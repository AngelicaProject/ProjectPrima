msgid "※Cannot add status when<br>　target motion is disabled."
msgstr "※ Нельзя добавить статус,<br>　если движение цели остановлено."

#. ja: モーション設定
#. de: Bewegungen
#. fr: Mouvements
msgctxt "Addon:5989:0:0"
msgid "Motion Settings"
msgstr "Настр. движений"

#. ja: 移動モーション
#. de: Ge<shy>schwindig<shy>keit und Richtung
#. fr: Déplacement
msgctxt "Addon:5990:0:0"
msgid "Movement"
msgstr "Движение"

#. ja: ※特定ステータス／エモート再生中は<br>　移動モーションの再生ができません
#. de: ※ Manche Bewegungen können während bestimmten Status oder Emotes nicht ausgeführt werden.
#. fr: * Indisponible lors de l'utilisation de certaines emotes et de certaines altérations d'état.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Addon:5991:0:0"
msgid "※Movement not available<br>　during certain<br>　emotes/statuses."
msgstr "※ Нельзя двигаться<br>　во время некоторых<br>　эмоций и статусов."

#. ja: 前進：歩き
#. de: Vorwärts gehen
#. fr: Marche vers l'avant
msgctxt "Addon:5992:0:0"
msgid "Walk Forward"
msgstr "Шаг вперёд"

#. ja: 前進：走り
#. de: Vorwärts rennen
#. fr: Course vers l'avant
msgctxt "Addon:5993:0:0"
msgid "Run Forward"
msgstr "Бег вперёд"

#. ja: 前進：スプリント
#. de: Vorwärts sprinten
#. fr: Sprint vers l'avant
msgctxt "Addon:5994:0:0"
msgid "Sprint Forward"
msgstr "Спринт вперёд"

#. ja: ストライフ左：歩き
#. de: Seitlich nach links gehen
#. fr: Marche latérale gauche
msgctxt "Addon:5995:0:0"
msgid "Slowly Strafe Left"
msgstr "Медленный шаг влево"

#. ja: ストライフ左：走り
#. de: Seitlich nach links rennen
#. fr: Course latérale gauche
msgctxt "Addon:5996:0:0"
msgid "Quickly Strafe Left"
msgstr "Быстрый шаг влево"

#. ja: ストライフ右：歩き
#. de: Seitlich nach rechts gehen
#. fr: Marche latérale droite
msgctxt "Addon:5997:0:0"
msgid "Slowly Strafe Right"
msgstr "Медленный шаг вправо"

#. ja: ストライフ右：走り
#. de: Seitlich nach rechts rennen
#. fr: Course latérale droite
msgctxt "Addon:5998:0:0"
msgid "Quickly Strafe Right"
msgstr "Быстрый шаг вправо"

#. ja: 後退：歩き
#. de: Rückwärts gehen
#. fr: Marche à reculons
msgctxt "Addon:5999:0:0"
msgid "Walk Backwards"
msgstr "Шаг назад"
