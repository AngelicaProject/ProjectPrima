msgctxt "Addon:7033:0:0"
msgid "<ui-color 506><ui-edge-color 507>You have selected the same item that is already on display.</ui-edge-color></ui-color><br><br>Discard the following item and replace it with another?<br><if ($n2 > 0)>※Items with the lowest collectability are prioritized for printing.<br></if><ui-color 500><ui-edge-color 501>※HQ items and collectables will be rendered normal.</ui-edge-color></ui-color>"
msgstr "<ui-color 506><ui-edge-color 507>Вы выбрали предмет, который уже выставлен.</ui-edge-color></ui-color><br><br>Заменить его следующим предметом?<br><if ($n2 > 0)>※ Сначала будут использованы предметы с наименьшей ценностью коллекции.<br></if><ui-color 500><ui-edge-color 501>※ Предметы HQ и коллекционные предметы будут отображаться как обычные.</ui-edge-color></ui-color>"

