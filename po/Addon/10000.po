msgid "Participating Parties: Two <if $n1><if ($n1 <= 10)><switch $n1><case>one<case>two<case>three<case>four<case>five<case>six<case>seven<case>eight<case>nine<case>ten</switch><else><num $n1></if><else><num $n1></if>-player parties<br>Spectator Party: 1-8 players"
msgstr "Группы участников: две группы по <if $n1><if ($n1 <= 10)><switch $n1><case>одному<case>два<case>три<case>четыре<case>пять<case>шесть<case>семь<case>восемь<case>девять<case>десять</switch><else><num $n1></if><else><num $n1></if> игрока<br>Группа зрителей: 1–8 игроков"

