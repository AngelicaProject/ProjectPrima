msgstr "<num $n1>-е"

#. ja: 50番目以降
#. de: 50. oder mehr
#. fr: 50e ou plus
msgctxt "Addon:10040:0:0"
msgid "After #50"
msgstr "После 50-го"

#. ja: ウルヴズジェイル(レート変動あり)
#. de: Wolfshöhle (mit Wertung)
#. fr: L'Antre des loups (classé)
msgctxt "Addon:10041:0:0"
msgid "The Wolves' Den (Rated)"
msgstr "Логово волков (рейт.)"

