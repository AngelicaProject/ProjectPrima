#. de: Grup<shy>pen<shy>mit<shy>glieder rekrutieren
#. fr: Recruter des équipiers
msgctxt "Addon:10034:0:0"
msgid "Recruit Members"
msgstr "Набрать участников"

#. ja: 該当するパーティ募集を見る
#. de: Gruppen suchen
#. fr: Voir les recrutements
msgctxt "Addon:10035:0:0"
msgid "View Parties That Meet Conditions"
msgstr "Показать подходящие группы"

#. ja: その他のパーティ募集
#. de: Andere Gruppen<shy>suchen
#. fr: Autres recrutements
msgctxt "Addon:10036:0:0"
msgid "Other Parties Recruiting"
msgstr "Другие группы в поиске"

#. ja: 現在マッチング先選定の待機中です
#. de: Warte auf passende Ergebnisse ...
#. fr: En attente de groupement
msgctxt "Addon:10037:0:0"
msgid "Waiting for a match..."
msgstr "Ожидание подбора..."

#. ja: 申請時のロールでの待機順番
#. de: Position auf der Warteliste in deiner registrierten Rolle
#. fr: Ordre d'attente pour le rôle choisi
msgctxt "Addon:10038:0:0"
msgid "Role Waiting List"
msgstr "Очередь ожидания по роли"

#. ja: <num $n1>番目
#. de: <num $n1>.
#. fr: <num $n1><if ($n1 <= 1)>er<else>e</if>
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
