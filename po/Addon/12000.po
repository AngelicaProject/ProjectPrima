msgctxt "Addon:12624:0:0"
msgid "Travel to <string $s1>?<br><ui-color 506><ui-edge-color 507>Please be advised you must be playing solo or in a cross-world party for your transfer to be processed.</ui-edge-color></ui-color>"
msgstr "Отправиться в «<string $s1>»?<br><ui-color 506><ui-edge-color 507>Для переноса нужно быть вне группы или состоять в межмировой группе.</ui-edge-color></ui-color>"

#. ja: Traveler
#. de: <if ($n1 == 1)>Reisende<else>Reisender</if>
#. fr: <if ($n1 == 1)>Exploratrice<else>Explorateur</if>
