msgstr "Другие игроки"

#. ja: メインディスプレイのリフレッシュレート
#. de: Bildfrequenz der Hauptanzeige
#. fr: Écran principal
msgctxt "Addon:4054:0:0"
msgid "Main Display Refresh Rate"
msgstr "Частота обновления экрана"

#. ja: 60fps
#. de: 60 fps
#. fr: 60 img/s
msgctxt "Addon:4055:0:0"
msgid "60 fps"
msgstr "60 к/с"

#. ja: コンテンツ参加確認中のシステム音を再生する
