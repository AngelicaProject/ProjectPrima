msgid "Play system sounds while waiting for Duty Finder."
msgstr "Воспроизводить системные звуки во время ожидания в поиске активностей."

#. ja: おすすめのガンマ設定：×が見えない / ◯が見える
#. de: Empfohlene Stärke: × ist unsichtbar / ◯ ist sichtbar
#. fr: Niveau recommandé<nbsp>: × n'est pas visible / ◯ est à peine visible
msgctxt "Addon:4057:0:0"
msgid "Recommended Level: × is not visible / ◯ is just visible"
msgstr "Рекомендуемый уровень: × не видно / ◯ едва видно"

#. ja: ガンマ補正
#. de: Gammakorrektur
#. fr: Correction gamma
msgctxt "Addon:4058:0:0"
msgid "Gamma Correction"
msgstr "Коррекция гаммы"

#. ja: 30fps
#. de: 30 fps
#. fr: 30 img/s
msgctxt "Addon:4059:0:0"
msgid "30 fps"
msgstr "30 к/с"

#. ja: グラフィック設定プリセット
#. de: Grafik-Voreinstellungen
#. fr: Préréglages graphiques
msgctxt "Addon:4060:0:0"
msgid "Graphics Settings"
msgstr "Настройки графики"

#. ja: 描画設定
#. de: Anzeigeeinstellungen
#. fr: Général
msgctxt "Addon:4061:0:0"
msgid "General"
msgstr "Общие"

#. ja: HDRレンダリングを有効にする（グラデーション描画をなめらかにする）
#. de: Die Darstellung allgemein verbessern (HDRR)
#. fr: Activer l'imagerie à grande gamme dynamique (HDR)
msgctxt "Addon:4062:0:0"
msgid "Enable HDR rendering and improve overall graphic quality."
msgstr "Включить HDR-рендеринг для улучшения общего качества графики."

#. ja: オクルージョンカリングを有効にする（見えないものの描画を簡略化する）
#. de: Verdeckte Bereiche vereinfacht berechnen (Occlusion Culling)
#. fr: Activer l'élimination des objets cachés
msgctxt "Addon:4063:0:0"
msgid "Disable rendering of objects when not visible. (Occlusion Culling)"
msgstr "Не отображать невидимые объекты. (Отсечение невидимых объектов)"

#. ja: LODを有効にする（遠影表示に簡易モデルを使用し描画負荷を軽減する）
#. de: Entfernte Details vereinfacht anzeigen (LOD)
#. fr: Réduire le niveau de détail des objets distants (LOD)
msgctxt "Addon:4064:0:0"
msgid "Use low-detail models on distant objects. (LOD)"
msgstr "Использовать упрощённые модели для удалённых объектов. (LOD)"

#. ja: LODストリーミングを有効にする
#. de: LOD-Daten nur wenn nötig laden (Streaming)
#. fr: Conserver le niveau de détail lorsque possible
msgctxt "Addon:4065:0:0"
msgid "Cache LOD data only when necessary. (LOD Streaming)"
msgstr "Загружать данные LOD только при необходимости. (Потоковая загрузка LOD)"

#. ja: アンチエイリアス
#. de: Gezackte Ränder glätten (Anti-Aliasing)
#. fr: Anticrénelage
msgctxt "Addon:4066:0:0"
msgid "Edge Smoothing (Anti-aliasing)"
msgstr "Сглаживание краёв (антиалиасинг)"

#. ja: ライティングの品質
#. de: Durchscheinendes Licht
#. fr: Qualité lumière transparente
msgctxt "Addon:4067:0:0"
msgid "Transparent Lighting Quality"
msgstr "Качество прозр. света"

#. ja: 細かい草の表示量
#. de: Grasdetails
#. fr: Détails de l'herbe
msgctxt "Addon:4068:0:0"
msgid "Grass Quality"
msgstr "Качество травы"

#. ja: 影の表現
#. de: Schatten
#. fr: Ombres
msgctxt "Addon:4069:0:0"
msgid "Shadow Quality"
msgstr "Качество теней"

#. ja: キャラクターの影のLODを有効にする
#. de: Schatten vereinfacht anzeigen (LOD)
#. fr: Réduire le niveau de détail pour les personnages (LOD)
msgctxt "Addon:4070:0:0"
msgid "Use low-detail models on shadows. (LOD)"
msgstr "Использовать упрощённые тени персонажей. (LOD)"

#. ja: 影の表示設定
#. de: Schattendarstellung
#. fr: Affichage des ombres
msgctxt "Addon:4071:0:0"
msgid "Shadows"
msgstr "Отображение теней"

#. ja: 影の解像度
#. de: Schattenauflösung
#. fr: Résolution
msgctxt "Addon:4072:0:0"
msgid "Shadow Resolution"
msgstr "Разрешение теней"

#. ja: 影の表示距離
#. de: Schattenkaskadierung
#. fr: Textures d'ombre en cascade (CSM)
msgctxt "Addon:4073:0:0"
msgid "Shadow Cascading"
msgstr "Каскадные тени"

#. ja: ソフトシャドウ
#. de: Schattenweichzeichnung
#. fr: Adoucissement
msgctxt "Addon:4074:0:0"
msgid "Shadow Softening"
msgstr "Смягчение теней"

#. ja: テクスチャ品質
#. de: Texturdetails
#. fr: Qualité des textures
msgctxt "Addon:4075:0:0"
msgid "Texture Detail"
msgstr "Качество текстур"

#. ja: テクスチャフィルタ
#. de: Texturfilterung
#. fr: Filtrage des textures
msgctxt "Addon:4076:0:0"
msgid "Texture Filtering"
msgstr "Фильтрация текстур"

#. ja: テクスチャ異方性フィルタ
#. de: Anisotropischer Filter
#. fr: Filtrage anisotrope
msgctxt "Addon:4077:0:0"
msgid "Anisotropic Filtering"
msgstr "Анизотроп. фильтрация"

#. ja: 画面効果
#. de: Bildschirmeffekte
#. fr: Effets de l'écran
msgctxt "Addon:4078:0:0"
msgid "Effects"
msgstr "Эффекты"

#. ja: 周辺減光を有効にする（画面の隅を自然に暗くする効果）
#. de: Abdunkelung zum Bildschirmrand hin (Randverdunkelung)
#. fr: Assombrir na<shy>tu<shy>rel<shy>le<shy>ment les bords de l'écran (centre-bord)
msgctxt "Addon:4079:0:0"
msgid "Naturally darken the edges of the screen. (Limb Darkening)"
msgstr "Естественно затемнять края экрана. (Затемнение по краям)"

#. ja: 放射ブラーを有効にする（爆発などで周囲に向かって画面をぼかす効果）
#. de: Verwischung bei bewegten Objekten (Radiale Unschärfe)
#. fr: Ajouter un flou autour des objets en mouvement (flou radial)
msgctxt "Addon:4080:0:0"
msgid "Blur the graphics around an object in motion. (Radial Blur)"
msgstr "Размывать изображение вокруг движущихся объектов. (Радиальное размытие)"

#. ja: リアルタイムリフレクション
#. de: Reflexionseffekte in Echtzeit
#. fr: Reflets en temps réel
msgctxt "Addon:4081:0:0"
msgid "Real-time Reflections"
msgstr "Отражения в реальном времени"

#. ja: SSAO（立体感を強調する効果）
#. de: Raumtiefe betonen (SSAO)
#. fr: Occl. ambiante d'espace d'écran (SSAO)
msgctxt "Addon:4082:0:0"
msgid "Screen Space Ambient Occlusion"
msgstr "Экранное затенение окружающих объектов"

#. ja: グレア（光があふれる表現）
#. de: Blendeffekte (Glare)
#. fr: Reflets lumineux
msgctxt "Addon:4083:0:0"
msgid "Glare"
msgstr "Сияние"

#. ja: カットシーン効果
#. de: Effekte in Videosequenzen
#. fr: Scènes cinématiques
msgctxt "Addon:4084:0:0"
msgid "Cinematic Cutscenes"
msgstr "Эффекты в роликах"

#. ja: 被写界深度表現を有効にする
#. de: Tiefenschärfe (DOF)
#. fr: Activer la profondeur de champ
msgctxt "Addon:4085:0:0"
msgid "Enable depth of field."
msgstr "Включить глубину резкости."

#. ja: バトルエフェクト設定
#. de: Kampfeffekte anzeigen
#. fr: Effets visuels des combats
msgctxt "Addon:4086:0:0"
msgid "Battle Effects"
msgstr "Боевые эффекты"

#. ja: 自分
#. de: Eigene
#. fr: Soi
msgctxt "Addon:4087:0:0"
msgid "Self"
msgstr "Себя"

#. ja: パーティ
#. de: Gruppe
#. fr: Équipiers
msgctxt "Addon:4088:0:0"
msgid "Party Members"
msgstr "Участники"

#. ja: 他人
#. de: Andere
#. fr: Autres joueurs
msgctxt "Addon:4089:0:0"
msgid "Other PCs"
msgstr "Другие игроки"

#. ja: マウス操作設定
#. de: Mauseinstellungen
#. fr: Paramètres souris
msgctxt "Addon:4090:0:0"
msgid "Mouse Settings"
msgstr "Настройки мыши"

#. ja: マウスドラッグ操作での解像度変更を有効にする
#. de: Auflösung bei Anpassung der Fenstergröße ändern
#. fr: Autoriser le redimensionnement de la fenêtre
msgctxt "Addon:4091:0:0"
msgid "Allow resolution changes via mouse drag."
msgstr "Менять разрешение перетаскиванием"

#. ja: 画面外へのマウスカーソル操作を制限する
#. de: Mauscursor nur innerhalb des Spielfensters effektiv
#. fr: Empêcher le curseur de sortir de la fenêtre du jeu
msgctxt "Addon:4092:0:0"
msgid "Limit mouse operation to game window."
msgstr "Ограничить курсор игровым окном."

#. ja: マウスドラッグでのカメラ感度
#. de: Mauskamera-Empfindlichkeit
#. fr: Sensibilité de la caméra à la souris
msgctxt "Addon:4093:0:0"
msgid "Mouse Camera Sensitivity"
msgstr "Чувствительность камеры к мыши"

#. ja: 選択肢へのオートフォーカスを有効にする
#. de: Automatisch zu Dialogfenstern springen
#. fr: Centrage automatique sur les choix
msgctxt "Addon:4094:0:0"
msgid "Auto-target queries."
msgstr "Автовыбор вариантов"

#. ja: キャラクターのライティング設定
#. de: Charakterausleuchtung
#. fr: Éclairage des personnages
msgctxt "Addon:4095:0:0"
msgid "Character Lighting"
msgstr "Освещение персонажей"

#. ja: 離席時にfps設定を制限する
#. de: Limitieren, wenn der Online-Status „Abwesend“ ist
#. fr: Limiter les images/seconde lorsqu'absent
msgctxt "Addon:4096:0:0"
msgid "Limit fps when away from keyboard."
msgstr "Огр. частоту кадров при отсутствии"

#. ja: UIアセット設定
#. de: UI-Auflösung
#. fr: Résolution de l'interface utilisateur
msgctxt "Addon:4097:0:0"
msgid "UI Resolution Settings"
msgstr "Настройки разрешения интерфейса"

#. ja: UIアセットタイプ
#. de: Auflösungstyp
#. fr: Type d'interface
msgctxt "Addon:4098:0:0"
msgid "UI Resolution"
msgstr "Разреш. UI"

#. ja: ※再起動時に反映されます
#. de: * Erfordert Neustart
#. fr: * Effectif au prochain démarrage.
msgctxt "Addon:4099:0:0"
msgid "※Requires reboot."
msgstr "※Требуется перезапуск"

#. ja: <platform 1>全般設定
#. de: <platform 1>-Einstellungen
