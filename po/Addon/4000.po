msgid "BGM"
msgstr "Музыка"

#. ja: 効果音
#. de: Soundeffekte
#. fr: Effets sonores
msgctxt "Addon:4049:0:0"
msgid "Sound Effects"
msgstr "Звуковые эфф."

#. ja: ボイス
#. de: Stimmen
#. fr: Voix
msgctxt "Addon:4050:0:0"
msgid "Voice"
msgstr "Голоса"

#. ja: システム音
#. de: Systemtöne
#. fr: Sons système
msgctxt "Addon:4051:0:0"
msgid "System Sounds"
msgstr "Сист. звуки"

#. ja: 環境音
#. de: Umgebungsgeräusche
#. fr: Ambiance sonore
msgctxt "Addon:4052:0:0"
msgid "Ambient Sounds"
msgstr "Звуки окружения"

