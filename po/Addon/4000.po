msgid "Play music when mounted."
msgstr "Воспроизводить музыку верхом."

#. ja: サウンドの聴取位置
#. de: Simulierung der Geräuschquelle
#. fr: Placement de la position d'écoute
msgctxt "Addon:4043:0:0"
msgid "Listening Position"
msgstr "Положение источника звука"

#. ja: カメラ寄り
#. de: Bei Kamera
#. fr: Près de la camera
msgctxt "Addon:4044:0:0"
msgid "Camera"
msgstr "У камеры"

