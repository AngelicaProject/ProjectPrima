msgctxt "Addon:17677:0:0"
msgid "Unable to take all.<br><if ($n1 > 0)><ui-color 506><ui-edge-color 507>※You will exceed the capacity of your crucible item inventory.</ui-edge-color></ui-color><br></if><if ($n2 > 0)><ui-color 506><ui-edge-color 507>※You will receive duplicates of beast gear.</ui-edge-color></ui-color><br></if><if ($n3 > 0)><ui-color 506><ui-edge-color 507>※You will exceed the capacity of your beast gear inventory.</ui-edge-color></ui-color><br></if>Please select loot individually."
msgstr "Не удалось забрать всё.<br><if ($n1 > 0)><ui-color 506><ui-edge-color 507>※ В инвентаре не хватит места для предметов Горнила.</ui-edge-color></ui-color><br></if><if ($n2 > 0)><ui-color 506><ui-edge-color 507>※ Нельзя получить повторно уже имеющееся снаряжение зверя.</ui-edge-color></ui-color><br></if><if ($n3 > 0)><ui-color 506><ui-edge-color 507>※ В инвентаре не хватит места для снаряжения зверя.</ui-edge-color></ui-color><br></if>Выберите добычу по отдельности."

