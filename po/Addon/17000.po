msgid "Close the coffer without receiving any items?<br><ui-color 506><ui-edge-color 507>You cannot reopen the treasure coffer after closing it.</ui-edge-color></ui-color>"
msgstr "Закрыть сундук, ничего не получив?<br><ui-color 506><ui-edge-color 507>После этого открыть его снова не получится.</ui-edge-color></ui-color>"

