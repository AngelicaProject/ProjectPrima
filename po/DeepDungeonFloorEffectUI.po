msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 魔法効果：暗闇
#. de: Ebeneneffekt: Blind
#. fr: Aura : Cécité
#. column 2: Accuracy of all party members is reduced.
msgctxt "DeepDungeonFloorEffectUI:1:0:1"
msgid "Area Effect: Blindness"
msgstr "Эффект области: слепота"

#. ja: 味方全員の命中率が低下。
#. de: Präzision aller Gruppenmitglieder ist verringert.
#. fr: La précision est réduite pour vous et vos équipiers.
#. column 1: Area Effect: Blindness
msgctxt "DeepDungeonFloorEffectUI:1:0:2"
msgid "Accuracy of all party members is reduced."
msgstr "Точность всех участников группы снижена."

#. ja: 魔法効果：最大ＨＰ低下
#. de: Ebeneneffekt: LP-Malus
#. fr: Aura : PV maximums réduits
#. column 2: Maximum HP of all party members is reduced.
msgctxt "DeepDungeonFloorEffectUI:2:0:1"
msgid "Area Effect: HP Penalty"
msgstr "Эффект области: снижение ОЗ"

#. ja: 味方全員の最大ＨＰが低下。
#. de: Maximal-LP aller Gruppenmitglieder sind verringert.
#. fr: Les PV maximums sont réduits pour vous et vos équipiers.
#. column 1: Area Effect: HP Penalty
msgctxt "DeepDungeonFloorEffectUI:2:0:2"
msgid "Maximum HP of all party members is reduced."
msgstr "Максимум ОЗ всех участников группы снижен."

#. ja: 魔法効果：ダメージ低下
#. de: Ebeneneffekt: Schadensmalus
#. fr: Aura : Dégâts infligés réduits
#. column 2: Damage dealt by all party members is reduced.
msgctxt "DeepDungeonFloorEffectUI:3:0:1"
msgid "Area Effect: Damage Penalty"
msgstr "Эффект области: снижение урона"

#. ja: 味方全員の与ダメージが低下。
#. de: Ausgeteilter Schaden aller Gruppenmitglieder ist verringert.
#. fr: Les dégâts infligés sont réduits pour vous et vos équipiers.
#. column 1: Area Effect: Damage Penalty
msgctxt "DeepDungeonFloorEffectUI:3:0:2"
msgid "Damage dealt by all party members is reduced."
msgstr "Урон всех участников группы снижен."

#. ja: 魔法効果：アビリティ使用不可
#. de: Ebeneneffekt: Fertigkeiten unwirksam
#. fr: Aura : Aptitudes inutilisables
#. column 2: Use of abilities is prohibited for all party members.
msgctxt "DeepDungeonFloorEffectUI:4:0:1"
msgid "Area Effect: Inability"
msgstr "Эффект области: запрет умений"

#. ja: 味方全員がアビリティ使用不可。
#. de: Gruppenmitglieder können keine Fertigkeiten einsetzen.
#. fr: Les aptitudes sont inutilisables pour vous et vos équipiers.
#. column 1: Area Effect: Inability
msgctxt "DeepDungeonFloorEffectUI:4:0:2"
msgid "Use of abilities is prohibited for all party members."
msgstr "Все участники группы не могут использовать умения."

#. ja: 魔法効果：ヘイスト
#. de: Ebeneneffekt: Hast
#. fr: Aura : Hâte
#. column 2: Weaponskill recast time, spell recast time, and auto-attack delay for all party members are reduced.
msgctxt "DeepDungeonFloorEffectUI:5:0:1"
msgid "Area Effect: Haste"
msgstr "Эффект области: ускорение"

#. ja: 味方全員のオートアタックの攻撃間隔とウェポンスキル、および魔法のリキャストタイムが短縮。
#. de: Intervalle zwischen Auto-Attacken und Reaktivierungszeiten von Waffenfertigkeiten sind für alle Gruppenmitglieder verkürzt.
#. fr: Le délai des attaques automatiques ainsi que le temps de recharge des techniques d'arme et des sorts de magie sont réduits pour vous et vos équipiers.
#. column 1: Area Effect: Haste
msgctxt "DeepDungeonFloorEffectUI:5:0:2"
msgid "Weaponskill recast time, spell recast time, and auto-attack delay for all party members are reduced."
msgstr "Время восстановления умений, заклинаний и автоатак у всех участников группы сокращено."

#. ja: 魔法効果：最大ＨＰ／ＭＰ上昇
#. de: Ebeneneffekt: LP-/MP-Bonus
#. fr: Aura : PV et PM maximums augmentés
#. column 2: Maximum HP and MP of all party members are increased.
msgctxt "DeepDungeonFloorEffectUI:6:0:1"
msgid "Area Effect: HP/MP Boost"
msgstr "Эффект области: увеличение ОЗ/МП"

#. ja: 味方全員の最大ＨＰと最大ＭＰが上昇。
#. de: Maximal-LP und -MP aller Gruppenmitglieder sind erhöht.
#. fr: Les PV et PM maximums sont augmentés pour vous et vos équipiers.
#. column 1: Area Effect: HP/MP Boost
msgctxt "DeepDungeonFloorEffectUI:6:0:2"
msgid "Maximum HP and MP of all party members are increased."
msgstr "Максимум ОЗ и МП всех участников группы увеличен."

#. ja: 魔法効果：アイテム禁止
#. de: Ebeneneffekt: Gegenstände verboten
#. fr: Aura : Objets désactivés
#. column 2: Use of items (including dungeon-specific items) is prohibited for all party members.
msgctxt "DeepDungeonFloorEffectUI:7:0:1"
msgid "Area Effect: Item Penalty"
msgstr "Эффект области: запрет предметов"

#. ja: 味方全員がアイテム、および特定の特殊アイテム使用不可。
#. de: Gruppenmitglieder können Gegenstände und manche Spezialgegenstände nicht einsetzen.
#. fr: L'utilisation des objets et de certains objets spéciaux est désactivée pour vous et vos équipiers.
#. column 1: Area Effect: Item Penalty
msgctxt "DeepDungeonFloorEffectUI:7:0:2"
msgid "Use of items (including dungeon-specific items) is prohibited for all party members."
msgstr "Все участники группы не могут использовать предметы, в том числе особые предметы подземелья."

#. ja: 魔法効果：スプリント禁止
#. de: Ebeneneffekt: Sprint unmöglich
#. fr: Aura : Sprint désactivé
#. column 2: Use of the action Sprint is prohibited for all party members.
msgctxt "DeepDungeonFloorEffectUI:8:0:1"
msgid "Area Effect: Sprint Penalty"
msgstr "Эффект области: запрет бега"

#. ja: 味方全員がスプリント使用不可。
#. de: Gruppenmitglieder können Sprint nicht einsetzen.
#. fr: L'utilisation du sprint est désactivée pour vous et vos équipiers.
#. column 1: Area Effect: Sprint Penalty
msgctxt "DeepDungeonFloorEffectUI:8:0:2"
msgid "Use of the action Sprint is prohibited for all party members."
msgstr "Все участники группы не могут использовать действие «Бег»."

#. ja: 魔法効果：ノックバック禁止
#. de: Ebeneneffekt: Rückstoß unwirksam
#. fr: Aura : Projections désactivées
#. column 2: Knockback and draw-in effects for both enemies and allies are disabled.
msgctxt "DeepDungeonFloorEffectUI:9:0:1"
msgid "Area Effect: Knockback Penalty"
msgstr "Эффект области: запрет отбрасывания"

#. ja: 敵味方問わず、ノックバック、および引き寄せ効果が無効。
#. de: Gruppenmitglieder und Gegner werden nicht von Rückstoß- und Heranzieheffekten beeinflusst.
#. fr: L'effet des projections et des attractions est désactivé pour vous, vos équipiers et vos ennemis.
#. column 1: Area Effect: Knockback Penalty
msgctxt "DeepDungeonFloorEffectUI:9:0:2"
msgid "Knockback and draw-in effects for both enemies and allies are disabled."
msgstr "Отбрасывание и притягивание не действуют ни на врагов, ни на союзников."

#. ja: 魔法効果：ＨＰ自然回復禁止
#. de: Ebeneneffekt: LP-Regeneration unwirksam
#. fr: Aura : Auto-récupération des PV désactivée
#. column 2: HP regeneration for all party members is disabled.
msgctxt "DeepDungeonFloorEffectUI:10:0:1"
msgid "Area Effect: Auto-heal Penalty"
msgstr "Эффект области: запрет восстановления ОЗ"

#. ja: 味方全員のＨＰ自然回復が無効。
#. de: Gruppenmitglieder können nicht automatisch LP regenerieren.
#. fr: La régénération automatique des PV est désactivée pour vous et vos équipiers.
#. column 1: Area Effect: Auto-heal Penalty
msgctxt "DeepDungeonFloorEffectUI:10:0:2"
msgid "HP regeneration for all party members is disabled."
msgstr "У всех участников группы отключено естественное восстановление ОЗ."

#. ja: 魔法効果：妖霧
#. de: Ebeneneffekt: Nichtsnebel
#. fr: Aura : Brume du néant
#. column 2: Enemy movement speed is increased. Enemies also deal more damage while taking less.
msgctxt "DeepDungeonFloorEffectUI:11:0:1"
msgid "Area Effect: Gloom"
msgstr "Эффект области: мгла"

#. ja: 妖霧に包まれた状態。すべての敵の与ダメージと移動速度が上昇し、被ダメージが低下。
#. de: Von Nichtsnebel umhüllt. Ausgeteilter Schaden und Bewegungsgeschwindigkeit aller Gegner ist erhöht, ihr erlittener Schaden verringert.
#. fr: Une brume menaçante augmente les dégâts infligés ainsi que la vitesse de déplacement, et réduit les dégâts subis pour tous vos ennemis.
#. column 1: Area Effect: Gloom
msgctxt "DeepDungeonFloorEffectUI:11:0:2"
msgid "Enemy movement speed is increased. Enemies also deal more damage while taking less."
msgstr "Скорость передвижения врагов повышена. Они наносят больше урона и получают меньше."

#. ja: 魔法効果：スプリント
#. de: Ebeneneffekt: Sprint
#. fr: Aura : Sprint
#. column 2: Movement speed of all party members is increased.
msgctxt "DeepDungeonFloorEffectUI:12:0:1"
msgid "Area Effect: Sprint"
msgstr "Эффект области: бег"

#. ja: 味方全員の移動速度が上昇。
#. de: Bewegungsgeschwindigkeit aller Gruppenmitglieder ist erhöht.
#. fr: La vitesse de déplacement est accélérée pour vous et vos équipiers.
#. column 1: Area Effect: Sprint
msgctxt "DeepDungeonFloorEffectUI:12:0:2"
msgid "Movement speed of all party members is increased."
msgstr "Скорость передвижения всех участников группы повышена."

#. ja: 魔法効果：魔石禁止
#. de: Ebeneneffekt: Zaubersteine verboten
#. fr: Aura : Magilithes inutilisables
#. column 2: Use of magicite is prohibited for all party members.
msgctxt "DeepDungeonFloorEffectUI:13:0:1"
msgid "Area Effect: Magicite Penalty"
msgstr "Эффект области: запрет магических камней"

#. ja: 味方全員が魔石使用不可。
#. de: Gruppenmitglieder können Zaubersteine nicht einsetzen.
#. fr: Les magilithes sont inutilisables pour vous et vos équipiers.
#. column 1: Area Effect: Magicite Penalty
msgctxt "DeepDungeonFloorEffectUI:13:0:2"
msgid "Use of magicite is prohibited for all party members."
msgstr "Все участники группы не могут использовать магические камни."

#. ja: 魔法効果：デミクローン禁止
#. de: Ebeneneffekt: Demiklone blockiert
#. fr: Aura : Semi-clones inutilisables
#. column 2: Use of demiclones is prohibited for all party members.
msgctxt "DeepDungeonFloorEffectUI:14:0:1"
msgid "Area Effect: Demiclone Penalty"
msgstr "Эффект области: запрет демиклонов"

#. ja: 味方全員がデミクローン使用不可。
#. de: Gruppenmitglieder können Demiklone nicht einsetzen.
#. fr: Les semi-clones sont inutilisables pour vous et vos équipiers.
#. column 1: Area Effect: Demiclone Penalty
msgctxt "DeepDungeonFloorEffectUI:14:0:2"
msgid "Use of demiclones is prohibited for all party members."
msgstr "Все участники группы не могут призывать демиклонов."

#. ja: 魔法効果：ジュニパーの香禁止
#. de: Ebeneneffekt: Weihrauch unwirksam
#. fr: Aura : Encens inutilisable
#. column 2: Use of incense is prohibited for all party members.
msgctxt "DeepDungeonFloorEffectUI:15:0:1"
msgid "Area Effect: Incense Penalty"
msgstr "Эффект области: запрет благовоний"

#. ja: 味方全員がジュニパーの香使用不可。
#. de: Gruppenmitglieder können keinen Weihrauch einsetzen.
#. fr: L'encens de genévrier est inutilisable pour vous et vos équipiers.
#. column 1: Area Effect: Incense Penalty
msgctxt "DeepDungeonFloorEffectUI:15:0:2"
msgid "Use of incense is prohibited for all party members."
msgstr "Все участники группы не могут использовать благовония."
