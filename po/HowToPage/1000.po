msgctxt "HowToPage:1982:0:4"
msgid "Flying consists of three basic maneuvers:<br><br><ui-color 500><ui-edge-color 501>Advancing</ui-edge-color></ui-color><br> Stick<br><ui-color 500><ui-edge-color 501>Ascending</ui-edge-color></ui-color><br> <icon2 11> button<br><ui-color 500><ui-edge-color 501>Descending</ui-edge-color></ui-color><br> <icon2 12>+<icon2 13> button"
msgstr "В полёте доступны три основных действия:<br><br><ui-color 500><ui-edge-color 501>Движение вперёд</ui-edge-color></ui-color><br> Стик<br><ui-color 500><ui-edge-color 501>Набор высоты</ui-edge-color></ui-color><br> Кнопка <icon2 11><br><ui-color 500><ui-edge-color 501>Снижение</ui-edge-color></ui-color><br> Кнопки <icon2 12>+<icon2 13>"
