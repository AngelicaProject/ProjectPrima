# InstanceContentTextData
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: サミダレを倒せ！
#. de: Besiege Samidare!
#. fr: Vainquez Samidare<nbsp>!
msgctxt "InstanceContentTextData:39000:0:0"
msgid "Defeat Samidare!"
msgstr "Одолейте Самидарэ!"

#. ja: アタシたちの祭器を返してもらう！
#. de: Du hast Flatterschein die längste Zeit besessen!
#. fr: Il faut récupérer le totem<nbsp>!
msgctxt "InstanceContentTextData:39001:0:0"
msgid "I'm taking back what you stole!"
msgstr "Я заберу то, что вы у нас украли!"

#. ja: 会得に何年もかかる妙技も、<br>この祭器を使えば……！
#. de: Mit diesem Artefakt ist die schwierigste Technik ein Klacks!
#. fr: Avec ce totem, je peux facilement utiliser n'importe quelle technique<nbsp>!
msgctxt "InstanceContentTextData:39002:0:0"
msgid "With this artifact, her mastery is mine to wield!"
msgstr "С этим артефактом мне подвластно даже искусство, которому учатся годами!"

#. ja: 獣を操る技だって……<br>さあ、集まって力を貸せ！
#. de: Selbst Bestien beherrscht man damit! Bei Fuß, meine Diener!
#. fr: Une compétence qui permet de contrôler les bêtes sauvages... Venez me prêter votre force<nbsp>!
msgctxt "InstanceContentTextData:39003:0:0"
msgid "Even her command over beasts! Now, come forth, and swarm my foes!"
msgstr "Даже зверями можно повелевать! Ну же, явитесь и растерзайте моих врагов!"

#. ja: さあ、逃れてみろ！
#. de: Mal sehen, ob ihr denen entkommt!
#. fr: Essayez donc de fuir, allez<nbsp>!
msgctxt "InstanceContentTextData:39004:0:0"
msgid "Let us see how fleet of foot you are!"
msgstr "Посмотрим, как быстро вы умеете бегать!"

#. ja: いまだ、一斉にかかれ！
#. de: Jetzt! Auf sie!
#. fr: Maintenant<nbsp>! Arrêtez-les<nbsp>!
msgctxt "InstanceContentTextData:39005:0:0"
msgid "Crush them!"
msgstr "Раздавите их!"

#. ja: クッ……数が多い……！<br>アタシがまとめて射かけてやる！
#. de: Verdammt, sind das viele<nbsp>... Überlass sie mir!
#. fr: Rah... Ils sont beaucoup<nbsp>! Je vais leur tirer dessus<nbsp>!
msgctxt "InstanceContentTextData:39006:0:0"
msgid "There are so many... But I can bury them in a volley of arrows!"
msgstr "Их так много... Но я осыплю их градом стрел!"

#. ja: チッ、しぶとい奴らめ……<br>なれば、長兄マグナイとやらの力を使おう！
#. de: Lästiges Geschmeiß! Zeit, dass dieser Magnai hier aufräumt!
#. fr: Grrr, vous êtes tenaces<nbsp>! Puisque c'est comme ça, dites bonjour au Frère suprême<nbsp>!
msgctxt "InstanceContentTextData:39008:0:0"
msgid "Hmph, stubborn fools! Very well, I shall borrow the might of that brutish Oronir!"
msgstr "Тьфу, живучая сволочь! Что ж, позаимствую силу этого вашего грубияна-оронира!"

#. ja: その煩わしい動きを封じてやる！
#. de: Schluss mit dem Gewusel!
#. fr: Vous bougez un peu trop à mon goût<nbsp>!
msgctxt "InstanceContentTextData:39009:0:0"
msgid "You will scuttle about no more!"
msgstr "Хватит вам больше вертеться под ногами!"

#. ja: サドゥなる女の奥の手で、まとめて片付けてくれる！
#. de: Bestimmt hat Sadu ein paar gute Tricks auf Lager!
#. fr: Et maintenant, Sadu va se débarrasser de vous d'un seul coup<nbsp>!
msgctxt "InstanceContentTextData:39010:0:0"
msgid "Now to deliver the coup de grâce with that Dotharli devil!"
msgstr "А теперь покончим с вами приёмчиком этой дотарлийской ведьмы!"

#. ja: ハッハッハ！<br>跡形もなく消し飛ぶがいい……！
#. de: Hahaha! Ein Freiflug bis zum Mond ohne Wiederkehr!
#. fr: Ah ha ha<nbsp>! Je vais vous exterminer<nbsp>!
msgctxt "InstanceContentTextData:39011:0:0"
msgid "Hahaha! Naught of you will remain!"
msgstr "Ха-ха-ха! От вас и праха не останется!"

#. ja: おのれ、かくなるうえは……<br>ヤンサの守護者となって葬ってやろう！
#. de: Also gut! Mal sehen, ob ihr es mit einer Gottheit aufnehmen könnt!
#. fr: Vous ne me laissez pas le choix<nbsp>! C'est la protectrice de Yanxia qui vous donnera le coup de grâce<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:39012:0:0"
msgid "Damn you! So be it─I will assume <i>her</i> form..."
msgstr "Проклятье! Тогда я приму её <i>облик</i>..."

#. ja: 大瑞獣「玉藻御前」の力を見せてやる！
#. de: Erzittert vor der Macht von Tamamo no Gozen!
#. fr: Tremblez devant la puissance de Tamamo-no-Gozen<nbsp>!
msgctxt "InstanceContentTextData:39013:0:0"
msgid "Tremble before the mighty auspice, Tamamo Gozen!"
msgstr "Трепещите перед могучим священным зверем Тамамо-но-Годзэн!"

#. ja: 嫌な予感がする、アイツから離れるんだ！
#. de: Das gefällt mir nicht. Wir halten besser Abstand!
#. fr: Ça sent mauvais, éloignons-nous de lui<nbsp>!
msgctxt "InstanceContentTextData:39014:0:0"
msgid "I have a bad feeling about this─get away from him, quickly!"
msgstr "У меня дурное предчувствие. Быстро отойдите от него!"

#. ja: まだまだこれからだ！
#. de: Ha, es hat gerade erst begonnen!
#. fr: C'est loin d'être terminé<nbsp>!
msgctxt "InstanceContentTextData:39015:0:0"
msgid "I'm not finished yet!"
msgstr "Это ещё не конец!"

#. ja: 九尾の妖力にて苦厄を起こさん……
#. de: Die Macht der Füchsin ist grenzenlos!
#. fr: De ces neuf queues vont naître les pires désastres...
msgctxt "InstanceContentTextData:39016:0:0"
msgid "A curse to spell your doom..."
msgstr "Девять хвостов навлекут на вас погибель..."

#. ja: この地に宿る力を取り込んで、<br>更なる大厄を喰らわしてやろう！
#. de: Ich werde den hiesigen Äther aufsaugen und unendliches Leid über euch bringen!
#. fr: L'énergie contenue dans ce sol va me servir à déclencher une catastrophe d'une ampleur ex<shy>cep<shy>tion<shy>nelle<nbsp>!
msgctxt "InstanceContentTextData:39017:0:0"
msgid "I shall drink deep of the ambient aether and render you to ash!"
msgstr "Я впитаю эфир этой земли и обращу вас в пепел!"

#. ja: 恐ろしい力を感じる！<br>あれを何とかしないとマズそうだ……！
#. de: Ich spüre eine grausame Kraft. Wir müssen ihn irgendwie stören!
#. fr: Elle dégage une puissance incroyable<nbsp>! Il faut absolument l'arrêter<nbsp>!
msgctxt "InstanceContentTextData:39018:0:0"
msgid "Such baleful energy... We'll be in trouble if we don't do something!"
msgstr "От этой силы веет бедой... Если ничего не предпринять, нам не поздоровится!"

#. ja: 大九厄の詠唱完了まで　10
#. de: Neunundneunzigfacher Fluch in 10 ...
#. fr: 10 secondes avant Nonuple catastrophe
msgctxt "InstanceContentTextData:39019:0:0"
msgid "10 seconds to Ninety-ninefold Curse"
msgstr "До заклинания «Девяностократное проклятие»: 10 сек."

#. ja: 大九厄の詠唱完了まで　5
#. de: Neunundneunzigfacher Fluch in 5 ...
#. fr: 5 secondes
msgctxt "InstanceContentTextData:39020:0:0"
msgid "5 seconds to Ninety-ninefold Curse"
msgstr "До заклинания «Девяностократное проклятие»: 5 сек."

#. ja: 大九厄の詠唱完了まで　4
#. de: Neunundneunzigfacher Fluch in 4 ...
#. fr: 4 secondes
msgctxt "InstanceContentTextData:39021:0:0"
msgid "4 seconds"
msgstr "4 сек."

#. ja: 大九厄の詠唱完了まで　3
#. de: Neunundneunzigfacher Fluch in 3 ...
#. fr: 3 secondes
msgctxt "InstanceContentTextData:39022:0:0"
msgid "3 seconds"
msgstr "3 сек."

#. ja: 大九厄の詠唱完了まで　2
#. de: Neunundneunzigfacher Fluch in 2 ...
#. fr: 2 secondes
msgctxt "InstanceContentTextData:39023:0:0"
msgid "2 seconds"
msgstr "2 сек."

#. ja: 大九厄の詠唱完了まで　1
#. de: Neunundneunzigfacher Fluch in 1 ...
#. fr: 1 seconde
msgctxt "InstanceContentTextData:39024:0:0"
msgid "1 second"
msgstr "1 сек."

#. ja: ハァ……ハァ……<br>あの技を耐え抜いたというのか……！？
#. de: \<keuch> ... \<pust> ...<br>Ihr konntet dieser Allmacht widerstehen?!
#. fr: Haa... Haa... Comment avez-vous pu survivre à une telle attaque<nbsp>!?
msgctxt "InstanceContentTextData:39026:0:0"
msgid "\\<pant> You...\\<pant>...survived...?"
msgstr "<i>Ха-а... Ха-а...</i> Ты... <i>ха-а...</i>...выжил?.."

#. ja: ええいッ、この祭器がある限り、<br>勝利は確実に、俺の手にあるはずなんだ……！
#. de: Egal, solange ich das Artefakt besitze, bin ich unbesiegbar!
#. fr: Tant que j'ai ce totem avec moi, je suis certain de gagner<nbsp>!
msgctxt "InstanceContentTextData:39027:0:0"
msgid "It matters not! So long as I have this power, my victory is assured!"
msgstr "Неважно! Пока эта сила у меня, победа в кармане!"

#. ja: くそッ……<br>お前らごときに……負けるものか……！
#. de: Niemals! Ich werde nie vor euch kapitulieren!
#. fr: Je refuse de perdre... contre vous...
msgctxt "InstanceContentTextData:39028:0:0"
msgid "No! I will not lose to vermin like you!"
msgstr "Нет! Я не проиграю таким ничтожным букашкам!"

#. ja: 呪鎖を破壊し、クイーキを救え！
#. de: Zerschlage die Fessel und befreie Kuiyki!
#. fr: Brisez la chaîne poisseuse et sauvez Kuiyki<nbsp>!
msgctxt "InstanceContentTextData:39029:0:0"
msgid "Destroy the filthy shackle and free Kuiyki!"
msgstr "Разрушьте грязные оковы и освободите Куйки!"

#. ja: 闇球を破壊しろ！
#. de: Zerstöre die Finsterspähren!
#. fr: Détruisez les orbes ténébreux<nbsp>!
msgctxt "InstanceContentTextData:39030:0:0"
msgid "Destroy the balls of naught!"
msgstr "Уничтожьте сферы небытия!"

#. ja: やれるものならやってみろ！<br>凄腕の狩人、イットカに勝てるならな！
#. de: Ihr wollt mich besiegen? Nur über I'tocas Leiche!
#. fr: On va voir ce que vous valez face à I'toca, la meilleure des chasseuses<nbsp>!
msgctxt "InstanceContentTextData:39031:0:0"
msgid "Take it if you dare─from the hands of I'toca herself!"
msgstr "Ну-ка, попробуйте отнять это у самой И'токи!"

#. ja: アイツ、大技を使って疲れてるみたいだ……！<br>いまのうちに、押し切ろう！
#. de: Der Mistkerl schwächelt! Das ist unsere Chance!
#. fr: Regarde, utiliser de grosses attaques semble l'avoir fatigué<nbsp>! C'est maintenant ou jamais<nbsp>!
msgctxt "InstanceContentTextData:39032:0:0"
msgid "He's winded! Now's our chance!"
msgstr "Он выдохся! Сейчас наш шанс!"

#. ja: さあ、「ハニー・B・ラブリー」の登場です！
#. de: Vorhang auf für Suzie Summ Honigsüß!
#. fr: Notre idole à la fois douce et piquante a fait son entrée en scène<nbsp>!
msgctxt "InstanceContentTextData:39100:0:0"
msgid "The Honey B. Lovely show has begun!"
msgstr "Шоу Хани Би Лавли начинается!"

#. ja: 蜂の劇毒を使った攻撃ッ！<br>これは恐ろしい！
#. de: Ein Angriff mit Bienengift! Das muss brennen!
#. fr: Honey B. vient d'attaquer avec son effroyable dard empoisonné<nbsp>!
msgctxt "InstanceContentTextData:39101:0:0"
msgid "Here comes her fearsome venom strike!"
msgstr "Сейчас она нанесёт свой ужасный ядовитый удар!"

#. ja: 待ってましたァ～！<br>ハニー・Bの魅力全開です！
#. de: Der Moment, auf den wir alle gewartet haben!
#. fr: Attention les mirettes<nbsp>! Honey B. nous dévoile tout son charme<nbsp>!
msgctxt "InstanceContentTextData:39102:0:0"
msgid "Now to savor the sweet sting of Honey B.'s charms."
msgstr "Ну наконец-то! Сейчас насладимся чарами Хани Би во всей красе."

#. ja: 客席からは溢れんばかりの歓声！
#. de: Die Zuschauer hält es kaum mehr auf ihren Sitzen!
#. fr: Le public exprime son extase devant tant de beauté<nbsp>!
msgctxt "InstanceContentTextData:39103:0:0"
msgid "Oh, she's definitely feeling your love!"
msgstr "Ох, как ей нравится ваша любовь!"

#. ja: 危険な魅力に、挑戦者は抗えるかァ～！？
#. de: Können die Herausforderer dieser Versuchung widerstehen?!
#. fr: Voyons si notre challenger saura résister à l'aura envoûtante de Honey B.<nbsp>!
msgctxt "InstanceContentTextData:39104:0:0"
msgid "Can the challenger resist the irresistible!? I know I can't."
msgstr "Устоит ли наш соперник перед её чарами? Я-то точно не устоял бы!"

#. ja: お～っと！<br>挑戦者はハニー・Bにメロメロだァ！
#. de: Ist da etwa jemand Hals über Kopf verliebt?!
#. fr: Ça devait arriver<nbsp>! Le charme de Honey B. est irrésistible<nbsp>!
msgctxt "InstanceContentTextData:39105:0:0"
msgid "Alas, her charms were not to be denied!"
msgstr "Увы, её чарам не устоять!"

#. ja: おや？<br>ハニー・B、戦法を変えてきました！
#. de: Oho?! Suzie scheint ihre Strategie zu ändern!
#. fr: Eh bien<nbsp>? On dirait que notre chère Honey B. change de stratégie<nbsp>!
msgctxt "InstanceContentTextData:39106:0:0"
msgid "What's this? Honey B. has changed her routine!"
msgstr "Что это? Хани Би сменила тактику!"

#. ja: 両者譲らない激戦が繰り広げられてます！
#. de: Keine Seite gibt nach! Ein Kampf für die Ewigkeit!
#. fr: Fantastique<nbsp>! Nos combattants s'affrontent sans retenue<nbsp>!
msgctxt "InstanceContentTextData:39107:0:0"
msgid "What a clash! Neither side is willing to yield!"
msgstr "Вот это схватка! Ни одна сторона не собирается сдаваться!"

#. ja: あま～い蜜蜂、ハニー・B！<br>ラブリーにはじめるよ！
#. de: Mein Herz summ-summ-summt vor Freude!
#. fr: Bienvenue dans le monde joyeux et doux de Honey B. Lovely, mes chéris<nbsp>!
msgctxt "InstanceContentTextData:39108:0:0"
msgid "Let's put on a lovely show for the audience, hmm?"
msgstr "Ну что, устроим зрителям прелестное шоу?"

#. ja: さぁて、これはどうかな～？
#. de: Das übersteht ihr doch, oooder?
#. fr: Voyons ce que vous pensez de ça...
msgctxt "InstanceContentTextData:39109:0:0"
msgid "A little taste to make it interesting."
msgstr "А вот это вам по вкусу?"

#. ja: 突き刺しちゃうぞ☆
#. de: Mein Stachel wird euch bestrafen!
#. fr: Attention, je vais piquer avec mon dard<nbsp>!
msgctxt "InstanceContentTextData:39110:0:0"
msgid "This may sting a little."
msgstr "Будет немного больно."

#. ja: くらえ、すんごい毒～っ！
#. de: Mein Gift kribbelt von Kopf bis Fuß!
#. fr: Goûtez un peu à mon puissant venin<nbsp>!
msgctxt "InstanceContentTextData:39111:0:0"
msgid "Careful now, this is very, very deadly!"
msgstr "Осторожнее, яд очень-очень опасный!"

#. ja: ものども、ひれふせーぃ！
#. de: Vor mir fällt jeder auf die Knie!
#. fr: Prosternez-vous devant moi<nbsp>!
msgctxt "InstanceContentTextData:39112:0:0"
msgid "Submit to your lovely queen!"
msgstr "На колени перед вашей прелестной королевой!"

#. ja: B！　B！　ブリリアント☆
#. de: Summ! Summ! Super!
#. fr: Bravo à moi<nbsp>! Je suis tellement brillante<nbsp>!
msgctxt "InstanceContentTextData:39113:0:0"
msgid "B is for brilliant!"
msgstr "Б — это «бесподобна»!"

#. ja: 盛り上がってきたね～！
#. de: Oh, so langsam kommt ihr in Fahrt, was?
#. fr: Voilà un combat comme je les aime<nbsp>!
msgctxt "InstanceContentTextData:39114:0:0"
msgid "I'm having so much fun, aren't you?"
msgstr "Ух, как же весело! А вам?"

#. ja: 死ぬかもだから、ほんとごめんね？
#. de: Seid mir nicht böse, wenn euch das umbringt, ja?
#. fr: Ne m'en voulez pas si vous perdez la vie, hein<nbsp>?
msgctxt "InstanceContentTextData:39115:0:0"
msgid "No hard feelings if I kill you?"
msgstr "Не обижайтесь, если я вас убью, ладно?"

#. ja: やば、今日のバトル、めっちゃ良きだね！？
#. de: Dieser Kampf ist der beste seit Langem!
#. fr: Ça faisait si longtemps que j'avais pas éprouvé autant de plaisir<nbsp>!
msgctxt "InstanceContentTextData:39116:0:0"
msgid "Oooh, what a delightful battle this is!"
msgstr "О-о-о, какая чудесная битва!"

#. ja: みんな～！<br>ハート連打の準備はいいかぁ！？
#. de: Meine Bienchen! Sind eure Herzen bereit für mich?!
#. fr: Mes très chers fans<nbsp>! Êtes-vous prêts à succomber à mon charme<nbsp>?
msgctxt "InstanceContentTextData:39117:0:0"
msgid "Hope you're ready for me to steal your heart!"
msgstr "Народ, готовы отдать мне свои сердца?"

#. ja: よーし、魅せちゃうぞ～！
#. de: Empfangt meine Liebe!
#. fr: Je vais tous vous envoûter<nbsp>!
msgctxt "InstanceContentTextData:39118:0:0"
msgid "I'll make you mine!"
msgstr "Сейчас вы станете моими!"

#. ja: 今日からアタシの働き蜂、でしょ？
#. de: Echte Bienchen arbeiten fleißig für ihre Königin!
#. fr: Vous êtes désormais tous mes petites ouvrières<nbsp>!
msgctxt "InstanceContentTextData:39119:0:0"
msgid "Who's my obedient little bee?"
msgstr "Кто моя послушная пчёлка?"

#. ja: みんな～！<br>まだまだ、楽しんでってね！　B！
#. de: Ich muss wieder auf die Bühne! Feuert mich weiter an, ja?
#. fr: Mes jolis cœurs, le spectacle n'est pas encore fini<nbsp>!
msgctxt "InstanceContentTextData:39120:0:0"
msgid "Is everyone having a good time?"
msgstr "Всем весело?"

#. ja: うわウザ、堕ちないとかなくない？
#. de: Was, ihr seid mir nicht hilflos verfallen? Das glaub ich jetzt nicht!
#. fr: J'y crois pas<nbsp>! On ose résister à mon charme divin<nbsp>!?
msgctxt "InstanceContentTextData:39121:0:0"
msgid "What? Oh, you're kidding me, it didn't work?"
msgstr "Что? Да ладно, не сработало?!"

#. ja: みんな応援ありがと～！　ラブリーっ！
#. de: Eure Liebe gibt mir Kraft! Ihr seid summ-summ-super!
#. fr: Merci à tous pour votre soutien<nbsp>! Je vous aime énormément<nbsp>!
msgctxt "InstanceContentTextData:39122:0:0"
msgid "Your support means the world to me, everyone!"
msgstr "Спасибо всем за поддержку! Для меня это так важно!"

#. ja: は？　マジ？<br>なんで普通にしてるわけ！？
#. de: Ach, kommt schon! Wieso seid ihr immer noch bei Sinnen?!
#. fr: Raaah<nbsp>! J'ai horreur qu'on n'apprécie pas ma beauté, moi<nbsp>!
msgctxt "InstanceContentTextData:39123:0:0"
msgid "What? No one rejects me... No one!"
msgstr "Что? Никто не смеет мне отказывать! Никто!"

#. ja: B……B……ぶっころす……。
#. de: Summ<nbsp>... Summ<nbsp>... Sterbt<nbsp>...!
#. fr: Foi de Honey B., je vais être impitoyable maintenant<nbsp>!
msgctxt "InstanceContentTextData:39124:0:0"
msgid "B is for beat you to a bloody pulp!"
msgstr "Б — значит «буду бить до кровавых соплей»!"

#. ja: まだまだ、いっくよ～☆
#. de: Weiter, immer weiter!
#. fr: Allez<nbsp>! Je sais que vous êtes tous fous de moi<nbsp>!
msgctxt "InstanceContentTextData:39125:0:0"
msgid "We're just getting started.♪"
msgstr "Мы только начинаем!♪"

#. ja: あのさぁ、何アタシより目立ってんの……？
#. de: Schluss damit<nbsp>... <i>Ich</i> stehe im Mittelpunkt<nbsp>...!
#. fr: Comment oses-tu me voler la vedette<nbsp>!?
msgctxt "InstanceContentTextData:39126:0:0"
msgid "Nobody steals the spotlight from me!"
msgstr "Никто не смеет затмевать меня!"

#. ja: いい加減……退場してくれないかな……？
#. de: Letzte Warnung<nbsp>... Ihr solltet lieber aufgeben<nbsp>...!
#. fr: Ça suffit maintenant<nbsp>! Il est temps de tirer ta révérence<nbsp>!
msgctxt "InstanceContentTextData:39127:0:0"
msgid "Enough is enough! Get off my stage!"
msgstr "Хватит уже! Убирайтесь со сцены!"

#. ja: もう……これでおしまい！
#. de: Ihr seid<nbsp>... erledigt!
#. fr: Tu l'auras cherché<nbsp>! Adieu<nbsp>!
msgctxt "InstanceContentTextData:39128:0:0"
msgid "It's curtains for you!"
msgstr "Всё, вам конец!"

#. ja: ハニー・B・ラブリーの撃破
#. de: Suzie Summ Honigsüß bezwingen
#. fr: Vaincre Honey B. Lovely
msgctxt "InstanceContentTextData:39129:0:0"
msgid "Defeat Honey B. Lovely"
msgstr "Одолейте Хани Би Лавли"

#. ja: グルージャジャの幻影を倒せ！
#. de: Besiege Gulool Ja Jas Glorie!
#. fr: Terrassez l'ombre de Gulool Ja Ja！
msgctxt "InstanceContentTextData:39200:0:0"
msgid "Defeat Gulool Ja Ja's glory!"
msgstr "Одолейте славу Гулул Джи Джи"

#. ja: 旅で磨いた「武」を見せてやろう！
#. de: Zeigt mir den Mut, den ihr auf eurer Reise gesammelt habt!
#. fr: Goûtez donc à la Force que nous avons acquise au cours de nos voyages !
msgctxt "InstanceContentTextData:39201:0:0"
msgid "Bear witness to our resolve!"
msgstr "Узрите нашу решимость!"

#. ja: 証明してやるよ！<br>みんなで手を取り合えば、双頭だって超えられるって！
#. de: Lasst es uns beweisen! Gemeinsam können wir selbst den Dämmerkönig bezwingen!
#. fr: Un groupe soudé peut même vaincre un double-tête, et je vais te l'prouver !
msgctxt "InstanceContentTextData:39202:0:0"
msgid "So long as we stand together, we're unstoppable!"
msgstr "Пока мы держимся вместе, нас не одолеть!"

#. ja: 身動きを封じられたようですね。<br>全員でカバーを！
#. de: Das sieht nicht gut aus. Schnell, schaffen wir Deckung!
#. fr: Leurs mouvements sont entravés<nbsp>! Tous en renfort, vite<nbsp>!
msgctxt "InstanceContentTextData:39204:0:0"
msgid "Some manner of paralyzing effect─defend the afflicted!"
msgstr "Похоже, их парализовало! Прикройте пострадавших!"

#. ja: わたくしの炎からは逃げられませんよ？
#. de: Meinen Flammen entkommt niemand.
#. fr: Vous pensez pouvoir échapper à nos flammes ?
msgctxt "InstanceContentTextData:39205:0:0"
msgid "None can outrun my flames."
msgstr "От моего пламени не убежать."

#. ja: 炎の刃よ、降り注ぎなさい……！
#. de: Feurige Klinge, stürze hernieder.
#. fr: Ô flammes, imprégnez nos épées.
msgctxt "InstanceContentTextData:39206:0:0"
msgid "Blades of fire rain."
msgstr "Пылающие клинки, обрушьтесь с небес..."

#. ja: 何者か知らんが、なかなか楽しませてくれる！
#. de: Zu einem guten Kampf sage ich nie Nein!
#. fr: Nous ne savons pas qui vous êtes, mais votre talent nous épate !
msgctxt "InstanceContentTextData:39207:0:0"
msgid "I know not who you are, but I applaud your tenacity."
msgstr "Не знаю, кто вы, но упорство ваше достойно похвалы."

#. ja: 破壊しきれなかったか！<br>それでも……みんなの力が合わされば！
#. de: Es hat nicht gereicht?! In dem Fall<nbsp>... Alle auf sie!
#. fr: Argh, ça n'a pas marché... ! Tant pis, concentrons nos forces sur eux !
msgctxt "InstanceContentTextData:39209:0:0"
msgid "Not enough... But together, we shall triumph!"
msgstr "Не хватило... Но вместе мы победим!"

#. ja: 祝福の炎よ  武と理を以て命じる――
#. de: Flammen des Mutes, in Weisheit vereint<nbsp>...
#. fr: Ô flammes bénies, la Force et la Raison vous l'ordonnent...
msgctxt "InstanceContentTextData:39210:0:0"
msgid "Resolve and Reason kindle..."
msgstr "Решимость и разум зажигают..."

#. ja: みんな、アタシの後ろに来い！<br>なんかやばそうだ！
#. de: Schnell, hinter mich! Das sieht gefährlich aus!
#. fr: Il prépare un sale coup ! Mettez-vous tous derrière moi !
msgctxt "InstanceContentTextData:39211:0:0"
msgid "Everyone, get behind me! I've got a bad feeling about this..."
msgstr "Все за мной! Что-то мне это не нравится..."

#. ja: こいつを受けてなお、立ってられるか？
#. de: Könnt ihr dieser Stärke wirklich trotzen?
#. fr: Tiendrez-vous encore debout après cette attaque, ja ?
msgctxt "InstanceContentTextData:39212:0:0"
msgid "Will you have the strength to stand after this?"
msgstr "Выстоите ли вы после такого удара?"

#. ja: アタシは……みんなの笑顔を護る王になるんだぁぁぁ！！
#. de: Ich werde den Frieden auf Tural beschützen!
#. fr: Je deviendrai reine et je protégerai mon peuple ! Je ne perdrai paaaaas... !!
msgctxt "InstanceContentTextData:39213:0:0"
msgid "I will be the next Dawnservant...I will protect my people!"
msgstr "Я стану следующим Хранителем Рассвета... и буду защищать свой народ!"

#. ja: へへっ……。<br>アンタの力はそんなもんかよ！
#. de: Hah ...! Selbst deine gesamte Kraft war nicht genug, Alterchen!
#. fr: Hé hé... C'est tout c'que tu sais faire ?
msgctxt "InstanceContentTextData:39214:0:0"
msgid "Hehehe... Is that the best you can do?"
msgstr "Хе-хе... И это всё, на что ты способен?"

#. ja: オレの全力を受けきるとはな。<br>だが、まだだ！
#. de: Ihr steht tatsächlich noch?! Glaubt euch aber noch nicht als Sieger!
#. fr: Vous avez encaissé notre meilleure attaque... Mais ce n'est pas encore terminé !
msgctxt "InstanceContentTextData:39215:0:0"
msgid "Impressive─but I'm not finished yet!"
msgstr "Впечатляет... но я ещё не закончил!"

#. ja: あなたを超えて、ラマチを王にしてみせる！<br>トライヨラの未来のために！
#. de: Ich werde dich übertrumpfen und Lamaty'i den Thron gewinnen! Für die Zukunft Tuliyollals!
#. fr: Moi aussi, je vais te surpasser, Papa ! Afin que Lamaty'i puisse te succéder !
msgctxt "InstanceContentTextData:39216:0:0"
msgid "We will see Lamaty'i become Dawnservant. For Tuliyollal!"
msgstr "Ламатийи станет Хранителем Рассвета. Ради будущего Тулийоллала!"

#. ja: この程度で倒れてくれるなよ？
#. de: Enttäuscht mich nicht, ja?
#. fr: Vous n'avez pas intérêt à vous effondrer après ce coup-ci !
msgctxt "InstanceContentTextData:39219:0:0"
msgid "Surely you can handle this much?"
msgstr "Надеюсь, вы от такого не свалитесь?"

#. ja: これを受ければ、諦めもつくでしょう？
#. de: Wollt ihr immer noch nicht aufgeben?
#. fr: Vous serez bien obligés de déclarer forfait après cela.
msgctxt "InstanceContentTextData:39220:0:0"
msgid "Surely this will quench your thirst for battle."
msgstr "Ну что, этого хватит, чтобы утолить вашу жажду битвы?"

#. ja: 我が敵を断つ  紅蓮の刃と化せ！
#. de: Werdet zur glühenden Klinge, die unsere Feinde zerteilt!
#. fr: Transformez-vous en lame ardente et pourfendez nos ennemis !
msgctxt "InstanceContentTextData:39221:0:0"
msgid "By crimson wrath be sundered!"
msgstr "Да обратитесь вы в багряный клинок, что рассечёт врагов!"

#. ja: <split " " 1><string $gs1></split>……！<br>嘘だろ、そんな……！
#. de: <split " " 1><string $gs1></split>, nein! Das darf nicht sein!
#. fr: <split " " 1><string $gs1></split>, non... ! Pas toi... !
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:39222:0:0"
msgid "<split \" \" 1><string $gs1></split>! No... This can't be happening..."
msgstr "<split \" \" 1><string $gs1></split>! Нет... Этого не может быть..."

#. ja: 歩んで知った「理」とともに……。
#. de: Habt ihr auch an Weisheit gewonnen ...?
#. fr: Nous vous ferons entendre Raison...
msgctxt "InstanceContentTextData:39223:0:0"
msgid "And the reason which guides our journey..."
msgstr "И разумом, что указывает путь..."

#. ja: 喧嘩バカはこれだから……長引く前に終わらせますよ。
#. de: Nichts als Kämpfen im Schädel<nbsp>... Ich beende dieses alberne Spielchen.
#. fr: Tu ne sais donc pas t'arrêter... Il vaut mieux en finir au plus vite.
msgctxt "InstanceContentTextData:39224:0:0"
msgid "Ever hungry for battle..."
msgstr "Вечно рвёшься в бой... Пора покончить с этим, пока всё не затянулось."

#. ja: 燃えよ天道、進めよ吾道 発動まで　5
#. de: Pfad der Morgensonne in 5<nbsp>...
#. fr: Ardeur de l'aurore et de l'âme dans 5 secondes<nbsp>!
#, aeria-term-model-exception: Duty 1752c76d124c
msgctxt "InstanceContentTextData:39225:0:0"
msgid "5 seconds to Saga of Dawn and Duty..."
msgstr "До «Саги о рассвете и долге»: 5 сек..."

#. ja: 燃えよ天道、進めよ吾道 発動まで　4
#. de: Pfad der Morgensonne in 4<nbsp>...
#. fr: 4...
#, aeria-term-model-exception: Duty 1752c76d124c
msgctxt "InstanceContentTextData:39226:0:0"
msgid "4 seconds to Saga of Dawn and Duty..."
msgstr "До «Саги о рассвете и долге»: 4 сек..."

#. ja: 燃えよ天道、進めよ吾道 発動まで　3
#. de: Pfad der Morgensonne in 3<nbsp>...
#. fr: 3...
#, aeria-term-model-exception: Duty 1752c76d124c
msgctxt "InstanceContentTextData:39227:0:0"
msgid "3 seconds to Saga of Dawn and Duty..."
msgstr "До «Саги о рассвете и долге»: 3 сек..."

#. ja: 燃えよ天道、進めよ吾道 発動まで　2
#. de: Pfad der Morgensonne in 2<nbsp>...
#. fr: 2...
#, aeria-term-model-exception: Duty 1752c76d124c
msgctxt "InstanceContentTextData:39228:0:0"
msgid "2 seconds to Saga of Dawn and Duty..."
msgstr "До «Саги о рассвете и долге»: 2 сек..."

#. ja: 燃えよ天道、進めよ吾道 発動まで　1
#. de: Pfad der Morgensonne in 1<nbsp>...
#. fr: 1...
#, aeria-term-model-exception: Duty 1752c76d124c
msgctxt "InstanceContentTextData:39229:0:0"
msgid "1 second to Saga of Dawn and Duty..."
msgstr "До «Саги о рассвете и долге»: 1 сек..."

#. ja: これはどうです？
#. de: Könnt ihr folgen?
#. fr: Que dites-vous de ça ?
msgctxt "InstanceContentTextData:39230:0:0"
msgid "How is this?"
msgstr "Ну как вам?"

#. ja: 悪意のエルレットを倒せ！
#. de: Besiege Ellerete!
#. fr: Vainquez Ellerete l'impitoyable<nbsp>!
msgctxt "InstanceContentTextData:39300:0:0"
msgid "Defeat Ellerete!"
msgstr "Одолейте Эллерет!"

#. ja: ワタシが前へ出るわ！<br><split " " 1><string $gs1></split>は、援護をお願い！
#. de: Ich übernehme das Kämpfen, <split " " 1><string $gs1></split>!<br>Konzentrier du dich aufs Heilen!
#. fr: Je vais l'affronter au corps-à-corps<nbsp>! Je compte sur toi pour me soigner, <split " " 1><string $gs1></split><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:39301:0:0"
msgid "I'll lead the charge, <split \" \" 1><string $gs1></split>! You focus on healing!"
msgstr "Я поведу атаку, <split \" \" 1><string $gs1></split>! А ты займись лечением!"

#. ja: 私たちの邪魔をしたこと、後悔させてやるんだからぁ！
#. de: Mein süßer kleiner Feenapfel, langsam schmeckst du sauer! Ab auf den Kompost mit dir!
#. fr: Je vais vous faire regretter d'être venu<if $gn4>es<else>s</if> nous embêter<nbsp>!
msgctxt "InstanceContentTextData:39302:0:0"
msgid "My dear, sweet faerie apple... I'm afraid you've soured on me. Prepare to perish!"
msgstr "Милая, сладкая фейская ягодка... Боюсь, ты мне уже приелась. Готовься к смерти!"

#. ja: あっは、さっそく毒を味わわせてあげる！
#. de: Hehe, ein bisschen Gift hat noch keinem gescha... Oh wartet, das war gelogen!
#. fr: Puisque vous tenez tant à souffrir, prenez donc une grande rasade de venin<nbsp>!
msgctxt "InstanceContentTextData:39303:0:0"
msgid "Hee hee! A little poison never killed any─ Oh, wait. I lied. Ah, well!"
msgstr "Хи-хи! Немного яда ещё никому не вредило... Ой, погодите. Вру! Ну и ладно!"

#. ja: くっ……毒には治癒魔法で対処しましょう！
#. de: Ugh! Wir müssen dieses Gift schnell loswerden!
#. fr: Argh... Ta magie guérisseuse doit pouvoir contrer les effets<nbsp>!
msgctxt "InstanceContentTextData:39304:0:0"
msgid "Ugh! We'll need this cleansed, and quickly!"
msgstr "Тьфу! Надо скорее снять яд!"

#. ja: 次は、治癒魔法の効きが悪くなる毒なんてどう？
#. de: Wie wär's mit etwas Gift, das das Heilen erschwert?
#. fr: Mauvaise nouvelle pour vous<nbsp>: j'ai aussi un venin qui affaiblit les sorts de soin<nbsp>!
msgctxt "InstanceContentTextData:39305:0:0"
msgid "For my next trick, I give you...a venomous gift to hurt what heals you! Ta-daaa!"
msgstr "А теперь фокус с ядом... Он ослабит ваши исцеляющие заклинания! Та-да-а!"

#. ja: 祭器で扱える毒に、そんな効果のものまで……。
#. de: Dass Herzstich so eine Last sein kann<nbsp>...
#. fr: Le totem permet de faire ça aussi<nbsp>!?
msgctxt "InstanceContentTextData:39306:0:0"
msgid "Such terrible power..."
msgstr "Какая же страшная сила..."

#. ja: よぉ～し、もっと錬金薬使っちゃお！
#. de: よぉ～し、もっと錬金薬使っちゃお！
#. fr: よぉ～し、もっと錬金薬使っちゃお！
msgctxt "InstanceContentTextData:39307:0:0"
msgid "Pesky pest problems call for alchemical solutions!"
msgstr "Назойливых вредителей выведем алхимическими средствами!"

#. ja: 特製錬金薬、もっと使っちゃお～っ！
#. de: Zeit für meine Spezialmischung!
#. fr: Concoction alchimique spéciale, deuxième service<nbsp>!
msgctxt "InstanceContentTextData:39310:0:0"
msgid "Time to break out the Ellerete special!"
msgstr "Пора достать особую смесь Эллерет!"

#. ja: 良薬も過ぎれば毒になりますが、大丈夫ですかね……。
#. de: Diese Tränke werden ihren Preis fordern, wenn du nicht aufpasst.
#. fr: Euh, Ellerete... Tu sais qu'il ne faut pas abuser des bonnes choses<nbsp>?
msgctxt "InstanceContentTextData:39311:0:0"
msgid "Those tonics are bound to take their toll if she's not careful..."
msgstr "Эти снадобья ещё аукнутся, если она не будет осторожна..."

#. ja: 今度は、頭がクラクラしちゃう毒にしよ～っと！
#. de: Ha, ich hab's! Warum lassen wir nicht ein wenig die Köpfe kreisen?
#. fr: Place au venin qui fait tourner la tête<nbsp>!
msgctxt "InstanceContentTextData:39312:0:0"
msgid "Ooh, I know! Why don't we set your heads a-spinning?"
msgstr "О, придумала! Как насчёт яда, от которого голова пойдёт кругом?"

#. ja: ほらほら、急いで逃げなきゃ毒まみれだよぉ～！
#. de: Schöne Bescherung! Wir müssen schnell was unternehmen!
#. fr: À votre place, je me dépêcherais de fuir dans la bonne direction, hi hi hi<nbsp>!
msgctxt "InstanceContentTextData:39313:0:0"
msgid "Ahaha! What a marvelous mess you're in! If you don't hurry, it'll only get messier..."
msgstr "А-ха-ха! Ну и заварушка у вас вышла! Не поторопитесь — станет ещё хуже..."

#. ja: さ～てと、次はどんな毒でイタズラしちゃおっかなぁ～？
#. de: Der Spaß hat gerade erst begonnen! Wo das herkam, gibt es noch viel mehr!
#. fr: Alors, quelle farce vais-je vous jouer ensuite<nbsp>?
msgctxt "InstanceContentTextData:39314:0:0"
msgid "The hunt's only just begun, my dears! I've plenty more where that came from."
msgstr "Охота только началась, дорогуши! У меня таких ещё полно!"

#. ja: うへぇ、頭がクラクラしてきたぁ……。
#. de: Ungh, mein Kopf<nbsp>...
#. fr: Oups, je me sens pas bien, tout à coup...
msgctxt "InstanceContentTextData:39316:0:0"
msgid "Augh! M-My head..."
msgstr "А-а... Г-голова..."

#. ja: 世話が焼ける人ですね！<br>魔法人形たち、エルレットを守ってください！
#. de: Langsam nervt ihr, Leute<nbsp>...<br>Marionetten, auf eure Positionen!
#. fr: Il faut toujours que je rattrape tes âneries... En avant, mes pantins<nbsp>! Allez protéger Ellerete<nbsp>!
msgctxt "InstanceContentTextData:39317:0:0"
msgid "I grow weary of your tenacity. Mammets, to your positions!"
msgstr "Мне надоело ваше упорство. Мампеты, по местам!"

#. ja: ここはひとまず、魔法人形をどうにかしましょう！
#. de: Die Marionetten zuerst, <split " " 1><string $gs1></split>!
#. fr: On ne pourra rien faire tant que ces pantins seront là<nbsp>! Débarrassons-nous d'eux<nbsp>!
msgctxt "InstanceContentTextData:39318:0:0"
msgid "Nothing we can't handle. Let's turn them into scrap metal!"
msgstr "Да мы с ними справимся. Превратим их в металлолом!"

#. ja: ああもう……エルレット、いいかげん立て直してくださいよ！
#. de: Meine Güte, Ellerete! Komm endlich zu dir!
#. fr: Mais enfin, Ellerete, ne reste pas plantée là<nbsp>!
msgctxt "InstanceContentTextData:39319:0:0"
msgid "Oh, for the love of... Pull yourself together, Ellerete!"
msgstr "Да чтоб тебя... Эллерет, соберись уже!"

#. ja: う～っ、まだやれるもん……もっと錬金薬で強化してやるっ！
#. de: Hmpf ... Ich hab noch genug Tränke in petto!
#. fr: Ouille... Vous allez voir ce que vous allez voir... Je peux me renforcer encore plus<nbsp>!
msgctxt "InstanceContentTextData:39320:0:0"
msgid "I-I'll be fine! Just a few more draughts..."
msgstr "Я-я в порядке! Ещё пару глотков зелья..."

#. ja: この毒を見極められるかなぁ～？
#. de: Mal sehen, wie ihr mit diesem Gift klarkommt!
#. fr: Vous voulez jouer à un jeu rigolo, hi hi<nbsp>?
msgctxt "InstanceContentTextData:39321:0:0"
msgid "Can you withstand this, I wonder!?"
msgstr "Интересно, выдержите такое!?"

#. ja: 劣勢だし、不調な魔法人形も使ってみますか……。
#. de: Hm, bleibt mir wohl nichts anderes übrig,<br>als die kaputten Marionetten zu rufen.
#. fr: Vu l'urgence de la situation, mieux vaut utiliser tous nos pantins... même ceux qui sont défectueux.
msgctxt "InstanceContentTextData:39323:0:0"
msgid "\\<sigh> Desperate times, as they say... I'll summon the defective mammets."
msgstr "<i>Эх...</i> Как говорится, на крайний случай... Призову неисправных мамметов."

#. ja: ちょっと……そんな魔法人形、使って大丈夫っ！？
#. de: Sicher, dass das 'ne gute Idee ist?
#. fr: Euh... T'es sûr de ton coup<nbsp>!?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:39324:0:0"
msgid "I'm sorry, the <i>what</i>!?"
msgstr "Простите, <i>что</i>!?"

#. ja: もう、じゃんじゃん毒を撒いちゃうもんね！
#. de: Ahaha! Eine Prise Gift hier, eine Prise Gift dort!<br>Keiner soll leer ausgehen!
#. fr: Puisque c'est comme ça, je vais vous ensevelir sous des litres de venin<nbsp>!
msgctxt "InstanceContentTextData:39327:0:0"
msgid "Ahaha! Poison here, poison there, poison, poison, everywhere!"
msgstr "Ахаха! Яду сюда, яду туда, ядом всё вокруг залью!"

#. ja: 毒の処理はワタシに任せて！<br><split " " 1><string $gs1></split>は、エルレットの警戒を……！
#. de: Um das Gift kümmere ich mich!<br>Achte du auf Ellerete, <split " " 1><string $gs1></split>!
#. fr: <split " " 1><string $gs1></split>, je m'occupe de cette grosse sphère<nbsp>! Aide-moi à résister aux attaques d'Ellerete<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:39328:0:0"
msgid "Leave this to me, <split \" \" 1><string $gs1></split>. Just keep an eye on Ellerete!"
msgstr "Оставь это мне, <split \" \" 1><string $gs1></split>. А ты присмотри за Эллерет!"

#. ja: どれだけ邪魔したら気が済むわけぇ～！？
#. de: Wie hartnäckig kann man eigentlich sein?
#. fr: Mais c'est pas possible d'être aussi borné<if $gn4>es<else>s</if><nbsp>!!!
msgctxt "InstanceContentTextData:39330:0:0"
msgid "You are rotten to the core! Why do you persist!?"
msgstr "Да сколько можно мне мешать!?"

#. ja: もう最悪……どうにか相手しなきゃ……。
#. de: Verdammt ... Muss wohl zu härteren Mitteln greifen.
#. fr: J'en peux plus... Mais faut que je tienne le coup à tout prix...
msgctxt "InstanceContentTextData:39331:0:0"
msgid "Godsdamn it all..."
msgstr "Проклятье..."

#. ja: あとは私がやるから、ココノワは大人しくしてて！
#. de: Den Rest übernehme ich, Kokonowa!<br>Sei ein braver Goldschmied und mach Platz!
#. fr: Arrête d'essayer de m'aider et laisse-moi faire, Kokonowa<nbsp>!
msgctxt "InstanceContentTextData:39332:0:0"
msgid "I'll handle the rest, Kokonowa! Be a good little goldsmith and sit this out!"
msgstr "Остальное я беру на себя, Коконоу! Будь умницей и сиди в сторонке, ювелир!"

#. ja: あれぇ……れ、錬金薬の効果が……。
#. de: Nein, nein, NEIN! Meine Tränke<nbsp>...
#. fr: B-bah alors<nbsp>? La concoction... ne marche plus<nbsp>?
msgctxt "InstanceContentTextData:39333:0:0"
msgid "No, no, NO! My tonics... They've betrayed me!"
msgstr "Нет, нет, НЕТ! Мои настойки... Они меня предали!"

#. ja: 特製錬金薬で身体強化しちゃうもんねぇ～！
#. de: Ihr habt es nicht anders gewollt! Einmal Ellerete Spezial!
#. fr: Et hop<nbsp>! Une concoction alchimique spéciale pour décupler mes forces<nbsp>!
msgctxt "InstanceContentTextData:39334:0:0"
msgid "Pesky pest problems call for alchemical solutions!"
msgstr "На вредителей найдётся алхимическое средство!"

#. ja: しつこいなぁ～っ、まとめてぶっ潰してやるわ！
#. de: Lästige Würmer! Ich werd euch zerquetschen, hört ihr?
#. fr: Arrêtez de résister et laissez-moi vous écraser comme des mouches<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:39335:0:0"
msgid "Stubborn worms! I will end you─<i>do you hear me</i>!?"
msgstr "Упрямые черви! Я вас прикончу─<i>слышите</i>!?"

#. ja: 棘咲く苑への到達
#. de: Zur Nadelblüte durchschlagen
#. fr: Atteindre le Jardin épineux
msgctxt "InstanceContentTextData:39400:0:0"
msgid "Arrive in Spineblossom"
msgstr "Добраться до Колючего цветника"

#. ja: バレルテンダーの撃破
#. de: Den Kugelkaktor besiegen
#. fr: Vaincre le maousse-pampa
msgctxt "InstanceContentTextData:39401:0:0"
msgid "Defeat the barreltender"
msgstr "Победить бочкокактуса"

#. ja: 巨躯の貯水槽への到達
#. de: Zum Sagenhaften Speicher durchkämpfen
#. fr: Atteindre la Citerne colossale
msgctxt "InstanceContentTextData:39402:0:0"
msgid "Arrive at the tremendous tank"
msgstr "Добраться до исполинского резервуара"

#. ja: アンスラサイトの撃破
#. de: Den Anthrazit bezwingen
#. fr: Vaincre Anthracite
msgctxt "InstanceContentTextData:39403:0:0"
msgid "Defeat Anthracite"
msgstr "Победить Антрацита"

#. ja: 蛇壺の祭壇への到達
#. de: Zum Altar der Schlängelnden Urne vorarbeiten
#. fr: Atteindre l'Autel de l'Urne serpentine
msgctxt "InstanceContentTextData:39404:0:0"
msgid "Arrive at the Altar of the Urn Exulted"
msgstr "Добраться до алтаря Змеиной урны"

#. ja: トラルの大蛇？の撃破
#. de: Die Größte Schlange von Tural besiegen
#. fr: Vaincre le grand serpent du Tural<nbsp>?
msgctxt "InstanceContentTextData:39405:0:0"
msgid "Defeat the greatest serpent of Tural"
msgstr "Победить величайшего змея Турала"

#. ja: 両翼ニ集イシ「番兵タチ」ヨ……！<br>眼ニ怒リヲ宿シ、聖域ヲ侵ス者ニ罰ヲ！
#. de: Breitschwingen! Richtet euren zornigen Blick auf die Eindringlinge, die den heiligen Boden betraten!
#. fr: Protecteurs<nbsp>! PUNISSEZ ceux qui envahissent le sanctuaire<nbsp>!
msgctxt "InstanceContentTextData:39406:0:0"
msgid "Open your eyes, and purge the sanctuary of this taint!"
msgstr "Откройте глаза и очистите святилище от скверны!"

#. ja: 「番兵タチ」ヨ、<br>ソノ眼デ捉エシ者ニ、怒リヲ解キ放テ！
#. de: Breitschwingen! Entfesselt euren zornigen Blick und strafet sie!
#. fr: Protecteurs<nbsp>! Libérez votre COLÈRE<nbsp>!
msgctxt "InstanceContentTextData:39407:0:0"
msgid "Guardians of the sanctuary─in the name of the great serpent, I bid you awaken!"
msgstr "Стражи святилища─именем великого змея повелеваю вам пробудиться!"

#. ja: 暴れている魔物を倒せ！
#. de: Besiege die Kreaturen!
#. fr: Abattez les créatures<nbsp>!
msgctxt "InstanceContentTextData:39500:0:0"
msgid "Defeat the rampaging beasts!"
msgstr "Одолейте разбушевавшихся чудовищ!"

#. ja: ケシュカと会話しろ
#. de: Mit Keshkwa sprechen
#. fr: Parlez à Keshkwa
msgctxt "InstanceContentTextData:39501:0:0"
msgid "Speak with Keshkwa"
msgstr "Поговорить с Кешквой"

#. ja: 「蛇尾撃」を使え
#. de: Todesrasseln benutzen
#. fr: Utilisez Cascabelle mortelle
msgctxt "InstanceContentTextData:39502:0:0"
msgid "Use Death Rattle"
msgstr "Использовать «Предсмертный хрип»"

#. ja: 「参の牙【側撃】」を使え
#. de: Flankenbiss benutzen
#. fr: Utilisez Saignée du flanc
msgctxt "InstanceContentTextData:39503:0:0"
msgid "Use Flanksting Strike"
msgstr "Использовать «Удар в бок»"

#. ja: 「参の牙【側裂】」を使え
#. de: Flankenreißer benutzen
#. fr: Utilisez Déchirement du flanc
msgctxt "InstanceContentTextData:39504:0:0"
msgid "Use Flanksbane Fang"
msgstr "Использовать «Разрыв бока»"

#. ja: 「参の牙【背撃】」を使え
#. de: Nackenbiss benutzen
#. fr: Utilisez Saignée de l'échine
msgctxt "InstanceContentTextData:39505:0:0"
msgid "Use Hindsting Strike"
msgstr "Использовать «Удар в спину»"

#. ja: 「参の牙【背裂】」を使え
#. de: Nackenreißer benutzen
#. fr: Utilisez Déchirement de l'échine
msgctxt "InstanceContentTextData:39506:0:0"
msgid "Use Hindsbane Fang"
msgstr "Использовать «Разрыв спины»"

#. ja: 「弐の蛇【猛襲】」を使え
#. de: Blutiger Otterngriff benutzen
#. fr: Utilisez Anneaux du prédateur
msgctxt "InstanceContentTextData:39507:0:0"
msgid "Use Hunter's Coil"
msgstr "Использовать «Виток охотника»"

#. ja: 「弐の蛇【疾速】」を使え
#. de: Flinker Otterngriff benutzen
#. fr: Utilisez Anneaux de l'écorcheur
msgctxt "InstanceContentTextData:39508:0:0"
msgid "Use Swiftskin's Coil"
msgstr "Использовать «Виток быстрокожего»"

#. ja: 「双牙連撃」を使え
#. de: Biss der Zwillingsfänge benutzen
#. fr: Utilisez Morsure vicieuse
msgctxt "InstanceContentTextData:39509:0:0"
msgid "Use Twinfang Bite"
msgstr "Использовать «Укус двух клыков»"

#. ja: 「双牙乱撃」を使え
#. de: Biss der Zwillingsschuppen benutzen
#. fr: Utilisez Morsure frénétique
msgctxt "InstanceContentTextData:39510:0:0"
msgid "Use Twinblood Bite"
msgstr "Использовать «Укус двух кровей»"

#. ja: ワンダリング・ガウロウを倒せ！
#. de: Besiege den streunenden Gowrow!
#. fr: Abattez le gowrow errant<nbsp>!
msgctxt "InstanceContentTextData:39511:0:0"
msgid "Defeat the wandering gowrow"
msgstr "Победить бродячего говроу"

#. ja: ふむ、どうやら親玉は隠れて様子を窺っているらしい。<br>眼前にいるのは、雑魚ばかりだな。
#. de: Die sind nur Kleinvieh. Das Alphatier liegt irgendwo auf der Lauer.
#. fr: Hum... On dirait que l'alpha de la meute cherche à nous tester. Il n'a fait qu'envoyer du menu fretin pendant qu'il reste caché...
msgctxt "InstanceContentTextData:39512:0:0"
msgid "If there are any meaner beasties, they must be biding their time. All I see here is fodder."
msgstr "Если тут есть кто покрупнее, он пока выжидает. А я вижу одну мелочь."

#. ja: だが、ヴァイパーの感覚を掴むにはちょうどいい相手だろう。
#. de: Aber das Rudel ist gut geeignet, um die Kunst der Schlange zu lernen.
#. fr: C'est l'occasion rêvée pour t'apprendre à combattre comme <if $gn4>une vraie rôdeuse vipère<else>un vrai rôdeur vipère</if>.
msgctxt "InstanceContentTextData:39513:0:0"
msgid "Though for practicing your new skills, they'll do fine."
msgstr "Но для отработки новых приёмов сгодятся."

#. ja: この戦いは、技の指南も兼ねているからな。<br>俺は、指示を出すことに専念しよう。
#. de: Keine Sorge, ich werde dir alles genau erklären, Jungviper.
#. fr: Je vais rester en retrait pour te donner des in<shy>struc<shy>tions. Essaye de les mettre en pratique durant cet af<shy>fron<shy>te<shy>ment.
msgctxt "InstanceContentTextData:39514:0:0"
msgid "I'll stay outta your way, and give you a few pointers."
msgstr "Я не буду тебе мешать, только кое-что подскажу."

#. ja: さっそくだが、ヴァイパーの基本を伝えたい。<br>まずは、俺に声をかけてくれ。
#. de: Als Erstes zeige ich dir den Basisangriff. Komm mal her.
#. fr: Viens me voir, je vais commencer par t'enseigner les techniques de base des rôdeurs vipère.
msgctxt "InstanceContentTextData:39515:0:0"
msgid "Lemme know when you're ready."
msgstr "Дай знать, когда будешь готово. <if $gn4>Готова<else>Готов</if>?"

#. ja: 見事だ！　やはり筋がいいな。<br>今のが、ヴァイパーの基本的な攻撃となる。
#. de: Sehr gut! Mein Instinkt hat mich nicht getäuscht: Du hast das Kämpfen im Blut.
#. fr: Eh bien<nbsp>! On peut dire que tu es <if $gn4>une naturelle<else>un naturel</if>. Tu as déjà maîtrisé les rudiments de notre art.
msgctxt "InstanceContentTextData:39516:0:0"
msgid "Not bad at all! These techniques are some of the most important tools in your kit."
msgstr "Неплохо! Эти приёмы станут твоим главным оружием."

#. ja: 今のうちに「牙の構え」による連続攻撃も教えておきたい。<br>一度、こちらに戻ってきてくれ。
#. de: Als Nächstes zeige ich dir eine Angriffsserie aus einer der zwei Grundhaltungen. Komm noch einmal her.
#. fr: Je vais en profiter pour t'expliquer comment enchaîner les attaques dans la Posture des crochets. Reviens me voir.
msgctxt "InstanceContentTextData:39517:0:0"
msgid "C'mon over here, and I'll tell you about attacking from Dual Fang stance."
msgstr "Иди-ка сюда, расскажу, как атаковать в стойке двух клыков."

#. ja: 参の牙には【側撃（そくげき）】【側裂（そくれつ）】、<br>【背撃（はいげき）】【背裂（はいれつ）】の4種類がある……。
#. de: Der dritte Biss hat vier Varianten: Flankenbiss, Flankenreißer, Nackenbiss und Nackenreißer.<br>Übe sie an dem Kleinvieh!
#. fr: Il existe quatre techniques pour terminer la Posture des crochets. Saignée du flanc, Déchirement du flanc, Saignée de l'échine et Déchirement de l'échine...
msgctxt "InstanceContentTextData:39518:0:0"
msgid "You can wrap up your combination with Flanksting Strike, Flanksbane Fang, Hindsting Strike, or Hindsbane Fang."
msgstr "Завершить серию можно одним из четырёх приёмов: «Удар в бок», «Разрыв бока», «Удар в спину» или «Разрыв спины»."

#. ja: 壱の牙【咬創（こうそう）】や壱の牙【穿裂（せんれつ）】から、<br>連続攻撃を決めることで、4種の技が繰り出せるぞ！
#. de: Beginne deine Serie mit Tödliche Fänge oder Tückische Fänge, und kombiniere dann die anderen vier Arten.
#. fr: Pour pouvoir les utiliser, tu dois réussir d'abord ton enchaînement de techniques, démarrant par Crochets d'acier ou Crochets mortels<nbsp>!
msgctxt "InstanceContentTextData:39519:0:0"
msgid "Open a sequence with Steel Fangs or Reaving Fangs and work your way up to one of the four finishers."
msgstr "Начни серию с «Стальных клыков» или «Разящих клыков» и доведи её до одного из четырёх завершающих приёмов."

#. ja: 「牙の構え」による連続攻撃を会得したようだな。<br>さすがだ、<split " " 1><string $gs1></split>！
#. de: Bravo, <split " " 1><string $gs1></split>. Du hast die Angriffsserie aus der Biss-Haltung gut gelernt.
#. fr: Tu as maîtrisé la Posture des crochets en un rien de temps<nbsp>! Je ne m'étais pas trompé sur ton compte, <split " " 1><string $gs1></split><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:39520:0:0"
msgid "Good work, <split \" \" 1><string $gs1></split>. Looks like you got the hang of Dual Fang stance."
msgstr "Отлично, <split \" \" 1><string $gs1></split>. Похоже, стойку двух клыков ты освои<if $gn4>ла<else>л</if>."

#. ja: 今の咆哮に反応して……連中、いっせいに移動し始めたな。
#. de: Das Rudel hört auf das Geheul! Die Tiere bewegen sich aufeinander abgestimmt!
#. fr: La meute a réagi au hurlement... Elle a commencé à se déplacer de manière coordonnée.
msgctxt "InstanceContentTextData:39521:0:0"
msgid "That roar just now... Almost like it was telling 'em to clear out."
msgstr "Этот рёв... Будто он велел им отступить."

#. ja: 群れの親玉が、どこかに潜み指示を出しているらしい。<br>さては、より強力な魔物を差し向けたな……！
#. de: Das Alphatier gibt aus seinem Versteck Anweisungen. Es schickt ein besonders großes Exemplar rüber<nbsp>...
#. fr: L'alpha doit nous observer depuis sa cachette pour donner des in<shy>struc<shy>tions aussi précises... Ne baisse pas ta garde, <split " " 1><string $gs1></split><nbsp>! Il nous a envoyé des adversaires plus coriaces<nbsp>!
msgctxt "InstanceContentTextData:39522:0:0"
msgid "I reckon there's a big ol' bastard waiting in the wings. And now it's sent us tougher opposition!"
msgstr "Похоже, где-то прячется здоровенный гад. И вот он подослал противников покрепче!"

#. ja: ずいぶんとデカい敵が現れたものだ……。<br>また別の技を伝えたいので、準備ができたら声をかけてくれ。
#. de: Sie versuchen, uns mit ihrer Überzahl zu überwältigen. Komm zurück, ich zeige dir eine neue Technik.
#. fr: Le gros gibier est de sortie... Reviens me voir, je connais quelques bottes secrètes adaptées à cette situation.
msgctxt "InstanceContentTextData:39523:0:0"
msgid "Lucky for you, I got just the thing for dealing with lummoxes like them. I'll tell you all about it when you're ready."
msgstr "Повезло тебе: у меня как раз есть приём против таких громил. Расскажу, когда будешь готов."

#. ja: 二刀を結合させた「蛇の構え」による剣術なら、<br>より高い威力の技を放つことができる。
#. de: Halte die zwei Schwerter zusammen, um die Schlangen-Haltung zu formen. So kannst du noch größere Kräfte entfesseln.
#. fr: Avec tes épées assemblées en Posture du serpent, tu es capable d'infliger des attaques encore plus mortelles<nbsp>!
msgctxt "InstanceContentTextData:39524:0:0"
msgid "Viper stance allows you to use your dual blades as a single weapon and bring everything you've got to bear!"
msgstr "Стойка вайпера позволяет соединить клинки в одно оружие и вложить в удар всю силу!"

#. ja: そこから牙の構えによる、双牙連撃（そうがれんげき）や、<br>双牙乱撃（そうがらんげき）へも繋げられるぞ！
#. de: Du kannst von dort in die Biss-Haltung wechseln und deinen Angriff mit Biss der Zwillingsfänge oder Biss der Zwillingsschuppen fortsetzen.
#. fr: Si tu utilises les techniques dans le bon ordre, tu pourras conclure ton assaut avec Morsure vicieuse ou Morsure frénétique<nbsp>!
msgctxt "InstanceContentTextData:39525:0:0"
msgid "You can even swap back into Dual Fang stance for Twinfang Bite or Twinblood Bite."
msgstr "А потом можно вернуться в стойку двух клыков и продолжить атаку «Укусом двух клыков» или «Укусом двух кровей»."

#. ja: よし、「蛇の構え」による剣術も覚えられたようだな。
#. de: Gut, Jungviper. Du hast die Schlangen-Haltung gelernt.
#. fr: Im<shy>pres<shy>sionnant<nbsp>! La Posture du serpent n'a déjà plus de secrets pour toi.
msgctxt "InstanceContentTextData:39526:0:0"
msgid "Alright, you got the hang of viper, I'd say."
msgstr "Ну вот, теперь ты <if $gn4>освоила<else>освоил</if> искусство вайпера."

#. ja: 咆哮がさらに近くへ……。<br>俺たちを倒せないことに、苛立ってきたらしい。
#. de: Die Rufe des Alphatiers kommen näher. Dass wir noch stehen, macht es rasend.
#. fr: Les hurlements de l'alpha se font de plus en plus proches... Il doit être frustré de nous voir toujours debout.
msgctxt "InstanceContentTextData:39527:0:0"
msgid "That roaring's getting closer. Boss beast must be pissed that its minions keep getting beat."
msgstr "Рёв всё ближе. Главарь, похоже, злится, что его приспешников раз за разом одолевают."

#. ja: どうやら、ついに親玉がお出ましのようだ……！
#. de: Es ist soweit. Das Alphatier zeigt sich.
#. fr: Mon flair ne m'a pas trompé, voilà l'alpha en chair et en os<nbsp>!
msgctxt "InstanceContentTextData:39528:0:0"
msgid "Heh, and there it is!"
msgstr "Хех, а вот и он!"

#. ja: さあ、親玉との決戦だ！<br>さすが、雑魚とは段違いの風格を漂わせているな。
#. de: Da ist das Alphatier! Das werden wir nicht so schnell los wie die anderen!
#. fr: Il est temps d'en finir<nbsp>! Pas besoin d'un dessin de pictomancien pour comprendre que l'alpha nous donnera plus de fil à retordre que ses sous-fifres.
msgctxt "InstanceContentTextData:39529:0:0"
msgid "Time to take it down a peg or three. Just remember what you're dealing with here─it ain't no pushover like the rest."
msgstr "Пора сбить с него спесь. Только помни, с кем имеешь дело: это тебе не какая-то мелочь."

#. ja: だが、ここまでに授けたヴァイパーの技を使えば、<br>決して恐れる相手ではない。
#. de: Benutze alle Techniken, die ich dir gezeigt habe! Dann wirst du auch mit diesem Gegner fertig.
#. fr: Sors tes crocs, <split " " 1><string $gs1></split>. Fais-lui sentir la douloureuse morsure d'<if $gn4>une rôdeuse vipère<else>un rôdeur vipère</if><nbsp>!
msgctxt "InstanceContentTextData:39530:0:0"
msgid "Still, you got all the tools you need at your disposal."
msgstr "Но теперь у тебя есть всё, чтобы с ним справиться."

#. ja: <split " " 1><string $gs1></split>、奴を倒し、ヴァイパーとしての使命を果たすんだ！
#. de: Erfülle den Willen der Natur, Jungviper!
#. fr: Utilise contre lui les techniques que tu viens d'apprendre pour me prouver que tu es un<if $gn4>e</if> des nôtres<nbsp>!
msgctxt "InstanceContentTextData:39531:0:0"
msgid "Show it what a viper can do!"
msgstr "Покажи ему, на что ты <if $gn4>способна<else>способен</if> как вайпер!"

#. ja: 絶え間ない連続攻撃こそ、ヴァイパーの真髄。<br>剣技を繋げて、眼前の獲物に喰らいつけ！
#. de: Nutze deine Angriffsserien! Lass ihn deine Bisse und die Macht der Schlange spüren!
#. fr: Attaque sans relâche, ne lui laisse aucune chance de riposter. Bondis sur ta proie et mords-la, pourfends-la de tes lames acérées<nbsp>!
msgctxt "InstanceContentTextData:39532:0:0"
msgid "Unrelenting attacks are the key! Don't give your prey a chance to fight back!"
msgstr "Главное — не прекращай атаковать! Не дай добыче опомниться!"

#. ja: 余裕があれば、敵との間合いや立ち位置も意識してみろ。<br>そうして、もっとも有効な一撃を叩き込むんだ！
#. de: Achte auf den richtigen Zeitpunkt und deine Position! Der Kampf der Viper ist wie ein Tanz.
#. fr: Mais reste aussi vigilant<if $gn4>e</if>, choisis le bon moment pour attaquer ou prendre de la distance. Saisis la moindre opportunité pour porter un coup décisif<nbsp>!
msgctxt "InstanceContentTextData:39533:0:0"
msgid "Some attacks work better from certain positions, so mind your footwork!"
msgstr "Некоторые удары лучше наносить с определённой позиции, так что следи за движениями!"

#. ja: イクソク・シュマジュンを倒せ！
#. de: Besiege Iq Soq Xmajun!
#. fr: Vainquez Iq Soq Xmajun<nbsp>!
msgctxt "InstanceContentTextData:39600:0:0"
msgid "Defeat Iq Soq Xmajun!"
msgstr "Победить Ик Сок Шмаджуна!"

#. ja: イクソク・シュマジュンよ。<br>遠慮はいりません、蹂躙なさい！
#. de: Nimm dir deine Beute, mein Süßer!
#. fr: C'est l'heure de passer à table, mon mignon<nbsp>!
msgctxt "InstanceContentTextData:39601:0:0"
msgid "Iq Soq Xmajun! Give me a bloody spectacle!"
msgstr "Ик Сок Шмаджун! Устрой мне кровавое зрелище!"

#. ja: すぐ終わってしまっては、つまらない……。<br>どうか、面白い戦いを見せてくださいね？
#. de: Aber sei nicht zu gierig. Ich möchte ihr Leiden genießen.
#. fr: Mais ne te bâfre pas pour autant... Laisse-moi prendre le temps de savourer leur souffrance.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:39602:0:0"
msgid "I would hate for this to end <i>too</i> quickly. Why not toy with them a little?"
msgstr "Не хотелось бы, чтобы всё закончилось <i>слишком</i> быстро. Может, немного помучаешь их?"

#. ja: ……思ったより、やりますね。<br>イクソク・シュマジュン、本気を出しなさい！
#. de: Sie sind zäher, als ich dachte. Zeig keine Gnade, Iq Soq Xmajun!
#. fr: Ces pièces de viande sont plus coriaces que je ne l'imaginais... Iq Soq Xmajun, mets les bouchées doubles<nbsp>!
msgctxt "InstanceContentTextData:39603:0:0"
msgid "Worthy foes indeed... Iq Soq Xmajun, the time for games is over!"
msgstr "Вот это противники... Ик Сок Шмаджун, хватит игр!"

#. ja: な、なんです、その攻撃は……！<br>どこを狙っているのです！？
#. de: Was soll das? Das war ein jämmerlicher Angriff!
#. fr: Je t'ai pourtant dit d'arrêter de jouer avec la nourriture<nbsp>! Quelle attaque pitoyable<nbsp>!
msgctxt "InstanceContentTextData:39604:0:0"
msgid "What was that!? Some underhanded tactic, no doubt..."
msgstr "Что это было!? Небось, какой-то грязный приём..."

#. ja: 貴方が本気を出せば、こんな連中など……！<br>もう……さっさと、殺してしまいなさい！
#. de: Hör auf, mit dem Essen zu spielen! Bring den Kampf zu Ende!
#. fr: Tu n'es pas dans ton assiette, ou quoi<nbsp>? Allez, remue-toi l'arrière-train<nbsp>!
msgctxt "InstanceContentTextData:39605:0:0"
msgid "Is this the limit of your power!? Kill them! Now!"
msgstr "Это всё, на что ты способен!? Убей их! Немедленно!"

#. ja: ど、どうしたのです！<br>何故、動きを止めてしまうのですか！？
#. de: Es reicht, du lahmes Ding! Töte sie endlich!
#. fr: Ma patience a ses limites, sale bête... Sois un bon garçon et finis ton assiette<nbsp>!
msgctxt "InstanceContentTextData:39606:0:0"
msgid "Move, you great brute, move!"
msgstr "Шевелись, здоровенная туша, шевелись!"

#. ja: イクソク・シュマジュン……指示を聞きなさい！<br>全力で、連中を縊り殺すのです！
#. de: Tu was ich sage, Iq Soq Xmajun! Stampf sie endlich in Grund und Boden!
#. fr: Arrête de buller, Iq Soq Xmajun<nbsp>! Réduis en charpie ces ballerines avec leurs épées ridicules<nbsp>!
msgctxt "InstanceContentTextData:39607:0:0"
msgid "Do as I say! Tear them asunder!"
msgstr "Делай, что велю! Разорви их на куски!"

#. ja: ここで負けるわけにはいかない……！<br>気を抜くなよ、<split " " 1><string $gs1></split>！
#. de: Er kommt direkt auf uns zu! Mach dich bereit, <split " " 1><string $gs1></split>!
#. fr: C'est lui ou nous, <split " " 1><string $gs1></split><nbsp>! Reste concentré<if $gn4>e</if><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:39608:0:0"
msgid "We can't afford any mistakes! Stay sharp, <split \" \" 1><string $gs1></split>!"
msgstr "Нельзя ошибаться! Будь начеку, <split \" \" 1><string $gs1></split>!"

#. ja: しかし、かすかに漂う、この匂いは……？。
#. de: Dieser Geruch ... Er kommt mir bekannt vor.
#. fr: Cette odeur... Elle m'est familière.
msgctxt "InstanceContentTextData:39609:0:0"
msgid "Wait─what's that smell?"
msgstr "Постой... Что это за запах?"

#. ja: イクソク・シュマジュンの様子がおかしい……。<br>これは、もしや……。
#. de: Irgendetwas ist mit Iq Soq Xmajun. Und ich glaube, ich weiß, was er hat.
#. fr: Iq Soq Xmajun a l'air patraque... Et je crois savoir ce qui l'affecte...
msgctxt "InstanceContentTextData:39610:0:0"
msgid "Something's wrong with Iq Soq Xmajun. Don't tell me..."
msgstr "С Ик Сок Шмаджуном что-то не так. Только не говорите, что..."

#. ja: そうか……わかったぞ！<br>イノセント・ストークの大きな過ちに……！
#. de: Unschuldiger Storch hat gar nichts verstanden.
#. fr: Mais oui, c'est bien sûr<nbsp>! Innocent Storck a commis une erreur gravissime...
msgctxt "InstanceContentTextData:39611:0:0"
msgid "That's it! Innocent Stork's made a huge mistake!"
msgstr "Вот оно! Невинный Аист совершил ужасную ошибку!"

#. ja: いよいよ、本領発揮か！<br><split " " 1><string $gs1></split>、敵から目を離すなよ！
#. de: Jetzt geht es ums Ganze! <split " " 1><string $gs1></split>, sei auf der Hut!
#. fr: On passe enfin aux choses sérieuses<nbsp>! <split " " 1><string $gs1></split>, ne baisse pas ta garde<nbsp>!
msgctxt "InstanceContentTextData:39612:0:0"
msgid "Looks like it's through messing around. Keep it together!"
msgstr "Похоже, шутки кончились. Не теряй головы!"

#. ja: なんだ……今の攻撃は……！？
#. de: Achte auf seine Flügel! Ihre Wucht ist tödlich!
#. fr: C'était quoi, cette attaque<nbsp>!?
msgctxt "InstanceContentTextData:39613:0:0"
msgid "That packed a punch!"
msgstr "Вот это мощь!"

#. ja: ●クッ……翼に魔力を溜めこんでいたのか……！<br>今のを、何度も喰らうとまずいな……。
#. de: Verdammt, er hat noch viel Leben in sich. Das halten wir nicht oft aus.
#. fr: Il a de la ressource... Je reconnais bien là mon ennemi juré. Je ne pourrais pas en encaisser beaucoup, des comme ça<nbsp>!
msgctxt "InstanceContentTextData:39614:0:0"
msgid "So it's gathered some kinda energy in its wings... Can't take too many hits like that!"
msgstr "Значит, он накопил какую-то энергию в крыльях... Таких ударов много не выдержать!"

#. ja: ゴリアスの言葉どおりのようだ。<br>奴が翼を広げたら、危険な攻撃を放つ前兆……！
#. de: Verdammt, er macht sich auf eine nächste Runde bereit!
#. fr: Golias avait raison. Quand il déploie ses ailes, c'est le signe qu'il se prépare à lancer une attaque dévastatrice<nbsp>!
msgctxt "InstanceContentTextData:39615:0:0"
msgid "Golias is right. When it spreads its wings, get ready for a huge attack!"
msgstr "Голиас прав. Расправит крылья — готовится к мощной атаке!"

#. ja: 今度は、ふたりで力をあわせて攻撃を食い止めるんだ！
#. de: Wir müssen seiner Attacke gemeinsam standhalten!
#. fr: On doit se coordonner pour l'empêcher de nous achever<nbsp>!
msgctxt "InstanceContentTextData:39616:0:0"
msgid "C'mon! Together, now!"
msgstr "Ну же! Вместе!"

#. ja: きたぞ！<br>奴の翼を攻撃して、動きを止めるんだ！
#. de: Jetzt! Seine Flügel sind verwundbar. Gib alles, was du hast!
#. fr: C'est le moment<nbsp>! Ses ailes sont vulnérables, donne tout ce que tu as<nbsp>!
msgctxt "InstanceContentTextData:39617:0:0"
msgid "Go for the wings! Keep it pinned down!"
msgstr "За крылья! Не давай ему двигаться!"

#. ja: やるな、<split " " 1><string $gs1></split>！<br>次は、もう片方の翼を！
#. de: So ist gut, <split " " 1><string $gs1></split>! Jetzt der andere Flügel!
#. fr: C'est bien <if $gn4>la<else>le</if> redoutable <split " " 1><string $gs1></split> que je connais<nbsp>! Encore une aile<nbsp>!
msgctxt "InstanceContentTextData:39618:0:0"
msgid "You did it! Now for the other wing!"
msgstr "Получилось! Теперь за другое крыло!"

#. ja: よし、奴の攻撃を封じたぞ！
#. de: Gut! Diese Gefahr wär gebannt!
#. fr: Haha<nbsp>! Tu fais moins le malin, maintenant<nbsp>!
msgctxt "InstanceContentTextData:39619:0:0"
msgid "That did the trick!"
msgstr "Вот и всё!"

#. ja: 一気に畳み掛けるぞ……！<br>これ以上、奴の被害を増やしてなるものか！
#. de: Beenden wir jetzt die Schreckensherrschaft von Iq Soq Xmajun!
#. fr: Il est temps d'en finir<nbsp>! Mettons un terme au règne de terreur d'Iq Soq Xmajun<nbsp>!
msgctxt "InstanceContentTextData:39620:0:0"
msgid "Don't hold back! It won't escape me again!"
msgstr "Не сдерживайся! На этот раз он от меня не уйдёт!"

#. ja: 奴の様子が……？<br>おふたりとも、気をつけてください！
#. de: Vorsicht! Er sammelt Kraft in seinen Flügeln!
#. fr: Faites attention<nbsp>! Je sens le coup fourré...
msgctxt "InstanceContentTextData:39621:0:0"
msgid "It's acting strangely! Be careful!"
msgstr "Он ведёт себя странно! Осторожно!"

#. ja: クッ、このままでは……！<br>だが……もう……誰もやらせはしない！！
#. de: Verdammt<nbsp>... Aber das werde ich<nbsp>... nicht zulassen!
#. fr: Argh...<nbsp>! Je suis à bout... Mais hors de question d'abandonner<nbsp>!!
msgctxt "InstanceContentTextData:39622:0:0"
msgid "Godsdammit... This ain't over, not by a long shot!"
msgstr "Проклятье... Это ещё не конец, даже близко!"

#. ja: <split " " 1><string $gs1></split>、大丈夫か！？
#. de: Lebst du noch, <split " " 1><string $gs1></split>?
#. fr: <split " " 1><string $gs1></split>, ça va<nbsp>!?
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:39623:0:0"
msgid "<split \" \" 1><string $gs1></split>! You alright?"
msgstr "<split \" \" 1><string $gs1></split>! Ты в порядке?"

#. ja: ……翼です！<br>奴は、翼に力を集めて攻撃をしています！
#. de: Die Flügel! Er sammelt Kraft für einen Angriff in seinen Flügeln!
#. fr: Ses ailes<nbsp>! Il concentre une grande quantité d'énergie dans ses ailes<nbsp>!
msgctxt "InstanceContentTextData:39624:0:0"
msgid "The wings! They accumulate aether before the beast strikes!"
msgstr "Крылья! Перед атакой зверь накапливает в них эфир!"

#. ja: ソリューション・ナインを護り抜け！
#. de: Verteidige Lösung Neun!
#. fr: Défendez Solution Neuf<nbsp>!
msgctxt "InstanceContentTextData:39700:0:0"
msgid "Defend Solution Nine!"
msgstr "Защитить Девятый предел!"

#. ja: 機械兵をせん滅せよ
#. de: Bezwinge die Maschinensoldaten!
#. fr: Éliminez les sentinelles<nbsp>!
msgctxt "InstanceContentTextData:39701:0:0"
msgid "Eliminate the mechanical soldiers"
msgstr "Уничтожить механических солдат"

#. ja: 逃げ遅れた人を探せ
#. de: Suche die zurückgebliebenen Bewohner!
#. fr: Retrouvez les survivants<nbsp>!
msgctxt "InstanceContentTextData:39702:0:0"
msgid "Search for stragglers"
msgstr "Найти отставших"

#. ja: 魔物をせん滅せよ
#. de: Erledige die Bestien!
#. fr: Éliminez les monstres<nbsp>!
msgctxt "InstanceContentTextData:39703:0:0"
msgid "Eliminate the fiends"
msgstr "Уничтожить чудовищ"

#. ja: エーテライト・プラザに向かえ
#. de: Eile zum Ätherytenplatz!
#. fr: Dirigez-vous vers la place de l'Éthérite<nbsp>!
#, aeria-term-model-exception: Head 0245bca5e3f6
msgctxt "InstanceContentTextData:39704:0:0"
msgid "Head to the aetheryte plaza"
msgstr "Направляйтесь на площадь к эфириту"

#. ja: 住民たちに声をかけろ
#. de: Kümmere dich um die Überlebenden!
#. fr: Réconfortez les habitants<nbsp>!
msgctxt "InstanceContentTextData:39705:0:0"
msgid "Comfort the citizens"
msgstr "Утешить жителей"

#. ja: 機械兵をせん滅せよ
#. de: Bezwinge die Maschinensoldaten!
#. fr: Éliminez les sentinelles<nbsp>!
msgctxt "InstanceContentTextData:39706:0:0"
msgid "Eliminate the mechanical soldiers"
msgstr "Уничтожить механических солдат"

#. ja: 敵部隊を撃退せよ
#. de: Dränge die Maschinensoldaten zurück!
#. fr: Repoussez les troupes ennemies<nbsp>!
msgctxt "InstanceContentTextData:39707:0:0"
msgid "Repel the mechanical soldiers"
msgstr "Отбросить механических солдат"

#. ja: オーティスを消耗させろ！
#. de: Bekämpfe Otis, bis ihm die Kraft ausgeht!
#. fr: Épuisez Otis<nbsp>!
msgctxt "InstanceContentTextData:39708:0:0"
msgid "Subdue Otis!"
msgstr "Одолеть Отиса!"

#. ja: 魔物をせん滅せよ
#. de: Bekämpfe die Bestie!
#. fr: Éliminez le monstre<nbsp>!
msgctxt "InstanceContentTextData:39709:0:0"
msgid "Defeat the fiend"
msgstr "Победить чудовище"

#. ja: エーテルの吸収を阻止せよ
#. de: Verhindere die Energieaufnahme!
#. fr: Stoppez l'absorption d'éther<nbsp>!
msgctxt "InstanceContentTextData:39710:0:0"
msgid "Stop the fiend from absorbing lightning"
msgstr "Не дать чудовищу поглотить молнию"

#. ja: オーティスが力尽きる前に魔物を倒せ！
#. de: Bezwinge die Bestie, bevor Otis die Kraft ausgeht!
#. fr: Éliminez le monstre tant qu'Otis tient debout<nbsp>!
msgctxt "InstanceContentTextData:39711:0:0"
msgid "Defeat the fiend before Otis succumbs!"
msgstr "Победите чудовище, пока Отис не пал!"

#. ja: お願いみんな、力を貸して……！
#. de: Bitte, leiht mir eure Kraft ...!
#. fr: S'il vous plaît... prêtez-moi votre force<nbsp>!
msgctxt "InstanceContentTextData:39712:0:0"
msgid "Please, everyone, lend me your strength."
msgstr "Пожалуйста, все, поделитесь со мной силами..."

#. ja: 構造物の移動なら、私の権限でも……！<br>少しだけ待ってて！
#. de: Mit meiner Befugnis kann ich auf Elektrob-Konstrukte zugreifen<nbsp>... Einen Moment ...!
#. fr: Je me charge de nous ouvrir le chemin<nbsp>! Ma qualité de souveraine de la Raison me le permet<nbsp>!
msgctxt "InstanceContentTextData:39713:0:0"
msgid "I have authority enough to move structures. A moment!"
msgstr "Моих полномочий должно хватить, чтобы передвинуть конструкции. Подождите!"

#. ja: これで……！<br>この先のみんなを、どうか、お願い……！
#. de: Geschafft<nbsp>... \<keuch> Bitte<nbsp>... rettet mein Volk ...!
#. fr: Ça y est, nous pouvons passer<nbsp>! S'il vous plaît... secourez les survivants de votre mieux<nbsp>!
msgctxt "InstanceContentTextData:39714:0:0"
msgid "There... Now, please help as many as you can!"
msgstr "Вот... Теперь, пожалуйста, помогите всем, кому сможете!"

#. ja: さぁ、まずはこいつらを片付けようぜ！
#. de: Lasst uns zuerst hier aufräumen!
#. fr: On s'occupe de ceux-là d'abord<nbsp>!
msgctxt "InstanceContentTextData:39715:0:0"
msgid "Right, let's deal with these ones first!"
msgstr "Ладно, сначала разберёмся с этими!"

#. ja: まだ救える人が大勢いるはず！<br>ほかを探しましょう！
#. de: Wir können noch viel mehr Leute retten! Lasst uns weitersuchen!
#. fr: Plein de gens doivent encore être en vie<nbsp>! Dépêchons-nous de les mettre en sécurité<nbsp>!
msgctxt "InstanceContentTextData:39717:0:0"
msgid "There are still those we can save! We keep moving!"
msgstr "Мы ещё можем спасти людей! Не останавливаемся!"

#. ja: すぐに道を作る！<br>塔よ、早く応えて……ッ！！
#. de: Lasst mich einen Weg bereiten<nbsp>... Ich bitte dich, antworte mir, o Immerfried ...!
#. fr: Laissez-moi faire<nbsp>! La tour répondra à mon appel<nbsp>!
msgctxt "InstanceContentTextData:39718:0:0"
msgid "I will make us a path. O Everkeep, hearken to me!"
msgstr "Я проложу нам путь. О, Вечный Оплот, услышь мой зов!"

#. ja: 聞こえる……まだたくさんの悲鳴……<br>無事でいて……！
#. de: Ich kann sie hören<nbsp>... All die Ver<shy>zweif<shy>lung<nbsp>... Bitte seid unversehrt!
#. fr: J'entends encore tellement de cris et de pleurs... Ça me fend le cœur...
msgctxt "InstanceContentTextData:39719:0:0"
msgid "So many still crying out in fear and in pain... Please hold on!"
msgstr "Столько людей ещё кричат от боли и страха... Держитесь!"

#. ja: ゾラージャのやつ、魔物まで放つなんて！
#. de: Dass Zoraal Ja sich nicht einmal scheut, Bestien loszulassen ...!
#. fr: Voilà que Zoraal Ja nous envoie des monstres, maintenant<nbsp>!
msgctxt "InstanceContentTextData:39720:0:0"
msgid "Fiends too!? Damn you, Zoraal Ja!"
msgstr "И чудовищ натравил!? Будь ты проклят, Зораль Джа!"

#. ja: アタシらで止めるしかねぇ！
#. de: Wir haben keine Wahl! Los!
#. fr: Reste plus que nous pour arrêter ce massacre<nbsp>!
msgctxt "InstanceContentTextData:39721:0:0"
msgid "It's up to us to stop them!"
msgstr "Только нам их и остановить!"

#. ja: みんな、無事でよかった……。
#. de: Ihr seid wohlauf ... Ein Glück<nbsp>...
#. fr: Des survivants... Quel soulagement<nbsp>!
msgctxt "InstanceContentTextData:39722:0:0"
msgid "You're safe now. Be at ease."
msgstr "Теперь вы в безопасности. Не бойтесь."

#. ja: 怖い思いを、痛い思いをさせてごめんなさい……<br>避難の方法を伝えるね……！
#. de: All die Furcht, all der Schmerz, die ihr erfahren musstet<nbsp>... Bitte gebt nicht auf! Ich ... Nein, <i>wir</i> werden euch beschützen!
#. fr: Je suis tellement navrée que vous souffriez ainsi par ma faute... Vous serez bientôt tous en sécurité, c'est promis<nbsp>!
msgctxt "InstanceContentTextData:39723:0:0"
msgid "I'm sorry for putting you through such an ordeal... It will soon be over, so please stay strong."
msgstr "Простите, что вам пришлось через это пройти... Скоро всё закончится, держитесь!"

#. de: Ich ... Nein, <i>wir</i> werden euch beschützen!
msgctxt "InstanceContentTextData:39724:0:0"
msgid "Deleted."
msgstr "Deleted."

#. ja: 王国騎士団の誇りにかけて！<br>総員突撃、敵を蹴散らせ！
#. de: Im Namen des Ritterordens! Schlagt unsere Feinde nieder!
#. fr: Fiers chevaliers du royaume d'Alexandrie... CHAAARGEEEZ<nbsp>!!
msgctxt "InstanceContentTextData:39725:0:0"
msgid "For the honor of the royal knights! Forward!"
msgstr "За честь королевских рыцарей! Вперёд!"

#. ja: やめろ！<br>アタシらのことが分からねぇのか！？
#. de: Hör auf! Erkennst du uns nicht?!
#. fr: Otis, réveille-toi<nbsp>! C'est nous, tes amis<nbsp>!
msgctxt "InstanceContentTextData:39726:0:0"
msgid "Snap out of it, Otis! Don't you recognize us!?"
msgstr "Опомнись, Отис! Ты нас не узнаёшь!?"

#. ja: 第一陣形！<br>王国騎士の統率力を見せよ！
#. de: Erste Formation! Zeigt ihnen die Führungsstärke der Ritter!
#. fr: En formation primaire<nbsp>! Montrez-leur toute notre puissance<nbsp>!
msgctxt "InstanceContentTextData:39727:0:0"
msgid "First formation! Show them a knight's valor!"
msgstr "Первый строй! Покажите доблесть рыцарей!"

#. ja: ……この機械たち、彼の指示に従っているわ！
#. de: Diese Maschinen folgen seinen Befehlen!
#. fr: Ces machines obéissent aveuglément à ses ordres<nbsp>!
msgctxt "InstanceContentTextData:39728:0:0"
msgid "The machines obey him!"
msgstr "Машины ему подчиняются!"

#. ja: 第二陣形！<br>勝利の栄光を掴み取れ！
#. de: Zweite Formation! Der Sieg ist zum Greifen nah!
#. fr: En formation secondaire<nbsp>! Couvrez-vous des lauriers de la victoire<nbsp>!
msgctxt "InstanceContentTextData:39729:0:0"
msgid "Second formation! Seize the glory of victory!"
msgstr "Второй строй! К победе и славе!"

#. ja: この戦術……<br>そんなはずない、だって「彼」は……。
#. de: Diese Formationen ... Das ist nicht möglich ...!
#. fr: Cette technique de combat... Je n'ose croire que ça puisse être...
msgctxt "InstanceContentTextData:39730:0:0"
msgid "Something about him is familiar... But...it couldn't be..."
msgstr "Что-то в нём знакомое... Но... не может быть..."

#. ja: 第三陣形！<br>進むのだ！　アレクサンドリアのために！
#. de: Dritte Formation! Vormarsch! Für Alexandria!
#. fr: En formation tertiaire<nbsp>! À l'attaque, pour l'honneur d'Alexandrie<nbsp>!
msgctxt "InstanceContentTextData:39731:0:0"
msgid "Third formation! Onward, for Alexandria!"
msgstr "Третий строй! Вперёд, за Александрию!"

#. ja: これは……やべえのがくるぞ！<br>みんな、備えろ！
#. de: Da kommt was Größeres! Passt auf!
#. fr: Ça sent le roussi<nbsp>! Préparez-vous à encaisser le choc<nbsp>!
msgctxt "InstanceContentTextData:39732:0:0"
msgid "Don't like the looks of this... Everyone, keep your guard up!"
msgstr "Мне это совсем не нравится... Всем быть начеку!"

#. ja: 間違いない、これは……騎士団長の……！
#. de: Kein Zweifel ... Er ist es wirklich ...!
#. fr: Ça alors... C'est vraiment lui<nbsp>? Le capitaine de ma garde royale<nbsp>!?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:39733:0:0"
msgid "It <i>is</i> him─the captain of the knights!"
msgstr "Это <i>он</i> — капитан рыцарей!"

#. ja: くそお……オーティスを正気に戻す方法はねぇのか！？
#. de: Können wir ihn nicht irgendwie zurückholen?!
#. fr: Merde... Comment faire pour qu'Otis reprenne ses esprits<nbsp>?
msgctxt "InstanceContentTextData:39734:0:0"
msgid "Damn it... How do we bring him to his senses!?"
msgstr "Чёрт... Как привести Отиса в чувство!?"

#. ja: もし「彼」の中に私の記憶が残ってるなら……
#. de: Wenn sich auch nur noch ein Fünkchen Erinnerung an mich in ihm befindet, dann ...!
#. fr: S'il a conservé en lui ne serait-ce que quelques souvenirs de moi...
msgctxt "InstanceContentTextData:39735:0:0"
msgid "If he still remembers me, then perhaps..."
msgstr "Если он ещё помнит меня, тогда, может быть..."

#. ja: ガガ……女王……お護りする……
#. de: D-D-Die ... Kö... gin ... schütze...!
#. fr: Votre Majesté... Je vous... protégerai...
msgctxt "InstanceContentTextData:39737:0:0"
msgid "...protect...Her Majesty..."
msgstr "...защитить... Её Величество..."

#. ja: お主らにも迷惑をかけたな！<key 8205251>このオンボロの体がもつ限り、共に戦おうぞ！
#. de: Verzeiht, ich war nicht bei Sinnen!<key 8205251>Erlaubt mir, an Eurer Seite zu kämpfen!
#. fr: J'espère que vous saurez me pardonner ce petit contretemps<nbsp>!<key 8205251>Tant que cette vieille carcasse me le permettra, je me battrai à vos côtés<nbsp>!
#. macro: <key 8205251> — a key prompt; its runtime meaning is not established; value = 8205251 (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:39738:0:0"
msgid "Apologies for the trouble I've caused.<key 8205251>So long as this body holds, I shall fight with you!"
msgstr "Простите, что доставил вам хлопот.<key 8205251>Пока это старое тело держится, я буду сражаться вместе с вами!"

#. ja: 大量のエネルギーが……みんな、気を付けて！
#. de: So viel Energie ... Seid vorsichtig!
#. fr: Quelle énergie incroyable... Faites très attention<nbsp>!
msgctxt "InstanceContentTextData:39739:0:0"
msgid "It's building up energy! Have care!"
msgstr "Он накапливает энергию! Осторожно!"

#. ja: こやつ、周囲の雷をかき集めているぞ！
#. de: Seht Euch vor, er sammelt Blitze aus der Umgebung an!
#. fr: Prenez garde, l'ennemi aspire l'énergie de foudre environnante<nbsp>!
msgctxt "InstanceContentTextData:39741:0:0"
msgid "It gathers lightning to itself!"
msgstr "Он собирает молнии вокруг себя!"

#. ja: みんなで分担して阻止しましょう！
#. de: Wir müssen uns aufteilen und sie stoppen!
#. fr: On se sépare pour être plus efficaces<nbsp>!
msgctxt "InstanceContentTextData:39742:0:0"
msgid "Let's split up and deal with them!"
msgstr "Разделимся и разберёмся с ними!"

#. ja: チッ……！　滅茶苦茶しやがるぜ！
#. de: Was?! Der ist nicht normal!
#. fr: Faites gaffe, ça risque de faire très mal<nbsp>!
msgctxt "InstanceContentTextData:39743:0:0"
msgid "Hmph! Not holding anything back, are we?"
msgstr "Хм! Вот это размах!"

#. ja: この数……流石に厳しいわね……！
#. de: So viele ... Das könnte eng werden ...!
#. fr: Ils sont tellement nombreux<nbsp>! Va falloir s'accrocher<nbsp>!
msgctxt "InstanceContentTextData:39744:0:0"
msgid "So many... This is going to be tough."
msgstr "Их так много... Будет нелегко."

#. ja: ワタシに任せろ！<key 8205255>これぞ高潔なる、王国騎士団が秘技！
#. de: Meine Zeit ist gekommen!<key 8205255>Werdet geblendet von der edelsten Technik des Ritterordens!
#. fr: Laissez-moi faire<nbsp>!<key 8205255>Admirez la botte secrète de la garde royale d'Alexandrie<nbsp>!
#. macro: <key 8205255> — a key prompt; its runtime meaning is not established; value = 8205255 (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:39745:0:0"
msgid "Leave this to me!<key 8205255>Behold the bladework of a royal knight!"
msgstr "Предоставьте это мне!<key 8205255>Узрите мастерство королевского рыцаря!"

#. ja: ぐぐっ、なんのこれしき！
#. de: Urgh, welche Wucht!
#. fr: Argh<nbsp>! Rassurez-vous, tous mes boulons sont en place<nbsp>!
msgctxt "InstanceContentTextData:39746:0:0"
msgid "'Tis but a flesh wound!"
msgstr "Пустяковая царапина!"

#. ja: なんという膨大な雷力……！
#. de: Welch überwältigendes Ausmaß an Blitzenergie ...!
#. fr: Cette énergie de foudre a l'air... foudroyante<nbsp>!
msgctxt "InstanceContentTextData:39747:0:0"
msgid "Such tremendous lightning!"
msgstr "Какая мощь... Столько энергии молнии!"

#. ja: まずいわ！　このままじゃ……！
#. de: Verdammt, wenn das so weiter geht ...!
#. fr: Oh non... Si ça continue, on est cuits<nbsp>!
msgctxt "InstanceContentTextData:39748:0:0"
msgid "Not good... At this rate..."
msgstr "Дело плохо... Если так пойдёт и дальше..."

#. ja: 王国騎士の誇りにかけて  護り抜く！！
#. de: Ich werde Euch beschützen! Im Namen der königlichen Ritter!
#. fr: Je vous défendrai coûte que coûte<nbsp>! Tel est le devoir d'un chevalier d'Alexandrie<nbsp>!
msgctxt "InstanceContentTextData:39749:0:0"
msgid "Upon mine honor, we shall weather this storm!"
msgstr "Клянусь честью королевского рыцаря, мы выдержим этот натиск!"

#. ja: さあ  今のうちに魔物を倒せ！
#. de: Schnell! Entledigt Euch der Bestie!
#. fr: À vous<nbsp>! Profitez de cette occasion pour faire virevolter votre arme<nbsp>!
msgctxt "InstanceContentTextData:39750:0:0"
msgid "Now! Lay the fiend low!"
msgstr "Сейчас! Добейте чудовище!"

#. ja: オーティス！！<br>退かないと、体がもたないよ……！
#. de: Otis! Dein Körper wird das nicht aushalten ...!!!
#. fr: Arrête, Otis<nbsp>!! C'est trop risqué<nbsp>!!
msgctxt "InstanceContentTextData:39751:0:0"
msgid "Otis, you must stop! Your body can't survive this!"
msgstr "Отис, остановись! Твоё тело этого не выдержит!"

#. ja: いいえ、退きませぬ！<br>たとえこの命尽きようとも！
#. de: Dann sei es so! Sollte dieser Körper auch vergehen, ich werde nicht weichen!
#. fr: Non<nbsp>! Je n'ai pas le droit d'abandonner maintenant<nbsp>! Je me battrai jusqu'à mon dernier souffle<nbsp>!
msgctxt "InstanceContentTextData:39752:0:0"
msgid "Nay, I cannot yield...even should it cost me my life!"
msgstr "Нет, я не отступлю... даже если это будет стоить мне жизни!"

#. ja: オーティス……！！！
#. de: Otis ...!!!
#. fr: Otis, non...<nbsp>!!
msgctxt "InstanceContentTextData:39753:0:0"
msgid "Otiiis!"
msgstr "Оти-и-ис!"

#. ja: スフェーン……様……お怪我はありませんか……？
#. de: Eure ... Hoheit ... Seid Ihr ... unverletzt?
#. fr: Votre Majesté... Dites-moi... que vous n'êtes pas... blessée...
msgctxt "InstanceContentTextData:39754:0:0"
msgid "My queen... Are you unharmed?"
msgstr "Моя королева... Вы не ранены?"

#. ja: これぞ高潔なる、王国騎士団が秘技！
#. de: Werdet geblendet von der edelsten Technik des Ritterordens!
#. fr: Admirez la botte secrète de la garde royale d'Alexandrie<nbsp>!
msgctxt "InstanceContentTextData:39755:0:0"
msgid "Behold the bladework of a royal knight!"
msgstr "Узрите мастерство королевского рыцаря!"

#. ja: こんにちは、そしてさようなら！
#. de: Hallo! Und auf Wieder<shy>sehen!
#. fr: Bienvenue et adieu<nbsp>!
msgctxt "InstanceContentTextData:39800:0:0"
msgid "Greetings and good-bye."
msgstr "Приветствую. И прощайте."

#. ja: 生きていますか？
#. de: Lebt ihr wirklich?
#. fr: Êtes-vous vivants<nbsp>?
msgctxt "InstanceContentTextData:39801:0:0"
msgid "Are you alive?"
msgstr "Вы живы?"

#. ja: 幸せですか？
#. de: 	Seid ihr glücklich?
#. fr: Êtes-vous heureux<nbsp>?
msgctxt "InstanceContentTextData:39802:0:0"
msgid "Are you happy?"
msgstr "Вы счастливы?"

#. ja: 死をのりこえましょう！
#. de: Lasst uns den Tod überwinden!
#. fr: Ensemble, surmontons la mort<nbsp>!
msgctxt "InstanceContentTextData:39803:0:0"
msgid "Let us rise above death!"
msgstr "Давайте превзойдём саму смерть!"

#. ja: エーテルが必要です！
#. de: Benötige Äther!
#. fr: Mon peuple a besoin de votre éther<nbsp>!
msgctxt "InstanceContentTextData:39804:0:0"
msgid "We require aether."
msgstr "Нам нужен эфир."

#. ja: 死んでもおわりではありません！<br>さあ、こわがらないで！
#. de: Der Tod ist nicht das Ende! Fürchtet euch nicht!
#. fr: N'ayez pas peur, la mort n'est pas une fin en soi<nbsp>!
msgctxt "InstanceContentTextData:39805:0:0"
msgid "Do not be afraid. Death is not the end. "
msgstr "Не бойтесь. Смерть — ещё не конец."

#. ja: 接続された世界を、お見せしましょう！
#. de: Seht die neu verbundene Welt!
#. fr: Admirez le lien entre les mondes<nbsp>!
msgctxt "InstanceContentTextData:39806:0:0"
msgid "I will show you the worlds beyond."
msgstr "Я покажу вам миры за пределами этого."

#. ja: 小型ユニットを展開します！
#. de: Sende Kampfeinheiten aus!
#. fr: Déploiement des sous-unités<nbsp>!
msgctxt "InstanceContentTextData:39807:0:0"
msgid "Deploying drones."
msgstr "Запускаю дронов."

#. ja: まだ生きていますか？<br>予備動力を起動します！
#. de: Lebt ihr immer noch? Aktiviere Energiereserven!
#. fr: Êtes-vous toujours en vie<nbsp>? Activation de la puissance de réserve...
msgctxt "InstanceContentTextData:39808:0:0"
msgid "Are you still alive? Activating reserve power."
msgstr "Вы ещё живы? Активирую резервное питание."

#. ja: まだ生きていますか？<br>安全装置を解除します！
#. de: Lebt ihr immer noch? Entferne Sicherungsvorrichtungen!
#. fr: Êtes-vous toujours en vie<nbsp>? Déverrouillage de la sécurité...
msgctxt "InstanceContentTextData:39809:0:0"
msgid "Are you still alive? Disengaging safeties."
msgstr "Вы ещё живы? Отключаю предохранители."

#. ja: 空間を掌握しました！<br>存在抹消を実行します！
#. de: Raumkontrolle aktiviert! Vernichte existente Lebensformen!
#. fr: Zone cible délimitée. Suppression de toute existence...
msgctxt "InstanceContentTextData:39810:0:0"
msgid "Target area delineated. Commencing erasure."
msgstr "Целевая область определена. Начинаю стирание."

#. ja: 限界負荷を超過……中断します。
#. de: Maximale Belastung überschritten ... Unterbrechung notwendig.
#. fr: Surcharge du système... Interruption de la procédure.
msgctxt "InstanceContentTextData:39811:0:0"
msgid "System overload. Aborting process."
msgstr "Перегрузка системы. Процесс прерван."

#. ja: まだ生きて……空間掌握……再実行します！
#. de: Lebt ihr imm...? ... Aktivi... Raumkontrolle ...!
#. fr: ... Toujours en vie<nbsp>?<nbsp>...ne délimitée...<nbsp>...eprise de la suppression...
msgctxt "InstanceContentTextData:39812:0:0"
msgid "Are you still alive? Recommencing erasure."
msgstr "Вы ещё живы? Повторно запускаю стирание."

#. ja: 限界負荷……超過……<br>エラーが発生し……
#. de: Maximale Belastung ... Fehler entdeckt ...
#. fr: Surcharg... extrême... Erreur dé...
msgctxt "InstanceContentTextData:39813:0:0"
msgid "System overload. An error has occurred."
msgstr "Перегрузка системы. Обнаружена ошибка."

#. ja: 強制実行……命令……確認……
#. de: Unterbrechung unterbunden ... Ver...
#. fr: Instruction<nbsp>...écution<nbsp>...rcée... con...ée.
msgctxt "InstanceContentTextData:39814:0:0"
msgid "System override order confirmed."
msgstr "Приказ на принудительное выполнение подтверждён."

#. ja: なんだ……空間に亀裂が！？<br>力が暴走してるのか……！？
#. de: Ein Riss im Himmel!? Hat sie die Macht etwa nicht unter Kontrolle<nbsp>...?!
#. fr: Est-ce que c'est... une fissure dans l'espace<nbsp>? Le pouvoir est hors de contrôle<nbsp>?
msgctxt "InstanceContentTextData:39815:0:0"
msgid "There...a rift in her reality! She's losing control of the power!"
msgstr "Там... разлом в её реальности! Она теряет контроль над силой!"

#. ja: スフェーン！！　アタシの声を聞け！！！
#. de: Sphene! Hör mir zu!
#. fr: Sphene<nbsp>!!! Écoute-moi<nbsp>!!!
msgctxt "InstanceContentTextData:39816:0:0"
msgid "Sphene! Listen to me!"
msgstr "Сфина! Послушай меня!"

#. ja: お前の覚悟はわかってる……！<br>もう  その想いは止められねぇってことも
#. de: Ich verstehe deinen Entschluss ...! Und warum du nicht anders kannst.
#. fr: Je comprends ta résolution...<nbsp>! Et je sais aussi que rien ne te fera fléchir.
msgctxt "InstanceContentTextData:39817:0:0"
msgid "I understand, I do. And I know that you won't be swayed from your course."
msgstr "Я понимаю тебя. И знаю, что с выбранного пути тебя уже не свернуть."

#. ja: だけどよ……<br>どうしても  お前と戦わなきゃいけねぇってんなら……
#. de: Trotzdem ... Wenn wir wirklich miteinander kämpfen müssen<nbsp>...
#. fr: S'il n'y a vraiment plus aucun moyen d'éviter la confrontation, alors...
msgctxt "InstanceContentTextData:39818:0:0"
msgid "But if there's truly no other way to resolve this..."
msgstr "Но если нам и правда не осталось ничего, кроме как сразиться..."

#. ja: 心無い機械じゃない……<br>お前の心と向き合いてぇんだ  スフェーン！！！！
#. de: Dann kämpf mit Herz und Seele, Sphene! Nicht als kalte Maschine!
#. fr: Ne m'affronte pas comme une machine. Fais-moi face avec tout ton cœur<nbsp>!!!
msgctxt "InstanceContentTextData:39819:0:0"
msgid "Then face me! Not as a machine, but as the real you!"
msgstr "Тогда сразись со мной! Не как машина, а как настоящая ты!"

#. ja: ラマ……チ……
#. de: Lama...ty'i<nbsp>...
#. fr: L-Lamaty'i...
msgctxt "InstanceContentTextData:39820:0:0"
msgid "Lamaty'i..."
msgstr "Ламатъи..."

#. ja: スフェーン！！！！！
#. de: Sphene!
#. fr: Sphene<nbsp>!!!
msgctxt "InstanceContentTextData:39821:0:0"
msgid "Sphene!"
msgstr "Сфина!"

#. ja: 記憶領域に  異常を検知しました
#. de: Anomalie im Erinnerungsspeicher entdeckt.
#. fr: Anomalie détectée dans un bloc mémoire...
msgctxt "InstanceContentTextData:39822:0:0"
msgid "Anomaly detected in memory banks."
msgstr "Обнаружена аномалия в банках памяти."

#. ja: 「スフェーン」の一部が  復元されました
#. de: Ein Teil von „Sphene“ wurde wieder<shy>her<shy>gestellt.
#. fr: Les données de l'Éternelle “Sphene” ont été partiellement restaurées.
msgctxt "InstanceContentTextData:39823:0:0"
msgid "Data for the Endless “Sphene” partially restored."
msgstr "Данные Вечной «Сфины» частично восстановлены."

#. ja: これは私の願い……絶対に負けられない！
#. de: Meinen Wunsch ... Ich werde ihn nicht aufgeben<nbsp>...!
#. fr: C'est là mon vœu le plus cher... et je n'échouerai pas<nbsp>!
msgctxt "InstanceContentTextData:39824:0:0"
msgid "This is what I desire...and I will not fail!"
msgstr "Я этого хочу... и не потерплю неудачи!"

#. ja: もう誰も、失いたくない……！！
#. de: Ich will niemanden mehr verlieren<nbsp>...!
#. fr: Je ne perdrai plus jamais qui que ce soit<nbsp>!
msgctxt "InstanceContentTextData:39825:0:0"
msgid "I can't bear to lose them! Not again!"
msgstr "Я не вынесу, если снова потеряю их!"

#. ja: 痛いほどわかる、お前の気持ち！
#. de: Mir geht es genauso ... Dieser Schmerz ist unerträglich.
#. fr: Je comprends ta douleur... Je la ressens comme si c'était la mienne<nbsp>!
msgctxt "InstanceContentTextData:39826:0:0"
msgid "I feel your pain! As if it were my own!"
msgstr "Я чувствую твою боль, будто она моя!"

#. ja: ……やっとお前の全部を、知れた気がするぜ！
#. de: Endlich verstehen wir einander.
#. fr: Pour la première fois, j'ai l'impression de te connaître <i>vraiment<nbsp>!</i>
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:39827:0:0"
msgid "At last I think I know you─<i>all</i> of you."
msgstr "Кажется, наконец я узнал тебя... <i>всю</i>."

#. ja: ずるいよ、今そんなこと言うの……！
#. de: Das ist gemein ... So etwas jetzt zu sagen<nbsp>...!
#. fr: Tu n'as pas le droit de me dire ça maintenant...<nbsp>!
msgctxt "InstanceContentTextData:39828:0:0"
msgid "How can you say that to me now!?"
msgstr "Как ты можешь говорить такое именно сейчас!?"

#. ja: これで終わりだ、スフェーン……！<br>この旅で出会った仲間と、お前を止める！
#. de: Es endet hier, Sphene ...! Gemeinsam mit meinen Freunden werde ich dich aufhalten!
#. fr: Cette fois, c'est fini, Sphene. Tous ensemble, on va t'arrêter<nbsp>!
msgctxt "InstanceContentTextData:39829:0:0"
msgid "It's over, Sphene. We will stop you."
msgstr "Всё кончено, Сфина. Мы остановим тебя."

#. ja: 諦めない……最後まで……！！
#. de: Ich gebe nicht nach ... Bis zum Ende<nbsp>...!
#. fr: Non... Je n'aban<shy>don<shy>ne<shy>rai jamais<nbsp>!
msgctxt "InstanceContentTextData:39830:0:0"
msgid "No! I won't let you! I can't!"
msgstr "Нет! Я не позволю! Не могу!"

#. ja: 私が、みんなの笑顔を護るんだ！！！
#. de: Ich werde das Lachen meiner Bürger beschützen!
#. fr: Je protégerai le sourire des miens, comme j'en ai fait le serment<nbsp>!
msgctxt "InstanceContentTextData:39831:0:0"
msgid "I will protect my people's happiness!"
msgstr "Я защищу счастье своего народа!"

#. ja: なら、その心を受け継いで……
#. de: Deine Hoffnung wird in mir weiterleben ...
#. fr: Ce fardeau t'accable depuis trop longtemps déjà...
msgctxt "InstanceContentTextData:39832:0:0"
msgid "Leave your burden with us now."
msgstr "Оставь свою ношу нам."

#. ja: アタシらは、お前を倒す路を往くぜ！！！
#. de: Wir werden dich besiegen!
#. fr: Laisse-nous t'en libérer une bonne fois pour toutes<nbsp>!
msgctxt "InstanceContentTextData:39833:0:0"
msgid "We will bear it in your stead!"
msgstr "Мы понесём её вместо тебя!"

#. ja: アブソリュート・オーソリティ発動まで　5
#. de: Absolute Autorität in 5<nbsp>...
#. fr: 5 secondes avant Autorité absolue...
msgctxt "InstanceContentTextData:39834:0:0"
msgid "5 seconds to Absolute Authority..."
msgstr "До активации Абсолютной власти: 5..."

#. ja: アブソリュート・オーソリティ発動まで　4
#. de: Absolute Autorität in 4<nbsp>...
#. fr: 4 secondes avant Autorité absolue...
msgctxt "InstanceContentTextData:39835:0:0"
msgid "4 seconds to Absolute Authority..."
msgstr "До активации Абсолютной власти: 4..."

#. ja: アブソリュート・オーソリティ発動まで　3
#. de: Absolute Autorität in 3<nbsp>...
#. fr: 3 secondes avant Autorité absolue...
msgctxt "InstanceContentTextData:39836:0:0"
msgid "3 seconds to Absolute Authority..."
msgstr "До активации Абсолютной власти: 3..."

#. ja: アブソリュート・オーソリティ発動まで　2
#. de: Absolute Autorität in 2<nbsp>...
#. fr: 2 secondes avant Autorité absolue...
msgctxt "InstanceContentTextData:39837:0:0"
msgid "2 seconds to Absolute Authority..."
msgstr "До активации Абсолютной власти: 2..."

#. ja: アブソリュート・オーソリティ発動まで　1
#. de: Absolute Autorität in 1<nbsp>...
#. fr: 1 seconde avant Autorité absolue...
msgctxt "InstanceContentTextData:39838:0:0"
msgid "1 second to Absolute Authority..."
msgstr "До активации Абсолютной власти: 1..."

#. ja: シャルトフィット盗賊団を倒せ
#. de: Chalteaufites Bande besiegen
#. fr: Vaincre Chalteaufite et ses sbires
msgctxt "InstanceContentTextData:39900:0:0"
msgid "Defeat Chalteaufite's gang"
msgstr "Победите банду Шартофита"

#. ja: 護りの力があれば、こいつひとりで十分だ！
#. de: Dank des Segens braucht es nur einen von uns!
#. fr: Grâce au pouvoir de cette relique, on est invincibles<nbsp>!
msgctxt "InstanceContentTextData:39901:0:0"
msgid "With the blessing, even one of us should be more than enough!"
msgstr "С благословением и одного из нас хватит!"

#. ja: フハハハハ！<br>お前たちの攻撃なんて効くものかー！
#. de: Hahaha! Ihr könnt mich nicht aufhalten!
#. fr: Ha ha ha ha<nbsp>! Vos attaques n'ont aucun effet<nbsp>!
msgctxt "InstanceContentTextData:39902:0:0"
msgid "Hahaha! You are powerless to stop me!"
msgstr "Ха-ха-ха! Вам меня не одолеть!"

#. ja: さっさとお前たちを倒して、この国をいただくぞ！
#. de: Wenn ich mit euch fertig bin, ist Ala Mhigo so gut wie mein!
#. fr: Hors de mon chemin, le palais est à moi<nbsp>!
msgctxt "InstanceContentTextData:39903:0:0"
msgid "Once I've dealt with you, Ala Mhigo is as good as mine!"
msgstr "Разберусь с вами — и Ала Миго будет моим!"

#. ja: 「完全なる護りの力などない、いつかは綻びが生じる」……。
#. de: Denkt dran: „Selbst der mächtigste Schild wird irgendwann zerbrechen.“
#. fr: “Même la plus infranchissable défense a une faille”, ja...
msgctxt "InstanceContentTextData:39904:0:0"
msgid "Remember, “Cracks form in even the mightiest of shields”!"
msgstr "Запомните: «Даже в самом крепком щите рано или поздно появится трещина»!"

#. ja: 言い伝えには、必ず意味があるはず！<br>ふたりとも、まずは攻撃し続けてみて！
#. de: Da muss etwas Wahres dran sein! Also lasst nicht nach!
#. fr: Il faut percer le secret du totem... Je compte sur vous pour attaquer<nbsp>!
msgctxt "InstanceContentTextData:39905:0:0"
msgid "There must be some truth to it! Don't let up your attack!"
msgstr "В этом предании наверняка есть доля правды! Не прекращайте атаковать!"

#. ja: ま、ままま、護りの力が弱まって……！？
#. de: D-Die Barriere schwindet!?
#. fr: Hein<nbsp>!? La bénédiction s'affaiblit...<nbsp>?
msgctxt "InstanceContentTextData:39906:0:0"
msgid "Th-The barrier is fading!?"
msgstr "П-п-похоже, защита слабеет!?"

#. ja: もしや、これが「綻び」か！
#. de: War das damit gemeint?
#. fr: Mais oui, ja<nbsp>! C'est elle, la “faille”<nbsp>!
msgctxt "InstanceContentTextData:39907:0:0"
msgid "Is this what you meant?"
msgstr "Так вот что имелось в виду!"

#. ja: <split " " 1><string $gs1></split>！<br>綻びが生じた方向から攻撃してみてくれ！
#. de: Gut so, <split " " 1><string $gs1></split>! Wenn du weiter die gleiche Stelle triffst, wird sie sicher zerbrechen!
#. fr: <split " " 1><string $gs1></split><nbsp>! Attaquez là où la protection s'amoindrit<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:39908:0:0"
msgid "That's it, <split \" \" 1><string $gs1></split>! If you keep hitting the same spot, it's sure to break!"
msgstr "Так держать, <split \" \" 1><string $gs1></split>! Бейте в одно место — и защита наверняка треснет!"

#. ja: 護りの力が破られるなんて、何かの間違いだッ！！<br>お前たち、怯まず囲み込め！
#. de: Das darf doch nicht wahr sein<nbsp>... Steht da nicht nur rum, umzingelt sie!
#. fr: Impossible, ce pouvoir est invincible... Vous<nbsp>! Arrêtez de vous planquer et rossez-les<nbsp>!
msgctxt "InstanceContentTextData:39909:0:0"
msgid "This can't be... Don't just stand there gawping, surround them!"
msgstr "Не может быть... Чего вы встали? Окружите их!"

#. ja: 馬鹿め、祭器に頼りすぎだ！<br><split " " 1><string $gs1></split>、畳みかけるぞ！
#. de: Du Narr, Chalteaufite! Dies ist das Limit der Macht des Artefakts!
#. fr: Il est aveuglé par les pouvoirs du totem, ja... <split " " 1><string $gs1></split>, on maintient la pression<nbsp>!
msgctxt "InstanceContentTextData:39910:0:0"
msgid "You fool, Chalteaufite! This is the limit of the artifact's power!"
msgstr "Глупец, Шальтофит! Вот предел силы артефакта!"

#. ja: 俺が抑えている間に、綻びを破ってくれ！
#. de: Überlass das mir! Greif weiter die Barriere an!
#. fr: Je me charge d'eux, concentre-toi sur les failles<nbsp>!
msgctxt "InstanceContentTextData:39911:0:0"
msgid "Leave this to me! Keep attacking the barrier!"
msgstr "Я их задержу! Продолжай атаковать барьер!"

#. ja: 僕の理念を理解しない愚か者どもが……<br>逃げ惑え！
#. de: Ihr verdammten Störenfriede! Mal sehen, wie ihr hierauf reagiert!
#. fr: Goûtez à ça... Vous allez comprendre notre souffrance<nbsp>!
msgctxt "InstanceContentTextData:39912:0:0"
msgid "Meddling curs! Let's see what you make of this!"
msgstr "Мерзкие выскочки! Посмотрим, как вам это понравится!"

#. ja: なっ、追尾してくるのか……！？<br>近づいてくる前に撃墜しなければ！
#. de: Es hat keinen Sinn, zu fliehen! Wir müssen aus der Ferne angreifen!
#. fr: Ils nous poursuivent<nbsp>!? Il faut les abattre avant qu'ils nous atteignent<nbsp>!
msgctxt "InstanceContentTextData:39913:0:0"
msgid "There's no use fleeing! We've got to strike from a distance!"
msgstr "Бесполезно убегать! Нужно атаковать издалека!"

#. ja: さっきのは何かの間違いだ！<br>祭器の力は絶対……のはず！
#. de: Unmöglich! Die Macht des Artefakts ist absolut!
#. fr: Ce n'était qu'une erreur, un peu plus tôt<nbsp>! Les pouvoirs du totem sont infaillibles, ha ha ha<nbsp>!
msgctxt "InstanceContentTextData:39914:0:0"
msgid "How could they shatter the barrier? The artifact's power is absolute!"
msgstr "Как им удалось разбить барьер? Сила артефакта абсолютна!"

#. ja: さあ、かましてやれ！<br>「ブリリアント・ダイナミクスウォール」をなッ！
#. de: Egal, ich kann den Segen einfach neu erteilen! Greift an!
#. fr: Préparez-vous pour l'attaque suprême au service des opprimés<nbsp>!
msgctxt "InstanceContentTextData:39915:0:0"
msgid "Behold the power at my command!"
msgstr "Узрите мощь, которой я повелеваю!"

#. ja: 護りの力が生み出す衝撃波で、吹き飛ぶがいい！！
#. de: Hahaha! Die Schockwelle wird kurzen Prozess mit euch machen!
#. fr: L'onde de choc de ma méga-barrière va vous envoyer valdinguer<nbsp>!
msgctxt "InstanceContentTextData:39916:0:0"
msgid "Hahaha! The shockwave will make short work of you!"
msgstr "Ха-ха-ха! Ударная волна быстро с вами расправится!"

#. ja: まったく何をやってるんだ！　ほら行け！
#. de: Worauf wartet ihr noch? Vernichtet sie!
#. fr: Vous foutez quoi, là<nbsp>!? À l'attaque, bon sang<nbsp>!
msgctxt "InstanceContentTextData:39917:0:0"
msgid "What are you waiting for! Destroy them!"
msgstr "Чего вы ждёте!? Уничтожьте их!"

#. ja: キィイイイイ！　なんで効かないんだよォオオ！<br>少しの間、お前たちでなんとかしろ！
#. de: Aaargh! Wie kann das sein!? Ihr da, haltet sie beschäftigt!
#. fr: Hiiiii<nbsp>! Pourquoi ça ne marche pas<nbsp>? Faites quelque chose<nbsp>!
msgctxt "InstanceContentTextData:39918:0:0"
msgid "Aaagh! How can this be happening!? You lot, keep them occupied!"
msgstr "А-а-а! Да как такое возможно!? Эй вы, задержите их!"

#. ja: 役立たずめ……！<br>クソッ、僕が前に出るしかないか……！
#. de: Nutzlos! Muss ich denn alles selber machen!?
#. fr: Bande d'incapables... Il faut toujours que je fasse tout moi-même<nbsp>!
msgctxt "InstanceContentTextData:39919:0:0"
msgid "Useless! Do I have to do everything myself!?"
msgstr "Бесполезные! Неужели мне всё самому делать!?"

#. ja: ぐうう……！<br>このままでは、俺たちの方が消耗してしまう……！
#. de: Hnnngh ... Wenn das so weitergeht, halten wir nicht länger durch!
#. fr: Argh... Si ça continue, c'est nous qui allons mordre la poussière, ja...
msgctxt "InstanceContentTextData:39920:0:0"
msgid "Hnnngh... At this rate, we won't last much longer!"
msgstr "Уф... Так мы долго не продержимся!"

#. ja: カクージャのおじさん、諦めちゃダメ！<br>トライヨラに帰るんでしょ！？
#. de: Nicht aufgeben, Kaqool Ja! Du musst noch immer zurück nach Tuliyollal, oder?
#. fr: Kaqool Ja, tiens bon<nbsp>! On rentrera chez nous ensemble<nbsp>!
msgctxt "InstanceContentTextData:39921:0:0"
msgid "Don't give in, Kaqool Ja! You still need to travel back to Tuliyollal, don't you?"
msgstr "Не сдавайся, Какул Джа! Тебе ведь ещё нужно вернуться в Тулийоллал!"

#. ja: 独りよがりなシャルトフィットなんかに負けないで！
#. de: Du kannst nicht gegen jemanden wie Chalteaufite verlieren!
#. fr: On n'a pas le droit de perdre contre Chalteaufite, ja<nbsp>!
msgctxt "InstanceContentTextData:39922:0:0"
msgid "You can't lose to someone like Chalteaufite!"
msgstr "Нельзя проиграть такому, как Шальтофит!"

#. ja: フン、僕を裏切った罪を今こそ償ってもらおうか！
#. de: Ha! Du wirst sehen, welches Schicksal jenen blüht, die mich verraten!
#. fr: Hmpf, je vais te faire payer ta traîtrise im<shy>mé<shy>dia<shy>te<shy>ment<nbsp>!
msgctxt "InstanceContentTextData:39923:0:0"
msgid "Ha! You will learn the fate of those who betray me!"
msgstr "Ха! Ты узнаешь, что ждёт тех, кто меня предаёт!"

#. ja: <split " " 1><string $gs1></split>……！<br>周りの兵器を頼む！
#. de: <split " " 1><string $gs1></split>! Kümmere dich um die kleinen Fische!
#. fr: <split " " 1><string $gs1></split><nbsp>! Les missiles sur les côtés, ja<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:39924:0:0"
msgid "<split \" \" 1><string $gs1></split>! Stop those missiles!"
msgstr "<split \" \" 1><string $gs1></split>! Останови эти ракеты!"

#. ja: <split " " 1><string $gs1></split>ちゃん！<br>あの綻びを狙って！
#. de: Jetzt, <split " " 1><string $gs1></split>! Zerschlag die Barriere!
#. fr: <split " " 1><string $gs1></split>, n'oubliez pas la faille<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:39925:0:0"
msgid "Now, <split \" \" 1><string $gs1></split>! Smash the barrier!"
msgstr "А теперь, <split \" \" 1><string $gs1></split>! Разбей барьер!"

#. ja: 祭器を盗んで悪いことして、仲間すら虐める……<br>シャルトフィットを捕まえよ！
#. de: Chalteaufite ... Du hast das Artefakt gestohlen, um andere zu bedrohen, selbst deine eigenen Leute! Dafür wirst du bezahlen!
#. fr: Un voleur sans foi ni loi qui utilise ceux qui lui font confiance... Attrapons-le, ja<nbsp>!
msgctxt "InstanceContentTextData:39926:0:0"
msgid "Chalteaufite... You stole the vessel to threaten others, even your own followers! It's time for you to pay!"
msgstr "Шальтофит... Ты украл сосуд, чтобы запугивать других, даже собственных приспешников! За это ты заплатишь!"

#. ja: ウワァアアアア！　来るな来るな来るな！！
#. de: Aaargh! Verschwindet! Geht weg von mir!
#. fr: Aaaaaah<nbsp>!!! Ne vous approchez pas de moiiii<nbsp>!!!
msgctxt "InstanceContentTextData:39927:0:0"
msgid "Aaaaaagh! Get away! Get away from me!"
msgstr "А-а-а! Не подходите! Не подходите ко мне!"

#. ja: あいつさては、護りの力が破られて混乱してるな。<br>一気に攻め落とすぞ！
#. de: Ziemlich kleinlaut ohne den Segen, was!? Das ist unsere Chance, <split " " 1><string $gs1></split>!
#. fr: Sans les pouvoirs du totem, il n'est rien. Profitons-en pour lui mettre une raclée, ja<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:39928:0:0"
msgid "Not so tough without the blessing, are you!? Now's our chance, <split \" \" 1><string $gs1></split>!"
msgstr "Без благословения ты уже не такой крутой, а!? Наш шанс, <split \" \" 1><string $gs1></split>!"

#. ja: ふたりとも、頑張ってーーーー！！
#. de: Weiter so! Du schaffst das!
#. fr: Courage, vous deux<nbsp>!
msgctxt "InstanceContentTextData:39929:0:0"
msgid "Keep going! You can do this!"
msgstr "Не сдавайтесь! У вас получится!"

#. ja: 堅牢な魔法障壁を攻撃せよ
#. de: Die Barriere angreifen
#. fr: Attaquer la barrière magique
msgctxt "InstanceContentTextData:39930:0:0"
msgid "Attack the barrier"
msgstr "Атакуйте барьер"

#. ja: 綻んだ魔法障壁を破壊せよ
#. de: Die geschwächte Barriere zerstören
#. fr: Détruire la barrière magique
msgctxt "InstanceContentTextData:39931:0:0"
msgid "Destroy the weakened barrier"
msgstr "Разрушьте ослабленный барьер"

#. ja: 魔導ミサイルを破壊せよ
#. de: Die Raketen zerstören
#. fr: Détruire les missiles
msgctxt "InstanceContentTextData:39932:0:0"
msgid "Destroy the missiles"
msgstr "Уничтожьте ракеты"

#. ja: シャルトフィットの手下を倒せ
#. de: Chalteaufites Anhänger besiegen
#. fr: Vaincre les sbires de Chalteaufite
msgctxt "InstanceContentTextData:39933:0:0"
msgid "Defeat Chalteaufite's followers"
msgstr "Одолейте приспешников Шальтофита"

#. ja: 怯弱のシャルトフィットを倒せ
#. de: Chalteaufite den Hasenfüßige besiegen
#. fr: Vaincre Chalteaufite
msgctxt "InstanceContentTextData:39934:0:0"
msgid "Defeat Chalteaufite Cravenscreed"
msgstr "Победить Халтофита Труса"

#. ja: お前たちなんか、僕だけでメコメコにしてやるッ！
#. de: Ich muss mich nicht mit so einem Gesindel herumschlagen!
#. fr: À moi tout seul, je vais vous écraser<nbsp>!
msgctxt "InstanceContentTextData:39935:0:0"
msgid "I don't need help to deal with the likes of you!"
msgstr "Мне и одному хватит сил разобраться с такими, как вы!"

#. ja: 護りの力のすべてを僕に！<br>これでお前たちの攻撃なんぞ効くものか！
#. de: Ich gewähre mir die vollständige Macht des Segens! Widerstand ist zwecklos!
#. fr: À moi, bénédiction du totem<nbsp>! Aucune attaque ne peut m'atteindre, ha ha<nbsp>!
msgctxt "InstanceContentTextData:39936:0:0"
msgid "I grant myself the full might of the blessing! Resist me at your peril!"
msgstr "Я призываю всю мощь благословения! Сопротивляться бесполезно!"

#. ja: だから、完全なる護りの力なんてないんだってば！<br>ふたりとも、言い伝えを信じて攻撃を続けて！
#. de: Selbst dieser Schild wird irgendwann zerbrechen! Hab Vertrauen und greif weiter an!
#. fr: Aucune défense n'est parfaite, ja<nbsp>! Ayez confiance et poursuivez l'assaut<nbsp>!
#, aeria-term-model-exception: Trust 4a08f7e1b8b7
msgctxt "InstanceContentTextData:39937:0:0"
msgid "Even that shield will crack eventually! Trust in the teachings and keep attacking!"
msgstr "Даже этот щит рано или поздно треснет! Верьте преданию и продолжайте атаковать!"

#. ja: 仕留め損なってるじゃないか、このマヌケーーーー！
#. de: Ihr Idioten! Zeigt gefälligst etwas Rückgrat!
#. fr: Bon sang, toujours incapable de finir le boulot<nbsp>!
msgctxt "InstanceContentTextData:39938:0:0"
msgid "Imbeciles! Show some backbone!"
msgstr "Идиоты! Да покажите уже хоть немного характера!"

#. ja: 絶対効いてるよ、大丈夫！<br>ウチの村の言い伝えを信じて！
#. de: Es wird funktionieren! Vertraut auf das Sprichwort!
#. fr: Ça va marcher, je le sais<nbsp>! Croyons en la légende de mon village<nbsp>!
msgctxt "InstanceContentTextData:39939:0:0"
msgid "It's working! Place your trust in the proverb!"
msgstr "Получается! Верьте нашему преданию!"
