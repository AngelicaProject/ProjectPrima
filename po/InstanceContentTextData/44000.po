msgid "<sheet PlaceName $n1 0><br><switch $n2><case>Rank B<case>Rank A<case>Rank S</switch><br><switch $n3><case>Activating in: <num $n4>:<num2 $n5><case>Unclaimed<case>Claimed <icon 51><case>Claimed <icon 52><case>Claimed <icon 53></switch>"
msgstr "<sheet PlaceName $n1 0><br><switch $n2><case>Ранг B<case>Ранг A<case>Ранг S</switch><br><switch $n3><case>До активации: <num $n4>:<num2 $n5><case>Не захвачено<case>Захвачено: <icon 51><case>Захвачено: <icon 52><case>Захвачено: <icon 53></switch>"

#. ja: ゆきゆき集まれ、ミンナで遊ぼ！
#. de: Lasst uns zusammen spielen! Das wird ein frostiger Spaß!
#. fr: Venez, venez, amis des neiges<nbsp>! Jouons tous ensemble<nbsp>!
msgctxt "InstanceContentTextData:44303:0:0"
msgid "Come to me, snowkin! Join the fun!"
msgstr "Снежные друзья, идите ко мне! Будем веселиться!"

#. ja: たくさん作るぞ、雪だるま～！
#. de: Schneemänner bauen macht einen Riesenspaß! Je mehr, desto besser!
#. fr: On va faire plein de bonhommes de neiges<nbsp>! Ouaiiis<nbsp>!
msgctxt "InstanceContentTextData:44304:0:0"
msgid "We shall make snowmen─lots of them!"
msgstr "Слепим снеговиков — целую кучу!"

#. ja: 遊んでくれて、ありがと～！<br>ゆきゆきサヨナラ、また明日！
#. de: Ahh, das war richtig lustig! Lasst uns bald wieder spielen!
#. fr: Merci, merci d'avoir joué avec nous<nbsp>! Au revoir amis des neiges, au revoir<nbsp>!
msgctxt "InstanceContentTextData:44305:0:0"
msgid "Ahhh, such fun that was! Let us play again soon!"
msgstr "Ах, как весело было! Давайте скорее снова поиграем!"

#. ja: たのしいキモチのおすそわけ！<br>ゆきゆきキラキラ、贈り物～！
#. de: Geteilter Spaß ist doppelter Spaß! Hier, ein frostig-fröhliches Geschenk!
#. fr: Merci, merci pour ce joyeux moment<nbsp>! Voilà un cadeau pour vous, tout brillant tout glacé<nbsp>!
msgctxt "InstanceContentTextData:44306:0:0"
msgid "With you we share our joy! A gift snowy and sparkly!"
msgstr "Делимся с вами радостью! Вот вам снежный блестящий подарок!"

#. ja: ニンゲン、ヨ……。<br>我が、新たなる領域にヨウコソ……。
#. de: Sterbliche ... Dies ist mein Reich.
#. fr: Bienvenue dans mon nouveau domaine, humains...
msgctxt "InstanceContentTextData:44500:0:0"
msgid "Welcome to my domain, mortals."
msgstr "Добро пожаловать в мои владения, смертные."

#. ja: この力で、傀儡を作ル……！
#. de: Ich halte die Fäden in meiner Hand<nbsp>...
#. fr: Il me faut une nouvelle marionnette<nbsp>!
msgctxt "InstanceContentTextData:44501:0:0"
msgid "Take form and serve!"
msgstr "Примите форму и служите мне!"

#. ja: サァ、我が意のままに戦エ！
#. de: Tanz nach meinem Willen!
#. fr: Maintenant, bats-toi<nbsp>! Je te l'ordonne<nbsp>!
msgctxt "InstanceContentTextData:44502:0:0"
msgid "Carry out my will!"
msgstr "Исполняйте мою волю!"

#. ja: コレはどうダ？
#. de: Passt auf!
#. fr: Que pensez-vous de ça<nbsp>?
msgctxt "InstanceContentTextData:44503:0:0"
msgid "Prepare yourselves!"
msgstr "А ну-ка, приготовьтесь!"

#. ja: 組み合わせてみるカ……。
#. de: Jetzt alle ...
#. fr: Peut-être devrais-je les combiner...
msgctxt "InstanceContentTextData:44504:0:0"
msgid "Time to pull the strings..."
msgstr "Пора дёрнуть за ниточки..."

#. ja: 踊ってみせロ……。
#. de: Tanzt!
#. fr: Montrez-moi comment vous dansez<nbsp>!
msgctxt "InstanceContentTextData:44505:0:0"
msgid "Dance!"
msgstr "Танцуйте!"

#. ja: 次はコイツを試そウ。
#. de: Jetzt mal was anderes.
#. fr: Essayons-en une autre.
msgctxt "InstanceContentTextData:44506:0:0"
msgid "Now for something different."
msgstr "А теперь попробуем кое-что другое."

#. ja: ここで朽ちヨ！
#. de: Bin ich nicht gemein?
#. fr: Vous allez pourrir ici<nbsp>!
msgctxt "InstanceContentTextData:44507:0:0"
msgid "Your corpses will rot here!"
msgstr "Здесь вам и гнить!"

#. ja: 逃げ惑エ……。
#. de: Wer wird denn weglaufen!
#. fr: Fuyez donc si vous le pouvez...
msgctxt "InstanceContentTextData:44508:0:0"
msgid "There is no escape."
msgstr "Бежать бесполезно."

#. ja: しぶとい奴らメ……！
#. de: Spielverderber!
#. fr: Vermine coriace que vous êtes...<nbsp>!
msgctxt "InstanceContentTextData:44509:0:0"
msgid "Stubborn wretches!"
msgstr "Упрямые негодяи!"

#. ja: 我が糧となるがイイ……。
#. de: Das könnte ich ewig machen<nbsp>...
#. fr: Je me nourrirai de vos âmes...
msgctxt "InstanceContentTextData:44510:0:0"
msgid "What delicious morsels you will make..."
msgstr "Какие же вы будете лакомые кусочки..."

#. ja: コンメルキウム区の踏破
#. de: Das Commercium erobern
#. fr: Franchir le commercium
msgctxt "InstanceContentTextData:44511:0:0"
msgid "Clear the Commercium"
msgstr "Пройти Коммерциум"

#. ja: アーマードアイの撃破
#. de: Das Panzerauge besiegen
#. fr: Vaincre l'œil blindé
msgctxt "InstanceContentTextData:44512:0:0"
msgid "Defeat the eye of the scorpion"
msgstr "Победить Око скорпиона"

#. ja: 魔導工廠への道の踏破
#. de: Den Weg zum Klyteum erobern
#. fr: Atteindre le Clyteum
msgctxt "InstanceContentTextData:44513:0:0"
msgid "Clear a path to the Clyteum"
msgstr "Пробиться к Клитею"

#. ja: チョルトの撃破
#. de: Chort besiegen
#. fr: Vaincre le chort
msgctxt "InstanceContentTextData:44514:0:0"
msgid "Defeat the chort"
msgstr "Победить хортиса"

#. ja: クルティウス魔導工廠の踏破
#. de: Das Klyteum erobern
#. fr: Franchir le Clyteum
msgctxt "InstanceContentTextData:44515:0:0"
msgid "Clear the Clyteum"
msgstr "Пройти Клитей"

#. ja: マルファスの撃破
#. de: Malphas besiegen
#. fr: Vaincre Malphas
msgctxt "InstanceContentTextData:44516:0:0"
msgid "Defeat Malphas"
msgstr "Победить Малфаса"

#. ja: お前たち、来てくれたか！
#. de: Da seid ihr ja!
#. fr: Les amis, vous êtes là<nbsp>!
msgctxt "InstanceContentTextData:44517:0:0"
msgid "You're a sight for sore eyes!"
msgstr "Ну наконец-то! Рад вас видеть!"

#. ja: すまない、助かった！
#. de: Danke für die Hilfe.
#. fr: Merci de votre aide. Vraiment.
msgctxt "InstanceContentTextData:44518:0:0"
msgid "Appreciate the help."
msgstr "Спасибо, выручили."

#. ja: グギ……貴様ラノ世界ニ……<br>我ラノ、安住ノ地ヲ……！
#. de: Wir bringen eurer Welt Frieden und ewige Stille.
#. fr: GnIiIiIihH... VoTrE mOnDe SeRa... NoTrE nOuVeLlE mAiSoN !
msgctxt "InstanceContentTextData:44519:0:0"
msgid "Your world is forfeit!"
msgstr "Ваш мир станет... нашим... новым домом...!"

#. ja: 我ガ眼力、スベテヲ石ニ……！
#. de: Mein Auge macht euch zu Stein!
#. fr: MoN œIl Va VoUs PéTrIfIeR !
msgctxt "InstanceContentTextData:44520:0:0"
msgid "All shall be turned to stone!"
msgstr "Мой взгляд обратит всё в камень...!"

#. ja: サァ、動イテミロ……！
#. de: Das ist die Stille, von der ich sprach.
#. fr: EsSaYeZ dOnC dE bOuGeR, hÉ hÉ hÉ !
msgctxt "InstanceContentTextData:44521:0:0"
msgid "The slightest movement will guarantee your doom!"
msgstr "Ну же, попробуйте пошевелиться...!"

#. ja: あとは俺たちで何とかする。<br>お前たちはヴォイドクラックを目指してくれ！
#. de: Den Rest schaffen wir. Kümmert ihr euch um das Portal!
#. fr: On se charge du reste. Occupez-vous de la fissure<nbsp>!
msgctxt "InstanceContentTextData:44522:0:0"
msgid "We'll handle things from here. Take care of the fissure!"
msgstr "Дальше мы сами справимся. Вы займитесь разломом!"

#. ja: 貴様らを傀儡とするのも一興カ……。
#. de: Vielleicht sollte ich euch auch in Marionetten verwandeln.
#. fr: Peut-être devrais-je vous changer en marionnette vous aussi, hé hé...
msgctxt "InstanceContentTextData:44523:0:0"
msgid "Care to join my horde? You would make such fine minions..."
msgstr "Может, и вас сделать марионетками? Из вас выйдут славные прислужники..."

#. ja: ウィンダスの突破
#. de: Windurst erobern
#. fr: Franchir Windurst
msgctxt "InstanceContentTextData:44600:0:0"
msgid "Clear Windurst"
msgstr "Пройти Виндурст"

#. ja: 皇都アルザビの突破
#. de: Al Zahbi erobern
#. fr: Franchir Al Zahbi
msgctxt "InstanceContentTextData:44601:0:0"
msgid "Clear Al Zahbi"
msgstr "Пройти Аль-Захби"

#. ja: アルザダール海底遺跡群の突破
#. de: Die Unterwasserruinen von Alzadaal erobern
#. fr: Franchir les Ruines immergées d'Alzadaal
msgctxt "InstanceContentTextData:44602:0:0"
msgid "Clear the Alzadaal Undersea Ruins"
msgstr "Пройти Подводные руины Альзадала"

#. ja: ル・メトの園の突破
#. de: Den Garten von Ru'Hmet erobern
#. fr: Franchir le Jardin de Ru'Hmet
msgctxt "InstanceContentTextData:44603:0:0"
msgid "Clear the Garden of Ru'Hmet"
msgstr "Пройти Сад Ру'Хмет"

#. ja: 天象の鎖の突破
#. de: Empyreal-Paradox erobern
#. fr: Franchir le Paradoxe empyréen
msgctxt "InstanceContentTextData:44604:0:0"
msgid "Clear the Empyreal Paradox"
msgstr "Пройти Эмпирееву Парадокс"

#. ja: アビセア-天象の鎖の突破
#. de: Abyssea - Empyreal-Paradox erobern
#. fr: Franchir Abyssée - Paradoxe empyréen
msgctxt "InstanceContentTextData:44605:0:0"
msgid "Clear the Abyssean Empyreal Paradox"
msgstr "Пройти Эмпирееву Парадокс Абиссии"

#. ja: あれは星の大樹……<br>ウィンダス石の区を模倣したのか！
#. de: Der Sternenbaum<nbsp>...! Wurde hier etwa Windurst-Mauern nachgebildet?
#. fr: L'Arbre aux étoiles... C'est donc une reproduction des Remparts de Windurst<nbsp>?
msgctxt "InstanceContentTextData:44606:0:0"
msgid "The Great Star Tree? This must be Windurst Walls..."
msgstr "Великое звёздное дерево? Значит, это Стены Виндурста..."

#. ja: サレージャはいったい、どんな「残滓」を創りだしたのか……。
#. de: Was für Echos hat Sareel Ja nur dieses Mal erzeugt<nbsp>...?
#. fr: Les nouveaux Échos de Sareel Ja risquent d'être plus redoutables que jamais...
msgctxt "InstanceContentTextData:44607:0:0"
msgid "What echoes has Sareel Ja conjured this time, I wonder?"
msgstr "Интересно, каких Эхо на этот раз вызвал Сариль Джа?"

#. ja: この街並み……<br>まさか、アトルガン皇国の「残滓」だと言うのか？
#. de: Diese Straßen<nbsp>... Ist das ein Echo von Aht Urhgan?
#. fr: Cette architecture... C'est celle de l'Empire d'Aht Urhgan<nbsp>!
msgctxt "InstanceContentTextData:44608:0:0"
msgid "By Altana, this looks like Aht Urhgan."
msgstr "Клянусь Альтаной, да это же Ахт Урган!"

#. ja: ヴァナ・ディールの記憶を、こうも好き勝手に！<br>サレージャ……必ず止めてみせるぞ！
#. de: Die Erinnerungen aus Vana'diel so zu missbrauchen<nbsp>... Sareel Ja darf nicht ungestraft davonkommen!
#. fr: Encore un fragment de Vana'diel bafoué par Sareel Ja<nbsp>! Il ne s'en tirera pas à si bon compte<nbsp>!
msgctxt "InstanceContentTextData:44609:0:0"
msgid "It pains me to see the memories of Vana'diel sullied so... Sareel Ja must be stopped!"
msgstr "Как же больно видеть, что память о Вана'диэле так оскверняют... Сариля Джа нужно остановить!"

#. ja: ここは露店が並ぶ賑やかな場所だったはず……。
#. de: Normalerweise wimmelt es hier nur so vor Ständen und Leuten<nbsp>...
#. fr: Ce marché était si paisible autrefois...
msgctxt "InstanceContentTextData:44610:0:0"
msgid "This is meant to be a bustling marketplace..."
msgstr "Здесь ведь должен быть шумный рынок..."

#. ja: この静けさは、いったい……？
#. de: Es ist ungewöhnlich ruhig. Was geht hier vor sich<nbsp>...?
#. fr: Ce calme ne me dit rien qui vaille...
msgctxt "InstanceContentTextData:44611:0:0"
msgid "I mislike this quiet..."
msgstr "С чего бы тут такая тишина?.."

#. ja: 警戒警報！　警戒警報！
#. de: Al Zahbi wird angegriffen!
#. fr: Alerte générale<nbsp>! Alerte générale<nbsp>!
msgctxt "InstanceContentTextData:44612:0:0"
msgid "Al Zahbi is under attack!"
msgstr "Аль-Захби атакуют!"

#. ja: バルラーン絶対防衛ラインを突破！<br>なおも、皇都に向けて進撃中！
#. de: Die Balrahn-Verteidigungslinie wurde durchbrochen! Sie sind im Anmarsch auf die imperiale Hauptstadt!
#. fr: Nos ennemis ont franchi la ligne de défense de Balrahn<nbsp>! Ils avancent sur la capitale impériale<nbsp>!
msgctxt "InstanceContentTextData:44613:0:0"
msgid "The enemy has breached the Balrahn Defense Line! They march on the Imperial capital!"
msgstr "Враг прорвал оборонительную линию Балраана! Он наступает на имперскую столицу!"

#. ja: 繰り返す。<br>全都市、第一級戒厳令発令！
#. de: Ich wiederhole! Über Al Zahbi wurde der Aus<shy>nahme<shy>zustand verhängt!
#. fr: La loi martiale est déclarée dans toutes les cités<nbsp>!
msgctxt "InstanceContentTextData:44614:0:0"
msgid "All non-combatants in the Commoners' Ward are to evacuate immediately."
msgstr "Всем мирным жителям Квартала простолюдинов немедленно эвакуироваться."

#. ja: 皇都防衛戦……「ビシージ」だと……！？<br>間もなくここは戦場となる、襲撃に備えるんだ！
#. de: So ist das also ...! Hier wird gleich eine gewaltige Schlacht stattfinden - ein Bastionskampf!
#. fr: Préparez-vous, la cité va bientôt entrer en état de siège<nbsp>!
msgctxt "InstanceContentTextData:44615:0:0"
msgid "The city has been besieged! Make ready─the enemy will soon be upon us."
msgstr "Город осаждён! Приготовьтесь — враг уже близко."

#. ja: アラアラ……私ノ人形ガコンナニタクサン。<br>カワイイコト……サァ、私ト踊リマセウ！
#. de: Oh, viele kleine Marionetten für mich. Süße Marionetten<nbsp>... Kommt, tanzt mit mir!
#. fr: Tiens, tiens... Regardez-moi tous ces pauvres petits bipèdes. Mes jolies poupées... Venez, dansssez avec moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44616:0:0"
msgid "Well, well... Look at all these adorable two-legs...<br>Come, dance with me, mortals!"
msgstr "Ну-ну... Сколько же тут милых двуногих...<br>Идите ко мне, смертные. Потанцуем!"

#. ja: この遺構……アルザダール海底遺跡群か……！
#. de: Das sind doch ... die Unterwasserruinen von Alzadaal!
#. fr: Je reconnais cet endroit... Les Ruines immergées d'Alzadaal<nbsp>!
msgctxt "InstanceContentTextData:44617:0:0"
msgid "Are these not the undersea ruins of Alzadaal?"
msgstr "Неужели это Подводные руины Альзадала?"

#. ja: いかにサレージャが創りあげた「残滓」が強敵でも、<br>私には彼らを討ち破った記憶がある！
#. de: Sareel Ja kann noch so starke Echos erzeugen, meine Erinnerungen werden uns zum Sieg führen!
#. fr: Sareel Ja peut nous envoyer les Échos les plus puissants de l'univers, je les aurai tous déjà vaincus par le passé<nbsp>!
msgctxt "InstanceContentTextData:44618:0:0"
msgid "There is no foe Sareel Ja can conjure that I have not already vanquished."
msgstr "Сариль Джа может вызвать сколь угодно сильное Эхо — я уже побеждал каждого из них."

#. ja: アレキサンダーの堅牢な守護を討ち破ってみせたな！<br>驕らずに、この先も注意して進もう！
#. de: Nicht einmal Alexanders stählerne Verteidigung konnte euch standhalten! Weiter so, jetzt nicht unvorsichtig werden!
#. fr: Nous avons percé les défenses de fer d'Alexander<nbsp>! Gardons l'œil ouvert pour la suite<nbsp>!
msgctxt "InstanceContentTextData:44619:0:0"
msgid "Well, if even the stalwart defenses of Alexander cannot stop us, I say we press on!"
msgstr "Даже крепкая оборона Александра нас не остановила! Продолжим путь, только не теряйте бдительности!"

#. ja: 白い石材で覆われた、この異様な空間……ル・メトの園か。<br>ならば、この先には……。
#. de: Diese weißen Hallen ...! Wir sind im Garten von Ru'Hmet. Dann wartet wohl „er“ auf uns ...
#. fr: Ces pierres blanches et cette atmosphère si mystérieuse... Si nous sommes dans le Jardin de Ru'Hmet, ça veut dire que...
msgctxt "InstanceContentTextData:44620:0:0"
msgid "The Garden of Ru'Hmet? Then that means..."
msgstr "Сад Ру'Хмет? Значит, впереди..."

#. ja: 先を急ごう。<br>これ以上、サレージャの好きにはさせない！
#. de: Lasst uns schnell weiterziehen, bevor Sareel Ja noch mehr Unheil anrichtet!
#. fr: Dépêchons-nous<nbsp>! Sareel Ja ne l'emportera pas au paradis<nbsp>!
msgctxt "InstanceContentTextData:44621:0:0"
msgid "We should hurry."
msgstr "Надо спешить. Нельзя позволить Сарилю Джа и дальше творить, что вздумается!"

#. ja: 次の選定相手は、ヴァナ・ディールの「男神」か……！<br>サレージャめ、まさか神まで引っ張り出してくるとはな！
#. de: Unser nächster Gegner ist Promathia, ein Gründergott von Vana'diel ...! Macht Sareel Ja denn vor gar nichts halt?
#. fr: Il ne reste plus qu'un seul adversaire auquel Sareel Ja pourrait avoir pensé...
msgctxt "InstanceContentTextData:44622:0:0"
msgid "The Twilight God? Here!? Sareel Ja, you bastard... You'll pay dearly for this."
msgstr "Бог Сумерек? Здесь?! Сариль Джа, мерзавец... Ты за это заплатишь!"

#. ja: ホッホッホ、座興はここまで。<br>「王の器」に選ばれし、神なる竜にご登場いただきましょう！
#. de: Hohoho, das Spielchen ist vorbei! Macht euch bereit, in den Flammen des göttlichen Drachen zu verglühen!
#. fr: Ho ho ho... Fini de jouer, mes petits aventuriers<nbsp>! Préparez-vous à périr dans les flammes du dragon divin en personne, ja<nbsp>!
msgctxt "InstanceContentTextData:44623:0:0"
msgid "Gahahaha! You have done well, but you will go no further! Come forth!"
msgstr "Га-ха-ха! Вы славно потрудились, но дальше не пройдёте! Выходи!"

#. ja: 異なるヴァナ・ディールを滅ぼした神のごとき竜……<br>サレージャめ、こんな存在まで……！
#. de: Der Drachengott hat einst eine ganze Parallelwelt von Vana'diel vernichtet<nbsp>... Sareel Ja hat keine Ahnung, was er da tut<nbsp>...!
#. fr: Ce dragon... C'est la divinité qui a détruit Abyssée, l'autre Vana'diel<nbsp>! Sareel Ja n'a plus aucune limite<nbsp>!
msgctxt "InstanceContentTextData:44624:0:0"
msgid "Shinryu... The divine dragon that brought ruin to Vana'diel's twin."
msgstr "Синрю... Божественный дракон, уничтоживший двойника Вана'диэля."

#. ja: まるで、人が畏怖する象徴の塊だぜ……。<br>「神竜」……とでもいったほうがしっくりくるかもな。
#. de: Eine wahre Inkarnation des Bösen<nbsp>... „Drachengott“ trifft es wirklich perfekt.
#. fr: Shinryu... Voilà un nom qui glace le sang à chaque fois. Le symbole de la frousse par excellence<nbsp>!
msgctxt "InstanceContentTextData:44625:0:0"
msgid "So “world destroyer” wouldn't be an exaggeration for this one? Well that's just wonderful..."
msgstr "Да его впору назвать разрушителем миров. Ну просто замечательно..."

#. ja: かつて、世界の命運を懸けて奴と戦い、討伐した……<br>私には、「そういう記憶」もある。
#. de: かつて、世界の命運を懸けて奴と戦い、討伐した……<br>私には、「そういう記憶」もある。
#. fr: Des souvenirs me reviennent... Je me revois en train de le vaincre durant un combat sans merci, mettant en jeu le salut du monde entier...
msgctxt "InstanceContentTextData:44626:0:0"
msgid "I remember fighting this fiend before... The fate of the world hung in the balance."
msgstr "Я помню, как сражался с этим чудовищем... На кону была судьба всего мира."

#. ja: 何なんだよ、この胸騒ぎは……！<br>俺はおまえのことなんて知らねぇぞ！
#. de: 何なんだよ、この胸騒ぎは……！<br>俺はおまえのことなんて知らねぇぞ！
#. fr: Ouah, ce monstre me fiche un de ces malaises<nbsp>! Pourtant, je l'avais jamais vu de ma vie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44627:0:0"
msgid "何なんだよ、この胸騒ぎは……！<br>俺はおまえのことなんて知らねぇぞ！"
msgstr "Что за дурное предчувствие...! Да я тебя впервые вижу!"

#. ja: へっ、とんでもねぇヤローだぜ。<br>男神プロマシアよりやばい奴がいるなんてな。
#. de: Der scheint ganz schön was auf dem Kasten zu haben. Vielleicht noch mehr als Promathia<nbsp>...
#. fr: Eh ben, il rigole pas, le lézard<nbsp>! Il est encore plus balèze que Promathia... C'est dingue<nbsp>!
msgctxt "InstanceContentTextData:44628:0:0"
msgid "Never thought I'd see a god that'd give Promathia a run for his money."
msgstr "Вот это чудовище! И подумать не мог, что найдётся бог, который даст фору Промату!"

#. ja: 神竜とは、復活した男神のなれの果ての姿だ。<br>「今の君」には、そのことを知る由もないだろうが……。
#. de: Er ist Promathia. Oder besser gesagt, seine weiterentwickelte Form. Aber mir ist bewusst, dass dein jetziges Ich nichts davon wissen kann<nbsp>...
#. fr: Shinryu est l'entité résultant de la décrépitude de Promathia, mais ton incarnation actuelle n'a aucun moyen de le comprendre...
msgctxt "InstanceContentTextData:44629:0:0"
msgid "Promathia assumed this form after its resurrection, though I suppose you would have no way of knowing."
msgstr "После воскрешения Проматия принял эту форму. Впрочем, нынешнему тебе этого не понять."

#. ja: やはり神竜が相手では一筋縄では……<br>それでも、私は負けるわけにはいかない！！
#. de: Wie erwartet macht es uns der Drachengott nicht leicht<nbsp>... aber wir werden nicht verlieren!
#. fr: Même si combattre un tel adversaire est loin d'être une mince affaire, je triompherai quoi qu'il en coûte<nbsp>!
msgctxt "InstanceContentTextData:44630:0:0"
msgid "Shinryu has already brought ruin to one world... We cannot let it come to another."
msgstr "Синрю уже погубил один мир... Нельзя позволить ему погубить и другой."

#. ja: みんな、ふんばれよ！<br>ここが正念場だ！
#. de: Jetzt nicht nachlassen, hört ihr?! Es geht um alles oder nichts!
#. fr: Courage, tout le monde<nbsp>! La victoire est à portée de main<nbsp>!
msgctxt "InstanceContentTextData:44631:0:0"
msgid "Not a chance! Let's kick this thing's scaly arse!"
msgstr "Держитесь, ребята! Сейчас решается всё!"

#. ja: 今度はなんだってんだ！？
#. de: Was denn jetzt noch?!
#. fr: Qu'est-ce qui m'arrive<nbsp>!?
msgctxt "InstanceContentTextData:44632:0:0"
msgid "What the hell was that!?"
msgstr "Да что это, чёрт возьми, было?!"

#. ja: あれは、サレージャの創りし「王の器」……<br>まさか、選定が……！？
#. de: Das Echo von Gulool Ja Ja<nbsp>...? Heißt das etwa<nbsp>...?!
#. fr: Voilà donc l'élu de Sareel Ja<nbsp>? Le “réceptacle”<nbsp>?
msgctxt "InstanceContentTextData:44633:0:0"
msgid "Has Sareel Ja finally prepared the “vessel” for his king?"
msgstr "Сариль Джа наконец создал «сосуд» для своего короля?"

#. ja: おい、取り込んじまったぞ！？
#. de: H-He, sie sind miteinander verschmolzen!
#. fr: Eh, je rêve pas<nbsp>? Ils ont fusionné<nbsp>!?
msgctxt "InstanceContentTextData:44634:0:0"
msgid "Did...did he just...?"
msgstr "Он... что, только что...?"

#. ja: グルルゥルルルッ！<br>ヨクゾ、ヤッテクレタ、サレー、ジャ！
#. de: Bwahahaha! Du hast mir gut gedient, Sareel Ja!
#. fr: GRAAAAAAAHHH<nbsp>!!! Tu t'es enfin rendu utile, Sareel Ja<nbsp>!
msgctxt "InstanceContentTextData:44636:0:0"
msgid "Mwahahaha! You have done well, Sareel Ja!"
msgstr "Мвахахаха! Ты хорошо послужил мне, Сариль Джа!"

#. ja: 手ニ入レタ、ゾ！<br>人間ヲ、滅ボスタメノ力、ヲ！
#. de: Endlich ...! Mit dieser Macht werde ich alle Sterblichen ausrotten!
#. fr: Le pouvoir qui détruira l'humanité tout entière est enfin entre nos mains<nbsp>!
msgctxt "InstanceContentTextData:44637:0:0"
msgid "This world is mine to conquer. Mine to rule forevermore!"
msgstr "Этот мир покорится мне. Я буду править им вечно!"

#. ja: なんだ！？<br>あいつ、どうなっちまったんだ！？
#. de: なんだ！？<br>あいつ、どうなっちまったんだ！？
#. fr: Mais c'est quoi ce bordel<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44638:0:0"
msgid "なんだ！？<br>あいつ、どうなっちまったんだ！？"
msgstr "Что?! Что с ним стало?!"

#. ja: 神竜に同化された……<br>いや、逆に取り込んだというのか！
#. de: 神竜に同化された……<br>いや、逆に取り込んだというのか！
#. fr: Gulool Ja Ja a absorbé le réceptacle... ou bien est-ce l'inverse<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44639:0:0"
msgid "神竜に同化された……<br>いや、逆に取り込んだというのか！"
msgstr "Он слился с Шинрю... Нет, скорее сам поглотил его!"

#. ja: 王ノ選定ハ、定マッタ。<br>我々ガ、神ヲモ喰ラウ、真ナル王、ナリ！
#. de: 王ノ選定ハ、定マッタ。<br>我々ガ、神ヲモ喰ラウ、真ナル王、ナリ！
#. fr: Le véritable aurarque du Tuliyollal sera bientôt amené à régner, ja... Tous se soumettront à nous, jusqu'aux Dieux en personne<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44640:0:0"
msgid "王ノ選定ハ、定マッタ。<br>我々ガ、神ヲモ喰ラウ、真ナル王、ナリ！"
msgstr "Выбор короля сделан.<br>Мы — истинный король, пожирающий даже богов!"

#. ja: 喰ラオウゾ！　コノ世界、ヲ！
#. de: 喰ラオウゾ！　コノ世界、ヲ！
#. fr: Ce monde deviendra nôtre, qu'il le veuille ou non<nbsp>!
msgctxt "InstanceContentTextData:44641:0:0"
msgid "喰ラオウゾ！　コノ世界、ヲ！"
msgstr "Пожрём этот мир!"

#. ja: 異界の冒険者と旅した美しい世界……<br>貴様の好きにさせはしない！
#. de: 異界の冒険者と旅した美しい世界……<br>貴様の好きにさせはしない！
#. fr: Je ne te laisserai pas souiller le monde merveilleux de mon ami<if $gn4>e</if><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44642:0:0"
msgid "異界の冒険者と旅した美しい世界……<br>貴様の好きにさせはしない！"
msgstr "Я не позволю тебе творить что вздумается с этим прекрасным миром, по которому я странствовал с авантюристом из другого мира..."

#. ja: 俺はこの世界を守りたい！だから、おまえはここでぶっ倒す！
#. de: 俺はこの世界を守りたい！だから、おまえはここでぶっ倒す！
#. fr: Je tiens à ce monde autant qu'au mien, t'as compris<nbsp>? Pas question de te laisser le détruire<nbsp>!
msgctxt "InstanceContentTextData:44643:0:0"
msgid "俺はこの世界を守りたい！だから、おまえはここでぶっ倒す！"
msgstr "Я хочу защитить этот мир! Поэтому я здесь тебя и уложу!"

#. ja: 畏レヨ！　王ノ審判、ヲ！
#. de: 畏レヨ！　王ノ審判、ヲ！
#. fr: Tremblez, car notre sentence sera terrible, ja<nbsp>!
msgctxt "InstanceContentTextData:44644:0:0"
msgid "畏レヨ！　王ノ審判、ヲ！"
msgstr "Трепещите! Перед судом короля!"

#. ja: 何が王だ！<br>この世界におまえの国なんてねぇ！
#. de: 何が王だ！<br>この世界におまえの国なんてねぇ！
#. fr: Va voir ailleurs si t'y es, Aurarque de pacotille<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44645:0:0"
msgid "何が王だ！<br>この世界におまえの国なんてねぇ！"
msgstr "Какой ты, к чёрту, король?! В этом мире у тебя нет никакого королевства!"

#. ja: サレージャの野望は、ここで終わらせる！
#. de: サレージャの野望は、ここで終わらせる！
#. fr: Sareel Ja<nbsp>! Ta route s'arrête ici et maintenant<nbsp>!
msgctxt "InstanceContentTextData:44646:0:0"
msgid "サレージャの野望は、ここで終わらせる！"
msgstr "Здесь мы покончим с амбициями Сариля Джа!"

#. ja: ソナタラ、ニ、逃ゲ場ナド、ナ、イ……！
#. de: ソナタラ、ニ、逃ゲ場ナド、ナ、イ……！
#. fr: Vous n'avez nulle part où fuir, misérables humains<nbsp>!
msgctxt "InstanceContentTextData:44647:0:0"
msgid "ソナタラ、ニ、逃ゲ場ナド、ナ、イ……！"
msgstr "Вам некуда бежать...!"

#. ja: 異界ノ王ノ、祝福ノ炎ヨ……
#. de: Flammen des Herrschers, in göttlicher Macht vereint ...
#. fr: Que ce feu de joie vous dévore, ja<nbsp>!
msgctxt "InstanceContentTextData:44648:0:0"
msgid "O sacred flame from beyond..."
msgstr "О священное пламя из-за пределов мира..."

#. ja: 我ガ敵ヲ灼ク、紅蓮ノ刃ト、化セ！！
#. de: Werdet zur glühenden Klinge, die meine Feinde zerteilt!
#. fr: Que notre lame ardente vous pourfende<nbsp>!
msgctxt "InstanceContentTextData:44649:0:0"
msgid "Become my blade, and consign my foes to ash!"
msgstr "Стань алым клинком, что испепелит моих врагов!"

#. ja: 来るぞ！　皆の力を貸してくれ！
#. de: Macht euch bereit! Leiht mir eure Kraft!
#. fr: Prêtez-moi votre force, camarades<nbsp>!
msgctxt "InstanceContentTextData:44650:0:0"
msgid "Everyone! With me!"
msgstr "Все! Ко мне!"

#. ja: ぐッ……！
#. de: Ugh ...!
#. fr: Urgh...<nbsp>!
msgctxt "InstanceContentTextData:44651:0:0"
msgid "Urgh!"
msgstr "Гх...!"

#. ja: もういい、アルシャール！<br>それ以上は、おまえの身体が……！
#. de: Alxaal, das reicht! Dein Körper macht das nicht mehr lange mit!
#. fr: Fais pas l'idiot, Alxaal<nbsp>! Ton corps risque de lâcher<nbsp>!
msgctxt "InstanceContentTextData:44652:0:0"
msgid "Alxaal, stop! That's enough!"
msgstr "Алхааль, остановись! Хватит!"

#. ja: うおおおおおおおおおおっ！
#. de: Nghhhhhaaaaaa!
#. fr: UOOOOOOOOOOOHHHH<nbsp>!!!
msgctxt "InstanceContentTextData:44653:0:0"
msgid "Ahhhhhh!"
msgstr "А-а-а-а-а-а-а!"

#. ja: 紛イ物、ゴトキ、ニ、防ガレタ、ダト……！？
#. de: Solch mickrige Imitationen halten meiner göttlichen Macht stand ...?!
#. fr: De vulgaires con<shy>tre<shy>fa<shy>çons osent se rebeller contre l'autorité du véritable Aurarque<nbsp>!?
msgctxt "InstanceContentTextData:44654:0:0"
msgid "Insolence! You dare defy me!?"
msgstr "Наглецы! Вы смеете мне перечить?!"

#. ja: アルシャール！<br>おい、しっかりしろ！！
#. de: Alxaal! Alxaal, geht's dir gut?!
#. fr: Alxaal<nbsp>! Tiens bon<nbsp>!!
msgctxt "InstanceContentTextData:44655:0:0"
msgid "Alxaal! Alxaal!!!"
msgstr "Алхааль! Алхааль!!!"

#. ja: こんなところで倒れてはいられないさ……。<br>私たちの冒険は、まだ道の途中なのだからな……！
#. de: Nicht im Traum würde ich es mir erlauben, hier zu fallen ...! Unser Abenteuer ist noch nicht zu Ende ...!
#. fr: Je n'ai pas le droit de lâcher prise... Pas tant que notre aventure se poursuit<nbsp>!
msgctxt "InstanceContentTextData:44656:0:0"
msgid "Don't you worry about me, Prishe... I'll see this adventure to its conclusion."
msgstr "Не волнуйся за меня, Прише... Я доведу наше приключение до конца."

#. ja: 受ケヨ、王ノ鉄槌、ヲ！
#. de: Ein wahrer König herrscht mit eiserner Faust!
#. fr: Que la puissance de l'Aurarque vous écrabouille, ja<nbsp>!
msgctxt "InstanceContentTextData:44657:0:0"
msgid "Face the king's judgment!"
msgstr "Прими же приговор короля!"

#. ja: 聴ケ！　王ノ天声、ヲ！
#. de: Mein Wort ist absolut!
#. fr: Obéissez à la volonté de votre souverain<nbsp>!
msgctxt "InstanceContentTextData:44658:0:0"
msgid "My word is absolute!"
msgstr "Моё слово — закон!"

#. ja: 跪ケ！　王ノ覇道、ニ！
#. de: 跪ケ！　王ノ覇道、ニ！
#. fr: Soumettez-vous à la domination de votre maître<nbsp>!
msgctxt "InstanceContentTextData:44659:0:0"
msgid "Kneel before me!"
msgstr "На колени передо мной!"

#. ja: 慄ケ！　王ノ奇跡、ニ！
#. de: 慄ケ！　王ノ奇跡、ニ！
#. fr: Prosternez-vous devant le miracle que nous incarnons<nbsp>!
msgctxt "InstanceContentTextData:44660:0:0"
msgid "Tremble before my majesty!"
msgstr "Трепещи перед моим величием!"

#. ja: 墜チヨ！　深淵ヘ！
#. de: 墜チヨ！　深淵ヘ！
#. fr: Plongez dans l'oubli des abysses de ce monde, ja<nbsp>!
msgctxt "InstanceContentTextData:44661:0:0"
msgid "I will care for you the deepest of graves!"
msgstr "Я уготовлю тебе могилу поглубже!"

#. ja: 見ヨ！　王ノ権能、ヲ！
#. de: Erkennt die Macht eures Königs!
#. fr: Admirez l'autre versant du territoire obscur<nbsp>!
msgctxt "InstanceContentTextData:44662:0:0"
msgid "I will not be denied!"
msgstr "Не выйдет у тебя мне отказать!"

#. ja: 真ナル王ヲ前ニシ、テ、ナゼ降伏セヌ……！
#. de: 真ナル王ヲ前ニシ、テ、ナゼ降伏セヌ……！
#. fr: Pourquoi ne pliez-vous pas... devant notre infinie supériorité, ja<nbsp>?
msgctxt "InstanceContentTextData:44663:0:0"
msgid "None stand above me! Why do you not yield!"
msgstr "Никто мне не ровня! Почему же вы не сдадитесь?!"

#. ja: ニンゲンドモ、ヨ……<br>我々ニ……我々………ハ？
#. de: ニンゲンドモ、ヨ……<br>我々ニ……我々………ハ？
#. fr: Misérables humains... Vous... Nous... Je...<nbsp>?
msgctxt "InstanceContentTextData:44664:0:0"
msgid "Arrogant mortals... I... I am king... I am..."
msgstr "Жалкие смертные... Я... я король... Я..."

#. ja: 今のを避けきるとはなぁ！<br>大したやつらだぜ！
#. de: Niemand wurde getroffen?! Ihr seid echt der Hammer!
#. fr: Bravo, les gars<nbsp>! C'est ce que j'appelle avoir le sens du placement<nbsp>!
msgctxt "InstanceContentTextData:44665:0:0"
msgid "Everyone all right? Hah, thought as much!"
msgstr "Все целы? Ха! Так и думал!"

#. ja: 誰かケガしちまったみてーだな……！<br>なんとかもちこたえてくれよ！
#. de: Mist, wir haben Verwundete ...! Haltet ja durch, hört ihr?!
#. fr: Tout le monde ne pète pas la forme, on dirait... Il faut soigner ceux qui en ont besoin<nbsp>!
msgctxt "InstanceContentTextData:44666:0:0"
msgid "Oh, that looks like it hurt. Hang in there..."
msgstr "Ох, больно, небось... Держитесь..."

#. ja: 仲間が倒されちまったのか！？<br>誰か、手を貸してやってくれ！
#. de: Hier hat's jemanden heftig erwischt! Wir brauchen Hilfe!
#. fr: Vite, un sort de résurrection<nbsp>! On doit conserver l'avantage du nombre<nbsp>!
msgctxt "InstanceContentTextData:44667:0:0"
msgid "Oh, oh no─someone's down! Can anyone revive them?"
msgstr "О нет, кто-то пал! Может, кто-нибудь воскресит его?"

#. ja: 限界を超えた攻撃……！<br>これが異界の冒険者が持つ力か！
#. de: Ein Angriff, der die eigenen Grenzen überschreitet ...! Eure Macht ist wahrlich beeindruckend!
#. fr: Cette attaque dépassait l'entendement<nbsp>! Votre monde est décidément plein de surprises<nbsp>!
msgctxt "InstanceContentTextData:44668:0:0"
msgid "A truly mighty blow! The adventurers of your world are extraordinary indeed!"
msgstr "Вот это удар! И впрямь, искатели приключений из вашего мира — сила!"

#. ja: 奇跡の如き癒やしの業……！<br>ありがとう、これでまだ戦える！
#. de: Welch warmer Segen ...! Meine Erschöpfung ist wie weggeblasen!
#. fr: Quel miracle de la nature<nbsp>! Le combat est loin d'être terminé<nbsp>!
msgctxt "InstanceContentTextData:44669:0:0"
msgid "Such potent healing! My thanks!"
msgstr "Вот это исцеление! Спасибо!"

#. ja: 砕けぬ心を具現した、絶対防御……<br>これほど心強いことはない！
#. de: Die Stärke eines resoluten Willens ...! Nichts kann diese Abwehr durchdringen!
#. fr: Cette défense de fer... Que dis-je, une barrière impénétrable<nbsp>! Merci<nbsp>!
msgctxt "InstanceContentTextData:44670:0:0"
msgid "Such adamant defense... Our unbreakable resolve made manifest!"
msgstr "Несокрушимая защита... Словно сама наша несгибаемая воля воплотилась!"

#. ja: 仲間が倒された！　誰か、蘇生魔法を頼む！
#. de: Jemand ist gefallen! Wir brauchen einen Wiederbelebungszauber!
#. fr: Je vois quelqu'un au sol<nbsp>! Lancez-lui un sort de résurrection<nbsp>!
msgctxt "InstanceContentTextData:44671:0:0"
msgid "A comrade is down! Someone revive them!"
msgstr "Союзник пал! Кто-нибудь, воскресите его!"

#. ja: ……私は……アレキサンダー<br>畏れる者に……天寵を……畏れぬ者に……天罰を……
#. de: Ich bin<nbsp>... Alexander<nbsp>...<br>Die Unterwürfigen<nbsp>... werden gesegnet<nbsp>...<br>Die Ungläubigen<nbsp>... werden gerichtet<nbsp>...
#. fr: Je suis... Alexander... La bénédiction divine... pour les pénitents... La punition divine... pour les blasphémateurs...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44672:0:0"
msgid "I...am...Alexander...<br>The meek...shall be rewarded...<br>The defiant...shall be judged..."
msgstr "Я... Александр...<br>Смиренные... будут вознаграждены...<br>Непокорные... предстанут перед судом..."

#. ja: アレキサンダーと、再び相まみえることになるとは……！
#. de: Dass ich Alexander erneut gegen<shy>über<shy>stehen würde<nbsp>...
#. fr: Je me retrouve une nouvelle fois face à Alexander...<nbsp>!
msgctxt "InstanceContentTextData:44673:0:0"
msgid "Alexander. So we meet again..."
msgstr "Александр. Вот мы и встретились снова..."

#. ja: 「残滓」といえど、この威圧感はアレキサンダーそのものだ……！
#. de: Selbst als Echo grenzt seine Macht an das Unvorstellbare<nbsp>...!
#. fr: Écho ou pas, Alexander nous envoie l'artillerie lourde<nbsp>!
msgctxt "InstanceContentTextData:44674:0:0"
msgid "How is it an echo can match the resilience of Alexander?"
msgstr "Как же это «эхо» может быть таким же стойким, как сам Александр?"

#. ja: 汝の魂に……不変の秩序を……我が裁きにて……示さん……
#. de: 汝の魂に……不変の秩序を……我が裁きにて……示さん……
#. fr: Que l'ordre immuable... asservisse vos âmes... Mon jugement... sera votre révélation...
msgctxt "InstanceContentTextData:44675:0:0"
msgid "汝の魂に……不変の秩序を……我が裁きにて……示さん……"
msgstr "Душам вашим... неизменный порядок... явлю... судом своим..."

#. ja: 我が熱が……汝の罪科を……<br>清め……浄化しよう……
#. de: Möge meine Hitze<nbsp>... eure Sünden<nbsp>... reinwaschen<nbsp>...
#. fr: Mes flammes consumeront vos péchés... et vous laveront de toute souillure...
msgctxt "InstanceContentTextData:44676:0:0"
msgid "Thy sin...shall be cleansed...by righteous fire..."
msgstr "Грехи твои... очистит... праведный огонь..."

#. ja: 我が光が……迷いし汝に……<br>明日への道を……指し示さん……
#. de: Öffnet eure Augen<nbsp>... Mein Licht<nbsp>... wird euch leiten<nbsp>...
#. fr: Ma lumière... montrera le chemin... à vos âmes égarées...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44677:0:0"
msgid "Open thine eyes...<br>My radiance...shall guide thee..."
msgstr "Открой глаза...<br>Сияние моё... укажет тебе путь..."

#. ja: 我がともし火が……汝の咎を……<br>赦し……焼き払おう……
#. de: Ich werde sie wegbrennen<nbsp>... Eure Schuld<nbsp>...
#. fr: Mon feu... purifiera vos fautes... et consumera vos péchés...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44678:0:0"
msgid "Offer thy worship...<br>I shall burn away...thy transgressions..."
msgstr "Поклонись мне...<br>И я сожгу... все твои прегрешения..."

#. ja: 我が炎にて……肉を炙り……臓を焼き……<br>骨を焦がし……汝の魂を解き放とう……
#. de: Mein Feuer<nbsp>... wird euer Fleisch verbrennen<nbsp>... und eure Seelen erlösen<nbsp>...
#. fr: Repaissez-vous... du festin de vos âmes... purifiées par mon feu...
msgctxt "InstanceContentTextData:44679:0:0"
msgid "My divine flames...shall melt thy flesh...sear thy bones...unshackle thy soul..."
msgstr "Пламя божественное... плоть твою растопит... кости опалит...<br>душу освободит..."

#. ja: 私は不朽であり……不滅であり……<br>不可量であり……不可侵である……
#. de: Ich<nbsp>... bin unzerstörbar<nbsp>... Unverwundbar<nbsp>... Unantastbar<nbsp>...
#. fr: Je suis immortel... impérissable... intouchable...
msgctxt "InstanceContentTextData:44680:0:0"
msgid "I am immutable...indestructible...impervious...immortal..."
msgstr "Я неизменен... неразрушим... непробиваем... бессмертен..."

#. ja: さすがは、アトルガンの守護者というべきか……！
#. de: Der Wächter von Aht Urhgan macht seinem Namen wirklich alle Ehre<nbsp>...!
#. fr: Pas de doute, voilà bien le protecteur d'Aht Urhgan<nbsp>!
msgctxt "InstanceContentTextData:44681:0:0"
msgid "I'd expect nothing less of such a deity."
msgstr "От такого божества иного и не ждёшь."

#. ja: 今なら突き崩せるはずだ！
#. de: 今なら突き崩せるはずだ！
#. fr: C'est le moment ou jamais de le faire trembler<nbsp>!
msgctxt "InstanceContentTextData:44682:0:0"
msgid "今なら突き崩せるはずだ！"
msgstr "Сейчас-то мы его и сломим!"

#. ja: 万物の無限を願い……無窮を思い……<br>無常を知り……無痕を見よ……
#. de: Sehnt euch<nbsp>... nach Unsterblichkeit<nbsp>...<br>Doch erkennt<nbsp>... eure Bedeutungslosigkeit<nbsp>...
#. fr: Priez pour l'éternité... Rêvez d'immortalité... Ressentez l'incertitude... Entrevoyez l'insaisissable...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44683:0:0"
msgid "Wish for eternity...yearn for immortality...<br>Sense thy transience...know thy insignificance..."
msgstr "Желай вечности... жажди бессмертия...<br>Почувствуй бренность... осознай ничтожность свою..."

#. ja: これは、「聖なる審判」……！？<br>強力な攻撃に備えてくれ！
#. de: これは、「聖なる審判」……！？<br>強力な攻撃に備えてくれ！
#. fr: Prenez garde<nbsp>! Le verdict divin s'abat sur nous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44685:0:0"
msgid "これは、「聖なる審判」……！？<br>強力な攻撃に備えてくれ！"
msgstr "Так вот он, «Священный суд»...?!<br>Готовьтесь к мощной атаке!"

#. ja: 「聖なる審判」を凌ぐとは……！<br>さすがは、異界の冒険者たちだ！
#. de: Ihr habt sein Urteil überstanden. Eure Stärke überschreitet meine kühnsten Vorstellungen.
#. fr: Endurer le verdict divin et y survivre, seuls les vrais aventuriers en sont capables<nbsp>!
msgctxt "InstanceContentTextData:44686:0:0"
msgid "Still standing in the face of His judgment. Well done!"
msgstr "Выстояли перед Его судом. Молодцы!"

#. ja: 「聖なる審判」の前では、倒れるのも無理はない。<br>ここから立て直すぞ！
#. de: 「聖なる審判」の前では、倒れるのも無理はない。<br>ここから立て直すぞ！
#. fr: Résister au verdict divin n'est pas donné à tout le monde... mais ce n'est pas une raison pour abandonner<nbsp>!
msgctxt "InstanceContentTextData:44687:0:0"
msgid "A comrade has been struck down by His judgment."
msgstr "Перед «Священным судом» и павших винить нельзя.<br>Ну же, соберёмся и продолжим!"

#. ja: ……私は……アレキサンダー<br>恐れる者に……天啓を……恐れぬ者に……天災を……
#. de: ……私は……アレキサンダー<br>恐れる者に……天啓を……恐れぬ者に……天災を……
#. fr: Je suis... Alexander... Ceux qui me craignent... seront acceptés... Ceux qui me défient... seront exterminés...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44688:0:0"
msgid "……私は……アレキサンダー<br>恐れる者に……天啓を……恐れぬ者に……天災を……"
msgstr "Я... Александр...<br>Боящимся... открою истину... не знающим страха... пошлю бедствие..."

#. ja: あの猛攻を凌ぐとは、見事だ……！
#. de: Vorbildlich reagiert! Geradezu meisterhaft!
#. fr: Bravo<nbsp>! Votre sang-froid est admirable<nbsp>!
msgctxt "InstanceContentTextData:44689:0:0"
msgid "Hah, nary a scratch! Well done!"
msgstr "Ха, ни царапины! Вот это молодцы!"

#. ja: 負傷者がいる！<br>癒やし手は力を貸してくれ！
#. de: Wir haben Verwundete<nbsp>...! Heiler, könnt ihr aushelfen?
#. fr: Certains semblent très mal en point<nbsp>! Soigneurs, à vous d'y remédier<nbsp>!
msgctxt "InstanceContentTextData:44690:0:0"
msgid "A comrade is in trouble! Someone heal them!"
msgstr "Кому-то плохо! Целители, помогите!"

#. ja: 今度の相手は手応えがありそうですわね。<br>問答無用でかかっていらっしゃい！
#. de: Und wieder stehen neue Gegner vor mir.<br>Haltet ihr stand oder seid ihr nur Zier?
#. fr: Tiens, voilà du menu fretin pas si menu que ça... Approchez donc pour recevoir votre fessée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44691:0:0"
msgid "What's this? More vermin come to play?<br>I'll put you down without delay."
msgstr "Что такое? Ещё букашки на забаву пожаловали?<br>Сейчас я вас мигом уложу!"

#. ja: シャントット博士は、連邦の黒い悪魔とも称される黒魔道士……<br>サレージャめ、とんでもない「残滓」を創り上げたな……！
#. de: Verflucht seist du, Sareel Ja<nbsp>... Musste es ausgerechnet der „Schwarze Teufel der Föderation“ sein<nbsp>...?
#. fr: À Windurst, le professeur Shantotto est surnommée “la sorcière”... Elle est le pire Écho de mage noir que Sareel Ja pouvait nous envoyer<nbsp>!
msgctxt "InstanceContentTextData:44692:0:0"
msgid "The renowned wizard and demon of the Federation... How has he conjured such a terrible echo?"
msgstr "Знаменитый чародей и демон Федерации... Как же он сумел создать такое ужасное эхо?"

#. ja: 無駄な抵抗はおやめなさいな。
#. de: Widerstand hat keinen Sinn<br>gegen die stärkste Zauberin!
#. fr: Allons allons, inutile de résister...
msgctxt "InstanceContentTextData:44693:0:0"
msgid "Surrender I'll allow, if you but give up now."
msgstr "Лучше сдавайтесь, пока я добрая."

#. ja: さあ！　火力を上げますわよ！
#. de: Das war noch viel zu zart,<br>so langsam komme ich in Fahrt!
#. fr: Bien<nbsp>! Il est temps d'épicer les hostilités<nbsp>!
msgctxt "InstanceContentTextData:44694:0:0"
msgid "For my next feat, let's turn up the heat!"
msgstr "Ну-ка, подбавим жару!"

#. ja: 魔法の真髄、見せてさしあげますわ！
#. de: Die Essenz der wahren Magie<br>zwingt euch alle in die Knie!
#. fr: Mes sorts de magie vont s'abattre sur vous de plein fouet<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:44695:0:0"
msgid "You've no recourse but to cower before my <i>true</i> power!"
msgstr "Остаётся только дрожать перед моей <i>истинной</i> мощью!"

#. ja: このわたくしに不可能はございませんわ！
#. de: Was für andere unmöglich sei,<br>ist für mich nur Spielerei!
#. fr: Impossible n'est pas Shantotto, ooohohohoho<nbsp>!
msgctxt "InstanceContentTextData:44696:0:0"
msgid "Before we're through, you'll learn there's nothing I can't do!"
msgstr "Пока мы не закончили, вы поймёте: для меня нет ничего невозможного!"

#. ja: 従う気がないのなら、ぶっ潰……<br>大人しくしてもらいますわ。
#. de: Weiter kämpft ihr gegen mich an<nbsp>...<br>Doch ihr wisst nicht, was ich noch alles kann!
#. fr: Si vous n'êtes pas sages, je vais vous réduire en bouil... au calme, bien sûr.
msgctxt "InstanceContentTextData:44697:0:0"
msgid "Refuse to obey and I'll make you pay!"
msgstr "Не желаете повиноваться? Пожалеете!"

#. ja: わたくしからは逃げられませんことよ！
#. de: Versucht gar nicht erst zu rennen,<br>meine Rache wird euch verbrennen!
#. fr: Vous n'échapperez à aucune de mes attaques<nbsp>!
msgctxt "InstanceContentTextData:44698:0:0"
msgid "No matter where you run, I'll still have my fun!"
msgstr "Куда бы вы ни бежали, мне всё равно будет весело!"

#. ja: わたくし、ブチ切れましたわ……！
#. de: Ihr habt es geschafft, meine Geduld ist am Ende!
#. fr: Oh<nbsp>! Et voilà, vous m'avez fait perdre mon sang-froid<nbsp>!
msgctxt "InstanceContentTextData:44699:0:0"
msgid "My patience is through─and now so are you!"
msgstr "Моё терпение лопнуло... А теперь лопнетесь и вы!"

#. ja: ……わたくし、ブチ切れましたわ。
#. de: ……わたくし、ブチ切れましたわ。
#. fr: ... Et voilà, vous m'avez fait perdre mon sang-froid.
msgctxt "InstanceContentTextData:44700:0:0"
msgid "My patience is through─and now so are you!"
msgstr "Моё терпение лопнуло... А теперь лопнетесь и вы!"

#. ja: 命の灯火を消してさしあげますわ！
#. de: Nobel war euer Streben,<br>doch nun erlischt die Flamme eurer Leben!
#. fr: Oh... Les petites flammèches de vos vies vont s'éteindre sous peu<nbsp>!
msgctxt "InstanceContentTextData:44701:0:0"
msgid "I shall snuff your flame out─another swift rout!"
msgstr "Я потушу ваш огонёк — и делу конец!"

#. ja: オホホ、飲み込みが早いこと！<br>わたくしの弟子を思い出しましたわ。
#. de: Ihr versteht schnell, das lobe ich mir!<br>Fast, als stünde mein Schüler hier.
#. fr: Ohoho<nbsp>! Quelle agilité<nbsp>! Vous me rappelez mon cher disciple<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44702:0:0"
msgid "Ohoho! You catch on fast!<br>Just like a pupil from my past!"
msgstr "О-хо-хо! Быстро схватываете!<br>Прямо как один мой давний ученик!"

#. ja: オーッホホホホホ！<br>ヘッポコくんには少し難しすぎたようですわね！
#. de: Ooohohohoho! Das war wohl zu schwer,<br>erwartet hätte ich von euch mehr!
#. fr: Oooohohohohoho<nbsp>! Trop difficile pour une bande de ratés dans votre genre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44703:0:0"
msgid "Ohoho! Too slow, I fear!<br>You never stood a chance, my dear!"
msgstr "О-хо-хо! Не успеваете, боюсь!<br>Милые мои, вам ничего не светило!"

#. ja: あら、魔法人形が壊されるだなんて。<br>よござんす……あなたのこと、覚えておいてさしあげますわ。
#. de: Meine arme Puppe, zerstört wie von einer Presse.<br>Glaubt ja nicht, dass ich diese Schmach vergesse<nbsp>...
#. fr: Oh non, ma poupée magique est en miettes... Je me souviendrai de votre performance, et surtout de votre chef...
msgctxt "InstanceContentTextData:44704:0:0"
msgid "You've proven a match for my magicked doll... Perhaps you have merit, after all."
msgstr "Моя зачарованная кукла... И всё же, пожалуй, в вас есть толк."

#. ja: この魔法は……！？<br>周囲に気をつけるんだ！
#. de: Dieser Zauber<nbsp>...?! Bleibt wachsam!
#. fr: Ce sort... Restez vigilants<nbsp>!
msgctxt "InstanceContentTextData:44705:0:0"
msgid "Have care! There's no telling what she'll conjure next."
msgstr "Осторожнее! Кто знает, что она ещё призовёт."

#. ja: くっ……さすがはシャントット博士……<br>皆、大事ないか……！？
#. de: Urgh<nbsp>... Weniger hätte ich auch nicht erwartet. Geht es allen gut?!
#. fr: Le professeur Shantotto ne plaisante pas<nbsp>! Tout le monde va bien<nbsp>?
msgctxt "InstanceContentTextData:44706:0:0"
msgid "Dammit! Is everyone all right?"
msgstr "Чёрт! Все целы?"

#. ja: まだだ、諦めはしない！<br>倒れた仲間を蘇生してくれ！
#. de: Gebt nicht auf! Schnell, helft den Gefallenen!
#. fr: Hors de question d'abandonner maintenant<nbsp>! Un sort de résurrection, vite<nbsp>!
msgctxt "InstanceContentTextData:44707:0:0"
msgid "A comrade is down, but we mustn't give up! Quickly─someone revive them!"
msgstr "Союзник пал, но сдаваться нельзя! Быстро, воскресите его!"

#. ja: 博士が相手では、負傷は避けられまい。<br>癒やし手よ、回復魔法を頼む……！
#. de: Doktor Shantotto überlebt man nicht ohne ein paar Wunden. Heiler, wir verlassen uns auf euch!
#. fr: Les attaques du professeur sont des plus meurtrières<nbsp>! Soigneurs, nous comptons tous sur vous<nbsp>!
msgctxt "InstanceContentTextData:44708:0:0"
msgid "I fear we'll not survive this without powerful healing magicks."
msgstr "Без мощного исцеления нам с доктором не справиться. Целители, надеюсь на вас!"

#. ja: オーッホホホホホ！
#. de: Ooohohohohoho!
#. fr: Oooohohohohoho<nbsp>!
msgctxt "InstanceContentTextData:44709:0:0"
msgid "Ohohoho!"
msgstr "О-хо-хо-хо!"

#. ja: 誰が……　誰から……<br>誰がために……　我を呼ぶ　か……！？
#. de: Wer<nbsp>... riefet meinen Namen?!
#. fr: Qui appelle mon nom...<nbsp>!?
msgctxt "InstanceContentTextData:44710:0:0"
msgid "Who... Who calleth my name...?"
msgstr "Кто... кто зовёт меня?.."

#. ja: 人間の根源である原初の神が相手だ！<br>持てる力のすべてを以て戦うぞ！
#. de: Wir haben es mit einer Gründergottheit zu tun! Kämpft mit aller Kraft!
#. fr: Voici le Dieu de la nuit, source de toute vie humaine<nbsp>! Donnez le meilleur de vous-mêmes, ou ce combat sera notre dernier<nbsp>!
msgctxt "InstanceContentTextData:44711:0:0"
msgid "We stand now before the very father of creation... Hold nothing back."
msgstr "Перед нами сам прародитель всего сущего... Не сдерживайтесь!"

#. ja: 望め　望もう　望むらくは　現身の終わり　を
#. de: Verlangen<nbsp>... Hunger<nbsp>... nach dem Ende der Sterblichkeit.
#. fr: Désirez... Désirez... Soif... de la fin des mortels...
msgctxt "InstanceContentTextData:44712:0:0"
msgid "Yearn... Desire... Hunger...for the end of mortality."
msgstr "Жаждите... желайте... алчите... конца смертных..."

#. ja: 願い　願おう　願わくば　闇　よ
#. de: Sehnsucht nach dem Nichts<nbsp>...
#. fr: Volonté... Volonté... de Néant...
msgctxt "InstanceContentTextData:44713:0:0"
msgid "Desire...for the Emptiness..."
msgstr "Желайте... пустоты..."

#. ja: 選び　選ぶ　選ばれし　死　を
#. de: Besiegelt ist das Schicksal aller<nbsp>...
#. fr: Choisissez... Choisissez... la mort...
msgctxt "InstanceContentTextData:44714:0:0"
msgid "A fate...decided..."
msgstr "Судьба... решена..."

#. ja: 我が　闇　よ
#. de: Das Nichts<nbsp>... durchdringt alles.
#. fr: Que le Néant... vous emporte...
msgctxt "InstanceContentTextData:44715:0:0"
msgid "O darkness..."
msgstr "О тьма..."

#. ja: 伝え　伝えん　伝わろう　我が断片　よ
#. de: Teile meiner Selbst<nbsp>... Nah und fern<nbsp>...
#. fr: Fragments de mon être... Transmigrez...
msgctxt "InstanceContentTextData:44716:0:0"
msgid "Bear unto them...my essence..."
msgstr "Донесите до них... сущность мою..."

#. ja: 墜つ　墜ちよ　墜下せし　星　よ
#. de: Stürzet hernieder<nbsp>... O Sterne.
#. fr: Tombe... Tombe... étoile filante...
msgctxt "InstanceContentTextData:44717:0:0"
msgid "O star...descend from the heavens...I beseech thee..."
msgstr "О звезда... сойди с небес... молю тебя..."

#. ja: 暁の女神よ……。<br>どうか私の胸に、再びの輝きを……！
#. de: O Göttin der Morgenröte<nbsp>...! Erfüllt mein Herz mit Eurem Glanz<nbsp>...!
#. fr: Déesse de l'aube... que ta lumière brille en moi<nbsp>!
msgctxt "InstanceContentTextData:44718:0:0"
msgid "O Altana, I beg your grace once more."
msgstr "Ольтана, молю о милости твоей вновь."

#. ja: 奪おう　驕慢なる　心　を
#. de: Werde mein<nbsp>... Herz voll Arroganz.
#. fr: Soumettez-vous à l'orgueil impromptu...
msgctxt "InstanceContentTextData:44719:0:0"
msgid "Thine arrogant heart shall be mine..."
msgstr "Надменное сердце твоё станет моим..."

#. ja: これは……ヴァナ・ディールの人々が抱える心の闇……<br>「虚ろなる闇」で満たされた領域か……！？
#. de: Dieser Ort<nbsp>... Er ist erfüllt vom „Nichts“, der inneren Dunkelheit der Bewohner Vana'diels!
#. fr: Où sommes-nous<nbsp>? Serait-ce... une repré<shy>sen<shy>ta<shy>tion du Néant qui ronge le cœur des habitants de Vana'diel<nbsp>!?
msgctxt "InstanceContentTextData:44720:0:0"
msgid "This place is... It's been swallowed by the Emptiness, the darkness of man's heart made manifest."
msgstr "Это место... Его поглотила Пустота, воплощение тьмы в людских сердцах."

#. ja: 私はこれまで多くの仲間と出会い、「信頼」を知った！<br>今さら心の闇に呑まれるものか！
#. de: Ich habe unzählige Bünde des Vertrauens mit meinen Kameraden geschmiedet. Als ob ich jetzt dem Nichts erliegen würde!
#. fr: Grâce à mes camarades, j'ai appris à faire confiance aux autres<nbsp>! Le Néant ne peut rien contre la passion qui brûle en moi<nbsp>!
msgctxt "InstanceContentTextData:44721:0:0"
msgid "So long as I hold faith in my comrades, and they in me, darkness shall find no purchase in my heart."
msgstr "Пока я верю своим товарищам, а они верят мне, тьме не овладеть моим сердцем."

#. ja: 留め　留めよ　留まらん　我が身躯　よ
#. de: Der Sieg der Dämmerung ist unausweichlich<nbsp>...
#. fr: Le règne du Dieu de la nuit est inévitable...
msgctxt "InstanceContentTextData:44722:0:0"
msgid "The reign of Twilight is inevitable..."
msgstr "Власть Сумерек неизбежна..."

#. ja: 逆る　逆らえ　逆しまな　お前自身　に
#. de: Die eigene Schwäche begeht Verrat<nbsp>...
#. fr: C'est ta propre faiblesse qui te trahit...
msgctxt "InstanceContentTextData:44723:0:0"
msgid "Thine own weakness betrays thee..."
msgstr "Тебя предаёт твоя же слабость..."

#. ja: 「虚ろなる闇」を取り込んでいるのか！
#. de: Er hat das Nichts in sich aufgenommen!
#. fr: Il absorbe le Néant<nbsp>!?
msgctxt "InstanceContentTextData:44724:0:0"
msgid "It's taking the darkness into itself!"
msgstr "Он поглощает тьму!"

#. ja: 今度こそが　永劫の別れ　だ
#. de: Der ewige Abschied erlöst uns<nbsp>...
#. fr: Voici venu le moment... des adieux intemporels...
msgctxt "InstanceContentTextData:44725:0:0"
msgid "Our farewell shall be...forever."
msgstr "Прощание наше... будет вечным."

#. ja: これは、私が知る男神ではない……<br>おそらく、サレージャの手で記憶を改変されたのだろう。
#. de: Diesen Promathia kenne ich nicht<nbsp>...! Sareel Ja muss auch hier seine Finger im Spiel haben.
#. fr: Ce n'est pas le Promathia que je connais... Mais cer<shy>tai<shy>ne<shy>ment sa réincarnation par les maléfices de Sareel Ja<nbsp>!
msgctxt "InstanceContentTextData:44726:0:0"
msgid "The Twilight God could never... What has Sareel Ja done?"
msgstr "Бог Сумерек не мог быть таким... Что же натворил Сариль Джа?"

#. ja: なんだ……！？
#. de: Was ist das<nbsp>...?!
#. fr: Quoi<nbsp>!?
msgctxt "InstanceContentTextData:44727:0:0"
msgid "What in the world?"
msgstr "Что это такое?!"

#. ja: 「虚ろなる闇」が流れこんでいるのか……！
#. de: Das Nichts fließt aus ihm heraus<nbsp>...!
#. fr: Le Néant se déverse sur nous<nbsp>!
msgctxt "InstanceContentTextData:44728:0:0"
msgid "The Emptiness threatens to spread."
msgstr "Пустота грозит распространиться!"

#. ja: その闇に呑まれないよう、注意してくれ！
#. de: Lasst euch davon nicht verschlucken!
#. fr: Attention à ne pas vous faire absorber<nbsp>!
msgctxt "InstanceContentTextData:44729:0:0"
msgid "Careful, lest the darkness take you."
msgstr "Осторожнее, не дайте тьме поглотить вас!"

#. ja: 偽りの　完全なる　死<br>満ち　満たされん　矮小なる器　よ……
#. de: Ein unechter Tod<nbsp>... Nicht absolut.<br>Verwehrt bleibt diesem Körper<nbsp>... die wahre Erfüllung<nbsp>...
#. fr: Dans la mort absolue mais futile... l'imperfection laisse place... à l'amertume...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44730:0:0"
msgid "A perfect death...denied...<br>The vessel...must needs...be filled..."
msgstr "Совершенная смерть... не свершилась...<br>Сосуд... должен... наполниться..."

#. ja: 私の心の闇を利用する気か！
#. de: Er will die Dunkelheit in meinem Herzen gegen uns verwenden?!
#. fr: Tu n'auras pas ma haine, Dieu de la nuit<nbsp>!
msgctxt "InstanceContentTextData:44731:0:0"
msgid "He means to use the darkness in my heart against us!?"
msgstr "Он хочет обратить тьму в моём сердце против нас?!"

#. ja: 何をするつもりだ、博士！
#. de: Vorsicht, sie führt etwas im Schilde!
#. fr: Mais qu'est-ce qu'elle manigance encore...<nbsp>?
msgctxt "InstanceContentTextData:44732:0:0"
msgid "What are you plotting, witch!?"
msgstr "Что ты задумала, ведьма?!"

#. ja: ブモモモーー！<br>俺サマタチ、ノ、連携ヲ見セテ、ヤル……！
#. de: Hrrraaarrr! Unsere Bande sind allmächtig!
#. fr: BROOOH<nbsp>! Personne n'arrive à la cheville des frères Taureaux<nbsp>!
msgctxt "InstanceContentTextData:44800:0:0"
msgid "Our brotherbond is unbreakable!"
msgstr "Бр-р-о-о-о! Братство наше не сломить!"

#. ja: ブモモモーー！<br>行クゾ、連携ダァ～！
#. de: Jetzt! Gemeinsam sind wir unsterblich!
#. fr: BROOOH<nbsp>! C'est parti pour une attaque combinée<nbsp>!
msgctxt "InstanceContentTextData:44801:0:0"
msgid "Now! We war together!"
msgstr "Вперёд! Вместе мы непобедимы!"

#. ja: ブッ、ブッ、ブモモモーーーーーーー！
#. de: Hrrr ... Hrrr ... Hrrraaarrr!
#. fr: BHOO... RHOO... BROOOOOH<nbsp>!!!
msgctxt "InstanceContentTextData:44802:0:0"
msgid "Hrhhh... Hrhhh... HRAAAGGGHHH!!!"
msgstr "Хр-р-р... Хр-р-р... Р-Р-РА-А-А-А!!!"

#. ja: 地中から狙うゴブよ！
#. de: Pshhh ... Wir zuschlagen aus Untererde!
#. fr: Ça va chauffer sous les pieds de l'<if $gn4>aventurière<else>aventurier</if><nbsp>!
msgctxt "InstanceContentTextData:44803:0:0"
msgid "We'll windknock you from the ground up!"
msgstr "Под землёй подкараулим, гоб!"

#. ja: アタイ流剣技、とくと見るゴブ！
#. de: Mein Schlageschwert so schnell wie Plappermaul, kho!
#. fr: Le maniement de l'épée n'a aucun secret pour Loosefrox<nbsp>!
msgctxt "InstanceContentTextData:44804:0:0"
msgid "My sword is as sharp as my tongueflaps!"
msgstr "Сама увидишь, как я владею мечом, гоб!"

#. ja: これ以上アタイのお芋ちゃんを、<br>狙わないでほしいゴブ～！
#. de: Kho! Hackrum auf Töffelchen is' fiesgemein!
#. fr: L'<if $gn4>aventurière<else>aventurier</if> doit arrêter d'être <if $gn4>méchante<else>méchant</if> avec Patatoune<nbsp>!
msgctxt "InstanceContentTextData:44805:0:0"
msgid "Leave Chewchum Popoto alone, you cheatsneak!"
msgstr "Хватит целиться в мою картошечку, гоб!"

#. ja: ま、まずいゴブ！<br>お芋ちゃん、大丈夫！？
#. de: Töffelchen! Du in Ordnung?
#. fr: Oh non<nbsp>! Patatoune a pris cher<nbsp>!!!
msgctxt "InstanceContentTextData:44806:0:0"
msgid "Chewchum Popoto! Are you all right!?"
msgstr "О-ой, беда, гоб! Картошечка, ты цела?!"

#. ja: ぜーったい負けないゴブ！
#. de: Losfrox hat Eisenwille!
#. fr: Loosefrox veut l'emporter coûte que coûte<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:44807:0:0"
msgid "<i>Now</i> you're asking for it!"
msgstr "<i>Ну</i> всё, ты напросился!"

#. ja: 爆弾の雨を食らうゴブ！
#. de: Heutige Wettersage: Knallschauer!
#. fr: Tapis explosif pour l'<if $gn4>aventurière<else>aventurier</if><nbsp>!
msgctxt "InstanceContentTextData:44808:0:0"
msgid "Dodgedance my blastbombs!"
msgstr "Лови мои бомбы, гоб!"

#. ja: べ、別にピンチなんかじゃないゴブ！<br>アタイひとりでも、やってやるゴブ！
#. de: M-Macht mir gar nix, weizzu?
#. fr: L-Loosefrox n'est pas dos au mur<nbsp>! Elle se battra seule s'il le faut<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:44809:0:0"
msgid "I-I'm not nervous! <i>You're</i> nervous!"
msgstr "Я-я вовсе не нервничаю! <i>Это ты</i> нервничаешь!"

#. ja: お芋ちゃんの力、かりるゴブよ～！
#. de: Töffelchen, mach Leihekraft!
#. fr: Loosefrox va emprunter le pouvoir de Patatoune<nbsp>!
msgctxt "InstanceContentTextData:44810:0:0"
msgid "Lend me your strength, Chewchum Popoto!"
msgstr "Дай мне сил, картошечка!"

#. ja: 小娘よ、我に心を明け渡セ。<br>その身は我がモノなり！
#. de: Diene mir, Tochter der Torheit!
#. fr: Frêle humaine, abandonne-toi à moi corps et âme<nbsp>!
msgctxt "InstanceContentTextData:44900:0:0"
msgid "Obey me, daughter of man!"
msgstr "Повинуйся мне, дочь человеческая!<br>Отныне ты принадлежишь мне!"

#. ja: 魔刃よ、切り裂ケ！
#. de: Deine Klinge folgt meinem Willen.
#. fr: Que ces lames te réduisent en charpie<nbsp>!
msgctxt "InstanceContentTextData:44901:0:0"
msgid "Thy blades to do my bidding."
msgstr "Клинки мои, исполните волю мою!"

#. ja: 万物ヲ我ガ支配下に！
#. de: Die gesamte Schöpfung kriecht vor mir im Staub!
#. fr: Je suis toute-puissante<nbsp>!
msgctxt "InstanceContentTextData:44902:0:0"
msgid "All of creation─mine to wield!"
msgstr "Всё сущее покорится моей воле!"

#. ja: 逃がさんゾ、魔獣使イ！
#. de: Du entkommst mir nicht, <if $gn4>Bändigerin<else>Bändiger</if>!
#. fr: Tu n'as nulle part où fuir, <if $gn4>dresseuse<else>dresseur</if><nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:44903:0:0"
msgid "No escape. <i>Beastmaster</i>."
msgstr "Тебе не уйти. <i>Укротитель</i>."

#. ja: 魔刃よ、焼キ払え！
#. de: Versenge, o Klinge!
#. fr: Mes lames te consumeront<nbsp>!
msgctxt "InstanceContentTextData:44904:0:0"
msgid "By steel, thy flesh be seared!"
msgstr "Сталью плоть твою испепелю!"

#. ja: グァルルルル……！<br>殺ス……殺シてやル……！
#. de: Grrrrrr! Stirb ... STIRB!!!
#. fr: GROOOARRR<nbsp>!!! Tuer<nbsp>! Tuer<nbsp>! Tuer<nbsp>!
msgctxt "InstanceContentTextData:44905:0:0"
msgid "Ghhhrrrhhh! Die... DIE!"
msgstr "Гр-р-р... Умри... УМРИ!"

#. ja: 敗北など……許さヌぞ……<br>我に抵抗するな……小娘が……！
#. de: Töricht! Wage es nicht ... dich mir zu widersetzen!
#. fr: Nul ne me vaincra<nbsp>! Laisse ma volonté t'asservir, frêle humaine<nbsp>!
msgctxt "InstanceContentTextData:44906:0:0"
msgid "My forest... My kindred... All shall be avenged!"
msgstr "Мой лес... мой народ... за всё вы ответите!"
