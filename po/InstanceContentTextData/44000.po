# InstanceContentTextData
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: ロトン・ワーカーたちを倒せ！
#. de: Besiege die Versuchsobjekte!
#. fr: Vaincre tous les marcheurs putrides
msgctxt "InstanceContentTextData:44000:0:0"
msgid "Defeat the rotten walkers!"
msgstr "Одолейте гнилых ходоков!"

#. ja: カーネリアンを倒せ！
#. de: Besiege Carnelian!
#. fr: Vaincre Carnelian
msgctxt "InstanceContentTextData:44001:0:0"
msgid "Defeat Carnelian!"
msgstr "Одолейте Карнелиана!"

#. ja: エレクトロープ兵器を倒せ！
#. de: Besiege die Elektrobwaffen!
#. fr: Vaincre toutes les armes en électrope
msgctxt "InstanceContentTextData:44002:0:0"
msgid "Defeat the electrope armaments!"
msgstr "Одолейте электроповые орудия!"

#. ja: 「リミットブレイク」を使え！
#. de: Setze den Limitrausch ein!
#. fr: Utiliser la Transcendance
msgctxt "InstanceContentTextData:44003:0:0"
msgid "Execute limit break!"
msgstr "Примените лимит-брейк!"

#. ja: クククク……<br>さあショータイムだ、ハルディボイルド。
#. de: Hehehe ... Die Show beginnt, Hildibrüh!
#. fr: Hé hé hé... La fête commence, Hildibrut<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44004:0:0"
msgid "Hm hm hm...<br>Ready for the show, Hardiboiled?"
msgstr "Хм-хм-хм...<br>Ну что, готов к представлению, Хардивойлд?"

#. ja: 眠りにつくのはお前だ。<br>助手のもとに送ってやろう。
#. de: Bist du müde? Ich schicke dich zu deiner Assistentin.
#. fr: C'est toi qui vas manger les pissenlits par la racine... Tout comme ta chère assistante<nbsp>!
msgctxt "InstanceContentTextData:44005:0:0"
msgid "You'll be the one going to his final rest─in the grave next to your assistant!"
msgstr "Это тебе предстоит упокоиться в могиле рядом с помощником!"

#. ja: 我が力を見せてやろう。<br>死者たちよ、立ち上がるのだ！
#. de: Werde Zeuge meiner Macht ...<br>Die Toten erheben sich!
#. fr: Tu sous-estimes mon emprise sur le royaume des morts... Debout, tas de viande pourrie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44006:0:0"
msgid "Now you learn true horror.<br>Damned servants, I bid you rise!"
msgstr "Сейчас ты узнаешь, что такое настоящий ужас.<br>Проклятые слуги, встаньте по моему приказу!"

#. ja: フフフ……<br>助手も蘇らせてほしかったか？
#. de: Hehehe ... Soll ich deine Assistentin etwa auch erwecken?
#. fr: Ha ha ha<nbsp>! Et n'espère pas que je ressuscite ton imbécile d'assistante<nbsp>!
msgctxt "InstanceContentTextData:44007:0:0"
msgid "Ah, how rude of me... Should I have raised Noirshu, as well?"
msgstr "Ах, какой я невежа... Надо было воскресить и Нуаршу?"

#. ja: やってみるがいい。<br>お前は死者を倒すことすらできん！
#. de: Versuch es ruhig. Aber du wirst die Toten nicht besiegen!
#. fr: Tu as beau te démener, tu ne peux pas tuer ce qui est déjà mort<nbsp>!
msgctxt "InstanceContentTextData:44008:0:0"
msgid "Do your worst. You cannot even best these shambling puppets."
msgstr "Давай, покажи, на что способен. Тебе даже этих шатких кукол не одолеть."

#. ja: 仕方ない、死者は死者らしく、<br>おネンネしてもらうか。
#. de: Tja, was soll’s. Ich schenke ihnen ihre verdiente Ruhe.
#. fr: Comptez sur moi pour vous renvoyer six pieds sous terre. Et restez morts cette fois-ci.
msgctxt "InstanceContentTextData:44009:0:0"
msgid "Lookin' pretty decayed there, Carnelian. And dead things oughta be sleeping in the ground."
msgstr "Совсем развалился, Карнелиан. Мертвецам положено лежать в земле."

#. ja: そのときは、お前も道連れだ。<br>ま、俺たちは地獄行きだがな。
#. de: Und du, du wirst sie begleiten. Bis in die Tiefen der Höllen!
#. fr: Ce n'est qu'une question de temps avant que tu mordes la poussière et nous rejoignes en enfer<nbsp>!
msgctxt "InstanceContentTextData:44010:0:0"
msgid "Nah, I'll take you down with me, punk. One-way ticket to hell."
msgstr "Не-а, я тебя с собой заберу, засранец. Билет в один конец — прямиком в ад."

#. ja: このまま眠らせてやればいいものを……<br>人使いが荒いな。
#. de: Dabei haben sie doch so tief geschlafen. Sie können einem wirklich leidtun.
#. fr: Laisse-les reposer en paix<nbsp>! Tu n'as décidément aucun cœur.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44011:0:0"
msgid "For the love of... Just let 'em stay dead.<br>Cruel bastard."
msgstr "Ради всего святого... Да оставь ты их мёртвыми.<br>Жестокий ублюдок."

#. ja: 笑えねぇな。<br>次はお前の軽口を塞いでやる！
#. de: Das ist nicht lustig. Ich werde dir das Handwerk legen!
#. fr: Épargne-moi tes leçons de morale. Il est grand temps que je te cloue le bec<nbsp>!
msgctxt "InstanceContentTextData:44012:0:0"
msgid "Good one, wise guy. Let's see you smile when I knock out all those rotten teeth."
msgstr "Ха-ха, смешно. Посмотрим, как ты улыбнёшься, когда я выбью тебе эти гнилые зубы."

#. ja: チッ……キリがないぜ……。
#. de: Hört das denn nie auf?
#. fr: Tsk... Ça n'en finit pas...
msgctxt "InstanceContentTextData:44013:0:0"
msgid "This is getting real old, real fast..."
msgstr "Ну и надоело же это..."

#. ja: もう安心ですぞ！<br>私にお任せください……！
#. de: Keine Angst! Hildibrand ist zur Stelle!
#. fr: Tout va bien maintenant. Pourquoi<nbsp>? Parce que je suis là<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44014:0:0"
msgid "Fear not, Detective!<br>I, Hildibrand, agent of enquiry, am here to help you win the day!"
msgstr "Не бойтесь, детектив!<br>Я, Хильдибранд, сыщик на службе правосудия, помогу вам одержать победу!"

#. ja: フ、フン、バカに何ができる……！？
#. de: Pah! Was will der denn schon ausrichten?
#. fr: Pfff... C'est pas l'idiot du village qui va m'effrayer<nbsp>!
msgctxt "InstanceContentTextData:44015:0:0"
msgid "What can a fool like you accomplish!?"
msgstr "И что же такой дурак, как ты, может сделать!?"

#. ja: まさか、お前に助けられるとはな……。<br>抜かるなよ、半熟野郎！
#. de: Gut gemacht, Weichei!
#. fr: Sacré détective mi-cuit... Je n'aurais jamais cru dire un ça un jour, mais je vous en dois une<nbsp>!
msgctxt "InstanceContentTextData:44016:0:0"
msgid "Right, well... I'm counting on ya, buddy."
msgstr "Ладно... Я на тебя рассчитываю, дружище."

#. ja: これでも喰らえッ！
#. de: Nehmt das!
#. fr: Prenez donc ça<nbsp>!
msgctxt "InstanceContentTextData:44017:0:0"
msgid "I am your doom!"
msgstr "Я стану твоей погибелью!"

#. ja: わずらわしい奴らめ……<br>ならば、兵器を投入だ！
#. de: Die Toten haben versagt. Aber auf die Technik ist Verlass!
#. fr: Vous êtes plus coriaces que je l'imaginais... C'est le moment de sortir l'artillerie lourde<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44018:0:0"
msgid "You...irritating worms!<br>But I have more than magic at my disposal..."
msgstr "Надоедливые черви!<br>Но в моём распоряжении есть не только магия..."

#. ja: どうした、カーネリアン。<br>だいぶ焦ってるようだが……？
#. de: Was ist los, Carnelian? Hat es dir die Sprache verschlagen?
#. fr: Eh bien, Carnelian<nbsp>? Qu'est-ce qu'il t'arrive<nbsp>? T'as des sueurs froides<nbsp>?
msgctxt "InstanceContentTextData:44019:0:0"
msgid "Something wrong, Crime King? Think your crown is starting to slip..."
msgstr "Что такое, король преступного мира? Корона уже съезжает?"

#. ja: 魔力の奔流に呑まれるがいい！
#. de: Erlebt die Macht des Lich!
#. fr: Le torrent implacable de ma magie vous engloutira<nbsp>!
msgctxt "InstanceContentTextData:44020:0:0"
msgid "Kneel before my arcane majesty!"
msgstr "Преклонитесь перед моим магическим величием!"

#. ja: ええい、こうなったら……<br>出し惜しみはせず投入だ！
#. de: Jetzt werde ich nichts mehr zurückhalten!
#. fr: Grrrrr... Puisque c'est comme ça, je vais déployer le gros de mes forces<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44021:0:0"
msgid "If that's how it must be...<br>I will hold back NOTHING!"
msgstr "Раз так...<br>Больше я сдерживаться НЕ БУДУ!"

#. ja: おやおや、みなさんお揃いで……<br>ここは、アレの出番ですな。
#. de: Ach, was für ein bezauberndes Ensemble!
#. fr: Ça en fait du monde<nbsp>! Il faut que je mette les petits plats dans les grands<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44022:0:0"
msgid "So many murder machines, all in a row.<br>But we have just the answer to that..."
msgstr "Сколько машин для убийства, и все в ряд.<br>Но у нас найдётся на них управа..."

#. ja: ハルディボイルド殿、参りますぞ！<br>エレクトリィィィック、チャァァァージ！
#. de: Aufgepasst, Herr Kollege!<br>Manderviiille-Blitzladuuung!
#. fr: Préparez-vous, Monsieur Hildibrut<nbsp>! Chaaarge électriiique<nbsp>!
msgctxt "InstanceContentTextData:44023:0:0"
msgid "Detective! Remember my electrifying handstand?"
msgstr "Детектив! Помните мою умопомрачительную стойку на руках?"

#. ja: でかしたぞ、半熟野郎！<br>お前のエーテル、使わせてもらおう！
#. de: Danke, Weichei. Damit kann ich etwas anfangen.
#. fr: On peut dire que t'as de la ressource<nbsp>! C'est tout l'éther dont j'avais besoin<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44024:0:0"
msgid "Now that's a swell idea!<br>Keep it comin'!"
msgstr "Вот это идея!<br>Давай ещё!"

#. ja: ク、クソッ……！<br>ありったけ投入してやる！
#. de: Verdammt! Jetzt gebe ich wirklich alles!
#. fr: Im-impossible...<nbsp>! Je dois envoyer tout ce qu'il me reste<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44025:0:0"
msgid "C-Curse you!<br>More. I must have more!"
msgstr "П-проклятый!<br>Мне нужно больше. Ещё больше!"

#. ja: おいおい、さっきまでの余裕はどうした？<br>軽口も出てないぞ？
#. de: Moment, hast du das nicht gerade schon gesagt?
#. fr: Tu es bien silencieux tout à coup. Tu ne devais pas me faire manger les pissenlits par la racine<nbsp>?
msgctxt "InstanceContentTextData:44026:0:0"
msgid "What, no more wisecracks? Someone's feeling the pinch."
msgstr "Что, шутки кончились? Видать, тебе уже не до смеха."

#. ja: これだけの兵器をすべて破壊しただと！？<br>それにしても、あのバカは何者なんだ……！？
#. de: Auch die Technik versagt? Was ist das für ein Teufelskerl?
#. fr: Toutes mes armes ont été détruites<nbsp>! Je n'aurais pas dû sous-estimer cet imbécile...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:44027:0:0"
msgid "My entire stock of armaments...destroyed.<br>Who <i>is</i> that foppish imbecile!?"
msgstr "Весь мой арсенал... уничтожен.<br>Да кто <i>он</i> такой, этот щеголеватый идиот!?"

#. ja: このままでは、埒が明かん！<br>あのバカから片付けてやる……！
#. de: So geht das nicht weiter. Ich muss ihn aus dem Weg räumen!
#. fr: Il faut que je me débarrasse de lui sur-le-champ<nbsp>!
msgctxt "InstanceContentTextData:44028:0:0"
msgid "I will not allow him to ruin my moment of triumph!"
msgstr "Не позволю ему испортить мой триумф!"

#. ja: 死ねぇーーー！
#. de: Stirb!
#. fr: Crève<nbsp>!!!
msgctxt "InstanceContentTextData:44029:0:0"
msgid "DIE!!!"
msgstr "СДОХНИ!!!"

#. ja: そ、そんなバカなッ！<br>この技を、耐えたというのか……ッ！？
#. de: Wie kann er das nur überleben?
#. fr: Je rêve... Il est encore debout après cette technique<nbsp>!?
msgctxt "InstanceContentTextData:44030:0:0"
msgid "Inconceivable! No mortal can withstand such power!"
msgstr "Невозможно! Как смертный мог выдержать такую силу!?"

#. ja: フッ、タフな奴だぜ。<br>いいぞ、そのエーテルがあれば……
#. de: Ganz schön hartgesotten, der Mann, was? Und blitzgescheit ist er auch.
#. fr: Toi aussi, t'as la coquille dure... Compte sur moi pour faire bon usage de tout cet éther<nbsp>!
msgctxt "InstanceContentTextData:44031:0:0"
msgid "Heh, he's one tough egg. And I reckon we could use that aether..."
msgstr "Хех, крепкий орешек. А его эфира нам, пожалуй, хватит..."

#. ja: 半熟野郎！<br>ありったけのエーテルを俺に貸してくれ！
#. de: Weichei! Schick mir mal was von deiner Blitzenergie!
#. fr: C'est le moment d'envoyer toute la sauce, détective mi-cuit<nbsp>!
msgctxt "InstanceContentTextData:44032:0:0"
msgid "Hildibrand! Gimme all the juice you got!"
msgstr "Хильдибранд! Гони сюда весь эфир, какой есть!"

#. ja: あのバカ、まともに喰らったはず……<br>なぜ平気なんだ？
#. de: Warum steht er noch? Das hätte längst reichen sollen.
#. fr: Je n'arrive pas à y croire... Il a encaissé tout ça sans broncher<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44033:0:0"
msgid "It hit that dolt full in the face...<br>How is he still standing?"
msgstr "Этот недотёпа получил удар прямо в лицо...<br>Как он ещё стоит на ногах?"

#. ja: あのバカ、いったい何をしている……？
#. de: Was soll das? Was macht er da?
#. fr: Qu'est-ce qu'il fait ce benêt<nbsp>!?
msgctxt "InstanceContentTextData:44034:0:0"
msgid "What new idiocy is this..."
msgstr "И что этот болван опять вытворяет..."

#. ja: なんと、私のファンがこんなにも……？
#. de: Ich bin ganz schön gefragt, wie es scheint.
#. fr: Je ne pensais pas avoir autant d'admirateurs<nbsp>!
msgctxt "InstanceContentTextData:44035:0:0"
msgid "What have we here? An army of admirers...?"
msgstr "Что тут у нас? Целая армия поклонников...?"

#. ja: 調子に乗っていられるのもいまのうちだ……！
#. de: Wenn es jetzt nicht klappt ...
#. fr: Préparez-vous à déchanter...<nbsp>!
msgctxt "InstanceContentTextData:44036:0:0"
msgid "Make your clever quips while you can..."
msgstr "Пока можешь острить..."

#. ja: その程度で俺を追い詰められるとでも？
#. de: Ist das jetzt wirklich dein Bestes?
#. fr: Tu pensais vraiment que ça suffirait à nous arrêter<nbsp>?
msgctxt "InstanceContentTextData:44037:0:0"
msgid "Think that's all it takes to break us?"
msgstr "Думаешь, нас так просто сломать?"

#. ja: これならどうだ……！
#. de: Nimm das!
#. fr: Que dites-vous de ça<nbsp>!?
msgctxt "InstanceContentTextData:44038:0:0"
msgid "Then how about...this!"
msgstr "А ну-ка попробуй вот это!"

#. ja: 何度やっても無駄だ。<br>この俺、タフガイは倒せないぜ。
#. de: Versuch es, so oft du willst. Aber mich haust du nicht in die Pfanne!
#. fr: Je suis un dur à cuire. Il en faut plus que ça pour fissurer ma coquille.
msgctxt "InstanceContentTextData:44039:0:0"
msgid "Wasting your time. My shell's too hard for you to crack."
msgstr "Зря стараешься. Мою скорлупу тебе не расколоть."

#. ja: 捕らえた……もう逃げられまい！
#. de: Jetzt hab ich dich!
#. fr: Je vous tiens... Préparez-vous à souffrir<nbsp>!
msgctxt "InstanceContentTextData:44040:0:0"
msgid "Hah! I have you now!"
msgstr "Ха! Попался!"

#. ja: そんなもんでタフガイを封じれると思ったか？<br>笑わせるなよ。
#. de: Dachtest du, damit kannst du ein hartes Ei wie mich fangen? Lächerlich.
#. fr: Ces tours de passe-passe ne suffisent pas à immobiliser un dur de dur comme moi<nbsp>!
msgctxt "InstanceContentTextData:44041:0:0"
msgid "Can't keep a good guy down. Try again, bozo."
msgstr "Хорошего парня так просто не одолеть. Попробуй ещё раз, болван."

#. ja: ク、クソォォォォォ！
#. de: Neeeiiinnn!
#. fr: Bordel<nbsp>! Pince-moi, je rêve<nbsp>!
msgctxt "InstanceContentTextData:44042:0:0"
msgid "D-Damn you!"
msgstr "П-проклятый!"

#. ja: 逃げられると思うな！
#. de: So leicht entkommt mir niemand!
#. fr: Vous n'échapperez pas à cette décrépitude<nbsp>!
msgctxt "InstanceContentTextData:44043:0:0"
msgid "There is no escaping from this one!"
msgstr "От меня не уйдёшь!"

#. ja: むむっ、芳しい香りが…
#. de: Was für ein mondäner Gestank!
#. fr: Ce parfum suave me chatouille les narines...
msgctxt "InstanceContentTextData:44044:0:0"
msgid "My, what a robust fragrance..."
msgstr "Ох, какой терпкий аромат..."

#. ja: アアーーーーッ！
#. de: Aaaah!
#. fr: Youpi<nbsp>!
msgctxt "InstanceContentTextData:44045:0:0"
msgid "AaAaAagh!"
msgstr "А-а-а-а-а-ах!"

#. ja: 飛ぶのは得意ですぞ！
#. de: Man nennt mich nicht umsonst den Spatz von Thanalan!
#. fr: J'adore les trampolines<nbsp>!
msgctxt "InstanceContentTextData:44046:0:0"
msgid "Graceful even in flight!"
msgstr "В полёте мне нет равных!"

#. ja: 死者たちよ、再び立ち上がれ！
#. de: Erhebt euch aufs Neue, meine toten Diener!
#. fr: Relevez-vous, cadavres pourrissants<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44047:0:0"
msgid "Rise again, my thralls!<br>I command you!"
msgstr "Встаньте вновь, мои рабы!<br>Приказываю!"

#. ja: ついに、統一王者「ザ・タイラント」との決戦です！
#. de: Der Tyrann ist bereit, seinen Titel zu verteidigen!
#. fr: Enfin nous y sommes, le match pour le titre d'ultime champion<nbsp>!
msgctxt "InstanceContentTextData:44100:0:0"
msgid "At long last, the decisive match against the grand champion!"
msgstr "Наконец-то решающий бой с абсолютным чемпионом!"

#. ja: はたして挑戦者は、<br>至天の座を勝ち取ることができるかァ！？
#. de: Werden die Herausforderer den Thron des Arkadions besteigen?
#. fr: Le challenger saura-t-il détrôner son formidable adversaire<nbsp>?
msgctxt "InstanceContentTextData:44101:0:0"
msgid "Will the challenger triumph and seize the Tyrant's throne?"
msgstr "Сумеет ли претендент победить и занять трон Тирана?"

#. ja: まずは小手調べといこう。
#. de: Seid unbesorgt, wir fangen simpel an.
#. fr: Commençons par un petit échauf<shy>fe<shy>ment<nbsp>!
msgctxt "InstanceContentTextData:44102:0:0"
msgid "First, I shall take your measure."
msgstr "Для начала проверю, на что ты способен."

#. ja: 我が武技、見切ってみろ。
#. de: Stellt euch meiner Waffenkunst.
#. fr: Essaie donc d'éviter mes coups<nbsp>!
msgctxt "InstanceContentTextData:44103:0:0"
msgid "Show me your footwork."
msgstr "Ну-ка, покажи свою ловкость."

#. ja: さすがは、ザ・タイラント！<br>アルカディアの圧政者の称号は伊達じゃない！
#. de: Ganz wie erwartet! Der Herrscher des Arkadions macht seinem Namen alle Ehre!
#. fr: Époustouflant<nbsp>! The Tyrant nous prouve qu'il n'a pas volé son titre<nbsp>!
msgctxt "InstanceContentTextData:44104:0:0"
msgid "It's Tyranny Time, folks! He knows no mercy, and he's never tasted defeat!"
msgstr "Пора тирании, друзья! Пощады он не знает и поражений не терпел!"

#. ja: さて、これはどうだ？
#. de: Habt ihr hierauf eine Antwort?
#. fr: Alors, que dis-tu de ça<nbsp>?
msgctxt "InstanceContentTextData:44105:0:0"
msgid "How about this?"
msgstr "Ну как тебе это?"

#. ja: 挑戦者も引けを取らない！
#. de: Die Herausforderer schlagen sich wacker!
#. fr: Le challenger tient bon malgré tout<nbsp>!
msgctxt "InstanceContentTextData:44106:0:0"
msgid "The challenger's holding their own!"
msgstr "Претендент держится на равных!"

#. ja: 武技の神髄というものを見せてやろう！
#. de: Meiner Kampfkunst sind keine Grenzen gesetzt!
#. fr: Laisse-moi te montrer à quoi ressemble un véritable maître du combat<nbsp>!
msgctxt "InstanceContentTextData:44107:0:0"
msgid "Behold the essence of martial mastery!"
msgstr "Узри истинное мастерство боя!"

#. ja: これは……！？<br>複数の武器が作られていくぞォ～！
#. de: Oh, er hat gleich mehrere Waffen auf einmal erzeugt!
#. fr: Mais qu'est-ce que...<nbsp>!? De nouvelles armes viennent d'apparaître<nbsp>!
msgctxt "InstanceContentTextData:44108:0:0"
msgid "I beg your pardon? What is he going to do with all those weapons?"
msgstr "Прошу прощения? И что же он будет делать со всем этим оружием?"

#. ja: 強烈な攻撃！<br>これが王者たる力なのかッ！！
#. de: Ein wuchtiger Angriff! Die Kraft eines wahren Großmeisters!
#. fr: Oooh<nbsp>! La tyrannie du champion n'a pas de limite<nbsp>!
msgctxt "InstanceContentTextData:44109:0:0"
msgid "Absolute brutality! The champion's power is unmatched!"
msgstr "Какая жестокая сила! Чемпиону нет равных!"

#. ja: まだまだいくぞっ！！
#. de: Wir sind noch lange nicht am Ende!
#. fr: Je n'en ai pas fini avec toi<nbsp>!
msgctxt "InstanceContentTextData:44110:0:0"
msgid "There is much more to come!"
msgstr "Это ещё не всё!"

#. ja: ふんッ！<br>久々に楽しませてくれるッ……！
#. de: Hmpf! Amüsieren könnt ihr mich wohl<nbsp>...
#. fr: Hmpf<nbsp>! Enfin quelqu'un qui a du répondant<nbsp>!
msgctxt "InstanceContentTextData:44111:0:0"
msgid "It has been a long time since I've enjoyed myself so!"
msgstr "Давно я так не веселился!"

#. ja: ここからは手加減抜きだ……
#. de: Genug aufgewärmt. Lasst uns ernst machen!
#. fr: Fini de jouer à présent<nbsp>!
msgctxt "InstanceContentTextData:44112:0:0"
msgid "No more holding back."
msgstr "Хватит сдерживаться."

#. ja: いくぞッ！　生身の挑戦者ァァ！！
#. de: Zeigt mir eure wahre Stärke, Herausforderer!
#. fr: Prépare-toi à souffrir, challenger sans régulateur<nbsp>!
msgctxt "InstanceContentTextData:44113:0:0"
msgid "Prepare yourself, unenhanced warrior!"
msgstr "Приготовься, воин без усилений!"

#. ja: す、凄まじい猛攻！<br>恐るべし統一王者ッ！！
#. de: Was für eine Stärke! Den Tyrannen hält nichts zurück!
#. fr: Q-quelle férocité<nbsp>! The Tyrant n'a pas de pitié pour son adversaire<nbsp>!
msgctxt "InstanceContentTextData:44114:0:0"
msgid "Such ferocity! The champion is ruthless indeed!"
msgstr "Вот это ярость! Чемпион и вправду не знает пощады!"

#. ja: 私は絶対王者だッ！<br>負けることなど、あるものかァァ！！
#. de: Ich bin der Großmeister des Arkadions! Eine Niederlage kommt nicht in Frage!
#. fr: Je suis le Champion céleste, le combattant ultime<nbsp>! Jamais je ne m'avouerai vaincu<nbsp>!
msgctxt "InstanceContentTextData:44115:0:0"
msgid "My reign is absolute! I will not lose!"
msgstr "Моя власть абсолютна! Я не проиграю!"

#. ja: うおおおおぉぉぉぉ！！！
#. de: Nhoooooaaaahh!!!
#. fr: Rhoooaaaaaah<nbsp>!
msgctxt "InstanceContentTextData:44116:0:0"
msgid "Rrraaah!"
msgstr "Р-р-р-ра-а-а!"

#. ja: こ、これは、いったい！？<br>統一王者の様子が変わったようだァ……！
#. de: Was geschieht da? Unser Großmeister verhält sich eigenartig<nbsp>...!
#. fr: Dites-moi que je rêve<nbsp>! Le champion vient d'altérer son apparence<nbsp>!
msgctxt "InstanceContentTextData:44117:0:0"
msgid "The Tyrant's altered his form! He looks even more tyrannical than before!"
msgstr "Тиран изменил облик! Теперь он выглядит ещё тираничнее!"

#. ja: 魔物の力に、生身で挑む愚かさ……<br>その身をもって知るがいい！
#. de: Ich werde euch lehren, wie töricht es war, diesen Ring ohne Verstärkung zu betreten!
#. fr: Tu vas découvrir à quel point il est stupide de se confronter à une âme de monstre<nbsp>!
msgctxt "InstanceContentTextData:44118:0:0"
msgid "Know the folly of challenging me unenhanced!"
msgstr "Узнай, как глупо было бросать мне вызов без усилений!"

#. ja: 吹っ飛べ、挑戦者ァ！！
#. de: Hinweg mit euch!
#. fr: Tu vas voler hors du ring<nbsp>!
msgctxt "InstanceContentTextData:44119:0:0"
msgid "Now fall!"
msgstr "А теперь пади!"

#. ja: 圧倒的な威力……！<br>魔獣ベヒーモスの力を解放したようです！！
#. de: Diese enorme Kraft! Er hat die Macht des Behemoth freigesetzt!
#. fr: Quelle dé<shy>mon<shy>stra<shy>tion de force ahurissante<nbsp>! The Tyrant déchaîne la puissance du béhémoth<nbsp>!
msgctxt "InstanceContentTextData:44120:0:0"
msgid "What a display of power! He's unleashed the full might of the behemoth!"
msgstr "Вот это мощь! Он высвободил всю силу бегемота!"

#. ja: 至天の座を譲るものかッ！
#. de: Der Thron des Arkadions ist mein!
#. fr: Jamais je ne céderai mon trône<nbsp>!
msgctxt "InstanceContentTextData:44121:0:0"
msgid "I will not yield my throne!"
msgstr "Я не уступлю свой трон!"

#. ja: リングが真っ二つだァ～！<br>急ぎ修復の準備に取りかかります！
#. de: Der Ring bricht entzwei! Wir setzen uns sofort an die Reparatur!
#. fr: Le ring a été fracturé en deux<nbsp>! Nous allons nous dépêcher de le réparer<nbsp>!
msgctxt "InstanceContentTextData:44122:0:0"
msgid "Oh, he's split the ring in half! We're going to need urgent repairs!"
msgstr "Ого, он расколол ринг пополам! Срочно нужно всё починить!"

#. ja: 喰らうがいい！
#. de: Spürt meine Macht!
#. fr: Encaisse donc ça, si tu en es capable<nbsp>!
msgctxt "InstanceContentTextData:44123:0:0"
msgid "Try this!"
msgstr "А ну-ка, попробуй это!"

#. ja: リングを投げ飛ばした！<br>な、なんという力なんだァ～！！
#. de: Er hat den Ring selbst geschleudert! Diese Kraft ist unglaublich!
#. fr: The Tyrant utilise sa force monstrueuse pour lancer la moitié du ring sur le challenger<nbsp>!
msgctxt "InstanceContentTextData:44124:0:0"
msgid "And now he's thrown the ring! What absurd strength!"
msgstr "Он швырнул ринг! Какая невероятная сила!"

#. ja: 準備が整ったようなので、リングを修復します。
#. de: Ich habe gerade gehört, dass der Ring jetzt repariert wird.
#. fr: Merci de votre patience, le ring est désormais tout beau tout neuf<nbsp>!
msgctxt "InstanceContentTextData:44125:0:0"
msgid "Ahem, the ring shall presently be restored."
msgstr "Кхм, ринг сейчас восстановят."

#. ja: この魔物の力あってこそ、アルカディアなのだッ！
#. de: Ohne Bestienseelen<nbsp>... gibt es kein Arkadion!
#. fr: Des âmes de monstre qui se déchaînent... C'est ça, l'Arcadion<nbsp>!
msgctxt "InstanceContentTextData:44126:0:0"
msgid "The power of feral souls makes the Arcadion what it is!"
msgstr "Сила диких душ — вот что делает Аркадион Аркадионом!"

#. ja: 魔物の意地と、生身の覚悟のぶつかり合い！<br>どちらが勝ってもおかしくありません！
#. de: Der unbarmherzige Wille der Bestie prallt auf eiserne Standhaftigkeit!
#. fr: La force brute d'un monstre face à la détermination du challenger... Qui l'emportera<nbsp>?
msgctxt "InstanceContentTextData:44127:0:0"
msgid "'Tis a clash between feral pride and mortal resolve! Either side could come out on top!"
msgstr "Дикая гордость противника против человеческой стойкости! Победить может любой!"

#. ja: はぁ……はぁ……！
#. de: Haa<nbsp>... haa<nbsp>...!
#. fr: (Halète)
msgctxt "InstanceContentTextData:44128:0:0"
msgid "Haaah...haaah..."
msgstr "Ха-а... ха-а..."

#. ja: アルカディアを、なめるなァァァ！
#. de: Das Arkadion<nbsp>... braucht euch nicht!
#. fr: Tu insultes l'Arcadion, pauvre vermine<nbsp>!
msgctxt "InstanceContentTextData:44129:0:0"
msgid "Do not underestimate the Arcadion!"
msgstr "Не смей недооценивать Аркадион!"

#. ja: ザ・タイラントの撃破
#. de: Den Tyrannen besiegen
#. fr: Vaincre The Tyrant
msgctxt "InstanceContentTextData:44130:0:0"
msgid "Defeat the Tyrant"
msgstr "Одолейте Тирана"

#. ja: エクストリームズの撃破
#. de: Team Extrem besiegen
#. fr: Vaincre les Xtrêmes
msgctxt "InstanceContentTextData:44200:0:0"
msgid "Defeat the Xtremes"
msgstr "Одолейте Экстремалов"

#. ja: 「エクストリームズ」とのタッグマッチです！<br>兄弟の交代にも注目！
#. de: Auf in einen Teamkampf der Superlative! Oder vielmehr<nbsp>... der Extreme?
#. fr: Ce combat en équipe s'annonce extrême<nbsp>!
msgctxt "InstanceContentTextData:44201:0:0"
msgid "This will be a tag team match of extreme proportions!"
msgstr "Это будет командный бой небывалого размаха!"

#. ja: オレひとりで、十分……。
#. de: Euch schaff ich auch allein.
#. fr: Je m'occuperai de toi tout seul...
msgctxt "InstanceContentTextData:44202:0:0"
msgid "I can handle you alone."
msgstr "Я и один с тобой справлюсь."

#. ja: レッドホットは強気だ！<br>挑戦者、ナメられているぞォ～！
#. de: Scharlachflamme nimmt die Herausforderer kein bisschen ernst!
#. fr: Red Hot provoque son adversaire<nbsp>!
msgctxt "InstanceContentTextData:44203:0:0"
msgid "My word, such scorn for the challenger!"
msgstr "Вот это презрение к претенденту!"

#. ja: オレのライディング、すべて燃やす……。
#. de: Meine Flammen verbrennen alles.
#. fr: Mes flammes détruisent tout sur leur passage<nbsp>!
msgctxt "InstanceContentTextData:44204:0:0"
msgid "I ride the inferno."
msgstr "Я оседлаю пламя ада."

#. ja: なんと凄まじい炎！<br>リングが燃えあがったァ～！
#. de: Was für enorme Flammen! Der Ring hat Feuer gefangen!
#. fr: Quelles terribles flammes<nbsp>! Le ring est en feu<nbsp>!
msgctxt "InstanceContentTextData:44205:0:0"
msgid "What fearsome flames! He's set the ring ablaze!"
msgstr "Какие страшные языки пламени! Он поджёг ринг!"

#. ja: どんどん燃え広がり、<br>挑戦者は追い詰められていくッ……！
#. de: Das Feuer schneidet den Herausforderern den Weg ab<nbsp>...!
#. fr: Le feu s'étend dans l'arène<nbsp>! Le challenger n'aura bientôt plus d'endroit où s'abriter<nbsp>!
msgctxt "InstanceContentTextData:44206:0:0"
msgid "The flames are spreading! At this rate, the challenger will be trapped!"
msgstr "Огонь всё разгорается! Скоро претенденту будет некуда бежать!"

#. ja: 吹っ飛ばす……！
#. de: Weg mit euch<nbsp>...!
#. fr: Je vais t'exploser<nbsp>!
msgctxt "InstanceContentTextData:44207:0:0"
msgid "I'll wipe you out."
msgstr "Я тебя сотру в порошок."

#. ja: お～い、オレにも楽しませてくれよォ！
#. de: He, lass mir auch noch was übrig!
#. fr: Hé oh<nbsp>! Laisse-moi m'amuser aussi un peu<nbsp>!
msgctxt "InstanceContentTextData:44208:0:0"
msgid "Hey, save some fun for me!"
msgstr "Эй, и мне оставь хоть немного веселья!"

#. ja: ディープブルーが痺れを切らした！<br>ここで交代です！
#. de: Indigowelle kann nicht mehr stillsitzen! Und abgeklatscht!
#. fr: Deep Blue n'en peut plus d'attendre<nbsp>! Red Hot passe la main à son frère<nbsp>!
msgctxt "InstanceContentTextData:44209:0:0"
msgid "Deep Blue's lost his cool! He's tagging in!"
msgstr "У Дип Блю лопнуло терпение! Он выходит на замену!"

#. ja: いい波が来ねェなら……自分で作りゃいい！
#. de: Die besten Wellen mach ich mir immer selbst!
#. fr: Si aucune vague ne se pointe... autant l'invoquer moi-même<nbsp>!
msgctxt "InstanceContentTextData:44210:0:0"
msgid "If there ain't a wave to ride, just make one yourself!"
msgstr "Нет волны — создай её сам!"

#. ja: なんてことだ！<br>見上げるほど巨大な波が出現したァ～！
#. de: Ach du meine Güte! Was für eine gewaltige Welle!
#. fr: Incroyable<nbsp>! Une énorme vague vient d'apparaître<nbsp>!
msgctxt "InstanceContentTextData:44211:0:0"
msgid "Good gods, what an enormous wave!"
msgstr "Боги всемогущие, вот это волна!"

#. ja: 変幻自在のトリックについてこれるかァ！？
#. de: Bei dem Trick werden euch die Augen rausfallen!
#. fr: Tu penses pouvoir déjouer mes tours<nbsp>?
msgctxt "InstanceContentTextData:44212:0:0"
msgid "Bet you've never seen anything this gnarly!"
msgstr "Такого трюка ты ещё не видел!"

#. ja: あ～、かったりィ！<br>ふたりで片付けちまおうぜ！
#. de: Mann, ich hab keinen Bock mehr. Komm, wir machen sie zusammen fertig!
#. fr: Bwaaah... Qu'est-ce qu'on s'ennuie<nbsp>! Réglons-lui son compte à deux<nbsp>!
msgctxt "InstanceContentTextData:44213:0:0"
msgid "Ugh, what a drag! Let's do this together, bro!"
msgstr "Уф, как скучно! Давай разберёмся с ним вместе, брат!"

#. ja: お～っと、兄弟そろってリングイン！<br>これはルール違反、反則だァ～！
#. de: Moment, die Brüder betreten gemeinsam den Ring! Ein klarer Regelverstoß!
#. fr: Ouh là là là là<nbsp>! Les deux frères montent ensemble sur le ring<nbsp>! Mais que fait l'arbitre<nbsp>!?
msgctxt "InstanceContentTextData:44214:0:0"
msgid "Both brothers have entered the ring! That's grounds for disqualification!"
msgstr "Оба брата в ринге! Это же повод для дисквалификации!"

#. ja: ヘッ、相手が複数なら、これでフェアだろ！？
#. de: Ha, die kämpfen doch auch nicht allein! Jetzt ist's gerecht!
#. fr: Ils sont plusieurs contre nous, alors c'est équitable<nbsp>!
msgctxt "InstanceContentTextData:44215:0:0"
msgid "They don't fight alone either, so it's only fair!"
msgstr "Они тоже дерутся не в одиночку, так что всё честно!"

#. ja: オレと兄者、ふたりでひとつ！
#. de: Zwei Körper, eine Seele!
#. fr: Moi et mon frère, on est unis comme les deux doigts de la main<nbsp>!
msgctxt "InstanceContentTextData:44216:0:0"
msgid "The Xtremes fight as one!"
msgstr "Экстремалы сражаются как единое целое!"

#. ja: オラアアアァァァッ！
#. de: Uraaaaaaah!
#. fr: Rhaaaaaah<nbsp>!
msgctxt "InstanceContentTextData:44217:0:0"
msgid "Hrrraah!"
msgstr "Хр-р-ра-а-а!"

#. ja: ウゥオオオォォォッ！
#. de: Uoooraaah!
#. fr: Uuuoaaaah<nbsp>!
msgctxt "InstanceContentTextData:44218:0:0"
msgid "Rrruaaah!"
msgstr "Р-р-р-уа-а-а!"

#. ja: え～、レフェリーも止めないので、試合続行です！<br>兄弟相手に挑戦者はどうする～？
#. de: Der Ringrichter schweigt und der Kampf geht weiter! Wie werden sich die Herausforderer schlagen?
#. fr: Oh<nbsp>!? Comme il n'y a pas d'objection, le combat continue<nbsp>! Que va faire notre challenger<nbsp>?
msgctxt "InstanceContentTextData:44219:0:0"
msgid "Er, it seems the referee is allowing it... It's double trouble for the challenger!"
msgstr "Э-э... похоже, судья не против. Претендента ждёт двойная беда!"

#. ja: 本番、これから……！
#. de: Jetzt<nbsp>... machen wir ernst!
#. fr: Le véritable combat commence maintenant<nbsp>!
msgctxt "InstanceContentTextData:44220:0:0"
msgid "We're just getting started!"
msgstr "А мы только начали!"

#. ja: オレたちの連携技、見せてやらァ！
#. de: Mal sehen, wie euch unsere Kombi gefällt!
#. fr: On va te montrer ce que c'est une attaque coordonnée<nbsp>!
msgctxt "InstanceContentTextData:44221:0:0"
msgid "Check out this smooth teamwork! "
msgstr "Полюбуйтесь, как слаженно мы работаем! "

#. ja: 兄弟の力が衝突し、爆発が起こっています！<br>まさに、混ぜるな危険！
#. de: Ihre Attacken haben eine Explosion verursacht! Extremer geht es kaum!
#. fr: Les frangins s'entrechoquent et le résultat est explosif<nbsp>! Mieux vaut les garder séparés<nbsp>!
msgctxt "InstanceContentTextData:44222:0:0"
msgid "The brothers have triggered a fusion explosion! Truly, they're deadly when mixed!"
msgstr "Братья устроили взрыв слияния! Вот уж точно — вместе им опасно!"

#. ja: とっておきのトリックだ！<br>「インセインエアー！」
#. de: Dieser Trick ist der absolute Wahnsinn, da könnt ihr drauf wetten!
#. fr: Admire ma figure préférée<nbsp>!
msgctxt "InstanceContentTextData:44223:0:0"
msgid "I've been saving this trick just for you!"
msgstr "Я приберёг этот трюк специально для вас!"

#. ja: で、で、出たァ～！<br>エクストリームズの究極奥義だァ～！
#. de: Haltet euch fest! Hier kommt der Spezialangriff von Team Extrem!
#. fr: Accrochez-vous à vos sièges<nbsp>! Voici la botte secrète du duo<nbsp>!
msgctxt "InstanceContentTextData:44224:0:0"
msgid "Brace yourselves, folks! The Xtremes are holding nothing back!"
msgstr "Держитесь, народ! Экстримы покажут всё, на что способны!"

#. ja: まだまだ……！
#. de: Wir kämpfen weiter!
#. fr: J'en ai pas fini avec toi<nbsp>!
msgctxt "InstanceContentTextData:44225:0:0"
msgid "I'm not finished with you yet!"
msgstr "Я с тобой ещё не закончил!"

#. ja: 喰らえッ！
#. de: Nehmt das!
#. fr: Prends ça<nbsp>!
msgctxt "InstanceContentTextData:44226:0:0"
msgid "Eat this!"
msgstr "Получай!"

#. ja: 喰らえ！
#. de: Nehmt das!
#. fr: Prends ça<nbsp>!
msgctxt "InstanceContentTextData:44227:0:0"
msgid "Feel the burn!"
msgstr "Почувствуй жар!"

#. ja: オラァ！
#. de: Kommt schon!
#. fr: Gnaaah<nbsp>!
msgctxt "InstanceContentTextData:44228:0:0"
msgid "Rrruah!"
msgstr "Ррр-ха!"

#. ja: くたばりやがれェ！
#. de: Fresst Sand!
#. fr: Tu vas clamser pour de bon<nbsp>!
msgctxt "InstanceContentTextData:44229:0:0"
msgid "You're goin' down!"
msgstr "Тебе конец!"

#. ja: ふん！
#. de: Hmpf!
#. fr: Humpf<nbsp>!
msgctxt "InstanceContentTextData:44230:0:0"
msgid "Hmph!"
msgstr "Хмф!"

#. ja: でぇああああ！
#. de: Nghaaa!
#. fr: Rhoooaaaaaah<nbsp>!
msgctxt "InstanceContentTextData:44231:0:0"
msgid "Yaaagh!"
msgstr "А-а-а-аргх!"

#. ja: お前……大したことない……。
#. de: Nichts als kleine Fische<nbsp>...
#. fr: Tu ne vaux rien<nbsp>!
msgctxt "InstanceContentTextData:44232:0:0"
msgid "You are nothing!"
msgstr "Ты ничтожество!"

#. ja: こんな程度か……<br>あばよ、生身の挑戦者！
#. de: Pah, das war's? Auf Nimmer<shy>wieder<shy>sehen, ihr Luschen!
#. fr: C'est tout ce que tu peux faire<nbsp>? Adieu, challenger sans régulateur<nbsp>!
msgctxt "InstanceContentTextData:44233:0:0"
msgid "That all you got, huh? Nice knowing you, unenhanced warrior!"
msgstr "И это всё, на что ты способен? Прощай, воин без усилений!"

#. ja: <if ($n2 > 0)>★<else>　</if><switch $n1><case><icon 51><case><icon 52><case><icon 53></switch><sheet GrandCompany $n1 0><br>戦略値
#. de: <if ($n2 > 0)>★<else> </if><switch $n1><case><icon 51><case><icon 52><case><icon 53></switch><noun-de GrandCompany 5 $n1 1 1 1><br>Punkte
#. fr: <if ($n2 > 0)>★</if><switch $n1><case><icon 51><case><icon 52><case><icon 53></switch><sheet GrandCompany $n1 0><br>Score tactique
#. macro: <if ($n2 > 0)>★<else>　</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 2 > 0 (condition: may be reworded, restructured, added, or dropped)
#. macro: <switch $n1><case><icon 51><case><icon 52><case><icon 53></switch> — shows the case whose position equals the value: the first <case> for 1, the second for 2, …; value = number parameter 1 (condition: may be reworded, restructured, added, or dropped)
#. macro: <icon 51> — an inline icon of the game font; icon = 51 (game data: keep it; it may move or repeat)
#. macro: <icon 52> — an inline icon of the game font; icon = 52 (game data: keep it; it may move or repeat)
#. macro: <icon 53> — an inline icon of the game font; icon = 53 (game data: keep it; it may move or repeat)
#. macro: <sheet GrandCompany $n1 0> — a value from a game data sheet, such as a name; sheet = GrandCompany, row = number parameter 1, column = 0 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:44300:0:0"
msgid "<if ($n2 > 0)>★<else>　</if><switch $n1><case><icon 51><case><icon 52><case><icon 53></switch>The <sheet GrandCompany $n1 0><br>Tactical Rating"
msgstr "<if ($n2 > 0)>★<else>　</if><switch $n1><case><icon 51><case><icon 52><case><icon 53></switch><sheet GrandCompany $n1 0><br>Тактический рейтинг"

#. ja: 他勢力を排除し、戦略目標地を制圧せよ！
#. de: Schalte gegnerische Kämpfer aus und erobere Triumphpunkte!
#. fr: Repoussez les forces ennemies et prenez le contrôle des points névralgiques<nbsp>!
msgctxt "InstanceContentTextData:44301:0:0"
msgid "Eliminate the opposition and claim triumphs!"
msgstr "Уничтожьте противников и захватите точки!"

#. ja: <sheet PlaceName $n1 0><br><switch $n2><case>ランクB<case>ランクA<case>ランクS</switch><br><switch $n3><case>制圧可能まで：<num $n4>:<num2 $n5><case>制圧可能状態<case>黒渦団 制圧状態<case>双蛇党 制圧状態<case>不滅隊 制圧状態</switch>
#. de: <sheet PlaceName $n1 0><br><switch $n2><case>Rang B<case>Rang A<case>Rang S</switch><br><switch $n3><case>Aktivierung in: <num $n4>:<num2 $n5><case>Besetzbar<case>Besetzt von <icon 51><case>Besetzt von <icon 52><case>Besetzt von <icon 53></switch>
#. fr: <sheet PlaceName $n1 0><br><switch $n2><case>Rang B<case>Rang A<case>Rang S</switch><br><switch $n3><case>Temps restant avant contrôle possible<nbsp>: <num $n4>:<num2 $n5><case>Contrôle possible<case>Contrôlé par <icon 51><case>Contrôlé par <icon 52><case>Contrôlé par <icon 53></switch>
