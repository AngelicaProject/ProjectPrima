# InstanceContentTextData
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 問おう……<br>汝ら、魔獣使いの力を！
#. de: Beweise mir deine Stärke mit der Wahrheit.
#. fr: Prouve ta valeur... Démontre tes compétences de <if $gn4>dresseuse<else>dresseur</if><nbsp>!
msgctxt "InstanceContentTextData:45100:0:0"
msgid "Prove your strength with answers true."
msgstr "Докажите свою силу верными ответами."

#. ja: 問おう……<br>汝らの「数」の知識を。
#. de: Wie steht es um dein Wissen von Zahlen?
#. fr: Prouve ta valeur... Démontre ta con<shy>nais<shy>san<shy>ce des nombres<nbsp>!
msgctxt "InstanceContentTextData:45101:0:0"
msgid "What knowledge have you of numbers?"
msgstr "Что вы знаете о числах?"

#. ja: 問おう……<br>汝らの「記憶」の力を。
#. de: Wie gut ist dein Gedächtnis?
#. fr: Prouve ta valeur... Démontre ta capacité de mémorisation<nbsp>!
msgctxt "InstanceContentTextData:45102:0:0"
msgid "How mighty is your memory?"
msgstr "Насколько крепка ваша память?"

#. ja: 問おう……<br>「有翼綱」の魔物はいずれなりや？
#. de: Sag mir: Wer ist ein Kind der Wölklinge?
#. fr: Réponds à ma question... Laquelle de ces bêtes est ptérienne<nbsp>?
msgctxt "InstanceContentTextData:45103:0:0"
msgid "Riddle me this─which child is kin of cloud?"
msgstr "Отгадайте: кто из этих созданий — дитя облаков?"

#. ja: 問おう……<br>「甲鱗綱」の魔物はいずれなりや？
#. de: Sag mir: Wer ist ein Kind der Schupplinge?
#. fr: Réponds à ma question... Laquelle de ces bêtes est cuirassienne<nbsp>?
msgctxt "InstanceContentTextData:45104:0:0"
msgid "Riddle me this─which child is kin of scale?"
msgstr "Отгадайте: кто из этих созданий — дитя чешуи?"

#. ja: 問おう……<br>「百獣綱」の魔物はいずれなりや？
#. de: Sag mir: Wer ist ein Kind der Biestlinge?
#. fr: Réponds à ma question... Laquelle de ces bêtes est thérienne<nbsp>?
msgctxt "InstanceContentTextData:45105:0:0"
msgid "Riddle me this─which child is kin of beast?"
msgstr "Отгадайте: кто из этих созданий — дитя зверя?"

#. ja: 問おう……<br>「水棲綱」の魔物はいずれなりや？
#. de: Sag mir: Wer ist ein Kind der Woglinge?
#. fr: Réponds à ma question... Laquelle de ces bêtes est hydride<nbsp>?
msgctxt "InstanceContentTextData:45106:0:0"
msgid "Riddle me this─which child is kin of wave?"
msgstr "Отгадайте: кто из этих созданий — дитя волн?"

#. ja: 見事なり……<br>正しきには褒賞にて報いよう。
#. de: Vortrefflich. Diese Leistung will gebührend entlohnt werden.
#. fr: Excellente réponse... Voilà qui mérite une récompense.
msgctxt "InstanceContentTextData:45107:0:0"
msgid "Forsooth. Aread me right and fortune yields its blessings."
msgstr "Верно! За правильный ответ полагается награда."

#. ja: 失望なり……<br>過ちには罰にて報いよう。
#. de: Erbärmlich. Dieser Fehler will gebührend bestraft werden.
#. fr: Mauvaise réponse... Voilà qui appelle un châtiment.
msgctxt "InstanceContentTextData:45108:0:0"
msgid "Amiss. Aread me false and punishment awaits."
msgstr "Неверно. За ошибку полагается наказание."

#. ja: 汝らの力は示された……。
#. de: Du hast deine Stärke bewiesen.
#. fr: Tu as prouvé ta valeur...
msgctxt "InstanceContentTextData:45109:0:0"
msgid "Your strength has been proven."
msgstr "Вы доказали свою силу."

#. ja: クポポー！<br>あいつら、やっちまうクポ！
#. de: Kupo! Jetzt gibt's auf die Bommel!
#. fr: Kupopo<nbsp>! Il faut pas me chercher, kupo<nbsp>!
msgctxt "InstanceContentTextData:45110:0:0"
msgid "Time to brawl, kupo! Bring it on!"
msgstr "Пора драться, купо! Ну, кто первый?"

#. ja: 魔法で制圧クポ！<br>ポンポンがうなるクポー！
#. de: Unserer Mogry-Magie bist du nicht gewachsen! Kupokadabra!
#. fr: J'ai le pompon qui crie violence<nbsp>! Tu vas goûter à ma magie, kupo<nbsp>!
msgctxt "InstanceContentTextData:45111:0:0"
msgid "You won't stand a chance against our magicks! Poms away!"
msgstr "Против нашей магии вам не устоять! Помпоны в бой!"

#. ja: オマエラだらしないクポ！<br>数でボコればいいのクポ！
#. de: Reißt euch am Bommel, Leute! Verkupot diesen Kümmerling nach Strich und Faden!
#. fr: Vous faites n'importe quoi<nbsp>! Écrasez-<if $gn4>la<else>le</if> à la force du nombre, kupo<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:45112:0:0"
msgid "Pull yourselves together! Pompile them if you have to, just <i>win</i>, kupo!"
msgstr "Соберитесь! Завалите их помпонами, если придётся, главное — <i>победить</i>, купо!"

#. ja: ヒトと魔獣の絆が力になるとイうならバ……<br>この勝負、勝たせてもらいます！
#. de: Mögen unsere Bande uns Kraft bescheren!
#. fr: Si le lien avec un humain est une source de puissance... hors de question que je perde face à plus faible que moi.
msgctxt "InstanceContentTextData:45113:0:0"
msgid "May our bonded souls prove true. Have at thee!"
msgstr "Пусть наши связанные души докажут, на что способны. Ну, держись!"

#. ja: 魔刃からは逃げられません！
#. de: Meiner Klinge wirst du nicht entkommen!
#. fr: Vous ne pourrez pas esquiver mes lames<nbsp>!
msgctxt "InstanceContentTextData:45114:0:0"
msgid "You shall not escape my blades!"
msgstr "От моих клинков не уйти!"

#. ja: すべては私の意のままに……。<br>あなたも支配されてみませんか？
#. de: Alles gehorcht meinem Willen. Und bald auch du!
#. fr: Tout obéit à ma volonté... Pourquoi pas vous<nbsp>?
msgctxt "InstanceContentTextData:45115:0:0"
msgid "Never have I felt so free... Free to reign supreme!"
msgstr "Я ещё никогда не чувствовала себя такой свободной... Свободной, чтобы править безраздельно!"

#. ja: ルー派の拘束術……逃げても無駄ですよ。
#. de: Den Fesseln der Lhu ... Kann niemand entkommen!
#. fr: Nul n'échappe à la technique d'entrave de l'école de Lhu.
msgctxt "InstanceContentTextData:45116:0:0"
msgid "Mine is a terrible power... Forget not our former shackles."
msgstr "Моя сила ужасна... Не забывай о прежних оковах."

#. ja: ガトラー、魔刃に炎を……！
#. de: Guttler, schenk mir die Kraft des Feuers!
#. fr: Dévoreuse, embrase mes lames<nbsp>!
msgctxt "InstanceContentTextData:45117:0:0"
msgid "Guttler, fire for our steel!"
msgstr "Гаттлер, огнём закали мою сталь!"

#. ja: ラウダよ……我ガ力を存分に使エ！
#. de: Labe dich an meiner Kraft, Lauda. Fälle unsere Feinde!
#. fr: Je t'en prie, Lauda... Déchaîne mon pouvoir<nbsp>!
msgctxt "InstanceContentTextData:45118:0:0"
msgid "Partake of my might, Lauda. Fell our foes!"
msgstr "Питайся моей силой, Лауда. Срази наших врагов!"

#. ja: 我ラの力が及ばヌというか……<br>否、まダ諦めぬゾ相棒よ……！
#. de: Unsere Seelen flackern ... Mögen sie abermals auflodern!
#. fr: Serions-nous battues<nbsp>? Non... Il est trop tôt pour abandonner, partenaire<nbsp>!
msgctxt "InstanceContentTextData:45119:0:0"
msgid "Our spirits flicker... Nay, let them kindle anew!"
msgstr "Наши души угасают... Нет, разгоримся вновь, напарник!"

#. ja: 絆の力で負けたくないから……！<br>私とガトラーの連携技、全力でぶつけてみせます！
#. de: Der Pfad, den Guttler und ich beschreiten ...<br>Er soll hier nicht enden! Erfahre unsere Macht!
#. fr: Notre lien est le plus fort... et nous allons le prouver, en jetant ensemble nos forces dans la bataille<nbsp>!
msgctxt "InstanceContentTextData:45120:0:0"
msgid "The path Guttler and I have chosen... It shall not end here!"
msgstr "Наш путь с Гаттлером... Здесь он не оборвётся!"

#. ja: 姿がなくても、見切れますか？
#. de: Vermagst du, zu sehen, was nicht sichtbar ist?
#. fr: Saurez-vous percevoir l'invisible<nbsp>?
msgctxt "InstanceContentTextData:45121:0:0"
msgid "Can you detect the invisible?"
msgstr "Сумеете заметить невидимое?"

#. ja: 刻限まで、あと5秒なり……。
#. de: Du hast noch fünf Sekunden.
#. fr: Plus que cinq secondes avant le moment fatidique...
msgctxt "InstanceContentTextData:45122:0:0"
msgid "Five seconds remain."
msgstr "Осталось пять секунд."

#. ja: 4……。
#. de: Vier ...
#. fr: Quatre...
msgctxt "InstanceContentTextData:45123:0:0"
msgid "Four..."
msgstr "Четыре..."

#. ja: 3……。
#. de: Drei ...
#. fr: Trois...
msgctxt "InstanceContentTextData:45124:0:0"
msgid "Three..."
msgstr "Три..."

#. ja: 2……。
#. de: Zwei ...
#. fr: Deux...
msgctxt "InstanceContentTextData:45125:0:0"
msgid "Two..."
msgstr "Два..."

#. ja: 1……。
#. de: Eins ...
#. fr: Un...
msgctxt "InstanceContentTextData:45126:0:0"
msgid "One..."
msgstr "Один..."

#. ja: 流石に手ごわいですね……。<br>ですが、ここで引くわけにはいきません！
#. de: Deine Stärke erkenne ich an.<br>Aber ich werde mich nicht vor ihr beugen!
#. fr: Vous avez du répondant... Mais le combat est loin d'être terminé<nbsp>!
msgctxt "InstanceContentTextData:45127:0:0"
msgid "I cannot deny your strength...but neither shall I forfeit!"
msgstr "Не могу не признать вашу силу... Но и сдаваться я не собираюсь!"

#. ja: 問おう……<br>「偶数」の置かれし地はいずれなりや？
#. de: Sag mir: Wo liegen die Geraden?
#. fr: Réponds à ma question... Où se trouvent les nombres pairs<nbsp>?
msgctxt "InstanceContentTextData:45128:0:0"
msgid "Riddle me this─where do evens lie?"
msgstr "Отгадайте: где находятся чётные числа?"

#. ja: 問おう……<br>「奇数」の置かれし地はいずれなりや？
#. de: Sag mir: Wo liegen die Ungeraden?
#. fr: Réponds à ma question... Où se trouvent les nombres impairs<nbsp>?
msgctxt "InstanceContentTextData:45129:0:0"
msgid "Riddle me this─wherein lie the odds?"
msgstr "Отгадайте: где находятся нечётные числа?"

#. ja: 問おう……<br>「3の倍数」の置かれし地はいずれなりや？
#. de: Sag mir: Was lässt sich teilen durch drei?
#. fr: Réponds à ma question... Où se trouvent les multiples de trois<nbsp>?
msgctxt "InstanceContentTextData:45130:0:0"
msgid "Riddle me this─what can threes divide?"
msgstr "Отгадайте: что делится на три?"

#. ja: 問おう……<br>「素数」の置かれし地はいずれなりや？
#. de: Sag mir: Was ist nur mit sich selbst im Reinen?
#. fr: Réponds à ma question... Où se trouvent les nombres premiers<nbsp>?
msgctxt "InstanceContentTextData:45131:0:0"
msgid "Riddle me this─which numbers are in prime?"
msgstr "Отгадайте: какие числа простые?"

#. ja: いざ選択せよ……汝が回答を。
#. de: Triff deine Wahl.
#. fr: Choisis ta réponse, et choisis bien.
msgctxt "InstanceContentTextData:45132:0:0"
msgid "Make your choice. Care not to err."
msgstr "Выбирайте ответ. Не ошибитесь."

#. ja: この魔物は、いったい……！？
#. de: Was sind das für Kreaturen?!
#. fr: Que sont ces créatures<nbsp>?
msgctxt "InstanceContentTextData:45200:0:0"
msgid "What are these creatures...?"
msgstr "Что это за создания?.."

#. ja: 単なる野生生物ではなさそうだ。<br>注意してくれ……！
#. de: Wilde Tiere können das ja kaum sein<nbsp>...
#. fr: On ne dirait clairement pas des animaux sauvages...<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:45201:0:0"
msgid "They are <i>clearly</i> not wild animals!"
msgstr "Это <i>точно</i> не дикие звери!"

#. ja: 考えるのは後だ！<br>今は目の前の敵に集中しろ！
#. de: Darüber kannst du später nachdenken. Augen nach vorn!
#. fr: On y réfléchira après<nbsp>! Pour l'instant, il faut les abattre<nbsp>!
msgctxt "InstanceContentTextData:45202:0:0"
msgid "Questions can wait till after the battle!"
msgstr "Вопросы подождут до конца битвы!"

#. ja: ふたりとも、まだやれるな？
#. de: Ich verlass mich auf euch.
#. fr: Vous tenez le coup<nbsp>?
msgctxt "InstanceContentTextData:45203:0:0"
msgid "Ready for another round?"
msgstr "Готовы продолжать?"

#. ja: 問題ない。<br>治癒は私に任せてくれ。
#. de: Natürlich. Ich decke euch den Rücken.
#. fr: Sois tranquille, je me charge de vous soigner.
msgctxt "InstanceContentTextData:45204:0:0"
msgid "Of course. Leave the healing to me."
msgstr "Разумеется. Лечение оставьте мне."

#. ja: 面倒だ……一気に始末する！
#. de: Jetzt reicht's aber. Schluss damit!
#. fr: Ce petit jeu a assez duré<nbsp>!
msgctxt "InstanceContentTextData:45205:0:0"
msgid "Enough. Have at you!"
msgstr "Хватит. Ну, получай!"

#. ja: 仕掛けてくるぞ、構えろ！！
#. de: Sie wollen angreifen ... Macht euch bereit!
#. fr: Ça sent pas bon, préparez-vous à encaisser<nbsp>!
msgctxt "InstanceContentTextData:45206:0:0"
msgid "They're up to something. Be ready!"
msgstr "Они что-то затевают. Будьте готовы!"

#. ja: 防御を厚くする！
#. de: Hier, ein wenig Verstärkung!
#. fr: Je renforce vos défenses<nbsp>!
msgctxt "InstanceContentTextData:45207:0:0"
msgid "I shall fortify our defenses!"
msgstr "Укреплю нашу защиту!"

#. ja: こいつら、いったい何の真似だ……？
#. de: Was soll das denn bitte werden?
#. fr: Mais qu'est-ce qu'ils font<nbsp>?
msgctxt "InstanceContentTextData:45208:0:0"
msgid "What are they playing at?"
msgstr "Что они задумали?"

#. ja: アルフィノを離せ……！
#. de: Finger weg von ihm!
#. fr: Lâchez Alphinaud<nbsp>!
msgctxt "InstanceContentTextData:45209:0:0"
msgid "Let him go!"
msgstr "Отпусти его!"

#. ja: ありがとう、助かったよ。
#. de: Danke euch!
#. fr: Merci pour le coup de main<nbsp>!
msgctxt "InstanceContentTextData:45210:0:0"
msgid "Thank you."
msgstr "Спасибо."

#. ja: しかし、不可解だ……。<br>身動きを縛りながらも、追撃をしてこなかった。
#. de: Eigenartig<nbsp>... Sie haben mich festgesetzt und sofort in Ruhe gelassen.
#. fr: Étrange... Ils ne m'ont pas attaqué après m'avoir immobilisé...
msgctxt "InstanceContentTextData:45211:0:0"
msgid "'Tis curious, though... They made no attempt to strike us while we were bound."
msgstr "Странно всё это... Они связали нас, но даже не попытались напасть."

#. ja: いや、捕縛すること自体が目的だったのか……？
#. de: War das also ihre eigentliche Absicht?
#. fr: Est-ce qu'ils cherchaient... à me capturer<nbsp>?
msgctxt "InstanceContentTextData:45212:0:0"
msgid "Could it be...their true objective is our capture?"
msgstr "Неужели... их настоящая цель — захватить нас?"

#. ja: やれやれ、いったい何なんだ……？
#. de: Was sollte das denn gewesen sein?
#. fr: Ça va<nbsp>?
msgctxt "InstanceContentTextData:45213:0:0"
msgid "What now..."
msgstr "Ну и что теперь?.."

#. ja: 攻撃が止んだようだが……。
#. de: Es scheint vorerst Ruhe eingekehrt zu sein<nbsp>...
#. fr: Ils ne viennent plus, on dirait...
msgctxt "InstanceContentTextData:45214:0:0"
msgid "It appears the onslaught has halted..."
msgstr "Похоже, нападение прекратилось..."

#. ja: ここから敵の動きを伝えるよ！
#. de: Ich halte ein Auge auf die Manöver des Feindes!
#. fr: Restez attentifs<nbsp>! Je vous prrréviendrai quand ils attaqueront<nbsp>!
msgctxt "InstanceContentTextData:45215:0:0"
msgid "I'll watch your backs from here! Do as I say and you'll be fine!"
msgstr "Я буду прикрывать вас отсюда! Делайте, что скажу, и всё будет хорошо!"

#. ja: あの慣れた様子……従ってみるか……。
#. de: Die scheint sich auszukennen. Spielen wir mit.
#. fr: Elle a l'air de savoir ce qu'elle fait...
msgctxt "InstanceContentTextData:45216:0:0"
msgid "She does seem to know what she's doing..."
msgstr "Похоже, она знает, что делает..."

#. ja: 水の魔力があふれるよ！　距離を取って！
#. de: Die ganze Wassermagie entlädt sich! Haltet Abstand!
#. fr: Méfiez-vous de l'eau qui jaillit<nbsp>!
msgctxt "InstanceContentTextData:45217:0:0"
msgid "There's a surge in water energies! Keep your distance!"
msgstr "Вода вот-вот хлынет! Отойдите подальше!"

#. ja: 魔力の凝縮反応を確認……！
#. de: Verzeichne einen massiven Anstieg der magischen Dichte!
#. fr: L'énerrrgie éthérée se condense<nbsp>!
msgctxt "InstanceContentTextData:45218:0:0"
msgid "It's harnessing water!"
msgstr "Она собирает водную магию!"

#. ja: 炸裂する前に離れて！
#. de: Weg da, bevor alles hochgeht!
#. fr: Écarrrtez-vous avant qu'elle n'explose<nbsp>!
msgctxt "InstanceContentTextData:45219:0:0"
msgid "Get clear before it bursts!"
msgstr "Отойдите, пока не взорвалось!"

#. ja: 上を見て、水球が落ちてくる！
#. de: Augen nach oben, bevor euch das Wasser erschlägt!
#. fr: Au-dessus de vous, des sphèrrres d'eau<nbsp>!
msgctxt "InstanceContentTextData:45220:0:0"
msgid "Look out! Those water orbs are going to fall!"
msgstr "Берегитесь! Эти водяные сферы сейчас упадут!"

#. ja: 跳ねる先を予測して避けるんだ！
#. de: Seid wachsam und passt gut auf, dann könnt ihr ausweichen!
#. fr: Déplacez-vous pourrr les éviter<nbsp>!
msgctxt "InstanceContentTextData:45221:0:0"
msgid "Be careful how they bounce!"
msgstr "Смотрите, куда они отскакивают!"

#. ja: 魔力濃度上昇……すぐに退避して！
#. de: Ein Anstieg der magischen Potenz<nbsp>... Rückzug, sofort!
#. fr: L'étherrr s'intensifie... Fuyez<nbsp>!
msgctxt "InstanceContentTextData:45222:0:0"
msgid "This concentration of magic... Quickly, get back!"
msgstr "Магия сгущается... Быстро отступайте!"

#. ja: その内側にいると酷い目に遭うよ！
#. de: Raus da, sonst seid ihr in großen Schwie<shy>rig<shy>keiten!
#. fr: Ne restez surrrtout pas à l'intérieur<nbsp>!
msgctxt "InstanceContentTextData:45223:0:0"
msgid "You do not want to be caught in that!"
msgstr "Только не попадите внутрь!"

#. ja: また拘束するつもりか……！
#. de: Sie wollen mich noch einmal fesseln!
#. fr: Ah non, j'ai déjà donné<nbsp>!
msgctxt "InstanceContentTextData:45224:0:0"
msgid "They're trying to bind us again!"
msgstr "Они снова пытаются нас связать!"

#. ja: やらせるもんか！
#. de: Oh nein, keine Chance!
#. fr: Je ne vous laisserai pas fairrre<nbsp>!
msgctxt "InstanceContentTextData:45225:0:0"
msgid "Oh no you don't!"
msgstr "Не бывать этому!"

#. ja: 助かった、援護に感謝を！
#. de: Besten Dank für die Unterstützung!
#. fr: Merci de m'avoir tiré de ce mauvais pas<nbsp>!
msgctxt "InstanceContentTextData:45226:0:0"
msgid "Thank you for the timely aid!"
msgstr "Спасибо, что вовремя пришли на помощь!"

#. ja: 雑魚は任せて！　キミたちは大型の眷属を！
#. de: Überlasst die Kleinen mir und kümmert euch um den Großen!
#. fr: Je prrrends les petits, occupez-vous du thræll majeur<nbsp>!
msgctxt "InstanceContentTextData:45227:0:0"
msgid "Deal with the big one! I'll handle the rest!"
msgstr "Разберитесь с большим! Остальных я беру на себя!"

#. ja: あれは……浮島のエーテルを吸っているのか！？
#. de: Zieht die Kreatur Äther aus der Insel?!
#. fr: Serait-il en train d'absorber l'éther de l'île...<nbsp>?
msgctxt "InstanceContentTextData:45228:0:0"
msgid "It's...siphoning the isle's aether!?"
msgstr "Оно... вытягивает эфир из острова?!"

#. ja: 魔力を溜めてるんだ、胸のコアを攻撃して！
#. de: Es sammelt Magie in seiner Brust! Greift den Kern an!
#. fr: Il concentrrre son énergie, visez le noyau dans sa poitrine<nbsp>!
msgctxt "InstanceContentTextData:45229:0:0"
msgid "It's gathering power! Throw everything you have at its heart!"
msgstr "Оно копит силу! Бейте изо всех сил прямо в сердце!"

#. ja: そういうことなら、全力でいくだけだ……。
#. de: Schön, dann muss ich mich ja auch nicht zurückhalten.
#. fr: Je crois que c'est le moment de tout donner<nbsp>!
msgctxt "InstanceContentTextData:45230:0:0"
msgid "Hmph. This calls for a heavier hand."
msgstr "Хм. Похоже, придётся взяться за дело всерьёз."

#. ja: 燃えよ竜血、爆ぜよ魔槍！
#. de: Das Blut der Drachen ...
#. fr: Que le sang du dragon brûle en moi<nbsp>!
msgctxt "InstanceContentTextData:45231:0:0"
msgid "Unleash your rage, Nidhogg!"
msgstr "Выпусти ярость, Нидхогг!"

#. ja: 怯んだ！　今がチャンスだよ！
#. de: Das hat wehgetan! Jetzt!
#. fr: Il faiblit, prrrofitez-en<nbsp>!
msgctxt "InstanceContentTextData:45232:0:0"
msgid "Yes, it's reeling! Now's your chance!"
msgstr "Да, он пошатнулся! Сейчас ваш шанс!"

#. ja: こいつで終いだッ！
#. de: ... besiegelt dein Schicksal!
#. fr: Libère ton pouvoir, lance de Nidhogg<nbsp>!
msgctxt "InstanceContentTextData:45233:0:0"
msgid "Down with you!"
msgstr "Сдохни!"

#. ja: 襲撃者たちを倒せ！
#. de: Besiege die Angreifer!
#. fr: Vainquez les assaillants<nbsp>!
msgctxt "InstanceContentTextData:45234:0:0"
msgid "Defeat the hostile creatures!"
msgstr "Победите враждебных созданий!"

#. ja: 次から次へと……！
#. de: Gut, einer nach dem anderen.
#. fr: Ça n'arrête jamais...
msgctxt "InstanceContentTextData:45235:0:0"
msgid "More of them..."
msgstr "Опять..."

#. ja: 我が前に立ちはだかる者よ。<br>美しき闇に閉ざされるがいい……。
#. de: Schöne, stille Dunkelheit. Umschließe meine Widersacher!
#. fr: Celui qui ose s'opposer à moi... finira prisonnier des Ténèbres.
msgctxt "InstanceContentTextData:45300:0:0"
msgid "All who dare oppose me shall quake before the silken Dark..."
msgstr "Все, кто посмеет встать у меня на пути, содрогнутся перед шелковистой Тьмой..."

#. ja: 消滅せよ。
#. de: Alles erlischt!
#. fr: Disparais.
msgctxt "InstanceContentTextData:45301:0:0"
msgid "Perish."
msgstr "Сгинь."

#. ja: 「無」を操らん。
#. de: Das Nichts gehorcht mir.
#. fr: Je peux manipuler le néant à ma guise.
msgctxt "InstanceContentTextData:45302:0:0"
msgid "The void's power is mine to wield."
msgstr "Сила пустоты в моей власти."

#. ja: お前という存在を否定する。
#. de: Du bist ein Niemand.
#. fr: Tu ne mérites pas de vivre.
msgctxt "InstanceContentTextData:45303:0:0"
msgid "You have no place here."
msgstr "Тебе здесь нет места."

#. ja: 滅べ……。
#. de: Vergehe!
#. fr: Sois anéanti<if $gn4>e</if>...
msgctxt "InstanceContentTextData:45304:0:0"
msgid "Accept your downfall."
msgstr "Смирись с поражением."

#. ja: 抗っても無駄だ。
#. de: Wehr dich nicht.
#. fr: Toute résistance est futile.
msgctxt "InstanceContentTextData:45305:0:0"
msgid "Struggle is futile."
msgstr "Сопротивление бесполезно."

#. ja: 彼我の境界を取り払おう。
#. de: Die Grenzen werden eingerissen.
#. fr: Je détruirai la frontière entre nos mondes.
msgctxt "InstanceContentTextData:45306:0:0"
msgid "And thus did all boundaries cease to be."
msgstr "И вот все границы исчезли."

#. ja: 一切の活動を停止せよ。
#. de: Möge Stillstand herrschen.
#. fr: Cesse donc de bouger.
msgctxt "InstanceContentTextData:45307:0:0"
msgid "Be still."
msgstr "Замри."

#. ja: 狭間に落ちてみるか？
#. de: Wer will in den Abgrund blicken?
#. fr: Et si je te projetais dans une faille<nbsp>?
msgctxt "InstanceContentTextData:45308:0:0"
msgid "Doth the yawning rift not tempt you?"
msgstr "Разве тебя не манит зияющая трещина?"

#. ja: これが世界の真実だ……！
#. de: Das ist das wahre Gesicht der Realität!
#. fr: Ce monde n'a qu'une seule vérité<nbsp>!
msgctxt "InstanceContentTextData:45309:0:0"
msgid "Behold the truth of this world!"
msgstr "Узрите истину этого мира!"

#. ja: 「無」が、すべてを包みゆく……
#. de: Das Nichts wird alles verschlingen.
#. fr: Tout sera bientôt englouti !
msgctxt "InstanceContentTextData:45310:0:0"
msgid "The void consumes..."
msgstr "Пустота поглощает..."

#. ja: ここには何もない……
#. de: Alles wird zu nichts.
#. fr: Ici, il n'y a rien...
msgctxt "InstanceContentTextData:45311:0:0"
msgid "Naught will endure..."
msgstr "Ничто не уцелеет..."

#. ja: 過去も未来も、そして現在も。
#. de: Kein Gestern, kein Heute, kein Morgen.
#. fr: Ni passé, ni futur... ni présent.
msgctxt "InstanceContentTextData:45312:0:0"
msgid "Neither past nor future..."
msgstr "Ни прошлого, ни будущего..."

#. ja: 感じられるのはただひとつ……
#. de: Jetzt gibt es nur noch eins ...
#. fr: Tu ne ressentiras plus qu'une chose...
msgctxt "InstanceContentTextData:45313:0:0"
msgid "Only one certainty remains..."
msgstr "Останется лишь одно..."

#. ja: 我が存在だけだ！
#. de: Meine Macht!
#. fr: Mon existence<nbsp>!
msgctxt "InstanceContentTextData:45314:0:0"
msgid "My triumph!"
msgstr "Моя победа!"

#. ja: 奴の領域に干渉した！<br>この光明を辿れ！
#. de: Das ist seine Domäne. Folgt dem Licht!
#. fr: J'ai pu créer une brèche dans son domaine<nbsp>! Suis la Lumière pour en sortir<nbsp>!
msgctxt "InstanceContentTextData:45315:0:0"
msgid "I've breached the darkness! Let the Light guide you!"
msgstr "Я пробил тьму! Пусть Свет укажет вам путь!"

#. ja: 内側からその空間を破るのだ！
#. de: Raus da, schnell!
#. fr: Tu dois briser cet espace de l'intérieur<nbsp>!
msgctxt "InstanceContentTextData:45316:0:0"
msgid "You must break free!"
msgstr "Вы должны вырваться!"

#. ja: 雑魚は一掃した<br>私たちも奴を叩くぞ！
#. de: Die sind erledigt. Jetzt auf Enuo!
#. fr: On s'est occupé du menu fretin<nbsp>! On arrive en renfort<nbsp>!
msgctxt "InstanceContentTextData:45317:0:0"
msgid "The underlings are no more. Now to deal with Enuo!"
msgstr "С приспешниками покончено. Теперь займёмся Энуа!"

#. ja: 生も  死も  すべてが意味を失う……
#. de: Leben und Tod haben keine Bedeutung.
#. fr: La vie, la mort... Plus rien n'a de sens.
msgctxt "InstanceContentTextData:45318:0:0"
msgid "Life and death rendered meaningless..."
msgstr "Жизнь и смерть утратили смысл..."

#. ja: これぞ  真の「無」の力だ！
#. de: Das ist die Macht des Nichts!
#. fr: Admire le véritable pouvoir du néant<nbsp>!
msgctxt "InstanceContentTextData:45319:0:0"
msgid "Such is the power of the void!"
msgstr "Вот она, истинная сила пустоты!"

#. ja: この世界  渡してやるものか！
#. de: Ich gebe diese Welt nicht auf!
#. fr: Tu n'auras pas notre monde<nbsp>!
msgctxt "InstanceContentTextData:45320:0:0"
msgid "I will not yield my domain!"
msgstr "Я не отдам свою землю!"

#. ja: 光よ  私たちに力をッ……！
#. de: Licht, schenk uns Kraft!
#. fr: Ô puissante Lumière, prête-nous ta force<nbsp>!
msgctxt "InstanceContentTextData:45321:0:0"
msgid "Light protect us!"
msgstr "Свет, защити нас!"

#. ja: 「無」が消えることなど有り得ぬ……
#. de: Das Nichts kann nicht vergehen!
#. fr: Impossible<nbsp>! Le néant ne peut disparaître<nbsp>!
msgctxt "InstanceContentTextData:45322:0:0"
msgid "The void shall never cease to be!"
msgstr "Пустота не может исчезнуть!"

#. ja: この力は絶対なのだ！
#. de: Seine Macht ist absolut!
#. fr: Ma puissance est absolue<nbsp>!
msgctxt "InstanceContentTextData:45323:0:0"
msgid "My power is absolute!"
msgstr "Моя сила абсолютна!"

#. ja: 光と闇の果てに、誘おう……。
#. de: Licht und Dunkel enden nun ...
#. fr: Viens aux confins de la Lumière et des Ténèbres...
msgctxt "InstanceContentTextData:45324:0:0"
msgid "Embrace the emptiness beyond Light and Dark."
msgstr "Прими пустоту, что лежит за пределами Света и Тьмы."

#. ja: 永遠の静寂に身を委ねよ……！
#. de: Übrig bleibt nur ewige Stille ...
#. fr: Et succombe au silence éternel<nbsp>!
msgctxt "InstanceContentTextData:45325:0:0"
msgid "Succumb to eternal silence!"
msgstr "Поддайся вечной тишине!"

#. ja: さあ、饗宴を始めましょう……！
#. de: Möge das Festmahl beginnen!
#. fr: Que le festin commence<nbsp>!
msgctxt "InstanceContentTextData:45400:0:0"
msgid "Let the feast begin!"
msgstr "Пусть начнётся пир!"

#. ja: おいでなさい！<br>我が美しき姉妹たち……！
#. de: Eilt herbei, meine Schwestern! Bewirtet unseren Besuch!
#. fr: Venez à moi, mes bien chères sœurs<nbsp>!
msgctxt "InstanceContentTextData:45401:0:0"
msgid "Come, my fair sisters! Entertain our guests."
msgstr "Ко мне, мои прекрасные сёстры! Развлеките наших гостей."

#. ja: あなたたちの生命力、<br>おいしくいただくわ……！
#. de: Mich dürstet nach deiner Lebenskraft<nbsp>...
#. fr: Je vais me délecter de votre énergie vitale<nbsp>!
msgctxt "InstanceContentTextData:45402:0:0"
msgid "Feed me... Let me drink deep of your essence..."
msgstr "Накорми меня... Дай испить твоей сущности..."

#. ja: 私の魅力に溺れなさいな……！
#. de: Erliege deiner Versuchung<nbsp>...
#. fr: Succombez à mes charmes<nbsp>!
msgctxt "InstanceContentTextData:45403:0:0"
msgid "Yield to your yearning..."
msgstr "Поддайтесь своим желаниям..."

#. ja: 愛は猛毒、そうでしょう？
#. de: Liebe ist das süßeste Gift von allen, nicht wahr?
#. fr: L'amour n'est-il pas le plus grand des poisons<nbsp>?
msgctxt "InstanceContentTextData:45404:0:0"
msgid "Love is the sweetest poison, is it not?"
msgstr "Любовь — самый сладкий яд, не так ли?"

