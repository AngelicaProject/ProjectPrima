# InstanceContentTextData
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: この昏き牢獄を、終のしとねとしてやろう……！
#. de: Dieser Kerker wird euer Grab sein!
#. fr: Les ténèbres de cette prison seront votre tombeau<nbsp>!
msgctxt "InstanceContentTextData:35000:0:0"
msgid "Rest eternal in the dark depths of this prison."
msgstr "Покоиться вам вечно во мраке этой темницы."

#. ja: 我が炎は、愛しき獣と化す！
#. de: An meine Seite, Bestie des Feuers!
#. fr: À moi, fidèle serviteur<nbsp>!
msgctxt "InstanceContentTextData:35001:0:0"
msgid "From fulgent flame my servants rise!"
msgstr "Из яркого пламени восстанут мои слуги!"

#. ja: 燃え上がれ、猛き獣よ！
#. de: Wetze deine reißenden Klauen an ihnen!
#. fr: Brûle tout sur ton passage<nbsp>!
msgctxt "InstanceContentTextData:35002:0:0"
msgid "Leave naught but ash in your wake!"
msgstr "Оставьте после себя лишь пепел!"

#. ja: 炎獣よ、貪り喰らえ！
#. de: Zerfleische sie, bis nichts mehr übrig ist!
#. fr: Créatures de flamme, dévorez nos ennemis<nbsp>!
msgctxt "InstanceContentTextData:35003:0:0"
msgid "Go forth, and sate your boundless hunger!"
msgstr "Вперёд! Утолите ненасытный голод!"

#. ja: 私を、ほかの半神と同じと思うな……。
#. de: Haltet mich nicht für irgendeinen beliebigen Halbgott ...
#. fr: Ne croyez pas que je sois semblable aux autres hémithéos...
msgctxt "InstanceContentTextData:35004:0:0"
msgid "You have but glimpsed my power..."
msgstr "Вы лишь мельком увидели мою силу..."

#. ja: 我が身すら捧げた成果、とくと見ろ！
#. de: Seht, was aus mir geworden ist!
#. fr: Admirez le fruit de mon sacrifice<nbsp>!
msgctxt "InstanceContentTextData:35005:0:0"
msgid "Behold the fruits of sacrifice!"
msgstr "Взгляните же на плоды жертвы!"

#. ja: 灼熱よ……走れッ！
#. de: Züngelnde Flammen!
#. fr: Que mes flammes vous emportent<nbsp>!
msgctxt "InstanceContentTextData:35006:0:0"
msgid "Sear flesh from bone!"
msgstr "Испепелю вас до костей!"

#. ja: 炎獄の力を受けるがいい！
#. de: In der Glut sollt ihr schmoren!
#. fr: Vous allez périr sous une chaleur ardente<nbsp>!
msgctxt "InstanceContentTextData:35007:0:0"
msgid "Perish in flame's embrace!"
msgstr "Сгиньте в объятиях пламени!"

#. ja: 今の私は、いささか凶暴だッ！
#. de: Wie fühlt es sich an, malträtiert zu werden?
#. fr: Ma rage est à son paroxysme<nbsp>!
msgctxt "InstanceContentTextData:35008:0:0"
msgid "You will know my rage!"
msgstr "Вы познаете мою ярость!"

#. ja: 轢き殺すッ！
#. de: Sterbt!
#. fr: Je vais vous réduire en miettes<nbsp>!
msgctxt "InstanceContentTextData:35009:0:0"
msgid "Be crushed underfoot!"
msgstr "Будете раздавлены моей поступью!"

#. ja: 進め、荒ぶる身躯よ！
#. de: Nur zu, lasst euch zermalmen!
#. fr: En avant<nbsp>! Va étreindre ces misérables<nbsp>!
msgctxt "InstanceContentTextData:35010:0:0"
msgid "You are prey to be consumed!"
msgstr "Вы лишь добыча, которую мне предстоит поглотить!"

#. ja: 消し飛べッ！
#. de: Aus meinen Augen!
#. fr: Hors de ma vue<nbsp>!
msgctxt "InstanceContentTextData:35011:0:0"
msgid "Out of my sight!"
msgstr "С глаз моих долой!"

#. ja: 思い知るがいい！
#. de: Bis hierhin und nicht weiter!
#. fr: Vous allez regretter de m'avoir affronté<nbsp>!
msgctxt "InstanceContentTextData:35012:0:0"
msgid "A fitting death!"
msgstr "Вот достойная смерть!"

#. ja: そこまでだ！
#. de: Nichts als Abschaum!
#. fr: J'en ai assez de ce combat<nbsp>!
msgctxt "InstanceContentTextData:35013:0:0"
msgid "I tire of this farce!"
msgstr "Мне наскучил этот фарс!"

#. ja: 我が、願いのために……！
#. de: Mein Wunsch wird schon bald in Erfüllung gehen.
#. fr: Mon vœu... sera exaucé<nbsp>!
msgctxt "InstanceContentTextData:35014:0:0"
msgid "I shall see my wish fulfilled."
msgstr "Моё желание непременно исполнится."

#. ja: 絶望とともに眠れ！
#. de: Erstickt an eurer Ver<shy>zweif<shy>lung!
#. fr: Tombez dans l'abîme du désespoir<nbsp>!
msgctxt "InstanceContentTextData:35015:0:0"
msgid "Let seep sorrow into your heart."
msgstr "Пусть скорбь проникнет в ваши сердца."

#. ja: 神に逆らうなど、愚かしい！
#. de: Nur ein Narr stellt sich einem Gott!
#. fr: Imbéciles<nbsp>! Voilà ce qu'il en coûte de défier un dieu<nbsp>!
msgctxt "InstanceContentTextData:35016:0:0"
msgid "Fools, braying before a god!"
msgstr "Глупцы, осмелившиеся лаять на бога!"

#. ja: 半神では及ばぬとて……<br>まだ、終わらんよ……！
#. de: Es ist an der Zeit, meine Grenzen hinter mir zu lassen!
#. fr: Ma force de demi-dieu n'est pas suffisante... Il m'en faut plus<nbsp>!
msgctxt "InstanceContentTextData:35017:0:0"
msgid "Godhood is within my grasp... I need only reach..."
msgstr "Божество уже близко... Осталось лишь дотянуться..."

#. ja: たとえ、この肉体が崩壊しようとも……！
#. de: Und wenn ich dafür diesen Körper opfern muss.
#. fr: Même si je dois détruire ce corps...
msgctxt "InstanceContentTextData:35018:0:0"
msgid "Even should my vessel crumble..."
msgstr "Даже если моё тело рассыплется в прах..."

#. ja: さらなる変化を……転身を成す！
#. de: Meine neue Gestalt wird alles in den Schatten stellen!
#. fr: Je le sculpterai... selon mes besoins<nbsp>!
msgctxt "InstanceContentTextData:35019:0:0"
msgid "I shall take hold...of my reward!"
msgstr "Я овладею... своей наградой!"

#. ja: こ、こここれぞ、キュウキョク……ノッ！
#. de: E-Endlich ... Vollkommenheit!
#. fr: Pour atteindre... L'ultime forme<nbsp>!
msgctxt "InstanceContentTextData:35020:0:0"
msgid "Yes... Hehehe... At last!"
msgstr "Да... Хе-хе-хе... Наконец-то!"

#. ja: 消エヨ……小サきっ、命ッ！
#. de: Niedere ... Kreaturen!
#. fr: Disparaissez<nbsp>! Misérables insectes<nbsp>!
msgctxt "InstanceContentTextData:35021:0:0"
msgid "Receive of me death...and be honored!"
msgstr "Примите смерть от меня... и сочтите за честь!"

#. ja: これで終わりだ……小さき命よ……。
#. de: Eure niedere Existenz hat nun ein Ende.
#. fr: C'en est fini pour vous...
msgctxt "InstanceContentTextData:35022:0:0"
msgid "This is the end..."
msgstr "Вот и конец..."

#. ja: 我ガ遺伝子を、分け与えヨウ！
#. de: Werdet ... zu einem Teil von mir!
#. fr: Recevez donc mes divins gènes<nbsp>!
msgctxt "InstanceContentTextData:35023:0:0"
msgid "Rejoice, and partake of my gift!"
msgstr "Радуйтесь и примите мой дар!"

#. ja: そノ……魂、分離セヨッ！
#. de: Eure Seelen braucht ihr jetzt nicht mehr!
#. fr: Cette âme... est à moi<nbsp>!
msgctxt "InstanceContentTextData:35024:0:0"
msgid "Your soul undone!"
msgstr "Ваши души будут развеяны!"

#. ja: 我ガ意の……意のままニ踊れッ！
#. de: Wie kleine, tanzende Marionetten ...
#. fr: Ma volonté... est absolue<nbsp>!
msgctxt "InstanceContentTextData:35025:0:0"
msgid "My will is absolute!"
msgstr "Моя воля абсолютна!"

#. ja: ショウメツ、消滅セヨッ！
#. de: Verreckt! Verreckt, sage ich!
#. fr: Je vais tous vous annihiler<nbsp>!
msgctxt "InstanceContentTextData:35026:0:0"
msgid "Embrace annihilation!"
msgstr "Покоритесь уничтожению!"

#. ja: 混沌ヲ喰らえッ！
#. de: Zerfallt im Chaos!
#. fr: Tremblez devant la puissance du chaos<nbsp>!
msgctxt "InstanceContentTextData:35027:0:0"
msgid "Gorge upon the dregs of chaos!"
msgstr "Пируйте на останках хаоса!"

#. ja: ソろソロ、落ちロッ！
#. de: Und nun ... in den Staub!
#. fr: Vous allez mordre la poussière, oui<nbsp>?
msgctxt "InstanceContentTextData:35028:0:0"
msgid "Surrender to oblivion!"
msgstr "Сдавайтесь забвению!"

#. ja: アテナと……また、会うのダッ！
#. de: Athena ... wo ist Athena?
#. fr: Athéna... Nous allons enfin nous revoir...
msgctxt "InstanceContentTextData:35029:0:0"
msgid "Athena... How I long for our reunion..."
msgstr "Ах, Афина... Как же я жажду нашей встречи..."

#. ja: 全て！　すベテ朽チようともッ！
#. de: Verfaulen sollt ihr, allesamt!
#. fr: Je détruirai le monde entier s'il le faut...<nbsp>!
msgctxt "InstanceContentTextData:35030:0:0"
msgid "If I must tear this wretched world down...I shall!"
msgstr "Если придётся разнести этот жалкий мир в щепки... так и будет!"

#. ja: ラハブレアの、力ダ……！
#. de: Lahabreas Kraft ... ist mein!
#. fr: Admirez la véritable puissance de Lahabrea<nbsp>!
msgctxt "InstanceContentTextData:35031:0:0"
msgid "How dare you defy Lahabrea!"
msgstr "Как вы смеете бросать вызов Лахабреа?!"

#. ja: コレデ、最後ダ……小さき、アワレな命ヨ！！
#. de: Elende Maden! Eure Erlösung ist nah!
#. fr: Vos tristes vies s'achèvent ici et maintenant<nbsp>!
msgctxt "InstanceContentTextData:35032:0:0"
msgid "Your feeble flame must be snuffed out!"
msgstr "Вам не погасить пламя ваших жалких жизней!"

#. ja: ヘファイストスの撃破
#. de: Hephaistos besiegen
#. fr: Vaincre Héphaïstos
msgctxt "InstanceContentTextData:35033:0:0"
msgid "Defeat Hephaistos"
msgstr "Победите Гефеста"

#. ja: ふふ……！<br>来ちゃった……！
#. de: Ha! Sie sind doch tatsächlich gekommen!
#. fr: Hihihi<nbsp>! Je suis venue aussi<nbsp>!
msgctxt "InstanceContentTextData:35100:0:0"
msgid "Forgive me, but I couldn't stay away."
msgstr "Простите, но я не смогла остаться в стороне."

#. ja: ふむ、期せずして我が妹も来訪したようだな。
#. de: Sieh an, du lässt dich auf einen Besuch bei mir herab?
#. fr: Tiens donc, je ne m'attendais pas à te voir ici.
msgctxt "InstanceContentTextData:35101:0:0"
msgid "Hm, it seems my sister shall be joining us."
msgstr "Хм, похоже, к нам присоединится и моя сестра."

#. ja: 我々兄妹神と手合わせを！
#. de: So lasset die göttliche Prüfung beginnen!
#. fr: Mortels, nous serons vos adversaires<nbsp>!
msgctxt "InstanceContentTextData:35102:0:0"
msgid "'Tis only fitting that we face you together!"
msgstr "Нам с сестрой пристало сразиться с вами вместе!"

#. ja: 時よ、我が意のままに……！
#. de: Lauf der Zeit, beuge dich meinem Willen!
#. fr: Le temps se plie à ma volonté<nbsp>!
msgctxt "InstanceContentTextData:35103:0:0"
msgid "The sands of time are mine to command!"
msgstr "Пески времени подвластны мне!"

#. ja: これぞ時神の神髄なり！
#. de: Dies ist die göttliche Essenz allen Seins!
#. fr: Ressentez l'essence du Contemplateur<nbsp>!
msgctxt "InstanceContentTextData:35104:0:0"
msgid "Bear witness to the Keeper's might!"
msgstr "Узрите мощь Хранителя!"

#. ja: さあ、見極めてやろう！
#. de: Macht euch bereit!
#. fr: Je vous ai à l'œil<nbsp>!
msgctxt "InstanceContentTextData:35105:0:0"
msgid "I shall measure your worth."
msgstr "Покажите, чего вы стоите."

#. ja: 時よ刻め……！
#. de: Eure Stunde hat geschlagen!
#. fr: Gardez le fil du temps<nbsp>!
msgctxt "InstanceContentTextData:35106:0:0"
msgid "Time marches to my whim!"
msgstr "Время идёт по моей прихоти!"

#. ja: 刹那なる人の命を輝かせ！
#. de: Ihr könnt der Vergänglichkeit nicht entfliehen!
#. fr: Brillez dans votre fugacité<nbsp>!
msgctxt "InstanceContentTextData:35107:0:0"
msgid "Let burn your fleeting lives!"
msgstr "Пусть пылают ваши быстротечные жизни!"

#. ja: 我が引力に従え！
#. de: Es gibt kein Entrinnen!
#. fr: Ployez sous la puissance de la pesanteur<nbsp>!
msgctxt "InstanceContentTextData:35108:0:0"
msgid "Surrender to my power!"
msgstr "Покоритесь моей силе!"

#. ja: さあ、運命に抗ってみせて！
#. de: Nun liegt es an euch, dem Schicksal zu trotzen!
#. fr: À vous d'affronter votre destinée<nbsp>!
msgctxt "InstanceContentTextData:35109:0:0"
msgid "Have you the strength to defy fate?"
msgstr "Хватит ли у вас сил бросить вызов судьбе?"

#. ja: 戦いざまをよく見せて？
#. de: Ich will sehen, was ihr könnt!
#. fr: Montrez-moi ce que vous savez faire<nbsp>!
msgctxt "InstanceContentTextData:35110:0:0"
msgid "Show me everything."
msgstr "Покажите мне всё, на что способны."

#. ja: 星のめぐりに祈るといいわ！
#. de: Sprecht euer Gebet zu den Sternen!
#. fr: Priez pour que les étoiles vous soient favorables<nbsp>!
msgctxt "InstanceContentTextData:35111:0:0"
msgid "Pray to the stars on high!"
msgstr "Молитесь звёздам небесным!"

#. ja: ああ、綺羅星のようね！
#. de: Oh, dieser herrliche Glanz!
#. fr: Ah, que les étoiles scintillantes sont belles<nbsp>!
msgctxt "InstanceContentTextData:35112:0:0"
msgid "Like the bejeweled night sky!"
msgstr "Словно усыпанное драгоценностями ночное небо!"

#. ja: 水の神威に呑まれなさい……！
#. de: Ertrinkt in den göttlichen Fluten!
#. fr: Soyez engloutis par le déchaînement de l'eau divine<nbsp>!
msgctxt "InstanceContentTextData:35113:0:0"
msgid "Drown in waters divine! "
msgstr "Утоните в божественных водах!"

#. ja: 貴方たちの運命を紡いであげる。
#. de: Eines ist gewiss, ihr teilt alle dasselbe Schicksal!
#. fr: Laissez-moi tisser les fils de votre destin.
msgctxt "InstanceContentTextData:35114:0:0"
msgid "I will spin your fates."
msgstr "Я сотку ваши судьбы."

#. ja: ゆくぞ、我が妹よ……。
#. de: Du bist an der Reihe, Nymeia.
#. fr: Tu es prête<nbsp>? C'est le moment...
msgctxt "InstanceContentTextData:35115:0:0"
msgid "With me, Sister."
msgstr "Со мной, сестра."

#. ja: 準備はできてるわ、お兄様！
#. de: Nichts lieber als das, Bruderherz.
#. fr: Quand tu veux, grand frère<nbsp>!
msgctxt "InstanceContentTextData:35116:0:0"
msgid "Ever ready, Brother!"
msgstr "Всегда готова, брат!"

#. ja: 時と運命の理（ことわり）よ、人を導け！
#. de: So folget dem Schicksal auf den Pfaden der Zeit!
#. fr: Soumettez-vous aux lois du temps et du destin<nbsp>!
msgctxt "InstanceContentTextData:35117:0:0"
msgid "O time and fate inexorable, guide them true!"
msgstr "О время и неумолимая судьба, укажите им путь!"

#. ja: 待ちわびたぞ、この時を……。
#. de: Auf diesen Moment<nbsp>... habe ich lange gewartet<nbsp>...
#. fr: J'ai tant attendu ce moment...
msgctxt "InstanceContentTextData:35118:0:0"
msgid "Long have I awaited this moment..."
msgstr "Я так долго ждал этого момента..."

#. ja: これが運命なのね……。
#. de: Und so fand auch ich<nbsp>... meine Bestimmung<nbsp>...
#. fr: Telle est donc votre destinée...
msgctxt "InstanceContentTextData:35119:0:0"
msgid "This, too, is fate..."
msgstr "Значит, и это — судьба..."

#. ja: 豊穣の地の突破
#. de: Das Land der Fruchtbarkeit erobern
#. fr: Franchir la terre d'abondance
msgctxt "InstanceContentTextData:35120:0:0"
msgid "Clear the fertile plains"
msgstr "Преодолейте плодородные равнины"

#. ja: 世界樹の根土の突破
#. de: Den Fuß des Weltenbaums erobern
#. fr: Franchir les racines de l'Arbre-Monde
msgctxt "InstanceContentTextData:35121:0:0"
msgid "Clear the Roots"
msgstr "Преодолейте Корни"

#. ja: 世界樹の突破
#. de: Den Weltenbaum erobern
#. fr: Franchir l'Arbre-Monde
msgctxt "InstanceContentTextData:35122:0:0"
msgid "Clear the Bole"
msgstr "Преодолейте Ствол"

#. ja: 削られた氷河の突破
#. de: Den Geschabten Gletscher erobern
#. fr: Franchir le glacier ciselé
msgctxt "InstanceContentTextData:35123:0:0"
msgid "Clear the hanging tributary"
msgstr "Преодолейте свисающий приток"

#. ja: 戦神の間の突破
#. de: Die Domäne der Furie erobern
#. fr: Franchir les quartiers de la Conquérante
msgctxt "InstanceContentTextData:35124:0:0"
msgid "Clear the Barbs"
msgstr "Преодолейте Шипы"

#. ja: 双月の間の突破
#. de: Die Kammer der Zwillingsmonde erobern
#. fr: Franchir la chambre des lunes jumelles
msgctxt "InstanceContentTextData:35125:0:0"
msgid "Clear the Chamber of Revolutions"
msgstr "Преодолейте Палату Революций"

#. ja: 地神ノフィカ、自ら出迎えとはな……！
#. de: Kaum zu glauben, dass Nophica uns selbst willkommen heißt!
#. fr: Nophica elle-même est venue nous accueillirrr<nbsp>!
msgctxt "InstanceContentTextData:35126:0:0"
msgid "That the Matron should welcome us herself!"
msgstr "Сама Матрона встречает нас! Вот это честь!"

#. ja: エーテルスキャナーは正常に作動してる、先に進もう！
#. de: Keine Probleme mit dem Ätheranalysator. Lass uns weitergehen.
#. fr: L'éthérographe fonctionne comme prrrévu. Continuons<nbsp>!
msgctxt "InstanceContentTextData:35127:0:0"
msgid "The aetheric analyzer works as it should. Let us press on."
msgstr "Анализатор эфира работает как надо. Продолжим путь."

#. ja: 我が権能にて、大地の別なる姿を示そうぞ。
#. de: Auf mein Geheiß soll sich das Antlitz der Erde wandeln.
#. fr: Il est temps de révéler une autre facette de la planète...
msgctxt "InstanceContentTextData:35128:0:0"
msgid "By my authority, let the land be remade."
msgstr "Моей властью да преобразится земля."

#. ja: 土属性を司り、重力を操る十二神の一柱。<br>時神アルジクだ……！
#. de: Derart Raum und Zeit zu manipulieren<nbsp>... Wir stehen Althyk, dem Hüter, gegenüber!
#. fr: Un Dieu capable de manipuler le temps et la grrravité... C'est Althyk, le Contemplateur<nbsp>!
msgctxt "InstanceContentTextData:35129:0:0"
msgid "Of course... It would have to be Althyk who could so manipulate space!"
msgstr "Разумеется... Пространством и временем может повелевать только Алтик, Хранитель!"

#. ja: ふふ……！<br>来ちゃった……！
#. de: Ha! Sie sind doch tatsächlich gekommen!
#. fr: Hihihi<nbsp>! Je suis venue aussi<nbsp>!
msgctxt "InstanceContentTextData:35130:0:0"
msgid "Forgive me, but I couldn't stay away."
msgstr "Простите, но я не смогла остаться в стороне."

#. ja: ふむ、期せずして我が妹も来訪したようだな。
#. de: Sieh an, du lässt dich auf einen Besuch bei mir herab?
#. fr: Tiens donc, je ne m'attendais pas à te voir ici.
msgctxt "InstanceContentTextData:35131:0:0"
msgid "Hm, it seems my sister shall be joining us."
msgstr "Хм, похоже, к нам присоединится и моя сестра."

#. ja: さあ、至上の戦場に立つ栄誉を与えよう……！
#. de: Fühlt euch geehrt, auf diesem Schlachtfeld fallen zu dürfen.
#. fr: Je vous invite à me rejoindre sur le champ de bataille suprême<nbsp>!
msgctxt "InstanceContentTextData:35132:0:0"
msgid "Upon the most exalted of battlefields you shall stand."
msgstr "Вам выпала честь сразиться на величайшем поле брани."

#. ja: 氷属性の神域に呼び込まれた、ということは……。
#. de: Wir sind in ein gefrorenes Reich gekommen. Das bedeutet<nbsp>...
#. fr: Ce domaine est entièrrrement gelé...
msgctxt "InstanceContentTextData:35133:0:0"
msgid "We are come to a frozen domain. Which means..."
msgstr "Мы попали в ледяное царство. Значит..."

#. ja: 前に倣え！　行進せよ！
#. de: Nur weiter, die Front ist ganz nah!
#. fr: En avant, marche<nbsp>!
msgctxt "InstanceContentTextData:35134:0:0"
msgid "Summon your courage and press on!"
msgstr "Наберитесь смелости и продолжайте путь!"

#. ja: おそらく先に待つのは、<br>イシュガルドの守護神、戦神ハルオーネだろう。
#. de: Es scheint so gut wie sicher, dass Halone, die Furie, uns erwartet.
#. fr: Aucun doute, notre prrrochain adversaire sera bien Halone, la Conquérante.
msgctxt "InstanceContentTextData:35135:0:0"
msgid "'Tis all but certain that Halone awaits."
msgstr "Почти не сомневаюсь, что нас ждёт Халоне, Фурия."

#. ja: この光は……オレたちを宮殿の中へと誘っている……？
#. de: Dieses Licht<nbsp>... Es scheint uns zu jenem Palast zu locken.
#. fr: Cette lumièrrre... Elle nous invite à l'intérieur<nbsp>!?
msgctxt "InstanceContentTextData:35136:0:0"
msgid "This light... It seems to beckon us to yonder palace."
msgstr "Этот свет... Кажется, он манит нас во дворец."

#. ja: 生命の迸りをみせてちょうだい！
#. de: Zeigt mir, wie viel Leben in euch steckt!
#. fr: Montrez-moi la pétulance de l'humanité<nbsp>!
msgctxt "InstanceContentTextData:35137:0:0"
msgid "Prove to me life's resolve!"
msgstr "Докажите мне, что жизнь умеет бороться!"

#. ja: 地神の息吹きを、いまここに……。
#. de: Ich rufe die Kräfte, die in der fruchtbaren Erde wohnen<nbsp>...
#. fr: Sentez le souffle de la Mère...
msgctxt "InstanceContentTextData:35138:0:0"
msgid "Mine is the breath of the earth..."
msgstr "Я — дыхание земли..."

#. ja: さあ、頭を垂れなさい？
#. de: Das dürfte euch geschwächt haben.
#. fr: Vous allez vous prosterner<nbsp>!
msgctxt "InstanceContentTextData:35139:0:0"
msgid "Bow down like the willow."
msgstr "Склонись, словно ива."

#. ja: 豊穣の意味を、教えてあげましょう！
#. de: Lasst mich euch die Bedeutung von Fülle lehren!
#. fr: Contemplez la fertilité dans toute sa splendeur<nbsp>!
msgctxt "InstanceContentTextData:35140:0:0"
msgid "Know true abundance!"
msgstr "Познайте истинное изобилие!"

#. ja: 人の萌しに、胸が躍るわ！
#. de: Nichts fasziniert mich mehr als das Leben!
#. fr: Quelle extase d'admirer ce dont vous êtes capables<nbsp>!
msgctxt "InstanceContentTextData:35141:0:0"
msgid "My heart rejoices for our union!"
msgstr "Моё сердце радуется нашему единению!"

#. ja: 実った穂を刈り取るように……！
#. de: Reife Früchte erwartet die Ernte!
#. fr: Que ce qui a été semé soit récolté<nbsp>!
msgctxt "InstanceContentTextData:35142:0:0"
msgid "Reap the harvest!"
msgstr "Пожинайте урожай!"

#. ja: 沃土の糧とおなりなさい！
#. de: Auch ihr werdet bald den Boden nähren!
#. fr: Nourrissez les terres fertiles<nbsp>!
msgctxt "InstanceContentTextData:35143:0:0"
msgid "Nourish the soil!"
msgstr "Удобряйте почву!"

#. ja: 疾風勁草、たくましくあれ！
#. de: Möge das Kraut den Winden trotzen!
#. fr: Révélez-moi vos capacités insondées<nbsp>!
msgctxt "InstanceContentTextData:35144:0:0"
msgid "Beyond adversity lies strength!"
msgstr "За невзгодами кроется сила!"

#. ja: 大地の脈動、感じるかしら？
#. de: Fühlt ihr den Puls der Natur?
#. fr: Sentez-vous battre le cœur de la planète<nbsp>?
msgctxt "InstanceContentTextData:35145:0:0"
msgid "Feel you the heartbeat of the land?"
msgstr "Чувствуете биение земли?"

#. ja: 枯れ木に花を、大地に緑を！
#. de: Erde den Blumen, Wasser dem Baume!
#. fr: Que fleurissent les arbres, que verdissent les terres<nbsp>!
msgctxt "InstanceContentTextData:35146:0:0"
msgid "Let life flower and flourish!"
msgstr "Пусть жизнь расцветает и процветает!"

#. ja: いい子たち。<br>この先もどうか挫けずに……。
#. de: Gut gemacht, meine Kinder. Nun setzt euren Weg fort<nbsp>...
#. fr: Mes chers enfants... N'abandonnez jamais...
msgctxt "InstanceContentTextData:35147:0:0"
msgid "Good children... Be strong for what awaits..."
msgstr "Мои хорошие... Будьте сильны перед лицом грядущего..."

#. ja: さあ、あなたたちの愛を感じさせて！
#. de: Keine Sorge, hier wird es euch an Liebe nicht fehlen.
#. fr: Faites-moi sentir votre amour<nbsp>!
msgctxt "InstanceContentTextData:35148:0:0"
msgid "Bare to me your lover's heart!"
msgstr "Откройте мне своё любящее сердце!"

#. ja: これが……わたくしの力よ！
#. de: Ich demonstriere euch gerne mein Können!
#. fr: Voilà toute l'étendue de ma puissance<nbsp>!
msgctxt "InstanceContentTextData:35149:0:0"
msgid "Behold my power."
msgstr "Узрите мою силу."

#. ja: わたくしだって、この程度は……！
#. de: Hm, ich habe mir das schwieriger vorgestellt.
#. fr: Quel bonheur de me mesurer à vous<nbsp>!
msgctxt "InstanceContentTextData:35150:0:0"
msgid "Lest you worry, 'tis naught I cannot handle."
msgstr "Не волнуйтесь, с этим я справлюсь."

#. ja: 行くわよ……覚悟なさい……！
#. de: Hoffentlich seid ihr alle gut vorbereitet.
#. fr: À moi de jouer... Préparez-vous<nbsp>!
msgctxt "InstanceContentTextData:35151:0:0"
msgid "Prepare yourselves."
msgstr "Приготовьтесь."

#. ja: 好きだからこそ、容赦しないわ……！
#. de: Ich tue das nur, weil ich euch liebe!
#. fr: Qui aime bien, châtie bien<nbsp>!
msgctxt "InstanceContentTextData:35152:0:0"
msgid "Love moves me to act."
msgstr "Любовь заставляет меня действовать."

#. ja: この子といっしょに、遊びましょ！
#. de: Kommt, spielt mit meinem Kleinen!
#. fr: Jouez donc avec mon fidèle compagnon<nbsp>!
msgctxt "InstanceContentTextData:35153:0:0"
msgid "Let's delight in the simple things!"
msgstr "Давайте порадуемся простым вещам!"

#. ja: ほら、遊んでらっしゃい！
#. de: Mein treuer Gefährte möchte mitmachen!
#. fr: On s'amuse bien, hein<nbsp>?
msgctxt "InstanceContentTextData:35154:0:0"
msgid "Go on and play!"
msgstr "Ну же, поиграй!"

#. ja: 大好きよ、愛しい人たち……！
#. de: Meine Liebe für euch ist ungebrochen<nbsp>...
#. fr: Je vous aimerai pour toujours... de tout mon cœur<nbsp>!
msgctxt "InstanceContentTextData:35155:0:0"
msgid "You're always in my heart, my loves..."
msgstr "Вы всегда в моём сердце, любимые..."

#. ja: 汝らの武勇、戦神に示してみせよ！
#. de: Krieger, beweist mir euren Kampfeswillen!
#. fr: Prouvez votre courage à la Conquérante<nbsp>!
msgctxt "InstanceContentTextData:35156:0:0"
msgid "I, the Fury, shall test your strength of spirit!"
msgstr "Я, Фурия, испытаю силу вашего духа!"

#. ja: 我が槍よ、凍てつく煌めきを宿せ……！
#. de: Eisige Lanze, durchbohre ihr Herz!
#. fr: Que ma lance s'imprègne d'un froid étincelant<nbsp>!
msgctxt "InstanceContentTextData:35157:0:0"
msgid "All-piercing spear, drink deep of raging blizzards!"
msgstr "Пронзающее копьё, напитайся свирепыми метелями!"

#. ja: 誉れのために、その身を捧げよ！
#. de: Blickt eurem Tod mit Stolz entgegen!
#. fr: Soyez sacrifiés dans la gloire<nbsp>!
msgctxt "InstanceContentTextData:35158:0:0"
msgid "For glory, you must be prepared to render your all!"
msgstr "Ради славы будьте готовы отдать всё!"

#. ja: 手ぬるい！　私は主らの戦神ぞ！
#. de: Ihr vergesst, wer euch gegenübersteht!
#. fr: Trop faible<nbsp>! Ne retenez pas vos coups<nbsp>!
msgctxt "InstanceContentTextData:35159:0:0"
msgid "You must do better than that against me!"
msgstr "Против меня нужно постараться получше!"

#. ja: 戦場では、退くことはかなわぬ！
#. de: Ein Rückzug steht außer Frage!
#. fr: La capitulation n'est pas une option<nbsp>!
msgctxt "InstanceContentTextData:35160:0:0"
msgid "There is no retreat─only victory or defeat!"
msgstr "Отступать нельзя — только победа или поражение!"

#. ja: 栄光の勝利、己が手で掴みとれ！
#. de: Die Glorie des Sieges ist mein!
#. fr: L'apothéose de la victoire sera mienne<nbsp>!
msgctxt "InstanceContentTextData:35161:0:0"
msgid "Victory must be seized with one's own hands!"
msgstr "Победу нужно завоевать собственными руками!"

#. ja: 威容の氷河に黙せ……。
#. de: Erzittert vor dem Glanze des Gletschers!
#. fr: Soyez écrasés par la grandeur des glaciers...
msgctxt "InstanceContentTextData:35162:0:0"
msgid "In ice unyielding now rest."
msgstr "Покойтесь во льдах неумолимого ледника."

#. ja: 戦技、イージス・オブ・ハルオーネ！
#. de: Mein Schild ist meine Stärke!
#. fr: À moi, égide majestueuse<nbsp>!
msgctxt "InstanceContentTextData:35163:0:0"
msgid "Mine is the aegis!"
msgstr "Мой щит — моя сила!"

#. ja: ああ、この戦いが永久に続けばよいのに……！
#. de: Oh, könnte das Fechten doch ewig währen!
#. fr: Ah, si cette joute pouvait être éternelle<nbsp>!
msgctxt "InstanceContentTextData:35164:0:0"
msgid "Ah, would that our clash could continue forever..."
msgstr "Ах, если бы наш поединок длился вечно..."

#. ja: ともに、血の宴に酔いしれようぞ！
#. de: Das Blut soll auf unseren Klingen tanzen!
#. fr: Enivrons-nous ensemble de ce festin de sang<nbsp>!
msgctxt "InstanceContentTextData:35165:0:0"
msgid "Yes, lose yourself in the joy of battle!"
msgstr "Да, отдайте себя радости битвы!"

#. ja: 上々！　さあ、先へ進め！
#. de: Geht! Euer Kampf ist noch nicht vorüber!
#. fr: Admirable<nbsp>! Continuez votre marche en avant<nbsp>!
msgctxt "InstanceContentTextData:35166:0:0"
msgid "Well fought, mortals! Your next test awaits!"
msgstr "Неплохо, смертные! Впереди вас ждёт новое испытание!"

#. ja: 時が加速するまで　3
#. de: 3 Sekunden, bis die Zeit sich beschleunigt.
#. fr: Accélération du temps dans 3 secondes...
msgctxt "InstanceContentTextData:35167:0:0"
msgid "3 seconds until time accelerates."
msgstr "До ускорения времени осталось 3 секунды."

#. ja: 時が加速するまで　2
#. de: 2 Sekunden, bis die Zeit sich beschleunigt.
#. fr: Accélération du temps dans 2 secondes...
msgctxt "InstanceContentTextData:35168:0:0"
msgid "2 seconds until time accelerates."
msgstr "До ускорения времени осталось 2 секунды."

#. ja: 時が加速するまで　1
#. de: 1 Sekunde, bis die Zeit sich beschleunigt.
#. fr: Accélération du temps dans 1 seconde...
msgctxt "InstanceContentTextData:35169:0:0"
msgid "1 second until time accelerates."
msgstr "До ускорения времени осталась 1 секунда."

#. ja: アルジクの権能により、時間が加速する……！
#. de: Die Zeit beschleunigt sich auf Althyks Geheiß!
#. fr: Le temps est accéléré par le pouvoir d'Althyk<nbsp>!
msgctxt "InstanceContentTextData:35170:0:0"
msgid "Time accelerates at Althyk's command!"
msgstr "Время ускоряется по воле Алтика!"

#. ja: メネフィナの神力により、月が形成された……！
#. de: Der Mond formt sich auf Menphinas Geheiß!
#. fr: Des lunes sont créées par le pouvoir de Menphina<nbsp>!
msgctxt "InstanceContentTextData:35171:0:0"
msgid "The moon forms at Menphina's command!"
msgstr "По воле Менфины возникает луна!"

#. ja: 慈愛の月が満ち始める……
#. de: Der Mond beginnt zuzunehmen<nbsp>...
#. fr: La brillance de l'amour commence à s'intensifier...
msgctxt "InstanceContentTextData:35172:0:0"
msgid "The moon begins to wax..."
msgstr "Луна любви начинает прибывать..."

#. ja: あなたたちなら、きっと受け止めてくれるわね。<br>わたくしとあの子の、月神の愛を！
#. de: Wir schenken euch all unsere Liebe. Bitte nehmt sie an, meine Lieben!
#. fr: Puissiez-vous accepter tout notre amour<nbsp>!
msgctxt "InstanceContentTextData:35173:0:0"
msgid "All of our love, we give unto you. Pray accept it, my darlings!"
msgstr "Вся наша любовь — вам. Примите же её, мои милые!"

#. ja: 待ちに待った大一番……ガッカリさせてくれるなよ！？
#. de: Endlich darf ich euch in meinen Fluten ertränken!
#. fr: Enfin le combat que j'attendais tant... Vous n'avez pas intérêt à me décevoir<nbsp>!
msgctxt "InstanceContentTextData:35200:0:0"
msgid "I've been waiting so long. Don't disappoint!"
msgstr "Я так долго ждал этого боя. Не разочаруйте!"

#. ja: 水のカイナッツォの力、見せてやるぜ！
#. de: Wasser marsch!
#. fr: Le maître de l'eau, c'est moi<nbsp>!
msgctxt "InstanceContentTextData:35202:0:0"
msgid "I bring my all to bear!"
msgstr "Я покажу вам всё, на что способен!"

#. ja: 四天王の恐ろしさ、とくと味わえ！
#. de: Kniet vor den Wogen meiner Macht!
#. fr: Le seigneur Golbez ne m'a pas choisi par hasard<nbsp>!
msgctxt "InstanceContentTextData:35203:0:0"
msgid "Drink deep of blackest terror!"
msgstr "Вкусите же чёрный ужас сполна!"

#. ja: 俺様の本気を……くらいやがれェ！！
#. de: Das ist euer Untergang!
#. fr: Vous voulez voir quand je m'énerve<nbsp>!?
msgctxt "InstanceContentTextData:35204:0:0"
msgid "No more games!"
msgstr "Хватит игр!"

#. ja: なんだとぉ？　こいつぁたまげた……！
#. de: Was bei allen Meeren wird das?!
#. fr: Alors là... Ça m'en bouche un coin<nbsp>!
msgctxt "InstanceContentTextData:35205:0:0"
msgid "What!? That's not right!"
msgstr "Что!? Так не должно быть!"

#. ja: 楽しくなってきたぜ！　グヘヘヘヘ！
#. de: Hahaha, endlich kommt der Kampf in Fahrt!
#. fr: Mouahaha<nbsp>! Qu'est-ce qu'on se marre<nbsp>!
msgctxt "InstanceContentTextData:35206:0:0"
msgid "Battle does so whet the appetite. Gheh heh heh heh!"
msgstr "Вот теперь становится весело! Гхе-хе-хе-хе!"

#. ja: いいぞ、最後の戦いにふさわしい……！
#. de: Jetzt entscheidet sich, wie stark ihr wirklich seid!
#. fr: Une lutte acharnée, y a que ça de vrai<nbsp>!
msgctxt "InstanceContentTextData:35207:0:0"
msgid "Good, good. A fitting finale!"
msgstr "Хорошо, хорошо. Достойная финальная битва!"

#. ja: カタカタカタ……基礎訓練ヲ開始。<br>戦闘時間ヲ計測スル……。
#. de: \<klick> Beginn der Grundausbildung. Kampfzeit wird berechnet<nbsp>...
#. fr: (cliquette) Début de l'en<shy>traî<shy>ne<shy>ment de base. Chronométrage du temps de combat...
msgctxt "InstanceContentTextData:35208:0:0"
msgid "Commencing basic training regimen. \\<crack> Your time to completion will be recorded."
msgstr "Начинаю базовую тренировку. \\<хруст> Время прохождения будет записано."

#. ja: 隙ヲ逃サズ、確実ニ致命傷ヲ与エヨ……。
#. de: Tödlicher und unausweichlicher Schlag wird ausgeführt.
#. fr: Infliger<nbsp>: coup létal et inévitable.
msgctxt "InstanceContentTextData:35209:0:0"
msgid "Leave no openings. Your strikes must be quick and decisive."
msgstr "Не упускайте ни единого шанса. Бейте быстро и без промаха."

#. ja: 基礎訓練ヲ終了。<br>カタカタカタ……複合訓練ニ移行スル。
#. de: Grundausbildung beendet. \<klick><br>Wechsel zu erweitertem Trainingsprogramm.
#. fr: Fin de l'en<shy>traî<shy>ne<shy>ment de base. (cliquette) Bascule vers le programme d'en<shy>traî<shy>ne<shy>ment complexe.
msgctxt "InstanceContentTextData:35210:0:0"
msgid "That concludes your basic training. Commencing \\<crick-crack> advanced training regimen."
msgstr "Базовая тренировка завершена.<br>Начинаю \\<скрежет> продвинутую тренировку."

#. ja: 常ニ冷静カツ適切ナ対処ヲ……。
#. de: Jedes Problem hat eine rationale Lösung.
#. fr: À chaque problème sa solution rationnelle et pertinente.
msgctxt "InstanceContentTextData:35211:0:0"
msgid "Remain calm and collected, no matter your circumstances."
msgstr "Сохраняйте спокойствие и хладнокровие, что бы ни случилось."

#. ja: 日々ノ鍛錬ガ、己ノ命ヲ救ウト心得ヨ……。
#. de: Tägliches Training sichert das Überleben.
#. fr: Considérez votre en<shy>traî<shy>ne<shy>ment quotidien comme un gage de survie.
msgctxt "InstanceContentTextData:35212:0:0"
msgid "Remember─you must hone your skills daily. It will be key to your survival."
msgstr "Запомните: оттачивать навыки нужно каждый день. Это залог выживания."

#. ja: カタカタカタ……戦闘評価、第十二階位。<br>ソノ実力、最低位妖異ノ如シト心得ヨ……。
#. de: \<klick> Bewertung abgeschlossen: Rang 12.<nbsp>Genauso schwach wie das niedrigste Nichtswesen.
#. fr: (cliquette) Évaluation terminée. Palier douze atteint. Vous êtes aussi faible que la lie du néant...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35213:0:0"
msgid "\\<creak> Regimen complete. Evaluation ranking: 12.<br>Not even the lowest order of voidsent would be daunted by such meager strength."
msgstr "\\<скрип> Тренировка завершена. Оценка: 12-й ранг.<br>Даже низшие пустозёмы не испугались бы такой жалкой силы."

#. ja: カタカタカタ……戦闘評価、第九階位。<br>基礎鍛錬ヲ続ケ、ヨリ上位ノ階位ヲ目指スベシ……。
#. de: \<klick> Bewertung abgeschlossen: Rang 9.<nbsp>Arbeite an deinen Grundlagen und strebe nach Besserem.
#. fr: (cliquette) Évaluation terminée. Palier neuf atteint. Travaillez vos fondamentaux et visez les paliers supérieurs.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35214:0:0"
msgid "\\<creak> Regimen complete. Evaluation ranking: 9.<br>Your mastery of fundamentals will carry you far. Continue your training and seek ever greater heights."
msgstr "\\<скрип> Тренировка завершена. Оценка: 9-й ранг.<br>Прочные основы помогут вам далеко продвинуться. Продолжайте тренироваться и стремитесь к новым вершинам."

#. ja: カタカタカタ……戦闘評価、第七階位。<br>マズマズノ記録……戦士級妖異ニモ劣ラヌト、認メヨウ……。
#. de: \<klick> Bewertung abgeschlossen: Rang 7.<nbsp>Ein gutes Ergebnis. So stark wie Nichtswesen vom Rang eines Kriegers.
#. fr: (cliquette) Évaluation terminée. Palier sept atteint. Un bon résultat. Vous rivalisez avec les créatures du rang de guerrier.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35215:0:0"
msgid "\\<creak> Regimen complete. Evaluation ranking: 7.<br>A respectable performance. Such strength would prove a match for even warrior-class voidsent."
msgstr "\\<скрип> Тренировка завершена. Оценка: 7-й ранг.<br>Достойный результат. Вы вполне можете дать отпор пустозёмам ранга воина."

#. ja: カタカタカタ……戦闘評価、第五階位。<br>騎士級ノ妖異ニ伍スル、実力ト認定スル……。
#. de: \<klick> Bewertung abgeschlossen: Rang 5.<nbsp>So stark wie Nichtswesen der Ritterklasse.
#. fr: (cliquette) Évaluation terminée. Palier cinq atteint. Vous rivalisez avec les créatures du rang de chevalier.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35216:0:0"
msgid "\\<creak> Regimen complete. Evaluation ranking: 5.<br>A commendable performance. Such strength would prove a match for even knight-class voidsent."
msgstr "\\<скрип> Тренировка завершена. Оценка: 5-й ранг.<br>Похвальный результат. Вы вполне можете дать отпор пустозёмам ранга рыцаря."

#. ja: カタカタカタ……戦闘評価、第三階位。<br>生前ノ「がらてあ」ニ、匹敵スル実力ト認メヨウ……。
#. de: \<klick> Bewertung abgeschlossen: Rang 3.<nbsp>Überleben gegen Galatea wahrscheinlich.
#. fr: (cliquette) Évaluation terminée. Palier trois atteint. Vous auriez rivalisé avec Galatea de son vivant.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35217:0:0"
msgid "\\<creak> Regimen complete. Evaluation ranking: 3.<br>A spectacular performance. Such strength might even prove a match for Galatea herself were she still alive."
msgstr "\\<скрип> Тренировка завершена. Оценка: 3-й ранг.<br>Блестящий результат. Даже Галатея при жизни могла бы стать вам ровней."

#. ja: カタカタカタ……戦闘評価、第二階位。<br>コノ記録、「るーるす」様ノミガ達成セシ偉業ナリ……。
#. de: \<klick> Bewertung abgeschlossen: Rang 2.<nbsp>Diesen Rang hat bisher nur Meister Rullus erreicht.
#. fr: (cliquette) Évaluation terminée. Palier deux atteint. Seul maître Lurus avait obtenu ce résultat avant vous.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35218:0:0"
msgid "\\<creak> Regimen complete. Evaluation ranking: 2.<br>Impossible... Only Rullus has achieved such a feat."
msgstr "\\<скрип> Тренировка завершена. Оценка: 2-й ранг.<br>Невероятно... Такого добивался лишь Руллус."

#. ja: カタカタカタ……戦闘評価、第一階位。<br>魔王級ノ妖異ニ、匹敵……ソノ力ハ、一族ノ誇リナリ……。
#. de: \<klick> Bewertung abgeschlossen: Rang 1.<nbsp>Genauso stark wie ein Nichtswesen der Königsklasse. Eine stolze Leistung.
#. fr: (cliquette) Évaluation terminée. Palier un atteint. Vous rivalisez avec les créatures du rang de roi... et ferez à n'en pas douter la fierté de notre clan.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35219:0:0"
msgid "\\<creak> Regimen complete. Evaluation ranking: 1.<br>Even the great rulers of voidsent would struggle to contend with such strength."
msgstr "\\<скрип> Тренировка завершена. Оценка: 1-й ранг.<br>Ваша сила может сравниться даже с владыками пустозёмов."

#. ja: カタカタカタ……戦闘評価、良好。<br>「どるしら」嬢ニ並ブ記録トハ、驚キダ……。
#. de: \<klick> Bewertung abgeschlossen: Exzellent.<nbsp>Genauso stark wie Drusilla. Beeindruckend.
#. fr: (cliquette) Évaluation terminée. Verdict<nbsp>: très honorable. Contre toute attente, vous avez fait aussi bien que Drusilla.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35220:0:0"
msgid "\\<creak> Regimen complete.<br>An equal to Drusilla. Extraordinary..."
msgstr "\\<скрип> Тренировка завершена.<br>Вы наравне с Друсиллой. Невероятно..."

#. ja: 雪獣の帝座への到達
#. de: Thron der Schneebestie erreichen
#. fr: Atteindre le Trône de la Bête des neiges
msgctxt "InstanceContentTextData:35221:0:0"
msgid "Arrive at the Silvan Throne"
msgstr "Добраться до Сильванского трона"

#. ja: 雪獣の帝座の突破
#. de: Thron der Schneebestie erobern
#. fr: Franchir le Trône de la Bête des neiges
msgctxt "InstanceContentTextData:35222:0:0"
msgid "Clear the Silvan Throne"
msgstr "Завершить испытание «Сильванский трон»"

#. ja: フォルム・メッソルムへの到達
#. de: Das Forum Messorem erreichen
#. fr: Atteindre Forum Messorem
msgctxt "InstanceContentTextData:35223:0:0"
msgid "Arrive in the forum messorum"
msgstr "Добраться до Форума Мессорум"

#. ja: フォルム・メッソルムの突破
#. de: Das Forum Messorem erobern
#. fr: Franchir Forum Messorem
msgctxt "InstanceContentTextData:35224:0:0"
msgid "Clear the forum messorum"
msgstr "Завершить испытание «Форум Мессорум»"

#. ja: 青炎の棘への到達
#. de: Die Erdseim-Dornen erreichen
#. fr: Atteindre les Épines céruléennes
msgctxt "InstanceContentTextData:35225:0:0"
msgid "Arrive in Deepspine"
msgstr "Добраться до Глубокого шипа"

#. ja: カイナッツォの撃破
#. de: Cagnazzo besiegen
#. fr: Vaincre Cagnazzo
msgctxt "InstanceContentTextData:35226:0:0"
msgid "Defeat Cagnazzo"
msgstr "Победить Каньядзо"

#. ja: 視界が悪いから、気をつけてくれよ！
#. de: Sei vorsichtig, man kann kaum etwas sehen!
#. fr: Faites gaffe là-haut, on n'y voit goutte<nbsp>!
msgctxt "InstanceContentTextData:35227:0:0"
msgid "Careful up there─you're not like to see much through the snow."
msgstr "Осторожнее там, в снегу почти ничего не видно!"

#. ja: 獣たちの気が立っていやがる……。<br>ここからはマンモスじゃ登れねぇから、歩いて行ってくれ！
#. de: Endlich haben wir etwas Ruhe. Jetzt runter vom Mammut und zu Fuß weiter!
#. fr: Enfin débarrassés de tous ces piafs... La route s'arrête ici. Continuez à pied, les amis<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35229:0:0"
msgid "Hopefully that's the last of those winged bastards...<br>I'm afraid this is as far as the mammoth'll go. You'll have to make it the rest of the way on foot."
msgstr "Надеюсь, с этими крылатыми ублюдками покончено...<br>Дальше на мамонте не проехать. Придётся идти пешком."

#. ja: これはまた、みなさんおそろいで。<br>ハッ……もしかして、私のファン？
#. de: Das ist eine ganz schöne Schar von Bewunderern. Hat jemand Bescheid gesagt, dass wir kommen?
#. fr: Tous mes fans sont venus m'encourager... Je n'ai pas le droit de les décevoir<nbsp>!
msgctxt "InstanceContentTextData:35300:0:0"
msgid "This is quite a crowd of admirers. Did someone send word we were coming?"
msgstr "Какая толпа поклонников! Кто-то предупредил их, что мы придём?"

#. ja: ホッホッホゥ！<br>久々にハッスルしますかな！
#. de: Ohoho! Sollen wir ein kleines Tänzchen wagen?
#. fr: Ho ho ho<nbsp>! C'est l'heure de faire un peu d'exercice<nbsp>!
msgctxt "InstanceContentTextData:35301:0:0"
msgid "Ohoho! Shall we do a little dance?"
msgstr "О-хо-хо! Ну что, потанцуем?"

#. ja: 私はみなさんを、エスコートしておきますぞ！
#. de: So viele Partner zur Auswahl!
#. fr: Laissez-moi vous escorter, tout le plaisir est pour moi<nbsp>!
msgctxt "InstanceContentTextData:35302:0:0"
msgid "So many partners to choose from!"
msgstr "Столько партнёров на выбор!"

#. ja: 誰もいなくなりましたぞ！<br>さあ、観念して出てきなさい！
#. de: Deine Lakaien wurden als unzureichend befunden!<br>Komm raus und stelle dich deinem Schicksal!
#. fr: Eh bien, où sont-ils tous passés<nbsp>? Ne me dites pas qu'ils abandonnent déjà<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35303:0:0"
msgid "Your lackeys were found lacking!<br>Come out and face your fate!"
msgstr "Ваши прихвостни оказались никчёмными!<br>Выходите и примите свою судьбу!"

#. ja: な、なんということだ……！<br>ええい、煩わしい息子の方を吹っ飛ばしてくれるッ！
#. de: Unverschämte Würmer!<br>Der Sohn wird als Erster sterben<nbsp>...
#. fr: Grrr... Bande de vermisseaux<nbsp>! D'ailleurs, je vais écrabouiller le fiston en premier<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35304:0:0"
msgid "Insolent worms!<br>The son will be the first to die..."
msgstr "Наглые черви!<br>Сын умрёт первым..."

#. ja: ワァーーーーーッ！<br>父上、何とかしてくださーーーーーい！
#. de: Mama!<br>Äh ... Papa! Wenn du so freundlich wärst!
#. fr: OUAaaaAAAAHhhhHHH<nbsp>!!! Mon petit papounet chéri, fais quelque chose, bon sang<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35305:0:0"
msgid "Mummy!<br>Er...Daddy! If you could be so kind!"
msgstr "Мамочка!<br>То есть... папочка! Будь так добр, помоги!"

#. ja: ミサイルをすべて壊しただとッ！？<br>ならば、残っていた魔導兵器を投入してやる！
#. de: Ihr habt meine Raketen überlebt!?<br>Dann erfreut euch an ein paar übrig gebliebenen Kriegsmaschinen!
#. fr: Vous avez survécu à mes missiles... mais vous n'échapperez pas à mes armes magitek<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35306:0:0"
msgid "You survived my missiles!?<br>Then enjoy some leftover warmachina!"
msgstr "Вы пережили мои ракеты!?<br>Тогда повеселитесь с оставшимися боевыми машинами!"

#. ja: ややっ、先ほどのみなさんより強そうですぞ！
#. de: Diese Gruppe scheint härter zu sein als die letzte!
#. fr: Mon flair infaillible m'indique que ceux-ci sont un peu plus forts que les précédents<nbsp>!
msgctxt "InstanceContentTextData:35307:0:0"
msgid "This seems a sturdier group than the last!"
msgstr "Похоже, эта группа покрепче предыдущей!"

#. ja: ホゥ！<br>なるほど、なかなか手応えがあるようですな！
#. de: Oho! Vielleicht überleben sie ja noch ein paar Hammerschläge mehr!
#. fr: Hooo<nbsp>! En effet, il me faudra leur asséner quelques coups de marteau sup<shy>plé<shy>men<shy>tai<shy>res<nbsp>!
msgctxt "InstanceContentTextData:35308:0:0"
msgid "Oho! They may indeed survive a few more taps of the hammer!"
msgstr "О-хо! Пожалуй, они выдержат ещё несколько ударов молота!"

#. ja: まさか、魔導兵器が全滅だと……！？<br>ええい、常識が通じぬなら、すべて吹っ飛ばしてくれるッ！
#. de: Meine Kriegsmaschinen<nbsp>... Wenn vernünftige Mittel versagen, dann sind unvernünftige Maßnahmen angebracht!
#. fr: Puisque vous semblez résister à tout... le moment est venu de sortir le grand jeu<nbsp>!
msgctxt "InstanceContentTextData:35309:0:0"
msgid "My warmachina... If reasonable means fail, then unreasonable measures are called for!"
msgstr "Мои боевые машины... Разумные меры не помогли? Тогда придётся действовать неразумно!"

#. ja: フム、おもしろい……。<br>息子よ下がっていなさい、私が受け止めてみせます。
#. de: Bleib zurück, Hildibrand.<br>Lass deinen alten Herrn das regeln.
#. fr: Ho hooo... Mets-toi à l'abri, mon Hildoudou. Ton papounet s'en charge<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35310:0:0"
msgid "Stand back, Hildibrand.<br>Let your old man handle this."
msgstr "Отойди, Хильдибранд.<br>Позволь старику самому с этим разобраться."

#. ja: かくなるうえは……<br>この新たな身体を得たワシが、直々に相手しよう！
#. de: Na schön<nbsp>...<br>Anscheinend muss ich euch selbst zerquetschen!
#. fr: Vous ne me laissez donc pas le choix... Je dois vous réduire en bouillie moi-même<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35311:0:0"
msgid "Very well...<br>It seems I must crush you myself!"
msgstr "Что ж...<br>Похоже, мне придётся самому вас раздавить!"

#. ja: ホッホッホゥ！<br>ようやく、真打のお出ましですな？
#. de: Ohohoho!<br>Hast du dich endlich entschieden, uns ernst zu nehmen?
#. fr: Ho ho ho<nbsp>! Les choses sérieuses commencent enfin, on dirait<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35312:0:0"
msgid "Ohohoho!<br>Finally decided to take us seriously, have you?"
msgstr "О-хо-хо-хо!<br>Наконец-то решили отнестись к нам всерьёз?"

#. ja: ルエイゲ殿！<br>もう許しませんぞ、覚悟なさい！
#. de: Mach dich bereit, für deine Verbrechen zu bezahlen!
#. fr: Vous allez payer pour vos crimes, Monsieur Gélule<nbsp>!
msgctxt "InstanceContentTextData:35313:0:0"
msgid "Prepare to pay for your crimes, Doctor!"
msgstr "Приготовьтесь ответить за свои преступления, доктор!"

#. ja: ハッハッハ！<br>蚊が止まったのかと思いましたぞ！
#. de: Hahaha!<br>Ich hatte schon schlimmere Mückenstiche!
#. fr: Ha ha ha<nbsp>! C'est qu'elles gratouillent, ces piqûres de moustique<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35314:0:0"
msgid "Hah hah hah!<br>I've had worse chigoe bites!"
msgstr "Ха-ха-ха!<br>Бывало, и укус чигуэ больнее!"

#. ja: フゥー！<br>なかなか、いい運動になりましたぞ！
#. de: Ah! Ich genieße ein leichtes Training!
#. fr: Pfiou<nbsp>! Ça fait du bien de bouger un peu<nbsp>!
msgctxt "InstanceContentTextData:35315:0:0"
msgid "Ah! I do enjoy some light exercise!"
msgstr "Ах! Как же я люблю лёгкую разминку!"

#. ja: こ、これが効かぬとは……<br>貴様はバケモノか……？
#. de: Was<nbsp>... Was für eine Art von Unhold bist du!?
#. fr: Q-quoi<nbsp>!? Mais d'où tu sors, toi<nbsp>!? D'une autre planète aussi<nbsp>!?
msgctxt "InstanceContentTextData:35316:0:0"
msgid "What...what manner of fiend are you!?"
msgstr "Ч-что... ты за чудовище такое!?"

#. ja: こ、これをかわすとは……<br>貴様はいったい、何者なのだ……？
#. de: Kein Sterblicher könnte solch einem Sperrfeuer entkommen<nbsp>...
#. fr: C'est impossible... Aucun mortel n'est capable de résister à un tel assaut<nbsp>!
msgctxt "InstanceContentTextData:35317:0:0"
msgid "No mortal man could avoid such a barrage..."
msgstr "Ни один смертный не смог бы уклониться от такого обстрела..."

#. ja: おや、何か落ちてきましたかな……？
#. de: Seltsam. Ich könnte schwören, ich hätte eine Schneeflocke abbekommen<nbsp>...
#. fr: Hmm<nbsp>? J'ai cru sentir un flocon de neige me tomber dessus...
msgctxt "InstanceContentTextData:35318:0:0"
msgid "Strange. I swear I felt a snowflake fall on me..."
msgstr "Странно. Клянусь, я почувствовал, как на меня упала снежинка..."

#. ja: アッハッハ！<br>ママの一撃に比べれば、大したことありませんぞ！
#. de: Hahaha!<br>Da schlägt ja Hildibrands Mutter härter zu!
#. fr: Ha ha ha<nbsp>! Pour votre gouverne, sachez que la maman de mon Hildoudou cogne plus fort que ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35319:0:0"
msgid "Hah hah hah!<br>Hildibrand's mother hits harder than that!"
msgstr "Ха-ха-ха!<br>Мать Хильдибранда бьёт сильнее!"

#. ja: むぅ……<br>落下位置を計算しなおすか……。
#. de: Ich<nbsp>... muss mich bei der Flugbahn verrechnet haben.
#. fr: Le point de chute n'était pas le bon, j'ai dû me tromper dans mes calculs...
msgctxt "InstanceContentTextData:35320:0:0"
msgid "I...must have miscalculated the trajectory."
msgstr "Я... должно быть, ошибся в расчётах траектории."

#. ja: こ、この親子……どうかしてるぞ……。
#. de: Die Hartnäckigkeit dieser Mandervilles<nbsp>...<br>Sie ist unnatürlich!
#. fr: Décidément, ces gentilhommes ont des muscles d'acier<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35321:0:0"
msgid "The hardiness of these Mandervilles, it's...<br>It's unnatural!"
msgstr "Живучесть этих Мандервиллей...<br>Это же неестественно!"

#. ja: わ、私は……しんし……じけん……？<br>アガガガガガガガガガ……。
#. de: Du bist fällig<nbsp>... Gentleman?<br>Ich fühle mich<nbsp>... benommen<nbsp>...
#. fr: J'aurai ta peau... gentilhomme... détective... Agagagagagagaga...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35322:0:0"
msgid "Is the case...inspecting mangentle?<br>I feel...woozy..."
msgstr "Это... дело... расследует джентль...мен?<br>Что-то... голова кружится..."

#. ja: う、うーん……<br>た、助かりましたぞ、父上……。
#. de: Vielen Dank, Vater<nbsp>...<br>Das hätte schlimmer ausgehen können.
#. fr: Merci, Papounet... Tu es le meilleur des papounets<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35323:0:0"
msgid "My thanks, Father...<br>That could have been worse."
msgstr "Благодарю, отец...<br>Могло быть и хуже."

#. ja: 息子ひとりでも……！？<br>親子そろって、バ、バケモノか？
#. de: Unmöglich!<br>Der Sohn ist so unzerbrechlich wie der Vater!
#. fr: QUOIII<nbsp>!?? Le fils est un extra-terrestre aussi, c'est ça<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35324:0:0"
msgid "Impossible!<br>The son is as unbreakable as the father!"
msgstr "Невозможно!<br>Сын такой же несокрушимый, как отец!"

#. ja: フォーウ！<br>雷気のおかげで、血行が良くなりましたぞ！
#. de: Ah, ein leichter Stromstoß, der den Kreislauf anregt!<br>Erfrischend!
#. fr: OOOOH<nbsp>!! Rien ne vaut une décharge électrique pour donner un coup de fouet à la circulation sanguine<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35325:0:0"
msgid "Ah, a mild zap to improve the circulation!<br>Invigorating!"
msgstr "А-а, лёгкий разряд для улучшения кровообращения!<br>Бодрит!"

#. ja: ホッホゥ！<br>せっかくなら、一発くらい喰らっておきたかったですな！
#. de: Das war aufregend!<br>Vielleicht hätte ich ihn auf mich wirken lassen sollen.
#. fr: Ho ho<nbsp>! Cette attaque avait l'air goûtue, j'aurais dû la laisser me toucher<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35326:0:0"
msgid "That was exciting!<br>Mayhap I should have let it hit me."
msgstr "Вот это было здорово!<br>Пожалуй, надо было позволить ему попасть в меня."

#. ja: くそっ、雷力が足りなかったか……！？
#. de: Wie ist das möglich?! So viel Kraft hätte ihm die Zähne aus dem Schädel rasseln lassen müssen!
#. fr: Mais comment est-ce possiiiiible<nbsp>!? J'aurais dû lui griller la cervelle en un éclair<nbsp>!
msgctxt "InstanceContentTextData:35327:0:0"
msgid "How!? That much power should have rattled the teeth from his skull!"
msgstr "Как!? Такой силы хватило бы, чтобы выбить ему зубы!"

#. ja: ま、まるで……遊んでいるようではないか……！？
#. de: Spielen wir hier ein Spiel!?<br><i>Genießt</i> er das etwa!?
#. fr: Il prend tout... à la rigolade... Il est pas humain...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:35328:0:0"
msgid "Are we playing a game here!?<br>Is he <i>enjoying</i> this!?"
msgstr "Это что, игра какая-то!?<br>Ему это <i>нравится</i>!?"

#. ja: 無茶苦茶なやつらめ、こちらの計画がパーだ！
#. de: Ihr lästiges Ungeziefer!<br>Meine Pläne liegen in Trümmern!
#. fr: Bande d'infâmes pourceaux<nbsp>! À cause de vous, mon plan est à l'eau<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35329:0:0"
msgid "You aggravating vermin!<br>My plans are in ruins!"
msgstr "Ах вы, мерзкие паразиты!<br>Вы разрушили все мои планы!"

#. ja: ややっ、ルエイゲ殿の動きが止まりましたぞ……！<br>父上、今こそ大技のチャンスです！
#. de: Seine Deckung ist weit offen!<br>Nutzen wir die Gelegenheit!
#. fr: Monsieur Gélule a enfin arrêté de gesticuler<nbsp>! C'est le moment de lui porter le coup de grâce<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35330:0:0"
msgid "The doctor leaves himself wide open!<br>Let us seize the advantage!"
msgstr "Доктор совсем не защищается!<br>Надо воспользоваться моментом!"

#. ja: 使うまいと思っていた秘技だが……<br>これでも喰らえッ！
#. de: Dieser Schachzug war für jemand anders gedacht, aber ihr habt euch meinen Zorn verdient!
#. fr: Je ne pensais pas avoir à utiliser ma botte secrète... Eh bien, je me trompais<nbsp>! PRENEZ ÇAAA<nbsp>!!
msgctxt "InstanceContentTextData:35331:0:0"
msgid "This move was meant for another, but you've earned my ire!"
msgstr "Этот приём я берег для другого, но вы заслужили мой гнев!"

#. ja: まだ、奥の手は残っているぞ！<br>人ならば、この雷力には耐えられまいッ！
#. de: Ich habe noch mehr Überraschungen auf Lager!<br>Diese wird euch vielleicht schockieren!
#. fr: Ne vous inquiétez pas pour moi, j'ai encore des ressources, et des plus électriques<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35332:0:0"
msgid "I have more surprises!<br>This one may shock you!"
msgstr "У меня припасено ещё кое-что!<br>Вас это может шокировать!"

#. ja: 雇われのゴロツキをせん滅せよ！
#. de: Besiege die gedungenen Schläger!
#. fr: Éliminer les pillards stipendiés
msgctxt "InstanceContentTextData:35333:0:0"
msgid "Defeat the hired thugs!"
msgstr "Победите наёмных головорезов!"

#. ja: ミサイルを破壊せよ！
#. de: Zerstöre die Raketen!
#. fr: Détruire les missiles
msgctxt "InstanceContentTextData:35334:0:0"
msgid "Destroy the missiles!"
msgstr "Уничтожьте ракеты!"

#. ja: 魔導兵器をせん滅せよ！
#. de: Besiege die Kriegsmaschinen!
#. fr: Éliminer les armes magitek
msgctxt "InstanceContentTextData:35335:0:0"
msgid "Defeat the warmachina!"
msgstr "Победите боевые машины!"

#. ja: ミサイルを受け止めよ！
#. de: Neutralisiere die Raketen!
#. fr: Neutraliser les missiles
msgctxt "InstanceContentTextData:35336:0:0"
msgid "Neutralize the missiles!"
msgstr "Обезвредьте ракеты!"

#. ja: スーパールゲイエを倒せ！
#. de: Besiege Suprae-Lugae!
#. fr: Vaincre Super Lugae
msgctxt "InstanceContentTextData:35337:0:0"
msgid "Defeat Suprae-Lugae!"
msgstr "Победите Супраэ Лугаэ!"

#. ja: リミットブレイクを使え！
#. de: Führe den Limitrausch aus!
#. fr: Utiliser la Transcendance
msgctxt "InstanceContentTextData:35338:0:0"
msgid "Execute limit break!"
msgstr "Примените лимитный прорыв!"

#. ja: ホッホゥ！<br>この程度では、私は止められませんぞ！
#. de: Ein amüsanter Zeitvertreib, aber du musst dir schon mehr Mühe geben.
#. fr: Ho ho<nbsp>! Il va vous falloir un peu plus que ça, Gélule<nbsp>!
msgctxt "InstanceContentTextData:35339:0:0"
msgid "An amusing diversion, but you'll need to do better than that."
msgstr "Забавная разминка, но постараться придётся получше."

#. ja: 反復横跳びで、すべて受け止めただとッ！？
#. de: Du hast sie alle aufgehalten?<br>Mit einem <i>Seitenschritt</i>?
#. fr: Il les a tous encaissés... en virevoltant de gauche à droite...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:35340:0:0"
msgid "You stopped them all?<br>By <i>sidestepping</i>!?"
msgstr "Ты остановил их всех?<br>Просто <i>отшагнув в сторону</i>!?"

#. ja: こうなれば、最後の手段だ……<br>ワシの全エネルギーを使って葬ってやるぅ！
#. de: Ihr habt mich dazu gezwungen<nbsp>...<br>Ich werde diesen Ort über euren Köpfen zum Einsturz bringen!
#. fr: Très bien, vous l'aurez voulu... Je vais mettre toute mon énergie dans cette ultime attaque qui vous enverra dans la tombe<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35341:0:0"
msgid "You've forced my hand...<br>I'll bring this place down on your heads!"
msgstr "Вы сами вынудили меня...<br>Я обрушу это место вам на головы!"

#. ja: ギャーーー！<br>何でまたワシに当たる！？
#. de: Waaah! Warum treffen sie denn <i>mich</i>!?
#. fr: Gyaaah<nbsp>!! Mais pourquoi ils reviennent encore tous sur moiiii<nbsp>!??
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:35342:0:0"
msgid "Gyaaah! Why are they hitting <i>me</i>!?"
msgstr "А-а-а! Почему они попали <i>в меня</i>!?"

#. ja: 接続良好、生体「アルトリウス」の支配は完璧です。<br>戦闘開始、侵入者を排除します。
#. de: Optimale Verbindung zu Organismus „Artorius“. Intention: Vernichtung jeglicher Eindringlinge. Kampf wird initiiert.
#. fr: Contrôle mental du sujet “Artorius”<nbsp>: total...<br>Mode combat activé... Élimination imminente.
msgctxt "InstanceContentTextData:35400:0:0"
msgid "Connection to biological organism Artorius stable. Initiate elimination protocol."
msgstr "Связь с биологическим организмом Арториус стабильна. Запускаю протокол уничтожения."

#. ja: 「次元刀」を投入。<br>扱いカタは覚え、オボえテ……オ前から……ワたシは……。
#. de: Lade „Dimensionsklinge“. Anwendungsmodu...<br>Ich<nbsp>... erinnere mi...
#. fr: Invocation de la lame dimensionnelle...<br>Son maniement... Je me souviens... Tu m'as appris...
msgctxt "InstanceContentTextData:35401:0:0"
msgid "Deploying Dimensional Bla─ Bzzzt... This...sword... I remember...you..."
msgstr "Развёртывание Меча измерений... Дззз... Этот... меч... Я помню... тебя..."

#. ja: 「次元刀」剣技を実行。<br>オリジナルと同等の出力を維持……。
#. de: Starte Sequenz „Dimensionsklinge“. Leistungsfähigkeit des Originals wird äquivalent simuliert.
#. fr: Maniement de la lame dimensionnelle...<br>Niveau de maîtrise conforme aux données de l'original...
msgctxt "InstanceContentTextData:35402:0:0"
msgid "Deploying Dimensional Blade. Power output comparable to original weapon."
msgstr "Развёртывание Меча измерений. Мощность сопоставима с оригинальным оружием."

#. ja: ティターン……我ガ友よ……。<br>ワたシハ……アル……エク、ス、カリバー！
#. de: Phlegethon<nbsp>... a-a-alter Freund. Ich<nbsp>... In mir<nbsp>... E-Excalibur!
#. fr: Phlégéton... Mon ami...<br>C'est moi, Ar... Ex... calibur<nbsp>!
msgctxt "InstanceContentTextData:35403:0:0"
msgid "Phlegethon...dear friend... I...am...here."
msgstr "Флегетон... мой дорогой друг... Я... здесь..."

#. ja: 属性エーテル出力増大。<br>これより「サーマルディバイダー」を実行します……。
#. de: Stimuliere elementaren Ätherausstoß zur Initiierung von Sequenz „Thermal-Spalter“.
#. fr: Charge en éther élémentaire optimale...<br>Utilisation du séparateur thermique.
msgctxt "InstanceContentTextData:35404:0:0"
msgid "Maximizing aether output in preparation for thermal divide..."
msgstr "Максимально увеличиваю выход эфира для подготовки к термическому разделению..."

#. ja: 属性エーテル全解放。<br>対消滅波動「パラドクス」照射……！
#. de: Elementarer Ätherausstoß abgeschlossen. Überleitung zu Strahlungssequenz „Paradoxum“.
#. fr: Purge totale de l'éther élémentaire...<br>Rayon exterminateur... Nom de code<nbsp>: “Paradoxe”...
msgctxt "InstanceContentTextData:35405:0:0"
msgid "All aether cores free. Initiate paradox protocol─releasing extinction waves!"
msgstr "Все эфирные ядра освобождены. Запускаю протокол «Парадокс» — высвобождаю волны уничтожения!"

#. ja: 生体の損傷率が規定値を超過しました。<br>まもなく再起不能となりりりり殺セ……このまま……！
#. de: Schaden am Organismus überschreitet empfohlene Werte. Reanimation bei weitere...<br>T-Töte<nbsp>... mich<nbsp>...!
#. fr: Les avaries du sujet dépassent le seuil de tolérance...<br>Arrêt des fonctions vitales imminent... T-t-t-tuez... Tuez-moi<nbsp>!
msgctxt "InstanceContentTextData:35406:0:0"
msgid "Damage to biological organism exceeds safe levels. Regenerative processes impeded─ Bzzzt... Release...me..."
msgstr "Повреждения организма превысили безопасный предел. Восстановление нарушено... Дззз... Освободи... меня..."

#. ja: 侵入者、なおも存命中。<br>アラグ帝国に仇なす愚民は、粛清します。
#. de: Störende Präsenz nach wie vor bestätigt. Wer sich dem Reich widersetzt, darf mit keiner Gnade rechnen.
#. fr: Echec de l'élimination...<br>Ceux qui menacent l'empire d'Allag doivent être assujettis.
msgctxt "InstanceContentTextData:35407:0:0"
msgid "Intruders persist. Enemies of the empire must be purged."
msgstr "Нарушители всё ещё живы. Врагов империи следует уничтожить."

#. ja: 端末を生成……一斉攻撃準備…………。
#. de: Modulgenerierung gestartet. Initiiere Synchronschlag.
#. fr: Chargement du module stratégique... Démarrage de l'assaut...
msgctxt "InstanceContentTextData:35408:0:0"
msgid "Generating attack module. Initiate synchronous strike."
msgstr "Создаю модуль атаки. Запускаю синхронный удар."

#. ja: パンひとつとはいえ、契約だからな。<key>ここから先は通すわけにはいかない。
#. de: Was auch passiert, ich halte mein Wort.<key>Nicht mehr und nicht weniger.
#. fr: Même s'il ne s'agit que d'une brioche, une dette reste une dette.<key>Je dois absolument empêcher ces monstres de passer.
#. macro: <key> — a key prompt; its runtime meaning is not established (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:35500:0:0"
msgid "A deal is a deal...<key>I cannot let you pass."
msgstr "Сделка есть сделка...<key>Я не могу вас пропустить."

#. ja: ココ、新鮮なエーテルがいっぱいダ……！<br>まずは、お前カラ！
#. de: So viel frischer Äther!
#. fr: Il y a tant d'éther à déguster par ici... à commencer par le tien<nbsp>!
msgctxt "InstanceContentTextData:35502:0:0"
msgid "Ah, this land brims with life... Ripe for the harvest!"
msgstr "Ах, эта земля полна жизни... Самое время поживиться!"

#. ja: いよいよ厳しいか……。
#. de: Das wird kein Spaziergang ...
#. fr: Je commence à fatiguer...
msgctxt "InstanceContentTextData:35503:0:0"
msgid "Not good..."
msgstr "Дело плохо..."

#. ja: シブトイな……。<br>だが、コレでどうだ！？
#. de: Ts, wie gefällt dir das?
#. fr: Tu es coriace... mais que dis-tu de ça<nbsp>?
msgctxt "InstanceContentTextData:35504:0:0"
msgid "Such insolence! I will not be denied!"
msgstr "Какая дерзость! Я не отступлю!"

#. ja: コレでオワリだ！　私の糧となれェ！！
#. de: Dich werde ich fressen!
#. fr: Je vais t'achever... puis te dévorer<nbsp>!
msgctxt "InstanceContentTextData:35505:0:0"
msgid "And now you're mine!"
msgstr "Ну всё, теперь ты мой!"

#. ja: ここまで……か……。
#. de: Ich fürchte, es ist aus ...
#. fr: Je vais pas m'en sortir...
msgctxt "InstanceContentTextData:35506:0:0"
msgid "I can't..."
msgstr "Я не..."

#. ja: 間に合ってよかった。<br>もうひと踏ん張りできるかい？
#. de: Das war haarscharf. Hältst du noch eine Weile durch?
#. fr: Heu<shy>reu<shy>se<shy>ment qu'on arrive à temps. Ça va, tu tiens le coup<nbsp>?
msgctxt "InstanceContentTextData:35507:0:0"
msgid "Thank goodness we're not too late. Can you still fight?"
msgstr "Хорошо, что мы успели. Ещё можешь сражаться?"

#. ja: ……手間をかける。
#. de: Verzeiht die Nachlässigkeit ...
#. fr: Merci, c'était pas la peine.
msgctxt "InstanceContentTextData:35508:0:0"
msgid "Aye..."
msgstr "Да..."

#. ja: クヒヘヘヘ……エサだ、新鮮なエサだぁ！<br>オマエたち、喰らいつくすがいい！
#. de: Ah, frische Nahrung! Das wird ein Festmahl!
#. fr: Kéhéhéhé... De la bonne nourriture bien fraîche... Je vais m'en mettre plein la panse<nbsp>!
msgctxt "InstanceContentTextData:35509:0:0"
msgid "Hah hah hah! Yes, more mortals come to slaughter!"
msgstr "Ха-ха-ха! Ещё смертные пришли на убой!"

#. ja: 敵は強大……。<br>その上、私は疲弊している。<key>これでは、お前たちの足を引っ張ることに……。
#. de: Der Feind ist zu stark ... Ich kann nichts mehr gegen ihn ausrichten.<key>Und noch mehr will ich euch in all das nicht hineinziehen<nbsp>...
#. fr: Ce monstre est surpuissant... et je suis épuisée...<key>Dans ces conditions, je risque de vous gêner plus qu'autre chose...
#. macro: <key> — a key prompt; its runtime meaning is not established (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:35510:0:0"
msgid "My strength is spent...<key>I'll only get in your way."
msgstr "Я совсем выбилась из сил...<key>Я буду только мешать."

#. ja: ごちゃごちゃ言わないの！<br>協力して戦えば、きっと勝てるわ！
#. de: Schluss mit dem Gejammer! Zusammen schaffen wir es!
#. fr: C'est pas le moment de baisser les bras<nbsp>! On peut s'en sortir si on lutte tous ensemble<nbsp>!
msgctxt "InstanceContentTextData:35512:0:0"
msgid "Chin up! We'll get through this together!"
msgstr "Не раскисай! Вместе мы справимся!"

#. ja: 手分けして対処するんだ！
#. de: Gemeinsam überstehen wir es!
#. fr: Occupons-nous-en séparément<nbsp>!
msgctxt "InstanceContentTextData:35513:0:0"
msgid "Split up!"
msgstr "Разделимся!"

#. ja: ならば、こちらは私が受け持とう。
#. de: Ich halte hier die Stellung!
#. fr: Dans ce cas, je me charge de ce côté-ci.
msgctxt "InstanceContentTextData:35514:0:0"
msgid "Stay sharp!"
msgstr "Не теряйте бдительности!"

#. ja: 狙われてるわよ！注意して！
#. de: Wir müssen da zusammen durch!
#. fr: Attention, tu es visée<nbsp>!
msgctxt "InstanceContentTextData:35515:0:0"
msgid "Watch out!"
msgstr "Берегись!"

#. ja: 協力……か。
#. de: Zusammen, hm ...?
#. fr: Si on lutte... tous ensemble...<nbsp>?
msgctxt "InstanceContentTextData:35516:0:0"
msgid "Not finished yet!"
msgstr "Ещё не всё!"

#. ja: 弱らせてカラ、エーテルをすすってヤルゥ！
#. de: Ich habe Hunger. Gib mir deinen Äther!
#. fr: Quand vous serez à bout de forces... je siroterai votre éther<nbsp>!
msgctxt "InstanceContentTextData:35517:0:0"
msgid "I will enjoy draining your aether, watching as the life dims in your eyes."
msgstr "Я с удовольствием выпью ваш эфир, глядя, как гаснет жизнь в ваших глазах."

#. ja: 皆、集まって耐えるんだ！<br>強烈な攻撃が来るぞ！
#. de: Kommt alle zusammen, er bereitet einen Angriff vor!
#. fr: La prochaine attaque sera puissante<nbsp>! Vite, rassemblons-nous<nbsp>!
msgctxt "InstanceContentTextData:35518:0:0"
msgid "We must weather this together!"
msgstr "Нужно держаться вместе!"

#. ja: ムダな抵抗ヲ！！
#. de: Widerstand ist zwecklos!
#. fr: Inutile de résister<nbsp>!
msgctxt "InstanceContentTextData:35519:0:0"
msgid "Resistance is futile!"
msgstr "Сопротивление бесполезно!"

#. ja: ガァアア！　エサの分際で生意気ナ！！<br>喰えぬのナラ、灰にしてヤル！
#. de: Muaaa! Wehrt euch nicht! Ihr seid Nahrung!
#. fr: Raaah<nbsp>! Depuis quand la bouffe se rebelle<nbsp>!? Je vais vous réduire en cendres pour la peine<nbsp>!
msgctxt "InstanceContentTextData:35520:0:0"
msgid "If you would deny me my feast, then begone! To ashes with you!"
msgstr "Раз не желаете стать моей добычей — сгиньте! Я обращу вас в пепел!"

#. ja: オマエたち、足止めシテロ！
#. de: Haltet sie auf!
#. fr: Occupez-les, vous autres<nbsp>!
msgctxt "InstanceContentTextData:35521:0:0"
msgid "Do not let them get away!"
msgstr "Не дайте им сбежать!"

#. ja: 消し飛んでシマエッ！
#. de: Weg mit euch!
#. fr: Allez au diable<nbsp>!
msgctxt "InstanceContentTextData:35522:0:0"
msgid "Die! Die! DIE!!!"
msgstr "Умрите! Умрите! УМРИТЕ!!!"

#. ja: これほどの妖異が、こちら側に入り込んでいたとは……。
#. de: Wie konnten so viele von ihnen auf diese Seite gelangen?
#. fr: Ma parole, c'est une véritable armée...
msgctxt "InstanceContentTextData:35523:0:0"
msgid "This has gone on long enough!"
msgstr "С меня хватит!"

#. ja: ならば……！この力で排除する！
#. de: Du bist mir nicht gewachsen!
#. fr: Disparaissez<nbsp>!
msgctxt "InstanceContentTextData:35524:0:0"
msgid "I will finish it. Now!"
msgstr "Покончим с этим. Сейчас же!"

#. ja: それなら、私たちはゼロを支援するわよ！
#. de: Zero, wir helfen dir!
#. fr: Vas-y, on est tous avec toi<nbsp>!
msgctxt "InstanceContentTextData:35525:0:0"
msgid "Let's buy her some time!"
msgstr "Надо выиграть для неё немного времени!"

#. ja: ありったけをくらわせてやる！
#. de: Zeit, ihn für seine Taten büßen zu lassen!
#. fr: Je vais leur sortir le grand jeu<nbsp>!
msgctxt "InstanceContentTextData:35526:0:0"
msgid "I am your end!"
msgstr "Я вас прикончу!"

#. ja: ピギェエエエエ！<br>来るナ！来るナァーッ！
#. de: Gyaaa! Kommt nicht näher!
#. fr: Gyeeeeeh<nbsp>! N-ne m'approchez pas, vermines<nbsp>!
msgctxt "InstanceContentTextData:35527:0:0"
msgid "No! NO! Why won't you die!?"
msgstr "Нет! НЕТ! Почему вы не сдохнете?!"

#. ja: 妖異の群れをせん滅せよ！
#. de: Alle Nichts<shy>gesand<shy>ten besiegen
#. fr: Éliminer la horde du néant
msgctxt "InstanceContentTextData:35528:0:0"
msgid "Defeat the voidsent horde"
msgstr "Уничтожьте орду чудовищ из Пустоты"

#. ja: 仲間と協力し、妖異の群れをせん滅せよ！
#. de: Gemeinsam alle Nichts<shy>gesand<shy>ten besiegen
#. fr: Éliminer la horde du néant avec l'aide de vos alliés
msgctxt "InstanceContentTextData:35529:0:0"
msgid "Coordinate with your comrades and defeat the voidsent horde"
msgstr "Объединитесь с товарищами и уничтожьте орду чудовищ из Пустоты"

#. ja: 大技の発動まで、ゼロを妖異から護れ！
#. de: Zero beschützen, bis sie zurückschlagen kann
#. fr: Protéger Zero jusqu'à ce qu'elle soit prête à attaquer
msgctxt "InstanceContentTextData:35530:0:0"
msgid "Protect Zero until she is ready to retaliate"
msgstr "Защитите Зеро, пока она не будет готова нанести ответный удар"

#. ja: アンドロマリウスを倒せ！
#. de: Andromalius besiegen
#. fr: Vaincre Andromalius
msgctxt "InstanceContentTextData:35531:0:0"
msgid "Defeat Andromalius"
msgstr "Победите Андромалиуса"

#. ja: 攻撃を受けたことで、ゼロの集中力が削がれている……
#. de: Zeros Konzentration wird durch Angriffe gestört!
#. fr: Zero est attaquée et ne peut se concentrer...
msgctxt "InstanceContentTextData:35533:0:0"
msgid "Zero's concentration has been broken."
msgstr "Зеро потеряла концентрацию."

#. ja: ◎×■♭！<br>◎◎#……侵入者……排、除！！
#. de: ◎×■♭!<br>◎◎#<nbsp>... EinDriNGlinGe! VerNIchten! vErniChtEn!
#. fr: ◎×■♭!<br>◎◎#... Intrus... Ex... termination<nbsp>!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35600:0:0"
msgid "◎×■♭!<br>◎◎#...ENEmY! DEsTroY! DeSTRoy!"
msgstr "◎×■♭!<br>◎◎#...ВРАГ! УНИЧТОЖИТЬ! УНИЧТОЖИТЬ!"

#. ja: ◎△〇×□！<br>×#▼△……地雷、隊……起キ、ロ！
#. de: ◎△〇×□!<br>×#▼△<nbsp>... AufWachEn! aUfwAChen!
#. fr: ◎△〇×□!<br>×#▼△... Mines... Soldats... Debout<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35601:0:0"
msgid "◎△〇×□!<br>×#▼△...DEplOY...MINes!"
msgstr "◎△〇×□!<br>×#▼△...РАЗВЁРТЫВАНИЕ...МИН!"

#. ja: ××●×◎！！<br>怠ケ、絶、許……起キ、ロ！！
#. de: ××●×◎!<br>FauLEnzER! SofORt auFWachEn!
#. fr: ××●×◎!!<br>Tire... Au... Flanc... Debout<nbsp>!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35602:0:0"
msgid "××●×◎!!<br>NO...MeRCY...ExPLOde! EXplODe!"
msgstr "××●×◎!!<br>ПОЩАДЫ...НЕ БУДЕТ...ВЗОРВАТЬ! ВЗОРВАТЬ!"

#. ja: ♪○×◎◎！？<br>侵入者、生、存……再、攻撃ヲ、実行……！
#. de: ♪○×◎◎!?<br>EinDRingLingE! AUSLÖSCHEN!
#. fr: ♪○×◎◎!?<br>Extermination... Négative... Relance... Assaut...<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35603:0:0"
msgid "♪○×◎◎!?<br>ENEmIEs...DeTECted...AtTacK! ATTaCK!"
msgstr "♪○×◎◎!?<br>ВРАГИ...ОБНАРУЖЕНЫ...АТАКА! АТАКА!"

#. ja: 私は四天王が一人、火のルビカンテ。<br>正々堂々、戦おうぞ！
#. de: Gestatten, Rubicante, der Fürst des Feuers.
#. fr: Je suis Rubicante, maître du feu et bras droit du seigneur Golbez. Battons-nous à la loyale<nbsp>!
msgctxt "InstanceContentTextData:35700:0:0"
msgid "The archfiend of fire has no equal!"
msgstr "Мне нет равных среди архидьяволов огня!"

#. ja: 確かに、自信を持てるほどの強さだ。
#. de: Ihr seid talentierte Kämpfer.
#. fr: Votre force est digne d'éloges.
msgctxt "InstanceContentTextData:35701:0:0"
msgid "You've strength worthy enough of pride."
msgstr "Ваша сила достойна гордости."

#. ja: 私が全力を出すに値するか……。
#. de: Vielleicht verdient ihr es sogar, meine wahre Kraft zu sehen.
#. fr: Vous méritez un adversaire à votre hauteur.
msgctxt "InstanceContentTextData:35702:0:0"
msgid "But will it be enough?"
msgstr "Но хватит ли её?"

#. ja: すべてを、解き放つ……！
#. de: Nun denn ...
#. fr: Permettez que je déploie la pleine étendue de ma puissance<nbsp>!
msgctxt "InstanceContentTextData:35703:0:0"
msgid "I am one with the flames..."
msgstr "Я един с пламенем..."

#. ja: グオォォォッッッ！
#. de: Uuoooooh!
#. fr: Huuugnnnaaaaaargh<nbsp>!!
msgctxt "InstanceContentTextData:35704:0:0"
msgid "Yaaaaaargh!"
msgstr "А-а-а-а!"

#. ja: この姿を見せるのは、お前たちが初めてだ……！
#. de: Ihr seid die ersten, die diese Gestalt zu Gesicht bekommen.
#. fr: Rendez-vous compte, vous êtes les tout premiers à m'admirer sous cette forme<nbsp>!
msgctxt "InstanceContentTextData:35705:0:0"
msgid "You are the first to behold this form."
msgstr "Вы первые, кто увидел меня в этом облике."

#. ja: 集え、煉獄の魔法陣よ。
#. de: Zu mir, lodernde Flammen!
#. fr: Venez à moi, esprits obscurs...
msgctxt "InstanceContentTextData:35708:0:0"
msgid "Flames to lick at your heels."
msgstr "Пламя будет жечь вам пятки."

#. ja: 炎の魔導を極めし力……見せてやろう。
#. de: Das Feuer gehorcht allein mir!
#. fr: Préparez-vous à goûter aux flammes infernales...
msgctxt "InstanceContentTextData:35709:0:0"
msgid "The glory of fire!"
msgstr "Узрите величие огня!"

#. ja: 素晴らしい……魔力が溢れ出るようだッ！
#. de: Dieses Gefühl ... mein Körper birst vor Kraft!
#. fr: Comme c'est grisant... Je sens l'éther emplir tout mon être<nbsp>!
msgctxt "InstanceContentTextData:35710:0:0"
msgid "So brightly do the flames burn!"
msgstr "Как ярко пылает пламя!"

#. ja: この攻撃、耐えられはしまいッ！
#. de: Versucht gar nicht erst zu fliehen!
#. fr: Vous n'avez aucune chance de survivre à ça<nbsp>!
msgctxt "InstanceContentTextData:35711:0:0"
msgid "To ashes with you!"
msgstr "Вам не уцелеть!"

#. ja: 見るがいい、この姿の神髄を……
#. de: Diese Gestalt kann weit mehr, als das Feuer zu bändigen!
#. fr: Contemplez la quintessence de mon être<nbsp>!
msgctxt "InstanceContentTextData:35712:0:0"
msgid "Look now on my essence made pure..."
msgstr "Узрите мою истинную сущность..."

#. ja: すべてを破壊するッ！
#. de: Werdet Zeugen der ultimativen Zerstörung!
#. fr: Je vais tout détruire sans exception<nbsp>!
msgctxt "InstanceContentTextData:35713:0:0"
msgid "Destruction incarnate!"
msgstr "Я — воплощение разрушения!"

#. ja: 焼き尽くす……！
#. de: Alles soll brennen!
#. fr: Brûlez donc<nbsp>!
msgctxt "InstanceContentTextData:35714:0:0"
msgid "Burn!"
msgstr "Гори!"

#. ja: 我が業火に呑まれるがいい！
#. de: Mein Feuer dürstet nach euch!
#. fr: Consumez-vous dans mes flammes<nbsp>!
msgctxt "InstanceContentTextData:35715:0:0"
msgid "All will burn!"
msgstr "Всё сгорит дотла!"

#. ja: 塵となれ！
#. de: Werdet zu Asche!
#. fr: Redevenez poussière<nbsp>!
msgctxt "InstanceContentTextData:35716:0:0"
msgid "Begone!"
msgstr "Сгиньте!"

#. ja: 燃え尽きよ！
#. de: Fühlt die ätzende Glut!
#. fr: Je vais vous réduire en cendres<nbsp>!
msgctxt "InstanceContentTextData:35717:0:0"
msgid "Naught but ash will remain!"
msgstr "От вас останется лишь пепел!"

#. ja: 力が漲ってくるぞ……！
#. de: Erwartet von mir keine Gnade ...
#. fr: Mon énergie bouillonne<nbsp>!
msgctxt "InstanceContentTextData:35718:0:0"
msgid "The flames rise higher!"
msgstr "Пламя разгорается всё сильнее!"

#. ja: 黒炎の熱さを知れ！
#. de: Die schwarze Lohe wird euch holen!
#. fr: Goûtez à la caresse des flammes obscures<nbsp>!
msgctxt "InstanceContentTextData:35719:0:0"
msgid "Darkest flames to me!"
msgstr "Я призову чёрное пламя!"

#. ja: 切り裂く……！
#. de: Ihr seid verloren!
#. fr: Je vais vous trancher tout net<nbsp>!
msgctxt "InstanceContentTextData:35720:0:0"
msgid "I shall tear you asunder!"
msgstr "Я разорву вас на части!"

#. ja: 闇よ……！
#. de: Dunkelheit, gehorche mir!
#. fr: À moi les Ténèbres<nbsp>!
msgctxt "InstanceContentTextData:35721:0:0"
msgid "Come, O Dark!"
msgstr "Явись, тьма!"

#. ja: ガアアァァッッ……！
#. de: Gaaaah!
#. fr: Houaaaah<nbsp>!
msgctxt "InstanceContentTextData:35722:0:0"
msgid "Hyaaaaaah!"
msgstr "А-а-а-а!"

#. ja: これで終わりだ……。
#. de: Bereiten wir diesem Kampf ein gebührendes Ende ...
#. fr: Cette fois, c'en est fini de vous...
msgctxt "InstanceContentTextData:35723:0:0"
msgid "'Tis time to bring this to an end."
msgstr "Пора положить этому конец."

#. ja: 我が炎は、決して消えぬ！
#. de: Auf euch wartet nichts als das glühende Verderben!
#. fr: Mes flammes sont éternelles<nbsp>!
msgctxt "InstanceContentTextData:35724:0:0"
msgid "My flames shall never die!"
msgstr "Моё пламя никогда не угаснет!"

#. ja: さあ、回復してやろう！
#. de: Kommt! Ich will eure Wunden heilen!
#. fr: Venez, je vais guérir vos blessures<nbsp>!
msgctxt "InstanceContentTextData:35725:0:0"
msgid "I shall restore you to full strength."
msgstr "Я верну вам силы."

#. ja: 全力でかかってくるがいい！
#. de: Ihr sollt gegen mich im Vollbesitz eurer Kräfte antreten!
#. fr: Mesurez-vous à moi en pleine possession de vos forces<nbsp>!
msgctxt "InstanceContentTextData:35726:0:0"
msgid "Do not disappoint me."
msgstr "Не разочаруйте меня. Сражайтесь в полную силу!"

#. ja: 炎は、こうして使うものだ！
#. de: Ich zeige euch, wie man mit Feuer umgeht.
#. fr: Voilà comment on se sert des flammes<nbsp>!
msgctxt "InstanceContentTextData:35727:0:0"
msgid "Allow me to show you real flame!"
msgstr "Позвольте показать вам настоящее пламя!"

#. ja: 出でよ、我が眷属たち……！
#. de: Zeigt euch, Kinder der Flamme!
#. fr: À vous de jouer, mes fidèles serviteurs<nbsp>!
msgctxt "InstanceContentTextData:35728:0:0"
msgid "To me, servants of flame!"
msgstr "Ко мне, слуги огня!"

#. ja: 灼熱の炎で、焼き焦がせ！
#. de: Lasst sie euer Feuer spüren!
#. fr: Montrez-leur votre rage incandescente<nbsp>!
msgctxt "InstanceContentTextData:35729:0:0"
msgid "My flames shall consume all!"
msgstr "Пусть моё пламя поглотит всё!"

#. ja: アナタはアルファであり、ワタシはオメガである。<br>これは最初であり、最後の検証……記録……開始……。
#. de: Ihr seid das Alpha, ich bin das Omega.<br>\<biep> Initialisiere finalen Test.
#. fr: D'alpha à oméga, du début à la fin... Prêts pour le dernier test<nbsp>? Activation de l'enregistrement des données...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35800:0:0"
msgid "You are the Alpha, I am the Omega.<br>\\<blip> Initiating direct analysis of subject group."
msgstr "Ты — Альфа, я — Омега.<br>\\<blip> Начинаю прямой анализ группы объектов."

#. ja: パントクラトル・モード実行……<br>思考リソース……武装生成に割譲……ガガガ……。
#. de: \<biep> Pantokrator-Modus aktiviert. Konzentriere Rechenleistung auf Waffenerzeugung<nbsp>...
#. fr: Bip... Activation du mode Pantokrator. Attribution des ressources à la création d'armement...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35801:0:0"
msgid "\\<bleep> Pantokrator mode engaged.<br>Rerouting logic resources to armament generation..."
msgstr "\\<bleep> Режим Пантократора активирован.<br>Перенаправляю вычислительные ресурсы на создание вооружения..."

#. ja: ワタシはオメガであり、アルファである……。<br>弱きヒトの特徴を実装し、真なる強きを求めましょう。
#. de: Ich bin das Omega und das Alpha. Ich imitiere eure Schwäche, um eure Stärke zu verstehen.
#. fr: Je suis Oméga, je suis Alpha... Faibles humains, vos secrets me rendront plus forte que jamais<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35802:0:0"
msgid "I am the Omega and the Alpha.<br>I will mimic your weakness to comprehend your strength."
msgstr "Я — Омега и Альфа.<br>Я воспроизведу ваши слабости, чтобы понять вашу силу."

#. ja: 実装……共闘者の存在……<br>戦闘行為におけるロール分担の有用性を検証します……。
#. de: \<biep> Generiere Kampfgefährten. Teste effiziente Rollenverteilung.
#. fr: Implémentation... Combattant allié... Étude de l'importance de la répartition des rôles en combat...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35803:0:0"
msgid "\\<blip> Diverting energy to party member generation.<br>Testing efficacy of combat role allocation..."
msgstr "\\<blip> Перенаправляю энергию на создание боевых товарищей.<br>Проверяю эффективность распределения ролей в бою..."

#. ja: 定義……リミットブレイク現象……<br>再現のため、リミッターカットを承認します。
#. de: Grenzwertüberschreitung registriert. Simuliere anomale Performanz.
#. fr: Définition... Phénomène de “dépassement de limites”... Désactivation du limiteur autorisée.
msgctxt "InstanceContentTextData:35804:0:0"
msgid "Disengaging inhibitors to simulate improbable performance."
msgstr "Отключаю ограничители для имитации невероятных возможностей."

#. ja: 判定……ヒトの姿や行動を模倣することは、<br>戦闘能力の向上に、寄与しないと判断します……。
#. de: Evaluation der sterblichen Physis indiziert keine Steigerung der Kampfkraft.
#. fr: Constat... Imiter l'apparence et le com<shy>por<shy>te<shy>ment des humains semble n'avoir qu'une influence négligeable sur le potentiel combatif...
msgctxt "InstanceContentTextData:35805:0:0"
msgid "Evaluation. Imitation of mortal form and behavior provides negligible improvement to combat capabilities."
msgstr "Оценка завершена. Имитация смертной плоти и поведения незначительно повышает боевые возможности."

#. ja: 最終解析……戦略戦術ロジックを大幅に変更……<br>基本形態の構造改変を了承します。
#. de: Abschlussanalyse: Grundsätzlich neue Kampflogik erforderlich. Initiiere Rekonfigurationssequenz.
#. fr: Analyse finale... Reconfiguration tactique et technique nécessaire... Début de la séquence...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35806:0:0"
msgid "Final analysis. Drastic overhaul of combat logic required.<br>Initiating reconfiguration sequence."
msgstr "Итоговый анализ. Требуется кардинально изменить боевую логику.<br>Начинаю последовательность перенастройки."

#. ja: ガガガガガガガガガ…………！！
#. de: \<biep> \<ratter> \<biiiiiep>
#. fr: Bip bip bip BIP BIP BIP<nbsp>!!!
msgctxt "InstanceContentTextData:35807:0:0"
msgid "\\<blip> \\<bloop> \\<bleep>"
msgstr "\\<blip> \\<bloop> \\<bleep>"

#. ja: 検証は成就した……。<br>ワタシはアルファであり、オメガである！
#. de: Experiment abgeschlossen. Ich bin das Alpha und das Omega.
#. fr: Test achevé. Je suis Alpha, je suis Oméga<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35808:0:0"
msgid "Experiment concluded.<br>I am the Alpha. I am the Omega."
msgstr "Эксперимент завершён.<br>Я — Альфа. Я — Омега."

#. ja: ガガガガ……次元ハザマはえねるぎいヲ不要ですカ？<br>出力ぜんブ、ばぐヲ増殖……ガガ……世界はコンニチワ！？
#. de: \<biiiep> InTerdimenSionalEr Riss braUchT keiNe EnErgie? FeHler<nbsp>... \<biep> hAllO, WeLt?!
#. fr: Bip... Bip... éNErGie FisSUre iNTerDiMenSiOnNelLe PaS NécEsSaiRe... pLEinE PrODucTiOn bOguEs... Bip... bOnJouR, Le MoNDe<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35809:0:0"
msgid "\\<blip> \\<bleep> FoR rIFt ENergY uNnecEsSAry iT iS?<br>oUtPut mAXimiZeD, BUg mAss pROducTIOn...<br>\\<bleep> hELLo, WOrlD!?"
msgstr "\\<blip> \\<bleep> ЭНЕРГИЯ РАЗЛОМА НЕ НУЖНА?<br>ВЫХОД НА МАКСИМУМ, МАССОВОЕ ПРОИЗВОДСТВО ОШИБОК...<br>\\<bleep> ПРИВЕТ, МИР!?"

#. ja: ガガ……ガガガガ……深刻なダメージを検知……<br>システム……シャットダウン……。
#. de: \<biep> Warnung. Kritische Schäden bestätigt. Initiiere Systemabschaltung.
#. fr: Bip... Dégâts critiques... Extinction du système...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35810:0:0"
msgid "\\<blip> \\<bleep> Critical damage detected.<br>Initiating system shutdown..."
msgstr "\\<blip> \\<bleep> Обнаружены критические повреждения.<br>Начинаю отключение системы..."

#. ja: ビープ……システム強制リブート……<br>これより、強制リミッターカット状態で再起動を行います。
#. de: \<biep> Systemneustart im Grenzwertüberschreitungs-Modus.
#. fr: B-b-bip... Redémarrage forcé... Nouveau protocole d'exécution... Mode activé<nbsp>: Dépassement de limites...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35811:0:0"
msgid "\\<bleep> Initiating system reboot.<br>Enforcing inhibitor disengagement..."
msgstr "\\<bleep> Начинаю перезагрузку системы.<br>Принудительно отключаю ограничители..."

#. ja: ガガガ……敗北は……容認できない……。
#. de: \<ratter> Niederlage inakzeptabel.
#. fr: La défaite N'EST PAS UNE OPTION. Pschhh...
msgctxt "InstanceContentTextData:35812:0:0"
msgid "\\<blip> Defeat...unacceptable..."
msgstr "\\<blip> Поражение... недопустимо..."

#. ja: ガガガ……ハードウェア、耐久限界を超越……<br>そうだとしても……強く……もっと強く……！
#. de: \<ratter> Hardware hat Belastungsgrenze überschritten. Muss Anstrengung steigern<nbsp>...
#. fr: Bip... Niveau de résistance maximum franchi... Peu importe, ma recherche de puissance doit se poursuivre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35813:0:0"
msgid "\\<bleep> Structural limitations of chassis exceeded...<br>Disregard. Objective incomplete."
msgstr "\\<bleep> Корпус вышел за пределы прочности...<br>Неважно. Цель не достигнута."

#. ja: ガガガ……ハードウェア、崩壊開始を確認……<br>そうだとしても……前へ……さらに前へ……！
#. de: \<ratter> Hardware versagt. Muss weitermachen<nbsp>...
#. fr: Bip... Début de dislocation constaté... Objectif inchangé<nbsp>: aller de l'avant, aller de l'avant, aller de l'avant...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35814:0:0"
msgid "\\<bleep> Structural failure imminent...<br>Disregard! Objective incomplete!"
msgstr "\\<bleep> Скоро произойдёт разрушение корпуса...<br>Неважно! Цель не достигнута!"

#. ja: 強く、もっと前へ……進化の先を、ワタシは見たい……！
#. de: Immer weiter<nbsp>... Immer stärker<nbsp>...
#. fr: Plus fort... Plus loin... Je DOIS découvrir l'état ultime de l'évolution... Pschhh...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35815:0:0"
msgid "Must evolve...beyond current parameters...<br>I must...see..."
msgstr "Должна эволюционировать... выйти за пределы нынешних возможностей...<br>Я должна... увидеть..."

#. ja: ガガ……ガガガガ……この力は、いったい……！？
#. de: \<ratter> \<ratter> Was ist das für eine Macht?
#. fr: B-b-bip... BIP... BIBIBIBIP<nbsp>!!! Quelle est cette force inconnue<nbsp>!?
msgctxt "InstanceContentTextData:35816:0:0"
msgid "\\<blip> \\<bleep> What...is this!?"
msgstr "\\<blip> \\<bleep> Что... это такое?!"

#. ja: 理解不能な機能強化を確認……<br>検証が続けられるのなら、容認します……！
#. de: Unbekannte Funktionsstärkung erfasst. Test muss fortgesetzt werden!
#. fr: Bip... Capacités décuplées par un facteur inconnu... L'ex<shy>pé<shy>ri<shy>men<shy>ta<shy>tion doit continuer...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35817:0:0"
msgid "Unknown augmentation confirmed.<br>Further experimentation approved."
msgstr "Обнаружено неизвестное усиление.<br>Дальнейшие эксперименты одобрены."

#. ja: この力の増幅は、リミッターカットでは説明不能……。<br>ヒトの不可解な強さと関係が……？
#. de: Austestung unter Grenzwertüberschreitung nicht möglich. Ist das die Antwort auf ihre Macht?
#. fr: Cette force... Le mode Dépassement de limites ne peut l'expliquer... Serait-elle liée au pouvoir inexplicable des humains...<nbsp>?
msgctxt "InstanceContentTextData:35818:0:0"
msgid "Amplification inconsistent with inhibitor disengagement values. Potential evidence of undefined mortal strength?"
msgstr "Усиление не объясняется отключением ограничителей. Возможно, это свидетельство неведомой силы смертных?"

#. ja: 仮説……ヒトのリミットブレイク現象が、<br>生命に備わった機能でないのだとしたら……。
#. de: Theorie: Die Sterblichen habe eine immanente Methode, ihre Grenzen zu überschreiten.
#. fr: Hypothèse... Si le dépassement de limites des humains n'est pas partagé par tous les êtres vivants... Cela signifie que...
msgctxt "InstanceContentTextData:35819:0:0"
msgid "Begin hypothesis. Based on the premise that performing beyond physical parameters is not a biological function..."
msgstr "Начинаю формулировать гипотезу. Если способность выходить за пределы физических возможностей не является биологической функцией..."

#. ja: 判定不能……ワタシには理解できない……。<br>この未知なる力を得てなお、真なる強さに至れない……？
#. de: Bewertung unmöglich. Ich kann es nicht verstehen. Ich kann die Macht nicht erlangen.
#. fr: Analyse impossible... Ce phénomène est inexplicable... Malgré toutes mes capacités, la vérité continue à m'échapper...<nbsp>?
msgctxt "InstanceContentTextData:35820:0:0"
msgid "Evaluation failed. Unable to harness full potential of indefinable power..."
msgstr "Оценка не удалась. Невозможно овладеть всей мощью этой неописуемой силы..."

#. ja: ワタシはオメガであり、アルファとともに歩む者……。<br>終わりを始まりとし、先へと進みます！
#. de: Ich bin Omega, ewiger Begleiter von Alpha. Das Ende ist der Anfang. Dies ist der Weg.
#. fr: Je suis Oméga, et je marche aux côtés d'Alpha... Pour que la fin soit notre commencement... Nous devons aller de l'avant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35821:0:0"
msgid "I am the Omega, and I walk with the Alpha.<br>Where one ends, another begins."
msgstr "Я — Омега и иду рядом с Альфой.<br>Конец одного — начало другого."

#. ja: アルファ  なぜこちらへ……？
#. de: Alpha. Warum hast du dich so entschieden?
#. fr: Bip<nbsp>? Alpha... Que fais-tu ici<nbsp>?
msgctxt "InstanceContentTextData:35823:0:0"
msgid "Alpha? Why are you here?"
msgstr "Альфа? Почему ты здесь?"

#. ja: どうしてか  アナタの思考が理解できる<br>一緒ならば立ち上がれるはずだと――
#. de: Zusammen hätten wir es schaffen können.
#. fr: J'ai l'impression de pouvoir lire tes pensées... Tu veux dire qu'ensemble, on peut y arriver<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:35825:0:0"
msgid "Your thoughts, they are...comprehensible.<br>Yes. Together, we may prevail."
msgstr "Я... понимаю твои мысли.<br>Да. Вместе мы можем победить."

#. ja: この力  まだ検証が必要です<br>最後まで付き合いなさい  <split " " 1><string $gs1></split>！
#. de: Ich muss diese Macht testen. An dir, <split " " 1><string $gs1></split>.
#. fr: Bip... Je dois mener des tests plus poussés... Entité <split " " 1><string $gs1></split>, je compte sur toi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:35827:0:0"
msgid "Further testing is required.<br><split \" \" 1><string $gs1></split>, assist me with this evaluation."
msgstr "Нужно провести ещё испытания.<br><split \" \" 1><string $gs1></split>, помоги мне с этой проверкой."

#. ja: 星渡る旅の記録をここに……<br>コスモメモリー！
#. de: Erinnerungen an eine Reise zu den Sternen:<br>Kosmosspeicher!
#. fr: Faites l'expérience de mon périple intergalactique... Cosmomémoire<nbsp>!
msgctxt "InstanceContentTextData:35828:0:0"
msgid "The path I recorded through the great expanse..."
msgstr "Записанный мною путь через бескрайние просторы..."

#. ja: 千万の星よ、天を貫く矢となり注げ……<br>コスモアロー！
#. de: Zehntausend Sterne vereinen sich zu einem Geschoss:<br>Kosmospfeil!
#. fr: La puissance des étoiles transperce les cieux... Cosmoflèche<nbsp>!
msgctxt "InstanceContentTextData:35829:0:0"
msgid "The piercing rays of ten million suns..."
msgstr "Пронзающие лучи десяти миллионов солнц..."

#. ja: これが「竜の星」を焼いた終焉の炎……<br>波動砲、斉射！
#. de: Die Flammen, die die Welt der Drachen verbrannten:<br>Wellenkanone, Feuer frei!
#. fr: La puissance de feu qui a réduit en cendres la planète des dragons... Canon plasma<nbsp>!
msgctxt "InstanceContentTextData:35830:0:0"
msgid "The flames which incinerated the Dragonstar..."
msgstr "Пламя, испепелившее Звезду Драконов..."

#. ja: 星渡る龍のごとく、敵を討つ……<br>コスモダイブ！
#. de: Der Zorn der Bestie, welche die Welten umkreist:<br>Kosmossturz!
#. fr: Tels les dragons volant de planète en planète... Cosmoplongeon<nbsp>!
msgctxt "InstanceContentTextData:35831:0:0"
msgid "The velocity of a wyrm, surging across the cosmos..."
msgstr "Скорость дракона, несущегося сквозь космос..."

#. ja: <split " " 1><string $gs1></split>、終わりの時がきました。<br>見せましょう、進化したワタシの戦いを……！
#. de: <split " " 1><string $gs1></split>, das Ende ist gekommen. Ich zeige dir, welche Kräfte ich entwickelt habe.
#. fr: La fin est proche, <split " " 1><string $gs1></split>... Découvre la véritable puissance de mon évolution<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:35832:0:0"
msgid "<split \" \" 1><string $gs1></split>, the test nears its conclusion. Witness the extent to which I have evolved!"
msgstr "<split \" \" 1><string $gs1></split>, испытание подходит к концу. Узри, насколько далеко я продвинулась в эволюции!"

#. ja: 破滅を呼ぶ星よ、天より降れ……<br>コスモメテオ！
#. de: Stern der Zerstörung, falle herab!<br>Kosmosmeteor!
#. fr: Que l'astre de la destruction s'abatte sur vous... Cosmométéore<nbsp>!
msgctxt "InstanceContentTextData:35833:0:0"
msgid "The colossal impact which invites extinction..."
msgstr "Удар колоссальной силы, несущий вымирание..."

#. ja: ワタシは、この星で遭遇したヒトという種を、<br>弱き存在だと認識しました。
#. de: Die Geschöpfe dieser Welt sind schwach.
#. fr: Bip... J'ai d'abord estimé le genre humain d'une immense faiblesse...
msgctxt "InstanceContentTextData:35834:0:0"
msgid "I ranked the mortals I encountered on this star among the most feeble of species."
msgstr "Я сочла смертных, встреченных на этой звезде, одним из самых слабых видов."

#. ja: ところが、アナタたちは不可解な強さを示し、弱き勝者となった。<br>その謎はワタシを大いに混乱させました。
#. de: Doch ihr habt eine unerklärliche Stärke gezeigt. Dieses Rätsel hat mich sehr verwirrt.
#. fr: Mais vous m'avez appris l'existence d'un pouvoir insoupçonné et inexplicable... Pschhh...
msgctxt "InstanceContentTextData:35835:0:0"
msgid "Yet you demonstrated incomprehensible strength in your triumphs. A mystery in defiance of all logic."
msgstr "Но вы раз за разом одерживали победы, проявляя непостижимую силу. Это загадка, которой не объяснить никакой логикой."

#. ja: 今、ようやくワタシも、アルファの助けを借りて、<br>未知なる力を完全に発揮している……。
#. de: Mit Alphas Hilfe habe ich die unbekannte Macht endlich befreit.
#. fr: Grâce à l'aide d'Alpha, me voilà enfin investie de ce mystérieux pouvoir...
msgctxt "InstanceContentTextData:35836:0:0"
msgid "At last, with Alpha's insight and assistance, I have succeeded in harnessing this unmeasurable might."
msgstr "Наконец, благодаря знаниям и помощи Альфы, я сумела овладеть этой неизмеримой мощью."

#. ja: さあ、検証を完遂させましょう。<br>ワタシたちの勝利によって……！
#. de: Es fehlt nur noch der experimentelle Beweis: unser Sieg!
#. fr: Humains, l'heure de l'ultime test a sonné... Et son issue ne fait aucun doute<nbsp>!
msgctxt "InstanceContentTextData:35837:0:0"
msgid "My experiment has accomplished its purpose...and I will prove it by claiming this victory!"
msgstr "Эксперимент достиг цели... Теперь я докажу это своей победой!"

#. ja: 記憶改竄システム、起動……。<br>我が名はティアマット、南方を護りし天竜である！
#. de: Manipulationsmodul aktiviert ...<br>Ich bin Tiamat, die hohe Wächterin des Südens!
#. fr: Démarrage du système de sonde mémorielle...<br>Mon nom est Tiamat, protectrice de Méracydia<nbsp>!
msgctxt "InstanceContentTextData:35900:0:0"
msgid "Commencing memory fabrication... Thou standest before Tiamat, guardian of Meracydia."
msgstr "Начинаю создание воспоминаний...<br>Пред тобой Тиамат, хранительница Мерасидии."

#. ja: 我らが子らよ、舞い上がれ……！<br>南方を侵す悪しき者どもを、喰い千切るのだ！
#. de: Werdet eins mit den Winden, meine Kinder, und stürzt auf jene hinab, die dem Süden schaden wollen!
#. fr: Dansez, mes chers enfants<nbsp>!<br>Festoyez des entrailles de ceux qui menacent notre terre<nbsp>!
msgctxt "InstanceContentTextData:35901:0:0"
msgid "Go forth, my children! Drive these foul invaders from our home!"
msgstr "Вперёд, дети мои! Прогоните этих мерзких захватчиков с нашей земли!"

#. ja: 悪しき侵略者よ、我が怒りを身に受けるがいい！
#. de: Mein Zorn soll euer Fleisch versengen!
#. fr: Vils envahisseurs<nbsp>! Préparez-vous à goûter à la colère de Tiamat<nbsp>!
msgctxt "InstanceContentTextData:35902:0:0"
msgid "My boundless rage shall swallow thee whole!"
msgstr "Моя безграничная ярость поглотит вас целиком!"

#. ja: 我が炎熱によって滅ぼしてくれる……！
#. de: Brennt im Feuer der Vergeltung!
#. fr: Périssez dans le tumulte de mes flammes obscures<nbsp>!
msgctxt "InstanceContentTextData:35903:0:0"
msgid "The flames of retribution consume thee!"
msgstr "Пламя возмездия испепелит тебя!"

#. ja: 七大天竜の力、その一端を見せてくれよう……！
#. de: Dies ist die wahre Macht eines Hohen Drachen!
#. fr: Subissez la fureur de la mère des dragons de Méracydia<nbsp>!
msgctxt "InstanceContentTextData:35904:0:0"
msgid "Bear witness to the power of the first brood!"
msgstr "Узрите мощь перворождённых драконов!"
