msgid "Clear Ichthyology"
msgstr "Пройдите отдел ихтиологии"

#. ja: 草木生物創造場への到達
#. de: Die Phytobiologie erreichen
#. fr: Atteindre le département de phytogénie
msgctxt "InstanceContentTextData:21702:0:0"
msgid "Arrive in Phytobiology"
msgstr "Доберитесь до отдела фитобиологии"

