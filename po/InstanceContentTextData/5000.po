# InstanceContentTextData
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 白百合の間の突破
#. de: Weiße Halle durchqueren
#. fr: Dégager le hall du lys
msgctxt "InstanceContentTextData:5000:0:0"
msgid "Clear the White Hall"
msgstr "Пройти Белый зал"

#. ja: 紅薔薇の間の突破
#. de: Rote Halle durchqueren
#. fr: Dégager le hall de la rose
msgctxt "InstanceContentTextData:5001:0:0"
msgid "Clear the Red Hall"
msgstr "Пройти Красный зал"

#. ja: ハリカルナッソスの撃破
#. de: Halikarnassos besiegen
#. fr: Vaincre Halicarnasse
msgctxt "InstanceContentTextData:5002:0:0"
msgid "Defeat Halicarnassus"
msgstr "Победить Халикарнас"

#. ja: 我が血肉となる光栄に浴せ！
#. de: Badet in meiner Herrlichkeit!
#. fr: Goûtez aux plaisirs de ma chair<nbsp>!
msgctxt "InstanceContentTextData:5003:0:0"
msgid "Slake my hunger and know true glory!"
msgstr "Утоли мой голод — и познай истинное величие!"

#. ja: 魂捧げ、我が糧となれ！
#. de: Opfert eure Seelen, um mich zu nähren!
#. fr: Donnez-moi vos âmes, que je m'en repaisse<nbsp>!
msgctxt "InstanceContentTextData:5004:0:0"
msgid "I shall feast upon your very soul!"
msgstr "Я пировать буду твоей душой!"

#. ja: 贄を、もっと贄を……
#. de: Opfer! Ich brauche mehr Opfer!
#. fr: Des sacrifices<nbsp>!<br>Je veux plus de sacrifices...<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:5005:0:0"
msgid "I still hunger...<br>Bring me more...more!"
msgstr "Я всё ещё голодна...<br>Принесите мне ещё... ещё!"

#. ja: 魂を捧げるとの誓い……<br>今こそ果たしてもらうぞ！
#. de: Eure Seelen! Jetzt werde ich sie zu mir nehmen!
#. fr: Vos âmes m'appartiennent...<br>Je vais vous les prendre maintenant<nbsp>!
msgctxt "InstanceContentTextData:5006:0:0"
msgid "Your souls are mine at last!"
msgstr "Ваши души наконец-то мои!"

#. ja: 小さな鍵所持数
#. de: Kleine Schlüssel
#. fr: Petites clefs
msgctxt "InstanceContentTextData:5007:0:0"
msgid "Tiny Keys"
msgstr "Крошечные ключи"

#. ja: さあ、第一の修練区画だ！<br>魔法人形を相手に、小手調べといこうか！
#. de: Der erste Übungsplatz! Na, wollt ihr euch mal gegen ein paar Marionetten versuchen?
#. fr: Aire d'en<shy>traî<shy>ne<shy>ment n°1<nbsp>: un petit échauf<shy>fe<shy>ment contre des automates<nbsp>!<br>Du menu fretin, en somme<nbsp>!
msgctxt "InstanceContentTextData:5100:0:0"
msgid "This way lies the first stage! By way of a warm-up, your opponents will be beasts and mammets!"
msgstr "Сюда, на первый этап! Для разминки вам предстоит сразиться с чудовищами и мамметами!"

#. ja: 第二の修練区画へ進むがいい！<br>猛獣、魔獣が相手になるぞ！
#. de: Nur weiter, nur weiter! Am zweiten Übungsplatz wird's ein bisschen wilder!
#. fr: Et maintenant, l'aire d'en<shy>traî<shy>ne<shy>ment n°2<nbsp>!<br>Vos adversaires sont des monstres féroces, cette fois<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:5102:0:0"
msgid "The second stage begins! Gird your loins for a <i>beastly</i> encounter!"
msgstr "Второй этап! Готовьтесь к <i>зверской</i> схватке!"

#. ja: 最後の修練区画まで、よく来たな！<br>いよいよ、本物の剣闘士たちのお出ましだぞ！
#. de: Haha, gut durchgehalten! Dann freut euch auf die ersten echten Gegner!
#. fr: Vous voici à la dernière aire d'en<shy>traî<shy>ne<shy>ment<nbsp>!<br>Maintenant, vous allez affronter de véritables combattants.
msgctxt "InstanceContentTextData:5104:0:0"
msgid "You have done well to come this far, but the hardest trials are yet to come. In the third stage, you must clash steel with seasoned gladiators!"
msgstr "Неплохо добрались до третьего этапа! Но самое трудное ещё впереди: теперь вам предстоит скрестить клинки с бывалым гладиаторами!"

#. ja: マメットを討伐
#. de: Marionetten besiegen
#. fr: Vaincre les automates
msgctxt "InstanceContentTextData:5106:0:0"
msgid "Defeat the mammets"
msgstr "Победить мамметов"

#. ja: ピュラクモンの撃破
#. de: Pyracmon bezwingen
#. fr: Vaincre Pyracmon
msgctxt "InstanceContentTextData:5107:0:0"
msgid "Defeat Pyracmon"
msgstr "Победить Пиракмона"

#. ja: 魔獣を討伐
#. de: Die Bestien besiegen
#. fr: Vaincre les fauves
msgctxt "InstanceContentTextData:5108:0:0"
msgid "Defeat the caged beasts"
msgstr "Победить запертых зверей"

#. ja: カトブレパスの撃破
#. de: Catblepus bezwingen
#. fr: Vaincre Catoblépas
msgctxt "InstanceContentTextData:5109:0:0"
msgid "Defeat the catoblepas"
msgstr "Победить катоблепаса"

#. ja: 剣闘士を討伐
#. de: Gladiatoren besiegen
#. fr: Vaincre les gladiateurs
msgctxt "InstanceContentTextData:5110:0:0"
msgid "Defeat the gladiators"
msgstr "Победить гладиаторов"

#. ja: すべての敵の撃破
#. de: Alle Gegner besiegen
#. fr: Vaincre tous les ennemis
msgctxt "InstanceContentTextData:5111:0:0"
msgid "Complete the final test"
msgstr "Пройти последнее испытание"

#. ja: さて、最後は集団戦の訓練と洒落込もうじゃないか！
#. de: Und jetzt mal so, wie's in der Arena wirklich zugeht!
#. fr: Et maintenant, le bouquet final<nbsp>: un combat de groupe à grande échelle<nbsp>!
msgctxt "InstanceContentTextData:5112:0:0"
msgid "And so we arrive at the climactic ending! Victory belongs to the beauteous!"
msgstr "Ну вот и финал! Победа достанется прекраснейшим!"

#. ja: ほほ～う、一流の剣闘士たちを退けるとは～。<br>大導師ムムエポと、我がシモベがお相手しましょう～！
#. de: Haha, echte Kraftpakete seid ihr! Dann zeigt's dem guten Mumuepo und seinem Gefolge mal!
#. fr: Ha ha<nbsp>! On tient tête à une troupe de gladiateurs d'élite<nbsp>? Bien joué<nbsp>!<br>Alors je vais m'occuper de vous en personne avec mon serviteur<nbsp>!
msgctxt "InstanceContentTextData:5113:0:0"
msgid "You may be able to stand with the best of the bloodsands, but how will you fare against the mightiest thaumaturge of the age?"
msgstr "С лучшими бойцами Кровавых песков вы справились. А как насчёт величайшего тауматурга нашего времени?"

#. ja: アルダネス聖櫃堂に伝わる古代魔法！<br>この呪縛には～手も足もでないでしょう～？
#. de: Die okkulten Künste des Arr<shy>za<shy>neth-Os<shy>sari<shy>ums! Da seid ihr baff, was?
#. fr: Subissez mon étreinte implacable, qui vous privera de vos mains et de vos jambes<nbsp>!<br>Voyez la puissance des anciens sorts de l'ossuaire d'Arrzaneth<nbsp>!
msgctxt "InstanceContentTextData:5114:0:0"
msgid "There is no escaping the Absolute Bind!"
msgstr "Абсолютные путы не разорвать!"

#. ja: ……なんとっ！？<br>完全呪縛に、抗ったというのですか～？
#. de: Nein?! War es etwa der falsche Spruch?!
#. fr: Quoi<nbsp>! Vous avez brisé mon Étreinte impénétrable<nbsp>!?
msgctxt "InstanceContentTextData:5115:0:0"
msgid "Wh-What? But...how!?"
msgstr "Ч-что? Но... как?!"

#. ja: さあ～逃げまどいなさ～い！<br>我が魔力を束ねし～呪いの雷から～！
#. de: Rennt in Deckung, meine Kleinen! Jetzt mach ich ernst!
#. fr: Fuyez, courez<nbsp>! Ou l'éclair maudit de mon pouvoir vous frappera<nbsp>!
msgctxt "InstanceContentTextData:5116:0:0"
msgid "Run, my pretties, lest you feel the searing kiss of my magicks!"
msgstr "Бегите, мои красавчики, иначе испытаете на себе жгучий поцелуй моей магии!"

#. ja: 我が海域を侵すか、光に穢れし者よ！
#. de: Du trübst meine Gewässer, Landgeborene<if $gn4><else>r</if>?
#. fr: Vous violez mon domaine, suppôts des puissances impures<nbsp>!
msgctxt "InstanceContentTextData:5200:0:0"
msgid "You trespass upon my domain, tainted of the Light!"
msgstr "Вы вторглись в мои владения, осквернённые Светом!"

#. ja: 清浄なる青き水を以て、穢れ清めん！
#. de: Trinkt den bitteren Wein meiner Fluten!
#. fr: Remplissez vos poumons du précieux breuvage et purifiez vos âmes corrompues<nbsp>!
msgctxt "InstanceContentTextData:5201:0:0"
msgid "Drink deep of the sea's bitter draught!"
msgstr "Пейте горькие воды моря!"

#. ja: 我が水の力……<br>全てを押し流し、全てを浄化する力！
#. de: Alles ist Wasser, ins Wasser kehrt alles zurück!
#. fr: Rien ne résiste à l'assaut implacable de mes déferlantes<nbsp>!
msgctxt "InstanceContentTextData:5202:0:0"
msgid "Mine is the power to cleanse all things! Naught can withstand the relentless onslaught of my waves!"
msgstr "Мне подвластно очищать всё на свете! Никто не устоит перед неумолимым натиском моих волн!"

#. ja: ぬぅ、小細工を弄したか……<br>なれば真なる力を解き放つのみ！
#. de: Lausche, Landgeborene<if $gn4><else>r</if>, dem Gesang der zornigen See!
#. fr: Vos appareils ne vous sauveront pas de mon courroux.<br>Tremblez devant la toute-puissance du Seigneur des mers<nbsp>!
msgctxt "InstanceContentTextData:5203:0:0"
msgid "You challenge me with trickery? Fools! Your mortal contrivances cannot quell the raging sea!"
msgstr "Решили одолеть меня хитростью? Глупцы! Ваши жалкие уловки не усмирят бушующее море!"

#. ja: これが光の加護……<br>我が力を水泡に帰すとは……
#. de: Ihr wendet das Wasser gegen mich?!
#. fr: C'est impossible... Nul ne peut arrêter le flot tumultueux de ma colère...
msgctxt "InstanceContentTextData:5204:0:0"
msgid "My waters...are stilled... This...this is the blessing of Light?"
msgstr "Мои воды... утихли... Неужели это... благословение Света?"

#. ja: 属性変換エーテル
#. de: Elementarwandlungs-Äther
#. fr: Conversion éthéréenne
msgctxt "InstanceContentTextData:5205:0:0"
msgid "Elemental Conversion"
msgstr "Стихийное преобразование"

#. ja: 我が水の力にて、押し流してくれようぞ！
#. de: Mit einer Woge nur könnte ich euch hinfortspülen!
#. fr: Misérables terriens... Vos vies me sont offertes<nbsp>! Votre chair nourrira mes fidèles<nbsp>!
msgctxt "InstanceContentTextData:5206:0:0"
msgid "Your flesh shall feed my minions of the deep!"
msgstr "Плоть ваша станет пищей моим прислужникам из морских глубин!"

#. ja: ぬぅ、小細工を弄したか……
#. de: Was sind das für Tricksereien?
#. fr: Vos appareils ne vous sauveront pas de ma colère<nbsp>!
msgctxt "InstanceContentTextData:5207:0:0"
msgid "You challenge me with trickery?"
msgstr "Решили одолеть меня хитростью?"

#. ja: 「避難地の前庭」への進路確保
#. de: Zugang zum Versteck-Vornebereich verschaffen
#. fr: Dégager la voie jusqu'au Front de l'Arrêt
msgctxt "InstanceContentTextData:5300:0:0"
msgid "Clear Runstop Frontblock"
msgstr "Открыть проход к переднему блоку «Приюта»"

#. ja: 小さな鍵所持数
#. de: Kleine Schlüssel
#. fr: Petites clefs
msgctxt "InstanceContentTextData:5301:0:0"
msgid "Tiny Keys"
msgstr "Крошечные ключи"

#. ja: 囚われのゴブリンの解放
#. de: Befreite Goblins
#. fr: Libérer les Gobelins captifs
msgctxt "InstanceContentTextData:5302:0:0"
msgid "Liberate captured goblins"
msgstr "Освободить пленённых гоблинов"

#. ja: 「ブレイフロクスの芥場」への進路確保
#. de: Zugang zum Müllwerfen-Ort verschaffen
#. fr: Dégager la voie de la Décharge de Brayflox
msgctxt "InstanceContentTextData:5303:0:0"
msgid "Clear Brayflox's Drossdump"
msgstr "Открыть проход к свалке Брейфлокса"

#. ja: 「野営地」の関門の突破
#. de: Langrast-Tor durchschreiten
#. fr: Franchir les barricades
msgctxt "InstanceContentTextData:5304:0:0"
msgid "Open Swiftmake Checkgates"
msgstr "Открыть ворота лагеря «Стремительный кованец»"

#. ja: チーズレシピは　門外不出！<br>我は　秘密の守護者なり～！！
#. de: Käseheimnis wird nicht verraten zu Keinezeit!
#. fr: Recette secrète, recette sacrée<nbsp>! Les Maîtres de la Main vont défendre la recette du fromage coûte que coûte<nbsp>!
msgctxt "InstanceContentTextData:5305:0:0"
msgid "Knowings of cheesemake is gobbie secret!"
msgstr "Знания о сыре — секрет гоблинов!"

#. ja: シュコォ、シュコォ……<br>邪魔する者は　抹殺だ～！！
#. de: Kho, wer lästigsteht in Weg, muss sterben!
#. fr: Les aventuriers veulent voler la recette du fromage<nbsp>! Ils doivent mourir pour ça<nbsp>!
msgctxt "InstanceContentTextData:5306:0:0"
msgid "All cheese recipes are belong to Illuminati!"
msgstr "Все рецепты сыра принадлежат Иллюминатам!"

#. ja: シュコォ、シュコォ……<br>目標発見　作戦開始　ブレイフロクス捕まえろ～！
#. de: Pshh, kommzu für Nasestecken in Fremdesache? Wirzzu bald bereuen.
#. fr: Cible en vue<nbsp>! La maudite Brayflox, usurpatrice du secret fromager, doit être attrapée croûte que croûte<nbsp>!
msgctxt "InstanceContentTextData:5307:0:0"
msgid "Shkoh! Target is eyecatched! All hands, forcetake Brayflox!"
msgstr "Шкох! Цель замечена! Всем приготовиться, схватить Брейфлокса!"

#. ja: 青の手　科学は　世界イチ～！<br>ゴブリガードで　蹴散らすど～！！
#. de: Indigohand muss selbsthaben Käse von Ganzewelt! Her mit Heimrezept!
#. fr: Les Maîtres de la Main sont maîtres de la science<nbsp>! La gobarmure va donner une bonne leçon aux aventuriers<nbsp>!
msgctxt "InstanceContentTextData:5308:0:0"
msgid "Illuminati brainfruit is frontmost! Uplanders have no chance to survive! "
msgstr "Мозги Иллюминатов — самые лучшие! Нагорцы не выживут!"

#. ja: 平和の残滓の突破
#. de: Den Friedensplatz erobern
#. fr: Franchir le square du Calme
msgctxt "InstanceContentTextData:5400:0:0"
msgid "Clear Halcyon Court"
msgstr "Пройти Двор мира"

#. ja: 白魔道士の塔の突破
#. de: Den Weißmagischen Turm erobern
#. fr: Franchir la tour des Guérisseurs
msgctxt "InstanceContentTextData:5401:0:0"
msgid "Clear the Tower of White"
msgstr "Пройти Башню Белого"

#. ja: ディアボロスの撃破
#. de: Diabolos besiegen
#. fr: Vaincre Diabolos
msgctxt "InstanceContentTextData:5402:0:0"
msgid "Defeat Diabolos"
msgstr "Победить Диаболосса"

#. ja: 我の眠りをさまたげる者は、誰だ？<br>アムダプールの魔道士ども……いや、違うな？
#. de: Wer wagt uns zu wecken? Weißmagier? Wer immer es ist, wird büßen!
#. fr: Qui ose troubler mon sommeil<nbsp>? Est-ce les mages amdaporiens... Non, pas cette fois.
msgctxt "InstanceContentTextData:5403:0:0"
msgid "Who dares set foot within my domain? The wretched white mages of Amdapor?"
msgstr "Кто посмел потревожить мой покой? Белые маги Амдапора?"

#. ja: 夜の闇束ね、我が盾と成さん……<br>我を阻むこと叶わぬと知れ！
#. de: Dunkelheit ist mein Schild, nimmer wird es brechen!
#. fr: Quiconque ose défier la puissance de Diabolos doit être puni<nbsp>! Que l'abîme noir du cauchemar vous engloutisse<nbsp>!
msgctxt "InstanceContentTextData:5404:0:0"
msgid "To face me is to face thy deepest, darkest nightmares!"
msgstr "Встретиться со мной — значит столкнуться со своими самыми тёмными кошмарами!"

#. ja: 暗き闇紡ぎて、死を知らせる弔鐘と成せ！<br>ルイナスオーメン！
#. de: Finsternis verwebe ich zum Vorhang, der über eures Lebens Tragödie herniederfällt!
#. fr: Que le glas des ténèbres annonce votre mort, alors que le châtiment de mon Mauvais présage s'abattra sur vous<nbsp>!
msgctxt "InstanceContentTextData:5405:0:0"
msgid "Not even in eternal sleep shalt thou be free from the terror of my weaving!"
msgstr "Даже вечный сон не избавит вас от ужаса моих чар!"

#. ja: 長き眠りで、我が力も衰えたか……
#. de: Geschwächt hat mich der lange Schlaf ... Entkräftet ...
#. fr: Au bout de ce long sommeil inerte... ma force s'est donc évanouie...
msgctxt "InstanceContentTextData:5406:0:0"
msgid "My long slumber...hath weakened me..."
msgstr "Долгий сон... ослабил меня..."

#. ja: 来たな冒険者、お前に勝って武器をいただくぜ！<br>ゆくぞ、エンキドゥ！　我が心の友よ！
#. de: Da seid ihr ja endlich! Von euren Waffen könnt ihr euch schon mal verabschieden. Los, Enkidu! Fass, mein wackerer Freund!
#. fr: À moi, Enkidu, mon plus fidèle compagnon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:5501:0:0"
msgid "来たな冒険者、お前に勝って武器をいただくぜ！<br>ゆくぞ、エンキドゥ！　我が心の友よ！"
msgstr "Явились, авантюристы! Побью вас — и заберу ваше оружие!<br>Вперёд, Энкиду! Друг мой сердечный!"

#. ja: オレが悪かった……。
#. de: Argh ...
#. fr: Bon, je le reconnais...
msgctxt "InstanceContentTextData:5502:0:0"
msgid "Fine! I admit it!"
msgstr "Ладно, признаю!"

#. ja: 8人でこられちゃ……。
#. de: Ich habe mich wohl übernommen ...
#. fr: Huit, c'est un peu trop pour moi<nbsp>!
msgctxt "InstanceContentTextData:5503:0:0"
msgid "Fighting all eight of you..."
msgstr "Когда вас восьмеро..."

#. ja: 手も足もでないぜ……。
#. de: ... gegen euch acht anzutreten.
#. fr: J'ai eu les yeux plus gros que le ventre.
msgctxt "InstanceContentTextData:5504:0:0"
msgid "Is just too much for me..."
msgstr "...мне не справиться!"

#. ja: ……てのは、ウソだけどな！！
#. de: In euren Träumen!
#. fr: Ah<nbsp>! Vous m'avez cru<nbsp>!? Je rigolais<nbsp>!
msgctxt "InstanceContentTextData:5505:0:0"
msgid "NOT! Ha, I lied!"
msgstr "А вот и нет! Ха, обманул!"

#. ja: こいつを食らえっ！<br>うおおおっ！　メガフレアっ！！
#. de: Haha! Nehmt das!
#. fr: Prenez donc ça<nbsp>!<br>Mégaaaafissiooooon<nbsp>!
msgctxt "InstanceContentTextData:5506:0:0"
msgid "Have at thee!"
msgstr "Получайте!"

#. ja: ……ありゃ？　メガフレアが出ない？<br>最強の槍じゃないのかー！
#. de: Wie bitte? Das soll der mächtigste Speer der Welt sein?!<br>Pah! Ich fühle mich so betrogen!
#. fr: Ma Mégafission a échoué<nbsp>!?<br>Ma lance aurait dû être invincible<nbsp>!
msgctxt "InstanceContentTextData:5507:0:0"
msgid "Ehhh!? Why, I've been had! This is far from the strongest of spears! I feel so betrayed!"
msgstr "А?! Мегавспышка не сработала?! Это что, не сильнейшее копьё?! Вот же обман!"

#. ja: 急用を思いだしたぜ！！<br>必ず戻って来るからなっ！
#. de: Argh! Ich muss dringend weg!<br>Ich ziehe mich fürs Erste zurück.
#. fr: Je viens de me rappeler que j'avais un rendez-vous<nbsp>!<br>Mais on se reverra<nbsp>!
msgctxt "InstanceContentTextData:5508:0:0"
msgid "Goodness gracious! I, uh, just remembered something!"
msgstr "Ох, совсем забыл! У меня тут одно неотложное дельце!"

#. ja: 行け、エンキドゥ！<br>大好物の蛙だぞ！
#. de: Fresschen, Enkidu! Es gibt dein Leibgericht ... Froschschenkel!
#. fr: En avant, Enkidu<nbsp>! De bonnes grenouilles<nbsp>!
msgctxt "InstanceContentTextData:5509:0:0"
msgid "Go on, Enkidu! It's toad─your favorite!"
msgstr "Вперёд, Энкиду! Лягушки — твоя любимая еда!"

#. ja: も、もういいだろ！<br>お前らしつこすぎだぞ！
#. de: Wir sind uns richtig nahe gekommen, findet ihr nicht?
#. fr: C'était un simple échauf<shy>fe<shy>ment<nbsp>!<br>Passons aux choses sérieuses<nbsp>!
msgctxt "InstanceContentTextData:5510:0:0"
msgid "I must say, I quite enjoy these tussles. I feel we've gained an understanding─"
msgstr "Должен признать, мне нравится наша возня. Кажется, мы с вами поладили..."

#. ja: ……上等だぜ。<br>このギルガメッシュ様を倒せるかな？
#. de: So nah wie ihr dem Tod! Hahaha!
#. fr: Pas mal du tout<nbsp>!<br>Vous pensez vraiment pouvoir me vaincre<nbsp>?
msgctxt "InstanceContentTextData:5511:0:0"
msgid "An understanding that I will pound you silly! Ha ha!"
msgstr "Поладили настолько, что я вас в лепёшку раскатаю! Ха-ха!"

#. ja: しぶといヤツらだぜ……。
#. de: Noch bin ich nicht geschlagen!
#. fr: Je me laisserai pas vaincre<nbsp>!
msgctxt "InstanceContentTextData:5512:0:0"
msgid "Urgh! I won't go down so easily!"
msgstr "Ургх! Я так просто не сдамся!"

#. ja: これなるはエオルゼアいちの強者……<br>その名も、剣豪ギルガメッシュ！
#. de: Narren! Ihr steht vor dem größten Schwertkämpfer Eorzeas! Ich bin Gilgamesch!
#. fr: Je suis le plus puissant guerrier d'Éorzéa<nbsp>!<br>Je suis le grand, l'inénarrable Gilgamesh<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:5513:0:0"
msgid "これなるはエオルゼアいちの強者……<br>その名も、剣豪ギルガメッシュ！"
msgstr "Перед вами сильнейший воин Эорзеи...<br>Сам великий фехтовальщик Гильгамеш!"

#. ja: ダークマター塊の破壊
#. de: Dunkelmaterie-Brocken zerstören
#. fr: Détruire l'amas de matière sombre
msgctxt "InstanceContentTextData:5600:0:0"
msgid "Destroy the dark matter cluster"
msgstr "Уничтожить сгусток тёмной материи"

#. ja: 整備システムの破壊
#. de: Wartungsmodul zerstören
#. fr: Détruire le module d'entretien
msgctxt "InstanceContentTextData:5700:0:0"
msgid "Destroy the maintenance modules"
msgstr "Уничтожить модули обслуживания"

#. ja: 艦首隔壁の開放
#. de: Das Hauptschott öffnen
#. fr: Ouvrir la cloison avant
