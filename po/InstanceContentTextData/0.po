msgstr "Выйти вместе с отрядом."

#. ja: キャンセル
#. de: Abbrechen.
#. fr: Annuler
msgctxt "InstanceContentTextData:4:0:0"
msgid "Remain here."
msgstr "Остаться здесь."

#. ja: <sheet BNpcName $n1 0>の撃破
#. de: <capitalize><noun-de BNpcName 2 $n1 1 4 1></capitalize> besiegen
#. fr: Vaincre <noun-fr BNpcName 2 $n1 1 1>
#. macro: <noun-en BNpcName 2 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = BNpcName, form = 2, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:5:0:0"
msgid "Defeat <noun-en BNpcName 2 $n1 1 1>"
msgstr "Победить <noun-en BNpcName 2 $n1 1 1>"

