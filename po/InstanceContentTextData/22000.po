# InstanceContentTextData
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: アソビ、マショ……夜ノ、ナイ朝……<br>眠リモ、忘レテ、ズット……
#. de: Immer Tag, nie Nacht ... Der Schlaf ist für die Toten ...
#. fr: Venez jouer avec moi... jusqu'au matin qui ne viendra jamais...
msgctxt "InstanceContentTextData:22000:0:0"
msgid "Come and play! For the night is bright, and you can sleep when you're dead!"
msgstr "Идём играть! Ночь так светла — выспимся, когда умрём!"

#. ja: ツブレテ、ペッチャン……赤イ、オ花……！
#. de: Eine rote Blume ... ist sie nicht schön?
#. fr: Une jolie fleur rouge<nbsp>! Pour vous écrabouiller<nbsp>!
msgctxt "InstanceContentTextData:22001:0:0"
msgid "Squish, squash! A crimson flower!"
msgstr "Хлюп-хлюп! Алый цветочек!"

#. ja: ビリビリ、カミナリ……ダレ、ト、アソブ……？
#. de: Es blitzt, es kribbelt ... Wer will mal fühlen?
#. fr: Qui veut danser avec la foudre<nbsp>!?
msgctxt "InstanceContentTextData:22002:0:0"
msgid "This may tingle a bit!"
msgstr "Щекотно будет!"

#. ja: ピカピカ、光ル……キレイ、ナ、オ空……！
#. de: Es leuchtet, es funkelt ... so ein schöner Himmel!
#. fr: La Lumière brille brille brille<nbsp>! Que le ciel est joli<nbsp>!
msgctxt "InstanceContentTextData:22003:0:0"
msgid "This is the rhythm of the light!"
msgstr "Вот так сияет свет!"

#. ja: ウネウネ、伸ビテ……ドコマデモ……！
#. de: Wurzeln, streckt euch! Streckt euch weit!
#. fr: Rien n'arrête de belles racines serpentantes<nbsp>!
msgctxt "InstanceContentTextData:22004:0:0"
msgid "Twist and sprout!"
msgstr "Вейся, расти!"

#. ja: 狭イ、オ城……モウ、イヤ……！<br>森ノ、中デ……アソビマショ……！
#. de: Das Schloss ist so eng, die Luft so stickig ... Ich will raus, in den Wald!
#. fr: J'en ai assez de ce château<nbsp>! Jouons dans la forêt<nbsp>!
msgctxt "InstanceContentTextData:22005:0:0"
msgid "We're sick of this cramped old castle! Let's play in the forest!"
msgstr "Надоел этот тесный старый замок! Пойдём играть в лес!"

#. ja: 踊レ、踊レ、木ノ葉ト、踊レ……！
#. de: Tanzt, Blätter, tanzt mit uns!
#. fr: Dansez avec les feuilles<nbsp>! Tournez, virevoltez<nbsp>!
msgctxt "InstanceContentTextData:22006:0:0"
msgid "Dance like the leaves on the boughs!"
msgstr "Танцуйте, как листья на ветру!"

#. ja: アハハ、楽シイ……！<br>モット、モット……アソビ、マショ！
#. de: Spielen wir weiter? Es ist ein so schöner Spaß!
#. fr: Ah ah ah<nbsp>! Qu'est-ce qu'on s'amuse<nbsp>! Allez, la fête continue<nbsp>!
msgctxt "InstanceContentTextData:22007:0:0"
msgid "This is so much fun! Let's play some more!"
msgstr "Как весело! Давайте ещё поиграем!"

#. ja: グルグル、巡ル……水ヨ、オイデ……！
#. de: Feen des Wassers, macht ihr mit?
#. fr: Quelqu'un se cacherait-il dans l'eau<nbsp>!? Sors de là<nbsp>!
msgctxt "InstanceContentTextData:22008:0:0"
msgid "Wet, wet, wet!"
msgstr "Мокро, мокро, мокро!"

#. ja: メラメラ、燃エル……オコリンボ……！
#. de: Feen des Feuers, seid dabei!
#. fr: Ne jouez pas trop avec le feu<nbsp>!
msgctxt "InstanceContentTextData:22009:0:0"
msgid "When you play with fire..."
msgstr "Кто с огнём играет..."

#. ja: ドッチ、コッチ……ワカル、カナ……？
#. de: Hier hin oder da hin? Was wird's sein?
#. fr: Hmm... Ça ce serait drôle, mais ça aussi. Qu'est-ce qu'on fait<nbsp>?
msgctxt "InstanceContentTextData:22010:0:0"
msgid "Can you guess which one?"
msgstr "Угадаешь, какой?"

#. ja: アハハハハ……！<br>モット、モット、木々ヨ、茂レ……！
#. de: Hahahaha! Wachst, Bäume, streckt euch hinauf!
#. fr: Ah ah ah<nbsp>! Poussez un peu plus vite, mes petits<nbsp>!
msgctxt "InstanceContentTextData:22011:0:0"
msgid "Grow, my lovelies! Grow!"
msgstr "Растите, мои милые! Растите!"

#. ja: アノ子モ、コノ子モ……大キク、ナァ～レ！
#. de: Sprießt, meine Lieben, wachst und sprießt!
#. fr: Plus gros<nbsp>! Plus gros<nbsp>! Plus gros<nbsp>!
msgctxt "InstanceContentTextData:22012:0:0"
msgid "Bigger is better!"
msgstr "Больше — лучше!"

#. ja: ナンデ……痛クスル、ノ……？<br>ドウ、シテ……虐メル、ノ……？
#. de: Warum tust du mir so weh? Das ist gemein ...
#. fr: Vous me faites mal... Pourquoi êtes-vous si méchants...<nbsp>?
msgctxt "InstanceContentTextData:22013:0:0"
msgid "Owww, that hurts! You play rough!"
msgstr "Ай! Больно! Ну и грубо же ты играешь!"

#. ja: 眠ラズ、見ル夢……モゥ、飽キタ……<br>死スべキ、定メ、抗エナイ……ダカラ、眠レ、永遠ニ……！
#. de: Ich bin des Tagtraumes müde ... Zeit, den ewigen Schlaf zu finden.
#. fr: Ces songes m'ennuient, et puis... vous n'échapperez jamais à votre destin, pauvres petits mortels.<br>Là... dormez, maintenant... et ne vous réveillez jamais<nbsp>!
msgctxt "InstanceContentTextData:22015:0:0"
msgid "I grow weary of this waking dream. 'Tis time to sleep for good."
msgstr "Надоело мне видеть сны наяву. Пора уснуть навеки."

#. ja: アノ子モ、コノ子モ……消エチャッタ……<br>ドウシテ、ドウシテ、ドウ、シテ……！！
#. de: Wo sind sie alle hin? Warum haben sie mich verlassen?
#. fr: Mais... Mais...<nbsp>? Où sont-ils tous passés...<nbsp>? Rendez-moi mes amis<nbsp>!
msgctxt "InstanceContentTextData:22016:0:0"
msgid "Where did everyone go? Why did they all leave me?"
msgstr "Куда все подевались? Почему они меня бросили?"

#. ja: アノ子モ、コノ子モ……ミンナ、オイデ！<br>楽シク、激シク、遊ビマショ……！
#. de: Kommt, meine Kinder! Je mehr, desto lustiger!
#. fr: Plus on est de fous, plus on rit<nbsp>! Venez, mes petits<nbsp>!
msgctxt "InstanceContentTextData:22017:0:0"
msgid "The more the merrier! Join us, my children!"
msgstr "Чем больше, тем веселее! Идите к нам, детки!"

#. ja: 紫黒のギャップへの到達
#. de: Zur Lavendellichtung vordringen
#. fr: Atteindre La Talure
msgctxt "InstanceContentTextData:22100:0:0"
msgid "Arrive at the Wound"
msgstr "Доберитесь до Раны"

#. ja: 紫黒のギャップの突破
#. de: Die Lavendellichtung sichern
#. fr: Franchir La Talure
msgctxt "InstanceContentTextData:22101:0:0"
msgid "Clear the Wound"
msgstr "Зачистите Рану"

#. ja: 家畜市広場への到達
#. de: Zum Viehmarkt durchkämpfen
#. fr: Atteindre la place du Cheptel
msgctxt "InstanceContentTextData:22102:0:0"
msgid "Arrive in the Auction"
msgstr "Доберитесь до Аукциона"

#. ja: 家畜市広場の突破
#. de: Den Viehmarkt zurückerobern
#. fr: Franchir la place du Cheptel
msgctxt "InstanceContentTextData:22103:0:0"
msgid "Clear the Auction"
msgstr "Зачистите Аукцион"

#. ja: マナーハウスの前庭への到達
#. de: Den Garten des Herrenhauses erreichen
#. fr: Atteindre l'esplanade du Manoir
msgctxt "InstanceContentTextData:22104:0:0"
msgid "Arrive in the manor house courtyard"
msgstr "Доберитесь до двора поместья"

#. ja: <sheet BNpcName 8301 0>の撃破
#. de: <sheet BNpcName 8301 0> bezwingen
#. fr: Vaincre <sheet BNpcName 8301 0>
#. macro: <sheet BNpcName 8301 0> — a value from a game data sheet, such as a name; sheet = BNpcName, row = 8301, column = 0 (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:22105:0:0"
msgid "Defeat <sheet BNpcName 8301 0>"
msgstr "Победите <sheet BNpcName 8301 0>"

#. ja: ア、ア、ア……アガガガガガ…………！
#. de: Ah ... Aaah ... Guaaaaah ...
#. fr: Ah... ah... ah... Graaargh<nbsp>!
msgctxt "InstanceContentTextData:22106:0:0"
msgid "Ah...ah...ah... Graaargh!"
msgstr "Ах... ах... аааа..."

#. ja: オオォォォォォォン！！！
#. de: Ooooooooorgh!
#. fr: Grrraaarrrgh<nbsp>!!!
msgctxt "InstanceContentTextData:22107:0:0"
msgid "Grrraaarrrgh!!!"
msgstr "Грррраааа!!!"

#. ja: 忌々しい光の力……星を喰らう化け物め……！<br>ここで終わりなき戦いに終止符を打つ！
#. de: Diener des verfluchten Lichts, diese Welt gehört nicht euch!
#. fr: Vils servants de la Lumière... Je vais mettre un terme à votre existence<nbsp>! Vous n'aurez pas cet astre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:22200:0:0"
msgid "Servants of the accursed Light,<br>this world is not yours to claim!"
msgstr "Слуги проклятого Света,<br>этому миру не место в ваших руках!"

#. ja: 我が力を以てすれば、世を隔てる境界など薄皮に等しい！<br>その傷口より、開け……昏き深淵よ！
#. de: Durch meine Hand wird der Schleier zwischen unseren Welten aufgerissen!
#. fr: Les barrières entre nos mondes ne sont rien de plus qu'un tissu chétif face à ma puissance<nbsp>!
msgctxt "InstanceContentTextData:22202:0:0"
msgid "By my hand, the veil between our worlds is torn open!"
msgstr "Моей рукой завеса между мирами будет разорвана!"

#. ja: さあ、もう一度だ……深淵へと通じ得る境界を斬り裂かん！
#. de: Blickt in den Abgrund und verzweifelt!
#. fr: Contemplez les abysses, suppôts de la Lumière<nbsp>!
msgctxt "InstanceContentTextData:22203:0:0"
msgid "Gaze into the abyss and despair!"
msgstr "Взгляните в бездну и познайте отчаяние!"

#. ja: 我が魔法を遅延させよう……<br>死の言霊は、睦言のように甘く、密やかに忍び寄るのだ……。
#. de: Es ist zu spät, um um Vergebung zu flehen.<br>Euer Schicksal ist besiegelt.
#. fr: L'appel de la mort est inexorable.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:22204:0:0"
msgid "It is too late to beg forgiveness.<br>Your fate is sealed."
msgstr "Просить прощения уже поздно.<br>Ваш приговор вынесен."

#. ja: 混沌を司るは闇の力……<br>昏き魔力よ、限りなく増大し、終末をも覆いつくせ！
#. de: Möge der Schatten das Licht auslöschen!
#. fr: Les Ténèbres règnent sur le chaos. Noyez-vous dans leur noirceur<nbsp>!
msgctxt "InstanceContentTextData:22205:0:0"
msgid "May shadow blot out the Light!"
msgstr "Пусть тьма поглотит Свет!"

#. ja: 嗚呼、昏き深淵よ！<br>世を隔てる悪しき境界を引き裂け！
#. de: Aus den Tiefen des Risses nähert sich euer Untergang<nbsp>...
#. fr: Ô sombres abysses<nbsp>! Brisez les barrières et immiscez-vous dans ce monde<nbsp>!
msgctxt "InstanceContentTextData:22206:0:0"
msgid "From beyond the rift, your doom draws near..."
msgstr "Из-за разлома надвигается ваша погибель..."

#. ja: その昏き虚ろより、魔力を引き出さん……！
#. de: Eure Bosheit wird nicht ungestraft bleiben!
#. fr: Vos péchés ne resteront pas impunis<nbsp>!
msgctxt "InstanceContentTextData:22207:0:0"
msgid "Your evil will not go unpunished! "
msgstr "Ваше зло не останется безнаказанным! "

#. ja: 光に目を焼かれた者どもめ……<br>貴様たちに、定めを示してみせよう！
#. de: Verwüster der Welten, euer Urteil steht an!
#. fr: Voici le destin de ceux qui se laissent aveugler par la Lumière<nbsp>!
msgctxt "InstanceContentTextData:22208:0:0"
msgid "Ravager of worlds, judgment is upon you!"
msgstr "Разрушители миров, вам вынесен приговор!"

#. ja: <sheet BNpcName 8382 0>の撃破
#. de: Nichtswandler bezwingen
#. fr: Vaincre la marcheuse du néant
msgctxt "InstanceContentTextData:22209:0:0"
msgid "Defeat Voidwalker"
msgstr "Одолеть Путника Бездны"

#. ja: もはや、これ以上、戦い続ける意味はなし……。<br>その魂を無に帰すべき時が来た……！
#. de: Geist, Körper und Seele<nbsp>...<br>Ich werde euch auslöschen!
#. fr: Finissons-en... Que ce soit votre corps ou votre âme, rien ne subsistera<nbsp>!
msgctxt "InstanceContentTextData:22210:0:0"
msgid "I shall erase you from existence─mind, body, and soul!"
msgstr "Я сотру вас из бытия — разум, тело и душу!"

#. ja: 光に溺れた愚者どもめ……その首を断ち斬ってくれるッ！
#. de: Meine Klinge lechzt nach eurem Lebensblut, Sünder!
#. fr: Abjectes défenseurs de la Lumière... J'aurai vos têtes<nbsp>!
msgctxt "InstanceContentTextData:22211:0:0"
msgid "My blade hungers for your lifeblood, evil one!"
msgstr "Мой клинок жаждет вашей крови, злодей!"

#. ja: 下位の罪喰いを倒せ！
#. de: Besiege die Sünden<shy>ver<shy>tilger!
#. fr: Vainquez les purgateurs<nbsp>!
msgctxt "InstanceContentTextData:22300:0:0"
msgid "Defeat the lesser eater!"
msgstr "Победите младшего грехоеда!"

#. ja: ソープロシュネーを倒せ！
#. de: Besiege Sophrosyne!
#. fr: Vainquez Sophrosyne<nbsp>!
msgctxt "InstanceContentTextData:22301:0:0"
msgid "Defeat Sophrosyne!"
msgstr "Победите Софросину!"

#. ja: 大再生魔法を求めるラミットの冒険を追体験せよ！
#. de: Besiege Ixtlilton!
#. fr: Vainquez Ixtlilton<nbsp>!
msgctxt "InstanceContentTextData:22302:0:0"
msgid "Relive Lamitt's battle in pursuit of ancient secrets!"
msgstr "Вновь переживите битву Ламитт, в которой она искала древние тайны!"

#. ja: 焦るなよ、<split " " 1><string $gs1></split>……！<br>まずは様子見して、情報を集めるんじゃ……！
#. de: Nur nichts überstürzen, <split " " 1><string $gs1></split> ... Beobachten wir zuerst, was sie macht.
#. fr: (Ne fonce pas dans l'tas, <split " " 1><string $gs1></split><nbsp>! Voyons d'abord ce qu'elle va faire...)
msgctxt "InstanceContentTextData:22305:0:0"
msgid "Watch closely..."
msgstr "Смотри в оба..."

#. ja: ソープロシュネーが動くぞい……！<br>再生能力を使う様子を、よく見ておくんじゃ……！
#. de: Jetzt heißt es Augen auf! Gleich zeigt sie uns ihren Spezialtrick!
#. fr: (Elle prépare son sort<nbsp>! N'en rate pas une miette<nbsp>!)
msgctxt "InstanceContentTextData:22306:0:0"
msgid "Wait for it... There!"
msgstr "Жди... Вот оно!"

#. ja: やはり、復活させよった……！<br>しかし……もう一匹は、なぜ再生しようとせん……？
#. de: Sie hat ihn tatsächlich wiederbelebt ... Aber warum nur den einen?
#. fr: (Elle a réussi à le ranimer, comme prévu. Par contre, qu'attend-elle pour s'occuper de l'autre...<nbsp>?)
msgctxt "InstanceContentTextData:22307:0:0"
msgid "...Why doesn't it fix the other one, though?"
msgstr "...А второго почему не воскрешает?"

#. ja: ええい、わからんことを考えても仕方がないの……！<br>よし、仕掛けるぞい！　<split " " 1><string $gs1></split>！
#. de: Darüber denken wir später nach. Jetzt geben wir ihr erst mal Saures!
#. fr: (Oh, et pis zut<nbsp>! C'est pas le moment de cogiter<nbsp>! On y va, part'naire<nbsp>!)
msgctxt "InstanceContentTextData:22308:0:0"
msgid "Well, makes our lives easier, I guess. Chaaarge!"
msgstr "Ну, нам же проще. В атаку!"

#. ja: ソープロシュネーを叩こうにも、周りが邪魔じゃな……！<br>まずは雑魚から片付けるぞい！
#. de: Grr, da müssen wir wohl erst mal das Kleinvieh beseitigen.
#. fr: Je m'occupe de c'lui-là, sinon il va nous gêner<nbsp>!
msgctxt "InstanceContentTextData:22309:0:0"
msgid "Take down the weakling first!"
msgstr "Сначала прикончим слабого!"

#. ja: ア……ア、アアァ……ア…………！
#. de: Ah ... Aaaahrgg!
#. fr: Ah... aaAAAHHHH<nbsp>!!!
msgctxt "InstanceContentTextData:22310:0:0"
msgid "\\<huff>"
msgstr ""

#. ja: さすがは、ワシが見込んだ相棒じゃ！<br>この調子で、一気に叩きのめすぞい！
#. de: Sehr gut, <split " " 1><string $gs1></split>! Weiter so!
#. fr: Je le sens qui faiblit<nbsp>! Continue comme ça, <split " " 1><string $gs1></split><nbsp>!
msgctxt "InstanceContentTextData:22311:0:0"
msgid "Ha! Ain't no match for us!"
msgstr "Ха! Нам с тобой не ровня!"

#. ja: よし、いいぞい！<br>次はソープロシュネーを……って、なんじゃ！？
#. de: Hah, jetzt können wir uns Sophrosyne ... Huch! Verflixt noch mal!
#. fr: Bravo nous<nbsp>! Au tour de Sophro... Quoi<nbsp>!?
msgctxt "InstanceContentTextData:22312:0:0"
msgid "Now for Sophrosy─ Oh. Shite."
msgstr "Ну, теперь за Софросину... Вот же дрянь."

#. ja: ええい、またも雑魚を復活させよったぞ！<br>なんとやっかいな……！
#. de: Sie hat ihr Gefolge schon wieder zurückgeholt! Hört das nie auf?
#. fr: Rah...<nbsp>! Elle s'lasse jamais, ma parole<nbsp>! Changeons de stratégie<nbsp>!
msgctxt "InstanceContentTextData:22313:0:0"
msgid "How does it do that so fast?"
msgstr "Как оно так быстро их поднимает?"

#. ja: よし、雑魚のことはワシが引き付けておく！<br>その間に相棒はソープロシュネーを叩いてくれい！
#. de: Das Bleichgesicht übernehme ich. Knöpf du dir Sophrosyne vor!
#. fr: Je vais tenir ce blanc-bec en respect<nbsp>! Pendant ce temps, essaie de vaincre Sophrosyne tout<if $gn4>e</if> seul<if $gn4>e</if><nbsp>!
msgctxt "InstanceContentTextData:22314:0:0"
msgid "Right. Divide and conquer, then. You take Sophrosyne."
msgstr "Ладно, разделимся. Софросину берёшь на себя."

#. ja: クッ……さしものワシも、そろそろ辛いぞい！<br><split " " 1><string $gs1></split>、治癒を頼むぞい！
#. de: Puh, jetzt wird's langsam eng. <split " " 1><string $gs1></split>, hilf mir mal auf die Beine.
#. fr: Gnargh... Il... Il tape dur... Des soins seraient pas de refus, <split " " 1><string $gs1></split><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:22315:0:0"
msgid "Urgh... Can I get some help, <split \" \" 1><string $gs1></split>?"
msgstr "Ох... Поможешь мне, <split \" \" 1><string $gs1></split>?"

#. ja: その調子じゃ！<br>このまま押して、押して、押しまくるんじゃ！
#. de: So ist es recht! Nicht lockerlassen!
#. fr: Je la vois qui commence à fléchir<nbsp>! Continue comme ça, <split " " 1><string $gs1></split><nbsp>!
msgctxt "InstanceContentTextData:22316:0:0"
msgid "It's working! Keep at it!"
msgstr "Получается! Не сбавляй темп!"

#. ja: やったか……！<br>さすがは相棒…………む、どうした……！？
#. de: Sehr gut! So kenne ich <if $gn4>meine Partnerin<else>meinen Partner</if> ... He, was ist los?
#. fr: Bien joué, part'naire<nbsp>! Je savais que... Q-qu'est-ce qui se passe<nbsp>!?
msgctxt "InstanceContentTextData:22317:0:0"
msgid "Ha! Take that, you─ What!?"
msgstr "Ха! Получай, тва... Что?!"

#. ja: ご、ごめんなさい……。<br>こんなところで、倒れる……なんて……。
#. de: Verzeiht mir, Freunde ... Dabei waren wir so kurz vorm Ziel ...
#. fr: Si près du but... Pardonnez-moi, mes amis... Pardonne-moi... pe... ti...
msgctxt "InstanceContentTextData:22318:0:0"
msgid "I'm so sorry... After everything you did for me..."
msgstr "Простите... После всего, что вы для меня сделали..."

#. ja: チクショウ……力量が不足していたってことか……。
#. de: Verflucht! Meine Kräfte ... reichen nicht.
#. fr: B-bordel... Je manquais encore autant de force...<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:22319:0:0"
msgid "How am I <i>still</i> not strong enough?"
msgstr "Да сколько же мне ещё <i>надо</i> стать сильнее?"

#. ja: ごめん……もう……体力の限界……だよ……。
#. de: Ich ... kann nicht mehr ... Es tut mir leid \<hust>
#. fr: Désolée... Je suis à bout...
msgctxt "InstanceContentTextData:22320:0:0"
msgid "I'm...\\<huff>...not going to make it..."
msgstr ""

#. ja: すみません……足を引っ張ってしまって……。
#. de: Vergebt mir ... Wegen mir scheitern wir nun ...
#. fr: Nous allons échouer... par ma faute...
msgctxt "InstanceContentTextData:22321:0:0"
msgid "I can't keep up..."
msgstr "Я не успеваю..."

#. ja: 私が敵を引き付けます！<br>ラミット！　回復を頼みますよ！
#. de: Ich locke sie her! Lamitt, übernimm die Heilung!
#. fr: C'est parti<nbsp>! Lamitt, je compte sur toi pour les soins<nbsp>!
msgctxt "InstanceContentTextData:22322:0:0"
msgid "I'll keep it busy!"
msgstr "Я отвлеку его!"

#. ja: にゃっ……痺れる……！<br>「エスナ」をお願い……ラミット……！
#. de: Ahrg, ich spüre meinen Körper nicht mehr ... Lamitt, ich brauche Medica!
#. fr: Argh... Son attaque m'a engourrrdi les bras<nbsp>! Lance-moi Guérison quand tu auras le temps, Lamitt<nbsp>!
msgctxt "InstanceContentTextData:22323:0:0"
msgid "Ouch! Please tell me your Esuna can fix this..."
msgstr "Ай! Скажи, что твоё «Эсна» это снимет..."

#. ja: ありがと、助かったよ！<br>さあ、反撃の始まりだからね！
#. de: Puh, danke. Jetzt schlagen wir zurück!
#. fr: Merrrci<nbsp>! Je passe à la contre-attaque<nbsp>!
msgctxt "InstanceContentTextData:22324:0:0"
msgid "Much better! And now I take my revenge..."
msgstr "Вот теперь лучше! А теперь я отомщу..."

#. ja: ラミット、その攻撃は危険だ！<br>こっちに来てくれ！
#. de: Lamitt, greif ihn nicht alleine an! Halt dich an uns!
#. fr: Lamitt<nbsp>! Tu pourras pas l'encaisser seule celle-là, colle-toi bien à nous<nbsp>!
msgctxt "InstanceContentTextData:22325:0:0"
msgid "It's a big one! To me, quickly!"
msgstr "Сильный удар! Быстро ко мне!"

#. ja: みんな、守ってくれて、ありがとう！
#. de: Danke, dass ihr mich geschützt habt.
#. fr: Merci de m'avoir protégée<nbsp>!
msgctxt "InstanceContentTextData:22326:0:0"
msgid "Nicely done, everyone!"
msgstr "Отлично сработано, ребята!"

#. ja: 俺が狙われている……！？<br>強烈なのが来るぞ！
#. de: Er hat es auf mich abgesehen! Das sieht gar nicht gut aus!
#. fr: Il me cible<nbsp>!? Ça sent pas bon, ça<nbsp>!
msgctxt "InstanceContentTextData:22327:0:0"
msgid "I don't know what's coming, but it can't be good..."
msgstr "Не знаю, что сейчас будет, но ничего хорошего..."

#. ja: ぐあっ……か、身体から……力が抜けて……！<br>ラミット、体力を……全快してくれ……！
#. de: Urgh ... Ich bin völlig kraftlos ... Lamitt! Eine Stärkung, schnell!
#. fr: Ah... Ahh... Je sens la vie... qui m'abandonne... Lamitt<nbsp>! Aide-moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:22328:0:0"
msgid "Gods, it's as if my strength is being drained somehow...<br>I need you to heal me as much as you can!"
msgstr "Боги, будто из меня силы вытягивают...<br>Вылечи меня как следует!"

#. ja: 助かった、ラミット！　命拾いをしたぜ……！
#. de: Danke, Lamitt! Das war haarscharf.
#. fr: Ça va mieux<nbsp>! Merci, Lamitt<nbsp>!
msgctxt "InstanceContentTextData:22329:0:0"
msgid "You did it! I'm alright!"
msgstr "Получилось! Я в порядке!"

#. ja: 気をつけて……ロンカの石像が動き出しました！<br>こんな仕掛けがあったなんて……！
#. de: Pass auf! Die Statuen bewegen sich!
#. fr: Les statues<nbsp>! Elles se mettent à bouger<nbsp>! L'endroit était mieux gardé qu'on le pensait<nbsp>!
msgctxt "InstanceContentTextData:22330:0:0"
msgid "The statues─they're moving!"
msgstr "Статуи... они двигаются!"

#. ja: 敵は俺が引き受ける！　レンダ・レイ、手を貸してくれ！
#. de: Ich locke sie her! Renda-Rae, hilf mir!
#. fr: Je les prends<nbsp>! Renda, tu me files un coup de main<nbsp>!?
msgctxt "InstanceContentTextData:22331:0:0"
msgid "I'll draw their focus. Meanwhile..."
msgstr "Я отвлеку их. А ты..."

#. ja: わかったよ！<br>一気に仕留めてやるから、それまで踏ん張ってよね！
#. de: Alles klar! Halt noch einen Moment durch, dann erledige ich sie auf einen Schlag!
#. fr: J'en fais mon affairrre<nbsp>! Accroche-toi<nbsp>!
msgctxt "InstanceContentTextData:22332:0:0"
msgid "Say no more! Just keep them in one place."
msgstr "Поняла! Удержи их на месте."

#. ja: うっ……思ったよりも、硬い……！<br>でも、負けないんだからッ！
#. de: Grr ... Hartnäckiger als gedacht. Aber die erledigen wir schon noch!
#. fr: Grrr... Ils sont plus costauds que je le crrroyais<nbsp>! Mais c'est pas ça qui les sauvera<nbsp>!
msgctxt "InstanceContentTextData:22333:0:0"
msgid "Tougher than I thought... But I'll get you yet!"
msgstr "Крепче, чем я думала... Но я вас ещё достану!"

#. ja: ふう……どうやら石像は片付いたみたいだな！<br>あとはヤツだけ……このまま押し切るぞ！
#. de: Die Statuen wären wir los! Jetzt nur noch der hier<nbsp>...
#. fr: Pfiou... Et voilà, un beau tas de gravier<nbsp>! Allez, on se concentre sur l'autre tas de plume<nbsp>!
msgctxt "InstanceContentTextData:22334:0:0"
msgid "That's all of them. Now, let's finish this!"
msgstr "Ну вот и всё. Теперь добьём последнего!"

#. ja: ラミット、狙われているようです……！<br>こちらの近くに来てください！
#. de: Lamitt, sie hat dich im Visier! Komm hierher in Deckung!
#. fr: La chouette t'a prise pour cible, Lamitt<nbsp>! Rapproche-toi de moi, je vais te couvrir<nbsp>!
msgctxt "InstanceContentTextData:22335:0:0"
msgid "It's going for you, Lamitt! Come here!"
msgstr "Ламитт, оно нацелилось на тебя! Иди сюда!"

#. ja: ち、力が……抜けて……ラミット……回復を早くッ！
#. de: \<hust> ... Lamitt ... Heil mich, bevor es zu spät ist ...
#. fr: Ahh... Ahhh... Je... Je vais perdre con<shy>nais<shy>san<shy>ce... Lamitt, restaure toute ma vitalité, sans quoi, je...
msgctxt "InstanceContentTextData:22336:0:0"
msgid "I need...help..."
msgstr "Мне... помоги..."

#. ja: 呪いの気配が消えた！？<br>ラミットの治癒魔法のおかげですね……！
#. de: Der Fluch ist aufgehoben! Das muss deine Heilmagie sein, Lamitt!
#. fr: La malédiction...<nbsp>! Ta magie l'a contrecarrée, Lamitt<nbsp>!
msgctxt "InstanceContentTextData:22337:0:0"
msgid "I get the feeling that you just saved my life. Again!"
msgstr "Похоже, ты опять спасла мне жизнь!"

#. ja: あともう一息だ……！<br>みんな、全力で攻撃を集中させるぞ！
#. de: Gleich haben wir's geschafft! Gebt alles, was ihr habt!
#. fr: Donnez tout ce que vous avez<nbsp>! Je sens qu'on y est presque<nbsp>!
msgctxt "InstanceContentTextData:22338:0:0"
msgid "We're so close! Hit it with everything you've got!"
msgstr "Мы почти у цели! Бейте изо всех сил!"

#. ja: ラミット、お前の動きに合わせて仕掛けるぞ！<br>覚悟が決まったら、行動してくれ！
#. de: Lamitt, wir richten uns nach dir! Auf dein Zeichen!
#. fr: À toi l'honneur, Lamitt<nbsp>! On ouvre le bal quand tu veux<nbsp>!
msgctxt "InstanceContentTextData:22339:0:0"
msgid "We'll follow your lead, Lamitt!"
msgstr "Мы за тобой, Ламитт!"

#. ja: ラミット……早く全快してくれ……！
#. de: Lamitt ... Ich brauche dringend Hilfe ... Wirk deinen stärksten Spruch!
#. fr: Lamitt...<nbsp>! J'ai... J'ai besoin de tout ce que tu as en soin, maintenant<nbsp>! Sinon...<nbsp>!
msgctxt "InstanceContentTextData:22340:0:0"
msgid "If I'm not fully healed soon, I think I might...\\<pant>"
msgstr ""

#. ja: 覚悟せよ、これよりは裁きの刻ダ！
#. de: Frohlocket, denn eure Erlösung naht!
#. fr: Approchez... L'heure de votre jugement a sonné<nbsp>!
msgctxt "InstanceContentTextData:22400:0:0"
msgid "Come, then! Prepare for judgment!"
msgstr "Ну же! Готовьтесь к суду!"

#. ja: 来たれ、下僕よ……！<br>反逆者の罪を喰らい尽くセッ！
#. de: Kommt, meine Diener. Zeigt Mitleid und tilgt ihre Sünden!
#. fr: Venez, mes petits, le repas est servi<nbsp>! Au menu<nbsp>: des rebelles dodus et juteux<nbsp>!
msgctxt "InstanceContentTextData:22401:0:0"
msgid "To me, my servants! Feast upon these villains and their foul sins!"
msgstr "Ко мне, слуги! Пируйте на этих злодеях и их скверных грехах!"

#. ja: 不甲斐ないお前たちに、慈悲と祝福を授けよウ！
#. de: Ihr enttäuscht, meine Diener, doch ich will euch meine Gnade schenken.
#. fr: Mes pauvres petits anges chétifs... Recevez ma bénédiction<nbsp>!
msgctxt "InstanceContentTextData:22402:0:0"
msgid "Receive of me my blessing and rise higher!"
msgstr "Примите моё благословение и возвысьтесь!"

#. ja: 容易にはくたばらないカ……だが！
#. de: Ihr seid hartnäckig ...
#. fr: Vous m'avez assez diverti comme ça... Finissons-en<nbsp>!
msgctxt "InstanceContentTextData:22403:0:0"
msgid "Fine, fine! If you refuse to die..."
msgstr "Ладно, ладно! Раз не желаете умирать..."

#. ja: 苦しかろう、つらかろウ！　それが罰であル！
#. de: Euer Hochmut wird bestraft werden!
#. fr: Vous souffrez<nbsp>? C'est normal. Ceci est votre châtiment<nbsp>!
msgctxt "InstanceContentTextData:22404:0:0"
msgid "Then you will suffer! Yes! That will be your punishment!"
msgstr "Будет вам больно! Да! Это ваша кара!"

#. ja: さあ悔いヨ！　さあ、さあ、さあッ……！
#. de: Ihr werdet es bereuen!
#. fr: Vous regrettez à présent, n'est-ce pas<nbsp>? N'EST-CE PAS<nbsp>!?
msgctxt "InstanceContentTextData:22405:0:0"
msgid "Suffer, suffer, suffer! Suffer and know your folly!"
msgstr "Страдайте, страдайте, страдайте! Страдайте и познайте свою глупость!"

#. ja: この反逆者ども……<br>なぜ抗ウ！　なぜ、屈しなイ！
#. de: Störenfriede ... Warum widersetzt ihr euch dem Frieden?
#. fr: Je ne comprends pas... Pourquoi refusez-vous de vous soumettre<nbsp>!?
msgctxt "InstanceContentTextData:22406:0:0"
msgid "Damn you... Why do you not fall?"
msgstr "Будьте вы прокляты... Почему не падаете?"

#. ja: ナゼ、ナゼ、ナゼェェェェェ……ッ！
#. de: Warum? WAARUUUUHUHUM!
#. fr: Pourquoi... POURQUOOOI<nbsp>!?
msgctxt "InstanceContentTextData:22407:0:0"
msgid "Why? WHYYY!?"
msgstr "Почему? ПОЧЕМУУУУ?!"

#. ja: アガガ、熱イ、熱イィ～！
#. de: Aaah, es brennt!
#. fr: Aguaaargh<nbsp>! Ça brûle<nbsp>! Ça brûûûle<nbsp>!
msgctxt "InstanceContentTextData:22408:0:0"
msgid "Graaargh! It burns, it burns!"
msgstr "Грррааах! Горит, горит!"

#. ja: ハァ、ハァ……このチカラ、は……！
#. de: Ah, aah ... Ich spüre es.
#. fr: Quelle est donc... cette puissance<nbsp>!?
msgctxt "InstanceContentTextData:22409:0:0"
msgid "What...what is this?"
msgstr "Что... что это?"

#. ja: 光があふれル！　嗚呼、甘美なり！！
#. de: Das Licht in meinem Inneren<nbsp>... Welch Erhabenheit, welch Hochgefühl!
#. fr: Je sens la Lumière affluer en moi<nbsp>! Quelle sensation<nbsp>!
msgctxt "InstanceContentTextData:22410:0:0"
msgid "The Light surges within me! Ahhh, such bliss!"
msgstr "Свет переполняет меня! Ах, какое блаженство!"

#. ja: そうか、これは神として再誕するための受難か……。
#. de: Dies ist der Moment meiner Gottwerdung!
#. fr: Voici donc l'ultime épreuve avant ma renaissance en dieu...
msgctxt "InstanceContentTextData:22411:0:0"
msgid "I see now... This is the passion of my ascension..."
msgstr "Понимаю... Это страдание — ступень к моему вознесению..."

#. ja: ならば、全能者「イノセンス」は、この戦いを受け入れよう！
#. de: Lasst das Leiden beginnen! Innozenz ist bereit!
#. fr: Moi, l'innocence incarnée, je relève le défi<nbsp>!
msgctxt "InstanceContentTextData:22412:0:0"
msgid "Very well, I shall embrace this trial!"
msgstr "Что ж, я приму это испытание!"

#. ja: これより、裁きを執行する……！
#. de: Es ist Zeit für eure Läuterung!
#. fr: Votre heure a sonné...
msgctxt "InstanceContentTextData:22413:0:0"
msgid "Your reckoning comes."
msgstr "Ваш час расплаты настал."

#. ja: その罪ごと、断たれて消えよッ！
#. de: Ich teile Fleisch von Sünde!
#. fr: Laissez-moi vous libérer de vos péchés<nbsp>!
msgctxt "InstanceContentTextData:22414:0:0"
msgid "I shall excise the sin of your existence!"
msgstr "Я вырежу самый грех вашего бытия!"

#. ja: 刻は来たれり！<br>我は全能神「イノセンス」として再誕を果たすッ！
#. de: Meine Wiedergeburt als Innozenz ist vollendet!
#. fr: Ma résurrection est accomplie<nbsp>! Je suis l'innocence divine<nbsp>!
msgctxt "InstanceContentTextData:22415:0:0"
msgid "My ascension to godhood is complete!"
msgstr "Час настал! Моё вознесение завершено!"

#. ja: ナイルベルトとアルバートの邂逅を追体験せよ！
#. de: Durchlebe Nyelberts und Ardberts ursprüngliches Abenteuer!
#. fr: Revivez la rencontre entre Nyelbert et Ardbert<nbsp>!
msgctxt "InstanceContentTextData:22500:0:0"
msgid "Relive Nyelbert and Ardbert's initial adventure!"
msgstr "Переживите заново первое приключение Нильберта и Ардберта!"

#. ja: ボヴァインを倒せ
#. de: Besiege Bovian!
#. fr: ボヴァインを倒せ
msgctxt "InstanceContentTextData:22501:0:0"
msgid "ボヴァインを倒せ"
msgstr "ボヴァインを倒せ"

#. ja: さっさと目的のボヴァインを倒して、脱出路を探すとしよう。<br>それまで、よろしく頼むぜ、ナイルベルト！
#. de: Deine Hilfe ist mehr als willkommen, Nyelbert. Lass uns kurzen Prozess mit dieser Bestie machen und von hier verschwinden, solange wir noch können.
#. fr: Une fois que Bovian aura mordu la poussière, on cherchera un moyen de sortir de ce trou. D'ici là, on compte tous sur toi, Nyelbert<nbsp>!
msgctxt "InstanceContentTextData:22503:0:0"
msgid "Your aid is most welcome, Nyelbert. Let us make short work of the beast, and take our leave of this place while we still can."
msgstr "Твоя помощь нам очень кстати, Нильберт. Быстро расправимся с этой тварью и уберёмся отсюда, пока ещё можем."

#. ja: …………ああ。
#. de: ... Einverstanden.
#. fr: ... Je ne vous décevrai pas.
msgctxt "InstanceContentTextData:22504:0:0"
msgid "...Indeed."
msgstr "...Именно."

#. ja: 来やがったな……！<br>ナイルベルト、敵は俺たちが引き付ける！
#. de: Sie kommen! Nyelbert, wir werden die Angriffe des Feindes auf uns ziehen!
#. fr: On s'occupe de les attirer<nbsp>! À toi de jouer, Nyelbert<nbsp>!
msgctxt "InstanceContentTextData:22505:0:0"
msgid "They come! Nyelbert, we will draw our foe's attack!"
msgstr "Они идут! Нильберт, мы отвлечём врага!"

#. ja: 坑道に棲んでいた魔物か……。<br>どうやら、一緒に閉じ込められたようだな。
#. de: Anscheinend sind wir nicht die Einzigen, die hier festsitzen, hm?
#. fr: On dirait qu'on n'est pas les seuls à être coincés ici, hein<nbsp>?
msgctxt "InstanceContentTextData:22506:0:0"
msgid "It would seem we're not the only ones stuck in here, eh?"
msgstr "Похоже, мы тут не одни застряли, да?"

#. ja: ……ふう、大変な依頼になりそうね。
#. de: Ich habe ein schlechtes Gefühl bei der Sache<nbsp>...
#. fr: Tout ça ne me dit rien qui vaille...
msgctxt "InstanceContentTextData:22507:0:0"
msgid "I have a bad feeling about this..."
msgstr "Что-то мне это совсем не нравится..."

#. ja: 左のヤツは引き受けた、シルヴァは右を……！
#. de: Der ganz links gehört mir! Cylva, kümmer dich um seinen Freund auf der rechten Seite!
#. fr: Je prends celui de gauche<nbsp>! Cylva, celui de droite est pour toi<nbsp>!
msgctxt "InstanceContentTextData:22508:0:0"
msgid "The leftmost one is mine! Cylva, you take its friend on the right!"
msgstr "Я беру того, что слева! Сильва, займись его дружком справа!"

#. ja: 任されました……行きましょう！
#. de: Ist so gut wie erledigt. Na kommt schon!
#. fr: Ça, c'est ce que j'appelle du travail d'équipe<nbsp>!
msgctxt "InstanceContentTextData:22509:0:0"
msgid "Consider it done. Have at you, fiends!"
msgstr "Считай, уже сделано. Ну, твари, получите!"

#. ja: こんな大型の魔物まで紛れ込んでいるとは……。
#. de: Na, du bist mir ja vielleicht einer<nbsp>...
#. fr: Attention, voilà un gros bébé<nbsp>!
msgctxt "InstanceContentTextData:22515:0:0"
msgid "Well, aren't you a big boy..."
msgstr "Ну и здоровяк..."

#. ja: 危ないところでしたね、ナイルベルト。
#. de: Denkst du immer noch, du hättest das alleine geschafft, Magier?
#. fr: Tu crois toujours que tu aurais pu t'en sortir tout seul, Nyelbert<nbsp>?
msgctxt "InstanceContentTextData:22516:0:0"
msgid "Still think you could have managed on your own, mage?"
msgstr "Всё ещё думаешь, что справился бы один, маг?"

#. ja: そうだな……。<br>たしかに、私ひとりでは……苦戦したことだろう……。
#. de: Womöglich ... wäre es doch schwieriger gewesen, als ich erwartet hatte.
#. fr: Disons que ça aurait pro<shy>ba<shy>ble<shy>ment été un peu plus compliqué que prévu...
msgctxt "InstanceContentTextData:22517:0:0"
msgid "Perhaps...it would have been more of a struggle than I expected."
msgstr "Пожалуй... это оказалось сложнее, чем я ожидал."

#. ja: あの子が、地脈から魔力を吸い上げているのね！
#. de: Das ist er. Er ist derjenige, der sich an dem Äther der Minen labt.
#. fr: Le voilà<nbsp>! C'est Bovian, celui qui pompe tout l'éther terrestre<nbsp>!
msgctxt "InstanceContentTextData:22520:0:0"
msgid "That's him. He's the one who drinks of the mines' aether."
msgstr "Вот он. Это он высасывает эфир из шахт."

#. ja: よし、さっさと倒しちまおう。<br>行くぜ、ラミット、シルヴァ！　それに……ナイルベルト！
#. de: Alles klar, dann lasst uns diesen übergroßen Stier mal bei den Hörnern packen. Cylva, Lamitt, Nyelbert ... zu mir!
#. fr: Il ne le pompera plus très longtemps. Lamitt, Cylva, Nyelbert... CHAAARGEEEZ<nbsp>!!
msgctxt "InstanceContentTextData:22521:0:0"
msgid "All right, let's put this oversized bull out to pasture. Cylva, Lamitt, Nyelbert...with me!"
msgstr "Ну что ж, пора отправить этого здоровенного быка на пастбище. Сильва, Ламитт, Нильберт... За мной!"

#. ja: …………全力で挑むぞ。
#. de: Meine Magie steht dir zu Diensten ... vorerst.
#. fr: Mes sorts auront raison de ce monstre<nbsp>!
msgctxt "InstanceContentTextData:22522:0:0"
msgid "My magicks are yours...for now."
msgstr "Моя магия в твоём распоряжении... пока что."

#. ja: ええ……！<br>それでは、私が奴の正面に立ちましょう！
#. de: Ich werde die Spitze über<shy>nehmen. Der Kampf geht los!
#. fr: Je vais attirer son attention<nbsp>!
msgctxt "InstanceContentTextData:22523:0:0"
msgid "I will take the front. The battle is on!"
msgstr "Я буду впереди. Начинаем!"

#. ja: 配下を呼びましたか……！<br>先に、雑魚の始末をお願いします！
#. de: Er beschwört andere seiner Art? Wir sollten die kleinen Viecher schleunigst beseitigen!
#. fr: Ah, j'étais sûre qu'il nous enverrait ses sbires<nbsp>! Éliminons-les le plus vite possible<nbsp>!
msgctxt "InstanceContentTextData:22524:0:0"
msgid "It summons others of its ilk? We should dispatch the small fry, and quickly!"
msgstr "Он призывает себе подобных? Надо поскорее разобраться с мелочью!"

#. ja: ああ、一気に蹴散らすぞ！
#. de: Überlasst das mir!
#. fr: C'est comme si c'était fait<nbsp>!
msgctxt "InstanceContentTextData:22525:0:0"
msgid "Leave it to me!"
msgstr "Предоставь это мне!"

#. ja: おっと……こいつは放置したらマズそうだぜ！？
#. de: Argh, der hier sieht nach Ärger aus!
#. fr: Attention, ça va chauffer<nbsp>!
msgctxt "InstanceContentTextData:22526:0:0"
msgid "Gah, this one looks like trouble!"
msgstr "Вот же... этот выглядит опасным!"

#. ja: シルヴァ、雑魚は片付けた！
#. de: Das sollte reichen, Cylva!
#. fr: Et voilà le travail<nbsp>!
msgctxt "InstanceContentTextData:22527:0:0"
msgid "That should do it, Cylva!"
msgstr "Думаю, хватит, Сильва!"

#. ja: マズいな、ここも崩落が始まってきたか……？
#. de: Noch ein Beben? Das verheißt nichts Gutes<nbsp>...
#. fr: Ça tremble encore<nbsp>! Pourvu qu'on ne se fasse pas ensevelir si près du but...
msgctxt "InstanceContentTextData:22528:0:0"
msgid "Another earthquake? This bodes ill..."
msgstr "Опять землетрясение? Ничего хорошего..."

#. ja: 何か仕掛けてくるみたい！　いったん下がって！
#. de: Unser Feind plant irgendwas! Bleibt zurück, meine Freunde!
#. fr: Reculez-vous, il a l'air très énervé<nbsp>!
msgctxt "InstanceContentTextData:22529:0:0"
msgid "Our foe's up to something! Stand back, my friends!"
msgstr "Наш враг что-то замышляет! Назад, друзья!"

#. ja: 回復するわ！　私の近くに集まって！
#. de: An meine Seite! Ich werde eure Wunden heilen!
#. fr: Restez près de moi, je vais tous nous soigner d'un coup<nbsp>!
msgctxt "InstanceContentTextData:22530:0:0"
msgid "To my side! I'll heal your wounds!"
msgstr "Ко мне! Я вас вылечу!"

#. ja: クソッ！　一度、後退するぞ！
#. de: Verdammt, er legt schon wieder los! Weicht zurück!
#. fr: Encore<nbsp>!? Tout le monde vers l'arrière<nbsp>!
msgctxt "InstanceContentTextData:22531:0:0"
msgid "Damn it, here it comes again! Get back!"
msgstr "Проклятье, опять начинается! Назад!"

#. ja: 岩陰に避難しろ！　まともに喰らうとヤバそうだ！
#. de: Geht hinter Felsen in Deckung! Ihr wollt nicht die volle Ladung davon abkriegen!
#. fr: Cachez-vous derrière les rochers, ou vous risquez d'avoir très très mal<nbsp>!
msgctxt "InstanceContentTextData:22532:0:0"
msgid "Take cover behind the rocks! You don't want to bear the full brunt of it!"
msgstr "За камни! Не стоит принимать удар на себя!"

#. ja: 皆さん、私の後ろに！　あの気配……大技がきます！
#. de: Ich spüre eine unheilige Macht ... Kommt hinter mich, Freunde! Schnell!
#. fr: Il prépare sa botte secrète<nbsp>! Tous derrière moi<nbsp>!
msgctxt "InstanceContentTextData:22533:0:0"
msgid "I sense unholy power... Get behind me, friends! Quickly!"
msgstr "Чую тёмную силу... За мной, друзья! Живо!"

#. ja: シルヴァ、まだ戦えるか！？<br>これ以上の長期戦はまずい……一気に畳み掛けるぞ！
#. de: Cylva ... bist du in Ordnung? Verdammt, das halten wir nicht mehr lange durch. Schlagt mit aller Härte zu!
#. fr: Cylva<nbsp>!! Tu tiens le coup<nbsp>? Il faut en finir au plus vite<nbsp>! Donnez tout ce que vous avez<nbsp>!
msgctxt "InstanceContentTextData:22534:0:0"
msgid "Cylva...are you all right!? Damn it, we can't keep this up much longer. Strike with all of your strength!"
msgstr "Сильва... ты в порядке!? Чёрт, долго мы так не продержимся. Бейте изо всех сил!"

#. ja: そんな……私は、テイナーを……。
#. de: Taynor, mein Freund ... Vergib mir ...
#. fr: T-Taynor... Pardonne-moi...
msgctxt "InstanceContentTextData:22537:0:0"
msgid "Taynor, my friend... Forgive me..."
msgstr "Тейнор, друг мой... Прости меня..."

#. ja: ふぅ……まだ奥まで坑道が続いているみたい。
#. de: Was ist das? Es führt noch tiefer rein ...?
#. fr: Cette caverne est vraiment très profonde...
msgctxt "InstanceContentTextData:22538:0:0"
msgid "What's this? It leads deeper within...?"
msgstr "Что это? Похоже, проход ведёт ещё глубже..."

#. ja: 依頼主に、坑道内の地図でももらっときゃよかったな……。<br>まあ、この崩落で使い物にならなかった可能性もあるが。
#. de: Wir hätten wirklich um eine Karte bitten sollen. Nicht, dass sie nach all den Einstürzen noch viel nützen würde<nbsp>...
#. fr: Le commanditaire aurait pu nous fournir une carte de cette grotte... Enfin, vu qu'elle risque de s'effondrer sur nos têtes à tout moment, ça n'a plus vraiment d'importance<nbsp>!
msgctxt "InstanceContentTextData:22539:0:0"
msgid "We really should have asked for a map. Not that it'd have been much use after all the cave-ins..."
msgstr "Надо было попросить карту. Хотя после всех этих обвалов от неё всё равно было бы мало толку..."

#. ja: 遺跡の最奥部へ進め！
#. de: In das Innere der Ruine vordringen
#. fr: Dirigez-vous vers le cœur du confessionnal<nbsp>!
msgctxt "InstanceContentTextData:22600:0:0"
msgid "Reach the bowels of the Great Pyramid of Ux'ner"
msgstr "Доберитесь до самых глубин Великой пирамиды Укс'нера"

#. ja: 目的の「仕掛け」があるとすれば最奥部よ。<br>さあ、急ぎましょう。
#. de: Der Schalter für den Magiestrom befindet sich im innersten Bereich. Beeilen wir uns!
#. fr: Notre objectif se trouve au plus profond de ces vestiges. Essayons de l'atteindre le plus vite possible<nbsp>!
msgctxt "InstanceContentTextData:22601:0:0"
msgid "We must hurry. Before the Eulmoran soldiers gain any ground."
msgstr "Надо поторопиться. Пока солдаты Эулмора не добрались сюда."

#. ja: 待て！<br>盗掘者避けの守護像だ……！
#. de: Wartet! Die Wächterstatuen werden uns für Unwürdige halten.
#. fr: Attendez<nbsp>! Je crois que nous allons avoir affaire à des gardiens chargés d'éliminer les gêneurs...
msgctxt "InstanceContentTextData:22602:0:0"
msgid "Wait! Do you see those sentinels?"
msgstr "Постойте! Видите тех стражей?"

#. ja: 見つかると「ロンカの呪詛」をかけられるという。<br>伝承によれば、死に至る呪いだとか……。
#. de: Sie verfügen über eine mächtige Verwünschung. Ein Todesfluch<nbsp>...
#. fr: Selon la légende, les “maléfices ronka” de ces golems seraient capables de provoquer une mort très douloureuse...
msgctxt "InstanceContentTextData:22603:0:0"
msgid "They are made to curse any who enter the pyramid. It is said to be seen by them is to be seen by death."
msgstr "Они проклинают каждого, кто входит в пирамиду. Говорят, стоит им тебя заметить — и смерть уже рядом."

#. ja: クッ……見つかったか……！<br>やむをえん、戦うぞ！
#. de: Wir sind entdeckt! Jetzt heißt es kämpfen!
#. fr: Mince, on a été repéré<if $gn4>es<else>s</if><nbsp>! Il va falloir user de la force<nbsp>!
msgctxt "InstanceContentTextData:22605:0:0"
msgid "Dammit! We must deal with them quickly, before the curse can take hold."
msgstr "Проклятье! Надо быстро с ними разобраться, пока проклятие не подействовало."

#. ja: この「呪詛」は、重ねがけによって効果を発揮する呪いのようね。<br>やはり、守護像との交戦は避けるべきよ……。
#. de: Die Verwünschung wirkt erst, wenn uns mehrere entdeckt haben. Wir müssen vorsichtiger sein.
#. fr: La malédiction de ces gardiens est cumulative. Plus on en absorbe, plus son effet s'intensifie. Voilà pourquoi il faut les éviter à tout prix<nbsp>!
msgctxt "InstanceContentTextData:22606:0:0"
msgid "This curse was not as potent as I dared imagine. But I suggest we avoid another confrontation. Its effects no doubt grow with every invocation."
msgstr "Проклятие оказалось не таким сильным, как я опасалась. Но лучше больше не связываться со стражами. Похоже, с каждым новым заклинанием оно становится сильнее."

#. ja: <split " " 1><string $gs1></split>……！？<br>なんてことなの……！
#. de: <split " " 1><string $gs1></split>! Was machst du da?
#. fr: ... <split " " 1><string $gs1></split><nbsp>? Qu'est-ce qui t'arrive<nbsp>!? <split " " 1><string $gs1></split><nbsp>!!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:22607:0:0"
msgid "<split \" \" 1><string $gs1></split>!? <split \" \" 1><string $gs1></split> hold on!"
msgstr "<split \" \" 1><string $gs1></split>!? <split \" \" 1><string $gs1></split>, погоди!"

#. ja: ふむ……守護像の動きが、<br>先程とは、微妙に異なっているようだな。
#. de: Wieder Wächterstatuen. Wir müssen sie irgendwie austricksen.
#. fr: Attention, la ronde des gardiens n'est pas la même que dans la salle précédente...
msgctxt "InstanceContentTextData:22611:0:0"
msgid "Another sentinel. Its movement is somehow different from before."
msgstr "Опять страж. Его движения... чем-то отличаются от прежних."

#. ja: 待ってくれ……あれほどの守護像となると、<br>まともに戦っていては、消耗は避けられん。
#. de: Das sind zu viele. Und es gibt keine Deckung.
#. fr: Attendez<nbsp>! Malgré toute notre expérience, affronter quatre gardiens aussi gi<shy>gan<shy>tesques en même temps n'est pas la meilleure des idées.
msgctxt "InstanceContentTextData:22616:0:0"
msgid "They are massive... How are we to get around them?"
msgstr "Они огромны... Как же нам мимо них пройти?"

#. ja: それなら、私が幻影魔法で注意を引くわ。<br>魔力の消耗が激しいから、あまり使いたくはなかったけれど。
#. de: Ich werde sie mit einem Trugbild ablenken. Dann rennen wir in einem durch. Greift also keinesfalls an!
#. fr: Dans ce cas, je vais créer des leurres pour attirer leur attention. Cela me coûtera une bonne partie de mon énergie magique, mais mieux vaut éviter les complications autant que possible.
msgctxt "InstanceContentTextData:22618:0:0"
msgid "I will draw their attention with a glamour."
msgstr "Я отвлеку их иллюзией."

#. ja: 守護像の注意が完全に逸れたら、<br>一気に奥の部屋まで駆けて……始めるわよ！
#. de: Aber beeilt euch, denn ich kann den Zauber nicht lange aufrechterhalten. Fertig? Dann los!
#. fr: Une fois qu'ils seront tous occupés, nous n'aurons plus qu'à nous précipiter de l'autre côté de la salle. Vous êtes prêt<if $gn4>es<else>s</if><nbsp>? C'est parti<nbsp>!
msgctxt "InstanceContentTextData:22619:0:0"
msgid "It will not last long. The moment they are distracted we must run with all haste."
msgstr "Долго она не продержится. Как только стражи отвлекутся, бегите изо всех сил."

#. ja: しまった……！？<br>私としたことが……ヤキが回ったものね……。
#. de: Verdammt. Ich dachte, ich schaff's.
#. fr: J'ai échoué... Je n'arrive pas... à y croire...
msgctxt "InstanceContentTextData:22621:0:0"
msgid "I... I was reckless..."
msgstr "Я... была опрометчива..."

#. ja: 油断したとでも……！？<br>すまない……同盟者よ……。
#. de: Verzeiht, Freunde von Ronka. Ich war unachtsam.
#. fr: Pardonnez-moi... alliés de Ronka...
msgctxt "InstanceContentTextData:22622:0:0"
msgid "Forgive me..."
msgstr "Прости меня..."

#. ja: このエーテルの流れは……転移装置のようね。<br>先に進むには、飛び込むしかなさそうよ。
#. de: Der Ätherstrom sieht aus wie ein Portal. Es wird uns nach oben befördern.
#. fr: Ce courant éthéré devrait nous servir de téléporteur. Nous n'avons plus qu'à l'emprunter pour découvrir où il mène.
msgctxt "InstanceContentTextData:22623:0:0"
msgid "A teleportation device? This should end well..."
msgstr "Устройство для телепортации? Ну, ничего хорошего это не сулит..."

#. ja: 姉ちゃん、あの爺さん何なの？<br>馬鹿みたいな速さで、どんどん奥に進んでる……！
#. de: Almet, <split " " 1><string $gs1></split>, hört ihr mich? Euch ist jemand auf den Fersen.
#. fr: Almet, il y a un vieux chevelu qui court à toute vitesse vers le cœur du confessionnal<nbsp>! Pour quelqu'un de cet âge, il est im<shy>pres<shy>sion<shy>nant<nbsp>!
msgctxt "InstanceContentTextData:22624:0:0"
msgid "Sister! They have reached the temple! I fear they are too fast for us."
msgstr "Сестра! Они добрались до храма! Боюсь, нам их не догнать."

#. ja: <split " " 1><string $gs1></split>、アルメ……<br>「ひそひ草」は通じていて……？
#. de: Ein alter Mann mit Schwert, und er ist schneller als der Wind!
#. fr: Almet, <split " " 1><string $gs1></split><nbsp>! Vous m'entendez<nbsp>?
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:22625:0:0"
msgid "<split \" \" 1><string $gs1></split>? Almet? ...Can anyone hear me?"
msgstr "<split \" \" 1><string $gs1></split>? Альмет?.. Кто-нибудь меня слышит?"

#. ja: ああ、それぞれが異なる場所に飛ばされたようだな。<br>それに、この霧……毒素が混じっている。
#. de: Wo seid ihr? Wir sind alle in verschiedenen Kammern gelandet. Und der Nebel ... ist giftig!
#. fr: On dirait que nous avons été téléporté<if $gn4>es<else>s</if> à des endroits différents. Et cet air embrumé... Prenez garde, il est chargé de poison<nbsp>!
msgctxt "InstanceContentTextData:22626:0:0"
msgid "We have been sent to...\\<cough> \\<cough>...separate chambers. This mist..."
msgstr ""

#. ja: 毒だけじゃない、うまく魔法が行使できない。<br>どうやら、行動を阻害する術式が組まれているようね。
#. de: Ich kann mich nicht richtig bewegen! Verdammt, ich versuch die leuchtenden Platten mit dem Verdrängungszauber!
#. fr: Non seulement ça, mais je suis également incapable de lancer le moindre sort<nbsp>! Il n'y a pas à dire, Ronka savait y faire en matière de défense...
msgctxt "InstanceContentTextData:22627:0:0"
msgid "Poison. And it has─\\<cough>─nullified my magick."
msgstr ""

#. ja: こちらは抜け出せたわ。<br>長居は無用よ……早く脱出してちょうだい。
#. de: Ich bin raus. Beeilt euch!
#. fr: Ça y est, j'ai réussi à m'échapper<nbsp>! Dépêchez-vous de sortir de là, vous aussi<nbsp>!
msgctxt "InstanceContentTextData:22628:0:0"
msgid "Finally, fresh air. How fare you two? We have to keep moving."
msgstr "Наконец-то свежий воздух. Как вы там? Надо идти дальше."

#. ja: こちらも脱出できた。<br>どうした、<split " " 1><string $gs1></split>……大丈夫か？
#. de: Ich hab's auch geschafft. <split " " 1><string $gs1></split>, wo bleibst du?
#. fr: Moi aussi, je suis enfin dehors<nbsp>! <split " " 1><string $gs1></split>, est-ce que ça va<nbsp>?
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:22629:0:0"
msgid "I am here. <split \" \" 1><string $gs1></split>? Are you all right?"
msgstr "Я здесь. <split \" \" 1><string $gs1></split>? Ты в порядке?"

#. ja: 噂のランジート将軍かしら……？<br>このままでは追いつかれかねない、先へ進みましょう！
#. de: General Ran'jit. Aber bei dem Vorsprung wird er uns nie einholen.
#. fr: Il ne peut s'agir de nul autre que du général Ran'jit en personne... Nous devons arriver au but avant lui<nbsp>!
msgctxt "InstanceContentTextData:22630:0:0"
msgid "Could it be Ran'jit? If so, we have precious little time."
msgstr "Неужели это Ран'джит? Если так, времени у нас в обрез."

#. ja: <split " " 1><string $gs1></split>、どうした？<br>早くこちらへ……下に通路がある！
#. de: <split " " 1><string $gs1></split>, wo bist du? Schnell, komm hier runter!
#. fr: Que se passe-t-il, <split " " 1><string $gs1></split><nbsp>? Fais vite, la suite du chemin est devant nous<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:22631:0:0"
msgid "It's all right, <split \" \" 1><string $gs1></split>. There's a path down here, but you have to jump."
msgstr "Всё хорошо, <split \" \" 1><string $gs1></split>. Тут есть путь вниз, но придётся прыгнуть."

#. ja: わかった。<br>無理はするな、こちらも先を急ぐ！
#. de: Verstanden. Beschäftigt sie so lang wie möglich. Wir sind raus, bevor er uns einholt.
#. fr: C'est compris, on se retrouve plus tard. Soyez prudentes<nbsp>!
msgctxt "InstanceContentTextData:22632:0:0"
msgid "Be careful of the traps inside. We are nearly there."
msgstr "Берегись ловушек. Мы уже почти у цели."

#. ja: やれやれ、どうやら無事に合流できたようだな。
#. de: Endlich wieder vereint. Dann kann's ja weitergehen.
#. fr: Ouf, on s'en est sorti<if $gn4>es<else>s</if> tant bien que mal...
msgctxt "InstanceContentTextData:22633:0:0"
msgid "Somehow we are still in one piece..."
msgstr "Удивительно, но мы все целы..."

#. ja: この霧……毒はないようだけれど、行動の阻害は相変わらずね。<br>慎重に行動しましょう。
#. de: Wieder so ein Nebel. Er ist nicht giftig, aber er lähmt meine Beine.
#. fr: Encore cette brume qui empêche d'agir à sa guise... sauf que cette fois, je ne ressens aucun poison dans l'air. Restons tout de même sur nos gardes...
msgctxt "InstanceContentTextData:22634:0:0"
msgid "That means little to the others if we do not hurry."
msgstr "Значит, надо спешить. Иначе остальным это не поможет."

#. ja: 来るぞ……走れ！！
#. de: Da kommt was! Lauft!
#. fr: Un rocher fonce droit sur nous<nbsp>! Courez<nbsp>!!
msgctxt "InstanceContentTextData:22635:0:0"
msgid "Run!!!"
msgstr "Бегите!!!"

#. ja: 壁に裂け目が……隠れてちょうだい！
#. de: Schnell, in die Einbuchtungen!
#. fr: Là, à droite<nbsp>! Une cavité<nbsp>!
msgctxt "InstanceContentTextData:22636:0:0"
msgid "There! That crevice in the wall!"
msgstr "Вон там! Трещина в стене!"

#. ja: やむをえん……飛べッ！
#. de: Der Weg ...! Springt!
#. fr: À la une, à la deux... à la trois<nbsp>!
msgctxt "InstanceContentTextData:22637:0:0"
msgid "We have to jump!"
msgstr "Придётся прыгать!"

#. ja: どうにか助かったようだな。<br>上に戻る道もなさそうだ、このまま水路を進むとしよう。
#. de: Das war knapp. Aber nach oben kommen wir nicht zurück. Folgen wir diesem Kanal.
#. fr: Pas de retour en arrière possible, on dirait... Continuons le long de ce cours d'eau.
msgctxt "InstanceContentTextData:22638:0:0"
msgid "Well, there is no going back now. I pray it is not much further."
msgstr "Назад дороги нет. Надеюсь, идти осталось недолго."

#. ja: ごめん、姉ちゃん、敵ふたりに突破された……！<br>今、うちとシャイメで追ってる！
#. de: Cymet und ich haben den General gestellt! Er hat noch einen Soldaten bei sich.
#. fr: Almet, deux Eulmoriens se sont introduits à l'intérieur<nbsp>! Cymet et moi faisons notre maximum pour les rattraper<nbsp>!
msgctxt "InstanceContentTextData:22639:0:0"
msgid "Sister! Sister, can you hear me? Two soldiers have broken through our defenses!"
msgstr "Сестра! Ты меня слышишь? Двое солдат прорвались сквозь нашу оборону!"

#. ja: そうか、わかった……。<br>こちらも急ぐが、追跡は十分に気をつけてくれ……！
#. de: Verstanden. Haltet sie in Schach, aber riskiert nicht zu viel.
#. fr: Bien reçu<nbsp>! N'oubliez pas de surveiller vos arrières au passage<nbsp>!
msgctxt "InstanceContentTextData:22640:0:0"
msgid "Follow them! They are not to reach this temple, understood?"
msgstr "За ними! Они не должны добраться до храма, ясно?"

#. ja: どうやら、ユールモア軍の兵数名が、妹たちの守りを抜けたようだ。<br>いずれ、彼らもこの遺跡にやって来るだろう……。
#. de: Die Soldaten aus Eulmore sind hier. Meine Schwestern versuchen sie aufzuhalten, aber es kann sein, dass wir bald mit ihnen zu tun bekommen.
#. fr: Il semblerait que la confrontation directe avec au moins deux Eulmoriens soit de l'ordre de l'inévitable...
msgctxt "InstanceContentTextData:22641:0:0"
msgid "A pair of soldiers somehow made it past my sisters. No doubt on their way here."
msgstr "Похоже, несколько солдат Эулмора прошли мимо моих сестёр. Скоро они будут здесь."

#. ja: 了解よ。<br>とにかく今は前進を続けましょう……！
#. de: Danke. Wir müssen versuchen, ihnen einen Schritt voraus zu bleiben.
#. fr: On s'en inquiétera le moment venu. Pour l'instant, on continue d'avancer<nbsp>!
msgctxt "InstanceContentTextData:22642:0:0"
msgid "All the more reason we should hurry, then."
msgstr "Тем более нельзя терять времени. Идём дальше!"

#. ja: こんな場所に扉だなんて、いかにもね。<br>目的の「仕掛け」も近いんじゃないかしら……？
#. de: Wir sind jetzt tief drinnen. Der Schalter für den Magiestrom muss hier irgendwo sein.
#. fr: Hmm... Une telle porte à un tel endroit, c'est assez étrange. Et si ça signifiait que nous approchons du but<nbsp>?
msgctxt "InstanceContentTextData:22643:0:0"
msgid "Another door. Wonderful... I can but imagine what awaits us inside."
msgstr "Ещё одна дверь. Замечательно... Даже боюсь представить, что там за ней."

#. ja: 見つけたぞ、鼠ども！
#. de: Hab ich euch, ihr Ratten!
#. fr: Vous voilà enfin, bande de rats<nbsp>!
msgctxt "InstanceContentTextData:22644:0:0"
msgid "There you are!"
msgstr "Вот вы где!"

#. ja: 追いつかれたか……応戦するぞ！
#. de: Sie haben uns tatsächlich eingeholt! Aber das werden sie bereuen<nbsp>...
#. fr: Les voilà<nbsp>! À l'attaque<nbsp>!
msgctxt "InstanceContentTextData:22645:0:0"
msgid "Impossible!"
msgstr "Не может быть!"

#. ja: また守護像が……なら、私が引き付ける！<br>あなたは奥の「仕掛け」を起動させて！
#. de: Noch mehr Wächter! Ich lenke sie ab. Aktiviere du den Magiestrom!
#. fr: Encore des golems<nbsp>!? Laisse-moi m'occuper d'eux pendant que tu actives le mécanisme<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:22647:0:0"
msgid "More sentinels? Go, <split \" \" 1><string $gs1></split>. I will draw their attention."
msgstr "Опять стражи? Иди, <split \" \" 1><string $gs1></split>. Я их отвлеку."

#. ja: ダブルの魔力が、ほつれはじめた……！<br>そろそろ、限界……急いで……！
#. de: Ich kann die Ablenkung nicht mehr lange aufrechterhalten!
#. fr: Je ne pourrai plus tenir très longtemps... Dépêche-toi<nbsp>!
msgctxt "InstanceContentTextData:22648:0:0"
msgid "I fear I've reached my limit. We must go. Now!"
msgstr "Боюсь, я больше не выдержу. Надо уходить. Сейчас же!"

#. ja: 話を聞いていなかったのかしら……？<br>まずは待機だと、説明したつもりだったけれど？
#. de: Ich hab doch gesagt: Nicht angreifen!
#. fr: <split " " 1><string $gs1></split>, je t'avais dit d'être patient<if $gn4>e</if><nbsp>! Écoute-moi la prochaine fois, s'il te plaît<nbsp>!
msgctxt "InstanceContentTextData:22649:0:0"
msgid "I realize we must hurry, but we mustn't be reckless."
msgstr "Понимаю, что надо спешить, но не стоит безрассудно бросаться вперёд."

#. ja: この部屋、床の印の方向へ移動する仕組みのようだ。<br>急いで、外に転移する魔力の奔流に向かってくれ！
#. de: Die Pfeile deuten in die Richtung des Verdrängungszaubers. Bestimmt gibt es einen Weg zu dem nächsten Portal!
#. fr: Ce sol est divisé en cases, et les flèches indiquent la direction où chacune d'entre elles mène. Trouvez le bon chemin pour atteindre le téléporteur orange<nbsp>!
msgctxt "InstanceContentTextData:22650:0:0"
msgid "These markings on the floor. \\<cough> \\<cough> I think they show the way out."
msgstr ""

#. ja: なに……？<br>後ろの方で、大きな音が……
#. de: Was war das? Ich habe etwas rumpeln gehört.
#. fr: Hmm<nbsp>? C'était quoi, ce bruit venu de derrière<nbsp>?
msgctxt "InstanceContentTextData:22651:0:0"
msgid "What was that noise?"
msgstr "Что это был за шум?"

#. ja: 冗談……では、ないようだな……。
#. de: Soll das ein Witz sein? Rennt!
#. fr: C'est... C'est une blague<nbsp>!?
msgctxt "InstanceContentTextData:22652:0:0"
msgid "By the gods...!"
msgstr "Боги!.."

#. ja: ……何をやっているの？<br>遊んでいる時間はないのよ……？
#. de: Was machst du da? Wir haben keine Zeit für Spielchen.
#. fr: Mais qu'est-ce que tu fabriques<nbsp>? C'est vraiment pas le moment de s'amuser<nbsp>!
msgctxt "InstanceContentTextData:22658:0:0"
msgid "This is no time for dithering. Come!"
msgstr "Не время медлить. Идём!"

#. ja: この者らは、私たち姉妹が抑える！<br>我らが同盟者よ、奥へ進み目的の「仕掛け」を！
#. de: Meine Schwestern halten die beiden in Schach. Geht weiter, Freunde von Ronka, und aktiviert den Magiestrom!
#. fr: Nous allons les retenir ici aussi longtemps que possible<nbsp>! Profitez-en pour activer le mécanisme<nbsp>! Vite<nbsp>!
msgctxt "InstanceContentTextData:22660:0:0"
msgid "We will hold him here. Quickly, make for the Heart of Toupasa."
msgstr "Мы его задержим. Скорее, доберись до Сердца Тупасы!"

#. ja: 聞いてのとおりだ。<br>しかし、妹たちが追いきれぬ相手とは、いったい……？
#. de: Gegen wen kämpfen sie da?
#. fr: Vous avez entendu comme moi, mais je me demande de qui elle parlait...
msgctxt "InstanceContentTextData:22661:0:0"
msgid "It is unheard of for anyone to outpace the Viis. What is this man who comes after you?"
msgstr "Никому ещё не удавалось обогнать ви'ис. Что это за человек гонится за вами?"

#. ja: 反逆者風情がっ！<br>この湿った坑道で朽ち果てるがいい！
#. de: Nieder mit den Störenfrieden!
#. fr: Maudits rebelles<nbsp>! Ces murs de pierre couverts de moisissure seront votre tombeau<nbsp>!
msgctxt "InstanceContentTextData:22662:0:0"
msgid "My lord demands retribution!"
msgstr "Мой господин требует возмездия!"

#. ja: 姉ちゃん、任せて！　いっくぞー！
#. de: Das übernehme ich!
#. fr: Laissez-moi faire, je m'occupe de lui<nbsp>!
msgctxt "InstanceContentTextData:22665:0:0"
msgid "At once, sister!"
msgstr "Сейчас, сестра!"

#. ja: 守護像から隠れて進め！
#. de: An den Wächtern vorbeischleichen
#. fr: Avancez en évitant les gardiens<nbsp>!
msgctxt "InstanceContentTextData:22666:0:0"
msgid "Avoid the Ronkan executioners"
msgstr "Проберитесь мимо палачей Ронки"

#. ja: ヤ・シュトラの助けを借り、奥へ進め！
#. de: Mit Y'shtolas Hilfe weiter vorrücken
#. fr: Avancez au fond de la salle avec l'aide de Y'shtola<nbsp>!
msgctxt "InstanceContentTextData:22667:0:0"
msgid "Avoid the Ronkan executioners"
msgstr "Проберитесь мимо палачей Ронки"

#. ja: 毒で倒れる前に脱出せよ！
#. de: Das nächste Portal erreichen
#. fr: Échappez-vous avant que le poison vous achève<nbsp>!
msgctxt "InstanceContentTextData:22668:0:0"
msgid "Escape the chamber of poison"
msgstr "Выберитесь из отравленной комнаты"

#. ja: 遺跡の最奥部へ進め！
#. de: In das Innere der Ruine vordringen
#. fr: Continuez d'avancer<nbsp>!
msgctxt "InstanceContentTextData:22669:0:0"
msgid "Reach the bowels of the Great Pyramid of Ux'ner"
msgstr "Доберитесь до самых глубин Великой пирамиды Укс'нера"

#. ja: 罠を回避しつつ奥へ進め！
#. de: Den Fallen ausweichen und weiter vorrücken
#. fr: Avancez en évitant les rochers<nbsp>!
msgctxt "InstanceContentTextData:22670:0:0"
msgid "Flee from the boulders"
msgstr "Спасайтесь от катящихся валунов"

#. ja: 飛び降りろ！
#. de: Nach unten springen
#. fr: Sautez dans le précipice<nbsp>!
msgctxt "InstanceContentTextData:22671:0:0"
msgid "Take a leap of faith"
msgstr "Прыгайте в пропасть"

#. ja: 遺跡の最奥部へ進め！
#. de: In das Innere der Ruine vordringen
#. fr: Continuez d'avancer<nbsp>!
msgctxt "InstanceContentTextData:22672:0:0"
msgid "Reach the bowels of the Great Pyramid of Ux'ner"
msgstr "Доберитесь до самых глубин Великой пирамиды Укс'нера"

#. ja: ランジートを阻止せよ！
#. de: Ran'jit aufhalten
#. fr: Empêchez Ran'jit d'accéder au mécanisme<nbsp>!
msgctxt "InstanceContentTextData:22673:0:0"
msgid "Defeat Ran'jit"
msgstr "Одолейте Ран'джита"

#. ja: 「ロンカの仕掛け」を起動せよ！
#. de: Den Magiestrom aktivieren
#. fr: Activez le mécanisme de Ronka<nbsp>!
msgctxt "InstanceContentTextData:22674:0:0"
msgid "Activate the Heart of Toupasa"
msgstr "Активируйте Сердце Тупасы"

#. ja: ウィメ！　シャイメ！　奴の足を止める！<br>やれるな！？
#. de: Uimet! Cymet! Haltet ihn auf!
#. fr: Arrêtez-le, mes sœurs<nbsp>! Je compte sur vous<nbsp>!
msgctxt "InstanceContentTextData:22675:0:0"
msgid "Uimet! Cymet! You know what to do!"
msgstr "Уимет! Симет! Вы знаете, что делать!"

#. ja: クッ……このままでは……！
#. de: Ich... schaffe es nicht!
#. fr: Argh<nbsp>! Ils sont coriaces<nbsp>!
msgctxt "InstanceContentTextData:22676:0:0"
msgid "I fear this is going nowhere..."
msgstr "Боюсь, так мы ничего не добьёмся..."

#. ja: 続いて、呪縛の魔法でぇ……！
#. de: Mit dem Zauber der Palastwache schaffen wir es vielleicht<nbsp>...
#. fr: Et maintenant, tu vas arrêter de gigoter<nbsp>!
msgctxt "InstanceContentTextData:22677:0:0"
msgid "I have him!"
msgstr "Я его поймала!"

#. ja: 急げ、同盟者<split " " 1><string $gs1></split>！<br>そう長くは、抑え込むことなど……！
#. de: Beeil dich, <split " " 1><string $gs1></split>! Wir können ihn nicht ewig halten!
#. fr: <split " " 1><string $gs1></split>, faites vite<nbsp>! Ce n'est qu'une question de temps avant qu'il se libère<nbsp>!
msgctxt "InstanceContentTextData:22678:0:0"
msgid "Hurry! We cannot hold him for long!"
msgstr "Скорее! Мы долго его не удержим!"

#. ja: 急いでくれ！<br>これ以上は、保たない……！
#. de: Schneller! Wir können nicht mehr!
#. fr: Nous sommes à bout de forces<nbsp>! Par pitié, dépêchez-vous<nbsp>!
msgctxt "InstanceContentTextData:22679:0:0"
msgid "Hurry! We can hold him no longer!"
msgstr "Быстрее! Мы больше не выдержим!"

#. ja: ランジートの体力を削れ！
#. de: Ran'jit schwächen
#. fr: Affaiblissez Ran'jit<nbsp>!
msgctxt "InstanceContentTextData:22700:0:0"
msgid "Defeat Ran'jit!"
msgstr "Ослабьте Ран'джита!"

#. ja: ランジートの体力をさらに削れ！
#. de: Ran'jit weiter schwächen
#. fr: Affaiblissez Ran'jit<nbsp>!
msgctxt "InstanceContentTextData:22701:0:0"
msgid "Defeat Ran'jit!"
msgstr "Ещё сильнее ослабьте Ран'джита!"

#. ja: コンテンツアクションで、窮地から抜け出せ！
#. de: Mit Spezialkommando entkommen
#. fr: Utilisez l'action de mission pour survivre à l'assaut<nbsp>!
msgctxt "InstanceContentTextData:22702:0:0"
msgid "Evade Ran'jit using Perfect Deception!"
msgstr "Уклонитесь от атаки Ран'джита с помощью «Идеального обмана»!"

#. ja: コンテンツアクションで、ソイルを放て！
#. de: Mit Spezialkommando Erda abfeuern
#. fr: Utilisez l'action de mission pour tirer une cartouche<nbsp>!
msgctxt "InstanceContentTextData:22703:0:0"
msgid "Fire a round from your gunblade!"
msgstr "Выстрелите из своего револьверного клинка!"

#. ja: ランジートの体力を削り、チャンスを待て！
#. de: Ran'jit schwächen
#. fr: Affaiblissez Ran'jit et attendez le bon moment<nbsp>!
msgctxt "InstanceContentTextData:22704:0:0"
msgid "Bide your time for a chance to strike!"
msgstr "Ослабьте Ран'джита и ждите подходящего момента!"

#. ja: コンテンツアクションで、窮地から抜け出せ！
#. de: Mit Spezialkommando entkommen
#. fr: Utilisez l'action de mission pour survivre à l'assaut<nbsp>!
msgctxt "InstanceContentTextData:22705:0:0"
msgid "Evade Ran'jit using Perfect Deception!"
msgstr "Уклонитесь от атаки Ран'джита с помощью «Идеального обмана»!"

#. ja: コンテンツアクションで、再びソイルを放て！
#. de: Mit Spezialkommando Erda abfeuern
#. fr: Utilisez l'action de mission pour tirer une autre cartouche<nbsp>!
msgctxt "InstanceContentTextData:22706:0:0"
msgid "Fire another round from your gunblade!"
msgstr "Сделайте ещё один выстрел из револьверного клинка!"

#. ja: ランジートの体力を削り、チャンスを待て！
#. de: Ran'jit weiter schwächen
#. fr: Affaiblissez Ran'jit et attendez le bon moment<nbsp>!
msgctxt "InstanceContentTextData:22707:0:0"
msgid "Bide your time for a chance to strike!"
msgstr "Ослабьте Ран'джита и ждите подходящего момента!"

#. ja: コンテンツアクションで、窮地から抜け出せ！
#. de: Mit Spezialkommando entkommen
#. fr: Utilisez l'action de mission pour survivre à l'assaut<nbsp>!
msgctxt "InstanceContentTextData:22708:0:0"
msgid "Evade Ran'jit using Perfect Deception!"
msgstr "Уклонитесь от атаки Ран'джита с помощью «Идеального обмана»!"

#. ja: ランジートの攻撃を耐え抜け！
#. de: Ran'jits Angriffen widerstehen
#. fr: Résistez aux attaques de Ran'jit<nbsp>!
msgctxt "InstanceContentTextData:22709:0:0"
msgid "Endure Ran'jit's onslaught!"
msgstr "Выдержите натиск Ран'джита!"

#. ja: コンテンツアクションで、窮地から抜け出せ！
#. de: Mit Spezialkommando entkommen
#. fr: Utilisez l'action de mission pour survivre à l'assaut<nbsp>!
msgctxt "InstanceContentTextData:22710:0:0"
msgid "Evade Ran'jit using Souldeep Invisibility!"
msgstr "Уклонитесь от атаки Ран'джита с помощью «Незримой глубины души»!"

#. ja: コンテンツアクションで、最後のソイルを放て！
#. de: Mit Spezialkommando die letzte Erda abfeuern
#. fr: Utilisez l'action de mission pour tirer la dernière cartouche<nbsp>!
msgctxt "InstanceContentTextData:22711:0:0"
msgid "Fire your last cartridge!"
msgstr "Сделайте последний выстрел!"

#. ja: なんて圧だ……<br>だが、今回ばかりは、何としてでも俺が勝つ！
#. de: Er macht ganz schön Druck. Aber diesmal werde ich gewinnen! Irgendwie!
#. fr: Tu ne lâches donc jamais prise<nbsp>? Cette fois, je vais te régler ton compte pour de bon<nbsp>!
msgctxt "InstanceContentTextData:22713:0:0"
msgid "Whatever it takes, I swear I will end you."
msgstr "Чего бы мне это ни стоило, клянусь — я с тобой покончу."

#. ja: よく吠える……。<br>その舌で、あの娘を騙したのであろう。
#. de: Pah! Nichts als leere Worte. Hast du damit dem Mädchen den Verstand verdreht?
#. fr: Tu aboies fort, sale chien, mais tes aboiements ne sont que des mensonges. Comme ceux avec lesquels tu as perverti Minfilia<nbsp>!
msgctxt "InstanceContentTextData:22714:0:0"
msgid "Hmph. You lie to yourself as you lied to her."
msgstr "Хм. Ты лжёшь себе так же, как лгал ей."

#. ja: 騙すどころか、黙っていたさ。<br>それでもあいつは、自分で歩き出した……！
#. de: Sie weiß mehr, als du ihr je beigebracht hättest. Sie geht jetzt ihren eigenen Weg.
#. fr: Je ne lui ai pas menti, je lui ai simplement caché des choses. Et malgré tout, elle a continué à aller de l'avant sans rien demander à personne<nbsp>!
msgctxt "InstanceContentTextData:22715:0:0"
msgid "Aye, I lied. Kept secrets. But no more. She deserves better."
msgstr "Да, я лгал. Скрывал от неё правду. Но хватит. Она заслуживает лучшего."

#. ja: 終わらぬ闘争、悲しみの宿命に向けてか？<br>……抜かせッ！
#. de: Einen Weg endloser und sinnloser Kämpfe? Was für ein trauriges Schicksal. Nur Vauthry kann ihr Glück schenken!
#. fr: Pour aller où<nbsp>? Vers une vie de souffrance éternelle<nbsp>?
msgctxt "InstanceContentTextData:22716:0:0"
msgid "A life of pain? Of ceaseless conflict and despair?"
msgstr "Жизнь, полная боли? Бесконечная борьба и отчаяние?"

#. ja: さすがに手強い……。<br>攻撃が、ことごとく捌かれる……！
#. de: Ein würdiger Gegner<nbsp>...
#. fr: Je me doutais que ce serait pas du gâteau...
msgctxt "InstanceContentTextData:22717:0:0"
msgid "This is going well..."
msgstr "Неплохо идёт..."

#. ja: 無駄なことを……。<br>我が奥義をもって、捻り潰してやろう！
#. de: Es wird dir nichts helfen.
#. fr: Que d'efforts inutiles...
msgctxt "InstanceContentTextData:22718:0:0"
msgid "Vanity..."
msgstr "Тщетно..."

#. ja: 我が血を受けし、獣よ来たれ！
#. de: Du nahmst mein Blut, jetzt erhör meinen Ruf!
#. fr: Sang de mon sang<nbsp>! Viens à moi<nbsp>!
msgctxt "InstanceContentTextData:22719:0:0"
msgid "Beast of my blood, answer my call!"
msgstr "Зверь, в чьих жилах моя кровь, откликнись на зов!"

#. ja: これぞ我が武器、我が衣……！
#. de: Sei mein Schwert, sei mein Schild!
#. fr: Mon arme<nbsp>! Mon armure<nbsp>! Anéantissons nos ennemis<nbsp>!
msgctxt "InstanceContentTextData:22720:0:0"
msgid "Rend my foes and ward their blows."
msgstr "Стань моим оружием и защитой!"

#. ja: ハッ、いよいよ化け物じみてきたじゃないか……！
#. de: Verschanz dich nur hinter dieser Schlange, du Feigling!
#. fr: Peuh<nbsp>! Tu crois me faire peur avec ton déguisement<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:22721:0:0"
msgid "Hah, so you really <i>are</i> a monster."
msgstr "Ха! Так ты и правда <i>чудовище</i>."

#. ja: ……あの娘に、歩み続けろと言うのか。<br>かように希望なき世界を……。
#. de: Wohin willst du das Mädchen führen? Es gibt keine Hoffnung mehr.
#. fr: Pourquoi continuer à guider Minfilia vers un monde qui n'en vaut pas la peine<nbsp>? Pourquoi<nbsp>?
msgctxt "InstanceContentTextData:22722:0:0"
msgid "Better a monster than a deceiver. A spinner of foolish dreams and false hopes."
msgstr "Лучше чудовище, чем обманщик. Сеятель глупых мечтаний и ложных надежд."

#. ja: いいや、彼女たちはきっと……<br>自らの手で、世界の明日を取り戻す。
#. de: Da liegst du falsch. Sie wird diese Welt retten.
#. fr: Laisse les Minfilia tranquilles... Ce sont justement elles qui nous forgeront un avenir digne de ce nom<nbsp>!
msgctxt "InstanceContentTextData:22723:0:0"
msgid "There is no folly in hope!"
msgstr "Надежда не бывает глупой!"

#. ja: かつての我らも、その夢を見た。<br>結果、幾人の巫女が殉じたことか……！
#. de: So dachten wir auch. Doch auf das Orakel wartet nur der Märtyrertod.
#. fr: C'est ce que nous croyions nous aussi, jadis... Une erreur qui a coûté la vie à de nombreuses jeunes filles<nbsp>!
msgctxt "InstanceContentTextData:22724:0:0"
msgid "...I said as much myself, once. I was wrong. Never again."
msgstr "...Я и сам когда-то так говорил. Ошибался. Больше не допущу."

#. ja: くそっ……。<br>ミンフィリアのソイルを放つ隙がない……！
#. de: Verdammt. Ich komm nicht zum Schuss.
#. fr: Merde<nbsp>! Impossible de tirer la cartouche de Minfilia<nbsp>!
msgctxt "InstanceContentTextData:22725:0:0"
msgid "Dammit! I need time to line up a clean shot."
msgstr "Чёрт! Мне нужно время, чтобы прицелиться."

#. ja: 隙を作れるとしたら、方法はひとつだけ……<br>命を懸けた「あの技」なら……。
#. de: Wenn ich Minfilias Erda abfeuern will, gibt es nur noch eins<nbsp>... Der Spezialtrick!
#. fr: Puisque c'est comme ça, à moi de créer l'opportunité... en utilisant ma botte secrète...
msgctxt "InstanceContentTextData:22726:0:0"
msgid "I suppose if there's no other way..."
msgstr "Похоже, другого выхода нет..."

#. ja: よく足掻く……が、これまでだ。<br>この一撃で潰えるがいい！
#. de: Schwächling<nbsp>...
#. fr: Je vois qu'on sait se battre...
msgctxt "InstanceContentTextData:22727:0:0"
msgid "When will you learn?"
msgstr "Когда же ты поймёшь?"

#. ja: もとより、ここを死に場所とする覚悟だ。<br>つきあってもらうぞ、ランジート！
#. de: Ich bin bereit, für sie zu sterben. Aber dich nehm ich mit, Ran'jit!
#. fr: De toute façon, j'ai décidé de donner ma vie pour Minfilia... mais pas sans t'avoir emmené en enfer avec moi<nbsp>!
msgctxt "InstanceContentTextData:22728:0:0"
msgid "When you're dead and buried!"
msgstr "Когда будешь лежать в могиле!"

#. ja: まずいな……負荷が高い……長くは維持できないか……。
#. de: Das sieht nicht gut aus<nbsp>...
#. fr: Ça va pas fort...
msgctxt "InstanceContentTextData:22729:0:0"
msgid "Not good..."
msgstr "Плохо дело..."

#. ja: それでも、この状態なら……！<br>ソイルを放って、渾身の一撃を叩き込める！
#. de: Ich versuch's! Ich lege alles in einen Schuss!
#. fr: Mais c'est le moment ou jamais pour tirer ma cartouche<nbsp>!
msgctxt "InstanceContentTextData:22730:0:0"
msgid "The strain is more than I remember... At least now I can get that shot."
msgstr "Напряжение куда сильнее, чем я помнил... Зато теперь смогу выстрелить."

#. ja: オオォォ……ッ！<br>貴様、「死」という「無」に踏みこんだな……！
#. de: Uoooh! Du meinst es ernst mit dem Sterben!
#. fr: Ooooh... Te voilà au plus près de la mort...
msgctxt "InstanceContentTextData:22731:0:0"
msgid "You would court death for mere parlor tricks?"
msgstr "Ты и вправду готов умереть ради дешёвых фокусов?"

#. ja: グッ……そうとも……<br>俺の命で、あいつが進めるなら、安いもんだ……！
#. de: Ja ... Wenn es ihr hilft, gebe ich mein Leben mit einem Lächeln.
#. fr: C'est un prix bien peu élevé pour qu'elle puisse remplir sa mission<nbsp>!
msgctxt "InstanceContentTextData:22732:0:0"
msgid "\\<pant> \\<pant> ...My life would be but a small price to pay."
msgstr ""

#. ja: ……ランジート。<br>小さなレディたちは大抵、家族が思うより強かだ。
#. de: Alter Mann! Du unterschätzt sie, weil sie ein junges Mädchen ist.
#. fr: Ne sous-estime pas les demoiselles nommées Minfilia, Ran'jit...
msgctxt "InstanceContentTextData:22733:0:0"
msgid "You never understood her."
msgstr "Ты никогда её не понимал."

#. ja: そしていつの間にか、遠くを歩んでいる……<br>籠になんて、閉じ込めておけるものか。
#. de: Du versteckst dich hinter einer Fassade. Deswegen wendet sie sich von dir ab.
#. fr: Elles ont tellement d'amour à donner... Et toi, tu veux les tenir en cage<nbsp>!
msgctxt "InstanceContentTextData:22734:0:0"
msgid "She is not a bird to be locked away in a gilded cage."
msgstr "Её не удержать взаперти в позолоченной клетке."

#. ja: その程度で、父きどりとは！<br>片腹痛いわ……ッ！
#. de: Und du hältst dich für ihren Beschützer?
#. fr: Et ça veut jouer les papas<nbsp>? Ridicule<nbsp>!
msgctxt "InstanceContentTextData:22735:0:0"
msgid "And you presume to be her protector. Pathetic!"
msgstr "И ты ещё смеешь называть себя её защитником? Жалок!"

#. ja: 今がチャンスだ！<br>もう一度、「あの技」を使う……！
#. de: Jetzt wäre Zeit, noch mal den Spezialtrick auszupacken!
#. fr: Maintenant<nbsp>! La botte secrète du pistosabreur<nbsp>!
msgctxt "InstanceContentTextData:22736:0:0"
msgid "Looks like I'll have to use it again, then."
msgstr "Похоже, придётся снова прибегнуть к этому приёму."

#. ja: うぐっ……ハァハァ……<br>慎重に近づいて……ソイルを……！
#. de: Uff ... Viel mehr geht nicht mehr. Jetzt muss die Erda ran.
#. fr: Haa... Haa... Doucement... Tu vas sentir passer ma cartouche, vieux débris...
msgctxt "InstanceContentTextData:22737:0:0"
msgid "Urgh... Hold still, damn you!"
msgstr "Ургх... Да замри ты, чёрт тебя дери!"

#. ja: 反逆者風情が！<br>貴様の曲芸など、見破ってくれるわ！
#. de: Nieder mit den Störenfrieden!
#. fr: Mort à nos opposants<nbsp>!
msgctxt "InstanceContentTextData:22738:0:0"
msgid "No quarter!"
msgstr "Пощады не будет!"

#. ja: ヌゥゥゥッ……またもや！<br>だが、同じ技を二度も見せたな……！
#. de: Was? Zweimal der gleiche Trick? Das sieht dir ähnlich ...
#. fr: Tu ne crois tout de même pas que je vais me laisser berner une deuxième fois<nbsp>?
msgctxt "InstanceContentTextData:22739:0:0"
msgid "You have played your hand far too early, boy."
msgstr "Ты слишком рано раскрыл свои карты, мальчишка."

#. ja: 長期戦はマズい……。<br>こうなったら……あの1発に、すべてを賭ける！
#. de: Wie lange sollen wir noch kämpfen? Ich leg jetzt alles in den nächsten Schuss.
#. fr: Ce combat doit avoir une fin, et il se terminera lors de l'impact de ma dernière cartouche<nbsp>!
msgctxt "InstanceContentTextData:22740:0:0"
msgid "This has carried on long enough, wouldn't you agree?"
msgstr "Пора бы уже закончить, тебе не кажется?"

#. ja: まだ屈さぬか……。<br>しかし、貴様はもはや窮鼠よ……。
#. de: Urgh. Du gibst nicht auf, hm?
#. fr: Tu tomberas avant moi<nbsp>!
msgctxt "InstanceContentTextData:22741:0:0"
msgid "Why do you persist in this folly?"
msgstr "К чему упорствовать в этой глупости?"

#. ja: 倒れるものかよッ！<br>さあ、持ってくれよ、俺の身体……！
#. de: War's das schon?
#. fr: C'est pas le moment de vaciller...
msgctxt "InstanceContentTextData:22742:0:0"
msgid "Is that all?"
msgstr "И это всё?"

#. ja: ぜぇ……ぜぇ……。<br>これで、ミンフィリアに託された、あのソイルを……。
#. de: Minfilias letzte Erda. Sie wird es richten.
#. fr: La cartouche de Minfilia... C'est la dernière... Ma dernière chance<nbsp>!
msgctxt "InstanceContentTextData:22743:0:0"
msgid "Minfilia's last cartridge... Have to... \\<pant> \\<pant> ...make it count..."
msgstr ""

#. ja: 見破ったりッ！
#. de: Damit erreichst du gar nichts.
#. fr: Tu crois que je ne t'ai pas vu<nbsp>?
msgctxt "InstanceContentTextData:22744:0:0"
msgid "There you are!"
msgstr "Вот ты где!"

#. ja: 捉えられた……！？<br>クソッ、もう一度気配を消して……！
#. de: Er steht noch? Verdammt. Ich muss sofort wieder in Deckung.
#. fr: Bordel, mais il a des yeux partout<nbsp>! Encore un petit effort...
msgctxt "InstanceContentTextData:22745:0:0"
msgid "Gah! But how!?"
msgstr "Гах! Но как?!"

#. ja: 愚か者めが……！<br>何度やっても同じことよ！
#. de: Dummkopf!
#. fr: Pauvre sot<nbsp>! Combien de fois comptes-tu faire la même erreur<nbsp>?
msgctxt "InstanceContentTextData:22746:0:0"
msgid "Fools to a man!"
msgstr "Все вы — глупцы!"

#. ja: ぐっ……ハァハァ……<br>同じ技じゃ、もう通じない……。
#. de: \<keuch> Mit dem gleichen Trick komm ich nicht weiter<nbsp>...
#. fr: Haa... Haa... Ça ne passe plus, on dirait...
msgctxt "InstanceContentTextData:22747:0:0"
msgid "I'd hoped you would fall for it a third time... "
msgstr "Надеялся, что ты попадёшься на это в третий раз..."

#. ja: ちくしょう……体が動かない……。<br>技の連発で、負荷をかけすぎた……。
#. de: Ich kann nicht mehr. Es war zu viel.
#. fr: Argh... J'arrive plus à mettre un pied devant l'autre à cause de cette technique...
msgctxt "InstanceContentTextData:22748:0:0"
msgid "Urgh... Though two times was... \\<pant> \\<pant> ...perhaps already too many..."
msgstr ""

#. ja: 万策尽きたか……。<br>このまま、葬り去ってやろう。
#. de: Wer Ruhm in der Schlacht sucht, wird nur sein Grab finden.
#. fr: C'est tout ce que tu as dans le ventre<nbsp>? Alors, il est grand temps d'en finir<nbsp>!
msgctxt "InstanceContentTextData:22749:0:0"
msgid "No more tricks? Then let us finish this."
msgstr "Больше никаких трюков? Тогда покончим с этим."

#. ja: このままじゃ負けだ……。<br>イチかバチか、やるしかない……！
#. de: Der nächste Angriff entscheidet. Es geht um alles oder nichts.
#. fr: C'est lui ou moi... Je dois tenter le tout pour le tout<nbsp>!
msgctxt "InstanceContentTextData:22750:0:0"
msgid "But you've not even seen the grand finale."
msgstr "Но ты ещё не видел моего главного фокуса."

#. ja: 負荷を限界まで上げ……己を完全に消し去る……ッ！
#. de: Ich muss jetzt ganz verschwinden. Es ist meine letzte Chance.
#. fr: Encore une disparition, et advienne que pourra...
msgctxt "InstanceContentTextData:22751:0:0"
msgid "One...last...disappearing act... "
msgstr "Ещё одно... последнее... исчезновение..."

#. ja: 虫の息で、目だけギラつかせおって。<br>だがそれも、ここで仕舞いだ……！
#. de: Ich höre deinen Atem. Ich sehe das Funkeln deiner Augen. Du entkommst mir nicht!
#. fr: Tu ne manques pas de combativité, je dois l'admettre... mais ta fin est proche<nbsp>!
msgctxt "InstanceContentTextData:22752:0:0"
msgid "Were you not struggling to stand I might think you serious."
msgstr "На ногах еле держишься, а глаза так и горят. Неужели ты всерьёз?"

#. ja: いいや……刺し違えてでも、お前を倒す！<br>命脈ごと気配を断て……ソウルレスインビジブル！
#. de: Diesmal nicht. Diesmal mache ich sogar meine Seele unsichtbar!
#. fr: Encore plus proche de toi que tu ne le crois... À moi, Invisibilité sans âme<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:22753:0:0"
msgid "Oh, I am <i>deadly</i> serious."
msgstr "О, я <i>смертельно</i> серьёзен."

#. ja: 気配が……完全に消えた……ッ！？
#. de: Er ist weg! Wo ist er hin?
#. fr: Quoi<nbsp>!? Où est-ce qu'il est passé<nbsp>?
msgctxt "InstanceContentTextData:22754:0:0"
msgid "Fool! You think the shadows will save you?"
msgstr "Глупец! Думаешь, тени тебя спасут?"

#. ja: オォォォォォ……ッ！<br>ならば、すべてを破壊しつくすまでよッ！
#. de: Uaaaaargh! Dann verwüste ich eben alles!
#. fr: Qu'importe<nbsp>! Je vais faire parler ma colère, et elle t'emportera sur son passage<nbsp>!
msgctxt "InstanceContentTextData:22755:0:0"
msgid "There is no escape! Do you hear me!?"
msgstr "Тебе не сбежать! Слышишь меня?!"

#. ja: うおおおぉぉぉぉッ！
#. de: Aaaaah!
#. fr: Brûle en enfer<nbsp>!
msgctxt "InstanceContentTextData:22756:0:0"
msgid "To hell with you!!!"
msgstr "Да провались ты в ад!!!"

#. ja: ……お前たちがついてるんだ、俺は負けないさ。<br>そうだろ、ミンフィリア……アシリア……。
#. de: Ich kann nicht verlieren ... Weil ich mit euch kämpfe<nbsp>... Minfilia<nbsp>... Acilia<nbsp>...
#. fr: Minfilia... Ma chère Ascilia... Avec toi à mes côtés, je ne peux pas perdre...
msgctxt "InstanceContentTextData:22757:0:0"
msgid "Thank you, Minfilia...for this precious gift..."
msgstr "Спасибо, Минфилия... за этот бесценный дар..."

#. ja: ぐっ……これ以上は持たない……早くソイルを……！
#. de: Ich kann nicht länger warten. Jetzt muss die Erda her.
#. fr: Mon cœur va... lâcher... La cartouche... Maintenant<nbsp>!
msgctxt "InstanceContentTextData:22758:0:0"
msgid "Come on, old boy... \\<pant> ...One more shot..."
msgstr ""

#. ja: 逃げられぬ以上、何もできずに果てるのみよ！
#. de: Die Zeit der Ausflüchte ist vorbei.
#. fr: Rends-toi ou ta mort sera lente et douloureuse<nbsp>!
msgctxt "InstanceContentTextData:22761:0:0"
msgid "Yield now and I will grant you a quick death."
msgstr "Сдавайся, и я дарую тебе быструю смерть."

#. ja: いいや……<br>積み重ねた戦いをもって、この秘技を行使する！
#. de: Warte, alter Hund. Einen Trick habe ich noch.
#. fr: À ta place, je ne parlerais pas trop vite<nbsp>!
msgctxt "InstanceContentTextData:22762:0:0"
msgid "But we've only just begun."
msgstr "Но мы только начали."

#. ja: 鼠ごときの分際で……ッ！
#. de: Ratte. Du bist nichts als eine feige Ratte.
#. fr: Tu es bien insolent pour un rat...
msgctxt "InstanceContentTextData:22763:0:0"
msgid "Then pay it you shall!"
msgstr "Тогда расплатишься сполна!"

#. ja: 我はリヴァイアサン……<br>失われた水底より来たりし、渦巻く者……！
#. de: Erhebt euch, Ozeane! Verschlingt dieses verlassene Land!
#. fr: Moi, Léviathan, je reviens des profondeurs asséchées pour déchaîner les marées<nbsp>!
msgctxt "InstanceContentTextData:22800:0:0"
msgid "Rise, oceans! Swallow this forsaken land!"
msgstr "Воспряньте, океаны! Поглотите эту забытую землю!"

#. ja: 我がアギトは、岩をも砕く……！
#. de: Alles soll vor mir zerfallen!
#. fr: Même mes ouïes sont capables de fendre la pierre<nbsp>!
msgctxt "InstanceContentTextData:22801:0:0"
msgid "All shall crumble before me!"
msgstr "Всё рассыплется в прах предо мной!"

#. ja: 大洋は氾濫し、すべてを洗い流す……<br>命の水よ牙を剥け、大海嘯！
#. de: Wall der Gezeiten! Brechende Wellen! Niemand wird verschont!
#. fr: Que les vagues déferlent et purifient cette terre<nbsp>!
msgctxt "InstanceContentTextData:22802:0:0"
msgid "Surge, tides! Crush, waves! Let none be spared."
msgstr "Вздымайтесь, приливы! Сокрушайте, волны! Не пощадите никого."

#. ja: 何者も海を統べること、叶わぬと知れ……<br>ヒトは、ただ揺られ、流され、翻弄されるのみ……！
#. de: Eure Leichen werden vom Strudel verschlungen!
#. fr: Nul ne dompte la mer. Le destin de l'Homme est d'être englouti par ses flots<nbsp>!
msgctxt "InstanceContentTextData:22803:0:0"
msgid "Your corse shall feed the vortex!"
msgstr "Ваши трупы станут добычей водоворота!"

#. ja: 寄セテハ返スガ、波ノ定メ……<br>全テヲ呑ミ込ムマデ、満チヨ、大海嘯！
#. de: Zu stur, um euer Schicksal zu akzeptieren! Zu blind, um zu sehen, dass ihr verdammt seid!
#. fr: Les vagues vont et viennent comme les ères... Et emportent tout<nbsp>!
msgctxt "InstanceContentTextData:22804:0:0"
msgid "Too stubborn to accept your fate, too blind to see you are doomed!"
msgstr "Слишком упрямы, чтобы принять судьбу, слишком слепы, чтобы понять, что обречены!"

#. ja: ガアアァァァァァ……<br>満チル……満チル……水ノ力……目覚メノ刻、来レリ！
#. de: Kraft ... Solche Kraft ... Sie soll mir gehören!
#. fr: GRAAAAAAH<nbsp>! Les eaux montent<nbsp>! Leur puissance est mienne<nbsp>!
msgctxt "InstanceContentTextData:22805:0:0"
msgid "Power...such power...mine for the taking!"
msgstr "Сила... такая сила... Она будет моей!"

#. ja: 始原ノ刻ヨリ、波ハ止マルコトヲ知ラズ！
#. de: Niemand wird sich mir widersetzen!
#. fr: Les ondes de la création sont inarrêtables<nbsp>!
msgctxt "InstanceContentTextData:22806:0:0"
msgid "None shall defy me!"
msgstr "Никто мне не перечит!"

#. ja: コノ星ガ終ワルマデ、波ハ止マルコトナシ！
#. de: Alles ... wird von mir verzehrt!
#. fr: Les vagues continueront de déferler tant que cet astre vivra<nbsp>!
msgctxt "InstanceContentTextData:22807:0:0"
msgid "Everything...is mine to consume!"
msgstr "Всё... будет поглощено мной!"

#. ja: 失ワレシ水底ヨリ、絶望ノ叫ビヲ聞ケ……！<br>全テヲ押シ流ソウ、永遠ニ……！
#. de: Ich werde nicht ruhen, ehe der Ozean jeden Ilm dieser Welt bedeckt!
#. fr: Un océan sans limites recouvrira ce monde<nbsp>! Entendez le cri de désespoir venu des profondeurs<nbsp>!
msgctxt "InstanceContentTextData:22808:0:0"
msgid "I will not cease until the ocean covers every ilm of this star!"
msgstr "Не успокоюсь, пока океан не покроет каждый илм этой звезды!"

#. ja: 死ノ底ニ沈メ……！！
#. de: Nun wird die See alles verschlingen!
#. fr: Sombrez dans les abysses<nbsp>!
msgctxt "InstanceContentTextData:22809:0:0"
msgid "Now, the sea shall swallow all!"
msgstr "Море поглотит всё!"

#. ja: “大丈夫ですか、<split " " 1><string $gs1></split>さん！？<br>エデンの力を使って、どうにか足場を再生してみます！”
#. de: <split " " 1><string $gs1></split>! Ich werde Edens Kraft einsetzen!
#. fr: <split " " 1><string $gs1></split><nbsp>! Accrochez-vous<nbsp>! Je devrais pouvoir vous aider avec Éden<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:22810:0:0"
msgid "<split \" \" 1><string $gs1></split>! I'll use Eden's power!"
msgstr "<split \" \" 1><string $gs1></split>! Я воспользуюсь силой Эдема!"

#. ja: “お、お待たせしました……！<br>周囲のエーテルに干渉して、足場を再生します！”
#. de: Das sollte fürs Erste halten, aber sei vorsichtig!
#. fr: Ça y est<nbsp>! J'ai réussi à convertir assez d'éther pour restaurer la plateforme<nbsp>!
msgctxt "InstanceContentTextData:22811:0:0"
msgid "This should hold for now, but be careful!"
msgstr "Пока этого хватит, но будь осторожен!"

#. ja: 何度、壊されたって、エデンの力で……！
#. de: Nicht schon wieder! Warte, ich versuche, es wieder aufzubauen!
#. fr: Encore<nbsp>!? Tenez bon, je m'en occupe<nbsp>!
msgctxt "InstanceContentTextData:22812:0:0"
msgid "Not again! Hold on, I'll try to rebuild it!"
msgstr "Опять?! Держись, попробую всё восстановить!"

#. ja: 足場の再生を行います……！
#. de: Das ist es, Eden!
#. fr: Vous allez pouvoir respirer, <split " " 1><string $gs1></split><nbsp>!
msgctxt "InstanceContentTextData:22813:0:0"
msgid "That's it, Eden!"
msgstr "Вот так, Эдем!"

#. ja: <sheet BNpcName 8486 0>の撃破
#. de: Leviathan bezwingen
#. fr: Vaincre <sheet BNpcName 8486 0>
msgctxt "InstanceContentTextData:22814:0:0"
msgid "Defeat Leviathan"
msgstr "Победите Левиафана"

#. ja: レンダ・レイの仇討ちの真実を追体験せよ！
#. de: Lass B'alam Quitze die Rache von Renda-Rae verspüren
#. fr: Vainquez B'alam Quitze<nbsp>!
msgctxt "InstanceContentTextData:22900:0:0"
msgid "Relive Renda-Rae's battle against Balam-Quitz!"
msgstr "Переживите заново битву Ренды-Рэй с Балам-Квицем!"

#. ja: バラム・キツェー！<br>仲間の仇だ、お前を討ち取ってやる……！
#. de: B'alam Quitze! Jetzt werde ich blutige Rache für meine Kameraden üben!
#. fr: B'alam Quitze, tu vas payer pourrr ce que tu as fait<nbsp>!
msgctxt "InstanceContentTextData:22903:0:0"
msgid "Balam-Quitz! Vengeance will be mine this day!"
msgstr "Балам-Квиц! Сегодня я отомщу!"

#. ja: もう以前のアタシじゃない！<br>「ダグリングアロー」で、その咆哮を止めてみせる！
#. de: Ich bin nicht mehr die hochmütige Renda-Rae von einst! Mit meinen ermattenden Pfeilen werde ich dein Gebrüll im Keim ersticken!
#. fr: Je ne suis plus la même<nbsp>! Mes flèches engourdissantes feront taire ton rrrugissement<nbsp>!
msgctxt "InstanceContentTextData:22904:0:0"
msgid "Just wait until I hit you with one of my dulling arrows..."
msgstr "Только попадись под одну из моих усыпляющих стрел..."

#. ja: 成功した！ これなら、勝てる……！
#. de: Es funktioniert! Die Rache wird mein sein!
#. fr: Ça a marrrché<nbsp>! Je peux gagner...
msgctxt "InstanceContentTextData:22905:0:0"
msgid "It worked! I've got you now, you bastard..."
msgstr "Получилось! Теперь-то я тебя достану, ублюдок..."

#. ja: くっ……耳が……。<br>「ダグリングアロー」で……咆哮を止めないと……。
#. de: \<keuch> Meine Ohren<nbsp>... Muss meine<nbsp>... ermattenden Pfeile<nbsp>... ins Ziel bringen<nbsp>...
#. fr: Ma tête... Il faut que je l'empêche de rugirrr avec mes flèches engourdissantes...
msgctxt "InstanceContentTextData:22906:0:0"
msgid "Gah, my ears! Need to use the arrows..."
msgstr "Ах, уши! Надо пустить в ход стрелы..."

#. ja: うう……負けるものか……。<br>今度こそ、「ダグリングアロー」を成功させなきゃ……。
#. de: \<stöhn> M-Muss das Gebrüll der Bestie<nbsp>... mit ermattenden Pfeilen<nbsp>... stoppen!
#. fr: Je ne peux pas perrrdre... Il faut que je fasse mouche avec mes flèches engourdissantes...
msgctxt "InstanceContentTextData:22907:0:0"
msgid "All I need is one good shot with a dulling arrow..."
msgstr "Мне бы попасть усыпляющей стрелой... всего один раз..."

#. ja: うぁ……またも……。<br>「ダグリングアロー」を成功させないと、勝ち目がない……。
#. de: Argh, m-muss das Gebrüll B'alam Quitzes stoppen<nbsp>... Meine ermattenden Pfeile<nbsp>... dürfen ihr Ziel nicht verfehlen!
#. fr: Argh, encorrre... Je dois persévérer avec mes flèches engourdissantes...
msgctxt "InstanceContentTextData:22908:0:0"
msgid "Godsdammit, what is wrong with you? Use the arrows..."
msgstr "Да что с тобой такое?! Стрелы — в ход..."

#. ja: うぐぐ……アイツが咆哮を上げる前に……<br>「ダグリングアロー」を放つ……それさえできれば……。
#. de: Grrr, dieses markerschütternde Gebrüll! Muss es unterbinden<nbsp>... Muss sie mit den<nbsp>... ermattenden Pfeilen treffen<nbsp>...
#. fr: Mes flèches engourrrdissantes sont la clef de ce combat, je le sais<nbsp>!
msgctxt "InstanceContentTextData:22909:0:0"
msgid "Ugh... Need to hit him with a dulling arrow before he roars..."
msgstr "Уф... Надо попасть в него усыпляющей стрелой, пока он не зарычал..."

#. ja: お前を倒して、仲間の無念を晴らす！
#. de: Ich werde dich erlegen, um das Andenken meiner Freunde zu ehren!
#. fr: Je vais venger la morrrt de mes compagnons<nbsp>!
msgctxt "InstanceContentTextData:22910:0:0"
msgid "You'll pay for taking them from me!"
msgstr "Ты заплатишь за то, что отнял у меня друзей!"

#. ja: これはアタシの仇討ち。<br>だから、自分ひとりで果たしてみせるんだ……。
#. de: Das ist <i>meine</i> Rache! Nur ich alleine werde sie vollstrecken!
#. fr: C'est ma vengeance, et je dois l'accomplirrr seule.
msgctxt "InstanceContentTextData:22911:0:0"
msgid "It was my fault. My failure. That's why I have to do it alone..."
msgstr "Это моя вина. Я не справилась. Вот почему я должна сделать это одна..."

#. ja: あのときのアタシに、いまほどの力があれば、<br>仲間を失うこともなかったのに……。
#. de: Wenn ich damals nicht so schwach gewesen wäre<nbsp>... Wenn ich mein heutiges Wissen gehabt hätte, wären meine Freunde noch am Leben!
#. fr: Si seulement j'avais été aussi forrrte, mes compagnons seraient toujours là...
msgctxt "InstanceContentTextData:22912:0:0"
msgid "If I'd only been this strong back then, they'd still be alive..."
msgstr "Если бы я тогда была такой же сильной, они бы остались живы..."

#. ja: 咆哮を上げる力もなくなったか？<br>いまが好機だ、一気に仕留める！
#. de: Dir ist das Gebrüll wohl vergangen, was? Jetzt werde ich dir den Blattschuss versetzen!
#. fr: Elle n'a même plus la forrrce de rugir<nbsp>!? C'est maintenant ou jamais<nbsp>!
msgctxt "InstanceContentTextData:22913:0:0"
msgid "You can feel it, can't you!? The pain, the fear! Serves you right!"
msgstr "Чувствуешь? Боль, страх! Так тебе и надо!"

#. ja: な、なんだ……？<br>アイツから強力な力を感じる……まだそんな力が……？
#. de: W-Was hat das<nbsp>...? Diese Kraft<nbsp>... Diese unglaubliche Kraft, die ich in ihr spüre<nbsp>...
#. fr: Hein<nbsp>!? Je ressens une puissante énerrrgie... Comment est-ce possible<nbsp>?
msgctxt "InstanceContentTextData:22914:0:0"
msgid "What the─ Where is this coming from!?"
msgstr "Что за... Откуда это?!"

#. ja: ぐはッ！<br>そ、そんな……アタシひとりじゃ……勝てな……い。
#. de: Argh! Das kann nicht<nbsp>... I-Ich habe<nbsp>... versagt<nbsp>...
#. fr: Arrrgh<nbsp>! Seule, je ne suis pas de taille...
msgctxt "InstanceContentTextData:22915:0:0"
msgid "Gah! I won't let it end like this!"
msgstr "Гах! Я не позволю этому так закончиться!"

#. ja: バカ野郎！　ひとりで無茶しやがって……！
#. de: Renda-Rae! Bist du des Wahnsinns?! Alleine so eine Bestie anzugehen!
#. fr: Idiote<nbsp>! Qu'est-ce que tu fais ici toute seule<nbsp>?
msgctxt "InstanceContentTextData:22916:0:0"
msgid "We won't! Godsdammit, Renda..."
msgstr "Не позволим! Проклятье, Ренда..."

#. ja: どうやら、間に合ったようだな……。
#. de: Scheint, als wären wir zur rechten Zeit eingetroffen!
#. fr: Ouf, on est arrivés à temps...
msgctxt "InstanceContentTextData:22917:0:0"
msgid "Made it in the nick, I see."
msgstr "Успели в самый последний миг, как я погляжу."

#. ja: 大丈夫！？　いま、ケガを治してあげる……！
#. de: Alles in Ordnung, Renda-Rae? Lass mich deine Wunden heilen!
#. fr: Tu tiens le coup<nbsp>? Je vais te soigner<nbsp>!
msgctxt "InstanceContentTextData:22918:0:0"
msgid "Are you hurt!? Don't worry, I've got you..."
msgstr "Ты ранена?! Не бойся, я помогу..."

#. ja: やれやれ……とんだじゃじゃ馬だな。<br>いや、お前の場合、じゃじゃ猫か……。
#. de: Immer diese einfältigen Kätzchen! Aber sei unbesorgt, wir holen dich aus dem Schlamassel wieder raus!
#. fr: Tu voulais t'amuser sans nous, hein<nbsp>? Petite cachottière<nbsp>!
msgctxt "InstanceContentTextData:22919:0:0"
msgid "The lone wolf just had to do it on her own terms..."
msgstr "Вот ведь одиночка, всё норовит сделать по-своему..."

#. ja: とにかく、無事なようでよかったです。
#. de: Zum Glück haben wir dich noch rechtzeitig gefunden.
#. fr: Ça fait plaisir de te revoir<nbsp>!
msgctxt "InstanceContentTextData:22920:0:0"
msgid "Aye, well, I was never good at indulging foolishness."
msgstr "Ага, глупостям я никогда не потакал."

#. ja: みんな……どうして？<br>わざわざ、アタシのために……？
#. de: W-Was macht ihr hier? Seid ihr extra meinetwegen<nbsp>...?
#. fr: Vous êtes tous venus... Juste pourrr moi<nbsp>!?
msgctxt "InstanceContentTextData:22921:0:0"
msgid "Don't...don't tell me you followed my trail?"
msgstr "Вы... вы шли по моему следу?"

#. ja: 話は奴を片付けてからだ！<br>まだやれるな、レンダ？
#. de: Wir können später noch plaudern! Lasst uns erstmal diesen Fleischberg abservieren! Kannst du deinen Bogen noch spannen?
#. fr: On parlera après<nbsp>! Renda, tu es toujours en état de te battre<nbsp>?
msgctxt "InstanceContentTextData:22922:0:0"
msgid "I'll tell you all about it after we kill this bloody bastard, aye?"
msgstr "Расскажу, как прикончим этого проклятого ублюдка, ага?"

#. ja: レンダと私が狙われてる！<br>仲間を巻き込まないよう、離れて！
#. de: Sie hat es auf Renda und mich abgesehen. Lasst euch nicht in die Ecke treiben. Verteilt euch!
#. fr: Elle vise Renda et moi<nbsp>! Écartez-vous<nbsp>!
msgctxt "InstanceContentTextData:22923:0:0"
msgid "It's coming for me and Renda! Keep your distance!"
msgstr "Она нацелилась на меня и Ренду! Держитесь подальше!"

#. ja: 皆、ナイルベルトのもとに集まるんだ！<br>敵の攻撃を分散させるぞ！
#. de: Alle zu Nyelbert! Das wird den Angriff der Bestie zerstreuen!
#. fr: Tous près de Nyelbert<nbsp>! On va la désorienter<nbsp>!
msgctxt "InstanceContentTextData:22924:0:0"
msgid "Gather round Nyelbert! Lend him your strength!"
msgstr "Все к Нильберту! Помогите ему!"

#. ja: また咆哮を？　させるものかッ……！
#. de: Willst schon wieder brüllen, was?
#. fr: Encore un rugissement<nbsp>!? Je ne te laisserrrai pas faire<nbsp>!
msgctxt "InstanceContentTextData:22925:0:0"
msgid "Gonna roar again, huh? The hells you will!"
msgstr "Опять собралась рычать? Ещё чего!"

#. ja: 何度でも止めてみせる！
#. de: Dir werd ich das Maul stopfen! Immer und immer wieder!
#. fr: Je t'arrêterai autant de fois qu'il faudrrra<nbsp>!
msgctxt "InstanceContentTextData:22926:0:0"
msgid "I've got plenty arrows left for you yet!"
msgstr "У меня стрел на тебя ещё полно!"

#. ja: くっ……失敗した……！
#. de: Argh, das ging daneben!
#. fr: Merde, rrraté...
msgctxt "InstanceContentTextData:22927:0:0"
msgid "Gah... Too late..."
msgstr "Чёрт... Не успела..."

#. ja: 安心しろ、レンダ。<br>オレが護るから、落ち着くんだ。
#. de: Keine Sorge Renda, ich steh dir bei. Konzentrier dich auf den Kampf!
#. fr: Calme-toi, Renda. Je suis là pour te protéger.
msgctxt "InstanceContentTextData:22928:0:0"
msgid "Steady, Renda! We'll best this bastard yet!"
msgstr "Держись, Ренда! Мы ещё одолеем этого ублюдка!"

#. ja: 私がいる限り、誰も死なせないからね！
#. de: Solange ich hier bin, stirbt heute keiner!
#. fr: Tant que je suis là, vous n'avez rien à craindre<nbsp>!
msgctxt "InstanceContentTextData:22929:0:0"
msgid "No one's dying on my watch!"
msgstr "Пока я здесь, никто не умрёт!"

#. ja: 何度でも止めてみせる！
#. de: Solange ich den Bogen spannen kann, kommt aus deiner Kehle kein Ton, Bestie!
#. fr: Je t'arrêterai autant de fois qu'il faudrrra<nbsp>!
msgctxt "InstanceContentTextData:22930:0:0"
msgid "Take that, you bastard!"
msgstr "Получай, ублюдок!"

#. ja: やるじゃないか、その調子だ！
#. de: Gut so! Wir haben sie gleich!
#. fr: C'est bien, on continue comme ça<nbsp>!
msgctxt "InstanceContentTextData:22931:0:0"
msgid "Well struck! Keep it up!"
msgstr "Вот это удар! Так держать!"

#. ja: みんなで力を合わせましょう！
#. de: Alle zusammen! Heizt ihr ein!
#. fr: Allez, tous ensemble<nbsp>!
msgctxt "InstanceContentTextData:22932:0:0"
msgid "Focus, everyone!"
msgstr "Все сосредоточьтесь!"

#. ja: レンダ！　ナイルベルト！<br>ラミットのもとに集まれ！
#. de: Renda! Nyelbert! Sammelt euch bei Lamitt!
#. fr: Renda, Nyelbert<nbsp>! Près de Lamitt<nbsp>!
msgctxt "InstanceContentTextData:22933:0:0"
msgid "Renda, Nyelbert! Assist Lamitt, quickly!"
msgstr "Ренда, Нильберт! Быстро, на помощь Ламитт!"

#. ja: 奴が力を溜め始めた！<br>大技が来る前に、一気にたたみかけるぞ……！
#. de: Das Biest bereitet einen starken Angriff vor! Wir müssen das vereiteln!
#. fr: Elle est en train de concentrer son énergie... Harcelons-la avant son attaque<nbsp>!
msgctxt "InstanceContentTextData:22934:0:0"
msgid "It's summoning all its strength for something big. Finish it!"
msgstr "Она собирает силы для мощной атаки. Добейте её!"

#. ja: みんな、私のもとに集まって！　力を高めるの！
#. de: Alle zu mir! Ich werde uns Kraft verleihen!
#. fr: Venez tous près de moi, je vais vous fortifier<nbsp>!
msgctxt "InstanceContentTextData:22935:0:0"
msgid "Everyone, to me! I'll lend you my power!"
msgstr "Все ко мне! Я поделюсь с вами своей силой!"

#. ja: バラム・キツェー！<br>仲間とともに、お前を討ち取ってやる……！
#. de: B'alam Quitze! Jetzt werde ich meinen Rachedurst mit deinem Blut stillen!
#. fr: B'alam Quitze<nbsp>! Tous ensemble, on te vaincrrra<nbsp>!
msgctxt "InstanceContentTextData:22936:0:0"
msgid "Together we will avenge my fallen friends!"
msgstr "Вместе мы отомстим за павших друзей!"

#. ja: 手ごたえが変わった！？　硬化しやがったぞ！
#. de: Die Bestie hat ihre Taktik geändert. Sie wappnet sich gegen Angriffe!
#. fr: Qu'est-ce qui se passe<nbsp>? On dirait qu'elle encaisse mieux les coups<nbsp>!
msgctxt "InstanceContentTextData:22937:0:0"
msgid "Something's wrong! It's shrugging off our attacks!"
msgstr "Что-то не так! Наши атаки ей нипочём!"

#. ja: 咆哮さえ止めれば、お前なんか……！
#. de: Solange dein Gebrüll unterbunden wird, bist du des Todes!
#. fr: Sans ton rugissement, tu ne me fais pas peurrr<nbsp>!
msgctxt "InstanceContentTextData:22938:0:0"
msgid "Without your roar you're nothing!"
msgstr "Без своего рёва ты ничто!"

#. ja: うぁ……落ち着けアタシ。<br>「ダグリングアロー」で咆哮を止めるんだ。
#. de: Urks, muss mich konzentrieren. Ich muss das Gebrüll mit meinen ermattenden Pfeilen unterbinden!
#. fr: Reste zen, Renda... Concentrrre-toi sur tes flèches engourdissantes.
msgctxt "InstanceContentTextData:22939:0:0"
msgid "Calm down. Trust the arrows. Shut its bloody gob..."
msgstr "Спокойно. Доверься стрелам. Заткни ей пасть..."

#. ja: うう……「ダグリングアロー」さえ……放てば……。
#. de: \<keuch> Muss meine ermattenden Pfeile anwenden!
#. fr: Juste une petite ouverturrre... Le temps de tirer mes flèches engourdissantes...
msgctxt "InstanceContentTextData:22940:0:0"
msgid "Grr... Need to hit it with a dulling arrow..."
msgstr "Грр... Надо попасть в неё усыпляющей стрелой..."

#. ja: くっ……絶対に止められるはず……やらなきゃ……！！
#. de: \<stöhn> Ich darf nicht versagen. Ich <i>muss</i> es schaffen!
#. fr: Je sais que j'en suis capable... Je peux le fairrre<nbsp>!
msgctxt "InstanceContentTextData:22941:0:0"
msgid "The arrows...use the arrows. It's the only way..."
msgstr "Стрелы... используй стрелы. Другого выхода нет..."

#. ja: アイツが咆哮を上げる前に、「ダグリングアロー」を放つんだ！
#. de: Ich muss ihr Brüllen unterbinden! Mit meinen ermattenden Pfeilen kann ich es schaffen!
#. fr: Je dois tirrrer juste avant qu'elle rugisse<nbsp>!
msgctxt "InstanceContentTextData:22942:0:0"
msgid "Gotta hit it with a dulling arrow before it roars again..."
msgstr "Надо попасть в неё усыпляющей стрелой, пока она снова не зарычала..."

#. ja: この調子で、止め続けてやる！
#. de: Sehr gut! Jetzt nicht nachlassen!
#. fr: Voilà<nbsp>! Il faut continuer comme ça<nbsp>!
msgctxt "InstanceContentTextData:22943:0:0"
msgid "Yes, yes! Just like that!"
msgstr "Да, да! Вот так!"

#. ja: 吠えさせるものか！　「ダグリングアロー」で止めてやる！
#. de: Das Brüllen wird dir im Halse stecken bleiben, Ungeheuer!
#. fr: Mes flèches engourdissantes vont te ferrrmer ton clapet<nbsp>!
msgctxt "InstanceContentTextData:22944:0:0"
msgid "Like I'll let you roar again! I've got plenty of arrows left!"
msgstr "Ещё раз взреветь тебе не дам! У меня ещё полно стрел!"
