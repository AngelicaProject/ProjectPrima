# InstanceContentTextData
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 技巧宮の突破
#. de: Den Schrein des Handwerks erobern
#. fr: Franchir la Gloire de l'ingéniosité
msgctxt "InstanceContentTextData:33000:0:0"
msgid "Clear Ingenuity's Foothold"
msgstr "Одолейте Оплот Изобретательности"

#. ja: 導きの歩廊の突破
#. de: Den Pfad der Führung erobern
#. fr: Franchir le Corridor céleste
msgctxt "InstanceContentTextData:33001:0:0"
msgid "Clear the Path"
msgstr "Одолейте Тропу Наставления"

#. ja: 彗星宮の突破
#. de: Den Schrein des Kometen erobern
#. fr: Franchir le Monument à la destruction
msgctxt "InstanceContentTextData:33002:0:0"
msgid "Clear the Monument to Destruction"
msgstr "Одолейте Памятник Разрушения"

#. ja: 壮麗なる都の突破
#. de: Die Stadt der Herrlichkeit erobern
#. fr: Franchir la Cité des splendeurs
msgctxt "InstanceContentTextData:33003:0:0"
msgid "Clear the Endless City"
msgstr "Одолейте Бесконечный город"

#. ja: 審理宮の突破
#. de: Den Schrein des Urteils erobern
#. fr: Franchir le Cercle de la justice
msgctxt "InstanceContentTextData:33004:0:0"
msgid "Clear the Circle of Inquiry"
msgstr "Одолейте Круг Познания"

#. ja: 二面宮の突破
#. de: Den Schrein der Zwei erobern
#. fr: Franchir le Palais jumeau
msgctxt "InstanceContentTextData:33005:0:0"
msgid "Clear the Twin Halls"
msgstr "Одолейте Двойные чертоги"

#. ja: ほう、ビエルゴを退けるとはな……！
#. de: Ihr habt Byregot überwunden?
#. fr: Ainsi, vous avez su tenir tête à Byregot...<nbsp>?
msgctxt "InstanceContentTextData:33006:0:0"
msgid "The Builder has been made to yield..."
msgstr "Созидатель уступил..."

#. ja: では此奴で、試させてもらおうか……！
#. de: Mal sehen, was ihr mit meinen Helfern anstellt.
#. fr: Voici votre prochain adversaire<nbsp>!
msgctxt "InstanceContentTextData:33007:0:0"
msgid "Intriguing. Then the Destroyer shall take your measure..."
msgstr "Любопытно. Посмотрим, как с вами справится Разрушитель..."

#. ja: 我が神使と戦い、人の力を見せてみよ！
#. de: Kämpft mit ihnen, auf dass ich eure Kraft erkenne!
#. fr: Prouvez votre valeur en venant à bout de mon serviteur<nbsp>!
msgctxt "InstanceContentTextData:33008:0:0"
msgid "...After you have provided my servant with some sport."
msgstr "...А прежде повеселите моего слугу."

#. ja: 壊神の名のもとに、あなた方を排除します。
#. de: Ich werde euch besiegen, im Namen des Zerstörers!
#. fr: Au nom du Destructeur, je vais vous éliminer.
msgctxt "InstanceContentTextData:33009:0:0"
msgid "In the name of the Destroyer, I will lay you low."
msgstr "Именем Разрушителя я сокрушу вас."

#. ja: 授けられし神斧の力に、慄きなさい！
#. de: Meine göttliche Axt wird euch zerschmettern!
#. fr: Ma hache divine va vous déchiqueter<nbsp>!
msgctxt "InstanceContentTextData:33010:0:0"
msgid "My divine axe will rend you in twain!"
msgstr "Трепещите перед мощью моей божественной секиры!"

#. ja: では、壊神と一戦交えようではないか！
#. de: Beweist euch gegenüber dem Zerstörer!
#. fr: Serez-vous capables de relever le défi de Rhalgr, le Destructeur<nbsp>?
msgctxt "InstanceContentTextData:33011:0:0"
msgid "Come, show me the strength of mankind!"
msgstr "Ну же, покажите, на что способны люди!"

#. ja: 神域の威光で、地に這うがいい！
#. de: Kriecht im Angesicht meiner göttlichen Gewalt!
#. fr: Rampez sous l'autorité divine<nbsp>!
msgctxt "InstanceContentTextData:33012:0:0"
msgid "Upon the ground you shall crawl!"
msgstr "Ползите по земле перед лицом моей божественной силы!"

#. ja: 壊神の名のもとに……
#. de: Ich bin der Zerstörer!
#. fr: Héros de l'humanité, préparez-vous...
msgctxt "InstanceContentTextData:33013:0:0"
msgid "By my authority as the Destroyer..."
msgstr "Властью Разрушителя..."

#. ja: 我が奥義……！　壊神創幻撃！
#. de: Dies ist meine schärfste Waffe!
#. fr: Ô suprême puissance destructrice<nbsp>!
msgctxt "InstanceContentTextData:33014:0:0"
msgid "I will break you body and soul!"
msgstr "Я сокрушу вас телом и духом!"

#. ja: 彗星よ、堕ちてすべてを打ち壊せ！
#. de: Meteor, stürze herab und zerstöre alles Leben!
#. fr: Que les étoiles s'abattent sur vous<nbsp>!
msgctxt "InstanceContentTextData:33015:0:0"
msgid "Wandering star, descend and destroy!"
msgstr "Звезда, что странствует в небесах, пади и всё разрушь!"

#. ja: せいぜい踏みとどまるがいい！
#. de: Etwas mehr Respekt vor göttlicher Größe!
#. fr: Arrière, frêles mortels<nbsp>!
msgctxt "InstanceContentTextData:33016:0:0"
msgid "Keep a reverent distance!"
msgstr "Держитесь почтительно от меня подальше!"

#. ja: 轟雷の杖よ、力を解き放て……！
#. de: Donnerstab, entfessele deine Macht!
#. fr: Goûtez à la force foudroyante de mon bâton<nbsp>!
msgctxt "InstanceContentTextData:33017:0:0"
msgid "Bask in my blinding resplendence!"
msgstr "Узрите ослепительный блеск моей силы!"

#. ja: お前たちに先見の明はあるか？
#. de: Erkennt ihr die Gefahr, wenn ihr sie seht?
#. fr: Saurez-vous prévoir votre destin<nbsp>?
msgctxt "InstanceContentTextData:33018:0:0"
msgid "Can you predict your own undoing?"
msgstr "Сумеете предугадать собственную гибель?"

#. ja: 人の子らよ、やるではないか……！
#. de: Ihr seid stark, wirklich stark<nbsp>...
#. fr: Tant de ressources insoupçonnées... Vous êtes fascinants<nbsp>!
msgctxt "InstanceContentTextData:33019:0:0"
msgid "Most impressive, children of man..."
msgstr "Весьма впечатляет, дети человеческие..."

#. ja: 雷の属性に偏った神域か……。<br>おそらくこの先に、ビエルゴが待ちかまえているだろうな。
#. de: Blitze und Donner. Dann ist Byregot nicht weit.
#. fr: Un espace imprégné de l'élément foudre... Byregot n'est sûrement pas loin.
msgctxt "InstanceContentTextData:33020:0:0"
msgid "A domain aspected to lightning... Byregot is here, I shouldn't doubt."
msgstr "Обитель, пропитанная молнией... Сомнений нет, Бьрегот здесь."

#. ja: 奥にある機械仕掛けの塔が見えるか？<br>まるで神話にある「ビエルゴの塔」のようじゃないか……！
#. de: Dieser Turm scheint direkt den Legenden entsprungen zu sein.
#. fr: Tu vois la tour mécanique, au fond<nbsp>? Elle semble tout droit sortie de la légende<nbsp>!
msgctxt "InstanceContentTextData:33021:0:0"
msgid "The mechanical spire ahead could have been plucked straight out of legend!"
msgstr "Башня с механизмами впереди словно сошла со страниц легенды!"

#. ja: 神々の一柱を倒すとは！<br>君たちに調査を依頼して、正解だったようだな……！
#. de: Ein Kampf gegen die Götter<nbsp>... Gut, dass ich das nicht alleine durchstehen muss.
#. fr: Hein<nbsp>!? Tu as vraiment réussi à battre un <i>Dieu</i><nbsp>? J'ai bien fait de m'adresser aux Élèves de Baldesion...
msgctxt "InstanceContentTextData:33022:0:0"
msgid "That you should best a divinity... I couldn't have asked for better help!"
msgstr "Вы одолели само божество... Не мог найти помощников лучше!"

#. ja: 見たこともない生物を使役していたな。<br>慎重に進んだ方がよさそうだ。
#. de: Die Götter schicken ihre Diener.
#. fr: Les Dieux peuvent donc appeler des familiers à leur guise... Nous devrons rester prudents.
msgctxt "InstanceContentTextData:33024:0:0"
msgid "So the gods have minions at their beck and call... We must proceed with care."
msgstr "Значит, боги могут призывать себе на подмогу прислужников... Надо быть осторожнее."

#. ja: 壊神ラールガーは、彗星と破壊を司る神だという。<br>心してかかれよ。
#. de: Rhalgr ist der Gott der Zerstörung. Macht euch bereit!
#. fr: Rhalgr est le Dieu de la destruction et des corps célestes. Prépare-toi.
msgctxt "InstanceContentTextData:33025:0:0"
msgid "Rhalgr isn't known as the god of destruction without reason. Steel yourself."
msgstr "Недаром Ралгр зовётся богом разрушения. Соберитесь с силами."

#. ja: 決闘のために拵えた、我が像へと至るがよい。
#. de: Mein steinernes Abbild soll Zeuge dieses Kampfes sein.
#. fr: Cette statue que vous avez bâtie en mon honneur sera témoin de notre combat.
msgctxt "InstanceContentTextData:33026:0:0"
msgid "Ahead stands a statue I have fashioned for our contest."
msgstr "Впереди статуя, которую я создал для нашей схватки."

#. ja: さあ人の子らよ、次なる神域に足を踏み入れよ……。
#. de: Seid willkommen in meiner Domäne.
#. fr: Venez, mortels... La gardienne du soleil vous attend dans son domaine...
msgctxt "InstanceContentTextData:33027:0:0"
msgid "Come, mortals. Enter my realm─if you dare."
msgstr "Вперёд, смертные. Войдите в мои владения, если осмелитесь."

#. ja: 随分と飛ばされたな……。<br>ここはまた別の……炎の属性の神域のようだ。
#. de: Eine neue Domäne. Sie ist dem Feuer gewidmet.
#. fr: Nous voilà dans une autre partie du domaine divin... Cette fois, un monde dominé par le feu.
msgctxt "InstanceContentTextData:33028:0:0"
msgid "Another domain─one aspected to fire..."
msgstr "Ещё одна обитель, на этот раз подвластная огню..."

#. ja: となると、俺たちを呼びいれたのは……。
#. de: Dann gehört diese Stimme<nbsp>...
#. fr: Alors, cette voix qui nous a appelés...
msgctxt "InstanceContentTextData:33029:0:0"
msgid "Then the voice that called out to us..."
msgstr "Значит, голос, что призвал нас..."

#. ja: また使役の生物で足止めをしてきたようだが……<br>さすがだな。
#. de: Diese Diener sind kaum eine Gefahr für dich und deine Gefährten.
#. fr: Ces créatures ne font décidément pas le poids face à toi et tes compagnons.
msgctxt "InstanceContentTextData:33030:0:0"
msgid "Mere minions are no match for you, 'twould seem."
msgstr "Похоже, одни лишь прислужники вам не соперники."

#. ja: おそらくこの先に神々が待っているぞ、気をつけろ！
#. de: Eine wahre Gottheit erwartet uns. Seien wir vorsichtig.
#. fr: Mais ton prochain adversaire sera sans doute autrement plus puissant... Tiens-toi <if $gn4>prête<else>prêt</if>.
msgctxt "InstanceContentTextData:33031:0:0"
msgid "A divinity awaits us beyond. Have care."
msgstr "Впереди нас ждёт божество. Будьте осторожны."

#. ja: 日神アーゼマを倒したことで空模様が変わった……！？<br>ここはやはり、神々の領域なんだな。
#. de: Azeyma ist bezwungen. Die untergehende Sonne ist das Zeichen.
#. fr: On dirait que les cieux ont changé après ta victoire sur Azeyma. Le domaine divin est fascinant...
msgctxt "InstanceContentTextData:33032:0:0"
msgid "Look how the sky has changed! The result of your victory over Azeyma, I daresay..."
msgstr "Смотри, как изменилось небо! Полагаю, это следствие твоей победы над Азимой..."

#. ja: 俺たち以外の人の気配はないが、<br>遠くに都のようなものが見えるな……。
#. de: Eine Stadt! Aber Bewohner sehe ich keine.
#. fr: J'aperçois une cité à l'horizon... Qu'est-ce qui nous attend là-bas<nbsp>?
msgctxt "InstanceContentTextData:33033:0:0"
msgid "There's a city up ahead... Could there be people here?"
msgstr "Впереди виднеется город... Неужели здесь кто-то живёт?"

#. ja: 汝ら、人の力を裁定いたそう。
#. de: Dies ist eine Probe eures Könnens.
#. fr: Humains... Préparez-vous à être jugés...
msgctxt "InstanceContentTextData:33034:0:0"
msgid "Prepare to be judged, children of man."
msgstr "Приготовьтесь к суду, дети человеческие."

#. ja: 灰燼に帰せ……！
#. de: Alles Leben endet in Asche!
#. fr: Brûlez, brûlez tous...<nbsp>!
msgctxt "InstanceContentTextData:33035:0:0"
msgid "Ashes you will be."
msgstr "Обратитесь в пепел!"

#. ja: 神の力を受けてみよ！
#. de: <i>Das</i> ist göttliche Kraft!
#. fr: Inclinez-vous devant le pouvoir divin<nbsp>!
msgctxt "InstanceContentTextData:33036:0:0"
msgid "Will you weather my trial?"
msgstr "Сумеете выдержать моё испытание?"

#. ja: まだまだ、こんなものではないぞ！
#. de: Dies ist erst der Anfang.
#. fr: Vous n'avez encore rien vu<nbsp>!
msgctxt "InstanceContentTextData:33037:0:0"
msgid "We have only just begun!"
msgstr "Это только начало!"

#. ja: 晦冥の炎に、絶え果てよ……。
#. de: Hoch lodern die Flammen der Dunkelheit!
#. fr: Que les flammes de l'au-delà vous consument...
msgctxt "InstanceContentTextData:33038:0:0"
msgid "The flames of the abyss consume all."
msgstr "Пламя бездны поглотит всё."

#. ja: 辛苦を味わえ……。
#. de: Diese Glut verheißt ewige Pein!
#. fr: Ressentez cette souffrance de tout votre être...
msgctxt "InstanceContentTextData:33039:0:0"
msgid "Bitterest suffering awaits."
msgstr "Вас ждут невыносимые страдания."

#. ja: いまいちど、灰燼に帰せるがいい……。
#. de: Zurück zur Asche, der ihr einst entstiegt!
#. fr: Soyez calcinés à tout jamais...
msgctxt "InstanceContentTextData:33040:0:0"
msgid "From ashes you came, to ashes you will return."
msgstr "Из пепла вы пришли, в пепел и вернётесь."

#. ja: 私たちの神威を凌ぐとはな！
#. de: Jetzt kennt ihr unsere göttliche Macht.
#. fr: Des humains qui rivalisent avec le pouvoir divin<nbsp>!?
msgctxt "InstanceContentTextData:33041:0:0"
msgid "Still you defy our divine authority."
msgstr "И всё же вы бросаете вызов нашей божественной власти."

#. ja: なればこれより、次なる裁定に移行する！
#. de: Doch der Gott des Handels ist noch nicht mit euch fertig.
#. fr: Mais n'allez pas croire que nous sommes quittes...
msgctxt "InstanceContentTextData:33042:0:0"
msgid "Very well. Let us proceed to your judgment."
msgstr "Что ж. Перейдём к вашему суду."

#. ja: 商神が、汝らの魂を清算しようぞ！
#. de: Stellen wir nun eure Seelen auf die Probe!
#. fr: L'heure est venue de peser la valeur de vos âmes<nbsp>!
msgctxt "InstanceContentTextData:33043:0:0"
msgid "We, the Traders, shall weigh your souls!"
msgstr "Мы, боги торговли, взвесим ваши души!"

#. ja: 天秤の均衡を保ってみせよ……。
#. de: Die Waage muss ins Gleichgewicht.
#. fr: La balance doit être équilibrée...
msgctxt "InstanceContentTextData:33044:0:0"
msgid "Preserve the balance if you can."
msgstr "Попробуйте удержать равновесие весов."

#. ja: 魂の清算完了まで あと 5 秒
#. de: 5 Sekunden bis zum Urteil<nbsp>...
#. fr: Jugement dans 5 secondes...
msgctxt "InstanceContentTextData:33045:0:0"
msgid "5 seconds to Balance."
msgstr "До равновесия осталось 5 секунд."

#. ja: 魂の清算完了まで あと 4 秒
#. de: 4 Sekunden bis zum Urteil<nbsp>...
#. fr: Jugement dans 4 secondes...
msgctxt "InstanceContentTextData:33046:0:0"
msgid "4 seconds to Balance."
msgstr "До равновесия осталось 4 секунды."

#. ja: 魂の清算完了まで あと 3 秒
#. de: 3 Sekunden<nbsp>...
#. fr: Jugement dans 3 secondes...
msgctxt "InstanceContentTextData:33047:0:0"
msgid "3 seconds..."
msgstr "3 секунды..."

#. ja: 魂の清算完了まで あと 2 秒
#. de: 2 Sekunden<nbsp>...
#. fr: Jugement dans 2 secondes...
msgctxt "InstanceContentTextData:33048:0:0"
msgid "2 seconds..."
msgstr "2 секунды..."

#. ja: 魂の清算完了まで あと 1 秒
#. de: 1 Sekunde<nbsp>...
#. fr: Jugement dans 1 seconde...
msgctxt "InstanceContentTextData:33049:0:0"
msgid "1 second..."
msgstr "1 секунда..."

#. ja: もう一度だ……。<br>汝らの魂を尽く清算し、幕切れとしてやろう……。
#. de: Noch einmal ...<br>Wir werden die Seelen nur ein weiteres Mal begutachten!
#. fr: Une fois de plus, nous allons juger vos âmes...
msgctxt "InstanceContentTextData:33050:0:0"
msgid "Once more─and once more only─we shall weigh your souls."
msgstr "Ещё раз... И только раз... Мы вновь взвесим ваши души."

#. ja: さあ、天秤の均衡を保ってみせよ……！
#. de: Die Waage muss ins Gleichgewicht!
#. fr: La balance des comptes doit être équilibrée...
msgctxt "InstanceContentTextData:33051:0:0"
msgid "Preserve the balance."
msgstr "Сумеете удержать равновесие весов?"

#. ja: 時は満ちた……魂の裁定を執り行う。
#. de: Die Zeit ist abgelaufen. Höret unser Urteil.
#. fr: L'heure du verdict est arrivée...
msgctxt "InstanceContentTextData:33052:0:0"
msgid "The moment of judgment is come."
msgstr "Время пришло... Пора судить ваши души."

#. ja: 人はまだ至らなかったか……。
#. de: Ihr seid noch nicht reif.
#. fr: L'humanité n'est pas prête...
msgctxt "InstanceContentTextData:33053:0:0"
msgid "You have been found wanting."
msgstr "Вы оказались недостойны."

#. ja: 生と死の狭間で彷徨い続けるがいい……。
#. de: Irrt weiter durch die Leere zwischen Leben und Tod!
#. fr: Continuez à vous égarer entre la vie et la mort...
msgctxt "InstanceContentTextData:33054:0:0"
msgid "You shall wander in purgatory for eternity."
msgstr "Вечно блуждайте меж жизнью и смертью."

#. ja: ほう……魂の裁定を越えてみせたか！
#. de: Eure Seelen haben sich als würdig erwiesen.
#. fr: Vos âmes se sont montrées dignes<nbsp>!
msgctxt "InstanceContentTextData:33055:0:0"
msgid "You have passed our judgment..."
msgstr "Вы выдержали наш суд..."

#. ja: 見事だったぞ！　汝らに祝福を与えよう！
#. de: Ihr habt eine Heldentat vollbracht! Geht mit unserem Segen!
#. fr: Splendide<nbsp>! Vous méritez notre bénédiction<nbsp>!
msgctxt "InstanceContentTextData:33056:0:0"
msgid "Well done! You are deserving of reward!"
msgstr "Прекрасно! Вы достойны награды!"

#. ja: 人の粘り強さには、まこと感心するな！
#. de: So gut wird man selten unterhalten.
#. fr: Mortels, votre persévérance est admirable<nbsp>!
msgctxt "InstanceContentTextData:33057:0:0"
msgid "Man's tenacity is a sight to behold!"
msgstr "Непоколебимость людей не перестаёт поражать!"

#. ja: 敬意を表し、我らも全力で戦おう……！
#. de: Zeigen wir etwas Respekt, indem wir mit aller Macht kämpfen.
#. fr: Vous méritez de connaître toute notre puissance...
msgctxt "InstanceContentTextData:33058:0:0"
msgid "As a show of esteem, we shall bring our all to bear."
msgstr "Из уважения к вам мы тоже будем сражаться в полную силу."

#. ja: フハハ！　猛るのう！！
#. de: Hahahaaa! <i>Das</i> ist das Leben!
#. fr: Ha ha ha<nbsp>! La vie est plus forte que tout<nbsp>!
msgctxt "InstanceContentTextData:33059:0:0"
msgid "Hahaha! Such vim and vigor!"
msgstr "Ха-ха-ха! Вот это пыл!"

#. ja: これが人の、生の躍動か……！
#. de: Es steckt viel Leben in euch.
#. fr: Les humains ont tant de talents cachés...
msgctxt "InstanceContentTextData:33060:0:0"
msgid "So this is the spirit of man..."
msgstr "Так вот какова жизненная сила людей..."

#. ja: 分かたれし我らの神威を見せてやろう……。
#. de: Erfahrt zuerst unsere göttliche Stärke!
#. fr: Nous allons vous montrer la véritable puissance divine...
msgctxt "InstanceContentTextData:33061:0:0"
msgid "You shall bear witness to our might..."
msgstr "Станьте свидетелями нашей мощи..."

#. ja: 我らの妙技、人に見極められるか！？
#. de: Seid ihr imstande, ihr zu trotzen?
#. fr: Des mortels, capables de nous résister...<nbsp>!?
msgctxt "InstanceContentTextData:33062:0:0"
msgid "But will you be able to comprehend it?"
msgstr "Но сумеете ли вы её постичь?"

#. ja: 人がこの地に足を踏み入れる日が来ようとは……。<br>いざ尋常に、勝負！
#. de: Ihr habt unsere Domäne betreten. Aber werdet ihr sie auch wieder verlassen?
#. fr: Des mortels, dans le domaine divin...<br>Approchez, et prouvez que vous êtes dignes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:33063:0:0"
msgid "That mortals should set foot in our divine realm...<br>Come, we shall see whether you are fit to remain!"
msgstr "Смертные ступили в божественные владения...<br>Ну же, покажите, достойны ли вы здесь остаться!"

#. ja: 工神にまみえる覚悟はできておろうな？
#. de: Seid ihr bereit, euch dem Erbauer zu stellen?
#. fr: Préparez-vous à affronter Byregot, l'Artisan<nbsp>!
msgctxt "InstanceContentTextData:33064:0:0"
msgid "So, you are resolved to face me."
msgstr "Итак, ты решился встретиться со мной."

#. ja: この力で、世界を我が手に！
#. de: Ich gebiete über die Schöpfung und die Elemente!
#. fr: Il n'est rien que je ne puisse façonner<nbsp>!
msgctxt "InstanceContentTextData:33065:0:0"
msgid "By my power shall a new world be forged."
msgstr "Моей силой будет создан новый мир."

#. ja: さあ人の子らよ、かかってくるがよい！
#. de: Zeigt mir, wozu ihr fähig seid.
#. fr: Approchez, mortels, je vous attends<nbsp>!
msgctxt "InstanceContentTextData:33066:0:0"
msgid "Come, children of man!"
msgstr "Ну же, дети человеческие!"

#. ja: 疾く散れ！
#. de: Auseinander!
#. fr: Je vais vous réduire en poussière<nbsp>!
msgctxt "InstanceContentTextData:33067:0:0"
msgid "Scatter!"
msgstr "Рассыпьтесь!"

#. ja: 神威に慄け……！
#. de: Verbeugt euch vor dem Willen der Götter!
#. fr: Tremblez devant la puissance divine<nbsp>!
msgctxt "InstanceContentTextData:33068:0:0"
msgid "Tremble before my divinity!"
msgstr "Трепещите перед моей божественной мощью!"

#. ja: 工神のなせる業、刮目して見よ！
#. de: Versteht ihr nun, warum sie mich als den Erbauer preisen?
#. fr: Ouvrez grand vos yeux, et admirez<nbsp>!
msgctxt "InstanceContentTextData:33069:0:0"
msgid "Behold the virtuosity of the Builder!"
msgstr "Узрите мастерство Созидателя!"

#. ja: 神の意匠に見惚れるがいい！
#. de: Mein Wille formt diese Welt!
#. fr: Voici la splendeur de l'artisanat divin<nbsp>!
msgctxt "InstanceContentTextData:33070:0:0"
msgid "Behold the works of a god!"
msgstr "Узрите творения бога!"

#. ja: いでよ！我が神槌！
#. de: Zu mir, Weltenhammer!
#. fr: À moi, fidèles marteaux<nbsp>!
msgctxt "InstanceContentTextData:33071:0:0"
msgid "To me, O hammer divine!"
msgstr "Ко мне, о божественный молот!"

#. ja: 雷の輝きよ、焼き尽くせ……！
#. de: Soll der Donner zerreißen, was ich schuf!
#. fr: Soyez réduits en cendres par la foudre suprême<nbsp>!
msgctxt "InstanceContentTextData:33072:0:0"
msgid "Searing light, smite my foes!"
msgstr "Жгучий свет, порази моих врагов!"

#. ja: 集え、雷の力！
#. de: Gewaltiges Gewitter, beuge dich meinem Befehl!
#. fr: Par la toute-puissance de la foudre<nbsp>!
msgctxt "InstanceContentTextData:33073:0:0"
msgid "The thunder is mine to command!"
msgstr "Гром и молния подвластны мне!"

#. ja: 我々を止めたくば、先に進め……。
#. de: Geht. Die anderen erwarten euch bereits.
#. fr: Continuez, si vous pensez pouvoir nous arrêter...
msgctxt "InstanceContentTextData:33074:0:0"
msgid "If you would halt our ascension, then press on..."
msgstr "Если хотите нас остановить, ступайте дальше..."

#. ja: 神の力を披露しよう……！
#. de: Lernt die Macht der Götter kennen!
#. fr: Ma force dépasse votre imagination<nbsp>!
msgctxt "InstanceContentTextData:33075:0:0"
msgid "Witness the glory of the divine!"
msgstr "Узрите славу божественной силы!"

#. ja: ひれ伏すがいい！
#. de: In den Staub mit euch!
#. fr: Prosternez-vous devant vos Dieux<nbsp>!
msgctxt "InstanceContentTextData:33076:0:0"
msgid "Bend the knee!"
msgstr "На колени!"

#. ja: 許しを乞うても、もう遅いぞ……！
#. de: Für Reue ist es jetzt zu spät!
#. fr: Il est trop tard pour implorer notre pardon<nbsp>!
msgctxt "InstanceContentTextData:33077:0:0"
msgid "'Tis too late to beg mercy!"
msgstr "Поздно молить о пощаде!"

#. ja: いざ、日神と焦がれあおうぞ！
#. de: Die Sonnengöttin erwartet euch mit sengender Sehnsucht!
#. fr: Je brûlais d'impatience de vous affronter<nbsp>!
msgctxt "InstanceContentTextData:33078:0:0"
msgid "You will be scoured by the light of the Sun!"
msgstr "Свет солнца выжжет вас дотла!"

#. ja: 紅炎纏いし我が焔扇……
#. de: Rotes Feuer nährt meinen flammenden Fächer<nbsp>...
#. fr: Mon éventail brille de mille feux...
msgctxt "InstanceContentTextData:33079:0:0"
msgid "O crimson fan, in fire woven..."
msgstr "О алый веер, сотканный из огня..."

#. ja: ひとたび振れば、焦土と化す！
#. de: Und verbrannte Erde glimmt, wo ich ihn schwinge!
#. fr: Que son souffle consume la terre<nbsp>!
msgctxt "InstanceContentTextData:33080:0:0"
msgid "In your wake leave naught uncleansed!"
msgstr "Оставь за собой лишь выжженную землю!"

#. ja: 陽炎たちよ、人の子らを惑わせよ！
#. de: Kommt, meine Kinder, und umtanzt die Gäste!
#. fr: Essayez donc de voir à travers mes mirages...
msgctxt "InstanceContentTextData:33081:0:0"
msgid "Is it just a mirage...or something more?"
msgstr "Всего лишь мираж... или нечто большее?"

#. ja: ハハハ！　滾ってきたよのう！
#. de: Ahaha! Hier, das ist für den nächsten Tanz!
#. fr: Ha ha ha<nbsp>! Je sens la chaleur monter<nbsp>!
msgctxt "InstanceContentTextData:33082:0:0"
msgid "Hahaha! I've quite warmed to you!"
msgstr "Ха-ха-ха! Вы мне всё больше нравитесь!"

#. ja: 我が舞いとともに、爆ぜよ焔扇！
#. de: Flammenfächer, mach dich bereit für das Finale!
#. fr: Joignez-moi dans une danse enflammée<nbsp>!
msgctxt "InstanceContentTextData:33083:0:0"
msgid "An explosive finish!"
msgstr "А теперь — огненная феерия!"

#. ja: 神火よ熾りたまえ！
#. de: Götterfeuer, stille deinen Hunger!
#. fr: Brûle, feu divin, brûle<nbsp>!
msgctxt "InstanceContentTextData:33084:0:0"
msgid "Let there be fire!"
msgstr "Да разгорится божественный огонь!"

#. ja: 風よ舞え、炎よ踊れ！
#. de: Wind, wehe, und entfache einen lichterlohen Tanz!
#. fr: Le souffle du vent fait danser les flammes<nbsp>!
msgctxt "InstanceContentTextData:33085:0:0"
msgid "Raging flames, dance upon the wind!"
msgstr "Бурные языки пламени, пляшите на ветру!"

#. ja: 逃げ惑え……烈火一閃！
#. de: Nimm freien Lauf, und lodere! Brenne lichterloh!
#. fr: Laissez-vous emporter par le feu frénétique<nbsp>!
msgctxt "InstanceContentTextData:33086:0:0"
msgid "None can escape the inferno!"
msgstr "Никому не спастись от этого пекла!"

#. ja: 我が日輪にその身を焦がせ……！
#. de: Meine flammende Aura soll euch verzehren!
#. fr: La plus brûlante des étreintes se referme sur vous...
msgctxt "InstanceContentTextData:33087:0:0"
msgid "This will burn!"
msgstr "Сейчас будет жарко!"

#. ja: 愛しき子らよ、受け取るがよい！
#. de: Spürt meine sengende Liebe!
#. fr: Ressentez la chaleur de mon amour<nbsp>!
msgctxt "InstanceContentTextData:33088:0:0"
msgid "A gift of flame for our children!"
msgstr "Подарок из огня для моих детей!"

#. ja: ああ、焦がれる……！
#. de: Ach, was habe ich euch begehrt ...
#. fr: Vous embrasez mon cœur...
msgctxt "InstanceContentTextData:33089:0:0"
msgid "Ever shall the fires burn..."
msgstr "Пламя будет гореть вечно..."

#. ja: この城の者どもも、今や私のしもべと化した……。<key>さぁ、餌の時間だ…！
#. de: Nun gehorchen sie mir alle aufsss Wort ...<key>Zeit für die erssste Mahlzeit!
#. fr: J'ai de nouveaux amis à vous présenter<nbsp>: les créatures de ce château, hahaha<nbsp>!<key>C'est l'heure de vous régaler, mes mignons<nbsp>!
#. macro: <key> — a key prompt; its runtime meaning is not established (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:33100:0:0"
msgid "Every soul in this domain ssserves me now.<key>Come, feassst upon their flesh!"
msgstr "Все души в этих владениях мне служат.<key>Ну же, пируйте их плотью!"

#. ja: 城内の妖異が集まってきているわ。<key>戦闘が長引くとまずそうね……。
#. de: Die Nichts<shy>gesand<shy>ten sammeln sich ...<key>Wir sollten es schnellstens zu Ende bringen.
#. fr: Les créatures du néant sont de plus en plus nombreuses...<key>Faisons en sorte que ce combat ne s'éternise pas<nbsp>!
#. macro: <key> — a key prompt; its runtime meaning is not established (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:33102:0:0"
msgid "The castle answers his call...<key>We'd do well to break up this feast quickly."
msgstr "Замок откликается на его зов...<key>Надо поскорее прервать этот пир."

#. ja: どれだけ集まろうが、蹴散らすだけだ。
#. de: Lass die Brut nur kommen!
#. fr: Quel que soit votre nombre, vous allez tous périr<nbsp>!
msgctxt "InstanceContentTextData:33104:0:0"
msgid "Then let's see these guests on their way."
msgstr "Пусть хоть целая толпа соберётся — перебьём всех."

#. ja: 土のスカルミリョーネの神髄、見せてやろう……！
#. de: Nun lernt ihr unser wahres Wesen kennen!
#. fr: Admirez la véritable puissance de Scarmiglione, maître de la terre<nbsp>!
msgctxt "InstanceContentTextData:33105:0:0"
msgid "Behold the power of the archfiend of earth!"
msgstr "Узрите истинную мощь архидемона земли!"

#. ja: 妖異の再生能力を、加速させているの？
#. de: Sie regenerieren sich viel schneller als vorher!
#. fr: Elles ont ressuscité à une vitesse folle<nbsp>!
msgctxt "InstanceContentTextData:33106:0:0"
msgid "He hastens their regeneration!"
msgstr "Он ускоряет их регенерацию!"

#. ja: 我らに死は訪れぬ……。<key>ゆえに、貴様らに勝ち目はない！
#. de: Unsss zu töten ist unmöglich!<key>Versucht es nur und seht, wie ihr scheitert!
#. fr: Nous sommes immortels, haha<nbsp>!<key>Pourquoi vous abandonnez pas<nbsp>? Vous avez déjà perdu<nbsp>!
#. macro: <key> — a key prompt; its runtime meaning is not established (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:33107:0:0"
msgid "We are deathlessssss.<key>You cannot defeat that which cannot die!"
msgstr "Мы бессмертныыыы.<key>Не одолеть того, кто не может умереть!"

#. ja: いくら屠ろうが無駄なことよ！
#. de: So viele ihr auch schlachtet, sie kehren immer wieder!
#. fr: Eh, vous comprenez pas que ça sert à rien<nbsp>?
msgctxt "InstanceContentTextData:33109:0:0"
msgid "Struggle and slaughter all you like!"
msgstr "Бейте сколько угодно — всё без толку!"

#. ja: この状況……奴に分がありすぎる……。
#. de: Noch stehe ich ...!
#. fr: Zut... Il a toujours un coup d'avance<nbsp>!
msgctxt "InstanceContentTextData:33110:0:0"
msgid "Our foe has too great an advantage..."
msgstr "У противника слишком большое преимущество..."

#. ja: どうにかして、奴を引きずりだしたいが……。
#. de: Pah, versteckt sich wie ein Feigling.
#. fr: Combien de temps encore va-t-il rester en retrait, celui-là<nbsp>?
msgctxt "InstanceContentTextData:33111:0:0"
msgid "We need to drag him out of this damnable feast."
msgstr "Надо вытащить его из этой проклятой пирушки."

#. ja: 埒があかないわ……。<key>一度退いて、策を練った方がよさそうね。
#. de: So kommen wir nicht voran.<key>Ziehen wir uns zurück und überdenken unsere Strategie.
#. fr: Ça n'en finira jamais...<key>On ferait peut-être mieux de se replier pour trouver une solution...
#. macro: <key> — a key prompt; its runtime meaning is not established (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:33112:0:0"
msgid "There's no end in sight...<key>A retreat may be in order."
msgstr "Так мы ничего не добьёмся...<key>Пожалуй, стоит отступить и придумать план."

#. ja: 一方的に押しつけられた名でも、借りは借りだ。<key>この戦いに加勢することで、チャラにしてもらうぞ。
#. de: Der Grund für meine Schuld tut nichts zur Sache.<key>Doch mit diesem Kampf ist sie beglichen.
#. fr: Je ne vous ai jamais demandé de me baptiser, mais... une dette est une dette.<key>Et je rembourse toujours les miennes.
#. macro: <key> — a key prompt; its runtime meaning is not established (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:33114:0:0"
msgid "However incurred, a debt is a debt.<key>I will repay it here and now."
msgstr "Неважно, как возник долг, долг есть долг.<key>Я расплачусь с ним здесь и сейчас."

#. ja: 彼女の力は、いったい……。
#. de: Woher nimmt sie diese Kraft?
#. fr: Quel est donc ce pouvoir...<nbsp>?
msgctxt "InstanceContentTextData:33116:0:0"
msgid "What is this power?"
msgstr "Что это за сила?"

#. ja: 土のスカルミリョーネの強さ、ゆっくり味わいながら死ねえ！
#. de: Ich werde euch genüssslich ausbluten lassen!
#. fr: Scarmiglione, maître de la terre, va bientôt se gorger de votre éther<nbsp>!
msgctxt "InstanceContentTextData:33117:0:0"
msgid "You will tremble before my true ssstrength!"
msgstr "Ты познаешь всю мощь моей истинной силы!"

#. ja: 四天王の恐ろしさを見せてやろう……！
#. de: Ssseht die grausame Macht der Elementarfürsssten!
#. fr: Tremblez devant le seigneur Golbez et ses quatre généraux<nbsp>!
msgctxt "InstanceContentTextData:33118:0:0"
msgid "Know your end is nigh!"
msgstr "Знайте: смерть уже близко!"

#. ja: まずは雑魚から片付けるべき、か。
#. de: Na schön, kümmern wir uns zuerst um das Gesindel.
#. fr: Tu veux qu'on s'occupe d'abord de tes larbins<nbsp>? Pas de problème.
msgctxt "InstanceContentTextData:33119:0:0"
msgid "Attend to the minions first."
msgstr "Сначала разберись с приспешниками."

#. ja: 向こうも本気というわけか……！<key>ならば、こっちも全力でいくぞ！
#. de: Macht er also endlich ernst, ja?<key>Also dann, gehen wir in die Vollen!
#. fr: On dirait qu'il passe aux choses sérieuses<nbsp>!<key>Qu'à cela ne tienne, on va lui montrer ce qu'on a dans le ventre<nbsp>!
#. macro: <key> — a key prompt; its runtime meaning is not established (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:33120:0:0"
msgid "Finally getting serious, are we?<key>Very well, let us return the favor!"
msgstr "Наконец-то взялся всерьёз? <key>Что ж, отвечу тем же!"

#. ja: 小賢しい真似を……これならどうだ！？
#. de: Wie gefällt euch dasss?
#. fr: Vous vous croyez malins, hein<nbsp>? Et qu'est-ce que vous dites de ça<nbsp>?
msgctxt "InstanceContentTextData:33122:0:0"
msgid "Trickery will not save you!"
msgstr "Твои уловки тебя не спасут!"

#. ja: おのれぇ……忌々しい力よ！
#. de: Aah! Nun kannssst du uns nicht mehr schaden!
#. fr: Cette énergie... C'est prodigieux<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:33123:0:0"
msgid "Enough! <i>Enough</i>!"
msgstr "Хватит! <i>Хватит</i>!"

#. ja: 彼女の力がなければ奴は倒せない。<br>助けるぞ！
#. de: Ohne Zero können wir ihn nicht bezwingen!
#. fr: Si on ne la sauve pas tout de suite, on est tous fichus<nbsp>!
msgctxt "InstanceContentTextData:33124:0:0"
msgid "We cannot win without Zero. We must help her!"
msgstr "Без Зеро нам его не одолеть. Надо ей помочь!"

#. ja: ええい、やはり彼奴らから始末するしかないようだな……。<key>我が力で、貴様らを葬ってやる！
#. de: Scheinbar muss ich das Ungeziefer zuerssst beseitigen ...
#. fr: Quoi<nbsp>!? Très bien, je vais m'occuper des misérables intrus en premier...<key>Je vais tous vous enterrer, vous m'entendez<nbsp>!? Tous<nbsp>!!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <key> — a key prompt; its runtime meaning is not established (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:33125:0:0"
msgid "Hmph. If I must deal with <i>you</i> first...<key>I'll kill you all myself!"
msgstr "Хм. Раз уж сначала нужно разобраться с <i>тобой</i>...<key>Я сам вас всех прикончу!"

#. ja: 役に立たぬ雑魚どもめッ！
#. de: Nichtssssnutzige Brut!
#. fr: Vous me décevez beaucoup, mes mignons<nbsp>!
msgctxt "InstanceContentTextData:33126:0:0"
msgid "Pathetic! Useless!"
msgstr "Ничтожества! Бесполезные твари!"

#. ja: 我が力で、貴様らを葬ってやる！
#. de: Verrottet unter der Erde!
#. fr: Je vais tous vous enterrer, vous m'entendez<nbsp>!? Tous<nbsp>!!
msgctxt "InstanceContentTextData:33127:0:0"
msgid "I'll kill you all myself!"
msgstr "Я сам вас всех прикончу!"

#. ja: 生きては帰さん……<br>ここで全員、朽ち果てよ！
#. de: Wenn diesss unser Ende ist ... dann ist es auch euresss!
#. fr: Vous ne reverrez jamais votre monde... car vous êtes déjà dans votre tombe<nbsp>!
msgctxt "InstanceContentTextData:33128:0:0"
msgid "This place will be your grave!"
msgstr "Здесь вы и сгинете!"

#. ja: 凄まじい魔力……<br>これで勝負を決める気よ！
#. de: Diese unglaubliche Macht ... Ich fürchte, er geht aufs Ganze!
#. fr: Quelle énergie... Il cherche à nous achever avec un sort surpuissant<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:33129:0:0"
msgid "This magick... We must stop him <i>now</i>!"
msgstr "Эту магию... Нужно остановить его <i>сейчас же</i>!"

#. ja: すべての敵を倒せ
#. de: Alle Gegner besiegen
#. fr: Vaincre tous les ennemis
msgctxt "InstanceContentTextData:33130:0:0"
msgid "Defeat all enemies."
msgstr "Одолейте всех врагов."

#. ja: スカルミリョーネを倒せ！
#. de: Besiege Scarmiglione!
#. fr: Vainquez Scarmiglione<nbsp>!
msgctxt "InstanceContentTextData:33131:0:0"
msgid "Defeat Scarmiglione!"
msgstr "Одолейте Скармильоне!"

#. ja: 妖異を結晶化するなんて……
#. de: Sie sind zu Kristall erstarrt?
#. fr: Incroyable... Les monstres se sont transformés en cristaux...
msgctxt "InstanceContentTextData:33132:0:0"
msgid "She can turn voidsent into crystal..."
msgstr "Она превращает пустотников в кристалл..."

#. ja: 蛮神どもを食らい、究極へと至った力……<br>貴様では及びもしまい！
#. de: Die Kraft aller Primae, die sie sich einverleibt hat, diese ultimative Macht lässt alles andere verblassen!
#. fr: L'Ultima Arma utilise le pouvoir des Primordiaux ! Personne ne peut lui résister !
msgctxt "InstanceContentTextData:33200:0:0"
msgid "The Ultima Weapon has partaken of the power of eikons! None can stand against it!"
msgstr "Оружие «Ultima» вобрало силу эйконов! Теперь ему никто не противостоит!"

#. ja: ガルーダの「エリアルブラスト」で消し飛ぶがいい！
#. de: Wind habt ihr gesät und Sturm sollt ihr ernten!
#. fr: Pliez sous la rafale aérienne de Garuda<nbsp>!
msgctxt "InstanceContentTextData:33201:0:0"
msgid "Yield to the storm!"
msgstr "Сгиньте в буре!"

#. ja: 嵐を統べる蛮神の力、利用させてもらうぞ……！
#. de: Spürt die vernichtende Macht Garudas aus meiner Hand!
#. fr: À moi, le pouvoir de la Souffleuse de rafales<nbsp>!
msgctxt "InstanceContentTextData:33202:0:0"
msgid "The wind is at my beck and call!"
msgstr "Ветер повинуется мне!"

#. ja: いかなる攻撃をも寄せ付けぬ……！<br>これぞ、究極幻想の名に相応しい力だ……！
#. de: Nichts vermag sich gegen die Wucht dieser Wogen zu stemmen!
#. fr: Plus aucune attaque ne peut m'atteindre<nbsp>! La fantaisie des anciens est toute-puissante<nbsp>!
msgctxt "InstanceContentTextData:33203:0:0"
msgid "Naught can pierce the raging tempest!"
msgstr "Ничто не устоит перед бушующей бурей!"

#. ja: 機械仕掛けの神を退けたくば、願うのです……。<br>闇を打ち砕く、光の力を……！
#. de: Nicht die stählerne Hülle ist dein Feind<nbsp>- es ist die Dunkelheit, die darin lauert! Willst du triumphieren, so richte deinen Blick zum Licht!
#. fr: Pour vaincre ce colosse de métal, tu dois invoquer le pouvoir de la Lumière... Lui seul peut défaire les Ténèbres...
msgctxt "InstanceContentTextData:33204:0:0"
msgid "Thy foe is Darkness clad in steel. If thou wouldst triumph, thou must look to the Light."
msgstr "Твой враг — тьма, облачённая в сталь. Хочешь победить — обратись к свету."

#. ja: バカなッ！？<br>外部から蛮神「タイタン」を引き剥がしたというのか！
#. de: Titans Macht ist<nbsp>... verschwunden?! Das glaube ich nicht!
#. fr: Impossible...<nbsp>! Le pouvoir de Titan, arraché à l'Ultima Arma<nbsp>!?
msgctxt "InstanceContentTextData:33205:0:0"
msgid "Titan's essence...torn from the Ultima Weapon!?"
msgstr "Сущность Титана... вырвана из оружия «Ultima»!?"

#. ja: だが、吸収した蛮神はこれだけではない……！
#. de: Grr! Sei es drum! Mit der Macht der übrigen Primae kann die Ultima-Waffe dich <i>zehn</i> Mal in Stücke reißen!
#. fr: Peu importe<nbsp>! Il lui reste d'autres Primordiaux en réserve<nbsp>!
msgctxt "InstanceContentTextData:33206:0:0"
msgid "No matter─it still harbors the might of other eikons!"
msgstr "Неважно! В нём ещё скрыта сила других эйконов!"

#. ja: タイタンの「大地の怒り」で平伏すがいい！
#. de: Kriecht in den Staub vor der Erde Zorn!
#. fr: Prosternez-vous face à la toute puissance de Titan<nbsp>!
msgctxt "InstanceContentTextData:33207:0:0"
msgid "Kneel to the might below!"
msgstr "Преклонитесь перед мощью земных недр!"

#. ja: 岩神と呼ばれし堅牢なる力……思い知れッ！
#. de: Die Substanz des Planeten selbst steht unter meiner Kontrolle!
#. fr: Admire l'implacable pouvoir de l'Ébranleur des terres<nbsp>!
msgctxt "InstanceContentTextData:33208:0:0"
msgid "The land itself is mine to wield!"
msgstr "Сама земля в моей власти!"

#. ja: そのまま押しつぶしてくれる！
#. de: Ich werde dich zwischen Fels und Stein zerquetschen!
#. fr: Tu vas finir <if $gn4>concassée<else>concassé</if><nbsp>!
msgctxt "InstanceContentTextData:33209:0:0"
msgid "Be entombed in earth!"
msgstr "Погребу тебя под землёй!"

#. ja: さあ、光のクリスタルを持つ者よ……！<br>いまふたたび、闇を打ち砕くのだと、願うのです！
#. de: Die Kraft des Lichts wohnt dir inne. Nutze sie! Verbanne das Dunkel!
#. fr: À toi de jouer, <if $gn4>porteuse<else>porteur</if> du cristal de la Lumière... Prie à nouveau pour que se dispersent les Ténèbres<nbsp>!
msgctxt "InstanceContentTextData:33210:0:0"
msgid "Once more, crystal bearer. Look to the Light to vanquish the Darkness."
msgstr "Носитель кристалла, обратись к свету и вновь уничтожь тьму."

#. ja: ええいッ！<br>蛮神「ガルーダ」まで！
#. de: Nun auch noch Garuda?! Das ist nicht möglich!
#. fr: Qu'est-ce que...<nbsp>! Garuda aussi<nbsp>!?
msgctxt "InstanceContentTextData:33211:0:0"
msgid "Garuda's as well!? Impossible!"
msgstr "И сила Гаруды тоже!? Невозможно!"

#. ja: ならば、次なる蛮神の力を使うまでだ！
#. de: Doch mit der Kraft des letzten Primae wird die Ultima-Waffe dich vernichten!
#. fr: Ce n'est pas terminé<nbsp>! Un Primordial chasse l'autre<nbsp>!
msgctxt "InstanceContentTextData:33212:0:0"
msgid "But the Ultima Weapon is not spent of eikon power yet!"
msgstr "Но в оружии «Ultima» ещё осталась сила эйконов!"

#. ja: イフリートの「地獄の火炎」で灰と化すがいい！
#. de: Ausbrennen werde ich euch, Geschwüre dieser Welt!
#. fr: Périssez dans les flammes d'Ifrit<nbsp>!
msgctxt "InstanceContentTextData:33213:0:0"
msgid "Succumb to the flames!"
msgstr "Сгиньте в пламени!"

#. ja: これが神狩りを成してきた、<br>エオルゼアの英雄の力だというのか……。
#. de: Dies ist also die Kraft <if $gn4>der Primae-Schlächterin<else>des Primae-Schlächters</if> von Eorzea<nbsp>...
#. fr: Voilà donc le pouvoir de <if $gn4>celle<else>celui</if> qui défie les divinités... <if $gn4>L'héroïne<else>Le héros</if> d'Éorzéa...
msgctxt "InstanceContentTextData:33214:0:0"
msgid "So this is the strength of the eikon-slayer..."
msgstr "Так вот какова сила убийцы эйконов..."

#. ja: しかし、ここで退くわけには……<br>リミッターを解放し、さらに出力を底上げするッ！
#. de: Wie du dich wohl schlägst, wenn die Waffe ihre ganze Energie entfesselt? Finden wir es heraus!
#. fr: Ça ne suffira pas cependant... Désactivation des limiteurs<nbsp>! Puissance maximale enclenchée<nbsp>!
msgctxt "InstanceContentTextData:33215:0:0"
msgid "Very well, let us see how you fare when the Ultima Weapon's power inhibitor is disengaged!"
msgstr "Что ж, посмотрим, как ты справишься, когда я сниму ограничитель мощности оружия «Ultima»!"

#. ja: アルテマウェポンよ、すべてを焼き尽くすのだ！
#. de: Zu nichts als schwelender Asche sollst du verbrennen!
#. fr: L'Ultima Arma va tout réduire en cendres<nbsp>!
msgctxt "InstanceContentTextData:33216:0:0"
msgid "Naught will remain of you but ash!"
msgstr "Не оставлю от вас и пепла!"

#. ja: 光の意思を持つ者よ、闇に屈してはなりません！<br>クリスタルに強く願うのです……！
#. de: Krieger<if $gn4>in</if>! Geh nicht vor der Dunkelheit in die Knie! Dein Glaube an den Kristall ebnet dir den Weg zum Sieg!
#. fr: Enfant de la Lumière, ne succombe pas aux Ténèbres... Prie le cristal de toutes tes forces<nbsp>!
msgctxt "InstanceContentTextData:33217:0:0"
msgid "Yield not to the Darkness, my child. Pray to the Crystal with all thy being."
msgstr "Не поддавайся тьме, дитя моё. Молись кристаллу всем сердцем."

#. ja: ……何なのだ、その力は！？<br>蛮神「イフリート」までも引き剥がしただと！？
#. de: Wie ... Wie kann das sein?
#. fr: La plai<shy>san<shy>te<shy>rie a assez duré<nbsp>!
msgctxt "InstanceContentTextData:33218:0:0"
msgid "No! How...how are you doing this!?"
msgstr "Нет! Как... как тебе это удаётся!?"

#. ja: いくぞ、冒険者！<br>貴様と我……これで最後の戦いだ！
#. de: Lass uns beginnen<nbsp>... Die allerletzte Schlacht!
#. fr: Réglons ça une fois pour toutes, aventuri<if $gn4>ère<else>er</if> ! C'est l'ultime bataille<nbsp>!
msgctxt "InstanceContentTextData:33219:0:0"
msgid "We settle this once and for all!"
msgstr "Покончим с этим раз и навсегда!"

#. ja: アルテマウェポンの威力を見よッ！<br>蛮神の力などなくとも、覇道は我にあり！
#. de: Staunt über die grenzenlose Kraft, die euch vernichtet!
#. fr: Je n'ai pas besoin du pouvoir des Primordiaux pour vaincre<nbsp>! Voyez la véritable puissance de l'Ultima Arma<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:33220:0:0"
msgid "I need not the power of eikons to defeat you! Gaze upon <i>true</i> power!"
msgstr "Мне не нужна сила эйконов, чтобы победить вас! Узрите <i>истинную</i> мощь!"

#. ja: まさか、ここまで押されることになろうとは……。<br>認めよう貴様の力……「持つ者」は貴様だ。
#. de: Dass es so weit kommen musste. Doch gut<nbsp>- immerhin habe ich mich nicht geirrt<nbsp>... du besitzt in der Tat eine besondere Gabe.
#. fr: Voilà qui est très... surprenant. Tu possèdes un grand pouvoir, je dois l'admettre.
msgctxt "InstanceContentTextData:33221:0:0"
msgid "This is most...unexpected. You are possessed of great might, this I will allow."
msgstr "Вот это... неожиданно. Признаю, сила в тебе велика."

#. ja: しかし、「統べる者」は違う。<br>力には力で示そう、我こそがその者だと！
#. de: Eine Gabe, aber nicht die Kraft eines Herrschers! Der Herrscher bin ich! Geboren zur Macht!
#. fr: Mais tu n'as pas l'étoffe d'un souverain ! Telle est la différence entre nous... Une différence qui va m'assurer la victoire !
msgctxt "InstanceContentTextData:33222:0:0"
msgid "Yet yours is not the might of a ruler! Such is the difference between us─a difference that will assure my victory!"
msgstr "Но правителю нужна совсем иная мощь! Вот чем мы отличаемся — и это отличие принесёт мне победу!"

#. ja: アルテマ……だと！？<br>なに、機体の制御が奪われているというのか……！
#. de: Was?! Die Ultima-Waffe? Verflucht seist du, Ascian!
#. fr: C'est... Ultima<nbsp>!? Oh non... Le dernier garde-fou a été levé...
msgctxt "InstanceContentTextData:33223:0:0"
msgid "U-Ultima!? Curse you, Ascian!"
msgstr "У-Ультима!? Будь ты проклят, асцианин!"

#. ja: ええい、アシエン・ラハブレアめ……。<br>またもあれを撃つ気か！？
#. de: Lahabrea! Willst du etwa erneut<nbsp>...?
#. fr: Maudit sois-tu, Ascien ! Ta soif de destruction ne sera-t-elle donc jamais assouvie !?
msgctxt "InstanceContentTextData:33224:0:0"
msgid "How much destruction must be wreaked before you are sated!?"
msgstr "Сколько ещё разрушений тебе нужно, чтобы насытиться!?"

#. ja: 滅びの魔法が……再び放たれようとしています……。
#. de: Der böse Zauber von Chaos und Verderben<nbsp>... wird erneut entfesselt!
#. fr: Je n'ai pas la force... de te protéger à nouveau...
msgctxt "InstanceContentTextData:33225:0:0"
msgid "I have not the strength...to shield thee again..."
msgstr "У меня больше нет сил... снова защитить тебя..."

#. ja: 光の戦士よ、滅びを阻止するのです……。<br>あれは絶望の闇……許してはなりません……。
#. de: Fühle das Licht! Lass dem Dunkel nicht den Sieg! Sonst wird unsere Zukunft in Ver<shy>zweif<shy>lung versinken.
#. fr: Ô <if $gn4>Guerrière<else>Guerrier</if> de la Lumière. Tu dois faire cesser ce sort impie... ou les Ténèbres règneront !
msgctxt "InstanceContentTextData:33226:0:0"
msgid "Permit not the manifestation of that vile magick...lest Darkness prevail!"
msgstr "Не дай этому проклятому заклинанию свершиться... иначе тьма восторжествует!"

#. ja: アルテマ発動まで　20　秒！
#. de: Ultima-Aktivierung in 20 Sekunden
#. fr: Détonation ultima dans 20 secondes
msgctxt "InstanceContentTextData:33227:0:0"
msgid "Ultima detonation in 20 seconds."
msgstr "До взрыва «Ultima»: 20 секунд."

#. ja: アルテマ発動まで　10　秒！
#. de: Ultima-Aktivierung in 10 Sekunden
#. fr: Détonation ultima dans 10 secondes
msgctxt "InstanceContentTextData:33228:0:0"
msgid "Ultima detonation in 10 seconds."
msgstr "До взрыва «Ultima»: 10 секунд."

#. ja: アルテマ発動まで　5　秒！
#. de: Aktivierung in 5 Sekunden
#. fr: Détonation ultima dans 5 secondes
msgctxt "InstanceContentTextData:33229:0:0"
msgid "Ultima detonation in 5 seconds."
msgstr "До взрыва «Ultima»: 5 секунд."

#. ja: アルテマ発動まで　4　秒！
#. de: Aktivierung in 4 Sekunden
#. fr: 4...
msgctxt "InstanceContentTextData:33230:0:0"
msgid "4..."
msgstr "4..."

#. ja: アルテマ発動まで　3　秒！
#. de: Aktivierung in 3 Sekunden
#. fr: 3...
msgctxt "InstanceContentTextData:33231:0:0"
msgid "3..."
msgstr "3..."

#. ja: アルテマ発動まで　2　秒！
#. de: Aktivierung in 2 Sekunden
#. fr: 2...
msgctxt "InstanceContentTextData:33232:0:0"
msgid "2..."
msgstr "2..."

#. ja: アルテマ発動まで　1　秒！
#. de: Aktivierung in 1 Sekunde
#. fr: 1...
msgctxt "InstanceContentTextData:33233:0:0"
msgid "1..."
msgstr "1..."

#. ja: フハハハハハ！<br>ハイデリンごと、消えてなくなれぃ！！
#. de: Ahahahahah! Zusammen mit deiner Hydaelyn musst du hilflos vergehen!
#. fr: Ha ha ha ha ha<nbsp>!!! C'est fini pour toi, Hydaelyn<nbsp>!
msgctxt "InstanceContentTextData:33234:0:0"
msgid "Your time is at an end, Hydaelyn!"
msgstr "Твоё время истекло, Хайделин!"

#. ja: 聞いて……感じて……考えて……。
#. de: Hör hin<nbsp>... Fühle es<nbsp>... Denk nach<nbsp>...
#. fr: Entends... Ressens... Pense...
msgctxt "InstanceContentTextData:33235:0:0"
msgid "Hear... Feel... Think..."
msgstr "Слушай... Чувствуй... Думай..."

#. ja: 裸者の広間への到達
#. de: Zur Ruhestatt der Gepeinigten vordringen
#. fr: Atteindre le repos du démuni
msgctxt "InstanceContentTextData:33300:0:0"
msgid "Arrive at the confession chamber"
msgstr "Доберитесь до Зала исповеди"

#. ja: 裸者の広間の突破
#. de: Ruhestatt der Gepeinigten durchbrechen
#. fr: Franchir le repos du démuni
msgctxt "InstanceContentTextData:33301:0:0"
msgid "Clear the confession chamber"
msgstr "Пройдите Зал исповеди"

#. ja: 愚者の広間への到達
#. de: Zur Ruhestatt der Narren vordringen
#. fr: Atteindre le repos du sot
msgctxt "InstanceContentTextData:33302:0:0"
msgid "Arrive at the Fool's Rest"
msgstr "Доберитесь до Пристанища глупцов"

#. ja: 愚者の広間の突破
#. de: Die Ruhestatt der Narren durchbrechen
#. fr: Franchir le repos du sot
msgctxt "InstanceContentTextData:33303:0:0"
msgid "Clear the Fool's Rest"
msgstr "Пройдите Пристанище глупцов"

#. ja: 拷問の間への到達
#. de: Zur Folterkammer vordringen
#. fr: Atteindre la chambre de torture
msgctxt "InstanceContentTextData:33304:0:0"
msgid "Arrive at the abacination chamber"
msgstr "Доберитесь до камеры пыток"

#. ja: グラフィアスの撃破
#. de: Graffias bezwingen
#. fr: Vaincre Graffias
msgctxt "InstanceContentTextData:33305:0:0"
msgid "Defeat Graffias"
msgstr "Одолейте Графиаса"

#. ja: 来い！　閣下の理想に仇なす者よ<br>貴様の野望は、ここで果てる！
#. de: Widersacher des Legatus werden gnadenlos beseitigt!
#. fr: Personne ne s'opposera à l'idéal du général<nbsp>! Viens ici que je t'écrase<nbsp>!
msgctxt "InstanceContentTextData:33400:0:0"
msgid "I will suffer none to oppose Lord van Baelsar!"
msgstr "Я не позволю никому встать на пути лорда ван Баэльсара!"

#. ja: 反逆者は、我が盾……<br>ガンシールド「タルタロス」の前に必滅……！
#. de: Spür das Schild des Kaisers ...
#. fr: Mes boucliers sont im<shy>pé<shy>né<shy>tra<shy>bles, et tu vas bientôt connaître leur pouvoir destructeur !
msgctxt "InstanceContentTextData:33401:0:0"
msgid "Like countless other challengers, you will fall before me!"
msgstr "Как и бесчисленные противники до тебя, ты падёшь от моей руки!"

#. ja: ガンシールド「タルタロス」フィールド展開……<br>貴様の攻撃なぞ、跳ね返してくれる！
#. de: Meine Schilde sind undurchbrechlich!
#. fr: Déploiement du champ de force... Essaye donc de m'attaquer pour voir<nbsp>!
msgctxt "InstanceContentTextData:33402:0:0"
msgid "My shields are impregnable!"
msgstr "Мои щиты непробиваемы!"

#. ja: 逃がさん……！<br>閣下によるエオルゼア統一の、礎となるがいい！
#. de: Du wirst nicht entkommen!
#. fr: Avec ta défaite, le général van Baelsar sera encore plus près de réaliser son noble dessein !
msgctxt "InstanceContentTextData:33403:0:0"
msgid "Your defeat will bring Lord van Baelsar's noble conquest one step closer to fruition!"
msgstr "Твоё поражение приблизит славное завоевание лорда ван Баэльсара!"

#. ja: ガハッ……<br>これが、蛮神「タイタン」を屠った力か……！
#. de: Mit dieser Kraft also fälltest du den großen Titan ...
#. fr: (tousse) Voilà donc la force <if $gn4>de la tombeuse<else>du tombeur</if> de Titan...<nbsp>?
#. macro: <if $gn4>she<else>he</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "InstanceContentTextData:33404:0:0"
msgid "Ugh... So this is the strength of <if $gn4>she<else>he</if> who vanquished Titan..."
msgstr "Кх... Так вот какова сила того, кто одолел Титана..."

#. ja: リットアティン隊長……援護いたしますッ！
#. de: Mein Praefectus! Wir stehen an Eurer Seite!
#. fr: Préfet sas Arvina<nbsp>! Tenez bon, nous allons vous aider<nbsp>!
msgctxt "InstanceContentTextData:33405:0:0"
msgid "Let us aid you, my lord!"
msgstr "Позвольте нам помочь вам, милорд!"

#. ja: な、なぜ戻ってきた……！？<br>撤退を命じたはずだぞ！
#. de: Ihr seid zurückgekommen? Ich hatte euch befohlen, zu verschwinden!
#. fr: Q-qu'est-ce que vous faites là<nbsp>!? Je vous ai ordonné de vous retirer<nbsp>!
msgctxt "InstanceContentTextData:33406:0:0"
msgid "What? I thought I ordered you to leave!"
msgstr "Что? Я же приказал вам уходить!"

#. ja: 申し訳有りません。<br>ですが、友軍への警告は、ご命令どおり発してきました！
#. de: Vergebt uns, Praefectus. Wir konnten Euch nicht im Stich lassen ...
#. fr: N-n'ayez crainte, Préfet<nbsp>! Nous avons alerté les troupes alliées comme vous nous l'avez demandé<nbsp>!
msgctxt "InstanceContentTextData:33407:0:0"
msgid "Forgive us, my lord, but we couldn't let you face the enemy alone!"
msgstr "Простите, милорд, но мы не могли бросить вас одного!"

#. ja: 我が軍団の栄光、兵たちの忠義……！<br>無にはさせん、無にはさせんぞォォォ！！
#. de: Ich werde den Mut und die Treue meiner Männer nicht umsonst sein lassen! Verlasst euch darauf!
#. fr: Mes fidèles soldats, vous qui faisiez ma fierté... Je vengerai votre mort, coûte que coûte<nbsp>!!!
msgctxt "InstanceContentTextData:33409:0:0"
msgid "Your conviction and courage will not be for naught! This I swear!"
msgstr "Ваши верность и отвага не пропадут даром! Клянусь!"

#. ja: ガイウス閣下に勝利を……！<br>そして我が配下に、貴様の首を捧げてくれようッ！
#. de: Dein Kopf soll rollen! Für Gaius! Für unseren Sieg!
#. fr: Au nom du général van Baelsar et de mes hommes, j'aurai ta tête<nbsp>!
msgctxt "InstanceContentTextData:33410:0:0"
msgid "For victory and vengeance, I will strike you down!"
msgstr "Ради победы и мести я сражу тебя!"

#. ja: 捉えたぞ……！<br>貴様の命、我が身に替えてもらい受ける……！
#. de: Für dich gibt es kein Entkommen!
#. fr: Je te tiens<nbsp>! À présent, tu vas me rejoindre dans la tombe<nbsp>!
msgctxt "InstanceContentTextData:33414:0:0"
msgid "Hah, I have you now!"
msgstr "Ха, попался!"

#. ja: もはや逃げられんぞ……！<br>共に華々しく爆炎の中で散ろうではないか……！
#. de: Dieses Inferno wird uns gemeinsam in den Tod reißen!
#. fr: Inutile de te débattre<nbsp>! Nous périrons ensemble dans les flammes<nbsp>!
msgctxt "InstanceContentTextData:33415:0:0"
msgid "We shall go together, amidst a raging inferno!"
msgstr "Сгинем вместе в бушующем пламени!"

#. ja: どれだけ打たれようとも、この手は……<br>この鎖は離さんぞ……！
#. de: Und wenn du mir die Finger zerschmetterst, ich werde nicht loslassen!
#. fr: Tu auras beau me frapper, je ne lâcherai pas cette chaîne<nbsp>!
msgctxt "InstanceContentTextData:33416:0:0"
msgid "No amount of pain can loosen my grip!"
msgstr "Сколько ни бей, хватки моей не разжать!"

#. ja: グッ……この血が枯れても、貴様を討つ……！
#. de: Ich bringe dich um ... und wenn es das Letzte ist, was ich tue!
#. fr: Argh... Même si ça me coûte la vie... Je te détruirai !
msgctxt "InstanceContentTextData:33417:0:0"
msgid "Ungh... You will not escape..."
msgstr "Угх... Тебе не уйти..."

#. ja: 待っていろ……！<br>我もまた、すぐにお前たちのところへ逝く……！
#. de: Ruhet in Frieden. Auf dass ich euch schon sehr bald folgen möge ...
#. fr: Attendez-moi, mes braves soldats... Je vous rejoindrai bientôt...<nbsp>!
msgctxt "InstanceContentTextData:33418:0:0"
msgid "Rest in peace, men... I shall join you soon..."
msgstr "Покойтесь с миром, солдаты... Скоро я к вам присоединюсь..."

#. ja: カハッ……ハァ、ハァ……<br>しぶといヤツめ……だが、これで終わりだ……！
#. de: \<keuch> \<keuch> Du bist stark, aber nicht stark genug. Dies ist dein Ende!
#. fr: (halète) (halète) Tu as de la ressource... mais tu ne survivras pas à ça<nbsp>!
msgctxt "InstanceContentTextData:33419:0:0"
msgid "\\<pant> \\<pant> It's over... Strong as you are, you cannot survive this!"
msgstr ""

#. ja: リットアティン・サス・アルヴィナを倒せ
#. de: Bezwinge Rhitahtyn sas Arvina
#. fr: Vaincre Rhitahtyn sas Arvina
msgctxt "InstanceContentTextData:33420:0:0"
msgid "Defeat Rhitahtyn sas Arvina"
msgstr "Одолейте Риотакина сас Арвину"

#. ja: リットアティンの部下たちを倒せ
#. de: Bezwinge Rhitahtyns Gefolge
#. fr: Vaincre les soldats de Rhitahtyn
msgctxt "InstanceContentTextData:33421:0:0"
msgid "Defeat Rhitahtyn's minions"
msgstr "Одолейте приспешников Риотакина"

#. ja: 再びリットアティン・サス・アルヴィナを倒せ
#. de: Bezwinge Rhitahtyn erneut
#. fr: Achever Rhitahtyn sas Arvina
msgctxt "InstanceContentTextData:33422:0:0"
msgid "Defeat Rhitahtyn sas Arvina again"
msgstr "Одолейте Риотакина сас Арвину ещё раз"

#. ja: クッ……お前だけでも退くのだ……！
#. de: Genug! Zieh dich zurück!
#. fr: Grr... Assez<nbsp>! Toi, va-t'en si tu veux sauver ta peau<nbsp>!
msgctxt "InstanceContentTextData:33423:0:0"
msgid "Flee, damn you! Flee while you still can!"
msgstr "Беги, проклятье! Беги, пока не поздно!"

#. ja: 我が故郷に伝わりし秘術を披露しよう……！
#. de: Dies ist eine Technik aus meinem Heimatland! Lass sie mich dir demonstrieren!
#. fr: Tiens, admire une technique tout droit venue de ma province natale<nbsp>!
msgctxt "InstanceContentTextData:33424:0:0"
msgid "Let me show you a technique passed down in my homeland!"
msgstr "Позволь показать тебе приём, которому учат в моей родине!"

#. ja: やってくれる……！<br>ならば、こちらも出し惜しみはなしだ！
#. de: Na schön! Wenn du dich nicht zurückhältst, sollst auch du meine ganze Kraft kennenlernen!
#. fr: Une vraie teigne... Soit, je ne retiendrai plus mes coups<nbsp>!
msgctxt "InstanceContentTextData:33425:0:0"
msgid "You do not hold back! Very well, neither shall I!"
msgstr "Не сдерживаешься? Что ж, я тоже не стану!"

#. ja: 痛みを忘れ、怒りを燃やせ……<br>この激情を爆炎とともに叩き込む……！
#. de: Ignoriere den Schmerz ... Entfache deinen Zorn! Kämpfe mit dem Feuer wilder Ent<shy>schlos<shy>sen<shy>heit!
#. fr: La douleur n'est rien face à ma rage de vaincre... Regarde-la s'embraser<nbsp>!
msgctxt "InstanceContentTextData:33426:0:0"
msgid "Ignore pain... Ignite rage... And fight with the fury of wildfire!"
msgstr "Забудь о боли... Разожги в себе ярость... Сражайся с огнём в сердце!"

#. ja: 貴様だけは、絶対に許さん……！
#. de: Erwarte keinen Funken Gnade von mir!
#. fr: Pas de pitié pour toi<nbsp>!
msgctxt "InstanceContentTextData:33427:0:0"
msgid "You will have no mercy from me!"
msgstr "Пощады от меня не жди!"

#. ja: なればこそ、支援に来たのです！<br>自分たちは最後まで隊長と共に……！
#. de: Wir haben getan, was Ihr befohlen habt. Nun hält uns nichts mehr davon ab, bis zum Schluss an Eurer Seite zu kämpfen!
#. fr: Et nous sommes revenus dans la foulée pour vous aider<nbsp>! Nous resterons à vos côtés jusqu'au bout<nbsp>!
msgctxt "InstanceContentTextData:33429:0:0"
msgid "We've raised the alarm as you bade...and now we would fight with you!"
msgstr "Мы подняли тревогу, как вы и приказали... А теперь будем сражаться рядом с вами!"

#. ja: 中央交差路への到達
#. de: Die Hauptkreuzung erreichen
#. fr: Atteindre le carrefour central
msgctxt "InstanceContentTextData:33500:0:0"
msgid "Arrive at the central crossing"
msgstr "Доберитесь до центрального перекрёстка"

#. ja: 中央交差路の突破
#. de: Die Hauptkreuzung sichern
#. fr: Franchir le carrefour central
msgctxt "InstanceContentTextData:33501:0:0"
msgid "Clear the central crossing"
msgstr "Пройдите центральный перекрёсток"

#. ja: 第Ⅴ閉鎖区への到達
#. de: Areal V erreichen
#. fr: Atteindre la zone V
msgctxt "InstanceContentTextData:33502:0:0"
msgid "Arrive at Area V"
msgstr "Доберитесь до зоны V"

#. ja: 第Ⅴ閉鎖区の突破
#. de: Areal V sichern
#. fr: Franchir la zone V
msgctxt "InstanceContentTextData:33503:0:0"
msgid "Clear Area V"
msgstr "Пройдите зону V"

#. ja: 閲兵場への到達
#. de: Den Paradeplatz erreichen
#. fr: Atteindre le champ de parade
msgctxt "InstanceContentTextData:33504:0:0"
msgid "Arrive at the parade ground"
msgstr "Доберитесь до плаца"

#. ja: リウィアの撃破
#. de: Livia sas Junius bezwingen
#. fr: Vaincre Livia sas Junius
msgctxt "InstanceContentTextData:33505:0:0"
msgid "Defeat Livia sas Junius"
msgstr "Одолейте Ливию сас Юниус"

#. ja: こちらシドだ、聞こえるか……？<br>作戦の第一目標は、「高出力魔導フィールド」の解除だ。
#. de: Hier ist Cid, hört ihr mich? Um weiterzukommen, müssen wir zunächst das Magitek-Energiefeld deaktivieren.
#. fr: Ici Cid, tu me reçois<nbsp>? Pour rappel, notre principal objectif est de désactiver le champ de force magitek.
msgctxt "InstanceContentTextData:33506:0:0"
msgid "This is Cid. To review, our goal is to deactivate the magitek field."
msgstr "Это Сид. Напоминаю: наша цель — отключить магический барьер."

#. ja: 俺はフィールドの発生器を探してみる。<br>その間、派手に暴れて、敵の目を引き付けておいてくれ！
#. de: Am besten, ihr spielt den Lockvogel für die Wachen, während ich nach dem Feldgenerator suche.
#. fr: Je vais essayer de localiser le générateur. Pendant ce temps, fais diversion en causant un maximum de grabuge<nbsp>!
msgctxt "InstanceContentTextData:33507:0:0"
msgid "If you could create a diversion─that's to say, wreak lots of havoc─I'll search for the field generator."
msgstr "Устройте отвлекающий манёвр — ну, пошумите как следует, — а я поищу генератор поля."

#. ja: どうした、行き止まりにでも迷い込んだか？<br>その地点なら……周囲に「ダストシュート」がないか探してみてくれ！
#. de: Seid ihr etwa steckengeblieben? In dem Fall geht's wohl nur durch den Entsorgungsschacht weiter. Da müsste irgendwo einer sein!
#. fr: Qu'est-ce qu'il se passe<nbsp>? Tu es <if $gn4>coincée<else>coincé</if><nbsp>? Hmm... Quelque part autour de toi, il devrait y avoir un vide-ordures.
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:33508:0:0"
msgid "<split \" \" 1><string $gs1></split>, how are you faring? ...Reached a dead end, you say? I believe I know where you are."
msgstr "<split \" \" 1><string $gs1></split>, как дела? ...Зашли в тупик? Кажется, я знаю, где вы."

#. ja: そいつを利用すれば、別の区画に入り込めるはずだ。<br>敵の意表をついて大暴れしてやれ！
#. de: Eigentlich kein schlechter Plan. Wenn ihr am anderen Ende wieder rauskommt, könnt ihr die Wachen dort überrumpeln!
#. fr: Si tu grimpes dedans, tu devrais atterrir dans un autre secteur. Et les gardes ne te verront pas venir<nbsp>!
msgctxt "InstanceContentTextData:33509:0:0"
msgid "There's a disposal chute nearby. Find it and jump in, and you'll emerge in a different sector."
msgstr "Поблизости есть мусоропровод. Найдите его и заберитесь внутрь — он выведет в другой сектор."

#. ja: 聞いてくれ、そっちに高速魔導駆逐艇が向かうのが見えた！<br>上空からの爆撃に注意するんだ！
#. de: Cid an <split " " 1><string $gs1></split>! Ihr bekommt jeden Moment Besuch von ein paar Jägern. Bleibt wachsam!
#. fr: Attention, j'aperçois des chasseurs magitek qui foncent droit sur ta position<nbsp>! Prends garde à leurs bombardements<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:33510:0:0"
msgid "<split \" \" 1><string $gs1></split>, assault crafts are near! Watch out for incoming fire!"
msgstr "<split \" \" 1><string $gs1></split>, рядом штурмовые корабли! Берегись обстрела!"

#. ja: こちらシドだ、警備システムの制御盤を見つけた。<br>待ってろ、封鎖された隔壁を開いてやる。
#. de: Ich habe die Armaturen für das Sicherheitssystem gefunden! Nur eine Sekunde, dann habt ihr freie Bahn.
#. fr: Ici Cid. J'ai trouvé le panneau de commande du système de sécurité. Je te déverrouille l'accès au carrefour central.
msgctxt "InstanceContentTextData:33511:0:0"
msgid "I've located the controls for the security system. A moment while I disable the barriers."
msgstr "Я нашёл пульт управления системой безопасности. Погоди, сейчас открою перегородки."

#. ja: また隔壁か……だが、便利なものに乗ってるからな。<br>こいつの砲撃でブチ抜いてやるぜ！
#. de: Noch so eine Cermet-Wand? Deine kleine Hilfsmaschine sollte damit kein Problem haben.
#. fr: Bon, voyons voir ce que cette machine a dans le ventre... Recule, ça va péter<nbsp>!
msgctxt "InstanceContentTextData:33512:0:0"
msgid "Another bulkhead, eh? Fortunately I'm equipped for the task. Stand back!"
msgstr "Опять перегородка? Хорошо, что у меня есть всё необходимое. Отойдите!"

#. ja: ヒャッハー！<br>このまま「高出力魔導フィールド」の発生器に向かうぞ！
#. de: Ha! Gut gezielt! Los jetzt, der Feldgenerator kann nicht mehr weit sein!
#. fr: Et voilà le travail<nbsp>! Le générateur ne devrait plus être très loin. Suis-moi<nbsp>!
msgctxt "InstanceContentTextData:33513:0:0"
msgid "Come on, the field generator should be just up ahead!"
msgstr "Вперёд, генератор поля должен быть совсем близко!"

#. ja: 見つけた、アレが「高出力魔導フィールド」だ！<br>俺が魔導アーマーでブチ壊す……敵を引き付けてくれ！
#. de: Da haben wir ihn ja! Kümmer dich um die Einheiten! Ich jage den Generator hoch!
#. fr: Trouvé<nbsp>! Occupe-toi des gardes, je me charge de le faire sauter avec mon armure magitek<nbsp>!
msgctxt "InstanceContentTextData:33514:0:0"
msgid "There it is! Keep the enemy occupied while I take it out of commission!"
msgstr "Вот он! Отвлеки врагов, а я выведу его из строя!"

#. ja: アタシから奪った分……貴様の全てを奪ってやる！
#. de: Was du mir genommen hast, wirst du hundertfach verlieren!
#. fr: Je vais te reprendre tout ce que tu m'as volé<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:33515:0:0"
msgid "You will <i>not</i> take any more from me!"
msgstr "Ты у меня <i>больше</i> ничего не отнимешь!"

#. ja: ガンバグナウ「アグライア」、<br>この痛み、たっぷりと味わせてやるッ！
#. de: Die Aglaia werden dich lehren, was Schmerz ist.
#. fr: Je vais te faire goûter à la <i>vraie</i> souffrance avec mes baghnakhs !
msgctxt "InstanceContentTextData:33516:0:0"
msgid "The pain I have suffered, I shall visit upon you a hundredfold!"
msgstr "Я заставлю тебя сполна испытать ту боль, что перенёс сам!"

#. ja: 調子に乗るなぁぁぁぁ！<br>貴様が英雄なら、せいぜい生き延びてみろッ！
#. de: Werd bloß nicht übermütig, du Heldenverschnitt!
#. fr: On va voir si <if $gn4>la prétendue héroïne<else>le prétendu héros</if> que tu es peut survivre à ÇA<nbsp>!!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:33517:0:0"
msgid "You have made me <i>wroth</i>!"
msgstr "Ты <i>разгневал</i> меня!"

#. ja: チッ……仕留めきれなかったか……。
#. de: Hmpf. Du bist zäh, das muss ich dir lassen.
#. fr: Grr... J'étais persuadée que ce serait le coup de grâce...
msgctxt "InstanceContentTextData:33518:0:0"
msgid "Hmph, you're tough, I grant you that."
msgstr "Хм. Крепкий ты, ничего не скажешь."

#. ja: だが、まだまだこれからだッ！
#. de: Aber wart's nur ab, bis ich mit dir fertig bin!
#. fr: Bah, ce n'était qu'un échauf<shy>fe<shy>ment<nbsp>!
msgctxt "InstanceContentTextData:33519:0:0"
msgid "But I will break you soon enough!"
msgstr "Но я ещё не всё показала! Скоро я тебя сломаю!"

#. ja: このアタシが、追い詰められて……<br>それなら、魔導ブースターで決着をつけてやるッ！
#. de: Ich werde nicht verlieren<nbsp>... Gegen <i>niemanden</i>, erst recht nicht gegen <i>dich</i>!
#. fr: Ça se corse... Heu<shy>reu<shy>se<shy>ment, il me reste mon amplificateur magitek<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:33520:0:0"
msgid "You will not defeat me! <i>You will not</i>!"
msgstr "Ты меня не победишь! <i>Не победишь</i>!"

#. ja: それとな、魔導アーマーをひとつ拝借した。<br>扉の先で合流するぞ……！
#. de: Übrigens habe ich mir inzwischen eine Kampfmaschine gesichert. Wer suchet, der findet! Wir treffen uns am nächsten Tor!
#. fr: J'en ai profité pour emprunter une armure magitek... Retrouve-moi à la porte d'en face, tu m'en diras des nouvelles<nbsp>!
msgctxt "InstanceContentTextData:33521:0:0"
msgid "I'm also pleased to say I've found a suit of armor. Press on─I'll meet you just ahead."
msgstr "И ещё: я раздобыла броню. Продолжай путь, я догоню тебя впереди."

#. ja: おいおい、また増援が来たぞ……！<br>悪いが、もうひとふんばり、時間稼ぎを頼む！
#. de: Noch mehr Einheiten! Ist hier irgendwo ein Nest?! Los, <split " " 1><string $gs1></split>, dein Einsatz!
#. fr: Eh merde, ils ont fait venir la cavalerie... Désolé, il va falloir que tu tiennes encore un peu<nbsp>!
msgctxt "InstanceContentTextData:33522:0:0"
msgid "Damn, reinforcements! Take care of them, would you?"
msgstr "Чёрт, подкрепление! Разберись с ними, а?"

#. ja: エオルゼアの蛮族どもを、ここで押し止めるぞ！<br>総員、攻撃開始ッ！
#. de: Alle Einheiten zum Angriff! Lasst sie keinen Schritt weiter vordringen!
#. fr: Les sauvages ne passeront pas<nbsp>! Tout le monde à l'attaque<nbsp>!
msgctxt "InstanceContentTextData:33523:0:0"
msgid "We must hold the enemy here! All units─attack!"
msgstr "Нельзя дать врагу пройти! Всем атаковать!"

#. ja: 第VIII歩兵大隊司令部、応答せよ……！<br>中央交差路に至急、応援を要請する……！
#. de: Der Feind hat die Hauptkreuzung überrannt! Erbitte sofortige Verstärkung!
#. fr: Commandement de la 7e cohorte d'infanterie, répondez<nbsp>! Demande immédiate de renforts au carrefour central<nbsp>!
msgctxt "InstanceContentTextData:33524:0:0"
msgid "The central crossing is overrun! Requesting immediate reinforcements!"
msgstr "Центральный проход захвачен! Срочно требуются подкрепления!"

#. ja: 押されているのか……！<br>ええい、予備戦力の魔導コロッサスを投入するのだ！
#. de: Dieses verfluchte Pack! Zeit, sie aus dem Weg zu räumen. Holt den zweiten Magitek-Colossus!
#. fr: Nous sommes dépassés<nbsp>! Vite, déployez les colosses magitek<nbsp>!
msgctxt "InstanceContentTextData:33525:0:0"
msgid "Gah, damn these savages! Deploy the reserve colossi!"
msgstr "Ах, проклятые дикари! Вывести резервных колоссов!"

#. ja: これでも仕留めきれないだと？<br>司令部、さらなる増援を中央交差路に……！
#. de: N-Nein, das darf nicht sein! Wo bleibt die Verstärkung?! Wir brauchen auf der Stelle mehr Einheiten!
#. fr: Ça ne suffit toujours pas<nbsp>!? Q.G., envoyez plus de renforts<nbsp>!
msgctxt "InstanceContentTextData:33526:0:0"
msgid "How can this be...? R-Reinforcements! We need more reinforcements!"
msgstr "Как такое возможно?.. П-подкрепление! Нам нужно ещё подкрепление!"

#. ja: 私たちは、終わりを記録した……。
#. de: Wir haben das Ende bezeugt.
#. fr: Nous sommes les chroniqueuses de la fin des temps...
msgctxt "InstanceContentTextData:33600:0:0"
msgid "We have seen the end."
msgstr "Мы видели конец."

#. ja: 同じ終わりが、幾度も繰り返される。
#. de: Wieder und wieder, wohin wir auch kamen.
#. fr: Toujours la même épître liminaire sans cesse recopiée...
msgctxt "InstanceContentTextData:33601:0:0"
msgid "The same end, again and again."
msgstr "Один и тот же конец, снова и снова."

#. ja: 姉妹たちのすべてが、絶望を知った……。
#. de: Meine Schwestern fanden einzig Ver<shy>zweif<shy>lung.
#. fr: Chacune d'entre nous a éprouvé le désespoir...
msgctxt "InstanceContentTextData:33602:0:0"
msgid "All of us have known despair."
msgstr "Все мы познали отчаяние."

#. ja: 悲しみを忘れるほど深い悲しみがあった……。
#. de: Eine Trauer so stark, dass man das Trauern vergisst.
#. fr: Nous avons connu la somme de toutes les peines...
msgctxt "InstanceContentTextData:33603:0:0"
msgid "A sorrow so deep only emptiness remains."
msgstr "Горе было таким глубоким, что оставалась лишь пустота."

#. ja: 星渡りの旅は、孤独……。
#. de: Es war einsam zwischen den Sternen.
#. fr: Un voyage solitaire sur un océan de Ténèbres...
msgctxt "InstanceContentTextData:33604:0:0"
msgid " 'Tis so lonely between the stars."
msgstr "Как одиноко среди звёзд."

#. ja: 流星は落ちる……時代の終焉を連れて……。
#. de: Sterne fallen und verkünden das Ende aller Tage.
#. fr: Une pluie battante d'étoiles marquera la fin des temps...
msgctxt "InstanceContentTextData:33605:0:0"
msgid "As surely as stars fall from the heavens, all civilizations are destined to die."
msgstr "Как звёзды падают с небес, так и все цивилизации обречены на гибель."

#. ja: フェイタリズム！
#. de: Fatalismus!
#. fr: Le désespoir est éternel<nbsp>!
msgctxt "InstanceContentTextData:33606:0:0"
msgid "This is fate!"
msgstr "Такова судьба!"

#. ja: そう、すべての光は掻き消える……<br>お前の生も、すぐに苦しみへと変わろうな。
#. de: Alles Licht wird erlöschen. Jedes Lachen verstummen.
#. fr: Le bonheur n'est qu'un éclair fugace.<br>La peine l'étouffe aussitôt.
msgctxt "InstanceContentTextData:33607:0:0"
msgid "All light is destined to fade─all happiness give way to suffering."
msgstr "Всякий свет угаснет, всякое счастье обернётся страданием."

#. ja: 無に還れ……！
#. de: Vergeht ins Nichts!
#. fr: Votre existence est futile<nbsp>!
msgctxt "InstanceContentTextData:33608:0:0"
msgid "Embrace the quiet!"
msgstr "Покорись тишине!"

#. ja: これもまた絶望のカタチ……。
#. de: Ver<shy>zweif<shy>lung hat vielerlei Formen.
#. fr: Le désespoir prend bien des formes...
msgctxt "InstanceContentTextData:33609:0:0"
msgid "Utterly futile."
msgstr "Всё было тщетно."

#. ja: 苦しむ必要はないの…
#. de: Niemand muss leiden!
#. fr: Inutile de souffrir...
msgctxt "InstanceContentTextData:33610:0:0"
msgid "Your suffering is at an end."
msgstr "Твои страданиям конец."

#. ja: ああ、苦悶があふれる……！<br>病にまみれた星の記憶が……！
#. de: Aah, die Erinnerung! Ein Stern, versunken in Pest und Seuche!
#. fr: Aaah... Cette souffrance... Je me souviens...<nbsp>!<br>Un monde en proie au fléau de la maladie<nbsp>!
msgctxt "InstanceContentTextData:33611:0:0"
msgid "Ahhh, it comes flooding back. The memory of a star ravaged by disease."
msgstr "А-а-а, всё возвращается... Воспоминание о звезде, израненной болезнью."

#. ja: 影のように速く……滅びの運命よ来たれ……！
#. de: Schnell und leise wie ein Schatten kommt das Verderben.
#. fr: Le drame frappe toujours plus vite que le couchant<nbsp>!
msgctxt "InstanceContentTextData:33612:0:0"
msgid "Quick as a shadow, doom comes to claim us."
msgstr "Быстра, как тень, гибель приходит за нами."

#. ja: 私たちは謳い続ける……。<br>果てから果てへと響き渡る、終焉を……。
#. de: Unser Lied vom Ende hallt durch endlosen Raum!
#. fr: Notre chant d'ané<shy>an<shy>tis<shy>se<shy>ment résonnera à jamais d'un bout à l'autre de l'univers...
msgctxt "InstanceContentTextData:33613:0:0"
msgid "Ever shall we sing, our voice resounding throughout the vast expanse."
msgstr "И будет наша песнь звучать, разноситься по бескрайним просторам."

#. ja: お前の、その小さき命にも届けよう。<br>星々の答えを……！
#. de: Höre, was unzählige Zivilisationen zu sagen haben!
#. fr: Voilà ma réponse... Celle des civilisations perdues qui vous ont précédés<nbsp>!
msgctxt "InstanceContentTextData:33614:0:0"
msgid "Unto you we shall deliver the answer of all the lives that came before."
msgstr "Тебе мы принесём ответ всех тех, кто жил прежде."

#. ja: 星の、命の、すべての果てにあるのは絶望……！
#. de: Jenseits der Sterne ist nichts als Ver<shy>zweif<shy>lung!
#. fr: Astres et vivants se dirigent inéluctablement vers l'abîme<nbsp>!
msgctxt "InstanceContentTextData:33615:0:0"
msgid "No life, no star, nor the universe itself..."
msgstr "Ни жизнь, ни звезда, ни сама вселенная..."

#. ja: 終わりの名は、希望などではないッ！
#. de: Hoffnung ist des Endes Name nicht!
#. fr: Votre épopée ne finira pas sur une note d'espoir<nbsp>!
msgctxt "InstanceContentTextData:33616:0:0"
msgid "None should hope for better!"
msgstr "Не надейся на лучшее!"

#. ja: 認めない……認められない……
#. de: Ich kann es nicht akzeptieren!
#. fr: Nous n'acceptons pas votre réponse...
msgctxt "InstanceContentTextData:33617:0:0"
msgid "We cannot suffer it again..."
msgstr "Не вынести этого снова..."

#. ja: 星のため、未来のため……<br>ラハブレアたる私自らが決着をつけよう！
#. de: Ich, Lahabrea, werde über dein Schicksal richten. Für die Zukunft dieses Gestirns!
#. fr: Pour l'avenir de notre planète, je vais mettre un terme à ta misérable existence<nbsp>!
msgctxt "InstanceContentTextData:33700:0:0"
msgid "For the sake of the star, I will deal with you personally!"
msgstr "Ради звезды я сам с тобой разберусь!"

#. ja: 消えてなくなるがいい……！<br>さらばだ、光の使徒よ！
#. de: Eine kümmerliche Existenz verlischt.
#. fr: Disparaissez<nbsp>!
msgctxt "InstanceContentTextData:33701:0:0"
msgid "You have meddled enough! Farewell, servant of Light!"
msgstr "Ты уже достаточно вмешался! Прощай, служитель Света!"

#. ja: 諦めてはなりません。<br>光のクリスタルに願うのです……。
#. de: Weiche nicht zurück. Öffne dein Herz und empfange die Macht des Kristalls!
#. fr: Tu ne dois pas abandonner... Ouvre ton cœur au Cristal... Prie-le...
msgctxt "InstanceContentTextData:33702:0:0"
msgid "Surrender not, my child. Look thee to the Light..."
msgstr "Не сдавайся, дитя моё. Взгляни к Свету..."

#. ja: 闇の力を打ち砕く……光の力を……！
#. de: Sein Strahlen wird die finsteren Kräfte beugen!
#. fr: Qu'il t'accorde le pouvoir de dissiper les Ténèbres... Le pouvoir de la Lumière<nbsp>!
msgctxt "InstanceContentTextData:33703:0:0"
msgid "And receive of the power to banish the Darkness!"
msgstr "Прими же силу, что изгонит Тьму!"

#. ja: ええい、ハイデリンめ……！<br>未だ邪魔をするだけの力を残していたか……！
#. de: Auch ein letztes Aufbäumen kann deinem Gesinde und dir nicht mehr helfen, Hydaelyn!
#. fr: Maudite Hydaelyn<nbsp>! Même à ce point affaiblie, tu viens mettre ton grain de sel...
msgctxt "InstanceContentTextData:33704:0:0"
msgid "That You should still have the strength to interfere... Damn You, Hydaelyn!"
msgstr "Даже теперь у Тебя остались силы вмешиваться... Проклятая Хайделин!"

#. ja: だが、ハイデリンの加護があろうと、<br>不完全なお前たちの刃が、私に届くことなどないと知れ！
#. de: Der Segen eurer elenden Göttin ist nur ein armseliges Glimmen im Angesicht meiner Vollkommenheit!
#. fr: Mais qu'importe. Avec ou sans sa bénédiction, tu n'as aucune chance contre moi, tout <if $gn4>imparfaite<else>imparfait</if> que tu es<nbsp>!
msgctxt "InstanceContentTextData:33705:0:0"
msgid "No matter. Blessing or no, you imperfect beings cannot hope to defeat me!"
msgstr "Неважно. С благословением или без него вам, несовершенным существам, меня не одолеть!"

#. ja: やってくれる……だが、よいのか？
#. de: Du bist stärker, als ich es dir zugetraut hätte ...
#. fr: Tu as du répondant... mais aurais-tu oublié un détail<nbsp>?
msgctxt "InstanceContentTextData:33706:0:0"
msgid "You are strong, I concede..."
msgstr "Ты силён, признаю..."

#. ja: 光の意思を持つ者よ、惑わされてはなりません……。<br>光の力で、闇の力を払うのです……！
#. de: Krieger<if $gn4>in</if>! Lasse dich nicht von Zweifeln lenken. Fühle die Stärke des Lichts und verbanne das Dunkel!
#. fr: Ne l'écoute pas... Tu incarnes la volonté de la Lumière... Sers-toi de son pouvoir pour chasser les Ténèbres<nbsp>!
msgctxt "InstanceContentTextData:33707:0:0"
msgid "Mark not the Dark Minion's subtle words. Only Light may banish the Darkness!"
msgstr "Не слушай лживых речей слуги Тьмы. Лишь Свет может изгнать Тьму!"

#. ja: アシエン・ラハブレアを倒せ
#. de: Bezwinge Lahabrea
#. fr: Vaincre Lahabrea
msgctxt "InstanceContentTextData:33708:0:0"
msgid "Defeat Lahabrea"
msgstr "Одолеть Лахабрею"

#. ja: 真なる魔法というものを、見せてくれる……！<br>創造の火を、ここに熾す……！
#. de: Ich zeige dir, was <i>wahre</i> Magie ist! Brenne, Feuer der Schöpfung!
#. fr: Je vais te montrer ce qu'est la vraie magie<nbsp>! À moi, le feu créateur<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:33709:0:0"
msgid "I will show you <i>true</i> magic! Fires of creation─arise!"
msgstr "Я покажу тебе <i>истинную</i> магию! Огонь творения, восстань!"

#. ja: 劫火よ、走れ！<br>真なる神のため、焼き清めてくれる！
#. de: Sengende Flammen, reinigt die Ungläubigen!
#. fr: Brûlez, flammes purificatrices<nbsp>! Faites place nette au nom du véritable dieu<nbsp>!
msgctxt "InstanceContentTextData:33710:0:0"
msgid "Searing flames, cleanse all in the name of the one true god!"
msgstr "Пылайте, жаркие огни, очистите всё именем единственного истинного бога!"

#. ja: これ以上、光に蝕まれし者を放置できん！<br>いでよ、幻影創造……！
#. de: Die vom Licht Befleckten müssen fallen! Richte über sie, Schatten, der Gestalt annimmt!
#. fr: Assez des suppôts de la Lumière<nbsp>! À moi, le pouvoir des ombres<nbsp>!
msgctxt "InstanceContentTextData:33711:0:0"
msgid "Those tainted by Light cannot be suffered to live! Go forth, my shadows!"
msgstr "Нельзя оставлять в живых осквернённых Светом! Вперёд, мои тени!"

#. ja: このまま私を倒すということは、<br>私が取り憑いた、この者を殺すということだぞ？
#. de: Doch wenn ich vergehe, wird die Hülle dieses Sterblichen mit mir vergehen!
#. fr: Je possède le corps de ton ami. Si je meurs, il meurt aussi.
msgctxt "InstanceContentTextData:33712:0:0"
msgid "Yet know that if I should perish, so too will the mortal within whose flesh I reside."
msgstr "Но знай: если погибну я, погибнет и смертный, в чьём теле я обитаю."

#. ja: 所詮は悪あがき、この程度ということか……。
#. de: Mehr hast du nicht zu bieten? Hmpf. Ganz wie erwartet<nbsp>...
#. fr: Et voilà. Preuve est faite que ta lutte a toujours été vaine...
msgctxt "InstanceContentTextData:33713:0:0"
msgid "Hmph. Yours was always a vain struggle."
msgstr "Хм. Твоя борьба всегда была тщетной."

#. ja: 家臣団よ、出陣せよクポーッ！
#. de: Mogrygarde, greift an!
#. fr: Fidèles vassaux, votre roi vous appelle<nbsp>!
msgctxt "InstanceContentTextData:33800:0:0"
msgid "Mogglesguard, to arms! Your king has need of you!"
msgstr "Страж Могла, к оружию! Ваш король нуждается в вас!"

#. ja: 家臣たちよ、ワルモノを裁くクポーッ！
#. de: Folgt mir, meine kupigen Untertanen! Zeigen wir diesen Miesekupos, wo der Bommel hängt!
#. fr: Mes braves vassaux<nbsp>! Donnons une leçon à ces profanateurs, kupo<nbsp>!
msgctxt "InstanceContentTextData:33801:0:0"
msgid "Hearken unto me, brave Mogglesguard! These villains must be vanquished!"
msgstr "Внемлите мне, храбрый страж Могла! Надо одолеть этих злодеев!"

#. ja: 家臣たちよ、連携して戦うべしクポーッ！
#. de: Vereint eure Kräfte, kupo!
#. fr: Mes braves vassaux<nbsp>! Vous devez unir vos forces, kupo<nbsp>!
msgctxt "InstanceContentTextData:33802:0:0"
msgid "Hold fast, Mogglesguard! Together we shall cast them out!"
msgstr "Держитесь, страж Могла! Вместе мы их прогоним!"

#. ja: メメント・モーグリ！　モグを記憶せよクポーッ！
#. de: Memento Mogry! Ihr werdet dafür büßen, euch gegen meine Untertanen erhoben zu haben, kupo!
#. fr: <i>Mémento mog</i><nbsp>!<br>Souvenez-vous que vous allez mourir de la patte d'un Mog<nbsp>!
msgctxt "InstanceContentTextData:33803:0:0"
msgid "You shall suffer for your transgressions against my subjects!"
msgstr "Ты поплатишься за то, что поднял руку на моих подданных!"

#. ja: 我らモーグリ家臣団……！<br>さからう者は、ギッタギタにしてやるクポ！
#. de: Mogrygarde, sammelt euch! Wir müssen sie gemeinsam vertreiben, kupo!
#. fr: Rassemblons-nous tous et vainquons ces rebelles, kupo<nbsp>!
msgctxt "InstanceContentTextData:33804:0:0"
msgid "Mogglesguard, assemble! We must drive them out together, kupo!"
msgstr "Страж Могла, собирайтесь! Вместе мы должны их прогнать, купо!"

#. ja: ち、ちょっとは、やるようクポね……。<br>こうなったら、善王様にいいつけてやるクポ……！
#. de: Unsere Gegner sind mächtig, kupo. Doch sie können es sicher nicht mit unserem König aufnehmen!
#. fr: P-pas mal... Mais notre roi va vous réduire en bouillie, kupo<nbsp>!
msgctxt "InstanceContentTextData:33805:0:0"
msgid "Our foe is formidable, kupo. But surely, they are no match for our king!"
msgstr "Наш враг грозен, купо. Но королю-то он точно не ровня!"

#. ja: 善王様、その裁きをクポ！
#. de: Lobet den König, kupo!
#. fr: Gloire au Roi<nbsp>!<br>Gloire aux Mogs<nbsp>!
msgctxt "InstanceContentTextData:33806:0:0"
msgid "Hail to the king, kupo!"
msgstr "Да здравствует король, купо!"

#. ja: モグたちの戦いはこれからクポ……！
#. de: Und nun geht unser Kampf erst so richtig los!
#. fr: Notre combat ne fait que commencer, kupo<nbsp>!
msgctxt "InstanceContentTextData:33807:0:0"
msgid "And now our battle begins in earnest!"
msgstr "А теперь наша битва начнётся по-настоящему!"

#. ja: モーグリ家臣団よ、制裁を与えるクポ！
#. de: Zu mir, meine Mogrygarde! Wir greifen zusammen an!
#. fr: Punissons l'ennemi comme il se doit, kupo<nbsp>!
msgctxt "InstanceContentTextData:33808:0:0"
msgid "To me, my Mogglesguard! We strike as one!"
msgstr "Ко мне, мой страж Могла! Вместе нападём!"

#. ja: パワーをポンポンメテオに……！<br>落ちたらドッカーン、痛いクポよ～！
#. de: Ihr werdet in Stücke gerissen, kupo!
#. fr: Je vais concentrer toute ma puissance et vous envoyer voler, kupo<nbsp>!
msgctxt "InstanceContentTextData:33809:0:0"
msgid "You'll be blown to smithereens, kupo!"
msgstr "Разнесём вас в пух и прах, купо!"

#. ja: 責罪広場への到達
#. de: Zur Sühneshalle vordringen
#. fr: Atteindre la salle des admonestations
msgctxt "InstanceContentTextData:33900:0:0"
msgid "Arrive in Penitence"
msgstr "Добраться до Зала Покаяния"

#. ja: 責罪広場の突破
#. de: Die Sühneshalle erobern
#. fr: Franchir la salle des admonestations
msgctxt "InstanceContentTextData:33901:0:0"
msgid "Clear Penitence"
msgstr "Пройти Зал Покаяния"

#. ja: 筆頭神官の間への到達
#. de: Zum Sitz der Hohepriesterin vordringen
#. fr: Atteindre la salle des primiciers
msgctxt "InstanceContentTextData:33902:0:0"
msgid "Arrive at the Seat of the Foremost"
msgstr "Добраться до Зала Первосвященницы"

#. ja: 筆頭神官の間の突破
#. de: Den Sitz der Hohepriesterin erobern
#. fr: Franchir la salle des primiciers
msgctxt "InstanceContentTextData:33903:0:0"
msgid "Clear the Seat of the Foremost"
msgstr "Пройти Зал Первосвященницы"

#. ja: 姉妹たちの園への到達
#. de: Zum Garten der Schwestern durchkämpfen
#. fr: Atteindre l'Enclos des sœurs
msgctxt "InstanceContentTextData:33904:0:0"
msgid "Arrive in the Garden of Epopts"
msgstr "Добраться до Сада сестёр"

#. ja: スカルミリョーネの撃破
#. de: Scarmiglione bezwingen
#. fr: Vaincre Scarmiglione
msgctxt "InstanceContentTextData:33905:0:0"
msgid "Defeat Scarmiglione"
msgstr "Одолеть Скармильоне"

#. ja: わらわの城に、ネズミが紛れこんでおったか。
#. de: Was muss ich da sehen? Ratten in meiner Burg?
#. fr: Grands Dieux<nbsp>! Des rats immondes ont envahi mon beau château<nbsp>!
msgctxt "InstanceContentTextData:33906:0:0"
msgid "It appears rats have wandered into my castle."
msgstr "Похоже, в мой замок забрели крысы."

#. ja: エーテルさえ喰えればそれでいい。<br>バラバラにしてしまえ！
#. de: Zerquetscht sie, wie das Ungeziefer, das sie sind! Ihr Äther soll mir genügen.
#. fr: Mettez-les en pièces, et gorgez-vous de leur éther<nbsp>!
msgctxt "InstanceContentTextData:33907:0:0"
msgid "Tear them apart if you must! Their drifting aether will suffice!"
msgstr "Разорвите их на части, если придётся! Мне хватит и эфира, что останется."

#. ja: ここまで来るとは……<br>ならば、わらわが直接喰ろうてやる！
#. de: Ihr seid weit gekrochen ... Dann will ich euch eine persönliche Audienz gewähren!
#. fr: Vous êtes tenaces... Puisque vous y tenez tant que ça, je vais me faire un plaisir d'engloutir votre éther moi-même<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:33908:0:0"
msgid "That you should make it this far...<br>No matter, I will devour you personally!"
msgstr "И всё же вы добрались так далеко...<br>Неважно, я сама вас сожру!"

#. ja: 美しき魔眼を、拝ませてやろう……！
#. de: Nur zu, verliert euch in meinem lockenden Blick ...
#. fr: Allons, n'ayez pas peur, plongez votre regard dans le mien<nbsp>!
msgctxt "InstanceContentTextData:33909:0:0"
msgid "Come, gaze into my eyes!"
msgstr "Ну же, загляните мне в глаза!"

#. ja: 魅入られし者の魂をいただく……！
#. de: Lasst euch fallen. Ich werde mich eurer Seelen annehmen.
#. fr: Vos âmes vivront en moi pour l'éternité<nbsp>!
msgctxt "InstanceContentTextData:33910:0:0"
msgid "Surrender your souls to me!"
msgstr "Отдайте мне свои души!"

#. ja: わらわの魔眼が効かぬだと……！？<br>おまえたちはいったい……？
#. de: Was hat das zu bedeuten?! Weshalb widersteht ihr meinem Zauber?!
#. fr: Vous avez résisté à mon regard enchanteur<nbsp>!? Mais... comment<nbsp>!?
msgctxt "InstanceContentTextData:33911:0:0"
msgid "H-How can this be? H-How could you resist my gaze?"
msgstr "К-как такое может быть? К-как вы устояли перед моим взглядом?"

#. ja: 上へ逃れるしかない……！<br>誰か、こやつらを喰らう者はおらぬか！？
#. de: Sie sind stark ... Soll sie ein anderer fressen!
#. fr: À l'aide<nbsp>! Que quelqu'un dévore ces sales rats pour moi<nbsp>! Pitié<nbsp>!
msgctxt "InstanceContentTextData:33912:0:0"
msgid "They're too strong... Someone else can devour them!"
msgstr "Они слишком сильны... Пусть их сожрёт кто-нибудь другой!"

#. ja: フシュルルル……<br>そのエーテル、我が糧にしてくれる！
#. de: Äther, stärke uns mit deiner Kraft!
#. fr: Hohoho... Tout cet éther me met l'eau à la bouche<nbsp>!
msgctxt "InstanceContentTextData:33913:0:0"
msgid "Hissssss... Your aether is mine!"
msgstr "Ш-ш-ш... Ваш эфир будет моим!"

#. ja: ガスを吸って、生ける屍になるがいい！
#. de: Verschlingt essss! Werdet zu wandelnden Toten!
#. fr: Une fois ce gaz dans vos narines, vous deviendrez des cadavres vivants<nbsp>!
msgctxt "InstanceContentTextData:33914:0:0"
msgid "Breathe deep of your deathsss!"
msgstr "Вдыхайте поглубже... и станете ходячими мертвецами!"

#. ja: 私の可愛いしもべ達よ……奴らの足止めをするのだ！
#. de: Geht und bessseitigt die Eindringlinge!
#. fr: Arrêtez-moi ces intrus, mes mignons<nbsp>!
msgctxt "InstanceContentTextData:33915:0:0"
msgid "Protect me, my minions!"
msgstr "Защитите меня, мои прислужники!"

#. ja: 我が奥義、とくと味わえ！
#. de: Lasst sie unseren Hasss spüren!
#. fr: Vous allez goûter à mon coup spécial<nbsp>!
msgctxt "InstanceContentTextData:33916:0:0"
msgid "I give you a taste of true dessspair!"
msgstr "Отведайте настоящего отчаяния!"

#. ja: 耐えたというのか……！？<br>ええい、だがここで終わる私ではない……！
#. de: Ihr ssseid am Leben!? Doch besiegen werdet ihr mich nicht!
#. fr: Quoi<nbsp>!? Vous avez survécu<nbsp>!? Attendez un peu, c'est pas terminé<nbsp>!
msgctxt "InstanceContentTextData:33917:0:0"
msgid "Stubborn mortals. I have not finished with you yet!"
msgstr "Упрямые смертные. Я ещё с вами не закончила!"

#. ja: おのれ……この私が貴様らごときに……！
#. de: Dafür sollt ihr büßen! Jeder einzelne von euch!
#. fr: Non<nbsp>! Je ne vous laisserai pas m'avoir, jamais<nbsp>!
msgctxt "InstanceContentTextData:33918:0:0"
msgid "No... I will not be defeated by you!"
msgstr "Нет... Я не позволю вам меня победить!"

#. ja: ネズミ、クジョスル！<br>オソウジ、オソウジ！
#. de: Nun wird die Burg gründlichst gesäubert! Weg mit den Ratten!
#. fr: C'est l'heure du grand nettoyage...<nbsp>! Tous les rats doivent être éliminés...<nbsp>!
msgctxt "InstanceContentTextData:33919:0:0"
msgid "Cleaning time! Eliminate the rats!"
msgstr "Пора навести порядок! Избавьтесь от крыс!"

#. ja: ニゲバ、ナイゾ……！
#. de: Kein Entkommen!
#. fr: Vous ne nous échapperez pas...<nbsp>!
msgctxt "InstanceContentTextData:33920:0:0"
msgid "There is no escape!"
msgstr "Не сбежать вам!"

#. ja: エーテルヲ、ブチマケロ！
#. de: Presst jeden Tropfen Äther aus ihnen heraus!
#. fr: Votre éther est à nous...<nbsp>!
msgctxt "InstanceContentTextData:33921:0:0"
msgid "Milk every last drop of their aether!"
msgstr "Выжмите из них весь эфир до последней капли!"

#. ja: ネズミハ、マルヤキダ！
#. de: Ratten am Spieß!
#. fr: Nous allons vous faire rôtir...<nbsp>!
msgctxt "InstanceContentTextData:33922:0:0"
msgid "Roast them whole!"
msgstr "Зажарить их целиком!"

#. ja: クロコゲ！　クロコゲ！
#. de: Röstet sie! Röstet sie!
#. fr: Calcinez-les tous...<nbsp>!
msgctxt "InstanceContentTextData:33923:0:0"
msgid "Char them black! Char them black!"
msgstr "Сжечь дотла! Сжечь дотла!"

#. ja: ギギ……シブトイネズミダ！
#. de: Garstiges Gesindel!
#. fr: Grrr... Sales rats...<nbsp>!
msgctxt "InstanceContentTextData:33924:0:0"
msgid "Grrr... Stubborn rats!"
msgstr "Гр-р... Упрямые крысы!"

#. ja: コレナラドウダ？　コレナラドウダ！
#. de: Vielleicht hiermit!
#. fr: Qu'est-ce que vous dites de ça...<nbsp>?
msgctxt "InstanceContentTextData:33925:0:0"
msgid "Try this! Try this!"
msgstr "А ну-ка вот это попробуйте!"

#. ja: カクナルウエハ……！
#. de: Nun gut ...
#. fr: Puisque c'est comme ça...
msgctxt "InstanceContentTextData:33926:0:0"
msgid "Very well, then..."
msgstr "Ну что ж..."

#. ja: オマエタチ……オワッタゾ！
#. de: Dies ist euer Ende!
#. fr: Finissons-en...<nbsp>!
msgctxt "InstanceContentTextData:33927:0:0"
msgid "You are finished!"
msgstr "Вам конец!"

#. ja: モウシワケ……ゴザイマセン……
#. de: Verzeiht mir ... Herrin ...
#. fr: Maîtresse... J'implore votre pardon...
msgctxt "InstanceContentTextData:33928:0:0"
msgid "Forgive me...my lady..."
msgstr "Простите... госпожа..."

#. ja: ええい、もう逃げ場が……<br>わらわはこんなところで喰われとうない！
#. de: So nimmt meine Flucht ein Ende ... Nein, ich will nicht gefressen werden!
#. fr: Où fuir, à présent<nbsp>!? Je ne vais tout de même pas me faire dévorer dans mon propre château<nbsp>!
msgctxt "InstanceContentTextData:33929:0:0"
msgid "Trapped in my own domain... No, I don't want to be eaten!"
msgstr "Я в ловушке в собственном замке... Нет, я не хочу, чтобы меня съели!"
