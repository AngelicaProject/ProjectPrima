# InstanceContentTextData
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 予選を勝ち抜け！
#. de: Gewinne die Vorgruppenkämpfe!
#. fr: 予選を勝ち抜け！
msgctxt "InstanceContentTextData:15000:0:0"
msgid "予選を勝ち抜け！"
msgstr "Пройди отборочные бои!"

#. ja: 第１試合、バーソロミューに勝つ
#. de: Im ersten Kampf Batholomew besiegen
#. fr: Gagnez le premier combat contre Bartholomew
msgctxt "InstanceContentTextData:15001:0:0"
msgid "Defeat Bartholomew"
msgstr "Победите Варфоломея"

#. ja: 第２試合、ブロンズ・ブルに勝つ
#. de: Im zweiten Kampf Bronzener Bulle besiegen
#. fr: Gagnez le deuxième combat contre Bronze Bull
msgctxt "InstanceContentTextData:15002:0:0"
msgid "Defeat the Bronze Bull"
msgstr "Победить Бронзового Быка"

#. ja: 第３試合、アンドゥルーに勝つ
#. de: Im dritten Kampf Handeloup besiegen
#. fr: Gagnez le troisième combat contre Handeloup
msgctxt "InstanceContentTextData:15003:0:0"
msgid "Defeat Handeloup"
msgstr "Победить Ханделупа"

#. ja: いよいよ始まるザル・ブロック予選1回戦！<br>バーソロミューと<split " " 1><string $gs1></split>の一戦だ！
#. de: Im ersten Kampf der Thal-Gruppe treten Bartholomew und <split " " 1><string $gs1></split> gegeneinander an!
#. fr: Le premier match du groupe de Thal est sur le point de commencer<nbsp>! Il verra s'affronter Bartholomew contre <split " " 1><string $gs1></split><nbsp>!
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15004:0:0"
msgid "It begins! In the first match of the Thal Group, Bartholomew takes on <string $gs1>!"
msgstr "Начинается! В первом поединке группы Тала Варфоломей сразится с <string $gs1>!"

#. ja: 両者、準備はいいか！？<br>それでは……試合開始！
#. de: Seid ihr bereit? Dann möge der Kampf beginnen!
#. fr: Tout le monde est prêt<nbsp>? Combattants, affûtez vos lames<nbsp>!
msgctxt "InstanceContentTextData:15005:0:0"
msgid "Combatants, ready your arms!"
msgstr "Бойцы, приготовьте оружие!"

#. ja: さあ、いざ真剣勝負といきましょう！
#. de: Ich kann keine Rücksicht auf dich nehmen.
#. fr: Que le meilleur gagne<nbsp>!
msgctxt "InstanceContentTextData:15006:0:0"
msgid "No holding back, my friend!"
msgstr "Не сдерживайся, друг!"

#. ja: 勝負あり！<br>この試合……<split " " 1><string $gs1></split>の勝利だ！！
#. de: Der erste Kampf ist entschieden. <if $gn4>Die Siegerin<else>Der Sieger</if> ist <split " " 1><string $gs1></split>!
#. fr: Quel coup de grâce<nbsp>! La victoire revient à <split " " 1><string $gs1></split><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15007:0:0"
msgid "And the winner is <split \" \" 1><string $gs1></split>!"
msgstr "Победитель — <split \" \" 1><string $gs1></split>!"

#. ja: 銀冑団が誇る剣技……受けてみよ！
#. de: Sieh her, wie die Palastwache kämpft!
#. fr: Un casque d'argent ne peut pas perdre<nbsp>!
msgctxt "InstanceContentTextData:15008:0:0"
msgid "For the pride of the Sultansworn!"
msgstr "За честь султанских стражей!"

#. ja: これならどうだ……！？
#. de: Wie gefällt dir das ...?!
#. fr: Qu'est-ce que vous dites de ça<nbsp>!?
msgctxt "InstanceContentTextData:15009:0:0"
msgid "How about this!?"
msgstr "А вот так?!"

#. ja: 予選2回戦……順当に勝ち上がった、<br><split " " 1><string $gs1></split>の次なる相手は、ブロンズ・ブル！
#. de: In der zweiten Runde der Thal-Gruppe kämpfen die Sieger der ersten Runde gegeneinander, <split " " 1><string $gs1></split> und Bronzener Bulle!
#. fr: Le prochain adversaire de l'illustre <split " " 1><string $gs1></split> est le non moins célèbre gladiateur Bronze Bull<nbsp>!
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15010:0:0"
msgid "In the next match, <string $gs1> and the Bronze Bull will fight for a place in the Thal group final!"
msgstr "В следующем бою <string $gs1> и Бронзовый Бык сразятся за место в финале группы Тала!"

#. ja: さあ、剣を構えて……試合開始！
#. de: Zieht eure Schwerter uuund ... kämpft!
#. fr: Combattants, tenez-vous prêts à croiser le fer<nbsp>!
msgctxt "InstanceContentTextData:15011:0:0"
msgid "Combatants, take your place!"
msgstr "Бойцы, на позиции!"

#. ja: 俺っちをなめると、痛い目見るぜ！？
#. de: Wenn du mir die Gelegenheit dazu gibst, werde ich dir weh tun!
#. fr: Ne me sous-estimez pas, car vous risquez de vous en mordre les doigts<nbsp>!
msgctxt "InstanceContentTextData:15012:0:0"
msgid "You'd do well not to underestimate me."
msgstr "Не советую меня недооценивать."

#. ja: 強豪ブロンズ・ブルも、ここで力尽きたか……！？<br><split " " 1><string $gs1></split>、またしても勝利だ！
#. de: Bronzener Bulle ist am Ende. Der Sieg geht an <split " " 1><string $gs1></split>!
#. fr: Et c'est une deuxième victoire pour <split " " 1><string $gs1></split><nbsp>! Même le surpuissant Bronze Bull n'a pas pu lui tenir tête<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15013:0:0"
msgid "And <split \" \" 1><string $gs1></split> stops the Bronze Bull's furious charge!"
msgstr "<split \" \" 1><string $gs1></split> остановил яростный натиск Бронзового Быка!"

#. ja: 「獄炎の鳳」に勝つために、編み出した大技……<br>ついに使う時がきたかッ！
#. de: Endlich ist die Zeit für meine Geheimtechnik gekommen! Nimm das!
#. fr: L'heure est venue d'utiliser ma botte secrète<nbsp>!
msgctxt "InstanceContentTextData:15014:0:0"
msgid "Time for the technique I created to quench the Hellfire Phoenix!"
msgstr "Пора применить приём, который я придумал, чтобы одолеть Феникса адского пламени!"

#. ja: いよいよ、ザル・ブロックの勝者を決める戦いだ！<br>アンドゥルー対<split " " 1><string $gs1></split>！
#. de: Die letzte und entscheidende Runde der Thal-Gruppe: Handeloup gegen <split " " 1><string $gs1></split>!
#. fr: Le dernier match du groupe de Thal entre Handeloup et <split " " 1><string $gs1></split> va enfin se dérouler sous vos yeux ébahis<nbsp>!
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15015:0:0"
msgid "And now, for the final match of the Thal group: Handeloup versus <string $gs1>!"
msgstr "А теперь — финальный бой группы Тала: Ханделуп против <string $gs1>!"

#. ja: 互いの剣と名誉にかけて、<br>それでは…………試合開始ッ！！
#. de: Zieht eure Schwerter und streitet um eure Ehre. Möge der Kampf ... beginnen!
#. fr: Qui aura l'honneur de participer à la grande finale<nbsp>? Nous allons bientôt le savoir<nbsp>!
msgctxt "InstanceContentTextData:15016:0:0"
msgid "Let us see who will have the honor of fighting in the Ul Cup final!"
msgstr "Узнаем, кому достанется честь сразиться в финале Кубка Ула!"

#. ja: <split " " 1><string $gs1></split>殿……全力で挑ませてもらう！<br>戦神ハルオーネよ、ご照覧あれ！
#. de: <split " " 1><string $gs1></split>, ich werde meine ganze Kraft aufbieten, denn Halone blickt auf mich herab!
#. fr: <if $gn4>Dame<else>Sire</if> <split " " 2><string $gs1></split>, préparez-vous à subir les foudres de la Conquérante<nbsp>!
msgctxt "InstanceContentTextData:15017:0:0"
msgid "Come, my friend. Let us fight with all our strength, in the sight of the Fury!"
msgstr "Ну же, друг мой. Сразимся изо всех сил — на глазах у Фурии!"

#. ja: 勝負あったァッ～！<br>ザル・ブロックを制したのは……<split " " 1><string $gs1></split>だ！！
#. de: Da war's! <split " " 1><string $gs1></split> steht an der Spitze der Thal-Gruppe!
#. fr: Et <if $gn4>la grande gagnante<else>le grand gagnant</if> du groupe de Thal est <split " " 1><string $gs1></split><nbsp>! Quel<if $gn4>le</if> combattant<if $gn4>e</if> hors du commun<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15018:0:0"
msgid "And <split \" \" 1><string $gs1></split> defeats Handeloup to claim victory in the Thal group!"
msgstr "<split \" \" 1><string $gs1></split> одерживает победу над Ханделупом и становится чемпионом группы Тала!"

#. ja: イシュガルドで研ぎ澄まされた聖剣技……<br>いかせてもらう！
#. de: Nun wirst du <if $gn4>Zeugin<else>Zeuge</if> des heiligen Schwerts von Ishgard!
#. fr: Mon épée a été forgée dans le froid glacial du Grand Nord<nbsp>! Elle est indestructible<nbsp>!
msgctxt "InstanceContentTextData:15019:0:0"
msgid "I shall show you a technique forged in blood and ice."
msgstr "Сейчас я покажу тебе технику, выкованную в крови и льдах."

#. ja: 私とて、神殿騎士団のコマンドだ……<br>皇都を守り抜いてきた騎士の意地を、ご覧あれ！
#. de: Als Tempelritter schlägt mein Herz für Ishgard. Mein Glaube macht mich stark!
#. fr: Je ne peux pas perdre<nbsp>! Je dois faire honneur à l'ordre du Temple et à Ishgard<nbsp>!
msgctxt "InstanceContentTextData:15020:0:0"
msgid "I am the sword and shield that defends Ishgard. Bear witness to my resolve!"
msgstr "Я — меч и щит, защищающий Ишгард. Узри мою решимость!"

#. ja: 戦神ハルオーネよ、我が剣に力を！
#. de: Halone, gib mir Kraft!
#. fr: Halone, prête-moi ta force<nbsp>!
msgctxt "InstanceContentTextData:15021:0:0"
msgid "O Halone, grant me strength!"
msgstr "О, Халоне, даруй мне силу!"

#. ja: まさか最大の聖剣技を阻止されるとは……！<br>だが、勝負はこれからだ！
#. de: Wie konntest du dem heiligen Schwert widerstehen?! Das wird dir nicht noch einmal gelingen!
#. fr: Vous êtes capable de parer les attaques les plus dévastatrices... mais le combat n'est pas terminé<nbsp>!
msgctxt "InstanceContentTextData:15022:0:0"
msgid "That my most potent attack should be thwarted... But the match isn't over yet!"
msgstr "И всё же мой сильнейший удар отразили... Но бой ещё не окончен!"

#. ja: 決勝戦を勝ち抜け！
#. de: Gewinne den Endkampf des Turniers!
#. fr: Remportez la finale du tournoi<nbsp>!
msgctxt "InstanceContentTextData:15100:0:0"
msgid "Triumph in the Ul Cup final"
msgstr "Победить в финале Кубка Ула"

#. ja: ナル神とザル神に祝福された勝者たち……<br>いよいよ、ウル王杯闘技会決勝戦の始まりだ！！
#. de: <if $gn4>Die Gewinnerin<else>Der Gewinner</if> der Thal-Gruppe und der Gewinner der Nald-Gruppe treffen nun im Endkampf aufeinander!
#. fr: La grande finale du tournoi commémoratif du sultanat entre <split " " 1><string $gs1></split> et Aldis va enfin avoir lieu<nbsp>! Ce combat restera à n'en point douter dans les annales du Colisée<nbsp>!
msgctxt "InstanceContentTextData:15102:0:0"
msgid "With the blessing of Nald'thal, two mighty warriors now meet in the Ul Cup final!"
msgstr "Благословлённые Налд'талом, два могучих воина встретятся в финале Кубка Ула!"

#. ja: さァて、お手並み拝見といこうか……<br>かかってこい、<split " " 1><string $gs1></split>！
#. de: Nun gut, <split " " 1><string $gs1></split>, komm her und zeig, was du kannst!
#. fr: L'heure a sonné... Montre-moi ce que tu as dans le ventre, <split " " 1><string $gs1></split><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15103:0:0"
msgid "Come, <split \" \" 1><string $gs1></split>! Show me what you can do!"
msgstr "Ну, <split \" \" 1><string $gs1></split>, покажи, на что способен!"

#. ja: 勝負あっっっっったァァァァ～！！！<br>頂点に立ったのは……<split " " 1><string $gs1></split>だ！！
#. de: Der Endkampf ist entschieden! <if $gn4>Die beste Schwertkämpferin<else>Der beste Schwertkämpfer</if> ist <string $gs1>!!!
#. fr: C'est incroyable<nbsp>! C'est ex<shy>traor<shy>di<shy>nai<shy>re<nbsp>! <split " " 1><string $gs1></split> est <if $gn4>la grande gagnante<else>le grand gagnant</if> du tournoi<nbsp>!
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15104:0:0"
msgid "And the champion of the Ul Cup─the greatest swordsman in the realm─is <string $gs1>!"
msgstr "Чемпионом Кубка Ула — сильнейшим мечником всего королевства — становится <string $gs1>!"

#. ja: こいつが俺の得意技だ……避けれるかァ！？
#. de: Dies ist mein Spezialangriff<nbsp>... Mal sehen, ob du ihm ausweichen kannst!
#. fr: N'essaie même pas d'esquiver ce coup, tu n'y arriveras pas<nbsp>!
msgctxt "InstanceContentTextData:15105:0:0"
msgid "Let's see if you can dodge my specialty!"
msgstr "Посмотрим, сумеешь ли ты увернуться от моего коронного приёма!"

#. ja: さァて、新技のお披露目といこうじゃねェか……吹き荒べ！
#. de: Meine neueste Technik ... haut dich um!
#. fr: Il est temps d'utiliser ma nouvelle technique... Prépare-toi à prendre ton envol<nbsp>!
msgctxt "InstanceContentTextData:15106:0:0"
msgid "Here's something new to knock you off your feet!"
msgstr "А вот и мой новый приём! Сейчас с ног собьёт!"

#. ja: しばらく、そこでジッとしてなァ……！
#. de: Ja, bleib doch ganz kurz dort stehen!
#. fr: Reste où tu es, c'est parfait<nbsp>!
msgctxt "InstanceContentTextData:15107:0:0"
msgid "Stay put for me, will you?"
msgstr "Постой-ка на месте, ладно?"

#. ja: ザナラーンの砂嵐よ……すべてを呑み込め……！
#. de: Die Wüstenstürme von Thanalan ... verschlingen alles!
#. fr: Que les tempêtes de sable du Thanalan t'emportent<nbsp>!
msgctxt "InstanceContentTextData:15108:0:0"
msgid "Storms of Thanalan, devour all before you!"
msgstr "Бури Таналана, поглотите всё на своём пути!"

#. ja: こいつは噂どおり……いや、噂以上だぜ……。<br>少し見ねぇ間に腕を上げたな、<split " " 1><string $gs1></split>！
#. de: Du wirst deinem Ruf gerecht ... nein, mehr als gerecht. Du bist wirklich stark geworden, <split " " 1><string $gs1></split>!
#. fr: Tu es vraiment très fort<if $gn4>e</if>, <split " " 1><string $gs1></split>... Encore plus que je ne le pensais...
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15109:0:0"
msgid "I'll be damned, <split \" \" 1><string $gs1></split>, you're even stronger than the rumors had me believe."
msgstr "Да чтоб меня! <split \" \" 1><string $gs1></split>, ты куда сильнее, чем о тебе говорят."

#. ja: とはいえ、俺も「ナルの剣」と呼ばれた剣闘士だ……。<br>このまま最後まで付いてこれるか！？
#. de: Aber man nennt mich nicht umsonst die Nald-Klinge. Glaubst du wirklich, du kannst es mit mir aufnehmen?!
#. fr: Mais on ne m'appelle pas la “Lame de Nald” pour rien, et tu vas comprendre pourquoi<nbsp>!
msgctxt "InstanceContentTextData:15110:0:0"
msgid "But remember, this is the Sword of Nald you're facing. Let's see if you can outlast me!"
msgstr "Но ты не забывай: перед тобой Меч Налда. Посмотрим, выдержишь ли ты бой со мной!"

#. ja: 無垢の土地に急げ！
#. de: Eile zum Unschuldsfleck!
#. fr: Atteignez la terre immaculée<nbsp>!
msgctxt "InstanceContentTextData:15200:0:0"
msgid "Race to the ovoo"
msgstr "Доберись до ову!"

#. ja: 無垢の土地と契約しろ！
#. de: Verbinde dich mit dem Unschuldsfleck!
#. fr: Passez un pacte avec la terre immaculée<nbsp>!
msgctxt "InstanceContentTextData:15204:0:0"
msgid "Claim the ovoo for the Mol"
msgstr "Заключи союз с ову для племени Мол"

#. ja: 帝国軍を殲滅せよ！
#. de: Vernichte die Garlear!
#. fr: Venez à bout des forces impériales<nbsp>!
msgctxt "InstanceContentTextData:15205:0:0"
msgid "Defeat the imperial forces"
msgstr "Победить имперцев"

#. ja: 「無垢の土地」は南の方角です！<br>先導しますので、急ぎましょう！
#. de: Der Unschuldsfleck liegt in südlicher Richtung! Folgt mir!
#. fr: La terre immaculée est plus au sud. Tous avec moi<nbsp>!
msgctxt "InstanceContentTextData:15206:0:0"
msgid "The ovoo lies to the south! I will lead the way!"
msgstr "Ову к югу! Я покажу дорогу!"

#. ja: モル族だな、行かせはせんぞ！
#. de: Es sind die Mol! Wir müssen sie aufhalten!
#. fr: Voilà ces pleutres de Mol<nbsp>! Barrez-leur la route<nbsp>!
msgctxt "InstanceContentTextData:15207:0:0"
msgid "Warriors of the Mol! You will go no further!"
msgstr "Воины Мол! Дальше вам не пройти!"

#. ja: さっそく敵のおでましか……早急に片すぞ！
#. de: Die ersten Störenfriede ... Los, machen wir sie fertig!
#. fr: Ce fut rapide... Aux armes<nbsp>!
msgctxt "InstanceContentTextData:15208:0:0"
msgid "That didn't take long. Weapons!"
msgstr "Что-то быстро они объявились... За оружие!"

#. ja: 任せたぞ、ゴウセツ！<br>皆、先を急ごう！
#. de: Mäh sie nieder, Gosetsu! Ich und die anderen müssen weiter nach Süden!
#. fr: Merci mon brave Gosetsu<nbsp>! Allez, on avance<nbsp>!
msgctxt "InstanceContentTextData:15209:0:0"
msgid "My thanks, Gosetsu! Forward, brothers and sisters!"
msgstr "Благодарю, Госэцу! Вперёд, братья и сёстры!"

#. ja: すでに他部族で大盛況か！<br>蹴散らして、「無垢の土地」に触れよ！
#. de: Was für ein bunter Anblick! Vereinige dich schnell mit dem Unschuldsfleck!
#. fr: Ça se bouscule déjà au portillon... Chargez<nbsp>!
msgctxt "InstanceContentTextData:15210:0:0"
msgid "The fighting is most fierce! No matter─charge!"
msgstr "Тут вовсю кипит бой! Неважно — в атаку!"

#. ja: 時間が惜しいでござる！<br>ここは拙者に任せ、先へ行けッ！
#. de: Uns läuft die Zeit davon. Überlasst die Kerle mir und eilt nach Süden!
#. fr: Il n'y a pas une seconde à perdre. Partez devant, je vais les retenir<nbsp>!
msgctxt "InstanceContentTextData:15211:0:0"
msgid "I will deal with this rabble, my lord! Make for the ovoo!"
msgstr "С этой шайкой я разберусь, мой господин! Скорее к ову!"

#. ja: 攻撃が緩んだ……！<br><split " " 1><string $gs1></split>よ、「無垢の土地」と契約を！
#. de: Jetzt ist der richtige Moment. <split " " 1><string $gs1></split>, vereinige dich mit dem Unschuldsfleck!
#. fr: Ça se calme... Maintenant, <split " " 1><string $gs1></split><nbsp>! Scelle le pacte<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15212:0:0"
msgid "They falter! Now, <split \" \" 1><string $gs1></split>─claim the ovoo!"
msgstr "Они дрогнули! Теперь, <split \" \" 1><string $gs1></split>, завладевай ову!"

#. ja: ……待て。<br>その土地は、余輩に献上されるべきものだ。
#. de: Nicht so schnell. Diese Erde gebührt dem tapfersten Stamm!
#. fr: Pas si vite... La terre immaculée appartient aux fils d'Azim<nbsp>!
msgctxt "InstanceContentTextData:15213:0:0"
msgid "What folly is this? Who dares to challenge the Sun?"
msgstr "Что за безумие? Кто посмел бросить вызов Солнцу?"

#. ja: 来たな、誇り高き長よ。<br>そなたを抑えんことには、契約は無理か……！
#. de: Der hochmütige Magnai. Wir müssen ihn wohl erst aus dem Weg räumen ...
#. fr: Enfin, leur frère suprême se montre... Il n'est pas question de lui obéir, cette fois-ci<nbsp>!
msgctxt "InstanceContentTextData:15214:0:0"
msgid "The most radiant brother has arrived! A pity..."
msgstr "Явился самый лучезарный из братьев! Жаль..."

#. ja: 兄弟たちよ！<br>我らが威光で圧倒せよ、蹂躙せよ！
#. de: Kommt, Brüder!
#. fr: À moi, mes frères<nbsp>!
msgctxt "InstanceContentTextData:15215:0:0"
msgid "Rise, brothers of the Sun!"
msgstr "Восстаньте, братья Солнца!"

#. ja: 隙あり！　契約を試みます……！
#. de: Niemand da. Das ist unsere Chance ...!
#. fr: Une ouverture<nbsp>! J'y vais<nbsp>! Défendez-moi, les amis<nbsp>!
msgctxt "InstanceContentTextData:15216:0:0"
msgid "An opening! Defend me, my friends!"
msgstr "Вот он, шанс! Прикройте меня, друзья!"

#. ja: 身の程知らずめ。<br>余輩の許しなく触れるな……！
#. de: Kennt eure Grenzen!
#. fr: Je vais vous apprendre le respect<nbsp>!
msgctxt "InstanceContentTextData:15217:0:0"
msgid "Know your place!"
msgstr "Знай своё место!"

#. ja: 殺し合いと言っただろう？<br>勝ち残った者こそが、それを得るにふさわしい！
#. de: Ich sagte doch, es wird ein Kampf auf Leben und Tod. Und ihr werdet sterben!
#. fr: Je vous ai promis un bain de sang, vous n'allez pas être déçus<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15218:0:0"
msgid "The battle has only begun, child!<br>You will not deprive me of my pleasure!"
msgstr "Бой только начался, дитя! Не лишишь ты меня удовольствия!"

#. ja: ドタールの猛者よ、そろそろいいな？<br>なら……オレが焼き尽くす！
#. de: Krieger der Dotharl!
#. fr: À moi, frères Dotharl<nbsp>!
msgctxt "InstanceContentTextData:15219:0:0"
msgid "Hearken to the chaos, brothers!"
msgstr "Внемлите хаосу, братья!"

#. ja: 遅いと思えば、あの女……。<br>それ、地獄がはじまるぞ。
#. de: Hab mich schon gewundert, wo sie bleibt. Jetzt fängt der Höllenreigen an ...
#. fr: Sadu... La simple vue de cette furie me donne envie de déchaîner l'enfer<nbsp>!
msgctxt "InstanceContentTextData:15220:0:0"
msgid "Lo, the mad udgan comes!"
msgstr "А вот и безумная удган!"

#. ja: <split " " 1><string $gs1></split>、まだいけるな！<br>マグナイとサドゥ、両族長を討ち取るぞ！
#. de: Ich bin noch längst nicht müde. Als Nächstes knöpfe ich mir Magnai und Sadu vor!
#. fr: Tu tiens le coup, <split " " 1><string $gs1></split><nbsp>? Il faut qu'on batte Magnai et Sadu<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15221:0:0"
msgid "Still alive, <split \" \" 1><string $gs1></split>? Good! If we want to claim the ovoo, we'll need to deal with those two first!"
msgstr "Ещё держишься, <split \" \" 1><string $gs1></split>? Вот и славно! Чтобы завладеть ову, сначала придётся разобраться с этими двумя!"

#. ja: 戦は、こうでなくちゃなあッ！<br>まとめて塵にしてやるよッ！
#. de: Was für ein Kampf!
#. fr: C'est comme ça qu'on s'bat<nbsp>!
msgctxt "InstanceContentTextData:15222:0:0"
msgid "In death do our souls sing!"
msgstr "Вот это бой! В смерти наши души поют!"

#. ja: あの石像、まじない道具……！？<br>みんな、急いで壊してッ！
#. de: Die Steinstatuen scheinen verzaubert zu sein. Schnell, zerstören wir sie!
#. fr: Ces statues ne me disent rien qui vaille... Démolissons-les<nbsp>!
msgctxt "InstanceContentTextData:15223:0:0"
msgid "I don't like the looks of those giant stone thingies!"
msgstr "Мне не нравятся эти громадные каменные штуковины!"

#. ja: チッ……邪魔してくれたな……！
#. de: Mist! Immer müsst ihr mich stören ...
#. fr: Grrr... Comment osez-vous...<nbsp>?
msgctxt "InstanceContentTextData:15224:0:0"
msgid "Hmph. How dare you..."
msgstr "Хм. Да как вы смеете..."

#. ja: よくやったでござる！<br>もうひと押し、たたみかけるのだ！
#. de: Gut gemacht! Noch einen Stoß und wir haben's geschafft!
#. fr: Nous y sommes presque<nbsp>! Un dernier effort<nbsp>!
msgctxt "InstanceContentTextData:15225:0:0"
msgid "Well done, well done! Victory is within our reach!"
msgstr "Молодцы, молодцы! Победа уже близко!"

#. ja: <split " " 1><string $gs1></split>、今だ！<br>そなたが「無垢の土地」と契約を！
#. de: <split " " 1><string $gs1></split>, jetzt! Berühre den Unschuldsfleck!
#. fr: <split " " 1><string $gs1></split>, c'est maintenant ou jamais<nbsp>! Passe le pacte avec la terre immaculée<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15226:0:0"
msgid "The ovoo, <split \" \" 1><string $gs1></split>! Claim it! Claim it now!"
msgstr "Ову, <split \" \" 1><string $gs1></split>! Завладевай им! Сейчас же!"

#. ja: まわりは意地でも抑えます！<br>私たちは、絶対に勝つんだから……ッ！
#. de: Ich werde die anderen abwehren. Wir werden auf jeden Fall siegen!
#. fr: Allez, on y croit<nbsp>! Défendez la terre immaculée<nbsp>!
msgctxt "InstanceContentTextData:15227:0:0"
msgid "Defend the ovoo! Let none pass!"
msgstr "Защитите ову! Никого не пропускайте!"

#. ja: 今、契約は成った！<br>オレたちドタール族の勝利だッ！
#. de: Ha, das Bündnis steht! Die Dotharl haben gesiegt!
#. fr: Le pacte est noué<nbsp>! Nous sommes les nouveaux maîtres de la steppe<nbsp>!
msgctxt "InstanceContentTextData:15228:0:0"
msgid "The ovoo is ours! The Steppe belongs to the Dotharl!"
msgstr "Ову наша! Степь принадлежит дотарлам!"

#. ja: 「無垢の土地」は、我らが威光に染まった！<br>勝鬨を上げよ、兄弟たち！
#. de: Unser Glanz hat den Unschuldsfleck überzogen! Brüder, stoßt euren Triumphschrei aus!
#. fr: Ça y est, la terre immaculée est à nous<nbsp>! À genoux devant la toute-puissance des Oronir<nbsp>!
msgctxt "InstanceContentTextData:15229:0:0"
msgid "Bow low, Xaela─you stand before a khagan crowned!"
msgstr "Поклонитесь, зайла! Перед вами коронованный каган!"

#. ja: 号令は下されました！<br>あなたに害なす者を、草原の民は拒絶するッ！
#. de: Der Sieger ist bestimmt. Wer dir schaden will, hat die Stämme der Steppe gegen sich!
#. fr: J'ordonne à tous les guerriers de la steppe de s'unir contre ce nouvel ennemi<nbsp>!
msgctxt "InstanceContentTextData:15230:0:0"
msgid "Drive the ironmen from our lands! The khagan wills it!"
msgstr "Изгоните железных людей с наших земель! Такова воля кагана!"

#. ja: まっこと、頼もしいことだ！<br>帝国軍よ、折を見誤ったなあ！
#. de: Die Garlear haben sich wohl den falschen Zeitpunkt für einen Angriff ausgewählt.
#. fr: Ces impériaux ont mal choisi leur moment pour attaquer. Ils vont s'en mordre les doigts<nbsp>!
msgctxt "InstanceContentTextData:15231:0:0"
msgid "Such fortuitous timing you have to face a Steppe united!"
msgstr "Как удачно, что вы застали объединённую Степь!"

#. ja: まとめて掃うか。<br>テメェら、今度は邪魔するなよ……！
#. de: Jetzt putz ich euch weg!
#. fr: Allez, du balai<nbsp>!
msgctxt "InstanceContentTextData:15232:0:0"
msgid "Let naught be left in our wake!"
msgstr "Не оставим за собой ни души!"

#. ja: な、なんだか強そうな石像だど……！<br>お前ら行け、あれを壊せっ！
#. de: D-Die Steinstatuen ... Sie sehen böse und stark aus. Los Männer, macht sie platt!
#. fr: Qu'est-ce que c'est que ces statues<nbsp>!? Pulvérisez-moi ça, vite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15233:0:0"
msgid "I don't like the looks of those giant stone thingies!<br>Get rid of them─now!"
msgstr "Мне не нравятся эти громадные каменные штуковины!<br>Разберитесь с ними. Живо!"

#. ja: サドゥの石像が狙われている！　守るのだ！
#. de: Sadus Steinstatuen sind in Gefahr! Wir müssen sie beschützen!
#. fr: Nous ne devons pas les laisser détruire les statues de Sadu<nbsp>!
msgctxt "InstanceContentTextData:15234:0:0"
msgid "Aid the khatun! She must finish her spell!"
msgstr "Помогите хатун! Ей нужно закончить заклинание!"

#. ja: ヤバイ、ヤバイど……こんなはずじゃ……！
#. de: Nicht noch mal ...!
#. fr: Merde de merde de merde<nbsp>!
msgctxt "InstanceContentTextData:15235:0:0"
msgid "Bugger, bugger, bugger!"
msgstr "Вот чёрт, чёрт, чёрт!"

#. ja: ブワッハッハ、壊してやったど！<br>お前らの作戦は失敗だどー！
#. de: Buahahaha! Ich habe sie plattgewalzt! So viel zu eurem genialen Plan.
#. fr: Ha ha ha<nbsp>! Et hop, plus de statues<nbsp>! Ça vous fera les pieds<nbsp>!
msgctxt "InstanceContentTextData:15237:0:0"
msgid "Bwahahaha! You'll have to do better than that!"
msgstr "Бвахахаха! Ничего у вас не вышло!"

#. ja: ちくしょう……ザマないぜ……！
#. de: Verdammter Mist!
#. fr: Raaah<nbsp>! Tant pis, il va falloir faire sans...
msgctxt "InstanceContentTextData:15238:0:0"
msgid "Bah! I cannot stand that shambling brute."
msgstr "Вот досада... Ненавижу эту неуклюжую громилу."

#. ja: 勝敗はまだだ……！<br>手ずから殲滅してやろう！
#. de: Ich geb nicht auf!
#. fr: Je n'ai pas encore perdu<nbsp>!
msgctxt "InstanceContentTextData:15239:0:0"
msgid "We have only begun to fight!"
msgstr "Мы только начали сражаться!"

#. ja: 今度こそ……勝つはずだった、のに……。
#. de: Nie gewinne ich ...
#. fr: Cette fois-ci justement... j'aurais DÛ gagner...
msgctxt "InstanceContentTextData:15240:0:0"
msgid "But I had you, I had you!"
msgstr "Но ведь я почти победил! Почти!"

#. ja: 気に食わないが乗ってやろう。<br>不敬、不遜……余輩が禁じるッ！
#. de: Es gefällt mir zwar nicht, doch Respektlosigkeit dulde ich nicht!
#. fr: Puisqu'il le faut... En avant, fils d'Azim, châtions ces impudents<nbsp>!
msgctxt "InstanceContentTextData:15241:0:0"
msgid "Oh, if I must... The Sun claims these ironmen!"
msgstr "Ну, раз придётся... Солнце покарает этих железных людей!"

#. ja: アタシも、とっておきを出すよ！<br>みんなに……届けッ！
#. de: Ich habe noch eine Überraschung für euch. Ich hoffe, sie gefällt euch!
#. fr: Venez, tous autant que vous êtes<nbsp>! J'ai encore plein de pains à distribuer<nbsp>!
msgctxt "InstanceContentTextData:15242:0:0"
msgid "Now this is more like it! All the imperials I can punch!"
msgstr "Вот это уже лучше! Целая куча имперцев, которых можно отделать!"

#. ja: おお、力が湧いてくる！<br>よし、合わせろゴウセツ！
#. de: Ich spüre, wie die Kraft in mir aufwallt. Gosetsu, schließ dich mir an!
#. fr: Allez, montrons-leur de quoi nous sommes capables<nbsp>! Gosetsu, avec moi<nbsp>!
msgctxt "InstanceContentTextData:15243:0:0"
msgid "That's the spirit! Let's not let her put us to shame!"
msgstr "Вот это настрой! Не дадим ей нас затмить!"

#. ja: 御意！　いくでござる、若ッ！
#. de: Zu Befehl, mein Herr!
#. fr: Avec plaisir, mon seigneur<nbsp>!
msgctxt "InstanceContentTextData:15244:0:0"
msgid "Never did the thought cross my mind, my lord!"
msgstr "Ни на миг не сомневался, господин!"

#. ja: みなさん……すごい……！<br>このまま、全員撃退します！
#. de: Ihr seid unglaublich ... Es sind nicht mehr viele Gegner übrig!
#. fr: I-im<shy>pres<shy>sion<shy>nant... Tenez bon, les amis<nbsp>! Nous allons vaincre<nbsp>!
msgctxt "InstanceContentTextData:15245:0:0"
msgid "Hold fast, warriors of the Steppe! We can defeat them!"
msgstr "Держитесь, воины Степи! Мы их одолеем!"

#. ja: 見えてきました！<br>この先に「無垢の土地」があります！
#. de: Seht! Da vorne ist der Unschuldsfleck!
#. fr: Je la vois<nbsp>! La terre immaculée est droit devant<nbsp>!
msgctxt "InstanceContentTextData:15246:0:0"
msgid "There it is! The ovoo! We are not too late!"
msgstr "Вон она! Ову! Мы ещё успеваем!"

#. ja: キリがないね……！<br>ここは私が抑えるから、先行ってッ！
#. de: Es sind zu viele Gegner. Ich werde sie aufhalten, ihr geht weiter!
#. fr: À ce rythme, on y sera encore demain... Je vais m'occuper d'eux, continuez sans moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15247:0:0"
msgid "Gosetsu had the right idea!<br>I'll keep them busy─the rest of you, keep moving!"
msgstr "Госэцу был прав!<br>Я их задержу, а вы двигайтесь дальше!"

#. ja: リセさん、ありがとう……！<br><split " " 1><string $gs1></split>さん、みなさん、南へ進軍を！
#. de: Lyse, danke! Los, auf nach Süden!
#. fr: Faites attention à vous, Lyse. Allez, la terre immaculée nous attend<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15248:0:0"
msgid "Thank you, Lyse! With me, Hien, <split \" \" 1><string $gs1></split>!"
msgstr "Спасибо, Лайза! Хиэн, <split \" \" 1><string $gs1></split>, за мной!"

#. ja: 無垢の土地と契約しろ！
#. de: Vereinige dich mit dem Unschuldsfleck!
#. fr: Passez un pacte avec la terre immaculée<nbsp>!
msgctxt "InstanceContentTextData:15249:0:0"
msgid "Claim the ovoo for the Mol"
msgstr "Заключи союз с ову для племени Мол"

#. ja: 他部族の契約を阻止しつつ、マグナイを倒せ！
#. de: Besiege Magnai und gib acht, dass keiner sich dem Unschuldsfleck nähert!
#. fr: Défendez la terre immaculée et vainquez Magnai<nbsp>!
msgctxt "InstanceContentTextData:15250:0:0"
msgid "Defeat Magnai the Older and hold back the Oronir"
msgstr "Победить Магная Старшего и не подпустить ороноров"

#. ja: 他部族の契約を阻止しつつ、族長たちを倒せ！
#. de: Besiege die Stammesführer und gib acht, dass keiner sich dem Unschuldsfleck nähert!
#. fr: Défendez la terre immaculée et vainquez Sadu<nbsp>!
msgctxt "InstanceContentTextData:15251:0:0"
msgid "Defeat Sadu Heavensflame and hold back the Dotharl"
msgstr "Победить Саду, Пламя Небес, и не подпустить дотарлов"

#. ja: 無垢の土地と契約しろ！
#. de: Vereinige dich mit dem Unschuldsfleck!
#. fr: Passez un pacte avec la terre immaculée<nbsp>!
msgctxt "InstanceContentTextData:15252:0:0"
msgid "Claim the ovoo for the Mol"
msgstr "Заключи союз с ову для племени Мол"

#. ja: 流星のチョローを倒せ！
#. de: Besiege die stellaren Chuluu!
#. fr: Détruisez les chuluu stellaires<nbsp>!
msgctxt "InstanceContentTextData:15253:0:0"
msgid "Destroy the stellar chuluu"
msgstr "Уничтожить звёздных чхулу"

#. ja: 流星のチョローを守れ！
#. de: Beschützt die stellaren Chuluu!
#. fr: Défendez les chuluu stellaires<nbsp>!
msgctxt "InstanceContentTextData:15254:0:0"
msgid "Defend the stellar chuluu"
msgstr "Защитить звёздных чхулу"

#. ja: オロニル族が契約を開始！　阻止しろ！
#. de: Ein Oronir will sich mit dem Unschuldsfleck vereinigen. Geh dazwischen!
#. fr: Empêchez les Oronir d'achever leur pacte<nbsp>!
msgctxt "InstanceContentTextData:15255:0:0"
msgid "Prevent the Oronir from claiming the ovoo"
msgstr "Ороноры начали заключать союз с ову! Останови их!"

#. ja: ブドゥガ族が契約を開始！　阻止しろ！
#. de: Ein Buduga will sich mit dem Unschuldsfleck vereinigen. Geh dazwischen!
#. fr: Empêchez les Buduga d'achever leur pacte<nbsp>!
msgctxt "InstanceContentTextData:15256:0:0"
msgid "Prevent the Buduga from claiming the ovoo"
msgstr "Будуга начали заключать союз с ову! Останови их!"

#. ja: ドタール族が契約を開始！　阻止しろ！
#. de: Ein Dotharl will sich mit dem Unschuldsfleck vereinigen. Geh dazwischen!
#. fr: Empêchez les Dotharl d'achever leur pacte<nbsp>!
msgctxt "InstanceContentTextData:15257:0:0"
msgid "Prevent the Dotharl from claiming the ovoo"
msgstr "Дотарлы начали заключать союз с ову! Останови их!"

#. ja: 忍者風の傭兵を倒せ！
#. de: Die als Ninja verkleideten Söldner besiegen
#. fr: Éliminez les mercenaires déguisés en ninja<nbsp>!
msgctxt "InstanceContentTextData:15300:0:0"
msgid "Defeat the sham shinobi"
msgstr "Победить лжесиноби"

#. ja: ヴァナラを倒せ！
#. de: Vanara besiegen
#. fr: Abattez Vanara<nbsp>!
msgctxt "InstanceContentTextData:15301:0:0"
msgid "Defeat the vanara"
msgstr "Победить ванару"

#. ja: オスティルグレインを倒せ！
#. de: Ostyrgrein besiegen
#. fr: Vainquez Ostyrgrein<nbsp>!
msgctxt "InstanceContentTextData:15302:0:0"
msgid "Defeat Ostyrgrein"
msgstr "Победить Остиргрейна"

#. ja: <split " " 1><string $gs1></split>殿！<br>ま、まさか、こんなところで倒れてしまうとは……。
#. de: <split " " 1><string $gs1></split>! Nein! Wie konntest du dich nur von so einem Gegner besiegen lassen ...?
#. fr: <split " " 1><string $gs1></split><nbsp>! Non<nbsp>! Comment as-tu pu être défait<if $gn4>e</if> ici...<nbsp>?
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15303:0:0"
msgid "<split \" \" 1><string $gs1></split>! That you should fall against such feeble opposition..."
msgstr "<split \" \" 1><string $gs1></split>! И как же ты проиграл такому слабому противнику..."

#. ja: さあ、せいぜい余興を盛り上げてくれい！
#. de: Dann sorgt mal richtig für Stimmung!
#. fr: Offrez-nous un spectacle de qualité<nbsp>!
msgctxt "InstanceContentTextData:15304:0:0"
msgid "Come! Let us warm the deck...with blood!"
msgstr "Ну же! Согрейте палубу... кровью!"

#. ja: これもまた修行の一環……。<br>エセ忍者どもなんぞ、お主ひとりで充分じゃろう。
#. de: Auch dies ist Teil des Trainings ... Mit diesen billigen Ninja-Kopien wirst du alleine fertig.
#. fr: Cela aussi fait partie de ton en<shy>traî<shy>ne<shy>ment. Ces pâles imitations de ninja ne pourront rien contre toi.
msgctxt "InstanceContentTextData:15305:0:0"
msgid "This is but part of your training. Finish them swiftly, my pupil."
msgstr "Это часть твоей тренировки. Покончи с ними поскорее, ученик мой."

#. ja: 多勢を相手にするときは、<br>「桜花」や「満月」を活用し、一網打尽にすべし！
#. de: Gegen viele Gegner gleichzeitig musst du Oka und Mangetsu einsetzen, damit du mehrere auf einmal erwischst!
#. fr: Utilise Ôka et Mangetsu quand tes ennemis sont nombreux<nbsp>!
msgctxt "InstanceContentTextData:15306:0:0"
msgid "When outnumbered, use Oka or Mangetsu to smite multiple foes in one fell swoop."
msgstr "Если врагов много, бей Оку или Мангэцу — разом сразишь нескольких!"

#. ja: ホッホッホ、なかなかやるではないか。<br>それでは、私の可愛いペットを放ってやろう。
#. de: Ho ho ho! Fabelhaft! Du hast dir einen Kampf gegen mein süßes Haustier wirklich verdient!
#. fr: Ho ho ho<nbsp>! Éblouissant<nbsp>! Vous avez gagné le droit de faire joujou avec mon animal de compagnie<nbsp>!
msgctxt "InstanceContentTextData:15307:0:0"
msgid "You're tough, I'll give you that! But how will you fare against my pet?"
msgstr "Ты крепкий боец, ничего не скажешь! Но как ты справишься с моим питомцем?"

#. ja: ヴァナラちゃん、エサの時間ですよぉ！
#. de: Zeit für dein Fresschen, Vanara!
#. fr: Ma petite Vanaraaaa<nbsp>! C'est l'heure du goûteeeer<nbsp>!
msgctxt "InstanceContentTextData:15308:0:0"
msgid "Feeding time, my pretty!"
msgstr "Время кормёжки, красавчик!"

#. ja: むう、魔物を放つとは卑怯な……。<br>あのケダモノは、お主に任せた！
#. de: Ein wildes Tier auf seine Gegner zu hetzen ... wie barbarisch! <split " " 1><string $gs1></split>, diese Bestie überlasse ich dir!
#. fr: Lâcher un animal sauvage sur ses adversaires... Quelle vilenie<nbsp>! <split " " 1><string $gs1></split><nbsp>! Je te laisse le soin de l'abattre<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15309:0:0"
msgid "Hmph, 'tis a fiend who resorts to using a fiend. The beast is yours, <split \" \" 1><string $gs1></split>."
msgstr "Хм, вот негодяй, призвавший на помощь другого негодяя. Зверь твой, <split \" \" 1><string $gs1></split>."

#. ja: エセ忍者どもは、ワシが片付けよう……参る！
#. de: Inzwischen werde ich diese Möchtegern-Ninja aus dem Weg räumen!
#. fr: Pendant ce temps, je vais nous débarrasser de ces soi-disant ninja<nbsp>!
msgctxt "InstanceContentTextData:15310:0:0"
msgid "The false shinobi, you may leave to me."
msgstr "С лжесиноби я разберусь сам."

#. ja: そのケダモノは、動作が鈍い、<br>動きをよく見て避けるのだ！
#. de: Diese Bestie bewegt sich sehr behäbig. Lass sie nicht aus den Augen und weiche ihren Angriffen aus!
#. fr: Les mouvements de cette bête sont vifs<nbsp>! Observe-la bien pour prédire ses attaques<nbsp>!
msgctxt "InstanceContentTextData:15311:0:0"
msgid "That beast is a lumbering thing. You can easily anticipate and evade its attacks."
msgstr "Зверюга неповоротливая. Следи за ней — и без труда увернёшься от её атак."

#. ja: いいぞ、その調子じゃ！
#. de: Ausgezeichnet, immer weiter so!
#. fr: Excellent, continue comme ça<nbsp>!
msgctxt "InstanceContentTextData:15312:0:0"
msgid "Yes, that's the way!"
msgstr "Да, вот так!"

#. ja: ふう、こちらはもう片付いたぞ、<br>お主もとっとと終わらせてしまえい。
#. de: Ich bin fertig mit Aufräumen. Beeil dich und mach mit diesem Vieh kurzen Prozess!
#. fr: À défaut d'être compétents, ils étaient nombreux. Dépêche-toi d'éliminer cet animal, <split " " 1><string $gs1></split>.
msgctxt "InstanceContentTextData:15313:0:0"
msgid "There, I have tended to my part. Hurry and tend to yours."
msgstr "Вот, со своей частью я закончил. А ты поторопись со своей."

#. ja: わ、私の可愛いヴァナラちゃんが……！
#. de: Neeeiiiin! Mein Vanara! Mein geliebtes Vanara ...!
#. fr: Noooon<nbsp>! Ma Vanara<nbsp>! Qu'avez-vous fait à ma pauvre Vanara<nbsp>!?
msgctxt "InstanceContentTextData:15314:0:0"
msgid "Nooo! My beautiful pet!"
msgstr "Нееет! Мой красавчик!"

#. ja: お、おのれ、こちらも侍の出番だ！
#. de: Dafür wird euch mein Samurai büßen lassen!
#. fr: Vous me le paierez<nbsp>! À mon tour d'envoyer mon samouraï<nbsp>!
msgctxt "InstanceContentTextData:15315:0:0"
msgid "No more games! Time to unleash...the samurai!"
msgstr "Хватит игр! Пора выпустить... самурая!"

#. ja: さあて、ぶった切ってやるかぁ……。
#. de: So, nun werde ich euch zwei in Scheiben schneiden ...
#. fr: Allez. Je vais vous découper ces deux-là en rondelles.
msgctxt "InstanceContentTextData:15316:0:0"
msgid "Right then, let's take some heads."
msgstr "Ну что ж, пора снимать головы..."

#. ja: 真打ちの登場といったところか。
#. de: Das soll wohl der Star dieser Vorstellung sein, hm?
#. fr: Il se décide à sortir le grand jeu.
msgctxt "InstanceContentTextData:15317:0:0"
msgid "Finally, the last act of this gaudy circus."
msgstr "Наконец-то финальный номер этого пёстрого балагана."

#. ja: どうせ、そやつは刀の握り方も知らん偽者じゃ……。
#. de: Dieser Hochstapler kann doch nicht mal richtig sein Katana halten ...
#. fr: Enfin, grand jeu, si l'on peut dire.
msgctxt "InstanceContentTextData:15318:0:0"
msgid "This man is but a pretender who knows not how to hold a blade."
msgstr "Да он самозванец и клинка-то держать не умеет."

#. ja: 中途半端な侍かぶれの剣術士なんぞ、<br>相手にもならんわ。
#. de: Der Gladiator versucht nur, unsere Kampfkunst nachzuahmen. Der ist kein Gegner für dich!
#. fr: Cet épéiste n'est qu'un imitateur sans talent, il ne fera pas le poids contre toi.
msgctxt "InstanceContentTextData:15319:0:0"
msgid "I should be surprised were he to offer you any trouble."
msgstr "Сомневаюсь, что он доставит тебе хоть какие-то хлопоты."

#. ja: 見せてやるよ、侍の技ってやつを！
#. de: Ich werde euch demonstrieren, dass ich wie ein wahrer Samurai kämpfe!
#. fr: Tu vas pouvoir lui faire la dé<shy>mon<shy>stra<shy>tion des vraies techniques de samouraï<nbsp>!
msgctxt "InstanceContentTextData:15320:0:0"
msgid "I'll show you a samurai trick or two!"
msgstr "Сейчас покажу тебе пару приёмчиков самурая!"

#. ja: なんという大振り……見るに堪えん。
#. de: Diese ungelenken Bewegungen ... Ich kann das gar nicht mitansehen.
#. fr: Ses mouvements sont atrocement amples. J'ai de la peine rien que de les voir.
msgctxt "InstanceContentTextData:15321:0:0"
msgid "Such a clumsy stroke. Seeing it fair makes mine eyes bleed."
msgstr "Ну и неуклюжий удар. От одного взгляда глаза кровью наливаются."

#. ja: 当たるわけなかろう、止まって見えたわい。
#. de: Wen hofft er mit so langsamen Hieben zu treffen?
#. fr: Qui espérait-il toucher<nbsp>? Son coup était d'une telle lenteur qu'il m'a paru immobile.
msgctxt "InstanceContentTextData:15322:0:0"
msgid "You'd do better to try and cut down a fly."
msgstr "Да ему разве что муху пытаться зарубить."

#. ja: これでも食らえっ！
#. de: Nimm das!
#. fr: Bouffe ça<nbsp>!
msgctxt "InstanceContentTextData:15323:0:0"
msgid "Try this!"
msgstr "А ну, получай!"

#. ja: 目潰しとは卑怯な！
#. de: Er versucht dich zu blenden! Dieser miese Feigling!
#. fr: Il tente de t'aveugler<nbsp>!? Le lâche<nbsp>!
msgctxt "InstanceContentTextData:15324:0:0"
msgid "Slinging mud!? You have no honor!"
msgstr "Грязью швыряешься?! Где твоя честь?!"

#. ja: うるせえ！　勝てばいいんだ！　勝てばよぉ！
#. de: Pah! Alles was zählt, ist zu gewinnen!
#. fr: Lâche-moi les basques, toi<nbsp>! Tant que je gagne, tout est permis<nbsp>!
msgctxt "InstanceContentTextData:15325:0:0"
msgid "Shite on your honor! Winning's all that matters!"
msgstr "Плевать на честь! Главное — победить!"

#. ja: 刀で戦うことすら放棄するとは……。<br>侍はおろか、剣術士の誇りすら捨てたか……。
#. de: Wer als Schwertkämpfer Bomben einsetzt, der hat keine Ehre! Und so was will ein Samurai sein ...
#. fr: Voilà qu'il abandonne même sa lame<nbsp>! Que cela fait-il de lui<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15326:0:0"
msgid "You were no samurai, but neither are you a gladiator.<br>Nay, you are naught but a craven."
msgstr "Ты и самураем-то не был, но и гладиатор из тебя никудышный.<br>Ты просто трус."

#. ja: バカな……この俺が……負けるとは……。
#. de: W-Wie kann das sein ...? W-Wie kann <i>ich</i> verlieren ...?
#. fr: Non, j'y crois pas... Comment j'ai pu me faire avoir par cet avorton...<nbsp>?
msgctxt "InstanceContentTextData:15327:0:0"
msgid "Th-This can't be right..."
msgstr "Н-не может быть..."

#. ja: ぜ、全滅だと……？<br>かくなるうえは……逃げるが勝ち！
#. de: Mein Samurai ... besiegt? Nun, dann ist es wohl an der Zeit für einen strategischen Rückzug!
#. fr: Mon samouraï a perdu<nbsp>!? Grrr... Peu importe<nbsp>! Pour vaincre, je n'ai qu'à fuir<nbsp>!
msgctxt "InstanceContentTextData:15328:0:0"
msgid "Nooo! It's not supposed to play out like this! Th-The banquet is over!"
msgstr "Нееет! Всё пошло не так! П-представление окончено!"

#. ja: 逃がすものか！　あやつを追うぞ！
#. de: <split " " 1><string $gs1></split>, ihm nach! Er darf uns nicht entwischen!
#. fr: <split " " 1><string $gs1></split><nbsp>! Rattrapons-le avant qu'il ne s'échappe<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15329:0:0"
msgid "Come, <split \" \" 1><string $gs1></split>! We give chase!"
msgstr "Ну же, <split \" \" 1><string $gs1></split>! За ним!"

#. ja: だ、黙れクソジジイ！
#. de: Halt den Mund, alter Mann!
#. fr: Ferme-la, le vieillard<nbsp>!
msgctxt "InstanceContentTextData:15330:0:0"
msgid "Shut your mouth, you old bastard!"
msgstr "Заткнись, старый ублюдок!"

#. ja: クソッ！　こうなったら……奥の手だ！
#. de: Verdammt! Dann setze ich halt meine Geheimwaffe ein!
#. fr: Merde<nbsp>! Puisque c'est comme ça, voilà ma botte secrète<nbsp>!
msgctxt "InstanceContentTextData:15331:0:0"
msgid "B-Bugger this! Time to use the secret weapon!"
msgstr "Ч-чёрт с ним! Пора применить тайное оружие!"

#. ja: アリアを探せ！
#. de: Arya suchen
#. fr: Retrouvez Arya<nbsp>!
msgctxt "InstanceContentTextData:15400:0:0"
msgid "Find Arya"
msgstr "Найдите Арью"

#. ja: リリスを倒し、儀式を阻止せよ！
#. de: Lilith besiegen und das Ritual unterbrechen
#. fr: Terrassez Lilith avant qu'elle n'achève son rituel<nbsp>!
msgctxt "InstanceContentTextData:15401:0:0"
msgid "Defeat Lilith and stop the ritual"
msgstr "Победить Лилит и остановить ритуал"

#. ja: 儀式を止めて、アリアを助けだすぞ！
#. de: Wir müssen das Ritual unterbrechen und Arya retten!
#. fr: Il faut qu'on sorte Arya de là<nbsp>! Stoppons cette cérémonie<nbsp>!
msgctxt "InstanceContentTextData:15402:0:0"
msgid "We must rescue Arya before it is too late!"
msgstr "Надо спасти Арью, пока не поздно!"

#. ja: 速攻で潰す！<br><split " " 1><string $gs1></split>、いくぞ！
#. de: Lass sie uns schnell besiegen! Auf geht's, <split " " 1><string $gs1></split>!
#. fr: Débarrassons-nous d'eux rapidement<nbsp>! <split " " 1><string $gs1></split>, en avant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15403:0:0"
msgid "Swift and sure!<br>We've no time for subtlety!"
msgstr "Быстро и без промедления!<br>Нам не до тонкостей!"

#. ja: こいつらに邪魔はさせん！
#. de: Die werden uns nicht aufhalten!
#. fr: Pas de temps à perdre avec ces gêneurs<nbsp>!
msgctxt "InstanceContentTextData:15404:0:0"
msgid "Cut through these pests!"
msgstr "Порубим этих гадов!"

#. ja: この凶々しい気配……見つけたぞ、大妖異リリス！
#. de: Diese verhängnisvolle Aura ... Das ist Lilith!
#. fr: Cette aura délétère... C'est Lilith<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15405:0:0"
msgid "I've felt that insidious aura before...<br>Lilith is here!"
msgstr "Я уже чувствовал эту скверную ауру...<br>Лилит здесь!"

#. ja: ええい、邪魔が入りおったか！<br>少々、早いが……儀式を始めるとしよう。
#. de: Wer wagt es, mich zu stören? Es ist etwas früh, doch das Ritual soll beginnen!
#. fr: Des intrus<nbsp>? Tant pis, que le rituel commence<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15406:0:0"
msgid "Meddlesome vermin! The vessel is mine!<br>The alignment is not perfect...but it shall suffice."
msgstr "Назойливые твари! Сосуд будет моим!<br>Схождение не идеально... но сойдёт."

#. ja: まずい、あの光は……！<br>アリアの身体を、強引に乗っ取るつもりだ！
#. de: Dieses Licht ...! Das ist nicht gut. Sie will Aryas Körper mit Gewalt über<shy>nehmen!
#. fr: Cette lumière... Ça craint, elle est en train de s'emparer du corps d'Arya<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15407:0:0"
msgid "No! That light...<br>She means to force the transference!"
msgstr "Нет! Этот свет...<br>Она хочет насильно переселить душу!"

#. ja: 情報どおり、毒を使ってきたか……！<br><split " " 1><string $gs1></split>、毒消しを使え！
#. de: Sie setzt Gift ein! Genau davor hat uns Yayake gewarnt. <split " " 1><string $gs1></split>, verwende Gegengift!
#. fr: Du poison, comme prévu... <split " " 1><string $gs1></split>, sers-toi de tes antidotes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15408:0:0"
msgid "Venom. Just as we anticipated.<br>Now's the time to use that antidote!"
msgstr "Яд. Как и ожидали.<br>Самое время воспользоваться противоядием!"

#. ja: ぐうっ……忌々しき、人の子よ……。<br>我が死の咢（あぎと）の餌食となるがよい！
#. de: Grrr ... Verdammt sollt ihr sein, Sterbliche! Ich werde mich an euch laben!
#. fr: Grrr... Méprisables mortels... Je vais prendre plaisir à dévorer vos âmes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15409:0:0"
msgid "\\<hiss> Wretched mortals...<br>I will sup upon the marrow of your souls!"
msgstr "<i>Шипит...</i> Жалкие смертные...<br>Я упьюсь костным мозгом ваших душ!"

#. ja: この悪寒……ランバードのときと同じだ。<br>気をつけろ、何か仕掛けてくるぞ！
#. de: Diese Kälte ... es ist wie bei Lambard ... Sei vorsichtig, sie bereitet etwas vor!
#. fr: J'ai un mauvais pres<shy>sen<shy>ti<shy>ment, comme face à Lambard... Fais attention, elle prépare un sale coup<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15410:0:0"
msgid "Do you feel that chill!?<br>It was the same with Lambard..."
msgstr "Чувствуешь холод?!<br>С Ламбаром было то же самое..."

#. ja: おのれ、おのれ……人の子め！<br>永きにわたる我が計画……ここで終わらせはせぬ！
#. de: Ihr seid nichts als Ungeziefer! Ihr werdet meine Pläne nicht durchkreuzen!
#. fr: Infâmes vermines humaines... Je ne vous laisserai pas contrecarrer mes plans<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15411:0:0"
msgid "For centuries have I planned this moment!<br>Your skulls will adorn my throne!"
msgstr "Столетиями я ждала этого мига!<br>Ваши черепа украсят мой трон!"

#. ja: 得意技をかわされたのが、だいぶ効いてるな！<br>この調子で、たたみかけるぞ！
#. de: Unsere Techniken zeigen Wirkung! Wir müssen sie weiter unter Druck setzen!
#. fr: Elle est vexée qu'on ait déjoué sa botte secrète... Elle n'a pas fini d'être déçue<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15412:0:0"
msgid "Our failure to perish appears to have upset her.<br>Keep wearing her down!"
msgstr "Похоже, ей не понравилось, что мы не умерли.<br>Продолжаем теснить её!"

#. ja: 思い上がるな……人の子よ！<br>出でよ、獄炎の灼火！　この者どもを焼きつくせ！
#. de: Bildet euch nicht zu viel ein! Meine Flammen des Nichts werden euch verzehren!
#. fr: Misérables mortels, votre arrogance vous perdra<nbsp>! Feu des ténèbres, consume ces avortons<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15413:0:0"
msgid "\\<hiss> You think me beaten?<br>Infernal flames of the void! Consume these worms!"
msgstr "<i>Шипит...</i> Думаете, я побеждён?<br>Адское пламя Пустоты! Сожги этих червей!"

#. ja: これは、ランバードが使った炎術……！？<br>いや……あれとは比べものにならない魔力だぞ！
#. de: Diese Technik ähnelt der von Lambard ... aber sie ist viel, viel mächtiger!
#. fr: C'est le sort qu'a utilisé Lambard<nbsp>? Non... c'est une version bien plus puissante<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15414:0:0"
msgid "She summons fiery spheres as did Lambard!<br>No...this is worse. So much worse."
msgstr "Она призывает огненные сферы, как Ламбар!<br>Нет... Всё гораздо хуже. Намного хуже."

#. ja: クソッ…………救えないのか……！
#. de: Verdammt ... Ich kann Arya nicht ... retten ...!
#. fr: Argh... Non... Arya...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15415:0:0"
msgid "Dammit...<br>Arya...forgive me..."
msgstr "Проклятье...<br>Арья... прости меня..."

#. ja: おのれ、おのれ……おのれェーーッ！<br>かつて我を陥れた者どもの……人の子の罪を、赦しはせん！
#. de: Ihr verdammten Sterblichen! Ihr sollt für das büßen, was ihr mir angetan habt!
#. fr: Mourez... Mourez, tous autant que vous êtes<nbsp>!!! Insolents humains... Vous qui m'avez trahie par le passé... Vous allez payer pour vos crimes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15416:0:0"
msgid "Sniveling...pestilent...MAGGOTS!<br>All the children of man shall suffer for mine imprisonment!"
msgstr "Нытики... гнусные... ЧЕРВИ!<br>Все люди ответят за то, что заточили меня!"

#. ja: もう少しだ！<br>リリスを倒して、アリアを救うんだ！
#. de: Sie ist fast am Ende! Geben wir ihr den Rest und retten Arya!
#. fr: C'est bientôt terminé... Arya, tiens bon, on va te sortir de là<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15417:0:0"
msgid "Victory is in our grasp!<br>Let us slay this monster and take Arya home!"
msgstr "Победа близка!<br>Убьём чудовище и вернём Арью домой!"

#. ja: くっくっく……新たな器を得て、我は自由の身となった！<br>かつて我を陥れた、人の子の住まう地に、これより復讐を果たさん！
#. de: Ohoho! Das perfekte Gefäß ist endlich mein! Nun werden alle Sterblichen meine Rache zu spüren bekommen!
#. fr: Ah... Enfin... Enfin libre<nbsp>! Avec ce nouveau corps, plus rien ne pourra m'arrêter<nbsp>! Ces chétifs humains vont regretter de m'avoir trahie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15419:0:0"
msgid "\\<hiss> Yes, the power... I am born anew!<br>I shall cast your kind into pits of vilest torment!"
msgstr "<i>Шипит...</i> Да, эта сила... Я возродился!<br>Я брошу ваш род в пучины ужаснейших мучений!"

#. ja: あれは……！<br><split " " 1><string $gs1></split>、キツいのがくるぞッ！
#. de: Was ist das ...? <split " " 1><string $gs1></split>, nimm dich in Acht, das sieht gefährlich aus!
#. fr: Qu'est-ce que... Fais gaffe, <split " " 1><string $gs1></split>, ces trucs ont l'air dangereux<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15420:0:0"
msgid "<split \" \" 1><string $gs1></split>!<br>Something wicked this way falls!"
msgstr "<split \" \" 1><string $gs1></split>!<br>Сейчас на тебя рухнет нечто ужасное!"

#. ja: 儀式の進行度
#. de: Fortschritt des Rituals
#. fr: Avancement de la cérémonie
msgctxt "InstanceContentTextData:15421:0:0"
msgid "Ritual progress"
msgstr "Прогресс ритуала"

#. ja: 格納区画の突破
#. de: Den Lagerkomplex sichern
#. fr: Franchir le secteur de stockage
msgctxt "InstanceContentTextData:15500:0:0"
msgid "Clear the storage compound"
msgstr "Зачистить складской комплекс"

#. ja: 魔導マグナローダーの撃破
#. de: Magna Rotula zerstören
#. fr: Vaincre le magna rouleur magitek
msgctxt "InstanceContentTextData:15501:0:0"
msgid "Dismantle the magna roader"
msgstr "Уничтожить магитехнический тягач"

#. ja: 実験区画の突破
#. de: Das Testgelände sichern
#. fr: Franchir le secteur des tests
msgctxt "InstanceContentTextData:15502:0:0"
msgid "Clear the testing compound"
msgstr "Зачистить испытательный комплекс"

#. ja: 実験体ナンバーXXIVの撃破
#. de: Experiment Nummer XXIV besiegen
#. fr: Vaincre le sujet expérimental Numéro XXIV
msgctxt "InstanceContentTextData:15503:0:0"
msgid "Defeat Subject Number XXIV"
msgstr "Победить подопытного № XXIV"

#. ja: 中枢区画の突破
#. de: Den Zentralbereich sichern
#. fr: Franchir le secteur central
msgctxt "InstanceContentTextData:15504:0:0"
msgid "Clear the central compound"
msgstr "Зачистить центральный комплекс"

#. ja: 氷属性、雷属性エーテル充填……<br>バリアチェンジ！
#. de: Eis- und Blitz-Äther aufgeladen ... Barrierewechsel!
#. fr: Remplissage d'éther de glace et de foudre...<br>Change-Barrière<nbsp>!
msgctxt "InstanceContentTextData:15505:0:0"
msgid "My cup runneth over with lightning and ice!"
msgstr "Моя чаша полна молний и льда!"

#. ja: 雷属性、火属性エーテル充填……<br>バリアチェンジ！
#. de: Blitz- und Feuer-Äther aufgeladen ... Barrierewechsel!
#. fr: Remplissage d'éther de feu et de foudre...<br>Change-Barrière<nbsp>!
msgctxt "InstanceContentTextData:15506:0:0"
msgid "My cup runneth over with fire and lightning!"
msgstr "Моя чаша полна огня и молний!"

#. ja: 火属性、氷属性エーテル充填……<br>バリアチェンジ！
#. de: Feuer- und Eis-Äther aufgeladen ... Barrierewechsel!
#. fr: Remplissage d'éther de feu et de glace...<br>Change-Barrière<nbsp>!
msgctxt "InstanceContentTextData:15507:0:0"
msgid "My cup runneth over with ice and fire!"
msgstr "Моя чаша полна льда и огня!"

#. ja: 属性バランス崩壊、エーテルベント解放……<br>オーバーフロー！
#. de: Balance bricht zusammen ... Ätherbeugung aktivieren - Überlastung!
#. fr: Équilibre élémentaire rompu<nbsp>! Relâchement d'éther...<br>Trop-plein<nbsp>!
msgctxt "InstanceContentTextData:15508:0:0"
msgid "Let the balance be shattered and all fall to ruin!"
msgstr "Пусть равновесие рухнет, а всё вокруг обратится в прах!"

#. ja: ククク、馬鹿め、その性能試験場は袋小路よ……！<br>我が作品「インフェルノ」で潰してくれる！
#. de: Hehehe ... Sackgasse! Nun wird euch mein Inferno vernichten!
#. fr: Hin hin hin<nbsp>! Imbéciles<nbsp>! C'est un cul-de-sac<nbsp>! Je vais vous écrabouiller comme de la vermine avec mon joli Inferno<nbsp>!
msgctxt "InstanceContentTextData:15509:0:0"
msgid "What fortune to receive such a promising test subject..."
msgstr "Какая удача — такой многообещающий подопытный..."

#. ja: 待たせたな、私の可愛い「インフェルノ」……<br>お薬の時間だぞ……？
#. de: So, mein Guter ... Zeit für die Medizin, hm?
#. fr: Oh, mon petit Inferno, c'est l'heure de ton petit remontant<nbsp>!
msgctxt "InstanceContentTextData:15510:0:0"
msgid "This way, little one, this way. Time for your medicine..."
msgstr "Сюда, малыш, сюда. Пора принимать лекарство..."

#. ja: ええい、やられたというのか……。<br>しかし、データは十分に記録できた……脱出する！
#. de: Wie hat man dich nur zugerichtet ... Aber die Daten sind ausreichend! Hehehe!
#. fr: Si vous croyez vraiment avoir gagné, vous vous trompez<nbsp>! Grâce à vous, j'ai recueilli plein de données utiles<nbsp>!<nbsp>... Nous nous reverrons<nbsp>!
msgctxt "InstanceContentTextData:15511:0:0"
msgid "Hm. Well. We have data enough. We will learn from this."
msgstr "Хм. Что ж. Данных достаточно. Учтём это."

#. ja: システム起動……<br>魔導V8エンジン点火！
#. de: System aktiv ... Magitek-Motor V-VIII zünden!
#. fr: Démarrage du système...<br>Allumage du moteur V8 magitek<nbsp>!
msgctxt "InstanceContentTextData:15512:0:0"
msgid "Systems nominal... Powering magitek engines..."
msgstr "Системы в норме... Запуск магитехнических двигателей..."

#. ja: スーパーチャージャー展開……<br>ニトロ投入……！
#. de: Superlader in Betrieb - Nitro einspeisen!
#. fr: Super chargeur en place... Injection de nitro-carburant magitek<nbsp>!
msgctxt "InstanceContentTextData:15513:0:0"
msgid "Deactivating limiters... Injecting ceruleum fuel additives..."
msgstr "Ограничители отключены... Впрыскиваю добавки к церулеуму..."

#. ja: 強制焼却システム起動……<br>総員退避……総員退避……！
#. de: Aktiviere Notverbrennung! Alle Mann zurückbleiben!
#. fr: Mise en marche du système d'incinération... Ordre à toutes les unités de se retirer<nbsp>!
msgctxt "InstanceContentTextData:15514:0:0"
msgid "Emergency restart! Systems unstable... Evacuate..."
msgstr "Аварийный перезапуск! Системы нестабильны... Эвакуация..."

#. ja: さあ、お薬のおかわりだ……。<br>思う存分、堪能するがいい！
#. de: Hier gibt's neue Medizin für dich ... Greif zu!
#. fr: Allez, un petit peu plus de sérum... Vous allez vous amusez, c'est moi qui vous le dis<nbsp>!
msgctxt "InstanceContentTextData:15515:0:0"
msgid "Have your fill, little one. My medicines are plentiful."
msgstr "Наедайся, малыш. Лекарств у меня в избытке."

#. ja: ガガガガガ……走行システムニ異常ヲ検知…<br>走行不能……走行不能……。
#. de: \<biep> Anomalie gefunden ...<br>System immobilisiert.
#. fr: Bvrrr... Anomalie détectée dans le système moteur... Déplacement impossible... Bvvrrrr....
msgctxt "InstanceContentTextData:15516:0:0"
msgid "Systems critical! Unable to execute Wild Speed Protocol..."
msgstr "Критическая ошибка системы! Протокол «Безумная скорость» недоступен..."

#. ja: 実験体ナンバーXXIV、敵性体を検知……！<br>魔法戦闘モード、起動……！
#. de: Feindliche Präsenz erkannt. Aktiviere Magie-Kampfmodus.
#. fr: Activation du sujet expérimental Numéro XXIV...<br>Détection d'intrus<nbsp>! Déclenchement du mode de combat magique<nbsp>!
msgctxt "InstanceContentTextData:15517:0:0"
msgid "Hostile presence detected. Subject Number XXIV, engaging arcane combat mode."
msgstr "Обнаружено враждебное существо. Подопытный № XXIV, запуск режима магического боя."

#. ja: 火属性エーテル充填、属性チャージャー起動……！
#. de: Beginne Aufladung von Feuer-Äther.
#. fr: Remplissage d'éther de feu<nbsp>! Activation du chargeur élémentaire<nbsp>!
msgctxt "InstanceContentTextData:15518:0:0"
msgid "Commencing fire aether loading."
msgstr "Начинаю загрузку огненного эфира."

#. ja: 氷属性エーテル充填、属性チャージャー起動……！
#. de: Beginne Aufladung von Eis-Äther.
#. fr: Remplissage d'éther de glace<nbsp>! Activation du chargeur élémentaire<nbsp>!
msgctxt "InstanceContentTextData:15519:0:0"
msgid "Commencing ice aether loading."
msgstr "Начинаю загрузку ледяного эфира."

#. ja: 雷属性エーテル充填、属性チャージャー起動……！
#. de: Beginne Aufladung von Blitz-Äther.
#. fr: Remplissage d'éther de foudre<nbsp>! Activation du chargeur élémentaire<nbsp>!
msgctxt "InstanceContentTextData:15520:0:0"
msgid "Commencing lightning aether loading."
msgstr "Начинаю загрузку эфир молний."

#. ja: システム復旧……。<br>火属性エーテル充填、属性チャージャー再起動……！
#. de: System wieder<shy>her<shy>gestellt. Beginne erneute Aufladung von Feuer-Äther.
#. fr: Restauration du système...<br>Remplissage d'éther de feu<nbsp>! Activation du chargeur élémentaire<nbsp>!
msgctxt "InstanceContentTextData:15521:0:0"
msgid "System restored. Recommencing fire aether loading."
msgstr "Система восстановлена. Возобновляю загрузку огненного эфира."

#. ja: システム復旧……。<br>氷属性エーテル充填、属性チャージャー再起動……！
#. de: System wieder<shy>her<shy>gestellt. Beginne erneute Aufladung von Eis-Äther.
#. fr: Restauration du système...<br>Remplissage d'éther de glace<nbsp>! Activation du chargeur élémentaire<nbsp>!
msgctxt "InstanceContentTextData:15522:0:0"
msgid "System restored. Recommencing ice aether loading."
msgstr "Система восстановлена. Возобновляю загрузку ледяного эфира."

#. ja: システム復旧……。<br>雷属性エーテル充填、属性チャージャー再起動……！
#. de: System wieder<shy>her<shy>gestellt. Beginne erneute Aufladung von Blitz-Äther.
#. fr: Restauration du système...<br>Remplissage d'éther de foudre<nbsp>! Activation du chargeur élémentaire<nbsp>!
msgctxt "InstanceContentTextData:15523:0:0"
msgid "System restored. Recommencing lightning aether loading."
msgstr "Система восстановлена. Возобновляю загрузку эфира молний."

#. ja: XXIVプロトコル起動、火属性攻撃を開始！
#. de: XXIV-Protokoll initiiert. Starte Feuer-Angriff.
#. fr: Protocole XXIV enclenché<nbsp>! Assaut de feu imminent<nbsp>!
msgctxt "InstanceContentTextData:15524:0:0"
msgid "XXIV Protocol initiated. Commencing fire attack."
msgstr "Протокол XXIV запущен. Начинаю огненную атаку."

#. ja: XXIVプロトコル起動、氷属性攻撃を開始！
#. de: XXIV-Protokoll initiiert. Starte Eis-Angriff.
#. fr: Protocole XXIV enclenché<nbsp>! Assaut de glace imminent<nbsp>!
msgctxt "InstanceContentTextData:15525:0:0"
msgid "XXIV Protocol initiated. Commencing ice attack."
msgstr "Протокол XXIV запущен. Начинаю ледяную атаку."

#. ja: XXIVプロトコル起動、雷属性攻撃を開始！
#. de: XXIV-Protokoll initiiert. Starte Blitz-Angriff.
#. fr: Protocole XXIV enclenché<nbsp>! Assaut de foudre imminent<nbsp>!
msgctxt "InstanceContentTextData:15526:0:0"
msgid "XXIV Protocol initiated. Commencing lightning attack."
msgstr "Протокол XXIV запущен. Начинаю атаку молниями."

#. ja: 敵性体の生存を確認。<br>リミッター解除、火属性エーテル最大出力……！
#. de: Deaktiviere Begrenzer. Setze Feuer-Äther-Kapazität auf höchste Stufe.
#. fr: Verrouillage des unités ennemies<nbsp>!<br>Désactivation immédiate du limiteur<nbsp>! Charge éthérée de feu, puissance maximale<nbsp>!
msgctxt "InstanceContentTextData:15527:0:0"
msgid "Inhibitors disengaged. Fire aether output level maximum."
msgstr "Противники ещё живы.<br>Ограничители сняты. Выход огненного эфира — максимум."

#. ja: 敵性体の生存を確認。<br>リミッター解除、氷属性エーテル最大出力……！
#. de: Deaktiviere Begrenzer. Setze Eis-Äther-Kapazität auf höchste Stufe.
#. fr: Verrouillage des unités ennemies<nbsp>!<br>Désactivation immédiate du limiteur<nbsp>! Charge éthérée de glace, puissance maximale<nbsp>!
msgctxt "InstanceContentTextData:15528:0:0"
msgid "Inhibitors disengaged. Ice aether output level maximum."
msgstr "Противники ещё живы.<br>Ограничители сняты. Выход ледяного эфира — максимум."

#. ja: 敵性体の生存を確認。<br>リミッター解除、雷属性エーテル最大出力……！
#. de: Deaktiviere Begrenzer. Setze Blitz-Äther-Kapazität auf höchste Stufe.
#. fr: Verrouillage des unités ennemies<nbsp>!<br>Désactivation immédiate du limiteur<nbsp>! Charge éthérée de foudre, puissance maximale<nbsp>!
msgctxt "InstanceContentTextData:15529:0:0"
msgid "Inhibitors disengaged. Lightning aether output level maximum."
msgstr "Противники ещё живы.<br>Ограничители сняты. Выход эфира молний — максимум."

#. ja: システムエラー発生……火属性オーバーフロー……！<br>戦闘システム制御不能、防衛、機能オフライン……！
#. de: Systemfehler: Feuer-Äther überladen. Kontrolle über Kampfsystem verloren. Abwehrfunktionen inaktiv.
#. fr: Erreur système... Trop-plein d'éther de feu<nbsp>!<br>Perte de contrôle du système de combat<nbsp>! Fonctions de défense hors ligne<nbsp>!
msgctxt "InstanceContentTextData:15530:0:0"
msgid "Warning: fire aether overload. Combat system throttled; defensive functions impaired."
msgstr "Внимание: перегрузка огненного эфира. Боевая система ограничена, защитные функции нарушены."

#. ja: システムエラー発生……氷属性オーバーフロー……！<br>戦闘システム制御不能、防衛、機能オフライン……！
#. de: Systemfehler: Eis-Äther überladen. Kontrolle über Kampfsystem verloren. Abwehrfunktionen inaktiv.
#. fr: Erreur système... Trop-plein d'éther de glace<nbsp>!<br>Perte de contrôle du système de combat<nbsp>! Fonctions de défense hors ligne<nbsp>!
msgctxt "InstanceContentTextData:15531:0:0"
msgid "Warning: ice aether overload. Combat system throttled; defensive functions impaired."
msgstr "Внимание: перегрузка ледяного эфира. Боевая система ограничена, защитные функции нарушены."

#. ja: システムエラー発生……雷属性オーバーフロー……！<br>戦闘システム制御不能、防衛、機能オフライン……！
#. de: Systemfehler: Blitz-Äther überladen. Kontrolle über Kampfsystem verloren. Abwehrfunktionen inaktiv.
#. fr: Erreur système... Trop-plein d'éther de foudre<nbsp>!<br>Perte de contrôle du système de combat<nbsp>! Fonctions de défense hors ligne<nbsp>!
msgctxt "InstanceContentTextData:15532:0:0"
msgid "Warning: lightning aether overload. Combat system throttled; defensive functions impaired."
msgstr "Внимание: перегрузка эфира молний. Боевая система ограничена, защитные функции нарушены."

#. ja: 属性チャージャー……<br>検証、完了……改善を要す、る……！
#. de: Äther-Aufladungstest abgeschlossen<nbsp>... Überarbeitung<nbsp>... notwendig<nbsp>...
#. fr: Analyse du chargeur élémentaire terminée...<br>Révision urgente... in<shy>dis<shy>pen<shy>sa<shy>ble...
msgctxt "InstanceContentTextData:15533:0:0"
msgid "Aether loading test complete... Urgent redesign required..."
msgstr "Проверка загрузки эфира завершена... Требуется срочная переработка..."

#. ja: ムソウサイを倒せ！
#. de: Besiege Musosai!
#. fr: Vainquez Musosai<nbsp>!
msgctxt "InstanceContentTextData:15600:0:0"
msgid "Defeat Musosai"
msgstr "Победить Мусосая"

#. ja: 我が剣気、雪風超えて吹きすさべ！<br>肌に感じよ、「必殺剣　凍」！！
#. de: Mein Katana entfesselt einen Schneesturm und die Kälte wird wie eine Klinge in deine Haut schneiden ... Hissatsu: To!
#. fr: Mon katana déchaîne des vents plus impétueux que l'ouragan d'hiver<nbsp>! Ils te mordront la peau<nbsp>! Hissatsu<nbsp>! Tô<nbsp>!
msgctxt "InstanceContentTextData:15601:0:0"
msgid "My blade scours as a snowstorm!"
msgstr "Мой клинок хлещет, как снежная буря!"

#. ja: 凍れる剣気、咲き誇りて花となれ！<br>刮目せよ、「必殺剣　菊」！！
#. de: Die klirrende Kälte erblüht auf meiner Klinge prächtig wie eine Chrysantheme ... Hissatsu: Kiku!
#. fr: De ma lame gelée éclate la pleine floraison<nbsp>! Ouvre grand les yeux<nbsp>! Hissatsu<nbsp>! Kiku<nbsp>!
msgctxt "InstanceContentTextData:15602:0:0"
msgid "Frozen blade, come into bloom!"
msgstr "Ледяной клинок, расцвети во всей красе!"

#. ja: 動の剣、究めれば風と成らん！<br>耐え抜けよ、剣技「嵐」！
#. de: Das Flirren meiner Klinge wird zum Heulen des Windes! Widerstehe dem Sturm ... Arashi!
#. fr: Maîtrisée, la lame fougueuse appelle les rafales hurlantes<nbsp>! Résiste à la tempête<nbsp>! Arashi<nbsp>!
msgctxt "InstanceContentTextData:15603:0:0"
msgid "Blade of fury, as one with the wind!"
msgstr "Клинок ярости сольётся с ветром!"

#. ja: 静の剣、究めれば舞いと成らん！<br>見るがいい、剣技「舞扇」！！
#. de: Ein wahrer Meister lässt das Katana leise durch die Luft tanzen und versetzt den Gegner vor dessen Tod in Staunen ... Maiogi!
#. fr: Maîtrisée, la lame tranquille se transforme en éventails dansant dans les airs<nbsp>! Admire leur splendeur<nbsp>! Maiôgi<nbsp>!
msgctxt "InstanceContentTextData:15604:0:0"
msgid "Blade of calm, graceful as dance!"
msgstr "Спокойный клинок грациозен, словно танец!"

#. ja: 舞えよ扇、吹けよ嵐！
#. de: Das Katana tanzt inmitten des Sturms ... Arashi no Maiogi!
#. fr: Une lame peut être fougueuse et tranquille à la fois<nbsp>! Arashi<nbsp>! Maiôgi<nbsp>!
msgctxt "InstanceContentTextData:15605:0:0"
msgid "The storm amidst the calm!"
msgstr "Буря среди тишины!"

#. ja: 咲けよ菊花、荒れよ嵐！
#. de: Der Sturm zerstreut die Blütenblätter ... Arashi no Kiku!
#. fr: La tempête disperse les pétales<nbsp>! Hissatsu<nbsp>! Kiku<nbsp>! Arashi<nbsp>!
msgctxt "InstanceContentTextData:15606:0:0"
msgid "Storms gather, blossoms scatter!"
msgstr "Буря налетает, лепестки разлетаются!"

#. ja: 以前のようなお遊びとは違う、真剣勝負じゃ……。
#. de: Dieses Duell wird anders als deine bisherigen Übungen ...
#. fr: Nous nous affrontons pour la seconde fois, mais ce duel sera différent du précédent.
msgctxt "InstanceContentTextData:15607:0:0"
msgid "Unlike before, this is no game."
msgstr "В этот раз всё всерьёз. Никаких игр."

#. ja: 勝敗は、どちらかが死ぬまで決まらんぞ……。
#. de: Es endet erst, wenn einer von uns beiden tot am Boden liegt!
#. fr: Aujourd'hui, le vainqueur ne sera décidé que lorsque son adversaire passera à trépas...
msgctxt "InstanceContentTextData:15608:0:0"
msgid "It ends only when one of us lies dead."
msgstr "Бой кончится, только когда один из нас падёт замертво."

#. ja: いざ、勝負！
#. de: Verteidige dich, <split " " 1><string $gs1></split>!
#. fr: En garde<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15609:0:0"
msgid "Defend yourself, <split \" \" 1><string $gs1></split>!"
msgstr "Защищайся, <split \" \" 1><string $gs1></split>!"

#. ja: がはっ……。
#. de: Grrargh ...
#. fr: Grrargh...
msgctxt "InstanceContentTextData:15610:0:0"
msgid "\\<grunt>"
msgstr "<i>Гр-рх!</i>"

#. ja: こ、こんなときに……<br>病に負けるわけには……いかん。
#. de: Ausgerechnet jetzt ... Meine Krankheit darf dieses Duell nicht entscheiden ...
#. fr: Je... Je ne peux pas laisser la maladie m'emporter...
msgctxt "InstanceContentTextData:15611:0:0"
msgid "N-Not now... Not to illness..."
msgstr "Н-не сейчас... Неужели болезнь меня одолеет..."

#. ja: ハァハァ……まだまだ。<br>ワシは……まだまだやれるぞ！
#. de: \<keuch> \<keuch> Nein, noch nicht ... Ich kann noch ... weitermachen ...
#. fr: (souffle)... (souffle)... Mon heure n'est pas venue... Je peux encore me battre<nbsp>!
msgctxt "InstanceContentTextData:15612:0:0"
msgid "\\<pant> I am not finished yet..."
msgstr "<i>Тяжело дышит...</i> Я ещё не закончил..."

#. ja: お主の本気はその程度か！？<br>ワシを倒さねば、死ぬのはそちらだぞ！
#. de: Ist das wirklich dein ganzes Können?! Ich warne dich, wenn du mich nicht besiegst, dann musst du sterben!
#. fr: Est-ce là ta limite<nbsp>!? Si tu ne triomphes pas de moi, tu mourras<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:15613:0:0"
msgid "Fight, <split \" \" 1><string $gs1></split>! Fight...or you <i>will</i> die!"
msgstr "Сражайся, <split \" \" 1><string $gs1></split>! Сражайся... или <i>умрёшь</i>!"

#. ja: ごふっ……。
#. de: \<hust> ...
#. fr: Ourgh...
msgctxt "InstanceContentTextData:15614:0:0"
msgid "Ungh..."
msgstr "Уф..."

#. ja: よくぞここまで……成長したものだ……。
#. de: Du hast es weit gebracht, <split " " 1><string $gs1></split> ...
#. fr: Je te félicite... <split " " 1><string $gs1></split>. Tu as atteint des sommets...
msgctxt "InstanceContentTextData:15615:0:0"
msgid "How strong you have grown, my pupil."
msgstr "Как же ты окреп, мой ученик."

#. ja: 嬉しいぞ……遂に修行が完遂する……。
#. de: Das freut mich ... Damit ist deine Ausbildung abgeschlossen ...
#. fr: Cela me ravit... Ton en<shy>traî<shy>ne<shy>ment touche enfin à sa fin...
msgctxt "InstanceContentTextData:15616:0:0"
msgid "Your training shall soon be complete. I am glad."
msgstr "Скоро твоё обучение завершится. И я этому рад."

#. ja: ワシからの……最大の試練……耐えてみせよ！
#. de: Zeige mir, dass du in der Lage dazu bist, meine letzte Prüfung zu bestehen!
#. fr: Montre-moi si tu es capable de résister à ma prochaine attaque<nbsp>!
msgctxt "InstanceContentTextData:15617:0:0"
msgid "Now, for my greatest test..."
msgstr "А теперь — моё величайшее испытание..."

#. ja: ワシがムソウサイと呼ばれた所以……<br>今こそ見せてくれる、秘剣「無双刃」！！
#. de: Ich zeige dir, woher der Name Musosai stammt ... Musojin!
#. fr: Elle m'a valu le nom que je porte aujourd'hui... Musôjin<nbsp>!
msgctxt "InstanceContentTextData:15618:0:0"
msgid "The technique for which I earned my name!"
msgstr "Вот техника, благодаря которой я получил своё имя!"

#. ja: 滅　殺　！
#. de: Und nun ... stirb!
#. fr: Que les multitudes t'emportent<nbsp>!
msgctxt "InstanceContentTextData:15619:0:0"
msgid "Death comes!"
msgstr "Смерть близка!"

#. ja: よくぞ耐えた！！
#. de: Du hast überlebt! Beeindruckend!
#. fr: Tu y as survécu<nbsp>! Bravo<nbsp>!
msgctxt "InstanceContentTextData:15620:0:0"
msgid "Well done, my pupil!"
msgstr "Молодец, ученик!"

#. ja: これで最期じゃ……。<br>ワシのすべてをお主に叩き込もう！
#. de: Der Kampf nähert sich dem Ende, doch er endet erst, wenn einer von uns tot ist!
#. fr: Je t'ai enseigné tout ce que je savais... Mes assauts seront désormais implacables. Seule la victoire marquera leur fin<nbsp>!
msgctxt "InstanceContentTextData:15621:0:0"
msgid "We are come to the end. I shall bring my all to bear, and so shall you."
msgstr "Мы подошли к концу. Я выложусь до последнего — и ты тоже."

#. ja: <split " " 1><string $gs1></split>よ……。<br>お主も……ワシにすべてを叩き込むのじゃ！
#. de: <split " " 1><string $gs1></split>, zeig mir alles, was du gelernt hast und bekämpfe mich mit all deiner Macht!
#. fr: Toi aussi, <split " " 1><string $gs1></split><nbsp>! Révèle l'étendue de ta puissance<nbsp>! Donne-moi tout ce que tu as<nbsp>!
msgctxt "InstanceContentTextData:15622:0:0"
msgid "Hold nothing back. Do you hear me?"
msgstr "Ничего не сдерживай. Ты слышишь меня?"

#. ja: この技は、剣気によって、<br>周囲に、旋風を発生させるのじゃ！
#. de: Diese Technik beschwört mit der Kraft des Katana einen Sturm herauf.
#. fr: Cette technique puise dans l'énergie de ton katana et fait naître des lames de vent autour de ton ennemi<nbsp>!
msgctxt "InstanceContentTextData:15623:0:0"
msgid "Drawing upon my blade's power, I shall call forth violent winds."
msgstr "Силой моего клинка я призову свирепые ветра."

#. ja: さて、お主に耐えられるかどうか……<br>ワシに、修行の成果を見せてくれ……。
#. de: Zeig mir das Ergebnis deines Trainings und überlebe diesen Angriff!
#. fr: Essaie d'y survivre<nbsp>!
msgctxt "InstanceContentTextData:15624:0:0"
msgid "Show me the fruit of your training, and weather it."
msgstr "Покажи, чему научился, и выдержи этот натиск."

#. ja: <split " " 1><string $gs1></split>！<br>あと一歩だというのに……倒れてしまうとは……。
#. de: <split " " 1><string $gs1></split>! Du warst fast so weit ...
#. fr: <split " " 1><string $gs1></split><nbsp>! Tu y étais presque...
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15625:0:0"
msgid "No, <split \" \" 1><string $gs1></split>! You cannot fall...not when you are so close!"
msgstr "Нет, <split \" \" 1><string $gs1></split>! Ты не можешь пасть... не теперь, когда так близок к цели!"

#. ja: 謎の斧術士たちを倒せ！
#. de: Die maskierten Marodeure besiegen
#. fr: Vainquez Zoenwyrn et ses compagnons<nbsp>!
msgctxt "InstanceContentTextData:15700:0:0"
msgid "Defeat the masked marauders."
msgstr "Одолейте замаскированных мародёров."

#. ja: ドルゴノを倒せ！
#. de: Dorgono besiegen
#. fr: Vainquez Dorgono<nbsp>!
msgctxt "InstanceContentTextData:15701:0:0"
msgid "Defeat Dorgono."
msgstr "Одолейте Доргоно."

#. ja: 戦士隊の力、見定めてやろう！
#. de: Dann zeigt mal, was ihr könnt, Krieger!
#. fr: Montrez-nous de quoi vous êtes capables, guerriers<nbsp>!
msgctxt "InstanceContentTextData:15702:0:0"
msgid "Come, warriors! Show us your mettle!"
msgstr "Ну же, воины! Покажите, на что способны!"

#. ja: オラたちに挑んだこと、後悔させてやるぞ！
#. de: Ihr werdet eure Kühnheit bald bereuen!
#. fr: Ha<nbsp>! Vous allez regretter de nous avoir défiés<nbsp>!
msgctxt "InstanceContentTextData:15703:0:0"
msgid "With pleasure! You will rue the day you crossed blades with us!"
msgstr "С радостью! Вы ещё пожалеете, что скрестили с нами клинки!"

#. ja: どんなもんだ！<br>戦士隊の力、思い知ったか！
#. de: Na? Jetzt kapiert, dass mit uns Kriegern nicht zu spaßen ist?
#. fr: Alors<nbsp>? Vous avez compris, maintenant<nbsp>!? Vous êtes pas de taille face aux guerriers<nbsp>!
msgctxt "InstanceContentTextData:15704:0:0"
msgid "Come now, is that all you marauders can muster?"
msgstr "Ну и ну! Это всё, на что вы, мародёры, способны?"

#. ja: ぐはっ……くそっ、このオラが……<br>負けちまうなんて……。
#. de: Das ... darf doch nicht wahr sein!
#. fr: Urgh... C'est pas possible... J'peux pas perdre contre de simples maraudeurs...
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15705:0:0"
msgid "Gah! I'm afraid my strength is spent... Forgive me, <split \" \" 1><string $gs1></split>."
msgstr "Кха... Боюсь, силы меня покинули... Прости меня, <split \" \" 1><string $gs1></split>."

#. ja: くっ、もう体が持たない、<br>足を引っ張ってすまぬ……。
#. de: Ich kann nicht mehr, Leute!
#. fr: P-pardonnez-moi... (souffle)... J-je suis à bout de forces... (souffle)...
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15706:0:0"
msgid "They are too strong. My apologies, <split \" \" 1><string $gs1></split>."
msgstr "Они слишком сильны. Прости, <split \" \" 1><string $gs1></split>."

#. ja: つ、強い……！<br>戦士の力が、これほどまでとは……。
#. de: Unglaublich, diese Stärke!
#. fr: Quelle force<nbsp>!<nbsp>... C-c'est incroyable<nbsp>!
msgctxt "InstanceContentTextData:15707:0:0"
msgid "We're...we're losing? How can this be?"
msgstr "Мы... проигрываем? Да как такое возможно?"

#. ja: ウォォォォォ……！
#. de: Grrraaahhh!
#. fr: GrrrAAaarRrr<nbsp>!
msgctxt "InstanceContentTextData:15708:0:0"
msgid "Raaaaaargh!"
msgstr "Ррррра-а-а-ар!"

#. ja: 彼女は野獣の如く、闘争本能をむきだしにしている！<br>全力で立ち向かわなければ、止めることはできんぞ！！
#. de: Die wütet wie ein wildes Tier!<br>Gib alles!
#. fr: Sa rage est en train de la transformer en véritable bête sauvage<nbsp>! Nous devons l'arrêter avant qu'il ne soit trop tard<nbsp>!
msgctxt "InstanceContentTextData:15709:0:0"
msgid "I fear she is lost to her inner beast now. We must do whatever it takes to stop her."
msgstr "Боюсь, она уже не в силах сдержать своего зверя. Нужно остановить её любой ценой!"

#. ja: ふう……なんとか、鎮めることができたな。
#. de: Genug, <split " " 1><string $gs1></split>. Sie scheint sich beruhigt zu haben.
#. fr: Ouf<nbsp>! Nous avons réussi à calmer sa fureur...
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15710:0:0"
msgid "Stay your blade, <split \" \" 1><string $gs1></split>. She appears to have calmed down."
msgstr "Опусти оружие, <split \" \" 1><string $gs1></split>. Похоже, она успокоилась."

#. ja: くっ、もうだめだ、<br>彼女を止められない……。
#. de: Ich muss passen, der bin ich nicht gewachsen.
#. fr: Argh<nbsp>! Elle est beaucoup trop forte pour moi...
msgctxt "InstanceContentTextData:15711:0:0"
msgid "It's no use... We cannot stop her..."
msgstr "Бесполезно... Нам её не остановить..."

#. ja: グガガガガッ……！
#. de: Uwoooaaahhhrrr!
#. fr: UwOoaAAhhhRRr<nbsp>!!!
msgctxt "InstanceContentTextData:15712:0:0"
msgid "No one will stand in my way! No one!!!"
msgstr "Никому меня не остановить! Никому!!!"

#. ja: 「原初の魂」を震わせ、大地を隆起させたのか！？<br>恐るべし技だ、避けなければ危険だぞ！
#. de: Sie hat die Erde mit ihrer Urkraft aufgeworfen!<br>Sieh dich vor!
#. fr: Sa rage est si grande qu'elle se propage à travers la terre<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15713:0:0"
msgid "The very earth beneath her trembles! Fall back, <split \" \" 1><string $gs1></split>."
msgstr "Даже земля под ней дрожит! Отступай, <split \" \" 1><string $gs1></split>!"

#. ja: ガォググガガガァァァァ……！
#. de: Grrruuuaaarrr!
#. fr: GrrRroOOooOAArrr<nbsp>!!!!
msgctxt "InstanceContentTextData:15714:0:0"
msgid "I will rend the flesh from your bones!"
msgstr "Я вырву плоть из ваших костей!"

#. ja: 「原初の魂」を、燃え上がらせて放ってきたぞ！<br>避けることはできん、守りを固めるのだ！
#. de: Die Urkraft ist völlig entfesselt!<br>Jetzt hilft nur noch verteidigen und beten!
#. fr: Sa rage brûle d'un feu inextinguible<nbsp>! Protège-toi<nbsp>!
msgctxt "InstanceContentTextData:15715:0:0"
msgid "Brace yourself! I fear there is no escaping this onslaught!"
msgstr "Приготовься! Боюсь, от этой атаки не уйти!"

#. ja: シデンを倒せ！
#. de: Shiden besiegen
#. fr: Vainquez Shiden<nbsp>!
msgctxt "InstanceContentTextData:15800:0:0"
msgid "Defeat Shiden"
msgstr "Одолейте Сидэна."

#. ja: 攘夷派の侍たちを倒せ！
#. de: Ugetsus Samurai besiegen
#. fr: Vainquez les samouraïs isolationnistes<nbsp>!
msgctxt "InstanceContentTextData:15801:0:0"
msgid "Defeat the traitorous Sekiseigumi"
msgstr "Одолейте предателей из Сэкисэйгуми."

#. ja: シデンを倒せ！
#. de: Shiden besiegen
#. fr: Vainquez Shiden<nbsp>!
msgctxt "InstanceContentTextData:15802:0:0"
msgid "Defeat Shiden"
msgstr "Одолейте Сидэна."

#. ja: ウゲツ様より受け継ぎし技……<br>唸れ、微塵斬！
#. de: Meister Ugetsu hat mich viel gelehrt ... unter anderem diese Technik! Mijingiri!
#. fr: Maître Ugetsu m'a beaucoup appris... y compris une de ses techniques de combat<nbsp>! Mijin-giri<nbsp>!
msgctxt "InstanceContentTextData:15803:0:0"
msgid "Let me show you something I learned from Lord Ugetsu."
msgstr "Позвольте показать вам, чему я научился у господина Угэцу."

#. ja: 我が真なる微塵斬で切り刻まれよ！
#. de: Mein Mijingiri wird dich in Stücke schneiden!
#. fr: Mon Mijin-giri vous taillera en pièces<nbsp>!
msgctxt "InstanceContentTextData:15804:0:0"
msgid "Bleed from a thousand cuts!"
msgstr "Истеку кровью от тысячи порезов!"

#. ja: 研ぎ澄まされし刃の一閃……<br>貫け、雷光突き！
#. de: Meine scharfe Klinge fährt herab und trifft meine Feinde wie ein Blitz ... Gewitterstoß!
#. fr: Ma lame est si aiguisée que son éclat vous transpercera<nbsp>! Raikô-zuki<nbsp>!
msgctxt "InstanceContentTextData:15805:0:0"
msgid "My brilliant blade pierces all!"
msgstr "Мой сверкающий клинок пронзит любого!"

#. ja: 裏切り者に負けるとは……無念。
#. de: Besiegt durch einen Verräter ... I-Ich habe mein Gesicht ... verloren ...
#. fr: J'ai perdu... face à ces traîtres...
msgctxt "InstanceContentTextData:15806:0:0"
msgid "No...  I cannot lose... Not to a traitor..."
msgstr "Нет... Я не могу проиграть... Не предателю..."

#. ja: やれやれ、私の手で君たちを葬ることになるとはな……。<br>やむを得ない……斬る。
#. de: Schade, dass es so kommen musste ... Nun muss ich euch aus dem Weg räumen!
#. fr: Que c'est pénible... Je ne pensais pas avoir à vous éliminer moi-même. Mais peu importe, vous mourrez ici ce soir.
msgctxt "InstanceContentTextData:15807:0:0"
msgid "I knew that we needed to be rid of you, but I had not expected to do the deed myself."
msgstr "Я знал, что от вас нужно избавиться, но не думал, что придётся самому этим заняться."

#. ja: マコトよ、君のことは買っていたんだがね、<br>残念でならないよ
#. de: Makoto, dich habe ich immer gemocht. Glaube mir bitte, dass ich deinen Tod bedauern werde.
#. fr: J'avais de l'affection pour toi, Makoto. C'est vraiment dommage que nous en soyons arrivés là.
msgctxt "InstanceContentTextData:15808:0:0"
msgid "You were my favorite, Makoto. This gives me no pleasure."
msgstr "Ты была моей любимицей, Макото. Мне это совсем не в радость."

#. ja: 副局長を……シデンさんを……尊敬していたのに……。
#. de: Shiden ... Dabei habe ich dich immer als Vorgesetzten respektiert ...
#. fr: Et moi du respect pour le vice-commandant que vous étiez... Shiden...
msgctxt "InstanceContentTextData:15809:0:0"
msgid "And I respected you, Shiden..."
msgstr "А ведь я тебя уважал, Сидэн..."

#. ja: 今からでも遅くはない……。<br>こちら側に、ウゲツ様の方につくのだ！
#. de: Es ist noch nicht zu spät. Schließe dich uns an, Makoto!
#. fr: Il n'est pas encore trop tard, Makoto. Rejoins-nous<nbsp>! Maître Ugetsu te montrera la voie<nbsp>!
msgctxt "InstanceContentTextData:15810:0:0"
msgid "It is not too late. Join me and swear fealty to Lord Ugetsu!"
msgstr "Ещё не поздно. Присоединяйся ко мне и поклянись в верности господину Угэцу!"

#. ja: 断る！　貴方のことは、見損なった！
#. de: Niemals! Ich habe mich in dir getäuscht!
#. fr: Hors de question<nbsp>! Je m'étais trompée sur vous<nbsp>!
msgctxt "InstanceContentTextData:15811:0:0"
msgid "Never! I will fight you to my dying breath!"
msgstr "Никогда! Я буду сражаться с тобой до последнего вздоха!"

#. ja: まったく、君というやつは……とんだじゃじゃ馬だ！
#. de: Pfff! Du bist stur und töricht wie ein Esel!
#. fr: Pff<nbsp>! Tu es têtue comme une mule<nbsp>!
msgctxt "InstanceContentTextData:15812:0:0"
msgid "Hmph, you did always have a stubborn streak. This time it will be the end of you."
msgstr "Хм, упрямства тебе всегда было не занимать. Но на этот раз оно тебя погубит."

#. ja: 邪魔立てした隊士たちのように、<br>大義のため、もっと早くに殺しておくべきだった！
#. de: Ich hätte euch früher aus dem Weg räumen sollen, so wie all die anderen, die unserem großen Ziel im Weg standen!
#. fr: J'aurais dû t'éliminer plus tôt pour réaliser mes ambitions, comme je l'ai fait avec les autres<nbsp>!
msgctxt "InstanceContentTextData:15813:0:0"
msgid "I should have killed you off long ago, as I did the others."
msgstr "Надо было прикончить тебя давным-давно, как и остальных."

#. ja: 暗殺された隊士も貴方が……？<br>おのれ、殺された仲間のためにも、私はお前を許さない！
#. de: D-Die anderen ...? Du hast unsere Kameraden getötet? Du Dreckskerl!
#. fr: L-les autres...<nbsp>? Sale charogne<nbsp>! C'est toi qui as tué nos camarades<nbsp>! Je ne te le pardonnerai jamais<nbsp>!
msgctxt "InstanceContentTextData:15814:0:0"
msgid "All those assassinations were your doing!? Damn you, Shiden!"
msgstr "Все эти убийства — твоих рук дело!? Проклятье, Сидэн!"

#. ja: 赤誠組の恥さらしめ、覚悟するがいい！
#. de: Du bist eine Schande für die Sekiseigumi! Dafür wirst du mit dem Leben bezahlen!
#. fr: Tu es la honte du Sekiseigumi<nbsp>! Tu vas mourir<nbsp>!
msgctxt "InstanceContentTextData:15815:0:0"
msgid "No punishment will suffice for your crimes!"
msgstr "За твои преступления не будет слишком суровой кары!"

#. ja: 御用だ、御用だ！
#. de: Hierher! Hierher!
#. fr: Par ici<nbsp>! Par ici<nbsp>!
msgctxt "InstanceContentTextData:15816:0:0"
msgid "To arms! To arms!"
msgstr "К оружию! К оружию!"

#. ja: この掛け声は！？
#. de: Diese Stimme kenne ich doch!
#. fr: Je reconnais cette voix<nbsp>!
msgctxt "InstanceContentTextData:15817:0:0"
msgid "What's this?"
msgstr "Что это?"

#. ja: 助太刀に参りました！
#. de: Verstärkung ist da!
#. fr: Les renforts sont là<nbsp>!
msgctxt "InstanceContentTextData:15818:0:0"
msgid "We are come to aid you!"
msgstr "Мы пришли вам на помощь!"

#. ja: やはり赤誠組！　駆けつけてくれたか！
#. de: Die Samurai der Sekiseigumi sind uns zu Hilfe geeilt!
#. fr: Ce sont bien eux<nbsp>! Nos guerriers sont venus à notre aide<nbsp>!
msgctxt "InstanceContentTextData:15819:0:0"
msgid "Kami be praised─it's the Sekiseigumi!"
msgstr "Хвала ками — это же Сэкисэйгуми!"

#. ja: 皆の者、一大事である！<br>副局長は組を裏切り、ウゲツと繋がっていたのだ！
#. de: Hört her! Shiden hat uns verraten! Er macht mit Ugetsu gemeinsame Sache!
#. fr: Camarades<nbsp>! L'heure est grave<nbsp>! Le vice-commandant a trahi notre cause en s'alliant à Ugetsu<nbsp>!
msgctxt "InstanceContentTextData:15820:0:0"
msgid "My friends, we are betrayed! The lieutenant serves Ugetsu!"
msgstr "Друзья, нас предали! Лейтенант служит Угэцу!"

#. ja: 皆、ご苦労。
#. de: Ihr kommt gerade rechtzeitig.
#. fr: Vous arrivez juste à temps.
msgctxt "InstanceContentTextData:15821:0:0"
msgid "You arrived just in time."
msgstr "Вы как раз вовремя."

#. ja: はっ！
#. de: Zu Diensten!
#. fr: À vos ordres<nbsp>!
msgctxt "InstanceContentTextData:15822:0:0"
msgid "Sir!"
msgstr "Слушаюсь!"

#. ja: なにっ！？　これは、いったい……。
#. de: Was?! Was hat das zu bedeuten?
#. fr: Comment<nbsp>!? Qu'est-ce que ça signifie...<nbsp>?
msgctxt "InstanceContentTextData:15823:0:0"
msgid "What? What is happening?"
msgstr "Что? Что происходит?"

#. ja: 甘いな、ウゲツ派が私だけだとでも思ったか……？
#. de: Du bist so naiv. Hast du wirklich geglaubt, ich wäre der Einzige, der zu Ugetsu übergelaufen ist?
#. fr: Comme tu es naïve. Pensais-tu vraiment que j'étais le seul parmi nos guerriers à avoir rejoint Ugetsu<nbsp>?
msgctxt "InstanceContentTextData:15824:0:0"
msgid "Come now, surely you did not think I was alone?"
msgstr "Ну же, неужели ты и правда думал, что я один?"

#. ja: ま、まさか……そんな……。
#. de: Oh nein ... S-Sie alle ...?
#. fr: Non... Impossible... Vous tous..<nbsp>?
msgctxt "InstanceContentTextData:15825:0:0"
msgid "No... This cannot be..."
msgstr "Нет... Не может быть..."

#. ja: このふたりのせいで、襲撃計画が露見したのだ……。
#. de: Wegen diesen beiden ist unser Plan gescheitert.
#. fr: L'assaut que nous avions prévu est tombé à l'eau à cause de ces deux-là.
msgctxt "InstanceContentTextData:15826:0:0"
msgid "These two have uncovered our plan."
msgstr "Эти двое раскрыли наш план."

#. ja: さあ、大義の邪魔立てをする愚か者どもを排除せよ！
#. de: Sie sind Hindernisse auf unserem Weg in ein neues Hingashi. Beseitigen wir sie!
#. fr: <if $gn4>Elles<else>Ils</if> nous barrent la route sur le chemin du renouveau<nbsp>! Éliminez-les<nbsp>!
msgctxt "InstanceContentTextData:15827:0:0"
msgid "They are a threat to the cause and cannot be suffered to live. Kill them."
msgstr "Они угрожают нашему делу и не должны остаться в живых. Убейте их."

#. ja: 御意！　大義のために！
#. de: Jawohl! Für die Gerechtigkeit!
#. fr: Compris<nbsp>! Pour la justice<nbsp>!
msgctxt "InstanceContentTextData:15828:0:0"
msgid "Yes, sir! For the cause!"
msgstr "Слушаюсь! За наше дело!"

#. ja: なんてこと！　裏切り者が……こんなにもっ！？
#. de: So viele Verräter gab es in unseren Reihen!?
#. fr: Il y avait autant de traîtres parmi nous<nbsp>!?
msgctxt "InstanceContentTextData:15829:0:0"
msgid "That there should be so many traitors..."
msgstr "Неужели среди нас и правда столько предателей..."

#. ja: 皆の者、目を覚ますのだ！
#. de: Ihr müsst eure Augen öffnen!
#. fr: Ouvrez les yeux, vous tous<nbsp>!
msgctxt "InstanceContentTextData:15830:0:0"
msgid "Please, open your eyes!"
msgstr "Прошу, очнитесь!"

#. ja: 幕府を倒しても、世は混乱するだけだ！
#. de: Ohne Shogunat wird das ganze Land in Kriegswirren versinken!
#. fr: Sans le bakufu, personne ne sera épargné par la guerre<nbsp>!
msgctxt "InstanceContentTextData:15831:0:0"
msgid "Tearing down the bakufu will only lead to chaos!"
msgstr "Свержение бакуфу приведёт лишь к хаосу!"

#. ja: そなたらは、国を護る赤誠組ではなかったか！？
#. de: Seid ihr der Sekiseigumi nicht beigetreten, um euer Land zu schützen?
#. fr: Pourquoi avez-vous rejoint le Sekiseigumi, si ce n'est pour protéger votre pays<nbsp>!?
msgctxt "InstanceContentTextData:15832:0:0"
msgid "We are Sekiseigumi! We are sworn to protect the nation!"
msgstr "Мы же Сэкисэйгуми! Мы поклялись защищать страну!"

#. ja: こんなこと……こんなこと……間違っている！
#. de: Warum seht ihr nicht, dass Ugetsus Weg der falsche ist?
#. fr: Vous... Vous êtes égarés sur le chemin de la justice<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:15833:0:0"
msgid "What you are doing is...is <i>wrong</i>!"
msgstr "То, что вы делаете... это <i>неправильно</i>!"

#. ja: くっ……多勢に無勢！
#. de: Verdammt, es sind viel zu viele!
#. fr: Bon sang, ils sont trop nombreux<nbsp>!
msgctxt "InstanceContentTextData:15834:0:0"
msgid "There's far too many of them!"
msgstr "Их слишком много!"

#. ja: このままでは……負けてしまう……！
#. de: So können wir nicht gewinnen ...
#. fr: Nous... ne nous en sortirons jamais<nbsp>!
msgctxt "InstanceContentTextData:15835:0:0"
msgid "We cannot win against these odds..."
msgstr "С таким перевесом нам не победить..."

#. ja: 仲間は……いないのか……？
#. de: Gibt es denn niemanden, der uns unterstützt?
#. fr: Nos guerriers nous auraient tous abandonné<if $gn4>e</if>s...<nbsp>?
msgctxt "InstanceContentTextData:15836:0:0"
msgid "Are there none who are loyal?"
msgstr "Неужели среди нас не осталось верных?"

#. ja: もはや……これまでか……。
#. de: Das ist das Ende, <split " " 1><string $gs1></split> ...
#. fr: C'est la fin, <split " " 1><string $gs1></split>...
msgctxt "InstanceContentTextData:15837:0:0"
msgid "That it should end like this..."
msgstr "И всё закончится вот так..."

#. ja: こっちだ、こっちだー！
#. de: Folgt mir! Hierher!
#. fr: Suivez-moi<nbsp>! Par ici<nbsp>!
msgctxt "InstanceContentTextData:15838:0:0"
msgid "Quickly! They're this way!"
msgstr "Скорее! Они вон там!"

#. ja: この声は……まさかっ！？
#. de: Diese Stimme! Ist das möglich!?
#. fr: Cette voix...<nbsp>? C'est impossible<nbsp>!!!
msgctxt "InstanceContentTextData:15839:0:0"
msgid "That voice... Could it be!?"
msgstr "Этот голос... Неужели!?"

#. ja: 遅くなって、あいすまぬ。<br>警備中の者を集めるのに手間取った。
#. de: Entschuldigt, dass ich so spät komme. Ich habe noch alle Krieger eingesammelt, die auf Patrouille waren.
#. fr: Désolé de vous avoir fait attendre. Je devais rassembler nos guerriers qui montaient la garde.
msgctxt "InstanceContentTextData:15840:0:0"
msgid "Forgive me my delay. It took some while to gather those on duty."
msgstr "Простите, что задержался. Пришлось собрать всех, кто был на дежурстве."

#. ja: き、局長っ！？<br>生きておられたのですね！
#. de: Wachtmeister!? Du bist ... Du bist am Leben!
#. fr: C-commandant<nbsp>!? Vous êtes en vie<nbsp>!?
msgctxt "InstanceContentTextData:15841:0:0"
msgid "C-Captain! You're alive!"
msgstr "К-капитан!? Вы живы!"

#. ja: 大変です！<br>副局長をはじめ、組内に多くの裏切り者が……！
#. de: Die Situation ist kritisch! Shiden und viele unsere Samurai haben sich als Verräter entpuppt ...
#. fr: La situation est critique<nbsp>! Le vice-commandant ainsi que nombre des nôtres nous ont trahis<nbsp>!
msgctxt "InstanceContentTextData:15842:0:0"
msgid "There are traitors in our midst, the lieutenant among them!"
msgstr "Среди нас предатели, и лейтенант — один из них!"

#. ja: 状況は承知している。<br>ワシはあやつに闇討ちされたのだからな……。
#. de: Ich weiß genau Bescheid. Er hat mich nachts überfallen.
#. fr: Je ne le sais que trop bien. Il m'a tendu un traquenard à la faveur de la nuit. Ça ne trompe pas.
msgctxt "InstanceContentTextData:15843:0:0"
msgid "Aye, I know. 'Twas he who tried to kill me."
msgstr "Знаю. Это он пытался меня убить."

#. ja: な、なんですと！？<br>局長までもがシデンに！
#. de: Wie bitte?! Shiden hat selbst dich angegriffen?
#. fr: I-il a osé s'en prendre à vous, Commandant<nbsp>!?
msgctxt "InstanceContentTextData:15844:0:0"
msgid "Th-That was Shiden, too!?"
msgstr "Т-так это Сидэн и вас...!?"

#. ja: チッ、討ち損じていたか……頑丈な奴め。
#. de: Mist. Du hast überlebt, hm? Bist ein zäher Bursche!
#. fr: Tss... Quel coriace. Je l'avais donc manqué...
msgctxt "InstanceContentTextData:15845:0:0"
msgid "Hmph, aren't you a tough old bastard?"
msgstr "Хм, да ты крепкий старый ублюдок!"

#. ja: シデンよ……まさか、お主が裏切り者だったとはな……。
#. de: Shiden ... Ausgerechnet du ...
#. fr: Shiden... De nous tous, je ne pensais pas que toi, tu me trahirais...
msgctxt "InstanceContentTextData:15846:0:0"
msgid "Why, Shiden? I trusted you."
msgstr "Почему, Сидэн? Я ведь тебе доверял."

#. ja: 頭の固いお前にはわからぬだろうが、<br>この国はウゲツ様が変える！
#. de: Kongo, du bist zu stur, um meine Beweggründe verstehen zu können. Ugetsu wird unser Land verändern!
#. fr: Tu ne peux pas comprendre, Kongo. Tu es trop buté<nbsp>! Ugetsu va sauver Hingashi<nbsp>!
msgctxt "InstanceContentTextData:15847:0:0"
msgid "To change Hingashi, why else? But mule-headed as you are, I don't expect you to understand."
msgstr "А зачем ещё менять Хингаси? Но ты такой упрямый мул, что всё равно не поймёшь."

#. ja: 虚けが……もはや、以前の聡明なお前ではないのだな。<br>……斬るしかないようだ。
#. de: Ich hätte nicht geglaubt, dass du dich so leicht täuschen lassen würdest ... Ich hielt dich für klug! Nun musst du sterben.
#. fr: Imbécile... Il ne reste donc rien de l'homme si perspicace que j'ai connu. Alors, tu mourras.
msgctxt "InstanceContentTextData:15848:0:0"
msgid "The earnest and true Shiden of old is no more─that is all I need to understand."
msgstr "От прежнего честного и искреннего Сидэна ничего не осталось. Мне этого достаточно."

#. ja: 裏切り者を一掃するぞ！<br>各々、ぬかるなよ！
#. de: Tötet alle Verräter! Aber nehmt euch vor ihnen in Acht!
#. fr: Éliminez ces renégats<nbsp>! Et faites attention<nbsp>!
msgctxt "InstanceContentTextData:15849:0:0"
msgid "We deal with the traitors! Have care, and remember:"
msgstr "Разберёмся с предателями! Будьте начеку и помните:"

#. ja: 我ら赤誠組！　刀を振るうは太平のため！
#. de: Wir sind die Sekiseigumi! Wir kämpfen, um den Frieden zu sichern!
#. fr: Nous sommes le Sekiseigumi<nbsp>! Nos katana défendent la paix<nbsp>!
msgctxt "InstanceContentTextData:15850:0:0"
msgid "We are the Sekiseigumi, and our blades stand for peace!"
msgstr "Мы — Сэкисэйгуми, и наши клинки стоят на страже мира!"

#. ja: 君の相手は私だ。<br>その真価を見せてもらうよ。
#. de: Ich werde dein Gegner sein. Ich will sehen, aus welchem Holz du geschnitzt bist!
#. fr: Je serai ton adversaire. Je tiens à voir ce que tu vaux.
msgctxt "InstanceContentTextData:15851:0:0"
msgid "Come, ijin. I shall be your opponent."
msgstr "Выходи, иджин. Я буду твоим противником."

#. ja: こちらも戯れは終わりだ……本気でいくぞ！
#. de: Unterschätze mich nicht! Einer von uns wird jetzt sterben!
#. fr: Je me battrai jusqu'au bout. Si tu me sous-estimes, tu périras<nbsp>!
msgctxt "InstanceContentTextData:15852:0:0"
msgid "I am done toying with you. Let us see your true worth!"
msgstr "Хватит с меня игр. Посмотрим, чего ты стоишь на самом деле!"

#. ja: うう……この私が……負けるなんて……。
#. de: N-Nein ... Wie konnte ich nur ... verlieren ...
#. fr: N-non... Moi<nbsp>? Perdre...<nbsp>?
msgctxt "InstanceContentTextData:15853:0:0"
msgid "\\<gasp> No... How could I lose?"
msgstr "<i>Ах...</i> Нет... Как я мог проиграть?"

#. ja: シデン様がやられた！　一旦、引くしかない！
#. de: Shiden ist gefallen! Rückzug!
#. fr: Ils ont eu Shiden<nbsp>! Battez en retraite<nbsp>!
msgctxt "InstanceContentTextData:15854:0:0"
msgid "Lord Shiden is fallen! We must retreat!"
msgstr "Господин Сидэн пал! Нужно отступать!"

#. ja: おのれ、逃がすか……！
#. de: Feiglinge! Ihr entkommt uns nicht!
#. fr: On ne vous laissera pas vous enfuir, bande de lâches<nbsp>!
msgctxt "InstanceContentTextData:15855:0:0"
msgid "You'll not get away!"
msgstr "Не уйдёте!"

#. ja: 深追いはやめるのだ！<br>町人に危害が及んでしまう……。
#. de: Wir sollten sie nicht zu weit verfolgen, sonst kommen Zivilisten zu Schaden.
#. fr: N'allez pas trop loin<nbsp>! Vous pourriez blesser des civils<nbsp>!
msgctxt "InstanceContentTextData:15856:0:0"
msgid "Leave them! We cannot risk endangering the citizens."
msgstr "Оставьте их! Нельзя подвергать горожан опасности."

#. ja: <split " " 1><string $gs1></split>殿……！<br>もはや、これまで……無念。
#. de: <split " " 1><string $gs1></split> ...! Das ist unser Ende ...
#. fr: <split " " 1><string $gs1></split>, non<nbsp>!<nbsp>... C'est donc la fin...
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15857:0:0"
msgid "<split \" \" 1><string $gs1></split>, forgive me... I am undone..."
msgstr "<split \" \" 1><string $gs1></split>, прости... Я проиграл..."

#. ja: ナヤガを倒せ！
#. de: Nayaga niederstrecken
#. fr: Vainquez Nayaga
msgctxt "InstanceContentTextData:15900:0:0"
msgid "Defeat Nayaga."
msgstr "Одолейте Наягу."

#. ja: オラ、オメたちを倒して、ケレル族に戻るんだ！<br>うおおおおおお！！
#. de: Ich will zurück zu meinem Stamm,<br>und ihr steht mir dabei im Weg!
#. fr: Au nom des Qerel, je vais tous vous exterminer<nbsp>!
msgctxt "InstanceContentTextData:15901:0:0"
msgid "I will make you pay for what you've done to the Qerel!"
msgstr "Я заставлю вас заплатить за то, что вы сделали с кэрелами!"

#. ja: 愚か者めが……。<br>我が「神憑き」の力、思い知るがいい……！！
#. de: Ungläubige Narren!<br>Dank der Mondgöttin bin ich unbesiegbar!
#. fr: Idiots de mécréants... Nhaama me confère son Pouvoir divin<nbsp>; je suis invincible<nbsp>!
msgctxt "InstanceContentTextData:15902:0:0"
msgid "Hmph! It is time you learned your place."
msgstr "Хм! Пора тебе узнать своё место."

#. ja: やった！　やったぞ！<br>オラたちの勝利だ……！！
#. de: Ha, die beten so schnell keinen mehr an!
#. fr: Nous avons réussi<nbsp>! Nous avons vaincu les Chagan<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15903:0:0"
msgid "We've done it, <split \" \" 1><string $gs1></split>! We've done it!"
msgstr "Мы сделали это, <split \" \" 1><string $gs1></split>! Сделали!"

#. ja: 月神ナーマの前に、ひれ伏すがいい！<br>フハハハハハハッ……！
#. de: Kniet nieder vor der Mondgöttin, Elende!<br>Hahahahahaaarrr!
#. fr: Vous n'êtes pas de taille face à la toute-puissance de Nhaama<nbsp>!<br>Repentissez-vous<nbsp>! Mouahahahaha<nbsp>!
msgctxt "InstanceContentTextData:15904:0:0"
msgid "None can deny the will of the Dusk Mother! Hahahaha!"
msgstr "Никто не смеет перечить воле Матери Сумерек! Ха-ха-ха-ха!"

#. ja: おぉ！　犠牲の血を求める月神ナーマよ……！<br>我に、すべてを見据える力を与えたまえ！！
#. de: Nach Blut dürstende Nhaama!<br>Gib mir deine alles verschlingende Kraft!
#. fr: Ô Mère des nuits crépusculaires, prête-moi tes yeux et ta perception pour voir au-delà des limites<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:15905:0:0"
msgid "Oh Nhaama, goddess of the dusk. Grant me strength to do<br>your bidding, to nourish the soil with their life's blood."
msgstr "О Нхаама, богиня сумерек! Дай мне сил исполнить твою волю и напитать землю кровью их жизни."

#. ja: オ、オラの攻撃がまったく効かねえぞ！
#. de: Ich kann ihm keinen Kratzer mehr zufügen!
#. fr: Eh<nbsp>! Mes attaques ont aucun effet sur lui<nbsp>!
msgctxt "InstanceContentTextData:15906:0:0"
msgid "What's this!? He's repelling our attacks!"
msgstr "Что такое!? Он отражает все наши атаки!"

#. ja: これが、ナヤガの奥の手だ！<br>こうなったら、もう攻撃を寄せつけねえんだ！
#. de: Das ist einer seiner schmutzigen Tricks!<br>Jetzt können wir ihm nichts mehr anhaben.
#. fr: C'est impossible<nbsp>! Comment peut-il esquiver toutes nos attaques<nbsp>!?
msgctxt "InstanceContentTextData:15907:0:0"
msgid "It is the power of Karash! To land a blow against him now is nigh impossible."
msgstr "Это сила Караша! Теперь попасть по нему почти невозможно."

#. ja: おぉ！　見える……見えるぞっ！<br>お前たちの動きは、すべてお見通しだ！！
#. de: Hahaha, ich sehe alles!<br>Ich erkenne all eure Absichten im Voraus!
#. fr: Hahaha<nbsp>! Je vois tout, TOUT<nbsp>! Je devine toutes vos intentions à l'avance<nbsp>!
msgctxt "InstanceContentTextData:15908:0:0"
msgid "This is the limit of your power? How pathetic, hahahaha!"
msgstr "И это всё, на что ты способен? Жалкий ты, ха-ха-ха!"

#. ja: ど、どうすればいいんだ！？<br>このままだと、勝てねえぞ……！
#. de: Was jetzt? Hat jemand 'nen Plan?
#. fr: Qu'est-ce qu'on fait<nbsp>? On s'replie<nbsp>!?
msgctxt "InstanceContentTextData:15909:0:0"
msgid "Is there nothing we can do?"
msgstr "Неужели мы ничего не можем поделать?"

#. ja: 「原初の魂」を、めいっぱい燃やしてぶつければ、<br>ヤツの奥の手を破れるかもしれねえ！
#. de: Ich werde meine Urkraft bis zum Äußersten steigern. Vielleicht lässt sich sein Wahn so brechen!
#. fr: Je vais déchaîner ma bête intérieure au maximum. Peut-être que mes flammes pourront créer une brèche dans sa défense<nbsp>!
msgctxt "InstanceContentTextData:15910:0:0"
msgid "The answer lies with Karash. If I can harness all my strength into a single strike..."
msgstr "Всё дело в Караше. Если я вложу все силы в один удар..."

#. ja: ナヤガは、<split " " 1><string $gs1></split>に任せた！<br>最強の戦士の、オメにしか相手は務まらねえからな！
#. de: Beschäftige du solange Nayaga, <split " " 1><string $gs1></split>!<br>Nur du kannst ihm jetzt noch die Stirn bieten!
#. fr: <split " " 1><string $gs1></split>, occupez-vous de Nayaga<nbsp>! J'ai besoin d'un peu de temps pour concentrer mon énergie<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15911:0:0"
msgid "<split \" \" 1><string $gs1></split>, keep his attention. I need a moment to focus my energies."
msgstr "<split \" \" 1><string $gs1></split>, отвлеки его. Мне нужно немного времени, чтобы собраться с силами."

#. ja: 今度はお前が相手か？<br>月神ナーマへの生贄にしてくれる！！
#. de: Versuch ruhig dein Glück!<br>Auch du wirst schon bald vor der Mondgöttin knien!
#. fr: Viens, <if $gn4>ma<else>mon</if> petit<if $gn4>e</if><nbsp>! Nhaama va s'abreuver de ton sang<nbsp>!
msgctxt "InstanceContentTextData:15912:0:0"
msgid "You would be the first to die? Very well."
msgstr "Ты хочешь умереть первым? Что ж, будет по-твоему."

#. ja: だが、オラの「原初の魂」だけじゃ足りねえかも……。
#. de: Ich fürchte nur, dass meine Urkraft alleine nicht reichen könnte ...
#. fr: Nayaga est rudement fort. Je crains que ma puissance seule ne soit pas suffisante...
msgctxt "InstanceContentTextData:15913:0:0"
msgid "I fear my strength alone may not be enough..."
msgstr "Боюсь, моих сил может не хватить..."

#. ja: オラも手伝うぞ！<br>「原初の魂」が必要なら、オラの力もわけてやる！
#. de: Dann helfe ich dir! Wir werden unsere Kräfte einen!
#. fr: J'vais t'aider<nbsp>! Si on unit nos forces, on arrivera cer<shy>tai<shy>ne<shy>ment à le battre<nbsp>!
msgctxt "InstanceContentTextData:15914:0:0"
msgid "Never fear, my love! You need but say the word, and my axe is yours."
msgstr "Не бойся, любимая! Скажи только слово — и мой топор к твоим услугам."

#. ja: よしきた、ゴージ！<br>ふたりで、「原初の魂」を燃え上がらせるぞ！
#. de: In Ordnung, Klamm! Wir ziehen das zusammen durch!
#. fr: En avant, Gorge<nbsp>! Libère ta rage et fais-la brûler avec la mienne<nbsp>!
msgctxt "InstanceContentTextData:15915:0:0"
msgid "Then let us combine our strength and put an end to his rampage."
msgstr "Тогда объединим силы и покончим с его буйством."

#. ja: オラ、いつになく「原初の魂」が燃え上がってるぞ！<br>こ、これが、愛ってヤツなのか！？
#. de: Meine Urkraft lodert so stark wie nie! I-Ist das etwa Liebe?
#. fr: Le feu d'ma rage brûle plus fort que jamais<nbsp>! S-serait-ce le pouvoir de l'amour<nbsp>!?
msgctxt "InstanceContentTextData:15916:0:0"
msgid "My soul is aflame─I've never felt so alive! Could this be the power of love?"
msgstr "Душа моя пылает как никогда! Н-неужели это любовь?"

#. ja: まずいぞ！<br>奴らめ、獣をけしかけてきやがった！
#. de: Verdammt! Meine Pheromone haben wilde Tiere angelockt!
#. fr: Oh non<nbsp>! Mes phéromones ont attiré des bêtes sauvages<nbsp>!
msgctxt "InstanceContentTextData:15917:0:0"
msgid "Oh no! Mammoths!"
msgstr "О нет! Мамонты!"

#. ja: オ、オラを狙ってるぞ！<br>今は反撃できねえ、<split " " 1><string $gs1></split>、手を貸してくれ……！
#. de: Die haben's auf mich abgesehen! Hilfe, <split " " 1><string $gs1></split>!
#. fr: Ces mammouths en ont après ma peau<nbsp>! Aide-moi, <split " " 1><string $gs1></split><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15918:0:0"
msgid "Back, you fiends! Can you not see I'm assisting my ladylove? <split \" \" 1><string $gs1></split>, you must stop them!"
msgstr "Назад, мерзавцы! Не видите, что я помогаю любимой? <split \" \" 1><string $gs1></split>, останови их!"

#. ja: また、獣が押し寄せてきたぞ！<br>今度は、オラたちふたりを狙ってる！
#. de: Schon wieder Besuch! Diesmal ist auch Dorgono in Gefahr!
#. fr: D'autres mammouths arrivent<nbsp>! Et c'te fois y en a un qui attaque Dorgono<nbsp>!
msgctxt "InstanceContentTextData:15919:0:0"
msgid "He's summoned more mammoths! You cannot allow him to disrupt our formation."
msgstr "Он призвал ещё мамонтов! Нельзя дать ему нарушить наш строй."

#. ja: あと、もう少しで限界まで「原初の魂」が燃え上がる！<br>耐えてくれ、<split " " 1><string $gs1></split>……！！
#. de: Meine Urkraft steht kurz vorm völligen Ausbruch.<br>Halte noch etwas durch, <split " " 1><string $gs1></split>!
#. fr: Nous y sommes presque<nbsp>! Courage, <split " " 1><string $gs1></split><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:15920:0:0"
msgid "Hold on, <split \" \" 1><string $gs1></split>. We're nearly there. I can feel it!"
msgstr "Ещё немного, <split \" \" 1><string $gs1></split>. Мы почти у цели. Чувствую!"

#. ja: 受け取ってくれ、ドルゴノ！<br>これが、オラの愛のすべてだああああ……！
#. de: Es ist so weit!<br>Empfange meine Liebe, Dorgono!
#. fr: Ça y est<nbsp>! Dorgono, prépare-toi à recevoir tout mon amour<nbsp>!!
msgctxt "InstanceContentTextData:15921:0:0"
msgid "Take my love, Dorgono. Take it, and lead us to victory!"
msgstr "Прими мою любовь, Доргоно! Прими её и приведи нас к победе!"

#. ja: な、なにが起こったというのだ……！？あの巨大な塊は……いったい！？
#. de: Ihr wollt mir mit diesem lächerlichen Flammenbällchen Angst machen?
#. fr: Ce n'est pas une pauvre boule de feu qui va m'effrayer<nbsp>!
msgctxt "InstanceContentTextData:15922:0:0"
msgid "You mean to intimidate me with that pitiful ball of flame?"
msgstr "Ты решил запугать меня этим жалким огненным шариком?"

#. ja: 受け取ったぜ、ゴージ！<br>燃やし尽くすぞ「原初の魂」！
#. de: Erlebe die wahre Macht unserer vereinten Urkräfte!
#. fr: Nos bêtes primitives sont unies<nbsp>! Et maintenant, il ne reste plus qu'à enfoncer le clou<nbsp>!
msgctxt "InstanceContentTextData:15923:0:0"
msgid "This is the true power of Karash, of our inner beasts."
msgstr "Вот истинная сила Караша, наших внутренних зверей."

#. ja: これが、オラたちの燃え上がる「原初の魂」！<br>食らえぇぇぇぇぇっ！！
#. de: Denn gemeinsam sind wir nicht zu schlagen!
#. fr: Nayaga<nbsp>! Fais tes prières<nbsp>!!!
msgctxt "InstanceContentTextData:15924:0:0"
msgid "And together, we are unstoppable!!!"
msgstr "А вместе нас не остановить!!!"

#. ja: ぐわああああああああああっ！！
#. de: Aaaaaarrrggghhh!
#. fr: Aaaaaarrrggghhh<nbsp>!!!
msgctxt "InstanceContentTextData:15925:0:0"
msgid "Gaaaaaaaaahhhhhh!!!"
msgstr "А-а-а-а-а-а-а-а!!!"

#. ja: そ、そんな……月神ナーマの力が……<br>破られただと……？
#. de: Nhaamas ... Kräfte ... sind versiegt.<br>Wie ist das möglich?
#. fr: C-comment est-ce possible<nbsp>?<nbsp>... Le pouvoir de Nhaama est... indéfectible.
msgctxt "InstanceContentTextData:15926:0:0"
msgid "My strength... No, this cannot be happening..."
msgstr "Моя сила... Нет, этого не может быть..."

#. ja: やったぞ！　これで奴は無防備だ！<split " " 1><string $gs1></split>、ゴージ、たたみかけるぞ！
#. de: Jetzt hilft ihm nichts und niemand mehr!<br><split " " 1><string $gs1></split>, Klamm, macht ihn fertig!
#. fr: Nous avons percé ses défenses<nbsp>! Gorge, <split " " 1><string $gs1></split><nbsp>! C'est le moment d'en finir<nbsp>!
msgctxt "InstanceContentTextData:15927:0:0"
msgid "We've breached his defenses. We must strike now before he can recover."
msgstr "Мы пробили его защиту! Надо ударить сейчас, пока он не оправился."

#. ja: おう！　オラまだまだやれるぞ！ぐおおおお……！！
#. de: Ha! Ich bin noch lange nicht geschlagen!<br>Grrraaarrrhhh!
#. fr: J'vais lui faire bouffer ma hache, à cet illuminé<nbsp>!
msgctxt "InstanceContentTextData:15928:0:0"
msgid "Leave it to me, my dear!"
msgstr "Предоставь это мне, дорогая!"

#. ja: このまま終わる……俺ではないぞ！
#. de: So hätte es nicht enden dürfen!
#. fr: Je n'ai pas encore dit mon dernier mot<nbsp>!
msgctxt "InstanceContentTextData:15929:0:0"
msgid "You will not deny the Dusk Mother."
msgstr "Ты не отвергнешь Мать Сумерек."

#. ja: まかせろ、ドルゴノ！<br>やってやるぞ、うおおおおお！
#. de: Überlass den mir, Dorgono!<br>Den mach ich fertig! Grrraaarrr!
#. fr: Avec plaisir, mon amour<nbsp>! GrrrAaaarr<nbsp>!!!
msgctxt "InstanceContentTextData:15930:0:0"
msgid "It would be my pleasure."
msgstr "С радостью!"
