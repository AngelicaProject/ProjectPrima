msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 群れからはぐれたロネークを探せ！
#. de: Suche verängstigte Rroneek!
#. fr: Chercher les rroneeks isolés
msgctxt "InstanceContentTextData:41000:0:0"
msgid "Search for rroneek"
msgstr "Найди рронеков"

#. ja: ロネークをなだめろ！
#. de: Besänftige die Rroneek!
#. fr: Rassurer les rroneeks
msgctxt "InstanceContentTextData:41001:0:0"
msgid "Stroke the trembling rroneek"
msgstr "Погладь дрожащего рронека"

#. ja: ロネークを守れ！
#. de: Beschütze die Rroneek!
#. fr: Protéger les rroneeks
msgctxt "InstanceContentTextData:41002:0:0"
msgid "Protect the rroneek"
msgstr "Защити рронеков"

#. ja: ヅルヘイゾヒリを倒せ！
#. de: Besiege den Tturuhhetso!
#. fr: Vaincre le tturuhhetsohhiri
msgctxt "InstanceContentTextData:41003:0:0"
msgid "Defeat the tturuhhetso!"
msgstr "Победи ттуруххетсо!"

#. ja: ヅルヘイゾヒリの脚部を攻撃せよ！
#. de: Konzentriere deine Angriffe auf das Bein!
#. fr: Attaquer les pattes du monstre
msgctxt "InstanceContentTextData:41004:0:0"
msgid "Attack the tturuhhetso's legs!"
msgstr "Атакуй ноги ттуруххетсо!"

#. ja: 分析完了、データはそろった……！
#. de: Analyse abgeschlossen, ich habe alle nötigen Daten!
#. fr: J'ai terminé mon analyse<nbsp>!
msgctxt "InstanceContentTextData:41005:0:0"
msgid "I've got it!"
msgstr "Я всё понял!"

#. ja: 胸部に高密度のエーテルを確認<br>この徹甲弾で外殻ごと……！
#. de: In seiner Brust befindet sich hochkonzentrierter Äther ...
#. fr: Sa poitrine renferme une forte con<shy>cen<shy>tra<shy>tion d'éther.
msgctxt "InstanceContentTextData:41006:0:0"
msgid "One well-placed piercing round to the chest, and..."
msgstr "Одного меткого выстрела в грудь — и..."

#. ja: 心核を貫く！
#. de: Und ich habe genau die richtige Kugel dafür!
#. fr: Il suffit de viser son cœur de cristal<nbsp>!
msgctxt "InstanceContentTextData:41007:0:0"
msgid "You're done for!"
msgstr "Тебе конец!"

#. ja: 一刻も早く、ロネークを避難させなくては……！
#. de: Wir müssen die Rroneek schleunigst in Sicherheit bringen!
#. fr: Il faut mettre les rroneeks en lieu sûr, vite<nbsp>!
msgctxt "InstanceContentTextData:41008:0:0"
msgid "Make haste! We must protect the rroneek."
msgstr "Скорее! Надо защитить рронеков."

#. ja: 手分けしてかかれば、きっと大丈夫だ。
#. de: Wenn wir uns aufteilen, schaffen wir das schon.
#. fr: À nous quatre, ça devrait pas poser de problème.
msgctxt "InstanceContentTextData:41009:0:0"
msgid "Don't worry, we're right behind you."
msgstr "Не волнуйся, мы рядом."

#. ja: ロネークがいます！
#. de: Da sind welche!
#. fr: Regardez<nbsp>! Un groupe de rroneeks<nbsp>!
msgctxt "InstanceContentTextData:41011:0:0"
msgid "There they are!"
msgstr "Вон они!"

#. ja: 大分動揺しているな。<br>なだめてやれば落ち着くだろう。
#. de: Sie wirken sehr aufgewühlt ...<br>Wenn wir sie streicheln, beruhigen sie sich bestimmt.
#. fr: Ils ont l'air terrorisés. Calmez-les en leur offrant des petites caresses.
msgctxt "InstanceContentTextData:41012:0:0"
msgid "They're terrified. We must do what we can to soothe them."
msgstr "Они в ужасе. Надо их успокоить."

#. ja: もう大丈夫そうですね。<br>先に進みましょう。
#. de: Jetzt sind sie bestimmt in Sicherheit. Machen wir weiter.
#. fr: Les Hhetsarro vont s'occuper d'eux. Il est temps d'avancer<nbsp>!
msgctxt "InstanceContentTextData:41014:0:0"
msgid "That herd should be all right. Let's look for stragglers."
msgstr "С этим стадом всё будет в порядке. Поищем отставших."

#. ja: ロネークもまた、トライヨラの一部。<br>必ず護りぬく……！
#. de: Die Rroneek sind ein Teil von Tuliyollal. Ich muss sie beschützen!
#. fr: Ces bêtes font tout autant partie de notre nation. Pas question de les abandonner<nbsp>!
msgctxt "InstanceContentTextData:41015:0:0"
msgid "The rroneek are Turali too. None shall be left behind!"
msgstr "Рронеки тоже жители Турала. Никого не оставим!"

#. ja: この先に何が……？<br>急ぎましょう！
#. de: Was ist da vorne los? Beeilen wir uns!
#. fr: Que se passe-t-il par là-bas<nbsp>? Allons voir de plus près<nbsp>!
msgctxt "InstanceContentTextData:41017:0:0"
msgid "There must be something up ahead. Come!"
msgstr "Там впереди что-то происходит. За мной!"

#. ja: アタシらにかかれば、こんな奴ら！
#. de: Gegen uns haben die keine Chance!
#. fr: Pas question de les laisser faire<nbsp>!
msgctxt "InstanceContentTextData:41018:0:0"
msgid "These are no match for the likes of us!"
msgstr "Да нам такие не страшны!"

#. ja: ヅルヘイゾヒリの影響で、凶暴化しているのか？
#. de: Lässt der Tturuhhetso die anderen so wild werden?
#. fr: Ils sont tous très agressifs... Est-ce à cause du dévoreur<nbsp>?
msgctxt "InstanceContentTextData:41020:0:0"
msgid "“In a panic” was clearly an understatement."
msgstr "«В панике» — это ещё мягко сказано."

#. ja: 別の方向からも来たぞ！
#. de: Da kommen noch mehr!
#. fr: En voilà d'autres qui arrivent<nbsp>!
msgctxt "InstanceContentTextData:41021:0:0"
msgid "More are coming!"
msgstr "Ещё идут!"

#. ja: お前の相手は、このアタシだ！
#. de: Um dich kümmere ich mich höchst<shy>persön<shy>lich!
#. fr: Laisse ces bêtes tranquilles<nbsp>! Ton adversaire, c'est moi<nbsp>!
msgctxt "InstanceContentTextData:41022:0:0"
msgid "You're mine!"
msgstr "Твоим противником буду я!"

#. ja: 一気に片付ける……！
#. de: Euch erledige ich im Hand<shy>umdrehen!
#. fr: Je vais nous débarrasser de ces gêneurs<nbsp>!
msgctxt "InstanceContentTextData:41024:0:0"
msgid "All or nothing, then!"
msgstr "Разом со всеми покончим!"

#. ja: そんな、護れなかっただなんて……。
#. de: Nein ...! Wir haben versagt ...
#. fr: Non... Les rroneeks...
msgctxt "InstanceContentTextData:41026:0:0"
msgid "The hhetso! No..."
msgstr "Хетсо! Нет..."

#. ja: ふぅ、なんとか護りきれましたね。
#. de: Puh, das ging noch mal gut.
#. fr: Pfiou, on s'en est sortis.
msgctxt "InstanceContentTextData:41027:0:0"
msgid "It seems that did the trick."
msgstr "Похоже, сработало."

#. ja: これ以上、誰も傷つけさせない！
#. de: Du wirst niemandem mehr etwas antun!
#. fr: Tu ne feras plus de mal à personne<nbsp>!
msgctxt "InstanceContentTextData:41028:0:0"
msgid "You'll find the Vow of Reason is not without resolve!"
msgstr "Ты больше никого не тронешь!"

#. ja: かってぇぇ！！<br>ぜんっぜん刃が通らねぇぞ！
#. de: Steinhart! Da kommt meine Axt überhaupt nicht durch!
#. fr: Pfouah<nbsp>! Il est dur comme un roc<nbsp>!
msgctxt "InstanceContentTextData:41029:0:0"
msgid "Dammit! Not even a scratch!"
msgstr "Чёрт! Ни царапины!"

#. ja: なにか秘密があるはず……<br>分析しなくては。
#. de: Da muss es doch einen Trick geben. Eine Analyse sollte helfen!
#. fr: Il a forcément un point faible. Je dois me concentrer...
msgctxt "InstanceContentTextData:41030:0:0"
msgid "Buy me some time to think, will you?"
msgstr "Дай мне немного времени подумать, ладно?"

#. ja: その仕組み、見極めてみせる……！
#. de: Ich muss rausfinden, was dahintersteckt!
#. fr: Laissez-moi observer sa carapace...
msgctxt "InstanceContentTextData:41031:0:0"
msgid "It must have a weakness...and I will find it!"
msgstr "У него должна быть слабость... и я её найду!"

#. ja: 少しの間でいい……！<br>奴を止めてください！
#. de: Könntet ihr ihn kurz für mich beschäftigen?
#. fr: J'ai besoin qu'il soit immobilisé ne serait-ce qu'un instant...
msgctxt "InstanceContentTextData:41032:0:0"
msgid "Keep it busy! I need time!"
msgstr "Задержите его! Мне нужно время!"

#. ja: よし、脚を狙おう！
#. de: Greifen wir sein Bein an!
#. fr: Compris<nbsp>! Attaquons ses jambes, alors<nbsp>!
msgctxt "InstanceContentTextData:41033:0:0"
msgid "Right. Go for the legs!"
msgstr "Точно. Бейте по ногам!"

#. ja: 兄さん、今だ！
#. de: Jetzt, Bruderherz!
#. fr: À toi de jouer, frérot<nbsp>!
msgctxt "InstanceContentTextData:41034:0:0"
msgid "Get thinking, Koana!"
msgstr "Коана, теперь думай!"

#. ja: 体表にエーテルが流れている……。<br>発生源は、どこだ？
#. de: Seine Schuppen werden von Äther durchströmt. Aber woher kommt der?
#. fr: Son corps est protégé par un puissant éther... Mais d'où vient-il<nbsp>?
msgctxt "InstanceContentTextData:41035:0:0"
msgid "A protective current of aether... But whence does it flow?"
msgstr "Защитный поток эфира... Откуда он идёт?"

#. ja: よし、エーテルの流れが止まりました。
#. de: Gut, der Ätherfluss ist gestoppt!
#. fr: Parfait<nbsp>! J'ai arrêté le flux éthéré.
msgctxt "InstanceContentTextData:41037:0:0"
msgid "That stemmed the flow of protective aether."
msgstr "Вот и остановили поток защитного эфира."

#. ja: これで、攻撃が通じるんだな！<br>さすが、コーナ兄さん！
#. de: Gute Arbeit, Bruderherz! Jetzt kommen wir mit unseren Angriffen durch!
#. fr: T'es trop fort<nbsp>! Nos attaques vont enfin pouvoir l'esquinter<nbsp>!
msgctxt "InstanceContentTextData:41039:0:0"
msgid "There's nothing stopping us now!"
msgstr "Теперь ничто не мешает нам атаковать!"

#. ja: まだやる気かよ。<br>とことん付き合ってやるぜ！
#. de: Aufgegeben hat er wohl noch nicht. Dann lasst uns diese Sache beenden!
#. fr: Alors comme ça t'en veux encore<nbsp>?
msgctxt "InstanceContentTextData:41040:0:0"
msgid "Still not backing down, huh? Fine with me!"
msgstr "Всё ещё не сдаёшься? Ну и ладно, я готова!"

#. ja: このエーテルの塊は……<br>奴に吸収させてはいけません！
#. de: Diese Ätherkugeln<nbsp>... Er darf sie nicht absorbieren!
#. fr: Attention, il ne doit pas absorber ces orbes d'éther<nbsp>!
msgctxt "InstanceContentTextData:41042:0:0"
msgid "We must disperse that aether ere the reaver recovers it!"
msgstr "Нельзя дать этому чудовищу поглотить сгустки эфира!"

#. ja: なら、アタシたちでいただこうぜ！
#. de: Na, dann schnappen <i>wir</i> sie uns eben!
#. fr: Dans ce cas, on lui chipe sous le nez<nbsp>!
msgctxt "InstanceContentTextData:41043:0:0"
msgid "This is going to hurt..."
msgstr "Тогда заберём их себе!"

#. ja: クソ、好き勝手させすぎたか……。
#. de: Verdammt, wir haben ihm zu viel Zeit geschenkt!
#. fr: Merde... J'y étais presque pourtant...
msgctxt "InstanceContentTextData:41044:0:0"
msgid "I may have...overdone it a little..."
msgstr "Чёрт, дал я ему разгуляться..."

#. ja: 攻撃が、重たすぎる……。
#. de: Welch ein<nbsp>... Schlag ...
#. fr: Ses attaques sont... trop... puissantes...
msgctxt "InstanceContentTextData:41045:0:0"
msgid "\\<wheeze>..."
msgstr "Его удары... слишком... сильные..."

#. ja: 肝心のヅルヘイゾヒリってのは、どこにいるんだ？
#. de: Wo steckt der Rroneekfresser?
#. fr: Au fait, où est passé le dévoreur de rroneeks<nbsp>?
msgctxt "InstanceContentTextData:41046:0:0"
msgid "For the fodder, at least. But where's..."
msgstr "По крайней мере, с кормом разобрались. Но где же..."

#. ja: 動きが鈍った……
#. de: Er wird langsamer ...
#. fr: Et reste tranquille, sale bête<nbsp>!
msgctxt "InstanceContentTextData:41047:0:0"
msgid "Now we just have to keep it pinned..."
msgstr "Он замедлился..."

#. ja: 基本訓練1の目標を達成せよ！
#. de: Schließe Übungseinheit 1 erfolgreich ab!
#. fr: Réussir le premier objectif
msgctxt "InstanceContentTextData:41100:0:0"
msgid "Clear the First Training Objective"
msgstr "Выполни первое задание базовой тренировки"

#. ja: 基本訓練2の目標を達成せよ！
#. de: Schließe Übungseinheit 2 erfolgreich ab!
#. fr: Réussir le deuxième objectif
msgctxt "InstanceContentTextData:41101:0:0"
msgid "Clear the Second Training Objective"
msgstr "Выполни второе задание базовой тренировки"

#. ja: 基本訓練3の目標を達成せよ！
#. de: Schließe Übungseinheit 3 erfolgreich ab!
#. fr: Réussir le troisième objectif
msgctxt "InstanceContentTextData:41102:0:0"
msgid "Clear the Third Training Objective"
msgstr "Выполни третье задание базовой тренировки"

#. ja: 基本訓練4の目標を達成せよ！
#. de: Schließe Übungseinheit 4 erfolgreich ab!
#. fr: Réussir le quatrième objectif
msgctxt "InstanceContentTextData:41103:0:0"
msgid "Clear the Fourth Training Objective"
msgstr "Выполни четвёртое задание базовой тренировки"

#. ja: 訓練担当官と会話しろ
#. de: Sprich mit dem Ausbilder
#. fr: Parler au superviseur de la formation
msgctxt "InstanceContentTextData:41104:0:0"
msgid "Speak with the Master of Trials"
msgstr "Поговори с наставником испытаний"

#. ja: 応用訓練の目標をすべて達成せよ！
#. de: Schließe alle Prüfungseinheiten erfolgreich ab!
#. fr: Réussir tous les objectifs
msgctxt "InstanceContentTextData:41105:0:0"
msgid "Clear All Challenge Objectives"
msgstr "Выполни все задания испытания"

#. ja: 応用訓練1の目標を達成せよ！
#. de: Schließe Prüfungseinheit 1 erfolgreich ab!
#. fr: Réussir le premier objectif
msgctxt "InstanceContentTextData:41106:0:0"
msgid "Clear the First Challenge Objective"
msgstr "Выполни первое задание испытания"

#. ja: 応用訓練2の目標を達成せよ！
#. de: Schließe Prüfungseinheit 2 erfolgreich ab!
#. fr: Réussir le deuxième objectif
msgctxt "InstanceContentTextData:41107:0:0"
msgid "Clear the Second Challenge Objective"
msgstr "Выполни второе задание испытания"

#. ja: 応用訓練3の目標を達成せよ！
#. de: Schließe Prüfungseinheit 3 erfolgreich ab!
#. fr: Réussir le troisième objectif
msgctxt "InstanceContentTextData:41108:0:0"
msgid "Clear the Third Challenge Objective"
msgstr "Выполни третье задание испытания"

#. ja: 応用訓練4の目標を達成せよ！
#. de: Schließe Prüfungseinheit 4 erfolgreich ab!
#. fr: Réussir le quatrième objectif
msgctxt "InstanceContentTextData:41109:0:0"
msgid "Clear the Fourth Challenge Objective"
msgstr "Выполни четвёртое задание испытания"

#. ja: さすがは<split " " 2><string $gs1></split>殿、対処成功です！
#. de: Fantastisch! Ihr habt perfekt reagiert, <if $gn4>verehrte Frau<else>verehrter Herr</if> <split " " 2><string $gs1></split>!
#. fr: Fé<shy>li<shy>ci<shy>ta<shy>tions, <if $gn4>Madame<else>Monsieur</if> <split " " 2><string $gs1></split>, vous vous en êtes remarquablement <if $gn4>sortie<else>sorti</if><nbsp>!
#. macro: <if $gn4>Mistress<else>Master</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <split " " 2><string $gs1></split> — the last name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:41110:0:0"
msgid "Bravo, <if $gn4>Mistress<else>Master</if> <split \" \" 2><string $gs1></split>!"
msgstr "Браво, <if $gn4>госпожа<else>господин</if> <split \" \" 2><string $gs1></split>!"

#. ja: 開始地点へ戻って、もう一度、挑戦してみましょう！
#. de: Kehrt zum Startpunkt zurück und versucht es erneut!
#. fr: Retournez au point de départ et essayez encore une fois<nbsp>!
msgctxt "InstanceContentTextData:41111:0:0"
msgid "Retake your starting position, and let's give it one more try!"
msgstr "Вернись на исходную позицию и попробуй ещё раз!"

#. ja: 素晴らしい、これで基本訓練は完了です！<br>応用訓練に移りますので、まずは私のところへ来てください。
#. de: Einwandfrei! Damit habt Ihr alle Übungs<shy>einheiten erfolgreich abgeschlossen! Sprecht mich bitte an, sobald Ihr bereit seid, euch der letzten Prüfung zu stellen.
#. fr: Bravo, vous avez accompli tous les objectifs<nbsp>! Venez me parler lorsque vous serez <if $gn4>prête<else>prêt</if> à commencer l'examen pratique.
msgctxt "InstanceContentTextData:41112:0:0"
msgid "Spectacular work! With that, your basic training is complete. Now, come and speak with me if you'd like to attempt my final challenge!"
msgstr "Великолепно! Базовая тренировка пройдена. Теперь приходи ко мне, если хочешь испытать себя в финальном испытании!"

#. ja: では、応用訓練を始めましょう。<br>準備がよければ、開始地点に移動してください。
#. de: Dann ist es jetzt Zeit für Eure Prüfung. Stellt Euch auf den Startpunkt, um zu beginnen.
#. fr: Très bien, allons-y. Postez-vous au point de départ quand vous serez <if $gn4>prête<else>prêt</if>.
msgctxt "InstanceContentTextData:41113:0:0"
msgid "We will now begin the final challenge. Once you are prepared, take your starting position."
msgstr "Переходим к финальному испытанию. Будешь готов<if $gn4>а<else></if> — займи исходную позицию."

#. ja: 基本訓練をやり直すのですね、承知しました！<br>それでは、開始地点に移動してください。
#. de: Ihr würdet die Übungen gerne wiederholen? Sehr gerne, dann stellt Euch bitte auf den Startpunkt.
#. fr: Vous préférez recommencer<nbsp>? Aucun problème, allez vous poster au point de départ.
msgctxt "InstanceContentTextData:41114:0:0"
msgid "You'd like to start over? No problem at all! Go ahead and retake your starting position."
msgstr "Хочешь начать сначала? Без проблем! Займи исходную позицию."

#. ja: さすがは<split " " 2><string $gs1></split>殿、<br>素晴らしい動きですね！
#. de: Flink wie ein Chocobo, bravo!
#. fr: Remarquable, <if $gn4>Madame<else>Monsieur</if> <split " " 2><string $gs1></split><nbsp>! Vos mouvements mériteraient d'être montrés à tous les novices<nbsp>!
#. macro: <if $gn4>Mistress<else>Master</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <split " " 2><string $gs1></split> — the last name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:41115:0:0"
msgid "Your grasp of combat tactics is commendable indeed, <if $gn4>Mistress<else>Master</if> <split \" \" 2><string $gs1></split>."
msgstr "Тактика боя у тебя на высоте, <if $gn4>госпожа<else>господин</if> <split \" \" 2><string $gs1></split>."

#. ja: おっと、地面に放たれた攻撃に当たってしまったようですね。<br>残念ながら、対処は失敗となります。
#. de: Oh, Ihr wurdet leider von der Bodenattacke getroffen. Verzeiht, aber dieser Versuch gilt somit als Fehlschlag.
#. fr: Vous avez été <if $gn4>touchée<else>touché</if> par une attaque... Mal<shy>heu<shy>reu<shy>se<shy>ment, vous allez devoir recommencer.
msgctxt "InstanceContentTextData:41116:0:0"
msgid "Careful! You were on unsafe ground just now. You'll need to retry the objective."
msgstr "Осторожно! Ты только что попал<if $gn4>а<else></if> под атаку. Придётся повторить задание."

#. ja: ようこそ<split " " 2><string $gs1></split>殿！<br>今回の訓練では、様々な攻撃を体験していただきます。
#. de: Willkommen, <if $gn4>verehrte Frau<else>verehrter Herr</if> <split " " 2><string $gs1></split>! In Eurem heutigen Training werdet Ihr eine Vielzahl an Attacken kennenlernen.
#. fr: Bienvenue, <if $gn4>Madame<else>Monsieur</if> <split " " 2><string $gs1></split>. J'ai préparé pour vous un panel de situations de combat diverses et variées.
#. macro: <if $gn4>Mistress<else>Master</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <split " " 2><string $gs1></split> — the last name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:41117:0:0"
msgid "Welcome, <if $gn4>Mistress<else>Master</if> <split \" \" 2><string $gs1></split>. In this training exercise, we will have you carry out a variety of common evasive maneuvers."
msgstr "Добро пожаловать, <if $gn4>госпожа<else>господин</if> <split \" \" 2><string $gs1></split>. На этой тренировке ты освоишь несколько стандартных приёмов уклонения."

#. ja: 場内にいる補助官が敵役として攻撃を実行しますので、<br>その「予兆」を感じ取り、適切に対処しましょう。
#. de: In diesen Übungen wird einer unserer Lehrmeister die Rolle des Gegners über<shy>nehmen. So könnt Ihr lernen, die Wir<shy>kungs<shy>be<shy>reiche der Angriffe schnell zu erkennen und entsprechend zu reagieren.
#. fr: C'est l'officière formatrice qui va vous attaquer. Soyez <if $gn4>attentive<else>attentif</if> aux indications qui vont apparaître et esquivez en conséquence.
msgctxt "InstanceContentTextData:41118:0:0"
msgid "My agent here will serve as your opponent. Try to get a sense for her oncoming attacks, and handle them accordingly."
msgstr "Моя помощница будет твоим противником. Следи за её атаками и вовремя реагируй."

#. ja: それでは準備ができましたら、開始地点に移動してください。
#. de: Also dann, stellt Euch bitte auf den Startpunkt, damit wir beginnen können.
#. fr: Lorsque vous serez <if $gn4>prête<else>prêt</if> à commencer, veuillez vous poster au point de départ.
msgctxt "InstanceContentTextData:41119:0:0"
msgid "Take your starting position when you are ready to begin."
msgstr "Когда будешь готов<if $gn4>а<else></if> начать, займи исходную позицию."

#. ja: 標的になった者を中心に、一定範囲を攻撃する魔法……<br>まずは、その「予兆」を感じていただきます。
#. de: Beginnen wir mit einem Zauber, der einen kreisförmigen Flächenangriff um sein Ziel auslöst. Angriffe dieser Art erkennt Ihr meist an dieser Markierung<nbsp>...
#. fr: Certains sorts visent une cible et infligent des dégâts dans une zone autour d'elle. Vous les reconnaîtrez à cette indication.
msgctxt "InstanceContentTextData:41120:0:0"
msgid "As you doubtless know, no few magicks strike a wide radius around a given target. The marker of such an attack will often look like this..."
msgstr "Некоторые заклинания поражают всех вокруг выбранной цели. Обычно их можно узнать по такой метке..."

#. ja: 自身が狙われていると感じたら、<br>味方から離れ、被害を最小限に留める必要があります。
#. de: Spürt Ihr, dass die Magie Euch treffen wird, solltet Ihr Euch von Euren Mitstreitern entfernen, um den erhaltenen Schaden so gering wie möglich zu halten.
#. fr: Si vous êtes <if $gn4>visée<else>visé</if>, vous avez intérêt à vous éloigner de vos coéquipiers pour qu'ils soient épargnés.
msgctxt "InstanceContentTextData:41121:0:0"
msgid "If you sense that you've been marked, you'd do well to move away from your allies so that they aren't caught in the blast."
msgstr "Если метка появилась над тобой, отойди от союзников, чтобы их не задело взрывом."

#. ja: 特に、味方も攻撃の標的となっている場合、<br>近づいてしまうと、二重に攻撃を受けることになるでしょう。
#. de: Besonders, wenn Eure Mitstreiter ebenfalls Ziele derselben Magie sind, würdet Ihr doppelt getroffen werden, falls Ihr zu nah beieinander steht.
#. fr: C'est d'autant plus vrai pour les attaques touchant plusieurs cibles. Si vous restez trop près les uns des autres, les dégâts seront multipliés<nbsp>!
msgctxt "InstanceContentTextData:41122:0:0"
msgid "The danger is greater still if an ally is targeted at the same time. Stand too close to one another, and you will suffer double the impact!"
msgstr "Особенно опасно, если такая атака одновременно нацелена на союзника. Встанете слишком близко — оба получите двойной урон!"

#. ja: おっと、ほかの味方に攻撃を当ててしまったようですね。<br>立ち位置を見て、離れるように工夫しましょう。
#. de: Oh weh, einer Eurer Mitstreiter wurde von dem Angriff getroffen, der auf Euch abzielte. Seid Euch der Position Eurer Kameraden bewusst und steht ihnen nicht zu nahe.
#. fr: Ah, l'attaque qui vous était destinée a aussi infligé des dégâts à vos équipiers... Essayez de bien espacer vos positions la prochaine fois.
msgctxt "InstanceContentTextData:41123:0:0"
msgid "Careful─you were too close to your ally just now. As you maneuver, you must be sure to mind each other's positions."
msgstr "Осторожно! Ты стоял<if $gn4>а<else></if> слишком близко к союзнику. Следи за тем, где находятся товарищи, и держись от них подальше."

#. ja: 次は、決してひとりでは耐えられない重い一撃……<br>まずは、その「予兆」を感じてください。
#. de: Als Nächstes ein mächtiger Angriff, der alleine nicht überwindbar ist. Die Markierung solcher Angriffe sieht wie folgt aus<nbsp>...
#. fr: À présent, nous allons voir une attaque si puissante qu'elle ne peut être endurée par une seule personne... Regardez d'abord l'indication.
msgctxt "InstanceContentTextData:41124:0:0"
msgid "Our next exercise features a strike so powerful, it cannot be endured alone. Allow me to demonstrate its marker..."
msgstr "В следующем упражнении будет удар такой силы, что в одиночку его не выдержать. Вот как выглядит его метка..."

#. ja: このような攻撃に狙われた場合は、<br>味方同士で集まり、支え合って耐え抜く必要があります。
#. de: Findet Ihr Euch als Ziel eines solchen Angriffs, solltet Ihr Euch schnellstens mit Euren Mitstreitern an einem Ort versammeln und den Schaden unter euch aufteilen.
#. fr: Si votre ennemi lance ce genre d'assaut, assurez-vous de bien vous regrouper avec vos équipiers.
msgctxt "InstanceContentTextData:41125:0:0"
msgid "Should the enemy perform such an attack, you and your allies must stand together in order to weather it."
msgstr "Если враг готовит такую атаку, соберитесь вместе и примите удар сообща."

#. ja: 「予兆」を感じたら、標的になった者の下に集まってください。
#. de: Steht Euren Kameraden so schnell wie möglich bei, sobald Ihr die Markierung spürt.
#. fr: Dès que vous apercevez l'indication en question, approchez-vous le plus rapidement possible<nbsp>!
msgctxt "InstanceContentTextData:41126:0:0"
msgid "Upon sensing this marker, locate its target and make your way there as quick as you can!"
msgstr "Увидел<if $gn4>а<else></if> метку — найди цель и скорее беги к ней!"

#. ja: おっと、味方の下に集まれませんでしたね。<br>こうなっては、被害は甚大です……。
#. de: Ach je, Ihr habt es nicht rechtzeitig zu Euren Mitstreitern geschafft. Bei kleinen Verletzungen wird es da nicht bleiben<nbsp>...
#. fr: J'ai bien peur que vous et vos équipiers étiez trop dispersés au moment fatidique... La prochaine fois, regroupez-vous<nbsp>!
msgctxt "InstanceContentTextData:41127:0:0"
msgid "Oh dear, you didn't reach your ally in time. Your absence was felt most painfully..."
msgstr "Ой, ты не успел<if $gn4>а<else></if> добраться до союзника. Без тебя ему пришлось тяжко..."

#. ja: 次は、盾役に対する範囲攻撃に対処していただきます。<br>まずは、その「予兆」を感じてください。
#. de: Als Nächstes ein Flächenangriff, der speziell auf Verteidiger abzielt. Erlaubt mir erneut, Euch zunächst mit seiner Markierung vertraut zu machen<nbsp>...
#. fr: Maintenant, vous allez découvrir une attaque de zone prenant pour cible le tank de l'équipe. Voici son indication...
msgctxt "InstanceContentTextData:41128:0:0"
msgid "Next, we will look at a lethal variety of attack that none but a tank can handle. Behold its marker..."
msgstr "Теперь разберём смертоносную атаку, выдержать которую может только танк. Вот её метка..."

#. ja: この「予兆」の後、強力な範囲攻撃が繰り出されます。<br>盾役以外が巻き込まれれば、ひとたまりもないでしょう。
#. de: Angriffe dieser Art verursachen enormen Schaden, der nur von Verteidigern überstanden werden kann. Alle anderen Mitstreiter sollten sich daher von diesem entfernen.
#. fr: Retenez bien que seul le tank est en mesure de survivre à un tel choc<nbsp>!
msgctxt "InstanceContentTextData:41129:0:0"
msgid "Remember, only the tank is equipped to survive a blow of this magnitude. Any other caught in its blast won't be left standing."
msgstr "Запомни: только танк способен пережить такой удар. Любой другой, кто попадёт под него, не устоит."

#. ja: では、盾役に対して実際に直線範囲の攻撃を行います！<br>盾役ひとりで攻撃を受けられるよう、動いてみてください！
#. de: Dann gehen wir von der Theorie mal in die Praxis über! Positioniert Euch so, dass der Verteidiger den Angriff alleine entgegennehmen kann!
#. fr: Et maintenant, la pratique. Positionnez-vous de façon à ce que seul le tank encaisse l'attaque.
msgctxt "InstanceContentTextData:41130:0:0"
msgid "Now for a proper demonstration. Everyone, position yourselves so that the tank may shield against this strike alone!"
msgstr "А теперь покажем всё на деле. Встаньте так, чтобы танк принял удар в одиночку!"

#. ja: おっと、盾役以外が攻撃を受けてしまいましたね。<br>こうなると被害は甚大、対処は失敗となります。
#. de: Aah, jemand anderes als der Verteidiger wurde von dem Angriff erwischt! Bei solch großem Schaden muss dieser Versuch als Fehlschlag gelten.
#. fr: Vous comprenez ce que j'ai voulu dire, maintenant<nbsp>? La prochaine fois, placez-vous pour que seul le tank se fasse toucher.
msgctxt "InstanceContentTextData:41131:0:0"
msgid "Dear me, that must have hurt. Only the tank is equipped to endure such a brutal blow, all right? Let's try it again."
msgstr "Ох, больно, должно быть! Только танк может выдержать такой сокрушительный удар. Попробуем ещё раз."

#. ja: 次は、追尾してくる連続攻撃に対する訓練を行います！<br>まずは、その「予兆」を感じてください。
#. de: Dann weiter im Text. Der nächste Angriff verfolgt sein Ziel und trifft mehrmals hintereinander. Seine Markierung hat diese Form<nbsp>...
#. fr: Cette fois-ci, il s'agit d'une attaque persistante qui suit vos mouvements<nbsp>! On la reconnaît à cette indication...
msgctxt "InstanceContentTextData:41132:0:0"
msgid "Next, let us practice how to handle a more persistent threat. Take note of this marker..."
msgstr "Теперь потренируемся справляться с более настойчивой угрозой. Запомни эту метку..."

#. ja: この「予兆」の後、標的に連続して攻撃が繰り出されます。<br>自身と味方が攻撃に当たらぬよう、移動しつつ回避してください。
#. de: Um keinen unnötigen Schaden zu erhalten, solltet Ihr durchgehend in Bewegung bleiben und so dem Angriff ausweichen. Haltet dabei auch Abstand von Euren Mitstreitern, um diese nicht zu gefährden.
#. fr: La cible de ce genre d'attaque a intérêt à rester en mouvement pour l'éviter, tout en prenant soin de ne pas croiser la route de ses équipiers<nbsp>!
msgctxt "InstanceContentTextData:41133:0:0"
msgid "What will follow is a chain of attacks that chase you doggedly. You must stay on the move, all the while keeping away from your allies."
msgstr "Дальше последует серия атак, которые будут неотступно преследовать тебя. Не стой на месте и держись подальше от союзников."

#. ja: おっと、攻撃が当たってしまったようですね。<br>自身にも味方にも被害が出ないよう、回避してください。
#. de: Oje, da wurde wohl jemand von der Attacke erwischt! Bleibt in Bewegung und haltet Abstand, um unnötigen Schaden auf Euch und Eure Mitstreiter zu vermeiden.
#. fr: Encore une fois, vous devez vous déplacer pour éviter la série d'attaques, tout en vous éloignant de vos équipiers.
msgctxt "InstanceContentTextData:41135:0:0"
msgid "Remember, you must evade the barrage while leading it away from your allies!"
msgstr "Помни: нужно уклоняться от серии ударов и уводить её подальше от союзников!"

#. ja: それでは、応用訓練に移りましょう。
#. de: Dann wollen wir uns mal der Prüfung widmen.
#. fr: Bien, il est temps de mettre à l'épreuve vos compétences.
msgctxt "InstanceContentTextData:41136:0:0"
msgid "Allow me to test all that you have learned thus far."
msgstr "А теперь проверим, чему ты научился<if $gn4>ась<else>ся</if>."

#. ja: 複数種類の攻撃を次々と繰り出しますので、<br>これまでの訓練を思い出し、被害を最小限に抑えてください。
#. de: Ihr werdet auf mehrere Angriffe hintereinander reagieren müssen. Erinnert Euch an unsere bisherigen Übungen und versucht, den Schaden so gut wie möglich zu minimieren.
#. fr: Pour l'examen pratique, vous devrez éviter diverses attaques en succession. Souvenez-vous de ce que vous venez d'apprendre<nbsp>!
msgctxt "InstanceContentTextData:41137:0:0"
msgid "In this exercise, you will face a slew of different attacks, each of which you must deal with appropriately to minimize the harm you sustain."
msgstr "В этом упражнении на тебя обрушится череда разных атак. Правильно реагируй на каждую, чтобы свести урон к минимуму."

#. ja: おっと、味方を巻き込んでしまったようですね。<br>味方との位置関係に気をつけてみましょう。
#. de: Oh nein, einer Eurer Mitstreiter wurde in den Angriff verwickelt. Seid Euch stets bewusst, wo Eure Kameraden stehen, um ihnen nicht unnötig Schaden zuzufügen.
#. fr: Une attaque dont vous étiez la cible a malheureusement touché un équipier. Positionnez-vous mieux pour éviter que ça ne se reproduise.
msgctxt "InstanceContentTextData:41138:0:0"
msgid "Oh dear, a party member was caught in the attack. Remember to be mindful of your allies' positions."
msgstr "Ой, союзника задело атакой. Следи за тем, где стоят товарищи."

#. ja: おっと、味方を巻き込みつつ、<br>地面に放たれた攻撃にも当たってしまったようですね。
#. de: Aah, sowohl Ihr selbst als auch einer Eurer Mitstreiter wurdet von dem Angriff getroffen.
#. fr: Non seulement vous avez pris l'attaque de plein fouet, mais vous avez aussi infligé des dégâts à un équipier...
msgctxt "InstanceContentTextData:41139:0:0"
msgid "Gods above! Not only did you hurt your poor ally, but you stood on unsafe ground as well!"
msgstr "Боги! Ты не только задел<if $gn4>а<else></if> бедного союзника, но и остался<if $gn4>ась<else>ся</if> на опасном участке!"

#. ja: おっと、味方の下に集まれませんでしたね。<br>こうなっては、被害は甚大です……。
#. de: Ach je, Ihr habt es nicht rechtzeitig zu Euren Mitstreitern geschafft. Bei kleinen Verletzungen wird es da nicht bleiben<nbsp>...
#. fr: Vous et vos équipiers n'avez pas su vous regrouper à temps, et le couperet est tombé.
msgctxt "InstanceContentTextData:41140:0:0"
msgid "Alas, you didn't reach your ally in time. A painful lesson..."
msgstr "Увы, ты не успел<if $gn4>а<else></if> добраться до союзника. Вот и болезненный урок..."

#. ja: おっと、味方の下に集まれなかったようですね。<br>さらに地面に放たれた攻撃にも当たってしまったようです。
#. de: Uhh, Ihr habt es nicht rechtzeitig zu Euren Mitstreitern geschafft. Darüber hinaus wurdet Ihr auch von dem Bodenangriff erwischt.
#. fr: Vous avez été incapable d'éviter, et par-dessus le marché, vous avez impliqué vos équipiers. Un peu de con<shy>cen<shy>tra<shy>tion<nbsp>!
msgctxt "InstanceContentTextData:41141:0:0"
msgid "Tsk-tsk. Not only did you fail to stand with your ally, you stood on unsafe ground as well!"
msgstr "Ай-ай-ай. Ты не только не успел<if $gn4>а<else></if> к союзнику, но и попал<if $gn4>а<else></if> под удар по земле!"

#. ja: おっと、盾役に向けられた攻撃が、<br>盾役以外にも当たってしまったようですね。
#. de: Oje, scheint, als hätte der mächtige Angriff nicht nur den Verteidiger erwischt!
#. fr: Cette attaque n'était censée toucher que le tank... Vous allez devoir recommencer.
msgctxt "InstanceContentTextData:41142:0:0"
msgid "Ye gods...that can't have been pleasant. Lest you forget, only the tank can withstand such lethal attacks."
msgstr "О боги... Удар, должно быть, был ужасным. Не забывай: такие смертоносные атаки выдержит только танк."

#. ja: おっと、盾役に向けられた攻撃に加え、<br>地面に放たれた攻撃への対処に失敗してしまったようですね。
#. de: Bei den Zwölf! Nicht nur wurde jemand außer dem Verteidiger von dem mächtigen Angriff erwischt, Ihr wurdet auch von dem Bodenangriff getroffen. Das muss ich leider als Fehlschlag notieren.
#. fr: Comme si ça ne suffisait pas d'encaisser cette attaque, vous avez aussi impliqué vos équipiers...
msgctxt "InstanceContentTextData:41143:0:0"
msgid "Are you all right!? That attack wasn't meant for more than the tank─and on unsafe ground, no less!"
msgstr "Ты в порядке!? Этот удар предназначался только танку, а ты ещё и на опасном участке стоял<if $gn4>а<else></if>!"

#. ja: おっと、連続して放たれる攻撃に当たってしまったようですね。<br>残念ながら、対処は失敗となります。
#. de: Oh nein, Ihr wurdet von dem Mehrfachangriff erwischt. Verzeiht, aber das werde ich als Fehlschlag zählen müssen.
#. fr: Je vous le concède, ce genre d'attaque n'est pas si simple à éviter. Surtout, restez bien en mouvement<nbsp>!
msgctxt "InstanceContentTextData:41144:0:0"
msgid "Unfortunately, you failed to evade all of the attacks, and have thereby failed this objective."
msgstr "К сожалению, ты не уклонился<if $gn4>ась<else>ся</if> от всех ударов и провалил<if $gn4>а<else></if> задание."

#. ja: おっと、攻撃に味方を巻き込んでしまったようですね。<br>残念ながら、対処は失敗となります。
#. de: Ach je, der auf Euch gerichtete Angriff hat auch einen Eurer Mitstreiter getroffen. Verzeiht, aber das werde ich als Fehlschlag zählen müssen.
#. fr: Vous devez vous déplacer de façon à ce que l'attaque ne touche personne. Courage, vous allez y arriver.
msgctxt "InstanceContentTextData:41145:0:0"
msgid "It would seem the attack targeting you inadvertently struck a party member. You'll need to retry this objective."
msgstr "Похоже, атака, нацеленная на тебя, задела и союзника. Придётся повторить задание."

#. ja: おっと、ご自身と味方が攻撃に当たってしまったようですね。<br>残念ながら、対処は失敗となります。
#. de: Oh nein, Ihr und Eure Mitstreiter wurden von dem Mehrfachangriff erwischt. Verzeiht, aber das werde ich als Fehlschlag zählen müssen.
#. fr: Aïe, vous et vos équipiers n'avez pas évité l'attaque comme il se doit. Mal<shy>heu<shy>reu<shy>se<shy>ment, c'est un échec.
msgctxt "InstanceContentTextData:41146:0:0"
msgid "You and your ally were both hit, I noticed. I'm afraid you have failed this objective."
msgstr "Я заметил<if $gn4>а<else></if>, что вы оба попали под удар. Боюсь, задание провалено."

#. ja: 適切に対応できなかった部分がありましたね。<br>開始地点へ戻って、もう一度、挑戦してみましょう！
#. de: Es gab leider einige Stellen, an denen Ihr die Prüfung nicht fehlerfrei bestehen konntet. Aber verliert hierdurch nicht den Mut! Begebt Euch einfach an den Startpunkt und versucht es erneut! Übung macht den Meister!
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment, tout n'était pas parfait<nbsp>! Désolé, mais vous allez devoir vous y recoller.
msgctxt "InstanceContentTextData:41147:0:0"
msgid "Alas, you didn't pass the challenge. Retake your starting position, and let's give it one more try! "
msgstr "Увы, испытание не пройдено. Вернись на исходную позицию и попробуй ещё раз!"

#. ja: 実にお見事、すべての攻撃に対処できていましたね！<br>応用訓練は、文句なく完了ですよ！
#. de: Wahrlich vorbildlich, Ihr habt auf alle Angriffe perfekt reagiert! Damit habt ihr die Prüfung mit Bravour bestanden!
#. fr: Vous avez admirablement géré toutes les situations proposées. Bravo, c'est une réussite totale<nbsp>!
msgctxt "InstanceContentTextData:41148:0:0"
msgid "You handled every last threat with finesse. It is with pleasure that I declare you have passed the challenge!"
msgstr "Ты ловко справился<if $gn4>ась<else>ся</if> со всеми угрозами. С радостью объявляю: испытание пройдено!"

#. ja: 訓練開始まで　3　秒！
#. de: Die Übung beginnt in 3 Sekunden!
#. fr: 3...
msgctxt "InstanceContentTextData:41149:0:0"
msgid "Commencing in 3..."
msgstr "Начало через 3..."

#. ja: 訓練開始まで　2　秒！
#. de: Die Übung beginnt in 2 Sekunden!
#. fr: 2...
msgctxt "InstanceContentTextData:41150:0:0"
msgid "2..."
msgstr "2..."

#. ja: 訓練開始まで　1　秒！
#. de: Die Übung beginnt in 1 Sekunde!
#. fr: 1...
msgctxt "InstanceContentTextData:41151:0:0"
msgid "1..."
msgstr "1..."

#. ja: それでは、訓練を始めましょう！
#. de: Lasst uns die Übung beginnen!
#. fr: Commençons<nbsp>!
msgctxt "InstanceContentTextData:41152:0:0"
msgid "Let the exercise begin!"
msgstr "Начинаем упражнение!"

#. ja: 次の訓練に移りますので、開始地点へ移動してください！
#. de: Zeit für die nächste Lektion! Stellt Euch bitte auf den Startpunkt!
#. fr: Pour la suite de l'exercice, veuillez vous rendre au prochain point de départ.
msgctxt "InstanceContentTextData:41153:0:0"
msgid "To start the next exercise, take your starting position."
msgstr "Займи исходную позицию, чтобы начать следующее упражнение."

#. ja: 素晴らしい判断です！<br>攻撃に対し、見事に対応できていますね！
#. de: Gut eingeschätzt! Ihr konntet korrekt auf den Angriff reagieren!
#. fr: Bravo, beaux réflexes<nbsp>! Vous avez réagi comme il fallait.
msgctxt "InstanceContentTextData:41154:0:0"
msgid "Masterfully judged! You handled that flawlessly."
msgstr "Отличное решение! Ты безупречно справился<if $gn4>ась<else>ся</if> с атакой."

#. ja: 的確な対応、お見事です！
#. de: Fantastisch, weiter so!
#. fr: Magnifique, c'est exactement ce que j'attendais de vous<nbsp>!
msgctxt "InstanceContentTextData:41155:0:0"
msgid "Precisely what I had hoped to see!"
msgstr "Именно такую реакцию я и хотел увидеть!"

#. ja: 訓練の内容を、しっかり実践できておりましたね！
#. de: Ihr habt die Theorie perfekt in die Praxis umgesetzt, wahrlich meisterhaft!
#. fr: Je suis heureux de constater que vous avez appliqué mes in<shy>struc<shy>tions à la lettre.
msgctxt "InstanceContentTextData:41156:0:0"
msgid "I'm pleased you took the lesson to heart."
msgstr "Рад<if $gn4>а<else></if>, что ты усвоил<if $gn4>а<else></if> урок."

#. ja: 冒険者の間では、この攻撃のことを被害の「頭割り」と呼ぶようです。<br>覚えておいて、損はないでしょう。
#. de: Unter Abenteurern werden solche Angriffe neben anderen Bezeichnungen wohl auch „Stapel“ genannt. Kurioser Ausdruck, aber es kann bestimmt nicht schaden, ihn im Hinterkopf zu behalten.
#. fr: Parmi les aventuriers, on parle d'attaque “à dégâts partagés”. Tâchez de vous en souvenir, ça ne mange pas de pain.
#, aeria-term-model-exception: Rings 3b282cc7f201
msgctxt "InstanceContentTextData:41157:0:0"
msgid "Among you adventurers, I'm given to understand that these are known as “stack markers.” Rings odd to my ear, but I suppose it matters not."
msgstr "Слышал<if $gn4>а<else></if>, вы, приключенцы, называете такие атаки «метками сбора». Странное название, но пусть будет."

#. ja: この「予兆」の攻撃は強力ですので、盾役として受ける際は、<br>ぜひ被害を軽減させられるアビリティなどを使ってみてください。
#. de: Angriffe dieser Art fügen enorm hohen Schaden zu. Übernehmt Ihr also die Rolle des Verteidigers, solltet Ihr versuchen, den Schaden mit entsprechenden Fä<shy>hig<shy>kei<shy>ten zu reduzieren.
#. fr: Face à ce genre d'attaque dans le rôle de tank, je vous recommande chaudement d'utiliser une aptitude de réduction des dégâts.
msgctxt "InstanceContentTextData:41158:0:0"
msgid "These attacks pack quite a punch. Should it fall to you to deal with it, you'd do well to employ what abilities you have to lighten the damage."
msgstr "Эти атаки бьют очень больно. Если тебе предстоит принять такой удар, используй способности, снижающие урон."

#. ja: 基本訓練1の目標を達成せよ！
#. de: Schließe Übungseinheit 1 erfolgreich ab!
#. fr: Réussir le premier objectif
msgctxt "InstanceContentTextData:41200:0:0"
msgid "Clear the First Training Objective"
msgstr "Выполни первое задание базовой тренировки"

#. ja: 基本訓練2の目標を達成せよ！
#. de: Schließe Übungseinheit 2 erfolgreich ab!
#. fr: Réussir le deuxième objectif
msgctxt "InstanceContentTextData:41201:0:0"
msgid "Clear the Second Training Objective"
msgstr "Выполни второе задание базовой тренировки"

#. ja: 基本訓練3の目標を達成せよ！
#. de: Schließe Übungseinheit 3 erfolgreich ab!
#. fr: Réussir le troisième objectif
msgctxt "InstanceContentTextData:41202:0:0"
msgid "Clear the Third Training Objective"
msgstr "Выполни третье задание базовой тренировки"

#. ja: 基本訓練4の目標を達成せよ！
#. de: Schließe Übungseinheit 4 erfolgreich ab!
#. fr: Réussir le quatrième objectif
msgctxt "InstanceContentTextData:41203:0:0"
msgid "Clear the Fourth Training Objective"
msgstr "Пройдите четвёртое задание базовой тренировки"

#. ja: 基本訓練5の目標を達成せよ！
#. de: Schließe Übungseinheit 5 erfolgreich ab!
#. fr: Réussir le cinquième objectif
msgctxt "InstanceContentTextData:41204:0:0"
msgid "Clear the Fifth Training Objective"
msgstr "Пройдите пятое задание базовой тренировки"

#. ja: 訓練担当官と会話しろ
#. de: Sprich mit dem Ausbilder
#. fr: Parler au superviseur de la formation
msgctxt "InstanceContentTextData:41205:0:0"
msgid "Speak with the Master of Trials"
msgstr "Поговорите с инструктором"

#. ja: 応用訓練の目標をすべて達成せよ！
#. de: Schließe alle Prüfungseinheiten erfolgreich ab!
#. fr: Réussir tous les objectifs
msgctxt "InstanceContentTextData:41206:0:0"
msgid "Clear All Challenge Objectives"
msgstr "Пройдите все задания продвинутой тренировки"

#. ja: 応用訓練1の目標を達成せよ！
#. de: Schließe Prüfungseinheit 1 erfolgreich ab!
#. fr: Réussir le premier objectif
msgctxt "InstanceContentTextData:41207:0:0"
msgid "Clear the First Challenge Objective"
msgstr "Пройдите первое задание продвинутой тренировки"

#. ja: 応用訓練2の目標を達成せよ！
#. de: Schließe Prüfungseinheit 2 erfolgreich ab!
#. fr: Réussir le deuxième objectif
msgctxt "InstanceContentTextData:41208:0:0"
msgid "Clear the Second Challenge Objective"
msgstr "Пройдите второе задание продвинутой тренировки"

#. ja: 応用訓練3の目標を達成せよ！
#. de: Schließe Prüfungseinheit 3 erfolgreich ab!
#. fr: Réussir le troisième objectif
msgctxt "InstanceContentTextData:41209:0:0"
msgid "Clear the Third Challenge Objective"
msgstr "Пройдите третье задание продвинутой тренировки"

#. ja: 応用訓練4の目標を達成せよ！
#. de: Schließe Prüfungseinheit 4 erfolgreich ab!
#. fr: Réussir le quatrième objectif
msgctxt "InstanceContentTextData:41210:0:0"
msgid "Clear the Fourth Challenge Objective"
msgstr "Пройдите четвёртое задание продвинутой тренировки"

#. ja: さすがは<split " " 2><string $gs1></split>殿、対処成功です！
#. de: Fantastisch! Ihr habt perfekt reagiert, <if $gn4>verehrte Frau<else>verehrter Herr</if> <split " " 2><string $gs1></split>!
#. fr: Fé<shy>li<shy>ci<shy>ta<shy>tions, <if $gn4>Madame<else>Monsieur</if> <split " " 2><string $gs1></split>, vous vous en êtes remarquablement <if $gn4>sortie<else>sorti</if><nbsp>!
#. macro: <if $gn4>Mistress<else>Master</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <split " " 2><string $gs1></split> — the last name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:41211:0:0"
msgid "Bravo, <if $gn4>Mistress<else>Master</if> <split \" \" 2><string $gs1></split>!"
msgstr "Браво, <if $gn4>госпожа<else>господин</if> <split \" \" 2><string $gs1></split>!"

#. ja: 開始地点へ戻って、もう一度、挑戦してみましょう！
#. de: Kehrt zum Startpunkt zurück und versucht es erneut!
#. fr: Retournez au point de départ et essayez encore une fois<nbsp>!
msgctxt "InstanceContentTextData:41212:0:0"
msgid "Retake your starting position, and let's give it one more try!"
msgstr "Вернитесь на стартовую позицию и попробуем ещё раз!"

#. ja: 素晴らしい、これで基本訓練は完了です！<br>応用訓練に移りますので、まずは私のところへ来てください。
#. de: Einwandfrei! Damit habt Ihr alle Übungs<shy>einheiten erfolgreich abgeschlossen! Sprecht mich bitte an, sobald Ihr bereit seid, euch der letzten Prüfung zu stellen.
#. fr: Bravo, vous avez accompli tous les objectifs<nbsp>! Venez me parler lorsque vous serez <if $gn4>prête<else>prêt</if> à commencer l'examen pratique.
msgctxt "InstanceContentTextData:41213:0:0"
msgid "Spectacular work! With that, your basic training is complete. Now, come and speak with me if you'd like to attempt my final challenge!"
msgstr "Великолепно! Базовая тренировка завершена. Хотите испытать себя в моём финальном испытании? Тогда подойдите ко мне!"

#. ja: では、応用訓練を始めましょう。<br>準備がよければ、開始地点に移動してください。
#. de: Dann ist es jetzt Zeit für Eure Prüfung. Stellt Euch auf den Startpunkt, um zu beginnen.
#. fr: Très bien, allons-y. Postez-vous au point de départ quand vous serez <if $gn4>prête<else>prêt</if>.
msgctxt "InstanceContentTextData:41214:0:0"
msgid "We will now begin the final challenge. Once you are prepared, take your starting position."
msgstr "Приступим к финальному испытанию. Как будете готовы, встаньте на стартовую позицию."

#. ja: 基本訓練をやり直すのですね、承知しました！<br>それでは、開始地点に移動してください。
#. de: Ihr würdet die Übungen gerne wiederholen? Sehr gerne, dann stellt Euch bitte auf den Startpunkt.
#. fr: Vous préférez recommencer<nbsp>? Aucun problème, allez vous poster au point de départ.
msgctxt "InstanceContentTextData:41215:0:0"
msgid "You'd like to start over? No problem at all! Go ahead and retake your starting position."
msgstr "Хотите начать сначала? Без проблем! Встаньте на стартовую позицию."

#. ja: さすがは<split " " 2><string $gs1></split>殿、<br>素晴らしい動きですね！
#. de: Flink wie ein Chocobo, bravo!
#. fr: Remarquable, <if $gn4>Madame<else>Monsieur</if> <split " " 2><string $gs1></split><nbsp>! Vos mouvements mériteraient d'être montrés à tous les novices<nbsp>!
#. macro: <if $gn4>Mistress<else>Master</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <split " " 2><string $gs1></split> — the last name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:41216:0:0"
msgid "Your grasp of combat tactics is commendable indeed, <if $gn4>Mistress<else>Master</if> <split \" \" 2><string $gs1></split>."
msgstr "Вы прекрасно разбираетесь в боевой тактике, <if $gn4>госпожа<else>господин</if> <split \" \" 2><string $gs1></split>!"

#. ja: おっと、地面に放たれた攻撃に当たってしまったようですね。<br>残念ながら、対処は失敗となります。
#. de: Oh, Ihr wurdet leider von der Bodenattacke getroffen. Verzeiht, aber dieser Versuch gilt somit als Fehlschlag.
#. fr: Vous avez été <if $gn4>touchée<else>touché</if> par une attaque... Mal<shy>heu<shy>reu<shy>se<shy>ment, vous allez devoir recommencer.
msgctxt "InstanceContentTextData:41217:0:0"
msgid "Careful! You were on unsafe ground just now. You'll need to retry the objective."
msgstr "Осторожно! Вы только что попали под атаку на земле. Придётся повторить задание."

#. ja: ようこそ<split " " 2><string $gs1></split>殿！<br>今回の訓練では、新たな攻撃を体験していただきます。
#. de: Willkommen, <if $gn4>verehrte Frau<else>verehrter Herr</if> <split " " 2><string $gs1></split>! In den heutigen Übungen werdet Ihr einige neue Arten von Angriffen kennenlernen.
#. fr: Bienvenue, <if $gn4>Madame<else>Monsieur</if> <split " " 2><string $gs1></split>. J'ai préparé pour vous de nouvelles attaques diverses et variées.
#. macro: <if $gn4>Mistress<else>Master</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <split " " 2><string $gs1></split> — the last name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:41218:0:0"
msgid "Welcome, <if $gn4>Mistress<else>Master</if> <split \" \" 2><string $gs1></split>. In this training exercise, we will have you carry out a medley of cutting-edge tactical maneuvers."
msgstr "Добро пожаловать, <if $gn4>госпожа<else>господин</if> <split \" \" 2><string $gs1></split>. На этой тренировке вы освоите целый ряд новейших тактических приёмов."

#. ja: 場内にいる補助官が敵役として攻撃を実行しますので、<br>その「予兆」を感じ取り、適切に対処しましょう。
#. de: In diesen Übungen wird einer unserer Lehrmeister die Rolle des Gegners über<shy>nehmen. So könnt Ihr lernen, die Wir<shy>kungs<shy>be<shy>reiche der Angriffe schnell zu erkennen und entsprechend zu reagieren.
#. fr: C'est l'officière formatrice qui va vous attaquer. Soyez <if $gn4>attentive<else>attentif</if> aux indications qui vont apparaître et esquivez en conséquence.
msgctxt "InstanceContentTextData:41219:0:0"
msgid "My agent here will serve as your opponent. Try to get a sense for her oncoming attacks, and handle them accordingly."
msgstr "Моя помощница будет вашим противником. Постарайтесь предугадать её атаки и вовремя на них реагировать."

#. ja: それでは準備ができましたら、開始地点に移動してください。
#. de: Also dann, stellt Euch bitte auf den Startpunkt, damit wir beginnen können.
#. fr: Lorsque vous serez <if $gn4>prête<else>prêt</if> à commencer, veuillez vous poster au point de départ.
msgctxt "InstanceContentTextData:41220:0:0"
msgid "Take your starting position when you are ready to begin."
msgstr "Когда будете готовы начать, встаньте на стартовую позицию."

#. ja: 最初に吹き飛ばし攻撃に対する訓練を行います！<br>まずは、その「予兆」を感じてください。
#. de: Lasst uns mit einem Rückstoß beginnen! Zunächst die Markierung<nbsp>...
#. fr: Pour commencer, parlons des attaques à projection. Vous les reconnaîtrez à cette indication.
msgctxt "InstanceContentTextData:41221:0:0"
msgid "First, let's discuss knockback attacks. The marker will look like this..."
msgstr "Для начала поговорим об атаках с отбрасыванием. Вот как выглядит их предупреждение..."

#. ja: この「予兆」の後、強力な攻撃が繰り出され、<br>命中地点を中心に、外側へと吹き飛ばされます。
#. de: Angriffe dieser Art stoßen Euch vom Zentrum ausgehend zurück.
#. fr: Si vous êtes <if $gn4>visée<else>visé</if>, vous n'aurez qu'un instant pour vous placer avant d'être <if $gn4>projetée<else>projeté</if> à une certaine distance du point d'impact.
msgctxt "InstanceContentTextData:41222:0:0"
msgid "As soon as you sense it, you will have but a few moments to position yourself before you are pushed a set distance from its point of impact."
msgstr "Как только заметите предупреждение, у вас останется всего несколько мгновений, чтобы занять позицию. Затем вас отбросит на определённое расстояние от места удара."

#. ja: 外周の雷撃に当たってしまわないよう、<br>吹き飛ばされる距離を考慮しつつ、立ち位置を変えましょう。
#. de: Bei dieser Übung müsst Ihr Euch also so positionieren, dass Euch der Rückstoß nicht in den äußeren Ring voller Blitzäther schleudert.
#. fr: J'ai placé un anneau de foudre autour de l'arène. Tâchez de ne pas atterrir dedans, ou vous serez <if $gn4>électrocutée<else>électrocuté</if><nbsp>!
msgctxt "InstanceContentTextData:41223:0:0"
msgid "For this exercise, I have placed a ring of lightning aether around the arena. Your goal is to position yourself such that you won't be sent hurtling into it!"
msgstr "Для этого упражнения я окружил арену кольцом молний. Ваша задача — занять такую позицию, чтобы вас не отбросило прямо в него!"

#. ja: おっと、外周の雷撃に当たってしまいましたね。<br>吹き飛ばされる距離を考慮し、攻撃の命中地点に寄りましょう。
#. de: Aah, Ihr habt leider den äußeren Ring berührt! Bedenkt die Stärke des Rückstoßes und positioniert Euch entsprechend an dessen Zentrum.
#. fr: Ah, vous avez été <if $gn4>projetée<else>projeté</if> dans le cercle d'énergie électrique. Tentez de mieux évaluer la distance<nbsp>!
msgctxt "InstanceContentTextData:41224:0:0"
msgid "Oh dear... That lightning must have given you quite the nasty jolt. Try to stand as close as you can to the point of impact!"
msgstr "Ох, вас всё-таки отбросило в кольцо молний... Постарайтесь встать как можно ближе к месту удара!"

#. ja: 次は、吹き飛ばし攻撃の派生に対処していきましょう。<br>まずは、その「予兆」を感じてください。
#. de: Sehen wir uns als Nächstes eine häufige Variation des Rückstoßangriffs an! Seine Markierung sieht für gewöhnlich wie folgt aus<nbsp>...
#. fr: À présent, nous allons voir une variante d'attaque à projection... Regardez d'abord l'indication.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:41225:0:0"
msgid "While we're at it, let's review a common variant. Take note of <i>this</i> marker..."
msgstr "А теперь разберём распространённый вариант такой атаки. Обратите внимание на <i>это</i> предупреждение..."

#. ja: この「予兆」の後に繰り出される吹き飛ばし攻撃は、<br>命中地点にいると、大打撃を受けてしまいます。
#. de: Diese Version stößt Euch nicht nur zurück, sondern fügt jenen, die sich direkt auf dem Ausgangspunkt befinden, sehr hohen Schaden zu.
#. fr: Con<shy>trai<shy>re<shy>ment à l'attaque précédente, si vous vous tenez près du centre, vous souffrirez de lourds dégâts.
msgctxt "InstanceContentTextData:41226:0:0"
msgid "Unlike last time, I don't recommend you stand directly in the center of it, lest you receive a most painful blow to the skull."
msgstr "В отличие от предыдущей атаки, здесь лучше не стоять прямо в центре: иначе получите очень болезненный удар по голове."

#. ja: 外周の雷撃に当たってしまわないよう、<br>吹き飛ばされる距離を考慮しつつ、立ち位置を変えましょう。
#. de: Ihr müsst Euch also gerade so außerhalb des Angriffspunkts positionieren, dass Ihr weder direkt getroffen noch gleichzeitig vom Rückstoß in den Blitzäther geschleudert werdet.
#. fr: Et une fois de plus, vous devrez éviter d'être <if $gn4>électrocutée<else>électrocuté</if>. Positionnez-vous comme il faut<nbsp>!
msgctxt "InstanceContentTextData:41227:0:0"
msgid "And so, once more, I challenge you to avoid being flung into the lightning. Where will you stand this time?"
msgstr "И снова постарайтесь не попасть в кольцо молний. Где встанете на этот раз?"

#. ja: 命中地点で攻撃を受け、痛手を被ってしまったようですね。<br>残念ながら、対処は失敗となります。
#. de: Uff, Ihr standet leider innerhalb des Angriffs und wurdet direkt von ihm getroffen. Das probieren wir lieber ein weiteres Mal.
#. fr: Voilà ce qui arrive quand vous ne m'écoutez pas. Surtout, ne restez pas dans la zone de l'attaque<nbsp>!
msgctxt "InstanceContentTextData:41228:0:0"
msgid "Remember, the glowing ground is itself a potent attack, and thus unsafe to stand in. Let's have you retry this objective."
msgstr "Помните: сама светящаяся область опасна. Не стойте в ней. Попробуем ещё раз."

#. ja: おっと、外周の雷撃に当たってしまいましたね。<br>吹き飛ばされる距離を考慮し、もう少し命中地点に寄りましょう。
#. de: Aah, Ihr habt leider den äußeren Ring berührt! Bedenkt die Stärke des Rückstoßes und positioniert Euch entsprechend am Rand des Angriffs.
#. fr: L'effet de projection vous a <if $gn4>envoyée<else>envoyé</if> pile dans le cercle électrique. Réévaluez vos distances, s'il vous plaît<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:41229:0:0"
msgid "That lightning is rather unpleasant to the touch, isn't it? I suggest you stand at the very <i>edge</i> of the area of effect attack."
msgstr "Молнии, конечно, неприятно бьют током. Советую встать у самого <i>края</i> области атаки."

#. ja: 次は、命中地点に近いほど被害が大きくなる攻撃です。<br>まずは、その「予兆」を感じてください。
#. de: Dann weiter im Text. Der nächste Angriff verursacht mehr Schaden, je näher Ihr Euch an seinem Ausgangspunkt befindet. Prägt Euch zunächst die Form seiner Markierung ein<nbsp>...
#. fr: Maintenant, vous allez découvrir une autre attaque de zone, dite de proximité.
msgctxt "InstanceContentTextData:41230:0:0"
msgid "Next, we'll demonstrate a proximity attack. Its marker pulses outward, like so..."
msgstr "Теперь покажу атаку, которая тем сильнее, чем ближе вы к месту удара. Вот как выглядит её предупреждение..."

#. ja: この「予兆」の後に繰り出される攻撃は、<br>命中地点に近いほど、大打撃を受けてしまいます。
#. de: Befindet Ihr Euch zu nah am Zentrum des Angriffs, so wird es wohl kaum bei einer kleinen Wunde bleiben.
#. fr: Regardez bien l'indication et dites-vous que plus vous serez proche du point d'impact, plus vous encaisserez des dégâts importants.
msgctxt "InstanceContentTextData:41231:0:0"
msgid "With these, the closer you are to its point of impact, the greater the damage you stand to take."
msgstr "Чем ближе вы к месту удара, тем больше урона получите."

#. ja: 「予兆」で命中地点を確認し、<br>そこから離れるように移動して被害を抑えましょう。
#. de: Sobald ihr also einen Angriff dieser Art bemerkt, solltet Ihr Euch zügig von ihm entfernen.
#. fr: Évaluez bien la situation et éloignez-vous le plus possible<nbsp>!
msgctxt "InstanceContentTextData:41232:0:0"
msgid "Thus, whenever you see that ominous light pulsing along the ground, I advise you to distance yourself as much as possible."
msgstr "Увидели зловещее свечение на земле? Отойдите от него как можно дальше."

#. ja: 命中地点に近すぎ、大打撃を受けてしまったようですね。<br>できるだけ距離をとり、被害を抑えましょう。
#. de: Oh nein, Ihr wart dem Angriff zu nah und habt schweren Schaden erhalten. Entfernt Euch so weit wie möglich vom Ausgangspunkt des Angriffs, um den Schaden zu minimieren.
#. fr: Vous étiez bien trop proche du point d'impact, enfin... Recommencez, et prenez vos distances, cette fois.
msgctxt "InstanceContentTextData:41233:0:0"
msgid "Too close to the point of impact! You want to keep your distance from these to minimize the damage."
msgstr "Вы стояли слишком близко к месту удара и получили большой урон. Держитесь подальше, чтобы свести его к минимуму."

#. ja: 次は、「予兆」の内側にあえて立つことで、<br>周囲への被害を抑えられる攻撃に対処しましょう。
#. de: Als Nächstes sehen wir uns Türme an. Der Name dieser Angriffe sollte mit einem Blick auf ihre Markierung deutlich werden<nbsp>...
#. fr: Cette fois-ci, il s'agit d'une attaque que vous avez tout intérêt à encaisser de plein fouet<nbsp>! Je m'explique.
msgctxt "InstanceContentTextData:41234:0:0"
msgid "Next, let's move on to tower tactics! This type of attack is one that must be endured rather than avoided."
msgstr "Теперь перейдём к тактике башен! Такую атаку нужно не избегать, а принять на себя."

#. ja: この「予兆」の後に繰り出される攻撃は、<br>全員が回避した場合、致命的な全体攻撃が発生してしまいます。
#. de: Befindet sich niemand innerhalb des Wir<shy>kungs<shy>be<shy>reichs des Angriffs, so nimmt die gesamte Gruppe stark erhöhten Schaden.
#. fr: Si une des tours est laissée inoccupée, c'est toute l'équipe qui va subir des dégâts catastrophiques.
msgctxt "InstanceContentTextData:41235:0:0"
msgid "See the tower marker? If no one stands inside to weaken its impact, the entire party will suffer a devastating blow."
msgstr "Видите отметку башни? Если никто не встанет внутрь, чтобы смягчить удар, вся группа получит сокрушительный урон."

#. ja: したがって、誰かが身を挺して「予兆」内に入り、<br>あえて攻撃を受けて、全体攻撃の発生を止める必要があるのです。
#. de: Daher muss sich mindestens ein Mitglied der Gruppe entsprechend positionieren und den Angriff abfangen.
#. fr: Pour cette raison, chacun d'entre vous doit se placer près d'une tour et essuyer le coup, à moins de payer le prix fort<nbsp>!
msgctxt "InstanceContentTextData:41236:0:0"
msgid "Therefore, one person must volunteer to take the tower, shielding the rest of the party from far greater casualties."
msgstr "Поэтому кому-то придётся принять удар на себя и защитить остальных от куда более тяжёлых последствий."

#. ja: おっと、致命的な全体攻撃が発生してしまいましたね。<br>味方と手分けし、「予兆」の内側で攻撃を受け止めましょう。
#. de: Ach je, Ihr habt Euren Turm nicht rechtzeitig erreicht, wodurch ein starker Gruppenangriff ausgelöst wurde. Verzeiht, aber das werde ich als Fehlschlag zählen müssen.
#. fr: Et voilà, c'est exactement ce qui arrive quand on n'écoute pas ce que je dis... N'oubliez pas<nbsp>: encaissez l'attaque<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:41237:0:0"
msgid "And <i>that</i> is what happens when a tower is left unoccupied. Remember, this is a team effort!"
msgstr "Вот что бывает, если оставить башню пустой. Помните: вы действуете сообща, и <i>всем достанется</i>!"

#. ja: 次も、「予兆」の内側にあえて立つことで、<br>被害を抑えられる攻撃となります。
#. de: Als Nächstes eine Variation des Turms. Mag die Markierung dieses Angriffs auch anders sein, so funktioniert er genau gleich und muss abgefangen werden<nbsp>...
#. fr: La prochaine attaque ressemble à la précédente, dans la mesure où vous allez une fois de plus devoir encaisser sans broncher.
msgctxt "InstanceContentTextData:41238:0:0"
msgid "Now let's cover a variant of the tower marker. Again, one of you will need to stand inside to protect the others."
msgstr "Теперь разберём другой вариант атаки с башней. Отметка выглядит иначе, но действовать нужно так же: кто-то должен встать внутрь и защитить остальных."

#. ja: この「予兆」の後に繰り出される攻撃は、<br>全員が回避した場合、致命的な全体攻撃が発生してしまいます。
#. de: Befindet sich niemand innerhalb des Wir<shy>kungs<shy>be<shy>reichs des Angriffs, so nimmt die gesamte Gruppe stark erhöhten Schaden, genau wie vorher.
#. fr: Au cas où vous auriez oublié, vous devez à tout prix éviter qu'une des aires de dégâts reste vacante.
msgctxt "InstanceContentTextData:41239:0:0"
msgid "Lest you forget, if the tower goes unoccupied, the entire party will pay the price."
msgstr "Не забывайте: если башня останется пустой, пострадает вся группа."

#. ja: 「予兆」の内側で魔力の球体を受け止め、<br>致命的な全体攻撃の発生を防ぎましょう。
#. de: Bleibt also innerhalb der Markierung stehen, bis die Magiekugel vollständig den Boden berührt hat.
#. fr: Restez donc au centre du cercle et laissez-vous frapper par la boule d'énergie magique qui s'écrase sur le sol.
msgctxt "InstanceContentTextData:41240:0:0"
msgid "In this case, you must ensure you are standing within the bounds of the circle before the arcane orb strikes the ground."
msgstr "Вам нужно встать внутрь круга и принять магическую сферу до того, как она ударится о землю."

#. ja: おっと、致命的な全体攻撃が発生してしまいましたね。<br>味方と手分けし、「予兆」の内側で攻撃を受け止めましょう。
#. de: Ach je, Ihr habt Euren Turm nicht rechtzeitig erreicht, wodurch ein starker Gruppenangriff ausgelöst wurde. Verzeiht, aber das werde ich als Fehlschlag zählen müssen.
#. fr: Des fois, je me demande si vous m'écoutez vraiment... Faites-moi confiance, encaissez l'attaque et tout se passera bien<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:41241:0:0"
msgid "And <i>that</i> is what happens when a tower is left unoccupied. Remember, this is a team effort!"
msgstr "Вот что бывает, если оставить башню пустой. Помните: вы действуете сообща, и <i>всем достанется</i>!"

#. ja: それでは、応用訓練に移りましょう。
#. de: Dann wollen wir uns mal der Prüfung widmen.
#. fr: Bien, il est temps de mettre à l'épreuve vos compétences.
msgctxt "InstanceContentTextData:41242:0:0"
msgid "Allow me to test all that you have learned thus far."
msgstr "Позвольте проверить, чему вы успели научиться."

#. ja: 複数種類の攻撃を次々と繰り出しますので、<br>これまでの訓練を思い出し、被害を最小限に抑えてください。
#. de: Ihr werdet auf mehrere Angriffe hintereinander reagieren müssen. Erinnert Euch an unsere bisherigen Übungen und versucht, den Schaden so gut wie möglich zu minimieren.
#. fr: Pour l'examen pratique, vous devrez éviter diverses attaques en succession. Souvenez-vous de ce que vous venez d'apprendre<nbsp>!
msgctxt "InstanceContentTextData:41243:0:0"
msgid "In this exercise, you will face a slew of different attacks, each of which you must deal with appropriately to minimize the harm you sustain."
msgstr "В этом испытании на вас обрушится целый ряд разных атак. Вспомните всё, чему научились, и постарайтесь свести полученный урон к минимуму."

#. ja: おっと、外周の雷撃に当たってしまいましたね。<br>吹き飛ばされる距離を考慮し、攻撃の命中地点に寄りましょう。
#. de: Aah, Ihr habt leider den äußeren Ring berührt! Bedenkt die Stärke des Rückstoßes und positioniert Euch entsprechend an dessen Zentrum.
#. fr: Ce bon vieux cercle de foudre... Ça pique, hein<nbsp>? La prochaine fois, vous évaluerez mieux la distance, j'en suis sûr.
msgctxt "InstanceContentTextData:41244:0:0"
msgid "Oh dear, straight into the lightning... Try to stand a bit closer to the point of impact next time."
msgstr "Ох, угодили прямо в молнии... В следующий раз встаньте немного ближе к месту удара."

#. ja: おっと、外周の雷撃に加えて、<br>地面に放たれた攻撃にも当たってしまったようですね。
#. de: Ach je, Ihr wurdet sowohl in den Blitzäther geschleudert als auch von dem Bodenangriff getroffen.
#. fr: Allons bon, le cercle électrique <i>et</i> l'attaque en pleine figure... Ne vous inquiétez pas, on va recommencer.
msgctxt "InstanceContentTextData:41245:0:0"
msgid "Poor thing. Not only were you knocked into the lightning, but you stood on unsafe ground as well."
msgstr "Бедняга! Мало того что вас отбросило в молнии, так вы ещё и стояли на опасном участке."

#. ja: 命中地点で攻撃を受け、痛手を被ってしまったようですね。<br>残念ながら、対処は失敗となります。
#. de: Oh nein, Ihr standet leider innerhalb des Angriffs und wurdet direkt von ihm getroffen. Verzeiht, aber das werde ich als Fehlschlag zählen müssen.
#. fr: Si vous restez aussi proche de la zone d'attaque, je ne peux rien pour vous. Concentrez-vous, je vous prie.
msgctxt "InstanceContentTextData:41246:0:0"
msgid "Alas, you were too close to the proximity attack. Let's have you retry the objective."
msgstr "Вы подошли слишком близко к атаке по близости. Придётся повторить задание."

#. ja: おっと、吹き飛ばし攻撃に加え、<br>致命的な全体攻撃への対処に失敗したようですね。
#. de: Oh je, Ihr konntet weder den Rückstoß unbeschadet überstehen noch rechtzeitig Euren Turm besetzen. Das werde ich leider als Fehlschlag notieren müssen.
#. fr: Par les Douze, vous avez été <if $gn4>ballottée<else>ballotté</if> comme une feuille morte<nbsp>!
msgctxt "InstanceContentTextData:41247:0:0"
msgid "By the gods... Not only did you take a nasty blow from the attack, but your empty tower inflicted catastrophic injury upon the rest of your party..."
msgstr "Боги... Вы не только получили сильный удар, но и оставили башню пустой, из-за чего вся группа пострадала..."

#. ja: おっと、致命的な全体攻撃が発生してしまいましたね。<br>味方と手分けし、「予兆」の内側で攻撃を受け止めましょう。
#. de: Bei den Zwölf! Ihr habt es leider nicht rechtzeitig zu Eurem Turm geschaft. Teilt Euch auf und stellt Euch jeweils in eine Markierung, um den Angriff abzufangen.
#. fr: Ouille, j'ai mal pour toute votre équipe... Vous allez essayer de nouveau, en vous coordonnant comme il faut<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:41248:0:0"
msgid "Lesson learned: an empty tower <i>hurts</i>. Whenever you see one, be not afraid to stand against the attack─your allies will thank you!"
msgstr "Вот что бывает, если оставить башню пустой. Не бойтесь принять удар на себя, когда увидите такую отметку: союзники будут вам <i>благодарны</i>!"

#. ja: 命中地点に近すぎ、大打撃を受けてしまったようですね。<br>残念ながら、対処は失敗となります。
#. de: Oh nein, Ihr wart dem Angriff zu nah und habt schweren Schaden erhalten. Verzeiht, aber das werde ich als Fehlschlag zählen müssen.
#. fr: A force de s'approcher, on finit par se brûler... Au bout d'un moment, vous allez y arriver<nbsp>! Ou pas...
msgctxt "InstanceContentTextData:41249:0:0"
msgid "I'm afraid you stood too close to the proximity attack. You'll need to retry the objective."
msgstr "Боюсь, вы стояли слишком близко к атаке по близости. Придётся повторить задание."

#. ja: おっと、致命的な全体攻撃が発生してしまいましたね。<br>味方と手分けし、「予兆」の内側で攻撃を受け止めましょう。
#. de: Ach je, Ihr habt Euren Turm nicht rechtzeitig erreicht, wodurch ein starker Gruppenangriff ausgelöst wurde. Verzeiht, aber das werde ich als Fehlschlag zählen müssen.
#. fr: Encore un cas de mauvaise coordination. Observez les mouvements de vos équipiers, et placez vous au bon endroit<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:41250:0:0"
msgid "Lesson learned: an empty tower <i>hurts</i>. Whenever you see one, be not afraid to stand against the attack─your allies will thank you!"
msgstr "Вот что бывает, если оставить башню пустой. Не бойтесь принять удар на себя, когда увидите такую отметку: союзники будут вам <i>благодарны</i>!"

#. ja: おっと、致命的な全体攻撃への対処に失敗したようですね。<br>さらに地面に放たれた攻撃に当たってしまったようです。
#. de: Oh nein, Ihr wart nicht rechtzeitig in Eurem Turm. Dazu wurdet Ihr auch von einem Bodenangriff getroffen.
#. fr: Aïe, vous et vos équipiers n'avez pas évité l'attaque comme il se doit. Mal<shy>heu<shy>reu<shy>se<shy>ment, c'est un échec.
#. macro: <if $gn4>Mistress<else>Master</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <split " " 2><string $gs1></split> — the last name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:41251:0:0"
msgid "Focus, <if $gn4>Mistress<else>Master</if> <split \" \" 2><string $gs1></split>! Not only did your tower go unoccupied, but you stood on unsafe ground as well!"
msgstr "Сосредоточьтесь, <if $gn4>госпожа<else>господин</if> <split \" \" 2><string $gs1></split>! Башня осталась пустой, а вы ещё и стояли на опасном участке!"

#. ja: 適切に対応できなかった部分がありましたね。<br>開始地点へ戻って、もう一度、挑戦してみましょう！
#. de: Es gab leider einige Stellen, an denen Ihr die Prüfung nicht fehlerfrei bestehen konntet. Aber verliert hierdurch nicht den Mut! Begebt Euch einfach an den Startpunkt und versucht es erneut! Übung macht den Meister!
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment, tout n'était pas parfait<nbsp>! Désolé, mais vous allez devoir vous y recoller.
msgctxt "InstanceContentTextData:41252:0:0"
msgid "Alas, you didn't pass the challenge. Retake your starting position, and let's give it one more try!"
msgstr "Увы, испытание не пройдено. Вернитесь на стартовую позицию и попробуем ещё раз!"

#. ja: 実にお見事、すべての攻撃に対処できていましたね！<br>応用訓練は、文句なく完了ですよ！
#. de: Wahrlich vorbildlich, Ihr habt auf alle Angriffe perfekt reagiert! Damit habt ihr die Prüfung mit Bravour bestanden!
#. fr: Vous avez admirablement géré toutes les situations proposées. Bravo, c'est une réussite totale<nbsp>!
msgctxt "InstanceContentTextData:41253:0:0"
msgid "You handled every last threat with finesse. It is with pleasure that I declare you have passed the challenge!"
msgstr "Вы мастерски справились со всеми угрозами. С радостью объявляю, что испытание пройдено!"

#. ja: 訓練開始まで　3　秒！
#. de: Die Übung beginnt in 3 Sekunden!
#. fr: 3...
msgctxt "InstanceContentTextData:41254:0:0"
msgid "Commencing in 3..."
msgstr "Начинаем через 3..."

#. ja: 訓練開始まで　2　秒！
#. de: Die Übung beginnt in 2 Sekunden!
#. fr: 2...
msgctxt "InstanceContentTextData:41255:0:0"
msgid "2..."
msgstr "2..."

#. ja: 訓練開始まで　1　秒！
#. de: Die Übung beginnt in 1 Sekunde!
#. fr: 1...
msgctxt "InstanceContentTextData:41256:0:0"
msgid "1..."
msgstr "1..."

#. ja: それでは、訓練を始めましょう！
#. de: Lasst uns die Übung beginnen!
#. fr: Commençons<nbsp>!
msgctxt "InstanceContentTextData:41257:0:0"
msgid "Let the exercise begin!"
msgstr "Начинаем тренировку!"

#. ja: 次の訓練に移りますので、開始地点へ移動してください！
#. de: Zeit für die nächste Lektion! Stellt Euch bitte auf den Startpunkt!
#. fr: Pour la suite de l'exercice, veuillez vous rendre au prochain point de départ.
msgctxt "InstanceContentTextData:41258:0:0"
msgid "To start the next exercise, take your starting position."
msgstr "Чтобы начать следующее упражнение, встаньте на стартовую позицию."

#. ja: 素晴らしい判断です！<br>攻撃に対し、見事に対応できていますね！
#. de: Gut eingeschätzt! Ihr konntet korrekt auf den Angriff reagieren!
#. fr: Bravo, beaux réflexes<nbsp>! Vous avez réagi comme il fallait.
msgctxt "InstanceContentTextData:41259:0:0"
msgid "Masterfully judged! You handled that flawlessly."
msgstr "Прекрасная реакция! Вы безупречно справились с атакой."

#. ja: 的確な対応、お見事です！
#. de: Fantastisch, weiter so!
#. fr: Magnifique, c'est exactement ce que j'attendais de vous<nbsp>!
msgctxt "InstanceContentTextData:41260:0:0"
msgid "Precisely what I had hoped to see!"
msgstr "Именно такой реакции я и ожидал!"

#. ja: 訓練の内容を、しっかり実践できておりましたね！
#. de: Ihr habt die Theorie perfekt in die Praxis umgesetzt, wahrlich meisterhaft!
#. fr: Je suis heureux de constater que vous avez appliqué mes in<shy>struc<shy>tions à la lettre.
msgctxt "InstanceContentTextData:41261:0:0"
msgid "I'm pleased you took the lesson to heart."
msgstr "Рад видеть, что вы усвоили урок."

#. ja: 命中地点から十分に距離をとり、<br>被害を抑えられていましたね！
#. de: Behaltet als Faustregel also immer im Hinterkopf: Je weiter entfernt vom Ausgangspunkt des Angriffs, desto geringer der Schaden.
#. fr: Voilà ce que j'appelle prendre ses distances<nbsp>! Je suis fier de vous, votre position était idéale.
msgctxt "InstanceContentTextData:41262:0:0"
msgid "Barely a scratch, eh? Sometimes the simplest solution is to get the hells out of there, so to speak."
msgstr "Едва царапина осталась! Иногда проще всего просто убраться оттуда к демонам."

#. ja: 基本訓練1の目標を達成せよ！
#. de: Schließe Übungseinheit 1 erfolgreich ab!
#. fr: Réussir le premier objectif
msgctxt "InstanceContentTextData:41300:0:0"
msgid "Clear the First Training Objective"
msgstr "Пройдите первое задание базовой тренировки"

#. ja: 基本訓練2の目標を達成せよ！
#. de: Schließe Übungseinheit 2 erfolgreich ab!
#. fr: Réussir le deuxième objectif
msgctxt "InstanceContentTextData:41301:0:0"
msgid "Clear the Second Training Objective"
msgstr "Пройдите второе задание базовой тренировки"

#. ja: 基本訓練3の目標を達成せよ！
#. de: Schließe Übungseinheit 3 erfolgreich ab!
#. fr: Réussir le troisième objectif
msgctxt "InstanceContentTextData:41302:0:0"
msgid "Clear the Third Training Objective"
msgstr "Пройдите третье задание базовой тренировки"

#. ja: 基本訓練4の目標を達成せよ！
#. de: Schließe Übungseinheit 4 erfolgreich ab!
#. fr: Réussir le quatrième objectif
msgctxt "InstanceContentTextData:41303:0:0"
msgid "Clear the Fourth Training Objective"
msgstr "Пройдите четвёртое задание базовой тренировки"

#. ja: 訓練担当官と会話しろ
#. de: Sprich mit dem Ausbilder
#. fr: Parler au superviseur de la formation
msgctxt "InstanceContentTextData:41304:0:0"
msgid "Speak with the Master of Trials"
msgstr "Поговорите с инструктором"

#. ja: 応用訓練の目標をすべて達成せよ！
#. de: Schließe alle Prüfungseinheiten erfolgreich ab!
#. fr: Réussir tous les objectifs
msgctxt "InstanceContentTextData:41305:0:0"
msgid "Clear All Challenge Objectives"
msgstr "Пройдите все задания продвинутой тренировки"

#. ja: 応用訓練1の目標を達成せよ！
#. de: Schließe Prüfungseinheit 1 erfolgreich ab!
#. fr: Réussir le premier objectif
msgctxt "InstanceContentTextData:41306:0:0"
msgid "Clear the First Challenge Objective"
msgstr "Пройдите первое задание продвинутой тренировки"

#. ja: 応用訓練2の目標を達成せよ！
#. de: Schließe Prüfungseinheit 2 erfolgreich ab!
#. fr: Réussir le deuxième objectif
msgctxt "InstanceContentTextData:41307:0:0"
msgid "Clear the Second Challenge Objective"
msgstr "Пройдите второе задание продвинутой тренировки"

#. ja: 応用訓練3の目標を達成せよ！
#. de: Schließe Prüfungseinheit 3 erfolgreich ab!
#. fr: Réussir le troisième objectif
msgctxt "InstanceContentTextData:41308:0:0"
msgid "Clear the Third Challenge Objective"
msgstr "Пройдите третье задание продвинутой тренировки"

#. ja: 応用訓練4の目標を達成せよ！
#. de: Schließe Prüfungseinheit 4 erfolgreich ab!
#. fr: Réussir le quatrième objectif
msgctxt "InstanceContentTextData:41309:0:0"
msgid "Clear the Fourth Challenge Objective"
msgstr "Пройдите четвёртое задание продвинутой тренировки"

#. ja: さすがは<split " " 2><string $gs1></split>殿、対処成功です！
#. de: Fantastisch! Ihr habt perfekt reagiert, <if $gn4>verehrte Frau<else>verehrter Herr</if> <split " " 2><string $gs1></split>!
#. fr: Fé<shy>li<shy>ci<shy>ta<shy>tions, <if $gn4>Madame<else>Monsieur</if> <split " " 2><string $gs1></split>, vous vous en êtes remarquablement <if $gn4>sortie<else>sorti</if><nbsp>!
#. macro: <if $gn4>Mistress<else>Master</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <split " " 2><string $gs1></split> — the last name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:41310:0:0"
msgid "Bravo, <if $gn4>Mistress<else>Master</if> <split \" \" 2><string $gs1></split>!"
msgstr "Браво, <if $gn4>госпожа<else>господин</if> <split \" \" 2><string $gs1></split>!"

#. ja: 開始地点へ戻って、もう一度、挑戦してみましょう！
#. de: Kehrt zum Startpunkt zurück und versucht es erneut!
#. fr: Retournez au point de départ et essayez encore une fois<nbsp>!
msgctxt "InstanceContentTextData:41311:0:0"
msgid "Retake your starting position, and let's give it one more try!"
msgstr "Вернитесь на стартовую позицию и попробуем ещё раз!"

#. ja: 素晴らしい、これで基本訓練は完了です！<br>応用訓練に移りますので、まずは私のところへ来てください。
#. de: Einwandfrei! Damit habt Ihr alle Übungs<shy>einheiten erfolgreich abgeschlossen! Sprecht mich bitte an, sobald Ihr bereit seid, euch der letzten Prüfung zu stellen.
#. fr: Bravo, vous avez accompli tous les objectifs<nbsp>! Venez me parler lorsque vous serez <if $gn4>prête<else>prêt</if> à commencer l'examen pratique.
msgctxt "InstanceContentTextData:41312:0:0"
msgid "Spectacular work! With that, your basic training is complete. Now, come and speak with me if you'd like to attempt my final challenge!"
msgstr "Великолепно! Базовая тренировка завершена. Хотите испытать себя в моём финальном испытании? Тогда подойдите ко мне!"

#. ja: では、応用訓練を始めましょう。<br>準備がよければ、開始地点に移動してください。
#. de: Dann wollen wir uns mal der Prüfung widmen. Stellt Euch auf den Startpunkt, sobald Ihr bereit seid.
#. fr: Très bien, allons-y. Postez-vous au point de départ quand vous serez <if $gn4>prête<else>prêt</if>.
msgctxt "InstanceContentTextData:41313:0:0"
msgid "We will now begin the final challenge. Once you are prepared, take your starting position."
msgstr "Приступим к финальному испытанию. Как будете готовы, встаньте на стартовую позицию."

#. ja: 基本訓練をやり直すのですね、承知しました！<br>それでは、開始地点に移動してください。
#. de: Ihr würdet die Übungen gerne wiederholen? Sehr gerne, dann stellt Euch bitte auf den Startpunkt.
#. fr: Vous préférez recommencer<nbsp>? Aucun problème, allez vous poster au point de départ.
msgctxt "InstanceContentTextData:41314:0:0"
msgid "You'd like to start over? No problem at all! Go ahead and retake your starting position."
msgstr "Хотите начать сначала? Без проблем! Встаньте на стартовую позицию."

#. ja: さすがは<split " " 2><string $gs1></split>殿、<br>素晴らしい動きですね！
#. de: Flink wie ein Chocobo, bravo!
#. fr: Remarquable, <if $gn4>Madame<else>Monsieur</if> <split " " 2><string $gs1></split><nbsp>! Vos mouvements mériteraient d'être montrés à tous les novices<nbsp>!
#. macro: <if $gn4>Mistress<else>Master</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <split " " 2><string $gs1></split> — the last name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:41315:0:0"
msgid "Your grasp of combat tactics is commendable indeed, <if $gn4>Mistress<else>Master</if> <split \" \" 2><string $gs1></split>."
msgstr "Вы прекрасно разбираетесь в боевой тактике, <if $gn4>госпожа<else>господин</if> <split \" \" 2><string $gs1></split>!"

#. ja: おっと、地面に放たれた攻撃に当たってしまったようですね。<br>残念ながら、対処は失敗となります。
#. de: Oh, Ihr wurdet leider von der Bodenattacke getroffen. Verzeiht, aber dieser Versuch gilt somit als Fehlschlag.
#. fr: Vous avez été <if $gn4>touchée<else>touché</if> par une attaque... Mal<shy>heu<shy>reu<shy>se<shy>ment, vous allez devoir recommencer.
msgctxt "InstanceContentTextData:41316:0:0"
msgid "Careful! You were on unsafe ground just now. You'll need to retry the objective."
msgstr "Осторожно! Вы только что попали под атаку на земле. Придётся повторить задание."

#. ja: ようこそ<split " " 2><string $gs1></split>殿！<br>今回の訓練では、さらなる攻撃を体験していただきます。
#. de: Willkommen, <if $gn4>verehrte Frau<else>verehrter Herr</if> <split " " 2><string $gs1></split>! In Eurem heutigen Training werdet Ihr eine weitere Palette an neuen Angriffen kennenlernen.
#. fr: Bienvenue, <if $gn4>Madame<else>Monsieur</if> <split " " 2><string $gs1></split>. J'ai préparé encore plus d'attaques diverses et variées<nbsp>!
#. macro: <if $gn4>Mistress<else>Master</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <split " " 2><string $gs1></split> — the last name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:41317:0:0"
msgid "Welcome, <if $gn4>Mistress<else>Master</if> <split \" \" 2><string $gs1></split>. In this training exercise, we will have you carry out even more advanced tactical maneuvers."
msgstr "Добро пожаловать, <if $gn4>госпожа<else>господин</if> <split \" \" 2><string $gs1></split>. На этой тренировке вы освоите ещё более сложные тактические приёмы."

#. ja: 場内にいる補助官が敵役として攻撃を実行しますので、<br>その「予兆」を感じ取り、適切に対処しましょう。
#. de: In diesen Übungen wird einer unserer Lehrmeister die Rolle des Gegners über<shy>nehmen. So könnt Ihr lernen, die Wir<shy>kungs<shy>be<shy>reiche der Angriffe schnell zu erkennen und entsprechend zu reagieren.
#. fr: C'est l'officière formatrice qui va vous attaquer. Soyez <if $gn4>attentive<else>attentif</if> aux indications qui vont apparaître et esquivez en conséquence.
msgctxt "InstanceContentTextData:41318:0:0"
msgid "My agent here will serve as your opponent. Try to get a sense for her oncoming attacks, and handle them accordingly."
msgstr "Моя помощница будет вашим противником. Постарайтесь предугадать её атаки и вовремя на них реагировать."

#. ja: それでは準備ができましたら、開始地点に移動してください。
#. de: Also dann, stellt Euch bitte auf den Startpunkt, damit wir beginnen können.
#. fr: Lorsque vous serez <if $gn4>prête<else>prêt</if> à commencer, veuillez vous poster au point de départ.
msgctxt "InstanceContentTextData:41319:0:0"
msgid "Take your starting position when you are ready to begin."
msgstr "Когда будете готовы начать, встаньте на стартовую позицию."

#. ja: 最初は、敵に近いほど被害が大きくなる攻撃への対処法です。<br>まずは、その「予兆」を感じてください。
#. de: Dieses Mal beginnen wir mit Angriffen, die höheren Schaden verursachen, je näher Ihr Euch am entsprechenden Gegner befindet. Hier zunächst die Markierung<nbsp>...
#. fr: Pour cette première attaque, vous verrez apparaître comme une attache qui vous lie à votre ennemi.
msgctxt "InstanceContentTextData:41320:0:0"
msgid "For your first exercise, allow me to demonstrate the proximity tether. Its marker looks like this..."
msgstr "Начнём с атаки, сила которой зависит от расстояния до врага. Вот как выглядит её предупреждение..."

#. ja: この「予兆」の後に放たれる攻撃は、<br>敵から距離をとることで、被害を抑えることができます。
#. de: Spürt Ihr einen solchen Angriff auf Euch gerichtet, könnt Ihr den Schaden minimieren, indem Ihr Distanz zwischen Euch und Euren Gegner bringt.
#. fr: Plus vous serez proche de lui, plus vous subirez des dégâts importants. Il est donc impératif que vous vous éloigniez de lui.
msgctxt "InstanceContentTextData:41321:0:0"
msgid "When entangled with one of these, to remain near the enemy is to risk suffering a painful strike."
msgstr "Если на вас направлена такая атака, держитесь подальше от врага, иначе получите болезненный удар."

#. ja: 補助官が攻撃を実行する前に、<br>「予兆」が変化するまで距離をとってみましょう。
#. de: Bevor Euer Gegner also seinen Angriff ausführen kann, solltet Ihr Euch so weit von ihm entfernen, bis sich die Form der Markierung geändert hat.
#. fr: Vous pourrez remarquer que l'apparence du lien change lorsque vous êtes assez loin, alors soyez <if $gn4>attentive<else>attentif</if><nbsp>!
msgctxt "InstanceContentTextData:41322:0:0"
msgid "Instead, use what precious few moments you have to retreat until the tether's magicks weaken!"
msgstr "До того как противник атакует, отойдите подальше — пока предупреждение не изменится."

#. ja: おっと、敵役の近くで攻撃を受けてしまいましたね。<br>残念ながら、対処は失敗となります。
#. de: Oje, Ihr habt Euch nicht weit genug von Eurem Gegner entfernt. Verzeiht, aber das werde ich als Fehlschlag notieren müssen.
#. fr: Vous voyez, sur cet exemple particulier, vous ne vous êtes pas assez <if $gn4>éloignée<else>éloigné</if> de votre ennemi. Désolé, mais vous recommencez.
msgctxt "InstanceContentTextData:41323:0:0"
msgid "You must move away until the tether visibly changes. Try again!"
msgstr "Нужно отойти так далеко, чтобы связь явно изменилась. Попробуйте ещё раз!"

#. ja: 次は、ほかの対象を狙った攻撃を代わりに受ける訓練です。<br>まずは、その「予兆」を感じてください。
#. de: Als Nächstes widmen wir uns Angriffen, die Ihr auf Euch lenken und somit das eigentliche Ziel beschützen könnt. Prägt Euch zunächst die Markierung ein<nbsp>...
#. fr: Passons à une autre attaque impliquant une attache, différente cette fois...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:41324:0:0"
msgid "Before we move on, there is another type of tether attack I wish to cover. Take note of <i>this</i> marker..."
msgstr "А теперь разберём ещё один вид атак со связью. Обратите внимание на <i>это</i> предупреждение..."

#. ja: 「予兆」を感じたら、狙われた対象と敵の間に入ることで、<br>自身が標的となり、攻撃を肩代わりすることができます。
#. de: Spürt Ihr einen solchen Angriff, solltet Ihr Euch zwischen den Gegner und sein Ziel stellen, um den Angriff abzufangen.
#. fr: En effet, vous pouvez vous interposer entre l'assaillant et sa cible pour encaisser le coup à la place de cette dernière.
msgctxt "InstanceContentTextData:41325:0:0"
msgid "Unlike proximity tethers, these can be intercepted at will, allowing you to sustain a blow on another's behalf."
msgstr "В отличие от атак на расстояние, такую связь можно перехватить. Встаньте между противником и его целью и примите удар на себя."

#. ja: 今回は、敵役がボムに攻撃を加えます。<br>ボムが刺激で爆発しないよう、代わりに攻撃を引き受けましょう。
#. de: Stellt Euch in diesem Fall also zwischen die Lehrmeisterin und den Bomber, um zu verhindern, dass der Angriff eine Explosion auslöst.
#. fr: La pratique, maintenant. Faites-vous toucher par l'attaque pour éviter que le bombo explose<nbsp>!
msgctxt "InstanceContentTextData:41326:0:0"
msgid "For this exercise, let's suppose your enemy intends to detonate a bomb. To prevent a lethal explosion, your only recourse is to shield the bomb yourself!"
msgstr "Представим, что противник собирается взорвать бомбу. Чтобы предотвратить взрыв, вам придётся заслонить её собой!"

#. ja: おっと、うまく攻撃を引き受けられなかったようですね。<br>残念ながら、対処は失敗となります。
#. de: Uhh, leider konntet Ihr den Angriff nicht erfolgreich auf Euch ziehen. Das werde ich wohl oder übel als Fehlschlag notieren müssen.
#. fr: Un beau feu d'artifice... Mais ce n'est pas ce que je vous ai demandé. Allez, on se remet en place<nbsp>!
msgctxt "InstanceContentTextData:41327:0:0"
msgid "An excellent demonstration...of an unmitigated explosion. Let's try again."
msgstr "Блестящая демонстрация... сокрушительного взрыва. Давайте попробуем ещё раз."

#. ja: 次は、視線攻撃に対処していきましょう。<br>まずは、その「予兆」を感じてください。
#. de: Kommen wir nun zu Blick-Angriffen. Der Name sowie die Markierung sind recht selbsterklärend, würde ich meinen<nbsp>...
#. fr: Bon, poursuivons avec une attaque... du regard<nbsp>! Oui, ça existe bel et bien. Voici à quoi ressemble l'indication.
msgctxt "InstanceContentTextData:41328:0:0"
msgid "Next, I will teach you how to defend against a gaze attack. Behold its marker..."
msgstr "Теперь научу вас защищаться от атак взглядом. Вот как выглядит их предупреждение..."

#. ja: この「予兆」の後に放たれる視線攻撃は、<br>敵の方を見ていた場合に、重大な被害を受けてしまいます。
#. de: Blickt Ihr in die Richtung des Gegners, wenn dieser einen solchen Angriff ausführt, wird es sicherlich nicht schön für Euch enden.
#. fr: Si vous regardez vers votre ennemi au moment où l'attaque est lancée, vous subirez des dégâts ou un effet néfaste.
msgctxt "InstanceContentTextData:41329:0:0"
msgid "When the spell is cast, all those facing its direction will suffer some manner of unpleasant effect─in this case, petrification."
msgstr "Те, кто будет смотреть в сторону врага, когда он применит это заклинание, пострадают. В этот раз они окаменеют."

#. ja: このあと敵役が、自身を見ていた者を石化する魔法を実行します。<br>体の向きを変え、敵役を見ないようにして避けましょう。
#. de: Für diese Übung wird unsere Lehrmeisterin eine Magie einsetzen, die bei Blickkontakt versteinert. Dreht Euch also in eine andere Richtung als die, von der der Angriff ausgeht.
#. fr: Pour notre exercice, l'officière formatrice va lancer un sort de pétrification. Assurez-vous de bien lui tourner le dos<nbsp>!
msgctxt "InstanceContentTextData:41330:0:0"
msgid "Fortunately, the solution is simple: you need but turn away from the enemy to neutralize its effects entirely!"
msgstr "К счастью, решение простое: отвернитесь от врага, и атака вас не заденет!"

#. ja: おっと、視線攻撃の際に敵役を見てしまったようですね。<br>残念ながら、対処は失敗となります。
#. de: Oje, Ihr habt Euren Gegner angesehen, als dieser den Blick-Angriff ausgeführt hat. Leider ein Fehlschlag.
#. fr: Vous n'avez pas pu vous empêcher de jeter un œil, hein<nbsp>? Allez, on recommence. Cette fois-ci, regardez de l'autre côté<nbsp>!
msgctxt "InstanceContentTextData:41331:0:0"
msgid "Ha, caught you looking! Have another go."
msgstr "Ага, попались! Попробуйте ещё раз."

#. ja: 次は、毒や麻痺といった、<br>状態異常への対処を訓練します。
#. de: Im Folgenden befassen wir uns nicht mit einem Angriff, sondern mit negativen Statuseffekten, speziell Gift und Paralyse.
#. fr: Maintenant, je vais vous parler d'altérations d'état, telles que le poison ou la paralysie, par exemple.
msgctxt "InstanceContentTextData:41332:0:0"
msgid "For your next exercise, let us discuss status effects such as poison or paralysis─and, more importantly, the curing thereof."
msgstr "В следующем упражнении поговорим о таких состояниях, как отравление и паралич, и, главное, о том, как от них избавиться."

#. ja: 状態異常には多くの種類がありますが、<br>その一部は癒やし手の「エスナ」などで浄化することができます。
#. de: Es gibt unzählige Arten an negativen Effekten, die Euch und Eure Mitstreiter befallen können, doch ein Teil von ihnen kann mit bestimmten Kommandos wie beispielsweise „Medica“ entfernt werden.
#. fr: Il en existe de nombreuses variétés, mais une bonne partie d'entre elles peuvent être éliminées grâce au sort Guérison.
msgctxt "InstanceContentTextData:41333:0:0"
msgid "While there are full many varieties of combat ailments, a fair few can be swiftly relieved with Esuna."
msgstr "Боевых недугов великое множество, но многие из них можно быстро снять заклинанием «Эсна»."

#. ja: では実際に、味方の状態異常を、<br>「エスナ」を使うことで浄化してみましょう。
#. de: Am besten probiert Ihr es selbst einmal aus. Verwendet „Medica“, um den negativen Effekt auf Eurem Mitstreiter zu entfernen.
#. fr: Pour notre exercice, un de vos équipiers sera victime d'une entrave. Lancez sur lui le sort Guérison pour qu'il puisse échapper à l'attaque qui va le viser<nbsp>!
msgctxt "InstanceContentTextData:41334:0:0"
msgid "So, let's get a feel for this by having our healer do the honors, shall we?"
msgstr "Давайте проверим это на практике. Пусть наш целитель снимет недуг с союзника, хорошо?"

#. ja: 今回は、状態異常の浄化を体験してもらいます。<br>状態異常が解除されたら、急いで攻撃を回避しましょう。
#. de: In dieser Übung wird Euer Mitstreiter den negativen Effekt auf Euch entfernen. Ihr müsst danach lediglich dem gegnerischen Angriff ausweichen.
#. fr: Pour notre exercice, le soigneur va vous soulager d'une entrave. Une fois que vous serez libre de vos mouvements, déplacez-vous pour éviter l'attaque qui vous visera<nbsp>!
#, aeria-term-model-exception: job b3e546875adf
msgctxt "InstanceContentTextData:41335:0:0"
msgid "For this exercise, let's see you evade the attack as soon as Esuna has done its job!"
msgstr "В этом упражнении уклонитесь от атаки сразу после того, как «Эсна» снимет с вас недуг!"

#. ja: おっと、状態異常を治療できなかったようですね。<br>残念ながら、対処は失敗となります。
#. de: おっと、状態異常を治療できなかったようですね。<br>残念ながら、対処は失敗となります。
#. fr: Je vois que l'entrave n'a pas été retirée comme prévu... Il faut recommencer.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:41336:0:0"
msgid "おっと、状態異常を治療できなかったようですね。<br>残念ながら、対処は失敗となります。"
msgstr "Похоже, вам не удалось снять недуг. Придётся повторить задание."

#. ja: おっと、「エスナ」が遅く、味方が攻撃を受けてしまいましたね。<br>残念ながら、対処は失敗となります。
#. de: Oh nein, Ihr konntet den negativen Effekt Eures Mitstreiters nicht schnell genug mit „Medica“ entfernen, wodurch Euer Mitstreiter von dem Angriff getroffen wurde. Das gilt leider als Fehlschlag.
#. fr: Vous deviez lancer le sort Guérison à temps pour que l'attaque soit évitée... Recommençons, je vous prie.
msgctxt "InstanceContentTextData:41337:0:0"
msgid "Your Esuna was just a touch too slow, I'm afraid. Not to worry─we can retry the objective."
msgstr "Боюсь, вы чуть-чуть опоздали с «Эсной». Ничего, попробуем ещё раз."

#. ja: おっと、攻撃を受けてしまいましたね。<br>状態異常が解除されたら、攻撃を回避しましょう！
#. de: Oje, Ihr wurdet leider vom Angriff erwischt. Weicht dem Angriff so schnell wie möglich aus, nachdem der negative Effekt auf Euch entfernt wurde!
#. fr: Vous avez encaissé l'attaque de plein fouet<nbsp>! Souvenez-vous, dès que l'entrave est levée, vous devez fuir im<shy>mé<shy>dia<shy>te<shy>ment<nbsp>!
msgctxt "InstanceContentTextData:41338:0:0"
msgid "Alas, you didn't quite dodge that attack. Be prepared to move as soon as you are cured!"
msgstr "Увы, от атаки уклониться не удалось. Будьте готовы двинуться сразу, как только с вас снимут недуг!"

#. ja: それでは、応用訓練に移りましょう。
#. de: Dann wollen wir uns mal der Prüfung widmen.
#. fr: Bien, il est temps de mettre à l'épreuve vos compétences.
msgctxt "InstanceContentTextData:41339:0:0"
msgid "Allow me to test all that you have learned thus far."
msgstr "Позвольте проверить, чему вы успели научиться."

#. ja: 複数種類の攻撃を次々と繰り出しますので、<br>これまでの訓練を思い出し、被害を最小限に抑えてください。
#. de: Ihr werdet auf mehrere Angriffe hintereinander reagieren müssen. Erinnert Euch an unsere bisherigen Übungen und versucht, den Schaden so gut wie möglich zu minimieren.
#. fr: Pour l'examen pratique, vous devrez éviter diverses attaques en succession. Souvenez-vous de ce que vous venez d'apprendre<nbsp>!
msgctxt "InstanceContentTextData:41340:0:0"
msgid "In this exercise, you will face a slew of different attacks, each of which you must deal with appropriately to minimize the harm you sustain."
msgstr "В этом упражнении вам предстоит столкнуться с целой чередой разных атак. Постарайтесь правильно на них реагировать, чтобы свести полученный урон к минимуму."

#. ja: おっと、敵役から近い位置で攻撃を受けてしまいましたね。<br>残念ながら、対処は失敗となります。
#. de: Oh je, Ihr wart nicht weit genug von Eurem Gegner entfernt. Verzeiht, aber das werde ich als Fehlschlag notieren müssen.
#. fr: Vous étiez encore trop proche de l'ennemi. La prochaine fois, éloignez-vous jusqu'à ce que la couleur de l'attache change.
msgctxt "InstanceContentTextData:41341:0:0"
msgid "That proximity tether wasn't weakened enough. You'll need to retry the objective."
msgstr "Вы не успели ослабить связь. Придётся повторить задание."

#. ja: おっと、敵役から近い位置で攻撃を受けたほか、<br>地面に放たれた攻撃にも当たってしまいましたね。
#. de: Hmm, Ihr wart nicht weit genug vom Gegner entfernt und wurdet dazu noch von einem Bodenangriff erwischt.
#. fr: Attention, voyons<nbsp>! Vous étiez trop proche, et en plus pas dans le bon angle pour éviter les coups...
#. macro: <if $gn4>Mistress<else>Master</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <split " " 2><string $gs1></split> — the last name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:41342:0:0"
msgid "Careful, <if $gn4>Mistress<else>Master</if> <split \" \" 2><string $gs1></split>! Not only were you too close to the enemy, but you stood on unsafe ground as well!"
msgstr "Осторожнее, <if $gn4>госпожа<else>господин</if> <split \" \" 2><string $gs1></split>! Вы не только подошли слишком близко к противнику, но и встали на опасное место!"

#. ja: おっと、ボムへの攻撃をうまく引き受けられなかったようですね。<br>残念ながら、対処は失敗となります。
#. de: Uhh, leider konntet Ihr den Angriff nicht erfolgreich auf Euch ziehen. Dass werde ich leider als Fehlschlag notieren müssen.
#. fr: Comme je vous l'ai expliqué, vous devez vous interposer entre l'assaillant et un bombo pour éviter une explosion.
msgctxt "InstanceContentTextData:41343:0:0"
msgid "Don't forget to take the tether from the bomb! You'll need to retry the objective."
msgstr "Не забудьте перехватить связь у бомба! Придётся повторить задание."

#. ja: おっと、味方が受けるはずの攻撃を奪ってしまったようですね。<br>残念ながら、対処は失敗となります。
#. de: Oh nein, Ihr habt einen Angriff, den einer Eurer Mitstreiter hätte abfangen sollen, selbst abbekommen. Verzeiht, aber das gilt als Fehlschlag.
#. fr: Vous avez subi une attaque destinée à un de vos équipiers<nbsp>! La prochaine fois, interposez-vous au bon endroit.
msgctxt "InstanceContentTextData:41344:0:0"
msgid "That was not your tether to take, my friend! Unfortunately, you will need to retry the objective."
msgstr "Эту связь нужно было перехватить не вам, друг мой! К сожалению, задание придётся повторить."

#. ja: おっと、視線攻撃の際に敵役を見てしまったようですね。<br>残念ながら、対処は失敗となります。
#. de: Oh je, Ihr habt den Gegner angeschaut, als er einen Blick-Angriff ausgeführt hat. Leider ein Fehlschlag.
#. fr: C'est pourtant simple<nbsp>: tournez le dos à l'ennemi au moment de l'attaque<nbsp>! Je compte sur vous pour y arriver la prochaine fois.
msgctxt "InstanceContentTextData:41345:0:0"
msgid "Tsk-tsk! You were caught looking at the enemy's gaze attack. You'll have to retry this objective."
msgstr "Ай-ай-ай! Вы попались на взгляд противника. Придётся повторить задание."

#. ja: おっと、視線攻撃の際に敵役を見てしまったほか、<br>地面に放たれた攻撃にも当たってしまったようですね。
#. de: Oh je, Ihr habt den Gegner angeschaut, als er einen Blick-Angriff ausgeführt hat, und wurdet auch von einem Bodenangriff erwischt.
#. fr: En plus de regarder où il ne fallait pas, vous avez aussi encaissé une attaque en pleine figure... Allez, on reprend.
msgctxt "InstanceContentTextData:41346:0:0"
msgid "Oh dear. Not only were you caught looking at the gaze attack, but you stood on unsafe ground as well."
msgstr "Вот беда. Вы не только попались на взгляд противника, но и встали на опасное место."

#. ja: おっと、味方全員の状態異常を治療できなかったようですね。<br>残念ながら、対処は失敗となります。
#. de: おっと、味方全員の状態異常を治療できなかったようですね。<br>残念ながら、対処は失敗となります。
#. fr: Vous n'avez pas réussi à guérir tous vos équipiers. Courage, vous allez y arriver.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:41347:0:0"
msgid "おっと、味方全員の状態異常を治療できなかったようですね。<br>残念ながら、対処は失敗となります。"
msgstr "Вы не успели снять отрицательные эффекты со всех союзников.<br>К сожалению, задание придётся повторить."

#. ja: おっと、全員が攻撃を回避できなかったようですね。<br>残念ながら、対処は失敗となります。
#. de: Hmm, es gelang nicht allen Grup<shy>pen<shy>mit<shy>gliedern, dem Angriff auszuweichen. Verzeiht, aber das werde ich als Fehlschlag zählen müssen.
#. fr: Il faut que tous les équipiers esquivent l'attaque, sinon à quoi bon<nbsp>?
msgctxt "InstanceContentTextData:41348:0:0"
msgid "I see not all of you managed to evade that attack. Unfortunately, you will need to retry the objective."
msgstr "Похоже, не всем удалось уклониться от атаки. К сожалению, задание придётся повторить."

#. ja: 適切に対応できなかった部分がありましたね。<br>開始地点へ戻って、もう一度、挑戦してみましょう！
#. de: Es gab leider einige Stellen, an denen Ihr die Prüfung nicht fehlerfrei bestehen konntet. Aber verliert hierdurch nicht den Mut! Begebt Euch einfach an den Startpunkt und versucht es erneut! Übung macht den Meister!
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment, tout n'était pas parfait<nbsp>! Désolé, mais vous allez devoir vous y recoller.
msgctxt "InstanceContentTextData:41349:0:0"
msgid "Alas, you didn't pass the challenge. Retake your starting position, and let's give it one more try!"
msgstr "Увы, испытание не пройдено. Вернитесь на стартовую позицию и попробуем ещё раз!"

#. ja: 実にお見事、すべての攻撃に対処できていましたね！<br>応用訓練は、文句なく完了ですよ！
#. de: Wahrlich vorbildlich, Ihr habt auf alle Angriffe perfekt reagiert! Damit habt ihr die Prüfung mit Bravour bestanden!
#. fr: Vous avez admirablement géré toutes les situations proposées. Bravo, c'est une réussite totale<nbsp>!
msgctxt "InstanceContentTextData:41350:0:0"
msgid "You neutralized every threat with practiced precision. Needless to say, you've passed my final challenge with flying colors!"
msgstr "Вы безупречно справились со всеми угрозами. Что и говорить, моё последнее испытание пройдено на отлично!"

#. ja: 訓練開始まで　3　秒！
#. de: Die Übung beginnt in 3 Sekunden!
#. fr: 3...
msgctxt "InstanceContentTextData:41351:0:0"
msgid "Commencing in 3..."
msgstr "Начинаем через 3..."

#. ja: 訓練開始まで　2　秒！
#. de: Die Übung beginnt in 2 Sekunden!
#. fr: 2...
msgctxt "InstanceContentTextData:41352:0:0"
msgid "2..."
msgstr "2..."

#. ja: 訓練開始まで　1　秒！
#. de: Die Übung beginnt in 1 Sekunde!
#. fr: 1...
msgctxt "InstanceContentTextData:41353:0:0"
msgid "1..."
msgstr "1..."

#. ja: それでは、訓練を始めましょう！
#. de: Lasst uns die Übung beginnen!
#. fr: Commençons<nbsp>!
msgctxt "InstanceContentTextData:41354:0:0"
msgid "Let the exercise begin!"
msgstr "Начинаем упражнение!"

#. ja: 次の訓練に移りますので、開始地点へ移動してください！
#. de: Zeit für die nächste Lektion! Stellt Euch bitte auf den Startpunkt!
#. fr: Pour la suite de l'exercice, veuillez vous rendre au prochain point de départ.
msgctxt "InstanceContentTextData:41355:0:0"
msgid "To start the next exercise, take your starting position."
msgstr "Займите стартовую позицию, чтобы начать следующее упражнение."

#. ja: 素晴らしい判断です！<br>攻撃に対し、見事に対応できていますね！
#. de: Gut eingeschätzt! Ihr konntet korrekt auf den Angriff reagieren!
#. fr: Bravo, beaux réflexes<nbsp>! Vous avez réagi comme il fallait.
msgctxt "InstanceContentTextData:41356:0:0"
msgid "Masterfully judged! You handled that flawlessly."
msgstr "Прекрасное решение! Вы безупречно справились с атакой!"

#. ja: 的確な対応、お見事です！
#. de: Fantastisch, weiter so!
#. fr: Magnifique, c'est exactement ce que j'attendais de vous<nbsp>!
msgctxt "InstanceContentTextData:41357:0:0"
msgid "Precisely what I had hoped to see!"
msgstr "Именно этого я от вас и ждал!"

#. ja: 訓練の内容を、しっかり実践できておりましたね！
#. de: Ihr habt die Theorie perfekt in die Praxis umgesetzt, wahrlich meisterhaft!
#. fr: Je suis heureux de constater que vous avez appliqué mes in<shy>struc<shy>tions à la lettre.
msgctxt "InstanceContentTextData:41358:0:0"
msgid "I'm pleased you took the lesson to heart."
msgstr "Рад видеть, что вы усвоили урок."

#. ja: 俺は死なぬ。<br>貴様ら人間どもを、根絶やしにするまではな。
#. de: Ich bin unsterblich. So lange, bis ich euch und euresgleichen von dieser Welt getilgt habe.
#. fr: Je ne peux pas mourir. Pas avant de vous avoir éliminés de ce monde.
msgctxt "InstanceContentTextData:41400:0:0"
msgid "I cannot die. Not until I have eradicated you and your kind from this world."
msgstr "Я не умру. Не раньше, чем истреблю вас и весь ваш род."

#. ja: 歎き、叩頭せよ！<br>我が剣撃で、無に還るがいい！
#. de: Auf die Knie und verneigt euch vor mir! Ein Hieb meines Schwertes vermag es, euch auszulöschen!
#. fr: À genoux, manants<nbsp>! Mes entailles vont vous renvoyer dans le néant<nbsp>!
msgctxt "InstanceContentTextData:41401:0:0"
msgid "Wretched filth. Return to the feculent soil that birthed you."
msgstr "Мерзкая падаль. Возвращайтесь в грязь, из которой вылезли."

#. ja: 我が剣撃で、地脈を揺るがさん！
#. de: Ein einziger Hieb meines Schwertes lässt sämtliche Ätherströme versiegen!
#. fr: Que la terre tremble sous le poids de l'acier<nbsp>!
msgctxt "InstanceContentTextData:41402:0:0"
msgid "The land trembles before my might!"
msgstr "Земля дрожит перед моей мощью!"

#. ja: 跪き、瞑目せよ！<br>貴様らを滅し、人の子の終焉を告げようぞ！
#. de: Eure Seelen sollen mein sein! Trink, meine Klinge, trink ihre sterbliche Essenz!
#. fr: Agenouillez-vous et préparez-vous à mourir<nbsp>! Les dernières heures de l'humanité auront sonné lorsque je vous aurai anéantis<nbsp>!
msgctxt "InstanceContentTextData:41403:0:0"
msgid "Kneel before me! Your demise shall portend the extinction of Altana's vile progeny!"
msgstr "На колени! Ваша гибель возвестит об истреблении мерзких отпрысков Альтаны!"

#. ja: 我が心の闇よ、人間どもを喰らいつくせ。
#. de: Die Dunkelheit meines Herzens verschlingt alles, was lebt und atmet!
#. fr: Que les ténèbres de mon âme vous engloutissent...
msgctxt "InstanceContentTextData:41404:0:0"
msgid "The Darkness within me shall devour you all!"
msgstr "Тьма, что живёт во мне, поглотит вас всех!"

#. ja: これぞ我が内にある、憎しみの炎……！
#. de: Das ist das Feuer des Zorns, das in mir lodert<nbsp>...!
#. fr: Admirez... le feu de la haine qui brûle dans mon cœur<nbsp>!
msgctxt "InstanceContentTextData:41405:0:0"
msgid "Flames of hatred! Oh, how they burn!"
msgstr "Пламя ненависти! О, как же оно жжёт!"

#. ja: 人間どもをひとり残らず焼き尽くせ。
#. de: Ich werde nicht eher ruhen, bis der Letzte von euch zu Asche verbrannt ist.
#. fr: Mes flammes vous consumeront tous, misérables humains.
msgctxt "InstanceContentTextData:41406:0:0"
msgid "There will be naught left of man but smoke and ash."
msgstr "От человечества не останется ничего, кроме дыма и пепла."

#. ja: 憎悪の炎よ、奔れ！　そして爆ぜよ！
#. de: Mein lodernder Hass wird euch umhüllen und bersten lassen!
#. fr: Vole, ô ma colère, et réduis-les en cendres<nbsp>!
msgctxt "InstanceContentTextData:41407:0:0"
msgid "Let the fires writhe and rage!"
msgstr "Пусть пламя бушует и клокочет!"

#. ja: この汚れ……<br>その血で……濯いでもらおう…………。
#. de: Diese Beleidigung<nbsp>... Ich werde sie in eurem Blut ertränken.
#. fr: Cette insulte... Votre sang la lavera.
msgctxt "InstanceContentTextData:41408:0:0"
msgid "This insult... I will scour it away with your blood."
msgstr "Это оскорбление... Я смою его вашей кровью."

#. ja: うごめくモノ……生にすがるモノ……<br>死せよ……滅びよ……滅せよ……。
#. de: Beendet euer schmerzhaftes Streben. Gebt euch der Dunkelheit des Vergessens hin.
#. fr: Abandonnez votre douloureux combat. Succombez aux ténèbres du néant.
msgctxt "InstanceContentTextData:41409:0:0"
msgid "Give up your painful strivings. Give in to the darkness of oblivion."
msgstr "Бросьте эту мучительную борьбу. Отдайтесь тьме забвения."

#. ja: みにくき肉塊が……<br>肉片と化せ……骨片と化せ……。
#. de: Zerbrechliche Sterbliche. Ich werde euer Fleisch zerreißen und eure Knochen zermalmen<nbsp>...
#. fr: Frêles mortels, je déchirerai votre chair et briserai vos os...
msgctxt "InstanceContentTextData:41410:0:0"
msgid "Frail mortals. I will tear your flesh and crush your bones."
msgstr "Хрупкие смертные. Я разорву вашу плоть и раздроблю кости."

#. ja: 戦慄せよ……畏怖せよ……<br>死の旋律を舞い……死の詩歌を吟ぜよ……。
#. de: Verzagt vor meiner Macht! Euer Grabgesang hat begonnen und seine trauervollen Noten singen von eurem Ableben.
#. fr: Votre chant funèbre a commencé. Ses notes lugubres marquent votre déclin.
msgctxt "InstanceContentTextData:41411:0:0"
msgid "Your funeral dirge has begun. Its mournful notes sing of your demise."
msgstr "Ваш погребальный гимн уже звучит. Его скорбные ноты поют о вашей гибели."

#. ja: 戦慄き、刮目せよ！<br>我が憎悪、しかとその身に刻んでやろう！
#. de: Muahahahaha! Nun sollt ihr schwächlichen Winzlinge meine wahre Macht erfahren! Ich werde eure Seelen fressen!
#. fr: Ressentez ce frisson d'horreur jusque dans vos veines<nbsp>! La marque de ma haine restera gravée dans votre chair<nbsp>!
msgctxt "InstanceContentTextData:41412:0:0"
msgid "Behold as the spate of my rage quenches the candle of your trivial existence."
msgstr "Смотрите, как поток моей ярости погасит свечу вашего ничтожного существования!"

#. ja: 潰れるがいい、ムシケラども！
#. de: Ich werde euch wie Fliegen zerquetschen!
#. fr: Je vais vous broyer en mille morceaux<nbsp>!
msgctxt "InstanceContentTextData:41413:0:0"
msgid "I will crush you like the insects you are!"
msgstr "Я раздавлю вас, как тех жалких насекомых, которыми вы и являетесь!"

#. ja: 友の死を見て、臆さぬか！<br>我が剣撃を聴き、怯まぬか！
#. de: Nun sollt ihr Narren erfahren, wie töricht ihr wirklich seid, vor mich zu treten. Könnt ihr das grausame Lied meiner Klinge hören?
#. fr: Saurez-vous toujours me tenir tête après avoir vu vos compagnons mourir sous vos yeux<nbsp>?
msgctxt "InstanceContentTextData:41414:0:0"
msgid "Can your vaunted “justice” withstand the brunt of the deepest rancor and wrath!?"
msgstr "Выдержит ли ваша хвалёная «справедливость» всю силу моей лютой злобы и гнева?!"

#. ja: この憎しみの炎の消えぬかぎり、<br>俺は決して……決して、倒れたりはせぬ！
#. de: Ich werde nicht fallen! Ich werde immer wiederkommen, bis das Feuer des Zorns mich verzehrt hat!
#. fr: Je ne tomberai pas<nbsp>! Je continuerai à revenir jusqu'à ce que le feu de la colère me consume<nbsp>!
msgctxt "InstanceContentTextData:41415:0:0"
msgid "I will not fall! I will keep coming back, until the fires of wrath consume me!"
msgstr "Я не паду! Я буду возвращаться снова и снова, пока пламя ярости не поглотит меня!"

#. ja: 跪き、瞑目せよ！<br>貴様らを滅し、人の子の終焉を告げようぞ！
#. de: Eure Seelen sollen mein sein! Trink, meine Klinge, trink ihre sterbliche Essenz!
#. fr: Agenouillez-vous et préparez-vous à mourir<nbsp>! Les dernières heures de l'humanité auront sonné lorsque je vous aurai anéantis<nbsp>!
msgctxt "InstanceContentTextData:41416:0:0"
msgid "Kneel before me! Your demise shall portend the extinction of Altana's vile progeny!"
msgstr "На колени! Ваша гибель возвестит об истреблении мерзких отпрысков Альтаны!"

#. ja: さあ、おっぱじめようぜー！
#. de: Ha, endlich bin ich an der Reihe!
#. fr: Vous allez voir ce que vous allez voir<nbsp>!
msgctxt "InstanceContentTextData:41417:0:0"
msgid "How about we start with a big fat knuckle sandwich!"
msgstr "Ну что, начнём с хорошей такой затрещины!"

#. ja: ヘヘっ！　いっくぜぇ！！
#. de: Hehe, kann losgehen!
#. fr: Allez, c'est parti<nbsp>!
msgctxt "InstanceContentTextData:41418:0:0"
msgid "Here we go!"
msgstr "Ну, держитесь!"

#. ja: おりゃあっ、もういっちょー！！
#. de: Und noch einer obendrauf!
#. fr: Et c'est reparti<nbsp>!
msgctxt "InstanceContentTextData:41419:0:0"
msgid "Is that all you've got?"
msgstr "И ещё получи!"

#. ja: 喰らいやがれ！！
#. de: Nehmt das!
#. fr: Prenez ça dans les dents<nbsp>!
msgctxt "InstanceContentTextData:41420:0:0"
msgid "Eat this!"
msgstr "Лови!"

#. ja: まだまだこっからだぁっ！
#. de: Das war noch lange nicht alles!
#. fr: Bon<nbsp>! Maintenant, j'y vais franco<nbsp>!
msgctxt "InstanceContentTextData:41421:0:0"
msgid "Oh, we're just getting started!"
msgstr "Это только начало!"

#. ja: 俺のとっておき、たえられっかな！？
#. de: Mal sehen, ob ihr das überlebt!
#. fr: Vous résisterez pas à ça<nbsp>!
msgctxt "InstanceContentTextData:41422:0:0"
msgid "This should do it!"
msgstr "Ну-ка, выдержите мой коронный удар!"

#. ja: マジの本気でいかせてもらうぜーー！！
#. de: Zieht euch warm an, jetzt mach ich ernst!
#. fr: Vous l'aurez voulu<nbsp>! Venez pas vous plaindre après<nbsp>!
msgctxt "InstanceContentTextData:41423:0:0"
msgid "Time to get serious!"
msgstr "Хватит дурачиться! Теперь всерьёз!"

#. ja: ヘヘっ！　覚悟しな！
#. de: Hehe, macht euch auf was gefasst!
#. fr: Préparez-vous à mordre la poussière<nbsp>!
msgctxt "InstanceContentTextData:41424:0:0"
msgid "Ya ready for this?"
msgstr "Ну что, готовы?"

#. ja: 女神様、俺に光を……！
#. de: Göttin, schenk mir dein Licht!
#. fr: Déesse, baigne-moi dans ta lumière...<nbsp>!
msgctxt "InstanceContentTextData:41425:0:0"
msgid "Altana give me strength!"
msgstr "Альтана, дай мне сил!"

#. ja: 女神様、光のご加護を……！
#. de: Göttin, schütze mich!
#. fr: Déesse, accorde-moi ta protection...<nbsp>!
msgctxt "InstanceContentTextData:41426:0:0"
msgid "Behold, the blessed power of Altana!"
msgstr "Взгляните на благословенную силу Альтаны!"

#. ja: オラオラオラーッ！！　夢想阿修羅拳！！！
#. de: Uahahahaha! Asura-Fäuste!
#. fr: Par les poings d'Asura<nbsp>!!
msgctxt "InstanceContentTextData:41427:0:0"
msgid "Take this. And that. And one of these!"
msgstr "Получай! И ещё! И вот ещё!"

#. ja: すぅーぱぁー、崑崙八象脚！
#. de: Superannullierender Doppelkick!
#. fr: Super coup de pied pulvérisant<nbsp>!
msgctxt "InstanceContentTextData:41428:0:0"
msgid "Nullifying Dropkick to your fat head!"
msgstr "Сокрушительный дропкик прямо в твою толстую башку!"

#. ja: ヘヘへ、楽しくなってきたぜ！
#. de: Hehehe, jetzt wird's lustig!
#. fr: Mais c'est que ça devient amusant, dites donc<nbsp>!
msgctxt "InstanceContentTextData:41429:0:0"
msgid "Now we're having a party!"
msgstr "Хе-хе-хе, вот теперь начинается веселье!"

#. ja: おまえら、なかなかやるじゃねーか！
#. de: Ihr seid gar nicht mal so übel!
#. fr: Vous êtes pas si nazes que ça, en fait<nbsp>!
msgctxt "InstanceContentTextData:41430:0:0"
msgid "Not bad. Not bad at all!"
msgstr "Неплохо. Очень даже неплохо!"

#. ja: 負けるわけにはいかねぇんだ……！
#. de: Mich kriegt ihr nicht so schnell klein<nbsp>...!
#. fr: Moi, la grande Prishe, perdre<nbsp>? Jamais...<nbsp>!
msgctxt "InstanceContentTextData:41431:0:0"
msgid "I'm not done yet..."
msgstr "Я ещё не закончила..."

#. ja: 負けたくねえ……負けたくねえよ……！
#. de: Das ist aber nicht so gelaufen wie geplant<nbsp>...!
#. fr: Oh, bon sang<nbsp>! Ça devait pas se passer comme ça...<nbsp>!
msgctxt "InstanceContentTextData:41432:0:0"
msgid "This wasn't how it was supposed to go...!"
msgstr "Всё пошло не так... Не так должно было быть...!"

#. ja: おーい、もう終わりかよぉ。<br>もっとあそぼーぜー。
#. de: Hmpf, ich hab mich doch gerade erst aufgewärmt!
#. fr: Ben alors<nbsp>? Et moi qui commençais justement à m'amuser...
msgctxt "InstanceContentTextData:41433:0:0"
msgid "Maaan, is that all? And I was just working up an appetite..."
msgstr "Ну-у, и это всё? А я только аппетит нагуляла..."

#. ja: まだやる気だな！<br>何度でもぶっ飛ばしてやるぜ！
#. de: Ihr wollt Nachschlag? Ich feg euch so oft weg, wie es nötig ist!
#. fr: Pas la peine de vous relever, vous finirez à nouveau au tapis<nbsp>!
msgctxt "InstanceContentTextData:41434:0:0"
msgid "Still kicking? 'Cause so am I!"
msgstr "Ещё держитесь? А я — да!"

#. ja: ッてぇぇー……！<br>今のは、いい一撃だったぜ！
#. de: Autschi! Das war nich' übel!
#. fr: Aaah... Vous avez quand même plus d'un tour dans votre sac<nbsp>!
msgctxt "InstanceContentTextData:41435:0:0"
msgid "Ouch! That was a good one!"
msgstr "Ай! Хороший удар!"

#. ja: なんじゃこりゃー！？俺の攻撃でびくともしねぇ！
#. de: Hier stimmt was nicht! Die zucken nicht mal, wenn ich angreife!
#. fr: Ouah<nbsp>!? Ils ont pas bougé d'un poil<nbsp>!
msgctxt "InstanceContentTextData:41436:0:0"
msgid "Gods, how are you so damn tough?"
msgstr "Да что с вами такое, чёрт возьми? Вас же ничем не пронять!"

#. ja: おまえらも女神の祝福を！？<br>そんなわけあるかよ！
#. de: Wurde euch etwa auch ein göttlicher Segen gewährt?!
#. fr: Quoi<nbsp>!? Vous avez aussi été bénis par la déesse<nbsp>? Impossible<nbsp>!
msgctxt "InstanceContentTextData:41437:0:0"
msgid "Huh!? There's no way you have Her blessing too!"
msgstr "Что?! Не может быть, чтобы и вас благословила Она!"

#. ja: ジュノ下層の突破
#. de: Unter-Jeuno durchqueren
#. fr: Franchir le Bas Jeuno
msgctxt "InstanceContentTextData:41448:0:0"
msgid "Clear Lower Jeuno"
msgstr "Пройти Нижний Джуно"

#. ja: 闘舞台の突破
#. de: Den Kampfplatz erobern
#. fr: Franchir l'Estrade des guerriers
msgctxt "InstanceContentTextData:41449:0:0"
msgid "Clear the Grand Dais"
msgstr "Пройти Большую арену"

#. ja: ボヤーダ樹の突破
#. de: Den Boyahda-Baum erkunden
#. fr: Franchir l'Arbre de Boyahda
msgctxt "InstanceContentTextData:41450:0:0"
msgid "Clear the Boyahda Tree"
msgstr "Пройти Дерево Боярда"

#. ja: 龍のねぐらの突破
#. de: Das Drachen-Nest erobern
#. fr: Franchir la Volière aux dragons
msgctxt "InstanceContentTextData:41451:0:0"
msgid "Clear Dragon's Aery"
msgstr "Пройти Драконье логово"

#. ja: ル・オンの庭の突破
#. de: Ru'Aun-Gärten
#. fr: Franchir les Jardins de Ru'Aun
msgctxt "InstanceContentTextData:41452:0:0"
msgid "Clear Ru'Aun Gardens"
msgstr "Пройти сады Ру'Ауна"

#. ja: ラ・ロフの劇場の突破
#. de: Das La'Loff-Amphitheater erkunden
#. fr: Franchir l'Amphithéâtre de La'Loff
msgctxt "InstanceContentTextData:41453:0:0"
msgid "Clear the La'Loff Amphitheater"
msgstr "Пройти амфитеатр Ла'Лофф"

#. ja: ズヴァール城の突破
#. de: Das Zvahl-Schloss erobern
#. fr: Franchir le Château Zvahl
msgctxt "InstanceContentTextData:41454:0:0"
msgid "Clear Castle Zvahl"
msgstr "Пройти замок Зваль"

#. ja: 王の間の突破
#. de: Den Thronsaal durchqueren
#. fr: Franchir la salle du trône
msgctxt "InstanceContentTextData:41455:0:0"
msgid "Clear the Throne Room"
msgstr "Пройти Тронный зал"

#. ja: 気をつけな！<br>あの嬢ちゃん、ただのガキじゃねェぞ……！
#. de: Passt bloß auf! Die Kleine hat es faustdick hinter den Spitzohren!
#. fr: Attention, ja<nbsp>! Cette gamine ne nous dit rien qui vaille...
msgctxt "InstanceContentTextData:41456:0:0"
msgid "Careful. That girl is stronger than she looks."
msgstr "Осторожно. Девчонка куда сильнее, чем кажется."

#. ja: いろいろと聞きてェことがあるからな……。<br>おねんねしてる間に運んじまうぞ！
#. de: Ich trage sie, solange sie schläft. Die Kleine ist uns ein paar Antworten schuldig.
#. fr: Transportons-la pendant qu'elle fait dodo, on lui posera des questions plus tard<nbsp>!
msgctxt "InstanceContentTextData:41457:0:0"
msgid "I've a bone to pick with this one. But first..."
msgstr "С ней у меня ещё разговор будет... А пока, пока она спит, уносим её!"

#. ja: 出口を探すには、先に進むしかなさそうだよ！
#. de: Sieht ganz so aus, als müssten wir weiter vordringen.
#. fr: Continuons droit devant pour sortir d'ici au plus vite, ja<nbsp>!
msgctxt "InstanceContentTextData:41458:0:0"
msgid "The only way out is forward."
msgstr "Выбраться отсюда можно, только если идти вперёд."

#. ja: なんだァ？　森の中に飛ばされちまったみてェだな。
#. de: Was? Bringt uns das mitten in den Wald?
#. fr: Hein<nbsp>? Nous voilà dans une forêt maintenant...
msgctxt "InstanceContentTextData:41459:0:0"
msgid "A forest, huh?"
msgstr "Лес, значит?"

#. ja: こっちは嬢ちゃんを守るので精一杯だ！<br>悪ィが、戦闘は任せたぞ！
#. de: Ich hab alle Hände voll zu tun mit der Kleinen hier. Das Kämpfen überlasse ich euch!
#. fr: On vous laisse vous occuper des vilains pas beaux pendant qu'on protège la petite, ja<nbsp>!
msgctxt "InstanceContentTextData:41460:0:0"
msgid "Go. We'll look after the girl."
msgstr "Идите. Мы присмотрим за девочкой."

#. ja: この先から、バカでかい気配を感じるぜ！<br>注意して進みな！
#. de: Da vorn wartet irgendwas Riesiges. Jetzt nicht die Köpfe verlieren!
#. fr: Notre flair ne nous trompe jamais, il y a un très gros morceau devant<nbsp>!
msgctxt "InstanceContentTextData:41461:0:0"
msgid "On your guard. I sense something up ahead. Something big..."
msgstr "Будьте начеку. Впереди что-то чую. Что-то большое..."

#. ja: これは……強制転移の魔法だよ！<br>はぐれないように気をつけて！
#. de: Das<nbsp>... ist Teleportationsmagie! Wir dürfen uns nicht aus den Augen verlieren!
#. fr: C'est un sort de téléportation<nbsp>! Restons tous groupés<nbsp>!
msgctxt "InstanceContentTextData:41462:0:0"
msgid "Teleportation magick!? Brace yourselves!"
msgstr "Магия телепортации?! Держитесь крепче!"

#. ja: ったく、いったいどこに飛ばしやがった……って、<br>遺跡が空に浮いてやがるぞ……！
#. de: Wo sind wir jetzt wieder gelandet? Moment mal, diese Ruinen schweben ja!
#. fr: Mais... où est-ce qu'on est...<nbsp>? Au beau milieu du ciel<nbsp>!?
msgctxt "InstanceContentTextData:41463:0:0"
msgid "So where are we now? And what are these floating ruins?"
msgstr "Куда это нас забросило? И что это за парящие руины?"

#. ja: あの5人組、どいつもかなりやるようだぜ。<br>油断するなよ。
#. de: Diese fünf da sehen aus, als hätten sie's in sich. Lasst euch nicht auf dem falschen Fuß erwischen!
#. fr: Ces cinq zigotos ont l'air de vouloir en découdre. Faites gaffe à vos fesses, ja<nbsp>!
msgctxt "InstanceContentTextData:41464:0:0"
msgid "Five of them? This should be interesting..."
msgstr "Их пятеро? Ну, вот это уже интересно..."

#. ja: 手強そうな相手だったけど、<br>さすがは武王ウクラマトの協力者だねェ！
#. de: Ein zäher Gegner, aber keine Heraus<shy>forde<shy>rung für die Unterstützer von Königin Wuk Lamat!
#. fr: Vous êtes vraiment fortiches<nbsp>! Je comprends pourquoi Wuk Lamat vous collait aux basques sans arrêt...
msgctxt "InstanceContentTextData:41465:0:0"
msgid "Well fought. Wuk Lamat chose her companions well."
msgstr "Отлично сражались. Вук Ламат не ошиблась в выборе спутников."

#. ja: あの城がゴール地点か？<br>手厚い歓迎は期待できなさそうだけどよ……。
#. de: Wir müssen also zum Schloss? Erwartet nur nicht, mit Jubel empfangen zu werden.
#. fr: C'est ce château, la ligne d'arrivée<nbsp>? L'accueil ne sera cer<shy>tai<shy>ne<shy>ment pas des plus chaleureux...
msgctxt "InstanceContentTextData:41466:0:0"
msgid "Our next destination. No doubt a warm reception awaits us."
msgstr "Наше следующее место назначения. Вряд ли нас там встретят с распростёртыми объятиями."

#. ja: 微塵がくれ発動まで　10　秒！
#. de: Mijin Gakure in 10 Sekunden!
#. fr: Mijin Gakure dans 10 secondes<nbsp>!
msgctxt "InstanceContentTextData:41467:0:0"
msgid "Mijin Gakure in 10 seconds!"
msgstr "Мидзин Гакурэ через 10 секунд!"

#. ja: 微塵がくれ発動まで　5　秒！
#. de: Mijin Gakure in 5 Sekunden!
#. fr: Mijin Gakure dans 5 secondes<nbsp>!
msgctxt "InstanceContentTextData:41468:0:0"
msgid "Mijin Gakure in 5 seconds!"
msgstr "Мидзин Гакурэ через 5 секунд!"

#. ja: 微塵がくれ発動まで　4　秒！
#. de: Mijin Gakure in 4 Sekunden!
#. fr: Mijin Gakure dans 4 secondes<nbsp>!
msgctxt "InstanceContentTextData:41469:0:0"
msgid "Mijin Gakure in 4 seconds!"
msgstr "Мидзин Гакурэ через 4 секунды!"

#. ja: 微塵がくれ発動まで　3　秒！
#. de: Mijin Gakure in 3 Sekunden!
#. fr: Mijin Gakure dans 3 secondes<nbsp>!
msgctxt "InstanceContentTextData:41470:0:0"
msgid "Mijin Gakure in 3 seconds!"
msgstr "Мидзин Гакурэ через 3 секунды!"

#. ja: 微塵がくれ発動まで　2　秒！
#. de: Mijin Gakure in 2 Sekunden!
#. fr: Mijin Gakure dans 2 secondes<nbsp>!
msgctxt "InstanceContentTextData:41471:0:0"
msgid "Mijin Gakure in 2 seconds!"
msgstr "Мидзин Гакурэ через 2 секунды!"

#. ja: 微塵がくれ発動まで　1　秒！
#. de: Mijin Gakure in 1 Sekunde!
#. fr: Mijin Gakure dans 1 seconde<nbsp>!
msgctxt "InstanceContentTextData:41472:0:0"
msgid "Mijin Gakure in 1 second!"
msgstr "Мидзин Гакурэ через 1 секунду!"

#. ja: ぐ～る……
#. de: Ene Mene<nbsp>...
#. fr: Hop-là...
msgctxt "InstanceContentTextData:41473:0:0"
msgid "Wait for it..."
msgstr "Ну же..."

#. ja: ドォーーーーーン！！！！！
#. de: Schmackeeeees!
#. fr: BOOOOOOUUUUUM<nbsp>!!
msgctxt "InstanceContentTextData:41474:0:0"
msgid "BAM!!!"
msgstr "БАМ!!!"

#. ja: 羅刹七星拳ンン！！
#. de: Extrem rosiger Kinnhaken!
#. fr: Méga uppercut auroral<nbsp>!!
msgctxt "InstanceContentTextData:41475:0:0"
msgid "Auroral Uppercut!"
msgstr "Авроральный апперкот!"

#. ja: 微塵がくれ発動まで　30　秒！
#. de: Mijin Gakure in 30 Sekunden!
#. fr: Mijin Gakure dans 30 secondes<nbsp>!
msgctxt "InstanceContentTextData:41476:0:0"
msgid "Mijin Gakure in 30 seconds!"
msgstr "Мидзин Гакурэ через 30 секунд!"

#. ja: 微塵がくれ発動まで　20　秒！
#. de: Mijin Gakure in 20 Sekunden!
#. fr: Mijin Gakure dans 20 secondes<nbsp>!
msgctxt "InstanceContentTextData:41477:0:0"
msgid "Mijin Gakure in 20 seconds!"
msgstr "Мидзин Гакурэ через 20 секунд!"

#. ja: こんにちは、そしてさようなら！
#. de: Hallo! Und auf Wieder<shy>sehen!
#. fr: Bienvenue et adieu<nbsp>!
msgctxt "InstanceContentTextData:41600:0:0"
msgid "Greetings and good-bye."
msgstr "Приветствую... и прощайте."

#. ja: 生きていますか？
#. de: Lebt ihr wirklich?
#. fr: Êtes-vous vivants<nbsp>?
msgctxt "InstanceContentTextData:41601:0:0"
msgid "Are you alive?"
msgstr "Вы живы?"

#. ja: 幸せですか？
#. de: Seid ihr glücklich?
#. fr: Êtes-vous heureux<nbsp>?
msgctxt "InstanceContentTextData:41602:0:0"
msgid "Are you happy?"
msgstr "Вы счастливы?"

#. ja: 死をのりこえましょう！
#. de: Lasst uns den Tod überwinden!
#. fr: Ensemble, surmontons la mort<nbsp>!
msgctxt "InstanceContentTextData:41603:0:0"
msgid "Let us rise above death!"
msgstr "Давайте победим саму смерть!"

#. ja: エーテルが必要です！
#. de: Benötige Äther!
#. fr: Mon peuple a besoin de votre éther<nbsp>!
msgctxt "InstanceContentTextData:41604:0:0"
msgid "We require aether."
msgstr "Нам нужен эфир."

#. ja: 死んでもおわりではありません！<br>さあ、こわがらないで！
#. de: Der Tod ist nicht das Ende! Fürchtet euch nicht!
#. fr: N'ayez pas peur, la mort n'est pas une fin en soi<nbsp>!
msgctxt "InstanceContentTextData:41605:0:0"
msgid "Do not be afraid. Death is not the end. "
msgstr "Не бойтесь. Смерть — это ещё не конец."

#. ja: 接続された世界を、お見せしましょう！
#. de: Seht die neu verbundene Welt!
#. fr: Admirez le lien entre les mondes<nbsp>!
msgctxt "InstanceContentTextData:41606:0:0"
msgid "I will show you the worlds beyond."
msgstr "Я покажу вам миры за пределами этого."

#. ja: 小型ユニットを展開します！
#. de: Sende Kampfeinheiten aus!
#. fr: Déploiement des sous-unités<nbsp>!
msgctxt "InstanceContentTextData:41607:0:0"
msgid "Deploying drones."
msgstr "Запускаю дронов."

#. ja: まだ生きていますか？<br>予備動力を起動します！
#. de: Lebt ihr immer noch? Aktiviere Energiereserven!
#. fr: Êtes-vous toujours en vie<nbsp>? Activation de la puissance de réserve...
msgctxt "InstanceContentTextData:41608:0:0"
msgid "Are you still alive? Activating reserve power."
msgstr "Вы всё ещё живы? Запускаю резервное питание."

#. ja: まだ生きていますか？<br>安全装置を解除します！
#. de: Lebt ihr immer noch? Entferne Sicherungsvorrichtungen!
#. fr: Êtes-vous toujours en vie<nbsp>? Déverrouillage de la sécurité...
msgctxt "InstanceContentTextData:41609:0:0"
msgid "Are you still alive? Disengaging safeties."
msgstr "Вы всё ещё живы? Отключаю предохранители."

#. ja: 空間を掌握しました！<br>存在抹消を実行します！
#. de: Raumkontrolle aktiviert! Vernichte existente Lebensformen!
#. fr: Zone cible délimitée. Suppression de toute existence...
msgctxt "InstanceContentTextData:41610:0:0"
msgid "Target area delineated. Commencing erasure."
msgstr "Целевая зона определена. Начинаю стирание."

#. ja: 限界負荷を超過……中断します。
#. de: Maximale Belastung überschritten ... Unterbrechung notwendig.
#. fr: Surcharge du système... Interruption de la procédure.
msgctxt "InstanceContentTextData:41611:0:0"
msgid "System overload. Aborting process."
msgstr "Система перегружена. Прерываю процесс."

#. ja: まだ生きて……空間掌握……再実行します！
#. de: Lebt ihr imm...? ... Aktivi... Raumkontrolle ...!
#. fr: ... Toujours en vie<nbsp>?<nbsp>...ne délimitée...<nbsp>...eprise de la suppression...
msgctxt "InstanceContentTextData:41612:0:0"
msgid "Are you still alive? Recommencing erasure."
msgstr "Вы всё ещё живы? Повторяю стирание."

#. ja: 限界負荷……超過……<br>エラーが発生し……
#. de: Maximale Belastung ... Fehler entdeckt ...
#. fr: Surcharg... extrême... Erreur dé...
msgctxt "InstanceContentTextData:41613:0:0"
msgid "System overload. An error has occurred."
msgstr "Перегрузка системы. Произошла ошибка."

#. ja: 強制実行……命令……確認……
#. de: Unterbrechung unterbunden ... Ver...
#. fr: Instruction<nbsp>...écution<nbsp>...rcée... con...ée.
msgctxt "InstanceContentTextData:41614:0:0"
msgid "System override order confirmed."
msgstr "Приказ на принудительное выполнение подтверждён."

#. ja: アブソリュート・オーソリティ発動まで　5
#. de: Absolute Autorität in 5<nbsp>...
#. fr: 5 secondes avant Autorité absolue...
msgctxt "InstanceContentTextData:41615:0:0"
msgid "5 seconds to Absolute Authority..."
msgstr "До активации «Абсолютной власти» осталось 5 секунд..."

#. ja: アブソリュート・オーソリティ発動まで　4
#. de: Absolute Autorität in 4<nbsp>...
#. fr: 4 secondes avant Autorité absolue...
msgctxt "InstanceContentTextData:41616:0:0"
msgid "4 seconds to Absolute Authority..."
msgstr "До активации «Абсолютной власти» осталось 4 секунды..."

#. ja: アブソリュート・オーソリティ発動まで　3
#. de: Absolute Autorität in 3<nbsp>...
#. fr: 3 secondes avant Autorité absolue...
msgctxt "InstanceContentTextData:41617:0:0"
msgid "3 seconds to Absolute Authority..."
msgstr "До активации «Абсолютной власти» осталось 3 секунды..."

#. ja: アブソリュート・オーソリティ発動まで　2
#. de: Absolute Autorität in 2<nbsp>...
#. fr: 2 secondes avant Autorité absolue...
msgctxt "InstanceContentTextData:41618:0:0"
msgid "2 seconds to Absolute Authority..."
msgstr "До активации «Абсолютной власти» осталось 2 секунды..."

#. ja: アブソリュート・オーソリティ発動まで　1
#. de: Absolute Autorität in 1<nbsp>...
#. fr: 1 seconde avant Autorité absolue...
msgctxt "InstanceContentTextData:41619:0:0"
msgid "1 second to Absolute Authority..."
msgstr "До активации «Абсолютной власти» осталась 1 секунда..."

#. ja: ココ、コんに……こんニチは！<br>そそそソシて、そソシて、さようナラ……！！！
#. de: Ha-Ha-HALlo<nbsp>... u-u-u-uNd AUf<nbsp>... AuFWiEDErsEhEN!
#. fr: ◎×■venue e-e-e-et ad#▼△ieu<nbsp>!
msgctxt "InstanceContentTextData:41620:0:0"
msgid "GreE-Gree-GreETinGs...a-a-a-aNd goOd-byE..."
msgstr "Приве-е-ет... и-и-и до свида-а-ания..."

#. ja: トワびトの、み、ミなさんは、ゴ安心……さい……！<br>まもなく、いのチ、いのチが、がガガ……。
#. de: ViE-VIe...En..Nk. ÄtHEr...In KÜrze be-BE-Be<nbsp>...
#. fr: É◎×■♭nels, veu▼△ patienter. La dis■♭!×tion d'énergie ×■tale-ale-ale-ale...
msgctxt "InstanceContentTextData:41621:0:0"
msgid "BeEe aT eAsE, everyone. Your aeTHer will SOon...pleNIshED-shED-shED-shED..."
msgstr "Не волну-у-уйтесь, все... Ваш эфир вскоре по-по-пополни-и-и-ится..."

#. ja: もしモの、トき……ハ……<br>きミ、が……わタシを……。
#. de: HmM, im FaLl...F?!lE...Wirst <i>du</i>...?!
#. fr: Dans ce cas, si ja◎×■♭!×#▼sion △♭◎ne au vinaigre... Je p... ourrai ×#?■ sur toi...<nbsp>?
msgctxt "InstanceContentTextData:41622:0:0"
msgid "IF tHIngS shoULd...turN...wORSe... MiGHt...aID..."
msgstr "Ес-если что-то пойдёт не так... ты... поможешь мне...?"

#. ja: せ、せつゾく……世界を……<br>オオお、見せ、しましょう……！
#. de: Se-seHt DIE...eu ver...nDenE WElt!
#. fr: Ad-ad-dmir▼△ez le lien en■♭tre les mon-◎▼ondes<nbsp>!
msgctxt "InstanceContentTextData:41623:0:0"
msgid "I-I will SHow you...tH-tH-tHe woRLds beyoND..."
msgstr "Я-я покажу вам... миры за пре-пределами..."

#. ja: シシ、し……しあわ、セ、ですか……？
#. de: SeI-sEi-Seid<nbsp>... SEiD ihR glüCKLiCh?
#. fr: Êtes-v■♭... Êtes-vous heu▼◎eux<nbsp>?
msgctxt "InstanceContentTextData:41624:0:0"
msgid "Are yOu-are yoU-are YOu...are you hapPY?"
msgstr "Вы счастливы...? Сча-стливы...?"

#. ja: こ、ココ、こわがら……ナい……で……。
#. de: Fü-fÜ-Fü-füRChtEt...ch...nICHT!
#. fr: N'a-n'a-n'ayez ◎×■ peur, la mort n'est pas #▼△ fin en soi<nbsp>!
msgctxt "InstanceContentTextData:41625:0:0"
msgid "Do...DO-do-do not be a-Be AFraID..."
msgstr "Н-не б-бойтесь..."

#. ja: し、シを……死を、死を！<br>のりこえましょう！
#. de: LaS...LAsST uN...laSsT UN...LAssT un...ÜBErWiNdEN!
#. fr: Ensem... Ens-ens-ens■♭!ble, surmontons la mort<nbsp>!
msgctxt "InstanceContentTextData:41626:0:0"
msgid "Let...let uS...let us...let uS...above deaTH..."
msgstr "Давайте... пре-пре-преодолеем... смерть!"

#. ja: 真の闇に溶けるがいい！
#. de: Sinkt in die Schwärze wahrer Dunkelheit!
#. fr: Bientôt, vous ne ferez plus qu'un avec les Ténèbres<nbsp>!
msgctxt "InstanceContentTextData:41700:0:0"
msgid "Drown in true Darkness!"
msgstr "Тоните во Тьме истинной!"

#. ja: 闇の力を刃と為さん……！
#. de: Scharf schneidet unsere Schwärze!
#. fr: Que les Ténèbres enveloppent mes lames<nbsp>!
msgctxt "InstanceContentTextData:41701:0:0"
msgid "Darkness as my blade!"
msgstr "Тьму обращу в клинок!"

#. ja: 無がすべてを凌駕する！
#. de: Das Nichts wird alles verschlingen!
#. fr: Le néant enveloppera tout<nbsp>!
msgctxt "InstanceContentTextData:41702:0:0"
msgid "Nothingness rules over all!"
msgstr "Ничто превзойдёт всё сущее!"

#. ja: 我が雲にて、光を覆わん……！
#. de: Alles Licht soll in uns vergehen!
#. fr: Jamais la Lumière ne percera ce nuage<nbsp>!
msgctxt "InstanceContentTextData:41703:0:0"
msgid "My clouds shall smother Light!"
msgstr "Мои облака поглотят Свет!"

#. ja: さらなる暗闇へ導こうぞ……！
#. de: Hinab in den Abgrund!
#. fr: Sombrez dans l'abîme<nbsp>!
msgctxt "InstanceContentTextData:41704:0:0"
msgid "Darkest Darkness awaits!"
msgstr "Вас ждёт всё более тёмная бездна..."

#. ja: まとめて消し飛べ……！
#. de: Ins Nichts!
#. fr: Soyez anéantis<nbsp>!
msgctxt "InstanceContentTextData:41705:0:0"
msgid "Begone with you!"
msgstr "Сгиньте все разом!"

#. ja: 小虫ども、薙ぎ払ってくれようぞ！
#. de: Ihr Maden, hinfort mit euch!
#. fr: Je vais vous exterminer comme les insectes que vous êtes<nbsp>!
msgctxt "InstanceContentTextData:41706:0:0"
msgid "I will exterminate you like the vermin you are!"
msgstr "Изничтожу вас, мерзкие твари!"

#. ja: 闇も光も我が腕の中に……。
#. de: Licht und Dunkel, beides halten wir in unseren Händen!
#. fr: Ténèbres... Lumière... Lovés dans mes bras...
msgctxt "InstanceContentTextData:41707:0:0"
msgid "Both Darkness and Light in my hands..."
msgstr "И Свет, и Тьма — в моих руках..."

#. ja: すべては優しき無へと還る……。
#. de: Gebt euch der Stille der Dunkelheit hin<nbsp>...
#. fr: Acceptez la caresse du néant...
msgctxt "InstanceContentTextData:41708:0:0"
msgid "All shall know oblivion's sweet embrace..."
msgstr "Всё вернётся в ласковое небытие..."

#. ja: 死すらも無への過程に過ぎぬと知れ……。
#. de: Auch der Tod ist nur ein Teil des allumfassenden Nichts!
#. fr: La mort n'est que le commencement...
msgctxt "InstanceContentTextData:41709:0:0"
msgid "Death is but a prelude to nothingness..."
msgstr "Смерть — лишь преддверие небытия..."

#. ja: 闇の風よ、すべてを無へと送れ……！
#. de: Dunkler Wind, wirble alles in die Finsternis!
#. fr: Que le tumulte ténébreux vous emporte<nbsp>!
msgctxt "InstanceContentTextData:41710:0:0"
msgid "Winds of Darkness, usher all unto oblivion!"
msgstr "Ветры Тьмы, унесите всё в небытие!"

#. ja: 死よ、我が腕に宿れ……！
#. de: Kalter Tod, erfülle unsere Brust!
#. fr: Plénitude de la mort... Je t'attire en mon sein<nbsp>!
msgctxt "InstanceContentTextData:41711:0:0"
msgid "Death abide in my breast!"
msgstr "Смерть, войди в мою грудь..."

#. ja: 風よ、我が腕に宿れ……！
#. de: Schwarzer Wind, erfülle unsere Brust!
#. fr: Impétuosité des vents... Je t'attire en mon sein<nbsp>!
msgctxt "InstanceContentTextData:41712:0:0"
msgid "Wind abide in my breast!"
msgstr "Ветер, войди в мою грудь..."

#. ja: 闇の力を……もう抑えられん……！
#. de: Nichts ... Nichts kann die Macht der Dunkelheit mehr aufhalten!
#. fr: Je n'arrive plus à contenir... le pouvoir des Ténèbres<nbsp>!
msgctxt "InstanceContentTextData:41713:0:0"
msgid "The Darkness...will not be contained!"
msgstr "Тьму... уже не сдержать!"

#. ja: 物言わぬ石と化すがいい……！
#. de: Schweigt still wie stummer Stein!
#. fr: Soyez réduits à l'état de pierres<nbsp>!
msgctxt "InstanceContentTextData:41714:0:0"
msgid "Become silent stone!"
msgstr "Превратитесь в безмолвный камень..."

#. ja: さあ、逃げ切れるか……？
#. de: Gelingt euch der Griff nach der Freiheit?
#. fr: Essayez donc d'éviter ça<nbsp>!
msgctxt "InstanceContentTextData:41715:0:0"
msgid "You shall not escape!"
msgstr "Вам не сбежать!"

#. ja: 今こそ誓いを果たす時……
#. de: Ich bin der Einzige, der sie beschützen kann ...
#. fr: Je suis le seul à même de la protéger...
msgctxt "InstanceContentTextData:41800:0:0"
msgid "I'm the only one fit to protect her..."
msgstr "Только я достойный защитить её..."

#. ja: 構えよ、この技が見切れるか！？
#. de: Komm! Zeig mir deine Stärke!
#. fr: Voyons un peu ce que vous valez... En garde<nbsp>!
msgctxt "InstanceContentTextData:41801:0:0"
msgid "Come! Show me your strength!"
msgstr "Ну же! Покажи, на что способен!"

#. ja: 今度こそ間違わない……。
#. de: Nur ich kann sie beschützen!
#. fr: J'ai juré de la protéger...
msgctxt "InstanceContentTextData:41802:0:0"
msgid "Only I can protect her!"
msgstr "Только я могу её защитить!"

#. ja: あくまで静寂を乱そうというのか……。
#. de: Wer wagt es, meine Ruhe zu stören<nbsp>...?
#. fr: Ainsi, vous cherchez à rompre la sérénité de ces lieux...
msgctxt "InstanceContentTextData:41803:0:0"
msgid "Fools... You would stoke the fires of conflict?"
msgstr "Глупцы... И вы хотите разжечь пламя раздора?"

#. ja: 光によりて、静寂を！
#. de: Das Licht bringt den Frieden!
#. fr: Place à la Lumière, porteuse de calme et de volupté<nbsp>!
msgctxt "InstanceContentTextData:41804:0:0"
msgid "The Light shall usher in peace!"
msgstr "Свет принесёт мир!"

#. ja: 聖竜よ、来たれ……！
#. de: Hraesvelgr, steh mir bei!
#. fr: À moi, dragon sacré<nbsp>!
msgctxt "InstanceContentTextData:41805:0:0"
msgid "Come to me, Hraesvelgr!"
msgstr "Хресвельгр, явись ко мне!"

#. ja: 新たな竜詩を紡ぐ……！
#. de: Ich werde den Frieden bringen ...!
#. fr: Le chant des dragons va de nouveau résonner<nbsp>!
msgctxt "InstanceContentTextData:41806:0:0"
msgid "I shall weave a new Dragonsong!"
msgstr "Я сплету новую песнь драконов!"

#. ja: ねぇ見て、ネックレスにして正解！
#. de: Ich hab doch gesagt, das wird eine schicke Halskette.
#. fr: C'était une bonne idée d'en faire un collier<nbsp>!
msgctxt "InstanceContentTextData:41807:0:0"
msgid "I told you it would make a great necklace."
msgstr "Ну вот, я же говорила, что из него выйдет чудесное ожерелье."

#. ja: すごくキレイ、絶対ガイアに似合うよ！
#. de: Wunderschön ... Ich finde, sie steht dir wirklich gut!
#. fr: Oh oui, je suis sûre qu'il t'ira à ravir<nbsp>!
msgctxt "InstanceContentTextData:41808:0:0"
msgid "Ohhh...it's beautiful! I think it'll really suit you!"
msgstr "О-о-о... Какая красота! Тебе очень пойдёт!"

#. ja: え、私が着けるの！？<br>だってこれはリーンが……。
#. de: Mir? Aber ich dachte, du solltest sie haben<nbsp>...
#. fr: Tu veux que je le porte<nbsp>? Mais c'est pourtant toi qui...
msgctxt "InstanceContentTextData:41809:0:0"
msgid "Me? But I thought you should have it..."
msgstr "Мне? Но я думала, оно для тебя..."

#. ja: 氷のネックレス？<br>なんでこんなものを……？
#. de: Ist das Eis? Wo ist das hergekommen?
#. fr: Un collier de glace<nbsp>? D'où il sort<nbsp>?
msgctxt "InstanceContentTextData:41810:0:0"
msgid "Is this ice? Where did this come from?"
msgstr "Это лёд? Откуда он взялся?"

#. ja: 混沌の闇よ！<br>天より降りて、光を圧し潰せ！
#. de: Das Chaos regiert auf ewig!
#. fr: Ô Ténèbres du chaos, descendez du ciel et anéantissez la Lumière<nbsp>!
msgctxt "InstanceContentTextData:41811:0:0"
msgid "O Chaotic Dark, descend and quench Light!"
msgstr "О, Хаотическая Тьма, сойди с небес и погаси Свет!"

#. ja: 過去……現在……未来……。
#. de: Ver<shy>gangen<shy>heit ... Gegenwart ... Zukunft.
#. fr: Passé... Présent... Futur...
msgctxt "InstanceContentTextData:41812:0:0"
msgid "Past...present...future."
msgstr "Прошлое... настоящее... будущее..."

#. ja: 無限の可能性を、ひとつに集約する！
#. de: Unbegrenzte Möglichkeiten, verdichtet in einem Moment!
#. fr: Ici convergent une infinité de possibilités<nbsp>!
msgctxt "InstanceContentTextData:41813:0:0"
msgid "Infinite possibilities...condensed into a single moment!"
msgstr "Бесконечные возможности... сведены к одному мгновению!"

#. ja: 苦しみは刹那、喜びは永遠……。
#. de: Schmerz möge flüchtig sein und Freude unvergänglich<nbsp>...
#. fr: Éphémère douleur, éternel bonheur...
msgctxt "InstanceContentTextData:41814:0:0"
msgid "Pain shall be fleeting, joy everlasting..."
msgstr "Пусть боль будет мимолётной, а радость — вечной..."

#. ja: 我が意のままに、時は流れる！
#. de: Der Fluss der Zeit soll sich meinem Willen beugen!
#. fr: Désormais, le temps s'écoule selon ma volonté<nbsp>!
msgctxt "InstanceContentTextData:41815:0:0"
msgid "As I wish it, so shall the river of time flow!"
msgstr "Время течёт так, как я пожелаю!"

#. ja: どこまでも抗うか……<br>ならば、その内なる光を利用してやろう！
#. de: Ihr gebt nicht nach<nbsp>... So muss das innere Licht heller strahlen!
#. fr: Puisque vous vous obstinez, je vais devoir puiser dans sa Lumière<nbsp>!
msgctxt "InstanceContentTextData:41816:0:0"
msgid "Still you resist. Then we shall unleash the Light within!"
msgstr "Всё ещё сопротивляетесь? Тогда выпустим Свет, что таится внутри!"

#. ja: 駄目……やらせはしないっ！
#. de: Nein ... Das darfst du nicht!
#. fr: Non... Je ne te laisserai pas faire<nbsp>!
msgctxt "InstanceContentTextData:41817:0:0"
msgid "No! I won't let you!"
msgstr "Нет! Не позволю!"

#. ja: ああああああああ！！
#. de: Aaaaaah!
#. fr: Aaaaaaaah<nbsp>!
msgctxt "InstanceContentTextData:41818:0:0"
msgid "Aaaaaahhh!"
msgstr "А-а-а-а-а-а!"

#. ja: リーン！
#. de: Ryne!
#. fr: Ryne<nbsp>!
msgctxt "InstanceContentTextData:41819:0:0"
msgid "Ryne!"
msgstr "Райн!"

#. ja: このままじゃ、リーンの魂がもたない！
#. de: Lange wird sie das nicht aushalten!
#. fr: Elle tiendra pas longtemps à ce rythme<nbsp>!
msgctxt "InstanceContentTextData:41820:0:0"
msgid "She won't last much longer!"
msgstr "Она долго не продержится!"

#. ja: タアァッ！
#. de: Hyahaa!
#. fr: Raaaah<nbsp>!!
msgctxt "InstanceContentTextData:41821:0:0"
msgid "Yaaaaaargh!"
msgstr "А-а-а-а!"

#. ja: ディレイスペルッ！
#. de: Jetzt reicht es mir!
#. fr: Déphasage<nbsp>!
msgctxt "InstanceContentTextData:41822:0:0"
msgid "Hold on, Ryne!"
msgstr "Держись, Райн!"

#. ja: リーン、大丈夫！？
#. de: Ryne, alles in Ordnung?!
#. fr: Ryne, est-ce que ça va<nbsp>!?
msgctxt "InstanceContentTextData:41823:0:0"
msgid "Ryne, are you alright!?"
msgstr "Райн, ты в порядке?!"

#. ja: フッ、助かったぞ、ガイア……！
#. de: Heh ... Dank dir, Gaia.
#. fr: Hmph... Tu m'as sauvée, Gaïa...
msgctxt "InstanceContentTextData:41824:0:0"
msgid "I am thanks to you, Gaia."
msgstr "Хм... Это благодаря тебе, Гайя."

#. ja: アンタ、ミトロン……？<br>あ、ああああっ……！
#. de: Was ... Mitron?! Aaaaah!
#. fr: T-tu es Mitron<nbsp>!? Ah... Aaaaaah<nbsp>!!
msgctxt "InstanceContentTextData:41825:0:0"
msgid "You're Mitron! Ugh... Aaaaaahhh!"
msgstr "Ты... Митрон?! А-а-а-а!"

#. ja: 私は、アシエン・アログリフ……<br>戒律王の巫女……！
#. de: Ich bin der Ascian Loghrif<nbsp>...
#. fr: Je suis Loghrif... adepte du grand Zordiarche<nbsp>!
msgctxt "InstanceContentTextData:41826:0:0"
msgid "I am Loghrif, servant of Zodiark."
msgstr "Я — асцианка Логриф, служительница Зодиарка!"

#. ja: 世界に真の闇を取り戻す者……！
#. de: Und ich werde die Macht der Dunkelheit dieser Welt wieder<shy>herstellen!
#. fr: J'apporte les Ténèbres absolues sur cette terre<nbsp>!
msgctxt "InstanceContentTextData:41827:0:0"
msgid "I shall restore the power of Darkness to this star."
msgstr "Я верну этой звезде власть Тьмы!"

#. ja: まだ彼女が真に覚醒していない……。<br>接続が万全ではないのか。
#. de: Sie ist noch nicht vollständig erwacht<nbsp>... Die Erinnerungen dieser Mädchen schwächen die Verbindung.
#. fr: Elle ne s'est pas encore totalement éveillée... Notre lien serait-il incomplet<nbsp>?
msgctxt "InstanceContentTextData:41828:0:0"
msgid "Her awakening is incomplete... Their memories weaken the link."
msgstr "Она ещё не пробудилась до конца... Их воспоминания ослабляют связь."

#. ja: 我らの共鳴を阻む少女たち。<br>余計な記憶をすべて消去する……！
#. de: Sie stehen unserer Resonanz im Weg<nbsp>... Fort mit ihnen!
#. fr: Ces jeunes filles troublent notre harmonie... Leurs souvenirs doivent disparaître<nbsp>!
msgctxt "InstanceContentTextData:41829:0:0"
msgid "Such impediments to our resonance must be expunged."
msgstr "Они мешают нашему резонансу. Их воспоминания нужно стереть!"

#. ja: 時は満ちた……<br>ともに闇に還ろう、とこしえに……！
#. de: Ja! Ja! Nun wird dich nichts mehr von mir fern<shy>halten!
#. fr: L'heure est venue... Tout retournera aux Ténèbres pour l'éternité<nbsp>!
msgctxt "InstanceContentTextData:41830:0:0"
msgid "The time is come. Together, we shall rejoin the Darkness!"
msgstr "Настал час... Мы навеки вернёмся во Тьму!"

#. ja: 今こそ調和がもたらされん。
#. de: Wir werden ewige Harmonie bringen.
#. fr: Notre harmonie est enfin accomplie.
msgctxt "InstanceContentTextData:41831:0:0"
msgid "We shall bring eternal harmony."
msgstr "Мы принесём вечную гармонию."

#. ja: 活性と停滞の極み……希望の園エデン……！
#. de: Ruhe und Lebendigkeit in perfektem Gleichgewicht<nbsp>...
#. fr: Essor et stagnation... L'ultime utopie<nbsp>!
msgctxt "InstanceContentTextData:41832:0:0"
msgid "Tranquility and vitality in perfect balance..."
msgstr "Покой и жизненная сила... в совершенном равновесии."

#. ja: まだだ  我らが交わした約束……<br>誰にも消させはしない！
#. de: Nein, wir gaben uns ein Versprechen<nbsp>... Und das wird uns niemand nehmen!
#. fr: Ce n'est pas fini... Personne ne m'empêchera d'accomplir notre promesse<nbsp>!
msgctxt "InstanceContentTextData:41833:0:0"
msgid "No one will erase our promise. No one!"
msgstr "Нет. Наше обещание... Никто не сотрёт его!"

#. ja: この共鳴……頭が割れそうだ！
#. de: Diese Resonanz ... Argh, mein Kopf!
#. fr: Assez... Assez de ces jacasseries<nbsp>!
msgctxt "InstanceContentTextData:41834:0:0"
msgid "This cacophony... My head..."
msgstr "Этот гул... Голова раскалывается..."

#. ja: もう少しで完全なる理想郷が完成したというのに……！
#. de: Wir waren unserer Utopie so nah ...!
#. fr: Et dire que notre utopie allait enfin devenir réalité<nbsp>!
msgctxt "InstanceContentTextData:41835:0:0"
msgid "So close to realizing our perfect utopia..."
msgstr "Мы были так близки к идеальной утопии..."

#. ja: 何度でも……やり直してみせる！
#. de: Wieder und wieder werde ich es versuchen!
#. fr: Je recommencerai tout à zéro, autant de fois qu'il le faudra<nbsp>!
msgctxt "InstanceContentTextData:41836:0:0"
msgid "I'll never stop. As many times as it takes!"
msgstr "Я не остановлюсь. Буду пробовать снова и снова!"

#. ja: そうだ……。<br>もう一度転生してくれば、きっと……！
#. de: Ja ... Nächstes Mal wird es mir gelingen!
#. fr: Oui... Si je peux me réincarner à nouveau, j'y arriverai...<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:41837:0:0"
msgid "When next I return, I <i>will</i> succeed!"
msgstr "Когда я вернусь, я <i>добьюсь</i> своего!"

#. ja: お前たちの存在など、私の記憶から消えてしまえ！
#. de: Ich brenne eure Existenz aus meiner Erinnerung!
#. fr: Je vais vous rayer de mon esprit<nbsp>! Vous n'existerez plus<nbsp>!
msgctxt "InstanceContentTextData:41838:0:0"
msgid "Begone from my memories! Every last trace of you!"
msgstr "Сгиньте из моей памяти! Не оставлю от вас и следа!"

#. ja: 私たちは、消えたりなんかしない！
#. de: Wir lassen uns nicht einfach wegwischen!
#. fr: Hors de question qu'on disparaisse<nbsp>!
msgctxt "InstanceContentTextData:41839:0:0"
msgid "We're not going to disappear!"
msgstr "Мы не исчезнем!"

#. ja: 悪いけど、そんなに存在感薄くないのよ！
#. de: Genau. Tut uns leid, aber so leicht machen wir es dir nicht!
#. fr: Désolée, mais on est pas du genre à se laisser gentiment évincer<nbsp>!
msgctxt "InstanceContentTextData:41840:0:0"
msgid "Aye, we're too stubborn for that!"
msgstr "Ага, нас так просто не вычеркнуть!"

#. ja: リーン……必ず一緒に帰りましょう！
#. de: Ryne ... Wir werden das hier zusammen durchstehen!
#. fr: Ryne... On va s'en sortir, toi et moi<nbsp>!
msgctxt "InstanceContentTextData:41841:0:0"
msgid "We'll get through this, Ryne!"
msgstr "Мы справимся, Райн!"

#. ja: うん、約束だよ！
#. de: Ja! Fest versprochen!
#. fr: Oui<nbsp>! Promis, juré<nbsp>!
msgctxt "InstanceContentTextData:41842:0:0"
msgid "Yes, together!"
msgstr "Да! Вместе!"

#. ja: あの人なら、きっと大丈夫……！
#. de: Ich habe volles Vertrauen!
#. fr: Notre <if $gn4>amie<else>ami</if> triomphera, j'en suis certaine<nbsp>!
msgctxt "InstanceContentTextData:41843:0:0"
msgid "Our friend won't fail us!"
msgstr "Наш друг нас не подведёт!"

#. ja: じゃなきゃ承知しないわ。<br>……期待に応えてよね！
#. de: Richtig. Und ich habe hohe Erwartungen!
#. fr: Y a intérêt... Hé, nous déçois pas, d'accord<nbsp>?
msgctxt "InstanceContentTextData:41844:0:0"
msgid "You'd better not, or I'll never let you hear the end of it!"
msgstr "Вот и отлично. А теперь не разочаруй меня, ясно?"

#. ja: 明日を、諦めない……！
#. de: Glaube fest an das Morgen!
#. fr: Allez... On va s'accrocher à notre avenir<nbsp>!
msgctxt "InstanceContentTextData:41845:0:0"
msgid "We won't give up on the future!"
msgstr "Мы не откажемся от будущего!"

#. ja: 私たちの祈り……届いて！
#. de: Und höre unser Gebet!
#. fr: Puissent nos prières être exaucées <nbsp>!
msgctxt "InstanceContentTextData:41846:0:0"
msgid "Please, let our prayers be heard!"
msgstr "Пусть наши молитвы будут услышаны!"

#. ja: ここはもう、我らの理想郷ではない……！
#. de: Dies ist nicht mehr unsere Utopie!
#. fr: Je ne reconnais déjà plus notre utopie...
msgctxt "InstanceContentTextData:41847:0:0"
msgid "If this place cannot be our utopia..."
msgstr "Если это место уже не может стать нашей утопией..."

#. ja: ならば、すべての存在を否定しよう！
#. de: So soll alles Leben vergehen!
#. fr: À ce compte-là... rien ne mérite d'exister<nbsp>!
msgctxt "InstanceContentTextData:41848:0:0"
msgid "Then naught in existence holds meaning!"
msgstr "Тогда ничто из сущего не заслуживает смысла!"

#. ja: 感情が、重すぎるのよ！
#. de: Diese Gefühle ... Sie sind zu stark!
#. fr: J-je sens tout le poids de sa volonté<nbsp>!
msgctxt "InstanceContentTextData:41849:0:0"
msgid "That's a little melodramatic, don't you think!?"
msgstr "Ну и драма! Не кажется?"

#. ja: どうか、負けないで！
#. de: Gib nicht auf!
#. fr: Tenez bon, je vous en prie<nbsp>!
msgctxt "InstanceContentTextData:41850:0:0"
msgid "You can weather this! I know you can!"
msgstr "Держись! Ты справишься, я знаю!"

#. ja: いっけえぇぇぇ！！
#. de: Und looos!
#. fr: Yaaaaah<nbsp>!!!
msgctxt "InstanceContentTextData:41851:0:0"
msgid "Yaaaaaargh!"
msgstr "А-а-а-а!"

#. ja: 約束が、消えていく……。
#. de: Ich konnte unser Versprechen nicht halten.
#. fr: Ainsi meurt notre promesse...
msgctxt "InstanceContentTextData:41852:0:0"
msgid "Our promise fades..."
msgstr "Наше обещание... тает..."

#. ja: 光と闇の力を、ここに！
#. de: Licht und Schatten, hört unseren Ruf!
#. fr: Par la Lumière et les Ténèbres...<nbsp>!
msgctxt "InstanceContentTextData:41853:0:0"
msgid "Light and Darkness, gather to me!"
msgstr "Свет и Тьма, придите ко мне!"

#. ja: 記憶から消し去れぬとでも……！<br>かくなる上は……！
#. de: Warum verschwindet ihr nicht?
#. fr: Leurs souvenirs résistent encore... Dans ce cas...<nbsp>!
msgctxt "InstanceContentTextData:41854:0:0"
msgid "You endure? Another approach, then..."
msgstr "Вы всё ещё держитесь? Тогда попробуем иначе..."

#. ja: 我は汝となりて  汝は我となる！
#. de: Du bist mein und ich bin dein!
#. fr: Nous ne ferons plus qu'un<nbsp>!
msgctxt "InstanceContentTextData:41855:0:0"
msgid "I am yours, and you are mine!"
msgstr "Я — это ты, а ты — это я!"

#. ja: なんだ、これは……！？
#. de: Was soll das?!
#. fr: Hein<nbsp>!? Qu'est-ce que...<nbsp>!?
msgctxt "InstanceContentTextData:41856:0:0"
msgid "What is this!?"
msgstr "Что это такое?!"

#. ja: あんたの好きにはさせない！
#. de: So nicht, sag ich!
#. fr: On va pas se laisser faire<nbsp>!
msgctxt "InstanceContentTextData:41857:0:0"
msgid "I won't let you do as you please!"
msgstr "Не позволю тебе поступать, как вздумается!"

#. ja: なんだ  この姿は……！？
#. de: Was soll das?!
#. fr: Hein<nbsp>? Quelle est cette apparence...<nbsp>!?
msgctxt "InstanceContentTextData:41858:0:0"
msgid "What is this!?"
msgstr "Что это за облик?!"

#. ja: リーン……そこにいるの？
#. de: Ryne, bist du da?!
#. fr: Ryne... T'es là<nbsp>? Réponds-moi<nbsp>!
msgctxt "InstanceContentTextData:41859:0:0"
msgid "Ryne... Are you there?"
msgstr "Райн... Ты меня слышишь?"

#. ja: ガイア……！
#. de: Gaia!
#. fr: Gaïa...<nbsp>?
msgctxt "InstanceContentTextData:41860:0:0"
msgid "Gaia?"
msgstr "Гайя?"

#. ja: ウオオオオ！
#. de: Uaaargh!
#. fr: Raaaaargh<nbsp>!!!
msgctxt "InstanceContentTextData:41861:0:0"
msgid "Raaaaaargggh!"
msgstr "А-а-а-а-а!"

#. ja: さあ、はじめようじゃないか。
#. de: Auf in den alles entscheidenden Kampf!
#. fr: Allez, l'heurrre du duel a sonné.
msgctxt "InstanceContentTextData:41900:0:0"
msgid "Let's begin, shall we?"
msgstr "Ну что, начнём?"

#. ja: クルーザー級王者「ハウリングブレード」の登場です！
#. de: Der Titelverteidiger im Schwergewicht macht seinen Auftritt!
#. fr: Vous l'attendiez tous, notre champion<nbsp>: Howling Blade<nbsp>!
msgctxt "InstanceContentTextData:41901:0:0"
msgid "Can the challenger defeat the wolf in his own lair!?"
msgstr "Сможет ли претендент одолеть волка в его же логове?!"

#. ja: この技についてこれるかい？
#. de: Bei euch muss ich mich nicht zurückhalten, oder?
#. fr: Arriveras-tu à me suivrrre<nbsp>?
msgctxt "InstanceContentTextData:41902:0:0"
msgid "I wonder if you can keep up..."
msgstr "Интересно, успеешь за мной...?"

#. ja: なんとォ～！<br>あまりの速さに残像が見えている！？
#. de: Man kann seinen Bewegungen kaum folgen!
#. fr: Incroyable<nbsp>! Il est tellement rapide qu'il laisse des doubles derrière lui<nbsp>!
msgctxt "InstanceContentTextData:41903:0:0"
msgid "Such speed─it's as if there's a pack of him!"
msgstr "Вот это скорость! Будто целая стая волков!"

#. ja: キミに、これが見破れるかな？
#. de: Könnt ihr den Überblick behalten?
#. fr: Pourras-tu prrrévoir ce coup<nbsp>?
msgctxt "InstanceContentTextData:41904:0:0"
msgid "Can you fend off a pack of wolves?"
msgstr "Сможешь отбиться от целой стаи?"

#. ja: ちょっと翻弄してやろう。
#. de: Etwas Spaß könnt ihr mir verzeihen, ja?
#. fr: Jouons un peu ensemble.
msgctxt "InstanceContentTextData:41905:0:0"
msgid "I do like toying with my prey."
msgstr "Обожаю поиграть с добычей."

#. ja: フェンリルの力で、<br>面白いものを見せてあげるよ！
#. de: Seht, wozu Fenrirs Seele fähig ist!
#. fr: Je vais te faire découvrirrr le pouvoir de Fenrir<nbsp>!
msgctxt "InstanceContentTextData:41906:0:0"
msgid "Fenrir's power can be wielded in surprising ways."
msgstr "Силу Фенрира можно применить самым неожиданным образом."

#. ja: お～っと！<br>巨大な像が現れた～！
#. de: Ooh! Er hat riesige Statuen erschaffen!
#. fr: Oh là là là<nbsp>! Des statues géantes ont fait leur apparition<nbsp>!
msgctxt "InstanceContentTextData:41907:0:0"
msgid "Where did that colossal thing come from!?"
msgstr "Откуда взялась эта громадина?!"

#. ja: 巨大な像が切り倒されてしまったァ～！
#. de: Einfach filetiert! Das ist unser Stolzer Wolf!
#. fr: Les statues n'ont pas résistés aux assauts<nbsp>!
msgctxt "InstanceContentTextData:41908:0:0"
msgid "He's put the colossus to the sword!"
msgstr "Он сразил колосса!"

#. ja: さすがだね……。<br>でも、これを耐えることができるかな？
#. de: Nicht schlecht<nbsp>... Aber wie sieht es hiermit aus?
#. fr: Intéressant... Mais pourras-tu rrrésister à la suite<nbsp>?
msgctxt "InstanceContentTextData:41909:0:0"
msgid "Not bad, not bad. But we've scarcely begun."
msgstr "Неплохо, неплохо. Но это только начало."

#. ja: さあ、その身に受け止めてみろ！
#. de: Mal sehen, ob ihr das überstehen könnt!
#. fr: Allez<nbsp>! Encaisse ça pour voirrr<nbsp>!
msgctxt "InstanceContentTextData:41910:0:0"
msgid "Bear my biting winds!"
msgstr "Ну-ка, выдержи мой ледяной ветер!"

#. ja: 驚いたよ、まだ闘えるなんてね。<br>フフフ、楽しくなってきた！
#. de: Ich gebe zu, das überrascht mich. Hehe, so langsam wird die Sache interessant!
#. fr: Je ne pensais pas que tu tiendrrrais aussi longtemps. Ha ha<nbsp>! Voilà qui devient amusant<nbsp>!
msgctxt "InstanceContentTextData:41911:0:0"
msgid "Still you stand... How delightful!"
msgstr "И всё ещё стоишь... Вот это славно!"

#. ja: フェンリルの力で、嵐を巻き起こす！
#. de: Selbst Stürme unterwerfen sich Fenrirs Macht!
#. fr: La puissance de Fenrir va s'abattrrre sur toi<nbsp>!
msgctxt "InstanceContentTextData:41912:0:0"
msgid "With Fenrir's might, I rouse a storm!"
msgstr "Силой Фенрира я подниму бурю!"

#. ja: もう終わらせよう！<br>この試合、ボクの勝ちだ！
#. de: Das war's dann. Der Sieg gehört mir!
#. fr: Finissons-en<nbsp>! La victoirrre m'appartient<nbsp>!
msgctxt "InstanceContentTextData:41913:0:0"
msgid "This has gone on long enough. Victory is mine!"
msgstr "Хватит тянуть. Победа будет за мной!"

#. ja: クッ……ボクは負けられない！<br>もっと力を……！
#. de: Urgh<nbsp>... Ich werde nicht aufgeben<nbsp>...!
#. fr: Ugh... Je ne peux pas perdrrre... Il me faut plus de puissance<nbsp>!
msgctxt "InstanceContentTextData:41914:0:0"
msgid "No, I will not lose... I need more power!"
msgstr "Нет, я не проиграю... Мне нужно больше силы!"

#. ja: フェンリルの力をすべて取り込む！
#. de: Fenrir, gib mir auch den Rest deiner Kraft!
#. fr: J'absorberai toute l'énerrrgie de Fenrir<nbsp>!
msgctxt "InstanceContentTextData:41915:0:0"
msgid "Fenrir's unbound might!"
msgstr "Безудержная мощь Фенрира!"

#. ja: この身体がどうなろうとも……<br>オレに敗北は許されないんだ！
#. de: Was mit mir auch geschieht<nbsp>... ich darf hier nicht verlieren!
#. fr: Je refuse de perdre<nbsp>! Peu importe le prrrix à payer...
msgctxt "InstanceContentTextData:41916:0:0"
msgid "No matter what becomes of my body...defeat is not an option!"
msgstr "Что бы ни стало с моим телом... я не имею права проиграть!"

#. ja: 様子がおかしいぞ！<br>いったい、何をする気でしょうか……！？
#. de: Da stimmt was nicht! Was hat Heulende Klinge nur vor<nbsp>...?!
#. fr: Tiens, c'est étrange... Qu'est-ce qu'il nous mijote<nbsp>?
msgctxt "InstanceContentTextData:41917:0:0"
msgid "Something's amiss... What does he intend to do!?"
msgstr "Что-то не так... Что он задумал?!"

#. ja: なんと！<br>リングが破壊され  下の階に落ちてしまったァ～！
#. de: Da geht der Ring zu Bruch! Der Kampf verlagert sich nach unten!
#. fr: Stupéfiant<nbsp>! Howling Blade a détruit le ring<nbsp>! Le combat continue à l'étage du dessous<nbsp>!
msgctxt "InstanceContentTextData:41918:0:0"
msgid "Egads! The ring's been destroyed, and they've fallen below!"
msgstr "Боже мой! Ринг разрушен, и они рухнули этажом ниже!"

#. ja: ここは、浮島デスマッチのリングだ！<br>限られた足場でどう戦うか！？
#. de: Schwebende Inseln<nbsp>...! Haben sie hier überhaupt genug Platz?!
#. fr: Les îles flottantes de la mort<nbsp>! Attention où vous mettez les pieds<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:41919:0:0"
msgid "They've moved to floating deathtraps!<br>How will they fight with so little room?"
msgstr "Они перебрались на парящие острова-ловушки!<br>Как они будут драться на такой тесной площадке?"

#. ja: これからが本当の闘いだ！<br>いくぞッ……！
#. de: Schluss mit lustig. Macht euch bereit!
#. fr: Le véritable combat commence maintenant<nbsp>! En garrrde<nbsp>!
msgctxt "InstanceContentTextData:41920:0:0"
msgid "Now I fight with everything I have! Prepare yourself!"
msgstr "Теперь я сражаюсь всерьёз! Приготовься!"

#. ja: すべて薙ぎ払う！
#. de: Alles wird niedergemäht!
#. fr: Je vais tout rrréduire à néant<nbsp>!
msgctxt "InstanceContentTextData:41921:0:0"
msgid "I will rend all asunder!"
msgstr "Я смету всё на своём пути!"

#. ja: 足場ごと叩き斬る！
#. de: Diese Insel ist im Weg!
#. fr: Tu disparaîtrrras avec cette arène<nbsp>!
msgctxt "InstanceContentTextData:41922:0:0"
msgid "You'll have nowhere to stand!"
msgstr "Тебе негде будет укрыться!"

#. ja: 浮島が壊れたァ！<br>修復されるまでしばらくかかります！
#. de: Er hat eine Insel zerschmettert! Wir setzen uns sofort an die Reparatur!
#. fr: Une île a été détruite<nbsp>! Nous allons réparer ça au plus vite<nbsp>!
msgctxt "InstanceContentTextData:41923:0:0"
msgid "He's destroyed an isle! It'll take time to restore it!"
msgstr "Он разрушил остров! На восстановление уйдёт время!"

#. ja: 風の力を暴走させる！<br>「双牙暴風撃」！
#. de: Nichts hält der ent<shy>fessel<shy>ten Macht des Windes stand!
#. fr: Que les vents se déchaînent<nbsp>! À moi, tempête de crrrocs<nbsp>!
msgctxt "InstanceContentTextData:41924:0:0"
msgid "The power of wind unleashed!"
msgstr "Сила ветра вырвется на волю!"

#. ja: この技から逃れられるか！？<br>「廻天動地」！
#. de: Vor mir gibt es kein Entkommen!
#. fr: Arriverrras-tu à esquiver ce coup<nbsp>? Secousse cosmique<nbsp>!
msgctxt "InstanceContentTextData:41925:0:0"
msgid "You cannot escape from the wolf!"
msgstr "От волка не сбежишь!"

#. ja: すべてを出し切って、必ずお前を倒す！
#. de: Mit all meiner Kraft<nbsp>... werde ich euch besiegen!
#. fr: Je suis prêt à tout donner pour te battrrre<nbsp>!
msgctxt "InstanceContentTextData:41926:0:0"
msgid "I will draw upon my all to defeat you!"
msgstr "Я отдам все силы, чтобы победить тебя!"

#. ja: 命、尽きようとも……オレは……！
#. de: Selbst wenn<nbsp>... es mich mein Leben kostet<nbsp>...!
#. fr: Même si je dois y laisser la vie... Je...
msgctxt "InstanceContentTextData:41927:0:0"
msgid "Even if it costs me my life..."
msgstr "Даже если это будет стоить мне жизни..."

#. ja: 死力を尽くした闘いです！<br>どちらに軍配が上がるのかァ～？
#. de: Ein verzweifelter Kampf auf beiden Seiten! Wen verlassen die Kräfte zuerst?!
#. fr: Ce combat prend des proportions épiques<nbsp>! Qui va réussir à l'emporter<nbsp>?
msgctxt "InstanceContentTextData:41928:0:0"
msgid "Neither side is holding back, but there can be only one champion!"
msgstr "Ни один не сдерживается, но чемпионом станет только один!"

#. ja: 絶対に……負けは……しない！
#. de: Eine Niederlage<nbsp>... kann ich<nbsp>... nicht akzeptieren!
#. fr: Pas... question... de perrrdre<nbsp>!
msgctxt "InstanceContentTextData:41929:0:0"
msgid "I will prevail!"
msgstr "Я одержу победу!"

#. ja: 認めよう……お前は強い……。<br>だが……勝つのはオレだ！
#. de: Ihr seid wirklich stark<nbsp>...! Aber gewinnen<nbsp>... Werde <i>iiiich</i>!
#. fr: Ta forrrce dépasse toutes mes attentes. Mais j'emporterai la victoire<nbsp>!
msgctxt "InstanceContentTextData:41930:0:0"
msgid "You're strong, I admit... But I'm the one who will win!"
msgstr "Признаю, ты силён... Но победителем буду я!"

#. ja: 見切れるものなら、やってみろ！
#. de: Weicht ruhig aus, wenn ihr könnt!
#. fr: Prrrouve-moi que tu peux esquiver mes coups<nbsp>!
msgctxt "InstanceContentTextData:41931:0:0"
msgid "Dodge this if you can!"
msgstr "Ну-ка, увернись, если сможешь!"

#. ja: この技を喰らって、立ってられるか！？
#. de: Ob ihr euch hiernach noch bewegen könnt?
#. fr: Arriveras-tu à te rrrelever après avoir encaissé ça<nbsp>?
msgctxt "InstanceContentTextData:41932:0:0"
msgid "Will you be able to stay on your feet?"
msgstr "Устоишь после такого удара?"

#. ja: ハウリングブレードの撃破
#. de: Heulende Klinge bezwingen
#. fr: Vaincre Howling Blade
msgctxt "InstanceContentTextData:41933:0:0"
msgid "Defeat the Howling Blade"
msgstr "Победите Ревущего клинка"

#. ja: ウオオオオオオッ！
#. de: Huooaah!
#. fr: Grrraaaaaah<nbsp>!
msgctxt "InstanceContentTextData:41934:0:0"
msgid "Aaarrrgh!"
msgstr "А-а-а-а-а-аргх!"

#. ja: いくぞッ！
#. de: Huah!
#. fr: C'est parrrti<nbsp>!
msgctxt "InstanceContentTextData:41935:0:0"
msgid "Have at you!"
msgstr "Ну, держись!"
