# InstanceContentTextData
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 獲得した輝く袋
#. de: Schimmernde Säcke gesammelt
#. fr: Sacs brillants ramassés
msgctxt "InstanceContentTextData:43000:0:0"
msgid "Shining sacks collected"
msgstr "Сияющие мешки собраны"

#. ja: クワン洞の踏破
#. de: Quans Höhle erobern
#. fr: Franchir la grotte de Kwane
msgctxt "InstanceContentTextData:43100:0:0"
msgid "Traverse Quan Caverns"
msgstr "Пройти пещеры Куана"

#. ja: トレノ・カトブレパスの撃破
#. de: Die Treno-Catblepus besiegen
#. fr: Vaincre le catoblépas de Tréno
msgctxt "InstanceContentTextData:43101:0:0"
msgid "Defeat the Treno catoblepas"
msgstr "Победить трено-катоблепаса"

#. ja: トレノ平野の踏破
#. de: Die Treno-Ebene durchqueren
#. fr: Franchir la plaine de Tréno
msgctxt "InstanceContentTextData:43102:0:0"
msgid "Traverse the Treno lowlands"
msgstr "Пройти низины Трено"

#. ja: アムドゥシアスの撃破
#. de: Amdusias besiegen
#. fr: Vaincre Amdusias
msgctxt "InstanceContentTextData:43103:0:0"
msgid "Defeat Amdusias"
msgstr "Победить Амдусиаса"

#. ja: トレノ市街地の踏破
#. de: Treno-Stadt zurückerobern
#. fr: Franchir le centre-ville de Tréno
msgctxt "InstanceContentTextData:43104:0:0"
msgid "Traverse the streets of Treno"
msgstr "Пройти улицы Трено"

#. ja: サンダーグリフォンの撃破
#. de: Den Donnergreif unschädlich machen
#. fr: Vaincre le griffon de foudre
msgctxt "InstanceContentTextData:43105:0:0"
msgid "Defeat the thundergust griffin"
msgstr "Победить громового грифона"

#. ja: まったく、次から次へと……！<br>俺たちの街を、魔物から守り抜くぞ！
#. de: Das nimmt ja gar kein Ende! Aber unsere Stadt überlassen wir den Biestern nicht!
#. fr: Nom d'une buse, ils arrivent de tous les côtés... mais nous protégerons notre cité bien-aimée jusqu'au bout<nbsp>!
msgctxt "InstanceContentTextData:43106:0:0"
msgid "No matter how many come, we fight hand in hand! Forevermore!"
msgstr "Сколько бы их ни было, мы будем держаться вместе! Защитим город до конца!"

#. ja: 君たち、旅人さんか！？<br>みんな街の奥へ避難してるから、そこを目指すといい！
#. de: Seid ihr Reisende?! Geht Richtung Stadtzentrum, dort suchen wir Schutz!
#. fr: Q-qui êtes-vous<nbsp>!? Des voyageurs<nbsp>? Peu importe, on a pas le temps de discuter<nbsp>! Essayez de secourir la population réfugiée à l'hôtel de ville<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:43107:0:0"
msgid "君たち、旅人さんか！？<br>みんな街の奥へ避難してるから、そこを目指すといい！"
msgstr "Эй, вы путешественники?! Все укрылись в глубине города. Вам туда!"

#. ja: 葬送をお望みかしら？<br>いいわ、私が眠りの御使いよ。
#. de: Hast du gerufen, mein Bäumlein?<br>Was dich bedroht, soll meinen Zorn spüren!
#. fr: Un enterrement en prévision<nbsp>? Très bien, je me ferai l'ange du sommeil<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:43300:0:0"
msgid "You called, my sapling?<br>May all who threaten you know my wrath!"
msgstr "Ты звал, росточек мой?<br>Пусть каждый, кто тебе угрожает, познает мой гнев!"

#. ja: そいつの相手は任せたぜ、お客人……！
#. de: Ich verlass' mich voll und ganz auf dich!
#. fr: À vous de jouer, chers invités<nbsp>!
msgctxt "InstanceContentTextData:43400:0:0"
msgid "We're in it now... I'm counting on you!"
msgstr "Теперь уж не отвертеться... Полагаюсь на вас!"

#. ja: ああっ、車両をふっ飛ばしやがった！！
#. de: Er hat den ganzen Waggon von den Gleisen gerammt?!
#. fr: Aaah<nbsp>! Il a fait sauter un wagon<nbsp>!
msgctxt "InstanceContentTextData:43401:0:0"
msgid "Waugh, the flatcar!"
msgstr "Ой, вагонетка!"

#. ja: うわ、タレット！？<br>使えるもんで凌いでくれ！
#. de: Sind das Kanonen?! Bring dich in Sicherheit!
#. fr: Oh non, des tourelles<nbsp>!? Je compte sur vous<nbsp>!
msgctxt "InstanceContentTextData:43402:0:0"
msgid "Turrets!? Uh...good luck!"
msgstr "Турели!? Э-э... удачи!"

#. ja: また車両が……お客人、大丈夫か！？
#. de: Noch ein Waggon weniger<nbsp>...! Stehst du noch?!
#. fr: Un autre wagon en moins... Rien de cassé<nbsp>?
msgctxt "InstanceContentTextData:43403:0:0"
msgid "Not again... You all right back there?"
msgstr "Опять... Вы там целы?"

#. ja: 昇降用の装置があるから、移動に使ってくれ！
#. de: Mit der Vorrichtung da kannst du hochspringen!
#. fr: Utilisez les plateformes pour vous déplacer<nbsp>!
msgctxt "InstanceContentTextData:43404:0:0"
msgid "Use the transport panels to get up there!"
msgstr "Вон там подъёмники, воспользуйтесь ими!"

#. ja: 何度も何度も、やってくれるぜ……！
#. de: Jetzt reicht's aber langsam mal!
#. fr: Mais il va en détruire combien comme ça<nbsp>!?
msgctxt "InstanceContentTextData:43405:0:0"
msgid "How many times is it going to do that!?"
msgstr "Да сколько можно!"

#. ja: あれっ、お客人いるよな！？<br>平気か！？
#. de: H-He, geht's dir gut?! Hallo?!
#. fr: Ça va<nbsp>? Vous tenez le coup<nbsp>?
msgctxt "InstanceContentTextData:43406:0:0"
msgid "What in the─ You're still on board, right!?"
msgstr "Да что ж... Вы ещё там, правда?!"

#. ja: 何だあれ……エーテルの、腕！？
#. de: Sind das<nbsp>... Arme aus Äther?!
#. fr: Qu'est-ce que... Des bras d'éther<nbsp>!?
msgctxt "InstanceContentTextData:43407:0:0"
msgid "Aetherial...arms...?"
msgstr "Это... руки из эфира?"

#. ja: マズい！<br>車両を切り離すから、次のに飛び移れ！
#. de: Uwah! Schnell, spring zum nächsten Waggon!
#. fr: Il faut abandonner ce wagon<nbsp>! Sautez vite sur le suivant<nbsp>!
msgctxt "InstanceContentTextData:43408:0:0"
msgid "I have to disconnect the car. Quick, jump on the next one!"
msgstr "Чёрт! Отцеплю вагон, прыгайте на следующий!"

#. ja: くっそーっ、無茶苦茶しやがって！
#. de: Der hat sie doch nicht mehr alle!
#. fr: Meeerde, il est vraiment pas content<nbsp>!
msgctxt "InstanceContentTextData:43409:0:0"
msgid "Thunderous heavens!"
msgstr "Да чтоб тебя, совсем разбушевался!"

#. ja: だああっ、またやられた！
#. de: Verdammt, nicht schon wieder!
#. fr: Aaah<nbsp>! Il nous en veut, ça c'est sûr<nbsp>!
msgctxt "InstanceContentTextData:43410:0:0"
msgid "Stop doing that!"
msgstr "Ну хватит уже!"

#. ja: お客人、来るぞ！
#. de: Vorsicht, mach dich bereit!
#. fr: Attention, ça risque de faire mal<nbsp>!
msgctxt "InstanceContentTextData:43411:0:0"
msgid "Look out!"
msgstr "Берегись!"

#. ja: やばい、やばい……もうあとがないぞ！
#. de: M-Mehr Waggons hat unser Zug nicht!
#. fr: Plus nulle part où fuir... C'est chaud là<nbsp>!
msgctxt "InstanceContentTextData:43412:0:0"
msgid "We're running out of train!"
msgstr "Поезд кончается!"

#. ja: このままじゃ、マズいぜ！？
#. de: Das sieht überhaupt nicht gut aus!
#. fr: Tout ça va mal finir<nbsp>!!
msgctxt "InstanceContentTextData:43413:0:0"
msgid "Pretty sure this is bad!"
msgstr "Кажется, дело дрянь!"

#. ja: こいつ、しぶとすぎだろ！
#. de: Wie viel hält dieses Ding denn noch aus?!
#. fr: Il lâche jamais l'affaire ou quoi<nbsp>!?
msgctxt "InstanceContentTextData:43414:0:0"
msgid "Hit it harder!"
msgstr "Да бейте сильнее!"

#. ja: ヴァンプ・ファタールの撃破
#. de: Vamp Fatale besiegen
#. fr: Vaincre Vamp Fatale
msgctxt "InstanceContentTextData:43500:0:0"
msgid "Defeat Vamp Fatale"
msgstr "Победить Вамп Фаталь"

#. ja: ウフフ、アナタはどんな声で泣くのかしら？
#. de: \<kicher> Seid ihr bereit, um Gnade zu winseln?
#. fr: Hahaha... J'ai hâte de goûter à tes larmes<nbsp>!
msgctxt "InstanceContentTextData:43501:0:0"
msgid "Hahaha... Will you cry out in pleasure, or pain?"
msgstr "Ха-ха-ха... Ну что, закричишь от наслаждения или от боли?"

#. ja: ヘビー級の初戦は「ヴァンプ・ファタール」！
#. de: Die Kämpfe im Superschwergewicht haben offiziell begonnen!
#. fr: La première combattante de la catégorie poids lourds est Vamp Fatale<nbsp>!
msgctxt "InstanceContentTextData:43502:0:0"
msgid "Feast your eyes on the lovely─and lethal─Vamp Fatale!"
msgstr "Полюбуйтесь на Вамп Фаталь — красавицу и убийцу!"

#. ja: 挑戦者は処刑人の餌食にされるのかァ～？
#. de: Werden die Herausforderer der Henkerin zum Opfer fallen?
#. fr: Le challenger saura-t-il résister à son charme ravageur<nbsp>?
msgctxt "InstanceContentTextData:43503:0:0"
msgid "Will the challenger fall prey to the cruel mistress?"
msgstr "Неужели наш претендент станет добычей жестокой госпожи?"

#. ja: おいで、しもべたち！
#. de: Zu mir, meine Diener!
#. fr: À moi, mes fidèles serviteurs<nbsp>!
msgctxt "InstanceContentTextData:43504:0:0"
msgid "Come, my pets!"
msgstr "Ко мне, питомцы!"

#. ja: さあ、ショータイムよ。<br>せいぜい、泣き叫んでちょうだい。
#. de: Wir fangen gerade erst an! Ich will euch flehen und jammern hören!
#. fr: Le spectacle va commencer<nbsp>! Tu vas hurler de plaisir, je te le promets.
msgctxt "InstanceContentTextData:43505:0:0"
msgid "This is my show. I will hear you scream."
msgstr "Это моё шоу. Хочу слышать ваши крики!"

#. ja: 出たァ～！<br>凶器が襲いくる「殺戮ショー」の始まりだァ～！
#. de: Die Henkerin! Immer bereit, sich ein Blutbad einzulassen!
#. fr: C'est parti<nbsp>! Vamp Fatale entame sa danse macabre<nbsp>!
msgctxt "InstanceContentTextData:43506:0:0"
msgid "A wicked weapon! Vamp Fatale's poised to execute a fatality!"
msgstr "Вот оно! Вамп Фаталь готовится прикончить противника своим смертоносным оружием!"

#. ja: ほらほら、リングのシミになっちゃうわよ？
#. de: Vorsicht, sonst ziert euer Blut gleich den Ring!
#. fr: Bientôt tu ne seras plus qu'une tâche de plus sur mon ring<nbsp>!
msgctxt "InstanceContentTextData:43507:0:0"
msgid "You will become a stain on this ring."
msgstr "Скоро станешь ещё одним пятном на этом ринге."

#. ja: 挑戦者、もうあとがないぞォ～！
#. de: Die Herausforderer wurden in die Enge getrieben!
#. fr: Notre challenger n'a plus aucune échappatoire<nbsp>!
msgctxt "InstanceContentTextData:43508:0:0"
msgid "The challenger has nowhere left to run!"
msgstr "Нашему претенденту некуда бежать!"

#. ja: お愉しみは、これから……<br>会場の下僕たち、エーテルをよこしなさい。
#. de: Euer Warten hat ein Ende<nbsp>...! Seid brave Diener und gebt mir euren Äther!
#. fr: Je commence à peine à m'amuser... Allez, mes chéris, donnez-moi votre éther<nbsp>!
msgctxt "InstanceContentTextData:43509:0:0"
msgid "This is just the beginning. My faithful minions─give me your aether!"
msgstr "Это только начало. Верные слуги, отдайте мне свой эфир!"

#. ja: 「クラウドキリング」！<br>観客のエーテルまで吸い取っているぞォ～！
#. de: Dieser Angriff! Sie entzieht den Zuschauern Äther!
#. fr: Vamp Fatale aspire l'éther de son public en délire<nbsp>!
msgctxt "InstanceContentTextData:43510:0:0"
msgid "It's begun! She's draining the audience─of their aether!"
msgstr "Началось! Она высасывает эфир прямо из зрителей!"

#. ja: これで、みんな呑み込んであげる。
#. de: Gebt euch dem Schmerz hin!
#. fr: Vous allez tous me nourrir<nbsp>!
msgctxt "InstanceContentTextData:43511:0:0"
msgid "All of you will feed me."
msgstr "Я поглощу вас всех."

#. ja: ヴァンプ・ファタールがエーテルを解き放った！<br>もはや独壇場だァ～！
#. de: Vamp Fatale setzt ihren Äther frei! Der Ring ist komplett unter ihrer Kontrolle!
#. fr: Admirez ce déferlement éthéré<nbsp>! Notre vampire asseoit sa domination<nbsp>!
msgctxt "InstanceContentTextData:43512:0:0"
msgid "Vamp Fatale's unleashed the aether! The challenger's in her realm now!"
msgstr "Вамп Фаталь высвободила эфир! Претендент теперь на её территории!"

#. ja: なかなか、しぶといじゃない……<br>許しを請うなら今のうちよ！
#. de: Ihr wollt es also nicht anders<nbsp>... Wer nicht kniet, muss eben fühlen!
#. fr: Tu as la peau dure... Mais je veux bien te pardonner si tu te mets à genoux<nbsp>!
msgctxt "InstanceContentTextData:43513:0:0"
msgid "You are a stubborn one. But it is not too late to beg for mercy!"
msgstr "Ты упрямый... Но ещё не поздно молить о пощаде!"

#. ja: 「殺戮ショー」の再演！<br>無数の凶器の中、挑戦者はどうする～？
#. de: Und zurück in die Folterkammer! Können die Herausforderer erneut entkommen?
#. fr: La danse macabre reprend de plus belle<nbsp>! Le challenger saura-t-il y échapper<nbsp>?
msgctxt "InstanceContentTextData:43514:0:0"
msgid "The spectacle of slaughter resumes! How will the challenger adapt?"
msgstr "Кровавое шоу продолжается! Как теперь выкрутится претендент?"

#. ja: 阿鼻叫喚の中、さらなる凶器が降り注ぐ～！
#. de: Aus welchen Höllen stammen nur all diese Waffen?
#. fr: Vamp Fatale lance une véritable pluie mortelle<nbsp>!
msgctxt "InstanceContentTextData:43515:0:0"
msgid "It's a veritable rain of death!"
msgstr "Настоящий дождь смерти!"

#. ja: ああもう、小賢しい……<br>よこしなさい……もっと、もっとよ！
#. de: Bildet euch ja nichts ein ...! Mehr...! Mehr Äther!
#. fr: Quelle insolence<nbsp>! Il me faut plus d'éther<nbsp>!
msgctxt "InstanceContentTextData:43516:0:0"
msgid "Such insolence I have never known! More─I need more aether!"
msgstr "Какая дерзость... Ещё! Мне нужно больше эфира!"

#. ja: またも「クラウドキリング」！<br>観客の皆さん、お気分は悪くないですかァ～？
#. de: Sie saugt dem Publikum wieder Äther ab! Sind die Zuschauer noch bei Bewusstsein?
#. fr: Vamp Fatale suce à nouveau l'éther des spectateurs<nbsp>! J'espère que vous tenez le coup dans les gradins<nbsp>!
msgctxt "InstanceContentTextData:43517:0:0"
msgid "She's draining the crowd's aether again! I hope our dear spectators are feeling alright..."
msgstr "Она опять высасывает эфир из зрителей! Надеюсь, наши дорогие зрители там в порядке..."

#. ja: とことん、痛めつけてあげるわ！
#. de: Niemand kann diesem Schmerz widerstehen!
#. fr: Je vais te faire découvrir le paroxysme de la souffrance<nbsp>!
msgctxt "InstanceContentTextData:43518:0:0"
msgid "In pain lies pleasure!"
msgstr "Я заставлю тебя страдать до последнего!"

#. ja: 大量のエーテルを解き放ったぞ！<br>いったい、どうなってしまうんだァ～？
#. de: Diese Menge ist unglaublich! Was hat sie damit nur vor?
#. fr: C'est un nouveau déluge d'éther<nbsp>? Comment y échapper cette fois<nbsp>?
msgctxt "InstanceContentTextData:43519:0:0"
msgid "She's unleashed even more aether! How will this end!?"
msgstr "Она высвободила ещё больше эфира! Чем же это закончится?!"

#. ja: 絶対に、逃がさないんだから！
#. de: Vor mir gibt es kein Entkommen!
#. fr: Tu ne m'échapperas pas<nbsp>!
msgctxt "InstanceContentTextData:43520:0:0"
msgid "You'll not escape me!"
msgstr "От меня не убежишь!"

#. ja: まだまだ足りない……<br>もっとよ……ありったけよこしなさい！
#. de: Nicht genug ...! Euer ganzer Äther gehört mir, bis auf den letzten Tropfen!
#. fr: Encore... Il m'en faut toujours plus<nbsp>! Donnez-moi tout votre éther<nbsp>!
msgctxt "InstanceContentTextData:43521:0:0"
msgid "It's still not enough. I will take everything you have!"
msgstr "Всё ещё мало... Отдайте мне всё, что у вас есть!"

#. ja: またまた「クラウドキリング」！<br>さすがにワタシも……ちょっと気分が……。
#. de: Ihr Hunger nach Äther ist unstillbar! So langsam<nbsp>.... wird mir auch schummerig<nbsp>...
#. fr: Vamp Fatale s'abreuve encore une fois d'éther... et votre serviteur... commence à avoir le vertige...
msgctxt "InstanceContentTextData:43522:0:0"
msgid "The seductress is at it again! I...I'm feeling a little lightheaded..."
msgstr "Опять за своё! Я... у меня уже голова кружится..."

#. ja: もう……謝っても……許さないわ……！
#. de: Ihr hattet<nbsp>... eure Chance<nbsp>...!
#. fr: Tu auras beau me supplier... Je n'aurai aucune pitié<nbsp>!
msgctxt "InstanceContentTextData:43523:0:0"
msgid "No mercy!"
msgstr "Пощады не будет!"

#. ja: 挑戦者のエーテルが吸い取られてしまったァ～！
#. de: Jetzt müssen die Herausforderer Äther bluten!
#. fr: Attention<nbsp>! Le challenger se fait siphonner son éther<nbsp>!
msgctxt "InstanceContentTextData:43524:0:0"
msgid "She's siphoned the challenger's aether!"
msgstr "Она высосала эфир из претендента!"

#. ja: いい加減……ひれ伏しなさい……！
#. de: Werft euch endlich<nbsp>... vor mir nieder<nbsp>...!
#. fr: Assez<nbsp>! Tu vas obéir, oui<nbsp>? Prosterne-toi<nbsp>!
msgctxt "InstanceContentTextData:43525:0:0"
msgid "On your knees, damn you!"
msgstr "На колени, проклятье!"

#. ja: ああ、面倒くさい……。<br>アタシの楽園に入ってくるんじゃないよ。
#. de: Was soll das? Wer wagt es, mein Reich zu beschmutzen?
#. fr: Aah, quelle corvée. Qui ose souiller mon domaine<nbsp>?
msgctxt "InstanceContentTextData:43600:0:0"
msgid "\\<sigh> What a chore. Must you soil the floor of my paradise?"
msgstr ""

#. ja: ほら、オマエが働くんだよ、絨毯。
#. de: Mach dich mal nützlich!
#. fr: Au boulot, sale paillasson<nbsp>!
msgctxt "InstanceContentTextData:43601:0:0"
msgid "Put those tattered threads to use!"
msgstr "Поработай хоть на пользу, облезлая тряпка!"

#. ja: しぶといねぇ……。<br>ほ～ら、絨毯、もっと激しくやっちまいな。
#. de: Ganz schön hartnäckig<nbsp>... Los, Teppich, beende dieses Spielchen!
#. fr: Toujours vivants<nbsp>? Mets les bouchées doubles, carpette de pacotille<nbsp>!
msgctxt "InstanceContentTextData:43602:0:0"
msgid "What persistent pests... Come now, you worthless rugs, shake off that dirt and do something!"
msgstr "Какие живучие вредители... Ну же, никчёмные половики, отряхнитесь и займитесь ими!"

#. ja: ああ、もう目障りだ……！<br>全部まとめて焼けちまいな！！
#. de: Das reicht! Meine Geduld ist am Ende<nbsp>... Alles soll brennen!
#. fr: Grrr... J'en ai assez<nbsp>! Tant pis, je vais tout réduire en cendres<nbsp>!
msgctxt "InstanceContentTextData:43603:0:0"
msgid "I've had quite enough of you! I shall like you better set aflame!"
msgstr "С меня хватит! Так и сожгу вас всех дотла!"

#. ja: アタシの前でウロチョロするんじゃないよ！<br>消え失せな！！
#. de: Ihr geht mir langsam ernsthaft auf die Nerven! Geht mir aus den Augen!
#. fr: Hors de ma vue<nbsp>! Allez gesticuler ailleurs<nbsp>!
msgctxt "InstanceContentTextData:43604:0:0"
msgid "Your prancing and capering sickens me! Begone from my sight!"
msgstr "Хватит мельтешить передо мной! С глаз долой!"

#. ja: ……ああ、疲れた。<br>絨毯たち、あとは適当にやっとくれ。
#. de: Ich hab genug. Kümmere dich um den Rest, Teppich.
#. fr: Ah... Je suis exténuée... Occupe-toi du reste, maudit tapis.
msgctxt "InstanceContentTextData:43605:0:0"
msgid "I tire of this. Go on, you frayed mats─smother the life out of them."
msgstr "...Ах, устала. Коврики, дальше сами разберётесь."

#. ja: しつこい鳥だなぁ！<br>ちょーっと食べ物を盗っただけじゃない！
#. de: Was für ein hartnäckiges Vögelchen! Ich habe ihnen doch nur ein bisschen Futter geklaut.
#. fr: Pour un oiseau, c'est une sacrée tête de mule<nbsp>! On lui a juste volé un peu de nourriture<nbsp>!
msgctxt "InstanceContentTextData:43606:0:0"
msgid "Greedy bird! I only stole a few snacks!"
msgstr "Прилипчивая же ты птица! Я всего-то немного еды стащила!"

#. ja: アハハ、おっそ～い！<br>じゃ、まったね～！
#. de: Hahaha, zu langsam! Das war wohl nichts<nbsp>...
#. fr: Ha ha ha<nbsp>! Trop lent<nbsp>! Allez, à la prochaine<nbsp>!
msgctxt "InstanceContentTextData:43607:0:0"
msgid "Hahaha, too slow! That food was delicious, by the way! Until next time!"
msgstr "Ха-ха-ха, не догнали! А еда, кстати, была вкусная! До встречи!"

#. ja: グギャギャ！！<br>ギャギャーーーー！！
#. de: Ungraaahhh! Ungrajaaah!
#. fr: Guhgyagya<nbsp>! Gyagyaaaah<nbsp>!!
msgctxt "InstanceContentTextData:43608:0:0"
msgid "Gyah! Gyaaah!"
msgstr "Гья! Гья-а-а!"

#. ja: さっきはよくも邪魔してくれたなぁ！<br>みんな、やっちゃえー！！
#. de: Zeit, dass ihr für eure Taten bezahlt! Angriff!
#. fr: Il est temps de payer le prix fort pour nous avoir fait obstacle<nbsp>! À l'attaque<nbsp>!
msgctxt "InstanceContentTextData:43609:0:0"
msgid "You got in the way of our fun, and now it's time to pay the price!"
msgstr "Помешали нам повеселиться — теперь за это ответите!"

#. ja: 助けてくれた……？<br>もしかして、さっき雛を助けた恩返しでしょうか……。
#. de: Eine unerwartete Hilfe<nbsp>... Vielleicht ein Dankeschön dafür, dass wir das Futter der Küken beschützt haben?
#. fr: Quelle aide inespérée<nbsp>! C'est sûrement pour nous rrremercier d'avoir sauvé le repas de ses poussins.
msgctxt "InstanceContentTextData:43610:0:0"
msgid "It helped us! Perhaps as a show of thanks for before?"
msgstr "Она нам помогла...? Может, это благодарность за то, что мы спасли её птенцов?"

#. ja: いい加減にしな！<br>もう許しゃしないよ！！
#. de: Meine Geduld ist am Ende<nbsp>- Schluss mit lustig!
#. fr: Ma patience a des limites, et elles ont été dépassées depuis un moment<nbsp>!!
msgctxt "InstanceContentTextData:43611:0:0"
msgid "Stop struggling! You wear my patience dangerously thin!"
msgstr "Хватит сопротивляться! Моё терпение уже на пределе!"

#. ja: チリも残さず、消し飛んじまいな！
#. de: Hier wird gleich alles in Rauch aufgehen!
#. fr: Préparez-vous à partir en fumée<nbsp>!
msgctxt "InstanceContentTextData:43612:0:0"
msgid "You'll soon be a pile of ash!"
msgstr "Скоро от вас останется лишь кучка пепла!"

#. ja: あれは……ドゥンの変異種でしょうか。<br>気が立っているようなので、ご注意ください！
#. de: Ist das<nbsp>... eine Art Chimäre? Sieht jedenfalls ziemlich gefährlich aus, pass bloß auf!
#. fr: On dirait une sorrrte de chimère. Fais attention, elle a l'air féroce<nbsp>!
msgctxt "InstanceContentTextData:43614:0:0"
msgid "Where have I seen this before...? Careful─it appears to be in a foul mood!"
msgstr "Где же я это уже видела?.. Осторожно, она, похоже, в дурном настроении!"

#. ja: えっ、消えた……？<br>今まで、そこに砂の玉がありましたよね！？
#. de: Wo zum<nbsp>...? Da war doch eben noch eine Sandkugel!
#. fr: Ça alors<nbsp>! Le monstre a fait disparrraître un des globes de sable<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:43615:0:0"
msgid "What? It disappeared? There <i>was</i> a ball of sand over there, right?"
msgstr "Что? Исчез? Там же <i>был</i> шар из песка, верно?"

#. ja: 消えたのではなく、見えなくなっただけ……！<br>砂玉があった場所を、覚えておいたほうがよさそうですね。
#. de: Pass auf! Die Kugeln sind nicht verschwunden, sondern nur unsichtbar! Merk dir gut, wo sie lagen!
#. fr: Même s'il est invisible, le danger est toujourrrs présent<nbsp>! Pense à mémoriser la position des globes de sable<nbsp>!
msgctxt "InstanceContentTextData:43616:0:0"
msgid "Wait, the balls are still here, we just can't see them! Remember their position before they turn invisible!"
msgstr "Постойте, шары никуда не делись — просто стали невидимыми! Запомните, где они были, пока их не стало видно!"

#. ja: 姿が見えなくなっただけで、このあたりにいるはずです！<br>周囲をよく見れば、きっと痕跡がわかるかと……！
#. de: Ich hab das ungute Gefühl, dass diese Kreatur noch ganz in der Nähe ist<nbsp>... Sieh dich lieber gut um!
#. fr: Mon petit doigt me dit que la créature est toujours dans le coin... Regarde bien autourrr de toi<nbsp>!
msgctxt "InstanceContentTextData:43617:0:0"
msgid "It must still be here somewhere! Look carefully for traces of its passage!"
msgstr "Он всё ещё где-то здесь! Внимательно ищите следы!"

#. ja: ゼェ、ハァ……おい、テメェ！<br>さっきは、よくもやってくれたな！！
#. de: Da seid ihr ja wieder! Wusste ich es doch<nbsp>...!
#. fr: Hé, j'te reconnais<nbsp>! C'est toi qui nous as mis des bâtons dans les roues<nbsp>!
msgctxt "InstanceContentTextData:43618:0:0"
msgid "\\<cough> \\<wheeze> ...There you are! Reckoned we'd sit back lickin' our wounds, eh?"
msgstr ""

#. ja: オレたちを舐めるなよ！<br>これでもくらえっ！
#. de: Ihr solltet uns lieber nicht unter<shy>schätzen, sonst holt ihr euch einen Satz heiße Ohren!
#. fr: Tu vas apprendre que quand on s'frotte aux durs, on s'fait de gros bobos<nbsp>!
msgctxt "InstanceContentTextData:43619:0:0"
msgid "Time for payback! You'll regret crossin' us!"
msgstr "Пора расплатиться! Ещё пожалеете, что перешли нам дорогу!"

#. ja: お、おい、なんか揺れてねぇか……？<br>ヤベェ、さっさとずらかるぞー！！
#. de: Ist das ein Erdbeben?! Wir sollten schleunigst von hier verschwinden!
#. fr: Hé<nbsp>! C'est moi ou la terre tremble...<nbsp>? Ouah<nbsp>! Il est temps de s'faire la malle<nbsp>!
msgctxt "InstanceContentTextData:43620:0:0"
msgid "Wh-What's that shakin'!? R-Run! This revenge ain't worth dyin' for!"
msgstr "Ч-что это трясётся?! Б-бежим! Не стоит мстить ценой собственной жизни!"

#. ja: ……去っていきましたね。<br>あの手のお騒がせな人たちって、どこにでもいるんだな……。
#. de: Sie haben sich einfach aus dem Staub gemacht. Feiglinge gibt's wohl in jeder Geschichte<nbsp>...
#. fr: Ils sont parrrtis la queue entre les jambes... Peu importe le lieu ou l'époque, on tombe toujours sur ce genre de petites frappes...
msgctxt "InstanceContentTextData:43621:0:0"
msgid "They've run out of eyeshot. I suppose every story needs its petty villains..."
msgstr "Скрылись из виду... Видать, в каждой истории нужны свои мелкие злодеи."

#. ja: オレたちの大事な爆弾を、台無しにしやがって！<br>これでもくらえっ！
#. de: Ihr habt unsere wertvollen Bomben zerstört! Nehmt das!
#. fr: T'as gâché nos belles bombinettes<nbsp>! Mange donc ça, sale charogne<nbsp>!
msgctxt "InstanceContentTextData:43622:0:0"
msgid "We slaved for days to make those bombs! Good thing we've got other ways to make you suffer!"
msgstr "Мы столько дней возились с этими бомбами! Хорошо, что есть и другие способы заставить вас страдать!"

#. ja: ヤベェ、すっからかんになっちまった……！<br>撤収、撤収ー！！
#. de: Verdammt, wir haben alles aufgebraucht! Rückzug, schnell!
#. fr: Oh merde<nbsp>! On a tout utilisé<nbsp>! Fuyez<nbsp>! Euh... Je veux dire... Retraite stratégique<nbsp>!!
msgctxt "InstanceContentTextData:43623:0:0"
msgid "Godsdammit, why didn't you bring more!? Get the hells out of here!"
msgstr "Да чтоб вас! Почему не принесли побольше?! Валим отсюда к чертям!"

#. ja: 種子にも隠蔽魔法を……！<br>見えなくなっただけなので、どうかご注意ください！
#. de: Ihre Magie lässt auch die Samen verschwinden! Aber pass auf, sie sind nur unsichtbar!
#. fr: Sa magie fonctionne aussi sur les grrraines<nbsp>! Fais attention, elles sont encore là<nbsp>!
msgctxt "InstanceContentTextData:43624:0:0"
msgid "It can turn the seeds invisible too!? Remember where they are!"
msgstr "Она может сделать невидимыми и семена!? Запомните, где они лежат!"

#. ja: さあ、歌いましょう、奏でましょう。<br>あなたも一緒に来てくれる？
#. de: Traut euch, kommt ruhig näher! Lasst uns zusammen singen<nbsp>...!
#. fr: L'auditoire est au complet. Joignez-vous à moi<nbsp>! Chantez<nbsp>! Dansez<nbsp>!
msgctxt "InstanceContentTextData:43625:0:0"
msgid "Come, join us. Lend your voice to our chorus!"
msgstr "Ну же, пойте вместе с нами! Подхватите нашу песню!"

#. ja: みんなも一緒に歌いましょう？
#. de: Na, gefällt euch mein Gesang?
#. fr: Appréciez-vous mon chant envoûtant<nbsp>?
msgctxt "InstanceContentTextData:43626:0:0"
msgid "Let our song ring ever louder!"
msgstr "Пусть наша песня звучит всё громче!"

#. ja: また仲間を呼ぶみたいです！<br>彼女の歌声をよく聴いてみてください！
#. de: Sie scheint Verstärkung zu rufen! Hör dir die Melodie genau an<nbsp>...
#. fr: Elle va encorrre appeler des renforts<nbsp>! Écoute bien sa mélodie<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:43627:0:0"
msgid "More minions! Listen to her voice carefully, <split \" \" 1><string $gs1></split>!"
msgstr "Ещё прислужники! Внимательно слушай её голос, <split \" \" 1><string $gs1></split>!"

#. ja: さっきとは別の魔物が現れました……！<br>どんな攻撃がくるのか警戒してください！
#. de: Noch mehr Gegner! Pass besser gut auf!
#. fr: De nouveaux monstres<nbsp>! Obserrrve-les bien, on ne sait pas de quoi ils sont capables<nbsp>!
msgctxt "InstanceContentTextData:43628:0:0"
msgid "These creatures are different than before... Be wary of their attacks!"
msgstr "Эти твари уже другие... Будьте готовы к их атакам!"

#. ja: 集まってきた魔物たちは、歌声に導かれているようです。<br>ご注意ください！
#. de: Sie scheinen auf ihren Gesang zu reagieren! Bleib wachsam!
#. fr: Les monstres semblent réagir à son chant<nbsp>! Ne rrrelâche pas ta vigilance<nbsp>!
msgctxt "InstanceContentTextData:43630:0:0"
msgid "They're being guided by her singing. Watch your back!"
msgstr "Похоже, её пение ведёт их за собой. Берегитесь!"

#. ja: 舞いましょう、胸の高鳴りが導くままに……。
#. de: Los, tanzt mit mir! Lasst euch von meiner Melodie leiten!
#. fr: Dansez au gré de ma mélodie<nbsp>!
msgctxt "InstanceContentTextData:43631:0:0"
msgid "Dance with me. Let the beat of our hearts guide our steps."
msgstr "Танцуй со мной. Пусть наши сердца задают ритм."

#. ja: またあの泳ぎ……！<br>彼女の通った場所に、どうかご用心を！
#. de: Sie schwimmt wieder! Pass auf, dass du nicht in ihren Bann gezogen wirst!
#. fr: Elle nage de nouveau<nbsp>! Attention, son sillage est semé d'embûches<nbsp>!
msgctxt "InstanceContentTextData:43632:0:0"
msgid "She's swimming around again. Don't get caught in her wake!"
msgstr "Она снова плывёт! Не попадите в её след!"

#. ja: 捧げましょう、溢れる想いを願いに変えて……。
#. de: Geben wir uns dem Meer hin! Auf dass all unsere Hoffnungen und Wünsche wahr werden<nbsp>...
#. fr: Joignez-vous à nous avec une joie débordante...
msgctxt "InstanceContentTextData:43633:0:0"
msgid "Now we offer ourselves to the sea. Hope overflowing coalesces into a wish come true..."
msgstr "Теперь мы отдаём себя морю. Переполняющая нас надежда станет исполненным желанием..."

#. ja: 水球の変化に気をつけてください！
#. de: Die Wasserkugeln verändern sich, pass auf!
#. fr: Les globes d'eau ont changé<nbsp>! Prrrépare-toi au pire<nbsp>!
msgctxt "InstanceContentTextData:43634:0:0"
msgid "The orbs are changing─keep an eye on them!"
msgstr "Следите за шарами: они меняются!"

#. ja: 祈りましょう、願いが天に届くまで……。
#. de: Mögen unsere Gebete erhört werden<nbsp>...!
#. fr: Que notre oraison fervente atteigne les cieux...
msgctxt "InstanceContentTextData:43635:0:0"
msgid "Let us shout our prayers to the heavens, and they may be answered."
msgstr "Вознесём молитвы к небесам — вдруг они будут услышаны."

#. ja: 足元にご注意ください！<br>まだ強いエーテルが残っています！
#. de: Pass auf, wo du hintrittst! Da ist überall Äther<nbsp>...
#. fr: Elle prépare quelque chose<nbsp>! Il reste une grrrande quantité d'éther à tes pieds<nbsp>!
msgctxt "InstanceContentTextData:43636:0:0"
msgid "Watch your step! Dense aether yet lingers!"
msgstr "Смотрите под ноги! Здесь всё ещё полно эфира!"

#. ja: 導きましょう、運命が示すとおりに……。
#. de: Lasst euch von meiner Stimme in euer Schicksal geleiten<nbsp>...
#. fr: Laissez ma voix vous guider vers votre destin...
msgctxt "InstanceContentTextData:43637:0:0"
msgid "You can but walk the path fate sets before you."
msgstr "Остаётся лишь идти по пути, что уготовила судьба."

#. ja: 委ねましょう、すべてを包む大いなる流れに……。
#. de: Lasst euch von der Strömung mitreißen<nbsp>...
#. fr: Abandonnez-vous aux courants implacables de l'océan...
msgctxt "InstanceContentTextData:43638:0:0"
msgid "Surrender yourself to the ocean's embrace."
msgstr "Отдайтесь объятиям океана."

#. ja: 大波が来ます！<br>水の変化をお見逃しなきよう……！
#. de: Eine gigantische Welle rollt an! Pass auf, dass du nicht von den Strömungen des Wassers überrascht wirst!
#. fr: C'est un véritable raz-de-marée<nbsp>! Ne te laisse pas surprendrrre par les mouvements de l'eau<nbsp>!
msgctxt "InstanceContentTextData:43639:0:0"
msgid "Here comes the wave again! Watch the water carefully!"
msgstr "Вновь надвигается волна! Следите за водой!"

#. ja: 刻みましょう、小さき想いの重なりを……。
#. de: Wie schwer die vielen Wünsche doch wiegen<nbsp>...
#. fr: Que l'accumulation de nos souhaits vous engloutisse...
msgctxt "InstanceContentTextData:43640:0:0"
msgid "Be buried under the weight of countless unanswered wishes..."
msgstr "Пусть вас погребёт под тяжестью бесчисленных несбывшихся желаний..."

#. ja: 感じましょう、縁が泡沫に消えゆく前に……。
#. de: Schätzt, was uns verbindet, bevor sich alles in Luft auflöst<nbsp>...
#. fr: Appréciez les liens qui vous unissent avant qu'ils soient dissous...
msgctxt "InstanceContentTextData:43641:0:0"
msgid "Let us treasure this bond, ere it vanishes like so much foam upon the tide..."
msgstr "Давайте беречь нашу связь, пока она не исчезла, словно пена на волнах..."

#. ja: 奏でましょう、祈りが届くまで幾度でも……。
#. de: Lasst uns weitersingen, bis unsere Wünsche erhört werden<nbsp>...
#. fr: Chantons sans relâche, jusqu'à ce que nos vœux soient exaucés...
msgctxt "InstanceContentTextData:43642:0:0"
msgid "Our revel shall not end until our prayers are answered."
msgstr "Наше веселье не кончится, пока молитвы не будут услышаны."

#. ja: どうかこの声を聞いて。<br>ただ、一緒に来てほしいだけなの……。
#. de: Bitte hört mir zu! Ich will doch nur, dass ihr mit mir kommt<nbsp>...
#. fr: Je vous en prie, écoutez-moi. Je souhaite seulement vous guider...
msgctxt "InstanceContentTextData:43643:0:0"
msgid "Do my words not reach you? I ask only that you stay by my side..."
msgstr "Неужели вы меня не слышите? Я прошу лишь об одном — останьтесь со мной..."

#. ja: さあ、共に行きましょう？<br>昏く深い、海の底へ……！
#. de: Folgt mir in die Tiefen des Meeres, bis zum Grund des Ozeans<nbsp>...!
#. fr: Mettons-nous en route, voulez-vous<nbsp>? Suivez-moi dans les abysses... Jusqu'au fin fond des océans<nbsp>!
msgctxt "InstanceContentTextData:43644:0:0"
msgid "Now, shall we depart? Into the black, inky depths!"
msgstr "Ну что, отправимся? В чёрные, непроглядные глубины!"

#. ja: 商客物語の踏破
#. de: „Des Händlers Liebesmüh“ lesen
#. fr: Lire les Contes du Camelot
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:43646:0:0"
msgid "Clear <i>The Merchant's Tale</i>"
msgstr "Пройти <i>«Повесть о купце»</i>"

#. ja: 商客物語の踏破
#. de: „Des Händlers Liebesmüh“ lesen
#. fr: Lire les Contes du Camelot
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:43647:0:0"
msgid "Clear <i>The Merchant's Tale</i>"
msgstr "Пройти <i>«Повесть о купце»</i>"

#. ja: 火精ペリの撃破
#. de: Die Sengende Pari bezwingen
#. fr: Vaincre Pari
msgctxt "InstanceContentTextData:43648:0:0"
msgid "Defeat the Pari of Plenty"
msgstr "Победить Пери изобилия"

#. ja: 人魚ダリヤの撃破
#. de: Meerjungfrau Darya bezwingen
#. fr: Vaincre Darya
msgctxt "InstanceContentTextData:43649:0:0"
msgid "Defeat Darya the Sea-maid"
msgstr "Победить морскую деву Дарью"

#. ja: ソードマスターの撃破
#. de: Die Meisterin des Schwertes bezwingen
#. fr: Vaincre le maître d'armes
msgctxt "InstanceContentTextData:43650:0:0"
msgid "Defeat the Lone Swordmaster"
msgstr "Победить одинокого мастера меча"

#. ja: 商客物語の踏破
#. de: „Des Händlers Liebesmüh“ lesen
#. fr: Lire les Contes du Camelot
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:43651:0:0"
msgid "Clear <i>The Merchant's Tale</i>"
msgstr "Пройти <i>«Повесть о купце»</i>"

#. ja: <split " " 1><string $gs1></split>さん、見てください！<br>街の人が襲われているようです！
#. de: <split " " 1><string $gs1></split>, schau, da! Die Stadtbewohnerin wird angegriffen!
#. fr: Regarrrde, <split " " 1><string $gs1></split><nbsp>! On dirait qu'il y a de l'agitation en ville<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:43652:0:0"
msgid "<split \" \" 1><string $gs1></split>, look! That woman is under attack!"
msgstr "<split \" \" 1><string $gs1></split>, глянь! На ту женщину напали!"

#. ja: 愛しき友よ
#. de: Ich bin wieder da
#. fr: chère amie
msgctxt "InstanceContentTextData:43653:0:0"
msgid "I am returned!"
msgstr "Я вернулась!"

#. ja: 美しい街並みですが、どこに何があるかさっぱりですね……。<br>住人もいるようですし、宝の情報を集めてみましょうか！
#. de: Was für eine wunderschöne Stadt! So viele kleine Gässchen und unbekannte Wege<nbsp>... Vielleicht haben die Einheimischen ja einen Tipp, wo wir einen Gegenstand von unschätzbarem Wert finden könnten?
#. fr: Quelle ville magnifique<nbsp>! Interrogeons la population, quelqu'un nous mettra peut-être sur la piste d'un trrrésor<nbsp>!
msgctxt "InstanceContentTextData:43654:0:0"
msgid "A beautiful place, to be sure, but sprawling. Perhaps the locals can help us catch the scent of treasure, eh?"
msgstr "Красивое место, спору нет, да только огромное. Может, местные подскажут, где искать сокровища?"

#. ja: ここは、街の中心の広場のようですね。<br>道が分かれていますが、気になる道はありますか？
#. de: So viele Straßen wie hier auf<shy>einander<shy>treffen, muss das wohl das Stadtzentrum sein. In welche Richtung sollen wir gehen?
#. fr: C'est sûrrrement la place centrale, car toutes les artères principales y mènent. Quelle direction prendre<nbsp>?
msgctxt "InstanceContentTextData:43655:0:0"
msgid "This must be the heart of the city. We've many roads to choose from. Do any pique your interest?"
msgstr "Похоже, это самый центр города. Дорог тут полно. Какая-нибудь тебе приглянулась?"

#. ja: あっ、私と一緒ですね！<br>では行ってみましょうか！
#. de: Das hätte ich auch gesagt! Dann lass uns doch direkt aufbrechen.
#. fr: C'était aussi mon prrremier choix<nbsp>! En route alors<nbsp>!
msgctxt "InstanceContentTextData:43656:0:0"
msgid "Ah, I see we think alike! Let us proceed."
msgstr "А, значит, наши мысли сошлись! Тогда идём."

#. ja: あっ、そちらが気になりますか？<br>冒険者ならではの勘を信じて、行きましょう！
#. de: Da entlang, wirklich? Na gut, ich vertraue deinem Abenteurerinstinkt!
#. fr: Tu préfères qu'on aille par là<nbsp>? Trrrès bien, je fais confiance à ton flair d'<if $gn4>aventurière<else>aventurier</if><nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:43657:0:0"
msgid "Oh? <i>That</i> way? Well, I'm not one to gainsay an adventurer's intuition, so lead the way!"
msgstr "О? В <i>ту</i> сторону? Что ж, спорить с чутьём авантюриста я не стану. Веди!"

#. ja: 任せてくださるんですか？<br>では、私も自分の勘を信じて……こっちに行きましょう！
#. de: Du überlässt die Entscheidung mir? Hmm, mein Instinkt sagt<nbsp>... hier entlang!
#. fr: Si tu n'as pas de préférrrence, suivons mon instinct de glaneuse et allons de ce côté<nbsp>!
msgctxt "InstanceContentTextData:43658:0:0"
msgid "You're fine with me making the choice? Well, my gleaner's intuition is pointing me...this way!"
msgstr "Не против, если я выберу? Ну, чутьё собирательницы подсказывает мне... вот туда!"

#. ja: ●最初に訪れたのは“住宅街”……
#. de: ●最初に訪れたのは„住宅街“……
#. fr: ●最初に訪れたのは“住宅街”……
msgctxt "InstanceContentTextData:43659:0:0"
msgid "●最初に訪れたのは“住宅街”……"
msgstr "● Сначала мы отправились в «жилой квартал»..."

#. ja: ●最初に訪れたのは“市場”……
#. de: ●最初に訪れたのは„市場“……
#. fr: ●最初に訪れたのは“市場”……
msgctxt "InstanceContentTextData:43660:0:0"
msgid "●最初に訪れたのは“市場”……"
msgstr "● Сначала мы отправились на «рынок»..."

#. ja: ●最初に訪れたのは“正門通り”……
#. de: ●最初に訪れたのは„正門通り“……
#. fr: ●最初に訪れたのは“正門通り”……
msgctxt "InstanceContentTextData:43661:0:0"
msgid "●最初に訪れたのは“正門通り”……"
msgstr "● Сначала мы отправились на «главную улицу»..."

#. ja: こんな街中に魔物が！？<br>誰か襲われているようです、助けましょう！
#. de: Angreifende Bestien, mitten in der Stadt?! <split " " 1><string $gs1></split>, wir müssen sie aufhalten!
#. fr: Des monstres<nbsp>!? En pleine ville<nbsp>!? Je t'en prrrie, <split " " 1><string $gs1></split>, sauve cet innocent<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:43662:0:0"
msgid "Beasts, here!? It looks like they're attacking someone─we must help, <split \" \" 1><string $gs1></split>!"
msgstr "Звери, здесь!? Похоже, они на кого-то напали. Надо помочь, <split \" \" 1><string $gs1></split>!"

#. ja: このあたりの岩の特性でしょうか。<br>近づくと、つい尻尾がブワッとなりそう……！
#. de: Ich weiß nicht, ob es an den Steinen hier liegt, aber<nbsp>... sobald ich mich ihnen nähere, sträubt sich mir das Fell am Schwanz!
#. fr: Les pierres des envirrrons sont très par<shy>ti<shy>cu<shy>liè<shy>res... Quand je m'en approche, je sens le poil de ma queue se hérisser<nbsp>!
msgctxt "InstanceContentTextData:43663:0:0"
msgid "Whenever I draw near the rocks, the fur on my tail stands on end! What could be causing that?"
msgstr "Стоит подойти к этим скалам, и шерсть на хвосте дыбом встаёт! Что бы это могло быть?"

#. ja: 姿を消す魔法、厄介でしたね……！<br>まだしばらくは、花が揺れるだけでも警戒しちゃいそうです。
#. de: Was für ein Feigling versteckt sich mithilfe von Magie?! Jetzt muss ich sicher beim kleinsten Blätterrascheln zusammenzucken<nbsp>...
#. fr: Quelle plaie, ces disparitions<nbsp>! Maintenant, je vais surrrsauter au moindre bruit.
msgctxt "InstanceContentTextData:43664:0:0"
msgid "A lot of good invisibility did that beast! Watch for shaking flowers─we don't want another surprise!"
msgstr "И на что этому зверю невидимость? Следи за цветами: если начнут качаться, нас ждёт сюрприз!"

#. ja: ありがとう、おかげで助かったよ……！<br>ところで、君たちは？
#. de: Ihr<nbsp>... Ihr habt mich gerettet! Vielen Dank! Aber wer seid ihr eigentlich<nbsp>...?
#. fr: Merci pour votre aide providentielle<nbsp>! Qui êtes-vous, nobles voyageurs<nbsp>?
msgctxt "InstanceContentTextData:43665:0:0"
msgid "I'm...I'm unharmed, thanks to you. Just who are you, anyways?"
msgstr "Я... я цел. Спасибо вам. А вы, собственно, кто?"

#. ja: ふむ……それなら西の平野に行ってみるといい。<br>奥に、今は放棄された宮殿があってね……中は宝の山だそうだよ。
#. de: Hm<nbsp>... Dann solltet ihr die westlichen Ebenen durchqueren. Dort befindet sich ein alter, verlassener Palast. Man sagt, dass er wahre Schätze beherbergt.
#. fr: Hum... Dans ce cas, je vous conseille de parcourir les plaines de l'ouest. Vous y trouverez un palais abandonné où dorment de nombreuses richesses.
msgctxt "InstanceContentTextData:43666:0:0"
msgid "Hmm... Perhaps you'll find what you seek in the plains to the west. There lies an old abandoned palace, said to house a veritable mountain of treasure."
msgstr "Хм... Может, найдёте то, что ищете, на равнинах к западу. Там стоит старый заброшенный дворец. Говорят, внутри целая гора сокровищ."

#. ja: 宮殿跡に行ってみましょう！<br>いざ、宝探しの旅へ！
#. de: Ich glaube, wir haben unser nächstes Ziel gefunden! Auf zu dem verlassenen Palast!
#. fr: Parrrfait<nbsp>! Continuons notre chasse au trésor dans cette direction<nbsp>!
msgctxt "InstanceContentTextData:43667:0:0"
msgid "What could be in an abandoned palace but abandoned treasure? Let our search begin in earnest!"
msgstr "Что может быть в заброшенном дворце, если не заброшенные сокровища? Ну что, начнём поиск всерьёз!"

#. ja: <split " " 1><string $gs1></split>さん、北の渓谷に行ってみませんか？<br>盗賊がいるということは、近くに宝があるのかも……！
#. de: Sollen wir ihnen folgen? Vielleicht verstecken sie in ihrem Unterschlupf wertvolle Gegenstände, die sie geklaut haben!
#. fr: <split " " 1><string $gs1></split>, et si on suivait les brrrigands<nbsp>? Il y a sûrement des objets de valeur dans leur butin<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:43668:0:0"
msgid "Shall we travel to the northern valley, <split \" \" 1><string $gs1></split>? As insufferable as thieves are, they often hoard treasure!"
msgstr "Может, отправимся в северную долину, <split \" \" 1><string $gs1></split>? Как ни противны разбойники, а сокровища они копить любят!"

#. ja: 風が気持ちいい！<br>どことなく、甘い香りがしますね……。
#. de: Was für eine angenehme Brise! Und es liegt so ein leichter, süßer Duft in der Luft<nbsp>... Riechst du das auch?
#. fr: Quelle brise agréable<nbsp>! Elle porte avec elle tant de parrrfums sucrés<nbsp>!
msgctxt "InstanceContentTextData:43669:0:0"
msgid "There's nothing like the gentle caress of the wind! And that smell...something sweet is in the air!"
msgstr "Нет ничего лучше лёгкого ветерка! А этот запах... Пахнет чем-то сладким!"

#. ja: やっぱり、香りの正体はリンゴでした！<br>あっち側にも果樹園が続いてますね。
#. de: Ah, der Duft kam also von den Äpfeln! In dieser Richtung scheint es noch mehr Obstbäume zu geben.
#. fr: Je me disais bien que c'était l'odeur de pommes<nbsp>! Il y a d'autres arbres fruitiers dans cette dirrrection.
msgctxt "InstanceContentTextData:43670:0:0"
msgid "So that was the scent of apples! I thought so. The orchard keeps going in that direction, it seems."
msgstr "Так вот чем пахло! Яблоками! Сад, похоже, тянется и туда."

#. ja: はい、集落があれば、<br>お宝に関する情報も得られるかもしれません！
#. de: Gute Idee! Wenn es in der Nähe wirklich eine Siedlung gibt, weiß dort vielleicht jemand etwas über einen Schatz in dieser Gegend.
#. fr: Effectivement, la population locale pourrait nous mettre sur la piste d'un objet de valeurrr.
msgctxt "InstanceContentTextData:43671:0:0"
msgid "If there's a settlement nearby, someone might be able to point us towards the nearest treasure."
msgstr "Если поблизости есть поселение, кто-нибудь может подсказать, где тут искать сокровища."

#. ja: たしかに……人里から離れた場所にこそ、<br>お宝が眠っているかもしれませんね！
#. de: Du hast recht<nbsp>... Wertvolle Gegenstände versteckt man besser dort, wo möglichst wenige Leute hingehen!
#. fr: Tu as raison... Ce n'est pas dans un village qu'on va trrrouver un trésor<nbsp>!
msgctxt "InstanceContentTextData:43672:0:0"
msgid "I see your thinking: where there's fewer people, there's more hidden treasure to be found!"
msgstr "Понимаю ход твоих мыслей: чем меньше людей вокруг, тем больше шансов найти спрятанное сокровище!"

#. ja: きっとこれは、価値のある品に違いありません！<br>娘の家に戻って渡してみましょう！
#. de: Ich jedenfalls könnte einen solchen Schatz nicht mit Geld aufwiegen! Komm, wir sollten ihn auf direktem Weg zur Angebeteten des Händlers bringen!
#. fr: C'est cer<shy>tai<shy>ne<shy>ment un objet d'une trrrès grande valeur<nbsp>! Allons tout de suite l'offrir à la belle demoiselle<nbsp>!
msgctxt "InstanceContentTextData:43673:0:0"
msgid "I, for one, could not put a price on a treasure such as this! Let us bring it to the maiden!"
msgstr "Такое сокровище не измерить никакими деньгами! Отнесём его девушке."

#. ja: さすが<split " " 1><string $gs1></split>さんですね！<br>見えない敵にも、惑わされず！
#. de: Gut gemacht, <split " " 1><string $gs1></split>! Selbst ein unsichtbarer Gegner schafft es nicht, dich aus der Ruhe zu bringen!
#. fr: Bien joué, <split " " 1><string $gs1></split><nbsp>! Invisible ou pas, cet ennemi n'a pas fait le poids<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:43674:0:0"
msgid "Exactly the outcome I expected! Even an invisible enemy is no match for your cunning, <split \" \" 1><string $gs1></split>!"
msgstr "Именно такого исхода я и ждала! Даже невидимый враг не сравнится с твоей смекалкой, <split \" \" 1><string $gs1></split>!"

#. ja: きっとこれは、価値のある品に違いありません！<br>娘の家に戻って渡してみましょう！
#. de: Wenn das nicht aussieht wie ein Gegenstand von unschätzbarem Wert, dann weiß ich auch nicht! Lass ihn uns direkt zur Angebeteten des Händlers bringen!
#. fr: C'est cer<shy>tai<shy>ne<shy>ment un objet d'une trrrès grande valeur<nbsp>! Allons tout de suite l'offrir à la belle demoiselle<nbsp>!
msgctxt "InstanceContentTextData:43675:0:0"
msgid "This has to be of great value─value immeasurable, one might say! Let us deliver this to the maiden!"
msgstr "Вещь, должно быть, невероятно ценная! Отнесём её девушке."

#. ja: 最後まで楽しそうな使い魔でしたね……！<br>あれが攻撃でなければ、こちらも楽しめたかもしれません。
#. de: Er scheint ja richtig Spaß gehabt zu haben<nbsp>... Hätte er nicht versucht, uns umzubringen, wäre es für uns vielleicht auch etwas spaßiger gewesen<nbsp>...
#. fr: Il avait l'air de bien s'amuser... S'il n'avait pas essayé de nous tuer, on aurait peut-être pu rrrigoler un peu, nous aussi...
msgctxt "InstanceContentTextData:43676:0:0"
msgid "I must say, that was a grand display! If that genie wasn't trying to kill us, I would certainly watch it again!"
msgstr "Вот это представление! Если бы этот джинн не пытался нас убить, я бы и ещё раз посмотрела!"

#. ja: あっ、新しい道です！<br>もしかして、岩に特定の力を充填させたから……動いた……？
#. de: Oh, ein neuer Weg! Glaubst du, die Felsen haben sich bewegt, weil sie über irgendwelche besonderen Kräfte verfügen?
#. fr: Ouah<nbsp>! Un nouveau passage<nbsp>! Tu crrrois que c'est parce qu'on a chargé ces rochers<nbsp>?
msgctxt "InstanceContentTextData:43677:0:0"
msgid "A new path! It seems the rocks moved... Hmm. Were they imbued with some unseen power?"
msgstr "Новая дорога! Камни будто сдвинулись... Хм. Неужели в них заключена какая-то невидимая сила?"

#. ja: すごい、遠くまで見えますよ！<br>……あそこに見えるのが、宮殿跡ですね！
#. de: Einfach atemberaubend<nbsp>...! Die Ebene erstreckt sich bis zum Horizont<nbsp>... Oh, und das muss der verlassene Palast sein!
#. fr: Les plaines s'étendent à perrrte de vue<nbsp>! C'est pas le fameux palais abandonné qu'on aperçoit au loin<nbsp>?
msgctxt "InstanceContentTextData:43678:0:0"
msgid "The horizon stretches as far as the eye can see! Oh, is that...? Why, I think it's the palace!"
msgstr "Равнина тянется до самого горизонта! О, вон там... Да это же дворец!"

#. ja: <split " " 1><string $gs1></split>さん！？<br>……えっ、そこ降りられるんですか！？
#. de: <split " " 1><string $gs1></split>?! Woher wusstest du, dass wir da durchkommen würden?
#. fr: <split " " 1><string $gs1></split><nbsp>!? Comment tu as su qu'on pouvait passer parrr là<nbsp>?
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:43679:0:0"
msgid "<split \" \" 1><string $gs1></split>!? Are you... Oh, can I get down from over there!?"
msgstr "<split \" \" 1><string $gs1></split>!? Ты... О, оттуда можно спуститься!?"

#. ja: そちらの道、宮殿跡につながっていそうですね！<br>魔物に気をつけて進みましょう！
#. de: Dieser Weg scheint direkt zum Palast zu führen! Aber wir sollten vorsichtig sein, hier wimmelt es sicher nur so vor unliebsamen Kreaturen<nbsp>...
#. fr: Cette route mène au palais. Restons vigilant<if $gn4>e</if>s, les monstres pullulent<nbsp>!
msgctxt "InstanceContentTextData:43680:0:0"
msgid "Here we are! I expect we'll be accosted soon enough, so be careful!"
msgstr "Вот и пришли! Скоро на нас наверняка кто-нибудь нападёт, так что будь осторожнее!"

#. ja: ん～、おいしい！<br>口の中でフワッととろけて、芳醇な香りが広がって……！
#. de: Mhhh, ich habe selten etwas so Köstliches gegessen! So zart und gleichzeitig so geschmacksintensiv!
#. fr: Délicieux<nbsp>! Cette texturrre soyeuse... Et cette saveur intense<nbsp>!
msgctxt "InstanceContentTextData:43681:0:0"
msgid "What divine flavor! I scarcely need to chew, and the aroma overwhelms the senses!"
msgstr "Какой божественный вкус! Жевать почти не нужно, а аромат просто кружит голову!"

#. ja: あ、<split " " 1><string $gs1></split>さんも気になりますか？<br>私の直感も、キノコに導かれよと告げています！
#. de: Ich hab das Gefühl, dass diese Pilze uns den Weg weisen wollen<nbsp>... Was denkst du, <split " " 1><string $gs1></split>?
#. fr: J'ai le sentiment que ces champignons cherrrchent à nous guider... Qu'en penses-tu, <split " " 1><string $gs1></split><nbsp>?
msgctxt "InstanceContentTextData:43682:0:0"
msgid "I can tell you're curious too. My intuition agrees─follow the mushrooms!"
msgstr "Вижу, тебе тоже любопытно. Моё чутьё согласно: за грибами!"

#. ja: <split " " 1><string $gs1></split>さん、大丈夫ですか！？<br>衝撃で手すりが壊れて……！
#. de: Alles in Ordnung, <split " " 1><string $gs1></split>?! Das Geländer hat einfach nachgegeben!
#. fr: La rrrambarde a cédé sous le choc<nbsp>! Est-ce que ça va, <split " " 1><string $gs1></split><nbsp>?
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:43683:0:0"
msgid "Are you alright, <split \" \" 1><string $gs1></split>!? The railing broke!"
msgstr "Ты в порядке, <split \" \" 1><string $gs1></split>!? Перила сломались!"

#. ja: お怪我はありませんか？<br>まさか、こちらにも道があったなんて……。
#. de: Hast du dir auch nicht wehgetan? Ich hätte nicht gedacht, dass wir ausgerechnet hier einen Weg finden würden<nbsp>...
#. fr: J'espère que tu n'es pas blessé<if $gn4>e</if>. Je ne pensais pas qu'on pouvait entrrrer par là...
msgctxt "InstanceContentTextData:43684:0:0"
msgid "Are you hurt? To think we would find a path here of all places..."
msgstr "Ты не ушибся? Вот уж не думала, что мы найдём здесь проход..."

#. ja: あっ、岩が浮きました！<br>なにやら、力が充填されていくようでしたが……。
#. de: Der Stein schwebt in der Luft! Es sah so aus, als ob irgendeine Kraft in ihn hineingeleitet worden wäre<nbsp>...
#. fr: Ah<nbsp>! Les rochers ont forrrmé une plate-forme<nbsp>! Tu les as sûrement alimentés en énergie.
msgctxt "InstanceContentTextData:43685:0:0"
msgid "The rock is floating in the air! It looked as though some kind of power was being channeled into it..."
msgstr "Камень парит в воздухе! Похоже, в него направляли какую-то силу..."

#. ja: 珍しい光景なので、気になりますよね……！<br>もっと近くで浮いている岩を見てみましょうか！
#. de: So etwas hab ich noch nie gesehen<nbsp>... Ich denke, wir sollten uns diese schwebenden Felsen mal genauer ansehen!
#. fr: C'est vrrrai que moi aussi, j'avais envie d'aller jeter un coup d'œil par là<nbsp>! C'est parti<nbsp>!
msgctxt "InstanceContentTextData:43686:0:0"
msgid "I haven't seen anything quite like this... I believe we have no choice but to get a closer look!"
msgstr "Ничего подобного я прежде не видела... Надо подойти поближе и рассмотреть!"

#. ja: これで、この辺りにある岩はすべて浮き上がりましたね。<br>何か変わったのでしょうか……？
#. de: Es sieht so aus, als würden jetzt alle Felsen in der Luft schweben. Ob sich wohl sonst noch etwas verändert hat<nbsp>...?
#. fr: Et voilà, toutes les pierres sont dans les airs. Tu as rrremarqué quelque chose de différent<nbsp>?
msgctxt "InstanceContentTextData:43687:0:0"
msgid "It seems with that, all the rocks in the area are floating. I wonder if anything else changed...?"
msgstr "Похоже, теперь в округе все камни парят. Интересно, ещё что-нибудь изменилось?.."

#. ja: あれは、伝説の剛剣使い……？<br>ただならぬ気配がします……ご武運を！
#. de: Was für eine Ausstrahlung<nbsp>... Das muss eine der legendären Schwertmeisterinnen sein! Bleib wachsam, sie hat bestimmt so einige un<shy>be<shy>rechen<shy>bare Techniken auf Lager!
#. fr: C'est vraiment un maître d'armes<nbsp>? Comme dans les légendes<nbsp>? Reste sur tes garrrdes, ses techniques sont sûrement im<shy>pré<shy>vi<shy>si<shy>bles<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:43688:0:0"
msgid "That must be one of the legendary swordmasters... Even I can sense she is a formidable foe. But not as formidable as <i>you</i>, I'm sure!"
msgstr "Это, должно быть, одна из легендарных мастериц меча... Даже я чую, какая она грозная противница. Но тебе она всё равно не соперница, <i>уверена</i>!"

#. ja: おつかれさまでした！<br>ずいぶん怠惰な敵でしたが……強さは本物でしたね……！
#. de: Klasse Kampf! Trotz ihres gelassenen Auftretens hast du sie nicht unterschätzt, sehr gut!
#. fr: Bravo<nbsp>! C'était une ennemie nonchalante, mais tu as bien fait de ne pas sous-estimer sa forrrce<nbsp>!
msgctxt "InstanceContentTextData:43689:0:0"
msgid "That was quite the fight! Despite appearances, her strength was terrifying to behold."
msgstr "Вот это был бой! Не суди по виду: её сила по-настоящему страшна."

#. ja: この絨毯は、さっきの……置いていかれたんだ……。<br>近くで見ると、織物としても素晴らしい出来ですね。
#. de: Sieh dir mal den Teppich an, den sie zurückgelassen hat. Aus der Nähe betrachtet sieht er wirklich hochwertig aus, findest du nicht auch?
#. fr: Elle a abandonné ce tapis... Il a l'airrr d'être de très bonne facture.
msgctxt "InstanceContentTextData:43690:0:0"
msgid "It's one of the carpets...she just left it here. Now that I see it up close, 'tis plain it was woven by a master."
msgstr "Один из ковров... Она просто бросила его здесь. Теперь, вблизи, видно, что соткан он искусной рукой."

#. ja: どうされましたか？
#. de: Was ist passiert?
#. fr: Que vous arrive-t-il<nbsp>?
msgctxt "InstanceContentTextData:43691:0:0"
msgid "What's the matter?"
msgstr "Что случилось?"

#. ja: 荷車が壊れちまったんだよ。<br>もう少し先の店まで運びたかったんだが……。
#. de: Mein Karren ist kaputtgegangen, und das so kurz vor dem Ziel<nbsp>...  Jetzt muss ich die ganzen Kisten wohl mühsam schleppen<nbsp>...
#. fr: Ma charrette a rendu l'âme à seulement quelques yalms de la boutique que je dois livrer<nbsp>!
msgctxt "InstanceContentTextData:43692:0:0"
msgid "The damned wheels came right off... Suppose I'll be carrying my haul the rest of the way."
msgstr "Колёса проклятые отвалились... Придётся тащить весь груз остаток пути."

#. ja: よければ、お手伝いしましょうか？<br>量は多いですが、手分けすれば運べると思います！
#. de: Wir können dir gerne helfen! Wenn wir alle mit anpacken, ist die Arbeit im Hand<shy>umdrehen erledigt!
#. fr: Si vous voulez, nous pouvons vous aider à transporrrter votre marchandise pour le reste du voyage<nbsp>!
msgctxt "InstanceContentTextData:43693:0:0"
msgid "Well, we can help with that. If we split the load, we should be able to make it in one go!"
msgstr "Мы можем помочь. Разделим груз — и, думаю, за один раз всё донесём!"

#. ja: あの……「計り知れぬほど価値ある品」と聞いて、<br>あなたなら何を思い浮かべますか？
#. de: Sag mal<nbsp>... Wenn du den Ausdruck „ein Gegenstand von unschätzbarem Wert“ hörst, was kommt dir da zuerst in den Sinn?
#. fr: Si je vous dis que nous cherrrchons un <i>objet d'une valeur inestimable</i>, est-ce que ça vous dit quelque chose<nbsp>?
msgctxt "InstanceContentTextData:43694:0:0"
msgid "Say, if I asked you to imagine an object of immeasurable worth, what would come to mind?"
msgstr "Скажи, если представить вещь неизмеримой ценности, что первым придёт тебе на ум?"

#. ja: うーん、価値ある品ねぇ。<br>絹、瑠璃、香辛料……売れ筋の高級品はそのあたりか？
#. de: Hm, wenn du besonders beliebte Waren mit einem hohen Marktwert meinst, dann vielleicht Seide, Lapislazuli oder seltene Gewürze.
#. fr: Hum... S'il s'agit d'une valeur marchande, je vous recommanderais du satin, du lapis-lazuli ou des épices rares...
msgctxt "InstanceContentTextData:43695:0:0"
msgid "Looking to make some coin, eh? Hmm. Silk, gemstones, spices. All those would fetch a high price."
msgstr "Хочешь деньжат срубить, да? Хм. Шёлк, самоцветы, пряности. Всё это можно дорого продать."

#. ja: そういえば……東の入江には、人魚が棲んでいるらしいぞ。<br>海で採れる珍しい品を持っていそうじゃないか？
#. de: Ah, oder seht euch doch mal in der Bucht östlich von hier um. Es heißt, dass eine Meerjungfrau dort versunkene Schätze versteckt haben soll.
#. fr: Sinon, essayez peut-être d'explorer la baie à l'est d'ici. On dit qu'une sirène y cacherait de nombreux trésors engloutis.
msgctxt "InstanceContentTextData:43696:0:0"
msgid "Come to think of it, I heard sea-folk live in the cove to the east. If anyone had a treasure of singular worth, it would be them."
msgstr "Кстати, я слышал, в бухте к востоку живут морские девы. Уж у них-то наверняка есть какое-нибудь редкое морское сокровище."

#. ja: 貴重なお話、ありがとうございます！<br><split " " 1><string $gs1></split>さん、東の入江に行ってみましょう！
#. de: Das klingt wirklich viel<shy>ver<shy>sprechend, vielen Dank für den Hinweis! Ich denke, unser nächstes Ziel steht somit fest, <split " " 1><string $gs1></split>!
#. fr: Merrrci pour ces précieux conseils<nbsp>! Suivons cette piste, <split " " 1><string $gs1></split><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:43697:0:0"
msgid "Thank you for that precious morsel of information, my good man! I believe we have our next destination, <split \" \" 1><string $gs1></split>!"
msgstr "Спасибо за столь ценную подсказку, добрый человек! Кажется, мы знаем, куда идти дальше, <split \" \" 1><string $gs1></split>!"

#. ja: あっ、あれは「コルヴォの隠遁者」では？<br>巨像の足首に見える岩塊が、海峡の両岸にあるっていう……！
#. de: Oh, ist das etwa der berühmte „Eremit von Corvos“? Man erzählt sich, dass die beiden Felsformationen, die auf beiden Seiten der Bucht zu finden sind, die Knöchel einer riesigen Statue sein sollen!
#. fr: C'est pas le fameux “Ermite corvosien”<nbsp>? On raconte que ces deux formations rrrocheuses qui entourent la baie sont en réalité les chevilles d'une statue gigantesque<nbsp>!
msgctxt "InstanceContentTextData:43698:0:0"
msgid "Ah, could that be? The Anchorite at Corvos? I read that the rocky formations on both sides of the strait are actually the ankles of a massive statue!"
msgstr "Постойте, неужели это Отшельник Корвоса? Я читал, что скалы по обе стороны пролива — это на самом деле лодыжки огромной статуи!"

#. ja: 恐ろしい怪物でしたね……。<br>あちらにも道が続いているようなので、行ってみましょう。
#. de: Ich werde noch eine ganze Weile Albträume von dieser Kreatur haben<nbsp>... Lass uns schnell zurück an Land gehen, ja?
#. fr: Brrr... Je frrrissonne encore de peur... Continuons dans cette direction.
msgctxt "InstanceContentTextData:43699:0:0"
msgid "I think I'll stay well away from the open sea for some time... Well, let's get to land, yes?"
msgstr "Пожалуй, какое-то время я побуду подальше от открытого моря... Ну что, вернёмся на сушу?"

#. ja: ここは……生き物の気配がありませんね。<br>でも、昔は人が住んでいた……？
#. de: Kein einziges Anzeichen von Leben in dieser Gegend<nbsp>... Aber früher haben hier doch Leute gelebt, oder nicht?
#. fr: Aucun signe de vie dans les parrrages... Mais des gens vivaient ici autrefois, non<nbsp>?
msgctxt "InstanceContentTextData:43700:0:0"
msgid "Not a single soul to be found...but plainly, this place once thrived."
msgstr "Ни души вокруг... А ведь когда-то здесь кипела жизнь."

#. ja: なんというか……愉快な敵でしたね。<br>使い魔なりの歓迎だったのかな……。
#. de: Man kann wirklich sagen, dass das ein außer<shy>ge<shy>wöhn<shy>licher Empfang war<nbsp>...
#. fr: On peut dire que c'était un accueil chaleurrreux...
msgctxt "InstanceContentTextData:43701:0:0"
msgid "That was─how should I put it?─quite the cheerful adversary. Perhaps it was welcoming us, in its own way..."
msgstr "Как бы это сказать... противник оказался на редкость весёлым. Может, так он по-своему нас приветствовал..."

#. ja: あっ……<split " " 1><string $gs1></split>さん、あの絨毯って……！<br>娘の部屋にあったものと同じじゃないですか！？
#. de: <split " " 1><string $gs1></split>, der Teppich! Ist das nicht genau das gleiche Motiv, das wir im Zimmer der Angebeteten des Händlers schon einmal gesehen haben?!
#. fr: <split " " 1><string $gs1></split><nbsp>! Ce tapis<nbsp>! C'est le même que celui que nous avons vu dans les apparrrtements de la belle demoiselle<nbsp>!
msgctxt "InstanceContentTextData:43702:0:0"
msgid "Wait... That carpet. Is it not the selfsame design we saw in the maiden's room?"
msgstr "Постой... Этот ковёр. Узор ведь точно такой же, как в комнате той девушки?"

#. ja: うん、やっぱり食べられます！<br>独特の歯ごたえが、料理のアクセントに使えそう！
#. de: Ja, die sind essbar! Ihre besondere Konsistenz bringt mich auf ganz neue Rezeptideen!
#. fr: Je te confirme que ces algues sont comestibles<nbsp>! Leur consistance ferme et élastique me donne des idées de rrrecettes<nbsp>!
msgctxt "InstanceContentTextData:43703:0:0"
msgid "Indeed, it is edible! This unique flavor would make for a perfect spice in certain dishes."
msgstr "Да, это съедобно! Такой необычный вкус отлично подойдёт в качестве приправы к некоторым блюдам."

#. ja: はい、この海ならではのものが見つかるかもしれません！<br>道中もいろいろ観察しながら行きましょう！
#. de: Diese Gewässer stecken bestimmt voller Schätze! Halten wir die Augen offen, während wir die Gegend erkunden!
#. fr: Ces eaux regorgent cer<shy>tai<shy>ne<shy>ment de richesses<nbsp>! Ouvrons grrrand les yeux pendant que nous parcourons les environs<nbsp>!
msgctxt "InstanceContentTextData:43704:0:0"
msgid "Indeed, these waters may hold treasures all their own! I look forward to the sights which await us."
msgstr "И правда, в этих водах могут скрываться свои сокровища! С нетерпением жду, что ещё нам встретится."

#. ja: 砂浜にも、美しい貝殻や真珠が見えますね……！<br>では、あちらに行ってみましょう！
#. de: Du hast recht, am Strand kann man bestimmt noch mehr schöne Muscheln und Perlen finden!
#. fr: Continuons par ici, alors<nbsp>! J'aperrrçois plein de jolis coquillages et des perles le long de la plage<nbsp>!
msgctxt "InstanceContentTextData:43705:0:0"
msgid "Indeed, I see shells and pearls glittering among the sands... All right, lead the way!"
msgstr "И правда, среди песка блестят ракушки и жемчужины... Ладно, веди!"

#. ja: 同じ柄の皿があります、これを持って帰りましょう。<br>ずいぶんと汚れてしまっていますが、きっと……。
#. de: Dieser Teller zeigt dasselbe Motiv<nbsp>... Er sieht zwar ein bisschen mitgenommen aus, aber ich denke, wir sollten ihn trotzdem mitnehmen!
#. fr: Cette assiette est en piteux état, mais je rrreconnais ces motifs... Ramenons-la à notre amie mé<shy>lan<shy>co<shy>li<shy>que.
msgctxt "InstanceContentTextData:43706:0:0"
msgid "There's a plate with a matching pattern, too. It's quite dirty, but I think we should take it back with us."
msgstr "Тут ещё и тарелка с таким же узором. Она вся грязная, но, думаю, стоит взять её с собой."

#. ja: このあたりは人の手が入っていますね。<br>何かを祀っていたのかも……？
#. de: Das sind eindeutig Spuren von Zivilisation. Vielleicht war hier mal eine Art Gebetsstätte?
#. fr: Je constate des trrraces de civilisation... Un lieu de culte, peut-être<nbsp>?
msgctxt "InstanceContentTextData:43707:0:0"
msgid "The marks of civilization are plain to see. Was this once a place of worship?"
msgstr "Следы цивилизации налицо. Неужели здесь когда-то было святилище?"

#. ja: 大丈夫ですか！？<br>こんな大通りで、襲ってくるなんて……。
#. de: Alles in Ordnung?! Was war das denn? Ein Angriff mitten in der Stadt! Nicht zu fassen<nbsp>...
#. fr: Vous n'êtes pas blessée<nbsp>? Quelle audace d'agrrresser une innocente dans une rue passante comme celle-ci<nbsp>!
msgctxt "InstanceContentTextData:43708:0:0"
msgid "Are you all right!? To think they would be so bold as to attack on a well-traveled avenue..."
msgstr "Ты в порядке!? Вот ведь наглость — нападать посреди оживлённой улицы..."

#. ja: おつかれさまでした！<br>あの人魚……襲ってきましたが、どこか悲しそうでしたね……。
#. de: Zum Glück haben wir den Kampf überstanden! Die Meerjungfrau war eine ernstzunehmende Gegnerin<nbsp>...  Aber irgendwie hat sie gleichzeitig eine tiefe Trauer ausgestrahlt, findest du nicht auch?
#. fr: Décidément, quel talent, <split " " 1><string $gs1></split><nbsp>! Cette sirène était agrrressive, mais j'ai aussi perçu une pointe de tristesse dans sa voix...
msgctxt "InstanceContentTextData:43710:0:0"
msgid "We made it! Although the sea-maid tried to kill us, something about her seemed...mournful."
msgstr "Мы справились! Морская дева пыталась нас убить, но в ней чувствовалась какая-то... тоска."

#. ja: これは……彼女が落とした宝珠でしょうか？<br>思わず吸い込まれそうな輝き……。
#. de: Sieh dir nur diese Perle an, die sie zurückgelassen hat! Sie leuchtet und funkelt in den schönsten Farben<nbsp>... Man könnte sich glatt in ihrem Anblick verlieren! Lieber nicht zu lange hinsehen<nbsp>...
#. fr: Elle a laissé cette sublime perle derrière elle. J'ai du mal à détourrrner les yeux de ses reflets miroitants<nbsp>!
msgctxt "InstanceContentTextData:43711:0:0"
msgid "Look, she dropped this gem. Its glow is entrancing...'tis probably best not to stare too long."
msgstr "Смотри, она обронила самоцвет. Какой завораживающий блеск... Лучше долго не смотреть."

#. ja: 助けてくださってありがとうございます。<br>アイツらは、最近北の渓谷に住み着いた盗賊でして……。
#. de: Ihr habt mir das Leben gerettet! Das waren die Banditen aus dem Tal im Norden, die seit Kurzem überall in der Gegend Angst und Schrecken verbreiten.
#. fr: Vous m'avez sauvé la vie<nbsp>! Récemment, ces maudits bandits ont élu domicile dans les ravins au nord...
msgctxt "InstanceContentTextData:43712:0:0"
msgid "You saved my life, truly. Those thieves but recently began to infest the valley to the north."
msgstr "Вы спасли мне жизнь, право. Эти разбойники совсем недавно обосновались в северной долине."

#. ja: 貝の音に呼ばれて、来てくれたのでしょうか？<br>入江の景色を映したかのような色合いで可愛いですね……！
#. de: Ist es dem Ruf der Muschel gefolgt? Was für ein süßes und hübsches Ding! Es leuchtet in sämtlichen Farben des Meeres<nbsp>...
#. fr: Il a répondu à l'appel de la conque<nbsp>? Comme il est mignon<nbsp>! On dirrrait qu'il miroite de toutes les couleurs<nbsp>!
msgctxt "InstanceContentTextData:43713:0:0"
msgid "Did it answer the shell's call? What an adorable thing─and it's colored just like the cove!"
msgstr "Она откликнулась на зов раковины? Какая прелесть! И цветом точь-в-точь как эта бухта!"

#. ja: ああ、嬉しい、嬉しいわ……！<br>人がまた、私に呼びかけてくれるなんて……！
#. de: Ihr seid meinem Ruf gefolgt, ich bin entzückt!
#. fr: Je suis heureuse que vous ayez répondu à mon appel<nbsp>!
msgctxt "InstanceContentTextData:43714:0:0"
msgid "Oh, most joyful of days! At last, voices from the land call out to me again!"
msgstr "О, какой счастливый день! Наконец-то с земли снова доносятся голоса!"

#. ja: 愛しき人、その声に応えて導きましょう。<br>あなたの探し物は、この道の先に……。
#. de: Was ihr sucht, findet ihr am Ende dieses Weges. Lasst euch von meinem Gesang leiten<nbsp>...
#. fr: Laissez mon chant vous guider... Ce que vous cherchez avec tant d'obstination se trouve au bout de ce chemin...
msgctxt "InstanceContentTextData:43715:0:0"
msgid "Pretty creatures, allow me to guide you. What you seek lies at the end of this path."
msgstr "Милые создания, позвольте проводить вас. То, что вы ищете, находится в конце этого пути."

#. ja: でも、どうか気を付けて。<br>ここからは悪しきものの縄張り……私の声は、もう届かない……。
#. de: Aber ich muss dich warnen: Von hier an führt der Weg durch das Territorium einer schrecklichen Bestie, wo dich meine Stimme nicht mehr erreichen wird.
#. fr: Mais je dois vous mettre en garde... Vous allez pénétrer dans le territoire d'une vile créature où ma voix ne saurait résonner...
msgctxt "InstanceContentTextData:43716:0:0"
msgid "Yet you must tread carefully. It passes through the territory of a dreadful beast...where my voice will not reach you."
msgstr "Но будьте осторожны. Дальше начинается владение ужасного зверя... там мой голос вас уже не достигнет."

#. ja: ね、寝転んだまま戦ってる……。<br>起き上がることすら面倒、ってことですか！？
#. de: Sie macht sich nicht mal die Mühe, aufzustehen! Sind wir unter ihrer Würde?!
#. fr: Elle se bat allongée<nbsp>!? C'est une sacrrrée <i>fée-néante</i><nbsp>!
msgctxt "InstanceContentTextData:43717:0:0"
msgid "Why, she hasn't even bothered to get up! Does she consider us beneath her, or is she just lazy?"
msgstr "Да она даже не встала! Считает нас недостойными или просто ленивая?"

#. ja: 動くのが面倒で、絨毯に命じて自分を運ばせてるようです！<br>……本当に、ものすごく怠惰なんですね。
#. de: Sie ist sogar zu faul, sich selbst zu bewegen<nbsp>... Der Teppich übernimmt die ganze Arbeit für sie!
#. fr: C'est le tapis qui fait tout le trrravail<nbsp>! Elle pourrait pourtant se déplacer elle-même<nbsp>!
msgctxt "InstanceContentTextData:43718:0:0"
msgid "It seems the carpets do her bidding... Heavens forfend she lift a finger herself!"
msgstr "Похоже, ковры исполняют её приказы... Боже упаси самой хоть пальцем пошевелить!"

#. ja: あれは、さっきの怪鳥……！？
#. de: Ist das der Vogel von vorhin?!
#. fr: C'est l'oiseau de tout à l'heurrre<nbsp>?
msgctxt "InstanceContentTextData:43719:0:0"
msgid "Is that the bird from before!?"
msgstr "Это та птица, что была раньше!?"

#. ja: ほら絨毯、次はアレをお見舞いしてやりな。<br>わかってるね？
#. de: Bring es schon endlich zu Ende! Hast du mich verstanden, du alter Bettvorleger?!
#. fr: C'est pas le moment de faire les descentes de lit<nbsp>! Vous avez compris, bande de tapis élimés<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:43720:0:0"
msgid "Now make yourselves useful, you old rags. You <i>do</i> know what I mean, yes?"
msgstr "А ну, тряпьё старое, покажите, на что годитесь. Вы <i>и правда</i> поняли, что я сказала?"

#. ja: なんだ、風精まで来たのかい。<br>ちょうどいい、この闖入者を追っ払っておくれよ。
#. de: Wie jetzt, eine Windfee? Das trifft sich gut. Wenn du schon da bist, dann hilf mir dabei, diese Eindringlinge loszuwerden!
#. fr: Tiens, un élémentaire<nbsp>! Puisque tu es là, aide-moi à me débarrasser de ces intrus<nbsp>!
msgctxt "InstanceContentTextData:43721:0:0"
msgid "A spirit come to join the fray? Good, good. The lighter my burden, the better."
msgstr "Дух явился присоединиться к драке? Отлично, отлично. Чем меньше мне хлопот, тем лучше."

#. ja: わっ、あれって、ランプの精！？<br>待ち構えていたようですが……。
#. de: I-Ist das etwa<nbsp>... Eine magische Lampe?!
#. fr: Cet esprrrit nous attendait de pied ferme<nbsp>! Enfin... façon de parler...
msgctxt "InstanceContentTextData:43722:0:0"
msgid "Is that a magic lamp I see!? Just how long was it waiting for us?"
msgstr "Неужели это волшебная лампа!? И сколько же она нас ждала?"

#. ja: ようこそ、いらっしゃいました！<br>大歓迎させていただきますよー！
#. de: Da seid ihr ja endlich! Willkommen, willkommen!
#. fr: Bienvenue, chers amis<nbsp>! Vous arrivez juste à temps<nbsp>!
msgctxt "InstanceContentTextData:43723:0:0"
msgid "Welcome, welcome! The guests of honor are here at last!"
msgstr "Добро пожаловать, добро пожаловать! Наконец-то прибыли почётные гости!"

#. ja: ショータイムの始まりでございまーす！<br>見逃し厳禁、ですよー！
#. de: Dann kann das große Spektakel nun ja beginnen! Macht euch bereit und freut euch auf eine einzigartige Darbietung<nbsp>...
#. fr: Le grand spectacle est sur le point de commencer<nbsp>! Préparez-vous à avoir le souffle coupé<nbsp>!
msgctxt "InstanceContentTextData:43724:0:0"
msgid "The curtain rises on the big show! Dare not look away, or else!"
msgstr "Занавес поднят, представление начинается! Только не вздумайте отвернуться, а то пожалеете!"

#. ja: 締めくくりは、ド派手にいきましょー！<br>はい、ドッカーン！！
#. de: Es wird Zeit für den Moment, auf den alle gewartet haben: Das große Feuerwerk!
#. fr: Nous arrivons au moment tant attendu<nbsp>: le bouquet final<nbsp>! Ouvrez grand les yeux, ça va décoiffer<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:43725:0:0"
msgid "Let us end on a high note! An <i>explosive</i> note!"
msgstr "Закончим на высокой ноте! На <i>взрывной</i> ноте!"

#. ja: もっともーっと、盛り上げていきましょー！<br>火力マシマシ、火傷にご注意くださーい！
#. de: Das war noch längst nicht alles, was euch heute hier geboten wird! Aber Vorsicht, es könnte heiß werden<nbsp>...
#. fr: Mais attendez, ce n'est pas fini<nbsp>! J'ai encore tout un tas de pétards en réserve<nbsp>! Mettons le feu aux poudres<nbsp>!
msgctxt "InstanceContentTextData:43726:0:0"
msgid "Now we turn up the heat! Do make sure not to get burned!"
msgstr "А теперь поддадим жару! Смотрите не обожгитесь!"

#. ja: いいですねぇ、いいですねぇー！<br>ワタシもバーンと打ち上げちゃいますかー！
#. de: Bravo! Wie schön das geknallt hat! Na, wollt ihr noch mehr davon sehen?
#. fr: Bravo<nbsp>! Bravo<nbsp>! Moi aussi, je dois pétarader de plus belle<nbsp>!
msgctxt "InstanceContentTextData:43727:0:0"
msgid "Oh ho, you really know how to put on a show! But I can't let my own guests upstage me!"
msgstr "Ого, да вы умеете устроить представление! Но я не позволю гостям затмить меня!"

#. ja: ピカピカ、ビューンと疾走する様をご覧あれ！<br>事故が起きても、責任はとりませーん！
#. de: Hahaha, seht euch an, wie hier die Funken sprühen! Aber ich übernehme keine Verantwortung, wenn sich jemand verbrennt.
#. fr: Magnifique<nbsp>! Regardez-les filer et scintiller<nbsp>! N'oubliez pas que la direction décline toute res<shy>pon<shy>sa<shy>bi<shy>li<shy>té en cas de blessure<nbsp>!
msgctxt "InstanceContentTextData:43728:0:0"
msgid "Splendid! Look how they dart about! Be aware that I take no responsibility in case of grievous injury!"
msgstr "Великолепно! Глядите, как они носятся! Только учтите: за тяжёлые травмы я ответственности не несу!"

#. ja: ここからは怒涛の打ち上げですよー！<br>目をかっぴらいて、お楽しみくださーい！
#. de: Jetzt werden die großen Geschütze aufgefahren! Passt gut auf, das wollt ihr garantiert nicht verpassen!
#. fr: Il est temps de sortir la grosse artillerie<nbsp>! Vous avez de la chance d'être aux premières loges<nbsp>!
msgctxt "InstanceContentTextData:43729:0:0"
msgid "That was only the opening act! Keep your eyes peeled─you won't want to miss this next part!"
msgstr "Это было лишь вступление! Глаза шире — следующую часть нельзя пропустить!"

#. ja: 落ち着いて、よく見てください！<br>連続といえど、きっと隙間はあります！
#. de: Bleib ruhig und sieh dich aufmerksam um! Es wird sich bestimmt eine Gelegenheit auftun!
#. fr: Prends le temps d'analyser la situation<nbsp>! Il y a sûrement un endrrroit où tu peux tout éviter...
msgctxt "InstanceContentTextData:43730:0:0"
msgid "Keep your wits about you and your eyes sharp! An opening will present itself!"
msgstr "Не теряй голову и смотри в оба! Скоро появится шанс!"

#. ja: おやおや、特別ゲストの登場ですねー！？<br>一緒に盛り上がっていきましょー！
#. de: Wen haben wir denn da? Ein Überraschungsgast! Je mehr, desto besser!
#. fr: Mazette<nbsp>! Des invités surprise<nbsp>! Plus on est de fous, plus on rit<nbsp>!
msgctxt "InstanceContentTextData:43731:0:0"
msgid "What do we have here? Surprise guests! This will be one for the ages!"
msgstr "Что у нас тут? Нежданные гости! Вот это будет представление на века!"

#. ja: 水を流したことで助けたのかと思いきや、<br>敵に回っちゃうんですか！？
#. de: Noch ein Gegner?! Für einen Moment dachte ich wirklich, das Wasser wäre ein Segen<nbsp>...
#. fr: Un autrrre ennemi<nbsp>? Pendant un moment j'ai vraiment cru que l'eau était là pour nous aider...
msgctxt "InstanceContentTextData:43732:0:0"
msgid "Another foe!? And here I thought the water would be a boon..."
msgstr "Ещё враг!? А я-то решила, что вода нам поможет..."

#. ja: まもなく、フィーバータイムでございまーす！<br>色とりどりの輝きを、とくとご覧あれー！
#. de: Jetzt kommt der spaßige Teil! Lasst euch verzaubern! Lasst euch begeistern! Lasst euch hypnotisieren!
#. fr: Les esprits s'échauffent<nbsp>! Il est temps de dévoiler le clou du spectacle<nbsp>! Appréciez ce numéro haut en couleur<nbsp>!
msgctxt "InstanceContentTextData:43733:0:0"
msgid "Now for the fun part! Be dazzled! Be amazed! Be hypnotized!"
msgstr "А теперь самое интересное! Любуйтесь! Изумляйтесь! Теряйте голову!"

#. ja: わぁ、綺麗な虹ですね～！<br>……って、だめだめ、あれも攻撃なのでご注意ください！
#. de: Diese Farbenpracht<nbsp>... Einfach atemberaubend schön! Ah, und gefährlich! Pass auf!
#. fr: Que c'est joli...<nbsp>! Ah, mais attention, c'est sûrrrement encore un explosif<nbsp>!
msgctxt "InstanceContentTextData:43734:0:0"
msgid "How breathtaking! And...dangerous! Yes, dangerous! Stay focused!"
msgstr "Какая красота! И... опасно! Да, опасно! Не отвлекайся!"

#. ja: 手練れ同士の、手に汗握る白熱の戦いでした……！<br>でもさすが<split " " 1><string $gs1></split>さん、大勝利ですよ！
#. de: Das war ein unerbittlicher Kampf zwischen zwei herausragenden Kriegern! Am Ende hast du dich als <if $gn4>die Stärkere<else>der Stärkere</if> erwiesen.
#. fr: C'était un combat intense entre deux combattant<if $gn4>e</if>s hors pair<nbsp>! Heurrreusement, tu as su tirer ton épingle du jeu<nbsp>!
msgctxt "InstanceContentTextData:43735:0:0"
msgid "That was like seeing two artists at work! My jaw was clenched the whole time...but in the end, you proved the mightier!"
msgstr "Будто на двух мастеров смотришь! Я всё время сидела как на иголках... но в конце концов ты доказала, кто сильнее!"

#. ja: 先程の剛剣使いの愛剣……<br>刃に欠けのひとつもなく、装飾も見事ですね。
#. de: Sieh dir dieses Schwert an<nbsp>... Diese filigranen Verzierungen zeugen von wahrer Handwerkskunst! Und trotz des heftigen Kampfes hat es nicht einen einzigen Kratzer abbekommen!
#. fr: Ton adversaire a abandonné son sabre... Malgré la violence de votre combat, il n'a pas l'ombre d'une égrrratignure<nbsp>!
msgctxt "InstanceContentTextData:43736:0:0"
msgid "Why, it's the swordmaster's blade. The edge is flawless, and the decorations are exquisite!"
msgstr "Да это же меч мастерицы! Лезвие без единой зазубрины, а украшения просто великолепны!"

#. ja: さあ、剣を取れ。<br>私を楽しませてくれよ？
#. de: Zieht eure Waffen. Hoffentlich könnt ihr mich vor eurem Tod noch ein wenig unterhalten!
#. fr: Voilà enfin un adversaire à ma hauteur<nbsp>! En garde<nbsp>! Montre-moi ce dont tu es capable<nbsp>!
msgctxt "InstanceContentTextData:43737:0:0"
msgid "Take up your weapon. I pray you can provide some measure of entertainment before you die."
msgstr "Бери оружие. Надеюсь, до смерти ты успеешь меня хоть немного развлечь."

#. ja: 八方より来たりて禍いとならん……！
#. de: Von allen Seiten wird es Unheil regnen<nbsp>...!
#. fr: Que le malheur t'assaille de toutes parts<nbsp>!
msgctxt "InstanceContentTextData:43738:0:0"
msgid "Death comes from all directions!"
msgstr "Смерть грядёт со всех сторон!"

#. ja: 逃げ惑え！<br>降り注ぐ凶星に慄くがいい！
#. de: Lauft, wenn ihr wollt, aber niemand kann seinem Schicksal entfliehen!
#. fr: Tu peux fuir si ça te chante, mais personne n'échappe au destin<nbsp>!
msgctxt "InstanceContentTextData:43739:0:0"
msgid "Run if you dare! Doom shall find you all the same!"
msgstr "Беги, если осмелишься! Рок всё равно тебя настигнет!"

#. ja: 貴様にも教えてやろう。<br>凶星からは逃れられぬと。
#. de: Es gibt kein Entkommen.
#. fr: Le temps est venu pour toi de faire face à ton destin<nbsp>!
msgctxt "InstanceContentTextData:43740:0:0"
msgid "Know this: none can escape their fate."
msgstr "Запомни: от судьбы не уйти."

#. ja: 貴様に、この剣閃が見切れるか？
#. de: Na, könnt ihr meiner Klinge folgen?
#. fr: Arriveras-tu à percevoir les mouvements de ma lame<nbsp>?
msgctxt "InstanceContentTextData:43741:0:0"
msgid "Whence shall my blade strike? Look well!"
msgstr "Откуда ударит мой клинок? Смотри в оба!"

#. ja: 剛剣とは何たるか、思い知るがいい！
#. de: Ihr werdet es bereuen, euch mit einer wahren Meisterin der Schwertkunst angelegt zu haben!
#. fr: Tu vas regretter d'avoir croisé le fer avec un maître d'armes<nbsp>!
msgctxt "InstanceContentTextData:43742:0:0"
msgid "Bear witness to the Unyielding Blade!"
msgstr "Узнай, что такое Несгибаемый клинок!"

#. ja: 貴様ごときが、逃げられると思うなよ？
#. de: Glaubt ihr wirklich, ihr könnt mir entkommen?
#. fr: Tu crois vraiment pouvoir éviter toutes mes attaques<nbsp>?
msgctxt "InstanceContentTextData:43743:0:0"
msgid "Do you truly believe you can run from me?"
msgstr "Ты правда думаешь, что сбежишь от меня?"

#. ja: ふはは、面白い！<br>もっと私を楽しませてみろ！
#. de: Hahaha, nicht übel! Vielleicht enttäuscht ihr mich doch nicht!
#. fr: Ha ha ha<nbsp>! Surprenant<nbsp>! Et que dis-tu de ça<nbsp>?
msgctxt "InstanceContentTextData:43744:0:0"
msgid "Hah hah, good, good! Perhaps you shall not disappoint after all!"
msgstr "Ха-ха, отлично! Может, ты всё-таки меня не разочаруешь!"

#. ja: 貴様は流れを読めるか、試してやろう！
#. de: Na, könnt ihr meinen nächsten Schritt erahnen?
#. fr: Essaye donc de prédire ma prochaine attaque<nbsp>!
msgctxt "InstanceContentTextData:43745:0:0"
msgid "Let us see how attuned you are to the flow of battle!"
msgstr "Ну-ка проверим, чувствуешь ли ты ход боя!"

#. ja: この程度で、くたばってくれるなよ？
#. de: Ihr wollt doch wohl nicht jetzt schon aufgeben? Ich werde gerade erst richtig warm!
#. fr: Je m'échauffe à peine. Ne meurs pas trop vite, d'accord<nbsp>?
msgctxt "InstanceContentTextData:43746:0:0"
msgid "Do not dare perish before witnessing my full strength!"
msgstr "Не вздумай умереть, не увидев всей моей силы!"

#. ja: 大地も味方につけてこそ、一流というものよ！
#. de: Wer die Erde selbst auf seiner Seite hat, dem ist der Sieg gewiss!
#. fr: Celui qui contrôle le terrain décide de l'issue du combat<nbsp>!
msgctxt "InstanceContentTextData:43747:0:0"
msgid "Only a true master can call the earth itself her ally!"
msgstr "Лишь истинная мастерица способна обратить саму землю себе в союзники!"

#. ja: 逃がさん！
#. de: Nicht so schnell!
#. fr: Évite donc ça<nbsp>!
msgctxt "InstanceContentTextData:43748:0:0"
msgid "Not so fast!"
msgstr "Не так быстро!"

#. ja: 剛剣の妙、貴様にも見せてやろう！
#. de: Verneige dich vor der Macht meines Schwertes!
#. fr: Incline-toi face à la supériorité martiale des maîtres d'armes<nbsp>!
msgctxt "InstanceContentTextData:43749:0:0"
msgid "Behold the depths of my art!"
msgstr "Узри всё искусство моего клинка!"

#. ja: さあ、もっと楽しませてくれよ！
#. de: Kommt schon, nicht nachlassen! Strengt euch an!
#. fr: C'est ça<nbsp>! N'abandonne pas<nbsp>! Continue de me distraire<nbsp>!
msgctxt "InstanceContentTextData:43750:0:0"
msgid "Come now, you can do better than that!"
msgstr "Ну же, ты можешь и лучше!"

#. ja: ……つまらんな、期待外れか。<br>死人は学ばない、ただ眠るだけだ。
#. de: Langweilig<nbsp>... Ihr enttäuscht mich. Ihr habt noch viel zu lernen, aber dazu wird euch keine Zeit bleiben.
#. fr: Pitoyable... Il est temps pour toi de mordre la poussière.
msgctxt "InstanceContentTextData:43751:0:0"
msgid "...Tch, you have much to learn. Sadly, the dead do not learn. They sleep."
msgstr "...Тц, тебе ещё учиться и учиться. Жаль, мёртвые не учатся. Они спят."

#. ja: さあさあ、お待ちかねのアンコールですよー！<br>盛り上がる準備はよろしいですかー？
#. de: Na, wie wäre es mit einer kleinen Zugabe?
#. fr: Merci, cher public<nbsp>! Faisons donc un rappel<nbsp>! Continuez d'applaudir<nbsp>!
msgctxt "InstanceContentTextData:43752:0:0"
msgid "Now for the part no one expects─the encore! Can you keep up the energy for just a little longer?"
msgstr "А теперь — часть, которой никто не ждёт: на бис! Силёнок ещё немного осталось?"

#. ja: ドッカン、ドッカン！<br>おまけにもひとつ、ドッカーン！！
#. de: Bumm! Bamm! Und noch ein Knall obendrauf!
#. fr: C'est parti pour un déluge d'explosions de toutes les couleurs<nbsp>!
msgctxt "InstanceContentTextData:43753:0:0"
msgid "Bang! Boom! And a blast for good measure!"
msgstr "Бах! Бум! И ещё один взрыв вдогонку!"

#. ja: まだまだショーは続きますよー！
#. de: Wir sind noch lange nicht fertig!
#. fr: Quand y en a plus, y en a encore<nbsp>!
msgctxt "InstanceContentTextData:43754:0:0"
msgid "The show must go on!"
msgstr "Шоу продолжается!"

#. ja: 楽しんでいただけてますかー？
#. de: Na, gefällt dir das Spektakel?
#. fr: Le spectacle est à votre goût<nbsp>?
msgctxt "InstanceContentTextData:43755:0:0"
msgid "Have you ever had so much fun!?"
msgstr "Ну и веселье, а?"

#. ja: ほーらほら！<br>どんどん盛り上がっていきますよー！
#. de: Wirklich nicht übel! Aber da geht noch mehr!
#. fr: Quel rythme endiablé<nbsp>! Ne vous battez pas, il y en aura pour tout le monde<nbsp>!
msgctxt "InstanceContentTextData:43756:0:0"
msgid "What a show! But it can always be better!"
msgstr "Вот это представление! Но можно и получше!"

#. ja: はぁ、まだ抵抗するのかい……。<br>アタシは、さっさと終わらせたいんだけどねぇ。
#. de: Ihr steht immer noch? Dabei wollte ich das eigentlich schnell hinter mich bringen, hmpf<nbsp>...
#. fr: Encore là<nbsp>? Quelle corvée... Moi qui voulais en finir rapidement...
msgctxt "InstanceContentTextData:43757:0:0"
msgid "You're still standing? Ugh... I was hoping this would be over by now."
msgstr "Ты всё ещё на ногах? Эх... А я-то надеялась уже закончить."

#. ja: 周囲にエーテルの刃が……！<br>ご注意ください！
#. de: Klingen aus Äther! Pass auf, dass sie dich nicht berühren!
#. fr: Des lames d'étherrr sont apparues... Fais attention<nbsp>!
msgctxt "InstanceContentTextData:43758:0:0"
msgid "Blades of aether! Don't let them pierce you!"
msgstr "Эфирные клинки! Не дай им тебя пронзить!"

#. ja: わわっ、落石！？<br>あっぶないなぁ……！
#. de: Vorsicht, Steinschlag!
#. fr: Des pierres sont tombées en plein milieu de l'arène<nbsp>!? C'est dangerrreux<nbsp>!
msgctxt "InstanceContentTextData:43759:0:0"
msgid "Falling stones! Watch your head!"
msgstr "Камнепад! Голову береги!"

#. ja: うっ、また磁場の乱れが……。<br>きっと敵はこの力も利用してくるはず……！
#. de: Die Magnetfelder sind instabil<nbsp>... Das wird unsere Gegnerin ausnutzen!
#. fr: Toutes ces fluctuations magnétiques... Je suppose que notre ennemie cherrrche à les utiliser à son avantage.
msgctxt "InstanceContentTextData:43760:0:0"
msgid "The magnetic fields are wildly unstable... Perhaps our foe uses them against us."
msgstr "Магнитные поля совсем разбушевались... Может, враг использует их против нас."

#. ja: エーテルの刃が軌道を変えた！？<br>あれが、コルヴォに伝わる剛剣の秘技……！
#. de: Pass auf, die Ätherklingen haben plötzlich ihre Flugrichtung geändert! Die Geheimtechnik der Schwertmeisterinnen von Corvos<nbsp>...!
#. fr: Des lames d'éther arrivent de toutes les directions<nbsp>! Les maîtres d'armes de la région de Corvos sont vrrraiment effrayants<nbsp>!
msgctxt "InstanceContentTextData:43761:0:0"
msgid "The blades of aether changed trajectory!? I see now why the Unyielding Blade was so feared..."
msgstr "Эфирные клинки сменили траекторию!? Теперь понятно, почему неуступчивого мечника так боялись..."

#. ja: きっとこれは、価値のある品に違いありません！<br>娘の家に戻って渡してみましょう！
#. de: Das sieht unheimlich wertvoll aus<nbsp>... Wir sollten es der Angebeteten des Händlers bringen!
#. fr: C'est cer<shy>tai<shy>ne<shy>ment un objet d'une trrrès grande valeur<nbsp>! Allons tout de suite l'offrir à la belle demoiselle<nbsp>!
msgctxt "InstanceContentTextData:43762:0:0"
msgid "I must say, I certainly couldn't measure the value of this. Could you? No? I believe that means we should deliver it to the maiden!"
msgstr "Признаться, я и понятия не имею, сколько это может стоить. А ты? Тоже нет? Значит, надо отнести эту вещицу той девушке!"

#. ja: 続けて別方向からも波が来ます！<br>周囲をよく見て、警戒してください……！
#. de: Die Wellen kommen aus allen Richtungen! Pass auf, dass sie dich nicht mitreißen!
#. fr: Des vagues arrivent de parrrtout<nbsp>! N'oublie pas de regarder derrière toi<nbsp>!
msgctxt "InstanceContentTextData:43763:0:0"
msgid "Waves are coming from everywhere at once! Don't let them knock you over!"
msgstr "Волны наступают со всех сторон! Смотри, не сбейся с ног!"

#. ja: しがない商人と、腕利きの護衛です。<br>「計り知れぬほど価値ある品」を探す旅に出るところでして。
#. de: Ich bin ein einfacher Händler und das hier ist <if $gn4>meine treue Leibwächterin<else>mein treuer Leibwächter</if>. Wir sind auf der Suche nach einem Gegenstand von unschätzbarem Wert.
#. fr: Je ne suis qu'un modeste camelot accompagné de son garrrde du corps à la recherche d'un <i>objet d'une valeur inestimable</i>.
msgctxt "InstanceContentTextData:43764:0:0"
msgid "I'm but a humble merchant, and this is my trusty bodyguard. We are searching for treasure said to be of value immeasurable."
msgstr "Я всего лишь скромный торговец, а это мой верный телохранитель. Мы ищем сокровище, которому нет цены."

#. ja: 今、音がしませんでしたか……？
#. de: Hast du das gerade auch gehört?
#. fr: C-c'était quoi ce brrruit<nbsp>?
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:43765:0:0"
msgid "<split \" \" 1><string $gs1></split>, listen. Did you hear a sound just now?"
msgstr "<split \" \" 1><string $gs1></split>, послушай. Ты только что что-то слышал?"

#. ja: ということは、ここはもしかして娘の……。
#. de: Könnte das früher mal ihr Zuhause gewesen sein<nbsp>...?
#. fr: Tout ceci lui a peut-être apparrrtenu autrefois...
msgctxt "InstanceContentTextData:43766:0:0"
msgid "Could this have been her home...?"
msgstr "Неужели это был её дом?.."

#. ja: この戦い方……剣技とエーテルを組み合わせた攻撃……<br>まさかこの方は、帝国の弾圧で歴史に消えた、伝説の剛剣使い！？
#. de: Jeder ihrer Schwerthiebe ist mit Äther aufgeladen<nbsp>... Könnte sie eine der legendären Schwertmeisterinnen sein, die unter der garleischen Besatzung ausgelöscht wurden?!
#. fr: Chacune de ses attaques est charrrgée d'éther... Serait-ce un des maîtres d'armes qui ont été exterminés lors de l'occupation de l'Empire<nbsp>!?
msgctxt "InstanceContentTextData:43767:0:0"
msgid "This fighting style...sword strikes imbued with aether. Could this be one of the swordmasters that were snuffed out by the Empire!?"
msgstr "Такой стиль боя... Удары мечом, наполненные эфиром. Неужели это один из легендарных мастеров меча, которых истребила Империя!?"

#. ja: 見せてやろう。<br>貴様の身に刻まれる、凶星の浮かぶ方角を！
#. de: Der Tod findet uns alle. Aber aus welcher Richtung wird er kommen? Ich werde es euch verraten!
#. fr: Laisse-moi te dévoiler de quel côté la mort viendra t'étreindre<nbsp>!
msgctxt "InstanceContentTextData:43768:0:0"
msgid "From where shall death take you? I shall grant you the mercy of foresight."
msgstr "Откуда к тебе придёт смерть? Позволь мне даровать тебе милость предвидения."

#. ja: 届ける荷物の数
#. de: Zu liefernde Waren
#. fr: Marchandises à livrer
msgctxt "InstanceContentTextData:43769:0:0"
msgid "Crates delivered"
msgstr "Ящиков доставлено"

#. ja: オーナーの悪行は許されません！<br>ワタシは……挑戦者を応援させてもらいます！！
#. de: Dem Präsidenten muss das Handwerk gelegt werden! Ich<nbsp>... weiß, auf wessen Seite ich stehe!
#. fr: Le pro<shy>prié<shy>taire a dépassé les bornes<nbsp>! Alors j'ai choisi d'encourager notre challenger<nbsp>!
msgctxt "InstanceContentTextData:43900:0:0"
msgid "The president must pay for his crimes! Give him what for, Champion!"
msgstr "Президент должен ответить за свои преступления! Покажи ему, на что способен, чемпион!"

#. ja: 腕が蛇になったァ！？<br>これが伝説のリンドブルムの力なのかァ～！
#. de: Sein Arm hat sich verwandelt?! Ist das etwa die Macht des legendären Lindwurms?
#. fr: Son bras s'est transformé en serpent<nbsp>! Voilà donc la force légendaire du Lindwurm<nbsp>!
msgctxt "InstanceContentTextData:43901:0:0"
msgid "His arm has a life of its own! Is this the power of the mythical Lindwurm?"
msgstr "У него рука сама по себе живёт! Вот она, сила легендарного Линдвурма?"

#. ja: なんとおぞましい！<br>腕が伸びているぞォ～！
#. de: Wie abscheulich! Sein Arm streckt sich in die Länge!
#. fr: Quelle horreur<nbsp>! Son bras s'allonge pour frapper notre challenger<nbsp>!
msgctxt "InstanceContentTextData:43902:0:0"
msgid "His arm is slithering out! That's disgusting!"
msgstr "Его рука извивается! Фу, какая мерзость!"

#. ja: 飛び散った細胞が広がっている！？
#. de: Die verstreuten Zellen verbreiten sich weiter?!
#. fr: Les morceaux dispersés se répandent partout<nbsp>!
msgctxt "InstanceContentTextData:43903:0:0"
msgid "The Lindwurm's scattered gore is expanding!?"
msgstr "Разбросанные останки Линдвурма расползаются!?"

#. ja: この動き、巻き付こうとしているようだ！<br>逃げてくれ、挑戦者ァ～！！
#. de: Er versucht, seine Gegner einzuwickeln! Vorsicht, Herausforderer!
#. fr: Attention<nbsp>! Le serpent essaie de s'enrouler autour du challenger<nbsp>!
msgctxt "InstanceContentTextData:43904:0:0"
msgid "Watch out! That is one cruel coil..."
msgstr "Берегись! Вот это хватка..."

#. ja: ダメだ！<br>締め付けられてしまったァ～！
#. de: Oh nein! Jemand ist dem Wurm zum Opfer gefallen!
#. fr: Damnation<nbsp>! Ce maudit reptile a enserré sa proie<nbsp>!
msgctxt "InstanceContentTextData:43905:0:0"
msgid "Oh no! The champion's been crushed!"
msgstr "О нет! Чемпиона раздавило!"

#. ja: 腕をリングに巻き付けているぞ……<br>いったい、何をする気だァ～！？
#. de: Er wickelt seine Arme um den Ring! Was hat er nur vor?
#. fr: On dirait qu'il enroule ses bras autour de l'arène... Mais que va-t-il faire<nbsp>!?
msgctxt "InstanceContentTextData:43906:0:0"
msgid "His arms are snaking 'round the ring! What's he planning!?"
msgstr "Он обвивает арену руками! Что же он задумал!?"

#. ja: 大変だ、リングが破壊されてしまったァ～！
#. de: Ich glaube es kaum, er hat den Ring zerstört!
#. fr: Oh non<nbsp>! Le ring a été détruit<nbsp>!
msgctxt "InstanceContentTextData:43907:0:0"
msgid "Dear me, the ring's in pieces!"
msgstr "Надо же, от ринга одни обломки!"

#. ja: 挑戦者が細胞に寄生された！<br>落ち着いて対処だッ！
#. de: Die Herausforderer wurden befallen! Jetzt Ruhe bewahren!
#. fr: Un morceau s'est accroché à notre challenger<nbsp>! Il faut vite s'en débarrasser<nbsp>!
msgctxt "InstanceContentTextData:43908:0:0"
msgid "Oh no, the gore has latched onto the champion! Don't panic!"
msgstr "О нет, останки впились в чемпиона! Не паникуй!"

#. ja: リンドブルムが全快してしまったァ！？<br>なんという再生能力だァ～！！
#. de: Der Lindwurm hat sich komplett erholt?! Was für eine Regenerationskraft!
#. fr: Le Lindwurm s'est entièrement soigné<nbsp>! Ses capacités curatives sont hors du commun<nbsp>!
msgctxt "InstanceContentTextData:43909:0:0"
msgid "The Lindwurm's completely healed! What outrageous regenerative power!"
msgstr "Линдвурм полностью исцелился! Вот это регенерация!"

#. ja: これはまさか……<br>再生能力が暴走しているッ！？
#. de: Was zum...?! Spielen seine Heilkräfte etwa verrückt?!
#. fr: Que se passe-t-il<nbsp>? Le serpent aurait-il perdu le contrôle de son pouvoir<nbsp>?
msgctxt "InstanceContentTextData:43910:0:0"
msgid "What the─? Could the Lindwurm's regeneration be out of control!?"
msgstr "Что за... Неужели регенерация Линдвурма вышла из-под контроля!?"

#. ja: 何度も再生を繰り返しています！
#. de: Er heilt sich unaufhörlich weiter!
#. fr: Rien n'arrête la puissance régénérante du Lindwurm<nbsp>! Il se fabrique des bras à l'infini<nbsp>!
msgctxt "InstanceContentTextData:43911:0:0"
msgid "His power continues to run amok! Again and again he remakes his arms!"
msgstr "Его сила всё буйствует! Он снова и снова отращивает себе руки!"

#. ja: 再生能力に、限界はないのかァ～！？
#. de: Kennt seine Regeneration denn gar keine Grenzen?!
#. fr: Mais n'y a-t-il aucune limite à ce pouvoir<nbsp>!?
msgctxt "InstanceContentTextData:43912:0:0"
msgid "Is there no limit to his regenerative capacity!?"
msgstr "Неужели его регенерации нет предела!?"

#. ja: リンドブルムが追い詰められているぞ！<br>がんばれ、挑戦者、このまま押し切ってくれッ～！
#. de: Der Lindwurm ist sichtlich angeschlagen! Jetzt nicht nachlassen, Herausforderer!
#. fr: Le challenger ne laisse aucun répit à son adversaire<nbsp>! Allez, il faut continuer<nbsp>!
msgctxt "InstanceContentTextData:43913:0:0"
msgid "Yes, you've got the serpent on the back tail! Press the advantage and finish this!"
msgstr "Змей уже на последнем издыхании! Не сбавляй напор, чемпион, добей его!"

#. ja: 毒液をくらったァ！<br>どうか耐えてくれ、挑戦者～！！
#. de: Sie wurden vom Gift erwischt! Aber das können sie wegstecken, das weiß ich genau!
#. fr: Popopo... Catastrophe<nbsp>! Le challenger a reçu une dose de venin<nbsp>!
msgctxt "InstanceContentTextData:43914:0:0"
msgid "They've been struck with venom! But they can weather it─they must!"
msgstr "Их задело ядом! Но они выдержат... должны выдержать!"

#. ja: この攻撃はマズそうだぞォ～！
#. de: Dieser Angriff sieht übel aus!
#. fr: Cette attaque ne me dit rien qui vaille...<nbsp>!
msgctxt "InstanceContentTextData:43915:0:0"
msgid "Something revolting this way comes!"
msgstr "Что-то мерзкое надвигается!"

#. ja: 決まったァ～～～！<br>挑戦者の勝利ィ～～～！
#. de: Und Schluss! Die Herausforderer holen sich den Sieg!
#. fr: Victoire du challenger<nbsp>! Son adversaire est à terre<nbsp>!
msgctxt "InstanceContentTextData:43916:0:0"
msgid "The battle is decided! Victory goes to the champion!"
msgstr "Бой окончен! Победа за чемпионом!"

#. ja: おや、これは……リンドブルムの核？
#. de: Hm, ist das<nbsp>... das Herz des Lindwurms?
#. fr: Tiens, qu'est-ce que c'est...<nbsp>? Le cœur de la créature<nbsp>?
msgctxt "InstanceContentTextData:43917:0:0"
msgid "Hm? Is that...the Lindwurm's heart?"
msgstr "Хм? Это... сердце Линдвурма?"

#. ja: 核が脈打っている！？<br>何やら禍々しいことが起ころうとしています……！
#. de: Es pulsiert? Ich habe ein ganz schlechtes Gefühl bei der Sache<nbsp>...!
#. fr: Oh là là là, j'entends encore un pouls... J'ai bien peur que le combat ne soit pas encore terminé<nbsp>!
msgctxt "InstanceContentTextData:43918:0:0"
msgid "It's pulsating... I've got a bad feeling about this!"
msgstr "Оно пульсирует... Чую, добром это не кончится!"

#. ja: 細胞が……何かに……なろうとしている……？
#. de: Die Zellen<nbsp>...! Sie formen sich<nbsp>... neu<nbsp>...?!
#. fr: Les cellules du Lindwurm... On dirait qu'elles s'agitent...
msgctxt "InstanceContentTextData:43919:0:0"
msgid "It's contorting... Transforming!"
msgstr "Оно корчится... Превращается!"

#. ja: オー・マイ・グッドネス！<br>新たなリンドブルムが誕生したァ～！
#. de: Ach du lieber Himmel! Der Lindwurm wurde neu geboren!
#. fr: Par tous les diables<nbsp>! Le Lindwurm s'est régénéré<nbsp>!
msgctxt "InstanceContentTextData:43920:0:0"
msgid "Snakes alive! It's the birth of a new Lindwurm!"
msgstr "Змеи мои! Рождается новый Линдвурм!"

#. ja: 闘いは終わりません！<br>いけ、挑戦者、絶対に諦めるな～！
#. de: Der Kampf ist noch nicht entschieden! Gebt nicht auf, Herausforderer!
#. fr: Le duel n'est pas terminé<nbsp>! Il ne faut pas abandonner maintenant<nbsp>!
msgctxt "InstanceContentTextData:43921:0:0"
msgid "Alas, the battle isn't over yet... But don't despair, Champion!"
msgstr "Увы, бой ещё не окончен... Но не отчаивайся, чемпион!"

#. ja: なんてことだ！<br>分裂して増えていくぞォ～！
#. de: Unfassbar! Er hat sich geteilt und vermehrt!
#. fr: J'en crois pas mes yeux<nbsp>! Le serpent se démultiplie<nbsp>!
msgctxt "InstanceContentTextData:43922:0:0"
msgid "The Lindwurm is creating more of itself!"
msgstr "Линдвурм плодит себе подобных!"

#. ja: また増えていく～！<br>この力、もはや神の領域だァ～！
#. de: Er hat sich erneut vervielfacht! Diese Kraft gleicht wahrer Göttlichkeit!
#. fr: Aïe, aïe, aïe, aïe<nbsp>! Le Lindwurm continue de se dédoubler<nbsp>! Rien ne semble pouvoir l'arrêter<nbsp>!
msgctxt "InstanceContentTextData:43923:0:0"
msgid "The Lindwurm continues to multiply! We've gone well beyond mortal limits now! "
msgstr "Линдвурм всё множится! Это уже за пределами человеческих возможностей! "

#. ja: 何かが現れました！<br>これは……いったい……？
#. de: Da ist etwas aufgetaucht! Was passiert hier nur?!
#. fr: D'étranges silhouettes viennent d'apparaître dans l'arène<nbsp>! Que se passe-t-il<nbsp>!?
msgctxt "InstanceContentTextData:43924:0:0"
msgid "Some curious props have appeared! What could they possibly be?"
msgstr "Появились какие-то странные декорации! Что бы это могло быть?"

#. ja: なんとォ～、挑戦者の姿に変わったァ！<br>何が起きるというのだァ～！
#. de: Ich werde verrückt! Sie haben sich in die Herausforderer verwandelt!
#. fr: Ces drôles de pantins ont pris l'apparence de notre challenger<nbsp>! Que vont-ils faire à présent<nbsp>!?
msgctxt "InstanceContentTextData:43925:0:0"
msgid "Egads, they've taken on the champion's form! This bodes ill!"
msgstr "Вот так дела, они приняли облик чемпиона! Добром это не кончится!"

#. ja: 先ほど起きたことが……再現されているッ！？
#. de: Bilden sie etwa nach, was vorher passiert ist?!
#. fr: J'ai comme une sérieuse impression de déjà-vu, pas vous<nbsp>?
msgctxt "InstanceContentTextData:43926:0:0"
msgid "I've got a serious case of deja vu here..."
msgstr "У меня уже серьёзное дежавю..."

#. ja: とてつもない破壊力！<br>リングが分断されてしまったァ！
#. de: Eine Zer<shy>störungs<shy>kraft sondergleichen! Der Ring wurde zerteilt!
#. fr: Quel effroyable pouvoir destructeur<nbsp>! Il a même fracturé le ring<nbsp>!
msgctxt "InstanceContentTextData:43927:0:0"
msgid "What destructiveness! The ring has been rent in two!"
msgstr "Вот это разрушительная сила! Ринг раскололо надвое!"

#. ja: 細胞に寄生されたぞッ！<br>慌てず対処するんだ！
#. de: Sie wurden befallen! Behaltet einen kühlen Kopf!
#. fr: Ces parasites s'attaquent à notre challenger<nbsp>! Il faut garder la tête froide<nbsp>!
msgctxt "InstanceContentTextData:43928:0:0"
msgid "The mutation is corrupting the champion! Let's hope they keep it together!"
msgstr "Мутация поражает чемпиона! Надеюсь, он не растеряется!"

#. ja: 何かしようとしている？<br>気をつけるんだァ～！
#. de: Was hat er jetzt schon wieder vor? Bleibt auf der Hut!
#. fr: Prudence<nbsp>! Le Lindwurm semble préparer un autre coup fourré<nbsp>!
msgctxt "InstanceContentTextData:43929:0:0"
msgid "Something's coming... Stay on your toes!"
msgstr "Он что-то замышляет... Будь начеку!"

#. ja: ここは、どこでしょう？<br>まさか、リンドブルムが時空を歪めたというのかッ！？
#. de: Was ist das für ein Ort? Hat der Lindwurm etwa Raum und Zeit selbst gekrümmt?!
#. fr: Mais... Mais où sommes-nous<nbsp>!? Le Lindwurm aurait-il déformé l'espace-temps<nbsp>!?
msgctxt "InstanceContentTextData:43930:0:0"
msgid "What is this place? Did the Lindwurm warp the very fabric of space and time!?"
msgstr "Что это за место? Неужели Линдвурм исказил саму ткань пространства и времени!?"

#. ja: 新たな時空でしょうか！？<br>とても理解が追いつきませんッ……！！
#. de: Noch ein anderer Raum?! Das ist zu viel für meinen armen Kopf<nbsp>...!
#. fr: Quel est cet endroit<nbsp>? Une nouvelle dimension<nbsp>? Je n'y comprends plus rien<nbsp>!
msgctxt "InstanceContentTextData:43931:0:0"
msgid "Is this another dimension? I must confess, I'm utterly bewildered..."
msgstr "Это другое измерение? Признаюсь, я совершенно сбит с толку..."

#. ja: 激しい攻撃の嵐！<br>挑戦者が追い込まれている～！
#. de: Ein wahrer Sturm an Angriffen! Doch die Herausforderer lassen nicht nach!
#. fr: Une tempête de coups s'abat sur notre challenger<nbsp>! Arrivera-t-il à riposter<nbsp>?
msgctxt "InstanceContentTextData:43932:0:0"
msgid "A relentless assault! The champion is hard-pressed!"
msgstr "Неистовый натиск! Чемпиону приходится туго!"

#. ja: 闘いは熾烈を極めています！<br>だが、まだです、挑戦者はまだ立っているぞ～！
#. de: Der Kampf nährt sich seinem Höhepunkt! Aber die Herausforderer sind nicht kleinzukriegen!
#. fr: Ce combat acharné dépasse les limites de l'entendement<nbsp>! Mais le challenger tient bon<nbsp>!
msgctxt "InstanceContentTextData:43933:0:0"
msgid "The battle has reached a fever pitch! But the champion still stands!"
msgstr "Бой достиг накала! Но чемпион всё ещё держится на ногах!"

#. ja: おびただしい数だ！<br>挑戦者よ、どうか無事でいてくれ～！
#. de: Eine schier unmögliche Anzahl an Gegnern! Gebt alles, Herausforderer!
#. fr: Le challenge se retrouve en sous-nombre<nbsp>! Mais rien n'est encore joué<nbsp>!
msgctxt "InstanceContentTextData:43934:0:0"
msgid "There's so many of them... Stay strong, I beg you!"
msgstr "Их так много... Держись, умоляю!"

#. ja: こ、これは……！？<br>もはや、何が起きているのやら……。
#. de: W-Was zum<nbsp>...?! Ich verstehe hier gar nichts mehr<nbsp>...
#. fr: Euh... Je ne suis pas certain de comprendre ce qui se passe ici...
msgctxt "InstanceContentTextData:43935:0:0"
msgid "I'm not sure I understand what's going on anymore, folks."
msgstr "Не уверен, что теперь понимаю, что тут вообще происходит, народ."

#. ja: どうやら、常識が通じない領域へと、<br>踏み込んでしまったようです……！
#. de: Die uns bekannten Gesetze gelten hier wohl nicht mehr!
#. fr: Tout ce que nous voyons dépasse de loin les limites de l'imagination<nbsp>!
msgctxt "InstanceContentTextData:43936:0:0"
msgid "We appear to have completely left the realm of logic behind."
msgstr "Похоже, мы начисто покинули пределы логики."

#. ja: 我々の理解を遥かに超えた何かが、<br>この場で起こっています……！
#. de: Was auch immer hier geschieht, überschreitet eindeutig den normalen Verstand<nbsp>...!
#. fr: Le spectacle qui s'offre à nous est tout simplement in-des-crip-tible<nbsp>!
msgctxt "InstanceContentTextData:43937:0:0"
msgid "Something that defies all comprehension is unfolding before our very eyes!"
msgstr "На наших глазах творится нечто, превосходящее всякое понимание!"

#. ja: リンドブルムの撃破
#. de: Den Lindwurm bezwingen
#. fr: Vaincre le Lindwurm
msgctxt "InstanceContentTextData:43938:0:0"
msgid "Defeat the Lindwurm"
msgstr "Одолеть Линдвурма"
