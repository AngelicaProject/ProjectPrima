# InstanceContentTextData
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 居住区の主門を開けろ！
#. de: Öffne das Tor des Wohn<shy>viertels!
#. fr: Ouvrez la grande porte du Faubourg mhigois<nbsp>!
msgctxt "InstanceContentTextData:17000:0:0"
msgid "Open the gates of the Ala Mhigan Quarter"
msgstr "Откройте ворота ала-мийгского квартала"

#. ja: 超越技術研究所へ向かえ！
#. de: Schlag dich zum Transzendenz-Laboratorium durch!
#. fr: Allez au laboratoire impérial<nbsp>!
msgctxt "InstanceContentTextData:17001:0:0"
msgid "Head to the Resonatorium"
msgstr "Направляйтесь в Резонаторий"

#. ja: フォルドラ・レム・ルプスを倒せ！
#. de: Besiege Fordola rem Lupus!
#. fr: Vainquez Fordola rem Lupus<nbsp>!
msgctxt "InstanceContentTextData:17002:0:0"
msgid "Defeat Fordola rem Lupis"
msgstr "Победите Фордолу рем Лупис"

#. ja: この居住区の主門までは、俺が先導する！<br>後についてきてくれ！
#. de: Folgt mir zum Tor des Wohn<shy>viertels!
#. fr: Suivez-moi<nbsp>! Je vais vous montrer le chemin jusqu'à la grande porte.
msgctxt "InstanceContentTextData:17003:0:0"
msgid "Follow my lead. Stay close and quiet."
msgstr "За мной. Держитесь рядом и не шумите."

#. ja: 待て……！<br>奴らが通り過ぎるまで、身を隠しているんだ！
#. de: Wartet! Versteckt euch, bis die Wachen vorbei sind.
#. fr: Ne bougez pas<nbsp>! Cachons-nous en attendant que cette patrouille soit passée...
msgctxt "InstanceContentTextData:17004:0:0"
msgid "Wait! Patrol. Let them pass..."
msgstr "Тихо! Патруль. Пусть пройдут..."

#. ja: よし、やり過ごせたな……。<br>一気に進むぞ！
#. de: Sehr gut ... Jetzt weiter!
#. fr: C'est bon<nbsp>! La voie est libre<nbsp>!
msgctxt "InstanceContentTextData:17005:0:0"
msgid "All clear. With me!"
msgstr "Чисто. За мной!"

#. ja: 倒しきったな？<br>敵が集まってくる前に、主門に向かうぞ！
#. de: Alle erledigt, was? Schnell weiter, bevor Verstärkung kommt.
#. fr: Pas d'ennemis en vue... Dépêchons-nous d'aller à la grande porte avant que des renforts n'arrivent<nbsp>!
msgctxt "InstanceContentTextData:17006:0:0"
msgid "That the last of them? Good. Let's keep moving!"
msgstr "Это все? Отлично. Идем дальше!"

#. ja: おっと、進路に敵兵だ！<br>俺が始末する……お前たちは待機していてくれ……！
#. de: Feind in Sicht ... Überlasst den Knaben mir!
#. fr: Mince, il y a un garde<nbsp>! Je m'en occupe<nbsp>! Restez en arrière<nbsp>!
msgctxt "InstanceContentTextData:17007:0:0"
msgid "Sentry! Get to cover! I will deal with him..."
msgstr "Часовой! В укрытие! Я с ним разберусь..."

#. ja: やれやれ、見つからずに済んだな。<br>よし、先に進もう。
#. de: Bevor er Alarm schlagen konnte! Hehe. Weiter!
#. fr: Pfiou<nbsp>! J'ai eu de la chance de ne pas m'être fait repérer... Allons-y<nbsp>!
msgctxt "InstanceContentTextData:17008:0:0"
msgid "And none were the wiser... Let us press on."
msgstr "И никто ничего не заметил... Продолжим путь."

#. ja: 見つかったなら、やるしかない！<br>速攻でケリをつけるぞ！
#. de: Wenn sie euch bemerken, handelt schnell!
#. fr: Si jamais on est découverts, il faudra faire taire l'ennemi rapidement<nbsp>!
msgctxt "InstanceContentTextData:17009:0:0"
msgid "Not one for stealth, are we!? Finish them quickly!"
msgstr "Скрытность — не ваш конек, да!? Быстро прикончите их!"

#. ja: よし、首尾よく、主門までたどり着けたな……。<br>俺が門番を始末する……待機しておいてくれ。
#. de: Da ist das Tor. Momentchen, ich kümmere mich um die Wache<nbsp>...
#. fr: Et voilà<nbsp>! Nous y sommes presque... Laissez-moi me charger de la sentinelle<nbsp>!
msgctxt "InstanceContentTextData:17010:0:0"
msgid "Here we are... Ah, one more sentry. Give me a moment."
msgstr "Вот и добрались... А, еще один часовой. Дайте минуту."

#. ja: ヒヤヒヤしたが、どうにか主門までたどり着けたな……。<br>俺が門番を始末する……待機しておいてくれ。
#. de: Puh! Das hat Nerven gekostet, aber wir sind am Tor. Wartet hier, ich kümmere mich um die Wache<nbsp>...
#. fr: Eh bien, j'aurais préféré avancer plus dis<shy>crè<shy>te<shy>ment, mais nous y sommes presque. Laissez-moi me charger de la sentinelle<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:17011:0:0"
msgid "Rather more eventful than I expected, but here we are...<br>Ah, one more sentry. Give me a moment."
msgstr "Путь оказался куда опаснее, чем я думал, но мы на месте...<br>А, еще один часовой. Дайте минуту."

#. ja: よし、上出来だ！<br>聞こえるか、アルフィノ……主門を開くぞ！
#. de: Sehr gut! Achtung, Alphinaud - wir öffnen das Tor!
#. fr: Mission réussie<nbsp>!<nbsp>...<br>Alphinaud<nbsp>?<nbsp>... Oui, c'est nous. Nous allons déverrouiller la grande porte<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:17012:0:0"
msgid "Hells open, heavens weep...<br>Alphinaud, can you hear me? The gates are open!"
msgstr "К чертям врата, пусть небеса содрогнутся...<br>Альфино, слышишь меня? Ворота открыты!"

#. ja: 突撃、突撃～ッ！<br>ガレマール帝国軍から民衆を解放するのだッ！
#. de: Attacke! Befreit die Stadt von den Garlearn!
#. fr: À l'attaque<nbsp>! Libérez les habitants<nbsp>!
msgctxt "InstanceContentTextData:17013:0:0"
msgid "Remember the Reach! Remember the towers! Attack!"
msgstr "Вспомните Рич! Вспомните башни! В атаку!"

#. ja: さすがの手並みだ！<br>この混乱に乗じて、我々はクルルさんの救出に向かおう！
#. de: Sehr schön. In diesem Chaos können wir uns Krile unbemerkt annähern.
#. fr: Bien, profitons de la confusion pour nous diriger vers l'endroit où Krile est retenue<nbsp>!
msgctxt "InstanceContentTextData:17014:0:0"
msgid "Our friends are ready and eager to engage the imperials!"
msgstr "Наши друзья уже готовы схватиться с имперцами!"

#. ja: クルルが監禁されている研究所までは、<br>俺が案内する……敵を蹴散らしながら進むぞ！
#. de: Ich führe euch zu dem For<shy>schungs<shy>labor. Lasst euch unterwegs nicht umbringen!
#. fr: Je vais vous montrer le chemin jusqu'au laboratoire où elle se trouve<nbsp>!
msgctxt "InstanceContentTextData:17015:0:0"
msgid "Then let us leave them to it and head for the facility!"
msgstr "Оставим их разбираться самим и отправимся к комплексу!"

#. ja: バカな……アラミゴ解放軍だとッ！？<br>ええい、迎撃だ……迎え撃て！！
#. de: Ala Mhigo befreien wollt ihr? Hah! Diese Frechheit werdet ihr büßen!
#. fr: L'armée de libération mhigoise<nbsp>!? Tuez-les<nbsp>! Tuez-les tous<nbsp>!!
msgctxt "InstanceContentTextData:17016:0:0"
msgid "Insurgents!? Here!? Sound the alarum!"
msgstr "Мятежники!? Здесь!? Бей тревогу!"

#. ja: 抵抗するなら、容赦はしないッ！
#. de: Wer Widerstand leistet, wird niedergemetzelt!
#. fr: Pas de pitié<nbsp>! S'ils résistent, abattez-les<nbsp>!
msgctxt "InstanceContentTextData:17017:0:0"
msgid "We don't have time for this! Put them down!"
msgstr "Нам некогда возиться! Прикончите их!"

#. ja: クルルさん……待っていてください！<br>今、助けに行きますッ！
#. de: Halt durch, Krile. Nur noch ein kleines bisschen.
#. fr: Tiens bon, Krile<nbsp>! Nous arrivons<nbsp>!
msgctxt "InstanceContentTextData:17018:0:0"
msgid "Hold on, Krile... We're coming..."
msgstr "Держись, Крил... Мы идем..."

#. ja: 研究所は、この先だ！
#. de: Dort ist das Labor!
#. fr: Le laboratoire est par là<nbsp>!
msgctxt "InstanceContentTextData:17019:0:0"
msgid "The Resonatorium is just ahead!"
msgstr "Резонаторий уже близко!"

#. ja: よし、突入するぞ！<br>一気に制圧して、クルルさんを助け出すんだ！
#. de: Wir stürmen hinein und überwältigen sie. Alle bereit?
#. fr: Prêts<nbsp>? Une fois à l'intérieur, nous devons sécuriser les lieux et retrouver notre amie<nbsp>!
msgctxt "InstanceContentTextData:17020:0:0"
msgid "They know we're coming. Make ready, my friends!"
msgstr "Они знают, что мы идем. Приготовьтесь, друзья!"

#. ja: 視える……視えるぞ！<br>貴様らの手の内が、過去が視えるッ！
#. de: Mir bleibt nichts verborgen!
#. fr: Je devine tous les coups<nbsp>!
msgctxt "InstanceContentTextData:17021:0:0"
msgid "I can read your every move!"
msgstr "Я вижу все ваши движения!"

#. ja: <split " " 1><string $gs1></split>、<br>「エーテルジャマー」を使うんだ！
#. de: <split " " 1><string $gs1></split>, benutz den Äther-Siphon!
#. fr: Le brouilleur d'éther, <split " " 1><string $gs1></split><nbsp>! Maintenant<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:17022:0:0"
msgid "Use the siphon, <split \" \" 1><string $gs1></split>! Use it now!"
msgstr "Используй сифон, <split \" \" 1><string $gs1></split>! Немедленно!"

#. ja: うああッ！？<br>あ、頭が……貴様、いったい何をしたッ……！！
#. de: Ahrg ... Mein Kopf! Was ist das für ein Trick?
#. fr: Aarrrgh<nbsp>! Ma tête... Cette douleur<nbsp>!<nbsp>...
msgctxt "InstanceContentTextData:17023:0:0"
msgid "Gah! Seven hells, my head... The pain!"
msgstr "А-а! Семь адов, голова... Какая боль!"

#. ja: ウリエンジェの秘策とやらが効いたようだな！<br>一気に、畳みかけるぞッ！
#. de: Uriangers Gerät scheint zu wirken! Auf sie!
#. fr: Ça marche<nbsp>! Fordola est affaiblie<nbsp>!
msgctxt "InstanceContentTextData:17024:0:0"
msgid "It's working! Strike now, while she's weak!"
msgstr "Работает! Нападайте, пока она ослабла!"

#. ja: 私の邪魔をするなッ！<br>「超越者」たる力で、貴様らなど超えてみせるッ！
#. de: Keiner tritt mich mit Füßen!
#. fr: Personne ne m'arrêtera<nbsp>!<nbsp>...
msgctxt "InstanceContentTextData:17025:0:0"
msgid "Out of my way!"
msgstr "С дороги!"

#. ja: フォルドラが立ち直ったみたい……！<br>もう一度、「エーテルジャマー」を使って！
#. de: Sie hat sich wieder erholt! Versuch es noch einmal mit dem Äther-Siphon!
#. fr: Merde<nbsp>! Elle s'est relevée<nbsp>! Il faut utiliser le brouilleur d'éther encore une fois<nbsp>!
msgctxt "InstanceContentTextData:17026:0:0"
msgid "Dammit, she won't stay down! Use the siphon again!"
msgstr "Проклятье, она не сдается! Используй сифон еще раз!"

#. ja: ぐっ……く、くそッ……こんなもので……！！
#. de: Gnh ... Verflucht! ... Ihr ...!
#. fr: Euuuaaarggh<nbsp>!<nbsp>... Vous allez me le payer<nbsp>!<nbsp>...
msgctxt "InstanceContentTextData:17027:0:0"
msgid "Graaagh! You'll...you'll pay for that..."
msgstr "Гр-р... Вы... вы за это заплатите..."

#. ja: いいぞ、あの妙な力を封じているッ！
#. de: Sehr gut! Sie kann ihre Kräfte nicht einsetzen!
#. fr: On l'a presque eu<nbsp>! Encore un petit effort<nbsp>!
msgctxt "InstanceContentTextData:17028:0:0"
msgid "Keep at it! We almost have her!"
msgstr "Не останавливайтесь! Мы почти ее одолели!"

#. ja: くっ、増援のお出ましか……！<br>サンクレッド、我々で食い止めるぞ！
#. de: Oh nein, Verstärkung! Thancred, halten wir sie auf!
#. fr: Mince<nbsp>! Des renforts<nbsp>!<nbsp>... Thancred, occupons-nous-en<nbsp>!
msgctxt "InstanceContentTextData:17029:0:0"
msgid "Thancred! Help me hold off those soldiers!"
msgstr "Танкрет! Помоги мне задержать солдат!"

#. ja: 了解だ、アルフィノ！<br><split " " 1><string $gs1></split>、リセ、そっちは任せたぞ！
#. de: Wird gemacht! Lyse, <split " " 1><string $gs1></split> - ihr kommt zurecht, ja?
#. fr: D'accord, Alphinaud<nbsp>!<nbsp>... <split " " 1><string $gs1></split>, Lyse, concentrez-vous sur Fordola<nbsp>!
msgctxt "InstanceContentTextData:17030:0:0"
msgid "Understood! We leave the pilus in your capable hands!"
msgstr "Понял! Пилус на вас!"

#. ja: 私は……私は負けるわけにはいかないのだッ！<br>私たちの自由のためにッ！
#. de: Ich darf nicht unterliegen! Unsere Freiheit steht auf dem Spiel!
#. fr: Hé hé hé<nbsp>! Je ne peux pas perdre<nbsp>! Je me bats pour la liberté de tous<nbsp>!
msgctxt "InstanceContentTextData:17031:0:0"
msgid "Heh heh heh... So it's to be the two of you after all..."
msgstr "Хе-хе-хе... Значит, все-таки вы вдвоем..."

#. ja: フォルドラ！！<br>この拳で、勝負を決めるッ！
#. de: Spür meine Fäuste!
#. fr: La victoire est à moi<nbsp>!
msgctxt "InstanceContentTextData:17032:0:0"
msgid "Let's finish this!"
msgstr "Покончим с этим!"

#. ja: やらせるものか！　新たな力があれば……！
#. de: Neue Kräfte!
#. fr: J'ai un tel pouvoir<nbsp>!
msgctxt "InstanceContentTextData:17033:0:0"
msgid "If only you knew the power!"
msgstr "Если бы только вы знали, какая у меня сила!"

#. ja: 見切られた！？<br>アタシのとっておきなのにッ！
#. de: Wie konntest du das vorhersehen?!
#. fr: Elle m'a esquivée<nbsp>! C'était pourtant ma botte secrète...
msgctxt "InstanceContentTextData:17034:0:0"
msgid "How much more can she take!?"
msgstr "Сколько же она еще выдержит!?"

#. ja: フン、「超越者」たる力があれば、<br>その程度の攻撃など、当たるものかッ！
#. de: Pah, für so eine Attacke brauche ich nicht mal besondere Kräfte!
#. fr: Idiote<nbsp>! Tes attaques pathétiques sont trop prévisibles<nbsp>!
msgctxt "InstanceContentTextData:17035:0:0"
msgid "Everything you've got and more, you stupid cow!"
msgstr "И это все, на что вы способны, тупые коровы!?"

#. ja: グハッ……負けるというのか……。<br>いや……私は……私は…………。
#. de: Ich ... Ich ... darf nicht unterliegen! Nicht gegen dich!
#. fr: Gouaaargh... Non... je ne peux pas... perdre...
msgctxt "InstanceContentTextData:17036:0:0"
msgid "Not here, not now... Not to you..."
msgstr "Не здесь, не сейчас... Только не от вас..."

#. ja: <split " " 1><string $gs1></split>、「開閉装置」を探すんだ！<br>背後は、俺たちが警戒しておく！
#. de: <split " " 1><string $gs1></split>, such den Hebel für das Tor! Ich halt dir den Rücken frei!
#. fr: <split " " 1><string $gs1></split>, le dispositif d'ouverture ne devrait pas être loin<nbsp>! Trouvez-le pendant que nous montons la garde<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:17037:0:0"
msgid "<split \" \" 1><string $gs1></split>, look for a lever or a winch!<br>We will guard the rear!"
msgstr "<split \" \" 1><string $gs1></split>, поищи рычаг или лебедку!<br>Мы прикроем тыл!"

#. ja: ここにまで侵入者が……！？<br>ええい、フォルドラ様を援護するのだッ！
#. de: Eindringlinge! Schützt Kommandantin Fordola!
#. fr: Des ennemis se sont infiltrés<nbsp>! La commandante est aux prises avec eux<nbsp>! Allons l'aider<nbsp>!
msgctxt "InstanceContentTextData:17038:0:0"
msgid "Enemy sighted, engaged with the commander! With me!"
msgstr "Враги замечены, схватка с командиром! За мной!"

#. ja: まだ、あの力を使うつもりなの！？<br>「エーテルジャマー」で封じて、<split " " 1><string $gs1></split>！
#. de: Sie will ihre Kräfte wieder einsetzen! Schnell, <split " " 1><string $gs1></split>, den Äther-Siphon!
#. fr: Elle va encore utiliser son pouvoir<nbsp>! Vite, le brouilleur d'éther, <split " " 1><string $gs1></split><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:17039:0:0"
msgid "Still got that siphon, <split \" \" 1><string $gs1></split>!? Then use it!"
msgstr "Сифон еще при тебе, <split \" \" 1><string $gs1></split>!? Тогда используй его!"

#. ja: それじゃあ、楽しいお仕置きの時間だ！<br>ンン～、楽しませておくれヨォ～？
#. de: Das Spiel beginnt! Und <i>ihr</i> werdet es nicht gewinnen!
#. fr: Que le spectacle commence<nbsp>! Attention, tu risques de ne pas aimer la fin, hé hé...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:17100:0:0"
msgid "Let the show begin! And it <i>won't</i> be a happy ending for you."
msgstr "Пусть представление начнется! И финал для вас будет <i>печальным</i>."

#. ja: 本流の忍術というもの、とくと味わうがいい！
#. de: Wir sind die einzig wahren Ninja!
#. fr: Vous n'êtes pas dignes de la tradition des ninja<nbsp>!
msgctxt "InstanceContentTextData:17101:0:0"
msgid "You are not worthy of calling yourself shinobi."
msgstr "Ты недостоин называться синоби."

#. ja: 我が影隠一族の「分身の術」を見せてやろう！
#. de: Jetzt lernst du die Techniken des Kagekakushi-Clans kennen.
#. fr: Essayez un peu de deviner où je suis<nbsp>!
msgctxt "InstanceContentTextData:17102:0:0"
msgid "You cannot strike what you cannot see!"
msgstr "Не ударить того, кого не видишь!"

#. ja: 我が「変化の術」は、人に変化するだけではない。<br>さあ……凍てつかせてやるぞ！
#. de: Das Verwandelte Ich kommt in vielen Formen ... Ich frier dich ein!
#. fr: Il n'y a pas qu'en humain que je sais me transformer... Tremblez devant ma puissance<nbsp>!
msgctxt "InstanceContentTextData:17103:0:0"
msgid "Quiver in fear before my might!"
msgstr "Трепещите перед моей мощью!"

#. ja: 抜け忍にしてはやるではないか……<br>さすれば、真なる「分身の術」を見るがいい！
#. de: Mein Doppeltes Ich ist besser als dein Doppeltes Ich!
#. fr: Vous appelez ça du ninjutsu<nbsp>? Contemplez la seule et unique technique véritable<nbsp>!
msgctxt "InstanceContentTextData:17104:0:0"
msgid "You call that ninjutsu? Witness the true skill of a master!"
msgstr "Это ты называешь ниндзюцу? Узри искусство истинного мастера!"

#. ja: しぶとい雑魚どもめ……<br>かくなるうえは、この十二代目ハンゾウの秘術で死ぬがいい！
#. de: Stirb! Hanzo XII. befiehlt es dir!
#. fr: Grrr, c'est qu'ils sont tenaces... Vous ne me laissez pas le choix<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:17105:0:0"
msgid "Gah! Just <i>die</i> already, you unworthy mongrels!"
msgstr "Гр-р! Да <i>сдохните</i> уже, жалкие шавки!"

#. ja: ま、まさか……この私が……抜け忍ごときに……。
#. de: Ich unterliege <i>Abtrünnigen</i>?
#. fr: Moi, Hanzo 12e du nom... défait par ces insectes...
msgctxt "InstanceContentTextData:17106:0:0"
msgid "Ngh! I cannot fail...to the likes of...you..."
msgstr "Н-не может быть... Я проиграл... таким, как вы..."

#. ja: こ、こんな筋書きじゃなかったんだけど、ネェ……。
#. de: Ist das das Ende der Geschichte?
#. fr: Oups, ce n'est pas ce que j'avais prévu...
msgctxt "InstanceContentTextData:17107:0:0"
msgid "Urk! This wasn't...in the...script..."
msgstr "Уф... Все пошло... не по сценарию..."

#. ja: ハンゾウを倒せ！
#. de: Besiege Hanzo!
#. fr: Venez à bout de Hanzo<nbsp>!
msgctxt "InstanceContentTextData:17108:0:0"
msgid "Defeat Hanzo!"
msgstr "Победите Хандзо!"

#. ja: ハンゾウの本体を探して倒せ！
#. de: Finde den echten Hanzo und besiege ihn!
#. fr: Trouvez le véritable Hanzo et vainquez-le<nbsp>!
msgctxt "InstanceContentTextData:17109:0:0"
msgid "See through Hanzo's illusions and defeat him!"
msgstr "Разоблачите иллюзии Хандзо и победите его!"

#. ja: いざ舞え、踊れ！　祭りである！<br>神前たれども無礼を許す……武器を取れい！
#. de: Kommt, lasst uns singen und tanzen!
#. fr: Dansez maintenant... La fête commence<nbsp>!
msgctxt "InstanceContentTextData:17200:0:0"
msgid "Let the revels begin!"
msgstr "Пусть начнется веселье!"

#. ja: カッカッカッ、興が乗ったわ！<br>アメノムラクモの真なる姿、見せてくれよう！
#. de: Jahaha! Weiter so!
#. fr: HA HA, HA<nbsp>! Je m'amuse comme un fou<nbsp>!
msgctxt "InstanceContentTextData:17201:0:0"
msgid "How our hearts sing in the chaos!"
msgstr "Как же сладко сердце поет в разгаре битвы!"

#. ja: 真の荒魂とは、斯様なものよッ！
#. de: Ich bin wild! Und frei!
#. fr: Tempétueux et libre pour toujours<nbsp>!
msgctxt "InstanceContentTextData:17202:0:0"
msgid "Wild and pure and forever free!"
msgstr "Дик и свободен — навеки!"

#. ja: フンヌアァァァァ！
#. de: Uohhh!
#. fr: MOUAAAAAAH<nbsp>!
msgctxt "InstanceContentTextData:17203:0:0"
msgid "REJOICE!"
msgstr "ЛИКУЙТЕ!"

#. ja: 凌いだか！　いや見事なり！
#. de: Oh! Ihr steht noch!
#. fr: Ho ho<nbsp>! Quelle résistance<nbsp>! Bravo<nbsp>!
msgctxt "InstanceContentTextData:17204:0:0"
msgid "Resilient souls! I salute you!"
msgstr "Несгибаемые души! Снимаю перед вами шляпу!"

#. ja: 八雲立ち、雷よ降らん！
#. de: Donnergroll und Blitzgewitter!
#. fr: Que se déchaînent les cieux<nbsp>!
msgctxt "InstanceContentTextData:17205:0:0"
msgid "Hark you to the tumultuous heavens!"
msgstr "Внемлите грохоту небес!"

#. ja: 踊れ踊れ！　乗り遅れるなよ！
#. de: Feiert! Frohlocket! Zeigt keine Müdigkeit!
#. fr: Allez<nbsp>! Allez<nbsp>! Allez<nbsp>! À mon tour<nbsp>!
msgctxt "InstanceContentTextData:17206:0:0"
msgid "Now cometh our part! Make way!"
msgstr "Теперь наша очередь! Дорогу!"

#. ja: そぉら、閉じよ籠れよ！<br>これぞ世に云う、岩戸隠れというヤツぞ！
#. de: Gefangen sollt ihr sein!
#. fr: Que s'agrègent les rocs<nbsp>!
msgctxt "InstanceContentTextData:17207:0:0"
msgid "Earth and stone at our beck and call!"
msgstr "Земля и камень нам подвластны!"

#. ja: 海原よ、吹け！<br>これより、海さえも割ってやろうぞ！
#. de: Kraft des Meeres!
#. fr: Que rugisse l'océan<nbsp>!
msgctxt "InstanceContentTextData:17208:0:0"
msgid "The seas part for we alone!"
msgstr "Моря расступятся лишь перед нами!"

#. ja: 帝国兵の排除
#. de: Die garleischen Soldaten beseitigen
#. fr: Éliminer les soldats impériaux
msgctxt "InstanceContentTextData:17300:0:0"
msgid "Eliminate the imperials"
msgstr "Уничтожьте имперцев"

#. ja: ガードスコーピオンの撃破
#. de: Den Wachskorpion besiegen
#. fr: Vaincre le scorpion magitek
msgctxt "InstanceContentTextData:17301:0:0"
msgid "Defeat the magitek scorpion"
msgstr "Победите магитех-скорпиона"

#. ja: 障害の排除
#. de: Alle Hindernisse beseitigen
#. fr: Éliminer tous les obstacles
msgctxt "InstanceContentTextData:17302:0:0"
msgid "Eliminate all obstacles"
msgstr "Устраните все препятствия"

#. ja: アウルス・マル・アシナの撃破
#. de: Aulus mal Asina besiegen
#. fr: Vaincre Aulus mal Asina
msgctxt "InstanceContentTextData:17303:0:0"
msgid "Slay Aulus mal Asina"
msgstr "Убейте Аулуса мал Асину"

#. ja: 鷲獅子の間への到達
#. de: Zur Halle des Greifen durchschlagen
#. fr: Atteindre la salle du Griffon
msgctxt "InstanceContentTextData:17304:0:0"
msgid "Arrive in the Hall of the Griffin"
msgstr "Доберитесь до Зала Грифона"

#. ja: 記録開始……これより実戦テストに着手する……。
#. de: Testsubjekt im Visier!
#. fr: Début du test expérimental...
msgctxt "InstanceContentTextData:17305:0:0"
msgid "Recording subject's performance..."
msgstr "Запись показателей испытуемого..."

#. ja: 研究の成果を披露しよう。
#. de: Zittere vor der Wissenschaft!
#. fr: Je dois publier mes résultats<nbsp>!
msgctxt "InstanceContentTextData:17306:0:0"
msgid "I shall have to share these findings..."
msgstr "Надо будет поделиться этими результатами..."

#. ja: では、実験開始だ……魂を分離する！
#. de: Seelenäther-Extraktion!
#. fr: Extraction de l'âme<nbsp>!
msgctxt "InstanceContentTextData:17307:0:0"
msgid "Initiate soul extraction!"
msgstr "Начать извлечение души!"

#. ja: ククク……実験成功だ！<br>すばらしい、すばらしいぞ……！
#. de: Hah, ein voller Erfolg!
#. fr: Ah<nbsp>!<nbsp>... Expérience réussie<nbsp>!
msgctxt "InstanceContentTextData:17308:0:0"
msgid "Hah! Success!"
msgstr "Ха! Успех!"

#. ja: なんと、肉体に魂が！？<br>馬鹿な、完全に分離させたはずだぞ！
#. de: Wie? Die Seele kehrt zurück?
#. fr: Oh, non<nbsp>! L'âme est revenue<nbsp>!
msgctxt "InstanceContentTextData:17309:0:0"
msgid "The soul rebels!?"
msgstr "Душа сопротивляется!?"

#. ja: こんなはずでは……。
#. de: Das ... kann nicht sein!
#. fr: N-non... c'est.. trop injuste...
msgctxt "InstanceContentTextData:17310:0:0"
msgid "Impossible...incredible!"
msgstr "Невероятно... Вот это да!"

#. ja: まさかここまで来るとはな……。<br>いや、そうでなければ、愉しみがないというものだ。
#. de: Na endlich ... Ich hatte schon angefangen, mich zu langweilen!
#. fr: Oh, quelle surprise... Mais c'est tant mieux car je commençais à mourir lit<shy>té<shy>ra<shy>le<shy>ment d'ennui.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:17311:0:0"
msgid "Like a moth to the flame...<br>But why else would you come, if not for this?"
msgstr "Как мотылек на пламя...<br>Но зачем еще сюда приходить, если не ради этого?"

#. ja: 見せてみろ、貴様の力を……！
#. de: Nun zeig, was du kannst!
#. fr: Montrez-moi votre force...
msgctxt "InstanceContentTextData:17312:0:0"
msgid "Show me your all..."
msgstr "Покажи, на что способен..."

#. ja: まだだ……まだ、斃れてくれるなよ？
#. de: Nicht aufgeben, Freunde!
#. fr: Faites-moi plaisir... Mourez<nbsp>!
msgctxt "InstanceContentTextData:17313:0:0"
msgid "Have you the strength?"
msgstr "Хватит ли у тебя сил?"

#. ja: 見せてやろう、超越者たる力を……！
#. de: Die alles übersteigende Kraft!
#. fr: Ma puissance transcende tout...
msgctxt "InstanceContentTextData:17314:0:0"
msgid "The power...to transcend..."
msgstr "Сила... превосходящая пределы..."

#. ja: 久々に愉しい戦だ……！
#. de: Aaah, wie unterhaltsam!
#. fr: Quelle chasse mémorable...
msgctxt "InstanceContentTextData:17315:0:0"
msgid "Let this moment last forever..."
msgstr "Пусть это мгновение длится вечно..."

#. ja: 敵戦力が予測値を……馬鹿な！？
#. de: Niederlage imminent?!
#. fr: Quelle force... C'est impossible<nbsp>!
msgctxt "InstanceContentTextData:17316:0:0"
msgid "My word, this data..."
msgstr "Вот это данные..."

#. ja: ほう、耐えてみせたか……！<br>そうでなくてはなァッ……！
#. de: Du konntest standhalten ... Beeindruckend!
#. fr: Im<shy>pres<shy>sionnant<nbsp>! C'est cette force, cette agressivité que j'admire par-dessus tout<nbsp>!
msgctxt "InstanceContentTextData:17317:0:0"
msgid "How glorious the violence within you..."
msgstr "Как прекрасна скрытая в вас ярость..."

#. ja: 被検世界デルタを目指せ！
#. de: Schlag dich zur Deltametrie durch!
#. fr: Atteignez le Deltastice<nbsp>!
msgctxt "InstanceContentTextData:17400:0:0"
msgid "Reach the Deltascape"
msgstr "Доберитесь до Дельтаскейпа"

#. ja: ポイントIIを突破しろ！
#. de: Sichere Testebene II!
#. fr: Franchissez la deuxième épreuve<nbsp>!
msgctxt "InstanceContentTextData:17401:0:0"
msgid "Clear Point II"
msgstr "Пройдите точку II"

#. ja: ポイントIIIを突破しろ！
#. de: Sichere Testebene III!
#. fr: Franchissez la troisième épreuve<nbsp>!
msgctxt "InstanceContentTextData:17402:0:0"
msgid "Clear Point III"
msgstr "Пройдите точку III"

#. ja: <split " " 1><string $gs1></split>、戦闘ではお前にあわせる。<br>様子を見て仕掛けてくれ！
#. de: <split " " 1><string $gs1></split>, wir richten uns nach dir! Führ die Attacke!
#. fr: <split " " 1><string $gs1></split>, à toi l'honneur d'ouvrir les hostilités<nbsp>! Sois <if $gn4>prudente<else>prudent</if><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:17403:0:0"
msgid "Take the lead, <split \" \" 1><string $gs1></split>. We'll follow."
msgstr "Веди, <split \" \" 1><string $gs1></split>. Мы за тобой."

#. ja: 攻撃が効いていない……！？<br>厄介なバリアを張っているらしいな。
#. de: Das Ding nimmt keinen Schaden ... Es ist von einer Barriere geschützt!
#. fr: C'est peine perdue... On dirait qu'il est protégé par une barrière spéciale.
msgctxt "InstanceContentTextData:17404:0:0"
msgid "No good. It's protected by some kind of barrier."
msgstr "Не выйдет. Похоже, его защищает какая-то барьерная магия."

#. ja: そういうことなら、オイラの出番ッス！<br>バリアの解除を試みるッス！
#. de: Dann sind wir an der Reihe! Barrieren deaktivieren ist mein Spezialgebiet!
#. fr: Ça, c'est un boulot pour super Wedge<nbsp>! Laissez-moi faire, je vais vous désactiver cette barrière en moins de deux<nbsp>!
msgctxt "InstanceContentTextData:17406:0:0"
msgid "Ooh, barriers are my specialty! I'll have this down before you know it!"
msgstr "О, барьеры — моя стихия! И глазом моргнуть не успеете, как я с ним разберусь!"

#. ja: 親方、さっきのブロックに変化が！
#. de: Chef, der Kubus verändert sich irgendwie ...
#. fr: P-Patron, c-c'est moi ou le cube a bougé<nbsp>!?
msgctxt "InstanceContentTextData:17408:0:0"
msgid "Chief, something's happening with the cube!"
msgstr "Шеф, с кубом что-то происходит!"

#. ja: ほう、出やがったな！<br>あのブロックは、時間経過で敵性生物になるらしい。
#. de: Eine langsam erwachende Lebensform! Und zwar eine feindselige!
#. fr: Je vois... Passé un certain temps, le cube se métamorphose en ennemi belliqueux. C'est fascinant...
msgctxt "InstanceContentTextData:17409:0:0"
msgid "Oho, so it changes into a life-form, and a hostile one at that."
msgstr "Ого, вот он и превратился в живое существо. Да еще и враждебное."

#. ja: <split " " 1><string $gs1></split>と俺たちで、魔獣を撃退だ！<br>ウェッジは解析を続行、ビッグスはその護衛を！
#. de: Wedge, kümmere dich um die Barriere! Biggs, halt ihm den Rücken frei! Wir anderen über<shy>nehmen den Angreifer.
#. fr: <split " " 1><string $gs1></split>, à l'attaque<nbsp>! Wedge, finis ce que tu es en train de faire<nbsp>! Biggs, protège-le pendant qu'il bidouille<nbsp>!
msgctxt "InstanceContentTextData:17410:0:0"
msgid "We'll see to the creature! Wedge, keep at the barrier! Biggs, watch his back!"
msgstr "Мы разберемся с чудищем! Ведж, продолжай заниматься барьером! Биггс, прикрой его!"

#. ja: またブロックか……！<br>まさか、レベルチェッカーを倒すまで続くってか？
#. de: Noch so ein Würfel. Kommen immer mehr nach, solange wir den Monitor nicht vernichtet haben?
#. fr: Encore un cube... J'ai comme l'impression qu'il en apparaîtra tant qu'on n'aura pas détruit le vérifiniveau...
msgctxt "InstanceContentTextData:17411:0:0"
msgid "Another one! It seems they'll continue spawning so long as the monitor is operational."
msgstr "Еще один! Похоже, они будут появляться, пока работает наблюдатель."

#. ja: レベルチェッカー、停止したッス！<br>バリアを形成してた力を、逆流させてやったッス！
#. de: Der Monitor ist hinüber! Ich hab die Energie für die Barriere in das Ding zurückgeleitet, hehe!
#. fr: Et boum<nbsp>! J'ai inversé l'énergie de la barrière pour court-circuiter le vérifiniveau. Je l'ai fait griller<nbsp>!
msgctxt "InstanceContentTextData:17414:0:0"
msgid "Hah, it's out of commission! The trick is to reverse the barrier's energy current!"
msgstr "Ха, наблюдатель выведен из строя! Нужно было лишь пустить энергию барьера вспять!"

#. ja: でかしたぞ、ウェッジ！<br>あとは魔獣を倒せば……！
#. de: Gut gemacht, Wedge!
#. fr: Beau boulot, Wedge<nbsp>! Il n'y a plus qu'à faire le ménage...
msgctxt "InstanceContentTextData:17415:0:0"
msgid "Well done, Wedge! That leaves just the enemy!"
msgstr "Молодец, Ведж! Осталось только разобраться с чудищем!"

#. ja: 親方、2個目のブロックが変化しそうだ！
#. de: Chef, der zweite Kubus verändert sich!
#. fr: Patron, le deuxième bloc est sur le point de se transformer<nbsp>!
msgctxt "InstanceContentTextData:17418:0:0"
msgid "Chief, the second cube's about to turn!"
msgstr "Шеф, второй куб вот-вот преобразится!"

#. ja: 上等だ、こいつを倒して先に進むぞ！
#. de: Sehr gut. Schaffen wir den hier aus dem Weg und dann nichts wie weiter!
#. fr: On ne va pas s'éterniser ici... Réglons-lui vite son compte et continuons d'avancer<nbsp>!
msgctxt "InstanceContentTextData:17419:0:0"
msgid "Let's finish it quickly and be on our way."
msgstr "Покончили бы с ним поскорее и двинули дальше."

#. ja: 同じ対処法を試してみるか……。<br>レベルチェッカーは、ウェッジたちに任せる。
#. de: Versuchen wir's noch mal. Wedge, übernimm den Monitor!
#. fr: Rebelote... Biggs, Wedge, vous savez ce qu'il vous reste à faire.
msgctxt "InstanceContentTextData:17420:0:0"
msgid "Right, the same approach as before. Wedge and Biggs, the monitor is yours."
msgstr "Ладно, повторим то же самое. Ведж, Биггс, наблюдатель на вас."

#. ja: 残りは魔獣に応戦だ。<br><split " " 1><string $gs1></split>、仕掛けるタイミングは任せたぞ！
#. de: Jetzt müssen wir nur noch diese hier besiegen. <split " " 1><string $gs1></split>, übernimm die Führung!
#. fr: <split " " 1><string $gs1></split>, ça va chauffer... On y va dès que tu es <if $gn4>prête<else>prêt</if>.
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:17421:0:0"
msgid "The rest of us will tend to the enemy. Whenever you're ready, <split \" \" 1><string $gs1></split>."
msgstr "Остальные займемся чудищем. Как будешь готов, <split \" \" 1><string $gs1></split>."

#. ja: みんな気をつけろ、ブロックが変化するぞ！
#. de: Aufgepasst! Da erwacht schon wieder ein Würfel!
#. fr: Les cubes commencent à frétiller<nbsp>! Faites attention<nbsp>!
msgctxt "InstanceContentTextData:17422:0:0"
msgid "Be careful! The cubes are going to turn!"
msgstr "Осторожно! Кубы сейчас преобразятся!"

#. ja: くっ、ブロックの生成が早い……！<br>ウェッジ、急げッ！
#. de: Diese Dinger entwickeln sich einfach zu schnell. Wedge, beeil dich!
#. fr: Saperlotte, ces cubes ap<shy>pa<shy>rais<shy>sent à un rythme effréné<nbsp>! Wedge, dépêche-toi<nbsp>!
msgctxt "InstanceContentTextData:17423:0:0"
msgid "Damn, they're spawning fast! Hurry, Wedge!"
msgstr "Черт, слишком быстро появляются! Живее, Ведж!"

#. ja: やった！　レベルチェッカー、撃破ッス！<br>今日のオイラは冴えてるッス！？
#. de: Jawohl! Monitor erledigt! Heut bin ich in Form!
#. fr: Et de deux<nbsp>! J'ai la pêche aujourd'hui<nbsp>!
msgctxt "InstanceContentTextData:17424:0:0"
msgid "Another monitor down and out! Am I in form today or what!?"
msgstr "Еще один наблюдатель готов! Ну и форма у меня сегодня, а!?"

#. ja: ああ、最高だ！<br>あとは残りの魔獣を撃破するだけだ！
#. de: Gute Arbeit! Jetzt nur noch die anderen Hindernisse hier ...
#. fr: C'est toi le meilleur<nbsp>! Finissons-en avec les ennemis qui restent et allons-y<nbsp>!
msgctxt "InstanceContentTextData:17425:0:0"
msgid "That you are, Wedge! Now, give us a moment while we clean things up."
msgstr "Так и есть, Ведж! А теперь дайте нам минутку, мы тут закончим."

#. ja: 今度はビッグスも、レベルチェッカーの対応にまわってくれ。<br><split " " 1><string $gs1></split>、俺たちで魔獣を！
#. de: Biggs, du übernimmst diesmal auch einen Monitor. Wir anderen kämpfen!
#. fr: Mince, il y a deux vérifiniveaux... Biggs, Wedge, occupez-vous d'un chacun. <split " " 1><string $gs1></split> et moi, on vous couvre<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:17426:0:0"
msgid "Biggs, this time you get a monitor as well. <split \" \" 1><string $gs1></split>, you know what to do."
msgstr "Биггс, на этот раз займись тоже одним наблюдателем. <split \" \" 1><string $gs1></split>, ты знаешь, что делать."

#. ja: ったく、この模擬戦がおわったら、<br>オレにもオモチャで遊ばせろよなぁ！
#. de: Grmpf ... Wenn dieser Kampf vorbei ist, will ich aber auch mal an ein paar Maschinen schrauben!
#. fr: Hé, pourquoi je n'ai pas le droit de trifouiller ces joujoux, moi aussi<nbsp>?
msgctxt "InstanceContentTextData:17427:0:0"
msgid "Hmph, I should think I'm no less qualified to tinker with these toys."
msgstr "Хмф, уж я-то не хуже остальных умею возиться с этими игрушками."

#. ja: ……さて、来るぞ。<br>幾分か、獰猛そうな獣の気配よ。
#. de: Ich glaube, wir kriegen Besuch.<br>Und er ist nicht besonders gut gelaunt.
#. fr: Prenez garde, humains. Mon instinct me dit que cette pile de cubes dissimule une féroce créature...
msgctxt "InstanceContentTextData:17430:0:0"
msgid "Have care. I sense a formidable presence."
msgstr "Будьте осторожны. Чую могучее присутствие."

#. ja: ベヒーモスッ！？<br>くっ、みんな踏ん張るんだ！
#. de: Ein Behemoth? Na, dann spuckt mal kräftig in die Hände, Leute!
#. fr: Un béhémoth, carrément<nbsp>!? P-pas le choix, il faut lui passer sur le corps<nbsp>!
msgctxt "InstanceContentTextData:17431:0:0"
msgid "A behemoth!? We're going to have to roll up our sleeves!"
msgstr "Бегемот!? Ну что, ребята, засучим рукава!"

#. ja: なお手は抜かぬか……。<br>オメガめ、相も変わらずよ……。
#. de: Was Omega macht, macht sie gründlich.
#. fr: Fidèle à elle-même, Oméga ne fait pas dans la demi-mesure...
msgctxt "InstanceContentTextData:17432:0:0"
msgid "Never one for half measures...eh, Omega?"
msgstr "Омега никогда не делает ничего вполсилы... Да, Омега?"

#. ja: や、やったッスー！<br>こっちのレベルチェッカー、撃破ッス！
#. de: Ha! Der Monitor wäre unschädlich gemacht!
#. fr: Et voilà le travail<nbsp>! J'en ai terminé avec mon vérifiniveau<nbsp>!
msgctxt "InstanceContentTextData:17433:0:0"
msgid "Haha, yes! My monitor's down!"
msgstr "Ха-ха, есть! Мой монитор готов!"

#. ja: 俺の方もバッチリだ！<br>これで増援はなくなったはず！
#. de: Ich bin auch fertig! Jetzt ist Schluss mit Nachschub!
#. fr: ... Et moi de même<nbsp>! Voilà qui devrait mettre fin à la pluie de cubes.
msgctxt "InstanceContentTextData:17434:0:0"
msgid "Mine too! That should take care of the cubes!"
msgstr "И у меня всё! Теперь кубы больше не будут появляться!"

#. ja: ふたりとも、よくやった！<br><split " " 1><string $gs1></split>、ネロ、あと一押しだ！
#. de: Gute Arbeit, Jungs!<br><split " " 1><string $gs1></split>, Nero, gleich haben wir's!
#. fr: Bravo les gars<nbsp>! <split " " 1><string $gs1></split>, Nero, encore un petit effort<nbsp>! On en voit le bout<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:17435:0:0"
msgid "Great work, you two! <split \" \" 1><string $gs1></split>, Nero─just a little further!"
msgstr "Отличная работа, вы двое! <split \" \" 1><string $gs1></split>, Неро, ещё немного!"

#. ja: ぐっ……すまない、しくじった…………。
#. de: Verzeiht mir<nbsp>... Ich hab's<nbsp>... vermasselt.
#. fr: Argh... Je me suis mal débrouillé...
msgctxt "InstanceContentTextData:17436:0:0"
msgid "Godsdammit... I messed up..."
msgstr "Чёрт... Всё испортил..."

#. ja: グハッ……！<br>悪い、やっぱり戦闘は…………。
#. de: Aah<nbsp>... Nehmt es mir nicht übel<nbsp>...
#. fr: Aïe aïe aïe... Désolé, je suis vraiment un piètre combattant...
msgctxt "InstanceContentTextData:17437:0:0"
msgid "Gah... I was out of my depth..."
msgstr "А-а... Не моё это — драться..."

#. ja: うう……オイラだって、やらなきゃいけないのに…………。
#. de: Ich wurde<nbsp>... besiegt<nbsp>...
#. fr: Oh non... Pas pendant mon moment de gloire...
msgctxt "InstanceContentTextData:17438:0:0"
msgid "Nooo... Still so much to do..."
msgstr "Нееет... Столько ещё нужно сделать..."

#. ja: チッ、甘く見すぎたぜ……。<br>オレの悪運もここまでってか…………。
#. de: Ich fürchte, ihr werdet ohne meinen Charme auskommen müssen<nbsp>...
#. fr: Eurgh, on dirait que ma chance insolente a tourné... Ça m'apprendra à être trop confiant...
msgctxt "InstanceContentTextData:17439:0:0"
msgid "My luck's run out... You'll have to manage without my wit..."
msgstr "Вот и удача отвернулась... Придётся вам обходиться без моего остроумия..."

#. ja: ほう、我が幻影を裂かれるとは……。<br>これではもはや、手を貸せぬか。
#. de: Meine Manifestation zu besiegen!<br>Du willst dich über die Götter erheben?
#. fr: Ça alors, mon avatar n'a pas fait le poids... Vous allez devoir vous passer de mon aide.
msgctxt "InstanceContentTextData:17440:0:0"
msgid "Not even mine avatar is safe... I take my leave of thee, mortal."
msgstr "Даже моё воплощение пало... Прощайте, смертные. Больше я вам не помогу."

#. ja: オオオオオオオン……！<br>ソ、ソ、ソンナニ、重力ニ抗ウナラ、飛バシテクレル！
#. de: Grrraaarrrhhh! Wenn euch die Schwerkraft so zuwider ist, dann fliegt doch!
#. fr: Blooooooorp<nbsp>! Personne ne résiste à la gravité<nbsp>! Préparez-vous à faire un vol plané<nbsp>!
msgctxt "InstanceContentTextData:17600:0:0"
msgid "Grrraaarrrghhh! You no like ground? I make you fly!"
msgstr "Грррррр! Не любите землю? Я заставлю вас летать!"

#. ja: 逃げられないよ……<br>あたしの遊技盤で、死ぬまで遊び続ける運命なのだ！
#. de: Jetzt könnt ihr mir nicht mehr entkommen!<br>Ich werde mit euch spielen, bis mir die Lust vergeht.
#. fr: Il n'y a pas d'échappatoire... Divertissez-moi jusqu'à en mourir<nbsp>!
msgctxt "InstanceContentTextData:17700:0:0"
msgid "There is no escape. You shall be a pawn in my games unto death."
msgstr "Вам не сбежать... Будете играть на моём поле до самой смерти!"

#. ja: 逃げられないよ……<br>あたしの特製遊技盤で、死ぬまで遊び続ける運命なのだ！
#. de: Jetzt könnt ihr mir nicht mehr entkommen!<br>Ich habe mir ein ganz besonderes Spiel ausgedacht.
#. fr: Il n'y a pas d'échappatoire... Divertissez-moi jusqu'à en mourir<nbsp>!
msgctxt "InstanceContentTextData:17701:0:0"
msgid "There is no escape. You shall be a pawn in my grand games unto death."
msgstr "Вам не сбежать... Будете играть на моём особом поле до самой смерти!"

#. ja: さて、盤面を入れ替えようか……！
#. de: Zeit für ein neues Spiel!
#. fr: Et si on changeait de plateau de jeu<nbsp>?
msgctxt "InstanceContentTextData:17702:0:0"
msgid "Let the board be changed!"
msgstr "А теперь сменим поле!"

#. ja: 一局目は、ここまで……<br>さあ、盤面を入れ替えようじゃないか！
#. de: Die erste Runde geht an euch!<br>Zeit für ein neues Spiel!
#. fr: La première manche est terminée. Pour la suivante, un nouveau plateau s'impose<nbsp>!
msgctxt "InstanceContentTextData:17704:0:0"
msgid "That concludes the first round. Let the board be changed!"
msgstr "Первый раунд окончен... Ну-ка, сменим поле!"

#. ja: 二局目も、切り抜けたか……<br>ならば、盤面を入れ替えるとしよう！
#. de: Auch die zweite Runde entscheidet ihr für euch?<br>Nun gut, wie ist es mit diesem Spiel?
#. fr: Vous avez survécu à la seconde manche... Votre récompense<nbsp>: un plateau de jeu tout neuf<nbsp>!
msgctxt "InstanceContentTextData:17705:0:0"
msgid "You've done well to survive the second round. But how will you fare in the next?"
msgstr "Пережили и второй раунд... Посмотрим, как вы справитесь со следующим!"

#. ja: ほう、三局目も耐え抜くとは、おもしろい！<br>よし、盤面を入れ替えるぞ！
#. de: Selbst aus der dritten Runde geht ihr als Sieger hervor!<br>Doch jetzt wird nach meinen Regeln gespielt!
#. fr: Toujours debout après trois manches<nbsp>? Intéressant... Tenez, voilà de nouvelles cases rien que pour vous<nbsp>!
msgctxt "InstanceContentTextData:17706:0:0"
msgid "Well, well, aren't you durable? But it's only a matter of time before you crumble."
msgstr "Надо же, вы выдержали и третий раунд! Забавно! Что ж, сменим поле!"

#. ja: 四局目も生き延びただと……！？<br>ええい、ならば、最終局の盤面は、こうしてくれる！
#. de: Ihr spielt nicht mit fairen Mitteln!<br>Also gut, ihr habt es so gewollt!
#. fr: Bravo, bravo<nbsp>! Je n'ai plus qu'un plateau de jeu en réserve. J'espère qu'il vous plaira<nbsp>!
msgctxt "InstanceContentTextData:17707:0:0"
msgid "Four rounds over yet you still stand!? You clearly want for a challenge, and I shall give it to you!"
msgstr "Четыре раунда позади, а вы всё ещё на ногах!? Хотите испытаний? Будет вам испытание!"

#. ja: ここはひとつ、気分を変えて……<br>死の脱出遊技でも、楽しんでみるか？
#. de: Also gut, spielen wir eine Runde Flucht vor dem Tod!
#. fr: Que diriez-vous d'une pause récréative<nbsp>? Je vous ai préparé un petit jeu qui devrait mettre vos méninges à l'épreuve.
msgctxt "InstanceContentTextData:17708:0:0"
msgid "For a change of pace, let us play...an escape game!"
msgstr "Для разнообразия сыграем... в игру на побег!"

#. ja: さあて、あたしはティータイムとさせてもらうよ……。
#. de: Ich werde mir derweil meinen Nachmittagstee gönnen.
#. fr: Je savourerai un bon thé en attendant votre retour. Si vous parvenez à revenir, bien sûr...
msgctxt "InstanceContentTextData:17709:0:0"
msgid "While you partake of the game, I shall partake of afternoon tea."
msgstr "А я пока выпью чаю..."

#. ja: それから、星の贈り物だ。<br>グズグズしていると、押しつぶされてしまうがな？
#. de: Auf euch wartet ein himmlisches Geschenk!<br>Wer zögert, der lodert!
#. fr: Une énorme météorite s'abattra bientôt sur ce plateau. Si j'étais vous, je me dépêcherais de trouver la sortie<nbsp>!
msgctxt "InstanceContentTextData:17710:0:0"
msgid "A starry gift comes for you, but you'll not wish to be around to receive it."
msgstr "Вам тут звёздный подарок приготовили. Только лучше не оставайтесь, когда он прилетит."

#. ja: しかし、これは遊技……脱出口も用意しておこう。<br>早く戻った者には、褒美を授けてやらんでもないぞ？
#. de: Doch wer schnell ist und entkommt,<br>darf sich eine Belohnung abholen ♪
#. fr: Faites assez vite et vous aurez même droit à une récompense... Promis<nbsp>!
msgctxt "InstanceContentTextData:17711:0:0"
msgid "Escape swiftly, and you may well earn a prize."
msgstr "Но это всего лишь игра, так что выход я тоже приготовила. Успеете выбраться — может, и награду получите."

#. ja: 茶を飲み終える前に、戻ってきたか……。<br>褒めて使わす、褒美を授けようぞ！
#. de: Ihr seid zurück, bevor ich meinen Tee austrinken konnte!<br>Hier die versprochene Belohnung!
#. fr: Oh, vous voilà de retour avant que j'aie fini mon thé... Comme promis, voilà votre récompense<nbsp>!
msgctxt "InstanceContentTextData:17712:0:0"
msgid "Well, well, returned before I could drain my cup. You deserve a prize."
msgstr "Вернулись, пока я ещё не допила чай... Молодцы! Вот вам награда."

#. ja: もう茶は飲み終えてしまったぞ……？<br>いつまでも待たせおって、褒美はなしだ！
#. de: Meine Tasse ist längst leer!<br>Was fällt euch ein, eine Dame so warten zu lassen!
#. fr: Quel dommage, j'ai terminé de boire mon thé avant votre retour... Pas de récompense pour cette fois<nbsp>!
msgctxt "InstanceContentTextData:17713:0:0"
msgid "Hmph, I have long drained my cup. Such insolence to keep a lady waiting."
msgstr "Я уже давно допила чай... Заставили даму ждать — никакой вам награды!"

#. ja: さあて、ティータイムも終いにして、<br>気分を切り替え、遊技盤で楽しむとしようぞ！
#. de: Die Lust auf Tee ist mir jedenfalls vergangen!<br>Spielt mit mir, um mich gnädig zu stimmen!
#. fr: Très bien, la pause thé est terminée<nbsp>! Reprenons notre pas<shy>sion<shy>nan<shy>te partie, voulez-vous<nbsp>?
msgctxt "InstanceContentTextData:17714:0:0"
msgid "Afternoon tea is over. Let us resume our fun-filled games."
msgstr "С чаепитием покончено. Пора снова повеселиться за игрой!"

#. ja: 舞踏もまた、高貴なる者の嗜み……<br>魅入るがいい、あたしの舞いになっ！
#. de: Tanz ist die vollendete Form der Bewegung!<br>Und niemand tanzt so schön wie ich!
#. fr: Une personne de sang bleu se doit de savoir danser<nbsp>! Appréciez la grâce de mes mouvements<nbsp>!
msgctxt "InstanceContentTextData:17715:0:0"
msgid "Dance is art in motion, and no one dances more artfully than I!"
msgstr "Танец — искусство в движении, и никто не танцует так изящно, как я!"

#. ja: あたしの舞いは、盤面の力を求める……！
#. de: Dielen, über die ich tanze,<br>leiht mir eure Kraft!
#. fr: Ce plateau de jeu est ma piste de danse<nbsp>!
msgctxt "InstanceContentTextData:17716:0:0"
msgid "My dance brings the board to life!"
msgstr "Мой танец пробуждает силу игрового поля!"

#. ja: 魅入るがいい、あたしの舞いになっ！
#. de: Mein Tanz wird euch die Sinne rauben!
#. fr: Ouvrez grand les yeux et observez mes pas<nbsp>!
msgctxt "InstanceContentTextData:17717:0:0"
msgid "My dance holds all in its thrall!"
msgstr "Любуйтесь моим танцем!"

#. ja: さあて、盤面に少しばかり手を加えようぞ……！<br>ルールに従わぬ無粋者には、罰を与えるゆえ気を付けよ！
#. de: Lasst mich das Spielfeld etwas ausgestalten!<br>Mit ein paar Fallen für Regelbrecher!
#. fr: Hmm, et si on pimentait un peu ce plateau de jeu<nbsp>? Prenez garde, les règles sont strictes et toute tricherie sera punie<nbsp>!
msgctxt "InstanceContentTextData:17718:0:0"
msgid "Let us add a special touch to the board. Oh, there's naught to fear...as long as you obey the rules."
msgstr "Немного изменим поле... Смотрите не нарушайте правила, иначе получите по заслугам!"

#. ja: 実に容易い遊技であろう？<br>ただ盤面の絵柄に従えば、よいだけのもの……！
#. de: Ist wirklich gar nichts dabei!<br>Ihr müsst euch nur an die Regeln halten ♪
#. fr: Dommage... Si vous aviez suivi les motifs des cases, tout aurait été pour le mieux dans le meilleur des mondes<nbsp>!
msgctxt "InstanceContentTextData:17719:0:0"
msgid "Yes, you need but abide by the symbols. A simple game, yes?"
msgstr "Премудростей никаких: просто следуйте символам на поле. Легко, правда?"

#. ja: これほど容易い遊技すら、失敗すると……？<br>もしや、身をもって、あたしを笑わせようというのか？
#. de: Selbst dieses simple Spiel versteht ihr nicht!<br>Macht ihr euch etwa über mich lustig?
#. fr: Comment, vous n'arrivez pas à suivre une règle aussi simple<nbsp>? Vous le faites exprès, avouez<nbsp>!
msgctxt "InstanceContentTextData:17720:0:0"
msgid "How can you not grasp such a simple game? Are you failing on purpose?"
msgstr "Неужели вы не справились с такой простой игрой? Может, специально меня смешите?"

#. ja: ふむ、いささか簡単すぎたか？<br>だが完璧に切り抜けたからには、褒美を授けよう！
#. de: Sollte mein Spiel etwa zu einfach gewesen sein?<br>Wie ist es dann zum Ausgleich hiermit?
#. fr: Il faut croire que c'était trop facile pour vous... Pour cette brillante prestation, vous avez mérité une récompense<nbsp>!
msgctxt "InstanceContentTextData:17721:0:0"
msgid "Mayhap that was too easy. But benevolent as I am, I shall grant you a prize nonetheless."
msgstr "Хм, не слишком ли легко вышло? Ну да ладно, за безупречную игру награжу вас!"

#. ja: では、もう少しだけ難度を上げて……絵合わせといこう！<br>楽しませるがいい、ハリカルナッソス様をなっ！
#. de: Schrauben wir den Schwie<shy>rig<shy>keits<shy>grad etwas an!<br>Erfreut mich mit einem Bilderspiel!
#. fr: Bien, corsons la difficulté avec un petit jeu de cases à motifs<nbsp>! Je compte sur vous pour me divertir<nbsp>!
msgctxt "InstanceContentTextData:17722:0:0"
msgid "Now then, let us increase the challenge with a delightful picture game!"
msgstr "А теперь усложним задачу и сыграем в игру с картинками! Развлеките же Харикарнас!"

#. ja: そらそら、どうした？<br>盤面の絵柄に従えぬ者には、罰が待っておるぞ？
#. de: Was denn, was denn?<br>Wer das Muster auf dem Spielfeld missachtet, wird bestraft!
#. fr: Ah non, vous devez respecter les motifs du plateau<nbsp>! À moins que vous ne recherchiez la punition<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "InstanceContentTextData:17723:0:0"
msgid "What's the matter? If you do not abide by the symbols, there <i>will</i> be a penalty."
msgstr "Что такое? Не будете следовать символам — <i>накажу</i>!"

#. ja: 少しばかり、難易度を上げただけでこれとは……<br>対戦相手として、物足りぬぞ？
#. de: Ihr enttäuscht mich!<br>So schwer war es nun wirklich nicht!
#. fr: Ah là là... Dès que les choses se corsent, il n'y a plus personne. Moi qui espérais un adversaire à ma hauteur...
msgctxt "InstanceContentTextData:17724:0:0"
msgid "Come now, it really isn't all that hard. Surely you can do better."
msgstr "Да бросьте, не так уж и сложно. Неужели не можете лучше?"

#. ja: なかなか、やるではないか……。<br>うむ、対戦相手の腕を称え、褒美を授けよう！
#. de: Das war ... gar nicht schlecht!<br>Ihr habt euch eine Belohnung verdient ♪
#. fr: Eh bien, je suis im<shy>pres<shy>sion<shy>née... Je sais reconnaître la valeur d'un adversaire. Tenez, voilà votre récompense<nbsp>!
msgctxt "InstanceContentTextData:17725:0:0"
msgid "Well, aren't we a natural at this? This calls for a prize!"
msgstr "А вы, оказывается, умеете играть! За это полагается награда!"

#. ja: ふむ、そろそろ飽きてきた……<br>必死になる様を、見させてもらおうか！
#. de: Ihr beginnt, mich zu langweilen.<br>Zeigt mal etwas mehr Eifer!
#. fr: Cette partie a assez duré comme ça. Vous allez voir de quel bois je me chauffe<nbsp>!
msgctxt "InstanceContentTextData:17726:0:0"
msgid "I grow weary of this game. Mayhap I'll spice things up with a pinch of desperation."
msgstr "Мне наскучила эта игра... Пожалуй, добавлю немного отчаяния!"

#. ja: さて、盤面の絵柄を見るがいい……！<br>見覚えのあるものではないか？
#. de: Achtet auf das Spielfeldmuster!<br>Es sollte euch vertraut sein.
#. fr: Observez bien les motifs des cases. Est-ce qu'ils ne vous rappellent pas quelque chose<nbsp>?
msgctxt "InstanceContentTextData:17728:0:0"
msgid "Look upon these symbols. You will find them familiar."
msgstr "Взгляните на эти символы... Знакомые, не правда ли?"

#. ja: 「守りの盾」、「攻めの剣」、「癒しの十字」……<br>立つべき盤面がわからぬ愚者には……罰を与えようぞ。
#. de: Der schützende Schild, das streitende Schwert, die heilende Hand ... Wer nicht weiß, wo er hingehört, dem ist nicht zu helfen!
#. fr: Le bouclier représente la défense, l'épée l'attaque et la croix le soin... Choisissez votre case. En cas d'erreur... Ce sera la punition<nbsp>!
msgctxt "InstanceContentTextData:17729:0:0"
msgid "A shield to block, a sword to strike, a cross to heal. Choose wisely, or pay the price!"
msgstr "Щит — для защиты, меч — для атаки, крест — для исцеления. Выбирайте верно, иначе поплатитесь!"

#. ja: うむうむ、ルールは理解できたようだな……。<br>呑み込みの早い対戦相手には、褒美を授けよう！
#. de: Gut, gut, ihr scheint das Spiel begriffen zu haben!<br>Dafür habt ihr euch eine Belohnung verdient ♪
#. fr: Hé hé, je vois que vous avez compris la règle... Belle vivacité d'esprit<nbsp>! Cela mérite récompense<nbsp>!
msgctxt "InstanceContentTextData:17731:0:0"
msgid "Good, you understand the rules. You're clever. I like clever people."
msgstr "Вот-вот, вы поняли правила... Сообразительные мне нравятся!"

#. ja: では、この絵柄を並べたら……どうする？<br>盤面の絵柄に従えぬ者には、罰が待っておるぞ？
#. de: Wie ist es mit diesem Muster?<br>Ob ihr wirklich richtig steht, seht ihr, wenn ihr aufrecht geht<nbsp>♪
#. fr: Que dites-vous de ces nouveaux motifs<nbsp>? N'oubliez pas, une sanction vous attend si vous ne vous y conformez pas<nbsp>!
msgctxt "InstanceContentTextData:17732:0:0"
msgid "And how about this pattern? What is the right answer?"
msgstr "А если выложить вот такой узор, что будете делать? Какой ответ верный?"

#. ja: 盤面の絵柄に従えなかった愚者には、<br>キツイ罰を与えよう！
#. de: Wer sich nicht an die Spielregeln hält,<br>erhält seine gerechte Strafe ♪
#. fr: Ah, vous n'avez pas respecté le motif. Comme c'est vilain... Pour la peine, voilà un châtiment<nbsp>!
msgctxt "InstanceContentTextData:17734:0:0"
msgid "Those who choose poorly will be duly punished!"
msgstr "Кто не следует символам на поле, получит суровое наказание!"

#. ja: すばらしい、カエルの大合唱よな！<br>うむ、褒美を授けよう！
#. de: Welch wunderbares Froschkonzert!<br>Dafür habt ihr euch eine Belohnung verdient ♪
#. fr: Magnifique<nbsp>! Une victoire rainette et sans bavure<nbsp>! Tenez, c'est pour vous<nbsp>!
msgctxt "InstanceContentTextData:17735:0:0"
msgid "Ah, such a sweet chorus, a veritable treat for the ears! A prize is in order!"
msgstr "Вот это лягушачий хор! Прелесть для ушей! Вам полагается награда!"

#. ja: さて、ここで「かけっこ」の時間といくとしよう……！<br>迷わず駆けるがいい、思い切りなっ！
#. de: Wie wär's mit einer Runde Fangen?<br>Flieht, der Tod hat schnelle Beine ♪
#. fr: Dites-moi, vous aimez courir<nbsp>? J'espère que oui car vous allez courir pour moi. Oh, oui<nbsp>!
msgctxt "InstanceContentTextData:17738:0:0"
msgid "Now then, let us have a race. Run, run, as fast as you can!"
msgstr "А теперь устроим забег! Бегите, бегите, со всех ног!"

#. ja: ファファファ……<br>お前たちも、「無」の中に消え去るがいい！
#. de: Hahaha! Ihr einfältigen Narren!<br>Im Nichts sollt ihr verrotten!
#. fr: Mouah ha, ha, ha... Et maintenant, vous allez périr à l'intérieur du néant<nbsp>!
msgctxt "InstanceContentTextData:17800:0:0"
msgid "Hahaha... You shall all be given to the void!"
msgstr "Фа-фа-фа... И вы все исчезнете в Ничто!"

#. ja: 食らえっ！！
#. de: Nehmt dies!
#. fr: En garde<nbsp>!
msgctxt "InstanceContentTextData:17801:0:0"
msgid "Fall!"
msgstr "Получай!"

#. ja: 「無」の力によって、強化された我が魔力……<br>暗黒魔道士の真価を、見るがいい！
#. de: Meine Magie ist durchtränkt von der Kraft des Nichts!<br>Berauscht euch an ihr!
#. fr: Le néant confère à mes sorts une puissance inouïe... Vous ne faites pas le poids face au mage obscur que je suis<nbsp>!
msgctxt "InstanceContentTextData:17802:0:0"
msgid "My magic is steeped in the greatest of powers─the power of the void!"
msgstr "Моя магия напитана величайшей силой — силой Ничто!"

#. ja: 死線を越えよう……！<br>「無」の力よ、我が真の姿を解き放て！
#. de: Tretet ein ins Reich des Todes!<br>Das Nichts offenbart meine wahre Gestalt!
#. fr: Le pouvoir du néant transcende les apparences... Admirez ma véritable forme<nbsp>!
msgctxt "InstanceContentTextData:17803:0:0"
msgid "My true strength lies in the void, and in the void all is laid bare!"
msgstr "Истинная сила моя — в Ничто. И в Ничто откроется мой истинный облик!"

#. ja: 私を本気にさせたな！<br>死の世界へ、行くがいい！！
#. de: Jetzt habt ihr mich wirklich wütend gemacht!<br>Ihr werdet mein Reich nie mehr verlassen!
#. fr: Je vais vous envoyer dans les profondeurs de l'au-delà<nbsp>!
msgctxt "InstanceContentTextData:17804:0:0"
msgid "You will rue provoking me! I shall send you to your doom!"
msgstr "Пожалеете, что вывели меня из себя! Я отправлю вас прямиком в погибель!"

#. ja: 「無」に呑まれるがいい！
#. de: Ertrinkt im Nichts!
#. fr: Que le néant vous emporte<nbsp>!
msgctxt "InstanceContentTextData:17805:0:0"
msgid "Void devour you!"
msgstr "Да поглотит вас Ничто!"

#. ja: 「無」は、ここに存在する！<br>私に勝てるのは、「無」の力のみ！
#. de: Hier ist das Nichts existent!<br>Und nur das Nichts kann mich besiegen!
#. fr: Le néant est tout-puissant<nbsp>! Lui seul peut s'opposer à ma suprématie<nbsp>!
msgctxt "InstanceContentTextData:17806:0:0"
msgid "Nothingness is my weapon, and nothingness alone can strike me down!"
msgstr "Ничто — моё оружие, и лишь Ничто способно меня сразить!"

#. ja: ファファファ……<br>怒りや憎しみでは、私は倒せん！
#. de: Hahaha!<br>Ihr rast, doch Raserei bezwingt mich nicht!
#. fr: Mouhaha... Énervez-vous autant que vous le voulez, cela ne vous sera d'aucun secours<nbsp>!
msgctxt "InstanceContentTextData:17807:0:0"
msgid "Hahaha... Anger and hatred cannot defeat me!"
msgstr "Фа-фа-фа... Гневом и ненавистью меня не одолеть!"

#. ja: ファファファ……<br>これぞ我が魔力……！
#. de: Hahaha!<br>Meine Magie ist unübertroffen!
#. fr: Mouah ha, ha, ha... Approchez, venez tâter de ma magie<nbsp>!
msgctxt "InstanceContentTextData:17808:0:0"
msgid "Hahaha... Mine is the ultimate magic!"
msgstr "Фа-фа-фа... Вот она, высшая магия!"

#. ja: ファファファ……<br>死の世界へ、行くがいい！
#. de: Hahaha!<br>Der Tod lässt euch nicht mehr los!
#. fr: Je vais vous envoyer dans les profondeurs de l'au-delà<nbsp>!
msgctxt "InstanceContentTextData:17809:0:0"
msgid "Hahaha... I shall send you to your doom!"
msgstr "Фа-фа-фа... Отправляйтесь в погибель!"

#. ja: 死線を越えよう……！<br>「無」の力よ、我が真の姿を解き放て！
#. de: Tretet ein ins Reich des Todes!<br>Das Nichts offenbart meine wahre Gestalt!
#. fr: Le pouvoir du néant transcende les apparences... Admirez ma véritable forme<nbsp>!
msgctxt "InstanceContentTextData:17810:0:0"
msgid "My true strength lies in the void, and in the void all is laid bare!"
msgstr "Истинная сила моя — в Ничто. И в Ничто откроется мой истинный облик!"

#. ja: な、なぜ……「無」の力が……！？
#. de: Wieso versagt das Nichts?
#. fr: Qu'est-ce que... Non... Le néant... Il m'aspire<nbsp>!?
msgctxt "InstanceContentTextData:17811:0:0"
msgid "Th-This cannot be..."
msgstr "Н-не может быть..."

#. ja: 認めん……認めんぞォォッ！
#. de: Das ist unmöglich!
#. fr: Ç-ça ne se passera pas comme ça<nbsp>!
msgctxt "InstanceContentTextData:17812:0:0"
msgid "Nooo!"
msgstr "Нееет!"

#. ja: な　ぜ　だ！
#. de: Warum?
#. fr: Non<nbsp>! Impossible<nbsp>!
msgctxt "InstanceContentTextData:17813:0:0"
msgid "Why!?"
msgstr "Почему!?"

#. ja: 「無」の力を手にいれたのに……
#. de: Das Nichts sollte mir doch gehorchen!
#. fr: La puissance du néant était à ma portée<nbsp>!
msgctxt "InstanceContentTextData:17814:0:0"
msgid "The void was mine to command!"
msgstr "Ведь сила Ничто была у меня в руках!"

#. ja: 「無」とはいったい……うごごご！！
#. de: Wie konnte das gescheh... Aaaaah!!!
#. fr: Comment est-ce... Nooon<nbsp>!
msgctxt "InstanceContentTextData:17815:0:0"
msgid "How could it─ Arrrgh!"
msgstr "Как такое могло... А-а-а!"

#. ja: 私は、ネオエクスデス……
#. de: Ich bin Neo Exdeath!
#. fr: Je suis Néo-Exdeath<nbsp>!
msgctxt "InstanceContentTextData:17816:0:0"
msgid "I am Neo Exdeath."
msgstr "Я — Нео Экздеат."

#. ja: すべての記憶　すべての存在、すべての次元を消し……
#. de: Alle Erinnerungen, alle Dimensionen ... Alles, was war und alles, das ist, soll nicht mehr sein!
#. fr: Souvenirs, dimensions, existence... Tout sera anéanti.
msgctxt "InstanceContentTextData:17817:0:0"
msgid "All memories...dimensions...existence... All that is shall be returned to nothing."
msgstr "Все воспоминания... все измерения... само существование... Всё сущее обратится в Ничто."

#. ja: そして、私も消えよう……
#. de: Dann kann auch ich endlich gehen!
#. fr: Et ensuite, je disparaîtrai aussi...
msgctxt "InstanceContentTextData:17818:0:0"
msgid "Then I, too, can disappear..."
msgstr "А после и я исчезну..."

#. ja: 永遠に！！
#. de: Für immer!
#. fr: ... pour toujours<nbsp>!
msgctxt "InstanceContentTextData:17819:0:0"
msgid "Forever!"
msgstr "Навеки!"

#. ja: <split " " 1><string $gs1></split>、気を付けるンだ！<br>こいつは……宇宙の法則が乱れるぞッ！！
#. de: Vorsicht, <split " " 1><string $gs1></split>!<br>Der Kerl rüttelt an den Grundfesten des Universums!
#. fr: <split " " 1><string $gs1></split>, fais attention, les ca<shy>rac<shy>té<shy>ris<shy>ti<shy>ques du Deltastice sont en train de changer<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "InstanceContentTextData:17820:0:0"
msgid "Watch out, <split \" \" 1><string $gs1></split>! He's shaking the very foundations of creation!"
msgstr "Берегись, <split \" \" 1><string $gs1></split>! Он расшатывает сами основы мироздания!"

#. ja: ケルピーの縄張りへの到達
#. de: Zu Kelpies Revier vorkämpfen
#. fr: Atteindre le domaine de Kelpie
msgctxt "InstanceContentTextData:17900:0:0"
msgid "Arrive at the Green Screams"
msgstr "Добраться до владений Келпи"

#. ja: ケルピーの撃破
#. de: Kelpie besiegen
#. fr: Vaincre Kelpie
msgctxt "InstanceContentTextData:17901:0:0"
msgid "Defeat Kelpie"
msgstr "Одолеть Келпи"

#. ja: 封印された門扉への到達
#. de: Zur Siegelpforte vorkämpfen
#. fr: Atteindre la voie scellée
msgctxt "InstanceContentTextData:17902:0:0"
msgid "Arrive at a Door Unopened"
msgstr "Добраться до запечатанной двери"

#. ja: オールドワンの撃破
#. de: Den Altvorderen besiegen
#. fr: Vaincre l'Ancien
msgctxt "InstanceContentTextData:17903:0:0"
msgid "Defeat the Old One"
msgstr "Одолеть Древнего"

#. ja: テオドリックの黄金堂への到達
#. de: Zu Theoderics Schatzkammer vorkämpfen
#. fr: Atteindre la salle du trésor
msgctxt "InstanceContentTextData:17904:0:0"
msgid "Arrive at the Golden Walls of Ruin"
msgstr "Добраться до Золотых стен погибели"

#. ja: グオオオォォォォ！<br>ゴロズ、ゴロズ、ミンナ、ゴロズウゥゥゥゥ！
#. de: Grrroooaaahhhr!<br>Töten, töten! Alle töten!
#. fr: GROARRR<nbsp>! DES PILLARDS<nbsp>! TUER<nbsp>! TUER<nbsp>! TUER<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:17905:0:0"
msgid "Graaaaaah!<br>Kill! Kill you all!"
msgstr "Гра-а-а!<br>Убить! Всех вас убить!"

#. ja: アガガガガガ……！<br>ユルザン、ミンナ、ゴロジデヤルゥゥゥゥ！
#. de: Arrrggghhh!<br>Yuruzan alle töten!
#. fr: GRRRRAAA...<nbsp>! VOLEURS<nbsp>!!! MOUREZ<nbsp>! MOUREZ TOUS<nbsp>!!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "InstanceContentTextData:17906:0:0"
msgid "\\<snarl> Death!<br>Death comes for you!"
msgstr "<i>Рычит...</i> Смерть!<br>Смерть идёт за вами!"

#. ja: ××△キジュツ△××◎ジュソ◎××▼ヘンイ▼××<br>ノロイ、ノロイ、ノロイ、ノロイ……
