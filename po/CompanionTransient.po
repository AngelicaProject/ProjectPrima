msgid "You've got the nose of a bloodhound.<br>   - Midnight Dew"
msgstr "Нюх у тебя — как у ищейки.<br>   — Полуночная роса"

#. ja: しっぽふりふり
#. de: Schwanzwedelei
#. fr: Queue remuante
