msgctxt "CompanionTransient:94:0:2"
msgid "Our dreams are<br>what sustain us.<br>  - Gundobald"
msgstr "Нам нужны наши<br>мечты, чтобы жить.<br>  — Гундобальд"

#. ja: 悪夢のおすそわけ
#. de: Klartraum
#. fr: Tapir soûlant
