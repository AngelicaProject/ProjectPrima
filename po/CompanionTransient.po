msgctxt "CompanionTransient:164:0:2"
msgid "I am no prince! I am but the<br>privileged brat of an...empire!<br>   - Tataramu"
msgstr "Я никакой не принц! Я всего лишь<br>избалованный отпрыск... империи!<br>   — Татараму"

#. ja: アイスバーン
#. de: Tückisches Eis
#. fr: Morsure gelée
