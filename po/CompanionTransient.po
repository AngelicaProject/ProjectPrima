msgctxt "CompanionTransient:463:0:2"
msgid "I am a finder of filth and<br>a pursuer of purity.<br>   - Statuesque Broom"
msgstr "Я нахожу грязь<br>и гонюсь за чистотой.<br>   — Статуя-метла"

#. ja: お掃除
#. de: Putzfimmel
#. fr: Nettoyage de printemps
