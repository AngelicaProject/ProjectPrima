msgctxt "CompanionTransient:441:0:2"
msgid "'Tis time for action.<br>   - Ancient Hero"
msgstr "Пора действовать.<br>   — Древняя героиня"

#. ja: ペルソナ
#. de: Persona
#. fr: Persona
