msgctxt "CompanionTransient:348:0:2"
msgid "Not water! Anything but water!<br>   - Zahar'ak Hatchling"
msgstr "Только не вода! Что угодно, только не вода!<br>   — Цыплёнок Захар'ака"

#. ja: 雷撃戦
#. de: Torpedierung
#. fr: Torpillage
