msgctxt "CompanionTransient:435:0:2"
msgid "My money is on<br>writhing snakes.<br>   - Thancred"
msgstr "Ставлю на<br>извивающихся змей.<br>   — Танкред"

#. ja: 蜷局
#. de: Ringelreigen
#. fr: Enlacement
#. column 0: Summon your Caduceus minion. Won't spit acid at you, so rest easy.
