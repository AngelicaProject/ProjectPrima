msgctxt "CompanionTransient:104:0:2"
msgid "Muscle-heads? Hate 'em!<br>  - Ultros"
msgstr "Качки? Терпеть их не могу!<br>  — Ультрос"

#. ja: たこあし
#. de: Tentakel
#. fr: Tentacule
