msgctxt "ActionTransient:146:0:0"
msgid "Deals ice damage with a potency of 50 to all nearby enemies.<br><ui-color 504><ui-edge-color 505>Additional Effect:</ui-edge-color></ui-color> Grants <ui-color 506><ui-edge-color 507>Umbral Ice</ui-edge-color></ui-color> or removes <ui-color 506><ui-edge-color 507>Astral Fire</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Duration:</ui-edge-color></ui-color> 15s"
msgstr "Наносит всем ближайшим противникам урон льдом мощностью 50.<br><ui-color 504><ui-edge-color 505>Дополнительный эффект:</ui-edge-color></ui-color> накладывает <ui-color 506><ui-edge-color 507>«Умбральный лёд»</ui-edge-color></ui-color> или снимает <ui-color 506><ui-edge-color 507>«Астральный огонь»</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Длительность:</ui-edge-color></ui-color> 15 сек."

