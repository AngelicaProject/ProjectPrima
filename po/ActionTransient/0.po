msgctxt "ActionTransient:149:0:0"
msgid "Swaps <ui-color 506><ui-edge-color 507>Astral Fire</ui-edge-color></ui-color> with a single <ui-color 506><ui-edge-color 507>Umbral Ice</ui-edge-color></ui-color>, or <ui-color 506><ui-edge-color 507>Umbral Ice</ui-edge-color></ui-color> with a single <ui-color 506><ui-edge-color 507>Astral Fire</ui-edge-color></ui-color>."
msgstr "Меняет <ui-color 506><ui-edge-color 507>«Астральный огонь»</ui-edge-color></ui-color> на один уровень <ui-color 506><ui-edge-color 507>«Умбрального льда»</ui-edge-color></ui-color> или <ui-color 506><ui-edge-color 507>«Умбральный лёд»</ui-edge-color></ui-color> на один уровень <ui-color 506><ui-edge-color 507>«Астрального огня»</ui-edge-color></ui-color>."

