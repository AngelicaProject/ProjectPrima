msgid "Deals unaspected damage with a potency of 100.<br><ui-color 504><ui-edge-color 505>Additional Effect:</ui-edge-color></ui-color> Absorbs a portion of damage dealt as HP<br><if ($gn72 >= 70)><if ($gn68 == 28)><ui-color 504><ui-edge-color 505>Additional Effect:</ui-edge-color></ui-color> Increases <ui-color 500><ui-edge-color 501>Faerie Gauge</ui-edge-color></ui-color> by 10<br></if></if><ui-color 504><ui-edge-color 505>Aetherflow Gauge Cost:</ui-edge-color></ui-color> 1"
msgstr "Наносит безатрибутный урон мощностью 100.<br><ui-color 504><ui-edge-color 505>Дополнительный эффект:</ui-edge-color></ui-color> часть нанесённого урона восстанавливает HP<br><if ($gn72 >= 70)><if ($gn68 == 28)><ui-color 504><ui-edge-color 505>Дополнительный эффект:</ui-edge-color></ui-color> повышает шкалу <ui-color 500><ui-edge-color 501>Фейской энергии</ui-edge-color></ui-color> на 10<br></if></if><ui-color 504><ui-edge-color 505>Расход зарядов шкалы «Поток эфира»:</ui-edge-color></ui-color> 1"

#. ja: 対象に無属性魔法攻撃。　<ui-color 504><ui-edge-color 505>威力：</ui-edge-color></ui-color>20<br><ui-color 504><ui-edge-color 505>追加効果：</ui-edge-color></ui-color>対象に無属性の継続ダメージを付与する<br><ui-color 504><ui-edge-color 505>威力：</ui-edge-color></ui-color>20　<ui-color 504><ui-edge-color 505>効果時間：</ui-edge-color></ui-color>30秒
