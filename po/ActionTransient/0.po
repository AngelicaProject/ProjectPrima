msgctxt "ActionTransient:228:0:0"
msgid "Surveys the landscape to locate the nearest mineral deposit or rocky outcrop within skill range. Can only be executed while <ui-color 506><ui-edge-color 507>Prospect</ui-edge-color></ui-color> is active.<br><ui-color 504><ui-edge-color 505>Duration:</ui-edge-color></ui-color> 15s"
msgstr "Показывает на карте ближайшую залежь руды или скальный выход в пределах досягаемости навыка. Можно применить только при действии эффекта <ui-color 506><ui-edge-color 507>«Поиск месторождений»</ui-edge-color></ui-color>.<br><ui-color 504><ui-edge-color 505>Длительность:</ui-edge-color></ui-color> 15 сек."

#. ja: 自分の移動速度が下がり、モンスターに襲われなくなる。<br>効果が有効なモンスターの最大レベル：<if ($gn68 == 16)><if ($gn69 >= 76)>{80}<else><if ($gn69 >= 73)>{77}<else><if ($gn69 >= 70)>{74}<else><if ($gn69 >= 66)>{70}<else><if ($gn69 >= 63)>{67}<else><if ($gn69 >= 60)>{64}<else><if ($gn69 >= 56)>{60}<else><if ($gn69 >= 53)>{57}<else><if ($gn69 >= 50)>{54}<else><if ($gn69 >= 38)>{50}<else><if ($gn69 >= 28)>{40}<else><if ($gn69 >= 18)>{30}<else>{20}</if></if></if></if></if></if></if></if></if></if></if></if><else>{20}</if>
