msgctxt "ActionTransient:229:0:0"
msgid "Conceal yourself and tread quietly, reducing movement speed, but enabling you to avoid enemies level <if ($gn68 == 16)><if ($gn69 >= 76)>{80}<else><if ($gn69 >= 73)>{77}<else><if ($gn69 >= 70)>{74}<else><if ($gn69 >= 66)>{70}<else><if ($gn69 >= 63)>{67}<else><if ($gn69 >= 60)>{64}<else><if ($gn69 >= 56)>{60}<else><if ($gn69 >= 53)>{57}<else><if ($gn69 >= 50)>{54}<else><if ($gn69 >= 38)>{50}<else><if ($gn69 >= 28)>{40}<else><if ($gn69 >= 18)>{30}<else>{20}</if></if></if></if></if></if></if></if></if></if></if></if><else>{20}</if> and below."
msgstr "Скрывает вас и замедляет передвижение, позволяя не привлекать внимание врагов <if ($gn68 == 16)><if ($gn69 >= 76)>{80}<else><if ($gn69 >= 73)>{77}<else><if ($gn69 >= 70)>{74}<else><if ($gn69 >= 66)>{70}<else><if ($gn69 >= 63)>{67}<else><if ($gn69 >= 60)>{64}<else><if ($gn69 >= 56)>{60}<else><if ($gn69 >= 53)>{57}<else><if ($gn69 >= 50)>{54}<else><if ($gn69 >= 38)>{50}<else><if ($gn69 >= 28)>{40}<else><if ($gn69 >= 18)>{30}<else>{20}</if></if></if></if></if></if></if></if></if></if></if></if><else>{20}</if> уровня и ниже."

#. ja: 採集アイテムのHQ獲得に必要な条件が分かる。
#. de: Du siehst während des Sammelns die Bedingungen, HQ-Gegenstände zu erhalten.
#. fr: Révèle les conditions pour récolter les objets HQ.
msgctxt "ActionTransient:230:0:0"
msgid "Reveals the conditions for obtaining HQ items while gathering."
msgstr "Показывает условия, необходимые для получения предметов высокого качества при сборе."

#. ja: すべてのリーチゲージを0にする。
#. de: Du kannst alle unerreichbaren Gegenstände sammeln.
#. fr: Rend accessibles tous les objets hors de portée.
msgctxt "ActionTransient:231:0:0"
msgid "Renders all out-of-reach items reachable."
msgstr "Позволяет собрать все недосягаемые предметы."

#. ja: 採集場所の耐久／採集回数を1回復する。<if ($gn68 == 16)><if ($gn69 >= 90)><br><ui-color 504><ui-edge-color 505>追加効果：</ui-edge-color></ui-color>自身に<ui-color 500><ui-edge-color 501>「理知興起実行可」</ui-edge-color></ui-color>を50％の確率で付与する。</if></if>
#. de: Du erhältst einen weiteren Sammelversuch.<if ($gn68 == 16)><if ($gn69 >= 90)><br>Zusatzeffekt: Zusatzeffekt: 50 % Chance auf <ui-color 506><ui-edge-color 507>Triumph des Wissens bereit</ui-edge-color></ui-color></if></if>
#. fr: Accorde une tentative de récolte sup<shy>plé<shy>men<shy>tai<shy>re.<if ($gn68 == 16)><if ($gn69 >= 90)><br><ui-color 506><ui-edge-color 507>Effet additionnel<nbsp>:</ui-edge-color></ui-color> 50% de chances de se voir octroyer <ui-color 500><ui-edge-color 501>Étalage des con<shy>nais<shy>san<shy>ces préparé</ui-edge-color></ui-color>.</if></if>
#. macro: <if ($gn68 == 16)><if ($gn69 >= 90)><br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>50% chance to grant <ui-color 506><ui-edg… — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 68 (the player's current class or job, a ClassJob row) == 16 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gn69 >= 90)><br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>50% chance to grant <ui-color 506><ui-edge-color 507>Eureka… — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 69 >= 90 (condition: may be reworded, restructured, added, or dropped)
