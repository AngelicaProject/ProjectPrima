msgctxt "ActionTransient:109:0:0"
msgid "Delivers an attack with a potency of 100.<br><ui-color 504><ui-edge-color 505>Additional Effect:</ui-edge-color></ui-color> <ui-color 506><ui-edge-color 507>Silence</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Duration:</ui-edge-color></ui-color> 1s"
msgstr "Наносит урон мощностью 100.<br><ui-color 504><ui-edge-color 505>Дополнительный эффект:</ui-edge-color></ui-color> накладывает <ui-color 506><ui-edge-color 507>Молчание</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Длительность:</ui-edge-color></ui-color> 1 сек."

#. ja: 対象に物理攻撃。　<ui-color 504><ui-edge-color 505>威力：</ui-edge-color></ui-color>130<br><ui-color 504><ui-edge-color 505>最大チャージ数：</ui-edge-color></ui-color><if ($gn68 == 23)><if ($gn72 >= 84)>{3}<else>{2}</if><else>{2}</if><if ($gn72 >= 45)><if ($gn68 == 23)><br>リキャストタイマーを<ui-color 500><ui-edge-color 501>「レイン・オブ・デス」</ui-edge-color></ui-color>と共有する。</if></if>
#. de: Du führst eine physische Attacke aus.<br>Attacke-Wert: 130<br>Maximale Aufladungen: <if ($gn68 == 23)><if ($gn72 >= 84)>{3}<else>{2}</if><else>{2}</if><if ($gn72 >= 45)><if ($gn68 == 23)><br>Gemeinsamer Reaktivierungs-Timer mit <ui-color 502><ui-edge-color 503>Tödlicher Regen</ui-edge-color></ui-color></if></if>
#. fr: Effectue une attaque physique sur la cible.<br><ui-color 506><ui-edge-color 507>Puissance<nbsp>:</ui-edge-color></ui-color> 130<br><ui-color 506><ui-edge-color 507>Maximum de charges<nbsp>:</ui-edge-color></ui-color> <if ($gn68 == 23)><if ($gn72 >= 84)>{3}<else>{2}</if><else>{2}</if><if ($gn72 >= 45)><if ($gn68 == 23)><br>Partage le même temps de recharge que <ui-color 500><ui-edge-color 501>Pluie mortelle</ui-edge-color></ui-color>.</if></if>
