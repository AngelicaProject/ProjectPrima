msgctxt "ActionTransient:42:0:0"
msgid "Delivers an attack with a potency of <if ($gn68 == 21)><if ($gn72 >= 94)>{220}<else><if ($gn68 == 21)><if ($gn72 >= 84)>{160}<else>{100}</if><else>{100}</if></if><else><if ($gn68 == 21)><if ($gn72 >= 84)>{160}<else>{100}</if><else>{100}</if></if>.<br><ui-color 504><ui-edge-color 505>Combo Action:</ui-edge-color></ui-color> <ui-color 500><ui-edge-color 501>Maim</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Combo Potency:</ui-edge-color></ui-color> <if ($gn68 == 21)><if ($gn72 >= 94)>{500}<else><if ($gn68 == 21)><if ($gn72 >= 84)>{440}<else>{380}</if><else>{380}</if></if><else><if ($gn68 == 21)><if ($gn72 >= 84)>{440}<else>{380}</if><else>{380}</if></if><br><ui-color 504><ui-edge-color 505>Combo Bonus:</ui-edge-color></ui-color> Restores own HP<br><ui-color 504><ui-edge-color 505>Cure Potency: </ui-edge-color></ui-color>250<if ($gn68 == 21)><if ($gn72 >= 35)><br><ui-color 504><ui-edge-color 505>Combo Bonus:</ui-edge-color></ui-color> Increases <ui-color 500><ui-edge-color 501>Beast Gauge</ui-edge-color></ui-color> by 20</if></if>"
msgstr "Наносит удар силой <if ($gn68 == 21)><if ($gn72 >= 94)>{220}<else><if ($gn68 == 21)><if ($gn72 >= 84)>{160}<else>{100}</if><else>{100}</if></if><else><if ($gn68 == 21)><if ($gn72 >= 84)>{160}<else>{100}</if><else>{100}</if></if>.<br><ui-color 504><ui-edge-color 505>Комбо:</ui-edge-color></ui-color> <ui-color 500><ui-edge-color 501>Калечащий удар</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Сила удара в комбо:</ui-edge-color></ui-color> <if ($gn68 == 21)><if ($gn72 >= 94)>{500}<else><if ($gn68 == 21)><if ($gn72 >= 84)>{440}<else>{380}</if><else>{380}</if></if><else><if ($gn68 == 21)><if ($gn72 >= 84)>{440}<else>{380}</if><else>{380}</if></if><br><ui-color 504><ui-edge-color 505>Бонус комбо:</ui-edge-color></ui-color> восстанавливает здоровье<br><ui-color 504><ui-edge-color 505>Сила лечения:</ui-edge-color></ui-color> 250<if ($gn68 == 21)><if ($gn72 >= 35)><br><ui-color 504><ui-edge-color 505>Бонус комбо:</ui-edge-color></ui-color> повышает <ui-color 500><ui-edge-color 501>шкалу зверя</ui-edge-color></ui-color> на 20</if></if>"

#. ja: 効果時間中、自身は一部を除くすべての攻撃に対してＨＰが1より減ることがなくなる。<br>敵を対象として実行した場合は、対象の移動を封じる。<br><ui-color 504><ui-edge-color 505>効果時間：</ui-edge-color></ui-color>10秒
#. de: Du überstehst fast jede Attacke, sodass dir mindestens 1 LP bleibt.<br>Wenn ein Gegner anvisiert ist, wird er an der Bewegung gehindert.<br>Dauer: 10 Sekunden
#. fr: La plupart des attaques ne peuvent pas réduire vos PV à moins de 1.<br>Si un ennemi était ciblé, entrave ses déplacements.<br><ui-color 506><ui-edge-color 507>Durée<nbsp>:</ui-edge-color></ui-color> 10s
