msgctxt "ActionTransient:188:0:0"
msgid "Creates a designated area in which party members will only suffer 90% of all damage inflicted.<br><ui-color 504><ui-edge-color 505>Duration:</ui-edge-color></ui-color> 15s<br><if ($gn68 == 28)><if ($gn72 >= 78)><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color><ui-color 506><ui-edge-color 507>Regen</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Cure Potency: </ui-edge-color></ui-color>100<br></if></if><if ($gn72 >= 70)><if ($gn68 == 28)><ui-color 504><ui-edge-color 505>Additional Effect:</ui-edge-color></ui-color> Increases <ui-color 500><ui-edge-color 501>Faerie Gauge</ui-edge-color></ui-color> by 10<br></if></if><ui-color 504><ui-edge-color 505>Aetherflow Gauge Cost:</ui-edge-color></ui-color> 1"
