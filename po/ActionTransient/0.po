msgctxt "ActionTransient:117:0:0"
msgid "Delivers an attack with a potency of 100 to target and all enemies nearby it.<br><ui-color 504><ui-edge-color 505>Maximum Charges: </ui-edge-color></ui-color><if ($gn68 == 23)><if ($gn72 >= 84)>{3}<else>{2}</if><else>{2}</if><br>Shares a recast timer with <ui-color 500><ui-edge-color 501><if ($gn68 == 23)><if ($gn72 >= 92)>Heartbreak Shot<else>Bloodletter</if><else>Bloodletter</if></ui-edge-color></ui-color>."
msgstr "Наносит цели и всем противникам рядом с ней урон мощностью 100.<br><ui-color 504><ui-edge-color 505>Максимум зарядов: </ui-edge-color></ui-color><if ($gn68 == 23)><if ($gn72 >= 84)>{3}<else>{2}</if><else>{2}</if><br>Время перезарядки общее с <ui-color 500><ui-edge-color 501><if ($gn68 == 23)><if ($gn72 >= 92)>«Выстрелом в сердце»<else>«Кровопуском»</if><else>«Кровопуском»</if></ui-edge-color></ui-color>."

