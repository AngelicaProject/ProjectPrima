msgctxt "ActionTransient:26253:0:0"
msgid "Reduces damage taken by 10%.<br><ui-color 504><ui-edge-color 505>Duration:</ui-edge-color></ui-color> 20s"
msgstr "Снижает получаемый урон на 10%.<br><ui-color 504><ui-edge-color 505>Длительность:</ui-edge-color></ui-color> 20 сек."

