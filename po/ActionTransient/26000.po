msgctxt "ActionTransient:26252:0:0"
msgid "Increases physical damage dealt by 25%.<br><ui-color 504><ui-edge-color 505>Duration:</ui-edge-color></ui-color> 25s"
msgstr "Увеличивает наносимый физический урон на 25%.<br><ui-color 504><ui-edge-color 505>Длительность:</ui-edge-color></ui-color> 25 сек."

#. ja: 一定時間、自身の被ダメージを10％軽減させる。<br><ui-color 504><ui-edge-color 505>効果時間：</ui-edge-color></ui-color>20秒
#. de: Du verringerst erlittenen Schaden um 10<nbsp>%.<br>Dauer: 20 Sekunden
#. fr: Réduit de 10% vos dégâts subis.<br><ui-color 506><ui-edge-color 507>Durée<nbsp>:</ui-edge-color></ui-color> 20s
