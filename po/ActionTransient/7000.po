msgctxt "ActionTransient:7407:0:0"
msgid "Deals wind damage with a potency of 100.<br><ui-color 504><ui-edge-color 505>Additional Effect:</ui-edge-color></ui-color> Wind damage over time<br><ui-color 504><ui-edge-color 505>Potency:</ui-edge-color></ui-color> 25<br><ui-color 504><ui-edge-color 505>Duration:</ui-edge-color></ui-color> 45s<if ($gn68 == 23)><if ($gn72 >= 76)><br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>35% chance of granting <ui-color 506><ui-edge-color 507>Hawk's Eye</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Duration: </ui-edge-color></ui-color>30s</if></if>"
msgstr "Наносит урон ветром с potency 100.<br><ui-color 504><ui-edge-color 505>Дополнительный эффект:</ui-edge-color></ui-color> периодический урон ветром<br><ui-color 504><ui-edge-color 505>Potency:</ui-edge-color></ui-color> 25<br><ui-color 504><ui-edge-color 505>Длительность:</ui-edge-color></ui-color> 45 сек.<if ($gn68 == 23)><if ($gn72 >= 76)><br><ui-color 504><ui-edge-color 505>Дополнительный эффект:</ui-edge-color></ui-color> с вероятностью 35% даёт эффект <ui-color 506><ui-edge-color 507>«Орлиный глаз»</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Длительность:</ui-edge-color></ui-color> 30 сек.</if></if>"

