msgid "Deals unaspected damage with a potency of <if ($gn68 == 19)><if ($gn72 >= 94)>{400}<else><if ($gn68 == 19)><if ($gn72 >= 84)>{350}<else>{300}</if><else>{300}</if></if><else><if ($gn68 == 19)><if ($gn72 >= 84)>{350}<else>{300}</if><else>{300}</if></if>.<if ($gn68 == 19)><if ($gn72 >= 64)><br><ui-color 504><ui-edge-color 505>Divine Might Potency: </ui-edge-color></ui-color><if ($gn68 == 19)><if ($gn72 >= 94)>{500}<else><if ($gn68 == 19)><if ($gn72 >= 84)>{450}<else>{400}</if><else>{400}</if></if><else><if ($gn68 == 19)><if ($gn72 >= 84)>{450}<else>{400}</if><else>{400}</if></if></if></if><if ($gn68 == 19)><if ($gn72 >= 68)><br><ui-color 504><ui-edge-color 505>Requiescat Potency: </ui-edge-color></ui-color><if ($gn68 == 19)><if ($gn72 >= 94)>{700}<else><if ($gn68 == 19)><if ($gn72 >= 84)>{650}<else>{600}</if><else>{600}</if></if><else><if ($gn68 == 19)><if ($gn72 >= 84)>{650}<else>{600}</if><else>{600}</if></if><br>The effect of <ui-color 506><ui-edge-color 507>Divine Might</ui-edge-color></ui-color> will be prioritized over <ui-color 506><ui-edge-color 507>Requiescat</ui-edge-color></ui-color> when under the effect of both.</if></if><if ($gn68 == 19)><if ($gn72 >= 84)><br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>Restores own HP<br><ui-color 504><ui-edge-color 505>Cure Potency: </ui-edge-color></ui-color>400</if></if>"
