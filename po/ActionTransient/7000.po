msgid "Delivers an attack with a potency of <if ($gn68 == 34)><if ($gn72 >= 66)>{200}<else>{180}</if><else>{180}</if>.<if ($gn72 >= 62)><if ($gn68 == 34)><br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>Increases <ui-color 500><ui-edge-color 501>Kenki Gauge</ui-edge-color></ui-color> by 5</if></if>"
msgstr "Наносит удар с potency <if ($gn68 == 34)><if ($gn72 >= 66)>{200}<else>{180}</if><else>{180}</if>.<if ($gn72 >= 62)><if ($gn68 == 34)><br><ui-color 504><ui-edge-color 505>Дополнительный эффект:</ui-edge-color></ui-color> повышает шкалу <ui-color 500><ui-edge-color 501>«Кэнки»</ui-edge-color></ui-color> на 5</if></if>"

