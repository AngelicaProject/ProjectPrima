msgctxt "ActionTransient:7518:0:0"
msgid "Ensures the next <if ($gn68 == 35)><if ($gn72 >= 82)><ui-color 500><ui-edge-color 501>Verthunder III</ui-edge-color></ui-color>, <ui-color 500><ui-edge-color 501>Veraero III</ui-edge-color></ui-color><else><ui-color 500><ui-edge-color 501>Verthunder</ui-edge-color></ui-color>, <ui-color 500><ui-edge-color 501>Veraero</ui-edge-color></ui-color></if><else><ui-color 500><ui-edge-color 501>Verthunder</ui-edge-color></ui-color>, <ui-color 500><ui-edge-color 501>Veraero</ui-edge-color></ui-color></if>, or <if ($gn68 == 35)><if ($gn72 >= 66)><ui-color 500><ui-edge-color 501>Impact</ui-edge-color></ui-color><else><ui-color 500><ui-edge-color 501>Scatter</ui-edge-color></ui-color></if><else><ui-color 500><ui-edge-color 501>Scatter</ui-edge-color></ui-color></if> can be cast immediately.<br><ui-color 504><ui-edge-color 505>Duration: </ui-edge-color></ui-color>20s<br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>Increases the potency of <if ($gn68 == 35)><if ($gn72 >= 66)><ui-color 500><ui-edge-color 501>Impact</ui-edge-color></ui-color><else><ui-color 500><ui-edge-color 501>Scatter</ui-edge-color></ui-color></if><else><ui-color 500><ui-edge-color 501>Scatter</ui-edge-color></ui-color></if> by 50<br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>Ensures <if ($gn68 == 35)><if ($gn72 >= 82)><ui-color 500><ui-edge-color 501>Verthunder III</ui-edge-color></ui-color> and <ui-color 500><ui-edge-color 501>Veraero III</ui-edge-color></ui-color><else><ui-color 500><ui-edge-color 501>Verthunder</ui-edge-color></ui-color> and <ui-color 500><ui-edge-color 501>Veraero</ui-edge-color></ui-color></if><else><ui-color 500><ui-edge-color 501>Verthunder</ui-edge-color></ui-color> and <ui-color 500><ui-edge-color 501>Veraero</ui-edge-color></ui-color></if> trigger <ui-color 506><ui-edge-color 507>Verfire Ready</ui-edge-color></ui-color> or <ui-color 506><ui-edge-color 507>Verstone Ready</ui-edge-color></ui-color> respectively<if ($gn68 == 35)><if ($gn72 >= 96)><br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>Grants <ui-color 506><ui-edge-color 507>Grand Impact Ready</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Duration: </ui-edge-color></ui-color>30s</if></if><if ($gn68 == 35)><if ($gn72 >= 88)><br><ui-color 504><ui-edge-color 505>Maximum Charges: </ui-edge-color></ui-color>2</if></if>"
msgstr "Следующее <if ($gn68 == 35)><if ($gn72 >= 82)><ui-color 500><ui-edge-color 501>Верогром III</ui-edge-color></ui-color>, <ui-color 500><ui-edge-color 501>Веровет III</ui-edge-color></ui-color><else><ui-color 500><ui-edge-color 501>Верогром</ui-edge-color></ui-color>, <ui-color 500><ui-edge-color 501>Веровет</ui-edge-color></ui-color></if><else><ui-color 500><ui-edge-color 501>Верогром</ui-edge-color></ui-color>, <ui-color 500><ui-edge-color 501>Веровет</ui-edge-color></ui-color></if> или <if ($gn68 == 35)><if ($gn72 >= 66)><ui-color 500><ui-edge-color 501>Импакт</ui-edge-color></ui-color><else><ui-color 500><ui-edge-color 501>Рассеивание</ui-edge-color></ui-color></if><else><ui-color 500><ui-edge-color 501>Рассеивание</ui-edge-color></ui-color></if> можно применить мгновенно.<br><ui-color 504><ui-edge-color 505>Длительность: </ui-edge-color></ui-color>20 сек.<br><ui-color 504><ui-edge-color 505>Дополнительный эффект: </ui-edge-color></ui-color>сила действия <if ($gn68 == 35)><if ($gn72 >= 66)><ui-color 500><ui-edge-color 501>Импакт</ui-edge-color></ui-color><else><ui-color 500><ui-edge-color 501>Рассеивание</ui-edge-color></ui-color></if><else><ui-color 500><ui-edge-color 501>Рассеивание</ui-edge-color></ui-color></if> увеличивается на 50.<br><ui-color 504><ui-edge-color 505>Дополнительный эффект: </ui-edge-color></ui-color>при применении <if ($gn68 == 35)><if ($gn72 >= 82)><ui-color 500><ui-edge-color 501>Верогрома III</ui-edge-color></ui-color> и <ui-color 500><ui-edge-color 501>Веролета III</ui-edge-color></ui-color><else><ui-color 500><ui-edge-color 501>Верогрома</ui-edge-color></ui-color> и <ui-color 500><ui-edge-color 501>Веролета</ui-edge-color></ui-color></if><else><ui-color 500><ui-edge-color 501>Верогрома</ui-edge-color></ui-color> и <ui-color 500><ui-edge-color 501>Веролета</ui-edge-color></ui-color></if> гарантированно дает эффект <ui-color 506><ui-edge-color 507>«Готовность к Верогню»</ui-edge-color></ui-color> или <ui-color 506><ui-edge-color 507>«Готовность к Верокамню»</ui-edge-color></ui-color> соответственно<if ($gn68 == 35)><if ($gn72 >= 96)><br><ui-color 504><ui-edge-color 505>Дополнительный эффект: </ui-edge-color></ui-color>дает эффект <ui-color 506><ui-edge-color 507>«Готовность к Великому импакту»</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Длительность: </ui-edge-color></ui-color>30 сек.</if></if><if ($gn68 == 35)><if ($gn72 >= 88)><br><ui-color 504><ui-edge-color 505>Максимум зарядов: </ui-edge-color></ui-color>2</if></if>"

#. ja: 対象とその周囲の敵に範囲物理攻撃。　<ui-color 504><ui-edge-color 505>威力：</ui-edge-color></ui-color><if ($gn68 == 35)><if ($gn72 >= 94)>{420}<else>{380}</if><else>{380}</if>
#. de: Du führst eine physische Attacke auf das Ziel und die Gegner in seiner Nähe aus.<br>Attacke-Wert: <if ($gn68 == 35)><if ($gn72 >= 94)>{420}<else>{380}</if><else>{380}</if>
#. fr: Effectue une attaque physique sur la cible et les ennemis autour.<br><ui-color 506><ui-edge-color 507>Puissance<nbsp>:</ui-edge-color></ui-color> <if ($gn68 == 35)><if ($gn72 >= 94)>{420}<else>{380}</if><else>{380}</if>
