msgid "Deals unaspected damage with a potency of 320.<br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>Grants 4 stacks of <ui-color 506><ui-edge-color 507>Requiescat</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Requiescat Effect: </ui-edge-color></ui-color>Increases the potency of <if ($gn68 == 19)><if ($gn72 >= 90)><ui-color 500><ui-edge-color 501>Holy Spirit</ui-edge-color></ui-color>,  <ui-color 500><ui-edge-color 501>Holy Circle</ui-edge-color></ui-color>, and all <ui-color 500><ui-edge-color 501>Confiteor</ui-edge-color></ui-color> combo actions,<else><if ($gn68 == 19)><if ($gn72 >= 80)><ui-color 500><ui-edge-color 501>Holy Spirit</ui-edge-color></ui-color>,  <ui-color 500><ui-edge-color 501>Holy Circle</ui-edge-color></ui-color>, and <ui-color 500><ui-edge-color 501>Confiteor</ui-edge-color></ui-color>,<else><if ($gn68 == 19)><if ($gn72 >= 72)><ui-color 500><ui-edge-color 501>Holy Spirit</ui-edge-color></ui-color> and <ui-color 500><ui-edge-color 501>Holy Circle</ui-edge-color></ui-color>,<else><ui-color 500><ui-edge-color 501>Holy Spirit</ui-edge-color></ui-color></if><else><ui-color 500><ui-edge-color 501>Holy Spirit</ui-edge-color></ui-color></if></if><else><if ($gn68 == 19)><if ($gn72 >= 72)><ui-color 500><ui-edge-color 501>Holy Spirit</ui-edge-color></ui-color> and <ui-color 500><ui-edge-color 501>Holy Circle</ui-edge-color></ui-color>,<else><ui-color 500><ui-edge-color 501>Holy Spirit</ui-edge-color></ui-color></if><else><ui-color 500><ui-edge-color 501>Holy Spirit</ui-edge-color></ui-color></if></if></if><else><if ($gn68 == 19)><if ($gn72 >= 80)><ui-color 500><ui-edge-color 501>Holy Spirit</ui-edge-color></ui-color>,  <ui-color 500><ui-edge-color 501>Holy Circle</ui-edge-color></ui-color>, and <ui-color 500><ui-edge-color 501>Confiteor</ui-edge-color></ui-color>,<else><if ($gn68 == 19)><if ($gn72 >= 72)><ui-color 500><ui-edge-color 501>Holy Spirit</ui-edge-color></ui-color> and <ui-color 500><ui-edge-color 501>Holy Circle</ui-edge-color></ui-color>,<else><ui-color 500><ui-edge-color 501>Holy Spirit</ui-edge-color></ui-color></if><else><ui-color 500><ui-edge-color 501>Holy Spirit</ui-edge-color></ui-color></if></if><else><if ($gn68 == 19)><if ($gn72 >= 72)><ui-color 500><ui-edge-color 501>Holy Spirit</ui-edge-color></ui-color> and <ui-color 500><ui-edge-color 501>Holy Circle</ui-edge-color></ui-color>,<else><ui-color 500><ui-edge-color 501>Holy Spirit</ui-edge-color></ui-color></if><else><ui-color 500><ui-edge-color 501>Holy Spirit</ui-edge-color></ui-color></if></if></if> and spells will require no cast time<if ($gn68 == 19)><if ($gn72 >= 80)><br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>Grants <ui-color 506><ui-edge-color 507>Confiteor Ready</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Duration: </ui-edge-color></ui-color>30s</if></if>"
msgstr "Наносит цели магический урон без элемента с potency 320.<br><ui-color 504><ui-edge-color 505>Дополнительный эффект:</ui-edge-color></ui-color> даёт 4 заряда эффекта <ui-color 506><ui-edge-color 507>«Реквиската»</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Эффект «Реквиската»:</ui-edge-color></ui-color> увеличивает potency заклинаний <if ($gn68 == 19)><if ($gn72 >= 90)><ui-color 500><ui-edge-color 501>Святой дух</ui-edge-color></ui-color> и <ui-color 500><ui-edge-color 501>Святой круг</ui-edge-color></ui-color>, а также <ui-color 500><ui-edge-color 501>Конфитеор</ui-edge-color></ui-color> и следующих за ним комбо-действий,<else><if ($gn68 == 19)><if ($gn72 >= 80)><ui-color 500><ui-edge-color 501>Святой дух</ui-edge-color></ui-color>, <ui-color 500><ui-edge-color 501>Святой круг</ui-edge-color></ui-color> и <ui-color 500><ui-edge-color 501>Конфитеор</ui-edge-color></ui-color>,<else><if ($gn68 == 19)><if ($gn72 >= 72)><ui-color 500><ui-edge-color 501>Святой дух</ui-edge-color></ui-color> и <ui-color 500><ui-edge-color 501>Святой круг</ui-edge-color></ui-color>,<else><ui-color 500><ui-edge-color 501>Святой дух</ui-edge-color></ui-color></if><else><ui-color 500><ui-edge-color 501>Святой дух</ui-edge-color></ui-color></if></if><else><if ($gn68 == 19)><if ($gn72 >= 72)><ui-color 500><ui-edge-color 501>Святой дух</ui-edge-color></ui-color> и <ui-color 500><ui-edge-color 501>Святой круг</ui-edge-color></ui-color>,<else><ui-color 500><ui-edge-color 501>Святой дух</ui-edge-color></ui-color></if><else><ui-color 500><ui-edge-color 501>Святой дух</ui-edge-color></ui-color></if></if></if><else><if ($gn68 == 19)><if ($gn72 >= 80)><ui-color 500><ui-edge-color 501>Святой дух</ui-edge-color></ui-color>, <ui-color 500><ui-edge-color 501>Святой круг</ui-edge-color></ui-color> и <ui-color 500><ui-edge-color 501>Конфитеор</ui-edge-color></ui-color>,<else><if ($gn68 == 19)><if ($gn72 >= 72)><ui-color 500><ui-edge-color 501>Святой дух</ui-edge-color></ui-color> и <ui-color 500><ui-edge-color 501>Святой круг</ui-edge-color></ui-color>,<else><ui-color 500><ui-edge-color 501>Святой дух</ui-edge-color></ui-color></if><else><ui-color 500><ui-edge-color 501>Святой дух</ui-edge-color></ui-color></if></if><else><if ($gn68 == 19)><if ($gn72 >= 72)><ui-color 500><ui-edge-color 501>Святой дух</ui-edge-color></ui-color> и <ui-color 500><ui-edge-color 501>Святой круг</ui-edge-color></ui-color>,<else><ui-color 500><ui-edge-color 501>Святой дух</ui-edge-color></ui-color></if><else><ui-color 500><ui-edge-color 501>Святой дух</ui-edge-color></ui-color></if></if></if> и позволяет произносить заклинания мгновенно<if ($gn68 == 19)><if ($gn72 >= 80)><br><ui-color 504><ui-edge-color 505>Дополнительный эффект:</ui-edge-color></ui-color> даёт эффект <ui-color 506><ui-edge-color 507>«Конфитеор готов»</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Длительность:</ui-edge-color></ui-color> 30 сек.</if></if>"

