msgid "Deals unaspected damage with a potency of 180 to target and all enemies nearby it.<br>Can only be executed while in <ui-color 506><ui-edge-color 507>Dreadwyrm Trance</ui-edge-color></ui-color>.<br><br>※This action cannot be assigned to a hotbar.<br>※<ui-color 500><ui-edge-color 501><if ($gn68 == 27)><if ($gn72 >= 74)>Tri-disaster<else>Outburst</if><else>Outburst</if></ui-edge-color></ui-color> changes to <ui-color 500><ui-edge-color 501>Astral Flare</ui-edge-color></ui-color> when requirements for execution are met."
msgstr "Наносит цели и всем противникам поблизости магический урон без элемента силой 180.<br>Можно выполнить только под действием <ui-color 506><ui-edge-color 507>«Транса Древнего дракона»</ui-edge-color></ui-color>.<br><br>※Действие нельзя поместить на панель команд.<br>※При выполнении условий <ui-color 500><ui-edge-color 501><if ($gn68 == 27)><if ($gn72 >= 74)>«Тройная катастрофа»<else>«Всплеск»</if><else>«Всплеск»</if></ui-edge-color></ui-color> превращается в <ui-color 500><ui-edge-color 501>«Астральный взрыв»</ui-edge-color></ui-color>."

#. ja: 特定のアクションの実行時に、このアクションが変化する。<br><ui-color 504><ui-edge-color 505><if ($gn72 >= 70)><if ($gn68 == 27)>サモン・バハムート<else>トランス・バハムート</if><else>トランス・バハムート</if>実行時：</ui-edge-color></ui-color><ui-color 500><ui-edge-color 501>「デスフレア」</ui-edge-color></ui-color>に変化する。<if ($gn68 == 27)><if ($gn72 >= 80)><br><ui-color 504><ui-edge-color 505>サモン・フェニックス実行時：</ui-edge-color></ui-color><ui-color 500><ui-edge-color 501>「再生の炎」</ui-edge-color></ui-color>に変化する。</if></if><if ($gn68 == 27)><if ($gn72 >= 86)><br><ui-color 504><ui-edge-color 505><if ($gn68 == 27)><if ($gn72 >= 90)>サモン・イフリートII<else>サモン・イフリート</if><else>サモン・イフリート</if>実行時：</ui-edge-color></ui-color><ui-color 500><ui-edge-color 501>「クリムゾンサイクロン」</ui-edge-color></ui-color>に変化する。<br><ui-color 504><ui-edge-color 505>トパーズ・リチュアルおよびトパーズ・カタストロフィ実行時：</ui-edge-color></ui-color><ui-color 500><ui-edge-color 501>「マウンテンバスター」</ui-edge-color></ui-color>に変化する。<br><ui-color 504><ui-edge-color 505><if ($gn68 == 27)><if ($gn72 >= 90)>サモン・ガルーダII<else>サモン・ガルーダ</if><else>サモン・ガルーダ</if>実行時：</ui-edge-color></ui-color><ui-color 500><ui-edge-color 501>「スリップストリーム」</ui-edge-color></ui-color>に変化する。</if></if><if ($gn68 == 27)><if ($gn72 >= 100)><br><ui-color 504><ui-edge-color 505>サモン・ソルバハムート実行時：</ui-edge-color></ui-color><ui-color 500><ui-edge-color 501>「ソルフレア」</ui-edge-color></ui-color>に変化する。</if></if>
#. de: Dieses Kommando ändert sich bei Ausführung bestimmter anderer Kommandos.<br>Bei <if ($gn72 >= 70)><if ($gn68 == 27)><ui-color 502><ui-edge-color 503>Bahamut-Beschwörung</ui-edge-color></ui-color><else><ui-color 502><ui-edge-color 503>Bahamut-Trance</ui-edge-color></ui-color></if><else><ui-color 502><ui-edge-color 503>Bahamut-Trance</ui-edge-color></ui-color></if>: <ui-color 502><ui-edge-color 503>Todesflamme</ui-edge-color></ui-color><if ($gn68 == 27)><if ($gn72 >= 80)><br>Bei <ui-color 502><ui-edge-color 503>Phönix-Trance</ui-edge-color></ui-color>: <ui-color 502><ui-edge-color 503>Wiederaufleben</ui-edge-color></ui-color></if></if><if ($gn68 == 27)><if ($gn72 >= 86)><br>Bei <if ($gn68 == 27)><if ($gn72 >= 90)><ui-color 502><ui-edge-color 503>Rubin-Ifrit-Beschwörung</ui-edge-color></ui-color><else><ui-color 502><ui-edge-color 503>Ifrit-Beschwörung</ui-edge-color></ui-color></if><else><ui-color 502><ui-edge-color 503>Ifrit-Beschwörung</ui-edge-color></ui-color></if>: <ui-color 502><ui-edge-color 503>Zinnober-Zyklon</ui-edge-color></ui-color><br>Bei <ui-color 502><ui-edge-color 503>Topas-Ritus</ui-edge-color></ui-color> oder <ui-color 502><ui-edge-color 503>Topas-Verderben</ui-edge-color></ui-color>: <ui-color 502><ui-edge-color 503>Bergsprenger</ui-edge-color></ui-color><br>Bei <if ($gn68 == 27)><if ($gn72 >= 90)><ui-color 502><ui-edge-color 503>Smaragd-Garuda-Beschwörung</ui-edge-color></ui-color><else><ui-color 502><ui-edge-color 503>Garuda-Beschwörung</ui-edge-color></ui-color></if><else><ui-color 502><ui-edge-color 503>Garuda-Beschwörung</ui-edge-color></ui-color></if>: <ui-color 502><ui-edge-color 503>Wirbelströmung</ui-edge-color></ui-color></if></if><if ($gn68 == 27)><if ($gn72 >= 100)><br>Bei <ui-color 502><ui-edge-color 503>Sol-Bahamut-Beschwörung</ui-edge-color></ui-color>: <ui-color 502><ui-edge-color 503>Sol-Flare</ui-edge-color></ui-color></if></if>
#. fr: L'effet de cette action dépend de celle qui la précède.<br><br><ui-color 506><ui-edge-color 507>Après <if ($gn72 >= 70)><if ($gn68 == 27)>Invocation Bahamut<else>Transe-Bahamut</if><else>Transe-Bahamut</if><nbsp>:</ui-edge-color></ui-color> devient <ui-color 500><ui-edge-color 501>Brasier de mort</ui-edge-color></ui-color>.<if ($gn68 == 27)><if ($gn72 >= 80)><br><ui-color 506><ui-edge-color 507>Après Invocation Phénix<nbsp>:</ui-edge-color></ui-color> devient <ui-color 500><ui-edge-color 501>Ravivement</ui-edge-color></ui-color>.</if></if><if ($gn68 == 27)><if ($gn72 >= 86)><br><ui-color 506><ui-edge-color 507>Après <if ($gn68 == 27)><if ($gn72 >= 90)>Invocation Ifrit II<else>Invocation Ifrit</if><else>Invocation Ifrit</if><nbsp>:</ui-edge-color></ui-color> devient <ui-color 500><ui-edge-color 501>Cyclone écarlate</ui-edge-color></ui-color>.<br><ui-color 506><ui-edge-color 507>Après Rite de topaze ou Cataclysme de topaze<nbsp>:</ui-edge-color></ui-color> devient <ui-color 500><ui-edge-color 501>Casse-montagnes</ui-edge-color></ui-color>.<br><ui-color 506><ui-edge-color 507>Après <if ($gn68 == 27)><if ($gn72 >= 90)>Invocation Garuda II<else>Invocation Garuda</if><else>Invocation Garuda</if><nbsp>:</ui-edge-color></ui-color> devient <ui-color 500><ui-edge-color 501>Sillage</ui-edge-color></ui-color>.</if></if><if ($gn68 == 27)><if ($gn72 >= 100)><br><ui-color 506><ui-edge-color 507>Après Invocation Sol-Bahamut<nbsp>:</ui-edge-color></ui-color> devient <ui-color 500><ui-edge-color 501>Brasier solaire</ui-edge-color></ui-color>.</if></if>
