msgctxt "ActionTransient:2876:0:0"
msgid "Guarantees that next weaponskill is a critical direct hit.<br><ui-color 504><ui-edge-color 505>Duration:</ui-edge-color></ui-color> 5s<br>Increases damage dealt when under an effect that raises critical hit rate or direct hit rate.<br>This action does not affect damage over time effects.<if ($gn68 == 31)><if ($gn72 >= 84)><br><ui-color 504><ui-edge-color 505>Maximum Charges: </ui-edge-color></ui-color>2</if></if>"
msgstr "Следующая техника оружия гарантированно станет критическим прямым попаданием.<br><ui-color 504><ui-edge-color 505>Длительность:</ui-edge-color></ui-color> 5 сек.<br>Если действует эффект, повышающий вероятность критического или прямого попадания, наносимый урон увеличивается.<br>Не влияет на периодический урон.<if ($gn68 == 31)><if ($gn72 >= 84)><br><ui-color 504><ui-edge-color 505>Максимум зарядов: </ui-edge-color></ui-color>2</if></if>"

#. ja: 対象に40％ヘヴィを付与する　<ui-color 504><ui-edge-color 505>効果時間：</ui-edge-color></ui-color>12秒<br><ui-color 504><ui-edge-color 505>※PvPエリアでの効果時間：</ui-edge-color></ui-color>8秒<if ($gn72 >= 22)><if ($gn68 == 31)><br>リキャストタイマーを<ui-color 500><ui-edge-color 501>「フットグレイズ」</ui-edge-color></ui-color>と共有する。</if></if>
