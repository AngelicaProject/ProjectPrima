msgid "Deals damage to target and all enemies nearby it with a potency of 130 for the first enemy, and 30% less for all remaining enemies.<br><ui-color 504><ui-edge-color 505>Maximum Charges: </ui-edge-color></ui-color><if ($gn68 == 31)><if ($gn72 >= 74)>{3}<else>{2}</if><else>{2}</if>"
