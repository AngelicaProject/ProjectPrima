msgid "Delivers an attack with a potency of 100 to all nearby enemies.<if ($gn68 == 30)><if ($gn72 >= 62)><br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>Increases <ui-color 500><ui-edge-color 501>Ninki Gauge</ui-edge-color></ui-color> by 5</if></if>"
