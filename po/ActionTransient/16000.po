msgctxt "ActionTransient:16164:0:0"
msgid "Draws aetheric energy from target, adding <if ($gn68 == 37)><if ($gn72 >= 88)>{3}<else>{2}</if><else>{2}</if> <ui-color 506><ui-edge-color 507>Cartridges</ui-edge-color></ui-color> to your <ui-color 500><ui-edge-color 501>Powder Gauge</ui-edge-color></ui-color>, and increasing maximum <ui-color 506><ui-edge-color 507>Cartridges</ui-edge-color></ui-color> to <if ($gn68 == 37)><if ($gn72 >= 88)>{6}<else>{4}</if><else>{4}</if>.<br><ui-color 504><ui-edge-color 505>Duration: </ui-edge-color></ui-color>30s<if ($gn68 == 37)><if ($gn72 >= 100)><br><ui-color 504><ui-edge-color 505>Additional Effect:</ui-edge-color></ui-color> Grants <ui-color 506><ui-edge-color 507>Ready to Reign</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Duration: </ui-edge-color></ui-color>30s</if></if>"
msgstr "Извлекает из цели эфирную энергию, добавляя <if ($gn68 == 37)><if ($gn72 >= 88)>{3}<else>{2}</if><else>{2}</if> <ui-color 506><ui-edge-color 507>заряда</ui-edge-color></ui-color> в <ui-color 500><ui-edge-color 501>шкалу пороха</ui-edge-color></ui-color> и увеличивая максимальное число <ui-color 506><ui-edge-color 507>зарядов</ui-edge-color></ui-color> до <if ($gn68 == 37)><if ($gn72 >= 88)>{6}<else>{4}</if><else>{4}</if>.<br><ui-color 504><ui-edge-color 505>Длительность: </ui-edge-color></ui-color>30 сек.<if ($gn68 == 37)><if ($gn72 >= 100)><br><ui-color 504><ui-edge-color 505>Дополнительный эффект:</ui-edge-color></ui-color> Накладывает <ui-color 506><ui-edge-color 507>Царство готово</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Длительность: </ui-edge-color></ui-color>30 сек.</if></if>"

