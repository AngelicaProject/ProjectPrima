msgctxt "ActionTransient:16472:0:0"
msgid "Conjure a simulacrum of your darkside to fight alongside you.<br><ui-color 504><ui-edge-color 505>Duration: </ui-edge-color></ui-color>22s<br><if ($gn68 == 32)><if ($gn72 >= 100)><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>Grants <ui-color 506><ui-edge-color 507>Scorn</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Duration: </ui-edge-color></ui-color>30s<br></if></if><ui-color 504><ui-edge-color 505>Simulacrum Attack Potency: </ui-edge-color></ui-color><if ($gn68 == 32)><if ($gn72 >= 88)>{420}<else>{340}</if><else>{340}</if><if ($gn68 == 32)><if ($gn72 >= 90)><br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>Simulacrum is able to execute <ui-color 500><ui-edge-color 501>Shadowbringer</ui-edge-color></ui-color><if ($gn68 == 32)><if ($gn72 >= 100)> and <ui-color 500><ui-edge-color 501>Disesteem</ui-edge-color></ui-color></if></if><br><ui-color 504><ui-edge-color 505>Shadowbringer Potency:</ui-edge-color></ui-color> 570 for the first enemy, and 25% less for all remaining enemies<if ($gn68 == 32)><if ($gn72 >= 100)><br><ui-color 504><ui-edge-color 505>Disesteem Potency:</ui-edge-color></ui-color> 620 for the first enemy, and 25% less for all remaining enemies</if></if></if></if>"
msgstr "Призывает вашу тёмную тень сражаться рядом.<br><ui-color 504><ui-edge-color 505>Длительность: </ui-edge-color></ui-color>22 сек.<br><if ($gn68 == 32)><if ($gn72 >= 100)><ui-color 504><ui-edge-color 505>Дополнительный эффект: </ui-edge-color></ui-color>Накладывает <ui-color 506><ui-edge-color 507>Презрение</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Длительность: </ui-edge-color></ui-color>30 сек.<br></if></if><ui-color 504><ui-edge-color 505>Мощность атак тёмной тени: </ui-edge-color></ui-color><if ($gn68 == 32)><if ($gn72 >= 88)>{420}<else>{340}</if><else>{340}</if><if ($gn68 == 32)><if ($gn72 >= 90)><br><ui-color 504><ui-edge-color 505>Дополнительный эффект: </ui-edge-color></ui-color>Тёмная тень может выполнить <ui-color 500><ui-edge-color 501>Несущего тень</ui-edge-color></ui-color><if ($gn68 == 32)><if ($gn72 >= 100)> и <ui-color 500><ui-edge-color 501>Презрение</ui-edge-color></ui-color></if></if><br><ui-color 504><ui-edge-color 505>Мощность «Несущего тень»:</ui-edge-color></ui-color> 570 по первому противнику, по остальным на 25% меньше<if ($gn68 == 32)><if ($gn72 >= 100)><br><ui-color 504><ui-edge-color 505>Мощность «Презрения»:</ui-edge-color></ui-color> 620 по первому противнику, по остальным на 25% меньше</if></if></if></if>"

#. ja: 自身の周囲の敵に範囲物理攻撃。　<ui-color 504><ui-edge-color 505>威力：</ui-edge-color></ui-color>140<br><ui-color 504><ui-edge-color 505>追加効果：</ui-edge-color></ui-color>自身に<ui-color 500><ui-edge-color 501>「参の型」</ui-edge-color></ui-color>を付与する。　<ui-color 504><ui-edge-color 505>効果時間：</ui-edge-color></ui-color>30秒<br><ui-color 504><ui-edge-color 505>発動条件：</ui-edge-color></ui-color><ui-color 500><ui-edge-color 501>「弐の型」</ui-edge-color></ui-color>効果中
#. de: Du führst eine physische Attacke auf alle umstehenden Gegner aus.<br>Attacke-Wert: 140<br>Bedingung: <ui-color 506><ui-edge-color 507>Raptor-Form</ui-edge-color></ui-color> aktiv<br>Zusatzeffekt: Du wechselst in die <ui-color 506><ui-edge-color 507>Coeurl-Form</ui-edge-color></ui-color>.<br>Dauer: 30 Sekunden
#. fr: Effectue une attaque physique sur les ennemis alentour.<br><ui-color 506><ui-edge-color 507>Puissance<nbsp>:</ui-edge-color></ui-color> 140<br><ui-color 506><ui-edge-color 507>Effet additionnel<nbsp>:</ui-edge-color></ui-color> posture du <ui-color 500><ui-edge-color 501>coeurl</ui-edge-color></ui-color>.<br><ui-color 506><ui-edge-color 507>Durée<nbsp>:</ui-edge-color></ui-color> 30s<br><ui-color 506><ui-edge-color 507>Condition<nbsp>:</ui-edge-color></ui-color> posture du <ui-color 500><ui-edge-color 501>raptor</ui-edge-color></ui-color>.
