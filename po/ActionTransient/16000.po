msgctxt "ActionTransient:16576:0:0"
msgid "Deals lightning damage with a potency of 200.<br><ui-color 504><ui-edge-color 505>Additional Effect:</ui-edge-color></ui-color> Lightning damage over time<br><ui-color 504><ui-edge-color 505>Potency:</ui-edge-color></ui-color> 40<br><ui-color 504><ui-edge-color 505>Duration:</ui-edge-color></ui-color> 24s"
