msgctxt "ActionTransient:13424:0:0"
msgid "Deals wind damage with a potency of 50.<br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>Wind damage over time<br><ui-color 504><ui-edge-color 505>Potency: </ui-edge-color></ui-color>50<br><ui-color 504><ui-edge-color 505>Duration: </ui-edge-color></ui-color>18s"
msgstr "Наносит урон ветром силой 50.<br><ui-color 504><ui-edge-color 505>Дополнительный эффект: </ui-edge-color></ui-color>периодический урон ветром<br><ui-color 504><ui-edge-color 505>Сила: </ui-edge-color></ui-color>50<br><ui-color 504><ui-edge-color 505>Длительность: </ui-edge-color></ui-color>18 сек."

#. ja: 対象のＨＰを回復する。　<ui-color 504><ui-edge-color 505>回復力：</ui-edge-color></ui-color>700
#. de: Du regenerierst LP des Ziels.<br>Heilpotenzial: 700
#. fr: Restaure des PV à la cible.<br><ui-color 506><ui-edge-color 507>Puissance<nbsp>:</ui-edge-color></ui-color> 700
