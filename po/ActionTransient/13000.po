msgid "Restores target's HP.<br><ui-color 504><ui-edge-color 505>Cure Potency:</ui-edge-color></ui-color> 700"
msgstr "Восстанавливает ОЗ цели.<br><ui-color 504><ui-edge-color 505>Сила лечения:</ui-edge-color></ui-color> 700"

#. ja: 自身のＭＰを回復する。
#. de: Du regenerierst MP.
#. fr: Restaure une partie de vos PM.
msgctxt "ActionTransient:13426:0:0"
msgid "Restores MP."
msgstr "Восстанавливает МП."

#. ja: 対象のＨＰを回復する。　<ui-color 504><ui-edge-color 505>回復力：</ui-edge-color></ui-color>4000<br><ui-color 504><ui-edge-color 505>最大チャージ数：</ui-edge-color></ui-color>2
#. de: Du regenerierst LP des Ziels.<br>Heilpotenzial: 4.000<br>Maximale Aufladungen: 2
#. fr: Restaure les PV de la cible.<br><ui-color 506><ui-edge-color 507>Puissance<nbsp>:</ui-edge-color></ui-color> 4000<br><ui-color 506><ui-edge-color 507>Maximum de charges<nbsp>:</ui-edge-color></ui-color> 2
