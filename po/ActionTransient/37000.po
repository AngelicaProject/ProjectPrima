msgctxt "ActionTransient:37010:0:0"
msgid "Restores own HP and the HP of all nearby party members.<br><ui-color 504><ui-edge-color 505>Cure Potency:</ui-edge-color></ui-color> 250<br><ui-color 504><ui-edge-color 505>Additional Effect:</ui-edge-color></ui-color> <ui-color 506><ui-edge-color 507>Regen</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Cure Potency:</ui-edge-color></ui-color> 175<br><ui-color 504><ui-edge-color 505>Duration:</ui-edge-color></ui-color> 15s"
