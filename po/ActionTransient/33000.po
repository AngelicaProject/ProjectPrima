msgctxt "ActionTransient:33987:0:0"
msgid "Take evasive action in the selected direction.<br><ui-color 504><ui-edge-color 505>Additional Effect:</ui-edge-color></ui-color> Grants <ui-color 506><ui-edge-color 507>Precision</ui-edge-color></ui-color> upon successfully executing a precision dodge<br><ui-color 504><ui-edge-color 505>Duration:</ui-edge-color></ui-color> 10s"
msgstr "Уклоняется в выбранном направлении.<br><ui-color 504><ui-edge-color 505>Дополнительный эффект:</ui-edge-color></ui-color> при точном уклонении даёт эффект <ui-color 506><ui-edge-color 507>«Точность»</ui-edge-color></ui-color>.<br><ui-color 504><ui-edge-color 505>Длительность:</ui-edge-color></ui-color> 10 сек."

