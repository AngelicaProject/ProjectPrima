msgctxt "ActionTransient:3621:0:0"
msgid "Deals unaspected damage with a potency of 120 to all nearby enemies.<br><ui-color 504><ui-edge-color 505>Additional Effect:</ui-edge-color></ui-color> Increased enmity"
msgstr "Наносит ближайшим врагам безэлементный урон силой 120.<br><ui-color 504><ui-edge-color 505>Дополнительный эффект:</ui-edge-color></ui-color> повышает враждебность."

