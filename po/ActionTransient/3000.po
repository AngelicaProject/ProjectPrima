msgctxt "ActionTransient:3538:0:0"
msgid "Delivers an attack with a potency of 700.<br>Can only be executed while under the effect of <ui-color 506><ui-edge-color 507>Goring Blade Ready</ui-edge-color></ui-color>."
msgstr "Наносит удар силой 700.<br>Можно применить, только если действует эффект <ui-color 506><ui-edge-color 507>Готовность «Пронзающего клинка»</ui-edge-color></ui-color>."

#. ja: 対象に物理攻撃。　<ui-color 504><ui-edge-color 505>威力：</ui-edge-color></ui-color><if ($gn68 == 19)><if ($gn72 >= 94)>{200}<else><if ($gn68 == 19)><if ($gn72 >= 84)>{140}<else>{100}</if><else>{100}</if></if><else><if ($gn68 == 19)><if ($gn72 >= 84)>{140}<else>{100}</if><else>{100}</if></if><br><ui-color 504><ui-edge-color 505>コンボ条件：</ui-edge-color></ui-color>ライオットソード　<ui-color 504><ui-edge-color 505>コンボ時威力：</ui-edge-color></ui-color><if ($gn68 == 19)><if ($gn72 >= 94)>{460}<else><if ($gn68 == 19)><if ($gn72 >= 84)>{400}<else>{360}</if><else>{360}</if></if><else><if ($gn68 == 19)><if ($gn72 >= 84)>{400}<else>{360}</if><else>{360}</if></if><if ($gn68 == 19)><if ($gn72 >= 76)><br><ui-color 504><ui-edge-color 505>コンボボーナス：</ui-edge-color></ui-color>自身に<ui-color 500><ui-edge-color 501>「ロイエ実行可」</ui-edge-color></ui-color>を付与する。<br><ui-color 504><ui-edge-color 505>効果時間：</ui-edge-color></ui-color>30秒</if></if><if ($gn68 == 19)><if ($gn72 >= 64)><br><ui-color 504><ui-edge-color 505>コンボボーナス：</ui-edge-color></ui-color>自身に<ui-color 500><ui-edge-color 501>「神聖魔法効果アップ」</ui-edge-color></ui-color>を付与する。<br><ui-color 504><ui-edge-color 505>効果時間：</ui-edge-color></ui-color>30秒<br><ui-color 504><ui-edge-color 505>神聖魔法効果アップ効果：</ui-edge-color></ui-color>次に実行する1回のホーリースピリット<if ($gn68 == 19)><if ($gn72 >= 72)>またはホーリーサークル</if></if>の威力が上昇し、かつ詠唱時間無しで実行できる。</if></if>
#. de: Du führst eine physische Attacke aus.<br>Attacke-Wert: <if ($gn68 == 19)><if ($gn72 >= 94)>{200}<else><if ($gn68 == 19)><if ($gn72 >= 84)>{140}<else>{100}</if><else>{100}</if></if><else><if ($gn68 == 19)><if ($gn72 >= 84)>{140}<else>{100}</if><else>{100}</if></if><br>Kombo-Bedingung: <ui-color 502><ui-edge-color 503>Donnerklinge</ui-edge-color></ui-color><br>Attacke-Wert: <if ($gn68 == 19)><if ($gn72 >= 94)>{460}<else><if ($gn68 == 19)><if ($gn72 >= 84)>{400}<else>{360}</if><else>{360}</if></if><else><if ($gn68 == 19)><if ($gn72 >= 84)>{400}<else>{360}</if><else>{360}</if></if><if ($gn68 == 19)><if ($gn72 >= 76)><br>Bonus: Gewährt dir <ui-color 506><ui-edge-color 507>Königliche Erhabenheit</ui-edge-color></ui-color>.<br>Dauer: 30 Sekunden</if></if><if ($gn68 == 19)><if ($gn72 >= 64)><br>Bonus: Gewährt dir <ui-color 506><ui-edge-color 507>Göttliche Gunst</ui-edge-color></ui-color>.<br>Dauer: 30 Sekunden<br>Effekt von <ui-color 506><ui-edge-color 507>Göttliche Gunst</ui-edge-color></ui-color>: Der nächste <ui-color 502><ui-edge-color 503>Heilige Geist</ui-edge-color></ui-color><if ($gn68 == 19)><if ($gn72 >= 72)> oder <ui-color 502><ui-edge-color 503>Heilige Kreis</ui-edge-color></ui-color></if></if> kann sofort gewirkt werden und hat einen erhöhten Attacke-Wert.</if></if>
