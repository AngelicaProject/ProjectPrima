msgctxt "ActionTransient:3606:0:0"
msgid "Reduces cast times for spells by 2.5 seconds.<br><ui-color 504><ui-edge-color 505>Duration:</ui-edge-color></ui-color> 15s<br><ui-color 504><ui-edge-color 505>Maximum Charges: </ui-edge-color></ui-color>2"
msgstr "Сокращает время произнесения заклинаний на 2,5 сек.<br><ui-color 504><ui-edge-color 505>Длительность:</ui-edge-color></ui-color> 15 сек.<br><ui-color 504><ui-edge-color 505>Максимум зарядов:</ui-edge-color></ui-color> 2"

#. ja: 一定時間、自身の敵視上昇を抑える。<br><ui-color 504><ui-edge-color 505>追加効果：</ui-edge-color></ui-color>自身のＭＰを継続回復する<br><ui-color 504><ui-edge-color 505>効果量：</ui-edge-color></ui-color><if ($gn72 >= 48)><if ($gn68 == 33)>{80}<else>{60}</if><else>{60}</if>　<ui-color 504><ui-edge-color 505>効果時間：</ui-edge-color></ui-color>24秒
