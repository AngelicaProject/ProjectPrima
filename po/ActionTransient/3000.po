msgctxt "ActionTransient:3551:0:0"
msgid "Reduces damage taken by 10%.<br><ui-color 504><ui-edge-color 505>Duration:</ui-edge-color></ui-color> 6s<br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>Restores HP with each weaponskill successfully delivered<br><ui-color 504><ui-edge-color 505>Cure Potency: </ui-edge-color></ui-color>400<if ($gn68 == 21)><if ($gn72 >= 76)><br>Shares a recast timer with <ui-color 500><ui-edge-color 501>Nascent Flash</ui-edge-color></ui-color>.</if></if>"
msgstr "Снижает получаемый урон на 10%.<br><ui-color 504><ui-edge-color 505>Длительность:</ui-edge-color></ui-color> 6 сек.<br><ui-color 504><ui-edge-color 505>Дополнительный эффект:</ui-edge-color></ui-color> каждое успешное попадание оружейным приёмом восстанавливает HP.<br><ui-color 504><ui-edge-color 505>Сила лечения:</ui-edge-color></ui-color> 400<if ($gn68 == 21)><if ($gn72 >= 76)><br>Перезарядка общая с <ui-color 500><ui-edge-color 501>Вспышкой зарождения</ui-edge-color></ui-color>.</if></if>"

#. ja: 自身のＨＰを回復する。　<ui-color 504><ui-edge-color 505>回復力：</ui-edge-color></ui-color>1200<if ($gn68 == 21)><if ($gn72 >= 84)><br><ui-color 504><ui-edge-color 505>追加効果：</ui-edge-color></ui-color>自身のＨＰを継続回復する。<br><ui-color 504><ui-edge-color 505>回復力：</ui-edge-color></ui-color>200　<ui-color 504><ui-edge-color 505>効果時間：</ui-edge-color></ui-color>15秒</if></if>
