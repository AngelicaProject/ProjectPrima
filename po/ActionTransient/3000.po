msgctxt "ActionTransient:3557:0:0"
msgid "Increases critical hit rate of self and nearby party members by 10%.<br><ui-color 504><ui-edge-color 505>Duration:</ui-edge-color></ui-color> 20s"
msgstr "Повышает шанс критического удара для вас и ближайших участников отряда на 10%.<br><ui-color 504><ui-edge-color 505>Длительность:</ui-edge-color></ui-color> 20 сек."

#. ja: 対象に物理攻撃。　<ui-color 504><ui-edge-color 505>威力：</ui-edge-color></ui-color><if ($gn68 == 23)><if ($gn72 >= 94)>{260}<else>{240}</if><else>{240}</if><if ($gn68 == 23)><if ($gn72 >= 68)><br><ui-color 504><ui-edge-color 505>追加効果：</ui-edge-color></ui-color>賢人のバラード、軍神のパイオン、旅神のメヌエットを実行している場合、自身に<ui-color 500><ui-edge-color 501>「詩心」</ui-edge-color></ui-color>が付与される。</if></if>
#. de: Du führst eine physische Attacke aus.<br>Attacke-Wert: <if ($gn68 == 23)><if ($gn72 >= 94)>{260}<else>{240}</if><else>{240}</if><if ($gn68 == 23)><if ($gn72 >= 68)><br>Zusatzeffekt: Gewährt <ui-color 506><ui-edge-color 507>Virtuose</ui-edge-color></ui-color>, wenn <ui-color 502><ui-edge-color 503>Ballade des Weisen</ui-edge-color></ui-color>, <ui-color 502><ui-edge-color 503>Hymne der Krieger</ui-edge-color></ui-color> oder <ui-color 502><ui-edge-color 503>Menuett des Wanderers</ui-edge-color></ui-color> gesungen wird.</if></if>
#. fr: Effectue une attaque physique sur la cible.<br><ui-color 506><ui-edge-color 507>Puissance<nbsp>:</ui-edge-color></ui-color> <if ($gn68 == 23)><if ($gn72 >= 94)>{260}<else>{240}</if><else>{240}</if><if ($gn68 == 23)><if ($gn72 >= 68)><br><ui-color 506><ui-edge-color 507>Effet additionnel<nbsp>:</ui-edge-color></ui-color> vous octroie <ui-color 500><ui-edge-color 501>Inspiration poétique</ui-edge-color></ui-color> sous l'effet de Ballade du mage, Péan martial ou Menuet du Vagabond.</if></if>
