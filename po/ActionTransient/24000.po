msgctxt "ActionTransient:24316:0:0"
msgid "Deals unaspected damage to target and all enemies nearby it with a potency of <if ($gn68 == 40)><if ($gn72 >= 94)>{380}<else>{330}</if><else>{330}</if> for the first enemy, and 50% less for all remaining enemies.<br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>Restores HP to targets under the effect of <ui-color 506><ui-edge-color 507>Kardion</ui-edge-color></ui-color> granted by you<br><ui-color 504><ui-edge-color 505>Cure Potency: </ui-edge-color></ui-color><if ($gn68 == 40)><if ($gn72 >= 85)>{170}<else>{130}</if><else>{130}</if><br><ui-color 504><ui-edge-color 505>Addersting Cost: </ui-edge-color></ui-color>1"
msgstr "Наносит цели и всем врагам рядом с ней магический урон без стихийной принадлежности с силой <if ($gn68 == 40)><if ($gn72 >= 94)>{380}<else>{330}</if><else>{330}</if> первому врагу. Урон по остальным врагам снижен на 50%.<br><ui-color 504><ui-edge-color 505>Дополнительный эффект: </ui-edge-color></ui-color>Восстанавливает ОЗ целей под действием наложенного вами эффекта <ui-color 506><ui-edge-color 507>Кардион</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Сила лечения: </ui-edge-color></ui-color><if ($gn68 == 40)><if ($gn72 >= 85)>{170}<else>{130}</if><else>{130}</if><br><ui-color 504><ui-edge-color 505>Расход змеиного клыка: </ui-edge-color></ui-color>1"

