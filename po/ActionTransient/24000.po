msgctxt "ActionTransient:24283:0:0"
msgid "Deals unaspected damage with a potency of </ui-edge-color></ui-color><if ($gn68 == 40)><if ($gn72 >= 64)>{300}<else><if ($gn68 == 40)><if ($gn72 >= 54)>{250}<else>{180}</if><else>{180}</if></if><else><if ($gn68 == 40)><if ($gn72 >= 54)>{250}<else>{180}</if><else>{180}</if></if>.<br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>Restores HP to targets under the effect of <ui-color 506><ui-edge-color 507>Kardion</ui-edge-color></ui-color> granted by you<br><ui-color 504><ui-edge-color 505>Cure Potency: </ui-edge-color></ui-color><if ($gn68 == 40)><if ($gn72 >= 85)>{170}<else>{130}</if><else>{130}</if>"
msgstr "Наносит магический урон без стихийной принадлежности с силой </ui-edge-color></ui-color><if ($gn68 == 40)><if ($gn72 >= 64)>{300}<else><if ($gn68 == 40)><if ($gn72 >= 54)>{250}<else>{180}</if><else>{180}</if></if><else><if ($gn68 == 40)><if ($gn72 >= 54)>{250}<else>{180}</if><else>{180}</if></if>.<br><ui-color 504><ui-edge-color 505>Дополнительный эффект: </ui-edge-color></ui-color>Восстанавливает ОЗ цели под действием наложенного вами эффекта <ui-color 506><ui-edge-color 507>Кардия</ui-edge-color></ui-color>.<br><ui-color 504><ui-edge-color 505>Сила лечения: </ui-edge-color></ui-color><if ($gn68 == 40)><if ($gn72 >= 85)>{170}<else>{130}</if><else>{130}</if>"

