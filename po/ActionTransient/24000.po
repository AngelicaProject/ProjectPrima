msgctxt "ActionTransient:24285:0:0"
msgid "Grants self the effect of <ui-color 506><ui-edge-color 507>Kardia</ui-edge-color></ui-color> and a selected party member or self the effect of <ui-color 506><ui-edge-color 507>Kardion</ui-edge-color></ui-color>, restoring HP after landing certain magic attacks.<br><ui-color 504><ui-edge-color 505>Cure Potency: </ui-edge-color></ui-color><if ($gn68 == 40)><if ($gn72 >= 85)>{170}<else>{130}</if><else>{130}</if>"
msgstr "Накладывает на себя эффект <ui-color 506><ui-edge-color 507>Кардия</ui-edge-color></ui-color>, а на выбранного участника группы или на себя — эффект <ui-color 506><ui-edge-color 507>Кардия</ui-edge-color></ui-color>. Попадание некоторыми магическими атаками восстанавливает ОЗ цели под действием эффекта.<br><ui-color 504><ui-edge-color 505>Сила лечения: </ui-edge-color></ui-color><if ($gn68 == 40)><if ($gn72 >= 85)>{170}<else>{130}</if><else>{130}</if>"

