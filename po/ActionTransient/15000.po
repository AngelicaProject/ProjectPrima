msgctxt "ActionTransient:15870:0:0"
msgid "Increases physical damage dealt by 25%.<br><ui-color 504><ui-edge-color 505>Duration:</ui-edge-color></ui-color> 25s"
msgstr "Увеличивает наносимый физический урон на 25%.<br><ui-color 504><ui-edge-color 505>Длительность:</ui-edge-color></ui-color> 25 с"

