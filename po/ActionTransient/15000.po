msgid "Delivers an attack with a potency of <if ($gn68 == 38)><if ($gn72 >= 94)>{220}<else>{200}</if><else>{200}</if>.<br><if ($gn68 == 38)><if ($gn72 >= 20)><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>50% chance of granting <ui-color 506><ui-edge-color 507>Silken Symmetry</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Duration: </ui-edge-color></ui-color>30s</if></if>"
