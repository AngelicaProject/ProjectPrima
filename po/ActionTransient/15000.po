msgid "Delivers an attack with a potency of <if ($gn68 == 38)><if ($gn72 >= 94)>{120}<else>{100}</if><else>{100}</if>.<br><ui-color 504><ui-edge-color 505>Combo Action: </ui-edge-color></ui-color><ui-color 500><ui-edge-color 501>Cascade</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Combo Potency: </ui-edge-color></ui-color><if ($gn68 == 38)><if ($gn72 >= 94)>{280}<else>{260}</if><else>{260}</if><br><if ($gn68 == 38)><if ($gn72 >= 40)><ui-color 504><ui-edge-color 505>Combo Bonus: </ui-edge-color></ui-color>50% chance of granting <ui-color 506><ui-edge-color 507>Silken Flow</ui-edge-color></ui-color><br><ui-color 504><ui-edge-color 505>Duration: </ui-edge-color></ui-color>30s</if></if>"
