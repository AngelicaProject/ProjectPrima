msgid "Deals unaspected damage with a potency of 1,800 to target and all enemies nearby it.<br><ui-color 504><ui-edge-color 505>Polyglot Cost: </ui-edge-color></ui-color>1"
msgstr "Наносит нейтральный магический урон цели и всем ближайшим противникам силой 1800.<br><ui-color 504><ui-edge-color 505>Расход «Полиглота»:</ui-edge-color></ui-color> 1"

