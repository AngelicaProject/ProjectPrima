msgid "Cancel."
msgstr "Отмена."

#. ja: 交換しますか？
#. de: Milch abliefern?
#. fr: Tu as du lait pour moi<nbsp>?
#. column 60: ありがとう
#. column 62: ミルク取ってきて
msgctxt "FateEvent:384:0:56"
msgid "交換しますか？"
msgstr "Обменяться?"

#. ja: ありがとう
#. de: Vielen Dank!
#. fr: Merci.
#. column 56: 交換しますか？
#. column 62: ミルク取ってきて
