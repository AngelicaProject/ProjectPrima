msgid "Aid in the milking of the sheep?<br><br><ui-color 500><ui-edge-color 501>※The recommended level for this FATE is <num $n1>.</ui-edge-color></ui-color>"
msgstr "Помочь подоить овец?<br><br><ui-color 500><ui-edge-color 501>※ Рекомендуемый уровень для этого FATE: <num $n1>.</ui-edge-color></ui-color>"

#. ja: キャンセル
#. de: Abbrechen
#. fr: キャンセル
#. column 56: Aid in the milking of the sheep?<br><br><ui-color 500><ui-edge-color 501>※The recommended level for this FATE is <num $n1>.</ui-edge-color></ui-color>
