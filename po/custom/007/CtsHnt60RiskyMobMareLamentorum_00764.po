msgid "Tell me about the rank B elite mark. (Level Cheater)"
msgstr "Расскажи об элитной цели ранга B. (Обманщик уровня)"

#. ja: ランクA：改良型兵器「アーチイータ」について
#. de: Erzähl mir mehr über das Hochwild vom Rang A. (Erz-Eta)
#. fr: La cible de rang A “Arch-Êta”
msgctxt "custom/007/CtsHnt60RiskyMobMareLamentorum_00764:TEXT_CTSHNT60RISKYMOBMARELAMENTORUM_00764_CHRYSIELLE_A3_000_003:1"
msgid "Tell me about the rank A elite mark. (Arch-Eta)"
msgstr "Расскажи об элитной цели ранга A. (Арх-эта)"

#. ja: ランクA：純血の竜族「ファン・アイル」について
#. de: Erzähl mir mehr über das Hochwild vom Rang A. (Fan Ail)
#. fr: La cible de rang A “Fan Ail”
msgctxt "custom/007/CtsHnt60RiskyMobMareLamentorum_00764:TEXT_CTSHNT60RISKYMOBMARELAMENTORUM_00764_CHRYSIELLE_A3_000_004:1"
msgid "Tell me about the rank A elite mark. (Fan Ail)"
msgstr "Расскажи об элитной цели ранга A. (Фан Айл)"

#. ja: ランクS：至高の精神「ナロー＝リフト」について
#. de: Erzähl mir mehr über das Hochwild vom Rang S. (Enger Riss)
#. fr: La cible de rang S “Rift-étroit”
