# custom/000/CmnBhtRewardLv020St0003_00025
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: どうした？　任務中だぞ！<br>まさか戦いを放棄し、撤退したいとでも？
#. de: Was ist los? Wir sind auf einer Mission! Willst du etwa allen Ernstes aufgeben?
#. fr: Nous sommes en pleine mission<nbsp>! Ne me dites pas que vous voulez abandonner<nbsp>!?
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_TALK_00:1"
msgid "Time is of the essence. If you have something to ask, make it quick."
msgstr ""

#. ja: 何をしますか？
#. de: Was möchtest du tun?
#. fr: Que voulez-vous faire<nbsp>?
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_MENU_TITLE:1"
msgid "What would you like to do?"
msgstr ""

#. ja: 自分だけ帰還する
#. de: Alleine zum Camp zurückkehren.
#. fr: Renoncer individuellement
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_MENU_00:1"
msgid "Withdraw self from the operation."
msgstr ""

#. ja: パーティで帰還する
#. de: Mit der ganzen Gruppe zum Camp zurückkehren.
#. fr: Renoncer en équipe
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_MENU_01:1"
msgid "Withdraw party from the operation."
msgstr ""

#. ja: 何もしない
#. de: Weitermachen.
#. fr: Annuler
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_MENU_02:1"
msgid "Return to duty."
msgstr ""

#. ja: パーティから離脱しますが、よろしいですか？
#. de: Du verlässt die Gruppe. Ist das dein Ernst?
#. fr: Vous quitterez l'équipe. Confirmez-vous votre choix<nbsp>?
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_RETURN_ME_MENU_TITLE:1"
msgid "You will be removed from your party. Proceed?"
msgstr ""

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_RETURN_ME_MENU_YES:1"
msgid "Yes"
msgstr ""

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_RETURN_ME_MENU_NO:1"
msgid "No"
msgstr ""

#. ja: ギルドオーダーを終了して帰還しますが、よろしいですか？
#. de: Das Gildengeheiß wirklich beenden und zum Ausgangspunkt zurückkehren?
#. fr: L'opération en cours prendra fin. Confirmez-vous votre choix<nbsp>?
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_RETURN_PARTY_MENU_TITLE:1"
msgid "Are you certain?"
msgstr ""

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_RETURN_PARTY_MENU_YES:1"
msgid "Absolutely"
msgstr ""

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_RETURN_PARTY_MENU_NO:1"
msgid "No"
msgstr ""

#. ja: よくやってくれた。<br>これが今回の働きに対する報酬だ。
#. de: Gut gemacht! Hier, das ist der Lohn für deine Mühen. 
#. fr: Beau travail. Voici une récompense proportionnelle à votre performance.
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_RET_TALK_00:1"
msgid "The operation was a success! Here's your reward, and don't let anyone tell you that you didn't earn it."
msgstr ""

#. ja: 全員が特務隊長から報酬を受け取る、<br>もしくは一定時間が経過すると<br>ギルドオーダーが終了し帰還します。
#. de: Ihr verlasst die Instanz, sobald alle Mitglieder ihre Vergütung vom Kommandanten abgeholt haben oder eine bestimmte Zeit verstrichen ist.
#. fr: L'opération de guilde est à présent terminée. Vous quitterez l'instance une fois que tous les joueurs auront récupéré leur récompense ou qu'un certain délai se sera écoulé.
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_RET_SUCCESS_SYSTEM_TALK_00:1"
msgid "You will leave the instance once all party members have collected their rewards."
msgstr ""

#. ja: おいおい、荷物がいっぱいじゃないか。
#. de: Hm, du schleppst doch schon genug mit dir herum. Ich behalte das mal ein, bis du Platz dafür hast.
#. fr: Hé<nbsp>! Votre sac est plein<nbsp>!
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_RET_FAIL_TALK_00:1"
msgid "Well, well. It looks like you have a full bag."
msgstr ""

#. ja: これ以上アイテムを持てないため、<br>報酬を受け取れませんでした。アイテムリストに<br>空欄を作ってから、もう一度報告してください。
#. de: Du konntest die Vergütung nicht aufnehmen, weil dein Inventar voll ist. Schaff etwas Platz und sprich den Zuständigen noch einmal an.
#. fr: Impossible de recevoir la récompense car l'inventaire est plein. Faites de la place et essayez de nouveau.
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_RET_FAIL_SYSTEM_TALK_00:1"
msgid "Make room in your inventory and speak with the battlewarden once again to receive your reward."
msgstr ""

#. ja: 任務の報酬を配っているところだ。<br>待機していてくれ。
#. de: Warte kurz. Ich verteile gerade die Vergütungen für die letzte Expedition.
#. fr: Je distribue les récompenses à vos compagnons. Restez ici un moment.
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_AFTER_RWD_TALK_00:1"
msgid "Can't you see I'm busy attending to your allies? I don't have time to chat."
msgstr ""

#. ja: ひとりで先に帰りますか？
#. de: Willst du alleine zurückkehren?
#. fr: Voulez-vous quitter l'instance sans attendre les autres<nbsp>?
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_AFTER_RWD_MENU_TITLE:1"
msgid "Leave without your party?"
msgstr ""

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_AFTER_RWD_MENU_YES:1"
msgid "Yes"
msgstr ""

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_AFTER_RWD_MENU_NO:1"
msgid "No"
msgstr ""

#. ja: パーティから離脱しますが、よろしいですか？
#. de: Willst du wirklich aus der Gruppe austreten?
#. fr: Vous quitterez l'équipe. Confirmez-vous votre choix<nbsp>?
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_AFTER_RWD_RETURN_MENU_TITLE:1"
msgid "You will be removed from the party. Proceed?"
msgstr ""

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_AFTER_RWD_RETURN_MENU_YES:1"
msgid "Yes"
msgstr ""

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_AFTER_RWD_RETURN_MENU_NO:1"
msgid "No"
msgstr ""

#. ja: よくやってくれた。<br>なかなかの働きぶりじゃないか。<br>報酬にも色を付けておいてやろう。
#. de: Die Operation war erfolgreich! Hier ist deine Vergütung, wie versprochen. Ich habe sie noch ein wenig angehoben und hoffe, du leistet uns auch in Zukunft Unterstützung.
#. fr: Beau travail. J'ai ajouté un petit quelque chose à votre récompense, pour cette fois.
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_FIRST_BONUS_TALK_00:1"
msgid "The operation was a success! Here's your payment, and as promised, I've thrown in a little extra, so that you may consider returning to aid us once again."
msgstr ""

#. ja: 初回達成によるボーナスがつき、<br>報酬が追加されます。
#. de: Weil du das Gildengeheiß zum ersten Mal geschafft hast, wurde deiner Vergütung ein Bonus hinzugefügt.
#. fr: Un bonus est attribué lorsqu'une mission est accomplie pour la première fois.
msgctxt "custom/000/CmnBhtRewardLv020St0003_00025:TEXT_CMNBHTREWARDLV020ST0003_00025_FIRST_BONUS_SYSTEM_TALK_00:1"
msgid "A bonus has been added to your reward."
msgstr ""
