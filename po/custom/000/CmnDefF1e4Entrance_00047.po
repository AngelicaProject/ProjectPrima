#. ja: この先は神勇隊司令室だ。
#. de: Hier geht es zum Kommandozimmer von Bogenmeister Lewin.
#. fr: Derrière cette porte se trouve la salle de commandement du Carquois.
msgctxt "custom/000/CmnDefF1e4Entrance_00047:TEXT_CMNDEFF1E4ENTRANCE_00047_TALK_000:1"
msgid "The Seat of the First Bow lies beyond."
msgstr ""

#. ja: この先、部外者立ち入り禁止だ。
#. de: Unangemeldeten ist der Zutritt zum Kommandozimmer nicht gestattet.
#. fr: Seules les personnes qui ont obtenu une au<shy>to<shy>ri<shy>sa<shy>tion spéciale peuvent passer.
msgctxt "custom/000/CmnDefF1e4Entrance_00047:TEXT_CMNDEFF1E4ENTRANCE_00047_TALK_001:1"
msgid "None but authorized personnel may enter."
msgstr ""

#. ja: 神勇隊司令室へ入りますか？
#. de: Ins Kommandozimmer von Nophicas Schar eintreten?
#. fr: Entrer dans la Salle de commandement<nbsp>?
msgctxt "custom/000/CmnDefF1e4Entrance_00047:TEXT_CMNDEFF1E4ENTRANCE_00047_YESNO_Q:1"
msgid "Proceed to the Seat of the First Bow?"
msgstr ""

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "custom/000/CmnDefF1e4Entrance_00047:TEXT_CMNDEFF1E4ENTRANCE_00047_YESNO_Y:1"
msgid "Yes"
msgstr ""

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "custom/000/CmnDefF1e4Entrance_00047:TEXT_CMNDEFF1E4ENTRANCE_00047_YESNO_N:1"
msgid "No"
msgstr ""
