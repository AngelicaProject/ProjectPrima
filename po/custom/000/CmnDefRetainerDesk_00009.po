msgid "Change a retainer's appearance and nickname."
msgstr "Изменить внешность и прозвище ретейнера"

#. ja: リテイナーの説明を聞きたい
#. de: Mir erklären lassen, wofür Gehilfen gut sind
#. fr: En savoir plus sur les servants
msgctxt "custom/000/CmnDefRetainerDesk_00009:TEXT_CMNDEFRETAINERDESK_00009_MAIN_MENU_EXPLANATION:1"
msgid "Ask about retainers."
msgstr "Узнать о ретейнерах"

#. ja: リテイナーをジョブにしたい
#. de: Erfahren, wie man Gehilfen einen Job zuteilen kann
#. fr: Savoir comment attribuer un job au servant
msgctxt "custom/000/CmnDefRetainerDesk_00009:TEXT_CMNDEFRETAINERDESK_00009_MAIN_MENU_JOBCHANGE:1"
msgid "Inquire about retainer jobs."
msgstr "Узнать о профессиях ретейнеров"

#. ja: 各マーケットの減税情報を知りたい
#. de: Erfahren, wo die Steuern zurzeit niedrig sind
#. fr: S'enquérir des taxes aux marchés
msgctxt "custom/000/CmnDefRetainerDesk_00009:TEXT_CMNDEFRETAINERDESK_00009_MAIN_MENU_CHECK_CASHBACK:1"
msgid "View market tax rates."
msgstr "Узнать о налогах на рынках"

