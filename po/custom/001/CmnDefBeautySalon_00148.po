# custom/001/CmnDefBeautySalon_00148
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 美容師を利用する権利がないため、<br>呼び出すことができません。
#. de: Du hast dir noch nicht das Recht verdient, den Kosmetiker zu rufen.
#. fr: Vous n'avez pas accès aux services de l'esthéticien et ne pouvez donc pas l'appeler.
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_UNQUALIFIED:1"
msgid "You are not authorized to summon the aesthetician."
msgstr "У вас нет права вызывать парикмахера."

#. ja: 美容師を呼びますか？
#. de: Den Kosmetiker rufen?
#. fr: Appeler l'esthéticien<nbsp>?
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_CALL_Q:1"
msgid "Summon the aesthetician?"
msgstr "Вызвать парикмахера?"

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_CALL_YES:1"
msgid "Yes"
msgstr "Да"

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_CALL_NO:1"
msgid "No"
msgstr "Нет"

#. ja: オメーの人生、ザックザクに切り刻んでやんよ！<br>キィィイイルゥゥゥ　オア　ダイッ！
#. de: Mach dich auf etwas gefasst, mon amour! Isch werde dir einen Schnitt verpassen, der deinem tristen Leben ein Ende bereiten wird! Pass nur auf!
#. fr: Mouahaha<nbsp>! Je ne vais pas vous rater avec mes ciseaux<nbsp>!
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_JANDELAINE_000_000:1"
msgid "As once did this very realm, from the darkest depths of unseemly ugliness shall you rise anew. Prepare yourself!"
msgstr "Из самых мрачных глубин безобразия ты возродишься во всём великолепии, как некогда возродился этот мир. Приготовься!"

#. ja: 髪型の変更では、チャットができなくなるなど、<br>プレイヤーの行動に制限がかかることがあります。
#. de: Manche Funktionen, wie zum Beispiel der Chat, sind nicht verfügbar, während du das Aussehen änderst.
#. fr: Vous serez incapable de communiquer avec les autres joueurs ou d'effectuer d'autres actions pendant l'utilisation des services de l'esthéticien.
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_CUSTOMIZE_WARNING:1"
msgid "While customizing your appearance, you will be unable to communicate with players and engage in other activities."
msgstr "Во время смены внешности вы не сможете общаться с игроками и заниматься другими делами."

#. ja: コンテンツファインダーに参加申請している場合、<br>このまま髪型の変更を進めると、<br>参加申請をキャンセルします。
#. de: Wenn du mit dem Ändern deines Aussehens fortfährst, wird deine derzeitige Inhaltssuche abgebrochen.
#. fr: L'utilisation des services de l'esthéticien annule au<shy>to<shy>ma<shy>ti<shy>que<shy>ment tout enregistrement dans l'outil de mission.
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_DUTY_FINDER_WARNING:1"
msgid "Beginning the customization process will automatically cancel your Duty Finder registration."
msgstr "Если продолжить смену внешности, регистрация в Поиске заданий будет отменена."

#. ja: よろしいですか？
#. de: Möchtest du dennoch fortfahren?
#. fr: Utiliser les services de l'esthéticien<nbsp>?
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_DUTY_FINDER_CONFIRM:1"
msgid "Proceed?"
msgstr "Продолжить?"

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_DUTY_FINDER_CONFIRM_YES:1"
msgid "Yes"
msgstr "Да"

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_DUTY_FINDER_CONFIRM_NO:1"
msgid "No"
msgstr "Нет"

#. ja: <kilo $n1 ",">ギルを払いますか？
#. de: <kilo $n1 "."> Gil bezahlen?
#. fr: Payer <kilo $n1 "<nbsp>"> gil<if ($n1 <= 1)><else>s</if><nbsp>?
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_MENU_PAYMENT_A_Q:1"
msgid "Pay 2,000 gil?"
msgstr "Заплатить 2 000 гил?"

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_MENU_PAYMENT_A_YES:1"
msgid "Yes."
msgstr "Да."

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_MENU_PAYMENT_A_NO:1"
msgid "No."
msgstr "Нет."

#. ja: <kilo $n1 ",">ギルを払いますか？<br>それとも「<sheet Item 7005 0>」を使いますか？
#. de: <kilo $n1 "."> Gil bezahlen?<br>Oder <noun-de Item 2 7005 1 4 1> einlösen?
#. fr: Payer <kilo $n1 "<nbsp>"> gil<if ($n1 <= 1)><else>s</if><nbsp>? Ou bien utiliser <noun-fr Item 1 7005 1 1><nbsp>?
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_MENU_PAYMENT_B_Q:1"
msgid "How will you pay?"
msgstr "Как заплатите?"

#. ja: ギルを払う
#. de: In Gil bezahlen
#. fr: Payer
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_MENU_PAYMENT_B_A_GIL:1"
msgid "Pay 2,000 gil."
msgstr "Заплатить 2 000 гил."

#. ja: 「<sheet Item 7005 0>」を使う
#. de: <capitalize><noun-de Item 2 7005 1 4 1></capitalize> einlösen
#. fr: Utiliser <noun-fr Item 1 7005 1 1>
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_MENU_PAYMENT_B_A_TICKET:1"
msgid "Use a token."
msgstr "Использовать жетон."

#. ja: 「<sheet Item 7005 0>」を使いますか？
#. de: <capitalize><noun-de Item 2 7005 1 4 1></capitalize> einlösen?
#. fr: Utiliser <noun-fr Item 1 7005 1 1><nbsp>?
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_MENU_PAYMENT_C_Q:1"
msgid "Use Jandelaine's token?"
msgstr "Использовать жетон Жанделейна?"

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_MENU_PAYMENT_C_YES:1"
msgid "Yes."
msgstr "Да."

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_MENU_PAYMENT_C_NO:1"
msgid "No."
msgstr "Нет."

#. ja: どうだ……新世界に生まれ変わった気分はよ？<br>……バラ色だろ？<br>誕生日おめでとさん！
#. de: Voilà, fertig! Schau in den Spiegel ... Aber mache dich auf eine <i>Erfahrung metaphysique</i> gefasst!<br>'erzlichen Glückwunsch, mon amour!
#. fr: Alors<nbsp>? Qu'est-ce que ça fait d'être com<shy>plè<shy>te<shy>ment changé<if $gn4>e</if><nbsp>? Vous voyez maintenant la vie en rose, j'en suis sûr.
#. macro: <if $gn4>woman<else>man</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_JANDELAINE_000_010:1"
msgid "Where once stood a disheveled shell of a <if $gn4>woman<else>man</if>, there now shines...a beauty reborn."
msgstr "На месте растрёпанного <if $gn4>женского<else>мужского</if> образа теперь сияет... новая красота."

#. ja: また、必ず会えると信じてるぜ。
#. de: Vielleischt ein andern Mal! Au revoir!
#. fr: Bon, il faut que je file, j'ai d'autres rendez-vous. À bientôt<nbsp>!
msgctxt "custom/001/CmnDefBeautySalon_00148:TEXT_CMNDEFBEAUTYSALON_00148_JANDELAINE_000_015:1"
msgid "When your star begins to dim, you need only send for Jandelaine. Till we meet again!"
msgstr "Когда твоя звезда начнёт тускнеть, просто позови Жанделейна. До встречи!"
