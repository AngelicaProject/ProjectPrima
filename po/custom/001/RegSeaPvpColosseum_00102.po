msgid "Scoreboard abbreviations."
msgstr "Сокращения в таблице результатов."

#. ja: キャンセル
#. de: Nichts
#. fr: Retour
msgctxt "custom/001/RegSeaPvpColosseum_00102:TEXT_REGSEAPVPCOLOSSEUM_00102_A3_000_005:1"
msgid "Nothing."
msgstr "Ничего."

#. ja: 「PvPレーティング」について、何を聞く？
#. de: Worüber möchtest du mehr erfahren?
#. fr: Sur quoi vous renseignez-vous<nbsp>? (Le score JcJ)
msgctxt "custom/001/RegSeaPvpColosseum_00102:TEXT_REGSEAPVPCOLOSSEUM_00102_Q4_000_000:1"
msgid "What part of PvP rating will you ask about?"
msgstr "Что вы хотите узнать о PvP-рейтинге?"

#. ja: 「PvPレーティング」とは
#. de: PvP-Wertung
#. fr: Le fonc<shy>tion<shy>ne<shy>ment du score JcJ
