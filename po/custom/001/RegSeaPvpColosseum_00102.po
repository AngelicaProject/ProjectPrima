msgid "Which rules will you ask about?"
msgstr "О каких правилах вы хотите узнать?"

#. ja: 「メダル」の所持数制限について
#. de: Höchstgrenze für Medaillen
#. fr: Les limites de médailles possédées
msgctxt "custom/001/RegSeaPvpColosseum_00102:TEXT_REGSEAPVPCOLOSSEUM_00102_A3_200_001:1"
msgid "Medal limits."
msgstr "Ограничение на количество медалей."

#. ja: 「ヘヴィメダル」と「ライトメダル」について
#. de: Schwermetall und Leichtmetall
#. fr: Les effets “Médailles lourdes” et “Médailles légères”
msgctxt "custom/001/RegSeaPvpColosseum_00102:TEXT_REGSEAPVPCOLOSSEUM_00102_A3_300_001:1"
msgid "Heavy Medal and Light Medal."
msgstr "Тяжёлая и Лёгкая медаль."

#. ja: 「サプライボックス」について
#. de: Versorgungskisten
#. fr: Les ra<shy>vi<shy>tail<shy>le<shy>ments
msgctxt "custom/001/RegSeaPvpColosseum_00102:TEXT_REGSEAPVPCOLOSSEUM_00102_A3_000_002:1"
msgid "Supply kits."
msgstr "Ящики снабжения."

#. ja: 「デンジャータイム」について
#. de: Blutrausch
#. fr: La phase de carnage
msgctxt "custom/001/RegSeaPvpColosseum_00102:TEXT_REGSEAPVPCOLOSSEUM_00102_A3_000_003:1"
msgid "Culling Time."
msgstr "Время истребления."

#. ja: 「戦闘不能」に関する短縮表記について
#. de: Kampfstatistiken S/K/U
#. fr: L'affichage des résultats
