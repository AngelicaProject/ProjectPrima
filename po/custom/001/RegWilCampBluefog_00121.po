msgctxt "custom/001/RegWilCampBluefog_00121:TEXT_REGWILCAMPBLUEFOG_00121_CRACKEDFIST_000_050:1"
msgid "A good <if ($gn11 < 12)><if ($gn11 < 4)>evening<else>day</if><else><if ($gn11 < 17)>day<else>evening</if></if> to you, <capitalize><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 8></if><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 8></if><if ($gn54 > 0)><sheet GCRankUldahMaleText $gn54 8></if></capitalize> <split \" \" 2><string $gs1></split>─or as good a day as one sees in these dismal environs. Is there aught I can help you with?"
msgstr ""
