msgid "<if ($n1 == 6257)><capitalize><noun-en Item 2 6257 1 1></capitalize> and <noun-en Item 3 6266 1 1><else><sheet Item $n1 9></if>"
msgstr "<if ($n1 == 6257)><capitalize><noun-en Item 2 6257 1 1></capitalize> и <noun-en Item 3 6266 1 1><else><sheet Item $n1 9></if>"

#. ja: キャンセル
#. de: Abbrechen
#. fr: Annuler
msgctxt "custom/001/CmnDefRelicWeapon020Trade_00165:TEXT_CMNDEFRELICWEAPON020TRADE_00165_MENU_CANCEL:1"
msgid "Cancel"
msgstr "Отмена"

#. ja: <if ($n1 == 6257)>「<sheet Item 6257 0>」と「<sheet Item 6266 0>」を強化しますか？<else>「<sheet Item $n1 0>」を強化しますか？</if>
#. de: <if ($n1 == 6257)><capitalize><noun-de Item 2 6257 1 4 1></capitalize> und <noun-de Item 2 6266 1 4 1> verstärken?<else><capitalize><noun-de Item 2 $n1 1 4 1></capitalize> verstärken?</if>
#. fr: Voulez-vous renforcer <if ($n1 == 6257)><noun-fr Item 2 6257 1 1> et <noun-fr Item 2 6266 1 1><else><noun-fr Item 2 $n1 1 1></if><nbsp>?
#. macro: <if ($n1 == 6257)><noun-en Item 2 6257 1 1> and <noun-en Item 2 6266 1 1><else><noun-en Item 2 $n1 1 1></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 1 == 6257 (condition: may be reworded, restructured, added, or dropped)
