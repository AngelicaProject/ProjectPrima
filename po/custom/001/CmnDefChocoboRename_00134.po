# custom/001/CmnDefChocoboRename_00134
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: バディを呼び出した状態では<br>この機能を利用することができません。
#. de: Diese Aktion kann nicht ausgeführt werden, während ein Mitstreiter präsent ist.
#. fr: Cette fonction ne peut pas être utilisée lorsqu'un compagnon est appelé. 
msgctxt "custom/001/CmnDefChocoboRename_00134:TEXT_CMNDEFCHOCOBORENAME_00134_MY_CHOCOBO_RENAME_UNQUALIFIED:1"
msgid "You cannot perform this action while your companion is present."
msgstr ""

#. ja: マイチョコボの新しい名前を入力してください。
#. de: Gib den neuen Namen für deinen Chocobo ein.
#. fr: Donner un nouveau nom au chocobo.
msgctxt "custom/001/CmnDefChocoboRename_00134:TEXT_CMNDEFCHOCOBORENAME_00134_PROMPT_MY_CHOCOBO_RENAME_TITLE:1"
msgid "Please rename your personal chocobo."
msgstr ""

#. ja: マイチョコボの名前
#. de: Neuer Name
#. fr: Nom du chocobo
msgctxt "custom/001/CmnDefChocoboRename_00134:TEXT_CMNDEFCHOCOBORENAME_00134_PROMPT_MY_CHOCOBO_RENAME_CAPTION:1"
msgid "Chocobo Name:"
msgstr ""

#. ja: アルファベット及びアポストロフィが使えます。<br>2文字以上20文字以内の名前を入力してください。
#. de: Der Name muss zwischen 2 und 20 Buchstaben lang sein und kann ein Apostroph beinhalten.
#. fr: Le nom de votre chocobo doit comprendre entre 2 et 20 lettres non accentuées et/ou apostrophes.<br>Le nom doit commencer par une lettre.
msgctxt "custom/001/CmnDefChocoboRename_00134:TEXT_CMNDEFCHOCOBORENAME_00134_PROMPT_MY_CHOCOBO_RENAME_MES0:1"
msgid "Names must be between 2 and 20 alphabetic characters and can include apostrophes but not hyphens."
msgstr ""

#. ja: マイチョコボの名前を<br><string $s1>に変更しました。
#. de: Der Name deines Chocobos wurde zu <string $s1> geändert.
#. fr: Votre chocobo s'appelle désormais <string $s1>.
#. macro: <string $s1> — a text value passed to the string; value = text parameter 1 (game data: keep it; it may move or repeat)
msgctxt "custom/001/CmnDefChocoboRename_00134:TEXT_CMNDEFCHOCOBORENAME_00134_PROMPT_MY_CHOCOBO_RENAME_SUCCESS:1"
msgid "Your chocobo has been renamed <string $s1>."
msgstr ""

#. ja: マイチョコボを厩舎に預けている状態では、<br>この機能を利用することができません。
#. de: Du kannst diese Funktion nicht nutzen, während sich dein Chocobo im Stall befindet.
#. fr: Vous ne pouvez pas renommer votre chocobo lorsqu'il est à l'écurie.
msgctxt "custom/001/CmnDefChocoboRename_00134:TEXT_CMNDEFCHOCOBORENAME_00134_MY_CHOCOBO_RENAME_STABLE:1"
msgid "You cannot perform this action while your chocobo is stabled."
msgstr ""
