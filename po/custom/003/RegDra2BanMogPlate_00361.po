#. ja: 銘板を見ますか？
#. de: Möchtest du die Gedenktafel lesen?
#. fr: Lire la plaque commémorative<nbsp>?
msgctxt "custom/003/RegDra2BanMogPlate_00361:TEXT_REGDRA2BANMOGPLATE_00361_Q1_000_000:1"
msgid "View the engraving?"
msgstr ""

#. ja: はい
#. de: Ja.
#. fr: Oui
msgctxt "custom/003/RegDra2BanMogPlate_00361:TEXT_REGDRA2BANMOGPLATE_00361_A1_000_000:1"
msgid "Yes."
msgstr ""

#. ja: いいえ
#. de: Nein.
#. fr: Non
