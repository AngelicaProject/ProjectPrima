#. ja: 【挿し花：<sheet Item $n1 0>】
#. de: In der Vase: <capitalize><noun-de Item 1 $n1 1 1 1></capitalize>
#. fr: [Vase<nbsp>: <lower><sheet Item $n1 9></lower>]
#. macro: <sheet Item $n1 9> — a value from a game data sheet, such as a name; sheet = Item, row = number parameter 1, column = 9 (game data: keep it; it may move or repeat)
msgctxt "custom/003/HouFurVase_00336:TEXT_HOUFURVASE_00336_Q1_000_000:1"
msgid "On display: <sheet Item $n1 9>"
msgstr "На витрине: <sheet Item $n1 9>"

#. ja: 【挿し花：空】
#. de: In der Vase: ---
#. fr: [Vase<nbsp>: vide]
msgctxt "custom/003/HouFurVase_00336:TEXT_HOUFURVASE_00336_Q1_000_001:1"
msgid "On display: Nothing"
msgstr "На витрине: ничего"

#. ja: 花瓶に花を挿す
#. de: Blumen in die Vase stellen
#. fr: Disposer des fleurs
msgctxt "custom/003/HouFurVase_00336:TEXT_HOUFURVASE_00336_A1_000_002:1"
msgid "Display Flowers"
msgstr "Поставить цветы"

#. ja: 花瓶から花を取り除く
#. de: Blumen aus der Vase nehmen
#. fr: Vider le vase
msgctxt "custom/003/HouFurVase_00336:TEXT_HOUFURVASE_00336_A1_000_003:1"
msgid "Remove Flowers"
msgstr "Убрать цветы"

#. ja: やめる
#. de: Abbrechen
#. fr: Annuler
msgctxt "custom/003/HouFurVase_00336:TEXT_HOUFURVASE_00336_A1_000_004:1"
msgid "Quit"
msgstr "Прервать"

#. ja: <sheet Item $n1 0>を取り除き、<br>花瓶を空に戻します。よろしいですか？<br><ui-color 500><ui-edge-color 501>※以下のアイテムは消滅します。</ui-edge-color></ui-color>
#. de: <capitalize><noun-de Item 2 $n1 1 4 1></capitalize> aus der Vase entfernen?<br><ui-color 500><ui-edge-color 501>※ <capitalize><noun-de Item 2 $n1 1 1 1></capitalize> geht dabei verloren.</ui-edge-color></ui-color>
#. fr: Vider le vase et jeter <noun-fr Item 2 $n1 1 1><nbsp>?<br><ui-color 500><ui-edge-color 501>* L'objet ci-dessous sera perdu.</ui-edge-color></ui-color>
#. macro: <capitalize><noun-en Item 2 $n1 1 1></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <noun-en Item 2 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = Item, form = 2, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "custom/003/HouFurVase_00336:TEXT_HOUFURVASE_00336_Q2_000_000:1"
msgid "<capitalize><noun-en Item 2 $n1 1 1></capitalize> will be discarded if removed from the vase. Are you certain you wish to proceed?"
msgstr "Если вынуть из вазы, <capitalize><noun-en Item 2 $n1 1 1></capitalize> будет потерян. Продолжить?"

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "custom/003/HouFurVase_00336:TEXT_HOUFURVASE_00336_Q2_000_001:1"
msgid "Yes"
msgstr "Да"

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "custom/003/HouFurVase_00336:TEXT_HOUFURVASE_00336_Q2_000_002:1"
msgid "No"
msgstr "Нет"
