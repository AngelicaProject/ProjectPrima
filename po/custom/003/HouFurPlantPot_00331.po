msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 植木鉢には何も植わっていない。
#. de: Der Blumentopf ist leer.
#. fr: Le pot de fleurs est vide.
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_TALK_NONE:1"
msgid "There is nothing in this flowerpot."
msgstr "В цветочном горшке ничего нет."

#. ja: やめる
#. de: Abbrechen
#. fr: Annuler
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_END_EVENT:1"
msgid "Quit"
msgstr "Прервать"

#. ja: 種をまく
#. de: Aussäen
#. fr: Ensemencer
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_SET_SEED:1"
msgid "Plant Seeds"
msgstr "Посадить семена"

#. ja: 肥料をやる
#. de: Düngen
#. fr: Mettre de l'engrais
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_SET_FERTILIZER:1"
msgid "Fertilize Crop"
msgstr "Удобрить"

#. ja: 手入れをする
#. de: Pflegen
#. fr: Entretenir
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_CARE:1"
msgid "Tend Crop"
msgstr "Ухаживать"

#. ja: 処分する
#. de: Pflanze vernichten
#. fr: Arracher
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_DISPOSE:1"
msgid "Remove Crop"
msgstr "Удалить"

#. ja: 収穫する
#. de: Ernten
#. fr: Récolter
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_HARVEST:1"
msgid "Harvest Crop"
msgstr "Собрать урожай"

#. ja: <sheet Item $n1 0>は枯れている……。
#. de: Die Pflanze ist leider verwelkt<nbsp>... (<capitalize><sheet Item $n1 9></capitalize>)
#. fr: Le semis <noun-fr Item 8 $n1 1 1> s'est fané...
#. macro: <sheet Item $n1 9> — a value from a game data sheet, such as a name; sheet = Item, row = number parameter 1, column = 9 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_TALK_DEAD:1"
msgid "<sheet Item $n1 9><br>This crop is beyond hope."
msgstr "<sheet Item $n1 9><br>Этому растению уже не помочь."

#. ja: <sheet Item $n1 0>が元気に育っている。
#. de: Die Pflanze gedeiht prächtig. (<capitalize><sheet Item $n1 9></capitalize>)
#. fr: Le semis <noun-fr Item 8 $n1 1 1> se porte bien.
#. macro: <sheet Item $n1 9> — a value from a game data sheet, such as a name; sheet = Item, row = number parameter 1, column = 9 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_TALK_VIGOROUS:1"
msgid "<sheet Item $n1 9><br>This crop is doing well."
msgstr "<sheet Item $n1 9><br>Растение хорошо растёт."

#. ja: <sheet Item $n1 0>の元気がないようだ……。
#. de: Die Pflanze sieht etwas angeschlagen aus. (<capitalize><sheet Item $n1 9></capitalize>)
#. fr: Le semis <noun-fr Item 8 $n1 1 1> n'a pas l'air en grande forme...
#. macro: <sheet Item $n1 9> — a value from a game data sheet, such as a name; sheet = Item, row = number parameter 1, column = 9 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_TALK_DEPRESSED:1"
msgid "<sheet Item $n1 9><br>This crop has seen better days..."
msgstr "<sheet Item $n1 9><br>Растение выглядит неважно..."

#. ja: <sheet Item $n1 0>は十分に成熟している。
#. de: Die Pflanze ist reif zur Ernte! (<capitalize><sheet Item $n1 9></capitalize>)
#. fr: <capitalize><noun-fr Item 2 $n1 1 1></capitalize> est arrivé<if "<sheet Item $n1 6>">e</if> à maturité<nbsp>!
#. macro: <sheet Item $n1 9> — a value from a game data sheet, such as a name; sheet = Item, row = number parameter 1, column = 9 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_TALK_RIPE:1"
msgid "<sheet Item $n1 9><br>This crop is ready to be harvested."
msgstr "<sheet Item $n1 9><br>Растение готово к сбору урожая."

#. ja: 作物を処分します。<br>本当によろしいですか？
#. de: Die Pflanze wirklich vernichten?
#. fr: Une fois arraché, le semis sera définitivement perdu. Confirmer<nbsp>?
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_ASK_DISPOSE:1"
msgid "Are you certain you wish to remove this crop?"
msgstr "Вы уверены, что хотите удалить это растение?"

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_ASK_DISPOSE_YES:1"
msgid "Yes"
msgstr "Да"

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_ASK_DISPOSE_NO:1"
msgid "No"
msgstr "Нет"

#. ja: <sheet Item $n1 0>が植わっている。元気に育っている。
#. de: In diesem Blumentopf wächst eine Pflanze. Sie gedeiht prächtig. (<capitalize><sheet Item $n1 9></capitalize>)
#. fr: <capitalize><noun-fr Item 1 $n1 1 1></capitalize> est planté<if "<sheet Item $n1 6>">e</if> dans le pot. Le développement se fait sans problème.
#. macro: <lower><sheet Item $n1 9></lower> — the content in lower case (may be added or dropped)
#. macro: <sheet Item $n1 9> — a value from a game data sheet, such as a name; sheet = Item, row = number parameter 1, column = 9 (game data: keep it; it may move or repeat)
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_TALK_FLOWER_VIGOROUS:1"
msgid "The <lower><sheet Item $n1 9></lower> have taken root, and the crop is doing well."
msgstr "<lower><sheet Item $n1 9></lower> прижились, растение хорошо растёт."

#. ja: <sheet Item $n1 0>が植わっている。元気がないようだ……。
#. de: In diesem Blumentopf wächst eine Pflanze. Sie sieht aber etwas angeschlagen aus. (<capitalize><sheet Item $n1 9></capitalize>)
#. fr: <capitalize><noun-fr Item 1 $n1 1 1></capitalize> est planté<if "<sheet Item $n1 6>">e</if> dans le pot. Le développement manque de vigueur...
#. macro: <lower><sheet Item $n1 9></lower> — the content in lower case (may be added or dropped)
#. macro: <sheet Item $n1 9> — a value from a game data sheet, such as a name; sheet = Item, row = number parameter 1, column = 9 (game data: keep it; it may move or repeat)
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_TALK_FLOWER_DEPRESSED:1"
msgid "The <lower><sheet Item $n1 9></lower> have taken root, but the crop has seen better days..."
msgstr "<lower><sheet Item $n1 9></lower> прижились, но растение выглядит неважно..."

#. ja: <switch $n1><case>赤<case>青<case>黄<case>緑<case>オレンジ<case>紫<case>分からない</switch>色の花が咲きそうだ……。
#. de: Die Pflanze wird bald <switch $n1><case>rot<case>blau<case>gelb<case>grün<case>orange<case>violett<case>in einer schönen Farbe</switch> blühen.
#. fr: Vous avez le sentiment que la plante va donner des fleurs <switch $n1><case>rouges<case>bleues<case>jaunes<case>vertes<case>oranges<case>violettes<case>d'une couleur encore indéfinissable</switch>.
#. macro: <switch $n1><case>red flowers<case>blue flowers<case>yellow flowers<case>green flowers<case>orange flowers<case>purple flowers<case>flowers, but who can say wha… — shows the case whose position equals the value: the first <case> for 1, the second for 2, …; value = number parameter 1 (condition: may be reworded, restructured, added, or dropped)
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_FLOWER_PREDICT:1"
msgid "Perhaps it will yield <switch $n1><case>red flowers<case>blue flowers<case>yellow flowers<case>green flowers<case>orange flowers<case>purple flowers<case>flowers, but who can say what color they might be</switch>..."
msgstr "Похоже, скоро распустятся <switch $n1><case>красные цветы<case>синие цветы<case>жёлтые цветы<case>зелёные цветы<case>оранжевые цветы<case>фиолетовые цветы<case>цветы неизвестного цвета</switch>..."

#. ja: <switch $n1><case>赤<case>青<case>黄<case>緑<case>オレンジ<case>紫</switch>、または、珍しい色の花が咲きそうだ……。
#. de: Die Pflanze wird bald <switch $n1><case>rot<case>blau<case>gelb<case>grün<case>orange<case>violett</switch> oder in einer ganz besonderen Farbe blühen.
#. fr: Vous avez le sentiment que la plante va donner des fleurs <switch $n1><case>rouges<case>bleues<case>jaunes<case>vertes<case>orange<case>violettes</switch> ou d'une couleur inédite.
#. macro: <switch $n1><case>red<case>blue<case>yellow<case>green<case>orange<case>purple</switch> — shows the case whose position equals the value: the first <case> for 1, the second for 2, …; value = number parameter 1 (condition: may be reworded, restructured, added, or dropped)
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_FLOWER_PREDICT_UNKNOWN:1"
msgid "Perhaps it will yield <switch $n1><case>red<case>blue<case>yellow<case>green<case>orange<case>purple</switch> flowers, or perhaps flowers of a more unusual shade..."
msgstr "Похоже, скоро распустятся <switch $n1><case>красные<case>синие<case>жёлтые<case>зелёные<case>оранжевые<case>фиолетовые</switch> цветы... А может, какого-нибудь необычного оттенка."

#. ja: <sheet Item $n1 0>が咲いている。
#. de: Die Pflanze blüht in voller Pracht. (<capitalize><sheet Item $n1 9></capitalize>)
#. fr: <capitalize><noun-fr Item 2 $n1 1 1></capitalize> est en floraison.
#. macro: <sheet Item $n1 9> — a value from a game data sheet, such as a name; sheet = Item, row = number parameter 1, column = 9 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "custom/003/HouFurPlantPot_00331:TEXT_HOUFURPLANTPOT_00331_FLOWERED:1"
msgid "<sheet Item $n1 9><br>These flowers are in bloom."
msgstr "<sheet Item $n1 9><br>Цветы распустились."
