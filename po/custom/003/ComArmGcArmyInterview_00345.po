msgstr ""

#. ja: 現在、新しい志願書はありません。
#. de: Zurzeit liegen keine Bewerbungen vor.
#. fr: Vous n'avez aucune candidature en attente d'examen.
msgctxt "custom/003/ComArmGcArmyInterview_00345:TEXT_COMARMGCARMYINTERVIEW_00345_SYSTEM_000_020:1"
msgid "No new enlistment papers are currently available."
msgstr ""

#. ja: まだ、入隊の是非を確定していない志願兵がいます。
#. de: Es liegt mindestens eine Bewerbung vor, über die du noch nicht entschieden hast.
#. fr: Vous avez des candidatures en attente d'examen.
msgctxt "custom/003/ComArmGcArmyInterview_00345:TEXT_COMARMGCARMYINTERVIEW_00345_SYSTEM_000_021:1"
msgid "You have enlistment papers pending review."
msgstr ""

#. ja: 他にも新しい志願書があるようです。<br>続けて、他の志願兵の志願書を確認しますか？
#. de: Es gibt noch eine andere Bewerbung. Möchtest du sie dir ansehen?
#. fr: D'autres volontaires souhaitent intégrer votre escouade. Examiner leur candidature<nbsp>?
msgctxt "custom/003/ComArmGcArmyInterview_00345:TEXT_COMARMGCARMYINTERVIEW_00345_SYSTEM_000_023:1"
msgid "Do you wish to review the remaining enlistment papers?"
msgstr ""

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "custom/003/ComArmGcArmyInterview_00345:TEXT_COMARMGCARMYINTERVIEW_00345_YES:1"
msgid "Yes"
msgstr ""

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "custom/003/ComArmGcArmyInterview_00345:TEXT_COMARMGCARMYINTERVIEW_00345_NO:1"
msgid "No"
msgstr ""
