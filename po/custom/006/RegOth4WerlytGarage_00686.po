msgid "What will you do?"
msgstr "Что будете делать?"

#. ja: 機体の概要を聞く
#. de: Mehr über den G-Retter erfahren
#. fr: Demander des in<shy>for<shy>ma<shy>tions sur la machine
msgctxt "custom/006/RegOth4WerlytGarage_00686:TEXT_REGOTH4WERLYTGARAGE_00686_A3_000_001:1"
msgid "Ask about the G-Savior."
msgstr "Расспросить о G-спасителе."

#. ja: ウェポン捕獲ユニットを確認する
#. de: Fangvorrichtung inspizieren
#. fr: Inspecter le module de capture
msgctxt "custom/006/RegOth4WerlytGarage_00686:TEXT_REGOTH4WERLYTGARAGE_00686_A3_000_002:1"
msgid "Inspect the containment apparatus."
msgstr "Осмотреть устройство захвата."

#. ja: 推進装置を確認する
#. de: Triebwerk begutachten
#. fr: Inspecter le module de propulsion
msgctxt "custom/006/RegOth4WerlytGarage_00686:TEXT_REGOTH4WERLYTGARAGE_00686_A3_000_003:1"
msgid "Inspect the propulsion system."
msgstr "Осмотреть двигатель."

