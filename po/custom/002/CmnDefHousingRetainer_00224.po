#. de: Abbrechen
#. fr: Annuler
msgctxt "custom/002/CmnDefHousingRetainer_00224:TEXT_CMNDEFHOUSINGRETAINER_00224_MENU_POSE_CANCEL:1"
msgid "Cancel."
msgstr "Отмена."

#. ja: ポーズを選んでください [現在のポーズ：ポーズ<num $n1>]
#. de: Wähle eine Pose. (momentan: Pose <num $n1>)
#. fr: Choisir une pose [Actuellement<nbsp>: pose <num $n1>]
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
msgctxt "custom/002/CmnDefHousingRetainer_00224:TEXT_CMNDEFHOUSINGRETAINER_00224_MENU_POSE_CAPTION:1"
msgid "Select an option. (Current setting: Pose <num $n1>)"
msgstr "Выберите вариант. (Сейчас: поза <num $n1>)"
