msgctxt "custom/002/CmnDefHousingRetainer_00224:TEXT_CMNDEFHOUSINGRETAINER_00224_MENU_POSE_TITLE:1"
msgid "Pose <num $n1>."
msgstr "Поза <num $n1>."

