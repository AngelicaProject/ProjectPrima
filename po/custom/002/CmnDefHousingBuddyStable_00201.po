#. de: Trainieren
#. fr: Entraîner
msgctxt "custom/002/CmnDefHousingBuddyStable_00201:TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MY_CHOCOBO_TRAIN:1"
