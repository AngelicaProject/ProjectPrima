msgctxt "custom/002/CmnDefRelicWeapon050Trade_00221:TEXT_CMNDEFRELICWEAPON050TRADE_00221_MENU_CHOICES:1"
msgid "<if ($n1 == 9491)><sheet Item 9491 9> (<sheet Item 8649 9>) and <sheet Item 9500 9> (<sheet Item 8658 9>)<else><capitalize><sheet Item $n1 9></capitalize> (<capitalize><sheet Item $n2 9></capitalize>)</if>."
msgstr ""

#. ja: キャンセル
#. de: Abbrechen
#. fr: Annuler
msgctxt "custom/002/CmnDefRelicWeapon050Trade_00221:TEXT_CMNDEFRELICWEAPON050TRADE_00221_MENU_CANCEL:1"
msgid "Nothing."
msgstr ""

#. ja: <if ($n1 == 9491)>「<sheet Item 9491 0>」と「<sheet Item 9500 0>」を再創造しますか<else>「<sheet Item $n1 0>」を再創造しますか</if>
#. de: <if ($n1 == 9491)><capitalize><noun-de Item 5 9491 1 4 1></capitalize> und <noun-de Item 2 9500 1 4 1> rekonstruieren<else><capitalize><noun-de Item 1 $n1 1 4 1></capitalize> rekonstruieren</if>?
#. fr: Voulez-vous vraiment forger <if ($n1 == 9491)><noun-fr Item 12 9491 1 1> et <noun-fr Item 12 9500 1 1><else><noun-fr Item 2 $n1 1 1></if><nbsp>?
#. macro: <if ($n1 == 9491)><noun-en Item 3 9491 1 1> and <noun-en Item 3 9500 1 1><else><capitalize><noun-en Item 3 $n1 1 1></capitalize></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 1 == 9491 (condition: may be reworded, restructured, added, or dropped)
