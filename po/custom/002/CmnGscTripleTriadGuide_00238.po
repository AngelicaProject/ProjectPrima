msgid "Regional rules."
msgstr "Региональные правила"

#. ja: 対戦ルールについて
#. de: Wer legt die Match-Regeln fest?
#. fr: Les règles initiales
msgctxt "custom/002/CmnGscTripleTriadGuide_00238:TEXT_CMNGSCTRIPLETRIADGUIDE_00238_A2_000_002:1"
msgid "Match rules."
msgstr "Правила матча"

#. ja: 特殊ルールの種類
#. de: Welche Ergänzungsregeln gibt es?
#. fr: Les règles spéciales
msgctxt "custom/002/CmnGscTripleTriadGuide_00238:TEXT_CMNGSCTRIPLETRIADGUIDE_00238_A2_000_003:1"
msgid "Advanced rule explanations."
msgstr "Виды продвинутых правил"

#. ja: キャンセル
#. de: Abbrechen.
#. fr: Annuler
msgctxt "custom/002/CmnGscTripleTriadGuide_00238:TEXT_CMNGSCTRIPLETRIADGUIDE_00238_A2_000_004:1"
msgid "Nothing."
msgstr "Ничего"

#. ja: どの特殊ルールについて聞く？
#. de: Welche Ergänzungsregel möchtest du dir erklären lassen?
#. fr: Quelle règle spéciale vous intéresse<nbsp>?
msgctxt "custom/002/CmnGscTripleTriadGuide_00238:TEXT_CMNGSCTRIPLETRIADGUIDE_00238_Q3_000_001:1"
