#. ja: 【内壁材：<sheet Item $n1 0>】
#. de: Aktuelles Muster: <sheet Item $n1 9>
#. fr: [Revêtement<nbsp>: <sheet Item $n1 0>]
#. macro: <sheet Item $n1 9> — a value from a game data sheet, such as a name; sheet = Item, row = number parameter 1, column = 9 (game data: keep it; it may move or repeat)
msgctxt "custom/004/HouFurWallpaperPartition_00437:TEXT_HOUFURWALLPAPERPARTITION_00437_Q1_000_000:1"
msgid "Current Design: <sheet Item $n1 9>"
msgstr "Текущий дизайн: <sheet Item $n1 9>"

#. ja: 【内壁材：初期状態】
#. de: Aktuelles Muster: ---
#. fr: [Revêtement<nbsp>: aucun]
msgctxt "custom/004/HouFurWallpaperPartition_00437:TEXT_HOUFURWALLPAPERPARTITION_00437_Q1_000_001:1"
msgid "Current Design: Nothing"
msgstr "Текущий дизайн: нет"

#. ja: 内壁材を張る
#. de: Muster anwenden
#. fr: Coller un revêtement
msgctxt "custom/004/HouFurWallpaperPartition_00437:TEXT_HOUFURWALLPAPERPARTITION_00437_A1_000_002:1"
msgid "Apply Design"
msgstr "Применить дизайн"

#. ja: 内壁材を外す
#. de: Muster entfernen
#. fr: Retirer le revêtement
msgctxt "custom/004/HouFurWallpaperPartition_00437:TEXT_HOUFURWALLPAPERPARTITION_00437_A1_000_003:1"
msgid "Remove Design"
msgstr "Убрать дизайн"

#. ja: やめる
#. de: Abbrechen
#. fr: Annuler
msgctxt "custom/004/HouFurWallpaperPartition_00437:TEXT_HOUFURWALLPAPERPARTITION_00437_A1_000_004:1"
msgid "Quit"
msgstr "Прервать"

#. ja: <sheet Item $n1 0>を取り除き、<br>パーティションを初期状態に戻します。よろしいですか？<br><ui-color 500><ui-edge-color 501>※以下のアイテムは消滅します。</ui-edge-color></ui-color>
#. de: Das Muster von dem Wandteil entfernen?<br><ui-color 500><ui-edge-color 501>※ <capitalize><noun-de Item 2 $n1 1 1 1></capitalize> geht dabei verloren.</ui-edge-color></ui-color>
#. fr: Retirer <noun-fr Item 2 $n1 1 1> et réinitialiser l'apparence de la partition<nbsp>?<br><ui-color 500><ui-edge-color 501>* L'objet ci-dessous sera perdu.</ui-edge-color></ui-color>
#. macro: <capitalize><noun-en Item 2 $n1 1 1></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <noun-en Item 2 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = Item, form = 2, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "custom/004/HouFurWallpaperPartition_00437:TEXT_HOUFURWALLPAPERPARTITION_00437_Q2_000_000:1"
msgid "<capitalize><noun-en Item 2 $n1 1 1></capitalize> will be discarded if removed from the partition. Are you certain you wish to proceed?"
msgstr "При снятии с перегородки предмет <capitalize><noun-en Item 2 $n1 1 1></capitalize> будет уничтожен. Продолжить?"
