#. fr: Yiazmat
msgctxt "custom/004/RegHinAllaganStorageSystem_00491:TEXT_REGHINALLAGANSTORAGESYSTEM_00491_A20_000_001:1"
msgid "What is Yiazmat?"
msgstr ""

