msgctxt "custom/004/RegHinAllaganStorageSystem_00491:TEXT_REGHINALLAGANSTORAGESYSTEM_00491_00491_ALLAGAN_000_000:1"
msgid "Records found. Initiating query protocol."
msgstr ""

