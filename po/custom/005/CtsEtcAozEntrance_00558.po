# custom/005/CtsEtcAozEntrance_00558
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: こちらは、新設された闘技場「ブルースカイ」の入り口です。<br>会員のお客様か、関係者の方のみ、入場が許されています。
#. de: Tut mir leid, aber der Eingang ist nur für Angestellte der Himmlischen Arena.
#. fr: Cette porte mène aux coulisses du Ciel azur, l'arène où a lieu la Grande Mascarade. Désolé, vous ne pouvez pas entrer sans au<shy>to<shy>ri<shy>sa<shy>tion.
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_000:1"
msgid "Only those with express permission from the manager of the Celestium may enter. Please, move along─you are making the place look untidy."
msgstr ""

#. ja: 何をする？
#. de: Was möchtest du machen?
#. fr: Que voulez-vous faire<nbsp>?
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_Q1_000_000:1"
msgid "What will you do?"
msgstr ""

#. ja: 「マスクカーニバル」に挑戦する
#. de: An der Großen Maskerade teilnehmen
#. fr: Participer à la Grande Mascarade
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_A1_000_001:1"
msgid "Enter the Masked Carnivale."
msgstr ""

#. ja: 「マスクカーニバル」について聞く
#. de: Mehr über die Große Maskerade erfahren
#. fr: En savoir plus sur la Grande Mascarade
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_A1_000_002:1"
msgid "Ask about the Masked Carnivale."
msgstr ""

#. ja: キャンセル
#. de: Abbrechen
#. fr: Annuler
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_A1_000_003:1"
msgid "Nothing."
msgstr ""

#. ja: 何を聞く？
#. de: Was möchtest du wissen?
#. fr: Sur quoi vous renseignez-vous<nbsp>?
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_Q2_000_000:1"
msgid "What will you ask?"
msgstr ""

#. ja: 「マスクカーニバル」について
#. de: Was ist die Große Maskerade?
#. fr: La Grande Mascarade en général
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_A2_000_001:1"
msgid "What is the Masked Carnivale?"
msgstr ""

#. ja: 「ウィークリーターゲット」について
#. de: Was sind Wochenziele?
#. fr: Les défis hebdomadaires
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_A2_000_002:1"
msgid "What are weekly targets?"
msgstr ""

#. ja: 戻る
#. de: Zurück
#. fr: Retour
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_A2_000_003:1"
msgid "Return."
msgstr ""

#. ja: 申し訳ありません、<split " " 1><string $gs1></split>さんは、<br>ブルースカイにて、青魔道士として選手登録されております。<br>マスクカーニバルには、「青魔道士」でのみ挑戦いただけます。
#. de: Willkommen in der Himmlischen Arena. Möchtest du an der Großen Maskerade teilnehmen? Ich kann dich leider nur als <if $gn4>Blaumagierin<else>Blaumagier</if> reinlassen. Also komm doch wieder, wenn du deine Ausrüstung gewechselt hast.
#. fr: Navré <if $gn4>Madame<else>Monsieur</if> <split " " 2><string $gs1></split>, vous êtes <if $gn4>inscrite<else>inscrit</if> dans nos registres en tant que mage bleu. Je ne peux vous laisser combattre qu'avec l'attirail correspondant.
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_001:1"
msgid "The Masked Carnivale─the series of arena events specifically for the demonstration of blue magic─is, unsurprisingly, only open to practitioners of said discipline. But you knew that already, did you not?"
msgstr ""

#. ja: 新進気鋭の実業家、ロイスさんによって、<br>ウルダハに新たな闘技場「ブルースカイ」が設営されました。
#. de: Du stehst vor der Himmlischen Arena, eine Schöpfung des talentierten Fräulein Royse persönlich. Die Große Maskerade ist die Hauptattraktion dieser Kombination aus Gladiatorenkampf und Theater.
#. fr: L'arène du Ciel azur a ouvert ses portes récemment. C'est madame Royse, notre très dynamique patronne, qui en est la pro<shy>prié<shy>taire.
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_010:1"
msgid "The Masked Carnivale is one of the many forms of entertainment on offer here at the Celestium, and was created by none other than the manager herself, Miss Royse."
msgstr ""

#. ja: そこで、人と魔物や野獣を競わせる「闘獣」を、<br>大々的に打ち出したものが「マスクカーニバル」です。
#. de: Hier demonstrieren Blaumagierinnen und Blaumagier ihr Talent im Kampf gegen ungezähmte, blutrünstige und furchterregende Gegner. Ein umwerfendes Spektakel voller überraschenden Wendungen!
#. fr: À la différence du Colisée, nous accueillons exclusivement des joutes bestiales, c'est-à-dire des af<shy>fron<shy>te<shy>ments entre humains et créatures sauvages, le tout enrobé dans une ambiance haute en couleur. C'est ce concept inédit que nous avons baptisé la Grande Mascarade.
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_011:1"
msgid "Building on our established reputation for providing shows in which man confronts beast, this particular event is specially designed for blue mages, who are fairly recent arrivals in Eorzea."
msgstr ""

#. ja: ルールは単純明快、襲いくる敵をすべて倒すのみ。<br>試合のカードはたくさんあり、その詳しい内容が、<br>開始前に確認できるようになっています。
#. de: Ganz in der ul'dhischen Tradition des Gladiatorenkampfes gibt es nur eine Regel: Wer am Ende noch steht, gewinnt.
#. fr: Sa règle de base est on ne peut plus limpide<nbsp>: les par<shy>ti<shy>ci<shy>pants doivent simplement se défaire de tous leurs ennemis sans exception. Avant de pénétrer dans l'arène, vous aurez le choix entre plusieurs groupes d'adversaires.
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_012:1"
msgid "There is but one rule: incapacitate or be incapacitated. Killing is strongly discouraged here, you see. Our clientele is far too sophisticated to revel in the barbaric bloodsports one might find in less reputable establishments."
msgstr ""

#. ja: なにせ、相手は言葉も通じなければ、加減も知らない魔物や野獣。<br>死にたくなければ、事前に情報をよく確認し、<br>作戦を練ってから、試合に臨むことをお勧めします。
#. de: Wenn du die Arena in einem Stück verlassen möchtest, solltest du dir genau ansehen, was für ein Gegner auf dich wartet, und dich entsprechend vorbereiten.
#. fr: De grâce, n'essayez pas de vous frotter à des monstres trop forts pour vous. Il y en a qui ont essayé... Ils ont eu des problèmes<nbsp>! Bref, réfléchissez à l'avance à votre stratégie avant de vous lancer.
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_013:1"
msgid "Having said that, the creatures that enter the pit have no understanding of such subtleties and will not hesitate to claw, bite, gore, and otherwise maim any contestant foolish enough to overestimate their own abilities."
msgstr ""

#. ja: ちなみに、<split " " 1><string $gs1></split>さんは、<br>ブルースカイにて、青魔道士として選手登録されています。<br>それ以外の戦い方では出場できないので、あしからず……。
#. de: Hatte ich erwähnt, dass du nur als <if $gn4>Blaumagierin<else>Blaumagier</if> teilnehmen kannst? Wir wollen uns von den anderen Arenen absetzen, und dann sind da ja noch die einzigartig dramatischen Kostüme für die Hauptdarsteller, die Fräulein Royse entworfen hat.
#. fr: À propos, <if $gn4>Madame<else>Monsieur</if> <split " " 2><string $gs1></split>, vous êtes <if $gn4>inscrite<else>inscrit</if> dans nos registres en tant que mage bleu, il est donc in<shy>dis<shy>pen<shy>sa<shy>ble que vous combattiez avec cette spécialité et aucune autre.
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_014:1"
msgid "I must also point out that only blue mages are eligible to enter the Masked Carnivale. That is what the audience comes to see, and we are not in the business of disappointing paying customers."
msgstr ""

#. ja: 青魔道士は、当闘技場の看板なので、<br>大いに盛り上げてくだされば、報酬も弾むことでしょう。<br>マスクカーニバルへの挑戦、いつでもお待ちしております！
#. de: Wenn die kämpferischen und schauspielerischen Leistungen stimmen, winken großzügige Belohnungen. Also leg dich ins Zeug!
#. fr: N'y voyez rien de personnel. Les mages bleus sont les vedettes de notre spectacle, et nous tenons à les mettre en avant autant que possible. Ravissez le cœur du public et vous aurez droit à une récompense à la hauteur. Bonne chance à vous<nbsp>! 
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_015:1"
msgid "Provided you follow our rules─and survive, of course─you will be generously rewarded. In fact, an especially emphatic performance may prompt the management to throw in a little something extra..."
msgstr ""

#. ja: マスクカーニバルは、<br>青魔道士がソロで遊ぶことができるコンテンツです。
#. de: Die Große Maskerade ist ein Solo-Inhalt für Blaumagier.
#. fr: La Grande Mascarade est une mission de combat en solo réservée aux mages bleus.
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_016:1"
msgid "The Masked Carnivale is comprised of solo duties for blue mages."
msgstr ""

#. ja: ステージは最大で3フェーズ構成になっており、<br>敵を全て討伐することで次のフェーズへと進みます。<br>全てのフェーズの敵を倒せば、ステージクリアとなります。
#. de: Jede Vorstellung besteht aus einem, zwei oder drei Akten. Besiege alle Gegner, um von einem Akt zum nächsten zu kommen. Wenn alle Akte abgeschlossen sind, ist auch die Vorstellung abgeschlossen.
#. fr: Chaque niveau comporte entre une et trois phases. Vainquez tous les ennemis présents dans l'arène pour progresser d'une phase à une autre. Franchissez toutes les phases d'un niveau avec succès pour le terminer.
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_017:1"
msgid "Each match contains between one and three acts. Defeating all of the opponents in one act will allow you to proceed to the next. Finish all acts to complete the performance."
msgstr ""

#. ja: 各ステージをクリアすると、<br>初回のみ、報酬としてギル、同盟記章、<br>アラガントームストーンを入手できます。
#. de: Bonusvergütungen werden für den ersten Abschluss ausgegeben und bestehen aus Gil, Jagdabzeichen und Allagischen Steinen.
#. fr: Chaque niveau complété vous octroiera des gils, des insignes alliés et des mémoquartz allagois poétiques. Cette récompense ne sera valable que la première fois que vous terminez le niveau en question.
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_018:1"
msgid "A special reward of gil, Allied Seals, and Allagan tomestones will be provided upon completing a performance for the first time."
msgstr ""

#. ja: また、マスクカーニバルでは、<br>開始前に敵の配置や弱点の情報を見ることができます。
#. de: Vor jeder Vorstellung können die Gegner und ihre Schwächen eingesehen werden.
#. fr: Avant de vous lancer dans un combat, vous pourrez vérifier la position et les faiblesses de chaque ennemi.
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_019:1"
msgid "You may check which enemies will appear and their weaknesses before each performance."
msgstr ""

#. ja: 敵の弱点を狙ったり、状態異常を付与したりして、<br>戦闘を有利に進めましょう。
#. de: Wähle entsprechende Blauzauber aus, um dir den Sieg in der Himmlischen Arena zu sichern!
#. fr: Utilisez ces in<shy>for<shy>ma<shy>tions à votre avantage pour remporter la victoire.
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_020:1"
msgid "Choosing spells that exploit the opponent's weaknesses is the key to victory."
msgstr ""

#. ja: マスクカーニバルは、闘獣であり興行でもあります。<br>お客様を飽きさせず、楽しませるのも大事。<br>そこで、「ウィークリーターゲット」というものを設けています。
#. de: Wir haben viele Stammkunden, die im Besitz von Dauerkarten sind. Also müssen wir ihnen auch in regelmäßigen Abständen etwas Neues bieten. Zu diesem Zweck haben wir die Wochenziele eingeführt.
#. fr: La Grande Mascarade, c'est du sport mais aussi du spectacle, ne l'oublions pas. Pour varier les plaisirs et éviter que le public ne se lasse, nous avons introduit ce que nous appelons des défis hebdomadaires.
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_030:1"
msgid "Our clientele soon grow tired of seeing the same tricks over and over, so we have introduced weekly targets to encourage participants to vary their approaches."
msgstr ""

#. ja: あえて制約を課して戦って、観客をハラハラさせたり、<br>多彩な技を見せたりして、会場を盛り上げる一種の演出です。<br>成功したら特別な報酬が出るので、ぜひ挑戦してみてください！
#. de: Sie sind keine Voraus<shy>setzungen, aber wenn du die Ziele erfüllst, wird die Arenaleitung dein Engagement sicher mit etwas Extragage belohnen.
#. fr: Chaque semaine, nous demandons à nos combattants de s'imposer des handicaps pour pimenter l'action, ou encore d'ébaudir les spectateurs avec un florilège de techniques spectaculaires. De juteuses récompenses sont prévues pour les courageux qui se prêtent au jeu<nbsp>!
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_031:1"
msgid "While it is by no means compulsory, the management will be very grateful should you be successful in achieving any of these goals during your performance. Naturally, such appreciation is often expressed through the proffering of more bountiful rewards."
msgstr ""

#. ja: ウィークリーターゲットは、指定されたステージを、<br>指定の「ボーナス」を達成してクリアすることで、<br>報酬を得ることができます。
#. de: Wochenziele werden für bestimmte Vorstellungen ausgegeben, die mit einem Symbol markiert sind.
#. fr: Les défis hebdomadaires demandent de terminer un niveau donné en remplissant certaines conditions.
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_032:1"
msgid "Weekly targets are available for certain performances, indicated with an icon."
msgstr ""

#. ja: ボーナスには、「ダメージを受けない」や、<br>「火属性と無属性の青魔法のみを使用」といった、<br>コンテンツ中の戦闘内容を評価するものが存在します。
#. de: Erfülle die Ziele (z. B. „Keinen Schaden erlitten“ oder „Nur feuerelementare oder neutrale Zauber benutzt“), um zusätzliche Vergütungen zu erhalten.
#. fr: Il peut s'agir par exemple de ne subir aucun dégât, ou de n'utiliser que des sorts de feu.
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_033:1"
msgid "By fulfilling predetermined conditions such as “Took no damage” or “Cast only fire- or unaspected spells” you may be eligible for additional bonuses. "
msgstr ""

#. ja: お題として出されるボーナスの達成条件は、<br>開始前に確認することができるので、<br>必要な青魔法などを確認してから臨みましょう。
#. de: Sieh dir die Wochenziele vor der Vorstellung an und suche deine Zaubersprüche entsprechend aus.
#. fr: Les conditions requises peuvent être vérifiées avant chaque combat. Assurez-vous entre autre d'avoir équipé les actions adéquates avant de vous lancer.
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_034:1"
msgid "Be sure to check these conditions before beginning a performance, and choose your spells accordingly."
msgstr ""

#. ja: お題は、初級、中級、上級の3種類存在し、<br>（地球時間）毎週<reset-time 17 2><switch $weekday><case>日<case>月<case>火<case>水<case>木<case>金<case>土</switch>曜日の<if ($hour >= 12)>午後<else>午前</if><if $hour><switch $hour><case>{1}<case>{2}<case>{3}<case>{4}<case>{5}<case>{6}<case>{7}<case>{8}<case>{9}<case>{10}<case>{11}<case>{0}<case>{1}<case>{2}<case>{3}<case>{4}<case>{5}<case>{6}<case>{7}<case>{8}<case>{9}<case>{10}<case>{11}</switch><else>{0}</if>時に更新されます。
#. de: Die Wochenziele haben verschiedene Schwierigkeitsstufen: leicht, mittel und schwer. Sie werden jeden <reset-time 17 2><switch $weekday><case>Sonntag<case>Montag<case>Dienstag<case>Mittwoch<case>Donnerstag<case>Freitag<case>Samstag</switch> um <if $hour><switch $hour><case>{1}<case>{2}<case>{3}<case>{4}<case>{5}<case>{6}<case>{7}<case>{8}<case>{9}<case>{10}<case>{11}<case>{12}<case>{13}<case>{14}<case>{15}<case>{16}<case>{17}<case>{18}<case>{19}<case>{20}<case>{21}<case>{22}<case>{23}</switch><else>{0}</if>:00 Uhr (Erdenzeit) zurückgesetzt.
#. fr: Les défis hebdomadaires sont répartis en trois niveaux de difficulté<nbsp>: facile, moyen et difficile. De nouveaux défis sont proposés tous les <reset-time 17 2><switch $weekday><case>dimanches<case>lundis<case>mardis<case>mercredis<case>jeudis<case>vendredis<case>samedis</switch> à <if $hour><switch $hour><case>{1}<case>{2}<case>{3}<case>{4}<case>{5}<case>{6}<case>{7}<case>{8}<case>{9}<case>{10}<case>{11}<case>{12}<case>{13}<case>{14}<case>{15}<case>{16}<case>{17}<case>{18}<case>{19}<case>{20}<case>{21}<case>{22}<case>{23}</switch><else>{0}</if>h (temps réel).
#. macro: <reset-time 17 2> — sets the time placeholders to the next daily or weekly reset; hour = 17, weekday = 2 (game data: keep it; it may move or repeat)
#. macro: <switch $weekday><case>Sunday<case>Monday<case>Tuesday<case>Wednesday<case>Thursday<case>Friday<case>Saturday</switch> — shows the case whose position equals the value: the first <case> for 1, the second for 2, …; value = day of the week of the set time, 1 for Sunday (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $hour><switch $hour><case>{1}<case>{2}<case>{3}<case>{4}<case>{5}<case>{6}<case>{7}<case>{8}<case>{9}<case>{10}<case>{11}<case>{12}<case>{1}<case>{2}<case>{… — shows the first branch when the condition holds, otherwise the branch after <else>; condition = hour of the set time, 0–23 (condition: may be reworded, restructured, added, or dropped)
#. macro: <switch $hour><case>{1}<case>{2}<case>{3}<case>{4}<case>{5}<case>{6}<case>{7}<case>{8}<case>{9}<case>{10}<case>{11}<case>{12}<case>{1}<case>{2}<case>{3}<case>{4… — shows the case whose position equals the value: the first <case> for 1, the second for 2, …; value = hour of the set time, 0–23 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($hour >= 12)>p.m.<else>a.m.</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = hour of the set time, 0–23 >= 12 (condition: may be reworded, restructured, added, or dropped)
msgctxt "custom/005/CtsEtcAozEntrance_00558:TEXT_CTSETCAOZENTRANCE_00558_BLUESKYGUIDE_000_035:1"
msgid "There are three levels of difficulty for weekly targets: novice, moderate, and advanced. Progress is reset every <reset-time 17 2><switch $weekday><case>Sunday<case>Monday<case>Tuesday<case>Wednesday<case>Thursday<case>Friday<case>Saturday</switch> at <if $hour><switch $hour><case>{1}<case>{2}<case>{3}<case>{4}<case>{5}<case>{6}<case>{7}<case>{8}<case>{9}<case>{10}<case>{11}<case>{12}<case>{1}<case>{2}<case>{3}<case>{4}<case>{5}<case>{6}<case>{7}<case>{8}<case>{9}<case>{10}<case>{11}</switch><else>{12}</if> <if ($hour >= 12)>p.m.<else>a.m.</if> (Earth time)."
msgstr ""
