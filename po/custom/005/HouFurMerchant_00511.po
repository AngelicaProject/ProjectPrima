msgid "Select race and gender. (Current setting: <if ($n2 == 0)>Male<else>Female</if> <sheet Race $n1 0>)"
msgstr "Выбрать расу и пол. (Сейчас: <if ($n2 == 0)>мужчина<else>женщина</if>, <sheet Race $n1 0>)"

#. ja: ポーズを選択する [ <sheet HousingMerchantPose $n1 1> ]
