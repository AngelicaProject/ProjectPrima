# cut_scene/050/VoiceMan_05006 · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 誰カシラ……？<br>私ヲ城カラ……出シテクレルノ……？
#. de: Wer kommt denn da in mein Schloss? Bist du hier, um mich zu befreien?
#. fr: Qui est-ce...<nbsp>? Êtes-vous là... pour me sortir de ce château ennuyeux...<nbsp>?
#. speaker: OLDTITANIA
msgctxt "cut_scene/050/VoiceMan_05006:TEXT_VOICEMAN_05006_000001_OLDTITANIA:1"
msgid "Who goes there? Are you the one who broke the seal?"
msgstr ""

#. ja: 早ク遊ビタイ……遊ンデ遊ンデ……タクサン食ベルノ……<br>オナカイッパイマデ……ミンナ……ミィンナ……
#. de: Ich langweile mich so! Es ist so gemein! Ich will spielen, mich vergnügen und essen, ich will <i>sie alle fressen</i>!
#. fr: Je veux jouer... Jouer et manger... J'ai si faim...<br>Approchez... que je me rassasie...
#. speaker: OLDTITANIA
msgctxt "cut_scene/050/VoiceMan_05006:TEXT_VOICEMAN_05006_000002_OLDTITANIA:1"
msgid "Ah, so much time lost... So much frolicking and feasting left undone..."
msgstr ""

#. ja: 違ウノナラ……アナタガ遊ンデ……遊ンデヨ……！<br>ズット！ ズット！ 永遠ニッ！
#. de: Nein? Dann bleibst du eben hier! Und tanzt mit mir, für immer und ewig!
#. fr: Vous n'êtes pas là pour me libérer...<nbsp>? Alors restez avec moi<nbsp>!<br>Nous jouerons ensemble... jusqu'à la fin des temps<nbsp>!
#. speaker: OLDTITANIA
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05006:TEXT_VOICEMAN_05006_000003_OLDTITANIA:1"
msgid "We must make up for it, we must... Beginning by playing with <i>you</i>!"
msgstr ""

#. ja: アァ……モゥ……踊レ……ナ……イ……
#. de: Aaah<nbsp>... Der Tanz hat ein Ende<nbsp>...
#. fr: Non... Je ne peux plus danser...
#. speaker: OLDTITANIA
msgctxt "cut_scene/050/VoiceMan_05006:TEXT_VOICEMAN_05006_000010_OLDTITANIA:1"
msgid "We can play...no more..."
msgstr ""

#. ja: 来たな反逆者ども……<br>跪き 頭を垂れよ 私はすべての王にして 新しき神ゾ！
#. de: Ich habe ein Anrecht auf meine Ordnung! Denn ich bin der Auserwählte! Ich bin ein Gott!
#. fr: Abandonnez votre rébellion de pacotille... Prosternez-vous devant votre roi, votre dieu<nbsp>!
#. speaker: VAUTHRY
msgctxt "cut_scene/050/VoiceMan_05006:TEXT_VOICEMAN_05006_000110_VAUTHRY:1"
msgid "Are you so determined to die? One last chance, villains: bow down and acknowledge your king. Your god!"
msgstr ""

#. ja: まさか……全能たる……私が……！？
#. de: Ich verstehe nicht<nbsp>... Es war mir doch versprochen<nbsp>...
#. fr: Impossible... Je suis... tout-puissant...
#. speaker: VAUTHRY
msgctxt "cut_scene/050/VoiceMan_05006:TEXT_VOICEMAN_05006_000120_VAUTHRY:1"
msgid "But...I am all-powerful..."
msgstr ""

#. ja: 全力で来い……！<br>私もまた 在るべき姿で 迎え撃ってやろう――
#. de: Zeigt mir eure Stärke! Und ich zeige euch, wie schwach ihr wirklich seid.
#. fr: Venez<nbsp>! Il est temps de tomber les masques... et de nous affronter sous notre véritable jour<nbsp>!
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05006:TEXT_VOICEMAN_05006_000210_EMETSELCH:1"
msgid "Show me your “vaunted” strength. And I shall expose the lie of your fragmented existence!"
msgstr ""

#. ja: 認められん……断じて……！
#. de: Nein. Ich lasse es nicht zu!
#. fr: Le monde est à nous... et à personne d'autre...<nbsp>!
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05006:TEXT_VOICEMAN_05006_000220_EMETSELCH:1"
msgid "You...you have no power over me!"
msgstr ""
