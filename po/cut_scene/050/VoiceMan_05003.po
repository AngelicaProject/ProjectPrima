# cut_scene/050/VoiceMan_05003 · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: (-男性の叫び声-)来るぞ、罪喰いだッ！
#. de: Sie kommen! Sünden<shy>ver<shy>tilger im Anflug!
#. fr: (-Habitant de Cristarium-)Les voilà<nbsp>! Les purgateurs arrivent<nbsp>!
#. speaker: CRYSTARIUMMAN
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000010_CRYSTARIUMMAN:1"
msgid "(-Distressed Townsman-)Sin eaters sighted! They're coming!"
msgstr ""

#. ja: よし……！<br>防壁の展開は、成功したようだ。
#. de: Na also, das Schutzfeld hält!
#. fr: Parfait<nbsp>! Le mur protecteur a rempli son office.
#. speaker: ALPHINAUD
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000020_ALPHINAUD:1"
msgid "Excellent. The barrier is holding."
msgstr ""

#. ja: ひとまず、街中の安全は確保ね……！<br>次はどうするの！？
#. de: Damit dürfte die Stadt vorerst sicher sein. Was machen wir als Nächstes?
#. fr: Pour l'instant, nous devons nous assurer que tout va bien dans la cité... mais après<nbsp>?
#. speaker: ALISAIE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000030_ALISAIE:1"
msgid "That's good news for the Crystarium, but what of the rest of Lakeland?"
msgstr ""

#. ja: レイクランド各所では、ライナたち衛兵団を中心として、<br>罪喰いとの戦闘が始まっているんだ。
#. de: Der Angriff hat begonnen. Lyna und ihre Wachsoldaten werden überall im Seenland herausgefordert.
#. fr: Lyna et ses soldats sont en train de combattre les purgateurs du côté de Grand-Lac.
#. speaker: ALPHINAUD
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000040_ALPHINAUD:1"
msgid "Lyna and the city guard have taken to the field."
msgstr ""

#. ja: すでに、サンクレッドたちも戦線に加わっている。<br>私たちも合流して、罪喰いを追い払おう……！
#. de: Thancred und die anderen sind auch schon auf dem Schlachtfeld. Lassen wir sie nicht warten!
#. fr: Thancred et les autres les ont rejoints, et nous ferions bien d'en faire autant<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000050_ALPHINAUD:1"
msgid "Thancred and the others have already joined them. Let us do the same."
msgstr ""

#. ja: 数が、多い……っ！
#. de: Es sind einfach zu viele!
#. fr: Ils sont... si nombreux...<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000060_RYNE:1"
msgid "There are so many..."
msgstr ""

#. ja: うっ、ああっ……！
#. de: Uh<nbsp>... Ahhh!
#. fr: (-Voix familière-)Haaah...
#. speaker: LYNA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000070_LYNA:1"
msgid "Godsdammit!"
msgstr ""

#. ja: ライナさん！
#. de: Lyna!
#. fr: Lyna<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000080_RYNE:1"
msgid "Lyna!"
msgstr ""

#. ja: ハァッ
#. de: Ha!
#. fr: Ha<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000090_RYNE:1"
msgid "(ATTACK GRUNT)"
msgstr ""

#. ja: ライナさん、しっかりしてください……！
#. de: Lyna, halte durch!
#. fr: Lyna<nbsp>! Tenez bon<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000100_RYNE:1"
msgid "Lyna, hold on!"
msgstr ""

#. ja: ……だめ……罪喰い、させたのは……別に……！
#. de: Pass auf<nbsp>...! Ein paar<nbsp>... haben sich<nbsp>... verwandelt<nbsp>...
#. fr: ... sur vos gardes... camarades... en monstres... dans les parages...
#. speaker: LYNA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000110_LYNA:1"
msgid "They...they turned on me..."
msgstr ""

#. ja: ぐはッ
#. de: Pah! 
#. fr: ぐはッ
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000120_THANCRED:1"
msgid "(COUGHING BLOOD)"
msgstr ""

#. ja: サンクレッド……ッ！
#. de: Thancred!
#. fr: Thancred<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000130_RYNE:1"
msgid "Thancred!"
msgstr ""

#. ja: こいつに、手を……出すな……ッ！
#. de: Lass die Finger von ihr!
#. fr: Je t'interdis... de la toucher<nbsp>!
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000140_THANCRED:1"
msgid "This...one...is mine!"
msgstr ""

#. ja: がんばれ、もう少しの辛抱だからな……！
#. de: Komm schon! Beiß die Zähne zusammen!
#. fr: Tiens bon<nbsp>! On y est presque<nbsp>!
#. speaker: CRYSTARIUMGARDYOUNG
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000150_CRYSTARIUMGARDYOUNG:1"
msgid "We need only hold out a little while longer."
msgstr ""

#. ja: さっき、援軍が来たって、誰かが言ってた。<br>だから……だから、もう大丈夫だ……！
#. de: Bald kommt die Verstärkung. Dann sind wir gerettet! Halte durch!
#. fr: Les renforts arrivent, on va s'en sortir<nbsp>!
#. speaker: CRYSTARIUMGARDYOUNG
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000160_CRYSTARIUMGARDYOUNG:1"
msgid "Reinforcements are coming, remember? The captain said so. We're going to be all right..."
msgstr ""

#. ja: おい、逃げろ……！
#. de: He! Macht, dass ihr da weg kommt!
#. fr: Hé<nbsp>! Barrez-vous<nbsp>!
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000170_WARRIOROFDARKNESS:1"
msgid "Run! Run, damn you!"
msgstr ""

#. ja: 「闇の戦士」が来て、夜も取り戻したんだ。<br>俺たち、これからだろ……なあ！
#. de: <if $gn4>Die Kriegerin<else>Der Krieger</if> der Dunkelheit hat uns die Nacht zurückgebracht. Alles wird gut<if $gn4> werden</if>!
#. fr: <if $gn4>La Guerrière<else>Le Guerrier</if> des Ténèbres est là. <if $gn4>Elle<else>Il</if> a ramené la nuit<nbsp>! Pour nous, la vie ne fait que commencer<nbsp>!
#. speaker: CRYSTARIUMGARDYOUNG
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000180_CRYSTARIUMGARDYOUNG:1"
msgid "The Warrior of Darkness has returned. The bloody <i>night</i> has returned! So stay with me, eh? You can't go dying now!"
msgstr ""

#. ja: チクショウ……！<br>止まれ……止まってくれ……ッ！
#. de: Lass sie in Ruhe, du Ungeheuer!
#. fr: Bordel... Recule<nbsp>! J'te dis de reculer<nbsp>!!
#. speaker: WARRIOROFDARKNESS
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000190_WARRIOROFDARKNESS:1"
msgid "Godsdammit! Please let this work, <i>please</i> let this work..."
msgstr ""

#. ja: っ…！
#. de: Ah<nbsp>...
#. fr: Hum...<nbsp>!?
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000200_WARRIOROFDARKNESS:1"
msgid "(WHIFF GRUNT)"
msgstr ""

#. ja: あっ……い、いやだ、来るな、来るなぁッ！
#. de: Uah!<nbsp>... Bleib weg! Nein! Neiiin!
#. fr: Oh non<nbsp>! Va-t'en<nbsp>! Dégage<nbsp>!!
#. speaker: CRYSTARIUMGARDYOUNG
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000210_CRYSTARIUMGARDYOUNG:1"
msgid "No! N-No, stay back! Stay back!"
msgstr ""

#. ja: うわああああああッ！
#. de: Uaaahhh!
#. fr: Ouaaah<nbsp>!
#. speaker: CRYSTARIUMGARDYOUNG
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000220_CRYSTARIUMGARDYOUNG:1"
msgid "Help, help! Someone, anyone!"
msgstr ""

#. ja: だったら、なんで……なんでなんだよ……。<br>俺は、何のために……！
#. de: Verdammt noch mal! Nichts kann ich ausrichten! Was soll ich überhaupt hier?
#. fr: Qu'est-ce que je fais ici... Je sers à rien<nbsp>!
#. speaker: WARRIOROFDARKNESS
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000230_WARRIOROFDARKNESS:1"
msgid "Why did you spare <i>me</i>? Why? What have I done to deserve this <i>mercy</i>!?"
msgstr ""

#. ja: 進め、進めーッ！<br>まだ戦えるものは合流、負傷者は後方に移送せよ！
#. de: Vorwärts, vorwärts! Nicht aufgeben! Wer kämpfen kann, kämpft! Die Verletzten ziehen sich zurück!
#. fr: En avant<nbsp>! Allez<nbsp>!! Que ceux qui peuvent encore se battre me rejoignent<nbsp>! Et qu'on emmène les blessés à l'arrière<nbsp>!
#. speaker: CRYSTARIUMGARDOLD
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000240_CRYSTARIUMGARDOLD:1"
msgid "Forward! <i>Forward</i>! If you can still hold a sword, follow me! Wounded, to the rear!"
msgstr ""

#. ja: 大丈夫だ……我らは勝てる！<br>この者を中心に、陣形を組みなおせ！
#. de: Noch haben wir nicht verloren! Schließt die Formation!
#. fr: Ça va aller... On vaincra<nbsp>! Serrez les rangs autour <if $gn4>d'elle<else>de lui</if><nbsp>!
#. speaker: CRYSTARIUMGARDOLD
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000250_CRYSTARIUMGARDOLD:1"
msgid "Weapons at the ready! Let's make this count!"
msgstr ""

#. ja: 英雄なきはずの世界で それはなお眩く
#. de: Heldenmut in einer Welt, die ihre Helden längst vergessen hat.
#. fr: Dans un monde qu'on croyait sans héros, ce combat fut d'autant plus remarquable.
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000260_WARRIOROFDARKNESS:1"
msgid "Fight and struggle. Seek salvation by your own hands."
msgstr ""

#. ja: 多くの犠牲を出しながらも<br>その奮闘によって 戦いは辛うじて終結した――
#. de: Ein Sieg, errungen mit dem letzten Atemzug, doch zu welchem Preis? Zu welchem Preis?
#. fr: Nombreux furent les sacrifices, mais c'est cet engouement qui leur permit de survivre.
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000270_WARRIOROFDARKNESS:1"
msgid "Though the losses be grave, endure them. Though the victories be hollow, claim them."
msgstr ""

#. ja: ……ああ、すみません。<br>何か御用だったでしょうか？
#. de: Ah, du bist es. Was gibt's?
#. fr: Ah, désolée... Vous avez besoin de quelque chose<nbsp>?
#. speaker: LYNA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000280_LYNA:1"
msgid "Oh. I did not see you there. Is there something you need?"
msgstr ""

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que répondez-vous à Lyna<nbsp>?
#. speaker: Q1
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_Q1_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr ""

#. ja: 大丈夫……？
#. de: Wie geht es dir?
#. fr: Ça va aller<nbsp>?
#. speaker: A1
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_A1_000_001_NONE_VOICE:1"
msgid "No, no, I'm fine. How are you feeling?"
msgstr ""

#. ja: 団長が参っていてどうする
#. de: Deine Soldaten brauchen dich.
#. fr: Vos soldats ne devraient pas vous voir comme ça...
#. speaker: A1
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_A1_000_002_NONE_VOICE:1"
msgid "Shouldn't you be resting? What would the guard do without their captain?"
msgstr ""

#. ja: 大きな戦いでしたから、多少の怪我は致し方ありません。<br>こうして命があるのですから、平気です。
#. de: Es war ein blutiger Kampf und ich hab ganz schön was abbekommen. Aber ich lebe, das zählt.
#. fr: Ce genre de bataille fait toujours de nombreux blessés... Mais c'est aussi grâce à eux si nous sommes encore en vie.
#. speaker: LYNA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000290_LYNA:1"
msgid "Injuries are part and parcel of battle. While there's breath in my lungs, I shall see my duties done."
msgstr ""

#. ja: ……まったくです。<br>こんなときに、油を売っているべきではありませんね。
#. de: Du sagst es. Wir haben keine Zeit zu verschenken.
#. fr: Effectivement. Ce n'est pas le moment de se tourner les pouces...
#. speaker: LYNA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000300_LYNA:1"
msgid "...Appoint another. A captain's place is with her soldiers in the field."
msgstr ""

#. ja: あなたには、皆を代表して、感謝を。<br>その活躍がなければ、間違いなく被害はさらに深刻でした。
#. de: Ich möchte dir im Namen von uns allen danken. Ohne dich hätten wir womöglich noch größere Verluste erlitten.
#. fr: Je dois vous remercier... de notre part à tous. Sans vous, les dégâts auraient été encore plus importants.
#. speaker: LYNA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000310_LYNA:1"
msgid "Don't pretend you are not of the same mind. You fought well today. Saved a great many lives. Thank you."
msgstr ""

#. ja: 衛兵団については、すぐに立て直しを図ります。<br>また襲撃があっても持ちこたえられるよう、<br>一層の強化に努めましょう。
#. de: Ich kümmere mich darum, dass die Wache so schnell wie möglich wieder einsatzbereit ist. Der nächste Angriff wird nicht lange auf sich warten lassen.
#. fr: Nous allons restructurer les troupes et renforcer les rangs afin de mieux endurer les assauts.
#. speaker: LYNA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000320_LYNA:1"
msgid "Unfortunately, this war is far from over. We must replenish our ranks and shore up our defenses before they attack again."
msgstr ""

#. ja: ……それでは、失礼します。
#. de: Jetzt entschuldige mich bitte.
#. fr: ... Si vous voulez bien m'excuser, je vais devoir vous laisser.
#. speaker: LYNA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000330_LYNA:1"
msgid "Now, if you will excuse me."
msgstr ""

#. ja: つっ…
#. de: Ha ...
#. fr: (Impro<nbsp>: petit cri douloureux de la personne qui s'effondre)
#. speaker: LYNA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000340_LYNA:1"
msgid "(FALLING TO GROUND REAX)"
msgstr ""

#. ja: …………悔しい。
#. de: Es tut weh<nbsp>...
#. fr: Je m'en veux...
#. speaker: LYNA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000350_LYNA:1"
msgid "I...am fine..."
msgstr ""

#. ja: 悔しい、悔しい……悔しい……ッ！<br>負傷した自分も、仲間を護れなかった自分も……！
#. de: Verdammt, verdammt, verdammt. Was ist der Schmerz meiner Wunden gegen die Schuld, meine Soldaten in den Tod geführt zu haben?
#. fr: Je m'en veux... Je m'en veux tellement<nbsp>! Je n'ai protégé personne... Ni les autres... ni moi<nbsp>!
#. speaker: LYNA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000360_LYNA:1"
msgid "Completely...and utterly...fine! Better than fine! Hale and hearty and still alive to mourn those who are not. Who I failed to protect when they needed me most."
msgstr ""

#. ja: ここまできて……あと少しで……<br>みんなで幸せになれたはずなのに……！
#. de: Sie alle hatten eine bessere Zukunft verdient. So viele von ihnen werden sie nun nicht mehr erleben.
#. fr: On était à deux doigts d'être heureux, tous ensemble...
#. speaker: LYNA
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000370_LYNA:1"
msgid "We've come so far─so <i>godsdamned</i> far! I could have sworn the end was in sight. And now..."
msgstr ""

#. ja: 一緒に、いけなかった……ッ……！
#. de: Ausgerechnet jetzt<nbsp>... wo sie zum Greifen nahe ist.
#. fr: Et nos routes se séparent...
#. speaker: LYNA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000380_LYNA:1"
msgid "Now they will never see it."
msgstr ""

#. ja: (-ヴァウスリーの声-)聞け、クリスタリウムの民……愚かなる民ヨ……。
#. de: Hört her, einfältige Bewohner von Crystarium!
#. fr: (-Voix de Vauthry-)Oyez, misérables habitants de Cristarium<nbsp>!
#. speaker: VAUTHRY
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000390_VAUTHRY:1"
msgid "(-Vauthry-)Impudent worms of the Crystarium."
msgstr ""

#. ja: (-ヴァウスリーの声-)私、ユールモアのヴァウスリーが宣告しよウ……。<br>此度の襲撃こそ、お前たちの愚行に対する、天罰であル。
#. de: Hier spricht Vauthry, Herrscher von Eulmore. Dieser Angriff war eine göttliche Strafe, um euch eure Torheit vorzuführen.
#. fr: (-Voix de Vauthry-)Moi, Vauthry, j'ai fait le chemin depuis Eulmore pour vous guider. Cette attaque n'est rien d'autre qu'un châtiment divin, qui s'est abattu sur vous en réponse à votre com<shy>por<shy>te<shy>ment idiot<nbsp>!
#. speaker: VAUTHRY
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000400_VAUTHRY:1"
msgid "(-Vauthry-)The tragedy that has befallen you is of your own making. Divine retribution for your defiance."
msgstr ""

#. ja: (-ヴァウスリーの声-)滅びゆくこの世界は、最後の希望として私を生み出しタ。<br>私は、人と罪喰いの盟約を結び、楽園を築く者であル。
#. de: Die sterbende Welt hat mich geboren, damit ich euch ein Paradies erschaffe. Ich bin die letzte Hoffnung! Denn ich bin mit den Sünden<shy>ver<shy>tilgern über einen unauflösbaren Pakt verbunden.
#. fr: (-Voix de Vauthry-)J'ai été enfanté par ce monde en perdition pour porter vos derniers espoirs. J'incarne l'indéfectible alliance entre les hommes et les purgateurs. Je suis celui qui fera de cette terre un paradis<nbsp>!
#. speaker: VAUTHRY
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000410_VAUTHRY:1"
msgid "(-Vauthry-)The heavens have bequeathed to you a benevolent savior─me! I offer you freedom from pain and suffering─a paradise where man and sin eater might live in peace and harmony..."
msgstr ""

#. ja: (-ヴァウスリーの声-)事実、罪喰いは私と、私の僕を決して喰らわなイ。<br>それはなぜか……喰らうべき罪がないからダ。
#. de: Die Sünden<shy>ver<shy>tilger verschonen mich und die Meinen. Und warum? Weil wir frei von Sünde sind!
#. fr: (-Voix de Vauthry-)Car jamais les purgateurs ne s'en prendront à moi... Pour la simple et bonne raison que je n'ai commis aucun péché<nbsp>!
#. speaker: VAUTHRY
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000420_VAUTHRY:1"
msgid "(-Vauthry-)Why, already our winged brothers and sisters regard me and mine as kin, alike to them in beauty and purity!"
msgstr ""

#. ja: (-ヴァウスリーの声-)対して、お前たちの罪は深まるばかリ……。<br>私の秩序に従わず、罪喰い狩りに加担するとは……。
#. de: Ihr hingegen versinkt tiefer und tiefer im Morast der Schuld. Ihr stellt euch auf die Seite derer, die die Sündervertilger jagen und morden, anstatt meiner Verheißung zu folgen.
#. fr: (-Voix de Vauthry-)Regardez-vous, empêtrés dans les vôtres<nbsp>! Vous m'avez désobéi et vous avez chassé les purgateurs...
#. speaker: VAUTHRY
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000430_VAUTHRY:1"
msgid "(-Vauthry-)But you─you not only reject my proffered hand, but raise your own against my sin eaters. 'Tis only right that they respond in kind."
msgstr ""

#. ja: (-ヴァウスリーの声-)此度の悲劇をもって、悔い改めヨ。<br>お前たちの行いは、秩序に仇なす、悪しき反逆であル！
#. de: Erkennt euren Irrtum! Bereuet, tut Buße! Fügt euch der Ordnung und findet Erlösung!
#. fr: (-Voix de Vauthry-)J'espère que cette tragédie vous aura servi de leçon. Votre petite rébellion est une abomination qui perturbe l'ordre naturel.
#. speaker: VAUTHRY
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000440_VAUTHRY:1"
msgid "(-Vauthry-)Let this be a lesson to all those who would walk the path of sin─the wicked shall not inherit this world!"
msgstr ""

#. ja: 皆、よくそろってくれた。<br>まず、此度の罪喰いによる襲撃についてだが……
#. de: Danke, dass ihr alle gekommen seid. Lasst mich zuerst etwas zum Angriff der Sünden<shy>ver<shy>tilger sagen.
#. fr: Merci de vous être rassemblés ici aujourd'hui. Je voudrais d'abord que l'on discute de l'attaque des purgateurs qui s'est produite un peu plus tôt...
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000450_MYSTERYVOICE:1"
msgid "My friends. With your aid we have weathered a brutal assault..."
msgstr ""

#. ja: なんだ、遅刻厳禁なら最初からちゃんと呼べ。
#. de: Ooh, bitte verzeiht die Verspätung, aber mir hat einfach niemand Bescheid gesagt.
#. fr: Bah quoi<nbsp>? Si vous ne vouliez pas que j'arrive en retard, il fallait me convoquer à votre petite réunion...
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000460_EMETSELCH:1"
msgid "Sorry I'm late. Though I would not have been had anyone thought to notify me in advance."
msgstr ""

#. ja: 此度の襲撃だが、あなた方には本当に助けられた。<br>この街を預かる者として、感謝にたえない。
#. de: Ihr habt uns während des Angriffs heldenhaft zur Seite gestanden. Ich danke euch, im Namen der ganzen Stadt.
#. fr: Sans vous, je ne sais pas ce que nous serions devenus. En tant que gardien de cet endroit, je tenais à vous remercier.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000470_MYSTERYVOICE:1"
msgid "...As I was saying, it was only with your aid that we weathered this assault. Without it, the Crystarium and all who dwell here would now be gone."
msgstr ""

#. ja: しかし、少なくない被害が出てしまった……。
#. de: Es hat nicht gereicht, die vielen Schäden zu verhindern.
#. fr: Les dégâts ont tout de même été importants...
#. speaker: ALPHINAUD
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000480_ALPHINAUD:1"
msgid "For each we saved, another perished."
msgstr ""

#. ja: クリスタリウムは、とっくに私たちの家でもあるんだ。<br>何か手伝えることがあれば、遠慮なくいってほしい。
#. de: Crystarium ist unser zweites Zuhause geworden. Wenn es irgendetwas gibt, das wir tun können, sag es uns bitte.
#. fr: Cristarium, c'est un peu chez nous. N'hésitez pas à nous demander de l'aide.
#. speaker: ALPHINAUD
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000490_ALPHINAUD:1"
msgid "If there is anything else we can do to help─anything at all─you need only ask. This is our home too, and we want nothing more than to keep it safe."
msgstr ""

#. ja: ……ありがとう。<br>その言葉だけでも、民がどれだけ励まされることか。
#. de: Vielen Dank. Euer Zuspruch bedeutet uns sehr viel.
#. fr: Merci. Vos paroles iront droit au cœur des habitants.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000500_MYSTERYVOICE:1"
msgid "Thank you. We are blessed to have you with us."
msgstr ""

#. ja: ヴァウスリーは、これを天罰と言った。<br>しかし、本能のまま襲撃をおこなう罪喰いが、<br>意図的に罰を与えにきたとは考えにくい。
#. de: Vauthry bezeichnete den Angriff als „göttliche Strafe“. Ich bezweifle aber, dass die Sünden<shy>ver<shy>tilger willentlich gekommen sind, um uns zu strafen. Sie sind reine Instinktwesen.
#. fr: Vauthry a qualifié cet événement de châtiment divin, mais les purgateurs agissent par instinct plus que par dessein. Difficile d'imaginer qu'ils aient sciemment cherché à nous punir.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000510_MYSTERYVOICE:1"
msgid "As for the attack itself─Vauthry may call it divine retribution, but sin eaters are creatures of instinct. A coordinated assault is unprecedented."
msgstr ""

#. ja: ましてや、レイクランドはすでに光が掃われた場所。<br>大罪喰いならばともかく、下級のものは避けたがるはずだ。
#. de: Ganz zu schweigen davon, dass die niederrangigen unter ihnen die vom Licht befreiten Gebiete eigentlich meiden.
#. fr: D'autant plus que la Lumière a été chassée de Grand-Lac... Ces créatures ne devraient plus tenter de s'en approcher en l'absence d'un grand purgateur.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000520_MYSTERYVOICE:1"
msgid "Moreover, in the absence of a Lightwarden, there should have been no compulsion for lesser sin eaters to congregate here en masse. All of which points to a single, unavoidable conclusion..."
msgstr ""

#. ja: ならば、意思なき罪喰いに、<br>指示を与えた者があったと考えるべきでしょう……。
#. de: Man kann nur einen Schluss daraus ziehen: Jemand hat die Sünden<shy>ver<shy>tilger gesteuert.
#. fr: S'ils n'ont pas de volonté propre, on peut alors imaginer que quelqu'un les a guidés jusqu'ici...
#. speaker: URIANGER
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000530_URIANGER:1"
msgid "...That these minions of light answer to a higher power."
msgstr ""

#. ja: 奇しくも自身で名乗り上げていたとおり、<br>それが可能なのは世界にただひとり……<br>ドン・ヴァウスリー、その人です。
#. de: Und ich denke, er hat sich uns selbst offenbart. Lord Vauthry höchst<shy>persön<shy>lich.
#. fr: Il n'y a qu'une personne en ce monde qui en est capable, et bizarrement, elle s'en est elle-même vantée... Je veux bien entendu parler de don Vauthry.
#. speaker: URIANGER
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000540_URIANGER:1"
msgid "He who did claim kinship with them─who did boast of control, not in idleness, 'twould seem, but in earnest. Lord Vauthry."
msgstr ""

#. ja: ああ……。<br>ゆえに、クリスタリウムはここで屈するわけにはいかない。<br>それこそ彼の思う壺なのだから。
#. de: Ja, das denke ich auch. Und deshalb dürfen wir uns ihm auf keinen Fall unterwerfen. Genau das wäre der Untergang, den er uns prophezeit.
#. fr: Tout à fait. Voilà pourquoi Cristarium ne doit pas fléchir. Il ne faut pas tomber dans son piège.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000550_MYSTERYVOICE:1"
msgid "Indeed. What I mistook for bluster was in fact the truth. The sin eaters are his to command. But if he imagines this show of force will convince us to bend the knee, he is sorely mistaken."
msgstr ""

#. ja: そうだ、ヴァウスリーといえば、<br>ユールモアに呼ばれた件はどうだったの？
#. de: Da fällt mir ein, was ist eigentlich aus deinem Besuch in Eulmore geworden?
#. fr: En parlant de ce type, comment s'est passée votre entrevue à Eulmore<nbsp>?
#. speaker: ALISAIE
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000560_ALISAIE:1"
msgid "I take it your meeting in Eulmore did <i>not</i> end well?"
msgstr ""

#. ja: 残念ながら、実りのある話し合いにはならなかった。<br>だが、収穫がなかったわけではない。
#. de: Das Gespräch war alles andere als ergiebig, aber ich habe dennoch etwas sehr Interessantes in Erfahrung gebracht.
#. fr: Elle n'aura pas les con<shy>sé<shy>quen<shy>ces espérées, mais elle n'a pas été inutile pour autant.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000570_MYSTERYVOICE:1"
msgid "You could say that, yes. But I am wiser for the experience, nevertheless."
msgstr ""

#. ja: ヴァウスリーは、どうやら魅了に類する術を使うようなのだ。<br>それによって私を傀儡にしようという魂胆で、召致したらしい。
#. de: Vauthry ist in der Lage, andere zu verhexen und gefügig zu machen. Er hatte mich nur herbeizitiert, um mich zu seiner Marionette zu machen.
#. fr: J'y ai appris que Vauthry utilisait des techniques similaires à des envoûtements. En tout cas, il m'avait invité dans l'intention de faire de moi sa marionnette.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000580_MYSTERYVOICE:1"
msgid "It appears he has mastered a technique which allows him to enslave the minds of others. A fact I discovered when he attempted to use it on me."
msgstr ""

#. ja: 君も見ただろう？<br>ユールモアにおける、異常なまでのヴァウスリー賛美を。
#. de: Wir haben gesehen, wie Vauthry in Eulmore verehrt wird. Es ist nicht normal.
#. fr: Vous avez remarqué, vous aussi<nbsp>? Les Eulmoriens lui vouent une adoration sans bornes.
#. speaker: ALPHINAUD
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000590_ALPHINAUD:1"
msgid "That would go some way towards explaining the peculiar reverence afforded him by his subjects."
msgstr ""

#. ja: あれらすべてが虚構とは言い切れないが、<br>市民たちにも精神支配が及んでいる可能性は高い……。
#. de: Manche jubeln ihm bestimmt auch aus freien Stücken zu, aber wir müssen davon ausgehen, dass er über die ganze Bevölkerung eine starke mentale Kontrolle ausübt.
#. fr: Je veux bien croire à la sincérité de certains, mais des civils pourraient être mentalement sous son emprise.
#. speaker: ALPHINAUD
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000600_ALPHINAUD:1"
msgid "There may feasibly be a handful of true believers among them, I suppose, but it would not surprise me if the vast majority were in his thrall."
msgstr ""

#. ja: 私は幻影をもちいることで回避したが、<br>今後、彼と直接対峙することになれば厄介だろう。
#. de: Diesmal konnte ich mich mit einer Illusion schützen. Aber eine direkte Konfrontation wäre äußerst gefährlich.
#. fr: Pour ma part, j'ai pu lui échapper en projetant une illusion, mais notre prochaine confrontation directe sera plus risquée.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000610_MYSTERYVOICE:1"
msgid "Had I not anticipated his treachery, I might well have joined them. But seeing his invitation for what it was, I sent a glamour in my stead. I rather doubt such tricks will avail me a second time, however."
msgstr ""

#. ja: コルシア島の大罪喰い捜索は？<br>一緒に進めてたんでしょう？
#. de: Was ist mit der Suche nach dem Licht<shy>bringer auf Kholusia? Hast du etwas herausgefunden?
#. fr: Et le grand purgateur de Kholusia<nbsp>? Des nouvelles<nbsp>?
#. speaker: ALISAIE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000620_ALISAIE:1"
msgid "Did you have any luck tracking down the Lightwarden in Kholusia?"
msgstr ""

#. ja: すまないが、良い報告はできそうもないよ。<br>……君の方は？
#. de: Nein, leider konnte ich nichts in Erfahrung bringen, was uns weiterhilft. Und du?
#. fr: Rien de réjouissant de ce côté-là... Et toi<nbsp>?
#. speaker: ALPHINAUD
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000630_ALPHINAUD:1"
msgid "Sadly, I have nothing to report on that front. What of Amh Araeng?"
msgstr ""

#. ja: 私も、いくつかの遺跡を巡ってみたけれど成果なし。<br>だから手を変えて、聞き込みに重点を置いてみたのよ。
#. de: Ich hab ein paar Ruinen untersucht, auch ohne Erfolg. Also ging ich dazu über, mich hier und da umzuhören.
#. fr: J'ai fait le tour d'un certain nombre de vestiges, mais je n'ai rien trouvé. Du coup, j'ai changé de stratégie et je me suis concentrée sur les habitants.
#. speaker: ALISAIE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000640_ALISAIE:1"
msgid "After a fruitless few days scouring ruins, I resorted to asking the locals."
msgstr ""

#. ja: ズバリって情報はなかったんだけど……<br>あるモルド族が、アム・アレーン西部に広がる廃坑道なら、<br>隠れるにはもってこいじゃないかって。
#. de: Vielleicht ist es ja nichts, aber ein Mordh sprach von einem stillgelegten Bergwerk westlich von Amh Araeng, das ein perfektes Versteck sein könnte.
#. fr: Je n'ai rien entendu de par<shy>ti<shy>cu<shy>liè<shy>rement utile, mais un Mord m'a dit que les mines abandonnées dans la partie ouest d'Amh Araeng seraient une cachette toute trouvée.
#. speaker: ALISAIE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000650_ALISAIE:1"
msgid "While no one I spoke to had seen any sign of the Warden, I did uncover a possible lead: an abandoned mine in western Amh Araeng. From what the Mord told me, it would be a perfect place to stay out of sight."
msgstr ""

#. ja: けど、広大な坑道を当てもなく歩き回ったんじゃ、<br>どれだけ時間がかかることか……。<br>だから、一旦帰ってきたってわけ。
#. de: Das Bergwerk ist riesig. Ich habe mir ein paar Stollen angesehen, aber alles alleine abzusuchen würde ewig dauern. Also bin ich erst einmal zurückgekommen.
#. fr: En revanche, les explorer au hasard m'aurait pris un temps fou. Du coup, j'ai préféré rentrer.
#. speaker: ALISAIE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000660_ALISAIE:1"
msgid "Of course, I could never hope to explore such a labyrinth quickly or safely on my own, so I returned here."
msgstr ""

#. ja: 少しずつ情報は集まっているけれど、<br>次の一手を決めるには、足りていないわね……。
#. de: Hm, das ist ein Anhaltspunkt. Aber nicht genug, um den nächsten Schritt zu planen.
#. fr: Nous progressons à bon rythme, mais nous ne pouvons toujours privilégier aucune piste...
#. speaker: YSHTOLA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000670_YSHTOLA:1"
msgid "Even should we all join in the endeavor, an exhaustive search could take weeks─and with no guarantee of finding anything."
msgstr ""

#. ja: ……あの。<br>大罪喰いは、強い光を放っているものなんですよね。
#. de: Ähm<nbsp>... Die Licht<shy>bringer strahlen doch ein starkes Licht aus.
#. fr: Excusez-moi... Les grands purgateurs émettent une intense lumière, c'est bien ça<nbsp>?
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000680_RYNE:1"
msgid "The Wardens harbor vast reservoirs of primordial Light, do they not? Far beyond anything found in lesser sin eaters."
msgstr ""

#. ja: だったら、光を司る者……「光の巫女」ならば、<br>その居場所が感じ取れたりしないんでしょうか。
#. de: Müsste dann nicht das Orakel des Lichts diese Lichtquelle aufspüren können?
#. fr: Si c'est le cas, la prêtresse de la Lumière pourrait peut-être les détecter. Qu'est-ce que vous en pensez<nbsp>?
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000690_RYNE:1"
msgid "And isn't it true that the Oracle could see the Light of a sin eater from malms away? Surely a Warden would seem like a blazing beacon by comparison?"
msgstr ""

#. ja: 私みたいな、半端者じゃなくて……<br>本物の「光の巫女」、ミンフィリアなら……。
#. de: Nicht ein Abbild wie ich<nbsp>... Ich meine das echte Orakel. Minfilia müsste es können.
#. fr: Moi, je ne suis bonne à rien... mais la vraie Minfilia devrait en être capable.
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000700_RYNE:1"
msgid "To the real Oracle of Light, I mean. The real Minfilia."
msgstr ""

#. ja: アム・アレーンの南端、「光の氾濫」が止められた場所。<br>そこへ行けば、彼女を呼び戻すことが叶う。
#. de: Am Südende von Amh Araeng, dort wo das Orakel die Lichtflut aufgehalten hat. Dort werden wir sie zurückrufen können.
#. fr: Nous devrions pouvoir communiquer avec elle, si on se rend au sud d'Amh Araeng, là où elle a contenu le déluge de Lumière.
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000710_RYNE:1"
msgid "If we traveled to Amh Araeng, to the south where she halted the Flood, I could summon her back."
msgstr ""

#. ja: ……違いますか、サンクレッド。
#. de: So ist es doch, oder, Thancred?
#. fr: Pas vrai, Thancred<nbsp>?
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000720_RYNE:1"
msgid "What do you think?"
msgstr ""

#. ja: …………違う。
#. de: Nein.
#. fr: Tu te trompes<nbsp>!
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000730_THANCRED:1"
msgid "...Don't."
msgstr ""

#. ja: いいえ、違わない……違わないはずです！
#. de: Doch, es ist möglich! Es muss möglich sein!
#. fr: J'ai raison, je sais que c'est possible<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000740_RYNE:1"
msgid "Don't what? Do what I can? What we both know is right!?"
msgstr ""

#. ja: 不用意に口にしていい言葉じゃないぞ。<br>お前は……それがどういう意味なのか、<br>わかって言っているのか。
#. de: Hör auf. Du weißt ja gar nicht, wovon du da redest.
#. fr: Sais-tu vraiment ce que tu dis<nbsp>? Tu réalises ce que ça implique<nbsp>?
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000750_THANCRED:1"
msgid "Do not presume to know my mind. You have no idea what you're proposing."
msgstr ""

#. ja: ちゃんとわかっています！<br>確かに、あなたからは何も聞いてない……<br>あなたは優しいから、何も言ってくれなかったけど……っ！
#. de: Doch, das weiß ich ganz genau. Du hast mir zwar nie etwas erzählt<nbsp>... weil du so nett bist und mich beschützen wolltest!
#. fr: Bien sûr que je le sais<nbsp>! Et ce n'est pas grâce à toi... Tu es bien trop prévenant pour me faire part de ce genre de problème.
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000760_RYNE:1"
msgid "But I do! I know why you never said anything. Because you thought you could keep me safe by keeping me in the dark."
msgstr ""

#. ja: 私だって、何も気づかずについてきたわけじゃない……。<br>そんなにも、サンクレッドに無関心だったわけじゃない！
#. de: Aber ich spüre Dinge, und ich bin neugierig. Glaubst du denn wirklich, dass ich mir in meinem Inneren keine Fragen stelle?
#. fr: Sache que je ne t'ai pas suivi aveuglément. J'ai bien remarqué que ça n'allait pas<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000770_RYNE:1"
msgid "And...maybe I thought so too. But I knew, Thancred. I always knew!"
msgstr ""

#. ja: ああ、なるほど。<br>道理で「光の巫女」の生まれ変わりにしては、凡庸だと思った。
#. de: Ich seh schon. So eine Wiedergeburt scheint keine einfache Angelegenheit zu sein.
#. fr: Je comprends mieux... Voilà pourquoi je trouvais la petite un peu légère pour une réincarnation de la prêtresse de la Lumière...
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000780_EMETSELCH:1"
msgid "Oh, I see... I thought you were a rather underwhelming reincarnation, but it all makes sense now."
msgstr ""

#. ja: 「光の巫女」は、まだそいつの中で眠っている。<br>すべての力を引き出すには、<br>完全な一体化を果たさなければならない……。
#. de: Das Orakel schläft noch im Körper dieses Mädchens. Um die ganze Kraft zu wecken, müssen beide vollständig eins werden.
#. fr: C'est parce que la vraie sommeille encore en elle. Elles ne doivent faire qu'une pour que ses pouvoirs se révèlent...
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000790_EMETSELCH:1"
msgid "The Oracle lies dormant within you, doesn't she? But to draw on her true power, you must become one, both body and soul."
msgstr ""

#. ja: 結果、残ることができるのは、<br>本来の「光の巫女」の人格か、肉体を提供している者の人格か、<br>ふたつにひとつ……というところだろう？
#. de: Ich fürchte, das wird nur eine von beiden überstehen. Entweder die Seele des Orakels oder die Seele des Mädchens. Wer wird es bloß werden?
#. fr: En somme, il nous faut encore choisir entre l'âme de la prêtresse d'origine et celle qui habite ac<shy>tu<shy>el<shy>le<shy>ment ce corps. Évincer l'une des deux, pour qu'il n'en reste qu'une... C'est ça<nbsp>?
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000800_EMETSELCH:1"
msgid "To wit, one being must consume the other. Who shall be the lucky winner?"
msgstr ""

#. ja: ……お前には、関係ない。
#. de: Halt dich da raus. Die Sache geht dich gar nichts an.
#. fr: Mêle-toi de tes affaires<nbsp>!
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000810_THANCRED:1"
msgid "This doesn't concern you, Ascian."
msgstr ""

#. ja: ああ、そのとおり。<br>だがその言い方だと、お前は関係者なんだろう？<br>少なくとも、自分ではそう思ってるはずだ。
#. de: Das stimmt. Aber geht es dich denn etwas an? Du scheinst dich ja sehr um das Wohl des Mädchens zu sorgen.
#. fr: Rassure-toi, je m'y applique. Mais dis-moi, pour me parler ainsi, c'est que le sujet te concerne<nbsp>? À tes yeux, tout du moins<nbsp>?
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000820_EMETSELCH:1"
msgid "But it plainly concerns you. Which is why your heart is ready to burst out of your chest."
msgstr ""

#. ja: だったら、少なくともお前とその娘は、<br>きちんと話し合っておくべきだったな。<br>なぜ今の今まで黙っていた？
#. de: Solltet ihr dann nicht offen und ehrlich miteinander reden? Warum hast du die Wahrheit vor ihr verborgen?
#. fr: Si oui, peut-être aurais-tu pu prendre quelques minutes pour discuter de la situation avec cette jeune fille. Pourquoi avoir attendu le dernier moment<nbsp>?
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000830_EMETSELCH:1"
msgid "Despite the raging tempest in your bosom, however, you have never once opened up to your young charge. Now why would that be?"
msgstr ""

#. ja: 愛情か……。
#. de: Ist es etwa Liebe?
#. fr: Par affection...
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000840_EMETSELCH:1"
msgid "Love...?"
msgstr ""

#. ja: 何にせよ、いいじゃないか。<br>その娘の提案は、それなりに可能性があると思うぞ。<br>諸々手っ取り早くなるところが、非常に高得点だ。
#. de: Aber das geht mich nun wirklich nichts an. Ich meine bloß, dass der Vorschlag des Mädchens durchaus Aussicht auf Erfolg hat.
#. fr: Peu importe... La proposition de cette petite est par<shy>fai<shy>te<shy>ment sensée. Elle a l'avantage de nous faire gagner pas mal de temps.
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000850_EMETSELCH:1"
msgid "Well, I for one think it's a marvelous idea. Certainly more promising than any of your other suggestions."
msgstr ""

#. ja: 次に目指すは、アム・アレーンの南端、<br>「廃都ナバスアレン」で決まりだな？
#. de: Ich nehme an, euer nächstes Ziel ist also Nabaath Areng?
#. fr: Il ne nous reste plus qu'à nous rendre au sud d'Amh Araeng, à Nabaath Areng plus précisément.
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000860_EMETSELCH:1"
msgid "So─it's off to Amh Araeng we go!"
msgstr ""

#. ja: ……支度をしてくる。<br>街の入口で、再集合だ。
#. de: Ich bereite alles für die Reise vor. Wir treffen uns am Stadtausgang.
#. fr: Je vais me préparer. Rendez-vous à l'entrée de la cité.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000870_THANCRED:1"
msgid "I'll meet you at the gates."
msgstr ""

#. ja: 進むことで出会いがあり 進むことで別れがある
#. de: Auf Wanderers Wegen geben sich Begegnung und Abschied die Hand.
#. fr: Une route pavée de rencontres. Un chemin cadencé d'adieux.
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000880_WARRIOROFDARKNESS:1"
msgid "Take comfort in the bonds you share. Accept the pain when the time comes to part."
msgstr ""

#. ja: 恐らくそれを知りながら 彼らは足を進めていった
#. de: Schreite forsch voran, denn Freud und Leid sind Teil der Reise.
#. fr: Ils avançaient, conscients de ce qui les attendait.
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000890_WARRIOROFDARKNESS:1"
msgid "Press on, for joy and sorrow walk hand in hand."
msgstr ""

#. ja: ガリク山の峠道を過ぎると<br>目的の廃都まで 鉱脈を抱いたアンバーヒルが続く
#. de: Wer den Garik-Pass überschreitet, blickt auf die Bernsteinhügel<nbsp>- gefüllt mit Schätzen aus Erz und Mineralien.
#. fr: Au-delà du col du mont Garik, les collines d'Ambre et leurs filons s'étendaient jusqu'à la cité abandonnée. Leur destination...
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000900_WARRIOROFDARKNESS:1"
msgid "Beyond Mount Garik lie the Hills of Amber, beneath which run hidden veins of mineral wealth."
msgstr ""

#. ja: 多くの労働者で賑わったその地には<br>過ぎし日の営みが 名残を留めているだろう――
#. de: Die meisten davon sind längst gehoben. Nur in wenigen Schächten hallt noch das kalte Klirren der Spitzhacken.
#. fr: Dans cette région qui débordait autrefois d'animation, seule persistait la marque indélébile des travailleurs<br>qui avaient contribué à son essor.
#. speaker: WARRIOROFDARKNESS
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000910_WARRIOROFDARKNESS:1"
msgid "Or <i>ran</i>, at least. Mayhap they are spent. Or mayhap the ringing of hammers <i>can</i> yet be heard below..."
msgstr ""

#. ja: ……親方の奥さんはさ、<br>「最後の山師」なんて呼ばれた、凄腕の採掘師だったんだ。
#. de: Die Frau von Meister Magnus war eine tüchtige Mi<shy>nen<shy>ar<shy>bei<shy>te<shy>rin. Vielleicht die beste, die wir je hatten. Man nannte sie die Erzkönigin.
#. fr: La femme du chef n'était pas du genre à rester les bras croisés. Les gens l'appelaient même “la reine du coup de pioche”<nbsp>!
#. speaker: THAFFE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000920_THAFFE:1"
msgid "Magnus's wife was a miner, you know. Greatest prospector there ever was."
msgstr ""

#. ja: タロースに新しい心核が必要かもって話になったとき、<br>当然、彼女は自分が掘りに行くって名乗り出た。
#. de: Als bekannt wurde, dass der Talos ein neues Herz brauchte, machte sie sich ohne zu zögern auf die Suche.
#. fr: Quand il a fallu trouver un nouveau noyau pour le talos, elle s'est proposée pour aller l'extraire elle-même.
#. speaker: THAFFE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000930_THAFFE:1"
msgid "When the golem hearts started failing, she was the first to head out in search of more."
msgstr ""

#. ja: けど、なにせ歴史ある鉱山だ。<br>力のある石となると、掘り尽くされてて簡単には見つからない。
#. de: Aber die Mine ist berüchtigt dafür, dass sie ihre Schätze nicht so leicht preisgibt.
#. fr: Mais cet endroit n'est pas né d'hier, et nombreux sont les mineurs qui ont rêvé d'en extraire les pierres chargées d'énergie. Les filons se faisaient rares...
#. speaker: THAFFE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000940_THAFFE:1"
msgid "Problem was, most of the veins ran dry ages ago, and finding fresh ones to tap's only gotten harder."
msgstr ""

#. ja: それで、彼女が坑道の奥深くに潜っていったときのことさ……<br>大規模な崩落が起きたのは。
#. de: In einem Schacht, tief unter der Erde, gab plötzlich die Decke nach und begrub die Erzkönigin unter sich.
#. fr: Un jour qu'elle se trouvait au plus profond des tunnels, un très gros éboulement s'est produit.
#. speaker: THAFFE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000950_THAFFE:1"
msgid "But she wasn't one to be deterred. She just kept digging deeper and deeper. And then the mine collapsed."
msgstr ""

#. ja: みんな、必死になって坑道を塞いだ土砂をどけたよ。<br>でも、彼女のもとに辿り着けたのは、およそ2カ月後だ。
#. de: Wir ruhten weder Tag noch Nacht, um den Schacht freizulegen. Trotzdem dauerte es zwei Monde, bis wir zu ihr vorgedrungen waren.
#. fr: On s'y est tous mis pour extraire la coulée froide qui obstruait la galerie, mais ça nous a pris deux mois pour dégager le passage.
#. speaker: THAFFE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000960_THAFFE:1"
msgid "We labored day and night to clear away the rubble, but it took us two months to find her..."
msgstr ""

#. ja: ……待っていたのは、当然、亡骸だった。
#. de: Da war sie schon lange tot.
#. fr: Évidemment, il ne restait d'elle que son cadavre...
#. speaker: THAFFE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000970_THAFFE:1"
msgid "...To find her body."
msgstr ""

#. ja: それ以来、親方はあんな感じさ。<br>すまないが……わかってやってほしい。
#. de: Meister Magnus hat den Verlust nicht verkraftet. Ihr habt ja selbst gesehen<nbsp>... Bitte habt etwas Verständnis.
#. fr: Le chef ne s'en est toujours pas remis. Faut le comprendre...
#. speaker: THAFFE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000980_THAFFE:1"
msgid "Magnus has never been the same since."
msgstr ""

#. ja: ちなみに、当の本人はどこへ？
#. de: Wo ist er eigentlich?
#. fr: ... Et où est-il passé, d'ailleurs<nbsp>?
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_000990_THANCRED:1"
msgid "Where is he, if you don't mind my asking?"
msgstr ""

#. ja: ああ、ついさっき、ふらっと出て行ったから、多分……。
#. de: Er ist gerade eben gegangen. Aber ich weiß schon, wo ihr ihn finden könnt<nbsp>...
#. fr: Ah, je l'ai vu partir un peu plus tôt...
#. speaker: THAFFE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001000_THAFFE:1"
msgid "Ah, yes, well...if he's not here, there's only one other place he'd be."
msgstr ""

#. ja: 何だぁ？<br>さっきの奴じゃねぇか、しつけぇなぁ……。
#. de: Du schon wieder. Gibst wohl nicht so leicht auf, was?
#. fr: Quoi encore<nbsp>? Qu'est-ce que tu m'veux<nbsp>?
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001010_MAGNUS:1"
msgid "What? Oh... You again."
msgstr ""

#. ja: どんなに頼まれようが、トロッコは動かさねぇ！<br>あんなもん、ブッ壊して樽にでも桶にでもしたほうが、<br>まだマシってもんだ！
#. de: Selbst wenn ich euch helfen wollte, die Bergbahn bewegt sich keinen Ilm mehr. Die taugt nur noch, um sie zu verschrotten und daraus Fässer und Eimer zu machen.
#. fr: Demandez tant que vous le voudrez, le chariot bougera pas<nbsp>! Ce truc sert à rien, on devrait en faire un tonneau ou un seau<nbsp>!
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001020_MAGNUS:1"
msgid "How many times must I tell you─the trolley won't run! We'd be better off dismantling the damn thing and selling the parts for scrap."
msgstr ""

#. ja: わかったら帰れ！<br>二度と俺の前にツラ晒すんじゃねぇ！
#. de: Also, lass mich gefälligst in Ruhe und verschwinde von hier.
#. fr: Pigé<nbsp>? Alors dégage<nbsp>! Et que je revoie jamais ta tête<nbsp>!
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001030_MAGNUS:1"
msgid "Now piss off back to wherever you came from, and don't let me catch you around here again."
msgstr ""

#. ja: ……ふたりの名は？
#. de: Wie waren ihre Namen?
#. fr: Comment ils s'appelaient<nbsp>?
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001040_THANCRED:1"
msgid "...What were their names?"
msgstr ""

#. ja: ……息子はスクリ、妻はアグナだ。
#. de: Meine Frau hieß Agna und mein Sohn Skuri.
#. fr: Mon fils, c'était Skuri. Ma femme, Agna.
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001050_MAGNUS:1"
msgid "My son was named Skuli. My wife, Agna."
msgstr ""

#. ja: ただいまと言う相手がいなくなって、<br>どこにも帰れなくなっちまった……。
#. de: Seit sie weg sind, hab ich keinen Grund mehr, nach Hause zu gehen. Ich ertrag die Einsamkeit nicht.
#. fr: J'ai plus de foyer, plus d'endroit où un être cher attend mon retour...
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001060_MAGNUS:1"
msgid "Being here with them...it beats going home. Home stopped being home when I lost them."
msgstr ""

#. ja: こいつに溺れても溺れても、行きつく底なんてありゃしねぇ。
#. de: Ich sauf und sauf, um meine Trauer zu vergessen, doch ich sink nur immer tiefer in sie rein.
#. fr: Je me noie là-dedans, mais quand je crois toucher le fond, j'me rends compte qu'il y a de quoi tomber toujours plus bas.
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001070_MAGNUS:1"
msgid "I thought to try and drown my sorrows...but somehow...the bottle's never deep enough."
msgstr ""

#. ja: ……まったくだ。<br>いっそ楽にしてくれと願ってるときほど、<br>そいつは役に立たないもんさ。
#. de: Der Trost der Welt liegt nicht in einer Flasche. Das weiß ich nur zu gut.
#. fr: Crois-moi, c'est quand on a le plus besoin de réconfort que cette chose-là nous aide le moins.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001080_THANCRED:1"
msgid "No bottle is. Believe me─I know."
msgstr ""

#. ja: お前も家族を亡くしたのか。
#. de: Hast du auch deine Familie verloren?
#. fr: Toi aussi, t'as plus de famille<nbsp>?
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001090_MAGNUS:1"
msgid "You've lost someone too?"
msgstr ""

#. ja: ……どうだかな。<br>家族なんて上等なものには、なってやれなかったと思う。
#. de: Ach weißt du, das ist eine komplizierte Geschichte.
#. fr: Si on veut... Je me demande si j'ai jamais réussi à en avoir une, en fait.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001100_THANCRED:1"
msgid "Not like you. Not my own flesh and blood."
msgstr ""

#. ja: なにせ、俺は身寄りのない孤児だったからな。<br>家族ってものの……加減がわからない。
#. de: Ich wuchs als Waise auf. Ich weiß gar nicht so richtig, wie es ist, eine Familie zu haben.
#. fr: Je suis orphelin, alors j'ai du mal à comprendre le sens du mot “famille”.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001110_THANCRED:1"
msgid "I grew up an orphan, so I never really knew what family meant."
msgstr ""

#. ja: 俺を拾ってくれた恩師は立派な人で、それを慕ってはいたさ。<br>だが、自分の手で護らなきゃならないようなものは、<br>何ひとつ持たないまま生きてきた。
#. de: Ich hatte mal einen weisen Lehrer, den ich verehrte wie einen Vater. Aber auch er konnte mich nicht lehren, Verantwortung für das Leben eines anderen zu über<shy>nehmen. Ich konnte ja nicht einmal auf mich selber aufpassen.
#. fr: Mon maître, celui qui m'a recueilli, était quelqu'un d'admirable, et à qui je tenais beaucoup. Mais pendant longtemps, je n'ai jamais eu quelqu'un que je voulais vraiment défendre de tout mon être.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001120_THANCRED:1"
msgid "Not until I met a man who offered to take me in and make me his pupil. He was a kindly soul. Always looking out for me, like a father. Not that I appreciated that at the time, or anything else for that matter..."
msgstr ""

#. ja: そんなときだ……。<br>俺の力不足で、まだ幼かったあいつを、<br>天涯孤独の身にさせてしまった。
#. de: Doch das Schicksal ließ mir keine Wahl. Ein junges Mädchen verlor ihren Vater, weil ich ihn nicht beschützen konnte.
#. fr: Jusqu'à ce jour-là, en tout cas, quand ma faiblesse a rendu une petite fille aussi orpheline que moi.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001130_THANCRED:1"
msgid "But I finally had a family. And then...and then I robbed a young girl of hers."
msgstr ""

#. ja: それからずっと、護ってやりたいと思ってきたが……<br>思い返すたび、大したことはしてやれなかったと感じるよ。
#. de: Seitdem versuchte ich, sie von allen Gefahren fernzuhalten, aber wenn ich ehrlich bin, stelle ich mich dabei nicht besonders geschickt an.
#. fr: C'est pour ça que j'ai voulu la prendre sous mon aile, mais plus j'y pense et plus je me dis que je n'ai rien fait de spécial pour elle.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001140_THANCRED:1"
msgid "I did my best to make amends, to offer her comfort. But the more I look back on it, the more I realize just how inadequate my efforts were. I let her down."
msgstr ""

#. ja: だからこそ、彼女の生きた跡を……<br>その意志を拾わなくちゃならないんだ。
#. de: Deshalb will ich wenigstens das Andenken an sie bewahren und ihren Willen in Ehren halten.
#. fr: C'est pour ça que je dois défendre ses convictions. Parce que c'est la preuve qu'elle a existé.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001150_THANCRED:1"
msgid "That is why I refuse to let her legacy die."
msgstr ""

#. ja: それに、今の俺には、護ってやりたいものがもうひとつ……<br>足踏みしていたら、削られていくのはあいつの未来だ。
#. de: Außerdem gibt es jetzt noch etwas, um das ich mich zu kümmern habe. Ihre Zukunft.
#. fr: Aujourd'hui encore, il y a quelqu'un que je veux protéger. Car si je ne fais rien, c'est son avenir qui sera compromis.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001160_THANCRED:1"
msgid "In the end, all we can do is press on. For those we have lost. For those we can yet save."
msgstr ""

#. ja: だから、ナバスアレンに行く。<br>そのために、タロースの修復ができたあかつきには、<br>お前にトロッコを動かしてもらいたい。
#. de: Deshalb muss ich nach Nabaath Areng. Und das geht nur, wenn du die Bergbahn in Bewegung setzt. Bitte, du musst uns helfen.
#. fr: Voilà pourquoi je dois me rendre à Nabaath Areng. Et pour ça, j'ai besoin que tu fasses bouger le chariot quand le talos sera réparé.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001170_THANCRED:1"
msgid "And that requires your Talos. Please, Magnus. You are our only hope of reaching Nabaath Areng."
msgstr ""

#. ja: ……できるもんか。
#. de: Schaff ich das?
#. fr: ... En serez-vous seulement capables<nbsp>?
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001180_MAGNUS:1"
msgid "...What rubbish."
msgstr ""

#. ja: ……どうして、本物のミンフィリアのこと、<br>過去みたいに言うんですか。
#. de: Warum sprichst du von ihr immer so, als gäbe es sie nicht mehr?
#. fr: Pourquoi tu parles de ta Minfilia comme si elle appartenait au passé<nbsp>?
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001190_RYNE:1"
msgid "She's not gone. No matter what you say or believe, she's not."
msgstr ""

#. ja: まだ取り戻せるじゃないですか……！<br>そのために、私はここに……っ！
#. de: Man kann sie doch bestimmt noch zurückholen. Dafür<nbsp>... Dafür bin ich doch hier.
#. fr: Tu peux encore la retrouver<nbsp>! C'est pour ça que j'ai voulu venir ici<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001200_RYNE:1"
msgid "We can still bring her back."
msgstr ""

#. ja: ……お前には、馴染がない話かもしれないが。
#. de: Es wird dich vielleicht überraschen<nbsp>...
#. fr: Je ne sais pas si vous en aviez déjà entendu parler...
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001210_THANCRED:1"
msgid "You may not remember this about our Minfilia..."
msgstr ""

#. ja: あいつは……原初世界のミンフィリアは、<br>もともと採掘師として稼いでいたんだ。
#. de: Aber unsere Minfilia hat früher auf der Ursprungs<shy>welt als Mi<shy>nen<shy>ar<shy>bei<shy>te<shy>rin ihre Gil verdient.
#. fr: La Minfilia de notre monde avait choisi la profession de mineur...
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001220_THANCRED:1"
msgid "But prior to founding the Path of the Twelve, long before the Scions, she was something of a miner."
msgstr ""

#. ja: 彼女が、事故で父を失って以来、<br>フ・ラミンさんに育てられてたのは知ってるだろう？
#. de: Du weißt vermutlich, dass F'lhaminn sie nach dem Tod ihres Vaters aufgenommen hat.
#. fr: Après la disparition de son père, F'lhaminn l'a recueillie et élevée comme sa fille. Ça, vous le saviez sans doute déjà...
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001230_THANCRED:1"
msgid "After her father died, F'lhaminn took her in and taught her the trade."
msgstr ""

#. ja: だが、ラミンさん自身、<br>恋人を失って頼る者がない境遇だったからな……。<br>少しでも力になれればと、採掘をはじめたらしい。
#. de: Doch F'lhaminn hatte selbst ihren Geliebten verloren und war auf sich allein gestellt. Also wollte Minfilia sich nützlich machen und begann, in einer Mine zu arbeiten.
#. fr: Mais F'lhaminn avait perdu celui qu'elle aimait et n'avait personne vers qui se tourner... Minfilia voulait l'aider comme elle pouvait, alors elle a donné ses premiers coups de pioche.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001240_THANCRED:1"
msgid "I think they were both seeking to fill the void left by a loved one. Maybe that's why she took to it so readily."
msgstr ""

#. ja: 懐かしいな……。<br>俺が情報収集もかねてウルダハの酒場で飲んでると、<br>顔に泥をつけたあいつが、外を通るわけだ。
#. de: Hach, ist das lange her<nbsp>... Ich weiß noch, wie ich in einer Kneipe in Ul'dah trank und den neuesten Gerüchten lauschte. Da lief sie draußen vorbei, ihr Gesicht war ganz verdreckt.
#. fr: Je m'en souviens comme si c'était hier. J'allais boire dans les tavernes uldiennes pour me mettre au courant des dernières rumeurs, et je la voyais passer dehors, le visage sale.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001250_THANCRED:1"
msgid "Back in those days, I spent most of my time in the Quicksand or some other tavern, loosening tongues and gathering secrets. Occasionally, I'd catch a glimpse of her in the street, on her way home after another hard day's work."
msgstr ""

#. ja: 俺は、今日も無事に仕事が終わったのかと安心しながら、<br>なんだか妙に、居心地が悪くなる……。
#. de: Sie war mit der Arbeit fertig. Ich hätte ihr nachlaufen können<nbsp>- sie fragen, wie es ihr geht.
#. fr: Ça me soulageait de me dire que sa journée était enfin terminée, même si sa situation me mettait mal à l'aise.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001260_THANCRED:1"
msgid "I always felt a wave of relief when I saw she'd come back safe...along with a pang of guilt at the fact I wasn't there to support her as I should've been."
msgstr ""

#. ja: けど、そこで店を飛び出して追いかける理由もない。<br>だから、後腐れない相手と、酒や軽口をますます弾ませるんだ。
#. de: Doch ich tat es nicht. Ich vergrub lieber wieder mein Gesicht in meinem Kelch und bildete mir ein, ich hätte Wichtigeres zu tun.
#. fr: Enfin, j'étais trop occupé pour aller lui parler. Du coup, je restais là, à trinquer avec mes voisins de tablée pour les faire parler.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001270_THANCRED:1"
msgid "Simply speaking with her more than once in a blue moon would've been a good start, but I could never bring myself to do it. Instead, I threw myself into my “work” and became every drunkard's best friend."
msgstr ""

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous à Thancred<nbsp>?
#. speaker: Q2
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_Q2_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr ""

#. ja: 彼女からは何て？
#. de: Was hielt sie denn davon?
#. fr: Et elle, qu'est-ce qu'elle pensait de cette vie à boire<nbsp>?
#. speaker: A2
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_A2_000_001_NONE_VOICE:1"
msgid "I can't imagine she thought too highly of you back then."
msgstr ""

#. ja: ひどい「お兄さん」だ……
#. de: Und so einer nennt sich großer Bruder<nbsp>...
#. fr: Quel grand frère modèle...
#. speaker: A2
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_A2_000_002_NONE_VOICE:1"
msgid "Not your finest hour, to say the least."
msgstr ""

#. ja: いつだったか、<br>「行く先々で女の人を口説いて回る流れ者」と言われたよ。<br>まったく、ろくなもんじゃない。
#. de: Irgendwann meinte sie zu mir, ich sei ein Taugenichts, der nur den Frauen nachstellt. Womit sie nicht ganz Unrecht hatte.
#. fr: Un jour, elle m'a décoché un “J'ignorais que vagabonder au gré de ses humeurs et conter fleurette aux donzelles étaient des valeurs nobles<nbsp>!” Elle n'a jamais eu la langue dans sa poche...
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001280_THANCRED:1"
msgid "Not too highly, no. She once called me a “wine-sodden wharf rat”─which wouldn't have been half as galling had it not been so accurate."
msgstr ""

#. ja: まったくだ。<br>その点に関しては、彼女自身からも、ほかの賢人たちからも、<br>実に的確で辛らつな評価をいただいたよ。
#. de: Ich weiß, ich weiß. Das habe ich mir schon oft genug von ihr anhören müssen. Und auch von den anderen Exegeten. Zu Recht.
#. fr: Je sais... Les Preux comme elle n'ont jamais manqué de me faire part de leurs critiques, aussi sévères que justifiées.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001290_THANCRED:1"
msgid "Far from it─and F'lhaminn has never let me live it down."
msgstr ""

#. ja: ……だからこそ、今回だけは間違えないようにしたいんだ。
#. de: Aber diesmal<nbsp>... Diesmal werde ich sie nicht enttäuschen.
#. fr: C'est bien pour ça que je n'ai pas envie de me rater ce coup-ci.
#. speaker: THANCRED
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001300_THANCRED:1"
msgid "But that was a lifetime ago. Here and now I have another chance to do things right, and I will <i>not</i> squander it again."
msgstr ""

#. ja: おい、あんたら！<br>見てくれよ、こいつは驚きだぞ……！
#. de: He, kommt mal her! Das müsst ihr euch ansehen!
#. fr: Hé<nbsp>! Venez un peu par là<nbsp>! Faut que vous voyiez ça, ça va vous en boucher un coin<nbsp>!
#. speaker: GUTHJON
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001310_GUTHJON:1"
msgid "Hey! Come and see what I've found! You're not going to believe this!"
msgstr ""

#. ja: 獅子目石があったのか？
#. de: Hast du ein Löwenauge gefunden?
#. fr: Qu'est-ce qu'il y a<nbsp>? Un œil de lion<nbsp>?
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001320_THANCRED:1"
msgid "Tell me it's leonine."
msgstr ""

#. ja: ああ、まあな。<br>あんたら、相当な強運の持ち主だよ。
#. de: Das kann man so sagen. Das Glück meint es wirklich gut mit euch.
#. fr: Si on veut... Et on peut dire que vous, vous avez une sacrée chance de cocu<nbsp>!
#. speaker: GUTHJON
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001330_GUTHJON:1"
msgid "It is, at that! You lot were born lucky."
msgstr ""

#. ja: 見つけた獅子目石は、細かな破片がいくつかと……<br>いいや、とにかくこいつを見てくれ！
#. de: Ich hab ein paar winzige Splitter<nbsp>... und das hier!
#. fr: Ce sont les morceaux d'une gemme...
#. speaker: GUTHJON
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001340_GUTHJON:1"
msgid "It's mostly broken pieces─but look at this!"
msgstr ""

#. ja: これも獅子目石か？
#. de: Das ist also ein Löwenauge. Es ist<nbsp>... prächtig.
#. fr: C'est un œil de lion, ça aussi<nbsp>?
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001350_THANCRED:1"
msgid "This is a rather fine specimen."
msgstr ""

#. ja: そうだ、そんな大きいものは、ここ十数年出ていない。<br>加えて……よく見ろ、文字が刻まれてるだろ。
#. de: Ja, und zwar ein so großes, wie es seit Jahrzehnten nicht mehr gefunden wurde. Und schau mal<nbsp>... Jemand scheint sich darauf verewigt zu haben.
#. fr: Des gros comme ça, j'en ai pas vu depuis des décennies. En plus, y a comme des lettres gravées dessus...
#. speaker: GUTHJON
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001360_GUTHJON:1"
msgid "It's been decades since we've found anything approaching this big! But that's not all─there's an engraving on it."
msgstr ""

#. ja: ……ああ、この傷みたいな線か。<br>確かに、文字に見えなくも……ふむ……。
#. de: Du meinst diese Einkerbungen hier? Ja, da steht etwas<nbsp>...
#. fr: Ces lignes, là, qui ressemblent à des rayures<nbsp>? C'est vrai qu'on pourrait aussi y voir des lettres... Hum...
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001370_THANCRED:1"
msgid "Ah, these scratches here? They're a little hard to make out."
msgstr ""

#. ja: 『マグヌス、スクリ、愛するあなたたちに』……？
#. de: „Für Magnus und Skuri, ich liebe euch“
#. fr: “À Magnus et Skuri, les amours de ma vie”...<nbsp>?
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001380_THANCRED:1"
msgid "\"To my beloved Magnus and Skuli.“"
msgstr ""

#. ja: そうだ、そうだとも！<br>そいつは、マグヌスんところの嫁、<br>アグナからの贈り物なんだ……！
#. de: Ja, so muss es sein! Der Stein ist ein Geschenk von Agna an ihren Mann und ihren Sohn!
#. fr: J'en étais sûr<nbsp>! C'est le cadeau d'Agna, la femme de Magnus<nbsp>!
#. speaker: GUTHJON
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001390_GUTHJON:1"
msgid "Yes! Do you see!? It was a gift to Magnus from his wife!"
msgstr ""

#. ja: まったく、さすが最後の山師だよ……。<br>あいつは、ちゃんと目的の石を掘り出してたんだ……！
#. de: Die Erzkönigin hat es tatsächlich geschafft. Sie hat den Stein gefunden.
#. fr: Un cadeau à la hauteur de la reine du coup de pioche... Elle avait bien trouvé la pierre qu'elle cherchait<nbsp>!
#. speaker: GUTHJON
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001400_GUTHJON:1"
msgid "She found it. She <i>really</i> found it."
msgstr ""

#. ja: だが、崩落のせいで帰ることができなくなった。<br>恐らく、その言葉を刻んで息絶えたんだろう。<br>いつかマグヌスが見つけると信じて……。
#. de: Doch der Einsturz versperrte ihr den Rückweg. Mit ihren letzten Atemzügen hat sie diese Nachricht eingeritzt, im festen Glauben, dass Magnus ihn irgendwann finden würde.
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment, l'éboulement l'a empêchée de rejoindre les siens. Elle a dû graver ce message avant de rendre son dernier souffle, convaincue qu'il parviendrait un jour à Magnus.
#. speaker: GUTHJON
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001410_GUTHJON:1"
msgid "She must've spent her final hours carving this message into the stone, in the hope that he might see it one day."
msgstr ""

#. ja: それを、岩蟲の奴が、先に持ってっちまったんだ。<br>ああ……まったく……なんてこった……！
#. de: Die Steinrücken müssen ihn sich geschnappt haben, bevor wir uns zu ihr durchgraben konnten. 
#. fr: Les sales bêtes qui vivent dans le coin ont trouvé la pierre avant nous et l'ont emportée jusqu'ici. Pfff... quel dommage.
#. speaker: GUTHJON
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001420_GUTHJON:1"
msgid "Those rock-backed bastards must've made off with it before we could clear a path to her."
msgstr ""

#. ja: あんたらが、埋もれてた運命を掘り当てたんだよ。<br>この場所にもまだ、こんな想いが、遺ってたんだな……。
#. de: Ich hätte nicht gedacht, dass die Mine noch so einen Schatz hergeben würde<nbsp>... Was da ans Tageslicht gekommen ist, grenzt an ein Wunder.
#. fr: Vous avez déterré un testament enfoui... Qui aurait pu se douter qu'un tel témoignage sommeillait ici<nbsp>?
#. speaker: GUTHJON
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001430_GUTHJON:1"
msgid "It's fate that brought you here to find this stone. No other explanation. Makes me wonder what else might still be buried in these parts."
msgstr ""

#. ja: ……さて、これで理論上は完了です。<br>起動用の魔力を流せば、このタロースは動くと思われます。
#. de: So, theoretisch ist alles bereit. Sobald der Äther läuft, müsste sich der Talos in Bewegung setzen.
#. fr: Et voilà... On devrait pouvoir relancer le talos en utilisant l'énergie magique prévue à cet effet.
#. speaker: URIANGER
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001440_URIANGER:1"
msgid "Preparations for the enchantment are complete. When the heart hath been suffused with a sufficient quantity of aether, the golem should be restored to life."
msgstr ""

#. ja: わ、わかった。<br>そのままやっちまってくれ……！
#. de: Also worauf wartest du dann noch? Los geht's!
#. fr: Compris<nbsp>!
#. speaker: THAFFE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001450_THAFFE:1"
msgid "All right then. Whenever you're ready."
msgstr ""

#. ja: タロースが、起動した……っ！
#. de: Er bewegt sich!
#. fr: Le talos s'est mis en marche<nbsp>!
#. speaker: THAFFE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001460_THAFFE:1"
msgid "It's working! It's working!"
msgstr ""

#. ja: あ……親方……。
#. de: Oh<nbsp>... Meister Magnus<nbsp>...
#. fr: Euh... Chef...
#. speaker: THAFFE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001470_THAFFE:1"
msgid "M...Magnus."
msgstr ""

#. ja: なんでだよ……たかだか、これっぽっちの石人形だぞ……。
#. de: Da steht er nun, der Scheißkerl.
#. fr: ... Qu'est-ce qui m'arrive<nbsp>? Pourquoi ce tas de cailloux me fait cet effet-là<nbsp>?
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001480_MAGNUS:1"
msgid "You left me for this...this wretched heap of stone and rubble..."
msgstr ""

#. ja: これっぽっちなのに……チクショウ……<br>なんてものを、遺してくんだ……。
#. de: Danke<nbsp>... Ich danke dir<nbsp>... für dieses Geschenk<nbsp>... meine Königin<nbsp>...
#. fr: C'est tout ce que tu me laisses<nbsp>? Et pourtant... Et pourtant<nbsp>!
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001490_MAGNUS:1"
msgid "This worthless pile of earth. And yet...I can't... I can't..."
msgstr ""

#. ja: ……どうしましたか、ミンフィリア。
#. de: Minfilia. Was ist mit dir?
#. fr: Qu'y a-t-il, Minfilia<nbsp>?
#. speaker: URIANGER
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001500_URIANGER:1"
msgid "What troubleth thee, child?"
msgstr ""

#. ja: 私には……遺せるものなんて何もない……。
#. de: Ich<nbsp>... Ich habe nichts, was ich jemandem hinterlassen könnte. Nichts, über das sich je jemand freuen wird.
#. fr: Je me disais juste que... je n'ai rien à laisser derrière moi...
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001510_RYNE:1"
msgid "I shouldn't be here. I don't deserve to be. I don't deserve any of the things you've done for me!"
msgstr ""

#. ja: 私は、何をやろうとしても、みんなほど上手くできない。<br>私が私のまま生き残っても、誰も喜ばない……。
#. de: Ich werde nie so mutig oder so weise werden wie ihr. Ich stehe allen immer nur im Weg herum. Es wäre besser, ich wäre gar nicht hier<nbsp>...
#. fr: J'ai beau essayer, je ne vous arrive pas à la cheville... Et si je décide de vivre, personne ne s'en réjouira.
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001520_RYNE:1"
msgid "I'm just a burden, helpless and hopeless. If tomorrow came and I was gone, it would be better for everyone!"
msgstr ""

#. ja: サンクレッドだって傷つけるって、わかってるんです。<br>だからいっそ……！
#. de: Und Thancred. Wenn er doch endlich sagen würde, was er wirklich denkt<nbsp>...
#. fr: Ça ferait même de la peine à Thancred, en fait... Alors que ça pourrait être plus simple...
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001530_RYNE:1"
msgid "Thancred most of all. He'll never admit it, but I can see it in his eyes..."
msgstr ""

#. ja: いっそ、本物のために消えてくれって……<br>そう言ってくれたら、苦しくないのに……。
#. de: Dass ich verschwinden soll, um der echten Minfilia Platz zu machen!
#. fr: Il suffirait qu'il me demande de laisser place à la vraie Minfilia<nbsp>! Ça serait moins pénible...
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001540_RYNE:1"
msgid "I wish he'd just say it─just say that he hates me! That he wishes I was dead so that she could return..."
msgstr ""

#. ja: ……申し訳ありません。
#. de: Das ist alles meine Schuld.
#. fr: Si tu savais combien je suis désolé...
#. speaker: URIANGER
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001550_URIANGER:1"
msgid "None of this is thy doing, child."
msgstr ""

#. ja: 私は、「光の巫女」を第一世界に送った張本人……。<br>あなたにも、サンクレッドにも、謝ることしかできません。
#. de: Ich war es, der das Orakel des Lichts in die erste Splitter<shy>welt geschickt hat. Ich hatte keine Ahnung, was ich Thancred und dir damit antun würde.
#. fr: C'est moi qui ai envoyé la prêtresse de la Lumière dans ton monde... Je vous dois des excuses, à toi et à Thancred.
#. speaker: URIANGER
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001560_URIANGER:1"
msgid "'Twas <i>I</i> who set the Oracle on her path unto the First. <i>I</i> who condemned you all to suffer these torments. 'Tis my sin alone, and one that will haunt me unto my dying day."
msgstr ""

#. ja: 世界というものは、とても複雑です。<br>誰かに生きてほしいという、ごく単純な願いでさえ、<br>別の誰かを犠牲にしなければ叶わないことがある……。
#. de: Doch ich bereue es nicht. Das Leben verläuft in komplizierten Bahnen, die Geschicke sind fest miteinander verwoben. Wir, die die Welt zu bessern wünschen, können es nicht tun, ohne an anderer Stelle etwas zu opfern.
#. fr: Le monde est si complexe... La réalisation d'un souhait aussi humble que la survie d'une personne peut parfois demander le sacrifice d'une autre.
#. speaker: URIANGER
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001570_URIANGER:1"
msgid "Yet I dare not dwell overlong on my many regrets, for the world is a tapestry of fates, interwoven and inseparable, and we who strive to better it cannot choose but make difficult decisions. For naught of worth was ever achieved without sacrifice."
msgstr ""

#. ja: だからこそ皆、生きるに足る理由を……<br>死すべき理由を、見出そうとするのではないかと思います。
#. de: Deswegen müssen wir uns mit unseren Herzen vergewissern, wofür wir leben und wofür wir sterben sollen.
#. fr: C'est peut-être pour ça que certains finissent par se demander si la vie vaut la peine d'être vécue, et d'autres... si la mort ne serait pas une meilleure solution...
#. speaker: URIANGER
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001580_URIANGER:1"
msgid "And thus must man ever struggle to weigh life against loss."
msgstr ""

#. ja: ……しかし。<br>本来その願いには、そのような難しい理屈はいらないのです。
#. de: Aber vielleicht ist die Antwort darauf gar nicht so schwer.
#. fr: Heu<shy>reu<shy>se<shy>ment, tout n'est pas toujours aussi compliqué.
#. speaker: URIANGER
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001590_URIANGER:1"
msgid "The one for whom thou mournest beareth no grudge."
msgstr ""

#. ja: ただ、大切なあなたに、<br>未来へと歩んでほしい……歩んでほしかった……<br>それだけのものなのです。
#. de: Wir wünschen uns eine Zukunft mit denen, die wir lieben<nbsp>... die wir liebten.
#. fr: Je veux simplement que tu avances vers ton avenir, comme j'aurais aimé qu'elle puisse le faire. Il n'y a rien que je souhaite davantage.
#. speaker: URIANGER
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001600_URIANGER:1"
msgid "Were she here, she would not suffer thee to languish in sorrow. She would tell thee to seek thine own path, thine own purpose."
msgstr ""

#. ja: ……私は人の群れの中で生きるのが苦手でしたので、<br>これを思い知るまでに、時間がかかりすぎましたが。
#. de: Ich war stets ein Einzelgänger. Deshalb musste erst viel Zeit verstreichen, bis ich das verstand.
#. fr: Je n'ai jamais été très doué pour vivre en société. J'ai mis du temps à réaliser ce que je voulais vraiment.
#. speaker: URIANGER
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001610_URIANGER:1"
msgid "It is a truth which I myself was slow to learn. Yet a truth it remaineth."
msgstr ""

#. ja: あなたは、ただ信じてもいいのではないかと……<br>私は思いますよ。
#. de: Hab Vertrauen, Minfilia.
#. fr: Aie confiance... Je suis sûr que tout ira bien.
#. speaker: URIANGER
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001620_URIANGER:1"
msgid "Thou needst but have faith. Have faith and all will be well."
msgstr ""

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q3
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_Q3_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr ""

#. ja: 行ってあげたらどうだ
#. de: Willst du nicht zu ihr gehen?
#. fr: Vous devriez les rejoindre...
#. speaker: A3
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_A3_000_001_NONE_VOICE:1"
msgid "Go to her."
msgstr ""

#. ja: 言葉で伝えるべきこともある
#. de: Du solltest mit ihr reden.
#. fr: Il y a des choses qu'il ne faut pas taire...
#. speaker: A3
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_A3_000_002_NONE_VOICE:1"
msgid "Have you no words for her?"
msgstr ""

#. ja: …………そうかもな。
#. de: Ja, vielleicht hast du Recht.
#. fr: Oui, peut-être...
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001630_THANCRED:1"
msgid "Not today."
msgstr ""

#. ja: 一方 クリスタリウム 星見の間――
#. de: Währenddessen in Crystarium ...
#. fr: Pendant ce temps, à L'Observatoire
#. speaker: SYSTEM_NONE_VOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001635_SYSTEM_NONE_VOICE:1"
msgid "Meanwhile, in the Crystarium..."
msgstr ""

#. ja: 今回は、彼らについていかなかったのか。
#. de: Diesmal bist du ihnen nicht gefolgt?
#. fr: Tu ne les as pas collés de près, ce coup-ci<nbsp>?
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001640_MYSTERYVOICE:1"
msgid "To what do I owe the pleasure that is your extended stay?"
msgstr ""

#. ja: ……ん、まあな。<br>大森林で、おおまかな具合は把握した。<br>あとは見るべきときに見ればいい。
#. de: Im Wald habe ich erfahren, was ich wissen wollte. Von nun an sollten gelegentliche Besuche ausreichen.
#. fr: Pas cette fois, non. J'ai plus ou moins saisi la situation quand j'étais à Rak'tika. J'irai les voir de temps en temps pour savoir si les choses ont évolué.
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001650_EMETSELCH:1"
msgid "Oh, to the tediousness of our heroes' present endeavors."
msgstr ""

#. ja: それに、アム・アレーンはとにかく光が強いからな。<br>あんな場所に同行するのはごめんだ……。
#. de: Außerdem ist das Licht in Amh Araeng besonders stark. Darauf kann ich liebend gerne verzichten.
#. fr: De toute façon, la Lumière est trop forte en Amh Araeng. Les accompagner là-bas<nbsp>? Très peu pour moi.
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001660_EMETSELCH:1"
msgid "That, and the insufferable abundance of Light in Amh Araeng. I should be glad to keep my distance."
msgstr ""

#. ja: だから寝ていた。<br>眠りはいいぞ、実に快適な時間のやり過ごし方だ……。
#. de: Deshalb habe ich mir etwas Ruhe gegönnt. Schlaf ist doch etwas Wundervolles.
#. fr: Du coup, j'en ai profité pour faire une sieste. C'est tellement agréable de se reposer... Je ne connais pas de meilleure façon de passer le temps<nbsp>!
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001670_EMETSELCH:1"
msgid "I'm rather fond of sleep, you know. Wonderful way to pass the time."
msgstr ""

#. ja: ラハブレアの爺さんなんかは、<br>ころころ体を変えて働き続けてたが、<br>あれじゃ擦り切れるってものだ。
#. de: Der alte Lahabrea tauschte rastlos einen Körper gegen den anderen, ständig war er unterwegs. Ein Wunder, dass er nicht vor Müdigkeit aus dem Leben geschieden ist. Alles hat darunter gelitten<nbsp>...
#. fr: Ce vieux Lahabrea changeait d'enveloppe en permanence et courait à droite à gauche... Comme ça devait être usant<nbsp>!
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001680_EMETSELCH:1"
msgid "Not that my compeers would agree, mind you. Always on the move, the lot of them. Like Lahabrea, constantly jumping from vessel to vessel."
msgstr ""

#. ja: 気力も……記憶も……願望さえな……。
#. de: Seine Willenskraft, seine Erinnerung<nbsp>... und seine Ziel<shy>stre<shy>big<shy>keit.
#. fr: Autant au niveau du moral que des souvenirs, sans parler des espoirs...
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001690_EMETSELCH:1"
msgid "Such fire, such determination! So much passion, fleeting and forgotten..."
msgstr ""

#. ja: お前こそ、いったいいつ眠ってるんだ？<br>どこかで存分に寝溜めでもしたかね。
#. de: Wann schläfst du denn eigentlich? Oder kann es sein, dass du ausreichend vorgeschlafen hast?
#. fr: D'ailleurs, tu ne te reposes jamais, toi<nbsp>? Ou t'es-tu déjà trop reposé<nbsp>?
#. speaker: EMETSELCH
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001700_EMETSELCH:1"
msgid "Come to think of it, Exarch, I don't believe I've ever seen <i>you</i> retire to your chambers for so much as forty winks. However do you keep your eyes from closing?"
msgstr ""

#. ja: やっぱり嫌われているらしい……。
#. de: Was hab ich dir bloß getan?
#. fr: Je crois qu'ils me détestent...
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001710_EMETSELCH:1"
msgid "The cold shoulder. You wound me, sir."
msgstr ""

#. ja: それほどアシエンを警戒しておきながら、<br>私が連中に接触したとき、なぜ警告のひとつも挟まなかった？
#. de: Wenn du mir so sehr misstraust, warum hast du den Besuch aus dem Ursprung dann nicht vor mir gewarnt?
#. fr: S'ils se méfient à ce point des Asciens, pourquoi ne m'ont-ils jamais sommé de m'en aller quand je les ai approchés<nbsp>?
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001720_EMETSELCH:1"
msgid "Always so guarded in our every interaction─interactions you curiously refrain from sharing with the Scions and their champion..."
msgstr ""

#. ja: ……彼という英雄は、兵器ではないからだ。<br>相手の事情を知ろうともせず戦うことを、良しとはしまい。
#. de: Weil er sehr wohl in der Lage ist, selbst zu entscheiden, wem er vertrauen kann.
#. fr: C'est parce que leur héros n'est pas belliqueux. Ce n'est pas son genre de chercher l'af<shy>fron<shy>te<shy>ment à tout prix sans savoir à qui il a affaire.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001730_MYSTERYVOICE:1"
msgid "And risk souring your budding relationship? I think not. Much as I dislike you, there are more useful targets for his energies. And I am not in the habit of pointing him at my enemies like a weapon."
msgstr ""

#. ja: ……彼女という英雄は、兵器ではないからだ。<br>相手の事情を知ろうともせず戦うことを、良しとはしまい。
#. de: Weil sie sehr wohl in der Lage ist, selbst zu entscheiden, wem sie vertrauen kann.
#. fr: C'est parce que leur héro<if $gn4>ïne<else>s</if> n'est pas belliqueu<if $gn4>se<else>x</if>. Ce n'est pas son genre de chercher l'af<shy>fron<shy>te<shy>ment à tout prix sans savoir à qui <if $gn4>elle<else>il</if> a affaire.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001740_MYSTERYVOICE:1"
msgid "And risk souring your budding relationship? I think not. Much as I dislike you, there are more useful targets for her energies. And I am not in the habit of pointing her at my enemies like a weapon."
msgstr ""

#. ja: ほう……よくご存じで。<br>まるで旧知のような言い方じゃないか。
#. de: So gut kennst du <if $gn4>sie<else>ihn</if>? Es klingt ja fast so, als wärt ihr alte Bekannte.
#. fr: Oooh, tu as étudié le dossier<nbsp>! Tu parles comme si vous étiez des amis d'enfance.
#. speaker: EMETSELCH
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001750_EMETSELCH:1"
msgid "Is that right? Fond of <if $gn4>her<else>him</if>, are you?"
msgstr ""

#. ja: 不思議なものだな、水晶公。
#. de: Du bist umgeben von Rätseln, Kristall<shy>exarch.
#. fr: Tu m'intrigues, cher Exarque...
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001760_EMETSELCH:1"
msgid "You continue to fascinate me, Exarch."
msgstr ""

#. ja: ……お前はいったい、何なんだ？
#. de: Wer bist du wirklich?
#. fr: Qui es-tu réellement...<nbsp>?
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001761_EMETSELCH:1"
msgid "But tell me: who are you?"
msgstr ""

#. ja: 私は原初世界において、この塔を造った国……<br>アラグ帝国の建国と繁栄にも、一役買った。
#. de: Weißt du<nbsp>... Ich war an der Gründung und dem Aufstieg des Allagischen Reiches<nbsp>- wo dieser Turm erbaut wurde<nbsp>- nicht ganz unbeteiligt.
#. fr: J'étais dans le monde primitif aux côtés du peuple qui a bâti cette tour... J'ai joué un rôle dans la fondation et le développement de l'empire allagois.
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001770_EMETSELCH:1"
msgid "The once-great nation whose ingenuity gave birth to this tower was shaped by my hand. As such, I know full well the wonders it can facilitate...and those it cannot."
msgstr ""

#. ja: だからこそわかる。<br>お前が使った英雄の召喚術は、塔に備わっていた機能ではない。
#. de: Deswegen weiß ich auch, dass die Technik, mit der du <if $gn4>die Heldin<else>den Helden</if> in diese Welt gerufen hast, nicht aus diesem Turm stammt.
#. fr: C'est pour ça que je le sais. L'édifice ne renferme pas la technique d'invocation que tu as utilisée pour faire venir <if $gn4>cette héroïne<else>ce héros</if>.
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001780_EMETSELCH:1"
msgid "There is nothing in these walls which could have aided you in summoning our dear friend across time and space."
msgstr ""

#. ja: それどころか、肉体を捨てさせずに人を別世界に招くなど、<br>アシエンですら成しえていない技だぞ？
#. de: Jemanden mitsamt seinem Körper in eine andere Welt zu zwingen<nbsp>... Das können nicht einmal die Ascians.
#. fr: D'ailleurs, même les Asciens ne sont pas parvenus à maîtriser ce procédé, qui consiste à attirer un être dans un autre monde sans lui faire abandonner son enveloppe charnelle.
#. speaker: EMETSELCH
#. macro: <if $gn4>her<else>his</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001790_EMETSELCH:1"
msgid "Much less in possession of <if $gn4>her<else>his</if> mortal flesh! Not even <i>I</i> could have performed such a feat."
msgstr ""

#. ja: ……そうか。<br>お前は、アラグにも……。
#. de: Im Allagischen Reich hattest du also auch deine Hand im Spiel<nbsp>...
#. fr: Tu étais déjà là du temps d'Allag...
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001800_MYSTERYVOICE:1"
msgid "I see... You had a hand in Allag as well."
msgstr ""

#. ja: ならば、こう答えよう。
#. de: Dann will ich dir folgende Antwort geben.
#. fr: Dans ce cas, je sais quoi te répondre.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001810_MYSTERYVOICE:1"
msgid "You would know what I am?"
msgstr ""

#. ja: 私は、お前たちが翻弄してきたもの……<br>人の歴史、人の執念によって導かれた代行者だ。
#. de: Ich bin ein Opfer eurer Ränkeschmiede, ein Stellvertreter all jener, die im Lauf der Geschichte unter euch gelitten haben.
#. fr: Je ne suis qu'un assesseur guidé à la fois par l'Histoire et la ténacité des êtres humains... tout ce dont toi et les tiens vous êtes toujours joués.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001820_MYSTERYVOICE:1"
msgid "I am the adjudicator of the sacred history with which you dared trifle."
msgstr ""

#. ja: クリスタルタワー……時の翼……<br>彼方より来たりし者による、次元を超えた事象観測。
#. de: Ich bin der Hüter des Kris<shy>tall<shy>turms und seines größten Rätsels. Das Wissen über das Heute, Gestern und Morgen, das Nirgendwo und das Überall. Das Wunderwerk derer, die den Flügel der Zeit freisetzten und hinter den Horizont des Risses blickten.
#. fr: La Tour de Cristal... Les ailes du temps... Ces outils créés par de lointains voyageurs ont permis d'observer le temps et l'espace.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001830_MYSTERYVOICE:1"
msgid "I am keeper of this tower's boundless wisdom. The wisdom of ages without age. Of everywhere and nowhere. The great work of those who tamed the wings of time, and grasped the nature of the rift."
msgstr ""

#. ja: そして、それらを目にした天才たちが、<br>生涯をかけて遺した閃き……。
#. de: Die, in Genialität vereint, ihr Leben dafür einsetzten, dieses Wissen zu hinterlassen<nbsp>...
#. fr: Les génies qui l'ont remarqué ont consacré leur vie à la transmission de leur éclat...
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001840_MYSTERYVOICE:1"
msgid "'Tis a boon born of the sacrifice of brave heroes who gave their lives for a brighter future."
msgstr ""

#. ja: そして、それらを目にすることになる天才たちが、<br>生涯をかけて遺した閃き……。
#. de: Die, in Genialität vereint, ihr Leben dafür einsetzen werden, dieses Wissen zu hinterlassen<nbsp>...
#. fr: Les génies qui le remarqueront risqueront leur vie pour nous léguer leur éclat...
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001850_MYSTERYVOICE:1"
msgid "'Tis a boon born of sacrifices yet unmade... The parting gift of brave heroes who will one day give their lives for a brighter future."
msgstr ""

#. ja: 私は、すべての想いと奇跡を託されてここに立つ。<br>運命に反逆せんとするために。
#. de: Ich stehe hier, weil mir alle Wünsche und Wunder anvertraut sind. Um gegen das Schicksal selbst aufzubegehren.
#. fr: Et moi, je me dresse là, porteur de tous les espoirs et de tous les miracles, me rebellant contre la fatalité.
#. speaker: MYSTERYVOICE
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001860_MYSTERYVOICE:1"
msgid "I will not see their hopes and dreams squandered. The history which led us here <i>will</i> be unwritten. I promise you that."
msgstr ""

#. ja: ……早く役目を遂げたいものだな、お互いに。
#. de: Es steht viel auf dem Spiel, für uns beide.
#. fr: ... Et tu voudrais en finir au plus vite, tout comme moi.
#. speaker: EMETSELCH
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001870_EMETSELCH:1"
msgid "Well, it seems we are both eager to fulfill our duties, then."
msgstr ""

#. ja: ああ、まったくだ。
#. de: Das tut es.
#. fr: Tout à fait.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001880_MYSTERYVOICE:1"
msgid "On that much we are in agreement."
msgstr ""

#. ja: ウリエンジェ……？
#. de: Urianger? Kommst du nicht mit?
#. fr: Urianger...<nbsp>?
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001890_RYNE:1"
msgid "Urianger?"
msgstr ""

#. ja: ここから先は、みなさんだけでお行きください。
#. de: Ich muss euch bitten, ohne mich weiterzureisen.
#. fr: Je reste ici. Poursuivez sans moi.
#. speaker: URIANGER
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001900_URIANGER:1"
msgid "Thou must needs carry on without me."
msgstr ""

#. ja: ナバスアレンへの道は開けた……。<br>ならば誰かが、陽動を続けているアリゼー様たちにも、<br>状況をお伝えせねばなりません。
#. de: Der Weg nach Nabaath Areng ist frei. Irgendjemand muss Alisaie und den anderen Bescheid sagen. Sie sind immer noch mit ihrem Ablenkungsmanöver beschäftigt.
#. fr: La route de Nabaath Areng est désormais praticable. Il va falloir que quelqu'un aille prévenir Alisaie et les autres. Ils sont toujours en train de faire diversion.
#. speaker: URIANGER
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001910_URIANGER:1"
msgid "The path to Nabaath Areng lieth open. Whilst thou travelest thither to the south, I would apprise Mistress Alisaie and the others of our progress."
msgstr ""

#. ja: 事と次第によっては、<br>続けて大罪喰いの討伐に向かう可能性もありましょう。<br>合流の手はずを整える必要があります。
#. de: Wenn alles wie geplant verläuft, stehen wir bald vor einem weiteren Kampf mit einem Licht<shy>bringer. Ich werde dafür sorgen, dass wir bis dahin wieder alle vereint sind.
#. fr: Nous pourrons peut-être poursuivre l'extermination des grands purgateurs, selon la tournure que prendront les événements. Nous devons être prêts à nous rassembler.
#. speaker: URIANGER
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001920_URIANGER:1"
msgid "As circumstances permit, I will thereafter rejoin the hunt for the remaining Lightwardens."
msgstr ""

#. ja: なあ、途中にあるゲートってのは、<br>トロッコが通るときにだけ開くのか？
#. de: Was ist mit dem Tor? Öffnet es sich nur, wenn die Bergbahn durchfährt?
#. fr: Dis, la porte sur le chemin ne s'ouvre que pour laisser passer le chariot, pas vrai<nbsp>?
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001930_THANCRED:1"
msgid "Magnus. Will the gate close immediately after the trolley passes through?"
msgstr ""

#. ja: いいや、事故防止のために、<br>一度開いたら、しばらくは開きっぱなしだ。
#. de: Nein, es bleibt auch danach noch eine Weile offen, aus Sicherheitsgründen.
#. fr: Non, elle reste ouverte un certain temps après son passage pour éviter les accidents.
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001940_MAGNUS:1"
msgid "No, it will stay open until someone closes it manually. Built that way to prevent any untimely accidents."
msgstr ""

#. ja: だったら、ユールモア軍をまいたあと、<br>みんなもナバスアレンを目指してくれ。<br>そっちで合流しよう。
#. de: Dann folgt uns, sobald ihr die Soldaten aus Eulmore vertrieben habt. Wir treffen uns in Nabaath Areng.
#. fr: Dans ce cas, on n'aura qu'à se retrouver à Nabaath Areng quand vous aurez semé l'armée eulmorienne.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001950_THANCRED:1"
msgid "Then you and the others can meet us in Nabaath Areng after giving the Eulmorans the slip."
msgstr ""

#. ja: ウリエンジェ……あの……！
#. de: Urianger<nbsp>... Ich<nbsp>...
#. fr: Urianger...<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001960_RYNE:1"
msgid "Ah, Urianger..."
msgstr ""

#. ja: ここまで……今まで、本当にありがとうございました。<br>どうか、気をつけて……。
#. de: Danke für alles. Danke für alles, was du für mich getan hast. Pass gut auf dich auf.
#. fr: Merci... Merci pour tout<nbsp>! Prenez soin de vous...
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001970_RYNE:1"
msgid "Thank you. For everything."
msgstr ""

#. ja: そちらこそ、お気をつけて。<br>……どうか、それぞれに悔いのないように。
#. de: Du auch. Du wirst sehen, wir werden auf das alles mit einem Lächeln zurückblicken.
#. fr: Toi aussi. J'espère que nous n'aurons pas à regretter nos choix.
#. speaker: URIANGER
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001980_URIANGER:1"
msgid "Remember: thou needst but have faith."
msgstr ""

#. ja: 別れも済んだなら、動かすぞ。<br>そこそこ揺れるだろうから、注意しな。
#. de: Seid ihr bereit? Dann setz ich die Bahn jetzt in Bewegung. Haltet euch gut fest, es wird etwas ruckeln.
#. fr: Si vous en avez fini avec les au revoir, je mets tout ça en marche. Attention, ça va secouer un peu.
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_001990_MAGNUS:1"
msgid "If you've finished with your good-byes, I suggest you grab hold of something. Be a shame if you took a tumble."
msgstr ""

#. ja: 行先は、廃都ナバスアレン、アム・マリク新宮殿前だ。<br>ゲートの向こう側は、線路の整備ができてねぇからな……<br>いざとなったら、途中から足をつかってくれ。
#. de: Die Bahn sollte euch bis vor den Palast von Amh Malik bringen. Allerdings ist es schon 'ne Zeit her, dass die Schienen gewartet wurden. Falls was schiefgeht, müsst ihr zu Fuß weiterlaufen.
#. fr: Prochain arrêt, Nabaath Areng et le palais d'Amh Malik<nbsp>! La route n'a jamais été aménagée de l'autre côté de la porte... Hésitez pas à utiliser vos pieds pour freiner ou stabiliser l'engin.
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002000_MAGNUS:1"
msgid "The tracks beyond the gate aren't in the best of shape, so the trolley can only go as far as Amh Malik."
msgstr ""

#. ja: それじゃ……良い旅を！
#. de: Also dann<nbsp>... Gute Fahrt!
#. fr: Allez, bon voyage<nbsp>!
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002010_MAGNUS:1"
msgid "Godsspeed!"
msgstr ""

#. ja: 見えたぞ、あれがゲートだな。
#. de: Da kommt das Tor.
#. fr: La voilà, la porte<nbsp>!
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002020_THANCRED:1"
msgid "Ah, that must be the gate."
msgstr ""

#. ja: よし、仕掛けも問題なさそうだ。
#. de: Na, wer sagt's denn<nbsp>...
#. fr: Le mécanisme a l'air de fonctionner cor<shy>rec<shy>te<shy>ment...
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002030_THANCRED:1"
msgid "Well, so far so good..."
msgstr ""

#. ja: なっ……あれは、ランジート！？
#. de: Das ist doch<nbsp>... Ran'jit!
#. fr: ... Ran'jit<nbsp>!? Qu'est-ce qu'il fait là<nbsp>!?
#. speaker: THANCRED
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002040_THANCRED:1"
msgid "Wait...is that─ <i>Ran'jit</i>!"
msgstr ""

#. ja: フンッ
#. de: Hua! 
#. fr: フンッ
#. speaker: RANJIT
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002050_RANJIT:1"
msgid "(ATTACK GRUNT)"
msgstr ""

#. ja: くっ
#. de: Ungh<nbsp>...!
#. fr: くっ
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002060_THANCRED:1"
msgid "(IMPACT GRUNT)"
msgstr ""

#. ja: きゃあ！
#. de: Aaah<nbsp>...!
#. fr: きゃあ！
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002070_RYNE:1"
msgid "(IMPACT GRUNT)"
msgstr ""

#. ja: っ……しぶとい奴だな……。<br>願わくば、あのままくたばってほしかったが。
#. de: Ich hab doch tatsächlich gedacht, dich wären wir los.
#. fr: Dans le genre tenace... La dernière fois t'a pas suffi<nbsp>?
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002080_THANCRED:1"
msgid "You're a stubborn old swine, aren't you..."
msgstr ""

#. ja: 我には、奈落すら生ぬるい。<br>あの程度、グクマッツを以てすれば、何とでもなるわ。
#. de: Pah. Mein Leben wird nicht auf dem Boden eines Abgrunds enden. Nicht solange ich auf Gukumatz zählen kann.
#. fr: L'enfer est doux pour quelqu'un comme moi. Ce n'est rien dont Gukumatz ne puisse me sortir.
#. speaker: RANJIT
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002090_RANJIT:1"
msgid "One who has mastered Gukumatz fears not the blackest pit or the fieriest hell."
msgstr ""

#. ja: むしろ、驚きを禁じ得ないのは我の方よ。<br>東の騒ぎを陽動と見て、単身こちらに回ったが……<br>よもや、貴様らが掛かろうとは。
#. de: Mir war natürlich sofort klar, dass eure Aktion im Osten nur ein Ablenkungsmanöver ist. Also habe ich mich wieder an eure Fersen geheftet<nbsp>- aber ich hätte nicht gedacht, dass ich euch so leicht zu packen bekomme.
#. fr: À vrai dire, c'est moi le plus surpris. Je suis venu ici quand j'ai compris que le remue-ménage à l'est était sans doute une diversion, mais je ne pensais pas tomber nez à nez avec vous.
#. speaker: RANJIT
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002100_RANJIT:1"
msgid "Your deeds in the east did not go unnoticed. Long have I lain in wait, and sure enough, you did not disappoint."
msgstr ""

#. ja: ……無様よな、反逆者ども。<br>我が主に従っていたなら、かように地を這うこともなかった。
#. de: Seht ihr ein, wie sinnlos euer Widerstand ist? Wollt ihr wirklich lieber im Dreck herumkriechen, als die Ordnung meines Herrn anzuerkennen?
#. fr: Sales rebelles... Si vous aviez obéi à mon maître, vous ne seriez pas en train de ramper de la sorte<nbsp>!
#. speaker: RANJIT
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002110_RANJIT:1"
msgid "Had you only sworn fealty to Lord Vauthry, you would have no cause to skulk about like frightened animals."
msgstr ""

#. ja: く……っつう……。
#. de: Urgh ...
#. fr: く……っつう……。
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002120_RYNE:1"
msgid "(STRUGGLING TO RISE GRUNT)"
msgstr ""

#. ja: おお……ミンフィリア……哀れな娘よ……。<br>お前はそのまま待て、すぐに鼠どもを始末してくれよう。
#. de: Ah, Minfilia. Du bist zu bemitleiden. Warte, ich befreie dich von diesem Ungeziefer.
#. fr: Oooh... Minfilia, ma pauvre petite... Sois patiente, le temps que j'élimine cette bande de rats<nbsp>!
#. speaker: RANJIT
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002130_RANJIT:1"
msgid "You will remain as you are, while I dispatch these villains."
msgstr ""

#. ja: だめ……だめです、そんなこと……！
#. de: Nein! Lass sie in Ruhe!
#. fr: Pas question<nbsp>! Laissez-les<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002140_RYNE:1"
msgid "No! I won't...! I won't let you!"
msgstr ""

#. ja: 何故だ。<br>かつて我は、拾うたびにお前を育て、ともに戦場に立ち、<br>何百何千もの罪喰いを屠った……。
#. de: Was soll das? Ich habe dich jedes Mal aufgespürt und großgezogen. Wir haben gegen mehr Sünden<shy>ver<shy>tilger gekämpft, als ich zählen kann.
#. fr: Pourquoi donc<nbsp>? Il y a longtemps que je t'ai recueillie et élevée. Ensemble, nous avons combattu et massacré des purgateurs par centaines... par milliers même<nbsp>!
#. speaker: RANJIT
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002150_RANJIT:1"
msgid "You forget to whom you speak! Who armed you? Trained you? Fought and killed a thousand sin eaters with you!?"
msgstr ""

#. ja: されど世は変わらず、お前は幾度も、幾度も死に続けた！
#. de: Doch was hat es gebracht? Immer und immer wieder lief es nur auf eins hinaus: deinen Tod!
#. fr: Mais ça n'a rien changé... Tu es morte, encore et encore<nbsp>!
#. speaker: RANJIT
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002160_RANJIT:1"
msgid "And when you were inevitably cut down and lay lifeless in my arms─who sought out your successor to carry on the futile struggle again and again!?"
msgstr ""

#. ja: この薄汚い鼠どもはッ！<br>哀れなお前に、なおも戦うことを迫り、<br>混迷の世に招き入れようとしている！
#. de: Und jetzt verleiten dich diese Ratten dazu, an ihrem schwachsinnigen Kampf teilzunehmen und die Ordnung der Welt niederzureißen!
#. fr: Ces vermines<nbsp>! Ils te forcent à poursuivre leur combat et cherchent à t'entraîner dans leur monde chaotique<nbsp>!
#. speaker: RANJIT
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002170_RANJIT:1"
msgid "We seek to bring peace to what is left of this shattered land, while these mad fools would only bring further chaos down upon us!"
msgstr ""

#. ja: 惑わされてはならぬ……ならぬぞ……！<br>お前を苦しみから永久に解き放てるのは、<br>我が主、ヴァウスリーのみッ！
#. de: Lass dich nicht von ihnen verführen! Nur einer kann dich für immer von deinem Leid erlösen. Mein Herr, Lord Vauthry!
#. fr: Je ne les laisserai pas troubler ton jugement<nbsp>! Le seul à pouvoir te tirer d'une éternité de douleur est mon maître<nbsp>! Don Vauthry<nbsp>!
#. speaker: RANJIT
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002180_RANJIT:1"
msgid "Do not be deceived, child! Only by Lord Vauthry's hand will this dying world know a sliver of salvation!"
msgstr ""

#. ja: ……いいえ、私はそんな風に救ってもらいたいわけじゃない。
#. de: Nein. Das ist nicht die Erlösung, die ich suche.
#. fr: Non, je n'ai pas besoin de son aide<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002190_RYNE:1"
msgid "I don't know about the world...but I never asked to be saved."
msgstr ""

#. ja: 今だって、痛くて、つらくて、とても苦しい……。<br>それでもこれは、ここまで旅してこられた証です……！
#. de: Meine Schmerzen, meine Zweifel und mein Leid sind ein Beweis dafür, was sie und ich auf dieser Reise bisher erreicht haben.
#. fr: Bien sûr que j'ai mal et que c'est dur, mais c'est la preuve que j'ai vécu et que j'ai parcouru tout ce chemin<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002200_RYNE:1"
msgid "However much it hurts, and however hard it gets, it's my life, and I want to live it on my own terms!"
msgstr ""

#. ja: みなさんからかけてもらった言葉を、覚えています。<br>一緒に見た風景を、覚えています……。
#. de: Jedes Wort, das sie zu mir gesagt haben, hüte ich wie einen Schatz. Jeden Moment, den wir zusammen verbracht haben, trage ich in meinem Herzen.
#. fr: Je me rappelle les encouragements que j'ai reçus, les paysages que j'ai admirés avec les autres...
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002210_RYNE:1"
msgid "And those “mad fools” you want me to abandon? The ones I've traveled with, fought with, and may one day die with─they feel the same."
msgstr ""

#. ja: その思い出があるからこそ、苦しいのだとしても……<br>なかったことになんて、絶対にできません……！
#. de: Diese Erinnerungen nehmen mir jede Last von den Schultern. Sie sind mir wichtiger als alles andere in der Welt!
#. fr: C'est grâce à ces souvenirs que je surmonte la peine et la douleur<nbsp>! Je ne m'en séparerai pour rien au monde<nbsp>!
#. speaker: RYNE
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002220_RYNE:1"
msgid "So no, I will <i>not</i> be deceived! No matter what you say, I refuse to believe it's all for nothing!"
msgstr ""

#. ja: 伝えたいんです。<br>大好きだと……ありがとうと……。<br>私のこの、命ぜんぶで。
#. de: Ich liebe sie. Ohne sie wäre ich<nbsp>... wäre ich nichts.
#. fr: Je veux qu'ils comprennent combien je les aime et à quel point je leur suis re<shy>con<shy>nais<shy>sante... quitte à y laisser la vie...
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002230_RYNE:1"
msgid "They're everything to me. All I have and all I need. And I would gladly do anything for them."
msgstr ""

#. ja: だから、あなたの手は取りません。<br>そこを……通してくださいッ！
#. de: Dich brauche ich nicht mehr. Also geh zur Seite und lass uns durch!
#. fr: Je ne saisirai pas cette main que vous me tendez. Laissez-nous passer, je vous en prie<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002240_RYNE:1"
msgid "Let us pass, or kill me. I'm not leaving here without them."
msgstr ""

#. ja: 愚かな……！<br>反逆者どもに染められおって、仕置きが必要か……！
#. de: So ein Blödsinn. Die Störenfriede haben dir den Kopf verdreht, aber ich werde dich schon wieder zur Vernunft bringen!
#. fr: Idiote<nbsp>! Tu t'es laissé convaincre par les rebelles... Tu mérites une punition<nbsp>!
#. speaker: RANJIT
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002250_RANJIT:1"
msgid "How <i>dare</i> you! Very well─if you would cast your lot with villains, then you shall share their fate!"
msgstr ""

#. ja: ハ！
#. de: Ha!
#. fr: ハ！
#. speaker: RANJIT
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002251_RANJIT:1"
msgid "(ATTACK GRUNT)"
msgstr ""

#. ja: ……お前が伝えようとしてくれた気持ちは、<br>痛いほど、よくわかってる……。<br>言葉で示せず、すまなかった。
#. de: Ich verstehe dich besser, als du meinst. Auch wenn ich es dir nie sagen konnte.
#. fr: Si tu savais comme je te comprends... J'aurais aimé te le dire plus tôt, mais je n'ai pas pu.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002260_THANCRED:1"
msgid "I heard what you said. And I'm sorry for all the things I've left unspoken."
msgstr ""

#. ja: 行けッ、こいつは俺が食い止める！
#. de: Und jetzt lauf! Ich kümmere mich um den hier.
#. fr: Partez, je m'occupe de lui<nbsp>!
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002270_THANCRED:1"
msgid "You have to go. Now!"
msgstr ""

#. ja: でも……っ！
#. de: Aber<nbsp>...!
#. fr: Mais je...<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002280_RYNE:1"
msgid "Thancred, no─"
msgstr ""

#. ja: だから誰のためでもない、お前の望みをぶつけてくるんだ。
#. de: Tu nur, was <i>du</i> für richtig hältst.
#. fr: On s'en fiche de ce qui est le mieux pour les autres. Ce qui compte, c'est ce que toi tu veux.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002290_THANCRED:1"
msgid "Go! Do what you came here to do."
msgstr ""

#. ja: 俺は……<br>お前のわがままくらい、いくつだって受け止めてやる……！
#. de: Ich komm schon zurecht.
#. fr: Moi, je suis prêt à me mettre en quatre pour satisfaire tes désirs<nbsp>!
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002300_THANCRED:1"
msgid "I'll not have you waste that newfound resolve on me."
msgstr ""

#. ja: そいつを頼んだ！<br>必ず、「ミンフィリア」のもとまで届けてやってくれ。
#. de: Kümmer dich um sie. Bring sie zu Minfilia!
#. fr: Je vous la confie<nbsp>! Emmenez-la auprès de l'autre Minfilia<nbsp>!
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002310_THANCRED:1"
msgid "I leave her in your hands. Hurry!"
msgstr ""

#. ja: 行かせはしない。<br>妹と娘、ふたりの家族への想いだ……打ち破れると思うなよッ！
#. de: Für mich ist sie Schwester und Tochter, und ich lasse nicht zu, dass du ihr etwas antust!
#. fr: Toi, tu restes là<nbsp>! Je ne te laisserai pas briser les rêves de celles dont j'ai fait ma sœur et ma fille. Elles sont ma seule famille<nbsp>!
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002320_THANCRED:1"
msgid "Not another step! Your fight is with me."
msgstr ""

#. ja: 笑止ッ……！<br>貴様のような未熟者が、あれの父など名乗るではないわ！
#. de: Du hältst dich für ihren Vater? Du bist doch selbst nur ein unreifer Stümper!
#. fr: C'est d'un grotesque<nbsp>! Comment quelqu'un d'aussi médiocre que toi pourrait assumer le rôle d'un père<nbsp>!?
#. speaker: RANJIT
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002330_RANJIT:1"
msgid "You think yourself her protector!? Hah! As if a whelp like you could be a better father to her than me!"
msgstr ""

#. ja: ……あの娘は、苦難の星のもとに生まれたのだ。<br>苦しむぞ……これからも……。
#. de: Das Mädchen ist unter einem Unglücksstern geboren. Ihr Leid wird niemals enden.
#. fr: Cette petite est née sous le signe du désespoir... Sa vie n'est que souffrance...
#. speaker: RANJIT
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002340_RANJIT:1"
msgid "You would have her suffer and die. I would spare her that fate!"
msgstr ""

#. ja: 護っていくさ。<br>……あいつが、それを望むかぎり。
#. de: Ich werde sie beschützen. Solange sie das will.
#. fr: Je la protégerai... tant qu'elle voudra de moi à ses côtés.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002350_THANCRED:1"
msgid "That is not for you or anyone else to decide─ever again."
msgstr ""

#. ja: はぁ…はぁ…
#. de: Ha ... ha ...
#. fr: Ha... Ha...
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002360_THANCRED:1"
msgid "(PANTING)"
msgstr ""

#. ja: ――君が この人生に与えてくれたものを<br>旅しながら 何度も思い返していた
#. de: Kein Tag vergeht in dieser Welt, an dem ich nicht daran denke, was du mir alles gegeben hast.
#. fr: Je n'ai jamais cessé de penser, au cours de ce voyage, à tout ce que tu as apporté dans ma vie.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002370_THANCRED:1"
msgid "Not a single day goes by that I don't think about all that you have given me."
msgstr ""

#. ja: 他愛もない日常 過ぎていく日々<br>俺がそれを持て余している間に 君はすっかり大きくなった
#. de: Wie schnell du erwachsen wurdest<nbsp>... Während ich sorglos in den Tag hinein lebte und meine Zeit verschwendete.
#. fr: Je passais le plus clair de mon temps à ne penser qu'à moi. Et lorsque je m'en suis rendu compte, tu avais déjà bien grandi.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002380_THANCRED:1"
msgid "Countless memories and moments I took for granted... Gods, you grew up so fast."
msgstr ""

#. ja: 思い出は ひとつひとつが鮮明で<br>だから あのときの言葉もよく覚えている
#. de: Ich erinnere mich so deutlich<nbsp>... Ich weiß noch ganz genau, was du damals zu mir gesagt hast.
#. fr: Je n'ai jamais rien oublié des moments qu'on a passés ensemble... y compris les dernières paroles que tu m'as adressées.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002390_THANCRED:1"
msgid "But you had to, didn't you? For those you had lost. For those you could yet save."
msgstr ""

#. ja: もらった愛情を 今度は誰かにわけにいくと――<br>そういって 遠い世界に旅立っていった
#. de: Du wolltest die Liebe, die du selbst erfahren hast, in die ganze Welt hinaustragen.
#. fr: “Tu m'as toujours porté tant d'affection... C'est à mon tour d'en donner autour de moi, aujourd'hui.”<br>Voilà ce que tu m'as dit avant de t'en aller vers ce monde lointain.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002400_THANCRED:1"
msgid "A world teetering on the very brink of oblivion, for which you gave your everything without hesitation..."
msgstr ""

#. ja: そんな優しい君の願いに 今度もまた<br>気づかなければよかったのかもしれない
#. de: Deine Güte und dein Mitgefühl stellen mich auf die Probe<nbsp>... Damals<nbsp>... wie heute<nbsp>... 
#. fr: Les choses auraient été plus simples si tu n'avais pas eu cette bonté d'âme...
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002410_THANCRED:1"
msgid "Your kindness, your compassion, your love... Then and now..."
msgstr ""

#. ja: ……でも、一度くらいはちゃんと叶えたいだろ。<br>俺は、お前の、「お兄さん」なんだから。
#. de: Wenigstens dieses eine Mal werde ich dich nicht enttäuschen. Ich bin doch<nbsp>... dein großer Bruder.
#. fr: Je voudrais que ton vœu soit exaucé, rien qu'une fois... Faire mon boulot de grand frère...
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002420_THANCRED:1"
msgid "One last time, with a little help. I'm so proud to have been a part of your life..."
msgstr ""

#. ja: ミンフィリア…………
#. de: Minfilia<nbsp>...
#. fr: Minfilia...
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002430_THANCRED:1"
msgid "Oh, Minfilia..."
msgstr ""

#. ja: この気配……ッ！
#. de: Da ist was!
#. fr: Cette sensation...<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002440_RYNE:1"
msgid "Is this─"
msgstr ""

#. ja: みんな逃げろ、「光の氾濫」が来るぞ！
#. de: Flieht! Das Licht kommt!
#. fr: Fuyez, le déluge de Lumière va s'abattre sur nous<nbsp>!
#. speaker: NABAATHARENGPEOPLEA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002450_NABAATHARENGPEOPLEA:1"
msgid "Run for your lives! It's the Flood! The Flood!"
msgstr ""

#. ja: うわあああ！
#. de: Uaaahhh!
#. fr: (Cri de terreur, “Ouaaaah<nbsp>!”)
#. speaker: NABAATHARENGPEOPLEB
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002460_NABAATHARENGPEOPLEB:1"
msgid "(SCREAMING)"
msgstr ""

#. ja: 助けてぇ！
#. de: Das ist das Ende!
#. fr: À l'aide<nbsp>!
#. speaker: NABAATHARENGPEOPLEC
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002470_NABAATHARENGPEOPLEC:1"
msgid "The end is nigh!"
msgstr ""

#. ja: お、おい見ろ！<br>宮殿の上、誰かいるぞっ！
#. de: Seht nur! Da oben ist jemand!
#. fr: Là-haut, au-dessus du palais<nbsp>! Y a quelqu'un<nbsp>!
#. speaker: NABAATHARENGPEOPLED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002480_NABAATHARENGPEOPLED:1"
msgid "Look! Th-There's somebody up there! On top of the palace!"
msgstr ""

#. ja: くっ
#. de: Hrrrgh<nbsp>...
#. fr: (Gémissement douloureux. Elle tient le coup, “Guh...”)
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002490_MINFILIA:1"
msgid "(EFFORT GRUNT)"
msgstr ""

#. ja: だめよ、あなたは力を使い果たしてはだめ。
#. de: Nein. Du nicht.
#. fr: Arrête<nbsp>! Tu dois économiser tes forces<nbsp>!
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002500_MINFILIA:1"
msgid "No. Stand back."
msgstr ""

#. ja: わたしの力と、あなたの仲間たちの力……<br>この場は、それで食い止めます。
#. de: Es<nbsp>... Es geht auch so.
#. fr: Les miennes et celles de tes camarades devraient suffire<nbsp>!
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002510_MINFILIA:1"
msgid "We shall stay the Flood."
msgstr ""

#. ja: どうしてだよ……！<br>俺だって、この世界を護る力になれるなら……！
#. de: Warum? Ich bin bereit!
#. fr: Non<nbsp>! Moi aussi, je veux protéger ce monde<nbsp>!
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002520_WARRIOROFDARKNESS:1"
msgid "But this is what I want! It's my sacrifice to make!"
msgstr ""

#. ja: あなたは、まだ消えるべきではないわ。
#. de: Nein. Deine Zeit ist noch nicht gekommen.
#. fr: Tu as encore un rôle à jouer, tu ne peux pas disparaître<nbsp>!
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002530_MINFILIA:1"
msgid "Your time has not yet come."
msgstr ""

#. ja: いずれ、この世界を本当の意味で救おうとしたとき、<br>あなたはもう一度、希望になる。
#. de: Warte. Warte auf den Tag, an dem du diese Welt wirklich retten wirst.
#. fr: Lorsqu'il sera temps de sauver ce monde pour de bon, tu porteras à nouveau le flambeau de l'espoir.
#. speaker: MINFILIA
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002540_MINFILIA:1"
msgid "When all hangs in the balance, <i>you</i> must give them hope."
msgstr ""

#. ja: ミンフィリア……ッ！
#. de: Minfilia!
#. fr: Minfilia<nbsp>!!
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002550_WARRIOROFDARKNESS:1"
msgid "Minfilia!"
msgstr ""

#. ja: ここは……。
#. de: Wo sind wir?
#. fr: Où... Où sommes-nous<nbsp>?
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002560_RYNE:1"
msgid "This place..."
msgstr ""

#. ja: あなたが……本当の……！
#. de: Du<nbsp>... Du bist die echte<nbsp>...
#. fr: C'est toi... la vraie...<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002570_RYNE:1"
msgid "You... You're..."
msgstr ""

#. ja: よく……本当によく、ここまで来てくれました。<br>こうしてあなたたちに会えて、とても嬉しい……。
#. de: Ihr habt mich gefunden. Ich bin wirklich überglücklich, euch hier zu treffen.
#. fr: Vous avez fait l'impossible pour arriver jusqu'ici. Je suis si heureuse de vous voir...
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002580_MINFILIA:1"
msgid "Ours is a meeting long overdue. Full glad am I that we may finally speak."
msgstr ""

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q4
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_Q4_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr ""

#. ja: 本当に、久しぶり
#. de: Wir haben uns so lange nicht gesehen.
#. fr: Ça fait si longtemps...
#. speaker: A4
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_A4_000_001_NONE_VOICE:1"
msgid "It's good to see you again."
msgstr ""

#. ja: サンクレッドから頼まれて来た
#. de: Thancred wäre so gerne mitgekommen.
#. fr: C'est Thancred qui nous envoie.
#. speaker: A4
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_A4_000_002_NONE_VOICE:1"
msgid "I've come at Thancred's behest."
msgstr ""

#. ja: …………
#. de: ...
#. fr: ...
#. speaker: A4
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_A4_000_003_NONE_VOICE:1"
msgid "..."
msgstr ""

#. ja: わたしの魂をここまで抱いてきてくれた、優しい子。<br>あなたにずっと、伝えたいと思っていたの。
#. de: Du bist das liebe Mädchen, das meine Seele so gut behütet hat. Ich wollte dir schon lange etwas sagen.
#. fr: Merci d'avoir porté mon âme en toi jusqu'à ce jour. Je voulais te le dire depuis si longtemps...
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002590_MINFILIA:1"
msgid "My dear, sweet child... Yours is a burden none should ever be forced to bear."
msgstr ""

#. ja: つらい宿命を背負わせてしまって、ごめんなさい……。<br>それでも投げ出さずに歩いて来てくれて、ありがとう。
#. de: Es tut mir leid, was für ein schweres Schicksal du auf deinen Schultern tragen musst. Und ich danke dir, dass du es so tapfer angenommen hast.
#. fr: Je suis désolée de t'avoir accablée du poids d'un tel destin... et je te suis re<shy>con<shy>nais<shy>sante de ne jamais avoir baissé les bras.
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002600_MINFILIA:1"
msgid "Such pain and suffering you have endured, yet still you came. For this and more, I thank you."
msgstr ""

#. ja: 私は、いつでも負けそうでした……。<br>だけど、みんながいてくれたから……。
#. de: Ich dachte, ich schaffe es nicht. Aber ich hatte Freunde, die bei mir waren.
#. fr: J'ai failli abandonner tellement souvent... C'est grâce aux autres si je m'en suis sortie.
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002610_RYNE:1"
msgid "I've lost count of the times I've almost given up. If people hadn't helped me every step of the way, I never would have made it."
msgstr ""

#. ja: ……さあ、聞かせてちょうだい。<br>あなたの言葉で、あなたの望みを。
#. de: Also, sag mir bitte in deinen eigenen Worten: Was wünschst du dir?
#. fr: ... Bien, dis-moi tout. Quelle est ta décision<nbsp>?
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002620_MINFILIA:1"
msgid "Yet here you stand, resolved. Now...tell me your heart's desire."
msgstr ""

#. ja: 私は、みんなと一緒にすべての大罪喰いを倒し、<br>この世界を救いたいです。
#. de: Ich möchte meinen Freunden helfen, die Licht<shy>bringer zu besiegen und diese Welt zu retten.
#. fr: Je veux terrasser les grands purgateurs et sauver ce monde avec les autres.
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002630_RYNE:1"
msgid "To defeat the sin eaters, and bring this world back from the brink!"
msgstr ""

#. ja: でも、大罪喰いは姿を隠している……。<br>「光の巫女」の力があれば、<br>それを突き止めることができるでしょうか？
#. de: Aber sie verstecken sich. Kannst du sie mit deiner Gabe finden?
#. fr: Mais ces monstres se cachent... Dites-moi, est-ce que je serais capable de les trouver, si j'avais vos pouvoirs<nbsp>?
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002640_RYNE:1"
msgid "The remaining Wardens have hidden themselves from us. But with the power of the Oracle, I thought we might be able to find them..."
msgstr ""

#. ja: ええ、できるでしょう。<br>強い光を辿って、彼らの居場所を探し出せるわ。
#. de: Ja, ich glaube schon. Man müsste dahin gehen, wo das Licht am stärksten ist.
#. fr: Certainement, car tu pourrais suivre la Lumière pour les localiser.
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002650_MINFILIA:1"
msgid "Indeed you could. Their radiance would be unmistakable."
msgstr ""

#. ja: ……でも、あなたの予想するとおり、<br>それは本来の「光の巫女」の力があればの話。
#. de: Allerdings wird das nur mit den vollen Kräften des Orakels gelingen.
#. fr: Mais comme tu l'as dit toi-même, cela ne serait possible que si tu disposais de mes pouvoirs.
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002660_MINFILIA:1"
msgid "But know, my child, that the power you seek will come at a price."
msgstr ""

#. ja: 先へ進もうと思えば、選ぶしかない……。<br>わたしたちは、分岐点にたどり着いてしまったの。
#. de: Um weiterzugehen, muss eine Entscheidung getroffen werden. Wir stehen an einem Scheideweg.
#. fr: Nous nous trouvons à la croisée des chemins. Si tu veux avancer, il te faut choisir.
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002670_MINFILIA:1"
msgid "We stand now at the crossroads. A decision must be made."
msgstr ""

#. ja: ……選ぶのは、いつだって勇気がいる。
#. de: Wie jede wichtige Entscheidung erfordert auch diese großen Mut.
#. fr: Il faut beaucoup de courage pour prendre une telle décision.
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002680_MINFILIA:1"
msgid "'Tis only natural to be afraid. To hesitate."
msgstr ""

#. ja: でも、あなたはそれを為せるだけの強さを、<br>大切な人たちから、もらってきたのではないかしら。
#. de: Doch ich glaube, mit deinen Freunden an deiner Seite brauchst du dich nicht davor zu fürchten.
#. fr: Je suis persuadée que tes compagnons t'en ont énormément transmis pour que tu aies la force d'affronter ce moment.
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002690_MINFILIA:1"
msgid "But for your many trials, you have grown stronger and wiser. And with the love and support of those you hold dear, you have grown to love yourself."
msgstr ""

#. ja: 100年前……この世界からは、<br>「光の氾濫」とともに、多くが失われました。
#. de: Vor einhundert Jahren kam die Lichtflut und hat fast alles vernichtet.
#. fr: Il y a cent ans, le déluge de Lumière a déferlé sur ce monde et a presque tout emporté avec lui.
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002700_RYNE:1"
msgid "The Flood has washed away so much of this world."
msgstr ""

#. ja: たくさんの命、豊かだったはずの大地、<br>そして……英雄と呼ばれる存在も。
#. de: Unzählige Leben, fruchtbares Land und<nbsp>... aufrichtige Helden.
#. fr: Un nombre incalculable de vies, les terres nourricières... sans parler des héros qui ont tout tenté pour les protéger.
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002710_RYNE:1"
msgid "So many people and places and possibilities─and all the heroes who fought to protect them."
msgstr ""

#. ja: そんな世界で、私はみなさんの背中を見ました。<br>遥か遠くから来た、英雄たちの背中を……<br>一緒に旅をして、すぐ近くで。
#. de: Dann kamen sie. Neue Helden von weit weg. Ich habe sie gesehen und bin ihnen gefolgt.
#. fr: C'est dans ce monde que j'ai fait la con<shy>nais<shy>san<shy>ce d'autres héros venus de si loin, dans ce monde que j'ai voyagé avec eux.
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002720_RYNE:1"
msgid "Yet here the Scions are, trying so, so hard to help those few of us who remain. And seeing how tirelessly they work, how completely committed they are to the cause...I can't help but believe."
msgstr ""

#. ja: 私はまだ未熟だけれど、<br>許されるのなら、あの背中を追いかけてみたい。
#. de: Ich bin noch ein Kind und es gibt vieles, das ich nicht weiß. Aber wenn ich darf, möchte ich gerne bei ihnen bleiben.
#. fr: J'ai encore beaucoup à apprendre, alors si vous le permettez, j'aimerais continuer à les suivre et à combattre à leurs côtés.
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002730_RYNE:1"
msgid "But I want to do more than just watch and cheer. I want to make a difference."
msgstr ""

#. ja: 無謀だとしても……届かないかもしれなくても……<br>もらった想いを、力を、次の誰かに伝えられるようになりたい。
#. de: Auch wenn wir scheitern, wenn wir nichts erreichen<nbsp>... dann möchte ich wenigstens etwas an die weitergeben, die nach uns kommen.
#. fr: Ça peut sembler insensé, mais je veux satisfaire les espoirs placés en moi et léguer cette force à mon tour.
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002740_RYNE:1"
msgid "I want to help them, like they helped me─and maybe even inspire others to do the same."
msgstr ""

#. ja: それが繋がって、繋がって……<br>この世界でもいつかまた、多くの英雄たちが、<br>果てない未来を目指すようになればいい。
#. de: Es gibt eine Verbindung<nbsp>... von Helden zu Helden, die uns für eine bessere Zukunft kämpfen lässt. Davon möchte ich ein Teil sein.
#. fr: Pour que de fil en aiguille, ce monde soit un jour peuplé de nombreux héros qui se battront pour un avenir radieux.
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002750_RYNE:1"
msgid "Coming together, providing for one another─that's the only way forward I can see. Since all of our heroes are gone, we'll just have to make heroes of ourselves."
msgstr ""

#. ja: 素敵な夢……。<br>わたしもかつて、願ったわ。
#. de: Das ist ein schöner Traum, der richtige Traum. Ich habe mir einst etwas ganz Ähnliches gewünscht.
#. fr: Quel beau rêve... J'ai souhaité la même chose, moi aussi, il y a bien longtemps.
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002760_MINFILIA:1"
msgid "'Tis a beautiful, wonderful dream. One we share."
msgstr ""

#. ja: 「ミンフィリア」という存在を、<br>罪喰いと戦う人々の灯火として繋いでいく……<br>それが、いつか本当の救いに結びついてほしいと。
#. de: Ich wollte, dass der Glaube an Minfilia den Bewohnern dieser Welt ein Licht der Hoffnung ist, damit sie vereint gegen die Sünden<shy>ver<shy>tilger kämpfen und so irgendwann wirklich ihre Welt retten.
#. fr: Je voulais que le nom de “Minfilia” soit synonyme d'espoir pour ceux qui combattent les purgateurs, qu'il guide le monde jusqu'à son salut.
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002770_MINFILIA:1"
msgid "Though my power was all but spent in staying the Flood, I prayed this final act would give hope to those who survived."
msgstr ""

#. ja: あの願いは、あなたが拾ってくれたのね。<br>……わたしは、それで十分、胸を張ることができる。
#. de: Du hast meinen Traum weitergeträumt. Da habe ich allen Grund, stolz auf mich zu sein.
#. fr: Je vois que tu as repris le flambeau... Ça suffit à me mettre du baume au cœur<nbsp>!
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002780_MINFILIA:1"
msgid "That selfsame hope lives on in you. It gives me comfort to know that the future is in capable hands."
msgstr ""

#. ja: あなたがどれほどの力を手に入れたとしても、<br>絶望は立ちふさがり、無力に苛まれるでしょう。
#. de: Egal, wie stark du wirst. Irgendwann kommen immer Zweifel und schwächen dich.
#. fr: Aussi grand soit le pouvoir dont tu disposes, il ne te servira à rien si tu perds espoir.
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002790_MINFILIA:1"
msgid "If ever you should falter, remember this: no one, however powerful, is immune to the whisperings of doubt and despair."
msgstr ""

#. ja: それでも、決して負けないで……。<br>わたしの心をわかってくれた、優しくて愛しいあなた。
#. de: Aber gib nicht auf, liebes Mädchen, das meinen Traum im Herzen trägt.
#. fr: Quoi qu'il advienne, ne baisse pas les bras. Tu as bon cœur et tu as su me comprendre, alors je sais que tu y arriveras.
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002800_MINFILIA:1"
msgid "Do not give in to them, but do not deny them either. Look instead to the light within, that you may continue to serve as a beacon to others."
msgstr ""

#. ja: ……ありがとう、ミンフィリア。<br>私を、人を、信じ続けてくれて……。
#. de: Du hast immer an mich und das Gute in dieser Welt geglaubt. Danke, Minfilia.
#. fr: Merci, Minfilia. Merci de croire en moi, en nous tous<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002810_RYNE:1"
msgid "Thank you, Minfilia, for believing in us. For believing in me."
msgstr ""

#. ja: あなたにも、心からの感謝を……。<br>その存在は、わたしにとって、<br>混迷の闇を照らす暁そのものだった。
#. de: Auch dir danke ich von ganzem Herzen. Du warst für mich die Morgenröte, die die Dunkelheit vertreibt.
#. fr: Je te suis re<shy>con<shy>nais<shy>sante à toi aussi... Tu as été pour moi une lueur d'espoir au cœur des ténèbres les plus épaisses.
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002820_MINFILIA:1"
msgid "Dearest friend...no words can express my gratitude to you for keeping her safe in these tumultuous times. You are a hero to us both."
msgstr ""

#. ja: 覚えていて……。<br>英雄は、ひとりではないわ。
#. de: Vergiss nie: Du kämpfst nicht allein.
#. fr: N'oublie pas<nbsp>: les héros ne sont jamais seuls.
#. speaker: MINFILIA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002830_MINFILIA:1"
msgid "But not even the most valiant heroes can stand alone."
msgstr ""

#. ja: ふたつの世界のあなたが手を取れば、<br>運命はまた、切り開かれる。
#. de: Wenn die Helden zweier Welten ihre Kräfte vereinen, können sie dem Schicksal einen neuen Weg bahnen.
#. fr: Toi et un alter ego pouvez encore faire basculer le destin si vous œuvrez main dans la main.
#. speaker: MINFILIA
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002840_MINFILIA:1"
msgid "Only <i>together</i> may you change the fate of two worlds."
msgstr ""

#. ja: ……よう。<br>そっちも無事みたいだな。
#. de: Hallo. Habt ihr auch alles gut überstanden?
#. fr: Salut<nbsp>! Content de voir que tout le monde est sain et sauf...
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002850_THANCRED:1"
msgid "Ah, there you are. We were worried."
msgstr ""

#. ja: 何言ってるのよ。<br>サンクレッドは、全然無事じゃなかったじゃない！
#. de: Was heißt hier „auch gut überstanden“? Thancred, du hast ganz schön was abbekommen!
#. fr: Qu'est-ce que tu racontes<nbsp>!? T'as vu dans quel état tu es<nbsp>?
#. speaker: ALISAIE
#. macro: <if $gn4>She<else>He</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $gn4>herself<else>himself</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002860_ALISAIE:1"
msgid "Really? <if $gn4>She<else>He</if> wasn't the one that nearly got <if $gn4>herself<else>himself</if> killed."
msgstr ""

#. ja: ウリエンジェに呼ばれて合流しにきたら、<br>ボロッボロになって倒れてるんですもの。<br>こっちの肝が冷えたわよ！
#. de: Urianger hat uns extra hergerufen, damit wir dich wieder zusammenflicken. Als ich dich gesehen habe, ist mir fast das Herz stehen<shy>geblieben!
#. fr: On a fait aussi vite que possible quand Urianger nous a avertis, et tu étais aux portes de la mort quand on t'a trouvé<nbsp>! Je me suis fait un sang d'encre<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002870_ALISAIE:1"
msgid "It's a good thing Urianger called on us when he did. You were at death's door when we found you."
msgstr ""

#. ja: はは……。<br>治癒魔法が達者な仲間ばかりで、助かったよ。
#. de: Hehe. Da sieht man mal wieder: Heiler haben viele Freunde.
#. fr: Ha ha... J'ai la chance incroyable d'être entouré d'experts en magie curative<nbsp>!
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002880_THANCRED:1"
msgid "But thanks to your timely ministrations, I was not obliged to walk through it."
msgstr ""

#. ja: その姿は……。
#. de: Minfilia<nbsp>... Du hast dich<nbsp>... verändert.
#. fr: Minfilia...<nbsp>?
#. speaker: ALPHINAUD
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002890_ALPHINAUD:1"
msgid "Minfilia...?"
msgstr ""

#. ja: ……ちゃんと、会えたんだな。
#. de: Ihr habt euch also endlich getroffen.
#. fr: Vous vous êtes enfin rencontrées...
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002900_THANCRED:1"
msgid "You saw her."
msgstr ""

#. ja: (-ミンフィリア-)あの……私……これからもっと、もっと努力します……！<br>戦うことも、ほかのことも……！
#. de: (-Minfilia-)Ich<nbsp>... werde mir jetzt noch mehr Mühe geben. Beim Kämpfen und<nbsp>... überhaupt bei allem.
#. fr: (-Minfilia-)Je... Je vais donner le meilleur de moi-même<nbsp>! Aussi bien au combat que dans tout ce que j'accomplirai<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002910_RYNE:1"
msgid "(-Minfilia-)I know I haven't exactly been pulling my weight up till now, but that's all going to change, starting today."
msgstr ""

#. ja: (-ミンフィリア-)それでも全然……全然たりないかもしれないけれど、<br>ミンフィリアが願ったことまで、絶対に、叶えてみせます。
#. de: (-Minfilia-)Vielleicht reicht es nicht. Aber ich will alles tun, damit Minfilias Traum wahr wird.
#. fr: (-Minfilia-)Je ne sais pas si ça suffira, mais je ferai tout pour exaucer les vœux de votre Minfilia.
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002920_RYNE:1"
msgid "(-Minfilia-)I'll do whatever it takes─whatever it takes to make Minfilia's dream a reality."
msgstr ""

#. ja: (-ミンフィリア-)罪喰いの居場所も、ちゃんとわかるようになりました。<br>お役に立てるはずです、だから……！
#. de: (-Minfilia-)Ich weiß jetzt, wo der Licht<shy>bringer ist. Ich kann euch zu ihm führen.
#. fr: (-Minfilia-)Je vais pouvoir me rendre utile. Je suis capable de localiser les purgateurs, maintenant<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002930_RYNE:1"
msgid "(-Minfilia-)I can track the Lightwardens now. Maybe even help you fight them."
msgstr ""

#. ja: おかえり、がんばったな。
#. de: Ich hab dich vermisst.
#. fr: Content de te revoir parmi nous.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002940_THANCRED:1"
msgid "I'm glad you're back."
msgstr ""

#. ja: (-ミンフィリア-)本当に……よかったの…………？
#. de: (-Minfilia-)Wirklich? Meinst du das ernst?
#. fr: (-Minfilia-)... Vraiment<nbsp>? Je croyais que tu serais déçu...
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002950_RYNE:1"
msgid "(-Minfilia-)You don't have to say that, you know..."
msgstr ""

#. ja: ……家族が無事に帰ってきたんだ。<br>おかえり以外に、掛けるべき言葉があるか？
#. de: Natürlich. Wir sind doch Familie.
#. fr: Tu es ma famille, et je te retrouve saine et sauve. Je n'ai pas la moindre raison d'être déçu.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002960_THANCRED:1"
msgid "But I want to. You're family. How else would I feel?"
msgstr ""

#. ja: さて、これからは、あの子を何て呼ぼうかしら？
#. de: Also. Wie wollen wir sie denn jetzt nennen?
#. fr: Bien. Par quel nom devons-nous appeler cette enfant, désormais<nbsp>?
#. speaker: YSHTOLA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002970_YSHTOLA:1"
msgid "She will need a name."
msgstr ""

#. ja: これまでどおりじゃダメなのかい？
#. de: Braucht sie denn einen neuen Namen?
#. fr: Parce qu'il y a un problème avec son ancien nom<nbsp>?
#. speaker: ALPHINAUD
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002980_ALPHINAUD:1"
msgid "A name?"
msgstr ""

#. ja: 当然よ、あの子は運命を自分のものとして受け入れた。<br>それなら自身の名を持つべきだわ。
#. de: Sie hat ihren Weg gewählt und sich selbst ein neues Schicksal gegeben. Ich denke, damit hat sie sich auch einen eigenen Namen verdient.
#. fr: Évidemment. Puisqu'elle a choisi de prendre en main sa destinée, elle doit être appelée par un nom qui n'appartient qu'à elle.
#. speaker: YSHTOLA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_002990_YSHTOLA:1"
msgid "A name of her own. I would not have her walk in the shadow of another any longer."
msgstr ""

#. ja: 何より……私たちにこそ必要なケジメよ。<br>ミンフィリアの「暁」に集った者としてね。
#. de: Wichtiger aber ist, dass wir sie richtig von unserer Minfilia unterscheiden können, der vom Bund der Morgenröte. Ich komm ja selbst schon ganz durcheinander.
#. fr: C'est une distinction que nous devons faire plus que quiconque, nous qui sommes les “Héritiers” de Minfilia.
#. speaker: YSHTOLA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003000_YSHTOLA:1"
msgid "And I think it a fitting tribute to our departed friend too. At the mention of Minfilia, I would remember the woman who preserved our fellowship when all seemed lost."
msgstr ""

#. ja: ねえ、あなたユールモアに引き取られる前は、<br>何て呼ばれていたの？
#. de: Erinnerst du dich an deinen Namen, bevor man dich nach Eulmore gebracht hat?
#. fr: Comment tu t'appelais, avant d'arriver à Eulmore<nbsp>?
#. speaker: ALISAIE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003010_ALISAIE:1"
msgid "Do you remember what you were called before you were taken to Eulmore?"
msgstr ""

#. ja: (-ミンフィリア-)それは……覚えていないんです。<br>とても小さいころだったから……。
#. de: (-Minfilia-)Nein. Ich war noch zu klein.
#. fr: (-Minfilia-)Je ne me souviens plus... J'étais toute petite...
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003020_RYNE:1"
msgid "(-Minfilia-)I'm sorry, I don't. I couldn't have been very old when it happened."
msgstr ""

#. ja: それなら、新しく名付けるべきでしょうね……？
#. de: Dann müssen wir uns wohl einen ausdenken.
#. fr: Que dirais-tu d'un nouveau nom, alors<nbsp>?
#. speaker: YSHTOLA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003030_YSHTOLA:1"
msgid "Then we must think of a new name. Suggestions?"
msgstr ""

#. ja: うん、改めてというならば、<br>やはりサンクレッドが名付けるべきだろう。<br>家族からもらった名というのは、宝物になる。
#. de: Ich denke, die Ehre sollte dir zukommen, Thancred. Es wird eure Familienbande um ein weiteres Quäntchen enger knüpfen<nbsp>- herzlichen Glückwunsch.
#. fr: S'il faut en choisir un autre, il semblerait logique que l'honneur revienne à Thancred. Il la chérit plus que tout. Il est pour ainsi dire son père, désormais.
#. speaker: ALPHINAUD
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003040_ALPHINAUD:1"
msgid "If the lady herself has no preference, I think the honor should rightly fall to Thancred. After all they have been through together, he's practically a father to her."
msgstr ""

#. ja: ……ですってよ？<br>いやー、アルフィノも、一周回って空気が読めてるわ！
#. de: Du hörst es. Mein einfühlsamer Bruder bringt es mal wieder galant auf den Punkt.
#. fr: Vous avez entendu ça<nbsp>? Alphinaud a su trouver les mots justes ce coup-ci<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003050_ALISAIE:1"
msgid "Well spotted! I'm so glad you're here to explain these things."
msgstr ""

#. ja: どういうことだい？
#. de: Was habe ich denn gesagt?
#. fr: Qu'entends-tu par là<nbsp>?
#. speaker: ALPHINAUD
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003060_ALPHINAUD:1"
msgid "And what exactly is that supposed to mean?"
msgstr ""

#. ja: いいのいいの
#. de: Ach, nichts.
#. fr: T'inquiète, c'était un compliment<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003070_ALISAIE:1"
msgid "Oh, nothing..."
msgstr ""

#. ja: …………リーン、でどうだ。
#. de: Wie wär es mit<nbsp>... Ryne?
#. fr: Pourquoi pas “Ryne”<nbsp>?
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003080_THANCRED:1"
msgid "What about... Ryne?"
msgstr ""

#. ja: 妖精語で、「祝福」を意味する言葉……。
#. de: Das Wort für Glück in der Sprache der Feen<nbsp>...
#. fr: Ça veut dire “bénédiction” chez le peuple féerique...
#. speaker: URIANGER
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003090_URIANGER:1"
msgid "Ah. “Blessing” in Fae..."
msgstr ""

#. ja: サンクレッド、あなた……<br>私の妖精語講座を、ちゃんと聞いていたのですか……！
#. de: Thancred, sag bloß, du hast dir gemerkt, was ich dir über die Feensprache beigebracht habe?
#. fr: Thancred... Vous écoutiez quand j'essayais de vous enseigner leur langage<nbsp>!?
#. speaker: URIANGER
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003100_URIANGER:1"
msgid "Wait! Doth this mean thou wert <i>listening</i> when I delivered my lectures on the pixies?"
msgstr ""

#. ja: たまたまだ。<br>……響きがいいなと思って、記憶に残っていた。
#. de: Nicht wirklich. Aber das Wort klang so gut, da ist es wohl irgendwie hängengeblieben.
#. fr: Rien qu'un instant, hein... La sonorité m'a plu, ça m'est resté en tête.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003110_THANCRED:1"
msgid "Not exactly. But that one word made an impression."
msgstr ""

#. ja: ……不満なら、そう言ってくれ。<br>何か別のを考える。
#. de: Wenn dir der Name nicht gefällt, suchen wir dir einen anderen aus.
#. fr: N'hésite pas à le dire si tu n'aimes pas. J'en trouverai un autre.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003120_THANCRED:1"
msgid "Of course, if it's not to your liking, I can think of something else."
msgstr ""

#. ja: (-ミンフィリア-)リーン……私の名前……。
#. de: (-Minfilia-)Ryne<nbsp>...
#. fr: (-Minfilia-)Ryne... Je m'appelle Ryne...
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003130_RYNE:1"
msgid "Ryne... Yes, I rather like the sound of it."
msgstr ""

#. ja: ありがとう、とても嬉しい……！
#. de: Der Name klingt wirklich schön. Danke!
#. fr: Je l'adore<nbsp>! Merci, Thancred<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003140_RYNE:1"
msgid "Thank you."
msgstr ""

#. ja: それじゃあ……またよろしくな、リーン。
#. de: Also gut, dann ist es entschieden. Ryne.
#. fr: À nos aventures à venir, Ryne...
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003150_THANCRED:1"
msgid "That settles it, then. Welcome aboard, Ryne!"
msgstr ""

#. ja: はいっ！
#. de: Ja. Ich heiße Ryne!
#. fr: Oui<nbsp>!
#. speaker: RYNE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003160_RYNE:1"
msgid "I won't let you down."
msgstr ""

#. ja: あいつら、ナバスアレンには行けたみたいだけど……。
#. de: Immerhin sieht es so aus, als hätten sie es nach Nabaath Areng geschafft.
#. fr: Ils sont tous à Nabaath Areng, à ce qu'il paraît...
#. speaker: THAFFE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003170_THAFFE:1"
msgid "Don't get me wrong, I'm glad those travelers made it all the way to Nabaath Areng..."
msgstr ""

#. ja: ウリエンジェの連絡を受けて行ってみれば、<br>タロースは倒れてるわ、トロッコは横転してるわ……。<br>いったい何があったんだ……？
#. de: Aber was ist da bloß passiert? Der Talos lag da, die Bahn lag da<nbsp>... Und wenn Urianger uns nicht gerufen hätte, lägen sie da immer noch.
#. fr: Après avoir reçu le message d'Urianger, j'y suis allé moi aussi, mais le talos était mal en point et le chariot était renversé. C'est à se demander ce qui s'est passé...
#. speaker: THAFFE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003180_THAFFE:1"
msgid "But when Urianger told me the Talos was in pieces, and the trolley didn't look much better, I couldn't help wondering what in the hells had gone on."
msgstr ""

#. ja: さあなぁ。<br>ま、タロースについては、心核も無事だったんだ。<br>いくらでも直しゃいい。
#. de: Zum Glück ist das Herz heil geblieben. Damit können wir den Talos wieder in Gang setzen.
#. fr: Ça... Au moins, le noyau du talos était intact. On va pouvoir le réparer.
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003190_MAGNUS:1"
msgid "What indeed. At least the heart is in one piece. The rest is replaceable."
msgstr ""

#. ja: あいつら自身にしたって、とんでもねぇ強運の持ち主だからな。<br>そう簡単に、くたばりゃしねぇさ。
#. de: Und was die Fremden angeht, brauchen wir uns keine Sorgen zu machen. Die können auf sich selber aufpassen.
#. fr: Pour les autres, on sait déjà qu'ils ont une chance insolente. C'est pas le genre à mordre la poussière si facilement.
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003200_MAGNUS:1"
msgid "Looking at this mess, though, it's a miracle they survived..."
msgstr ""

#. ja: だといいんですけど……
#. de: Wollen wir's hoffen<nbsp>...
#. fr: Espérons...
#. speaker: THAFFE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003210_THAFFE:1"
msgid "Heh, you can say that again."
msgstr ""

#. ja: って……えええっ！？
#. de: Was ist das?
#. fr: Hé<nbsp>!<nbsp>... Hein<nbsp>!?
#. speaker: THAFFE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003220_THAFFE:1"
msgid "Wha─ What the!? Are you seeing this!?"
msgstr ""

#. ja: なんだ……この空……！？
#. de: Seht nur<nbsp>... Der Himmel!
#. fr: Qu'est-ce qui se passe<nbsp>!? Le ciel...
#. speaker: MAGNUS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003230_MAGNUS:1"
msgid "The sky, it's... It..."
msgstr ""

#. ja: やっと、アム・アレーンからも光を掃うことができた……。
#. de: Endlich. Endlich ist Amh Araeng auch vom Licht befreit<nbsp>...
#. fr: Nous avons enfin libéré l'Amh Araeng de la Lumière...
#. speaker: ALISAIE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003240_ALISAIE:1"
msgid "At last. Night has returned to Amh Araeng."
msgstr ""

#. ja: やったよ、テスリーン。<br>あなたの大事なみんなも、きっと良くなっていくわ。
#. de: Jetzt werden deine Patienten sicher bald wieder gesund, Tesleen!
#. fr: On a réussi, Tesleen... Ceux dont tu t'occupais vont pouvoir se remettre.
#. speaker: ALISAIE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003250_ALISAIE:1"
msgid "We'll save this broken world yet, Tesleen. You see if we don't..."
msgstr ""

#. ja: ユールモア軍の飛空艇だ。<br>空に闇が戻ったのを見て、撤退したんだろう。
#. de: Das sind Militärschiffe aus Eulmore. Sie haben den dunklen Himmel gesehen und ziehen sich zurück.
#. fr: Des aéronefs eulmoriens... Le retour des Ténèbres les fait battre en retraite.
#. speaker: ALPHINAUD
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003260_ALPHINAUD:1"
msgid "No doubt retreating in the wake of the Warden's demise."
msgstr ""

#. ja: これで、倒した大罪喰いは4体……<br>光に覆われている主要な地域も、残るはコルシア島付近のみね。
#. de: Vier Licht<shy>bringer sind besiegt. Jetzt ist nur noch Kholusia vom Licht bedeckt.
#. fr: Ça fait quatre grands purgateurs éliminés. Seuls les alentours de Kholusia sont encore sous le joug de la Lumière.
#. speaker: YSHTOLA
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003270_YSHTOLA:1"
msgid "Back to Kholusia. The last refuge of Light."
msgstr ""

#. ja: ああ……。<br>ヴァウスリーも、次は総力をあげて対抗してくるだろう。<br>連中の本拠地でもあることだしな。
#. de: Vauthry wird uns alles entgegenwerfen. Jetzt geht es schließlich um seine letzte Bastion.
#. fr: Oui... Et Vauthry va sans doute mettre encore plus d'énergie dans la bataille. Surtout que le combat va se dérouler chez lui cette fois-ci.
#. speaker: THANCRED
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003280_THANCRED:1"
msgid "Home to our dear Lord Vauthry─who will no doubt do everything in his power to thwart us."
msgstr ""

#. ja: 大罪喰いと決着をつけようとすれば、<br>必然、彼らとも決着をつけることになる……。
#. de: Ja. Uns steht nicht nur der letzte Licht<shy>bringer bevor, sondern auch die Konfrontation mit Eulmore.
#. fr: Il luttera bec et ongle pour protéger le dernier grand purgateur. L'af<shy>fron<shy>te<shy>ment est inévitable...
#. speaker: ALPHINAUD
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003290_ALPHINAUD:1"
msgid "As well he should, for defeat there would spell the end for both him and his heavenly host."
msgstr ""

#. ja: それを、世界を救うための、最後の戦いにするんだ……！
#. de: Bringen wir es zu Ende!
#. fr: C'est la bataille finale<nbsp>! Celle qui va nous permettre de sauver ce monde<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003300_ALPHINAUD:1"
msgid "There the fate of this star shall be decided."
msgstr ""

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous à Ardbert<nbsp>?  
#. speaker: Q5
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_Q5_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr ""

#. ja: おーい、不法侵入者ー
#. de: Wen haben wir denn da? Einen Eindringling<nbsp>...
#. fr: Ça va, on fait comme à la maison<nbsp>?
#. speaker: A5
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_A5_000_001_NONE_VOICE:1"
msgid "So this is where you've been hiding."
msgstr ""

#. ja: 今回はついてこなかったのか？
#. de: Warum bist du dieses Mal nicht mitgekommen?
#. fr: Tu ne m'as pas accompagné<if $gn4>e</if>, cette fois-ci<nbsp>?
#. speaker: A5
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_A5_000_002_NONE_VOICE:1"
msgid "Why did you stay behind?"
msgstr ""

#. ja: ……たまには留守番しててもいいだろ。<br>アム・アレーンは、どうだった？
#. de: Irgendjemand muss doch das Haus hüten. Wie ist es euch in Amh Araeng ergangen?
#. fr: Il faut bien que quelqu'un monte la garde en ton absence... Alors<nbsp>? C'était comment en Amh Araeng<nbsp>?
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003310_WARRIOROFDARKNESS:1"
msgid "Sometimes the dead would rather not be disturbed. But enough about me─what of Amh Araeng?"
msgstr ""

#. ja: そうか……ミンフィリアがな……。
#. de: Minfilia hat also ihre Bestimmung gefunden.
#. fr: Minfilia...
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003320_WARRIOROFDARKNESS:1"
msgid "I see. Minfilia's gone, then."
msgstr ""

#. ja: つまり、俺があいつに残された理由も、<br>ついにわからず仕舞いになっちまったってわけか……。
#. de: Nur meine kenne ich immer noch nicht.
#. fr: Je ne saurai donc jamais pourquoi elle ne m'a pas laissé suivre mes camarades...
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003330_WARRIOROFDARKNESS:1"
msgid "Which means the reason I must suffer this purgatory shall forever remain a mystery."
msgstr ""

#. ja: おいどうした、大丈夫か……！？
#. de: Was ist? Geht's dir nicht gut?
#. fr: Hé<nbsp>!! Hé, ça va<nbsp>!?
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003340_WARRIOROFDARKNESS:1"
msgid "What's the matter? Are you all right?"
msgstr ""

#. ja: なっ
#. de: Ah!
#. fr: Hein...<nbsp>?
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003350_WARRIOROFDARKNESS:1"
msgid "Ah!"
msgstr ""

#. ja: なんだったんだ……今の……。
#. de: Was<nbsp>... Was war das?
#. fr: C'était quoi, ça...<nbsp>?
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003360_WARRIOROFDARKNESS:1"
msgid "What...what just happened?"
msgstr ""

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q6
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_Q6_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr ""

#. ja: そういえば、ミンフィリアが言っていた
#. de: Jetzt verstehe ich, was Minfilia mir sagen wollte.
#. fr: Étrange... Ça me rappelle ce qu'a dit Minfilia...
#. speaker: A6
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_A6_000_001_NONE_VOICE:1"
msgid "There...there was something Minfilia said to me..."
msgstr ""

#. ja: 英雄は、ひとりではない……
#. de: Minfilia sprach von zwei Helden.
#. fr: “Les héros ne sont jamais seuls...”
#. speaker: A6
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_A6_000_002_NONE_VOICE:1"
msgid "Not even the most valiant heroes can stand alone..."
msgstr ""

#. ja: あいつは俺にも、消えるべきではないと……<br>いつかまた俺が必要になるのだと言っていた。
#. de: Sie sagte mir, dass meine Zeit noch nicht gekommen sei. Dass ich irgendwann die Welt retten würde.
#. fr: Elle m'a dit que je ne devais pas disparaître, car j'aurai un rôle à jouer plus tard.
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003370_WARRIOROFDARKNESS:1"
msgid "Minfilia said my time had not yet come. That I still had a role to play."
msgstr ""

#. ja: その理由が……まさか、お前に……？
#. de: Ist mein Schicksal etwa<nbsp>... mit dir verbunden?
#. fr: Elle a refusé mon sacrifice... pour que je t'aide<nbsp>?
#. speaker: WARRIOROFDARKNESS
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003380_WARRIOROFDARKNESS:1"
msgid "Not even the most valiant heroes can stand alone..."
msgstr ""

#. ja: いいや、俺はもう……英雄なんかじゃないんだ。<br>誰を救うこともできない、何にもなれない、亡霊だ……！
#. de: Ach, was rede ich da. Ich bin schon lange kein Held mehr. Ich rette nichts und niemanden<nbsp>... Ich bin ein Geist!
#. fr: C'est impossible... Je n'ai plus rien d'un héros, je ne pourrai plus sauver qui que ce soit. Je ne suis rien de plus qu'un fantôme<nbsp>!
#. speaker: WARRIOROFDARKNESS
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003390_WARRIOROFDARKNESS:1"
msgid "No─ No, it couldn't be. There's only one hero in this room, and it is <i>not</i> me. I'm just a shadow, cursed to wander."
msgstr ""

#. ja: ああ、ええと、急にすまない……！<br>ミンフィリア……でなくて、リーンたちから、<br>あなたの具合がよくないと聞いた。
#. de: Ähm, entschuldige die Störung<nbsp>... Minfilia<nbsp>- ich meine Ryne<nbsp>- sagte, dass sie sich Sorgen um dich macht.
#. fr: Désolé de te déranger... Minfilia... euh, Ryne et les autres m'ont dit que tu ne te sentais pas bien.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003400_MYSTERYVOICE:1"
msgid "Ahem. Forgive the intrusion, but Minfilia─that is, Ryne and the others were asking after you."
msgstr ""

#. ja: それで……その……大丈夫だろうか！？
#. de: Also? Wie geht es dir? Es ist doch bestimmt nicht so schlimm, oder?
#. fr: C'est pour ça que... Ça va<nbsp>?
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003410_MYSTERYVOICE:1"
msgid "Is everything all right?"
msgstr ""

#. ja: また異変があったのか……！？<br>それで、今は！？　まだ痛いとか、苦しいとか……！
#. de: Ein weiterer Schub? Gerade eben? Geht es dir wieder gut?
#. fr: Tu as encore eu cette sensation étrange<nbsp>? Et là, ça va mieux<nbsp>? Tu n'as pas mal, tu ne souffres pas trop<nbsp>?
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003420_MYSTERYVOICE:1"
msgid "That pain again? And did it pass?"
msgstr ""

#. ja: よかった……。<br>ひとまず治まってはいるのだな。
#. de: Es hat sich gelegt? Dann ist ja gut.
#. fr: Tant mieux si tout est rentré dans l'ordre pour le moment.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003430_MYSTERYVOICE:1"
msgid "Thank goodness for that. I would not wish to see you suffer."
msgstr ""

#. ja: ……いや、よくない……何もよくない。<br>度重なる罪喰い討伐を、あなたに頼っているのは事実。<br>負担をかけているのは、間違いない……。
#. de: Nein<nbsp>... genau genommen ist gar nichts gut. Wir verlangen viel zu viel von dir. Die ständigen Kämpfe gegen die Sünden<shy>ver<shy>tilger laugen dich aus.
#. fr: Mais c'est loin d'être une bonne nouvelle. Nous nous sommes beaucoup trop reposés sur toi. De toute évidence, tu portes sur tes épaules le poids de l'extermination des grands purgateurs.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003440_MYSTERYVOICE:1"
msgid "Though I know only too well how much you have suffered on our behalf in recent days."
msgstr ""

#. ja: すべては、私があなたに願ったことだ。<br>だから本当は、案じる資格すらないのかもしれないが……。
#. de: Es ist meine Schuld. Ich bin zu weit gegangen.
#. fr: Et c'est moi qui t'ai confié cette mission... Je ne me sens pas le droit d'exprimer mon inquiétude.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003450_MYSTERYVOICE:1"
msgid "Indeed, I have no right to impose upon you further. Nevertheless, I must ask one thing of you."
msgstr ""

#. ja: どうか、これからも無事でいてほしい。
#. de: Mir liegt nichts mehr am Herzen als deine Gesundheit.
#. fr: Je tiens vraiment à ce que tu ailles bien, aujourd'hui comme demain.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003460_MYSTERYVOICE:1"
msgid "That you survive this, no matter what."
msgstr ""

#. ja: あなたはこの戦いを終え、あなたを待つ人のもとへ戻る。<br>そして、第八霊災の起こらない世界で、冒険を続けるんだ。
#. de: Wenn das hier alles vorbei ist, wirst du nach Hause zurückkehren. Du wirst deine Abenteuer fortsetzen, in einer Welt, in der keine Achte Katastrophe eintreten wird.
#. fr: Quand tu auras triomphé ici, je veux que tu puisses rejoindre ceux qui t'attendent. Que tu continues de parcourir ton monde sans craindre la venue du huitième fléau...
#. speaker: MYSTERYVOICE
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003470_MYSTERYVOICE:1"
msgid "When the dust settles, you <i>must</i> return to your world. For the battles to come and the wars yet unwon."
msgstr ""

#. ja: そのためにも、あと1体……どうにか勝利を収めてほしい。<br>体の異変については、私も対処を考えておこう。
#. de: Dafür muss nur noch ein Licht<shy>bringer besiegt werden. Bitte, halte solange noch durch. Ich werde mich in der Zwischenzeit damit beschäftigen, wie wir deine Ver<shy>wand<shy>lung aufhalten.
#. fr: Et c'est pour ça qu'il faut que tu triomphes de ton dernier ennemi. Quant à moi, je me chargerai de trouver un remède au mal qui t'afflige.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003480_MYSTERYVOICE:1"
msgid "The final Lightwarden is all that stands between us and victory. There is still much we must do to prepare, but for now, I will see if there is aught that may remedy the strange affliction which plagues you."
msgstr ""

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que répondez-vous<nbsp>?
#. speaker: Q7
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_Q7_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr ""

#. ja: 任せろ、必ず勝つ
#. de: Ich werde ihn zur Strecke bringen, verlass dich drauf.
#. fr: Ne vous en faites pas, je vaincrai.
#. speaker: A7
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_A7_000_001_NONE_VOICE:1"
msgid "I'll see it through."
msgstr ""

#. ja: やっと戦いが終わりそうだ……
#. de: Dann hat der Kampf hier endlich ein Ende<nbsp>...
#. fr: On touche enfin au but...
#. speaker: A7
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_A7_000_002_NONE_VOICE:1"
msgid "The end is finally in sight."
msgstr ""

#. ja: それで水晶公の願いも叶うのか？
#. de: Wirst du dann erreicht haben, was du dir vorgenommen hast?
#. fr: Est-ce vraiment ce que vous voulez<nbsp>?
#. speaker: A7
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_A7_000_003_NONE_VOICE:1"
msgid "When the Warden is dead, will your work finally be done?"
msgstr ""

#. ja: そのとおり、必ず勝つさ。<br>私が召喚した人は、誰よりも強い英雄なのだから。
#. de: Daran habe ich keinen Zweifel. Schließlich rief ich <if $gn4>die stärkste<else>den stärksten</if> aller Helden herbei.
#. fr: Je n'en ai jamais douté. Car je sais que <if $gn4>celle<else>celui</if> que j'ai invoqué<if $gn4>e</if> est <if $gn4>la plus grande des héroïnes<else>le plus grand des héros</if><nbsp>!
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003490_MYSTERYVOICE:1"
msgid "Of that I have no doubt. Even if I had my pick of every reflection's heroes, I could not have asked for a finer champion."
msgstr ""

#. ja: 本当に……おつかれさま。<br>せめて今は、ゆっくり休んでくれ。
#. de: Ich weiß, es ist hart. Deswegen ist es am besten, wenn du dich jetzt noch etwas ausruhst.
#. fr: Tu t'es vraiment bien battu<if $gn4>e</if> jusqu'ici. Tu as mérité un peu de repos.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003500_MYSTERYVOICE:1"
msgid "Indeed it is. But for now put all such concerns from your mind."
msgstr ""

#. ja: ……ああ、叶うさ。<br>この世界から光を掃えれば、私の大事な民が助かる。<br>もちろん、私が特別に助けたかった人も。
#. de: Ja, in der Tat. Wenn wir das Licht zurückdrängen, sind meine Leute gerettet. Und noch jemand, den ich unbedingt retten möchte.
#. fr: Oui, car chasser la Lumière de ce monde soulagera ses habitants. En particulier ceux que je voulais aider plus que tout.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003510_MYSTERYVOICE:1"
msgid "Yes, I believe it will. Once the tyranny of light is ended, the people of the Crystarium will be safe, and the future that must be shall come to pass."
msgstr ""

#. ja: では……急に邪魔をして悪かった。<br>のちほど、また会おう。
#. de: Also dann, entschuldige nochmals die plötzliche Störung. Wir sehen uns in Kürze.
#. fr: Bref... toutes mes excuses pour le dérangement. Nous nous reverrons bientôt.
#. speaker: MYSTERYVOICE
msgctxt "cut_scene/050/VoiceMan_05003:TEXT_VOICEMAN_05003_003520_MYSTERYVOICE:1"
msgid "I'll not keep you from your rest any longer. Take as much time as you like."
msgstr ""
