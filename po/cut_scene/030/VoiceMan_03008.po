# cut_scene/030/VoiceMan_03008 · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: イシュガルド教皇代行として<br>神殿騎士団総長 アイメリク卿が条約に署名された
#. de: Großmeister Aymeric, der Kommandant der Tempelritter, hat die Urkunde im Namen Ishgards gezeichnet.
#. fr: Que tous ceux présents attestent que sire Aymeric, agissant au nom de l'Archevêque, a ajouté ici sa signature.
#. speaker: NANAMO
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000010_NANAMO:1"
msgid "Let all here present attest that Ser Aymeric, acting on<br>behalf of the archbishop, has appended his signature."
msgstr ""

#. ja: 今 ここに宣言する！
#. de: Hiermit verkünde ich ...
#. fr: Je déclare par conséquent...
#. speaker: NANAMO
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000020_NANAMO:1"
msgid "I do hereby declare..."
msgstr ""

#. ja: 今日この日をもって 山の都「イシュガルド」は<br>エオルゼア都市軍事同盟に復帰した
#. de: ... dass Ishgard mit dem heutigen Tage erneut als Mitglied in die Eorzäische Allianz aufgenommen ist!
#. fr: ... qu'à partir de ce jour même, le Saint-Siège d'Ishgard sera de nouveau considéré membre de l'Alliance éorzéenne.
#. speaker: NANAMO
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000030_NANAMO:1"
msgid "That from this day forth, the Holy See of Ishgard<br>shall once more be counted a member of the Eorzean Alliance."
msgstr ""

#. ja: 来たるべきガレマール帝国との決戦に備え<br>再び友邦として ともに歩まん！
#. de: Lasst unsere Völker vereint voranschreiten und dem Garleischen Reich mutig die Stirn bieten!
#. fr: Puissent nos nations aller de l'avant, et se dresser ensemble et unies contre l'agresseur garlemaldais<nbsp>!
#. speaker: NANAMO
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000040_NANAMO:1"
msgid "Let our nations move forward as one,<br>and stand united against the Garlean Empire!"
msgstr ""

#. ja: すべてはエオルゼアのために！
#. de: Für die Zukunft Eorzeas!
#. fr: Pour le futur d'Éorzéa<nbsp>!
#. speaker: AYMERIC
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000050_AYMERIC:1"
msgid "For the future of Eorzea!"
msgstr ""

#. ja: すべてはエオルゼアのために！
#. de: Für die Zukunft Eorzeas!
#. fr: Pour le futur d'Éorzéa<nbsp>!
#. speaker: RAUBAHNMERLWYBKANESENNA
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000060_RAUBAHNMERLWYBKANESENNA:1"
msgid "For the future of Eorzea!"
msgstr ""

#. ja: ここにいたのか
#. de: Da bist du ja.
#. fr: Vous voilà.
#. speaker: ALPHINAUD
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000070_ALPHINAUD:1"
msgid "There you are."
msgstr ""

#. ja: 君からオルシュファン卿への手向けなのだね
#. de: Für unseren Freund, nicht wahr?
#. fr: Ah... Que voici un noble hommage à notre ami.
#. speaker: ALPHINAUD
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000080_ALPHINAUD:1"
msgid "A noble monument to a noble soul."
msgstr ""

#. ja: オルシュファン様は きっとここから<br>イシュガルドを守り続けてくれるでっすよ
#. de: Ich bin sicher, dass Haurchefant von hier aus immer über Ishgard wachen wird.
#. fr: Sire Haurchefant continuera de veiller sur Ishgard d'ici, j'en suis sûre.
#. speaker: TATARU
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000090_TATARU:1"
msgid "From here, Lord Haurchefant can watch over all of Ishgard..."
msgstr ""

#. ja: 長い旅だった<br>失ったものも大きく 辛い旅路だった
#. de: Es war eine unendlich lange Reise voller Strapazen und tragischer Verluste ...
#. fr: Notre voyage a été long et ardu. Nous avons perdu tant de choses sur notre route.
#. speaker: ALPHINAUD
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000100_ALPHINAUD:1"
msgid "It has been a long and arduous journey.<br>And we have lost much and more along the way."
msgstr ""

#. ja: でも 私たちは決して歩みを止めてはいけない
#. de: ... aber komme, was da wolle, wir werden auf keinen Fall stehen bleiben.
#. fr: Mais quoi qu'il advienne, nous devons rester fidèles à notre cause et aller de l'avant.
#. speaker: ALPHINAUD
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000110_ALPHINAUD:1"
msgid "Yet come what may, we must stay true to our purpose and press on."
msgstr ""

#. ja: そうでっす！<br>おふたりともこれからでっすよ 「暁」の本当の復活は！
#. de: Ja, genau! Schließlich müssen wir alle zusammen den Bund der Morgenröte wieder aufbauen!
#. fr: Oui, vous avez raison<nbsp>! Il est grand temps de remettre sur pied les Héritiers de la Septième Aube<nbsp>!
#. speaker: TATARU
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000120_TATARU:1"
msgid "That's right, you two! It's high time<br>we got back to rebuilding the Scions!"
msgstr ""

#. ja: まずは 活動資金集めからでっす！
#. de: Und dazu brauchen wir Geld - viel Geld!
#. fr: Et pour ça, nous allons avoir besoin d'argent, de beaucoup d'argent<nbsp>!
#. speaker: TATARU
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000130_TATARU:1"
msgid "Which means we're going to need money─and lots of it!"
msgstr ""

#. ja: こうして ひとつの物語の幕が閉じた
#. de: Und so geht ein bedeutendes Kapitel zu Ende ...
#. fr: Ainsi s'achève ce chapitre de leur histoire.
#. speaker: EDMONT
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000140_EDMONT:1"
msgid "So ends a glorious chapter in their tale."
msgstr ""

#. ja: この先も イシュガルドの動揺はしばし続くだろう
#. de: Ishgard aber erwartet eine Zeit großer Umbrüche ...
#. fr: Néanmoins, de nombreux tumultes s'annoncent encore pour Ishgard.
#. speaker: EDMONT
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000150_EDMONT:1"
msgid "However, tumultuous days yet lie ahead for Ishgard."
msgstr ""

#. ja: 千年に渡って続いた 教皇による統治の終焉は<br>この国の有り様を 覆したのだ
#. de: Die Abkehr vom Papsttum nach tausend Jahren kirchlicher Herrschaft stellt das Volk vor eine schwere Aufgabe.
#. fr: Après avoir été régi un millier d'années par l'Église, le peuple s'apprête à faire ses premiers pas dans l'inconnu.
#. speaker: EDMONT
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000160_EDMONT:1"
msgid "After a thousand years under the yoke of the church,<br>the people take their first tentative steps into the unknown."
msgstr ""

#. ja: ドラゴン族との戦いも終わったわけではない<br>邪竜の脅威は 未だ残っている
#. de: Auch die Fehde mit den Drachen ist noch lange nicht beigelegt, denn Nidhoggs Hass brennt weiter, ungestillt.
#. fr: Et bien qu'un espoir de paix soit né, l'ombre malveillante de Nidhogg<br>continue de planer dan<shy>ge<shy>reu<shy>se<shy>ment dans les cieux.
#. speaker: EDMONT
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000170_EDMONT:1"
msgid "And though they spy a glimmer of peace upon the horizon,<br>Nidhogg's vengeful shadow yet remains to darken the way."
msgstr ""

#. ja: だが――
#. de: Und dennoch ...
#. fr: Malgré cela...
#. speaker: EDMONT
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000180_EDMONT:1"
msgid "Be that as it may..."
msgstr ""

#. ja: 若き神殿騎士団総長と頼もしき盟友たち<br>そして 光を取り戻した英雄がいるかぎり
#. de: So lange der junge Großmeister der Tempelritter und seine loyalen Vertrauten das Volk führen, besteht Hoffnung ...
#. fr: Tant qu'Aymeric, jeune capitaine général des templiers, et ses fidèles compagnons seront là<br>pour veiller sur leur cité, les gens pourront garder espoir...
#. speaker: EDMONT
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000190_EDMONT:1"
msgid "So long as the young commander of the Temple Knights<br>and his heroic companions are there to guide them,<br>the people may hold fast to hope─"
msgstr ""

#. ja: いつの日か かつてそうだったように<br>真の平和が訪れ 人と竜との融和がなされると信じている
#. de: Hoffnung, dass eines Tages der Friede wieder Einzug halten wird und Drachen und Ishgarder in Harmonie zusammenleben.
#. fr: Celui qu'un jour, Ishgard connaîtra une paix réelle,<br>et que les hommes et les dragons oublieront la guerre pour vivre à nouveau en harmonie.
#. speaker: EDMONT
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000200_EDMONT:1"
msgid "the hope that, one day, true peace will return to Ishgard,<br>and that man and dragon may live in harmony once more."
msgstr ""

#. ja: 我々は それを紡がねばならない
#. de: <i>Wir</i> müssen diese Zukunft herbeiführen.
#. fr: Puissent les faits relatés ici n'être jamais oubliés...
#. speaker: EDMONT
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000210_EDMONT:1"
msgid "Let the deeds writ herein never be forgot,"
msgstr ""

#. ja: 次の千年に続く 新たな竜詩の始まりとして――
#. de: Eine neue Ära, die uns immer weiter streben lässt  - himmelwärts.
#. fr: ... et les générations futures qui les liront s'en inspirer pour aller toujours plus haut vers les cieux.
#. speaker: EDMONT
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_000220_EDMONT:1"
msgid "that they may inspire generations yet unborn to strive ever heavensward."
msgstr ""

#. ja: <ui-color 547>ラハブレアとイゲオルムが散ったか……。</ui-color>
#. de: (-Elidibus-)<ui-color 547>Lahabrea und Igeyorhm sind gefallen ...</ui-color>
#. fr: (-Elidibus-)<ui-color 547>Lahabrea et Igeyorhm ne sont plus.</ui-color>
#. speaker: ELIDIBUS
#. macro: <ui-color 547> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 547 (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_100010_ELIDIBUS:1"
msgid "(-Elidibus-)<ui-color 547>So Lahabrea and Igeyorhm have fallen.</ui-color>"
msgstr ""

#. ja: <ui-color 547>八度目の「次元圧壊」を狙ったようだが、<br>どうやら、ヒトの可能性を見誤ったらしい。</ui-color>
#. de: (-Elidibus-)<ui-color 547>Übertölpelt von einer Handvoll Sterblicher. Und die Achte Nova, die sie auslösen wollten, ist nicht eingetreten.</ui-color>
#. fr: (-Elidibus-)<ui-color 547>Vaincus par des mortels dans leur tentative de provoquer la huitième Réunion... Ils se sont laissé aveugler par leur arrogance et ont payé le prix capital pour cette raison.</ui-color>
#. speaker: ELIDIBUS
#. macro: <ui-color 547> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 547 (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_100020_ELIDIBUS:1"
msgid "(-Elidibus-)<ui-color 547>Bested by mortals in their attempt to initiate the eighth Rejoining. That they should be so complacent...</ui-color>"
msgstr ""

#. ja: <ui-color 547>とはいえ、嗤ってばかりもいられぬか……。</ui-color>
#. de: (-Elidibus-)<ui-color 547>Aber ich sollte nicht spotten. Letztlich fällt ihr Versagen auf uns alle zurück.</ui-color>
#. fr: (-Elidibus-)<ui-color 547>Et c'est désormais à moi de m'occuper des con<shy>sé<shy>quen<shy>ces...</ui-color>
#. speaker: ELIDIBUS
#. macro: <ui-color 547> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 547 (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_100030_ELIDIBUS:1"
msgid "(-Elidibus-)<ui-color 547>And now it falls to me to deal with the consequences...</ui-color>"
msgstr ""

#. ja: <ui-color 547>このまま光と闇の均衡が失われれば、<br>世界をあるべき姿に戻すという、我らの宿願が破綻しかねん。</ui-color>
#. de: (-Elidibus-)<ui-color 547>Wenn das Gleichgewicht zwischen Licht und Dunkelheit noch weiter verschoben wird, ist unsere Mission ernsthaft gefährdet.</ui-color>
#. fr: (-Elidibus-)<ui-color 547>Si rien n'est fait, l'équilibre entre la Lumière et les Ténèbres sera rompu. Notre mission pourrait être sévèrement compromise.</ui-color>
#. speaker: ELIDIBUS
#. macro: <ui-color 547> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 547 (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_100050_ELIDIBUS:1"
msgid "(-Elidibus-)<ui-color 547>Without intervention, the balance between Light and Darkness will begin to shift, placing our mission in jeopardy.</ui-color>"
msgstr ""

#. ja: <ui-color 547>光の戦士は、力を持ちすぎた。<br>神の領域に近づくほどに……。</ui-color>
#. de: (-Elidibus-)<if $gn4>Die Kriegerin<else>Der Krieger</if> des Lichts besitzt zu viel Kraft. <if $gn4>Sie<else>Er</if> nähert sich dem Göttlichen ...
#. fr: (-Elidibus-)<ui-color 547>L<if $gn4>a<else>e</if> champion<if $gn4>ne</if> d'Hydaelyn est désormais trop fort<if $gn4>e</if>. Son pouvoir rivalise presque avec celui des dieux.</ui-color>
#. speaker: ELIDIBUS
#. macro: <ui-color 547> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 547 (formatting: keep it as often as the source has it)
#. macro: <if $gn4>Her<else>His</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_100060_ELIDIBUS:1"
msgid "(-Elidibus-)<ui-color 547>Hydaelyn's champion has grown too strong. <if $gn4>Her<else>His</if> might encroaches upon the realm of gods.</ui-color>"
msgstr ""

#. ja: <ui-color 547>だからこそ、お前たちの出番なのだ。</ui-color>
#. de: (-Elidibus-)<ui-color 547>Deshalb muss deine Schar eingreifen ...</ui-color>
#. fr: (-Elidibus-)<ui-color 547>L'équilibre doit être rétabli. Le temps est venu pour toi et les tiens d'entrer dans la bataille...</ui-color>
#. speaker: ELIDIBUS
#. macro: <ui-color 547> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 547 (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_100070_ELIDIBUS:1"
msgid "(-Elidibus-)<ui-color 547>Equilibrium must needs be restored. The time is come for you and yours to join the fray...</ui-color>"
msgstr ""

#. ja: <ui-color 547>闇の戦士よ……。</ui-color>
#. de: (-Elidibus-)<ui-color 547>Krieger der Dunkelheit ...</ui-color>
#. fr: (-Elidibus-)<ui-color 547>... Guerrier des Ténèbres.</ui-color>
#. speaker: ELIDIBUS
#. macro: <ui-color 547> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 547 (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_100080_ELIDIBUS:1"
msgid "(-Elidibus-)<ui-color 547>...Warrior of Darkness.</ui-color>"
msgstr ""

#. ja: やれやれ……<br>一難去って、また一難とはこのことだぜ。
#. de: Ahhh! Kann mir einer sagen, wann ich <i>jemals</i> eine ruhige Minute haben werde?!
#. fr: Dis-moi, n'a-t-on jamais le droit à un moment de répit<nbsp>?
#. speaker: CID
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_200010_CID:1"
msgid "Remind me: why is there no rest for the righteous?"
msgstr ""

#. ja: まったくだわ……。
#. de: In absehbarer Zeit wohl nicht ...
#. fr: Certainement pas dans notre domaine<nbsp>!
#. speaker: YSHTOLA
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_200020_YSHTOLA:1"
msgid "Because they <i>care</i>, Master Garlond."
msgstr ""

#. ja: 馬鹿野郎が、あんなもんを動かしやがって……。<br>アイツは玩具なんかじゃねぇ……蛮神なんだぞ……！！
#. de: Diese Wichte müssen aber auch alles in Gang setzen, was sie finden! Ein Primae ist kein Spielzeug!
#. fr: N'avaient-ils rien d'autre avec quoi s'occuper, ceux-là<nbsp>?<nbsp>... Ce n'est pas un jouet, pauvres fous<nbsp>! C'est un Primordial<nbsp>!
#. speaker: CID
msgctxt "cut_scene/030/VoiceMan_03008:TEXT_VOICEMAN_03008_200030_CID:1"
msgid "Of all the things they could have picked to play with... That's not a toy, you bloody fools─it's a primal!"
msgstr ""
