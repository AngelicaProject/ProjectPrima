# cut_scene/030/VoiceMan_03007 · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 来たな……ついに完成したぜ。<br>新たに生まれ変わった「エンタープライズ」……
#. de: Hier, seht nur! Sie ist so umfassend verbessert, dass ich ihr einen neuen Namen gegeben habe ...
#. fr: Ah, vous arrivez au bon moment<nbsp>! Nous venons juste de terminer nos travaux sur l'Entreprise. Nous lui avons apporté tellement d'améliorations que j'ai décidé de lui donner un nouveau nom.
#. speaker: CID
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_000010_CID:1"
msgid "Ah, excellent timing! We've just finished our work on the <i>Enterprise</i>. She's so much improved, I've decided to give her a new name to suit:"
msgstr ""

#. ja: ……いや、「エンタープライズ・エクセルシオ」だ！
#. de: Die „<i>Enterprise Excelsior</i>“! ... Oder einfach „<i>Excelsior</i>“, wenn euch das zu lang ist.
#. fr: L'Entreprise Excelsior<nbsp>! Ha ha ha<nbsp>! Ou pour faire plus court<nbsp>: l'Excelsior. Qu'est-ce que vous en pensez, ça en jette, non<nbsp>?
#. speaker: CID
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_000020_CID:1"
msgid "The <i>Enterprise Excelsior</i>! Or simply the <i>Excelsior</i>, if pressed for time."
msgstr ""

#. ja: 俺たちの新たな翼で、<br>お前たちを、決戦の地に送り届けてやるぜ。
#. de: Sie wird euch an den Ort der großen Konfrontation bringen ...
#. fr: Une fois de plus, cet aéronef va conduire les protecteurs d'Éorzéa vers la bataille<nbsp>!
#. speaker: CID
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_000030_CID:1"
msgid "Once again, she'll carry Eorzea's protectors into battle!"
msgstr ""

#. ja: さあ、乗船するッス！
#. de: Also dann, alle Mann an Bord!
#. fr: Tout le monde à bord<nbsp>!
#. speaker: WEDGE
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_000040_WEDGE:1"
msgid "All aboard!"
msgstr ""

#. ja: 英雄殿……。<br>私には、こうやって貴殿を見送ることしかできない。
#. de: Ab hier muss ich euch alleine ziehen lassen.
#. fr: Je ne peux que vous souhaiter bonne chance et prier pour votre salut.
#. speaker: EDMONT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_000050_EDMONT:1"
msgid "I can do no more than see you off with prayers for your safety and success."
msgstr ""

#. ja: しかし、我が息子オルシュファンの想いは、<br>常に貴方とともにある……どうか、ご武運を！
#. de: Aber meine Gebete werden euch begleiten - und ich bin sicher, dass auch Haurchefant im Geiste bei euch sein wird. Viel Glück.
#. fr: Où que vous alliez, sachez que l'âme de mon fils sera toujours avec vous.<br>Que la Conquérante vous donne sa force<nbsp>!
#. speaker: EDMONT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_000060_EDMONT:1"
msgid "Yet know that wheresoever you may go, my son's spirit goes with you. May the Fury grant you strength!"
msgstr ""

#. ja: 帰って来るのだぞ、必ず……！
#. de: Möge eure Mission von Erfolg gekrönt sein!
#. fr: Je compte sur vous pour tous nous revenir<nbsp>!
#. speaker: AYMERIC
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_000070_AYMERIC:1"
msgid "Return to us─all of you!"
msgstr ""

#. ja: 「エンタープライズ・エクセルシオ」、発進！
#. de: Also dann - Abflug!
#. fr: Excelsior, en route<nbsp>!
#. speaker: CID
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_000080_CID:1"
msgid "<i>Enterprise Excelsior</i>...engage!"
msgstr ""

#. ja: いよいよだ、準備はいいな！
#. de: Gleich ist es so weit, Leute!
#. fr: Nous y sommes<nbsp>! Préparez-vous<nbsp>!
#. speaker: CID
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100010_CID:1"
msgid "This is it! Get ready!"
msgstr ""

#. ja: 「眼」の力を解放する……！
#. de: Zeig mir deine Kraft, Auge!
#. fr: Œil de mon ennemi<nbsp>! Donne-moi ton pouvoir<nbsp>!
#. speaker: ESTINIEN
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100020_ESTINIEN:1"
msgid "Eye of mine enemy! Render unto me thy power!"
msgstr ""

#. ja: グッ……なんという力……。<br>黙っていろ……貴様の主は、この俺だ……！
#. de: Ahnng ... Du wirst <i>mir</i> gehorchen ...! <i>Ich</i> bin dein Meister!
#. fr: Argh... Non... Tu ne m'auras pas<nbsp>!
#. speaker: ESTINIEN
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100030_ESTINIEN:1"
msgid "Ugh... No... You will not claim me! I am the master!"
msgstr ""

#. ja: うおおおおおおッ！
#. de: Yaaaahaaaaaaaarr!
#. fr: Ouuuaaaarrrgh<nbsp>!
#. speaker: CID
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100040_CID:1"
msgid "Yaaaaaargh!"
msgstr ""

#. ja: 抜けたぞッ！！
#. de: Wir sind durch!
#. fr: Ça a marché<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100050_ALPHINAUD:1"
msgid "We're through!"
msgstr ""

#. ja: こ、後方に帝国軍アグリウス級飛空戦艦ッ！
#. de: Ich glaub, mein Schweinchen pfeift! Die Garlear!
#. fr: Patron<nbsp>! Nous avons un aéronef impérial aux fesses<nbsp>! Et il est... vachement gros<nbsp>!
#. speaker: BIGGS
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100060_BIGGS:1"
msgid "Chief! We've got an imperial battleship on our tail! And it's bleedin' <i>massive</i>!"
msgstr ""

#. ja: クソッ！<br>奴らめ、俺たちがフィールドを突破するのを、<br>待っていたってわけか！
#. de: Verflucht noch mal! Die haben bloß darauf gewartet, dass wir ihnen den roten Teppich ausrollen!
#. fr: Merde<nbsp>! Ces salauds ont sûrement guetté notre venue pour profiter du passage<nbsp>!
#. speaker: CID
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100070_CID:1"
msgid "Damn it! The bastards were waiting for us to open the door for them!"
msgstr ""

#. ja: 振り切るぞ、みんな掴まれ！
#. de: Die schütteln wir schon ab. Haltet euch fest!
#. fr: Je vais essayer de les semer<nbsp>! Accrochez-vous<nbsp>!
#. speaker: CID
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100080_CID:1"
msgid "I'm going to try to shake them! Hang on to something!"
msgstr ""

#. ja: うわあああああ！！<br>当たる、当たる、当たっちゃうッス！<br>……タタルさん、助けて！
#. de: Uuuuuaaaaahhhh! Gleich schießen sie uns ab! Tataruuu!
#. fr: Ouaaaah<nbsp>! Nous allons tous mourir<nbsp>! Tataruuuu<nbsp>!
#. speaker: WEDGE
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100090_WEDGE:1"
msgid "Uwaaaaaah! We're all going to die! Tataruuu!"
msgstr ""

#. ja: クソッ、このままじゃ……！
#. de: Verdammt, das halten wir nicht mehr lange durch!
#. fr: Nous n'allons pas pouvoir tenir longtemps<nbsp>!
#. speaker: BIGGS
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100100_BIGGS:1"
msgid "She won't take much more of this!"
msgstr ""

#. ja: かつて星の意思から授かった、光のクリスタル……。<br>……今こそ使う時か。
#. de: (-???-)Die Zeit ist gekommen, dein Geschenk einzusetzen, Hydaelyn ...
#. fr: Le temps est venu d'utiliser le don d'Hydaelyn.
#. speaker: ICEHEART
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100110_ICEHEART:1"
msgid "The time is come to use Hydaelyn's gift."
msgstr ""

#. ja: これまで、自分の主我のために、多くの犠牲を出してきた。<br>結局私は、凍えた身体を温めるための、仲間が欲しかったのだ……<br>そのために、大義を創った。
#. de: Für all die Opfer, die mein einfältiger Glaube an meine selbsterschaffene Gerechtigkeit forderte ...
#. fr: Tant de sang a été répandu en mon nom... Et pourquoi<nbsp>? Une cause créée de toutes pièces par moi-même afin d'assouvir mon désir de chaleur et de camaraderie.
#. speaker: ICEHEART
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100120_ICEHEART:1"
msgid "Much blood has been spilled in my name. And for what? For a false cause that I created for want of the warmth of companionship."
msgstr ""

#. ja: 許して、シヴァ。<br>……そして、フレースヴェルグ。
#. de: Shiva ... Hraesvelgr - Bitte verzeiht mir ...
#. fr: Sainte Shiva, Hraesvelgr... Pardonnez-moi...
#. speaker: ICEHEART
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100130_ICEHEART:1"
msgid "Saint Shiva...Hraesvelgr... Pray forgive this fool."
msgstr ""

#. ja: それでも私は、どうしても見てみたい……。<br>少女が雪原のただ中で、凍えずとも済む時代をッ！
#. de: Selbst jetzt wünsche ich mir nur, dass all die kalten Herzen sich erwärmen ... in einer Zeit des wahren Friedens.
#. fr: Pourtant, je ne peux abandonner mon rêve... Un jour viendra où plus aucun enfant ne tremblera de froid seul dans la neige...
#. speaker: ICEHEART
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100140_ICEHEART:1"
msgid "But even now, I cannot let go of my dream─my dream of a tomorrow in which no child need freeze alone in the snow."
msgstr ""

#. ja: ありがとう フレースヴェルグ
#. de: Danke, Hraesvelgr.
#. fr: Merci, Hraesvelgr.
#. speaker: ICEHEART
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100150_ICEHEART:1"
msgid "Thank you, Hraesvelgr."
msgstr ""

#. ja: あれは イゼル？<br>何をするつもりだ！！
#. de: Ist ... Ist das Ysayle?! Was hat sie vor?
#. fr: Mais... c'est Ysayle<nbsp>! Que cherche-t-elle à faire<nbsp>!?
#. speaker: ALPHINAUD
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100160_ALPHINAUD:1"
msgid "Is that...Ysayle? What does she mean to do!?"
msgstr ""

#. ja: 聖女シヴァ――<br>いえ 願いによって造られた 私自身の神よ！
#. de: Oh Göttin, Geschöpf meiner Wünsche und Träume - noch einmal bitte ich dich!
#. fr: Ô Déesse née de mes espoirs et de mes rêves... J'en appelle à vous une dernière fois<nbsp>!
#. speaker: ICEHEART
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100170_ICEHEART:1"
msgid "O goddess born of mine own hopes and dreams.<br>For the last time, I beseech you!"
msgstr ""

#. ja: 今こそ我が身に降りて<br>真の融和のために 最期の静寂を！
#. de: Erfülle meinen Körper mit göttlicher Kraft, o Shiva! Für den wahren, immerwährenden Frieden!
#. fr: Baignez mon être dans votre lumière<nbsp>! Apaisez la haine dans nos cœurs et apportez-nous la grâce éternelle<nbsp>!
#. speaker: ICEHEART
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100180_ICEHEART:1"
msgid "Fill this vessel with your light! Still the hatred<br>within our hearts and bless us with eternal grace!"
msgstr ""

#. ja: さらばだ 光の戦士<br>私を導いてくれて ありがとう
#. de: Leb wohl, <if $gn4>Kriegerin<else>Krieger</if> des Lichts! Du hast mir den Weg gezeigt.
#. fr: Adieu, Guerri<if $gn4>ère<else>er</if> de la Lumière. Je te remercie de m'avoir montré la voie.
#. speaker: ICEHEART
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100190_ICEHEART:1"
msgid "Farewell, Warrior of Light. And thank you─for showing me the way."
msgstr ""

#. ja: イゼル…………！！
#. de: Ysayle!
#. fr: Non<nbsp>!!
#. speaker: ALPHINAUD
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100200_ALPHINAUD:1"
msgid "NOOOOOO!"
msgstr ""

#. ja: あのエーテル……あれは、光のクリスタル……。
#. de: Dieser Äther ...! Sie hat einen Lichtkristall benutzt ...
#. fr: Cet éther... C'était un cristal de Lumière.
#. speaker: YSHTOLA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100210_YSHTOLA:1"
msgid "This aether... It was a Crystal of Light."
msgstr ""

#. ja: 彼女もまた、間違いなく、<br>ハイデリンに導かれた光の戦士だったのね……。
#. de: Auch sie war geführt von Hydaelyn ...
#. fr: Elle aussi était une protégée d'Hydaelyn.
#. speaker: YSHTOLA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100220_YSHTOLA:1"
msgid "She, too, was one of Hydaelyn's chosen..."
msgstr ""

#. ja: ……さらばだ、「氷の巫女」よ。
#. de: Ruhe in Frieden, Eisherz.
#. fr: Repose en paix, Cœur-de-glace.
#. speaker: ESTINIEN
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_100230_ESTINIEN:1"
msgid "Fare you well, my lady."
msgstr ""

#. ja: 艦内でも説明したとおり、<br>これより、我々は魔大陸中枢に向かう。
#. de: Noch einmal: Unser Ziel liegt im Zentrum von Azys Lla.
#. fr: Notre objectif est au cœur de cette île.
#. speaker: REGULA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_200010_REGULA:1"
msgid "Our objective lies at the heart of the isle."
msgstr ""

#. ja: 第III歩兵中隊は、艦の護衛のため、この場に残れ。<br>第II歩兵中隊は散開し、アラグの防衛兵器を排除せよ。
#. de: Die Dritte Einheit bleibt hier und bewacht das Schiff. Die Zweite schwärmt aus und beseitigt die allagischen Fallen.
#. fr: La Troisième compagnie va rester en arrière pour protéger l'aéronef, pendant que la Deuxième va se disperser et neutraliser les mécanismes de défense allagois.
#. speaker: REGULA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_200020_REGULA:1"
msgid "The Third will remain to guard the ship, while the Second patrols the perimeter and eliminates any threats."
msgstr ""

#. ja: 第I歩兵中隊は、我に続き、<br>「魔科学研究所」の制圧を目指す。
#. de: Die Erste Einheit kommt mit mir. Wir sichern das For<shy>schungs<shy>labor.
#. fr: La Première va m'accompagner pour prendre le contrôle du Laboratoire de magismologie.
#. speaker: REGULA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_200030_REGULA:1"
msgid "The First will come with me to secure the research facility."
msgstr ""

#. ja: いいか、パラメキア諜報機関からの報告によると、<br>この「魔大陸」には、蛮神を生きたまま捕らえる、<br>アラグの秘術が眠っているという。
#. de: Wenn die Informationen des Frumentariums stimmen, finden wir dort die Antwort darauf, wie die Allager es schafften, Primae lebendig zu fesseln.
#. fr: Notre mission est de la plus haute importance. Les Allagois avaient découvert un moyen de capturer les Primordiaux vivants, et leur savoir est caché sur cette île.
#. speaker: REGULA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_200040_REGULA:1"
msgid "Let no man doubt the import of our mission: the Allagans found a means to capture eikons alive, and their knowledge lies hid upon this isle."
msgstr ""

#. ja: 星を蝕む病魔は、蛮族どもの願いで何度でも蘇る。<br>だが、封じてしまえば、それも叶わぬこととなるだろう。<br>その意義の大きさを肝に銘じておけ。
#. de: Diese ätherfressenden Parasiten gilt es auszumerzen, das ist unsere oberste Weisung. Der Wahn ihrer missgeleiteten Lakaien hat sie bisher wieder und wieder auferstehen lassen.
#. fr: En l'acquérant, nous serons capables d'empêcher ces entités de revenir nous menacer et nous mettrons un terme à leur cycle de renaissance.
#. speaker: REGULA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_200050_REGULA:1"
msgid "If we can but acquire it, we would be able to prevent the beings from returning to plague us, thus ending the cycle of rebirth."
msgstr ""

#. ja: これは本国に帰還された皇帝陛下に、<br>我ら第VI軍団の実力を示す、またとない好機でもある！
#. de: Wenn wir aber das Geheimnis der Allager herausfinden, können wir den Kreislauf ihrer Wiedergeburt durchbrechen ... und uns den ewigen Dank des Kaisers sichern!
#. fr: Je n'ai pas besoin de vous rappeler que notre réussite permettra à notre légion de se hisser haut dans l'estime de l'Empereur. Qui plus est, Sa Majesté ne tolère aucun échec.
#. speaker: REGULA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_200060_REGULA:1"
msgid "I need not remind you that success will raise our legion high in the Emperor's regard."
msgstr ""

#. ja: だが、皇帝陛下は、敗北をお許しにならぬ御方……<br>己が手で、必ずや陛下の重畳を賜るのだッ！！
#. de: Doch so großzügig der Kaiser Erfolge belohnt, so wenig verzeiht er Niederlagen. Sorgen wir dafür, dass wir mit der richtigen Nachricht vor seinen Thron treten können!
#. fr: Que toutes les compagnies se préparent à se déployer<nbsp>!
#. speaker: REGULA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_200070_REGULA:1"
msgid "Yet, by the same token, His Radiance does not tolerate failure. That is all. All troops, prepare for deployment!"
msgstr ""

#. ja: 蛮神を封じる技術……。<br>それが、帝国軍の狙いなのね。
#. de: Das Wissen, wie man Primae lebendig fesselt! Darauf haben es die Garlear also abgesehen.
#. fr: C'est donc ça, leur objectif...
#. speaker: YSHTOLA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_200080_YSHTOLA:1"
msgid "So that is their purpose."
msgstr ""

#. ja: 古の蛮神「バハムート」を封じた技術が、<br>ここに残されているということか……。
#. de: Dann liegt hier auch die Antwort auf die Frage verborgen, wie die Allager Bahamut in ihren künstlichen Mond bannen konnten.
#. fr: Et dire que la technologie qui a permis de capturer Bahamut est cachée ici...
#. speaker: ALPHINAUD
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_200090_ALPHINAUD:1"
msgid "To think that the knowledge used to bind no less a being than Bahamut sleeps here..."
msgstr ""

#. ja: 蛮神を封印できれば、確かに再召喚は防げるわ。<br>蛮神問題に対する、ひとつの解法ともいえなくもない……。
#. de: So könnte man wohl tatsächlich verhindern, dass ein Primae erneut beschworen wird ... Vielleicht ist das die Lösung, nach der wir so lange gesucht haben ...!
#. fr: Emprisonner un Primordial de cette façon est assurément un moyen d'arrêter le cycle des invocations... À condition de ne pas se soucier des risques, bien sûr.
#. speaker: YSHTOLA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_200100_YSHTOLA:1"
msgid "Imprisoning a primal in such a manner would represent an effective means to halt the cycle of summoning─were it not for the grave and obvious risks."
msgstr ""

#. ja: いいや、答えはすでに出ているよ、ヤ・シュトラ。<br>バハムートは蘇り、絶望が世を包み、世界は崩壊しかけたんだ。<br>「第七霊災」を忘れたわけではないだろう？
#. de: Nein, Y'shtola, das kann nicht die Lösung sein. Denk doch daran, welches Leid Bahamut über Eorzea gebracht hat. Wir dürfen die Siebte Katastrophe niemals vergessen.
#. fr: En effet. Il nous suffit de voir ce qui s'est déjà produit, notamment le retour destructeur de Bahamut, pour comprendre que ce n'est pas la solution que nous souhaitons.
#. speaker: ALPHINAUD
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_200110_ALPHINAUD:1"
msgid "Indeed. We need but refer to past experience─that of Bahamut's calamitous return─to see why this is not the solution we seek."
msgstr ""

#. ja: 封じられた蛮神は、負の感情を膨らませ続け、<br>やがて、大いなる災いを引き起こすということね。
#. de: Hm, du hast wohl Recht. Eine so lange Zeit in Gefangenschaft lässt den Hass eines jeden Wesens ins Unermessliche wachsen ... das Risiko ist zu groß.
#. fr: Même en captivité, ces êtres continuent de nourrir leur haine pour le genre humain. Et inévitablement, lorsqu'ils retrouvent leur liberté, leur colère devient in<shy>con<shy>trô<shy>la<shy>ble.
#. speaker: YSHTOLA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_200120_YSHTOLA:1"
msgid "Held in duress, a primal will continue to nurse its hatred for mankind. And when it inevitably breaks free, its rage will be beyond quelling."
msgstr ""

#. ja: 目下の問題は、教皇の方だ。<br>今の状況で帝国と戦ったとして、<br>それを最も喜ぶのは、奴らだからな。
#. de: Unser Ziel ist der Papst. Wenn wir uns <i>jetzt</i> mit den Garlearn anlegen, lacht <i>er</i> sich ins Fäustchen.
#. fr: Peu importe ce que les Garlemaldais mijotent, ils peuvent attendre. Nous devons rester concentrés sur notre mission.
#. speaker: ESTINIEN
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_200130_ESTINIEN:1"
msgid "Whatever folly the Garleans mean to commit, they can wait. We must remain focused on our task."
msgstr ""

#. ja: そうだな、先を急ごう。<br>まずは教皇を止める……帝国はその次だ。
#. de: Ja, natürlich. Erst halten wir ihn auf, danach kümmern wir uns um die Garlear.
#. fr: Exactement. Retrouvons d'abord l'Archevêque.
#. speaker: ALPHINAUD
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_200140_ALPHINAUD:1"
msgid "Yes, of course. It would not be polite to keep the archbishop waiting."
msgstr ""

#. ja: 通信が途絶えた部隊があると思って来てみれば、<br>貴様らだったとはな……。
#. de: Dacht' ich's mir doch. Deswegen kam auf einmal keine Nachricht mehr von meinem Trupp.
#. fr: Voilà qui explique le silence radio de l'unité... Nous nous rencontrons de nouveau.
#. speaker: REGULA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_300010_REGULA:1"
msgid "That would explain my men's silence."
msgstr ""

#. ja: この前は邪魔が入ったが、<br>ひとつお手合わせを願おうじゃないか。
#. de: Beim letzten Mal wurden wir unterbrochen, aber diesmal haben wir viel Zeit füreinander ...
#. fr: Rien ni personne ne viendra nous gêner, cette fois.
#. speaker: REGULA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_300020_REGULA:1"
msgid "We meet again. And this time, we will not be interrupted."
msgstr ""

#. ja: エオルゼアの英雄の実力……<br>見極めさせてもらうぞ！
#. de: Zeig mir doch mal, was <if $gn4>eine Kriegerin<else>einen Krieger</if> des Lichts so besonders macht!
#. fr: Approche, héro<if $gn4>ïne<else>s</if> d'Éorzéa<nbsp>! Montre-moi de quoi tu es fait<if $gn4>e</if><nbsp>!
#. speaker: REGULA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_300030_REGULA:1"
msgid "Come! Show me your power, champions of Eorzea!"
msgstr ""

#. ja: ふむ……。<br>さすがは、英雄と呼ばれるだけのことはある……か。<br>なかなかの戦いぶりだ。
#. de: Gar nicht so übel - fast heldenhaft. Nun scheint mir die Niederlage van Baelsars schon erklärlicher.
#. fr: On m'a beaucoup parlé de ta force, Guerri<if $gn4>ère<else>er</if> de la Lumière. Et maintenant que j'en ai eu une dé<shy>mon<shy>stra<shy>tion, la défaite de van Baelsar me paraît moins inexplicable.
#. speaker: REGULA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_400010_REGULA:1"
msgid "I had heard the tales of your strength, Warrior of Light. And now that I have experienced it firsthand, van Baelsar's defeat seems less inexplicable."
msgstr ""

#. ja: ……さて、こちらの準備が整ったようなのでね。<br>戯れの時間は終いにしよう。
#. de: Tja, es war mir ein Vergnügen, aber nun muss leider Schluss sein. Wenn ich erst die Primae-Technologie in Händen halte, hat mir dieser Ort ohnehin nichts mehr zu bieten.
#. fr: Tu es un<if $gn4>e</if> adversaire ex<shy>cep<shy>tion<shy>nel<if $gn4>le</if>, et j'aurais aimé pouvoir te consacrer plus de temps. Hélas, toutes les bonnes choses ont une fin. J'ai eu ce que je voulais, et par conséquent, je n'ai plus aucune raison de m'attarder ici.
#. speaker: REGULA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_400020_REGULA:1"
msgid "You are a formidable foe, and I have thoroughly enjoyed our time together. Alas, all good things must come to an end. Allagan secrets await, and there is no profit to be had in remaining here."
msgstr ""

#. ja: お前たち、適当に相手をして時間を稼いでおけ！<br>例の秘術さえ手に入れれば、<br>こんなところに用はないのだからな。
#. de: Beschäftigt sie eine Weile, Männer!
#. fr: Vous autres, retenez-les<nbsp>!
#. speaker: REGULA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_400030_REGULA:1"
msgid "Keep them occupied!"
msgstr ""

#. ja: 時間稼ぎか……。
#. de: Er hält uns hin, um Zeit zu gewinnen!
#. fr: Sale couard<nbsp>!<nbsp>...
#. speaker: ESTINIEN
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_400040_ESTINIEN:1"
msgid "Coward..."
msgstr ""

#. ja: こうなったら、やるしかないようね。
#. de: Aber wir haben wohl keine Wahl!
#. fr: On dirait bien que nous n'avons pas le choix.
#. speaker: YSHTOLA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_400050_YSHTOLA:1"
msgid "It would seem we have no choice."
msgstr ""

#. ja: 君は、先に進むんだ。<br>ここは、私たちで持ちこたえる！
#. de: Du läufst weiter. Wir halten sie hier auf!
#. fr: Vous devez continuer. Nous allons les retenir ici.
#. speaker: ALPHINAUD
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_400060_ALPHINAUD:1"
msgid "You must continue on. We will hold them here."
msgstr ""

#. ja: 光の戦士よ、これをお前に預けておく。
#. de: Hier - nimm das. Du wirst es brauchen.
#. fr: Prends l'Œil. Il devrait contenir assez d'énergie pour te servir.
#. speaker: ESTINIEN
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_400070_ESTINIEN:1"
msgid "Take the Eye. It should still hold enough energy to be of use to you."
msgstr ""

#. ja: 「エーテルラム」の起動で、多少消耗はしているが、<br>お守り代わりにでもしていろ。<br>……俺もすぐに向かう。
#. de: Das Durchbrechen der Barriere hat einen Teil seiner Kraft verbraucht, aber vielleicht bringt es dir Glück. Geh schon, ich bin gleich bei dir.
#. fr: Je te rejoins dès que possible.
#. speaker: ESTINIEN
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_400080_ESTINIEN:1"
msgid "I shall join you as soon as I am able."
msgstr ""

#. ja: さあ、おしゃべりもここまでのようよ。<br>早く行って！　行って、教皇を止めなさい！
#. de: Los jetzt! Keine Zeit für lange Reden! Halt den Papst auf!
#. fr: Assez discuté<nbsp>! Dépêche-toi et arrête l'Archevêque<nbsp>!
#. speaker: YSHTOLA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_400090_YSHTOLA:1"
msgid "Enough talk! Make haste and stop the archbishop!"
msgstr ""

#. ja: (-？？？？-)数千年の長きに渡り、閉ざされてきたこの地に、<br>再び人が訪れようとは……何者だ？
#. de: Seit Tausenden von Jahren bin ich an diesem verfluchten Ort gefesselt, vergessen ... Wer kommt nun, um mich zu verspotten?
#. fr: (-???-)Qui ose venir en ce lieu oublié et déranger ma solitude<nbsp>?
#. speaker: TIAMAT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500010_TIAMAT:1"
msgid "(-???-)Who cometh to this forsaken place and disturbeth my solitude?"
msgstr ""

#. ja: 久しいな……。<br>我が子、ティアマットよ。
#. de: Tiamat, meine Tochter ...
#. fr: Tiamat, mon enfant...
#. speaker: MIDGARDSORMR
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500020_MIDGARDSORMR:1"
msgid "Tiamat, my child."
msgstr ""

#. ja: (-ティアマット-)おぉぉぉ……なんということだ、その御姿は……？<br>しかし、確かに貴方はミドガルズオルム、我が父よ。
#. de: (-Tiamat-)Vater! Bist du das?!
#. fr: (-Tiamat-)... Père<nbsp>? Est-ce vraiment toi<nbsp>?
#. speaker: TIAMAT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500030_TIAMAT:1"
msgid "(-Tiamat-)...Father? Can it truly be you?"
msgstr ""

#. ja: 故あって仮初めの幻体に心を移し、<br>この者……ハイデリンの使徒と、ともに旅をしておる。
#. de: Ich bin es ... Mein Geist begleitet Hydaelyns erwähltes Kind in dieser Gestalt<nbsp>...
#. fr: Nul autre. Cette forme me permet d'accompagner <if $gn4>la<else>le</if> protégé<if $gn4>e</if> d'Hydaelyn.
#. speaker: MIDGARDSORMR
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500040_MIDGARDSORMR:1"
msgid "None other. My form is such that I may journey with Hydaelyn's chosen─"
msgstr ""

#. ja: 竜とヒトとの争いの禍根を断つため、<br>自ら苦難の道を歩むというのでな……。
#. de: <if $gn4>Sie<else>Er</if> will den endlosen Krieg beenden. Diese schwere Bürde nahm <if $gn4>sie<else>er</if> auf sich.
#. fr: Un<if $gn4>e</if> mortel<if $gn4>le</if> qui désire mettre un terme à la guerre entre les hommes et les dragons.
#. speaker: MIDGARDSORMR
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500050_MIDGARDSORMR:1"
msgid "A mortal who desireth to end the war between man and dragon."
msgstr ""

#. ja: (-ティアマット-)……我がアラグとの戦いに敗れてより幾星霜。<br>まさか、エオルゼアの地でもまた、<br>竜と人との争いが起こっていたとは……。
#. de: (-Tiamat-)Über all die Zeit, seit mich die Allager hier fesselten, tobte in Eorzea also der Krieg weiter ...
#. fr: (-Tiamat-)Des millénaires ont passé depuis que les gens d'Allag m'ont mise à bas. Et malgré tout, la guerre fait toujours rage entre nos peuples...
#. speaker: TIAMAT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500060_TIAMAT:1"
msgid "(-Tiamat-)Millennia have passed since I was brought low by the men of Allag. To think that war rageth still between our kinds..."
msgstr ""

#. ja: (-ティアマット-)聞け、人の子よ……。<br>我が名はティアマット、黄昏に消えゆく竜……。
#. de: (-Tiamat-)Mein Name ist Tiamat, der ins Vergessen entschwundene Drache.
#. fr: (-Tiamat-)Écoute mon histoire, humain<if $gn4>e</if>. Je suis Tiamat, l'un des premiers rejetons de Midgardsormr.
#. speaker: TIAMAT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500070_TIAMAT:1"
msgid "(-Tiamat-)Hearken to my tale, child of man. I am Tiamat, of Midgardsormr's first brood."
msgstr ""

#. ja: (-ティアマット-)始原の時、生まれたばかりのこの星に、<br>我が父、ミドガルズオルムが降り立った。<br>……七の卵を携えてな。
#. de: (-Tiamat-)Am Anbeginn der Zeit, als dieses Gestirn gerade geboren war, kam mein Vater und brachte sieben Eier mit sich. 
#. fr: (-Tiamat-)Avant le commencement de toutes choses, mon père est venu sur cette planète, avec sept œufs dans son sein.
#. speaker: TIAMAT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500080_TIAMAT:1"
msgid "(-Tiamat-)In a time before time, my father did come to this star, bearing seven eggs."
msgstr ""

#. ja: そして、成長した我が子ら……<br>後に、「七大天竜」と呼ばれる者たちは、<br>ハイデリン各地の大陸へと飛び立ったのだ。
#. de: Zu sieben starken Kindern wuchsen sie heran - die Hohen Drachen nennt ihr sie. Sie flogen aus und ließen sich an verschiedenen Orten nieder.
#. fr: De ces œufs sont nés mes enfants. Et lorsqu'ils ont grandi, ils ont pris leur envol, parcourant les terres d'Hydaelyn.
#. speaker: MIDGARDSORMR
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500090_MIDGARDSORMR:1"
msgid "From these eggs did my children hatch. And once they were full-grown, they took wing and spread across all the lands of Hydaelyn."
msgstr ""

#. ja: (-ティアマット-)我と愛しき同胞であったバハムートは、<br>南方大陸メラシディアに渡り、多くの子を成した。
#. de: (-Tiamat-)Mit meinem geliebten Bahamut flog ich nach Süden. Wir brachten in Meracydia zahlreiche Nachkommen zur Welt.
#. fr: (-Tiamat-)En compagnie de mon frère Bahamut, j'ai voyagé vers le sud, jusqu'à Méracydia. Ensemble, nous avons engendré un grand nombre d'enfants.
#. speaker: TIAMAT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500100_TIAMAT:1"
msgid "(-Tiamat-)Together with my brood-brother Bahamut, I journeyed south to Meracydia. And together, we brought forth innumerable children into the world."
msgstr ""

#. ja: (-ティアマット-)だが、五千年の昔……<br>人の軍勢、すなわちアラグの民が南方を侵略。<br>我らが子を焼き、遂にはバハムートをも殺したのだ……。
#. de: (-Tiamat-)Doch vor fünftausend Jahren fiel der Stamm der Allager bei uns ein. Sie schlachteten meine Kinder ab und Bahamut nahmen sie mir auch.
#. fr: (-Tiamat-)Nous vivions en paix, et tout allait pour le mieux... jusqu'à l'apparition des hommes d'Allag, il y a cinq mille ans. Ils massacrèrent ma progéniture, et aussi mon Bahamut bien-aimé.
#. speaker: TIAMAT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500110_TIAMAT:1"
msgid "(-Tiamat-)We abided in peace, and all was well...until the men of Allag came, some five thousand years since. They slaughtered my children in droves, and took from me my beloved Bahamut."
msgstr ""

#. ja: (-ティアマット-)我を深い悲しみと絶望が包んだその時であった……。<br>漆黒の衣をまとった者、アシエンが現れたのは。
#. de: (-Tiamat-)Ich war von ohnmächtiger Trauer überwältigt. Da erschienen schwarz gewandete Gestalten, die sich Ascians nannten.
#. fr: (-Tiamat-)C'est alors que j'avais sombré dans le tréfonds du désespoir, que ces hommes en robe noire apparurent. Les Asciens...
#. speaker: TIAMAT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500120_TIAMAT:1"
msgid "(-Tiamat-)'Twas then, when I had fallen into the depths of despair, that black-robed men came unto me. The Ascians."
msgstr ""

#. ja: (-ティアマット-)我は奴らと密約し、バハムートの復活を願った……<br>だが、呼び降ろされたそれは、紛い物だったのだ。
#. de: (-Tiamat-)Ich schloss einen Pakt. Wenn nur Bahamut wieder lebte ...! Doch sie waren Verräter ...
#. fr: (-Tiamat-)Ils m'offrirent de ressusciter Bahamut grâce à leurs sombres artifices, et dans mon malheur, je fis l'erreur d'accepter... Une décision que je regretterai jusqu'à mon dernier souffle.
#. speaker: TIAMAT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500130_TIAMAT:1"
msgid "(-Tiamat-)They offered to resurrect Bahamut through their dark arts, and I, in my grief, accepted─a decision which I shall regret unto my dying breath."
msgstr ""

#. ja: (-ティアマット-)アシエンどもはアラグの民にも知恵を授け、<br>バハムートは、永劫の檻に捕えられた。
#. de: (-Tiamat-)Hinter meinem Rücken unterwiesen sie die Allager in ihren bösen Lehren. Und so war Bahamut am Leben - doch auf ewig gefesselt in einem metallenen Verlies.
#. fr: (-Tiamat-)Ce qu'ils m'apportèrent n'était qu'un simulacre de mon bien-aimé. Pire encore, les Asciens donnèrent à ses bourreaux les moyens de l'emprisonner.
#. speaker: TIAMAT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500140_TIAMAT:1"
msgid "(-Tiamat-)For what they brought back was a mockery of my beloved. Worse, the Ascians gifted his murderers the means to entrap him."
msgstr ""

#. ja: (-ティアマット-)よいか、人の子よ。<br>神とは想像力の産物……<br>願いの力が、星の命を用いて作り出す虚像。
#. de: (-Tiamat-)Hör mir zu. Die Wesen, die die Euren Götter nennen, sind nichts weiter als Trugbilder eurer Vor<shy>stel<shy>lungs<shy>kraft, denen auf Kosten von Hydaelyn Gestalt verliehen wird.
#. fr: (-Tiamat-)Humain<if $gn4>e</if>, tu dois savoir que ceux que les tiens appellent dieux ne sont que des spectres créés par leurs esprits, prenant forme au détriment d'Hydaelyn.
#. speaker: TIAMAT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500150_TIAMAT:1"
msgid "(-Tiamat-)Know this, child of man: the beings thy kind call gods are but specters of thy mind's creation, given form at great cost to Hydaelyn."
msgstr ""

#. ja: (-ティアマット-)そして、この地にはアラグに抗わんとして、<br>降ろされた多数の神が封じられている。<br>……これを解き放ってはならぬ。
#. de: (-Tiamat-)An diesen Ort stiegen unzählige Götter herab, um die Allager zu bezwingen. Doch sie alle wurden gefangen ... und niemand darf sie befreien.
#. fr: (-Tiamat-)Un grand nombre de ces êtres dorment dans ce monde, vaincus par l'empire qui m'a mise aux fers. Ils ne doivent en aucun cas être réveillés.
#. speaker: TIAMAT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500160_TIAMAT:1"
msgid "(-Tiamat-)Many such beings yet slumber across the land, brought to heel by the selfsame empire that bound me. They must not be released into the world."
msgstr ""

#. ja: (-ティアマット-)争いの禍根を絶つならば、神にすがる弱き者と、<br>その眼を曇らせるアシエンどもを倒すのだ。
#. de: (-Tiamat-)Wenn ihr die Wurzel des Hasses ausmerzen wollt, dann haltet die Schwachen ab, sich an Götter zu klammern; und tötet die Blender, die ihre Sinne trüben: die Ascians.
#. fr: (-Tiamat-)Si tu veux mettre un terme au conflit, tu dois vaincre les Asciens et libérer de leur sombre influence ceux dont la volonté est faible.
#. speaker: TIAMAT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500170_TIAMAT:1"
msgid "(-Tiamat-)If thou wouldst end the conflict, vanquish thee the Ascians, and deliver the weak of will from the bonds of their dark influence."
msgstr ""

#. ja: ティアマットよ。<br>五千年の時を数えてなお、自らを許せぬのか。
#. de: Tiamat, meine Tochter. Selbst nach fünftausend Jahren kannst du dir nicht verzeihen?
#. fr: Cela fait maintenant cinq mille ans, mon enfant. Ne veux-tu pas pardonner, toi aussi<nbsp>?
#. speaker: MIDGARDSORMR
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500180_MIDGARDSORMR:1"
msgid "It hath been five thousand years, my child. Wilt thou not forgive thyself?"
msgstr ""

#. ja: (-ティアマット-)ここは、死すら叶わぬ時の牢獄……。<br>しかし、我はここを出ることを望まぬ。<br>時の果てる、その日まで。
#. de: (-Tiamat-)Dies ist ein Kerker, der mir nicht einmal durch den Tod Erlösung gewährt. Aber ich wünsche nicht meine Freiheit. Nicht bis ans Ende aller Zeit.
#. fr: (-Tiamat-)La délivrance de la mort m'est refusée ici, et pourtant je ne désire pas la liberté. Non, Père. Je vivrai avec mon regret jusqu'à ce que le monde ne soit plus.
#. speaker: TIAMAT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500190_TIAMAT:1"
msgid "(-Tiamat-)The release of death is denied me here, yet I desire not freedom. Nay, Father. I shall live with my regret until the world itself hath ceased to be."
msgstr ""

#. ja: (-ティアマット-)一時の感情に呑まれ、神降ろしに手を染め……<br>バハムートの魂をねじ曲げ、穢してしまった己への罰……。<br>……そう、これは贖罪なのだ。
#. de: (-Tiamat-)Meine Schuld wiegt zu schwer. Die unbändige Trauer gab mir ein, Bahamuts Seele zu rufen - zu verderben ... Niemals kann ich mir dies vergeben. 
#. fr: (-Tiamat-)Tel est mon châtiment pour m'être associée aux Ténèbres, et pour avoir condamné mon bien-aimé à un sort pire que la mort.
#. speaker: TIAMAT
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_500200_TIAMAT:1"
msgid "(-Tiamat-)Such is my just punishment for consorting with Darkness─for calling forth a loathsome and lamentable creature which blackeneth my beloved's memory."
msgstr ""

#. ja: クリスタルに導かれし光の戦士よ
#. de: Mein Kind ... <if $gn4>Meine Kriegerin<else>Mein Krieger</if> des Lichts ...
#. fr: Porteu<if $gn4>se<else>r</if> du cristal, mon enfant...
#. speaker: HYDAELYN
#. macro: <if $gn4>daughter<else>son</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_600010_HYDAELYN:1"
msgid "Warrior of Light. Beloved <if $gn4>daughter<else>son</if>."
msgstr ""

#. ja: あなたの心に 再び光の宿りを感じます
#. de: In dein Herz ist das Licht zurückgekehrt.
#. fr: La Lumière resplendit de nouveau dans ton cœur.
#. speaker: HYDAELYN
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_600020_HYDAELYN:1"
msgid "The Light abideth within thy heart again."
msgstr ""

#. ja: よくぞ 幻龍の試練に耐えました
#. de: Die Fessel ist gelöst, du hast deine Prüfung tapfer bestanden.
#. fr: Vaillamment, tu as surmonté tes nombreuses épreuves.
#. speaker: HYDAELYN
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_600030_HYDAELYN:1"
msgid "Full valiantly didst thou overcome thy many trials."
msgstr ""

#. ja: しかし 安心してはなりません
#. de: Doch du musst achtsam bleiben.
#. fr: Mais ne relâche pas ta vigilance.
#. speaker: HYDAELYN
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_600040_HYDAELYN:1"
msgid "But glory not in thy success."
msgstr ""

#. ja: 深淵に潜む者たちが すぐそこまで迫っています
#. de: Denn die Diener der Dunkelheit sind unheilvoll nahe ...
#. fr: Car les serviteurs des Ténèbres sont toujours à proximité.
#. speaker: HYDAELYN
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_600050_HYDAELYN:1"
msgid "For the servants of Darkness are ever close at hand."
msgstr ""

#. ja: 今一度 あなたに光の加護を
#. de: Dir ist das Licht aufs Neue geschenkt.
#. fr: Reçois ma bénédiction.
#. speaker: HYDAELYN
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_600060_HYDAELYN:1"
msgid "Receive of me my blessing once more,"
msgstr ""

#. ja: そして どうか世界を光あるものに――
#. de: Mein Segen ist wieder mit dir. Bring der Welt das Licht ...
#. fr: Va et laisse ta Lumière éclairer tous les êtres.
#. speaker: HYDAELYN
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_600070_HYDAELYN:1"
msgid "And go forth, to shine thy Light on all creation."
msgstr ""

#. ja: 我が「爪」のすべてを打ち砕き、<br>再び、光の加護を取り戻したか……。
#. de: Du hast also meine Klaue gelöst und Hydaelyns Segen wieder empfangen.
#. fr: Tu t'es libéré<if $gn4>e</if> de mon <i>étreinte</i> et tu as retrouvé la bénédiction d'Hydaelyn.
#. speaker: MIDGARDSORMR
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_700010_MIDGARDSORMR:1"
msgid "Thou hast broken down the wall I built around thee, and partaken of thy mistress's blessing once more."
msgstr ""

#. ja: 生まれ落ちてより、今日この日に至るまで、<br>我は、お主ほど、心強き者を知らぬ。
#. de: Seit Beginn meiner Existenz habe ich noch niemals ein Wesen mit so starkem Herzen gesehen.
#. fr: Tu es fort<if $gn4>e</if>, mortel<if $gn4>le</if>. Plus fort<if $gn4>e</if> que tous ceux des tiens que j'ai connus.
#. speaker: MIDGARDSORMR
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_700011_MIDGARDSORMR:1"
msgid "Strong art thou, mortal─stronger than any other of thy kind."
msgstr ""

#. ja: ハイデリンの使徒よ……<br>今のお主であれば、我が背に乗るに相応しい。
#. de: Als ich auf dieser Welt zu neuem Leben erwachte, gelobte ich, Hydaelyn zu dienen. Nun will ich dir, <if $gn4>ihrer Erwählten<else>ihrem Erwählten</if>, beistehen.
#. fr: Ayant été témoin de tes actes, je suis désormais convaincu que tu es digne de sa Lumière.
#. speaker: MIDGARDSORMR
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_700020_MIDGARDSORMR:1"
msgid "Having looked upon thy deeds, I am convinced. Thou art worthy to bear Her Light."
msgstr ""

#. ja: 生まれし日に、母なるハイデリンと誓った盟約に従い……<br>今こそ我が翼を、お主に授けようぞ！
#. de: Deine Schlachten werde ich nicht schlagen, doch meine Flügel sollen deine sein.
#. fr: Un ancien pacte m'a lié à toi, mais il semble que le destin devait nous unir depuis le début. Je ne combattrai pas à ta place, mais je te prêterai mes ailes.
#. speaker: MIDGARDSORMR
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_700030_MIDGARDSORMR:1"
msgid "The covenant bound me to thee, but 'twould seem our fates were mingled from the first. Though I will not fight thy battles, I will yet lend thee my wings."
msgstr ""

#. ja: ゆくぞ、闇の使徒どもを討つために！
#. de: Lass uns fliegen und die Dunkelheit vertreiben!
#. fr: Viens, mortel<if $gn4>le</if>. Ensemble, nous allons chasser les Ténèbres<nbsp>!
#. speaker: MIDGARDSORMR
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_700040_MIDGARDSORMR:1"
msgid "Come, mortal─we go to cast out the Darkness!"
msgstr ""

#. ja: 来たか 光の使徒よ
#. de: Hydaelyns Lakai ...!
#. fr: Te voici, protégé<if $gn4>e</if> d'Hydaelyn.
#. speaker: LAHABREA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_800010_LAHABREA:1"
msgid "The champion of Hydaelyn."
msgstr ""

#. ja: 何故 お前はそうも神を憎む？
#. de: Sag, warum verabscheut ihr die Primae so?
#. fr: Dis-moi, pourquoi méprises-tu tant les Primordiaux<nbsp>?
#. speaker: IGEYOHRM
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_800020_IGEYOHRM:1"
msgid "Tell me: why do you despise the primals so?"
msgstr ""

#. ja: 神とは人の意思によりて降りしもの
#. de: Sie sind nur die Verkörperung sterblicher Sehnsüchte.
#. fr: Ils sont l'incarnation même de l'envie, de l'avidité des mortels.
#. speaker: IGEYOHRM
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_800030_IGEYOHRM:1"
msgid "They are the embodiment of mortal will─of mortal desire."
msgstr ""

#. ja: その神と神との争いがもたらす混沌こそが<br>新たに生まれいずるゾディアーク様の産湯となるのだ
#. de: Offenbar <i>wollt</i> ihr einander hassen. Und das sollt ihr auch, denn aus dem Chaos, das die endlosen Kämpfe entfachen, wird Zodiark auferstehen.
#. fr: Tu cherches clairement un ennemi à haïr.<br>Et tant mieux, car c'est du tourbillon créé par vos conflits incessants que notre maître Zordiarche renaîtra.
#. speaker: IGEYOHRM
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_800040_IGEYOHRM:1"
msgid "Plainly, you <i>desire</i> a foe to despise. And 'tis well<br>that you do, for it is from the vortex of ceaseless conflict<br>that Lord Zodiark shall be reborn."
msgstr ""

#. ja: 次元圧壊を経て<br>世界は 再びひとつに戻る
#. de: Mit jeder Nova kommt das Universum seinem Urbild näher.
#. fr: À travers la Réunion, le monde redeviendra un et entier.
#. speaker: LAHABREA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_800050_LAHABREA:1"
msgid "Through the Joining, the world shall become whole again."
msgstr ""

#. ja: そして 世界をあるべき姿に再創造されるのだ
#. de: Sind alle Welten vereint, beginnt die Schöpfung erneut!
#. fr: Alors tout sera comme avant, et comme cela devrait toujours être.
#. speaker: LAHABREA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_800060_LAHABREA:1"
msgid "Then all shall be as once it was─as it should ever have remained."
msgstr ""

#. ja: すべては ゾディアーク様のために
#. de: Für Zodiark.
#. fr: Gloire au grand Zordiarche.
#. speaker: IGEYOHRM
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_800070_IGEYOHRM:1"
msgid "For the glory of Lord Zodiark."
msgstr ""

#. ja: 邪魔はさせんぞ 光の使徒よ！
#. de: Du warst ihm lange genug ein Hemmnis, <if $gn4>Lichtkriegerin<else>Lichtkrieger</if>!
#. fr: C'en est fini de tes immixtions, Guerri<if $gn4>ère<else>er</if> de la Lumière<nbsp>!
#. speaker: LAHABREA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_800080_LAHABREA:1"
msgid "Your meddling ends here and now, Warrior of Light!"
msgstr ""

#. ja: よもや これほどの力を――
#. de: Diese Stärke ist kaum vorstellbar!
#. fr: Une telle force<nbsp>! Cela défie l'entendement...
#. speaker: LAHABREA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_900010_LAHABREA:1"
msgid "Such strength! It defies all reason..."
msgstr ""

#. ja: 認めん 断じて認めはせんぞ
#. de: Nein! Ich lasse mich nicht in die Knie zwingen!
#. fr: Non<nbsp>! Je ne me laisserai pas surpasser par des humains<nbsp>!
#. speaker: IGEYOHRM
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_900020_IGEYOHRM:1"
msgid "No! I will not be bested by the likes of them!"
msgstr ""

#. ja: ラハブレア！ いまこそひとつに！
#. de: Lahabrea! Es ist Zeit!
#. fr: Lahabrea<nbsp>! Le moment est venu<nbsp>!
#. speaker: IGEYOHRM
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_900030_IGEYOHRM:1"
msgid "Lahabrea! It is time!"
msgstr ""

#. ja: 仕方あるまい<br>「超える力」の真なる使い方を見せてやろう
#. de: Gut ... Lass uns den Sterblichen zeigen, was die Kraft des Transzendierens vermag ...
#. fr: Très bien. Nous allons montrer à ce<if $gn4>tte</if> mortel<if $gn4>le</if> le véritable potentiel de l'Écho...
#. speaker: LAHABREA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_900040_LAHABREA:1"
msgid "Very well. Let us show these mortals the true power of the Echo..."
msgstr ""

#. ja: 魂の境界さえ 超えるほどの力をな！
#. de: Die Grenzen der Seele sind nicht mehr von Belang!
#. fr: Le pouvoir de transcender les limites mêmes de l'existence<nbsp>!
#. speaker: LAHABREA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_900050_LAHABREA:1"
msgid "The power to break down the barriers of existence!"
msgstr ""

#. ja: 我は 汝となりて――
#. de: Ich werde zu dir ...
#. fr: Ah... Nous fusionnons...
#. speaker: IGEYOHRM
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_900060_IGEYOHRM:1"
msgid "I am become you..."
msgstr ""

#. ja: ――汝は 我となる
#. de: ... und wir sind vereint!
#. fr: ... Et ne formons plus qu'un.
#. speaker: LAHABREA
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_900070_LAHABREA:1"
msgid "...And we are become one."
msgstr ""

#. ja: 贄となるがいい!<br>ゾディアーク様の新生のために！
#. de: Opfert eure Seelen, Sterbliche, für Zodiarks Wiedergeburt!
#. fr: Viens, mortel<if $gn4>le</if><nbsp>! Offre ton âme pour la résurrection de Zordiarche<nbsp>!
#. speaker: ASCIANPRIME
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_900080_ASCIANPRIME:1"
msgid "Come, mortals! Render up your souls, that Lord Zodiark might be reborn!"
msgstr ""

#. ja: ぐおぉぉ！！
#. de: Guuaaaaaaaarrrh!
#. fr: Aaaaarrrgh<nbsp>!
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00010_ASCIANPRIME:1"
msgid "Aaargh!!!"
msgstr ""

#. ja: 魂に境界が造られているッ！？<br>ええい 忌まわしきハイデリンめ！！
#. de: Hydaelyn!! Du zwingst mich in die Grenzen, aus denen mich Zodiark befreite?!
#. fr: Des parois... autour de nos âmes<nbsp>! Raaah<nbsp>! Sois maudite, Hydaelyn<nbsp>!
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00020_ASCIANPRIME:1"
msgid "What walls are these? Arrrgh! Damn you, Hydaelyn!"
msgstr ""

#. ja: <ui-color 547>チィ……！<br>光の加護を、完全に取り戻していたとは！</ui-color>
#. de: <ui-color 547>Dass <if $gn4>sie<else>er</if> Hydaelyns Kraft wiedererlangen würde, war ja vorherzusehen ...</ui-color>
#. fr: <ui-color 547>Hmpf<nbsp>! Non seulement <if $gn4>elle<else>il</if> a retrouvé la bénédiction de la Lumière...</ui-color>
#. kind: other
#. macro: <ui-color 547> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 547 (formatting: keep it as often as the source has it)
#. macro: <if $gn4>she<else>he</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00030_LAHABREA:1"
msgid "<ui-color 547>That <if $gn4>she<else>he</if> might regain the blessing of Light I had foreseen...</ui-color>"
msgstr ""

#. ja: <ui-color 547>我らの「超える力」を打ち破るほどに<br>加護が強くなっているだと……？<br>……このままでは。</ui-color>
#. de: <ui-color 547>Aber dass <if $gn4>sie<else>er</if> uns an der Entfaltung <i>unserer</i> Gabe hindern würde!</ui-color>
#. fr: <ui-color 547>Mais cela lui confère une telle force qu'<if $gn4>elle<else>il</if> est capable de briser notre pouvoir.</ui-color>
#. kind: other
#. macro: <ui-color 547> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 547 (formatting: keep it as often as the source has it)
#. macro: <if $gn4>she<else>he</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00040_LAHABREA:1"
msgid "<ui-color 547>But <if $gn4>she<else>he</if> is grown so strong in it as to deny us our power.</ui-color>"
msgstr ""

#. ja: <ui-color 547>退くぞラハブレア……。<br>奴は今、我らの魂を砕く魔器を持たぬ！</ui-color>
#. de: <ui-color 547>Lass uns gehen, Lahabrea. <if $gn4>Sie<else>Er</if> hat nicht das Mittel, uns zu vernichten!</ui-color>
#. fr: <ui-color 547>Partons, Lahabrea. Ils ne peuvent pas nous empêcher de fuir.</ui-color>
#. kind: other
#. macro: <ui-color 547> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 547 (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00050_IGEYOHRM:1"
msgid "<ui-color 547>Let us withdraw, Lahabrea. That power remains to us, at least.</ui-color>"
msgstr ""

#. ja: <ui-color 547>馬鹿なッ！</ui-color>
#. de: Waas ...?! Das ist unmöglich!
#. fr: <ui-color 547>C-c'est impossible<nbsp>!</ui-color>
#. kind: other
#. macro: <ui-color 547> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 547 (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00060_IGEYOHRM:1"
msgid "<ui-color 547>Impossible!</ui-color>"
msgstr ""

#. ja: グ、グアアァァァァァァァァ！
#. de: Gguuuaaaaaaaaarh!
#. fr: Aaaaaah<nbsp>!
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00070_IGEYOHRM:1"
msgid "Aaaaaahhh!"
msgstr ""

#. ja: <ui-color 547>「竜の眼」の力を引き出したか……。<br>しかし、もはや小細工はあるまい？</ui-color>
#. de: <ui-color 547>Mit einem Drachen<shy>auge wolltest du dein Glück versuchen? Tja, zu schade, dass es damit nun vorbei ist!</ui-color>
#. fr: <ui-color 547>Tu as donc réussi à maîtriser le pouvoir de l'Œil. Quel dommage que tu l'aies épuisé... Que vas-tu faire maintenant<nbsp>?</ui-color>
#. kind: other
#. macro: <ui-color 547> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 547 (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00080_LAHABREA:1"
msgid "<ui-color 547>So you harnessed the Eye's power... A pity you spent it all. What will you do now, hero?</ui-color>"
msgstr ""

#. ja: やはり、ハイデリンの加護を受けし「光の戦士」といえど、<br>魂封じる檻なくして、アシエンを斬ることは叶わぬか……。
#. de: Selbst <if $gn4>die Kriegerin<else>der Krieger</if> des Lichts, mit Hydaelyns Kraft gesegnet, kann einen Ascian nur mit äußerster Mühe vernichten ...
#. fr: Ainsi, même l'illustre Guerri<if $gn4>ère<else>er</if> de la Lumière ne peut détruire un Ascien sans avoir recours à de vulgaires artifices...
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00090_THORDAN:1"
msgid "So, not even the vaunted Warrior of Light can unmake an Ascian without relying upon mortal contrivances."
msgstr ""

#. ja: <ui-color 547>トールダンだと！？</ui-color>
#. de: <ui-color 547>Thordan?!</ui-color>
#. fr: <ui-color 547>Thordan<nbsp>!</ui-color>
#. kind: other
#. macro: <ui-color 547> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 547 (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00100_LAHABREA:1"
msgid "<ui-color 547>You!</ui-color>"
msgstr ""

#. ja: かつてトールダン王と十二騎士たちは、<br>大きな犠牲を払いながらも、ニーズヘッグを退けた。
#. de: Vor langer, langer Zeit zwangen König Thordan und seine Ritter den Hohen Drachen Nidhogg in die Knie.
#. fr: Il y a bien longtemps, le premier roi d'Ishgard et ses douze chevaliers ont combattu et vaincu Nidhogg.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00110_THORDAN:1"
msgid "In the distant past, King Thordan and his knights twelve fought and defeated Nidhogg."
msgstr ""

#. ja: そして、ふたつの「竜の眼」を手に入れ、<br>以降、イシュガルド教皇庁は、これを厳重に管理してきた。<br>「蒼の竜騎士」の力の源としてな……。
#. de: Sie verloren viel, aber erlangten weit mehr: Sie raubten ihm beide Augen, die die Kurie seit damals sicher verwahrt ...
#. fr: Malgré le prix qu'ils ont dû payer pour la victoire, leur récompense était sans égale<nbsp>: les yeux de l'ancien dragon. Ces trésors ont été tenus en bonne garde pendant des siècles par le Saint-Siège.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00120_THORDAN:1"
msgid "Though the victory cost them dear, they were rewarded with a great prize: the dread wyrm's eyes, both of which have since been held in the Holy See's safekeeping."
msgstr ""

#. ja: 光の使徒よ。<br>お主の手にあるそれが、ニーズヘッグの左眼……<br>では、右眼はどこにあるのか？
#. de: Du besitzt das linke Auge des Drachen, das den Azur-Drachenreitern seit jeher ihre Kraft verleiht ... Doch wo, meinst du, ist das rechte?
#. fr: Celui que tu possèdes est l'œil gauche de Nidhogg, et il a procuré son pouvoir au Dragon céleste, de génération en génération. Quant à l'autre...
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00130_THORDAN:1"
msgid "The Eye you possess was Nidhogg's left, and long has it served as the source of the Azure Dragoon's might. As for its twin..."
msgstr ""

#. ja: 初代「蒼の竜騎士」……征竜将「ハルドラス」……。<br>眼から力を引き出しながらも、その力に呑まれ、<br>朽ちぬ死体と化した哀れな男よ。
#. de: Es ist hier, fest mit dem Körper Haldraths verschmolzen - dem ersten Azur-Drachenreiter. Das Auge verlieh ihm seine Kraft, doch am Ende wurde er von ihm verschlungen. Das Leben ist lange aus seinem Körper gewichen, und doch verfällt die Leiche nicht ...
#. fr: Il est lié à la personne de Haldrath, le premier des protecteurs du peuple ishgardais. Et bien qu'il ait été capable de jouir de sa puissance, il a fini par succomber à son influence. Désormais, il gît ici sans que sa chair ne pourrisse. Une bien misérable fin pour un héros légendaire...
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00140_THORDAN:1"
msgid "It has lain here, joined to the person of Haldrath, the first Azure Dragoon. For though he learned to harness its power, he was ultimately consumed by it. Even in death, his body decays not─a pitiful end for a fabled hero."
msgstr ""

#. ja: 闇の使徒、アシエンよ……。<br>貴様らは、人々に神降ろしの手法を教え、<br>争いを煽り、混沌を生み出す。
#. de: Lahabrea, mein Freund ... Ihr Ascians, Boten eures dunklen Gottes - ihr sät eine böse Saat. Das Verlangen nach Rache gebt ihr uns ein und lehrt uns die Götterbeschwörung.
#. fr: Ascien, pendant longtemps toi et tes semblables avez semé les graines du chaos en initiant les mortels aux secrets de l'invocation divine.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00150_THORDAN:1"
msgid "My Ascian friend. Long have you and your kind sown the seeds of chaos by teaching mortals the secrets of summoning."
msgstr ""

#. ja: だが、すべてが自分たちの思惑どおりに進むなどと、<br>思わぬことだ……。
#. de: Ihr meint, alles arbeitet für euch auf euer großes Ziel zu ... Aber da seid ihr im Irrtum.
#. fr: Mais si vous croyiez que nous allions vous laisser nous utiliser comme des pions, vous vous êtes gravement fourvoyés.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00160_THORDAN:1"
msgid "But if you assumed that we would meekly serve as your pawns, then you are gravely mistaken."
msgstr ""

#. ja: <ui-color 547>貴様ッ……！</ui-color>
#. de: <ui-color 547>Du niederträchtiger Heuchler!</ui-color>
#. fr: <ui-color 547>Oserais-tu te retourner contre nous<nbsp>!?</ui-color>
#. kind: other
#. macro: <ui-color 547> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 547 (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00170_LAHABREA:1"
msgid "<ui-color 547>You would raise a hand against us!?</ui-color>"
msgstr ""

#. ja: 伝説の騎士王を我が身に呼び降ろし、我は神となる……。
#. de: Der legendäre König Thordan ... in mir zum Gott erhöht!
#. fr: En accueillant en moi l'âme du légendaire roi Thordan, je suis devenu un dieu...
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00180_THORDAN:1"
msgid "By taking unto my flesh the soul of the legendary King Thordan, I am become a god─"
msgstr ""

#. ja: 「千年戦争」により蓄積された民の祈りと、<br>「眼」がもたらす莫大なエーテルとが創り出す、<br>消え去ることのない永遠の神……。
#. de: Ein ewiger, unsterblicher Gott ... Erfleht von Gebeten, die zahllose Seelen über tausend Jahre in Ver<shy>zweif<shy>lung sprachen; genährt vom gewaltigen Äther, der sich in Nidhoggs Augen konzentriert.
#. fr: Un dieu éternel, dont l'être même est nourri par un millier d'années de ferventes prières et les vastes ressources d'éther de l'Œil du dragon.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00190_THORDAN:1"
msgid "A god who knows not cessation, whose being is sustained by a millennium of fervent prayer and the Eye's nigh-bottomless reservoir of aether."
msgstr ""

#. ja: <ui-color 547>永遠の神……だと……！？</ui-color>
#. de: <ui-color 547>Ewiger ... Gott?!</ui-color>
#. fr: <ui-color 547>Que dis-tu<nbsp>!?</ui-color>
#. kind: other
#. macro: <ui-color 547> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 547 (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00200_LAHABREA:1"
msgid "<ui-color 547>What!?</ui-color>"
msgstr ""

#. ja: 人を侮りすぎよな、アシエン・ラハブレア……。
#. de: Du hast uns unterschätzt, Ascian.
#. fr: C'est ton mépris pour les hommes qui aura causé ta perte, Ascien. Mon premier acte en tant que dieu-roi sera de te condamner à mort.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00210_THORDAN:1"
msgid "Your contempt for man has proven your undoing, Ascian. For my first act as god-king, I do hereby sentence you to die."
msgstr ""

#. ja: ウガァァァァァァァァァァァ！！
#. de: Gguuuaaaaaaaaarh!
#. fr: Aaaaaargggh<nbsp>!
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00220_LAHABREA:1"
msgid "Aaaaaargggh!"
msgstr ""

#. ja: 神はエーテルを喰らう。<br>それが、アシエンの魂の欠片であったとしても、な。<br>……これこそが千年の禍根を断つ力。
#. de: Äther ... Alles kehrt zu dieser Reinform aller Substanz zurück. Selbst eine Ascian-Seele.
#. fr: Les dieux se nourrissent d'éther, quelle que soit sa forme. L'âme d'un Ascien n'échappe pas à cette règle. Avec ce nouveau pouvoir, je vais mettre fin à un millénaire de conflits.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00230_THORDAN:1"
msgid "Gods feed upon aether. It matters not what form that aether takes. Ascian souls are no exception. With this power, I shall put an end to a thousand years of conflict."
msgstr ""

#. ja: アシエン、ドラゴン、蛮神……<br>争いを生み出すすべてを、我が聖剣によって断ち斬り、<br>調和の世をもたらさん……。
#. de: Ascians, Drachen, Götzen ... Alles, was die Flammen des Krieges schürt, alles, was Zwietracht sät, wird durch meine heilige Klinge zerspalten. Endlich wird diese Welt Frieden finden.
#. fr: Asciens, dragons ou Primordiaux... Peu importe qui apporte le chaos, il subira le châtiment de mon épée divine, et je restaurerai l'ordre dans ce monde.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00240_THORDAN:1"
msgid "Be they sown by Ascian, dragon, or primal, wheresoever the seeds of chaos threaten to quicken, I shall excise them with my divine blade and bring order to the world."
msgstr ""

#. ja: 来い、光の使徒よ。<br>神を否定するというのなら、存分に相手になろう……。
#. de: Komm, <if $gn4>Lichtkriegerin<else>Lichtkrieger</if>. Ich bin zu einem der Wesen geworden, die du so sehr verabscheust. Wenn du deinem Hass Luft machen willst, so ergreif diese Gelegenheit ...
#. fr: Je suis devenu ce que tu abhorres le plus, Guerri<if $gn4>ère<else>er</if> de la Lumière. Si tu oses défier ma divinité, je devrai te terrasser, toi aussi.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_A00250_THORDAN:1"
msgid "I am become that which you abhor, Warrior of Light. If you would take issue with my godhood, I shall answer you with my blade."
msgstr ""

#. ja: 今こそ 我ら蒼天騎士の真の力を見せるときぞ！
#. de: Brüder! Es ist Zeit, die Kraft der Azurgarde zu offenbaren!
#. fr: Frères<nbsp>! Le temps est venu de révéler le véritable pouvoir des chevaliers de l'Azur<nbsp>!
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_B00010_ZEPHIRIN:1"
msgid "Brothers! The time is come to call upon the true power of the Heavens' Ward!"
msgstr ""

#. ja: かかってくるがいい 光の使徒よ
#. de: Versuch dein Glück, <if $gn4>Kriegerin<else>Krieger</if> des Lichts!
#. fr: Viens donc m'affronter, Guerri<if $gn4>ère<else>er</if> de la Lumière.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_B00020_THORDAN:1"
msgid "Fight me if you will, Warrior of Light."
msgstr ""

#. ja: 永遠の神となった私が<br>闇の者もろとも 光の使徒をも斬り伏せてくれる
#. de: Doch gegen den ewigen Gott wirst du nicht bestehen. Ich dulde weder Diener des Lichts noch der Dunkelheit.
#. fr: Je ne te crains point. Tous ceux qui s'opposent à moi seront détruits,<br>qu'ils servent les Ténèbres ou la Lumière.
#. kind: other
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_B00030_THORDAN:1"
msgid "I care not. All who stand against me will be destroyed─<br>be they servants of the Darkness or the Light."
msgstr ""

#. ja: そして すべての人に祝福をあたえ<br>清らかなる聖徒に造り替え 恒久の平和を授けよう
#. de: Nur ich alleine bringe dem Volk den Segen. Mir werden ihre Seelen folgen, mein Wort wird sie leiten.
#. fr: Par ma bénédiction, tous les hommes seront sanctifiés, et une ère de paix éternelle commencera.<br>Tous les conflits disparaîtront.
#. kind: other
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_B00040_THORDAN:1"
msgid "By my blessing shall all men be sanctified, and an endless era<br>of peace begin. Vice and conflict shall cease to be."
msgstr ""

#. ja: 神を肯定し その力を宿した我が聖剣と<br>神を否定し その力を捨てた貴様の刃
#. de: Was hast du meinem göttlichen Plan entgegenzusetzen? Wahrheit um der Wahrheit willen? <br>Endlose Opfer von höchst zweifelhaftem Wert?
#. fr: Tu rejettes ma divinité, mais qu'as-tu à offrir à mon peuple à la place<nbsp>? Une dure réalité<nbsp>?<br>Une souffrance vertueuse<nbsp>?
#. kind: other
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_B00050_THORDAN:1"
msgid "You reject my divinity, yet what have you to offer<br>my people in its stead? Bitter truth? Virtuous suffering?"
msgstr ""

#. ja: この混沌の時代に<br>世がどちらを求めているか 確かめようではないか！
#. de: Hah! Doch wenn du an deine Sache glaubst, dann verteidige sie - mit deinem eigenen Leben!
#. fr: Peu importe. Si tu crois que ta cause est juste, prouve que tu es capable de la défendre avec ta vie<nbsp>!
#. kind: other
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_B00060_THORDAN:1"
msgid "No matter. If you believe your cause just,<br>I call upon you to defend it with your life!"
msgstr ""

#. ja: 馬鹿な―― 千年 千年だぞ――<br>永き祈りの声と竜の眼でさえ 及ばぬというのか！
#. de: Du willst der Welt den Frieden verweigern - um deiner „Wahrheit“ willen? Soll das Leben Tausender durch dein Ethos der Ehrlichkeit zerstört werden?!
#. fr: Comment... est-ce possible<nbsp>? Un millénaire de prières et le pouvoir de l'Œil... n'ont pas suffi à te vaincre<nbsp>!?
#. kind: other
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_C00010_THORDAN:1"
msgid "How...how can this be? A millennium of prayer<br>and the Eye's power combined─and still you stand?"
msgstr ""

#. ja: 貴様は いったい何者なのだ――
#. de: Was bist du für <if $gn4>eine Närrin<else>ein Narr</if>!
#. fr: Mais quel genre d'humain<if $gn4>e</if> es-tu donc<nbsp>?
#. kind: other
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_C00020_THORDAN:1"
msgid "Who─<i>what</i> are you?"
msgstr ""

#. ja: 終わってしまったか……<br>最後は俺の手でと思ったのだがな。
#. de: Dann ist das Ende also gekommen. Leider nicht durch meine Hand.
#. fr: Tu as déjà fini<nbsp>? Et moi qui espérais mettre fin à tout ça de mes propres mains... Dommage.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_C00030_ESTINIEN:1"
msgid "...It is over, then? I had hoped that mine would be the hand to end it...but knowing you, there was little chance of that."
msgstr ""

#. ja: こいつを返してもらいに来た。<br>なんとか、役に立ったようじゃないか。
#. de: Meine Leihgabe. Schön, dass sie dir von Nutzen war.
#. fr: Il semblerait que l'Œil t'ait bien servi.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_C00040_ESTINIEN:1"
msgid "'Twould seem the Eye has served you well."
msgstr ""

#. ja: これが、隠されていた、もうひとつの「眼」か。<br>長かった……ふたつの「眼」が、ようやく……。
#. de: Das zweite Auge. Endlich sind sie beide in meiner Hand ...
#. fr: Et voici l'autre... Il est enfin entre mes mains...
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_C00050_ESTINIEN:1"
msgid "Its twin... At long last..."
msgstr ""

#. ja: あとは、こいつを雲海深くに投げ入れれば、<br>俺の使命もそれで……。
#. de: Nun muss ich nur noch dafür sorgen, dass weder Ishgarder noch Drachen sie jemals wieder finden.
#. fr: Il ne me reste plus qu'à les emporter hors d'atteinte des hommes et des dragons. Lorsque ce sera fait, j'aurai enfin accompli mon devoir...
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_C00060_ESTINIEN:1"
msgid "All that remains is to take them beyond the reach of man and dragon both. With this task accomplished, my toils shall finally be at an end."
msgstr ""

#. ja: 長らく、我が眼の力に触れ、<br>さらには全身に我が血を浴びながら、よく耐えてきた。
#. de: Lange hast du meiner Kraft widerstanden, obwohl du mein Auge am Leibe trugst und in meinem Blut gebadet hast.
#. fr: Tu as admirablement réussi à résister à ma voix, toi qui as été baigné par mon pouvoir et mon sang.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_C00070_NIDHOGG:1"
msgid "Thou hadst done well to resist mine influence, bathed in my power and blood as thou wert."
msgstr ""

#. ja: ……だが、ついに貴様は願ったな、蒼の竜騎士よ！<br>すべての荷を降ろしたいと！　安らぎが欲しいと！！
#. de: Aber schließlich wuchs in dir ein Wunsch, Drachenreiter! Die Last möge von dir genommen werden, endlich möge man dir Ruhe gönnen!
#. fr: Hélas, dans ton pathétique désir de réconfort, tu as baissé la garde de ton esprit et tu t'es ainsi exposé à mon influence<nbsp>!
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_C00080_NIDHOGG:1"
msgid "Alas, in thine anticipation of comfort, thou hast lowered thy guard!"
msgstr ""

#. ja: 心の奥底に燻り続けた復讐の心……<br>「竜詩戦争」の影で散っていった者たちの慟哭……
#. de: Tief in deinem Herzen schwelte das Verlangen nach Rache ... hallte noch immer das Wehgeschrei der Opfer nach, die du im Drachenkrieg sterben sahst.
#. fr: Les lamentations de mes semblables vaincus... Leur ardent désir de revanche...
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_C00090_NIDHOGG:1"
msgid "The keening of my fallen kindred... Their smoldering desire for vengeance..."
msgstr ""

#. ja: 我の「眼」は、そのすべてを視、すべてを写してきた！<br>今こそ、すべて貴様にくれてやろう……
#. de: Mein Auge hat alles gesehen, alles ... Lass mich den Anblick mit dir teilen.
#. fr: Mes yeux ont été témoins d'un millier d'années de douleur. Une douleur que je vais désormais t'infliger.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_C00100_NIDHOGG:1"
msgid "Mine eyes have partaken of a thousand years of pain─a pain which I shall bestow upon thee."
msgstr ""

#. ja: ……そして、我となれ！
#. de: Nimm meinen Zorn tief in dich auf, Sterblicher ... und werde zu mir!!!
#. fr: Reçois mon ire, mortel, et deviens Nidhogg<nbsp>!
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_C00110_NIDHOGG:1"
msgid "Drink deep of my rage, mortal...AND BECOME ME!"
msgstr ""

#. ja: グオオオオォォォォ！
#. de: Ngaaaaaaahh ...!
#. fr: Grrraaarrrgh<nbsp>!
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_C00120_ESTINIEN:1"
msgid "Grrraaarrrgh!!!"
msgstr ""

#. ja: 未だすべてを恨むか、我が息子ニーズヘッグよ……
#. de: Nidhogg, mein Sohn ... Was hat der Hass aus dir gemacht?
#. fr: Nidhogg, mon enfant... La mort elle-même n'a pas pu atténuer ta colère...
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_C00130_MIDGARDSORMR:1"
msgid "Nidhogg, my child... What hath thy fury made of thee...?"
msgstr ""

#. ja: ゆくぞ、ハイデリンの使徒よ。
#. de: Schnell, <if $gn4>Botin<else>Bote</if> Hydaelyns!
#. fr: Partons, protégé<if $gn4>e</if> d'Hydaelyn.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_C00140_MIDGARDSORMR:1"
msgid "Let us away, servant of Hydaelyn."
msgstr ""

#. ja: 親方、あそこッス！
#. de: Chef! Sieh mal da!
#. fr: Patron<nbsp>! L<if $gn4>a<else>e</if> voilà<nbsp>!
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_D00010_WEDGE:1"
msgid "Chief! Over there!"
msgstr ""

#. ja: おーい！
#. de: Heeee! Hierher!
#. fr: Hééé<nbsp>!
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_D00020_BIGGS:1"
msgid "Oi!"
msgstr ""

#. ja: ヘヘッ……。<br>毎度のことながら、ヒヤヒヤさせやがるぜ！
#. de: <if $gn4>Sie<else>Er</if> macht's aber auch jedes Mal spannend ...
#. fr: Hohoho<nbsp>! Par les Douze, n'as-tu donc aucune pitié pour mon pauvre cœur<nbsp>!?
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_D00030_CID:1"
msgid "Haha! Godsdammit, do you always have to cut it so bloody close!?"
msgstr ""

#. ja: 倒したのね……教皇を……<br>いえ、蛮神「ナイツ・オブ・ラウンド」を……。
#. de: <if $gn4>Sie<else>Er</if> hat es also geschafft ...
#. fr: Une fois de plus, <if $gn4>elle<else>il</if> a réussi.
#. kind: other
#. macro: <if $gn4>she<else>he</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_D00040_YSHTOLA:1"
msgid "It would seem <if $gn4>she<else>he</if> has done it again."
msgstr ""

#. ja: あぁ、信じていたさ。
#. de: Daran haben wir doch nie gezweifelt, oder?
#. fr: En avons-nous jamais douté<nbsp>?
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_D00050_ALPHINAUD:1"
msgid "Was there ever any doubt?"
msgstr ""

#. ja: 帰ろう、イシュガルドへ……<br>皆が、英雄の凱旋を待っている。
#. de: Lasst uns nach Ishgard zurückkehren. Alle warten auf die triumphale Rückkehr <if $gn4>unserer Heldin<else>unseres Helden</if>.
#. fr: Retournons à Ishgard. Nos amis sont sans doute impatients d'apprendre l'issue du combat... et d'accueillir leur héro<if $gn4>ïne<else>s</if>.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_D00060_ALPHINAUD:1"
msgid "Let us return to Ishgard. Our friends will be eager to learn the battle's outcome...and welcome back their champion."
msgstr ""

#. ja: ……エスティニアンがいない？
#. de: Wo ist Estinien ...?
#. fr: Où est Estinien<nbsp>?
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_D00070_YSHTOLA:1"
msgid "Where is Estinien?"
msgstr ""

#. ja: イシュガルド建国史上において、<br>竜の背に乗って皇都に凱旋した者は、君が初めてだろうな。<br>……これもまた千年の後、伝説として語り継がれるのだろう。
#. de: Du bist wohl <if $gn4>die<else>der</if> Allererste, <if $gn4>die<else>der</if> jemals auf dem Rücken eines Drachen in unsere Stadt zurückgekehrt ist. Dieser Tag wird in die Geschichte eingehen!
#. fr: Je crois bien que vous êtes la première personne dans l'histoire d'Ishgard à entrer dans notre cité à dos de dragon. Ce moment restera dans les mémoires pour le millier d'années à venir.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00010_AYMERIC:1"
msgid "I daresay you are the first soul in Ishgardian history to arrive in our city upon dragonback. This scene shall be remembered for a thousand years to come."
msgstr ""

#. ja: 蛮神「ナイツ・オブ・ラウンド」と化した、<br>教皇トールダン7世は討たれた。
#. de: Es ist geschafft. Wir haben Papst Thordan aufgehalten.
#. fr: Comme nous le craignions, l'Archevêque avait invoqué l'âme du roi Thordan dans son propre corps et était devenu un Primordial.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00020_ALPHINAUD:1"
msgid "As we had feared, the archbishop summoned the soul of King Thordan unto himself and thence became a primal."
msgstr ""

#. ja: 光の戦士の手によって……ね。
#. de: <if $gn4>Die Kriegerin<else>Der Krieger</if> des Lichts, um genau zu sein.
#. fr: Mais lui et ses chevaliers ont été défaits par l<if $gn4>a<else>e</if> Guerri<if $gn4>ère<else>er</if> de la Lumière.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00030_YSHTOLA:1"
msgid "But he and his knights are no more, thanks to the Warrior of Light."
msgstr ""

#. ja: ……すべてが終わった訳ではないぞ、ヒトの子よ。
#. de: Noch ist nicht alles vorbei, Kinder Isghards.
#. fr: Vous n'êtes pas encore au bout de vos peines, mortels.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00040_MIDGARDSORMR:1"
msgid "Your struggles are not yet over, mortals."
msgstr ""

#. ja: 貴方は……。
#. de: Mit wem haben wir die Ehre?
#. fr: À qui ai-je l'honneur<nbsp>?<nbsp>...
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00050_AYMERIC:1"
msgid "Whom do I have the pleasure...?"
msgstr ""

#. ja: 我が名は、幻龍「ミドガルズオルム」……。<br>ハイデリンの使徒とともに旅し、<br>竜とヒトとの争いの行く末を見守ってきた……。
#. de: Ich bin Midgardsormr, der erste Drache. Ich habe Hydaelyns <if $gn4>Kriegerin<else>Krieger</if> begleitet und <if $gn4>ihre<else>seine</if> Taten im Kampf zwischen unseren Völkern beobachtet.
#. fr: Je suis Midgardsormr. J'ai voyagé avec l<if $gn4>a<else>e</if> champion<if $gn4>ne</if> d'Hydaelyn et observé ses actes dans le conflit entre les hommes et les dragons.
#. kind: other
#. macro: <if $gn4>her<else>his</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00060_MIDGARDSORMR:1"
msgid "I am Midgardsormr. I have journeyed with Hydaelyn's champion and observed <if $gn4>her<else>his</if> deeds in the conflict between man and dragon."
msgstr ""

#. ja: イシュガルドの民、トールダンの子らに問う。<br>お主たちは、再び、竜との調和を望むか？
#. de: Sagt mir, Kinder Thordans: Wollt ihr den Frieden mit den Drachen?
#. fr: Dis-moi, enfant de Thordan. Désires-tu vraiment la paix<nbsp>?
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00070_MIDGARDSORMR:1"
msgid "Tell me, children of Thordan. Do you desire peace?"
msgstr ""

#. ja: 人の戦いを導いてきた虚構は崩れ去りました。<br>そして、竜を率いてきたニーズヘッグもまた……。
#. de: Mein Volk hat un<shy>beschreib<shy>liche Verbrechen gegen das Eure begangen - und gegen unser eigenes. Ich wünschte, ich könnte all dies ungeschehen machen.
#. fr: Mon peuple a commis d'épouvantables atrocités contre les dragons... et même contre les siens. Si seulement nous pouvions réparer ces crimes...
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00080_AYMERIC:1"
msgid "My people have committed unspeakable atrocities against dragonkind─even against our own. Would that we could undo these wrongs...but we cannot."
msgstr ""

#. ja: 人は竜に対し、そして同じ人に対して、<br>幾たびも同じ過ちを繰り返してきました。<br>むろん、それを水に流してほしいとは申しません。
#. de: Es fällt schwer, solch abscheuliche Taten zu vergessen, und so denke ich, dass wir uns alle erinnern müssen. Ich habe das Lügengebäude zerstört, das meine Ahnen für unser Volk errichteten.
#. fr: Mais bien que le passé ne puisse être changé, l'avenir offre la chance de recommencer sur des bases nouvelles. Notre nation s'est libérée des chaînes d'une foi factice, et Nidhogg ne conduira plus les siens contre nous.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00090_AYMERIC:1"
msgid "Be that as it may, the future yet presents a chance to begin anew. Our nation has broken free of the shackles of a false faith, and Nidhogg shall lead his kindred against us no more."
msgstr ""

#. ja: それでも私は、この先のイシュガルドが、<br>人と竜が手を携える土地となれることを信じています。<br>……それでは、足りぬでしょうか？
#. de: Nidhogg, der den Feldzug für die Euren führte, ist gefallen. Wir haben viele Opfer zu beklagen, doch ich bin überzeugt davon, dass wir alle in diesem Land in Frieden zusammenleben können - Ishgarder wie Drachen.
#. fr: Je ne doute pas que cela nécessitera beaucoup d'efforts et de persévérance, mais j'ai la conviction qu'avec le temps, Ishgard redeviendra un endroit où les hommes et les dragons pourront vivre ensemble en harmonie.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00100_AYMERIC:1"
msgid "I doubt not that it will require much effort and perseverance, but 'tis my belief that, in time, Ishgard will again become a place where man and dragon may abide together in harmony."
msgstr ""

#. ja: ……その言葉、しかと我が胸に刻んだぞ。
#. de: Ich werde deine Worte nicht vergessen.
#. fr: Je n'oublierai pas tes paroles.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00110_MIDGARDSORMR:1"
msgid "I shall remember thy words."
msgstr ""

#. ja: だが、心せよ……。<br>我が子、ニーズヘッグの魂は死しておらぬ。
#. de: Aber bedenke, dass Nidhoggs Seele noch fortlebt.
#. fr: Sois pourtant averti<nbsp>: bien que Nidhogg n'ait plus d'enveloppe charnelle, son âme continue d'exister.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00120_MIDGARDSORMR:1"
msgid "Yet be warned: Nidhogg's soul liveth on."
msgstr ""

#. ja: ニーズヘッグの怨念に取り憑かれ、<br>蒼の竜騎士は堕ち、邪竜の影と化した……。
#. de: Euer Azur-Drachenreiter ist gefallen. Nidhoggs rachsüchtiger Geist ist in ihm. <i>Er</i> ist nun der Drache.
#. fr: Son immense colère a désormais pour vaisseau celui que vous appelez le Dragon céleste.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00130_MIDGARDSORMR:1"
msgid "His unbridled rage hath claimed for its vessel the one thou callest the Azure Dragoon."
msgstr ""

#. ja: まさか……エスティニアンが！？
#. de: Estinien?!
#. fr: Estinien<nbsp>!
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00140_AYMERIC:1"
msgid "Estinien!"
msgstr ""

#. ja: ニーズヘッグの眷属たちもまた、<br>我が子が発した復讐の咆哮に応えるであろう……。
#. de: Nidhogg wird die Seinen bald wieder rufen, und sie werden ihm folgen.
#. fr: Il ne fait aucun doute que d'ici peu, Nidhogg lancera un appel à ses semblables, et ils répondront à son rugissement vindicatif.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00150_MIDGARDSORMR:1"
msgid "Doubt not but that Nidhogg will call out to his brood ere long, nor that they shall answer him."
msgstr ""

#. ja: 戦火のすべてが消えたわけではない。<br>竜とヒト、その本当の試練はこれからなのだ。
#. de: Der Krieg ist noch nicht vorüber. Eure wahre Prüfung steht erst bevor.
#. fr: Armez-vous bien, car votre véritable épreuve vous attend.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00160_MIDGARDSORMR:1"
msgid "Steel yourselves, for the true test is yet to come."
msgstr ""

#. ja: それでも……。
#. de: Ich werde nicht aufgeben, noch wird mein Volk das tun.
#. fr: Quoi qu'il arrive, nous continuerons d'y croire.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00170_AYMERIC:1"
msgid "Come what may, we will never cease to believe."
msgstr ""

#. ja: 未来を信じて散っていった者たち……<br>そして、我が友らの魂に誓って、<br>私も、人も、諦めはしません。
#. de: Für all jene, die in der Hoffnung auf eine bessere Zukunft starben, und um unserer Freunde Seelen willen werden wir den Frieden erreichen.
#. fr: Au nom de tous ceux qui se sont sacrifiés pour rendre la paix possible, nous n'abandonnerons jamais notre cause.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00180_AYMERIC:1"
msgid "Upon the souls of they who have sacrificed themselves to pave the way for peace, we will never abandon our cause."
msgstr ""

#. ja: 千年の戦は、一朝一夕に終わるものではなかろう。<br>だからこそ、次の世代に希望を伝えよ、ヒトの子らよ……。
#. de: Ein tausendjähriger Krieg findet kein so schnelles Ende. Sieh zu, dass deine Überzeugung Generation um Generation weitergegeben wird.
#. fr: Une guerre de mille ans ne peut pas être arrêtée en une journée. Cela prendra peut-être des générations. Ce que tu as commencé, tes enfants devront le poursuivre.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00190_MIDGARDSORMR:1"
msgid "A thousand-year war cannot be ended in a day. It may take generations. What thou dost begin, thy children must continue."
msgstr ""

#. ja: その先にこそ……<br>光に満ちた、調和の時代が待っているのだから。
#. de: Dann wird am Horizont eine Zukunft erscheinen, die von Licht und Harmonie erfüllt ist.
#. fr: Confie-leur tes espoirs et tes rêves, pour que la paix puisse régner à nouveau... et pour toujours.
#. kind: other
msgctxt "cut_scene/030/VoiceMan_03007:TEXT_VOICEMAN_03007_E00200_MIDGARDSORMR:1"
msgid "Entrust unto them thy hopes and dreams, that peace may reign again...and forevermore."
msgstr ""
