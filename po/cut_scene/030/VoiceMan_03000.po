# cut_scene/030/VoiceMan_03000 · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 行くぞ、エンキドウ……我が友よ！
#. de: 行くぞ、エンキドウ……我が友よ！
#. fr: Allez, on y va, Enkidu, mon vieil ami<nbsp>!
#. speaker: GILGAMESH
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_000010_GILGAMESH:1"
msgid "To my side, Enkidu! The battle is joined!"
msgstr "Энкиду, ко мне! Бой начался!"

#. ja: やるじゃねぇか……エンキドウ、手当を頼むぜ！
#. de: やるじゃねぇか……エンキドウ、手当を頼むぜ！
#. fr: C'est qu'ils n'y vont pas de main morte<nbsp>!<nbsp>... Enkidu, soigne-moi<nbsp>!
#. speaker: GILGAMESH
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_000020_GILGAMESH:1"
msgid "Owww! It hurts! It hurts!Enkidu! Your master wants for succor!"
msgstr "Ай! Больно! Больно! Энкиду, хозяину срочно нужна помощь!"

#. ja: 鶏になっちまえ！
#. de: 鶏になっちまえ！
#. fr: Par ici, mes petits poulets<nbsp>!
#. speaker: GILGAMESH
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_000030_GILGAMESH:1"
msgid "Fancy some feathers...bird brain?"
msgstr "Пёрышек не хочешь, куриные мозги?"

#. ja: 人形と遊んでな！
#. de: 人形と遊んでな！
#. fr: Retournez jouer à la poupée<nbsp>!
#. speaker: GILGAMESH
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_000040_GILGAMESH:1"
msgid "This should cut you down to size..."
msgstr "А теперь уменьшитесь-ка в размерах..."

#. ja: エンキドウ！　後はお前に任せたぜ！
#. de: エンキドウ！　後はお前に任せたぜ！
#. fr: Enkidu<nbsp>! Prends la relève<nbsp>!
#. speaker: GILGAMESH
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_000050_GILGAMESH:1"
msgid "Fight on, Enkidu, my ever faithful─hm!?"
msgstr "Держись, Энкиду, мой верный друг... а?"

#. ja: ありゃ……エンキドウ……？<br>置いてけぼりは、なしだぜー！？<br>これが本当、本気の……最後の戦いだぜ！
#. de: ありゃ……エンキドウ……？<br>置いてけぼりは、なしだぜー！？<br>これが本当、本気の……最後の戦いだぜ！
#. fr: Enkidu<nbsp>!? Tu ne vas pas me lâcher maintenant<nbsp>!?
#. speaker: GILGAMESH
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_000060_GILGAMESH:1"
msgid "Enkidu! Are the bonds of our friendship so fragile!?"
msgstr "Энкиду! Неужели наша дружба так мало для тебя значит!?"

#. ja: くらえ、マサムネ！
#. de: くらえ、マサムネ！
#. fr: Goûtez au tranchant de Masamune<nbsp>!
#. speaker: GILGAMESH
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_000070_GILGAMESH:1"
msgid "Not the <i>strongest</i> of swords, but it should suffice."
msgstr "Меч не <i>самый сильный</i>, но сойдёт."

#. ja: 剣の舞い！
#. de: 剣の舞い！
#. fr: Et maintenant, la danse du sabre<nbsp>!
#. speaker: GILGAMESH
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_000080_GILGAMESH:1"
msgid "Gilgamesh is in the mood...for dancing!"
msgstr "Гильгамеш в настроении... потанцевать!"

#. ja: 秘技…我流雪月花！
#. de: 秘技…我流雪月花！
#. fr: Admirez la beauté mortelle de Neige, Lune et Fleurs<nbsp>!
#. speaker: GILGAMESH
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_000090_GILGAMESH:1"
msgid "Divide and conquer, Gilgamesh style!"
msgstr "Разделяй и властвуй — по-гильгамешски!"

#. ja: うりゃっ、電撃！
#. de: うりゃっ、電撃！
#. fr: On dirait bien que vous avez le coup de foudre<nbsp>!
#. speaker: GILGAMESH
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_000100_GILGAMESH:1"
msgid "...And now for something truly <i>shocking</i>!"
msgstr "...А теперь кое-что по-настоящему <i>потрясающее</i>!"

#. ja: そぉれ、大捕物！
#. de: そぉれ、大捕物！
#. fr: Et hop, un joli coup de filet<nbsp>!
#. speaker: GILGAMESH
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_000110_GILGAMESH:1"
msgid "What's the matter, friend? All tied up?"
msgstr "Что такое, друг? Связался не с тем?"

#. ja: いでよ、雲蒸竜変！
#. de: いでよ、雲蒸竜変！
#. fr: Prenez ça... Fléau du dragon<nbsp>!
#. speaker: GILGAMESH
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_000120_GILGAMESH:1"
msgid "Uh-oh! Someone just woke the dragon..."
msgstr "Ой-ой! Кто-то только что разбудил дракона..."

#. ja: なかなかやるじゃねぇか！<br>だが……オレたちの戦いは、まだ始まったばかりだ！
#. de: なかなかやるじゃねぇか！<br>だが……オレたちの戦いは、まだ始まったばかりだ！
#. fr: Pas mal<nbsp>! Pas mal<nbsp>! Mais le combat ne fait que commencer<nbsp>!
#. speaker: GILGAMESH
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_000130_GILGAMESH:1"
msgid "You have some skill, I'll give you that...<br>But Gilgamesh has only just begun to fight!"
msgstr "Ты неплохо дерёшься, признаю...<br>Но Гильгамеш только-только начал!"

#. ja: じ、上等だ……よぉし！<br>ここからは、お互い出し惜しみはナシだぜ！？
#. de: じ、上等だ……よぉし！<br>ここからは、お互い出し惜しみはナシだぜ！？
#. fr: Raaah<nbsp>! C'est moins facile que prévu... Allez, pas de quartier<nbsp>!
#. speaker: GILGAMESH
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_000140_GILGAMESH:1"
msgid "Most impressive!<br>Very well─I, too, shall fight with all my strength!"
msgstr "Впечатляет!<br>Что ж... теперь и я буду драться в полную силу!"

#. ja: まだだ……まだ、戦いは終わっちゃいねぇ！！
#. de: まだだ……まだ、戦いは終わっちゃいねぇ！！
#. fr: Je... je n'ai pas dit mon dernier mot<nbsp>!
#. speaker: GILGAMESH
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_000150_GILGAMESH:1"
msgid "No! The mighty Gilgamesh will not be defeated!"
msgstr "Нет! Великий Гильгамеш ещё не побеждён!"

#. ja: こうして お前とやりあうのも二度目か――<br>へへっ なんだか嬉しいじゃねぇか！
#. de: Wie schön, dass du meiner Einladung gefolgt bist!
#. fr: <split " " 1><string $gs1></split>, je suis tellement heureux de pouvoir vous affronter à nouveau<nbsp>!
#. speaker: GILGAMESH
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_100010_GILGAMESH:1"
msgid "At long last, we meet again on the battlefield!<br>I daresay Enkidu shall come to enjoy our tussles as much as I."
msgstr "Наконец-то мы снова встретились на поле боя!<br>Пожалуй, Энкиду наши схватки понравятся не меньше, чем мне."

#. ja: ここなら思う存分にやれるってもんだ！<br>オレたち最強コンビの力を見せてやる！
#. de: Hier können Enkidu und ich uns richtig austoben!<br>Dir werden die Ohren schlackern!
#. fr: Je crois que ce vieux château en ruine est l'endroit idéal pour une revanche. Enkidu et moi, nous allons vous montrer de quoi nous sommes capables<nbsp>!
#. speaker: GILGAMESH
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_100020_GILGAMESH:1"
msgid "<i>You</i>, however, might not find this one so enjoyable.<br>...Unless you enjoy getting pounded senseless. Hah!"
msgstr "<i>Тебе</i> эта схватка может не так понравиться.<br>...Если только ты не любишь, когда тебя избивают до потери сознания. Ха!"

#. ja: ワッハッハ このオレが逃げたとでも思ったか！？<br>決着を付けるために ここで待ってたんだ！
#. de: Dachtest du etwa, ich wollte fliehen?<br>Hab nur ein gemütlicheres Plätzchen gesucht!
#. fr: Mouahahaha<nbsp>! Vous croyiez peut-être que j'allais m'échapper<nbsp>!?<br>Non, Gilgamesh ne fuit jamais devant un adversaire<nbsp>! C'est pour vous infliger le coup de grâce que je suis venu ici<nbsp>!
#. speaker: GILGAMESH
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_200010_GILGAMESH:1"
msgid "<i>Me</i>? Run away? Hah! I-I was but seeking out a<br>more suitable spot to celebrate my inevitable victory!"
msgstr "<i>Я</i>? Убежать? Ха! Я... я лишь подыскивал место получше, чтобы отметить свою неминуемую победу!"

#. ja: オレさまの「真の力」を とくと味わうがいいぜ！
#. de: Ich werde dir zeigen, was in mir steckt!
#. fr: Vous allez voir de quoi je suis vraiment capable<nbsp>!
#. speaker: GILGAMESH
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_200020_GILGAMESH:1"
msgid "But enough exposition! Now we fight like men!<br>And ladies! And ladies who dress like men!"
msgstr "Хватит разговоров! Теперь сразимся по-мужски!<br>И по-женски! И по-мужски, переодетому женщиной!"

#. ja: 真ギルガメッシュ・チェーーーーーーンジ！！
#. de: Gilgamesch-Metamorphooose!
#. fr: Tremblez devant le VRAI Gilgamesh<nbsp>!
#. speaker: GILGAMESH
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_200030_GILGAMESH:1"
msgid "For Gilgamesh...it is transmogrifying time!"
msgstr "Гильгамеш... настало время преображения!"

#. ja: これなるはエオルゼアいちの強者 その名も剣豪ギルガメッシュ！<br>――いざ参る！
#. de: Ich bin Gilgamesch, der stärkste Schwertkämpfer Eorzeas!<br>Möge der Kampf beginnen!
#. fr: Il n'est de plus puissant bretteur que moi<nbsp>! Vous allez en avoir la preuve<nbsp>!
#. speaker: GILGAMESH
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_200040_GILGAMESH:1"
msgid "The mightiest warrior ever to grace Eorzea stands before you─<br>by which I mean <i>I</i>, Gilgamesh! Prepare yourself!"
msgstr "Перед вами величайший воин, когда-либо ступавший на землю Эорзеи —<br>то есть <i>я</i>, Гильгамеш! Приготовься!"

#. ja: まさか ここまでとは<br>6本も手を増やしたのに 手も足も出なかったぜ
#. de: Selbst mit acht Armen bin ich dir nicht gewachsen.
#. fr: Incroyable<nbsp>! Même avec quatre paires de bras, je n'arrive pas à vous battre<nbsp>!
#. speaker: GILGAMESH
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_300010_GILGAMESH:1"
msgid "To think that my full complement of arms would avail me naught..."
msgstr "Подумать только, все мои руки оказались бесполезны..."

#. ja: オレが悪かった もう悪さはしねぇ
#. de: Also gut, ich gebe auf. Du hast mich überzeugt.
#. fr: Je... je suis désolé... Je vous promets que je ne ferai plus rien de mal.
#. speaker: GILGAMESH
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_300020_GILGAMESH:1"
msgid "No more high jinks from Gilgamesh. You have my word."
msgstr "Больше никаких проказ от Гильгамеша. Даю слово."

#. ja: その誓いに 「契約の剣」はちゃんと返す<br>近くの森に隠してあるから 探してほしい
#. de: Das Schwert des Paktes geb ich euch auch zurück.<br>Ich habe es vor den Ruinen im Wald versteckt.
#. fr: Pour vous le prouver, je vais vous rendre l'Épée du Pacte. Elle est cachée dans la forêt, près d'ici.
#. speaker: GILGAMESH
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_300030_GILGAMESH:1"
msgid "The Treaty-Blade, too, I shall return.<br>...Just as soon as I remember where I hid it."
msgstr "Клинок Договора я тоже верну.<br>...Как только вспомню, куда его спрятал."

#. ja: だから頼む！<br>このとおりだ ゆるしてくれ！
#. de: Bitte, verschone mich. Ich flehe dich an!
#. fr: Je vous en supplie<nbsp>! Pardonnez-moi<nbsp>!
#. speaker: GILGAMESH
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_300040_GILGAMESH:1"
msgid "Anyway, I yield to your unparalleled puissance!<br>Spare my insignificant life, I beg of you!"
msgstr "В общем, сдаюсь перед твоим несравненным могуществом!<br>Пощади мою ничтожную жизнь, прошу!"

#. ja: ってのは 半分ウソだけどな！
#. de: Als würde ich jemals aufgeben!
#. fr: Ils ne croyaient quand même pas que cette vieille relique m'intéressait<nbsp>!?
#. speaker: GILGAMESH
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_400010_GILGAMESH:1"
msgid "...NOT! Ha, I lied...again! Like a rug! Oh, I kill me!"
msgstr "...Да нет, соврал! Опять! Ха! Вот умора!"

#. ja: あんな古い剣なんていらねぇよ ぺっ！<br>オレがほしいのは最強の武器だからな！
#. de: Das olle Schwert ist mir doch völlig egal!<br>Nur die stärksten Waffen sind gut genug für Gilgamesch!
#. fr: Moi, ce que je veux, ce sont les armes les plus puissantes d'Éorzéa<nbsp>!
#. speaker: GILGAMESH
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_400020_GILGAMESH:1"
msgid "You can take that fusty old blade for all I care! I thirst for <i>true</i><br>power, and naught save the strongest of swords will suffice!"
msgstr "Забирай этот старый хлам, мне не жалко! Я жажду <i>истинной</i><br>силы, а для этого годятся только самые мощные мечи!"

#. ja: 光の戦士 気持ちのいい武人だったぜ<br>ようし 次に戦うときは 絶対に負けねぇぞ！
#. de: Immerhin habe ich einen würdigen Gegner gefunden!<br>Ich freue mich schon auf unser nächstes Treffen!
#. fr: Je dois dire que ce<if $gn4>tte Guerrière<else> Guerrier</if> de la Lumière est vraiment un adversaire redoutable... Mais la prochaine fois, c'est moi qui gagnerai<nbsp>! Foi de Gilgamesh<nbsp>!
#. speaker: GILGAMESH
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_400030_GILGAMESH:1"
msgid "Warrior of Light─you have proven a worthy opponent.<br>But I warn you─treasure every moment with your weapon."
msgstr "Воин Света, ты доказал, что достоин сражаться со мной.<br>Но вот что скажу: цени каждое мгновение со своим оружием."

#. ja: いつかお前らの武器もいただくからな！<br>それまで あばよっ！
#. de: Eines Tages schnapp ich mir auch deine Waffe!<br>Ach was, dein ganzes Arsenal!
#. fr: Et toutes leurs armes seront à moi<nbsp>! On se reverra bientôt<nbsp>!
#. speaker: GILGAMESH
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/030/VoiceMan_03000:TEXT_VOICEMAN_03000_400040_GILGAMESH:1"
msgid "For as sure as day follows night, the hour will come when<br>I claim it as mine own! Till we meet again!"
msgstr "Когда-нибудь я заберу и твоё оружие!<br>До встречи!"
