# cut_scene/070/VoiceMan_07005 · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: あなたは……！<br>どうしてここに……！？
#. de: He! Was machst du denn hier?
#. fr: Tu... Tu es <if $gn4>revenue<else>revenu</if><nbsp>!
#. speaker: KOANA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000010_KOANA:1"
msgid "You are returned!"
msgstr "Ты вернулся!"

#. ja: すぐに下ります！
#. de: Gib mir einen Moment! Ich bin sofort bei dir!
#. fr: Ne bouge pas, j'arrive<nbsp>!
#. speaker: KOANA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000020_KOANA:1"
msgid "Wait there, I'm coming down!"
msgstr "Подожди там, я спускаюсь!"

#. ja: あの、ラマチは……？<br>ドーム内で何かあったのですか！？
#. de: Wo ist Lamaty'i? Und was ist in der Kuppel vorgefallen?
#. fr: Lamaty'i n'est pas avec toi<nbsp>!? Que s'est-il passé dans le dôme<nbsp>?
#. speaker: KOANA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000030_KOANA:1"
msgid "Where's Lamaty'i? What happened inside the dome?"
msgstr "Где Ламатъи? Что случилось внутри купола?"

#. ja: そうですか、兄さんが……。
#. de: Dass es so weit kommen musste, Bruder<nbsp>...
#. fr: Les ambitions de mon frère ont finalement eu raison de lui...
#. speaker: KOANA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000040_KOANA:1"
msgid "So my brother is gone..."
msgstr "Значит, брата больше нет..."

#. ja: とはいえ、まだ真に問題は解決しておらず、<br>異界への遠征が控えているということですね……。
#. de: Aber vorbei scheint es damit ja noch nicht zu sein. Euch steht also eine Expedition in eine fremde Dimension bevor. Unglaublich<nbsp>...
#. fr: Mais la véritable menace subsiste, et vous devez voyager dans un autre monde pour l'écarter définitivement...
#. speaker: KOANA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000050_KOANA:1"
msgid "Yet the danger remains, and you must soon sally forth unto an unknown reality..."
msgstr "Но опасность всё ещё не миновала, и скоро вам предстоит отправиться в неизвестный мир..."

#. ja: (-ウクラマトの声-)おーい、コーナ兄さん！
#. de: (-Wuk Lamats Stimme-)He, Brüderchen!
#. fr: (-Voix de Wuk Lamat-)Koana<nbsp>! Hé, frérot<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000060_WUKLAMAT:1"
msgid "(-Wuk Lamat-)Hey! Koana!"
msgstr "(-Вук Ламат-)Эй, Коана!"

#. ja: ラマチ、その子はいったい……？
#. de: Wen hast du denn da mitgebracht, Lamaty'i?
#. fr: Lamaty'i, qui est cet enfant<nbsp>?
#. speaker: KOANA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000070_KOANA:1"
msgid "Lamaty'i... Is this boy perhaps...?"
msgstr "Ламатъи... А этот мальчик кто?"

#. ja: こいつの名はグルージャ。<br>ゾラージャ兄さんの子さ。
#. de: Der Kleine hier ist Gulool Ja<nbsp>- Zoraal Jas Sohn.
#. fr: Je te présente Gulool Ja, le fils de Zoraal Ja.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000080_WUKLAMAT:1"
msgid "This is Zoraal Ja's son, Gulool Ja."
msgstr "Это Гулул Джа, сын Зораал Джа."

#. ja: ……そうか。<br>ドームの内外では、時間にズレが生じていたのでしたね。
#. de: Verstehe<nbsp>... Ihr meintet schließlich, die Zeit in der Kuppel fließe schneller als außerhalb, richtig?
#. fr: Je vois. Voilà une preuve indiscutable que le temps s'écoule plus rapidement dans le dôme.
#. speaker: KOANA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000090_KOANA:1"
msgid "I see. Time did flow differently inside the dome."
msgstr "Понятно... Время внутри купола и правда шло иначе."

#. ja: その子が兄さんの子だというなら……僕にとって……
#. de: Der Sohn unseres Bruders<nbsp>... damit wäre ich ja<nbsp>...
#. fr: S'il est le fils de notre frère, alors ça fait de moi...
#. speaker: KOANA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000100_KOANA:1"
msgid "If he is our brother's child, then..."
msgstr "Если он сын нашего брата, значит, я ему..."

#. ja: グルージャ……だったね。<br>僕はコーナ、ラマチの兄さ。
#. de: Gulool Ja, richtig? Ich bin Koana, Lamaty'is großer Bruder.
#. fr: Tu t'appelles Gulool Ja, c'est ça<nbsp>? Mon nom est Koana, je suis le grand frère de Lamaty'i.
#. speaker: KOANA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000110_KOANA:1"
msgid "Gulool Ja, was it? My name is Koana, and I am Lamaty'i's brother."
msgstr "Гулул Джа, верно? Я Коана, брат Ламатъи."

#. ja: ラマチの、お兄さん……。
#. de: Ihr<nbsp>... Ihr großer Bruder?
#. fr: Le grand frère de... Lamaty'i<nbsp>?
#. speaker: GULOOLJA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000120_GULOOLJA:1"
msgid "You're her brother...?"
msgstr "Ты... её брат?"

#. ja: コーナ兄さんほど、頼りになる存在はいねぇ。<br>きっとお前にとっても、いい家族になってくれるさ。
#. de: Auf niemanden ist so viel Verlass wie auf Koana, Kleiner! Er wird sich genauso gut um dich kümmern wie wir alle. Als Familie!
#. fr: Y a pas plus digne de confiance que Koana. Maintenant que tu fais partie de notre famille, il prendra soin de toi.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000130_WUKLAMAT:1"
msgid "You'll find none more dependable than Koana. He's family, and he'll take good care of you."
msgstr "Надёжнее Коаны не найти. Он теперь твоя семья и позаботится о тебе."

#. ja: よろしく、グルージャ。
#. de: Freut mich, dich kennenzulernen, Gulool Ja.
#. fr: Ravi de te rencontrer, Gulool Ja.
#. speaker: KOANA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000140_KOANA:1"
msgid "A pleasure to meet you, Gulool Ja."
msgstr "Рад знакомству, Гулул Джа."

#. ja: じゃあ、コーナ叔父さんだね！
#. de: Dann bist du jetzt mein „Onkel Koana“!
#. fr: Moi aussi, ja... Tonton Koana<nbsp>!
#. speaker: GULOOLJA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000150_GULOOLJA:1"
msgid "A pleasure to meet you too, uh...Uncle Koana."
msgstr "И я рад... дядя Коана!"

#. ja: た、たしかに叔父さんで間違いないが……
#. de: O-Onkel?! Nun ja, ich schätze, das stimmt, aber<nbsp>...
#. fr: Euh, ef<shy>fec<shy>ti<shy>ve<shy>ment, je suis bien ton oncle...
#. speaker: KOANA
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000160_KOANA:1"
msgid "Well, I suppose I <i>am</i> your uncle..."
msgstr "Что ж, я и правда <i>твой</i> дядя..."

#. ja: どうかコーナと呼んでほしい。
#. de: ... Koana genügt vollkommen. Wir wollen es schließlich nicht übertreiben, hm?
#. fr: Mais je préfère “Koana” tout court, si tu veux bien.
#. speaker: KOANA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000161_KOANA:1"
msgid "But simply Koana will do."
msgstr "Но просто Коаной меня зови."

#. ja: みんなも混乱させちまったよな。<br>すべて解決したら、ちゃんと説明するからよ。
#. de: Ich weiß, ihr seid bestimmt schrecklich verwirrt. Später werde ich alles genauer erklären.
#. fr: Vous devez vous poser des questions... Ne vous inquiétez pas, je vous expliquerai tout le moment venu.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000170_WUKLAMAT:1"
msgid "You're all confused, and little wonder. Rest assured all will be explained in due course."
msgstr "Вы все, небось, совсем запутались. Когда всё уладится, я вам всё объясню."

#. ja: ただ、これだけは言っておきたい。
#. de: Eine Sache möchte ich trotzdem klarstellen. Hier und jetzt.
#. fr: Mais en attendant, je voudrais qu'on se mette tous d'accord sur un truc.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000180_WUKLAMAT:1"
msgid "But for now, I want to make one thing clear."
msgstr "Но пока хочу кое-что прояснить."

#. ja: グルージャは、グルージャだ。<br>父親の罪と何の関係もねぇ。<br>そのことだけは、どうかわかってほしい。
#. de: Gulool Ja ist und bleibt er selbst. Die Verbrechen seines Vaters haben rein gar nichts mit ihm zu tun.
#. fr: Gulool Ja n'est qu'un enfant, et il n'est en aucun cas responsable des agissements de son père.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000190_WUKLAMAT:1"
msgid "Gulool Ja is his own person. He had no part in his father's crimes."
msgstr "Гулул Джа — сам по себе. Он не виноват в преступлениях отца."

#. ja: ゾラージャ兄さんのことでぶつけたい想いがあれば、<br>連王のアタシらがいくらでも聞くからよ！
#. de: Und falls jemand seinem Unmut über Zoraal Ja Luft machen muss<nbsp>- dann kommt zu uns. Als Thronerben sind mein Bruder und ich immer zur Stelle.
#. fr: Si quelqu'un a la moindre doléance au sujet de Zoraal Ja, qu'il vienne s'adresser à moi, ou à mon frère Koana<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000200_WUKLAMAT:1"
msgid "If you have anger towards Zoraal Ja you need to express, Koana and I will gladly hear you. But you will treat Gulool Ja as you would any child─with kindness."
msgstr "Если вам нужно высказать всё, что накипело из-за Зораал Джа, мы с Коаной вас выслушаем. Но к Гулул Джа относитесь по-доброму, как к любому ребёнку."

#. ja: そうだな……子どもに罪はない。
#. de: Richtig so. Der Knirps kann ja nichts für seinen Vater<nbsp>...
#. fr: C'est vrai... Le petit garçon n'y est pour rien.
#. speaker: TULIYOLLALMALE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000210_TULIYOLLALMALE:1"
msgid "As we should. The boy's done no wrong."
msgstr "И правильно. Мальчик ни в чём не виноват."

#. ja: ええ、ウクラマト様の言うとおりだわ！
#. de: Genau! Weise Worte von der Krone des Mutes!
#. fr: Oui<nbsp>! L'Aurarque de la Force a tout à fait raison<nbsp>!
#. speaker: TULIYOLLALFEMALE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000220_TULIYOLLALFEMALE:1"
msgid "Yes, the Vow of Resolve speaks true!"
msgstr "Да! Вук Ламат говорит верно!"

#. ja: ともかく……話を聞かせてもらえるかな？<br>グ・ラハ・ティア殿からも報告は受けていたが、<br>改めて事の顛末を知りたいんだ。
#. de: Wäre dann bitte jemand so freundlich, mich in die Einzelheiten einzuweihen? G'raha Tia hat mir mit seinem Bericht eine grobe Übersicht verschafft, aber es gibt sicherlich noch mehr, was ich wissen sollte.
#. fr: Alors, voulez-vous bien me raconter ce qui est arrivé<nbsp>? J'ai déjà parlé avec G'raha Tia, mais j'aimerais entendre de plus amples ex<shy>pli<shy>ca<shy>tions.
#. speaker: KOANA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000230_KOANA:1"
msgid "So...will you tell me what happened? G'raha Tia has given me a summary, but I would hear your detailed accounts."
msgstr "Ну... расскажете, что произошло? Г'раха Тиа уже поделился со мной кратким отчётом, но я хочу узнать всё в подробностях."

#. ja: それじゃあ、少し歩きながら話さないか？<br>トライヨラの様子を見てまわりたくてさ。
#. de: Wie wär's dann mit einem kleinen Spaziergang? Ich würde mir gerne ein Bild von der aktuellen Lage der Stadt machen.
#. fr: Ça te dérange qu'on discute en marchant<nbsp>? Je veux voir dans quel état est la ville.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000240_WUKLAMAT:1"
msgid "Can we walk while we chat? I want to see how things are in the city."
msgstr "Может, поговорим на ходу? Хочу посмотреть, как там город."

#. ja: では、ブライトプルーム・ポストへ向かおう。
#. de: In dem Fall sollten wir zunächst dem Grellfeder-Posten einen Besuch abstatten.
#. fr: Très bien. Dans ce cas, dirigeons-nous vers la Vigie de Claireplume.
#. speaker: KOANA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000250_KOANA:1"
msgid "In that case, let us make our way to Brightploom Post."
msgstr "Тогда пойдём на Пост Яркого пера."

#. ja: 兵たちは未だ警戒態勢を続けているんだ。<br>さらなる攻撃の心配がなくなったのなら、<br>交代で休むように伝えて、労わってやらないと。
#. de: Unsere Soldaten dort befinden sich noch immer in Alarm<shy>bereit<shy>schaft. Doch nun, wo die Gefahr einer Invasion gebannt scheint, ist es allerhöchste Zeit, ihnen eine wohlverdiente Ruhepause zu gönnen.
#. fr: Nos soldats sont toujours sur le qui-vive, mais puisque le danger est passé, je vais les inviter à prendre un repos bien mérité.
#. speaker: KOANA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000260_KOANA:1"
msgid "Our soldiers remain on high alert, but if the threat of invasion has passed, I will bid them take a well-earned rest."
msgstr "Наши солдаты всё ещё настороже. Раз опасность вторжения миновала, надо велеть им отдыхать по очереди. Они заслужили передышку."

#. ja: 周囲を埋め尽くすエレクトロープに、<br>膨大な雷属性の力が溜め込まれているのが視えるわ。<br>この機構は「生きて」いる……。
#. de: Elektrob so weit das Auge reicht und eine gewaltige Menge Blitzenergie<nbsp>... Zumindest scheint hier noch alles funktionstüchtig zu sein.
#. fr: De l'électrope à perte de vue, chargé à bloc d'éther de foudre ex<shy>trê<shy>me<shy>ment intense... On pourrait presque croire que cet endroit est vivant.
#. speaker: YSHTOLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000270_YSHTOLA:1"
msgid "Electrope everywhere one turns, harboring vast amounts of lightning... This place is very much alive."
msgstr "Электроп вокруг видимо-невидимо, и в нём скопилось огромное количество молнии... Это место словно живое."

#. ja: クルル、耳飾りを端末にかざしてみてもらえるかしら？
#. de: Krile, versuch doch bitte einmal, den Ohrring an die Konsole zu halten.
#. fr: Krile, tu veux bien approcher ta boucle d'oreille du capteur, s'il te plaît<nbsp>?
#. speaker: YSHTOLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000280_YSHTOLA:1"
msgid "Krile, try holding your earring to the terminal."
msgstr "Крилэ, поднеси, пожалуйста, серьгу к терминалу."

#. ja: だめなの……？
#. de: Haben wir uns etwa geirrt?
#. fr: Ça ne fonctionne pas...
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000290_KRILE:1"
msgid "No luck..."
msgstr "Не вышло..."

#. ja: 落胆するにはまだ早いですよ。<br>反応したってことは、コードの読み取り自体はできてるはず。<br>ただ、より上位の権限によって、実行が阻害されているのかも。
#. de: Es ist noch ein bisschen zu früh, um aufzugeben, meinst du nicht? Immerhin hat die Konsole ja schon mal reagiert. Vielleicht fehlt einfach die nötige Befugnis.
#. fr: Pourtant, il y a bien eu une réaction. Le système a reconnu le code, mais nous avons peut-être besoin d'un niveau d'au<shy>to<shy>ri<shy>sa<shy>tion plus élevé.
#. speaker: SHALE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000300_SHALE:1"
msgid "Don't give up yet. The terminal reads the code─it might just need higher clearance."
msgstr "Не спеши отчаиваться. Терминал считал код, ему, возможно, просто нужны права повыше."

#. ja: グルージャ、あなたが試してみてくれますか？
#. de: Gulool Ja! Versuch du es doch mal!
#. fr: Gulool Ja, tu veux bien essayer<nbsp>?
#. speaker: SHALE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000310_SHALE:1"
msgid "Gulool Ja, would you give it a try?"
msgstr "Гулул Джа, попробуешь?"

#. ja: え……僕が……？
#. de: I-Ich?!
#. fr: Hein<nbsp>? Moi...<nbsp>?
#. speaker: GULOOLJA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000320_GULOOLJA:1"
msgid "Me?"
msgstr "Я?.."

#. ja: 「武王」の権限が正しく継承されてるなら、<br>扉が開くはずです。
#. de: Als Erbe der Krone des Mutes müsstest du jetzt auch Zugriff auf alle möglichen Sachen haben. Die Pforte sollte sich von dir öffnen lassen.
#. fr: Si tu as bien hérité de l'autorité du souverain de la Force, le portail devrait s'ouvrir.
#. speaker: SHALE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000330_SHALE:1"
msgid "If the king's authority has passed to you, then the gate ought to open."
msgstr "Если власть короля перешла к тебе, ворота должны открыться."

#. ja: (-ゾラージャ-)ただ、俺が生き、勝ち得たものは置いていく。<br>受け継ぐなり、見捨てていくなりするがいい……。
#. de: (-Zoraal Ja-)Aber jetzt hinterlasse ich dir mein Leben<nbsp>... meinen Pfad. Ob du ihn fortschreitest<nbsp>... liegt allein bei dir<nbsp>...
#. fr: (-Zoraal Ja-)Tout ce que je peux faire ici et maintenant, c'est te léguer ce que j'ai conquis à la sueur de mon front depuis mon plus jeune âge. À toi de l'accepter... ou de le rejeter à ton tour...
#. speaker: ZORAALJA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000331_ZORAALJA:1"
msgid "(-Zoraal Ja-)But I leave behind that which I've gained by the sweat of my brow... It is yours to embrace...or spurn..."
msgstr "(-Зораал Джа-)Но я оставляю тебе то, чего добился потом и кровью... Прими это... или отвергни..."

#. ja: うわあっ！？
#. de: Uwaaah!
#. fr: Ouah<nbsp>!
#. speaker: GULOOLJA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000340_GULOOLJA:1"
msgid "Uwaaah!"
msgstr "А-а-а!"

#. ja: 本当に……耳飾りが……。
#. de: Der Ohrring<nbsp>... Dann ist es also tatsächlich wahr<nbsp>...
#. fr: La boucle d'oreille... C'était bien elle...
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000350_KRILE:1"
msgid "The earring... It really was..."
msgstr "Серьга... Значит, и правда..."

#. ja: 見事なものね……。<br>次元の壁に膨大なエーテルをぶつけて、<br>無理やりにこじ開けたヴォイドゲートとは根本的に違う。
#. de: Faszinierend, es unterscheidet sich auf fundamentale Weise von einem Nichtsportal. Ein solches muss mit gezieltem Einsatz von Äther aufgerissen werden.
#. fr: C'est fascinant... Rien à voir avec notre porte du néant qui forçait le passage à grands coups d'éther.
#. speaker: YSHTOLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000360_YSHTOLA:1"
msgid "Remarkable... A voidgate is forced open with a blast of aether, and thus appears as a tear in the fabric of reality."
msgstr "Поразительно... Ничего общего с вратами Бездны, которые разрывают ткань реальности мощным выбросом эфира."

#. ja: 歪みが一切感じられず、正しく世界の接点が生じている。<br>これがかつて、「世界を繋ぐ力」で開かれたもの……。
#. de: Aber dies hier ist ein vollkommener Übergang zwischen den Dimensionen<nbsp>- ganz ohne störende Verzerrungen. Mit anderen Worten: Ein perfektes Portal. <i>Das</i> ist also die Weltenfusion.
#. fr: Je ne ressens aucune perturbation, comme si les dimensions étaient par<shy>fai<shy>te<shy>ment juxtaposées l'une à l'autre. C'est donc ça, le pouvoir de relier les mondes...
#. speaker: YSHTOLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000370_YSHTOLA:1"
msgid "In contrast, this is the stitchwork of a master. Neatly hemmed, without a thread out of place. A power to be reckoned with..."
msgstr "Здесь нет ни малейшего искажения — миры соприкоснулись ровно как надо. Вот она, сила, способная соединять миры..."

#. ja: いえ、感心している場合ではないわね。<br>グルージャの権限によって扉を開けたということは、<br>同等の権限を持つスフェーンなら、閉じることもできるはず。
#. de: Allerdings ist das wohl nicht der rechte Zeitpunkt für weitschweifende Erklärungen. Wenn Gulool Ja das Portal öffnen konnte, sollte es Sphene als Krone der Weisheit auch wieder schließen können.
#. fr: Mais nous avons mieux à faire que de nous émerveiller devant cette technologie. Si Gulool Ja a pu ouvrir ce passage, cela signifie que Sphene est aussi capable de le refermer.
#. speaker: YSHTOLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000380_YSHTOLA:1"
msgid "But now isn't the time to marvel. If Gulool Ja can open the gate, then so too can Sphene close it."
msgstr "Но сейчас не время восхищаться. Если Гулул Джа может открыть врата, значит, и Сфен сможет их закрыть."

#. ja: つまり、こちら側から扉に対して、<br>固定化の術と、干渉防御の術をかけ続ける必要がある。
#. de: Uns bleibt somit nicht viel Zeit. Wir benötigen jemanden, der das Portal aufrechterhält, und jemanden, der jegliche Störversuche abwehrt.
#. fr: Je suggère que nous prenions quelques précautions... D'une part en stabilisant l'état du portail, et d'autre part en le protégeant contre d'éventuelles in<shy>ter<shy>ven<shy>tions malveillantes.
#. speaker: YSHTOLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000390_YSHTOLA:1"
msgid "'Twould be wise to employ magicks in its defense─both to maintain its stability and ward off interference."
msgstr "Значит, с нашей стороны нужно поддерживать врата и защищать их от любого вмешательства."

#. ja: 術式そのものは構築できているけれど、<br>私ひとりでは長時間の維持が難しい……。<br>互いをよく知り、息を合わせることのできる協力者がいるわ。
#. de: Ich bin zwar in der Lage, diese Magie zu wirken, aber auf Dauer kann ich das Portal nicht alleine aufrechterhalten. Ich brauche Unterstützung<nbsp>- jemanden, dem ich vertrauen kann.
#. fr: Je peux élaborer l'incantation nécessaire, mais je serai incapable de la maintenir active toute seule. Pour cela, il me faudra l'aide d'une personne versée dans la magie et capable de canaliser son énergie en tandem avec moi.
#. speaker: YSHTOLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000391_YSHTOLA:1"
msgid "While I am able to invoke said magicks, I cannot sustain them alone. I require another to channel with me, and in unison."
msgstr "Я могу наложить эти чары, но одной мне не поддерживать их долго. Мне нужен тот, кто хорошо меня знает и сможет действовать со мной в унисон."

#. ja: 私もこちらに残り扉の維持に努めますが、<br>それでもなお心許ないのは確か。<br>おふたりにも、ご協力いただけないでしょうか……？
#. de: Dafür stelle ich mich gerne zur Verfügung. Doch selbst dann dürfte dies ein äußerst schwieriges Unterfangen werden. Es wäre beruhigend, euch mit euren mannigfaltigen Fä<shy>hig<shy>kei<shy>ten ebenfalls an unserer Seite zu wissen.
#. fr: Je serai ravi d'être mis à con<shy>tri<shy>bu<shy>tion pour cette tâche, mais rien ne garantit que mon in<shy>ter<shy>ven<shy>tion sera suffisante. Pourrons-nous également bénéficier de votre concours<nbsp>?
#. speaker: URIANGER
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000392_URIANGER:1"
msgid "For that role I do humbly volunteer myself, but even our combined efforts offer no certainty of success. Might we prevail upon the two of you to lend your support?"
msgstr "Я с радостью останусь и помогу удерживать врата, но даже вместе нам может не хватить сил. Не согласитесь ли вы двое нам помочь?"

#. ja: 了解だよ。<br>術者同士の精密な連携が必要なのであれば、<br>私とアリゼーはまさしく適任だろう。
#. de: Aber selbst<shy>verständ<shy>lich. Diese Aufgabe scheint schließlich wie für uns gemacht.
#. fr: Bien sûr. En matière de coordination incantatoire, Alisaie et moi-même sommes imbattables.
#. speaker: ALPHINAUD
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000393_ALPHINAUD:1"
msgid "Of course. If coordination between mages is required, few would be better suited than Alisaie and myself."
msgstr "Конечно. Если нужна слаженность магов, мало кто справится лучше нас с Ализе."

#. ja: オレも残った方がいいか？
#. de: Wäre es hilfreich, wenn ich ebenfalls hierbliebe?
#. fr: Est-ce que ma présence sera nécessairrre<nbsp>?
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000394_GRAHATIA:1"
msgid "Shall I remain as well?"
msgstr "Мне тоже остаться?"

#. ja: そうしてもらいたいところではあるけれど、<br>あなたは突入組に回って頂戴。
#. de: Unter normalen Umständen, ja. Diesmal bist du jedoch bei den anderen besser aufgehoben.
#. fr: Même si tu aurais tout à fait ta place ici, je préfère que tu intègres l'équipe qui part explorer.
#. speaker: YSHTOLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000395_YSHTOLA:1"
msgid "While your presence would be welcome, I'd rather you joined the expedition team."
msgstr "Я была бы рада твоей помощи, но предпочла бы, чтобы ты отправился с отрядом."

#. ja: 私たちがどれほど努力をしても、<br>扉が閉じられてしまう可能性は否定できない……。
#. de: Wir können leider nicht ausschließen, dass sich das Portal trotz all unserer Bemühungen früher oder später schließt<nbsp>...
#. fr: Car malgré ces précautions, on ne peut pas écarter l'éventualité que le portail se verrouille à nouveau...
#. speaker: YSHTOLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000396_YSHTOLA:1"
msgid "For despite our earnest efforts, the gate may well end up closed once more."
msgstr "Даже если мы выложимся по полной, нельзя исключать, что врата всё равно закроются..."

#. ja: そのときには、鏡像世界側からも、<br>再び世界を繋ぐ手立てを探してもらう必要があるわ。<br>……あなたならできるでしょう？
#. de: Im schlimmsten Fall werdet ihr von der anderen Seite aus einen Weg finden müssen, erneut einen Übergang zwischen den Welten herzustellen. Und ich kenne niemand Geeigneteren für diese Aufgabe als dich, mein Guter.
#. fr: Et si cela se produit, il nous faudra trouver un moyen de rétablir une connexion entre les deux mondes depuis l'autre côté. Un défi taillé sur mesure pour toi, qu'en dis-tu<nbsp>?
#. speaker: YSHTOLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000397_YSHTOLA:1"
msgid "In such a situation, it may fall to those on the other side to devise a method to reconnect our worlds. A task with which you are not unfamiliar, as I recall?"
msgstr "Если так случится, вам придётся искать способ соединить наши миры снова — уже с другой стороны. Думаю, с этим ты справишься, верно?"

#. ja: ……そうならないと信じてるが、<br>もしものときは、全力を尽くそう。
#. de: Ich hoffe nicht, dass es so weit kommt, aber falls doch<nbsp>... Na, dann bleibt mir wohl nichts anderes übrig, nicht wahr?
#. fr: Je suis convaincu que nous n'aurons pas à en arriver là. Mais dans le cas contraire, je vous prrromets de faire de mon mieux.
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000398_GRAHATIA:1"
msgid "I have faith it will not come to that, but should it, I will endeavor not to disappoint."
msgstr "Надеюсь, до этого не дойдёт. Но если что, я сделаю всё, что смогу."

#. ja: 先に意思を示したウクラマト、クルル、エレンヴィルは、<br>もちろん突入にまわるとして……
#. de: Ich nehme schwer an, dass Wuk Lamat, Krile und Erenville ebenfalls in die andere Welt reisen, richtig?
#. fr: Puisque Wuk Lamat, Krile et Erenville prendront part à l'incursion, je monterai la garde ici pour protéger ceux qui s'occuperont du portail.
#. speaker: THANCRED
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000510_THANCRED:1"
msgid "So, assuming Wuk Lamat, Krile, and Erenville are a given for this foray..."
msgstr "Раз Вук Ламат, Крилэ и Эренвиль уже вызвались, они, конечно, отправятся в тот мир..."

#. ja: 俺はこっちで、扉を維持している連中を護衛する。<br>前に聞いたヴォイドゲートのときと同じように、<br>あちら側から何かが侵入してこないとも限らないからな。
#. de: Dann werde ich bleiben und diejenigen beschützen, die hier die Stellung halten. Wer weiß, vielleicht wird auf der anderen Seite des Portals ja bereits ein Angriff auf uns geplant.
#. fr: On ne sait jamais, des créatures belliqueuses pourraient tenter la traversée en sens inverse...
#. speaker: THANCRED
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000511_THANCRED:1"
msgid "I'll make myself useful here by guarding those who are maintaining the gate."
msgstr "А я останусь здесь и буду охранять тех, кто поддерживает врата. Как тогда с вратами Бездны, нельзя исключать, что оттуда кто-нибудь проберётся."

#. ja: どんなものがやって来ようが、術の邪魔をさせはしない。
#. de: Komme, was wolle, ich werde nichts und niemanden dieses Portal schließen lassen.
#. fr: Si ça arrive, je serai là pour leur faire comprendre qu'elles ne sont pas les bienvenues dans notre monde.
#. speaker: THANCRED
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000512_THANCRED:1"
msgid "Should any threats emerge, from the world beyond or otherwise, I'll deal with them."
msgstr "Что бы ни появилось, я не дам помешать заклинанию."

#. ja: 俺も同じくだ。
#. de: Da bin ich mit von der Partie.
#. fr: Elles auront aussi l'honneur de tâter de ma lance.
#. speaker: ESTINIEN
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000520_ESTINIEN:1"
msgid "As will I."
msgstr "Я тоже."

#. ja: だからお前は、この先に何があるか見届けてこい。
#. de: Wehe, du kommst mir ohne die ein oder andere Geschichte im Gepäck zurück. Das bist du mir schuldig.
#. fr: Comme tu peux le voir, tes arrières seront bien gardés. Pars l'esprit tranquille, camarade.
#. speaker: ESTINIEN
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000521_ESTINIEN:1"
msgid "Which leaves you free to head in there─and do what you do best."
msgstr "Так что отправляйся туда и посмотри, что тебя ждёт. Это у тебя лучше всего получается."

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q1
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_Q1_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr "Что ответить?"

#. ja: アリゼーが門番をしてくれるなら安心だ
#. de: Du weißt gar nicht, wie sehr es mich beruhigt, dich hier als Portalwächterin zu haben.
#. fr: Alisaie, avec toi, je sais qu'on ne court aucun risque<nbsp>!
#. speaker: A1
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A1_000_001_NONE_VOICE:1"
msgid "With you holding the fort, I know we'll be all right."
msgstr "Раз ты будешь охранять врата, я спокоен."

#. ja: 老人にならないように護ってくれ
#. de: Bitte gib dein Bestes! Sonst kommen wir alle alt und verschrumpelt zurück.
#. fr: Fais en sorte qu'on ne devienne pas des vieillards, s'il te plaît.
#. speaker: A1
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A1_000_002_NONE_VOICE:1"
msgid "Make sure we can return while we're still young and beautiful, eh?"
msgstr "Смотри, чтобы мы вернулись, пока ещё молоды и красивы, а?"

#. ja: ゴメン……！
#. de: Tut mir leid, Alisaie<nbsp>...
#. fr: Vraiment <if $gn4>désolée<else>désolé</if>...
#. speaker: A1
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A1_000_003_NONE_VOICE:1"
msgid "I'm sorry..."
msgstr "Прости..."

#. ja: もう、わかったわよ。<br>その代わり……
#. de: Ist ja gut, ist ja gut! Ich verstehe schon. Aber versprecht mir eins!
#. fr: C'est bon, j'ai compris...
#. speaker: ALISAIE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000530_ALISAIE:1"
msgid "It's fine. Really. Mostly."
msgstr "Ладно, поняла... Почти."

#. ja: この人に、ぜんぶ背負わせないでよね。
#. de: Lasst <if $gn4>sie<else>ihn</if> nicht die ganze Last alleine stemmen, hört ihr?
#. fr: Ne <if $gn4>la<else>le</if> laisse pas porter tout le fardeau sur ses épaules, d'accord<nbsp>?
#. speaker: ALISAIE
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000531_ALISAIE:1"
msgid "Just don't let <if $gn4>her<else>him</if> bear the burden alone, do you hear?"
msgstr "Только не позволяй <if $gn4>ей<else>ему</if> тащить всё на себе, слышишь?"

#. ja: よし……今のうちに行くんだ。
#. de: Jetzt oder nie!
#. fr: Voilà, c'est quand vous voulez.
#. speaker: ALPHINAUD
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000532_ALPHINAUD:1"
msgid "'Tis done. Whenever you're ready."
msgstr "Готово. Идите, как будете готовы."

#. ja: どんなことがあっても、私たちが護るから……！
#. de: Was auch passieren mag, wir werden das Portal<nbsp>- und euch<nbsp>- beschützen!
#. fr: Quoi qu'il arrive, on protégera ce portail<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000533_ALISAIE:1"
msgid "We'll protect the portal. Keep it open no matter what."
msgstr "Мы защитим врата. Чего бы это ни стоило, проход останется открытым!"

#. ja: ここから先は、未知なる鏡像世界。
#. de: Auf der anderen Seite erstreckt sich eine uns unbekannte Welt.
#. fr: Un monde inconnu vous attend de l'autre côté.
#. speaker: YSHTOLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000540_YSHTOLA:1"
msgid "Beyond lies an unknown reflection."
msgstr "По ту сторону — неизвестное нам отражение."

#. ja: アシエンでない私たちには、<br>そこが第何世界にあたるのかはわからないわ。
#. de: Und da uns das Wissen der Ascians fehlt, können wir auch nicht sagen, um welchen der dreizehn Splitter es sich wohl handelt.
#. fr: Sans Ascien pour nous renseigner, nous n'avons aucun moyen de deviner de quel reflet il s'agit.
#. speaker: YSHTOLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000550_YSHTOLA:1"
msgid "Short of asking an Ascian, we unfortunately have no way of identifying which one it is."
msgstr "Без помощи асциана мы не узнаем, какой это осколок."

#. ja: なら、こう呼ぼうぜ。<br>スフェーンが、死者さえも失わないために閉じこもった場所……
#. de: Dann lasst uns ihm einen Namen geben: Der Ort, an dem selbst die Verstorbenen nicht in Vergessenheit geraten<nbsp>...
#. fr: Au moins, on sait qu'il s'agit du royaume de Sphene. Là où rien ne disparaît, même pas les morts...
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000551_WUKLAMAT:1"
msgid "Well, what we do know is that it's Sphene's domain─a place where she brings back those who've been lost. So for now, why don't we call it..."
msgstr "Что ж, мы знаем, что это владения Сфен — место, где она возвращает потерянных. Давайте пока назовём его..."

#. ja: 「<ruby>失われざる世界<rt>アンロスト・ワールド</ruby>」ってな！
#. de: „Die unverlorene Welt!“
#. fr: Faute de mieux, on a qu'à l'appeler... le monde inéphémère<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000552_WUKLAMAT:1"
msgid "The unlost world!"
msgstr "„Непотерянный мир“!"

#. ja: よし、行くぜ！
#. de: Auf geht's!
#. fr: En avant, mes amis<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000570_WUKLAMAT:1"
msgid "Right, let's go!"
msgstr "Ну, пошли!"

#. ja: あのとき  眼前に広がる光景を見て<br>俺たちがどれほど驚いたか  言葉で表すのは難しい
#. de: Es fällt mir auch heute noch schwer, in Worte zu fassen, was sich da vor unseren Augen abspielte. Welche Wunder auf uns warteten.
#. fr: Les mots me manquent pour exprimer la stupéfaction qui fut la nôtre<br>en découvrant l'incroyable paysage qui s'étendait de l'autre côté du portail.
#. speaker: ERENVILLE
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000580_ERENVILLE:1"
msgid "How to describe the sheer amazement we felt when we emerged on the other side of the portal?<br>I fear words do not do it justice."
msgstr "И сейчас мне трудно подобрать слова, чтобы описать, как мы изумились, увидев то, что ждало нас по ту сторону врат. <br>Боюсь, они не передадут и доли увиденного."

#. ja: 肉体の死を経た記憶たちが<br>色褪せることのない思い出の中で  永遠を謳歌する場所
#. de: Ein Ort, an dem die Erinnerungen, ihrer sterblichen Hüllen entledigt, in ewigem Glanze ihr Dasein genießen konnten.
#. fr: Sous nos yeux, une ville animée de souvenirs ayant survécu à la mort charnelle<br>et perdurant dans une existence à la gloire de l'éternité.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000590_ERENVILLE:1"
msgid "Before us was a vibrant world where the memories of the departed abided and reveled in bygone days."
msgstr "Перед нами раскинулся дивный мир, где память об ушедших жила и ликовала, возвращаясь к былым дням."

#. ja: 永久人たちはそこを  リビング・メモリーと呼んだ
#. de: Die Endlosen nannten ihn schlicht „Lebende Erinnerung“.
#. fr: “La Mémoire vivante”, comme les Éternels l'avaient eux-mêmes appelée.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000591_ERENVILLE:1"
msgid "Living Memory, or so the Endless called it."
msgstr "Живая память — так называли это место его обитатели, Вечные."

#. ja: 誰も彼もが笑っている  叶わなかった夢を語りながら<br>皆たしかに生きていて  失われるものは何もなかった
#. de: Ihre unerfüllten Träume hinter sich lassend, schien ein jeder dort glücklich und zufrieden<nbsp>- durch und durch am Leben und frei vom Schmerz des Verlustes.
#. fr: Chacun de ses habitants riait joyeusement en partageant ses rêves jamais réalisés,<br>croquant à pleines dents dans cette vie infinie,<br>sans aucune crainte de perdre quoi que ce soit.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000600_ERENVILLE:1"
msgid "How they laughed and smiled as they reminisced upon unfulfilled dreams. Alive in all perceivable ways...yet knowing no loss."
msgstr "Все смеялись и улыбались, вспоминая несбывшиеся мечты. Они были живы во всём, что можно увидеть... и не знали утрат."

#. ja: 街はどこもかしこも眩い輝きを放っていて<br>俺は思わず  こう呟いたんだ――
#. de: Ob dieses prachtvollen Glanzes, der alles erstrahlen ließ, drangen meine Gedanken unweigerlich über meine Lippen<nbsp>...
#. fr: Littéralement émerveillé par le spectacle de ce monde qui brillait de mille feux,<br>je ne pus m'empêcher de penser à voix haute.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000610_ERENVILLE:1"
msgid "So resplendent was every ilm of this paradise, the words rose unbidden to my lips:"
msgstr "Весь этот райский город сиял так ярко, что слова сами сорвались с моих губ:"

#. ja: 黄金郷は、ここにあったんだな……。
#. de: Die Stadt aus Gold<nbsp>... <i>endlich</i> habe ich sie gefunden<nbsp>...
#. fr: La voilà, la cité d'or...
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000620_ERENVILLE:1"
msgid "All this time, it was here─the city of gold."
msgstr "Так вот где всё это время был золотой город..."

#. ja: おい、スフェーン！<br>ここにいるのか？
#. de: Sphene! Bist du da?
#. fr: Hé, Sphene<nbsp>! T'es là-dedans<nbsp>?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000630_WUKLAMAT:1"
msgid "Sphene! Are you there?"
msgstr "Сфен! Ты там?"

#. ja: いるなら返事をしてくれ！<br>お前と話がしてぇんだ！
#. de: Wenn du da bist, antworte mir! Wir müssen mit dir reden!
#. fr: Si t'es là, réponds-moi<nbsp>! Il faut qu'on parle<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000640_WUKLAMAT:1"
msgid "If you are, say something! We need to talk!"
msgstr "Если ты здесь, отзовись! Нам нужно поговорить!"

#. ja: スフェーン……！
#. de: Sphene ...!
#. fr: Sphene<nbsp>?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000650_WUKLAMAT:1"
msgid "Sphene!"
msgstr "Сфен!"

#. ja: こんなところにまで来ちゃうなんて……参ったなあ。
#. de: Dass ihr mir bis <i>hierhin</i> folgen würdet<nbsp>...
#. fr: Je ne pensais pas que tu viendrais jusqu'ici...
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000660_SPHENE:1"
msgid "Hmm... That you should come here..."
msgstr "Вот уж не думала, что вы доберётесь сюда..."

#. ja: スフェーンとはまだ短い付き合いだけどよ……<br>お前が民を愛する心根の優しい奴だってことは、<br>ここまでで十分わかってるつもりだぜ。
#. de: Wir kennen uns zwar noch nicht lange, aber einer Sache bin ich mir sicher: Du trägst dein Herz am rechten Fleck, denn du liebst dein Volk über alles.
#. fr: On se connaît pas depuis longtemps, mais il m'a suffi de voir l'amour que tu portes à ton peuple pour comprendre que tu as un bon fond.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000670_WUKLAMAT:1"
msgid "I haven't known you long, Sphene, but I know you have a good heart. Your love for your people is proof of this."
msgstr "Мы со Сфен знакомы недолго, но я уже поняла, что у неё доброе сердце. Она любит свой народ."

#. ja: だけどよ、お前がやろうとしていることは見過ごせねぇ。<br>お前だって、本当はこんなことしたくないんだろ？
#. de: Aber trotzdem <i>kann</i> ich dein Vorhaben nicht gutheißen! Du weißt doch selbst, wie falsch es ist!
#. fr: Malgré ça, je refuse de te laisser agir à ta guise. Toi-même, tu peux pas avoir pris cette décision de gaieté de cœur.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000680_WUKLAMAT:1"
msgid "I can't let you do what you're trying to do. And deep down, I don't think you want to do it either."
msgstr "Но я не могу позволить тебе это сделать. И в глубине души ты сама не хочешь этого, правда?"

#. ja: 誰も傷つかない、何も失われない……<br>そんな優しい世界があればよかった。
#. de: Eine Welt ohne Schmerz und Verlust<nbsp>... Wie schön sie doch wäre.
#. fr: Un monde sans douleur, dans lequel rien n'est perdu à jamais... Si seulement un tel endroit pouvait exister.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000690_SPHENE:1"
msgid "I want a world without suffering. A world where nothing is lost... Would that such a place existed."
msgstr "Я хотела бы, чтобы никто не страдал и ничего не терял... Если бы только существовал такой добрый мир."

#. ja: でもね、増え続ける永久人の存在を維持するためには、<br>「生命力のエーテル」が必要なの。<br>永遠の命は、その糧を得てこそ永遠でいられる……。
#. de: Doch der Fortbestand der Endlosen kostet Lebensenergie. Dies ist der Preis ihrer Unsterblichkeit<nbsp>...
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment, ce n'est pas le cas. Le nombre des Éternels augmente sans cesse, et leur existence ne saurait être infinie sans éther vital...
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000700_SPHENE:1"
msgid "But the Endless only grow in number, and ever more life force is needed to sustain them."
msgstr "Но Вечных становится всё больше, и чтобы поддерживать их жизнь, нужно всё больше жизненной силы."

#. ja: 障壁に閉ざされた箱庭の中で、<br>命の巡りをせき止めながら、数百年どうにか繋いできたけど……<br>それももう限界なんだ。
#. de: Wir brachen den Kreislauf der Vergänglichkeit, und in unserem Wall bewahrten wir das ewige Leben für mehrere hundert Jahre<nbsp>... Doch die immer größer werdende Anzahl an Endlosen brachte uns schließlich an unsere Grenzen.
#. fr: En interrompant le cycle de la vie, nous nous sommes épanouis dans cet espace clos pendant plusieurs siècles. Mais aujourd'hui, la situation n'est plus tenable.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000710_SPHENE:1"
msgid "Within the barrier, we have managed to curb the cycle of rebirth these few hundred years. But we've reached the limit."
msgstr "За преградой мы сотни лет сдерживали круговорот жизни. Но теперь это уже не по силам."

#. ja: だから私は「世界を繋ぐ力」に頼る路を選んだ。<br>キミたちの世界に、永久人の糧を求めるために……。
#. de: Und deswegen entschied ich mich dazu, die Weltenfusion einzuleiten. Eure Realität sollte den Endlosen als Nahrung dienen.
#. fr: C'est pourquoi j'ai décidé de recourir au pouvoir de relier les mondes... Afin d'aller chercher dans le vôtre ce dont nous avons besoin pour prospérer.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000720_SPHENE:1"
msgid "That is why I looked to interdimensional fusion. To harvest what we needed from your world."
msgstr "Поэтому я решила прибегнуть к силе, соединяющей миры. Чтобы добыть в вашем мире то, чем можно кормить Вечных..."

#. ja: 計画は果たされるよ。<br>「鍵」は今……私の手元にあるんだから。
#. de: Nun wird sich mein Plan endlich verwirklichen. Denn ich<nbsp>... halte den Schlüssel in den Händen.
#. fr: La <i>clef</i> pour mener ce projet à son terme est en ma possession, et je n'échouerai pas.
#. speaker: SPHENE
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000721_SPHENE:1"
msgid "From your people. And with the key, we <i>will</i> have it."
msgstr "Теперь мой план осуществится. Ведь ключ... у меня."

#. ja: オレたちの世界からエーテルを奪って、<br>それでも足りなくなったら、今度は別の鏡像世界から奪うのか？
#. de: Und was, wenn der Äther unserer Welt restlos aufgezehrt ist? Labst du dich dann an der nächsten?
#. fr: Et lorsque tu auras siphonné tout l'éther de notre monde, tu vas continuer en t'attaquant aux autres rrreflets<nbsp>?
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000730_GRAHATIA:1"
msgid "And once you've plundered our world of aether, what then? Will you do the same to others?"
msgstr "А когда ты выкачаешь эфир из нашего мира, что дальше? Возьмёшься за другие?"

#. ja: 人は生まれれば死ぬものだ……。<br>そのすべてを永久人にしたら、糧はいくらあっても足りない。<br>奪い続けて、やがては自滅するだけだ！
#. de: Alles Leben muss enden. Wenn du dich dem entgegenstellst, werden die Endlosen schließlich auch den letzten Tropfen Äther verzehren. So führt dieses „ewige Leben“ nur zur Selbstzerstörung deines Volkes!
#. fr: Tous les êtres vivants doivent mourir un jour. Plus le nombre d'Éternels grandira, plus tu auras besoin d'énergie pour les préserver... Tu ne fais que repousser l'inévitable en emporrrtant toujours plus d'innocents dans ta propre destruction<nbsp>!
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000731_GRAHATIA:1"
msgid "All men eventually die. If you make Endless of everyone, you will never have enough aether to sustain them. You but prolong the inevitable."
msgstr "Все люди смертны. Если ты превратишь их в Вечных, эфира на всех не хватит. Ты лишь отсрочишь неизбежное."

#. ja: そうね……もし本当に実行するつもりなら、<br>残念だけど、あなたを敵とみなすしかないわ。
#. de: Ganz genau. Deswegen werden wir alles daransetzen, dich und deinen Plan aufzuhalten.
#. fr: Il a raison, et tu le sais très bien. Si tu as vraiment l'intention de mettre ton plan à exécution, alors nous devons te considérer comme notre ennemie.
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000740_KRILE:1"
msgid "Sphene. If you would nevertheless persist in this folly, we must stand against you."
msgstr "Сфен, если ты всё же решишься на эту безумную затею, нам придётся выступить против тебя."

#. ja: 私たちにだって、譲れないもの……護りたい人……<br>いつか帰るところがあるのだから。
#. de: Denn auch wir haben Dinge, die uns wichtig sind: Freunde und Verbündete. Orte, die wir unser Zuhause nennen ...!
#. fr: Nous aussi, nous avons des choses qui nous sont chères, des personnes que nous voulons protéger. On ne peut pas te laisser tout anéantir.
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000750_KRILE:1"
msgid "For we too have people we cannot lose. Places to which our hearts belong."
msgstr "Нам тоже есть кого беречь, есть места, куда мы хотим вернуться."

#. ja: ……ラマチ。<br>同じ王として、ともに手を取り合って国を護っていけたら、<br>どんなによかっただろうって、今でも思うよ。
#. de: Lamaty'i ... Du kannst dir gar nicht vorstellen, wie gerne ich dir doch die Hand gereicht und Seite an Seite mit dir gestanden hätte<nbsp>- beflügelt von der gleichen Liebe für unser Volk.
#. fr: Lamaty'i... J'aurais tant aimé que nous œuvrions main dans la main pour protéger nos peuples... En tant que reines, toi et moi.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000760_SPHENE:1"
msgid "Lamaty'i... I would have loved nothing more than to work hand in hand with you to tend our nations."
msgstr "Ламатъи... Я и сейчас думаю, как же мне хотелось вместе с тобой, как королеве, защищать наши народы."

#. ja: ……でも、運命は残酷だね。<br>キミと出会ったときには、もう何もかもが手遅れだったんだ。
#. de: Doch es hat nicht sein sollen. Bereits bei unserem ersten Treffen war es längst zu spät.
#. fr: Hélas, le destin est cruel. Lorsque nos routes se sont enfin croisées, il était déjà trop tard.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000770_SPHENE:1"
msgid "But fate is cruel. By the time it had brought us together, our futures had already been written."
msgstr "Но судьба жестока. Когда мы встретились, всё уже было предрешено."

#. ja: かつて、優しいだけのスフェーン王は、民を護れなかった。<br>だから私は、弱い心を捨てることにしたの！
#. de: Egal, was Sphene auch versuchte, sie konnte ihr Volk nicht beschützen. Und so bleibt mir nichts übrig, als mich ihres Herzens zu entledigen.
#. fr: Puisque la bonne et généreuse Sphene a été incapable de défendre les siens... j'ai décidé de me débarrasser d'elle.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000780_SPHENE:1"
msgid "The kind and gentle Queen Sphene was too weak to serve her people. And so she will serve them no more."
msgstr "Добрая и мягкая королева Сфен не смогла защитить свой народ. Поэтому ей больше не место у власти."

#. ja: 私を構成する「生前のスフェーン」の記憶、<br>それを捨て去って、この人格を消去する……！
#. de: Die Erinnerung jener Königin, welcher ich entspringe<nbsp>... Sie ist es, die mich zurückhält<nbsp>... Die mein Volk gefährdet<nbsp>...!
#. fr: Oui, je vais effacer les souvenirs de celle qui a régné autrefois, et ainsi m'affranchir de ses faiblesses.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000790_SPHENE:1"
msgid "I will erase all memories of the living Sphene─she who has cursed me with this soft and powerless nature."
msgstr "Я сотру воспоминания о Сфен, которой была при жизни, и избавлюсь от слабой, мягкосердечной личности!"

#. ja: そうして……世界を喰らう最悪のシステムとなって、<br>アレクサンドリアを護るんだ。
#. de: Befreit von diesem Gewissen werde ich zu einer gnadenlosen, weltenverschlingenden Waffe werden<nbsp>... Für Alexandria<nbsp>... Für mein Volk!
#. fr: Je serai alors enfin à même de protéger ma chère Alexandrie... en devenant une arme impitoyable, capable de dévorer les mondes.
#. speaker: SPHENE
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000800_SPHENE:1"
msgid "Freed from conscience, I shall become a ruler that <i>can</i> protect Alexandria. A devourer of worlds."
msgstr "Лишившись совести, я стану правительницей, <i>способной</i> защитить Александрию. Пожирательницей миров."

#. ja: ……お互いの護りたいものが相容れないとき、<br>どうやって解決すべきか……キミならきっとわかるよね？
#. de: Wir beide haben Dinge zu beschützen, die zu verlieren wir nicht bereit sind. Du weißt ganz genau, was unausweichlich folgen muss, nicht wahr?
#. fr: Lorsque chaque camp ne peut accomplir sa volonté qu'au détriment de l'autre, une seule issue est possible. Tu sais comme moi de laquelle il s'agit, n'est-ce pas<nbsp>?
#. speaker: SPHENE
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000810_SPHENE:1"
msgid "When two nations cannot protect their own without doing harm to the other, there can be only one resolution. It is a hard truth...but one <i>you</i> understand, don't you?"
msgstr "Если два народа не могут защитить своё, не причиняя вреда другому, остаётся только одно решение. Тяжёлая правда... но ты ведь её понимаешь?"

#. ja: 何と言う？
#. de: Was antwortest du?
#. fr: Que répondez-vous<nbsp>?
#. speaker: Q2
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_Q2_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr "Что ответить?"

#. ja: 決着をつけよう
#. de: Beenden wir es.
#. fr: Ça a assez duré, finissons-en.
#. speaker: A2
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A2_000_001_NONE_VOICE:1"
msgid "Then let's resolve this."
msgstr "Пора положить этому конец."

#. ja: 鏡像世界は自分が護る
#. de: Ich werde alle Welten beschützen, nicht nur die meine.
#. fr: Je protégerai mon monde coûte que coûte.
#. speaker: A2
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A2_000_002_NONE_VOICE:1"
msgid "I'll protect my world and all the others."
msgstr "Я защищу свой мир и все остальные."

#. ja: その力を悪用するな
#. de: Gib dich dieser Kraft nicht hin, Sphene!
#. fr: Tu n'abuseras pas de ce pouvoir.
#. speaker: A2
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A2_000_003_NONE_VOICE:1"
msgid "This evil is not inevitable! Find another way!"
msgstr "Зло не неизбежно! Найди другой путь!"

#. ja: 残念、ひと足遅かったね。<br>起動したシステムは、もう止められない……！
#. de: Es ist zu spät. Das System<nbsp>... Niemand kann es mehr stoppen!
#. fr: Il est déjà trop tard... Le système a été activé, et rien ne pourra l'arrêter.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000870_SPHENE:1"
msgid "I'm afraid we're out of time. The process has begun. And it cannot be stopped."
msgstr "Боюсь, мы опоздали. Процесс уже запущен. Его не остановить."

#. ja: (-メインターミナル-)メインターミナルの記憶領域を消去中……
#. de: (-Meso-System-)Erinnerungsspeicher des Meso-Systems wird gelöscht.
#. fr: (-Mésoterminal-)Suppression de la mémoire du mésoterminal en cours...
#. speaker: MESOTERMINAL
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000880_MESOTERMINAL:1"
msgid "(-Meso Terminal-)Meso Terminal memory deletion in progress."
msgstr "(-Мезотерминал-)Идёт удаление памяти Мезотерминала."

#. ja: (-メインターミナル-)メインターミナルの記憶領域を消去中……<br>完了後、世界を繋ぐ力を実行します……
#. de: (-Meso-System-)Erinnerungsspeicher des Meso-Systems wird gelöscht. Nach Abschluss des Prozesses wird die Weltenfusion eingeleitet.
#. fr: (-Mésoterminal-)Activation du pouvoir de relier les mondes une fois la suppression terminée...
#. speaker: MESOTERMINAL
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000890_MESOTERMINAL:1"
msgid "(-Meso Terminal-)Meso Terminal memory deletion in progress. Upon completion, interdimensional fusion will commence."
msgstr "(-Мезотерминал-)Идёт удаление памяти Мезотерминала. По завершении начнётся слияние миров."

#. ja: スフェーン！！！
#. de: Sphene!
#. fr: Spheeene<nbsp>!!!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000900_WUKLAMAT:1"
msgid "Sphene!"
msgstr "Сфен!"

#. ja: なあ、オレがあんたに言ったこと覚えてるか？
#. de: Sag mal, erinnerst du dich eigentlich noch an meine Worte von damals?
#. fr: Au fait... Tu te souviens de ce que je t'ai dit avant toute cette histoirrre<nbsp>?
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000910_GRAHATIA:1"
msgid "Do you remember what I said to you before all this?"
msgstr "Помнишь, что я сказал тебе до всего этого?"

#. ja: あんたは自分の旅路に、何を見つけるんだろう。<br>それまで、好きに歩いてみればいい、ってさ。
#. de: Du weißt schon<nbsp>... Dass das Leben selbst unsere Antwort auf das Ende sei. Und was du noch so auf deiner Reise entdecken wirst.
#. fr: Qu'en attendant de savoir ce que tu finirais par trouver au terrrme de ton périple, il te suffirait pour le moment d'aller là où tes pas te mèneraient.
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000920_GRAHATIA:1"
msgid "That life is a series of journeys. That you must be true to yourself, for indeed, there's no telling what awaits."
msgstr "Что жизнь — это череда странствий. Нужно оставаться верным себе, ведь никто не знает, что ждёт впереди."

#. ja: 歩いた先に、こんな景色が見えるだなんて思ってなかった。<br>やっぱりわからないもんだよな、未来って。
#. de: Aber dass uns auf dieser Reise <i>so etwas</i> erwarten würde<nbsp>... Die Ungewissheit, die uns auf Schritt und Tritt begleitet. Sie hat schon etwas Wundersames<nbsp>...
#. fr: Eh bien, je ne sais pas pour toi... mais j'étais loin de me douter que le destin nous conduirait jusqu'à un endroit pareil. Décidément, le futur est imprrrévisible...
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000930_GRAHATIA:1"
msgid "I don't know about you, but I certainly didn't expect to behold such sights. The future is as fluid as the water beneath us, truly."
msgstr "Не знаю, как ты, а я уж точно не ожидал увидеть такое. Будущее и правда изменчиво, как вода под нами."

#. ja: ……なあ、あんたはさ、<br>死んでしまった人に会いたいって思うことはあるか？
#. de: Hast du eigentlich manchmal das Verlangen, jemand Verstorbenen noch einmal wiedersehen zu können?
#. fr: Dis-moi... Ça ne t'arrive jamais de vouloir rrrevoir ceux qui nous ont quittés<nbsp>? D'être <if $gn4>réunie<else>réuni</if> avec d'anciens compagnons<nbsp>?
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000940_GRAHATIA:1"
msgid "Tell me, my friend. Have you ever wished to be reunited with someone who has passed away?"
msgstr "Скажи, друг мой, тебе когда-нибудь хотелось снова встретиться с тем, кто уже ушёл из жизни?"

#. ja: オレはあったよ……あったけど……<br>一番の願いは「生きていてほしい」の方なんだ。
#. de: Ich<nbsp>... habe es ehrlich gesagt öfter. Mehr noch als alles andere wünsche ich mir jedoch, dass sie am Leben wären.
#. fr: Moi, je dois t'avouer que oui... Enfin, ce que j'aimerais encore davantage, pour être honnête... c'est qu'ils soient toujourrrs à nos côtés.
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000950_GRAHATIA:1"
msgid "I have. I do. But I think... Above all else, I wish that they had lived."
msgstr "Мне хотелось. И сейчас хочется. Но больше всего... я хотел бы, чтобы они были живы."

#. ja: 1日でも長く、健やかに……叶うのならば、幸せに……。
#. de: Gesund, munter, und vor allem glücklich.
#. fr: Les voir heureux et en bonne santé, comme autrefois... Même si ce n'est que le temps d'une jourrrnée...
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000960_GRAHATIA:1"
msgid "If only for one more day. One more day... A joyous one, if I could choose."
msgstr "Пусть даже всего на один день. Ещё один день... И пусть он будет счастливым."

#. ja: そのためにできることがあるなら無理だって通したし、<br>持ち得るすべてを費やした。
#. de: Beizeiten habe ich dafür alles gegeben, sie zu retten<nbsp>... alle mir zur Verfügung stehenden Möglichkeiten ausgeschöpft.
#. fr: Si j'avais eu la moindrrre chance de les protéger, j'aurais fait tout ce qui était en mon pouvoir.
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000970_GRAHATIA:1"
msgid "I did all that I could to make it happen. I tried everything. Spared nothing."
msgstr "Я сделал всё, что мог. Перепробовал всё. Ничего не пожалел."

#. ja: それで、多少なり危機から遠ざけられた人もいたし……<br>結局、見送るしかなかった命もある。
#. de: So manch einen konnte ich tatsächlich vor Unheil bewahren. Andere wiederum ... andere musste ich gehen lassen.
#. fr: À ma manière, j'ai déjà sauvé cerrrtaines personnes, c'est vrai... Mais hélas... j'ai aussi dû dire adieu à tant et tant d'autres...
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000980_GRAHATIA:1"
msgid "In that manner, I was able to keep some few souls out of harm's way. But so, so many were beyond my power to save."
msgstr "Некоторых мне удалось уберечь от беды. Но стольких, стольких я спасти не смог."

#. ja: こういう場所があったら、オレはどうしたかな……。
#. de: Hätte ich anders gehandelt, wenn ich von solch einem Ort gewusst hätte<nbsp>...?
#. fr: Je me demande ce qui se serait passé, si j'avais eu un tel endrrroit à ma disposition.
#. speaker: GRAHATIA
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000981_GRAHATIA:1"
msgid "What would I have done then, had I <i>this</i>...?"
msgstr "И что бы я тогда сделал, будь у меня <i>это</i>?"

#. ja: あんたは……<br>ここで何も失わない日々を過ごす自分を、想像できるか？
#. de: Sag ... Kannst du dir vorstellen, wie es wäre, hier ein Leben ohne Angst vor Verlust zu führen?
#. fr: Et toi, es-tu capable d'imaginer la vie ici, dans un monde où rrrien ne meurt, où rien n'est jamais perdu<nbsp>?
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000982_GRAHATIA:1"
msgid "And you─can you imagine yourself spending eternity here, knowing no loss?"
msgstr "А ты... можешь представить, каково это — провести здесь вечность и ничего не терять?"

#. ja: 言われたとおりに、回路のスイッチを入れてきたぞ。
#. de: Wir haben die Schalter gleichgeschaltet und den Kreislauf wieder<shy>her<shy>gestellt<nbsp>- genau wie es uns erklärt wurde.
#. fr: On a activé les interrupteurs, comme tu nous l'as demandé.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_000990_WUKLAMAT:1"
msgid "We've switched on the circuits like you asked."
msgstr "Мы включили цепи, как ты и просила."

#. ja: 助かったよ、みんなありがとね！<br>これで直ってくれるといいんだけど……。
#. de: Vielen Dank! Hoffentlich funktioniert jetzt alles wieder wie gehabt.
#. fr: Merci à vous tous<nbsp>! J'espère que ça va fonctionner...
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001000_CAHCIUA:1"
msgid "Thank you, everyone. Hopefully this does the trick."
msgstr "Спасибо всем! Надеюсь, теперь всё заработает."

#. ja: おおっ！
#. de: Oh!
#. fr: Oooh<nbsp>!
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001010_GRAHATIA:1"
msgid "Oh!"
msgstr "Ого!"

#. ja: ……すげえ。
#. de: Unglaublich!
#. fr: Incroyable...
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001020_WUKLAMAT:1"
msgid "Amazing..."
msgstr "Потрясающе..."

#. ja: わああ……！
#. de: Uahaha!
#. fr: Ouaaah<nbsp>!
#. speaker: CANALTOWNGIRL
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001030_CANALTOWNGIRL:1"
msgid "Wow!"
msgstr "Вот это да!"

#. ja: お母さん、あれ見て！
#. de: Guck mal, Mama! Guck mal!
#. fr: Maman, Maman<nbsp>! Regarde<nbsp>!
#. speaker: CANALTOWNGIRL
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001040_CANALTOWNGIRL:1"
msgid "Look, Mother! Look!"
msgstr "Мама, смотри! Смотри!"

#. ja: おおお……
#. de: [BEZAUBERT]Ohooo!
#. fr: Waoooh...
#. speaker: CANALTOWNMALE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001050_CANALTOWNMALE:1"
msgid "[IMPRESSED REAX “Wow”]"
msgstr "[Восхищённо: «Ух ты!»]"

#. ja: 綺麗ね……。
#. de: Das ist ja wunderschön!
#. fr: C'est magnifique...
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001060_KRILE:1"
msgid "It's beautiful."
msgstr "Красота..."

#. ja: ……ああ。<br>こんな光景、生まれて初めて見たよ。
#. de: So was Bezauberndes habe ich ja noch nie gesehen<nbsp>...
#. fr: Oui... C'est la première fois que je vois un spectacle d'une telle beauté.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001070_CAHCIUA:1"
msgid "I've never seen anything like it."
msgstr "Ничего подобного я ещё не видел."

#. ja: (-？？？？-)ウクラマト様……！
#. de: (-???-)Wuk Lamat!
#. fr: (-???-)Wuk Lamat<nbsp>!
#. speaker: NAMIKKA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001080_NAMIKKA:1"
msgid "(-???-)Wuk Lamat!"
msgstr "(-???-)Вук Ламат!"

#. ja: (-？？？？-)どちらにいらっしゃいますか？<br>ウクラマト様……！
#. de: (-???-)Oh, wo steckst du nur? Wuk Lamat!
#. fr: (-???-)Où es-tu donc passée... Wuk Lamat<nbsp>!
#. speaker: NAMIKKA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001090_NAMIKKA:1"
msgid "(-???-)Where are you? Wuk Lamat!"
msgstr "(-???-)Ты где? Вук Ламат!"

#. ja: 嘘だろ……。<br>あれは……ナミーカ……？
#. de: Nein<nbsp>... Das kann nicht<nbsp>... Namikka?!
#. fr: C'est pas possible... Namikka<nbsp>?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001100_WUKLAMAT:1"
msgid "By the gods... It's...Namikka..."
msgstr "Боги... Это... Намикка?"

#. ja: あの、すみません。<br>幼いシュバラール族の女の子を見ませんでしたか？
#. de: Entschuldigung, habt Ihr zufällig ein junges Xbr'aal-Mädchen hier in der Nähe gesehen?
#. fr: Excusez-moi, vous n'auriez pas vu une petite Xbr'aal<nbsp>?
#. speaker: NAMIKKA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001110_NAMIKKA:1"
msgid "Begging your pardon, but I'm looking for a child─a small Xbr'aal girl. Have you seen her by chance?"
msgstr "Простите, я ищу ребёнка — маленькую девочку из народа шбал. Вы её не видели?"

#. ja: お前、ナミーカ……だよな……？
#. de: Du<nbsp>... Du bist doch Namikka, oder nicht?
#. fr: Tu es bien Namikka, n'est-ce pas<nbsp>?
#. speaker: WUKLAMAT
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001120_WUKLAMAT:1"
msgid "You─you <i>are</i> Namikka, aren't you?"
msgstr "Ты... ты <i>и правда</i> Намикка, да?"

#. ja: ウクラマトだよ、アタシがわからないのか？
#. de: Ich bin's! Wuk Lamat!
#. fr: C'est moi, Wuk Lamat<nbsp>! Tu me reconnais pas<nbsp>?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001130_WUKLAMAT:1"
msgid "It's me, Wuk Lamat. Don't you recognize me?"
msgstr "Это я, Вук Ламат. Ты меня не узнаёшь?"

#. ja: ああ、どうしたら……とても大切な子なんです……。<br>血は繋がっていないけど、我が子同然で……。
#. de: Hach, was mache ich bloß? Die Kleine<nbsp>... Wir sind zwar nicht verwandt, aber sie ist wie eine Tochter für mich<nbsp>...
#. fr: Aaah, que vais-je faire... Cette enfant et moi ne sommes pas liées par le sang, mais je la considère comme ma propre fille...
#. speaker: NAMIKKA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001140_NAMIKKA:1"
msgid "Oh, what am I to do? The child and I, we aren't related by blood, but she's as dear to me as my own..."
msgstr "Ох, что же мне делать? Мы с девочкой не кровные родственницы, но она мне как родная..."

#. ja: ……もう探さなくても大丈夫だ。<br>その子なら、ここにいるから。
#. de: Dann musst du nicht mehr suchen. Es ist alles gut. Du hast sie bereits gefunden.
#. fr: Tu peux arrêter de te tracasser. Celle que tu cherches se trouve juste devant toi.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001150_WUKLAMAT:1"
msgid "It's all right. You've found her. I'm here."
msgstr "Всё хорошо. Ты её нашла. Я здесь."

#. ja: ウクラマト……様……？
#. de: Wuk Lamat?
#. fr: Wuk Lamat...<nbsp>?
#. speaker: NAMIKKA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001160_NAMIKKA:1"
msgid "You...could it be?"
msgstr "Ты... неужели?"

#. ja: そうだ、ナミーカ。<br>安心してくれ……アタシだ、ウクラマトだ！
#. de: Ganz genau, Namikka. Ich bin's!
#. fr: Oui Namikka. Sois tranquille... c'est bien moi, Wuk Lamat<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001170_WUKLAMAT:1"
msgid "Yes, Namikka. You know these eyes, this voice. It's me, Wuk Lamat."
msgstr "Да, Намикка. Ты ведь знаешь эти глаза, этот голос. Это я, Вук Ламат."

#. ja: ハッ……！
#. de: [ÜBERRASCHTES AUFSCHRECKEN;CHECK MIT JP]
#. fr: [Petite expiration de révélation]
#. speaker: NAMIKKA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001171_NAMIKKA:1"
msgid "[GASP OF REALIZATION]"
msgstr "[Внезапно всё поняла]"

#. ja: そうでした、私はもう……。<br>ああ、まさかウクラマト様もお命が……？
#. de: Oh, Wuk Lamat! Da bist du ja! Aber Moment<nbsp>... Dass du hier bist, bedeutet doch<nbsp>...
#. fr: Oui, c'est bien toi<nbsp>! Mais si tu es ici, ça veut dire que...
#. speaker: NAMIKKA
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001180_NAMIKKA:1"
msgid "It <i>is</i> you! How silly of me. But if you're here, then that means..."
msgstr "<i>Правда</i> ты! Какая же я глупая. Но если ты здесь, значит..."

#. ja: 大丈夫、アタシは生きてるよ。
#. de: Keine Sorge. Ich bin noch am Leben.
#. fr: Non non, je suis toujours en vie.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001190_WUKLAMAT:1"
msgid "No, no. I'm still alive."
msgstr "Нет, нет. Я ещё жива."

#. ja: はあっ……
#. de: [ERLEICHTERTES AUSATMEN]
#. fr: [Expiration de soulagement]
#. speaker: NAMIKKA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001191_NAMIKKA:1"
msgid "[RELIEVED SIGH]"
msgstr "[Облегчённо вздыхает]"

#. ja: よかった……本当によかった……。
#. de: Ach du meine Güte! Wie schön!
#. fr: Quel soulagement...
#. speaker: NAMIKKA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001200_NAMIKKA:1"
msgid "Good, good... Thank the gods for that..."
msgstr "Хорошо... Слава богам..."

#. ja: まさかこうしてお会いできるなんて、<br>これは夢じゃないんですね……！
#. de: Du glaubst gar nicht, wie froh es mich stimmt, dich wiederzusehen. Oder träume ich etwa?
#. fr: Je n'arrive pas à croire qu'on se retrouve, comme ça... Ce n'est pas un rêve, au moins<nbsp>?
#. speaker: NAMIKKA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001210_NAMIKKA:1"
msgid "But what power has brought us together again? This isn't a dream, is it?"
msgstr "Но как мы снова встретились? Это ведь не сон?"

#. ja: 夢なんかじゃないさ。
#. de: Nein<nbsp>... Und ich freue mich auch, Namikka. Mehr, als du dir vorstellen kannst!
#. fr: Non, tu ne rêves pas.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001220_WUKLAMAT:1"
msgid "It's not a dream."
msgstr "Это не сон."

#. ja: まいったな……願いが叶っちまった。<br>もう一度、お前の声が聴きたかったんだ……。
#. de: Ich bin einfach so glücklich, deine Stimme zu hören!
#. fr: On dirait bien que mon vœu s'est réalisé. J'avais tellement envie d'entendre ta voix encore une fois...
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001221_WUKLAMAT:1"
msgid "Or rather, it is a dream come true. I so wanted to hear your voice one more time."
msgstr "Вернее, это мечта, ставшая явью. Мне так хотелось ещё раз услышать твой голос..."

#. ja: それにしても、ウクラマト様。<br>本当にご立派になられましたね。
#. de: Aber sieh doch mal an, Kleines, wie groß du geworden bist! Und du wirkst irgendwie so<nbsp>... reif.
#. fr: Regarde-toi, Wuk Lamat... Tu as tellement grandi<nbsp>!
#. speaker: NAMIKKA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001230_NAMIKKA:1"
msgid "Just look at you. My Wuk Lamat. Stronger and more assured than I've ever seen."
msgstr "Только посмотри на себя, моя Вук Ламат. Ты стала сильнее и увереннее, чем когда-либо."

#. ja: きっとここまで来るのに、多くの苦労があったのでしょう。<br>よくがんばりましたね。
#. de: Du hast so einige Hürden auf deinem Weg hierher überwunden, nicht wahr? Vergiss nie, wie weit du gekommen bist, Wuk Lamat. Ich bin stolz auf dich!
#. fr: J'ose à peine imaginer les épreuves que tu as dû surmonter pour venir jusqu'ici.
#. speaker: NAMIKKA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001240_NAMIKKA:1"
msgid "Such hazards you must have braved and hardships endured to come so far..."
msgstr "Наверное, ты многое пережила, пока добиралась сюда..."

#. ja: こいつらの支えがあったからさ。
#. de: Ohne meine Freunde hier hätte ich das niemals geschafft!
#. fr: C'était pas une partie de plaisir, mais j'ai des amis sur qui compter.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001241_WUKLAMAT:1"
msgid "It was tough, but I made it thanks to my friends."
msgstr "Было нелегко, но благодаря друзьям я справилась."

#. ja: それに……<br>今のアタシがいるのは、ナミーカが育ててくれたからだ。
#. de: Und außerdem<nbsp>... Ich bin, wer ich bin, weil du mich großgezogen hast, Namikka.
#. fr: Et puis... je dois aussi beaucoup à celle qui m'a élevée.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001260_WUKLAMAT:1"
msgid "And to you, Namikka."
msgstr "И тебе, Намикка."

#. ja: どんなときも、信じて背中を押してくれた。<br>アタシを、本当の娘みてぇに愛してくれた……。
#. de: Was auch geschah, du hast immer an mich geglaubt und mich bei allem unterstützt. Du hast mich wie eine Tochter geliebt.
#. fr: Tu as toujours cru en moi, tu m'as toujours encouragée... Il y a pas eu <i>un</i> jour où tu m'as pas aimée comme ta propre fille.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001270_WUKLAMAT:1"
msgid "I'm the person I am now because you always believed in me. Because you loved me as if I were your own daughter."
msgstr "Я стала такой, какая есть, потому что ты всегда верила в меня. Потому что любила меня, как родную дочь."

#. ja: ありがとな！<br>ナミーカはアタシにとって、最高の母親だ！
#. de: Und darum warst du mir die beste Mutter, die ich mir jemals hätte wünschen können! Danke für alles!
#. fr: Merci pour tout, Namikka<nbsp>! J'aurais pas pu espérer avoir une meilleure maman<nbsp>!
#. speaker: WUKLAMAT
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001280_WUKLAMAT:1"
msgid "Thank you, thank you. You're everything I could've asked for─the <i>best</i> mother!"
msgstr "Спасибо тебе, спасибо. Ты дала мне всё, о чём я могла мечтать. Ты — <i>лучшая</i> мама!"

#. ja: ああ……嬉しいわ……。
#. de: Hach, was für ein liebes Kind du bist, Wuk Lamat. Ich bin so glücklich.
#. fr: Aaah... Je suis si heureuse...
#. speaker: NAMIKKA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001290_NAMIKKA:1"
msgid "Ahhh... I'm so glad..."
msgstr "Ах... Как же я счастлива..."

#. ja: こうして振り返ると、なんて良い人生だったのでしょう。<br>あなたに出会ってから、私はとても幸せでした。
#. de: Und was für ein erfülltes Leben ich doch hatte. Dich zu treffen, war das Beste, was mir hätte passieren können!
#. fr: En repensant à tout ce que j'ai vécu, j'ai le sentiment d'avoir été vraiment comblée. Quelle chance j'ai eue de te rencontrer...
#. speaker: NAMIKKA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001300_NAMIKKA:1"
msgid "Looking back, I've had a blessed life. And it was because I was a part of yours."
msgstr "Оглядываясь назад, я понимаю, как много мне повезло в жизни. И всё потому, что я была рядом с тобой."

#. ja: 我が子を病で喪い、絶望の底にいた私に、<br>小さなウクラマト様は微笑みを向けてくれた。<br>その瞬間から、あなた様は私の生きる喜びになったのですよ。
#. de: Als ich mein leibliches Kind an eine Krankheit verlor, fühlte ich mich lange Zeit in schier endloser Dunkelheit gefangen. Doch das unschuldige Lächeln deines kleinen, süßen Gesichtes brachte Licht in meine Tage. Du wurdest zum Leuchtfeuer der Freude in meinem Leben.
#. fr: Lorsque la maladie a emporté mon enfant, j'étais désespérée. Mais le jour où j'ai vu ton sourire pour la première fois, mon cœur s'est empli d'une telle joie... C'est là que tu es devenue ma raison d'être.
#. speaker: NAMIKKA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001310_NAMIKKA:1"
msgid "When I lost my child to illness, I thought I'd never know happiness again. But it rekindled in my breast the instant you smiled your little smile at me. You became my purpose. My joy."
msgstr "Когда болезнь отняла у меня ребёнка, я думала, что больше никогда не буду счастлива. Но всё изменилось в тот миг, когда ты улыбнулась мне, совсем ещё крошка. Ты стала смыслом моей жизни. Моей радостью."

#. ja: ナミーカ……。<br>アタシだってそうだ……。
#. de: Und du warst meine Freude, Namikka. Du gabst mir den Mut, voranzuschreiten!
#. fr: Namikka... Tu as toujours été ce que j'avais de plus précieux...
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001320_WUKLAMAT:1"
msgid "You were mine too."
msgstr "Ты тоже была для меня всем."

#. ja: 最期に想いを伝えることができてよかった……。<br>これでもう、私に思い残すことはありません。
#. de: Dass ich diese Gelegenheit erhalten würde<nbsp>... Es gibt nichts, nach dem ich noch verlangen könnte.
#. fr: J'ai enfin pu te dire ce que j'avais sur le cœur, et ça suffit à faire mon bonheur.
#. speaker: NAMIKKA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001330_NAMIKKA:1"
msgid "To have this chance to speak with you again and leave nothing unsaid... I know not how or why, but I am grateful. So grateful."
msgstr "Как же хорошо, что нам удалось поговорить и сказать всё, что было на сердце... Не знаю, как и почему, но я благодарна. Очень благодарна."

#. ja: 私にはこの先のご活躍を見届けることはできませんが、<br>どうか体に気をつけて、元気でいてくださいね。
#. de: Ich glaube, es ist langsam Zeit. Bitte pass auf dich auf, Wuk Lamat, ja?
#. fr: Je ne pourrai malheureusement pas être témoin de tes futurs exploits, mais sache que je veillerai toujours sur toi. Sois prudente, d'accord<nbsp>?
#. speaker: NAMIKKA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001340_NAMIKKA:1"
msgid "Where you must go, I cannot follow, but know that I'll always be with you. Take care of yourself. Promise me."
msgstr "Я не смогу идти с тобой дальше, но знай: я всегда буду рядом. Береги себя. Пообещай мне."

#. ja: ……ありがとよナミーカ。
#. de: Das werde ich! Danke, Namikka. Danke für alles!
#. fr: Je te le promets, Namikka.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001341_WUKLAMAT:1"
msgid "I will, Mama. I will."
msgstr "Обещаю, мама. Обещаю."

#. ja: それじゃあ……行ってくるぜ！
#. de: Bis wir uns wiedersehen.
#. fr: Au revoir... et merci<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001350_WUKLAMAT:1"
msgid "And one day...we'll meet again!"
msgstr "И однажды... мы встретимся снова!"

#. ja: これがスフェーンが抱えていた、<br>いつまでも残したかったものなんだな。
#. de: Das ist also der Schmerz, den du auf ewig tilgen willst, Sphene.
#. fr: Sphene... C'est donc ce déchirement qui t'était in<shy>sup<shy>por<shy>ta<shy>ble...
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001360_WUKLAMAT:1"
msgid "I understand why Sphene cannot bear to let them go."
msgstr "Теперь я понимаю, почему Сфен так тяжело с ними расставаться."

#. ja: でもよ、スフェーン……
#. de: Aber trotzdem!
#. fr: Mais même si ça fait mal de dire adieu...
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001370_WUKLAMAT:1"
msgid "But as painful as it is to part..."
msgstr "Но как бы ни было больно прощаться..."

#. ja: 命は受け継がれていくもの。<br>すべてを永遠にそのままなんて……できやしねぇんだ……。
#. de: Der Tod ist Teil des Lebens. Wenn alles ewig weitergehen würde<nbsp>... Wo ist da der Sinn? Wofür würden die Leute überhaupt leben wollen?
#. fr: C'est ainsi que la nature l'a voulu. On naît, on vit... et un jour on doit mourir. Rien n'est <i>éternel</i>...
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001380_WUKLAMAT:1"
msgid "We're meant to live and die. To let go and let others carry on in our stead. We can't cling to everything forever."
msgstr "Так уж устроена жизнь: мы рождаемся, живём и умираем. Отпускаем тех, кто ушёл, а после нас живут другие. Нельзя вечно цепляться за прошлое."

#. ja: さあ、先へ進もうぜ……！
#. de: Kommt! Wir haben keine Zeit zu verlieren!
#. fr: Bref, y a du pain sur la planche. En avant<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001390_WUKLAMAT:1"
msgid "Come, let's keep moving!"
msgstr "Ну, пойдём дальше!"

#. ja: ……おやすみ、みんな。
#. de: Schlaft gut<nbsp>...
#. fr: Bonne nuit, tout le monde...
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001400_CAHCIUA:1"
msgid "Sleep tight, everyone..."
msgstr "Спите спокойно, все..."

#. ja: (-古風な王国騎士-)見ない顔だが、助太刀に感謝する！
#. de: (-Altmodischer Ritter-)Ein neues Gesicht! Danke für Eure wackere Unterstützung, <if $gn4>verehrte Dame<else>verehrter Herr</if>!
#. fr: (-Chevalier en armure antique-)J'ignore qui vous êtes, mais merci pour votre salutaire in<shy>ter<shy>ven<shy>tion<nbsp>!
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001410_OTIS:1"
msgid "(-Old-fashioned Knight-)I know not who you are, but my thanks for your timely aid!"
msgstr "(-Рыцарь из давних времён-)Не знаю, кто вы, но благодарю за своевременную помощь!"

#. ja: ふたりとも、すっごく強かった！
#. de: Das war absolut fabelhaft!
#. fr: Ouah, vous êtes trop forts<nbsp>!
#. speaker: YESTERLANDGIRL
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001420_YESTERLANDGIRL:1"
msgid "You're both so strong!"
msgstr "Вы оба такие сильные!"

#. ja: オーティスやるじゃん！　そっちの人も！
#. de: Ja, das war großartig, Otis! Und du natürlich auch!
#. fr: Bravo, Otis<nbsp>! Et à vous aussi, <if $gn4>Madame<else>Monsieur</if><nbsp>!
#. speaker: YESTERLANDBOY
#. macro: <if $gn4>miss<else>mister</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001430_YESTERLANDBOY:1"
msgid "That was amazing, Otis! And you too, <if $gn4>miss<else>mister</if>!"
msgstr "Вот это да, Отис! И вы тоже, <if $gn4>мисс<else>мистер</if>!"

#. ja: (-オーティスと呼ばれた騎士-)ハハハ！　この程度の魔物、大したことないわ！
#. de: (-Otis?-)Hohoho! Wer wär ich denn schon, mich vor solch nieder<shy>träch<shy>tigen Kreaturen zu verkriechen!
#. fr: (-Chevalier appelé Otis-)Ha ha ha ha<nbsp>! Il en faut bien davantage pour m'impressionner<nbsp>!
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001440_OTIS:1"
msgid "Hahaha! Fiends such as these are naught to be feared."
msgstr "Ха-ха-ха! Таких тварей нечего бояться!"

#. ja: 魔物は……もう片付けたのか？
#. de: Ist noch was für mich übrig? Oh, scheinbar nicht<nbsp>...
#. fr: T'as déjà fait le ménage, c'est ça<nbsp>?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001450_WUKLAMAT:1"
msgid "Well then... Dealt with it already, have you?"
msgstr "Ну что, уже управились с чудовищами?"

#. ja: 安心したまえ、諸君！<br>この王国騎士団長オーティスがいる限り、<br>民に危険が及ぶことはないからな！
#. de: Fürchtet euch nicht, meine lieben Kinder! So wahr <i>ich</i>, Otis, Großmeister der königlichen Ritter, über unser wunderschönes Alexandria wache, soll euch kein Unheil widerfahren!
#. fr: Soyez tranquilles, mes enfants<nbsp>! Otis, le capitaine de la garde royale d'Alexandrie, veille au grain<nbsp>! Aucun danger ne saurait vous atteindre<nbsp>!
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001460_OTIS:1"
msgid "Be at ease, one and all. So long as I, Ser Otis, live and breathe, no citizen shall come to harm!"
msgstr "Успокойтесь, все! Пока я, сэр Отис, жив и дышу, ни один житель не пострадает!"

#. ja: オーティスだって！？
#. de: Moment mal<nbsp>... Otis!?
#. fr: Otis<nbsp>!?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001470_WUKLAMAT:1"
msgid "Otis!?"
msgstr "Отис!?"

#. ja: もしかしてお前……あのオーティスなのか！？
#. de: <i>Der</i> Otis!?
#. fr: Est-ce que tu serais le même Otis...<nbsp>?
#. speaker: WUKLAMAT
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001480_WUKLAMAT:1"
msgid "Of all the people─could you really be <i>that</i> Otis?"
msgstr "Так неужели ты и вправду <i>тот самый</i> Отис?"

#. ja: む……あのオーティスとは何だ？<br>ワタシは常に、このオーティスだが……お主は何者だ？
#. de: Was seid Ihr denn so überrascht, meine Dame? Natürlich bin ich <i>der</i> Otis! Der einzig wahre<nbsp>- wenn ich anmerken darf! Die Frage ist doch, wer seid Ihr?
#. fr: Comment cela, “le même Otis”<nbsp>? Je ne connais qu'un seul Otis, moi-même. Et vous, qui êtes-vous<nbsp>?
#. speaker: OTIS
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001490_OTIS:1"
msgid "I'm certain I do not know what you mean by <i>that</i> Otis. I am who I am─and I should very much like to know who <i>you</i> are."
msgstr "Не понимаю, что вы подразумеваете под <i>тем самым</i> Отисом. Я и есть я. А теперь будьте добры сказать, кто <i>вы</i> такие."

#. ja: 何者って……お前、オーティス・ヴェロナなんだろ？<br>アタシらがグルージャを探してたときに、<br>ヘリテージファウンドで出会ったじゃねぇか。
#. de: W-Wie bitte?! Du bist doch Otis Velona, oder nicht? Wir kennen uns! Erinnerst du dich nicht daran, als wir dich und Gulool Ja zum ersten Mal getroffen haben? Das war vielleicht ein Miss<shy>ver<shy>ständ<shy>nis, was?
#. fr: Tu es bien Otis Velona, le capitaine de la garde royale d'Alexandrie<nbsp>? Nos routes se sont croisées quand on cherchait Gulool Ja.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001500_WUKLAMAT:1"
msgid "You're Ser Otis Velona, lord captain of the royal knights of Alexandria, yes? We met you while searching for Gulool Ja."
msgstr "Вы сэр Отис Велона, капитан королевских рыцарей Александрии, верно? Мы встретились, когда искали Гулула Джа."

#. ja: ほら、飯も一緒に食っただろ？<br>最後はソリューション・ナインで戦って……。
#. de: Und was du uns zu essen gezaubert hast<nbsp>... Ich hätte mich reinlegen können! Aber als wir in Lösung Neun Seite an Seite gekämpft haben, bist du<nbsp>...
#. fr: Tu nous a préparé à manger, et on a même combattu ensemble à Solution Neuf...
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001510_WUKLAMAT:1"
msgid "You cooked a most delicious repast for us. Fought beside us in Solution Nine."
msgstr "Вы приготовили для нас чудесный ужин. А потом сражались рядом с нами в Решении Девять."

#. ja: グルージャ……ソリューション・ナイン……？<br>いったい何を言っている？
#. de: Gulool Ja<nbsp>... Lösung Neun<nbsp>... Ich muss gestehen, diese Namen sind mir gänzlich unbekannt.
#. fr: Gulool Ja<nbsp>? Solution Neuf<nbsp>? Mais de quoi parlez-vous<nbsp>?
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001520_OTIS:1"
msgid "Gulool Ja...? Solution Nine...? I've never heard of such things."
msgstr "Гулул Джа?.. Решение Девять?.. Никогда о таком не слышал."

#. ja: お主らのことなど、まったく知らぬし、<br>ヘリテージ……何とかという場所も知らぬ！
#. de: Und Euch sehe ich auch zum ersten Mal! Warum also<nbsp>...
#. fr: Ces choses me sont par<shy>fai<shy>te<shy>ment inconnues, tout comme vos visages<nbsp>!
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001530_OTIS:1"
msgid "These events of which you speak are utterly unknown to me. As are you─I'm quite confident I would recall if we had met before!"
msgstr "Всё, о чём вы говорите, мне совершенно незнакомо. Как и вы сами. Уж встречу с вами я бы точно запомнил!"

#. ja: もしや、ワタシをからかっているのではあるまいな？
#. de: Moment! Wagt Ihr es etwa, Euch über mich lustig zu machen? Das ist es doch, nicht wahr, ihr Halunken?
#. fr: Vous ne seriez pas en train de vous payer ma tête, par hasard<nbsp>?
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001540_OTIS:1"
msgid "Could this be... \\<gasp> Villainy!? You seek to bewilder me for purposes most foul!"
msgstr "Неужели это... <i>Ах!</i> Злодейство?! Вы хотите сбить меня с толку ради самых гнусных целей!"

#. ja: 違う、違う！<br>からかってねぇって……！
#. de: Nein, warte! So ein Unsinn! Nichts liegt uns ferner, ehrlich!
#. fr: Non non non non non<nbsp>! Pas le moins du monde<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001550_WUKLAMAT:1"
msgid "No, no! No villainy intended, I swear!"
msgstr "Нет, нет! Мы не замышляем ничего дурного, честное слово!"

#. ja: なあ、もしかしてこいつ、<br>アタシらが向こうで出会った奴とは違うのか……？
#. de: Vielleicht ist er ja doch nicht unser Otis<nbsp>...
#. fr: (Rassure-moi, je suis pas devenue folle<nbsp>? C'est bien le même Otis, non<nbsp>?)
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001560_WUKLAMAT:1"
msgid "(Tell me I'm not mad. This is definitely the Otis we know...right?)"
msgstr "(Скажи, что я не сошла с ума. Это же точно тот Отис, которого мы знаем... да?)"

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que répondez-vous<nbsp>?
#. speaker: Q3
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_Q3_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr "Что ответить?"

#. ja: 生身だったころの記憶なのだろう
#. de: Das ist Otis, bevor er einen Blechkörper hatte.
#. fr: Ses souvenirs datent sûrement de l'époque où il était humain.
#. speaker: A3
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A3_000_001_NONE_VOICE:1"
msgid "In the flesh, no less!"
msgstr "Да он же живой!"

#. ja: 機械兵になった後の記憶がないのでは？
#. de: Er hat keine Erinnerungen an sein Dasein als Maschinensoldat.
#. fr: On dirait qu'il n'a pas conscience de son vécu en tant que machine.
#. speaker: A3
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A3_000_002_NONE_VOICE:1"
msgid "An earlier version─he won't remember his time as a machine."
msgstr "Он ещё прежний — ничего не помнит о том времени, когда был механическим солдатом."

#. ja: おいっ、何をヒソヒソと話している！？
#. de: Was flüstert Ihr denn da vor Euch hin!? Das ist nun wirklich keine Art, mit einem königlichen Ritter umzugehen!
#. fr: Allons bon<nbsp>! Des messes basses, maintenant<nbsp>?
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001570_OTIS:1"
msgid "I say, what are you whispering about there!?"
msgstr "Послушайте, о чём это вы шепчетесь?"

#. ja: すまぬが、建国祭の準備に忙しくてな。<br>わけのわからぬ話に付き合っている暇はないのだ。
#. de: Wenn Ihr mich dann bitte entschuldigen würdet<nbsp>- ich habe Besseres zu tun, als meine Zeit mit Euch Tagedieben zu verschwenden. Eine Gründungsfeier will vorbereitet werden.
#. fr: Vous m'excuserez, je n'ai pas le temps pour ces enfantillages. On m'attend pour les préparatifs de la fête de la Fondation.
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001580_OTIS:1"
msgid "Wait─I've no time for this! I must attend to my preparations for the Founding Celebration."
msgstr "Погодите, мне некогда! Надо заняться подготовкой к празднику основания!"

#. ja: なにせ祭りでは、子どもたちにせがまれて、<br>芝居に出ることになっているのだからな！
#. de: Immerhin habe ich mich dazu erbarmt, während der Festlichkeiten meine Schau<shy>spiel<shy>kunst in einem Theaterstück zur Schau zu stellen. Zur Belustigung des Volkes<nbsp>... Ihr könnt Euch gar nicht vorstellen, wie groß die Augen der Kinder wurden, als sie mich anflehten, mitzumachen, hoho.
#. fr: Ces jeunes gens ont éminemment insisté pour que je monte sur les planches pendant le spectacle. Comment aurais-je pu refuser<nbsp>?
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001590_OTIS:1"
msgid "The children begged and begged that I perform in the marquee play, and I cannot possibly disappoint them!"
msgstr "Дети так просили меня сыграть в праздничном представлении. Ну как я мог им отказать?"

#. ja: では、これにて失礼！
#. de: Und damit wünsche ich Euch einen schönen Tag! Ich hoffe, Ihr wahrt fortan etwas mehr Anstand, verehrte Fremde!
#. fr: Sur ce, je me permets de prendre congé. Soyez sages en mon absence<nbsp>!
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001600_OTIS:1"
msgid "I take my leave of you. Good day!"
msgstr "Позвольте откланяться. Всего доброго!"

#. ja: 建国祭……？
#. de: Eine Gründungsfeier ...?
#. fr: La fête de la Fondation...<nbsp>?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001610_WUKLAMAT:1"
msgid "Founding Celebration...?"
msgstr "Праздник основания?.."

#. ja: 招待されて来てみたものの……<br>いったい何が始まるのかしら？
#. de: So ein Trubel! Was hier wohl gleich losgehen wird?
#. fr: Nous voilà donc au lieu des célébrations... Je me demande quel est le programme.
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001620_KRILE:1"
msgid "Well, this seems to be the right place. What's on the program, I wonder."
msgstr "Похоже, мы пришли куда надо. Интересно, что тут будет?"

#. ja: ウクラマトたちも見当たらないな。
#. de: Wuk Lamat und <if $gn4>unsere umtriebige Freundin<else>unser umtriebiger Freund</if> sind auch nirgendwo zu sehen.
#. fr: Je ne vois pas les autrrres...
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001630_GRAHATIA:1"
msgid "And where are the others, for that matter..."
msgstr "И где, кстати, остальные?.."

#. ja: さあて、お集まりの皆様！<br>今宵我らが語る物語は、はるか遠い昔の物語でございます。
#. de: Sehr verehrtes Publikum! Unsere heutige Aufführung erzählt von Ereignissen aus einer längst vergessenen Zeit.
#. fr: Mesdames et Messieurs<nbsp>! La pièce que nous allons jouer devant vous raconte une histoire qui s'est déroulée dans un très lointain passé.
#. speaker: YESTERLANDTROUPE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001640_YESTERLANDTROUPE:1"
msgid "Ladies and gentlemen, boys and girls! Tonight's performance is a story that takes place long, long ago."
msgstr "Дамы и господа, мальчики и девочки! Сегодняшнее представление — история о событиях давным-давно."

#. ja: かつて、このアレクサンドリア王国は、<br>エレクトロープを巡る大きな争いに巻き込まれました。
#. de: Es begab sich zu der Zeit, als unser wunderschönes Alexandria in einen Konflikt um wertvolles Elektrob verwickelt wurde.
#. fr: Alors que le conflit pour le contrôle de l'électrope faisait rage, le royaume d'Alexandrie était plongé dans un profond chaos.
#. speaker: YESTERLANDTROUPE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001650_YESTERLANDTROUPE:1"
msgid "A great conflict rages over precious electrope, and the Kingdom of Alexandria has been embroiled in the chaos."
msgstr "Разразилась великая битва за драгоценный электроп, и королевство Александрия оказалось втянуто в хаос."

#. ja: これは勇敢な我が国の王国騎士たちが、<br>命を懸けてスフェーン様を護り抜くお話です。
#. de: Und in diesen Zeiten des Tumultes schworen die tapferen Helden der Krone, Königin Sphene mit ihrem Leben zu beschützen.
#. fr: Mis à mal par le siège de la capitale, les vaillants chevaliers de la garde royale risquèrent leur vie pour protéger Sa Majesté la reine Sphene...
#. speaker: YESTERLANDTROUPE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001660_YESTERLANDTROUPE:1"
msgid "When the royal capital comes under siege, the kingdom's valiant knights lay their lives on the line for their beloved Princess Sphene."
msgstr "Когда столицу осадили, доблестные королевские рыцари рисковали жизнью, защищая любимую принцессу Сфен."

#. ja: それでは皆様、<br>厚手のハンカチをご用意してお楽しみください。
#. de: Und nun, meine Damen und Herren, ist es endlich so weit! Haltet Eure Liebsten fest und greift zu den Taschentüchern, denn hier bleibt kein Auge trocken<nbsp>- Bühne frei!
#. fr: Et à présent, noble assistance, veuillez vous munir de vos mouchoirs, car la repré<shy>sen<shy>ta<shy>tion va commencer<nbsp>!
#. speaker: YESTERLANDTROUPE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001670_YESTERLANDTROUPE:1"
msgid "I bid you keep your handkerchiefs at hand. Now, without further ado..."
msgstr "Прошу вас приготовить платочки. Ну а теперь, без лишних слов..."

#. ja: わあ、見て！
#. de: Da! Guck mal!
#. fr: Oh, regardez<nbsp>!
#. speaker: YESTERLANDGIRL
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001680_YESTERLANDGIRL:1"
msgid "\\<gasp> Look!"
msgstr "[Ахает] Смотрите!"

#. ja: 王国騎士だ！
#. de: Auf dem Balkon! Ein Ritter!
#. fr: C'est <if $gn4>une garde royale<else>un garde royal</if>, à droite<nbsp>!
#. speaker: YESTERLANDBOY
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001690_YESTERLANDBOY:1"
msgid "Yeah! It's a royal knight!"
msgstr "Да! Это же королевский рыцарь!"

#. ja: え……えええっ！？
#. de: Ah - Bitte was?!
#. fr: Mais... Dites-moi que je rêve<nbsp>!?
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001700_KRILE:1"
msgid "I beg your pardon!?"
msgstr "Простите, что!?"

#. ja: アハハ！　最っ高じゃないか！
#. de: Hahaha! Großartig!
#. fr: Ha ha ha ha<nbsp>! Ça promet<nbsp>!
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001720_CAHCIUA:1"
msgid "Ahaha! What a twist!"
msgstr "Ахаха! Вот это поворот!"

#. ja: 何してんだ、あいつらは……。
#. de: Die beiden sind sich für nichts zu schade<nbsp>...
#. fr: Comment <if $gn4>elles se sont retrouvées<else>ils se sont retrouvés</if> là...<nbsp>?
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001730_ERENVILLE:1"
msgid "\\<sigh> Unbelievable..."
msgstr "[Вздыхает] Ну и ну..."

#. ja: ふっ！
#. de: Hng!
#. fr: [Donne un coup d'épée, forcé]
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001740_WUKLAMAT:1"
msgid "[SLASHING EXERT “Hah!”]"
msgstr "[Рубит мечом, усилие: «Ха!»]"

#. ja: とりゃあ！
#. de: Huryah!
#. fr: [Donne un autre coup d'épée, forcé]
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001750_WUKLAMAT:1"
msgid "[SLASHING EXERT “Yaaah!”]"
msgstr "[Рубит мечом, усилие: «Я-а!»]"

#. ja: ぐあああ！<br>や、やられたあ……！
#. de: Guaaah! Ich sterbeee!
#. fr: Aaaaah<nbsp>! O-on me pourfend...
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001760_WUKLAMAT:1"
msgid "Arrrgh! I-I am killed!"
msgstr "А-а-ах! Я... я убит!"

#. ja: みんな、逃げてー！
#. de: Flieht! Flieht, meine Lieben!
#. fr: Vite, fuyez tous<nbsp>!
#. speaker: QUEENACTOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001770_QUEENACTOR:1"
msgid "You must flee, all of you!"
msgstr "Бегите все!"

#. ja: スフェーンさまだ！
#. de: Juchhu! Sphene!
#. fr: Sa Majesté Sphene<nbsp>!
#. speaker: YESTERLANDGIRL
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001780_YESTERLANDGIRL:1"
msgid "Princess Sphene!"
msgstr "Принцесса Сфен!"

#. ja: てええい！
#. de: Hyaaah!
#. fr: [Donne un coup d'épée, forcé]
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001790_OTIS:1"
msgid "[SLASHING SWORD EXERT “Hyaaah!”]"
msgstr "[Рубит мечом, усилие: «Хья-а!»]"

#. ja: スフェーン様、ご無事ですか？
#. de: Meine Königin, seid Ihr wohlauf?
#. fr: Vous allez bien, Ma Reine<nbsp>?
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001800_OTIS:1"
msgid "Are you unharmed?"
msgstr "Вы не пострадали?"

#. ja: ああ……ありがとう、私のオーティス！
#. de: Ja<nbsp>... Es geht mir gut. Ich danke dir, mein teuerster Otis!
#. fr: Oui, grâce à toi... mon Otis chéri<nbsp>!
#. speaker: QUEENACTOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001810_QUEENACTOR:1"
msgid "I am thanks to you, my dearest Otis!"
msgstr "Благодаря тебе... спасибо, мой дорогой Отис!"

#. ja: 私の……って？
#. de: Mein teuerster Otis?!
#. fr: Mais bien sûr...
#. speaker: WUKLAMAT
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001820_WUKLAMAT:1"
msgid "My <i>dearest</i>...?"
msgstr "Мой <i>дорогой</i>..."

#. ja: こうして、王国騎士の活躍もあり、<br>アレクサンドリアは辛くも勝利したのでした。
#. de: Und so war es der Heldenmut unserer tapferen Ritter, welcher Alexandria an jenem Tag zum Sieg verhalf.
#. fr: C'est ainsi que, grâce au courage de ses valeureux chevaliers, le royaume d'Alexandrie parvint à repousser les assaillants qui menaçaient de l'envahir.
#. speaker: YESTERLANDTROUPE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001830_YESTERLANDTROUPE:1"
msgid "And so, in no small part due to the valor of the royal knights, the kingdom succeeds in repelling the invaders."
msgstr "И вот благодаря доблести королевских рыцарей королевству удалось отбросить захватчиков."

#. ja: しかし……悲劇は起きてしまったのです！
#. de: Doch die süße Freude des Triumphes sollte nicht lange währen<nbsp>...
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment, cette joie ne fut que de courte durée...
#. speaker: YESTERLANDTROUPE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001840_YESTERLANDTROUPE:1"
msgid "But their jubilation proves short-lived..."
msgstr "Но радость победы была недолгой..."

#. ja: ああ、なんということでしょうか。<br>敵国が投入した最終兵器により、大災害が発生……
#. de: In seiner Ver<shy>zweif<shy>lung erschuf der Feind eine Waffe von unvorstellbarer Zer<shy>störungs<shy>kraft. Ihr Einsatz gebar eine Katastrophe, so verheerend, dass ganze Kontinente ausgelöscht und zahlreiche Leben gelassen wurden<nbsp>...
#. fr: Loin de s'avouer vaincue, la nation ennemie revint à la charge avec une arme surpuissante, provoquant une catastrophe sans précédent...
#. speaker: YESTERLANDTROUPE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001850_YESTERLANDTROUPE:1"
msgid "For in mad defiance, the enemy unleashes a forbidden weapon which brings about a terrible calamity. Full many lose their lives..."
msgstr "В отчаянной попытке враг применил запретное оружие, вызвавшее страшное бедствие. Многие погибли..."

#. ja: スフェーン様は、後遺症で命を落としてしまったのです……！
#. de: Unter ihnen<nbsp>... unsere geliebte Königin Sphene<nbsp>...
#. fr: D'innombrables vies furent perdues, et parmi elles, celle de Sa Majesté la reine Sphene...
#. speaker: YESTERLANDTROUPE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001860_YESTERLANDTROUPE:1"
msgid "The good Queen Sphene, shining vision of hope, among them..."
msgstr "Среди них оказалась и добрая королева Сфен, наша надежда и отрада..."

#. ja: ちょっと……！<br>ここは彼女に駆け寄って締めてもらわないと……！
#. de: Komm schon! Das ist deine Szene!
#. fr: Hé<nbsp>! C'est là que t'es censé courir vers elle...<nbsp>!
#. speaker: YESTERLANDTROUPE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001870_YESTERLANDTROUPE:1"
msgid "(Go to her! You're supposed to go to her!)"
msgstr "(Иди к ней! Ты же должен к ней подойти!)"

#. ja: なんだ？
#. de: Was ist los?
#. fr: Qu'est-ce qui se passe<nbsp>?
#. speaker: YESTERLANDBOY
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001880_YESTERLANDBOY:1"
msgid "What's happening?"
msgstr "Что происходит?"

#. ja: これでおしまいなの？
#. de: Ist es denn schon vorbei?
#. fr: C'est déjà fini<nbsp>?
#. speaker: YESTERLANDGIRL
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001890_YESTERLANDGIRL:1"
msgid "Is it over already?"
msgstr "Уже всё?"

#. ja: コホン！
#. de: Ähem!
#. fr: [S'éclaircit la gorge]
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001900_WUKLAMAT:1"
msgid "[CLEARING THROAT]"
msgstr "[Откашливается]"

#. ja: あ～っと、しかし大いなる悲しみにあっても、<br>人々は、スフェーン様の遺志を継ぎ……
#. de: Zwar ward das Volk von tiefster Trauer ergriffen ... Doch das Erbe ihrer Königin sollte sie auch weiterhin führen.
#. fr: Et... malgré l'immense tristesse des Alexandrins après la disparition de leur souveraine... ils entreprirent d'accomplir ses dernières volontés.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001910_WUKLAMAT:1"
msgid "And then...though the people grieved their queen's tragic passing, guided by her legacy of compassion..."
msgstr "А потом... люди оплакивали трагическую гибель королевы, но её наследие, её милосердие помогли им..."

#. ja: えーと……<br>苦難の時代を乗り越え、新たな王国を……<br>新生アレクサンドリア連王国を興し、今の繁栄を築いたのだ！
#. de: Ähm ... Sie arbeiteten tagein, tagaus, und am Ende ihrer Mühen gelang es, ein neues Alexandria zu errichten<nbsp>- ein wunderbares Königreich!
#. fr: Main dans la main... i-ils travaillèrent d'arrache-pied... pour... surmonter cette épreuve, et fonder une nouvelle nation. Le royaume de... euh, Néo-Alexandrie<nbsp>!
#. speaker: WUKLAMAT
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001920_WUKLAMAT:1"
msgid "Oh boy. They, um...worked hand in hand to overcome an age of hardship, and in time...they built a peaceful and prosperous Alexandria─a <i>new</i> Alexandria!"
msgstr "Ну... они вместе... преодолели тяжёлые времена, а потом... построили мирную и процветающую Александрию. <i>Новую</i> Александрию!"

#. ja: かたじけない……。<br>当時を思い出したら、体が動かなくなってしまってな。
#. de: Entschuldigt bitte meine Unzuverlässigkeit auf der Bühne vorhin<nbsp>... Meine Erinnerungen, sie<nbsp>... sie waren plötzlich so präsent und hielten mich in ihrem Bann<nbsp>...
#. fr: Je vous prie de me pardonner... Lorsque je me suis remémoré les événements, mon corps s'est pétrifié...
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001930_OTIS:1"
msgid "Pray forgive me... The memories...they had me in a vice grip..."
msgstr "Молитва... Воспоминания... будто сковали меня по рукам и ногам... Простите меня..."

#. ja: 気にすんなって！<br>なんだかんだで、アタシらも楽しかったからさ！
#. de: Ach, Schwamm drüber! Letzten Endes war es doch ein Riesenspaß, oder nicht?
#. fr: Inutile de t'excuser. La repré<shy>sen<shy>ta<shy>tion s'est terminée... tant bien que mal. Le public a apprécié, et nous aussi<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001940_WUKLAMAT:1"
msgid "All's well that ends well. I wouldn't dwell on it."
msgstr "Что ж, всё хорошо, что хорошо кончается. Не стоит об этом думать."

#. ja: ところで……。<br>先ほどお主は、新生アレクサンドリア連王国などと言っていたな？
#. de: Bitte gestattet mir eine Frage<nbsp>... Ihr spracht vorhin von einem „neuen Alexandria“<nbsp>...
#. fr: Au fait, pendant la pièce, vous avez mentionné un royaume de “Néo-Alexandrie”...
#. speaker: OTIS
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001950_OTIS:1"
msgid "If I may ask... During your improvisation, you spoke of a <i>new</i> Alexandria."
msgstr "Позвольте спросить... Во время вашей импровизации вы упомянули <i>новую</i> Александрию."

#. ja: もしやお主らは……後の世から来た者たちなのか？
#. de: Es scheint mir eine verwegene These, doch ... Seid Ihr etwa Reisende aus der Zukunft?
#. fr: Serait-il possible que vous veniez... du futur<nbsp>?
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001960_OTIS:1"
msgid "And so I am given to wonder... Do you hail from a time after mine own?"
msgstr "И вот я думаю... Вы пришли из будущего?"

#. ja: ……そうだ。<br>そして永久人でもなく、命ある存在だ。
#. de: Ganz recht. Und anders als ihr Endlosen sind wir Lebewesen aus Fleisch und Blut!
#. fr: Tout juste. Et contrairement aux Éternels, on a pas encore passé l'arme à gauche.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001970_WUKLAMAT:1"
msgid "We do. And we're living people, not Endless."
msgstr "Да. И мы живые, не вечные."

#. ja: まさか、ここで生者と会うことになろうとは……。
#. de: Lebende? An solch einem Ort? Welche Windungen das Schicksal doch für uns bereithält<nbsp>...
#. fr: Si on m'avait dit que je rencontrerais des vivants ici...
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001980_OTIS:1"
msgid "My word. That I should meet the living in this place..."
msgstr "Вот так встреча... Живые в таком месте..."

#. ja: ならばお主らに、聞きたいことがある。<br>真実を知るのが恐ろしくて、<br>新参の永久人たちに問うことができずにいたことだ……。
#. de: Ich fürchte, in dem Fall müsst ihr mir eine weitere Frage gestatten. Eine Frage, mit der ich schon allzu lange hadere ... aus Angst vor der Wahrheit.
#. fr: Dans ce cas, j'aimerais vous poser une question. Il s'agit d'un sujet que j'ai évité d'aborder avec les nouveaux arrivants, de peur de connaître la vérité...
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_001990_OTIS:1"
msgid "There is another question I dread to speak aloud. A question I couldn't bring myself to pose to newcomers out of fear of the truth..."
msgstr "Есть ещё один вопрос, который страшно задать вслух. Не решался спрашивать об этом новоприбывших, боясь услышать правду..."

#. ja: アレクサンドリアは……今も健在か？
#. de: Alexandria<nbsp>... Mein geliebtes Königreich<nbsp>... Existiert es noch immer? Erstrahlt es in seinem alten Glanz?
#. fr: Le royaume d'Alexandrie... Existe-t-il encore<nbsp>?
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002000_OTIS:1"
msgid "Alexandria... Does it still exist?"
msgstr "Александрия... Она ещё существует?"

#. ja: ああ。<br>お前が生きていたころとは、<br>だいぶ様変わりしていると思うが……
#. de: Das tut es! Auch wenn es sich nach all der Zeit ein <i>bisschen</i> verändert hat.
#. fr: Oui, même s'il a beaucoup changé depuis ton époque.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002010_WUKLAMAT:1"
msgid "It does. It isn't quite the place you knew, but it endures."
msgstr "Да. Она уже не та, что ты помнишь, но она всё ещё есть."

#. ja: お前たちの子孫は、今もアレクサンドリアの名を掲げて、<br>懸命に前を向いて生きてるぜ。
#. de: Doch ob verändert oder nicht, eure Nachkommen leben auch heute noch ein glückliches Leben als stolze Bürger Alexandrias.
#. fr: Les Alexandrins d'aujourd'hui sont toujours aussi fiers de leur patrie, et ils continuent à aller de l'avant.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002020_WUKLAMAT:1"
msgid "The descendants of your people walk its streets and live each day to the fullest as proud Alexandrians."
msgstr "Потомки твоего народа живут в Александрии и каждый день с гордостью называют себя александрийцами."

#. ja: そうか……そうか！
#. de: So ist das also, hoho!
#. fr: Quel soulagement...
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002030_OTIS:1"
msgid "They live... We live..."
msgstr "Они живы... Мы живы..."

#. ja: 遺憾ながら、スフェーン様はお護りできなかったが……<br>それを聞いて、少し安心した。
#. de: Als sie mich am dringendsten benötigte, konnte ich meine Königin nicht beschützen<nbsp>... Die Schuld verfolgt mich bis zum heutigen Tag<nbsp>... Doch das Wissen um Alexandrias Fortbestand soll mir nun als Balsam für die alten Wunden meiner Seele dienen.
#. fr: Je regretterai à tout jamais de n'avoir su protéger ma reine... mais vos paroles apportent un peu de tran<shy>quil<shy>li<shy>té à mon esprit.
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002040_OTIS:1"
msgid "I-I had failed to protect my queen, but to hear that... It brings me a measure of peace."
msgstr "Я... не смог защитить королеву. Но, услышав это... я обрёл покой."

#. ja: この際、話しておきたいんだけどよ……<br>アタシらは、外でお前の分身みたいな奴に会ったんだ。
#. de: Eine Sache wäre da aber noch, Otis! In diesem neuen Alexandria sind wir dir begegnet<nbsp>... be<shy>ziehungs<shy>weise einem Abbild deiner Seele.
#. fr: Au fait, il faut qu'on te dise... À notre époque, on a rencontré... ton double, en quelque sorte.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002050_WUKLAMAT:1"
msgid "You were there too, Otis. That is, an incarnation of you."
msgstr "Отис, ты тоже был там. Вернее, мы встретили твоё воплощение."

#. ja: 分身だと……？<br>そんな馬鹿な話が……
#. de: Einem Abbild meiner Seele? Was wollt Ihr mir damit sagen<nbsp>...?
#. fr: Mon <i>double</i><nbsp>? Que voulez-vous dire...<nbsp>?
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002060_OTIS:1"
msgid "Of me? That's absurd..."
msgstr "Моё? Да быть того не может..."

#. ja: ……いや、思い出してきたぞ。<br>スフェーン様を蘇らせるための新技術……<br>記憶の抽出と再現とやらに、ワタシは志願して……。
#. de: Aber Moment! Wenn ich mich recht entsinne, gab es doch dieses Programm<nbsp>... Es ging um die Bewahrung und Nachbildung von Erinnerungen, und ich meldete mich freiwillig<nbsp>...
#. fr: Attendez, ça me revient... Lorsqu'ils cherchaient à ressusciter Sa Majesté... Ils travaillaient sur une méthode de pré<shy>ser<shy>va<shy>tion des souvenirs, et je me suis porté volontaire comme cobaye...
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002070_OTIS:1"
msgid "But wait... Something comes back to me. When they were researching a means to resurrect Her Majesty─memory preservation or some such─I volunteered to be a test subject..."
msgstr "Постойте... Кажется, я кое-что вспомнил. Когда искали способ воскресить Её Величество — сохранить воспоминания или что-то в этом роде, — я вызвался стать подопытным..."

#. ja: ……ダメだ、これ以上は思い出せん。<br>して、ワタシの分身はどのような奴だったのだ？
#. de: ... Nein, es nützt nichts. An mehr kann ich mich nicht erinnern. Aber sagt, wie war dieses<nbsp>... Abbild denn so?
#. fr: Non, non, je n'y arrive pas... Ma mémoire est comme embrumée. Mais dites-moi, ce double, quel genre de personne était-il<nbsp>?
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002080_OTIS:1"
msgid "...No, it is a fog I cannot pierce. But pray tell me, this incarnation of myself─what was he like?"
msgstr "...Нет, дальше туман. Не могу ничего вспомнить. Но скажите, каким было это моё воплощение?"

#. ja: 何と言う？
#. de: Was antwortest du?
#. fr: Que répondez-vous<nbsp>?
#. speaker: Q4
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_Q4_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr "Что ответить?"

#. ja: 誇り高き王国騎士だった
#. de: Er war ein stolzer Ritter Alexandrias.
#. fr: Il était un vaillant chevalier de la garde royale.
#. speaker: A4
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A4_000_001_NONE_VOICE:1"
msgid "He was a proud and valiant knight of the realm."
msgstr "Он был доблестным королевским рыцарем."

#. ja: 立派にアレクサンドリアの王を護った
#. de: Er beschützte seine Königin, ganz wie es seine Pflicht ihm vorschrieb.
#. fr: Il était un brave qui a su protéger sa reine.
#. speaker: A4
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A4_000_002_NONE_VOICE:1"
msgid "He was a brave soul who protected his queen to the last."
msgstr "Он до последнего защищал королеву."

#. ja: それどころか、お前の分身は、<br>グルージャっていう、次代の王も育ててみせた。
#. de: Aber das ist noch nicht alles. Er kümmerte sich auch liebevoll um den zukünftigen König<nbsp>- ein kleiner Junge namens Gulool Ja.
#. fr: Et c'est pas tout<nbsp>! Il a aussi élevé comme son propre fils le prochain roi, Gulool Ja.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002090_WUKLAMAT:1"
msgid " That's not all. He was a father in all but name to the new king, Gulool Ja."
msgstr "И это ещё не всё. Он стал настоящим отцом новому королю, Гулулу Джа."

#. ja: お前は護りたいものを護れなかったのかもしれねぇが、<br>オーティスから受け継がれた記憶は……想いは……<br>アタシらに希望を残したんだよ。
#. de: Otis. Deine Schuld ist nicht weiter von Bedeutung. Denn deine Erinnerung<nbsp>... und dein Herz<nbsp>... sind so voller Liebe und Hingabe, dass sie uns auch viele hundert Jahre später noch die Kraft und Hoffnung geben, die wir benötigen.
#. fr: Tu as peut-être échoué par le passé, Otis, mais ça n'entache en rien la noblesse de ton âme. À travers tes souvenirs et tes aspirations, tu nous as donné un immense courage.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002100_WUKLAMAT:1"
msgid "Whatever you may have failed to do, you're the noblest of souls, Otis. And your deeds─your sacrifice─gave us hope that we sorely needed."
msgstr "Пусть ты и не смог защитить то, что хотел, ты всё равно благороднейший человек, Отис. Твои поступки, твоя жертва дали нам надежду, которой нам так не хватало."

#. ja: くっ、ハッハッハ！
#. de: Hohohoho!
#. fr: Ha ha ha ha<nbsp>!
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002110_OTIS:1"
msgid "Aha... Ahahaha!"
msgstr "Аха... Ахахаха!"

#. ja: なんということだ。<br>これはまるで、奇跡ではないか！
#. de: Wenn man das kein Wunder nennen darf, dann weiß ich auch nicht!
#. fr: J'ai peine à y croire... C'est un véritable miracle<nbsp>!
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002120_OTIS:1"
msgid "'Tis a miracle. Verily, there can be no other way to describe it."
msgstr "Это чудо. Воистину, иначе и не скажешь."

#. ja: 奇跡か……そうだな！<br>今ここでお前から受け取った想いも全部、<br>このアタシが受け継いでいってやるぜ！
#. de: Du sagst es! Und zusammen mit alldem, was uns dein anderes Ich mit auf den Weg gegeben hat, werden wir auch dein Vermächtnis in unseren Herzen tragen!
#. fr: Un miracle... Ouais, on peut le dire<nbsp>! Et tu peux compter sur nous pour préserver ton héritage, comme on l'a fait pour ton double.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002130_WUKLAMAT:1"
msgid "It is. It really is. We bear the legacy of your other self, and we'd be glad to bear yours as well."
msgstr "Да, настоящее чудо! Мы несём наследие твоего второго воплощения и с радостью понесём и твоё."

#. ja: なんと、頼もしい！<br>ならばワタシに思い残すことなどない！
#. de: Welch frohlockender Klang in meinen Ohren. So kann ich endlich in Frieden ruhen.
#. fr: Que demander de plus<nbsp>? Grâce à vous, je vais enfin pouvoir trouver le repos<nbsp>!
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002140_OTIS:1"
msgid "My, what comfort you offer! With such dependable souls to take up my shield, I may rest easy indeed!"
msgstr "Какие же утешительные слова! С такими надёжными людьми, что подхватят мой щит, я и впрямь могу спокойно уйти!"

#. ja: どうか、アレクサンドリア王の力になってやってほしい。
#. de: Doch gewährt mir noch eine allerletzte Bitte: Lasst Seiner Hoheit Gulool Ja Eure volle Unterstützung zu<shy>teil<shy>werden.
#. fr: Protégez Alexandrie, s'il vous plaît. Et veillez sur le roi.
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002150_OTIS:1"
msgid "I beg you, watch over our new king."
msgstr "Прошу вас, позаботьтесь о нашем новом короле."

#. ja: 大戦後のスフェーン様は、殺しても殺しきれぬ悲しみに、<br>いつもお顔を曇らせていた……。
#. de: Wenn ich an Königin Sphene zurückdenke<nbsp>... Ein Schatten der Trauer und Einsamkeit folgte ihr auf Schritt und Tritt<nbsp>...
#. fr: La guerre a bouleversé Sa Majesté Sphene, vous savez. Jusqu'à son dernier souffle, son si beau visage était miné par le chagrin.
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002151_OTIS:1"
msgid "The war changed my queen. To her final moment, grief darkened her gentle countenance."
msgstr "Война изменила королеву. До самого последнего дня скорбь омрачала её доброе лицо."

#. ja: 現在のアレクサンドリア王がどういった方かは存じ上げぬが、<br>今度こそ王が笑えるように……どうか……。
#. de: Ich bitte Euch eindringlich! Auch wenn ich den neuen König nicht kennen mag, so wünsche ich mir nichts sehnlicher, als dass seine Tage von Lachen und Freude erfüllt sein mögen.
#. fr: Je n'ai pas la chance de connaître le nouveau monarque de ma patrie, mais je vous en conjure, faites qu'il garde le sourire...
#. speaker: OTIS
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002152_OTIS:1"
msgid "I've not the honor of knowing Gulool Ja, but I pray, that for all his days, he shall have cause to smile."
msgstr "Я не удостоился чести познакомиться с Гулулом Джа, но молю вас: пусть каждый его день будет поводом для улыбки."

#. ja: ……ああ、任せろ！
#. de: Dafür werden wir alles tun. Verlass dich auf uns!
#. fr: Oui, c'est promis<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002160_WUKLAMAT:1"
msgid "We'll see to it he does, Otis. I swear."
msgstr "Положись на нас, Отис. Обещаю."

#. ja: あの王国騎士はたしか、グルージャの……。
#. de: War der Ritter da nicht<nbsp>...
#. fr: Ce chevalier, c'est lui qui veillait sur Gulool Ja.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002170_CAHCIUA:1"
msgid "That knight─he was the one who looked after Gulool Ja..."
msgstr "Этот рыцарь... Он ведь заботился о Гулуле Джа..."

#. ja: ……彼の想いを、受け継いできたんだね。
#. de: ... Er hat euch seine innersten Wünsche anvertraut, nicht wahr?
#. fr: Alors comme ça, vous avez hérité de ses souvenirs et de ses espoirs...
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002180_CAHCIUA:1"
msgid "And now you follow in his footsteps."
msgstr "И теперь ты идёшь по его стопам."

#. ja: ああ、受け継いださ。
#. de: Ja, das hat er.
#. fr: Oui, et pas seulement des siens.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002190_WUKLAMAT:1"
msgid "And those of others as well."
msgstr "И не только его наследие."

#. ja: オーティスの想いだけじゃない。<br>この国の人たちが、どれほどスフェーンを愛し、<br>平和を願い、求めていたのか……しっかりと受け継いできた。
#. de: Und nicht nur seine. Die Wünsche und Hoffnungen der Endlosen<nbsp>... Sie führen uns vor Augen, wie sehr die Leute Königin Sphene geliebt haben. Wie sehr sie sich nach Frieden sehnten<nbsp>... Wir sind es ihnen schuldig, ihre Träume mit auf unseren Weg zu nehmen.
#. fr: En faisant con<shy>nais<shy>san<shy>ce avec les Alexandrins, on a compris à quel point Sphene était importante pour eux, et qu'ils ne désiraient rien d'autre que la paix. Ces sentiments, on les porte en nous, désormais.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002200_WUKLAMAT:1"
msgid "We've come to know how much Sphene's people loved her. How much they yearned for peace. All of this, we'll carry with us."
msgstr "Мы узнали, как сильно народ Сфен любил её. Как жаждал мира. Всё это мы унесём с собой."

#. ja: ……そうか。
#. de: Verstehe.
#. fr: ... Je vois.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002210_CAHCIUA:1"
msgid "I see."
msgstr "Понятно."

#. ja: 彼らの魔法……巴術に似てない？
#. de: Ist das etwa<nbsp>... Hermetik?
#. fr: Ces sorts... On dirait de la magie arcanique, non<nbsp>?
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002220_KRILE:1"
msgid "That rather resembles arcanima, wouldn't you agree?"
msgstr "Их магия очень напоминает арканистику, вам не кажется?"

#. ja: たしかに。<br>似た魔法が鏡像世界にあっても不思議じゃないが……<br>本当にそっくりだな。
#. de: Es sieht zumindest ganz danach aus. Dass die magischen Disziplinen der Spiegelwelten den unseren ähneln, war zu erwarten. Nicht aber, dass sie derart identisch sind<nbsp>...
#. fr: En effet. Rien d'étrange à trouver des disciplines qui se ressemblent parmi les différents reflets. Mais à ce point, c'est surrrprenant.
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002230_GRAHATIA:1"
msgid "Indeed. While similar arts could have developed independently across reflections, this verges on being identical."
msgstr "И правда. В разных отражениях могли независимо возникнуть похожие искусства, но это почти одно и то же."

#. ja: 変な顔してどうした？
#. de: Was ist denn los?
#. fr: Y a un problème<nbsp>?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002240_WUKLAMAT:1"
msgid "Is something wrong?"
msgstr "Что-то не так?"

#. ja: えっ……！？
#. de: Ha!?
#. fr: ... Comment<nbsp>!?
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002250_KRILE:1"
msgid "What!?"
msgstr "Что?!"

#. ja: (-ミララ族の淑女-)あの……どこかでお会いしましたか？
#. de: (-Mütterliche Milalla-)Ah<nbsp>... Verzeihung, kennen wir uns?
#. fr: (-Femme milalla-)Est-ce qu'on s'est déjà rencontrées quelque part<nbsp>?
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002260_ALAYLA:1"
msgid "(-Milalla Woman-)Do we know each other from somewhere?"
msgstr "(-Женщина-милалла-)Мы раньше где-нибудь встречались?"

#. ja: (-ミララ族の紳士-)おーい、行くぞ！
#. de: (-Väterlicher Milalla-)Komm schon, Schatz!
#. fr: (-Homme milalla-)Il faut qu'on y aille<nbsp>!
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002270_ROBOR:1"
msgid "(-Milalla Man-)Come on, dear!"
msgstr "(-Мужчина-милалла-)Ну же, дорогая!"

#. ja: (-ミララ族の淑女-)ごめんなさいね、もう行かなくっちゃ。
#. de: (-Mütterliche Milalla-)Entschuldigt mich bitte. Wir haben es leider eilig.
#. fr: (-Femme milalla-)Pardonnez-moi, je dois partir.
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002280_ALAYLA:1"
msgid "(-Milalla Woman-)I'm sorry, but I must be going."
msgstr "(-Женщина-милалла-)Простите, мне пора."

#. ja: 待ってください……！
#. de: Einen Moment bitte!
#. fr: S'il vous plaît, attendez<nbsp>!
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002290_KRILE:1"
msgid "Wait, please!"
msgstr "Постойте, пожалуйста!"

#. ja: (-ミララ族の淑女-)もしかして、新しく来た永久人さんかしら？<br>始めは混乱するかもしれないけど、きっとすぐに慣れるわ。
#. de: (-Mütterliche Milalla-)Seid ihr vielleicht Neuankömmlinge? Am Anfang mag zwar alles etwas befremdlich wirken, ihr werdet euch aber sicher im Nu eingewöhnen.
#. fr: (-Femme milalla-)Vous êtes nouvelle, ici<nbsp>? Ne vous inquiétez pas, même si c'est déconcertant au début, on finit par s'habituer.
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002301_ALAYLA:1"
msgid "(-Milalla Woman-)You're new here, I gather. It may seem strange at first, but give it time. You'll grow accustomed to it soon enough."
msgstr "(-Женщина-милалла-)Вы здесь недавно, верно? Сперва всё может показаться странным, но скоро привыкнете."

#. ja: あ、あの……そうではなくて……。
#. de: Nein<nbsp>... das ist es nicht<nbsp>... W-Wie soll ich das nur sagen<nbsp>...?
#. fr: Euh, ce n'est pas ça. En fait, je...
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002310_KRILE:1"
msgid "No, no, I-I'm not... Er... Rather, I'm... Oh, what can I say?"
msgstr "Нет, я... Я не... То есть... Ох, как бы сказать?"

#. ja: そうだ、この耳飾りに見覚えはありませんか！？
#. de: Erinnert ihr Euch vielleicht an diesen Ohrring hier?
#. fr: Ah<nbsp>! Est-ce que vous reconnaissez cette boucle d'oreille, par hasard<nbsp>?
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002311_KRILE:1"
msgid "Of course! This earring─do you recognize it?"
msgstr "Ах да! Вы узнаёте эту серёжку?"

#. ja: (-ミララ族の紳士-)まさか……！
#. de: (-Väterlicher Milalla-)Nein<nbsp>... das kann doch nicht ...!
#. fr: (-Homme milalla-)Impossible<nbsp>!
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002320_ROBOR:1"
msgid "(-Milalla Man-)Impossible!"
msgstr "(-Мужчина-милалла-)Не может быть!"

#. ja: 私、クルルといいます。<br>赤ん坊のころに、こことは異なる世界に渡りました。
#. de: Meine Name ist Krile. Als Säugling wurde ich von dieser Welt in eine andere gebracht.
#. fr: Mon nom est Krile. Alors que je n'étais encore qu'un bébé, j'ai voyagé de ce monde vers un autre, où j'ai grandi sans rien savoir de mon passé.
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002330_KRILE:1"
msgid "My name is Krile. When I was a baby, I was taken from this world to another, where I grew up without knowledge of my past."
msgstr "Меня зовут Крилэ. Когда я была младенцем, меня перенесли отсюда в другой мир. Там я и выросла, ничего не зная о своём прошлом."

#. ja: ただ、私はそれをずっと知らずに生きてきて……<br>ふたつの世界の間には、時間の流れのズレもあるし……<br>おふたりの認識とは……違うかもしれませんが……！
#. de: Bis vor kurzem wusste ich das allerdings selbst nicht. Und dann kommt noch hinzu, dass der Fluss der Zeit dort anders ist und<nbsp>... Und ihr erkennt mich sicherlich nicht wieder, aber<nbsp>...
#. fr: Le temps s'écoule plus ou moins vite selon les dimensions et... c'est peut-être inattendu pour vous, mais j'ai trouvé un moyen de rentrer.
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002340_KRILE:1"
msgid "I know not how much time has passed for you, and er...things may not be as you expect them to be, but...I'm here now. I've found my way back."
msgstr "Я и сама долго об этом не знала. И время в мирах течёт по-разному, так что... возможно, всё не совсем так, как вы ожидали, но... я вернулась. Я нашла дорогу домой."

#. ja: 来たんです、この耳飾りに記録されていたコードを使って。<br>遺されていた扉を開いて……！
#. de: Nun bin ich hier. Dieser Ohrring hier verhalf mir, das Portal ein weiteres Mal zu öffnen.
#. fr: En utilisant le code inscrit dans cette boucle d'oreille, j'ai réussi à ouvrir le portail<nbsp>!
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002341_KRILE:1"
msgid "This earring, it contained a code with which I was able to reopen the gate. And I did, and I'm here, and..."
msgstr "В серёжке был код, с помощью которого я смогла снова открыть врата. Я открыла их, и вот я здесь, и..."

#. ja: (-ミララ族の紳士-)こんなことが起こり得るのか……？
#. de: (-Väterlicher Milalla-)Kann es denn wirklich wahr sein?
#. fr: (-Homme milalla-)Est-ce seulement possible...<nbsp>?
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002350_ROBOR:1"
msgid "(-Milalla Man-)Could it be as she claims...?"
msgstr "(-Мужчина-милалла-)Неужели всё так, как она говорит?.."

#. ja: (-ミララ族の淑女-)嘘を言っているようには感じないわ。<br>それにその耳飾りは、たしかに私たちが託したもの……。
#. de: (-Mütterliche Milalla-)Schau sie dir doch mal genau an, Schatz. Sie sagt die Wahrheit! Und der Ohrring ist mir Beweis genug!
#. fr: (-Femme milalla-)Je n'ai pas le sentiment qu'elle mente. Quant à la boucle d'oreille, il n'y a pas le moindre doute...
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002360_ALAYLA:1"
msgid "(-Milalla Woman-)She's not lying─I can tell. And there is no mistaking the earring..."
msgstr "(-Женщина-милалла-)Я чувствую, что она не лжёт. И эту серёжку ни с чем не спутаешь..."

#. ja: はあっ……
#. de: [ERLEICHTERTES SEUFZEN, MIT JP CHECKEN]
#. fr: [soupir ému]
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002365_ALAYLA:1"
msgid "[DEEP CONTENTED SIGH]"
msgstr "[Глубоко вздыхает с облегчением]"

#. ja: (-ミララ族の淑女-)こんなに大きくなったのね……！
#. de: (-Mütterliche Milalla-)Hach, wie groß du geworden bist, meine liebe Tochter!
#. fr: (-Femme milalla-)C'est bien toi, ma fille chérie...<nbsp>!
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002370_ALAYLA:1"
msgid "(-Milalla Woman-)How you've grown, my darling daughter!"
msgstr "(-Женщина-милалла-)Как же ты выросла, доченька!"

#. ja: はっ…
#. de: [ERLEICHTERTES AUFATMEN]
#. fr: [Soupir empli d'émotions]
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002381_KRILE:1"
msgid "[OVERWHELMED EXHALE]"
msgstr "[Вздыхает, переполненная чувствами]"

#. ja: 20年……経ちましたから……。
#. de: Ich hatte schließlich zwanzig Jahre lang Zeit<nbsp>...
#. fr: Vingt longues années... J'ai tant à vous raconter...
#. speaker: KRILE
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002390_KRILE:1"
msgid "It <i>has</i> been twenty years..."
msgstr "Прошло ведь <i>двадцать</i> лет..."

#. ja: 自己紹介がまだだったな、私の名はロボル。<br>そして妻のアライラだ。
#. de: Wir haben uns noch gar nicht vorgestellt. Mein Name ist Robor und das hier ist meine Frau, Alayla.
#. fr: Eh bien, je crois qu'il est temps de nous présenter... Je suis Robor, et voici mon épouse, Alayla.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002400_ROBOR:1"
msgid "Ah, yes, names. I'm Robor, and this is Alayla...your mother."
msgstr "Ах да, мы ещё не представились. Я Робор, а это Алайла... твоя мать."

#. ja: 聞きたいことはお互い山ほどあるだろうが、<br>とりあえず場所を移動しないか？
#. de: Zweifelsohne haben wir uns viel zu erzählen. Aber wie wäre es, wenn wir uns zunächst an einen etwas ruhigeren Ort begeben würden?
#. fr: Je ne doute pas qu'une montagne de questions vous brûle les lèvres, et nous ne sommes pas en reste... Que diriez-vous de nous rendre dans un endroit plus calme<nbsp>?
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002410_ROBOR:1"
msgid "Doubtless we have a mountain of questions for each other, but perhaps we can take this somewhere quieter?"
msgstr "Наверное, нам всем есть о чём поговорить. Может, найдём место потише?"

#. ja: 東にあるアサイラム・ホットウェルに、休憩できる場所がある。<br>そちらでゆっくり話をしよう。
#. de: Bei den Glühquellen gibt es ein beschauliches Plätzchen. Da ist nicht so viel los und man kann sich deutlich entspannter unterhalten.
#. fr: Il y a un lieu qui s'appelle l'Aven ardent, à l'est d'ici. Nous y serons bien mieux pour discuter.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002420_ROBOR:1"
msgid "The heatwells, for instance. There's a spot there where we can relax and chat."
msgstr "Например, у горячих источников. Там есть местечко, где можно отдохнуть и спокойно поговорить."

#. ja: まさか人生が終わったあとに、<br>こんなご褒美が待っていたなんて……ねえ、あなた？
#. de: Ach, Schatz! Dass uns das Leben selbst nach dem Tod auf solch großartige Art und Weise belohnen würde!
#. fr: Nous n'aurions jamais imaginé recevoir un tel présent une fois notre vie écoulée... N'est-ce pas, Robor<nbsp>?
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002430_ALAYLA:1"
msgid "Never did we imagine that such a reward awaited us. Isn't that so, Robor?"
msgstr "И подумать не могли, что нас ждёт такая награда. Правда, Робор?"

#. ja: あ、ああ……そうだな。
#. de: Ähem<nbsp>... Ja, also<nbsp>...
#. fr: O-oh, oui, oui, ma chérie...
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002450_ROBOR:1"
msgid "Uh...y-yes."
msgstr "Э... д-да."

#. ja: もう、照れてるのよこの人ったら。<br>あなたがこんなに美人に成長したものだから。
#. de: Ha, dein Vater ist ganz sprachlos. Aber wie auch nicht, wenn eine so wunderbare junge Frau vor uns sitzt?
#. fr: Ne fais pas attention à ton père. Il est encore sous le choc d'avoir retrouvé sa fille, et je suis sûre qu'il ne s'attendait pas à la voir aussi rayonnante de beauté.
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002460_ALAYLA:1"
msgid "Oh, don't mind your father. Like me, he's still getting used to seeing you all grown up."
msgstr "Не обращай внимания на отца. Он, как и я, ещё привыкает к тому, что ты уже совсем взрослая."

#. ja: た、耐えられねぇ……あの空気……！
#. de: Das<nbsp>... Das ist ja nicht auszuhalten!
#. fr: Aaah... Cette ambiance coincée, ça commence à me filer de l'urticaire<nbsp>!
#. speaker: WUKLAMAT
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002461_WUKLAMAT:1"
msgid "This is just <i>excruciating</i>..."
msgstr "Это просто <i>мучительно</i>..."

#. ja: 無理もない……。<br>20年の隔たりはそう簡単に埋められないだろうからな。
#. de: Zwanzig Jahre sind eben nicht einfach so aufzuholen<nbsp>...
#. fr: On peut les comprendrrre... Il s'en passe, des choses, en vingt ans.
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002462_GRAHATIA:1"
msgid "Yes, well. A twenty-year blank is not so quickly filled."
msgstr "Да уж. Двадцать лет за один разговор не наверстаешь."

#. ja: どうする……？　このまま見守るか……ッ！？
#. de: Aber wir können doch nicht einfach hier rumsitzen und nichts tun! Sieh sie dir doch mal an!
#. fr: On devrait pas leur donner un petit coup de pouce<nbsp>?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002463_WUKLAMAT:1"
msgid "Even so... There's got to be something we can do..."
msgstr "И всё же... Неужели мы совсем ничем не можем помочь?"

#. ja: よし、ここはオレに任せろ……！
#. de: Ich hätte da eine Idee!
#. fr: Je crrrois que j'ai une idée.
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002464_GRAHATIA:1"
msgid "You know, I think I might have an idea."
msgstr "Знаешь, кажется, у меня появилась идея."

#. ja: ラハくん……？
#. de: Raha?
#. fr: Raha...<nbsp>?
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002465_KRILE:1"
msgid "Raha...?"
msgstr "Раха?.."

#. ja: はむッ
#. de: Ham!
#. fr: [Mange une glace]
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_012465_GRAHATIA:1"
msgid "[BITING INTO ICE CREAM EXERT]"
msgstr "[Откусывает мороженое]"

#. ja: はむッ
#. de: Ham!
#. fr: [Mange une glace]
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_012466_GRAHATIA:1"
msgid "[BITING INTO ICE CREAM EXERT]"
msgstr "[Откусывает мороженое]"

#. ja: 何してんだ、あいつ……？
#. de: Was macht er denn da?!
#. fr: Qu'est-ce qui lui prend...<nbsp>?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002466_WUKLAMAT:1"
msgid "What is he doing...?"
msgstr "Что он делает?.."

#. ja: ふふっ……ふふふ……！
#. de: [FÄNGT AN AMÜSIERT ZU LACHEN]Hihi<nbsp>... Hahahaha!
#. fr: [Rit de la scène absurde]
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002467_KRILE:1"
msgid "[AMUSED LAUGHTER “Hehe... Hehehe!”] "
msgstr "[Весело смеётся: «Хе-хе... Хе-хе-хе!»]"

#. ja: はむッ
#. de: Ham!
#. fr: [Mange une glace]
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002468_KRILE:1"
msgid "[BITING INTO ICE CREAM EXERT]"
msgstr "[Откусывает мороженое]"

#. ja: む、無理して食べなくてもいいのよ……？
#. de: Nicht, dass dir schlecht wird, Kind!
#. fr: I-il ne faut pas te forcer, tu sais...<nbsp>?
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002510_ALAYLA:1"
msgid "Y-You needn't force yourself..."
msgstr "Т-тебе не обязательно доедать..."

#. ja: 生きている君たちには、味がしないだろう？
#. de: Das schmeckt für euch doch nach gar nichts, oder?
#. fr: Pour des vivants comme vous, cela n'a aucun goût, je suppose<nbsp>?
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002511_ROBOR:1"
msgid "It doesn't taste of anything to the living, surely?"
msgstr "Живым ведь мороженое наверняка совсем безвкусным кажется?"

#. ja: いいえ、おいしいんです……。
#. de: Nein, nein. Es ist köstlich!
#. fr: Non non, c'est très bon.
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002520_KRILE:1"
msgid "No, no. It's delicious."
msgstr "Нет, нет, очень вкусное."

#. ja: 本当に……心の底から……！
#. de: Etwas Leckereres habe ich noch nie gegessen!
#. fr: Du fond du cœur... je n'ai jamais rien mangé d'aussi délicieux<nbsp>!
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002530_KRILE:1"
msgid "I mean it. I've never tasted anything so good."
msgstr "Правда. Ничего вкуснее я в жизни не пробовала."

#. ja: ふふっ
#. de: [FRÖHLICH LACHEND,AN JP ANPASSEN]
#. fr: [Très léger rire amusé]
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_012530_ALAYLA:1"
msgid "[HAPPY CHUCKLE “Hehe”]"
msgstr "[Весело посмеивается: «Хе-хе»]"

#. ja: はむっ
#. de: Ham!
#. fr: [Mange une glace]
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_012531_ROBOR:1"
msgid "[BITING INTO ICE CREAM EXERT]"
msgstr "[Откусывает мороженое]"

#. ja: はむっ
#. de: Ham!
#. fr: [Mange une glace]
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_012532_ALAYLA:1"
msgid "[BITING INTO ICE CREAM EXERT]"
msgstr "[Откусывает мороженое]"

#. ja: ……本当ね、とってもおいしいわ。<br>家族がそろうと、こんなにも味が違うのね。
#. de: Du hast Recht, Tochter. Wenn man als Familie an einem Tisch sitzt, schmeckt alles gleich noch einmal besser.
#. fr: ... Tu as raison. C'est tellement meilleur lorsqu'on partage en famille.
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002531_ALAYLA:1"
msgid "It really does taste so much better when we're all together."
msgstr "И правда, когда мы все вместе, оно намного вкуснее."

#. ja: ああ、そうだな。
#. de: Wohl wahr!
#. fr: Oh que oui.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002532_ROBOR:1"
msgid "Yes, indeed."
msgstr "Да, именно так."

#. ja: へっ、こうしちゃいられねぇよな！<br>アタシらも食おうぜ！
#. de: Dieses Eis darf ich mir auf keinen Fall entgehen lassen!
#. fr: Bon, on va pas rester plantés ici. Allons nous régaler, nous aussi<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002533_WUKLAMAT:1"
msgid "I'm suddenly craving dessert. How about you?"
msgstr "Ну, чего мы тут стоим? Давайте и мы мороженого поедим!"

#. ja: ありがとう……こんなに幸せなことってないわ。<br>なんて感謝したらいいかわからないくらいよ。
#. de: Vielen lieben Dank. Ich hätte mir nichts Schöneres wünschen können.
#. fr: Nous n'avons jamais été si heureux... Je ne sais pas comment vous remercier.
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002534_ALAYLA:1"
msgid "Truly, we've never felt so happy in all our lives. We don't know how to thank you."
msgstr "Мы никогда в жизни не были так счастливы. Даже не знаю, как вас благодарить."

#. ja: みなさんのお話をいつまでも聞いていたいけれど……<br>ねえ、私たちに確かめたいことがあるんじゃないかしら。<br>ここまで辿りついた者として。
#. de: Wir könnten den ganzen Tag den spannenden Geschichten über eure vielen Abenteuer zuhören, aber<nbsp>... es gibt doch sicherlich auch einiges, das ihr von uns wissen wollt, oder etwa nicht? Schließlich habt ihr etliche Mühen auf euch genommen, um an diesen Ort zu gelangen.
#. fr: Peut-être avez-vous des questions précises à nous poser<nbsp>? Vous êtes venus de si loin... Ce serait la moindre des choses de répondre à vos interrogations.
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002535_ALAYLA:1"
msgid "But at the very least, we can give you some answers. You've risked so much and come so far for them, after all."
msgstr "Но мы хотя бы можем ответить на ваши вопросы. Вы так многим рискнули и проделали такой долгий путь ради них."

#. ja: あなた方が研究していたという「世界を繋ぐ力」について、<br>よければ詳しく聞かせてくれないか？
#. de: Bitte erzählt uns mehr über die Weltenfusion. Wenn ich mich nicht täusche, habt ihr doch maßgeblich daran geforscht?
#. fr: Pourriez-vous nous en dirrre plus sur ce “pouvoir de relier les mondes” que vous avez contribué à développer<nbsp>?
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002540_GRAHATIA:1"
msgid "'Tis our understanding you were researching a power called interdimensional fusion. Will you tell us about it?"
msgstr "Насколько мы понимаем, вы изучали силу, способную соединять миры. Не расскажете о ней?"

#. ja: 事の始まりは……<br>私たちミララ族が先祖より語り継いできた、ひとつの伝承にある。
#. de: Alles hat seinen Ursprung in einer Legende, die seit Generationen unter uns Milalla weitergegeben worden ist.
#. fr: Tout part d'une légende transmise de génération en génération au sein de notre peuple, les Milalla.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002560_ROBOR:1"
msgid "To begin at the very beginning, there is a legend passed down by our people, the Milalla."
msgstr "Начнём с самого начала. Милалла издавна передают из поколения в поколение одну легенду."

#. ja: はるか昔のこと、ミララ族は異なる世界で生きてきた。<br>そこは一年を通じて美しい花が咲き誇る、<br>常夏の理想郷であったという。
#. de: Unser Volk soll vor langer Zeit auf einer Insel in einer anderen Welt gelebt haben. Man sagt, dass dort das ganze Jahr über die prächtigsten Blüten zu bewundern waren, denn es wurde niemals kalt. Wahrlich das reinste Paradies.
#. fr: Dans un lointain passé, nous vivions dans un autre monde. Nous habitions un endroit paradisiaque où l'été régnait à longueur d'année, et où les fleurs étaient toujours épanouies.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002570_ROBOR:1"
msgid "In the distant past, we abided in a different world. Our homeland was a paradise of eternal summer. The flowers were always in bloom."
msgstr "В далёком прошлом наш народ жил в другом мире. На родине царило вечное лето, и цветы там цвели круглый год."

#. ja: だが、災いが起こって海が凍りつき、<br>多くの犠牲が出るなかで、先祖たちは秘宝に救いを求めた。<br>そして、その力により路を拓き、世界を渡ったのだ。
#. de: Doch dann vereiste eine gewaltige Katastrophe die Meere. Viele ließen ihr Leben in diesen grauen Tagen unerbittlicher Kälte, und so setzten unsere Vorfahren ihre Hoffnungen in ein mystisches Artefakt, auf dass es sie erlösen möge. Mit seiner Macht wurde eine Brücke in eine andere Welt geschlagen, um sich so in Sicherheit zu bringen.
#. fr: Hélas, un terrible cataclysme se produisit et gela les mers. De nombreux Milalla périrent dans le froid, ce qui poussa nos ancêtres à faire appel au pouvoir d'une relique sacrée afin de fuir vers une autre dimension.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002580_ROBOR:1"
msgid "Until, that is, a great calamity turned the very seas to ice. As those around them froze to death, our ancestors looked to a mighty relic for salvation. By its power they opened a portal, and used it to flee to another reality."
msgstr "Но однажды страшное бедствие сковало льдом сами моря. Многие замёрзли насмерть, и предки обратились за спасением к могущественной реликвии. С её помощью они открыли врата и бежали в другой мир."

#. ja: 私たちの一族は、秘宝とされる遺物を受け継いでいてね。
#. de: Dieses Artefakt, von dem in der Legende die Rede ist<nbsp>... Es wurde seit jeher in unserer Familie weitervererbt.
#. fr: Cette relique, que nous appelons “la clef”, symbolise le salut de notre peuple. Elle est depuis considérée comme notre trésor le plus précieux.
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002590_ALAYLA:1"
msgid "The key is none other than that relic, and it has been in the safekeeping of our people since time immemorial."
msgstr "Ключ — та самая реликвия. Наш народ хранит его с незапамятных времён."

#. ja: それが「鍵」と呼ばれるもの……。<br>私たちは、世界が雷の力によって衰退していくなかで、<br>伝承を再現し、異世界に逃れられないかと考えたわけだ。
#. de: Man nennt es auch den „Schlüssel“. Und als die Blitze auf uns herabregneten und der Himmel das Ende unserer Welt zu verkünden schien, suchten wir verzweifelt nach einer Möglichkeit, seine Macht ein weiteres Mal zu aktivieren<nbsp>- ganz wie unsere Vorfahren vor uns.
#. fr: Oui, et alors que ce monde périclitait sous l'influence de l'élément foudre, nous avons tenté de l'utiliser pour ouvrir un nouveau portail et nous réfugier ailleurs, une fois de plus.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002600_ROBOR:1"
msgid "Yes. When lightning threatened this world, we attempted to use the key to flee again like our ancestors once did."
msgstr "Да. Когда этому миру стала угрожать молния, мы попытались с помощью ключа бежать, как когда-то наши предки."

#. ja: だが、努力も虚しく「世界を繋ぐ力」は発動できなかった。<br>プリザベーションが接触してきたのは、そんなときだ。
#. de: Doch so sehr wir uns auch bemühten, es gelang uns einfach nicht. Und kurz darauf kontaktierte uns dann die Wahrung, eine Gruppierung bestehend aus den besten Wissenschaftlern weit und breit.
#. fr: Mais malgré nos efforts, nous n'avons pas réussi à activer son pouvoir. Alors que nous avions perdu tout espoir, c'est là que nous avons été approchés par Préservation.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002610_ROBOR:1"
msgid "Alas, no matter what we tried, we couldn't invoke its power. We had all but given up when Preservation approached us with an offer of partnership."
msgstr "Увы, сколько бы мы ни старались, призвать его силу не удалось. Мы уже почти отчаялись, когда Сохранение предложило нам сотрудничество."

#. ja: 私たちは藁にもすがる想いでその一員となったが、<br>彼らの目的は、異世界からのエーテル<ruby>簒奪<rt>さんだつ</ruby>だった。<br>騙されたと感じたが、後の祭りさ。
#. de: In unserer Ver<shy>zweif<shy>lung schlossen wir uns ihnen an - nur um wenige Zeit später von ihren wahren Absichten zu erfahren: Sie wollten den Äther anderer Welten rauben.
#. fr: À défaut d'alternative, nous avons accepté leur aide. Mais ce n'est qu'après avoir rejoint leurs rangs que nous avons découvert leur véritable intention<nbsp>: s'approprier l'éther des autres dimensions.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002620_ROBOR:1"
msgid "Desperate as we were, we accepted their help...only to later discover their ulterior motive: to plunder other worlds of aether."
msgstr "От безысходности мы приняли их помощь... но позже узнали об их истинной цели: грабить другие миры, забирая их эфир."

#. ja: せめて被害を出す前にと、<br>決死の思いでプリザベーションから離脱し……<br>追っ手の迫る中で、試作段階の扉を占拠して起動させたんだ。
#. de: Wir wussten, was zu tun war. Als Abtrünnige waren wir Tag und Nacht auf der Flucht vor der Wahrung. Nach einer langen Zeit des Bangens gelangten wir endlich an einen Portal-Prototypen und aktivierten ihn.
#. fr: Afin d'éviter le pire, nous avons décidé de quitter l'or<shy>ga<shy>ni<shy>sa<shy>tion. Mais leurs hommes étaient à nos trousses, et pour leur échapper, nous n'avons eu d'autre choix que d'employer un prototype de porte dimensionnelle.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002630_ROBOR:1"
msgid "Seeking to frustrate their plans, we defected from the order. And as their agents closed in on us, we seized control of the prototype gate and activated it."
msgstr "Чтобы помешать их планам, мы покинули организацию. А когда их агенты настигали нас, мы захватили прототип врат и активировали его."

#. ja: あとは、あなた方も知るとおり……。<br>一時的に開いた扉を通じて、娘と「鍵」を異世界に送り、<br>そこで出会った男性に託したの。
#. de: Den Rest der Geschichte kennt ihr ja bereits<nbsp>... Wenn auch instabil, das Portal tat sich auf. Unsere Tochter sowie den Schlüssel vertrauten wir einem Mann auf der anderen Seite an.
#. fr: La suite, vous la connaissez... Nous avons juste eu le temps de confier notre fille et la “clef” à un homme de l'autre côté, avant que le passage se referme.
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002640_ALAYLA:1"
msgid "What followed, you already know. We sent our daughter and the key through the portal, entrusting them to the men we encountered."
msgstr "Дальше вы уже знаете. Мы отправили дочь и ключ через врата, доверив их встретившимся нам мужчинам."

#. ja: この子には不思議な力があって、<br>プリザベーションが、実験対象として狙っていたのよ……。
#. de: Unserem Kind, ihr<nbsp>... wohnt eine mysteriöse Macht inne. Als die Wahrung von dieser erfuhr, zögerten die Schurken keinen Moment. Sie wollten sie umgehend ihren Experimenten unterziehen.
#. fr: Car notre fille est née avec un mystérieux pouvoir... Et après l'avoir appris, ceux de Préservation avaient pour projet de faire d'elle un sujet d'expériences...
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002650_ALAYLA:1"
msgid "You were born with an unusual gift, you see. Upon learning of it, Preservation sought to subject you to experiments."
msgstr "Видишь ли, ты родилась с необычным даром. Узнав об этом, Сохранение захотело поставить над тобой опыты."

#. ja: ……超える力のことか。
#. de: Die Kraft des Transzendierens<nbsp>...
#. fr: Un mystérieux pouvoir... L'Écho, bien sûrrr.
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002660_GRAHATIA:1"
msgid "An unusual gift... The Echo, I daresay."
msgstr "Необычный дар... Полагаю, речь об Эхе."

#. ja: ……あの、ミララ族のこと、<br>もっと詳しく知る方法はありませんか？
#. de: Die Milalla<nbsp>... Gibt es vielleicht einen Weg, mehr über sie zu erfahren?
#. fr: Notre peuple, les Milalla... Comment pourrais-je en apprendre davantage à leur sujet<nbsp>?
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002750_KRILE:1"
msgid "Our people, the Milalla. Are there any ways I might learn more about them?"
msgstr "Наш народ, милалла... Есть ли способ узнать о нём побольше?"

#. ja: うむ、それなら火山にある洞窟に入ってみなさい。<br>私たちミララ族が暮らしていた土地が再現されている。
#. de: Den gibt es in der Tat. In einer Höhle des Vulkans wurde unsere alte Heimat nachgebildet.
#. fr: Je te conseille d'aller visiter la grotte qui se trouve sous le volcan. Notre ancien foyer y est reconstitué à l'identique.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002760_ROBOR:1"
msgid "There are─such as visiting the cavern inside the volcano. Our ancient homeland has been recreated there."
msgstr "Есть, например, пещера внутри вулкана. Там воссоздали нашу древнюю родину."

#. ja: 娯楽施設として作られたものではあるが……<br>歴史や伝承を、ひととおり学べるだろう。
#. de: Es mag sich zwar nur um eine Attraktion zu Vergnügungszwecken handeln, aber das ein oder andere kann man dort trotzdem lernen.
#. fr: Même s'il s'agit d'une attraction ludique, tu pourras y découvrir notre histoire et certaines de nos coutumes.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002770_ROBOR:1"
msgid "While it's intended to serve as an entertaining diversion, it ought to teach you a thing or two about our history and traditions."
msgstr "Пусть это место и задумано как развлечение, там можно узнать кое-что о нашей истории и обычаях."

#. ja: 行ってみてもいいかしら？<br>知りたいの……私たちの祖先のこと。
#. de: Wäre es in Ordnung, wenn wir einen kurzen Abstecher wagen würden? Ich würde so gerne mehr über meine Vorfahren herausfinden<nbsp>...
#. fr: Ça ne vous dérangerait pas qu'on aille y faire un tour<nbsp>? Je serais curieuse d'en apprendre davantage sur mes ancêtres.
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002780_KRILE:1"
msgid "May we go there? Selfish though it may be, I should love to learn of my ancestors."
msgstr "Можно нам туда сходить? Может, это и эгоистично, но мне так хочется узнать о своих предках."

#. ja: それから……両親のことも。
#. de: ... Und natürlich über meine Eltern.
#. fr: Et sur mes parents aussi, bien sûr.
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002781_KRILE:1"
msgid "Of them...and of the legacy my parents entrusted to me."
msgstr "И о наследии, которое оставили мне родители."

#. ja: ああ、行こうぜ！<br>どっちにしろ、アタシらの目的地も、<br>火山を通っていった先だしな。
#. de: Auf jeden Fall! Wir müssen sowieso den Vulkan durchqueren<nbsp>- da liegt das ja fast auf dem Weg!
#. fr: Oui, allons-y<nbsp>! Le volcan est sur notre route, de toute façon.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002790_WUKLAMAT:1"
msgid "Sure, by all means. As it happens, it's on the way to our destination."
msgstr "Конечно! Это как раз по пути к нашей цели."

#. ja: やっと終わりか……！<br>なんか、どっと疲れたぜ……。
#. de: Endlich durch<nbsp>... Mir tut alles weh!
#. fr: Pfiou... Enfin, on y est<nbsp>! Je suis com<shy>plè<shy>te<shy>ment lessivée...
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002800_WUKLAMAT:1"
msgid "Finished at last... Gods, I'm exhausted..."
msgstr "Наконец-то... Боги, как же я устала..."

#. ja: あの伝承が正しいとすると、<br>ミララ族は、原初世界から渡った人々の末裔ということになる。
#. de: Wenn wir der Legende glauben können, haben die Milalla ihre Wurzeln also im Ursprung<nbsp>...
#. fr: D'après la légende, les Milalla sont les descendants de voyageurs originaires du monde primitif.
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002810_KRILE:1"
msgid "If the legend is true, the Milalla were refugees from the Source."
msgstr "Если легенда правдива, милалла были беженцами из Истока."

#. ja: でも、彼らが持っていた秘宝……<br>世界を繋ぐ力の「鍵」とは、いったい……。
#. de: Doch was genau ist bloß dieses mysteriöse Artefakt, das ihnen dazu verhalf, die Welten zu verbinden?
#. fr: Mais cette relique renfermant le pouvoir de relier les mondes... D'où vient-elle, exactement<nbsp>?
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002820_KRILE:1"
msgid "But what is this relic of theirs that can bridge worlds? Who made it, and to what end?"
msgstr "Но что это за реликвия, способная соединять миры? Кто её создал и зачем?"

#. ja: (-？？？？-)「鍵」については、まだ謎が多い。
#. de: (-???-)Der Schlüssel wirft nach wie vor viele Rätsel auf.
#. fr: (-Voix familière-)Aujourd'hui encore, la “clef” est nimbée de mystère.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002821_ROBOR:1"
msgid "Much about the key remains shrouded in mystery."
msgstr "Многое о ключе до сих пор остаётся загадкой."

#. ja: プリザベーションはそこに改造を施し、<br>扉を開閉させられるまでに至ったが……<br>それですら、仕組みを完全に理解した上でのことではないのだ。
#. de: Und die Wahrung ließ nichts unversucht, diese Rätsel zu lösen. Zwar gelang es ihnen letztlich, das Tor zu öffnen, aber gänzlich verstanden hatten sie die Wirkweise des Schlüssels nicht.
#. fr: Préservation a certes réussi à ouvrir un portail, en y apportant quelques mo<shy>di<shy>fi<shy>ca<shy>tions. Mais sans comprendre l'essence de sa structure.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002830_ROBOR:1"
msgid "By augmenting it with electrope, Preservation did succeed in opening a portal. Yet they could never grasp how they had managed to do so, much less the underlying principles of the technology."
msgstr "Сохранение сумело открыть врата, усовершенствовав ключ с помощью электрита. Но они так и не поняли, как им это удалось, не говоря уже о принципах работы этой технологии."

#. ja: あの「鍵」がいつ、誰によって作り出されたのか……<br>そこからもたらされる「世界を繋ぐ力」の本質とは……<br>解明できた者は、ひとりとしていない。
#. de: Wann und von wem wurde der Schlüssel erschaffen? Was genau steckt hinter der ihm innewohnenden Macht? Bisher konnte noch niemand diese Fragen beantworten.
#. fr: Personne ne sait quand et par qui a été fabriqué cet artefact. Quant à la véritable nature du pouvoir de relier les mondes, elle demeure un mystère absolu.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002840_ROBOR:1"
msgid "To this day, not a single person understands the mechanics of interdimensional fusion. Let alone who imbued the key with its power, when they did so, or why."
msgstr "До сих пор никто не понимает, как происходит слияние миров. И уж тем более никто не знает, кто, когда и зачем наделил ключ этой силой."

#. ja: ……気をつけなさい。
#. de: Aber denkt immer daran<nbsp>...
#. fr: ... Mais n'oubliez jamais ceci.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002841_ROBOR:1"
msgid "But remember this."
msgstr "Но запомните вот что."

#. ja: 何者が作りだしたにせよ、物に善悪はない。<br>使う者の心次第で、どちらにも転ぶことだろう。
#. de: Was auch seine Ursprünge sein mögen, ein Ding an sich ist weder gut noch böse. Das hängt ganz allein von den Intentionen jener ab, die es benutzen.
#. fr: Quelle que soit son origine, un objet n'est jamais bon ou mauvais par nature. Ce sont les intentions de son possesseur qui en décident.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002850_ROBOR:1"
msgid "The key is a tool. And like all tools, in and of itself it is a force for neither good nor evil."
msgstr "Ключ — всего лишь инструмент. Сам по себе он не несёт ни добра, ни зла."

#. ja: その心とて、善悪の境目は実に曖昧だ。<br>誰かを救いたいという想いが、<br>別の誰かを滅ぼす脅威になり得る。
#. de: Und selbst die sind nicht immer einfach einzuordnen. Denn was des einen Freud ist, mag des anderen Leid sein. Vergesst das nicht.
#. fr: Et même avec toute la bonne volonté du monde, le salut d'un homme peut signifier le trépas d'un autre... Voilà pourquoi la ligne séparant le bien du mal reste toujours ténue.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002860_ROBOR:1"
msgid "Once taken in hand, however, its capacity for both is made plain. In delivering one man, it may doom another─making a lie of its bearer's every good intention."
msgstr "Но стоит кому-то им воспользоваться — и он способен как спасти одного, так и погубить другого. Так что любые добрые намерения того, кто держит ключ, могут обернуться ложью."

#. ja: プリザベーションも、スフェーン様も、<br>「鍵」を使うのは、愛する人を護るためだと言うでしょう。
#. de: Genau wie die Wahrung vor ihr sucht Sphene lediglich, ihr geliebtes Volk zu schützen, nicht wahr?
#. fr: Qu'il s'agisse de Sphene ou de Préservation, chacun d'entre eux est sans doute convaincu d'agir dans l'intérêt de ceux qui leur sont chers.
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002870_ALAYLA:1"
msgid "As did Preservation, Queen Sphene seeks to wield the key in the name of those she loves."
msgstr "Как и Сохранение, королева Сфен, должно быть, хочет воспользоваться ключом ради тех, кого любит."

#. ja: そうして、多くの人が犠牲になる路を歩み続ける……。
#. de: Und doch führte ihre Liebe sie auf einen Pfad voller Schmerz und Zerstörung<nbsp>...
#. fr: Mais en empruntant cette voie, ils laissent aussi d'innombrables victimes dans leur sillage...
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002871_ALAYLA:1"
msgid "And, in so doing, makes her people party to the destruction of countless souls."
msgstr "И тем самым обрекает свой народ стать соучастником гибели бесчисленных душ."

#. ja: さて、私たちが伝えられる情報は、これですべてよ。<br>最期にあなた方に話すことができて、<br>ようやく役目を終えられた気がするわ。
#. de: Nun, das ist alles, was wir euch mit auf den Weg geben können<nbsp>... Mit unserem Wissen in euren Händen fühlt es sich so an, als hätten wir nach all den Jahren endlich unsere Pflicht erfüllt.
#. fr: Voilà, c'est tout ce que nous avions à vous apprendre. Maintenant que cette discussion est terminée, nous avons enfin le sentiment d'avoir rempli notre rôle.
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002880_ALAYLA:1"
msgid "We have told you all we can. To be able to share this with you at the last... It feels as though we've fulfilled our purpose."
msgstr "Это всё, что мы могли вам рассказать. И под конец поделиться с вами всем этим... Кажется, теперь мы наконец исполнили своё предназначение."

#. ja: 君たちは、ターミナルを停止しに来たんだろう？
#. de: Ihr seid hier, um das System abzuschalten, richtig?
#. fr: Vous êtes venus ici pour éteindre le terminal, n'est-ce pas<nbsp>?
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002890_ROBOR:1"
msgid "You've come to shut down the terminal?"
msgstr "Вы пришли отключить терминал?"

#. ja: ……はい。
#. de: ... Ja.
#. fr: ... Oui.
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002900_KRILE:1"
msgid "...Yes, we have."
msgstr "...Да."

#. ja: でも、もしかして、<br>おふたりなら停止する以外の方法を……！
#. de: A-Aber vielleicht finden wir ja einen anderen Weg! Mit eurer Hilfe muss es doch<nbsp>...
#. fr: Mais si vous connaissez un autre moyen d'arriver à nos fins, dites-le-nous...<nbsp>!
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002910_KRILE:1"
msgid "But perhaps there's another way? One that doesn't require the terminal's deactivation..."
msgstr "Но, может быть, есть другой способ? Такой, чтобы не пришлось отключать терминал..."

#. ja: 私たちの知識が悪用される前に、<br>この記憶を消すすべをずっと探していた。
#. de: Wir suchen schon seit Ewigkeiten nach einer Möglichkeit, unsere Erinnerung zu löschen. In den falschen Händen ist unser Wissen einfach zu gefährlich<nbsp>...
#. fr: Pendant toutes ces années, nous avons cherché à effacer notre mémoire pour éviter que notre savoir soit utilisé à mauvais escient.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002920_ROBOR:1"
msgid "For the longest time, we've sought a means to erase ourselves before our knowledge could be used for ill. And in you we have found it."
msgstr "Мы давно искали способ стереть нашу память, пока наши знания не попали в дурные руки. И вот теперь вы можете нам помочь."

#. ja: この路でいい、進みなさい。
#. de: Dein Pfad ist der richtige, Kind. Wandle weiter auf deinen Wegen<nbsp>... für uns.
#. fr: La voie que tu as choisie est la bonne. Va, et ne te retourne pas.
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002930_ROBOR:1"
msgid "So press on. Press on, and don't look back."
msgstr "Так что продолжай. Иди дальше, не оглядывайся."

#. ja: わかりました……。
#. de: Ich<nbsp>... verstehe.
#. fr: Très bien...
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002940_KRILE:1"
msgid "I will..."
msgstr "Я... поняла."

#. ja: あの……最後に、聞いてもいいですか？
#. de: Es<nbsp>... Es gibt da noch eine letzte Sache<nbsp>...
#. fr: ... Je peux vous poser une dernière question<nbsp>?
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002941_KRILE:1"
msgid "Um... May I ask you one last question?"
msgstr "Эм... Можно задать вам последний вопрос?"

#. ja: ええ、もちろん。
#. de: Was denn, mein Kind?
#. fr: Bien sûr, ma chérie.
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002942_ALAYLA:1"
msgid "Of course, my dear."
msgstr "Конечно, милая."

#. ja: この耳飾りを私に託したのは……<br>扉の制御コードを仕込んだのは……なぜですか？
#. de: Wieso habt ihr mir diesen Ohrring damals mitgegeben? Und wozu die Mühe, in ihm ein Öffnungsprotokoll für das Portal zu speichern?
#. fr: Pourquoi m'avez-vous confié la boucle d'oreille<nbsp>? Et pourquoi y avoir inscrit le code pour ouvrir le portail<nbsp>?
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002943_KRILE:1"
msgid "The earring... Why did you leave it with me?"
msgstr "Серьга... Почему вы оставили её мне?"

#. ja: あなたに、会いたかったからよ……。
#. de: Weil wir dich wiedersehen wollten, natürlich.
#. fr: Car nous rêvions de te revoir...
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002944_ALAYLA:1"
msgid "Because, Krile, we wanted to see you again."
msgstr "Потому что, Крилэ, мы хотели снова увидеть тебя."

#. ja: 身勝手に聞こえるでしょうけれど……<br>手がかりを残しておきたかったの。
#. de: Es mag egoistisch klingen, aber wir konnten einfach nicht anders<nbsp>... Wir wollten dir etwas hinterlassen.
#. fr: Cela peut paraître égoïste, mais nous voulions laisser un indice pour que tu retrouves notre trace.
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002945_ALAYLA:1"
msgid "This may seem self-serving...but we wanted to leave a trace of ourselves with you."
msgstr "Может, это и эгоистично... Но нам хотелось оставить тебе хоть какую-то память о нас."

#. ja: いつの日かあなたと再会できるようにって、<br>どうしても、希望を残しておきたかった…………。
#. de: Die Hoffnung, dass du uns eines Tages finden würdest und wir die Familie sein könnten, die wir schon immer hätten sein sollen.
#. fr: C'était notre façon à nous d'entretenir l'espoir d'être à nouveau réunis un jour.
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002946_ALAYLA:1"
msgid "A hint to guide you to us, so that we could live in hope."
msgstr "Подсказку, которая привела бы тебя к нам, чтобы мы могли надеяться на встречу."

#. ja: いつかこんな日が来ればと、ずっと夢見ていたんだ。<br>だが、いざ願いが叶ってしまったら……<br>私たちに再会を喜ぶ資格があるのか、自信がなくなってな。
#. de: Hach, wie lange wir uns diesen Tag doch herbeigesehnt haben<nbsp>... Und als du dann vor uns standest, da kamen mir plötzlich Zweifel<nbsp>... Haben wir überhaupt ein Recht auf dieses Glück?
#. fr: Nous avons tant attendu ce moment... Et pourtant, maintenant que notre rêve s'est réalisé, je me demande si nous le méritons...
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002947_ROBOR:1"
msgid "We've dreamed of this day for so long. But now that it's become reality, we wonder if we deserve to enjoy it."
msgstr "Мы так долго мечтали об этом дне. Но теперь, когда он настал, мы не знаем, заслужили ли право радоваться."

#. ja: お前を護るためとはいえ、<br>親として、酷いことをしたと思っている……。
#. de: Es war allein zu deinem Schutz, aber dich wegzugeben<nbsp>... Hrm. Wir haben dir so viel aufgebürdet.
#. fr: Même si c'était pour te protéger, nous avons fait quelque chose qu'aucun parent ne voudrait infliger à son enfant...
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002948_ROBOR:1"
msgid "We wanted naught but the best for you, yet we've always wondered how much you might have suffered in our absence..."
msgstr "Мы хотели для тебя только лучшего, но всегда думали, как же тебе было тяжело без нас..."

#. ja: そんな顔はしないでください……<br>とても素敵な人に育ててもらえましたから。<br>ガラフおじいちゃんって言うんです！
#. de: Sagt sowas nicht, bitte. Ich hatte eine wundervolle Kindheit. Und dafür habe ich Großvater Galuf zu danken<nbsp>- er war es, der mich damals aufnahm.
#. fr: Vous ne devez pas culpabiliser. L'homme qui m'a recueillie, Galuf, a toujours été bon avec moi. Il m'a élevée comme sa propre fille<nbsp>!
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002950_KRILE:1"
msgid "Do not torment yourselves so. As fate would have it, you entrusted me to a good man. His name is Galuf, and he raised me as his own."
msgstr "Не мучайте себя. Так уж вышло, что вы доверили меня хорошему человеку. Его зовут Галуф, и он растил меня как родную дочь."

#. ja: それに……素晴らしい仲間にも恵まれました。
#. de: Und<nbsp>... Die besten Freunde habe ich sowieso.
#. fr: Et puis... j'ai eu la chance de nouer des liens avec des amis plus merveilleux les uns que les autres.
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002951_KRILE:1"
msgid "What's more, I've been blessed with the finest comrades anyone could have."
msgstr "А ещё мне достались лучшие товарищи, о каких только можно мечтать."

#. ja: だから、どうか安心してください。
#. de: Ihr müsst euch also gar keine Sorgen machen!
#. fr: Je vous en prie, soyez rassurés.
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002952_KRILE:1"
msgid "It's thanks to you that I am here now, hale and happy."
msgstr "Это благодаря вам я сейчас здесь, жива и счастлива."

#. ja: あなたたちが私を護ってくれたから、<br>私は今……幸せに生きています！
#. de: Nur weil ihr mich so tapfer beschützt habt, lebe ich jetzt ein Leben voller Freude und Glück!
#. fr: Car si je suis en vie et heureuse aujourd'hui, c'est grâce à vous<nbsp>!
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002953_KRILE:1"
msgid "So please, be at peace. Be at peace, Mother, Father."
msgstr "Так что прошу, не тревожьтесь. Будьте спокойны, мама, папа."

#. ja: ふふっ
#. de: [GLÜCKLICHES LACHEN,AN JP ORIENTIEREN]
#. fr: [Très léger rire amusé]
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_012953_ALAYLA:1"
msgid "[HAPPY CHUCKLE “Hehe”]"
msgstr "[Весело посмеивается: «Хе-хе»]"

#. ja: あなたに素敵な名前があるのはわかってる。<br>それでもどうか最期に、この名で呼ぶことを許してほしい……。
#. de: Ich weiß, du hast inzwischen einen anderen, ebenso wundervollen Namen angenommen, aber<nbsp>... ich würde dich gerne ein letztes Mal bei dem Namen rufen, den wir dir damals gaben<nbsp>...
#. fr: Nous savons que tu as un très joli nom. Mais si tu pouvais nous laisser t'appeler par celui que nous t'avons donné, juste une dernière fois...
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002954_ALAYLA:1"
msgid "You already have a beautiful name. But if we might call you by the one we gave you..."
msgstr "У тебя уже есть прекрасное имя. Но позволь нам назвать тебя именем, которое мы дали тебе..."

#. ja: マイア……心から愛してるわ。
#. de: Maya<nbsp>... Unsere Maya. Wir lieben dich von ganzem Herzen.
#. fr: Maya, notre très chère Maya. Nous t'aimons plus que tout au monde.
#. speaker: ALAYLA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002955_ALAYLA:1"
msgid "Maya, our dearest Maya. We love you more than life itself."
msgstr "Майя, наша дорогая Майя. Мы любим тебя больше жизни."

#. ja: マイア……。<br>それが私の……もうひとつの名前なんですね……。
#. de: Maya<nbsp>... Das ist also mein anderer Name<nbsp>...
#. fr: Maya... mon autre nom...
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002956_KRILE:1"
msgid "Maya... M-My name...my name is Maya..."
msgstr "Майя... Моё... моё имя — Майя..."

#. ja: ……本当にいいのか？<br>アタシたちがターミナルを操作したっていいんだぞ。
#. de: Bist du dir wirklich sicher? Wir können das Abschalten auch über<shy>nehmen.
#. fr: Ça va aller, Krile<nbsp>? On peut éteindre le terminal à ta place, si tu préfères.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002957_WUKLAMAT:1"
msgid "Are you sure about this? You can leave the terminal to us, you know."
msgstr "Ты уверена? Мы ведь можем отключить терминал вместо тебя."

#. ja: これは私が……<br>クルル・マイア・バルデシオンがやらないといけない事だから。
#. de: Das ist etwas, das ich ganz allein tun muss - ich, Krile Maya Baldesion.
#. fr: Non. C'est ma res<shy>pon<shy>sa<shy>bi<shy>li<shy>té... Celle de Krile Maya Baldesion.
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002970_KRILE:1"
msgid "No─I must do this. Krile Maya Baldesion must press on. Press on, and..."
msgstr "Нет... Это должна сделать я. Крилэ Майя Бальдесион должна идти дальше. Идти дальше, и..."

#. ja: お父さん！　お母さん！
#. de: Papa<nbsp>... Mama<nbsp>...
#. fr: Papa, Maman...
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002980_KRILE:1"
msgid "Farewell, Mother!"
msgstr "Прощайте, мама!"

#. ja: さようなら！
#. de: Auf Wieder<shy>sehen!
#. fr: Adieu<nbsp>!
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002981_KRILE:1"
msgid "Farewell, Father! "
msgstr "Прощайте, папа!"

#. ja: ……ああ。
#. de: Mhm.
#. fr: Nous serons toujours près de toi, Maya...
#. speaker: ROBOR
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002982_ROBOR:1"
msgid "Farewell."
msgstr "Прощай."

#. ja: ……やり方はわかるね？
#. de: Du weißt, wie's geht, oder?
#. fr: Tu sais ce que tu dois faire...<nbsp>?
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002985_CAHCIUA:1"
msgid "You know how to do it?"
msgstr "Ты знаешь, что делать?"

#. ja: はい……。
#. de: Ja.
#. fr: Oui.
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002986_KRILE:1"
msgid "I do."
msgstr "Знаю."

#. ja: ねえ、みんな聞いてくれるかい？<br>あたしはさ、死ぬ前にやりたいことがふたつあったんだよ。
#. de: He, hört mal alle her! Es gibt da zwei Dinge, die ich vor meinem Tod erledigt haben wollte!
#. fr: Je peux avoir votre attention, un moment<nbsp>? De mon vivant, il y a deux choses qui me tenaient à cœur.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_002990_CAHCIUA:1"
msgid "If I could have everyone's attention. I know we have pressing business, but I'd like to say a few words."
msgstr "Послушайте меня, пожалуйста. Дела у нас не ждут, но я хочу сказать пару слов."

#. ja: ひとつは、エレネッシパの成長を見届けること！
#. de: Erstens: Elene'shpya heranwachsen zu sehen.
#. fr: La première, c'était de voir Elene'shpya grandir.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003000_CAHCIUA:1"
msgid "Before I died, I had two wishes. The first was to see who my Elene'shpya would become."
msgstr "Перед смертью у меня было два желания. Первое — узнать, каким человеком станет моя Эленэшпья."

#. ja: これに関しては、ある意味では叶ったと言えるかな。
#. de: Was mir mehr oder weniger gelungen ist, denke ich.
#. fr: D'une certaine façon, on peut dire que ce vœu est désormais exaucé.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003010_CAHCIUA:1"
msgid "I would say that wish has been fulfilled."
msgstr "Думаю, можно сказать, что оно исполнилось."

#. ja: だって、他人を煙たがってばかりだった子が、<br>こんなに素敵な仲間を、ぞろぞろ連れて来たんだからね！
#. de: Ich mein, schaut euch den Jungen doch mal an! Die schüchterne Rotznase von damals hat jetzt so viele wundervolle Freunde!
#. fr: Alors qu'il était si solitaire autrefois, mon garçon est aujourd'hui entouré d'amis plus attachants les uns que les autres.
#. speaker: CAHCIUA
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003020_CAHCIUA:1"
msgid "Indeed it has, for the boy who once shunned company has returned a <i>somewhat</i> sociable man, surrounded by wonderful friends."
msgstr "Ведь мальчик, который раньше сторонился всех, вернулся <i>почти</i> общительным, да ещё и в окружении замечательных друзей."

#. ja: この子の師としても母としても、<br>これほど嬉しいことはないよ！
#. de: Sowohl als seine Mentorin als auch als seine Mutter gibt es nichts, was mich stolzer machen könnte!
#. fr: En tant que mère, mais aussi mentor, rien n'aurait pu me ravir davantage<nbsp>!
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003030_CAHCIUA:1"
msgid "As his mother and mentor both, I couldn't be more proud."
msgstr "Как мать и наставница, я не могла бы гордиться им сильнее."

#. ja: そして、もうひとつは……<br>まだ見たことのない生き物に出会うこと。
#. de: Und zweitens: Spezies zu entdecken, die mir nie zuvor untergekommen sind!
#. fr: Quant à mon second souhait... J'ambitionnais de découvrir des espèces animales inconnues.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003040_CAHCIUA:1"
msgid "As for my second wish... That was to see all manner of nature that I had never seen before."
msgstr "А второе желание... Я мечтала увидеть самых разных созданий, которых прежде не встречала."

#. ja: 世界中を隅々まで旅して、<br>未知の生き物をひとつでも多く見つけるんだ……！
#. de: Hach, es war immer mein Traum, jeden Winkel unseres Planeten zu bereisen und dabei den kuriosesten Lebewesen auf die Spur zu kommen<nbsp>...
#. fr: Je me voyais déjà parcourir le monde, explorer ses régions les plus reculées, et révéler aux yeux de tous l'existence de créatures encore jamais vues<nbsp>!
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003050_CAHCIUA:1"
msgid "I hoped to explore every corner of the world, and there find thriving life!"
msgstr "Я хотела объехать весь мир, заглянуть в каждый уголок и найти там жизнь!"

#. ja: ……でもまあ、世界どころかトラル大陸さえ、<br>すべて見てまわる前に、おっ死んじまったんだけどね。
#. de: Aber na ja, ihr wisst ja, was passiert ist. Ich hab's noch nicht einmal geschafft, Tural komplett zu sehen, bevor es mich umgehauen hat<nbsp>...
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment, je suis morte avant d'y arriver. Avant même de voir le bout du Tural...
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003060_CAHCIUA:1"
msgid "...But I didn't even get to see all of Tural, did I? Never enough hours in a day, or days in a year. Or years in a life."
msgstr "...Но я даже весь Турал не успела посмотреть, да? В сутках всегда мало часов, в году — дней, а в жизни — лет."

#. ja: カフキワさん……。
#. de: Cahciua<nbsp>...
#. fr: Cahciua...
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003061_KRILE:1"
msgid "Cahciua..."
msgstr "Кахкиуа..."

#. ja: あー！　やめな、やめな。<br>暗い雰囲気は嫌いなんだよ！
#. de: Ach, was mach ich denn? Die Stimmung so zu verderben.
#. fr: Allons, ne faites pas des têtes pareilles<nbsp>! Je déteste voir les gens tristes<nbsp>!
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003070_CAHCIUA:1"
msgid "Oh, don't give me that look! Though admittedly I did go and spoil the mood. Apologies."
msgstr "Ой, да хватит вам! Не люблю я, когда все такие мрачные. Простите, это я испортила настроение."

#. ja: 何が言いたいかって言うと、<br>あんたたちに、あたしの夢を叶えてほしいんだよ。
#. de: Aber wie auch immer. Was ich sagen will, ist: Bitte helft mir, diesen zweiten Wunsch zu erfüllen!
#. fr: Ce que j'essaye de dire, c'est que j'aimerais que vous m'aidiez à réaliser mon second rêve.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003080_CAHCIUA:1"
msgid "What I was so poorly trying to work up to asking was this: I want you to help me fulfill my second wish."
msgstr "Я всё пыталась подвести к главному... Хочу, чтобы вы помогли мне исполнить второе желание."

#. ja: ここにだって、見たことのない生き物がいそうだからね！
#. de: Mein Gespür sagt mir, dass sich hier irgendwo seltene Kreaturen verstecken. Welche, die ich noch nie zuvor gesehen habe. Ich kann sie förmlich riechen<nbsp>...
#. fr: Mon petit doigt me dit qu'il y a dans le coin des bestioles qui n'attendent que nous pour être découvertes<nbsp>!
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003090_CAHCIUA:1"
msgid "I have a good feeling about this place. There is so much here I've never seen before, I just know it!"
msgstr "Кажется, в этом месте полно того, чего я ещё не видела. Я прямо чувствую!"

#. ja: そういうことなら任せてくれよ。<br>喜んで付き合うぜ！
#. de: Eine Jagd also! Nichts lieber als das!
#. fr: Si c'est que ça, avec plaisir<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003100_WUKLAMAT:1"
msgid "We'd love to see it with you."
msgstr "Будем рады отправиться с тобой."

#. ja: あんたたちならそう言ってくれると思ったよ。<br>ありがとね！
#. de: Was anderes habe ich auch gar nicht erwartet. Danke!
#. fr: Je savais que je pouvais compter sur vous. Merci<nbsp>!
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003110_CAHCIUA:1"
msgid "I thought you might say that! Thank you."
msgstr "Я так и думала! Спасибо!"

#. ja: 見てごらん、ここウィンドパスガーデンにはね、<br>かつてアレクサンドリアがあった大陸に棲息していた、<br>いろんな動植物が集められてるのさ。
#. de: Seht euch um! Hier in den Windpfadgärten gibt es allerhand Flora und Fauna, die nur auf dem Kontinent Alexandrias aufzufinden waren.
#. fr: Dans les jardins de Soufflevent, on peut observer un aperçu de la faune et de la flore typiques du continent d'autrefois.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003120_CAHCIUA:1"
msgid "Windspath Gardens is home to a collection of flora and fauna that once thrived on the continent."
msgstr "В Садах ветреных троп собрали множество растений и животных, когда-то обитавших на этом континенте."

#. ja: ただ、機械の遠隔操作にばかり集中してたもんだから、<br>あたしがリビング・メモリーを歩き回るようになったのは、<br>ほんの最近のことでね。
#. de: Wenn ich doch bloß nicht so mit der Fernsteuerung meiner kleinen Roboterdrohne beschäftigt gewesen wäre<nbsp>... dann hätte ich schon längst alles erkundet!
#. fr: Seulement, j'étais tellement concentrée sur le contrôle de mon enveloppe mécanique... Résultat, je n'ai commencé à explorer La Mémoire vivante que récemment.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003130_CAHCIUA:1"
msgid "Like the rest of Living Memory, I haven't explored it in earnest. Controlling my vessel demanded all of my attention."
msgstr "Как и остальную Живую память, я почти не исследовала это место. Всё внимание уходило на управление моим телом."

#. ja: つまり、あたしにとっても、<br>この場所は未知の生き物だらけってこと！<br>最期の冒険の舞台としちゃ、上出来だろ？
#. de: Aber so ist dieses Gebiet nun genauso frisch für mich wie für euch Neuankömmlinge! Der perfekte Schauplatz für ein letztes Abenteuer, meint ihr nicht?
#. fr: Autrement dit, c'est l'endroit parfait pour achever ma dernière aventure sur une bonne note. Vous ne croyez pas<nbsp>?
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003140_CAHCIUA:1"
msgid "But at long last, I'll get to meet the creatures here. Wrap things up with a perfect little adventure. So, shall we?"
msgstr "Но теперь я наконец познакомлюсь со здешними созданиями. Вот и устроим небольшое приключение напоследок. Ну что, пойдём?"

#. ja: ……ちょっと待てよ。
#. de: Moment.
#. fr: ... Attends un peu.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003160_ERENVILLE:1"
msgid "Absolutely not."
msgstr "Ни за что."

#. ja: そんなことで、<br>おふくろの夢は都合よく満たされたことになって、<br>それで、終わりなのかよ！？
#. de: So ist das also, was? Wir erfüllen dir deinen letzten Wunsch und dann ist Schluss? Ende?
#. fr: Une fois ton vœu exaucé, tu vas te volatiliser sans prévenir, c'est ça<nbsp>?
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003170_ERENVILLE:1"
msgid "We're to grant you your wish─and then what? You'll leave?"
msgstr "Мы исполним твоё желание — и что дальше? Ты уйдёшь?"

#. ja: ……納得、できるもんか。
#. de: Die anderen magst du ja überzeugt haben, aber nicht mit mir, Mama!
#. fr: Tu crois vraiment que je vais me contenter de si peu<nbsp>?
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003180_ERENVILLE:1"
msgid "You cannot ask that of me."
msgstr "Ты не можешь просить меня об этом."

#. ja: まったく、困った子だねえ。
#. de: Ach, Junge<nbsp>... Was mach ich nur mit dir<nbsp>...
#. fr: Aaah, Elene'shpya...
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003190_CAHCIUA:1"
msgid "Oh, Elene'shpya..."
msgstr "Ах, Эленэшпья..."

#. ja: ……エレネッシパ、頼むよ。<br>最期は、とびきり楽しい旅にしたいんだ。
#. de: Elene'shpya, ich bitte dich! Meine letzten Momente sollen keine Tränen, sondern Freude bringen. Uns allen.
#. fr: Essaye de comprendre, mon enfant. Je ne demande rien de plus qu'à profiter pleinement de la vie, une dernière fois.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003200_CAHCIUA:1"
msgid "Please understand. I just want it to end on a happy note. Not only for myself, but for all of us."
msgstr "Пойми меня. Я просто хочу, чтобы всё закончилось на радостной ноте. Не только для меня, но и для нас всех."

#. ja: みんなだって湿っぽいのは嫌だろ？
#. de: Niemand mag traurige Abschiede<nbsp>...
#. fr: C'est toujours mieux que des adieux déprimants, non<nbsp>?
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003210_CAHCIUA:1"
msgid "Better that than a sad good-bye, surely?"
msgstr "Всё же это лучше, чем грустное прощание, правда?"

#. ja: ああ、楽しかった！<br>こんなに楽しかったのは、グルージャジャとの旅以来だよ！
#. de: Hach, was für ein Spaß das war! Ich glaube, so sehr amüsiert habe ich mich das letzte Mal auf meiner Reise mit dem Dämmerkönig!
#. fr: Aaah, quel plaisir<nbsp>! Je ne m'étais pas autant amusée depuis mon voyage avec Gulool Ja Ja<nbsp>!
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003220_CAHCIUA:1"
msgid "How delightful this has been! Not since my journey with the Dawnservant have I enjoyed myself so!"
msgstr "Как же славно мы провели время! Я так веселилась в последний раз, когда путешествовала с Рассветным владыкой."

#. ja: ううん……あの時よりも、<br>今の方がずっと満たされた気分だ。
#. de: Wobei<nbsp>... Das nehme ich zurück! So viel Spaß hatte ich noch nie!
#. fr: Non... Tout bien réfléchi, je me sens encore plus heureuse aujourd'hui.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003230_CAHCIUA:1"
msgid "No, I'm selling it short. This was even better."
msgstr "Нет, я себя недооцениваю. Сегодня было ещё лучше."

#. ja: だって、ようやく息子と一緒に冒険できたんだもん。
#. de: Ich kann mir nichts Schöneres vorstellen, als ein Abenteuer gemeinsam mit meinem Sohn.
#. fr: J'ai enfin vécu une aventure avec mon fils, et ça, ça n'a pas de prix.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003240_CAHCIUA:1"
msgid "And that's because I was able to share this adventure with my darling boy."
msgstr "Ведь я наконец-то отправилась в приключение вместе с моим любимым мальчиком."

#. ja: さて、あたしが付き合えるのはここまでさ。<br>あとのことは……
#. de: So. Ich schätze, für mich ist dann hier wohl Schluss<nbsp>... Den Rest überlasse ich<nbsp>...
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment, toutes les bonnes choses ont une fin, et c'est ici que nos routes doivent se séparer. En ce qui concerne le reste...
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003250_CAHCIUA:1"
msgid "Well, this is as far as I can go. As for the rest..."
msgstr "Ну, дальше я уже не пойду. А остальное..."

#. ja: あんたは、いつもいつもそうやって自分で勝手に決めて、<br>どっかに行っちまうんだな。
#. de: Mama! Es ist immer das Gleiche mit dir! Entscheidest alles alleine und verschwindest dann einfach!
#. fr: J'en étais sûr<nbsp>! Comme à chaque fois, tu n'en fais qu'à ta tête avant de disparaître sans crier gare. Ça t'arrive de penser aux autres<nbsp>!?
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003260_ERENVILLE:1"
msgid "Just stop. You're doing it again. Deciding everything by yourself and then disappearing."
msgstr "Хватит. Опять за своё. Всё решаешь сама, а потом просто исчезаешь."

#. ja: エレネッシパ。<br>あたしの弟子ならわかってるだろ？
#. de: Mein lieber Elene'shpya. Du weißt doch bestimmt, was jetzt kommt, oder?
#. fr: Elene'shpya. Avec tout ce que je t'ai appris, tu devrais pourtant comprendre.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003270_CAHCIUA:1"
msgid "Elene'shpya. You're my pupil, so you ought to understand."
msgstr "Эленэшпья. Ты же мой ученик, должен понимать."

#. ja: 生き物はいつか必ず死ぬ。<br>そして、そうなったら復活も再現もない……<br>それが正しい命の巡りなんだ。
#. de: Jedes Leben hat irgendwann ein Ende. Das ist der natürliche Lauf der Dinge. Und sich ihm entgegenzustellen, wäre töricht.
#. fr: Tout être vivant doit mourir un jour. Sans revenir au monde, ou être recréé sous la même forme, car cela va à l'encontre des lois de la nature.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003280_CAHCIUA:1"
msgid "Everything that lives must one day die, and that which has died isn't meant to return. This is the way of nature."
msgstr "Всё живое однажды умирает, и умершее не должно возвращаться. Таков закон природы."

#. ja: 今のあたしは不自然な存在で、<br>この歪んだ状況を壊すためだけに永らえてきた。
#. de: Meine Existenz an sich ist falsch. Und ich hielt sie nur aus, weil sie mir die Möglichkeit gab, diesen grotesken Abklatsch einer Welt zu seinem Ende zu geleiten.
#. fr: L'existence que je mène ac<shy>tu<shy>el<shy>le<shy>ment est une aberration, et je l'ai acceptée pour une seule et unique raison<nbsp>: détruire cette réalité faussée.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003290_CAHCIUA:1"
msgid "Mine is an unnatural existence, and I've suffered it only because I had to unmake this twisted mausoleum."
msgstr "Моё существование противоестественно. Я терпела его лишь потому, что должна была разрушить этот искажённый мавзолей."

#. ja: だけど、みんながここに来てくれたから、<br>ようやくこの使命を託して、自然に還ることができるんだ。
#. de: Doch jetzt, wo ihr alle hier seid, habe ich meine Pflicht erfüllt. Ich kann endlich ruhen.
#. fr: Aujourd'hui, j'ai enfin trouvé des personnes de confiance à qui léguer cette mission, et je peux donc partir en paix.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003300_CAHCIUA:1"
msgid "But now that brave souls have appeared to whom I might entrust my mission, I may finally embrace the end."
msgstr "Но теперь появились смельчаки, которым я могу доверить своё дело. Наконец-то я могу принять конец."

#. ja: ……そんな仏頂面してないで、喜んでくれない？
#. de: Darum zieh doch bitte keine finstere Miene, sondern schenke mir ein Lächeln, Elene'shpya.
#. fr: Tu ne veux pas te réjouir pour moi, au lieu de faire la moue<nbsp>?
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003310_CAHCIUA:1"
msgid "Can't you be happy for me?"
msgstr "Неужели ты не можешь порадоваться за меня?"

#. ja: こんなときに笑えねえよ……。
#. de: Wie soll ich denn <i>lächeln</i> können?
#. fr: Tu crois vraiment que j'ai envie de rire, dans un moment pareil<nbsp>?
#. speaker: ERENVILLE
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003320_ERENVILLE:1"
msgid "How could I be <i>happy</i>?"
msgstr "Как я могу быть <i>счастлив</i>?"

#. ja: ……実を言うとさ、少し怖かったんだ。
#. de: Wenn ich ehrlich bin, hatte ich Angst.
#. fr: ... Pour tout te dire, j'avais peur.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003330_CAHCIUA:1"
msgid "...I was actually quite scared, you see."
msgstr "...Знаешь, на самом деле мне было страшно."

#. ja: このままずっと永久人として障壁に閉じ込められて、<br>知る喜びを感じなくなったら、どうなっちまうんだろうってね。
#. de: Angst, dass ich für immer und ewig ein Dasein als Endlose fristen und jegliche Abenteuerlust verlieren würde.
#. fr: Peur d'être emprisonnée pour toujours dans cet endroit, sans plus jamais connaître l'ivresse de la découverte.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003340_CAHCIUA:1"
msgid "Scared that I'd be trapped inside the barrier forever, and denied the thrill of discovery for all my days."
msgstr "Я боялась, что навсегда останусь запертой за барьером и больше никогда не испытаю радости открытий."

#. ja: だから、あんたが来てくれて、<br>心の底から安心したし、心強かった！
#. de: Du kannst dir gar nicht vorstellen, was mir für ein Stein vom Herzen fiel, als du schließlich kamst. Du hast mir den so bitter nötigen Mut und Trost geschenkt.
#. fr: Si tu savais comme j'étais comblée de te voir... Ta venue m'a mis un tel baume au cœur<nbsp>!
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003350_CAHCIUA:1"
msgid "Your coming gave me courage and comfort, Elene'shpya. More than you know."
msgstr "Ты придал мне сил и успокоил, Эленэшпья. Даже не представляешь, как."

#. ja: うん、今なら断言できる！<br>あたしの人生で最も幸せな瞬間は、今このときさ！
#. de: Und einer Sache bin ich mir absolut sicher: Ich war niemals glücklicher als jetzt, in diesem Moment!
#. fr: Maintenant, j'en suis absolument convaincue. C'est le plus beau jour de ma vie<nbsp>!
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003380_CAHCIUA:1"
msgid "And now, here I stand, unburdened and free! In this moment─the happiest of my life."
msgstr "Теперь я могу сказать точно: я никогда не была так счастлива, как сейчас."

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q5
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_Q5_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr "Что вы скажете?"

#. ja: カフキワの想いを受け継ごう
#. de: Cahciuas Abenteuerdrang soll uns auf ewig begleiten!
#. fr: Portons les espoirs de Cahciua en nous.
#. speaker: A5
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A5_000_001_NONE_VOICE:1"
msgid "And those feelings will live on."
msgstr "И эти чувства останутся с нами."

#. ja: エレンヴィルにしかできないことがある
#. de: Deine Mutter zählt auf dich, Erenville!
#. fr: Ta mère compte sur toi, Erenville.
#. speaker: A5
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A5_000_002_NONE_VOICE:1"
msgid "This is something only you can do."
msgstr "Только ты можешь это сделать."

#. ja: だったら……<br>おふくろの夢は俺が継いでやる！
#. de: Mama ... Ich werde beenden, was du begonnen hast!
#. fr: Puisque c'est comme ça... Je finirai moi-même ce que tu as commencé<nbsp>!
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003390_ERENVILLE:1"
msgid "As you wish, Mother. I'll continue what you began."
msgstr "Как скажешь, мама. Я продолжу твоё дело."

#. ja: こいつらと出会って、ここまで来れた。<br>悔しいけど、あんたの言うとおり世界が広がったんだ。
#. de: Es fällt mir zwar schwer, es zuzugeben, aber<nbsp>... du hattest Recht! Nur mit meinen Freunden habe ich es überhaupt erst bis hierhin geschafft. Mit ihnen an meiner Seite scheint die Welt voll unbegrenzter Möglichkeiten zu sein.
#. fr: Si je suis ici, c'est parce que ma route a croisé celle de toutes ces personnes ex<shy>traor<shy>di<shy>nai<shy>res. Tu avais raison, rien ne se serait passé si j'étais resté enfermé dans mon petit univers.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003400_ERENVILLE:1"
msgid "You were right, of course─leaving home has broadened my horizons. I've met my friends and found this place."
msgstr "Ты была права: стоило уехать из дома, и мой мир стал шире. Я встретил друзей и нашёл это место."

#. ja: だから、あんたが行けなかった場所まで旅をする……
#. de: Die Reisen, die dir verwehrt blieben, will ich an deiner Stelle antreten.
#. fr: Sois tranquille, ton rêve est entre de bonnes mains...
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003410_ERENVILLE:1"
msgid "So I bid you leave your dreams with me..."
msgstr "Так что позволь мне отправиться туда, куда ты не успела..."

#. ja: あんたの……おふくろの夢は、俺が叶える……必ず！
#. de: Deine Träume<nbsp>... Ich werde sie zu Ende träumen. Komme, was wolle!
#. fr: J'en fais le serment... Je le réaliserai, et j'irai au bout de ton voyage<nbsp>!
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003411_ERENVILLE:1"
msgid "And know─I'll go where you couldn't go and do what you couldn't do! I will!"
msgstr "Я исполню твою мечту, мам... Побываю там, куда ты не добралась, и сделаю то, что не успела. Обещаю!"

#. ja: ……参ったな。<br>本当に頼もしくなっちゃってさ。
#. de: Hah. Wie stark dein Herz geworden ist.
#. fr: Merci, Elene'shpya... Je sais que je peux te faire confiance.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003420_CAHCIUA:1"
msgid "Look at you, all grown up and dependable."
msgstr "Посмотри на себя — уже совсем взрослый и такой надёжный."

#. ja: これからもきっと、あんたはいろんな経験を積んで、<br>たくさん失敗も、後悔もするだろうさ。
#. de: Du bist jung. Du hast noch viele Lektionen zu lernen und Erfahrungen zu machen. An einigen wirst du scheitern, an anderen gar verzweifeln.
#. fr: Avec le temps, tu vas continuer à accumuler de l'expérience. Tu connaîtras aussi bien des succès grisants que des échecs que tu regretteras amèrement.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003430_CAHCIUA:1"
msgid "Yet with so much more ahead. A world of experiences await you─each a lesson of its own."
msgstr "А впереди у тебя ещё целый мир — столько всего предстоит пережить, и каждый опыт чему-нибудь научит."

#. ja: それでも、前に進み続けてごらん。<br>いつかあんたが自分の路に迷ったとき、<br>その記憶が、<ruby>標<rt>しるべ</ruby>になってくれるから。
#. de: Doch Aufgeben kommt nicht in Frage, hörst du? Diese Erfahrungen sind es nämlich, welche dir in schweren Zeiten den Weg weisen und dich sicher ans Ziel kommen lassen.
#. fr: Mais quoi qu'il arrive, tu devras continuer ta marche en avant. Et lorsque tu te perdras en chemin, n'aie pas peur, car ces souvenirs seront là pour te guider.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003440_CAHCIUA:1"
msgid "You may know failure, and burning regret...but these too shall become beacons to guide you. So come what may, hold your head high and carry on with conviction."
msgstr "Ты будешь терпеть неудачи и горько о них жалеть... Но и они станут путеводными огнями. Что бы ни случилось, держи голову высоко и иди вперёд уверенно."

#. ja: だからほら、顔を上げて。<br>あたしの記憶も連れていってよ！
#. de: Nun komm schon<nbsp>- Kopf hoch, Junge! Wo immer dich deine Reise auch hinführen mag, bitte nimm mich mit! In deinen Erinnerungen!
#. fr: Alors relève la tête, et regarde-moi. Je veux que tu me promettes qu'où que tu ailles, tu me garderas dans ton cœur.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003450_CAHCIUA:1"
msgid "And wherever your journeys take you, keep me close to your heart, will you?"
msgstr "И куда бы ни занесло тебя в странствиях, храни меня в сердце, ладно?"

#. ja: この世界は、まだまだ未知で溢れているんだ！
#. de: Die Welt steckt voller Wunder. Und bis du sie alle entdeckt hast, will ich dich begleiten.
#. fr: Comme ça, on pourra découvrir le monde tous les deux<nbsp>!
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003460_CAHCIUA:1"
msgid "I should like to be there, to see what I haven't seen."
msgstr "Я бы хотела быть рядом и увидеть то, чего ещё не видела."

#. ja: ……ああ、約束する！
#. de: Versprochen, Mama!
#. fr: ... Je te le promets, Maman<nbsp>!
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003470_ERENVILLE:1"
msgid "You will be, Mother."
msgstr "Так и будет, мама."

#. ja: さあ、行っといで。<br>あんたはあたしの、自慢の息子さ！
#. de: Dann auf, Junge! Ich liebe dich!
#. fr: Va, mon fils. Et n'oublie jamais que tu es ma plus grande fierté.
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003471_CAHCIUA:1"
msgid "Now, run along. And never forget that you're my pride and joy."
msgstr "Ну, беги. И никогда не забывай: ты — моя гордость и радость."

#. ja: それじゃあみんな！<br>あとのことは、頼んだよ！
#. de: Macht's gut, meine Freunde! Der Rest liegt an euch, verstanden?
#. fr: Encore merci à vous tous. Vous savez ce qu'il vous reste à faire...
#. speaker: CAHCIUA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003480_CAHCIUA:1"
msgid "I trust you all can handle the rest. Take care─and farewell!"
msgstr "Остальное я доверяю вам. Берегите себя... Прощайте!"

#. ja: ……これで、全部だ。
#. de: Das war's dann wohl.
#. fr: ... Voilà, c'était le dernier.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003490_WUKLAMAT:1"
msgid "That makes all of them."
msgstr "Вот и всё."

#. ja: あとはメインターミナルが膨大な計算を終え、<br>異界への接続工程に入るのを待つだけ……。<br>無防備になる、その瞬間を突くんだ。
#. de: Dann bleibt uns jetzt nur noch zu warten, bis das Meso-System seine Berechnungen beendet hat und die Weltenfusion startet. Dann ist es gänzlich schutzlos.
#. fr: Maintenant, on a plus qu'à attendrrre que le mésoterminal finisse ses calculs. On frappera quand il baissera sa garde pour initialiser le processus de liaison des mondes.
#. speaker: GRAHATIA
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003500_GRAHATIA:1"
msgid "All that remains is to wait for the Meso Terminal to become vulnerable, when it's about to initiate fusion. And then we strike."
msgstr "Осталось дождаться, когда Терминал Мезо станет уязвимым, готовясь начать слияние. Тогда и нанесём удар."

#. ja: (-メインターミナル-)世界接続最終シーケンスに移行……。<br>繰り返します、世界接続最終シーケンスに移行……。
#. de: (-Meso-System-)Weltenfusion befindet sich in der letzten Phase. Wiederhole: Weltenfusion befindet sich in der letzten Phase.
#. fr: (-Mésoterminal-)Attention, début de la séquence de connexion entre les mondes. Je répète, début de la séquence de connexion entre les mondes.
#. speaker: MESOTERMINAL
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003510_MESOTERMINAL:1"
msgid "(-Meso Terminal-)Please be advised: we are entering the final phase of world bridging. Repeat: we are entering the final phase of world bridging."
msgstr "(-Мезотерминал-)Внимание: начинается заключительный этап объединения миров. Повторяю: начинается заключительный этап объединения миров."

#. ja: (-メインターミナル-)永久人のみなさん、ご安心ください。<br>生命力のエーテルは、間もなく供給されます。
#. de: (-Meso-System-)An alle Endlosen: Äthervorräte werden in Kürze aufgefüllt.
#. fr: (-Mésoterminal-)Éternels, veuillez patienter. La dis<shy>tri<shy>bu<shy>tion d'énergie vitale va bientôt commencer.
#. speaker: MESOTERMINAL
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003520_MESOTERMINAL:1"
msgid "(-Meso Terminal-)The aether of all residents will shortly be replenished. Be at ease─no action on your part is required."
msgstr "(-Мезотерминал-)Скоро эфир всех обитателей будет восполнен. Не беспокойтесь, от вас ничего не требуется."

#. ja: (-メインターミナル-)永久人のみなさん、ご安心ください……
#. de: (-Meso-System-)Vielen Dank für eure Geduld.
#. fr: (-Mésoterminal-)Éternels, veuillez patienter...
#. speaker: MESOTERMINAL
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003530_MESOTERMINAL:1"
msgid "(-Meso Terminal-)We thank you for your patience."
msgstr "(-Мезотерминал-)Благодарим за терпение."

#. ja: ついに、始まったぞ……！？
#. de: Das ging schneller als erhofft<nbsp>...
#. fr: Ça y est, c'est le moment<nbsp>?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003540_WUKLAMAT:1"
msgid "Wait─it's already begun!?"
msgstr "Постойте... Уже началось!?"

#. ja: スフェーン！！
#. de: Sphene!
#. fr: Sphene<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003550_WUKLAMAT:1"
msgid "Sphene!"
msgstr "Сфен!"

#. ja: おい、スフェーン聞こえねぇのか！？
#. de: Sphene! Hörst du mich etwa nicht?
#. fr: Hé, Sphene<nbsp>! Tu m'entends<nbsp>?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003560_WUKLAMAT:1"
msgid "Sphene! Listen to me! Please!"
msgstr "Сфен! Послушай меня, прошу!"

#. ja: 彼女、もう心が……。
#. de: Ich fürchte, sie ist nicht mehr<nbsp>...
#. fr: J'ai bien peur qu'elle ne soit plus là...
#. speaker: KRILE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003570_KRILE:1"
msgid "I'm afraid she's gone..."
msgstr "Боюсь, её уже нет..."

#. ja: (-メインターミナル-)まもなく同期が完了します……。
#. de: (-Meso-System-)Synchronisiere<nbsp>...
#. fr: (-Mésoterminal-)Synchronisation imminente...
#. speaker: MESOTERMINAL
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003571_MESOTERMINAL:1"
msgid "(-Meso Terminal-)Synchronization will soon be complete."
msgstr "(-Мезотерминал-)Синхронизация скоро завершится."

#. ja: (-エターナルクイーン-)同期完了……。<br>永久人「スフェーン」の構成要素はまっしょうされ、<br>メインターミナルが「<ruby>永久の女王<rt>エターナルクイーン</ruby>」をけいしょうしました。
#. de: (-Ewige Königin-)Synchronisierung abgeschlossen. Daten der Endlosen „Sphene“ wurden entfernt. Das Meso-System tritt die Nachfolge an. Die Ewige Königin ist einsatzbereit.
#. fr: (-???-)Synchronisation terminée. Les données de l'Éternelle “Sphene” ont été supprimées. Moi, Reine Éternité, ai pris le contrôle du mésoterminal.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003572_SPHENE:1"
msgid "(-???-)Synchronization complete. Data for the Endless “Sphene” has been overwritten and reconfigured. All shall be well, henceforth and in perpetuity."
msgstr "(-???-)Синхронизация завершена. Данные о Вечной Сфен перезаписаны и изменены. Отныне и навеки всё будет хорошо."

#. ja: (-エターナルクイーン-)国民のみなさんを、<ruby>いつまでも<rt>エバー</ruby><ruby>保護<rt>キープ</ruby>します。<br>そのための権限は、すべて開放されました！
#. de: (-Ewige Königin-)Bürgern wird fortan für IMMER FRIEDen garantiert sein. Zu diesem Zweck wurden alle Befugnisse der Ewigen Königin übertragen.
#. fr: (-Reine Éternité-)Habitants d'Alexandrie, j'ai désormais le pouvoir de vous protéger jusqu'à la fin des temps.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003573_SPHENE:1"
msgid "(-???-)Forever will I keep and cherish my people. To that end, I have removed the remaining checks upon my authority."
msgstr "(-???-)Я буду вечно оберегать свой народ. Для этого я сняла все ограничения со своих полномочий."

#. ja: なっ！？
#. de: Wha!
#. fr: Qu'est-ce que...<nbsp>!?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003590_WUKLAMAT:1"
msgid "What the─!?"
msgstr "Что за...!?"

#. ja: 計画の障害となる要素を、はいじょします。
#. de: Störelemente werden entfernt.
#. fr: (-Reine Éternité-)Tout obstacle à mon projet sera réduit à néant.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003591_SPHENE:1"
msgid "(-???-)Obstructions to the plan will be summarily removed."
msgstr "(-???-)Все, кто помешает плану, будут немедленно устранены."

#. ja: おい待て、アタシはまだ……ッ！
#. de: He! Ich bin noch nicht ...!
#. fr: Non, attends<nbsp>! Je dois encore te dire que...<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003592_WUKLAMAT:1"
msgid "Wait! I still haven't said─!"
msgstr "Постой! Я ещё не сказала...!"

#. ja: どうぞ、お引き取りください。
#. de: Entfernung eingeleitet<nbsp>...
#. fr: (-Reine Éternité-)Hors de ma vue, im<shy>mé<shy>dia<shy>te<shy>ment.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003593_SPHENE:1"
msgid "(-???-)Begone from my presence."
msgstr "(-???-)Убирайтесь с глаз моих."

#. ja: (-エターナルクイーン-)エリミネーターが収集した情報によれば、<br>あなたが、計画実行における最大の障害です。
#. de: (-Ewige Königin-)Kampfdaten des Eliminators wurden ausgewertet. Du stellst die größte Bedrohung für unser Vorhaben dar.
#. fr: (-Reine Éternité-)D'après les données recueillies par Annihilation, c'est toi qui représentes la plus grande menace pour mon projet.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003594_SPHENE:1"
msgid "(-???-)According to Eliminator's battle data, you pose the single greatest threat."
msgstr "(-???-)Согласно боевым данным Элиминатора, вы представляете наибольшую угрозу."

#. ja: (-エターナルクイーン-)よって、ここで確実に消去します……。
#. de: (-Ewige Königin-)Deine umgehende Auslöschung ist notwendig.
#. fr: (-Reine Éternité-)Je vais donc t'éliminer sur-le-champ.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003595_SPHENE:1"
msgid "(-???-)As such, you will be erased here and now."
msgstr "(-???-)Поэтому я сотру вас здесь и сейчас."

#. ja: 私は、旧アレクサンドリア王の記憶を受け継ぎし者。<br>愛する家族である民を護りたいという願いは、<br>どんな願いにも勝る！
#. de: Ich trage die Erinnerungen der Königin Sphene von Alexandria. Vor meinem strahlenden Willen, mein geliebtes Volk zu beschützen, soll alles andere verblassen!
#. fr: Je suis l'héritière et la dépositaire de la mémoire de l'ancien royaume d'Alexandrie<nbsp>! Ma volonté de défendre les miens est ma seule et unique loi<nbsp>!
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003596_SPHENE:1"
msgid "I am the bearer of the memories of Queen Sphene of Alexandria, and my desire to protect my people transcends all others!"
msgstr "Я храню воспоминания королевы Александрии Сфен, и моё желание защитить свой народ превыше всего!"

#. ja: それとも、力も命もあるキミたちなら、<br>犠牲を出さずに、護りたいものを護れるの……？
#. de: Ihr, die ihr voller Kraft und Leben steckt<nbsp>... Schützt ihr, was euch lieb und teuer ist, ohne anderswo Leid zu verursachen?
#. fr: Vous qui êtes si pleins de vie et d'énergie... ne seriez-vous pas prêts à tous les sacrifices pour protéger ceux qui vous sont chers<nbsp>?
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003597_SPHENE:1"
msgid "If it were you, could you have found another way? With your strength, could you have held fast to that which is dear without sacrifice?"
msgstr "А вы смогли бы найти другой путь? Хватило бы вам сил защитить то, что дорого, не принося жертв?"

#. ja: ふたりとも、あのね、実は私……！
#. de: Wisst ihr<nbsp>... In Wirklichkeit<nbsp>... Ich<nbsp>...
#. fr: Écoutez, je... je dois... Il faut que je vous fasse une confidence...<nbsp>!
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003598_SPHENE:1"
msgid "Listen to me. There's something that I need to tell you..."
msgstr "Послушайте. Я должна вам кое-что сказать..."

#. ja: ふふっ、キミも私を警戒してる？<br>それとも……心配してくれてるのかな？
#. de: Heh<nbsp>... misstraust du mir etwa auch? Oder<nbsp>... sorgst du dich um mich?
#. fr: Alors... Toi aussi, tu te méfies de moi<nbsp>? Ou bien... est-ce de la sollicitude<nbsp>?
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003599_SPHENE:1"
msgid "Is that concern? Or suspicion?"
msgstr "Ты обо мне беспокоишься? Или подозреваешь?"

#. ja: じゃあ、もしものときは……
#. de: Hmm, im Fall der Fälle<nbsp>...
#. fr: Dans ce cas, si jamais notre excursion tourne au vinaigre...
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003601_SPHENE:1"
msgid "If things should take a turn for the worse..."
msgstr "Если всё пойдёт не так..."

#. ja: キミが私を……
#. de: Wirst du ...
#. fr: Je... Je pourrai...
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003602_SPHENE:1"
msgid "Might...I..."
msgstr "Сможешь... я..."

#. ja: 何と言う？
#. de: Was antwortest du?
#. fr: Que répondez-vous<nbsp>?
#. speaker: Q6
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_Q6_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr "Что вы скажете?"

#. ja: やるべきことはわかっている
#. de: Ich weiß, was getan werden muss.
#. fr: Je sais ce que je dois faire.
#. speaker: A6
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A6_000_001_NONE_VOICE:1"
msgid "I know what I have to do."
msgstr "Я знаю, что должна сделать."

#. ja: 最後のシャットダウンだ
#. de: Dich endlich abschalten ... Ein für alle Mal!
#. fr: C'est l'heure de la dernière extinction.
#. speaker: A6
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A6_000_002_NONE_VOICE:1"
msgid "I'm shutting you down."
msgstr "Я тебя отключу."

#. ja: ……計画のしょうがいとなる要素を、排除します。
#. de: Störelemente werden<nbsp>... entfernt.
#. fr: Tout obstacle à mon projet sera réduit à néant.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003615_SPHENE:1"
msgid "(-???-)Obstructions to the plan will be summarily removed."
msgstr "(-???-)Все, кто помешает плану, будут немедленно устранены."

#. ja: せかいは  繋がりました！
#. de: Weltenfusion abgeschlossen!
#. fr: Le lien entre les mondes est formé<nbsp>!
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003620_SPHENE:1"
msgid "The worlds have been bridged!"
msgstr "Миры объединены!"

#. ja: 永久人のみなさんは  ご安心ください！<br>まもなく  命が  提供されます！
#. de: Vielen Dank für eure Geduld. Äther wird in Kürze bereitgestellt.
#. fr: Éternels, veuillez patienter. La dis<shy>tri<shy>bu<shy>tion d'énergie vitale va bientôt commencer.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003630_SPHENE:1"
msgid "Be at ease, everyone. Your aether will soon be replenished."
msgstr "Не беспокойтесь, жители. Скоро ваш эфир будет восполнен."

#. ja: 邪魔はさせません<br>消えてください
#. de: Störenfriede werden nicht geduldet.
#. fr: Rien ne m'arrêtera. Tu vas disparaître.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003640_SPHENE:1"
msgid "I will suffer no interference."
msgstr "Я не потерплю помех."

#. ja: さようなら
#. de: Lebt wohl.
#. fr: Adieu<nbsp>!
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003645_SPHENE:1"
msgid "Disappear. "
msgstr "Исчезни."

#. ja: スフェーン……！
#. de: Sphene!
#. fr: Sphene...<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003650_WUKLAMAT:1"
msgid "Sphene!"
msgstr "Сфен!"

#. ja: ……ラマチの声、届いたよ。
#. de: Deine Stimme<nbsp>... Sie hat mich erreicht, Lamaty'i!
#. fr: ... J'ai entendu ta voix, Lamaty'i.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003660_SPHENE:1"
msgid "Your voice reached me, Lamaty'i."
msgstr "Я услышала твой голос, Ламатъи."

#. ja: お前、記憶を……心を取り戻したのか？
#. de: Bist<nbsp>... Bist du es wirklich? Hast du deine Erinnerungen zurück?
#. fr: Sphene... Tu es redevenue toi-même...<nbsp>?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003670_WUKLAMAT:1"
msgid "Is it...is it really you?"
msgstr "Это... правда ты?"

#. ja: ……ううん。<br>生前の「スフェーン」の記憶はもう消えちゃったから、<br>これはきっと、「永久人の私」の記憶をかき集めたもの。
#. de: Nein, ich<nbsp>... Meine Erinnerungen an das alte Alexandria sind komplett gelöscht<nbsp>... Dies sind lediglich Überreste meiner Erinnerungen als Endlose.
#. fr: ... Pas exactement. Les souvenirs du temps où j'étais vivante ont disparu... Il s'agit sûrement de fragments de ma mémoire d'Éternelle.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003680_SPHENE:1"
msgid "No─only in part. My memories as a living person are gone. I've been remade from those I had as an Endless."
msgstr "Нет... не совсем. Воспоминания о моей жизни исчезли. Я была воссоздана из воспоминаний, оставшихся у меня как у Вечной."

#. ja: でも……この記憶の欠片すら、もう消える。<br>メインターミナルが間もなく停止しちゃうから……。
#. de: Doch ohne Kern wird sich das Meso-System schon bald abschalten. Und meine Erinnerungen und ich werden verschwinden.
#. fr: Mais cela signifie aussi que mon temps est compté...
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003690_SPHENE:1"
msgid "However...I cannot remain long, for the Meso Terminal will soon cease to function."
msgstr "Но... долго мне не продержаться. Скоро Терминал Мезо перестанет работать."

#. ja: だから最後に、キミたちに謝りに来たんだ。
#. de: Dies ist also meine letzte Gelegenheit, mich zu entschuldigen.
#. fr: Avant de m'éteindre définitivement, j'aimerais vous présenter mes excuses.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003700_SPHENE:1"
msgid "Once, you wanted to know me, Lamaty'i. Let my last act be to give an honest accounting."
msgstr "Ламатъи, ты хотела узнать меня. Позволь мне перед уходом рассказать тебе всё как есть."

#. ja: 私の願いに、巻き込んでごめんなさい……。
#. de: Es tut mir so unendlich leid. Wärt ihr nicht gewesen<nbsp>...
#. fr: Je suis désolée pour l'immense peine que mes ambitions ont causée...
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003710_SPHENE:1"
msgid "I am, above all, sorry. For the suffering I've caused your people, and mine."
msgstr "Прежде всего, прости меня. За страдания, которые я причинила твоему народу и своему."

#. ja: 結局、私には何も変えることができなくて、<br>ただ自分の理想のために、多くの人の命を奪ってしまった……。
#. de: Ich habe die Tode von so vielen Unschuldigen zu verantworten! Und wofür? Für meine fehlgeleiteten Ideale! Und nun stehe ich hier mit nichts als Reue.
#. fr: Finalement, cela n'aura servi à rien. Tout ce que j'ai réussi à accomplir, c'est ôter la vie à de nombreux innocents...
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003720_SPHENE:1"
msgid "I am, ultimately, powerless against the inevitable. Unable to do aught but visit harm upon the innocent."
msgstr "В конечном счёте я бессильна перед неизбежным. Мне оставалось лишь причинять боль невинным."

#. ja: こんな結末になるくらいなら……<br>私は造られるべきじゃなかったんだろうね。
#. de: Ich hätte niemals erschaffen werden sollen!
#. fr: Si c'était pour en arriver là, je n'aurais jamais dû continuer à vivre...
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003730_SPHENE:1"
msgid "I am, in the end, a pitiful, selfish creature. One that should never have been created."
msgstr "В конце концов я всего лишь жалкое, эгоистичное создание. Меня не следовало создавать."

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q7
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_Q7_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr "Что вы скажете?"

#. ja: それでも笑顔を護りたかったのでは？
#. de: Du wolltest dein Volk einfach nur zufrieden und glücklich wissen.
#. fr: Tu voulais protéger le sourire des tiens coûte que coûte.
#. speaker: A7
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A7_000_001_NONE_VOICE:1"
msgid "You strove to make your people happy."
msgstr "Ты хотела, чтобы твой народ был счастлив."

#. ja: 優しい記憶を抱えすぎたんだ
#. de: Die Erinnerungen an eine glückliche Ver<shy>gangen<shy>heit wurden dir zur Last.
#. fr: Tu t'es accrochée trop longtemps à tes souvenirs heureux.
#. speaker: A7
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A7_000_002_NONE_VOICE:1"
msgid "You carried too many gentle memories."
msgstr "Ты слишком сильно держалась за добрые воспоминания."

#. ja: お前は国を維持するシステムにすぎない
#. de: Du dientest lediglich dem Fortbestand Alexandrias. Nicht mehr und nicht weniger.
#. fr: Tu n'es qu'un système destiné à défendre ta nation.
#. speaker: A7
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A7_000_003_NONE_VOICE:1"
msgid "You're merely a system, created to sustain Alexandria."
msgstr "Ты всего лишь система, созданная для сохранения Александрии."

#. ja: 近いようで、気が遠くなるほど遠い、隣国の王同士……<br>一緒に未来を描けたらって思った。
#. de: Unsere Nationen könnten sich nicht näher sein<nbsp>... Und doch liegen Welten zwischen uns. Wären wir uns doch nur früher begegnet, dann hätten wir sicherlich einer gemeinsamen Zukunft entgegenschreiten können<nbsp>- Hand in Hand.
#. fr: Un univers sépare nos nations, et pourtant elles se ressemblent tellement... J'aurais tant aimé qu'on écrive notre futur ensemble.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003740_WUKLAMAT:1"
msgid "Our nations are worlds apart, but they feel so close. Who knows what we could have accomplished had we walked together, towards a shared future."
msgstr "Наши страны так далеки друг от друга, но кажутся такими близкими. Кто знает, чего бы мы добились, если бы шли вместе к общему будущему?"

#. ja: だけど……アタシらには互いに護るべきものがあったから、<br>同じ路を歩むことはできなかった……。
#. de: Aber das Schicksal wollte es anders. Für jeden von uns stand einfach zu viel auf dem Spiel.
#. fr: Mais le destin en a décidé autrement. On avait toutes les deux à cœur de protéger ce qui nous est cher...
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003750_WUKLAMAT:1"
msgid "And yet...it could never be so. We each had our own to protect."
msgstr "Но... этого не могло случиться. Каждой из нас было что защищать."

#. ja: そうだね。<br>もしも私が生きていたころに、<br>キミたちと出会っていたなら、結末は変わったのかな……。
#. de: Und diese Tatsache schmerzt mich sehr. Hach, wie anders die Dinge doch hätten sein können, wären wir uns nur während meiner Lebenszeit begegnet<nbsp>...
#. fr: Hélas... Si seulement nous nous étions rencontrées de mon vivant, notre histoire se serait peut-être conclue dif<shy>fé<shy>rem<shy>ment...
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003760_SPHENE:1"
msgid "If only I had met you when I was still alive, then perhaps..."
msgstr "Если бы мы встретились, пока я была жива... может быть, всё сложилось бы иначе."

#. ja: って、ダメだよね、起こらなかった奇跡に縋るのは。
#. de: Aber was nützt es schon, einem nie geschehenen Wunder nachzutrauern, nicht wahr?
#. fr: Mais inutile de se lamenter sur un miracle qui ne s'est jamais produit.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003770_SPHENE:1"
msgid "But it's no use dwelling upon a miracle that didn't happen."
msgstr "Но незачем тосковать по чуду, которого не случилось."

#. ja: でもね、これだけは信じてほしい。
#. de: Trotzdem, bitte glaubt mir eins.
#. fr: Cependant, je veux que vous sachiez ceci.
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003780_SPHENE:1"
msgid "Still, if there's one thing I hope you'll believe, it is this."
msgstr "И всё же я надеюсь, что в одном вы мне поверите."

#. ja: キミたちと過ごした時間は、短いけど本当に楽しかった……<br>この記憶が消えちゃうのが寂しいと思えるほどに。
#. de: So kurz sie auch war, meine Zeit mit euch erfüllte mich mit Freude und Hoffnung. So sehr, dass mich der Gedanke, diese Erinnerungen zu verlieren, unendlich traurig macht.
#. fr: Nous n'avons pas passé beaucoup de temps ensemble, mais j'en ai apprécié chaque seconde. J'aimerais tellement conserver ces souvenirs à tout jamais...
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003785_SPHENE:1"
msgid "Brief though it was, I treasured our time together. It pains me to think that its memory will disappear along with me."
msgstr "Пусть мы провели вместе совсем немного времени, я дорожила каждой минутой. Больно думать, что эти воспоминания исчезнут вместе со мной."

#. ja: あのさ、もし私が消えても……<br>アレクサンドリアのみんなのこと……
#. de: Bitte sagt mir<nbsp>... Werdet ihr euch um mein Volk<nbsp>... um Alexandria kümmern?
#. fr: Dites, quand je ne serai plus de ce monde... pourrez-vous veiller sur mon peuple<nbsp>?
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003790_SPHENE:1"
msgid "I know I have no right to ask this of you, but...when I'm gone...my people... Will you...?"
msgstr "Я знаю, что не вправе просить об этом, но... когда меня не станет... мой народ... Вы сможете...?"

#. ja: 心配すんな、アタシらがしっかりと護っていくからよ。<br>永久人たちのことだって、決して忘れたりしねぇ。
#. de: Aber selbst<shy>verständ<shy>lich! Als wäre es das Meine. Und die Endlosen will ich auch nicht vergessen!
#. fr: T'en fais pas, on prendra soin d'eux. Quant aux Éternels, ils resteront gravés dans nos mémoires...
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003800_WUKLAMAT:1"
msgid "We'll take care of them, don't worry. And we will never forget the Endless."
msgstr "Не волнуйся, мы о них позаботимся. И Вечных никогда не забудем."

#. ja: ……それから、お前と過ごした記憶もな。
#. de: Genau wie meine Erinnerung an dich!
#. fr: ... Tout comme les moments passés en ta compagnie.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003810_WUKLAMAT:1"
msgid "Neither them nor the time we spent with you."
msgstr "Как и времени, проведённого с тобой."

#. ja: だから、安心して眠ってくれ……スフェーン。
#. de: Mach dir also keine Sorgen. Du kannst leichten Herzens deinen Frieden schließen, Sphene.
#. fr: Tu peux avoir l'esprit tranquille... Repose en paix, Sphene.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003820_WUKLAMAT:1"
msgid "So be free of your burdens, Sphene. And sleep well."
msgstr "Так отпусти свои тревоги, Сфен. Спи спокойно."

#. ja: うん……ありがと……！
#. de: Danke! Danke vielmals!
#. fr: Merci... Lamaty'i...
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003830_SPHENE:1"
msgid "I will. Thank you."
msgstr "Так и сделаю. Спасибо."

#. ja: さようなら、私が愛したアレクサンドリア。
#. de: Leb wohl, mein geliebtes Alexandria!
#. fr: Adieu... mon Alexandrie bien-aimée...
#. speaker: SPHENE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003840_SPHENE:1"
msgid "Farewell, my beloved Alexandria."
msgstr "Прощай, моя любимая Александрия."

#. ja: ――こうしてメインターミナルは停止し<br>永久人の大半が  静寂の闇の中に溶けていった
#. de: So geschah es, dass das Meso-System abgeschaltet wurde und die Endlosen in der Stille der Dunkelheit verschwanden.
#. fr: Et c'est ainsi que le mésoterminal s'éteignit, emportant avec lui<br>d'innombrables Éternels dans les abîmes du silence.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003850_ERENVILLE:1"
msgid "So it was that the Meso Terminal fell dark, and the Endless departed for oblivion's embrace."
msgstr "Так Терминал Мезо погас, а Вечные канули в объятия забвения."

#. ja: 思い出をかたどっていた黄金の光は消え<br>仮初の楽園が  本来の姿を現した
#. de: Seinem gülden schimmernden Glanz der Erinnerung beraubt, zeigte das Paradies sein wahres Gesicht.
#. fr: La lueur dorée qui modelait les souvenirs disparut,<br>et le paradis éphémère retrouva son apparence originelle.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003860_ERENVILLE:1"
msgid "Their resplendent paradise was no more, as the memories sustaining it faded with the golden light."
msgstr "Золотое сияние, питавшее их воспоминаниями, угасло, и от прекрасного рая ничего не осталось."

#. ja: それでも  生きた証が喪われたわけではない
#. de: Doch das Zeugnis ihrer Leben glomm noch immer hell.
#. fr: Mais toute trace de l'existence de ce monde<br>ne s'était pas évanouie pour autant...
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003870_ERENVILLE:1"
msgid "Even so, in a way, they live on."
msgstr "И всё же, в каком-то смысле, они продолжают жить."

#. ja: 昇りゆく太陽から射した暁光を見て<br>確かにそう感じたんだ――
#. de: Beim Anblick der Morgendämmerung war es dieser Gedanke, der mir wie ein Sonnenstrahl die Seele wärmte.
#. fr: Tel fut mon sentiment lorsque le soleil levant de cette aurore nouvelle<br>m'étreignit de sa lumineuse chaleur.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003871_ERENVILLE:1"
msgid "This I felt with conviction as I basked in the glow of a new dawn."
msgstr "Я был уверен в этом, глядя на зарю нового дня."

#. ja: 「世界を繋ぐ力」が  鏡像世界に及ぼした影響は未知数だ
#. de: Die Weltenfusion ließ die Zukunft der Spiegelwelten ungewisser denn je erscheinen.
#. fr: Nous ignorions encore l'influence<br>du pouvoir de relier les mondes sur les autres reflets.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003880_ERENVILLE:1"
msgid "It remains to be seen how interdimensional fusion may have affected other reflections."
msgstr "Ещё неизвестно, как межпространственное слияние повлияло на другие отражения."

#. ja: 物に善悪はない――クルルの両親はそう語ったそうだが<br>スフェーンの行いは  それぞれにどう刻まれたのだろうか
#. de: Ein Ding für sich ist weder gut noch böse<nbsp>- Kriles Eltern sprachen klare Worte. Doch wie wird wohl jeder von uns Sphenes Taten in Erinnerung behalten?
#. fr: Si, comme l'avaient affirmé les parents de Krile,<br>la ligne séparant le bien du mal était ef<shy>fec<shy>ti<shy>ve<shy>ment ténue,<br>quelle leçon aurions-nous pu tirer des agissements de Sphene<nbsp>?
#. speaker: ERENVILLE
#. macro: <br> — a line break (may be added or dropped)
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003881_ERENVILLE:1"
msgid "Krile's parents spoke of the power's capacity for both good and evil.<br>I cannot help but wonder how Sphene's deeds will be remembered by those they touched."
msgstr "Родители Крилэ говорили, что эта сила способна творить и добро, и зло.<br>Не могу не гадать, как те, кого коснулись деяния Сфен, будут их помнить."

#. ja: くだんの「鍵」は  あの冒険者に託されたらしい
#. de: Der „Schlüssel“ ist jetzt zumindest in <if $gn4>ihrer<else>seiner</if> Obhut.
#. fr: La clef était désormais en possession de notre <if $gn4>amie aventurière<else>ami aventurier</if>.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003890_ERENVILLE:1"
msgid "The key that started it all was entrusted to the adventurer."
msgstr "Ключ, с которого всё началось, доверили тому самому искателю приключений."

#. ja: 世界の壁を超える秘宝だなんて  それこそ「暁」の領分だ<br>彼らが究明を試みることに  誰もが同意した
#. de: Ein Artefakt mit der Kraft, Dimensionen zu durchschreiten<nbsp>... Alle waren sich einig, dass es keine geeignetere Gruppe für die Erforschung gäbe als den Bund der Morgenröte.
#. fr: Une relique d'une telle nature appartenait sans nul doute<br>au domaine d'expertise des Héritiers de la Septième Aube,<br>et personne ne vit d'objection à ce qu'on leur confie son analyse en profondeur.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003901_ERENVILLE:1"
msgid "Such an artifact certainly lies within the Scions' realm of expertise, and no objection was raised to their retaining it for research."
msgstr "Такой артефакт, конечно же, относится к области знаний Потомков, и никто не возражал, чтобы они оставили его себе для исследований."

#. ja: 天深きセノーテは  理王コーナの指示のもと<br>厳重に警備することになったという
#. de: Auf Koanas Geheiß hin wurde der Himmelstiefe Cenote von nun an strengstens bewacht.
#. fr: Sur ordre de Koana, le cénote des Cieux infinis fut placé<br>sous la sur<shy>veil<shy>lan<shy>ce de la Légion de l'Aurore.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003910_ERENVILLE:1"
msgid "By order of Vow Koana, the Skydeep Cenote was placed under the strict watch of the Landsguard."
msgstr "По приказу Во Коаны Небесный сенот взяли под строгую охрану Стражи земли."

#. ja: あのバクージャジャを加えたトラル勇連隊なら<br>ゾラージャ亡きあとも  心配はいらないだろう
#. de: Und mit Bakool Ja Ja in ihren Reihen war die Landsgarde mehr als fähig, dieser Verantwortung gerecht zu werden.
#. fr: Bakool Ja Ja à la place de Zoraal Ja,<br>l'élite des combattants du pays n'avait rien perdu de sa superbe.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003911_ERENVILLE:1"
msgid "With the mighty Bakool Ja Ja among their number, they shall not want for strength even in Zoraal Ja's absence."
msgstr "С могучим Бакул Джаджа в рядах Стражи земли им не будет недоставать сил и после смерти Зораал Джа."

#. ja: スフェーン崩御の報せに<br>アレクサンドリアの人々は悲しみ  涙した
#. de: Trauer und Tränen. Etwas anderes blieb Alexandria nicht, als sie von ihrer geliebten Sphene hörten.
#. fr: Les Alexandrins versèrent des larmes de chagrin<br>en apprenant la disparition de leur reine adorée.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003920_ERENVILLE:1"
msgid "Upon learning of their queen's passing, the people of Alexandria mourned and wept."
msgstr "Узнав о смерти королевы, жители Александрии скорбели и плакали."

#. ja: 死の悲しみを取り除いてきた彼女のことだ<br>きっとこの光景は不本意だろう
#. de: Sie, die die Leute vom Kummer des Todes befreit hatte. Sie hätte es nicht gewollt, ihr Volk so zu sehen.
#. fr: Elle qui s'était donné tant de peine pour éviter aux siens la douleur du deuil<br>aurait cer<shy>tai<shy>ne<shy>ment souffert de cette vision...
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003930_ERENVILLE:1"
msgid "Having devoted herself to sparing them sorrow, the sight might well have moved Sphene to tears."
msgstr "Сфен посвятила себя тому, чтобы избавить их от печали. Увидев их горе, она и сама, верно, заплакала бы."

#. ja: だが――
#. de: Aber<nbsp>...
#. fr: Cependant...
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003940_ERENVILLE:1"
msgid "However..."
msgstr "Но..."

#. ja: スフェーンの遺志を受け継いだあいつなら<br>いずれ彼らの笑顔も取り戻すんだろう
#. de: Sie, die Sphenes Wünsche und Hoffnungen erbte, wird den Leuten ihr Lächeln eines Tages wiederbringen.
#. fr: Wuk Lamat avait donné sa parole, et je savais<br>que les anciens sujets de Sphene retrouveraient bientôt le sourire.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003950_ERENVILLE:1"
msgid "With Wuk Lamat carrying on her legacy, I have faith that her subjects will know joy once more."
msgstr "И всё же я верю: благодаря Вук Ламат, продолжившей её дело, подданные Сфен снова обретут радость."

#. ja: 王権が幼いグルージャに継承されたという発表は<br>予想どおり  多くの人の動揺を誘った
#. de: Dem kleinen Gulool Ja sollte die Verantwortung der Krone zu<shy>teil<shy>werden<nbsp>- diese Nachricht sorgte für einiges an Aufruhr.
#. fr: Comme on pouvait s'y attendre, l'annonce de l'avènement du très jeune Gulool Ja<br>ne laissa pas les Alexandrins indifférents.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003960_ERENVILLE:1"
msgid "As anticipated, the news that young Gulool Ja had succeeded his father as king was greeted with trepidation."
msgstr "Как и ожидалось, весть о том, что юный Гулул Джа унаследовал от отца корону, вызвала тревогу."

#. ja: その後見人として  ウクラマトが名乗りを上げた点も<br>反応は様々だったが――
#. de: Und auch als Wuk Lamat ihre Rolle als Vormund des unerfahrenen Königs verkündete, fielen die Reaktionen gemischt aus.
#. fr: De la même façon, les réactions furent pour le moins contrastées<br>lorsque Wuk Lamat se présenta comme tutrice du petit garçon.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003961_ERENVILLE:1"
msgid "Reception was also mixed when Wuk Lamat came forward to name herself as the boy's guardian."
msgstr "Неоднозначно встретили и то, что Вук Ламат объявила себя опекуном мальчика."

#. ja: エバーキープの基幹システムが無事で<br>当面の生活に支障がないとわかると  混乱も収束していった
#. de: Aber das Kernsystem des Immerfrieds würde erhalten bleiben, und damit auch ihr Alltag. Das beruhigte die Gemüter.
#. fr: Le peuple fut cependant rassuré d'apprendre que la Gardienne de l'Éternité<br>était intacte et que le quotidien resterait inchangé.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003962_ERENVILLE:1"
msgid "But the people were mollified to learn that Everkeep's systems remained operational, and there would be no impact on their lives."
msgstr "Но люди успокоились, узнав, что системы Вечной крепости работают и их жизнь не изменится."

#. ja: 父から受け継いだ王権をどう使うか<br>それは成長したグルージャ自身が  いつか決断することだろう
#. de: Wie und für was will er seine Macht einsetzen? Das sind Fragen, denen sich Gulool Ja eines Tages ganz alleine stellen muss.
#. fr: Quant à Gulool Ja, il avait amplement le temps de grandir avant de décider,<br>un jour, ce qu'il voudrait faire de l'héritage royal de son père.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003963_ERENVILLE:1"
msgid "One day, when he is older, Gulool Ja will decide for himself what manner of ruler he will be."
msgstr "Когда Гулул Джа подрастёт, он сам решит, каким правителем ему стать."

#. ja: 願わくは――<br>小さき王の歩む路が  家族の愛で照らされんことを
#. de: Möge der steinige Pfad des kleinen Königs von der wärmenden Liebe seiner Familie beleuchtet sein.
#. fr: D'ici là, le jeune monarque allait pouvoir découvrir un sentiment inédit,<br>l'amour inconditionnel de sa nouvelle famille...
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003964_ERENVILLE:1"
msgid "Till that day and beyond, may the path of the young king be illuminated by the love of family."
msgstr "Пусть же путь юного короля освещает любовь семьи — и впредь, и всегда."

#. ja: 一方  トライヨラの連中は――<br>新たな連王の勝利を心から喜んだ
#. de: Freude und Lachen. Dies war die Antwort Tuliyollals ob des ruhmreichen Sieges ihres Herrscherpaares.
#. fr: Pendant ce temps, au Tuliyollal, les habitants fêtaient dans l'allégresse<br>le triomphe de leur tandem de souverains.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003970_ERENVILLE:1"
msgid "Meanwhile, in Tuliyollal, the people came together to hail their new Dawnservants' great victory."
msgstr "А тем временем жители Тулийоллала праздновали великую победу новых Рассветных владык."

#. ja: 犠牲者たちの弔いも兼ねた祝祭だったはずが<br>結局  三日三晩のお祭り騒ぎになっていた
#. de: Und was als Feier zum Gedenken der vielen Opfer begann, artete in ein drei Tage und Nächte währendes Gelage aus.
#. fr: Après une période de recueillement en l'honneur de ceux tombés au combat,<br>les festivités se poursuivirent pendant trois jours et trois nuits.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003980_ERENVILLE:1"
msgid "Having honored those they lost, they turned their attention to a brighter future and celebrated for three days and nights."
msgstr "Почтив память погибших, они обратились к светлому будущему и праздновали три дня и три ночи."

#. ja: だが  すべてが片付いたわけじゃない
#. de: Aber wo Licht ist, da ist auch Schatten.
#. fr: Pourtant, tous les problèmes n'étaient pas résolus pour autant.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_003990_ERENVILLE:1"
msgid "Not everything had been resolved, though."
msgstr "Но не все проблемы были решены."

#. ja: ドームからの生還者たちは30年の隔たりに困惑していたし<br>彼らの国籍含めて  問題は山積みだ――
#. de: Für die Rückkehrer aus der Kuppel waren mehr als dreißig Jahre vergangen. Und ihre Staatsangehörigkeit war nur eines der vielen Probleme, denen wir uns stellen mussten.
#. fr: Par exemple, ceux qui venaient de passer trente longues années à l'intérieur du dôme<br>éprouvaient de grandes difficultés à s'adapter à leur nouvel environnement...
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004000_ERENVILLE:1"
msgid "Those who had spent thirty years in the dome struggled to resume their former lives. This and a host of other challenges remained."
msgstr "Те, кто провёл тридцать лет внутри купола, с трудом возвращались к прежней жизни. И это была лишь одна из множества оставшихся проблем."

#. ja: それでも新たな武王と理王は<br>力と知恵を合わせて  平和を築いていくだろう
#. de: Doch vereint werden unsere beiden Kronen mit Mut und Weisheit auch diese Hürde bewältigen<nbsp>- auf ihrem Pfad der Morgensonne.
#. fr: Mais grâce à l'équilibre entre force et raison incarné par ses deux jeunes Aurarques,<br>nul doute que le Tuliyollal entrait dans une ère de paix et de prospérité.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004010_ERENVILLE:1"
msgid "But as the new Dawnservants continue to lead with strength and wisdom, the people may be assured that peace will endure."
msgstr "Но пока новые Рассветные владыки правят с силой и мудростью, люди могут не сомневаться: мир сохранится."

#. ja: 礼が遅くなって、悪かったな！<br>復興の計画やらオヤジの国葬やらでバタバタしてたもんでよ。
#. de: Es tut mir so leid, dass wir uns noch gar nicht richtig bei dir bedanken konnten. Die Pläne für den Wieder<shy>aufbau, Vaters Staatsbegräbnis<nbsp>... Dauernd kam mir etwas dazwischen.
#. fr: Désolée d'être à la bourre<nbsp>! Entre la recon<shy>struc<shy>tion de la cité et les funérailles de mon père, j'ai pas eu une seule minute à moi.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004030_WUKLAMAT:1"
msgid "I'm sorry we haven't been able to talk properly. Between the reconstruction work and Papa's funeral, I've hardly had time to breathe."
msgstr "Прости, что мы так и не поговорили как следует. То восстановление города, то похороны папы — я едва успевала вздохнуть."

#. ja: だが……それもようやく一区切りついた。
#. de: Aber jetzt sind wir ja hier, nicht wahr?
#. fr: Je suis venue dès que j'ai pu, car je tenais à te remercier.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004040_WUKLAMAT:1"
msgid "But, at long last, there's a lull in my duties."
msgstr "Но наконец в делах наступило затишье."

#. ja: お前には、一生感謝してもしきれそうにねぇ。<br>本当に……ありがとな。
#. de: Das, was du für mich und mein geliebtes Tuliyollal getan hast, kann ich dir niemals vergelten. Ich danke dir wirklich von ganzem Herzen!
#. fr: Après tout ce que t'as fait pour moi et les miens, je sais pas si j'arriverai à te rendre la pareille un jour... En attendant, du fond du cœur, merci infiniment.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004050_WUKLAMAT:1"
msgid "You've done more for us than we could ever hope to repay. Thank you, from the bottom of my heart."
msgstr "Нам никогда не отплатить тебе за всё, что ты для нас сделал. Спасибо тебе от всего сердца."

#. ja: 継承の儀に参加して終わるはずが、<br>まさかこんな騒動に巻き込まれることになるとは。
#. de: Sag mal, wie machst du das nur immer? Du nimmst lediglich aus Langeweile am Ritus der Thronfolge teil, nur um dann plötzlich in einen interdimensionalen Konflikt zwischen zwei Nationen verwickelt zu werden?
#. fr: Quand on a pris la mer pour participer au rite de succession, on était loin de s'imaginer qu'on allait vivre des moments aussi riches en émotions...
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004060_ERENVILLE:1"
msgid "When we left Eorzea behind to take part in the contest, none of us could have predicted what complications would follow."
msgstr "Когда мы покинули Эорзею, чтобы участвовать в состязании, никто и представить не мог, сколько неприятностей нас ждёт."

#. ja: おたくも難儀な星のもとに生まれたもんだな。
#. de: Unter was für einem Stern des Unheils bist du bloß geboren?
#. fr: Décidément, tu as vraiment le chic pour t'embarquer dans des histoires rocambolesques<nbsp>!
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004070_ERENVILLE:1"
msgid "You truly have a knack for finding trouble, my friend."
msgstr "Ты и правда умеешь находить неприятности, дружище."

#. ja: ……そんなもんか。
#. de: Aber du scheinst deinem Schicksal ja nicht besonders abgeneigt zu sein, was?
#. fr: Et ça n'a pas l'air de te déranger.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004071_ERENVILLE:1"
msgid "And you wouldn't have it any other way."
msgstr "Да и по-другому ты бы не хотел."

#. ja: それで、お前はこれからどうするんだ？<br>グリーナーズ・ギルドシップは抜けたんだろ？
#. de: Und was hast du jetzt vor? Du bist doch aus der Klaubergilde ausgetreten, richtig?
#. fr: D'ailleurs, Erenville... C'est quoi tes projets, maintenant que t'as quitté le collège des glaneurs<nbsp>?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004080_WUKLAMAT:1"
msgid "So, what's next for you? Assuming you're still set on leaving the gleaner's life behind?"
msgstr "Ну и что теперь будешь делать? Похоже, ты всё-таки решил оставить жизнь собирателя?"

#. ja: ……ああ、おふくろの夢を受け継いだからな。
#. de: Ganz genau. Meine Mutter<nbsp>... Ich will mich vollends der Erfüllung ihrer Träume verschreiben.
#. fr: Réaliser le rêve de ma mère, bien sûr.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004090_ERENVILLE:1"
msgid "I'm off to fulfill my mother's dream, of course."
msgstr "Конечно, отправлюсь исполнить мамину мечту."

#. ja: まだ見ぬ生き物を求めて、未知を探す旅に出る。<br>せいぜい星海で待ってるおふくろを、驚かせてやるさ。
#. de: Eine Reise, um das Unentdeckte zu entdecken. Allein der Gedanke daran würde sie sicher vor Neid aus dem Sternengrund zurückkehren lassen.
#. fr: Comme elle le voulait, je vais partir pour un voyage à la découverte de l'inconnu. J'ai bien l'intention de la surprendre quand on se retrouvera dans la mer des étoiles<nbsp>!
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004100_ERENVILLE:1"
msgid "Like she had intended, I'll embark on a journey in search of the unknown. She's sure to enjoy my stories when we meet again in the aetherial sea."
msgstr "Как она и хотела, отправлюсь на поиски неизведанного. Уверен, когда мы встретимся в эфирном море, ей будет интересно послушать мои истории."

#. ja: へえ……いいじゃねえか！<br>食い扶持の当てはあるのか？
#. de: Das klingt doch gut! Weißt du denn schon, wie du die Reisekosten abdecken wirst?
#. fr: Eh ben, ça promet<nbsp>! Et comment tu vas remplir ton assiette<nbsp>?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004110_WUKLAMAT:1"
msgid "Well, well, sounds like a plan! But will you have the coin to get by?"
msgstr "Вот это план! Только хватит ли тебе денег на дорогу?"

#. ja: グリーナーを辞めても、<br>シャーレアンとの繋がりがなくなるわけじゃないからな。<br>新種や希少種の情報なら売りつけられるはずだ。
#. de: Ich bin zwar kein Klauber mehr, aber meine Verbindungen zu Sharlayan sind immer noch intakt. Und im Austausch für Informationen über neue und seltene Arten ist sich der Rat der Philosophen schließlich nie zu schade, ein paar Gil abzutreten.
#. fr: Ma carrière de glaneur est peut-être derrière moi, mais j'ai toujours des contacts à Sharlayan. On me payera grassement pour des in<shy>for<shy>ma<shy>tions sur des espèces rares ou inédites.
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004120_ERENVILLE:1"
msgid "I may no longer be a gleaner, but I still have contacts in Sharlayan. Contacts with deep pockets always eager to pay for information on new or rare species."
msgstr "Я больше не собиратель, но связи в Шарлаяне у меня остались. А там полно тех, кто не пожалеет денег за сведения о новых и редких видах."

#. ja: へっ、たくましい奴だぜ。
#. de: Haha, dann war ja meine Sorge vollkommen unbegründet.
#. fr: Ha<nbsp>! Je vois que t'as tout prévu.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004130_WUKLAMAT:1"
msgid "Heh, you've got it all worked out."
msgstr "Ха, у тебя всё продумано."

#. ja: お前は……次の冒険について考え中か？
#. de: Und du? Noch am Überlegen?
#. fr: Et toi, alors<nbsp>? Tu réfléchis déjà à ta prochaine aventure<nbsp>?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004140_WUKLAMAT:1"
msgid "And what of you? Any new adventures in the offing?"
msgstr "А ты? Не присмотрел уже себе новое приключение?"

#. ja: まあ、行き先が決まるまでトライヨラでゆっくりしていってくれ。<br>もちろん、代わりに要職へ就けなんて言う気はねえよ。
#. de: Na, es besteht ja kein Grund zur Eile. Genieß deine Zeit in Tuliyollal und lass ein wenig die Seele baumeln! Ich werd dir auch keinen Posten im Palast aufzwingen, versprochen!
#. fr: En attendant de te décider, hésite pas à prendre tes aises chez nous. Promis, je te demanderai pas de gouverner avec moi<nbsp>!
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004150_WUKLAMAT:1"
msgid "Regardless, until you're ready to leave, you're our guest here in Tuliyollal. And this time, I won't pester you to take up a post."
msgstr "А пока не решишь, куда податься, побудь у нас в Тулийоллале — ты здесь желанный гость. И на этот раз я не стану приставать с предложением занять какой-нибудь пост."

#. ja: お前は冒険が好きでたまらなくて、<br>困ってる誰かがいたら放っておけない奴なんだ……って。<br>ここまでの旅で、よくわかったからな。
#. de: Wenn mir auf unserer Reise eins klar geworden ist, dann, wie sehr du das Abenteuer liebst<nbsp>... Und dass du es einfach nicht lassen kannst, allem und jedem deine Hilfe anzubieten<nbsp>...
#. fr: À force de te côtoyer, j'ai bien compris que t'étais pas du genre à rester en place. Ni à ignorer un appel à l'aide, d'ailleurs.
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004160_WUKLAMAT:1"
msgid "By now, I know you well enough to know you can't stay in one place. No more than you can ignore the plight of those in need."
msgstr "За время нашего путешествия я успела понять, как сильно ты любишь приключения. И что не можешь пройти мимо тех, кому нужна помощь."

#. ja: だからこれからも、<br>お前はお前の路を、歩き続けるんだろ？
#. de: Darum bin ich mir absolut sicher: Deine Reise ist noch lange nicht vorbei. Solange du nur gewillt bist, ihn zu gehen, wird dein Pfad dich weiterführen.
#. fr: Le Tural n'est qu'une étape sur ta route, hein<nbsp>? Tu vas bientôt t'en aller vers de nouveaux horizons<nbsp>?
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004170_WUKLAMAT:1"
msgid "Your path will always lead you elsewhere, and you'll continue walking it. Isn't that so?"
msgstr "Твой путь всегда ведёт куда-то дальше, и ты продолжишь идти по нему. Разве не так?"

#. ja: 根っからの冒険者なんだな。<br>何がそんな風に、おたくを突き動かすんだ？
#. de: Durch und durch <if $gn4>die Frau Abenteurerin<else>der Herr Abenteurer</if>, wie? Was ist es nur, das dich antreibt?
#. fr: <if $gn4>Aventurière<else>Aventurier</if> un jour, <if $gn4>aventurière<else>aventurier</if> toujours... Mais qu'est-ce qui te motive à aller sans cesse de l'avant, au juste<nbsp>?
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004180_ERENVILLE:1"
msgid "An adventurer to the marrow, you are. What is it exactly that spurs you on?"
msgstr "Ты прирождённый искатель приключений. Что же тебя так подстёгивает?"

#. ja: 何と言う？
#. de: Was antwortest du?
#. fr: Que répondez-vous<nbsp>?
#. speaker: Q8
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_Q8_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr "Что ответите?"

#. ja: この世界が好きだから
#. de: Diese Welt. Ich liebe sie und alles in ihr.
#. fr: Mon amour pour ce monde.
#. speaker: A8
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A8_000_001_NONE_VOICE:1"
msgid "My love for the star."
msgstr "Я люблю этот мир."

#. ja: まだ見ておくべき場所が残っているから
#. de: Das Unbekannte. Ich habe noch so viele Orte zu entdecken.
#. fr: Toutes les surprises qui m'attendent.
#. speaker: A8
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A8_000_002_NONE_VOICE:1"
msgid "All the sights I've yet to see."
msgstr "Я хочу увидеть всё, что ещё не видел."

#. ja: たくさんのものを受け継いだから
#. de: All das, was mir mit auf den Weg gegeben wurde.
#. fr: Les espoirs qu'on m'a confiés.
#. speaker: A8
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_A8_000_003_NONE_VOICE:1"
msgid "The legacies I bear."
msgstr "Я несу с собой наследие других."

#. ja: フフッ
#. de: Haha!
#. fr: [Très léger rire amusé]
#. speaker: ERENVILLE
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004181_ERENVILLE:1"
msgid "[AMUSED CHUCKLE “Hehe”]"
msgstr "[Довольно смеётся]"

#. ja: フフッ
#. de: Haha!
#. fr: [Très léger rire amusé]
#. speaker: WUKLAMAT
msgctxt "cut_scene/070/VoiceMan_07005:TEXT_VOICEMAN_07005_004182_WUKLAMAT:1"
msgid "[AMUSED CHUCKLE “Hehe”]"
msgstr "[Довольно смеётся]"
