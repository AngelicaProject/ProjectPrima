# cut_scene/060/VoiceMan_06005 · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: しばらく前  マグナ・グラキエス――
#. de: Kurz zuvor in Magna Glacies<nbsp>...
#. fr: Un peu plus tôt, dans le Magna Glacies
#. speaker: SYSTEM_NONE_VOICE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000010_SYSTEM_NONE_VOICE:1"
msgid "Earlier, on the Magna Glacies..."
msgstr ""

#. ja: ひぃぃ
#. de: Uaaah!
#. speaker: REFUGEEMAN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000020_REFUGEEMAN:1"
msgid "No..."
msgstr ""

#. ja: い、嫌だ……助かるために逃げてきたんだぞ……！？<br>こんな、こんなことがあってたまるか……！
#. de: Nein<nbsp>... Ich will hier nicht sterben! Hier sollte es doch sicher sein!
#. fr: Qu'est-ce que j'ai fait pour mériter ça<nbsp>!? On était venus là pour être sauvés<nbsp>! C'est pas juste<nbsp>!
#. speaker: REFUGEEMAN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000030_REFUGEEMAN:1"
msgid "No, no... We were promised an escape... Not the same doom we fled..."
msgstr ""

#. ja: イイィィ！
#. de: Uaaaargh!
#. speaker: REFUGEEMAN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000040_REFUGEEMAN:1"
msgid "Report if displayed."
msgstr ""

#. ja: くっ、よもやここで終末に見舞われようとは……！
#. de: Tch, der Planet scheint sich gegen uns verschworen zu haben.
#. fr: Rah, l'apocalypse a bien choisi son moment<nbsp>!
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000050_FOURCHENAULT:1"
msgid "I shall not meet my final days here in this blasted waste."
msgstr ""

#. ja: 皆、落ち着くのだ！<br>すぐに防御の陣を張る！
#. de: Bewahrt Ruhe! Hilfe ist auf dem Weg!
#. fr: Ne cédez pas à la panique<nbsp>! En position de défense<nbsp>!
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000060_FOURCHENAULT:1"
msgid "Calm yourselves! Your panic is our greatest enemy."
msgstr ""

#. ja: 無暗に逃げ回らず、こちらへ……！
#. de: Hierher! Rennt nicht blind ins Eis!
#. fr: Arrêtez de courir dans tous les sens et suivez-moi<nbsp>!
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000070_FOURCHENAULT:1"
msgid "Come, we must build a line of defense."
msgstr ""

#. ja: お前たち……！？
#. de: Ihr<nbsp>...?!
#. fr: Vous, ici...<nbsp>!?
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000080_FOURCHENAULT:1"
msgid "How...?"
msgstr ""

#. ja: 「暁の血盟」が援護します！<br>お父様は、誘導を優先してください！
#. de: Der Bund hält euch den Rücken frei! Führe die Leute in Sicherheit, Vater!
#. fr: Père, les Héritiers sont avec vous<nbsp>! Continuez à guider les gens en lieu sûr<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000090_ALPHINAUD:1"
msgid "Leave the fighting to us, Father. You must lead the people to safety!"
msgstr ""

#. ja: ハァッ
#. de: Ha!
#. speaker: ESTINIEN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000100_ESTINIEN:1"
msgid "Report if displayed."
msgstr ""

#. ja: チッ
#. de: Tch<nbsp>...
#. speaker: ESTINIEN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000110_ESTINIEN:1"
msgid "Tsk."
msgstr ""

#. ja: あのデカブツは俺が抑える。<br>お前は……
#. de: Ich halt die Großen auf. Kümmere du ...
#. fr: Je m'occupe de ces gros tas. Ça ira, toi<nbsp>?
#. speaker: ESTINIEN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000120_ESTINIEN:1"
msgid "I can handle this pair. You..."
msgstr ""

#. ja: 難民たちの治癒と保護だろう。<br>さあ、行こう！
#. de: Ich heile Verletzte und beschütze die Fliehenden. Los!
#. fr: Aucun problème<nbsp>! Je me charge de soigner les réfugiés<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000130_ALPHINAUD:1"
msgid "Shall tend to the refugees. Let us be about it!"
msgstr ""

#. ja: フ
#. de: Heh
#. speaker: ESTINIEN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000135_ESTINIEN:1"
msgid " Hmph."
msgstr ""

#. ja: 任せたぞ……アルフィノ！
#. de: Ich verlass mich auf dich, Alphinaud!
#. fr: Alphinaud, je compte sur toi<nbsp>!
#. speaker: ESTINIEN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000140_ESTINIEN:1"
msgid "As you wish, my little lord!"
msgstr ""

#. ja: 誰か、誰か助けて……ッ！
#. de: Hilfe! Zu Hiiilfe!
#. fr: Au secours, aidez-nous<nbsp>!
#. speaker: PALAKASWOMANB
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000150_PALAKASWOMANB:1"
msgid "Help! Someone, please!"
msgstr ""

#. ja: っ！？
#. de: Hm?!
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000160_ALPHINAUD:1"
msgid "What...?"
msgstr ""

#. ja: あぐっ
#. de: Argh!!
#. speaker: PALAKASWOMANB
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000170_PALAKASWOMANB:1"
msgid " "
msgstr ""

#. ja: ああ…！
#. de: Aaah<nbsp>...
#. speaker: PALAKASWOMANB
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000180_PALAKASWOMANB:1"
msgid "Report if displayed."
msgstr ""

#. ja: あたし……あたしは、まだ……ッ！
#. de: Ich<nbsp>... Ich will noch nicht<nbsp>...!
#. fr: Pitié, je veux pas mourir...<nbsp>!
#. speaker: PALAKASWOMANB
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000190_PALAKASWOMANB:1"
msgid "No, no, n-no, don't! I don't want to die..."
msgstr ""

#. ja: (-？？？？-)総員突撃！<br>化け物どもを掃討せよッ！
#. de: (-???-)Zum Angriff! Lasst keine Bestie übrig!
#. fr: (-???-)Tous à l'attaque<nbsp>! Ne laissez aucun de ces monstres en vie<nbsp>!
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000200_JULLUS:1"
msgid "(-???-)Forward! Let not a single fiend escape!"
msgstr ""

#. ja: あれは……！
#. de: Das sind doch<nbsp>...!
#. fr: Ça alors...<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000210_ALPHINAUD:1"
msgid "Wait, that's..."
msgstr ""

#. ja: ユルス！　それに帝国軍の……！<br>皆、治療を終えたのか！
#. de: Jullus! Und die kaiserlichen Truppen! Ihr seid wohlauf!
#. fr: Jullus et ses compagnons d'armes<nbsp>! Ils sont donc com<shy>plè<shy>te<shy>ment rétablis<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000220_ALPHINAUD:1"
msgid "Jullus and the army! So, you've recovered, then!"
msgstr ""

#. ja: 今度は、出遅れずに済んだみたいだな……。
#. de: Diesmal bin ich nicht zu spät.
#. fr: Je m'en serais voulu d'arriver trop tard une fois de plus.
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000230_JULLUS:1"
msgid "In time enough to be of aid, for once."
msgstr ""

#. ja: 細かいことはあとだ！<br>今はただ、救われた同胞を想って戦え！
#. de: Reden können wir nachher! Lasst uns jetzt gemeinsam in die Schlacht ziehen!
#. fr: Battons-nous, camarades<nbsp>! Pour tous nos compatriotes qui ont la chance d'avoir la vie sauve<nbsp>!
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000240_JULLUS:1"
msgid "We can speak of it more later. For now, we must fight!"
msgstr ""

#. ja: 同じだけ、それ以上に、俺たちも助け出すんだ……
#. de: Gemeinsam mit denen, die uns in der Not halfen.
#. fr: Cette fois, c'est à nous de secourir nos alliés<nbsp>!
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000250_JULLUS:1"
msgid "To repay your salvation in kind─or with better."
msgstr ""

#. ja: 誇り高き、ガレアンとしてッ！
#. de: Kämpft! Mit dem Stolz Garlemalds!
#. fr: Pour Garlemald, avec force et honneur<nbsp>!
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000260_JULLUS:1"
msgid "For Garlemald has her pride!"
msgstr ""

#. ja: 私たちも加勢しよう！
#. de: Los, unterstützen wir sie!
#. fr: Allons leur donner un coup de main<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000270_ALPHINAUD:1"
msgid "Of that, I've no doubt!"
msgstr ""

#. ja: 馬鹿な……どうして、敵対していた帝国軍が……。
#. de: Ausgerechnet die kaiserliche Armee<nbsp>...?!
#. fr: Mais qu'est-ce qui se passe<nbsp>? Les Impériaux sont nos ennemis, pourtant<nbsp>!
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000280_FOURCHENAULT:1"
msgid "Good gods... Of all possible saviors, the imperial army?"
msgstr ""

#. ja: あれは……！
#. de: Oh<nbsp>...!
#. fr: Hein...<nbsp>!?
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000290_FOURCHENAULT:1"
msgid "Oh!"
msgstr ""

#. ja: さすがに、一度に全部は無理か……！
#. de: Verdammt, ich hab nicht alle erwischt<nbsp>...!
#. fr: Mince, j'ai pas réussi à tous les avoir d'un coup<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000300_ALISAIE:1"
msgid "I had hoped to take all of them down at once!"
msgstr ""

#. ja: どうするアリゼー、一旦下がるか？
#. de: Sollen wir uns kurz zurückziehen?
#. fr: Et maintenant, Alisaie<nbsp>? On se rrreplie<nbsp>?
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000310_GRAHATIA:1"
msgid "Think a withdrawal might be in order?"
msgstr ""

#. ja: 冗談！<br>私たちは、あの人が帰るまで、こっちの世界を任された。
#. de: Auf keinen Fall! Wir haben versprochen, diese Welt zu beschützen!
#. fr: Hors de question<nbsp>! En attendant <i>son</i> retour, c'est à nous de protéger ce monde<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000320_ALISAIE:1"
msgid "Sod that! You-know-who would never abandon these people to their fate."
msgstr ""

#. ja: 獣になってしまった人に、<br>仲間を傷つける悲しみまで背負わせない……<br>一秒でも早く、食い止めてみせる！
#. de: Ich lasse nicht zu, dass die Bestien nun ihre ehemaligen Liebsten verschlingen! Dieser Schmerz muss nicht auch noch sein<nbsp>...
#. fr: Déjà que ces pauvres gens ont été transformés en monstres, on ne peut pas en plus les laisser faire du mal à leurs proches... Il faut les arrêter<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000330_ALISAIE:1"
msgid "To be devoured by their former friends─that'd be beyond cruel. These beasts must fall here and now!"
msgstr ""

#. ja: 上等だ……！<br>だったらお互い、「無茶するな」は封印だな！
#. de: Recht so. Komm, entfachen wir ein Feuerwerk!
#. fr: Tu as rrraison<nbsp>! À partir de maintenant, on donne tout ce qu'on a et advienne que pourra<nbsp>!
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000340_GRAHATIA:1"
msgid "Well then, I'd say it's high time we threw caution to the winds!"
msgstr ""

#. ja: いいけど、エーテルを切らしたりしないでよね。
#. de: Solange du nicht wieder deinen kompletten Äther aufbrauchst<nbsp>...
#. fr: D'accord, mais fais quand même gaffe à pas tomber à court d'éther, hein<nbsp>?
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000350_ALISAIE:1"
msgid "So long as you spare me the heroic sacrifices."
msgstr ""

#. ja: さあ……行くわよッ！
#. de: Na, dann los!
#. fr: Sur ce, à l'attaque<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000360_ALISAIE:1"
msgid "Now, let's go!"
msgstr ""

#. ja: エーテルが感じられない……<br>やっぱり、どうやっても戻せないのか……。
#. de: Ich spüre kein bisschen Äther mehr<nbsp>... Es gibt also wahrlich kein Zurück<nbsp>...
#. fr: C'est bien ce qu'on pensait, plus une seule goutte d'éther dans ces créatures... Elles sont perrrdues à jamais.
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000370_GRAHATIA:1"
msgid "Not the barest trace of aether... Maybe there really is no way to bring them back."
msgstr ""

#. ja: あ、あの、助けてくださって、ありがとうございました！
#. de: E-Entschuldigt<nbsp>... Wir wollten euch dafür danken, dass ihr uns gerettet habt!
#. fr: Merci, vous nous avez sauvé la vie<nbsp>!
#. speaker: PALAKASMAN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000380_PALAKASMAN:1"
msgid "Thank you for saving our lives once again!"
msgstr ""

#. ja: あなたは確か、前にも……<br>プルシャ寺院で俺たちを助けてくださった方ですよね……？
#. de: Ihr wart es doch auch, die uns bei Purusa geholfen habt, oder nicht?
#. fr: C'est bien vous qui nous avez secourus au temple du Purusa, n'est-ce pas<nbsp>?
#. speaker: PALAKASMAN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000390_PALAKASMAN:1"
msgid "I remember you, from Purusa. You helped us there, too, didn't you?"
msgstr ""

#. ja: そっか、あなたパーラカの里の人だったのね。<br>どうにか無事でよかったわ。
#. de: Richtig, du bist aus Palakas Ruh! Schön, dass du unversehrt bist.
#. fr: Mais oui, tu es de l'Écoute des Palaka<nbsp>! Contente de voir que tu vas bien<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000400_ALISAIE:1"
msgid "Ah, you're from Palaka's Stand! I'm glad you're still in one piece."
msgstr ""

#. ja: もしかして怪我してるの？<br>待って、すぐに治療するから。
#. de: Aber dich hat es ziemlich erwischt, oder? Lass mich dich heilen.
#. fr: Tu es blessée<nbsp>? Ne bouge pas, je vais te soigner.
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000410_ALISAIE:1"
msgid "...Or you will be, once I see to that injury of yours."
msgstr ""

#. ja: みんな逃げろ！
#. de: Schnell, lauft!
#. fr: Attention<nbsp>!
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000420_GRAHATIA:1"
msgid "Look out!"
msgstr ""

#. ja: ぐあっ
#. de: Gah!
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000430_ALISAIE:1"
msgid "Report if displayed."
msgstr ""

#. ja: っ…
#. de: Ah<nbsp>...
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000440_ALISAIE:1"
msgid "Report if displayed."
msgstr ""

#. ja: くっ
#. de: Ts<nbsp>...
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000450_GRAHATIA:1"
msgid "Report if displayed."
msgstr ""

#. ja: ここから離れてろ……行け！
#. de: Weg von hier! Schnell!
#. fr: Parrrtez d'ici, vite<nbsp>!
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000460_GRAHATIA:1"
msgid "Get out of here, quickly!"
msgstr ""

#. ja: 失くさせない……ひとつでも……。<br>ここは、多くの希望を託された未来だ……！
#. de: Nicht ein Leben<nbsp>... sollst du nehmen<nbsp>...! Unsere Zukunft<nbsp>... All unsere Hoffnung!
#. fr: Ugh... Je ne te laisserai pas faire... Il y a trrrop de gens qui comptent sur nous...
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000470_GRAHATIA:1"
msgid "I won't lose them...not a one. This will be a brighter future."
msgstr ""

#. ja: 終末だろうが何だろうが、踏みにじらせて、たまるかッ！
#. de: Letzte Tage hin oder her<nbsp>... sie bekommt ihr nicht!
#. fr: Apocalypse ou pas, je ne te laisserai pas rrruiner leurs espoirs<nbsp>!
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000480_GRAHATIA:1"
msgid "I won't let a madman's apocalypse ruin everything we fought to achieve!"
msgstr ""

#. ja: まったくだわ……。<br>お父様もいるのに、膝をついてちゃ、<br>「見てて」って言ったのが台無しじゃない……。
#. de: Also ehrlich. Mich vor den Augen meines Vaters in die Knie zu zwingen, wie sieht das denn aus?
#. fr: Argh... Mince alors... C'est pas avec un genou à terre... que papa me verra voler de mes propres ailes...
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000490_ALISAIE:1"
msgid "Get it together, Alisaie! You're embarrassing yourself...and in front of Father, no less."
msgstr ""

#. ja: あの背中にだって、追いつけやしない……。
#. de: Nicht, dass ich jemals an <if $gn4>ihre<else>seine</if> Größe heranreichen würde<nbsp>...
#. fr: Ni que j'arriverai un jour à <i>sa</i> hauteur...
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000500_ALISAIE:1"
msgid "You might never measure up to our champion..."
msgstr ""

#. ja: エオルゼアの剣に……私の剣になってくれた人に、<br>いつまでも独りで切り込ませていられないのよ……ッ！
#. de: Aber es ist höchste Zeit, <if $gn4>ihr<else>ihm</if> nicht fortan alle Last aufzubürden. <if $gn4>Ihr<else>Ihm</if>, <if $gn4>die<else>der</if> zu Eorzeas Klinge<nbsp>... und auch zu meiner Klinge geworden ist.
#. fr: <if $gn4>Elle<else>Lui</if> qui est <if $gn4>devenue<else>devenu</if> la lame d'Éorzéa... Et même <i>ma</i> lame... Je ne peux pas <if $gn4>la<else>le</if> laisser lutter <if $gn4>seule<else>seul</if> éter<shy>nel<shy>le<shy>ment<nbsp>!
#. speaker: ALISAIE
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000510_ALISAIE:1"
msgid "But we ask too much of <if $gn4>her<else>him</if> as it is. You mustn't let our sword in the darkness fight alone!"
msgstr ""

#. ja: エオルゼアの剣になってくれた人に、<br>いつまでも独りで切り込ませていられないのよ……ッ！
#. de: Aber es ist höchste Zeit, <if $gn4>ihr<else>ihm</if> nicht fortan alle Last aufzubürden. <if $gn4>Ihr<else>Ihm</if>, <if $gn4>die<else>der</if> zu Eorzeas Klinge geworden ist.
#. fr: <if $gn4>Elle<else>Lui</if> qui est <if $gn4>devenue<else>devenu</if> la lame d'Éorzéa... Je ne peux pas <if $gn4>la<else>le</if> laisser lutter <if $gn4>seule<else>seul</if> éter<shy>nel<shy>le<shy>ment<nbsp>!
#. speaker: ALISAIE
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000520_ALISAIE:1"
msgid "But we ask too much of <if $gn4>her<else>him</if> as it is. You mustn't let Eorzea's hero fight alone!"
msgstr ""

#. ja: あ…
#. de: Ah?
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000530_ALISAIE:1"
msgid "Oh..."
msgstr ""

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q1
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_Q1_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr ""

#. ja: お待たせ！
#. de: Bin ich spät dran?
#. fr: <if $gn4>Désolée<else>Désolé</if> de t'avoir fait attendre<nbsp>!
#. speaker: A1
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A1_000_001_NONE_VOICE:1"
msgid "I'm back!"
msgstr ""

#. ja: よくがんばった
#. de: Tapfer gekämpft, Alisaie.
#. fr: Tu t'es bien battue, Alisaie.
#. speaker: A1
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A1_000_002_NONE_VOICE:1"
msgid "You've done well in my absence."
msgstr ""

#. ja: 修行が足りていないのでは？
#. de: Sieht aus, als bräuchtest du noch etwas mehr Übung.
#. fr: Ça manque encore d'en<shy>traî<shy>ne<shy>ment...
#. speaker: A1
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A1_000_003_NONE_VOICE:1"
msgid "This is precisely why you should never skip your squat regimen."
msgstr ""

#. ja: っ…
#. de: Hrmpf<nbsp>...
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000540_ALISAIE:1"
msgid " Hmph."
msgstr ""

#. ja: ……私ひとりでも、やれたんだけどね。
#. de: Ich wär auch allein zurechtgekommen<nbsp>...
#. fr: ... J'avais la situation bien en main.
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000550_ALISAIE:1"
msgid "I can look after myself, you know."
msgstr ""

#. ja: おかえり、準備は万全か？
#. de: Willkommen zurück, <if $gn4>meine Freundin<else>mein Freund</if>. Bist du gewappnet?
#. fr: Ah, te rrrevoilà. <if $gn4>Prête<else>Prêt</if> à passer à l'action<nbsp>?
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000560_GRAHATIA:1"
msgid "Everything's in order, I trust?"
msgstr ""

#. ja: さっさと片づけて、次へ行くわよ！
#. de: Mir reicht's mit diesen Biestern! Los!
#. fr: Débarrassons-nous de ce gêneur<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000570_ALISAIE:1"
msgid "I've had enough of this rabble. Come on!"
msgstr ""

#. ja: では、あなた方も飛空艇の中へ。<br>間もなく出発になります。
#. de: Bitte steigt zügig ins Luftschiff. Wir werden bald ablegen.
#. fr: Montez vite à bord, nous allons bientôt décoller.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000580_FOURCHENAULT:1"
msgid "You must board without delay. The ship will depart ere long."
msgstr ""

#. ja: ……予定を変えて、シャーレアン本国に避難するんですよね。<br>そこでもまた、終末に見舞われたりしないでしょうか。
#. de: Um nach Sharlayan zu fliehen, oder nicht? Lauert das Ende dort nicht ebenso<nbsp>...?
#. fr: On va se réfugier à Sharlayan, maintenant<nbsp>? Qu'est-ce qui nous dit qu'on y sera à l'abri<nbsp>?
#. speaker: PALAKASWOMANA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000590_PALAKASWOMANA:1"
msgid "Your offer to host us in Sharlayan is most appreciated, but will the Final Days not soon fall upon it as well?"
msgstr ""

#. ja: 私は、太守殿からあなた方の身命をお預かりした身……。<br>でありながら、恐ろしい思いをさせ、<br>同胞を失わせてしまったことには、弁解の余地もありません。
#. de: Der Magistrat hat Eure Leben vertrauensvoll in meine Hände gelegt. Gleichwohl musstet Ihr fürchterliches Leid erfahren und schlimme Verluste hinnehmen. Dafür gibt es keine Entschuldigung.
#. fr: Bien que le satrape m'ait confié votre protection, je vous ai mis en danger et plusieurs d'entre vous ont même péri par ma faute. J'ai échoué, et je n'ai aucune excuse.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000600_FOURCHENAULT:1"
msgid "Your hesitation is not unwarranted. The satrap entrusted me with your lives, yet I have failed your comrades."
msgstr ""

#. ja: 一方で、事実として、終末は広がり続けていく。<br>我らが祖国ならば絶対に安全だなどと、<br>軽々しい約束はできかねます。
#. de: Und Ihr habt ganz recht. Das Ende breitet sich aus wie ein Geschwür, und ich kann Euch wahrlich nicht garantieren, dass Sharlayan absolute Sicherheit bieten wird.
#. fr: Dans le même temps, l'apocalypse continue de s'étendre à travers le monde, et je ne peux vous garantir que vous serez en sécurité, à Sharlayan ou ailleurs.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000610_FOURCHENAULT:1"
msgid "Nor are you wrong to fear that this corruption will continue to spread. I cannot promise you complete safety, even in my homeland."
msgstr ""

#. ja: ……ですが、人を救済したいという心には、一点の曇りもなく。
#. de: Dennoch ist unser Wille ungebrochen und unsere Mission klar: Wir wollen helfen.
#. fr: En revanche, je peux vous promettre que je ferai tout ce qui est en mon pouvoir pour vous sauver.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000620_FOURCHENAULT:1"
msgid "What I can promise is that I will do all in my power to protect you."
msgstr ""

#. ja: 皆さんをオールド・シャーレアンにお連れするのも、<br>そこで、月へ向かう手段が建造されているからです。
#. de: Meine Landsleute arbeiten just in diesem Moment an einem Schiff, das unser aller Rettung bedeutet. Ein Schiff gen Mond. Deswegen bringe ich Euch nach Alt-Sharlayan.
#. fr: Si je veux vous emmener à Sharlayan, c'est parce que nous sommes à un cheveu de mettre au point un moyen de voyager vers la lune.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000630_FOURCHENAULT:1"
msgid "That power is not inconsiderable. Even now, my countrymen are preparing the vessel that will deliver us to a sanctuary on the moon."
msgstr ""

#. ja: それが完成すれば、多くの物資やシャーレアンの民とともに、<br>あなた方も新天地へとお連れできるでしょう。
#. de: Und ist es erst fertig, werden wir gemeinsam in eine neue Welt aufbrechen. Mitsamt dem kollektiven Erbe unseres Gestirns und ausreichend Versorgungsgütern.
#. fr: Lorsque tout sera prêt, vous pourrez vous y envoler en compagnie des Sharlayanais et du matériel nécessaire pour commencer une nouvelle vie.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000640_FOURCHENAULT:1"
msgid "Join us on our journey there and beyond, to new horizons. Come to Old Sharlayan. Please."
msgstr ""

#. ja: わかりました。<br>どうぞ、よろしくお願いします。
#. de: Dann danken wir für Eure Obhut.
#. fr: Merci, nous vous faisons confiance.
#. speaker: PALAKASWOMANA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000650_PALAKASWOMANA:1"
msgid "We would be fools to refuse such a generous offer made in earnest."
msgstr ""

#. ja: 行き先を変更なさるのですね。
#. de: Eure Pläne haben sich also geändert?
#. fr: Vous avez donc décidé de changer de destination.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000660_ALPHINAUD:1"
msgid "It seems they've a new destination."
msgstr ""

#. ja: ラザハンの民は、終末で深く傷ついている。<br>ガレマルドが間近とはいえど、<br>この状況下での強行軍は全滅を招くだけだ。
#. de: Den Leuten aus Radz-at-Han haben die Letzten Tage schlimm zugesetzt. Garlemald mag nicht weit sein, doch würden wir sie nun diesem Gewaltmarsch aussetzen, würde das nur mehr Leid bringen.
#. fr: Le peuple de Radz-at-Han a déjà bien assez souffert. Même si Garlemald est proche, tenter de s'y rendre reviendrait à courir au massacre.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000670_FOURCHENAULT:1"
msgid "The people of Radz-at-Han have known too much suffering. The march to Garlemald will only bring them more, short though it may be."
msgstr ""

#. ja: 私も、同じ考えです。<br>……くれぐれも、彼らのことをよろしくお願いします。
#. de: Das hatte mir auch Sorgen bereitet<nbsp>... Allerdings bin ich froh zu hören, dass sie nun in guten Händen sein werden. Kümmert Euch gut um sie, bitte.
#. fr: En effet, cela serait très risqué. Je compte sur vous pour faire en sorte que tout se passe bien.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000680_ALPHINAUD:1"
msgid "I quite agree. Fortunately, they have you to look after them."
msgstr ""

#. ja: アルフィノ、お前は……
#. de: Alphinaud<nbsp>...
#. fr: Tu as bien grandi, Alphinaud...
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000690_FOURCHENAULT:1"
msgid "Yes, well..."
msgstr ""

#. ja: 見てくれ、何か来る！
#. de: Seht, da kommt jemand!
#. fr: Regardez, là-bas<nbsp>!
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000700_JULLUS:1"
msgid "Behind you! Just there!"
msgstr ""

#. ja: まだ残っていやがったか……！
#. de: Hört das denn nie auf?
#. fr: Décidément, ils refusent de crever, ceux-là<nbsp>!
#. speaker: ESTINIEN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000710_ESTINIEN:1"
msgid "More of them?"
msgstr ""

#. ja: ゼノス……来ていたのか……！
#. de: Zenos<nbsp>...
#. fr: ... Zenos<nbsp>?
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000720_ALPHINAUD:1"
msgid "Zenos!? Here!?"
msgstr ""

#. ja: ……もう大丈夫だ、このまま飛空艇の方へ向かってくれ。
#. de: Alles ist gut. Geh zum Luftschiff, dort findest du Sicherheit.
#. fr: Tout va bien se passer, dépêchez-vous d'embarrrquer.
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000730_GRAHATIA:1"
msgid "You'll be all right. Hurry to the airship."
msgstr ""

#. ja: 今更、いったいどういうつもりだ……？
#. de: Was bei den Göttern soll das hier werden?
#. fr: Qu'est-ce que tu viens faire ici<nbsp>?
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000740_ALPHINAUD:1"
msgid "Why have you come?"
msgstr ""

#. ja: 見たことのない獣がいた、ゆえに斬ってみた。
#. de: Da war eine Bestie, die ich noch nie gesehen habe. Also habe ich sie erlegt.
#. fr: Quand je vois une créature pour la première fois, je ne peux m'empêcher de la prendre en chasse.
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000750_ZENOS:1"
msgid "A heretofore unseen beast. 'Twas ripe for the slaying."
msgstr ""

#. ja: が、脆かったな……。<br>これでは到底、鍛錬にならぬ。
#. de: Sie war allerdings so schwach, dass ich mich kaum aufwärmen konnte. Was für eine enttäuschende Übung.
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment, quelle déception... Elle était si faible que j'ai à peine pu m'échauffer.
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000760_ZENOS:1"
msgid "Poor sport, alas. Unfit to temper my blade."
msgstr ""

#. ja: 鍛錬って……。<br>あなた、この状況でもまだ、再戦だなんだって考えてるの！？
#. de: Übung?! Hast du nur deine dumme Revanche im Kopf?!
#. fr: T'échauffer<nbsp>!? Me dis pas que tu veux ta revanche, dans un moment pareil<nbsp>?
#. speaker: ALISAIE
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000770_ALISAIE:1"
msgid "Oh, for the love of─ You cannot <i>still</i> be on about a rematch!"
msgstr ""

#. ja: もとより、そのためだけに得た生だ。<br>ほかの何に費やす道理もない。
#. de: Warum sollte ich an irgendetwas anderes denken?
#. fr: C'est la raison même pour laquelle je suis revenu à la vie, la seule et unique pensée qui occupe mon esprit.
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000780_ZENOS:1"
msgid "That is and has ever been my sole concern."
msgstr ""

#. ja: ……しかし、お前はいまだ、別の獲物を見据えているのだろう。
#. de: Aber du hast eine andere Beute im Visier, nicht wahr?
#. fr: ... Cependant, je vois que tes yeux sont toujours braqués sur une autre proie.
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000790_ZENOS:1"
msgid "You, on the other hand, are fixated on a different quarry."
msgstr ""

#. ja: その熱は俺に及ばず、さりとて、<br>怒りや絶望で強引に奪えるものでもないらしい……。
#. de: In dir brennt ein wunderbar heißes Feuer, aber es gilt nicht mir<nbsp>... Und es lässt sich nicht locken, so sehr ich es auch mit Hass und Ver<shy>zweif<shy>lung zum Lohen bringe.
#. fr: La flamme qui brûle en toi ne m'est pas destinée, et je n'y changerai rien, même en ensevelissant ce monde dans la colère et le désespoir...
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000800_ZENOS:1"
msgid "Your passion pales before mine, yet neither hate nor despair seem sufficient to recapture your misdirected bloodlust."
msgstr ""

#. ja: ゆえにただ、牙を研いでいる。<br>今は、それだけだ。
#. de: Und so wetze ich lediglich meine Klauen.
#. fr: Je vais donc continuer à aiguiser mes crocs, en attendant patiemment de mériter ton attention.
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000810_ZENOS:1"
msgid "So I hone my blade, and I wait."
msgstr ""

#. ja: お前……何を言ってるんだ……？
#. de: Was sagt Ihr denn da<nbsp>...?
#. fr: Toi... Qu'est-ce que tu racontes<nbsp>?
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000820_JULLUS:1"
msgid "That's it? That's all you care about?"
msgstr ""

#. ja: ガレマール帝国が壊れたんだぞ……<br>俺たちの祖国が……お前たちが治めた国が！
#. de: Garlemald ist gefallen<nbsp>... Unsere Heimat. Die Heimat, über die Ihr geherrscht habt!
#. fr: L'empire de Garlemald est en ruines... Notre chère patrie... Le pays que tes ancêtres ont bâti<nbsp>!
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000830_JULLUS:1"
msgid "Garlemald is in ruins. Our homeland─the nation you rule!─is as good as gone."
msgstr ""

#. ja: 帝都はあの有様だ……大勢死んだ……。
#. de: Die Hauptstadt ist ein Trümmerfeld<nbsp>... So viele Tote<nbsp>...
#. fr: Notre fière capitale est détruite... Tant de nos frères et sœurs ont perdu la vie...
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000840_JULLUS:1"
msgid "Along with so many of its people."
msgstr ""

#. ja: 俺たちみたいに、内戦に加担した軍人だけならまだいい。<br>そうじゃない民間人まで、どれだけ斃れたと思ってるんだよ！
#. de: Wir sind Soldaten. Wenn ein Bürgerkrieg ausbricht, dann kämpfen wir. Aber wie viele unschuldige Zivilisten mussten ihr Leben lassen?!
#. fr: Nous autres soldats, on est préparés à mourir à la guerre. Mais as-tu seulement idée du nombre d'<i>innocents</i> sacrifiés durant ce conflit<nbsp>!?
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000850_JULLUS:1"
msgid "Not just soldiers like us! Not only those who fought and killed for power and duty. Innocent civilians..."
msgstr ""

#. ja: 様子がおかしくなって……同族同士で殺し合って……
#. de: Familie, Freunde, Landsleute<nbsp>... Sie haben sich alle gegenseitig abgeschlachtet. Niemand wusste, weshalb<nbsp>...
#. fr: Des camarades, des familles... qui se sont entredéchirés sans même savoir pourquoi...
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000860_JULLUS:1"
msgid "Murdered by their own flesh and blood. Lost and confused as they breathed their last."
msgstr ""

#. ja: どうにか意識を保ったまま生き延びた奴だって、<br>凍えて死んでいくしかなかった……！
#. de: Und die wenigen, die diesem Irrsinn widerstehen konnten, sind elendig erfroren<nbsp>...!
#. fr: Quant à ceux qui ont pu survivre en gardant toute leur tête, ils ont fini par mourir de froid<nbsp>!
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000870_JULLUS:1"
msgid "While we who survived with our lives and minds intact were left to freeze to death!"
msgstr ""

#. ja: 派遣団からは、お前たちが望んで仕掛けたことだったと聞いた。<br>本当なのか！？　だとしたら、なぜ……！
#. de: Und dann musste ich erfahren, dass all das Euretwegen geschehen ist?! Wenn das wahr ist, dann<nbsp>... Wieso?! Wozu?!
#. fr: Les gars de la délégation d'Ilsabard m'ont dit que t'étais responsable de tout ça. C'est vrai<nbsp>? Mais pourquoi, bon sang<nbsp>!?
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000880_JULLUS:1"
msgid "The Eorzeans tell me all this was your doing. You slaughtered your countrymen. You did. For what?"
msgstr ""

#. ja: すべて事実だ。<br>今となっては、さして意味もなかったがな。
#. de: Ja, es ist wahr. Und am Ende war alles umsonst.
#. fr: C'est la vérité même. Pour pas grand-chose, au final.
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000890_ZENOS:1"
msgid "For nothing, in the end. So much wasted effort."
msgstr ""

#. ja: な……
#. de: Was<nbsp>...
#. fr: Quoi<nbsp>!?
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000900_JULLUS:1"
msgid "You..."
msgstr ""

#. ja: ゼノス……お前……ッ！！
#. de: Du verdammter Dreckskerl!
#. fr: Zenos... Je vais te t...<nbsp>!!!
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000910_JULLUS:1"
msgid "You bastard!"
msgstr ""

#. ja: ユルス、ダメだ、落ち着いてくれ……！<br>ゼノスなんかのためじゃない、君のために怒りを抑えるんだ！
#. de: Jullus! Zenos hat all deinen Zorn verdient, aber du musst dich jetzt beruhigen! Ich bitte dich!
#. fr: Jullus<nbsp>! Tu dois garder ton calme<nbsp>! Pas pour Zenos, mais pour ton bien<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000920_ALPHINAUD:1"
msgid "For your own sake, Jullus, you must control your anger!"
msgstr ""

#. ja: この災厄のもとで強い負の感情を抱けば、<br>君だって、獣に転じてしまうかもしれない。<br>だから……！
#. de: Wenn dich deine Gefühle übermannen, wirst auch du zu einer Bestie!
#. fr: Si tu te laisses envahir par la colère, tu pourrais te transformer en monstre, toi aussi<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000930_ALPHINAUD:1"
msgid "It will serve no one should it consume you and see you transformed."
msgstr ""

#. ja: くうっ
#. de: Grrh<nbsp>...
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000940_JULLUS:1"
msgid "Report if displayed."
msgstr ""

#. ja: ……理由があればよかったのか？
#. de: Hättest du gerne einen Grund?
#. fr: ... Tu voulais une raison<nbsp>?
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000950_ZENOS:1"
msgid "Would you be “happier” had I a “good reason”?"
msgstr ""

#. ja: なんだって……？
#. de: Was?
#. fr: Hein<nbsp>!?
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000960_JULLUS:1"
msgid "What?"
msgstr ""

#. ja: それらしい理由があれば、<br>眼前の事実を許せたのかと言ったのだ。
#. de: Ich frage, ob ich dir einen Grund nennen soll. Es klang so, als hättest du gerne einen. Um das, was du gesehen hast, zu vergeben. Zu rechtfertigen.
#. fr: Tu m'as demandé “pourquoi<nbsp>?”... Comme si une raison allait t'aider à accepter la réalité qui se trouve sous tes yeux.
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000970_ZENOS:1"
msgid "If my motives met with your approval, would you no longer resent the outcome?"
msgstr ""

#. ja: だとすれば、貴様らはやはり愚かな獣……<br>狩られる側の存在であろうよ。
#. de: Wenn dem so ist, wärst auch du nur stumpfes Vieh.
#. fr: Si c'est le cas, tu n'es qu'une bête écervelée, qui ne mérite rien d'autre que d'être chassée.
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000980_ZENOS:1"
msgid "If so, then perhaps a beast's skin would suit you better."
msgstr ""

#. ja: 物事は常、誰かの都合がいいように語られる。<br>いかなる理由も名分も、善悪などというものでさえな。
#. de: Was sind schon Gründe? Die Frage nach Richtig oder Falsch<nbsp>... All das sind nichts weiter als bequeme Ausflüchte. Alles Schall und Rauch.
#. fr: Raisons, justifications... de simples outils pour écrire sa version de l'histoire.
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_000990_ZENOS:1"
msgid "Duty...honor...morality...all constructs of convenience, when put to proof."
msgstr ""

#. ja: ガレマールという国の中枢では、いくらでも見られたぞ？<br>潰し合いの中で、正しさがすり替えられる様を……。
#. de: Hat dich der Krieg denn nichts gelehrt? Glaubst du, Garlemald sei anders? Besonders? Wie oft haben sinnlose Konflikte die Grenze zwischen Gut und Böse verwischt.
#. fr: Il en va ainsi partout dans le monde, et Garlemald n'est en rien différent. Combien de fois a-t-on vu des conflits dénués de sens brouiller la frontière entre le bien et le mal<nbsp>?
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001000_ZENOS:1"
msgid "Surely the war taught you how easily power becomes the tool of the self-righteous?"
msgstr ""

#. ja: あるいは、民衆が意気揚々と掲げる正義が、<br>計略により扇動されたものであったという事実を……。
#. de: Schaut euch nur an: Wie ihr allzu bereitwillig eure Schwerter im Blut anderer gebadet habt, im Namen der Gerechtigkeit. Dabei seid ihr schon immer blind dem Willen selbstgerechter Intriganten gefolgt.
#. fr: Et la populace... Les gueux qui, comme toi et tes petits camarades, croient aveuglément en une justice qui n'est rien d'autre qu'une illusion...
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001010_ZENOS:1"
msgid "How the people's “justice” was merely a means to their ends?"
msgstr ""

#. ja: 貴様は今、俺になぜと問うたな。<br>……馬鹿馬鹿しい。
#. de: Und da fragst du mich nach einem Grund. Lächerlich.
#. fr: Et voilà qu'un de ces gueux me demande “pourquoi”... C'est d'un grotesque...
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001020_ZENOS:1"
msgid "Yet you would ask me why."
msgstr ""

#. ja: 現実に納得するための理由を、他者になど求めて何になる。<br>そんなもの、たとえ地の果て、天の果てまで問い求めようが、<br>返ってくるのは誰ぞの都合よ。
#. de: Was blickst du zu anderen und fragst nach Erklärungen? Nach deren Gründen? Auf der Suche nach einer Antwort könntest du bis ans Ende des Universums reisen und fändest doch nur eines<nbsp>... Selbstsucht.
#. fr: À quoi bon chercher chez les autres des raisons d'accepter la réalité<nbsp>? Tu auras beau remuer ciel et terre, tu ne trouveras que mensonge et opportunisme.
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001030_ZENOS:1"
msgid "Ask any creature of this star and those above for answers, and they will tell you what suits their fancy."
msgstr ""

#. ja: 己が生に横臥することごとく、<br>それに意味を、答えを出すのは己自身だ。
#. de: Im Sein einen Sinn zu finden<nbsp>... Diese Verantwortung liegt allein bei uns selbst.
#. fr: Pour donner un sens à son existence, on ne doit jamais compter sur personne d'autre que <i>soi-même</i>.
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001040_ZENOS:1"
msgid "And they would be right to do so. What meaning there is to be found in the petty vicissitudes of your existence must be gleaned by you and you alone."
msgstr ""

#. ja: 貴様が自らの答えとして剣を抜くというのなら、<br>俺は俺の道理にて、その身を技の糧にしてやろう。
#. de: Ist dein Sinn nun das gezogene Schwert, so werde ich meine Klauen auch an dir wetzen.
#. fr: Vas-y, pointe ta lame sur moi... Donne-moi une autre occasion d'aiguiser mes crocs...
#. speaker: ZENOS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001050_ZENOS:1"
msgid "Should you seek it in battle─in the fruitless pursuit of my demise─then come. Assume your rightful place as a notch on my blade."
msgstr ""

#. ja: ……お前の存在は、ガレアンにとって猛毒だ。<br>怒りも悲しみも、全部吐き出して叩きつけてやりたくなる。
#. de: ... Deine Existenz ist Gift in Garlemalds Adern. Ich will dir all meinen Zorn und all meinen Kummer ins Gesicht spucken, auf dass sie dich zerfressen mögen.
#. fr: Ton existence même est une insulte à tous les Garlemaldais. Tu mériterais de subir au centuple la douleur de ceux qui ont souffert par ta faute.
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001060_JULLUS:1"
msgid "You are a blight on the Garlean race, and there would be no more satisfying way to expunge it than by beating you to death."
msgstr ""

#. ja: だが、アルフィノの言うように、<br>それが悲劇の引き金になるなら……<br>俺はもう、お前のせいで血を分けた仲間を失いたくはない。
#. de: Aber Alphinaud hat Recht. Es zöge nur eine weitere Tragödie nach sich und ich möchte wahrlich niemand mehr an deinen Irrsinn verlieren.
#. fr: Mais comme l'a dit Alphinaud, recourir à la violence ne ferait que provoquer une tragédie plus grande encore. Et moi, je ne veux pas perdre un camarade de plus.
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001070_JULLUS:1"
msgid "But I will not be party to another tragedy. I refuse to lose anyone else because of you."
msgstr ""

#. ja: 行け……！<br>そして二度と、同胞の前に姿を現すな……！
#. de: Verschwinde! Und wage es bloß nicht, noch ein einziges Mal vor deine Landsleute zu treten!
#. fr: Va-t'en<nbsp>! Pars, et ne te montre plus jamais devant nous<nbsp>!
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001080_JULLUS:1"
msgid "So go! Go, and may we never suffer your madness again."
msgstr ""

#. ja: ……ゼノス！
#. de: Zenos!
#. fr: ... Zenos<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001090_ALISAIE:1"
msgid "Zenos!"
msgstr ""

#. ja: あなたの生き方は強いわ。<br>一理あるとも思う……。
#. de: Du hast vielleicht Sinn in dieser Lebensweise gefunden und manches, was du gesagt hast, mag stimmen.
#. fr: Tu as une conception bien tranchée de l'existence, et c'est ton droit.
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001100_ALISAIE:1"
msgid "Perhaps you've found meaning in living this way─I cannot deny you've found strength."
msgstr ""

#. ja: けどね、それで他人を傷つけてたら、<br>あなたはずっと孤独なまま。<br>再戦だってなんだって、望まれるわけないわ。
#. de: Aber wenn du das verachtest, was anderen Sinn gibt, und du dich nur um dich selbst sorgst, wirst du für immer allein sein. Diese Revanche zum Beispiel? Wer sollte sich darauf einlassen wollen?
#. fr: Mais si tu continues à mépriser tes semblables, tu resteras toujours dé<shy>ses<shy>pé<shy>ré<shy>ment seul. Tu crois vraiment que quelqu'un se soucie de ta foutue revanche<nbsp>?
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001110_ALISAIE:1"
msgid "Yet if you only pursue your hedonistic pleasures, and pay no heed to the plight of others, then no one will give you the time of day."
msgstr ""

#. ja: 人に求めることがあるならば、自分が愉しむだけじゃなく、<br>一緒に愉しめるように考えるものよ。
#. de: Du benutzt jeden nur für dein eigenes Vergnügen, ohne etwas zurückzugeben. Wie wär's denn, wenn du den Spaß zur Abwechslung mal teilst? Wenn du mal an andere denkst? Dich für sie interessierst?
#. fr: Au lieu de toujours te servir des autres pour ta propre sa<shy>tis<shy>fac<shy>tion, tu devrais essayer de partager les plaisirs de la vie avec eux, ça te changerait.
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001120_ALISAIE:1"
msgid "You will never get what you want─not even the battle you pine for so dearly."
msgstr ""

#. ja: そんなこともわからないなら……永久にふられてなさい。
#. de: Und wenn du das nicht kannst<nbsp>... Dann hau ab. Genieß deine Einsamkeit. Du verdienst sie.
#. fr: Et si tu préfères rester comme tu es, alors profite bien de ta solitude et continue à t'attirer la haine du monde entier.
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001130_ALISAIE:1"
msgid "You'll be alone for an eternity, and you'll deserve every agonizing second of it."
msgstr ""

#. ja: 飛空艇の出発準備が整った。<br>民を乗せているものはすぐに発つが、<br>私の船は、しばし待機させている。
#. de: Die Luftschiffe sind bereit zum Abflug. Das mit den Bürgern Radz-at-Hans bricht gleich auf, aber mein eigenes wird noch eine Weile ankern.
#. fr: Les réfugiés sont sur le point de s'envoler, mais mon aéronef va rester stationné ici dans l'immédiat.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001140_FOURCHENAULT:1"
msgid "We are ready to depart. The refugee ships will be leaving shortly, but I've asked mine to remain for the time being."
msgstr ""

#. ja: お前たちも、望むのであれば、それに乗りなさい。
#. de: Es steht euch offen, mitzufliegen, so ihr es denn wünscht.
#. fr: Si vous le désirez, vous êtes les bienvenus à bord.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001150_FOURCHENAULT:1"
msgid "There's room enough for you to join me on it, if you wish."
msgstr ""

#. ja: ……此度の騒動で「暁」に助けられたのは事実。<br>道を違えていたとて、それは否定されるべきではない。
#. de: Der Bund der Morgenröte hat uns hier und heute vor Schlimmem bewahrt. Wir mögen grundverschiedener Ansichten sein, aber eure Hilfe ist unbestreitbar.
#. fr: Sans l'in<shy>ter<shy>ven<shy>tion des Héritiers de la Septième Aube, qui sait ce qui aurait pu se passer<nbsp>? Même si nous ne partageons pas la même vision, votre aide est hautement appréciée.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001160_FOURCHENAULT:1"
msgid "Do contain your surprise. I needn't agree with the Scions' methods or intentions to acknowledge that their deeds are deserving of gratitude."
msgstr ""

#. ja: お気遣い、ありがとうございます。<br>しかし、しばし待機というのは……？
#. de: Danke für das Angebot. Aber wie lange ist denn eine Weile?
#. fr: Nous vous remercions pour cette attention. Mais pourquoi votre aéronef ne décolle-t-il pas avec les autres<nbsp>?
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001170_ALPHINAUD:1"
msgid "We appreciate the offer, but might I ask why you are delaying your departure? I presume it is not solely for our benefit."
msgstr ""

#. ja: 私は一度ガレマルドに赴き、<br>イルサバード派遣団に状況を共有するつもりだ。<br>この地で問題を起こした以上、筋は通さねばならないだろう。
#. de: Ich werde nach Garlemald reisen, um das Ilsabard-Korps über die dortige Lage zu informieren. Nach dem Eingreifen der kaiserlichen Armee betrachte ich es als meine Pflicht, mich dieser Situation anzunehmen.
#. fr: J'ai l'intention de me rendre à Garlemald pour informer la délégation d'Ilsabard. Après ce qui vient de se passer ici, il en va de ma res<shy>pon<shy>sa<shy>bi<shy>li<shy>té.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001180_FOURCHENAULT:1"
msgid "I must visit Garlemald ere we return to Sharlayan. Having caused such an uproar, 'tis only meet that I explain myself to the Ilsabard contingent."
msgstr ""

#. ja: であれば、私たちもご一緒しましょう。<br>両者を知る立場として、お役に立てるかもしれません。
#. de: In dem Fall werden wir dich begleiten. Wir kennen beide Seiten der garleischen Medaille und unsere Einblicke könnten dir nützlich sein.
#. fr: Dans ce cas, permettez-nous de vous accompagner. Grâce à nos relations avec les deux parties, nous pourrons cer<shy>tai<shy>ne<shy>ment nous rendre utiles.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001190_ALPHINAUD:1"
msgid "Allow us to accompany you, then. We should be glad to facilitate, given our familiarity with all concerned."
msgstr ""

#. ja: ユルス、よければ君も……<br>歩きながら、終末について知っていることを話すよ。
#. de: Jullus. Schließe dich gerne an, wenn du möchtest. Unterwegs kann ich dir erzählen, was es mit den sogenannten Letzten Tagen auf sich hat.
#. fr: Jullus, tu veux bien te joindre à nous<nbsp>? Je profiterai du trajet pour te raconter ce qu'on sait sur l'apocalypse.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001200_ALPHINAUD:1"
msgid "If you would like to join as well, Jullus, we can speak of recent events on the way."
msgstr ""

#. ja: まったく、いよいよ大人顔負けだな。
#. de: Unsere jungen Adler werden also endlich flügge<nbsp>...
#. fr: Voilà ce qui s'appelle “voler de ses propres ailes”.
#. speaker: ESTINIEN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001210_ESTINIEN:1"
msgid "He'll be after your seat on the Forum next."
msgstr ""

#. ja: ああ、無事だったか……！
#. de: Ihr seid unversehrt. Sehr gut.
#. fr: Vous allez bien, quel soulagement<nbsp>!
#. speaker: LUCIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001220_LUCIA:1"
msgid "No major injuries then. Good."
msgstr ""

#. ja: 取り急ぎ、治療が済んだ帝国軍の者たちに事情を説明し、<br>貴公らを追ってほしいと頼んだのだが……間に合ったようだな。
#. de: Ich habe die geheilten Truppen über die Situation aufgeklärt und sie umgehend zu eurer Unterstützung entsendet. Offenbar haben sie euch noch rechtzeitig erreicht.
#. fr: J'ai expliqué en urgence la situation aux soldats impériaux guéris en espérant qu'ils vous retrouvent à temps... On dirait bien que ça a marché.
#. speaker: LUCIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001230_LUCIA:1"
msgid "I briefed the recovered soldiers and sent them on their way as quickly as I could, but nevertheless feared they would not make it in time."
msgstr ""

#. ja: ええ、とても心強い援軍でした。<br>彼らが来てくれたことで救えた命も少なくありません。
#. de: In der Tat. Durch ihr beherztes Eingreifen wurden viele Leben gerettet.
#. fr: Oui, ces renforts étaient un véritable don du ciel<nbsp>! Grâce à eux, de nombreuses vies ont pu être sauvées.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001240_ALPHINAUD:1"
msgid "The additional support was invaluable. Your men saved more than a few lives."
msgstr ""

#. ja: ……ただ、それでもなお、助けられなかった人々もいました。
#. de: Und doch konnten wir nicht allen helfen<nbsp>...
#. fr: ... Mal<shy>heu<shy>reu<shy>se<shy>ment, d'autres n'ont pas eu cette chance.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001250_ALPHINAUD:1"
msgid "...Though not all, I regret to say."
msgstr ""

#. ja: イルサバード派遣団代表のルキア・ユニウス卿とお見受けする。<br>私は、シャーレアン哲学者議会のフルシュノ・ルヴェユール。
#. de: Ihr müsst Lucia Junius sein, die Kommandantin des Ilsabard-Korps. Gestatten, Fourchenault Leveilleur vom Rat der Philosophen Sharlayans. Es ist mir eine Ehre.
#. fr: Vous êtes bien Lucia Junius, re<shy>pré<shy>sen<shy>tante de la délégation d'Ilsabard<nbsp>? Mon nom est Fourchenault Leveilleur, j'appartiens au Conseil de Sharlayan.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001260_FOURCHENAULT:1"
msgid "I take it that I am addressing Lucia Junius? I am the Forum's envoy, Fourchenault Leveilleur."
msgstr ""

#. ja: こちらの状況は、私から説明させていただこう……。
#. de: Erlaubt mir, euch über die aktuelle Lage zu informieren.
#. fr: Permettez-moi de tout vous expliquer...
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001270_FOURCHENAULT:1"
msgid "And you are owed an explanation for these most dire developments."
msgstr ""

#. ja: そうか……。<br>やはりこれが、終末の災厄で間違いないのだな。
#. de: Verstehe<nbsp>... Wir haben es also tatsächlich mit dem Ende der Welt zu tun<nbsp>...
#. fr: Je vois... Cette fois c'est sûr, ce sont des manifestations de l'apocalypse.
#. speaker: LUCIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001280_LUCIA:1"
msgid "Another trial wrought by the Final Days... I was beginning to suspect as much."
msgstr ""

#. ja: 貴公も、さぞ歯がゆい思いをされていることだろう。<br>しかし、強行せずに避難を選んでくれたのは正解だった。
#. de: Sicherlich fühlt es sich gerade wie ein herber Rückschlag an, aber es war die richtige Entscheidung, zu evakuieren. Es hätte nur zu weiteren Verlusten geführt, hättet ihr eure Stellung mit aller Gewalt verteidigt.
#. fr: Même si la tournure des événements n'est pas celle que vous espériez, je suis convaincue que vous avez fait le bon choix en prenant en charge les réfugiés.
#. speaker: LUCIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001290_LUCIA:1"
msgid "You doubtless feel some consternation having been forced to abandon your original plan─but trust me when I say you were right to send the refugees elsewhere."
msgstr ""

#. ja: 実は、ガレマルド市街地でも、異形の獣の姿が確認されている。<br>もともと廃墟同然の状態だったため、数は少ないが……。
#. de: Im Zentrum Garlemalds wurden ebenfalls groteske Bestien gesichtet. Immerhin halten sich ihre Zahlen in Grenzen, da sich kaum mehr Überlebende in der zerstörten Stadt aufhalten.
#. fr: À Garlemald aussi, des bêtes similaires sont apparues. Heu<shy>reu<shy>se<shy>ment elles sont peu nombreuses, puisque la capitale est presque déserte.
#. speaker: LUCIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001300_LUCIA:1"
msgid "Beasts have been sighted within the capital. Perhaps it was a stroke of grim fortune that the population was decimated beforehand, as they've yet to appear in any great number, but in time..."
msgstr ""

#. ja: 今はマキシマ殿が派遣団の残留部隊を率いて、<br>討伐と避難誘導にあたってくれている。
#. de: Maxima führt die verbliebenen Truppen des Korps gerade dorthin, um den Rest der Bestien unschädlich zu machen und die Evakuierung der übrig gebliebenen Bewohner zu leiten.
#. fr: Maxima est ac<shy>tu<shy>el<shy>le<shy>ment sur place avec des effectifs de la délégation pour chasser ces monstres et organiser l'évacuation des rescapés.
#. speaker: LUCIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001310_LUCIA:1"
msgid "In any case, Maxima leads the remainder of the contingent in an effort to cull the creatures and evacuate the populace as we speak."
msgstr ""

#. ja: 貴公ら帝国軍にも、飛空艇の護衛を終え次第、<br>合流を頼めるだろうか……？
#. de: Ich möchte um die Unterstützung der kaiserlichen Truppen bitten, sobald alle Luftschiffe gestartet sind.
#. fr: Jullus, que dirais-tu de les rejoindre avec tes camarades, une fois que tous les aéronefs auront décollé<nbsp>?
#. speaker: LUCIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001320_LUCIA:1"
msgid "Once the airships have taken to the skies, I pray your men can be persuaded to join him."
msgstr ""

#. ja: いいのか？<br>俺たちに武器を持たせ続けて……。
#. de: Vertraut ihr uns dafür denn genug?
#. fr: Vous avez décidé de nous faire confiance...<nbsp>?
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001330_JULLUS:1"
msgid "You'll permit us to retain our weapons?"
msgstr ""

#. ja: 造反を危惧しているのなら、そもそも、<br>恩人たる「暁」を追わせたりはしなかったさ。
#. de: Wäre ich um einen Hinterhalt eurerseits besorgt, hätte ich euch nicht gen Bund der Morgenröte ziehen lassen.
#. fr: Si je mettais en doute tes motivations, je ne t'aurais jamais demandé d'aller prêter main-forte aux Héritiers de la Septième Aube.
#. speaker: LUCIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001340_LUCIA:1"
msgid "I wouldn't have sent you after the Scions were I expecting you to stab them in the back."
msgstr ""

#. ja: 私たちからも、お願いするよ。<br>終末が広がりつつある今、君たちの力を貸してほしいんだ。
#. de: Das Ende der Welt wiegt schwerer als alte Feindschaften, und jede Hilfe ist willkommen.
#. fr: Je te le demande aussi, de notre part à tous. L'apocalypse gagne du terrain d'heure en heure, et nous avons plus que jamais besoin de votre aide.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001350_ALPHINAUD:1"
msgid "And I, for one, would not consider past transgressions more relevant than future contributions."
msgstr ""

#. ja: 違う血を引き、違う想いを抱き、互いに禍根もあるだろうが……<br>今度こそ、ともに未来を模索する盟友として。
#. de: Wir mögen unter<shy>schied<shy>licher Abstammung sein, gar gänzlich andere Ansichten haben<nbsp>... Aber im Moment kämpfen wir alle für dasselbe. Für eine Zukunft.
#. fr: Le sang qui coule dans nos veines et les idéaux qui nous animent sont peut-être différents, mais le temps n'est plus au conflit. C'est en nous alliant que nous construirons notre futur.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001360_ALPHINAUD:1"
msgid "Regardless of the circumstances that saw us at odds before, we need men of courage now. More than ever."
msgstr ""

#. ja: ……その要請、承った。<br>もとより、帝都を護るのは俺たちの役目だからな。
#. de: Selbstverständlich werden wir helfen. Wir haben geschworen, die kaiserliche Hauptstadt zu schützen.
#. fr: Vous pouvez compter sur nous. Pour mes compagnons et moi, la protection de Garlemald a toujours été une priorité absolue.
#. speaker: JULLUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001370_JULLUS:1"
msgid "We swore to defend Garlemald. And so we shall."
msgstr ""

#. ja: では、私も己の職務に戻らせていただく。<br>皆には今一度の感謝を。
#. de: Ich selbst werde mich nun wieder meinen Obliegenheiten zuwenden. Ich danke euch allen erneut für Kooperation und Beistand.
#. fr: Très bien, il est temps que je retourne à mes res<shy>pon<shy>sa<shy>bi<shy>li<shy>tés. Merci à tous pour votre précieuse coopération.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001380_FOURCHENAULT:1"
msgid "It seems you have everything under control. You will excuse me, then, for mine own duties await."
msgstr ""

#. ja: お待ちください……フルシュノ殿。
#. de: Bitte, einen Moment noch<nbsp>...
#. fr: Juste une seconde, s'il vous plaît.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001390_ALPHINAUD:1"
msgid "A moment, Master Fourchenault."
msgstr ""

#. ja: 謝意を表していただけるのなら、<br>ひとつだけ、願いを聞いてはもらえないでしょうか。
#. de: Ich würde dich gerne um einen Gefallen bitten<nbsp>...
#. fr: Si vous le permettez, j'aurais une faveur à vous demander...
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001400_ALPHINAUD:1"
msgid "You did desire to express your appreciation for services rendered, did you not?"
msgstr ""

#. ja: ……悪いが、我々の計画に口を挟もうというのならば、<br>聞き届けることはできない。
#. de: ... Es tut mir leid, mein Sohn, aber wenn du mich nun für eure Pläne rekrutieren möchtest, werde ich dir diesen Gefallen abschlagen müssen.
#. fr: Si c'est pour me faire part de tes réserves au sujet de notre projet, je n'ai pas besoin d'en entendre davantage.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001410_FOURCHENAULT:1"
msgid "I did... Though if you intend to again ask that Sharlayan alter its course, you will find my gratitude insufficient."
msgstr ""

#. ja: いいえ……ただ、話を聞く機会をいただきたいのです。
#. de: Nein, das ist es nicht. Ich möchte lediglich eine Erklärung.
#. fr: Non... Au contraire, je voudrais profiter de cette occasion pour vous demander des éclaircissements.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001420_ALPHINAUD:1"
msgid "'Tis nothing so onerous."
msgstr ""

#. ja: シャーレアンの、この星からの大撤収。<br>その計画の全容を、教えていただきたい。
#. de: Zu Sharlayans Großem Exodus, die Flucht von diesem Planeten. Ich möchte den Plan in seiner Gänze hören.
#. fr: Le projet de Grand Exode de Sharlayan... J'aimerais que vous l'expliquiez en détail.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001430_ALPHINAUD:1"
msgid "I wish to hear the details of this grand endeavor of yours."
msgstr ""

#. ja: あくまで聞くだけで、<br>我々を妨げるようなことはしないと、誓えるか？
#. de: Kannst du mir denn versprechen, dass du es beim Zuhören belässt und keine Bestrebungen unternimmst, uns zu hindern oder aufzuhalten?
#. fr: Peux-tu me promettre que ta véritable intention n'est pas de nous faire obstacle<nbsp>?
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001440_FOURCHENAULT:1"
msgid "Do you swear to listen and to learn, and not to embark upon some scheme to impede us?"
msgstr ""

#. ja: はい、お約束します。
#. de: Ja. Das verspreche ich.
#. fr: Je vous en fais le serment.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001450_ALPHINAUD:1"
msgid "I swear."
msgstr ""

#. ja: ……ほかの者の約束ならば、もう少し疑えたのだがな。<br>お前のそれは、破られたことがなかったか。
#. de: Hätte mir ein anderer ein solches Versprechen gegeben, wäre ich zweifelsohne misstrauischer. Aber du, du hast in deinem Leben noch keines gebrochen<nbsp>...
#. fr: Venant de quelqu'un d'autre, j'aurais beaucoup de mal à y croire... Mais depuis ton plus jeune âge, tu as toujours tenu ta parole.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001460_FOURCHENAULT:1"
msgid "...Hmph. Any other I would doubt, but you I trust to keep your word. For not once have you broken it."
msgstr ""

#. ja: ひとまず、哲学者議会に持ちかけてみるとしよう。<br>結果が出次第、バルデシオン委員会に使者を送る。<br>……それでいいな？
#. de: Ich werde deine Bitte dem Rat vorlegen müssen. Sobald eine Entscheidung getroffen ist, lasse ich Nachricht an Baldesions Gelehrte schicken. Ist das akzeptabel?
#. fr: Soit, je vais m'entretenir avec le Conseil à ce sujet. Si la réponse est positive, j'enverrai un messager chez les Élèves de Baldesion pour te prévenir. Es-tu satisfait<nbsp>?
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001470_FOURCHENAULT:1"
msgid "Very well. I will request that the Forum make you privy to our plans. You may await our summons at the Baldesion Annex─assuming the decision is in your favor. Does that suffice?"
msgstr ""

#. ja: 十分です、ありがとうございます。
#. de: Mehr als das. Vielen Dank.
#. fr: Oui, je vous remercie.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001480_ALPHINAUD:1"
msgid "It does. You have my thanks."
msgstr ""

#. ja: やったな。<br>じゃあ、ひとまずオールド・シャーレアンに戻ろう。<br>あんたの第一世界についての報告も、ゆっくり聞きたいしな。
#. de: Das lief gut. Kehren wir nach Alt-Sharlayan zurück. Ich bin schon gespannt, was du uns vom ersten Splitter berichten wirst.
#. fr: Parrrfait<nbsp>! Pour commencer, rentrons à Sharlayan. Je parie que tout le monde a hâte d'entendre ce qui s'est passé dans le premier reflet.
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001490_GRAHATIA:1"
msgid "Excellent! You can regale us with tales of your most recent sojourn to the First while we wait."
msgstr ""

#. ja: ん……今何か聞こえなかったか……？
#. de: Hm? Hast du das auch gerade gehört?
#. fr: Hmm<nbsp>? Vous n'avez rrrien entendu<nbsp>?
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001500_GRAHATIA:1"
msgid "Did you...hear something just now?"
msgstr ""

#. ja: (-？？？？-)……グ……ング……。<br>ィン……プ…………プ…………。
#. de: (-???-)Puh<nbsp>... hnnng<nbsp>... Puddi .. Hnnnnnng<nbsp>... Prrrrrh<nbsp>... hnnnnng<nbsp>...
#. fr: (-???-)Pu... dding... Pu... dding... Pu... dding... Pu... dding...
#. speaker: PUDDINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001510_PUDDINGWAY:1"
msgid "(-???-)Pudding... Puuuddiiing..."
msgstr ""

#. ja: プディング！！<br>青い星のプディングは、どこですか！！
#. de: Pudding!!! Wo ist der sagenumwobene Pudding des blauen Steeeerns?!
#. fr: Où est le fameux flan de la planète bleue<nbsp>!? J'ai toujours rêvé d'y goûter<nbsp>!
#. speaker: PUDDINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001520_PUDDINGWAY:1"
msgid "Where, oh where, is this star's blasted pudding!?"
msgstr ""

#. ja: ……はぁ？
#. de: Was zum<nbsp>...
#. fr: ... Hein<nbsp>!?
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001530_GRAHATIA:1"
msgid "Um...?"
msgstr ""

#. ja: (-？？？？-)月明輝けども、必ずや暁迎えん……。
#. de: (-???-)Selbst wenn der Mond mit Gleißen birst, kommt ganz gewiss die Dämmerung am Morgen<nbsp>...
#. fr: (-Voix familière-)Je dis toujours que la lumière de l'aube peut bien dissiper la plus sombre des nuits...
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001540_URIANGER:1"
msgid "Dawn may banish even the darkest night..."
msgstr ""

#. ja: (-？？？？-)とはいえ、まさかここでお会いできるとは……。
#. de: (-???-)Dennoch hätte ich nicht erwartet, euch hier anzutreffen.
#. fr: (-Voix familière-)... Mais je n'aurais jamais cru retrouver mes camarades Héritiers dans un endroit pareil.
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001550_URIANGER:1"
msgid "And to this bitter clime bring warmth and comfort."
msgstr ""

#. ja: ご無沙汰しておりました、皆さん。<br>ゆえあって、ただいま地上に帰還いたしました。
#. de: Wir haben uns lange nicht gesehen, Freunde. Wie ihr seht, hat mich unser Gestirn seit eben wieder.
#. fr: Bonjour, mes amis. Finalement, j'ai décidé de rentrer.
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001560_URIANGER:1"
msgid "'Tis heartening to see such an assembly upon my return. I thought often of you whilst I looked down upon our star's brilliance from the moon above."
msgstr ""

#. ja: ウリエンジェ、どうしてここに！？<br>あとその格好寒くないの！？
#. de: Urianger, was machst du hier?! Und ist dir in deinem Aufzug überhaupt nicht kalt?!
#. fr: Urianger<nbsp>!? Qu'est-ce que vous faites ici<nbsp>? Vous n'avez pas froid, habillé comme ça<nbsp>?
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001570_ALISAIE:1"
msgid "Yes, but what are you doing here? And dressed like that! Aren't you cold?"
msgstr ""

#. ja: それが、話せば長くなり……この格好は大変寒いのですが……。
#. de: In der Tat wird es wohl nicht mehr lange brauchen und die eisige Hand des Todes wird mich dahingerafft haben.
#. fr: C'est une longue histoire... Et oui, je suis frigorifié...
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001580_URIANGER:1"
msgid "Verily. I fear for my health should I proceed to expound upon our purpose ere I procure more suitable garments..."
msgstr ""

#. ja: 終末の現象が観測され始めたのに、<br>地上のみなさんが、なかなかいらっしゃらないからですわ。
#. de: Deshalb lasst mich schnell erklären, warum wir hier sind: Niemand<nbsp>- keine einzige Seele<nbsp>- ist nämlich zu uns auf den Mond geflohen. Und das, obwohl wir den Anfang des Endes beobachtet haben.
#. fr: Malgré les manifestations de l'apocalypse, aucun être humain n'est encore venu se réfugier sur la lune<nbsp>!
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001590_LIVINGWAY:1"
msgid "Then allow me to summarize─we're here because none of you lot are up there! Nor has anyone deigned to send word about any changes in the plans!"
msgstr ""

#. ja: かといって、月には行かないことになったという連絡もなし。<br>もしや準備に手間取っているのではないかと考え、<br>意を決してお手伝いに……
#. de: Aber wir haben auch nichts davon gehört, dass die Evakuierung abgesagt wurde und nun gar nicht stattfindet. Vielleicht gibt es Probleme mit den Vor<shy>bereitungen zur Abreise, dachten wir uns, und wollten helfen kommen.
#. fr: Comme personne ne nous a contactés, on s'est dit qu'il y avait peut-être eu quelques imprévus... Du coup, on est venus vous donner un petit coup de patte<nbsp>!
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001600_LIVINGWAY:1"
msgid "It's rude, is what it is. Least that's what I thought at first, but then folks got to wondering if you weren't in a spot of bother, so we decided to take matters into our own hands. Come down here and help, if our help be needed."
msgstr ""

#. ja: いやぁ、それがねぇ、<br>ウリエンジェにアーテリスの話をいろいろ聞いてたら、<br>どうしても本物を見てみたくなっちゃってさ。
#. de: Außerdem hat Urianger so sehr von Ætheris geschwärmt, dass wir den Planeten unbedingt mit eigenen Augen bestaunen müssen.
#. fr: Et puis, à force d'entendre les histoires d'Urianger au sujet d'Ætherys, on a eu envie de voir ça de nos propres yeux.
#. speaker: MAPPINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001610_MAPPINGWAY:1"
msgid "So she says, but it's also something of a convenient excuse to visit Etheirys. Urianger made it sound absolutely marvelous. More so before the impending doom, but still."
msgstr ""

#. ja: 終末で滅びるなら、今しかない！<br>って思ったんだよなー。
#. de: Richtig! Bevor der Planet endgültig hopsgeht!
#. fr: Avec l'apocalypse qui s'annonce, c'est sûrement notre dernière chance de visiter cette planète avant qu'elle ne disparaisse com<shy>plè<shy>te<shy>ment<nbsp>!
#. speaker: SINGINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001620_SINGINGWAY:1"
msgid "And it's not like there will ever be a better time! What with the aforementioned doom."
msgstr ""

#. ja: プディング……プディング……<br>ウリエンジェのプディングよりもおいしいプディング……<br>会いたい食べたい恋しいプディング……。
#. de: Pudding<nbsp>... Echter Pudding, nicht Uriangers Bleh. Lang ersehnter Pudding, mein Herz verzehrt sich nach dir<nbsp>...
#. fr: Si Urianger dit vrai, on trouve plein de flans encore meilleurs que les siens, ici... Il faut absolument que je goûte ça...
#. speaker: PUDDINGWAY
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001630_PUDDINGWAY:1"
msgid "<i>Marvelous</i>, they say, yet not an onze of pudding to be found! I must suffer Urianger's inferior works no more..."
msgstr ""

#. ja: ちょっとあなたたち！<br>言い方ってものがありましてよ！？
#. de: He, ihr raubauzigen Rüben! Kein Fünkchen Anstand in den langen Löffeln<nbsp>...
#. fr: Non mais dites donc<nbsp>! Il y a des façons de s'exprimer, enfin<nbsp>!
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001640_LIVINGWAY:1"
msgid "Hey! Maybe consider the plight of present company before you go blathering on about pudding and doom?"
msgstr ""

#. ja: コホン
#. de: Ähem!
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001650_LIVINGWAY:1"
msgid "Ahem!"
msgstr ""

#. ja: と、ともかく、ヒトの判断がどうなるにせよ、<br>お手伝いができればと思って参ったのです。
#. de: Wie gesagt, wie auch immer die Entscheidung der Bevölkerung von Ætheris ausfallen wird. Wir sind hier, weil wir helfen wollen.
#. fr: Je disais donc, quels que soient les projets des humains sur la lune ou ailleurs, nous sommes venus ici <i>pour nous rendre utiles</i>.
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001660_LIVINGWAY:1"
msgid "As I was saying─should you require any assistance with...whatever, we are at your disposal."
msgstr ""

#. ja: わたくしたちは、ハイデリン様の、<br>命への想いから創られたもの。<br>あなた方の道行きをサポートするのが役目であり歓びです。
#. de: Hydaelyn schuf uns aus ihrer unbändigen Liebe zum Leben. Und dem Wunsch, es zu schützen. Demnach ist es nicht nur unsere Pflicht, euch zu unterstützen, wo wir nur können, sondern vor allem ist es unser größtes Vergnügen.
#. fr: Hydaelyn nous a donné naissance dans son profond désir de protéger la vie. C'est donc notre mission de vous accompagner dans cette épreuve, mais aussi notre plus grande joie.
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001670_LIVINGWAY:1"
msgid "We were born from Hydaelyn's love for the lives of this star, so naturally we would much prefer to see them continue. Twiddling our thumbs up on the moon is hardly conducive to that, though, is it?"
msgstr ""

#. ja: けれど、遠い月から願うだけでは、<br>あなた方が感じ、考えること、望むことを理解しきれない。<br>ウリエンジェとたくさん話をして、それを痛感しましたわ。
#. de: Vom fernen Mond aus gestaltet sich das aber schwierig. Wie sollen wir je verstehen, was ihr fühlt, denkt und braucht, wenn wir so weit von euch entfernt sind? Je mehr wir uns mit Urianger unterhielten, desto schmerzlicher wurde uns das bewusst.
#. fr: Seulement, la distance entre la terre et la lune est telle qu'il nous est impossible de vraiment comprendre votre manière de penser, ou comment vous vivez. Nous l'avons vivement ressenti en écoutant Urianger.
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001680_LIVINGWAY:1"
msgid "Aye, not when you've all got such precious thoughts, and feelings, and hopes for the future, deserving of more active preservation. Speaking to Urianger made us realize that while we've carried out our duties to the letter, we've failed to fulfill them in spirit."
msgstr ""

#. ja: ですので、ひと思いにピョンっと！<br>どうかわたくしたちに学びの機会を……<br>そしてお困りごとがあるなら手伝わせてくださいませ！
#. de: Bitte, lasst die Idee einmal durch euren Kopf hopsen. Erlaubt uns, zu lernen. Euch zu verstehen. Und euch zu helfen, wo auch immer ihr auf Probleme stoßt.
#. fr: Nous avons toujours eu envie d'en savoir plus, donc c'était l'occasion rêvée<nbsp>! S'il vous plaît, permettez-nous d'apprendre à votre contact, et n'hésitez pas à nous demander quoi que ce soit<nbsp>!
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001690_LIVINGWAY:1"
msgid "From there it was just a hop, skip, and a jump towards resolving to do better! So please, show us how. Help us help you!"
msgstr ""

#. ja: 察するに、その者たちはもしや……？
#. de: Verzeiht, aber handelt es sich bei diesen Wesen um<nbsp>...
#. fr: Excusez-moi, mais... qui sont ces créatures<nbsp>?
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001700_FOURCHENAULT:1"
msgid "Forgive me, but are they...?"
msgstr ""

#. ja: おやフルシュノ様、お久しぶりです。<br>ええ、彼女たちこそ、月に住まうハイデリンの使者……<br>あなた方の「協力者」です。
#. de: Ah, Meister Fourchenault! Es ist lange her. Sie sind die Helfer Hydaelyns. Diejenigen, die Ihr Eure Unterstützer auf dem Mond nennt.
#. fr: Salutations, Messire Fourchenault. Je vous présente les Loporrites, vos collaborateurs de longue date sur la lune.
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001710_URIANGER:1"
msgid "Thy distant collaborators, indeed."
msgstr ""

#. ja: まあ、哲学者議会の方ですの？<br>やっとお会いできましたわね。
#. de: Oooh, seid Ihr jemand vom Rat der Philosophen? Wie aufregend, Euch endlich treffen zu können!
#. fr: Vous appartenez au Conseil de Sharlayan<nbsp>? Il y a tellement longtemps que je voulais vous rencontrer<nbsp>!
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001720_LIVINGWAY:1"
msgid "Hail fellow well met! You'd be a member of the Forum, would you? It's an honor and a pleasure to meet you at last."
msgstr ""

#. ja: わたくしはリヴィングウェイ。<br>ハイデリン様の右腕の、リヴィングウェイですわ！
#. de: Ich bin Livingway. Die rechte Hand Hydaelyns!
#. fr: C'est moi, Livingway<nbsp>! Le bras droit d'Hydaelyn<nbsp>!
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001730_LIVINGWAY:1"
msgid "I'm Livingway, Hydaelyn's right paw. That last bit is very important─as am I, if I may humbly say so myself."
msgstr ""

#. ja: あ、ああ……地上へようこそ、リヴィングウェイ殿。<br>哲学者議会は、あなた方を心から歓迎しよう。
#. de: V-Verstehe<nbsp>... Ich und der Rat der Philosophen heißen Euch und die Euren herzlich auf unserem Planeten willkommen, ehrenwerte Livingway.
#. fr: Aaah, mais bien sûr... Au nom du Conseil de Sharlayan, je vous souhaite la bienvenue sur terre.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001740_FOURCHENAULT:1"
msgid "I, er...bid you welcome to our star, Livingway. On behalf of the Forum, I thank you for traveling such a distance to meet us."
msgstr ""

#. ja: 実は、あなたの推察どおり、<br>月へと向かうための準備に手こずっていたのだ。<br>是非我らが本国へお越しいただき、ご意見を賜りたい。
#. de: Ihr lagt mit Eurer Einschätzung in der Tat sehr richtig. Bei unseren Vor<shy>bereitungen, zum Mond aufzubrechen, sind wir auf zahlreiche Schwie<shy>rig<shy>keiten gestoßen. Wir wären hocherfreut, wenn Ihr mit uns nach Sharlayan reisen und Euch der Sache annehmen würdet.
#. fr: Comme vous l'avez judicieusement deviné, nous rencontrons quelques difficultés pour préparer notre voyage vers la lune. J'aimerais d'ailleurs m'entretenir avec vous à ce sujet.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001750_FOURCHENAULT:1"
msgid "As you have surmised, preparations for the exodus have not proceeded as smoothly as we had hoped. I should be happy to personally escort you to our headquarters in Sharlayan, where you may advise us as you deem fit."
msgstr ""

#. ja: 皆さんが地上で抗う間、私が月という退路を確保する……<br>その役目を放棄したつもりはございません。
#. de: Während ihr um das Gestirn kämpftet, bemühte ich mich um den Mond als letzte Rettung. Dieser Pflicht habe ich mich noch nicht entbunden.
#. fr: Ne vous inquiétez pas, je n'ai nullement oublié ma promesse de rester sur la lune pour superviser la préparation de l'arche comme dernier recours.
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001760_URIANGER:1"
msgid "'Twas with reluctance that I set aside the great work of readying the moon for habitation. Be assured that I did so only after the Loporrits made plain their earnest desire to come hither, and I myself felt a growing certainty that their contributions here would prove invaluable."
msgstr ""

#. ja: されど、レポリットたちが地上に行きたいと言いだしたとき、<br>何かより良き結果が掴めるやもしれないと感じたのです。<br>その心に、従いました。
#. de: Doch als es die Loporrit nach unserem Planeten sehnte, tat sich eine Alternative vor mir auf. Und ich folgte meinem Herzen<nbsp>...
#. fr: Mais lorsque les Loporrites ont voulu visiter la terre, j'ai eu l'intime conviction que ce ne pourrait être que bénéfique. C'est dans l'intérêt supérieur de l'humanité que nous nous trouvons ici aujourd'hui.
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001770_URIANGER:1"
msgid "'Tis trite, perhaps, but...I followed my heart."
msgstr ""

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q2
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_Q2_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr ""

#. ja: おかえり、ウリエンジェ
#. de: Willkommen zurück, Urianger.
#. fr: Vous nous avez tant manqué, Urianger.
#. speaker: A2
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A2_000_001_NONE_VOICE:1"
msgid "Good to haveth you back!"
msgstr ""

#. ja: 月明輝いてるね、ウリエンジェ大先生
#. de: Auch du scheinst mir gerade mit Gleißen zu bersten, großer Urianger.
#. fr: Vos élèves ont bien progressé<nbsp>!
#. speaker: A2
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A2_000_002_NONE_VOICE:1"
msgid "May thy disciples banish this darkest of nights."
msgstr ""

#. ja: はい、ひとまずは……。<br>こうして皆さんの無事な様子を見られただけでも、<br>出向いた甲斐がありました。
#. de: Ich danke dir. Allein euch alle in guter Gesundheit zu sehen, bestärkt mich in meinem Entschluss.
#. fr: Je dois dire que je suis heureux de vous revoir tous en bonne santé. Je ne regrette pas d'avoir fait le voyage.
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001780_URIANGER:1"
msgid "For a time, at least. Nevertheless, 'twas worth the journey to find present company well."
msgstr ""

#. ja: フフ…
#. de: Heh<nbsp>...
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001790_URIANGER:1"
msgid "Report if displayed."
msgstr ""

#. ja: そのような称号をいただくには、<br>依然ふさわしくないと存じますが……<br>彼らにこの星のことを伝えられていたなら、嬉しいかぎりです。
#. de: Einen derartigen Titel habe ich längst nicht verdient. Dennoch freut es mich, dass ich mit meinen getreuen Beschreibungen so viel Begeisterung für unsere Heimat zu entfachen vermochte.
#. fr: Je n'ai aucunement la prétention d'être un professeur émérite, mais j'ai fait de mon mieux pour leur donner une description fidèle de notre planète.
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001800_URIANGER:1"
msgid "I am no esteemed philosopher of eld. Nevertheless, 'tis my hope that what little knowledge I shared shall serve them well, and perchance help save us all."
msgstr ""

#. ja: レポリットたちが哲学者議会に招かれている間、<br>どうかまた、ご一緒させてください。
#. de: Während die Loporrit in der Obhut des Rates der Philosophen verweilen, würde ich mich euch gern wieder anschließen.
#. fr: D'ailleurs, pendant que Livingway et les siens s'entretiendront avec le Conseil de Sharlayan, je serai plus qu'enchanté de me joindre à vous de nouveau.
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001810_URIANGER:1"
msgid "Wilt thou attend us at the Forum, and lend thine own wisdom?"
msgstr ""

#. ja: そうと決まれば、ウリエンジェが風邪をひく前に帰りましょ！<br>私もだんだん冷えてきたし……。
#. de: Dann lasst uns schnell nach Hause, bevor sich Urianger in seinem Gewändchen noch den Tod holt! Mir klappern inzwischen auch die Zähne, wenn ich ehrlich bin<nbsp>...
#. fr: Rentrons vite nous abriter avant qu'Urianger ne prenne froid. Moi-même, je commence à avoir les orteils gelés<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001820_ALISAIE:1"
msgid "If that's all quite settled, can we start moving before Urianger catches his death? Even I'm freezing out here."
msgstr ""

#. ja: 大丈夫、レポリットでぎゅうぎゅうの飛空艇は、<br>きっとあったかいさ。
#. de: Keine Sorge. Mit derart vielen Loporrit an Bord wird das Innere des Luftschiffes sicherlich lauschig warm.
#. fr: Ne t'en fais pas, on va bien se tenirrr chaud avec tous ces Loporrites à bord de l'aéronef.
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001830_GRAHATIA:1"
msgid "Oh, I daresay you'll warm up quickly once you're aboard the airship, sat shoulder to shoulder with our fur-covered friends."
msgstr ""

#. ja: ひとつ、皆に頼みがあるんだ。
#. de: Ich hätte einen Vorschlag an euch.
#. fr: Avant d'y aller, j'ai une faveur à vous demander.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001840_ALPHINAUD:1"
msgid "There is a matter I wish to raise with you before we enter."
msgstr ""

#. ja: これから哲学者議会の話を聞くことになるが、<br>場合によっては、彼らにさらなる提案をしてみたいと思う。<br>次の一手に繋げるようなね。
#. de: Je nachdem, wie viel uns der Rat gleich zu erzählen gewillt ist, würde ich ihnen gerne ein Angebot unterbreiten. Einen Handel, wenn man so will, der uns einen ordentlichen Schritt voranbringen dürfte.
#. fr: En fonction des révélations du Conseil, il se pourrait que je leur fasse une proposition importante pour la suite de nos projets.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001850_ALPHINAUD:1"
msgid "We are here to listen and to learn─but if the Forum's plans are more or less what I expect, then I should like to make a proposal that will serve our ends..."
msgstr ""

#. ja: それを、私に任せてもらえるだろうか……？
#. de: Seid ihr damit einverstanden, mir die Ver<shy>hand<shy>lungen diesbezüglich zu überlassen?
#. fr: Pourriez-vous me laisser mener la discussion<nbsp>? Faites-moi confiance, cela ne compromettra pas nos intérêts.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001860_ALPHINAUD:1"
msgid "By your leave, of course."
msgstr ""

#. ja: いいんじゃない。<br>もともと、アルフィノが機転を利かせて、<br>この機会を勝ち取ったんだしね。
#. de: Aber klar. Du warst es schließlich, der das hier überhaupt erst in die Wege geleitet hat.
#. fr: Aucune objection de ma part<nbsp>! Après tout, c'est toi qui as réussi à convaincre notre père de nous accorder cette audience.
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001870_ALISAIE:1"
msgid "I don't see why not. Your words and wits have gotten us this far."
msgstr ""

#. ja: アルフィノくんが考えを巡らせられるよう、<br>質疑はひとまず私の方で受け持つわ。
#. de: In dem Fall kann ich die Fragen über<shy>nehmen, die wir ihnen stellen wollen. Dann kannst du dich darauf konzentrieren, dir deine Argumente zurechtzulegen und auf den richtigen Augenblick zu warten.
#. fr: Je me chargerai des questions que nous nous posons tous, comme ça tu pourras mettre tes pensées en ordre et te concentrer sur ton in<shy>ter<shy>ven<shy>tion finale.
#. speaker: KRILE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001880_KRILE:1"
msgid "Agreed. I will present our queries so that you may consider the most advantageous way to advance your proposal without distraction."
msgstr ""

#. ja: ありがとう……。
#. de: Danke, Krile.
#. fr: Merci à vous tous...
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001890_ALPHINAUD:1"
msgid "Thank you, everyone."
msgstr ""

#. ja: あー、皆の者、静粛に！<br>ただいまより、臨時会を開催する。
#. de: Ich bitte um Ruhe im Saal! Die Sondersitzung des Rates ist hiermit eröffnet.
#. fr: Un peu de silence dans la salle<nbsp>! Je déclare ouverte cette session ex<shy>cep<shy>tion<shy>nelle.
#. speaker: BARNIER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001900_BARNIER:1"
msgid "If I may have your attention─the ad hoc session will now commence."
msgstr ""

#. ja: 今日は知ってのとおり、「暁の血盟」からの要請に応え、<br>我らが大撤収の計画を明かすこととなっている。
#. de: Wie bereits besprochen, nehmen wir uns heute dem Anliegen des Bundes der Morgenröte an, unsere Pläne um den Großen Exodus offenzulegen.
#. fr: Comme vous le savez, l'objet de cette réunion est l'exposition de notre projet de Grand Exode aux Héritiers de la Septième Aube, conformément à leur requête.
#. speaker: BARNIER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001910_BARNIER:1"
msgid "The purpose of today's assembly is to brief the Scions of the Seventh Dawn, at their request, on the great exodus."
msgstr ""

#. ja: さっそくだが、入ってきてくれ。
#. de: Bitte, tretet ein.
#. fr: Veuillez entrer, je vous prie.
#. speaker: BARNIER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001920_BARNIER:1"
msgid "You may enter."
msgstr ""

#. ja: 先んじて、君たちに感謝を伝えたい。<br>マグナ・グラキエスにて、ラザハンの民と我々の同胞を、<br>異形の獣から護ってくれたことについてだ。
#. de: Doch bevor ich zum eigentlichen Thema komme, möchte ich Euch unseren Dank aussprechen. Für Euer beherztes Eingreifen in Magna Glacies, das sowohl Geflüchtete als auch Landsleute rettete.
#. fr: Pour commencer, j'aimerais vous exprimer la recon<shy>nais<shy>san<shy>ce du Conseil. Vous avez fait preuve d'un courage admirable pour protéger nos compatriotes et les réfugiés hannois des bêtes qui les ont attaqués dans le Magna Glacies.
#. speaker: BARNIER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001930_BARNIER:1"
msgid "On behalf of the Forum, I commend your heroic actions on the Magna Glacies. We shall not soon forget your service to us and the people of Radz-at-Han."
msgstr ""

#. ja: 今しがたラザハンの太守にも報告をし、<br>君たちに深く感謝を表するとの伝言を預かった。
#. de: Ich soll Euch zudem vom Magistrat von Radz-at-Han ausrichten, dass er Euch zutiefst verbunden für Eure Hilfe ist.
#. fr: J'en ai d'ailleurs informé le satrape de Radz-at-Han, qui m'a demandé de vous remercier pour votre bravoure et votre abnégation.
#. speaker: BARNIER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001940_BARNIER:1"
msgid "The satrap, whom we have informed of the refugees' new arrangements, sings your praises as well."
msgstr ""

#. ja: 我々哲学者議会としても、本件を真摯に受け止め、<br>この場を用意させてもらった次第だ。<br>君たちの質問に、できるかぎり答えよう。
#. de: Als Ausdruck unseres Dankes möchte sich der Rat der Philosophen nun Eurem Anliegen annehmen. Diese Sondersitzung soll all Euren Fragen gelten und wir werden unser Äußerstes tun, sie nach bestem Wissen und Gewissen zu beantworten.
#. fr: Le Conseil juge la situation actuelle ex<shy>trê<shy>me<shy>ment préoccupante, et c'est la raison pour laquelle nous avons accepté de vous recevoir aujourd'hui. Nous sommes prêts à répondre à vos questions en toute transparence.
#. speaker: BARNIER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001950_BARNIER:1"
msgid "As an expression of our gratitude, we will endeavor to answer your questions as fully and openly as we are able."
msgstr ""

#. ja: では、まず前提を確認させてください。
#. de: Vielen Dank. So gestattet mir, bei den Grundlagen zu beginnen.
#. fr: Merci. Pour commencer, j'aimerais m'assurer que nous sommes sur la même longueur d'onde.
#. speaker: KRILE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001960_KRILE:1"
msgid "Then let us begin."
msgstr ""

#. ja: 哲学者議会の目的は、終末によって滅びゆくこの星を脱し、<br>人々と知識を月へと運ぶことで間違いありませんか？
#. de: Die erklärte Mission des Rates ist es, sowohl Bewohner als auch Wissen auf den Mond zu evakuieren - fort von diesem Planeten, der alsbald von einer Apokalypse verschlungen wird, richtig?
#. fr: Pouvez-vous nous confirmer que le but du Conseil de Sharlayan est d'organiser l'évacuation de l'humanité et de son savoir avant la destruction de la terre par l'apocalypse<nbsp>?
#. speaker: KRILE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001970_KRILE:1"
msgid "First─it is the Forum's objective to ferry the life and knowledge of this star to the moon. Am I correct?"
msgstr ""

#. ja: 相違ない……。<br>知の都シャーレアンは、長年、そのために活動をしてきたのだ。
#. de: Das ist korrekt. Als Stadt des Wissens arbeitet Sharlayan seit geraumer Zeit an diesem Vorhaben.
#. fr: Exactement. Depuis de longues années, c'est en préparation de cette éventualité que s'articulent les activités de notre cité.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001980_FOURCHENAULT:1"
msgid "You are. It is for this purpose that Sharlayan has labored these many long years."
msgstr ""

#. ja: 世界中から集め、ラヴィリンソスや大書院に蓄積した知識。<br>まずはそれを運び出す。
#. de: Besagtes Wissen wird aus der ganzen Welt zu<shy>sammen<shy>getragen und sowohl im Labyrinthos als auch im Noumenon verwahrt. Es zu bergen, ist der erste Schritt.
#. fr: La première étape de l'exode en lui-même est l'acheminement des con<shy>nais<shy>san<shy>ces du monde entier que nous avons accumulées dans le Labyrinthos et le Noumène.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_001990_FOURCHENAULT:1"
msgid "We have collected biological samples and scientific records from across the star. When the time comes, they will be moved from their places in Labyrinthos and Noumenon and conveyed to safety."
msgstr ""

#. ja: 並行して、シャーレアンの民をいくつかの組に分け、<br>月へと順次移送……住環境の確認と整備を開始する計画だ。
#. de: Gleichzeitig werden wir Sharlayans Bewohner in Gruppen teilen und sie nacheinander auf den Mond transportieren. Dort sollen sie die Wohn- und Lebensverhältnisse überprüfen und bei Bedarf verbessern.
#. fr: Dans le même temps, le peuple sharlayanais sera réparti en plusieurs groupes qui seront transportés l'un après l'autre sur la lune, pour en aménager l'environnement et s'y établir progressivement.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002000_FOURCHENAULT:1"
msgid "Once that critical task has been accomplished, we will begin transporting the Sharlayan citizenry, which has been categorized into groups. The earliest arrivals are to ensure hospitable environs for those who come after."
msgstr ""

#. ja: それらが落ち着き次第、我が国と協力関係にある国家から順に、<br>月へ案内していくという手はずになっている。
#. de: Sobald diese Grundlagen geschaffen sind, werden wir uns der Bevölkerung unserer verbündeten Nationen annehmen und sie nacheinander auf den Mond evakuieren.
#. fr: Puis, lorsque ce sera possible, nous prendrons en charge les populations de nos alliés pour les conduire jusqu'à l'arche et leur permettre de s'y installer.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002010_FOURCHENAULT:1"
msgid "Following our people, we will send those of other nations in turn, beginning with our allies."
msgstr ""

#. ja: ラザハンは、その最優先候補だった。<br>だが想定より早く終末の現象に見舞われたため、<br>どうにか前倒して移送できないかと試みたのだ。
#. de: Radz-at-Han stand bereits recht weit oben auf unserer Prioritätenliste. Doch die Letzten Tage brachen früher an als erwartet, und so wollten wir die Evakuierung Thavnairs vorziehen.
#. fr: Les Hannois devaient faire le voyage en priorité, mais les premières manifestations de l'apocalypse sont apparues plus tôt que nous le pensions. Nous avons donc tenté de hâter leur évacuation.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002020_FOURCHENAULT:1"
msgid "Radz-at-Han was foremost among these, but since the Final Days have already come to Thavnair, we saw fit to include the refugees with earlier groupings."
msgstr ""

#. ja: なるほど、壮大な計画ね。<br>この星のすべての民を運べる算段が立っているのかしら？
#. de: Ein Plan von beachtlichem Ausmaß<nbsp>... Glaubt ihr, alle Bewohner des Gestirns auf diese Art in Sicherheit bringen zu können?
#. fr: C'est un projet véritablement titanesque. Estimez-vous être en mesure de sauver toute l'humanité de cette façon<nbsp>?
#. speaker: YSHTOLA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002030_YSHTOLA:1"
msgid "An ambitious plan. You have accounted for the safety of all nations and tribes, then?"
msgstr ""

#. ja: ……可能な範囲で、だ。
#. de: ... Soweit es eben möglich ist.
#. fr: ... Dans la mesure du possible.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002040_FOURCHENAULT:1"
msgid "...As many as we can."
msgstr ""

#. ja: そしてその線引きは哲学者議会がすると。
#. de: Und was möglich ist, das entscheidet der Rat der Philosophen?
#. fr: Et c'est le Conseil qui décide ce qui est “possible”, n'est-ce pas<nbsp>?
#. speaker: YSHTOLA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002050_YSHTOLA:1"
msgid "And how, pray tell, do you decide who to leave behind?"
msgstr ""

#. ja: 別の星への移住は、史上類を見ないほど達成困難な任務だ。<br>志の異なる者を取り入れようとすれば、<br>そこから腐って全滅しかねない。
#. de: Der Exodus auf einen anderen Planeten ist das wohl schwierigste Unterfangen in der Geschichte dieser Welt. Verwenden wir unsere Kräfte darauf, Parteien mit anderen Ansichten und Plänen dennoch aufzunehmen, setzen wir seinen Erfolg aufs Spiel.
#. fr: Un exode d'une telle ampleur est un défi colossal, surtout à l'échelle interplanétaire. Prendre en compte des opinions extérieures et divergentes compromettrait sa réussite, ce que nous voulons éviter à tout prix.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002060_FOURCHENAULT:1"
msgid "To journey beyond the sky is an unprecedented and immeasurably difficult endeavor. Introducing sources of inevitable conflict would condemn all to certain death."
msgstr ""

#. ja: ……その是非は、一旦置いておきましょう。
#. de: ... Vertagen wir die Diskussion über das Für und Wider dieser Angelegenheit.
#. fr: ... Mettons de côté ce débat et passons à un autre sujet, si vous le permettez.
#. speaker: KRILE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002070_KRILE:1"
msgid "Questions as to the validity of that approach aside..."
msgstr ""

#. ja: 次に伺いたいのは、計画が順調に進んでいるかどうかです。<br>聞いたところによると、肝心の月への移送手段が、<br>まだ完成しきっていないとか……？
#. de: Ich möchte nun auf den aktuellen Stand des Projekts eingehen. Uns ist zu Ohren gekommen, dass der Schlüssel dieses Plans - nämlich das Transportmittel zum Mond selbst - noch gar nicht fertig ist?
#. fr: J'aimerais aborder l'état d'avancement actuel du projet. D'après mes in<shy>for<shy>ma<shy>tions, la question centrale du moyen de transport vers la lune n'est pas encore réglée. Qu'en est-il exactement<nbsp>?
#. speaker: KRILE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002080_KRILE:1"
msgid "Are your plans proceeding apace? We're under the impression that your primary means of celestial transportation is incomplete."
msgstr ""

#. ja: 要求する水準に至っていないという意味では、確かに未完成だ。
#. de: Nicht fertig in dem Sinne, dass es nicht mit der erforderlichen Leistung operiert, das ist korrekt.
#. fr: Dans la mesure où ce moyen de transport ne fonctionne pas encore con<shy>ve<shy>na<shy>ble<shy>ment, l'honnêteté exige d'admettre que ce problème reste en suspens.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002090_FOURCHENAULT:1"
msgid "If only in that it does not meet our optimal parameters, that is correct."
msgstr ""

#. ja: かねてより製造を進めてきた、月へ向かう船……<br>通称「方舟」は、一応の完成を見ている。
#. de: Das Schiff, an dem wir so lange gearbeitet haben<nbsp>... Die <i>Rettung</i>, wie wir sie getauft haben<nbsp>... Fertig ist sie sehr wohl.
#. fr: Le vaisseau que nous avons passé tant d'années à élaborer puis à construire peut être considéré comme achevé.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002100_FOURCHENAULT:1"
msgid "This ark, as some have taken to calling it, is fully operational and could be launched even today."
msgstr ""

#. ja: 想定外だったのは、終末の広がりがあまりに速いことだ。
#. de: Doch wir haben unterschätzt, wie schnell sich die Letzten Tage ausbreiten werden.
#. fr: Hélas, nous n'avions pas prévu que les effets de l'apocalypse se propageraient si rapidement au reste du monde.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002110_FOURCHENAULT:1"
msgid "However, the Final Days have progressed more quickly than we anticipated."
msgstr ""

#. ja: 現状の方舟の動力機関では、<br>航行速度が遅く、何より都度の補給にかかる時間が長すぎる。
#. de: Momentan erreicht der Antrieb dieses Schiffes nicht die benötigte Ge<shy>schwindig<shy>keit, und auch das Zuführen von Energie nimmt zu viel Zeit in Anspruch.
#. fr: Ce qui nous amène à la partie motrice de l'appareil. La technologie que nous utilisons ne nous permet pas d'atteindre la vitesse requise, et le ra<shy>vi<shy>tail<shy>le<shy>ment en carburant nécessite un temps trop important.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002120_FOURCHENAULT:1"
msgid "At present, the ship is incapable of attaining speeds sufficient to meet our evacuation targets."
msgstr ""

#. ja: 見切り発車で移送をはじめたところで、<br>往復数を稼げないうちに終末が拡大……<br>膨大な数の知識と命を、見捨てざるを得ないだろう。
#. de: Würden wir nun mit der Evakuierung beginnen, bräuchten wir für einen vollen Hin- und Rückflug viel zu lange. Niemals schaffen wir so genügend Flüge, um alles Leben und Wissen vor dem Untergang zu bewahren. Die Verluste wären immens.
#. fr: En l'état actuel des choses, nous sommes beaucoup trop lents pour faire suf<shy>fi<shy>sam<shy>ment d'allers-retours avant que l'apocalypse ne ravage toute la planète. Nous allons au-devant de pertes immenses, aussi bien humaines que matérielles.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002130_FOURCHENAULT:1"
msgid "Should we put the vessel into service as it is now, we will be unable to travel to the moon and back quickly enough to complete the necessary number of trips. Precious lives and knowledge will be lost."
msgstr ""

#. ja: そんな……何か手はないの？
#. de: Das<nbsp>... Gibt es denn gar nichts, was man tun kann?
#. fr: ... Il n'y a vraiment aucun moyen d'éviter ça<nbsp>?
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002140_ALISAIE:1"
msgid "Seven hells... Is there anything to be done?"
msgstr ""

#. ja: 星外での推進力を生み出す「エーテル縮退炉」、<br>その改良ができないか、今も試行錯誤が続いている。
#. de: Der Ätherantrieb, der die Reise zwischen den Sternen erst möglich macht, wird im Moment noch diversen Tests unterzogen. Das Ziel ist es, ihn dahingehend zu verbessern.
#. fr: Nous conduisons de nombreux tests pour tenter d'améliorer le réacteur à éthéro-dégénérescence, la partie du moteur qui sert à propulser le vaisseau dans l'espace.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002150_FOURCHENAULT:1"
msgid "The aetherburner─the primary means of propulsion once the craft is in the space between stars─is undergoing testing to determine whether it can be made more efficient."
msgstr ""

#. ja: 同時に第一陣の荷の積み込みも始めてはいるが……<br>限界まで、調整をするつもりだ。
#. de: Gleichzeitig haben wir damit begonnen, die erste Fracht zu laden. Aber auch hierbei muss die Obergrenze noch ausgelotet und angepasst werden.
#. fr: Le chargement des mar<shy>chan<shy>di<shy>ses a déjà commencé pour le premier voyage, mais nous avons l'intention de peaufiner nos réglages jusqu'au tout dernier moment.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002160_FOURCHENAULT:1"
msgid "Though cargo is being loaded for the initial phase of the exodus, we are prepared to continue our experimentation up to the day before launch should it prove necessary."
msgstr ""

#. ja: では、私たちと取引をするのはいかがでしょう。
#. de: Wie wäre es in diesem Fall mit einem Abkommen zwischen Sharlayan und dem Bund der Morgenröte?
#. fr: Dans ce cas, que diriez-vous de passer un marché avec les Héritiers de la Septième Aube<nbsp>?
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002170_ALPHINAUD:1"
msgid "What if the Scions were to solve your problem?"
msgstr ""

#. ja: 「暁の血盟」は、エーテル縮退炉の改良に協力します。<br>結果、それが必要な性能を上回るものになった場合、<br>ふたつの報酬をいただけないでしょうか。
#. de: Wir werden helfen, den Ätherantrieb zu verbessern. Haben wir damit Erfolg, so bitten wir Sharlayan um zwei Gegenleistungen.
#. fr: Nous pourrions vous aider à améliorer votre réacteur, en échange de quoi nous vous demanderions deux faveurs.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002180_ALPHINAUD:1"
msgid "We shall help devise a means to improve the aetherburner's efficiency─on two conditions."
msgstr ""

#. ja: ひとつ目は、ハイデリンと会わせてもらうこと……。
#. de: Erstens: Eine Unterredung mit Hydaelyn.
#. fr: La première serait de nous accorder une entrevue avec Hydaelyn.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002190_ALPHINAUD:1"
msgid "If we succeed, you must allow us to meet with Hydaelyn."
msgstr ""

#. ja: あなたたちとハイデリンの関係を思えば、<br>「逆さの塔」を放置しているのは奇妙だわ。
#. de: Wenn man euer enges Verhältnis zu der Göttin bedenkt, so ist es doch reichlich seltsam, dass Sharlayan den Antiturm einfach sich selbst und der Natur überließ.
#. fr: Compte tenu de vos relations avec Hydaelyn, nous trouvons par<shy>ti<shy>cu<shy>liè<shy>rement étrange que vous laissiez l'Antitour à l'abandon.
#. speaker: YSHTOLA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002200_YSHTOLA:1"
msgid "'Twas simple enough to deduce. You have a concord, and so you would never have abandoned the Antitower had you no other means of communication."
msgstr ""

#. ja: あるんでしょう？<br>かの塔に代わる、より良い別の手段が……。
#. de: Dafür kann es nur eine Erklärung geben: Man hat einen anderen Weg gefunden, Kontakt zu halten.
#. fr: Vous avez forcément découvert un moyen plus efficace de communiquer avec elle...
#. speaker: YSHTOLA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002210_YSHTOLA:1"
msgid "One far more convenient, I suspect."
msgstr ""

#. ja: そしてふたつ目が……<br>方舟を、誰が、どのように使うかを、<br>皆様に提案させていただきたいのです。
#. de: Zweitens würden wir dem Rat gerne einen Vorschlag unterbreiten, wie die <i>Rettung</i> eingesetzt wird - und von wem.
#. fr: Passons à notre seconde requête. Nous aimerions vous suggérer qui se servira de votre vaisseau, et de quelle façon.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002220_ALPHINAUD:1"
msgid "The second condition, also to be met upon our success, is that we be permitted to propose another use for your ark."
msgstr ""

#. ja: 「提案」か？　命令ではなく……。
#. de: Einen Vorschlag? Keine Forderung?
#. fr: Une “suggestion”<nbsp>? Cela implique que nous ne sommes pas dans l'obligation de l'accepter.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002230_FOURCHENAULT:1"
msgid "We would be at liberty to refuse this proposal?"
msgstr ""

#. ja: ここにいる、たった99人さえ納得させられない提案なら、<br>この窮地に貫くべきではありません。
#. de: Nun, wenn jener Vorschlag nicht einmal den Zuspruch von 99 Ratsmitgliedern erhält, ist uns das Beweis genug. Dann ist er unbrauchbar.
#. fr: Exactement. Si notre proposition ne parvient pas à convaincre les quatre-vingt-dix-neuf membres du Conseil, ce sera la preuve qu'elle n'est pas pertinente.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002240_ALPHINAUD:1"
msgid "Of course. If we cannot prove its merit to the ninety-nine here, who are we to stake on it the lives of all peoples of this star?"
msgstr ""

#. ja: フォフォフォ……いや、おもしろい！
#. de: Hahaha<nbsp>... Wie überaus interessant!
#. fr: Ho ho ho... Voilà qui s'annonce intéressant<nbsp>!
#. speaker: MONTICHAIGNE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002250_MONTICHAIGNE:1"
msgid "Hahaha! Delightful as always, Master Alphinaud!"
msgstr ""

#. ja: フォフォフォ
#. de: フォフォフォ
#. speaker: MONTICHAIGNE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002255_MONTICHAIGNE:1"
msgid "Report if displayed."
msgstr ""

#. ja: その道の専門家たちが頭を抱えている難問に、<br>行きずりの者たちが挑むときた！<br>フォフォ、なんと無茶で無謀なことよ！
#. de: Ein bunter Haufen junger Weltenbummler will sich einem Problem stellen, an dem sich selbst die klügsten Köpfe Sharlayans die Zähne ausbeißen? Wie wunderbar unerhört!
#. fr: Une équipe de nouveaux venus qui s'attaque à un casse-tête technologique sur lequel nos plus éminents spé<shy>cia<shy>listes planchent depuis des années. C'est aussi absurde qu'excitant<nbsp>!
#. speaker: MONTICHAIGNE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002260_MONTICHAIGNE:1"
msgid "We couldn't have asked for a finer plan. “Allow us to solve this complex engineering problem of which we were entirely unaware until moments ago. What could possibly go wrong?” Haha! The satire writes itself!"
msgstr ""

#. ja: ニィ
#. de: Hihi
#. speaker: MONTICHAIGNE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002265_MONTICHAIGNE:1"
msgid "Report if displayed."
msgstr ""

#. ja: じゃが、行き詰まった研究に必要なのは、<br>嫌というほど見返した理論より、<br>ちょっとしたひらめき……新しい風じゃろうて。
#. de: Aber genau das braucht der Wissenschaftler, wenn er in einer Sackgasse steckt! Neue Inspiration und selbst<shy>verständ<shy>lich frischen Wind, um den Muff der alten Theorien zu vertreiben.
#. fr: C'est exactement ce qu'il faut à nos scien<shy>ti<shy>fi<shy>ques. Un vent nouveau qui les ferait dévier de leurs vieilles théories surannées et sortir de l'impasse dans laquelle ils se trouvent.
#. speaker: MONTICHAIGNE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002270_MONTICHAIGNE:1"
msgid "Yet what field has not benefited from a change in perspective? When we are at wits' end, what we need is not the same dry theories recited ad nauseam, but fresh inspiration."
msgstr ""

#. ja: わしは、かつての教え子たちに賭ける。<br>彼らとの取引に「賛成」じゃ。
#. de: Ich persönlich setze große Hoffnungen auf meine einstigen Schüler. Und stimme für das Abkommen.
#. fr: J'ai bon espoir d'être agré<shy>a<shy>ble<shy>ment surpris par mes anciens élèves, et je vote en faveur de leur proposition.
#. speaker: MONTICHAIGNE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002280_MONTICHAIGNE:1"
msgid "I, for one, have faith in my erstwhile students to provide it. And I find their terms to be perfectly acceptable."
msgstr ""

#. ja: あー、静粛に！　静粛に！<br>今は一秒すら惜しい、さっそく決を採るとしよう。
#. de: Ruhe! Ruuuhe! Es zählt jede Sekunde.
#. fr: Silence dans la salle<nbsp>! Le temps nous est compté, et nous devons décider d'une issue le plus vite possible.
#. speaker: BARNIER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002290_BARNIER:1"
msgid "Order! Order! We have no time to waste on debate. I call a vote."
msgstr ""

#. ja: では、「暁の血盟」との取引に賛成の者は挙手を！
#. de: Alle, die für das vorgeschlagene Abkommen mit dem Bund der Morgenröte sind, mögen bitte die Hand heben!
#. fr: Que ceux qui veulent accepter les conditions des Héritiers de la Septième Aube lèvent la main<nbsp>!
#. speaker: BARNIER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002300_BARNIER:1"
msgid "All in favor of agreeing to the Scions' terms?"
msgstr ""

#. ja: 賛成71、反対28……<br>決まったな、彼らの申し出を受け入れよう。
#. de: Ich zähle 71 Stimmen dafür und 28 dagegen. Damit ist es beschlossen: Sharlayan nimmt das Angebot an.
#. fr: Je compte soixante et onze voix pour, vingt-huit contre... C'est un résultat sans appel, la proposition est acceptée par le Conseil.
#. speaker: BARNIER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002310_BARNIER:1"
msgid "Seventy-one in favor, twenty-eight against. The ayes have it."
msgstr ""

#. ja: フルシュノ氏、計画の責任者たる君が彼らを案内するように。<br>個人としては異論もあろうが、<br>議会の決定として、しかと遂行していただきたい。
#. de: Ratsmitglied Fourchenault, als Kopf des Exodus-Projektes untersteht der Bund der Morgenröte Eurer Verantwortung. Der Rat verlässt sich darauf, dass Ihr Euch nicht durch persönliche Einwände von Euren Pflichten abhalten lasst.
#. fr: Messire Fourchenault Leveilleur, en qualité de dirigeant du projet de Grand Exode, c'est à vous que revient la res<shy>pon<shy>sa<shy>bi<shy>li<shy>té de guider ces gens. J'espère que vos objections per<shy>son<shy>nelles n'entraveront pas votre devoir de conseiller.
#. speaker: BARNIER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002320_BARNIER:1"
msgid "Fourchenault, as the architect of this project, you are the best candidate to show them its current state. ...And bear in mind that, regardless of your personal misgivings, this is the will of the Forum."
msgstr ""

#. ja: ……承知いたしました。
#. de: ... Ihr habt mein Wort.
#. fr: ... Naturellement.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002330_FOURCHENAULT:1"
msgid "Very well."
msgstr ""

#. ja: では、此度の臨時会は終了とする！<br>終わりのときまで時間がない……<br>各自、己の責務をしっかりと果たすように！
#. de: Damit ist die heutige Sondersitzung geschlossen! Eines noch: Die Zeit läuft uns davon. Widmet Euch Euren Aufgaben und gestattet keinerlei Ablenkungen!
#. fr: Mesdames et Messieurs, la séance est levée<nbsp>! Nous sommes près du but, aussi je vous demande de vous mettre im<shy>mé<shy>dia<shy>te<shy>ment au travail<nbsp>!
#. speaker: BARNIER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002340_BARNIER:1"
msgid "I call this session to a close. Return to your tasks with urgency─the Final Days wait for none."
msgstr ""

#. ja: あっちのパーツを変えてみるか……？<br>いや、ねぇな、あそこはもうイジらん方がいい……。
#. de: Mmmmmh<nbsp>... Liegt es vielleicht an der Kabelführung? Nein, nein. Lieber nicht mehr dran herumfummeln.
#. fr: Voyons voir... Peut-être qu'en décalant cette valve... Non, j'ai déjà à peine la place de placer le joint...
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002350_KOKKOLDANKKOL:1"
msgid "I could swap 'em out... No─been there, done that, damn near lost me eyebrows..."
msgstr ""

#. ja: だぁぁ、クソ！<br>どうにかしろでどうにかできたら、<br>今ごろ人は宇宙の果てにだってヒトッ飛びだったろうよ！
#. de: Gaaah, verdammt noch eins! Wir sollten schon längst am anderen Ende des Universums sein!
#. fr: Aaah, bon sang, c'est pas vrai<nbsp>! C'est pas comme ça qu'on va réussir à envoyer ces gens dans l'espace en temps et en heure<nbsp>!
#. speaker: KOKKOLDANKKOL
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002360_KOKKOLDANKKOL:1"
msgid "Think, Kokkol, think! We'd be well on our way to paradise, visionaries pattin' themselves on the backs for their grand accomplishments if you'd only <i>think</i>!"
msgstr ""

#. ja: ……取り込み中すまない、ククロ・ダンクロ殿。
#. de: ... Meister Kokkol, bitte verzeiht die Störung.
#. fr: Désolé de vous interrompre, Messire Kokkol.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002370_FOURCHENAULT:1"
msgid "Yes... That does sound rather lovely..."
msgstr ""

#. ja: うひゃぁ！？　フルシュノの旦那！？<br>なななんだよ大勢揃って、いよいよ納期だってか！？
#. de: Uaaargh, Fourchenault! Was ist? Und was sollen die ganzen Leute hier? Sag bloß, das ist schon die erste Fuhre?!
#. fr: Aaah, Monsieur Fourchenault, qu'est-ce que vous faites là<nbsp>!? Pourquoi il y a tant de monde, tout à coup<nbsp>!? Ne me dites pas que le délai est déjà écoulé<nbsp>!
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002380_KOKKOLDANKKOL:1"
msgid "Gyaaah! ...I mean, Master Fourchenault, what a pleasant surprise! We're not blastin' off already, are we!?"
msgstr ""

#. ja: いや、予定については変わりない。<br>あまり時間が残されていないという点でもな。
#. de: Am Flugplan hat sich nichts geändert, auch wenn uns die Zeit davonläuft.
#. fr: Non, ne vous en faites pas. Même si nous sommes pressés par le temps, notre calendrier demeure inchangé.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002390_FOURCHENAULT:1"
msgid "The schedule remains unchanged. For better or worse..."
msgstr ""

#. ja: 今回は、哲学者議会の意向で、<br>エーテル縮退炉の改良に協力したいという者たちを連れてきた。
#. de: Heute will ich dir eine Gruppe Individuen vorstellen, die auf Geheiß des Rates bei der Verbesserung des Ätherantriebs helfen sollen.
#. fr: Les personnes qui m'ac<shy>com<shy>pa<shy>gnent sont ici pour vous aider à améliorer le réacteur à éthéro-dégénérescence, avec l'aval du Conseil.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002400_FOURCHENAULT:1"
msgid "Which is why the Forum has elected to accept assistance in resolving the aetherburner conundrum."
msgstr ""

#. ja: ほーん、界隈で見た覚えのねぇ顔だな。
#. de: Helfen sollen sie? So, so. Die hab ich ja noch nie gesehen.
#. fr: Ils sont nouveaux dans la profession<nbsp>? Leur tête me dit rien.
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002410_KOKKOLDANKKOL:1"
msgid "Huh. Not seen you lot down here before."
msgstr ""

#. ja: 実際、賢人も混じってはいるが、この分野の専門ではない。<br>何かの突破口になればとのことだが、<br>仕事の邪魔になるくらいなら、追い出してもいい。
#. de: Einige von ihnen sind Exegeten, niemand von ihnen ist jedoch auf dein Fachgebiet spezialisiert. Trotz alledem glauben sie, den lang ersehnten Durchbruch erreichen zu können. Zögere aber nicht, sie deiner Werkstatt zu verweisen, sollten sie dich zu sehr bei der Arbeit stören.
#. fr: À vrai dire, même si certains d'entre eux sont des Preux, aucun n'est spécialisé dans votre domaine d'expertise. Nous espérons qu'ils vous permettront d'avancer, mais s'ils vous gênent, n'hésitez pas à les congédier.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002420_FOURCHENAULT:1"
msgid "There are Archons among their number, but engineering is not their expertise. Nevertheless, the Forum concedes the slim possibility that they may have insights to offer. If not, you are at liberty to return them to the surface...by whatever means you see fit."
msgstr ""

#. ja: そうならないように、最善を尽くしましょう。<br>……さっそくですが、エーテル縮退炉について伺っても？
#. de: So weit werden wir es nicht kommen lassen, das versichere ich Euch. Würdet Ihr uns etwas zu besagtem Ätherantrieb erzählen?
#. fr: Nous allons bien sûr faire notre possible pour vous aider dans votre travail. Pour commencer, pourriez-vous nous en dire plus au sujet de ce fameux réacteur<nbsp>?
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002430_ALPHINAUD:1"
msgid "I assure you that won't be necessary. Now, about your troubles with the aetherburner...?"
msgstr ""

#. ja: ああ、構わねぇぜ、息抜きがてらにな。
#. de: Äh, sicher, sicher. Ich sollte ohnehin eine Pause machen.
#. fr: Pas de problème. Ça tombe bien, j'avais justement besoin de m'aérer les neurones.
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002440_KOKKOLDANKKOL:1"
msgid "Aye, aye, I'll walk you through it. S'pose I could do with a change of pace."
msgstr ""

#. ja: 方舟に搭載される動力機関……<br>エーテルを宇宙航行のための推進力に換えるのが、<br>俺たちの作ってるエーテル縮退炉だ。
#. de: Also. Der Ätherantrieb unserer Arche soll, wie sein Name schon mehr als deutlich verrät, puren Äther in Schubkraft konvertieren. Diese brauchen wir, um im Weltall überhaupt ordentlich von der Stelle zu kommen.
#. fr: Sans entrer dans les détails les plus complexes, le réacteur à éthéro-dégénérescence est la partie de notre vaisseau qui convertit l'éther en force de poussée pour lui permettre de se déplacer.
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002450_KOKKOLDANKKOL:1"
msgid "As the name ought to tell you, the aetherburner “burns” aether─ambient or otherwise─and transforms it into motive force. Think of it like a giant bomb that never stops explodin'."
msgstr ""

#. ja: 地上に比べて、星外はエーテルが乏しい。<br>それでもしっかり方舟を動かし、<br>月と行き来させられるスグレモノだ！
#. de: Unser eigener Planet mag reich an Äther sein, aber das All ist es nicht. Trotzdem muss die <i>Rettung</i> zuverlässig zwischen hier und dem Mond hin- und herfliegen können.
#. fr: L'éther est beaucoup moins abondant dans l'espace qu'à la surface de notre planète. Mais grâce à la technologie qu'on a développée, notre appareil est capable de faire l'aller-retour terre-lune.
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002460_KOKKOLDANKKOL:1"
msgid "Even out in that black void where the aether's right sparse, it's strong enough to move our ark. And it probably won't kill you like an actual bomb!"
msgstr ""

#. ja: ……が、まだ性能が足りねぇときた。
#. de: Und das ist des Kobalos' Kern<nbsp>...
#. fr: Le problème, c'est qu'il est encore beaucoup trop lent...
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002470_KOKKOLDANKKOL:1"
msgid "...But it ain't perfect."
msgstr ""

#. ja: 計算上、あと6％ほどエーテル伝導率を上げられりゃ、<br>哲学者議会に要求されてるだけ往復時間を短縮できる。
#. de: Meinen Berechnungen zufolge müssen wir die ätherische Leitfähigkeit um 6<nbsp>Prozent steigern. Nur so können wir die vom Rat verlangte Zahl der Rundflüge in der uns verbleibenden Zeit bewerkstelligen.
#. fr: D'après mes calculs, en augmentant le taux de conductivité éthéréenne de six pourcent, on pourrait atteindre la vitesse nécessaire pour faire le voyage aussi rapidement que l'exige le Conseil.
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002480_KOKKOLDANKKOL:1"
msgid "Accordin' to my calculations, to travel to the moon and back fast enough for the Forum's likin', the conversion rate needs to be six percent more efficient."
msgstr ""

#. ja: たかが6％、されど6％だ！<br>最高の素材と最良の設計で縮退炉の製造にあたってる以上、<br>そう簡単に数字は上がらねぇんだよ……！
#. de: Nur 6 Prozent, sagt ihr jetzt vielleicht, aber ich sage: ganze 6 Prozent! Sowohl das verbaute Material als auch der strukturelle Aufbau des Antriebs sind bereits bis auf das Äußerste optimiert. Woher sollen wir also noch diese verflixten 6 Prozent nehmen?!
#. fr: Six pourcent, ça paraît peu comme ça<nbsp>! Mais quand on utilise les meilleurs matériaux pour chaque pièce, quand on a optimisé ses plans des centaines de fois, laissez-moi vous dire que c'est une véritable montagne<nbsp>!
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002490_KOKKOLDANKKOL:1"
msgid "“A measly six percent,” you say, but if I could've squeezed even another “point six” out of it, don't you think I'd've built it that way in the first place!?"
msgstr ""

#. ja: レポリットたちには、もう相談したのですか？
#. de: Habt Ihr die Loporrit bereits um Rat gefragt?
#. fr: Avez-vous sollicité l'avis des Loporrites à ce sujet<nbsp>?
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002500_URIANGER:1"
msgid "Hast thou consulted with the Loporrits?"
msgstr ""

#. ja: ああ、彼らの技師も検討をしてくれているが、<br>すぐには解決策が出せそうもないようだ。
#. de: Haben wir. Ihre Ingenieure haben sich der Sache angenommen, aber selbst sie meinten, dass die Lösung dieses Problems einige Zeit in Anspruch nehmen wird. Zeit, die wir nicht haben.
#. fr: Bien sûr. Ils travaillent comme nous d'arrache-pied sur le problème. Seulement, ils ne semblent pas être en mesure de trouver une solution dans l'immédiat.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002510_FOURCHENAULT:1"
msgid "Yes. They too are conducting their own research, for lack of a ready answer."
msgstr ""

#. ja: レポリットの船である月は、高性能の動力機関を有している。<br>しかしそれは、広大な月内部を使えるからこその、<br>とてつもなく大きなものだという……。
#. de: Die Arche der Loporrit, sprich der Mond, hat einen weitaus leistungsstärkeren Antrieb und trifft damit gar nicht erst auf derartige Schwie<shy>rig<shy>keiten. Diese Schubkraft erreicht sie allerdings auch nur, weil besagter Antrieb das komplette Innere des Mondes ausfüllt.
#. fr: L'arche des Loporrites possède elle-même un puissant système de propulsion, mais il n'existe que grâce à l'immense espace qui lui est dédié au cœur de la lune.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002520_FOURCHENAULT:1"
msgid "The moon's propulsion systems are considerable, naturally, yet they are commensurately massive."
msgstr ""

#. ja: 我々の……彼らに言わせれば「小さな玩具の方舟」に、<br>その技術を転用するのは難しい。
#. de: Diese Technologie auf unsere<nbsp>... „Winzarche“ zu münzen, wie sie die <i>Rettung</i> bezeichnen, gestaltet sich wohl als äußerst schwierig.
#. fr: Adapter un tel dispositif à l'échelle de notre vaisseau est inconcevable dans leur esprit, puisque, pour reprendre leurs mots, “il est à peine plus gros qu'un jouet”.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002530_FOURCHENAULT:1"
msgid "It is no easy feat to convert their technology into an efficient means of propulsion for a “teeny-tiny toy boat,” as they say─and as I most certainly do not."
msgstr ""

#. ja: はぁぁ、もう、どうしろってんだ！<br>そういう無茶を言うときは、<br>せめてエクスアダマントを手土産にしてほしいぜ！
#. de: Es ist zum Verzweifeln! Kein Ansatz scheint auch nur annähernd Erfolg versprechend! He, ihr. Wenn ihr wirklich helfen wollt, dann organisiert mir Edel-Adamantit.
#. fr: Aaah<nbsp>! J'vous le dis, c'est mission impossible<nbsp>! Vous êtes bien gentils de venir m'aider, mais à moins que vous ayez de l'<i>exadamantium</i> dans vos sacs, c'est peine perdue<nbsp>!
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002540_KOKKOLDANKKOL:1"
msgid "Yes, exactly! Damn it all, I ask for refined adamantite and they send me uppity rabbits with inscrutable, ancient, incompatible technology... You tryin' to drive me mad?"
msgstr ""

#. ja: エクスアダマントって……アラグのか？
#. de: Edel-Adamantit? Das der Allager?
#. fr: De l'exadamantium...<nbsp>? Comme on pouvait en trrrouver à Allag<nbsp>?
#. speaker: GRAHATIA
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002550_GRAHATIA:1"
msgid "Do you speak of <i>Allagan</i>-refined adamantite, perchance?"
msgstr ""

#. ja: あなた、何か知っているの？
#. de: Weißt du etwas darüber, Raha?
#. fr: Ça te dit quelque chose<nbsp>?
#. speaker: YSHTOLA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002560_YSHTOLA:1"
msgid "You know of it?"
msgstr ""

#. ja: ああいや、詳細までは……。<br>アラグ帝国で生み出された金属なんだが、製造法が門外不出で、<br>「秘されし金属」なんて呼ばれてたらしい。
#. de: Leider sind mir nur sehr allgemeine Informationen bekannt. Es wurde im Allagischen Kaiserreich erschaffen. Allerdings hielt man seine Herstellungsmethode streng unter Verschluss, weshalb es auch oft „verborgenes Metall“ genannt wurde.
#. fr: Il s'agit d'un alliage créé par les Allagois. Son procédé de fabrication a toujours baigné dans le mystèrrre, si bien qu'on le qualifiait parfois de “métal miracle”.
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002570_GRAHATIA:1"
msgid "Only in the most general terms, I'm afraid. 'Twas an alloy of Allagan make, but the secrets of its production were closely guarded."
msgstr ""

#. ja: かの帝国においては、ダラガブの製造に用いられたり、<br>宇宙進出の要を担ったって、記録で見たことがある。
#. de: Es ist nicht nur in Teilen Dalamuds zu finden. Diverse Auf<shy>zeich<shy>nun<shy>gen sprechen auch davon, dass es eine Schlüsselrolle bei der Erschließung des Alls gespielt hat.
#. fr: À l'époque, l'empire d'Allag s'en est serrrvi pour construire Dalamud, et son utilisation est mentionnée dans divers rapports sur sa conquête spatiale.
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002580_GRAHATIA:1"
msgid "As I recall, the records stated it was vital to Dalamud's construction and launch."
msgstr ""

#. ja: そう、そいつだ、そのエクスアダマントだよ！<br>現代においては完全に失われた、<br>未知の冶金技術で作られた素材なんだ！
#. de: Ah! Genau! Ganz genau das! Edel-Adamantit, gegossen aus ge<shy>heim<shy>nis<shy>vol<shy>len metallurgischen Künsten, die gemeinsam mit den Allagern unwiederbringlich verschwunden sind!
#. fr: Ouais, c'est ça<nbsp>! L'exadamantium<nbsp>! Un métal légendaire né de techniques aujourd'hui oubliées et qui est devenu quasiment introuvable<nbsp>!
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002590_KOKKOLDANKKOL:1"
msgid "Aye, that's the stuff! No material more conductive far as I know. Slottin' some in's like blowing up a dam and watching the river of aether come rushing through!"
msgstr ""

#. ja: エーテル伝導率が、もンのすごくてな……！<br>今のエーテル縮退炉にも、少量だが使ってるんだ。
#. de: Seine ätherische Leitfähigkeit ist phänomenal und stellt alles Vergleichbare in den Schatten! In unserem Ätherantrieb selbst habe ich eine winzige Menge dieses Wundermetalls verbaut.
#. fr: Parmi ses propriétés supérieures, je vous le donne en mille... C'est un supra-conducteur pour l'éther<nbsp>! Je suis bien placé pour le savoir, j'en ai utilisé un peu pour le réacteur.
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002600_KOKKOLDANKKOL:1"
msgid "Ain't a living soul that knows how to make it, though."
msgstr ""

#. ja: ほら、第七霊災の折に、ダラガブが飛び散っただろ？<br>たまたま北洋にポチャンとした破片を引き上げて、<br>そこから取り出したってわけよ。
#. de: Wir sind im Nordmeer zufällig über ein Stück von Dalamud gestolpert und haben es natürlich sofort an Land gezogen. Seit der Siebten Katastrophe hat dieser Schatz unentdeckt in den Tiefen geschlummert!
#. fr: Où je l'ai trouvé<nbsp>? Dans un morceau de structure de Dalamud qu'on a renfloué dans les mers du Nord. Il dormait sûrement là-bas depuis la fin du septième fléau, quand le satellite a volé en éclats.
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002610_KOKKOLDANKKOL:1"
msgid "We were fortunate enough to salvage some for the aetherburner─just a wee bit, mind─from a chunk of Dalamud that came hurtlin' into the Northern Empty during the Calamity."
msgstr ""

#. ja: あのエクスアダマントが、たくさん手に入りゃ、<br>伝導率の6％向上も夢じゃないんだがな……。
#. de: Wenn wir noch mehr davon in die Finger bekämen<nbsp>... Tja, dann sähen 6<nbsp>Prozent plötzlich überhaupt nicht mehr wie ein Fiebertraum aus.
#. fr: Si je pouvais mettre la main sur un bon paquet de cet exadamantium, ce serait un jeu d'enfant d'atteindre les six pourcent qui nous manquent, croyez-moi.
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002620_KOKKOLDANKKOL:1"
msgid "With more...well, that extra six percent efficiency would be child's play. It's a cryin' shame that we've no other sources."
msgstr ""

#. ja: ダラガブの破片なら、<br>ほかにもエオルゼア各地に刺さってると思うけど……<br>そこからは回収しないの？
#. de: Dalamuds Splitter sind quer über Eorzea verteilt. Die sollten sich doch mühelos aufspüren und bergen lassen?
#. fr: Il y a des morceaux de l'épave de Dalamud éparpillés à travers tout Éorzéa. Pourquoi vous n'iriez pas vous servir<nbsp>?
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002630_ALISAIE:1"
msgid "Surely the many shards of Dalamud scattered throughout Eorzea would suffice. Why not get the refined adamantite from them?"
msgstr ""

#. ja: グリーナーに依頼は出してある。<br>だが、エクスアダマントが使われているのは、<br>ダラガブの中でもごく一部……
#. de: Natürlich haben wir schon unsere Klauber darauf angesetzt, ja. Aber Edel-Adamantit wurde nur in sehr spezifischen Teilen Dalamuds verwendet.
#. fr: On a déjà envoyé les glaneurs en chercher, tu penses bien<nbsp>! Mal<shy>heu<shy>reu<shy>se<shy>ment c'est pas si simple, l'exadamantium est utilisé qu'en certains endroits précis dans la structure du satellite.
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002640_KOKKOLDANKKOL:1"
msgid "Oh we tried, believe you me. But only a few specialized pieces would've had any in 'em to begin with."
msgstr ""

#. ja: トゲのように突き立った巨大装置、<br>いわゆる「ラグナロク級拘束艦」の動力部なんだよ。
#. de: In dem gigantischen Motor der Verkeilungsschiffe vom Typ Ragnarök, nämlich, der wie ein Stachel aus ihnen herausragt.
#. fr: C'est uniquement dans ses protubérances semblables à des épines géantes qu'on peut en trouver. Plus précisément, il s'agit de l'unité motrice des vaisseaux de classe Ragnarok.
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002650_KOKKOLDANKKOL:1"
msgid "Drive cores from Ragnarok-class internment hulks─those are the prize bits we really need."
msgstr ""

#. ja: 調査によると、そこへ辿り着くには、<br>数々の防衛機構ひしめくダラガブ片の内部を、<br>踏破しなきゃならんそうだ。
#. de: Doch an den Teil mit dem Edel-Adamantit gelangt man laut unserer Nach<shy>for<shy>schungen nur, wenn man sich durch das Innere eines dieser Schiffe schlägt. Und das ist mit unzähligen Abwehrmechanismen gespickt.
#. fr: D'après les éclaireurs qui ont inspecté le terrain, il faut s'aventurer au plus profond de la carcasse pour atteindre le métal, et l'endroit est infesté de dispositifs de sécurité allagois.
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002660_KOKKOLDANKKOL:1"
msgid "But accordin' to the gleaners, gettin' to 'em means delvin' deep into the shards─and the defenses are still very operational and very eager to blow 'em up."
msgstr ""

#. ja: 凄腕のグリーナーをかき集めたって、<br>そうそうできる芸当じゃねぇ……。
#. de: Selbst die talentiertesten Klauber laufen durchaus Gefahr, sich an einem derartigen Unterfangen die Zähne auszubeißen<nbsp>...
#. fr: Même pour une équipe de glaneurs triés sur le volet, je vous garantis que ça se fait pas en un claquement de doigts.
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002670_KOKKOLDANKKOL:1"
msgid "It's rough goin' in there, even for the cream. Not sure they'd make it out alive..."
msgstr ""

#. ja: ……ってそれ、バハムートを消滅させるために、<br>私たちが行ったあたりよね？
#. de: Klingt wie der Ort, an dem wir uns mit Bahamut angelegt haben, findest du nicht?
#. fr: Il parle de l'endroit où on est allés pour détruire Bahamut, non<nbsp>?
#. speaker: ALISAIE
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002680_ALISAIE:1"
msgid "...Weren't we near that part of the <i>Ragnarok</i> when we went to destroy Bahamut?"
msgstr ""

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q3
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_Q3_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr ""

#. ja: 自分が行ってこようか……？
#. de: Kein Problem, dann gehe eben ich.
#. fr: Vous voulez que je m'en charge<nbsp>?
#. speaker: A3
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A3_000_001_NONE_VOICE:1"
msgid "You want me to go and fetch the wotsits?"
msgstr ""

#. ja: ネールが……ネールがいないなら……
#. de: Uargh<nbsp>... Solange Nael nirgendwo mehr herumgeistert<nbsp>...
#. fr: Tant qu'il n'y a plus cette Nael possédée...
#. speaker: A3
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A3_000_002_NONE_VOICE:1"
msgid "The White Raven's ghost...it haunts me..."
msgstr ""

#. ja: 誰かに頼もう
#. de: Irgendjemand wird sich schon finden.
#. fr: Ça a l'air un peu trop coton à mon goût.
#. speaker: A3
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A3_000_003_NONE_VOICE:1"
msgid "This sounds like a job for someone else."
msgstr ""

#. ja: 確かに、あなたの実力なら申し分ないと思うけれど……。
#. de: Die Heraus<shy>forde<shy>rung, der du dich nicht sofort stellen willst, muss erst noch gefunden werden, was?
#. fr: C'est vrai que ce serait sûrement du gâteau pour toi.
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002690_ALISAIE:1"
msgid "That may be for the best...though you'd doubtless find the task too dull for your liking."
msgstr ""

#. ja: だ、大丈夫！？<br>でも、そうよね、激戦だったものね……。
#. de: Dass dir gerade das bis heute in den Knochen steckt, sagt auch viel aus<nbsp>...
#. fr: Hé, ça va<nbsp>!? Quand j'y repense, c'est vrai que t'en avais bavé.
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002700_ALISAIE:1"
msgid "Heavens, are you alright? You look pale as a...well!"
msgstr ""

#. ja: 今はあまり深く思い出さない方がいいわ。<br>追体験は、いつだって過酷なものよ……。
#. de: Und ehrlich gesagt will ich mich genauso wenig an dieses Ereignis erinnern müssen wie du<nbsp>... Uah<nbsp>...
#. fr: Évite de trop y penser pour l'instant. On pourra toujours revivre ça ensemble si jamais tu as envie de te faire une grosse frayeur...
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002710_ALISAIE:1"
msgid "Best put that battle from your mind for now. Deep breaths, that's it..."
msgstr ""

#. ja: それはいいけど、頼めそうなあてはあるの？
#. de: Nur wer? Schwebt dir jemand Bestimmtes vor?
#. fr: Si même toi tu rechignes, qui est-ce qui va s'y coller<nbsp>?
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002720_ALISAIE:1"
msgid "Oh, very funny. Hah hah."
msgstr ""

#. ja: 拘束艦を伴ったダラガブの破片は、<br>エオルゼアだけでも複数確認されている……。
#. de: Allein in Eorzea wissen wir um mehrere Splitter Dalamuds, die in Frage kommen<nbsp>...
#. fr: Il y a plusieurs débris du même genre sus<shy>cep<shy>ti<shy>bles de nous intéresser à travers Éorzéa.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002730_ALPHINAUD:1"
msgid "Hmm... There are multiple internment hulks in Eorzea alone, so handling this ourselves may not be the most efficient option."
msgstr ""

#. ja: できるだけ多くのエクスアダマントを回収したいとなれば、<br>私たちで手分けするよりも、むしろ……。
#. de: Wenn wir so viel Edel-Adamantit wie möglich bergen wollen, wäre es nicht zielführend, uns einfach nur aufzuteilen. Nein<nbsp>...
#. fr: Nous pourrions nous séparer pour mettre la main sur l'exadamantium que nous cherchons, mais je pense avoir une meilleure idée...
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002740_ALPHINAUD:1"
msgid "Rather, if we could salvage adamantite from the shards simultaneously..."
msgstr ""

#. ja: サンクレッド、君はガレマルドで偵察任務をするにあたって、<br>派遣団の代表たちと繋がるリンクパールを渡されていたね。<br>それはまだ通じるかい？
#. de: Thancred, als du Garlemald ausgekundschaftet hast<nbsp>... Da hast du doch eine Kontaktperle benutzt, um dich mit der Leitung des Ilsabard-Korps austauschen zu können, oder nicht? Ist die Verbindung noch aktiv?
#. fr: Thancred, la délégation d'Ilsabard t'avait fourni une linkperle lorsque tu es parti en recon<shy>nais<shy>san<shy>ce à Garlemald. Tu l'as toujours<nbsp>?
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002750_ALPHINAUD:1"
msgid "Thancred, is the linkshell we established before you went to Garlemald still active?"
msgstr ""

#. ja: ああ、現役だ。<br>好きに使ってやってくれ。
#. de: Ist sie. Hier, tob dich aus.
#. fr: Je te vois venir.
#. speaker: THANCRED
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002760_THANCRED:1"
msgid "Of course. The floor is yours."
msgstr ""

#. ja: 何をするつもりだ……？
#. de: Was hast du vor<nbsp>...?
#. fr: Qu'est-ce que tu as derrière la tête...<nbsp>?
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002770_FOURCHENAULT:1"
msgid "What's all this?"
msgstr ""

#. ja: 皆で薪を集めるのです。<br>吹雪を凌ぐ焚火を、暗闇を照らす灯火を点けるために！
#. de: Ein jeder muss beim Holzsammeln helfen. Nur so kann das Feuer groß genug werden, um die Kälte des Schneesturms zu vertreiben und die Finsternis der Nacht fernzuhalten!
#. fr: Si tout le monde va chercher du bois, on pourra allumer un feu assez fort pour résister au blizzard et nous éclairer dans la nuit noire<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002780_ALPHINAUD:1"
msgid "Gathering firewood, so to speak. We alone can accomplish little, but joined by others, we may yet build a bonfire to carry us heavensward."
msgstr ""

#. ja: こちらアルフィノ、聞こえるだろうか。<br>「暁の血盟」から皆に頼みたいことがあるんだ。
#. de: Hier ist Alphinaud, hört ihr mich? Der Bund der Morgenröte hätte ein Anliegen an euch<nbsp>...
#. fr: Allô<nbsp>? Oui, c'est Alphinaud. Vous m'entendez<nbsp>? J'ai quelque chose à vous demander, au nom des Héritiers de la Septième Aube.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002790_ALPHINAUD:1"
msgid "This is Alphinaud. The Scions have need of you."
msgstr ""

#. ja: (-ルキア-)ルキアだ、委細承知した。<br>すぐにアイメリク様に連絡を取り、<br>クルザスのダラガブ片に回収部隊を向かわせる。
#. de: (-Lucia-)Verstanden. Ich werde umgehend Großmeister Aymeric kontaktieren und ihn eine Bergungseinheit zu den Dalamud-Resten in Coerthas schicken lassen.
#. fr: (-Voix de Lucia-)Entendu. Je vais contacter sire Aymeric pour qu'il envoie im<shy>mé<shy>dia<shy>te<shy>ment une équipe dans le Coerthas.
#. speaker: LUCIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002800_LUCIA:1"
msgid "(-Lucia-)Understood. I will contact the Lord Commander and dispatch our finest at once."
msgstr ""

#. ja: (-ア・ルン・センナ-)グリダニアも了解だよ。<br>対策に追われてる姉さまたちに代わって、<br>黒衣森の分は僕が行く。
#. de: (-Ruhn-Senna-)Gridania nimmt sich der Sache ebenfalls an. Meine Schwestern tun derzeit ihr Möglichstes, die Auswüchse des Untergangs im Zaum zu halten, so werde ich an ihrer statt die Bergungsexpedition leiten.
#. fr: (-Voix d'A-Ruhn-Senna-)En l'absence de ma sœur, je vous assure du soutien de Gridania pour cette mission. Nous nous occuperons de la forêt de Sombrelinceul.
#. speaker: ARUHNSENNA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002810_ARUHNSENNA:1"
msgid "(-A-Ruhn-Senna-)My sisters are somewhat preoccupied with the Final Days─so I will lead the Twelveswood expedition myself."
msgstr ""

#. ja: 拘束艦のほかに、<br>エクスアダマントが回収できるあてはないのかしら？
#. de: Gibt es neben den Luftschiffwracks noch eine andere Möglichkeit, an Edel-Adamantit zu gelangen?
#. fr: N'y a-t-il vraiment que dans ces vaisseaux de confinement qu'on peut trouver de l'exadamantium<nbsp>?
#. speaker: YSHTOLA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002820_YSHTOLA:1"
msgid "Are you aware of any other sources of refined adamantite?"
msgstr ""

#. ja: わざわざエクスアダマントを使っているような品は、<br>尋常じゃない量のエーテルを通したり、<br>蓄えたりする必要があるものだ。
#. de: Etwas aus dem höchst seltenen Metall herzustellen, lohnt sich nur dann, wenn eine große Menge Äther geleitet oder gespeichert werden muss.
#. fr: Seuls des objets nécessitant de conduire ou d'emmagasiner une énorrrme quantité d'éther ont pu justifier l'utilisation d'un métal aussi rarissime.
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002830_GRAHATIA:1"
msgid "Logically, such an invaluable alloy would have been utilized solely where absolutely necessary─in components intended to conduct or collect surpassing amounts of aether."
msgstr ""

#. ja: 現代にまで残っていれば、とくに強力な魔器として、<br>専門家や好事家のもとに流れている可能性が高い。
#. de: Allagische Artefakte, die in Frage kämen und das Kaiserreich überdauert haben, sind nun wahrscheinlich in den Händen extravaganter Sammler oder hochspezialisierter Magiekundiger.
#. fr: Pour trouver de tels artefacts qui auraient survécu à l'épreuve du temps, je suppose qu'il faudrait se tourrrner vers des sommités en magismologie, ou des col<shy>lec<shy>tion<shy>neurs extravagants.
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002840_GRAHATIA:1"
msgid "Any extant instrumentation or devices would have likely found their way into the hands of aetherologists or...enthusiasts."
msgstr ""

#. ja: (-シリナ-)……強力なアラグの魔器ですね。<br>東方連合に持ちかけて、探してみます！
#. de: (-Cirina-)Mächtige allagische Artefakte? Ich werde mich mit der Östlichen Allianz besprechen. Mit vereinten Kräften werden wir sicherlich fündig.
#. fr: (-Voix de Cirina-)Vous cherchez des reliques allagoises<nbsp>? Je vais voir ce que la coalition orientale peut faire pour vous<nbsp>!
#. speaker: CIRINA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002850_CIRINA:1"
msgid "(-Cirina-)Magical artifacts of Allagan design? The Eastern alliance will send word to one and all."
msgstr ""

#. ja: (-シリナ-)ほかにも何か、協力できることはありませんか？<br>こちらにはダラガブ片がないので、<br>人手にはまだ余裕があります……！
#. de: (-Cirina-)Kann ich euch sonst noch irgendwie unterstützen? Es finden sich zwar keine Splitter Dalamuds in unseren Landen, aber helfende Hände haben wir zuhauf!
#. fr: (-Voix de Cirina-)Si vous avez besoin de quoi que ce soit d'autre, n'hésitez pas<nbsp>! Il n'y a pas de débris de Dalamud par ici, et nous avons de la main-d'œuvre à disposition.
#. speaker: CIRINA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002860_CIRINA:1"
msgid "(-Cirina-)Are there other ways we may offer aid? No shards of the lesser moon scar our soil, but our stake in this cause is no less for it..."
msgstr ""

#. ja: ククロ殿、オサード小大陸の方で、<br>何かできることはないでしょうか？
#. de: Meister Kokkol, benötigt Ihr irgendetwas aus Othard?
#. fr: Kokkol, auriez-vous besoin de quelque chose du côté d'Othard<nbsp>?
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002870_ALPHINAUD:1"
msgid "Is there anything in Othard that might be of use to you?"
msgstr ""

#. ja: ぬお！？　東方諸国が協力してくれるってのか！？
#. de: Was?! Sogar der Ferne Osten steht uns bei?!
#. fr: Oh<nbsp>!? Vous voulez dire que les contrées orientales soutiennent notre effort<nbsp>?
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002880_KOKKOLDANKKOL:1"
msgid "Othard, you say!? You've got friends in far places, lad!"
msgstr ""

#. ja: だだだ、だったらアレだ、ほれ、<br>「神器」って呼ばれる祭具を貸してもらいてぇ！
#. de: Na! In dem Fall brauche ich unbedingt die göttlichen Schätze! Ihr wisst schon<nbsp>... ihre heiligen Insignien!
#. fr: Dans ce cas, il me faudrait... des reliques sacrées<nbsp>! Tu vois de quoi je parle, hein<nbsp>?
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002890_KOKKOLDANKKOL:1"
msgid "Anyroad, if you're offerin', I wouldn't say no to one of those Far Eastern sacred relics."
msgstr ""

#. ja: 神器は、ときに蛮神を顕現させられるほどのエーテルを、<br>ため込めるようになってんだ。<br>縮退炉と一緒に組み込みゃ、大きな力を扱いやすくなる！
#. de: Diese Schätze sind darauf ausgelegt, die massiven Äthermengen von Primae in sich zu bündeln und bei Bedarf auch wieder freizusetzen. Für die Speicherkapazität unseres Antriebs wären sie ein Segen!
#. fr: Si ces trésors sont capables de stocker suf<shy>fi<shy>sam<shy>ment d'éther pour invoquer des Primordiaux, ils nous seront très utiles pour améliorer notre réacteur<nbsp>!
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002900_KOKKOLDANKKOL:1"
msgid "Some of them can hold enough aether to summon a whole damn primal. Combine a source like that with the aetherburner and three...two...one...kaboom!"
msgstr ""

#. ja: ……聞こえていただろうか？<br>神器の確保も、併せて頼みたいんだ。
#. de: Cirina, du hast es sicher gehört. Denkst du, du könntest uns die göttlichen Schätze besorgen?
#. fr: Cirina, vous avez entendu<nbsp>? Si ce n'est pas trop demander, j'aimerais que vous rassembliez des reliques sacrées pour nous.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002910_ALPHINAUD:1"
msgid "...I gather you heard his explosive enthusiasm. Might you secure us a suitable relic?"
msgstr ""

#. ja: (-シリナ-)了解です！<br>終末の災厄だなんて、どうしようかと思いましたが……<br>何かやれることがあって、少し、ほっとしました。
#. de: (-Cirina-)Nur zu gern! Ich hatte schon befürchtet, im Kampf gegen diesen Untergang gänzlich machtlos zu sein.
#. fr: (-Voix de Cirina-)Bien sûr<nbsp>! Moi qui craignais de n'être d'aucune utilité pour faire face à cette horrible apocalypse, quel soulagement de savoir que je peux vous aider<nbsp>!
#. speaker: CIRINA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002920_CIRINA:1"
msgid "(-Cirina-)It shall be done! I know little of machines, but I promise we will do our utmost to gather the materials you need to finish your starship."
msgstr ""

#. ja: (-シリナ-)機械のことはよくわかりませんが、<br>完全な形で仕上げられるよう、私たちもがんばります！
#. de: (-Cirina-)Und wenn die Insignien dieser Maschine dienlich sind, so will ich mein Bestes tun, sie euch zu beschaffen!
#. fr: (-Voix de Cirina-)Je n'y connais rien en mécanique, mais si vous me dites que les reliques peuvent servir notre cause, je vous promets de faire le nécessaire<nbsp>!
#. speaker: CIRINA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002930_CIRINA:1"
msgid "(-Cirina-)I am glad for the work, in truth. Better to busy oneself than wait and fret over disasters foretold."
msgstr ""

#. ja: (-シカルド-)よっしゃ、そんじゃまあ、チャチャッと行って来らぁ！<br><ruby>陸<rt>おか</ruby>の上だろうが構わねぇ、景気よく略奪してくるからよ！
#. de: (-Sicard-)Aber sicher helfen wir euch! Schließlich versteht sich niemand so gut aufs Plündern wie wir. Und uns jucken die Finger nach einer ordentlichen Beutefahrt.
#. fr: (-Voix de Sicard-)Mais bien sûr qu'on va vous donner un coup de main<nbsp>! Rafler des trésors, c'est notre spécialité, alors tu peux compter sur moi et toute la clique de Limsa<nbsp>!
#. speaker: SICARD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002940_SICARD:1"
msgid "(-Sicard-)Then why're we all still standin' about yappin'? There's plunder for the takin'─an' I'm a born plunderer!"
msgstr ""

#. ja: (-シカルド-)届け先は、オールド・シャーレアンでいいんだな？<br>首を洗って待っていやがれ！
#. de: (-Sicard-)Wir schippern dann alles nach Alt-Sharlayan, ja? Schafft schon mal Platz im Hafen!
#. fr: (-Voix de Sicard-)Faudra envoyer le butin à Sharlayan, c'est ça<nbsp>? Tu peux déjà leur dire de faire de la place sur les quais<nbsp>!
#. speaker: SICARD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002950_SICARD:1"
msgid "(-Sicard-)I'll be in Ol' Sharlayan before you know it. Start mixing the grog!"
msgstr ""

#. ja: そうするよ。<br>……皆、ありがとう。<br>くれぐれも気をつけて頼む！
#. de: Machen wir. Vielen, vielen Dank. Und gebt bitte alle auf euch Acht!
#. fr: Je n'y manquerai pas. Merci, merci à tous pour votre aide si précieuse... Et surtout faites bien attention à vous.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002960_ALPHINAUD:1"
msgid "I'm certain that can be arranged. Thank you all─and do be careful."
msgstr ""

#. ja: やったわね！
#. de: Ich bin beeindruckt!
#. fr: Bien joué<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002970_ALISAIE:1"
msgid "Just like that!"
msgstr ""

#. ja: ああ……。<br>エクスアダマントはきっとここに届く。
#. de: Ja<nbsp>... Damit sollte für reichlich Edel-Adamantit gesorgt sein.
#. fr: Nous allons trouver cet exadamantium, j'en suis convaincu.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002980_ALPHINAUD:1"
msgid "Aye, just like that, our refined adamantite is on its way."
msgstr ""

#. ja: 私たちは、それを信じ……<br>さらに先を見据えて、準備を進めていこう！
#. de: Ich habe großes Vertrauen in unsere Freunde. Und wir kümmern uns inzwischen um den nächsten Schritt!
#. fr: Faisons confiance à nos alliés et préparons-nous pour la suite. D'autres épreuves nous attendent, mais nous saurons les surmonter<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_002990_ALPHINAUD:1"
msgid "Now let us consider our next steps, shall we? There's yet much to be done."
msgstr ""

#. ja: 一方  ウルダハ  香煙の間――
#. de: Unterdessen in Ul'dahs Weihrauchkammer<nbsp>...
#. fr: Pendant ce temps, dans la Chambre de l'Encens
#. speaker: SYSTEM_NONE_VOICE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003000_SYSTEM_NONE_VOICE:1"
msgid "Meanwhile, in Ul'dah..."
msgstr ""

#. ja: ……改めて、事情はわかった。<br>ダラガブ片からのエクスアダマントの回収、<br>そして強力なアラグの魔器の収集じゃな。
#. de: Danke, Pipin. Es gilt also einerseits, Edel-Adamantit aus den Resten Dalamuds zu bergen und andererseits nach potenten magischen Artefakten der Allager zu suchen.
#. fr: Merci, Pipin. Si nous avons bien suivi, l'exadamantium peut se trouver dans certains fragments de Dalamud, et dans de puissantes reliques magiques allagoises.
#. speaker: NANAMOULNAMO
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003010_NANAMOULNAMO:1"
msgid "...Our course of action is clear. We must harvest refined adamantite from the shards of Dalamud, and procure arcane relics of Allagan make."
msgstr ""

#. ja: よし、すぐに不滅隊の精鋭をそろえ、突入部隊を編成せよ！<br>銀冑団や銅刃団からも腕利きを募れ！
#. de: Gut. Dann versammeln wir unverzüglich jegliche Elitestreiter der Legion und stellen einen Bergungstrupp zusammen. Dafür werden die besten Leute der Palastwache und der Messingklingen rekrutiert.
#. fr: Nous voulons que tu réunisses im<shy>mé<shy>dia<shy>te<shy>ment les meilleurs éléments des Immortels, des casques d'argent et des lames de cuivre pour former une unité spéciale.
#. speaker: NANAMOULNAMO
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003020_NANAMOULNAMO:1"
msgid "Summon the best and brightest of our Immortal Flames, and form an expeditionary party at once! Call upon the Sultansworn and Brass Blades for support as you must."
msgstr ""

#. ja: パパシャンは、各ギルドに通達を。<br>アラグの防衛機構を制し、未知の素材を回収するにあたっては、<br>彼らの協力が必要不可欠じゃ。
#. de: Papashan, bitte setze auch alle Gilden in Kenntnis. Ihre Kooperation ist unabdingbar, sowohl für die Überwindung der allagischen Abwehrmechanismen, als auch für die Bergung des Metalls selbst.
#. fr: Papashan, tu vas contacter les guildes de la cité. L'aide de nos artisans sera in<shy>dis<shy>pen<shy>sa<shy>ble, aussi bien pour déjouer les systèmes de défense allagois que pour prélever un matériau aussi précieux.
#. speaker: NANAMOULNAMO
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003030_NANAMOULNAMO:1"
msgid "Papashan, send word to the guilds. We will require the expertise of master artisans if we are to have any hope of identifying and recovering these elusive materials."
msgstr ""

#. ja: フィルガイス……<br>砂蠍衆の中でもそなたを呼んだのは、<br>鉄灯団を動かす可能性を考えてのこと。
#. de: Meister Fyrgeiss? Ich ließ nun gerade Euch in den Scorpio-Kreis berufen, weil ich mir die Unterstützung der Eisenschein-Soldaten erhoffe.
#. fr: Messire Fyrgeiss, si nous avons fait appel à vous parmi tous les membres du Cartel des Scorpions, c'est que nous comptons sur le soutien des torches d'acier.
#. speaker: NANAMOULNAMO
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003040_NANAMOULNAMO:1"
msgid "Fyrgeiss, we have need of your Stone Torches."
msgstr ""

#. ja: 不滅隊に協力し、突入部隊の補助や、<br>その間の各地の警備を受け持ってくれるな……？
#. de: Ihr werdet mit der Legion der Unsterblichen zu<shy>sammen<shy>arbeiten, um dem Bergungstrupp zur Seite zu stehen und für die Sicherheit an allen Schlüsselstellungen zu sorgen.
#. fr: Vous travaillerez en coordination avec les Immortels pour assister leur unité spéciale, tout en assurant la sécurité sur les zones-clefs de cette mission.
#. speaker: NANAMOULNAMO
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003050_NANAMOULNAMO:1"
msgid "They are to assist the Immortal Flames in scouring the ruins, and to help secure the surrounding areas. I trust I can count on your support?"
msgstr ""

#. ja: は……。<br>我が息子、鉄灯団団長ツィルンベルク直々に、<br>ことにあたるといたしましょう。
#. de: Selbstverständlich, Eure Majestät. Mein Sohn Zirnberk, Hauptmann der Eisenschein-Soldaten, wird persönlich das Kommando über<shy>nehmen.
#. fr: Soyez tranquille, Votre Majesté. Je m'assurerai que mon fils Zirnberk, capitaine des torches d'acier, supervise personnellement notre part de la mission.
#. speaker: FYRGEISS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003060_FYRGEISS:1"
msgid "As commander of the Stone Torches, my son Zirnberk will personally see it done."
msgstr ""

#. ja: ピピン、突入部隊の長はそなたに任せる。<br>集いしつわものたちを率い、存分にティソーナを振るうがよい。
#. de: Pipin, du hast deinerseits Befehlsgewalt über den Bergungstrupp. Führe die Streiterinnen und Streiter mit Tizona fest in deiner Hand.
#. fr: Pipin, nous te confions le commandement général de cette opération. Tu as carte blanche pour faire usage de Tizona comme bon te semble.
#. speaker: NANAMOULNAMO
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003070_NANAMOULNAMO:1"
msgid "Pipin. I would have you lead the raiding party. Assemble your finest, and with Tizona's blade clear the way."
msgstr ""

#. ja: ロロリトよ、そなたはアラグの魔器の回収じゃ。<br>市場に出回っているもの、好事家に買われたもの……<br>そなたになら心当たりもあろう。
#. de: Lolorito. Euch beauftrage ich mit der Beschaffung der allagischen Artefakte. Niemand verfolgt den Markt von Ul'dah und den Handel mit exotischen Stücken so genau wie Ihr.
#. fr: Lolorito, vos relations nous seront très utiles pour localiser les reliques allagoises, des alcôves du marché noir jusqu'aux collections privées les plus exclusives.
#. speaker: NANAMOULNAMO
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003080_NANAMOULNAMO:1"
msgid "Lord Lolorito, I pray you take charge of the search for Allagan relics. Surely you know of some being traded on open or clandestine markets, or sleeping in collectors' vaults."
msgstr ""

#. ja: 無論、善意で……などとは言わぬ。<br>取引方法はそなたに任せるゆえ、いつものとおり、<br>最後には損のないよう収めてみせよ。
#. de: Selbstverständlich sollt Ihr nicht aus der Güte Eures Herzens und aus eigener Tasche heraus handeln. Jegliche Transaktion wird von der Krone vergütet, lasst also keinerlei Zurückhaltung walten.
#. fr: Bien évidemment, nous ne vous demandons pas de le faire bé<shy>né<shy>vo<shy>le<shy>ment. Vous êtes libre de choisir la méthode, tant que vous mettez la main sur ces trésors.
#. speaker: NANAMOULNAMO
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003090_NANAMOULNAMO:1"
msgid "Of course, I ask not that you do this out of the kindness of your heart. By all means, profit on the transactions. I wish you the joy of it."
msgstr ""

#. ja: 世界を脅かさんとしておる、終末の災厄……<br>それが報告どおりのものならば、<br>我らの力のみでは、到底抗い得ぬ。
#. de: Unsere Welt steht am Abgrund einer nie dagewesenen Katastrophe. Eine Bedrohung, der wir allein nicht Herr werden können.
#. fr: Notre monde est menacé par une catastrophe sans précédent, et nos efforts seuls ne permettront pas de le sauver de la destruction.
#. speaker: NANAMOULNAMO
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003100_NANAMOULNAMO:1"
msgid "The Final Days descend upon our world. If circumstances are truly as dire as they say, Ul'dah's best efforts may be for naught."
msgstr ""

#. ja: しかし、わらわは……エオルゼアの民は、今や知っておろう。<br>第七霊災からこちら、抱えてきた傷や痛みと向き合って、<br>やっとわかったのじゃ。
#. de: Doch wir<nbsp>... die Kinder Eorzeas. Wir kennen das Leid und den Schmerz. Tragen Wunden, die seit der Siebten Katastrophe in unsere Herzen stechen. Sie sind uns eine Lektion.
#. fr: Mais le peuple éorzéen connaît mieux que quiconque la souffrance et la peine. Ainsi, toutes les épreuves que nous avons surmontées depuis le septième fléau nous ont permis de prendre conscience d'une importante vérité.
#. speaker: NANAMOULNAMO
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003110_NANAMOULNAMO:1"
msgid "And yet, when we Eorzeans rose from the ashes to rebuild our broken realm, did we not learn one simple truth?"
msgstr ""

#. ja: 独りでは立ち上がることさえできずとも、<br>誰かとならば、戦い抜けると。
#. de: Eine Lektion, die wir nun endlich verstanden haben. Nur gemeinsam werden wir uns erheben.
#. fr: Aucun défi n'est impossible à relever lorsqu'on unit nos forces pour se battre tous ensemble.
#. speaker: NANAMOULNAMO
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003120_NANAMOULNAMO:1"
msgid "That which seems all but impossible to overcome alone, may yet be possible if we stand together."
msgstr ""

#. ja: それを先陣を切って示してきた「暁」が、<br>ともに立つ者を欲している……。
#. de: Der Bund der Morgenröte beschwor uns seit jeher zu Einheit. Nun schallt sein Ruf nach Verbündeten durch alle Lande.
#. fr: Les Héritiers de la Septième Aube nous l'ont maintes fois prouvé, et aujourd'hui ce sont eux qui sollicitent l'aide de leurs alliés.
#. speaker: NANAMOULNAMO
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003130_NANAMOULNAMO:1"
msgid "It was the Scions who united us then, and it is the Scions who call upon us now."
msgstr ""

#. ja: ならばウルダハは果敢に応え、<br>彼らとともに、この災厄に打ち勝とうではないか！
#. de: Und Ul'dah wird antworten, in all ihrer Stärke und Glorie. So erheben wir das Schwert und schlagen auch diese Bedrohung zurück!
#. fr: Nous, Uldiens, allons répondre à leur appel avec détermination<nbsp>! Nous vaincrons ce péril et sauverons notre planète<nbsp>!
#. speaker: NANAMOULNAMO
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003140_NANAMOULNAMO:1"
msgid "Ul'dah will answer that call. We will summon our courage, and join the fight for our world's future."
msgstr ""

#. ja: 各方、ただちに取り掛かるがよい！<br>第十七代国王、ナナモ・ウル・ナモからの至上命令と心得よ！
#. de: Dies ist ein Befehl Sultana Nanamo Ul Namos, Siebzehnte derer von Ul: Widmet euch umgehend Euren Pflichten und kämpft!
#. fr: Que chacun s'attelle à sa tâche im<shy>mé<shy>dia<shy>te<shy>ment. Nous, Nanamo Ul Namo, 17e sultane d'Ul'dah, nous vous l'ordonnons<nbsp>!
#. speaker: NANAMOULNAMO
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003150_NANAMOULNAMO:1"
msgid "You know your duties! I, Nanamo Ul Namo, seventeenth in the line of Ul, bid you good luck and godsspeed!"
msgstr ""

#. ja: 一方  黒衣森  フォールゴウド――
#. de: Im Tiefen Wald, am Herbstkürbis-See<nbsp>...
#. fr: Pendant ce temps, au Radeau de la Calebasse
#. speaker: SYSTEM_NONE_VOICE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003160_SYSTEM_NONE_VOICE:1"
msgid "Meanwhile, in the Black Shroud..."
msgstr ""

#. ja: 兵の数はそろったけど、やっぱり偏りが出るか……。<br>治療には事欠かなくても、防衛機構の破壊を担う者が少ない。
#. de: Unsere Streitkräfte sind beachtlich, aber stimmt das Verhältnis der Truppen? Heiler haben wir zur Genüge, doch mangelt es an Frontkämpfern, die den allagischen Abwehrmechanismen standhalten können<nbsp>...
#. fr: Nos effectifs sont suffisants, mais déséquilibrés... On a bien assez de soigneurs, mais on manque de combattants pour détruire les systèmes de défense.
#. speaker: ARUHNSENNA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003170_ARUHNSENNA:1"
msgid "We've fielded a goodly number, but our ranks are heavy with healers. And an abundance of restorative magicks will be of little help in destroying Dalamud's defenses."
msgstr ""

#. ja: グリダニアの在り方としては正しいんだけどね。<br>長期戦になるかもしれないな……。
#. de: Bislang war diese Aufstellung immer Gridanias Stärke, ohne Frage, doch zöge sie nun den Kampf unnötig in die Länge<nbsp>...
#. fr: Ce qui fait d'ordinaire la force de Gridania risque de nous coûter un temps précieux pour cette mission...
#. speaker: ARUHNSENNA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003180_ARUHNSENNA:1"
msgid "Still, it has ever been thus with Gridania. We must steel ourselves for a protracted engagement..."
msgstr ""

#. ja: (-？？？？-)よければ、アタシたちも連れて行ってくれない？
#. de: (-???-)Dürfen wir uns diesem Kampf anschließen?
#. fr: (-???-)Ça ne te dérange pas si on participe, nous aussi<nbsp>?
#. speaker: LYSE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003190_LYSE:1"
msgid "(-???-)In that case, might I suggest taking us along?"
msgstr ""

#. ja: 君、どうしてここに……！？
#. de: Was macht ihr denn alle hier?
#. fr: Lyse<nbsp>!? Je ne m'attendais pas à te voir ici<nbsp>!
#. speaker: ARUHNSENNA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003200_ARUHNSENNA:1"
msgid "Commander Hext!? What are you doing here?"
msgstr ""

#. ja: ギラバニアには、拘束艦がついているような、<br>大きなダラガブ片が落ちてきてないんだ。
#. de: Nun ja<nbsp>... In Gyr Abania gibt es kein Dalamudstück mit Verkeilungsschiff.
#. fr: À notre con<shy>nais<shy>san<shy>ce, il n'y a pas de fragment de Dalamud qui corresponde à ce qu'on cherche en Gyr Abania.
#. speaker: LYSE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003210_LYSE:1"
msgid "None of the shards in Gyr Abania are big enough to hold an internment hulk."
msgstr ""

#. ja: だから、グリダニアの手伝いに！<br>アラミゴからいちばん近いし、何より、<br>思いっきり暴れる前衛が必要なんじゃないかと思ってさ。
#. de: Deswegen sind wir gekommen, um Gridania zu unterstützen. Es war kein weiter Weg von Ala Mhigo bis hierher und außerdem dachte ich, dass ihr ein Frontpolster gut gebrauchen könntet.
#. fr: Donc, nous voilà au service de Gridania<nbsp>! Ala Mhigo n'est pas loin, et puis on s'est dit que vous alliez manquer de combattants en première ligne.
#. speaker: LYSE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003220_LYSE:1"
msgid "So we said to ourselves─why not lend our neighbors a hand? We thought you might be short on people with a talent for breaking things."
msgstr ""

#. ja: ……見透かされてるのは癪だけど、そのとおりだよ。<br>よくわかったね。
#. de: Es sollte mich kränken, dass du Gridanias Schwäche derart leicht durchschaut hast. Aber du hast den Nagel wahrlich auf den Kopf getroffen.
#. fr: Tu es bien au fait de nos faiblesses... Merci, Lyse.
#. speaker: ARUHNSENNA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003230_ARUHNSENNA:1"
msgid "While it pains me to admit it...you are right. Are our deficiencies so plain to see?"
msgstr ""

#. ja: もう、すごく昔のことみたいに感じちゃうけど……<br>アタシ、「暁」の一員として、この国の調査を担当してたんだ。
#. de: Es kommt mir wie eine halbe Ewigkeit vor, aber als Mitglied des Bundes der Morgenröte verbrachte ich viel Zeit in Gridania und dem Tiefen Wald.
#. fr: Même si ça remonte un peu, j'en ai passé du temps à l'ombre de ces arbres, en compagnie des Héritiers.
#. speaker: LYSE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003240_LYSE:1"
msgid "It might've been a lifetime ago, but I was once one of the Scions assigned to the Shroud."
msgstr ""

#. ja: だから知ってるよ、黒衣森のことも……<br>グリダニアのみんなの戦い方だって。
#. de: Deswegen bin ich mit den hiesigen Truppen und Strategien bestens vertraut.
#. fr: Donc les spécificités de Gridania et de sa forêt, ça me connaît<nbsp>!
#. speaker: LYSE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003250_LYSE:1"
msgid "I know this forest well. I know your people. And I know we will be stronger if we fight this fight together."
msgstr ""

#. ja: だったら、遠慮なく力を借りさせてもらうよ。<br>さっそくだけど、打ち合わせといこう。
#. de: In dem Fall werde ich nicht zögern, dich um Ala Mhigos Unterstützung zu bitten. Rufen wir sofort den Stab zusammen.
#. fr: Dans ce cas, c'est avec plaisir que nous acceptons l'aide d'Ala Mhigo. Commençons par faire le point, si tu le veux bien.
#. speaker: ARUHNSENNA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003260_ARUHNSENNA:1"
msgid "Then I will impose upon you with a clear conscience. Come, let us speak of how to integrate our forces."
msgstr ""

#. ja: ……必ずやり遂げるから。<br>見ててね、パパリモ。
#. de: Ich werd's schon schaukeln. Das verspreche ich dir, Papalymo.
#. fr: On va y arriver. Je te le promets, Papalymo.
#. speaker: LYSE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003270_LYSE:1"
msgid "I won't let it all be for nothing. I promise you, Papalymo..."
msgstr ""

#. ja: 一方  クルザス中央高地――
#. de: Im zentralen Hochland von Coerthas<nbsp>...
#. fr: Pendant ce temps, dans les Hautes terres du Coerthas central
#. speaker: SYSTEM_NONE_VOICE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003280_SYSTEM_NONE_VOICE:1"
msgid "Meanwhile, in Coerthas..."
msgstr ""

#. ja: あ、やっと見つけたぞ……！
#. de: Hier bist du also!
#. fr: Ah, te voilà enfin<nbsp>!
#. speaker: EMMANELLAIN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003290_EMMANELLAIN:1"
msgid "There...there you are!"
msgstr ""

#. ja: 兄貴、何してるんだよ。<br>もうみんなとっくに集合して……
#. de: Bruder, was treibst du denn? Es haben sich schon längst alle versamm-
#. fr: Qu'est-ce que tu fabriques<nbsp>? Ils se sont déjà tous rassemblés, tu sais...
#. speaker: EMMANELLAIN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003300_EMMANELLAIN:1"
msgid "We've no time to waste, Brother! Everyone has already... Ah."
msgstr ""

#. ja: な、なんだよこれ……竜の……咆哮……！？
#. de: W-W-Was war das?! Ein<nbsp>... Drache?!
#. fr: Q-qu'est-ce que c'est...<nbsp>!? U-un dragon<nbsp>?
#. speaker: EMMANELLAIN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003310_EMMANELLAIN:1"
msgid "That...that was a roar. A dragon's roar!"
msgstr ""

#. ja: 一方  紅玉海  筋違砦――
#. de: Und schließlich in der Rubinsee<nbsp>...
#. fr: Pendant ce temps, à L'Entorse
#. speaker: SYSTEM_NONE_VOICE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003320_SYSTEM_NONE_VOICE:1"
msgid "Meanwhile, in the Ruby Sea..."
msgstr ""

#. ja: ……という要請が、東方連合とロロリト会長からありまして。<br>海賊衆の皆さんなら、神器に心当たりがないかと思って、<br>こちらに参ったのデ～ス。
#. de: ... So lautet die Bitte um Unterstützung von der Östlichen Allianz und des Vorsitzenden Lolorito. Wenn irgendjemand um den Aufenthaltsort dieser heiligen Kleinodien weiß, dann doch sicherlich meine Freunde von der Konföderation, dachte ich mir.
#. fr: Voilà ce que m'ont demandé la coalition orientale et le seigneur Lolorito. Je me suis dit que si quelqu'un pouvait dénicher ces reliques, ce serait vous, mes amis de la Confédération.
#. speaker: HANCOCK
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003330_HANCOCK:1"
msgid "...And so, in summation, the Eastern alliance, as well as the honorable Lord Lolorito himself, reached out to me for assistance in procuring these treasures of the divine─and I, in turn, do beseech the Confederacy for aid."
msgstr ""

#. ja: おや？　あれは……。
#. de: Wen haben wir denn da<nbsp>...?
#. fr: Tiens donc...
#. speaker: HANCOCK
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003340_HANCOCK:1"
msgid "Hm? Is that...?"
msgstr ""

#. ja: あれぇ、なんでハンコックまでいるのぉ～？
#. de: Hancock<nbsp>...... Was machst du<nbsp>...... hier?
#. fr: Heiiiin<nbsp>? Hancock est là aussiiii<nbsp>?
#. speaker: SOROBAN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003350_SOROBAN:1"
msgid "Hancock? What a surprise this is!"
msgstr ""

#. ja: でも、ちょうどいいやぁ～。<br>実は、頼みたいことがあってねぇ～。
#. de: Aber das passt mir<nbsp>...... sehr gut. Ich wollte dich um einen Gefallen<nbsp>...... bitten.
#. fr: Tant mieux, après touuuut. J'avais justement quelque chose à vous demandeeeer.
#. speaker: SOROBAN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003360_SOROBAN:1"
msgid "And a fortuitous one at that. I have a favor to ask, you see..."
msgstr ""

#. ja: ちょっと休憩……<br>一度にこんなにしゃべったのは、はじめてですわ……。
#. de: Ich brauche eine Pause<nbsp>... Bei allen Möhren, noch nie in meinem Leben habe ich so viel reden müssen!
#. fr: J'ai besoin de faire une petite pause... Je crois bien que c'est la première fois que je parle autant d'un coup<nbsp>!
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003370_LIVINGWAY:1"
msgid "Phew! Finally, some rest. Why, I haven't spoken so much in...well, in forever!"
msgstr ""

#. ja: よう、盛況だな。<br>月の民から助言をもらえるらしいって、<br>さっそく街中で話題になってたぞ。
#. de: Na, hier geht's aber lebhaft zu. Schön! Die ganze Stadt ist in heller Aufregung wegen der Helfer vom Mond.
#. fr: Eh bien, quel succès<nbsp>! Tout Sharlayan est en ébullition depuis la nouvelle de l'arrivée des petits habitants de la lune.
#. speaker: THANCRED
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003380_THANCRED:1"
msgid "Lively, isn't it? The town is abuzz─everyone eager to meet with our friends from the moon."
msgstr ""

#. ja: そういうことでしたら、<br>こちらのスリーピングウェイと話してみるのがよろしいかと。<br>彼は月の操縦士ですので……。
#. de: ... Dafür solltet Ihr am besten mit Sleepingway hier sprechen. Er ist der dedizierte Pilot des Mondes.
#. fr: Dans ce domaine, c'est Sleepingway qui sera le plus à même de vous répondre. C'est lui qui est chargé de piloter l'arche.
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003390_URIANGER:1"
msgid "'Twould behoove you to consult with Sleepingway. As our moon's pilot, his advice should be most pertinent..."
msgstr ""

#. ja: よく覚えてるもんだな。<br>レポリットの違いを見分けるのは難しいと思うんだが。
#. de: Wie schnell er sich all eure Namen gemerkt hat. Und über eure Fä<shy>hig<shy>kei<shy>ten und Rollen Bescheid weiß<nbsp>...
#. fr: Je me demande comment il fait pour différencier les Loporrites... À mes yeux, ils se ressemblent tous.
#. speaker: THANCRED
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003400_THANCRED:1"
msgid "I'm impressed. Truth be told, I struggle to tell one from another. No offense intended, of course..."
msgstr ""

#. ja: あなた方を嘆きの海から送り出したあと、<br>わたくしたちとウリエンジェは、たくさん話をしましたから。
#. de: Nachdem ihr Mare Lamentorum verlassen habt, haben wir uns lange mit Urianger unterhalten.
#. fr: Après votre départ de Mare Lamentorum, Urianger a passé beaucoup de temps à discuter avec chacun d'entre nous.
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003410_LIVINGWAY:1"
msgid "None taken! After you and your friends left Mare Lamentorum, we spent no small amount of time with your Urianger."
msgstr ""

#. ja: 彼はアーテリスについていろいろと教えてくれましたし、<br>こちらの質問にも、とことん付き合ってくれましたわ。
#. de: Er hat uns unzählige spannende Fakten über Ætheris erzählt und ist geduldig auf unseren gigantischen Berg von Fragen eingegangen.
#. fr: Il nous a non seulement appris énormément de choses au sujet d'Ætherys, mais il a aussi eu la patience de répondre aux questions qu'on lui posait sans arrêt.
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003420_LIVINGWAY:1"
msgid "Oh, the conversations we had! He told us all about Etheirys─answered our every question, no matter how trifling or trivial."
msgstr ""

#. ja: おかげで、わたくしの本ももういっぱい！
#. de: Mein Buch mit Informationen und Geschichten über euren Planeten ist inzwischen randvoll!
#. fr: Grâce à lui, il n'y a plus une seule page blanche dans mon livre<nbsp>!
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003430_LIVINGWAY:1"
msgid "Look! Every page, filled to the margins with knowledge!"
msgstr ""

#. ja: こうして実際に来てみると、まだ驚くことばかりですが……<br>そもそも彼から教えられなければ、<br>地上に降りてくることもなく、月で待ち続けていたでしょう。
#. de: Und jetzt, wo ich selbst Pfote auf Ætheris gesetzt habe, gibt es trotzdem noch so viele Dinge, die mich überraschen, erstaunen und entzücken. Wäre Urianger nicht gewesen, hätten wir endlos auf dem Mond gewartet<nbsp>...
#. fr: Et pourtant, je fais des découvertes pas<shy>sion<shy>nan<shy>tes chaque minute depuis mon arrivée ici. Sans Urianger, les Loporrites seraient encore en train de compter les jours, sur la lune...
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003440_LIVINGWAY:1"
msgid "When I first arrived, I was struck by how little I knew. It was daunting...but then I realized that were it not for Urianger and his teachings, we'd still be stuck on the moon. Gazing at your world and wondering what we've been missing..."
msgstr ""

#. ja: ふ…
#. de: Heh.
#. speaker: THANCRED
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003450_THANCRED:1"
msgid "Report if displayed."
msgstr ""

#. ja: こんな光景、昔のウリエンジェを知る奴が見たら、<br>驚いて……喜んだだろうな。
#. de: Wenn man nur den alten Urianger kennt und ihn jetzt sähe, würde man aus dem Staunen vermutlich gar nicht mehr herauskommen. Und aus dem Schmunzeln auch nicht.
#. fr: Quiconque a connu Urianger par le passé serait surpris devant un tel spectacle. Surpris... et heureux.
#. speaker: THANCRED
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003460_THANCRED:1"
msgid "What would they think if they could see Urianger now? I daresay they'd be more than a bit surprised...and impressed, no doubt."
msgstr ""

#. ja: ルイゾワ様やミンフィリア、パパリモ、それから……
#. de: Kannst du dir die Gesichter von Louisoix, Minfilia oder Papalymo vorstellen? Und natürlich<nbsp>...
#. fr: Je pense à Louisoix... À Minfilia, ou encore à Papalymo... Et bien sûr...
#. speaker: THANCRED
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003470_THANCRED:1"
msgid "Master Louisoix, Minfilia, Papalymo. And not to forget..."
msgstr ""

#. ja: (-？？？？-)やあ、ここで良い相談役を紹介してもらえると聞いたんだ。<br>私たちにも頼めるかな？
#. de: (-???-)Hallo zusammen! Wir haben gehört, dass dies hier die richtige Anlaufstelle für Fragen aller Art ist? Hätte man ein wenig Zeit für uns?
#. fr: (-???-)Bonjour, on nous a dit que nous pourrions trouver réponse à nos questions ici. Auriez-vous un peu de temps à nous consacrer<nbsp>?
#. speaker: WILFSUNN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003480_WILFSUNN:1"
msgid "Ho there! Heard there was a visiting expert who we might bother with a few questions. I take it you'd be the one?"
msgstr ""

#. ja: ウィルフスンさん……ブローウィダさん……。
#. de: Wilfsunn! Und Bloewyda<nbsp>...
#. fr: Wilfsunn<nbsp>! Bloewyda<nbsp>!
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003490_URIANGER:1"
msgid "Y-Yes... I am..."
msgstr ""

#. ja: 転移魔法の研究者として有名な夫妻だよ。<br>……ムーンブリダの、ご両親だ。
#. de: Das<nbsp>... sind die wohl berühmtesten Forscher auf dem Gebiet der Transportmagie. Und darüber hinaus Moenbrydas Eltern.
#. fr: Ces gens sont connus pour leurs recherches sur les sorts de téléportation. Et... ce sont aussi les parents de Moenbryda.
#. speaker: THANCRED
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003500_THANCRED:1"
msgid "Wilfsunn and Bloewyda. Sharlayan's foremost researchers in the field of teleportation magick. ...And Moenbryda's parents."
msgstr ""

#. ja: ……お久しぶりです。<br>おふたりとも……こちらに、いらしたのですか……。
#. de: Was für eine<nbsp>... Freude, euch<nbsp>... Ich meine, es ist so lange her! Ich<nbsp>... Ich wusste nicht, dass ihr<nbsp>...
#. fr: Cela fait si longtemps... Je ne savais pas que vous viviez ici...
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003510_URIANGER:1"
msgid "It hath been some time. 'Tis... 'Tis good to see you in...good health."
msgstr ""

#. ja: ああ、しばらく前に、妻ともども引き抜かれてね。<br>しかしまさか、ここで君と再会することになるとは。
#. de: Nein, nein, wir leben schon seit geraumer Zeit hier. Seit wir ins Labyrinthos berufen wurden. Aber dass wir dich hier treffen, das hätten wir nicht gedacht!
#. fr: Il y a quelque temps, mon épouse et moi avons été débauchés pour poursuivre nos travaux dans le Labyrinthos. Quelle surprise de te trouver ici<nbsp>!
#. speaker: WILFSUNN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003520_WILFSUNN:1"
msgid "Likewise, old friend! Bloewyda and I were most honored to answer the call. Never expected this reunion, though, did we, dear?"
msgstr ""

#. ja: まったくだよ……。<br>あんたときたら、うちの子の訃報に手紙を添えてきたきり、<br>何の連絡もよこしやしない……！
#. de: Also wirklich, Urianger<nbsp>... Einen einzigen Brief hast du geschrieben. Als unsere Tochter gestorben ist. Und seither hast du gar nichts mehr von dir hören lassen!
#. fr: Quand même... Une lettre pour le décès de notre fille, et puis plus rien. Tu aurais au moins pu donner signe de vie<nbsp>!
#. speaker: BLOEWYDA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003530_BLOEWYDA:1"
msgid "I'll say! The nerve...sending that letter, then running off to the gods know where!"
msgstr ""

#. ja: 本当に……本っ当に……心配かけて……！
#. de: Wir<nbsp>... Wir haben uns solche Sorgen um dich gemacht!
#. fr: Si tu savais... Nous nous sommes fait tant de souci pour toi<nbsp>!
#. speaker: BLOEWYDA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003540_BLOEWYDA:1"
msgid "Do you have...any idea...how worried we were?"
msgstr ""

#. ja: っ…
#. de: A<nbsp>...
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003550_URIANGER:1"
msgid "Report if displayed."
msgstr ""

#. ja: 申し訳、ございません……。<br>直接ご報告に伺うべきだと、わかっていながら……。
#. de: Es tut mir<nbsp>... so furchtbar leid. Ich wusste, ich hätte es euch persönlich<nbsp>...
#. fr: Je n'ai aucune excuse. Je sais que j'aurais dû venir vous l'annoncer en personne...
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003560_URIANGER:1"
msgid "I...I'm sorry. 'Twas remiss of me...not to deliver the news in person."
msgstr ""

#. ja: 何より、ムーンブリダのことを……私は……。
#. de: Aber ich<nbsp>... Moenbryda, sie<nbsp>...
#. fr: Mais plus que tout, pour Moenbryda, je...
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003570_URIANGER:1"
msgid "No, more than that... 'Twas I who..."
msgstr ""

#. ja: ……ルイゾワ様に置いていかれたと嘆いていた彼女にとって、<br>君たち「暁」が呼んでくれたことが、どれほどの歓びだったか。
#. de: Moenbryda war fürchterlich enttäuscht, dass Meister Louisoix sie nicht nach Eorzea mitgenommen hatte. Als du sie zu dir gerufen hast, im Namen des Bundes der Morgenröte, hat sie gestrahlt wie die Sonne selbst.
#. fr: Si tu savais comme elle était heureuse de vous rejoindre, toi et tes amis Héritiers, après le départ de Louisoix...
#. speaker: WILFSUNN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003580_WILFSUNN:1"
msgid "Our daughter was disillusioned after Master Louisoix left her behind. The day the Scions called upon her was the happiest I'd seen her in years."
msgstr ""

#. ja: あの子の為したこと、すべての決断は、<br>間違いなくあの子自身のものだったと思う。
#. de: Alles, was geschehen ist. Die Entscheidungen, die sie traf<nbsp>... Sie folgte dem Ruf ihres Herzens, da sei dir gewiss.
#. fr: Tout ce qui s'est passé ensuite, les choix qu'elle a faits... Je peux t'assurer qu'elle n'a jamais écouté que son cœur.
#. speaker: WILFSUNN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003590_WILFSUNN:1"
msgid "She made her every choice of her own free will. No one could've ever forced her to do otherwise."
msgstr ""

#. ja: どうか君も、己を責めるのではなく……<br>彼女を誇ってやってはくれないか。
#. de: Du musst aufhören, dir selbst die Schuld zu geben, Urianger. Sei lieber stolz auf unser tapferes, starkes Mädchen.
#. fr: Ça ne sert à rien de culpabiliser, tu sais<nbsp>? Au contraire, tu devrais être fier de ce qu'elle a accompli.
#. speaker: WILFSUNN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003600_WILFSUNN:1"
msgid "Don't blame yourself for her death. Celebrate her life. You know that's what she'd want."
msgstr ""

#. ja: 私たちに怒ってることがあるとすれば、<br>それは、あんたと一緒に泣けなかったことだよ。
#. de: Es gibt nur eine Sache, wegen der ich dir ernsthaft böse sein könnte. Dass du nicht bei uns warst, um gemeinsam um sie zu trauern.
#. fr: Si nous devions t'en vouloir pour une seule chose... c'est de ne pas avoir été avec nous pour pleurer sa disparition.
#. speaker: BLOEWYDA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003610_BLOEWYDA:1"
msgid "If there is one thing we resent you for, it was that we could not be there to mourn her with you..."
msgstr ""

#. ja: あんな震えた字の手紙だけよこして……<br>私たちで、あんたの分まで泣く羽目になったじゃないか。
#. de: Als wir deinen Brief erhielten<nbsp>... Kaum lesen konnten wir ihn, so sehr muss deine Hand beim Schreiben gezittert haben<nbsp>... Und sonst gar nichts von dir hörten? Da haben wir auch um dich geweint, Urianger.
#. fr: Nous avons versé tant de larmes, en lisant ton message, écrit d'une main tremblante... J'aurais tellement aimé pouvoir te serrer dans mes bras...
#. speaker: BLOEWYDA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003620_BLOEWYDA:1"
msgid "Reading the words you penned in that shaky hand... We must have cried as much for you as we did for her."
msgstr ""

#. ja: 本当に……申し訳が、ございません……。
#. de: Es tut mir so leid. So entsetzlich leid.
#. fr: Je suis ter<shy>ri<shy>ble<shy>ment désolé... Pour <i>tout</i>...
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003630_URIANGER:1"
msgid "I'm sorry. I truly, truly am..."
msgstr ""

#. ja: 私は、語れる言葉を持たなかった……<br>こみあげる気持ちも、よぎる思い出も、<br>ひとつとして、正しく言葉にできなかったのです……。
#. de: Ich fand einfach keine Worte. Für nichts, was ich empfand. Auch nicht für die Erinnerungen, die mich überkamen.
#. fr: À l'époque, je n'ai pas trouvé d'autre moyen de m'exprimer, tellement j'étais submergé par l'émotion et les souvenirs.
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003640_URIANGER:1"
msgid "I knew not what to say. Knew not how to express my feelings..."
msgstr ""

#. ja: 積み上げてきた知識も、読み解いてきた詩も、無力でした。<br>私はただ……ただ、無力で…………。
#. de: All das Wissen, das ich mir aneignete. Die Poesie, die ich verinnerlicht hatte<nbsp>... Unbedeutend. Machtlos. Bei den Göttern<nbsp>... Ich fühlte mich so ohnmächtig<nbsp>...
#. fr: Dans ces moments, on se rend compte à quel point on est impuissant. Malgré les années consacrées à étendre mes con<shy>nais<shy>san<shy>ces, à déchiffrer des prophéties, je me suis senti tellement insignifiant...
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003650_URIANGER:1"
msgid "The poems and platitudes of wiser men. Musings on sadness and loss... Studied and memorized...and meaningless in the moment."
msgstr ""

#. ja: 馬鹿だね……誰だってそうさ……。<br>私たちだって、あの子を……<br>この悲しみを語れはしないよ……。
#. de: Dummerchen. Denkst du, uns ist es anders ergangen? Kein Wort brachten wir heraus<nbsp>... Da war nur diese tiefe, tiefe Trauer um unser Mädchen.
#. fr: Enfin, ne dis pas ça. C'est pareil pour tout le monde... Nous-mêmes, notre seule réponse a été de nous murer dans le chagrin.
#. speaker: BLOEWYDA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003660_BLOEWYDA:1"
msgid "Silly boy... We are all powerless before such grief. Even now, try as I might, the words escape me..."
msgstr ""

#. ja: だからちゃんと、わかってた……わかってたんだよ……。
#. de: Wir verstehen, wie es dir ergangen ist. Wirklich.
#. fr: Nous comprenons, tu sais. Nous comprenons ce que tu ressens...
#. speaker: BLOEWYDA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003670_BLOEWYDA:1"
msgid "But in our hearts, we know. We always know."
msgstr ""

#. ja: ……君たちがまだ小さかったころ、<br>遊ぶことより学ぶことを愛した君を、冷やかした子がいたね。
#. de: Ich erinnere mich gut daran, als du noch jung warst. Ein Mädchen hat dich ständig gehänselt, weil du die Nase lieber in Bücher gesteckt hast, anstatt mit ihm zu spielen.
#. fr: Je me rappelle lorsque vous n'étiez encore que des enfants, un de vos camarades n'arrêtait pas de te taquiner parce que tu passais plus de temps à lire qu'à t'amuser.
#. speaker: WILFSUNN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003680_WILFSUNN:1"
msgid "I remember when you were young. How the lads teased you for choosing the company of books over others."
msgstr ""

#. ja: そのたびにムーンブリダが飛んでいって、喧嘩をした。<br>私たちがいさめても、「ウリエンジェはいい奴なんだ」と、<br>むくれるばかりでね……。
#. de: Und jedes Mal, wenn sie garstig zu dir war, hat sich Moenbryda auf sie gestürzt und sie haben gerauft. Unser Töchterchen davon abzubringen, war ein Ding der Unmöglichkeit. „Nein! Urianger ist ein lieber Kerl“, hat sie protestiert.
#. fr: À chaque fois, Moenbryda n'hésitait pas à se battre pour te défendre... Et quand nous la grondions, elle nous répétait sans cesse que tu ne méritais pas ce qui t'arrivait.
#. speaker: WILFSUNN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003690_WILFSUNN:1"
msgid "Our Moen didn't take kindly to that. “Be nice to Urianger!” she'd shout, and give them a walloping. No matter how many times we scolded her..."
msgstr ""

#. ja: だったら相手を叩くんじゃなくて、<br>あんたがウリエンジェと周りを繋がないとって言ったら、<br>「そうかぁ」なんて、腕組みして唸ってさ……。
#. de: Und was haben wir geschimpft! Dann solle sie sich lieber um dich kümmern, anstatt mit dem Mädchen zu raufen. Ich sehe sie heute noch vor mir. Die Arme vor der Brust verschränkt, die Stirn in Falten gelegt und ganz grummelig dachte sie darüber nach.
#. fr: Ce n'est pas faute d'avoir essayé de lui expliquer qu'il valait mieux réconcilier tout le monde et éviter la bagarre<nbsp>! Je la vois encore grogner les bras croisés, pas vraiment convaincue...
#. speaker: BLOEWYDA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003700_BLOEWYDA:1"
msgid "So we offered a suggestion: rather than starting fights, why don't you be the bridge between Urianger and the others? She had to mull it over for a while. Arms crossed, brow furrowed in intense thought..."
msgstr ""

#. ja: それからは、前よりも強引にあんたを連れ出してみたり、<br>考えてることがわかるようにって、同じ本を読もうとしたり……
#. de: Seither wart ihr beiden unzertrennlich. Sie hat dich überall hin mitgeschliffen, ob du wolltest oder nicht. Und sie hat exakt die Bücher gelesen, die du auch gelesen hast. Um dir eine bessere Freundin zu sein.
#. fr: Finalement, elle s'est mis en tête de t'emmener pour jouer plus souvent, mais elle a aussi commencé à mieux te comprendre, et à s'intéresser aux livres que tu lisais...
#. speaker: BLOEWYDA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003710_BLOEWYDA:1"
msgid "But from that day on, she never let you be alone. She'd drag you outside to play, pepper you with endless questions, read the same books you read...all to try and understand you that much better."
msgstr ""

#. ja: 当時のあんたにとっちゃいい迷惑だったかもしれないけど、<br>あの子なりに、とてもがんばっていたんだよ。
#. de: Vermutlich ist sie dir damals mit ihrer Klammerei ziemlich auf den Geist gegangen<nbsp>... Aber es war ihre Art, sich um dich zu bemühen. Dich zu beschützen.
#. fr: Tu la trouvais peut-être un peu collante à l'époque, mais c'était sa façon à elle de veiller sur toi.
#. speaker: BLOEWYDA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003720_BLOEWYDA:1"
msgid "I'm sure it was annoying and exhausting at the time...but she only ever had the best of intentions."
msgstr ""

#. ja: そして君は今、こうして大勢の中にいる。<br>それどころか、絆を結ぶ手助けまでしているね。
#. de: Und jetzt schau dich nur an, das Zentrum der Aufmerksamkeit. Nun hilfst du selbst, Bande zu schmieden.
#. fr: Regarde-toi, aujourd'hui, au centre de l'attention... Maintenant, c'est toi qui contribues à créer des liens.
#. speaker: WILFSUNN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003730_WILFSUNN:1"
msgid "And look at you now. At the center of the crowd─the reason there even is a crowd, having brought these people together."
msgstr ""

#. ja: 私たちは、そのことが……たまらなく嬉しいんだ。
#. de: Das zu sehen<nbsp>... Es gibt kaum etwas Schöneres für uns.
#. fr: Il n'y a rien qui pourrait nous rendre plus heureux.
#. speaker: WILFSUNN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003740_WILFSUNN:1"
msgid "You've no idea how proud we are."
msgstr ""

#. ja: ムーンブリダが信じた人は、力いっぱい押した背中は、<br>そのあともちゃんと歩き続けてくれていた。
#. de: Der Junge, in dem unsere Moenbryda etwas Besonderes erkannt hat<nbsp>... Um den sie sich stets so sehr bemüht hat, ihn mit all ihrer Kraft unterstützt hat<nbsp>... Schau, was aus ihm geworden ist.
#. fr: Celui en qui notre petite a toujours cru, celui qu'elle a encouragé de toutes ses forces... Quelle joie de voir ce qu'il est devenu<nbsp>!
#. speaker: BLOEWYDA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003750_BLOEWYDA:1"
msgid "To see the boy our daughter trusted and believed in more than anyone...grow into the man she always knew he could be."
msgstr ""

#. ja: うちの自慢の娘の笑顔を、今日はとても近くに感じるよ。<br>ありがとう……ウリエンジェ。
#. de: Wenn ich dich heute so sehe, dann fühle ich mich meinem Mädchen entsetzlich nahe. Wir sind so, so stolz auf dich, Urianger.
#. fr: En ce jour, le joli sourire de notre fille bien-aimée est plus vif que jamais dans notre esprit. Merci, Urianger...
#. speaker: BLOEWYDA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003760_BLOEWYDA:1"
msgid "I can see her in you, too. Feel her. She walks with you, wheresoever you go. So thank you, Urianger. For being who you are."
msgstr ""

#. ja: っ…
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003770_URIANGER:1"
msgid "Report if displayed."
msgstr ""

#. ja: ……はい、私も今やっと……やっと思い出せています……。
#. de: Ja, ich<nbsp>... Endlich. Endlich erinnere ich mich auch wieder<nbsp>...
#. fr: Merci à vous... de me permettre de me rappeler, moi aussi... comme elle était radieuse...
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003780_URIANGER:1"
msgid "I...I think...I can feel her, too..."
msgstr ""

#. ja: あの笑顔はまぶしく、あたたかく……<br>悲しいものではなかったことを。
#. de: An ihr warmes, ansteckendes Lächeln. Nicht der kleinste Funke von Traurigkeit<nbsp>...
#. fr: Son sourire, chaleureux et bien<shy>veil<shy>lant... Toujours sans l'ombre d'un tourment.
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003790_URIANGER:1"
msgid "The truth...of her life. Not sorrow...but hope. And love..."
msgstr ""

#. ja: ウリエンジェには、大切な方がいらっしゃったのですね。
#. de: Diese Person muss sehr wichtig für Urianger gewesen sein<nbsp>...
#. fr: Alors comme ça, Urianger avait quelqu'un à qui il tenait énormément...
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003800_LIVINGWAY:1"
msgid "This Moenbryda...she was important to him, wasn't she?"
msgstr ""

#. ja: ……気になるか？
#. de: ... Fasziniert dich das?
#. fr: ... Ça t'intéresse<nbsp>?
#. speaker: THANCRED
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003810_THANCRED:1"
msgid "...You could ask the man himself."
msgstr ""

#. ja: いいえ、わたくしはただ……<br>まだ知らないことが多いのだと、思い直しただけですわ。
#. de: Nein, nein. Es<nbsp>... zeigt mir nur, dass es noch so vieles gibt, was ich nicht kenne und verstehe.
#. fr: Non, je me disais juste qu'il me restait encore tellement à apprendre au sujet des humains...
#. speaker: LIVINGWAY
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003820_LIVINGWAY:1"
msgid "Oh no, no. But watching this exchange reminds me how much I've yet to learn about your world...and its people."
msgstr ""

#. ja: そうだな、生まれたときからここにいたって、<br>知らないこと、わからないこと、足りないことだらけだ。
#. de: Mach dir nichts draus. Ich lebe seit meiner Geburt auf diesem Planeten und selbst für mich gibt es noch so viel, was ich nicht verstehe. Und Dinge, die ich verpasst habe.
#. fr: Tu sais, même pour ceux qui sont nés sur cette planète et y ont passé toute leur vie, il reste quantité de mystères et de merveilles à découvrir.
#. speaker: THANCRED
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003830_THANCRED:1"
msgid "You can live here your entire life and hardly learn a thing."
msgstr ""

#. ja: だから……この星はまだ、終わるには早すぎるんだよ。
#. de: Deshalb kommt dieses Ende auch viel zu früh<nbsp>...
#. fr: C'est bien pour ça qu'on ne peut pas la laisser disparaître comme ça...
#. speaker: THANCRED
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003840_THANCRED:1"
msgid "That's why...it's too soon for this to end."
msgstr ""

#. ja: あら、あなたも手が空いたのかしら？
#. de: Sag bloß, du drehst hier auch nur Däumchen?
#. fr: Toi aussi, tu te tournes les pouces<nbsp>?
#. speaker: YSHTOLA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003850_YSHTOLA:1"
msgid "All set, I take it?"
msgstr ""

#. ja: こっちも、やれそうな仕事は片づけてきたぞ。<br>荷運びやら、逃げた動物の捕獲やら……<br>役に立ったのかはわからんがな。
#. de: Wir haben alles getan, was wir tun konnten. Kisten schleppen, alle möglichen Viecher fangen<nbsp>... Aber es ist fraglich, ob wir tatsächlich nützlich waren oder einfach nur beschäftigt worden sind.
#. fr: On s'est chargés de tout ce qui était dans nos cordes. Transporter des caisses, rattraper une bestiole qui s'était échappée... C'est pas ça qui va sauver le monde, mais bon.
#. speaker: ESTINIEN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003860_ESTINIEN:1"
msgid "We've finished what we could. Delivered supplies, tracked down escaped animals...trivial tasks as they may be."
msgstr ""

#. ja: 十分なんじゃない？<br>ここにきて大きな仕事が残ってるようだったら、<br>それはそれで、マズそうだし……。
#. de: Ich sehe darin kein Problem. Wär ja noch schöner, wenn du nur hier herumlungern würdest, obwohl noch ein ganzer Berg Arbeit zu tun ist.
#. fr: C'est tant mieux, non<nbsp>? S'il restait encore de gros travaux à accomplir à ce stade, on aurait des raisons de s'inquiéter.
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003870_ALISAIE:1"
msgid "That's enough, don't you think? If there was anything more important still undone, that would be a problem in itself."
msgstr ""

#. ja: 荷や人の積み込みはともかく、<br>方舟そのものの準備は順調そうだったな。<br>あとはエーテル縮退炉さえどうにかなれば、って感じだ。
#. de: Sieht man von der Beladung und der Bemannung einmal ab, laufen die Vor<shy>bereitungen für die Arche wie am Schnürchen. Jetzt müsste nur noch das Problem um den Ätherantrieb behoben werden<nbsp>...
#. fr: Le chargement des mar<shy>chan<shy>di<shy>ses et l'embarquement des passagers vont bon train, le vaisseau sera bientôt prêt à décoller. Une fois qu'on aura rrréglé le problème du réacteur, bien sûr...
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003880_GRAHATIA:1"
msgid "The vessel is essentially ready for departure. All that remains is to load the final batch of supplies and see everyone on board. Once we've readied the aetherburner, that is..."
msgstr ""

#. ja: ああ、ここに集まってたのか。
#. de: Ah, hier seid ihr also.
#. fr: Ah, vous êtes tous là.
#. speaker: THANCRED
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003890_THANCRED:1"
msgid "Ah...had a feeling we might find you all here."
msgstr ""

#. ja: レポリットたちへの相談も、ひとまず落ち着きました。<br>話を聞いて安堵した様子の方もいれば、<br>最後まで調整を続けると息巻いている方もおいででしたよ。
#. de: Der Austausch zwischen den Loporrit und Sharlayan läuft ganz wunderbar. Ihre Anwesenheit sorgt teils für Erleichterung, teils spornt es die Arbeiter an, noch bis zur letzten Sekunde Anpassungen vorzunehmen.
#. fr: Les Sharlayanais semblent satisfaits de leurs échanges avec les Loporrites. Certains sont rassurés, d'autres se focalisent sur les derniers ajustements.
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003900_URIANGER:1"
msgid "Our consultations with the Loporrits, too, have run their course. Pleased I am to say that our researchers' concerns have for the most part been allayed, though some insist on making adjustments to the very end."
msgstr ""

#. ja: リヴィングウェイたちも、<br>それぞれの研究者に付き添いたいと言ってくれました。<br>今しがた、送り届けてきたところです。
#. de: Livingway und die anderen wollten sich den Forschern anschließen. Ich habe sie gerade eben verabschiedet, fürs Erste.
#. fr: Quant à Livingway et ses compagnons, ils m'ont fait part de leur envie d'assister les scien<shy>ti<shy>fi<shy>ques dans leurs travaux. Je viens tout juste de les mettre en relation.
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003910_URIANGER:1"
msgid "For their part, Livingway and her peers have graciously offered to stay and keep the people company, lest any lingering queries go unanswered."
msgstr ""

#. ja: さて、こうなるとエクスアダマントを待つばかりだが……
#. de: Also fehlt jetzt nur noch das Edel-Adamantit<nbsp>...
#. fr: Il ne nous reste plus qu'à attendre des nouvelles de tous nos amis improvisés chercheurs d'exadamantium...
#. speaker: THANCRED
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003920_THANCRED:1"
msgid "All that remains is to wait for the refined adamantite..."
msgstr ""

#. ja: (-クルル-)アルフィノくん、聞こえる？<br>こちらクルルよ。
#. de: (-Krile-)Alphinaud, hörst du mich? Krile hier.
#. fr: (-Voix de Krile-)Alphinaud, tu m'entends<nbsp>? C'est Krile.
#. speaker: KRILE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003930_KRILE:1"
msgid "(-Krile-)Alphinaud, are you there? It's me, Krile."
msgstr ""

#. ja: (-クルル-)お待ちかねの品が届いたわ！<br>至急、みんなと一緒に地上にあがって、港へ来て！
#. de: (-Krile-)Das Warten hat ein Ende! Ruf alle zusammen und kommt zum Hafen, schnell!
#. fr: (-Voix de Krile-)La livraison qu'on espérait tant est arrivée<nbsp>! Viens vite au port avec tout le monde<nbsp>!
#. speaker: KRILE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003940_KRILE:1"
msgid "(-Krile-)Your special delivery has arrived! Round up everyone and come to the harbor at once!"
msgstr ""

#. ja: 噂をすれば……だ！<br>行ってみよう！
#. de: Hah. Wenn man vom Eufel spricht<nbsp>... Gehen wir!
#. fr: Quand on parle du loup... Venez, mes amis<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003950_ALPHINAUD:1"
msgid "Speak of the devil... Let us go at once!"
msgstr ""

#. ja: フルシュノ様、お忙しいところ失礼します！<br>緊急のご報告が……！
#. de: Meister Fourchenault, bitte verzeiht die Störung. Ich bringe dringliche Kunde.
#. fr: Messire Fourchenault, excusez-moi de vous déranger en plein travail<nbsp>!
#. speaker: OFFICECLERK
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003960_OFFICECLERK:1"
msgid "Forgive the intrusion, Master Fourchenault─I bring urgent news!"
msgstr ""

#. ja: それが、その、なんというか……<br>知神の港が大変なことになっておりまして……ッ！
#. de: An Thaliaks Pforte<nbsp>... Also, wie soll ich das am besten sagen<nbsp>... Dort ist das pure Chaos ausgebrochen!
#. fr: Sur le port, c'est... c'est la confusion la plus totale<nbsp>! Je ne peux pas vous l'expliquer, il faut que vous veniez voir ça par vous-même<nbsp>!
#. speaker: OFFICECLERK
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003970_OFFICECLERK:1"
msgid "A great commotion has broken out in Scholar's Harbor. Your presence is requested with all speed!"
msgstr ""

#. ja: すみません、ちょっと通ります……！
#. de: Wenn wir um etwas Platz bitten dürften<nbsp>...
#. fr: Laissez-nous passer, s'il vous plaît...<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003980_ALPHINAUD:1"
msgid "Now, where might this delivery be?"
msgstr ""

#. ja: これは……！
#. de: Das<nbsp>...!
#. fr: Ça alors...<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_003990_ALPHINAUD:1"
msgid "Oh!"
msgstr ""

#. ja: だから、困りますってば！<br>許可もなく、こんなに荷物を持ち込まれては！
#. de: Aber das geht doch so nicht! Ihr könnt hier nicht einfach derart viele Güter abladen, ohne jegliche Befugnisse!
#. fr: Mais puisque je vous dis que vous avez besoin d'une au<shy>to<shy>ri<shy>sa<shy>tion pour déposer ces mar<shy>chan<shy>di<shy>ses<nbsp>!
#. speaker: IMMIGRATIONCONTROLSTAFF
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004000_IMMIGRATIONCONTROLSTAFF:1"
msgid "I'm sure it's very important, but we cannot accept these without the proper permits!"
msgstr ""

#. ja: すごい……まさか、これ全部……？
#. de: Bei den Göttern<nbsp>... Ist das alles<nbsp>...?
#. fr: C'est bien ce que je pense<nbsp>!? Incroyable...
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004010_ALISAIE:1"
msgid "By the Twelve! Surely these can't all be..."
msgstr ""

#. ja: な、なんじゃこりゃあ！<br>ここにいる全員、あの海賊船も飛空艇も、<br>荷物を届けにきた連中だってのか！？
#. de: Was ist denn hier los?! Piraten, Luftschiffe und weiß der Behemoth, was noch! Und sie alle kommen mit Lieferungen?!
#. fr: Qu'est-ce que c'est que ce bazar<nbsp>? Ils se sont donné le mot pour arriver tous en même temps ou quoi<nbsp>?
#. speaker: KOKKOLDANKKOL
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004020_KOKKOLDANKKOL:1"
msgid "Bleedin' hellfire! They're bringin' 'em by sea <i>and</i> by air! All these folks and these crates..."
msgstr ""

#. ja: よう、待たせたな。<br>依頼の品、キッチリお届けに上がったぜ。<br>……見た感じ、うちがいちばん大量だな！
#. de: Besser spät als nie, was? Wie versprochen: dicke, fette Beute! Und die Henkershorde hat den größten Fang an Land gezogen, das sag ich euch!
#. fr: Salut, et désolé pour le retard<nbsp>! Comme convenu, on vous apporte le matos dont vous avez besoin. À vue de nez, c'est les Bourreaux qui en ont dégoté le plus<nbsp>!
#. speaker: SICARD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004030_SICARD:1"
msgid "And more on the way. Got your adamantite right here─a bigger haul than any o' these sorry bastards brought, and that's no lie!"
msgstr ""

#. ja: そりゃ、グリダニアとウルダハの分も預かってるからだろ。<br>威張るなよな。
#. de: ... Weil ihr die Kisten aus Ul'dah und Gridania geladen habt. Werd nicht arrogant.
#. fr: Ça va, les chevilles<nbsp>? Vous oubliez un peu vite qu'il y avait aussi toute la cargaison d'Ul'dah et de Gridania sur votre navire.
#. speaker: EMMANELLAIN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004040_EMMANELLAIN:1"
msgid "Yes, because you were charged with seeing the shipments from Gridania and Ul'dah here along with your own. Give credit where credit is due."
msgstr ""

#. ja: アァ？　負け惜しみか？<br>っつーかお前、本当にダラガブ片まで行ったのかよ？
#. de: Oh, Verzeihung. Das Herzoglein ist wohl ein schlechter Verlierer. Dabei warst du dir zu fein, Dalamuds Splitter die Stirn zu bieten<nbsp>...
#. fr: Bah alors, le fiston à son papa est mauvais perdant<nbsp>? Je parie que t'as même pas osé t'approcher d'un des fragments de Dalamud<nbsp>!
#. speaker: SICARD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004050_SICARD:1"
msgid "Sounds like the sorry whingin' of a sore loser─an' a hypocrite to boot. Ain't no way a scrawny whelp like you took a dozen steps inside a Dalamud shard."
msgstr ""

#. ja: おう、入口まで行ったぞ！<br>あとはツテを辿って、こういうお宝探索の専門家、<br>空賊たちに話を持っていったりしたな！
#. de: Verleumdung! Bis zum Eingang bin ich gegangen! Außerdem habe ich mein diplomatisches Geschick spielen lassen und meine eigenen Piraten zum Beutezug gebeten. Luftpiraten, nämlich.
#. fr: Faux, je suis allé jusqu'à l'entrée<nbsp>! Et j'ai aussi fait jouer mes relations pour mettre sur le coup de <i>vrais</i> experts de la chasse au trésor, des pirates <i>des cieux</i><nbsp>!
#. speaker: EMMANELLAIN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004060_EMMANELLAIN:1"
msgid "I'll have you know I went all the way to the entrance! Furthermore, 'twas my contacts that enabled us to enlist the cooperation of the sky pirates."
msgstr ""

#. ja: へへん、当たり前だろ！<br>突入部隊が安心して先を目指せるように、<br>入口を護る大役を務めたぜ！
#. de: Verleumdung! Ich habe das Kommando über den Wachtrupp am Eingang des Splitters übernommen, um dem Bergungstrupp den Rücken freizuhalten!
#. fr: Bien sûr que si<nbsp>! J'ai assumé le rôle ô combien important de surveiller l'entrée et les environs, pour que les chasseurs de trésors puissent se consacrer à ce qu'ils savent faire le mieux<nbsp>!
#. speaker: EMMANELLAIN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004070_EMMANELLAIN:1"
msgid "I'll have you know I went all the way to the entrance! I played a vital role in keeping a lookout whilst our expeditionary forces secured the adamantite."
msgstr ""

#. ja: ま、適材適所だな。<br>あんなヤベェ場所にボンクラ貴族を連れてっても、<br>おもりしきれねぇし。
#. de: Schon klar. Jeder tut eben das, was er am besten kann, was? Und was soll man von einem Schnösel an einem solchen Ort schon erwarten? Steht vorm Eingang und pudert seine Perücke<nbsp>...
#. fr: C'est bien ce que je disais, t'as eu la trouille d'aller là où ça chauffait vraiment. Bah, il vaut mieux que tu restes à te poudrer le nez plutôt que de gêner ceux qui font le vrai boulot<nbsp>!
#. speaker: SICARD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004080_SICARD:1"
msgid "Left you outside so you wouldn't get anyone killed, did they? Well then, credit where credit's due─you did a right fine job sittin' on your arse!"
msgstr ""

#. ja: なにをー！
#. de: Du kleiner<nbsp>...
#. fr: Comment osez-vous<nbsp>!?
#. speaker: EMMANELLAIN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004090_EMMANELLAIN:1"
msgid "Take that back!"
msgstr ""

#. ja: やるかぁ！？
#. de: Ja, sprich dich ruhig aus!
#. fr: Quoi, tu veux te battre<nbsp>?
#. speaker: SICARD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004100_SICARD:1"
msgid "Make me!"
msgstr ""

#. ja: 負けるからやりませーん
#. de: Unter meinem Niveau ist das!
#. fr: Je ne m'abaisserai pas à ça<nbsp>!
#. speaker: EMMANELLAIN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004110_EMMANELLAIN:1"
msgid "I will not stoop to your level!"
msgstr ""

#. ja: みなさん、ご無沙汰しておりマ～ス！
#. de: Seid gegrüßt, meine lieben Freunde! Lange ist es her!
#. fr: Bonjour, mes amis<nbsp>! Cela faisait si longtemps<nbsp>!
#. speaker: HANCOCK
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004120_HANCOCK:1"
msgid "My, what a grand welcome party!"
msgstr ""

#. ja: ハンコック殿！？<br>ソロバンまで、どうして……！
#. de: Hancock! Und Soroban, du bist auch gekommen!
#. fr: Messire Hancock, Soroban<nbsp>! Que faites-vous ici<nbsp>?
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004130_ALPHINAUD:1"
msgid "Hancock! And Soroban!"
msgstr ""

#. ja: いやなに、東方連合が集めた神器やアラグの魔器、<br>その他諸々こころづけを、代表してお持ちしたのデ～ス。
#. de: Selbstverständlich! Wir sind die Repräsentanten der östlichen Verbände und bringen göttliche Schätze, allagische Artefakte und mehr!
#. fr: Je vous apporte la con<shy>tri<shy>bu<shy>tion de la coalition orientale. Des artefacts allagois, des reliques sacrées, et plus encore<nbsp>!
#. speaker: HANCOCK
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004140_HANCOCK:1"
msgid "We come bearing relics both sacred and Allagan─as well as a few other gifts that may be of help─to be presented with best wishes from the Eastern alliance."
msgstr ""

#. ja: 例えば、ボズヤ・レジスタンスが押収したアラグの遺物など……<br>「解放者殿ならば正しく役立ててくださるでしょう」と、<br>快く提出してくださいましたヨ！
#. de: Viele davon kommen direkt vom bozianischen Widerstand. Für <if $gn4>die Befreierin<else>den Befreier</if> gibt man sie doch gerne her, hieß es. Mitsamt wärmsten Grüßen.
#. fr: Figurez-vous que nous avons reçu un don conséquent de la résistance bozjienne. Ils m'ont dit qu'ils étaient ravis de rendre service <if $gn4>à la grande libératrice<else>au grand libérateur</if><nbsp>!
#. speaker: HANCOCK
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004150_HANCOCK:1"
msgid "Our friends in Bozja, for instance, have sent along a few artifacts for the “brave allies of the Resistance.” That's you!"
msgstr ""

#. ja: ついでに、バル島に保管されていた品の中で使えそうなものを、<br>エジカ・ツンジカさんより預かってまいりました。<br>「急に探せるか！」と怒ってましたがネ！
#. de: Ejika Tsunjika hat außerdem einige magische Kleinodien beigetragen, die sich auf der Insel Val befanden. Selbst wenn er gezetert hat wie ein Straßenspatz, dass er auf die Schnelle kaum etwas auftreiben könne<nbsp>...
#. fr: Il y a aussi des objets qui étaient entreposés sur l'île de Val, de la part d'Ejika Tsunjika. Il semblait en avoir davantage en réserve, mais il s'est plaint de ne pas avoir assez de temps pour les chercher.
#. speaker: HANCOCK
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004160_HANCOCK:1"
msgid "And we've brought a number of items from Eureka as well, courtesy of one Ejika Tsunjika! He says, “A little advance warning would have been appreciated,” by the by."
msgstr ""

#. ja: ついでに、バル島に保管されていた品の中で使えそうなものを、<br>現地に残っている調査員から預かってまいりました。
#. de: Die verbliebenen Forscher auf der Insel Val haben außerdem einige magische Kleinodien beigetragen. Sie haben jeden letzten Winkel nach Brauchbarem durchkämmt.
#. fr: Il y a aussi des objets qui étaient entreposés sur l'île de Val, de la part des explorateurs qui continuent leurs études sur place.
#. speaker: HANCOCK
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004170_HANCOCK:1"
msgid "And we've brought a number of items from Eureka as well, courtesy of our hardworking expedition members!"
msgstr ""

#. ja: オイラも、神器のお届けに来たんだよぉ～。<br>博識のセンリがおやつを求めてクガネに行ったとき、<br>たまたまハンコックがその話をしてるのを聞いたそうでさぁ～。
#. de: Ich habe die göttlichen Schätze<nbsp>...... mitgebracht. Senri ist auf der Suche nach Süßigkeiten nach Kugane gelaufen. Da hat er Hancock überhört. Wie er darüber gesprochen<nbsp>...... hat.
#. fr: Quant à moi, j'ai été mis au courant par Senri, qui a rencontré Hancock en allant chercher des douceurs à Kuganeeee. Je vous apporte une relique très précieuuuuse.
#. speaker: SOROBAN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004180_SOROBAN:1"
msgid "I myself have come with a sacred relic of Reisen Temple. 'Twas passing fortunate that Senri's dango craving brought us to Kugane─we arrived precisely as Hancock was making his arrangements."
msgstr ""

#. ja: 醴泉神社のみんなで相談して、秘蔵の神器、<br>テンゼンの愛刀「鳳凰丸」を貸すことにしたんだよぉ～。
#. de: Also sind wir zum Reisen-Schrein gegangen, haben uns besprochen und entschieden<nbsp>...... dass wir euch Hoomaru überlassen. Tenzens liebstes<nbsp>...... Schwert.
#. fr: Il s'agit de Hôômaru, le fidèle katana de Tenzeeeen. Au sanctuaire Reisen, tout le monde était d'accord pour vous le prêter, sauf Suzaku et Seiryû qui craignaient pour sa sécuritéééé.
#. speaker: SOROBAN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004190_SOROBAN:1"
msgid "Upon learning of your need, we made haste back to Hells' Lid─with our dango, never fear─and consulted with the other auspices. All consented to the lending of Tenzen's legendary Phoenix Blade for this noble cause."
msgstr ""

#. ja: けど、とくに朱雀と青龍が心配しちゃってさぁ～。<br>渡すまでついてくるっていうから、<br>近場にいて信頼できる海賊衆に託そうとしたんだぁ～。
#. de: Ich wollte es den Piraten geben. Aber vor allem Suzaku und Seiryu war das nicht<nbsp>...... geheuer. Sie sagten, dass sie mir folgen würden<nbsp>...... bis ich das Schwert der Konföderation überreiche.
#. fr: J'ai eu beau leur répéter qu'on pouvait faire confiance aux pirates qui allaient le transporter, ils ont quand même insisté pour être du voyaaaage...
#. speaker: SOROBAN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004200_SOROBAN:1"
msgid "Suzaku and Seiryu were nevertheless worried that it might be lost in transit, however, and insisted upon accompanying me to Onokoro, where I had intended to entrust it to our Confederate allies."
msgstr ""

#. ja: そしたら、そこにハンコックもいてさぁ～。<br>よかったぁ～って思ったんだけど、<br>青龍が今度は、ちゃんと見届けるまで帰ってくるなって……。
#. de: Da war dann auch Hancock! Was für ein Glück, habe ich mir<nbsp>...... gedacht. Aber Seiryu war das nicht genug. Ich muss es persönlich abliefern gehen, hat er<nbsp>...... gesagt.
#. fr: Heu<shy>reu<shy>se<shy>ment, j'ai appris que Hancock supervisait l'acheminemeeeent<nbsp>! Je pensais que tout le monde serait rassuré, mais Seiryû a exigé que je reste avec le sabre... donc me voilàààà.
#. speaker: SOROBAN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004210_SOROBAN:1"
msgid "I thought instead to give it over to Hancock when we chanced to cross paths yet again, but alas, Seiryu remained ill at ease, and ordered me see the blade into your hands personally “or die trying”..."
msgstr ""

#. ja: オイラもオイラもぉ～！<br>ハンコックから相談を受けたブンチン様が、<br>碧甲羅の神器を持っていってやりなさいって言ってさぁ～。
#. de: Ich bin auch hier, hallo! Der verehrteste Älteste Bunchin hat mir aufgetragen, die göttlichen Schätze der Blaupanzer<nbsp>...... herzubringen.
#. fr: Je suis là, moi aussiiii<nbsp>! Le vieux Bunchin m'a chargé de vous remettre une relique sacrée pré<shy>cieu<shy>se<shy>ment gardée par les Veeeerts.
#. speaker: SOROBAN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004220_SOROBAN:1"
msgid "I myself have come with a sacred relic of the Kojin. Upon learning of your need, Bunchin bade me deliver it on behalf of the Blue with all haste."
msgstr ""

#. ja: けど、オイラだけで運ぶのが難しかったから、<br>海賊衆に手伝ってもらおうと思ったんだぁ～。<br>結局、そこでハンコックに会えたんだけどねぇ～。
#. de: Aber allein kann ich doch gar nicht alles<nbsp>...... tragen. Also bin ich zu der Konföderation gegangen, um sie um Hilfe zu bitten. Zufällig traf ich dort dann<nbsp>...... Hancock.
#. fr: J'ai demandé aux pirates de la Confédération de s'occuper du transport, et c'est là que j'ai rencontré Hancoooock.
#. speaker: SOROBAN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004230_SOROBAN:1"
msgid "Fearing I could not swim here with the necessary speed, however, I thought to beg our Confederate allies for aid. To my delight, Hancock was already preparing for departure at the selfsame port, and had space for additional cargo."
msgstr ""

#. ja: そういうのを諸々集めた結果、かなりの量になりまして。<br>加えて一刻も早く……とのことでしたので、<br>知人の素晴らしいフネに乗せていただいた次第デス。
#. de: Es ist eine beachtliche Menge zusammengekommen, wie Ihr seht. Weitaus mehr als erwartet. Und da alles schleunigst geliefert werden sollte, habe ich kurzerhand einen alten Bekannten darum gebeten, sein wunderbares Schiff borgen zu dürfen.
#. fr: Avec tout cela, nous nous sommes finalement retrouvés avec une cargaison plus imposante que prévu. Et puisque l'urgence était de mise, je me suis arrangé pour emprunter le navire de vieilles con<shy>nais<shy>san<shy>ces.
#. speaker: HANCOCK
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004240_HANCOCK:1"
msgid "We did, of course, need quite the impressive vessel to get it all here in time."
msgstr ""

#. ja: 劇団マジェスティックのみなさんが、アナタによろしくと。<br>「光の戦士」の冒険譚に、再び劇場艇が出てくるとは光栄だと、<br>よろこんでおられましたヨ！
#. de: Selbstverständlich lassen Eure Freunde der Theater<shy>gruppe „Maiestas“ recht herzlich grüßen. Weiterhin richten sie aus, dass sie ihr traumhaftes Theaterschiff sehr gern für die aufregenden Abenteuer <if $gn4>der Kriegerin<else>des Kriegers</if> des Lichts zur Verfügung stellen.
#. fr: D'ailleurs, tous les membres de la Compagnie des Majestueux vous saluent<nbsp>! C'est pour eux une grande fierté que le Prima Vista fasse une nouvelle apparition dans le “roman épique de vos aventures”, m'ont-ils dit.
#. speaker: HANCOCK
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004250_HANCOCK:1"
msgid "Fortunately, our Majestic associates have been more than helpful. “'Tis an honor to join the Warrior of Light on another adventure,” they tell me!"
msgstr ""

#. ja: しかし……それだけ多くの神器や魔器を集めたとなると、<br>多額の費用がかかったのではないだろうか……？
#. de: Du liebe Güte<nbsp>... Die göttlichen Schätze und derart viele allagische Artefakte zusammenzutragen, das muss eine ganze Menge Gil gekostet haben.
#. fr: Cela a dû vous coûter une véritable fortune de réunir autant de reliques sacrées et d'artefacts allagois...
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004260_ALPHINAUD:1"
msgid "That is all wonderful to hear, but what of the extraordinary cost? I shudder to think of the ransom we must pay for such a bounty..."
msgstr ""

#. ja: オ～、もしやあとから請求されることを案じてますネ？
#. de: Ah. Fürchtet der junge Herr eine saftige Rechnung, wenn alles vorbei ist?
#. fr: Ne vous inquiétez pas, je vous ai gardé toutes les factures<nbsp>!
#. speaker: HANCOCK
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004270_HANCOCK:1"
msgid "Fret not for your coinpurse, young Alphinaud!"
msgstr ""

#. ja: しかしご心配なく。<br>東アルデナード商会としましては、ロロリト会長の指示のもと、<br>将来も見据えて「悪くないように」やっておりますのでネ！
#. de: Ich versichere, es besteht keinerlei Grund zur Sorge. Die Ostaldenard-Handelsgesellschaft und ihr ehrenwerter Vorsitzender Lolorito Nanarito tun ihr Äußerstes, um, Zitat: „den Karren aus dem Dreck zu ziehen und eine rosige Zukunft zu sichern!“
#. fr: Je plaisante, bien sûr. Soyez tranquilles, la Firme du commerce de l'Aldenard oriental est entre de bonnes mains avec le seigneur Lolorito, et cet in<shy>ves<shy>tis<shy>se<shy>ment est tout sauf désintéressé.
#. speaker: HANCOCK
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004280_HANCOCK:1"
msgid "Lord Lolorito looks ever towards the profits of the future, and thus the East Aldenard Trading Company went to some lengths to reduce the financial liability."
msgstr ""

#. ja: 加えて、「暁」からはすでに資金提供を受けておりマ～ス。<br>それを使ってそろえてきた品々デスから、<br>正真正銘、みなさんの戦利品デ～ス！
#. de: Außerdem haben wir bereits eine beträchtliche Gilsumme vom Bund der Morgenröte erhalten. Eine großzügige Finanzierung, die all das hier erst möglich gemacht hat! Was Ihr seht, ist letztlich allein Euch zuzuschreiben!
#. fr: Qui plus est, nous avons déjà reçu un généreux financement de la part des Héritiers de la Septième Aube<nbsp>! Tout ce que vous voyez ici vous appartient, et vous y avez mis le prix<nbsp>!
#. speaker: HANCOCK
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004290_HANCOCK:1"
msgid "And since the Scions funded the entire venture, not a gil need be rendered up in compensation. Everything is already yours!"
msgstr ""

#. ja: すでに資金提供を？<br>それは……
#. de: Eine großzügige<nbsp>... Finanzierung?
#. fr: Un financement... <i>généreux</i><nbsp>?
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004300_ALPHINAUD:1"
msgid "We funded the venture? When...?"
msgstr ""

#. ja: (-？？？？-)フーッフッフッフ！
#. de: (-???-)Hiiihihi!
#. fr: (-???-)Hé hé hé hé<nbsp>!
#. speaker: TATARU
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004310_TATARU:1"
msgid "(-???-)Muahahaha!"
msgstr ""

#. ja: (-？？？？-)私をケチなだけの金庫番だとお思いでっしたか？
#. de: (-???-)Hat da etwa jemand die Schatzmeisterin des Bundes unterschätzt?
#. fr: (-???-)Vous croyiez que la trésorière était une pince, c'est ça<nbsp>?
#. speaker: TATARU
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004320_TATARU:1"
msgid "(-???-)Don't let the name fool you─this <i>coinkeeper</i> knows a thing or two about spending."
msgstr ""

#. ja: 必要なときには、ドドーンと投資する！<br>そのために日ごろの節制と内職があるのでっす！
#. de: Ich bin doch kein Geizhals! Wenn ich investiere, dann richtig! Wozu denn sonst die ganze Mäßigung und all die anstrengenden Nebenerwerbe?
#. fr: Quand c'est nécessaire, il faut savoir dépenser<nbsp>! C'est en prévision d'un moment pareil qu'on s'est serré la ceinture pendant tout ce temps<nbsp>!
#. speaker: TATARU
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004330_TATARU:1"
msgid "When it comes to capital investiture, a sprinkling of gil here and there will not do! You need enough savings to make waves when it really counts...which is why frugality is paramount."
msgstr ""

#. ja: それだけではありません……<br>今回は、超強力なパトロンが力添えをしてくださいまっした。
#. de: Das allein war es aber nicht. Uns stand diesmal auch eine äußerst großzügige Gönnerin zur Seite.
#. fr: Mais ce n'est pas tout... Nous avons aussi reçu une importante donation d'un mécène qui a le cœur sur la main.
#. speaker: TATARU
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004340_TATARU:1"
msgid "We also had the benefit of a generous patron─“generous” being rather an understatement..."
msgstr ""

#. ja: 「暁」の設立当初、まだ資金の乏しい冬の時代……<br>そんなころから、こっそり支援してくださったこのお方……！
#. de: Eine ganz wunderbare Dame, die den Bund der Morgenröte schon klammheimlich unterstützt hat, als er noch in den Kinderschuhen steckte!
#. fr: Cette personne a soutenu les Héritiers de la Septième Aube dans le plus grand secret... Depuis les premiers jours, quand nous étions fauchés comme les blés<nbsp>!
#. speaker: TATARU
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004350_TATARU:1"
msgid "She has supported us from the shadows since the very founding of the Scions, ere we even had coffers to fill..."
msgstr ""

#. ja: って、お母様！？
#. de: M-Mutter? Du?!
#. fr: Hein<nbsp>!? Me dis pas que c'est maman<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004360_ALISAIE:1"
msgid "Mother!?"
msgstr ""

#. ja: アメリアンス……。
#. de: Ameliance<nbsp>...
#. fr: Ameliance...
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004370_FOURCHENAULT:1"
msgid "Ameliance..."
msgstr ""

#. ja: あら、私はあくまで中立よ？<br>けれど、あなたががんばって用意してくれている方舟にも、<br>うちの金庫を乗せたりはできないでしょう？
#. de: Entschuldigung? Ich bewahre Neutralität. Irgendwo muss das Geld schließlich hin. Wir können unseren Familientresor schlecht mit auf die Arche nehmen, oder?
#. fr: En toute neutralité, bien sûr<nbsp>! De toute façon, il n'y a pas de place pour notre coffre-fort familial sur le vaisseau que tu as préparé, j'imagine<nbsp>?
#. speaker: AMELIANCE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004380_AMELIANCE:1"
msgid "I remain, of course, an entirely neutral party. I simply thought our family's coffers were needlessly full."
msgstr ""

#. ja: だったら、空けてしまってもいいかなって。<br>使えるうちに使ってこそのお金だもの。
#. de: Unser Vermögen zurückzulassen, wäre auch Unsinn. Und wenn es doch nützlich angelegt werden kann<nbsp>...
#. fr: Ça n'avait aucun sens de garder tout cet argent, donc j'ai résolu de le dépenser à bon escient.
#. speaker: AMELIANCE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004390_AMELIANCE:1"
msgid "We can hardly take them with us on your “teeny-tiny toy boat,” now, can we? And 'twould be a shame to leave all that hard-earned wealth unspent."
msgstr ""

#. ja: ねー
#. de: Warum nicht?
#. fr: Pour la bonne cause<nbsp>!
#. speaker: AMELIANCE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004400_AMELIANCE:1"
msgid "Waste not!"
msgstr ""

#. ja: ねー
#. de: Warum nicht?
#. fr: Pour la bonne cause<nbsp>!
#. speaker: TATARU
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004410_TATARU:1"
msgid "Waste not!"
msgstr ""

#. ja: しかし、これだけの短時間に、よく連携がとれたな。<br>派遣団に参加していた連中以外にも、<br>ずいぶん広まってるようだが……。
#. de: Aber wie um alles in der Welt wurde das Ganze in so kurzer Zeit auf die Beine gestellt? Das ist ja längst nicht mehr nur das Ilsabard-Korps, das mitgeholfen hat<nbsp>...
#. fr: Dire qu'au début, seule la délégation d'Ilsabard était concernée... C'est un miracle d'avoir réussi à organiser une opération aussi complexe en si peu de temps.
#. speaker: THANCRED
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004420_THANCRED:1"
msgid "How ever did you manage so much in so short a time, though? We expected word to reach only a fraction of our allies..."
msgstr ""

#. ja: そこはほら、私にもツテがあるって言ったでしょう？
#. de: Ich sagte doch bereits, dass ich beträchtliche Kontakte vorzuweisen habe.
#. fr: Je vous avais bien dit que j'avais des relations<nbsp>!
#. speaker: KRILE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004430_KRILE:1"
msgid "Did I not tell you I have my ways?"
msgstr ""

#. ja: エレンヴィル！<br>あなたがクルルと組んでたの……！？
#. de: Erenville! Du hast Krile also geholfen?!
#. fr: Erenville<nbsp>! Vous étiez de mèche avec Krile<nbsp>!?
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004440_ALISAIE:1"
msgid "Erenville!? You were involved, too?"
msgstr ""

#. ja: おたくらとラヴィリンソスで別れたあと、<br>あらためてこのお嬢ちゃんから手紙をもらったんだよ。
#. de: Nachdem wir uns im Labyrinthos das letzte Mal gesehen hatten, erhielt ich noch einen Brief von der werten Dame hier.
#. fr: Après votre départ du Labyrinthos, j'ai reçu une lettre de cette jeune demoiselle.
#. speaker: ERENVILLE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004450_ERENVILLE:1"
msgid "I received a letter from Krile after we parted ways in Labyrinthos."
msgstr ""

#. ja: 「暁」が何を目的としてるか。<br>それから、世界中を飛び回ってるグリーナーの足と連絡網を、<br>いざってときには貸してほしい……ってな。
#. de: In ihm legte sie mir die Ziele des Bundes der Morgenröte dar und bat um die helfenden Hände und die weitschweifenden Kontakte der Klauber, die ja nun die ganze Welt bereisen.
#. fr: Elle m'y expliquait les aspirations des Héritiers de la Septième Aube, et me demandait de tenir les glaneurs à disposition.
#. speaker: ERENVILLE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004460_ERENVILLE:1"
msgid "She explained what the Scions were trying to accomplish, and why you might soon require the services of the gleaners, spread across the world as we are."
msgstr ""

#. ja: 俺らに、シャーレアンを裏切るつもりはない。<br>これまで命じられてきた収集が、<br>月へ知識を運び出すためだったってのも、まあいい。
#. de: Dies ist kein Verrat an Sharlayan, das will ich betonen. All das Wissen, das wir über die Jahre gesammelt haben, darf gerne gen Mond geflogen werden.
#. fr: Il ne s'agit en aucun cas d'une trahison envers Sharlayan. Tout le matériel livré par nos soins va servir à emporter notre savoir avec nous sur la lune, et je n'ai aucun problème avec ça.
#. speaker: ERENVILLE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004470_ERENVILLE:1"
msgid "I pray you do not interpret this as a betrayal of Sharlayan. I accept that the Forum's aim in pushing us to our limits was to preserve what knowledge we have, and I bear you no ill will for it."
msgstr ""

#. ja: だがな、俺らは自分で集めたからこそ知ってるんだ。<br>この星にはまだまだ、「未知」がたくさんあるってことを。
#. de: Aber eines können wir mit Sicherheit sagen. Wir, die das ganze Gestirn bereisen, um zu sammeln und zu katalogisieren: Es gibt noch so vieles, das wir nicht kennen.
#. fr: Par contre, c'est justement parce que les glaneurs ont sillonné le monde pour le collecter et le cataloguer que je peux l'affirmer<nbsp>: il nous reste <i>tout</i> à apprendre de cette planète.
#. speaker: ERENVILLE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004480_ERENVILLE:1"
msgid "Yet, in collecting that knowledge, what I came to appreciate most about our star is that there remains so much we do not know."
msgstr ""

#. ja: だから、終末と抗う道を探してる「暁」に手を貸した。<br>もっとも、人使いの荒さにかけては、<br>おたくらと同じくらいだったけどな。
#. de: Deswegen haben wir uns dazu entschlossen, dem Bund zu helfen, sich gegen diese Apokalypse zu stemmen. Nicht, dass wir dadurch weniger Arbeit gehabt hätten<nbsp>... Zeit für Pausen gönnt uns die Morgenröte genauso wenig.
#. fr: C'est ce qui m'a convaincu de soutenir les Héritiers dans leur lutte contre l'apocalypse. Si ça peut vous rassurer, ils ne m'ont pas plus ménagé que le Conseil pour arriver à leurs fins.
#. speaker: ERENVILLE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004490_ERENVILLE:1"
msgid "That is why I chose to help the Scions─to combat the obliteration of those countless undiscovered wonders. I held no illusions that they would be less demanding taskmasters...though rest assured, if I had, I would have been sorely disappointed."
msgstr ""

#. ja: ……ってなわけで、<br>グリーナーズ・ギルドシップが総力を挙げて連れてきたぜ。<br>これが最後の助っ人たちだ！
#. de: Zu guter Letzt haben wir noch eine besonders essenzielle Ressource aufgetan. Bitte sehr, die allerletzte Fuhre Helfer!
#. fr: Voilà, sans plus attendre, je vous présente la dernière équipe de volontaires prêts à rejoindre votre cause<nbsp>!
#. speaker: ERENVILLE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004500_ERENVILLE:1"
msgid "To make a long story short─the whole of the guildship cooperated to ensure your call was heard far and wide."
msgstr ""

#. ja: よう、宇宙を行く船を作ってるんだって？
#. de: Ich hab gehört, wir bauen ein Raumschiff?
#. fr: Alors comme ça, tu bidouilles un vaisseau spatial<nbsp>?
#. speaker: CID
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004510_CID:1"
msgid "What's this about a ship that can fly to the moon?"
msgstr ""

#. ja: これまで我が社を散々巻き込んできたんだ、<br>そんなおもしろそうな案件にだけ、除け者ってことはないよな。
#. de: Ihr habt doch nicht gedacht, dass ihr uns aus einem solch monumentalen Projekt ausschließen könnt? Wo die Metallwerke doch sonst bei allen Untergangsszenarien vertreten sind<nbsp>...
#. fr: C'est pas sympa de monter un projet aussi passionnant dans mon dos, après tout ce qu'on a vécu ensemble<nbsp>!
#. speaker: CID
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004520_CID:1"
msgid "And why didn't you mention it sooner? The one time you don't beg my aid, your problem's a bloody ship that can fly to the moon!"
msgstr ""

#. ja: シド……みんな……！
#. de: Cid! Schön, euch zu sehen!
#. fr: Ça alorrrs... Vous êtes tous là<nbsp>!
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004530_GRAHATIA:1"
msgid "Cid! You brought the team!"
msgstr ""

#. ja: ガーロンド・アイアンワークス、参上だ！<br>集まった素材を方舟に組み込む役目、<br>俺たちにも手伝わせてくれ。
#. de: Ganz recht. Die Gar<shy>lond-Me<shy>tall<shy>wer<shy>ke, stets zu Diensten! Irgendwer muss ja schließlich die ganzen Berge Material in die Arche einbauen, nicht wahr?
#. fr: Les Forges de Garlond, à votre service<nbsp>! On va s'occuper d'ajouter à votre vaisseau tous les matériaux que vous avez accumulés.
#. speaker: CID
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004540_CID:1"
msgid "Of course! Garlond Ironworks' finest. You need only point us towards my new favorite ship..."
msgstr ""

#. ja: おっと、もうひとつ伝えなきゃならないことがあった。<br>……ここに来る前、ウェルリトの、<br>ガイウスのところに寄ってきてな。
#. de: Ah, zunächst aber etwas anderes. Bevor wir nach Sharlayan kamen, haben wir in Werlyt vorbeigeschaut. Bei Gaius.
#. fr: Ah, j'allais oublier<nbsp>! Avant de venir, on a fait un petit détour du côté de Werlyt, histoire de saluer l'ami Gaius.
#. speaker: CID
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004550_CID:1"
msgid "Oh, I nearly forgot. We stopped by Werlyt before coming here and picked up a package from Gaius."
msgstr ""

#. ja: ウァレンスがアルテマウェポン研究のために溜め込んでた、<br>アラグの魔器を預かってきた。<br>見たところ、少量だがエクスアダマントが使われてる。
#. de: Er hat uns alle allagischen Artefakte überlassen, die Valens für die Forschung rund um die Ultima-Waffen gehortet hat. Soweit ich es beurteilen kann, ist in ihnen ebenfalls Edel-Adamantit verarbeitet.
#. fr: Il a eu la générosité de nous confier les artefacts allagois utilisés par Valens pour ses recherches sur les Armes. À mon avis, on devrait pouvoir en extraire un peu d'exadamantium.
#. speaker: CID
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004560_CID:1"
msgid "He's still of the mind that actions make for better penance than words─contrite or otherwise─so he offered none of the latter."
msgstr ""

#. ja: ガイウスが「暁」に対して贈れる、<br>どんな言葉よりも誠実な謝罪で、支援だろうよ。<br>受け取ってやってくれ。
#. de: Gaius lässt seine besten Grüße ausrichten. Er meinte, dieses Geschenk ist eine bessere Entschuldigung an den Bund der Morgenröte, als er sie jemals in Worte fassen könne.
#. fr: C'est sa façon à lui de soutenir les Héritiers, mais sûrement aussi de vous présenter ses plus sincères excuses, mieux qu'il aurait pu le faire avec des mots.
#. speaker: CID
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004570_CID:1"
msgid "What he sent is an Allagan relic Valens used in his Weapons experiments─has a fair bit of refined adamantite in it, too."
msgstr ""

#. ja: 私たちは、クルルさんから要請を受けて、<br>モードゥナのダラガブ片へ向かいました。
#. de: Krile hat uns damit beauftragt, Dalamuds Splitter in Mor Dhona anzugehen.
#. fr: Coultenet et moi, on a été contactés par Krile pour aller explorer le morceau de carcasse de Dalamud qui se trouve dans le Mor Dhona.
#. speaker: HOARYBOULDER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004580_HOARYBOULDER:1"
msgid "As you like as not suspect, we've also brought adamantite from Mor Dhona's Dalamud shard."
msgstr ""

#. ja: ……とはいえ、かの防衛機構を相手取るとなると、<br>「暁」の残存メンバーだけでは厳しいものがある。
#. de: Allerdings hätten die verbliebenen Mitglieder des Bundes nicht ausgereicht, um all die Abwehrmechanismen auszuschalten.
#. fr: Je dois vous avouer que pour un petit groupe d'Héritiers comme le nôtre, les systèmes de défense allagois étaient quasiment infranchissables.
#. speaker: HOARYBOULDER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004590_HOARYBOULDER:1"
msgid "I admit to some consternation upon first receiving Krile's message. So few Scions remain at the Rising Stones now─far too few for such an expedition."
msgstr ""

#. ja: そこへ、グリーナーの呼びかけによって、<br>イディルシャイアのトレジャーハンターたちが、<br>駆けつけてくれたのです。
#. de: Glücklicherweise traten dann die Klauber auf den Plan und baten um Hilfe. So haben sich alle tapferen Schatz<shy>sucher in Frohehalde zusammengetan und mit angepackt!
#. fr: Heu<shy>reu<shy>se<shy>ment, grâce à l'appel lancé par les glaneurs, nous avons reçu le soutien inattendu des chasseurs de trésors d'Idyllée.
#. speaker: HOARYBOULDER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004600_HOARYBOULDER:1"
msgid "However, the gleaners were able to secure us reinforcements, Idyllshire's treasure hunters not least among them."
msgstr ""

#. ja: その一団の中には、多くのゴブリン族の姿もありました。
#. de: Und stellt euch vor, unter ihnen war eine erstaunlich große Anzahl von Goblins!
#. fr: Vous n'allez pas le croire, mais il y avait aussi bon nombre de Gobelins parmi eux<nbsp>!
#. speaker: HOARYBOULDER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004610_HOARYBOULDER:1"
msgid "And ho, how the gobbieflock fought!"
msgstr ""

#. ja: イディルシャイアを仕切るスローフィクス氏が、<br>以前、ご息女のラウンドロクスが受けた恩に報いるとして、<br>一味を率いて来てくれたのです。
#. de: Schlafix ist gar mit einer kleinen Armee angerückt, ganz der Meister von Frohehalde. Um den Gefallen zu erwidern, den ihr seiner Tochter Rundblox einst erwiesen habt.
#. fr: Slowfix n'a pas oublié ce que vous avez fait pour sa fille Roundrox, et il a sauté sur l'occasion de vous rendre la pareille en rameutant ses troupes.
#. speaker: HOARYBOULDER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004620_HOARYBOULDER:1"
msgid "Slowfix's gratitude for the safe return of his daughter has not waned, and he gathered his kin to our side with an astounding quickness."
msgstr ""

#. ja: アラグの防衛機構対、ゴブリン族の機工兵器！<br>爆発やまぬ、あのアツい戦いを、<br>皆さんにもお見せしたかったくらいですよ！
#. de: Hah! Die allagischen Abwehrmechanismen gegen die Maschinerien der Goblins! Das war vielleicht ein Anblick! Es hat gar nicht mehr aufgehört zu krachen und zu poltern!
#. fr: Vous auriez vu le spectacle<nbsp>! Entre les pièges allagois et les gadgets des Gobelins, ça explosait de tous les côtés<nbsp>!
#. speaker: HOARYBOULDER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004630_HOARYBOULDER:1"
msgid "The clash between their machina and the Allagan defenses was a sight to behold. I wager even you would have been impressed by the magnitude of the gobbiebooms!"
msgstr ""

#. ja: ……で、お前はどうした？<br>分身とはいえ、終末の最中にお前が来たんだ、<br>野暮用じゃあなさそうだが。
#. de: Und was treibst du hier, mit deinem zweibeinigen Ich? Wir sind immer noch mitten im Weltuntergang, also kann's wohl keine vergnügliche Kreuzfahrt sein.
#. fr: Et toi, Vrtra, qu'est-ce que tu fais ici<nbsp>? On est à deux doigts de la fin du monde, et même si c'est pas en chair et en os, ça m'étonnerait que tu te sois déplacé juste pour le plaisir.
#. speaker: ESTINIEN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004640_ESTINIEN:1"
msgid "Fascinating as all this is, I fail to see how it explains your presence here. Does Radz-at-Han not have more pressing concerns?"
msgstr ""

#. ja: まずは、君たちにお礼を……<br>ガレマルドに向かった者たちを助けてくれたこと、<br>心より感謝申し上げる。
#. de: Um Euch noch einmal persönlich meinen Dank auszusprechen. Dafür, dass Ihr Euch in Garlemald so beherzt um den Schutz der Unsrigen bemüht habt.
#. fr: Pour commencer, j'aimerais vous remercier d'avoir sauvé les miens, en Garlemald.
#. speaker: VARSHAHN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004650_VARSHAHN:1"
msgid "We do─yet averting the Final Days would be the most expedient solution. That, and I am indebted to you."
msgstr ""

#. ja: 島を離れる決断をしたとはいえ、彼らは大切なラザハンの民だ。<br>救い出された者がいて、本当によかった……。
#. de: Sie mögen zwar beschlossen haben, die Insel zu verlassen, doch sie sind und bleiben Landsleute und damit Schätze Radz-at-Hans. Ich bin ungemein erleichtert, dass nicht alle ihr Leben in Eis und Schnee lassen mussten.
#. fr: Malgré leur décision de quitter notre île, ils n'en restent pas moins des enfants de Thavnair. Je suis soulagé que tous n'aient pas laissé la vie dans ces plaines enneigées.
#. speaker: VARSHAHN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004660_VARSHAHN:1"
msgid "Though they chose to take their leave of Thavnair, those you saved in Garlemald remain my people. My gratitude is beyond words."
msgstr ""

#. ja: 加えて、君たちは終末に抗うことを諦めていないという。<br>ならば、この星の一員として、協力をさせてもらいたい。
#. de: Zumal mir zugetragen wurde, dass ihr diese Apokalypse nicht widerstandslos hinnehmen wollt. Und als ein Kind dieses Gestirns<nbsp>... liegt es mir sehr am Herzen, Euch nun in diesem Kampf zu unterstützen.
#. fr: On m'a aussi fait savoir que vous n'aviez pas abandonné l'espoir de conjurer l'apocalypse. En tant qu'habitant de cette planète, je veux vous soutenir dans ce combat.
#. speaker: VARSHAHN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004670_VARSHAHN:1"
msgid "'Tis appropriate that I aid you in kind. If in the doing we bring salvation to others of this star, so much the better."
msgstr ""

#. ja: ……以前、我が父の話をしたのを覚えているだろうか？<br>父祖ミドガルズオルムは、星渡る竜だった。
#. de: Ihr erinnert Euch sicher, als ich das letzte Mal von meinem Vater sprach. Midgardsormr, der Drache, der zwischen den Sternen flog.
#. fr: Vous vous souvenez de ce que je vous ai dit à propos de mon père Midgardsormr, le dragon qui a volé de planète en planète<nbsp>?
#. speaker: VARSHAHN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004680_VARSHAHN:1"
msgid "You will recall that I spoke of my father, Midgardsormr, and his journey across the great expanse."
msgstr ""

#. ja: その鱗は星外の薄いエーテルさえもよく捕らえ、<br>長く、遠くへと渡る力に換えたという……。
#. de: Seine Schuppen absorbierten den wenigen Äther, der zwischen den Sternen strömt, und wandelten ihn in eine tragende Kraft. Sie ließ ihn diese immense Reise wohl erst bewerkstelligen.
#. fr: S'il a pu accomplir un tel voyage, c'est sûrement grâce à ses écailles, qui lui ont permis d'absorber l'éther qui n'existe qu'en quantité infime dans l'espace.
#. speaker: VARSHAHN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004690_VARSHAHN:1"
msgid "As he traveled betwixt the stars, his resplendent scales drank of the aether in those nigh-empty surrounds, and imparted to him the strength to persevere..."
msgstr ""

#. ja: ゆえに、君たちが星渡る船を造るというのなら、<br>父の鱗を託してはどうかと考えた。<br>そして、血族たちに、竜の咆哮で問うてみたのだ。
#. de: Wenn Ihr nun also ein Schiff bauen wollt, das durchs Sternenmeer segeln kann, so würde ich Euch gerne die Schuppen meines Vaters überlassen. Die Entscheidung liegt jedoch nicht allein bei mir. Mit meinem Ruf befragte ich die meines Blutes<nbsp>...
#. fr: Lorsque j'ai su que vous construisiez un vaisseau spatial, je me suis dit que ces écailles pourraient vous être utiles. Mais il me fallait d'abord consulter mes frères et sœurs...
#. speaker: VARSHAHN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004700_VARSHAHN:1"
msgid "Thinking they might further your cause, I called out to my kin for consent."
msgstr ""

#. ja: アジュダヤからは、いつものことだが返事がなかった。
#. de: Ich erhielt keine Antwort von Azdaja, wie üblich.
#. fr: Comme d'habitude, je n'ai reçu aucune réponse d'Azdaja.
#. speaker: VARSHAHN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004710_VARSHAHN:1"
msgid "Azdaja's answer was silence, as ever."
msgstr ""

#. ja: ティアマットは「良し」と言った。<br>フレースヴェルグも、彼方から「良し」と返してくれた。
#. de: Tiamat stimmte zu. Auch Hraesvelgr ließ sein Ja erschallen.
#. fr: Tiamat m'a dit qu'elle était d'accord, tout comme Hraesvelgr.
#. speaker: VARSHAHN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004720_VARSHAHN:1"
msgid "Tiamat and Hraesvelgr, however, responded favorably to the suggestion."
msgstr ""

#. ja: 以て、父もひととき微睡みから浮き上がり、私に告げた。<br>「では、そうするがよい」と……。
#. de: Selbst mein Vater wachte für einen Wimpernschlag aus seinem tiefen Schlaf, um mir seinen Segen zu geben. „Dann soll es so sein“, sprach er zu mir.
#. fr: Puis, à ma grande surprise, c'est mon père lui-même qui est sorti un instant de son long sommeil pour me donner sa bénédiction.
#. speaker: VARSHAHN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004730_VARSHAHN:1"
msgid "My sire, too, stirred from his slumber long enough to speak and say, “Very well...”"
msgstr ""

#. ja: 以て、父は私に告げた。<br>「では、そうするがよい」と……。
#. de: Auch mein Vater selbst gab mir seinen Segen. „Dann soll es so sein“, sprach er zu mir.
#. fr: J'ai ainsi pu approcher mon père lui-même, qui m'a donné sa bénédiction.
#. speaker: VARSHAHN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004740_VARSHAHN:1"
msgid "My sire, too, gave his assent."
msgstr ""

#. ja: だから私は幻龍の鱗を持ってきた。<br>君たちが望む結末へと踏み出す力として、使ってほしい。
#. de: So bringe ich Euch heute die Schuppen des Urdrachen. Des Hüters. Auf dass sie zu der Kraft werden, dem Ende so gegenüberzutreten, wie es Euch vorschwebt.
#. fr: J'apporte donc aujourd'hui ces fameuses écailles. Puissent-elles vous aider à atteindre votre but.
#. speaker: VARSHAHN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004750_VARSHAHN:1"
msgid "Thus have I brought you his own wyrmscales. Fit them to your purpose, and seek a worthier fate for us all."
msgstr ""

#. ja: 竜の鱗を組み込むにあたっては、<br>アタシたちがサポートをさせてもらうね！<br>護魂の霊鱗を作ったときの経験が活かせると思うんだ。
#. de: Und wir helfen euch dabei, die Schuppen korrekt einzusetzen! Dank der Forschung um die Seelenwächter haben wir auf diesem Gebiet ja nun reichlich Erfahrung.
#. fr: Si vous avez des questions, nous serons évidemment là pour y répondre. Grâce à nos recherches poussées sur les écailles garde-âme, on en connaît un rayon<nbsp>!
#. speaker: NIDHANA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004760_NIDHANA:1"
msgid "You'd be hard-pressed to find someone else so familiar with the unique properties of dragon scales, so I invited myself along."
msgstr ""

#. ja: はは……なんてこった……奇跡でも起きたってのか……？
#. de: Hah<nbsp>... Haha<nbsp>... Ist ein Wunder geschehen!?
#. fr: Pincez-moi, je rêve... Est-ce que c'est... un miracle<nbsp>!?
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004770_KOKKOLDANKKOL:1"
msgid "Bugger me, this is so unbelievable I've gone right back round to believin' it again!"
msgstr ""

#. ja: 検めてみないと正しいことは言えねぇが、<br>これだけの素材があれば、<br>6％の壁なんざ、容易く飛び越えられる……！
#. de: Natürlich kann ich nichts versprechen, aber wenn ich mir das ganze Material so ansehe, das ihr organisiert habt<nbsp>... dann sollten wir die mickrigen sechs Prozent mit Leichtigkeit knacken können!
#. fr: Je peux rien affirmer avant d'avoir fait quelques tests, mais avec tout cet exadamantium, je crois bien qu'on va atteindre les six pourcent les doigts dans le nez<nbsp>!
#. speaker: KOKKOLDANKKOL
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004780_KOKKOLDANKKOL:1"
msgid "Forget a six percent gain in efficiency. With all these goodies, we could get seven─no, ten─no! <i>Fourteen</i> bleedin' percent!"
msgstr ""

#. ja: それどころか、もっと遠い星までだって行けちまいそうだ！<br>できるぞ、最ッ高のエーテル縮退炉が！
#. de: Und nicht nur das - warum nur zum Mond fliegen, wenn man so auch die entferntesten Sterne erreichen könnte?! Wir werden ihn bauen, den großartigsten Ätherantrieb aller Zeiten!
#. fr: Et c'est rien d'le dire<nbsp>! On en a tellement que notre réacteur pourra même nous emmener vers l'infini, et au-delà<nbsp>!
#. speaker: KOKKOLDANKKOL
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004790_KOKKOLDANKKOL:1"
msgid "Think of how far we could go─what we could do with that much power! What we could blow up! "
msgstr ""

#. ja: ……ほかならぬククロ氏がこう言っているのだ。<br>「暁」は取引の条件を満たしたと、<br>認めてやるべきではないかね。
#. de: Es lässt sich nur schwer abstreiten<nbsp>... Der Bund der Morgenröte hat seinen Teil des Abkommens erfüllt.
#. fr: Si messire Kokkol est aussi enthousiaste, le doute n'est plus permis. Les Héritiers de la Septième Aube ont rempli leur part du marché avec brio.
#. speaker: BARNIER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004800_BARNIER:1"
msgid "If Kokkol is duly convinced, then it must be true─in which case, the Scions' end of the bargain has been fulfilled. Would you not agree?"
msgstr ""

#. ja: お父様……？
#. de: Vater<nbsp>...?
#. fr: Père...<nbsp>?
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004810_ALISAIE:1"
msgid "Yes, Father?"
msgstr ""

#. ja: お前たちが、ハイデリンに何を求めているのかはわからない。<br>方舟をどう使いたいと考えているのかもな。
#. de: Ich weiß nicht, was ihr beiden im Gespräch mit Hydaelyn zu finden hofft. Und ich weiß auch nicht, wozu ihr die Arche benutzen wollt.
#. fr: J'ignore de quoi vous voulez parler avec Hydaelyn, et comment vous avez l'intention d'utiliser notre vaisseau.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004820_FOURCHENAULT:1"
msgid "I know not what you seek of Hydaelyn, nor for what purpose you would take command of our ship."
msgstr ""

#. ja: いずれにせよ、この局面でそれらに関与することは、<br>人の存亡、星の命運を左右するに等しいだろう。
#. de: Sicher ist nur eines: Das Spiel mit beiderlei hat eine direkte Auswirkung auf das Schicksal des Gestirns.
#. fr: Tout ce dont je suis sûr, c'est que vos choix auront de lourdes con<shy>sé<shy>quen<shy>ces sur l'avenir de l'humanité et de notre planète.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004830_FOURCHENAULT:1"
msgid "Yet this much is certain─to do so will be to dictate the fate of this star and the lives upon it."
msgstr ""

#. ja: 多くの命を巻き込むことになる……<br>しくじれば、叱責どころで済みはしまい。
#. de: Die Zukunft unzähliger Leben steht auf Messers Schneide<nbsp>... Ein falscher Schritt und die Konsequenzen sind verheerend.
#. fr: D'innombrables vies sont en jeu, et l'échec n'est pas envisageable.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004840_FOURCHENAULT:1"
msgid "The lives of each and every creature. In their magnitude and their fragility."
msgstr ""

#. ja: ……その責任を負う覚悟はあるのか？
#. de: Seid ihr euch dieser immensen Verantwortung bewusst?
#. fr: ... Êtes-vous prêts à endosser une telle res<shy>pon<shy>sa<shy>bi<shy>li<shy>té<nbsp>?
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004850_FOURCHENAULT:1"
msgid "Do you understand, and are you prepared?"
msgstr ""

#. ja: ……はい。<br>すべての出会いが、私の語る「世界」に中身をくれました。<br>その上で私は、世界を救いたいのです。
#. de: Sind wir. Wir können, nein, wir werden diese Welt retten. Sie ist unser Zuhause und bedeutet so vielen Leuten so unendlich viel. Ihr Wohl setzen wir nicht leichtfertig aufs Spiel.
#. fr: Et comment. C'est tout ce que nous avons vécu dans ce monde qui le rend si cher à nos yeux. Et c'est pour ça que nous voulons le sauver.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004860_ALPHINAUD:1"
msgid "We have seen and we have felt how much each life shapes this world. And so we are determined to abandon none. We understand what is at stake, and we are prepared to bear this burden."
msgstr ""

#. ja: っ…
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004870_FOURCHENAULT:1"
msgid "Report if displayed."
msgstr ""

#. ja: ならば……ならば私も、ともに背負おう……。
#. de: Dann<nbsp>... Dann tragen wir diese Verantwortung gemeinsam.
#. fr: Dans ce cas, laissez-moi porter ce lourd fardeau avec vous.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004880_FOURCHENAULT:1"
msgid "Then I... I will bear it with you."
msgstr ""

#. ja: お前たちがこれから為すことの責任を、<br>家族として、わかちあわせてほしい。
#. de: Was auch immer ihr im Sinn habt, meine Kinder<nbsp>... Wir tragen sie gemeinsam. Als Familie.
#. fr: Nous sommes une famille, et je ne peux pas vous abandonner devant une telle res<shy>pon<shy>sa<shy>bi<shy>li<shy>té.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004890_FOURCHENAULT:1"
msgid "I beg you─share your struggles with me. As family."
msgstr ""

#. ja: お前たちが生まれたとき……<br>あの小さな手がこの指を握ったときに、<br>私は胸が詰まる思いだった。
#. de: Als ihr beide gerade erst frisch auf der Welt wart und ihr eure winzigen Händchen um meine Finger geschlossen habt<nbsp>... Da dachte ich, mir zerspringt das Herz in der Brust.
#. fr: Lorsque vous êtes venus au monde, que vous avez serré mes doigts dans vos petites mains pour la première fois... J'ai cru que mon cœur allait exploser...
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004900_FOURCHENAULT:1"
msgid "You grasped my fingers with such tiny hands the day you were born. I thought my heart might burst."
msgstr ""

#. ja: 言い知れないほどの愛しさと、眩い幸せ……<br>それから、怒りにも似た激しい決意がこみあげてきたのだ。
#. de: Ich war völlig überkommen. Von einer un<shy>beschreib<shy>lich tiefen Liebe und blindem Glück. Und dann war da eine Ent<shy>schlos<shy>sen<shy>heit in mir, die sich beinahe wie Wut anfühlte.
#. fr: J'ai d'abord ressenti un sentiment indescriptible, mêlé d'amour et de tendresse... Puis une profonde résolution, presque comme de la colère.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004910_FOURCHENAULT:1"
msgid "'Twas love and happiness beyond expression. Overwhelming. And a conviction so powerful that I trembled with something close to rage."
msgstr ""

#. ja: 私はすでに哲学者議会の一員で、終末の予言を知っていた。<br>そんなものに、お前たちの未来を奪われたくはなかった……。
#. de: Zu dem Zeitpunkt war ich bereits Mitglied des Rates und wusste um die Prophezeiung der Letzten Tage. Und ich schwor, dass ich eure Zukunft nicht an dieses Unglück verlieren würde.
#. fr: À l'époque, j'étais déjà membre du Conseil et au courant de la prophétie apocalyptique. Je me suis juré de ne jamais laisser cette tragédie vous priver de votre futur...
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004920_FOURCHENAULT:1"
msgid "I had heard the Final Days foretold. I swore to myself then and there that I would not let them steal your futures."
msgstr ""

#. ja: 以来、私は月への脱出計画を推し進めてきた。<br>何を切り捨て、誰に疎まれても構わなかった。<br>手遅れになる方がよほど怖かったのだから。
#. de: Seither arbeitete ich wie im Wahn und setzte alles daran, die Flucht zum Mond zu ermöglichen. Es kümmerte mich nicht, was ich opfern würde und welche Brücken ich dafür einreißen musste. Mich trieb die Angst, es nicht rechtzeitig zu schaffen.
#. fr: Dès lors, j'ai consacré ma vie à préparer notre plan d'exode vers la lune. Peu importe les sacrifices, rien ne m'effrayait plus que de ne pas être prêt à temps.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004930_FOURCHENAULT:1"
msgid "The great exodus would succeed. Must succeed. No sacrifice or sin was worse than the alternative."
msgstr ""

#. ja: 唯一捨てられないものがあったとしたら、<br>それは父……ルイゾワだ。
#. de: Nur eines war ich nie bereit, aufzugeben. Den großen Louisoix, meinen Vater.
#. fr: Il n'y a qu'une part de moi à laquelle je n'ai jamais pu renoncer... Louisoix, mon père.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004940_FOURCHENAULT:1"
msgid "If anything gave me pause...'twas mine own father."
msgstr ""

#. ja: 父はシャーレアンの使命に対し、異なる考え方を持っていた。<br>その考え方を……父自身を……<br>私は大人になるにつれ、愚かだと感じるようになっていた。
#. de: Ihr wisst selbst, dass er die Philosophie Sharlayans anders auslegte. Je älter ich wurde, desto alberner kamen mir seine Perspektive und sein Streben vor. Bis ich irgendwann überzeugt davon war, dass er ein alter Dummkopf ist.
#. fr: Sa vision du rôle de Sharlayan différait de la mienne. Plus je prenais de l'âge, plus j'étais convaincu qu'elle était absurde, et qu'il divaguait com<shy>plè<shy>te<shy>ment.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004950_FOURCHENAULT:1"
msgid "The Archon Louisoix openly decried Sharlayan's policies, a perspective which I regarded with increasing disdain as I grew older."
msgstr ""

#. ja: それでもどこかで、あの偉大な人ならば、<br>何か革新的なやり方でお前たちを救ってくれるのではと……<br>期待していたのだろう。
#. de: Und doch<nbsp>... Tief in mir hoffte irgendetwas darauf, dass dieser großartige Mann ein unorthodoxes Manöver bereithalten und uns so die Rettung bringen würde.
#. fr: Et pourtant, au fond de moi, j'espérais secrètement qu'un aussi grand homme ait un éclair de génie qui nous sauverait tous.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004960_FOURCHENAULT:1"
msgid "Yet even as part of me thought him a fool... Perhaps I also hoped that he, of all people, would devise a brilliant means to save my children."
msgstr ""

#. ja: だから、お前たちが父と親しくすることを、<br>あえて止めはしなかったのだ。
#. de: Deswegen habe ich euch nie aufgehalten, ihm nachzueifern.
#. fr: C'est pour cela que je n'ai jamais cherché à vous éloigner de lui.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004970_FOURCHENAULT:1"
msgid "A naive hope─but stubborn enough that I could never bring myself to keep you apart."
msgstr ""

#. ja: しかし、父は果てた。<br>家族とは何ら関係のない、遠きカルテノーの地で。
#. de: Und dann<nbsp>... starb er. Im fernen Carteneau, weit weg von zu Hause, ohne seine Familie.
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment, le destin en a voulu autrement. Il est mort sur la plaine de Carteneau, loin des siens.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004980_FOURCHENAULT:1"
msgid "No, that was his doing, when he perished at Carteneau."
msgstr ""

#. ja: 北洋へと飛来した拘束艦を引き上げながら、私は再び決意した。<br>自分がお前たちを護らねば……<br>そのために、今度こそ障害となるすべてを切り捨てようと。
#. de: Als ich das Verkeilungsschiff barg, das im Nordmeer gelandet war, da ergriff mich abermals feurige Ent<shy>schlos<shy>sen<shy>heit. Ich musste euch beschützen. Komme, was wolle. Und diesmal ohne Kompromisse.
#. fr: En renflouant le vaisseau de confinement qui s'était abîmé dans les mers du Nord, je me suis fait une nouvelle promesse. Je <i>devais</i> vous protéger, et plus rien ne m'en empêcherait.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_004990_FOURCHENAULT:1"
msgid "As we pulled that twisted slab of Dalamud from the sea, I remembered the warmth of your newborn touch. Chastened, I vowed never again to suffer any interference in my mission to protect you."
msgstr ""

#. ja: たとえそれが、お前たち自身の意思であってもだ。
#. de: Selbst, wenn ich euch damit zum Feind werden würde.
#. fr: Même si cela faisait de moi votre ennemi, il me fallait aller contre votre volonté.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005000_FOURCHENAULT:1"
msgid "No matter that you yourselves wished otherwise."
msgstr ""

#. ja: お前たちからどれほど憎まれようが、とにかく計画を進め、<br>最後には無理やりにでも連れていけばいい……そう考えていた。
#. de: Es kümmerte mich nicht, wie sehr ihr mich dafür hassen würdet. Ich würde den Plan zu seinem Ende führen und euch letztlich mit mir zwingen. So dachte ich zumindest<nbsp>...
#. fr: Quand bien même vous me haïriez, je devais mener le projet de Grand Exode à bien, et vous emmener de force si vous ne m'en laissiez pas le choix.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005010_FOURCHENAULT:1"
msgid "Detest me. Fight me tooth and nail. I would suffer it and more and be satisfied so long as I could force you onto the ship."
msgstr ""

#. ja: ……だが、浅はかだったな。<br>お前たちは私が思っているよりずっと多くのことを学び、<br>自分たちの足で、求める方へと歩きはじめていたようだ。
#. de: Wie einfältig ich war. Ihr seid mehr gewachsen, als ich es mir je vorzustellen gewagt habe. Mit beiden Beinen fest im Leben verfolgt ihr nun eure eigenen Ziele.
#. fr: Oh, comme je me trompais... Vous avez bien plus mûri que je ne l'imaginais. Peu à peu, vous avez tracé votre propre voie, comme des adultes.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005020_FOURCHENAULT:1"
msgid "I was wrong. You two have grown so much stronger, and so much wiser, than I dared dream."
msgstr ""

#. ja: 私ばかりが護らねばと思っていたが……<br>お前たちはもう、護りたいと願う側にいるのだな。
#. de: Ich dachte, ich müsste euch beschützen<nbsp>... Dabei seid ihr selbst längst zu Beschützern anderer geworden.
#. fr: Je ne pensais qu'à mon vœu de vous sauver. Mais désormais, vous aussi avez à cœur de protéger les vôtres.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005030_FOURCHENAULT:1"
msgid "You have earned the right to walk your own path...and already begun to do so."
msgstr ""

#. ja: ええ、そうよ。<br>見つけたの……大切なもの……大切な人たち……<br>たくさんの、かけがえのないものを。
#. de: Da hast du Recht. Es gibt so viele Dinge, die uns teuer sind. Und Leute, die uns am Herzen liegen<nbsp>... Sie sind allesamt unersetzlich.
#. fr: Oui... Nous avons trouvé des choses précieuses à nos yeux, et rencontré de nombreuses personnes qui nous sont chères.
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005040_ALISAIE:1"
msgid "Good! Because there are things we care about, and people we love...and none of them is replaceable. Not a one."
msgstr ""

#. ja: それを知るまでの道のりは、平坦ではなかっただろうに。<br>よく、ここまで歩いてきたものだ。
#. de: Es muss ein steiniger Weg gewesen sein, all diese Bindungen zu knüpfen. Bei Thaliak, wie weit ihr gekommen seid<nbsp>... Ich bin so stolz auf euch.
#. fr: La route a dû être longue et semée d'embûches pour en arriver où vous êtes aujourd'hui. Je suis fier de vous.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005050_FOURCHENAULT:1"
msgid "It cannot have been an easy journey, for you to have come so far."
msgstr ""

#. ja: すべてが無事におわったら、きっとお話ししましょう。<br>私たちが見て、聞いて、感じて、考えたことを。
#. de: Davon erzählen wir dir sehr gern, wenn alles vorbei ist. Von allem, was wir erlebt haben.
#. fr: Lorsque tout cela sera terminé, nous prendrons le temps de te raconter les expériences que nous avons vécues et les en<shy>sei<shy>gne<shy>ments que nous en avons tirés.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005060_ALPHINAUD:1"
msgid "We shall be glad to acquaint you with the finer details someday, once this danger has passed. All that we have seen and heard. That we have felt and learned in our travels."
msgstr ""

#. ja: この厳しくも素晴らしい世界のことを……。
#. de: Und von dieser harten aber herzlichen Welt. Unzählige Geschichten haben wir für dich!
#. fr: Notre monde est aussi vaste qu'il est magnifique, il y a tant à en dire...
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005070_ALPHINAUD:1"
msgid "Ours is not a kind world, but it is beautiful. Always."
msgstr ""

#. ja: あら大変！<br>フルシュノさんは、ふたりからの手紙だって、<br>ハラハラしちゃって読めなかったのよ？
#. de: Du liebe Zeit! Euer Herr Vater war bis vor kurzem noch derart um euch besorgt, dass er sich nicht einmal an eure Briefe getraut hat.
#. fr: Vous devez savoir que votre père était <i>tellement</i> inquiet pour vous qu'il n'osait même pas lire vos lettres...
#. speaker: AMELIANCE
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005080_AMELIANCE:1"
msgid "Oh no, are you quite sure that's wise? After all, <i>someone</i> turns pale and flees the room when he sees so much as an envelope containing word of your adventures."
msgstr ""

#. ja: 旅のお話なんて聞いたら、どうなってしまうのかしら？
#. de: Meinst du, du verträgst ihre Reisegeschichten überhaupt?
#. fr: Si vous lui racontez vos voyages dans les moindres détails, j'ai bien peur qu'il ne s'en remette pas<nbsp>!
#. speaker: AMELIANCE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005090_AMELIANCE:1"
msgid "What ever will happen if he learns what you were really up to?"
msgstr ""

#. ja: アメリアンス……！
#. de: Ameliance!
#. fr: Ameliance...<nbsp>!
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005100_FOURCHENAULT:1"
msgid "Ameliance!"
msgstr ""

#. ja: ふふふ…
#. de: Haha<nbsp>...
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005110_ALPHINAUD:1"
msgid "Report if displayed."
msgstr ""

#. ja: あはは…
#. de: Haha<nbsp>...
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005120_ALISAIE:1"
msgid "Report if displayed."
msgstr ""

#. ja: 君たちにも、度重なる非礼をお詫びせねばならない。
#. de: Ich will mich außerdem bei euch für mein doch sehr garstiges Benehmen entschuldigen.
#. fr: Je voudrais également vous présenter mes excuses pour l'attitude désagréable que j'ai eue à votre égard.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005130_FOURCHENAULT:1"
msgid "Though I have wronged my children most gravely, I owe you an apology as well."
msgstr ""

#. ja: 率直に言うと、アルフィノとアリゼーが危険を冒すのは、<br>「暁」のせいではないかと考えていた。
#. de: Wenn ich ehrlich bin, so glaubte ich, dass sich meine Kinder vor allem wegen des Bundes fortlaufend in Gefahr brachten.
#. fr: Pour être honnête avec vous, j'étais convaincu que mes enfants persistaient à prendre les armes sous l'influence des Héritiers.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005140_FOURCHENAULT:1"
msgid "I assumed that it was the Scions' influence that made them so keen to charge headlong into danger."
msgstr ""

#. ja: とくに、君のことは……。
#. de: Insbesondere dein Einfluss auf sie war mir ein Dorn im Auge.
#. fr: Surtout la vôtre, cela va sans dire.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005150_FOURCHENAULT:1"
msgid "...Yours, in particular."
msgstr ""

#. ja: だが、ふたりが多くの出会いを果たし、<br>今ここに大勢が集っているのも、君あっての結果なのだろう。
#. de: Aber letztlich bist du es, <if $gn4>der<else>dem</if> sie so viele ihrer Erfahrungen verdanken. Und ohne dich hätten wir uns heute wohl nicht so zahlreich zusammengefunden.
#. fr: Aujourd'hui, je me rends compte qu'ils vous doivent en grande partie toutes ces rencontres, et que c'est grâce à vous si tous ces gens sont réunis ici aujourd'hui.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005155_FOURCHENAULT:1"
msgid "I see now that said influence instead brought them together with the many fine people gathered here today."
msgstr ""

#. ja: ならば、どうか……<br>これからも、ふたりのことを、よろしく頼む。
#. de: So danke ich dir. Und<nbsp>... bitte habe auch weiterhin ein wachsames Auge auf meine beiden.
#. fr: Je vous en remercie, et j'espère que vous continuerez à prendre soin de mes enfants, à l'avenir.
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005160_FOURCHENAULT:1"
msgid "In which case...I hope you continue to guide them."
msgstr ""

#. ja: じゃ、まずはこの場を動かさないとだな！<br>みんな指示を待ってるみたいだぞ。
#. de: Nun, dann schlage ich vor, wir bringen den Stein ins Rollen. Ein jeder hier ist bereit, zur Tat zu schreiten.
#. fr: Bon, et si on se mettait au travail<nbsp>? Je crrrois que tout le monde attend nos in<shy>struc<shy>tions.
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005170_GRAHATIA:1"
msgid "If we've finished loitering about the harbor, might I suggest we put our plans into motion? People are beginning to look confused."
msgstr ""

#. ja: ひとまず君から、ひと声かけてはくれないか？<br>君を慕って来ている者も多いだろうからね。
#. de: Wie wäre es mit einer kleinen Ansprache, zum Auftakt? So viele Leute hier blicken schließlich zu dir auf.
#. fr: Que dirais-tu de prendre la parole<nbsp>? Après tout, ils sont surtout là pour toi<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005180_ALPHINAUD:1"
msgid "Perhaps you can spare a few words ere they resume the tedious lugging of cargo? You've no small number of friends and admirers here, after all."
msgstr ""

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q4
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_Q4_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr ""

#. ja: まだ力を貸してくれるか？
#. de: Werdet ihr mir noch ein weiteres Mal zur Seite stehen?
#. fr: Puis-je compter sur votre aide une fois de plus<nbsp>?
#. speaker: A4
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A4_000_001_NONE_VOICE:1"
msgid "Lend us your strength!"
msgstr ""

#. ja: 正念場だ、がんばろう！
#. de: So beginnt der Kampf um unsere Heimat! Unsere Zukunft!
#. fr: Courage, l'avenir de notre monde est en jeu<nbsp>!
#. speaker: A4
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A4_000_002_NONE_VOICE:1"
msgid "Our moment of triumph is close at hand!"
msgstr ""

#. ja: 指示に従って、なかよく！
#. de: Jetzt wird in die Hände gespuckt, meine Lieben! Auf Schweiß und Blut kommt es an!
#. fr: Tout le monde au travail, dans la joie et la bonne humeur<nbsp>!
#. speaker: A4
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A4_000_003_NONE_VOICE:1"
msgid "With me!"
msgstr ""

#. ja: おう！
#. de: Jaaa!
#. speaker: SICARD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005190_SICARD:1"
msgid "Damn right!"
msgstr ""

#. ja: おう！
#. de: Jawohl!
#. speaker: EMMANELLAIN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005200_EMMANELLAIN:1"
msgid "Brilliant!"
msgstr ""

#. ja: オー！
#. de: Bravo!
#. speaker: HANCOCK
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005210_HANCOCK:1"
msgid "Huzzah!"
msgstr ""

#. ja: おぉ～
#. de: Jaaaah!
#. speaker: SOROBAN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005220_SOROBAN:1"
msgid "Very good!"
msgstr ""

#. ja: おう！
#. de: Jawoll!
#. speaker: ERENVILLE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005230_ERENVILLE:1"
msgid "Aye!"
msgstr ""

#. ja: おう！
#. de: Jawoll!
#. speaker: CID
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005240_CID:1"
msgid "Finally!"
msgstr ""

#. ja: おう！
#. de: Har har!
#. speaker: HOARYBOULDER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005250_HOARYBOULDER:1"
msgid "Huzzah!"
msgstr ""

#. ja: おー！
#. de: Jaaa!
#. speaker: NIDHANA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005260_NIDHANA:1"
msgid "Wonderful!"
msgstr ""

#. ja: では、これより順次誘導をさせていただく。<br>皆の尽力に感謝を……<br>そして、今しばらくご協力いただきたい！
#. de: Ich werde die nötigen Anweisungen geben, um eure vielfältigen Expertisen voll und ganz auszuschöpfen. Wir danken euch allen für die Mithilfe.
#. fr: C'est moi qui vais vous donner les indications nécessaires. Encore merci à tous pour votre précieuse aide<nbsp>!
#. speaker: FOURCHENAULT
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005270_FOURCHENAULT:1"
msgid "Your assistance is appreciated. Now, in an orderly fashion, if you please!"
msgstr ""

#. ja: まったく  諦めの悪い人たちですね<br>こんな場所にまで踏み込んで――
#. de: Ihr gebt aber auch wirklich nie auf, was? Selbst hierher habt ihr euch gewagt<nbsp>...
#. fr: Même dans un tel endroit, vous osez venir me harceler... Décidément, vous n'abandonnerez jamais...
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005280_AMON:1"
msgid "So bold, so headstrong. Stubborn to the last."
msgstr ""

#. ja: ですが  ここまでです<br>終末を受け入れ  無に還りなさい！
#. de: Aber weiter kommt ihr nicht. Hinab ins Nichts mit euch!
#. fr: Mais c'est fini, tout ça. Embrassez l'apocalypse, et allez pourrir dans le néant une bonne fois pour toutes<nbsp>!
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005290_AMON:1"
msgid "But this is as far as you go. Oblivion beckons!"
msgstr ""

#. ja: おのれ――行かせるものか――
#. de: Nein<nbsp>... Das darf nicht<nbsp>...
#. fr: Non... Vous n'irez pas plus loin...
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005300_AMON:1"
msgid "Lies...all lies..."
msgstr ""

#. ja: 夢  希望  未来  可能性<br>そんなもの  どこにもありはしない――！
#. de: Träume, Hoffnung, Zukunft<nbsp>... Es gibt sie nicht! Nirgendwo!
#. fr: L'espoir, les rêves, le futur... Tout ça, ce ne sont que des illusions<nbsp>!
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005310_AMON:1"
msgid "Your dreams, your hopes, your futures... Delusions and lies!"
msgstr ""

#. ja: っ…
#. de: Urgh
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005320_AMON:1"
msgid "Report if displayed."
msgstr ""

#. ja: クソ……魂さえ、もうままならない……<br>ああ、本当に忌々しい……！
#. de: Argh<nbsp>... Nicht einmal die Seele will mehr gehorchen<nbsp>... Verdammt<nbsp>...
#. fr: Argh... Même... mon âme... est à bout... Je ne peux pas y croire... C'est... vraiment... pitoyable<nbsp>!
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005330_AMON:1"
msgid "My very essence...begins to wane. Sweet, sweet agony..."
msgstr ""

#. ja: ……任せよう。
#. de: ... Nicht.
#. fr: ... Laisse-<if $gn4>la<else>le</if>.
#. speaker: ALPHINAUD
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005340_ALPHINAUD:1"
msgid "Leave this to <if $gn4>her<else>him</if>."
msgstr ""

#. ja: 何です……とどめを刺してくれるんですか……？
#. de: Was denn<nbsp>... Bringst du es nun endlich zu Ende?
#. fr: Quoi<nbsp>? Tu viens me donner le coup de grâce...<nbsp>?
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005350_AMON:1"
msgid "Come to deal the coup de grâce?"
msgstr ""

#. ja: ハ……望むところですよ……。<br>あなたたちの抵抗を見ていると、虫唾が走る……<br>いっそ、魂も残さず消してください。
#. de: Dein Mitleid ist jetzt genau das, was ich brauche<nbsp>... Es treibt mir die Galle hoch<nbsp>... Tilge meine Seele, bis auf den letzten Rest!
#. fr: Je préfère encore mourir que d'être témoin de votre résistance pitoyable. Vous me donnez envie de vomir... Dépêche-toi de m'achever, et n'oublie pas mon âme<nbsp>!
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005360_AMON:1"
msgid "Good... Watching you struggle against the inevitable is bad comedy. Erase me from existence, soul and all."
msgstr ""

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q5
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_Q5_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr ""

#. ja: メーティオンを覚えているか
#. de: Erinnerst du dich an Meteion?
#. fr: Te souviens-tu encore de Météion<nbsp>?
#. speaker: A5
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A5_000_001_NONE_VOICE:1"
msgid "Have you any memories of Meteion?"
msgstr ""

#. ja: ヘルメスだったころを覚えているか
#. de: Du warst einmal ein Mann namens Hermes<nbsp>...
#. fr: Tu t'appelais Hermès, autrefois...
#. speaker: A5
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A5_000_002_NONE_VOICE:1"
msgid "Do you recall your days as Hermes?"
msgstr ""

#. ja: 何故……その名前を……。
#. de: Wieso<nbsp>... dieser Name<nbsp>...
#. fr: ... Hein<nbsp>!? Comment connais-tu ce nom<nbsp>?
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005370_AMON:1"
msgid "How would you know that name?"
msgstr ""

#. ja: くくく…ふふ…
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005380_AMON:1"
msgid "Report if displayed."
msgstr ""

#. ja: エルピスにいたの、あれ、<br>あなたとエメトセルクだったんですか……！<br>くく……まったく……なんという……。
#. de: In Elpis<nbsp>... Das warst also du an Emet-Selchs Seite! Nicht zu fassen<nbsp>...
#. fr: C'était donc toi, à Elpis, avec Emet-Selch... Incroyable...
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005390_AMON:1"
msgid "Then it was you─in Elpis, with Emet-Selch. Ha! The final pieces fall into place."
msgstr ""

#. ja: 私、ただのアモンとして生きていたころに、<br>繰り返し見ていた夢があったんです……。
#. de: Als ich noch Amon war<nbsp>... hatte ich immer wieder denselben Traum<nbsp>...
#. fr: À cette époque, je faisais le même rêve chaque nuit...
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005400_AMON:1"
msgid "In my halcyon days as the mortal Amon, I was haunted by a dream..."
msgstr ""

#. ja: 壊れた記録みたいに、途切れ途切れの夢。<br>登場人物の姿は欠けて、声も、顔も思い出せない。
#. de: Zerrissen und unvollständig, sich dauernd wiederholend. Die Akteure nur unförmige Schemen, als hätte ich ihre Stimmen und Gesichter längst vergessen.
#. fr: C'était toujours des images hachées... Impossible de me rappeler les voix ou les visages de ceux que j'y croisais.
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005410_AMON:1"
msgid "Night after night, the faceless multitude. The voiceless cries. Shards of shattered memories."
msgstr ""

#. ja: ただぼんやりと、そこがエルピスという場所で、<br>自分がヘルメスと呼ばれていることを認識していました。
#. de: Nur zwei Dinge blieben mir nach einem solchen Traum vage im Sinn. Ein Ort namens Elpis und der Name, mit dem ich gerufen wurde. Hermes<nbsp>...
#. fr: Tout ce que je sais, c'est que ça se passait à Elpis, et qu'on m'appelait Hermès.
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005420_AMON:1"
msgid "But slowly the fog began to clear. This was Elpis, and I...I was Hermes."
msgstr ""

#. ja: 当然、妄想だと思いましたよ。<br>そんな場所は知らないし、私はヘルメスじゃないんですから。
#. de: Ich hielt es selbst<shy>verständ<shy>lich für ein Hirngespinst. Nie war ich an einem solchen Ort und auch der Name war mir fremd.
#. fr: Bien sûr, j'étais persuadé que c'était seulement mon imagination. Cet endroit m'était inconnu, tout comme ce nom qui n'était pas le mien.
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005430_AMON:1"
msgid "Recurring though it was, I paid this dream little heed."
msgstr ""

#. ja: ……ですが、アシエンになり、<br>オリジナルのファダニエルの情報を受け取ったとき、<br>すべてが繋がってしまったんです。
#. de: Doch dann wurde ich ein Ascian und übernahm den Sitz des Fandaniel. Plötzlich fügten sich alle Teile zu einem Ganzen.
#. fr: Et puis, quand j'ai hérité des souvenirs de Fandaniel en devenant Ascien, tout est devenu plus clair.
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005440_AMON:1"
msgid "It was only when I was granted the seat─and memories─of Fandaniel that I knew these visions to be true."
msgstr ""

#. ja: 私が夢だと思っていたのは、<br>ヘルメスの……カイロスが消した記憶だったのだと。
#. de: Was ich für einen Traum hielt, waren die Erinnerungen dieses Hermes. Ausgelöscht vom Kairos.
#. fr: Ce n'était pas un rêve, mais des restes de la mémoire d'Hermès effacée par sa machine, Kairos.
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005450_AMON:1"
msgid "They were the memories of Hermes, that he himself erased using the power of Kairos."
msgstr ""

#. ja: あのとき、カイロスはその場にいた者の記憶を上書いた。<br>もとの記憶はエーテル放射によって覆われ……<br>だからこそ、魂に強く焼き込まれた。
#. de: Damals überschrieb er die Gedächtnisse aller Anwesenden. Doch der Äther überstrahlte ihre Gedanken und Eindrücke so intensiv, dass sie sich tief in ihre Seelen brannten.
#. fr: Ce jour-là, elle a réécrit les souvenirs de tous ceux qui étaient présents. Les radiations d'éther ont frappé si fort les mémoires que celles-ci ont été comme gravées dans l'âme de chacun.
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005460_AMON:1"
msgid "Or so he thought. In his attempt to burn away the events of that fateful day, he succeeded only in searing them more deeply into his soul. My soul."
msgstr ""

#. ja: 死して魂が洗われるときにも、消えきらず……<br>幾度の生と死を経て薄れながらも、<br>私の代まで継がれてきた、というのが真相でしょう。
#. de: Der Tod wäscht alle Erinnerungen fort, nur diese sind nie gänzlich verschwunden. Das Wissen ist über die Jahrhunderte zwar reichlich ausgeblichen, aber irgendwann, nach unzähligen Leben, kam es bei mir an die Oberfläche.
#. fr: Même purifiées par la mort, ces âmes n'ont ainsi jamais com<shy>plè<shy>te<shy>ment perdu leurs souvenirs originels. C'est pour ça qu'il me restait des bribes d'Hermès, quand j'ai hérité de la sienne.
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005470_AMON:1"
msgid "Death failed to expunge them, no matter how many times it came. Rebirth after rebirth, from one Fandaniel to the next."
msgstr ""

#. ja: やっと死ねたエメトセルクも、星海のどこかで、<br>消された日々のことを思い出してるんじゃないですか？
#. de: Emet-Selch ist also auch endlich tot<nbsp>... sitzt im Sternengrund und entsinnt sich nun selbst seiner verlorenen Tage, nicht wahr?
#. fr: Du coup, je me demande si ce brave Emet-Selch rêve lui aussi de cette époque oubliée, maintenant qu'il a enfin rejoint la mer des étoiles...
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005480_AMON:1"
msgid "I wonder─is Emet-Selch adrift somewhere in this aetherial sea, in defeat finally remembering your time together in Elpis?"
msgstr ""

#. ja: さぞ悔しいでしょうねぇ……。<br>啖呵を切っておきながら終末を止められなかったことも、<br>核心を忘れたまま、楽園を求めてきたことも。
#. de: Er muss entsetzlich frustriert sein<nbsp>... Nicht nur, dass er das Ende nicht verhindern konnte, so sehr er sich auch bemühte. Nein, er griff auch fortan nach einem Paradies, dessen fauligen Kerns er sich gar nicht mehr gewahr war.
#. fr: Le pauvre doit être dépité. Non seulement il n'a pu empêcher l'apocalypse malgré tous ses efforts, mais il a convoité un paradis sans même savoir pourquoi.
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005490_AMON:1"
msgid "How it must gall him─to be entrusted with knowledge of the Final Days, only to be rendered powerless to act upon it! So many lifetimes dedicated to restoring his beloved Amaurot in blissful ignorance. Oh, folly."
msgstr ""

#. ja: ……ですが、私はヘルメスだから終末を呼んだわけじゃない。
#. de: Aber ich sehnte mich nicht an Hermes' statt nach dem Ende<nbsp>... Nein.
#. fr: ... Quant à moi, ce n'est pas parce que je suis la réincarnation d'Hermès que j'ai relancé l'apocalypse.
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005500_AMON:1"
msgid "But make no mistake... My life as Hermes is not the reason I invited the world's end."
msgstr ""

#. ja: 私は、私として生き、この心で苦しんだ……<br>絶望した……見切ったんです。
#. de: Ich lebte als ich selbst. Ich litt als ich selbst. Es ist mein Herz, das nach Hoffnung suchte<nbsp>... und nur Ver<shy>zweif<shy>lung fand.
#. fr: J'ai mené ma vie comme tout un chacun. J'ai souffert, j'ai perdu espoir... puis j'ai fini par tout abandonner.
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005510_AMON:1"
msgid "I have lived. I have struggled. I have dredged the very depths of despair. And in the detritus of existence, I found the truth."
msgstr ""

#. ja: かつて偉大な皇帝と、彼が導いた超大国が示しました。<br>最後に待つのは無であると。<br>生きるのはただ、そこに至る道程でしかないのだと。
#. de: Ein einstmals großer Herrscher und sein einstmals großes Reich schenkten mir diese Wahrheit. Denn am Ende wartet bloß das Nichts. Und das Leben ist letztlich nur eine Reise gen Vergessenheit.
#. fr: C'est un illustre empereur et sa patrie puissante qui m'ont ouvert les yeux<nbsp>: au bout du compte, la mort finit toujours par tout emporter. La vie n'est rien de plus qu'un long voyage vers l'oubli.
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005520_AMON:1"
msgid "I served a great ruler, powerful beyond measure, the world his dominion. Yet even he and his vast empire were destined to fall─to become one with oblivion. At the end of life's journey...lies only death."
msgstr ""

#. ja: ……だったら何故生きる？
#. de: Also warum überhaupt leben?
#. fr: Dans ces conditions... à quoi bon exister<nbsp>?
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005530_AMON:1"
msgid "So I ask you─why live at all?"
msgstr ""

#. ja: 他者を踏みつけ、足蹴にし、傷つけながら、<br>どうして生き続ける必要があるんだ？
#. de: Warum das ganze Leid? Wir zertrampeln, zertrümmern, ermorden uns gegenseitig, und wofür?
#. fr: Pourquoi passer sa vie à piétiner son prochain, à se battre et à souffrir si tout est vain<nbsp>?
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005540_AMON:1"
msgid "We betray, we torment, we murder. We are wicked, spiteful creatures─without exception!"
msgstr ""

#. ja: 人はあらゆる言葉で生を讃えるが、<br>見てみろ、人生の大半は暗澹たる闇の中だ。
#. de: Das ach so wunderbare Leben wird in unzähligen Liedern besungen, doch hinter dieser Fassade ist das Dasein von Düsternis geprägt.
#. fr: Les hommes s'évertuent à célébrer le miracle de la vie, alors que ce n'est qu'une longue agonie à travers les ténèbres...
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005550_AMON:1"
msgid "If life is so sacred, so precious, why fill it with such misery?"
msgstr ""

#. ja: しかもその闇を、自分たちで吐きだしているときた。<br>まったくもってたちが悪い。
#. de: Eine Düsternis, die wir selbst überall hinspeien, wohin wir nur gehen. Ein Trauerspiel, wahrlich!
#. fr: Des ténèbres que nous répandons nous-mêmes, de surcroît. C'est tout simplement pathétique<nbsp>!
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005560_AMON:1"
msgid "Man wallows in a hell of his own making, without purpose or meaning."
msgstr ""

#. ja: だったらもういい、やめてしまえばいい……！
#. de: Ist es nicht an der Zeit, dieses Possenspiel zu beenden?
#. fr: Puisque c'est comme ça, autant abréger nos souffrances...<nbsp>!
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005570_AMON:1"
msgid "To live is to suffer... And I would end that suffering by my own hand!"
msgstr ""

#. ja: この星に生きる、いつまでも、どこまでも愚かな人類が、<br>誰ひとりそれを謳わなかったとしても……<br>終わることこそ、ただひとつの正しい答えだ！
#. de: Auch wenn man von den Bewohnern dieses Planeten in ihrer endlosen Einfalt keinerlei Einsicht erwarten darf<nbsp>... Das Ende ist dennoch der einzig wahre Weg!
#. fr: Même si aucun des stupides humains de cette planète ne veut se rendre à l'évidence, la seule solution, c'est de mettre fin à cette farce ridicule<nbsp>!
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005580_AMON:1"
msgid "It matters not if it flies in the face of all believed right and just. Death is the only solution!"
msgstr ""

#. ja: それが正しいと……真理だとわかっているのに……。
#. de: Und obwohl ich weiß, dass dies die ungetrübte Wahrheit ist<nbsp>...
#. fr: Et pourtant, même si je sais que c'est la stricte vérité...
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005590_AMON:1"
msgid "That is my truth. My answer to the question, and yet..."
msgstr ""

#. ja: どうしてこんな、口にするたび、<br>何かに負けたような気がするんだ……。
#. de: Warum schmecken die Worte dann so bitter? Als reiße jedes einzelne ein Stück aus mir heraus<nbsp>...?
#. fr: Ces mots ont comme un arrière-goût d'échec... Dès lors, je me demande...
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005600_AMON:1"
msgid "...Even as the words pass my lips, I am filled with doubt."
msgstr ""

#. ja: これじゃないなら、私は何を求めていた……？
#. de: Wonach soll ich denn sonst streben?
#. fr: Si j'ai fait fausse route, où est-ce que je me suis trompé...<nbsp>?
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005610_AMON:1"
msgid "Has my search reached its end?"
msgstr ""

#. ja: どういう結果ならよかったんだ……。
#. de: Was will ich?
#. fr: Qu'est-ce que je voulais vraiment...<nbsp>?
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005620_AMON:1"
msgid "Was this the only way?"
msgstr ""

#. ja: 自分が……待っていたのは……
#. de: Auf was habe ich gewartet?
#. fr: Qu'est-ce que j'attendais depuis toujours...<nbsp>?
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005630_AMON:1"
msgid "After all these years..."
msgstr ""

#. ja: 望んでいたのは、どんな答えだ……？
#. de: Nach welcher Antwort sehnt es mich<nbsp>...?
#. fr: La réponse que j'espérais au fond de moi, et que je n'ai jamais eue...
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005640_AMON:1"
msgid "Is this the answer I was hoping for?"
msgstr ""

#. ja: (-？？？？-)死者の問いに答えて、どうするんです？<br>そいつに未練を晴らさせやしませんよ。
#. de: (-???-)Du wirst doch nicht etwa mit einem Toten debattieren? Das wird ihm und seiner Reue nämlich auch nicht helfen.
#. fr: (-???-)Qu'est-ce qui te prend, de parler avec un mort<nbsp>? Ce n'est pas ça qui va l'aider à oublier ses regrets...
#. speaker: ASAHI
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005650_ASAHI:1"
msgid "(-???-)The lamentations of the damned... How it vexes me, to see your conviction falter at the last."
msgstr ""

#. ja: (-？？？？-)アシエン・ファダニエル……<br>お前が安らかに眠っていなくてよかったよ。
#. de: (-???-)Ascian Fandaniel! Es bereitet mir ungemeine Freude, dass du keinen Frieden findest.
#. fr: (-???-)Fandaniel... Quelle <i>chance</i> que tu sois éveillé, toi aussi.
#. speaker: ASAHI
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005660_ASAHI:1"
msgid "(-???-)Fandaniel... Still clinging to existence, I see."
msgstr ""

#. ja: (-？？？？-)ここじゃあ、誰も彼もが静かに眠る。<br>記憶も想いも溶かして、魂を癒すために……。
#. de: (-???-)Weißt du? Dies hier ist der Ort, an dem wir alle in ruhigen Schlummer sinken sollen<nbsp>... Unsere Erinnerungen und Gedanken schwinden dahin, um unsere Seelen zu heilen.
#. fr: (-???-)Ici, tout le monde est plongé dans une profonde léthargie. Un repos servant à purger l'âme de ses souvenirs et de ses pensées...
#. speaker: ASAHI
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005670_ASAHI:1"
msgid "(-???-)You, who champion death so fervently, unwilling to accept your own. Refusing to be purified and swept into the sea of souls─as do I."
msgstr ""

#. ja: (-？？？？-)けれど稀に、気がかりがあって眠るに眠れず、<br>星海の水面に映る、現し世を眺めてる者がいるんです。
#. de: (-???-)Aber einige finden einfach keinen Frieden. Ihr einstiges Leben lässt sie nicht los. Und so sitzen sie im Sternengrund und starren unablässig auf die Spiegelung der Gegenwart.
#. fr: (-???-)Mais certains sont si préoccupés qu'ils ne parviennent pas à trouver le sommeil. Ils restent là, à contempler le reflet du monde sur la mer des étoiles.
#. speaker: ASAHI
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005680_ASAHI:1"
msgid "(-???-)We prisoners to memory, watching as the world turns..."
msgstr ""

#. ja: (-？？？？-)たとえばそう……<br>己の骸がゲス野郎に使われていたり、ねぇ……。
#. de: (-???-)Ich, zum Beispiel<nbsp>... Ich musste mit ansehen, wie sich Ungeziefer in meinem Körper eingenistet hat<nbsp>...
#. fr: (-???-)Comme quelqu'un qui aurait vu une <i>ordure</i> se servir de son cadavre, par exemple...
#. speaker: ASAHI
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005690_ASAHI:1"
msgid "(-???-)Though unlike me, you will be spared the ignominy of having your corpse made a puppet, dancing to another's tune."
msgstr ""

#. ja: まさか、アサヒなのか！？
#. de: A-Asahi?!
#. fr: Asahi, c'est toi<nbsp>!?
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005700_ALPHINAUD:1"
msgid "Is that...Asahi?"
msgstr ""

#. ja: やめていただきたいですね、旧知の間柄みたいな言い草は。<br>残念ながら、あなた方には何の用もないんですよ。
#. de: Wer hat dir das Recht gegeben, mich bei meinem Vornamen zu rufen wie eine alte Bekanntschaft? Zumal ich euch wirklich nichts zu sagen habe.
#. fr: Qui vous a permis ces familiarités, comme si nous étions de vieilles con<shy>nais<shy>san<shy>ces<nbsp>? Toutes mes excuses, mais je n'ai pas de temps à vous consacrer.
#. speaker: ASAHI
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005710_ASAHI:1"
msgid "How very astute. But let me be clear─I have not come to consort with the likes of you."
msgstr ""

#. ja: 俺は、俺が死んだあとの世界なんて、どうでもいい。<br>派手に滅びてそこの英雄殿を苦しめてくれるんなら、<br>いっそありがたいくらいです。
#. de: Ich bin tot. Mir ist egal, was mit dieser Welt passiert. Tatsächlich hätte ich nichts dagegen, wenn alles in einem großen Spektakel zugrunde ginge und <if $gn4>diese Heldin<else>dieser Held</if> hier ordentlich leiden müsste.
#. fr: Depuis ma mort, je me contrefiche de ce que le monde peut devenir. À la limite, s'il est anéanti en emportant avec lui l'autre <if $gn4>crâneuse d'héroïne<else>crâneur de héros</if> dans d'atroces souffrances, ça m'ira bien.
#. speaker: ASAHI
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005720_ASAHI:1"
msgid "Nor have I come to bemoan the state of the world following my untimely demise. In fact, I delight in mankind's downfall and the anguish it brings the savior of the savages."
msgstr ""

#. ja: 身体を使われたことだって……<br>まあ、不愉快だと思ったところで、死人に口なしですよ。
#. de: So gesehen ist es eine Ehre, das gerade mein Körper eine Hauptrolle dabei spielen durfte<nbsp>... Auch wenn ich schlecht hätte widersprechen können. Tote können sich ja bekanntlich nicht beklagen.
#. fr: Quant au fait que tu te sois approprié mon cadavre... Eh bien, je suppose qu'on n'a plus le droit de se plaindre, une fois qu'on est passé de l'autre côté.
#. speaker: ASAHI
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005730_ASAHI:1"
msgid "If I played some small part in the chaos, all the better. Not that I was in any position to resist."
msgstr ""

#. ja: ……だが！<br>お前が、俺の身体でゼノス様に近づき、裏切ったこと……。
#. de: Aber! Du hast Prinz Zenos - meinen Herrn und Meister - mit meinem Körper hintergangen<nbsp>...
#. fr: En revanche... Que tu aies <i>osé</i> t'en servir pour aborder Son Altesse Zenos, et le <i>trahir</i>...
#. speaker: ASAHI
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005740_ASAHI:1"
msgid "But to be made accomplice to the betrayal of Lord Zenos..."
msgstr ""

#. ja: それだけは絶対に、絶対に……死んでも許せるもんじゃあない！
#. de: Mag mir alles andere auch egal sein<nbsp>... Dieses Verbrechen wirst du mir büßen!
#. fr: Ça, je ne te le pardonnerai jamais, tu m'entends<nbsp>!? Jamais<nbsp>!
#. speaker: ASAHI
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005750_ASAHI:1"
msgid "...I would die a thousand deaths to exact my vengeance!"
msgstr ""

#. ja: お前はここで、俺とともに眠るんだ。<br>問いの答えを得ることも、災厄の結末を見ることもなく！
#. de: Du wirst hier ruhen. Mit mir. Für dich wird es keine Antworten geben. Nicht einmal das Ende deiner ach so ersehnten Apokalypse wirst du miterleben.
#. fr: Tu vas t'<i>endormir</i> ici avec moi, bien gentiment. Tes questions resteront sans réponse, et le dénouement de cette apocalypse demeurera pour toujours un mystère pour toi<nbsp>!
#. speaker: ASAHI
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005760_ASAHI:1"
msgid "Now you are at my mercy. I shall drag us both into oblivion, and you will never see the fulfillment of your magnum opus!"
msgstr ""

#. ja: 次に生まれることがあったとしても……<br>苦しんで、苦しんで、苦しんで、答えを探し続けろ……！
#. de: Und selbst wenn du irgendwann wiedergeboren werden solltest<nbsp>... So wartet nur noch mehr Leid auf dich! Leid, wohin du dich auch wendest. Leid, das deiner Seele selbst anhaftet!
#. fr: Et ne crois pas t'en sortir en étant réincarné<nbsp>! Tu vas souffrir, souffrir et encore souffrir en te torturant l'esprit à perpétuité<nbsp>!
#. speaker: ASAHI
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005770_ASAHI:1"
msgid "Even should you be reborn, your desperate search for answers must start again!"
msgstr ""

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q6
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_Q6_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr ""

#. ja: あとのことは任せろ
#. de: Ich kümmere mich um den Rest. Das verspreche ich dir.
#. fr: Fais-moi confiance, je m'occupe du reste.
#. speaker: A6
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A6_000_001_NONE_VOICE:1"
msgid "I'll do what must be done."
msgstr ""

#. ja: …………
#. de: ...
#. fr: ...
#. speaker: A6
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A6_000_002_NONE_VOICE:1"
msgid "..."
msgstr ""

#. ja: 次はきっと、一緒に探そう
#. de: Das nächste Mal suchen wir gemeinsam nach Antworten.
#. fr: Nous chercherons ces réponses ensemble, la prochaine fois.
#. speaker: A6
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A6_000_003_NONE_VOICE:1"
msgid "Next time, we will find the answer together."
msgstr ""

#. ja: ハ……何を任せられるって言うんですか……。
#. de: Hah<nbsp>... Dich um den Rest kümmern?
#. fr: T'occuper du reste<nbsp>? Qu'est-ce que tu racontes...<nbsp>?
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005780_AMON:1"
msgid "Heh... And what might that be?"
msgstr ""

#. ja: 私の望みは、すべてを殺して、死ぬことですよ。
#. de: Verstehst du es immer noch nicht<nbsp>...? Ich will den Tod. Für mich und für euch.
#. fr: Mon seul et unique souhait est la destruction totale... Alors seulement pourrai-je mourir en paix.
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005790_AMON:1"
msgid "My wish is all but granted─to die and take you all with me."
msgstr ""

#. ja: フ…
#. de: Heh
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005800_AMON:1"
msgid "Report if displayed."
msgstr ""

#. ja: 何を馬鹿なことを……。
#. de: Sei nicht albern<nbsp>...
#. fr: Ne dis pas de bêtises...
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005810_AMON:1"
msgid "Even here. Even now..."
msgstr ""

#. ja: 恨んだまま、赦す必要はない……。<br>こんな愚か者のことは、過去へ置いていくといい……。
#. de: Hass mich, ich kann es dir nicht verdenken. Aber lass mich zurück. Lass diesen Narren zurück<nbsp>...
#. fr: Tu n'as pas à me pardonner. Oublie-moi ici, ça vaudra mieux pour toi.
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005820_AMON:1"
msgid "You have every right to hate me. For the fool I was, for the monster I became."
msgstr ""

#. ja: 私も、謝ったりはしません。<br>あのときヘルメスがあなたに抱いた心残りを、<br>永遠に、未練のままにしておいてやりますよ。
#. de: Ich werde mich auch nicht entschuldigen. Hermes' Reue<nbsp>... Die Worte, die er dir gerne gesagt hätte. Sie behalte ich bei mir. Und stelle sicher, dass sie auf ewig unausgesprochen bleiben.
#. fr: Sache que je n'ai aucune intention de m'excuser. Les regrets d'Hermès, je les garderai avec moi pour l'éternité.
#. speaker: AMON
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005830_AMON:1"
msgid "But I will not beg forgiveness. The tale of Hermes─the man who knew so much, yet understood so little─ends here."
msgstr ""

#. ja: 俺がいるうちは、星海へ来ないでもらえますか？<br>死んでからもあなた方の顔を拝みっぱなしとか、最悪なので。
#. de: Wärt ihr so freundlich, euch im Sternengrund nicht mehr blicken zu lassen, solange ich hier verweile? Eure Gesichter selbst nach dem Tod noch ertragen zu müssen, ist eine wahre Qual.
#. fr: Au fait, vous pourriez éviter la mer des étoiles quand j'y suis<nbsp>? C'est déjà pas drôle d'être mort, alors si en plus je dois me coltiner vos têtes d'ahuris...
#. speaker: ASAHI
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005840_ASAHI:1"
msgid "Don't try to follow me. I had more of you people than I could stomach in life, never mind in death."
msgstr ""

#. ja: ああ……そうならないように、心がけよう。
#. de: Selbstverständlich<nbsp>... Wir werden dich nicht weiter behelligen.
#. fr: Nous ferons en sorte que cela ne se reproduise plus.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005850_ALPHINAUD:1"
msgid "Likewise. I pray we do not meet again."
msgstr ""

#. ja: チッ、本当に言葉どおりの意味ですからね。
#. de: Tsk<nbsp>... Die Hoffnung stirbt zuletzt.
#. fr: Plus tard vous reviendrez, mieux ce sera.
#. speaker: ASAHI
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005860_ASAHI:1"
msgid "Hmph. You had better hope not."
msgstr ""

#. ja: ……行こう、ハイデリンが呼んでいるんだ。
#. de: Gehen wir. Hydaelyn wartet.
#. fr: Allons-y, Hydaelyn nous attend.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005870_ALPHINAUD:1"
msgid "Come. Hydaelyn is waiting."
msgstr ""

#. ja: よくぞここまで辿り着きました……。
#. de: Ihr habt einen langen Weg hinter euch<nbsp>...
#. fr: Vous voilà enfin...
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005880_HYDAELYN:1"
msgid "Brave travelers, I welcome you."
msgstr ""

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q7
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_Q7_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr ""

#. ja: 久しぶり、ヴェーネス
#. de: Venat<nbsp>... Es ist lange her.
#. fr: Ça faisait longtemps, Venat.
#. speaker: A7
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A7_000_001_NONE_VOICE:1"
msgid "We meet again, Venat."
msgstr ""

#. ja: ずいぶん姿が変わったな
#. de: Du hast dich ordentlich verändert.
#. fr: Tu as bien changé...
#. speaker: A7
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A7_000_002_NONE_VOICE:1"
msgid "You look...different."
msgstr ""

#. ja: っ…
#. de: Hm?
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005890_HYDAELYN:1"
msgid "Report if displayed."
msgstr ""

#. ja: あなたは……エルピスに行ったのですね。
#. de: Du<nbsp>... bist nach Elpis gegangen, nicht wahr?
#. fr: Tu as été à Elpis, n'est-ce pas<nbsp>?
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005900_HYDAELYN:1"
msgid "I see... Thou didst journey unto Elpis."
msgstr ""

#. ja: 私たちの時間が、やっと、ここで繋がった……。
#. de: Und so verknüpfen sich unsere beiden Zeitalter, hier und jetzt<nbsp>...
#. fr: C'est donc ici que nos routes se rejoignent enfin...
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005910_HYDAELYN:1"
msgid "And now, the rivers of time converge."
msgstr ""

#. ja: わかりました。<br>では、その上で、あえてあなたたちに問いましょう。<br>ここへ来た目的を……。
#. de: Ich verstehe. Nun denn, ihr habt meine Aufmerksamkeit. Was ist euer Begehr?
#. fr: Très bien. Pour commencer, j'aimerais entendre de votre bouche la raison de votre venue.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005920_HYDAELYN:1"
msgid "I know why you have come, yet I would hear you speak your reasons, all the same."
msgstr ""

#. ja: ハイデリン、あなたは終末が再来したときに備えて、<br>脱出船としての月を準備していたのよね。
#. de: Hydaelyn. Du hast den Mond als Fluchtschiff vorbereitet, sollten die Letzten Tage erneut über das Gestirn hereinbrechen.
#. fr: Hydaelyn. Pour parer à une nouvelle apocalypse, tu as fait de la lune une arche.
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005930_ALISAIE:1"
msgid "You created the moon to deliver mankind from the Final Days."
msgstr ""

#. ja: でも、本当にそれですべてなの？<br>私たちは逃げたくない……<br>鏡像世界も含めて、この星を救いたいの！
#. de: Aber<nbsp>... war das wirklich alles? Die einzige Lösung? Wir wollen nicht fliehen! Vielmehr wollen wir diesen Planeten retten, ihn und all seine Splitter!
#. fr: Mais nous, on refuse de fuir. On veut sauver cette planète, et tous ses reflets avec elle<nbsp>! Il n'y a vraiment pas d'autre issue<nbsp>?
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005940_ALISAIE:1"
msgid "But is that really how it has to end? We do not wish to abandon this world. We want to protect the Source, and all of its shards!"
msgstr ""

#. ja: そうですね……<br>逃げるのは、人が取り得るふたつの選択、<br>その片方にすぎません。
#. de: Nun<nbsp>... Die Flucht ist stets nur einer von zwei Wegen, nie aber der einzige.
#. fr: Effectivement, l'exode n'est rien de plus qu'un des deux choix qui s'offrent à l'humanité.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005950_HYDAELYN:1"
msgid "To flee is but one of two paths."
msgstr ""

#. ja: もうひとつの道は、<br>メーティオンが巣くう天の果てへ向かうこと。<br>終焉を謳うものたちと、直接決着をつける方法です。
#. de: Der andere Pfad führt euch ans Ende des Universums<nbsp>... in Meteions Nest. Es ist die Option der direkten Konfrontation mit jener, die das Ende herbeisehnt.
#. fr: L'alternative consiste à se rendre aux confins de l'univers pour trouver Météion et affronter les partisans de l'ané<shy>an<shy>tis<shy>se<shy>ment total.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005960_HYDAELYN:1"
msgid "The other leadeth to Meteion, far beyond the stars, where she doth chant creation's requiem."
msgstr ""

#. ja: ……しかし、そこは彼女たちが支配する、<br>デュナミスで構築された宙域。
#. de: Aber seid gewarnt. Jener Raum besteht aus dem Dynamis. Der Kraft, die sie formt und webt, wie es ihr beliebt.
#. fr: Mais vous devez savoir que leur antre est intégralement constitué de dynamis, l'énergie qu'ils contrôlent à leur guise...
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005970_HYDAELYN:1"
msgid "Her domain is formed of dynamis. Pure. Absolute."
msgstr ""

#. ja: 想いだけが力となるその場所では、<br>どれほどのエーテルを有し、強大な魔法を繰ろうとも、<br>決して彼女たちに勝つことはできません。
#. de: Ganz gleich, wie mächtig eure Zauber sind oder wie stark euer Äther<nbsp>... An einem Ort, an dem ihre Gefühle und Gedanken herrschen, werden sie euch nicht helfen.
#. fr: Dans ce lieu qui n'a pour limites que celles de leurs sentiments, même les plus puissants sorts de magie ne vous suffiront pas pour remporter la victoire.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005980_HYDAELYN:1"
msgid "Where emotion and memory govern all, aether will avail you naught."
msgstr ""

#. ja: かの空間に集められた、先ゆく星々の絶望、苦しみ、悲しみ……<br>それらに抗えなければ、行くだけ無駄。<br>あえなく全滅するでしょう。
#. de: Wenn ihr euch der geballten Ver<shy>zweif<shy>lung, dem Leid und dem Kummer der in ihrem Nest ruhenden Sterne nicht widersetzen könnt, so ist euer Vorhaben zum Scheitern verurteilt. Es wird euch verschlingen, mit Haut und Haar.
#. fr: Si vous ne parvenez pas à résister au désespoir, à la souffrance et à la tristesse des astres qui y sont réunis, vous serez purement et simplement anéantis.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_005990_HYDAELYN:1"
msgid "Meteion hath gathered the pain and despair of countless stars, and to go unprepared is to go unto your doom."
msgstr ""

#. ja: そんなの平気よ、私は屈したりしないわ！
#. de: So weit werden wir es nicht kommen lassen!
#. fr: Aucun problème, je suis pas du genre à me laisser décourager<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006000_ALISAIE:1"
msgid "We'll beat her. We'll win. I swear it!"
msgstr ""

#. ja: ……なんて、昔なら言えたかもしれないけど。
#. de: ... Zumindest glaubte ich das einst.
#. fr: ... Enfin, c'est ce que je croyais autrefois.
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006010_ALISAIE:1"
msgid "...Is what I might've said, once."
msgstr ""

#. ja: 旅の中には、確かにあったわ。<br>どうしようもなく悲しいこと……<br>恐れるなって言い聞かせても、足がすくんだこともね。
#. de: Doch auf unseren Reisen ist es uns unzählige Male passiert. Von einem Kummer gelähmt zu sein, der das Herz zu zerfressen droht.
#. fr: Ce serait mentir de dire que je me suis jamais sentie abattue au cours de tous nos voyages, ou que je n'ai jamais eu peur.
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006020_ALISAIE:1"
msgid "After everything I've seen, all the times I've succumbed to my own anger and fear..."
msgstr ""

#. ja: あの想いを、なかったことにはできない。<br>絶対に大丈夫だなんて言えない。
#. de: Diese Momente zu verneinen, wäre nicht nur unrecht<nbsp>... Wir könnten es auch gar nicht. Und so weiß ich nicht, ob wir der Probe tatsächlich gewachsen sind.
#. fr: On n'oublie pas des moments aussi marquants. Et ils nous rappellent constamment qu'on peut faillir...
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006030_ALISAIE:1"
msgid "...I can no longer pretend that courage and faith will be enough."
msgstr ""

#. ja: そんな私たちじゃ、逃げる道を選ぶことしかできないの……！？
#. de: Bleibt uns also wirklich nur die Flucht?!
#. fr: La fuite serait vraiment notre seule option, alors<nbsp>!?
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006040_ALISAIE:1"
msgid "But are we truly so powerless? That our only choice is to flee?"
msgstr ""

#. ja: ……いいえ。<br>あなたたちは、だからこそ可能性を持つのです。
#. de: Nein. Eben diese Erfahrungen sind euch wieder und wieder zu eurer größten Stärke geworden.
#. fr: Non. C'est justement pour cela que vous avez toujours en vous la possibilité de choisir votre destin.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006050_HYDAELYN:1"
msgid "Far from it, my child."
msgstr ""

#. ja: かつて、アーテリスよりも栄えた多くの星々が、<br>負の感情のない楽園を作り出そうと試みました。
#. de: Im Lauf der Geschichte haben schon viele Gestirne nach einem Paradies ohne Leid und Kummer gestrebt. Planeten, die weitaus prächtiger blühten als Ætheris.
#. fr: Autrefois, de nombreuses planètes encore plus florissantes qu'Ætherys ont tenté de matérialiser le rêve d'un paradis dénué de sentiments négatifs.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006060_HYDAELYN:1"
msgid "Long ago, the inhabitants of myriad stars─many more prosperous than Etheirys─sought to free their worlds from life's woes."
msgstr ""

#. ja: 悲しみや怒り、争いや破滅、死や絶望……<br>そういったものを排除しようとして、失敗したのです。<br>メーティオンの報告によれば、ひとつの成功例もなく。
#. de: Sie alle haben es versucht<nbsp>... Und sie alle sind gescheitert. Den Berichten Meteions zufolge gab es nicht ein Gestirn, das die Furcht und die Wut, den Schmerz und das Leid, den Hass und die Zerstörung von seinem Antlitz tilgen konnte.
#. fr: En essayant d'éliminer la peine, la colère et le désespoir, ou même des concepts tels que la guerre, la destruction et la mort, elles ont échoué. D'après les rapports de Météion, pas une n'a fait exception.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006070_HYDAELYN:1"
msgid "Sorrow and anger, conflict and hostility, despair...and even death itself. But as Meteion reported, every attempt ended in failure."
msgstr ""

#. ja: だとすれば……それらの闇は、<br>決してなくならないものなのでしょう。
#. de: Das legt nahe, dass sie ein fester Bestandteil unserer Existenz sind. Facetten, ohne die das Bild des Lebens sich nicht zu einem Ganzen fügen würde.
#. fr: On peut donc en conclure que ces aspects sombres font partie intégrante de l'être humain et qu'ils ne disparaîtront jamais.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006080_HYDAELYN:1"
msgid "Darkness abideth within every living being, and can never be cast out."
msgstr ""

#. ja: どれほど理想を突き詰めていっても、<br>すべてを消し去ることはできないのです。
#. de: Ganz gleich, wie sehr wir nach Perfektion und Glückseligkeit streben<nbsp>...
#. fr: Quel que soit l'idéal auquel on aspire, certains concepts sont immuables par essence.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006090_HYDAELYN:1"
msgid "Neither reason nor faith can challenge this immutable truth."
msgstr ""

#. ja: だから生命は、必ず絶望する。
#. de: Das Leben und die Ver<shy>zweif<shy>lung gehen Hand in Hand.
#. fr: La perfection n'est qu'une utopie, et c'est ce qui fait que l'homme finit invariablement par perdre espoir.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006100_HYDAELYN:1"
msgid "To live is to suffer."
msgstr ""

#. ja: するけれど……しない誰かがいたのなら、繋いでいけます。
#. de: Doch dies sind zwei Seiten derselben Medaille. Auch die Ver<shy>zweif<shy>lung kann nicht ohne das Leben und seine Hoffnung bestehen.
#. fr: Et pourtant, tant qu'il y a de la vie...
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006110_HYDAELYN:1"
msgid "And in suffering find strength, and purpose. And hope."
msgstr ""

#. ja: あなたたちだって、そうしてここに至ったのではありませんか？
#. de: Ihr, die ihr hier vor mir steht, seid doch selbst der beste Beweis dafür, nicht wahr?
#. fr: Votre présence en ce lieu est bien la preuve que vous n'avez jamais abandonné, n'est-ce pas<nbsp>?
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006120_HYDAELYN:1"
msgid "As you have done so many times before."
msgstr ""

#. ja: 完璧な正しさは存在しなかった。<br>その理想が打ち砕かれたとき、<br>傍らに立つ者に、手を差し伸べられた。
#. de: Deine Weltanschauung zerbrach einst an deinem Streben nach der absoluten Gerechtigkeit. Noch während du vor ihren Scherben standest, reichten dir jene, die stets an deiner Seite weilten, die Hand.
#. fr: Ton monde s'est écroulé lorsque tu as pris conscience qu'il n'y avait pas de justice absolue, et pourtant tes compagnons t'ont tendu la main.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006130_HYDAELYN:1"
msgid "Thou dost pursue an impossible dream, yet knowing this, you pursue it nevertheless. And thou hast learned to depend on others, as they do thee."
msgstr ""

#. ja: 己の力は、望みに足りはしなかった。<br>無力に苛まれたときも、目指す背中は揺るぎなかった。
#. de: Deine Stärke allein reichte oft nicht aus, um deine Wünsche zu tragen. Dort, wo du an deine Grenzen stößt, wartet jedoch stets <if $gn4>eine Vertraute<else>ein Vertrauter</if>, <if $gn4>die<else>der</if> dich zu beflügeln weiß.
#. fr: Ta force seule s'est parfois révélée insuffisante pour réaliser tes souhaits, mais à chaque fois que ton impuissance te tourmentait, ton modèle était là pour t'emmener dans son sillage.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006140_HYDAELYN:1"
msgid "Thy yearning for the power to save the powerless hath ever driven thee to greater heights. Thou hast grown strong."
msgstr ""

#. ja: 大切な者は、その手をすり抜けていった。<br>けれども愛は継がれ、新たな希望に巡り合えた。
#. de: Du vermochtest nicht zu schützen, was dir teuer war und ein geliebtes Leben rann durch deine Finger. Doch eben diese Liebe wurde zum Nährboden neuer Hoffnung. Für dich und für andere.
#. fr: Malgré le chagrin de ne pas avoir pu protéger la personne à laquelle tu tenais le plus, tu n'as jamais renié l'amour qui t'habitait et cela t'a mené à la rencontre d'un espoir nouveau.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006150_HYDAELYN:1"
msgid "Though those closest to thee no longer walketh by thy side, their love remaineth thy guiding light."
msgstr ""

#. ja: 言葉は本質から遠く、あなたを悩ませた。<br>その心を理解してくれる者たちがいた。
#. de: Wo dir die Worte den Dienst versagen, da sprießt das Leid in dir. Nur gab es immer jene, die gar keiner Worte bedurften, weil sie die Sprache deines Herzens sprechen.
#. fr: Quant à toi, tu as souffert de ne pas savoir exprimer l'essence de tes sentiments. Heu<shy>reu<shy>se<shy>ment, ceux qui t'entouraient n'avaient pas besoin de mots pour lire dans ton cœur.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006160_HYDAELYN:1"
msgid "For duty's sake, thou hast been bound by truths unutterable, time and time again. Yet thy heart hath never wavered, as thy companions will attest."
msgstr ""

#. ja: 真実は容易にねじ曲がり、失われる。<br>そう知ってなお探求が止まなかったのは、<br>わずかでも触れたいと願えるものに出会えたから。
#. de: Die Wahrheit ist schnell verzerrt und umso schneller verloren. Dies hält dich jedoch nie davon ab, den widrigsten Umständen zu trotzen und nach verborgener Weisheit zu suchen.
#. fr: La vérité est souvent déformée, parfois oubliée. Même après avoir accepté cet état de fait, tu n'as jamais abandonné ta quête de sagesse dans l'espoir de trouver ce que tu cherchais.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006170_HYDAELYN:1"
msgid "In thy pursuit of mysteries great, all thou believest is brought into question. Undaunted, thy thirst for knowledge remaineth unquenched."
msgstr ""

#. ja: 憎しみは、自他を燃やし尽くした。<br>真っ白な灰の中に、小さくもあたたかなものが遺った。
#. de: Der Hass verbrannte Schwingen wie Schwerter, und zu guter Letzt dich selbst. Zurück blieb allerdings nicht nur Verwüstung - in weißer Asche glomm ein heilender Funken Wärme.
#. fr: La haine a embrasé tes terres et consumé un grand nombre des tiens, mais une lueur d'espérance a surgi des cendres blanches pour révéler un futur couleur azur.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006180_HYDAELYN:1"
msgid "The fires of hatred that once burned in thy heart burneth no more. From their ashes doth spring the light of love, warm and pure."
msgstr ""

#. ja: 大きな災いに対し、人はあまりに非力だった。<br>それでも数多の手に引かれ、押されて、<br>今、新たな地平を臨んだ。
#. de: Deine Ver<shy>zweif<shy>lung türmte sich im Angesicht einer verheerenden Katastrophe. Doch dein unbeirrter Glaube an einen neuen Morgen und eine andere Zukunft schürte letztlich den Mut zur Ent<shy>schlos<shy>sen<shy>heit.
#. fr: Tu as entrepris l'impossible pour sauver un monde d'une catastrophe sans précédent, et après avoir convaincu tout un peuple qu'il pouvait se dresser contre son destin, tu as accepté de vivre ta propre aventure.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006190_HYDAELYN:1"
msgid "As witness to black calamity, thou despaired at man's helplessness. Resolved, thou didst unite a distant world on the brink of collapse."
msgstr ""

#. ja: あなただって……どこで折れていても不思議ではなかった。<br>苦難は十分にありました。
#. de: Du<nbsp>... Auch du wurdest gebrochen. Wieder und wieder. So viel Leid hast du erdulden müssen, so viel Verantwortung auf deinen Schultern getragen.
#. fr: Et toi, bien sûr... Quels que soient les obstacles sur ta route, tu as su les surmonter sans flancher. À ta place, nombreux sont ceux qui auraient depuis longtemps abdiqué.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006200_HYDAELYN:1"
msgid "And thou...my champion. When all did seem lost, thou never abandoned hope."
msgstr ""

#. ja: けれど、ときに旅の続きを想い、この世界で会う誰かを想い、<br>託されたものを糧にして、あなたは立ち上がってきた……。
#. de: In den bittersten Momenten hältst du inne und denkst an den nächsten Schritt deiner Reise, nicht wahr? Oder die nächste Begegnung, die auf dich wartet. Und dann erhebst du dich, wissend, dass du unzählige Hoffnungen mit dir trägst.
#. fr: Dans les moments de doute, tu as pensé aux futurs défis qui t'attendaient, à toutes les rencontres qui t'ont fait aimer ce monde... Et cela t'a donné le cœur de continuer.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006210_HYDAELYN:1"
msgid "For every trial and every foe that did bar thy way, thou hast proven equal to the challenge, drawing courage from the many bonds forged on thy journey."
msgstr ""

#. ja: そうして絶望を知り、<br>いずれ終わりがくることを知りながらも、<br>皆で歩み続けていけることこそが……
#. de: Bei jedem Schritt mit der Ver<shy>zweif<shy>lung ringend, schreitet ihr voran. Und des nahenden Endes stets gewahr, habt ihr doch bis heute nicht innegehalten<nbsp>...
#. fr: Toujours aller de l'avant, au gré des difficultés, en sachant pertinemment que chacun de vos pas vous rapproche d'une fin inéluctable...
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006220_HYDAELYN:1"
msgid "You have all known despair, and though the end approacheth, you walk on, heads held high."
msgstr ""

#. ja: 今の人が勝ち得てきた力。<br>終焉を謳うものに対抗しうる、強さなのです。
#. de: Eure Reise ist ein Testament eures Willens. Sie ist die Stärke, die euch zum Widerstand gegen jene wird, die das Lied des Endes singt.
#. fr: C'est ce qui rend les humains uniques, et c'est dans cette force que subsiste votre espoir de vaincre la chantre de l'ané<shy>an<shy>tis<shy>se<shy>ment.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006230_HYDAELYN:1"
msgid "Therein lieth your power. The strength to silence the song of oblivion."
msgstr ""

#. ja: では……！<br>私たちは、終末を止めに行くことができるのですか……！？
#. de: Du<nbsp>... traust uns also zu, den Untergang aufhalten zu können?
#. fr: Mais alors, cela veut dire que nous avons encore une chance d'éviter la fin du monde<nbsp>!?
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006240_ALPHINAUD:1"
msgid "Then there is a means to confront her?"
msgstr ""

#. ja: その資格を得るに、かぎりなく近いでしょう。
#. de: Wenn nicht ihr, wer dann?
#. fr: Oui, et vous n'en avez jamais été si proches.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006250_HYDAELYN:1"
msgid "Yes, if you should prove yourselves worthy."
msgstr ""

#. ja: ですが……
#. de: Allerdings<nbsp>...
#. fr: Cependant...
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006260_HYDAELYN:1"
msgid "Hark..."
msgstr ""

#. ja: 人を天の果てに送るのは、至難の業。<br>やり直しは利かず、仕損じれば二度目はありません。
#. de: Bis zum Ende der Sterne zu reisen, ist eine kolossale Aufgabe. Ihr habt nur einen Versuch. Solltet ihr scheitern, ist alles verloren.
#. fr: Envoyer des humains aux confins de l'univers est une opération ex<shy>trê<shy>me<shy>ment délicate. En cas d'échec, une nouvelle tentative serait impossible.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006270_HYDAELYN:1"
msgid "Nigh impossible is it to send mortals to the edge of the universe. Should you fail, there will be no second chance."
msgstr ""

#. ja: ゆえに私は、星の意志として問わなければならない……
#. de: Und so muss ich - der Wille des Planeten - euch nun auf die Probe stellen.
#. fr: En tant que volonté de la planète, je dois donc vous mettre à l'épreuve.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006280_HYDAELYN:1"
msgid "As the will of the star, I ask of you this..."
msgstr ""

#. ja: あなたたちの決意を。<br>強大な相手を前に、幾度倒れ、毀たれようとも、<br>皆でなら戦い抜けるという確信を。
#. de: Zeigt mir, dass in euch das Feuer des Lebens brennt. Der Wille, bis zum Ende zu gehen. Ganz gleich, wie oft ihr dabei in die Knie gezwungen werdet. Ganz gleich, wie sehr es schmerzt.
#. fr: C'est l'unique moyen de m'assurer que tous ensemble, vous saurez vous relever autant de fois qu'il sera nécessaire afin de vaincre un ennemi tout-puissant.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006290_HYDAELYN:1"
msgid "Do you possess the fortitude to stand firm when all around you doth crumble? Do you possess the faith to vanquish despair itself?"
msgstr ""

#. ja: 旧き神にすら屈するようならば、<br>天の果てで待つ者たちに挑むべくもない。
#. de: Fallt ihr hier vor einer einzelnen, uralten Göttin, so erwartet euch am Rand des Universums der sichere Tod.
#. fr: Si vous n'êtes pas capables de me battre, il est inutile que vous alliez défier Météion et ses sœurs.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006300_HYDAELYN:1"
msgid "Should you lack the strength to best a supreme deity, I cannot allow you to make the journey."
msgstr ""

#. ja: 月に乗り、<ruby>星<rt>わたし</ruby>を棄てて、どこへなり逃げるといいでしょう。
#. de: Dann lasst dieses Gestirn hinter euch und flieht. Weit, weit fort von hier.
#. fr: Le cas échéant, vous gagnerez la lune pour vous mettre en quête d'une nouvelle planète où habiter.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006310_HYDAELYN:1"
msgid "You must leave this star and never return."
msgstr ""

#. ja: さあ……構えなさい！
#. de: Nun<nbsp>... Dann los!
#. fr: Sur ce... en garde<nbsp>!
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006320_HYDAELYN:1"
msgid "Prepare yourselves!"
msgstr ""

#. ja: どれほど大層な試練を言い渡されるのかと思えば……<br>なるほど、わかりやすくていい。
#. de: Diese Prüfung beweist ein für alle Mal, was wir uns hier aufgehalst haben, Freunde.
#. fr: Moi qui me demandais à quelle sauce on allait être mangés... Ce genre d'épreuve, ça me connaît<nbsp>!
#. speaker: ESTINIEN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006330_ESTINIEN:1"
msgid "Prove ourselves worthy, eh? Sounds straightforward enough."
msgstr ""

#. ja: その分、ごまかしも利かないがな。
#. de: Und selbst die trickreichste Täuschung würde hier nicht funktionieren<nbsp>...
#. fr: Je ne m'attendais pas à devoir passer un examen d'entrée...
#. speaker: THANCRED
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006340_THANCRED:1"
msgid "Aye, no room for confusion there..."
msgstr ""

#. ja: ……まあ、耐えてみせるさ。<br>なにせこっちには、諦める理由がない。
#. de: Aber die haben wir ja ohnehin nicht nötig, hab ich Recht? Und aufgegeben wird erst recht nicht.
#. fr: Bon, aucun moyen de tricher, et c'est pas maintenant qu'on va se défiler<nbsp>!
#. speaker: THANCRED
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006350_THANCRED:1"
msgid "In any case, we've come too far to back down now."
msgstr ""

#. ja: くずおれそうなら、支えましょう……。<br>微力でも、そのために力を培ってきたのですから。
#. de: Ich werde stützen und stärken, wo ich nur kann. So bescheiden meine Künste auch sein mögen, so habe ich sie doch genau zu diesem Zweck geschliffen.
#. fr: Vous pouvez compter sur mon soutien. J'ignore si je serai à la hauteur, mais je vous promets de donner le meilleur de moi-même.
#. speaker: URIANGER
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006360_URIANGER:1"
msgid "I am of the same mind. What power I have, I shall bring to bear."
msgstr ""

#. ja: まったく、あなたたちときたら……<br>相手は最強の蛮神のひと柱、星の意志だとわかっていて？
#. de: Was sind wir nicht alle voller Zuversicht<nbsp>... Euch ist aber schon bewusst, dass wir es hier mit dem Willen des Gestirns selbst zu tun haben, ja?
#. fr: Vous alors, décidément... Vous avez conscience qu'on a affaire à un des plus puissants Primordiaux, la volonté même de la planète sur laquelle on se tient<nbsp>!?
#. speaker: YSHTOLA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006370_YSHTOLA:1"
msgid "The three of you seem to be forgetting who we're up against... It's not every day we battle a divine being of untold power. Well, not quite every day."
msgstr ""

#. ja: でも、ええ、私も負ける気はしないわね。
#. de: Aber<nbsp>... Ich gebe zu, dass auch mir nicht nach einer Niederlage ist.
#. fr: Enfin bon, je n'ai pas la moindre intention de perdre, moi non plus.
#. speaker: YSHTOLA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006380_YSHTOLA:1"
msgid "Do try not to get underfoot. Needless to say, there'll be no margin for error."
msgstr ""

#. ja: 全力でいただいてくぞ……！<br>すべての世界を救う、最後の可能性……星と命の未来を！
#. de: Es wird jedes Quäntchen Kraft kosten, das wir in uns tragen. Für die Zukunft des Planeten, nein, des Lebens selbst!
#. fr: Il n'y a pas à hésiter<nbsp>! Puisque cette possibilité existe, à nous de la saisirrr<nbsp>! Pour le futur de la planète, et de l'humanité tout entière<nbsp>!
#. speaker: GRAHATIA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006390_GRAHATIA:1"
msgid "Let us hold nothing back! For the people of this world and those beyond the rift!"
msgstr ""

#. ja: ええ！
#. de: ええ！
#. fr: Ouais<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006400_ALISAIE:1"
msgid "Report if displayed."
msgstr ""

#. ja: ああ！
#. de: ああ！
#. fr: Oui<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006410_ALPHINAUD:1"
msgid "Report if displayed."
msgstr ""

#. ja: エルピスでは聞けずじまいだったことを、<br>今一度、あなたに問いましょう。
#. de: In Elpis konntest du mir keine Antwort geben, also fordere ich sie jetzt.
#. fr: Cette fois, tu vas enfin pouvoir répondre à la question cruciale que je t'ai posée à Elpis.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006420_HYDAELYN:1"
msgid "Alas, the question I posed to thee in Elpis hath remained unanswered these long years."
msgstr ""

#. ja: あなたの旅が、良いものであったなら……<br>勝利を以て、示しなさい！
#. de: War deine Reise eine gute<nbsp>... so zeig es mir! Beweise es mit einem Sieg!
#. fr: Le voyage en valait-il la peine<nbsp>? Si c'est le cas, prouve-le-moi en remportant la victoire<nbsp>!
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006430_HYDAELYN:1"
msgid "I would hear thy response, Warrior of Light, shouldst thou emerge victorious!"
msgstr ""

#. ja: 星の意志として  最後の旧き人として<br>あなたたちの勝ち得た強さを見定めましょう
#. de: Als Wille des Planeten und die Letzte der Alten will ich nun über euch und eure Stärke richten.
#. fr: En tant que volonté de la planète et dernière re<shy>pré<shy>sen<shy>tante des Anciens, je vais maintenant juger de votre valeur.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006440_HYDAELYN:1"
msgid "I, the last of my kind, shall test thee. Come, prove thy worth!"
msgstr ""

#. ja: ああ――人は――やっと――
#. de: So besteht<nbsp>... doch noch<nbsp>...
#. fr: Enfin... l'humanité... est prête...
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006450_HYDAELYN:1"
msgid "At last...man has the strength to..."
msgstr ""

#. ja: ハイデリン、あなた……やっぱりもう、力が……！
#. de: Hydaelyn! Oh nein, deine Kräfte<nbsp>...!
#. fr: Hydaelyn... Ton énergie...<nbsp>!
#. speaker: ALISAIE
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006460_ALISAIE:1"
msgid "No! This can't be happening!"
msgstr ""

#. ja: フ…
#. de: Heh
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006470_HYDAELYN:1"
msgid "Hmmm."
msgstr ""

#. ja: 星の意志として、未来の番人として、<br>この一戦をきちんとやり遂げるだけの力は、<br>残してありました。
#. de: Als Wille des Planeten und Wächterin über die Zukunft hatte ich mir genügend Kräfte gespart, diesen letzten Kampf zu Ende zu bringen.
#. fr: En tant que volonté de la planète et gardienne de son futur, j'avais conservé juste assez d'énergie pour mener ce combat à son terme.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006480_HYDAELYN:1"
msgid "Though my power is in constant flux, I have always kept a reserve for this very moment."
msgstr ""

#. ja: だから、大丈夫……。<br>あなたたちは正しく試され、正しく打ち勝ったわ。
#. de: Nun ist es gut. Ihr wurdet rechtens geprüft<nbsp>... und habt rechtens gesiegt.
#. fr: Soyez tranquilles... Vous avez été mis à l'épreuve comme il se doit, et vous avez brillamment réussi.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006490_HYDAELYN:1"
msgid "It was a true test of your prowess. You have done well."
msgstr ""

#. ja: ……本題に入る前に、ひとつ教えてもらえるかしら。
#. de: Bitte beantworte mir noch eines, bevor wir aufbrechen.
#. fr: J'aimerais te poser une question...
#. speaker: YSHTOLA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006500_YSHTOLA:1"
msgid "There is one thing I must ask."
msgstr ""

#. ja: あなたが世界を14に分割した理由……<br>それはもしや、エーテルが薄弱な生物の方が、<br>デュナミスに干渉しやすいからではなくて？
#. de: Du hast Ætheris damals in vierzehn Welten zerschlagen, weil Geschöpfe von schwachem Äther das Dynamis leichter manipulieren können, nicht wahr?
#. fr: Quand tu as divisé Ætherys en quatorze fragments, ton but était-il d'affaiblir l'éther des humains pour leur permettre d'interférer plus facilement avec le dynamis<nbsp>?
#. speaker: YSHTOLA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006510_YSHTOLA:1"
msgid "By sundering the world into fourteen shards, the aether of all living beings too was divided. This reduction would in theory allow us to more easily interact with dynamis."
msgstr ""

#. ja: あなたは、一度終末に打ちのめされた人類が、<br>今度こそ絶望を受け止められるようになることを、<br>願った……信じた。
#. de: Du konntest es nicht zulassen, dass das Leben im Angesicht der Letzten Tage noch einmal kapitulieren würde. So hast du gehofft, dass wir lernen, der Ver<shy>zweif<shy>lung standzuhalten. Nein, du hast sogar fest daran geglaubt.
#. fr: Tu as prié pour que l'humanité, bien qu'elle ait déjà été terrassée par l'apocalypse, puisse résister au désespoir... Tu étais même convaincue qu'elle en était capable.
#. speaker: YSHTOLA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006520_YSHTOLA:1"
msgid "Having seen mankind brought to the very precipice of extinction, you wished for us to develop a means to overcome despair."
msgstr ""

#. ja: それが遂げられたとき、<br>デュナミス渦巻く天の果てへと終末を止めに行けるように、<br>世界ごと命を創り変えたのでは……？
#. de: Als das nach deinem Schlag neu geformte Leben diese Hoffnung erfüllte, wusstest du, dass der Zweck die Mittel geheiligt hat. Eines Tages würde es jemanden geben, der bereit ist, bis zum Rand der Existenz zu reisen und das Ende aufzuhalten. Liege ich damit richtig?
#. fr: Lorsque ton souhait s'est réalisé, tu as remodelé le monde de façon à ce que ses habitants puissent un jour se rendre aux confins de l'univers, faire face au dynamis et mettre un terme à l'apocalypse. Telle était ton intention, n'est-ce pas<nbsp>?
#. speaker: YSHTOLA
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006530_YSHTOLA:1"
msgid "You believed we had the potential, and sundered all creation to see it fulfilled. To deliver us to that swirling maelstrom of dynamis in which our foe hides, and grant us the power to defeat her once and for all. Is this not true?"
msgstr ""

#. ja: さて……私の行いは、どうあれ人に課した試練。<br>多くを破壊し、多くを苦しめた……<br>優しさや正当性で語られてはならないものです。
#. de: Nun<nbsp>... Wie man es auch dreht und wendet, all mein Wirken war letztlich eine Prüfung. Vieles wurde dadurch zerstört und oft zog es tiefes Leid nach sich. Es verdient weder freundliche Worte, noch kann es gerechtfertigt werden.
#. fr: Tout cela aussi, c'était une épreuve pour les humains. Tant de pertes, tant de souffrance... par ma faute... Je ne mérite ni votre bonté, ni les excuses que vous me trouvez.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006540_HYDAELYN:1"
msgid "It is as thou sayest. 'Twas the trial to which I subjected mankind, and it hath led to untold bloodshed and suffering. There was no kindness nor justice in the tragedy I wrought."
msgstr ""

#. ja: それに、事実、ゾディアークはとても強かった。<br>星を巻き込むくらいの全力でいかないと、<br>どうにもなりませんでした。
#. de: Doch Zodiarks Macht war derart überwältigend<nbsp>... Hätte ich mich nicht aller Mittel bedient, inklusive des Planeten selbst, wäre der Kampf verloren gewesen.
#. fr: En vérité, Zordiarche était tellement puissant... Pour lui tenir tête, j'ai dû utiliser toute ma force, au point d'entraîner la planète dans notre af<shy>fron<shy>te<shy>ment.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006550_HYDAELYN:1"
msgid "When confronted with the almighty Zodiark, my only recourse was to rend Him and the world asunder, that His power be diminished for a time."
msgstr ""

#. ja: 大切なのは、私が何をしたかではなく、<br>あなたたちが今、私を乗り越えたということです。
#. de: Letztlich zählt nicht, was ich getan habe. Nur, dass ihr mich überwunden habt.
#. fr: Ce qui compte désormais, ce ne sont pas mes actions passées mais le fait que vous ayez réussi à me surpasser.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006560_HYDAELYN:1"
msgid "And so it came to pass. Now you, my chosen, have surpassed my expectations. Surpassed me."
msgstr ""

#. ja: だから、逃げずに立ち向かう方法を……<br>すべての命運を、その手に託します。
#. de: Und nun<nbsp>... lege ich alles Schicksal in eure Hände. Gemeinsam mit dem Schlüssel zur finalen Konfrontation.
#. fr: Je peux donc vous confier le destin de ce monde, ainsi que la clef pour aller le défendre.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006570_HYDAELYN:1"
msgid "I entrust the fate of the universe...unto you."
msgstr ""

#. ja: そこには、私が割り出した、<br>メーティオンの軌跡が記録されています。
#. de: Dies ist eine Aufzeichnung von Meteions Pfad durch den Himmel. Ich selbst habe ihn berechnet.
#. fr: Ceci contient mes estimations du trajet de Météion, tout au long de son voyage jusqu'aux confins de l'univers.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006580_HYDAELYN:1"
msgid "This crystal contains the memory of Meteion's passage through the stars."
msgstr ""

#. ja: 天を航行する術を学んだレポリットたちならば、<br>向かうべき座標を割り出し、案内してくれることでしょう。
#. de: Die Loporrit sind des Navigierens durch das Sternenmeer mächtig. Sie werden die Koordinaten zu entschlüsseln wissen und euch zu ihrem Nest führen.
#. fr: Si vous les montrez aux Loporrites, qui sont rompus aux techniques de navigation spatiale, ils devraient pouvoir en extraire les coordonnées exactes de votre destination.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006590_HYDAELYN:1"
msgid "Deliver it unto the Loporrits. They will guide you to her."
msgstr ""

#. ja: しかし、私たちは実際にそこへ到達できるのだろうか……。<br>天の果てというくらいだ、月に行くよりずっと困難だろう。
#. de: Aber werden wir auch tatsächlich dort ankommen? Der Flug zum Mond scheint eine Leichtigkeit im Vergleich zu einer Reise bis an den Rand des Universums.
#. fr: Sommes-nous seulement capables d'atteindre un point aussi éloigné<nbsp>? Cela me semblait déjà incroyable d'aller sur la lune, alors au fin fond de l'univers...
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006600_ALPHINAUD:1"
msgid "Though they may be capable of crossing great distances, there is a vast difference between traveling to the moon and the furthermost reaches of the great expanse."
msgstr ""

#. ja: メーティオンのように、<br>デュナミスを使って翔ぶわけにもいかないだろうし……。
#. de: Im Gegensatz zu Meteion können wir uns für eine solche Reise nicht einfach das Dynamis zunutze machen<nbsp>...
#. fr: Sans nous servir du dynamis comme l'a fait Météion, je ne vois pas comment nous pourrions accomplir un tel miracle.
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006610_ALPHINAUD:1"
msgid "And unlike Meteion, we cannot simply soar on waves of dynamis to our destination."
msgstr ""

#. ja: ええ、エーテルを動力とする場合、<br>目的地に到達するために必要な量は、<br>並大抵のものではありません。
#. de: Richtig. Nutzt man Äther als Antrieb, bedarf es einer exorbitanten Menge, um eine derartige Distanz zurückzulegen.
#. fr: Effectivement, si l'éther est votre carburant, il vous en faudra une quantité incommensurable pour un tel voyage.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006620_HYDAELYN:1"
msgid "Indeed. To make such a journey would require an astronomical amount of aether."
msgstr ""

#. ja: ……ですが、あなたたちはすでに、<br>解決法を目の当たりにしているはずですよ。
#. de: Doch ihr seid euch der Lösung dieses Problems sicherlich bereits gewahr<nbsp>...
#. fr: Cependant, la solution à votre problème existe, et vous la connaissez même déjà.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006630_HYDAELYN:1"
msgid "But a solution lieth close at hand."
msgstr ""

#. ja: まさか……！？
#. de: Ist das dein Ernst<nbsp>...?!
#. fr: Ne me dites pas que...<nbsp>!
#. speaker: ALPHINAUD
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006640_ALPHINAUD:1"
msgid "Of course!"
msgstr ""

#. ja: ええ、そのまさかです。
#. de: Mein vollster, ja.
#. fr: Et pourtant, si.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006650_HYDAELYN:1"
msgid "Yes, my child."
msgstr ""

#. ja: 私は星の意志となって以来、<br>この場に満ちるエーテルを少しずつ結晶にしてきた……
#. de: Seitdem ich der Wille des Planeten bin, habe ich den Äther des Sternengrunds nach und nach kristallisiert.
#. fr: Depuis que je suis devenue la volonté de la planète, je me suis efforcée de cristalliser peu à peu l'éther qui emplit ces lieux.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006660_HYDAELYN:1"
msgid "Ever since I became the will of the star, the aether drawn here hath slowly crystallized."
msgstr ""

#. ja: ここへ精神を繋げた超える力の持ち主たちは、<br>必ず「それ」を見たでしょう。
#. de: Denjenigen, die der Kraft des Transzendierens mächtig sind, ist sein Anblick wohlbekannt.
#. fr: Tous ceux qui ont hérité du pouvoir de l'Écho, et qui sont liés à cet espace par la pensée, ont déjà eu l'occasion de l'admirer.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006670_HYDAELYN:1"
msgid "They who have answered my call know it well."
msgstr ""

#. ja: そして姿を顕さない私に代わり、<br>「それ」を星の意志の象徴として捉えたのです。
#. de: Da, wo mir eine physische Form fehlt, repräsentiert er den Willen des Planeten.
#. fr: Il se substitue d'ailleurs à moi, qui ne possède pas de forme physique, pour représenter la volonté de la planète dans leur esprit.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006680_HYDAELYN:1"
msgid "While I have remained hidden, it hath become the embodiment of the planet's will in my place. A faceless, omnipotent force of nature."
msgstr ""

#. ja: マザークリスタル……<br>この星が蓄えてきた、反撃の切り札。<br>あなたたちを、天の果てへと運ぶ力です。
#. de: Der Urkristall<nbsp>... Er ist unser allerletzter Widerstand, der uns den entscheidenden Vorsprung sichert. Er wird euch ans Ende der Sterne tragen.
#. fr: Le Cristal-mère, le dernier atout de l'humanité... C'est lui qui vous emmènera aux confins de l'univers.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006690_HYDAELYN:1"
msgid "The Mothercrystal...our final hope."
msgstr ""

#. ja: けれど、私が手を貸せるのはそこまで……。<br>行った先で待ち受ける、絶望の闇の中は、<br>あなたたち自身の力で、進んでもらわねばなりません。
#. de: Leider ist dies auch das Letzte, was ich für euch tun kann. Der Finsternis, die euch am Ende des Weges mit Kummer zu ersticken droht, müsst ihr euch alleine stellen.
#. fr: Pour ma part, je ne peux vous aider davantage. Là où vous allez, vous ne pourrez compter que sur vous-mêmes pour avancer au plus profond des ténèbres du désespoir.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006700_HYDAELYN:1"
msgid "Alas, I can do no more. The fulfillment of this task doth fall to you, my chosen."
msgstr ""

#. ja: だから、必ず覚えていてください。
#. de: Und so denkt stets an eins, meine Kinder.
#. fr: C'est pourquoi j'aimerais que vous vous souveniez bien de ceci.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006710_HYDAELYN:1"
msgid "Now, heed these words."
msgstr ""

#. ja: 誰かの歓びが、誰かの悲しみであるのなら……<br>あらゆる人が絶望する中で、<br>あなたひとりが希望を抱くことも、あるのだと。
#. de: So, wie aus des einen Freude eines anderen Kummer erwächst<nbsp>... So ist es euch auch möglich, inmitten der Wogen der Ver<shy>zweif<shy>lung dennoch die Hoffnung in euch zu tragen.
#. fr: Quoi qu'il arrive, vous devrez toujours croire en vous. Rien ne vous interdit de garder espoir, même si l'humanité entière a déjà abdiqué.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006720_HYDAELYN:1"
msgid "Darkness and Light. Despair and hope. As goeth one, so goeth the other. Become Light. Become hope."
msgstr ""

#. ja: 最後にもうひとつだけ、あなたへ……<br>どうか、近くまで来てもらえませんか……？
#. de: Und auch an dich will ich noch ein letztes Wort richten<nbsp>... Tritt bitte ein Stück näher.
#. fr: Un dernier mot, juste pour toi... Approche un peu, s'il te plaît.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006730_HYDAELYN:1"
msgid "I have a gift for thee... Come closer."
msgstr ""

#. ja: ……今日までの永い時間、<br>星の未来を繋ぐ方法を探してきました。
#. de: Seit ewiger Zeit und bis zum heutigen Tag habe ich fieberhaft nach einem Weg gesucht, diesem Gestirn eine Zukunft zu schenken.
#. fr: Jusqu'à aujourd'hui, pendant toutes ces années, je n'ai eu de cesse de chercher un moyen d'offrir un futur à cette planète.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006740_HYDAELYN:1"
msgid "Long have I searched for a means to safeguard the future of this star."
msgstr ""

#. ja: 幾度となく窮地に陥ったとき、<br>あなたから聞いた冒険の話や、あなたとの約束が、<br>どれだけ私に勇気をくれたことか。
#. de: Ich vermag nicht zu sagen, wie oft ich dabei selbst gefährlich nahe am Abgrund der Ver<shy>zweif<shy>lung gewandelt bin. Und jedes Mal haben mich die Geschichten deiner Abenteuer mit neuem Mut beflügelt. Ebenso wie das Versprechen, das wir uns gaben.
#. fr: Je ne compte pas le nombre de fois où, alors que j'étais en proie au doute, les récits de tes aventures et la promesse que nous nous sommes faite m'ont donné le courage de surmonter les difficultés.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006750_HYDAELYN:1"
msgid "Though I knew failure after failure, by recalling thy tales─and my promise to thee─I found the strength to carry on."
msgstr ""

#. ja: 世界が変わっても、そこに何かを求めて旅をする者がいる。<br>別の歴史だったとしても、未来のために戦う者がいる……。
#. de: In einer dir gänzlich fremden Welt hast du beherzt nach deinem Glück gesucht. In einer dir gänzlich fremden Zeit doch mit aller Macht um ihre Zukunft gerungen.
#. fr: Même quand le monde changeait, tu as toujours été là pour partir à l'aventure et y accomplir ta quête. Et même dans d'autres temps, tu as toujours combattu pour protéger son avenir...
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006760_HYDAELYN:1"
msgid "Though the world is ever changing, thy thirst for adventure hath never waned."
msgstr ""

#. ja: ただそれだけで、私は何度だって、<br>人を信じ直すことができたのです。
#. de: Das allein hat den Glauben an das Leben so, so oft neu in mir entfacht.
#. fr: Autant d'occasions pour moi d'être admirative envers les humains, et de croire en vous encore plus à chaque fois.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006770_HYDAELYN:1"
msgid "Thine unshakable resolve never ceaseth to amaze. To inspire."
msgstr ""

#. ja: ありがとう……。<br>ささやかですが、心をこめて、お礼をさせてください。
#. de: Es ist nur ein kleines Wörtchen, aber ich spreche es doch aus tiefstem Herzen. Danke.
#. fr: Je sais que ce n'est pas grand-chose, mais du fond du cœur, je voudrais te dire... Merci.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006780_HYDAELYN:1"
msgid "As a mark of my gratitude, I bestow this final gift."
msgstr ""

#. ja: アゼムの術が込められたクリスタルを、持っていますね……？
#. de: Du trägst Azems Kristall stets bei dir, nicht wahr?
#. fr: Tu as toujours le cristal d'Azem avec toi, n'est-ce pas<nbsp>?
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006790_HYDAELYN:1"
msgid "Thou dost possess the crystal of Azem, yes?"
msgstr ""

#. ja: 私、ハイデリンの司る力は、停滞、鎮静、平穏……<br>つまりは、存在を固定するものです。
#. de: Die Mächte, über die ich als Hydaelyn gebiete, sind der Stillstand, die Ruhe<nbsp>... Das, was das Leben hält, wenn du so willst.
#. fr: Si je devais décrire mon pouvoir, je dirais qu'il exprime la stagnation, le calme, la tran<shy>quil<shy>li<shy>té... En substance, la faculté de cristalliser l'existence.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006800_HYDAELYN:1"
msgid "As Hydaelyn, I preside over the forces of stasis, tranquility, peace. The laws which impart stability to existence itself."
msgstr ""

#. ja: その力をアゼムの術式に組み込むことによって、<br>数度かぎりではありますが、<br>姿なき者を喚び、形を与えることができるでしょう。
#. de: Kombiniert mit Azems Macht sollte es dir möglich sein, das Verborgene zu rufen und ihm Gestalt zu verleihen. Wenn auch nur begrenzt.
#. fr: Associé aux compétences d'Azem, il devrait te permettre de donner forme à l'immatériel pour l'invoquer à tes côtés.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006810_HYDAELYN:1"
msgid "I will weave this selfsame power into the crystal, granting thee mastery over matter, to give form to the formless. Use it wisely, for it will not last indefinitely."
msgstr ""

#. ja: 星海の道すがら、あなたに応えた魂のように……<br>肉体なき者でさえ、喚び寄せられるかもしれません。
#. de: Selbst jene, die längst keinen Körper mehr ihr Eigen nennen, werden deinem Ruf folgen<nbsp>... Ganz ähnlich der Seelen des Sternengrunds.
#. fr: Je pense à ces âmes qui ont réagi à ta présence, quand tu as pénétré dans la mer des étoiles... Peut-être pourras-tu t'en faire des alliés<nbsp>?
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006820_HYDAELYN:1"
msgid "As thou hast seen on thy journey through the aetherial sea, souls are drawn to thee. Mayhap this trait will prove to be a boon rather than a hindrance..."
msgstr ""

#. ja: ……けれど、アゼムの術は、<br>あくまで使う人の願いに応じるもの。<br>望みを持っていてこそ、力を発揮します。
#. de: Aber sei dir einer wichtigen Sache gewahr. Azems Kunst ist keine simple Magie. Vielmehr beruht sie auf deinem eigenen Willen, der erst Gestalt annehmen wird, wenn du einen innigen Wunsch im Herzen trägst.
#. fr: N'oublie pas, le pouvoir d'Azem n'est ni plus ni moins qu'une extension de ta volonté. Il ne s'exprimera que si tu le souhaites au plus profond de toi.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006830_HYDAELYN:1"
msgid "It is thy hopes and prayers that enable Azem's invocations and give them life, so keep them close. But pray, remember this..."
msgstr ""

#. ja: 「自分でさえ結末を思い描けなくなったとき、<br>　先を拓いてくれるのは、その術で喚ばないものだ」
#. de: „Schreite festen Schrittes auf dein Ziel, deines Herzens größten Wunsches folgend. Dann, nur dann werden jene Mächte sich entfalten.“
#. fr: “Lorsque le dénouement ne t'apparaîtra plus clairement, tu ne pourras compter en aucun cas sur ce bienfait pour trouver la voie.”
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006840_HYDAELYN:1"
msgid "When the way forward is hidden even from the mind's eye, look not to the invocation, but within yourself."
msgstr ""

#. ja: 術のもとの持ち主は、そう言っていたわ。
#. de: Das waren die Worte <if $gn4>der Schöpferin<else>des Schöpfers</if> dieser Magie.
#. fr: C'est ce que m'a dit Azem, lorsqu'<if $gn4>elle<else>il</if> m'a transmis ce don.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006850_HYDAELYN:1"
msgid "These were the words of the crystal's original bearer."
msgstr ""

#. ja: ……託せるものは、今度こそこれですべて。
#. de: Dies ist nun alles, was ich dir auf den Weg mitzugeben weiß.
#. fr: Voilà... C'était la dernière chose que j'avais à t'offrir.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006860_HYDAELYN:1"
msgid "With that...my work is finished."
msgstr ""

#. ja: お願い、どうか……約束を……<br>あらゆる時代を超え、積み重ねてきた、人の答えを……
#. de: Bitte<nbsp>... ein letztes Versprechen. Trag sie mit dir, die Antwort des Lebens. Geformt aus unendlich vielen Schicksalen unendlich vieler Zeiten.
#. fr: Je t'en prie, va maintenant. Et porte avec toi le fruit de la vie à travers les âges, la réponse claire et définitive de l'humanité...
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006870_HYDAELYN:1"
msgid "Fulfill our promise. Right the wrongs committed when the world was yet whole. Silence the song of oblivion..."
msgstr ""

#. ja: 私たちは終わるものかと……<br>終焉を謳うものに、叩きつけて……！
#. de: Wir werden nicht vergehen! Schleudert sie der Endsängerin entgegen und bringt ihr Lied zum Verstummen!
#. fr: Fais comprendre à la chantre de l'ané<shy>an<shy>tis<shy>se<shy>ment que notre fin n'est pas encore arrivée<nbsp>!
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006880_HYDAELYN:1"
msgid "Teach her a brighter melody. Show her...our journey is far from over."
msgstr ""

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q8
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_Q8_000_001_NONE_VOICE:1"
msgid "What will you say?"
msgstr ""

#. ja: 長い間ありがとう、ハイデリン
#. de: Ich danke dir, Hydaelyn. Für alles.
#. fr: Hydaelyn... Merci... pour tout.
#. speaker: A8
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A8_000_001_NONE_VOICE:1"
msgid "Thank you, Hydaelyn."
msgstr ""

#. ja: 人はもう大丈夫だ、ヴェーネス
#. de: Wir werden zurechtkommen, Venat. Das Leben hat eine Zukunft.
#. fr: L'avenir de l'humanité est entre de bonnes mains, Venat.
#. speaker: A8
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_A8_000_002_NONE_VOICE:1"
msgid "We will find our way, Venat."
msgstr ""

#. ja: ええ……ええ……！<br>あなたたちこそ、生まれてきてくれてありがとう。
#. de: Nicht doch. Aller Dank gilt euch. Dafür, dass ihr in diese Welt gekommen seid.
#. fr: Non, c'est moi...<nbsp>! Je vous remercie tous... d'être venus au monde.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006890_HYDAELYN:1"
msgid "It is I who should thank thee. For all thou hast done...and may yet accomplish."
msgstr ""

#. ja: 私は、きっともう、魂も残らないけれど……
#. de: Meine Seele schwindet, doch noch verbleibt Hoffnung in mir<nbsp>...
#. fr: L'heure est venue pour mon âme de s'éteindre...
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006900_HYDAELYN:1"
msgid "Long after I have gone, though not even my soul remaineth..."
msgstr ""

#. ja: 私の想いが、いつまでも、愛しき子らを護りますように……。
#. de: Auf dass meine Gebete auf ewig eine schützende Hand über euch halten mögen, meine geliebten Kinder<nbsp>...
#. fr: Puissent mes sentiments protéger mes enfants jusqu'à la fin des temps...
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006910_HYDAELYN:1"
msgid "My love will be with you forever, my dearest children."
msgstr ""

#. ja: っ…
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006920_HYDAELYN:1"
msgid "Report if displayed."
msgstr ""

#. ja: ええ……ええ……！<br>よく知っているわ、たくさん見せてもらったもの……！
#. de: Das werdet ihr. Daran habe ich nun wirklich keinerlei Zweifel mehr.
#. fr: Oh, je ne m'en fais pas, tu sais<nbsp>! Toi et tes amis m'en avez amplement convaincue.
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006930_HYDAELYN:1"
msgid "Of this, I have no doubt. For yours is a light brilliant beyond measure."
msgstr ""

#. ja: 私は、きっともう、魂も残らないけれど……
#. de: Meine Seele schwindet, doch noch verbleibt Hoffnung in mir<nbsp>...
#. fr: L'heure est venue pour mon âme de s'éteindre...
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006940_HYDAELYN:1"
msgid "Long after I have gone, though not even my soul remaineth..."
msgstr ""

#. ja: 私の想いが、いつまでも、愛しき子らを護りますように……。
#. de: Auf dass meine Gebete auf ewig eine schützende Hand über euch halten mögen, meine geliebten Kinder<nbsp>...
#. fr: Puissent mes sentiments protéger mes enfants jusqu'à la fin des temps...
#. speaker: HYDAELYN
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006950_HYDAELYN:1"
msgid "My love will be with you forever, my dearest children."
msgstr ""

#. ja: 見つけた――
#. de: Hab ich dich gefunden!
#. fr: Je t'ai trouvé<nbsp>!
#. speaker: HYTHLODAEUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006960_HYTHLODAEUS:1"
msgid "There you are..."
msgstr ""

#. ja: ――うん  久しぶりだね<br>とくに  キミにとってはさ
#. de: Ja, es ist wirklich lange her. Besonders für dich.
#. fr: Ça faisait longtemps, hein<nbsp>? Surtout pour toi.
#. speaker: HYTHLODAEUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006970_HYTHLODAEUS:1"
msgid "Some time indeed, yes... For you, at least."
msgstr ""

#. ja: いや  眠るつもりだったんだよ？<br>でも  微睡んで  溶け始めたときに――ふとね
#. de: Nein, nein<nbsp>... Ich wollte mich tatsächlich schlafen legen! Aber als ich eindöste und langsam alles zu schmelzen begann<nbsp>... Nun ja.
#. fr: Non, non, je voulais vraiment m'<i>endormir</i><nbsp>! Mais quand j'ai fermé les yeux, que tout a commencé à disparaître...
#. speaker: HYTHLODAEUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006980_HYTHLODAEUS:1"
msgid "Believe me, I'd meant to get some proper sleep, but here we are, drifting along instead."
msgstr ""

#. ja: キミだって  同じだろう？<br>だからまだ  こんなところからあちらを眺めてる
#. de: Dir geht es doch genauso, oder nicht? Deswegen verfolgst du selbst hier noch alles mit größter Aufmerksamkeit.
#. fr: Toi aussi, n'est-ce pas<nbsp>? C'est pour ça que tu restes ici, à observer ce qui se passe au loin.
#. speaker: HYTHLODAEUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_006990_HYTHLODAEUS:1"
msgid "Well, well. You too? And so we remain to watch and wonder..."
msgstr ""

#. ja: フフ  そうだね――
#. de: Haha, stimmt.
#. fr: Ha ha, en effet<nbsp>!
#. speaker: HYTHLODAEUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_007000_HYTHLODAEUS:1"
msgid "Yes, indeed..."
msgstr ""

#. ja: 新しく始めるにはまず 終わりに辿り着かなくちゃ
#. de: Denn ein jeder neuer Anfang gedeiht schließlich aus einem Ende.
#. fr: Avant d'ouvrir un nouveau chapitre, nous devons d'abord clore celui-ci.
#. speaker: HYTHLODAEUS
msgctxt "cut_scene/060/VoiceMan_06005:TEXT_VOICEMAN_06005_007010_HYTHLODAEUS:1"
msgid "To begin, we first must see the end."
msgstr ""
