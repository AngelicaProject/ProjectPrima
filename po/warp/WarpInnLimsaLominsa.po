msgctxt "warp/WarpInnLimsaLominsa:TEXT_WARPINNLIMSALOMINSA_MYTESYN_000_12:1"
msgid "Ye can come and go any time ye please. Our beds are the softest in the land, and I guarantee ye'll sleep like a babe at <if $gn4>her<else>his</if> mother's warm teat."
msgstr ""

#. ja: （★未使用／削除予定★）
#. de: （★未使用／削除予定★）
#. fr: （★未使用／削除予定★）
