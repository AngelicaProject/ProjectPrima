msgctxt "warp/WarpInnLimsaLominsa:TEXT_WARPINNLIMSALOMINSA_MYTESYN_000_10:1"
msgid "Greetin's, <if $gn4>lass<else>lad</if>. What can I do for ye this fine <if ($gn11 < 12)><if ($gn11 < 4)>evenin'<else>mornin'</if><else><if ($gn11 < 17)>day<else>evenin'</if></if>?"
msgstr ""

#. ja: 何をする？
#. de: Was möchtest du?
#. fr: Que voulez-vous faire<nbsp>?
msgctxt "warp/WarpInnLimsaLominsa:TEXT_WARPINNLIMSALOMINSA_Q2_000_1:1"
msgid "What would you like to do?"
msgstr ""

#. ja: 客室に移動する
#. de: Ein Gästezimmer beziehen.
#. fr: Aller dans ma chambre
msgctxt "warp/WarpInnLimsaLominsa:TEXT_WARPINNLIMSALOMINSA_A2_000_1:1"
msgid "Retire to an inn room."
msgstr ""

#. ja: （★未使用／削除予定★）
#. de: （★未使用／削除予定★）
#. fr: （★未使用／削除予定★）
