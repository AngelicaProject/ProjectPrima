msgctxt "warp/WarpInnLimsaLominsa:TEXT_WARPINNLIMSALOMINSA_A2_000_2:1"
msgid "Ask about <ui-color 500><ui-edge-color 501>resting</ui-edge-color></ui-color>."
msgstr ""

#. ja: 客室での禁止事項について聞く
#. de: Etwas darüber erfahren, was in den Zimmern verboten ist.
#. fr: En savoir plus sur les in<shy>ter<shy>dic<shy>tions
msgctxt "warp/WarpInnLimsaLominsa:TEXT_WARPINNLIMSALOMINSA_A2_000_3:1"
msgid "Ask about inn rules."
msgstr ""

#. ja: 宿屋「ミズンマスト」とは？
#. de: Etwas über das Gasthaus erfahren.
#. fr: Savoir quel genre d'endroit est L'Artimon
msgctxt "warp/WarpInnLimsaLominsa:TEXT_WARPINNLIMSALOMINSA_A2_000_4:1"
msgid "Ask about the Mizzenmast Inn."
msgstr ""

#. ja: キャンセル
#. de: Nichts.
#. fr: Rien en particulier
msgctxt "warp/WarpInnLimsaLominsa:TEXT_WARPINNLIMSALOMINSA_A2_000_5:1"
msgid "Nothing."
msgstr ""

#. ja: ゆっくり休めよ、がっはっは。
#. de: Erhol dich gut! Har har ...
#. fr: Dans ce cas, fais de beaux rêves. Bouahaha<nbsp>!
msgctxt "warp/WarpInnLimsaLominsa:TEXT_WARPINNLIMSALOMINSA_MYTESYN_000_11:1"
msgid "Have a nice rest! Gah hah hah!"
msgstr ""

#. ja: （★未使用／削除予定★）
#. de: （★未使用／削除予定★）
#. fr: （★未使用／削除予定★）
