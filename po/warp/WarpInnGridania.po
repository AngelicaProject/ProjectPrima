msgctxt "warp/WarpInnGridania:TEXT_WARPINNGRIDANIA_A2_000_2:1"
msgid "Ask about <ui-color 500><ui-edge-color 501>resting</ui-edge-color></ui-color>."
msgstr ""

#. ja: 客室での禁止事項について聞く
#. de: Etwas darüber erfahren, was in den Zimmern verboten ist.
#. fr: En savoir plus sur les in<shy>ter<shy>dic<shy>tions
msgctxt "warp/WarpInnGridania:TEXT_WARPINNGRIDANIA_A2_000_3:1"
msgid "Ask about inn rules."
msgstr ""

#. ja: 旅館「とまり木」とは？
#. de: Etwas über die Pension erfahren.
#. fr: En savoir plus sur “Le Perchoir”
msgctxt "warp/WarpInnGridania:TEXT_WARPINNGRIDANIA_A2_000_4:1"
msgid "Ask about the Roost."
msgstr ""

#. ja: キャンセル
#. de: Nichts.
#. fr: Annuler
msgctxt "warp/WarpInnGridania:TEXT_WARPINNGRIDANIA_A2_000_5:1"
msgid "Nothing."
msgstr ""

#. ja: ゆっくり、体を休めるといい。
#. de: Ich wünsche angenehm zu ruhen.
#. fr: Repose-toi bien.
msgctxt "warp/WarpInnGridania:TEXT_WARPINNGRIDANIA_ANTOINAUT_000_11:1"
msgid "We hope you have a pleasant stay."
msgstr ""

#. ja: （★未使用／削除予定★）
#. de: （★未使用／削除予定★）
#. fr: （★未使用／削除予定★）
msgctxt "warp/WarpInnGridania:TEXT_WARPINNGRIDANIA_ANTOINAUT_000_12:1"
msgid "We here at the Roost believe that you'll find your adventures much more rewarding if you face them well rested. Feel free to retire to one of our homey rooms whenever you find yourself in Gridania."
msgstr ""

#. ja: （★未使用／削除予定★）
#. de: （★未使用／削除予定★）
#. fr: （★未使用／削除予定★）
#. macro: <ui-color 500> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 500 (formatting: keep it as often as the source has it)
#. macro: <ui-edge-color 501> — text outline color from the UIColor sheet; </ui-edge-color> restores the previous color; color = 501 (formatting: keep it as often as the source has it)
