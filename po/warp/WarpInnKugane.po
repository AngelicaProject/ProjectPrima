msgctxt "warp/WarpInnKugane:TEXT_WARPINNKUGANE_USHITORA_000_21:1"
msgid "If you wish to stay with us this <if ($gn11 < 12)><if ($gn11 < 4)>evening<else>day</if><else><if ($gn11 < 17)>day<else>evening</if></if>, you need only ask, and I will show you to a room at once."
msgstr "Если захотите остановиться у нас <if ($gn11 < 12)><if ($gn11 < 4)>вечером<else>днём</if><else><if ($gn11 < 17)>днём<else>вечером</if></if>, просто скажите — и я сразу провожу вас в комнату."
