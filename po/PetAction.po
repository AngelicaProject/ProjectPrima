#. ja: 帰還
#. de: Lauf
#. fr: Renvoyer
#. column 1: Order pet to leave the battlefield.
msgctxt "PetAction:1:0:0"
msgid "Away"
msgstr "Отозвать"

#. ja: ペットを帰還させる。
#. de: Du schickst dein Familiar weg.
#. fr: Renvoie le familier.
#. column 0: Away
msgctxt "PetAction:1:0:1"
msgid "Order pet to leave the battlefield."
msgstr "Прикажите питомцу покинуть поле боя."

#. ja: 追従
#. de: Bei Fuß
#. fr: Suivre
#. column 1: Order pet to follow behind you.
msgctxt "PetAction:2:0:0"
msgid "Heel"
msgstr "Рядом"

#. ja: ペットを自身に追従させる。
#. de: Du befiehlst deinem Familiar, dir zu folgen.
#. fr: Ordonne au familier de vous suivre.
#. column 0: Heel
msgctxt "PetAction:2:0:1"
msgid "Order pet to follow behind you."
msgstr "Прикажите питомцу следовать за вами."

#. ja: 移動
#. de: Dorthin
#. fr: Se placer
#. column 1: Order pet to move to a specified location.
msgctxt "PetAction:3:0:0"
msgid "Place"
msgstr "Переместить"

#. ja: ペットを指定地点まで移動させる。
#. de: Du befiehlst deinem Familiar, an einen bestimmten Ort zu gehen.
#. fr: Ordonne au familier de se placer à l'endroit désigné.
#. column 0: Place
msgctxt "PetAction:3:0:1"
msgid "Order pet to move to a specified location."
msgstr "Прикажите питомцу переместиться в указанное место."

#. ja: 待機
#. de: Bleib
#. fr: Attendre
#. column 1: Order pet to remain where it is.
msgctxt "PetAction:4:0:0"
msgid "Stay"
msgstr "Оплот"

#. ja: ペットをその場で待機させる。
#. de: Du befiehlst deinem Familiar, hier zu warten.
#. fr: Ordonne au familier de rester où il est.
#. column 0: Stay
msgctxt "PetAction:4:0:1"
msgid "Order pet to remain where it is."
msgstr "Прикажите питомцу оставаться на месте."

#. ja: インターセプト
#. de: Schütz
#. fr: Défendre
#. column 1: Order pet to refrain from attacking until you attack or are attacked.
msgctxt "PetAction:5:0:0"
msgid "Guard"
msgstr "Защита"

#. ja: ペットに、自分が攻撃を行うか、自分が攻撃を受けるまで戦闘しないように命令する。
#. de: Du lässt dein Familiar angreifen, sobald du selbst einen Angriff startest oder angegriffen wirst.
#. fr: Ordonne au familier de n'attaquer que lorsque vous attaquez ou lorsque vous êtes attaqué<if $gn4>e</if>.
#. column 0: Guard
msgctxt "PetAction:5:0:1"
msgid "Order pet to refrain from attacking until you attack or are attacked."
msgstr "Прикажите питомцу не нападать, пока вы не атакуете или не подвергнетесь нападению."

#. ja: ピース
#. de: Aus
#. fr: Passif
#. column 1: Order pet to refrain from attacking until ordered to do so.
msgctxt "PetAction:6:0:0"
msgid "Steady"
msgstr "Спокойствие"

#. ja: ペットに、自分が指示を出すまで戦闘しないように命令する。
#. de: Du befiehlst deinem Familiar, nicht anzugreifen, bis du das Zeichen dazu gibst.
#. fr: Ordonne au familier de n'attaquer que lorsque vous en donnez l'ordre.
#. column 0: Steady
msgctxt "PetAction:6:0:1"
msgid "Order pet to refrain from attacking until ordered to do so."
msgstr "Прикажите питомцу не вступать в бой без приказа."

#. ja: フリーファイト
#. de: Fass
#. fr: Libre arbitre
#. column 1: Order pet to attack.
msgctxt "PetAction:7:0:0"
msgid "Sic"
msgstr "Фас!"

#. ja: ペットに攻撃させる。
#. de: Du lässt dein Familiar angreifen.
#. fr: Ordonne au familier d'attaquer librement.
#. column 0: Sic
msgctxt "PetAction:7:0:1"
msgid "Order pet to attack."
msgstr "Прикажите питомцу атаковать."

#. ja: セミオーダー
#. de: Gib Acht
#. fr: Obéir
#. column 1: Order pet to attack, but refrain from using certain actions until ordered to do so.
msgctxt "PetAction:8:0:0"
msgid "Obey"
msgstr "Слушаться"

#. ja: ペットに攻撃させる。ただし、一部のアクションは命令を受けるまで実行しない。
#. de: Du lässt dein Familiar angreifen, aber bei einigen Kommandos wartet es noch auf dein Zeichen.
#. fr: Ordonne au familier d'attaquer, mais il n'accomplit pas certaines actions sans votre ordre.
#. column 0: Obey
msgctxt "PetAction:8:0:1"
msgid "Order pet to attack, but refrain from using certain actions until ordered to do so."
msgstr "Прикажите питомцу атаковать, но использовать некоторые действия только по вашему приказу."

#. ja: ガスト
#. de: Böe
#. fr: Coup de vent
#. column 1: Deals wind damage with a potency of 90.
msgctxt "PetAction:9:0:0"
msgid "Gust"
msgstr "Порыв ветра"

#. ja: 対象に風属性魔法攻撃。　<ui-color 504><ui-edge-color 505>威力：</ui-edge-color></ui-color>90
#. de: Führt eine windbasierte magische Attacke aus.<br>Attacke-Wert: 90
#. fr: Effectue une attaque magique de vent sur la cible.<br><ui-color 506><ui-edge-color 507>Puissance<nbsp>:</ui-edge-color></ui-color> 90
#. column 0: Gust
msgctxt "PetAction:9:0:1"
msgid "Deals wind damage with a potency of 90."
msgstr "Наносит урон ветром. Сила: 90"

#. ja: ふきとばし
#. de: Rückstoß
#. fr: Éjection
#. column 1: Deals wind damage with a potency of 80.<br><ui-color 504><ui-edge-color 505>Additional Effect:</ui-edge-color></ui-color> 15-yalm knockback<br>When <ui-color 506><ui-edge-color 507>Obey</ui-edge-color></ui-color> is active, will only execute upon command.
msgctxt "PetAction:10:0:0"
msgid "Backdraft"
msgstr "Обратная тяга"

#. ja: 対象に風属性魔法攻撃。　<ui-color 504><ui-edge-color 505>威力：</ui-edge-color></ui-color>80<br><ui-color 504><ui-edge-color 505>追加効果：</ui-edge-color></ui-color>対象を15mノックバックする<br><ui-color 500><ui-edge-color 501>「セミオーダー」</ui-edge-color></ui-color>状態では命令を受けるまで実行しない。</ui-edge-color></ui-color>
#. de: Schleudert den Gegner mit einer windbasierten magischen Attacke um 15y zurück.<br>Attacke-Wert: 80<br>Bei der Haltung <ui-color 506><ui-edge-color 507>Gib Acht</ui-edge-color></ui-color> wird dieses Kommando nur auf ausdrücklichen Befehl ausgeführt.
#. fr: Effectue une attaque magique de vent sur la cible.<br><ui-color 506><ui-edge-color 507>Puissance<nbsp>:</ui-edge-color></ui-color> 80<br><ui-color 506><ui-edge-color 507>Effet additionnel<nbsp>:</ui-edge-color></ui-color> projette la cible 15 yalms en arrière<br>En mode <ui-color 500><ui-edge-color 501>Obéir</ui-edge-color></ui-color>, requiert l'ordre du maître.
#. column 0: Backdraft
#. macro: <br> — a line break (may be added or dropped)
#. macro: <ui-color 504> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 504 (formatting: keep it as often as the source has it)
