#. column 0: snurble fly
#. column 2: snurble flies
#. column 8: A freshwater fishing lure made from a snurble tuft.
msgctxt "Item:2618:0:9"
msgid "Snurble Fly"
msgstr "Снёрбль-мушка"

#. ja: ヘヴィメタルジグ
#. de: schwer[a] Eisenköder
#. fr: devon lesté
#. column 2: heavy steel jigs
#. column 8: The sheer weight of this steel lure allows for casting tremendous distances, such as from coastlines.
#. column 9: Heavy Steel Jig
msgctxt "Item:2619:0:0"
msgid "heavy steel jig"
msgstr "тяжёлый стальной пилькер"

#. de: schwer[a] Eisenköder
