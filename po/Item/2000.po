msgctxt "Item:2603:0:9"
msgid "Glowworm"
msgstr "Светящийся червь"

#. ja: ローリングストーン
#. de: Kieselwurm
#. fr: roule-boule
#. column 2: rolling stones
#. column 8: When threatened, this tiny desert crustacean will curl itself into a ball which, to the untrained eye, will appear no more than a simple pebble. Live bait for dunefishing.
#. column 9: Rolling Stone
msgctxt "Item:2604:0:0"
msgid "rolling stone"
msgstr "камешек-катушка"

#. de: Kieselwürmer
#. fr: roule-boule
#. column 0: rolling stone
