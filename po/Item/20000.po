msgctxt "Item:20034:0:9"
msgid "Tawny Wench Shark"
msgstr "Тигровая акула-куртизанка"

#. ja: ホワイトホース
#. de: Weißpferdchen
#. fr: chevalier servant
#. column 2: whitehorses
#. column 8: This queer horse-like wavekin swims upright, using two tiny fins near its head to slowly swim through the waters of extreme salinity it calls home.<br><br>[Suitable for printing on small canvases.]
#. column 9: Whitehorse
msgctxt "Item:20035:0:0"
msgid "whitehorse"
msgstr "белая лошадка"

#. de: Weißpferdchen
#. fr: chevaliers servants
