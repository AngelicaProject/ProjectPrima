msgctxt "Item:29766:0:9"
msgid "Merman's Mane"
msgstr "Грива морского мужика"

#. ja: フラッフィー
#. de: Fluffy
#. fr: requin-balais
#. column 2: sweepers
#. column 8: Its habit of moving its head from side to side while searching the seabed for food has earned it this unusual moniker.<br><br>[Suitable for printing on large canvases.]
#. column 9: Sweeper
msgctxt "Item:29767:0:0"
msgid "sweeper"
msgstr "подметальщик"

