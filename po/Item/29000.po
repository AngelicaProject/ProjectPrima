msgctxt "Item:29753:0:9"
msgid "Casket Oyster"
msgstr "Устричный гроб"

#. ja: フィッシュモンガー
#. de: Fischhändler
#. fr: poissonnière
#. column 2: fishmongers
#. column 8: Known for its habit of seeking out a variety of fish, though unlike its namesake, these are purely for its own consumption.<br><br>[Suitable for printing on large canvases.]
#. column 9: Fishmonger
msgctxt "Item:29754:0:0"
msgid "fishmonger"
msgstr "рыботорговец"

#. de: Fischhändler
#. fr: poissonnières
#. column 0: fishmonger
