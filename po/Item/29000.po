msgctxt "Item:29763:0:9"
msgid "Aetheric Seadragon"
msgstr "Эфирный морской дракон"

#. ja: コーラルシードラゴン
#. de: Korallenseedrache
#. fr: dragon de mer corallin
#. column 2: coral seadragons
#. column 8: Dedicates its life to looking─and behaving─as much like coral as possible.<br><br>[Suitable for printing on small canvases.]
#. column 9: Coral Seadragon
msgctxt "Item:29764:0:0"
msgid "coral seadragon"
msgstr "коралловый морской дракон"

#. de: Korallenseedrachen
#. fr: dragons de mer corallins
#. column 0: coral seadragon
