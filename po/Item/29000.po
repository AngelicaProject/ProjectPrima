msgid "Executioner"
msgstr "Палач"

#. ja: ワイルドアーチン
#. de: Riesenseeigel
#. fr: oursin féroce
#. column 2: wild urchins
#. column 8: A creamy center encased in horrendously sharp spines. Only those who acquire the knack of eating one without impaling themselves can acquire the decidedly acquired taste.<br><br>[Suitable for printing on small canvases.]
#. column 9: Wild Urchin
msgctxt "Item:29771:0:0"
msgid "wild urchin"
msgstr "свирепый морской ёж"

