msgctxt "Item:40576:0:9"
msgid "Bekko Rockhugger"
msgstr "Бекко-скалолаз"

#. ja: 黄菖蒲
#. de: Wasserschwertlilie
#. fr: iris jaune
#. column 2: yellow irises
#. column 8: Like its namesake flower, this fish has put many local ecosystems at risk.<br><br>[Suitable for printing on small canvases.]
#. column 9: Yellow Iris
msgctxt "Item:40577:0:0"
msgid "yellow iris"
msgstr "жёлтый ирис"

#. de: Wasserschwertlilien
