msgstr "Редька дайкон"

#. ja: シュガービート
#. de: Zuckerrübe
#. fr: betterave sucrière
#. column 2: sugar beets
#. column 8: These tubers can be several times sweeter than most fruit, and as such are commonly processed into sugar for sweetening cakes and other confections.
#. column 9: Sugar Beet
msgctxt "Item:19856:0:0"
msgid "sugar beet"
msgstr "сахарная свёкла"

#. de: Zuckerrüben
#. fr: betteraves sucrières
