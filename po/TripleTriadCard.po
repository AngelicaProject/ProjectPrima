#. fr: Alphinaud & Alisaie
#. column 2: 0
#. column 8: “Our paths may differ, but our destination is the same. In time, I daresay we will see eye to eye.”
msgctxt "TripleTriadCard:59:0:0"
msgid "Alphinaud & Alisaie"
msgstr "Альфино и Ализе"

#. ja: 0
#. de: NONE
