#. ja: 探索開始地点
#. de: Landungsstelle
#. fr: Point de départ
msgctxt "PartyContentTextData:2002:0:0"
msgid "Base Camp"
msgstr "Базовый лагерь"

#. ja: 目標地点
#. de: Zielort
#. fr: Destination
