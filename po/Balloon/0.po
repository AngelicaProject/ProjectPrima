# Balloon
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: いらっしゃいいらっしゃい
#. de: Kommt her, kommt alle!
#. fr: Approchez, mesdames et messieurs<nbsp>!
msgctxt "Balloon:2:0:1"
msgid "Come one, come all!"
msgstr "Налетайте, не зевайте!"

#. ja: やすいよ～
#. de: Wir haben die besten<br>Preise weit und breit!
#. fr: Que des bonnes affaires<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3:0:1"
msgid "We've the best<br>prices in the realm!"
msgstr "Лучшие<br>цены во всём краю!"

#. ja: Ｚｚｚ…
#. de: Zzz ...
#. fr: Zzz...
msgctxt "Balloon:4:0:1"
msgid "Zzz......"
msgstr "Хр-р-р..."

#. ja: 帝国の動向は？
#. de: Gibt es Neuigkeiten<br>aus dem Kaiserreich?
#. fr: Des nouvelles de l'Empire<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:5:0:1"
msgid "Any word<br>on the Empire?"
msgstr "Есть новости<br>из Империи?"

#. ja: 間もなく報告が…
#. de: Unsere Späher sollten<br>bald zurück sein.
#. fr: Nous attendons un rapport de nos unités sur place.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:6:0:1"
msgid "Our scouts should<br>be returning shortly."
msgstr "Разведчики скоро<br>должны вернуться."

#. ja: ああ、明媚なる田舎都市よ！
#. de: Eines Tages wird<br>all dies mir gehören!
#. fr: Ah<nbsp>! Quelle cité pittoresque et verdoyante<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7:0:1"
msgid "One day,<br>all this'll be mine!"
msgstr "Когда-нибудь<br>всё это будет моим!"

#. ja: 愛想のねぇ都市だなぁ
#. de: Dieser Wald ...<br>Er beobachtet uns!
#. fr: Cette ville n'est pas très accueillante...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:8:0:1"
msgid "The wood...<br>It's watching, you know!"
msgstr "Лес...<br>Он ведь следит за нами!"

#. ja: …で、どうだ？
#. de: Nun spann mich nicht<br>so auf die Folter.
#. fr: Alors<nbsp>? Ne me fais pas languir plus longtemps.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:9:0:1"
msgid "You look odd. Did you do<br>something with your hair?"
msgstr "Что-то ты странно выглядишь. С волосами что-то сделал?"

#. ja: 悪くはねぇな
#. de: Dieser hier. Wir werden<br>mit diesem beginnen.
#. fr: Celui-là. Commençons avec celui-là.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:10:0:1"
msgid "A little lanolin<br>goes a long way."
msgstr "Немного ланолина —<br>и шерсть как новенькая."

#. ja: どう、どう…
#. de: Du kannst dich nun ausruhen.
#. fr: Gentil, lààà...
msgctxt "Balloon:11:0:1"
msgid "You can rest now."
msgstr "Теперь можешь отдохнуть."

#. ja: クェェ～
#. de: Kweh! Kweeeh!
#. fr: Kwéé...
msgctxt "Balloon:12:0:1"
msgid "Kweh! Kweeeh!"
msgstr "Ку-э! Ку-э-э!"

#. ja: 伝えておこう
#. de: Gut gemacht.<br>Erstatte umgehend der<br>Waldschanze Bericht.
#. fr: Je vais faire un rapport.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:13:0:1"
msgid "Well done. Report to<br>the Barracks at once."
msgstr "Молодец. Немедленно доложи<br>в казармы."

#. ja: 頼んだぞ
#. de: Das müssen die<br>Ixal gewesen sein.
#. fr: On dirait bien.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:14:0:1"
msgid "It had to have<br>been the Ixal."
msgstr "Это наверняка иксалы."

#. ja: イクサル族の仕業のようです
#. de: Die Markierungen<br>stimmen überein.
#. fr: C'est un coup des Ixali, apparemment.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:15:0:1"
msgid "The markings<br>were consistent."
msgstr "Следы совпадают."

#. ja: ご案内いたしましょう
#. de: Erlaubt mir, Euch zu<br>helfen, guter Herr.
#. fr: Laissez-moi vous montrer, Monsieur.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:16:0:1"
msgid "Allow me to assist<br>you, good sir."
msgstr "Позвольте помочь,<br>сударь."

#. ja: 次の便は…？
#. de: Ich muss bei Sonnen-<br>untergang zurück in<br>Limsa sein.
#. fr: Quand est le prochain départ<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:17:0:1"
msgid "I need to be back in<br>Limsa by sundown!"
msgstr "Мне надо вернуться<br>в Лимсу к закату!"

#. ja: おっそいなぁ、アイツ…
#. de: Wo bei den Sieben Höllen<br>ist diese Frau?
#. fr: Elle en met, du temps...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:18:0:1"
msgid "Where in the seven<br>hells is that woman?"
msgstr "Где, во имя семи<br>преисподних, эта женщина?"

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "Balloon:19:0:1"
msgid "  ..."
msgstr "  ..."

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "Balloon:20:0:1"
msgid "  ..."
msgstr "  ..."

#. ja: …………Ｚｚｚ…
#. de: Zzz ...
#. fr: ... Zzz...
msgctxt "Balloon:21:0:1"
msgid "Zzz..."
msgstr "Хр-р-р..."

#. ja: ふん、よそ者に何ができる
#. de: Die Fremden können uns gestohlen bleiben. Die machen doch nur Ärger ...
#. fr: Les étrangers ne sont bons à rien.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:22:0:1"
msgid "Just what we need.<br>Another outsider..."
msgstr "Вот уж чего нам не хватало.<br>Ещё один чужак..."

#. ja: よし、イクサル族の姿なし…！
#. de: Wo in Oschons Namen<br>sind diese verdammten Ixal?
#. fr: Aucun Ixal en vue<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:23:0:1"
msgid "Where in Oschon's name<br>are those damned Ixal?"
msgstr "Где, во имя Ошона,<br>эти проклятые иксалы?"

#. ja: 素晴らしい毛並みだ…
#. de: Das sind ein paar<br>wirklich feine Vögel.
#. fr: Quel plumage magnifique<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:24:0:1"
msgid "Those are some<br>right fine birds."
msgstr "Вот это птицы,<br>что надо!"

#. ja: この道を上れば商店街よ
#. de: Die Marktstände sind<br>hinter dieser Passage.
#. fr: Le quartier commerçant se trouve par là.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:25:0:1"
msgid "The markets are<br>beyond this passage."
msgstr "Рынок за<br>этим проходом."

#. ja: …………
#. de: Kweh! Kweeeh!
#. fr: ...
msgctxt "Balloon:26:0:1"
msgid "Kwaaark! Kwaaaaaark!"
msgstr "Ква-а-арк! Ква-а-а-арк!"

#. ja: にゃ…にゃー？
#. de: Du schaffst es, Mädchen!<br>Jetzt drrrücken!
#. fr: Allez... fais pas la tête<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:27:0:1"
msgid "You can do it, girl!<br>Now push!"
msgstr "Давай, милая!<br>Тужься!"

#. ja: 精霊の力を借りてはどうだ？
#. de: Und wenn wir die<br>Gebieter anflehen würden?
#. fr: Et si on faisait appel aux esprits<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:28:0:1"
msgid "What if we were to<br>entreat the spirits?"
msgstr "А что, если<br>воззвать к духам?"

#. ja: 我らこそが森を守るのだ
#. de: Lässt du dir etwa noch<br>von deiner Mutter den<br>Hintern abwischen?
#. fr: C'est à nous de protéger la forêt<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:29:0:1"
msgid "Would you have your<br>mother wipe your arse?"
msgstr "Может, тебе ещё мама<br>попу подтирать должна?"

#. ja: 水車が回るよ～くるくるり～♪
#. de: Ihr wollt sicher wissen,<br>wie ich hier<br>rrraufgekommen bin,<br>nicht wahr?
#. fr: Il tourne, il tourne, le joli moulin...♪
#. macro: <if $gn4>Want to know how<else>Watch your eyes</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
#. macro: <if $gn4>I got up here, do you?<else>now, milord.</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "Balloon:30:0:1"
msgid "<if $gn4>Want to know how<else>Watch your eyes</if><br><if $gn4>I got up here, do you?<else>now, milord.</if>"
msgstr "<if $gn4>Хочешь узнать,<br>как я сюда забралась?<else>Гляди в оба,<br>милорд.</if>"

#. ja: 休める時に、休まねばな…
#. de: Stillstand reinigt den<br>Geist von Unrat.
#. fr: Il faut se reposer quand on en a l'occasion...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:31:0:1"
msgid "Respite cleanses the<br>mind of impurity."
msgstr "Покой очищает<br>разум от скверны."

#. ja: キュゥウ…
#. de: Kweh! Kweh!
#. fr: K-kwé... kwé...
msgctxt "Balloon:32:0:1"
msgid "Kweh! Kweh!"
msgstr "Ку-э! Ку-э!"

#. ja: ん？どうした？
#. de: Was ist los, Mädchen?
#. fr: Eh bien<nbsp>? Qu'est-ce que tu as<nbsp>?
msgctxt "Balloon:33:0:1"
msgid "What is it, girl?"
msgstr "Что такое, девочка?"

#. ja: いーち、にーぃ…
#. de: Eins, zwei ...
#. fr: Voyons voir... Un, deux, trois...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:34:0:1"
msgid "Ginger cookies are<br><i>my</i> sustenance!"
msgstr "Имбирные пряники —<br><i>всё</i> для меня!"

#. ja: 心に染み入る…！
#. de: Eure Worte sind mein<br>Leben, Meister!
#. fr: Ces mots resteront gravés dans mon cœur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:35:0:1"
msgid "Your words are my<br>sustenance, Master!"
msgstr "Ваши слова — моя<br>пища, наставник!"

#. ja: Ｚｚｚ…
#. de: Zzz ...
#. fr: Zzz...
msgctxt "Balloon:36:0:1"
msgid "Zzz......"
msgstr "Хр-р-р..."

#. ja: 手がギサール臭い…
#. de: Mein ganzer Körper stinkt<br>nach Gizar-Blättern!
#. fr: Beuh, mes mains sentent les légumes de Gysahl...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:37:0:1"
msgid "My whole body reeks<br>of gysahl greens!"
msgstr "От меня всякой<br>зеленью Гизаль пахнет!"

#. ja: このところずっとねぇ
#. de: Aber der Wald war einst<br>voll von ihnen!
#. fr: Il n'y en a jamais, en ce moment...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:38:0:1"
msgid "But the forest was<br>once full with them!"
msgstr "А ведь когда-то<br>лес ими кишел!"

#. ja: ウォルナットは売り切れだよ
#. de: Tut mir leid, meine Dame.<br>Wir haben keine Walnüsse<br>mehr.
#. fr: On n'a plus de noix, désolé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:39:0:1"
msgid "Sorry, ma'am. We're<br>fresh out of walnuts."
msgstr "Простите, сударыня.<br>Грецкие орехи кончились."

#. ja: ふんっ
#. de: Bei den Göttern,<br>mein Rücken!
#. fr: Pfouh...
msgctxt "Balloon:40:0:1"
msgid "Gods, me back!"
msgstr "Ох, спина..."

#. ja: きのこいっぱいにゃ！
#. de: Mützen rrrot,<br>so gut wie tot.<br>Mützen weiß,<br>schmecken heiß!
#. fr: Mangez-moi, mangez-moi...♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:41:0:1"
msgid "Caps of red,<br>good as dead.<br>Caps of white,<br>stew tonight!"
msgstr "Красная шляпка —<br>прощайся с жизнью.<br>Белая шляпка —<br>в суп пойдёт!"

#. ja: き、木屑が…鼻に…
#. de: Im Umgang mit den<br>Sägen kann man gar nicht<br>vorsichtig genug sein.
#. fr: Ah, j'ai de la sciure dans le nez<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:42:0:1"
msgid "One cannot be too<br>careful when working<br>the saws."
msgstr "С пилами осторожности<br>много не бывает."

#. ja: トントントン…っと
#. de: Ein bisschen hier ab,<br>ein bisschen dort ab ...
#. fr: Et je tape, tape, tape...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:43:0:1"
msgid "A little off here,<br>and a little off here..."
msgstr "Тут чуток снять,<br>и тут чуток..."

#. ja: げっ、オトナだ…
#. de: Du hast hier hinten<br>nichts verloren, du!
#. fr: Bah, <if $gn4>une grande<else>un grand</if>... Laisse-nous un peu<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:44:0:1"
msgid "You're not supposed<br>to be back here, you!"
msgstr "Тебе тут делать<br>нечего!"

#. ja: ふん～ふふん～♪
#. de: Das wird eine gute<br>Ernte dieses Jahr!
#. fr: ♪ La la la, la la...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:45:0:1"
msgid "A fine crop we'll<br>have this season!"
msgstr "Урожай в этом году<br>будет что надо!"

#. ja: 槍をぶんぶん、きこくたい～
#. de: Ich schaffe es, ich<br>sag's dir! Pass nur auf!
#. fr: Je peux le faire, je te dis<nbsp>! Regarde un peu<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:46:0:1"
msgid "I can make it,<br>I tell you! Just watch!"
msgstr "Я справлюсь,<br>вот увидишь!"

#. ja: あ、あわわわ…
#. de: Du wirst wieder reinfallen.
#. fr: Tu vas encore tomber...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:47:0:1"
msgid "You're going to fall<br>in again."
msgstr "Ты опять<br>свалишься."

#. ja: 精霊の導きを信じるのです
#. de: Folgt immer den Gebietern, meine Kinder.
#. fr: Il faut faire confiance aux esprits.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:48:0:1"
msgid "Always heed the<br>spirits, my children."
msgstr "Всегда следуйте<br>воле духов, дети мои."

#. ja: いったいどうしたら…
#. de: Aber wie soll ich ihnen<br>folgen, wenn ich sie<br>nicht hören kann?
#. fr: Que pouvons-nous faire<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:49:0:1"
msgid "But I can't heed<br>what I can't hear!"
msgstr "Да как следовать тому,<br>чего не слышишь?"

#. ja: ……♪
#. de: ♪♪♪
#. fr: ♪♪♪
msgctxt "Balloon:50:0:1"
msgid "♪♪♪"
msgstr "♪♪♪"

#. ja: ふぅ…
#. de: Was gäbe ich nur für einen<br>guten Schluck Honigwein.
#. fr: Fouh... Besoin de souffler...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:51:0:1"
msgid "What I wouldn't give<br>for a cup of mead."
msgstr "Чего бы я только<br>не отдал за кружку медовухи."

#. ja: 育ってきたなぁ
#. de: Möge die Matrone diese<br>fleißigen Bienen segnen.
#. fr: Elles ont bien grandi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:52:0:1"
msgid "May the Matron bless<br>these busy bees."
msgstr "Да благословит Мать<br>этих неутомимых пчёл."

#. ja: もうちょっと…
#. de: Nur noch ein paar<br>Sonnenrunden jetzt.
#. fr: Encore un peu, et elles seront prêtes.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:53:0:1"
msgid "Only a few more<br>turns of the sun now."
msgstr "Ещё немного,<br>и солнце зайдёт."

#. ja: 森は危ないのよ？
#. de: Ich hab dir doch gesagt,<br>bleib in der Nähe!
#. fr: Je t'ai bien dit que la forêt était dangereuse<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:54:0:1"
msgid "I told you, no<br>wandering off!"
msgstr "Я же велела<br>не отходить!"

#. ja: だって…
#. de: Aber Mama!
#. fr: Mais, euh<nbsp>!
msgctxt "Balloon:55:0:1"
msgid "But, Mother!"
msgstr "Но, мама!"

#. ja: はいはい、見てってー！
#. de: Kommt schon, kommt alle!
#. fr: Admirez nos produits, mesdames et messieurs<nbsp>!
msgctxt "Balloon:56:0:1"
msgid "Come one, come all!"
msgstr "Подходите, налетайте!"

#. ja: へーい！らっしゃい！
#. de: Wir haben die besten<br>Preise weit und breit!
#. fr: Vous ne trouverez pas moins cher ailleurs<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:57:0:1"
msgid "We've the best<br>prices in the realm!"
msgstr "Лучшие<br>цены во всём краю!"

#. ja: 俺たちもやり直そう…！
#. de: Wir dürfen uns davon<br>nicht beeindrucken lassen.
#. fr: On devrait se donner une autre chance, toi et moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:58:0:1"
msgid "We mustn't let this<br>come between us!"
msgstr "Нельзя же позволить,<br>чтобы это нас рассорило!"

#. ja: そうね…
#. de: Ich nehme an, du hast<br>Recht.
#. fr: Peut-être bien, oui...
msgctxt "Balloon:59:0:1"
msgid "I suppose..."
msgstr "Пожалуй..."

#. ja: …ようこそ、旅人
#. de: Alle Reisenden sind hier<br>willkommen. Sogar du.
#. fr: Sois <if $gn4>la<else>le</if> bienvenu<if $gn4>e</if>, l'ami<if $gn4>e</if>.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:60:0:1"
msgid "All travelers are<br>welcome here. Even you."
msgstr "Все путники здесь<br>добро пожаловать. Даже ты."

#. ja: キュゥゥ…
#. de: Kweh ...
#. fr: Kwé kwé...
msgctxt "Balloon:61:0:1"
msgid "Kweh..."
msgstr "Ку-э..."

#. ja: も、もうしねぇよ…
#. de: Verzeiht, mein Herr!<br>Es wird nicht wieder<br>vorkommen.
#. fr: Pardon, je ne recommencerai plus...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:62:0:1"
msgid "Apologies, milord!<br>It won't happen again."
msgstr "Простите, милорд!<br>Больше не повторится."

#. ja: いいか、次は無いぞ
#. de: Das will ich doch hoffen!
#. fr: C'est la dernière fois<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:63:0:1"
msgid "You'd best believe<br>it won't."
msgstr "Смотри, чтоб и правда<br>не повторилось."

#. ja: ったく、シェーダーは…
#. de: Einfach unglaublich!
#. fr: Pfff, ces Crépusculaires...
msgctxt "Balloon:64:0:1"
msgid "Damnable Duskwights!"
msgstr "Проклятые сумеречники!"

#. ja: …お静かに
#. de: Ruhe! Ihr stört<br>die Zeremonie.
#. fr: Pas de bruit, je vous prie.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:65:0:1"
msgid "Silence! You will<br>disturb the rites."
msgstr "Тише! Вы помешаете<br>обряду."

#. ja: ホラ、しゃんとしな！
#. de: Aufstehen!<br>Wir sind noch nicht ferrrtig!
#. fr: Debout, on n'a pas fini<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:66:0:1"
msgid "On your feet!<br>We're not through yet!"
msgstr "На ноги!<br>Мы ещё не закончили!"

#. ja: ひぃ…はぁ…
#. de: Aber meine Beine ...<br>Sie sind ganz wabbelig!
#. fr: Mais j'ai les pieds en compote...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:67:0:1"
msgid "But my legs...<br>They're like jelly!"
msgstr "Но ноги...<br>Подкашиваются!"

#. ja: はぁぁあああっ！
#. de: Gnarr! Ha!
#. fr: Oui, Chef<nbsp>!
msgctxt "Balloon:68:0:1"
msgid "Die, foul Ixal!"
msgstr "Сгинь, мерзкий иксал!"

#. ja: 脇を締め…顎をひいて…
#. de: Vielleicht nimmt er<br>es zu ernst ...
#. fr: Restez bien droits, gardez le rythme...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:69:0:1"
msgid "Disobey me again, and it<br>will be another thousand!"
msgstr "Ещё раз ослушаешься —<br>прибавлю тысячу!"

#. ja: 腰が高い！
#. de: Knie gestreckt!<br>Rücken gerade!
#. fr: Moins raide sur tes jambes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:70:0:1"
msgid "Bend your knees!<br>Straighten your back!"
msgstr "Согни колени!<br>Выпрями спину!"

#. ja: はいっ！
#. de: Jawohl, Sir!
#. fr: Yah<nbsp>!
msgctxt "Balloon:71:0:1"
msgid "Hyah!"
msgstr "Так точно!"

#. ja: …せいっ！
#. de: Stirb, garstiger Ixal!
#. fr: M... Mes bras...
msgctxt "Balloon:72:0:1"
msgid "Yes, sir!"
msgstr "Есть, сэр!"

#. ja: うぅ…
#. de: Arrrrgh! Ooooh!
#. fr: Ouh...
msgctxt "Balloon:73:0:1"
msgid "Nnnghaaa! Grrraaah!"
msgstr "Н-н-нгха-а! Гр-р-ра-а!"

#. ja: 大丈夫よ
#. de: Wie lange denn noch?<br>Mir reicht's so langsam.
#. fr: Tout ira bien.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:74:0:1"
msgid "How much longer?<br>I grow weary of this."
msgstr "Сколько ещё?<br>Я уже устала."

#. ja: …………
#. de: Verschwindet, ihr<br>widerlichen Geister!
#. fr: ...
msgctxt "Balloon:75:0:1"
msgid "Foul spirits, begone!"
msgstr "Пошли прочь, мерзкие духи!"

#. ja: 怪我はないみたいだけど…
#. de: Nun, es scheint ihr<br>gut zu gehen.
#. fr: Il n'a pas l'air blessé...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:76:0:1"
msgid "Well, I see nothing<br>wrong with her."
msgstr "Ну, вроде с ней<br>всё в порядке."

#. ja: ふぅむ…
#. de: Sie hat die Seuche,<br>ich sag's dir!
#. fr: Hmm...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:77:0:1"
msgid "She's got the blight,<br>I tell ye!"
msgstr "Да у неё же хворь, говорю тебе!"

#. ja: お塩、お塩…
#. de: Ja, ich glaube, wir<br>brauchen mehr Salz.
#. fr: Une pincée de sel...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:78:0:1"
msgid "Yes, I believe we'll<br>be needing more salt."
msgstr "Да, пожалуй, соли<br>нам понадобится побольше."

#. ja: 軽さを重視すべきか…？
#. de: Schneiden oder stechen?<br>Ich kann mich nicht<br>entscheiden!
#. fr: La légèreté, ou la puissance...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:79:0:1"
msgid "To slice or to pierce?<br>I cannot decide!"
msgstr "Резать или колоть?<br>Не могу решить!"

#. ja: ええと、つまり…
#. de: Hört ihr beiden<br>überhaupt zu?
#. fr: Comment vous expliquer, euh...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:80:0:1"
msgid "Are you two<br>even listening?"
msgstr "Вы двое<br>вообще слушаете?"

#. ja: うう…
#. de: ...
#. fr: ...
msgctxt "Balloon:81:0:1"
msgid "\\<groan>"
msgstr "<i>У-у-у...</i>"

#. ja: …………？
#. de: ...?
#. fr: ...<nbsp>?
msgctxt "Balloon:82:0:1"
msgid "  ...?"
msgstr "  ...?"

#. ja: す、すまない…
#. de: Dieser hier hütet<br>die Flammen.
#. fr: J-je suis désolé...
msgctxt "Balloon:83:0:1"
msgid "My apologies..."
msgstr "Простите..."

#. ja: 励ましてくれてるのか？
#. de: ♪ Das süße Lächeln der Sonne, die sanfte Brise der See ♪
#. fr: Tu m'encourages<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:84:0:1"
msgid "Sun's sweet smile<br>and wind's cool breath,<br>both of these<br>I send thee...♪"
msgstr "Солнца ласковый свет,<br>ветра морского дыханье —<br>вам я шлю...♪"

#. ja: ……♪
#. de: ♪♪♪
#. fr: ♪♪♪
msgctxt "Balloon:85:0:1"
msgid "♪♪♪"
msgstr "♪♪♪"

#. ja: 次は何を植えようか…
#. de: Hm, was sollte ich als<br>Nächstes pflanzen ...?
#. fr: Qu'est-ce que je vais planter maintenant<nbsp>?<nbsp>...
msgctxt "Balloon:86:0:1"
msgid "What to plant next..."
msgstr "Что бы посадить дальше..."

#. ja: 肥料を変えてみたのよ
#. de: Dieses Jahr habe ich<br>die Formel geändert!
#. fr: J'ai changé de fertilisant cette saison<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:87:0:1"
msgid "This season, I<br>switched formulae!"
msgstr "В этом сезоне я<br>сменила удобрение!"

#. ja: 茎がしっかりしてきたな
#. de: Ich wusste doch, dass<br>die Blätter grüner aussehen!
#. fr: Je me disais bien que les tiges ont l'air plus robustes.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:88:0:1"
msgid "I knew the leaves<br>looked greener!"
msgstr "Я же знал, листья<br>стали зеленее!"

#. ja: 道理で！
#. de: Beta funktioniert viel<br>besser als Alpha!
#. fr: Je comprends mieux maintenant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:89:0:1"
msgid "Beta works far<br>better than alpha!"
msgstr "Бета куда<br>лучше альфы!"

#. ja: しっかり育てよ～
#. de: Der Vorarbeiter schaut<br>noch immer her?<br>Verdammt ...
#. fr: Poussez, poussez, mes belles<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:90:0:1"
msgid "The foreman still<br>watching? Damn..."
msgstr "Бригадир всё ещё<br>смотрит? Вот чёрт..."

#. ja: おーい、交代だよぉ
#. de: Ich glaube, du hast dich<br>für heute genug ausgeruht.
#. fr: Hé<nbsp>! C'est ton tour, là<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:91:0:1"
msgid "I think you've had<br>enough rest today."
msgstr "Думаю, на сегодня<br>ты уже достаточно отдохнул."

#. ja: あと10分休ませてくれ…
#. de: Nur noch ein paar<br>Minuten, ich schwöre!
#. fr: Je me repose encore dix minutes, et je reprends...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:92:0:1"
msgid "Just another<br>half bell, I swear!"
msgstr "Ещё полколокола,<br>честное слово!"

#. ja: ダメですよ！
#. de: Was denkst du denn!?
#. fr: Je ne te félicite pas<nbsp>!
msgctxt "Balloon:93:0:1"
msgid "What do you think!?"
msgstr "Ты что творишь?!"

#. ja: つ、つい…
#. de: Warum hast du mich<br>gefesselt?
#. fr: Faites un petit geste<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:94:0:1"
msgid "What did you go<br>and cuff me for?"
msgstr "За что ты меня<br>в наручники заковал?"

#. ja: 未使用：会話091
#. de: 91
#. fr: 未使用：会話091
msgctxt "Balloon:95:0:1"
msgid "91"
msgstr "91"

#. ja: 御言葉は絶対でございます
#. de: Es ist der Wille des Waldes.
#. fr: La volonté de la forêt est absolue.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:96:0:1"
msgid "Such is the will<br>of the forest."
msgstr "Такова воля<br>леса."

#. ja: ほ、本当なの？
#. de: Aber das ist nicht richtig!
#. fr: C-c'est vrai<nbsp>!?
msgctxt "Balloon:97:0:1"
msgid "But that's not right!"
msgstr "Но это же неправильно!"

#. ja: 参ったな…
#. de: Das arme Mädchen hat<br>erst zwölf Sommer gesehen!
#. fr: Oh, non...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:98:0:1"
msgid "The girl's only seen<br>twelve summers!"
msgstr "Девочке всего<br>двенадцать лет!"

#. ja: なんてこと…！
#. de: Ich flehe dich an ...<br>Du musst etwas tun ...
#. fr: Qu'allons-nous faire<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:99:0:1"
msgid "Please... You must<br>do something..."
msgstr "Пожалуйста... Вы должны<br>что-нибудь сделать..."

#. ja: お取り次ぎしましょう
#. de: Der Wald wacht über<br>uns alle.
#. fr: La Déesse entendra votre prière.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:100:0:1"
msgid "The forest watches<br>over us all."
msgstr "Лес оберегает<br>нас всех."

#. ja: 行商の安全祈願を…
#. de: Ob die Gebieter wohl mein<br>Geschäft segnen würden?
#. fr: Je veux prier pour mon commerce...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:101:0:1"
msgid "Would the spirits<br>bless me business?"
msgstr "А благословят ли духи<br>моё дело?"

#. ja: 早く行きましょうよ
#. de: Wir müssen uns beeilen!
#. fr: Nous devons reprendre notre route<nbsp>!
msgctxt "Balloon:102:0:1"
msgid "We must make haste!"
msgstr "Надо поторопиться!"

#. ja: そう、焦るな
#. de: Ich gehe nirgendwo hin,<br>ehe ich etwas zu Trinken<br>bekommen habe.
#. fr: Je vais nulle part avant d'avoir bu un coup<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:103:0:1"
msgid "I'm going nowhere<br>until I've had a drink."
msgstr "Я никуда не пойду,<br>пока не выпью."

#. ja: やっとここまで来たな
#. de: Aber wir sind gerade<br>erst angekommen!
#. fr: Mais on vient juste d'arriver<nbsp>!
msgctxt "Balloon:104:0:1"
msgid "But we just arrived!"
msgstr "Но мы же только приехали!"

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "Balloon:105:0:1"
msgid "  ..."
msgstr "  ..."

#. ja: 精霊様…道士様…！
#. de: Wir haben nichts getan,<br>womit wir dieses Schicksal<br>verdient hätten!
#. fr: Ô esprits<nbsp>! Ô druides<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:106:0:1"
msgid "The beasts grow<br>bolder by the day!"
msgstr "Зверьё с каждым днём<br>наглеет всё больше!"

#. ja: 頭痛がひどくて…
#. de: Was sagen die Gebieter<br>zu der Ernte?
#. fr: Vous savez, j'ai des maux de tête in<shy>sup<shy>por<shy>ta<shy>bles...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:107:0:1"
msgid "What say the spirits<br>of the harvest?"
msgstr "Что говорят духи<br>об урожае?"

#. ja: どうかお守りください…
#. de: Warum lässt Gridania<br>uns im Stich?
#. fr: Protégez-nous, je vous en prie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:108:0:1"
msgid "Why has Gridania<br>forsaken us?"
msgstr "За что Гридания<br>нас покинула?"

#. ja: すぐ良くなりますよ
#. de: Mögen deine Wunden heilen.
#. fr: Vous allez guérir vite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:109:0:1"
msgid "May your wounds<br>be healed."
msgstr "Пусть раны твои<br>заживут."

#. ja: ありがたや…ありがたや…
#. de: Vielen Dank, meine Dame!
#. fr: Merci... merci<nbsp>!
msgctxt "Balloon:110:0:1"
msgid "Thank ye, milady!"
msgstr "Благодарствую, сударыня!"

#. ja: 残念だわぁ。
#. de: Das ist ja furchtbar!
#. fr: Ce n'est pas de chance.
msgctxt "Balloon:111:0:1"
msgid "Why, that's terrible!"
msgstr "Вот беда-то!"

#. ja: 今年は不作で…
#. de: Coeurl sind hier<br>eingedrungen und haben<br>all unsere Küken gefressen!
#. fr: J'ai fait une mauvaise récolte cette saison...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:112:0:1"
msgid "Coeurls came and<br>ate all our chicks!"
msgstr "Куэрлы налетели<br>и всех цыплят пожрали!"

#. ja: 小麦に…ライ麦に…
#. de: Zehn Ponzen Mehl,<br>vier Drachenschoten ...
#. fr: De la farine, du seigle...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:113:0:1"
msgid "Ten onzes of flour,<br>four dragon peppers..."
msgstr "Десять унций муки,<br>четыре перца дракона..."

#. ja: たまらんなぁ
#. de: Genau wie deine Augen,<br>meine Liebste.
#. fr: Il n'y a rien de mieux au monde.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:114:0:1"
msgid "As are your<br>eyes, my love."
msgstr "Как и твои<br>глаза, милая."

#. ja: いい香りねぇ
#. de: Dieser Honigwein hier<br>ist wahrlich göttlich.
#. fr: Quel parfum délicieux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:115:0:1"
msgid "The mead here<br>is simply divine."
msgstr "А мёдовый эль здесь<br>просто божественный."

#. ja: 早いものねぇ
#. de: Wir können trotzdem<br>Freunde bleiben, oder?
#. fr: Ça passe si vite...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:116:0:1"
msgid "We can still be<br>friends, can't we?"
msgstr "Мы ведь можем<br>остаться друзьями?"

#. ja: あの霊災から5年とはなぁ
#. de: Ähm<nbsp>... Denke schon, ja<nbsp>...
#. fr: Déjà cinq ans depuis la catastrophe...
msgctxt "Balloon:117:0:1"
msgid "I...er...suppose...so..."
msgstr "Я... э-э... полагаю... да..."

#. ja: はあぁぁぁ…
#. de: \<gähn>
#. fr: (bâille)
msgctxt "Balloon:118:0:1"
msgid "\\<yawn>"
msgstr "<i>Ха-а-а...</i>"

#. ja: よそ者は好かん
#. de: Ich sage, lasst uns alle<br>Fremden verbannen!
#. fr: Moi, j'aime pas les étrangers.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:119:0:1"
msgid "I say banish each<br>and every outsider!"
msgstr "Я бы всех чужаков<br>прогнал отсюда!"

#. ja: カヌ・エ・センナ様のご意向だぞ
#. de: Die Saatseher sagen, wir<br>müssen sie akzeptieren.
#. fr: On doit s'ouvrir, c'est la volonté de Kan-E-Senna<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:120:0:1"
msgid "The Seedseers say<br>we must accept them."
msgstr "Провидцы велели<br>принять их."

#. ja: …………
#. de: Lass mich allein ...
#. fr: ...
msgctxt "Balloon:121:0:1"
msgid "Leave me be..."
msgstr "Оставь меня..."

#. ja: …ふぅ
#. de: Darf sich eine Dame nicht<br>mal einen Moment lang<br>ausruhen?
#. fr: Fiouh...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:122:0:1"
msgid "Ain't a lady allowed<br>a moment's rest?"
msgstr "Даме что, нельзя<br>хоть минутку отдохнуть?"

#. ja: 決まりは決まりだ
#. de: Alles zu seiner Zeit,<br>meine Freunde.
#. fr: Les règles sont les règles.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:123:0:1"
msgid "All in good time,<br>my friends."
msgstr "Всему своё время,<br>друзья мои."

#. ja: そこを何とか…
#. de: Ihr habt Eure Gil.<br>Also wo ist es?
#. fr: Faites un petit geste<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:124:0:1"
msgid "We met our end of<br>the bargain!"
msgstr "Мы свою часть<br>сделки выполнили!"

#. ja: すぐに欲しいのにゃ！
#. de: Wir haben unseren Teil<br>der Abmachung eingehalten!
#. fr: Je le veux tout de suite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:125:0:1"
msgid "You have your gil.<br>Now where is it?"
msgstr "Вот ваши гилы.<br>А где товар?"

#. ja: こっちがいいわよぉ
#. de: Stell dir nur all die Fische<br>vor, die man damit<br>transportieren könnte!
#. fr: Celui-là est mieux, non<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:126:0:1"
msgid "Fish! Have you<br>lost your wits!?"
msgstr "Рыба! Ты что, совсем<br>с ума сошёл?!"

#. ja: ん～～、こっちじゃない？
#. de: Fische?! Hast du den<br>Verrrstand verloren?!
#. fr: Je crois que je vais prendre celui-ci...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:127:0:1"
msgid "Think of all the fish<br>this could carry!"
msgstr "Да подумай, сколько<br>рыбы влезет!"

#. ja: …ぷはぁっ！
#. de: Mädel! Wir brauchen<br>eine neue Runde!
#. fr: Ça fait du bien par où ça passe<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:128:0:1"
msgid "Wench! We need<br>another round!"
msgstr "Эй, красотка! Нам<br>ещё по кружке!"

#. ja: ふぅむ…見事だ
#. de: Daraus könnte ich ein<br>Dutzend Waffenröcke nähen!
#. fr: Je suis sûr que je tiens là-dedans<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:129:0:1"
msgid "I could fit my<br>whole family in that!"
msgstr "Да тут вся моя<br>семья поместится!"

#. ja: おい、聞いてんのかよぉ？
#. de: Was wir <i>brauchen</i>,<br>ist ein neues Mädel.
#. fr: Eh, tu m'écoutes<nbsp>!?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:130:0:1"
msgid "What we <i>need</i><br>is another wench."
msgstr "Нам нужна<i> </i><br>ещё одна официантка."

#. ja: んっしょ…んっしょ…
#. de: La lala la la ♪
#. fr: Un point dedans, un point dehors...
msgctxt "Balloon:131:0:1"
msgid "La lala la la!♪"
msgstr "Ля-ля-ля-ля-ля!♪"

#. ja: よしよし、いい子ね
#. de: Solange <i>ich</i> hier wache,<br>ist alles gut, Liebes.
#. fr: Bien, brave bête<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:132:0:1"
msgid "Won't no one et ye<br>on <i>my</i> watch, dear."
msgstr "Не дам тебя в обиду,<br>пока <i>я</i> тут, милая."

#. ja: てい、ねい、に…っと
#. de: Muss ... aufpassen ...<br>mir nicht ... in den ...<br>Autsch!
#. fr: Doucement et soigneusement...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:133:0:1"
msgid "Must...be...careful...<br>not...to... Ouch!"
msgstr "Надо... быть... осторожнее...<br>только бы не... Ай!"

#. ja: 上々ですよ
#. de: Diese Bohnen! Ich kriege den Gestank gar nicht mehr aus meiner Kleidung raus!
#. fr: Et là, il m'a dit, accroche-toi au pinceau...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:134:0:1"
msgid "The beans! I cannot rid<br>my clothes of this stench!"
msgstr "Эти бобы! Никак не могу<br>выветрить запах из одежды!"

#. ja: ふむ、大丈夫そうだな
#. de: Heute scheint alles in<br>Ordnung zu sein.
#. fr: Tout m'a l'air impeccable.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:135:0:1"
msgid "Everything seems<br>in order today."
msgstr "Сегодня, похоже,<br>всё в порядке."

#. ja: これもステキねぇ
#. de: Welch herrliche<br>Handwerkskunst!
#. fr: Oh, c'est ravissant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:136:0:1"
msgid "What beautiful<br>craftsmanship!"
msgstr "Какая чудесная<br>работа!"

#. ja: へぇ、こういうのもあるのね
#. de: Ähm.<br>Da hab ich schon<br>Besseres gesehen.
#. fr: Ils ont aussi ce genre de choses<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:137:0:1"
msgid "Eh.<br>I've seen better."
msgstr "Ох.<br>Видал и получше."

#. ja: …静かにしてくれないか
#. de: Ich krieg kein Auge zu<br>bei dem Geschnarche!
#. fr: Silence, s'il vous plaît<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:138:0:1"
msgid "I cannot sleep a wink<br>with that snoring!"
msgstr "Да не храпите вы!<br>Мне уснуть не даёте!"

#. ja: Ｚｚｚ…
#. de: \<schnarch>
#. fr: (ronfle)...
msgctxt "Balloon:139:0:1"
msgid "\\<snore>"
msgstr "<i>Хр-р-р...</i>"

#. ja: うーん…
#. de: Ich kann meine Hände<br>nicht ruhig halten!
#. fr: Grmbl... Je dois y arriver...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:140:0:1"
msgid "I cannot steady<br>my hands!"
msgstr "Руки никак<br>не унять!"

#. ja: …えいっ！
#. de: Ein bisschen höher ...<br>Oder vielleicht ein<br>bisschen tiefer?
#. fr: Décidément, c'est pas mon jour<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:141:0:1"
msgid "A tad higher... Or<br>perhaps a tad lower?"
msgstr "Чуть повыше... Или<br>чуть пониже?"

#. ja: 力みすぎだ
#. de: Entspannt Euch ... und<br>vergesst nicht, zu atmen.
#. fr: Sois moins tendue... Prends ton temps.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:142:0:1"
msgid "Relax... And do not<br>forget to breathe."
msgstr "Расслабься... И не<br>забывай дышать."

#. ja: 隙をつけば…！
#. de: Meine Frau sagt, ich sei<br>der Beste, den sie je hatte.
#. fr: Il faut trouver une faille...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:143:0:1"
msgid "Wife tells me I'm<br>the best she's had."
msgstr "Жена говорит, что я<br>лучший из всех, кто у неё был."

#. ja: イクサル族を甘く見るな
#. de: Lustig. Mir erzählt sie<br>das Gleiche. Hahaha!
#. fr: Ne sous-estime pas les Ixali.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:144:0:1"
msgid "Funny. She tells me<br>the same. Gahaha!"
msgstr "Забавно. Она мне<br>то же самое говорит. Ха-ха!"

#. ja: …ふぅ…
#. de: Haben wir nicht genug<br>trainiert für heute?
#. fr: Pfouh... J'en peux plus...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:145:0:1"
msgid "Haven't we trained<br>enough for the day?"
msgstr "Может, на сегодня<br>хватит тренироваться?"

#. ja: はぁ、はぁ…
#. de: \<keuch> \<keuch>
#. fr: Pffh, pffh...
msgctxt "Balloon:146:0:1"
msgid "\\<pant> \\<pant>"
msgstr "<i>Ха-а... ха-а...</i>"

#. ja: もう、へばったのか？
#. de: Denkt ihr, der Feind<br>gönnt euch eine Pause?!
#. fr: Déjà fatigués<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:147:0:1"
msgid "You think the enemy<br>will allow you rest!?"
msgstr "Думаете, враг даст<br>вам передышку?!"

#. ja: はっ！
#. de: Jawohl, Sir!
#. fr: Compris<nbsp>!
msgctxt "Balloon:148:0:1"
msgid "Yes, sir!"
msgstr "Так точно, сэр!"

#. ja: はいっ！
#. de: Jawohl, Sir!
#. fr: Bien, Chef<nbsp>!
msgctxt "Balloon:149:0:1"
msgid "Yes, sir!"
msgstr "Так точно, сэр!"

#. ja: …はひ！
#. de: Jawohl, Ma'am!<br>Äh! Sir!
#. fr: Oui, M'sieur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:150:0:1"
msgid "Yes, ma'am!<br>Ah! Sir!"
msgstr "Так точно, мэм!<br>Ой! Сэр!"

#. ja: 引きが甘いわね
#. de: Ihr könntet nicht mal<br>diesen Baumstamm treffen!
#. fr: Ils ne bandent pas assez leurs arcs.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:151:0:1"
msgid "You lot couldn't hit<br>the side of that log!"
msgstr "Вы даже в бревно<br>не попадёте!"

#. ja: どうか、お導きを…
#. de: Gibt es denn nichts,<br>was Ihr tun könnt,<br>um zu helfen?
#. fr: Je vous en prie, aidez-moi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:152:0:1"
msgid "Is there naught you<br>can do to help!?"
msgstr "Неужели вы ничем<br>не можете помочь?!"

#. ja: クエッ！
#. de: Kweeeh!
#. fr: Kwé<nbsp>!!
msgctxt "Balloon:153:0:1"
msgid "Kweeeh!"
msgstr "Кве-е-е!"

#. ja: あと100回ッ！
#. de: Noch mal hundert, bis<br>du es richtig machst!
#. fr: Encore cent coups<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:154:0:1"
msgid "A hundred more until<br>you have it right!"
msgstr "Ещё сто раз,<br>пока не получится!"

#. ja: 踏み込みが甘いぞ！
#. de: Dieser Hieb durchsticht<br>nicht einmal die Federn<br>am Hintern eines Ixal!
#. fr: Ton approche est trop molle<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:155:0:1"
msgid "That thrust won't<br>pierce the feathers<br>on an Ixal's arse!"
msgstr "Таким ударом даже<br>перья с задницы иксаля<br>не проткнёшь!"

#. ja: Ｚｚｚ…
#. de: Meine liebste<br>Pauline ... Zzz ...
#. fr: Ma chère Pauline... Zzz...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:156:0:1"
msgid "My dearest<br>Pauline... Zzz......"
msgstr "Моя дорогая<br>Полина... Хр-р..."

#. ja: 魔物の仕業か？
#. de: Es sind diese Parasiten,<br>ich sag's dir!
#. fr: C'est encore ces fichus chigoes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:157:0:1"
msgid "It's them chigoes,<br>I tell you!"
msgstr "Это всё эти чигу,<br>вот увидите!"

#. ja: 新芽がやられちまったよ
#. de: Was sollte ich Eurer<br>Meinung nach tun?
#. fr: Mes pousses ont été saccagées...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:158:0:1"
msgid "What would you<br>have me do then?"
msgstr "И что же вы<br>предлагаете делать?"

#. ja: クエッ！
#. de: Kweh!
#. fr: Kwé kwé<nbsp>!
msgctxt "Balloon:159:0:1"
msgid "Kweh!"
msgstr "Кве!"

#. ja: 次に枝打ちする場所は…。
#. de: Da kommen wir wohl<br>auf keinen grünen Zweig.
#. fr: Alors que le bon élagueur, lui, il coupe la branche mais...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:160:0:1"
msgid "Then we agree<br>to disagree."
msgstr "Тогда уж лучше<br>не спорить."

#. ja: よーしよし
#. de: Ist ja gut.
#. fr: Comme tu es beau, toi<nbsp>!
msgctxt "Balloon:161:0:1"
msgid "There, there."
msgstr "Ну-ну."

#. ja: あとひと息だ
#. de: Noch eine Glocke und<br>wir sind in Gridania!
#. fr: On est presque arrivés<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:162:0:1"
msgid "Another bell and<br>we'll be in Gridania!"
msgstr "Ещё колокол —<br>и будем в Гридании!"

#. ja: ガッポリにゃ！
#. de: Und dann werden wir<br>rrreich sein!
#. fr: À nous les sousous dans la popoche<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:163:0:1"
msgid "And then<br>we'll be rich!"
msgstr "А там-то<br>заживём!"

#. ja: 到着まで気は抜けん
#. de: Falls wir es in einem Stück<br>dorthin schaffen ...
#. fr: Pas d'imprudence avant d'y être<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:164:0:1"
msgid "That's if we make<br>it in one piece..."
msgstr "Если только доберёмся<br>туда целыми..."

#. ja: ったく…
#. de: Das hast du <i>letzte</i><br>Nacht schon gesagt.
#. fr: Ah, bravo...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:165:0:1"
msgid "That's what you<br>said <i>last</i> night."
msgstr "Ты это же<br>говорил <i>вчера</i> ночью."

#. ja: うぃ～ヒック…
#. de: Argh ...<br>Nie wieder Honigwein.<br>Das schwöre ich.
#. fr: Beuheuh... (hips)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:166:0:1"
msgid "Ugh... I've had my<br>last mead. I swear it."
msgstr "Уф... Больше ни капли<br>мёдового эля. Клянусь."

#. ja: 精霊様が許すはずがないわ
#. de: Die Gebieter werden das<br>niemals gestatten!
#. fr: Les esprits ne laisseront jamais faire ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:167:0:1"
msgid "The spirits will<br>never allow it!"
msgstr "Духи никогда<br>этого не допустят!"

#. ja: またアラミゴからか？
#. de: Dann wird uns das gleiche<br>Schicksal ereilen ...
#. fr: Encore<nbsp>? D'Ala Mhigo<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:168:0:1"
msgid "Then we shall meet<br>the same fate..."
msgstr "Тогда нас ждёт<br>та же участь..."

#. ja: む…冒険者か
#. de: Vorsicht, Fremder.<br>Ich habe ein Auge auf Euch.
#. fr: Encore <if $gn4>une aventurière<else>un aventurier</if>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:169:0:1"
msgid "Tread lightly, outsider.<br>I am watching you."
msgstr "Осторожнее, чужак.<br>Я за тобой слежу."

#. ja: あれは商人か？それとも…
#. de: Bei den Göttern! Was<br>kommt da auf uns zu?
#. fr: C'est un marchand, ça, ou bien...<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:170:0:1"
msgid "Gods! What is that<br>approaching!?"
msgstr "Боги! Что это<br>к нам приближается?!"

#. ja: これより討伐任務を開始する！
#. de: Helft Ihr uns, das Land<br>von dem Bösen zu säubern?
#. fr: Nous partons en expédition. Que les courageux nous suivent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:171:0:1"
msgid "Join us in purging<br>the land of evil?"
msgstr "Поможешь очистить<br>эти земли от зла?"

#. ja: うまい仕事はないのか？
#. de: Ich glaube, ich habe die<br>perfekte Aufgabe für uns!
#. fr: Vous auriez pas un boulot sympa pour moi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
#, aeria-term-model-exception: job b3e546875adf
msgctxt "Balloon:172:0:1"
msgid "I think I found us<br>the perfect job!"
msgstr "Кажется, я нашёл<br>нам идеальную работу!"

#. ja: またスクウィレルの退治なの？
#. de: Sag's nicht ...<br>Schon wieder Baumhörnchen?
#. fr: Quoi, encore casser de l'écureuil<nbsp>!? Pffff...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:173:0:1"
msgid "Don't tell me...<br>Squirrels again?"
msgstr "Только не говори...<br>Опять белки?"

#. ja: え～宿、借りられないの？
#. de: Die Regeln interessieren<br>mich einen Dreck! Ich<br>verlange ein Zimmer!
#. fr: Quoi, on ne peut pas louer de chambre<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:174:0:1"
msgid "I care not one whit for<br>your rules! I demand a room!"
msgstr "Мне плевать на ваши<br>правила! Требую комнату!"

#. ja: かしこまりました
#. de: Kommt sofort!
#. fr: Je vous apporte ça tout de suite<nbsp>!
msgctxt "Balloon:175:0:1"
msgid "Coming right up, love!"
msgstr "Сейчас принесу, милый!"

#. ja: 名物のハーブティーを頼む
#. de: Den größten Krug deines<br>stärksten Bieres bitte!
#. fr: Une tisane, s'il vous plaît.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:176:0:1"
msgid "The tallest mug of<br>your strongest ale!"
msgstr "Самую большую кружку<br>самого крепкого эля!"

#. ja: 休んだら鍛錬再開だぞ
#. de: Erheb deinen Hintern,<br>Rekrut!
#. fr: Souffle un coup. On reprend l'en<shy>traî<shy>ne<shy>ment dès que t'as récupéré.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:177:0:1"
msgid "Half a bell of rest, then<br>it's back to the barracks."
msgstr "Полчаса отдыха — и<br>марш обратно в казармы."

#. ja: ぜえ…ぜえ…
#. de: Aber ich habe mich gerade<br>erst hingesetzt!
#. fr: Pfiou... Je suis épuisé...
msgctxt "Balloon:178:0:1"
msgid "But I just sat down!"
msgstr "Но я только сел!"

#. ja: アダマンタスに頼みな
#. de: Frag doch einen Adaman-Taimai.<br>Ich habe nichts zu verschenken.
#. fr: Va donc demander à une adamankhélone<nbsp>! Je ne peux rien pour toi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:179:0:1"
msgid "Ask an adamantoise.<br>I have none to spare."
msgstr "Попроси у адамантойса.<br>У меня лишних нет."

#. ja: 1個でいいのにゃ！
#. de: Ich bitte doch nur um<br>ein einziges Ei!
#. fr: Allez, juste un<nbsp>! Sois sympa<nbsp>!
msgctxt "Balloon:180:0:1"
msgid "Just one egg is all I ask!"
msgstr "Мне всего одно яичко!"

#. ja: こ、これしき…
#. de: Ah, Lady Heinana,<br>hatten wir es nicht eilig?
#. fr: Décidez-vous, bon sang<nbsp>! Cette caisse pèse une tonz<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:181:0:1"
msgid "Uh, Lady Heinana,<br>were we not in a hurry?"
msgstr "Госпожа Хайнана,<br>мы разве не торопимся?"

#. ja: 甲羅のスキマを狙えないか？
#. de: Wenn man sie doch nur<br>irgendwie auf den Rücken<br>kriegen würde.
#. fr: Il y a sûrement un point faible dans leurs carapaces<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:182:0:1"
msgid "If there were only a way<br>to get them on their backs."
msgstr "Вот бы только как-нибудь<br>перевернуть их на спину."

#. ja: うーん…
#. de: Ich werde mich mal in der Grotte nach einem Schwebe-Zauber erkundigen.
#. fr: Il y a sans doute matière à réflexion, en effet...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:183:0:1"
msgid "I will inquire with<br>the Fane about a<br>spell of levitation."
msgstr "Надо спросить в храме,<br>как наложить заклятие левитации."

#. ja: あの水しぶきは…？
#. de: Man kann gar nicht vorsichtig genug sein mit diesen riesigen Viechern.
#. fr: Il y a des remous suspects, là-bas...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:184:0:1"
msgid "One can never be too<br>careful around tortoises."
msgstr "С черепахами надо<br>держать ухо востро."

#. ja: …ふぅ
#. de: Bitte! Ich kann nicht mehr!
#. fr: J'en peux plus, je sens plus mes bras<nbsp>!
msgctxt "Balloon:185:0:1"
msgid "Please. I can cut no more!"
msgstr "Пожалуйста. Я больше<br>не могу рубить!"

#. ja: ふむ、ふむ
#. de: Sehr wohl, meine Liebste.<br>Aber was ist mit der Lieferung?
#. fr: Vous m'en direz tant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:186:0:1"
msgid "Very good. But what<br>of the delivery's status?"
msgstr "Понятно. А как там<br>с доставкой?"

#. ja: ユージニア監視哨では…
#. de: Bei Eugenias Wachturm<br>wurden Ixal gesichtet.
#. fr: Une attaque à la tour d'Eugenia<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:187:0:1"
msgid "Ixal were sighted<br>near Eugenia's Spire."
msgstr "Иксалей видели<br>у дозорной башни Евгении."

#. ja: 警戒をしておこう
#. de: Das solltest du deine<br>Gäste lieber wissen lassen.
#. fr: Nous devons être vigilants.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:188:0:1"
msgid "You'd best let<br>your patrons know."
msgstr "Лучше предупреди<br>своих посетителей."

#. ja: …………
#. de: ...
#. fr: Quel chef-d'œuvre...
msgctxt "Balloon:189:0:1"
msgid "Master..."
msgstr "Мастер..."

#. ja: 北の砦に？
#. de: Die Festung im Norden?<br>Bist du verrückt?
#. fr: La forteresse au nord<nbsp>? C'est trop dangereux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:190:0:1"
msgid "The fortress to the<br>north!? Are you mad?"
msgstr "В крепость на севере?!<br>Ты с ума сошёл?"

#. ja: 見に行くだけだって
#. de: Wir wollen ja nicht <i>rein</i>.<br>Nur mal einen Blick drauf werfen.
#. fr: Allez, c'est juste pour jeter un œil<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:191:0:1"
msgid "We won't <i>enter</i> it;<br>merely have a look."
msgstr "Мы не будем <i>входить</i>.<br>Просто поглядим."

#. ja: Ｚｚｚ…
#. de: Kann ein Mann nicht mal<br>in Ruhe seinen Rausch<br>ausschlafen?
#. fr: Ô ma douce... Zzz...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:192:0:1"
msgid "Can't a man sleep off<br>his mead in peace?"
msgstr "Мужчине и поспать нельзя,<br>чтобы протрезветь?"

#. ja: …ふぅ
#. de: Oh! Tut mir leid, Schatz.<br>Hast du was gesagt?
#. fr: (soupire) Qu'il est beau...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:193:0:1"
msgid "Oh! I'm sorry, love. Were<br>you saying something?"
msgstr "Ой, прости, милый. Ты<br>что-то говорил?"

#. ja: オススメを頼む
#. de: Ich ... äh ... hätte gern<br>ein Wasser.
#. fr: Euh... Laissez-moi réfléchir...
msgctxt "Balloon:194:0:1"
msgid "I'll...uh, have some water."
msgstr "Мне... э-э... воды, пожалуйста."

#. ja: 川魚のムニエルはいかが？
#. de: Unser Spezialitäten heute<br>sind Aal, Molch, Schnecke<br>und Kröte.
#. fr: Aujourd'hui, nous vous proposons du triton en meunière.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:195:0:1"
msgid "Our specials today are<br>eel, eft, snail, and toad."
msgstr "Сегодня у нас на выбор:<br>угорь, тритон, улитка и жаба."

#. ja: 恐ろしい目に遭った…
#. de: Und ich habe gesehen, wie<br>sich diese <i>Fremde</i> mit<br>der Tasche davongemacht hat.
#. fr: Je les revois encore... J'ai vraiment eu la peur de ma vie<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:196:0:1"
msgid "And I saw this <i>outsider</i><br>make off with the purse."
msgstr "А ещё я видел, как этот<br><i>чужак</i> унёс кошель."

#. ja: もう、大丈夫ですよ
#. de: Aber das ist nicht wahr!<br>Ihr müsst mir glauben!
#. fr: Remets-toi, c'est fini<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:197:0:1"
msgid "But that isn't true!<br>You must believe me!"
msgstr "Но это неправда!<br>Поверьте мне!"

#. ja: 甘ったれるな！
#. de: Sieh mal an! Und du bist<br>gerade mal zwei Stunden<br>aus Gridania raus.
#. fr: Que j'vous voie pas vous relâcher, ou j'vous en colle cent de plus<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:198:0:1"
msgid "Not two hours out of<br>Gridania, and look at you!"
msgstr "Ты всего два часа как<br>вышел из Гридании — и уже раскис!"

#. ja: ヒィッ、ハァッ…
#. de: Sir, ich bin bereit für die<br>nächsten zwanzig Malme, Sir!
#. fr: Et une, et deux<nbsp>! Et une, et deux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:199:0:1"
msgid "Sir, I'm ready for another<br>twenty malms, sir!"
msgstr "Сэр, я готов пробежать<br>ещё двадцать миль, сэр!"

#. ja: でね、それがまた…
#. de: Ich musste vorhin ein paar<br>der Viecher verjagen.
#. fr: Et alors là, tu vois...  Oh<nbsp>! Tu m'écoutes<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:200:0:1"
msgid "I had to chase a few of<br>the monsters away earlier."
msgstr "Мне тут пришлось<br>отогнать несколько чудовищ."

#. ja: はい、はい
#. de: Diese Bohnen sind voller<br>Opo-Opo-Mist!
#. fr: Cette odeur<nbsp>! Je ne m'y ferai jamais...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:201:0:1"
msgid "These beans are covered<br>in opo-opo droppings!"
msgstr "Эти бобы все<br>в помёте опо-опо!"

#. ja: かなりやばそうだぜ
#. de: Du wirst nicht glauben,<br>was ich heute vorhabe.
#. fr: Écoutez un peu cette idée que je viens d'avoir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:202:0:1"
msgid "You won't believe what<br>I have planned for today."
msgstr "Не поверишь, что я сегодня задумал!"

#. ja: あぁ…
#. de: \<seufz><br>Nicht schon wieder ...
#. fr: Et ça recommence... (soupire)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:203:0:1"
msgid "\\<sigh><br>Here we go again."
msgstr "<i>Эх...</i><br>Опять за своё."

#. ja: またー？
#. de: Lass mich raten.<br>Mal wieder die Ruinen?
#. fr: Laisse-moi deviner<nbsp>: une nouvelle excursion aux ruines<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:204:0:1"
msgid "Wait, let me guess.<br>Another trip to the ruins?"
msgstr "Погоди, дай угадаю.<br>Опять в руины собрались?"

#. ja: ま～た勝手に貼って…
#. de: Verdammter Tierkleber!<br>Das kriege ich niemals raus!
#. fr: Qui a utilisé de la glu animale<nbsp>? Je vais jamais réussir à décoller ça, moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:205:0:1"
msgid "Damned vandals!<br>I'll never get this off!"
msgstr "Проклятые вандалы!<br>Да я это вовек не отдеру!"

#. ja: ふい～！
#. de: Es geht doch nichts über<br>ein warmes Bier nach<br>einem knüppelharten Tag!
#. fr: Après une journée pareille, rien ne vaut une bonne bière<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:206:0:1"
msgid "Nothin' like a warm ale<br>after a day of maimin'!"
msgstr "Нет ничего лучше тёплого эля<br>после дня, полного мордобоя!"

#. ja: まぁそう焦んなよぉ
#. de: Sehen? Ich dachte, wir wären zum Trinken hier!
#. fr: Fais comme moi et bois une bonne brune en attendant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:207:0:1"
msgid "See? I thought we<br>was 'ere to drink!"
msgstr "Ну вот! А я-то думал,<br>мы сюда выпить пришли!"

#. ja: お手並み拝見だな
#. de: Du würdest kaum dreißig Herzschläge durchhalten, du Hund.
#. fr: Tu tiendrais même pas trente secondes contre moi.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:208:0:1"
msgid "You wouldn't last<br>thirty heartbeats, dog."
msgstr "Тебе и тридцати ударов сердца не продержаться, пёс."

#. ja: う～ん…
#. de: So viel Auswahl ...
#. fr: Sacré dilemme...
msgctxt "Balloon:209:0:1"
msgid "Decisions, decisions..."
msgstr "Вот так задачка..."

#. ja: …フン
#. de: Komm schon, sei ein Mann und kämpfe im Kolosseum gegen mich.
#. fr: Tu veux parier<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:210:0:1"
msgid "Come, fight me on the<br>bloodsands like a man."
msgstr "А ну, дерись со мной<br>на кровавом песке, как мужчина!"

#. ja: 悪くないぜ
#. de: Die Brückenseile kappen, die Bestie in den Abgrund stoßen, die Prinzessin retten.
#. fr: Disons qu'on se mettrait à l'abri pour un moment...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:211:0:1"
msgid "Cut the ropes to the<br>bridge, send the beast<br>plummeting, save the<br>princess."
msgstr "Перерезать канаты моста,<br>сбросить чудовище в пропасть,<br>спасти принцессу."

#. ja: 報酬はどう？
#. de: Klingt nach einem Kinderspiel. Was ist für uns dabei drin?
#. fr: La récompense en vaut la peine, au moins<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:212:0:1"
msgid "Sounds simple enough.<br>What's in it for us?"
msgstr "Звучит проще простого.<br>А нам-то что за это будет?"

#. ja: ヒヒ…金貸しに用かい？
#. de: Du benötigst ein wenig<br>Kleingeld, nicht wahr?
#. fr: Besoin d'argent<nbsp>? J'peux t'en prêter si tu veux, héhéhé...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:213:0:1"
msgid "Lookin' to borrow<br>some coin, maybe?"
msgstr "Денег занять хочешь, что ли?"

#. ja: 俺もコロセウムの試合見てぇ…
#. de: Wenn meine Schicht doch<br>nur schon rum wäre ...
#. fr: Je commence à en avoir marre d'être planté là...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:214:0:1"
msgid "If only my<br>shift would end..."
msgstr "Вот бы смена уже закончилась..."

#. ja: 今日も熱いカードだねぇ
#. de: Und wie riecht Action so?
#. fr: Les combats d'aujourd'hui promettent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:215:0:1"
msgid "And what, exactly,<br>does action smell like?"
msgstr "И чем же, позволь спросить,<br>пахнет зрелище?"

#. ja: 持ってくかぁ
#. de: Bist du so weit?
#. fr: T'es prêt<nbsp>?
msgctxt "Balloon:216:0:1"
msgid "You ready yet?"
msgstr "Ну что, готов?"

#. ja: よっ…
#. de: Einen Moment noch.<br>Ich hab's gleich.
#. fr: Une seconde, je préfère l'avoir bien en main.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:217:0:1"
msgid "Just let me get a<br>good handle on her."
msgstr "Погоди, дай-ка я её<br>как следует ухвачу."

#. ja: あわわ…
#. de: Das nächste Mal krieg ich's hin, ich schwöre!
#. fr: Un jour, j'y arriverai<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:218:0:1"
msgid "I'll get it right<br>next time, I swear!"
msgstr "В следующий раз точно получится, клянусь!"

#. ja: フットワークが遅い！
#. de: Links! Rechts!<br>In Bewegung bleiben!
#. fr: Qu'est-ce que c'est que ce jeu de jambes<nbsp>? Réveillez-vous, bon sang<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:219:0:1"
msgid "Left! Right!<br>Keep moving!"
msgstr "Лево! Право!<br>Не стой на месте!"

#. ja: 473番です
#. de: Nummer 473.
#. fr: C'est le casier numéro 473.
msgctxt "Balloon:220:0:1"
msgid "Drawer 473."
msgstr "Ящик номер 473."

#. ja: はぁっ、はぁっ…
#. de: Das ist nicht fair!
#. fr: Il n'y aurait pas comme une petite différence de catégorie<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:221:0:1"
msgid "This is hardly<br>what I'd call fair!"
msgstr "Вот уж это я честным боем не назову!"

#. ja: 次の作品のイメージはね…
#. de: Ich habe eine Idee für ein Gefährt mit 2 Rädern, das man mit Pedalen antreibt.
#. fr: Voilà ce que je compte faire pour ma prochaine création...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:222:0:1"
msgid "I have an idea for a<br>two-wheeled cart you<br>pedal with your legs."
msgstr "Я придумал, что создать дальше: телегу на двух колёсах, которую ногами крутишь."

#. ja: 俺も、いつかは…
#. de: Eines Tages wird mein<br>Antlitz an dieser Wand<br>sein!
#. fr: Moi aussi, un jour, j'aurai une place sur ce mur...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:223:0:1"
msgid "One day, it'll be my<br>likeness on that wall!"
msgstr "Когда-нибудь и мой портрет<br>будет на этой стене!"

#. ja: 素晴らしいアイデアだ
#. de: Warum nimmst du nicht<br>einfach einen Chocobo?
#. fr: Je te reconnais bien là<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:224:0:1"
msgid "Why wouldn't you<br>just ride a chocobo?"
msgstr "А почему бы просто<br>не оседлать чокобо?"

#. ja: 銀鉱の質がイマイチなんだ
#. de: Die letzte Lieferung war völlig verunreinigt.
#. fr: Le dernier chargement contenait beaucoup d'impuretés.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:225:0:1"
msgid "That last shipment<br>was full of impurities."
msgstr "В последней партии<br>было полно примесей."

#. ja: そこで俺のカードがな…
#. de: Hab heute drei Gegner besiegt, jawoll!
#. fr: J'ai remporté tous mes combats, aujourd'hui.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:226:0:1"
msgid "Took down three<br>opponents today, I did."
msgstr "Сегодня троих соперников уложил, вот!"

#. ja: すごーい！
#. de: Und nicht mal einen Kratzer abbekommen? Unglaublich!
#. fr: Et pas une seule égratignure<nbsp>? Incroyable<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:227:0:1"
msgid "And not a single<br>scratch? Incredible!"
msgstr "И ни царапинки? Вот это да!"

#. ja: 素敵…
#. de: Wie wär's, wenn du es mit noch einem aufnimmst ...?
#. fr: Qu'il est beau...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:228:0:1"
msgid "How would you like to<br>take down one more...?"
msgstr "Как насчёт ещё одного?.."

#. ja: 破壊、破壊、破壊…
#. de: Kalamitäten ...<br>Kataklysmen ...<br>Ach ja, Katastrophen!
#. fr: Calamités, cataclysmes... catastrophes, voilà ce que je cherchais<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:229:0:1"
msgid "Calamities...<br>Cataclysms...<br>Ah, yes, catastrophes!"
msgstr "Бедствия...<br>Катаклизмы...<br>А, точно! Катастрофы!"

#. ja: ザル神に祈りを…
#. de: Kniet nieder vor Thal und betet für einen sanften Übergang ins Jenseits.
#. fr: Prosternez-vous devant Thal et priez pour un confortable passage vers l'au-delà.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:230:0:1"
msgid "Kneel before Thal and<br>pray for safe passage<br>into the afterlife."
msgstr "Преклонитесь перед Талом<br>и молитесь о лёгком пути<br>в загробный мир."

#. ja: 来世こそ幸せになりてぇだ…
#. de: Möge ich im nächsten Leben Glück finden ... und Gil.
#. fr: Faites que je me réincarne en quelqu'un d'heureux... et riche<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:231:0:1"
msgid "May the next life bring<br>me happiness...and gil."
msgstr "Пусть в следующей жизни<br>мне повезёт... и гилов будет побольше."

#. ja: 寄付ならいくらでも…
#. de: Geld spielt keine Rolle.
#. fr: L'argent n'est pas un problème.
msgctxt "Balloon:232:0:1"
msgid "Money is no object."
msgstr "Деньги не проблема."

#. ja: 豪華な葬儀にしたいんだ
#. de: Wir möchten uns einen Platz in Thals Reich sichern.
#. fr: Nous sommes venus demander la bénédiction de Thal.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:233:0:1"
msgid "We wish to secure our<br>place in Thal's realm."
msgstr "Мы хотим обеспечить себе<br>место в царстве Тала."

#. ja: 採掘師ギルドに文句言うかぁ
#. de: Willst du bei der Gilde Beschwerde einreichen?
#. fr: Tu vas te plaindre à la guilde<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:234:0:1"
msgid "Will you lodge a com-<br>plaint with the guild?"
msgstr "Пойдёшь жаловаться<br>в гильдию?"

#. ja: クエェ…
#. de: Kweh!
#. fr: Kwé kwé<nbsp>!
msgctxt "Balloon:235:0:1"
msgid "Kweh!"
msgstr "Квэ!"

#. ja: さあ、キレイにしてやるぞ
#. de: Dann wollen wir mal sehen, ob wir dich wieder sauber kriegen.
#. fr: C'est l'heure de ta toilette.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:236:0:1"
msgid "Now let's see if we<br>can't get you cleaned up."
msgstr "Ну-ка посмотрим,<br>сможем ли мы тебя отмыть."

#. ja: 今日の対戦カードはこちら！
#. de: Die heutigen Kämpfe stehen fest!
#. fr: Demandez le programme<nbsp>!
msgctxt "Balloon:237:0:1"
msgid "Today's matches are set!"
msgstr "Список сегодняшних боёв готов!"

#. ja: 今日の目玉はこいつだ！
#. de: Spannung pur im Kolosseum!
#. fr: C'est le combat du jour<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:238:0:1"
msgid "Thrill awaits you<br>on the bloodsands!"
msgstr "На кровавом песке<br>вас ждёт настоящее зрелище!"

#. ja: 人間戦車ゲオルクかぁ！
#. de: Georg Galleongut!<br>Das ist mein Favorit!
#. fr: Georg Galleongut va encore faire un massacre...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:239:0:1"
msgid "Georg Galleongut!<br>He's my favorite!"
msgstr "Георг Галлеонгут!<br>Мой любимец!"

#. ja: ここから先は行動に気をつけろ
#. de: Ein Fehltritt und du landest im Steinwurf-Slum!
#. fr: Je t'ai à l'œil<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:240:0:1"
msgid "One misstep and it's to<br>Stonesthrow with you!"
msgstr "Оступишься — и отправишься<br>в трущобы Камнеброда!"

#. ja: いいなぁ…
#. de: Noch eine halbe Glocke, bis sie Pause hat, und dann werde ich ...
#. fr: Dans quelques minutes elle prendra sa pause et j'en profiterai pour...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:241:0:1"
msgid "In half a bell, she'll take<br>her break, and then I'll─"
msgstr "Ещё полколокола — и она пойдёт на перерыв, а там я..."

#. ja: プレゼントに最適ですわ
#. de: Deine Frau wird ihn lieben!
#. fr: Votre femme va adorer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:242:0:1"
msgid "Your wife will<br>simply adore this!"
msgstr "Ваша жена будет<br>просто в восторге!"

#. ja: 一袋貰おうかのう
#. de: Einen Sack Sonnenweizen bitte.
#. fr: Un sac de blé, s'il vous plaît.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:243:0:1"
msgid "I'll take a sack<br>of sunset wheat."
msgstr "Мне мешок<br>закатной пшеницы."

#. ja: ありがとうございます！
#. de: Gibt's heute Brot?<br>Oder vielleicht Bier?
#. fr: Pour du pain ou de la bière<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:244:0:1"
msgid "Making some bread<br>today? Or maybe ale?"
msgstr "Сегодня хлеб печёте?<br>Или, может, эль?"

#. ja: そうだなぁ…
#. de: Solange sie nicht erfährt, wie viel er kostet ...
#. fr: Pas si elle apprend combien ça m'a coûté...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:245:0:1"
msgid "Not if she learns<br>how much it costs..."
msgstr "Если только она не узнает,<br>сколько это стоило..."

#. ja: 新作モチーフの発表です
#. de: Es gibt nichts Schöneres als eine Frau mit Funkeln in den Augen <i>und</i> an ihren Händen!
#. fr: Quoi de plus ravissant qu'une femme parée de diamants<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:246:0:1"
msgid "There is nothing more<br>beautiful than a woman<br>with diamonds in her<br>eyes <i>and</i> on her hands!"
msgstr "Нет ничего прекраснее<br>женщины с бриллиантами<br>в глазах <i>и</i> на руках!"

#. ja: 見てって見てってー
#. de: Bei mir gibt es die besten Edelsteine in der Stadt!
#. fr: Je vends les gemmes les plus pures de la ville<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:247:0:1"
msgid "I've the finest gems<br>in all this fine town!"
msgstr "У меня лучшие самоцветы<br>во всём этом славном городе!"

#. ja: さあさ見てらっしゃい！
#. de: Seht her und staunt!
#. fr: Approchez-vous et admirez<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:248:0:1"
msgid "Now watch<br>and be amazed!"
msgstr "Ну-ка, смотрите<br>и дивитесь!"

#. ja: すごーい！
#. de: Guck dir die mal an!
#. fr: Regarde<nbsp>! Il ne les laisse jamais tomber<nbsp>!
msgctxt "Balloon:249:0:1"
msgid "Look at her go!"
msgstr "Вот это да!"

#. ja: あははは！！
#. de: Das könnte ich besser ...
#. fr: Pas de quoi s'extasier...
msgctxt "Balloon:250:0:1"
msgid "I could do better..."
msgstr "Да я бы и лучше справилась..."

#. ja: ウフフ♪
#. de: ♪ Verliebt in 'nen Mann<br>ohne Gil in der Hand ♪
#. fr: Ses promesses m'ont rendue folle, mais tout n'était que belles paroles.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:251:0:1"
msgid "I fell for a man<br>with no gil in his hand.♪"
msgstr "Я влюбилась в мужчину,<br>у которого ни гроша в кармане.♪"

#. ja: 不思議な尻尾ねぇ
#. de: Rechts, hinten, links übersteigen ... Gleich hab ich's raus. Wär ja gelacht.
#. fr: Je ne savais pas que la mode était aux queues de chat...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:252:0:1"
msgid "Now, how do I get me<br>one of those tails...?"
msgstr "И как бы мне заполучить<br>такой хвост?.."

#. ja: 買っちゃった～！
#. de: Und ich muss dafür nur seine Einladung zum Essen annehmen!
#. fr: Oui<nbsp>! En échange d'un simple dîner chez lui, hihi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:253:0:1"
msgid "And I only need dine<br>with him at his estate!"
msgstr "А мне всего-то нужно поужинать у него в поместье!"

#. ja: え～いいな～！
#. de: Er kauft dir wirklich jede Kette, die dir gefällt?
#. fr: Il a vraiment promis de t'acheter le collier de tes rêves<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:254:0:1"
msgid "He'll truly buy you<br>any necklace you want?"
msgstr "Он и правда купит тебе<br>любое ожерелье?"

#. ja: ちょっとちょっと
#. de: He, du! Da drüben!
#. fr: Eh<nbsp>! Vous m'entendez<nbsp>?
msgctxt "Balloon:255:0:1"
msgid "Hey, you! Over here!"
msgstr "Эй, вы! Сюда!"

#. ja: また買いすぎちゃった！
#. de: Ich konnte mich nicht zwischen der roten und der blauen entscheiden ... Also habe ich beide gekauft!
#. fr: J'hésitais entre le rouge et le bleu... Mais finalement j'ai pris les deux.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:256:0:1"
msgid "I just couldn't decide<br>between the red or the<br>blue...so I bought both!"
msgstr "Всё никак не могла выбрать:<br>красное или синее...<br>Так что купила оба!"

#. ja: 上物だ！ 勉強するよ！
#. de: Für ihn 200.000 Gil! Aber für dich, mein Freund, nur 25!
#. fr: Vingt gils au lieu de deux cents<nbsp>! Un prix d'ami<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:257:0:1"
msgid "For him, 200,000 gil! But<br>for you, my friend, only 25!"
msgstr "Для него — двести тысяч гил!<br>А тебе, дружище, всего двадцать пять!"

#. ja: ひぃ～
#. de: Ähm, ich wär so weit, Liebling!
#. fr: Je suis prêt, ma chérie<nbsp>!
msgctxt "Balloon:258:0:1"
msgid "Any time now, dearest!"
msgstr "Уже иду, дорогая!"

#. ja: まだまだ行けるわよ！
#. de: Für welche hast du dich entschieden?
#. fr: Alors, lequel as-tu choisi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:259:0:1"
msgid "So which one did<br>you end up choosing?"
msgstr "Ну так какое<br>ты выбрала?"

#. ja: こりゃ掘り出し物だな
#. de: Ich <i>muss</i> diese Vase einfach haben!
#. fr: Ce vase... Il me le faut absolument<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:260:0:1"
msgid "I simply <i>must</i><br>have this vase!"
msgstr "Я просто <i>обязана</i><br>заполучить эту вазу!"

#. ja: うんと、えっと…
#. de: Wo hab ich nur mein Proviantpaket hingetan?
#. fr: Où ai-je donc mis mon casse-croûte<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:261:0:1"
msgid "Now where did I<br>put my lunch?"
msgstr "Куда же я положил<br>свой обед?"

#. ja: 静粛にするよう
#. de: Hüte deine Zunge auf der Herrscherpromenade.
#. fr: La promenade royale est un lieu où doivent régner calme et courtoisie.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:262:0:1"
msgid "You will watch your<br>tongue whilst in the<br>Royal Promenade."
msgstr "На Королевской аллее<br>следите за языком."

#. ja: ロロリト様ったらね…
#. de: Lord Lolorito ist ein dreckiger alter Sack!
#. fr: Lolorito n'est rien d'autre qu'un vieux grigou pervers<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:263:0:1"
msgid "Lord Lolorito is naught<br>but a dirty old pinchgil!"
msgstr "Лорд Лолорито — не кто иной,<br>как старый грязный скупердяй!"

#. ja: これは珍しい…
#. de: Eine Kopie des Enchiridions aus der Fünften Ära des Lichts!
#. fr: Un exemplaire de l'Enchiridion datant de la 5e ère astrale<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:264:0:1"
msgid "A Fifth Astral Era<br>copy of the <i>Enchiridion</i>!"
msgstr "Копия <i>Энхиридиона</i><br>пятой астральной эры!"

#. ja: さすがですわ～
#. de: Sprich leiser! Eines seiner Vögelchen könnte dich hören!
#. fr: Chuuut<nbsp>! Un de ses espions pourrait t'entendre...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:265:0:1"
msgid "Lower your voice! One<br>of his birds might hear!"
msgstr "Потише! Один из его осведомителей может услышать!"

#. ja: 希代の古書だよ！
#. de: Die findest du so leicht nie wieder.
#. fr: Vous ne verrez ça nulle part ailleurs<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:266:0:1"
msgid "You won't find another<br>outside the Holy See."
msgstr "За пределами Святого престола такого не сыщешь!"

#. ja: 実験もほどほどにな
#. de: Aber deine Kinder brauchen ihre Mutter!
#. fr: Prudence avec les ex<shy>pé<shy>ri<shy>men<shy>ta<shy>tions...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:267:0:1"
msgid "But your children<br>need their mother!"
msgstr "Но ведь твоим детям нужна мама!"

#. ja: ラウバーン様のおかげだ
#. de: Die Leute sagen, der Phönixgeneral habe den mächtigen Drachen erschlagen.
#. fr: Il paraît que c'est le général Aldynn qui est venu à bout de ce terrible dragon.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:268:0:1"
msgid "They say it was the<br>Flame General who<br>slew the mighty dragon."
msgstr "Говорят, могучего дракона<br>сразил генерал Огненных Чертогов."

#. ja: さすがだな
#. de: Er ist ein wahrer Held.
#. fr: C'est un héros parmi les héros.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:269:0:1"
msgid "He is a hero<br>amongst heroes."
msgstr "Он герой среди героев."

#. ja: お目が高い！
#. de: Sie haben einen vorzüglichen Geschmack, meine Dame!
#. fr: Vous avez bon goût, Madame<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:270:0:1"
msgid "You have excellent<br>taste, madam!"
msgstr "У вас превосходный вкус, мадам!"

#. ja: あらぁ…
#. de: Oh, vielen Dank!
#. fr: Merci, jeune homme<nbsp>!
msgctxt "Balloon:271:0:1"
msgid "Why, thank you!"
msgstr "Ой, благодарю!"

#. ja: ま、まだですかぁ？
#. de: Dauert das noch länger?
#. fr: Je commence à fatiguer...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:272:0:1"
msgid "Will this take<br>very much longer?"
msgstr "Долго ещё?"

#. ja: 武具の名店だよ！
#. de: Wir haben jede Waffe, die man sich nur wünschen kann. Und sogar ein paar mehr!
#. fr: Les armes et armures dont vous rêvez, et plus encore<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:273:0:1"
msgid "We carry any weapon<br>you can imagine, and<br>more that you can't!"
msgstr "У нас есть любое оружие,<br>какое только можно вообразить!<br>И даже такое, какого не вообразишь!"

#. ja: お見立てしますよ！
#. de: Individuelle Verzierungen bei jedem Kauf!
#. fr: Une broderie personnalisée offerte pour tout achat<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:274:0:1"
msgid "Custom embroidery<br>on all purchases!"
msgstr "Вышьем на заказ<br>при любой покупке!"

#. ja: 流行の発信地ですのよ
#. de: Einheitsgrößen, die allen passen ... oder die Hälfte des Kaufpreises zurück!
#. fr: N'hésitez pas à demander pour essayer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:275:0:1"
msgid "One size fits all or<br>half your money back!"
msgstr "Один размер подходит всем —<br>иначе вернём половину денег!"

#. ja: タランチュラを調合するのか…
#. de: Und wenn wir es auf vier Taranteln erhöhen würden?
#. fr: Une potion à base de pattes de tarentule<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:276:0:1"
msgid "What if we increased<br>it to four tarantulas?"
msgstr "А если увеличить дозу<br>до четырёх тарантулов?"

#. ja: 強力な毒になるんだ
#. de: Bei den Göttern! Das würde einen Auerochsen umbringen!
#. fr: Par les Douze<nbsp>! Il y en a assez pour assommer un buffle<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:277:0:1"
msgid "By the gods! That<br>would kill an aurochs!"
msgstr "Боги! Да это и быка убьёт!"

#. ja: なるほどね…
#. de: Aha! Zwei Augen von Nimmermolchen und <i>drei</i> Zehen von Fröschen!
#. fr: Deux yeux de triton et trois pattes de grenouille<nbsp>? Intéressant...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:278:0:1"
msgid "I see! Two eyes of newt<br>and <i>three</i> toes of frog!"
msgstr "Понятно! Два глаза тритона<br>и <i>три</i> лягушачьих пальца!"

#. ja: 交代は、まだかなあ…
#. de: Du bist nicht meine<br>Ablösung, oder?<br>Verdammt ...
#. fr: Vous êtes ici pour prendre la relève<nbsp>?<nbsp>... Non<nbsp>!? (soupire)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:279:0:1"
msgid "You aren't my replace-<br>ment, are you? Damn..."
msgstr "Ты ведь не сменщик мой?<br>Нет?.. Вот чёрт..."

#. ja: 魔物には気をつけるんだぞ
#. de: Drehe niemals deinen Rücken einer Bestie zu, hörst du?
#. fr: Ne tourne jamais le dos à un monstre, compris<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:280:0:1"
msgid "Don't ever turn your<br>back on a beastie, hear?"
msgstr "Никогда не поворачивайся к чудищу спиной, понял?"

#. ja: まずは濁水よ
#. de: Ja, aber zunächst müssen wir die Stagnation stoppen.
#. fr: Il faut d'abord enlever le dépôt.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:281:0:1"
msgid "Yes, but we must first<br>remove the stagnation."
msgstr "Да, но сначала надо убрать осадок."

#. ja: まだかー？
#. de: Ich würde das nicht hier rumstehen lassen.
#. fr: Tu ne la trouves toujours pas<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:282:0:1"
msgid "I wouldn't put<br>it past this lot."
msgstr "От этих всего можно ожидать."

#. ja: 賑やかだねぇ
#. de: Die Stadt sprüht nur so vor Leben!
#. fr: La cité a retrouvé son animation d'antan.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:283:0:1"
msgid "The city's alive<br>once again!"
msgstr "Город снова кипит жизнью!"

#. ja: そうだねぇ
#. de: Hoch lebe die Sultana!
#. fr: C'est grâce à la Sultane<nbsp>!
msgctxt "Balloon:284:0:1"
msgid "All hail the sultana!"
msgstr "Да здравствует султана!"

#. ja: ダメダメ！
#. de: Und ich habe Nein gesagt!
#. fr: Quand je dis non, c'est non<nbsp>!
msgctxt "Balloon:285:0:1"
msgid "And I said no!"
msgstr "А я сказала — нет!"

#. ja: お菓子買ってよ～
#. de: Ich will noch einen Honigkuchen!
#. fr: Papa, s'il te plaît...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:286:0:1"
msgid "I want another<br>honey cake!"
msgstr "Хочу ещё<br>медового пирога!"

#. ja: くず鉄、くず鉄…
#. de: Du glaubst doch nicht, dass jemand es stehlen würde, oder?
#. fr: Peut-être que quelqu'un l'a déjà emportée...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:287:0:1"
msgid "You don't think some-<br>one stole it, do you?"
msgstr "Не думаешь, что кто-нибудь его украл?"

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "Balloon:288:0:1"
msgid "  ..."
msgstr "  ..."

#. ja: 異常な～し！
#. de: Der Platz ist gesichert!
#. fr: Rien à signaler<nbsp>!
msgctxt "Balloon:289:0:1"
msgid "Plaza secure!"
msgstr "Площадь под охраной!"

#. ja: 誰も気にしねーだろ
#. de: Wo darf ich diese für Sie ablegen, meine Dame?
#. fr: Où voulez-vous que je les pose<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:290:0:1"
msgid "Where do you<br>want these, ma'am?"
msgstr "Куда это поставить, мадам?"

#. ja: 騒ぎは起こすなよ
#. de: Wenn du hier Ärger machst, verbringst du den Rest deines Lebens im Kerker.
#. fr: Cause pas de problèmes si tu veux pas finir aux oubliettes.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:291:0:1"
msgid "Start any trouble, and<br>I'll see you rot in the<br>oubliettes for eternity."
msgstr "Только попробуй устроить тут беспорядок — сгниёшь в казематах!"

#. ja: いいぞ、ねーちゃん！
#. de: Wenn du Gil brauchst, solltest du mal die Hände in meine Taschen stecken!
#. fr: Wouhou<nbsp>! Encore<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:292:0:1"
msgid "If it's gil you want,<br>come stick your hands<br>in me pockets!"
msgstr "Гилы нужны — суй руки мне в карманы!"

#. ja: ヒュー、ヒュー！
#. de: Bewegt euch, Mädels!
#. fr: Allez les filles, bougez-moi tout ça<nbsp>!
msgctxt "Balloon:293:0:1"
msgid "Shake it, ladies!"
msgstr "Давай, девчонки, трясите всем, что есть!"

#. ja: そろそろ行くか
#. de: Sollen wir los?
#. fr: Prêt à prendre la route<nbsp>?
msgctxt "Balloon:294:0:1"
msgid "Shall we be going, then?"
msgstr "Ну что, двинули?"

#. ja: ああ…
#. de: Wie du willst.
#. fr: C'est quand tu veux<nbsp>!
msgctxt "Balloon:295:0:1"
msgid "As you command."
msgstr "Как прикажете."

#. ja: ヘヘ…すいやせん
#. de: Ich bitte vielmals um Verzeihung, mein Herr.
#. fr: Pitié<nbsp>! Ça ne se reproduira plus<nbsp>!
msgctxt "Balloon:296:0:1"
msgid "A thousand apologies, sir."
msgstr "Простите великодушно, сэр."

#. ja: またてめぇか！
#. de: Pass ab jetzt besser auf!
#. fr: Encore toi<nbsp>!?
msgctxt "Balloon:297:0:1"
msgid "You watch yourself now!"
msgstr "Ну всё, смотри у меня!"

#. ja: タノシイタノシイ☆遊技場◎デス
#. de: Spaß! Spannung! Unterhaltung! Für Jung☆und☆Alt!
#. fr: Bienvenue au Mirage de platine<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:298:0:1"
msgid "BlOoD! MaImInG! FuN<br>fOr YoUnG☆aNd☆OlD!"
msgstr "КРРРРРРОВЬ! МЯСОРУБКА! ВЕСЕЛЬЕ<br>ДЛЯ МАЛЫШЕЙ☆И☆ВЗРОСЛЫХ!"

#. ja: 廃棄物が増えたわね
#. de: Schmeißen Sie sie einfach mit dem anderen Müll zusammen.
#. fr: Jette ça avec le reste.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:299:0:1"
msgid "Just toss it with<br>the rest of the rubbish."
msgstr "Просто выбрось это<br>к остальному мусору."

#. ja: 俺がお前をたおーす！
#. de: Ich töte dich und lass dich dann sterben!
#. fr: Prépare-toi à mourir<nbsp>! Je vais te réduire en miettes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:300:0:1"
msgid "I kill you and<br>make you die!"
msgstr "Я тебя убью<br>и заставлю умереть!"

#. ja: ハッ　笑わせるねぇ
#. de: Wenn ich nicht vorher am Lachen ersticke!
#. fr: Si je meurs, ça sera de rire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:301:0:1"
msgid "If I don't die of<br>laughter first!"
msgstr "Если только я раньше<br>не помру со смеху!"

#. ja: 貧民どもを連れてくんなよ？
#. de: Bring ja nichts von dem Pöbel hierher.
#. fr: T'as pas intérêt à amener une de ces canailles à l'intérieur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:302:0:1"
msgid "Don't you go bringing<br>any of that rabble in here."
msgstr "Не вздумай тащить сюда<br>всякое отребье."

#. ja: この通りは注意しろよ
#. de: Wenn du durch die Perlengasse musst, behalte lieber deinen Gilbeutel im Auge!
#. fr: Si tu passes par la rue de la Perle, garde un œil sur ta bourse.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:303:0:1"
msgid "It's best you keep<br>one eye on your purse."
msgstr "Лучше держи<br>кошелёк на виду."

#. ja: やれやれー！
#. de: 100 Gil auf den Seewolf!
#. fr: Cent gils sur le Roegadyn<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:304:0:1"
msgid "A hundred gil<br>on the Hellsguard!"
msgstr "Ставлю сто гил<br>на стража Ада!"

#. ja: あはは！
#. de: Hahaha!
#. fr: Hahahahaha<nbsp>!!!
msgctxt "Balloon:306:0:1"
msgid "Ahahahaha!"
msgstr "Ахахаха!"

#. ja: 肩が、どうもな…
#. de: Du hast mir doch glatt den Arm ausgekugelt!
#. fr: Toujours cette vieille blessure à l'épaule...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:307:0:1"
msgid "You damn near pulled<br>me arm straight out of<br>its socket!"
msgstr "Чуть руку мне<br>из сустава не вывернул!"

#. ja: イヒヒヒ…
#. de: Muharhar!
#. fr: Hihihihi<nbsp>!
msgctxt "Balloon:308:0:1"
msgid "Mwahahaha!"
msgstr "Мвахаха!"

#. ja: イヒッ…
#. de: Harhar!
#. fr: Hihihi<nbsp>!
msgctxt "Balloon:309:0:1"
msgid "Mwaha!"
msgstr "Мваха!"

#. ja: 相手の目をよく見ろ…
#. de: Behaltet immer den Gegner im Auge!
#. fr: Ne jamais quitter son adversaire des yeux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:310:0:1"
msgid "Do not take your<br>eyes off your victim!"
msgstr "Не своди глаз<br>с жертвы!"

#. ja: 呪術とは～つまり…
#. de: Es gibt nur eins zu bedenken, wenn ihr die Dunkelheit kanalisiert!
#. fr: Il n'est pas principe plus important dans l'occultisme<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:311:0:1"
msgid "There is but one thing<br>you must remember<br>when channeling the dark!"
msgstr "Запомни главное,<br>когда черпаешь силу<br>из тьмы!"

#. ja: クク…なるほど
#. de: Das wird dem Mistkerl eine Lektion sein, mich zu betrügen!
#. fr: Voilà qui devrait lui donner une bonne leçon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:312:0:1"
msgid "This'll teach that<br>whoreson to cozen me!"
msgstr "Вот тебе урок, негодяй!<br>Не надо было меня дурить!"

#. ja: 俺の呪具はっと…
#. de: Ich könnte schwören, meinen Stab hier abgelegt zu haben.
#. fr: J'aurais juré avoir laissé mon sceptre ici...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:313:0:1"
msgid "I could have sworn I<br>set my rod down here."
msgstr "Куда же я положил<br>свой жезл?"

#. ja: 嫌いな奴がいてさ…
#. de: Ich habe von einem geplanten Anschlag auf die Sultana gehört!
#. fr: Ils préparent un attentat visant la Sultane<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:314:0:1"
msgid "I heard they're plotting<br>an attempt on the<br>sultana's life!"
msgstr "Слышал, они готовят<br>покушение на султану!"

#. ja: 呪術による破壊を…
#. de: Was Thaumaturgie zerstört ...
#. fr: Ce qui est détruit par l'occultisme...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:315:0:1"
msgid "What thaumaturgy<br>destroys..."
msgstr "Что разрушает<br>тауматургия..."

#. ja: 破壊による浄化を…
#. de: ... kann sie auch erschaffen!
#. fr: ... est créé par l'occultisme<nbsp>!
msgctxt "Balloon:316:0:1"
msgid "...thaumaturgy creates!"
msgstr "...то она и создаёт!"

#. ja: そいつはいい…
#. de: Die werden gar nicht merken, wie ihnen geschieht! Hihi!
#. fr: Il ne sauront jamais d'où c'est venu, hé hé hé...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:317:0:1"
msgid "They'll never know<br>what hit them! Tee hee!"
msgstr "Они и не поймут,<br>что их настигло! Хи-хи!"

#. ja: 家ごと破壊してね…
#. de: Ich setze einfach den Feuerspruch ein, sobald sie sich in ihre Kammern zurückgezogen haben.
#. fr: Nous allons brûler cette maison, et eux avec<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:318:0:1"
msgid "I'll cast the Fire spell<br>once they've retired<br>to their chambers!"
msgstr "Подожду, пока они<br>разойдутся по покоям,<br>и пущу в ход «Огонь»!"

#. ja: せいやっ！
#. de: Harharhar!
#. fr: Yaaah<nbsp>! Yaaah<nbsp>!
msgctxt "Balloon:319:0:1"
msgid "Hyah! Hyah! Hyah!"
msgstr "Хья! Хья! Хья!"

#. ja: ウルダハって野蛮ね
#. de: Ein Kampf ohne eine Jagd ... Wie unzivilisiert ...
#. fr: Je ne l'imaginais pas aussi grrrand.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:320:0:1"
msgid "Removing the hunt from<br>battle... How brutish."
msgstr "Убирать охоту из боя...<br>Какая дикость."

#. ja: どこが壊れてるのかしら…
#. de: Aber ich habe die Designvorlage doch genau befolgt ...
#. fr: Il y a quelque chose qui cloche...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:321:0:1"
msgid "But I followed the<br>designs to the letter..."
msgstr "Но я ведь точно<br>следовала чертежам..."

#. ja: さっさと行きな…
#. de: Hier gibt's höchstens ein paar auf die Nase.
#. fr: T'éternise pas ici si tu tiens à ta peau.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:322:0:1"
msgid "Ain't naught fer ye here<br>but a knife in the gut."
msgstr "Уходи отсюда,<br>пока кишки не выпустили."

#. ja: 安い労働者はいないかねぇ
#. de: Nein. Die taugen alle nichts. Viel zu alt.
#. fr: Regarde-moi ces bons à rien...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:323:0:1"
msgid "No. None of these will<br>do. They're all too old."
msgstr "Нет. Эти не годятся.<br>Все слишком старые."

#. ja: 早く行きましょう…
#. de: 早く行きましょう…
#. fr: Vite<nbsp>!
msgctxt "Balloon:324:0:1"
msgid "早く行きましょう…"
msgstr "Пойдёмте скорее..."

#. ja: どうかお恵みを…
#. de: Eine milde Gabe für die Armen!
#. fr: À vot'bon cœur...
msgctxt "Balloon:325:0:1"
msgid "Alms for the poor!"
msgstr "Подайте бедному!"

#. ja: いたた…
#. de: Bitte, <if $gn4>werte Dame<else>mein Herr</if>.<br>Ich kann nicht mal laufen.
#. fr: Je vous en prie, une petite pièce pour manger...
#. macro: <if $gn4>milady<else>milord</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:326:0:1"
msgid "Please, <if $gn4>milady<else>milord</if>.<br>I cannot even walk."
msgstr "Прошу, <if $gn4>миледи<else>милорд</if>.<br>Я даже ходить не могу."

#. ja: く～るくるくる…
#. de: ♪ Ferne Welten vereint,<br>Wunder der Ewigkeit ♪
#. fr: Tourne, tourne...♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:327:0:1"
msgid "Distant worlds together,<br>miracles from realms<br>beyond...♪"
msgstr "Далёкие миры вместе,<br>чудеса из-за пределов<br>нашего мира...♪"

#. ja: トントンよっと…
#. de: Und eins, und zwei, und drei, und vier, und ...
#. fr: Et un, et deux<nbsp>! Et trois, et quatre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:328:0:1"
msgid "One, and two, and<br>three, and four, and..."
msgstr "Раз, два,<br>три, четыре..."

#. ja: う～んほんとね
#. de: Was willst du damit sagen!?
#. fr: Qu'est-ce que tu veux insinuer par là<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:329:0:1"
msgid "What <i>ever</i> are<br>you implying!?"
msgstr "Что ты <i>такое</i><br>хочешь сказать!?"

#. ja: すこし身幅が小さい
#. de: Sitzt sie vielleicht ein wenig eng auf der Hüfte?
#. fr: Ça ne te serre pas trop au niveau de la taille<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:330:0:1"
msgid "Might it feel tight<br>around the middle?"
msgstr "А в талии не жмёт?"

#. ja: 特別に仕立ててもらったの
#. de: Ich habe sie mit Thavnair-Seide besticken lassen.
#. fr: Je l'ai faite broder avec de la soie thavnairoise.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:331:0:1"
msgid "I had it embroidered<br>with Thavnairian silk."
msgstr "Я попросила украсить её<br>тавнайрским шёлком."

#. ja: ステキ～
#. de: Oh, wie wunderschön!
#. fr: Oh, c'est magnifique<nbsp>!
msgctxt "Balloon:332:0:1"
msgid "Oh, how wonderful!"
msgstr "Ой, как чудесно!"

#. ja: こちらは裁縫師ギルドです
#. de: Zur Webergilde geht's hier entlang, <if $gn4>werte Dame<else>mein Herr</if>.
#. fr: La guilde des couturiers est par ici.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <if $gn4>ma'am<else>sir</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "Balloon:333:0:1"
msgid "The Weavers' Guild is<br>this way, <if $gn4>ma'am<else>sir</if>."
msgstr "Гильдия ткачей<br>вон там, <if $gn4>госпожа<else>господин</if>."

#. ja: 情けねぇなぁ！
#. de: Du verträgst genau so wenig wie ein Lala.
#. fr: J't'avais pourtant prévenu, hahaha<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:334:0:1"
msgid "You 'old your drink<br>'bout as good as a Lala."
msgstr "Пьёшь ты, как лалафелл!"

#. ja: うぃ～っ…
#. de: Habe ich ... gewonnen ...?
#. fr: J'abandonne... (rote)
msgctxt "Balloon:335:0:1"
msgid "Did I...win...?"
msgstr "Я... выиграл?.."

#. ja: う～ん…
#. de: Erst, wenn ich es gefunden habe.
#. fr: Qu'est-ce que je cherchais, déjà...<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:336:0:1"
msgid "Won't know what I'm<br>lookin' for till I find it."
msgstr "Пока не найду —<br>не узнаю, что ищу."

#. ja: ふんふ～ん♪
#. de: Weißt du überhaupt, wonach du suchst?
#. fr: Tu sais ce qu'on cherche, au moins<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:337:0:1"
msgid "Do you even know<br>what we're looking for?"
msgstr "Ты хоть знаешь,<br>что мы ищем?"

#. ja: そこの現場が大変でな…
#. de: Ein Sack voller Gil mit deinem Namen drauf, Liebste.
#. fr: J'ai apporté de quoi te faire changer d'avis.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:338:0:1"
msgid "I's a sack o' coin with<br>yer name on it, love."
msgstr "За тебя мешок монет,<br>милая."

#. ja: …ひっく
#. de: Lass mich einfach in Frieden sterben hier ... \<schluck>!
#. fr: Je m'sens pas très bien... (hips)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:339:0:1"
msgid "Jusslemme die<br>herein peece... Ulp!"
msgstr "Дайте мне тут<br>поесть... ик!"

#. ja: 金のチェーンは…
#. de: Wie wäre es mit Goldkettchen?
#. fr: Alors, alors... Voyons voir...
msgctxt "Balloon:340:0:1"
msgid "What about gold chains?"
msgstr "А золотые цепочки?"

#. ja: …ふぅ
#. de: Ich werde niemals damit fertig, oder?
#. fr: J'en verrai jamais le bout...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:341:0:1"
msgid "I'll never finish<br>this, will I?"
msgstr "Я это когда-нибудь<br>закончу?"

#. ja: …話しかけないでね
#. de: Bitte zurücktreten!
#. fr: Laissez-moi, j'ai besoin de me concentrer.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:342:0:1"
msgid "Would you mind<br>stepping back?"
msgstr "Не могли бы вы<br>отойти?"

#. ja: 彫キキキ★ガガ※※
#. de: WilLkOmenn★※～
#. fr: <i>BzzZZtTkr...★◎<br>Bi-bi-BiEeeen★※～</i>
msgctxt "Balloon:343:0:1"
msgid "WeLcOmmmm★※～"
msgstr "ДобРо ПжаЛоВать★※～"

#. ja: 切っ先まで集中しろ！
#. de: Haltet die Schilde hoch!<br>Wie oft denn noch?!
#. fr: Plus haut, les boucliers<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:344:0:1"
msgid "Keep your shields up!<br>Again!"
msgstr "Щиты выше!<br>Ещё раз!"

#. ja: こっちはコロセウムの控え室だ
#. de: Dies ist der Eingang zum Hypogäum.
#. fr: Vous êtes à l'entrée de l'hypogée.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:345:0:1"
msgid "This is the entrance<br>to the hypogeum."
msgstr "Это вход<br>в подземелье."

#. ja: はぁ、はぁ…
#. de: Ich hätte der Webergilde beitreten sollen ...
#. fr: J'aurais mieux fait de rejoindre la guilde des couturiers...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:346:0:1"
msgid "I should have joined<br>the Weavers' Guild..."
msgstr "Надо было вступить<br>в гильдию ткачей..."

#. ja: 肘が下がり過ぎだ
#. de: Hast du überhaupt <i>versucht</i>, ihn zu treffen?!
#. fr: T'as même pas réussi à le toucher<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:347:0:1"
msgid "Did you even<br><i>try</i> to hit him!?"
msgstr "Ты хоть <i>пытался</i><br>в него попасть!?"

#. ja: 早くしないと売り切れだ！
#. de: Unsere Plätze sind so nah am Geschehen, dass man die Action riechen kann!
#. fr: Il ne reste que quelques places, dépêchez-vous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:348:0:1"
msgid "We have seats so close,<br>you can smell the action!"
msgstr "Места у нас такие близкие,<br>что аж запах боя учуешь!"

#. ja: これが名物コロセウムか…
#. de: Also das ist das weltberühmte Kolosseum ...
#. fr: Voilà donc le célèbre Colisée d'Ul'dah...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:349:0:1"
msgid "So this is the world-<br>famous Coliseum..."
msgstr "Так вот он какой,<br>знаменитый Колизей..."

#. ja: いい薬にな～れ…
#. de: Blubber, blubber ...
#. fr: Des bubulles, des bubulles, encore des bubulles.♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:350:0:1"
msgid "Bubble, bubble, toil<br>and...and...and bubble?"
msgstr "Буль-буль, котёл кипит,<br>а я... я... что дальше?"

#. ja: つまりこの配合は…
#. de: Wenn ihr auch nur eine Zutat vergesst, kann das tödlich enden.
#. fr: Un ingrédient en trop ou en moins, et c'est le drame.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:351:0:1"
msgid "Omit even one of the<br>ingredients, and the<br>results would be fatal."
msgstr "Упустишь хоть один<br>ингредиент — и всё<br>закончится смертью."

#. ja: Zzz…
#. de: Aber es muss doch einen Weg geben! Das muss es einfach!
#. fr: Il y a forcément un moyen, je le sais<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:352:0:1"
msgid "But there must<br>be a way! There must!"
msgstr "Но способ же должен<br>быть! Должен!"

#. ja: また実験で夜更かし～？
#. de: Die Alchemie kann dir nicht dabei helfen, deinen Vater zu<shy>rück<shy>zu<shy>brin<shy>gen.
#. fr: Père, même l'alchimie ne pourra pas la faire revenir...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:353:0:1"
msgid "No manner of alchemy<br>can bring her back, Father."
msgstr "Никакая алхимия<br>не вернёт её, отец."

#. ja: 熱はあるのか？
#. de: Wann genau haben diese begonnen?
#. fr: A-t-il de la température<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:354:0:1"
msgid "When, exactly, did<br>these episodes begin?"
msgstr "Когда именно<br>начались эти приступы?"

#. ja: うちの子が風邪ひいちゃって
#. de: Es geht um meinen Sohn. Er hat schlimme nächtliche Anfälle.
#. fr: C'est mon fils, il dort mal, la nuit...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:355:0:1"
msgid "It's my son. He's been<br>having terrible night fits."
msgstr "Это мой сын. У него<br>по ночам страшные<br>приступы."

#. ja: ほんとに～？
#. de: Das meinst du nicht ernst ... oder?!
#. fr: Tu ne ferais pas ça, quand même<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:356:0:1"
msgid "You're surely not<br>serious...are you!?"
msgstr "Ты ведь шутишь... правда!?"

#. ja: 惚れ薬を調合するの！
#. de: Wenn ich ihn nicht mit Worten für mich gewinnen kann, dann vielleicht mit Gift!
#. fr: Puisque c'est comme ça, je vais lui faire boire un philtre d'amour<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:357:0:1"
msgid "If I cannot talk my way<br>into his heart, I'll poison<br>my way into it!"
msgstr "Раз словами его сердце<br>не завоевать, я проберусь<br>туда с помощью яда!"

#. ja: あ、あれ～？
#. de: Wonach suchen wir noch gleich?
#. fr: Cet endroit est si grand<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:358:0:1"
msgid "What was it we were<br>searching for again?"
msgstr "А что мы искали-то?"

#. ja: ここから先は王宮よ
#. de: Welch ein Anliegen sollte Ihre Herrlichkeit wohl mit <if $gn4>einer<else>einem</if> wie dir haben?
#. fr: Tu n'as rien à faire par ici. Ouste<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:359:0:1"
msgid "What business would<br>Her Grace have<br>with the likes of you?"
msgstr "Что её высочеству<br>делать с такими,<br>как ты?"

#. ja: ワシが考えるに…
#. de: Wenn du mich fragst, dann sollten wir sie in die Höllen jagen!
#. fr: Ne perds pas ton temps avec ça...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:360:0:1"
msgid "If you ask me, I say<br>to the hells with them!"
msgstr "По мне, так пусть<br>катятся к чертям!"

#. ja: 金、くれねえか？
#. de: Haben Sie vielleicht einen Gil übrig für einen armen Mann, <if $gn4>werte Dame<else>werter Herr</if>?
#. fr: L'aumône, par pitié...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <if $gn4>miss<else>sir</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "Balloon:361:0:1"
msgid "Might ye spare a poor<br>man some coin, <if $gn4>miss<else>sir</if>?"
msgstr "Не подадите бедняку<br>монетку, <if $gn4>мисс<else>сэр</if>?"

#. ja: できるだけ水で薄めよう
#. de: Was hast du denn in diesem Topf? Es duftet himmlisch!
#. fr: Qu'y a-t-il dans ce pot<nbsp>? Ça sent divinement bon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:362:0:1"
msgid "What ever do you have<br>in that pot? It smells<br>absolutely heavenly!"
msgstr "Что у вас там в горшке?<br>Пахнет просто божественно!"

#. ja: ざまぁみろ！
#. de: ざまぁみろ！
#. fr: Prends ça<nbsp>!
msgctxt "Balloon:363:0:1"
msgid "ざまぁみろ！"
msgstr "Так тебе и надо!"

#. ja: あ？　お前はすっこんでろ！
#. de: あ？　お前はすっこんでろ！
#. fr: Tire-toi de là<nbsp>!
msgctxt "Balloon:364:0:1"
msgid "あ？　お前はすっこんでろ！"
msgstr "А? Проваливай отсюда!"

#. ja: テメーは関係ねぇんだよ
#. de: テメーは関係ねぇんだよ
#. fr: Ça t'regarde pas<nbsp>!
msgctxt "Balloon:365:0:1"
msgid "テメーは関係ねぇんだよ"
msgstr "Тебя это не касается."

#. ja: ハッ、隊長殿！
#. de: ハッ、隊長殿！
#. fr: Oui, cap'taine<nbsp>!
msgctxt "Balloon:367:0:1"
msgid "ハッ、隊長殿！"
msgstr "Так точно, капитан!"

#. ja: お前もそう思う？
#. de: Die Erzausbeute soll sich verdoppelt haben ... Dafür gibt es aber auch mehr tote Minenarbeiter.
#. fr: La production de minerai augmente, mais les décès de mineurs aussi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:368:0:1"
msgid "I hear ore yields have<br>increased twofold...but<br>so have miner deaths."
msgstr "Говорят, руды стали<br>добывать вдвое больше...<br>И шахтёров гибнет тоже."

#. ja: 鉱石の量増えすぎじゃね？
#. de: Die Zeiten sind hart. Viele Männer arbeiten bis zu zwanzig Glocken am Stück.
#. fr: Les temps sont durs, il faut travailler de longues heures pour se payer un peu de pain...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:369:0:1"
msgid "Times are harsh.<br>A man'll work twenty<br>bells straight if it<br>means food in his belly."
msgstr "Времена тяжёлые.<br>Мужик и двадцать часов<br>без передышки вкалывать<br>будет, лишь бы поесть."

#. ja: そうは言われましても…
#. de: Möglich. Wenn sie einen <i>Anreiz</i> dazu hätten.
#. fr: Si vous les payiez un peu plus grassement...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:370:0:1"
msgid "Perhaps. If they had<br>a little more <i>incentive</i>."
msgstr "Может быть. Если бы<br>у них был получше<br><i>стимул</i>."

#. ja: もっと早くできないのか？
#. de: Können deine Männer sich nicht schneller bewegen?
#. fr: Vos hommes sont de véritables tire-au-flanc<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:372:0:1"
msgid "Can your men not<br>move any faster?"
msgstr "Твои люди не могут<br>пошевеливаться быстрее?"

#. ja: じゃ、頼んだよ
#. de: Hm, die Märkte? Oder die Gold<shy>schmiede<shy>gilde? Oder vielleicht die Bucht des Abendsterns?
#. fr: Était-ce aux marché, à la guilde des orfèvres ou dans la baie des Vêpres<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:374:0:1"
msgid "Was it the markets? Or<br>the Goldsmiths' Guild?<br>Or maybe Vesper Bay?"
msgstr "Это был рынок? Или<br>гильдия золотых дел мастеров?<br>Или, может, бухта Веспер?"

#. ja: 足りない…またキキルンか？
#. de: 7 ... 8 ... 9 ... Verdammt!<br>Das müssen wieder diese verlausten Rattendiebe gewesen sein!
#. fr: Sept, huit, neuf... Par Thal<nbsp>! Satanés Qiqirns...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:375:0:1"
msgid "7...8...9... Thal's balls!<br>It must be those<br>damn rat-thieves again!"
msgstr "Семь... восемь... девять...<br>Таловы яйца! Опять эти<br>проклятые крысы-воришки!"

#. ja: 冒険者か…
#. de: Noch ein Abenteurer?<b>Du kannst passieren.
#. fr: Tu peux passer.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:377:0:1"
msgid "Another adventurer?<br>You may pass."
msgstr "Ещё один искатель приключений?<br>Можешь проходить."

#. ja: 大きくな～れ♪
#. de: Ob es wohl jemand merken würde, wenn ich einen davon mitgehen ließe?
#. fr: Hop<nbsp>! sous la chemise. Ni vu, ni connu<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:379:0:1"
msgid "I wonder if they'd<br>notice if I slipped one<br>of these under my tunic."
msgstr "Интересно, заметят ли,<br>если я одну под тунику<br>припрячу?"

#. ja: 西方、異常あり！！
#. de: Im Westen nichts Neues!
#. fr: Ennemis repérés à l'ouest<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:380:0:1"
msgid "Enemies on the<br>western front!"
msgstr "На западе враги!"

#. ja: は～い、お水ですよ～♪
#. de: Trinkt schön, meine Lieben!
#. fr: Buvez, mes chéries<nbsp>! C'est pour votre bien<nbsp>!
msgctxt "Balloon:381:0:1"
msgid "Drink up, my dears!"
msgstr "Пейте, мои хорошие!"

#. ja: それでね…
#. de: Also habe ich's abgeschnitten und in den See geworfen!
#. fr: Je lui ai coupé la tête avant de le jeter dans le lac<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:382:0:1"
msgid "And so I sliced it off<br>and tossed it in the lake!"
msgstr "Ну я и отрезала её,<br>а потом бросила в озеро!"

#. ja: 西方、異常なし
#. de: Alles ruhig im Westen.
#. fr: Rien de nouveau à l'ouest.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:383:0:1"
msgid "All's clear on<br>the western front."
msgstr "На западе всё чисто."

#. ja: もーちょっとー
#. de: N-Nur n-noch ein Bescha, kleina Mann! \<hicks>
#. fr: Allez, juste un dernier verre... (hips)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:384:0:1"
msgid "Jussone more cupp,<br>littlemann! Hic!"
msgstr "Ещё одну кружечку,<br>маленький человечек! Ик!"

#. ja: もー、早く行くぞ！
#. de: Beweg deinen betrunkenen Hintern und mach dich fertig!
#. fr: Assez lambiné, il faut y aller maintenant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:385:0:1"
msgid "Get off your drunken<br>arse and make ready!"
msgstr "Хватит валяться пьяным,<br>собирайся!"

#. ja: 1杯10ギル！
#. de: Wie sieht's aus, mein Freund? Nur zehn Gil pro Glas!
#. fr: Dix gils la bouteille<nbsp>! Qu'en dis-tu<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:386:0:1"
msgid "What do you say,<br>friend? Ten gil a pull!"
msgstr "Ну что, дружище?<br>По десять гил за глоток!"

#. ja: お腹すいた…
#. de: Ein leckerer Eintopf nach Steinwurf-Art, wohl bekommt's!
#. fr: Du ragoût de coccinelle et de marmotte...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:387:0:1"
msgid "Some of Stonesthrow's<br>extra-special stew, sir!"
msgstr "Особое рагу из Камнемёта,<br>сэр! Приятного аппетита!"

#. ja: オラ！有名に！なるだ！
#. de: Wenn etwas erschlagen werden muss, bin ich genau der Richtige.
#. fr: Personne peut me battre<nbsp>! Yaaah<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:388:0:1"
msgid "If it needs killin', I'm yer<br>man. Fer a price, that is."
msgstr "Надо кого прибить —<br>я ваш человек. За плату, ясное дело."

#. ja: …仕事くれ
#. de: Hast du Arbeit für mich? Ich kann ziemlich gut mit 'ner Axt umgehen.
#. fr: Y a du boulot<nbsp>? Ma hache me démange...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:389:0:1"
msgid "You got any work? I'm<br>quite handy with an axe."
msgstr "Работа найдётся? Я<br>с топором управляться умею."

#. ja: もう、夢も希望も…
#. de: Lass mich zufrieden ...
#. fr: Il n'y a plus d'espoir...
msgctxt "Balloon:390:0:1"
msgid "Just leave me be..."
msgstr "Оставьте меня..."

#. ja: いただきますよーっと
#. de: Hehe. Das wird er nicht brauchen.
#. fr: On n'aura pas besoin de ça, héhéhé...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:391:0:1"
msgid "Heh heh. He won't<br>be needin' this."
msgstr "Хе-хе. Ему это<br>уже не понадобится."

#. ja: …Ｚｚｚ…
#. de: Zzz ...
#. fr: Zzz...
msgctxt "Balloon:393:0:1"
msgid "Zzz......"
msgstr "Ззз......"

#. ja: …ごほんごほん
#. de: So ... hungrig ...
#. fr: J'ai si faim...
msgctxt "Balloon:394:0:1"
msgid "So...hungry..."
msgstr "Так... есть хочется..."

#. ja: なるほど…
#. de: Ich habe dich <i>nicht</i> gefragt!
#. fr: Je ne t'ai rien demandé, que je sache.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:395:0:1"
msgid "I <i>wasn't</i> asking you..."
msgstr "Я тебя <i>не</i> спрашивал..."

#. ja: まだかなぁ～
#. de: Gab es keine besseren Plätze? Ich kann nichts sehen von hier!
#. fr: Qu'est-ce qu'ils attendent pour commencer<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:396:0:1"
msgid "Were there no better<br>seats? I can't see a thing!"
msgstr "Мест получше не нашлось?<br>Ничего же не видно!"

#. ja: またナナワ銀山？
#. de: Ha! Du könntest dir mich nicht leisten, du lausiger Dummkopf.
#. fr: Hahaha<nbsp>! Je ne pense pas que tu aies les moyens.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:397:0:1"
msgid "Hah! You couldn't afford<br>me, you poxy-arsed fool."
msgstr "Ха! Тебе меня не потянуть,<br>жалкий кретин!"

#. ja: ピカピカ◎彫金師ギルド☆デス
#. de: WiLlKoMmEn★In★DeR<br>gOlDsChMiEdEgIlDe!
#. fr: <i>Bzzz...★◎<br>Bienvenue à la guilde ☆●des orfèvres<nbsp>!</i>
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:398:0:1"
msgid "WeLcOmE★tO★tHe<br>GoLdSmItHs'★gUiLd!"
msgstr "ДоБрО пОжаЛоВаТь★в★<br>гиЛьДиЮ★юВеЛиРоВ!"

#. ja: よくできとるな…
#. de: Blinzeln die Dinger eigentlich nie!?
#. fr: Ces machines sont des merveilles de technologie.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:399:0:1"
msgid "Don't these contrap-<br>tions ever blink!?"
msgstr "Эти штуки хоть<br>когда-нибудь моргают!?"

#. ja: ここから先は政庁層だ
#. de: Die Ebene der Redner ist da oben.
#. fr: Le district politique se trouve au-dessus d'ici.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:400:0:1"
msgid "The Hustings Strip<br>lies above."
msgstr "Площадь Хастингс<br>наверху."

#. ja: まぁ、いいじゃない
#. de: Haben wir denn eine andere Wahl?
#. fr: Il n'y a pas d'autre choix...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:401:0:1"
msgid "What other choice<br>do we have?"
msgstr "А что нам ещё остаётся?"

#. ja: 東アルデナード商会が…
#. de: Die Ostaldenard-<br>Handelsgesellschaft!?<br>Niemals!
#. fr: La Firme du commerce de l'Aldenard oriental<nbsp>? Hors de question<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:402:0:1"
msgid "The East Aldenard<br>Trading Company!? Never!"
msgstr "Торговая компания<br>Восточного Альденарда!? Ни за что!"

#. ja: 仕入れを急いだほうがいい
#. de: Du musst die Ver<shy>gangen<shy>heit ruhen lassen.
#. fr: Il est temps de mettre nos différends de côté.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:403:0:1"
msgid "You must put past<br>differences aside."
msgstr "Пора оставить<br>старые распри позади."

#. ja: そしたら召使いがなぁ…
#. de: Dann rannte sie aus der Kammer des Lords und trug nur noch ihr Höschen!
#. fr: Puis elle est sortie de la chambre du seigneur en courant, couverte d'un simple drap<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:404:0:1"
msgid "And she ran out of the<br>lord's chambers wearing<br>naught but her knickers!"
msgstr "А потом она выскочила<br>из покоев лорда —<br>в одних трусиках!"

#. ja: ウフフ
#. de: Dieses neue Hausmädchen!? Nicht zu fassen!
#. fr: La nouvelle servante<nbsp>!? Non, vraiment<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:405:0:1"
msgid "That new maidservant!?<br>No! Truly?"
msgstr "Новая служанка!?<br>Да ну, правда?"

#. ja: しばらく帰れないんだ
#. de: Ich kann nicht heimkehren. Nicht jetzt, wo ich so kurz vorm Ziel stehe!
#. fr: Je ne peux pas abandonner maintenant...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:406:0:1"
msgid "I cannot return home.<br>Not when I'm so close!"
msgstr "Не могу вернуться домой.<br>Я ведь почти у цели!"

#. ja: 調合はもっと慎重に！
#. de: Pass auf, dass du die Reagenzien nicht zu sehr stimulierst!
#. fr: Attention à ne pas trop stimuler les réactifs<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:407:0:1"
msgid "Be careful not to over-<br>stimulate the reagents!"
msgstr "С реактивами осторожнее!<br>Не перевозбуди их!"

#. ja: ふむふむ…
#. de: Können wir dieses Wasser nicht benutzen?
#. fr: On va vraiment utiliser cette eau<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:408:0:1"
msgid "Can we not<br>use this water?"
msgstr "Разве нельзя<br>использовать эту воду?"

#. ja: フーン
#. de: Aber das wird nicht billig!
#. fr: Cela va vous coûter cher<nbsp>!
msgctxt "Balloon:409:0:1"
msgid "But it'll cost you!"
msgstr "Но это тебе дорого обойдётся!"

#. ja: ふーん
#. de: Vielleicht finden wir da was für Sie ...
#. fr: Peut-être que dans cette petite boutique...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:410:0:1"
msgid "Might be we<br>could find you one..."
msgstr "Может, здесь<br>и найдётся для тебя такая..."

#. ja: 大きなルビーの原石がね…
#. de: Ich möchte einen Rubin kaufen ... einen <i>großen</i> Rubin.
#. fr: Je cherche un rubis... au moins gros comme le pouce.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:411:0:1"
msgid "I'm looking to buy a<br>ruby...a <i>large</i> ruby."
msgstr "Я ищу рубин... <i>крупный</i><br>такой рубин."

#. ja: 見回りに行くか
#. de: Du bist an der Reihe mit Patrouillieren!
#. fr: À ton tour de monter la garde<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:412:0:1"
msgid "It's your turn to<br>make the rounds!"
msgstr "Твоя очередь<br>обойти посты!"

#. ja: だからお前は…
#. de: Bei den Zwölf! Kein Mann hat solch ein Schicksal verdient.
#. fr: Par les Douze<nbsp>! Personne ne mérite une fin aussi horrible...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:413:0:1"
msgid "Twelve be good! No<br>man deserves <i>that</i> fate."
msgstr "Боги милостивые! Никто<br>не заслужил <i>такой</i> участи."

#. ja: 獣くせぇな、この酒…
#. de: Bah, das Zeug schmeckt wie Spitzmauspisse!
#. fr: Ce truc pue l'bouc<nbsp>!
msgctxt "Balloon:414:0:1"
msgid "This ale reeks of rat!"
msgstr "От этого эля крысиным духом несёт!"

#. ja: ち、ちょっと待とうか…
#. de: Vielleicht lieber noch 'n bisschen warten ...
#. fr: Attendons de voir ce qui se passe...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:415:0:1"
msgid "Why don't we wait out<br>here a moment longer?"
msgstr "Может, подождём<br>ещё немного здесь?"

#. ja: いたた…
#. de: Habt Erbarmen, <if $gn4>werte Dame<else>mein Herr</if>. Ich bitte doch nur um eine Milchwurzel.
#. fr: Pitié, juste quelques pousses de tuberculait...
#. macro: <if $gn4>milady<else>milord</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:416:0:1"
msgid "Have mercy, <if $gn4>milady<else>milord</if>.<br>Some somnus's all I ask."
msgstr "Сжальтесь, <if $gn4>госпожа<else>господин</if>.<br>Мне бы только сон-травы."

#. ja: …げほげほ
#. de: \<hust> \<hust>
#. fr: (tousse) (tousse)
msgctxt "Balloon:417:0:1"
msgid "\\<cough> \\<cough>"
msgstr "<i>Кхе-кхе!</i>"

#. ja: お願いします
#. de: Schauen Sie sich nur um, <if $gn4>meine Dame<else>mein Herr</if>! Sie werden es nicht bereuen!
#. fr: Je vous en prie, <if $gn4>ma bonne dame<else>Monseigneur</if>...
#. macro: <if $gn4>lady<else>sir</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:418:0:1"
msgid "Have a look, good <if $gn4>lady<else>sir</if>!<br>You won't regret it!"
msgstr "Поглядите, <if $gn4>госпожа<else>сударь</if>!<br>Не пожалеете!"

#. ja: 仕事欲しいなぁ…
#. de: Zwanzig Gil und ich tue alles, was Ihr wollt.
#. fr: Je ferai tout ce que vous voudrez contre vingt gils...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:419:0:1"
msgid "Twenty gil, and I'll<br>do whatever you want."
msgstr "Двадцать гил — и я<br>сделаю всё, что скажешь."

#. ja: 無理よ、絶対
#. de: Und dafür die Sklavin eines fetten Händlers werden? Da verhungere ich lieber!
#. fr: Tout mais pas ça<nbsp>! Je préfère encore rester ici le ventre vide...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:421:0:1"
msgid "And be some fat<br>merchant's slave?<br>I'd rather starve!"
msgstr "И стать рабыней<br>какого-нибудь жирного<br>торгаша? Уж лучше с голоду помру!"

#. ja: ウルダハで仕事を探せば…
#. de: Ich habe gehört, dass Leute gute Gil für Hausmädchen bezahlen.
#. fr: Tu pourrais travailler comme servante pour une famille riche d'U'ldah...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:422:0:1"
msgid "I hear patrons pay good<br>coin for live-in maids."
msgstr "Слыхала, за хорошую монету<br>нанимают служанок с проживанием."

#. ja: ここは、ブラックブラッシュだ
#. de: Achtet auf die Gleise, sonst werden wir von dem Eisenbiest zerquetscht.
#. fr: Dégage des rails si tu veux pas te faire broyer par le monstre d'acier.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:424:0:1"
msgid "Mind the tracks, lest<br>you be crushed by the<br>iron beast."
msgstr "Смотри под ноги, а то<br>железная тварь тебя<br>раздавит."

#. ja: はいはい…
#. de: Wo sollte das noch mal hin? Ich hab nicht den ganzen Tag Zeit.
#. fr: Où j'dois poser ça<nbsp>? J'ai pas toute la journée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:425:0:1"
msgid "Where'd you want this<br>again? I haven't all day."
msgstr "Куда это поставить?<br>Мне некогда тут торчать."

#. ja: お腹をすかせた子が…
#. de: Bitte! Mein Sohn hat seit zwei Tagen nichts gegessen.
#. fr: Je vous en prie<nbsp>! Mon fils n'a pas mangé depuis deux jours...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:426:0:1"
msgid "Please! My son...he<br>hasn't eaten in two days."
msgstr "Прошу! Сынок... он<br>уже два дня ничего не ел."

#. ja: おう、金はあんのかい？
#. de: Sag nicht, du hast Geld!
#. fr: J'teste ré<shy>gu<shy>liè<shy>re<shy>ment l'produit pour m'assurer d'sa qualité<nbsp>! (hips)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:428:0:1"
msgid "Tessme s'pply reggarly<br>t'ssure quality, I do. Hic!"
msgstr "Я товарчик регулярно пробую,<br>чтоб качество проверить. Ик!"

#. ja: 古傷が痛むんだ
#. de: Meine Beine fühlen sich schwer an. Wie wär's wenn du sie ein bisschen auflockern hilfst?
#. fr: J'ai de ces crampes... Tu veux bien m'aider à m'étirer<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:429:0:1"
msgid "Me thigh muscles are<br>right sore. How 'bout<br>ye help loosen 'em up?"
msgstr "Ноги-то у меня<br>разболелись. Может,<br>разомнёшь их?"

#. ja: 買ってけ買ってけ
#. de: Wir haben alles, von dem Sie nicht wussten, dass Sie es brauchen!
#. fr: Tout ce que vous ne cherchez pas, nous l'avons<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:430:0:1"
msgid "We've everything you<br>didn't think you needed!"
msgstr "У нас есть всё,<br>о чём ты и не знал, что тебе нужно!"

#. ja: …ハラヘッタ
#. de: Hm? Hätten Sie wohl Interesse an ... Ach, schon gut.
#. fr: Je donnerais tout pour un morceau de pain...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:431:0:1"
msgid "Hm? Can I, uh, interest<br>you in a... Oh, never mind..."
msgstr "А? Может, вам... это...<br>А, да ну, неважно..."

#. ja: いつもそう…
#. de: Wie wär's, wenn ich die Zähne in deinem dreckigen Mundwerk etwas lockere?
#. fr: Et puis quoi encore<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:433:0:1"
msgid "How about I help loosen<br>them teeth from that<br>filthy gob o' yours?"
msgstr "А может, я тебе зубы<br>повышибаю из твоей<br>поганой пасти?"

#. ja: ここは、都市ウルダハだぜ
#. de: Willkommen in Ul'dah. Ich hoffe, du hast einen dicken Gilbeutel dabei.
#. fr: Bienvenue à Ul'dah. J'espère que votre bourse est bien remplie.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:434:0:1"
msgid "Welcome to Ul'dah.<br>I hope you brought a<br>fat purse."
msgstr "Добро пожаловать в Ульду.<br>Надеюсь, кошелёк у тебя<br>толстый."

#. ja: よう、おかえり
#. de: Mach hier keinen Blödsinn! Sonst ziehe ich dir das Fell über die Ohren.
#. fr: Reste tranquille ou tu auras affaire à moi.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:435:0:1"
msgid "Don't try anything, or I'll<br>skin ye and throw the<br>rest in our cookpots."
msgstr "Не вздумай тут шалить, а то<br>содеру с тебя шкуру, а остатки<br>брошу в котёл!"

#. ja: よっ…
#. de: \<grunz>
#. fr: (grogne)
msgctxt "Balloon:436:0:1"
msgid "\\<grunt>"
msgstr "<i>Хн!</i>"

#. ja: また実験失敗したの？
#. de: Du hast die Synthese schon wieder versaut, wie?
#. fr: T'as encore raté ton expérience<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:437:0:1"
msgid "Botch the synthesis<br>again, did you?"
msgstr "Опять синтез запорол?"

#. ja: さあいらっしゃい！
#. de: Sucht Ihr nach Fellen? Oder vielleicht nach Seide?
#. fr: Cherchez-vous de la peau ou des étoffes<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:438:0:1"
msgid "Is it skins you seek?<br>Or perhaps silks?"
msgstr "Шкуры ищете?<br>Или, может, шёлк?"

#. ja: 安売りだ！
#. de: Vier Tote in der Perlengasse! Unfall oder Mord? Lesen Sie hier alles!
#. fr: Quatre corps trouvés dans la rue de la Perle<nbsp>! Crime ou accident<nbsp>? Lisez tous les détails<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:439:0:1"
msgid "Four found dead on<br>Pearl Lane! Accident or<br>foul play!? Read it here!"
msgstr "На Жемчужной улице<br>нашли четверых мёртвыми!<br>Несчастный случай или убийство? Читайте!"

#. ja: そろそろ帰ろうかしらね
#. de: Ich hab dir doch gesagt, ich bin <i>nicht</i> deine Mami!
#. fr: Encore un peu de patience, ton père arrive bientôt.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:440:0:1"
msgid "I told you, I'm<br><i>not</i> your mummy!"
msgstr "Я же сказала,<br>я тебе <i>не</i> мамочка!"

#. ja: ママ疲れたー
#. de: Mami, ich bin müde!
#. fr: Maman, je suis fatigué<nbsp>!
msgctxt "Balloon:441:0:1"
msgid "Mummy, I'm tired!"
msgstr "Мам, я устал!"

#. ja: ちょっと休んでいくか
#. de: Diese Hitze ist unerträglich!
#. fr: Quelle chaleur étouffante<nbsp>!
msgctxt "Balloon:442:0:1"
msgid "This heat is unbearable!"
msgstr "Какая невыносимая жара!"

#. ja: えーと、あとは…
#. de: Bring mir deine beste Flasche Rotwein!
#. fr: Deux bouteilles de rouge<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:443:0:1"
msgid "Bring me your best<br>bottle of sour red!"
msgstr "Налейте мне лучшего<br>кислого красного!"

#. ja: ふぃ～
#. de: Und ein Mann kann nicht mit trockener Kehle arbeiten.
#. fr: J'peux pas travailler la gorge sèche.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:444:0:1"
msgid "And a man cannot<br>work with his throat dry."
msgstr "А с пересохшим горлом<br>разве поработаешь?"

#. ja: クズ石の処分かぁ
#. de: Womit habe ich nur diese Drecksarbeit verdient?
#. fr: Qu'est-ce que j'ai fait pour me retrouver avec le sale boulot<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:445:0:1"
msgid "What'd I ever do to get<br>stuck with slag duty?"
msgstr "Чем я провинился,<br>что мне досталась эта отработка с пустой породой?"

#. ja: めんどうだなぁ
#. de: Hm, du hast dich immerhin an die Tochter des Vorarbeiters rangemacht.
#. fr: T'as flirté avec la fille du contremaître, voilà ce que t'as fait<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:446:0:1"
msgid "Got caught fondlin' the<br>foreman's daughter is<br>what you did."
msgstr "Вот и нечего было лапать<br>дочку бригадира!"

#. ja: 鉱石詰めすぎだろっ！
#. de: Bei den Sieben Höllen! Hätten sie die Kiste nicht noch voller machen können!?
#. fr: Qui est l'idiot qui a rempli cette caisse<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:448:0:1"
msgid "Seven hells! You think<br>the boys could've filled<br>this crate any fuller!?"
msgstr "Семь адов! Они что,<br>ещё больше руды в ящик<br>запихать не могли?!"

#. ja: 使える部分次第だなぁ
#. de: Ja, aber wie sieht's mit seiner Reinheit aus?
#. fr: Qu'en est-il de sa pureté<nbsp>? Je ne me ferai pas avoir deux fois.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:449:0:1"
msgid "Yes, but what of its<br>purity? I won't be had twice."
msgstr "Да, но что насчёт чистоты?<br>На этот раз меня не проведёшь."

#. ja: 凄く大きい銀鉱よ
#. de: Das ist der größte Brocken Silber, den du je gesehen hast.
#. fr: Vous ne verrez jamais un morceau de minerai d'argent aussi gros<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:450:0:1"
msgid "'Tis the largest chunk of<br>silver ore you've seen."
msgstr "Такого большого куска<br>серебряной руды ты ещё не видел!"

#. ja: うんしょっ…と
#. de: Kann man Flusswasser mit Rattenfell „Eintopf“ nennen?
#. fr: (Si on peut appeler ça du ragoût...)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:451:0:1"
msgid "(If you call river water<br>and rat pelts “stew.”)"
msgstr "(Если, конечно, можно<br>назвать похлёбкой речную воду<br>с крысиными шкурами.)"

#. ja: そこで俺の斧がズバッと！
#. de: Und dann habe ich es mit einem Schwung geköpft!
#. fr: Et là, je lui ai tranché la tête d'un seul coup<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:454:0:1"
msgid "And I took off its head<br>with one fell swing!"
msgstr "А я одним махом<br>снёс ему голову!"

#. ja: へっぴり腰のくせに…
#. de: Hahaha! Ich hätte nicht anstelle dieses Baumhörnchens sein wollen.
#. fr: Hahaha<nbsp>! Je n'aurais pas aimé être à la place de ce pauvre écureuil<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:455:0:1"
msgid "Hahaha! I'd hate<br>to be that squirrel."
msgstr "Ха-ха-ха! Не хотел бы я<br>оказаться на месте той белки."

#. ja: そうだな…
#. de: Ich schon wieder!?<br>Aber ich bin doch gerade erst zurückgekommen!
#. fr: Déjà<nbsp>!? Mais je viens tout juste de prendre ma pause<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:457:0:1"
msgid "My turn!?<br>I just got back!"
msgstr "Опять моя очередь?!<br>Я же только вернулся!"

#. ja: すごいすごい！
#. de: Na los! Noch 5.000 und du hast meinen Rekord gebrochen!
#. fr: Encore cinq cents et tu battras mon record<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:459:0:1"
msgid "Only 5,000 more and<br>you'll break my record!"
msgstr "Ещё пять тысяч — и побьёшь<br>мой рекорд!"

#. ja: ムグムグ…
#. de: Ich war nicht mehr so hungrig seit ... seit gestern!
#. fr: Je n'ai pas eu aussi faim depuis au moins... deux jours<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:460:0:1"
msgid "I ain't been so hungry<br>since...since yesterday!"
msgstr "Я так не голодал<br>со вчерашнего дня!.."

#. ja: まだまだっ！
#. de: Stirb, fieser Feind!
#. fr: Meurs, vermine<nbsp>!
msgctxt "Balloon:462:0:1"
msgid "Die, fiery fiend!"
msgstr "Сдохни, огненный демон!"

#. ja: 実戦でできればねぇ…
#. de: Wenn doch nur alle unsere Opfer so ... unbeweglich wären.
#. fr: Si seulement tes ennemis étaient aussi... immobiles.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:463:0:1"
msgid "If only all your victims<br>were this...stationary."
msgstr "Вот бы все твои жертвы<br>были такими... неподвижными."

#. ja: す、すみません…
#. de: Ich bin so schnell gekommen wie ich konnte, Herr!
#. fr: Je suis venu aussi vite que j'ai pu, Monsieur.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:464:0:1"
msgid "I came as quickly<br>as I could, sir!"
msgstr "Я прибежал так быстро,<br>как только мог, сэр!"

#. ja: これだから冒険者は
#. de: Ich bezahl dich nicht fürs Faulenzen, Junge! Hoch mit dir!
#. fr: Je ne te paye pas pour lambiner<nbsp>! Allez, debout<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:465:0:1"
msgid "I don't pay you to rest,<br>boy! Back on your feet!"
msgstr "Я тебе не за отдых плачу,<br>парень! А ну, на ноги!"

#. ja: いい話が…
#. de: Ich habe gehört, mit Relikten aus dem Tal der Spuren seien gute Gil zu machen.
#. fr: Il paraît qu'on peut faire fortune en vendant des reliques de la vallée des Pas perdus...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:466:0:1"
msgid "I hear there's good coin<br>to be made selling relics<br>from the Footfalls."
msgstr "Слыхал, на продаже реликвий<br>из долины Следов можно<br>неплохо заработать."

#. ja: 本当か？
#. de: Aber die Leute sagen, dieser Ort sei verflucht!
#. fr: Mais... cet endroit est maudit<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:467:0:1"
msgid "But they say that<br>place is cursed!"
msgstr "Но говорят, это место<br>проклято!"

#. ja: この先はウルダハ都市内だ
#. de: Wenn du nicht weißt, wo du bist, solltest du nicht hier sein, <if $gn4>Reisende<else>Reisender</if>.
#. fr: Tu n'as rien à faire ici, aventuri<if $gn4>ère<else>er</if>.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:468:0:1"
msgid "If you don't know where<br>you are, you shouldn't<br>be here, traveler."
msgstr "Раз не знаешь, где ты,<br>тебе здесь не место, путник."

#. ja: 騒ぎを起こすなよ
#. de: Weitergehen!
#. fr: Circulez<nbsp>!
msgctxt "Balloon:469:0:1"
msgid "Move along."
msgstr "Проходи."

#. ja: 東回りでいくか
#. de: Ich sage, wir gehen nach Osten!
#. fr: C'est vers l'est<nbsp>!
msgctxt "Balloon:470:0:1"
msgid "I say we go east!"
msgstr "Я говорю, пойдём на восток!"

#. ja: 西回りにしよう
#. de: Ich sage, wir gehen nach Westen!
#. fr: Mais non, vers l'ouest<nbsp>!
msgctxt "Balloon:471:0:1"
msgid "I say we go west!"
msgstr "Я говорю, пойдём на запад!"

#. ja: 未使用
#. de: Ich sage, wir gehen zurück!
#. fr: Et si on retournait en arrière<nbsp>?
msgctxt "Balloon:472:0:1"
msgid "未使用"
msgstr "未使用"

#. ja: 仕事の邪魔はするなよ
#. de: Bleib lieber vom Tor weg, sonst wirst du noch von Chocobos überrannt.
#. fr: Ne reste pas sur le passage ou tu vas te faire renverser par un chocobo.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:473:0:1"
msgid "Stand clear of the gate,<br>or you'll find yourself<br>under a chocobo's talons."
msgstr "Отойди от ворот,<br>а то попадёшь под копыта чокобо."

#. ja: 街で一杯やりたいぜ
#. de: Eines Tages, Ul'dah.<br>Eines Tages.
#. fr: Ul'dah sera toujours Ul'dah...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:474:0:1"
msgid "One day, Ul'dah.<br>One day."
msgstr "Вот однажды, Ульда...<br>Вот однажды."

#. ja: 街道を行くとシルバーバザーよ
#. de: Südlich führt der Sonnenweg zum Silberbasar, nördlich nach Horizont.
#. fr: Suis la voie allagoise du Soleil vers le nord et tu trouveras le Bazar argenté.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:475:0:1"
msgid "Follow the Sunway<br>south to the Silver<br>Bazaar, north to Horizon."
msgstr "Иди по Солнечному тракту:<br>на юг — к Серебряному базару,<br>на север — к Горизонту."

#. ja: ラプトル運送だ！
#. de: Alles muss raus!
#. fr: Tout doit disparaître<nbsp>!
msgctxt "Balloon:476:0:1"
msgid "Everything must go!"
msgstr "Всё распродаём!"

#. ja: よし…よしっと
#. de: Vier Kisten, alle randvoll mit Erz ... Trag die hier ...
#. fr: Étrange, j'ai beau vérifier, le compte n'y est pas...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:477:0:1"
msgid "Four coffers, each<br>containing 63 ponzes<br>of ore... Carry the one..."
msgstr "Четыре сундука, в каждом<br>по шестьдесят три понзе руды...<br>А ну-ка, тащи этот..."

#. ja: 腹へってきたな
#. de: Du hast nicht zufällig einen warmen Kuchen dabei, oder?
#. fr: Vous n'auriez pas une part de tarte pour moi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:478:0:1"
msgid "Don't happen to have<br>a hot pie on you, do you?"
msgstr "У тебя случайно нет<br>горячего пирога?"

#. ja: 街道の様子は…
#. de: Der Sonnenweg ist sicher!
#. fr: La voie allagoise du Soleil est libre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:479:0:1"
msgid "The Royal Sunway<br>is clear!"
msgstr "Королевский Солнечный тракт<br>свободен!"

#. ja: 未使用480
#. de: Kweeeh?
#. fr: Kwééé<nbsp>?
msgctxt "Balloon:480:0:1"
msgid "未使用480"
msgstr "未使用480"

#. ja: 未使用481
#. de: Ja, aber wie schaut's mit unseren Profiten aus?
#. fr: Y gagne-t-on vraiment...<nbsp>?
msgctxt "Balloon:481:0:1"
msgid "未使用481"
msgstr "未使用481"

#. ja: 未使用482
#. de: Wenn die Dame Sonnenzitronen wünscht, dann besorgst du ihr Sonnenzitronen!
#. fr: Si elle veut des citrons soleil, tu lui achètes des citrons soleil<nbsp>!
msgctxt "Balloon:482:0:1"
msgid "未使用482"
msgstr "未使用482"

#. ja: えっ、こんなに頼んだか？
#. de: Ich kann mich nicht dran erinnern, so viele Lalafell-Linsen bestellt zu haben!
#. fr: Je ne me rappelle pas avoir commandé autant de lentilles lalafelles<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:483:0:1"
msgid "I do not recall ordering<br>this many Lalafellin lentils!"
msgstr "Не припомню, чтобы я<br>заказывал столько чечевицы по-лаллафельски!"

#. ja: どうぞご利用を！
#. de: Die Preise werden bis zur Achten Ära des Lichts nie mehr so niedrig sein!
#. fr: Vous ne verrez plus de prix pareils jusqu'à la 8e ère astrale<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:484:0:1"
msgid "Prices won't be this<br>low again until the<br>Eighth Astral Era!"
msgstr "Таких низких цен<br>не будет вплоть до<br>Восьмой астральной эры!"

#. ja: ホントかよ？
#. de: Könnten Sie uns vielleicht einen Rabatt geben?
#. fr: Vous pourriez nous faire une petite ristourne<nbsp>?
msgctxt "Balloon:485:0:1"
msgid "ホントかよ？"
msgstr "ホントかよ？"

#. ja: 未使用486
#. de: Das ist ganz schön happig nur für drei Taschen.
#. fr: Ça n'est pas donné pour trois malheureux sacs.
msgctxt "Balloon:486:0:1"
msgid "未使用486"
msgstr "未使用486"

#. ja: 未使用487
#. de: Einen wird schon niemand vermissen ...
#. fr: Personne n'a rien vu...
msgctxt "Balloon:487:0:1"
msgid "未使用487"
msgstr "未使用487"

#. ja: 今です！　今出ました！
#. de: Ich betreibe hier ein Geschäft, werte Dame, kein Armenhaus.
#. fr: Je tiens une boutique, Madame, pas un hospice.
msgctxt "Balloon:488:0:1"
msgid "今です！　今出ました！　"
msgstr "今です！　今出ました！　"

#. ja: 未使用489
#. de: Bezahl den Mann einfach. Wir haben nicht den ganzen Tag Zeit.
#. fr: Paye-le donc, nous n'avons pas toute la journée.
msgctxt "Balloon:489:0:1"
msgid "未使用489"
msgstr "未使用489"

#. ja: め、目がまわる…
#. de: Ich hätte die sechste Flasche Wein vielleicht doch weglassen sollen!
#. fr: Je n'aurais pas dû boire autant ce matin, héhé... Hic<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:490:0:1"
msgid "I shouldn't have had that<br>sixth bottle of sour red!"
msgstr "Не стоило мне пить<br>шестую бутылку кислого красного!"

#. ja: これでよし、と
#. de: Es scheint alles in Ordnung zu sein.
#. fr: Tout a l'air en ordre...
msgctxt "Balloon:491:0:1"
msgid "All appears to be in order."
msgstr "Вроде всё в порядке."

#. ja: 未使用492
#. de: Ich versteh nicht, warum man <i>stehen</i> sollte, um Wache zu stehen.
#. fr: Dois-je vraiment rester droit comme un piquet pour monter la garde...<nbsp>?
msgctxt "Balloon:492:0:1"
msgid "未使用492"
msgstr "未使用492"

#. ja: 未使用493
#. de: Hier ist der Zutritt verboten. Tritt zurück, <if $gn4>Mädel<else>Junge</if>.
#. fr: Il est interdit d'entrer ici. Du vent<nbsp>!
msgctxt "Balloon:493:0:1"
msgid "未使用493"
msgstr "未使用493"

#. ja: また引っ越したって
#. de: Hab gesehen, wie der alte Müller sein Zelt abgebaut hat ...
#. fr: J'ai vu le meunier préparer ses bagages...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:494:0:1"
msgid "I spied the old miller<br>taking down his tent."
msgstr "Видел, как старый мельник<br>разбирал палатку."

#. ja: どんどん人が…
#. de: Der wäre schon der Dritte, der hier diese Woche abhaut ...
#. fr: Tout le monde s'en va...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:495:0:1"
msgid "He'll be the third to<br>leave in as many days!"
msgstr "Он будет уже третьим,<br>кто уедет за три дня!"

#. ja: …店はやってないぜ
#. de: Nix zu verkaufen hier.
#. fr: Il n'y a rien à vendre ici.
msgctxt "Balloon:496:0:1"
msgid "Nothin' fer sale here."
msgstr "Тут ничё не продают."

#. ja: …店はやってないぜ
#. de: Hier gibt's nichts zu kaufen.
#. fr: Il n'y a rien à vendre ici.
msgctxt "Balloon:498:0:1"
msgid "…店はやってないぜ"
msgstr "...店はやってないぜ"

#. ja: わ、わ、何事ですかぁ！？
#. de: W-Warum machen die das?
#. fr: Prenez-moi, mais laissez la nourriture<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:502:0:1"
msgid "Take me, but<br>leave the lunches!"
msgstr "Забирайте меня, только<br>обеды не трогайте!"

#. ja: ぐ、ぐぅ…
#. de: \<schnauf>
#. fr: Argh...
msgctxt "Balloon:503:0:1"
msgid "Me gut..."
msgstr "Живот..."

#. ja: はぁ、はぁ…
#. de: \<keuch>
#. fr: (souffle) (souffle)
msgctxt "Balloon:504:0:1"
msgid "\\<pant> \\<pant>"
msgstr "<i>Ха-а... ха-а...</i>"

#. ja: ド、ドックを頼む…
#. de: Jemand muss diese Typen aufhalten!
#. fr: Les docks... Vous devez... protéger les... (tousse)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:505:0:1"
msgid "The docks... You must...<br>secure the... \\<cough>"
msgstr "Док... Надо...<br>защитить... <i>Кхе-кхе!</i>"

#. ja: にゃっ大変だにゃー
#. de: Wie schrecklich!
#. fr: Si je me cache derrière ces bûches...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:506:0:1"
msgid "Perhaps this isn't the<br>best place to hide..."
msgstr "Похоже, прятаться здесь<br>не лучшая затея..."

#. ja: ヴィ、ヴィクトリー号がぁ…
#. de: D-Die Victory ...!
#. fr: Protégez le Victoire<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:507:0:1"
msgid "Protect the <i>Victory</i>!"
msgstr "Защитите «<i>Победу</i>»!"

#. ja: か、海賊どもが…
#. de: Verdammte Piraten ...
#. fr: Des piraaaates<nbsp>!
msgctxt "Balloon:508:0:1"
msgid "P-P-Pirates!"
msgstr "П-п-пираты!"

#. ja: ひぃぃ助けてくれぇー
#. de: H-Hiiilfeeeeee!
#. fr: Au secours<nbsp>!
msgctxt "Balloon:509:0:1"
msgid "They're all yours!"
msgstr "Они ваши!"

#. ja: こりゃやばい！
#. de: O-Oh ...
#. fr: On est dans l'pétrin<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:510:0:1"
msgid "Go on, then! Knock<br>some sense into <i>them</i>!"
msgstr "Ну же! Вправьте <i>им</i><br>мозги!"

#. ja: ちょっと…補給…
#. de: Es reicht einfach nie ...
#. fr: On n'en a jamais assez...
msgctxt "Balloon:511:0:1"
msgid "Enough is never enough."
msgstr "Всего всегда мало."

#. ja: 助かります
#. de: Dann sieh zu, dass es erledigt wird.
#. fr: Assure-toi que ce soit fait, et bien.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:515:0:1"
msgid "See that it<br>gets done, then."
msgstr "Проследи, чтобы<br>всё сделали."

#. ja: デッカイ夢だな
#. de: Erzähl den Quatsch mal dem Gildenmeister.
#. fr: Essaye un peu de dire ça devant le patron<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:519:0:1"
msgid "Ye try spittin' that bilge<br>before the guildmaster."
msgstr "Попробуй такую чушь<br>сказать мастеру гильдии!"

#. ja: お頭を目指してんだ
#. de: Im Sommer bin ich hier der Boss auf den Trockendocks.
#. fr: Avant l'été, je dirigerai ces docks<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:521:0:1"
msgid "Come summer, I'll be<br>runnin' these here docks."
msgstr "К лету я буду тут<br>главным на доках!"

#. ja: 何でもやるよ
#. de: Ihr habt den richtigen Mann für den Job ausgewählt!
#. fr: Vous pouvez me faire confiance<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#, aeria-term-model-exception: job b3e546875adf
msgctxt "Balloon:522:0:1"
msgid "You chose the<br>right man for the job!"
msgstr "Вы выбрали<br>нужного человека!"

#. ja: 材木は船の要…
#. de: Na,  das nenn ich mal ordentlich Holz vor der Hütte!
#. fr: J'imagine déjà les navires majestueux que tout ce bois va servir à fabriquer.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:527:0:1"
msgid "That'll be a holt's worth<br>of lumber down there."
msgstr "Там целый лес древесины."

#. ja: 異常なし…
#. de: Könnte den Leuten den ganzen Tag bei der Arbeit zusehen.
#. fr: T'approche pas trop du bord.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:530:0:1"
msgid "Take care to stand<br>clear of the edge."
msgstr "Держись подальше<br>от края."

#. ja: 広い～！
#. de: Ah, der Duft des Meeres!
#. fr: Ah, l'air vivifiant de la mer<nbsp>!
msgctxt "Balloon:535:0:1"
msgid "Ah, the smell of the sea!"
msgstr "Ах, морской воздух!"

#. ja: 受付はっ、と…
#. de: Hör auf zu quasseln und hilf mir bei der Suche, dann finden wir den Mann auch.
#. fr: Peut-être que si tu m'aidais, on trouverait notre homme plus vite...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:536:0:1"
msgid "Perhaps if you stopped<br>yapping and helped me<br>look, we'd find the man."
msgstr "Может, хватит болтать<br>и поможешь искать? Так мы<br>скорее найдём этого человека."

#. ja: また新入りか…
#. de: Suchst du nach Arbeit? Das Büro ist weiter unten.
#. fr: Vous cherchez du travail<nbsp>? C'est en bas.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:537:0:1"
msgid "Lookin' for work? The<br>offices are further down."
msgstr "Работу ищешь? Конторы<br>дальше по дороге."

#. ja: 船体の曲線がたまらない
#. de: Wow, <i>das</i> ist mal ein schönes Ding.
#. fr: Regarde-moi un peu cette beauté<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:539:0:1"
msgid "Now <i>that's</i> a<br>thing of beauty."
msgstr "Вот это <i>красота</i>!"

#. ja: べっぴんな船だ
#. de: Was weißt du schon von Schönheit?
#. fr: Comme si tu y connaissais quelque chose...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:540:0:1"
msgid "And what would you<br>know about beauty?"
msgstr "Да откуда тебе знать,<br>что такое красота?"

#. ja: やだ、生乾き…
#. de: Noch ein paar Tage in der Sonne und sie sind verarbeitungsfertig.
#. fr: Encore quelques jours à sécher au soleil...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:545:0:1"
msgid "A few more days in the<br>sun and they'll be ready."
msgstr "Ещё пару дней на<br>солнце — и будет готово."

#. ja: ネズミめっ！
#. de: Verfluchte Ratten!
#. fr: Saleté d'rats<nbsp>!
msgctxt "Balloon:546:0:1"
msgid "Blasted rats!"
msgstr "Проклятые крысы!"

#. ja: また、かじられた
#. de: Haben sie mal wieder an deinem Hintern genagt?
#. fr: Faut qu'on trouve une solution...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:547:0:1"
msgid "Been nibblin' on yer<br>arse again, have they?"
msgstr "Опять твою задницу<br>обгрызли, а?"

#. ja: 木釘が届いたぞ～
#. de: Oi! Wo sollen diese Nägel hin, Kumpel?
#. fr: Où que j'dois poser tout ça, moi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:549:0:1"
msgid "Oi! Where'd you<br>want these nails, lads?"
msgstr "Эй! Куда эти<br>гвозди, ребята?"

#. ja: 使いようだ
#. de: Dann müssen wir ihm mal ein wenig davon einhämmern!
#. fr: T'inquiète, il va vite apprendre à notre contact, hahaha<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:550:0:1"
msgid "Then ye'll jus' 'ave to<br>knock some into 'im!"
msgstr "Ну так придётся<br>вбить ему это в голову!"

#. ja: 最近の新入りってやつぁ…
#. de: Dieser neue Typ hat nicht einen Funken Verstand im Hirn!
#. fr: L'est pas bien malin, l'nouveau...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:551:0:1"
msgid "That new hand hasn't<br>a single wit about him!"
msgstr "У нового работника<br>ума ни на грош!"

#. ja: がってんだ
#. de: Zu Befehl, Eure Hoheit.
#. fr: Tu es sûr que ça va aller<nbsp>? Tu as l'air d'avoir du mal...
msgctxt "Balloon:552:0:1"
msgid "Aye aye, Yer Highness."
msgstr "Есть, ваше высочество."

#. ja: 小屋に運び込め
#. de: Bring die Säcke ins Lagerhaus. Und hör auf, mir auf den Hintern zu starren.
#. fr: Suis-moi, on emmène ça dans la réserve.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:553:0:1"
msgid "Take them sacks to<br>the storehouse. And<br>stop starin' at me arse."
msgstr "Отнесите эти мешки<br>на склад. И хватит<br>пялиться на мою задницу."

#. ja: どれも新鮮ですよ
#. de: Frisches Obst! Esst mehr frisches Obst!
#. fr: Frais, les fruits et légumes, frais<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:554:0:1"
msgid "Get your fresh fruit!<br>Keep the scurvy at bay!"
msgstr "Свежие фрукты!<br>Цингу не подпустим!"

#. ja: エールはいかがかね！？
#. de: Bestes Gebräu direkt aus dem Bierhafen! Tretet heran, probiert einen Schluck!
#. fr: Goûtez donc la meilleure bière de Port-aux-Ales<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:555:0:1"
msgid "Come and have a<br>taste of Aleport's finest!"
msgstr "Подходите, попробуйте<br>лучший эль из Алепорта!"

#. ja: すぐ治るさ
#. de: Ach, die wachsen schon wieder nach.
#. fr: Bah, ils repousseront.
msgctxt "Balloon:556:0:1"
msgid "It'll grow back eventually."
msgstr "Отрастёт ещё."

#. ja: 作業中に火傷だって？
#. de: Die Flammen haben all meine Haare versengt!
#. fr: Tous mes cheveux, brûlés<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:557:0:1"
msgid "The flames gone singed<br>every last hair on me head!"
msgstr "Огонь опалил<br>каждый волос на голове!"

#. ja: タールは十分だな
#. de: Man sollte meinen, dass 30 Kisten Teer mehr als genug wären.
#. fr: Bon, avec ça, on devrait avoir assez de goudron.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:558:0:1"
msgid "Ye'd reckon thirty crates<br>o' tar'd be more 'an enough."
msgstr "Казалось бы, тридцати ящиков<br>дёгтя должно хватить с лихвой."

#. ja: 次の船は…
#. de: Wo zu den Sieben Höllen bleibt meine verdammte Fähre!?
#. fr: Où est passé le bateau qui était amarré ici<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:559:0:1"
msgid "Where in the seven<br>hells is my damn ship!?"
msgstr "Да где же, во имя семи<br>адов, мой корабль?!"

#. ja: さっさと運んじまうぞ
#. de: Halt den Rand und beweg deinen Hintern.
#. fr: Ferme ton clapet et bouge un peu tes fesses<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:560:0:1"
msgid "Shut yer gob and<br>move that arse."
msgstr "Заткнись и<br>шевели задницей."

#. ja: 修繕依頼ですか？
#. de: Jemand sollte das dem armen Seewolf sagen.
#. fr: Quelqu'un devrait prévenir ce pauvre Roegadyn...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:563:0:1"
msgid "Someone should tell<br>that poor Sea Wolf."
msgstr "Кто-нибудь должен сказать<br>этому бедному морскому волку."

#. ja: 今日は運休よ
#. de: Für heute legt hier kein Boot mehr ab.
#. fr: Les docks sont fermés aujourd'hui.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:564:0:1"
msgid "The Drydocks are<br>closed for repairs today."
msgstr "Сегодня сухие доки<br>закрыты на ремонт."

#. ja: 修繕ばっかり
#. de: Ich hab keine Lust mehr, den ganzen Tag leckende Galeeren zu reparieren.
#. fr: J'en ai marre de renflouer des rafiots à longueur de journée...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:565:0:1"
msgid "I'm tired of repairin'<br>leaky galleys all day."
msgstr "Сил нет чинить<br>целый день протекающие галеры."

#. ja: また！？
#. de: Aye! Wann arbeiten wir endlich an der <i>Victory</i>?
#. fr: Quand est-ce qu'on commence à travailler sur le Victoire<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:566:0:1"
msgid "Aye! When do we start<br>workin' on the <i>Victory</i>?"
msgstr "Ага! Когда начнём<br>работать над <i>«Победой»</i>?"

#. ja: 視線を感じる…
#. de: Lass das nicht Mimidoa hören!
#. fr: Pas si fort, Mimidoa pourrait t'entendre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:567:0:1"
msgid "Don't let Mimidoa<br>hear you say that!"
msgstr "Не дай Мимидоа<br>услышать такие слова!"

#. ja: 見かけない船だな…
#. de: So einen Kahn hab ich noch nie gesehn.
#. fr: Je ne me lasserai jamais de cette vue...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:572:0:1"
msgid "I have me a son.<br>Isaac's his name."
msgstr "У меня есть сын.<br>Зовут Айзек."

#. ja: 干し肉が人気よ
#. de: Ich schwör, wenn er mich noch mal anfasst, hacke ich ihm die Hand ab!
#. fr: S'il me touche une fois de plus, je lui tranche la main<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:573:0:1"
msgid "I swear if he<br>touches me again,<br>I'll cut off his hand!"
msgstr "Клянусь, если он<br>ещё раз меня тронет,<br>я ему руку отрежу!"

#. ja: 力仕事だからね
#. de: Das ist nicht alles, was man abhacken sollte!
#. fr: C'est la tête qu'on devrait lui trancher...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:574:0:1"
msgid "That's not all what<br>deserves a cuttin'!"
msgstr "Да тут кое-что ещё<br>под нож просится!"

#. ja: ヤロウまた遅刻か
#. de: Der verdammte Mistkerl ist schon wieder zu spät!
#. fr: Il est en r'tard, comme toujours...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:575:0:1"
msgid "The damn<br>bastard's late again."
msgstr "Опять этот<br>проклятый ублюдок опаздывает."

#. ja: 根性なさすぎ
#. de: Oder einfach nur früh dran für die Schicht morgen.
#. fr: Je crrrois plutôt qu'on est en avance...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:576:0:1"
msgid "Or, just early for<br>the morrow's work."
msgstr "Или мы просто<br>заранее пришли на работу."

#. ja: 無理しすぎだ
#. de: Was du <i>brauchst</i>, ist weniger Bier.
#. fr: J'crois qu'tu peux commencer à économiser tout d'suite...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:577:0:1"
msgid "What ye <i>needs</i> is<br>to lay off the ale."
msgstr "Тебе бы <i>надо</i><br>поменьше эля пить."

#. ja: 海に癒される…
#. de: Ich brauche einen Kutter, damit ich mir die Welt anschauen kann.
#. fr: Si j'avais un bateau rien qu'à moi, j'ferais l'tour du monde<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:578:0:1"
msgid "I needs me a ship so<br>I might see the world."
msgstr "Мне бы корабль —<br>и весь мир передо мной!"

#. ja: 肌が荒れちゃう
#. de: Bist du sicher, dass es nicht nur dein Spiegelbild war?
#. fr: C'était pas juste ton ombre<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:582:0:1"
msgid "Sure it wasn't just<br>your reflection?"
msgstr "Точно не просто<br>своё отражение увидел?"

#. ja: 俺も…
#. de: Hahaha!
#. fr: Hahahaha<nbsp>!!
msgctxt "Balloon:583:0:1"
msgid "Ahahahaha!"
msgstr "А-ха-ха-ха!"

#. ja: 今日も夜勤さ
#. de: Direkt dort drüben habe ich einen Sahagin gesehn. Ich schwör!
#. fr: J'ai vu un Sahuagin, juste là-bas<nbsp>! Vraiment<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:584:0:1"
msgid "I saw a Sahagin right<br>over there. I swear it!"
msgstr "Я видел сахагина вон<br>там. Клянусь!"

#. ja: どの子を使おうかしら…
#. de: Ich denke, das muss fürs Erste reichen.
#. fr: Ça devrait suffire pour le moment.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:586:0:1"
msgid "I suppose this'll<br>have to do for now."
msgstr "Думаю, пока<br>придётся обойтись этим."

#. ja: どいた、どいた
#. de: Aus dem Weg!
#. fr: Place<nbsp>!
msgctxt "Balloon:593:0:1"
msgid "Out o' me way."
msgstr "А ну с дороги."

#. ja: この荷は臭う…
#. de: Die Kiste hier stinkt nach verfaultem Fisch und altem Teer.
#. fr: Cette caisse pue le goudron et la vieille poiscaille...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:606:0:1"
msgid "This here crate reeks<br>of rotting fish and old tar."
msgstr "Эта бочка воняет<br>тухлой рыбой и старым дёгтем."

#. ja: まだ、まだ、あるな…
#. de: Nu pack das Ding schon an, du alte Heulsuse!
#. fr: Regardez-moi ce Roegadyn... Rien que de la gonflette<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:607:0:1"
msgid "Put yer back into it,<br>ye nine-stone ninny! "
msgstr "Наляг на неё,<br>тощий ты недотёпа!"

#. ja: くっそ！
#. de: Beim Auge des Leviathan! Was ham die denn hier reingepackt!?
#. fr: Par les Douze<nbsp>! Qu'est-ce qu'ils ont bien pu mettre là-dedans<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:608:0:1"
msgid "Leviathan's eye! What'd<br>they fill this bugger with!?"
msgstr "Око Левиафана! Чем же<br>эту штуку набили?!"

#. ja: うっ、足りない…
#. de: Ach, hör schon auf zu schnacken!
#. fr: J'ai beau compter et recompter, il en manque une...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:609:0:1"
msgid "Stop your nattering.<br>They <i>all</i> do!"
msgstr "Хватит болтать.<br>Они <i>все</i> такие!"

#. ja: あ～だりぃ～
#. de: Siehst du nicht, dass ich arbeite?
#. fr: Tu vois pas que j'travaille<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:613:0:1"
msgid "Can't you see<br>I'm workin'?"
msgstr "Не видишь,<br>я работаю?"

#. ja: とれねえなあ
#. de: Mist, ich komm nicht dran!
#. fr: Saleté de tache de vin rouge...
msgctxt "Balloon:614:0:1"
msgid "Nothin's bitin'..."
msgstr "Не клюёт..."

#. ja: 不味い酒だ
#. de: Dieser Wein schmeckt nach Pisse!
#. fr: Ce vin a vraiment un goût de pisse, ma parole<nbsp>!
msgctxt "Balloon:615:0:1"
msgid "This wine tastes of piss!"
msgstr "Это вино на мочу похоже!"

#. ja: 仕事さえあれば…
#. de: Das erklärt dann wohl deinen Mundgeruch!
#. fr: Ça doit être pour ça que tu pues du bec.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:616:0:1"
msgid "That would explain<br>your breath!"
msgstr "Теперь понятно,<br>почему у тебя изо рта несёт!"

#. ja: 何が悪いってんだ
#. de: Was? Meine Gil sind dir wohl nicht gut genug?!
#. fr: Bah, quoi<nbsp>? Tu veux pas de mes gils<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:617:0:1"
msgid "Wha? Me gil's not<br>good enough fer ye?"
msgstr "Чего? Мои гилы<br>тебе не подходят, что ли?"

#. ja: 迷惑なの！
#. de: Das wären sie ... wenn du welche <i>hättest</i>!
#. fr: Ha<nbsp>! Je sais bien que t'es fauché comme les blés<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:618:0:1"
msgid "It would be...if<br>you <i>had</i> any!"
msgstr "Подошли бы... если бы<br>у тебя хоть что-то <i>было</i>!"

#. ja: うむ、うむ
#. de: Dann mal los.
#. fr: Qu'est-ce que tu attends, alors<nbsp>?
msgctxt "Balloon:619:0:1"
msgid "Then make it so."
msgstr "Так сделай."

#. ja: 金を積めば余裕さ
#. de: Kann ich nicht sagen. Aber ich werd's trotzdem versuchen.
#. fr: Je ne sais pas. Mais ce n'est pas ce qui va m'empêcher d'essayer.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:620:0:1"
msgid "I cannot say. But<br>that won't stop me<br>from trying."
msgstr "Не знаю. Но<br>это мне не помешает<br>попробовать."

#. ja: いけるか？
#. de: Ist das machbar?
#. fr: Tu crois que ça marcherait<nbsp>?
msgctxt "Balloon:621:0:1"
msgid "Is it possible?"
msgstr "Это вообще возможно?"

#. ja: 未使用622
#. de: Es wird nicht weniger heiß, wenn du so mit der Hand rumfuchtelst.
#. fr: 未使用622
msgctxt "Balloon:622:0:1"
msgid "未使用622"
msgstr "未使用622"

#. ja: ふう…はあ…
#. de: Ich hätte Mandoline lernen sollen ...
#. fr: J'aurais mieux fait d'apprendre à jouer de la mandoline...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:623:0:1"
msgid "Wavin' yer hand like<br>that ain't gonna make<br>it any less hot."
msgstr "Махать рукой —<br>жара от этого меньше<br>не станет."

#. ja: 未使用624
#. de: Wir liegen schon eine Woche hinter dem Zeitplan zurück.
#. fr: 未使用624
msgctxt "Balloon:624:0:1"
msgid "未使用624"
msgstr "未使用624"

#. ja: 未使用625
#. de: Der Vorarbeiter wird uns gehörig den Marsch blasen.
#. fr: 未使用625
msgctxt "Balloon:625:0:1"
msgid "未使用625"
msgstr "未使用625"

#. ja: やなこった
#. de: Ich schaff's einfach nicht!
#. fr: J'ai déjà trop perdu, j'arrête<nbsp>!
msgctxt "Balloon:626:0:1"
msgid "Nothing or double!"
msgstr "Всё или ничего!"

#. ja: もう一勝負！
#. de: Komm schon, noch einen Versuch!
#. fr: Tu peux encore te refaire...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:627:0:1"
msgid "You play cards about as<br>well as you comb your hair."
msgstr "Ты в карты играешь<br>не лучше, чем причёсываешься."

#. ja: 準備はできてる？
#. de: Du hast nicht schon wieder die Freibriefe vergessen, oder?
#. fr: Ne me dis pas que t'as encore oublié les au<shy>to<shy>ri<shy>sa<shy>tions<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:628:0:1"
msgid "You didn't forget the<br>leves again, did you?"
msgstr "Ты же опять не забыл<br>взять поручения?"

#. ja: この先は閉鎖中だ
#. de: Hinter diesem Tor liegt Kelchkuppe. Von meinem mickrigen Sold kann ich mir da allerdings nie 'ne Unterkunft leisten.
#. fr: Rebrousse chemin, il n'y a rien à voir par ici.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:629:0:1"
msgid "This gate is to<br>remain closed."
msgstr "Эти ворота должны<br>оставаться закрытыми."

#. ja: その服どこのブランド？
#. de: Wo hast du nur diese Tunika gefunden?
#. fr: Quel beau châle<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:630:0:1"
msgid "Where ever did<br>you find that tunic?"
msgstr "Где ты только<br>такую тунику нашёл?"

#. ja: いいでしょ？
#. de: Bei Fen Yll, natürlich!
#. fr: N'est-ce pas<nbsp>? Il vient des Soieries du Soleil.
msgctxt "Balloon:631:0:1"
msgid "Sunsilk, of course!"
msgstr "Конечно, из солнечного шёлка!"

#. ja: それくらい私だって！
#. de: Pah! Ich hab gesehen, wie du sie von einem Stand im Steinwurf-Slum gemopst hast!
#. fr: Vraiment<nbsp>? Comment te l'es-tu procuré<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:632:0:1"
msgid "Pah! I saw you swipe it<br>from a stall in Stonesthrow!"
msgstr "Ха! Я видел, как ты стащил это с прилавка в Камнебросе!"

#. ja: 確か小銭が…
#. de: Wo hat er bloß diesen Brief versteckt?!
#. fr: Où avais-je caché nos dernières économies<nbsp>?<nbsp>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:633:0:1"
msgid "Now where did he<br>hide that letter!?"
msgstr "Куда же он<br>письмо запрятал?!"

#. ja: 未使用634
#. de: Meine Mama hat mir gesagt, ich soll hier warten, während sie diesen Mann trifft. Ich hab Hunger ...
#. fr: 未使用634
msgctxt "Balloon:634:0:1"
msgid "未使用634"
msgstr "未使用634"

#. ja: …お前もか
#. de: Wo könnten wir denn sonst hin?
#. fr: Toi aussi, tu vas laisser tomber<nbsp>?<nbsp>...
msgctxt "Balloon:635:0:1"
msgid "Where else can we go?"
msgstr "Куда нам ещё податься?"

#. ja: 他で商売やろうぜ
#. de: Hier ist eine Stimmung wie auf dem Friedhof.
#. fr: Je crois qu'il est temps d'aller faire du commerce ailleurs...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:636:0:1"
msgid "This place is deader<br>than a lichyard."
msgstr "Тут мертвее,<br>чем на кладбище личей."

#. ja: 残り少なくなったわね…
#. de: Die sind alle so toll.<br>Ich kann mich einfach nicht entscheiden!
#. fr: Ils sont si beaux<nbsp>! Lequel choisir<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:637:0:1"
msgid "They're all so stunning.<br>I simply cannot decide!"
msgstr "Они все такие красивые.<br>Прямо не знаю, что выбрать!"

#. ja: 未使用638
#. de: Verzieh dich! Leute wie dich kann ich hier nicht gebrauchen.
#. fr: 未使用638
msgctxt "Balloon:638:0:1"
msgid "未使用638"
msgstr "未使用638"

#. ja: 汚い手で家具に触るなよ
#. de: Nimm deine Schmutzgriffel von der Ware weg, du!
#. fr: Je vous interdis de toucher à mes meubles avec vos sales pattes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:639:0:1"
msgid "Keep those filthy gropers<br>off the merchandise, you."
msgstr "Не лапай товар<br>своими грязными ручищами."

#. ja: 未使用640
#. de: Womit kann ich dienen?
#. fr: 未使用640
msgctxt "Balloon:640:0:1"
msgid "未使用640"
msgstr "未使用640"

#. ja: お…お？
#. de: Nur noch ein bisschen<br>näher ...
#. fr: Par ici mon joli...
msgctxt "Balloon:641:0:1"
msgid "Just a little closer..."
msgstr "Ещё чуть-чуть..."

#. ja: 画期的な工法で…
#. de: Und dadurch könnte man die Produktivität verdreifachen!
#. fr: ... ce qui nous permettrait d'améliorer notre productivité.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:642:0:1"
msgid "And doing so could<br>improve productivity<br>threefold!"
msgstr "А так мы сможем<br>утроить производительность!"

#. ja: 視察中だ
#. de: Ich wache über meinen Herrn, während er die Dampframmen inspiziert.
#. fr: Je suis ici pour assurer la sécurité de sa seigneurie.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:643:0:1"
msgid "I'm to see no harm<br>comes to his lordship as<br>he inspects the hammers."
msgstr "Я должен проследить, чтобы с его светлостью<br>ничего не случилось, пока он осматривает молоты."

#. ja: 邪魔をするなよ
#. de: Du gehst besser ... jetzt.
#. fr: Hors de mon chemin.
msgctxt "Balloon:644:0:1"
msgid "You'd best leave...now."
msgstr "Тебе лучше уйти... сейчас же."

#. ja: だから金持ちは…
#. de: Und wenn sich die Messingklinge dann umdreht ...
#. fr: Et quand le garde aura le dos tourné...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:645:0:1"
msgid "And when the Brass<br>Blade is turned away─"
msgstr "А когда Стальной клинок<br>отвернётся..."

#. ja: しっ、黙っとけ
#. de: Pssst! Nicht so laut!
#. fr: Chut<nbsp>! Ils pourraient t'entendre<nbsp>!
msgctxt "Balloon:646:0:1"
msgid "Shhh! Keep it down!"
msgstr "Тсс! Потише!"

#. ja: 音が頭に響く…
#. de: Kann mal jemand den Lärm abstellen!?
#. fr: Le bruit de ces machines résonne dans ma tête...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:647:0:1"
msgid "Someone make the<br>pounding stop!"
msgstr "Кто-нибудь, пусть этот<br>грохот прекратится!"

#. ja: すぐに慣れる
#. de: Es gibt genug andere Kisten, mein Freund!
#. fr: T'inquiète, tu vas vite t'habituer.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:648:0:1"
msgid "Well, maybe if you hadn't<br>downed that last bottle..."
msgstr "А нечего было<br>допивать последнюю бутылку..."

#. ja: 未使用649
#. de: Nun, vielleicht hättest du die letzte Buddel weglassen sollen.
#. fr: 未使用649
msgctxt "Balloon:649:0:1"
msgid "未使用649"
msgstr "未使用649"

#. ja: ふむ…
#. de: Unmöglich! Ich habe sie heute Morgen selbst eingestellt!
#. fr: Pas possible, je les ai fait graisser ce matin<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:650:0:1"
msgid "Impossible! I calibrated<br>them myself this morning!"
msgstr "Невозможно! Я сам их<br>настроил сегодня утром!"

#. ja: 未使用651
#. de: Diese Kiste sollte einen ganzen Mond lang halten!
#. fr: 未使用651
msgctxt "Balloon:651:0:1"
msgid "未使用651"
msgstr "未使用651"

#. ja: 少し遅くないか？
#. de: Ich glaube die Zahnräder werden allmählich langsamer.
#. fr: Tu ne trouves pas que les engrenages coincent un peu<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:652:0:1"
msgid "I believe the gears are<br>showing signs of slowing."
msgstr "Похоже, шестерёнки<br>начинают замедляться."

#. ja: ぼやぼやしてるな
#. de: Zurück an die Arbeit, oder ich ziehe dir noch mal 100 Gil vom Lohn ab!
#. fr: Au boulot, ou je retiens cent gils sur ta paye<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:653:0:1"
msgid "Back to work, or I'll<br>dock another hundred gil!"
msgstr "Живо за работу, а то<br>ещё сотню гил из зарплаты вычту!"

#. ja: わ、わかってるよ
#. de: Sir! Sofort, Sir!
#. fr: Oui Monsieur, tout de suite<nbsp>!
msgctxt "Balloon:654:0:1"
msgid "Sir! Right away, sir!"
msgstr "Сэр! Сейчас же, сэр!"

#. ja: やっと一服だ
#. de: Ein fahrender Sänger hat mir die Pfeife hier gegeben.
#. fr: Rien de tel qu'une bonne petite pipe pendant la pause<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:655:0:1"
msgid "A wanderin' minstrel<br>gave me this here pipe."
msgstr "Один странствующий менестрель<br>подарил мне эту трубку."

#. ja: 歯車掃除も楽じゃねえや
#. de: Zahnradputzen ist von Nutzen!
#. fr: Si j'avais su que c'est aussi crevant de nettoyer ces engrenages<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:656:0:1"
msgid "What were if I waved<br>it right crackin', like?"
msgstr "А если махать ею вот так,<br>прямо от души?"

#. ja: 話が違う！
#. de: Du hast gesagt, ich würde fünfzig pro Ladung kriegen!
#. fr: Vous aviez dit cinquante par chargement<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:657:0:1"
msgid "Ye said I'd be gettin'<br>fifty fer each load!"
msgstr "Ты же обещал<br>пятьдесят за каждый груз!"

#. ja: ん？妙に軽いな？
#. de: Die fühlen sich leichter an als sie sollten ...
#. fr: Ces sacs sont bien légers...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:658:0:1"
msgid "These feel lighter<br>than they should..."
msgstr "Что-то они легче,<br>чем должны быть..."

#. ja: だいぶガタがきてるな
#. de: Hier quietscht's und rappelt's an allen Enden ...
#. fr: Celle-ci ne va pas tenir bien longtemps...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:659:0:1"
msgid "Where the hells is that<br>rattling coming from?"
msgstr "Да откуда этот<br>чёртов грохот?!"

#. ja: どこ置くんスかァ～？
#. de: Beweg deinen Hintern, damit ich das Teil hier abstellen kann.
#. fr: Bouge ton cul que je puisse poser ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:660:0:1"
msgid "Move yer arse, so I can<br>set this bugger down."
msgstr "Подвинь задницу, мне<br>эту штуку поставить надо."

#. ja: ぐぬぬぬぬぬぬ
#. de: Aua! Mein Rücken ...
#. fr: Ouille, mon dos<nbsp>!
msgctxt "Balloon:661:0:1"
msgid "Ach! Me back!"
msgstr "Ай! Спину прихватило!"

#. ja: 取引は終わりだ
#. de: Das war letzte Woche. Heute kann ich dir sechs anbieten.
#. fr: Ça, c'était la semaine dernière. Aujourd'hui, je t'en offre six.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:662:0:1"
msgid "That was last week.<br>Today, I can offer you six."
msgstr "Это было на прошлой неделе.<br>Сегодня могу предложить шесть."

#. ja: 注文通りですよ
#. de: Dreißig Kisten, im Morgengrauen angeliefert. Genau wie bestellt.
#. fr: Trente caisses, c'est pourtant ce qui était écrit.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:663:0:1"
msgid "Thirty crates, delivered<br>by dawn. Just as ordered."
msgstr "Тридцать ящиков доставили<br>к рассвету. Всё как заказывали."

#. ja: 未使用664
#. de: Nun bezahl schon, sonst wird's hier ungemütlich.
#. fr: 未使用664
msgctxt "Balloon:664:0:1"
msgid "未使用664"
msgstr "未使用664"

#. ja: 歪みはないな？
#. de: Nein, nein! Das geht so nicht! Die Räder müssen sofort ersetzt werden!
#. fr: Non, ça ne va pas<nbsp>! Ces roues doivent être remplacées im<shy>mé<shy>dia<shy>te<shy>ment.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:665:0:1"
msgid "No, no! This will not do!<br>The wheels will have to<br>be replaced forthwith!"
msgstr "Нет, так не пойдёт!<br>Колёса придётся<br>немедленно заменить!"

#. ja: それでなぁ…
#. de: Und der Minenarbeiter sagte: „Ich habe doch gar keine Tochter!“
#. fr: Et là, le mineur répond<nbsp>: “mais je n'ai pas de fille<nbsp>!” Hahaha<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:668:0:1"
msgid "And the miner said, “But<br>I don't have a daughter!”"
msgstr "А шахтёр и говорит: «Но<br>у меня же нет дочери!»"

#. ja: またオメェは…
#. de: Nö. Ich versteh's immer noch nicht.
#. fr: Non, désolé, je comprends pas...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:669:0:1"
msgid "No.<br>Still don't get it."
msgstr "Нет.<br>Всё равно не понял."

#. ja: ふんふ～ん♪
#. de: Ist es das, was ich glaube?
#. fr: Mes yeux me joueraient-ils des tours<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:670:0:1"
msgid "Did I just <i>see</i> what<br>I thought I saw?"
msgstr "Мне правда <i>показалось</i>,<br>что я это видел?"

#. ja: 約束が違う
#. de: Du kriegst nicht einen Gil mehr als vereinbart!
#. fr: Vous n'aurez pas un gil de plus<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:671:0:1"
msgid "You'll not get a gil more<br>than what was agreed upon!"
msgstr "Ни гила больше<br>того, о чём договорились!"

#. ja: もう一声！
#. de: Du bist eine volle Glocke früher hier. Das sollte hundert extra wert sein.
#. fr: Nous sommes arrivés en avance, je pense que ça mérite une petite rallonge...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:672:0:1"
msgid "I got you here a full bell<br>early. I'm thinkin' that be<br>worth another hundred."
msgstr "Я привёз тебя на целый колокол<br>раньше. Думаю, ещё сотня будет<br>в самый раз."

#. ja: 未使用673
#. de: Genug jetzt! Alle beide!
#. fr: 未使用673
msgctxt "Balloon:673:0:1"
msgid "未使用673"
msgstr "未使用673"

#. ja: 未使用674
#. de: Nach der Brücke ist es nur noch eine viertel Glocke bis nach Horizont.
#. fr: 未使用674
msgctxt "Balloon:674:0:1"
msgid "未使用674"
msgstr "未使用674"

#. ja: 未使用：荒：会話00363
#. de: Jenseits dieses Weges befindet sich das zentrale Thanalan.
#. fr: 未使用：荒：会話00363
msgctxt "Balloon:675:0:1"
msgid "未使用：荒：会話00363"
msgstr "未使用：荒：会話00363"

#. ja: えーっと…
#. de: Der Lagerplatz will wohl überlegt sein!
#. fr: T'es bigleux ou quoi<nbsp>? Et deux qui font deux cent cinquante-deux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:676:0:1"
msgid "Two hundred and<br>fifty-two, you half-wit!"
msgstr "Двести пятьдесят два,<br>ты что, совсем тупой?!"

#. ja: どこいったかなぁ…
#. de: Ich bezahle euch beide nicht fürs Rumstehen! Bewegt euch!
#. fr: Où est donc passé ce fichu tapis<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
#, aeria-term-model-exception: job b3e546875adf
msgctxt "Balloon:677:0:1"
msgid "I run a business, not an<br>almshouse. If it is coin<br>you seek, get a job."
msgstr "Я тут бизнес веду, а не<br>богадельню. Нужны деньги —<br>найди работу."

#. ja: 船、来ないな
#. de: Wie lange dauert das denn noch?
#. fr: Il y avait tant de bateaux, avant...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:678:0:1"
msgid "I should've learned to<br>play the mandolin..."
msgstr "Надо было научиться<br>играть на мандолине..."

#. ja: ふごー…
#. de: \<schnarch>
#. fr: (ronfle)
msgctxt "Balloon:679:0:1"
msgid "\\<snore>"
msgstr "<i>Хр-р-р...</i>"

#. ja: 未使用
#. de: Ihr habt eure Befehle!
#. fr: 未使用
msgctxt "Balloon:680:0:1"
msgid "未使用"
msgstr "Не используется"

#. ja: やめとけって
#. de: Du hast doch gehört, was der letzten Gruppe zugestoßen ist!
#. fr: Puisque je te dis que j'étais encerclé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:681:0:1"
msgid "You heard what became<br>of the last party!"
msgstr "Ты слышал, что стало<br>с прошлой группой!"

#. ja: コブラン怖くて採掘師できるか！
#. de: Aber wir haben doch keine andere Wahl.
#. fr: Ça se dit mineur et ça a peur d'un coblyn...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:682:0:1"
msgid "Aye, but what choice<br>do we have?"
msgstr "Да, а что нам остаётся?"

#. ja: どうなっちまったんだ？
#. de: Die Bergbau AG entscheidet, wer passieren darf.
#. fr: Qu'est-ce que tu fais ici<nbsp>? Tu t'es perdu<if $gn4>e</if><nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:683:0:1"
msgid "The Concern decides<br>who may pass."
msgstr "Только Concern решает,<br>кого пропускать."

#. ja: 奥は危険だ
#. de: Weiter hinten ist's gefährlich, sieh dich vor!
#. fr: Je te déconseille d'aller plus loin.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:684:0:1"
msgid "You don't want<br>to go back there."
msgstr "Тебе туда лучше<br>не ходить."

#. ja: 景気がいいねェ
#. de: Hach, ich könnte stundenlang so hier rumstehen!
#. fr: Cette contrôleuse est vraiment mon genre.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:685:0:1"
msgid "I'm thinking of courting<br>that assessor. The one<br>who ties her hair up, like."
msgstr "Думаю приударить<br>за той оценщицей. Ну, за той,<br>что волосы завязывает."

#. ja: 一ケタ間違えちゃったかも…
#. de: Bei Thal, das ist schwerer als ein Auerochse!
#. fr: C'est plutôt tranquille de monter la garde ici.
msgctxt "Balloon:686:0:1"
msgid "一ケタ間違えちゃったかも…"
msgstr "Кажется, я на один разряд ошибся..."

#. ja: クー…クー…
#. de: Zzz ... Zzz ... Zzz ...<br>Zzz ... Raaa? Zzz ...
#. fr: Zzz... Kwé<nbsp>? Zzz...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:687:0:1"
msgid "Zzz... Zzz... Zzz...<br>Zzz... Wark? Zzz..."
msgstr "Хр-р... Хр-р... Хр-р...<br>Хр-р... Кве? Хр-р..."

#. ja: 異常なし…たぶん
#. de: Keine besonderen Vorkommnisse! Äh, zumindest keine, die ich bemerkt hätte.
#. fr: Rien à signaler... a priori.
msgctxt "Balloon:688:0:1"
msgid "異常なし…たぶん"
msgstr "Всё спокойно... наверное."

#. ja: 魔物がこっち来ませんように
#. de: Dir sind doch keine Bestien auf den Fersen, oder?
#. fr: Aucun monstre ne t'a suivi<if $gn4>e</if><nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:689:0:1"
msgid "There are no beasts<br>trailing you, are there?"
msgstr "За тобой ведь<br>не увязались чудовища?"

#. ja: 安いよ、安いよ！
#. de: Du siehst wohlhabend aus. Lass doch mal was von deinem Reichtum hier!
#. fr: C'est pas cher<nbsp>!
msgctxt "Balloon:690:0:1"
msgid "安いよ、安いよ！"
msgstr "Дёшево, дёшево!"

#. ja: 買い逃すと損するよ！
#. de: Es wäre eine Todsünde, diese Preise zu ignorieren!
#. fr: Vous allez le regretter si vous laissez passer cette affaire<nbsp>!
msgctxt "Balloon:691:0:1"
msgid "買い逃すと損するよ！"
msgstr "Упустишь такую покупку — пожалеешь!"

#. ja: アンタ、許可とってんのか？
#. de: Pass auf, dass du die zulässige Packlast nicht überschreitest, Freundchen!
#. fr: Vous avez une au<shy>to<shy>ri<shy>sa<shy>tion<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:692:0:1"
msgid "I cannot allow you to<br>leave until your cargo<br>has been inspected."
msgstr "Не выпущу тебя, пока<br>не проверю груз."

#. ja: 焦るなって
#. de: Immer mit der Ruhe, Kollege!
#. fr: Pas besoin de s'impatienter.
msgctxt "Balloon:693:0:1"
msgid "焦るなって"
msgstr "Да не торопись ты."

#. ja: 機械油臭せェ！
#. de: Pass auf, wo du hinlatschst.
#. fr: Attention où tu mets les pieds, aventuri<if $gn4>ère<else>er</if>.
msgctxt "Balloon:694:0:1"
msgid "Mind your step, adventurer."
msgstr "Под ноги смотри, искатель приключений."

#. ja: あれ、荷物が足りないぞ？
#. de: Hm? Uns fehlen 'n paar Kisten!
#. fr: Alors, notre prochaine destination sera...
msgctxt "Balloon:695:0:1"
msgid "Never heard of the beast."
msgstr "Никогда не слышал о таком чудовище."

#. ja: ふんぬぬぬぬ！
#. de: Mann, ist das Ding schwer! Was ha'm die geladen? Gravitas-Zauber?
#. fr: Où tu iras, je te suivrai<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:696:0:1"
msgid "Thal's balls, this is<br>heavier than an aurochs!"
msgstr "Да чтоб меня Тал побрал, это<br>тяжелее дикого быка!"

#. ja: いいじゃん、ケチ～！
#. de: Jetzt stell dich nicht so an, Geizhals!
#. fr: Espèce de radin<nbsp>!
msgctxt "Balloon:697:0:1"
msgid "いいじゃん、ケチ～！"
msgstr "Ну и жадина!"

#. ja: お前の心がけ次第だ
#. de: Liegt ganz bei dir ...
#. fr: Ça ne dépend que de toi.
msgctxt "Balloon:698:0:1"
msgid "お前の心がけ次第だ"
msgstr "Всё зависит от тебя."

#. ja: で、ブツはいつ届くんだ？
#. de: Nicht wenn dieser Lohengarde ein Wörtchen mitzureden hat.
#. fr: Quand est-ce que la marchandise arrive<nbsp>?
msgctxt "Balloon:699:0:1"
msgid "で、ブツはいつ届くんだ？"
msgstr "Так когда товар-то доставят?"

#. ja: 愚痴は掘った穴に叫べよ
#. de: Früher konnte ein Mann vom Kupferabbau gut leben.
#. fr: Pas envie d'entendre tes plaintes.
msgctxt "Balloon:700:0:1"
msgid "愚痴は掘った穴に叫べよ"
msgstr "Хочешь поныть — кричи в выкопанную яму."

#. ja: 銅山は閉鎖かねェ…
#. de: Diese verdammten Abenteurer machen die Preise kaputt.
#. fr: Qu'est-ce qu'on va faire si on peut plus aller dans les Mines de Clochecuivre...<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:701:0:1"
msgid "Copperbell's done<br>for, I tell ye."
msgstr "Медное Колоколо закрывают,<br>говорю тебе."

#. ja: 考古学はロマンなのよ！
#. de: Seid ihr denn zu gar nichts zu gebrauchen?
#. fr: Soyez plus attentifs la prochaine fois<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:702:0:1"
msgid "If I told you once, I've<br>told you a thousand times!"
msgstr "Сколько раз повторять?!<br>Я тебе уже тысячу раз говорил!"

#. ja: 未使用
#. de: Es wird nicht wieder vorkommen!
#. fr: 未使用
msgctxt "Balloon:703:0:1"
msgid "未使用"
msgstr "Не используется"

#. ja: 遺跡の調査に戻りたい…
#. de: Vergebt uns!
#. fr: Pardon...
msgctxt "Balloon:704:0:1"
msgid "Forgive us!"
msgstr "Простите нас!"

#. ja: また始まった…
#. de: Entschuldigt, Meister.
#. fr: Ça ne se reproduira plus.
msgctxt "Balloon:705:0:1"
msgid "My apologies, Master."
msgstr "Прошу прощения, господин."

#. ja: 申告漏れは許さないわよん
#. de: Fass etwas an und Blutige Steinschleuder hier reißt dir die Arme aus.
#. fr: Nous ne tolérons aucun oubli dans les déclarations<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:706:0:1"
msgid "Touch anything, and<br>Bloody Catapult here<br>will tear your arms off."
msgstr "Тронешь что-нибудь —<br>эта Кровавая Катапульта<br>тебе руки оторвёт."

#. ja: 未使用
#. de: Du hast nicht zufällig eine Karawane auf dem Weg hierhin gesehn?
#. fr: 未使用
msgctxt "Balloon:707:0:1"
msgid "未使用"
msgstr "Не используется"

#. ja: ここに署名だ
#. de: Unterschreiben Sie hier ...<br>hier ... und hier ...<br>Oh, und hier.
#. fr: N'oubliez pas de signer les trois exemplaires.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:708:0:1"
msgid "Sign there...there...there...<br>and there......oh, and there."
msgstr "Подпишите тут... тут... тут...<br>и тут... О, и здесь тоже."

#. ja: 検品の受付は奥だ
#. de: Der Schalter für die Wareninspektion befindet sich hinten.
#. fr: Le bureau des inspecteurs se trouve au fond.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:709:0:1"
msgid "The assessors' office<br>lies in the rear."
msgstr "Приёмная оценщиков<br>в конце коридора."

#. ja: 未使用710
#. de: Haben Sie noch etwas mehr Tinte?
#. fr: 未使用710
msgctxt "Balloon:710:0:1"
msgid "未使用710"
msgstr "Не используется710"

#. ja: これじゃ鼻血もでねェよ
#. de: Vielleicht könnten ein oder zwei Münzen die Sache beschleunigen.
#. fr: Je n'ai même pas de quoi payer...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:711:0:1"
msgid "Perhaps a coin or two<br>could speed things up."
msgstr "Может, пара монет<br>ускорит дело."

#. ja: 未使用
#. de: Fünf ... Sechs ... Sieben? Diese betrügerische Ratte!
#. fr: 未使用
msgctxt "Balloon:712:0:1"
msgid "未使用"
msgstr "Не используется"

#. ja: 一列に並べ！
#. de: Schön inner Reihe aufstellen, Freunde! Zeit für die Wareninspektion.
#. fr: En rang, devant moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:713:0:1"
msgid "Get the birds out<br>of here! Now!"
msgstr "Уберите птиц<br>отсюда! Живо!"

#. ja: 未使用
#. de: Where to next...?
#. fr: 未使用
msgctxt "Balloon:714:0:1"
msgid "未使用"
msgstr "Не используется"

#. ja: 長旅ごくろうさん
#. de: Ganz ruhig. Bin ja fast fertig.
#. fr: Douuucement... J'ai presque fini.
msgctxt "Balloon:715:0:1"
msgid "Easy. I'm almost done."
msgstr "Тихо. Я почти закончил."

#. ja: 未使用
#. de: Ganz ruhig. Nur drei Säcke heute.
#. fr: 未使用
msgctxt "Balloon:717:0:1"
msgid "未使用"
msgstr "Не используется"

#. ja: 未使用
#. de: Nicht zu eng, oder, Junge?
#. fr: 未使用
msgctxt "Balloon:718:0:1"
msgid "未使用"
msgstr "Не используется"

#. ja: 給料分は守ってやるか
#. de: Zzz ...
#. fr: Au nom de ma paie<nbsp>!
msgctxt "Balloon:719:0:1"
msgid "給料分は守ってやるか"
msgstr "За такую плату можно и постоять за них."

#. ja: はぁ～ちょっと一休み
#. de: Nie wieder ziehe ich die Reise von Gridania in einem Tag durch.
#. fr: Pfiouuu<nbsp>! C'est la dernière fois que je fais le voyage depuis Gridania d'une traite...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:720:0:1"
msgid "Never again will I assay<br>the ride from Gridania<br>in a single turn of the sun."
msgstr "Больше ни за что не поеду<br>из Гридании за один день."

#. ja: 盛況、盛況！
#. de: Ich habe ein Auge auf den zwielichtigen Haufen hier!
#. fr: Vous pouvez compter sur moi pour faire régner l'ordre ici.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:721:0:1"
msgid "I've my eye on each<br>and every one of this<br>unsavory lot!"
msgstr "Я за каждым<br>из этой сомнительной<br>компании слежу!"

#. ja: 代表者が中に入れ
#. de: Hast du was zu trinken?<br>Nö? Dann zieh Leine.
#. fr: Le re<shy>pré<shy>sen<shy>tant peut entrer.
msgctxt "Balloon:722:0:1"
msgid "代表者が中に入れ"
msgstr "Представитель — внутрь."

#. ja: 小役人め…偉そうに
#. de: Die schwächsten Hyänen knurren am lautesten.
#. fr: Pour qui il se prend, celui-là<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:723:0:1"
msgid "Come over here and say<br>that, you baseborn dog!"
msgstr "Эй, подойди сюда и повтори!<br>Ах ты, безродный пёс!"

#. ja: クェッ？
#. de: Kweeeh!?
#. fr: Kwééé<nbsp>!?
msgctxt "Balloon:724:0:1"
msgid "クェッ？"
msgstr "Кве?"

#. ja: さて、そろそろ出発か
#. de: Nun, ich könnte mich von ihm trennen ... für einen anständigen Preis.
#. fr: Je peux peut-être m'en séparer... pour le bon prix.
msgctxt "Balloon:725:0:1"
msgid "さて、そろそろ出発か"
msgstr "Ну что, пора отправляться."

#. ja: いいチョコボだなあ
#. de: Einen Vogel wie diesen könnte ich gut gebrauchen.
#. fr: C'est un beau chocobo que vous avez là.
msgctxt "Balloon:726:0:1"
msgid "いいチョコボだなあ"
msgstr "Хороший у тебя чокобо."

#. ja: 未使用
#. de: Noch länger und der Kapitän wird uns kielholen!
#. fr: Le capitaine ne va pas tarder à nous dénoncer<nbsp>!
msgctxt "Balloon:727:0:1"
msgid "未使用"
msgstr "Не используется"

#. ja: これでよし、と……
#. de: Du machst dir zu viel Sorgen! Der Kapitän ist Malme weit weg.
#. fr: Neuf, dix, onze...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:728:0:1"
msgid "Five...six...seven? Why,<br>that double-crossing rat!"
msgstr "Пять... шесть... семь? Да<br>этот двуличный крысёныш!"

#. ja: 関税高ェよ！
#. de: Zwei Tage!? So lange können wir nicht warten!
#. fr: Ces taxes sont trop élevées... C'est une honte<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:729:0:1"
msgid "Two days!? We<br>cannot wait that long!"
msgstr "Два дня?! Мы<br>столько ждать не можем!"

#. ja: …ふぅ
#. de: Ich schwöre, die verdammte Sonne ist seit der Katastrophe heißer geworden.
#. fr: La vache, quelle chaleur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:730:0:1"
msgid "I swear that bloody sun's<br>hotter since the Calamity."
msgstr "Клянусь, это проклятое солнце после Бедствия стало жарче."

#. ja: …ぐー…
#. de: Geschlafen? Quatsch, hab nur kurz meditiert!
#. fr: J'dormais pas, juré<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:732:0:1"
msgid "Sleeping!? I was merely<br>shielding my eyes from<br>the sun!"
msgstr "Спал?! Да я просто<br>от солнца глаза прикрывал!"

#. ja: この様式は…
#. de: Yalik senleh ... ahamat<br>zah ... Oder heißt es jah ...?
#. fr: Yalik senleh...ahamat zah... Ou était-ce jah...?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:733:0:1"
msgid "Yalik senleh...ahamat<br>zah... Or is it jah...?"
msgstr "Ялик сенлех... ахамат<br>зах... Или всё-таки джах?.."

#. ja: なるべく丁寧に扱いたまえ
#. de: Schneller, Jungs! Wir haben nicht den ganzen Tag Zeit.
#. fr: Surtout, allez-y délicatement<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:734:0:1"
msgid "Quickly now, lads!<br>We haven't all day."
msgstr "Пошевеливайтесь, ребята!<br>У нас не весь день впереди."

#. ja: ベラフディア時代の遺跡か
#. de: Der Eingang muss hier irgendwo sein!
#. fr: Des vestiges de l'ancienne Belah'dia...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:735:0:1"
msgid "The entrance must<br>be here somewhere!"
msgstr "Вход где-то<br>здесь должен быть!"

#. ja: 考古学って案外地味だなァ
#. de: Warum heuern wir nicht ein paar Bengel aus dem Steinwurf-Slum dafür an?
#. fr: Pourquoi c'est toujours les mêmes qui font le sale boulot<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:736:0:1"
msgid "Could we not simply hire<br>a few urchins from<br>Stonesthrow to do this?"
msgstr "Может, нанять пару беспризорников из Камнеброса, пусть всё сделают?"

#. ja: おおっ、これはもしや…
#. de: Gib mir mal das ...<br>Oh, du bist nur <if $gn4>'ne Abenteurerin<else>'n Abenteurer</if> ...
#. fr: Approche un peu la lam... Oh, mes excuses, aventuri<if $gn4>ère<else>er</if>.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:737:0:1"
msgid "Hand me that lan─<br>Oh, another adventurer..."
msgstr "Подай мне ту лам─<br>О, ещё один искатель приключений..."

#. ja: うわ、苔がヌルヌルだ
#. de: Ich hätte meine Robe im Ossarium lassen sollen.
#. fr: Flûte, ma robe est trempée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:738:0:1"
msgid "I should have left my<br>robe back at the Ossuary."
msgstr "Надо было оставить<br>мантию в Костнице."

#. ja: こんな調査が金になるのかねェ
#. de: Ich sehe hier nur einen Haufen Dreck.
#. fr: Tant que l'Ossuaire y trouve son compte...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:739:0:1"
msgid "I see naught<br>but a pile o' rubble. "
msgstr "Тут одна груда<br>обломков, и больше ничего."

#. ja: き、君だよ…
#. de: Ich hoffe, du magst Orobon!
#. fr: J'espère que tu aimes l'orobon<nbsp>?
msgctxt "Balloon:740:0:1"
msgid "I hope you like orobon!"
msgstr "Надеюсь, ты любишь оробона!"

#. ja: 何釣るつもり？
#. de: Nur, wenn ich die Augen haben kann!
#. fr: Oui, surtout les yeux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:741:0:1"
msgid "Only if I can<br>have the eyes!"
msgstr "Только если мне<br>достанутся глаза!"

#. ja: せめて晩飯を…
#. de: Das Meer reicht bis zum Strande und dann verläuft's im Sande ...
#. fr: Pourvu que j'attrape au moins de quoi manger ce soir...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:742:0:1"
msgid "The Spinner pulls, but<br>the Wanderer pushes away."
msgstr "Прядильщик тянет, а<br>Странник отталкивает."

#. ja: 雑魚ばっかだな
#. de: Ein Fass voller Träume; eine Tasche voller Nichts.
#. fr: Des brèmes, encore des brèmes... Comment je gagne ma vie, moi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:743:0:1"
msgid "A barrel full o' bream;<br>a pocket full o' naught."
msgstr "Бочка лещей,<br>а в кармане — ни гроша."

#. ja: あと半日ってとこかな
#. de: Ob der Gestank verschwindet, wenn ich sie noch 'n bisschen länger trocknen lasse?
#. fr: Encore une demi-journée et elles seront parfaites.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:744:0:1"
msgid "These should fetch a<br>fine price at the markets."
msgstr "За них на рынке<br>дадут хорошую цену."

#. ja: あいつら、追っ払ってやる！
#. de: Wo ist mein Essen, Mädel?!
#. fr: Tu vas voir, je vais les chasser d'ici<nbsp>!
msgctxt "Balloon:745:0:1"
msgid "Where's my meal, woman!?"
msgstr "Где моя еда, женщина?!"

#. ja: そんな勇気もないクセに
#. de: Kannst es dir gerne selber kochen, mein Lieber!
#. fr: Tu dis ça, mais tu te dégonfles toujours le moment venu.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:746:0:1"
msgid "Get it your Twelve-<br>damned self, you lazy<br>son of a mutt."
msgstr "Сам себе готовь, чтоб тебя<br>Двенадцать побрали,<br>ленивый ты пёс!"

#. ja: 次の漁までもつかしら…
#. de: Lass bloß deinen Vater diesen Unsinn nicht hören!
#. fr: Ne répète pas ce genre de sottises devant ton père<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:747:0:1"
msgid "Don't let your da hear<br>you talk that nonsense!"
msgstr "Смотри, не ляпни такого<br>при отце!"

#. ja: おなかへったー
#. de: Wenn ich groß bin, werde ich ein Gourmet!
#. fr: Quand je serai grand, je serai cuisinier<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:748:0:1"
msgid "When I grow up, I want<br>to be a cully-narian!"
msgstr "Когда вырасту, хочу<br>стать кулинаром-чокобоведом!"

#. ja: 昔は立派な網元だったんだがな
#. de: <i>Eine</i> lausige Nacht im Pökelhaus und mein ganzer Körper stinkt nach Fisch!
#. fr: Une nuit à travailler en salaison et mes vêtements puent le poisson<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:749:0:1"
msgid "<i>One</i> lousy night in the<br>salting house, and me<br>whole body reeks o' cod!"
msgstr "<i>Всего</i> одну проклятую ночь<br>провёл в засолочной, а<br>воняю теперь треской с ног до головы!"

#. ja: くそ、エサをもってかれた
#. de: Verdammt, meine Köder sind weg!
#. fr: Ce maudit poisson a emporté mon appât<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:750:0:1"
msgid "Have any ale on you?<br>No? Then bugger off."
msgstr "Проклятая рыба утащила<br>мою наживку!"

#. ja: チンケな漁村だぜ
#. de: Hab keine Lust auf 'n weiteren Tag in diesem stinkenden Drecksloch!
#. fr: Pourquoi on se fait pas la malle de ce trou à rats<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:751:0:1"
msgid "Not <i>another</i> turn of<br>the sun in this piss'ole..."
msgstr "Ни <i>ещё одного</i> дня<br>в этой дыре, пропахшей мочой..."

#. ja: 潮時ってヤツだな
#. de: Die Winde stehen ungünstig.
#. fr: Les vents ne sont pas bons...
msgctxt "Balloon:752:0:1"
msgid "The winds just ain't right."
msgstr "Ветра нынче не те."

#. ja: 出稼ぎに行こうと思うの
#. de: Ist nicht euer Ernst, oder?
#. fr: Alors<nbsp>? Qu'est-ce qu'il a dit<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:753:0:1"
msgid "Mimilo's husband fell<br>asleep in the salting<br>house last night..."
msgstr "Мимило вчера ночью уснул<br>в засолочной..."

#. ja: 未使用
#. de: Mimilos Mann ist letzte Nach im Pökelhaus eingeschlafen ...
#. fr: 未使用
msgctxt "Balloon:754:0:1"
msgid "未使用"
msgstr "Не используется"

#. ja: 未使用
#. de: Und nun erzählt er jedem, er hätte die Nacht mit einer Meerjungfrau verbracht!
#. fr: 未使用
msgctxt "Balloon:755:0:1"
msgid "未使用"
msgstr "Не используется"

#. ja: 不味い肉だぜ
#. de: Muwahaha!
#. fr: Cette bidoche est vraiment dégueulasse<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:756:0:1"
msgid "Gah hah hah! \\<choke><br>\\<cough> Hah hah!"
msgstr "Га-ха-ха! <i>Кхе!</i><br><i>Кхе-кхе!</i> Ха-ха!"

#. ja: きゃはははははは！
#. de: Wer sagt denn, dass ich einen Mann brauche?
#. fr: Hahahaha<nbsp>!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:757:0:1"
msgid "Hah hah hah! Who says<br>I needs me a man?"
msgstr "Ха-ха-ха! Кто сказал,<br>что мне мужик нужен?"

#. ja: 酒だよ、酒もってきな！
#. de: Ich bin mehr Mann als du jemals brauchen wirst, Mädel!
#. fr: Bois plus d'alcool, ça passera mieux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:758:0:1"
msgid "I'm more man than<br>you'll ever need, lass!"
msgstr "Да я мужик получше любого,<br>кто тебе понадобится, девка!"

#. ja: 未使用：荒：会話00447
#. de: Kweh! Kweeeh!
#. fr: 未使用：荒：会話00447
msgctxt "Balloon:759:0:1"
msgid "未使用：荒：会話00447"
msgstr "Не используется:荒:会話00447"

#. ja: 未使用：荒：会話00448
#. de: Ich kann dich bis zum Skorpionen-Treff mitnehmen. Den Rest musst du laufen.
#. fr: 未使用：荒：会話00448
msgctxt "Balloon:760:0:1"
msgid "未使用：荒：会話00448"
msgstr "Не используется:荒:会話00448"

#. ja: 未使用：荒：会話00449
#. de: Ich benötige eine Eskorte nach Ul'dah.
#. fr: 未使用：荒：会話00449
msgctxt "Balloon:761:0:1"
msgid "未使用：荒：会話00449"
msgstr "Не используется:荒:会話00449"

#. ja: 未使用：荒：会話00450
#. de: Und ich sage dir, in Limsa sind eine Menge Gil zu machen.
#. fr: 未使用：荒：会話00450
msgctxt "Balloon:762:0:1"
msgid "未使用：荒：会話00450"
msgstr "Не используется:荒:会話00450"

#. ja: 未使用：荒：会話00451
#. de: Nun, wir werden keine verdienen, solange wir hier rumsitzen.
#. fr: 未使用：荒：会話00451
msgctxt "Balloon:763:0:1"
msgid "未使用：荒：会話00451"
msgstr "Не используется:荒:会話00451"

#. ja: 未使用：荒：会話00452
#. de: Es gibt in Thanalan genug Gelegenheiten, einen Profit zu machen!
#. fr: 未使用：荒：会話00452
