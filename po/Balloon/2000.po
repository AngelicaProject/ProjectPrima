# Balloon
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: これで全部だ
#. de: Gut, dann hätten wir alles beisammen.
#. fr: Aurez-vous aussi besoin de ces outils, Monseigneur<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2000:0:1"
msgid "Will ye be needin' these<br>tools as well, milord?"
msgstr "А эти<br>инструменты тоже нужны, милорд?"

#. ja: うるせーババァ
#. de: Von wegen!
#. fr: Tu me dis à <i>moi</i> quand <i>tu</i> en as assez.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2001:0:1"
msgid "You tell <i>me</i> when<br><i>you've</i> had enough."
msgstr "Это ты мне скажи, когда<br><i>тебе</i> уже <i>самому</i> хватит."

#. ja: もうバテたか？
#. de: Machst du etwas schon schlapp?
#. fr: Dis-moi juste quand tu en as assez, quoi.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2002:0:1"
msgid "Just tell me when<br>you've had enough, now."
msgstr "Ну так скажи, когда<br>хватит."

#. ja: 来季の小麦は完売だ
#. de: Was soll ich machen? Meine Vorräte sind nun mal schon ausverkauft.
#. fr: Nous n'avons plus de blé aujourd'hui.
msgctxt "Balloon:2003:0:1"
msgid "We've no more wheat today."
msgstr "Пшеницы на сегодня больше нет."

#. ja: お宅のじゃなきゃ困る！
#. de: Ohne dein Mehl kann ich meine Bäckerei dichtmachen!
#. fr: Vous avez dit la même chose hier<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2004:0:1"
msgid "You said the<br>same yesterday!"
msgstr "Ты и вчера<br>то же самое говорил!"

#. ja: わざわざ来たのに
#. de: Soll das 'n Witz sein? Ich bin extra aus Ul'dah angereist!
#. fr: J'ai cinq enfants à nourrir<nbsp>!
msgctxt "Balloon:2005:0:1"
msgid "I have five kids to feed!"
msgstr "Мне пятерых детей кормить!"

#. ja: ちっ出遅れた
#. de: Ausverkauft? Du beliebst zu scherzen!
#. fr: Mes gils paient aussi bien que ceux des autres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2006:0:1"
msgid "My coin is as good<br>as the next man's!"
msgstr "Мои деньги ничуть не хуже<br>чужих!"

#. ja: 元気出して…
#. de: Armer Piepmatz ...
#. fr: Je suis désolé, Lucky...
msgctxt "Balloon:2007:0:1"
msgid "I'm sorry, Lucky..."
msgstr "Бедняга, Лаки..."

#. ja: ラベンダーの注文です
#. de: Ich hätte gerne eine Wagenladung Lavendel.
#. fr: Encore une commande de lavande de la guilde des alchimistes.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2008:0:1"
msgid "Another order of lavender<br>from the Alchemists' Guild."
msgstr "Гильдия алхимиков снова заказала<br>лаванду."

#. ja: 最近、人気だな
#. de: Das Zeug geht in letzter Zeit weg wie warme Semmeln.
#. fr: Ah<nbsp>! Voilà qui va pas faire plaisir aux Gridaniens.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2009:0:1"
msgid "The Gridanians'll be none<br>too pleased 'bout that."
msgstr "Гриданийцам это совсем<br>не понравится."

#. ja: うちの小麦さね
#. de: Mein frischer Weizen natürlich!
#. fr: Euh... De la farine<nbsp>?
msgctxt "Balloon:2010:0:1"
msgid "Er... Flour?"
msgstr "Э-э... Мука?"

#. ja: 味の秘訣は…？
#. de: Und was ist das Geheimnis des guten Geschmacks?
#. fr: Il me faut absolument la recette de ce gruau<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2015:0:1"
msgid "You simply must tell me<br>the recipe for this gruel!"
msgstr "Ну расскажите же мне<br>рецепт этой каши!"

#. ja: クエッ
#. de: Kweh!
#. fr: Couac<nbsp>!
msgctxt "Balloon:2017:0:1"
msgid "Kwark!"
msgstr "Квак!"

#. ja: さっさとしろ
#. de: Beeil dich gefälligst!
#. fr: Tu veux que j'appelle une des trayeuses pour t'aider avec ça<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2019:0:1"
msgid "You need me to call<br>one of the milkmaids<br>to help you with that?"
msgstr "Позвать доярок,<br>чтобы помогли тебе<br>с этим?"

#. ja: よく働いた…
#. de: Ich rühr heut ganz bestimmt keinen Finger mehr.
#. fr: Je n'ai pas autant travaillé depuis... depuis hier<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2020:0:1"
msgid "I haven't worked so hard<br>since...since yesterday!"
msgstr "Я так не уставал<br>со вчерашнего дня!"

#. ja: むにゃむにゃ…
#. de: Ist es wirklich schon Zeit zum Aufstehen? \<gähn>
#. fr: Je réclame ce lit au nom de... moi-même<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2023:0:1"
msgid "I claim this bed<br>in the name of...me!"
msgstr "Застолблю эту кровать<br>от своего имени... от себя!"

#. ja: 明日は遅番さ
#. de: Morgen hab ich schon wieder Nachtschicht, verdammter Mist. Springst du für mich ein?
#. fr: Laissez-moi donc boire en paix.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2024:0:1"
msgid "Allow a man<br>a drink in peace."
msgstr "Да дайте же человеку<br>спокойно выпить."

#. ja: ク…エェェ…
#. de: \<krächz>
#. fr: Kwé-éé...
msgctxt "Balloon:2030:0:1"
msgid "Kwe...eh..."
msgstr "Кве...ээ..."

#. ja: 柵に帰るよ
#. de: Jetzt aber zurück in deinen Stall ...
#. fr: Retour au bercail, mon gars.
msgctxt "Balloon:2034:0:1"
msgid "Back to the corral, boy."
msgstr "А теперь в загон, мальчик."

#. ja: しっかりしろ…
#. de: Kopf hoch, Kleiner! Das wird schon wieder.
#. fr: Si ça continue, nous allons devoir l'abattre...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2042:0:1"
msgid "We've no choice but to<br>put the poor beast down."
msgstr "Придётся беднягу<br>прикончить."

#. ja: 散歩して疲れさせよう
#. de: Treib sie auf die Weide, Auslauf macht müde.
#. fr: Maïs et laitue, Monsieur.
msgctxt "Balloon:2043:0:1"
msgid "Millioncorn and lettuce, sir."
msgstr "Кукуруза и салат, сэр."

#. ja: 肥料を変えよう
#. de: Paperlapapp, einfach den Dünger wechseln, sag ich!
#. fr: Vous avez déjà vu un coq rouge<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2045:0:1"
msgid "You ever seen<br>a red rooster?"
msgstr "Ты когда-нибудь видел<br>красного петуха?"

#. ja: 豆を植えれば？
#. de: Vielleicht sollten wir lieber Bohnen anpflanzen.
#. fr: Seulement après en avoir frit un avec du piment dragon.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2046:0:1"
msgid "Only after I've fried<br>one in dragon peppers."
msgstr "Только если пожарю его<br>с драконьим перцем."

#. ja: いったん置かせてくれ
#. de: Lass mich die Kiste wenigstens kurz abstellen.
#. fr: Mais on nous a dit précisément la cabane du sud.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2047:0:1"
msgid "But we were specifically<br>told the south shiel."
msgstr "Но нам же велели<br>именно в южный шалаш."

#. ja: 羊毛が足りん
#. de: Ich brauche mehr Wolle!
#. fr: Les moutons sont si pleins qu'ils peuvent pas bouger<nbsp>! Vous leur donnez quoi<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2049:0:1"
msgid "The sheep are so en-<br>gorged, they can't move!<br>What is that feed!?"
msgstr "Овцы так объелись,<br>что с места не сдвинутся!<br>Чем вы их кормите?!"

#. ja: キャンセル待ちか…
#. de: Was soll das heißen, „warten“?! Ich sehe drei freie Tische!
#. fr: Comment ça, <i>attendre</i><nbsp>? Je vois trois tables vides<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2056:0:1"
msgid "What do you mean “<i>wait</i>”?<br>I see three open tables!"
msgstr "Что значит «<i>подождать</i>»?<br>Вон три свободных стола!"

#. ja: 困りますぅ
#. de: Wir nehmen die Maultaschen auf keinen Fall wieder mit nach Hause!
#. fr: Et si vous preniez une caisse pour vous-même<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2057:0:1"
msgid "How about you take a<br>crate for yourself?"
msgstr "Может, возьмёте<br>ящик себе?"

#. ja: 没収だってぇ！？
#. de: Einfuhr abgelehnt? Was soll das heißen?
#. fr: Ça coûte une fortune<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2058:0:1"
msgid "Those dream flowers<br>cost us a fortune!"
msgstr "Эти цветы-мечты<br>целое состояние стоят!"

#. ja: お魚さん、来い来い～
#. de: Kommt liebe Fischchen, kommt zu Mama!
#. fr: Appelle-moi encore comme ça et ce seau finit sur ta tête.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2059:0:1"
msgid "Call me that again<br>and this bucket goes<br>on your head."
msgstr "Назовёшь меня так ещё раз —<br>ведро окажется<br>у тебя на голове."

#. ja: 商談か？
#. de: Für den Deal hier? Ansonsten verschwinde!
#. fr: Tu viens voir le cap'taine<nbsp>?
msgctxt "Balloon:2061:0:1"
msgid "Business with the cap'n?"
msgstr "Капитану по делу?"

#. ja: 柵が壊れちまってな
#. de: Die dummen, fetten Vögel rennen andauernd den Zaun um. Ist das zu fassen?
#. fr: Ces maudites volailles arrêtent pas de sauter la palissade...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2062:0:1"
msgid "Damned fowl keep<br>kicking over the paling..."
msgstr "Проклятая птица всё время<br>сносит ограду..."

#. ja: 遊びましょ～
#. de: Dann zeig mal deine <i>Ware</i> ...
#. fr: Est-ce que c'est vrai, ce qu'ils disent sur le Clan de la Mer<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2063:0:1"
msgid "Is it true what they<br>say about Sea Wolves?"
msgstr "Правда, что говорят<br>о морских волках?"

#. ja: ステキな商人さん
#. de: ... stattliches Händlerlein.
#. fr: Et ces sceptres dorés<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2064:0:1"
msgid "And your <i>gilded scepters</i>?"
msgstr "А что насчёт твоих <i>позолоченных скипетров</i>?"

#. ja: ガッハッハッハ
#. de: Muwahahaha!
#. fr: Si ça vous travaille, pourquoi ne pas trouver par vous-même<nbsp>?
msgctxt "Balloon:2065:0:1"
msgid "Why don't you find out?"
msgstr "А почему бы самому не проверить?"

#. ja: クンクン
#. de: Fiep, fiep?
#. fr: (snif) (snif)
msgctxt "Balloon:2066:0:1"
msgid "\\<sniff> \\<sniff>"
msgstr "\\<sniff> \\<sniff>"

#. ja: しーっ…起こさないであげて
#. de: Pssst ... Ich glaube, er hat 'nen ziemlichen Kater.
#. fr: Je crois qu'il a bu un coup de trop.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2067:0:1"
msgid "I think he may have had<br>one too many sips."
msgstr "Кажется, он вчера<br>перебрал."

#. ja: 帝国軍の動きが心配だわ
#. de: Wenn ihr wieder die ganzen Rosinen auffuttert, dann kommt euch der böse Gaius holen!
#. fr: Je ne me sens pas en sécurité ici. On est si proches des Impériaux...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2068:0:1"
msgid "I do not feel safe with<br>the imperials so close..."
msgstr "Мне неспокойно, когда<br>имперцы так близко..."

#. ja: 1565年の赤です
#. de: Dies sind die einzigen Flaschen jenes vortrefflichen Jahrgangs, die die Katastrophe überstanden haben.
#. fr: Ce sont les seuls à avoir survécu au Fléau.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2069:0:1"
msgid "These were the only ones<br>to survive the Calamity."
msgstr "Это единственные бутылки,<br>пережившие Бедствие."

#. ja: うむ、3本もらおう
#. de: Gib mir zehn davon! Der Preis spielt keine Rolle!
#. fr: Alors je prends dix bouteilles ! Peu importe le prix !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2070:0:1"
msgid "Then I'll take ten bottles!<br>Price is no object!"
msgstr "Тогда беру десять бутылок!<br>Цена не имеет значения!"

#. ja: へぇ、すいません…
#. de: Dabei habt <i>Ihr</i> doch immer geschagt, man scholl kennen, wasch man den Kunden verkauft, Meister ... \<hicks>
#. fr: Son mari était parti. Je ne pensais pas à mal.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2071:0:1"
msgid "Her husband had left.<br>I meant no harm, sir."
msgstr "Её муж ушёл.<br>Я не хотел ничего плохого, сэр."

#. ja: どうだいこの枝ぶり！
#. de: Eine Traube schöner als die andere! Der Meister wird höchst erfreut sein!
#. fr: Tout va bien ici<nbsp>!
msgctxt "Balloon:2072:0:1"
msgid "Not a sign of the blight!"
msgstr "Ни следа гнили!"

#. ja: 美味しく実ってね♪
#. de: Das wird ein fantastischer Jahrgang, glaub's mir.
#. fr: Les raisins vont faire une bonne cuvée cette année.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2073:0:1"
msgid "This year's grapes'll<br>make a fine vintage."
msgstr "В этом году виноград<br>даст отличное вино."

#. ja: 姉ェちゃんもう1本！
#. de: Dasselbe noch mal, Schätzchen. Und schreibs auf <i>ihre</i> Rechnung.
#. fr: Une autre tournée, ma belle ! Et mets-la sur <i>son</i> ardoise !
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2074:0:1"
msgid "Another round, wench!<br>And put it on <i>her</i> tab!"
msgstr "Ещё кружечку, красотка!<br>Запиши на <i>её</i> счёт!"

#. ja: もう、最低…
#. de: Das ist doch wirklich das Letzte!
#. fr: Vous êtes prêt à discuter les termes de notre accord ?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2075:0:1"
msgid "Are you ready to discuss<br>the terms of our accord?"
msgstr "Готовы обсудить<br>условия нашего соглашения?"

#. ja: やはり赤には肉料理か？
#. de: Vielleicht doch ein Fleischgericht?
#. fr: Du vin rouge pour ton repas ? T'auras ce que je te donnerai, ouais.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2076:0:1"
msgid "Red wine with yer meal?<br>Ye'll get what I give ye."
msgstr "Красное вино к еде?<br>Будешь пить, что налью."

#. ja: お水～じょろじょろ～
#. de: Wasser ist zum Gießen da ... Lalala ... ♪
#. fr: Je peux pas me concentrer si vous restez devant moi.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2077:0:1"
msgid "I cannot well concentrate<br>with ye gawpin' at me, now."
msgstr "Не могу сосредоточиться,<br>когда ты так пялишься."

#. ja: 飼葉が湿ってやがる
#. de: Verdammt, das Futter ist schon wieder so feucht wie 'n Küchenschwamm.
#. fr: Pourquoi le chef veut toujours qu'on porte ces masques avec cette chaleur !?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2078:0:1"
msgid "Why must the stable-<br>master insist we wear<br>these masks in this heat!?"
msgstr "Почему конюх настаивает,<br>чтобы мы носили маски<br>в такую жару?!"

#. ja: くかあぁ～
#. de: Wehe, du verpfeist uns!
#. fr: Zzzzzz...
msgctxt "Balloon:2079:0:1"
msgid "Zzzzzz..."
msgstr "Ззззз..."

#. ja: すぴゅるる…
#. de: Dumdidum ...
#. fr: (grogne)
msgctxt "Balloon:2080:0:1"
msgid "\\<snortle>"
msgstr "\\<snortle>"

#. ja: あいつらどこ行ったの？
#. de: Wo sind sie wohl hin?
#. fr: Mais où sont donc passés ces deux-là !?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2081:0:1"
msgid "Where in the seven hells<br>did those two run off to!?"
msgstr "Да где, во имя семи преисподних,<br>эти двое пропали?!"

#. ja: だいぶ傷んでるわね
#. de: Ganz schön mitgenommen ...
#. fr: Ces flèches ne tiendront pas une autre bataille...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2082:0:1"
msgid "These notched blades<br>couldn't even cut butter..."
msgstr "Эти зазубренные клинки<br>масло не разрежут..."

#. ja: いっちょやったるか～
#. de: Eins könnt ich eigenlich noch vertragen ...
#. fr: On va se farcir quelques monstres, oh que ouais.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2083:0:1"
msgid "Gonna skin us some<br>fishbacks, we are."
msgstr "Сейчас мы выпотрошим<br>парочку рыбомордых."

#. ja: はぁ、今晩もクラゲかぁ…
#. de: Ich kann das fiese Quallen-Gulasch langsam nicht mehr sehen!
#. fr: Vous auriez pas du dodo séché ? J'en ai ras-le-bol de bouffer des méduses.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2084:0:1"
msgid "Might ye 'ave some<br>jerked dodo? I've had<br>more'n me fill o' jellyfish."
msgstr "Нет ли у вас вяленого додо?<br>С меня уже довольно этих медуз."

#. ja: 必殺サハギン三枚下ろし！
#. de: Filetierter Sahagin an Preiselbeersoße, bitte!
#. fr: Ah, qu'est-ce que je ne donnerais pas pour repartir en mer.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2085:0:1"
msgid "Oh, what I wouldn't give<br>to be back on the Deep."
msgstr "Чего бы я только не отдал,<br>чтобы снова выйти в открытое море."

#. ja: 作戦に異論は？
#. de: Irgendwelche Einwände gegen diesen Plan?
#. fr: Ne pas laissez pas les Sahuagins gagner la terre ferme !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2086:0:1"
msgid "Never allow the fish-<br>backs the upper ground!"
msgstr "Ни за что не позволим<br>рыбомордым занять высоту!"

#. ja: 今が好機！
#. de: Jetzt ist die Gelegenheit!
#. fr: Il faut battre le fer tant qu'il est chaud !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2087:0:1"
msgid "We must strike<br>while the iron is hot!"
msgstr "Надо бить,<br>пока горячо!"

#. ja: 動き理解した？
#. de: Hast du's endlich kapiert?
#. fr: Mais avec quoi ? On reste vraiment en infériorité numérique !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2088:0:1"
msgid "But strike them with<br>what? We remain<br>sorely undermanned!"
msgstr "А чем бить-то?<br>Нас ведь куда меньше!"

#. ja: 新兵器の試作には…
#. de: Für den Test der neuen Waffe ...
#. fr: Est-ce que les balistes sont prêtes à être déployées ?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2089:0:1"
msgid "Are the ballistas<br>ready for deployment?"
msgstr "Балисты готовы<br>к развёртыванию?"

#. ja: それより武器弾薬！
#. de: Was ist mit der Munition?
#. fr: Ces machines ne nous servent à rien du tout sans hommes pour les utiliser !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2090:0:1"
msgid "Those contraptions do<br>us little good without<br>men to operate them!"
msgstr "От этих штуковин мало толку,<br>если ими некому управлять!"

#. ja: 早くしなさいよ
#. de: Mach hinne!
#. fr: J'ai une main de libre, si la caisse est trop lourde.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2091:0:1"
msgid "I've an 'and free, if that<br>crate's too much fer ye."
msgstr "Если ящик тебе не поднять,<br>у меня одна рука свободна."

#. ja: 備蓄数よ～し
#. de: Die Vorräte sind aufgefüllt!
#. fr: Je crois qu'il y en aura pas assez pour chauffer le goudron.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2092:0:1"
msgid "I fear there won't be<br>enough to boil the pitch."
msgstr "Боюсь, смолы не хватит,<br>чтобы вскипятить котёл."

#. ja: …マジで？
#. de: Wirklich?
#. fr: Z'avez entendu parler du Cimetière de bateaux ?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2093:0:1"
msgid "You 'eard of the<br>Ship Graveyard?"
msgstr "Слыхал про<br>Кладбище кораблей?"

#. ja: でるんだってよ…
#. de: Es geht los ...
#. fr: Ouaip, y paraît que ça grouille de revenants<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2094:0:1"
msgid "Aye, 'tis crawling with all<br>manner of dark spirits!"
msgstr "Ага, там полно всякой<br>нечисти!"

#. ja: 特製エール召しあがれ♪
#. de: Lasst Euch unser Dunkelbier schmecken!
#. fr: Vous voudriez pas un peu d'ragoût avec vot' bière ?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2095:0:1"
msgid "How'd ye fancy a bowl<br>o' stew with yer brown?"
msgstr "Не желаете тарелку рагу<br>к тёмному пиву?"

#. ja: 酔ってないれろ！
#. de: Isch bin übahaupt nich beschoffen!
#. fr: Ah ben tiens, c'est... comment déjà... Rah, je sais plus mais j'vous ai déjà vu<if $gn4>e</if> avant.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2096:0:1"
msgid "Ye look right ferm... Far...<br>Mill... Farmar... Aye, I<br>reckon I's seen ye afore."
msgstr "Ты мне кажешься знако... знако...<br>ферм... ферм... Ага,<br>кажется, я тебя уже встречал."

#. ja: その額で手を打ちましょう
#. de: Damit machen wir's!
#. fr: Les cieux n'ont pas été cléments avec les récoltes.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2097:0:1"
msgid "The skies haven't been<br>kind to the harvest."
msgstr "Небо не пощадило<br>урожай."

#. ja: 御用の際は是非！
#. de: Stets zu Diensten!
#. fr: T'as besoin d'une femme comme moi pour surveiller tes arrières !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2098:0:1"
msgid "Ye need a woman as<br>me to watch yer backs!"
msgstr "Тебе нужна такая женщина, как я,<br>чтобы прикрывать спину!"

#. ja: 軽い軽い
#. de: Leicht wie eine Feder!
#. fr: Où est ce foutu bateau ? J'ai mal aux épaules !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2099:0:1"
msgid "Where's the bloody boat?<br>Me shoulder aches!"
msgstr "Где эта чёртова лодка?<br>Плечо уже ноет!"

#. ja: その荷物ヤバいぜ…
#. de: Das Ding wiegt gefühlt 'ne Tonze.
#. fr: Eh bien, en tout cas elle te voit <i>toi</i> en train de te ridiculiser avec cette boîte.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2100:0:1"
msgid "Well, she can <i>certainly</i><br>see <i>you</i> making an arse<br>of yourself with that box."
msgstr "Ну, зато она <i>точно</i><br>увидит, как <i>ты</i> тут<br>корчишься с этим ящиком."

#. ja: んなわけ…グギッ！
#. de: Ach Qua... Au, mein Kreuz!
#. fr: Tu crois qu'elle peut nous voir ?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2101:0:1"
msgid "You think she<br>can see us?"
msgstr "Думаешь, она<br>нас видит?"

#. ja: 酒税はまからないわよ
#. de: Die Alkoholsteuer bleibt, basta.
#. fr: Le tarif de la bière est passé à deux cents gils par fût.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2102:0:1"
msgid "The tariff on ale has<br>risen 200 gil per barrel."
msgstr "Пошлина на эль выросла<br>на 200 гил за бочку."

#. ja: やめろって、恥ずかしい
#. de: Hör auf damit, ist doch total peinlich!
#. fr: L'est peut-être temps de t'acheter de nouvelles lunettes.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2103:0:1"
msgid "Might be time you got a<br>new pair o' spectacles."
msgstr "Пора бы тебе обзавестись<br>новыми очками."

#. ja: いや～でけェ船だっぺ～
#. de: Hoho, ganz schön große Schiffchen ...
#. fr: Ces montagnes sont énormes !
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2104:0:1"
msgid "Those mountains are<br>simply <i>enormous</i>!"
msgstr "Да эти горы просто<br><i>огромные</i>!"

#. ja: こんなところに何用だ？
#. de: Was willst du hier?
#. fr: T'es avec eux ou quoi ?
msgctxt "Balloon:2105:0:1"
msgid "You one of their mates?"
msgstr "Ты с ними заодно?"

#. ja: 火薬はもっと丁寧に…
#. de: Schießpulver will mit Vorsicht gehandhabt werden, du Idiot!
#. fr: Fais gaffe avec cette poudre, espèce d'imbécile !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2106:0:1"
msgid "Be careful with that<br>firesand, you fool!"
msgstr "Осторожнее с этим<br>огнепеском, дурень!"

#. ja: えっと、教本通りなら…
#. de: Also, wenn's nach dem Lehrbuch geht ...
#. fr: Ce canon n'est plus en bon état de marche !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2107:0:1"
msgid "The trunnion is warped<br>and the cascabel cracked!"
msgstr "Цапфа погнута,<br>а казённик треснул!"

#. ja: エールには魚料理よね
#. de: Fisch schwimmt am liebsten in Dunkelbier, hehe.
#. fr: Qu'est-ce qui accompagne bien la bière ? Plus de bière<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2108:0:1"
msgid "What goes well with<br>warm sour ale? More ale."
msgstr "Что хорошо подходит<br>к тёплому кислому элю? Ещё эль."

#. ja: あの船の臨検記録は…
#. de: Das Durchsuchungsprotokoll jenes Schiffes ...
#. fr: Je sais pas pourquoi je continue à chercher. Je vais jamais le trouver...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2109:0:1"
msgid "I don't know why I<br>keep looking. I'm never<br>going to find it..."
msgstr "Не знаю, зачем я<br>всё ищу. Всё равно<br>ничего не найду..."

#. ja: 理論上は正しいはずだ
#. de: Theoretisch müsste es so sein ...
#. fr: C'est pas parce que tu as toujours raison que tu as raison cette fois.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2110:0:1"
msgid "Just because you are<br>always right, doesn't<br>mean you are this time."
msgstr "То, что ты всегда прав,<br>ещё не значит,<br>что и на этот раз прав."

#. ja: うえっぷ、飲みすぎた～
#. de: Örks ... Ich hab ... wohl 'n bisschen tschu viel ... getrunken ...
#. fr: C'est l'meilleur son de cloche qu'j'ai jamais entendu.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2111:0:1"
msgid "That was the greatest<br>quarter bell o' me life."
msgstr "Это был лучший<br>удар в колокол в моей жизни."

#. ja: 大型船を手配してだな…
#. de: Ich brauch 'nen großen Kahn, keine Jolle, ist das klar?
#. fr: Le problème, c'est de transporter la bière jusqu'à Radz-at-Han sans qu'elle soit bue<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2112:0:1"
msgid "The problem is getting<br>the ale to Radz-at-Han<br>without it being drunk!"
msgstr "Проблема в том, как доставить<br>эль в Радз-ат-Хан,<br>чтобы его не выпили по дороге!"

#. ja: お前らたるんどるぞ！
#. de: Ihr seid der schlaffste Haufen, den ich kenne!
#. fr: J'ai bien envie de vous envoyer pourrir dans la cale, vous deux !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2113:0:1"
msgid "I've a mind to throw you<br>both in the brig to rot!"
msgstr "Я бы вас обоих<br>в трюм бросил гнить!"

#. ja: 知ってる？硝石の原料って…
#. de: Schon gewusst? Salpeter besteht aus ...
#. fr: Le capitaine les a pris en train de le faire comme des lapins dans son propre plumard !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2114:0:1"
msgid "You 'ear? The cap'n<br>caught 'em ruttin' like<br>rabbits in 'is very bunk!"
msgstr "Слыхал? Капитан застукал их,<br>когда они кувыркались, как кролики,<br>прямо в его койке!"

#. ja: オイ、ほどほどにしとけよ
#. de: Nie sah ich eine bezauberndere Frau als Euch.
#. fr: J'ai jamais vu d'aussi belle femme que toi.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2115:0:1"
msgid "I've never seen a woman<br>as beautiful as you."
msgstr "Никогда не встречал<br>женщины красивее тебя."

#. ja: ヒック、うっさい！
#. de: Süße Worte für einen Mann, der den saursten Wein fabriziert, den ich kenne!
#. fr: De bien jolis mots de la part de quelqu'un qui fait du si mauvais vin.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2116:0:1"
msgid "Sweet words comin' from<br>one who makes sour red."
msgstr "Красиво говоришь для того,<br>кто делает такое кислое красное."

#. ja: へぇ、ウルダハから？
#. de: Aus Ul'dah, sagst du?! Das ist doch wohl nicht einer dieser neuen Amphibienkarren, oder?
#. fr: Depuis Ul'dah, tu dis ? Et comment t'as passé le détroit avec ce machin !?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2117:0:1"
msgid "From Ul'dah, ye say?<br>How'd ye roll that thing<br>across the strait, then!?"
msgstr "Из Ульды, говоришь?<br>И как же ты перевёз эту штуку<br>через пролив?!"

#. ja: もっと優雅に！美しく！
#. de: Mehr Grazie! Mehr Anmut!
#. fr: Plus de grâce ! Plus d'élégance !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2118:0:1"
msgid "Faster! Harder!<br>Are you even listening!?"
msgstr "Быстрее! Сильнее!<br>Ты вообще слушаешь?!"

#. ja: 次の戦いは長そうだ…
#. de: Uns steht ein langer Krieg bevor ...
#. fr: J'crois bien qu'après la prochaine, je range l'épée pour de bon.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2119:0:1"
msgid "I'm thinkin' of layin' down<br>me sword after this next one."
msgstr "Думаю, после следующей битвы<br>заброшу меч."

#. ja: ぐおお…腹が…いてェェ…
#. de: Aua, mein Bauch ...
#. fr: Aaarrgh... J'ai trop mal au ventre...
msgctxt "Balloon:2120:0:1"
msgid "Agh, my belly hurts somethin' fierce!"
msgstr "Ай, живот болит ужасно!"

#. ja: ウボァァァァァァ…
#. de: \<würg> ...
#. fr: Blouaeurgh...
msgctxt "Balloon:2122:0:1"
msgid "Urggghhh..."
msgstr "Уррргх..."

#. ja: ナルザル神よ…お助けください…
#. de: Gütiger Nald'thal, stehe mir bei ...
#. fr: Ô Nald'thal, abrégez mes souffrances...
msgctxt "Balloon:2123:0:1"
msgid "O Nald'thal...ease my pain!"
msgstr "О, Налд'тал... избавь меня от боли!"

#. ja: 甘い夢を…見てたんだ…<br>終わらない…夢さ…
#. de: Ich hatte so einen süßen Traum ... Und jetzt ist mir schlecht ...
#. fr: J'ai fait un rêve doux... Un rêve sans fin...
msgctxt "Balloon:2124:0:1"
msgid "'Twas a dream so sweet... Now, it is a─hurk!─nightmare."
msgstr "Сон был такой сладкий... А теперь это... кхр... кошмар."

#. ja: …イエロー・ムーンちゃああん…
#. de: Gelber Moooond ...
#. fr: Aah... Yellow Moon...
msgctxt "Balloon:2125:0:1"
msgid "Yellow Moooooon..."
msgstr "Йеллоу Мун..."

#. ja: あぐっ…鎮まれ…俺の胃袋…！
#. de: Ich glaub ... meine Gedärme haben sich verknotet ...
#. fr: Urgh... Je n'aime pas cette sensation dans mes intestins...
msgctxt "Balloon:2126:0:1"
msgid "Will my raging innards know no peace!?"
msgstr "Да неужели мои бушующие кишки<br>никогда не успокоятся?!"

#. ja: …なんだか…とっても眠い…
#. de: Boah, bin ich fertig ...
#. fr: Je... J'ai très... sommeil... tout à coup...
msgctxt "Balloon:2127:0:1"
msgid "Stay awake, now. Just...stay...zzz..."
msgstr "Не засыпай... Только...<br>не засы... ззз..."

#. ja: イエロー・ムーン…イイ女だ…
#. de: Gelber Mond ... Was für 'ne tolle Frau ...
#. fr: Yellow Moon... C'est une chic fille...
msgctxt "Balloon:2128:0:1"
msgid "Yellow Moon. I've never seen a maid as fair..."
msgstr "Йеллоу Мун... Никогда не видел такой красавицы..."

#. ja: うぐっ…ううううっ…
#. de: Hm? \<würg>!
#. fr: Eeeuuurgh...
msgctxt "Balloon:2129:0:1"
msgid "Ugh... Urggghhh..."
msgstr "Уф... Уррргх..."

#. ja: なんだぁ！？
#. de: Was ist das?
#. fr: Qu'est-ce que c'est que ça<nbsp>!?
msgctxt "Balloon:2130:0:1"
msgid "What was that!?"
msgstr "Что это было?!"

#. ja: チョコボ…じゃない！？
#. de: Das ist aber ein komischer Chocobo.
#. fr: Pas un chocobo, en tout cas...
msgctxt "Balloon:2131:0:1"
msgid "'Twas...'twas no bird!"
msgstr "Это... это была не птица!"

#. ja: 元気じゃのぉ…
#. de: Ziemlich lebhaft ...
#. fr: Quelle belle bête<nbsp>!
msgctxt "Balloon:2132:0:1"
msgid "Such a spirited beast!"
msgstr "Какая резвая зверюга!"

#. ja: なんと珍妙な…
#. de: Welch sonderbares Wesen!
#. fr: Comme c'est étrange...
msgctxt "Balloon:2133:0:1"
msgid "How peculiar..."
msgstr "Как странно..."

#. ja: お母さん、あれは何ー？
#. de: Mami, Mami, was ist das für ein Tier?
#. fr: M'man<nbsp>! M'man<nbsp>! C'est quoi, ça<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2134:0:1"
msgid "Mummy, Mummy!<br>What was that thing?"
msgstr "Мам, мам!<br>Что это было?"

#. ja: ええと…何かしら…
#. de: Das, ähm, muss eine Antilope sein, mein Schatz.
#. fr: Euh... Eh bien, c'était... Demande plutôt à ton père, mon ange.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2135:0:1"
msgid "Why, that was a...er...<br>Why don't you ask<br>your father, sweetling?"
msgstr "Да это... э-э...<br>Спроси-ка лучше<br>папу, милый."

#. ja: スッゲー！はえー！
#. de: Verdammt flink auf den Hufen!
#. fr: Ouah<nbsp>! Quelle rapidité<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2136:0:1"
msgid "Cor! I ain't seen<br>nothin' like it!"
msgstr "Вот это да!<br>Такого я ещё не видел!"

#. ja: 人か？チョコボか？
#. de: Ist das ein ... Chocobo?
#. fr: C'était un humain... ou un chocobo<nbsp>?
msgctxt "Balloon:2137:0:1"
msgid "What in the heavens...!?"
msgstr "Да что же это такое?!"

#. ja: 馬だー！
#. de: Oh, ein Pferd!
#. fr: C'était un cheval<nbsp>!
msgctxt "Balloon:2138:0:1"
msgid "It's one o' them horses!"
msgstr "Это же лошадь!"

#. ja: よくわからんが頑張れ！
#. de: Ich verstehe zwar nicht, was hier vor sich geht, aber egal.
#. fr: Je sais pas trop ce qui se passe par ici, mais bon courage<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2139:0:1"
msgid "I don't know what the<br>hells's going on, but<br>keep up the good work!"
msgstr "Понятия не имею,<br>что тут, к чёрту, творится,<br>но так держать!"

#. ja: 行け行けーっ！
#. de: Schneller, schneller!
#. fr: Cours<nbsp>! Oui, cours plus vite<nbsp>!
msgctxt "Balloon:2140:0:1"
msgid "Faster! Faster!"
msgstr "Быстрее! Ещё быстрее!"

#. ja: ほう、興味深いな
#. de: Faszinierend.
#. fr: Très intéressant...
msgctxt "Balloon:2141:0:1"
msgid "Intriguing..."
msgstr "Любопытно..."

#. ja: チョコボより速い？
#. de: Schneller als Chocobos?
#. fr: Plus rapide qu'un chocobo<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2142:0:1"
msgid "It's burning up the<br>quarter malm!"
msgstr "За четверть мальма<br>и глазом не моргнуло!"

#. ja: ファイトー！
#. de: Gib alles!
#. fr: Allez<nbsp>! Encore un peu<nbsp>! Il ne faut pas s'arrêter<nbsp>!
msgctxt "Balloon:2143:0:1"
msgid "Don't give up!"
msgstr "Не сдавайся!"

#. ja: 格好いいじゃない
#. de: Bewundernswert ...
#. fr: J'aime tout par<shy>ti<shy>cu<shy>liè<shy>rement la couleur.
msgctxt "Balloon:2144:0:1"
msgid "Color me impressed..."
msgstr "Вот это впечатляет..."

#. ja: あと少しだぞ
#. de: Noch ein kleines Stück!
#. fr: Encore un peu<nbsp>! Plus que quelques yalms<nbsp>!
msgctxt "Balloon:2145:0:1"
msgid "Come on! You're almost there!"
msgstr "Давай! Уже почти!"

#. ja: 何か走ってるわ！
#. de: Du kannst aber flitzen!
#. fr: Il y a quelque chose qui vient par ici à toute allure<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2146:0:1"
msgid "Something majestic<br>this way runs!"
msgstr "Что-то величественное<br>мчится сюда!"

#. ja: キャー！ステキ！
#. de: Wie reizend!
#. fr: Oh là là<nbsp>! Je crois bien que je suis sous le charme<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2147:0:1"
msgid "Gods, I think I'm<br>in love... \\<sigh>"
msgstr "Боги, кажется, я<br>влюбилась... \\<вздох>"

#. ja: くらえ！　リーヴォルドッ！
#. de: Nimm dies, Leavold!
#. fr: C'est la fin pour toi<nbsp>!
msgctxt "Balloon:2300:0:1"
msgid "Enough! Let's finish this!"
msgstr "Хватит! Покончим с этим!"

#. ja: ギャーッハッハ！<br>死ね死ね死ね死ねぇ！！
#. de: Du Bastard!<br>Stirb, stirb, stirb!
#. fr: Crève, crève, crève<nbsp>! Crève mille fois et plus encore<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2301:0:1"
msgid "Die! Die! Die! Die a<br>thousand deaths an'<br>then die a thousand more!"
msgstr "Умри! Умри! Умри! Умри!<br>Тысячу раз умри,<br>а потом ещё тысячу!"

#. ja: きゃあ！<br>助けてッ！
#. de: Du musst uns hier rausholen!
#. fr: Vous devez nous sauver<nbsp>!
msgctxt "Balloon:2302:0:1"
msgid "You must save us!"
msgstr "Вы должны нас спасти!"

#. ja: 私は海賊じゃないわ！<br>間違えないでッ！
#. de: I-Ich gehöre nicht zu den Piraten! Das ist alles ein großes Miss<shy>ver<shy>ständ<shy>nis!
#. fr: Je ne suis pas avec eux<nbsp>! Je le jure sur le peu de vertu qu'il me reste<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2303:0:1"
msgid "I'm not one of them!<br>I swear it on what little<br>remains of my virtue!"
msgstr "Я не из них!<br>Клянусь тем немногим,<br>что осталось от моей чести!"

#. ja: な、何なの！？
#. de: W-Was willst du?
#. fr: Qui êtes-vous<nbsp>!?
msgctxt "Balloon:2304:0:1"
msgid "Who are you!?"
msgstr "Кто ты такой?!"

#. ja: あら、お帰りな…<br>だ、誰なの！？
#. de: Willkommen zurüc...! Moment mal, wer bist du?
#. fr: Qu'est-ce que ce sera ce soir, Cap... Vous n'êtes pas le capitaine<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2305:0:1"
msgid "What shall it be tonight,<br>Cap─ You're not the captain!"
msgstr "Чего изволите сегодня,<br>капита─ Ты не капитан!"

#. ja: 許して、<br>お願い許して！
#. de: Bitte tu mir nichts! Bitte, bitte!
#. fr: Pardonnez-moi<nbsp>! J-je ne voulais pas vous offenser<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2306:0:1"
msgid "Forgive me, my lord!<br>I did not mean to offend!"
msgstr "Простите меня, милорд!<br>Я не хотела вас оскорбить!"

#. ja: これで逃げられるの？
#. de: Kommen wir jetzt endlich hier raus?
#. fr: Suis-je... libre<nbsp>?
msgctxt "Balloon:2307:0:1"
msgid "Am I...free?"
msgstr "Я... свободна?"

#. ja: た、助けが来たのね！
#. de: Hurra, die Kavallerie!
#. fr: Loués soient les Douze<nbsp>! Le cauchemar est fini<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2308:0:1"
msgid "Thank the Twelve!<br>This nightmare is over!"
msgstr "Хвала Двенадцати!<br>Этот кошмар закончился!"

#. ja: もう…逆らったり<br>しないから…
#. de: Gnade! I-Ich widersetze mich auch nicht mehr, versprochen!
#. fr: Je me rends à vous... Faites de moi ce que vous voulez...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2309:0:1"
msgid "I shan't bite any more...<br>Just let me out!"
msgstr "Я больше не кусаюсь...<br>Только выпустите меня!"

#. ja: ぐすっ…<br>お、お母さん…
#. de: \<schnüff> Mami!
#. fr: Qu'ai-je fait pour mériter ces souffrances<nbsp>?<nbsp>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2310:0:1"
msgid "Mother... Father... What<br>did I do to deserve this?"
msgstr "Мама... папа... За что<br>мне всё это?"

#. ja: アタシたち、<br>海賊に誘拐されて…
#. de: Wir sind von Piraten entführt worden!
#. fr: Je ne tiendrai pas une nuit de plus...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2311:0:1"
msgid "I don't think I can last<br>another night in the<br>Deckhands' Quarters..."
msgstr "Я не выдержу ещё<br>одной ночи в казарме<br>палубной команды..."

#. ja: 何回相手をすれば…<br>えっ、助けなの？
#. de: Ihr könnt mich tausendmal folt... Was? Du bist gekommen, um uns zu retten?
#. fr: S'il vous plaît, <if $gn4> Madame<else>Monseigneur</if>, je souffre tant...
#. macro: <if $gn4>milady<else>milord</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2312:0:1"
msgid "Please, <if $gn4>milady<else>milord</if>,<br>I'm ever so sore..."
msgstr "Пожалуйста, <if $gn4>миледи<else>милорд</if>,<br>мне так больно..."

#. ja: 海賊どもを<br>ブチのめして！
#. de: Erteile diesen dreckigen Piraten eine Lektion!
#. fr: Découpez-leur l'entrejambe<nbsp>! À tous, jusqu'au dernier<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2313:0:1"
msgid "Slit them between the<br>legs! Every last one of them!"
msgstr "Режьте их между ног!<br>Всех до единого!"

#. ja: わが気の弾を食らうがいい！
#. de: Hadouken!
#. fr: Hadoken<nbsp>!
msgctxt "Balloon:2314:0:1"
msgid "Feel the true power of the Fist!"
msgstr "Почувствуй истинную силу Кулака!"

#. ja: 逃がしませんよ…！
#. de: Du entkommst mir nicht!
#. fr: Tu ne m'échapperas pas<nbsp>!
msgctxt "Balloon:2315:0:1"
msgid "There is no escape!"
msgstr "Тебе не уйти!"

#. ja: ウォォォォ！
#. de: Hiaaah!
#. fr: Yaaah<nbsp>!
msgctxt "Balloon:2316:0:1"
msgid "Hyaaah!"
msgstr "Хья-а!"

#. ja: 我が怨みを糧に、来たれ異界の蟲王よッ！
#. de: Erhebe dich aus der Dunkelheit!
#. fr: Réponds à l'appel de ma rancune, entité des ténèbres<nbsp>!
msgctxt "Balloon:2317:0:1"
msgid "Rise from the darkness!"
msgstr "Поднимись из тьмы!"

#. ja: …待ってる
#. de: Ich warte hier ... Dumdidum ...
#. fr: Alors moi aussi.
msgctxt "Balloon:2318:0:1"
msgid "Then so shall I."
msgstr "Тогда и я останусь."

#. ja: ぶくぶくぶく…
#. de: \<blubber> ... \<blubber> ... \<blubber> ...
#. fr: Si l'eau était plus profonde je me noierais !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2319:0:1"
msgid "If the water were<br>any deeper, I'd drown!"
msgstr "Будь вода хоть<br>чуть глубже, я бы утонул!"

#. ja: うう…のぼせちゃった…
#. de: Ui, ich glaub, das Wasser war doch zu warm ... Oder der Wein?
#. fr: Mon cerveau... Je crois qu'il a bouilli.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2320:0:1"
msgid "My brain...<br>I think I boiled it."
msgstr "Мозги...<br>Кажется, сварились."

#. ja: 早く復帰したいぜ
#. de: Noch so 'n Kommentar über meine <i>Frisur</i>, Wiesländer, und ich verpass dir 'ne neue. Mit meiner Axt!
#. fr: Tu dis encore quelque chose sur mes cheveux et je te scalpe sur place.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2321:0:1"
msgid "Another word about my<br>hair, Midlander, and I'll<br>scalp you right here."
msgstr "Ещё слово про мои<br>волосы, срединец, и я<br>с тебя скальп сниму!"

#. ja: せっかくだし、入ってく？
#. de: Ach, komm schon! Ich zeig dir auch meinen neuesten Flachköpper. Macht Laune!
#. fr: Ces demoiselles veulent-elles prendre un bain de minuit ?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2322:0:1"
msgid "Can I interest you<br>ladies in a midnight dip?"
msgstr "Не желаете ли искупаться<br>в полночь, дамы?"

#. ja: 長期療養かい？
#. de: Langzeitbehandlung?
#. fr: Les sources vous réchaufferont à l'extérieur, et le vin à l'intérieur.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2323:0:1"
msgid "The springs'll warm from<br>without, the wine within."
msgstr "Вода согреет снаружи,<br>а вино — изнутри."

#. ja: お肌っゃっゃにゃ！
#. de: An meine Haut lasse ich nur Wasser und Krötensekret.
#. fr: Vous voulez nous rejoindre ? Ou bien est-ce qu'on est trop pour vous ?
#. macro: <if $gn4><else> Or are<br>you not man enough<br>for the five of us?</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2324:0:1"
msgid "Care to join us?<if $gn4><else> Or are<br>you not man enough<br>for the five of us?</if>"
msgstr "Не хотите к нам присоединиться?<if $gn4><else> Или пятерых мужчин<br>тебе не одолеть?</if>"

#. ja: 頭が…くらくら…
#. de: Mein Kopf ... Alles dreht sich ...
#. fr: Je crois qu'on est repérées, les filles.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2325:0:1"
msgid "It appears we've been<br>discovered, ladies."
msgstr "Кажется, нас<br>заметили, дамы."

#. ja: 高くない？
#. de: In Nordwald hab ich das zum halben Preis gesehen!
#. fr: Je peux en avoir deux fois plus à Ul'dah pour le même prix !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2326:0:1"
msgid "I can get twice as much<br>in Ul'dah for half the price!"
msgstr "В Ульде за те же деньги<br>можно купить вдвое больше!"

#. ja: よってらっしゃい！
#. de: Beste Ware, niedrigste Preise, tretet heran!
#. fr: Dernier ra<shy>vi<shy>tail<shy>le<shy>ment avant des dizaines de malms !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2327:0:1"
msgid "Last stop for supplies<br>for ten score malms!"
msgstr "Последняя остановка,<br>чтобы запастись провизией<br>на двести мальмов!"

#. ja: でりゃっ
#. de: Drei mit einem Streich? Das glaubst du ja selbst nicht.
#. fr: Trois contre un !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2328:0:1"
msgid "Five against one,<br>ye say? Cor!"
msgstr "Пятеро на одного,<br>говоришь? Вот это да!"

#. ja: ここも賑やかになってきたわね
#. de: Hier ist mittlerweile ganz schön was los, was?
#. fr: Eh bien, c'est beaucoup plus animé qu'avant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2329:0:1"
msgid "This place has<br>certainly grown<br>lively of late."
msgstr "Тут в последнее время<br>стало довольно людно."

#. ja: 全部運んで
#. de: Und wehe, es bleibt auch nur eine Kiste liegen!
#. fr: Il faut im<shy>mé<shy>dia<shy>te<shy>ment amener tout ça à la Trouvaille.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2330:0:1"
msgid "These must all be moved<br>to the Find at once."
msgstr "Немедленно перенесите<br>всё это в «Находку»."

#. ja: 異常なし！
#. de: Keine besonderen Vorkommnisse!
#. fr: Rien à signaler de ce côté<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2331:0:1"
msgid "You want this aetheryte,<br>you have to get by me first!"
msgstr "Нужен этот эфирит —<br>сперва придётся одолеть меня!"

#. ja: 畑仕事も潮時かなぁ…
#. de: Gut Ding will Weile haben.
#. fr: Le destin récompense toujours qui sait attendre. Hé hé hé...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2332:0:1"
msgid "Naught but<br>weeds, all of it."
msgstr "Одни сорняки кругом."

#. ja: はあ、たまらんな
#. de: Ich geh noch mal ein in dieser Rüstung!
#. fr: Je crève de chaud dans cette armure.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2333:0:1"
msgid "I'm boiling<br>in this armor."
msgstr "Ух, в этих доспехах<br>я сейчас сварюсь."

#. ja: 一人一竜殺！
#. de: Jeder bitte nur einen Drachen töten! Die anderen wollen auch ihren Spaß!
#. fr: La chair molle sous leur menton, c'est ça leur point faible.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2334:0:1"
msgid "The soft flesh under the<br>jaw. That's their weak spot."
msgstr "Мягкая кожа под<br>челюстью. Вот их слабое место."

#. ja: はあ、温まるな
#. de: Fühlt sich an, als hätte ich 'nen ganzen Drachen verspeist.
#. fr: J'ai l'impression d'avoir mangé un dragon.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2335:0:1"
msgid "Feels like I ate<br>a whole dragon."
msgstr "Будто целого дракона<br>съел."

#. ja: 非番いつだっけ？
#. de: Wann waren noch mal die Brückenfeiertage? Ich muss dringend an die Sonnenküste.
#. fr: Et si tu venais faire un tour dans mon lit ?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2336:0:1"
msgid "What say you come<br>over to my bunk, squire?"
msgstr "Как насчёт заглянуть<br>ко мне на койку, оруженосец?"

#. ja: うう…ドラゴンめ…
#. de: Verdammte Drachenbrut ...
#. fr: Je me vengerai...
msgctxt "Balloon:2337:0:1"
msgid "I will have my revenge..."
msgstr "Я отомщу..."

#. ja: 吹雪で小隊が…
#. de: Einen ganzen Trupp hat's im Schneesturm erwischt ...
#. fr: Un cadavre me tiendrait plus chaud que toi.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2338:0:1"
msgid "I'd be warmer in<br>bed with a corpse."
msgstr "С покойником в постели<br>было бы теплее."

#. ja: ずいぶん冷えるな
#. de: Ganz schön schattig hier ...
#. fr: La visière empêche mes yeux de geler.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2339:0:1"
msgid "The visor keeps my<br>eyes from freezing shut."
msgstr "Забрало не даёт<br>глазам замёрзнуть."

#. ja: 遺跡を荒らすなよ
#. de: Ruinier uns nicht die Ruinen, hörst du?
#. fr: Je constate que tu n'es pas un géant. Tu peux donc passer.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2340:0:1"
msgid "Well, you're obviously not<br>a giant. You may pass."
msgstr "Ну, ты явно не великан.<br>Можешь проходить."

#. ja: 北側を掘り進めよう
#. de: Lasst uns an der Nordseite graben.
#. fr: Je dis qu'on doit creuser depuis la face nord.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2341:0:1"
msgid "I say we dig<br>from the north face."
msgstr "Предлагаю копать<br>с северной стороны."

#. ja: やってみる価値はあるな
#. de: Hm, einen Versuch ist es wert ...
#. fr: Et moi je dis qu'on creuse depuis le sud.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2342:0:1"
msgid "And I say we<br>dig from the south."
msgstr "А я говорю — копать<br>с южной."

#. ja: 巨人族にゃ手を焼くぜ
#. de: Wenn du mal Schutz vor den Riesen brauchst, Kleines ...
#. fr: Faut jamais chercher du travail dans un endroit comme celui-là.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2343:0:1"
msgid "Never want for work<br>in a place as this."
msgstr "В таком месте<br>работы всегда вдоволь."

#. ja: ふむ…この文様は…
#. de: Ist das ... ein altes allagisches Rezept für Gizauerkraut?!
#. fr: Quel chef-d'œuvre<nbsp>! Toute la structure est conçue à partir d'un seul rocher !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2344:0:1"
msgid "Look at the masonwork!<br>The entire structure is<br>wrought from a single stone!"
msgstr "Гляньте на кладку!<br>Всё здание высечено<br>из цельного камня!"

#. ja: 霧になると調査が捗らん
#. de: Bei Nebel sieht man hier die Axt vor Augen nicht ...
#. fr: Quand il y a beaucoup de brouillard, mieux vaut rester dans le coin.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2345:0:1"
msgid "When the fog is thick, I<br>wouldn't wander too far."
msgstr "В густом тумане<br>лучше далеко не уходить."

#. ja: 大審門は封鎖中だ
#. de: Die Tore stehen Fremden und Ungläubigen nicht offen.
#. fr: Les portes sont fermées aux étrangers et aux hérétiques.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2346:0:1"
msgid "The Gates are closed to<br>outsiders and unbelievers."
msgstr "Врата закрыты для<br>чужаков и неверных."

#. ja: 冒険者には無用の場所だ
#. de: Abenteurer haben hier nichts zu suchen.
#. fr: Les personnes comme toi n'ont rien à faire ici.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2347:0:1"
msgid "Too many adventurers<br>in Coerthas, I say."
msgstr "В Кертасе и без того<br>слишком много искателей приключений."

#. ja: 最近なんかキナ臭いよな
#. de: In letzter Zeit riecht's hier streng ...
#. fr: Moi, je dis qu'il y a trop d'aventuriers dans le Coerthas.
msgctxt "Balloon:2348:0:1"
msgid "Can you believe it!?"
msgstr "Ну и дела, правда?!"

#. ja: ああ、同感だね
#. de: Frag mal deine Stiefel warum ...
#. fr: Ils sont presque aussi néfastes que les dragons.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2349:0:1"
msgid "They're almost as<br>bad as the dragons."
msgstr "От них почти столько же<br>вреда, сколько от драконов."

#. ja: 干し肉が不足してるな
#. de: Wir haben nicht mehr genug Dörrfleisch.
#. fr: De la farine et du chou pourri... c'est pas avec ça qu'on va tenir un siège.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2350:0:1"
msgid "Three sacks of winter<br>wheat and a box of<br>rotting cabbage will not<br>see us through a siege."
msgstr "Трёх мешков озимой<br>пшеницы и ящика<br>гнилой капусты на осаду<br>не хватит."

#. ja: あ～当直やだなぁ
#. de: Schnee von gestern bleibt für uns leider Schnee für 'n ganzes Jahr ...
#. fr: Y a rien de mieux à faire dans la vie que combattre des dragons ?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2351:0:1"
msgid "Is there naught more to<br>life than fighting dragons?"
msgstr "Неужели вся жизнь —<br>только драконов бить?"

#. ja: 赤か白か…両方？
#. de: Rot oder Weiß ... Oder beide?
#. fr: Tout ce que je vois là, c'est du rouge et du blanc. Le maître a commandé un rosé !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2352:0:1"
msgid "All I see here is red<br>and white. The master<br>requested a rosé!"
msgstr "Вижу только красное<br>и белое. Господин заказал розовое!"

#. ja: な、ええぢゃろ？
#. de: Die Würze liegt in der Kürze, meine Teuerste. Wirklich!
#. fr: J'ai comblé bien des femmes au cours de mes cinquante-cinq printemps.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2353:0:1"
msgid "I've satisfied many a<br>woman in my fifty and<br>five summers."
msgstr "Я ублажил немало<br>женщин за свои пятьдесят<br>пять весен."

#. ja: クビよ、クビ！
#. de: Du bist gefeuert, aber sowas von!
#. fr: C'est pour ça que j'embauche pas d'hommes ! Vous pensez qu'avec votre entrejambe !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2354:0:1"
msgid "This is why I don't hire<br>men! You only think with<br>that head 'twixt your legs!"
msgstr "Вот почему я не нанимаю<br>мужчин! У вас одни мысли<br>об этой штуке между ног!"

#. ja: 次は倍がけだ！
#. de: Beim nächsten Mal mit doppeltem Einsatz!
#. fr: Eh ! Tu me paies avec mon propre argent !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2355:0:1"
msgid "Hah! Yer payin' me<br>with me own coin!"
msgstr "Ха! Ты платишь мне<br>моими же деньгами!"

#. ja: むむ…あの影は？
#. de: Nanu? Dieser Schatten!
#. fr: Qu'est-ce que je donnerais pas pour être là-bas...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2356:0:1"
msgid "What I wouldn't give to<br>be down there sipping<br>rum from a coconut."
msgstr "Чего бы я только не отдал,<br>чтобы сидеть там и потягивать<br>ром из кокоса."

#. ja: あらよっと
#. de: Was denn? Noch nichts vom neuen Trendsport mitbekommen? Kistenbalancieren ist gerade der Renner in Eorzea.
#. fr: M'déconcentre pas<nbsp>! J'ai fait l'pari que j'tiendrai cette caisse pendant une lune entière<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2357:0:1"
msgid "You hear a scream<br>from the palace?"
msgstr "Слышишь крик<br>из дворца?"

#. ja: 見敵必殺！
#. de: Nur ein toter Feind ist ein duldbarer Feind.
#. fr: J'ai encore jamais raté.<br>(La falaise, évidemment.)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2358:0:1"
msgid "Haven't missed yet.<br>(The cliff, that is.)"
msgstr "Пока ни разу не промахнулся.<br>(Я про обрыв.)"

#. ja: おいっす
#. de: Eins, zwei ... neun, zehn, äh, zwanzig, einundzwanzig ...
#. fr: Un, deux... Neuf, dix... Quarante et un, quarante-deux...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2359:0:1"
msgid "One, two... Nine, ten...<br>Forty-one, forty-two..."
msgstr "Раз, два... Девять, десять...<br>Сорок один, сорок два..."

#. ja: ほいっす
#. de: Sieben, acht ... hm? Äh, vierundzwanzig, fünfundzwanzig!
#. fr: Sept, huit... Hm ? Trente-neuf, quarante... Hm ?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2360:0:1"
msgid "Seven, eight...hm?<br>Thirty-nine, forty...hm?"
msgstr "Семь, восемь... А?<br>Тридцать девять, сорок... А?"

#. ja: あ～肉うめぇ
#. de: Du magst Schenkelklopfer? Kannste haben!
#. fr: Ça a un goût de poulet parce que <i>c'est</i> du poulet !
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2361:0:1"
msgid "Tastes like chicken,<br>'cause it <i>is</i> chicken!"
msgstr "На вкус как курица,<br>потому что это и <i>есть</i> курица!"

#. ja: 理想のテンポだ！<br>シェイシェイハ！！
#. de: Etwas mehr Schwung noch in die Vorhand ... Ja, genau so!
#. fr: Tout est dans le poignet !
msgctxt "Balloon:2362:0:1"
msgid "It's all in the wrist!"
msgstr "Всё дело в кисти!"

#. ja: ふざけるな！大声だせ！
#. de: Die Drachen ruhen nie, warum also sollten wir es tun?
#. fr: Les dragons se reposent jamais, donc nous non plus !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2363:0:1"
msgid "The dragons never<br>rest, nor shall we!"
msgstr "Драконы не отдыхают,<br>и мы не будем!"

#. ja: ぐうっ…腕が…
#. de: Argh ... Mein Arm ...
#. fr: Mon bras... Ce maudit truc a failli me l'arracher !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2364:0:1"
msgid "My arm... The damned<br>thing nearly bit it off!"
msgstr "Рука... Эта проклятая<br>тварь чуть её не откусила!"

#. ja: ハルオーネの御許へ…
#. de: Halone empfängt jeden ...
#. fr: Halone est témoin de ton sacrifice. Tu auras ta place chez elle.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2365:0:1"
msgid "The Fury has witnessed<br>your sacrifice. A place<br>in Her halls is secure."
msgstr "Фурия видела<br>твою жертву. Тебе уготовано<br>место в Её чертогах."

#. ja: 貴様ら、気を抜くなよ！
#. de: Selbst Schneemänner haben mehr Haltung als ihr!
#. fr: Dix hommes sont morts quand vous avez brisé les rangs !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2366:0:1"
msgid "Ten men lost their lives<br>when you broke the line!"
msgstr "Из-за того, что вы нарушили строй,<br>погибли десять человек!"

#. ja: 凍傷に効く薬を…
#. de: Von meinen Zehen spüre ich keinen einzigen mehr!
#. fr: Mes orteils... Ils sont tout noirs et froids.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2367:0:1"
msgid "My toes...they've all<br>grown black and cold."
msgstr "Пальцы на ногах...<br>Все почернели и замёрзли."

#. ja: 冒険者か？
#. de: Du siehst ... abenteuerlich aus.
#. fr: Encore un aventurier... (soupire)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2368:0:1"
msgid "Halt. State your─<br>Ah, another adventurer."
msgstr "Стой. Назови себя─<br>А, ещё один искатель приключений."

#. ja: 条件は悪くないな
#. de: Ruhe! Willst du's den Rittern etwa auf ihre hohen Nasen binden?
#. fr: Silence ! Tu veux que les chevaliers t'entendent !?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2369:0:1"
msgid "Quiet! You want the<br>knights to hear you!?"
msgstr "Тише! Хочешь, чтобы<br>рыцари тебя услышали?!"

#. ja: ひと稼ぎするぞ
#. de: Hab dieses Messer aus ihrem toten Griff gelöst.
#. fr: J'ai pris le couteau dans ses mains sans vie.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2370:0:1"
msgid "Pulled this knife<br>from her dead hands."
msgstr "Вытащил этот нож<br>из её мёртвых рук."

#. ja: そこで傭兵部隊が…
#. de: In Coerthas habt ihr unser Recht zu befolgen!
#. fr: Dans le Coerthas, vous devez vous conformer à <i>nos</i> lois.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2371:0:1"
msgid "When in Coerthas, you<br>must abide by <i>our</i> laws."
msgstr "В Кертасе вы обязаны<br>соблюдать <i>наши</i> законы."

#. ja: 強くなれ！もっと！
#. de: Ich kenne einen Zack, der war mehr auf Zack als ihr, Freunde! Los jetzt, doppeltes Tempo!
#. fr: Allez, allez<nbsp>! Plus vite, bande de chiffes molles<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2372:0:1"
msgid "Do not dare question<br>our ways, unbeliever."
msgstr "И не смейте ставить<br>под сомнение наши обычаи, неверные."

#. ja: 何か横切らなかったか？
#. de: Irgendwann musst du dich entscheiden! Entweder sie geht oder ich!
#. fr: On ne peut plus continuer comme ça. Pense à ta femme.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2373:0:1"
msgid "We can continue this no<br>longer. Think of your wife."
msgstr "Так больше продолжаться не может.<br>Подумай о жене."

#. ja: 異常はなし、と
#. de: Sorg dafür, dass diese Achse vor Einbruch der Nacht noch geölt wird.
#. fr: Je veux que cet essieu soit graissé avant la nuit.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2374:0:1"
msgid "See that this axle is<br>greased before nightfall."
msgstr "Проследи, чтобы ось<br>смазали до темноты."

#. ja: こうも白いと…
#. de: Der Weise weiß, das Weiß ist weiß!
#. fr: Et un hérétique de plus dans le Gouffre, un.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2375:0:1"
msgid "There goes another<br>heretic off Witchdrop. "
msgstr "Вот ещё один еретик<br>летит с Ведьминого обрыва."

#. ja: 訓練、厳しすぎだよ…
#. de: Die Ausbildung ist die reinste Schinderei!
#. fr: Quand on tue pas des dragons, on s'entraîne à les tuer.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2376:0:1"
msgid "If it isn't <i>slaying</i> dragons<br>it's <i>training</i> to slay them."
msgstr "Если не <i>убиваем</i> драконов,<br>то <i>тренируемся</i> их убивать."

#. ja: 実戦には比べるべくもない
#. de: Kein Vergleich zu einem richtigen Krieg!
#. fr: Ça nous prépare aux vrais combats<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2377:0:1"
msgid "Would you have us face<br>the Horde unprepared?"
msgstr "Ты хочешь, чтобы мы встретили<br>Орду неподготовленными?"

#. ja: …雪には慣れたか？
#. de: Und? Schon an den Schnee gewöhnt?
#. fr: Les armes à l'intérieur appartiennent à ceux qui sont tombés au champ d'honneur.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2378:0:1"
msgid "The weapons within are<br>those of the fallen."
msgstr "Оружие внутри принадлежит<br>павшим в бою."

#. ja: 便箋はどこだったか
#. de: Dabei war ich mir sicher, die Abschrift des Enchiridions hier hingestellt zu haben ...
#. fr: Où ai-je donc mis cet exemplaire de l'Enchiridion ?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2379:0:1"
msgid "Where did I place that<br>copy of the <i>Enchiridion</i>?"
msgstr "Куда я положил<br>тот экземпляр <i>Энхиридиона</i>?"

#. ja: キツいな…
#. de: Die Ungläubigen lügen, um uns von unseren Pflichten abzubringen!
#. fr: Des mensonges d'hérétique pour nous faire oublier notre devoir.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2380:0:1"
msgid "Unbeliever lies, told to<br>make us forget our duty."
msgstr "Неверные лгут, чтобы<br>заставить нас забыть долг."

#. ja: まだまだ…！
#. de: Wechselbäder sollen ja gut für den Kreislauf sein.
#. fr: Il paraît qu'il y a un endroit au sud où l'eau est aussi chaude que le sang.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2381:0:1"
msgid "They say there's a place<br>in the south where the<br>water's warm as blood."
msgstr "Говорят, на юге есть место,<br>где вода тёплая, как кровь."

#. ja: あったかーい…
#. de: Ja, nur dass es hier weit und breit kein warmes Wasser gibt, Witzbold.
#. fr: Silence, vous deux, et concentrez-vous !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2382:0:1"
msgid "Quiet, both of you,<br>and concentrate!"
msgstr "Тихо вы оба<br>и сосредоточьтесь!"

#. ja: …何の用よ
#. de: Ein Sternenzelt zum Campen, das wäre in der Tat das Größte!
#. fr: Qu'est-ce que c'est<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2383:0:1"
msgid "An astrologian requires<br>ample time to ponder the<br>questions of the heavens."
msgstr "Астрологу нужно время,<br>чтобы обдумать вопросы небес."

#. ja: 都に帰ろうと思ってな
#. de: Ich hab genug von den faden Gerichten, dem faden Bier und deiner faden Ge<shy>sell<shy>schaft!
#. fr: Tout est rassis : le pain, la bière, et la compagnie. J'en ai plus qu'assez.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2384:0:1"
msgid "I've had enough of the<br>stale bread, the stale ale,<br>and the stale company."
msgstr "Надоел черствый хлеб,<br>кислый эль и скучная компания."

#. ja: ん…ああ……
#. de: Hm, wie? Hast du was gesagt?
#. fr: Tu as un problème avec ma compagnie ?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2385:0:1"
msgid "You have a problem<br>with my company?"
msgstr "У тебя что-то против моей компании?"

#. ja: 貴方の口には合わないわ
#. de: Ein Dunkelbier gefällig?
#. fr: Vous voulez prendre un verre ?
msgctxt "Balloon:2386:0:1"
msgid "Would you care for a drink?"
msgstr "Не выпьешь чего-нибудь?"

#. ja: 部隊ごと壊滅だとさ
#. de: Ein ganzer Trupp! Vernichtet!
#. fr: Tous les huit ont été rôtis vivants dans leur armure...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2387:0:1"
msgid "All eight were cooked<br>alive in their armor..."
msgstr "Все восемь сгорели заживо<br>в своих доспехах..."

#. ja: ドラゴン族め…
#. de: Das werden diese elenden Drachen büßen!
#. fr: Et nos compagnons alors ?
msgctxt "Balloon:2388:0:1"
msgid "What of the fellowship?"
msgstr "А что с товарищами?"

#. ja: 少し…眠らせてくれ…
#. de: Worum geht's? Drachen? Bitte nicht schon wieder Drachen ...
#. fr: Qu'est-ce que c'est ? Encore des dragons !?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2389:0:1"
msgid "What is it? Dragons?<br>It's <i>always</i> dragons..."
msgstr "Что такое? Драконы?<br>Да вечно эти <i>драконы</i>..."

#. ja: 雪どけは遠いな…
#. de: Wird noch Monde dauern, bis es taut ... \<seufz>...
#. fr: Quand est-ce que la neige fondra...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2390:0:1"
msgid "Took me half a lifetime<br>to find a woman what<br>could chop wood as good<br>as Linne."
msgstr "Полжизни потратил,<br>пока нашёл женщину,<br>что колет дрова не хуже<br>Линне."

#. ja: 占星台の予測では…
#. de: Macht dich der Hut wirklich intelligenter? Er sieht nämlich ziemlich bescheuert aus.
#. fr: D'après nos relevés...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2391:0:1"
msgid "But does the hat actually<br>increase your intelligence?"
msgstr "А эта шляпа и правда<br>делает тебя умнее?"

#. ja: 飛び降りるなよ
#. de: Die Drachen kommen selten bis hier runter. Da machen uns die Goobbue und Giganten viel mehr Probleme.
#. fr: Les géants et les goobbues sont notre fléau, d'habitude.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2392:0:1"
msgid "The Horde rarely<br>descends this far south.<br>Gigants and goobbues─<br>those are our bane."
msgstr "Орда редко<br>спускается так далеко на юг.<br>Гиганты да губбу —<br>вот наша напасть."

#. ja: あの星の位置なら…
#. de: Aber ich sage dir doch, die Smei hat meinen Aufsatz gefressen, die Smei!
#. fr: La position des étoiles laisse présager une attaque imminente.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2393:0:1"
msgid "The Horde will attack<br>again within the fortnight."
msgstr "Орда нападёт снова<br>в течение двух недель."

#. ja: 記録が足りない！
#. de: Noch so eine faule Ausrede und du siehst Sterne, die nie ein Astrologe vor dir sah!
#. fr: Ce n'est pas ce que révèlent nos observations !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2394:0:1"
msgid "But the readings<br>say otherwise!"
msgstr "Но расчёты<br>говорят обратное!"

#. ja: 騎士様にお伝えください
#. de: Der Papst muss unbedingt davon erfahren!
#. fr: Il faut prévenir les templiers<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2395:0:1"
msgid "The See must be<br>made known of this!"
msgstr "Об этом нужно<br>сообщить Святейшему Престолу!"

#. ja: ふむふむ…
#. de: Das verheißt nichts Gutes ...
#. fr: C'est de mauvais augure...
msgctxt "Balloon:2396:0:1"
msgid "This bodes ill..."
msgstr "Добром это не кончится..."

#. ja: なんだ、冒険者か…
#. de: Bringst du die Ohrenschützer? Hoffentlich auch das Elezen-Modell ...
#. fr: Tu es bien loin de chez toi, mon ami<if $gn4>e</if>.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2397:0:1"
msgid "You're a long way<br>from home, adventurer."
msgstr "Далеко же ты<br>от дома, искатель приключений."

#. ja: ひとりで巡回に？
#. de: Du willst wirklich allein da raus?
#. fr: Je n'envie pas celui qui doit patrouiller l'Œil.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2398:0:1"
msgid "I do not envy the man<br>who must patrol the Gaze."
msgstr "Не завидую тому,<br>кому приходится патрулировать Взор."

#. ja: すぐ戻るさ
#. de: Keine Angst, wird nicht lange dauern.
#. fr: Moi non plus.
msgctxt "Balloon:2399:0:1"
msgid "Nor I, my friend."
msgstr "Я тоже, друг мой."

#. ja: 俺は見たんだ！帝国の…
#. de: Ihr hättet die Garlear sehen sollen! Sie haben vor mir gezittert! Vor Kälte ...
#. fr: Il manque une bouteille ! Expliquez-vous !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2400:0:1"
msgid "A bottle is missing!<br>Explain yourselves!"
msgstr "Пропала бутылка!<br>Объяснитесь!"

#. ja: 俺…この任務が終わったら…
#. de: Nach Schichtende gibt's erst mal 'nen Warmwein!
#. fr: Aucun être humain ne pourrait survivre à une telle chute.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2401:0:1"
msgid "No mortal man could<br>survive such a drop."
msgstr "Такое падение<br>не пережить ни одному смертному."

#. ja: 助っ人かな？
#. de: Hat ein Nichts<shy>gesand<shy>ter erst einmal nach deiner Seele gegriffen, gibt es kein Entkommen mehr.
#. fr: Si un être du néant vous attrape, il dévorera votre âme.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2402:0:1"
msgid "Once the voidsent grab<br>hold, your soul is theirs."
msgstr "Стоит пустотникам схватить тебя,<br>как душа твоя будет принадлежать им."

#. ja: 誰か手伝ってくれんかのぉ
#. de: Mein Kollege da erzählt immer solche Schauergeschichten. Lass dich davon nicht abschrecken, hehe.
#. fr: Écoutez-le. Quittez ce lieu et ne revenez jamais<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2403:0:1"
msgid "Listen to him. Leave this<br>place and never return."
msgstr "Послушай его. Уходи отсюда<br>и никогда не возвращайся."

#. ja: ここの警備は万全だ
#. de: Wir haben hier alles im Griff!
#. fr: Ne craignez rien. Cet endroit est sûr.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2404:0:1"
msgid "You need not fear.<br>This location is secure."
msgstr "Не бойся.<br>Здесь безопасно."

#. ja: 警備は交代制、俺は3番だ
#. de: Bei der Wache lösen wir uns ab. Ich bin als Dritter dran.
#. fr: Je prends le premier quart.
msgctxt "Balloon:2405:0:1"
msgid "I am of the third shift."
msgstr "Я из третьей смены."

#. ja: 衛兵5番、異常なしです！
#. de: Wache Nummer 5 meldet: Keine Probleme!
#. fr: Cinquième quart au rapport !
msgctxt "Balloon:2406:0:1"
msgid "Fifth shift reporting!"
msgstr "Пятая смена докладывает!"

#. ja: 俺は衛兵7番…芝居好きだ
#. de: Ich bin Wache Nummer 7 und mag Theater!
#. fr: Le septième quart est toujours le pire.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2407:0:1"
msgid "Seventh shift is<br>always the worst."
msgstr "Седьмая смена —<br>хуже некуда."

#. ja: 警備は交代制、万全さ
#. de: Das Wort Wachablösung klingt wie Musik in meinen Ohren.
#. fr: On travaille par quarts pour être plus efficaces.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2408:0:1"
msgid "We work in shifts to<br>ensure efficiency."
msgstr "Мы работаем посменно,<br>так надёжнее."

#. ja: 警備に神はいない…
#. de: Die Götter müssen verrückt sein ... glaube ich.
#. fr: Encore un coup de cloche et mon quart sera terminé.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2409:0:1"
msgid "Another bell and my<br>shift will be over."
msgstr "Ещё один звонок —<br>и моя смена закончится."

#. ja: 衛兵9番だ、おつかれさん
#. de: Gestatten, Wache Nummer 9. Alles im grünen Bereich!
#. fr: Je suis avec le huitième quart... ou le neuvième<nbsp>? Mince, j'ai oublié<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2410:0:1"
msgid "I'm with the eighth shift.<br>Or was it the ninth...?"
msgstr "Я из восьмой смены.<br>Или девятой?.."

#. ja: 衛兵11番、問題ないわ
#. de: Wache Nummer 11 meldet: Keine Probleme!
#. fr: Je suppose que vous vous demandez combien de quarts on a en tout.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2411:0:1"
msgid "I suppose you're<br>wondering just how<br>many shifts there are."
msgstr "Наверное, ты гадаешь,<br>сколько же у нас<br>всего смен."

#. ja: 中はずいぶん賑やかだぜ？
#. de: Drinnen ist ganz schön was los!
#. fr: J'essaie de ne pas trop me soucier de ce qui se passe à l'intérieur.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2412:0:1"
msgid "I try not to concern<br>myself with what<br>transpires within."
msgstr "Стараюсь не думать,<br>что творится<br>внутри."

#. ja: 衛兵XIV番だ
#. de: Ich bin Wache Nummer 14. Eine schöne Zahl, findest du nicht?
#. fr: Le numéro de mon quart ? Je sais pas... Quatorze ?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2413:0:1"
msgid "My shift number?<br>I don't know. Fourteen?"
msgstr "Номер смены?<br>Не знаю. Четырнадцатая?"

#. ja: 警備は交代制です
#. de: Pro Schicht und pro Team sind drei Auswechslungen erlaubt.
#. fr: À la fin de mon quart, je vais boire comme un trou.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2414:0:1"
msgid "When my shift ends,<br>I'm going to drink<br>myself blind."
msgstr "Когда смена закончится,<br>напьюсь до беспамятства."

#. ja: 真のXIV番だ…待たせたな
#. de: Ich bin die wahre Nummer 14. Der andere Typ ist 'ne Fälschung!
#. fr: Le type du quatorzième quart a été démobilisé. Je suis le nouveau quatorze !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2415:0:1"
msgid "The man on fourteenth<br>was released from service.<br>I am the new fourteen!"
msgstr "Четырнадцатого уволили.<br>Я теперь новый четырнадцатый!"

#. ja: 警備は常に変化する…<br>15番目だ
#. de: Ich bin Nummer 15 und gehöre zur nächsten Generation!
#. fr: Les quarts, ça va, ça vient, comme la marée. Moi, je suis le quinzième.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2416:0:1"
msgid "Shifts come and go, like<br>the ebb and flow of the<br>tides. I am of the fifteenth."
msgstr "Смены приходят и уходят,<br>словно прилив и отлив.<br>Я из пятнадцатой."

#. ja: 仇は…とるぞ！
#. de: Ich werde dich rächen, Bruder, versprochen!
#. fr: Ni votre vie, ni votre mort ne seront oubliées.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2417:0:1"
msgid "Neither your life, nor<br>death, will be forgotten."
msgstr "Ни жизнь твоя,<br>ни смерть не будут забыты."

#. ja: 栄養つけなくちゃ！
#. de: Vitamine! Da helfen nur Vitamine!
#. fr: On pourrait croire que des tueurs de dragons sont capables d'attraper un rat ou deux !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2418:0:1"
msgid "You'd think slayers of<br>dragons could catch a<br>bloody rat or two!"
msgstr "Думаешь, убийцы драконов<br>могли бы поймать<br>хоть парочку крыс, чёрт возьми!"

#. ja: 傷が…うずくぜ
#. de: Magst du meine Wunde kratzen? Sie eitert auch kaum!
#. fr: Elle est partie... Je n'ai pas pu la sauver...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2419:0:1"
msgid "She's gone... And I<br>couldn't save her..."
msgstr "Её больше нет...<br>Я не смог её спасти..."

#. ja: 耳先が冷えるな
#. de: Ich glaub, mir frieren gleich die Ohrläppchen ab!
#. fr: Alors, on vient se réchauffer, hein ?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2420:0:1"
msgid "Come to warm<br>yourself, too, eh?"
msgstr "Тоже пришёл<br>согреться, а?"

#. ja: む、何かひらめきそうだ！
#. de: Bin kurz vorm Geistesblitz des Jahrhunderts!
#. fr: Ma nouvelle technique ? C'est la frappe mortelle du fléau !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2421:0:1"
msgid "My new technique? I call<br>it, Eldritch Bane Thrust!"
msgstr "Мой новый приём? Назвал его<br>«Проклятый укол»!"

#. ja: 正射必中！
#. de: Gut gezielt ist halb getroffen!
#. fr: Pile entre les écailles !
msgctxt "Balloon:2422:0:1"
msgid "Right 'twixt the scales!"
msgstr "Точно меж чешуек!"

#. ja: ぐぎぎぎき…
#. de: (Der Diktator hat gut reden, hmpf!)
#. fr: (souffle) J'commence à en avoir marre... (souffle) d'faire des pompes...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2423:0:1"
msgid "(Then why aren't you<br>down here with us? Hmph!)"
msgstr "(И чего ты тогда<br>не здесь с нами? Тьфу!)"

#. ja: ほっ、はっ、ふっ！
#. de: Sie können mich hier nicht festhalten ... Nicht für immer!
#. fr: Ils peuvent pas me garder ici !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2424:0:1"
msgid "They cannot keep<br>me down here!"
msgstr "Им меня тут<br>не удержать!"

#. ja: 天は我らを見放したか…
#. de: Auch das noch! Haben die Götter uns etwa verlassen?
#. fr: Tu as toujours su utiliser les bons mots.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2425:0:1"
msgid "You've always had<br>a way with words."
msgstr "Ты всегда умел<br>подбирать слова."

#. ja: 先生のように美しく！
#. de: Seid edel, meine Brüder! Eifert dem Meister nach!
#. fr: On est un... gentilhomme... ou on ne l'est pas<nbsp>!
msgctxt "Balloon:2426:0:1"
msgid "A gentleman is, rather than does!"
msgstr "Джентльменом надо быть,<br>а не казаться!"

#. ja: 紳士力が…滾ル！
#. de: Erwache, oh Erlesenheit, die du in mir schlummerst!
#. fr: Je me sens... si raffiné<nbsp>!
msgctxt "Balloon:2427:0:1"
msgid "I feel so cultured! I feel so refined!"
msgstr "Чувствую себя таким культурным! Таким утончённым!"

#. ja: もっと…もっと紳士ニ！
#. de: Lasset uns streben nach Noblesse!
#. fr: Le pouvoir de la... gentilhommerie m'habite<nbsp>!
msgctxt "Balloon:2428:0:1"
msgid "Am...am I a gentleman yet?"
msgstr "Я... я уже джентльмен?"

#. ja: ♪月は心を狂わせる…
#. de: ♪ Der Mond geht auf ... Meine Seele steigt in den Himmel ... Berauscht vom Klang der Stille ... ♪
#. fr: ♪ La lune se lève...<br>♪ Mon âme monte au ciel...<br>♪ Enivrée par cette ritournelle...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2429:0:1"
msgid "The moon...eye...<br>your heart...cry...♪"
msgstr "Луна... глаз...<br>сердце... плачь...♪"

#. ja: 我ガ妙技ヲ味ワエ！
#. de: Ich brech dir alle Knochen im Leib! Und dann noch mal!
#. fr: Je vais vous faire bouffer vos dents<nbsp>!
msgctxt "Balloon:2430:0:1"
msgid "None shall return alive..."
msgstr "Никто отсюда живым не уйдёт..."

#. ja: ヒトは逃さぬ！
#. de: Ha! Lebend kommt die nicht davon!
#. fr: Les peaux-tendres, il faut tuer<nbsp>!
msgctxt "Balloon:2431:0:1"
msgid "The heathen's life is ours, brother."
msgstr "Жизнь неверных принадлежит нам, брат."

#. ja: 我らの陣営に近づこうとは！
#. de: Selbst schuld, wenn sie sich in unser Lager traut!
#. fr: Du camp, ils ont osé s'approcher<nbsp>!
msgctxt "Balloon:2432:0:1"
msgid "Aye, another soul for Lord Ifrit."
msgstr "Ишь, осмелились подойти к нашему лагерю!"

#. ja: 資材の搬入は…
#. de: Außerdem benötigen wir noch eine Trittleiter für Tataru.
#. fr: Alors, le reste de la cargaison...
msgctxt "Balloon:2433:0:1"
msgid "As for the remainder of the shipment... "
msgstr "Что до остальной части груза..."

#. ja: …なるほど
#. de: Ist notiert.
#. fr: Je m'en occupe sur-le-champ, Monsieur.
msgctxt "Balloon:2434:0:1"
msgid "I shall see to it forthwith, sir."
msgstr "Сейчас же займусь этим, сэр."

#. ja: 気を引き締めてかかるぞ！
#. de: Nehmt all euren Mut zusammen, ihr werdet ihn brauchen!
#. fr: Il ne faut pas avoir peur de ces horreurs<nbsp>!
msgctxt "Balloon:2435:0:1"
msgid "Shirk not from the horrors!"
msgstr "Не дрогните перед ужасами!"

#. ja: クソッ、妖異どもめ！
#. de: Verdammtes Geisterpack!
#. fr: Maudits soient ces êtres du néant<nbsp>!
msgctxt "Balloon:2436:0:1"
msgid "Godsdamned voidsent!"
msgstr "Проклятые пустотники!"

#. ja: 助太刀か？ありがたい！
#. de: Verstärkung? Na, ausgezeichnet!
#. fr: Votre aide est plus que bienvenue<nbsp>!
msgctxt "Balloon:2437:0:1"
msgid "Your blade is welcome, friend."
msgstr "Твой клинок нам очень кстати, друг."

#. ja: 頼む…仲間を助けてくれ！
#. de: Holt unsere Kameraden da raus.
#. fr: Je vous en supplie... Sauvez nos camarades<nbsp>!
msgctxt "Balloon:2438:0:1"
msgid "I beg of you...save my comrades from those terrors."
msgstr "Умоляю... спаси моих товарищей от этих чудовищ."

#. ja: くるならこいでふっち！
#. de: Die Meinige macht die Eurigen zu Breiigen!
#. fr: Qu'attends-tu pour t'approcher<nbsp>?<br>Ne me dis pas que tu es effrayé<if $gn4>e</if><nbsp>!
msgctxt "Balloon:2439:0:1"
msgid "What is scaredy one waiting for?"
msgstr "Чего этот трусишка ждёт?"

#. ja: 迎え撃つでふっち
#. de: Zum Gegenangriff!
#. fr: Je suis prêt à contre-attaquer<nbsp>!<br>Viens donc un peu plus près<nbsp>!
msgctxt "Balloon:2440:0:1"
msgid "This one is ready for you!"
msgstr "Этот готов дать тебе отпор!"

#. ja: やってやるでふっち！
#. de: Das werden die Eurigen bereuigen!
#. fr: Prépare-toi à mourir<nbsp>!<br>Je ne te laisserai pas t'enfuir<nbsp>!
msgctxt "Balloon:2441:0:1"
msgid "Walking one will not leave here alive!"
msgstr "Пешеход отсюда живым не уйдёт!"

#. ja: くるならこいでふっち！
#. de: Die Meinige macht die Eurigen zu Breiigen!
#. fr: Qu'attends-tu pour t'approcher<nbsp>?<br>Ne me dis pas que tu es effrayé<if $gn4>e</if><nbsp>!
msgctxt "Balloon:2442:0:1"
msgid "What is scaredy one waiting for?"
msgstr "Чего этот трусишка ждёт?"

#. ja: 迎え撃つでふっち
#. de: Zum Gegenangriff!
#. fr: Je suis prêt à contre-attaquer<nbsp>!<br>Viens donc un peu plus près<nbsp>!
msgctxt "Balloon:2443:0:1"
msgid "This one is ready for you!"
msgstr "Этот готов дать тебе отпор!"

#. ja: やってやるでふっち！
#. de: Das werden die Eurigen bereuigen!
#. fr: Prépare-toi à mourir<nbsp>!<br>Je ne te laisserai pas t'enfuir<nbsp>!
msgctxt "Balloon:2444:0:1"
msgid "Walking one will not leave here alive!"
msgstr "Пешеход отсюда живым не уйдёт!"

#. ja: 落とさずに運ぶのよ！
#. de: Jetzt stell dich nicht so an! Hoch damit!
#. fr: T'as pas intérêt à laisser tomber ça, toi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2445:0:1"
msgid "Yer mother was<br>a Lalafell!"
msgstr "Твоя мать была<br>лаллафелл!"

#. ja: 焼き加減が命！
#. de: Außen knusprig, innen saftig. So muss es sein.
#. fr: Savoir griller la viande est un art que peu maîtrisent.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2446:0:1"
msgid "To others this is a patty<br>of ground meat. To me<br>this is a work of <i>art</i>."
msgstr "Для других это котлета<br>из мясного фарша. А для меня —<br>настоящее <i>искусство</i>."

#. ja: まだ、持ち上げられないの！？
#. de: Schneller! Ich habe nicht den ganzen Tag Zeit!
#. fr: Allez, plus vite<nbsp>! On va pas y passer la journée<nbsp>!
msgctxt "Balloon:2447:0:1"
msgid "Godsdammit, man! I know you can work faster than that!"
msgstr "Чтоб тебя, давай быстрее! Я знаю, ты можешь работать лучше!"

#. ja: 助けてふっち！
#. de: Hilfeee!
#. fr: Vite, j'ai besoin d'aide<nbsp>!
msgctxt "Balloon:2448:0:1"
msgid "This one needs help!"
msgstr "Этому нужна помощь!"

#. ja: 離せでふっち！
#. de: Die Meinige will raus hier!
#. fr: Laisse-moi partir<nbsp>!<br>Je sens mon corps s'engourdir<nbsp>!
msgctxt "Balloon:2449:0:1"
msgid "Let go of this one!"
msgstr "Отпусти этого!"

#. ja: 苦しいでふっち！
#. de: Igitt, ist das klebrig!
#. fr: Ah, je me sens mal<nbsp>!<br>Cette situation est infernale<nbsp>!
msgctxt "Balloon:2450:0:1"
msgid "Ick! This one is all sticky!"
msgstr "Фу! Этот весь липкий!"

#. ja: 意外と話せる奴らじゃないか
#. de: Nicht alle von euch sind also engstirnig und verbohrt. Das ist beruhigend.
#. fr: On peut discuter, en fait...
msgctxt "Balloon:2451:0:1"
msgid "You are not what I expected..."
msgstr "Вы оказались совсем не такими, как я думал..."

#. ja: 強将の下に弱卒無し！
#. de: Niemand ist so ruhmreich wie unser Anführer.
#. fr: Les bons soldats, les bons dirigeants font.
msgctxt "Balloon:2452:0:1"
msgid "The warleader commands no weaklings!"
msgstr "У сильного вождя слабакам не место!"

#. ja: ふふ、それは名案でふっち…
#. de: Die Unsrigen müssen das Unsrige beschützen!
#. fr: Nous devons défendre notre demeure<nbsp>!<br>Et si nous échouons, que tous meurent<nbsp>!
msgctxt "Balloon:2453:0:1"
msgid "These ones must protect these ones' home!"
msgstr "Этим нужно защитить дом этих!"

#. ja: 仮宿のヤツらを<br>やっつけるでふっち～
#. de: Passt gutig auf!
#. fr: Restez sur vos gardes<nbsp>!<br>Que personne ne bavarde<nbsp>!
msgctxt "Balloon:2454:0:1"
msgid "Be on guard, every one!"
msgstr "Будьте начеку, все до одного!"

#. ja: 毒気をまき散らす<br>キノコを植えるでふっち
#. de: <if $gn4>Die<else>Der</if> Deinige nimm Diesiges!
#. fr: Ouah<nbsp>!
msgctxt "Balloon:2455:0:1"
msgid "Tee hee!"
msgstr "Хи-хи!"

#. ja: 罠をしかけるでふっち…
#. de: Das könnte <if $gn4>der Deinigen<else>dem Deinigen</if> so passen!
#. fr: Mouaha<nbsp>!
msgctxt "Balloon:2456:0:1"
msgid "Ta ha!"
msgstr "Та-ха!"

#. ja: あとはまかせたでふっち！
#. de: Das Übrige liegt <if $gn4>an der Deinigen<else>am Deinigen</if>!
#. fr: À toi de jouer, maintenant<nbsp>!<br>Je sais qu'avec toi, nous serons gagnants<nbsp>!
msgctxt "Balloon:2457:0:1"
msgid "Walking one is strong one! This one will leave the rest to strong one!"
msgstr "Пешеход силён! Этот оставит остальное сильному!"

#. ja: クラえ！<br>イカリのイチゲキを！！
#. de: IHR MEINEN ZORN SPÜREN!
#. fr: VOUS ALLEZ CONNAÎTRE LA FORCE DE NOTRE COLÈRE<nbsp>!
msgctxt "Balloon:2458:0:1"
msgid "PUNY MAN! FEEL OUR WRATH!"
msgstr "НИЧТОЖНЫЙ ЧЕЛОВЕК! ВКУСИ НАШ ГНЕВ!"

#. ja: オオグチソウを<br>改良するでふっち！
#. de: Die M-Meinige wird das g-g-großmäulige Kraut sprießen lassen! Hicks!
#. fr: Notre succès est assuré.<br>Cette margoulette va nous aider<nbsp>!
msgctxt "Balloon:2459:0:1"
msgid "Stupid ones will never see it coming. Tee hee!"
msgstr "Глупцы ничего не заподозрят. Хи-хи!"

#. ja: フ～ムフムでふっち
#. de: Oliolioh! Hicks!
#. fr: ♪ On est des malins.<br>♪ On est des coquins.
msgctxt "Balloon:2460:0:1"
msgid "These ones are smart ones, oh yes."
msgstr "Эти умные, да-да."

#. ja: いつまで休んでるんだい！？
#. de: Keine Zeit, sich auszuruhen! Weiter!
#. fr: Eh<nbsp>! T'as pas fini de te tourner les pouces<nbsp>!?
msgctxt "Balloon:2461:0:1"
msgid "You there, on your feet! These paving stones aren't going to lay themselves!"
msgstr "Долго ещё отдыхать будешь?!"

#. ja: なんだ、あんたも手伝うのか？
#. de: Du willst mir helfen? Ach, ist schon gut ...
#. fr: Toi aussi, t'es là pour filer un coup de main<nbsp>?
msgctxt "Balloon:2462:0:1"
msgid "For gods' sakes, do I have to do everything myself!?"
msgstr "И ты тоже мне поможешь? Да за что мне всё это?!"

#. ja: 畑仕事の方が楽だったな…
#. de: Und ich dachte immer, die Feldarbeit wär anstrengend ...
#. fr: J'en ai par-dessus la tête de ces fichus cailloux<nbsp>! J'en rêve même la nuit...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2463:0:1"
msgid "Gods help me, I'm<br>starting to see paving<br>stones in my dreams..."
msgstr "Боги, мне уже<br>камни мостовой снятся..."

#. ja: ここで素振りが役立つとは！
#. de: Wenn ich nur meine schwere Rüstung ablegen könnte ...
#. fr: Comme quoi, s'entraîner, ça sert<nbsp>!
msgctxt "Balloon:2464:0:1"
msgid "Bleedin' waste of me sword arm..."
msgstr "Вот и пригодились тренировки с мечом..."

#. ja: 何が見えるのかにゃ？
#. de: Ich sehe was, was du nicht siehst und das ist ...
#. fr: Je vois rien du tout. Et vous<nbsp>?
msgctxt "Balloon:2465:0:1"
msgid "I don't see anything. Do you?"
msgstr "Ничего не вижу. А ты?"

#. ja: 腕がなるな～
#. de: Äh ... War hier nicht eben noch eine Leiter?
#. fr: Raah<nbsp>! J'ai hâte de pouvoir m'y mettre<nbsp>!
msgctxt "Balloon:2466:0:1"
msgid "Only one way to find out..."
msgstr "Узнаем только на деле..."

#. ja: 床デモ、ナメテナ！
#. de: Für wen hältst du dich?
#. fr: Va te faire voir<nbsp>!
msgctxt "Balloon:2467:0:1"
msgid "Go and bugger yourself!"
msgstr "Иди к чёрту!"

#. ja: バーカ、アーホ！
#. de: Idiot!
#. fr: Débile<nbsp>! Idiot<if $gn4>e</if><nbsp>!
msgctxt "Balloon:2468:0:1"
msgid "Idiot! Half-wit!"
msgstr "Идиот! Полный тупица!"

#. ja: 訓練をご希望ですね？
#. de: Du möchtest trainieren?
#. fr: Vous venez vous entraîner, je suppose<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2469:0:1"
msgid "Here for training,<br>I take it?"
msgstr "Пришли тренироваться,<br>верно?"

#. ja: さぁ、奥へお進みを…
#. de: Nur zu, tritt ein!
#. fr: L'entrée est sur votre gauche.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2470:0:1"
msgid "Go right on in.<br>Don't be shy!"
msgstr "Проходи, не стесняйся!"

#. ja: さては怖気付いたな？
#. de: Muffensausen bekommen?
#. fr: Alors, on a les chocottes<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2471:0:1"
msgid "Not losing your<br>nerve, I hope?"
msgstr "Надеюсь, ты не<br>струсил?"

#. ja: オラオラ、気合入れろ！
#. de: Haltung bewahren, Freundchen!
#. fr: Allez<nbsp>! On se motive<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2472:0:1"
msgid "Me infirm grandma<br>hits harder than ye!"
msgstr "Даже моя больная бабка<br>бьёт сильнее тебя!"

#. ja: もっと強く踏み込め！
#. de: Und jetzt das Ganze noch mal in Kräftig, kapiert?
#. fr: Plus fort<nbsp>!
msgctxt "Balloon:2473:0:1"
msgid "Put yer hip into it!"
msgstr "Вкладывайся всем телом!"

#. ja: は、はい！
#. de: J-Jawohl!
#. fr: C-compris<nbsp>!
msgctxt "Balloon:2474:0:1"
msgid "Sir, yes sir!"
msgstr "Так точно, сэр!"

#. ja: 次の試合は勝つ！
#. de: Noch mal verlier ich nicht!
#. fr: Je gagnerai la prrrochaine<nbsp>!
msgctxt "Balloon:2475:0:1"
msgid "To the victor go the spoils!"
msgstr "Победителю достанется всё!"

#. ja: ほう、冒険者か…
#. de: Abenteurer? Hmpf ...
#. fr: Pfff<nbsp>! J'en ai marre de ramasser les cadavres des aventuriers...
msgctxt "Balloon:2476:0:1"
msgid "Ah, fresh meat for the grinder."
msgstr "О, свежая добыча для мясорубки."

#. ja: 強き者のみが生き残る！
#. de: Auf sie! Na, wird's bald?
#. fr: Seuls les plus forts survivront<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2477:0:1"
msgid "The meek shall inherit<br>a hole in the ground!"
msgstr "Слабым достанется<br>могила!"

#. ja: 剣奴の生活は辛い…
#. de: I-Ich dachte immer, Gladiatorenkämpfe wären nur Schau!
#. fr: La vie du gladiateur est dure...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2478:0:1"
msgid "Oh, gods, what've I<br>gotten myself into..."
msgstr "О боги, во что же я<br>ввязался..."

#. ja: そんなヘッピリ腰では<br>観客の心は掴めんぞ！
#. de: So wird das nichts mit Ruhm und Ehre!
#. fr: Il faut se donner pour captiver l'audience<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2479:0:1"
msgid "Are you fighting or farting!?<br>The spectators are like to<br>laugh themselves to death!"
msgstr "Ты дерёшься или пукаешь!?<br>Зрители сейчас от смеха<br>помрут!"

#. ja: ビビったら負けだ…
#. de: Angst ist der größte Feind.
#. fr: Si vous perdez vos moyens, c'est la défaite assurée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2480:0:1"
msgid "If you show your fear,<br>you've already lost."
msgstr "Покажешь страх —<br>уже проиграл."

#. ja: しっかりせんかー！
#. de: Da kämpft ja mein Mogry-Stofftier besser!
#. fr: Alors<nbsp>! Tu vas attaquer, oui<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2481:0:1"
msgid "What the hells are you<br>waiting for? The cavalry!?"
msgstr "Чего, к чёрту, ты<br>ждёшь? Подмоги!?"

#. ja: 先手を取れば…
#. de: Wer zuerst schlägt, lacht am frühsten?
#. fr: Raah<nbsp>! Il perturbe ma con<shy>cen<shy>tra<shy>tion à crier comme ça...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2482:0:1"
msgid "If I can catch<br>them unawares..."
msgstr "Если застану их<br>врасплох..."

#. ja: 魔獣どもが待っているぞ！
#. de: Nur zu, die Kätzchen schnurren schon!
#. fr: Les monstres vous attendent<nbsp>!
msgctxt "Balloon:2483:0:1"
msgid "There be monsters!"
msgstr "Там чудища!"

#. ja: 気合を入れろ！
#. de: Nicht so zögerlich, ihr Waschlappen!
#. fr: Allez<nbsp>! Matez-moi ces gros matous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2484:0:1"
msgid "The eye of the coeurl!<br>Show it to me!"
msgstr "Покажи мне взгляд кууруля!<br>Ну же!"

#. ja: ここの魔獣はわしが育てた
#. de: Sind meine Bärchen nicht goldig?
#. fr: C'est moi qui ai élevé ces bêtes. C'est pour ça qu'elles m'attaquent pas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2485:0:1"
msgid "How do you like my<br>pets? Not too <i>playful</i><br>for you, I hope?"
msgstr "Ну как тебе мои<br>питомцы? Надеюсь, они не слишком <i>игривые</i>?"

#. ja: 剣闘士同士の闘いこそ<br>コロセウムの花形だ！
#. de: Der Kampf Mann gegen Mann ist das Höchste für jeden Gladiator!
#. fr: Les combats de gladiateurs sont la gloire du Colisée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2486:0:1"
msgid "Naught is nobler<br>than single combat<br>between gladiators."
msgstr "Нет ничего благороднее<br>честного поединка<br>между гладиаторами."

#. ja: 槍の一撃は強烈だ…
#. de: Nimm dich vor seinem Speer in Acht!
#. fr: Un coup de lance bien placé, et hop<nbsp>! direction les sept enfers.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2487:0:1"
msgid "Taking a spear to the<br>gut is the worst..."
msgstr "Пропустить удар копьём<br>в живот — хуже некуда..."

#. ja: 守りを崩す方法を学べ！
#. de: Es gilt die Deckung zu durchbrechen!
#. fr: Percer leur défense sera pas facile, croyez-moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2488:0:1"
msgid "A gladiator must<br>know how to pierce<br>every defense!"
msgstr "Гладиатор должен<br>уметь пробить<br>любую защиту!"

#. ja: タフさが無ければ勝てん…
#. de: Nur die Härtesten haben hier 'ne Chance.
#. fr: Il faut des tripes pour vaincre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2489:0:1"
msgid "Without endurance, a<br>gladiator has nothing."
msgstr "Без выносливости<br>гладиатору не победить."

#. ja: 船酔いが…うぇっぷ…
#. de: „Eine Seefahrt, die ist lustig“, haben sie gesagt ... \<würg>
#. fr: J'ai le mal de mer... Oeeurg<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2490:0:1"
msgid "Oh, gods, make it end... I've<br>got nothin' left to bring up..."
msgstr "О боги, пусть это кончится...<br>Уже и блевать нечем..."

#. ja: 寝てなーいわー<br>仕事つらーいわー
#. de: Warum arbeiten, wenn schlafen so schön sein? Zzz ...
#. fr: J'ai pas dormi, oh non<nbsp>! Je suis fatigué, oui<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2491:0:1"
msgid "Why work when sleep<br>feels so good? Rest...<br>Slumber... Zzz..."
msgstr "Зачем работать, если так<br>хорошо спится? Отдых...<br>Сон... Хр-р-р..."

#. ja: フスィー…オサカナどこ？
#. de: Hab ich dich ...! Oder auch nicht.
#. fr: Fsss... Où sssont les poissons<nbsp>?
msgctxt "Balloon:2493:0:1"
msgid "My only wishhh is to catch a fishhh─they're so juicy-sssweet!"
msgstr "Моя единственная мечта — поймать рыбкууу... такая сочная и сладкаяяя!"

#. ja: 潮の流れを読むんだ
#. de: Gezeitenströme les ich am liebsssten.
#. fr: Il faut lire dans la marée...
msgctxt "Balloon:2494:0:1"
msgid "Read the flow of the currentsss..."
msgstr "Читай течениеее..."

#. ja: ぐひーひ　あそぼーぜぇ
#. de: Spaß uns lass haben!
#. fr: On va s'amuser, ma cocotte, mouais, on va s'amuser<nbsp>!
msgctxt "Balloon:2495:0:1"
msgid "You come here why? Yes, yes, to die!"
msgstr "Зачем пришёл? Да-да, умирать!"

#. ja: ナカヨーク　錬金しよーぜぇ
#. de: Nicht so schüchtern!
#. fr: Tu vas nous donner des cours d'anatomie, ouais<nbsp>!
msgctxt "Balloon:2496:0:1"
msgid "I'll boil you─cook you, simmer you, boil you!"
msgstr "Я тебя сварю — приготовлю, потушу, снова сварю!"

#. ja: た　助け～て！　誰～か！
#. de: H-Hilfe! Vom Leib mir bleibt!
#. fr: Au secours<nbsp>! À l'aide, moui-moui<nbsp>!!
msgctxt "Balloon:2497:0:1"
msgid "Paws off, you brutes─you beasts, you savages, you brutes!"
msgstr "Руки прочь, вы, мерзавцы! Звери! Дикари! Руки прочь!"

#. ja: ここはお任せを！
#. de: Weiter östlich!
#. fr: J'admire votre bravoure...<br>Mais vous devriez faire demi-tour.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2498:0:1"
msgid "<i>I</i> have this area under control!"
msgstr "<i>Я</i> здесь всё держу под контролем!"

#. ja: イタズラに注意するんだ
#. de: Überlass das uns!
#. fr: On s'occupe de tout.<br>Vous pouvez rentrer chez vous.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2499:0:1"
msgid "<i>You</i> should be on <i>your</i> guard against mischief!"
msgstr "<i>Ты</i> уж <i>смотри</i>, как бы не натворить чего!"

#. ja: 賢人は見つかったか？
#. de: Zutritt verboten!
#. fr: Cette zone est interdite.<br>Il y a trop de parasites.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2500:0:1"
msgid "Have <i>you</i> found <i>your</i> wise <i>companions</i>?"
msgstr "Нашёл <i>ты</i> <i>своих</i> мудрых <i>спутников</i>?"

#. ja: 撤退するつもりか？
#. de: Hast du etwa schon genug?
#. fr: Vous renoncez<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2501:0:1"
msgid "You seek to retreat?<br>A craven!"
msgstr "Отступить надумал?<br>Трус!"

#. ja: 戦神ハルオーネの<br>加護あらんことを！
#. de: Halone steh euch bei!
#. fr: Que Halone vous protège<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2502:0:1"
msgid "May Halone give you<br>a good death!"
msgstr "Пусть Халон дарует тебе<br>лёгкую смерть!"

#. ja: 先発した切込隊に続き<br>我らも突入するぞ！
#. de: Wir bilden die Nachhut und folgen der Vorhut!
#. fr: Nous allons prendre le relais de l'unité d'éclaireurs<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2503:0:1"
msgid "We storm the keep once<br>the gate is breached!"
msgstr "Как только проломят ворота,<br>мы ворвёмся в крепость!"

#. ja: 異端者どもめ…
#. de: Verfluchte Häretiker ...
#. fr: Maudits hérétiques<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2504:0:1"
msgid "Much blood will I<br>spill this day..."
msgstr "Сегодня я пролью<br>немало крови..."

#. ja: ふ、震えが止まらねぇ…
#. de: Ich zittere wie Espenlaub ...
#. fr: Je tremble comme une feuille...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2505:0:1"
msgid "This is the worst part,<br>the waiting..."
msgstr "Хуже всего —<br>это ожидание..."

#. ja: 生きて帰るわよ
#. de: ... Und dann sagte er: „Gut, dann verbringen wir den Urlaub eben bei meiner Mutter.“
#. fr: Je rentrerai vivante<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2506:0:1"
msgid "Halone means me to live,<br>this I know."
msgstr "Халон велит мне жить,<br>я это знаю."

#. ja: 訓練を思い出すんだ…
#. de: Nimm das, elendiger Wurm!
#. fr: Ça me rappelle l'en<shy>traî<shy>ne<shy>ment<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2507:0:1"
msgid "Where is your point? In<br>the belly of a dragon..."
msgstr "Где твоя честь? В брюхе<br>у дракона..."

#. ja: な、仲間を…頼む…
#. de: K-Kameraden!
#. fr: Sauvez... mes compagnons...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2508:0:1"
msgid "Tell them... Tell them<br>I died well..."
msgstr "Скажи им... Скажи,<br>что я погиб достойно..."

#. ja: フスィーッ…！？<br>「珊瑚の銛」に何の用だ？
#. de: Sssssh ... Was willst du von uns?
#. fr: Fsss... Que voulez-vous aux Tridents du corail<nbsp>?
msgctxt "Balloon:2509:0:1"
msgid "Pshhh... What business have you with the Tridentsss?"
msgstr "Пшшш... Что вам нужно от Трезубцев?"

#. ja: フスィーッ…てめぇ…<br>ノォヴんとこのガキか？
#. de: Gehörssst du zu Novv, diesem Verräter?
#. fr: Fsssh... Un enfant de Novv<nbsp>?
msgctxt "Balloon:2510:0:1"
msgid "Pshhhahaha, this is one of Novv's ssspawnlings!"
msgstr "Пшшшахаха! Так это же один из выводков Новв!"

#. ja: フスィーッ…いててて…
#. de: Ssssh ... Aua!
#. fr: Fsssouille-ouille-ouille<nbsp>!
msgctxt "Balloon:2511:0:1"
msgid "Pshhh... Pshhh..."
msgstr "Пшшш... Пшшш..."

#. ja: ぜんぶ　決めてーよ<br>おまかせだーよ
#. de: Is' mir egal. Null Bock ich hab!
#. fr: Je suis trop occupé à me reposer, là, oui<nbsp>! Arrête de m'embêter avec tes histoires<nbsp>!
msgctxt "Balloon:2512:0:1"
msgid "Salt, saltpeter─what's the difference, anyway?"
msgstr "Соль, селитра... Какая, в сущности, разница?"

#. ja: クソッ、クソッ、クソッ！
#. de: Verdammt, verdammt, verdammt!
#. fr: Bon sang, non<nbsp>! Nooon<nbsp>!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2516:0:1"
msgid "Blood and thunder,<br>the Fury keep me!"
msgstr "Кровь и гром!<br>Фурия, защити меня!"

#. ja: 戦闘準備良し！
#. de: Bereit zum Kampf!
#. fr: Prêts à combattre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2517:0:1"
msgid "Sir, ready to<br>do battle, sir!"
msgstr "Сэр, готов<br>к бою, сэр!"

#. ja: きやがれ、カメ野郎！
#. de: Dein Panzer wird dir nichts nützen!
#. fr: Ça va saigner<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2518:0:1"
msgid "Swive me bloody before<br>I give ground! "
msgstr "Пока не отступлю — хоть режь меня на куски!"

#. ja: くらえ！
#. de: Nimm dies!
#. fr: Prends ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2519:0:1"
msgid "We who are<br>the Fury's fighters...!"
msgstr "Мы, воины Фурии...!"

#. ja: とりゃ！
#. de: Ha!
#. fr: Yah<nbsp>!
msgctxt "Balloon:2520:0:1"
msgid "Awake, steel!"
msgstr "Проснись, сталь!"

#. ja: そこだ！
#. de: Dahin, wo's weh tut!
#. fr: C'est le moment<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2521:0:1"
msgid "Strike true and <br>lash deep!"
msgstr "Бей наверняка и<br>поглубже!"

#. ja: ウラァッ！
#. de: Uaaargh!
#. fr: Waaargh<nbsp>!
msgctxt "Balloon:2522:0:1"
msgid "To me, to me!"
msgstr "За мной! За мной!"

#. ja: 何が見えるんだ？
#. de: Weißt du, wonach die beiden Ausschau halten?
#. fr: Mais qu'est-ce qu'ils regardent, ces deux-là<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2523:0:1"
msgid "You see anything?<br>I don't see anything."
msgstr "Что-нибудь видишь?<br>А я ничего не вижу."

#. ja: 武器の素振りが<br>こんなところで役立つとは！
#. de: Das mit den vielfältigen Berufschancen für Marodeure hatte ich mir ein bisschen anders vorgestellt.
#. fr: J'ai bien fait d'm'entraîner sur des marmottes et des coccinelles<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2524:0:1"
msgid "Why am I mining in full<br>armor? Never can be too<br>careful in the fens!"
msgstr "Кто бы мог подумать, что<br>навык махать оружием<br>пригодится в шахте!"

#. ja: もっと奥を掘りなさいよ！
#. de: Schlag zu, das ist hier keine Prickelstunde!
#. fr: Arrête donc de creuser sous les échafaudages<nbsp>! Tu m'entends<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2525:0:1"
msgid "What kind of addle-<br>brained fool mines in<br>full plate?"
msgstr "Да что за кретин<br>копает в полном доспехе?"

#. ja: 朝採り野菜だよ～
#. de: In dampfendem Morbol-Dung herangewachsen!
#. fr: Ils sont bons, mes légumes<nbsp>! Ils sont frais<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2526:0:1"
msgid "Turnips! Get your turnips!<br>Picked fresh this very morn!"
msgstr "Репа! Налетай на репу!<br>Только сегодня с грядки!"

#. ja: 主人の野菜は最高ですよ！
#. de: Gemüse, frisch und knackig!
#. fr: De bons gros légumes<nbsp>! Cultivés avec de la fiente de nix<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2527:0:1"
msgid "I invite you to find a better<br>turnip in all the realm!"
msgstr "Попробуйте найти репу получше<br>во всём мире!"

#. ja: クンクン
#. de: Fiep, fiep.
#. fr: (snif) (snif)...
msgctxt "Balloon:2528:0:1"
msgid "\\<sniff> \\<sniff>"
msgstr "\\<нюх> \\<нюх>"

#. ja: キュイ～
#. de: \<knurr>
#. fr: (couine)
msgctxt "Balloon:2529:0:1"
msgid "\\<yip> \\<yip> \\<yip>"
msgstr "\\<тяф> \\<тяф> \\<тяф>"

#. ja: ルビーちゃん！
#. de: Rubinchen, bei Fuß!
#. fr: Ruuuubiiii...<nbsp>!?
msgctxt "Balloon:2530:0:1"
msgid "Ruby!? Ru～by!?"
msgstr "Руби!? Ру-у-би!?"

#. ja: クンクン
#. de: Fiep, fiep.
#. fr: (snif) (snif)...
msgctxt "Balloon:2531:0:1"
msgid "\\<sniff> \\<sniff>"
msgstr "\\<нюх> \\<нюх>"

#. ja: 準備中だ！
#. de: Mit Verlaub, aber ich polier noch 'n bisschen meine Angel.
#. fr: Comment elle est trop belle, ma canne à pêche...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2532:0:1"
msgid "You call that a knife?<br>Now, <i>this</i> here's a knife."
msgstr "Это ты называешь ножом?<br>Вот <i>это</i> — нож."

#. ja: どこ行ったにゃ？
#. de: Wo steckt sie nur?
#. fr: Il faut vrrraiment que j'achète une laisse, moi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2533:0:1"
msgid "Now where in Nophica's<br>name did that girl go?"
msgstr "Куда же, во имя Нофикы,<br>эта девчонка запропастилась?"

#. ja: 釣れるかにゃ～？
#. de: Los, beiß schon an!
#. fr: Parrr ici, gentil petit poisson...♪
msgctxt "Balloon:2534:0:1"
msgid "Heeere, fishy fishy fishy...♪"
msgstr "Иди сюда, рыбка, рыбка, рыбка...♪"

#. ja: 大物かかるといいにゃ～♪
#. de: Ich warte ... ♪
#. fr: Viens morrrdre à l'hameçon...♪
msgctxt "Balloon:2535:0:1"
msgid "I'm waaaiting...♪"
msgstr "Ну, я жду...♪"

#. ja: おっ♪
#. de: Ohooo ♪
#. fr: Ohoo<nbsp>!♪
msgctxt "Balloon:2536:0:1"
msgid "Oh!"
msgstr "О!"

#. ja: おっきなの釣れたにゃ～！
#. de: Ha, du dachtest wohl, du kannst mir entkommen!
#. fr: Haha<nbsp>! Tu as crrru que tu allais m'échapper, mon dodu<nbsp>!
msgctxt "Balloon:2537:0:1"
msgid "Thought you could get away, didn't you?"
msgstr "Думала, сбежишь от меня?"

#. ja: ご主人さまも喜ぶにゃ～♪
#. de: Mein Herr wird mit dir zufrieden sein - und mit mir!
#. fr: C'est mon maîtrrre qui va être content d'obtenir encore un poisson<nbsp>!♪
msgctxt "Balloon:2538:0:1"
msgid "Master will be pleased with you─and with me!"
msgstr "Хозяин будет доволен и тобой, и мной!"

#. ja: ボウズにゃ…<br>何か買って帰るにゃ…
#. de: So eine Pleite! Ich sollte mir einfach einen Fisch kaufen.
#. fr: Tant pis... Je n'ai qu'à acheter un poisson en rentrrrant en ville.
msgctxt "Balloon:2539:0:1"
msgid "...Sod this. I should just buy a fish."
msgstr "...Да ну его. Проще рыбу купить."

#. ja: 来たね、冒険者さん！
#. de: Schön, dass du da bist!
#. fr: Youpi<nbsp>! Ça va être la fête<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2540:0:1"
msgid "Look, children!<br>An adventurer!"
msgstr "Смотрите, дети!<br>Авантюрист!"

#. ja: がんばれ～ッ！
#. de: Viel Glück!
#. fr: Allez<nbsp>! Allez<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2541:0:1"
msgid "Do you have your<br>own magitek armor?"
msgstr "А у тебя есть<br>свой магитековый доспех?"

#. ja: 華麗な技を見せて！
#. de: Zeig, was du drauf hast!
#. fr: Montrez-nous de quoi vous êtes capable<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2542:0:1"
msgid "Would that my man<br>was as reliable as<br>an adventurer."
msgstr "Эх, вот бы мой муж<br>был таким же надёжным,<br>как авантюрист."

#. ja: 私も冒険者になるんだ！
#. de: Ich werd auch mal eine Abenteurerin!
#. fr: Moi aussi, je veux devenir aventurière<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2543:0:1"
msgid "I'm going to be<br>an adventurer<br>when I grow up!"
msgstr "Когда вырасту,<br>стану<br>авантюристкой!"

#. ja: 応援してるぞ！
#. de: Du schaffst das!
#. fr: J'suis de tout cœur avec toi, <if $gn4>ma grande<else>mon gars</if><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2544:0:1"
msgid "Put on a good<br>show for us, eh?"
msgstr "Ну-ка, покажи<br>нам класс!"

#. ja: がんばってね！
#. de: Gib alles!
#. fr: Faites de votre mieux<nbsp>!
#. macro: <if $gn4>She's so pretty<else>He must be<br>really strong</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2545:0:1"
msgid "<if $gn4>She's so pretty<else>He must be<br>really strong</if>!"
msgstr "<if $gn4>Какая красавица<else>Наверняка он<br>очень силён</if>!"

#. ja: おっ、来たぞ！
#. de: Oh, da ist ja <if $gn4>eine<else>einer</if>!
#. fr: Génial<nbsp>! V'là un<if $gn4>e</if> aventuri<if $gn4>ère<else>er</if><nbsp>!
msgctxt "Balloon:2546:0:1"
msgid "Blast them to bits!"
msgstr "Разнесите их в клочья!"

#. ja: 冒険者さ～ん！
#. de: Verpass ihnen 'ne schöne Breitseite!
#. fr: J'aime trop les aventuriers<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2547:0:1"
msgid "Wow! You have<br>big muscles!"
msgstr "Ого! Какие<br>у тебя мускулы!"

#. ja: 凛々しいな…
#. de: Welch Kühnheit!
#. fr: Ouah, la classe<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2548:0:1"
msgid "Such gallant bearing...<br>The tales do not lie."
msgstr "Какая стать...<br>Сказания не врали."

#. ja: かっこいいね！
#. de: Beeindruckend!
#. fr: Ouah, comment <if $gn4>elle<else>il</if> a l'air balèze<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2549:0:1"
msgid "Princesses are<br>boring! I want to<br>be an adventurer!"
msgstr "Принцессы — скукотища! Хочу<br>стать авантюристкой!"

#. ja: がんばってー！
#. de: Viel Glück!
#. fr: Bon courage<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2550:0:1"
msgid "We're praying for<br>your success!"
msgstr "Мы будем молиться,<br>чтобы ты победил!"

#. ja: ぼうけんしゃさんだー！
#. de: Oh, wie ist das schööön! ♪
#. fr: Youpi<nbsp>! Un<if $gn4>e</if> aventuri<if $gn4>ère<else>er</if><nbsp>!
#. macro: <if $gn4>her<else>his</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2551:0:1"
msgid "I wanna see <if $gn4>her<else>his</if><br>battle scars!"
msgstr "Хочу увидеть <if $gn4>её<else>его</if><br>боевые шрамы!"

#. ja: おっ！
#. de: Seht an, <if $gn4>eine Abenteurerin<else>ein Abenteurer</if>!
#. fr: Oh<nbsp>! Regardez, un<if $gn4>e</if> aventuri<if $gn4>ère<else>er</if><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2552:0:1"
msgid "At last, we get to<br>see some action!"
msgstr "Наконец-то увидим<br>настоящую битву!"

#. ja: がんばってね♪
#. de: Viel Erfolg!
#. fr: Faites-nous rêver<nbsp>!♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2553:0:1"
msgid "How high can you<br>jump? Can you touch<br>that big balloon?"
msgstr "А высоко ты<br>прыгаешь? Достанешь<br>до того шара?"

#. ja: ドカンと頼むよ！
#. de: Lass es krachen!
#. fr: Je veux voir des beaux feux d'artifice<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2554:0:1"
msgid "Make the bad<br>Bombards fly!"
msgstr "Разнеси<br>бомбард в пух и прах!"

#. ja: 冒険者さんだー！
#. de: Seht mal, <if $gn4>eine Abenteurerin<else>ein Abenteurer</if>!
#. fr: Vous allez nous offrir un beau spectacle<nbsp>?
msgctxt "Balloon:2555:0:1"
msgid "Ooh, a real adventurer!"
msgstr "Ух ты, настоящий авантюрист!"

#. ja: きたきたー！
#. de: Jetzt geht's los!
#. fr: Ah, en voilà un<if $gn4>e</if><nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2556:0:1"
msgid "The children have <i>so</i><br>looked forward to this."
msgstr "Дети так<br><i>ждали</i> этого."

#. ja: やっちゃえー！
#. de: Mach sie fertig!
#. fr: Je veux en voir de toutes les couleurs<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2557:0:1"
msgid "Adventurers are<br>the greatest!"
msgstr "Авантюристы —<br>лучшие!"

#. ja: やったー！<br>種が採れた！
#. de: Na endlich! Das wurde aber auch Zeit.
#. fr: Ah, enfin<nbsp>! Depuis le temps que je cherche une de ces satanées graines<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2558:0:1"
msgid "There you are!<br>About damn time!"
msgstr "Вот ты где!<br>Давно пора!"

#. ja: キングスイールド！
#. de: Lenk mich nicht ab!
#. fr: Bon, c'est pas le moment de se déconcentrer<nbsp>!
msgctxt "Balloon:2559:0:1"
msgid "Focus, focus!"
msgstr "Сосредоточься, соберись!"

#. ja: お、これは！？
#. de: Ah, ist das nicht ...?
#. fr: Oh<nbsp>! Voyons, voyons, qu'est-ce que j'ai, là...<nbsp>?
msgctxt "Balloon:2560:0:1"
msgid "Ah! Is that...?"
msgstr "О! Неужели это?.."

#. ja: きた、高品質！
#. de: Ja! Perfekt!
#. fr: Oui<nbsp>! Parfait<nbsp>!
msgctxt "Balloon:2561:0:1"
msgid "Yes! It's flawless!"
msgstr "Да! Идеально!"

#. ja: うむ、なかなか！
#. de: Nicht schlecht, Herr Specht!
#. fr: Mouais, pas mal joué<nbsp>!
msgctxt "Balloon:2562:0:1"
msgid "Not bad, not bad!"
msgstr "Неплохо, неплохо!"

#. ja: よし、いい感じだ！
#. de: Noch ein bisschen ...
#. fr: Je sens que j'ai de la veine, aujourd'hui<nbsp>!
msgctxt "Balloon:2563:0:1"
msgid "A little more..."
msgstr "Ещё немного..."

#. ja: ふ～、疲れるぜ
#. de: Bei den Sieben Höllen, ist das anstrengend!
#. fr: Ouf<nbsp>! Je commence à fatiguer, moi...
msgctxt "Balloon:2564:0:1"
msgid "Seven hells, this is exhausting!"
msgstr "Семь адов, как же я устал!"

#. ja: お、同業者か？<br>お互いがんばろうな！
#. de: Du auch? Viel Glück!
#. fr: T'es du métier, toi aussi<nbsp>? Bon courage à nous deux<nbsp>!
msgctxt "Balloon:2565:0:1"
msgid "You too, eh? Best of luck to you, friend!"
msgstr "И ты, да? Удачи, друг!"

#. ja: さてと…<br>ご主人さまに届けるかな
#. de: Immerhin kehre ich nicht mit leeren Händen zurück.
#. fr: Bon, il est temps que je rapporte tout ça à ma maîtresse.
msgctxt "Balloon:2566:0:1"
msgid "Well, time to pack up."
msgstr "Ну, пора собираться."

#. ja: さてと…<br>次の仕事を探さないとね！
#. de: Also gut, Zeit für 'ne neue Beschäftigung.
#. fr: Bon<nbsp>! Il nous reste plus qu'à trouver un nouveau boulot.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2567:0:1"
msgid "If I never have to move<br>another tree, it'll be too soon."
msgstr "Если мне больше никогда не придётся<br>перетаскивать деревья, будет не скоро."

#. ja: 武器の素振りが<br>ここの警備で役立つとは！
#. de: Mein Training war nicht umsonst! Es hat mir diesen Posten als Wächter eingebracht!
#. fr: Garde, c'est pas plus ennuyeux que d'explorer cent fois l'même donjon, après tout...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2568:0:1"
msgid "Lay a finger on any of the<br>splendors, and I'll cut it off."
msgstr "Только троньте хоть одну<br>из этих красот — и я вам пальцы отрублю."

#. ja: 巴術士の心得…<br>そんな本あったかしら…
#. de: Gibt's denn nirgendwo eine gute Einführung in die Hermetik?
#. fr: Il n'y a pas un livre d'initiation à l'arcanisme quelque part<nbsp>?<nbsp>...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2569:0:1"
msgid "My copy of <i>Ona Ramuhda</i>!<br>It was here this morning!"
msgstr "Куда делся мой экземпляр <i>«Она Рамунда»</i>?<br>Утром же был здесь!"

#. ja: みんな、何を見てるんだ？
#. de: Gibt's hier irgendwas zu sehen?
#. fr: Mais qu'est-ce qu'ils regardent, ceux-là<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2570:0:1"
msgid "Do I see it? Uh, why, of<br>course I see <i>it</i>. Don't you?"
msgstr "Я это вижу? Ну конечно, вижу <i>это</i>. А ты нет?"

#. ja: 海に沈めてやろう！
#. de: Versinke im Meer!
#. fr: Je vais te noyer<nbsp>!
msgctxt "Balloon:2571:0:1"
msgid "Ye'll sleep with the fishes!"
msgstr "Отправлю тебя спать с рыбами!"

#. ja: 蟹のエサにしてくれる！
#. de: Ich mach Krabbenfutter aus dir!
#. fr: Tu vas servir de pâture aux crabes<nbsp>!
msgctxt "Balloon:2572:0:1"
msgid "Yer crab fodder!"
msgstr "Станешь кормом для крабов!"

#. ja: 水神様のために！
#. de: Für den Herrn der Wogen!
#. fr: Au nom de Léviathan<nbsp>!
msgctxt "Balloon:2573:0:1"
msgid "Fer Lord Leviathan!"
msgstr "За владыку морей Левиафана!"

#. ja: さあ、私たちと一緒に…
#. de: Ergötze dich mit uns ...
#. fr: Viens avec nouuus<nbsp>!
msgctxt "Balloon:2574:0:1"
msgid "One of us! One of us!"
msgstr "Стань одним из нас! Стань одним из нас!"

#. ja: この姿を…見るな…！
#. de: ... an diesem Anblick!
#. fr: Non... Ne me regarde paaas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2575:0:1"
msgid "Don't look at me!<br>Don't look at meee!"
msgstr "Не смотри на меня!<br>Не смотри-и-и!"

#. ja: どうせ戻れないなら…
#. de: Es gibt sowieso kein Zurück mehr ...
#. fr: Il n'y a plus d'échappatoire<nbsp>!
msgctxt "Balloon:2576:0:1"
msgid "There's no going back..."
msgstr "Назад пути нет..."

#. ja: よしっ、勝ったぞっ！
#. de: Haha! Der Sieg ist mein!
#. fr: Hé hé hé<nbsp>! La victoire est mienne<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2577:0:1"
msgid "Hah hah!<br>Victory is mine!"
msgstr "Ха-ха!<br>Победа за мной!"

#. ja: すごいな！<br>また勝ったんだって！？
#. de: Hast du auch die Kunde von dem glorreichen Sieg vernommen?!
#. fr: Ouah<nbsp>! T'as encore gagné<nbsp>!? T'es vraiment trop balèze<nbsp>!
msgctxt "Balloon:2578:0:1"
msgid "Well, I'll be!"
msgstr "Вот это да!"

#. ja: 次の試合まで時間があるな<br>いまのうちに届けよう
#. de: Bis zum nächsten Kampf bleibt mir Zeit, die bestellten Waren abzuliefern.
#. fr: Bon, je vais profiter de cette petite pause pour livrer mon maître.
msgctxt "Balloon:2579:0:1"
msgid "Wouldn't do to keep the client waiting..."
msgstr "Не стоит заставлять заказчика ждать..."

#. ja: 獲物はいないかな？
#. de: Keine Beute in Sicht?!
#. fr: Y a pas quelque chose pour moi<nbsp>?
msgctxt "Balloon:2580:0:1"
msgid "Anything for me?"
msgstr "Для меня ничего нет?"

#. ja: うーん、いないな…
#. de: Heute habe ich wohl kein Glück.
#. fr: On dirait bien que non. Tant pis...
msgctxt "Balloon:2581:0:1"
msgid "No? Bah."
msgstr "Нет? Эх."

#. ja: 来ちゃダメでふっち！
#. de: Die Meinige will in Ruhe gelassen werden!
#. fr: N'approchez pas<nbsp>!<br>Retournez là-bas<nbsp>!
msgctxt "Balloon:2582:0:1"
msgid "Stay away from this one!"
msgstr "Не подходи к этому!"

#. ja: あ～、酒が切れちまう！
#. de: Du sagst es, Bruder! Schenk gleich mal einen ein!
#. fr: Argh<nbsp>! Y a presque plus de gnôle<nbsp>!
msgctxt "Balloon:2583:0:1"
msgid "Bah! We've almost drunk the wine dry!"
msgstr "Эх! Вино уже почти всё выпили!"

#. ja: 商談、早く終わんねぇかなぁ…
#. de: Hoffentlich \<hick> gehn die Gespräche noch schla-lange!
#. fr: Ces négociations n'en finiront donc jamais...
msgctxt "Balloon:2584:0:1"
msgid "Let's hope this meeting ends quickly..."
msgstr "Вот бы встреча поскорее закончилась..."

#. ja: たらふく食えよ…チビ助どもッォ
#. de: Sieht kleiner Helfer echt lecker, kah!
#. fr: Ceux-là sont de bons petits... Ils doivent bien manger<nbsp>!
msgctxt "Balloon:2585:0:1"
msgid "Eat well and grow big, you must!"
msgstr "Ешьте досыта и растите большими!"

#. ja: 基礎が大事だよなッァ！
#. de: Ist Grundlage alles, weißt du?
#. fr: Celui-ci est d'accord, c'est les fondations qui soutiennent tout<nbsp>!
msgctxt "Balloon:2586:0:1"
msgid "Be strong and sturdy, foundation must!"
msgstr "Главное — крепкий фундамент!"

#. ja: まだまだ先は長いぜッェ！
#. de: Haben wir noch viel zu tun, kah.
#. fr: Ceux-ci doivent être patients<nbsp>!
msgctxt "Balloon:2587:0:1"
msgid "Much work to be done, there is! Much work..."
msgstr "Работы ещё невпроворот! Ещё сколько всего сделать..."

#. ja: だいぶ形になってきたぜッェ！
#. de: Sieht Schiff schon echt schnittig aus, findest du nicht?
#. fr: Petit à petit, le travail de ceux-ci prend forme<nbsp>!
msgctxt "Balloon:2588:0:1"
msgid "Beginning to take shape, it is!"
msgstr "Уже начинает вырисовываться!"

#. ja: ヒトの技術もたいしたモンだッァ！
#. de: Federlose auch was drauf haben, kah!
#. fr: Celui-ci est im<shy>pres<shy>sion<shy>né par la technologie des humains<nbsp>!
msgctxt "Balloon:2589:0:1"
msgid "Contribute much to our progress, craft of no-feathers does!"
msgstr "Немало нашему делу помогает ремесло бескрылых!"

#. ja: 完成まで、あと少しッィ！
#. de: Bald ist fertig, staunst du aber!
#. fr: Encore un peu et ça sera prêt<nbsp>!
msgctxt "Balloon:2590:0:1"
msgid "Soon take to sky, we will!"
msgstr "Скоро взлетим!"

#. ja: 俺たちの夢は終わらねッェ！
#. de: ♪ Über den Wolken, muss der Freiheit wohl grenzenlos sein ♪ Äh, das Freiheit?
#. fr: Le rêve de ceux-ci n'est pas fini<nbsp>!
msgctxt "Balloon:2591:0:1"
msgid "Surrender our dream, we will not!"
msgstr "От мечты мы не откажемся!"

#. ja: ぐがーぐがー…
#. de: Jawohl, Meister Tata...Zzz \<schnarch>
#. fr: Rrrr... zzZZZ...
msgctxt "Balloon:2592:0:1"
msgid "Have another cup... \\<snore>"
msgstr "Налейте ещё... \\<храп>"

#. ja: ほかの場所を探すにゃ…
#. de: Irgendwo muss sie doch stecken ...
#. fr: Je vais cherrrcher autre part...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2598:0:1"
msgid "Perhaps poor Ruby's<br>wandered off..."
msgstr "Может, бедняжка Руби<br>куда-то забрела..."

#. ja: いなかったにゃ…
#. de: Hier war sie nicht ...
#. fr: Grrr... Il n'est pas par ici...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2599:0:1"
msgid "Looking for Ruby<br>in all the wrong places.♪"
msgstr "Ищу Руби где попало.♪"

#. ja: ルビーちゃーん、どこー？
#. de: Rubinchen, wo bist du?
#. fr: Ruuubiii<nbsp>!!! Mais tu es où<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2600:0:1"
msgid "Now where in Nophica's<br>name did that girl go?"
msgstr "Да где же, именем Нопики,<br>эта девчонка пропала?"

#. ja: クンクン
#. de: Fiep, fiep.
#. fr: (snif) (snif)...
msgctxt "Balloon:2601:0:1"
msgid "\\<sniff> \\<sniff>"
msgstr "\\<нюх> \\<нюх>"

#. ja: もう、どこ行ったにゃ…
#. de: Komm sofort zurück, sonst gibt es kein Fresschen!
#. fr: Si je l'attrrrape, je l'attache à un piquet<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2602:0:1"
msgid "Come out this instant or<br>you're going without supper!"
msgstr "Вылезай сию же минуту, а то<br>останешься без ужина!"

#. ja: おーい、ルビーちゃん！
#. de: Rubiiinchen!
#. fr: Ruuubiii<nbsp>!!! Viens, mon petit<nbsp>! Montrrre-toi<nbsp>!
msgctxt "Balloon:2603:0:1"
msgid "Ruby!? Ru～by!?"
msgstr "Руби!? Ру-у-би!?"

#. ja: なんでオイラが<br>こんなことを…
#. de: Warum nur?!
#. fr: Pourquoi ça nous arrive à nous...<nbsp>?
msgctxt "Balloon:2604:0:1"
msgid "Why, oh why?"
msgstr "Ну за что мне всё это?"

#. ja: しっかりしろ！
#. de: Los, hoch!
#. fr: Tiens bon<nbsp>!
msgctxt "Balloon:2605:0:1"
msgid "Come, you must stand!"
msgstr "Давай, держись! Вставай!"

#. ja: うぅ…もうダメだ…
#. de: Urgs, ich ... zu schwach ...
#. fr: Urghhh...
msgctxt "Balloon:2606:0:1"
msgid "Ughhh..."
msgstr "У-ух..."

#. ja: せっかく怨みが<br>晴れたのに…
#. de: Dabei waren wir gerade vom Groll befreit ...
#. fr: Dire qu'on vivait enfin en paix...
msgctxt "Balloon:2607:0:1"
msgid "Just as we were free from the rancor..."
msgstr "И только мы избавились<br>от этой злобы..."

#. ja: 静かに暮らしたい…
#. de: Wir wollen doch nur in Frieden leben!
#. fr: J'aimerais qu'on nous laisse tranquilles...
msgctxt "Balloon:2608:0:1"
msgid "Can we not just live in peace?"
msgstr "Неужели нельзя просто жить спокойно?"

#. ja: グェェェェ…
#. de: Graaarrrgh ...
#. fr: Graaarrrgh...
msgctxt "Balloon:2609:0:1"
msgid "Graaarrrgh..."
msgstr "Гра-а-а-а..."

#. ja: ウゥゥゥゥ…
#. de: Urghh ...
#. fr: Hurrrgh...
msgctxt "Balloon:2610:0:1"
msgid "Hurrrgh..."
msgstr "Ур-р-р..."

#. ja: アウ…アウゥゥゥ…
#. de: Mhhrgh ...
#. fr: Gwouuh... gwouuuh...
msgctxt "Balloon:2611:0:1"
msgid "Kill me... End it..."
msgstr "Убей меня... Покончи с этим..."

#. ja: 救援だって！？<br>た、たのむ、仲間を…
#. de: I-Ihr helft uns? Bitte, rettet meine Freunde!
#. fr: Vous êtes venus nous aider<nbsp>? Pitié, sauvez mes amis<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2612:0:1"
msgid "H-Have you come to help us?<br>Or hurt us!?"
msgstr "В-вы пришли нам помочь?<br>Или навредить?!"

#. ja: クンクン
#. de: Fiep, fiep.
#. fr: (snif) (snif)...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2613:0:1"
msgid "Where, oh where has<br>my little girl gone?♪"
msgstr "Где же, где же<br>моя малышка?♪"

#. ja: いったい、どこにゃ！？
#. de: Komisch, sie ist wie vom Erdboden verschluckt ...
#. fr: Raaah<nbsp>! J'ai l'imprrression de passer mon temps à chercher cet idiot de familier<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2614:0:1"
msgid "Oh where, oh where<br>can she be?♪"
msgstr "Да где же она?!"

#. ja: 仲間を助けてください！
#. de: Bitte helft meinen Gefährten!
#. fr: Sauvez mes compagnons<nbsp>!
msgctxt "Balloon:2615:0:1"
msgid "Please help my companions!"
msgstr "Пожалуйста, помогите моим товарищам!"

#. ja: おいおい…<br>ケンカは外で頼むぜ
#. de: He! Könnt ihr das bitte<br>draußen austragen!?
#. fr: Eh, oh<nbsp>! Si vous voulez vous battre, c'est dehors que ça se passe<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2616:0:1"
msgid "Pray take your disagreement<br><i>outside</i>."
msgstr "Разбирайтесь со своими ссорами<br><i>на улице</i>."

#. ja: 釣れるといいな♪
#. de: Hoffentlich beißt einer an!
#. fr: J'espère que ça va mordre aujourd'hui...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2617:0:1"
msgid "Dangle a string off the<br>edge? How hard can this be?"
msgstr "Закинуть леску с края?<br>Да что тут сложного?"

#. ja: 大物こーい！
#. de: Brav anbeißen, Kapitalfischchen!
#. fr: Allez, quoi<nbsp>! Rien qu'un ou deux gros poissons...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2618:0:1"
msgid "This one's a right<br>monster, it is!"
msgstr "Вот это рыбина,<br>так рыбина!"

#. ja: おおっ！？
#. de: Oh?!
#. fr: Oh<nbsp>!?
msgctxt "Balloon:2619:0:1"
msgid "If this is another boot..."
msgstr "Только не очередной сапог..."

#. ja: よーし、釣れたー！
#. de: Und ab ins Eimerchen!
#. fr: Oh, la belle prise<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2620:0:1"
msgid "The one that got<br>away, my arse!"
msgstr "Уж точно не упустил!"

#. ja: ご主人さまも喜ぶぞ～♪
#. de: Da freut sich der Boss!
#. fr: C'est mon maître qui va être content.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2621:0:1"
msgid "Master SephiroxXx will be<br>delighted with today's catch!"
msgstr "Господин Сефирокс будет<br>в восторге от сегодняшнего улова!"

#. ja: ううう、ボウズかぁ…<br>何か買って帰らなきゃ…
#. de: Mist, Fehlanzeige. Muss wohl was kaufen gehen.
#. fr: Chou blanc... Il va falloir faire les courses en rentrant.
msgctxt "Balloon:2622:0:1"
msgid "Kelp... Always kelp..."
msgstr "Опять одна ламинария..."

#. ja: やったー！<br>こんなにいっぱい♪
#. de: Diese Ausbeute kann sich sehen lassen!
#. fr: Youpi<nbsp>! Ça c'est ce que j'appelle une bonne récolte<nbsp>!
msgctxt "Balloon:2623:0:1"
msgid "A fine specimen, this is!"
msgstr "Вот это экземпляр!"

#. ja: キングスイールドだ！
#. de: Auf einen fürstlichen Ertrag!
#. fr: Récolte royale<nbsp>!
msgctxt "Balloon:2624:0:1"
msgid "Just one more..."
msgstr "Ещё одну..."

#. ja: おお、これは！？
#. de: Nanu, was ist denn das?
#. fr: J'en crois pas mes yeux...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2625:0:1"
msgid "Well, well!<br>What do we have here?"
msgstr "Ну-ну!<br>Что у нас тут?"

#. ja: たくさん採れたぞ！
#. de: Hurra! Da ist mehr als genug!
#. fr: Génial<nbsp>! Y en a foison<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2626:0:1"
msgid "This'll fetch<br>a fine price."
msgstr "За такую уловку<br>платят хорошие деньги."

#. ja: よし、なかなか！
#. de: Heute hab ich Glück, das spür ich zwischen meinen Zehen.
#. fr: C'est mon jour de chance.
msgctxt "Balloon:2627:0:1"
msgid "Another decent find."
msgstr "Ещё одна неплохая находка."

#. ja: おお、いい感じだ！
#. de: Nicht schlecht, wahrlich nicht schlecht.
#. fr: Pas mal... Vraiment pas mal<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2628:0:1"
msgid "I've fallen headfirst into<br>the Matron's bosom!"
msgstr "Прямо в объятия Матроны свалился!"

#. ja: ふ～、疲れるぜ
#. de: Puh ... Lang mache ich heute nicht mehr.
#. fr: Pfiou<nbsp>! C'est éreintant, tout ça.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2629:0:1"
msgid "I'd risk a moment of<br>rest but you never know<br>when Master is watching..."
msgstr "Отдохнул бы чуток, да кто знает,<br>не следит ли за мной хозяин..."

#. ja: よう、同業者か？<br>せいがでるな！
#. de: Na, fleißig bei der Arbeit?
#. fr: Tiens, <if $gn4>une consœur<else>un confrère</if>... Courage à vous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2630:0:1"
msgid "Step back, friend. That<br>spot is already claimed."
msgstr "Отойди, дружище. Это место<br>уже занято."

#. ja: こんなもんだろう<br>ご主人さまに届けよう
#. de: Das war's. Zeit, das Geröll nach Hause zu bringen.
#. fr: J'ai enfin terminé. Reste plus qu'à apporter tout ça à mon maître.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2631:0:1"
msgid "This take should stay<br>Master's hand tonight."
msgstr "С таким уловом сегодня<br>хозяин будет сыт по горло."

#. ja: よしっ、連勝だっ！
#. de: Wieder ein glorreicher Sieg!
#. fr: Et encore une fois, c'est un triomphe<nbsp>!
msgctxt "Balloon:2632:0:1"
msgid "I am INVINCIBLE!"
msgstr "Я НЕПОБЕДИМ!"

#. ja: すごいな！<br>また勝ったんだって！？
#. de: Was? Schon wieder? Du bist ja unglaublich!
#. fr: Incroyable<nbsp>! Vous gagnez vraiment à tous les coups, vous...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2633:0:1"
msgid "The Spinner smiles on<br>you this day, friend."
msgstr "Сегодня сама Прядильщица<br>тебе улыбнулась, дружище."

#. ja: ふふ、楽勝さ<br>ひとつ上の装備をくれ
#. de: Ja, es ist ja fast zu einfach ...
#. fr: Quelle chance<nbsp>! Vous n'auriez pas de l'équipement de qualité à me prêter<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2634:0:1"
msgid "Who needs luck when<br>you have skill to spare?"
msgstr "Да какая удача, когда<br>мастерства хоть отбавляй?"

#. ja: 次まで時間があるか…<br>いまのうちに届けよう
#. de: So, ich bring meine Schäfchen ins Trockene.
#. fr: Il me reste du temps avant ma prochaine tâche. Je vais en profiter pour boire un coup.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2635:0:1"
msgid "Might be I've time to wet<br>me lips on a warm ale."
msgstr "До следующего дела ещё есть время...<br>Успею пропустить кружечку эля."

#. ja: この辺の獲物は<br>狩り尽くしたかな？
#. de: Ich frage mich, ob hier noch was zu holen ist?
#. fr: Je me demande s'il y a encore du gibier à chasser ici.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2636:0:1"
msgid "Appears this area's<br>been picked clean."
msgstr "Похоже, в этих краях<br>всё уже переловили."

#. ja: 次はどこで狩るかな…
#. de: Mal sehen, wo ich mich als Nächstes auf die Pirsch begebe ...
#. fr: Bon, il faut que je trouve un autre terrain de chasse...
msgctxt "Balloon:2637:0:1"
msgid "Where to next?"
msgstr "Куда бы податься дальше?"

#. ja: がんばるぞ♪
#. de: Na, dann mal in die Hände gespuckt! \<grins>
#. fr: C'est parti<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2638:0:1"
msgid "Nothing like sweat on the<br>brow to soothe the soul."
msgstr "Нет ничего лучше, чем<br>трудиться в поте лица!"

#. ja: ザックザクだね♪
#. de: Der ist nicht von schlechten Eltern, dieser Lalafell! \<zwinker>
#. fr: La récolte va être bonne.
msgctxt "Balloon:2639:0:1"
msgid "Another...and another...and...!"
msgstr "Ещё... и ещё... и ещё...!"

#. ja: やったね♪
#. de: Hurra! So einen Brocken findet man nicht alle Tage!
#. fr: Wouhou<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2640:0:1"
msgid "I wouldn't call myself a<br>natural, but I'm a natural!"
msgstr "Не скажу, что у меня талант,<br>но он у меня есть!"

#. ja: なかなか♪
#. de: So langsam komm ich in Fahrt!
#. fr: J'ai décroché le gros lot.♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2641:0:1"
msgid "One for Master...<br>(One for me...)"
msgstr "Одну хозяину...<br>(Одну себе...)"

#. ja: いい感じ♪
#. de: Na, wer sagt's denn! Wieder einer!
#. fr: Quelle récolte mes enfants, quelle récolte<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2642:0:1"
msgid "As easy as taking<br>candy from a rock!"
msgstr "Легче лёгкого, как<br>с камня конфетку снять!"

#. ja: ふひぃ、疲れた～
#. de: Puh ... Ich glaub, meine Schwielen fangen an zu dampfen.
#. fr: J'en peux plus...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2643:0:1"
msgid "Never have I<br>labored so hard..."
msgstr "Никогда ещё я<br>так не вкалывал..."

#. ja: 貴方も採掘に？<br>がんばろうね♪
#. de: Auch zum Schürfen hier? Dann lass dich nicht abhalten.
#. fr: Salut vous<nbsp>! Vous êtes venu<if $gn4>e</if> exploiter ce filon<nbsp>? Bonne chance<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2644:0:1"
msgid "Take my word. The land<br>here will yield no more."
msgstr "Поверь, здесь больше<br>ничего не найдёшь."

#. ja: いっぱい採れたぞ♪<br>すぐに帰らなきゃ！
#. de: Das hat sich mächtig gelohnt! Ich düs mal ab. Viel Spaß noch!
#. fr: J'ai bien travaillé. Il faut que je me dépêche de rentrer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2645:0:1"
msgid "Finally! I can return home<br>to my children at last!"
msgstr "Наконец-то! Можно возвращаться<br>домой, к детям!"

#. ja: こっちも忙しいのに<br>何度も呼び出さないでよ…
#. de: Diese ständige Klingelei! Als hätte Unsereins nichts Besseres zu tun ...
#. fr: Comment voulez-vous que je travaille si on n'arrête pas de me sonner<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2646:0:1"
msgid "Must you call<br>every quarter bell?"
msgstr "Обязательно звонить<br>каждый четвертьчас?"

#. ja: あんたも同業者？<br>お互い苦労するわね…
#. de: Geht Ihr auch der Gärtnerei nach? Ein tolles Hobby, so beruhigend ...
#. fr: Je vois que je ne suis pas la seule à connaître ce coin...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2647:0:1"
msgid "Not here to steal<br>my spot now, are you?"
msgstr "Моё место присмотреть пришёл?"

#. ja: また呼び出しだわ…<br>今度は何を売るのかしら
#. de: Jetzt hat man mich schon wieder gerufen! Irgendwann verbuddel ich diese verfluchte Kontaktperle noch mit meinen Tulpenzwiebeln!
#. fr: Et voilà qu'on me sonne encore... C'est pour quoi, cette fois<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2648:0:1"
msgid "Another call? I wonder<br>what he wants this time..."
msgstr "Опять вызов...<br>Чего ему на этот раз надо?"

#. ja: 釣れるといいが…
#. de: Das sieht mir nach einem guten Plätzchen aus.
#. fr: J'ai un mauvais prrressentiment.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2649:0:1"
msgid "Ten bells and<br>not a single bite..."
msgstr "Десять ударов колокола,<br>а ни одной поклёвки..."

#. ja: たまには大物が<br>かかってほしいぜ
#. de: Ich hab ein rrrichtig gutes Gefühl ...
#. fr: J'en ai assez des petits poissons. Où sont les grrros<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2650:0:1"
msgid "Enough with the fries...<br>I'm here for a king!"
msgstr "Хватит мелочи...<br>Я за королём пришёл!"

#. ja: きたかっ！？
#. de: Na also! Ich hab's ja gesagt!
#. fr: Je crois que ça morrrd<nbsp>!
msgctxt "Balloon:2651:0:1"
msgid "You're mine now!"
msgstr "Теперь ты мой!"

#. ja: やったぜ、大物だ！
#. de: Das ist kein Fisch, das ist ein Seeungeheuer!
#. fr: Il doit être énorrrme, celui-là<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2652:0:1"
msgid "The bloody thing's<br>a good yalm across!"
msgstr "Чтоб её, да она в ярд<br>поперёк будет!"

#. ja: ご主人さまも<br>さぞ喜んでくれるだろう
#. de: Meine Herrin wird mich begeistert zwischen den Ohren kraulen, wenn ich damit nach Hause komme.
#. fr: Ma maîtrrresse va être aux anges<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2653:0:1"
msgid "Freedom earned<br>with a dragon!"
msgstr "Дракон — и свобода!"

#. ja: ダメだな…<br>ほかに行ってみるか
#. de: Hier ist nichts zu holen. Ich zieh weiter.
#. fr: Quand ça veut pas, ça veut pas. Il faut peut-être changer d'endrrroit.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2654:0:1"
msgid "I've caught nothing<br>here but the chills."
msgstr "Тут от холода только и спасения...<br>Пойду в другое место."

#. ja: かっこいい<br>リテイナーさんにゃ～♪
#. de: Hui! Ein hübscher Gehilfe! Und wie er die Rute schwingt!
#. fr: Mais regardez-moi ce serrrvant<nbsp>! Il est canon.
msgctxt "Balloon:2655:0:1"
msgid "Well met!"
msgstr "Приветствую!"

#. ja: 釣れますにゃ～？
#. de: Hast du schon was Schuppiges an Land gezogen?
#. fr: J'ai com<shy>plè<shy>te<shy>ment morrrdu à votre hameçon<nbsp>!
msgctxt "Balloon:2656:0:1"
msgid "Anything bite?"
msgstr "Клюёт?"

#. ja: 集中しているんだ<br>邪魔しないでくれ
#. de: Verdufte. Ich muss mich konzentrieren.
#. fr: J'essaie de me concentrer. Ne venez pas me dérrrangez, Madame.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2657:0:1"
msgid "Venturing requires all <i>six</i><br>senses. Yes, I said <i>six</i>."
msgstr "На вылазке нужны все <i>шесть</i><br>чувств. Да, я сказал <i>шесть</i>."

#. ja: この辺りは危ないぞ<br>崖から落ちるなよ！
#. de: Aufgepasst. Hier geht's steil runter ...
#. fr: Faites attention en repartant. La pente est un peu rrraide.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2658:0:1"
msgid "Mind your step. 'Tis a<br>long way to the bottom."
msgstr "Смотри под ноги. До дна<br>отсюда далеко."

#. ja: この子を助けて…！
#. de: Bitte helft unserem Kind!
#. fr: S'il vous plaît, sauvez cet enfant<nbsp>!
msgctxt "Balloon:2659:0:1"
msgid "Pray help our child!"
msgstr "Пожалуйста, помогите нашему ребёнку!"

#. ja: しっかり！目を開けろ！
#. de: Mach die Augen auf, Sohn!<br>Bitte!
#. fr: Tu m'entends<nbsp>? Ouvre les yeux, bon sang<nbsp>!
msgctxt "Balloon:2660:0:1"
msgid "Open your eyes, son! Please!"
msgstr "Открой глаза, сынок! Прошу!"

#. ja: ナニナニ、御用っちゃ？
#. de: Was du willst hier?
#. fr: Aventuuuuri<if $gn4>ère<else>er</if> veut quelque chose<nbsp>?
msgctxt "Balloon:2661:0:1"
msgid "Hoho, a handy blade for each hand!"
msgstr "Ого, по клинку в каждой руке!"

#. ja: なるほどな…<br>ほかに情報はないか？
#. de: Sieh an! Mehr weißt du nicht darüber?
#. fr: Hmm, je vois... Y a-t-il autre chose<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2662:0:1"
msgid "Is that it?<br>What else can you tell me?"
msgstr "И это всё?<br>Что ещё можешь рассказать?"

#. ja: 遅い…まだ来ないのか…
#. de: Sie sind spät dran.<br>Mal wieder ...
#. fr: Pfff, combien de temps encore vais-je devoir attendre...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2663:0:1"
msgid "They're soddin' late.<br>Again."
msgstr "Опять опаздывают.<br>Чёрт бы их побрал."

#. ja: おなかすいた…
#. de: Ich bin am Verhungern ...
#. fr: Qu'est-ce que j'ai faim...
msgctxt "Balloon:2664:0:1"
msgid "I'm bloody starvin'..."
msgstr "Сдохну сейчас с голоду..."

#. ja: 腕がなるね
#. de: Ich brauche ein Paar neue Dolche ...
#. fr: Ouah<nbsp>! J'étais sûrement jongleur dans une vie antérieure.
msgctxt "Balloon:2665:0:1"
msgid "I need me some new stabbers..."
msgstr "Мне бы новые ножи..."

#. ja: 次の仕事は…
#. de: Was ist unser nächster Job?
#. fr: Vivement la prochaine mission<nbsp>!
msgctxt "Balloon:2666:0:1"
msgid "What's our next job?"
msgstr "Какое у нас следующее дело?"

#. ja: おっ、ケンカか！？
#. de: Oh, ich liebe einen guten Kampf!
#. fr: Chouette, une baston<nbsp>!
msgctxt "Balloon:2667:0:1"
msgid "Ooh, I love me a good scrap!"
msgstr "О, обожаю хорошую потасовку!"

#. ja: 何だか知らんが<br>やっちまえ～！
#. de: Keine Ahnung, was hier los ist, aber ich will Blut seh'n!
#. fr: Je veux voir du sang<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2668:0:1"
msgid "I dunno what's goin' on<br>but let's see some blood!"
msgstr "Не знаю, что тут творится,<br>но крови бы посмотреть!"

#. ja: まだ大丈夫ね…
#. de: Wasabi ist noch genug da, wie es scheint.
#. fr: Jusque-là, tout va bien...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2669:0:1"
msgid "Yes, this should<br>last us for a while..."
msgstr "Да, этого нам<br>на какое-то время хватит..."

#. ja: Zzz…Zzz…クェ…
#. de: Zzz ... Zzz ... Kweh ...
#. fr: Zzz... Zzz... Kwééé...
msgctxt "Balloon:2670:0:1"
msgid "Zzz... Zzz... Kwehzzz..."
msgstr "Хр-р... Хр-р... Ку-э-э..."

#. ja: おまえ…愛し…Zzz
#. de: Ich ... liebe ... dich ... Zzz ...
#. fr: Tu m'as... tellement manqué... Zzz...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2671:0:1"
msgid "We'll never...<br>be...apart... Zzz..."
msgstr "Мы никогда...<br>не расстанемся... Хр-р..."

#. ja: カシス・サボテンダーを
#. de: Eine Cassis-Kaktormilch, bitte.
#. fr: Un cassis pampa pour la trois<nbsp>!
msgctxt "Balloon:2672:0:1"
msgid "A glass of our vilest piss."
msgstr "Бокальчик нашего самого отвратного пойла."

#. ja: お待たせいたしました
#. de: Bitte sehr, der Herr.
#. fr: Voici votre commande.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2673:0:1"
msgid "One watered wine and one<br>warm milk. Anything else?"
msgstr "Бокал разбавленного вина и стакан<br>тёплого молока. Что-нибудь ещё?"

#. ja: お決まりでしょうか？
#. de: Was darf ich bringen?
#. fr: Vous avez choisi<nbsp>?
msgctxt "Balloon:2674:0:1"
msgid "Have you decided yet?"
msgstr "Вы уже выбрали?"

#. ja: カシス・サボテンダーです
#. de: Bitte sehr, die Cassis-Kaktormilch.
#. fr: Voilà votre cassis pampa...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2675:0:1"
msgid "Your wine, madam.<br>A Fifth Astral Era vintage."
msgstr "Ваше вино, госпожа.<br>Урожай Пятой астральной эры."

#. ja: …あいよ
#. de: Schon unterwegs!
#. fr: Ça marche<nbsp>!
msgctxt "Balloon:2676:0:1"
msgid "Heh heh. Coming right up."
msgstr "Хе-хе. Сейчас будет."

#. ja: おぉ！　きたきた！
#. de: Na endlich!
#. fr: Ah, voilà les boissons<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2677:0:1"
msgid "Keep the drinks coming!<br>And put it on <i>his</i> tab!"
msgstr "Ещё напитков!<br>И запиши на <i>его</i> счёт!"

#. ja: オススメの飲み物を
#. de: Das Beste, was du hast, Kleine.
#. fr: Donnez-moi votre spécialité<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2678:0:1"
msgid "A glass of your best wine!<br>And make it quick, woman."
msgstr "Бокал лучшего вина!<br>И поживее, женщина."

#. ja: ありがとさん
#. de: Besten Dank!
#. fr: Merci<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2679:0:1"
msgid "Only a Fifth? I suppose it<br>will have to do. Begone now."
msgstr "Всего лишь пятая часть? Ладно,<br>сойдёт. А теперь проваливай."

#. ja: ボールに全てをたくす！
#. de: Du musst eins mit dem Ball werden.
#. fr: Le ballon est mon ami<nbsp>!
msgctxt "Balloon:2680:0:1"
msgid "Three... Two... One..."
msgstr "Три... Два... Один..."

#. ja: ゴールドソーサーへようこそ！
#. de: Willkommen im Gold Saucer!
#. fr: Bienvenue au Gold Saucer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2681:0:1"
msgid "Welcome to the<br>Manderville Gold Saucer!"
msgstr "Добро пожаловать<br>в Золотое блюдце Мандервилей!"

#. ja: 楽しんでいってね！
#. de: Viel Spaß, Schätzchen!
#. fr: Profitez de votre visite pour prendre un peu de bon temps<nbsp>!♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2682:0:1"
msgid "Escape reality,<br>live the fantasy!"
msgstr "Забудь о реальности,<br>живи мечтой!"

#. ja: モーグリキャッチャー行く！
#. de: Los, lass uns zum Mogry-Greifer!
#. fr: J'veux jouer à Attrap'Mog<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2683:0:1"
msgid "But I don't want to<br>work in the silver mines!"
msgstr "Но я не хочу работать<br>в серебряных копях!"

#. ja: 慌てなくても大丈夫さ
#. de: Da war'n wir doch gestern schon!
#. fr: Du calme, on va y aller<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2684:0:1"
msgid "It's only for a few moons.<br>Then my debt will be paid."
msgstr "Да всего-то на пару лун.<br>Потом расплачусь с долгом."

#. ja: 俺たちの女神の勝利だ！
#. de: Triaden-Tina ist unschlagbar!
#. fr: Hourra<nbsp>! Notre championne a gagné<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2685:0:1"
msgid "You going to let her<br>take your money like that?"
msgstr "И позволишь ей вот так<br>забрать твои деньги?"

#. ja: ふむ、筋がいい…
#. de: Erstklassige Wurfhand.
#. fr: Il se débrouille bien...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2686:0:1"
msgid "The stroke... The follow-<br>through... That boy truly<br>knows how to handle a ball..."
msgstr "Замах... Проводка... Этот парень<br>и правда знает толк в мяче..."

#. ja: 今日こそ当ててやる！
#. de: Heute gewinn ich bestimmt.
#. fr: La chance va me sourire aujourd'hui, j'en suis sûr<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2687:0:1"
msgid "Today's my lucky day!<br>Or perhaps tomorrow!"
msgstr "Сегодня мне повезёт!<br>А может, завтра!"

#. ja: 今日は何で遊ぼうか…
#. de: Hm ... Triple Triad? Oder doch lieber Chocobo-Rennen?
#. fr: À quoi vais-je bien pouvoir jouer aujourd'hui<nbsp>?<nbsp>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2688:0:1"
msgid "Pipe down, boy. Can't<br>ye see I'm thinkin'?"
msgstr "Помолчи, парень. Не видишь,<br>я тут думаю?"

#. ja: 困るんですよー
#. de: Das kannst du nicht bringen, Mann!
#. fr: Nous ne pouvons pas tolérer ce genre de com<shy>por<shy>te<shy>ment.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2689:0:1"
msgid "Beggary is frowned upon<br>at our fine establishment."
msgstr "У нас в заведении нищенство<br>не приветствуется."

#. ja: 楽しく遊びましょうよ
#. de: Beim nächsten Mal fliegst du raus!
#. fr: Je suis navré, mais nous allons vous demander de quitter notre éta<shy>blis<shy>se<shy>ment.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2690:0:1"
msgid "I'm afraid we're going to<br>have to ask you to leave."
msgstr "Боюсь, нам придётся<br>попросить вас уйти."

#. ja: ハズレても暴れません…
#. de: Also gut, noch mal verklopp ich den Croupier nicht. Versprochen!
#. fr: Pitié<nbsp>! Je vous promets de plus recommencer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2691:0:1"
msgid "All I need is ten more MGP!<br>You know I'm good for it!"
msgstr "Мне всего десяти тысяч МГП не хватает!<br>Ты же знаешь, я верну!"

#. ja: おっきい像だなぁ！
#. de: Beeindruckend, diese Statue.
#. fr: Cette statue est immense<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2692:0:1"
msgid "Everything in this place is<br>so massive! I wonder if<br>the owner is attempting to<br>compensate for something."
msgstr "Здесь всё такое громадное!<br>Интересно, хозяин чем-то<br>пытается компенсировать?"

#. ja: 次はこのカードだな
#. de: Meine nächste Karte wird dich zerschmettern.
#. fr: Ma prochaine carte va vous écraser<nbsp>!
msgctxt "Balloon:2693:0:1"
msgid "After you, my dear."
msgstr "После вас, дорогая."

#. ja: 切り札を使うときね…
#. de: Hab noch ein Ass im Ärmel, mein Lieber.
#. fr: Hmpf<nbsp>! J'ai <i>toujours</i> un atout dans ma manche.
msgctxt "Balloon:2694:0:1"
msgid "No, after you. I insist."
msgstr "Нет, после вас. Я настаиваю."

#. ja: 油断は禁物ね
#. de: Der kleinste Fehler kann dich alles kosten.
#. fr: Prudence... La moindre erreur peut être fatale dans ce jeu...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2695:0:1"
msgid "Knavery is unnecessary<br>when matching wits with<br>the likes of you."
msgstr "С такими, как ты, и без жульничества можно посостязаться в уме."

#. ja: まだ逆転可能よ…！
#. de: Noch ist nichts entschieden.
#. fr: Je peux encore reprendre le dessus...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2696:0:1"
msgid "Them some right baggin'<br>sleeves you 'ave there."
msgstr "А рукава-то у тебя знатные, широкие!"

#. ja: でも、それは<br>大きなミステイク♪
#. de: Jetzt tu nicht so, als hättest du 'nen Plan gehabt.
#. fr: J'ai encore gagné, on dirait<nbsp>!♪
msgctxt "Balloon:2697:0:1"
msgid "Did I win again?"
msgstr "Опять я выиграла?"

#. ja: 考えていたことの<br>逆が正解だったか…
#. de: Immer kommt es anders, als man denkt!
#. fr: Mince<nbsp>! Je savais que j'aurais dû faire l'inverse<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2698:0:1"
msgid "But... But... You said this<br>was your first time playing!"
msgstr "Но... но ты же сказал, что играешь впервые!"

#. ja: お人形、かわいいな～
#. de: Ich will auch so ein Plüschtier!
#. fr: Ces peluches sont jolies comme tout.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2699:0:1"
msgid "A little more to the left...<br>Now up! No, back! Right!<br>Stop! Stop! Stop!"
msgstr "Чуть левее...<br>А теперь вверх! Нет, назад! Вправо!<br>Стой! Стой! Стой!"

#. ja: 俺の競走羽が勝つために…
#. de: Ein Ishgarder Trainer machte gewiss einen Siegervogel aus meinem Chocobo!
#. fr: Mon chocobo va gagner, je le sens<nbsp>!
msgctxt "Balloon:2700:0:1"
msgid "I'll never best that Teioh!"
msgstr "Мне никогда не обогнать Тэйо!"

#. ja: ねえ、早く行こうよー！
#. de: Jetzt entscheid dich schon endlich!
#. fr: Dis, on y va, dis<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2701:0:1"
msgid "Da! I'm hungry<br>and I miss Ma and Sis!"
msgstr "Да! Я есть хочу<br>и по маме с сестрёнкой скучаю!"

#. ja: あのモーグリ可愛い…
#. de: Der Mogry da vorne ist echt süß.
#. fr: Ce Mog est vraiment adorable<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2702:0:1"
msgid "Can someone─anyone─<br>show me to the privy? I'm<br>like to explode!"
msgstr "Кто-нибудь... хоть кто-нибудь...<br>покажите, где тут уборная! Сейчас лопну!"

#. ja: セニョール・サボテンダー！
#. de: Señor Kaktor!
#. fr: Regardez<nbsp>! Señor Pampa<nbsp>!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2703:0:1"
msgid "Look! It's a senior<br>saber...something!"
msgstr "Смотрите! Старый... сабельник... как его там!"

#. ja: 注目銘柄は青燐水だぞ
#. de: Erdseim soll das nächste große Ding sein!
#. fr: Il n'y en a que pour le céruleum, en ce moment.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2704:0:1"
msgid "Every merchant worth his<br>salt is watchin' ceruleum."
msgstr "Любой купец, который себя уважает,<br>следит за церулеумом."

#. ja: 青燐水特需だってよ！
#. de: Ist es wahr, dass Erdseim in Zukunft knapp wird?
#. fr: Il paraît que ça sera bientôt la course au céruleum<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2705:0:1"
msgid "There's a mad scramble<br>to buy ceruleum!"
msgstr "Все бросились скупать<br>церулеум!"

#. ja: 青燐水、俺も買うかな…
#. de: Vielleicht sollte ich auch etwas Erdseim auf Vorrat kaufen ...
#. fr: Peut-être que je devrais investir dans le céruleum, moi aussi...
msgctxt "Balloon:2706:0:1"
msgid "Ought I invest, I wonder?"
msgstr "Вот думаю, не вложиться ли..."

#. ja: 青燐水で蔵が建つぜ！
#. de: Wer reich werden will, muss jetzt Erdseim kaufen.
#. fr: Grâce au céruleum, je vais être riche<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2707:0:1"
msgid "I'll make my fortune in<br>ceruleum─see if I don't!"
msgstr "На церулеуме-то я разбогатею,<br>вот увидите!"

#. ja: こわいよ…ママ…
#. de: Ich habe Angst ... Mamaaa ...
#. fr: Maman, j'ai peur...
msgctxt "Balloon:2708:0:1"
msgid "\\<sniff> I want my mammy!"
msgstr "\\<всхлип> Хочу к мамочке!"

#. ja: フン…うまくいったな
#. de: Hehe, es läuft alles wie geplant ...
#. fr: Hé hé hé... Tout s'passe comme prévu...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2709:0:1"
msgid "Ugh, noisy bloody brat.<br>Can't be rid of it soon<br>enough..."
msgstr "Тьфу, шумный паршивец.<br>Скорей бы от него избавиться..."

#. ja: こっち見てー！
#. de: Dreh dich noch mal!
#. fr: Regarde-moi, regarde-moi<nbsp>!
msgctxt "Balloon:2710:0:1"
msgid "Over here! Over here!"
msgstr "Сюда! Сюда!"

#. ja: ちょっと一休み…
#. de: Tolle Säule! Ich mag Säulen. Du auch? Dann setz dich zu mir.
#. fr: Cette place est prise.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2711:0:1"
msgid "This seat is taken,<br>if you were wondering."
msgstr "Это место занято,<br>если ты вдруг не заметил."

#. ja: これ登りたいー！
#. de: Darf ich da raufklettern?
#. fr: J'veux monter là-haut<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2712:0:1"
msgid "What exactly were we<br>looking for again, Father?"
msgstr "Пап, а что мы вообще<br>ищем?"

#. ja: 一緒にまわろうよー
#. de: Jetzt komm schon, eine Runde nur.
#. fr: Allez, viens faire le tour avec moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2713:0:1"
msgid "“El Coloso” means<br>“the Coloso.”"
msgstr "«Эль Колоссо» значит<br>«Колоссо»."

#. ja: えー、どうしようかなー
#. de: Ich weiß nicht ...
#. fr: J'hésite...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2714:0:1"
msgid "\\<swoon><br>You know everything!"
msgstr "\\<падает в обморок><br>Ты всё знаешь!"

#. ja: 蜂のように刺す！
#. de: Und ab dafür!
#. fr: À fond la caisse<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2715:0:1"
msgid "Sting like a butterfly,<br>float like a tree!"
msgstr "Жали, как бабочка,<br>порхай, как дерево!"

#. ja: うおぉぉぉ！<br>日ごろの鬱憤をこの一撃に！
#. de: Urlaub erst in sechs Monden? Wie ich meinen Chef hassssssse!
#. fr: Toute ma colère dans ce coup<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2716:0:1"
msgid "Here's what I think<br>of yer twenty-bell<br>shifts, taskmaster!"
msgstr "Вот вам за смены<br>по двадцать часов,<br>надзиратель проклятый!"

#. ja: ミスは許されないわね…！
#. de: Hier ist Finger<shy>spitzen<shy>gefühl gefragt ...
#. fr: Il faut du doigté et de la délicatesse pour gagner à ce jeu.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2717:0:1"
msgid "Stop that yapping or <i>I'll</i><br>show you a moogle's paw!"
msgstr "Хватит болтать, а то <i>я</i><br>покажу тебе лапу могла!"

#. ja: こっちじゃないのか…
#. de: Hm, Fehlanzeige ...
#. fr: C'est pas par là, plutôt<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2718:0:1"
msgid "Don't you think if there<br>was more to life than<br>lugging crates, I'd be doing it!?"
msgstr "Да если б в жизни было что-то получше таскания ящиков, я бы этим и занялся!"

#. ja: 釣れないなぁ…
#. de: Heut beißt einfach nichts an.
#. fr: Ça ne mord vraiment pas, aujourd'hui...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2719:0:1"
msgid "That sabotender told me<br>there was fish in here!"
msgstr "А тот саботендер сказал, что тут рыба водится!"

#. ja: きっついわ、これ…
#. de: Ganz schön anstrengend ...
#. fr: Pfff<nbsp>! C'est dur...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2720:0:1"
msgid "How's about another<br>go at her, eh?"
msgstr "Ну что, ещё разок<br>на неё, а?"

#. ja: 頂上まで、もう少しよ！
#. de: Herrlich, diese Bergluft, nicht wahr?
#. fr: Vous êtes presque au sommet<nbsp>!
msgctxt "Balloon:2721:0:1"
msgid "I can see the top!"
msgstr "Вон вершина!"

#. ja: 可愛いわよねー！
#. de: Zum Abknuddeln, nicht wahr?
#. fr: C'était quoi, cette chose<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2722:0:1"
msgid "What in the seven<br>hells was that thing?"
msgstr "Что это, во имя семи<br>преисподних, было?"

#. ja: さっき握手しちゃった！
#. de: Ich hab ihm gerad die Hand geschüttelt!
#. fr: Un concombre sur pattes, je crois...
msgctxt "Balloon:2723:0:1"
msgid "A cucumber, I think."
msgstr "Похоже на огурец."

#. ja: …うちに持って帰りたい
#. de: Am liebsten nähm ich ihn mit nach Hause!
#. fr: Vous avez vu<nbsp>? Il a essayé de me toucher les fesses<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2724:0:1"
msgid "Did you see him try<br>and touch me bum?"
msgstr "Видел, как он<br>пытался меня за зад ущипнуть?"

#. ja: なんで、インプが…？
#. de: Imps? Die Mandervilles leiden wohl unter Geschmacksverkalkung ...
#. fr: Pourquoi un ballon en forme d'imp géant<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2725:0:1"
msgid "Where am I? I just<br>want to go home..."
msgstr "Где я? Хочу домой..."

#. ja: 何して遊ぼうかー？
#. de: Na, was sollen wir spielen?
#. fr: Tu veux jouer à quoi, Carbuncle<nbsp>?
msgctxt "Balloon:2726:0:1"
msgid "No pets allowed, my arse."
msgstr "А во что играть будем?"

#. ja: はないき、すごかったね
#. de: Wo der Kerl niest, wächst kein Gras mehr!
#. fr: Et après, il a fait son fameux “FUNGAH”<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2727:0:1"
msgid "And then he<br>went...FUNGAH!!!"
msgstr "А потом он такой...<br>ФУНГАХ!!!"

#. ja: …はないき？
#. de: Ist das wahr?
#. fr: Hein<nbsp>? De quoi tu parles<nbsp>!?
msgctxt "Balloon:2728:0:1"
msgid "Fungah!?"
msgstr "Фунгах!?"

#. ja: さすが先生だわ！
#. de: Dem Meister niest so leicht keiner was vor!
#. fr: Fungah<nbsp>?<nbsp>... Qu'est-ce que ça veut dire<nbsp>?
msgctxt "Balloon:2729:0:1"
msgid "What does that even mean?"
msgstr "И что это вообще значит?"

#. ja: 次こそ成功するぞ！
#. de: Jetzt aber mal richtig, Männer!
#. fr: Je ne veux plus voir la moindre erreur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2730:0:1"
msgid "You think you have<br>what it takes to be <i>the</i><br>Lords of the Dance!?"
msgstr "Думаете, вам по силам стать <i>самими</i><br>Владыками танца!?"

#. ja: 違う！もっとこうだ！
#. de: Nein, nein, nicht so ...! So!
#. fr: Mais non<nbsp>! Comme ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2731:0:1"
msgid "You bloody lot move<br>like sotted jellyfish!"
msgstr "Вы двигаетесь, как пьяные медузы!"

#. ja: 全然違う！こうだろう！
#. de: Ich sagte, SO!
#. fr: Vous faites n'importe quoi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2732:0:1"
msgid "No, no!<br>You have it all wrong!"
msgstr "Нет, нет!<br>Всё совсем не так!"

#. ja: 押忍ッ！
#. de: Alles klar!
#. fr: Oui, Chef<nbsp>!
msgctxt "Balloon:2733:0:1"
msgid "Sir! Yes, sir!"
msgstr "Так точно, сэр!"

#. ja: ちっがーう！集中しろ！
#. de: Konzentriert euch gefälligst!
#. fr: Mais non<nbsp>! Concentrez-vous un peu<nbsp>!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2734:0:1"
msgid "Four simple motions. Is<br>that so hard to remember!?"
msgstr "Четыре простых движения. Неужели<br>так трудно их запомнить!?"

#. ja: 愛してるよ、ハニー…
#. de: Ich halt's nicht mehr aus, Baby!
#. fr: Je t'aime, mon amour<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2735:0:1"
msgid "Close your eyes, darling.<br>They cannot see you if<br>you cannot see them."
msgstr "Закрой глаза, дорогая.<br>Если ты их не видишь,<br>они тебя тоже не увидят."

#. ja: ここじゃ恥ずかしいわ…
#. de: So warte doch wenigstens, bis wir auf dem Zimmer sind!
#. fr: Moi aussi, mon cœur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2736:0:1"
msgid "Why is everyone<br>staring at us, Bradford?"
msgstr "Брэдфорд, почему<br>все на нас смотрят?"

#. ja: 次こそ当たる気がする…
#. de: Dieses Mal muss es einfach klappen!
#. fr: Cette fois, c'est la bonne<nbsp>! J'ai joué ma combinaison porte-bonheur.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2737:0:1"
msgid "My lucky numbers?<br>Why, 1234, of course!"
msgstr "Мои счастливые числа?<br>Ну, конечно, 1234!"

#. ja: 星神ニメーヤ様の<br>祝福がありますように…
#. de: Möge Nymeia dir hold sein.
#. fr: Que Nymeia vous accorde sa bénédiction<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2738:0:1"
msgid "A kiss for good luck?<br>That'll be 50 MGP."
msgstr "Поцелуй на удачу?<br>С вас 50 МГП."

#. ja: 俺、2等賞だ！
#. de: Ich hatte drei Richtige!
#. fr: J'ai trois bons numéros<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2739:0:1"
msgid "Rig away! I've won<br>three drawings straight!"
msgstr "Да крути хоть до упаду! Я выиграл<br>в трёх розыгрышах подряд!"

#. ja: お前、何等？
#. de: Und du?
#. fr: Moi, deux<nbsp>!<br>Et toi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2740:0:1"
msgid "I can't win a thing...<br>I'm starting to think<br>the lots are rigged."
msgstr "Ничего не выигрываю...<br>Уже думаю, что жребий подстроен."

#. ja: 僕は針0本だ…
#. de: Fehlanzeige. Mal wieder ...
#. fr: Aucun...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2741:0:1"
msgid "You'd best not let one of<br>the attendants hear you..."
msgstr "Только не вздумай говорить такое<br>при служителях..."

#. ja: 今週の購入者ボーナスは…
#. de: Welcher Teilnahmebonus wohl diese Woche vergeben wird?
#. fr: Vous pouvez pas avancer la date du tirage<nbsp>? J'en peux plus d'attendre.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2742:0:1"
msgid "You mean waiting here<br>won't see the drawing<br>any earlier!?"
msgstr "То есть если я буду тут ждать,<br>розыгрыш раньше не начнётся!?"

#. ja: 先週の当選番号は…
#. de: Welche Nummer wohl diesmal gewinnt?
#. fr: C'est mieux que rien, je suppose...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2743:0:1"
msgid "And by “approximately”<br>you mean “exactly,” right?"
msgstr "А «примерно» — это значит «точно», да?"

#. ja: 最近の傾向として…
#. de: Nun, statistisch gesehen ...
#. fr: Selon mes calculs, vous avez une chance sur dix mille de gagner.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2744:0:1"
msgid "By my calculations, you<br>have approximately a 1 in<br>10,000 chance of winning."
msgstr "По моим расчётам, шанс выиграть<br>у вас примерно один на десять тысяч."

#. ja: うんしょ　こらしょ
#. de: Mit Schwung!
#. fr: Me demande pas ce qu'il y a dans cette caisse, j'en ai pas la moindre idée.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2745:0:1"
msgid "Don't ask me what's<br>in this crate. Just don't."
msgstr "Не спрашивай, что в этом ящике.<br>Даже не спрашивай."

#. ja: 聞いてくれよ…
#. de: Jetzt echt! Acht Arme, und in jedem ein Schwert! Ich schwör's!
#. fr: Non, mais écoutez, je...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2746:0:1"
msgid "That uniform serves only<br>to objectify and is an<br>insult to her inner beauty!"
msgstr "Эта форма только выставляет её напоказ<br>и оскорбляет её внутреннюю красоту!"

#. ja: 飲みすぎですよ？
#. de: Ja, klar ... Und ich bin die Schwester der Sultana.
#. fr: Vous abusez de la boisson<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2747:0:1"
msgid "Any complaints regarding<br>staff attire can be taken<br>up with the management."
msgstr "Все жалобы на форму персонала<br>принимает администрация."

#. ja: お飲み物でございます
#. de: Einmal Tausend Nadeln, der Herr.
#. fr: Voici vos boissons.
msgctxt "Balloon:2748:0:1"
msgid "Anything you need, love?"
msgstr "Чего-нибудь ещё, милый?"

#. ja: ご注文はございますか？
#. de: Darf ich etwas bringen?
#. fr: Monsieur souhaitera boire quelque chose<nbsp>?
msgctxt "Balloon:2749:0:1"
msgid "Top off your glass?"
msgstr "Долить вам?"

#. ja: うむ、ありがとう
#. de: Ah, ausgezeichnet!
#. fr: Ah, merci.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2750:0:1"
msgid "How 'bout a hammer an'<br>nails for to clap shut<br>this windbag's flappin' gob?"
msgstr "Молоток бы да гвозди —<br>прибить этому болтуну<br>его поганый рот!"

#. ja: 今は要らないそうです
#. de: Momentan nicht, danke. Mein Herr wünscht, nicht gestört zu werden.
#. fr: Pas pour le moment, merci.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2751:0:1"
msgid "The young master does<br>not require any further<br>refreshment, thank you."
msgstr "Молодому господину больше<br>ничего не нужно, благодарю."

#. ja: ここの支配人らしいよ…
#. de: Ich hab gehört, er läuft auch draußen so rum!
#. fr: Il paraît que c'est le directeur du Gold Saucer...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2752:0:1"
msgid "Rumor is it's<br>anatomically correct."
msgstr "Говорят, там всё<br>как у настоящего."

#. ja: 金ピカだね…
#. de: Ich sag's ja: Reichtum geht auf den Verstand!
#. fr: Tu as vu la taille de cette statue<nbsp>? En or massif, en plus<nbsp>!
msgctxt "Balloon:2753:0:1"
msgid "That's quite the statue..."
msgstr "Вот это статуя..."

#. ja: 仕上がりはバッチリだ！
#. de: Mein Chocobo ist in Topform!
#. fr: Mon chocobo est prêt à remporter le championnat<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2754:0:1"
msgid "I heard the Saucer's kitchens<br>claim all abandoned chocobos."
msgstr "Слышал, на кухнях Золотого блюдца<br>готовят блюда из брошенных чокобо."

#. ja: まだ早いんじゃない？
#. de: Mit dem Harnisch?! Eher in Topfform!
#. fr: C'est encore un peu tôt, non<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2755:0:1"
msgid "No wonder there are so<br>many chicken dishes!"
msgstr "Неудивительно, что там<br>так много блюд из курятины!"

#. ja: 必要なのは、加速力だ！
#. de: Auf Schnelligkeit kommt es an!
#. fr: Le plus important, c'est l'accélération<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2756:0:1"
msgid "Acceleration is the key<br>to victory, I tell you."
msgstr "Главное — ускорение,<br>говорю вам."

#. ja: 体力も鍛えないと…
#. de: Und Ausdauer, finde ich.
#. fr: Il ne faut pas négliger les capacités physiques.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2757:0:1"
msgid "Only a clever bird will<br>claim the laurels, my boys."
msgstr "Победит только смышлёная птица, парни."

#. ja: 適応力が大事なんだ！
#. de: Ach Quatsch! Köpfchen muss ein Vogel haben!
#. fr: L'agilité est aussi cruciale<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2758:0:1"
msgid "Nimble feet amount to<br>naught without the<br>stamina to drive them!"
msgstr "Резвые ноги ничего не стоят,<br>если не хватает сил их двигать!"

#. ja: 出走時間はまだかな…
#. de: Weißt du, wann es losgeht?
#. fr: Quand est-ce que la course commence<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2759:0:1"
msgid "I wonder if I have time for<br>a swing at Cuff-a-Cur<br>before the next race..."
msgstr "Успею ли я сыграть в «Ударь-Кур»,<br>пока не началась следующая гонка?.."

#. ja: ボコ、いいのか！？
#. de: Bereit für das große Rennen, Horst?
#. fr: Boko, tu es prêt<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2760:0:1"
msgid "It's alright, Boko.<br>The people here will<br>take good care of you."
msgstr "Всё хорошо, Боко.<br>Здесь о тебе позаботятся."

#. ja: いつかレースに出ようね
#. de: Irgendwann machen wir hier auch mal mit, Kwehwi!
#. fr: Toi aussi, un jour, tu participeras aux courses<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2761:0:1"
msgid "Old enough to waddle,<br>old enough to race."
msgstr "Уже можешь ходить вразвалку —<br>значит, пора и в гонку."

#. ja: 来てくれたのか！<br>手分けして助けるぞ！
#. de: Geteiltes Leid ist halbes Leid!
#. fr: Vous voilà<nbsp>! Unissons nos forces et sauvons mes semblables<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2762:0:1"
msgid "Thank the heavens you've<br>come! Now, let us split up<br>and save our friends' tails!"
msgstr "Слава небесам, вы пришли!<br>Разделимся и спасём наших друзей!"

#. ja: 稀少な鉱石を用立てたのは<br>このアタシなのよ？
#. de: <i>Ich</i> war es, die das feinste Erz gewonnen hat!
#. fr: Mais elle est à moi, cette bague<nbsp>! Qu'est-ce qu'elle fait à ton doigt, espèce de voleuse<nbsp>!?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2763:0:1"
msgid "Well, <i>I'm</i> the one<br>who procured the<br>rarest of ores!"
msgstr "Вообще-то, именно <i>я</i><br>добыла редчайшую руду!"

#. ja: あんな子たちなんて、<br>ほっとこうよ…ね？
#. de: Wollen wir die keifernden Weiber nicht sich selbst überlassen, hm?
#. fr: Allez, laisse tomber ces mégèrrres et viens t'amuser avec moi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2764:0:1"
msgid "Why don't we leave<br>these others to their<br>squabbling, hm?"
msgstr "Может, оставим этих<br>переругиваться, а?"

#. ja: 黙った方が<br>身のためにゃ！
#. de: Hüte deine Zunge!
#. fr: La ferrrme, bande de harpies<nbsp>!
msgctxt "Balloon:2765:0:1"
msgid "You'd best watch your tongue!"
msgstr "Лучше бы тебе следить за языком!"

#. ja: 彼は、いつもアタシに<br>叱咤してくれるのよ！
#. de: Er hat beteuert, dass er nur Augen für <i>mich</i> hat!
#. fr: De toute façon, c'est moi qu'il préfère<nbsp>! Mes petites tenues sont irrésistibles...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2766:0:1"
msgid "He said that <i>I</i> was<br>his favorite muse!"
msgstr "Он сказал, что именно <i>я</i><br>его любимая муза!"

#. ja: このドロボウ猫！
#. de: Männerfressende Miqo'te!
#. fr: J'en ai assez de me faire piquer mon petit ami par une Miqo'te<nbsp>!
msgctxt "Balloon:2767:0:1"
msgid "Miqo'te manstealer!"
msgstr "Ми-коте, охотница за мужчинами!"

#. ja: 皇都の様子は！？
#. de: Wie ist es um Ishgard bestellt?
#. fr: Et la cité<nbsp>? Il y a des victimes<nbsp>?
msgctxt "Balloon:2768:0:1"
msgid "What of the city!?"
msgstr "Что с городом!?"

#. ja: 守りは完璧なはずだ！
#. de: Daniffens Kette ist unüberwindbar.
#. fr: Non<nbsp>! Le collier de Daniffen est infranchissable.
msgctxt "Balloon:2769:0:1"
msgid "Its defenses are impenetrable!"
msgstr "Его оборона неприступна!"

#. ja: だが、油断はできんぞ…
#. de: Sicher? Wir reden hier über Drachen!
#. fr: Espérons, car les dragons vont débarquer en force.
msgctxt "Balloon:2770:0:1"
msgid "Nay, we must not be overconfident..."
msgstr "Нет, нельзя терять бдительность..."

#. ja: 兵が動揺している…
#. de: Furcht ergreift die Herzen der Ritter.
#. fr: Les soldats semblent inquiets...
msgctxt "Balloon:2771:0:1"
msgid "The soldiers are unsettled..."
msgstr "Солдаты встревожены..."

#. ja: お前が勇気づけるんだ
#. de: Du musst ihnen Mut einflößen!
#. fr: À toi de trouver les mots pour les rassurer<nbsp>!
msgctxt "Balloon:2772:0:1"
msgid "Then you must settle them!"
msgstr "Тогда успокой их!"

#. ja: 了解であります！
#. de: Zu Befehl!
#. fr: À vos ordres<nbsp>!
msgctxt "Balloon:2773:0:1"
msgid "Understood!"
msgstr "Понял!"

#. ja: みんな、<br>来てくれたのね！
#. de: Danke, dass ihr gekommen seid.
#. fr: Je ne pensais pas que vous viendriez<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2774:0:1"
msgid "You've all come!<br>Thank you..."
msgstr "Вы все пришли!<br>Спасибо..."

#. ja: 仲間の故郷が危ないんだ<br>当然でしょ！
#. de: Klar doch, Freunde lässt man nicht im Stich!
#. fr: On va pas te laisser protéger ta cité natale toute seule, quand même<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2775:0:1"
msgid "How could we not?<br>Your homeland is in peril!"
msgstr "Как же иначе?<br>Твоей родине грозит опасность!"

#. ja: いよいよ決戦だな…
#. de: Endlich, der Augenblick der Entscheidung!
#. fr: Le moment fatidique approche...
msgctxt "Balloon:2776:0:1"
msgid "I should not have left the Toll..."
msgstr "Не стоило мне уходить с заставы..."

#. ja: 援軍はまだなの？
#. de: Wo bleibt die Verstärkung?
#. fr: On est que trois<nbsp>? Mais que font les autres<nbsp>!?
msgctxt "Balloon:2777:0:1"
msgid "Where are our reinforcements?"
msgstr "Где подкрепление?"

#. ja: この先が、<br>皇都イシュガルド…
#. de: Dort liegt die Heilige Stadt Ishgard!
#. fr: Alors c'est ça, la sainte Cité d'Ishgard...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2778:0:1"
msgid "Will we be allowed into<br>the city, I wonder..."
msgstr "Интересно, пустят ли нас<br>в город..."

#. ja: 救援に感謝しますぞ！
#. de: Ein Hoch auf unsere Retter!
#. fr: Vous arrivez juste à temps...
msgctxt "Balloon:2779:0:1"
msgid "Thank the gods you're here!"
msgstr "Слава богам, вы здесь!"

#. ja: ド、ドラゴン族め！
#. de: Elende Drachenbrut!
#. fr: M-maudits dragons<nbsp>!
msgctxt "Balloon:2780:0:1"
msgid "D-Damn dragons!"
msgstr "П-проклятые драконы!"

#. ja: イシュガルド防衛に<br>力を貸してくれ！
#. de: Hilf uns, Ishgard zu verteidigen!
#. fr: Nos frères d'Ishgard ont besoin de nous<nbsp>!
msgctxt "Balloon:2781:0:1"
msgid "Lend your blade to Ishgard!"
msgstr "Сразись за Ишгард!"

#. ja: ともに戦いましょう！<br>エオルゼアのために！
#. de: Lass uns gemeinsam kämpfen,<br>für Eorzea!
#. fr: Tous ensemble, luttons pour Éorzéa<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2782:0:1"
msgid "We fight as one!<br>For all Eorzeans!"
msgstr "Сражаемся единым строем!<br>За всех жителей Эорзеи!"

#. ja: お父さん、これ登れる？
#. de: Kannst du da hochklettern, Papa?
#. fr: Papa, tu peux grimper en haut<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2783:0:1"
msgid "Why do they call it a<br>square if the hall's round?"
msgstr "Почему зал называется «Круглым»,<br>если он квадратный?"

#. ja: か、軽いもんさ…
#. de: K-Klar doch ...!
#. fr: M-mais bien sûr<nbsp>! Facile<nbsp>!
msgctxt "Balloon:2784:0:1"
msgid "Ask your mother, boys."
msgstr "Спросите у мамы, ребятки."

#. ja: つ、ついに当たったー！
#. de: Endlich was gewonnen! Hurra!
#. fr: J'ai enfin gagné<nbsp>!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2785:0:1"
msgid "Cactpot!<br>I'm rich! I'm rich!"
msgstr "Кактпот!<br>Я богач! Богач!"

#. ja: た、助かったわ…
#. de: D-Danke! Das war Rettung in letzter Sekunde!
#. fr: M-merci, <split " " 1><string $gs1></split>...
msgctxt "Balloon:2786:0:1"
msgid "My thanks..."
msgstr "Благодарю..."

#. ja: ジャボテンダーよー！
#. de: Ich will zum Coloso!
#. fr: J'veux voir Coloso de plus près<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2787:0:1"
msgid "I wouldn't have got caught<br>if you'd stayed hidden!"
msgstr "Не поймали бы меня,<br>если бы ты не прятался!"

#. ja: マウント・コレルがいーい！
#. de: Und ich zum Mount Corel!
#. fr: Non<nbsp>! Moi, j'veux aller au Mont Corel<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2788:0:1"
msgid "I would've stayed hidden if<br>you hadn't kept looking at me!"
msgstr "А я бы спрятался,<br>если бы ты не пялился на меня!"

#. ja: …お前ら本当、仲いいな
#. de: Ein Herz und eine Seele, wie immer ... \<seufz>
#. fr: Je vois que vous vous entendez bien...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2789:0:1"
msgid "We'll never win the Durai<br>Memorial if you two don't<br>learn to work together."
msgstr "Нам не выиграть Мемориал Дюрея,<br>пока вы двое не научитесь работать вместе."

#. ja: 今日も始めますかな！
#. de: Warum nicht hier?
#. fr: Ça me paraît pas mal, ici<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2790:0:1"
msgid "I suppose this spot<br>is as good as any!"
msgstr "Пожалуй, место ничуть не хуже других!"

#. ja: ふふ、素敵なところね<br>つい来たくなるわ
#. de: Tolle Aussicht! Am liebsten käme ich jeden Tag her.
#. fr: Quelle vue splendide<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2791:0:1"
msgid "What a wonderful view of...<br>whatever those things are."
msgstr "Какой чудесный вид на...<br>что бы это ни было."

#. ja: いいカフェテラスだね
#. de: Wollte mal sehen, was die Konkurrenz so macht. Nette Aussicht, aber die gute Waldluft fehlt.
#. fr: Mes clients avaient raison... La concurrence s'annonce rude.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2792:0:1"
msgid "My patrons cannot stop<br>talking of Rowena's new<br>terrace, so I came to see<br>what all the fuss is about."
msgstr "Посетители только и говорят о новой террасе Ровены. Вот и пришёл взглянуть, из-за чего весь шум."

#. ja: なるほど…<br>あんな料理を出すとは…
#. de: Hmpf. Ich warte mit meinem Urteil, bis ich das Zeug runtergespült habe.
#. fr: Voyons un peu ce que vaut cette bière<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2793:0:1"
msgid "Hmph. I'll reserve<br>me judgment till I've<br>swallowed the grog."
msgstr "Хм. С выводами повременю,<br>пока не проглочу эту бурду."

#. ja: 金をせびりに来たんだが…<br>やはりダメだったか
#. de: Ob ich meine Schulden hier absaufen kann?
#. fr: Bon, c'est pas ici que j'vais m'faire des gils, moi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2794:0:1"
msgid "Looks as if ol' Rowena's<br>more'n a few gil to spare."
msgstr "Похоже, у старой Ровены<br>гиляков-то хоть отбавляй."

#. ja: そろそろ帰りますかな！
#. de: Dieses Lokal ist einem Manderville wahrlich würdig.
#. fr: Cet éta<shy>blis<shy>se<shy>ment est digne d'un Manderville, foi de... Manderville<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2795:0:1"
msgid "I deem this establishment<br>fit for a Manderville man!"
msgstr "Считаю, заведение это<br>вполне достойно Мандервиля!"

#. ja: 楽しかったわ<br>うちも見習わなくちゃ！
#. de: Vielleicht sollten wir in Ul'dah einen Steingarten anlegen?
#. fr: Notre guilde devrait en prendre de la graine<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2796:0:1"
msgid "I'll have to see about<br>having some of those<br>sent to the guild."
msgstr "Надо бы узнать,<br>можно ли заказать<br>такое для гильдии."

#. ja: 気分転換もできたことだし<br>仕事に戻るとしよう
#. de: Genug gefaulenzt. Auf mich warten frische Abenteurer.
#. fr: C'est pas tout, mais j'ai du travail...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2797:0:1"
msgid "A decent terrace, <i>if</i> you<br>enjoy these sort of things."
msgstr "Терраса вполне приличная, <i>если</i><br>вам такое по душе."

#. ja: よし！<br>うちでもやってみるか！
#. de: Wie der Grog war? So gut, dass ich mich nicht dran erinnern kann.
#. fr: Hips<nbsp>!<nbsp>... Un chef-d'œuvre, cette bière<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2798:0:1"
msgid "'Ow was the bloody grog?<br>So good, I cannot recall!"
msgstr "Как вам этот проклятый грог?<br>Так хорош, что я уже не помню!"

#. ja: 粘ってもダメだろうな<br>帰って酒でも飲むか…
#. de: Ob du's glaubst oder nicht, aber irgendwie komm ich hier einfach nicht in Trinklaune.
#. fr: Pas mal, mais j'préfère me soûler chez moi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2799:0:1"
msgid "No love for poor<br>Gerolt here, I reckon."
msgstr "Похоже, бедолаге Герольту<br>тут не светит."

#. ja: あなたの言ったとおり、<br>ひと儲けできたわ！
#. de: Dein Tipp war Gold wert, Schätzchen!
#. fr: Votre conseil valait son pesant d'or, ma chère<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2800:0:1"
msgid "Your advice was worth<br>its weight in gold, milady!"
msgstr "Ваш совет оказался<br>на вес золота, миледи!"

#. ja: どうですロウェナさん<br>うちの商品の売れ行きは？
#. de: Und? Wie läuft das Geschäft mit der Garlond-Kollektion?
#. fr: Comment vont les affaires<nbsp>? Les articles des Forges se vendent bien<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2801:0:1"
msgid "How fare the sales<br>of Ironworks goods?"
msgstr "Как идут продажи<br>товаров «Гарлонд»?"

#. ja: なるほど…<br>あの装備はそうやって…
#. de: Aber was werden die Leute sagen, wenn sie erfahren, dass es eigentlich <i>daraus</i> besteht?!
#. fr: Pense à la réaction des clients quand ils sauront d'où ça provient<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2802:0:1"
msgid "But think of what people<br>will say when they learn<br>that's where it's from!"
msgstr "Только подумайте, что скажут люди,<br>когда узнают,<br>откуда это взялось!"

#. ja: みんな…何を見てるの…
#. de: Wo schauen die bloß alle hin?
#. fr: Qu'est-ce qu'ils peuvent bien regarder, comme ça<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2803:0:1"
msgid "I can see clearly now,<br>the rain is gone!"
msgstr "Теперь я вижу ясно,<br>дождь прошёл!"

#. ja: おいしくな～れ♪
#. de: Niedrigere Tische wären nett gewesen.
#. fr: Faire une bonne crème fouettée demande de l'en<shy>traî<shy>ne<shy>ment.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2804:0:1"
msgid "Lower tables<br>would've been nice..."
msgstr "Столы бы пониже<br>сделали..."

#. ja: こちらはカフェテラスです。<br>シェフ自慢の料理はいかが？
#. de: Rowena legt Wert auf gutes Benehmen. Und ich auf ein gutes Trinkgeld.
#. fr: <if ($gn11 < 12)><if ($gn11 < 4)>Bonsoir<else>Bonjour</if><else><if ($gn11 < 17)>Bonjour<else>Bonsoir</if></if>, <if $gn4>Madame<else>Monsieur</if>. Soyez l<if $gn4>a<else>e</if> bienvenu<if $gn4>e</if> à notre café-terrasse.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2805:0:1"
msgid "Lady Rowena will not<br>suffer riffraff in her<br>new establishment."
msgstr "Леди Ровена не потерпит<br>в своём новом заведении<br>всякое отребье."

#. ja: 運ぶ場所、まちがえた…
#. de: Mist, zum falschen Ort gelaufen.
#. fr: On s'est trompés...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2806:0:1"
msgid "If you have to ask, you're<br>not supposed to know."
msgstr "Кто спрашивает — тому знать не положено."

#. ja: ただいま、大会を開催中です！
#. de: Wir veranstalten gerade ein Turnier.
#. fr: Un tournoi est en cours<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2807:0:1"
msgid "Come one, come all! The<br>glory of the tourney awaits!"
msgstr "Собирайтесь, народ!<br>Слава ждёт участников турнира!"

#. ja: この辺でいいかな
#. de: Ob hier in Ordnung ist?
#. fr: C'est là, non<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2808:0:1"
msgid "Lord Manderville pays<br>me to carry crates,<br>so I carry crates."
msgstr "Лорд Мандервиль платит<br>мне за перенос ящиков,<br>вот я и переношу ящики."

#. ja: 僕宛の贈物はあるかな？
#. de: Hast du kein Paket für mich?
#. fr: Un cadeau<nbsp>? Pour moi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2809:0:1"
msgid "Is there a letter in<br>your bag for me?"
msgstr "У тебя в сумке<br>для меня письма нет?"

#. ja: だ、大事な話があるんだ！
#. de: I-Ich habe dir etwas Wichtiges zu sagen!
#. fr: Je... J'ai quelque chose d'important à te dire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2810:0:1"
msgid "I-I have something I<br>must needs ask you!"
msgstr "М-мне нужно кое о чём<br>тебя спросить!"

#. ja: う、うん、何の話かな？
#. de: Etwas Wi-Wichtiges? Was denn?
#. fr: Hmm<nbsp>? De quoi s'agit-il<nbsp>?
msgctxt "Balloon:2811:0:1"
msgid "I-I do! I mean...what?"
msgstr "Н-нужно! То есть... о чём?"

#. ja: こんなに幸せでいいのかな
#. de: Womit habe ich so viel Glück verdient?
#. fr: Quel bonheur, mes aïeux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2812:0:1"
msgid "Is it wrong of us to know<br>such happiness?"
msgstr "Разве можно быть<br>настолько счастливыми?"

#. ja: いいのよ、幸せで
#. de: Du verdienst alles Glück der Welt ...
#. fr: Tu mérites tout le bonheur du monde...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2813:0:1"
msgid "Happiness can never be<br>wrong, my love."
msgstr "Счастье не бывает<br>плохим, любимый."

#. ja: 今回こそあの人に…
#. de: Heute ist <i>die</i> Gelegenheit, es ihm zu sagen ...
#. fr: Aujourd'hui, c'est le grand jour<nbsp>!
msgctxt "Balloon:2814:0:1"
msgid "This time, he will be mine..."
msgstr "На этот раз он будет моим..."

#. ja: あの…その、す、す…
#. de: A-Also ... i-ich ...
#. fr: Euh... C'est-à-dire que... Je...
msgctxt "Balloon:2815:0:1"
msgid "I-I-I... I l-l-l-l-l-lov─"
msgstr "Я... я... л-л-л-люб..."

#. ja: 焦らなくていいぜ、な？
#. de: Lass dir ruhig Zeit.
#. fr: Du calme, du calme<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2816:0:1"
msgid "Calm down, calm down!<br>Take a deep breath<br>and start again."
msgstr "Тише, тише!<br>Глубоко вдохни<br>и начни заново."

#. ja: 贈物、なにがいい？
#. de: Was wünschst du dir zum Valentiontag?
#. fr: Qu'est-ce qui te ferait plaisir pour la Valention<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2817:0:1"
msgid "What do you want for<br>Valentione's Day?"
msgstr "Что ты хочешь<br>на День влюблённых?"

#. ja: えっと…キ、キミ…
#. de: D-Deine Liebe ...
#. fr: Rien d'autre que toi, voyons...
msgctxt "Balloon:2818:0:1"
msgid "Just you, my darling."
msgstr "Только тебя, любимая."

#. ja: 何も届いてない…
#. de: Schon wieder nichts für mich dabei! Ah ...
#. fr: Toujours rien pour moi<nbsp>? Pfff...
msgctxt "Balloon:2819:0:1"
msgid "Why does she not write!?"
msgstr "Почему она не пишет?!"

#. ja: チョコレート貰ったか？
#. de: Hast du Schokolade gekauft?
#. fr: T'as pensé aux chocolats<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2820:0:1"
msgid "So, did you get anything<br>for Valentione's Day?"
msgstr "Ну что, получил что-нибудь<br>на День влюблённых?"

#. ja: 何も貰ってないんだ…
#. de: Ich habe gar nichts gekauft ...
#. fr: Ceux que j'ai mangés tout à l'heure<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2821:0:1"
msgid "No card, no chocolate.<br>Nothing..."
msgstr "Ни открытки, ни шоколадки.<br>Ничего..."

#. ja: さっさと告白しなさいよ！
#. de: Gesteh ihm endlich deine Liebe!
#. fr: Bon, ça vient, cette déclaration<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2822:0:1"
msgid "Just go over and give it<br>to him, you daft sod!"
msgstr "Да подойди ты к нему и отдай уже,<br>дурья твоя башка!"

#. ja: 待って、心の準備が…
#. de: Aber ich bin noch nicht so weit!
#. fr: Euh... T-tu es le s-soleil de m-mes nuits...
msgctxt "Balloon:2823:0:1"
msgid "I can't! I'm not ready! "
msgstr "Не могу! Я ещё не готова!"

#. ja: カフェテラスでスクワット！<br>筋肉が喜びますな！
#. de: Geht doch nichts über ein paar Kniebeugen an der frischen Luft!
#. fr: Et un, et deux, et trois, et quatre<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2824:0:1"
msgid "A true man is <i>defined</i><br>by his muscle... Bwahahaha!"
msgstr "Настоящего мужчину определяют<br><i>мышцы</i>... Бу-ха-ха-ха!"

#. ja: 今日もいいキレでしたな！
#. de: Damit bin ich für den nächsten Sprint gerüstet!
#. fr: Aïe... J'ai beau être matinal, j'ai mal...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2825:0:1"
msgid "See how the oil glistens in<br>the light of the crystals?"
msgstr "Видите, как масло блестит<br>в свете кристаллов?"

#. ja: こっちに来るわよ！
#. de: Seht doch, er kommt zu uns!
#. fr: Il vient par ici<nbsp>!
msgctxt "Balloon:2826:0:1"
msgid "Our eyes met!"
msgstr "Он идёт сюда!"

#. ja: なんてキュートなの…！
#. de: Entzückend!
#. fr: Qu'est-ce qu'il est chou<nbsp>!
msgctxt "Balloon:2827:0:1"
msgid "Ouch! What was that!?"
msgstr "Ай! Это ещё что было?!"

#. ja: ヘヘッ…追いつめたぜ！
#. de: Hehe, jetzt bist du dran!
#. fr: Ha ha ha, il est pris au piège<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2828:0:1"
msgid "Nowhere to run now, Spriggy!<br>Nowhere to hide!"
msgstr "Теперь не убежишь, Спригги!<br>И не спрячешься!"

#. ja: 逃がさねえぞ！
#. de: Du entkommst uns nicht!
#. fr: Pas question de le laisser filer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2829:0:1"
msgid "You ain't getting away<br>from us this time!"
msgstr "В этот раз от нас<br>не уйдёшь!"

#. ja: 観念しな！
#. de: Besser, du ergibst dich!
#. fr: Tu ferais mieux de te rendre.
msgctxt "Balloon:2830:0:1"
msgid "Bags I a leg!"
msgstr "Забираю себе ногу!"

#. ja: オッキナ、タマギ！<br>オッキナ、タカラ！
#. de: Groooßes Eiii! Groooßer Schatz!
#. fr: Gros œufs, gros trésors<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2831:0:1"
msgid "Big, big eggiiies!<br>Lucky, lucky treasuuure!!!"
msgstr "Большие-большие яяйца!<br>Счастье-счастье, сокрооовища!!!"

#. ja: ぬぅ、侵入者どもめ…
#. de: Wer wagt es?!
#. fr: Cette sale bande d'envahisseurs...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2832:0:1"
msgid "Why would these fiends<br>trespass against us?"
msgstr "Что этим мерзавцам<br>понадобилось на нашей земле?"

#. ja: 食事にも手は抜けんな
#. de: Auch Kochen will gelernt sein!
#. fr: Nos repas doivent être irréprochables.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2833:0:1"
msgid "Where have all the<br>rolanberry cheesecakes gone?♪"
msgstr "Куда подевались все<br>пироги с роланберри и сыром?♪"

#. ja: 皆様の笑顔が、私の幸せ…
#. de: Ein Lächeln ist für mich der größte Lohn.
#. fr: Voir notre clientèle satisfaite, c'est ma raison d'être<nbsp>!
msgctxt "Balloon:2834:0:1"
msgid "Mayhap I'm just too demanding...♪"
msgstr "Может, я просто слишком требователен...♪"

#. ja: ステージの様子は…
#. de: Wie sieht's auf der Bühne aus?
#. fr: Allons jeter un œil aux animations sur scène...
msgctxt "Balloon:2835:0:1"
msgid "Dream, if you will, a stage...♪"
msgstr "Представь себе сцену...♪"

#. ja: 今日も輝いていたな！
#. de: Auch diese Show hatte es mal wieder in sich.
#. fr: C'était époustouflant<nbsp>!
msgctxt "Balloon:2836:0:1"
msgid "I am something you'll never understand...♪"
msgstr "Я — то, чего тебе никогда не понять...♪"

#. ja: 熱闘を見届けるとするか
#. de: Dann will ich den Leuten mal 'nen guten Kampf liefern.
#. fr: Et si j'allais voir quelques duels...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2837:0:1"
msgid "A body like yours<br>ought to be in gaol...♪"
msgstr "С таким телом тебе бы<br>в тюрьме место...♪"

#. ja: 熱気にあてられたな…
#. de: So war das nicht geplant ...
#. fr: Palpitant<nbsp>! Mon cœur bat à cent à l'heure, maintenant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2838:0:1"
msgid "Feel the heat<br>between me and you...♪"
msgstr "Чувствуешь жар<br>между нами?..♪"

#. ja: レースは盛況だろうか…
#. de: Wie es wohl ist, bei so einem Rennen mitzumachen?
#. fr: Allons voir si la course bat son plein...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2839:0:1"
msgid "This is what it sounds like<br>when chocobos kweh...♪"
msgstr "Вот как звучит<br>«квээ» чокобо...♪"

#. ja: チョコボは美しい…
#. de: Renn-Chocobos sind prächtige Tiere.
#. fr: Les chocobos sont décidément des créatures majestueuses.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2840:0:1"
msgid "Have you ever seen<br>such a beautiful animal?"
msgstr "Видели вы когда-нибудь<br>животное прекраснее?"

#. ja: 爆弾　バクハツ　邪魔するぞ～
#. de: Macht Vielebumm. Muzzu gucken!
#. fr: Boum<nbsp>! Prenez un gros boum<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2841:0:1"
msgid "Crash and boom<br>and bangy doom.♪<br>Tastybird, we eat<br>you soon.♪"
msgstr "Бах и бум,<br>грохот да дым.♪<br>Вкусный птенчик,<br>скоро съедим.♪"

#. ja: 爆弾　ドッカン　邪魔するぞ～
#. de: Großewumms. Pazzu auf!
#. fr: Boum<nbsp>! Boum<nbsp>! Ça va chauffer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2842:0:1"
msgid "Boom and crash<br>and doomy dash.♪<br>Tastyegg we<br>crack and smash.♪"
msgstr "Бум и бах,<br>всё в прах.♪<br>Вкусное яичко<br>разобьём — и ах!♪"

#. ja: 油断するな…<br>まだ近くにいるぞ…
#. de: Vorsicht! Er ist ganz in der Nähe!
#. fr: Reste sur tes gardes<nbsp>! Il est encore tout près...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2843:0:1"
msgid "Be on your guard.<br>He is yet close..."
msgstr "Будь начеку.<br>Он всё ещё близко..."

#. ja: フウウ、この一服のために生きてるぜ。
#. de: フウウ、この一服のために生きてるぜ。
#. fr: フウウ、この一服のために生きてるぜ。
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2844:0:1"
msgid "There's naught like a long<br>drag on the pipe here to<br>calm a man's nerves after<br>a day fittin' blast caps."
msgstr "Нет ничего лучше затяжки<br>из трубки, чтоб успокоить нервы<br>после целого дня за установкой<br>взрывных капсюлей."

#. ja: 未成年のくせに、止めろっても聞きやしねえ。
#. de: 未成年のくせに、止めろっても聞きやしねえ。
#. fr: 未成年のくせに、止めろっても聞きやしねえ。
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2845:0:1"
msgid "Man!? You've not seen a<br>day past ten summers!<br>Now pass the bloody briar<br>afore I whack you one good."
msgstr "Мужчина?! Тебе и десяти лет-то<br>ещё нет! А ну, подай трубку,<br>чёрт бы тебя побрал,<br>пока я тебя не отходил!"

#. ja: げええ。
#. de: げええ。
#. fr: げええ。
msgctxt "Balloon:2846:0:1"
msgid "\\<belch>"
msgstr "\\<отрыжка>"

#. ja: 寒いよりよかろ、あったまるから飲めや。
#. de: 寒いよりよかろ、あったまるから飲めや。
#. fr: 寒いよりよかろ、あったまるから飲めや。
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2847:0:1"
msgid "Gahahaha! Somebody bring<br>this boy another round!<br>His first be runnin' down<br>his britches!"
msgstr "Га-ха-ха! Налейте парню ещё!<br>Первая кружка у него<br>уже по штанам стекает!"

#. ja: オイオイ、未成年に酒飲ませちゃだめだろ。
#. de: オイオイ、未成年に酒飲ませちゃだめだろ。
#. fr: オイオイ、未成年に酒飲ませちゃだめだろ。
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2848:0:1"
msgid "Thal's balls, man!<br>Stop wastin' good ale<br>on a whelp what'll just<br>disgorge 'er gutterwise!"
msgstr "Клянусь яйцами Тала!<br>Хватит переводить хорошее пиво<br>на сопляка, который только<br>и умеет, что блевать на пол!"

#. ja: あそこに闇の賭博場があるらしいぜ。
#. de: あそこに闇の賭博場があるらしいぜ。
#. fr: あそこに闇の賭博場があるらしいぜ。
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2849:0:1"
msgid "Even the mutton down in<br>Stone's Throw'll cost ye.<br>Might be a toss o' the<br>bones'd line yer linty purse."
msgstr "Даже за баранину<br>в Каменном Уступе содрут деньги.<br>Может, костями покидаешь —<br>вдруг кошелёк пополнится?"

#. ja: おいおい、やばいんじゃないか。
#. de: おいおい、やばいんじゃないか。
#. fr: おいおい、やばいんじゃないか。
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2850:0:1"
msgid "Are you suggesting I<br>use ill-gotten coin to<br>purchase the services of<br>a local courtesan? PAH, I say!"
msgstr "Ты предлагаешь мне купить<br>услуги местной куртизанки<br>на краденые деньги? Да ни за что!"

#. ja: イイぞ、友よ！
#. de: Kämpft, meine Freunde! Kämpft!
#. fr: Montrez-leur de quoi vous êtes capables<nbsp>!
msgctxt "Balloon:2851:0:1"
msgid "Fight, my friends! Fight!"
msgstr "Сражайтесь, друзья! Сражайтесь!"

#. ja: 戦神ハルオーネよ…
#. de: Oh Halone ...
#. fr: Ô Halone...
msgctxt "Balloon:2852:0:1"
msgid "O Halone..."
msgstr "О, Халон..."

#. ja: 殺れェッ！
#. de: Tötet sie! Tötet sie!
#. fr: Achevez-les<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2853:0:1"
msgid "Finish them!<br>Finish them!"
msgstr "Добейте их!<br>Добейте их!"

#. ja: 異端者どもめ！
#. de: Verdammte Ketzer!
#. fr: Sales hérétiques<nbsp>!
msgctxt "Balloon:2854:0:1"
msgid "Heathen scum!"
msgstr "Поганые язычники!"

#. ja: グリノー様～！
#. de: Herr!
#. fr: Vous êtes le meilleur, Sire Grinnaux<nbsp>!
msgctxt "Balloon:2855:0:1"
msgid "Ser Grinnaux!"
msgstr "Сэр Гринно!"

#. ja: いけ、そこだ！
#. de: Los, schnappt sie!
#. fr: Punissez-les<nbsp>!
msgctxt "Balloon:2856:0:1"
msgid "Get them!"
msgstr "Взять их!"

#. ja: ご無事でしたか！<br>どうぞ、こちらへ！
#. de: Hier entlang!
#. fr: Par ici, vite<nbsp>!
msgctxt "Balloon:2857:0:1"
msgid "This way, quickly!"
msgstr "Сюда, скорее!"

#. ja: わあ、おめでとうございます！
#. de: Gratulation!
#. fr: Fé<shy>li<shy>ci<shy>ta<shy>tions！
msgctxt "Balloon:2858:0:1"
msgid "Well done!"
msgstr "Молодцы!"

#. ja: 第一の試練、突破ですね！
#. de: Wirklich beeindruckend!
#. fr: Quelle belle dé<shy>mon<shy>stra<shy>tion de force<nbsp>!
msgctxt "Balloon:2859:0:1"
msgid "An impressive performance!"
msgstr "Впечатляющее выступление!"

#. ja: 体がなまっちまうぜ…
#. de: Ein zu schwerer Kopfschutz, und meine ganze Leichtfüßigkeit ist dahin ...
#. fr: Je vais rouiller à force de rester ici...
msgctxt "Balloon:2860:0:1"
msgid "Sway like a cobra, strike like a viper..."
msgstr "Извивайся, как кобра, бей, как гадюка..."

#. ja: どう、キマってるでしょ？
#. de: Na? Das hat doch was, oder?
#. fr: L'élégance est mon credo.
msgctxt "Balloon:2861:0:1"
msgid "I must always look my best!"
msgstr "Я всегда должен выглядеть безупречно!"

#. ja: 早く試したいぜ！
#. de: Ein zu schwerer Kopfschutz, und meine ganze Leichtfüßigkeit ist dahin ...
#. fr: J'ai hâte d'essayer mon masque<nbsp>!
msgctxt "Balloon:2862:0:1"
msgid "I feel extra fierce in this mask!"
msgstr "В этой маске я чувствую себя грознее!"

#. ja: それにしてもいい鎧ね♪
#. de: Na? Das hat doch was, oder?
#. fr: C'est vraiment une belle armure<nbsp>!
msgctxt "Balloon:2863:0:1"
msgid "I need some matching earrings..."
msgstr "Надо бы серьги к этим доспехам..."

#. ja: ひどい目にあった…
#. de: Wir haben ganz schön was abbekommen ...
#. fr: On a eu chaud...
msgctxt "Balloon:2864:0:1"
msgid "Hells, that thing was fast..."
msgstr "Чёрт, да эта тварь была быстра..."

#. ja: ダサい目にあったわ…
#. de: Das tat richtig in den Augen weh ...
#. fr: Cette défaite est trop embarrassante...
msgctxt "Balloon:2865:0:1"
msgid "I hope nobody saw us..."
msgstr "Надеюсь, нас никто не видел..."

#. ja: …死ぬかと思った
#. de: Ich dachte, mein letztes Stündlein hätte geschlagen ...
#. fr: J'ai cru qu'on allait y rester...
msgctxt "Balloon:2866:0:1"
msgid "I thought we were done for..."
msgstr "Я думал, нам конец..."

#. ja: 次こそ！
#. de: Ein zu schwerer Kopfschutz, und meine ganze Leichtfüßigkeit ist dahin ...
#. fr: La prochaine sera la bonne<nbsp>!
msgctxt "Balloon:2867:0:1"
msgid "We'll beat it this time!"
msgstr "В этот раз мы её одолеем!"

#. ja: 今度はキメるわ！
#. de: Na? Das hat doch was, oder?
#. fr: En tout cas, mon armure est la plus élégante.
msgctxt "Balloon:2868:0:1"
msgid "Onwards to victory...with style!"
msgstr "Вперёд, к победе... и со стилем!"

#. ja: ああ…ハルオーネちゃん
#. de: Ah ... Meine geliebte Halone ...
#. fr: Que Halone nous protège...
msgctxt "Balloon:2869:0:1"
msgid "Ah, my beloved Halone..."
msgstr "Ах, любимая моя Халон..."

#. ja: 立ち去れ、立ち去れ！<br>ここはバヌバヌの土地ぞ！
#. de: Fort! Hier leben Vanu!
#. fr: Hors d'ici, gens d'en bas<nbsp>! Ces terres appartiennent aux Vundu<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2870:0:1"
msgid "Begone, netherlings!<br>These are Vundu lands!"
msgstr "Прочь, нижеземцы!<br>Это земли Вунду!"

#. ja: くそ、奴ら強い！
#. de: Sie sind zu stark ...
#. fr: Bon sang, ils sont coriaces<nbsp>!
msgctxt "Balloon:2871:0:1"
msgid "Bastards..."
msgstr "Ублюдки..."

#. ja: もう少しなのに…
#. de: Wir hätten es fast geschafft ...
#. fr: Presque<nbsp>!
msgctxt "Balloon:2872:0:1"
msgid "If only..."
msgstr "Если бы только..."

#. ja: ゼェゼェ…
#. de: \<keuch>...
#. fr: Prenez ça<nbsp>!
msgctxt "Balloon:2873:0:1"
msgid "Dammit..."
msgstr "Чёрт..."

#. ja: 「暁」には未来がある…<br>そう思っているのさ
#. de: Der Bund hat eine Zukunft, da bin ich felsenfest von überzeugt!
#. fr: La flamme qui animait ceux qui ont tout quitté pour suivre les Héritiers n'est pas éteinte.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2874:0:1"
msgid "I worry not, for with every<br>dawn comes a new day."
msgstr "Не тревожусь я: с каждым<br>рассветом приходит новый день."

#. ja: 防衛戦で一緒に戦った<br>戦友なんだしね！
#. de: Seite an Seite! Wie bei der Verteidigung Ishgards!
#. fr: C'est vrai que sans leur aide, Ishgard serait réduite en cendres à l'heure qu'il est...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2875:0:1"
msgid "I recall you from the<br>battle on the Steps!"
msgstr "Я помню тебя по битве<br>на Ступенях!"

#. ja: 故郷を救ってくれた<br>恩を返したいのよ
#. de: Der Bund hat meine Heimat gerettet. Dafür möchte ich mich revanchieren.
#. fr: Les Héritiers ont sauvé notre pays. C'est à notre tour de les aider<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2876:0:1"
msgid "Your bravery shall<br>not soon be forgotten."
msgstr "Твою отвагу мы<br>не забудем."

#. ja: フ・ラミンさんが<br>帰ってくるまでは…ね
#. de: Ich habe mich bereiterklärt, hier auszuhelfen, aber nur bis F'lhaminn wieder da ist.
#. fr: Je remplace F'lhaminn en attendant qu'elle revienne.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2877:0:1"
msgid "This is only until<br>F'lhaminn returns."
msgstr "Я здесь лишь до тех пор,<br>пока не вернётся Ф'ламин."

#. ja: 大丈夫ですか！？<br>これ以上の力は危険だ！
#. de: Nicht zu viel! Du kannst es nicht kontrollieren!
#. fr: Tu ne dois pas en abuser<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2878:0:1"
msgid "You fool! I warned you<br>not to drink too deep!"
msgstr "Глупец! Я же предупреждал,<br>что нельзя пить так много!"

#. ja: グゴゴゴゴ…
#. de: Gugraaahr!
#. fr: GrraAahrr<nbsp>!
msgctxt "Balloon:2879:0:1"
msgid "\\<rumble> \\<rumble>"
msgstr "\\<грохот> \\<грохот>"

#. ja: グオォォォン！
#. de: Groooaaah!
#. fr: GroOOaaAhr<nbsp>!
msgctxt "Balloon:2880:0:1"
msgid "Graaargggh!"
msgstr "Гра-а-а-аргх!"

#. ja: さあさあ<br>お立ち会いでっす！
#. de: Ihr werdet Bauklötze staunen!
#. fr: Vous êtes prêts<nbsp>?<br>Que le spectacle commence<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2881:0:1"
msgid "Gather one, gather all!<br>The show is about to begin!"
msgstr "Собирайтесь, собирайтесь!<br>Представление вот-вот начнётся!"

#. ja: フ・ラミンさん直伝！<br>必殺の舞いでっす！
#. de: Die Schritte hat mir F'lhaminn höchst<shy>persön<shy>lich beigebracht!
#. fr: Voici la danse que m'a apprise F'lhaminn, le Joyau d'Ul'dah<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2882:0:1"
msgid "This I learned from the<br>Songstress of Ul'dah herself!"
msgstr "Этому меня научила сама<br>певица из Ульды!"

#. ja: 次いくでっす！
#. de: Auf zum nächsten Tanz!
#. fr: Allez<nbsp>! Une autre pour la route<nbsp>!
msgctxt "Balloon:2883:0:1"
msgid "For my next number..."
msgstr "А теперь следующий номер..."

#. ja: ありがとでっす！
#. de: Vielen Dank!
#. fr: Merci, merciii<nbsp>!♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2884:0:1"
msgid "Thank you! Thank you!<br>You are all too kind!"
msgstr "Спасибо! Спасибо!<br>Вы слишком добры!"

#. ja: くっ…！
#. de: Argh!
#. fr: Sale garce<nbsp>!
msgctxt "Balloon:2885:0:1"
msgid "Bollocks..."
msgstr "Чёрт..."

#. ja: 油断したぜ…
#. de: Wie unvorsichtig von mir!
#. fr: J'me vengerai<nbsp>!
msgctxt "Balloon:2886:0:1"
msgid "How could such a wee thing be so strong!?"
msgstr "Как такая кроха может быть такой сильной?!"

#. ja: くそっ、こんな小娘に…
#. de: Gegen sie? Unmöglich!
#. fr: Tu perds rien pour attendre, merdeuse<nbsp>!
msgctxt "Balloon:2887:0:1"
msgid "Tossed us about like a rag doll, she did!"
msgstr "Она нас раскидала, как тряпичных кукол!"

#. ja: すまんが、尋ねたいことが…
#. de: Ich hätte da mal eine Frage ...
#. fr: Pardon, j'aimerais vous poser une question...
msgctxt "Balloon:2888:0:1"
msgid "I have a few questions, if I may..."
msgstr "Можно задать вам пару вопросов?"

#. ja: なにか知らないかしら…
#. de: Weißt du vielleicht etwas darüber?
#. fr: Vous ne sauriez pas quelque chose, par hasarrrd<nbsp>?
msgctxt "Balloon:2889:0:1"
msgid "Might I trouble you for a moment...?"
msgstr "Не уделите минутку?.."

#. ja: なんの、その…！
#. de: Ich glaub, ich werd nicht mehr!
#. fr: Ouah, la vache<nbsp>! M-mon dos...
msgctxt "Balloon:2890:0:1"
msgid "The things I do for coin and country..."
msgstr "Вот ведь, чего только не сделаешь<br>ради монеты и родины..."

#. ja: 頼んだぞ…！
#. de: Halte ich das Teil richtig so?
#. fr: Comment ça se tient, ce truc<nbsp>?
msgctxt "Balloon:2891:0:1"
msgid "Am I holding this thing right?"
msgstr "Я правильно держу эту штуку?"

#. ja: 釣りは苦手なんだよ…
#. de: Argh! Fast hätte ich einen gehabt!
#. fr: Mince<nbsp>! J'l'avais presque<nbsp>!
msgctxt "Balloon:2892:0:1"
msgid "Agh! I nearly had one!"
msgstr "Ах! Ещё чуть-чуть — и поймал бы!"

#. ja: 釣れねえなあ
#. de: Die verdammten Viecher wollen einfach nicht anbeißen ...
#. fr: Mais pouquoi qu'y mordent pas<nbsp>?<nbsp>...
msgctxt "Balloon:2893:0:1"
msgid "The bloody things just won't bite..."
msgstr "Проклятые твари никак не клюют..."

#. ja: お、助っ人さんだな！
#. de: Den Zwölf sei Dank!<br>Endlich ist Hilfe da!
#. fr: Ah, les Douze soient loués<nbsp>! Quelqu'un vient nous aider<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2894:0:1"
msgid "Thank the gods!<br>Help's finally arrived!"
msgstr "Слава богам!<br>Наконец-то подмога!"

#. ja: クソがァ…
#. de: Unmöglich ...
#. fr: C'est impossible<nbsp>!<nbsp>...
msgctxt "Balloon:2895:0:1"
msgid "Impossible..."
msgstr "Невозможно..."

#. ja: くっ…！
#. de: Arrrgh ...
#. fr: Argh<nbsp>!
msgctxt "Balloon:2896:0:1"
msgid "Ugh..."
msgstr "Ух..."

#. ja: 死んでたまるか！
#. de: Bei Halone!
#. fr: Pas question de mourir comme ça<nbsp>!
msgctxt "Balloon:2897:0:1"
msgid "You're mine!"
msgstr "Тебе меня не взять!"

#. ja: ありがとう…！
#. de: Habt Dank!
#. fr: Merci<nbsp>!
msgctxt "Balloon:2898:0:1"
msgid "My thanks..."
msgstr "Спасибо..."

#. ja: 助かった
#. de: Das war knapp ...
#. fr: Vous m'avez sauvé<nbsp>!
msgctxt "Balloon:2899:0:1"
msgid "That was close..."
msgstr "Ещё бы чуть-чуть..."

#. ja: ドラゴン族め…
#. de: Verfluchte Drachenbrut!
#. fr: Maudits dragons...
msgctxt "Balloon:2900:0:1"
msgid "Have at you!"
msgstr "Ну, держись!"

#. ja: こんなところで…！
#. de: Ganz schön zäh!
#. fr: Prenez ça<nbsp>!
msgctxt "Balloon:2901:0:1"
msgid "Damn their thick hides!"
msgstr "Чёрт, да у них шкура что надо!"

#. ja: くそぉぉ！
#. de: Jaaa!
#. fr: Bon sang<nbsp>!
msgctxt "Balloon:2902:0:1"
msgid "Yaaargh!"
msgstr "Я-а-а-р-р!"

#. ja: 採掘地への最短ルートは…
#. de: Also gut, der kürzeste Weg zum Abbaugebiet ist ...
#. fr: Je me demande quel est le chemin le plus court pour rentrer...
msgctxt "Balloon:2903:0:1"
msgid "What's the shortest way back, I wonder?"
msgstr "Интересно, как быстрее всего вернуться?"

#. ja: 滑落に注意しろ！
#. de: Vorsicht, der Weg ist rutschig!
#. fr: Attention aux éboulements<nbsp>!
msgctxt "Balloon:2904:0:1"
msgid "Keep an eye out for falling rocks!"
msgstr "Смотри, камни сверху не посыпались бы!"

#. ja: 試掘も大変そうだ
#. de: Probebohrungen sind kein Zucker<shy>schlecken.
#. fr: Le métier de mineur n'a pas l'air d'être de tout repos.
msgctxt "Balloon:2905:0:1"
msgid "Prospecting looks a right chore."
msgstr "Разведка месторождения — та ещё морока."

#. ja: 採掘しやすくはないな…
#. de: Nicht besonders viel<shy>ver<shy>sprechend.
#. fr: Bon courage pour les coups de pioche<nbsp>!
msgctxt "Balloon:2906:0:1"
msgid "I'll bet you'd work up a right sweat digging."
msgstr "Уж вспотеешь, пока тут накопаешь..."

#. ja: 高低差があるな
#. de: Ganz schönes Gefälle.
#. fr: Dix malms à pied, ça use, ça use<nbsp>!
msgctxt "Balloon:2907:0:1"
msgid "Up, up, up it goes, then down, down, down!"
msgstr "То вверх, то вниз — конца и края нет!"

#. ja: 鉱床があるといいが…
#. de: Hoffentlich finden wir was.
#. fr: J'espère qu'on fait pas ça pour rien...
msgctxt "Balloon:2908:0:1"
msgid "I hope there's ore hereabouts."
msgstr "Хоть бы тут нашлась руда..."

#. ja: 急勾配だな
#. de: Ziemlich steil.
#. fr: J'aimerais pas tomber ici...
msgctxt "Balloon:2909:0:1"
msgid "Whew, that's one sharp drop."
msgstr "Ого, какой обрыв."

#. ja: 岩肌に鉱脈は…？
#. de: Erze an der Felsoberfläche?
#. fr: Alors, il y a du minerai<nbsp>?
msgctxt "Balloon:2910:0:1"
msgid "Isn't the ore on the inside?"
msgstr "Разве руда не внутри?"

#. ja: ザザ…イジョウナシ…
#. de: \<biep> ... Keine Anomalien ...
#. fr: Tzzt... Aucune anomalie détectée.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2911:0:1"
msgid "\\<buzzzzzz><br>Sector clear..."
msgstr "\\<бззззз><br>Сектор чист..."

#. ja: 警備中…警備中…
#. de: Patrouillen-Modus ... Patrouillen-Modus
#. fr: Patrouille en cours...<br>Patrouille en cours...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2912:0:1"
msgid "Per...orming...diagn...sti...<br>\\<buzzzzzz>"
msgstr "Вып...олняю... диа...гно...стику...<br>\\<бззззз>"

#. ja: エラー！エラー！
#. de: \<bzzz> Fehler ... Fehler ...
#. fr: Erreur 404<nbsp>!<br>Erreur 404<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2913:0:1"
msgid "Error! Error!<br>Core failure imminent!"
msgstr "Ошибка! Ошибка!<br>Отказ ядра неизбежен!"

#. ja: アジス・ラーへようこそ！<br>アジス・ラーへようこそ！
#. de: \<biep> ...<br>Willkommen in Azys Lla ...
#. fr: Bienvenue à Azys Lla<nbsp>!<br>Bienvenue à Azys Lla<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2914:0:1"
msgid "Welcome to Azys Lla.<br>Please form two lines<br>and await processing."
msgstr "Добро пожаловать в Азис-Лла.<br>Встаньте в две шеренги<br>и ожидайте обработки."

#. ja: ドラゴン族を<br>軽視するのか！？
#. de: Wollt ihr uns auf den Arm nehmen?!
#. fr: Ne nous sous-estimez pas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2915:0:1"
msgid "Heretics! Someone<br>call the guard!"
msgstr "Еретики! Кто-нибудь,<br>позовите стражу!"

#. ja: 役立たずの占星術師め！
#. de: Und so was nennt sich Astrologe!
#. fr: Vous pouvez vous mettre votre astromancie où je pense<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2916:0:1"
msgid "Take your fortune-<br>telling elsewhere!"
msgstr "Гадания свои<br>в другом месте предлагай!"

#. ja: 今日も一日がんばるぞ！
#. de: Neuer Tag, neues Glück!
#. fr: Et c'est reparti... Nouvelle journée, nouvelle chance<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2917:0:1"
msgid "Don't let the beauty of this<br>place fool you. Even the<br>flowers would see you dead."
msgstr "Не дайте красоте этого<br>места себя обмануть. Тут<br>даже цветы вас убить готовы."

#. ja: ふ～<br>やっと一日が終わったぜ！
#. de: Puh ... Den Feierabend hab ich mir verdient!
#. fr: Pfff<nbsp>! Encore une longue journée qui s'achève...
msgctxt "Balloon:2918:0:1"
msgid "I shall sleep well tonight!"
msgstr "Сегодня ночью буду спать как убитый!"

#. ja: おじいさん<br>そろそろ帰りますよ！
#. de: Was haben diese Wolken nur, was ich nicht hab? Nun sag es mir schon, Hubert!
#. fr: Allez, il est l'heure de rentrer maintenant<nbsp>!
msgctxt "Balloon:2919:0:1"
msgid "He's not coming back, love..."
msgstr "Он уже не вернётся, милый..."

#. ja: メェ～
#. de: Mäh ...
#. fr: Bêêêêê...
msgctxt "Balloon:2920:0:1"
msgid "Baa! Baa!"
msgstr "Бе-е! Бе-е!"

#. ja: メェ～メェ～
#. de: Mäh ... Mäh ...
#. fr: Bêê<nbsp>! Bêêê...<nbsp>!
msgctxt "Balloon:2921:0:1"
msgid "Bleeeaaat!"
msgstr "Бее-е-е!"

#. ja: あら、もうこんな時間…<br>あの人が帰ってくるわ♪
#. de: Huch, schon so spät? Dann ist er ja bald zurück ♪
#. fr: Il est déjà cette heure-là<nbsp>? Il faut que je me dépêche de rentrer préparer le dîner.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2922:0:1"
msgid "I've been scattering marl<br>so long, I cannot even<br>remember when I started!"
msgstr "Так долго рассыпала мергель,<br>что уже и не помню,<br>когда начала!"

#. ja: 今日もよく働いたな～！
#. de: Ganz schön geschuftet heute.
#. fr: Pffou... J'suis claqué...
msgctxt "Balloon:2923:0:1"
msgid "Gods, how I hate cabbage..."
msgstr "Боги, как же я ненавижу капусту..."

#. ja: ん…なんだあれは…？
#. de: Komisch ... Sie hätte längst für ihr tägliches Sonnenbad ... Hm? Was suchst du hier?!
#. fr: Hmm<nbsp>? J'ai cru voir quelque chose bouger<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2924:0:1"
msgid "Which end was I supposed<br>to look into again?"
msgstr "На какой конец-то смотреть?<br>Забыл уже..."

#. ja: まずい、まずい、<br>ぼうずじゃ帰れない
#. de: Vanu-eeh suchen schnell wie Sausewind!
#. fr: Ça veut pas mordre aujourd'hui...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2925:0:1"
msgid "Fish in sea are like stars<br>in heavens─ever bountiful!"
msgstr "Рыбы в море — как звёзды<br>на небе: их не перечесть!"

#. ja: エサどこ…
#. de: Kommt raus, kleine Würmchen!
#. fr: Sortez de votre cachette, petits vers<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2926:0:1"
msgid "Then why can<br>you catch none?"
msgstr "Тогда почему же<br>ничего не ловится?"

#. ja: フンッ
#. de: Und vorwärts!
#. fr: YAH<nbsp>!
msgctxt "Balloon:2927:0:1"
msgid "Rain!"
msgstr "Дождь!"

#. ja: ハッ！
#. de: Rückwärts!
#. fr: WARH<nbsp>!
msgctxt "Balloon:2928:0:1"
msgid "Sky!"
msgstr "Небо!"

#. ja: ホッ！
#. de: Seitwärts, ran!
#. fr: RAARH<nbsp>!
msgctxt "Balloon:2929:0:1"
msgid "Life!"
msgstr "Жизнь!"

#. ja: さ、寒い…<br>だれか開けてくれ…
#. de: M-Mist, ausgesperrt. H-Hast du 'nen Schlüssel?
#. fr: J-j'ai si froid<nbsp>!<br>Ouvrez-moi la porte<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2930:0:1"
msgid "Open this door or I'll...<br>Or I'll... Gah! Just open it!"
msgstr "Откройте дверь, а то я...<br>А то... Чёрт, просто откройте!"

#. ja: あれ？<br>あいつどこ行った？
#. de: Er wollte nur mal kurz den Ausblick genießen, hat er gesagt. Das war vor drei Wochen!
#. fr: Tiens<nbsp>? Mais il manque quelqu'un<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2931:0:1"
msgid "'Tweren't for these<br>goggles, our eyes'd freeze<br>solid! I've seen it happen!"
msgstr "Если б не эти очки,<br>глаза бы замёрзли насмерть!<br>Сам видел, как такое было!"

#. ja: ここはもっと強化が必要だ
#. de: Diese Stelle muss verstärkt werden.
#. fr: Il va falloir renforcer un peu ce toit...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2932:0:1"
msgid "We'll need six score nails,<br>ten score lengths of ash...<br>Are you getting all this?"
msgstr "Нам понадобится сто двадцать гвоздей<br>и двести досок из ясеня...<br>Запоминаешь?"

#. ja: さっさとしろ！<br>親方に怒られるぞ！
#. de: Hau rein! Hab keine Lust auf 'ne weitere Standpauke vom Chef!
#. fr: Dépêche-toi, ou l'patron va nous enguirlander<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2933:0:1"
msgid "Don't tell me it's frozen to<br>the cobbles. I'm not falling<br>for <i>that</i> one again!"
msgstr "Только не говори, что всё<br>примёрзло к мостовой. На<br><i>это</i> я уже не куплюсь!"

#. ja: ここもか…<br>修復した方がいいな
#. de: Hm ... Das werden wir wohl oder übel restaurieren müssen.
#. fr: Il faut renforcer cette main, ou elle va s'écrouler<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2934:0:1"
msgid "I have no idea how I'm<br>going to get down..."
msgstr "И как мне теперь<br>отсюда спускаться..."

#. ja: だれか～<br>お助けぇぇ！
#. de: H-Hilfeee!
#. fr: Au secours, je vais tombeeer<nbsp>!
msgctxt "Balloon:2935:0:1"
msgid "Good-bye, cruel world!"
msgstr "Прощай, жестокий мир!"

#. ja: …危うく死ぬところだった
#. de: Nach dem Schreck brauch ich erst mal 'ne Pause.
#. fr: J'ai bien failli y rester...
msgctxt "Balloon:2936:0:1"
msgid "Damned powder snow..."
msgstr "Проклятый рыхлый снег..."

#. ja: 異常な～し！
#. de: Eines Tages wird das alles ... Hm, du kennst den Spruch?
#. fr: Rien à signaler à l'ouest<nbsp>!
msgctxt "Balloon:2937:0:1"
msgid "I think I see a mountain!"
msgstr "Кажется, я вижу гору!"

#. ja: やっべぇ！<br>寝坊した～！
#. de: Mist, verschlafen!
#. fr: Zut<nbsp>! Je me suis pas réveillé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2938:0:1"
msgid "Six bells!? The foreman'll<br>have me head!"
msgstr "Уже шесть!? Прораб мне<br>голову оторвёт!"

#. ja: いてて…<br>手を打っちまった…
#. de: Verflixt, wenn ich mich erinnern könnte, was ich holen wollte! Den Hammer ...?
#. fr: Aïe<nbsp>!! Je me suis tapé la main<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2939:0:1"
msgid "It's straight to the pallet<br>for me tonight... After an<br>ale or six, of course."
msgstr "Сегодня сразу на койку...<br>Но сначала кружечек шесть эля."

#. ja: げええ…
#. de: Örks ... Is mir übel ...
#. fr: Beuargh...
msgctxt "Balloon:2940:0:1"
msgid "\\<belch>"
msgstr "\\<рыгание>"

#. ja: 飲め飲め！<br>体が温まるぞ～！
#. de: Trink, trink! Dann geht's dir gleich besser!
#. fr: Allez, bois, ça va te réchauffer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2941:0:1"
msgid "Gahahaha! Somebody bring<br>this boy another round!<br>His first be runnin' down<br>his britches!"
msgstr "Га-га-га! Налейте парню<br>ещё кружку! У него первая<br>уже по штанам потекла!"

#. ja: オイオイ！<br>未成年に酒飲ませちゃダメだ！
#. de: Lass endlich den Kleinen in Ruhe!
#. fr: Il est bien trop jeune, enfin<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2942:0:1"
msgid "Thal's balls, man!<br>Stop wastin' good brew<br>on a whelp what'll just<br>disgorge 'er gutterwise!"
msgstr "Да чтоб тебя! Не трать<br>доброе пиво на сопляка —<br>он же всё вывернет прямо в<br>канаву!"

#. ja: まだまだ雑念が多いな…
#. de: Ich hab doch gesagt: Nicht denken ... Fühlen.
#. fr: Tu manques encore de con<shy>cen<shy>tra<shy>tion, ma fille...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2943:0:1"
msgid "You must unlearn what<br>you have learned."
msgstr "Тебе нужно разучиться<br>всему, чему ты научился."

#. ja: くそっ！<br>あんな奴に負けるもんか！
#. de: Ich kann nicht glauben, dass ich gegen diesen Kerl verloren habe!
#. fr: Je ne dois plus rater ma cible<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2944:0:1"
msgid "What do you <i>mean</i>,<br>“There is no try”?"
msgstr "Как это — <i>«делать попыток не надо»</i>?"

#. ja: おい、押すなよ！？
#. de: Wehe, du schubst mich!
#. fr: Eh<nbsp>! Ne me fais pas peur comme ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2945:0:1"
msgid "Just what the<br>colonel ordered."
msgstr "Вот именно то, что<br>полковник прописал."

#. ja: 音をさせるな！<br>逃げられちゃうだろ！
#. de: Verhalt dich still. Sonst scheuchst du den Vogel auf!
#. fr: Pas un bruit<nbsp>!<br>Tu vas les faire fuir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2946:0:1"
msgid "Quiet! I'll not have you<br>frighten off my quarry!"
msgstr "Тихо! Не спугни<br>мою добычу!"

#. ja: シシシシシ…
#. de: Bssst ...
#. fr: Kssssss<nbsp>!!
msgctxt "Balloon:2947:0:1"
msgid "\\<click> \\<click>"
msgstr "\\<щёлк> \\<щёлк>"

#. ja: 降りれん…<br>シシシシシ…
#. de: Und wie kommen wir jetzt wieder runter?
#. fr: Je ne peux plus descendre, ksss<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2948:0:1"
msgid "In or out? \\<click><br>\\<click> Out or in?"
msgstr "Войти или выйти? \\<щёлк><br>\\<щёлк> Выйти или войти?"

#. ja: かわいいね～
#. de: Süß, nicht? Ich will auch so einen haben!
#. fr: Coucou, tu veux voir ma bête<nbsp>?
msgctxt "Balloon:2949:0:1"
msgid "I won't let them eat you."
msgstr "Я не дам им тебя съесть."

#. ja: 危険な道のりだが<br>気を付けていくぞ！
#. de: Kein Gil ohne Risiko!
#. fr: Ce chemin est dangereux, mais je vais faire attention.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2950:0:1"
msgid "If I lose another 'bo to<br>those yetis, I'll be ruined."
msgstr "Если я ещё раз проиграю<br>йети в кости, мне конец."

#. ja: ふう…
#. de: Uff ...
#. fr: Ouf...
msgctxt "Balloon:2951:0:1"
msgid "Whew..."
msgstr "Фух..."

#. ja: 助かったぜ…
#. de: Vielen Dank!
#. fr: Vous m'avez sauvé<nbsp>!
msgctxt "Balloon:2952:0:1"
msgid "We're in your debt."
msgstr "Мы у тебя в долгу."

#. ja: あの…すいません…
#. de: Verzeihung ...
#. fr: Euh... Excusez-moi...
msgctxt "Balloon:2953:0:1"
msgid "May I have a moment?"
msgstr "Можно вас на минутку?"

#. ja: …何用だ
#. de: Was soll das?
#. fr: Quoi<nbsp>!?
msgctxt "Balloon:2954:0:1"
msgid "Make it quick."
msgstr "Покороче."

#. ja: ここを越えれば<br>ドラヴァニアだ！
#. de: Jetzt ist's nur noch ein Katzensprung bis Dravania.
#. fr: En continuant par là, on arrive à La Penne.
msgctxt "Balloon:2955:0:1"
msgid "Just a few more malms..."
msgstr "Ещё пара миль — и будем<br>в Дравании!"

#. ja: 早く狩りて～ぜ！
#. de: Kann's gar nicht erwarten, wieder auf Jagd zu gehen.
#. fr: J'ai hâte d'aller chasser<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2956:0:1"
msgid "Cut my hand with this<br>damned knife. Captain<br>says no hunting till it heals."
msgstr "Порезал руку этим<br>проклятым ножом. Капитан<br>запретил охотиться, пока не заживёт."

#. ja: 異端者の動きが…
#. de: Kommen zwei Häretiker zum Arzt. Sagt der eine ...
#. fr: Les hérétiques semblent mijoter quelque chose...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2957:0:1"
msgid "The colder it grows, the<br>bolder the heretics become."
msgstr "Чем холоднее становится,<br>тем наглее делаются еретики."

#. ja: ZZZ…
#. de: Zzz ...
#. fr: Zzz...
msgctxt "Balloon:2958:0:1"
msgid "Zzz... Zzz... \\<snort> Zzz..."
msgstr "Хр-р... Хр-р... \\<храп> Хр-р..."

#. ja: ZZZ…はやいくぽ…
#. de: Zzz ... Ist schon Morgen, kupo?
#. fr: Zzz... Je veux dormir, kuppo...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2959:0:1"
msgid "Zzz... Mog be nimble...<br>Mog be quick... Zzz..."
msgstr "Хр-р... Мог быть ловким...<br>Мог быть быстрым... Хр-р..."

#. ja: 美味すぎて<br>止められないくぽ！
#. de: Nüsse! Nüsse, Nüsse, Nüsse! Mampf, kupo!
#. fr: C'est tellement bon que je ne peux pas m'arrêter, kuppo<nbsp>!
msgctxt "Balloon:2960:0:1"
msgid "I can't stop, kupo!"
msgstr "Не могу остановиться, купо!"

#. ja: ZZZ…もう食べれないくぽ…
#. de: Puh, bin ich voll ... Und müde ... Zzz, kupo ...
#. fr: Zzz... J'ai trop mangé, kuppo<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2961:0:1"
msgid "Zzz... If I could only eat<br>in my sleep, kupo... Zzz..."
msgstr "Хр-р... Вот бы есть<br>во сне, купо... Хр-р..."

#. ja: 君も飛べるくぽ？
#. de: Du kannst auch fliegen, kupo?
#. fr: Toi aussi tu voles, kuppo<nbsp>?
msgctxt "Balloon:2962:0:1"
msgid "A flying landlord!?"
msgstr "И домовладелец летает!?"

#. ja: 警備中くぽ！
#. de: Aus dem Weg, ich patrouilliere, kupo!
#. fr: Je veille au grain<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2963:0:1"
msgid "You like my axe? You<br>can't have it, kupo!"
msgstr "Нравится мой топор?<br>Не отдам, купо!"

#. ja: やってらんねぇぜ～
#. de: Halone ... Warum hast du uns verlassen?
#. fr: Pas envie d'bosser...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2964:0:1"
msgid "You'll see me a knight<br>afore you see me<br>swing a sledge."
msgstr "Скорее рыцарем стану,<br>чем возьму в руки кувалду."

#. ja: うう…
#. de: Uuuh ...
#. fr: Argh...
msgctxt "Balloon:2965:0:1"
msgid "Just leave me, Sister."
msgstr "Оставьте меня, сестра."

#. ja: おい、大丈夫か！
#. de: Stirb mir hier bloß nicht weg, hörst du?
#. fr: Hé, ça va<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2966:0:1"
msgid "What were you thinking,<br>coming back out here<br>before your wounds healed?"
msgstr "О чём ты думал, когда<br>вернулся сюда, не дождавшись,<br>пока раны заживут?"

#. ja: ううう…凍える…
#. de: An diese Kälte werd ich mich nie gewöhnen.
#. fr: Brrr<nbsp>! Je suis glacée...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2967:0:1"
msgid "It's colder than a<br>dragon's stare out there!"
msgstr "Там холоднее, чем взгляд<br>дракона!"

#. ja: 重い…！<br>何が入ってるんだ！？
#. de: Verdammt, festgefroren!
#. fr: Bon sang<nbsp>! Y a quoi là-dedans<nbsp>? Ça pèse une tonz<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2968:0:1"
msgid "“Lift with the legs,”<br>she said. Bah!"
msgstr "«Поднимай ногами», —<br>сказала она. Ну да, конечно!"

#. ja: ひとりじゃ無理か…
#. de: Das schaff ich doch mit link... Argh, mein Kreuz!
#. fr: À la une... À la deux...<br>À la TROIIIIIS<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2969:0:1"
msgid "I could use that pickaxe<br>over here, Midlander."
msgstr "Мне бы тут кирка пригодилась, чужеземец."

#. ja: 例の場所に非合法の賭博場が<br>あるらしいぜ…
#. de: Ein Bekannter von mir hat da drinnen sein ganzes Vermögen verzockt!
#. fr: Il y a un casino clandestin à l'intérieur de la carrière... Ça vous intéresse<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2970:0:1"
msgid "Even the mutton down in<br>the Brume'll cost ye.<br>Might be a toss o' the<br>bones'd line yer linty purse."
msgstr "Даже баранина в Трущобах<br>тебе в копеечку встанет.<br>А вот сыграть в кости —<br>и карман не так опустеет."

#. ja: それ、やばいんじゃない？
#. de: Bei den armen Schluckern, die sich deine Freunde schimpfen, kann das ja nicht viel gewesen sein.
#. fr: C'est tentant, mais j'ai déjà à peine de quoi m'acheter à manger...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2971:0:1"
msgid "Are you suggesting I<br>use ill-gotten coin to<br>purchase the services of<br>a local courtesan? Pah, I say!"
msgstr "Ты предлагаешь мне на краденые<br>деньги купить услуги местной<br>куртизанки? Да ни за что!"

#. ja: 家族全員…<br>俺を残して死んじまった…
#. de: Meine ganze Familie ... tot ... Warum haben sie mich nicht mitgenommen?
#. fr: Ma femme... Mes enfants... Tous morts... C'est pas juste<nbsp>! Hic<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2972:0:1"
msgid "They're all dead...and it<br>was me who killed 'em!"
msgstr "Они все мертвы... И это<br>я их убил!"

#. ja: 早く直さないとな！
#. de: Das muss schleunigst repariert werden!
#. fr: Ça va prendre du temps pour réparer tout ça...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2973:0:1"
msgid "Why do I even bother?<br>It will only be demolished<br>again in the next raid..."
msgstr "Зачем я вообще стараюсь?<br>После следующего налёта<br>всё опять разнесут..."

#. ja: 資材は持ったし後は…
#. de: Uns fehlt es vorne und hinten an Materialien.
#. fr: Je crois qu'on a tous les matériaux dont on a besoin...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2974:0:1"
msgid "This won't be<br>nearly enough..."
msgstr "Этого и близко<br>не хватит..."

#. ja: この店で高価な順に<br>3つほどいただこうかしら？
#. de: Gib mir einfach die Teuersten! Wie sie aussehen, ist mir egal.
#. fr: Donnez-moi ce que vous avez de mieux. Je me fiche du prix.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:2975:0:1"
msgid "I'll take two of everything.<br>In gold <i>and</i> silver!"
msgstr "Мне по две штуки каждого.<br>И золотого, <i>и</i> серебряного!"

#. ja: えーと…野菜屋は…
#. de: Der Gemüsehändler müsste hier irgendwo ...
#. fr: Je comprends pas... Le maraîcher devrait être ici...
msgctxt "Balloon:2976:0:1"
msgid "Is this a “P” or an “R”?"
msgstr "Это «П» или «Р»?"

#. ja: …お兄ちゃん、大丈夫？
#. de: Bruderherz, hältst du den Zettel nicht falsch herum?
#. fr: Ta carte serait pas à l'envers, par hasard<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2977:0:1"
msgid "Maybe if you had studied<br>your letters instead of<br>playing Knights & Knaves<br>we'd have our lemoncakes."
msgstr "Может, если бы ты учил<br>буквы, а не играл в «Рыцарей и негодяев»,<br>у нас были бы лимонные пирожные."

#. ja: …え？<br>あんだって？
#. de: Megatrank? Ts, diese neumodischen Namen ... Furchtbar.
#. fr: Méga quoi...<nbsp>? Parlez plus fort, je ne vous entends pas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2978:0:1"
msgid "Might you have aught<br>for boils, miss? Big ones."
msgstr "Нет ли у вас чего-нибудь<br>от фурункулов, барышня? От здоровенных."

#. ja: 神学生って<br>いろいろ大変そうだな…
#. de: Ich wollte immer gerne aufs Theologikum gehen, aber im Moment scheint die Lage dort ziemlich kompliziert zu sein.
#. fr: Ça a l'air d'être dur pour les élèves du scolasticat, ces temps-ci...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2979:0:1"
msgid "You need more than<br>an endorsement to enter<br>the seminary, you know."
msgstr "Чтобы поступить в семинарию,<br>одного рекомендательного письма мало, знаешь ли."

#. ja: おっそいな～！<br>心配しちゃったよ！
#. de: Ich hasse es, wenn man mich warten lässt.
#. fr: Raah<nbsp>! Je commence vraiment à me faire du mouron...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2980:0:1"
msgid "It feels as if we've<br>waited here an eternity!"
msgstr "Кажется, мы тут целую<br>вечность прождали!"

#. ja: 大聖堂内は<br>お静かにお願いします
#. de: Verhalte dich drinnen bitte ruhig.
#. fr: Merci de respecter le silence pour éviter de perturber les fidèles.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2981:0:1"
msgid "You need not speak while<br>in the chapel, for the Fury<br>can hear the whispers of<br>your soul."
msgstr "В часовне говорить незачем.<br>Сама Фурия слышит шёпот<br>вашей души."

#. ja: こちらより先は<br>立ち入り禁止となります
#. de: Ab hier ist der Zutritt nur Befugten gestattet.
#. fr: Je suis désolée, mais je ne suis pas autorisée à vous dire ce qu'il y a derrière cette porte.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2982:0:1"
msgid "What lies beyond is not<br>for the eyes of an unbeliever."
msgstr "Неверующему не положено<br>видеть, что скрывается за этой дверью."

#. ja: 今日もお綺麗ですね
#. de: Dieses Gelb steht Euch ausgezeichnet, Werteste.
#. fr: <if ($gn11 < 12)><if ($gn11 < 4)>Vous êtes le soleil de mes nuits, et la lumière de mes jours...<else>Le jaune vous va à ravir, très chère...</if><else><if ($gn11 < 17)>Vos parents ont donc pris toutes les étoiles du ciel pour les mettre dans vos yeux<nbsp>!<else>Vous êtes le soleil de mes nuits, et la lumière de mes jours...</if></if>
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2983:0:1"
msgid "Your skin is like the snow,<br>your eyes like sapphires!"
msgstr "Кожа у вас бела, как снег,<br>а глаза — как сапфиры!"

#. ja: この星の並びは…
#. de: Diese Konstellation kann nur eins bedeuten ...
#. fr: Cette constellation est absolument magnifique...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2984:0:1"
msgid "These stars won't align for<br>another seventy lunations."
msgstr "Эти звёзды сойдутся<br>лишь через семьдесят лунаций."

#. ja: なんだこれは…
#. de: Ist das möglich?
#. fr: Je viens de faire une découverte ex<shy>cep<shy>tion<shy>nelle<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2985:0:1"
msgid "Why can't the viscount<br>put anything away...?"
msgstr "Почему виконт никогда<br>ничего не убирает?.."

#. ja: あの星の輝きは…
#. de: So ein Leuchten ist nicht normal für diese Jahreszeit.
#. fr: Cette étoile brille si fort, c'est prodigieux...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2986:0:1"
msgid "The star has changed its<br>magnitude from four to five!"
msgstr "Звезда сменила величину<br>с четвёртой на пятую!"

#. ja: やだ、奥様ったら！<br>そういえば、宅の主人が…
#. de: Ohohohohoho! Wenn Ihr seine Nase gesehen hättet, wüsstet Ihr, wovon ich spreche!
#. fr: Il était vraiment gentil, mais si vous aviez vu son nez... On aurait dit un roc<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2987:0:1"
msgid "But a moon in the<br>kitchens and the maid is<br>already fat with child!"
msgstr "Но стоит луне показаться<br>на кухне, как служанка уже<br>беременна!"

#. ja: まだ始まらないようだな…
#. de: Scheint wohl noch etwas zu dauern, bis es losgeht.
#. fr: À quelle heure vous avez dit que ça commençait<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2988:0:1"
msgid "How much longer must we<br>wait? You, fetch me a drink."
msgstr "И сколько ещё ждать?<br>Эй ты, принеси мне выпить."

#. ja: シュコォ…シュコォ…<br>おうち作って　大御殿！
#. de: Psh, willzu mitbauen? Schönehaus für Wohnen.
#. fr: Le gentil Gobelin va se construire un vrai palace<nbsp>! Pssshh...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2989:0:1"
msgid "The gobbiehall will see<br>overmuch feasting and<br>trading of tongueflaps!"
msgstr "В гоббихолле будет<br>много пиров и трёпа!"

#. ja: オイラのお魚～はよ焼けろ～
#. de: Glaubzzu ist schon fertig ...?
#. fr: Encore quelques minutes et le poisson sera cuit à point.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2990:0:1"
msgid "Warmfeet and warmfish<br>and water that's clean.♪<br>Bigsky and tongue-tie,<br>a good gobbie's dream.♪"
msgstr "Тёплые ножки, тёплая рыба<br>и чистая вода.♪<br>Большое небо и длинный язык —<br>мечта любого гобби.♪"

#. ja: シュコォ…シュコォ…<br>デッカイ工房　作っちゃう？
#. de: Willzu maschinebauen, brauchzzu gute Werkenstätte, kho!
#. fr: Pshh...<nbsp>! Les Gobelins ont besoin d'un grand atelier pour construire leurs machines<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2991:0:1"
msgid "The better the boom,<br>the bigger the doom!"
msgstr "Чем громче взрыв,<br>тем больше бед!"

#. ja: さーて！<br>今回の仕事場はここだ！
#. de: Da wären wir! Packen wir's an!
#. fr: Bon, ben, y a plus qu'à s'mettre au travail<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2992:0:1"
msgid "It's quieter than the<br>Toll, I'll give it that."
msgstr "Тут потише, чем в Торговых рядах, это точно."

#. ja: 設置完了っと！
#. de: Die Klingel steht, Zeit für 'ne Pause.
#. fr: Ces sonnettes sont beaucoup plus compliquées à installer qu'on ne le dirait.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2993:0:1"
msgid "A summoning bell...?<br>Dare I ring it...just once?"
msgstr "Колокол призыва?.. <br>Осмелюсь ли я позвонить... хоть разок?"

#. ja: フウウ～！<br>この一服のために生きてるぜ
#. de: Ein Zug Gizar-Kraut und du schwirrst ab in den Äther, ich sag's dir.
#. fr: Rien de tel qu'une bonne pipe pour se détendre.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2994:0:1"
msgid "There's naught like a long<br>drag on the pipe here to<br>calm a man's nerves after<br>a day fittin' blast caps."
msgstr "Нет ничего лучше, чем затянуться трубкой после дня, проведённого за набивкой взрывных капсюлей. Сразу нервы успокаиваются."

#. ja: 未成年のくせに<br>止めろっても聞きやしねえ
#. de: Ist das der Grund, warum schwarze Chocobos fliegen können?
#. fr: Dit comme ça, c'est très ambigu...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:2995:0:1"
msgid "Man!? You've not seen a<br>day past twelve summers!<br>Now pass the bloody briar<br>afore I whack you one good."
msgstr "Мужик!? Да тебе и двенадцати-то ещё нет! А ну, передай трубку, пока я тебе не врезал как следует."

#. ja: 大丈夫か～？
#. de: So war das nicht gemeint, als ich sagte, du sollst dich mal hängen lassen!
#. fr: Pfiou<nbsp>! Ça fait au moins vingt-huit jours qu'il est suspendu là-haut<nbsp>!
msgctxt "Balloon:2996:0:1"
msgid "Don't look down!"
msgstr "Не смотри вниз!"

#. ja: グゥ…グゥ…
#. de: Wer ist hier?
#. fr: Zzz...
msgctxt "Balloon:2997:0:1"
msgid "Zzz..."
msgstr "Хр-р... Хр-р..."

#. ja: 坑道掘るーの<br>疲れたーよ…
#. de: Müde von graben, immer graben ...
#. fr: Je suis fatigué de creuser, toujours creuser, oui.
msgctxt "Balloon:2998:0:1"
msgid "Which way was escape tunnel?"
msgstr "Где там был выход из шахты?"

#. ja: フシギナ、ジュモンサ<br>サッサカサ！
#. de: Husch, weg den grauen Staub und zauberhafte Welten her!
#. fr: Je me demande ce qui est le pire... Les kikoo lol ou les ouin ouin<nbsp>?
msgctxt "Balloon:2999:0:1"
msgid "Flipp'er over, flip flip!"
msgstr "Переверни его, крути-верти!"
