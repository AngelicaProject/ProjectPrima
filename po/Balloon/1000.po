# Balloon
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: キリがありゃしない
#. de: Es nimmt und nimmt keine Ende ...
#. fr: Ça n'a pas de fin.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1000:0:1"
msgid "Aye. I'm not combin'<br>the hills for bones again."
msgstr "Ага. Неохота опять шарить<br>по холмам в поисках костей."

#. ja: …………
#. de: Lasst diesen Mann den Frieden finden, den er verdient, oh Zwölf!
#. fr: Accompagnez-le bien dans le royaume de l'au-delà...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1001:0:1"
msgid "See him safely<br>to the realm beyond..."
msgstr "Пусть он благополучно<br>доберётся до мира иного..."

#. ja: 未使用
#. de: Der Tod kann das Band zwischen uns nicht brechen.
#. fr: 未使用
msgctxt "Balloon:1002:0:1"
msgid "未使用"
msgstr "未使用"

#. ja: 祈りましょう
#. de: Möge sie für immer Thals Reich beschreiten.
#. fr: Puisse-t-elle à jamais marcher dans le royaume de Thal.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1003:0:1"
msgid "May she tread forever-<br>more in the realm of Thal."
msgstr "Пусть она вечно ступает<br>по владениям Тала."

#. ja: かしこまりました
#. de: Jawohl, Ma'am.
#. fr: Très bien, M'dame.
msgctxt "Balloon:1004:0:1"
msgid "Very good, ma'am."
msgstr "Будет исполнено, госпожа."

#. ja: 死体の運搬か？
#. de: Sag bitte nicht, du bringst uns noch mehr Tote. Der Friedhof quillt so auch schon über.
#. fr: Vous venez porter ces corps au cimetière<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1005:0:1"
msgid "Come to carry those<br>bodies to the lichyard?"
msgstr "Трупы на кладбище<br>повезли?"

#. ja: よっ…
#. de: Ich wünschte, sie hätten den Anstand, draußen zu sterben.
#. fr: J'aurais préféré qu'ils aient le bon goût de mourir <i>dehors</i>.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1006:0:1"
msgid "I wish they'd have the<br>decency to die <i>outside</i>."
msgstr "Вот бы они догадались<br>умирать <i>снаружи</i>."

#. ja: 掘り出し物ないかなー？
#. de: Sei ruhig, Schatz, ich versuche hier, deine Gil loszuwerden.
#. fr: Chut<nbsp>! Pas un bruit pendant que je dépense ton argent.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1007:0:1"
msgid "Shush, dear, while I<br>spend your coin."
msgstr "Тише, милый, я тут<br>твои деньги трачу."

#. ja: 早くしてくれ
#. de: Brauchen wir wirklich mehr davon ... was immer das auch ist?
#. fr: On a vraiment encore besoin de ces... choses, quel que soit leur nom<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1008:0:1"
msgid "Do we really need any<br>more of these...whatever<br>they are?"
msgstr "Нам точно нужно ещё<br>этих... как их там?"

#. ja: 取り寄せておいて
#. de: Ich möchte nicht, dass er erfährt, dass das Päckchen von mir ist.
#. fr: Je ne veux pas qu'il sache que c'est moi qui ai envoyé le colis.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1009:0:1"
msgid "I do not wish him<br>to know it was I<br>who sent the parcel."
msgstr "Не хочу, чтобы он узнал,<br>кто послал посылку."

#. ja: なんだよ…
#. de: Was willst du?
#. fr: Qu'est-ce que tu m'veux<nbsp>?
#. macro: <if $gn4>Might be I's lookin' to dip<br>the wick. Ye keen?<else>Sod off. I ain't got no<br>use fer you and yer ilk.</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1010:0:1"
msgid "<if $gn4>Might be I's lookin' to dip<br>the wick. Ye keen?<else>Sod off. I ain't got no<br>use fer you and yer ilk.</if>"
msgstr "<if $gn4>Может, я хочу<br>развлечься. Не против?<else>Проваливай. Мне не нужны<br>такие, как ты.</if>"

#. ja: …買うか？
#. de: Mal sehen. Die braunen Linsen, die grünen Linsen ... und das wäre alles.
#. fr: J'ai des lentilles brunes, des lentilles vertes et... c'est tout.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1011:0:1"
msgid "Let's see. We have your<br>brown lentils, your green<br>lentils, and...that's all."
msgstr "Так, у нас твоя коричневая<br>чечевица, зелёная чечевица<br>и... вроде всё."

#. ja: ザル神のお導きを…
#. de: Möge Thal dir den Weg erleuchten ...
#. fr: Faites-le bien profond, ou bien les chacals viendront se servir.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1012:0:1"
msgid "Make this one deep, or<br>the jackals'll be at him."
msgstr "Поглубже копайте, а то<br>шакалы его обглодают."

#. ja: 戦神ハルオーネよ、<br>我が忠義を大盾と成せ！
#. de: Große Halone, Göttin des Krieges, werde deinen treuen Dienern Schild!
#. fr: Halone, sois mon bouclier<nbsp>!
msgctxt "Balloon:1013:0:1"
msgid "Halone, be my shield!"
msgstr "Халонна, защити меня!"

#. ja: 戦神ハルオーネよ、<br>我が忠義を大剣と成せ！
#. de: Große Halone, Göttin des Krieges, werde deinen treuen Dienern Schwert!
#. fr: Halone, guide mon épée<nbsp>!
msgctxt "Balloon:1014:0:1"
msgid "Halone, guide my sword!"
msgstr "Халонна, направь мой меч!"

#. ja: やっちまえっ！
#. de: Immer feste drauf!
#. fr: En avant<nbsp>!
msgctxt "Balloon:1016:0:1"
msgid "Get 'em!"
msgstr "Покажите им!"

#. ja: へへへ、いけいけ！
#. de: Vorwärts!
#. fr: Allez-y, hé hé hé<nbsp>!
msgctxt "Balloon:1017:0:1"
msgid "Gahaha! This'll learn ye!"
msgstr "Га-ха-ха! Вот вам наука!"

#. ja: くらえ！
#. de: Nimm dies!
#. fr: Yaaah<nbsp>!
msgctxt "Balloon:1018:0:1"
msgid "Hyaaah!"
msgstr "А-а-а!"

#. ja: このー！
#. de: Keine Gefangenen!
#. fr: Prends ça<nbsp>!
msgctxt "Balloon:1019:0:1"
msgid "Take that!"
msgstr "Получай!"

#. ja: このやろう！
#. de: Verdammter Schuft!
#. fr: Que Rhalgr t'emporte<nbsp>!
msgctxt "Balloon:1020:0:1"
msgid "Try this on for size!"
msgstr "А ну-ка попробуй это!"

#. ja: これでもか！
#. de: Na, wie ist das?
#. fr: On ne se laissera pas faire<nbsp>!
msgctxt "Balloon:1021:0:1"
msgid "To the great beyond with you!"
msgstr "Отправляйся к праотцам!"

#. ja: オオオオオン！
#. de: Grrraaarrr!
#. fr: Graaarrrgh<nbsp>!
msgctxt "Balloon:1022:0:1"
msgid "Graaarrrgh!"
msgstr "Гра-а-ар!"

#. ja: オオォォオオオォォ！
#. de: Haaarrrhhh!
#. fr: GRAAARRRGGGH<nbsp>!
msgctxt "Balloon:1023:0:1"
msgid "GRAAARRRGGGH!"
msgstr "ГРА-А-АРРР!"

#. ja: ふむ…
#. de: Ach, wenn ich doch nur auf dem Äther dieses elende Loch verlassen könnte.
#. fr: Qu'est-ce que je donnerais pas pour sortir de ce trou.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1024:0:1"
msgid "What I wouldn't give to<br>ride the aether straight<br>out of this hellhole."
msgstr "Чего бы я не отдал, чтобы<br>умчаться на эфире прочь<br>из этой дыры."

#. ja: 教会に用か？
#. de: Vorräte findest du unten im Lager.
#. fr: Vous trouverez des provisions en bas, au camp.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1025:0:1"
msgid "You can find supplies<br>down in the camp."
msgstr "Припасы найдёшь<br>в лагере внизу."

#. ja: 異常なし、と
#. de: Wo ist er!?
#. fr: Où est-il<nbsp>!? Ça fait au moins trois heures que mon quart est fini<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1026:0:1"
msgid "Where <i>is</i> he!? My shift<br>was over three bells ago!"
msgstr "Да где же <i>он</i>!? Моя смена<br>закончилась три колокола назад!"

#. ja: 休むなら是非うちで
#. de: Bei uns findest du ein weiches Bett und ein Dach über dem Kopf! Die Läuse gibt's gratis dazu.
#. fr: Bienvenue au Sommeil éternel<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1027:0:1"
msgid "Welcome to the<br>Eternal Sleep!"
msgstr "Добро пожаловать<br>в «Вечный сон»!"

#. ja: そうだねぇ…
#. de: Allerdings ...
#. fr: Et qui dit qu'on peut pas<nbsp>?
msgctxt "Balloon:1028:0:1"
msgid "And who says we can't?"
msgstr "А кто нам запретит?"

#. ja: 誰も見てない…
#. de: Niemand wird eine kleine Zitrone vermissen.
#. fr: Un petit citron ne manquera à personne.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1029:0:1"
msgid "Nobody will miss<br>one little lemon."
msgstr "Одного лимона никто<br>и не хватится."

#. ja: 黒衣森へ抜けましょう
#. de: Ich habe gehört, es gäbe Schätze in der Unsichtbaren Stadt.
#. fr: Il paraît qu'il y a des trésors dans la Cité invisible.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1030:0:1"
msgid "I hear there's treasure<br>in the Invisible City."
msgstr "Говорят, в Невидимом городе<br>сокровища есть."

#. ja: 大丈夫なのか？
#. de: Ja, wenn du denn lebend hinkommst.
#. fr: Oui, ils sont à toi si tu y arrives en vie.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1031:0:1"
msgid "Yes, if you can<br>reach it alive."
msgstr "Ага, если доберёшься<br>туда живым."

#. ja: 迎えまだかな～
#. de: Ich ... Äh ... Du hast <i>was</i>!?
#. fr: Je... euh... Tu as <i>quoi</i><nbsp>!?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1032:0:1"
msgid "I...uh... You <i>what</i>!?"
msgstr "Я... э-э... Ты <i>что</i>!?"

#. ja: かな～
#. de: Geht's um deinen geheimen Biervorrat? Den habe ich nämlich schon getrunken.
#. fr: Si c'est au sujet de ta réserve cachée de bière de Port-aux-Ales, je l'ai déjà bue.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1033:0:1"
msgid "Is this about your hidden<br>stash of aleport stout?<br>Because I already drank it."
msgstr "Это про твой тайный запас<br>портского эля? А то я его<br>уже выпил."

#. ja: シケた所だぜ
#. de: Nordwestlich von hier liegt der Goldbasar. Vom einstigen Glanz ist allerdings nicht mehr viel zu spüren.
#. fr: Au nord et à l'est, vous trouverez le Bazar doré... même s'il a bien changé.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1034:0:1"
msgid "To the north and west<br>you'll find the Golden<br>Bazaar...though it's lost<br>its former luster."
msgstr "К северу и западу отсюда<br>Золотой базар... да только<br>от былого блеска ничего<br>не осталось."

#. ja: …よォ
#. de: Was hast du hier zu suchen?
#. fr: Que venez-vous faire dans la caserne<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1035:0:1"
msgid "What business do you<br>have in the barracks?"
msgstr "Что тебе нужно<br>в казармах?"

#. ja: ゆっくりしてきな
#. de: Mach hier ja keinen Ärger, klar?!
#. fr: On veut pas de bagarres au bar, compris<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1036:0:1"
msgid "I'd remind you there's<br>no brawling in the pub,<br>but you don't seem<br>the listening type."
msgstr "Я бы напомнил, что в пабе<br>драться нельзя, да ты, похоже,<br>всё равно не слушаешь."

#. ja: クエッ
#. de: Kweh?
#. fr: Kwé<nbsp>?
msgctxt "Balloon:1037:0:1"
msgid "Kweh?"
msgstr "Кве?"

#. ja: んがーっ！
#. de: „Lass den Roegadyn das machen“, haben sie gesagt. Pah!
#. fr: “Que le Roegadyn le porte,” qu'ils disent. Bah<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1038:0:1"
msgid "“Let the Roegadyn<br>carry it,” they say. Bah!"
msgstr "«Пусть Рогадин тащит»,<br>говорят. Пф!"

#. ja: 働けど働けど…
#. de: Arbeit, nichts als Arbeit ...
#. fr: Laisse-<if $gn4>la<else>le</if> tranquille. On a pas besoin des lames de cuivre ici.
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1039:0:1"
msgid "Let <if $gn4>her<else>him</if> be, you fool.<br>We don't need the Brass<br>Blades up here."
msgstr "Оставь <if $gn4>её<else>его</if> в покое, болван.<br>Медные Клинки нам<br>здесь не нужны."

#. ja: 今度はどんな厄介ごとだ？
#. de: Wer hat dich reingelassen!?<br>Raus! Sofort!
#. fr: Qui vous a permis d'entrer<nbsp>!? Dehors<nbsp>! Maintenant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1040:0:1"
msgid "Who let you in here!?<br>Out! Now!"
msgstr "Кто тебя сюда впустил!?<br>Вон! Живо!"

#. ja: 次の偵察は…
#. de: Ich bleibe schön hier im Schatten, vielen Dank.
#. fr: Je vais juste rester là, dans l'ombre, merci.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1041:0:1"
msgid "I'll be stayin' right here<br>in the shade, thank you."
msgstr "Я лучше тут, в тени,<br>посижу, спасибо."

#. ja: 懲りねーなぁ
#. de: Du bist so dumm wie dein Schwert breit ist.
#. fr: Bien sûr que oui.
msgctxt "Balloon:1042:0:1"
msgid "Of course you did."
msgstr "Ну конечно."

#. ja: また例の商人が…
#. de: Ich spalte dir deine Rübe entzwei!
#. fr: Je lui fends la tête en deux<nbsp>!
msgctxt "Balloon:1043:0:1"
msgid "I clove his head in two!"
msgstr "Я ему голову раскроил!"

#. ja: アマルジャなんて怖かねぇよ！
#. de: Redest du immer noch?
#. fr: Encore en train de parler<nbsp>?
msgctxt "Balloon:1046:0:1"
msgid "You still talkin'?"
msgstr "Ты ещё болтаешь?"

#. ja: さすがだぜ！
#. de: Nach dem Vierten wusste ich, ich bin erledigt.
#. fr: Quand le quatrième est arrivé, j'ai su que j'étais fichu.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1047:0:1"
msgid "When the fourth came<br>I knew I was done for."
msgstr "Когда появился четвёртый,<br>я понял, что мне конец."

#. ja: もう死体だろ
#. de: Das war nicht meine beste Entscheidung.
#. fr: P'têt' bien que j'ai pas vraiment réfléchi.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1048:0:1"
msgid "I may not've been<br>usin' me best judgment."
msgstr "Похоже, я не лучшим<br>образом соображал."

#. ja: でも…
#. de: Wie konntest du nur!?<br>Sie ist meine beste Freundin!
#. fr: Comment t'as pu<nbsp>!? C'est ma meilleure amie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1049:0:1"
msgid "How could you!?<br>She's my best friend!"
msgstr "Как ты мог!?<br>Она моя лучшая подруга!"

#. ja: 未使用：荒：会話00727
#. de: Meine Lenden pochen wie Dalamud! Mein Herz brennt wie Megaflare!
#. fr: 未使用：荒：会話00727
msgctxt "Balloon:1050:0:1"
msgid "未使用：荒：会話00727"
msgstr "未使用：荒：会話00727"

#. ja: 未使用：荒：会話00728
#. de: Hach, du bist immer so wortgewandt!
#. fr: 未使用：荒：会話00728
msgctxt "Balloon:1051:0:1"
msgid "未使用：荒：会話00728"
msgstr "未使用：荒：会話00728"

#. ja: へいらっしゃい
#. de: Kann ich dir etwas bringen, <if $gn4>meine Liebe<else>mein Lieber</if>?
#. fr: Tu as besoin de quelque chose, mon cœurrr<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1052:0:1"
msgid "Anything I can<br>get you, love?"
msgstr "Чего желаете, милый?"

#. ja: やってられるか～
#. de: Warum geht diese verdammte Tür nicht auf!? \<hicks>
#. fr: Pourquoi c'te maudite porte veut pas s'ouvrir<nbsp>! Hic<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1053:0:1"
msgid "Why won't this gods-<br>damned door open!? Hic!"
msgstr "Почему эта чёртова<br>дверь не открывается!? Ик!"

#. ja: ふんふ～ん♪
#. de: Dass ich die Suppe mit Hyänenschweiß gestreckt habe, merkt bestimmt niemand!
#. fr: Un seul mot à propos de mon tablier et vous serez sur le menu.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1054:0:1"
msgid "One word about my apron<br>and you'll be on the menu."
msgstr "Скажешь хоть слово про мой фартук —<br>и сам окажешься в меню."

#. ja: むにゃ…
#. de: Nur noch fünf Minuten, Mama ...
#. fr: Prends-moi, Raubahn... Je suis ta Sulta... (ronfle)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1055:0:1"
msgid "Take me, Raubahn... I am<br>your sultana... \\<snore>"
msgstr "Возьми меня, Раубан... Я твоя<br>султана... \\<snore>"

#. ja: 早くウルダハに戻ろう
#. de: Ich wusste gleich, dass was nicht stimmt, als im Katalog von einem „aufstrebenden Ferienort“ die Rede war!
#. fr: Je me lasse du désert. Allons vers le nord.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1056:0:1"
msgid "I tire of the desert.<br>Let us head north."
msgstr "Надоела пустыня.<br>Давайте на север."

#. ja: どこだったっけ…
#. de: Warum denkt bei der Konstruktion dieser Leitern eigentlich niemand an Lalafell?
#. fr: Le Sommeil éternel, près d'un cimetière... Tu parles d'un nom engageant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1057:0:1"
msgid "I told him Eternal Sleep<br>wasn't the best name for<br>an inn built under a lich-<br>yard, but did he listen?"
msgstr "Я же говорил ему, что «Вечный сон» —<br>не лучшее название для постоялого<br>двора у кладбища. Но он меня послушал?"

#. ja: 教会に運びましょう
#. de: Wir sollten ihn entsorgen, bevor die Bussarde ihn riechen.
#. fr: Je conseille de le déplacer avant que les busards ne repèrent son odeur.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1058:0:1"
msgid "I suggest moving him<br>before the buzzards<br>catch his scent."
msgstr "Надо бы его перенести,<br>пока стервятники не учуяли."

#. ja: はい…
#. de: Wie kannst du nur so herzlos sein?!
#. fr: Tu es si froid...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1059:0:1"
msgid "How can you<br>be so cold!?"
msgstr "Как ты можешь<br>быть такой бессердечной!?"

#. ja: また2人も…
#. de: Vereint im Leben, vereint im Tod.
#. fr: Ensemble dans la vie, ensemble dans la mort.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1061:0:1"
msgid "Together in life,<br>together in death."
msgstr "Вместе при жизни,<br>вместе и после смерти."

#. ja: 妙な真似はするな
#. de: Komm nicht auf dumme Gedanken!
#. fr: Vous sentez la mort. Vous venez des ruines, pas vrai<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1062:0:1"
msgid "You smell of the dead.<br>Been to the ruins, eh?"
msgstr "От тебя мертвечиной несёт.<br>В развалинах был, а?"

#. ja: むむむ…
#. de: Heut mach ich den Fang meines Lebens, ich hab's im linken Zeh!
#. fr: Je t'attraperai un jour<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1063:0:1"
msgid "I'll catch you<br>one day, Ness!"
msgstr "Я тебя ещё поймаю,<br>Несс!"

#. ja: 未使用：荒：会話00741
#. de: Dein Vater wird mir fehlen. Er war immer so großzügig.
#. fr: 未使用：荒：会話00741
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1064:0:1"
msgid "Your father will be<br>missed. He was most<br>generous with his<br>donations."
msgstr "Мы будем скучать по твоему отцу.<br>Он щедро жертвовал."

#. ja: 未使用：荒：会話00742
#. de: Band 32 fehlt!
#. fr: 未使用：荒：会話00742
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1065:0:1"
msgid "The thirty-second<br>volume is missing!"
msgstr "Тридцать второй том<br>пропал!"

#. ja: 厳しいな…
#. de: Ich glaube, es gab dort niemals Gold.
#. fr: Je crois pas qu'il y ait jamais eu de l'or.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1066:0:1"
msgid "I don't believe there<br>ever was any gold."
msgstr "Не верю, что там вообще<br>когда-нибудь было золото."

#. ja: 次はもっと奥を掘る
#. de: Zwei Wochen Plackerei und nicht ein Brocken ist dabei rumgekommen!
#. fr: Deux semaines à creuser, et rien du tout<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1067:0:1"
msgid "A fortnight of digging,<br>and not a single onze!"
msgstr "Две недели копали —<br>и ни унции не нашли!"

#. ja: クズ石はわけたよな？
#. de: Noch mehr Müll aus der Stadt? Hier rüber.
#. fr: D'autres gravats sans valeur de la Cité invisible<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1068:0:1"
msgid "More rubble from the<br>city? Over there."
msgstr "Опять хлам из города?<br>Вон туда складывай."

#. ja: 気を抜くなよ
#. de: Die Toten fühlen keinen Schmerz. Merk dir das für deinen nächsten Kampf.
#. fr: Les morts n'ont pas mal. Pensez-y quand vous coupez la tête de quelqu'un.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1069:0:1"
msgid "The dead feel no pain.<br>Remember that when<br>you slice off one's head."
msgstr "Мёртвые боли не чувствуют.<br>Помни об этом, когда<br>будешь кому-нибудь голову рубить."

#. ja: 市に活気を戻しましょう
#. de: Wir müssen den Goldbasar wieder zu dem machen, was er mal war!
#. fr: Le hameau doit retrouver son éclat d'antan<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1070:0:1"
msgid "The hamlet must be re-<br>stored to its former luster!"
msgstr "Посёлку пора вернуть<br>прежний блеск!"

#. ja: 旦那ったら…
#. de: Er ist vor drei Sonnen<br>Richtung Ruinen<br>aufgebrochen, aber ...
#. fr: Ça fait trois jours que mon mari est parti vers les ruines...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1071:0:1"
msgid "He left for the ruins<br>three suns past, but..."
msgstr "Он отправился в развалины<br>три солнца назад, но..."

#. ja: なんで私が…
#. de: Wieso bekomm eigentlich immer ich den Küchendienst aufgebrummt?
#. fr: Les ruines ne sont qu'à trois malms, et je reste pourtant ici...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1072:0:1"
msgid "The ruins are but mere<br>malms away, yet here I<br>stand and stir..."
msgstr "Развалины всего в паре миль,<br>а я тут стою и помешиваю..."

#. ja: 遺跡はロマンさ
#. de: Bist du auch hier, um Ruinen zu erforschen?
#. fr: Les secrets de la Cité invisible seront miens<nbsp>! Mais je vais d'abord manger du ragoût.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1073:0:1"
msgid "The Invisible City's<br>secrets will be mine!<br>After I sup on some stew."
msgstr "Тайны Невидимого города<br>будут моими!<br>После похлёбки, конечно."

#. ja: だといいけど
#. de: Das hast du beim letzten Mal auch gesagt ...
#. fr: Est-ce que ce maudit Roegadyn a fini le ragoût<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1074:0:1"
msgid "Has that blasted Roe-<br>gadyn finished the stew?"
msgstr "Этот проклятый Рогадин<br>уже доел похлёбку?"

#. ja: 確率は高い…
#. de: Diesmal bin ich mir hundert<shy>prozen<shy>tig sicher!
#. fr: Pourquoi on l'a pris avec nous, je ne le comprendrai jamais.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1075:0:1"
msgid "Why we dragged him<br>along, I'll never know."
msgstr "Зачем мы его с собой взяли,<br>ума не приложу."

#. ja: 霊銀を必ず…！
#. de: Hat jemand das verfluchte Mädel gesehn?
#. fr: Quelqu'un aurait vu cette maudite gueuse<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1076:0:1"
msgid "Anyone seen<br>the blasted wench?"
msgstr "Никто не видел<br>эту проклятую девку?"

#. ja: おうよ！
#. de: Wo sollen die hin?
#. fr: Vous les voulez où<nbsp>?
msgctxt "Balloon:1077:0:1"
msgid "Where you want these?"
msgstr "Куда это ставить?"

#. ja: 一攫千金だ
#. de: Ich gehe nicht in diese verfluchte Stadt zurück!
#. fr: Je retourne pas dans cette cité maudite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1078:0:1"
msgid "I ain't goin' back to<br>that accursed city!"
msgstr "Я ни за что не вернусь<br>в этот проклятый город!"

#. ja: お客…お客…
#. de: Bist du ganz allein hier?
#. fr: Vous êtes ici tout<if $gn4>e</if> seul<if $gn4>e</if><nbsp>?
msgctxt "Balloon:1079:0:1"
msgid "Here by your lonesome?"
msgstr "Один<if $gn4>а</if> тут?"

#. ja: お金…お金…
#. de: Vielleicht können wir das ändern ... aber das hat seinen Preis.
#. fr: Peut-être qu'on pourrait arranger ça. Pour un certain prix.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1080:0:1"
msgid "Might be that we could<br>fix that...for a price."
msgstr "Может, это можно устроить...<br>за отдельную плату."

#. ja: それでね～
#. de: Ich wusste doch, dass sie nicht einen Gil in der Tasche hat!
#. fr: Je <i>savais</i> qu'elle n'avait pas un gil<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1081:0:1"
msgid "I <i>knew</i> she hadn't<br>a gil to her name!"
msgstr "Я же <i>знала</i>, что у неё<br>ни гроша за душой!"

#. ja: やだ～
#. de: Und die Seidentunika? Die hat sie von einer Karawane gestohlen!
#. fr: Et cette tunique en soie<nbsp>? Elle l'a volée à une caravane<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1082:0:1"
msgid "And that silk tunic? She<br>swiped it from a caravan!"
msgstr "А шёлковую тунику? Её она<br>у каравана стащила!"

#. ja: 安心してね…
#. de: Ich werde dich rächen ...
#. fr: Je te vengerai...
msgctxt "Balloon:1083:0:1"
msgid "I will see you avenged..."
msgstr "Я отомщу за тебя..."

#. ja: み、見られてる…
#. de: Bleib bloß von den beiden weg. Ist gesünder ...
#. fr: Vous approchez pas de ces deux-là. Elles m'ont refilé des morpions<nbsp>! Vraiment<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1084:0:1"
msgid "Stay clear from them<br>two. Gave me the<br>crotch rot, they did!"
msgstr "С этими двумя лучше<br>не связывайся. Заразили<br>меня лобковыми вшами!"

#. ja: うむ、異常なし
#. de: Alles in trockenen Tüchern ... mal abgesehen von meinen Schuhen.
#. fr: Que je vous attrape pas en train de vous battre avec les Mhigois.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1088:0:1"
msgid "Don't let me catch you<br>fighting with the Mhigans."
msgstr "Смотрите у меня, не вздумайте<br>драться с мхигоанами."

#. ja: 腹減った…
#. de: Die Suppe braucht leider noch 'ne Weile.
#. fr: Encore du ragoût de cactuar...
msgctxt "Balloon:1092:0:1"
msgid "Cactuar stew again..."
msgstr "Опять тушёный кактуар..."

#. ja: わかってる、そんなの…
#. de: Mein Stolz macht wohl gerade Urlaub ...
#. fr: Non, pas du tout. Et c'est pas la peine de parler de notre héritage à chaque fois<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1094:0:1"
msgid "No. I haven't. And you<br>needn't bring up our<br>heritage each time I<br>disagree with you!"
msgstr "Нет, не забыл. И хватит<br>каждый раз поминать наше<br>наследие, когда я с тобой<br>не согласен!"

#. ja: 誇り高きアラミゴの血だ！
#. de: Lass dich nicht so hängen, Mann! Wir sind stolze Krieger aus Ala Mhigo!
#. fr: Est-ce que tu as oublié d'où on vient<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1095:0:1"
msgid "Have you forgotten<br>where we came from!?"
msgstr "Ты забыл, откуда мы родом!?"

#. ja: あんたも差別主義者？
#. de: Willst du auch, dass wir hier verschwinden?
#. fr: Vous venez vous moquer de nous, pas vrai<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1097:0:1"
msgid "Come here to<br>mock us, have ye?"
msgstr "Пришли над нами<br>посмеяться, да?"

#. ja: ふんっ！
#. de: 1370, 1371, 1372 ...
#. fr: Ne faites pas attention. Elle est comme ça avec tout le monde.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1098:0:1"
msgid "Do not mind her. It's not<br>that she hates <i>you</i>;<br>she hates <i>everyone</i>."
msgstr "Не обращайте на неё внимания. Она<br>ненавидит не <i>вас</i> — она ненавидит<br><i>всех</i>."

#. ja: 帰る場所などとうに無い！
#. de: Diese Schweine haben uns unsere Heimat genommen! Ich bring sie um, allesamt!
#. fr: J'ai déjà dit que j'avais pas l'argent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1100:0:1"
msgid "I told ye already─<br>I don't have the money!"
msgstr "Я же сказал вам уже —<br>денег у меня нет!"

#. ja: 落ち着け…
#. de: Jetzt beruhig dich doch mal ...
#. fr: On voudrait pas qu'il arrive quelque chose à cette jolie femme que tu as...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1101:0:1"
msgid "We wouldn't want any-<br>thing to happen to that<br>beautiful wife of yours..."
msgstr "Не хотелось бы, чтобы с твоей<br>красавицей-женой что-нибудь<br>случилось..."

#. ja: 古傷が…
#. de: Argh, meine alte Kriegsverletzung!
#. fr: C'est pas du somnus<nbsp>! (À moins que vous ne cherchiez du somnus.)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1103:0:1"
msgid "This ain't somnus!<br>(Unless you're lookin'<br>for some somnus.)"
msgstr "Это не сомнус!<br>(Если только вы не за сомнусом.)"

#. ja: 不滅隊の秘密特訓である！
#. de: Ich will eure Muskeln tanzen sehen, Männer!
#. fr: Vous devez apprendre à supporter la morsure du soleil si vous voulez devenir des Immortels<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1107:0:1"
msgid "To become an Immortal<br>Flame, you must first<br>learn to feel the <i>burn</i>!"
msgstr "Хочешь стать бойцом Пламени?<br>Сперва научись чувствовать,<br>как тебя <i>припекает</i>!"

#. ja: ハイッ！
#. de: Da guckste, was?
#. fr: Tu le sens<nbsp>?
msgctxt "Balloon:1111:0:1"
msgid "Can you feel it?"
msgstr "Чувствуешь?"

#. ja: ホイッ！
#. de: Ohne Aufputschmittel!
#. fr: Tu le sens<nbsp>?
msgctxt "Balloon:1114:0:1"
msgid "Can you feel it?"
msgstr "Чувствуешь?"

#. ja: セイッ！
#. de: Mein Bizeps heißt Berti!
#. fr: Je peux le sentir<nbsp>!
msgctxt "Balloon:1116:0:1"
msgid "I can feel it!"
msgstr "Я чувствую!"

#. ja: 気を引き締めろ！
#. de: Zeigt gefälligst Haltung!
#. fr: Vous avez vos ordres<nbsp>!
msgctxt "Balloon:1117:0:1"
msgid "You have your orders!"
msgstr "Вы получили приказ!"

#. ja: 露店なら奥だ
#. de: Tränke, fast geschenkt! Einfach diesen Tunnel entlang!
#. fr: Les baraques que vous cherchez sont au Malm du Minotaure.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1126:0:1"
msgid "The stalls you seek are<br>down the Minotaur Malm."
msgstr "Лавки, которые ищете,<br>там, у Минотаврового мили."

#. ja: ふざけたマネはするなよ
#. de: Keine Dummheiten, in Ordnung? Wir Mädels vom Drakon-Stamm sind ziemlich heißblütig, musst du wissen.
#. fr: Notre territoire est sacré. Souillez ces terres et vous nous offenserez tous.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1127:0:1"
msgid "Our territory is sacred.<br>Sully this land, and you<br>will have offended us all."
msgstr "Эта земля священна.<br>Оскверните её — и оскорбите<br>нас всех."

#. ja: 一発命中よ！
#. de: Ich hab ihn mit einem Schuss erledigt!
#. fr: On devrait demander à ces deux-là de se joindre à notre partie de chasse.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1131:0:1"
msgid "We should ask those two<br>to join our hunting party."
msgstr "Надо позвать тех двоих<br>на охоту."

#. ja: さすが～！
#. de: Was du nicht sagst!
#. fr: Mais le gros, il pue les vieilles bottes et la vinasse.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1132:0:1"
msgid "But the large one reeks<br>of boots and sour ale."
msgstr "Но от здоровяка несёт<br>старыми сапогами и кислым элем."

#. ja: つぎは何を獲ろうか
#. de: Und was sollen wir als Nächstes jagen?
#. fr: C'est une mauviette qui se soucie pas de son devoir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1133:0:1"
msgid "The nunh's a sop who<br>cares not about his <i>duty</i>!"
msgstr "Нунах — слабак, которому<br>плевать на свой <i>долг</i>!"

#. ja: 大きいのがいいな～
#. de: Egal, Hauptsache groß!
#. fr: Mais quelle crinière<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1134:0:1"
msgid "But that <i>mane</i>!"
msgstr "Но эта <i>грива</i>!"

#. ja: 敵の動きを読むの
#. de: Man muss jede Bewegung seines Gegners vorausahnen.
#. fr: Du calme. Ne fais qu'un avec l'arc et guide la flèche avec ton esprit.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1141:0:1"
msgid "Steady. Become one<br>with the bow and guide<br>the arrow with your soul."
msgstr "Спокойно. Стань единым целым<br>с луком и веди стрелу<br>силой духа."

#. ja: え、あ、あの…
#. de: G-Glaubst du, sie mag mich?
#. fr: Toute cette eau gaspillée pour ces minous. Quelle honte<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1142:0:1"
msgid "All this water wasted on<br>those kittens. Shame, it is."
msgstr "Столько воды зря извели<br>на этих котят. Позор."

#. ja: 次の獲物はね…
#. de: Du hättest seine Augen sehen sollen ... als ich ihm meine Köcherladung Pfeile reingejagt habe!
#. fr: Nous devons décider de notre prochaine proie...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1145:0:1"
msgid "When is your next<br>coupling, Sister?"
msgstr "Когда у тебя следующая<br>связка, сестрица?"

#. ja: よく焼けよ！
#. de: Medium bitte, Schätzchen!
#. fr: La viande doit être noire à l'extérieur, et rouge à l'intérieur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1146:0:1"
msgid "Make sure the beast's<br>black on the outside,<br>and bleedin' on the in!"
msgstr "Смотри, чтоб снаружи зверюга<br>почернела, а внутри<br>кровью истекала!"

#. ja: 魔物来るなよ…！
#. de: Der Felsen da ... der ist doch irgendwas am Planen dran!
#. fr: C'est l'heure de bouffer, ou bien<nbsp>?
msgctxt "Balloon:1148:0:1"
msgid "Is it time for grub, yet?"
msgstr "Ну когда уже жрать?"

#. ja: 目眩がするわね…
#. de: Bei dieser Hitze wird einem ganz schwindelig ...
#. fr: Ici, la chaleur est franchement in-su-ppor-table<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1156:0:1"
msgid "The heat out here is<br>positively unbearable!"
msgstr "Здесь такая жара —<br>просто невмоготу!"

#. ja: スグに砂が…
#. de: Ich kann diesen elenden Sand nicht mehr sehen ...
#. fr: Vaudrait mieux garder ces réflexions pour toi-même quand le chef est là<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1157:0:1"
msgid "Best keep that nonsense<br>to yerself while the<br>foreman's watchin'!"
msgstr "Лучше помалкивай<br>со своей чепухой, пока<br>смотритель рядом!"

#. ja: えっさ！ほいさ！
#. de: Ich auch nicht, hab nämlich die Augen voll davon!
#. fr: Ô puissant Byregot<nbsp>! Prête-nous ton marteau<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1161:0:1"
msgid "O mighty Byregot!<br>Lend us Your hammer!"
msgstr "О могучий Биргат!<br>Одолжи нам свой молот!"

#. ja: 消えろッァ！！
#. de: Verschwinde!
#. fr: Adieu<nbsp>!
msgctxt "Balloon:1324:0:1"
msgid "To us, all this forest belongs!"
msgstr "Весь этот лес принадлежит нам!"

#. ja: 死ねぇッァ！
#. de: Stirb!
#. fr: Crève<nbsp>!!
msgctxt "Balloon:1325:0:1"
msgid "To survive, no chance you have!"
msgstr "Тебе не выжить!"

#. ja: くらえ！
#. de: Friss das!
#. fr: Prends ça<nbsp>!
msgctxt "Balloon:1326:0:1"
msgid "For the elementals!"
msgstr "За элементалей!"

#. ja: こなくそ！
#. de: Argh!
#. fr: Grrr<nbsp>!
msgctxt "Balloon:1327:0:1"
msgid "Begone!"
msgstr "Проваливай!"

#. ja: これでもか！
#. de: Na, wie ist das?
#. fr: T'en veux encore<nbsp>?
msgctxt "Balloon:1328:0:1"
msgid "Take this!"
msgstr "На, получай!"

#. ja: とりゃ！
#. de: Ha!
#. fr: Rah<nbsp>!
msgctxt "Balloon:1329:0:1"
msgid "Ha!"
msgstr "Ха!"

#. ja: 消えろ！！
#. de: Hinfort mit dir!
#. fr: Disparais<nbsp>!
msgctxt "Balloon:1330:0:1"
msgid "Graaarrrgh!"
msgstr "Гра-а-а-ах!"

#. ja: 死ねぇ！
#. de: Stirb!
#. fr: Je vais te finir<nbsp>!
msgctxt "Balloon:1331:0:1"
msgid "Die, damn you!"
msgstr "Сдохни, проклятый!"

#. ja: くらえぃ！
#. de: Nimm dies!
#. fr: Raaargh<nbsp>!
msgctxt "Balloon:1332:0:1"
msgid "Raaargh!"
msgstr "Р-р-р-а-а-ах!"

#. ja: 王家のために！
#. de: Für die Sultana!
#. fr: Pour la Sultane<nbsp>!
msgctxt "Balloon:1333:0:1"
msgid "For the sultana!"
msgstr "За султаншу!"

#. ja: 若いもんには負けんぞ！
#. de: Einmal Palastwache, immer Palastwache!
#. fr: Les petits jeunes ne me font pas peur<nbsp>!
msgctxt "Balloon:1334:0:1"
msgid "Like carving a cake!"
msgstr "Мне такие — раз плюнуть!"

#. ja: せりゃ！
#. de: Hrgh!
#. fr: Yaaah<nbsp>!
msgctxt "Balloon:1335:0:1"
msgid "Ha!"
msgstr "Ха!"

#. ja: くらえ！
#. de: Ha!
#. fr: Yaah<nbsp>!
msgctxt "Balloon:1336:0:1"
msgid "Hyaaah!"
msgstr "Хья-а-а!"

#. ja: てやっ！
#. de: Der ist für dich!
#. fr: Ha<nbsp>!
msgctxt "Balloon:1337:0:1"
msgid "Ha!"
msgstr "Ха!"

#. ja: くたばれ！
#. de: Stirb!
#. fr: Crève<nbsp>!
msgctxt "Balloon:1338:0:1"
msgid "Die!"
msgstr "Сдохни!"

#. ja: やらせん！
#. de: Niemals!
#. fr: Tu rêves<nbsp>!
msgctxt "Balloon:1339:0:1"
msgid "Not on your life!"
msgstr "Не дождёшься!"

#. ja: 堕ちた海賊どもめ！
#. de: Elendes Piratenpack!
#. fr: Allez en enfer, pourritures<nbsp>!
msgctxt "Balloon:1340:0:1"
msgid "Traitorous snakes!"
msgstr "Предательские змеи!"

#. ja: 成敗してくれる！
#. de: Es geht um alles oder nichts!
#. fr: Fais tes prières<nbsp>!
msgctxt "Balloon:1341:0:1"
msgid "You're mine!"
msgstr "Ты мой!"

#. ja: どりゃ！
#. de: Argh!
#. fr: Yaaargh<nbsp>!
msgctxt "Balloon:1342:0:1"
msgid "Yaaargh!"
msgstr "Я-а-арх!"

#. ja: ヒーハー！！
#. de: Hiyaaah!
#. fr: Yahaaa<nbsp>!
msgctxt "Balloon:1343:0:1"
msgid "Rargh!"
msgstr "Ра-арг!"

#. ja: これでどう？
#. de: Wie schmeckt dir das?
#. fr: Prends ça<nbsp>!
msgctxt "Balloon:1344:0:1"
msgid "Down with you!"
msgstr "Долой тебя!"

#. ja: せやっ！
#. de: Den gibt's gratis!
#. fr: Ha<nbsp>!
msgctxt "Balloon:1345:0:1"
msgid "Ha!"
msgstr "Ха!"

#. ja: 飛空艇は我々の物だ！
#. de: Das Luftschiff gehört uns!
#. fr: Cette technologie appartient à l'Empire<nbsp>!
msgctxt "Balloon:1346:0:1"
msgid "This technology belongs to the Empire!"
msgstr "Эта технология принадлежит империи!"

#. ja: 飛空艇を取り戻せ！
#. de: Sichert das Luftschiff!
#. fr: Reprenez cet aéronef<nbsp>!
msgctxt "Balloon:1347:0:1"
msgid "Get that airship back!"
msgstr "Верните дирижабль!"

#. ja: 帝国軍め！
#. de: Garleischer Abschaum!
#. fr: Impériaux de malheur<nbsp>!
msgctxt "Balloon:1348:0:1"
msgid "Imperial curs!"
msgstr "Проклятые имперцы!"

#. ja: エオルゼアから<br>出て行け！
#. de: Für Eorzea!
#. fr: Pour Éorzéa<nbsp>!
msgctxt "Balloon:1349:0:1"
msgid "For Eorzea!"
msgstr "За Эорзею!"

#. ja: 目つぶしだ、オラッ！
#. de: Augen zu und durch!
#. fr: Qu'est-ce que vous voyez maintenant<nbsp>? Rien<nbsp>! Rien du tout<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1350:0:1"
msgid "What do you see now?<br>Nothin'! Nothin' at all!"
msgstr "Ну что видишь?<br>Ничего! Вообще ничего!"

#. ja: くたばれ！
#. de: Stirb!
#. fr: J'vais t'saigner<nbsp>!
msgctxt "Balloon:1351:0:1"
msgid "Bleed fer me!"
msgstr "Истекай за меня кровью!"

#. ja: そらよ！
#. de: Argh!
#. fr: Raaah<nbsp>!
msgctxt "Balloon:1352:0:1"
msgid "Yargh!"
msgstr "Йа-арх!"

#. ja: これでも喰らいやがれぇ！
#. de: Arrr, mal sehen, wer zuletzt lacht!
#. fr: Personne ne passe<nbsp>!
msgctxt "Balloon:1353:0:1"
msgid "Ain't no bastard gettin' by me!"
msgstr "Ни одна сволочь мимо меня не пройдёт!"

#. ja: 貴様を倒す！<br>俺の命にかけてもなッ！
#. de: Ich bring dich um! Und wenn ich selbst dran glauben muss!
#. fr: C'en est fini, Leavold<nbsp>!
msgctxt "Balloon:1354:0:1"
msgid "It ends here, Leavold!"
msgstr "Здесь тебе конец, Ливолд!"

#. ja: オラァ！
#. de: Ha!
#. fr: Aaargh<nbsp>!
msgctxt "Balloon:1355:0:1"
msgid "Raaar!"
msgstr "Ра-а-ар!"

#. ja: どうした、その程度かアルディス！
#. de: Ist das alles, Aldis?
#. fr: Aldiiis<nbsp>!
msgctxt "Balloon:1356:0:1"
msgid "ALDIIIS!"
msgstr "АЛДИ-И-ИС!"

#. ja: 闇を謳い…死を言祝げ…！
#. de: Die Finsternis besingend ... bringe ich Tod über euch!
#. fr: Je chante les ténèbres... et appelle votre MORT<nbsp>!
msgctxt "Balloon:1357:0:1"
msgid "Darkness attends the banquet of your DEMISE!"
msgstr "Тьма ждёт пира на твоей ПОГИБЕЛИ!"

#. ja: 今朝釣ったサカナだよ～！
#. de: Fische so frisch, dass sie fast noch zappeln!
#. fr: Dorades, morues et lamproies, toutes fraîches de ce matin.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1358:0:1"
msgid "Bream, cod, an' lampreys,<br>caught fresh this morn."
msgstr "Лещи, треска и миноги,<br>сегодняшний улов."

#. ja: どれどれ…
#. de: Zeig mal her!
#. fr: Qui serait assez dingue pour manger une sale lamproie<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1359:0:1"
msgid "Who in their right mind'd<br>eat a bleedin' lamprey?"
msgstr "Кто в здравом уме станет<br>жрать эту чёртову миногу?"

#. ja: 活きがいいねぇ
#. de: Igitt!
#. fr: Je prendrai trois lamproies<nbsp>!
msgctxt "Balloon:1360:0:1"
msgid "I'll take three lampreys!"
msgstr "Мне три миноги!"

#. ja: 海で嵐にあってねぇ
#. de: Auf See sind wir in einen schweren Sturm geraten!
#. fr: Il y a largement de quoi se faire de l'argent dans le Thanalan<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1362:0:1"
msgid "There's more than<br>enough opportunity for<br>profit in Thanalan!"
msgstr "В Таналанe и так<br>хватит возможностей<br>нажиться!"

#. ja: 無事だなんてステキ
#. de: Zum Glück ist dir nichts passiert.
#. fr: Et moi je dis qu'il y a des gils à gagner à Limsa Lominsa.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1363:0:1"
msgid "And I say there's gil<br>for the takin' in Limsa."
msgstr "А я говорю, в Лимсе<br>полно гилей, бери не хочу!"

#. ja: お土産は？
#. de: U-Und die Souvenirs für mich?
#. fr: En tout cas, on fait pas d'argent du tout en restant ici.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1364:0:1"
msgid "Well, we aren't making<br><i>any</i> coin just sitting here."
msgstr "Да мы тут так<br><i>вообще</i> ни гроша не заработаем."

#. ja: そんなことないですって
#. de: So ein Unsinn!
#. fr: Je ne crois pas que je supporterai une nuit de plus.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1366:0:1"
msgid "I don't think I can<br>bear another night."
msgstr "Не думаю, что вынесу<br>ещё одну ночь."

#. ja: アタイ知らない～っと
#. de: In der Kürze liegt die Würze, was?
#. fr: T'aimes cette hache<nbsp>? Approche donc et j'te la montrerai en grrros plan.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1367:0:1"
msgid "Like the axe? Why not<br>take a step closer?"
msgstr "Нравится топор? Подойди<br>поближе — покажу."

#. ja: こっち見んな！！
#. de: Was glotzt du so?
#. fr: Dégage avant que je te casse les dents<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1368:0:1"
msgid "We's can give<br>ye a problem."
msgstr "Мы можем<br>тебе проблем подкинуть."

#. ja: バッカじゃねーの
#. de: Geschieht dem Typ recht!
#. fr: Qu'est-ce qu'on s'fait chier, ici... (soupire)
#. macro: <if $gn4><br>Where've <i>you</i> been, lass?</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1369:0:1"
msgid "I smells me a man.<if $gn4><br>Where've <i>you</i> been, lass?</if>"
msgstr "Чую, мужиком запахло.<if $gn4><br>Где ж ты пропадала, <i>красотка</i>?</if>"

#. ja: 痛い目見たいのかい？
#. de: Es sei denn, du stehst auf Schmerzen ...
#. fr: T'as un prrroblème<nbsp>?
msgctxt "Balloon:1370:0:1"
msgid "'Ave a problem wiv that?"
msgstr "Тебе что-то не нравится?"

#. ja: 寄るんじゃないよっ！
#. de: Schwirr ab!
#. fr: Pourquoi on est assises comme ça<nbsp>? Tu vois des chaises dans le coin<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1371:0:1"
msgid "Why we sittin' like this?<br>Ye see any bleedin' chairs?"
msgstr "Чего это мы так сидим?<br>Стулья тут, что ли, есть?"

#. ja: どーせアタイのせいさ…
#. de: Buhu ... Das ist alles meine Schuld!
#. fr: Je te donne pas le choix. Sers une autre assiette d'huîtres à ce garçon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1372:0:1"
msgid "I'm not giving you a<br>choice. Get this boy<br>another plate of oysters!"
msgstr "Я не оставлю тебе<br>выбора. Принеси этому мальчику<br>ещё тарелку устриц!"

#. ja: いいことしましょ～？
#. de: Brauchst du noch 'n Ankerplatz für die Nacht, Matrose?
#. fr: Tu pensais pouvoir t'en tirer avec deux filles timides, pas vrai<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1375:0:1"
msgid "Thought ye'd 'ave yer<br>way with a pair of<br>blushin' maids, did ye?"
msgstr "Думал, что уложишь<br>двух скромниц, а?"

#. ja: うふふふ
#. de: Sei gewarnt, der Seegang ist rau, mein Lieber. \<kicher>
#. fr: Vide donc ta bourse avant qu'on t'les coupe.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1376:0:1"
msgid "Now empty your purse<br>afore we slice yer wick<br>and toss it brine-wise."
msgstr "А теперь выкладывай кошелёк,<br>пока мы тебе фитиль не перерезали<br>и не пустили его по волнам."

#. ja: でへへへ
#. de: Wenn ihr mein Schiff vertaut, immer doch, die Damen!
#. fr: Qu'est-ce que j'ai fait pour mériter ça<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1377:0:1"
msgid "What did I do<br>to deserve this!?"
msgstr "За что мне всё это?!"

#. ja: もうすんなよっ！
#. de: Aber mal echt!
#. fr: T'en as eu assez<nbsp>!?
msgctxt "Balloon:1379:0:1"
msgid "Ye had enough!?"
msgstr "Хватит уже?!"

#. ja: 税関はどこだ…
#. de: Macht mal hin, ich krieg allmählich lange Arme hier!
#. fr: Est-ce qu'un de vous pourrait la fermer et prendre cette porte<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1380:0:1"
msgid "Would one of ye shut yer<br>yap and grab that door?"
msgstr "Кто-нибудь из вас может<br>заткнуться и взяться за дверь?"

#. ja: 積荷検査の待ち時間は？
#. de: Die Prüfung dauert zwei Wochen? Bis dahin bin ich bankrott!
#. fr: À qui dois-je m'adresser pour que mon bateau sorte de sa quarantaine<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1381:0:1"
msgid "Who must I speak<br>with to have my ship<br>unquarantined?"
msgstr "С кем мне поговорить,<br>чтобы мой корабль<br>выпустили из карантина?"

#. ja: 税率高いのう…
#. de: So hohe Zölle?! Das ist ja Wucher!
#. fr: Combien pour les citrons soleil<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1382:0:1"
msgid "How much is the tariff<br>for sun lemons, woman?"
msgstr "Сколько пошлина<br>на лимоны, сударыня?"

#. ja: うりゃぁぁぁ！
#. de: Nenn mich nicht noch mal Harry!
#. fr: Tu vas payer pour ça<nbsp>!
msgctxt "Balloon:1384:0:1"
msgid "You'll pay for that!"
msgstr "Ты за это заплатишь!"

#. ja: ひゅーひゅー
#. de: Lass dir das nicht gefallen, Hering!
#. fr: Regardez les tourtereaux<nbsp>!
msgctxt "Balloon:1385:0:1"
msgid "Look at the lovebirds!"
msgstr "Глядите, голубки!"

#. ja: いいぞハハハーッ
#. de: Für die Ehre der Knochenfische!
#. fr: Embrassez-vous et basta<nbsp>!
msgctxt "Balloon:1386:0:1"
msgid "Kiss an' be done with it!"
msgstr "Поцелуйтесь — и дело с концом!"

#. ja: ほら来いや！
#. de: Ich mach Rollmops aus dir, Harry!
#. fr: J'ai essayé, mais ta mère a dit que c'était la maison qui payait<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1387:0:1"
msgid "I tried, but yer ma said<br>it was on the house!"
msgstr "Я пытался, да твоя мамаша сказала,<br>что угощает заведение!"

#. ja: やれやれ！
#. de: Polier ihm den Bugspriet, Salziger Hering!
#. fr: Ha ha ha ha<nbsp>!
msgctxt "Balloon:1388:0:1"
msgid "Gah hah hah hah hah!"
msgstr "Га-ха-ха-ха-ха!"

#. ja: 腕がなるな
#. de: Pah, an mir stochert der sich die Spähne aus!
#. fr: Cet imbécile aurait aussi bien fait de me frapper avec un livre.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1389:0:1"
msgid "That fool would've<br>done as well to slap<br>me with a book."
msgstr "Этому дураку стоило<br>шлёпнуть меня книжкой —<br>вышло бы не хуже."

#. ja: 次も手ごわいらしいわ
#. de: Dieser Pikenier soll nur mit einem Zahnstocher bewaffnet Titan niedergerungen haben ...
#. fr: Ben, c'était un érudit, tu sais...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1390:0:1"
msgid "Um, he <i>was</i> a<br>scholar, you know..."
msgstr "Ну, он же <i>был</i><br>учёным, знаешь ли..."

#. ja: 生身の人相手だもんね
#. de: Der Nervenkitzel beim Kampf gegen erfahrene Abenteurer aus Fleisch und Blut ist unübertroffen.
#. fr: Rien m'excite autant que de me friter pour de vrai avec un confrère aventurier.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1391:0:1"
msgid "Nothin' turns me on like<br>goin' hard at it with a<br>fellow 'venturer."
msgstr "Ничто меня так не заводит,<br>как хорошая драка<br>с другим искателем приключений."

#. ja: うーん釣れないな…
#. de: Du solltest dir endlich mal einen angeln gehen, und nicht immer zu Hause rumhocken, haben meine Freundinnen gesagt.
#. fr: Eh ben, ça mord pas des masses...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1392:0:1"
msgid "I come for the view,<br>I stay for the fish."
msgstr "Пришёл полюбоваться видом,<br>а остался ради рыбки."

#. ja: …………見えた！
#. de: Denkst du nicht, du hast langsam genug an der Sehne rumgezupft?
#. fr: Ah, je sais... J'ai compris quelle est la stratégie ultime<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1393:0:1"
msgid "\\<gasp> ...I have it!<br>The <i>ultimate</i> strategy!"
msgstr "\\<gasp> ...Понял!<br>Вот она, <i>величайшая</i> стратегия!"

#. ja: 殺気あふれて…異常なし！
#. de: Die Brise duftet nach Salz - und einer Prise Mordlust. Also alles wie gehabt.
#. fr: Y a rien d'mieux que l'odeur mélangée du sang, d'la sueur et de la mer.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1394:0:1"
msgid "Ain't nothin' like the smell<br>o' blood, sweat, an' brine."
msgstr "Нет ничего лучше запаха<br>крови, пота и морской соли."

#. ja: よし…順調だな…
#. de: Sehr schön. So darf's weitergehen.
#. fr: Bouahaha<nbsp>! Personne ne peut nous arrêter<nbsp>!
msgctxt "Balloon:1395:0:1"
msgid "Gahaha! We're unstoppable!"
msgstr "Га-ха-ха! Нас не остановить!"

#. ja: うちの連中…また勝ちだ
#. de: Unser Mann ... hat schon wieder gewonnen.
#. fr: Ouais<nbsp>! On a encore gagné<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1396:0:1"
msgid "Great, now that you<br>went and said <i>that</i>..."
msgstr "Отлично. Ну вот, теперь<br>ты ещё и <i>сглазил</i>..."

#. ja: む、ワインが…
#. de: \<grummel> ... Mein Wein ...
#. fr: Argh<nbsp>! Mon vin...
msgctxt "Balloon:1397:0:1"
msgid "Ack, the wine..."
msgstr "Ох, вино..."

#. ja: 傷んでるな…
#. de: Verdammt, tut das weh ...
#. fr: On dirait bien qu'il a pris quelques coups au passage.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1398:0:1"
msgid "Took a few bumps<br>in transit, looks like."
msgstr "Похоже, по дороге<br>его потрепало."

#. ja: 登るなよ…
#. de: Komm sofort runter da, hörst du?
#. fr: Si t'as l'intention de grimper là-d'ssus, j'te conseille d'arrêter tout d'suite...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1399:0:1"
msgid "If you're thinking of<br>climbing that...<i>don't</i>."
msgstr "Если собрался туда лезть...<i>не надо</i>."

#. ja: また乱れてる…
#. de: Wieder alles durcheinander ...
#. fr: Non, mais regardez-moi ce chantier...
msgctxt "Balloon:1400:0:1"
msgid "All messed up again..."
msgstr "Опять всё вверх дном..."

#. ja: 今回はマシでした…
#. de: Dieses Mal gibt's kein Grund zu klagen.
#. fr: C'était un de nos meilleurs matches... bien que le résultat soit toujours le même.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1401:0:1"
msgid "That was one of our better<br>outings. Which isn't saying<br>much, unfortunately..."
msgstr "Это была одна из наших<br>лучших вылазок. Что, увы,<br>не о многом говорит..."

#. ja: よく食うブタだな
#. de: Wenn du weiter so viel frisst, können wir dich bald als Rettungsboot einsetzen ...
#. fr: Tu mangerais ta propre mère si on la cuisinait<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1452:0:1"
msgid "Ye'd probably et yer own<br>ma if we cooked the hag."
msgstr "Ты бы, пожалуй, и родную<br>мать сожрал, приготовь мы её."

#. ja: サカナ～サカナだよ～
#. de: Fisch! Frischer Fisch!
#. fr: Des délices de Llymlaen<nbsp>! Tout droit de ses profondeurs salées<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1534:0:1"
msgid "Fruits of the Navigator's<br>loins! Straight from the<br>depths of Her salty womb!"
msgstr "Плоды чрева Покровительницы мореплавателей!<br>Прямо из её солёных<br>глубин!"

#. ja: 網倉はっと…
#. de: Wo ging's noch mal gleich zum Fischers Bodden?
#. fr: Ô Llymlaen<nbsp>! Permets-moi d'arriver vivant à L'Escale du pêcheur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1535:0:1"
msgid "O Llymlaen! See me safe<br>to Fisherman's Bottom!"
msgstr "О, Льмлин! Доведи меня целым<br>до Рыбацкого дна!"

#. ja: 姉ちゃん10匹
#. de: Zehn Stück für mich, meine Gute.
#. fr: Donne-m'en dix<nbsp>! Non, vingt<nbsp>!
msgctxt "Balloon:1536:0:1"
msgid "Give me ten! No, twenty!"
msgstr "Дай мне десять! Нет, двадцать!"

#. ja: おすすめは？
#. de: Ist er so <i>frisch</i> wie beim letzten Mal, als der Gestank selbst meinem chronisch verschnupften Mann die Nase freigeätzt hat?
#. fr: Euh... Je passe mon tour.
msgctxt "Balloon:1537:0:1"
msgid "Uh...I think I'll pass."
msgstr "Э... пожалуй, не буду."

#. ja: どれにしよっかな…
#. de: Hm, die Qual der Wahl ...
#. fr: Mmm... Des fruits...
msgctxt "Balloon:1538:0:1"
msgid "Mmm... Loinfruit..."
msgstr "М-м-м... дальнеплоды..."

#. ja: いい釣竿だなぁ
#. de: Nicht, dass ich schummeln will, aber ob die hier auch Richterruten führen?
#. fr: C'est une belle canne... Une <i>très</i> belle canne, même...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1540:0:1"
msgid "That's a fine rod.<br>A <i>fine</i> rod, indeed."
msgstr "Славная удочка.<br><i>Очень</i> славная."

#. ja: こりゃ珍しい…
#. de: Ganz schön seltenes Zeug haben die hier ...
#. fr: C'est plutôt cher pour à peine trois sacs.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1542:0:1"
msgid "That's quite the price<br>for a mere three bags."
msgstr "Дороговато<br>за всего три мешка."

#. ja: どうするの～？
#. de: Nein, danke.
#. fr: C'est ce que me disent tous mes clients.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1548:0:1"
msgid "That's what all my<br>customers tell me."
msgstr "Так мне говорят все<br>покупатели."

#. ja: さっすが～あははは
#. de: Gib's auf, Zitternde Mücke! Dir springen doch selbst die Würmer vom Haken!
#. fr: Tu ferais mieux de repartir à la guilde pour t'astiquer le mât<nbsp>! Hé, hé, hé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1549:0:1"
msgid "Ye'd both do better back<br>in the guild polishin'<br>yer masts! Hah hah hah!"
msgstr "Вам обеим лучше вернуться<br>в гильдию да мачты<br>полировать! Ха-ха-ха!"

#. ja: ♪ヨホホィ酒飲め船漕げ♪
#. de: ♪ In der Achterburg, nachts um halb eins ♪
#. fr: Ce pont a vu plus de sang couler que n'importe quel homme dans l'pays<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1551:0:1"
msgid "The decks, they be<br>stained with the blood o'<br>more men than there be<br>in all o' Limsa."
msgstr "Эти палубы пропитаны<br>кровью большего числа людей,<br>чем во всей Лимсе."

#. ja: ♪ヨホホィ俺たちゃ海賊♪
#. de: ♪ Piraten brauchen keine Spaten, auch ohne stechen sie in See ♪
#. fr: On est p'têtre des pirates, mais on est pas des sauvages.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1552:0:1"
msgid "We may be pirates,<br>but we ain't uncivilized."
msgstr "Мы, может, и пираты,<br>но не дикари."

#. ja: 釣り上手じゃのぅ
#. de: Mir angelt keiner was vor!
#. fr: Moi j'attrape juste le poisson et elle s'occupe de la vente.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1554:0:1"
msgid "I just catch the fish and<br>leave the mongerin' to her."
msgstr "Я только рыбу ловлю,<br>а торговлю оставляю ей."

#. ja: サカナ買わない？
#. de: Orobon-Filets, nur heute für 5 Gil das Stück! (Ansonsten 2, hehe!)
#. fr: Qu'est-ce qui te ferait plaisir<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1555:0:1"
msgid "Greetin's, love. Aught I<br>can interest you in?"
msgstr "Привет, милашка. Не желаешь<br>чего-нибудь купить?"

#. ja: ここから上甲板層だ
#. de: Hier rauf gelangst du zu den Oberen Decks.
#. fr: Le Tillac est au-dessus.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1556:0:1"
msgid "The upper decks<br>lie above."
msgstr "Верхние палубы<br>наверху."

#. ja: この空を君に贈るよ
#. de: Der Himmel soll dir gehören, mein Liebes!
#. fr: J'ai les zygomatiques coincés et mon cœur brûle comme les flammes d'Ifrit<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1557:0:1"
msgid "My loins throb like<br>Dalamud! My heart<br>burns like Megaflare!"
msgstr "Чресла пульсируют,<br>как Даламу́д! Сердце<br>горит, как мега-вспышка!"

#. ja: バカ…ポッ
#. de: Deinen Himmel kannst du dir sonst wo hinschmieren ...
#. fr: Vous savez y faire avec les mots<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1558:0:1"
msgid "You have such a<br>way with words!"
msgstr "Ну ты и мастак<br>говорить!"

#. ja: 覚悟しなっ！
#. de: ... Da hab ich ihn halt 'nen Kopf kürzer gemacht.
#. fr: Les sirènes ont pas de temps à perdre avec les hommes, sauf pour réchauffer leurs lits.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1559:0:1"
msgid "The Sirens don't 'ave<br>time for men, unless<br>they's warmin' our beds."
msgstr "Сиренам не до мужчин,<br>разве что постель им<br>согреть."

#. ja: 毎日ドレスを着せてやる
#. de: Ich werde dich in die teuersten Gewänder von Haute Couture Sonnenseide kleiden!
#. fr: Me dites pas que vous n'en avez pas entendu parler<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1561:0:1"
msgid "Don't tell me you've not<br>heard of Thal Icebound!"
msgstr "Не говори, что не слышал<br>о Тале Ледяном!"

#. ja: へぇ、それで…？
#. de: Und mich dann entkleiden, was? Ne, ne, mein Lieber!
#. fr: Vous voulez que <i>je</i> chante une chanson sur <i>vos</i> exploits<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1562:0:1"
msgid "You wish <i>me</i> to sing a<br>song of <i>your</i> deeds?"
msgstr "Ты хочешь, чтобы <i>я</i><br>пела песню о <i>твоих</i> подвигах?"

#. ja: じゃあ5匹…全部だ！
#. de: Ein Sonderangebot? Ist gut, ich nehm sie alle!
#. fr: Il y a bien quelque chose... mais pas tes poissons en tout cas.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1563:0:1"
msgid "Might be there is.<br>But it ain't fishes."
msgstr "Может, и есть.<br>Только это не рыба."

#. ja: きゅいんきゅいん
#. de: Grrr ...
#. fr: Grrr...
msgctxt "Balloon:1585:0:1"
msgid "\\<yip> \\<yip> \\<yip>"
msgstr "\\<тяф> \\<тяф> \\<тяф>"

#. ja: 用意はいいか？
#. de: Bist du bereit, Fili?
#. fr: Allez, on se concentre...
msgctxt "Balloon:1586:0:1"
msgid "Focus, my pet..."
msgstr "Соберись, мой хороший..."

#. ja: 負けるかッ！
#. de: Nicht schlappmachen, Trixi!
#. fr: Émeraude éclatante<nbsp>! J'ai dit <i>Émeraude éclatante</i><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1587:0:1"
msgid "Shining Emerald!<br>I <i>said</i> Shining Emerald!"
msgstr "Сияющий изумруд!<br>Я <i>сказал</i>: Сияющий изумруд!"

#. ja: 行くぞッ！
#. de: Auf sie, Schnuffel!
#. fr: Attaque<nbsp>!
msgctxt "Balloon:1588:0:1"
msgid "Attack!"
msgstr "В атаку!"

#. ja: 造船師ってキッツイな
#. de: Sag mal, wie lange bist du eigentlich schon hier, Kollege?
#. fr: Pourquoi je dois porter mon armure pour ça<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1591:0:1"
msgid "Why'd I wear<br>my mail for this?"
msgstr "Зачем я вообще надел<br>кольчугу?"

#. ja: あ、あちぃ…
#. de: In Momenten wie diesen wünschte ich, mein Kettenhemd wäre atmungsaktiv.
#. fr: Je pense qu'on pourrait brûler à peu près n'importe quoi ici.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1593:0:1"
msgid "I reckon one could<br>burn just about anything<br>in there."
msgstr "Да там, пожалуй,<br>что угодно сгорит."

#. ja: よく乾いてるわ
#. de: Knochentrocken, die Stämme. Ausgezeichnet.
#. fr: Cet endroit est plus sec que le Thanalan.
msgctxt "Balloon:1594:0:1"
msgid "Dry as bones."
msgstr "Сухие, как кости."

#. ja: 情けねぇぞ～！！
#. de: Das wird dir 'ne Lehre sein, noch mal den Toffelschäldienst zu schwänzen!
#. fr: C'est pas des busards que je vois tourner dans le ciel<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1601:0:1"
msgid "Is them buzzards<br>I see a-circlin'?"
msgstr "Это что, стервятники<br>уже кружат?"

#. ja: ♪ヨホホィ分捕れ乗っ取れ♪
#. de: ♪ Eine Kaperfahrt ist lustig, eine Kaperfahrt ist schön ♪
#. fr: Si vous voulez mon avis, récurer c'est un boulot de rat.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1602:0:1"
msgid "Swabbin' be a rat's job,<br>if ye ask me."
msgstr "Палубу драить —<br>работа крысиная, как по мне."

#. ja: アタマ冷えたか～！？
#. de: Jetzt lass dich doch nicht so hängen, Kumpel!
#. fr: Dis-nous où t'as planqué le magot, sale avorton<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1603:0:1"
msgid "Tell us where ye hid<br>the loot, ye rotten scrag!"
msgstr "Говори, где спрятал<br>добычу, мерзкий коротышка!"

#. ja: 遅いぞ～！
#. de: Na, das geht aber noch 'n bisschen schneller!
#. fr: Ça te dit que je m'assoie sur ton dos, hein<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1606:0:1"
msgid "Like if I sat on<br>yer back, ox-breath?"
msgstr "Может, мне сесть<br>тебе на спину, бычье дыхало?"

#. ja: ほぁ…
#. de: Sind alle Mädels von den Goldtatzen so heiß?
#. fr: Je cherche la bagarre<nbsp>!
msgctxt "Balloon:1607:0:1"
msgid "I's lookin' for a fight!"
msgstr "Ищу драки!"

#. ja: 提督と面会したい
#. de: Ich muss mit dem Admiral sprechen, sofort!
#. fr: Je cherche l'Amirale<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1608:0:1"
msgid "I'm looking for<br>the Admiral!"
msgstr "Я ищу<br>адмирала!"

#. ja: てっぺんに行けるのか？
#. de: Wie kommt man hier auf die Oberen Decks?
#. fr: Je cherche le bureau des douanes.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1609:0:1"
msgid "I'm looking for<br>the custom house."
msgstr "Я ищу<br>таможню."

#. ja: ほら、行くぞ
#. de: Komm schon, wir finden die Gourmetgilde auch so irgendwie.
#. fr: Quand j'ai dit que je te suivrais jusqu'au bout du monde, je pensais que tu savais où tu allais.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1610:0:1"
msgid "When I said I'd follow you<br>to the ends of the realm,<br>I didn't think we'd need<br>to stop and ask directions."
msgstr "Когда я сказал, что пойду за тобой<br>хоть на край света,<br>я не думал, что придётся<br>останавливаться и спрашивать дорогу."

#. ja: 詳しく教えてくれ
#. de: Wie jetzt, Backbord hat doch nichts mit Brötchen zu tun? Das musst du mir noch mal erklären ...
#. fr: Par Llymlaen, où sont les aéronefs<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1611:0:1"
msgid "Where in the Navigator's<br>name are the airships!?"
msgstr "Во имя Мореплавательницы,<br>где дирижабли!?"

#. ja: 例のブツを50袋だ
#. de: Fünfzig Beutel von dem Zeug, aber dalli!
#. fr: Il me faut seize sacs de cette racine d'ici l'aube.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1612:0:1"
msgid "I need sixteen bags<br>of the root by sunrise."
msgstr "К рассвету мне нужно<br>шестнадцать мешков корня."

#. ja: ウマイのか…？
#. de: Nee, kann man das essen?
#. fr: À chaque instant.
msgctxt "Balloon:1613:0:1"
msgid "Not a moment I don't."
msgstr "Ни минутки без этого."

#. ja: 幸せって、なんだっけ…
#. de: He, Kumpel! Weißt du, was Glück ist?
#. fr: Déjà pensé à partir<nbsp>?
msgctxt "Balloon:1614:0:1"
msgid "Ever think of leavin'?"
msgstr "Не думал уйти отсюда?"

#. ja: この先どうするか…
#. de: Was soll bloß aus uns werden ...? \<seufz>
#. fr: C'est pas un endroit facile, Quartpierre, vraiment pas...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1615:0:1"
msgid "A damn hard place, this<br>Quarterstone. Damn hard."
msgstr "Чёртово трудное место,<br>этот Кварцстоун. Очень трудное."

#. ja: 酒持ってないかい…？
#. de: Hasse ma 'n Schluck füa mich übrich? Ich bin nämlich scho fass wieda nüchtan!
#. fr: J'ai vu un canari bleu<nbsp>! Un canari bleu, c'est vrai<nbsp>! Hic<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1617:0:1"
msgid "Saws me a blue canary!<br>A blue canary, it was! Hic!"
msgstr "Видал синюю канарейку!<br>Синюю канарейку, ей-богу! Ик!"

#. ja: 腹減った…
#. de: Kannst du vielleicht 'nen Happen Essen erübrigen?
#. fr: Qu'est-ce que je ne donnerais pas... Pour reprendre la mer...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1618:0:1"
msgid "To be back at sea...<br>What I wouldn't give..."
msgstr "Вернуться бы в море...<br>Отдал бы всё на свете..."

#. ja: 努力なんてムダさ…
#. de: Wozu anstrengen, wenn's eh nichts bringt?
#. fr: Encore un jour qui me rend plus vieille et plus endettée...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1619:0:1"
msgid "Another day older<br>and deeper in debt..."
msgstr "Ещё на день старше,<br>ещё глубже в долгах..."

#. ja: 許さんぞー！
#. de: Komm doch selber, du ...!
#. fr: T'en as assez<nbsp>?
msgctxt "Balloon:1621:0:1"
msgid "Had enough?"
msgstr "Ну что, хватит?"

#. ja: どうした来いや！
#. de: Komm doch, wenn du dich traust!
#. fr: Une brise marine m'a déjà frappé plus fort<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1622:0:1"
msgid "I've been hit harder<br>by an ocean breeze!"
msgstr "Меня и океанский бриз<br>сильнее бил!"

#. ja: ♪ヨホホィ俺たちゃ海賊♪
#. de: ♪ Sie tanzte wie eine Sirene ... ♪
#. fr: ♪ Nous, les pirates de bonne foi.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1626:0:1"
msgid "He lied there with her<br>in the dark,♪"
msgstr "Он лежал с ней рядом<br>во тьме... ♪"

#. ja: ♪ヨホホィ分捕れ乗っ取れ♪
#. de: ♪ ... wir nannten sie wilde Irene ♪
#. fr: ♪ On pille, on saccage dans la joie.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1627:0:1"
msgid "And not a word<br>was spoke...♪"
msgstr "И ни слова<br>не молвил... ♪"

#. ja: 海に戻りてぇ
#. de: Ich sehn mich nach Wellen und der salzigen Brise ...
#. fr: Mais qu'est-ce qu'on fout ici<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1630:0:1"
msgid "What in the Navigator's<br>name are we doin' here?"
msgstr "Во имя Мореплавательницы,<br>что мы здесь делаем?"

#. ja: ウェップゥ
#. de: \<rülps>
#. fr: Sans bateau, on est aussi utiles que des seins sur une dorade.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1631:0:1"
msgid "Wivout no ship, we's use-<br>less as teats on a flounder."
msgstr "Без корабля мы бесполезны,<br>как соски у камбалы."

#. ja: てめぇ！ぶっ殺す！
#. de: Ich bring dich um, du Schwein!
#. fr: Crève<nbsp>!
msgctxt "Balloon:1633:0:1"
msgid "Sneaky bastard!"
msgstr "Подлый ублюдок!"

#. ja: モルモーの壺が狙いか！？
#. de: Habt ihr es auf Mormos Urne abgesehen?
#. fr: Cette urne est à nous<nbsp>!
msgctxt "Balloon:1634:0:1"
msgid "You ain't havin' that urn!"
msgstr "Урну вам не отдам!"

#. ja: はぁ…ひぃ…ふぅ…
#. de: \<keuch> \<prust>
#. fr: (À l'aide...)
msgctxt "Balloon:1635:0:1"
msgid "(Help me...)"
msgstr "(Помогите...)"

#. ja: ふん、まだまだ
#. de: Eine Woche Kombüsenstrafdienst hat mir gereicht!
#. fr: Après toi, ma jolie.
msgctxt "Balloon:1636:0:1"
msgid "Right after you, lass."
msgstr "Давай за мной, красотка."

#. ja: もう諦めなよ
#. de: Mach bloß nicht schon schlapp!
#. fr: Pourquoi t'arrêtes pas, espèce de vieille barrique<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1637:0:1"
msgid "Why won't ye quit, ye<br>bloody sea cow!?"
msgstr "Чего не сдаёшься, ты,<br>проклятая морская корова!?"

#. ja: 次どこ行きます～？
#. de: Schon 'nen neuen Angelplatz in Aussicht?
#. fr: Et tous les Qiqirns alors<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1652:0:1"
msgid "But what of<br>all the Qiqirn?"
msgstr "А как же<br>все кикирны?"

#. ja: ソルトストランドはどうだい？
#. de: Am Salzstrand soll'n die Fischbestände reich sein!
#. fr: Il y a plein de poissons au large des atolls de sel.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1653:0:1"
msgid "There be fish aplenty<br>off the Salt Strand."
msgstr "У Солёного берега<br>рыбы полно."

#. ja: ほっほっほっ…
#. de: Ha, probier's doch mal mit deinem verlausten Kopftuch als Köder!
#. fr: Encore un peu plus près d'ici, mon petit chou.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1656:0:1"
msgid "A little more over<br>here, lemoncake."
msgstr "Ещё чуть-чуть сюда,<br>лимонный кексик."

#. ja: 今日こそ勝つ…
#. de: Noch mal verlier ich nicht gegen den Strohhut!
#. fr: Llymlaen me sourit aujourd'hui<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1657:0:1"
msgid "The Navigator smiles<br>upon me today!"
msgstr "Сегодня Мореплавательница<br>мне благоволит!"

#. ja: 押されてんぞー！？
#. de: Du liegst aber schon drei Forellen hinten!
#. fr: Elle se moque bien de ta prise ridicule, oui<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1658:0:1"
msgid "She's merely laughin'<br>at your paltry catch!"
msgstr "Она просто смеётся<br>над твоим жалким уловом!"

#. ja: 特技は？
#. de: Du fängst als Deckschrubber an! Wegtreten!
#. fr: Et pourquoi je devrais prendre un gringalet comme toi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1660:0:1"
msgid "And why should I take<br>on a scrag as yerself?"
msgstr "И зачем мне брать<br>такого заморыша, как ты?"

#. ja: マスト登りだっ！
#. de: A-Aye, Sir!
#. fr: Parce que je... euh... j'ai un bandeau<nbsp>?
msgctxt "Balloon:1661:0:1"
msgid "I...er...'ave an eyepatch?"
msgstr "Я... э-э... у меня повязка на глазу?"

#. ja: き、き、き、緊張する…
#. de: Ich hasse Bewerbungsgespräche ...
#. fr: (J'allais le dire.)
msgctxt "Balloon:1662:0:1"
msgid "(I was goin' to say that!)"
msgstr "(Я как раз это и хотел сказать!)"

#. ja: へぇ～やるじゃん
#. de: Für den Latrinendienst brauchen wir auch noch jemanden!
#. fr: Je veux le voir voler, Capitaine.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1664:0:1"
msgid "I want to see<br>him fly, Captain."
msgstr "Хочу посмотреть,<br>как он полетит, капитан."

#. ja: うふふふ…
#. de: Du kleiner Charmeur, du ...
#. fr: Eh bien, Monsieur, quelle est votre estimation<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1665:0:1"
msgid "Well then, milord,<br>what is your assessment?"
msgstr "Ну что ж, милорд,<br>каково ваше мнение?"

#. ja: うちの船に来ないか？
#. de: Bock auf 'ne Spritztour mit meiner Jolle, Baby?
#. fr: Je t'aime<nbsp>! Suis-moi et deviens ma maîtresse<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1666:0:1"
msgid "I love ye! Come<br>and be me saltwife!"
msgstr "Люблю тебя! Пойдём<br>со мной, станешь моей морской женой!"

#. ja: も…もう少し
#. de: Wo ist das Muttermal, sagst du?
#. fr: Je... J'suis contrôleur de corsets à la douane de Mealvaan.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1667:0:1"
msgid "I's a...a bodice assessor<br>wiv Mealvaan's Gate."
msgstr "Я... я оценщик корсетов<br>в таможне Мелваана."

#. ja: きゅるきゅる
#. de: \<fauch>
#. fr: (feule)
msgctxt "Balloon:1668:0:1"
msgid "   ???"
msgstr "???"

#. ja: きゅるるるぅ
#. de: \<knurr>
#. fr: (siffle)
msgctxt "Balloon:1670:0:1"
msgid "Hisss!"
msgstr "Шшшш!"

#. ja: 積荷を書いてください
#. de: Wenn du sie ordentlich versteuerst nicht.
#. fr: J'ai besoin que vous signiez ce bordereau d'importation<nbsp>.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1671:0:1"
msgid "I am going to need you<br>to sign this import slip."
msgstr "Мне нужно, чтобы вы<br>подписали эту импортную декларацию."

#. ja: 御禁制品ですから
#. de: Was soll ich machen, Lachkrötenleder steht nun mal auf der roten Liste ...
#. fr: Suggérez-vous que j'accepte un pot-de-vin, Madame<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1672:0:1"
msgid "Are you suggesting I<br>accept a <i>bribe</i>, madam?"
msgstr "Вы предлагаете мне<br>взять <i>взятку</i>, мадам?"

#. ja: ピカピカもりもりっちゃ
#. de: Glitzer, Glitzer! Ganz viel Glitzer!
#. fr: Cinq boîtes de clic clic, dix sacs de bijoux...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1673:0:1"
msgid "Five box o' sparklies...<br>Ten sack o' shinies..."
msgstr "Пять коробок блестяшек...<br>Десять мешков сияшек..."

#. ja: シュコォ…おけんさドキドキ
#. de: Unter<shy>such<shy>ung mir Angst machen ...
#. fr: Le gentil Gobelin a mal aux jambes à force de rester debout... Psshh<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1674:0:1"
msgid "Longstand makes gobbie-<br>legs shake and quake."
msgstr "Долго стоим — гобли-<br>ноги дрожат и трясутся."

#. ja: 我らの商品、は傭兵、だ
#. de: Ich will Sssöldner einführen. 'n Problem damit?
#. fr: Vous avez... plus grosse plume<nbsp>?
msgctxt "Balloon:1675:0:1"
msgid "Have you...bigger quill?"
msgstr "У вас... перо побольше есть?"

#. ja: 訓練中だ、静かにな
#. de: Wir trainieren hier unsere Karfunkel. Verhalte dich ruhig!
#. fr: Faites pas de bruit, ils ont besoin de rester concentrés.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1676:0:1"
msgid "Keep your voice low, lest<br>you disturb the summons."
msgstr "Потише, а то<br>потревожите призыв."

#. ja: 臨検の作戦は…
#. de: Wie sollen wir bei der Razzia vorgehen ...?
#. fr: Un espion avec une identité secrète<nbsp>? Ça pourrait bien marcher.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1677:0:1"
msgid "An undercover intelli-<br>gencer? It might just work."
msgstr "Внедрить разведчика<br>под прикрытием? Может сработать."

#. ja: おとり作戦とか
#. de: Vielleicht einen Lockvogel einsetzen?
#. fr: Et si on devait faire venir un contrôleur sur le bateau<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1678:0:1"
msgid "What if we were to plant<br>an assessor on the ship?"
msgstr "А если подсадить<br>оценщика на корабль?"

#. ja: はいはい宝石50箱っと…
#. de: Jaja, fünfzig Kisten mit Edelsteinen also, nicht wahr?
#. fr: Pourriez-vous être un peu plus <i>précis</i>, Monsieur<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1679:0:1"
msgid "Could you be any<br>more <i>specific</i>, sir?"
msgstr "Можно быть<br>ещё <i>конкретнее</i>, сэр?"

#. ja: はぁぁぁ！
#. de: Nein, du sollst nicht diese Kisten angreifen, zum Eufel noch mal!
#. fr: Fort bien<nbsp>! Il a repéré le tuberculait<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1681:0:1"
msgid "Very good! He's<br>located the milkroot!"
msgstr "Отлично! Он<br>нашёл молочный корень!"

#. ja: 受付は、この先です！
#. de: Die Warenprüfung findet weiter hinten statt.
#. fr: La salle de réception est droit devant.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1682:0:1"
msgid "The reception hall<br>lies straightaway."
msgstr "Приёмная<br>прямо дальше."

#. ja: どぅおりゃっ！！！
#. de: Friss meinen Stahl!
#. fr: Grrrraaaah<nbsp>!
msgctxt "Balloon:1684:0:1"
msgid "Nnngraaahhh!"
msgstr "Нннгаааа!"

#. ja: やれやれ、またか…
#. de: 'ne Buddel Rum wär mir lieber<nbsp>...
#. fr: Pendez-le par les coudes<nbsp>!
msgctxt "Balloon:1685:0:1"
msgid "Jus' toss 'im to the sharks."
msgstr "Да просто скормите его акулам."

#. ja: 構え、撃てェー！
#. de: Zum hundertsten Mal: Nein, meine Füße sind nicht Bestandteil dieser Zielübung!
#. fr: Visez d'abord la tête, puis le cœur et enfin l'entre-jambes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1686:0:1"
msgid "Higher, ladies. Striking<br>them <i>there</i> will only<br>make your targets angrier."
msgstr "Повышайте прицел, дамы. Если попадёте<br>им <i>туда</i>, только разозлите мишени."

#. ja: どういうつもりだ！？
#. de: Zur Strafe baut ihr eine Woche lang Buddelschiffe!
#. fr: Peut-être que quelques jours aux fers te feront comprendre.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1691:0:1"
msgid "Might be a couple<br>nights in the brig<br>will learn you."
msgstr "Может, пара ночей<br>в карцере тебя поумерит."

#. ja: 気をつけます…
#. de: 'tschuldigung ...
#. fr: Je... Je suis désolé...
msgctxt "Balloon:1692:0:1"
msgid "It won't happen again!"
msgstr "Больше такого не повторится!"

#. ja: これだから新兵は…
#. de: Na, schönen Dank auch, Frischling!
#. fr: Foutue bleusaille<nbsp>!
msgctxt "Balloon:1694:0:1"
msgid "Bloody recruits..."
msgstr "Проклятые новобранцы..."

#. ja: まだ、まだ、まだぁっ！！
#. de: Keine Müdigkeit vorschützen, Leute!
#. fr: Mes genoux...
msgctxt "Balloon:1695:0:1"
msgid "Me knees..."
msgstr "Мои колени..."

#. ja: 仕上げは愛情…
#. de: ... und abgeschmeckt das Ganze mit einer Prise Liebe!
#. fr: Et l'ingrédient spécial est... l'amour<nbsp>! Ha ha ha<nbsp>! J'ai toujours rêvé de dire ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1701:0:1"
msgid "And the special ingre-<br>dient is...love! Gah hah<br>hah! I always wanted<br>to say that."
msgstr "А главный ингре-<br>диент... любовь! Ха-ха-ха!<br>Всегда хотел это сказать."

#. ja: い、生きててよかった…
#. de: Ihr Nudelholz hat mich nur um Haaresbreite verfehlt, und mit dem möchtest du keine Bekanntschaft machen, glaub's mir ...
#. fr: Après le Fléau... je... je n'aurais jamais cru que... (sanglote)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1704:0:1"
msgid "After the Calamity... I...<br>I never thought I'd... \\<sob>"
msgstr "После Катаклизма... Я...<br>Я и представить не мог... \\<всхлип>"

#. ja: メニュー全部さ
#. de: Junger Orobon mit gedämpften Gizar-Blättern an Preiselbeersoße soll köstlich sein, Schatz!
#. fr: C'est ici que nous nous sommes rencontrés...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1706:0:1"
msgid "This is where<br>we first met..."
msgstr "Здесь мы<br>впервые встретились..."

#. ja: 好きなもん頼め
#. de: Och nö, ham die keine Murmelhörnchenbuletten hier?
#. fr: Ça me semblait être le bon endroit pour nous dire adieu.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1707:0:1"
msgid "It seemed a fitting place<br>to say our farewells."
msgstr "Место подходящее,<br>чтобы попрощаться."

#. ja: よせ、逮捕するぞ！
#. de: Noch so'n Spruch und du landest im Kerker!
#. fr: Tu viens avec moi dans la cale<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1708:0:1"
msgid "You're coming with<br>me to the brig!"
msgstr "В карцер за мной!"

#. ja: ああん、やんのかコラ！
#. de: Ach ja?
#. fr: J'aimerais bien voir ça<nbsp>!
msgctxt "Balloon:1709:0:1"
msgid "I'd like to see ye try!"
msgstr "Да уж, посмотрел бы я!"

#. ja: 威張りくさんな！
#. de: Mach mal nicht so auf dicke Hose hier!
#. fr: Découpe-le<nbsp>! Découpe-le j'te dis<nbsp>!
msgctxt "Balloon:1710:0:1"
msgid "Cut 'im, dog! Cut 'im!"
msgstr "Режь его, пёс! Режь!"

#. ja: うらうら、うまうまっちゃ
#. de: Erst Mamool Glitzer zeigen, ja?
#. fr: Mamool doit d'abord montrer clic clic<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1715:0:1"
msgid "Mamool must be show-<br>ing the sparkly first, yes?"
msgstr "Сначала Мамул показать<br>блестяшки, да?"

#. ja: い～ぶき、い～ぱい～よ
#. de: Kein Klimmbimm, kein Gutgeschäft!
#. fr: Pas de sous-sous, pas d'affaire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1716:0:1"
msgid "No jinglyshine,<br>no busydeal!"
msgstr "Нет звеняшек —<br>нет сделяшек!"

#. ja: 交渉、成立、だ
#. de: Du wirst kein Gold sssehen, bevor wir den Pakt nicht mit Blut besssiegelt haben, Rattenmann.
#. fr: L'or, je ne donne pas. Signer le pacte de sang, l'homme-rat doit d'abord.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1717:0:1"
msgid "You'll see no gold<br>until we seal the<br>pact in blood, ratman."
msgstr "Золота не увидишь,<br>пока не скрепим<br>договор кровью, крысочеловек."

#. ja: ギルなら惜しまん
#. de: Von mir siehst du keinen Gil!
#. fr: Mais regarde, ce papier dit que je te donnerai les sous quand je les aurai.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1718:0:1"
msgid "But see, this slip says I<br>will give you the jingly-<br>shine when I get it."
msgstr "Но смотри, в этой бумаге сказано:<br>отдам тебе звеня-<br>шки, когда получу."

#. ja: 遠出するんでな
#. de: Ich hab dich gewarnt, es wird 'ne lange Reise ...
#. fr: Donne-lui ce foutu argent, on va pas y passer la nuit.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1720:0:1"
msgid "Jus' give 'im the coin,<br>or we'll be here all night."
msgstr "Да отдай ему деньги,<br>а то до ночи тут проторчим."

#. ja: いい温度だ
#. de: Dieses Wabern ist irgendwie beruhigend. Vielleicht sollte ich Lampen mit diesem Effekt herstellen ... Lavalampen!
#. fr: Personne va broncher si tu colles ton petit derrière dans la forge.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <if $gn4>go an' singe<br>yer frillies in the forge<else>go an' stick yer<br>manhood in the forge</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "Balloon:1721:0:1"
msgid "Ain't no one'll blink an<br>eye if you <if $gn4>go an' singe<br>yer frillies in the forge<else>go an' stick yer<br>manhood in the forge</if>."
msgstr "Никто и глазом не моргнёт,<br>если ты <if $gn4>опалишь<br>свои прелести в горне<else>сунёшь своё<br>мужское хозяйство в горн</if>."

#. ja: 15年待てますか？
#. de: Der automatische Segelheber ist eine Investition, die Ihr nicht bereuen werdet!
#. fr: Voyons voir... Il y aura un poste dans une quinzaine d'étés.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1722:0:1"
msgid "Let me see... There is an<br>opening ten summers hence."
msgstr "Дай подумать... Место<br>освободится через десять лет."

#. ja: 1隻注文したい
#. de: Eine Fregatte mit allen Extras, bitte.
#. fr: Il me faut un bateau<nbsp>! Un qui ne coulera pas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1723:0:1"
msgid "I need a ship!<br>One what won't sink!"
msgstr "Мне нужен корабль!<br>Такой, чтобы не тонул!"

#. ja: ふおおぉぉぉ！
#. de: Mehr Glut, Mann, mehr Glut!
#. fr: Arrête de me r'garder, tu sais pas comment t'servir d'un marteau<nbsp>?
#. macro: <if $gn4>Ain't never seen<br>a man swing a sledge?<else>Get them winkers off me<br>forgemate's dugs, 'fore I<br>renders ye black an' blue.</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1724:0:1"
msgid "<if $gn4>Ain't never seen<br>a man swing a sledge?<else>Get them winkers off me<br>forgemate's dugs, 'fore I<br>renders ye black an' blue.</if>"
msgstr "<if $gn4>Ты что, никогда не видела,<br>как мужик машет кувалдой?<else>Хватит пялиться на<br>сиськи напарника, а то<br>я тебе сейчас устрою!</if>"

#. ja: ふうぉ！ふんがっ！
#. de: Ich geb dir gleich Glut, Mann! Weißglut!
#. fr: C'est plus dur qu'il n'y paraît.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1726:0:1"
msgid "This is harder<br>than it looks."
msgstr "Это труднее,<br>чем кажется."

#. ja: 次はどこの港へ行くんだ？
#. de: Dass du dich immer von jedem Diätboom anstecken lassen musst ...
#. fr: Pas <i>encore</i> de la morue<nbsp>!? (soupire)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1728:0:1"
msgid "Not cod <i>again</i>!"
msgstr "Только не треска <i>опять</i>!"

#. ja: ヒャ～キッツイぜ…
#. de: Und ich sach dem Käpt'n noch: „Lass uns die Dielen imprägnieren, dann verdrecken die nich so schnell.“
#. fr: Me faut un avorton pour du boulot d'avorton.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1744:0:1"
msgid "I needs me a scrag to<br>do me scrag work."
msgstr "Мне нужен коротышка,<br>чтоб коротышкину работу делать."

#. ja: ♪ヨホホィ嵐に負けねぇ♪
#. de: ♪ Ich tu segeln, ich tu seeegeln ♪
#. fr: À une époque, on avait des Qiqirns pour laver le pont.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1745:0:1"
msgid "Used to be we had<br>Qiqirn swab the decks."
msgstr "Раньше кикирны<br>драили нам палубу."

#. ja: うまか…った…
#. de: Boah, bin ich voll ...
#. fr: Tout ce que je voulais, c'était une omelette sans œufs.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1747:0:1"
msgid "All I wanted was<br>an eggless omelette."
msgstr "Я всего-то хотел<br>омлет без яиц."

#. ja: 実、に見事、だ
#. de: Ausssgezeichnet ...
#. fr: Quarante boudins au sang. Crus.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1748:0:1"
msgid "Two score blood<br>sausages. Raw."
msgstr "Сорок кровяных<br>колбасок. Сырых."

#. ja: 規則だ
#. de: Der schaust du höchstens in den Lauf, Freundchen!
#. fr: Décret de l'Amirale. Si vous avez un problème, vous en parlez avec <i>elle</i>.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1767:0:1"
msgid "Admiral's decree. You've<br>a problem, you take it up<br>with <i>her</i>."
msgstr "Таков приказ адмирала. Есть<br>претензии — разбирайся<br>с <i>ней</i>."

#. ja: 銃を解放しろ！
#. de: Zeig mal deine Waffe!
#. fr: Une vé<shy>ri<shy>fi<shy>ca<shy>tion des antécédents<nbsp>!?
msgctxt "Balloon:1768:0:1"
msgid "A background check!?"
msgstr "Проверка биографии!?"

#. ja: お役人は帰れ～
#. de: Geh nach Hause, Gelbjacke!
#. fr: Va t'noyer en mer, Barracuda<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1773:0:1"
msgid "Back to the<br>sea with ye, 'Cuda!"
msgstr "В море обратно<br>плыви, барракуда!"

#. ja: やっちゃえやっちゃえ！
#. de: Keine Zurückhaltung, Jungs!
#. fr: Tu vas le laisser te bousculer comme ça, mon amour<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1774:0:1"
msgid "You going to let him<br>push you around like<br>that, love!?"
msgstr "Ты дашь ему вот так<br>собой помыкать, милый!?"

#. ja: ハーブオイル塗ってあげる
#. de: Dich reib ich gratis mit Kräuteröl ein, Schätzchen.
#. fr: Certaines huiles pourraient aider...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1775:0:1"
msgid "There are oils<br>which can help..."
msgstr "Есть масла,<br>которые могут помочь..."

#. ja: 全身が凝ってんだよぉ
#. de: Hast du irgendwas Verspannungslösendes?
#. fr: Je suis raide comme un caillou.
msgctxt "Balloon:1776:0:1"
msgid "I'm stiff as a rock."
msgstr "Я весь как камень."

#. ja: 干し魚をあるだけ欲しい
#. de: Ich nehme all den Trockenfisch, den du hast.
#. fr: Mon bateau a b'soin de toute la morue salée que vous pouvez vendre.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1777:0:1"
msgid "Me ship needs all the<br>salted cod ye can spare."
msgstr "Кораблю нужна вся<br>солёная треска, что найдётся."

#. ja: 30樽なら
#. de: In Ordnung, das wären dann 30 Fässer.
#. fr: Trente barils, ça va<nbsp>?
msgctxt "Balloon:1778:0:1"
msgid "Thirty barrels do ye?"
msgstr "Тридцать бочек, говоришь?"

#. ja: 少しは手伝ってください
#. de: 'n bisschen könntest du ruhig mal helfen!
#. fr: Il y a encore des corvées, des corvées à finir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1810:0:1"
msgid "There are still chores<br>that need attending!"
msgstr "Ещё столько дел<br>не переделано!"

#. ja: うるせー黙れ
#. de: Halt einfach dein Maul, ja?
#. fr: Et y a des Gobelins à faire frire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1811:0:1"
msgid "And by the sounds of it,<br>gobs what need stuffin'!"
msgstr "Да и, судя по шуму,<br>гоблинов пора жарить!"

#. ja: ワインくれよ
#. de: Haste 'ne Flasche Wein für 'ne durstige Piratin?
#. fr: T'as vu ce que tu voulais<nbsp>? Alors reste loin de mes gars, compris<nbsp>?
#. macro: <if $gn4>Stay the seven hells<br>away from me boys, hear?<else>See aught ye like?</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1812:0:1"
msgid "<if $gn4>Stay the seven hells<br>away from me boys, hear?<else>See aught ye like?</if>"
msgstr "<if $gn4>Семь преисподних, держись<br>подальше от моих ребят, ясно?<else>Что-то приглянулось?</if>"

#. ja: いっちょいくぜ！
#. de: Und du neue Zähne!
#. fr: Qu'est-ce que t'attends<nbsp>? Une invitation de l'Amirale<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1815:0:1"
msgid "What ye waitin' fer? An<br>invite from the Admiral?"
msgstr "Чего ждёшь? Приглашения<br>от адмирала?"

#. ja: 俺が勝つ
#. de: Bestell schon mal 'n neues Kopftuch!
#. fr: Tu vas voir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1816:0:1"
msgid "Come a li'l closer, like.<br>I dinnae 'ear ye!"
msgstr "Подойди-ка поближе.<br>Не слышу тебя!"

#. ja: 勝ってくれよ！
#. de: Mach Fischfutter aus ihm!
#. fr: Si tu choisis cette mauviette, tu vas voir tes fesses<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1817:0:1"
msgid "Ye fall to that scrag,<br>yer arse is mine!"
msgstr "Проиграешь этому доходяге —<br>тебе несдобровать!"

#. ja: 私のフトコロ温めとくれ！
#. de: Endlich mal was los hier!
#. fr: Cinquant' gils sur... sur... çui en bleu<nbsp>! Hic<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1818:0:1"
msgid "Fiffy gil on the...on the...<br>on theone innnblue! Hic!"
msgstr "Пятьдесят гил на... на...<br>на того, в синем! Ик!"

#. ja: あははは～うふふふ～
#. de: Na los, Jungs, das könnt ihr auch!
#. fr: Plus fort les gars<nbsp>!
msgctxt "Balloon:1820:0:1"
msgid "Louder, boys!"
msgstr "Громче, парни!"

#. ja: ♪ヨホホィ嵐に負けねぇ♪
#. de: Schwing das Tanzbein, Mädel!
#. fr: ♪ Mais le matin en s'réveillant.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1821:0:1"
msgid "But in the morning<br>when he woke,♪"
msgstr "А поутру,<br>когда он проснулся...♪"

#. ja: ♪ヨホホィ酒飲め船漕げ♪
#. de: Hach, jetzt fehlt nur noch 'n Schifferklavier!
#. fr: ♪ L'a vu qu'la fille était une chèèèvre.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1822:0:1"
msgid "He saw the maiden<br>was a goat!♪"
msgstr "Увидел он: девица-то<br>козой была!♪"

#. ja: オシベとメシベをチュチュ
#. de: Hm, welchen pflück ich denn nun zuerst?
#. fr: Pas de traces de ces feuilles... pour l'instant.
msgctxt "Balloon:1833:0:1"
msgid "No signs of ashleaf...yet."
msgstr "Ашевого листа пока не видать."

#. ja: やだカスカス…
#. de: Alle vertrocknet, welch ein Jammer ...
#. fr: Voilà qui devrait faire un bon vin de cuisine.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1837:0:1"
msgid "These'll make<br>a fine sour red."
msgstr "Из них выйдет<br>отличное кислое вино."

#. ja: 終わらない…
#. de: Die Pflückerei nimmt einfach kein Ende ...
#. fr: Et comment je fais pour atteindre ce qui est en haut<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1838:0:1"
msgid "And how am I to reach<br>those ones at the top?"
msgstr "Как же мне достать<br>те, что наверху?"

#. ja: ♪ヨホホィ俺たちゃ海賊♪
#. de: ♪ Piraten brauchen keine Spaten, auch ohne stechen sie in See ♪
#. fr: Le gagnant peut venir réchauffer ma couchette<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1843:0:1"
msgid "The winner can<br>warm me bunk!"
msgstr "Победитель сможет<br>согреть мою койку!"

#. ja: ♪ヨホホィ酒飲め船漕げ♪
#. de: ♪ In der Achterburg, nachts um halb eins ♪
#. fr: T'vas l'laisser te causer comme ça<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1844:0:1"
msgid "Ye goin' to let 'im<br>talk to ye like that?"
msgstr "Ты позволишь ему<br>так с тобой разговаривать?"

#. ja: ♪ヨホホィ分捕れ乗っ取れ♪
#. de: ♪ Eine Kaperfahrt ist lustig, eine Kaperfahrt ist schön ♪
#. fr: Ha ha ha ha<nbsp>!
msgctxt "Balloon:1847:0:1"
msgid "Hah hah hah hah!"
msgstr "Ха-ха-ха-ха!"

#. ja: むにゃ…
#. de: \<schnarch>
#. fr: Zzzzzz...
msgctxt "Balloon:1848:0:1"
msgid "Zzzzzz..."
msgstr "Хр-р-р..."

#. ja: リフトを上げろ～！！
#. de: Rauf damit, na wird's bald?
#. fr: J'ai dit <i>lève</i> le monte-charge, abruti<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:1853:0:1"
msgid "I <i>said</i> raise the lift!"
msgstr "Я же <i>сказал</i> поднять грузовой лифт!"

#. ja: 来た来た～
#. de: Ob sie unterwegs ein Unglück ereilt hat?
#. fr: Y a d'la marchandise qui arrive<nbsp>!
msgctxt "Balloon:1854:0:1"
msgid "Incoming cargo!"
msgstr "Груз прибывает!"

#. ja: オーライ、オーライ！
#. de: Ich übe hier für meinen Traumjob: Galionsfigur!
#. fr: Doucement<nbsp>! Dou-ce-ment<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1859:0:1"
msgid "Slower! Slow<i>er</i>!<br>Alright, not <i>that</i> slow!"
msgstr "Медленнее! Ещё <i>медленнее</i>!<br>Ладно, не <i>настолько</i> же медленно!"

#. ja: 荷をさばききれん
#. de: Glaub's mir, das hat sie wirklich gesagt!
#. fr: Et maintenant, il raconte à tout le monde qu'il est parti coucher avec une sirène<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1860:0:1"
msgid "And now he's telling<br>everyone he's gone<br>and lain with a mermaid!"
msgstr "А теперь он всем рассказывает,<br>что переспал с русалкой!"

#. ja: はっ！
#. de: Jawohl!
#. fr: Oui, Chef<nbsp>!
msgctxt "Balloon:1861:0:1"
msgid "Yes, sir!"
msgstr "Так точно!"

#. ja: はっ！
#. de: Zu Befehl!
#. fr: Oui, Chef<nbsp>!
msgctxt "Balloon:1862:0:1"
msgid "Yes, sir!"
msgstr "Есть, сэр!"

#. ja: はっ！
#. de: Alles klar!
#. fr: Oui, Chef<nbsp>!
msgctxt "Balloon:1863:0:1"
msgid "Yes, sir!"
msgstr "Будет сделано!"

#. ja: はっ！
#. de: Selbstverständlich!
#. fr: Oui, Chef<nbsp>!
msgctxt "Balloon:1864:0:1"
msgid "Yes, sir!"
msgstr "Слушаюсь!"

#. ja: はっ！
#. de: Sir!
#. fr: Oui, Chef<nbsp>!
msgctxt "Balloon:1865:0:1"
msgid "Yes, sir!"
msgstr "Да, сэр!"

#. ja: にゃっ！
#. de: Keine Fledderei? Ach, menno ...
#. fr: Pas de butin<nbsp>?
msgctxt "Balloon:1866:0:1"
msgid "No looting...?"
msgstr "А добычи не будет?.."

#. ja: スープは切らすな
#. de: Warum kippst du die stinkende Suppe nicht weg? Die kann doch keiner mehr essen.
#. fr: Tu t'inquiètes trop<nbsp>! Le capitaine est loin.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1871:0:1"
msgid "You worry overmuch!<br>The captain is malms away."
msgstr "Да ты слишком уж волнуешься!<br>Капитан за много миль отсюда."

#. ja: 敵にぶっかけるんですね！
#. de: Die servieren wir unseren Gegnern: kochend heiß auf den Kopf!
#. fr: Si on reste plus longtemps, le capitaine nous balancera<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1873:0:1"
msgid "Any longer and the<br>captain will report us!"
msgstr "Ещё немного — и капитан<br>нас заложит!"

#. ja: 夜の襲撃に備えよ
#. de: Mach dich fertig für die nächtliche Patrouille!
#. fr: L'heure du combat approche<nbsp>! Restez sur le qui-vive<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1875:0:1"
msgid "The fiends will arrive<br>shortly. Make ready."
msgstr "Нечисть скоро нагрянет.<br>Приготовиться!"

#. ja: 物見は僕が！
#. de: Aber ich war doch erst gestern dran!
#. fr: Faites-moi confiance, Chef<nbsp>!
msgctxt "Balloon:1876:0:1"
msgid "Yes, sir!"
msgstr "Так точно!"

#. ja: 巡回始めっ！
#. de: Denkt daran, ihr seid keine Piraten mehr! Wehe, ich erwische einen von euch beim Leichenfleddern!
#. fr: Et n'oubliez pas que vous n'êtes plus des pirates<nbsp>! On ne fouille pas les cadavres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1878:0:1"
msgid "And remember, you're<br>not pirates anymore! I'll<br>have no corpse looting."
msgstr "И помните: вы больше<br>не пираты! Чтоб я больше<br>не видел, как обирают мертвецов!"

#. ja: きれいに咲けよ
#. de: Schön wachsen, hört ihr? Schön wachsen!
#. fr: ♪ Pour un fruit mûr,<br>♪ Des graines partout,<br>♪ Pour nous nourrir.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1891:0:1"
msgid "To ripe thy fruit<br>and spread thy seed,<br>and nourish those<br>that tend thee...♪"
msgstr "Чтоб плод твой созрел,<br>семена разнеслись,<br>и кормил ты тех,<br>кто за тобой ухаживает...♪"

#. ja: 新しい肥料だよ～
#. de: Mal sehen, wie sich unser neuer Dünger schlägt.
#. fr: ♪ Un peu d'eau ici...<br>♪ Un peu d'eau là...<br>♪ Et un peu d'eau partout...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1895:0:1"
msgid "A sprinkle here...<br>A sprinkle there...<br>Another sprinkle here..."
msgstr "Чуть-чуть сюда...<br>Чуть-чуть туда...<br>И ещё чуть-чуть сюда..."

#. ja: 恐くないのかねぇ
#. de: Pass auf, dass du nicht durch die Lücke purzelst.
#. fr: Vous avez pas ce qu'il faut pour travailler là-bas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1909:0:1"
msgid "You haven't the stones<br>to work down there!"
msgstr "Да кишка тонка у вас<br>там работать!"

#. ja: 作業してるぞ…
#. de: Haha, sehr witzig ...
#. fr: Il paraît qu'ils cherchent des hommes pour Le Lien d'Oschon.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1962:0:1"
msgid "I hear they're looking<br>for men to mortar<br>the Embrace."
msgstr "Слышал, ищут людей<br>класть раствор<br>в Объятии Ошона."

#. ja: 船が襲われたんです
#. de: Unser Schiff wurde geentert!
#. fr: Notre bateau s'est fait piller<nbsp>!
msgctxt "Balloon:1967:0:1"
msgid "We saw Swallowtail Roam!"
msgstr "Мы видели Свэллоутейл-Роум!"

#. ja: 積荷が奪われた
#. de: Und der Laderaum komplett ausgeräumt!
#. fr: Toute notre marchandise est perdue...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1968:0:1"
msgid "Just beyond<br>the Cieldalaes!"
msgstr "Чуть дальше<br>Сьельдалеев!"

#. ja: おら、どけ、どけ
#. de: Aus'm Weg, du garstige Wand, du! \<hicks>
#. fr: Écartez-vous<nbsp>!
msgctxt "Balloon:1974:0:1"
msgid "Stand aside, 'venturer!"
msgstr "Посторонись, авантюрист!"

#. ja: こっちこっち～
#. de: Sag mal, bist du festgewachsen? Hier rüber mit den Säcken!
#. fr: Par ici<nbsp>! Vite<nbsp>!
msgctxt "Balloon:1977:0:1"
msgid "Down here! Quickly now!"
msgstr "Сюда! Живо!"

#. ja: 暴れるもので…
#. de: Was soll ich machen, die Biester sind in letzter Zeit so störrisch.
#. fr: Comme vous avez demandé, Chef.
msgctxt "Balloon:1986:0:1"
msgid "Just as you ordered, sir."
msgstr "Как вы и приказали, сэр."

#. ja: よしっ揃ったわ
#. de: Um die Sammlung wird mich jeder beneiden!
#. fr: Je crois que c'est tout.
msgctxt "Balloon:1991:0:1"
msgid "I believe that's everything."
msgstr "Кажется, это всё."

#. ja: エサは十分だな
#. de: Guck mich nicht so an, du hattest dein Futter gerade!
#. fr: Foutredieu<nbsp>! Cette caisse devait nous durer toute la lune<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1995:0:1"
msgid "Blast! That crate was to<br>last us the whole moon!"
msgstr "Чтоб тебя! Этот ящик должен был<br>продержаться целую луну!"

#. ja: それはここじゃない
#. de: Hufeisen hatte ich nicht bestellt!
#. fr: C'est pas censé aller là-dedans<nbsp>! Incapable<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1997:0:1"
msgid "This is <i>not</i> where that<br>goes! Off with you now!"
msgstr "Это <i>не</i> сюда!<br>А ну, марш отсюда!"

#. ja: くそっ重い…！
#. de: Das Ding ist aber sauschwer!
#. fr: Va voir ailleurs<nbsp>!
msgctxt "Balloon:1998:0:1"
msgid "Sod off, woman!"
msgstr "Отвали, женщина!"

#. ja: ドードー肉は揃ったよ
#. de: Das Dodo-Fleisch hab ich dabei.
#. fr: Où vous voulez ces sacs de nourriture pour dodo<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:1999:0:1"
msgid "Where would ye have<br>these sacks of dodo feed?"
msgstr "Куда поставить<br>эти мешки с кормом для додо?"
