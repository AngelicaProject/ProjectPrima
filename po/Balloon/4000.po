# Balloon
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 残念だが、今日は…
#. de: Tut mir leid, heute nicht.
#. fr: Désolé. On n'en a pas récolté, aujourd'hui.
msgctxt "Balloon:4000:0:1"
msgid "None today, I'm afraid..."
msgstr "Сегодня ничего нет, боюсь..."

#. ja: ケナガウシの肉もいいな
#. de: Pökelfleisch vom Steppen-Dzo ist auch aus.
#. fr: De la viande de hainag, ce serait super<nbsp>!
msgctxt "Balloon:4001:0:1"
msgid "Could use more dzo meat!"
msgstr "Мяса дзо бы ещё не помешало!"

#. ja: 伝えておこう
#. de: Verstanden. Ich bestell neues.
#. fr: Je leur demanderai.
msgctxt "Balloon:4002:0:1"
msgid "I'll pass it along!"
msgstr "Передам!"

#. ja: 産地直送だぞ！
#. de: Fische so frisch, sie schnappen noch nach Luft!
#. fr: Il est frais mon poisson<nbsp>! Il est frais<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4003:0:1"
msgid "Catch of the day!<br>Fresh from the Ruby Sea!"
msgstr "Улов дня!<br>Прямиком из Рубинового моря!"

#. ja: 迷うなぁ…
#. de: Ich hab zwar schon gegessen, aber etwas passt noch rein.
#. fr: Y a l'embarras du choix, dis donc...
msgctxt "Balloon:4004:0:1"
msgid "Bah, I can't decide..."
msgstr "Эх, никак не выберу..."

#. ja: 盗人…ではないな
#. de: Komm nicht auf die Idee, dich einfach so zu bedienen<nbsp>...
#. fr: Donner, c'est donner. Reprendre, c'est voler. Enfin, on peut s'arranger.
msgctxt "Balloon:4005:0:1"
msgid "Hands where I can see..."
msgstr "Руки на виду..."

#. ja: いいところ見せてくれよ！
#. de: Zeig, was du drauf hast!
#. fr: Venez nous prouver que vous êtes pas des poules mouillées<nbsp>!
msgctxt "Balloon:4006:0:1"
msgid "Show us what you've got!"
msgstr "Покажите, на что способны!"

#. ja: び、びびってねぇからな…！
#. de: D-Das sieht gefährlich aus<nbsp>...
#. fr: J-j'y serais bien allé... m-mais j'ai oublié mon bonnet<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4007:0:1"
msgid "I'm not afraid...<br>But it <i>is</i> awfully high, isn't it?"
msgstr "Я не боюсь...<br>Но ведь <i>высоко</i> же, правда?"

#. ja: とっとと行きな！
#. de: Los, trau dich!
#. fr: Mais bien sûr...
msgctxt "Balloon:4008:0:1"
msgid "Stop making excuses and go!"
msgstr "Хватит отговорки придумывать, иди!"

#. ja: 高いなぁ…
#. de: Ganz schön hoch<nbsp>...
#. fr: Ne pas regarder en bas...<br>Ne pas regarder en bas...
msgctxt "Balloon:4009:0:1"
msgid "It's a long way down..."
msgstr "Высоко... Падать далеко..."

#. ja: ハァハァ…<br>もう動けないよぉ…
#. de: Ich kann nicht mehr<nbsp>...
#. fr: J'en peux plus... Prends-moi sur ton dos ou abandonne-moi ici<nbsp>!
msgctxt "Balloon:4010:0:1"
msgid "\\<pant> It's a miracle I survived..."
msgstr "<i>Фух...</i> Чудом удалось выжить..."

#. ja: ここからが本番よね…
#. de: Ab hier wird's schwierig.
#. fr: Fini l'échauf<shy>fe<shy>ment. Place aux choses sérieuses<nbsp>!
msgctxt "Balloon:4011:0:1"
msgid "So this is where it starts getting tricky?"
msgstr "Вот теперь начинается самое сложное?"

#. ja: 海賊魂…ナメんなッ…！
#. de: Verdammt, meine Piratenehre steht auf dem Spiel!
#. fr: Les pirates, ça lâche rien. La piraterie n'est jamais finiiie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4012:0:1"
msgid "Pirates lose to ninjas?<br>Over my dead body!"
msgstr "Пираты проиграют ниндзя?<br>Только через мой труп!"

#. ja: はわわわわわ…
#. de: Oje!
#. fr: Mamaaan...
msgctxt "Balloon:4013:0:1"
msgid "I can't do it... I can't do it!"
msgstr "Не могу... Не могу!"

#. ja: 最後の難関だわ…
#. de: Das letzte Hindernis<nbsp>...
#. fr: C'est ici que tout va se jouer...
msgctxt "Balloon:4014:0:1"
msgid "It all hangs on this final stage..."
msgstr "Всё решится на этом последнем этапе..."

#. ja: 好きな娘の前で失敗した…<br>う、うう…
#. de: Hoffentlich hat mich meine Liebste nicht gesehen.
#. fr: J'ai chu sous les yeux de ma douce...<br>Bouhouhou<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4015:0:1"
msgid "How could I shame myself so<br>in front of my beloved?"
msgstr "Как же я опозорился<br>перед любимой!"

#. ja: あともう少しなのにぃぃ！
#. de: Mist, so kurz vorm Ziel!
#. fr: Nooon<nbsp>! J'ai dit que j'me couperais les cheveux si j'tombaiiis<nbsp>!
msgctxt "Balloon:4016:0:1"
msgid "If only I were a ninja!"
msgstr "Вот бы мне быть ниндзя!"

#. ja: うおおお…<br>攻略おめでとう！！
#. de: Gut gemacht!
#. fr: C'que vous êtes doué<if $gn4>e</if><nbsp>!
msgctxt "Balloon:4017:0:1"
msgid "I knew you'd reach the top!"
msgstr "Я знал, что ты доберёшься до вершины!"

#. ja: すごい、すごーい！
#. de: Super!
#. fr: Ouaaaah<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4018:0:1"
msgid "I wasn't watching.<br>Could you do that again for me?"
msgstr "Я не смотрел.<br>Повторишь для меня?"

#. ja: あなたのファンになっちゃった！
#. de: Du hast mich sehr beeindruckt!
#. fr: Vous ne voudriez pas me signer un petit autogrrraphe<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4019:0:1"
msgid "Of all the ones to complete the course,<br>you're my favorite!"
msgstr "Из всех, кто прошёл трассу,<br>ты мне понравился больше всех!"

#. ja: 紅蓮祭、楽しんでいってね！
#. de: Viel Spaß beim Feuermond-Reigen!
#. fr: Vive les Feux de la Mort<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4020:0:1"
msgid "Come one, come all!<br>The Moonfire Faire is here!"
msgstr "Заходите, не стесняйтесь!<br>Праздник Огненного моря уже здесь!"

#. ja: さあさあ、「常夏の魔城」の<br>挑戦者募集中だよ！
#. de: Der Feuermond-Parkour ist eröffnet!
#. fr: Ils cherchent des candidats pour “Pas dans l'tas”, le grand jeu de l'été<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4021:0:1"
msgid "Adventurers! Test your<br>skills on the Eorzean<br>Nimble Warrior course!"
msgstr "Авантюристы! Испытайте<br>свою ловкость на трассе<br>«Проворный воин Эорзеи»!"

#. ja: やっぱ海で泳いじゃう！？
#. de: Lust auf ein Bad im Meer?
#. fr: Et si on allait nager<nbsp>?
msgctxt "Balloon:4022:0:1"
msgid "Come on, let's go for a swim!"
msgstr "Ну же, пойдём поплаваем!"

#. ja: 「常夏の魔城」も<br>見学したくない？
#. de: Wollen wir nicht beim Feuermond-Parkour zugucken?
#. fr: Tu préfères pas regarder “Pas dans l'tas”<nbsp>?
msgctxt "Balloon:4023:0:1"
msgid "Shall we go and watch?"
msgstr "Может, сходим посмотрим?"

#. ja: あんなの建てちゃうなんて<br>すごいね！
#. de: Ganz schön aufwendig, das Ganze!
#. fr: La mer sera encore là demain, mais pas le bidule géant qui baigne dedans...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4024:0:1"
msgid "It's certainly impressive,<br>but it's a bit of an eyesore..."
msgstr "Впечатляет, конечно,<br>но уж больно вид портит..."

#. ja: 地主さんって<br>どんな方かしら？
#. de: Was ist dieser Gegeruju für ein Typ?
#. fr: Pour avoir construit une telle structure, Gegeruju doit être un grand Roegadyn hyper musclé...
msgctxt "Balloon:4025:0:1"
msgid "I wonder what Master Gegeruju is like?"
msgstr "Интересно, что за человек мастер Гегеруджу?"

#. ja: ナイス筋肉ゥ！
#. de: Ich bin der Stärkste!
#. fr: Mes beaux biscoteaux n'ont pas le vertige, eux<nbsp>!
msgctxt "Balloon:4026:0:1"
msgid "There's always time for squats!"
msgstr "Приседаниям всегда найдётся время!"

#. ja: 美しい仕上がりだ！
#. de: Du bist auch nicht schlecht gebaut!
#. fr: J'ai décidément le plus beau slip de bain...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4027:0:1"
msgid "In the way?<br>No, not at all!"
msgstr "Мешаю?<br>Да нисколько!"

#. ja: お前の筋肉も<br>輝いているな！
#. de: Los, zeig deine Muckis!
#. fr: Du vent<nbsp>! Les autres peuvent pas m'admirer si tu bloques la vue<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4028:0:1"
msgid "Finish the course?<br>We're too busy looking good!"
msgstr "Пройти трассу?<br>Нам некогда, мы хороши собой!"

#. ja: 足踏み外したぁ！
#. de: Zieh mich hoch!
#. fr: Je n'ai fait qu'un faux pas... rien qu'un seul<nbsp>!
msgctxt "Balloon:4029:0:1"
msgid "Mustn't...let go..."
msgstr "Нельзя... разжимать руки..."

#. ja: わわわっ！？<br>揺らさないで…！
#. de: Achtung, tritt mir bloß nicht auf die Finger!
#. fr: Arrêtez de faire bouger la passerelle<nbsp>!
msgctxt "Balloon:4030:0:1"
msgid "Argh! Stop shaking it!"
msgstr "А-а! Хватит её трясти!"

#. ja: こ、こんな序盤で！？
#. de: Was für eine Blamage<nbsp>...
#. fr: Ils trouvent vraiment ça facile, les organisateurs...<nbsp>!?
msgctxt "Balloon:4031:0:1"
msgid "And this is the easy part!?"
msgstr "И это ещё лёгкая часть!?"

#. ja: ふむ…<br>いかに攻略するか…
#. de: Ob ich das schaffe?
#. fr: Hum... Suffit juste de trouver la bonne stratégie...
msgctxt "Balloon:4032:0:1"
msgid "Am I truly ready?"
msgstr "А готов ли я и вправду?"

#. ja: 落ちるのも気持ちいいな…
#. de: Runterfallen macht auch Spaß!
#. fr: La chute était pas si terrible...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4033:0:1"
msgid "I know you're not supposed to fall off, but it <i>is</i> quite fun!"
msgstr "Падать, конечно, не положено, но это <i>так</i> весело!"

#. ja: ブクブクブク……
#. de: \<gluck> \<gluck>
#. fr: Bloup, bloup, bloup...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4034:0:1"
msgid "I'm not drowning,<br>I'm just resting."
msgstr "Буль-буль-буль...<br>Я не тону, просто отдыхаю."

#. ja: 熱くなっちゃダメよね…<br>慎重に…慎重に…
#. de: Immer schön mit der Ruhe!
#. fr: Attention au coup de chaud... Pensez à vous rafraîchir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4035:0:1"
msgid "I mustn't give in to<br>my fear next time...<br>I must focus."
msgstr "В следующий раз не дам страху<br>взять надо мной верх...<br>Надо сосредоточиться."

#. ja: ゴフッ！<br>ゴボボボボボッ…！！
#. de: Ohhh<nbsp>... \<prust>
#. fr: Kof<nbsp>!<br>Kof kof kof<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4036:0:1"
msgid "\\<splutter> Gods!<br>Am I dead!?"
msgstr "<i>Кха!</i> Боги!<br>Я что, умер!? "

#. ja: ガッツが足らないニャ！
#. de: Na los, hoch mit dir!
#. fr: Pfff, dis pas n'imporrrte quoi<nbsp>!
msgctxt "Balloon:4037:0:1"
msgid "Is that all you've got!?"
msgstr "И это всё, на что ты способен!?"

#. ja: ほらほら！<br>あと少しがんばれー♪
#. de: Bald hast du es geschafft!
#. fr: Allez, allez<nbsp>! T'y es presque<nbsp>!
msgctxt "Balloon:4038:0:1"
msgid "That's the way! Just a little farther!"
msgstr "Вот так! Ещё чуть-чуть!"

#. ja: ゴールは目前です…！
#. de: Das Ziel ist da oben!
#. fr: La ligne d'arrivée est juste là<nbsp>!
msgctxt "Balloon:4039:0:1"
msgid "You're almost there!"
msgstr "Ты почти у цели!"

#. ja: ここで攻略者を<br>見届けるのさ！
#. de: Was für ein Spaß!
#. fr: D'ici, on peut pas rater les gagnants...
msgctxt "Balloon:4040:0:1"
msgid "Let me know when someone promising shows up."
msgstr "Дай знать, если покажется кто-нибудь перспективный."

#. ja: 見てるだけで<br>ドキドキしちゃう！
#. de: Ach, ist das aufregend!
#. fr: J'ai le cœur serré rien qu'à les regarder.
msgctxt "Balloon:4041:0:1"
msgid "I had a feeling that Lalafell chap would struggle..."
msgstr "Я так и знал, что тому лалафеллу будет тяжело..."

#. ja: 頑張る姿…<br>ステキだわ！
#. de: So sehen echte Abenteurer aus!
#. fr: C'est beau de les voirrr tous se donner à fond comme ça<nbsp>!
msgctxt "Balloon:4042:0:1"
msgid "I could watch this all day!"
msgstr "Я бы мог смотреть на это весь день!"

#. ja: はいよ、順番にな…！
#. de: Immer schön der Reihe nach.
#. fr: Chacun son tour<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4043:0:1"
msgid "And I need a long, hot bath!<br>We've all got to wait our turn!"
msgstr "А мне нужна долгая горячая ванна!<br>Всем придётся подождать своей очереди!"

#. ja: かなりの注文が…
#. de: Ich hätte da eine etwas umfangreichere Bestellung aufzugeben<nbsp>...
#. fr: C'est une grosse commande. Ça va aller<nbsp>?
msgctxt "Balloon:4044:0:1"
msgid "This is no small order..."
msgstr "Заказ немаленький..."

#. ja: 平行に…なってるな
#. de: Alles schön gerade?
#. fr: Hmm... C'est à niveau, ça<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4045:0:1"
msgid "But are they absolutely,<br><i>perfectly</i> parallel...?"
msgstr "А они точно<br><i>идеально</i> параллельны?.."

#. ja: この木で良かったか？
#. de: Ist das die richtige Sorte?
#. fr: C'est ça le bois qu'il fallait<nbsp>?
msgctxt "Balloon:4046:0:1"
msgid "Will these do?"
msgstr "Эти подойдут?"

#. ja: ちょっと待ってくれ
#. de: Moooment mal<nbsp>...
#. fr: Attends, je finis ça et je jette un coup d'œil.
msgctxt "Balloon:4047:0:1"
msgid "Give me a moment!"
msgstr "Погодите минутку!"

#. ja: 次は道具も届くそうね
#. de: Die Zweimannsäge soll heute eintreffen.
#. fr: On ne devrait pas tarder à recevoir nos nouveaux outils.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4048:0:1"
msgid "Shipment ought to be<br>arriving soon, I think..."
msgstr "Кажется, скоро должна<br>прийти поставка..."

#. ja: ああ、仕事がはかどるな！
#. de: Klasse, dann geht's schneller.
#. fr: Bonne nouvelle<nbsp>! Je vais pouvoir mettre du cœur à l'ouvrage<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4049:0:1"
msgid "About time! This saw's got<br>no teeth left to speak of..."
msgstr "Наконец-то! У этой пилы<br>зубьев почти не осталось..."

#. ja: 次の納入はいつ？
#. de: Sind die neuen Werkzeuge schon da?
#. fr: Vous savez quand les nouveaux outils seront livrés<nbsp>?
msgctxt "Balloon:4050:0:1"
msgid "Hey, about those tools─"
msgstr "Слушай, а инструменты─"

#. ja: 実は予定が変わって…
#. de: Nein. Komm später wieder.
#. fr: Ben en fait... Ce sera pas pour tout de suite...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4051:0:1"
msgid "Not today, I'm afraid.<br>Delivery's been delayed.<br>Again..."
msgstr "Сегодня, боюсь, не получится.<br>Поставку задержали.<br>Опять..."

#. ja: …聞こえてた？
#. de: Hast du gehört? Die Zweimannsäge ist noch nicht da.
#. fr: J'imagine que t'as entendu...
msgctxt "Balloon:4052:0:1"
msgid "...Heard that?"
msgstr "...Слышал?"

#. ja: まあ、やれるように<br>やるしかないさ
#. de: Ach, was soll's! Ich schaff's auch alleine.
#. fr: Ouais, ouais... On fera ce qu'on peut avec ce qu'on a<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4053:0:1"
msgid "Aye. Should've known.<br>We'll make do as always..."
msgstr "Ага. Надо было догадаться.<br>Как всегда, обойдёмся тем, что есть..."

#. ja: できるだけ軽いと<br>嬉しいけれど…
#. de: Das Holz sollte so leicht wie möglich sein.
#. fr: Et plus c'est léger, mieux c'est.
msgctxt "Balloon:4054:0:1"
msgid "The lighter the better..."
msgstr "Чем легче, тем лучше..."

#. ja: どの木材にするか…
#. de: Nehm ich Kiefer oder Eiche?
#. fr: Alors... quel bois je vais utiliser...<nbsp>?
msgctxt "Balloon:4055:0:1"
msgid "Aren't we spoiled for choice..."
msgstr "И какой же взять?.."

#. ja: やっぱり松かな
#. de: „Nicht die Kiefer, dann wird's schiefer.“ Also Eiche!
#. fr: Allez, le pin, il y a que ça de vrai.
msgctxt "Balloon:4056:0:1"
msgid "Pine it is!"
msgstr "Возьму сосну!"

#. ja: 取っ手が折れちゃって…
#. de: Und dann ist<nbsp>... krach!<nbsp>... der Hebel angebrochen!
#. fr: Et là, la poignée s'est cassée...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4057:0:1"
msgid "...And then the handle split<br>right down the middle!"
msgstr "...А потом ручка раскололась<br>ровно пополам!"

#. ja: 何か手伝えることは…
#. de: Gibt's was zu tun?
#. fr: Voyons voir...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4058:0:1"
msgid "Surely there's got to be<br>something I can do..."
msgstr "Неужели я никак<br>не могу помочь?.."

#. ja: ないか…<br>ちゃんと休憩しよう
#. de: Nein? Dann leg ich mich wieder hin.
#. fr: Rien à faire. Profitons-en pour se reposer.
msgctxt "Balloon:4059:0:1"
msgid "...Or not. Back to my bunk."
msgstr "...Ну и ладно. Пойду прилегу."

#. ja: やる気が…でない…
#. de: Irgendwie fehlt mir heute die Lust.
#. fr: Pfiou... J'ai pas la motivation, là...
msgctxt "Balloon:4060:0:1"
msgid "Really can't be bothered..."
msgstr "Что-то совсем не хочется шевелиться..."

#. ja: こっちはあと一息だ
#. de: Es fehlt nicht mehr viel und das Handwerkerviertel steht.
#. fr: On a presque terminé les travaux ici.
msgctxt "Balloon:4061:0:1"
msgid "A little more and it'll be finished! You'll see!"
msgstr "Ещё немного — и всё будет готово! Вот увидишь!"

#. ja: これはなかなか…
#. de: Ein neuer Schemel? Hm, solche Investitionen wollen reiflich überlegt sein.
#. fr: Ah, ils sont vraiment bien faits ces tabourets.
msgctxt "Balloon:4062:0:1"
msgid "Impressive craftsmanship..."
msgstr "Мастерская работа..."

#. ja: こうしてると<br>なんだか…
#. de: Weißt du noch?
#. fr: Discuter toutes les deux dans la rue, comme ça... J'ai l'impression de nous revoir étant enfants...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4063:0:1"
msgid "Just watching everyone work<br>makes me feel...I don't know..."
msgstr "Смотрю, как все работают,<br>и такое чувство... Сам не знаю..."

#. ja: うん、懐かしいね
#. de: Ja, es sieht alles aus wie früher.
#. fr: Oui, ça rappelle de bons souvenirs.
msgctxt "Balloon:4064:0:1"
msgid "...Like we've turned a corner?"
msgstr "...Будто мы преодолели трудный период?"

#. ja: さすがね！<br>数は十分そう
#. de: Prächtig! Und wie sie leuchten!
#. fr: Les lanternes ont l'air de bien avancer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4065:0:1"
msgid "Excellent work! This should be<br>more than enough!"
msgstr "Отличная работа! Этого<br>должно хватить с лихвой!"

#. ja: 灰の準備も<br>しておかないと
#. de: Hm, ich sollte etwas Holz nachlegen.
#. fr: Il faudra bientôt s'occuper des cendres.
msgctxt "Balloon:4066:0:1"
msgid "We'll need to add ash soon..."
msgstr "Скоро надо будет подсыпать золы..."

#. ja: 久々すぎて<br>腕が落ちてない？
#. de: Du hast nichts verlernt, wie ich sehe.
#. fr: Alors, tu n'as pas trop perdu la main<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4067:0:1"
msgid "Arms holding up? Even<br>though it's been a while?"
msgstr "Руки ещё слушаются? Столько<br>времени прошло!"

#. ja: はは、まったくだ！
#. de: Ha ha! Ich bin immer noch der gleiche Tölpel!
#. fr: Ah ah<nbsp>! Ça s'oublie pas<nbsp>!
msgctxt "Balloon:4068:0:1"
msgid "I could do this all day!"
msgstr "Я бы мог так целый день!"

#. ja: ふふ…いい感じだ
#. de: Gut sieht's hier aus.
#. fr: Parfait. Ça commence à prendre forme.
msgctxt "Balloon:4069:0:1"
msgid "Looking good..."
msgstr "Красота..."

#. ja: よっこらせ！
#. de: Das geht ins Kreuz<nbsp>...
#. fr: Allez. Oh hisse<nbsp>!
msgctxt "Balloon:4070:0:1"
msgid "Hurrrgh!"
msgstr "Хр-р-р!"

#. ja: 苦労した甲斐はあったよ
#. de: Beim Schöpfen kommt man ganz schön ins Schwitzen.
#. fr: J'en ai bavé, mais le résultat est là<nbsp>!
msgctxt "Balloon:4071:0:1"
msgid "By the kami, I'm spent!"
msgstr "Ками свидетели, я вымотался!"

#. ja: やっぱり<br>こっち用じゃないな
#. de: Nein, wir haben das nicht bestellt.
#. fr: J'ai vérifié, on n'a pas commandé de bois.
msgctxt "Balloon:4072:0:1"
msgid "No, this isn't the place."
msgstr "Нет, это не сюда."

#. ja: どこに持っていけば…
#. de: Und wo soll ich's dann hinbringen?
#. fr: Ben, je dois les apporter où alors<nbsp>? C'est lourd ces machins.
msgctxt "Balloon:4073:0:1"
msgid "...Just tell me where to take it."
msgstr "...Только скажите, куда отнести."

#. ja: 車前会からは何て？
#. de: Was weiß ich! Frag doch bei der Shazenkai noch mal nach.
#. fr: Le Shazenkai vous avait dit quoi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4074:0:1"
msgid "What did the Shazenkai<br>fellow say again?"
msgstr "Что там говорил человек<br>из Садзэнкая?"

#. ja: どこへ<br>いっちゃったんだろ…
#. de: Wo kann er denn nur sein?
#. fr: Où peut-il bien être...<nbsp>?
msgctxt "Balloon:4075:0:1"
msgid "I wonder where he went..."
msgstr "Интересно, куда он подевался..."

#. ja: お年寄りだけじゃ<br>厳しいみたいで…
#. de: Besonders die Älteren haben es schwer<nbsp>...
#. fr: Ça risque d'être compliqué pour des personnes âgées.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4076:0:1"
msgid "Really, it's far too much for<br>the elders to handle..."
msgstr "Для старейшин это, конечно,<br>слишком тяжёлая работа..."

#. ja: 高い所はにがてなんだ…
#. de: Ich hab Höhenangst<nbsp>...
#. fr: Tout ce qui est en hauteur, c'est décidément pas pour moi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4077:0:1"
msgid "...Actually, I, uh, I don't<br>really like heights..."
msgstr "...Вообще-то, я, ну...<br>высоты не очень люблю..."

#. ja: イカサマしてる悪い子は<br>いないかしら…
#. de: Ich habe scharfe Augen. Wenn einer auch nur <i>versucht</i>, eine Lightning-Karte aus seinem Ärmel zu ziehen, melde ich ihn der Triple Triad-Meisterin.
#. fr: Le prochain qui sort une carte de sa manche va passer un sale quart d'heure.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4078:0:1"
msgid "Anyone here caught cheating<br>answers to <i>me</i>, understand?"
msgstr "Попадётся кто жульничать —<br>будет иметь дело <i>со мной</i>, ясно?"

#. ja: つ、次こそは…<br>一攫千金でっす
#. de: Wieder nix! Aber beim nächsten Mal werde ich reich, das spüre ich in meinen Achselhöhlen.
#. fr: J'ai encore raté le Méga Cactpot... Pas grave<nbsp>! La prochaine, c'est la bonne<nbsp>!
msgctxt "Balloon:4079:0:1"
msgid "Next time. Next time I'll hit the cactpot."
msgstr "В следующий раз. В следующий раз точно сорву куш."

#. ja: プレゼントにまっしぐら<br>すごいです～
#. de: Herr Hildibrand! Was für ein galanter Hechtsprung!
#. fr: À moi les jolis cadeaux<nbsp>!!!♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4080:0:1"
msgid "A present? But it's not<br>even my nameday!"
msgstr "Подарок? Но у меня же<br>даже не именины!"

#. ja: いや、チョコボレースで勝負だ！
#. de: Beim Chocobo-Rennen häng ich dich ab!
#. fr: Nan<nbsp>! On va rrrégler nos comptes aux courses de chocobos, un point c'est tout<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4081:0:1"
msgid "Hells take your cards!<br>I say we race chocobos!"
msgstr "К чёрту карты!<br>Лучше на чокобо наперегонки!"

#. ja: トリプルトライアドで勝負だ
#. de: Und beim Triple Triad ziehe ich dir die Hosen aus!
#. fr: Puisque c'est comme ça, j'te défie à Trrriple Triade<nbsp>!
msgctxt "Balloon:4082:0:1"
msgid "We should play Triple Triad!"
msgstr "Сыграем в тройную триаду!"

#. ja: 警備隊の慰安といっても<br>羽目を外しすぎるなよ
#. de: Verspiel nicht wieder deinen ganzen Sold. Halt dir wenigstens genug Gil für den Rückflug nach Velodyna zurück.
#. fr: Garde-frontières, ça doit pas êtrrre facile, mais il y a des limites au bon temps, non<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4083:0:1"
msgid "Don't stray too far,<br>got that? I promised to<br>keep an eye on you."
msgstr "Не уходи далеко,<br>ясно? Я обещал<br>присматривать за тобой."

#. ja: オレの勝負運を<br>見せてやるぜ！
#. de: Ich bin unschlagbaaar!
#. fr: Je crois en l'âme des cartes<nbsp>! Je suis imbattable<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4084:0:1"
msgid "I <i>will</i> have that bunny suit!"
msgstr "Я <i>обязательно</i> заполучу этот костюм зайки!"

#. ja: そうか？<br>気のせいだろう
#. de: Nicht, dass ich wüsste. Obwohl, dieser Rosenduft<nbsp>...
#. fr: Lui, là<nbsp>? Si tu veux mon avis, tu te fais des idées.
msgctxt "Balloon:4085:0:1"
msgid "'Tis your mind playing tricks on you. Nothing more."
msgstr "Тебе показалось. Не более того."

#. ja: あの人…<br>見覚えがあるような…？
#. de: Kennen wir den da drüben nicht von irgendwoher?
#. fr: Je jurerais avoir déjà vu cet homme masqué quelque part...
msgctxt "Balloon:4086:0:1"
msgid "I swear I've seen him somewhere before..."
msgstr "Клянусь, я где-то уже его видел..."

#. ja: バニーちゃんは登らんのか？
#. de: Ich geh hier nicht weg, bis ich ein Goldhäschen da hochsteigen gesehen habe.
#. fr: Je me demande si la petite Abbelina a déjà essayé de faire l'ascension...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4087:0:1"
msgid "You ladies head up first.<br>I'll take the rear..."
msgstr "Леди, поднимайтесь первыми.<br>Я пойду последним..."

#. ja: つい採掘したくなる山ね…
#. de: Pappmaché. Da ist nichts zu schürfen.
#. fr: Tous ces rochers... Ça me donne envie d'aller y planter ma pioche.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4088:0:1"
msgid "You'll take my pickaxe to the<br>eye should you try anything."
msgstr "Попробуешь что-нибудь выкинуть —<br>получишь киркой в глаз."

#. ja: しゅ～<br>煌びやかな趣向じゃのう
#. de: Dieser Häutungszyklus ist mein Glückssszyklus! Ich spür's in jeder Schuppe!
#. fr: Mais ça brille, je ne peux pas me retenir<nbsp>! Ssss...
msgctxt "Balloon:4089:0:1"
msgid "Don't be such a ssspoilsport."
msgstr "Не будь таким занудой."

#. ja: 素晴らしい肉体美…<br>うふふふふ…
#. de: Ich steh auf durchtrainierte Körper!
#. fr: Hi hi hi<nbsp>! Tous ces corps musclés et plein de sueur...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4090:0:1"
msgid "Such magnificent muscles.<br>Heh heh heh..."
msgstr "Какие великолепные мышцы...<br>Хе-хе-хе..."

#. ja: 子供たちの笑顔が<br>ご褒美です！
#. de: Die Kinder sehen so glücklich aus!
#. fr: Les enfants sont si joyeux...<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4091:0:1"
msgid "When the children are happy,<br>Zhloe's happy too!"
msgstr "Когда дети счастливы,<br>счастлива и Жло!"

#. ja: ケビちゃん<br>お祭り楽しいね！
#. de: Na, T'kebbe, gefällt dir das Fest?
#. fr: Quelle fête...<nbsp>! Pas vrrrai, T'kebbe<nbsp>?
msgctxt "Balloon:4092:0:1"
msgid "I love festivals, don't you, T'kebbe?"
msgstr "Я обожаю фестивали, а ты, Т'кеббе?"

#. ja: ボク、すっごく楽しい！<br>シロおねえちゃんありがとう！
#. de: Ja, total! Können wir noch länger zugucken?
#. fr: J'adorrre les Feux de la Mort<nbsp>! Merci de nous avoir emmenés, Zhloe<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4093:0:1"
msgid "This is so much fun!<br>Thank you, Miss Zhloe!"
msgstr "Как же весело!<br>Спасибо, мисс Жло!"

#. ja: 素材はどうします？
#. de: Sag schon. Was fehlt denn noch?
#. fr: D'accord. Et comment on va faire pour les matériaux<nbsp>?
msgctxt "Balloon:4094:0:1"
msgid "Some of the wood is missing..."
msgstr "Древесины не хватает..."

#. ja: こんにちは<br>様子はどうだい？
#. de: Wie geht's voran?
#. fr: Bonjour. Comment avancent les travaux de votre côté<nbsp>?
#. macro: <if ($gn11 < 12)><if ($gn11 < 4)>evening<else>day</if><else><if ($gn11 < 17)>day<else>evening</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 12 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gn11 < 4)>evening<else>day</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 4 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gn11 < 17)>day<else>evening</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 17 (condition: may be reworded, restructured, added, or dropped)
msgctxt "Balloon:4095:0:1"
msgid "How fare you this <if ($gn11 < 12)><if ($gn11 < 4)>evening<else>day</if><else><if ($gn11 < 17)>day<else>evening</if></if>?"
msgstr "Как поживаете этим <if ($gn11 < 12)><if ($gn11 < 4)>вечером<else>днём</if><else><if ($gn11 < 17)>днём<else>вечером</if></if>?"

#. ja: おおむね順調ですよ
#. de: Alles nach Plan, Meister.
#. fr: Plutôt bien, dans l'ensemble.
msgctxt "Balloon:4096:0:1"
msgid "Well enough, well enough."
msgstr "Всё хорошо, всё хорошо."

#. ja: こんにちは<br>具合はどうだい？
#. de: Wie läuft's da oben?
#. fr: Hé oh<nbsp>! Tout va bien chez vous<nbsp>!?
msgctxt "Balloon:4097:0:1"
msgid "Working hard, or hardly working?"
msgstr "Работаешь или только делаешь вид?"

#. ja: 作業はぼちぼちだが<br>楽しくやってますよ
#. de: Könnte schneller gehen, aber heute hol ich was auf.
#. fr: On en voit le bout<nbsp>!
msgctxt "Balloon:4098:0:1"
msgid "Having the time of my life!"
msgstr "Работа потихоньку идёт, зато весело!"

#. ja: あまり根詰めないように
#. de: Übertreib's nicht! Wir liegen gut im Zeitplan.
#. fr: Tirez pas trop sur la corde non plus, hein<nbsp>!
msgctxt "Balloon:4099:0:1"
msgid "Hah! Well, try not to overdo it."
msgstr "Ха! Только не переутомись."

#. ja: こんな…もんか…？
#. de: Hat der Barren einen Knick oder meine Optik?
#. fr: Hé hé... Tu vas le sentir dans les bras qu'il disait<nbsp>!
msgctxt "Balloon:4100:0:1"
msgid "Like...like this?"
msgstr "Вот... так?"

#. ja: 返却箱の方で<br>よかったよな？
#. de: Wo soll das hin? Nach hinten ins Lager? \<schwitz>
#. fr: Je peux mettre cette caisse avec les autres<nbsp>?
msgctxt "Balloon:4101:0:1"
msgid "Shall I set it down by the reclamation box?"
msgstr "Поставить у ящика для возврата?"

#. ja: ああ、よろしく頼んだ！
#. de: Ja, bitte.
#. fr: Ah<nbsp>! Oui, s'il vous plaît<nbsp>!
msgctxt "Balloon:4102:0:1"
msgid "Aye, if it's no trouble!"
msgstr "Да, конечно!"

#. ja: 任せてくれよ
#. de: Kein Problem. \<keuch>
#. fr: C'est parti.
msgctxt "Balloon:4103:0:1"
msgid "Not at all."
msgstr "Не вопрос."

#. ja: 新しい荷物を運んできたぞ
#. de: Die neuen Güter sind da. \<schwitz>
#. fr: J'ai une autre caisse pour vous.
msgctxt "Balloon:4104:0:1"
msgid "More for the pile!"
msgstr "Ещё в общую кучу!"

#. ja: おっ、どこに置いて<br>もらおうかな…
#. de: Äh, Moment. Ich mach Platz.
#. fr: Super. Attendez, je vais voir où vous pouvez la poser.
msgctxt "Balloon:4105:0:1"
msgid "Ah, where to put it..."
msgstr "Так... куда бы её поставить?"

#. ja: 交ざらないよう<br>ゆっくりでいいぞ
#. de: Nur keine Eile<nbsp>... \<keuch>
#. fr: Prenez votre temps. Faudrait pas que vous vous emmêliez les pinceaux.
msgctxt "Balloon:4106:0:1"
msgid "Don't rush on my account."
msgstr "Не торопись из-за меня."

#. ja: おにいさん来ないなぁ…
#. de: Wo bleibt mein Trödelbruder denn nur?
#. fr: Toujours pas là... Mais qu'est-ce qu'il fait<nbsp>?
msgctxt "Balloon:4107:0:1"
msgid "Where could he be...?"
msgstr "Ну где же он..."

#. ja: 薬は…まだなのか…
#. de: Ist meine Medizin immer noch nicht da?
#. fr: Et... Et les remèdes<nbsp>?
msgctxt "Balloon:4108:0:1"
msgid "Medicine... I need more..."
msgstr "Лекарство... Мне нужно ещё..."

#. ja: 材料の薬草が<br>足りないそうだ
#. de: Angeblich fehlt es an den nötigen Kräutern.
#. fr: On manque de plantes médicinales.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4109:0:1"
msgid "Sorry, friend, but I'm<br>short this one herb..."
msgstr "Прости, дружище, но одной травы<br>у меня не хватает..."

#. ja: それさえ見つかれば<br>あるいは…
#. de: Sobald die da sind, geht's ganz schnell.
#. fr: Si seulement on en avait...
msgctxt "Balloon:4110:0:1"
msgid "If I had it, I could sort you out."
msgstr "Будь она у меня, я бы тебя вылечил."

#. ja: …どのあたりに<br>生えている？
#. de: Und wo wachsen die? In Ilsabard?
#. fr: Vous... Vous savez où elles poussent<nbsp>?
msgctxt "Balloon:4111:0:1"
msgid "...Tell me where it grows."
msgstr "...Скажи, где она растёт."

#. ja: グゥゥゥ～
#. de: Urrks ...
#. fr: Hnnngh...
msgctxt "Balloon:4112:0:1"
msgid "Hnnngh..."
msgstr "М-м-м..."

#. ja: ガオォォ～
#. de: Graaarrr!
#. fr: Graaarrrgh<nbsp>!
msgctxt "Balloon:4113:0:1"
msgid "Graaaghhh..."
msgstr "Гр-р-ра-а!"

#. ja: グルルルル…
#. de: Grrr ...
#. fr: Grrrrrr...
msgctxt "Balloon:4114:0:1"
msgid "Grrrrrr..."
msgstr "Р-р-р-р..."

#. ja: ブゥゥゥ～
#. de: Hmmm ...
#. fr: Hmmm...
msgctxt "Balloon:4115:0:1"
msgid "\\<smack> \\<slurp>"
msgstr "<i>Чмок... хлюп...</i>"

#. ja: 料理が冷めてやがる…
#. de: Da friert einem ja das Essen an der Gabel fest!
#. fr: Tss... La bidoche gelée, c'est pas mon truc...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4116:0:1"
msgid "What good's wine when it<br>freezes in the bloody bottle?"
msgstr "Какое, к чёрту, вино, если оно<br>замёрзло прямо в бутылке?"

#. ja: ああ、生き返る…
#. de: Hach, schön mollig warm.
#. fr: Ahh, un peu de chaleur... Je commençais à avoir les orrreilles congelées.
msgctxt "Balloon:4119:0:1"
msgid "Ahh, feel that heat!"
msgstr "Ах, вот это тепло!"

#. ja: さすが名工の作品ね
#. de: Diesen Gerolt müssen <i>wir</i> uns warmhalten.
#. fr: Gerolt fabrique les meilleures bouilloires. Ça, il n'y a pas doute.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4120:0:1"
msgid "Gerolt's definitely got a knack<br>for more than weapons."
msgstr "У Герольта, похоже, талант<br>не только к оружию."

#. ja: 調査前に除雪が必要ね…
#. de: Bevor wir das untersuchen können, müssen wir erst mal Schnee schippen.
#. fr: Il va falloir déblayer toute cette neige avant qu'on puisse se mettre au travail.
msgctxt "Balloon:4121:0:1"
msgid "Think it's worth digging out?"
msgstr "Думаешь, стоит откопать?"

#. ja: それ、誰がやるニャ…？
#. de: Wir?! Du lässt ja doch wieder nur mich schaufeln!
#. fr: Heu... et qui va s'y coller<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4122:0:1"
msgid "Depends on who's got to<br>do the digging."
msgstr "Смотря кому копать придётся."

#. ja: 寒いとお腹が空くわ…
#. de: Die Kälte macht ganz schön hungrig.
#. fr: Le froid, ça m'ouvre l'appétit. J'ai une de ces faims<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4123:0:1"
msgid "Wonder if it'll cook faster<br>if we keep staring."
msgstr "Интересно, если на неё пялиться,<br>приготовится быстрее?"

#. ja: 煮込み終わるまで待ってろ
#. de: Ja, ja, ich beeil mich ja schon.
#. fr: Oui ben, attends que ce soit cuit quand même.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4124:0:1"
msgid "Eh, not like I've got<br>anywhere else to be..."
msgstr "Да никуда я не спешу..."

#. ja: 名工の道具に異常なし！
#. de: Großartige Arbeit!
#. fr: Serre-joints, tenailles, marteaux... Tous sont encore comme neufs<nbsp>! Ça c'est des outils de bonne facture<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4125:0:1"
msgid "A place for everything and<br>everything in its place..."
msgstr "Порядок во всём и всё на месте..."

#. ja: 凍りついて使えんとは…
#. de: Ich wollte ja Schnee schippen, aber die Schaufel ist festgefroren!
#. fr: Même le puits a gelé. C'est dingue...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4126:0:1"
msgid "Even a shallow well<br>shouldn't freeze like this!"
msgstr "Даже такой мелкий колодец<br>не должен замерзать!"

#. ja: 小金通りとは…<br>どこじゃ？
#. de: Wo geht's bitte zur Kogane-dori?
#. fr: C'est par où, Kogane-dori...<nbsp>? Ssss...
msgctxt "Balloon:4127:0:1"
msgid "Thisss place is a maze!"
msgstr "Ну и лабиринт тут!"

#. ja: 逃がすものかぁ～<br>カゲヤマ～
#. de: Kageyama, ich bin dir auf den<nbsp>...... Fersen!
#. fr: Je t'aurai, Kageyamaaaa... Je t'auraaaai<nbsp>!
msgctxt "Balloon:4128:0:1"
msgid "Kageyama must not escape us."
msgstr "Не уйдёшь от нас, Кагэяма!"

#. ja: 稲作をやるのに<br>必要なものは…
#. de: Um Reis anzubauen, braucht man das und das und<nbsp>... ja, das auch.
#. fr: Hmm... Si on veut cultiver du riz ici, il faudra ça, ça... ah et ça aussi...
msgctxt "Balloon:4129:0:1"
msgid "If I have calculated the rice-per-fulm ratio correctly..."
msgstr "Если я верно рассчитал норму риса на фулм..."

#. ja: ふう…田植えは<br>骨が折れるわね
#. de: Puh, das Einsetzen der Pflänzchen geht wirklich in die Knochen.
#. fr: Je crois que mon dos gardera à jamais les séquelles de ces plantations...
msgctxt "Balloon:4130:0:1"
msgid "This is awfully thirsty work!"
msgstr "Ух, от этой работы пить хочется!"

#. ja: 丁寧かつ迅速に…
#. de: Dieser Stengel ist besonders hartnäckig. Oder ist die Sichel stumpf?
#. fr: Le tout, c'est d'être rapide et précise... rapide... et précise...
msgctxt "Balloon:4131:0:1"
msgid "I have come to harvest your souls! Errr...I mean rice."
msgstr "Я пришла пожинать ваши души! То есть... рис."

#. ja: 小石を踏んだら…<br>痛いからな…
#. de: Die großen Brocken sind weg, aber die kleinen Steinchen müssen auch raus.
#. fr: Saletés de cailloux... En plus, ils font mal quand on marche dessus<nbsp>!
msgctxt "Balloon:4132:0:1"
msgid "Picking up all these stones is not my idea of fun."
msgstr "Поднимать все эти камни —<br>не самое весёлое занятие."

#. ja: こっちの様子はどうだい？
#. de: Wie sieht's hier aus?
#. fr: Ça avance<nbsp>?
msgctxt "Balloon:4133:0:1"
msgid "So, how does it look?"
msgstr "Ну как тут дела?"

#. ja: 小石や破片が多くて…
#. de: Steine, Scherben, rostige Nägel<nbsp>... Das wird noch was dauern.
#. fr: Couci-couça. C'est que c'est rempli de cailloux...
msgctxt "Balloon:4134:0:1"
msgid "Full of weeds and stones, I'm afraid."
msgstr "Боюсь, тут полно сорняков и камней."

#. ja: よし、手伝おう
#. de: Ich helf dir.
#. fr: Ah oui, c'est pas marrant, ça. Je vais te donner un coup de main.
msgctxt "Balloon:4135:0:1"
msgid "“Many hands make light work,” they say."
msgstr "Говорят, много рук — и работа спорится."

#. ja: 次は向こうの草とりを…
#. de: Da drüben ist ja schon wieder Unkraut nachgewachsen!
#. fr: Gare à vous les mauvaises herbes, j'arrive<nbsp>!
msgctxt "Balloon:4136:0:1"
msgid "I spy some more weeds that want pulling up."
msgstr "Вон ещё сорняки, пора выдрать."

#. ja: なんと愛らしい佇まい…
#. de: Ist das eine Vogelscheuche oder Kunst?
#. fr: Ah, il y a pas à dire. Je le trouve adorable<nbsp>!
msgctxt "Balloon:4137:0:1"
msgid "It may not be lifelike, but it keeps the crows away!"
msgstr "Пусть на чучело не похожа, зато ворон отпугивает!"

#. ja: 次に必要なのは…
#. de: Ach ja, das wollte ich ja auch noch bei der Shazenkai bestellen<nbsp>...
#. fr: Bien, ça c'est bon. Maintenant, il me faut...
msgctxt "Balloon:4138:0:1"
msgid "Oh...I knew I should've labeled these boxes."
msgstr "Эх... надо было подписать эти ящики."

#. ja: よーしよしよし<br>一緒にがんばろうね
#. de: Braaav, braaav<nbsp>... Jetzt ruh dich erst mal aus.
#. fr: C'est bien mon beau. Tu vois le travail qu'on arrive à abattre ensemble<nbsp>!?
msgctxt "Balloon:4139:0:1"
msgid "Hold still so I can get this mud out of your fur!"
msgstr "Смирно, дай-ка грязь из шерсти вычешу!"

#. ja: よく煮えているわね
#. de: Hoffentlich reicht's. Die Arbeiter werden hungrig sein.
#. fr: Parfait, la cuisson avance bien.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4140:0:1"
msgid "In the morning, laughing happy fish heads.♪<br>In the evening, floating in the soup!♪"
msgstr "Утром рыбьи головы смеются счастливо.♪<br>А к вечеру плавают в супе!♪"

#. ja: あとは…隠し味を…
#. de: Wo ist denn meine geheime Zutat?
#. fr: Il ne me reste plus qu'à donner un petit arrière-goût de... Hmm...
msgctxt "Balloon:4141:0:1"
msgid "And now for my secret ingredient... Once I find it, anyway."
msgstr "Теперь добавлю секретный ингредиент... Вот только найду его."

#. ja: 次は酒用の米もつくるか
#. de: Ein Teil der Ernte sollten wir für hausgemachten Reiswein zurückhalten.
#. fr: Bon, quand est-ce qu'on plante du riz à saké<nbsp>!? Les réserves s'amenuisent<nbsp>!
msgctxt "Balloon:4142:0:1"
msgid "I'm telling you! We should be making sake!"
msgstr "Да говорю же! Надо сакэ варить!"

#. ja: トンテンカンってね
#. de: Immer schön den Nagel im Auge behalten<nbsp>...
#. fr: Encore quelques petits coups, et ces tenons seront enfoncés comme il faut.
msgctxt "Balloon:4143:0:1"
msgid "The nail that sticks out gets hammered down."
msgstr "Кто высовывается, того и заколачивают."

#. ja: いい眺めだなぁー
#. de: Tolle Aussicht hat man von hier oben.
#. fr: Ah... On a une belle vue d'ici...
msgctxt "Balloon:4144:0:1"
msgid "I suppose I will have to climb down at some point."
msgstr "Придётся когда-нибудь спуститься, наверное."

#. ja: 屋根に使う木材は…
#. de: Was waren nochmal die richtigen Bretter fürs Dach?
#. fr: Quel bois on devrait utiliser pour le toit...<nbsp>?
msgctxt "Balloon:4145:0:1"
msgid "What should we use for the roof?"
msgstr "Какую древесину взять на крышу?"

#. ja: ケヤキの木がいいだろう
#. de: Keyaki. Nimm die Keyaki-Bretter.
#. fr: Du keyaki, ça fera l'affaire.
msgctxt "Balloon:4146:0:1"
msgid "Zelkova should do the trick."
msgstr "Дзелькова подойдёт."

#. ja: ありがとう、用意しておくよ
#. de: Ah, danke. Mach ich ...
#. fr: Merci, je vais en chercher derrière.
msgctxt "Balloon:4147:0:1"
msgid "Leave it to me!"
msgstr "Предоставь это мне!"

#. ja: ど、どれだ…？
#. de: Wie sehen die nochmal aus ...?
#. fr: Heu... Ça ressemble à quoi du keyaki...<nbsp>?
msgctxt "Balloon:4148:0:1"
msgid "Ummm... Which ones are zelkova?"
msgstr "Эм... Где тут дзелькова?"

#. ja: どうやって上に<br>運べばいいんだ…？
#. de: Und wie bekomme ich die jetzt da hoch?
#. fr: Comment je vais hisser ça là-haut, moi...<nbsp>?
msgctxt "Balloon:4149:0:1"
msgid "Carry the timber up the ladder? Easier said than done!"
msgstr "Поднять брёвна по лестнице? Легче сказать, чем сделать!"

#. ja: こいつで全部そろったな！
#. de: Das sollten die letzten sein.
#. fr: Et voilà<nbsp>! C'est les dernières<nbsp>!
msgctxt "Balloon:4150:0:1"
msgid "Just like carrying a wife over the threshold. But with timber."
msgstr "Как невесту через порог перенести. Только вместо невесты — брёвна."

#. ja: ここには何を建てるんで？
#. de: Was wird hier gebaut?
#. fr: Alors, vous allez bâtir quoi ici<nbsp>?
msgctxt "Balloon:4151:0:1"
msgid "What do you have in mind?"
msgstr "Что вы задумали?"

#. ja: 精米は問題なさそうね
#. de: Läuft tadellos.
#. fr: On va en décortiquer du riz avec ces beaux pilons tout neufs.
msgctxt "Balloon:4152:0:1"
msgid "Should be ready in a few bells..."
msgstr "Через пару колоколов будет готово..."

#. ja: どの本にしようかな…
#. de: Nehm ich ein blaues oder lieber ein rotes?
#. fr: Qu'est-ce que je vais lire ensuite...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4153:0:1"
msgid "What's this? <i>When in Doma, Do as the Domans Do: A Guide for Ijin</i>..."
msgstr "Что это? <i>В Доме — как домосцы: путеводитель для гайдзинов</i>..."

#. ja: ふむふむ…
#. de: Aha ... Mhm ...
#. fr: Hmmhmm... (marmonne)... Hmmm...
msgctxt "Balloon:4154:0:1"
msgid "“The Eorzean diet largely consists of popotoes rather than rice.”"
msgstr "«Основу эорзейского рациона составляют картофелины, а не рис»."

#. ja: む、むにゃ…
#. de: Nicht ... einschlafen ...
#. fr: Zzzz... ZZZZ... ZZhm<nbsp>!? H-hein<nbsp>?
msgctxt "Balloon:4155:0:1"
msgid "I was just resting my eyes!"
msgstr "Я просто глаза прикрыл!"

#. ja: 眠くない…<br>ねむく…ない…
#. de: Ich bin nicht müde.<br>Ich bin nicht<nbsp>... müde<nbsp>...
#. fr: J'ai pas sommeil, j'ai pas sommeil, j'ai pas... sommeil, j'ai pas... szzzzZZZ...
msgctxt "Balloon:4156:0:1"
msgid "All this reading is making me sleepy!"
msgstr "От чтения так и клонит в сон!"

#. ja: クルクルまわれー<br>かざぐるまー
#. de: Shiun, sieh doch mal, wie es sich dreht!
#. fr: Regarde<nbsp>! Regarde comment il tourne, mon kazaguruma<nbsp>!
msgctxt "Balloon:4157:0:1"
msgid "Spinny spin spin!"
msgstr "Крутись-крутись-крутись!"

#. ja: 西方のお話、もっと聞かせて！
#. de: Und gibt es in Eorzea auch vier Jahreszeiten?
#. fr: Raconte-moi une histoire sur l'Occident<nbsp>! S'il te plaît<nbsp>!
msgctxt "Balloon:4158:0:1"
msgid "Tell me more about Eorzea!"
msgstr "Расскажи ещё про Эорзею!"

#. ja: ぐっ…腰にくるな…
#. de: Wo ist er hin? Halt mal kurz, hat er gesagt, und dann<nbsp>...
#. fr: Qu'est-ce qu'elle est lourde cette caisse<nbsp>! Je vais le sentir passer demain...
msgctxt "Balloon:4159:0:1"
msgid "I wonder who carried all these big crates?"
msgstr "Интересно, кто все эти ящики таскал?"

#. ja: 歪みはねぇかな…
#. de: Sieht gerade aus ...
#. fr: Je rêve ou ça plie...<nbsp>? Non c'est moi qui me fais des idées.
msgctxt "Balloon:4160:0:1"
msgid "Seems straight enough to me."
msgstr "Вроде ровно."

#. ja: 次は屋根かなぁ
#. de: Fehlt nur noch das Dach.
#. fr: Ahh... On va devoir s'attaquer au toit, maintenant.
msgctxt "Balloon:4161:0:1"
msgid "I'll be a lot happier once we get that roof up!"
msgstr "Вот крышу поставим — тогда я и успокоюсь!"

#. ja: しっかり固定しないと危ないな…
#. de: Acht dicke Taue, das sollte halten.
#. fr: Les troncs sont bien fixés...<nbsp>? Il s'agirait pas que quelqu'un s'en prenne un sur la caboche.
msgctxt "Balloon:4162:0:1"
msgid "Can't have any of these logs rolling off and squashing someone!"
msgstr "Нельзя, чтобы брёвна скатились и кого-нибудь придавили!"

#. ja: これから、頑張っていかなくては
#. de: Es gibt noch so viel zu tun.
#. fr: Nous allons devoir donner le meilleur de nous-mêmes.
msgctxt "Balloon:4163:0:1"
msgid "And she told me to mind my own business!"
msgstr "А она велела не лезть не в своё дело!"

#. ja: 次はこれを試すかの…
#. de: Jetzt probier ich mal den hier.
#. fr: Et si je m'essayais à l'arc, tiens...
msgctxt "Balloon:4164:0:1"
msgid "Perhaps I will have more luck with this one?"
msgstr "Может, с этим повезёт больше?"

#. ja: 筋肉はッ裏切らないッ
#. de: Was man nicht auf dem Kopf hat, muss man unter den Armen haben.
#. fr: La forme<nbsp>! Gnnn<nbsp>! ça...<nbsp>! Gnnn<nbsp>! s'entretient<nbsp>!!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4165:0:1"
msgid "I'm not pushing myself up,<br>I'm pushing the earth down!"
msgstr "Я не себя поднимаю,<br>а Землю опускаю!"

#. ja: 捕り物に備えて、<br>足腰も鍛えないとなッ
#. de: Für jede hunderte Kniebeuge wächst dir ein Haar, hat der Hauptmann gesagt.
#. fr: Toujours travailler le bas du corps<nbsp>! Sans ça, les crapules nous fileront entre les doigts<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4166:0:1"
msgid "I hear squats cure baldness!<br>If not, I could always buy a wig..."
msgstr "Говорят, приседания от облысения помогают!<br>А нет — куплю парик..."

#. ja: 大分そろってきたな
#. de: Es ist ein hübsches Arsenal zusammengekommen.
#. fr: On commence à avoir un bel arsenal.
msgctxt "Balloon:4167:0:1"
msgid "Not a bad selection."
msgstr "Неплохой набор."

#. ja: もっと腰を低く！
#. de: Mehr in die Knie gehen!
#. fr: Plie plus les genoux<nbsp>!
msgctxt "Balloon:4168:0:1"
msgid "Put your back into it, lad!"
msgstr "Ниже приседай, парень!"

#. ja: コザクラちゃんに伝えておくよ
#. de: Ich werde Kozakura Bescheid sagen.
#. fr: J'en ferai part à Kozakura.
msgctxt "Balloon:4169:0:1"
msgid "These are the resources we need from the Shazenkai."
msgstr "Вот что нам нужно получить от Садзэнкая."

#. ja: 耐久性に問題はないだろうか…
#. de: Man könnte auch den Hals angreifen<nbsp>...
#. fr: Je me demande si ça tiendra quand même...
msgctxt "Balloon:4170:0:1"
msgid "These should hold up..."
msgstr "Надеюсь, выдержат..."

#. ja: 釘が足りなくなってきたな
#. de: Die Nägel sind alle ...
#. fr: Ah, mince, plus de clous...
msgctxt "Balloon:4171:0:1"
msgid "Gah! No more nails! I'll just keep tapping these ones, then."
msgstr "Чёрт! Гвозди кончились! Придётся пока эти забивать."

#. ja: おーい！<br>戸をあけてくれ！
#. de: He! Mach mal einer die Tür auf!
#. fr: Hé<nbsp>! Ouvrez-moi<nbsp>! Je vais lâcher<nbsp>!
msgctxt "Balloon:4172:0:1"
msgid "Would somebody open the door, please?"
msgstr "Эй! Кто-нибудь, откройте дверь!"

#. ja: ひいふうみい…
#. de: Mannmannmann ...
#. fr: Un... Deux... Trois...
msgctxt "Balloon:4173:0:1"
msgid "I could swear I heard a voice..."
msgstr "Клянусь, я слышал чей-то голос..."

#. ja: 解体用の発破は…
#. de: Und der Sprengstoff? Wo ist der Sprengstoff?
#. fr: ... huit, neuf caisses... Mais où est la poudre noire qu'on avait demandée...
msgctxt "Balloon:4174:0:1"
msgid "What should we do with all these leftover explosives?"
msgstr "Куда девать все эти лишние взрывчатые вещества?"

#. ja: そろそろ交代しよう
#. de: Sollen wir mal tauschen?
#. fr: Allez, je vais prendre la relève.
msgctxt "Balloon:4175:0:1"
msgid "Why don't I take over?"
msgstr "Давай я тебя сменю."

#. ja: へい兄貴っ！
#. de: He, ich sprech mit dir!
#. fr: Ça marche<nbsp>! HAN<nbsp>! Laisse-moi encore... HAN<nbsp>! quelques minutes<nbsp>!
msgctxt "Balloon:4176:0:1"
msgid "Take this, Garlean...rubble!"
msgstr "Получай, гарлеанская развалина!"

#. ja: あとひと踏ん張りだな
#. de: Noch ein bisschen, dann ist's geschafft.
#. fr: Pfiou... Le plus dur est fait.
msgctxt "Balloon:4177:0:1"
msgid "By the kami, it's hot out here!"
msgstr "Ками свидетели, ну и жара!"

#. ja: 板も張り替えなくちゃな
#. de: Hier sind neue. Die alten Bretter sehen morsch aus.
#. fr: Ce sera bien plus joli une fois recouvert.
msgctxt "Balloon:4178:0:1"
msgid "Say, friend, you are looking rather “board.” Hur hur!"
msgstr "Слушай, дружище, ты сегодня прямо доска доской! Ха-ха!"

#. ja: ここには…
#. de: Was für Bäume könnten hier wohl passen?
#. fr: Hmm... Qu'est-ce qu'on pourrait faire, ici<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4179:0:1"
msgid "I wandered lonely as a pond...<br>No, that doesn't sound right..."
msgstr "Бродил я одиноко у пруда...<br>Нет, что-то не так звучит..."

#. ja: オ、オレの負けだ…！
#. de: Ich bin unwürdig, ich bin Staub, ich bin Asche!
#. fr: J'accepte ma défaite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4180:0:1"
msgid "Never, never again!<br>This I do solemnly swear..."
msgstr "Никогда, никогда больше!<br>Торжественно клянусь..."

#. ja: この先は危険だが…
#. de: Überleg's dir, draußen ist's gefährlich.
#. fr: C'est trop dangereux par là. Je peux pas vous laisser passer...
msgctxt "Balloon:4181:0:1"
msgid "No one is allowed past this point."
msgstr "Дальше проход запрещён."

#. ja: どうしても<br>薬草を手に入れたいんだ
#. de: Ich hab keine Wahl. Ich brauch die Medizin.
#. fr: Vous comprenez pas, il me faut absolument ces herbes médicinales.
msgctxt "Balloon:4182:0:1"
msgid "But I must have those herbs!"
msgstr "Но мне непременно нужны эти травы!"

#. ja: 狼のお兄さん<br>どこにいるか知らない？
#. de: Hast du den Wolfmann gesehen?
#. fr: Dis, tu sais où est passé mon ami le loup<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4183:0:1"
msgid "I'm looking for a Lupin boy.<br>Have you seen him?"
msgstr "Я ищу мальчика-лупина.<br>Не видели его?"

#. ja: このところ見かけないな
#. de: Hier ist er nicht.
#. fr: Le Lupin, tu veux dire<nbsp>? Je sais pas...
msgctxt "Balloon:4184:0:1"
msgid "Can't say I have."
msgstr "Не припомню."

#. ja: このあたりは監視が厳しいか…？
#. de: Keine Chance. Hier sind zu viele Wachen.
#. fr: La voie est trop bien gardée... Que faire<nbsp>?
msgctxt "Balloon:4185:0:1"
msgid "We cannot see anything from here!"
msgstr "Отсюда ничего не разглядеть!"

#. ja: ひと区切りついたら<br>帰燕館の偵察に向かうぞ！
#. de: Noch ein bisschen, dann sehen wir uns mal das Landhaus genauer an.
#. fr: Bon, le temps d'une petite pause, et ce sera à notre tour de monter la garde au Kienkan<nbsp>!
msgctxt "Balloon:4186:0:1"
msgid "As soon as this is finished, we go in search of Hien!"
msgstr "Как только закончим, отправимся искать Хиэна!"

#. ja: 猫…助けがいらないなら<br>そう言ってくれよ…
#. de: Verdammtes Biest! Wie bist du hier runter gekommen?
#. fr: T'aurais pu le dire que t'avais pas besoin d'aide pour descendre... Satané chat...
msgctxt "Balloon:4187:0:1"
msgid "Wretched cat...I was only trying to help! Now I'm the one who needs saving!"
msgstr "Проклятый кот... Я ведь помочь хотел! Теперь самому спасение нужно!"

#. ja: にゃーん？
#. de: Miau?
#. fr: Miaou<nbsp>?
msgctxt "Balloon:4188:0:1"
msgid "Meow!"
msgstr "Мяу!"

#. ja: 分身っぺな
#. de: Achtung! Ninja-Namazu-Technik<nbsp>... Das Doppelte Ich!
#. fr: Technique de clonage namazu<nbsp>!
msgctxt "Balloon:4189:0:1"
msgid "I am a bunshin, yes, yes."
msgstr "Я — клон, да-да."

#. ja: 変化の術を<br>見せてください！
#. de: Dann zeig mal, wie du dich verwandeln kannst!
#. fr: Montre-moi un peu ce pouvoir qui te rend si fier<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4190:0:1"
msgid "Shapeshifter, eh? Show me<br>what you've got!"
msgstr "Ты умеешь превращаться? Покажи,<br>на что способен!"

#. ja: ならば<br>お前に化けてみせよう
#. de: Klar, kein Problem! Ich verwandle mich einfach in dich!
#. fr: Pas de problème<nbsp>! Je vais me transformer... en <i>toi</i><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4191:0:1"
msgid "Heh, all right!<br>I'll show you “you”!"
msgstr "Ха, ладно!<br>Покажу тебе... тебя!"

#. ja: このとおり<br>どう見てもネズミだろう？
#. de: Jemals 'ne schönere Maus gesehen?
#. fr: Alors<nbsp>? On dirait des jumeaux, pas vrai<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4192:0:1"
msgid "How 'bout it?<br>We could be twins!"
msgstr "Ну как? Вылитые близнецы!"

#. ja: カワウソなんですけどォ！！
#. de: Maus?! Ich bin ein Otter, du Dumpfbacke!
#. fr: Mais je suis une loutre, bon sang<nbsp>!!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4193:0:1"
msgid "A rat? A <i>rat</i>!?<br>I am an otter, good sir!"
msgstr "Крыса? <i>Крыса</i>!?<br>Я выдра, сударь!"

#. ja: 我々のかつての食文化とは…
#. de: Was unsere frühere Esskultur angeht<nbsp>...
#. fr: Laissez-moi vous décrire notre ancienne culture culinaire...
msgctxt "Balloon:4194:0:1"
msgid "We once had cuisine..."
msgstr "Когда-то у нас была кухня..."

#. ja: 可能性の星か…
#. de: Der Stern unbegrenzter Möglichkeiten<nbsp>...
#. fr: La planète de toutes les possibilités, hein...
msgctxt "Balloon:4195:0:1"
msgid "Possibilities abound..."
msgstr "Безграничные возможности..."

#. ja: そうきたか…
#. de: Interessanter Zug ...
#. fr: Un coup... intéressant.
msgctxt "Balloon:4196:0:1"
msgid "A bold move..."
msgstr "Смелый ход..."

#. ja: 火の～用心～！
#. de: Vorsicht mit den Laternen! Die brennen leicht!
#. fr: Faites attention à vos lanternes, vos fours, vos foyers<nbsp>! Prenez garde au feu<nbsp>!
msgctxt "Balloon:4197:0:1"
msgid "See a fire, raise the alarum!"
msgstr "Увидел огонь — бей тревогу!"

#. ja: まるで長い夢から…<br>覚めた様…
#. de: Mir ist, als bin ich aus einem langen Traum erwacht<nbsp>...
#. fr: J'ai l'impression de me réveiller... après un long cauchemar...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4198:0:1"
msgid "At last, the scales have<br>fallen from my eyes..."
msgstr "Наконец-то пелена<br>спала с моих глаз..."

#. ja: 料理が冷めてない…！
#. de: Das Zeug will einfach nicht kalt werden!
#. fr: C'est dingue, c'est encore chaud<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4199:0:1"
msgid "Eyes bigger than<br>my stomach..."
msgstr "Глаза больше желудка..."

#. ja: これぞ理想のテンポ！
#. de: Na? Bei dem Tempo wird dir schwindelig, was?
#. fr: Ah ah, voilà<nbsp>! J'ai le bon rythme, maintenant<nbsp>!
msgctxt "Balloon:4200:0:1"
msgid "How about...this!?"
msgstr "А вот так!?"

#. ja: いつもと同じじゃない？
#. de: Träum weiter.
#. fr: J'vois vraiment pas la différence...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4201:0:1"
msgid "Eh. Same as the last<br>two dozen times..."
msgstr "Да ну. То же самое,<br>что и в прошлый раз."

#. ja: 温かくて…意識が…
#. de: Ist so schön mollig warm hier drin<nbsp>...
#. fr: Cette chaleur, c'est trop bon... Je dormirais bien ici...
msgctxt "Balloon:4202:0:1"
msgid "I could just drift off..."
msgstr "Я бы и задремал..."

#. ja: …ここで寝ちゃダメよ
#. de: He, nicht einschlafen!
#. fr: Va pas te noyer dans le bain, quand même...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4203:0:1"
msgid "You really shouldn't,<br>you know..."
msgstr "Только не надо,<br>слышишь..."

#. ja: よーし、いい子だ…
#. de: Schön still halten, mein Guter, schön still.
#. fr: C'est bien, mon beau.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4204:0:1"
msgid "There, there,<br>that's a good girl..."
msgstr "Ну-ну,<br>умница..."

#. ja: クェクェッ！
#. de: Kweh, kweh!
#. fr: Kwé<nbsp>! Kwé<nbsp>!
msgctxt "Balloon:4205:0:1"
msgid "Kweh, kweh!"
msgstr "Квэ, квэ!"

#. ja: 俺、採掘師じゃないのに…
#. de: Sag mal, seh ich aus wie 'n Minenarbeiter?
#. fr: Je suis pas mineur moi. Tu me rappelles ce que je fais là<nbsp>?
msgctxt "Balloon:4206:0:1"
msgid "I ain't no bloody miner..."
msgstr "Я вообще-то ни черта не шахтёр..."

#. ja: 調査のためよ、我慢して
#. de: Stell dich nicht so an. Ist alles im Namen der Forschung.
#. fr: Tais-toi, c'est pour le bien de l'expédition.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4207:0:1"
msgid "Yes, well, we've all got<br>to help however we can."
msgstr "Да уж, всем нам<br>приходится помогать чем можем."

#. ja: 俺の夢はだな…
#. de: Mein Traum ...
#. fr: Mon rêve, ce serait... Hum...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4208:0:1"
msgid "We ain't gotta dream<br>no more..."
msgstr "Да и мечтать уже<br>не о чем..."

#. ja: 人材求む！　高給保障する！
#. de: Handwerker gesucht! Bieten hervorragende Bezahlung!
#. fr: On a besoin de bras<nbsp>! Salaire garanti<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4209:0:1"
msgid "Help wanted! High wages!<br>Meals provided! "
msgstr "Требуются работники! Высокая зарплата!<br>Кормим бесплатно!"

#. ja: 元気になったもんだね
#. de: Jetzt kommt frischer Wind in die Sache.
#. fr: T'as plus d'entrain qu'avant, dis donc.
msgctxt "Balloon:4210:0:1"
msgid "Things are starting to look up."
msgstr "А дела-то налаживаются."

#. ja: 今日も張り切っていこう！
#. de: Heute geb ich wieder alles!
#. fr: Allez, encore une belle journée de boulot qui s'annonce<nbsp>!
msgctxt "Balloon:4211:0:1"
msgid "Right, then. Let's be about it!"
msgstr "Ну что, за работу!"

#. ja: まともな仕事なら喜んで！
#. de: Bin froh über jeden Auftrag!
#. fr: Enfin un turbin correct<nbsp>! T'peux compter sur moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4212:0:1"
msgid "If the terms are to my liking.<br>I've got options, you know."
msgstr "Если условия меня устроят.<br>А то у меня и другие варианты есть."

#. ja: この通りも変わったぞ
#. de: Diese Straße hat sich verändert ...
#. fr: L'ambiance a changé sur la rue de la Perle.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4213:0:1"
msgid "Folks can say what they like.<br>I'd still hold your purse close."
msgstr "Болтайте что хотите,<br>а кошельки всё равно держите покрепче."

#. ja: 物資が増えたわね
#. de: Gibt hier mehr Waren denn je.
#. fr: Les livraisons se font plus régulières der<shy>niè<shy>re<shy>ment.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4214:0:1"
msgid "Past time we had<br>proper materials."
msgstr "Давно пора было запастись<br>нормальными материалами."

#. ja: 助かるな
#. de: Die Rettung!
#. fr: Et c'est tant mieux<nbsp>!
msgctxt "Balloon:4215:0:1"
msgid "Bloody oath."
msgstr "Вот это помощь."

#. ja: 給料が入ったんだ！
#. de: Endlich sind die Gil da!
#. fr: J'ai enfin reçu un salaire<nbsp>! Ça faisait si longtemps<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4216:0:1"
msgid "Aye, I got a job. Still living<br>in a bloody tent for all<br>the good it's done me."
msgstr "Ага, работу нашёл. Только толку-то —<br>как жил в палатке, так и живу."

#. ja: よく働き…よく眠る…
#. de: Arbeiten, schlafen. Arbeiten, schlafen ...
#. fr: Rien de tel qu'une bonne sieste après le travail...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4217:0:1"
msgid "It's better than before,<br>but that ain't saying much..."
msgstr "Лучше, чем раньше,<br>хотя радоваться особо нечему..."

#. ja: さて、今日も…
#. de: Puh, dann mal los ...
#. fr: C'est un jour nouveau<nbsp>!
msgctxt "Balloon:4218:0:1"
msgid "Today, we work..."
msgstr "Сегодня работаем..."

#. ja: がんばろう！
#. de: Legen wir los!
#. fr: On va se donner à fond<nbsp>!
msgctxt "Balloon:4219:0:1"
msgid "Tomorrow, we eat the rich!"
msgstr "А завтра будем есть богачей!"

#. ja: 少し余裕が出てきたな…
#. de: Ich hab grade etwas Luft ...
#. fr: Oui, on peut enfin respirer.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4220:0:1"
msgid "Pulled me groin<br>with all that honest work─"
msgstr "От этой честной работы<br>я себе пах потянул..."

#. ja: いい調子ね
#. de: So muss das sein!
#. fr: Les affaires ont l'air d'aller mieux.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4221:0:1"
msgid "Whatever you're about<br>to ask, don't."
msgstr "Что бы ты ни собиралась<br>спросить — не надо."

#. ja: 仕事が見つかったの！
#. de: Arbeit! Endlich!
#. fr: Devine quoi<nbsp>! J'ai enfin du travail<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4222:0:1"
msgid "So one of those fat merchants<br>offered to make me his slave..."
msgstr "Один жирный купец предложил<br>сделать меня своей рабыней..."

#. ja: 私もよ！
#. de: Ich auch!
#. fr: Moi aussi<nbsp>! J'en reviens pas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4223:0:1"
msgid "Me too. Let's both say yes<br>and kill him while he sleeps."
msgstr "Мне тоже. Давай согласимся,<br>а потом прикончим его во сне."

#. ja: なんだか寂しくなるわね
#. de: Es ist nicht mehr so viel los hier.
#. fr: C'est le calme plat, ici.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4224:0:1"
msgid "It's not the same<br>without them."
msgstr "Без них всё<br>уже не то."

#. ja: アラミゴへ帰るのか
#. de: Vielleicht ist es an der Zeit, nach Ala Mhigo zurückzukehren.
#. fr: Et si on rentrait à Ala Mhigo<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4225:0:1"
msgid "Perhaps we too should<br>return to Ala Mhigo..."
msgstr "Может, и нам пора<br>вернуться в Ала Миго..."

#. ja: 蓄えが増えてきた…
#. de: Ich hab endlich mal was gespart.
#. fr: J'arrive même à faire des économies maintenant.
msgctxt "Balloon:4226:0:1"
msgid "Thus begins my empire..."
msgstr "Вот и начало моей империи..."

#. ja: 物は悪くないよ！
#. de: Die Waren haben eine super Qualität!
#. fr: Rien ne se perd, vous savez<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4227:0:1"
msgid "You'll be buying it<br>for a good deal more!"
msgstr "Да вы потом<br>втридорога заплатите!"

#. ja: 廃材を使って商売を…
#. de: Kleinholz zum Verkauf anbieten, hmm ...
#. fr: On pourrait revendre ce que jettent les gens.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4228:0:1"
msgid "What ever do you have<br>in that pot? It smells<br>absolutely heavenly!"
msgstr "Что у вас там в горшке? Пахнет<br>просто восхитительно!"

#. ja: 考えてみよう…
#. de: Wäre eine Idee ...
#. fr: C'est une idée à creuser.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4229:0:1"
msgid "Some of Stonesthrow's<br>extra-special stew, sir!"
msgstr "Особое рагу из Каменного Порога, господин!"

#. ja: 今日は荷下ろしの仕事か…
#. de: Sieht so aus, als würd ich heute wieder Salz entladen ...
#. fr: Ah, c'est vrai qu'aujourd'hui, j'ai du travail. Je dois aider à transporter des mar<shy>chan<shy>di<shy>ses...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4230:0:1"
msgid "You an old customer?<br>Sorry, but I don't do that<br>kind of work anymore."
msgstr "Старый клиент?<br>Извиняйте, но я таким<br>больше не занимаюсь."

#. ja: あの子の好物にしようかしら
#. de: Ich wünschte, ich könnte dem Kind mal was Gutes tun.
#. fr: Hmm... Et si je lui prenais sa gourmandise favorite<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4231:0:1"
msgid "What shall I treat<br>the boy to today...?"
msgstr "Чем бы сегодня<br>порадовать мальчика?.."

#. ja: そのやる気、買った！
#. de: Das ist die richtige Einstellung. Abgemacht!
#. fr: J'achète<nbsp>!
msgctxt "Balloon:4232:0:1"
msgid "Fair enough, fair enough..."
msgstr "Ладно, уговорил..."

#. ja: 貧民たちに活気が出てきた
#. de: Bei den armen Leuten hat sich was getan ...
#. fr: On dirait que nos réfugiés ont meilleure mine, tiens.
msgctxt "Balloon:4233:0:1"
msgid "The rabble's in high spirits..."
msgstr "Глянь-ка, беднота-то приободрилась..."

#. ja: おいらも壺がほしいっぺな…
#. de: Ich will auch 'n Schlafplatz! \<spotz>
#. fr: Moi aussi, je veux jouer...
msgctxt "Balloon:4234:0:1"
msgid "You have been in that pot long enough, yes, yes?"
msgstr "Я тоже хочу в горшок, да-а..."

#. ja: い、生きた心地がしなかったぜ…
#. de: Da kannst du aber von Glück sagen, dass ich zur Stelle war.
#. fr: J-j'ai bien cru que j'allais y passer...
msgctxt "Balloon:4235:0:1"
msgid "Why must you torment me, you furry fiend!?"
msgstr "Да за что ты меня мучаешь, пушистый дьявол?!"

#. ja: おにいさん<br>顔色がよくなったね！
#. de: Deine Nase ist nicht mehr so trocken, hm?
#. fr: T'as meilleure mine, dis-moi<nbsp>!
msgctxt "Balloon:4236:0:1"
msgid "My, what big ears you have!"
msgstr "Ух ты, какие у тебя большие уши!"

#. ja: …お前のおかげだ
#. de: Das habe ich dir zu verdanken.
#. fr: ... Et c'est à toi que je le dois.
msgctxt "Balloon:4237:0:1"
msgid "All the better to hear you with."
msgstr "Чтобы лучше тебя слышать."

#. ja: ほんと？<br>えへへ、よかったぁ！
#. de: Meinst du? Das freut mich!
#. fr: C'est vrai<nbsp>? Tant mieux alors, hé hé hé<nbsp>!
msgctxt "Balloon:4238:0:1"
msgid "What do you mean by that?"
msgstr "Ты о чём?"

#. ja: これでヒエンを追うぞ！
#. de: Hiermit reisen wir König Hien hinterher!
#. fr: Avec un tel galion, on peut être sûrs de retrouver Hien<nbsp>!
msgctxt "Balloon:4239:0:1"
msgid "Hien would never expect us to chase after him in a boat!"
msgstr "Хиэн и не подумает, что мы пустимся за ним в погоню на лодке!"

#. ja: この舟って乗り物<br>苦手っす…
#. de: Ich hasse Boote und Schiffe!
#. fr: Et comment on fait quand on n'a pas le pied marin<nbsp>?
msgctxt "Balloon:4240:0:1"
msgid "Is this the only way? I'm feeling a little queasy..."
msgstr "И только на лодке можно добраться? Меня уже мутит..."

#. ja: 泳いできた往路よりは<br>マシだろう
#. de: Immer noch besser als Schwimmen ...
#. fr: On nage...
msgctxt "Balloon:4241:0:1"
msgid "You're welcome to swim alongside, if you prefer!"
msgstr "Если хочешь, плыви рядом!"

#. ja: あれだけ長く船に乗ったのだ…<br>この辺りがエオルゼアだな？
#. de: Ich dachte schon, die Überfahrt würde nie enden. Sind wir endlich in Eorzea?
#. fr: Ça y est<nbsp>? On est en Éorzéa<nbsp>? J'ai l'impression que ça fait une éternité qu'on est partis...
msgctxt "Balloon:4242:0:1"
msgid "Considering how long we spent on that boat, we must be in Eorzea by now."
msgstr "Мы так долго плыли... Должно быть, уже добрались до Эорзеи."

#. ja: お、落ちる！<br>落ちたら死ぬ、溺れ死ぬぅ～！
#. de: Hilfe, ich falle! Ich werde ertrinken!
#. fr: Ah, ah<nbsp>! J-j'vais me noyer si j'tombe<nbsp>!
msgctxt "Balloon:4243:0:1"
msgid "Brothers, down here! Help me!"
msgstr "Братья, сюда! Помогите мне!"

#. ja: ブドゥガの兄さんたちは<br>行っちまったのか？
#. de: Wohin sind denn bloß die Buduga verschwunden?
#. fr: Alors ça y est, les Buduga sont partis<nbsp>?
msgctxt "Balloon:4244:0:1"
msgid "Do you think we'll see those Budugan men again?"
msgstr "Думаешь, мы ещё увидим тех мужчин из Будуги?"

#. ja: ああ、クガネへ向かったよ<br>きっと西方行きの船に乗るんだろ
#. de: Ich glaub, die wollten nach Kugane, um dort ein Schiff zu finden, das sie nach Westen bringt.
#. fr: Eh oui. Pour Kugane. Une fois là-bas, ils vont embarquer sur un bateau pour l'Occident, j'imagine.
msgctxt "Balloon:4245:0:1"
msgid "Well, last I heard, they're heading west from Kugane."
msgstr "Ну, я слышал, они направляются на запад из Куганэ."

#. ja: そこまでして<br>ヒエン様を…
#. de: So sehr sind sie König Hien ergeben.
#. fr: Le seigneur Hien les a marqués à ce point...
msgctxt "Balloon:4246:0:1"
msgid "They still haven't given up on Lord Hien, then..."
msgstr "Значит, они всё ещё не оставили надежды найти господина Хиэна..."

#. ja: おそるべき執念だな…
#. de: Ja, ihre Hingabe ist schon fast beängstigend.
#. fr: Leur dévotion fait presque peur, honnêtement.
msgctxt "Balloon:4247:0:1"
msgid "You have to admire their determination, if nothing else."
msgstr "Надо отдать должное их упорству. Оно даже пугает..."

#. ja: アラミゴのツテがあるんで…
#. de: Sind das Waren aus Ala Mhigo?
#. fr: Ça, c'est parce que j'ai mes four<shy>nis<shy>seurs à Ala Mhigo.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4248:0:1"
msgid "My Ala Mhigan contacts<br>are up to the challenge."
msgstr "Мои связи в Ала Миго<br>справятся с этой задачей."

#. ja: 珍しい物を揃えてるのね
#. de: Ja, ich habe eine Auswahl seltener Waren. Schaut Euch nur in Ruhe um.
#. fr: Pas banals vos produits...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4249:0:1"
msgid "This selection is impressive,<br>but I'm looking for something<br>especially rare..."
msgstr "Выбор впечатляет,<br>но я ищу кое-что<br>по-настоящему редкое..."

#. ja: ♪♪
#. de: ♪♪
#. fr: ♪♪
msgctxt "Balloon:4250:0:1"
msgid "♪♪♪"
msgstr "♪♪♪"

#. ja: タコですみません！
#. de: Überschall ist anders<nbsp>...
#. fr: Une parodie de jeu de tir, foi de poulpe<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4251:0:1"
msgid "What were you expecting?<br>A sabotender?"
msgstr "А чего ты ждал?<br>Саботендера?"

#. ja: フンフンガー！
#. de: Hungaaa! Baller dich an die Spitze!
#. fr: À fond sur le champignon<nbsp>!
msgctxt "Balloon:4252:0:1"
msgid "Fungahhhhhh!"
msgstr "Фунгаааа!"

#. ja: ホッホゥ！<br>その調子ですぞ～！
#. de: Hoho! Feuer frei!
#. fr: Tout droit dans la zone de danger<nbsp>!
msgctxt "Balloon:4253:0:1"
msgid "That's the way! "
msgstr "Вот так!"

#. ja: 撃ちまくるんだ！<br>流星を放つように！
#. de: Nimm keine Rücksicht auf die Inneneinrichtung!
#. fr: Feu à volonté<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4254:0:1"
msgid "Steady your hand<br>and aim true."
msgstr "Руку крепче,<br>целься как следует."

#. ja: 人選を間違えました…
#. de: Ich glaube, das wird heute nichts mehr ...
#. fr: J'ai dû me tromper quelque part...
msgctxt "Balloon:4255:0:1"
msgid "I have a feeling your talents lie elsewhere..."
msgstr "Кажется, твоё призвание в чём-то другом..."

#. ja: 不肖チェミ・ジンジャル！<br>頭を使うのは苦手です！
#. de: Pah, zur Not schnitze ich uns eben ein Wunderei.
#. fr: Je suis artisan, moi... Je suis un manuel, moi. Pas un intellectuel<nbsp>!
msgctxt "Balloon:4256:0:1"
msgid "Perhaps I should craft us an egg instead?"
msgstr "Может, лучше я смастерю для нас яйцо?"

#. ja: チッ…<br>なぜ俺がこんな真似を…
#. de: Da stehe ich und diskutiere mit einem Spriggan! \<seufz>
#. fr: Comment j'ai fini dans ce bourbier, déjà<nbsp>? J'ai sans doute mieux à faire de mon temps<nbsp>!
msgctxt "Balloon:4257:0:1"
msgid "Matron's teats! How did I let them talk me into this?"
msgstr "Клянусь сиськами Матроны! Как я позволил себя на это уговорить?!"

#. ja: 降りてこい…<br>オレのヌン力！
#. de: Eins, zwei, M'rhaz Nunh!<br>Eins, zwei, stark wie ein Nunh!<br>\<schnauf>
#. fr: Descends de là tout de suite<nbsp>!
msgctxt "Balloon:4258:0:1"
msgid "A new chapter in the legend of M'zhet Tia begins today!"
msgstr "Сегодня начинается новая глава легенды о М'жете Тиа!"

#. ja: メ・ゼトさんの分まで<br>私が考えないと…
#. de: Vielleicht wird er irgendwann mal ein Nunh, aber ein Rätselgenie bestimmt nicht.
#. fr: M'zhet Tia ne m'est d'aucune utilité... C'est moi qui fais tout le travail<nbsp>!
msgctxt "Balloon:4259:0:1"
msgid "A self-proclaimed future nunh he may be, but a puzzle-solving genius he is not."
msgstr "Будущим нунхом он себя объявил, а загадки разгадывать не умеет."

#. ja: ふふふ<br>ふたりが楽しそうでよかった
#. de: Hihi, die Kinder haben einen Riesenspaß.
#. fr: Hi hi hi... Ils ont l'air si heureux<nbsp>!
msgctxt "Balloon:4260:0:1"
msgid "Oh! You two have made a new friend!"
msgstr "Ой! У вас появился новый друг!"

#. ja: スプリガンちゃんって<br>モフモフだね～
#. de: Er ist soooo flauschig! Dürfen wir ihn behalten?
#. fr: Les spriggans, c'est les petites boules de poils noires<nbsp>?
msgctxt "Balloon:4261:0:1"
msgid "He's so warm and fluffy! Can I keep him?"
msgstr "Он такой тёплый и пушистый! Можно его оставить?"

#. ja: かわいいね～
#. de: Hihi, die buschigen Öhrchen!
#. fr: A-do-rable<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4262:0:1"
msgid "Watch your fingers, Khloe! He looks sort of...<i>bitey</i> to me."
msgstr "Хлоя, пальчики побереги! Он какой-то... <i>кусучий</i>, по-моему."

#. ja: 落ち着いて<br>森の精霊の声を聴くんだ…
#. de: Pssst ... Die Gebieter geben mir gerade einen Hinweis auf das Wunderei ...
#. fr: Guidez-moi, esprits de la sylve...
msgctxt "Balloon:4263:0:1"
msgid "It seems I must petition the elementals for aid."
msgstr "Похоже, придётся просить помощи у элементалей."

#. ja: コワイ！<br>インゲンコワイ！
#. de: Geh weg! Spriggy Angst!
#. fr: Humains... terrifiants...
msgctxt "Balloon:4264:0:1"
msgid "Spiky man! Scary man!"
msgstr "Колючий человек! Страшный человек!"

#. ja: 今日という今日は…
#. de: Wo man sich nicht so überall wiedersieht<nbsp>...
#. fr: Comme on se retrouve...
msgctxt "Balloon:4265:0:1"
msgid "Fancy seeing you here..."
msgstr "Вот уж кого не ожидал здесь встретить..."

#. ja: 増えてる…
#. de: Heilige Kami!
#. fr: Voilà qu'ils sont trois maintenant...
msgctxt "Balloon:4266:0:1"
msgid "By the kami, what now..."
msgstr "Боги ками, ну и что теперь..."

#. ja: 今度こそ<br>お前に化けてみせよう
#. de: Als Nächstes siehst du nicht nur doppelt, sondern dreifach!
#. fr: Cette fois, tu vas voir non pas double, mais triple<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4267:0:1"
msgid "For our next bit, all three<br>of us will double “you”!"
msgstr "А в следующий раз мы все трое<br>превратимся в тебя!"

#. ja: 先に言っておきますが<br>僕はカワウソですよ…
#. de: Ah, ah, ah! Macht's nicht!<br>Macht mir nicht den Genbu!
#. fr: Tant que je vois des loutres...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4268:0:1"
msgid "Don't do it! Don't you dare<br>pull a Genbu!"
msgstr "Не надо! Только не вздумайте<br>повторять фокус с Гэнбу!"

#. ja: 承知している<br>黙って見ていろ
#. de: Schon gut, schon gut!<br>Jetzt halt die Klappe und schau her!
#. fr: Abracadabra<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4269:0:1"
msgid "Perish the thought!<br>Now watch!"
msgstr "Да знаю я.<br>Молчи и смотри!"

#. ja: どうだ！
#. de: Wie wär's? Aus Eins mach Vier?
#. fr: Alors, ça t'en bouche un coin, hein<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4270:0:1"
msgid "How 'bout it?<br>We could be quadruplets!"
msgstr "Ну как тебе?<br>Могли бы стать четверняшками!"

#. ja: カワウソォーッ！
#. de: Na toll! Das hat jetzt keiner erwartet. Pah!
#. fr: Au moins, vous êtes cohérents<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4271:0:1"
msgid "Oh, well done you!<br>I'm sure no one saw<br>that one coming! Bah!"
msgstr "Ну просто молодцы!<br>Никто же такого<br>не ожидал! Тьфу!"

#. ja: い、一緒に、<br>セレモニーに参加してみませんか！
#. de: W-Würdest du mit mir an dem L-L-Liebestest teilnehmen?
#. fr: V-vous voulez participer<br>à la cérémonie avec moi<nbsp>?
msgctxt "Balloon:4272:0:1"
msgid "W-Would you like to try the ceremony with me?"
msgstr "Н-не хочешь пройти церемонию вместе со мной?"

#. ja: ええ、喜んで！
#. de: Oh ja, sehr gerne!
#. fr: Oui, avec joie<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4273:0:1"
msgid "I'd <i>love</i> to!"
msgstr "С <i>радостью</i>!"

#. ja: もちろんだとも！
#. de: Aber natürlich, mein Schatz.
#. fr: Bien sûr<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4274:0:1"
msgid "Hah!<br>One more time, then."
msgstr "Ха!<br>Ну, ещё разок."

#. ja: おじいちゃん！<br>もういっかい行こっ！
#. de: Noch mal, Opa! Biiiitte! Das war sooo lustig!
#. fr: Papy<nbsp>! On y retourne<nbsp>?
msgctxt "Balloon:4275:0:1"
msgid "Let's go again, Granddad!"
msgstr "Дедушка! Давай ещё раз!"

#. ja: 全体連絡はっと…
#. de: Ein Rundschreiben an alle Expeditionsteilnehmer<nbsp>...?
#. fr: Alors, voyons voir...
msgctxt "Balloon:4276:0:1"
msgid "The bulletin... Have to check the bulletin..."
msgstr "Так, что там в бюллетене... Надо проверить..."

#. ja: …この情報は面白いな！
#. de: Das klingt spannend!
#. fr: ... Voilà qui est intéressant<nbsp>!
msgctxt "Balloon:4277:0:1"
msgid "Heh heh, clowns are funny."
msgstr "Хе-хе, клоуны смешные."

#. ja: 全体連絡は確認できた？
#. de: Hast du das Rundschreiben gesehen?
#. fr: Tu as été jeter un coup d'œil au tableau<nbsp>?
msgctxt "Balloon:4278:0:1"
msgid "Did you check the bulletin?"
msgstr "Ты проверил бюллетень?"

#. ja: あっ…！
#. de: Huh?
#. fr: Ah<nbsp>!
msgctxt "Balloon:4279:0:1"
msgid "I...uh... No, miss..."
msgstr "Я... э-э... Нет, госпожа..."

#. ja: …確認してきて
#. de: Schau es dir an!
#. fr: Je t'attends ici.
msgctxt "Balloon:4280:0:1"
msgid "\\<sigh> Go. Check. The bulletin."
msgstr "<i>Эх...</i> Иди. Проверь. Объявление."

#. ja: この荷物は…あっちか！
#. de: Und wo soll das Material jetzt hin? Ah, da!
#. fr: Bon sang, où est-ce que je devais mettre ça...
msgctxt "Balloon:4281:0:1"
msgid "Over there, eh?"
msgstr "Туда, значит?"

#. ja: あれ、ここじゃないのか
#. de: Hm? War doch nicht hier<nbsp>...
#. fr: C'était pas ici<nbsp>?
msgctxt "Balloon:4282:0:1"
msgid "Huh? Was sure this is the spot..."
msgstr "А? Я думал, это здесь..."

#. ja: それならここだ！
#. de: Ach, dann muss es hier sein!
#. fr: Ici, ça ira bien<nbsp>!
msgctxt "Balloon:4283:0:1"
msgid "Has to be here, then!"
msgstr "Тогда сюда!"

#. ja: …って、やっぱり違う！
#. de: Verflixt, hier auch nicht!
#. fr: Non, là-bas, finalement<nbsp>!
msgctxt "Balloon:4284:0:1"
msgid "...No? Godsdammit!"
msgstr "...Нет? Да чтоб вас!"

#. ja: これ、どこに運ぶんだ？
#. de: Wenn ich doch nur wüsste, wo das Zeug hin soll!
#. fr: Où est-ce que je vais mettre ça<nbsp>?
msgctxt "Balloon:4285:0:1"
msgid "Where's this supposed to go?"
msgstr "Куда это надо отнести?"

#. ja: さて、ここからどうするか…
#. de: Was machen wir als Nächstes?
#. fr: Qu'est-ce qu'on pourrait aménager ensuite, ja<nbsp>?
msgctxt "Balloon:4286:0:1"
msgid "What now, do you think?"
msgstr "Ну и что теперь делать?"

#. ja: そろそろ戻ろうぜ…？
#. de: Wir sollten langsam zurückkehren<nbsp>...
#. fr: Bon, on va pas tarder à rentrer.
msgctxt "Balloon:4287:0:1"
msgid "Haven't you stared long enough?"
msgstr "Ты уже насмотрелся?"

#. ja: え～？　もっと見たい～
#. de: Was? Schon? Wir haben doch noch gar nichts gesehen!
#. fr: Hein<nbsp>!? Non, pas déjà...
msgctxt "Balloon:4288:0:1"
msgid "No, it's not nearly seared into my brain!"
msgstr "Нет! Я ещё не всё запомнил!"

#. ja: あっちは野菜だろ？<br>それなら向こうに…
#. de: Nun, wenn das Gemüse hier drüben hinkommt<nbsp>...
#. fr: Voyons voir... Si les fruits et légumes vont là-bas, alors...
msgctxt "Balloon:4289:0:1"
msgid "Well, if the vegetables go over there..."
msgstr "Так, овощи, значит, туда..."

#. ja: 魔導兵器に負けるものか…
#. de: Damit werden wir ihren Magitek-Maschinen tüchtig einheizen.
#. fr: Hmpf... C'est pas leur technologie magitek qui viendra à bout de nous.
msgctxt "Balloon:4290:0:1"
msgid "I pray this will be enough."
msgstr "Надеюсь, этого хватит."

#. ja: 本陣の魔法障壁は強固だが…
#. de: Die Barriere über dem Hauptquartier steht. Hoffen wir auch, dass sie hält.
#. fr: On doit renforcer les défenses magiques autour du quartier général.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4291:0:1"
msgid "We have no reason to believe<br>the barrier will not hold."
msgstr "Нет оснований полагать,<br>что барьер не выдержит."

#. ja: 強襲に備えねば…
#. de: Wir haben mit ziemlich starkem Artilleriefeuer zu rechnen.
#. fr: Oui, nous pourrions essuyer un assaut violent d'un instant à l'autre.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4292:0:1"
msgid "Yet if they should bring<br>all to bear against us..."
msgstr "Но если они обрушат на нас<br>всю свою мощь..."

#. ja: 忍びに哨戒させよう
#. de: Schickt die Shinobi auf Patrouille.
#. fr: Envoyons les shinobi en patrouille.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4293:0:1"
msgid "We should send out a<br>reconnaissance team."
msgstr "Надо отправить<br>разведчиков."

#. ja: 全力を尽くすわ
#. de: Wenn es sein muss, opfere ich meinen letzten Tropfen Äther.
#. fr: Je vais faire de mon mieux.
msgctxt "Balloon:4294:0:1"
msgid "I will do whatever it takes to save my patients. Whatever it takes!"
msgstr "Я сделаю всё, что потребуется, чтобы спасти пациентов. Всё что угодно!"

#. ja: ロータノ海は澄んでいて…
#. de: Du glaubst nicht, wie klar die Rhotano-See ist.
#. fr: L'eau de la mer de Rhotano est si transparente qu'on voit jusqu'au fond.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4295:0:1"
msgid "There's nothin' more beautiful<br>than a sunset on the Rhotano."
msgstr "Нет ничего прекраснее,<br>чем закат над Ротано."

#. ja: いつか行ってみたいな…
#. de: Wenn wir das hier überlebt haben, zeigst du sie mir mal.
#. fr: Ahh, j'aimerais voir ça de mes propres yeux, un jour...
msgctxt "Balloon:4296:0:1"
msgid "I pray I live to see it..."
msgstr "Хоть бы дожить до того дня..."

#. ja: ここにも戦力が必要だ…
#. de: Hier brauchen wir ebenfalls mehr Soldaten<nbsp>...
#. fr: Il nous faut des soldats ici aussi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4297:0:1"
msgid "I fear we lack the numbers<br>to hold out..."
msgstr "Боюсь, нас слишком мало,<br>чтобы удержать рубеж..."

#. ja: それなら我が部隊を…
#. de: Ich schicke welche von meinen.
#. fr: Laissez-nous faire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4298:0:1"
msgid "Then we must call for<br>reinforcements."
msgstr "Тогда надо запросить<br>подкрепление."

#. ja: 我らで国境を死守しよう！
#. de: Wir werden die Grenze mit unserem Leben verteidigen!
#. fr: Nous mourrons pour protéger la frontière, s'il le faut<nbsp>!
msgctxt "Balloon:4299:0:1"
msgid "We must protect the border at all costs."
msgstr "Мы должны защищать границу любой ценой."

#. ja: 帝国軍を蹴散らします！
#. de: Ich werd so viele Garlear mit in die Sieben Höllen nehmen, wie ich nur kann.
#. fr: On va réduire les Impériaux en chair à pâté<nbsp>!
msgctxt "Balloon:4300:0:1"
msgid "Till our dyin' breaths."
msgstr "Будем бить имперцев<br>до последнего вздоха!"

#. ja: 痛ぇ、痛ぇよぉ…
#. de: Ngghh! Schneidet es raus! Es tut so schrecklich weh!
#. fr: J-j-j'ai mal... Argh<nbsp>!
msgctxt "Balloon:4301:0:1"
msgid "Argh..."
msgstr "А-а-а..."

#. ja: 前線は…地獄だった
#. de: Es ist noch nicht vorbei. Kawumm. Es ist noch nicht vorbei. Kawumm. Es ist noch nicht<nbsp>...
#. fr: J'reviens des premières lignes... C'est... C'est l'enfer là-bas...
msgctxt "Balloon:4302:0:1"
msgid "I can't feel my legs..."
msgstr "Ног не чувствую..."

#. ja: まさか僕が…<br>敗れるなんて…
#. de: Geschlagen ... Ich bin<nbsp>... geschlagen.
#. fr: Je suis battu... une deuxième fois...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4303:0:1"
msgid "Only once before have<br>I bowed my head low..."
msgstr "Лишь однажды прежде<br>я так низко склонял голову..."

#. ja: 温かい料理は…まだか…
#. de: Wann gibt's endlich was Warmes zu futtern? Bin am Verhungern!
#. fr: Ah, qu'est-ce que je donnerais pour un bon plat chaud...
msgctxt "Balloon:4304:0:1"
msgid "My body is ready for a hot meal."
msgstr "Душа просит горячего..."

#. ja: 仕事が終わったら、ね
#. de: Wenn die Arbeit hier getan ist<nbsp>...
#. fr: On a du trrravail à finir, d'abord<nbsp>!
msgctxt "Balloon:4305:0:1"
msgid "As soon as our watch is over."
msgstr "Как только закончится наше дежурство."

#. ja: お風呂に入りたい…
#. de: Ein Königreich für ein heißes Bad<nbsp>...
#. fr: Ce que j'aimerais pouvoir prendre un bon bain<nbsp>!
msgctxt "Balloon:4306:0:1"
msgid "Gods, what I wouldn't give for a bath..."
msgstr "Ох, чего бы я только не отдал за горячую ванну..."

#. ja: 買って帰ろうかしら…
#. de: Ob ich was davon kaufen und mit nach Hause bringen soll?
#. fr: Bon ben, je vais finir mes emplettes et rentrer.
msgctxt "Balloon:4308:0:1"
msgid "That doesn't look half bad..."
msgstr "А ведь ничего так..."

#. ja: 一杯やってくか…
#. de: Ein Feierabendbierchen und dann geht's ab nach Hause.
#. fr: Je vais peut-être en prendre un gobelet aussi alors...
msgctxt "Balloon:4309:0:1"
msgid "Sure, I'll give it a try."
msgstr "Ладно, попробую."

#. ja: 掘り出し物があるな…
#. de: Vielleicht finde ich ja ein Schnäppchen.
#. fr: Ça en fait de la vieillerie...
msgctxt "Balloon:4310:0:1"
msgid "I'd buy that for a gil..."
msgstr "За гил бы взял..."

#. ja: 美味いんだなこれが！
#. de: Woah! Das Zeug schmeckt!
#. fr: Délicieuse, cette cuvée.
msgctxt "Balloon:4311:0:1"
msgid "Down the hatch!"
msgstr "Ну, за милую душу!"

#. ja: 大金持ちへの道は険しいのねん…
#. de: Der Weg zum Reichtum ist mit Rückschlägen gepflastert<nbsp>...
#. fr: Le chemin vers la richesse est semé d'embûches...
msgctxt "Balloon:4312:0:1"
msgid "The path to riches is a perilous one, yes, yes..."
msgstr "Путь к богатству опасен, да-да..."

#. ja: ん～もう！<br>目のやり場に困るわ…
#. de: Könnt ihr nicht zu Hause knuddeln?
#. fr: Hé, vous avez pas honte<nbsp>!? Y a des chambres, pour ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4313:0:1"
msgid "Seven hells!<br>Get a bloody room, will ye!?"
msgstr "Семь адов!<br>Да снимите вы комнату, в конце концов!"

#. ja: 次は俺が勝ってやるかんね！
#. de: Nächstes Mal gewinn ich, das spür ich im linken kleinen Zeh.
#. fr: La prrrochaine partie est pour moi<nbsp>!
msgctxt "Balloon:4314:0:1"
msgid "The next match is mine!"
msgstr "В следующий раз я выиграю!"

#. ja: 何度やっても僕には敵わんよ！
#. de: Gegen mich kommt keiner an!
#. fr: Tu n'as aucune chance, petit chaton inoffensif<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4315:0:1"
msgid "Mewling cub!<br>You'll never defeat me!"
msgstr "Жалкий котёнок!<br>Тебе меня не одолеть!"

#. ja: オレのハンマーさばきを見やがれ！
#. de: Mit Hämmern kenn ich mich aus, das werd ich euch zeigen.
#. fr: Je vais vous montrer comment on manie vraiment le marteau<nbsp>!
msgctxt "Balloon:4316:0:1"
msgid "I'll show ye how to swing a damn hammer!"
msgstr "Сейчас покажу, как надо махать молотом, чёрт побери!"

#. ja: 私が負けてしまうとは…
#. de: Ich angel mir schon noch einen Sieg<nbsp>... Man braucht nur etwas Geduld.
#. fr: Je ne pensais pas perdre comme ça...
msgctxt "Balloon:4317:0:1"
msgid "The abyss take me..."
msgstr "Да чтоб меня бездна поглотила..."

#. ja: は、牌を捨てるときは<br>きれいに並べてっと…
#. de: So, der Ziegel sieht doch hübsch aus<nbsp>...
#. fr: Une paire de numérales, un brelan de dragons... Oh et puis flûte, je pige rien à ce jeu<nbsp>!
msgctxt "Balloon:4318:0:1"
msgid "Wh-Which tile should I discard...?"
msgstr "К-какую плитку сбросить?.."

#. ja: ちっくしょう、勝てねえよぉ…！
#. de: Verdammt, wieder nichts!
#. fr: Et clac<nbsp>! Clac<nbsp>! J'adore le bruit des tuiles qui claquent sur la table<nbsp>!
msgctxt "Balloon:4319:0:1"
msgid "Well, this is a disaster!"
msgstr "Ну и дела..."

#. ja: ふゥん、これに登れとねぇ？
#. de: Da soll ich hoch?
#. fr: On est censé grimper là-haut<nbsp>?
msgctxt "Balloon:4320:0:1"
msgid "And one is meant to scale this edifice...?"
msgstr "И надо, значит, лезть на эту громадину?.."

#. ja: ウララー！
#. de: Ulalaaa!
#. fr: Ulalaaa<nbsp>!
msgctxt "Balloon:4321:0:1"
msgid "Ulalaaa!"
msgstr "У-ла-ла-а-а!"

#. ja: 最高！！
#. de: Kreisch!
#. fr: Génial<nbsp>!
msgctxt "Balloon:4322:0:1"
msgid "I love you!"
msgstr "Обожаю тебя!"

#. ja: マシャー！！
#. de: Masha!!!
#. fr: Mashaaa<nbsp>!
msgctxt "Balloon:4323:0:1"
msgid "Mashaaa!"
msgstr "Маша-а-а!"

#. ja: うぉーー！！
#. de: Mehr!
#. fr: Ouiii<nbsp>!
msgctxt "Balloon:4324:0:1"
msgid "Yes!"
msgstr "Да-а!"

#. ja: ウララちゃーん！！
#. de: Ulala, du bist die Beste!
#. fr: Ulala, c'est toi la meilleure<nbsp>!
msgctxt "Balloon:4325:0:1"
msgid "U-lah-lah!"
msgstr "У-ла-ла!"

#. ja: オイッ！オイッ！
#. de: Heee! Hooo!
#. fr: Allez, allez<nbsp>!
msgctxt "Balloon:4326:0:1"
msgid "Hah! Hah!"
msgstr "Ха! Ха!"

#. ja: ナルミー！！
#. de: Narumiii!
#. fr: Narumiii<nbsp>!
msgctxt "Balloon:4327:0:1"
msgid "Narumiii!"
msgstr "Наруми-и-и!"

#. ja: こっち向いてー！
#. de: Hier! Hier!
#. fr: Elle m'a regardée<nbsp>!
msgctxt "Balloon:4328:0:1"
msgid "She looked at me!"
msgstr "Она на меня посмотрела!"

#. ja: た、助かった…
#. de: I-Ist der Schrecken vorbei?
#. fr: On est sauvés...<nbsp>?
msgctxt "Balloon:4329:0:1"
msgid "W-We're safe...?"
msgstr "М-мы спасены?.."

#. ja: この空は…！？
#. de: Der Himmel ...
#. fr: Le ciel...<nbsp>!
msgctxt "Balloon:4330:0:1"
msgid "The sky..."
msgstr "Небо..."

#. ja: 何が起きてるんだ
#. de: Was geht hier vor sich?
#. fr: Qu'est-ce qui se passe<nbsp>!?
msgctxt "Balloon:4331:0:1"
msgid "What's happening...?"
msgstr "Что происходит?.."

#. ja: ヴァ…スリ…さま…
#. de: Lord ... Vauthry ...
#. fr: Don... Vauth... ry...
msgctxt "Balloon:4332:0:1"
msgid "Lord...Vauthry..."
msgstr "Лорд... Ваутри..."

#. ja: 万歳…万歳…
#. de: Lang lebe ... der Erlauchte Erlöser<nbsp>...
#. fr: Longue vie... Longue vie...
msgctxt "Balloon:4333:0:1"
msgid "Long may...you reign..."
msgstr "Да правь ты... вечно..."

#. ja: ぅ…おぉ…
#. de: Ah ... Aahhh ...
#. fr: Uguuh...
msgctxt "Balloon:4334:0:1"
msgid "Ohhh..."
msgstr "О-о-о..."

#. ja: 偉大なる…ドン…
#. de: Lange lebe ... Lord Vauthry ...
#. fr: Don Vauthry... Vous êtes si grand...
msgctxt "Balloon:4335:0:1"
msgid "Hallowed be his name..."
msgstr "Священно имя его..."

#. ja: アァァ…<br>もっとメオルを…
#. de: Gib uns unser tägliches Meol<nbsp>...
#. fr: Plus de méol...
msgctxt "Balloon:4336:0:1"
msgid "Blessed is the meol..."
msgstr "Благословен меол..."

#. ja: これも演出…？
#. de: Ist das Teil der Aufführung?
#. fr: C'est supposé faire partie du spectacle, ça<nbsp>?
msgctxt "Balloon:4337:0:1"
msgid "Is this supposed to be part of the show?"
msgstr "Это часть представления?"

#. ja: 何が始まるんだ…
#. de: Irgendwas passiert hier ...
#. fr: Il se passe quelque chose...
msgctxt "Balloon:4338:0:1"
msgid "Something's happening..."
msgstr "Что-то происходит..."

#. ja: アンタたちが呼んだのか？
#. de: Habt ihr diese Dinger gerufen?
#. fr: C'est vous qui avez invoqué ces choses<nbsp>!?
msgctxt "Balloon:4339:0:1"
msgid "Did you summon those things!?"
msgstr "Это вы призвали этих тварей?!"

#. ja: なんだ、なんだ？
#. de: W-Was ist das?!
#. fr: Qu'est-ce que c'est que ce truc<nbsp>!!?
msgctxt "Balloon:4340:0:1"
msgid "What in the gods' name is that!?"
msgstr "Что это, во имя богов?!"

#. ja: 王冠はあっち！<br>あっちだヨ！
#. de: Zur Krone geht es da entlang!
#. fr: La couronne est par là<nbsp>!
msgctxt "Balloon:4341:0:1"
msgid "That way! The crown's that way!"
msgstr "Туда! Корона там!"

#. ja: さあ、王冠まで<br>あと少しさ！
#. de: Eilt! Eilt geschwind! Ihr seid beinahe da!
#. fr: Courez<nbsp>! Vous y êtes presque<nbsp>!
msgctxt "Balloon:4342:0:1"
msgid "Keep running! You're almost there!"
msgstr "Бегите! Уже почти добрались!"

#. ja: どうにかフーアを<br>退けたが、さて…
#. de: Puh, das hätten wir geschafft ...
#. fr: Nous y voilà...
msgctxt "Balloon:4343:0:1"
msgid "Phew, we did it..."
msgstr "Фух, получилось..."

#. ja: さあ、王冠を渡して<br>もらいましょうか…
#. de: Zeit, unsere Trophäe entgegenzunehmen.
#. fr: La couronne est à nous.
msgctxt "Balloon:4344:0:1"
msgid "Time to collect our prize."
msgstr "Пора забрать нашу награду."

#. ja: …安心しろ<br>相手は戦意を失っている…
#. de: Entspannt euch. Wir haben sie geschlagen.
#. fr: Tout va bien, les Fuath n'ont plus l'air de vouloir se battre.
msgctxt "Balloon:4345:0:1"
msgid "I daresay they've had their fill of sport."
msgstr "Думаю, с них хватит забав."

#. ja: こ、これで、終わり…<br>ですか？
#. de: Ist es ... ist es vorbei?
#. fr: C'est... c'est vraiment fini<nbsp>?
msgctxt "Balloon:4346:0:1"
msgid "Is... Is it over?"
msgstr "В-всё... закончилось?"

#. ja: それにしても見事な<br>幻惑の術でしたね…
#. de: Ihre Fä<shy>hig<shy>kei<shy>ten im Bereich der Illusionsmagie sind wahrlich erstaunlich.
#. fr: Ces illusions étaient plus vraies que nature...
msgctxt "Balloon:4347:0:1"
msgid "Their mastery over glamours is truly astounding."
msgstr "Каким же мастерством иллюзий они владеют..."

#. ja: さすがの手並みだ<br>見事だったよ
#. de: Alles lief, wie erwartet. Aber dennoch, eine unglaubliche Leistung.
#. fr: Bien joué<nbsp>! Je n'en espérais pas moins de toi.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4348:0:1"
msgid "It was no less than what<br>I expected, but─well done."
msgstr "Всё прошло именно так,<br>как я и ожидал. И всё же — отлично сработано."

#. ja: アリゼー…？
#. de: Alisaie<nbsp>...
#. fr: Alisaie...
msgctxt "Balloon:4349:0:1"
msgid "Alisaie..."
msgstr "Ализе..."

#. ja: どうか安らかに…
#. de: Tesleen<nbsp>... Hoffentlich findest du Frieden<nbsp>...
#. fr: Repose en paix, Tesleen...
msgctxt "Balloon:4350:0:1"
msgid "Rest well..."
msgstr "Покойся с миром..."

#. ja: 大罪喰いを<br>討伐してしまうなんて…
#. de: Der Licht<shy>bringer ist wirklich bezwungen<nbsp>... Ich kann es kaum glauben.
#. fr: Un grand purgateur est mort... J'ai du mal à y croire.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4351:0:1"
msgid "A Lightwarden, gone.<br>I can scarce believe it."
msgstr "Страж Света повержен.<br>Не верится."

#. ja: その恐怖を<br>忘れないようにな…
#. de: Die Angst ist gut. Vergiss sie nicht.
#. fr: Bien. Prends garde à ne jamais oublier cette peur.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4352:0:1"
msgid "Good. Keep that<br>memory with you."
msgstr "Хорошо. Не забывай<br>этот страх."

#. ja: 大罪喰いの恐ろしさ<br>肌で感じました…
#. de: Der Anblick eines Licht<shy>bringers kann einem wirklich Angst machen.
#. fr: Ce... Ce grand purgateur était vraiment <i>terrifiant</i>.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4353:0:1"
msgid "That Lightwarden...<br>That was <i>terrifying</i>."
msgstr "Этот Страж Света...<br>Это было <i>ужасно</i>."

#. ja: となれば、夜の闇も<br>戻りましょう
#. de: Und der Nachthimmel wird bald zurückkehren.
#. fr: Et voilà que la nuit tombe à nouveau.
msgctxt "Balloon:4354:0:1"
msgid "And thus doth the night return."
msgstr "И вот ночь вновь возвращается."

#. ja: 森を統べる<br>大罪喰いは墜ちた…
#. de: Der Licht<shy>bringer von Rak'tika ist gefallen.
#. fr: C'en est fini du grand purgateur de la forêt.
msgctxt "Balloon:4355:0:1"
msgid "So the Warden of the wood falls."
msgstr "Хранитель леса пал."

#. ja: これで荒野にも<br>夜の闇が戻るぞ！
#. de: Überall in der Region wird man nun voller Hoffnung zum Himmel aufsehen.
#. fr: On a fait revenir la nuit<nbsp>!
msgctxt "Balloon:4356:0:1"
msgid "We've taken back the darkness!"
msgstr "Мы вернули тьму!"

#. ja: やったわ…<br>テスリーン…
#. de: Das war für dich, Tesleen.
#. fr: Enfin... On a réussi, Tesleen...
msgctxt "Balloon:4357:0:1"
msgid "At last."
msgstr "Наконец-то."

#. ja: リーンの見立ては<br>正しかったようだな
#. de: Ryne hat Recht behalten. Ich bin stolz auf sie.
#. fr: On dirait que Ryne avait raison.
msgctxt "Balloon:4358:0:1"
msgid "It seems that Ryne was correct."
msgstr "Похоже, Рин оказалась права."

#. ja: 無事に倒すことができて<br>本当に良かったです
#. de: Wir haben ihn wirklich erledigt!
#. fr: Quel soulagement<nbsp>!
msgctxt "Balloon:4359:0:1"
msgid "Thank goodness we succeeded."
msgstr "Слава богу, мы справились."

#. ja: かくも異様な形態の<br>罪喰いが存在するとは…
#. de: Die Sünden<shy>ver<shy>tilger können erstaunliche Gestalt annehmen.
#. fr: Ce purgateur avait vraiment une forme étrange...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4360:0:1"
msgid "That was a passing<br>strange form for an eater."
msgstr "И надо же было пожирателю<br>принять такую жуткую форму."

#. ja: あなた…身体は大丈夫？
#. de: Wie geht es dir? Spürst du etwas?
#. fr: Tu n'as rien<nbsp>?
msgctxt "Balloon:4361:0:1"
msgid "Are you at all injured?"
msgstr "Ты не ранен?"

#. ja: ヴァウスリー…<br>この先にいるのか？
#. de: Jede Wette, der Fettwanst hat sich hinter seinen Vertilgern versteckt.
#. fr: Vauthry est tout près.
msgctxt "Balloon:4362:0:1"
msgid "Vauthry awaits."
msgstr "Ваутри ждёт."

#. ja: さて、いよいよ本丸に<br>殴り込みね
#. de: Endlich rücken wir ihm auf die Pelle.
#. fr: C'est le moment de vérité.
msgctxt "Balloon:4363:0:1"
msgid "It's the moment of truth."
msgstr "Вот и настал решающий миг."

#. ja: 周囲に罪喰いの<br>気配はないようだな
#. de: Hier scheint es keine weiteren Sünden<shy>ver<shy>tilger mehr zu geben.
#. fr: Plus aucune trace de purgateur à l'horizon.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4364:0:1"
msgid "No eaters remain to<br>stand in our way."
msgstr "Больше пожирателей,<br>которые встанут у нас на пути, нет."

#. ja: 感じます…<br>上の方から強烈な光の力を…
#. de: Ich spüre eine starke Präsenz des Lichts. Irgendwo weiter oben.
#. fr: Je peux ressentir une puissante lumière au-dessus de nous...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4365:0:1"
msgid "I feel it above─<br>a powerful light."
msgstr "Чувствую его сверху...<br>Мощный свет."

#. ja: ここまでは作戦どおり…<br>次の一手で王手を…
#. de: Bisher lief alles genau nach Plan. Hoffentlich bleibt es auch so.
#. fr: Tout se passe comme prévu... Et maintenant, place à la meilleure partie.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4366:0:1"
msgid "All has gone to plan thus far.<br>...To the extent there <i>is</i> a plan."
msgstr "Пока всё шло по плану.<br>...Насколько у нас вообще <i>есть</i> план."

#. ja: 罪喰いを強化するなんて<br>やっかいな相手ね…
#. de: Als er den Sünden<shy>ver<shy>tilgern plötzlich zu neuer Kraft verhalf, wurde mir einen Moment mulmig.
#. fr: Un purgateur qui a le pouvoir de rendre les autres encore plus dangereux... Il ne manquait plus que ça.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4367:0:1"
msgid "An eater that only makes<br>the others fiercer. Lovely."
msgstr "Пожиратель, который делает<br>остальных ещё свирепее. Ну чудесно."

#. ja: そうとも！<br>決して歩みを止めはしない！
#. de: Aber wir werden uns durch nichts mehr beirren lassen.
#. fr: Nous ne devons pas faiblir<nbsp>!
msgctxt "Balloon:4368:0:1"
msgid "We shall not falter!"
msgstr "Мы не дрогнем!"

#. ja: どんな絶望を<br>見せられたって私たちは…！
#. de: Zugegeben, das war ein ganz schön erschütternder Anblick.
#. fr: Nous ne céderons pas au désespoir<nbsp>!
msgctxt "Balloon:4369:0:1"
msgid "Not for despair, nor fate itself."
msgstr "Ни отчаяние, ни сама судьба нас не остановят."

#. ja: 警戒を怠るな<br>ここはヤツの領域だ
#. de: Sei auf der Hut! Wir sind hier in seinem Territorium.
#. fr: Restez sur vos gardes. C'est son territoire, ici.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4370:0:1"
msgid "Be on your guard.<br>This is wholly his realm."
msgstr "Будьте начеку.<br>Здесь его владения."

#. ja: エメトセルクは…<br>どこに…？
#. de: Wo hat er sich versteckt?
#. fr: Mais <i>où</i> est passé Emet-Selch<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4371:0:1"
msgid "<i>Where</i> is Emet-Selch?"
msgstr "<i>Где</i> Эмет-Селх?"

#. ja: これが最初の<br>「時代の終焉」…
#. de: Und zugleich ist es das Ende der Welt. Das <i>ursprüngliche</i> Ende der Welt.
#. fr: Nous y voilà, la fin du monde...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4372:0:1"
msgid "This is it─the<br>first and final end."
msgstr "Вот оно —<br>первое и последнее завершение эпохи."

#. ja: 世の理がほつれる様を<br>視ることになるなんてね
#. de: Zu sehen, wie alles begann<nbsp>... Eine einmalige Gelegenheit.
#. fr: Le dénouement de la vie elle-même...
msgctxt "Balloon:4373:0:1"
msgid "The unwinding of life itself..."
msgstr "Увидеть, как расплетается сама жизнь..."

#. ja: 哀れだな…<br>ヴァウスリー…
#. de: Eigentlich kann man mit Vauthry nur Mitleid haben<nbsp>...
#. fr: Vauthry me ferait presque de la peine...
msgctxt "Balloon:4374:0:1"
msgid "One cannot help but pity Vauthry..."
msgstr "Ваутри невольно жаль..."

#. ja: これですべての<br>大罪喰いが…！
#. de: Es war der Letzte der Licht<shy>bringer. Oder?
#. fr: Ça y est, tous les grands purgateurs sont morts<nbsp>!
msgctxt "Balloon:4375:0:1"
msgid "Finally, all the Lightwardens are gone..."
msgstr "Наконец-то все Стражи Света повержены..."

#. ja: ヒトはどこかな～？
#. de: Wooo seiiid iiihr?
#. fr: Youhou les humains<nbsp>! Vous êtes oùùù<nbsp>?♪
msgctxt "Balloon:4376:0:1"
msgid "Come out, come out, wherever you are!"
msgstr "Ау-у! Где вы там?"

#. ja: 見つけたら<br>何して遊ぼう？
#. de: Spielen wir etwa Verstecken?
#. fr: Qu'est-ce qu'on fait si on les retrouve<nbsp>?
msgctxt "Balloon:4377:0:1"
msgid "What should we do when we find them?"
msgstr "И что мы с ними сделаем, когда найдём?"

#. ja: また飛ばしちゃえ！
#. de: Und tschüss!
#. fr: On les balance super loin, pardi<nbsp>!!!
msgctxt "Balloon:4378:0:1"
msgid "We send them flying! Tee hee!"
msgstr "Подбросим их высоко-высоко! Хи-хи!"

#. ja: そろそろ来るかな？
#. de: \<seufz> Es wird langweilig. Vielleicht sollte ich mir andere Spielgefährten suchen<nbsp>...
#. fr: Bon alors, quand est-ce qu'ils arrivent...<nbsp>?
msgctxt "Balloon:4379:0:1"
msgid "Aaany moment now..."
msgstr "Ну когда же они придут..."

#. ja: やだ、怖い…！
#. de: Oje, oje! O weh, o weh!
#. fr: Oh, non<nbsp>! J'ai peur<nbsp>!<nbsp>...
msgctxt "Balloon:4380:0:1"
msgid "D-Don't let them eat me!"
msgstr "Н-не дайте им меня съесть!"

#. ja: おい、どうしたんだ？
#. de: Was ist geschehen?
#. fr: Quelqu'un m'explique ce qu'il se passe<nbsp>?
msgctxt "Balloon:4381:0:1"
msgid "What in the world...?"
msgstr "Да что тут вообще творится?.."

#. ja: 何がどうなってるんだ…
#. de: Was ist denn nur mit allen los?
#. fr: Je n'y comprends plus rien...
msgctxt "Balloon:4382:0:1"
msgid "What's wrong with everyone? "
msgstr "Что со всеми не так? "

#. ja: ワタシ…私は何を…？
#. de: Was ... mache ich hier?
#. fr: Qu-qu'est-ce qu'il m'est arrivé<nbsp>?
msgctxt "Balloon:4383:0:1"
msgid "Where...where am I?"
msgstr "Где... где я?"

#. ja: 頭が…ぼんやりして…
#. de: Mir ist so schwindelig<nbsp>...
#. fr: J'ai une de ces migraines...
msgctxt "Balloon:4384:0:1"
msgid "Ungh... My head..."
msgstr "Ох... Голова..."

#. ja: ヴァウスリ…さま…？
#. de: Mir ist, als hätte ich schrecklich geträumt<nbsp>...
#. fr: Don... Vauthry<nbsp>?
msgctxt "Balloon:4385:0:1"
msgid "Long live...Lord Vauthry?"
msgstr "Да здравствует... лорд Ваутри?"

#. ja: 恐ろしい目にあったわ
#. de: Irgendetwas Füchterliches ist geschehen.
#. fr: C'était horrible...
msgctxt "Balloon:4386:0:1"
msgid "It was awful... \\<sob>"
msgstr "Это было ужасно... <i>Хнык...</i>"

#. ja: そっちの主人は無事か？
#. de: Herr, geht es Euch gut?
#. fr: Est-ce que ça va<nbsp>?
msgctxt "Balloon:4387:0:1"
msgid "Are you all right?"
msgstr "Ты в порядке?"

#. ja: ぐー…
#. de: \<schnarch> Krrrr<nbsp>... tschüüüh<nbsp>... krrr<nbsp>...
#. fr: Zzz...
msgctxt "Balloon:4388:0:1"
msgid "Zzzzzz..."
msgstr "Хр-р-р..."

#. ja: むにゃむにゃ…
#. de: \<schmatz> Njam, njam, njam<nbsp>...
#. fr: (ronfle)...
msgctxt "Balloon:4389:0:1"
msgid "\\<snore> \\<snore>"
msgstr "<i>Хр-р-р... Хр-р-р...</i>"

#. ja: グゴォ…グゴォ…
#. de: \<murmel> Ah, nein<nbsp>... nicht mein Met<nbsp>... nicht<nbsp>... \<schnarch>
#. fr: Zzz... Faut... prévenir... Zzz...
msgctxt "Balloon:4390:0:1"
msgid "\\<slurp> \\<snort>"
msgstr "<i>Хлюп... хр-р...</i>"

#. ja: 早く起きろ！
#. de: Beeilt euch!
#. fr: Allez<nbsp>! Réveille-toi, bordel<nbsp>!
msgctxt "Balloon:4391:0:1"
msgid "Wake up, damn you!"
msgstr "Проснись, чтоб тебя!"

#. ja: 何がどうなっている！？
#. de: Was geht hier vor?!
#. fr: Mais...<nbsp>! Mais pourquoi tout le monde pionce<nbsp>!?
msgctxt "Balloon:4392:0:1"
msgid "What's happening!?"
msgstr "Что происходит?!"

#. ja: 粉を吸い込むな…！
#. de: Den Staub nicht einatmen<nbsp>...
#. fr: Respirez surtout pas cette satanée poudre<nbsp>!
msgctxt "Balloon:4393:0:1"
msgid "It's the dust! Don't breathe in the dust!"
msgstr "Это пыль! Не вдыхайте её!"

#. ja: あいつら、見てろよ～！
#. de: Schau dir den mal an!
#. fr: Regarde-moi ça<nbsp>!
msgctxt "Balloon:4394:0:1"
msgid "Keep an eye on them buggers!"
msgstr "Гляньте-ка на этих остолопов!"

#. ja: しばらくは大丈夫そうね
#. de: Das sollte für eine Weile reichen.
#. fr: Bon, on devrait tenir un bout de temps, avec ça<nbsp>!
msgctxt "Balloon:4395:0:1"
msgid "We're gonna need more meat..."
msgstr "Мяса нам понадобится побольше..."

#. ja: よーし、いい子だぞ～
#. de: Guter Junge ...
#. fr: Tout doux, ma belle.
msgctxt "Balloon:4396:0:1"
msgid "Who's a pretty girl, then?"
msgstr "Кто тут у нас такая красавица?"

#. ja: ヒック…もう呑めまひぇん…
#. de: \<hick> Bin Sternhagel voll ...
#. fr: (hic)... Je... J'crois que j'vais m'arrêter là pour (hic) ce soir<nbsp>!
msgctxt "Balloon:4397:0:1"
msgid "I think...\\<hic>...I've had enough..."
msgstr "Кажется... <i>Ик...</i> с меня хватит..."

#. ja: 素早くかき混ぜてっと…
#. de: Ich soll schnell rühren, hieß es<nbsp>...
#. fr: Et hop<nbsp>! On mélange<nbsp>!
msgctxt "Balloon:4398:0:1"
msgid "Whisk, whisk until it's mixed!♪"
msgstr "Мешай, мешай, пока всё не смешается!♪"

#. ja: ほら、あんたも飲めって！
#. de: Komm schon, trink mit ...
#. fr: Mais vas-y, juste un petit verre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4399:0:1"
msgid "Grab a seat!<br>...And a mug!"
msgstr "Садись!<br>...И кружку бери!"

#. ja: やることは山積みね…
#. de: Hier gibt's viel zu tun ...
#. fr: J'ai tellement de choses à faire...
msgctxt "Balloon:4400:0:1"
msgid "You do too much..."
msgstr "Ты слишком много на себя берёшь..."

#. ja: うぅん、難しい…
#. de: Puh, das ist echt schwer ...
#. fr: Hum... Je vois, je vois<nbsp>!
msgctxt "Balloon:4401:0:1"
msgid "Ugh, I need a drink..."
msgstr "Ох, выпить бы..."

#. ja: くぅ～！<br>たまんないねぇ！
#. de: Arg, so ein Mist!
#. fr: Ah, cette bière est délicieuse<nbsp>!
msgctxt "Balloon:4402:0:1"
msgid "Aye, that hits the spot!"
msgstr "Вот это то, что надо!"

#. ja: ラリホー！
#. de: Ho-holladrio!
#. fr: Lali-ho<nbsp>!
msgctxt "Balloon:4403:0:1"
msgid "Lali-hooo!"
msgstr "Лали-хо-о-о!"

#. ja: ラ…ラ…ラリッホー！
#. de: Ho-la-dri-ooo ... \<piep>
#. fr: La-la-lali-ho<nbsp>!!
msgctxt "Balloon:4404:0:1"
msgid "La... La...li...ho!"
msgstr "Ла... Ла... ли... хо!"

#. ja: よっ！　ほっ！！
#. de: Hallo!
#. fr: Oh hisse<nbsp>!
msgctxt "Balloon:4405:0:1"
msgid "Hup! Ha!"
msgstr "Раз! Ещё раз!"

#. ja: 異変はねぇべか？
#. de: Das ist ungewöhnlich ...
#. fr: Tout a l'air normal...
msgctxt "Balloon:4406:0:1"
msgid "No swivin' Goggs about, then?"
msgstr "Гоггов что-то не видать..."

#. ja: お、思ったより高いなぁ…
#. de: Hm. Das ist teurer, als gedacht.
#. fr: J-j'ai le vertige...
msgctxt "Balloon:4407:0:1"
msgid "B-Blast! It's higher than I thought..."
msgstr "Чёрт... Выше, чем я думал..."

#. ja: こっちの網も<br>問題なさそうだな…
#. de: Dieses Netz scheint auch soweit in Ordnung zu sein<nbsp>...
#. fr: Ce filet est en parfait état<nbsp>!
msgctxt "Balloon:4408:0:1"
msgid "No rips that I can see..."
msgstr "Вроде целая... ни одной прорехи."

#. ja: おや、アンタも<br>一杯やりにきたのかい？
#. de: Na, bist du auch auf ein schnelles Gläschen hier?
#. fr: Allez, viens donc te rincer le gosier<nbsp>!
msgctxt "Balloon:4409:0:1"
msgid "Heading in for a pint?"
msgstr "За кружечкой?"

#. ja: ちゃんと飯は確保しねぇとな！
#. de: Pökeln, einlegen, trocknen! Alles muss haltbar gemacht werden!
#. fr: Il me faut plus de prrrovisions<nbsp>!
msgctxt "Balloon:4410:0:1"
msgid "We've got to protect our food stores!"
msgstr "Надо бы запасы еды поберечь!"

#. ja: 何か足りてないものはない？
#. de: Brauchst du noch irgendwas?
#. fr: Vous avez tout ce qu'il vous faut<nbsp>?
msgctxt "Balloon:4411:0:1"
msgid "Is there aught else you need?"
msgstr "Тебе ещё чего-нибудь нужно?"

#. ja: 大丈夫だよ、ありがとう
#. de: Nein, alles gut! Danke dir.
#. fr: Oui, ça va, merrrci<nbsp>!
msgctxt "Balloon:4412:0:1"
msgid "I'm fine for now, thanks."
msgstr "Пока ничего, спасибо."

#. ja: あ～らよっと！
#. de: ♪ Da erntet der Bauer das duftende Heu<nbsp>... ♪
#. fr: Et hop<nbsp>!
msgctxt "Balloon:4413:0:1"
msgid "Just a few more rows!"
msgstr "Ещё несколько рядков!"

#. ja: お手伝いが<br>おわってからにして！
#. de: He, wir sind mit dem Beet noch nicht fertig!
#. fr: Finissez d'aborrrd d'aider<nbsp>!
msgctxt "Balloon:4414:0:1"
msgid "Hey! We're meant to do our chores first!"
msgstr "Эй! Сначала дела доделаем!"

#. ja: まてー！！
#. de: Nicht so schnell!
#. fr: Je vais t'avoirrr<nbsp>!
msgctxt "Balloon:4415:0:1"
msgid "Wait!"
msgstr "Стой!"

#. ja: まてまてー！！
#. de: Waaarte!
#. fr: Hi hi hi<nbsp>!
msgctxt "Balloon:4416:0:1"
msgid "I'm gonna get you!"
msgstr "А ну стой!"

#. ja: わーい、おいついたー！
#. de: Ha! Hab dich! ♪
#. fr: Ouaiiiis, je t'ai attrrrapée<nbsp>!
msgctxt "Balloon:4417:0:1"
msgid "Yay! I got you!"
msgstr "Ура! Догнал!"

#. ja: 手加減してあげたからだよーっ！
#. de: Nur weil ich absichtlich langsamer gelaufen bin!
#. fr: C'est parrrce que j'ai été lentement exprès<nbsp>!
msgctxt "Balloon:4418:0:1"
msgid "Nuh-uh! I let you catch me!"
msgstr "Да ну! Я сама дала тебе себя поймать!"

#. ja: はい、追いかけっこおわりっ！
#. de: Jetzt kommt mir wieder helfen!
#. fr: Allez, hop, fini de jouer<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4419:0:1"
msgid "That's enough! You're <i>both</i> winners."
msgstr "Всё, хватит! <i>Вы оба</i> победители."

#. ja: おいかっけこしよっ！
#. de: Haha, du bist's!
#. fr: Viens on joue au loup<nbsp>!
msgctxt "Balloon:4420:0:1"
msgid "Let's play catch-the-kitten!"
msgstr "Давай играть в кошки-мышки!"

#. ja: いいよー、まけないんだからっ！
#. de: Na warte, dir zeig ich's!
#. fr: D'accorrrd, mais ne pleure pas quand tu auras perdu<nbsp>!
msgctxt "Balloon:4421:0:1"
msgid "All right, you go first!"
msgstr "Ладно, только ты первый!"

#. ja: こっちだよーん！
#. de: Du kriegst mich nieee!
#. fr: Hi hi, parrr ici<nbsp>!!
msgctxt "Balloon:4422:0:1"
msgid "This way, slowpoke!"
msgstr "А вот и не догонишь!"

#. ja: 腹ごしらえはしねぇとな！
#. de: Har, ich freu mich auf 'ne ordentliche Mahlzeit!
#. fr: C'est l'heure de la pitance<nbsp>!
msgctxt "Balloon:4423:0:1"
msgid "Almost time to eat!"
msgstr "Скоро обедать!"

#. ja: ど、どうしてこんなことに…
#. de: W-Wie konnte das passieren? Was soll ich jetzt nur machen?
#. fr: Mais qu'est-ce qui t'est arrivé<nbsp>?
msgctxt "Balloon:4424:0:1"
msgid "W-We'll get you some medicine..."
msgstr "М-мы найдём тебе лекарство..."

#. ja: そろそろいい頃合いかな？
#. de: Na, lange muss das nicht mehr köcheln!
#. fr: Ah, c'est bientôt prêt<nbsp>!
msgctxt "Balloon:4425:0:1"
msgid "It's gotta be cooked by now..."
msgstr "Уже, должно быть, готово..."

#. ja: ねぇ、あの噂信じられる！？
#. de: Sag mal, hast du dieses haarsträubende Gerücht schon gehört?
#. fr: Tu y crois, toi, à cette histoire<nbsp>?
msgctxt "Balloon:4426:0:1"
msgid "Did you hear what happened to that girl!?"
msgstr "Ты слышал, что с той девушкой случилось?!"

#. ja: こんだけ補強すれば<br>大丈夫だろ
#. de: Hier ein bisschen ausbessern, dann hält das schon!
#. fr: Bon, ça devrait tenir, maintenant<nbsp>!
msgctxt "Balloon:4427:0:1"
msgid "That ought to keep the wind out."
msgstr "Теперь ветер точно не продует."

#. ja: どうか、お恵みを…
#. de: Bitte<nbsp>... Eine kleine Spende<nbsp>...
#. fr: Une petite pièce, s'il vous plaît<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4428:0:1"
msgid "Please...<br>Whatever you can spare..."
msgstr "Подайте... сколько не жалко..."

#. ja: おばあちゃん、夜のお話して！
#. de: Oma, erzähl mir noch mal von der Nacht!
#. fr: Mamie<nbsp>! Raconte-moi encore comment c'était la nuit<nbsp>!
msgctxt "Balloon:4429:0:1"
msgid "Maybe I should join him..."
msgstr "Может, мне к нему присоединиться..."

#. ja: クリスタリウムの親戚が手紙でね…
#. de: Meine Cousine hat mir einen Brief aus Crystarium geschickt!
#. fr: Mon cousin m'a envoyé une lettre de Cristarium<nbsp>!
msgctxt "Balloon:4430:0:1"
msgid "But the letter from the Crystarium said..."
msgstr "Но в письме из Кристариума сказано..."

#. ja: 自給自足、っと…
#. de: Ich träume davon, eines Tages auf eigenen Beinen zu stehen<nbsp>...
#. fr: Je rêve de devenir auto-suffisant un jour...
msgctxt "Balloon:4431:0:1"
msgid "I hope this crop turns out better than the last..."
msgstr "Надеюсь, в этом году урожай будет лучше, чем в прошлом..."

#. ja: 話し出すと止まらないのね
#. de: Sobald sie anfangen zu reden, gibt es kein Halten mehr!
#. fr: Une fois que tu as commencé à parler, on ne t'arrête plus, toi<nbsp>!
msgctxt "Balloon:4432:0:1"
msgid "Don't you wag your finger at me!"
msgstr "И не тычь в меня пальцем!"

#. ja: 当面の備蓄は、問題ないね
#. de: Im Moment reichen die Reserven aus<nbsp>...
#. fr: Pour le moment, les réserves sont suffisantes...
msgctxt "Balloon:4433:0:1"
msgid "I once knew twins who had hair just like yours!"
msgstr "Я знал близнецов, у которых волосы были точь-в-точь как у тебя!"

#. ja: この前、巡回中にね…
#. de: Du wirst nicht glauben, was ich heute Morgen bei meiner Patrouille gesehen habe!
#. fr: Vous n'allez pas croire ce que j'ai vu pendant ma patrouille ce matin<nbsp>!
msgctxt "Balloon:4434:0:1"
msgid "We'd best scout the area first."
msgstr "Сначала надо бы разведать окрестности."

#. ja: あの子のこと、忘れられないの？
#. de: Du hast es nicht vergessen, hoffe ich?
#. fr: Tu ne l'as pas oubliée, j'espère<nbsp>?
msgctxt "Balloon:4435:0:1"
msgid "You can cross that bridge when you come to it."
msgstr "До этого моста ещё дойти надо."

#. ja: 静かに、森の声に耳を澄まして…
#. de: Ruhe<nbsp>... Ich versuche, der Stimme des Waldes zuzuhören!
#. fr: Chut... J'essaie d'écouter la voix de la forêt<nbsp>!
msgctxt "Balloon:4436:0:1"
msgid "The forest calls to me..."
msgstr "Лес зовёт меня..."

#. ja: 見たんだ、白い影が…！
#. de: Ich sah einen riesigen weißen Schatten!
#. fr: J'ai vu une immense forme blanche<nbsp>!
msgctxt "Balloon:4437:0:1"
msgid "I am not lying! I saw it!"
msgstr "Я не вру! Я это видел!"

#. ja: 鹿肉、サイコー！
#. de: Ich liebe Hirschfleisch!
#. fr: J'adore la viande de cerf<nbsp>!
msgctxt "Balloon:4438:0:1"
msgid "Well, if the others don't get here soon, we'll have to eat their share!"
msgstr "Если остальные скоро не придут, придётся съесть и их порцию!"

#. ja: 緩みはないだろうな…
#. de: Wir werden nicht nachlassen.
#. fr: Tout a l'air en place...
msgctxt "Balloon:4439:0:1"
msgid "Give me a moment, would you? I'm sure it's crooked!"
msgstr "Секунду, ладно? Кажется, криво висит!"

#. ja: この前ウィメったらね…
#. de: Uimet hat mir heute Morgen etwas sehr Lustiges erzählt!
#. fr: Uimet m'a raconté quelque chose de très drôle ce matin<nbsp>!
msgctxt "Balloon:4440:0:1"
msgid "That is what Uimet said, anyway."
msgstr "Во всяком случае, так сказала Уимет."

#. ja: あの子、そういうとこあるよね～！
#. de: Ha ha, da besteht eine gewisse Ähnlichkeit.
#. fr: Ha ha, ça lui ressemble bien, tiens<nbsp>!
msgctxt "Balloon:4441:0:1"
msgid "It is probably true, in that case."
msgstr "Тогда, пожалуй, это правда."

#. ja: 祭儀の準備、どうなってる？
#. de: Kommen die Vor<shy>bereitungen für die Zeremonie gut voran?
#. fr: Les pré<shy>pa<shy>ra<shy>tions pour le festival avancent bien<nbsp>?
msgctxt "Balloon:4442:0:1"
msgid "Is everything ready?"
msgstr "Всё готово?"

#. ja: ラニルがみんなやってるわ
#. de: Lanille kümmert sich um alles!
#. fr: Lanille s'occupe de tout<nbsp>!
msgctxt "Balloon:4443:0:1"
msgid "Master Lanille has taken care of it."
msgstr "Госпожа Ланиль обо всём позаботилась."

#. ja: それなら大丈夫そうだな
#. de: Dann besteht kein Grund zur Sorge.
#. fr: Dans ce cas-là, il n'y a aucune inquiétude à avoir<nbsp>!
msgctxt "Balloon:4444:0:1"
msgid "Then I shall return to my post."
msgstr "Тогда я вернусь на пост."

#. ja: 全部届いてるかな？
#. de: Ist auch wirklich alles da?
#. fr: Je ferais mieux de les recompter, juste pour être sûr.
msgctxt "Balloon:4445:0:1"
msgid "I'd better count them again, just to be sure."
msgstr "Надо пересчитать, на всякий случай."

#. ja: いいこネ！ いいこネ！
#. de: Brave Echse. Feine Echse!
#. fr: Tu es adorable, oui oui<nbsp>!
msgctxt "Balloon:4446:0:1"
msgid "Yes, yes! Adorable!"
msgstr "Да-да! Какая прелесть!"

#. ja: いい石はないかネ…
#. de: Welcher Stein der schönste? Finden, sammeln!
#. fr: Y a rien qui brille, par ici, rien du tout<nbsp>!
msgctxt "Balloon:4447:0:1"
msgid "There must be at least one shiny here!"
msgstr "Тут хоть один блестящий камешек найдётся?"

#. ja: ちょっと高くないかしら…
#. de: Da verlangt Ihr aber eine ziemliche Summe von mir<nbsp>...
#. fr: C'est... c'est un peu cher, non<nbsp>?
msgctxt "Balloon:4448:0:1"
msgid "Not a bad price, all things considered."
msgstr "В целом цена неплохая."

#. ja: この商談…<br>まとめてみせるわよ！
#. de: Lass mich die Ver<shy>hand<shy>lungen knapp zusammenfassen<nbsp>...
#. fr: Je vais nous avoir un bon prix, ne t'inquiète pas<nbsp>!
msgctxt "Balloon:4449:0:1"
msgid "I'll get us a good deal, don't you worry!"
msgstr "Я для нас сторгую хорошую цену, не волнуйся!"

#. ja: 遠くへ行っちゃ駄目ヨ～
#. de: He, nicht zu weit weglaufen!
#. fr: Toi, tu restes ici, oui<nbsp>!
msgctxt "Balloon:4450:0:1"
msgid "Now, you stay right there!"
msgstr "Ну-ка, сиди здесь!"

#. ja: ど、どこにいっちゃったネ！？
#. de: Oh<nbsp>... Oh ih! Wo ist Echse hin?
#. fr: Tiens<nbsp>? Mais... Où est-il<nbsp>?
msgctxt "Balloon:4451:0:1"
msgid "Hmm? Where did it go?"
msgstr "Хм? Куда оно делось?"

#. ja: ちょっと目を離したらこうネ…
#. de: Einmal nicht hingeschaut, schuppiger Freund sofort weg.
#. fr: Je l'ai juste quitté des yeux une seule seconde, une seule, oui<nbsp>!
msgctxt "Balloon:4452:0:1"
msgid "I take my eyes off of it for one moment..."
msgstr "Стоило на миг отвернуться..."

#. ja: 戻ってくるネ～！
#. de: Komm zurück! Heee!
#. fr: Reviens ici<nbsp>!
msgctxt "Balloon:4453:0:1"
msgid "Come back here!"
msgstr "А ну вернись!"

#. ja: まーた見失っちゃったのヨ！
#. de: Schon wieder verschwunden?! Ach, Echse<nbsp>...
#. fr: Mais, il a encore disparu, disparu, oui<nbsp>!
msgctxt "Balloon:4454:0:1"
msgid "Not again!"
msgstr "Опять?!"

#. ja: これは、とてもまずいのネ…
#. de: Nicht gut. Gar, gar nicht gut!
#. fr: Oh là là, c'est la tuile, oui<nbsp>!
msgctxt "Balloon:4455:0:1"
msgid "Not good, not good..."
msgstr "Нехорошо... совсем нехорошо..."

#. ja: も、戻ってきたのネ！？
#. de: Ah! Echse wieder da! Puh<nbsp>...
#. fr: Ah<nbsp>! Te voilà, oui<nbsp>!
msgctxt "Balloon:4456:0:1"
msgid "There it is!"
msgstr "Вот оно!"

#. ja: 勝手にどこかへ<br>いっちゃダメヨー！
#. de: Darfst nicht einfach weglaufen, ja! Sag vorher Bescheid, Echse.
#. fr: Tu ne dois pas t'éloigner comme ça, non<nbsp>! Compris<nbsp>?
msgctxt "Balloon:4457:0:1"
msgid "You must not wander off like that, understood?"
msgstr "Не смей вот так убегать, понял?"

#. ja: そ、そうだよね…
#. de: Du hast ja recht<nbsp>... \<seufz>
#. fr: Hum, tu as raison...
msgctxt "Balloon:4458:0:1"
msgid "That's a fair point..."
msgstr "Да, пожалуй..."

#. ja: 足りないものはないよな？
#. de: Fehlt es uns auch an nichts?
#. fr: J'ai l'impression d'avoir oublié quelque chose...
msgctxt "Balloon:4459:0:1"
msgid "I have a feeling I've forgotten something."
msgstr "Кажется, я что-то забыл."

#. ja: 大丈夫、大丈夫よ…
#. de: Sssh. Ist ja gut. Alles wird gut.
#. fr: Doucement, tout va bien<nbsp>!
msgctxt "Balloon:4460:0:1"
msgid "Come now, you mustn't fret."
msgstr "Ну же, не волнуйся."

#. ja: 何度見ても<br>凄い光景だよなぁ…
#. de: An dieser schaurig-schönen Aussicht kann ich mich einfach nicht sattsehen!
#. fr: Ce paysage ne cessera jamais de m'émerveiller.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4461:0:1"
msgid "It never ceases to amaze.<br>Every time I see it..."
msgstr "Каждый раз вижу — и всё равно поражаюсь.<br>Вот это зрелище..."

#. ja: なんだかなぁ…
#. de: Mir läuft die Zeit davon<nbsp>...
#. fr: Qu'est-ce que je suis censé faire, maintenant...
msgctxt "Balloon:4462:0:1"
msgid "What am I supposed to do now!?"
msgstr "И что мне теперь делать?!"

#. ja: いろんな情報仕入れたネ！
#. de: Doch, schwöre ich. Säcke voller Gil, in jedem Wagen!
#. fr: Des nouvelles croustillantes, oui oui<nbsp>!
msgctxt "Balloon:4463:0:1"
msgid "A tasty morsel of information, yes?"
msgstr "А у меня есть для тебя кое-что вкусненькое, да?"

#. ja: お宝が眠ってるといいネ…
#. de: Nicht ein klitzekleiner Staubwurm?
#. fr: J'espère qu'il y a un trésor, ici, oui oui<nbsp>!
msgctxt "Balloon:4464:0:1"
msgid "Leave no stone unturned..."
msgstr "Нужно обыскать каждый уголок..."

#. ja: あんな近くに大罪喰いが…
#. de: Ein Licht<shy>bringer, so nah ...
#. fr: Les purgateurs sont si près d'ici...
msgctxt "Balloon:4465:0:1"
msgid "To see a sin eater from so close... I will never forget it."
msgstr "Увидеть пожирателя грехов так близко... Этого я никогда не забуду."

#. ja: オレと一山当てようぜ！
#. de: Und die Kohle, die teilen wir uns! Denk mal drüber nach.
#. fr: On va devenir riches<nbsp>!!
msgctxt "Balloon:4466:0:1"
msgid "And we'll split the profits!"
msgstr "А прибыль поделим пополам!"

#. ja: 大丈夫だ、問題ない
#. de: Ja, es ist alles da, wie vereinbart.
#. fr: Oui, tout est là comme convenu.
msgctxt "Balloon:4467:0:1"
msgid "Yes, it's all here, as agreed."
msgstr "Да, всё на месте, как и договаривались."

#. ja: おつかれ！<br>調子はどうだい？
#. de: Ganz schön heiß heute, was?
#. fr: Alors, prêt à reprendre le travail<nbsp>?
msgctxt "Balloon:4468:0:1"
msgid "So, ready to get back to work?"
msgstr "Ну что, готов вернуться к работе?"

#. ja: バッチリだぜ！<br>ちょいと休憩中でな！
#. de: Und wie. Die Sacksuppe läuft in Strömen.
#. fr: Euh... Oui oui. Motivé comme jamais<nbsp>!
msgctxt "Balloon:4469:0:1"
msgid "Not yet. Still coughing up grey phlegm."
msgstr "Пока нет. Всё ещё отхаркиваю серую мокроту."

#. ja: 了解！<br>無理しないでな！
#. de: Ha, musste erstmal mein Arschwasser sehen!
#. fr: Oulà, je peux sentir ton énergie d'ici dis donc.
msgctxt "Balloon:4470:0:1"
msgid "Erm... You might wanna get that looked at..."
msgstr "Э-э... Тебе бы это проверить у лекаря..."

#. ja: フーア族のやつらめ…
#. de: Immer diese Fuath!
#. fr: Satanés Fuath...
msgctxt "Balloon:4471:0:1"
msgid "The Fuath are nothing but trouble!"
msgstr "От этих фуатов одни неприятности!"

#. ja: ボクの主はね…
#. de: Mein Reiter, mein armer Reiter ...
#. fr: Tu sais, ma maîtresse était vraiment une femme fantastique...
msgctxt "Balloon:4472:0:1"
msgid "As my master always used to say..."
msgstr "Как всегда говорил мой хозяин..."

#. ja: こいつはおいしいキノコだ！
#. de: Der Pilz sieht lecker aus ...
#. fr: Ouh, quel délicieux champignon<nbsp>!
msgctxt "Balloon:4473:0:1"
msgid "Yes, better than boiling them, methinks."
msgstr "Да, куда вкуснее, чем варёные, я полагаю."

#. ja: よい取引をしようじゃないか？
#. de: Wie wäre es mit einem ehrbaren Handel, hm?
#. fr: Que dirait-tu de passer un marché avec moi<nbsp>?
msgctxt "Balloon:4474:0:1"
msgid "A fair trade, it would seem."
msgstr "Похоже, сделка будет честной."

#. ja: あまり育ちが<br>よくない気がする…
#. de: Ich habe das Gefühl, dieser Pilz wächst gar nicht mächtig-prächtig.
#. fr: J'ai l'impression qu'ils ne sont pas aussi gros que d'habitude...
msgctxt "Balloon:4475:0:1"
msgid "A bit on the small side, perhaps..."
msgstr "Маловаты, пожалуй..."

#. ja: 元気に育つのだぞ～
#. de: Wachse! Wachse in höchste Höhen!
#. fr: Allez mes jolis<nbsp>!
msgctxt "Balloon:4476:0:1"
msgid "Slowly but surely do the mushrooms grow."
msgstr "Растите потихоньку, грибочки."

#. ja: どちらも上出来そうだの
#. de: Das Myzel dieser beiden Sprösslinge wird sich einst durch die gesamte Höhle erstecken.
#. fr: Hum... Difficile de choisir, ils m'ont tous les deux l'air délicieux<nbsp>!
msgctxt "Balloon:4477:0:1"
msgid "The blue one... Or the other blue one... Hmm..."
msgstr "Синий... или другой синий... Хм..."

#. ja: ふむふむ、興味深いぞ…
#. de: Hm. Interessant.
#. fr: Intéressant, intéressant...
msgctxt "Balloon:4478:0:1"
msgid "I am sure my eyesight is getting worse."
msgstr "Кажется, зрение у меня всё хуже..."

#. ja: ふんっ！ ほっ…！
#. de: Hnnnggg ... Hnnnggg ... \<pups>
#. fr: Oh hisse<nbsp>!!!
msgctxt "Balloon:4479:0:1"
msgid "Oh! This is a heavy one!"
msgstr "Ох! Тяжёлый какой!"

#. ja: いまあげるからね～
#. de: Trinkt fein, meinen knuffeligen Knöllchen.
#. fr: Oui oui, tenez tenez<nbsp>! Du calme<nbsp>!
msgctxt "Balloon:4480:0:1"
msgid "Gather round, little ones."
msgstr "Идите сюда, мои крошки."

#. ja: どんなおもしろいことする！？
#. de: Was wollen wir jetzt spielen, Freunde?
#. fr: Venez on joue à quelque chose de drôle<nbsp>!
msgctxt "Balloon:4481:0:1"
msgid "And we'll call it “Delta Attack!”"
msgstr "А давайте назовём это «Атака Дельта»!"

#. ja: 魔法で変身してみない？
#. de: Wie wär's wenn ich dich in was Lustiges verwandel, hm?
#. fr: Et si on jouait à se transformer<nbsp>?
msgctxt "Balloon:4482:0:1"
msgid "Let's try shapechanging!"
msgstr "Давайте попробуем превратиться!"

#. ja: やりたい、やりたい！
#. de: Oh, ja! Tolle Idee!
#. fr: Ouaiiiis<nbsp>!
msgctxt "Balloon:4483:0:1"
msgid "That sounds like fun!"
msgstr "Здорово! Давайте!"

#. ja: ふふっ、任せてよっ♪
#. de: Hihi. Meine leichteste Übung!
#. fr: Hi hi, vous n'allez pas en croire vos yeux<nbsp>!♪
msgctxt "Balloon:4484:0:1"
msgid "Watch this!"
msgstr "Смотрите!"

#. ja: わぁ！<br> 楽しみ～！
#. de: Das wird ein Spaß!
#. fr: Hi hi hi, allez vas-y<nbsp>!
msgctxt "Balloon:4485:0:1"
msgid "Ooh! I can't wait to see this!"
msgstr "О-о-о! Не терпится посмотреть!"

#. ja: いくよ…<br>えいっ！
#. de: Auf geht's!
#. fr: C'est partiiii <nbsp>!
msgctxt "Balloon:4486:0:1"
msgid "Piff, paff, poff!"
msgstr "Пиф-паф-пуф!"

#. ja: わっ！
#. de: Hups!
#. fr: Waouh<nbsp>!
msgctxt "Balloon:4487:0:1"
msgid "Eek!"
msgstr "Ой!"

#. ja: ピギィ…
#. de: \<pieps> ...
#. fr: Grouiiik<nbsp>!
msgctxt "Balloon:4488:0:1"
msgid "Oink!"
msgstr "Хрюк!"

#. ja: へへっ、すごいでしょ！
#. de: Hihihi. Ist das nicht großartig?!
#. fr: Alors, alors<nbsp>? Génial, non<nbsp>?
msgctxt "Balloon:4489:0:1"
msgid "Hee hee! How terribly amusing!"
msgstr "Хе-хе! До чего же забавно!"

#. ja: あはは！<br> ポークシーだ！
#. de: Hahaha, eine Quiexie!
#. fr: Bwahaha, c'est un porxie<nbsp>!
msgctxt "Balloon:4490:0:1"
msgid "Haha! A porxie!"
msgstr "Ха-ха! Поркси!"

#. ja: ピギィー！
#. de: \<pieps>!
#. fr: Grouiiik<nbsp>!
msgctxt "Balloon:4491:0:1"
msgid "Oink! Oink!"
msgstr "Хрюк-хрюк!"

#. ja: さて…<br>どうやって元に戻そう…
#. de: Aber wie verwandeln wir sie jetzt zurück?
#. fr: Bon, par contre je sais pas comment on annule le sortilège...
msgctxt "Balloon:4492:0:1"
msgid "Now I just need to work out how to reverse it..."
msgstr "Теперь осталось придумать, как всё вернуть обратно..."

#. ja: おもしろーい！<br> まてー！
#. de: Haha, das ist lustig! He, wo willst du hin?
#. fr: Hi hi hi, c'est trop rigolo<nbsp>!
msgctxt "Balloon:4493:0:1"
msgid "Wait for me!"
msgstr "Подожди меня!"

#. ja: あっ、ちょっと待ってよ～！
#. de: He, wartet!
#. fr: Ah, reviens<nbsp>!
msgctxt "Balloon:4494:0:1"
msgid "Come back!"
msgstr "Вернись!"

#. ja: えっ…
#. de: Uhm ...
#. fr: Euh...
msgctxt "Balloon:4495:0:1"
msgid "Ummm..."
msgstr "Э-э-э..."

#. ja: ビ、ビーバーだぁ～！
#. de: E-Ein B-Biber! Aaaah!
#. fr: C... castooooor<nbsp>!
msgctxt "Balloon:4496:0:1"
msgid "It's a beaver!"
msgstr "Б-бобёр!"

#. ja: ガウ！
#. de: \<knurrr>!
#. fr: Graou<nbsp>!
msgctxt "Balloon:4497:0:1"
msgid "Snook!"
msgstr "Снук!"

#. ja: ひ、ひぃ～！
#. de: Hiiilfe!
#. fr: Ouiiiin<nbsp>!
msgctxt "Balloon:4498:0:1"
msgid "You'll never catch me!"
msgstr "Ты меня никогда не поймаешь!"

#. ja: ガウガウ～！
#. de: \<knurrr>!!
#. fr: Graougraougraou<nbsp>!
msgctxt "Balloon:4499:0:1"
msgid "Snook! Chit!"
msgstr "Снук! Чит!"

#. ja: どっちのお花が<br>似合うかなぁ…
#. de: Welche Blume steht mir besser? Was meinst du?
#. fr: Hum, impossible de choisir quelle fleur lui va le mieux...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4500:0:1"
msgid "I wonder who pushed up <i>these</i> daisies?"
msgstr "Интересно, кто тут <i>такие</i> ромашки посадил?"

#. ja: あまくておいひ～い！
#. de: Hmmm! Sooo süüüß!
#. fr: Cette pomme est délicieuse<nbsp>!
msgctxt "Balloon:4501:0:1"
msgid "If I eat the whole thing, I shall go “pop!”"
msgstr "Если съем целиком, то лопну!"

#. ja: ちょっとひとやすみ…
#. de: Uff, ich brauch jetzt ein kleines Päuschen ...
#. fr: Ah, ça fait du bien de se reposer les ailes<nbsp>!
msgctxt "Balloon:4502:0:1"
msgid "All this frolicking has worn me out..."
msgstr "Уф, от всей этой беготни я совсем вымотался..."

#. ja: いつまで食べてるのっ！
#. de: Wie viele Früchte willst du denn noch in dich reinstopfen?!
#. fr: Pose cette pomme et viens nous aider<nbsp>!
msgctxt "Balloon:4503:0:1"
msgid "Haven't you had enough!?"
msgstr "Да сколько можно жрать?!"

#. ja: 休んでないで働いてよね！
#. de: Nicht schlafen, bewegen!
#. fr: Hop hop hop, au travail<nbsp>!
msgctxt "Balloon:4504:0:1"
msgid "Come on, lazy bones! There's frolicking to be done!"
msgstr "Ну давай, лежебока! Нас ждут весёлые дела!"

#. ja: むにゃむにゃ…
#. de: \<schmatz>!
#. fr: C'est tout doux...
msgctxt "Balloon:4505:0:1"
msgid "So soft... So fluffy..."
msgstr "Такая мягкая... Пушистая..."

#. ja: 草と花に囲まれ～♪<br>今日も遊ぶよ～♪
#. de: Blumen, Gräser, Pflanzen ♪<br>Lasst uns lustig tanzen ♪
#. fr: Comment t'as fait pour monter jusqu'ici, toi<nbsp>?
msgctxt "Balloon:4506:0:1"
msgid "No one can fly higher than meee～♪"
msgstr "Никто не взлетит выше меня-ая～♪"

#. ja: ボクについて来れるかなっ！？
#. de: Fang mich doch!
#. fr: Je parie que je vais plus vite que toi<nbsp>!
msgctxt "Balloon:4507:0:1"
msgid "Now you see me, now you don't!"
msgstr "А ну догони меня!"

#. ja: また見つかっちゃった！<br>あなた、やるねー！
#. de: Haha! Du hast mich gefunden! Jetzt bist du dran!
#. fr: Waouh, t'es trop rapide<nbsp>! Encore<nbsp>!
msgctxt "Balloon:4508:0:1"
msgid "Found me again! I'll have to try harder!"
msgstr "Опять нашёл! Придётся постараться получше!"

#. ja: やるね～、次はどうかな？
#. de: Nicht schlecht! Noch eine Runde?
#. fr: Hi hi, allez on recommence<nbsp>!
msgctxt "Balloon:4509:0:1"
msgid "Very good! Let's see if you can find me again!"
msgstr "Ну и ну! Посмотрим, найдёшь ли меня ещё раз!"

#. ja: くっそー！<br> 今度は見つからないぞ！
#. de: Menno! Wie machst du das?
#. fr: Raaaah<nbsp>!! Tu m'auras pas cette fois<nbsp>!
msgctxt "Balloon:4510:0:1"
msgid "Ooh! You won't be so lucky next time!"
msgstr "Вот блин! В следующий раз так просто не поймаешь!"

#. ja: 遊べて楽しかったー！<br>まったね～！
#. de: Haha, das hat Spaß gemacht! Lass uns bald wieder spielen!
#. fr: C'était sympa de jouer avec toi<nbsp>! À la prochaine<nbsp>!
msgctxt "Balloon:4511:0:1"
msgid "You're fun! Bye for now!"
msgstr "С тобой весело! Пока!"

#. ja: これをあげるから、許してよ～
#. de: Hier, die sind für dich. Bitte sei mir nicht mehr böse ...
#. fr: Tiens, prends ça, c'est cadeau<nbsp>!
msgctxt "Balloon:4512:0:1"
msgid "Come now, don't sulk! Here, I brought you a flower!"
msgstr "Ну не дуйся! Вот, я принёс тебе цветок!"

#. ja: うふふ、やわらか～い！
#. de: Hihi. Dein Fell ist so schön weich!
#. fr: Hi hi hi, c'est si douuuux<nbsp>!
msgctxt "Balloon:4513:0:1"
msgid "You're like a walking cloud!"
msgstr "Ты прямо ходячее облачко!"

#. ja: よく、おもしろいことを<br>思いつくなぁ…
#. de: Mir fällt einfach nichts Lustiges ein ... \<schnief> ...
#. fr: Tu as toujours des idées rigolotes, toi<nbsp>!
msgctxt "Balloon:4514:0:1"
msgid "And they'll never suspect a thing!"
msgstr "И никто ни о чём не догадается!"

#. ja: おおきくな～れ♪
#. de: Groß und größer!
#. fr: Allez hop<nbsp>!♪
msgctxt "Balloon:4515:0:1"
msgid "Hurry up and grow!"
msgstr "Ну же, расти скорей!"

#. ja: なんでもいい、なんかくれ…
#. de: Almosen! Eine kleine Spende! Ich bitte Euch!
#. fr: À manger... À manger... S'il vous plaît...
msgctxt "Balloon:4516:0:1"
msgid "Please, anything you can spare!"
msgstr "Подайте, кто сколько может!"

#. ja: だから、あれほど<br>言ったじゃない！
#. de: Gah, hast du mir überhaupt zugehört? Ich hab's dir doch eben erklärt<nbsp>...
#. fr: Mais tu n'écoutes jamais ce qu'on te dit, aussi<nbsp>!
msgctxt "Balloon:4517:0:1"
msgid "That's what you get for pushing your luck!"
msgstr "Вот зачем было испытывать судьбу!"

#. ja: デカイのきてくれ…！
#. de: Na, komm schon<nbsp>... Beiß endlich an, du dicker Fisch! Ich kann dich sehen!
#. fr: J'espère avoir une belle prise<nbsp>!
msgctxt "Balloon:4518:0:1"
msgid "Nana nana nana nana, fishing!"
msgstr "На-на-на-на, рыбалка!"

#. ja: 凄いの揃えてるよ！
#. de: Töpfe, Karaffen, Gläser! Kommt und kauft!
#. fr: Oyez oyez, venez voir mes belles pièces<nbsp>!
msgctxt "Balloon:4519:0:1"
msgid "A steal at half the price!"
msgstr "Полцены — считай, даром!"

#. ja: 何か掘り出しモンは…
#. de: Bitte, bitte lass einen Schatz unter all dem Schutt liegen<nbsp>...
#. fr: Je suis sûr qu'il y a un trésor par ici<nbsp>!
msgctxt "Balloon:4520:0:1"
msgid "My fortune is just a few scoops of dirt away!"
msgstr "Ещё пара лопат — и разбогатею!"

#. ja: どうしたものか…
#. de: Was soll ich jetzt nur machen<nbsp>...
#. fr: Je me demande bien ce qui s'est passé...
msgctxt "Balloon:4521:0:1"
msgid "As soon as his back's turned, that soup is mine!"
msgstr "Отвернётся — и суп мой!"

#. ja: 乾いたかしら？
#. de: Ist schon alles trocken?
#. fr: Alors... Est-ce que c'est sec...<nbsp>?
msgctxt "Balloon:4522:0:1"
msgid "Next time, I'll set the line a bit lower."
msgstr "В следующий раз поставлю верёвку пониже."

#. ja: 審査、通るかしら…
#. de: Ob sie mit der Prüfung meines Falls wohl inzwischen fertig sind?
#. fr: J'espèrrre que tout va bien se passer...
msgctxt "Balloon:4523:0:1"
msgid "Why must there be so many rules?"
msgstr "И зачем столько правил?"

#. ja: いろんなものがあるのねぇ
#. de: Ganz schön langwierig, das Ganze<nbsp>...
#. fr: Hmmmm...
msgctxt "Balloon:4524:0:1"
msgid "I hope I haven't forgotten anything."
msgstr "Надеюсь, ничего не забыла."

#. ja: ニワトリさん、かわいー！
#. de: Ihr habt sooo weiße Federn, Frau Henne!
#. fr: Oh, une petite poule trrrop mignonne<nbsp>!
msgctxt "Balloon:4525:0:1"
msgid "Why are they eating pebbles?"
msgstr "Почему они едят камешки?"

#. ja: 火加減、強すぎかな？
#. de: Ist das nicht zu viel Hitze?
#. fr: J'espère que le feu n'est pas trop fort<nbsp>!
msgctxt "Balloon:4526:0:1"
msgid "Oh no! It looks like I've burnt it!"
msgstr "О нет! Кажется, я всё сожгла!"

#. ja: いいぞ！<br> やっちまえ！
#. de: Jawoll! Hau ordentlich zu!
#. fr: Allez<nbsp>! Mets-lui sa pâtée<nbsp>!
msgctxt "Balloon:4527:0:1"
msgid "He's gonna eat his face off! I can't wait!"
msgstr "Вот так! Врежь ему как следует!"

#. ja: おっと、ここで渾身の右ィ！
#. de: Oho, der hat 'ne starke Rechte!
#. fr: BIM<nbsp>! Une belle droite<nbsp>!
msgctxt "Balloon:4528:0:1"
msgid "Go for the ribs! Don't let that bastard breathe!"
msgstr "Бей по рёбрам! Не дай этому ублюдку вздохнуть!"

#. ja: いつまで持つかしら…
#. de: Wie lange wollen sie mich denn noch warten lassen<nbsp>...
#. fr: C'est une question de jours avant qu'elle ne s'effondre...
msgctxt "Balloon:4529:0:1"
msgid "One good gust of wind, and the whole thing'll come down."
msgstr "Ещё подует ветерок — и всё рухнет."

#. ja: 焦げてないわよね…
#. de: Verbrennen die Fladen auch nicht?
#. fr: C'est pas brûlé au moins<nbsp>?
msgctxt "Balloon:4530:0:1"
msgid "Maybe it's time to flip them over?"
msgstr "Может, пора их перевернуть?"

#. ja: 見てろよ、いつかオレだって…！
#. de: Wartet nur<nbsp>... Irgendwann blicke <i>ich</i> von oben auf diese Kaschemme hinab!
#. fr: Un jour, cette misère ne sera qu'un souvenir...
msgctxt "Balloon:4531:0:1"
msgid "Take that, you bastard nail! And that!"
msgstr "Получи, проклятый гвоздь! И ещё раз!"

#. ja: た、たすけてぇ～！！
#. de: Hiiilfe! Hört mich irgendjemand?!
#. fr: À l'aide<nbsp>!!!
msgctxt "Balloon:4532:0:1"
msgid "This burgling lark's harder than I thought!"
msgstr "Воровать оказалось сложнее, чем я думал!"

#. ja: き、気持ち悪い…
#. de: Urks<nbsp>... Die letzte Flasche war zu viel.
#. fr: Beuh, je me sens pas bien...
msgctxt "Balloon:4533:0:1"
msgid "If I stay drunk, I'll never get hungover!"
msgstr "Если буду всё время пьяным, похмелья не будет!"

#. ja: いい話を聞いたから教えるわ
#. de: Hab ich vielleicht ein spannendes Gerücht gehört!
#. fr: Si j'entends quelque chose je te tiens au courant<nbsp>!
msgctxt "Balloon:4534:0:1"
msgid "Stick to the plan, and we can't fail!"
msgstr "Придерживайся плана — и всё получится!"

#. ja: 項目が多いな…
#. de: Heute nehmen die Formulare mal wieder gar kein Ende<nbsp>...
#. fr: J'adore la paperasse<nbsp>!!
msgctxt "Balloon:4535:0:1"
msgid "Why must this take so long?"
msgstr "Почему это так долго?"

#. ja: この格好なら大丈夫だよな？
#. de: Seh ich präsentabel genug aus?
#. fr: Je suis trop bien habillé, aujourd'hui<nbsp>!
msgctxt "Balloon:4536:0:1"
msgid "They're sure to be impressed by my posing!"
msgstr "Моими позами они точно впечатлятся!"

#. ja: いやぁ、気持ちいいー！
#. de: Aaah, tut das gut! Endlich wieder richtig sauber!
#. fr: Ahhh, on est bien<nbsp>!
msgctxt "Balloon:4537:0:1"
msgid "Maybe I should draw the curtain..."
msgstr "Может, занавеску задёрнуть?.."

#. ja: ワインでも持ってきてくれる？
#. de: Bring mir doch ein Glas Wein, hm?
#. fr: Tu peux m'apporter un peu de vin<nbsp>?
msgctxt "Balloon:4538:0:1"
msgid "Be a good boy and fetch me some wine, would you?"
msgstr "Будь добр, принеси мне вина, ладно?"

#. ja: かしこまりました、お待ちを…
#. de: Wie Ihr wünscht. Ich eile.
#. fr: Tout de suite<nbsp>!
msgctxt "Balloon:4539:0:1"
msgid "Yes, milady."
msgstr "Да, миледи."

#. ja: 樹根の層見学を、と思ったけど…
#. de: Eigentlich wollte ich mir ja einen Spaziergang durch die Wurzeln gönnen<nbsp>...
#. fr: Je pensais aller explorer un peu Les Racines...
msgctxt "Balloon:4540:0:1"
msgid "I had hoped there would be something in the Buttress to entertain me..."
msgstr "Я надеялся, что в Опорном ярусе найдётся что-нибудь занятное..."

#. ja: 降りてきただけで<br>満足しちゃったわ
#. de: Aber das Treppensteigen hat mir schon gereicht.
#. fr: Mais rien que descendre d'un étage est déjà tellement excitant<nbsp>!
msgctxt "Balloon:4541:0:1"
msgid "...but it seems I was mistaken."
msgstr "...но, похоже, я ошибся."

#. ja: 樹幹の層に帰りましょ
#. de: Ich sollte mich wieder in die Baumkrone zurückziehen.
#. fr: Bon, je me suis assez promenée...
msgctxt "Balloon:4542:0:1"
msgid "Back to the Understory it is."
msgstr "Ну что ж, обратно в Подлесок."

#. ja: ワインをお持ちしました
#. de: Meine Dame, Ihr Wei...
#. fr: Votre vin, Madame.
msgctxt "Balloon:4543:0:1"
msgid "Your wine, milady."
msgstr "Ваше вино, миледи."

#. ja: はぁ、またいつもの気まぐれか…
#. de: \<seufz> Wieder eine ihrer Launen?
#. fr: Roh, mais qu'elle me fatigue...
msgctxt "Balloon:4544:0:1"
msgid "Tsk! That bloody fickle cow!"
msgstr "Тьфу! Опять эта проклятая капризуля!"

#. ja: それでさぁ…
#. de: Hier, der ist gut! Kommt 'ne Viis nach Eulmore<nbsp>...
#. fr: Et puis après ça...
msgctxt "Balloon:4545:0:1"
msgid "\"Where? Up your arse and 'round the corner!“ Ha!"
msgstr "«Куда? Себе в зад, за угол!» Ха!"

#. ja: 特に異常はなさそうだな
#. de: Hier gibt's nichts zu berichten.
#. fr: Tout a l'air en ordre...
msgctxt "Balloon:4546:0:1"
msgid "I wish they'd make these eyeholes a bit bigger."
msgstr "Вот бы прорези для глаз сделали пошире."

#. ja: さてと、何をしようかしら…
#. de: Was stelle ich denn heute Schönes an?
#. fr: Bon, trrrouvons quelque chose à faire, maintenant<nbsp>!
msgctxt "Balloon:4547:0:1"
msgid "Time for a stroll..."
msgstr "Пора прогуляться..."

#. ja: やっぱりパーラーが一番ね！
#. de: Ach, im Salon ist immer was los! Wie wunderbar!
#. fr: Ah, aucun endrrroit ne vaut ce Salon<nbsp>!
msgctxt "Balloon:4548:0:1"
msgid "...to the parlor!"
msgstr "...до салона!"

#. ja: 足を滑らせて<br>落ちるんじゃないぞ
#. de: Und dann hat sie<nbsp>... hahaaa<nbsp>...dann hat sie<nbsp>... \<prust><nbsp>... die ganze Leberpastete<nbsp>... ha, ich kann nicht mehr!
#. fr: Et alors cet abruti a glissé et a descendu tous les escaliers sur le derrière<nbsp>! Haha, hilarant<nbsp>!!
msgctxt "Balloon:4549:0:1"
msgid "And then the wretched pauper split his head open! Hilarious!"
msgstr "А потом этот нищий голову себе раскроил! Умора!"

#. ja: 飲みてぇ時に飲んで何が悪い！
#. de: Bah, wenn ich trinken will, dann trinke ich! So viel ich will!
#. fr: Y a rien de mal à se rincer le gosier de temps en temps<nbsp>!
msgctxt "Balloon:4550:0:1"
msgid "It's my money, and I'll spend it how I please!"
msgstr "Мои деньги — куда хочу, туда и трачу!"

#. ja: 長老ときたら…
#. de: ... Aber das darfst du nie dem Dorfältesten erzählen.
#. fr: Passé la trentaine...
msgctxt "Balloon:4551:0:1"
msgid "But, of courshe─hic!─the eldersh musht never know of thish!"
msgstr "Но старейшинам ни слова, ик!"

#. ja: ウンウン…わかるヨォ
#. de: Keine Sorge. Ich weiß ja, wie er ist.
#. fr: Oui, je l'ai toujours dit<nbsp>!
msgctxt "Balloon:4552:0:1"
msgid "Oh, don't you worry about that, my friend!"
msgstr "Да не волнуйся ты, друг мой!"

#. ja: ウププ…オボロくんったら…
#. de: Hoi hoi, Oboro!
#. fr: Hé hé hé, sacré Oboro<nbsp>!
msgctxt "Balloon:4553:0:1"
msgid "Haha! How very unlike you, Oboro!"
msgstr "Ха-ха! На тебя это совсем не похоже, Оборо!"

#. ja: あらよっと！
#. de: Uuuund ... hopp!
#. fr: Hop là<nbsp>!
msgctxt "Balloon:4554:0:1"
msgid "Hic! Perhapsh I have partaken a bit more than─hic─ushual..."
msgstr "Ик! Кажется, я выпил чуточку больше обычного... ик..."

#. ja: またぐるっと回ろうかしら
#. de: Sollen wir noch eine kleine Runde drehen?
#. fr: Je vais refaire un tour, je crois...
msgctxt "Balloon:4555:0:1"
msgid "I tire of this place. Come."
msgstr "Мне здесь надоело. Идём."

#. ja: お供いたします
#. de: Ganz wie Ihr wünscht.
#. fr: Je vous accompagne<nbsp>!
msgctxt "Balloon:4556:0:1"
msgid "Yes, my lady."
msgstr "Как пожелаете, миледи."

#. ja: なんて下世話だこと…
#. de: Hmpf. Wie vulgär<nbsp>...
#. fr: Quelle vulgarité ces danseurs...
msgctxt "Balloon:4557:0:1"
msgid "How frightfully vulgar!"
msgstr "Какая вульгарность!"

#. ja: 左様でございますね
#. de: Da habt Ihr ganz recht.
#. fr: Vous avez raison, Madame.
msgctxt "Balloon:4558:0:1"
msgid "I quite agree."
msgstr "Совершенно с вами согласен."

#. ja: あら、いつ私がアナタに<br>意見を求めたかしら？
#. de: Nanu? Ich erinnere mich nicht daran, nach deiner Meinung gefragt zu haben.
#. fr: Il ne me semble pas vous avoir demandé votre avis...
msgctxt "Balloon:4559:0:1"
msgid "Silence! When I want your opinion, I will ask for it!"
msgstr "Не припомню, чтобы я спрашивала твоего мнения."

#. ja: し、失礼いたしました！
#. de: V-Verzeiht!
#. fr: T-toutes mes excuses<nbsp>!
msgctxt "Balloon:4560:0:1"
msgid "Yes, my lady!"
msgstr "Д-да, миледи!"

#. ja: エーテライト・プラザに行くわ
#. de: Kehren wir zum Ätherytenplatz zurück.
#. fr: Bon, je vais à la place de l'Éthérite.
msgctxt "Balloon:4561:0:1"
msgid "What I would not give for some stimulating conversation..."
msgstr "Вот бы найти собеседника поинтереснее..."

#. ja: 綺麗な飾り付けよね
#. de: Hach, ist das Dekor nicht hinreißend?
#. fr: Ces décorations sont magnifiques.
msgctxt "Balloon:4562:0:1"
msgid "One day, I shall buy this plaza and decorate in the manner of my choosing."
msgstr "Когда-нибудь я куплю эту площадь и украшу её по своему вкусу."

#. ja: は、はぃ…<br>左様でございますね…
#. de: I-Ist es in der Tat.
#. fr: O-oui... Vous avez raison, Madame.
msgctxt "Balloon:4563:0:1"
msgid "Yes, my lady..."
msgstr "Д-да, миледи..."

#. ja: お飲み物はいかがですか？
#. de: Darf ich Euch ein Getränk anbieten?
#. fr: Désirez-vous quelque chose à boire<nbsp>?
msgctxt "Balloon:4564:0:1"
msgid "Care for a drink, sir?"
msgstr "Не желаете выпить, сударь?"

#. ja: 見たらわかんだろ、あとにして！
#. de: Hast du keine Augen im Kopf? Wir haben noch!
#. fr: Tu vois bien que je suis occupé, non<nbsp>? Plus tard<nbsp>!
msgctxt "Balloon:4565:0:1"
msgid "Can you not see I am busy!?"
msgstr "Не видишь, я занят?!"

#. ja: このお客様も大丈夫そうかな…
#. de: Dieser Gast hat auch noch ein volles Glas<nbsp>...
#. fr: Je me demande si ce client a soif...
msgctxt "Balloon:4566:0:1"
msgid "I can't even give this stuff away..."
msgstr "Да я это пойло даже даром никому не могу всучить..."

#. ja: 飲み物がはけなくて…
#. de: Mein Tablett wird nicht leerer.
#. fr: On n'a pas vendu beaucoup de cocktails ce soir...
msgctxt "Balloon:4567:0:1"
msgid "Why will no one take a drink?"
msgstr "Почему никто не хочет выпить?"

#. ja: 根気強く行かなきゃダメだぞ
#. de: Sei nicht so ungeduldig und bedräng unsere Gäste nicht so sehr.
#. fr: Il faut être patient<nbsp>!
msgctxt "Balloon:4568:0:1"
msgid "Maybe you should be more assertive?"
msgstr "Может, стоит быть понастойчивее?"

#. ja: は、はい…がんばります…
#. de: N-Natürlich. Entschuldigung<nbsp>...
#. fr: O-oui...
msgctxt "Balloon:4569:0:1"
msgid "All right, I'll try."
msgstr "Л-ладно, попробую."

#. ja: もう一周してきますね
#. de: Ich dreh noch mal ne Runde.
#. fr: J'espère qu'on va avoir un peu plus de clients ce soir...
msgctxt "Balloon:4570:0:1"
msgid "Are you sure we haven't got anything better?"
msgstr "Да вы уверены, что у нас нет ничего получше?"

#. ja: 今宵も愉しみましょう！
#. de: Na kommt! Machen wir uns einen feucht<shy>fröhlichen Abend!
#. fr: On va passer une bonne soirée<nbsp>!
msgctxt "Balloon:4571:0:1"
msgid "Marry me, and you shall have everything you could wish for!"
msgstr "Выходи за меня — и получишь всё, о чём мечтала!"

#. ja: 張りが弱くなってきたか？
#. de: Ich glaube, dieser Bogen muss neu aufgespannt werden<nbsp>...
#. fr: Mon fil s'est détendu...
msgctxt "Balloon:4572:0:1"
msgid "It's about time I changed the string."
msgstr "Пора бы уже сменить тетиву."

#. ja: よーし…<br>綺麗にしてやるからな～
#. de: Ruhig, ruhig. Ich mach dich jetzt hübsch und glänzend, hörst du?
#. fr: Tu vas voir mon beau, tes plumes vont briller<nbsp>!
msgctxt "Balloon:4573:0:1"
msgid "Oh my! How did you get so dusty?"
msgstr "Ой, да откуда же ты такой пыльный?"

#. ja: お前は本当に話好きだな…
#. de: Joanric<nbsp>... Du kaust mir echt 'n Horn ab, hol doch mal Luft.
#. fr: Tu aimes vraiment t'écouter parler, toi<nbsp>!
msgctxt "Balloon:4574:0:1"
msgid "All right, you've made your point!"
msgstr "Ладно, я понял!"

#. ja: む、旅人か…
#. de: Oh, <if $gn4>eine Reisende<else>ein Reisender</if>? Ungewöhnlich<nbsp>...
#. fr: Tiens, qu'est-ce que tu fais là, voyage<if $gn4>use<else>ur</if><nbsp>?
msgctxt "Balloon:4575:0:1"
msgid "I'd stick to the path if I were you."
msgstr "Я бы на твоём месте держался дороги."

#. ja: オレも前線で戦いたいよ！
#. de: Bitte, ich will an der Frontlinie kämpfen!
#. fr: Moi aussi je veux me battre en prrremière ligne<nbsp>!
msgctxt "Balloon:4576:0:1"
msgid "But I'm ready for the front line!"
msgstr "Но я готов сражаться на передовой!"

#. ja: ちゃんと足りてるかしら…
#. de: Hmm, ob die Vorräte wohl genügen<nbsp>...
#. fr: J'espèrrre qu'il y en aura assez...
msgctxt "Balloon:4577:0:1"
msgid "This ought to last us a while."
msgstr "Этого нам надолго хватит."

#. ja: 筋肉は…<br>裏切らないッ…
#. de: Gaaah! Muskeln, lasst mich jetzt nicht im Stich!
#. fr: Oulà, j'ai mal partout...
msgctxt "Balloon:4578:0:1"
msgid "I'll work off this beer belly eventually!"
msgstr "Когда-нибудь я избавлюсь от этого пивного живота!"

#. ja: そこを何とか通してくれよ
#. de: Wird schon werden. Irgendwie geht's ja immer.
#. fr: Laisse-moi passer<nbsp>!
msgctxt "Balloon:4579:0:1"
msgid "There'll be no trouble, I swear!"
msgstr "Да пропусти ты меня, ничего не случится!"

#. ja: 不気味な陰が見えた気が…
#. de: D-Da war ein großer, dunkler Schatten im Wasser, ich schwör's!
#. fr: J'ai l'impression d'avoir vu une ombrrre menaçante...
msgctxt "Balloon:4580:0:1"
msgid "There's something down there, I know it!"
msgstr "Там что-то есть, я точно знаю!"

#. ja: この小屋も寿命かな…
#. de: Diese alte Hütte hier hat schon viel gesehen.
#. fr: Cette cabane ne va pas tenir debout encore longtemps...
msgctxt "Balloon:4581:0:1"
msgid "Whoever built this thing must've been in a hurry."
msgstr "Похоже, этой хижине уже недолго осталось..."

#. ja: 巡回完了、異常ありません！
#. de: Rundgang beendet. Nichts außer<shy>ge<shy>wöhn<shy>liches zu berichten!
#. fr: Patrouille terminée, rien à signaler<nbsp>!
msgctxt "Balloon:4582:0:1"
msgid "Nothing to report!"
msgstr "Докладывать не о чем!"

#. ja: 引き続き、よろしく頼む！
#. de: Vielen Dank, Soldat. Wegtreten.
#. fr: Merci<nbsp>! À bientôt<nbsp>!
msgctxt "Balloon:4583:0:1"
msgid "You'd better do one more circuit, just to be sure."
msgstr "На всякий случай обойди ещё раз."

#. ja: あ、脚に疲労が…
#. de: Bitte, ich kann kaum noch aufrecht stehen<nbsp>...
#. fr: Ah, je ne sens plus mes jambes...
msgctxt "Balloon:4584:0:1"
msgid "Yes, yes... I know how to do my job, thanks."
msgstr "Да знаю я, как выполнять свою работу, спасибо."

#. ja: ふふ、いい子ね
#. de: Wer ist ein braves Mädchen? Du bist ein braves Mädchen!
#. fr: Shhh, c'est bien mon beau<nbsp>!
msgctxt "Balloon:4585:0:1"
msgid "Soon, my pretty, soon..."
msgstr "Скоро, красавчик, скоро..."

#. ja: 弓弦も問題無しっと…！
#. de: Wunderbar, die Sehne ist ordentlich straff!
#. fr: Mon arc est en parfait état<nbsp>!
msgctxt "Balloon:4586:0:1"
msgid "I could put one in that smug prick's back from up here. He wouldn't even know what hit him..."
msgstr "Отсюда можно пустить стрелу этому самодовольному ублюдку прямо в спину. Он даже не поймёт, что его настигло..."

#. ja: やっぱり<br>ここの湯は格別さ！
#. de: Die heißen Quellen hier sind das Beste auf der Welt!
#. fr: Ah... On a bien fait de venir se relaxer ici<nbsp>! Leurs sources sont fantastiques<nbsp>!
msgctxt "Balloon:4587:0:1"
msgid "And we even managed to get the best room they have!"
msgstr "И номер нам достался лучший!"

#. ja: そっちの湯加減はどうだ？
#. de: Wie ist das Wasser da unten?
#. fr: Alors, elle est bonne<nbsp>?
msgctxt "Balloon:4588:0:1"
msgid "We should get away like this more often."
msgstr "Надо почаще вот так выбираться."

#. ja: だいぶ翼が傷んでるわね…
#. de: O je<nbsp>... Dein Flügel hat was abbekommen, hm?
#. fr: Oulà, quelle vilaine blessure<nbsp>!
msgctxt "Balloon:4589:0:1"
msgid "What could you have been doing to end up in such a state?"
msgstr "Что же с тобой приключилось?"

#. ja: もっと武器が必要だ！
#. de: Wir brauchen unbedingt mehr Waffen!
#. fr: Il nous faut plus d'armes<nbsp>!
msgctxt "Balloon:4590:0:1"
msgid "Yes, but I hear enormous swords are all the rage!"
msgstr "Да, но я слышал, что огромные мечи сейчас в моде!"

#. ja: 地面まで顔を近づけてッ！
#. de: Bis das Gras die Nasenspitze kitzelt!
#. fr: Et on s'approche plus près du sol<nbsp>!
msgctxt "Balloon:4591:0:1"
msgid "I want to see those noses touch the ground!"
msgstr "Носом к самой земле!"

#. ja: 何が必要なんだい？
#. de: Was wird denn noch benötigt?
#. fr: Qu'est-ce qu'il te faut<nbsp>?
msgctxt "Balloon:4592:0:1"
msgid "If we pull this off, we'll make a killing!"
msgstr "Если провернём это дело, озолотимся!"

#. ja: 特に問題なしっと…
#. de: Alles in Ordnung soweit.
#. fr: Rrrien à signaler<nbsp>!
msgctxt "Balloon:4593:0:1"
msgid "I swear my eyesight's getting worse..."
msgstr "Клянусь, зрение у меня всё хуже..."

#. ja: 警戒を怠るとは何事か！
#. de: Die kleinste Unaufmerksamkeit kann uns alle das Leben kosten, Soldatin!
#. fr: Hé dis donc<nbsp>! On ne relâche pas sa garde<nbsp>!
msgctxt "Balloon:4594:0:1"
msgid "If I see you sleeping on the job again, you'll be on latrine duty until I say you've had enough!"
msgstr "Увижу, что опять спишь на посту, будешь чистить сортиры, пока я не скажу хватит!"

#. ja: こいつは…<br>どこに置けばいいんだ？
#. de: Wo soll ich das denn noch hinstellen<nbsp>...
#. fr: Qu'est-ce que je dois faire de ça<nbsp>?
msgctxt "Balloon:4595:0:1"
msgid "I have a feeling I'm in the wrong place..."
msgstr "Кажется, я попал не туда..."

#. ja: キレイな羽だなぁ
#. de: Was hast du hübsche Federn!
#. fr: Tes ailes sont vraiment belles<nbsp>!
msgctxt "Balloon:4596:0:1"
msgid "These feathers would fetch a gil or two..."
msgstr "Такие перья пару гил стоят..."

#. ja: ハァ、ハァ…
#. de: Aaah ... Aaah ...!
#. fr: Ahhh... Ahhh... Ahhh...
msgctxt "Balloon:4597:0:1"
msgid "\\<pant> \\<pant>"
msgstr "<i>Ха-а... ха-а...</i>"

#. ja: 悪夢のようだ…
#. de: Ein Albtraum, es ist ein Albtraum!
#. fr: C'est un vrai cauchemar...
msgctxt "Balloon:4598:0:1"
msgid "This is madness..."
msgstr "Это безумие..."

#. ja: ど、どうすれば…
#. de: Rette sich, wer kann!
#. fr: Q-que peut-on faire...<nbsp>!?
msgctxt "Balloon:4599:0:1"
msgid "Wh-What do we do...?"
msgstr "Ч-что же нам делать?.."

#. ja: ヒィ…！
#. de: Hiiilfe!
#. fr: Aaaah<nbsp>!
msgctxt "Balloon:4600:0:1"
msgid "Aaah!"
msgstr "А-а-а!"

#. ja: どうもありがとう！
#. de: Vielen Dank!
#. fr: Merci beaucoup<nbsp>!
msgctxt "Balloon:4601:0:1"
msgid "Shall we?"
msgstr "Ну что, пойдём?"

#. ja: ご同行、お願いね
#. de: Ich danke für's Geleit!
#. fr: Tu m'accompagnes, n'est-ce pas<nbsp>?
msgctxt "Balloon:4602:0:1"
msgid "Lead the way."
msgstr "Веди."

#. ja: あちらは円蓋の座と<br>呼ばれておりまして…
#. de: <nbsp>... Und diesen Platz hier nennt man die Rotunde.
#. fr: Là-bas, c'est La Rotonde<nbsp>!
msgctxt "Balloon:4603:0:1"
msgid "And here we have the Rotunda."
msgstr "А это место называется Ротонда."

#. ja: 立派に育てよ～
#. de: Auf dass ihr schön groß und köstlich werdet<nbsp>...
#. fr: Oh qu'elles sont belles mes citrouilles<nbsp>!
msgctxt "Balloon:4604:0:1"
msgid "Watering, watering, all day long! "
msgstr "Поливаю, поливаю — целый день!"

#. ja: 頼まれた作業、終わったよ
#. de: Alles fertig, soweit!
#. fr: J'ai fini ce que tu m'avais demandé<nbsp>!
msgctxt "Balloon:4605:0:1"
msgid "All finished!"
msgstr "Всё готово!"

#. ja: お、ご苦労さま～！
#. de: Wunderbar, vielen Dank!
#. fr: Ah, bon trrravail<nbsp>!
msgctxt "Balloon:4606:0:1"
msgid "Good work."
msgstr "Отличная работа."

#. ja: じゃ、次はこいつを頼むよ
#. de: Da gäbe es noch diese Samen auszustreuen.
#. fr: Tu peux passer à la suite<nbsp>!
msgctxt "Balloon:4607:0:1"
msgid "Here's the next batch."
msgstr "Вот следующая партия."

#. ja: 同じ場所でいいのかい？
#. de: Alles klar. Selbes Beet?
#. fr: Au même endroit<nbsp>?
msgctxt "Balloon:4608:0:1"
msgid "So, I should scatter these in the same place."
msgstr "Значит, рассыпать их там же?"

#. ja: あぁ！<br> よろしくな！
#. de: Genau! Ich dank dir!
#. fr: Oui, merrrci<nbsp>!
msgctxt "Balloon:4609:0:1"
msgid "That's right!"
msgstr "Верно!"

#. ja: なるほど、なるほど…
#. de: Hmm, verstehe<nbsp>...
#. fr: Je vois, je vois<nbsp>!
msgctxt "Balloon:4610:0:1"
msgid "And what comes after that?"
msgstr "А дальше что?"

#. ja: なかなか上出来でしたよ！
#. de: Diesmal sind sie besonders groß und saftig!
#. fr: Ils sont beaux, non<nbsp>?
msgctxt "Balloon:4611:0:1"
msgid "Yes, four apples, seven lemons. How many times must you count them!?"
msgstr "Четыре яблока, семь лимонов. Да сколько можно их пересчитывать?!"

#. ja: うぅ…腰にくるぜ…
#. de: Autsch, mein verfluchter Rücken<nbsp>...
#. fr: Ouh que j'ai mal au dos<nbsp>!
msgctxt "Balloon:4612:0:1"
msgid "My achin' bones..."
msgstr "Ух, спина совсем разболелась..."

#. ja: ここはどうするかな…
#. de: Es bedarf eines neuen Stalls. Doch ist Platz genug?
#. fr: Hmmm...
msgctxt "Balloon:4613:0:1"
msgid "If I stare at those crates long enough, maybe they will move themselves."
msgstr "Если долго смотреть на эти ящики, может, они сами сдвинутся с места."

#. ja: キレイにしましょうね～
#. de: Bis alle Federchen glänzen!
#. fr: Tu vas être tout propre<nbsp>!
msgctxt "Balloon:4614:0:1"
msgid "Marvelous! Splendid!"
msgstr "Чудесно! Просто прекрасно!"

#. ja: 牧場の仕事も大変だな
#. de: Die Amaro-Zucht ist eine ehrhafte Berufung.
#. fr: Fatigant est, le travail à la ferme<nbsp>!
msgctxt "Balloon:4615:0:1"
msgid "I fear this disagrees with my aesthetic sensibilities..."
msgstr "Боюсь, это противоречит моему эстетическому вкусу..."

#. ja: こいつがいいかもな…
#. de: Ah, der hier vielleicht!
#. fr: Il a l'air pas mal, celui-là...
msgctxt "Balloon:4616:0:1"
msgid "This one might do..."
msgstr "Может, вот этот подойдёт..."

#. ja: どうだ…<br>手頃な獲物は見つかったか？
#. de: Und, hast du einen passenden Auftrag für uns gefunden?
#. fr: Alors, t'as trouvé quelque chose d'intéressant<nbsp>?
msgctxt "Balloon:4617:0:1"
msgid "So? Find anything?"
msgstr "Ну что? Нашёл что-нибудь?"

#. ja: あぁ、よさそうなのがあったよ！
#. de: Ich glaube schon! Beute nach genau unseren Vorstellungen!
#. fr: Oui<nbsp>!!
msgctxt "Balloon:4618:0:1"
msgid "I did indeed!"
msgstr "Ещё как!"

#. ja: 報酬と棲息地域は…
#. de: Hmm. Die Belohnung gefällt mir jedenfalls<nbsp>...
#. fr: Hum, la récompense n'en vaut pas la chandelle...
msgctxt "Balloon:4619:0:1"
msgid "And the reward is not bad either!"
msgstr "Да и награда неплохая!"

#. ja: 綺麗な紫色だわね
#. de: Dieses herrliche, satte Lila<nbsp>...
#. fr: Quelle magnifique couleur.
msgctxt "Balloon:4620:0:1"
msgid "Such vibrant colors!"
msgstr "Какие яркие цвета!"

#. ja: あれ、どこにしまったかしら…
#. de: O je, wo habe ich das Buch nur hinsortiert?
#. fr: Tiens, mais où est-elle passée<nbsp>?
msgctxt "Balloon:4621:0:1"
msgid "Where could it have gone?"
msgstr "Куда же это запропастилось?"

#. ja: どこにいれたかねぇ…
#. de: Hier vielleicht?
#. fr: Bon sang, mais qu'est-ce que j'en ai fait<nbsp>!
msgctxt "Balloon:4622:0:1"
msgid "I'm sure it wouldn't sprout legs and walk off by itself."
msgstr "Не могло же оно отрастить ноги и уйти само по себе."

#. ja: このあたりだった気が…
#. de: Ich bilde mir ein, es hier gesehen zu haben.
#. fr: Je suis sûre de l'avoir vue quelque part par là<nbsp>!
msgctxt "Balloon:4623:0:1"
msgid "Perhaps it found its way over here?"
msgstr "Может, оно сюда перебралось?"

#. ja: ここらへんじゃなかったかな
#. de: Hier auch nicht, oder?
#. fr: Ou alors par là<nbsp>?
msgctxt "Balloon:4624:0:1"
msgid "Or perhaps not."
msgstr "А может, и нет."

#. ja: どの箱に入れたっけな…
#. de: Warum sehen denn alle Regale so gleich aus? \<seufz>
#. fr: Raah, je ne me souviens plus<nbsp>!
msgctxt "Balloon:4625:0:1"
msgid "Maybe it's lurking in here?"
msgstr "Может, оно тут притаилось?"

#. ja: こちらは我々が<br>まとめておきますので
#. de: Hier ist alles detailliert aufgelistet<nbsp>...
#. fr: On s'en occupe<nbsp>!
msgctxt "Balloon:4626:0:1"
msgid "I do not see that posing any difficulties."
msgstr "Не думаю, что с этим возникнут трудности."

#. ja: 新たな依頼か、どれどれ…
#. de: So viele neue Aufträge, o je<nbsp>...
#. fr: Alors, voyons voir ce qu'il y a d'écrit sur ce bon de commande...
msgctxt "Balloon:4627:0:1"
msgid "“By the time you read this, I shall surely be...”"
msgstr "«К тому времени, как ты прочтёшь это, я уже наверняка...»"

#. ja: こういうのはどうでしょうか？
#. de: Wie steht es denn um die Setzlinge?
#. fr: Et que pensez-vous de ça<nbsp>?
msgctxt "Balloon:4628:0:1"
msgid "Well, perhaps if you'd brushed your hair away from your eyes, you'd have seen it!"
msgstr "Может, если бы ты убрал волосы с глаз, то заметил бы!"

#. ja: もう少し様子見かしら…
#. de: Na, noch ein Kontrollgang kann nicht schaden, was?
#. fr: Hum, voyons voir...
msgctxt "Balloon:4629:0:1"
msgid "I should take another look, just in case."
msgstr "На всякий случай осмотрю ещё раз."

#. ja: ううむ、思い浮かばぬ…
#. de: Warum fällt mir heute das Denken nur so schwer?
#. fr: Que faire, que faire...
msgctxt "Balloon:4630:0:1"
msgid "But that would mean that cucumbers are fruit..."
msgstr "Но тогда получается, что огурцы — это фрукты..."

#. ja: 新たな発見は何かあった？
#. de: Irgendwelche neuen Erkenntnisse?
#. fr: Tu as découvert quelque chose<nbsp>?
msgctxt "Balloon:4631:0:1"
msgid "We're still waiting for those new ladders to be delivered, I'm afraid."
msgstr "Боюсь, новые лестницы нам всё ещё не привезли."

#. ja: むずかしいなぁ…
#. de: \<murmel> So viele schwierige Wörter<nbsp>...
#. fr: Oh là là, je comprends rien...
msgctxt "Balloon:4632:0:1"
msgid "“...and ripped out his still-beating heart...”"
msgstr "«...и вырвал всё ещё бьющееся сердце...»"

#. ja: いったいどこにあるのかしら…
#. de: Das gibt's doch nicht, wo steckt dieses Buch nur?
#. fr: Mais où est passé ce livre<nbsp>?
msgctxt "Balloon:4633:0:1"
msgid "I can never find what I'm looking for."
msgstr "Вечно не могу найти то, что ищу."

#. ja: もう一度向こうを<br>調べようかしら…
#. de: Vielleicht steht es doch dort hinten<nbsp>...
#. fr: Je vais retourner vérifier de l'autre côté...
msgctxt "Balloon:4634:0:1"
msgid "Something about needles and haystacks springs to mind..."
msgstr "Что-то про иголки и стога сена вспоминается..."

#. ja: こっちの棚には無さそうね…
#. de: In diesem Regal ist es also auch nicht.
#. fr: Il n'a pas l'air d'être là.
msgctxt "Balloon:4635:0:1"
msgid "Would it kill them to organize things a bit better?"
msgstr "Неужели так трудно навести тут порядок?"

#. ja: 魔法を使えば<br>高い書棚の本だって…
#. de: Na, wer sagt's denn! Mit Magie ist selbst das höchste Regal keine Heraus<shy>forde<shy>rung mehr!
#. fr: Un petit tour de magie, et hop<nbsp>! Pas besoin d'échelle<nbsp>!
msgctxt "Balloon:4636:0:1"
msgid "Who needs ladders when you have magic!"
msgstr "Зачем лестницы, если есть магия!"

#. ja: お願いしたものはどうかな？
#. de: Wie steht es um die Sache, um die ich dich vorhin gebeten habe?
#. fr: Alors, comment avance ce petit travail que je vous ai demandé<nbsp>?
msgctxt "Balloon:4637:0:1"
msgid "So, where is it?"
msgstr "Ну и где оно?"

#. ja: 今、とりかかってます～
#. de: Ich bin seit vorhin damit fertig!
#. fr: Je suis surrr le point de m'y mettre<nbsp>!
msgctxt "Balloon:4638:0:1"
msgid "Erm..."
msgstr "Эм..."

#. ja: どれくらいかかりそうかな？
#. de: Wie lange wirst du brauchen, kannst du das einschätzen?
#. fr: Ça va être encore long<nbsp>?
msgctxt "Balloon:4639:0:1"
msgid "I didn't ask for an “erm,” did I?"
msgstr "Я ведь не просил тебя мычать, верно?"

#. ja: もう少しですかね～
#. de: Ein Weilchen bestimmt.
#. fr: Encorrre un peu de patience<nbsp>!
msgctxt "Balloon:4640:0:1"
msgid "It should be ready soon."
msgstr "Скоро будет готово."

#. ja: 例の物は見つかりそうかい？
#. de: Konntest du mehr über die Symptomatik herausfinden?
#. fr: Vous l'avez trouvé<nbsp>?
msgctxt "Balloon:4641:0:1"
msgid "Any idea how soon?"
msgstr "Есть новости? Скоро найдётся?"

#. ja: まだ報告は入ってませんね…
#. de: Leider nicht. Dazu scheint es keinerlei Berichte zu geben.
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment, personne ne l'a vu...
msgctxt "Balloon:4642:0:1"
msgid "I'm afraid not."
msgstr "Боюсь, пока нет."

#. ja: 配分は問題なし、と
#. de: Das Verhältnis scheint schonmal zu stimmen<nbsp>...
#. fr: Le dosage est parfait<nbsp>!
msgctxt "Balloon:4643:0:1"
msgid "Hopefully it won't explode this time..."
msgstr "Надеюсь, на этот раз не взорвётся..."

#. ja: 休め！
#. de: Rührt euch!
#. fr: Repos<nbsp>!
msgctxt "Balloon:4644:0:1"
msgid "Sir, yes, sir!"
msgstr "Так точно, сэр!"

#. ja: もっと深く下げる！
#. de: Das geht tiefer!
#. fr: Plus de nerf, il faut<nbsp>!
msgctxt "Balloon:4645:0:1"
msgid "You call that a squat!?"
msgstr "Это ты называешь приседанием?!"

#. ja: 手入れは行き届いてるかな…
#. de: Die Instandhaltung wird sicher nicht einfach<nbsp>...
#. fr: On a tout reçu.
msgctxt "Balloon:4646:0:1"
msgid "Is everything here yet?"
msgstr "Всё уже привезли?"

#. ja: 困ったことはないかい？
#. de: Irgendwelche Schwie<shy>rig<shy>keiten, bisher?
#. fr: Tout va bien<nbsp>?
msgctxt "Balloon:4647:0:1"
msgid "How goes it?"
msgstr "Как дела?"

#. ja: 今のところ順調です！
#. de: Keine! Bislang läuft alles wie geschmiert.
#. fr: Oui, aucun souci<nbsp>!
msgctxt "Balloon:4648:0:1"
msgid "Well, it could be worse!"
msgstr "Могло быть и хуже!"

#. ja: 何かあれば、すぐ呼んでな
#. de: Gut. Sollte es ein Problem geben, melde dich unverzüglich bei mir.
#. fr: Appelle-moi si tu as un problème<nbsp>!
msgctxt "Balloon:4649:0:1"
msgid "Don't be afraid to ask for help if you need it."
msgstr "Если что понадобится, не стесняйся обращаться за помощью."

#. ja: ありがとうございます！
#. de: Verstanden!
#. fr: D'accorrrd, merci<nbsp>!
msgctxt "Balloon:4650:0:1"
msgid "Understood!"
msgstr "Понял!"

#. ja: 結構重いわね…
#. de: Uff, schwerer als erwartet!
#. fr: Euh, c'est super lourd...
msgctxt "Balloon:4651:0:1"
msgid "Maybe I should lighten the load..."
msgstr "Может, стоит немного облегчить ношу..."

#. ja: ほう…
#. de: Hmm<nbsp>...
#. fr: Hum...
msgctxt "Balloon:4652:0:1"
msgid "I concur."
msgstr "Согласен."

#. ja: ヒィ！<br> あ、足がすくむ…
#. de: Himmel, ist das tief! Mir wird ganz schwindelig<nbsp>...
#. fr: Oh non non non, j'ai trop le vertige pour ça<nbsp>!
msgctxt "Balloon:4653:0:1"
msgid "Well, there goes my lunch..."
msgstr "Ну всё, прощай, мой обед..."

#. ja: そこは譲れないぜ！
#. de: Darüber lässt sich nicht verhandeln!
#. fr: Ah non, ça c'est obligé<nbsp>!
msgctxt "Balloon:4654:0:1"
msgid "Take it or leave it!"
msgstr "Торговаться не буду!"

#. ja: 何が良くないのかしら…
#. de: Sehen wir doch mal, ob es heute allen gut geht.
#. fr: Oh<nbsp>! Mes premiers fruits<nbsp>!
msgctxt "Balloon:4655:0:1"
msgid "I wonder what the problem is..."
msgstr "Интересно, в чём проблема..."

#. ja: さて、観察日記をつけますか
#. de: Auf zum nächsten Kontrollgang!
#. fr: Bon, plus qu'à consigner tout ça<nbsp>!
msgctxt "Balloon:4656:0:1"
msgid "I'd best make a note of this."
msgstr "Надо бы записать."

#. ja: これは順調っと…
#. de: Du siehst prächtig aus, wunderbar<nbsp>...
#. fr: Rien à signaler.
msgctxt "Balloon:4657:0:1"
msgid "Everything seems fine here."
msgstr "Тут, похоже, всё в порядке."

#. ja: この子はまずまずね…
#. de: Ihr müsst noch ein Weilchen reifen.
#. fr: Tout se passe bien, ici.
msgctxt "Balloon:4658:0:1"
msgid "Not great, but acceptable."
msgstr "Ну, сойдёт..."

#. ja: こいつはいらないかい！？
#. de: Was soll das bedeuten, du brauchst diese Lieferung nicht mehr?
#. fr: Je t'apporte une autre caisse<nbsp>!
msgctxt "Balloon:4659:0:1"
msgid "Are you sure you don't need any?"
msgstr "Точно ничего не нужно?"

#. ja: 悪いな、あいにく足りてるよ…<br>って、またあんたか！
#. de: Na, brauch ich eben nicht mehr! Warte<nbsp>... <i>Du</i> schon wieder?!
#. fr: Mais je t'ai déjà dit cent fois qu'on en avait assez<nbsp>!
msgctxt "Balloon:4660:0:1"
msgid "For the last time, no!"
msgstr "В который раз говорю: нет!"

#. ja: そうか、また来るぜ…
#. de: \<seufz>
#. fr: Ah... Bon bah je repasserai alors<nbsp>!
msgctxt "Balloon:4661:0:1"
msgid "Oh... I see."
msgstr "А... Ясно."

#. ja: もう一度、聞いてくるぜ
#. de: Die Kiste hier ist die richtige, oder?
#. fr: J'ai rien compris du tout, moi...
msgctxt "Balloon:4662:0:1"
msgid "I'll try asking again."
msgstr "Попробую спросить ещё раз."

#. ja: 奴の諦めの悪さは<br>一級品だな…
#. de: Dieser Kerl<nbsp>... Nichts als Schwie<shy>rig<shy>keiten hat man mit dem.
#. fr: Qu'est-ce qui est petit et marron<nbsp>?
msgctxt "Balloon:4663:0:1"
msgid "He's persistent, I'll give him that."
msgstr "Упрямства ему не занимать..."

#. ja: ふんっ！<br> うおおおお！！
#. de: Hnnnnnng! \<schnauf>
#. fr: Oula<nbsp>!!!
msgctxt "Balloon:4664:0:1"
msgid "Oh gods, I think I've torn my breeches!"
msgstr "Ох, кажется, я порвал штаны!"

#. ja: お詳しいのですね
#. de: Euer Sachverstand ist wirklich beeindruckend!
#. fr: Vous en savez, des choses<nbsp>!
msgctxt "Balloon:4665:0:1"
msgid "How remarkably informative..."
msgstr "Как много интересного вы знаете..."

#. ja: いい武器じゃねぇか
#. de: Eine wahrlich edle Axt!
#. fr: Très belle, cette hache est<nbsp>!
msgctxt "Balloon:4666:0:1"
msgid "He held an axe in each hand, and another with his tail!"
msgstr "Он держал по топору в каждой руке, а ещё один — хвостом!"

#. ja: さぁさぁ、見てってくんな！
#. de: Tretet näher, schaut euch um!
#. fr: Venez voir mes armures<nbsp>!
msgctxt "Balloon:4667:0:1"
msgid "We have every garment the discerning professional could possibly need!"
msgstr "Подходите, выбирайте! У нас есть одежда на любой вкус для настоящего мастера!"

#. ja: 綺麗なネックレスね…
#. de: Meine Güte, was steht mir diese Halskette gut<nbsp>...
#. fr: Quel magnifique collier<nbsp>!
msgctxt "Balloon:4668:0:1"
msgid "It will make a fine gift."
msgstr "Из него выйдет отличный подарок."

#. ja: これでバッチリだぜ！
#. de: Passt perfekt!
#. fr: C'est parfait<nbsp>!
msgctxt "Balloon:4669:0:1"
msgid "What could possibly go wrong?"
msgstr "Теперь всё как надо! Что может пойти не так?"

#. ja: お客様、お目が高いっ！
#. de: Ihr seid eine wahre Kennerin, wie ich sehe!
#. fr: Vous avez l'œil<nbsp>!
msgctxt "Balloon:4670:0:1"
msgid "You certainly have an eye for quality!"
msgstr "Вы, я вижу, цените качество!"

#. ja: へっぴり腰でどうする！？
#. de: Jetzt stell dich nicht so an!
#. fr: Allez, du nerrrf<nbsp>!
msgctxt "Balloon:4671:0:1"
msgid "Stop whining!"
msgstr "Хватит ныть!"

#. ja: ふふっ、今日も、<br>おねえちゃんに怒られてる
#. de: O je... Sicher schimpft meine große Schwester wieder mit mir, wenn sie mich naschen sieht.
#. fr: Hi hi, encore en trrrain de se faire disputer<nbsp>!
msgctxt "Balloon:4672:0:1"
msgid "I'll show her! I can live on stolen bread!"
msgstr "Вот ещё! Буду питаться краденым хлебом!"

#. ja: 次はどこへいくよ？
#. de: Wo geht's als Nächstes hin?
#. fr: Alors, on bouge<nbsp>?
msgctxt "Balloon:4673:0:1"
msgid "Think of the profits we'll make!"
msgstr "Подумай только, сколько мы заработаем!"

#. ja: 噂で聞いた話だとな…
#. de: Darüber habe ich schon diverse Gerüchte gehört<nbsp>...
#. fr: J'ai entendu une rumeur folle ce matin<nbsp>!
msgctxt "Balloon:4674:0:1"
msgid "So she told him to take a long walk off a short pier!"
msgstr "Слыхал я одну историю... Она и велела ему прогуляться с короткого пирса в длинный путь!"

#. ja: オススメを貰おうかな
#. de: Hm<nbsp>... Was könnt Ihr mir denn empfehlen?
#. fr: Apportez-moi la surprise du chef<nbsp>! Non attendez...
msgctxt "Balloon:4675:0:1"
msgid "I shall leave it to the chef's discretion."
msgstr "Пусть повар сам выберет, что мне подать."

#. ja: 特に問題ありませんよ
#. de: Bei den Destillen keine Probleme!
#. fr: Non, rien à signaler.
msgctxt "Balloon:4676:0:1"
msgid "It all seems in order."
msgstr "Всё в порядке."

#. ja: いつも点検ありがとうねぇ
#. de: Großartig! Danke, dass du die Kontrollen übernimmst.
#. fr: Merci<nbsp>!
msgctxt "Balloon:4677:0:1"
msgid "Thank you for keeping an eye on it!"
msgstr "Спасибо, что присматриваешь!"

#. ja: いいえ、お安い御用です
#. de: Aber nicht doch. Sicherheit geht schließlich vor!
#. fr: Pas de problème<nbsp>!
msgctxt "Balloon:4678:0:1"
msgid "Don't mention it!"
msgstr "Не за что!"

#. ja: 異常はないかなっと…
#. de: Druck, Temperatur<nbsp>... Sieht alles gut aus.
#. fr: On dirait que tout va bien.
msgctxt "Balloon:4679:0:1"
msgid "Hmm... No leaks, no strange noises..."
msgstr "Так... Ничего не течёт, странных звуков нет..."

#. ja: でっけぇ夢を見ようぜ！
#. de: Habt keine Furcht vor großen Träumen, Freunde!
#. fr: Vous manquez d'ambition les gars<nbsp>!
msgctxt "Balloon:4680:0:1"
msgid "What say you? Are you in?"
msgstr "Ну что, кто со мной?"

#. ja: 順調に育ってくれてるわね
#. de: Du willst gar nicht mehr aufhören zu wachsen, wie?
#. fr: Je vais faire les meilleures confitures de tout Norvrandt<nbsp>!
msgctxt "Balloon:4681:0:1"
msgid "It might be easier to shoot them down with my bow."
msgstr "Проще было бы сбить их из лука."

#. ja: オレの部屋についてなんだが…
#. de: Wie steht es denn nun um die Unterkunft für mich?
#. fr: Ma chambre est beaucoup trop petite...
msgctxt "Balloon:4682:0:1"
msgid "Yes, about my room..."
msgstr "Да, насчёт моей комнаты..."

#. ja: 部屋がいっぱいだー！
#. de: Sooo viele Wohnungen<nbsp>...
#. fr: Waouh, c'est immense<nbsp>!
msgctxt "Balloon:4683:0:1"
msgid "I wonder which is the biggest?"
msgstr "Интересно, какая из них самая большая?"

#. ja: お掃除しなくっちゃね
#. de: Ich muss dringend saubermachen<nbsp>...
#. fr: Balayer, nettoyer...
msgctxt "Balloon:4684:0:1"
msgid "Where did all of these crumbs come from?"
msgstr "Откуда тут столько крошек?"

#. ja: 凄い情報を掴んだわよ！
#. de: Das ist wirklich gut zu wissen, vielen Dank!
#. fr: Merci pour<br>ces in<shy>for<shy>ma<shy>tions<nbsp>!
msgctxt "Balloon:4685:0:1"
msgid "I'm telling you! It's true!"
msgstr "Да говорю же, это правда!"

#. ja: 次は何して遊ぶ～？
#. de: Was wollen wir als Nächstes spielen?
#. fr: On joue à cache-cache<nbsp>?
msgctxt "Balloon:4686:0:1"
msgid "I want to be the Exarch this time!"
msgstr "В этот раз я хочу быть Экзархом!"

#. ja: ラリホー！！
#. de: Holladrio!
#. fr: LALI-HO<nbsp>!!!
msgctxt "Balloon:4687:0:1"
msgid "Lali-ho!"
msgstr "Лали-хо!"

#. ja: オートマトンの調子はどう？
#. de: Und, wie läuft der Eisenbart?
#. fr: Tout va bien avec l'automate<nbsp>?
msgctxt "Balloon:4688:0:1"
msgid "How go the repairs?"
msgstr "Ну как ремонт?"

#. ja: どうもなにも、絶好調さっ！
#. de: Wie geschmiert!
#. fr: Aucun problème<nbsp>!
msgctxt "Balloon:4689:0:1"
msgid "It's practically like new!"
msgstr "Да лучше нового!"

#. ja: とりあえず植えてみたが…<br>本当に育つのか？
#. de: Ob sie wohl wirklich wachsen werden<nbsp>...?
#. fr: On a planté tout ça, mais est-ce que ça va vraiment pousser<nbsp>?
msgctxt "Balloon:4690:0:1"
msgid "I wonder if they'll really grow..."
msgstr "Посадили мы их, а вырастут ли они?"

#. ja: 講談を聴いて、来たんだ
#. de: Ich bin so gespannt auf die Geschichte!
#. fr: Je suis venu assister à une pièce de théâtre.
msgctxt "Balloon:4691:0:1"
msgid "Mmmmmm, tastes like samurai..."
msgstr "М-м-м... На вкус прямо как самурай..."

#. ja: お土産にいいわね…
#. de: Hmm, ich sollte ein kleines Mitbringsel besorgen.
#. fr: Ça pourra faire un superbe souvenir<nbsp>!
msgctxt "Balloon:4692:0:1"
msgid "I'll have a dozen."
msgstr "Возьму дюжину."

#. ja: 早く先輩に追いつくぞ！
#. de: Musosai, ich werde deinen Lehren folgen!
#. fr: Il faut vite que je rattrape mon maître<nbsp>!
msgctxt "Balloon:4693:0:1"
msgid "Can't talk─gotta train!"
msgstr "Некогда болтать — надо тренироваться!"

#. ja: 森も私たちを見ているのよ…
#. de: Der Wald beobachtet uns.
#. fr: La forêt nous regarde, tu sais...
msgctxt "Balloon:4694:0:1"
msgid "If you gaze too long into the forest, the forest also gazes into you... "
msgstr "Если долго вглядываться в лес, лес тоже начнёт вглядываться в тебя..."

#. ja: わぁ！<br> たっかーい！
#. de: Hu! Ist das hoch!
#. fr: Waouh<nbsp>!!
msgctxt "Balloon:4695:0:1"
msgid "And for my next trick, a handstand!"
msgstr "А теперь — стойка на руках!"

#. ja: ヒ、ヒトだ、珍しい…
#. de: Flossenlose? Hier?
#. fr: Un<if $gn4>e</if> sssans-branchies, ccc'est plutôt rare par iccci...
msgctxt "Balloon:4696:0:1"
msgid "Finlesss one, eh?"
msgstr "Бесплавниковый, да?"

#. ja: 聞きたい、ことが…
#. de: Ich weiß. Und seine trockene Ausssprache erst<nbsp>... Widerlich, fsssh.
#. fr: J'ai quelque chose à te demander...
msgctxt "Balloon:4697:0:1"
msgid "I have a quessstion..."
msgstr "У меня к тебе вопрос..."

#. ja: そろそろ、狩り、行かぬか？
#. de: Psssh ... Pulssshsss ... Verssspürst du Lust zu jagen?
#. fr: Il est bientôt l'heure d'aller chasser.
msgctxt "Balloon:4698:0:1"
msgid "Are you just going to ssstand there all day!?"
msgstr "Ты так и будешь тут стоять весь день?!"

#. ja: 潮なく、不安だ…
#. de: Psssh ... Ich trockne aus. Kommst du mit schwimmen?
#. fr: Sssans la marée, rien n'est plus pareil...
msgctxt "Balloon:4699:0:1"
msgid "But it is ssso dry!"
msgstr "А без приливов так сушит!"

#. ja: 今回の災厄における<br>学術的見解は…
#. de: Wir sind verloren. Dies sind unsere letzten Tage.
#. fr: Quel est ton point de vue scien<shy>ti<shy>fi<shy>que sur tout ceci<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4700:0:1"
msgid "But when you consider the<br>implications of this latest<br>calamity, you must admit..."
msgstr "Но если задуматься<br>о последствиях этой недавней<br>катастрофы, вы должны признать..."

#. ja: アカデミアの研究結果を<br>待つべきだろう
#. de: Wir müssen Geduld haben, Bruder. Die Magier der Akadaemia werden eine Lösung finden.
#. fr: Je préfère attendre les résultats des recherches de l'Akadaemia Anydre avant de me prononcer.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4701:0:1"
msgid "Trust in the scholars.<br>They will find a solution."
msgstr "Доверьтесь учёным.<br>Они найдут решение."

#. ja: おや、なんと可愛らしい子だ
#. de: Ah, was für ein niedliches Geschöpf du bist.
#. fr: Oh, mais que tu es mignon<if $gn4>ne</if>, toi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4702:0:1"
msgid "What a precocious<br>little child!"
msgstr "Какой смышлёный<br>ребёнок!"

#. ja: 創造理論について<br>ご教授願えますか？
#. de: Bitte, Meister, erklärt mir die Grundprinzipien der Schöpfungsmagie.
#. fr: Pourriez-vous m'enseigner ce que vous savez sur la théorie de la création<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4703:0:1"
msgid "If you could perhaps<br>explain the finer points<br>of the creation process..."
msgstr "Не могли бы вы<br>посвятить меня<br>в тонкости процесса творения..."

#. ja: 君の話は<br>いつも面白いな
#. de: \<kicher> Das hast du gut ausgedrückt.
#. fr: Tu as toujours des choses tellement in<shy>té<shy>res<shy>santes à dire<nbsp>!
msgctxt "Balloon:4704:0:1"
msgid "Yes, yes. Quite right..."
msgstr "Да-да. Всё верно..."

#. ja: これで私たちも<br>アーモロート市民ね
#. de: Wir sind nun Bürger von Amaurot. Hoffen wir, dass wir diese Entscheidung nicht bereuen.
#. fr: Nous voilà citoyens d'Amaurote<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4705:0:1"
msgid "Citizens must be held<br>to a higher standard..."
msgstr "Граждане должны<br>держать планку повыше..."

#. ja: これから<br>重要な議会があるらしい
#. de: Es wurde eine Sitzung einberufen.
#. fr: Je dois me rendre à une réunion très importante.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4706:0:1"
msgid "They've convened an<br>emergency assembly."
msgstr "Созвали экстренное<br>собрание."

#. ja: ふむ、傍聴しようじゃないか
#. de: Wir sollten teilnehmen. Vielleicht hat der Konvent etwas zu verkünden.
#. fr: Tu es déjà en retard, de toute façon...
msgctxt "Balloon:4707:0:1"
msgid "This concerns us all."
msgstr "Это касается всех нас."

#. ja: よし、すぐ向かおう
#. de: Gehen wir.
#. fr: Je me dépêche<nbsp>!
msgctxt "Balloon:4708:0:1"
msgid "Agreed. We must hurry..."
msgstr "Согласен. Надо спешить..."

#. ja: なにか素敵なイデアをご存知？
#. de: Was macht man, wenn das Ende naht?
#. fr: Tu n'aurais pas une idée de concept<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4709:0:1"
msgid "There's an incredible<br>concept I just know<br>you'll adore..."
msgstr "Я знаю одну потрясающую<br>идею. Уверен, тебе<br>она понравится..."

#. ja: 君はもしかして…<br>いや、なんでもない
#. de: Du bist doch nicht etwa<nbsp>... Nein, das kann nicht sein.
#. fr: J'ai l'impression de te connaître...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4710:0:1"
msgid "You... I know...<br>No, never mind."
msgstr "Ты... Я тебя знаю...<br>Нет, неважно."

#. ja: あの研究対象の魅力は…
#. de: Was das Forschungsobjekt so interessant macht, ist<nbsp>...
#. fr: Mes recherches avancent bien<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4711:0:1"
msgid "The subject's potential<br>is far beyond our<br>wildest expectations..."
msgstr "Потенциал этого объекта<br>превзошёл все наши<br>самые смелые ожидания..."

#. ja: さて、この荷箱は…
#. de: Sag mir, wo das hin soll, oder ich lass es gleich fallen.
#. fr: Bon, où est-ce que je vais mettre ça...
msgctxt "Balloon:4712:0:1"
msgid "Where to put this...?"
msgstr "И куда бы это положить?.."

#. ja: 楽しんだぶん<br>キレイにしないとね
#. de: So schön es war, so sauber soll es auch wieder werden!
#. fr: C'est l'heure de faire le ménage<nbsp>!
msgctxt "Balloon:4713:0:1"
msgid "I'm all for people having fun, but can't they learn to pick up after themselves?"
msgstr "Я не против веселья, но неужели нельзя за собой убирать?"

#. ja: いつかの紅蓮祭よりは<br>マシかな…
#. de: Wenigstens ist es nicht so schlimm wie letztes Mal.
#. fr: Encore plus fort que les Feux de la Mort<nbsp>!
msgctxt "Balloon:4714:0:1"
msgid "It's a mess, all right. But it could have been worse."
msgstr "Бардак, конечно. Но могло быть и хуже."

#. ja: お、いいもの拾った！
#. de: Ha! Das behalte ich!
#. fr: Regardez ce que j'ai trouvé<nbsp>!
msgctxt "Balloon:4715:0:1"
msgid "Look what I found!"
msgstr "Смотрите, что я нашёл!"

#. ja: ゲゲルジュさんから<br>借りてる土地だしね…
#. de: Wir haben die Fläche ja nur von Herrn Gegeruju geliehen.
#. fr: Cet endroit appartient au seigneur Gegeruju, en plus...
msgctxt "Balloon:4716:0:1"
msgid "We have to clean up this mess before Master Gegeruju sees it..."
msgstr "Надо прибраться, пока мастер Гегеруджу этого не увидел..."

#. ja: 海賊だって<br>後片付けくらいするさ
#. de: Auch Piraten achten auf Sauberkeit!
#. fr: Les pirates à la rescousse<nbsp>!
msgctxt "Balloon:4717:0:1"
msgid "Even pirates clean up better than this!"
msgstr "Даже пираты убираются лучше вас!"

#. ja: 腰の筋肉が鍛えられるな
#. de: Das ist ein gutes Training für die Rückenmuskulatur!
#. fr: Ça fait travailler les abdos<nbsp>!
msgctxt "Balloon:4718:0:1"
msgid "At least all the squatting I'm doing is good for my thighs..."
msgstr "Ну хоть приседать полезно для бёдер..."

#. ja: キレイな浜辺にこそ…<br>筋肉は輝く
#. de: An einem sauberen Strand kommen meine Muskeln noch besser zur Geltung!
#. fr: C'est bon pour les muscles<nbsp>!
msgctxt "Balloon:4719:0:1"
msgid "My muscles shine even brighter on these sparkling sands!"
msgstr "На этом чистом песочке<br>мои мышцы сияют ещё ярче!"

#. ja: 沖合の漂流物も<br>泳いでとってくるか…
#. de: Da schwimmt doch noch mehr Treibgut im Wasser, oder?
#. fr: Il y a des débris dans la mer aussi...
msgctxt "Balloon:4720:0:1"
msgid "As if it weren't bad enough already, the debris keeps floating in..."
msgstr "Мало того, что тут и так грязно, так мусор ещё и приплывает..."

#. ja: 新生祭のためにも<br>片付けないとね…
#. de: Das muss bis zum Jahrestag der Katastrophe wieder picobello aussehen!
#. fr: La fête de la Commémorrration, il n'y a que ça de vrai<nbsp>!
msgctxt "Balloon:4721:0:1"
msgid "We need to clean up before the Rising! Or wait, has it already started?"
msgstr "Надо прибраться до Восхождения! Или оно уже началось?"

#. ja: 面倒だけど<br>放っておくわけには…
#. de: Ordnung muss sein!
#. fr: C'est fatigant, mais on n'a pas le choix...
msgctxt "Balloon:4722:0:1"
msgid "It's a hassle, all right, but we can't just leave this trash here..."
msgstr "Хлопотно, конечно, но нельзя же бросить весь этот мусор..."

#. ja: ううーん<br>ほかに無いかしら…
#. de: War das schon alles?
#. fr: Voyons voir ce qui reste...
msgctxt "Balloon:4723:0:1"
msgid "Is that the last of it?"
msgstr "Это всё?"

#. ja: えーっと、これの分別は…
#. de: Zählt das als Sperrmüll, oder<nbsp>...?
#. fr: Surtout, ne pas oublier de trier<nbsp>!
msgctxt "Balloon:4724:0:1"
msgid "Where do empty bottles go again...?"
msgstr "Куда сдают пустые бутылки?.."

#. ja: 疲れたから一休みネ
#. de: Graben macht hungrig!
#. fr: Je suis fatigué d'avoir tant creusé, fatigué, oui<nbsp>!
msgctxt "Balloon:4725:0:1"
msgid "All that digging makes me sleepy!"
msgstr "От этой копки так и клонит в сон!"

#. ja: うわあっ！？
#. de: Neeein!
#. fr: Nooon<nbsp>!
msgctxt "Balloon:4726:0:1"
msgid "Mummy!"
msgstr "Мамочка!"

#. ja: 力みすぎるなよ！
#. de: Übertreib nicht!
#. fr: Relâche-toi un peu<nbsp>!
msgctxt "Balloon:4727:0:1"
msgid "Just try to relax a little!"
msgstr "Да расслабься ты немного!"

#. ja: る…るせぇ！！
#. de: Ruhe! Ich brauche keine Ratschläge!
#. fr: Chut<nbsp>! Laisse-moi faire<nbsp>!
msgctxt "Balloon:4728:0:1"
msgid "Sh-Shut up already!"
msgstr "З-заткнись уже!"

#. ja: で、いつになったら跳ぶんだい？
#. de: Und wann genau springst du?
#. fr: Et tu sautes quand, au juste<nbsp>?
msgctxt "Balloon:4729:0:1"
msgid "So, are you going to jump any time soon?"
msgstr "Ну и когда ты наконец прыгнешь?"

#. ja: ボム踊りはあっちの島？
#. de: Findet der Feuertanz auf der Insel dort statt?
#. fr: La danse du bombo, c'est sur l'île, là-bas<nbsp>?
msgctxt "Balloon:4730:0:1"
msgid "Where do I go for the bomb dance?"
msgstr "А где танцуют бомбо-танец?"

#. ja: もう、へとへと…
#. de: Ich<nbsp>... Ich kann nicht mehr<nbsp>...
#. fr: J'en... j'en peux plus...
msgctxt "Balloon:4731:0:1"
msgid "I think I need a rest..."
msgstr "Кажется, мне надо отдохнуть..."

#. ja: あのてっぺんも登れるの！？
#. de: Da ganz oben kann man auch hochklettern?
#. fr: On peut monter tout là-haut<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4732:0:1"
msgid "I don't even want to <i>think</i> about climbing that!"
msgstr "Даже <i>думать</i> не хочу о том, чтобы туда лезть!"

#. ja: どりゃあ！<br>海賊魂ぃぃ！！
#. de: Ich fühle mich wie ein Pirat!
#. fr: Je me sens l'âme d'un pirate<nbsp>!
msgctxt "Balloon:4733:0:1"
msgid "Look at me! I'm a pirate! Yarr!"
msgstr "Смотрите на меня! Я пират! Йо-хо-хо!"

#. ja: 挑戦して落ちるのも悪くない…
#. de: Runterzufallen ist gar nicht so schlimm.
#. fr: C'est pas si mal de tomber...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4734:0:1"
msgid "I suppose it's not <i>too</i> far down..."
msgstr "Пожалуй, падать отсюда не <i>так уж</i> высоко..."

#. ja: どうやって上にいくの！？
#. de: Wie kommt man da hoch?
#. fr: Comment on fait pour aller en haut<nbsp>!?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4735:0:1"
msgid "How am I supposed to get up <i>there</i>!?"
msgstr "И как мне забраться <i>вон туда</i>!?"

#. ja: お、俺なら頂上まで楽勝さ
#. de: Für mich wird es ein Kinderspiel!
#. fr: Ça va être un jeu d'enfant pour moi<nbsp>!
msgctxt "Balloon:4736:0:1"
msgid "Hah! Getting to the top is child's play!"
msgstr "Ха! Да забраться на вершину — раз плюнуть!"

#. ja: あとひと息ぃぃ！
#. de: Gleich geschafft!
#. fr: Encore un petit effort<nbsp>!
msgctxt "Balloon:4737:0:1"
msgid "Phew! Almost there!"
msgstr "Фух! Почти добрался!"

#. ja: ここで攻略者を<br>見届けるのさ！
#. de: Ich beobachte von hier aus die Teilnehmer.
#. fr: Je regarde les par<shy>ti<shy>ci<shy>pants d'ici<nbsp>!
msgctxt "Balloon:4738:0:1"
msgid "I don't have the nerve to try myself, but I do enjoy watching!"
msgstr "Самому духу не хватает попробовать, зато смотреть очень люблю!"

#. ja: ゴール前はハラハラするわ
#. de: Kurz vor dem Ziel krieg ich immer Bammel!
#. fr: Voir l'arrivée me fiche la trouille<nbsp>!
msgctxt "Balloon:4739:0:1"
msgid "They really saved the best for last..."
msgstr "Самое волнительное — прямо перед финишем..."

#. ja: 応援してるから頑張ってね！
#. de: Du schaffst das! Ich glaube an dich.
#. fr: Je suis de tout cœur avec toi<nbsp>!
msgctxt "Balloon:4740:0:1"
msgid "I know you can do it!"
msgstr "Ты справишься, я верю в тебя!"

#. ja: 思いっきり、楽しんでいってね！
#. de: Am wichtigsten ist, dass du Spaß hast!
#. fr: L'important, c'est de s'amuser<nbsp>!
msgctxt "Balloon:4741:0:1"
msgid "What's most important is that you have fun!"
msgstr "Главное — хорошенько повеселиться!"

#. ja: さあさあ！<br>そこの君も挑戦していってよ！
#. de: Du solltest auch mitmachen!
#. fr: Toi aussi, tu ferais mieux d'y participer<nbsp>!
msgctxt "Balloon:4742:0:1"
msgid "What are you waiting for!? Give it a try!"
msgstr "Ну же, чего ждёшь!? Попробуй!"

#. ja: 上からじゃなきゃいけないみたいね
#. de: Man kann wohl nur von dort oben aus starten.
#. fr: On peut y aller que par en haut, on dirait.
msgctxt "Balloon:4743:0:1"
msgid "Only way to get there is from above, it seems."
msgstr "Похоже, попасть туда можно только сверху."

#. ja: みてみて！<br>スライダーがあるよ！
#. de: Schau! Schau! Schau! Es gibt eine Rutsche!
#. fr: Regarde<nbsp>! Il y a un toboggan<nbsp>!
msgctxt "Balloon:4744:0:1"
msgid "Look! It's a slide!"
msgstr "Смотри! Там горка!"

#. ja: えぇぇ～登るの！？<br>むずくない？？
#. de: Da hoch?! Das sieht viel zu schwierig aus!
#. fr: Hein, tu veux grimper là-haut<nbsp>? Ça a l'air difficile, tu trouves pas<nbsp>?
msgctxt "Balloon:4745:0:1"
msgid "You're going to climb up there? That looks so scary!"
msgstr "Ты собираешься туда лезть? Страшно же!"

#. ja: でも素敵な休憩所もあるみたい！
#. de: Oben soll man aber total gut entspannen können.
#. fr: Il y a un endroit sympa pour se relaxer, il paraît<nbsp>!
msgctxt "Balloon:4746:0:1"
msgid "I hear there's a nice place to rest there!"
msgstr "Говорят, там наверху есть отличное место отдохнуть!"

#. ja: 良いハムストリングだ
#. de: Was für schöne Oberschenkel!
#. fr: Quelles belles cuisses<nbsp>!
msgctxt "Balloon:4747:0:1"
msgid "Ooh, look at those muscular thighs!"
msgstr "Ох, какие мускулистые бёдра!"

#. ja: 筋肉歓喜！
#. de: Ich liebe gut definierte Muskeln über alles!
#. fr: J'aime trop les muscles<nbsp>!
msgctxt "Balloon:4748:0:1"
msgid "Muscle-heads? Love 'em!"
msgstr "Мускулистые парни? Обожаю!"

#. ja: さぁ、その筋肉で塔を登れ！
#. de: Benutze sie, um nach oben zu gelangen!
#. fr: Utilise-les pour monter tout en haut<nbsp>!
msgctxt "Balloon:4749:0:1"
msgid "Put those muscles to work and climb to the top!"
msgstr "Пусти эти мышцы в дело и заберись на вершину!"

#. ja: 今度こそリベンジィィ！
#. de: Diesmal werde ich es schaffen!
#. fr: Cette fois-ci, je vais y arriver<nbsp>!
msgctxt "Balloon:4750:0:1"
msgid "I will have my revenge! My vengeance! My re-vengeance!"
msgstr "Я отомщу! Отомщу! О-том-щу!"

#. ja: ちょちょ…揺れるって！
#. de: Uahhh! Es wackelt!
#. fr: Ouaaah<nbsp>!<nbsp>... Ça remue<nbsp>!
msgctxt "Balloon:4751:0:1"
msgid "Hey! Don't rock the boat!"
msgstr "Эй! Не раскачивай лодку!"

#. ja: こ、こんな序盤で！？
#. de: D-Da geht es los!?
#. fr: Dès... dès le début<nbsp>!
msgctxt "Balloon:4752:0:1"
msgid "B-But this is only the beginning!"
msgstr "Н-но это же только начало!"

#. ja: 噂の隠しルートはここからか
#. de: Geht hier die geheime Route los?
#. fr: Le passage caché serait par là<nbsp>?
msgctxt "Balloon:4753:0:1"
msgid "Is this the secret route everyone's talking about?"
msgstr "Это и есть тайный путь, о котором все говорят?"

#. ja: また浮かんでるな、俺…
#. de: Ich werde es schaffen!
#. fr: Je vais y arriver<nbsp>!
msgctxt "Balloon:4754:0:1"
msgid "I'm going to make it this time!"
msgstr "В этот раз у меня всё получится!"

#. ja: ゴボボボボ…
#. de: \<gluck> \<gluck> \<gluck>
#. fr: Glouglouglouglou...
msgctxt "Balloon:4755:0:1"
msgid "Urgh..."
msgstr "Ургх..."

#. ja: あなたも一緒にどう？
#. de: Begleitest du mich?
#. fr: Tu veux pas y aller avec moi<nbsp>?
msgctxt "Balloon:4756:0:1"
msgid "Shall we dance?"
msgstr "Потанцуем?"

#. ja: あーらよっと！
#. de: Allez hopp!
#. fr: Allez<nbsp>! Hop<nbsp>!
msgctxt "Balloon:4757:0:1"
msgid "A-one, and a-two, and a-one, and a-two!"
msgstr "Раз-два, раз-два!"

#. ja: みんなで踊るのたのしー！
#. de: Es ist so schön, zusammen zu tanzen!
#. fr: C'est trop sympa de danser tous ensemble<nbsp>!
msgctxt "Balloon:4758:0:1"
msgid "There's nothing like dancing your worries away!"
msgstr "Нет ничего лучше танцев — все заботы как рукой снимает!"

#. ja: バタードフィッシュあるって！
#. de: Es soll wieder den leckeren Fisch im Teigmantel geben!
#. fr: Il y a du poisson pané<nbsp>!
msgctxt "Balloon:4759:0:1"
msgid "They have the battered fish again this year!"
msgstr "Говорят, в этом году опять будет рыба в кляре!"

#. ja: じゃあ浜辺で食べよっか
#. de: Wollen wir dann am Strand essen?
#. fr: On va manger sur la plage, alors<nbsp>?
msgctxt "Balloon:4760:0:1"
msgid "Ooh! Let's get some and eat it on the beach!"
msgstr "О! Давай купим и съедим на пляже!"

#. ja: 風がよんでる<br>ボコ、ダッシュで跳んでみようか
#. de: Der Wind ruft mich! Er wird mich tragen!
#. fr: Le vent m'appelle<nbsp>! Je vais courir et sauter très haut<nbsp>!
msgctxt "Balloon:4761:0:1"
msgid "The wind calls us. Run as fast as your legs carry you and soar into the air."
msgstr "Ветер зовёт нас. Беги изо всех сил — и взмывай в небо!"

#. ja: 祭りだ、祭りだー！
#. de: Was für ein tolles Fest!
#. fr: Vive les Feux de la Mort<nbsp>!
msgctxt "Balloon:4762:0:1"
msgid "There's no festival fairer than the Moonfire Faire!"
msgstr "Нет праздника прекрасней Огненной Луны!"

#. ja: いけいけ～！
#. de: Los! Ihr schafft das!
#. fr: Allez<nbsp>! Vas-y<nbsp>!
msgctxt "Balloon:4763:0:1"
msgid "I can't wait to write a story about this!"
msgstr "Не терпится написать об этом!"

#. ja: やったね！<br>攻略おめでとう！！
#. de: Herzlichen Glückwunsch! Du hast es geschafft!
#. fr: Bravo<nbsp>! Tu as réussi<nbsp>!
msgctxt "Balloon:4764:0:1"
msgid "You did it! Congratulations!"
msgstr "У тебя получилось! Поздравляю!"

#. ja: あなたすごいわね！
#. de: Du hast es echt drauf!
#. fr: Tu m'épates vraiment, tu sais<nbsp>!
msgctxt "Balloon:4765:0:1"
msgid "You're really something else!"
msgstr "Ну ты даёшь!"

#. ja: あなたのファンになっちゃった！
#. de: Du hast gerade einen neuen Fan gewonnen!
#. fr: Tu es mon idole, désormais<nbsp>!
msgctxt "Balloon:4766:0:1"
msgid "Incredible! You're my hero!"
msgstr "Невероятно! Ты мой герой!"

#. ja: キミ、以前も活躍してたね！<br>攻略おめでとう！
#. de: Das war nicht dein erstes Mal, oder? Wie auch immer, gut gemacht!
#. fr: C'est pas la première fois, n'est-ce pas<nbsp>? En tout cas, bien joué<nbsp>!
msgctxt "Balloon:4767:0:1"
msgid "Hey, haven't I seen you before? Good job, either way!"
msgstr "Эй, я тебя уже где-то видел? В любом случае — отлично справился!"

#. ja: 今回もやってくれると思ってたわ！
#. de: Ich wusste, dass du es schaffst!
#. fr: Je savais que tu y arriverais<nbsp>!
msgctxt "Balloon:4768:0:1"
msgid "I knew you could do it again!"
msgstr "Я знала, что у тебя и в этот раз получится!"

#. ja: 実は前からあなたのファンなの！
#. de: Ich habe dich schon immer bewundert.
#. fr: J'ai toujours eu beaucoup d'admiration pour toi<nbsp>!
msgctxt "Balloon:4769:0:1"
msgid "I've always admired you!"
msgstr "Я всегда тобой восхищалась!"

#. ja: みんながんばれ～！
#. de: Kommt schon, Leute, seid tapfer!
#. fr: Allez, tout le monde, du courage<nbsp>!
msgctxt "Balloon:4770:0:1"
msgid "Go get 'em!"
msgstr "Давайте, покажите им!"

#. ja: ふふふ<br>連れてこられて良かった
#. de: Hierher zu kommen, war die richtige Entscheidung.
#. fr: Héhé<nbsp>! J'ai bien fait de venir ici<nbsp>!
msgctxt "Balloon:4771:0:1"
msgid "I'm so glad I could bring them here. Wait...have they eaten yet?"
msgstr "Как же хорошо, что я смогла привести их сюда. Погоди... Они уже поели?"

#. ja: これが書で読んだ紅蓮祭…<br>まさしく奇祭ではないか！
#. de: Das ist also der berühmte Feuermond-Reigen! Wirklich großartig!
#. fr: Voilà donc les fameux Feux de la Mort<nbsp>! C'est vraiment génial<nbsp>!
msgctxt "Balloon:4772:0:1"
msgid "So this is the festival I read about... A truly magical occasion, indeed!"
msgstr "Так вот он какой, праздник, о котором я читал... И правда, поистине волшебное зрелище!"

#. ja: うぺぺぺぺ…<br>船酔いしたっぺよ…
#. de: Urks<nbsp>... Ich glaube<nbsp>... ich bin seekrank<nbsp>...
#. fr: Euuurgh... J'ai... le mal... de mer...
msgctxt "Balloon:4773:0:1"
msgid "How I hate ships... I think I'm going to be─urk!"
msgstr "Как же я не люблю корабли... Кажется, меня сейчас вывернет..."

#. ja: 耐熱装備、素敵っぺな！<br>作ってみたいっぺよ！
#. de: Die Ausrüstung gegen die Hitze ist klasse! Die will ich auch herstellen.
#. fr: L'équipement anti-chaleur a vraiment la classe<nbsp>! J'aimerais bien en fabriquer, moi aussi<nbsp>!
msgctxt "Balloon:4774:0:1"
msgid "Heat-resistant garb? Well, well, I would like to try making that!"
msgstr "Одежда для защиты от жары? Надо же! Хотелось бы попробовать такую сшить!"

#. ja: 騒がしい女が近くにいると<br>魚が逃げてしまいますね
#. de: All diese lauten Mädchen verjagen meine Fische.
#. fr: Toutes ces filles excitées font fuir mes poissons.
msgctxt "Balloon:4775:0:1"
msgid "I do wish those ladies would be quiet. They're scaring all the fish away."
msgstr "Вот бы эти дамы помолчали. Они распугали всю рыбу."

#. ja: チッ、カルヴァランの野郎！<br>先に釣りあげてやるっ！
#. de: Carvallain hat den Fisch gefangen, den ich fangen wollte!
#. fr: Carvallain a attrapé le poisson que je voulais pêcher<nbsp>!
msgctxt "Balloon:4776:0:1"
msgid "This bleedin' lout keeps catchin' my godsdamned fish before I can!"
msgstr "Чёртов грубиян опять ловит эту треклятую рыбу раньше меня!"

#. ja: フ……ハハハハハハハ！<br>我にかかれば頂上など容易いぞ！
#. de: Hahahahaha! Mit mir kommt man ganz leicht nach oben!
#. fr: Hahaha<nbsp>! Avec moi, c'est très facile d'arriver tout en haut<nbsp>!
msgctxt "Balloon:4777:0:1"
msgid "Hah! As easy as baking pineapple pie, I say!"
msgstr "Ха! Для меня забраться наверх — проще простого!"

#. ja: ううっ、店長の水着姿が見たい…<br>ここはおそろいの水着を勧めて…
#. de: Ich will sie auch in einem Badeanzug sehen<nbsp>... Vielleicht kaufe ich einen identischen<nbsp>...
#. fr: J'ai trop envie de la voir en maillot de bain... Je vais peut-être en acheter un identique...
msgctxt "Balloon:4778:0:1"
msgid "Does this mean I'll be able to see the chief in a bathing suit!?"
msgstr "Неужели мне удастся увидеть начальницу в купальнике!?"

#. ja: サッサカサー！
#. de: Nichts darf liegen bleiben ♪<br>Oder wir sein' Zorn erleiden ♪
#. fr: Fschuiii<nbsp>!
msgctxt "Balloon:4779:0:1"
msgid "Swish-swish-aroo!"
msgstr "Шух-шух-ару!"

#. ja: 急げや急げ<br>サッサカサー！
#. de: Wisch, wisch schnell ♪<br>Den Boden strahlend hell ♪
#. fr: Vite, vite<nbsp>! Fschuiii<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4780:0:1"
msgid "Naps dna kcips.<br>Swish-swish-aroo!"
msgstr "Поспешим, поспешим,<br>Шух-шух-ару!"

#. ja: 綺麗にするぞ<br>サッサカサー！
#. de: Firlefanz und Feenhaar ♪<br>Fege ich auf Tag und Jahr ♪
#. fr: Nettoyage immédiat<nbsp>! Fschuiii<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4781:0:1"
msgid "Eb nac naelc sa nealc!<br>Swish-swish-aroo!"
msgstr "Чистоту наведём,<br>Шух-шух-ару!"

#. ja: 塵も残さず<br>サッサカサー！
#. de: Es soll blinken, blitzen ♪<br>Drum feg ich Spalt und Ritzen.
#. fr: La poussière ne passera pas<nbsp>! Fschuiii<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4782:0:1"
msgid "Mottob ot pot morf!<br>Swish-swish-aroo!"
msgstr "Ни пылинки не оставим,<br>Шух-шух-ару!"

#. ja: 隅から隅まで<br>サッサカサー！
#. de: Von einer Wand zur anderen ♪<br>Soll'n die Borsten wanderen ♪
#. fr: Jusque dans les moindres recoins<nbsp>! Fschuiii<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4783:0:1"
msgid "Yaws dna peews!<br>Swish-swish-aroo!"
msgstr "В каждый угол заглянем,<br>Шух-шух-ару!"

#. ja: 汚れは嫌い<br>サッサカサー！
#. de: Abstoßend, gar widerlich ♪<br>Ist, was ich nicht sauber krieg.
#. fr: La saleté, c'est moche<nbsp>! Fschuiii<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4784:0:1"
msgid "Degrup eb tsum sniats!<br>Swish-swish-aroo!"
msgstr "Грязь терпеть невмочь,<br>Шух-шух-ару!"

#. ja: 綺麗は大好き<br>サッサカサー！
#. de: Ich fege tagelang ♪<br>Bis man sich spiegeln kann ♪
#. fr: La propreté, c'est beau<nbsp>! Fschuiii<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4785:0:1"
msgid "Naelc ot evil I!<br>Swish-swish-aroo!"
msgstr "Чистоту люблю я,<br>Шух-шух-ару!"

#. ja: お掃除するぞ<br>サッサカサー！
#. de: Krümel, Stoppel, Mist ♪<br>Das alles bald gewesen ist ♪
#. fr: Le ménage, c'est la vie<nbsp>! Fschuiii<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4786:0:1"
msgid "Burcs, burcs, burcs!<br>Swish-swish-aroo!"
msgstr "Трём, трём, трём!<br>Шух-шух-ару!"

#. ja: このまま回復すれば…
#. de: Ich hoffe, alles wird gut.
#. fr: Tu imagines, si on réussit à s'en remettre<nbsp>?
msgctxt "Balloon:4787:0:1"
msgid "There, there, lad. You're going to be all right."
msgstr "Ну-ну, парень. Всё будет хорошо."

#. ja: 復興計画には<br>常に目を通しておけよ！
#. de: Behalte das Schwarze Brett im Auge und informiere mich über alle Änderungen.
#. fr: Assure-toi d'être toujours à la page sur les dernières avancées du projet de recon<shy>struc<shy>tion<nbsp>!
msgctxt "Balloon:4788:0:1"
msgid "Know the reconstruction plan like the back of your hand!"
msgstr "Знай план восстановления как свои пять пальцев!"

#. ja: こっちですよぅ…！
#. de: Nein, die müssen hier oben hin, Junge!
#. fr: Regardez-moi ce bon à rien... Derrière toi<nbsp>!
msgctxt "Balloon:4789:0:1"
msgid "No! Up here!"
msgstr "Нет! Сюда наверх!"

#. ja: 副棟梁～<br>資材はここですよねぇ～？
#. de: Die Materialien müssen hierhin, oder?
#. fr: Chef<nbsp>! Où je dois poser tout ça<nbsp>?
msgctxt "Balloon:4790:0:1"
msgid "This is where it goes, right, miss?"
msgstr "Сюда положить, верно, госпожа?"

#. ja: 事件屋に聞いた街はここか<br>描きがいがありそうだ
#. de: Dies ist also das berühmte Viertel, von dem Briardien sprach. Die perfekte Szenerie für mein Bild!
#. fr: Briardien avait raison. Une fois reconstruit, ce quartier fera un sujet parfait pour ma prochaine toile.
msgctxt "Balloon:4791:0:1"
msgid "The inspector was right. This scenery shall make a fine subject for my masterpiece."
msgstr "Инспектор был прав. Этот пейзаж станет прекрасным сюжетом для моего шедевра."

#. ja: こ、このシチューの味は…<br>独特だな…
#. de: Dieses Gulasch ist wirklich hervorragend!
#. fr: Ce ragoût est... comment dire... goûteux<nbsp>!
msgctxt "Balloon:4792:0:1"
msgid "This stew certainly tastes...interesting."
msgstr "Этот суп на вкус... весьма своеобразный."

#. ja: こっちです…！<br>曲がって階段を上がって…！
#. de: Viel Muskeln, wenig Hirn, was? Hier oben, du Genie.
#. fr: Non mais quel idiot... Je t'ai dit en haut des escaliers<nbsp>!
msgctxt "Balloon:4793:0:1"
msgid "No! Up the stairs, I said!"
msgstr "Нет! Я же сказал: вверх по лестнице!"

#. ja: 副棟梁～！<br>このまま、まっすぐですか！？
#. de: Chef, geradezu oder was?
#. fr: Chef<nbsp>! C'est bien par ici<nbsp>?
msgctxt "Balloon:4794:0:1"
msgid "Straight ahead, right, miss?"
msgstr "Бригадир, прямо идти, верно?"

#. ja: お前たち、頑張ったな！<br>次の作業までよく休め！
#. de: Ihr habt hervorragende Arbeit geleistet! Ruht euch nun ein wenig aus.
#. fr: Vous avez bien bossé<nbsp>! Maintenant, repos jusqu'à nouvel ordre.
msgctxt "Balloon:4795:0:1"
msgid "We worked hard! Now we rest hard!"
msgstr "Мы хорошо потрудились! Теперь будем хорошо отдыхать!"

#. ja: もっと内側に寄れ！<br>落っこっちまうぞ！
#. de: Lauf weiter innen, sonst brichst du dir noch das Genick!
#. fr: Ne va pas tomber et te casser une jambe<nbsp>!
msgctxt "Balloon:4796:0:1"
msgid "Watch your step or you'll break your neck!"
msgstr "Держись ближе к середине, а то шею свернёшь!"

#. ja: あ、あの子…<br>どこ行っちゃったのかしら…
#. de: Wo ist der Junge schon wieder hin?
#. fr: Où est-il encore passé, bon sang...<nbsp>?
msgctxt "Balloon:4797:0:1"
msgid "Where in the world did he go?"
msgstr "Куда же он подевался?"

#. ja: あれ～？<br>ここどこだ～？
#. de: Huh? Wo bin ich hier gelandet?
#. fr: Hein<nbsp>!? Comment je me suis retrouvé ici, moi<nbsp>?
msgctxt "Balloon:4798:0:1"
msgid "Where in the world am I?"
msgstr "Где это я?"

#. ja: お腹すいたぁ～<br>シチュー美味しそう～
#. de: Ich hab ja so einen Kohldampf! Das Gulasch duftet wunderbar.
#. fr: J'ai une de ces dalles<nbsp>! Je mangerais bien un peu de ragoût...
msgctxt "Balloon:4799:0:1"
msgid "Mmmmmm, stew..."
msgstr "М-м-м... Рагу..."

#. ja: いずれ戻ってくるだろ！<br>そんなオロオロするなって！
#. de: Kein Grund zur Panik. Der wird sicher bald wieder auftauchen.
#. fr: Pas la peine de te mettre dans un état pareil, il finira bien par revenir...
msgctxt "Balloon:4800:0:1"
msgid "Relax, he'll find his way back."
msgstr "Не волнуйся, он сам дорогу найдёт."

#. ja: 新入りさんが<br>いなくなっちゃったんですぅ～！
#. de: Polier! Der Junge ist verschwunden. Ich mache mir große Sorgen.
#. fr: Monsieur, c'est terrible<nbsp>! Le petit nouveau a disparu<nbsp>!
msgctxt "Balloon:4801:0:1"
msgid "Sir, one of the workers has disappeared!"
msgstr "Сэр, один из рабочих пропал!"

#. ja: 一瞬の気の緩みが<br>重大な事故につながるんだ！
#. de: Ein kleiner Fehler kann eine Katastrophe auslösen!
#. fr: Il faut toujours rester concentré sur un chantier<nbsp>! Un seul moment d'inattention, et c'est le drame...
msgctxt "Balloon:4802:0:1"
msgid "Stay sharp! The briefest lapse in concentration can have lasting consequences!"
msgstr "Будьте начеку! Малейшая оплошность может привести к серьёзным последствиям!"

#. ja: よ、よかったわ<br>無事に見つかって…！
#. de: Puh. Nochmal Glück gehabt! Bist du unversehrt?
#. fr: Ouf, je suis soulagée qu'il ne te soit rien arrivé...
msgctxt "Balloon:4803:0:1"
msgid "I've been searching high and low for you!"
msgstr "Я тебя уже где только не искала!"

#. ja: 道に迷っちゃって～！<br>副棟梁、すいません～！
#. de: Ich hab mich verlaufen, Chef! Tut mir wirklich leid<nbsp>...
#. fr: Chef, je suis vraiment désolé<nbsp>! Je m'étais perdu...
msgctxt "Balloon:4804:0:1"
msgid "Sorry, miss... I got a little spun around..."
msgstr "Простите, госпожа... Я немного заблудился..."

#. ja: 復興共同作業が<br>そろそろ開始するらしい
#. de: Die Arbeiten für den Wieder<shy>aufbau sollen jeden Moment beginnen<nbsp>...
#. fr: Je crois que le prochain ouvrage collectif est sur le point de commencer.
msgctxt "Balloon:4805:0:1"
msgid "Concerted works starting soon."
msgstr "Скоро начнутся совместные работы по восстановлению."

#. ja: 俺たちの<br>腕の見せどころだな！
#. de: Eine gute Gelegenheit zu beweisen, was in uns steckt!
#. fr: C'est le moment de montrer de quel bois on se chauffe<nbsp>!
msgctxt "Balloon:4806:0:1"
msgid "Let's show 'em what we can do."
msgstr "Покажем-ка им, на что мы способны!"

#. ja: 復興共同作業だ！<br>いくぜ！
#. de: Der Wieder<shy>aufbau hat begonnen! Hurra!
#. fr: En avant, pour Halone<nbsp>!
msgctxt "Balloon:4807:0:1"
msgid "This is it! Let's make it count!"
msgstr "Вот и наш час! Сделаем всё как надо!"

#. ja: おーー！
#. de: Oooh!
#. fr: Pour Halone<nbsp>!
msgctxt "Balloon:4808:0:1"
msgid "Yah!"
msgstr "А-а-а!"

#. ja: うわわっ、高いなー…
#. de: Boah, ist das hoch!
#. fr: Wouah... On voit super loin d'ici.
msgctxt "Balloon:4810:0:1"
msgid "I've never climbed so high!"
msgstr "Никогда ещё так высоко не забирался!"

#. ja: やれやれ…<br>どうしたものか…
#. de: Wie ... Wie haben sie das nur geschafft?
#. fr: Mais... qu'est-ce qui s'est passé<nbsp>?
msgctxt "Balloon:4811:0:1"
msgid "Hmph. Well fought."
msgstr "Хм. Ну и битва была."

#. ja: 空を飛んだらどう？
#. de: Warte ab, bis du erstmal fliegst! \<kicher>
#. fr: Essaie de voler<nbsp>! C'est encore plus im<shy>pres<shy>sion<shy>nant de là-haut<nbsp>!
msgctxt "Balloon:4812:0:1"
msgid "Why climb, when you can fly? Just think happy thoughts!"
msgstr "А зачем карабкаться, если можно летать? Только представь!"

#. ja: お花カワイイでしょ？
#. de: Diese Blumen sind wunderschön, findest du nicht auch?
#. fr: Ah ah<nbsp>! Regarde comme elles sont jolies<nbsp>!
msgctxt "Balloon:4813:0:1"
msgid "Pretty, aren't they?"
msgstr "Красивые, правда?"

#. ja: くぴー…くぴぴー…
#. de: Sooo<nbsp>... weich<nbsp>... \<murmel>
#. fr: Zzz... Zzz... Zzz...
msgctxt "Balloon:4814:0:1"
msgid "Zzzzzz..."
msgstr "Хр-р-р..."

#. ja: しーっ…<br>膝の上で寝ちゃったの！
#. de: Schhh<nbsp>... Leise! Sie ist gerade auf meinem Schoß eingeschlafen<nbsp>...
#. fr: (Fais pas de bruit<nbsp>! Elle dort<nbsp>!)
msgctxt "Balloon:4815:0:1"
msgid "(Don't make a sound! They've fallen asleep!)"
msgstr "Тс-с-с! Не шумите, они уснули!"

#. ja: こっちおいで！<br>へーき、へーき！
#. de: Ach, überhaupt nicht! Hier ist alles samtweich<nbsp>... \<kicher>
#. fr: Mais non<nbsp>! Tu peux pas te faire mal ici<nbsp>! Allez, saute<nbsp>!
msgctxt "Balloon:4816:0:1"
msgid "Come on, you can do it!"
msgstr "Давай, у тебя получится!"

#. ja: お、落ちたら痛いかな？
#. de: Ob das weh tut, wenn ich runterfalle?
#. fr: J-j'vais me faire mal si je me rate...
msgctxt "Balloon:4817:0:1"
msgid "I-I'm not sure about this..."
msgstr "Я... не уверен, что стоит..."

#. ja: もっともっと花を創るんだ～
#. de: Blumen! Noch mehr Blumen braucht die Welt!
#. fr: Ça manque de fleurs par ici<nbsp>!
msgctxt "Balloon:4818:0:1"
msgid "Flowers! We need more flowers!"
msgstr "Цветов! Нам нужно больше цветов!"

#. ja: そぉれ！
#. de: Uuund zack!
#. fr: Hop là<nbsp>!
msgctxt "Balloon:4819:0:1"
msgid "Bloom for me, my lovelies!"
msgstr "Расцветайте, мои милые!"

#. ja: よし！<br>次はどこ行こうかな～
#. de: Sehr gut. Alles bunt<nbsp>- so wie es mir gefällt! \<kicher>
#. fr: Hé hé, c'est mieux<nbsp>! Allons voir plus loin<nbsp>!
msgctxt "Balloon:4820:0:1"
msgid "Hehe, that's better! And on we go!"
msgstr "Хе-хе, вот так лучше! А теперь дальше!"

#. ja: うひょー！<br>すげー場所！
#. de: Woooah!<nbsp>... Ich glaub, ich träume!<br>Das ist ja unglaublich!
#. fr: Il est dingue cet endroit<nbsp>!
msgctxt "Balloon:4821:0:1"
msgid "Whoa! What is this place!?"
msgstr "Ничего себе! Что это за место?!"

#. ja: あそぼ、あそぼ♪<br>ねぇ、早くー！
#. de: Komm schon, lass uns spielen!
#. fr: Allez<nbsp>! Range ton bouquin et viens jouer avec nous<nbsp>!
msgctxt "Balloon:4822:0:1"
msgid "Put that book away and come play!"
msgstr "Отложи книгу и иди играть!"

#. ja: う、うん…
#. de: Nur noch eine Seite<nbsp>...
#. fr: J-je finis ce chapitre, d'abord.
msgctxt "Balloon:4823:0:1"
msgid "Let me finish this page, all right?"
msgstr "Дай мне сначала дочитать страницу, ладно?"

#. ja: 頑張ってる子を見ると<br>イタズラしたくなっちゃうわ♪
#. de: Wenn ich Kinder sehe, die sich müh'n,<br>will ich sofort Streiche spiel'n! ♪\<kicher>
#. fr: On devrait lui donner un coup de main en la poussant, hi hi hi.♪
msgctxt "Balloon:4824:0:1"
msgid "Perhaps we can give her a little push, tee hee!"
msgstr "Может, чуть-чуть ей поможем... хи-хи!"

#. ja: わあ…わあ…虹！<br>お母さんにも見せたいな！
#. de: Woah! Seht ihr den Regenbogen?<br>Wenn den Mama sehen könnte!
#. fr: Vous avez vu comment il est beau cet arrrc-en-ciel<nbsp>!?
msgctxt "Balloon:4825:0:1"
msgid "A rainbow! It's so beautiful!"
msgstr "Радуга! Какая красивая!"

#. ja: おっきいねぇ！
#. de: Der ist ja echt riesig!
#. fr: J'en ai jamais vu d'aussi grrros<nbsp>!
msgctxt "Balloon:4826:0:1"
msgid "I wish Mummy could see this too!"
msgstr "Хочу, чтобы мама тоже это увидела!"

#. ja: 虹の上歩けないかな？
#. de: Wo der wohl hinführt, wenn man bis an sein Ende geht?
#. fr: Vous crrroyez qu'on pourrait marcher dessus...<nbsp>?
msgctxt "Balloon:4827:0:1"
msgid "Do you think we can walk on it?"
msgstr "Как думаешь, по ней можно пройтись?"

#. ja: 食べていいのかな…？
#. de: Ob man mal kosten darf?
#. fr: Vous croyez qu'on peut croquer un bout de la table<nbsp>?
msgctxt "Balloon:4828:0:1"
msgid "You suppose it's all right to have a bite...?"
msgstr "Интересно, можно откусить кусочек?.."

#. ja: クリスタリウムにもほしいな！
#. de: Ich wünschte, so was gäbe es in Crystarium. \<träum>
#. fr: Je veux les mêmes à Cristarium<nbsp>!
msgctxt "Balloon:4829:0:1"
msgid "I want this in the Crystarium!"
msgstr "Хочу, чтобы и в Кристариуме такое было!"

#. ja: …この子…カワイイ…
#. de: Der ist ja niedlich<nbsp>...
#. fr: Haaaan<nbsp>! Il est troooop mignoooon<nbsp>!
msgctxt "Balloon:4830:0:1"
msgid "Ahhh! He's adorable!"
msgstr "Ах, какой он милый!"

#. ja: わぁ、ぜんぶ<br>お菓子でできてる！
#. de: Unglaublich! Das ist ja alles aus Zucker!
#. fr: Gloups... Tout est fait en pâtisserrries<nbsp>!
msgctxt "Balloon:4831:0:1"
msgid "Amazing! It's all made from sweets!"
msgstr "Ух ты! Тут всё из сладостей!"

#. ja: やるなら外でね！<br>夢を乱すとティルが怒るよぉ
#. de: Stell besser keinen Unfug an,<br>sonst zieht dir Tyr Beq die Ohren lang<nbsp>... \<kicher>
#. fr: Hé<nbsp>! Tyr a dit pas touche<nbsp>! Dehors tu peux, mais pas dans le Lyhe Mheg<nbsp>!
msgctxt "Balloon:4832:0:1"
msgid "Oh, don't even think about it! You'll make Tyr Beq mad!"
msgstr "Даже не думай! Тир Бек рассердится!"

#. ja: 草人にして飾りたいなぁ…
#. de: Ich finde, hier fehlen ein paar Grasgrummel! \<kicher>
#. fr: Ahhh... Ils seraient mille fois plus mignons en enfeuillés...
msgctxt "Balloon:4833:0:1"
msgid "Do you know what this place is missing? Leafmen!"
msgstr "Знаешь, чего здесь не хватает? Листолюдов!"

#. ja: ゴゴゴゴ…
#. de: \<ratter> \<ratter>
#. fr: CLANK... CLONK...
msgctxt "Balloon:4834:0:1"
msgid "\\<rumble> \\<rumble>"
msgstr "<i>Гр-р-р... Гр-р-р...</i>"

#. ja: ズズズズ…
#. de: \<zisch> \<zisch>
#. fr: CLONK... CLANK...
msgctxt "Balloon:4835:0:1"
msgid "\\<rumble> \\<rumble>"
msgstr "<i>Гр-р-р... Гр-р-р...</i>"

#. ja: ふむ、これはなかなか…
#. de: Also, das ist ja wirklich<nbsp>...
#. fr: Hmm, très intéressant...
msgctxt "Balloon:4836:0:1"
msgid "Finally, a palatable dish."
msgstr "Наконец-то блюдо, которое можно есть."

#. ja: おぉ、美味なり…
#. de: Wirklich delikat!
#. fr: C'est délicieux...
msgctxt "Balloon:4837:0:1"
msgid "Oh my! This is delicious!"
msgstr "Ох, как вкусно!"

#. ja: 絶品だな…
#. de: Was für ein Genuss!
#. fr: Quel chef-d'œuvre...
msgctxt "Balloon:4838:0:1"
msgid "This is absolutely divine."
msgstr "Просто божественно..."

#. ja: 素敵な晩餐ね…
#. de: Das Bankett ist hervorragend gelungen.
#. fr: Voilà un banquet dont je me souviendrai...
msgctxt "Balloon:4839:0:1"
msgid "What a lovely meal."
msgstr "Какой чудесный ужин."

#. ja: さすがは王宮付きの<br>シェフね…
#. de: Der Küchenchef muss ein feines Zünglein haben.
#. fr: Le chef est un véritable génie...
msgctxt "Balloon:4840:0:1"
msgid "My compliments to the chef."
msgstr "Передайте шеф-повару моё восхищение."

#. ja: トルスウィル王に<br>感謝を…
#. de: Das haben wir alles König Tolthewils Großzügigkeit zu verdanken.
#. fr: Un grand merci au roi Tolthewil...
msgctxt "Balloon:4841:0:1"
msgid "To Lord Tolthewil! Long may he reign!"
msgstr "За короля Толтевиля! Да правит он вечно!"

#. ja: いらっしゃいませ…
#. de: Ich heiße Euch willkommen.
#. fr: Bienvenue...
#. macro: <if $gn4>madam<else>good sir</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "Balloon:4842:0:1"
msgid "Be welcome, <if $gn4>madam<else>good sir</if>."
msgstr "Добро пожаловать, <if $gn4>госпожа<else>сударь</if>."

#. ja: かしこまりました…
#. de: Natürlich, wie Ihr wünscht.
#. fr: Je vous l'apporte tout de suite...
msgctxt "Balloon:4843:0:1"
msgid "As you wish."
msgstr "Как пожелаете."

#. ja: 我が美剣にかけて<br>踊ってみせましょう
#. de: Dürfte ich Euch meinen besten Schritt vorführen?
#. fr: Laissez-moi vous montrer mes talents de danseur<nbsp>!
msgctxt "Balloon:4844:0:1"
msgid "The next time you step on my toes, dear, it shall be the last."
msgstr "В следующий раз наступишь мне на ногу, милая, и это будет последний раз."

#. ja: ところで副長は<br>どちらに…？
#. de: Wo ist denn eigentlich der gute Herr Vize-Kommandant?
#. fr: Où est passé le vice-commandant<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4845:0:1"
msgid "One-two-three,<br>One-two-three."
msgstr "Раз-два-три,<br>раз-два-три."

#. ja: 力を束ねるのだ…
#. de: Wir sind ein traumhaftes Paar. Der erste Preis ist uns sicher<nbsp>...
#. fr: À deux, c'est plus facile...
msgctxt "Balloon:4846:0:1"
msgid "It's all in the hips."
msgstr "Всё дело в движении бёдер."

#. ja: なんと！？<br>真でありますか？
#. de: Wirklich? Meint Ihr das auch ernst?
#. fr: Vraiment<nbsp>!? Vous êtes sûre<nbsp>?
msgctxt "Balloon:4847:0:1"
msgid "\\<gasp> Would he truly say such things?"
msgstr "<i>Ах!</i> Неужели он и правда такое сказал?"

#. ja: 舞踏勝負か、面白い！
#. de: Famose Idee, einen Wettbewerb im Tanze abzuhalten.
#. fr: J'adore les concours de danse<nbsp>!
msgctxt "Balloon:4848:0:1"
msgid "We should hold a contest."
msgstr "Надо устроить состязание!"

#. ja: 軽やかなステップだ…
#. de: Wie leichtfüßig du doch bist!
#. fr: Avec légèreté, surtout...
msgctxt "Balloon:4849:0:1"
msgid "You're quite light on your feet."
msgstr "Как легко ты двигаешься!"

#. ja: ハハハ…
#. de: A-hahaha!
#. fr: Ah ah ah...
msgctxt "Balloon:4850:0:1"
msgid "Hahaha."
msgstr "Ха-ха-ха."

#. ja: さあ、踊りましょう
#. de: Also, wollen wir es wagen?
#. fr: Dansons à en perdre la tête<nbsp>!
msgctxt "Balloon:4851:0:1"
msgid "Come, let us put on a show!"
msgstr "Ну же, устроим настоящее представление!"

#. ja: どうにも<br>ダンスは苦手だ…
#. de: Man sagt, ich habe zwei linke Füße<nbsp>...
#. fr: Je n'ai jamais été très doué...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4852:0:1"
msgid "That's the way.<br>Now, follow my lead."
msgstr "Вот так.<br>Теперь повторяй за мной."

#. ja: おっと…
#. de: Nicht so hastig, meine Liebe<nbsp>...
#. fr: Doucement...
msgctxt "Balloon:4853:0:1"
msgid "Watch your step."
msgstr "Осторожнее, смотри под ноги."

#. ja: フフフ…
#. de: Hihi ...
#. fr: Hi hi hi...
msgctxt "Balloon:4854:0:1"
msgid "Hehehe."
msgstr "Хе-хе-хе..."

#. ja: 美しい…
#. de: Diese Schönheit!
#. fr: Comme c'est beau...
msgctxt "Balloon:4855:0:1"
msgid "A lovely thought."
msgstr "Прекрасная мысль."

#. ja: お相手できて<br>光栄です…
#. de: Es ist eine Ehre, Euer Antlitz erblicken zu dürfen!
#. fr: C'est un honneur de vous connaître...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:4856:0:1"
msgid "Keep smiling dear.<br>We have to keep smiling..."
msgstr "Улыбайся, дорогой.<br>Нам обоим надо улыбаться..."

#. ja: 実に素晴らしい<br>舞踏会だ…
#. de: So einen wundervollen Ball haben wir schon lange nicht mehr abgehalten!
#. fr: Ce bal est une vraie splendeur...
msgctxt "Balloon:4857:0:1"
msgid "Would that I could dance so wonderfully. Alas..."
msgstr "Ах, если бы я так же прекрасно танцевал... Но увы."

#. ja: ちゃんと<br>踊れているかしら？
#. de: Vergnügt Ihr Euch auch?
#. fr: Ça virevolte de partout<nbsp>!
msgctxt "Balloon:4858:0:1"
msgid "How am I doing, dear?"
msgstr "Ну как я, милый?"

#. ja: お上手ですこと…
#. de: Ihr seid anmutig wie ein Schwan!
#. fr: Quel spectacle...
msgctxt "Balloon:4859:0:1"
msgid "I see you've been practicing."
msgstr "Вижу, ты тренировался."

#. ja: 楽しみましょう…
#. de: Was für ein königliches Vergnügen!
#. fr: Amusons-nous...
msgctxt "Balloon:4860:0:1"
msgid "Relax, darling, you're doing fine."
msgstr "Расслабься, дорогой, у тебя всё отлично."

#. ja: 嗚呼、夢のよう…
#. de: Ich wähne mich in einem Traum.
#. fr: On nage en plein rêve...
msgctxt "Balloon:4861:0:1"
msgid "If this is a dream, I hope to never wake."
msgstr "Если это сон, не хочу просыпаться."

#. ja: リードして<br>くださいましね？
#. de: Dürfte ich mir wohl anmaßen, Euch zu führen?
#. fr: Je vous laisse mener la danse<nbsp>?
msgctxt "Balloon:4862:0:1"
msgid "Aren't you glad we came?"
msgstr "Рад, что мы сюда пришли?"

#. ja: あちらの殿方は…
#. de: Seht nur, die Damen und Herren dort hinten.
#. fr: Ces personnes, là-bas...
msgctxt "Balloon:4863:0:1"
msgid "Hm? Who is that?"
msgstr "Хм? Кто это?"

#. ja: もしかして噂の…？
#. de: Aber, das sind doch nicht etwa<nbsp>...
#. fr: Serait-ce les fameux...
msgctxt "Balloon:4864:0:1"
msgid "A guest of His Majesty?"
msgstr "Неужели это тот самый?.."

#. ja: 国王陛下は<br>いらっしゃらないのかしら？
#. de: Weilt Unsere Majestät denn heute nicht unter uns?
#. fr: Sa Majesté n'est pas avec nous<nbsp>?
msgctxt "Balloon:4865:0:1"
msgid "Will His Majesty be joining us?"
msgstr "Его Величество к нам присоединится?"

#. ja: ふう、踊り疲れて<br>しまったわ…
#. de: Puh ... Die Tanzerei hat meinen Kopf mit Schwindel und meine Beine mit Blei gefüllt.
#. fr: Ouf<nbsp>! Toutes ces gesticulations m'ont épuisée...
msgctxt "Balloon:4866:0:1"
msgid "I cannot dance another step. A moment, I prithee..."
msgstr "Больше ни шагу не станцую. Дайте передохнуть, прошу..."

#. ja: ご用があるようでしたら<br>お申し付けを…
#. de: Bitte, wenn ich Euch irgendeinen Wunsch erfüllen kann, braucht Ihr es nur zu sagen.
#. fr: Si vous avez besoin de quelque chose, je suis à votre service...
msgctxt "Balloon:4867:0:1"
msgid "If there is aught you require, pray do not hesitate to ask."
msgstr "Если вам что-нибудь понадобится, не стесняйтесь попросить."

#. ja: どんどん食べて！<br>お腹が風船になるまで♪
#. de: Iss nur, kleiner Junge! Iss, bis du Bauchschmerzen kriegst. \<kicher>
#. fr: Allez, mange<nbsp>! Ton ventre va gonfler comme une montgolfière<nbsp>!
msgctxt "Balloon:4868:0:1"
msgid "Go ahead, eat until you're fit to burst!"
msgstr "Ну же, ешь, пока не лопнешь!"

#. ja: でしょ♪<br>あなたも木になってみる？
#. de: Hihi, toll oder? Wärst du auch gern mal so groß? Das wär doch lustig!
#. fr: N'est-ce pas<nbsp>!? Ça te dirait que je te transforme en arbuste pour voir ce que ça fait<nbsp>?♪
msgctxt "Balloon:4869:0:1"
msgid "Well, if you put your mind to it, you could turn into a big tree yourself!"
msgstr "Если постараешься, сама сможешь вырасти в огромное дерево!"

#. ja: あのおっきな木すごいねぇ！
#. de: Der Baum ist aber groß! Der geht ja bis in den Himmel!
#. fr: Il est gros l'arbre qui y a là-bas, dis donc<nbsp>!
msgctxt "Balloon:4870:0:1"
msgid "I wish I was as big as that tree!"
msgstr "Вот бы мне вырасти такой же большой, как то дерево!"

#. ja: あの茸から登れそうだね！<br>いってみよう！
#. de: Sieht so aus, als könnte man über diese Pilze dort nach oben!<br>Los, probieren wir's aus!
#. fr: V'nez<nbsp>! On peut se servir des champignons pour grimper<nbsp>!
msgctxt "Balloon:4871:0:1"
msgid "If we use those big mushrooms, we can reach the top!"
msgstr "Если забраться по тем огромным грибам, можно добраться до вершины!"

#. ja: おもしろそう！<br>宝の地図あったりして！
#. de: Ja, los! Vielleicht leben da oben ja Tiger Lilu und Khema Kahn!
#. fr: Ouais<nbsp>! Si ça se trouve, y a une carte au trésor tout en haut<nbsp>!
msgctxt "Balloon:4872:0:1"
msgid "And there might even be hidden treasure!"
msgstr "А вдруг там ещё и клад спрятан!"

#. ja: 見てみろよ！<br>この木登れるみたいだぞ！
#. de: He, schaut euch das mal an! Da kann man bestimmt raufklettern!
#. fr: Ça vous dit, on escalade l'arbre géant<nbsp>!?
msgctxt "Balloon:4873:0:1"
msgid "Last one there's a rotten egg!"
msgstr "Кто последний — тот тухлое яйцо!"

#. ja: 気持ちいいな～
#. de: Ach, das ist ja so herrlich frisch!
#. fr: On est pas bien, là<nbsp>?
msgctxt "Balloon:4874:0:1"
msgid "Trickle, trickle! Splishy splash!"
msgstr "Плюх да брызги! Вот здорово!"

#. ja: フーアがいないから<br>遊び放題ね！
#. de: Und keine doofen Fuath, die einem den Spaß verderben!
#. fr: En plus, on est tranquilles<nbsp>! Y a pas de Fuath<nbsp>!
msgctxt "Balloon:4875:0:1"
msgid "Those horrid Fuath can't spoil our fun here!"
msgstr "Эти противные фуаты нам тут веселье не испортят!"

#. ja: 背中押してあげる！
#. de: Komm, ich schubs dich an. \<kicher>
#. fr: T'iras encore plus vite si je te pousse<nbsp>!♪
msgctxt "Balloon:4876:0:1"
msgid "Would you like me to give you a push?"
msgstr "Хочешь, я тебя подтолкну?"

#. ja: うはぁ…結構急だなぁ
#. de: Oh, das sieht aber ganz schön steil aus<nbsp>...
#. fr: Y... y tombe presque à pic votre toboggan...
msgctxt "Balloon:4877:0:1"
msgid "Oh... It's a bit steep, isn't it?"
msgstr "Ох... Крутовато, да?"

#. ja: 羽がないと<br>こんな遊びができるのね！
#. de: Das sieht wirklich spaßig aus! Aber mit Flügeln rutscht es sich nicht so gut<nbsp>...
#. fr: Ouf. Avec nos ailes, on pouvait pas les essayer avant.
msgctxt "Balloon:4878:0:1"
msgid "You were as quick as lightning!"
msgstr "Ты быстрее молнии!"

#. ja: サイコーー！！！
#. de: Das ist ja sooo toll!
#. fr: C'était trop trop bien<nbsp>!
msgctxt "Balloon:4879:0:1"
msgid "Did you see how fast I went?"
msgstr "Это было потрясающе!!!"

#. ja: もっかい滑ろうぜ！
#. de: Komm, lass uns gleich nochmal rutschen!
#. fr: V'nez, on y retourne<nbsp>!
msgctxt "Balloon:4880:0:1"
msgid "Let's do that again!"
msgstr "Давай ещё раз!"

#. ja: うんうん！　行こう！
#. de: Au ja!
#. fr: Le dernier arrivé est un Fuath<nbsp>!
msgctxt "Balloon:4881:0:1"
msgid "See you at the top!"
msgstr "Встретимся наверху!"

#. ja: トンネルがあったらいいなぁ
#. de: Ein Tunnel wäre lustig!
#. fr: Faudrait un pont pour traverser la rivière... Ou un tunnel, carrément<nbsp>!
msgctxt "Balloon:4882:0:1"
msgid "We should make a bridge!"
msgstr "Вот бы тут мост построить!"

#. ja: カラフルなのがいいね！
#. de: Alles müsste viel bunter sein!
#. fr: Ouais<nbsp>! Avec plein de couleurs<nbsp>!
msgctxt "Balloon:4883:0:1"
msgid "All the colors of the rainbow!"
msgstr "Во все цвета радуги!"

#. ja: ドドーンっと<br>大きな遊び場が欲しいな！
#. de: Was hier fehlt ist ein riesiger Spielplatz!
#. fr: Ici, faudrait des jeux grands comme ça<nbsp>!
msgctxt "Balloon:4884:0:1"
msgid "Look at all this space! Think of the possibilities!"
msgstr "Сколько тут места! Представьте, что можно сделать!"

#. ja: 登れる高い遊具とかどう？
#. de: Wie wäre es mit etwas, an dem man ganz hoch klettern kann?
#. fr: Et on pourrait monter dessus pour grimper dans le ciel<nbsp>!
msgctxt "Balloon:4885:0:1"
msgid "Let's make a big tower for the children to climb!"
msgstr "Давайте построим высокую башню, чтобы дети могли на неё залезть!"

#. ja: それいいわね！
#. de: Eine ausgezeichnete Idee!
#. fr: Oh oui<nbsp>! Ce serait parfait<nbsp>!
msgctxt "Balloon:4886:0:1"
msgid "And then they can fly from the top! Tee hee!"
msgstr "А потом они смогут слететь с самой верхушки! Хи-хи!"

#. ja: なーんか、物足りないよぉ！
#. de: Irgendwie fehlt noch etwas<nbsp>...
#. fr: Hmm... Manque quelque chose quand même<nbsp>!
msgctxt "Balloon:4887:0:1"
msgid "Waterfalls are nice and all, but something is missing..."
msgstr "Водопады — это, конечно, хорошо, но чего-то не хватает..."

#. ja: ヒトが滑り落ちるところ<br>見られたら楽しいよねー！
#. de: Wäre lustig, wenn man den Kindern dabei zuschauen könnte, wie sie in den Matsch plumpsen. \<kicher>
#. fr: Moi j'aimerais bien voir les humains tomber ou glisser<nbsp>!
msgctxt "Balloon:4888:0:1"
msgid "What about something slippy? Or something slidey?"
msgstr "А если сделать что-нибудь скользкое? Или горку?"

#. ja: お茶会ごっこがしたいわ
#. de: Ich will Kaffee und Kuchen spielen!
#. fr: On pourrait les faire jouer à la dînette<nbsp>!
msgctxt "Balloon:4889:0:1"
msgid "We should host a tea party!"
msgstr "Надо устроить чаепитие!"

#. ja: あまーいお菓子も食べたい！
#. de: Ich möchte was Zuckersüßes naschen!
#. fr: Oh oui<nbsp>! Avec plein de petits gâteaux<nbsp>!
msgctxt "Balloon:4890:0:1"
msgid "With lots of delicious cakes!"
msgstr "И побольше вкусных пирожных!"

#. ja: あ、じゃあさ！<br>お菓子のお家とかどう？
#. de: Wie wäre es mit einem Haus aus Zucker?!<br>Mit Tischen und Stühlen und Kuchen!
#. fr: Et pourquoi pas... une maison en gâteau<nbsp>!
msgctxt "Balloon:4891:0:1"
msgid "Or even better, a whole house made of sweets!"
msgstr "А ещё лучше — целый дом из сладостей!"

#. ja: 動物が好きなのね
#. de: Oh, schau, all die süßen Tiere<nbsp>...<br>Eins niedlicher als das andere! \<kicher>
#. fr: T'adores les animaux toi, hein<nbsp>?
msgctxt "Balloon:4892:0:1"
msgid "They obey my every command..."
msgstr "Они исполняют любой мой приказ..."

#. ja: いいですね、アナタ！<br>アタシに合わせなサイ！
#. de: Gut so, schön im Rhythmus bleiben.
#. fr: Gardez le rythme, et tout ira bien<nbsp>!
msgctxt "Balloon:4893:0:1"
msgid "Would that my last partner could dance so well."
msgstr "Вот это да, милая! Держи ритм и повторяй за мной!"

#. ja: あら♪<br>来てくれて嬉しいわ
#. de: Oh, schön dich zu sehen!
#. fr: Coucou, <split " " 1><string $gs1></split><nbsp>! Ça fait plaisir de te voir<nbsp>!♪
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "Balloon:4894:0:1"
msgid "<split \" \" 1><string $gs1></split>, so good of you to visit!"
msgstr "<split \" \" 1><string $gs1></split>, как здорово, что ты заглянул<if $gn4>а</if>!"

#. ja: 私たちのリェー・メグで<br>心ゆくまで楽しんでね
#. de: Viel Spaß in Lyhe Mheg! Erfreue dich an unserem Werk, so lang es dein Herz begehrt!
#. fr: Amuse-toi bien<nbsp>!
msgctxt "Balloon:4895:0:1"
msgid "Please have lots of fun!"
msgstr "Веселитесь от души!"

#. ja: みんなくつろいでるね
#. de: Mach es dir ruhig bequem!
#. fr: Les enfants adorent nos hamacs<nbsp>!
msgctxt "Balloon:4896:0:1"
msgid "The children just love to lie in these and swing away."
msgstr "Дети обожают лежать в этих гамаках и качаться."

#. ja: これで、揺られて眠るみたい
#. de: Das ist ja wie eine Kinderwiege!
#. fr: Moi aussi j'aimerais bien dormir dedans.
msgctxt "Balloon:4897:0:1"
msgid "Swinging on the wind, side and side again."
msgstr "Качает туда-сюда, будто ветер..."

#. ja: ゆらゆら…楽しそう♪
#. de: Das sieht lustig aus!
#. fr: C'est vrai que ça doit être amusant de se faire bercer<nbsp>!♪
msgctxt "Balloon:4898:0:1"
msgid "To their hearts' content!"
msgstr "Им так весело качаться!"

#. ja: ファラララララ…
#. de: Wuuusch<nbsp>...
#. fr: Et tellement relaxant...
msgctxt "Balloon:4899:0:1"
msgid "Fa la la la la.♪"
msgstr "Фа-ла-ла-ла-ла.♪"

#. ja: エンタープライズ<br>ハッシーン！
#. de: Navigation: Warp fünf. Volle Energie!
#. fr: En avant, Entreprise<nbsp>!
msgctxt "Balloon:4900:0:1"
msgid "Enterprise...engage!"
msgstr "Энтерпрайз... полный вперёд!"

#. ja: なぁに、それ？
#. de: Was soll denn DAS bedeuten?
#. fr: C'est qui, Entreprise<nbsp>?
msgctxt "Balloon:4901:0:1"
msgid "Hm? What's an enterprise?"
msgstr "А? Что такое «Энтерпрайз»?"

#. ja: よくわからないけど<br>誰かの夢で言ってたの
#. de: Keine Ahnung. Das hat jemand im Traum gemurmelt<nbsp>...
#. fr: Chais pas trop. J'ai entendu ça dans le rêve de quelqu'un.
msgctxt "Balloon:4902:0:1"
msgid "I've no idea. I just heard someone say it."
msgstr "Понятия не имею. Просто услышал, как кто-то это сказал."

#. ja: そうなの？<br>私もやってみようかな
#. de: Echt? Muss ich auch gleich mal ausprobieren!
#. fr: J'veux essayer aussi<nbsp>!
msgctxt "Balloon:4903:0:1"
msgid "Oh? I guess I'll say it too, then."
msgstr "Правда? Тогда и я попробую сказать."

#. ja: エンタープライズ<br>ハッシーン！
#. de: Nivagation: Wuprs fünf! Voller Energie!
#. fr: En avant, Entreprise<nbsp>!
msgctxt "Balloon:4904:0:1"
msgid "Enterprise...engage!"
msgstr "Предприятие... полный вперёд!"

#. ja: なんだか、楽しい！
#. de: Das macht echt Spaß!
#. fr: C'est amusant<nbsp>!
msgctxt "Balloon:4905:0:1"
msgid "Heh, that was strangely fun!"
msgstr "Ха, а ведь было весело!"

#. ja: ふふふっ♪<br>ハッシーン！
#. de: Wuhuuu! Volle Energie! Hahaha!
#. fr: Hé hé hé<nbsp>! Ennnn avaaant<nbsp>!
msgctxt "Balloon:4906:0:1"
msgid "I know, right!?"
msgstr "Вот-вот!"

#. ja: 花は…好き
#. de: Ich liebe Blumen!
#. fr: J'aime les fleurs. Elles sont jolies et sentent tellement bon.
msgctxt "Balloon:4907:0:1"
msgid "I like flowers. They look pretty and smell nice."
msgstr "Я люблю цветы. Они красивые и так приятно пахнут."

#. ja: 私も大好き♪
#. de: Ich auch!
#. fr: Moi aussi, j'adore<nbsp>!♪
msgctxt "Balloon:4908:0:1"
msgid "Don't they, though?"
msgstr "А то!"

#. ja: コレ、何か知ってる？
#. de: Weißt du, was das hier sein soll?
#. fr: Tu sais ce que c'est, ça<nbsp>?
msgctxt "Balloon:4909:0:1"
msgid "Do you know what this creature is?"
msgstr "Ты знаешь, что это за зверёк?"

#. ja: 白い豚？<br>リダ・ラーンにいた子ね
#. de: Ein<nbsp>... weißes Schweinchen? So eins hab ich mal in Lydha Lran gesehen.
#. fr: Un cochon blanc<nbsp>? Il ressemble un peu à ce truc qui porte un sac rouge à Lydha Lran.
msgctxt "Balloon:4910:0:1"
msgid "No. Wasn't there something like it in Lydha Lran?"
msgstr "Нет. Разве в Лидха-Лране не было кого-то похожего?"

#. ja: モーグリっていうのよ
#. de: Man nennt sie Mogrys.
#. fr: On appelle ça un Mog.
msgctxt "Balloon:4911:0:1"
msgid "Right. It's called a moogle."
msgstr "Точно. Это мугл."

#. ja: モー…グリ…<br>頭の先に付いてる玉は？
#. de: Mogrys? Und was soll dieser komische Bommel da auf dem Kopf?
#. fr: Un Mog...<nbsp>? Pourquoi il a une boule accrochée sur la tête<nbsp>?
msgctxt "Balloon:4912:0:1"
msgid "Moogle... And what's that peculiar thing attached to its head?"
msgstr "Мугл... А что это у него на голове такое странное?"

#. ja: それもモーグリよ！<br>本物は淡く光るみたい
#. de: Frag mich doch nicht. Aber die von echten Mogrys sollen angeblich leuchten!
#. fr: Ça brille, en fait. Je crois qu'ils appellent ça un pompon.
msgctxt "Balloon:4913:0:1"
msgid "That's a pom-pom, and they say that real ones glow!"
msgstr "Это помпон. Говорят, у настоящих он светится!"

#. ja: え…玉が光るの？<br>…ふぅん
#. de: Leuchten? Wie eine Laterne? Hah!
#. fr: Ah bon<nbsp>!? Ça brille<nbsp>!?
msgctxt "Balloon:4914:0:1"
msgid "They glow? Really?"
msgstr "И правда светится?"

#. ja: …欲しい！
#. de: So einen will ich auch haben!
#. fr: ... J'en veux un vrai<nbsp>!
msgctxt "Balloon:4915:0:1"
msgid "I want one!"
msgstr "Хочу такой!"

#. ja: ねぇ、この青い玉<br>取れるかな？
#. de: Ob man diese blaue Kugel pflücken kann?
#. fr: Tu crois qu'on pourrait en trouver un bleu comme ça<nbsp>?
msgctxt "Balloon:4916:0:1"
msgid "Does it come off the moogle, do you think?"
msgstr "Как думаешь, это можно снять с мугла?"

#. ja: むしってみたらわかるわ♪
#. de: Probieren geht über Studieren!
#. fr: On a qu'à essayer d'en arracher un à un Mog<nbsp>!♪
msgctxt "Balloon:4917:0:1"
msgid "If you pull hard enough, sure!"
msgstr "Если хорошенько дёрнуть — конечно!"

#. ja: そうね！<br>たくさん集めて飾りましょ！
#. de: Gute Idee! Komm, lass uns ganz viele sammeln und irgendwas damit schmücken!
#. fr: T'as raison<nbsp>! Et il nous en faut plein<nbsp>!
msgctxt "Balloon:4918:0:1"
msgid "Great! Let's collect lots and decorate with them!"
msgstr "Здорово! Соберём побольше и украсим ими всё вокруг!"

#. ja: ものすごい熱量の<br>使い魔だったね…
#. de: Die Hitze war beinah nicht zu ertragen.
#. fr: La température a grimpé en flèche d'un seul coup...
msgctxt "Balloon:4919:0:1"
msgid "Phew. I'm glad for that to be over and done with."
msgstr "Фух. Хорошо, что с этим покончено."

#. ja: 交渉事は水晶公と<br>アルフィノに任せるわ
#. de: Die Verhandlung überlasse ich besser dem Kristall<shy>exarchen und meinem Bruder.
#. fr: Alphinaud, Exarque, je vous laisse gérer la partie diplomatique<nbsp>!
msgctxt "Balloon:4920:0:1"
msgid "We'd best leave the negotiations to Alphinaud and the Exarch."
msgstr "Пожалуй, переговоры лучше оставить Альфино и Экзарху."

#. ja: この惨状もホウキが<br>掃除するのかしら？
#. de: Bestimmt kümmern sich die Besen gleich um die Aschehaufen.
#. fr: Ces pauvres balais vont avoir de la surface à nettoyer...
msgctxt "Balloon:4921:0:1"
msgid "Perhaps now we have afforded ourselves an audience."
msgstr "Может, теперь нас наконец-то выслушают."

#. ja: さて、いよいよ<br>肝心の交渉だが…
#. de: Endlich stehen wir ihm gegenüber.
#. fr: Nous voilà enfin arrivés au moment des négociations.
msgctxt "Balloon:4922:0:1"
msgid "Now they have little choice but to hear our plea."
msgstr "Ну что, теперь главное — переговоры."

#. ja: ねえねえ！<br>次はどんな夢を創りたい？
#. de: Sag schon! Was für einen Traum wollen wir als nächstes verwirklichen?
#. fr: Dis, An. Qu'est-ce qu'on devrait rajouter maintenant<nbsp>?
msgctxt "Balloon:4923:0:1"
msgid "So, what kind of dream should we spin next?"
msgstr "Ну что, какую мечту будем создавать дальше?"

#. ja: うーん…ティルは？
#. de: Irgendeine Inspiration, Tyr Beq?
#. fr: Hmm... Je sais pas trop, et toi<nbsp>?
msgctxt "Balloon:4924:0:1"
msgid "I'm not sure. What do you think?"
msgstr "Даже не знаю. А ты как думаешь?"

#. ja: そうねぇ…
#. de: Hmm, mal sehen<nbsp>...
#. fr: Voyons voir...
msgctxt "Balloon:4925:0:1"
msgid "Hmmm..."
msgstr "Хм-м..."

#. ja: おっきな羊を創ってみたいわ
#. de: Ich hab neulich in einem Traum ein lustiges Riesenschaf gesehen. Das war lustig.
#. fr: Pourquoi pas une énooorme brebis<nbsp>!?
msgctxt "Balloon:4926:0:1"
msgid "How about...a great big sheep?"
msgstr "А давайте... огромную овцу?"

#. ja: たくさんミルクを絞って<br>ミルクの泉を創るの！
#. de: Das hat so viel Milch gegeben, dass es einen Fluss aus Milch erschaffen hat!
#. fr: Comme ça, on pourra aussi faire une grande fontaine de lait<nbsp>!
msgctxt "Balloon:4927:0:1"
msgid "With all the milk it gives us, we could make a milk fountain!"
msgstr "Из её молока можно сделать целый фонтан!"

#. ja: どう？<br>ステキでしょ♪
#. de: Lustig oder? ♪
#. fr: Qu'est-ce que t'en penses<nbsp>? Ce serait génial, hein<nbsp>?♪
msgctxt "Balloon:4928:0:1"
msgid "Imagine it─we could drink and play at the same time!"
msgstr "Представляешь? И пить можно, и плескаться одновременно!"

#. ja: うん！<br>さすがティル！
#. de: Haha, ja! Ein klasse Einfall!
#. fr: T'as toujours de bonnes idées, Tyr<nbsp>!
msgctxt "Balloon:4929:0:1"
msgid "Oh, that sounds wonderful!"
msgstr "Ой, как здорово!"

#. ja: 羊をたくさん創って<br>リェー・メグを埋め付くそう！
#. de: Lass uns ganz viele davon hierherzaubern!
#. fr: Je vais inonder le Lyhe Mheg de mouton, et on pourra nager dans leur laine<nbsp>!
msgctxt "Balloon:4930:0:1"
msgid "Let's make lots of big sheep and drown all of Lyhe Mheg in milk!"
msgstr "Давайте насоздаём огромных овец и затопим молоком весь Лихе-Мег!"

#. ja: …と、とにかく！<br>検討してみましょ！
#. de: Also gut, lass es mich mal versuchen<nbsp>...
#. fr: Heu... O-on en reparle une autre fois, d'accord<nbsp>?
msgctxt "Balloon:4931:0:1"
msgid "Uh... We're going to need to have a little talk..."
msgstr "Э-э... Нам надо это хорошенько обсудить..."

#. ja: 大きな獣…かしら
#. de: Hmm. Eine wilde Bestie vielleicht?
#. fr: Pourquoi pas une énooorme bête sauvage<nbsp>!?
msgctxt "Balloon:4932:0:1"
msgid "How about...a great big beast?"
msgstr "А давайте... огромного зверя?"

#. ja: アイツの天敵を創るのよ！<br>夢に紛れないように！
#. de: Das sind die natürlichen Feinde von den<nbsp>... Lasst euch nicht im Traum von ihnen erwischen!
#. fr: Comme ça, au moins, qui tu sais viendra pas nous embêter<nbsp>!
msgctxt "Balloon:4933:0:1"
msgid "Something that's a natural predator to the you-know-whats!"
msgstr "Создадим ему природных врагов! Чтобы эти... ну, ты знаешь, не совались в наши сны!"

#. ja: ところで、アイツのクッキー…<br>私、創った覚えないのよね…
#. de: Ich habe die hier übrigens vorhin entdeckt. Hast du die Kekse gebacken?
#. fr: D'ailleurs, c'est toi qui as créé des gâteaux à leur forme...<nbsp>?
msgctxt "Balloon:4934:0:1"
msgid "Speaking of which...did you make cookies in their likeness?"
msgstr "Кстати... А ты сделал печенье в их форме?"

#. ja: え、そうなの…？<br>てっきり、ティルが創ったのかと…
#. de: Öhm. Ja. Darf ich das nicht?
#. fr: Heu... Je croyais que c'était toi...
msgctxt "Balloon:4935:0:1"
msgid "I did. Should I not have?"
msgstr "Да. А что, нельзя было?"

#. ja: そういえば…<br>近頃外でよく見かけるよね
#. de: Die sieht man draußen übrigens auch in letzter Zeit recht oft.
#. fr: Ça me fait penser, on en voit souvent près de Lydha Lran depuis un moment...
msgctxt "Balloon:4936:0:1"
msgid "I've been seeing them a lot outside, so I thought I'd try my hand..."
msgstr "Я часто встречаю их снаружи, вот и решил попробовать..."

#. ja: 気づかれないよう<br>慎重にいこう
#. de: Schön vorsichtig, damit das Biest mich nicht sieht<nbsp>...
#. fr: Surtout, pas de prrrécipitation...
msgctxt "Balloon:4939:0:1"
msgid "I must be careful."
msgstr "Нужно действовать осторожно, чтобы меня не заметили."

#. ja: こちらを向いてるときに<br>近づくのは危険だな…
#. de: Ich will dem Ding nicht zu nah kommen, wenn es in meine Richtung sieht<nbsp>...
#. fr: Attendons qu'il ait le dos tourrrné...
msgctxt "Balloon:4940:0:1"
msgid "Perhaps it'd be best to approach from the rear."
msgstr "Подходить, когда он смотрит в мою сторону, опасно..."

#. ja: おっ…<br>背を向けたぞ…?
#. de: Das Biest sieht weg! Soll ich los?
#. fr: Ça y est, il regarrrde de l'autre côté<nbsp>!
msgctxt "Balloon:4941:0:1"
msgid "Oh! Its back is turned!"
msgstr "О... Он отвернулся!"

#. ja: ぬぉぉぉぉぉ！
#. de: Aaaaaah!
#. fr: Yaaaaah<nbsp>!!
msgctxt "Balloon:4942:0:1"
msgid "I pray this works..."
msgstr "Надеюсь, сработает..."

#. ja: ぬぅ…<br>ほかの魔物もいるな…
#. de: Sch-Schon wieder so ein Unding!
#. fr: Saperrrlipopette<nbsp>! Notre deuxième talos n'est pas seul<nbsp>!
msgctxt "Balloon:4943:0:1"
msgid "Curses. It's not alone."
msgstr "Проклятье. Он не один."

#. ja: より気をつけていこう…
#. de: Das sieht mir ziemlich gefährlich aus<nbsp>...
#. fr: Il va falloir être trrrès prudent...
msgctxt "Balloon:4944:0:1"
msgid "Calm yourself, old boy. Everything will be fine."
msgstr "Спокойно, старина. Всё будет хорошо."

#. ja: いつでも合図をくれ
#. de: Ich bin bereit. Kann ich los?
#. fr: Quand vous voulez, <split " " 1><string $gs1></split><nbsp>!
msgctxt "Balloon:4945:0:1"
msgid "An opening!"
msgstr "Вот он, шанс!"

#. ja: い、いくぞぉぉぉぉぉ！
#. de: Jaaaaaa!
#. fr: Que trrrépasse si je faiblis<nbsp>!
msgctxt "Balloon:4946:0:1"
msgid "Please don't turn around!"
msgstr "П-пожалуйста, не оборачивайся!"

#. ja: 真正面からは無理だー！<br>撤退するぞー！！
#. de: Von vorne trau ich mich nicht! Rückzug!
#. fr: Oh non, il m'a vu<nbsp>! Retraite<nbsp>! RETRRRAIIIITE<nbsp>!!
msgctxt "Balloon:4949:0:1"
msgid "Oh no! I've been spotted!"
msgstr "О нет! Меня заметили!"

#. ja: 赤はウララの色…<br>かわいいわねっ♪
#. de: Rot ist die Farbe Ulalas. Ist sie nicht süß?
#. fr: J'adore le rouge, c'est une si jolie couleur<nbsp>!
msgctxt "Balloon:4950:0:1"
msgid "Isn't red such a lovely color? I certainly think so."
msgstr "Разве красный не прекрасный цвет? Мне он очень нравится."

#. ja: 素敵な飾り付け…！
#. de: Wie wunderschön!
#. fr: Quelles jolies décorations<nbsp>!
msgctxt "Balloon:4951:0:1"
msgid "What lovely decorations!"
msgstr "Какие прекрасные украшения!"

#. ja: ここで歌ってみたいものね
#. de: Du möchtest hier bestimmt ein Liedchen zum Besten geben, oder?
#. fr: Qu'est-ce que j'aimerais chanter sur cette scène<nbsp>!
msgctxt "Balloon:4952:0:1"
msgid "Oh, what I wouldn't give to sing on this stage!"
msgstr "Ох, чего бы я только не отдал, чтобы спеть на этой сцене!"

#. ja: 新たな詩歌が浮かびそうだ…
#. de: Diese neue Ballade wird gewiss Aufsehen erregen.
#. fr: Je sens l'inspiration monter en moi...
msgctxt "Balloon:4953:0:1"
msgid "I can just feel inspiration about to strike..."
msgstr "Чувствую, вот-вот меня посетит вдохновение..."

#. ja: どいつもこいつも<br>浮かれやがって…
#. de: Keiner scheint so recht in Stimmung zu sein<nbsp>...
#. fr: Ardeur et affection, tu parles... On a déjà assez de travail<nbsp>!
msgctxt "Balloon:4954:0:1"
msgid "Who has time for ardor and affection? We have a job to do..."
msgstr "Кому тут до любовных утех? Нам работать надо..."

#. ja: 普段と色が違うのね、珍しい…
#. de: Eine ungewöhnliche Farbe<nbsp>...
#. fr: C'est rare de voir une telle couleur à cette époque de l'année...
msgctxt "Balloon:4955:0:1"
msgid "This is an unusual color to see at this time of year..."
msgstr "В это время года такой цвет редко встретишь..."

#. ja: 大丈夫、次はうまくいくわよ…！
#. de: Sei unbesorgt, nächstes Mal wird bestimmt besser!
#. fr: Il ne faut pas s'en faire, ça ira mieux la prochaine fois<nbsp>!
msgctxt "Balloon:4956:0:1"
msgid "Cheer up, won't you? Things will go better next time. I'm sure of it!"
msgstr "Не расстраивайся, ладно? В следующий раз всё получится. Уверена!"

#. ja: さあ、もう一度<br>挑戦しましょう！
#. de: Los, probier's gleich noch einmal!
#. fr: Allez, encore une fois<nbsp>!
msgctxt "Balloon:4957:0:1"
msgid "Come, now. Let's give it another try!"
msgstr "Ну же, давай попробуем ещё раз!"

#. ja: ぎゃぁああ！<br>引き返すぞー！！
#. de: Hiiilfe! Nichts wie weg!
#. fr: AAAAH<nbsp>!! AU SECOURRRS<nbsp>!!
msgctxt "Balloon:4958:0:1"
msgid "Gah! It's seen me!"
msgstr "А-а-а! Он меня заметил!"

#. ja: め、目の前に魔物がー！<br>逃げなければー！！
#. de: Das Ding hat mich im Auge! Ich verzieh mich lieber!
#. fr: NOOON<nbsp>!! Je ne veux pas finir en mille morrrceaux<nbsp>!
msgctxt "Balloon:4959:0:1"
msgid "B-B-Bombs!"
msgstr "Б-б-бомбы!"

#. ja: 戦いは終わったのか…？
#. de: Ist das Gekämpfe jetzt vorbei?
#. fr: Ça y est, on l'a eu<nbsp>?
msgctxt "Balloon:4960:0:1"
msgid "Is it over?"
msgstr "Всё кончилось?"

#. ja: やっと一息付けますね
#. de: Endlich Zeit für eine kleine Ver<shy>schnauf<shy>pause!
#. fr: Enfin un peu de calme.
msgctxt "Balloon:4961:0:1"
msgid "Phew."
msgstr "Фух."

#. ja: ここはまだ敵の拠点の中だ…<br>油断しないで
#. de: Wir sind nach wie vor in Feindesgebiet. Vergesst das nicht.
#. fr: Ne relâchez pas votre vigilance, nous sommes toujours en territoire ennemi.
msgctxt "Balloon:4962:0:1"
msgid "We can't be sure. Stay vigilant."
msgstr "Мы всё ещё на вражеской территории. Не теряйте бдительности."

#. ja: 技術指導にきたからには<br>ビシバシしごいてやっからな！
#. de: Ich bin als Vorarbeiter eingesetzt worden, und ich dulde keinen Schlendrian. Enttäuscht mich nicht!
#. fr: Je suis un expert des chantiers de grande échelle, et vous avez intérêt à bien m'écouter<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:4963:0:1"
msgid "Are you ready...to be <i>supervised</i>!?"
msgstr "Ну что, готовы... к <i>надзору</i>!?"

#. ja: が、頑張りましょうね…！
#. de: Wir geben alles, Chef!
#. fr: Suivez nos in<shy>struc<shy>tions et tout se passera bien.
msgctxt "Balloon:4964:0:1"
msgid "Yes. Yes, we are."
msgstr "Д-да, конечно."

#. ja: おー！
#. de: Kannst dich auf uns verlassen!
#. fr: À vos ordres<nbsp>!
msgctxt "Balloon:4965:0:1"
msgid "Yeah!"
msgstr "Ага!"

#. ja: おぉー！
#. de: Jawohl, Chef!
#. fr: Oui, Chef<nbsp>!
msgctxt "Balloon:4966:0:1"
msgid "Am I ever!?"
msgstr "Ещё спрашиваете!?"

#. ja: ついていきます！
#. de: Legen wir los!
#. fr: On est avec vous<nbsp>!
msgctxt "Balloon:4967:0:1"
msgid "Ready and willing, sir!"
msgstr "Готовы и полны решимости, сэр!"

#. ja: ウワアアア！<br>足がすべったアアァ！
#. de: Aaah! Hilfe, ich bin ausgerutscht!
#. fr: J'ai glissé<nbsp>! À l'aide<nbsp>!
msgctxt "Balloon:4968:0:1"
msgid "Help! Somebody help!"
msgstr "Помогите! Кто-нибудь, помогите!"

#. ja: 早く小屋を建ててやりたいな
#. de: Uff, dass so eine kleine Hütte so viel Holz braucht<nbsp>...
#. fr: Où sont les matériaux, que je me mette au travail<nbsp>?
msgctxt "Balloon:4969:0:1"
msgid "Steady does it..."
msgstr "Тише едешь — дальше будешь..."

#. ja: わかりました、棟梁！
#. de: Verstanden! Wird erledigt.
#. fr: À vos ordres<nbsp>!
msgctxt "Balloon:4970:0:1"
msgid "Sir, yes, sir!"
msgstr "Так точно, сэр!"

#. ja: 職人が用意してくれる資材<br>大切に使わないとな
#. de: Materialverschwendung ist die Todsünde eines jeden Handwerkers!
#. fr: Nous devons utiliser avec soin les matériaux qui nous sont fournis par les artisans<nbsp>!
msgctxt "Balloon:4971:0:1"
msgid "Mustn't waste a single plank."
msgstr "Ни одной доски зря не потратим."

#. ja: 棚なんかも<br>ほしいところだよな
#. de: Ein paar Regale wären auch nicht schlecht<nbsp>...
#. fr: Je dirais pas non à une étagère pour ranger tous mes outils...
msgctxt "Balloon:4972:0:1"
msgid "Could use some shelves..."
msgstr "Полки бы ещё пригодились..."

#. ja: どっちが遠くまで投げられるか<br>勝負だ！
#. de: Ziel ins dümmliche Gesicht! Hahaha!
#. fr: On va voir qui c'est qui lance le plus loin<nbsp>!
msgctxt "Balloon:4973:0:1"
msgid "Bet I can throw this further than you!"
msgstr "Спорим, я дальше тебя брошу!"

#. ja: 負けないよ！
#. de: Hier, eine Erfrischung für dich!
#. fr: Tu me battras pas<nbsp>!
msgctxt "Balloon:4974:0:1"
msgid "Bet you can't!"
msgstr "А вот и нет!"

#. ja: うわ大人だ！<br>逃げろー！
#. de: Oh, oh! Schnell weg!
#. fr: Wouah, des adultes<nbsp>! On se tire<nbsp>!
msgctxt "Balloon:4975:0:1"
msgid "It's a grown-up! Run!"
msgstr "Это взрослый! Бежим!"

#. ja: いたずらなんて<br>してないよー！
#. de: War doch nur ein Spaß! Wirklich!
#. fr: On fait rien de mal, promis<nbsp>!
msgctxt "Balloon:4976:0:1"
msgid "W-We weren't being naughty or anything!"
msgstr "М-мы ничего плохого не делали!"

#. ja: ぐっ…<br>腰にくるな…！
#. de: Hnnng<nbsp>... \<pups>
#. fr: Me voilà bon pour un lumbago...
msgctxt "Balloon:4977:0:1"
msgid "Ugh, my back..."
msgstr "Уф... Спина..."

#. ja: は、はいっ！
#. de: Keine Sorge, Chef! Ich pass schon auf<nbsp>...
#. fr: Oui, Chef<nbsp>!
msgctxt "Balloon:4978:0:1"
msgid "Yes, Chief!"
msgstr "Так точно, бригадир!"

#. ja: なにか仕事はありますか？
#. de: Wo soll ich mit anpacken?
#. fr: Il y a du travail pour moi<nbsp>?
msgctxt "Balloon:4979:0:1"
msgid "Is there anything I can do?"
msgstr "Есть для меня работа?"

#. ja: ふむふむ…<br>いま人手が要りそうなのは…
#. de: Wir könnten noch ein paar helfende Hände gebrauchen<nbsp>...
#. fr: Voyons voir, où est-ce qu'il y a besoin de main-d'œuvre...<nbsp>?
msgctxt "Balloon:4980:0:1"
msgid "Hm... Where do we need hands right now?"
msgstr "Так... Где нам сейчас нужнее всего рабочие руки?"

#. ja: そうね、それなら…
#. de: Hm, mal sehen<nbsp>...
#. fr: Dans ce cas, peut-être que...
msgctxt "Balloon:4981:0:1"
msgid "Let's see..."
msgstr "Посмотрим..."

#. ja: 働きすぎはよくない<br>休養も充分にとらないとな
#. de: Nur schuften bringt auch nichts. Man muss auch mal eine Pause machen.
#. fr: C'est pas bon de trop travailler, il faut aussi savoir se reposer.
msgctxt "Balloon:4982:0:1"
msgid "Well and good to work hard, but you've got to rest as well."
msgstr "Работа работой, но и отдыхать надо."

#. ja: さっみぃー！
#. de: W-Wär's doch nur nicht so arschkalt! \<schlotter>
#. fr: Qu'est-ce qu'on se gèle, ici<nbsp>!
msgctxt "Balloon:4983:0:1"
msgid "B-B-Bloody hells it's cold!"
msgstr "Ч-чтоб вас! Как же холодно!"

#. ja: あっれ…<br>釘どこいった…
#. de: Mist! Wo sind die Nägel hin?
#. fr: Je pensais pourtant avoir posé ce clou ici...
msgctxt "Balloon:4984:0:1"
msgid "Huh? Where did I put that nail?"
msgstr "А? Куда я гвоздь положил?"

#. ja: 職人の人手は<br>足りていますか？
#. de: Haben wir jetzt genug Handwerker?
#. fr: On a réussi à trouver assez de main d'œuvre, finalement<nbsp>?
msgctxt "Balloon:4985:0:1"
msgid "Do you have enough hands?"
msgstr "Хватает нам мастеров?"

#. ja: ここは大丈夫ですよー
#. de: Hier ist alles in bester Ordnung!
#. fr: Ici, on a ce qu'il faut<nbsp>!
msgctxt "Balloon:4986:0:1"
msgid "Aye, we're good here."
msgstr "У нас тут всё в порядке!"

#. ja: 資材の調達をお願いします
#. de: Wir können immer eine helfende Hand gebrauchen.
#. fr: On aurait bien besoin de quelques ressources sup<shy>plé<shy>men<shy>tai<shy>res.
msgctxt "Balloon:4987:0:1"
msgid "We could use help with some procurement."
msgstr "Нам бы помочь с закупкой материалов."

#. ja: この造形…<br>じつに美しい…
#. de: Was für eine Form! Eine wahrlich prächtige Feuerschale!
#. fr: Ces angles, ces lignes... Tout bonnement magnifique.
msgctxt "Balloon:4988:0:1"
msgid "I don't know much about braziers, but I know what I like."
msgstr "Не разбираюсь я в жаровнях, но эта мне нравится."

#. ja: はいっ！<br>気をつけます！
#. de: Tut mir leid, soll nicht wieder vorkommen!
#. fr: Vous pouvez me faire confiance<nbsp>!
msgctxt "Balloon:4989:0:1"
msgid "I'll be careful, Chief!"
msgstr "Буду осторожнее, бригадир!"

#. ja: 街がきれいになってくのは<br>見ていて気持ちがいいな
#. de: Es ist einfach fantastisch zu sehen, wie sich dieses Viertel wandelt!
#. fr: C'est beau de voir ce quartier renaître de ses cendres...
msgctxt "Balloon:4990:0:1"
msgid "A fine feeling watching the place transform."
msgstr "Приятно смотреть, как преображается это место."

#. ja: 時間はかかるけど<br>復興がんばろう
#. de: Es wird noch eine Weile dauern, aber wenn wir alle anpacken, werden wir es schaffen!
#. fr: Il reste encore beaucoup de travail, mais on va y arriver<nbsp>!
msgctxt "Balloon:4991:0:1"
msgid "There's still a long way to go, but we'll get there."
msgstr "Работы ещё много, но мы справимся."

#. ja: すっげーー！
#. de: Boooah!
#. fr: Trop cool<nbsp>!
msgctxt "Balloon:4992:0:1"
msgid "Whoa!"
msgstr "Ого!"

#. ja: ひろーい！
#. de: Der ist ja rieeesig!
#. fr: Ouah, c'est super grand<nbsp>!
msgctxt "Balloon:4993:0:1"
msgid "This is amazing!"
msgstr "Ничего себе!"

#. ja: 疲れた職人のために<br>滋養のつくアレや、コレを…！
#. de: Nur die besten Zutaten für unsere hart arbeitenden Handwerker!
#. fr: De bons ingrédients nourrissants pour nos artisans fatigués<nbsp>!
msgctxt "Balloon:4994:0:1"
msgid "These special ingredients will keep our workers going all day long!"
msgstr "Эти особые продукты придадут рабочим сил на весь день!"

#. ja: ぐう、う…！
#. de: Ich bin schon am Verhungern<nbsp>...
#. fr: J'ai l'estomac dans les talons...
msgctxt "Balloon:4995:0:1"
msgid "Wh-What did I just eat?"
msgstr "Ч-что я только что съел?"

#. ja: すごい匂いがするわね…
#. de: Ja, es riecht wunderbar, nicht?
#. fr: Hmm, ça sent tellement bon...
msgctxt "Balloon:4996:0:1"
msgid "That's a mild way to put it."
msgstr "Мягко сказано..."

#. ja: あ、あったけぇ…
#. de: Uuuh, das ist so herrlich warm!
#. fr: Ça fait du bien... J'étais frigorifié.
msgctxt "Balloon:4997:0:1"
msgid "Hmmm, toasty..."
msgstr "М-м-м, как тепло..."

#. ja: これからも頑張りましょう…！
#. de: Ehre den Handwerkern!
#. fr: Ce grand projet ne fait que commencer<nbsp>!
msgctxt "Balloon:4998:0:1"
msgid "Yes, rest up and be ready for more!"
msgstr "Отдохните как следует и будьте готовы к новым делам!"

#. ja: お疲れさまでしたー！
#. de: Gute Arbeit, Leute!
#. fr: On ne vous décevra pas<nbsp>!
msgctxt "Balloon:4999:0:1"
msgid "Yeah!"
msgstr "Ура!"
