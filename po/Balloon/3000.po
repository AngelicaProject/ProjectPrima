# Balloon
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: どんまことすきて<br>むいたーぴらす
#. de: Ein doppeltes Leerzeichen! Husch, wusch, weg!
#. fr: C'est terrible... Si les Miqo'tes continuent à les manger, il n'y aura bientôt plus de Lalafells en Éorzéa<nbsp>!
msgctxt "Balloon:3000:0:1"
msgid "Emit PDN, ammo-ct xet."
msgstr "Эмит ПДН, патроны-кт хет."

#. ja: 新しいアクションに<br>「頭を狙う」をだな…
#. de: Vielleicht „Kopfschuss“ als neues Kommando ...
#. fr: Tu ne crois pas que les joueurs pré<shy>fé<shy>re<shy>raient une nouvelle emote, plutôt<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3001:0:1"
msgid "I hear you've found<br>some new housing."
msgstr "Слышал, ты нашёл<br>новое жильё."

#. ja: ハウジングの新情報を<br>探しているんだが…
#. de: Irgendwo muss der aktuelle Plan für die Unterkünfte doch sein.
#. fr: À mon avis, on devrait ajouter de nouveaux meubles à la prochaine mise à jour.
msgctxt "Balloon:3002:0:1"
msgid "Again with the head shot!"
msgstr "И опять выстрел в голову!"

#. ja: 今度、使う機材は…っと
#. de: Wir müssen definitiv umrüsten. Fragt sich nur, auf was.
#. fr: On a vraiment besoin de ces 92 pages de notes de mise à jour<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3003:0:1"
msgid "Maybe next year they'll<br>let me carry sacks!"
msgstr "Может, в следующем году мне<br>дадут таскать мешки!"

#. ja: どんな調整をしよう
#. de: Nein nein, das wirft die Balance über den Haufen.
#. fr: Je crois qu'il faut encore un peu ajuster les attributs de celui-ci...
msgctxt "Balloon:3004:0:1"
msgid "Neuro-what?"
msgstr "Нейро... что?"

#. ja: もっと強くしてみるか…？
#. de: Erst mal den Schaden über Zeit raufsetzen?
#. fr: Doublons ses PV pour décourager les joueurs, ha ha<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3005:0:1"
msgid "Are you certain this<br>neurolink is on tight?"
msgstr "Ты уверен, что этот<br>нейролинк затянут?"

#. ja: こっちの方が面白い！
#. de: Aber wer würde denn so reagieren?
#. fr: Qu'est-ce que tu penses de ça, plutôt<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3006:0:1"
msgid "What comes after white<br>and black? Red, I say!"
msgstr "А что после белого<br>и чёрного? Красный, говорю!"

#. ja: こっちの方が楽しい！
#. de: Mhigiten sind eben manchmal un<shy>be<shy>rechen<shy>bar!
#. fr: Impossible, beaucoup trop difficile pour les joueurs occasionnels<nbsp>!
msgctxt "Balloon:3007:0:1"
msgid "Red!? Don't you mean blue!?"
msgstr "Красный!? Ты хотел сказать синий!?"

#. ja: フォーラムにこんな意見が！
#. de: Hm, keine schlechte Idee! Das Forum bringt wirklich was.
#. fr: Tu as lu le dernier fil sur le forum<nbsp>? La discussion est animée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3008:0:1"
msgid "What evils would bring<br>together two primals, a<br>behemoth, and a bomb!? "
msgstr "Что за зло могло свести<br>двух праймалов, бехемота<br>и бомбу!?"

#. ja: 次のイベントですが…
#. de: Also wegen dem nächsten Event ... Ich hätte da eine Idee.
#. fr: Bon, qu'est-ce qu'on fait pour le prochain événement saisonnier<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3009:0:1"
msgid "Er......<br>Can I have three guesses?"
msgstr "Э-э...<br>Можно я попробую угадать три раза?"

#. ja: 何体か見当たらないぞ…
#. de: Hier sollten doch viel mehr Monster sein. Wieso sind die jetzt weg?
#. fr: C'est bizarre, j'ai l'impression qu'il en manque... Encore un coup d'un chasseur de mascottes<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3010:0:1"
msgid "Now where did I put that<br>clockwork Doomtrain?"
msgstr "Ну и куда я дел<br>этот заводной Поезд Судного дня?"

#. ja: ヨシダさんはこの先よ！
#. de: Der Produzent ist in seinem Büro. Hast du einen Termin?
#. fr: Vous avez de la chance, monsieur Yoshida est à son bureau<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3011:0:1"
msgid "Abandon all hope,<br>ye who enter here...<br>Oh, I'm only kidding!"
msgstr "Оставь надежду,<br>всяк сюда входящий...<br>Да шучу я!"

#. ja: 次はどんな音を創ろう…♪
#. de: Dröhnend ... oder melodisch? Hmhmhmmm ♪
#. fr: Quelle musique pour le prochain donjon... Plutôt jazz ou plutôt rock<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3012:0:1"
msgid "What!? Did you say some-<br>thing!? I can't hear you!"
msgstr "Что!? Ты что-то сказал?<br>Я не слышу!"

#. ja:  　♪
#. de: 　♪
#. fr: ♪～♪
msgctxt "Balloon:3013:0:1"
msgid "♪～♪"
msgstr "♪～♪"

#. ja: ミニオンに癒やされるとしよう
#. de: Nichts macht einen so froh wie ein süßer Begleiter.
#. fr: Les mascottes sont plus mignonnes les unes que les autres... Il me les faut toutes<nbsp>!
msgctxt "Balloon:3014:0:1"
msgid "I need my daily dose of minions..."
msgstr "Без ежедневной порции миньонов мне не обойтись..."

#. ja: やはりミニオンはいい…
#. de: Als Begleiter sieht einfach alles unglaublich niedlich aus!
#. fr: Mon rêve<nbsp>: pouvoir un jour combattre en équipe avec mes mascottes<nbsp>!
msgctxt "Balloon:3015:0:1"
msgid "Ah, such adorable violence..."
msgstr "Ах, какая милая жестокость..."

#. ja: イヤです…
#. de: Du Ferkel!
#. fr: Euh... On peut pas, on a piscine<nbsp>!
msgctxt "Balloon:3016:0:1"
msgid "Get away!"
msgstr "Отстань!"

#. ja: 海賊ごっこしよーぜー
#. de: Rüpel!
#. fr: On connaît un coin sympa pour jouer à cache-cache.
msgctxt "Balloon:3017:0:1"
msgid "Let's play pirates an' planks!"
msgstr "Давайте играть в пиратов и доски!"

#. ja: 君たち、ほどほどにしなさい！
#. de: Lass uns in Frieden!
#. fr: Si vous ne vous calmez pas, je vais m'occuper de votre cas<nbsp>!
msgctxt "Balloon:3018:0:1"
msgid "Calm down, you!"
msgstr "Успокойся ты!"

#. ja: うるせー、ひっこんでろ！
#. de: Ruhe, sonst setzt's was!
#. fr: Range ce doigt ou je te l'fourre là où je pense<nbsp>!
msgctxt "Balloon:3019:0:1"
msgid "Shut your mouth!"
msgstr "Закрой рот!"

#. ja: なんだとぉ、この野郎？
#. de: Was will der denn?
#. fr: Pour qui y s'prend, lui<nbsp>?
msgctxt "Balloon:3020:0:1"
msgid "What's that!?"
msgstr "Чего!?"

#. ja: なんか文句あんのかぁ？
#. de: Hast du ein Problem?
#. fr: T'as un problème<nbsp>?
msgctxt "Balloon:3021:0:1"
msgid "Got somethin' to say!?"
msgstr "Есть что сказать!?"

#. ja: ガラの悪い人が多いな…
#. de: Komische Typen hier ...
#. fr: C'est vraiment mal fréquenté, ici...
msgctxt "Balloon:3022:0:1"
msgid "Bunch of ne'er-do-wells..."
msgstr "Сборище проходимцев..."

#. ja: ダーリン、怖いわ…
#. de: Schätzchen, ich hab Angst!
#. fr: J'ai peur...
msgctxt "Balloon:3023:0:1"
msgid "Lemoncakes, I'm scared..."
msgstr "Лимонные кексы, мне страшно..."

#. ja: ここなら大丈夫かな…
#. de: Hier wird uns nichts passieren ...
#. fr: Ne t'en fais pas, on est en sécurité ici.
msgctxt "Balloon:3024:0:1"
msgid "We should be fine over here."
msgstr "Здесь с нами ничего не случится."

#. ja: ダーリン、守ってね…
#. de: Hilf mir, Schätzchen!
#. fr: Protège-moi...
msgctxt "Balloon:3025:0:1"
msgid "Never let me go!"
msgstr "Никогда меня не отпускай!"

#. ja: ゴミを片付けなさい！
#. de: Müll aufheben!
#. fr: Ramassez-moi ces détritus<nbsp>!
msgctxt "Balloon:3026:0:1"
msgid "Pick up your garbage!"
msgstr "Уберите за собой мусор!"

#. ja: イチイチうるせーんだよ！
#. de: Halt's Maul.
#. fr: T'as pas un peu fini de nous les briser<nbsp>?
msgctxt "Balloon:3027:0:1"
msgid "Hold yer damn tongue!"
msgstr "Заткнись уже!"

#. ja: かかってこいよ！
#. de: Komm doch her!
#. fr: Viens te battre pour voir<nbsp>!
msgctxt "Balloon:3028:0:1"
msgid "Show me yer moves!"
msgstr "Ну-ка, покажи, на что способен!"

#. ja: やってやろうじゃねぇか！
#. de: Dir zeig ich's, du Knalltüte!
#. fr: Tu vas voir ce que tu vas prendre<nbsp>!
msgctxt "Balloon:3029:0:1"
msgid "Ye got some gall!"
msgstr "Да ты совсем страх потерял!"

#. ja: 美味しかったね～
#. de: Wirklich köstlich ...
#. fr: Ce poisson pané était incroyable<nbsp>!
msgctxt "Balloon:3030:0:1"
msgid "I'm lovin' it!"
msgstr "Объедение!"

#. ja: キレイだよハニー
#. de: Schau doch, Häschen!
#. fr: Tu es encore plus belle que les feux d'artifice<nbsp>!
msgctxt "Balloon:3031:0:1"
msgid "How pretty!"
msgstr "Как красиво!"

#. ja: もう、ダーリンったら
#. de: Diese Farben!
#. fr: Et tu es merveilleux, mon petit apkallu vert des cascades<nbsp>!
msgctxt "Balloon:3032:0:1"
msgid "If it's you..."
msgstr "Если ты..."

#. ja: イテテテテ
#. de: Aua, aua, aua!
#. fr: Ouille ouille ouille<nbsp>!
msgctxt "Balloon:3033:0:1"
msgid "Godsdamn, that smarts!"
msgstr "Чёрт, как больно!"

#. ja: 血だ、血が出てるー！
#. de: Ich blute, ich blute!
#. fr: Du sang, bon sang de bois<nbsp>! Il saigne<nbsp>!
msgctxt "Balloon:3034:0:1"
msgid "Blood, it's blood!"
msgstr "Кровь! Кровь пошла!"

#. ja: キャハハー！
#. de: Ha ha ha!
#. fr: Ha ha ha<nbsp>!
msgctxt "Balloon:3035:0:1"
msgid "Haha!"
msgstr "Ха-ха!"

#. ja: ウフフフ
#. de: He he he!
#. fr: Hu hu hu<nbsp>!
msgctxt "Balloon:3036:0:1"
msgid "Hehehe!"
msgstr "Хи-хи-хи!"

#. ja: いいだろ、子猫ちゃん
#. de: Du bedeutest mir so viel ...
#. fr: Pas mal<nbsp>! Tu trouves pas mon chaton<nbsp>?
msgctxt "Balloon:3037:0:1"
msgid "So, do you like...stuff?"
msgstr "Ну и как тебе... всякое такое?"

#. ja: ヤダも～！
#. de: Ich will doch nur spielen.
#. fr: Tu parrrles...
msgctxt "Balloon:3038:0:1"
msgid "Go away!"
msgstr "Уйди!"

#. ja: ダーリンを独り占めよ
#. de: Ich werde immer für dich da sein, mein Schnuckelchen ...
#. fr: Tu seras toujours à moi, et rien qu'à moi<nbsp>!
msgctxt "Balloon:3039:0:1"
msgid "I'll never give you up!"
msgstr "Никогда тебя не отпущу!"

#. ja: ヒャッハー！
#. de: Wir sind die Geilsten!
#. fr: Wouhou<nbsp>!
msgctxt "Balloon:3040:0:1"
msgid "Mwahah!"
msgstr "Муа-ха-ха!"

#. ja: 祭りだワッショイ！！
#. de: Paaarty!
#. fr: C'est la fêteuuuh<nbsp>! La fêêête<nbsp>!
msgctxt "Balloon:3041:0:1"
msgid "Party time, excellent!"
msgstr "Время вечеринки! Отлично!"

#. ja: キャハハハハー！！
#. de: Iiih, ich bin ja so diiick!
#. fr: Mouah ha ha<nbsp>!
msgctxt "Balloon:3042:0:1"
msgid "How's thiiis!?"
msgstr "Ну как тебе такое!?"

#. ja: わーい、わーい！
#. de: Endlich Sand, Sonne und Salzwasserränder!
#. fr: Géniaaal<nbsp>!
msgctxt "Balloon:3043:0:1"
msgid "Come on, you can jump higher than that!"
msgstr "Давай, ты можешь прыгнуть выше!"

#. ja: いい眺めだわ…
#. de: Das Meer glitzert so wunderschön ...
#. fr: Tiens bon les vannes, et tiens bon les vents...♪
msgctxt "Balloon:3044:0:1"
msgid "The docks are lovely today..."
msgstr "Сегодня в доках чудесно..."

#. ja: 戦いは数だ！<br>物量で一気にいくぜ！
#. de: Gemeinsam sind wir stark! Auf geht's!
#. fr: Le plus important dans une bataille, c'est le nombre<nbsp>! L'union fait la force, comme on dit<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3045:0:1"
msgid "Overwhelming numbers!<br>That's the best strategy!"
msgstr "Чем нас больше, тем лучше!<br>Вот лучшая тактика!"

#. ja: もう少し、引きつけてから…<br>うふふ…♪
#. de: Gleich dreh ich dich durch die Mühle, Freundchen ♪
#. fr: Oh, oui<nbsp>! Avancez encore un peu, mes petits<nbsp>! Vous allez voir le piège que je vous ai tendu<nbsp>! Hihihi<nbsp>!♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3046:0:1"
msgid "I'll let him think he's winning...<br>Then BAM! Hee hee!"
msgstr "Пусть думает, что побеждает...<br>А потом БАЦ! Хе-хе!"

#. ja: 性格が出るなぁ…
#. de: Im Wettkampf zeigt sich der wahre Charakter ...
#. fr: La personnalité des deux adversaires est bien visible...
msgctxt "Balloon:3047:0:1"
msgid "She's usually such a sweet girl..."
msgstr "Вот это характер... Обычно она такая милая..."

#. ja: 構成にもこだわってるの！
#. de: Ich setze ganz auf biologische Kriegsführung.
#. fr: Pour moi, le plus important, c'est la composition de mes troupes<nbsp>!
msgctxt "Balloon:3048:0:1"
msgid "I'm very particular about my forces!"
msgstr "Я и к подбору отряда подхожу со всей тщательностью!"

#. ja: へぇー、どんな風に？
#. de: Was? Das ist sicher gegen die Regeln.
#. fr: C'est-à-dire<nbsp>?
msgctxt "Balloon:3049:0:1"
msgid "Oh? How so?"
msgstr "Да? И как же?"

#. ja: 全部、マンドラーズ！
#. de: Ich meine doch, ich lasse nur Mandragoras kämpfen!
#. fr: Je n'utilise que des membres du gang des légumes<nbsp>!
msgctxt "Balloon:3050:0:1"
msgid "Every minion is a mandragora!"
msgstr "У меня все миньоны — мандрагоры!"

#. ja: それ、強いの…？
#. de: So? Die kompostiere ich doch mit links.
#. fr: Et ça marche<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3051:0:1"
msgid "Uh...<br>And that helps you win?"
msgstr "Э-э...<br>И как это поможет тебе победить?"

#. ja: MGPはたいて交換したんだ<br>頼むぜ、相棒！
#. de: Ich hab meine letzten Ersparnisse in Manderville-Goldpunkte umgetauscht. Enttäusch mich nicht, kleiner Kompagnon!
#. fr: Tu m'as coûté tous mes PGS, alors tu n'as pas le droit de me décevoir, mon petit compagnon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3052:0:1"
msgid "I spent all my MGP<br>on you, mate.<br>So we better win!"
msgstr "Я потратил на тебя все свои MGP,<br>приятель.<br>Так что победа за нами!"

#. ja: カッパーーッ！！
#. de: Kappaaa!
#. fr: Kappaaa<nbsp>!
msgctxt "Balloon:3053:0:1"
msgid "Squeee!"
msgstr "Виии!"

#. ja: やっと、ふたりっきりになれたね
#. de: Endlich sind wir allein ...
#. fr: Enfin seuls<nbsp>!
msgctxt "Balloon:3054:0:1"
msgid "I think we're alone now..."
msgstr "Кажется, мы наконец одни..."

#. ja: 怖いよ～
#. de: Ich will nach Hause.
#. fr: J'ai peur...
msgctxt "Balloon:3055:0:1"
msgid "How horrid..."
msgstr "Какой ужас..."

#. ja: 海に入りたいよ～
#. de: Ich will ins Meer!
#. fr: J'irais bien piquer une tête<nbsp>!
msgctxt "Balloon:3056:0:1"
msgid "I want to get my feet wet!"
msgstr "Хочу окунуть ноги в воду!"

#. ja: 花火楽しみだな～
#. de: Wann fängt das Feuerwerk an?
#. fr: Je me demande à quelle heure ils tirent le feu d'artifice...
msgctxt "Balloon:3057:0:1"
msgid "I love fireworks!"
msgstr "Обожаю фейерверки!"

#. ja: 冒険者さんたちカッコよかった～
#. de: Wenn ich groß bin, möchte ich auch Abenteurerin werden und Piraten versohlen!
#. fr: Ces aventuriers sont tous plus beaux les uns que les autres<nbsp>!
msgctxt "Balloon:3058:0:1"
msgid "I want to be an adventurer!"
msgstr "Хочу стать искателем приключений!"

#. ja: 早くヘンシンさせてよ～
#. de: Schnell, verwandle mich!
#. fr: Alors, quand est-ce qu'on me change en monstre<nbsp>?
msgctxt "Balloon:3059:0:1"
msgid "Hurry! I want to go scare my sister!"
msgstr "Скорее! Хочу пойти пугать сестру!"

#. ja: ねぇねぇ、まだぁ？
#. de: Was ist jetzt mit der Ver<shy>wand<shy>lung?
#. fr: J'en ai assez d'attendre que tu me transformes...
msgctxt "Balloon:3060:0:1"
msgid "Can I have my costume now?"
msgstr "Ну когда уже дадут мой костюм?"

#. ja: まだかなまだかな！
#. de: Bist du endlich so weit?
#. fr: Je vais prendre racine si j'attends plus longtemps<nbsp>!
msgctxt "Balloon:3061:0:1"
msgid "Come on, do it! I'm here! Do it now!"
msgstr "Ну же, давай! Я готов! Прямо сейчас!"

#. ja: ねぇ、ヘンシンはまだ？
#. de: Was ist jetzt mit der Ver<shy>wand<shy>lung?
#. fr: Pourquoi tu me transformes pas<nbsp>?
msgctxt "Balloon:3062:0:1"
msgid "Where. Is. My. Costume!?"
msgstr "Где. Мой. Костюм!?"

#. ja: 早くお菓子ちょーだい！
#. de: Ich will jetzt sofort Süßigkeiten!
#. fr: Il est où mon gâteau<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3063:0:1"
msgid "Sweets! Sweets! <i>Sweeeeeets</i>!"
msgstr "Сладости! Сладости! <i>Сла-а-адости</i>!"

#. ja: さっさとやってよ
#. de: Dalli dalli!
#. fr: Bon, c'est pour aujourd'hui ou pour demain<nbsp>?
msgctxt "Balloon:3064:0:1"
msgid "This better not be a trick!"
msgstr "Это ещё не какая-нибудь ловушка?"

#. ja: これだけありゃ！
#. de: Gold und Silber lieb ich sehr ... ♪
#. fr: On a touché le Cactpot<nbsp>!
msgctxt "Balloon:3065:0:1"
msgid "I love me some plunder..."
msgstr "Обожаю всякую добычу..."

#. ja: ニヒヒ…
#. de: Harhar, das war fast zu einfach.
#. fr: C'était presque trop facile<nbsp>!
msgctxt "Balloon:3066:0:1"
msgid "Too easy!"
msgstr "Проще простого!"

#. ja: オルシュファン…<br>いつも君はそうだ…
#. de: Haurchefant ... Wie trist unser Haus ist,<br>seit du von uns gegangen bist!
#. fr: Sire Haurchefant... Vous nous manquez tellement...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3067:0:1"
msgid "Hello again,<br>old friend..."
msgstr "И снова здравствуй,<br>старый друг..."

#. ja: …君も来たのか<br>忘れ難いな、お互いに
#. de: Es freut mich, dich hier zu sehen. Auch für dich muss es schmerzlich sein ...
#. fr: Tiens... Ça me fait plaisir que vous soyez venu<if $gn4>e</if>.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3068:0:1"
msgid "...It doesn't get any easier,<br>does it."
msgstr "...Ничуть не легче,<br>правда?"

#. ja: うぅ…お家が…<br>燃えちゃったよォ…
#. de: Mein Vater ist noch einmal in das Haus, um mein Wollschaf zu holen ... Doch dann brach das Dach ein ... Buhuhuhu ...
#. fr: Ma maison a brûlé... Que vais-je devenir<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3069:0:1"
msgid "It's...it's all gone.<br>Everything... Gone..."
msgstr "Всё... всё пропало.<br>Всё... исчезло..."

#. ja: 僕が雲霧街を守るんだ！
#. de: Ich werde die Schwaden beschützen!
#. fr: Je protégerai Brouillasse<nbsp>!
msgctxt "Balloon:3070:0:1"
msgid "I have the watch!"
msgstr "Я буду охранять дозор!"

#. ja: なんということだ…
#. de: J-Ja, Weib!
#. fr: Quelle horreur...
msgctxt "Balloon:3071:0:1"
msgid "I...I just don't..."
msgstr "Я... Я просто не..."

#. ja: これからどうするの！<br>アナタ、しっかりして！
#. de: Wir müssen von vorne anfangen! Und du musst doppelt so hart arbeiten wie bisher!
#. fr: Arrête de chouiner<nbsp>! Tu dois te reprendre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3072:0:1"
msgid "Pull yourself together!<br>We'll find a way! We always do!"
msgstr "Возьми себя в руки!<br>Мы что-нибудь придумаем! Как всегда!"

#. ja: 怪しい奴はいないか？
#. de: Wo stecken Eindringlinge?
#. fr: Voyons s'il n'y a pas d'intrus...
msgctxt "Balloon:3073:0:1"
msgid "Something is amiss..."
msgstr "Что-то тут неладно..."

#. ja: さっさ！<br>どんどん食べてくだせ～
#. de: Bäuche grollen, Fische brutzeln, Leben ist schön!
#. fr: Ils sont bons, ces poissons<nbsp>! Ils sont bons<nbsp>!
msgctxt "Balloon:3074:0:1"
msgid "Eat! Eat until stomach swells!"
msgstr "Ешьте! Ешьте, пока животы не лопнут!"

#. ja: エヌバヌ殿の腕前は<br>すばらしいですな！
#. de: Fischers Eenu Vanu-ooh fischt frische Fische ♪
#. fr: Je ne connais pas de meilleur pêcheur qu'Eenu Vanu<nbsp>!
msgctxt "Balloon:3075:0:1"
msgid "Eenu Vanu outdoes himself again!"
msgstr "Эну Вану снова превзошёл самого себя!"

#. ja: そろそろ行くか…
#. de: Dann mal los, oder?
#. fr: Je suis prêt. C'est quand tu veux.
msgctxt "Balloon:3076:0:1"
msgid "Let's be off, eh?"
msgstr "Ну что, пора идти?"

#. ja: よぅ、お前か
#. de: Ah, du bist es.
#. fr: Ah, c'est toi.
msgctxt "Balloon:3077:0:1"
msgid "Ah, it's you."
msgstr "А, это ты."

#. ja: 時には息抜きも必要ってな
#. de: Selbst ein Luftpirat muss von Zeit zu Zeit mal ein wenig ausspannen.
#. fr: Même un pirate des cieux a besoin de souffler de temps en temps.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3078:0:1"
msgid "Even a sky pirate needs<br>a break from excitement.<br>From time to time."
msgstr "Даже небесному пирату иногда<br>нужно передохнуть от приключений.<br>Время от времени."

#. ja: 魔航船のエーテル計測中さ
#. de: Ich nehme Äthermessungen vor. Du weißt schon, wegens des Geisterschiffes!
#. fr: Je prends des mesures. Vous savez, pour suivre le vaisseau fantôme.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3079:0:1"
msgid "I'm taking aether readings.<br>You know, for the ghost ship!"
msgstr "Снимаю показания эфира.<br>Ну, для поисков корабля-призрака!"

#. ja: 数値が少し変化してるんだ…
#. de: Diese Werte ... Sie sind ganz anders als zuvor.
#. fr: Les mesures sont un peu différentes de la dernière fois...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3080:0:1"
msgid "These values...<br>They're different from before."
msgstr "Показания...<br>Они изменились."

#. ja: ヤツの船影は…
#. de: Dieses verdammte Schiff ...
#. fr: Ce maudit vaisseau...
msgctxt "Balloon:3081:0:1"
msgid "That bleedin' ship..."
msgstr "Чёртов корабль..."

#. ja: 噂話も貴重な情報源なの
#. de: Wir leben davon, Gerüchten nachzugehen.
#. fr: Les rumeurs sont notre pain et notre beurre.
msgctxt "Balloon:3082:0:1"
msgid "Rumors are our meat and mead."
msgstr "Слухи — наше мясо и мёд."

#. ja: 横の奴がうるさくて<br>ロクに飲めやしねぇ…
#. de: Bei all dem Geplärre kann ich keinen Schluck genießen ...
#. fr: À quoi ça sert de m'emmener dans une auberge si c'est pour m'interdire de boire<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3083:0:1"
msgid "Can't enjoy me drink with<br>this scrag yappin' in me ear..."
msgstr "С этим треплом рядом<br>и выпить спокойно не дадут..."

#. ja: ほかをあたるぞ
#. de: Hier gibt's nichts zu holen.
#. fr: Bah<nbsp>! Y a rien ici.
msgctxt "Balloon:3084:0:1"
msgid "Bah! This place is dry."
msgstr "Тьфу! Здесь ловить нечего."

#. ja: よし、これでバッチリだぜ！
#. de: Alles paletti!
#. fr: J'adore quand un plan se déroule sans accroc<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3085:0:1"
msgid "I love it when<br>a plan comes together!"
msgstr "Обожаю, когда<br>всё идёт по плану!"

#. ja: いい感じのエモノだぜ！
#. de: Nicht schlecht abgesahnt.<br>Das machen wir öfter!
#. fr: C'est vraiment une belle bête<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3086:0:1"
msgid "Well...it hasn't come<br>together till the beast's<br>in me belly."
msgstr "Ну... План ещё не удался,<br>пока зверь не у меня<br>в животе."

#. ja: あっ、エサ忘れてた<br>なんで捕まってるんだコイツ…
#. de: Gibt's doch nicht! Wieder<br>den Köder vergessen.
#. fr: Tiens<nbsp>? J'avais oublié d'utiliser un appât... Comment j'ai réussi à l'attraper, lui<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3087:0:1"
msgid "I could've sworn I forgot<br>to bait the trap... Oh well."
msgstr "А я-то думал, что забыл<br>положить приманку в ловушку... Ну и ладно."

#. ja: ふぅ、いい仕事したぜ
#. de: Artet ja richtig in Arbeit aus, das mit den Expeditionen.
#. fr: J'ai attrapé quatre gros poissons<nbsp>!
msgctxt "Balloon:3088:0:1"
msgid "Another day's work done."
msgstr "Ещё один рабочий день позади."

#. ja: 順調みたいだな<br>晩メシ、頼むぜ！
#. de: Dann zauber uns mal ein schönes Abendessen!
#. fr: Bien joué<nbsp>! On va se régaler ce soir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3089:0:1"
msgid "I'm so hungry, I could eat...<br>well, almost anything."
msgstr "Я так проголодался, что съел бы...<br>да почти что угодно."

#. ja: うむ、いい風味だ！
#. de: Hm, wie das gut riecht!
#. fr: Mmm<nbsp>! Ça sent bon<nbsp>!
msgctxt "Balloon:3090:0:1"
msgid "That smells heavenly!"
msgstr "Как же вкусно пахнет!"

#. ja: くくく…！
#. de: Schon wieder nichts ...
#. fr: Hé hé hé<nbsp>!
msgctxt "Balloon:3092:0:1"
msgid "Hee hee hee!"
msgstr "Хи-хи-хи!"

#. ja: 神の裁きを受けよ！
#. de: Möge die Furie unsere Schwerter in die Herzen der Häretiker führen!
#. fr: Que la colère de la Conquérante s'abatte sur vous<nbsp>!
msgctxt "Balloon:3093:0:1"
msgid "Heretic! Kinslayer!"
msgstr "Еретик! Убийца родичей!"

#. ja: 戦神よ、我らに力を！
#. de: Halone, sprich dein Urteil!
#. fr: Halone, donne-nous ta force<nbsp>!
msgctxt "Balloon:3094:0:1"
msgid "O Halone, we beseech You!"
msgstr "О Халон, молим Тебя!"

#. ja: 死ねッ！
#. de: Stirb, Verräter!
#. fr: Meurs<nbsp>!
msgctxt "Balloon:3095:0:1"
msgid "Die, damn you, die!"
msgstr "Сдохни, чтоб тебя, сдохни!"

#. ja: 大丈夫ですか？
#. de: Ist alles in Ordnung?
#. fr: Est-ce que ça va<nbsp>?
msgctxt "Balloon:3096:0:1"
msgid "Are you injured?"
msgstr "Вы не ранены?"

#. ja: どうかご安心を…
#. de: Du bist jetzt in Sicherheit.
#. fr: Rassurez-vous, nous sommes là<nbsp>!
msgctxt "Balloon:3097:0:1"
msgid "It's over now..."
msgstr "Всё уже позади..."

#. ja: よくがんばったな…
#. de: Hab keine Angst, es ist vorbei.
#. fr: Ça y est, c'est fini...
msgctxt "Balloon:3098:0:1"
msgid "Fury be praised..."
msgstr "Хвала Фурии..."

#. ja: 通行人に気をつけな！
#. de: Wir kommen schneller voran, als ich dachte.
#. fr: Non, mais fais un peu plus attention aux passants, quand même<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3099:0:1"
msgid "Put your back into it!<br>We've ten score more of<br>these to clear by noon!"
msgstr "Налегай!<br>До полудня надо убрать ещё<br>два десятка таких!"

#. ja: 順調に進んでるね
#. de: Pass auf, dass du keinem auf die Füße klopfst.
#. fr: Il avance plus vite que je ne le croyais...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3100:0:1"
msgid "Why don't we ever hire<br>anyone who can wield<br>cobble-laying magicks?"
msgstr "Почему мы никогда не нанимаем<br>кого-нибудь, кто умеет<br>укладывать мостовую магией?"

#. ja: シュコォ…シュコォ…<br>作れや作れ　大工房～！
#. de: Psh, wird schöne Werkenstätte hier.
#. fr: Pshhh... Pshhh... Les gentils Gobelins auront bientôt leur bel atelier<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3101:0:1"
msgid "Pshkohhh...<br>Bigger! Higher!<br>Build, build, build!"
msgstr "Пшшх...<br>Выше! Крупнее!<br>Строим, строим, строим!"

#. ja: こりゃ大仕事だぜ
#. de: Das sieht nach einer ganzen Menge Arbeit aus.
#. fr: Y a rien de mieux que de voir quelqu'un faire du beau travail.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3102:0:1"
msgid "I've a feeling I'm<br>going to regret taking<br>Lady Rowena's coin..."
msgstr "Чует моё сердце, ещё пожалею,<br>что взял монету леди Ровены..."

#. ja: 僕と結婚できるなんて<br>君は実に幸運だ！
#. de: Bald bist du die Frau eines Barons.<br>Benimm dich auch so.
#. fr: Vous rendez-vous compte de la chance que vous avez de pouvoir vous marier à moi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3103:0:1"
msgid "Your father has already<br>given his consent. We are<br>to be married on the eve<br>of the new moon."
msgstr "Твой отец уже дал согласие.<br>Сыграем свадьбу в ночь<br>перед новолунием."

#. ja: ……光栄です
#. de: ... S-Sehr wohl.
#. fr: Euh... oui, je crois...
msgctxt "Balloon:3104:0:1"
msgid "Yes, my lord."
msgstr "Да, милорд."

#. ja: 家の決めた結婚…<br>受け入れるしかないの？
#. de: Wie soll ich diese Ehe nur ertragen?
#. fr: N'ai-je donc d'autre choix que d'accepter ce mariage arrangé par nos familles<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3105:0:1"
msgid "Why am I not allowed say<br>in mine own affairs...?"
msgstr "Почему я не могу сама<br>решать свою судьбу?.."

#. ja: いいえ…<br>私の宿命ですから…
#. de: ... Wie? Nein, es geht schon. Es muss. Unsere Familien<br>haben diese Ehe beschlossen.
#. fr: Ce n'est rien... Je ne faisais que penser à mon avenir...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3106:0:1"
msgid "I am a woman grown, yet<br>Father would treat me as<br>if I were a swaddling babe."
msgstr "Я уже взрослая, а отец<br>обращается со мной, будто<br>я младенец в пелёнках."

#. ja: お嬢さん、浮かない顔だ<br>お困りごとかい？
#. de: Ist Euch nicht wohl, meine Dame?
#. fr: Qu'est-ce qui vous arrive, Mad'moiselle<nbsp>? Vous en faites une triste mine.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3107:0:1"
msgid "You look pale, milady.<br>Is aught amiss?"
msgstr "Вы бледны, миледи.<br>Что-то случилось?"

#. ja: 俺じゃあ…<br>何もしてやれないのか？
#. de: So gern ich wollte, hier kann ich mich nicht einmischen.
#. fr: Y a-t-il donc rien que j'puisse faire pour l'aider<nbsp>?
msgctxt "Balloon:3108:0:1"
msgid "Might I be of some assistance?"
msgstr "Могу я чем-нибудь помочь?"

#. ja: ゴブリンキャップで<br>みんな　なか～ま！
#. de: Hier in Lager sind alle Freundewerden. Schönezeit!
#. fr: Tous copains grâce au chapeau de Gobelin<nbsp>!
msgctxt "Balloon:3109:0:1"
msgid "A fine gobbiemask, that is!"
msgstr "Славная гоблинская маска!"

#. ja: ゴブリンキャップ！<br>お前も　なか～ま！
#. de: Glaubzzu auch ist ganz mütlich hier? Bleibzzu bisschen, kho!
#. fr: Un chapeau de gobelin<nbsp>! Le petit Lalafell est aussi un gentil Gobelin<nbsp>!
msgctxt "Balloon:3110:0:1"
msgid "A fine gobbiemask, indeed!"
msgstr "Да, славная гоблинская маска!"

#. ja: ゴブリン族の技術を<br>学びたいんだ！
#. de: Die Goblins haben es echt drauf. Was ich hier alles lernen kann!
#. fr: Je veux apprendre les technologies des Gobelins<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3111:0:1"
msgid "I've come from Ul'dah<br>to learn the ways<br>of your people!"
msgstr "Я прибыл из Ульды,<br>чтобы изучить<br>ваши обычаи!"

#. ja: ヒトのお仲間　大歓迎！<br>知識の持ち寄り　大賛成！
#. de: Gobbi haben Offenearm für Großwachsene. Wissen muss verbreitenwerden!
#. fr: Les gentils humains sont bienvenus parmi les Gobelins<nbsp>! Vive les échanges de con<shy>nais<shy>san<shy>ces<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3112:0:1"
msgid "Gobbie mindfruit is ripe<br>for bellyfilling! Here,<br>halflegs! Take a bite!"
msgstr "Угощайся, коротконожка!<br>Наши умные плоды спелые,<br>как раз на живот набить!"

#. ja: …そうかい
#. de: Hmm ...
#. fr: Je vois...
msgctxt "Balloon:3113:0:1"
msgid "Ah... Very well, then."
msgstr "Ах... Ну что ж."

#. ja: お母さん…<br>この日が来たのね！
#. de: Endlich ist es so weit, Mama!
#. fr: Le grand jour est enfin arrivé, Maman<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3114:0:1"
msgid "You'll see, Mother.<br>You'll see."
msgstr "Вот увидишь, мама.<br>Вот увидишь."

#. ja: みんな再出発か…
#. de: Ein Aufbruch zu neuen Ufern also ...
#. fr: C'est un nouveau départ...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3115:0:1"
msgid "Hope it's not<br>like last time..."
msgstr "Надеюсь, на этот раз<br>всё будет иначе..."

#. ja: 竜はまだかなぁ？
#. de: Kommt der Drache bald?
#. fr: Le dragon n'est toujours pas là<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3116:0:1"
msgid "When's the dragon<br>going to come?"
msgstr "Когда же прилетит дракон?"

#. ja: 開催が待ち遠しいわねぇ
#. de: Bin ich zu früh dran? Ich dachte, es geht schon los.
#. fr: Vivement que ça commence<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3117:0:1"
msgid "But what if the baby<br>comes early?"
msgstr "А вдруг ребёнок<br>появится раньше срока?"

#. ja: どんな式典になるのかな
#. de: Ich bin schon so gespannt ...
#. fr: J'ai hâte de voir à quoi ça va ressembler<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3118:0:1"
msgid "What I wouldn't give to<br>look behind the curtain."
msgstr "Вот бы узнать, что там<br>происходит за кулисами."

#. ja: ヤーイヤーイ<br>ジュピー！
#. de: Jaaa! Juhuu!
#. fr: Yahou<nbsp>! Yaha<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3119:0:1"
msgid "Slay the stinky intruders!<br>Ugh, the smell!"
msgstr "Покончим с вонючими чужаками!<br>Фу, да от них разит!"

#. ja: ああ、精鋭を揃えたからな
#. de: Unsere Eliteeinheit ist jedenfalls bereit.
#. fr: Notre troupe d'élite est au complet<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3120:0:1"
msgid "They've a trick or two<br>up their sleeves.<br>I'm sure of it."
msgstr "У них припасена парочка<br>трюков, я уверен."

#. ja: 我々が必ず勝つ！
#. de: Wir müssen gewinnen!
#. fr: Nous ne pouvons pas perdre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3121:0:1"
msgid "Bah! We've the pride<br>of three nations.<br>What have they got!?"
msgstr "Ха! За нами честь<br>трёх государств!<br>А за ними что!?"

#. ja: シシシシシ…<br>ウデキキはさすがだ
#. de: \<klick> \<klack> Der Macher ist ein wahrer Macher!
#. fr: Ksss ksss... Je n'arrive pas à croire ce qu'a accompli Futé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3122:0:1"
msgid "\\<click> \\<click> <br>(You saw it, yes?)"
msgstr "<i>Щёлк-щёлк.</i><br>(Вы же видели, да?)"

#. ja: シシシシシ…<br>ヒトの冒険者には及ばん
#. de: Ohne <if $gn4>die Abenteuerjägerin<else>den Abenteuerjäger</if> macht er aber nicht viel ...
#. fr: Peut-être, mais le disciple ne serait rien sans le maître, ksss...
msgctxt "Balloon:3123:0:1"
msgid "(Hush. The deftarm will hear.)"
msgstr "(Тише. Умелорукий услышит.)"

#. ja: 依頼をこなしたわ
#. de: Auftrag erfüllt!
#. fr: Voilà, mission accomplie.
msgctxt "Balloon:3124:0:1"
msgid "I have fulfilled my duty."
msgstr "Я выполнила поручение."

#. ja: シシシシシ…<br>ご苦労だった
#. de: \<klick> \<klack> Hervorragend. Ich danke dir.
#. fr: Très bien. Nous avons votre récompense, ksss<nbsp>!
msgctxt "Balloon:3125:0:1"
msgid "\\<click> \\<click> Very good. We have your reward."
msgstr "<i>Щёлк-щёлк.</i> Отлично. Награда за вами."

#. ja: で、報酬は？
#. de: Und wo bleibt meine Belohnung?
#. fr: Si c'est encore ces œufs bizarres, vous pouvez vous les garder<nbsp>!
msgctxt "Balloon:3126:0:1"
msgid "It's not gysahl greens, is it?"
msgstr "Только не зелень гизаль, а?"

#. ja: 採れたてのギサールの野菜<br>持ってきたぜ
#. de: Hier, bitte sehr. Frisches Gizar-Kraut für die Gilde!
#. fr: J'ai des in<shy>for<shy>ma<shy>tions qui pourraient intéresser votre guilde.
msgctxt "Balloon:3127:0:1"
msgid "We've come across some news that may interest your guild."
msgstr "Мы узнали кое-что, что может заинтересовать вашу гильдию."

#. ja: シシシシシ…<br>これはウマそうだ
#. de: \<klick> \<klack> Ich werde gleich testen, ob es auch schmeckt.
#. fr: Ksss<nbsp>? Dites-moi, je suis tout ouïe.
msgctxt "Balloon:3128:0:1"
msgid "\\<click> \\<click> Do tell. We are eager to hear it."
msgstr "<i>Щёлк-щёлк.</i> Ну же, расскажите. Нам не терпится узнать."

#. ja: ほう、これは見事だ
#. de: Beeindruckend.
#. fr: Ça alors, im<shy>pres<shy>sion<shy>nant.
msgctxt "Balloon:3129:0:1"
msgid "Well, ain't that somethin'."
msgstr "Вот это да, впечатляет."

#. ja: そこのドラゴン像<br>いいモノだな
#. de: So eine Drachenstatue hätte ich auch gerne.
#. fr: Tiens<nbsp>!? Une statue de dragon, ici<nbsp>?
msgctxt "Balloon:3130:0:1"
msgid "Was that stone dragon always there?"
msgstr "Эта каменная статуя дракона тут всегда стояла?"

#. ja: シシシシシ…<br>ドラゴン族から譲り受けた
#. de: \<klick> \<klack> Die Drachen haben sie uns geschenkt.
#. fr: C'est Futé qui a insisté, en signe de notre nouvelle amitié avec eux, ksss...
msgctxt "Balloon:3131:0:1"
msgid "The dragons permitted us to take it. A sign of parley."
msgstr "Драконы позволили нам её взять. В знак перемирия."

#. ja: ドラゴン族と取引とは！<br>ところで、依頼だが…
#. de: Mit den Drachen Geschäfte machen! Schon verrückt. Apropos Geschäft ...
#. fr: Sacré Futé, il a vraiment accompli l'impossible<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3132:0:1"
msgid "Parley with dragons!? <br>Ne'er thought I'd see the day!"
msgstr "Переговоры с драконами!?<br>Не думал, что доживу до такого!"

#. ja: よう、依頼された火薬だ
#. de: Hier ist die versprochene Lieferung Feuersand.
#. fr: Voilà la poudre que vous avez demandée.
msgctxt "Balloon:3133:0:1"
msgid "Your procurement of firesand has arrived."
msgstr "Твой заказ на огненный песок доставили."

#. ja: シシシシシ…<br>いつも助かる
#. de: \<klick> \<klack> Danke, auf dich ist Verlass.
#. fr: Les Égarés vous remercient, ksss<nbsp>!
msgctxt "Balloon:3134:0:1"
msgid "\\<click> \\<click> The Nonmind are grateful."
msgstr "<i>Щёлк-щёлк.</i> Без общего разума благодарны вам."

#. ja: 頼まれた　金属製品<br>作ったぞ～
#. de: Pssssh ... Gobbi bringen Metallzeug.
#. fr: Pshhh... Pshhh... Le gentil Gobelin est ici pour la livraison de fusils.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3135:0:1"
msgid "Gobbies finish boomstick! <br>New type, more boom!"
msgstr "Гоблины сделали бум-палки!<br>Новая модель, бум сильнее!"

#. ja: シシシシシ…<br>いい出来だな
#. de: \<klick> \<klack> Sieht gut aus.
#. fr: Merci, ksss<nbsp>! Ne bougez pas, je vais chercher vos œufs de nanka.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3136:0:1"
msgid "And we have nanka eggs, special for you. <br>We aged them. Especially juicy."
msgstr "А для тебя у нас яйца нанки.<br>Выдержанные. Особенно сочные."

#. ja: 危険な依頼だが…<br>頼めるか？
#. de: Ich habe einen gefährlichen Auftrag. Kannst du ihn über<shy>nehmen?
#. fr: J'ai une tâche plutôt coton à vous confier. Vous en sentez-vous capables<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3137:0:1"
msgid "Got a dangerous task for ye.  <br>Is the guild up for a challenge?"
msgstr "Есть опасное задание.<br>Гильдия готова испытать себя?"

#. ja: シシシシシ…<br>報酬次第だ
#. de: \<klick> \<klack> Kommt auf die Belohnung an.
#. fr: Tout dépend de ce que vous offrez en échange, ksss...
msgctxt "Balloon:3138:0:1"
msgid "\\<click> \\<click> We do not fear the wilds."
msgstr "<i>Щёлк-щёлк.</i> Мы не боимся диких земель."

#. ja: メンターである俺に<br>なんでも聞きな
#. de: Ich bin jetzt ein <i>Mentor</i>! Wende dich vertrauensvoll an mich, wenn du was wissen willst.
#. fr: Je suis un mentor, et mon rôle c'est d'aider les petits nouveaux comme toi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3139:0:1"
msgid "I am a mentor, my good<br>fellow! And there are no<br>foolish questions!"
msgstr "Я ведь наставник, друг мой!<br>Глупых вопросов не бывает!"

#. ja: よろしくお願いします！
#. de: Jawohl, mein Mentor!
#. fr: <if ($gn11 < 12)><if ($gn11 < 4)>Euh... Vous pouvez m'aider à grandir<nbsp>? Juste de quelques ilms...<else>J'ai tellement de questions... Par où commencer<nbsp>?</if><else><if ($gn11 < 17)>Dans ce cas-là... Vous pourriez me dépanner de quelques milliers de gils<nbsp>?<else>Euh... Vous pouvez m'aider à grandir<nbsp>? Juste de quelques ilms...</if></if>
msgctxt "Balloon:3140:0:1"
msgid "Well, in that case..."
msgstr "Ну, тогда..."

#. ja: 最終訓練がむずかしくて…
#. de: An der letzten Übung beiß ich mir jedes Mal die Zähne aus ...
#. fr: L'exercice final est tellement dur... Je crrrois que j'y arriverai jamais...
msgctxt "Balloon:3141:0:1"
msgid "That final exercise is murderous..."
msgstr "Последнее упражнение просто зверское..."

#. ja: いぎゃぁぁ！<br>助けてくれぇ～！
#. de: Kreisch! Zu Hilfe!
#. fr: Hé<nbsp>! Y a quelqu'un<nbsp>? V'nez m'aider<nbsp>! J-j'commence à avoir une crampe au mollet...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3142:0:1"
msgid "Someone...er...<br>lend me a hand?"
msgstr "Кто-нибудь...<br>поможет мне?"

#. ja: この公園が完成したら<br>うちのガキどもも喜ぶな
#. de: Fast fertig ... Dann sollen die Kinder hier rumtollen, statt mir auf die Nerven zu fallen.
#. fr: J'ai hâte de jouer avec mes gosses ici<nbsp>! Ils ont vraiment besoin de prendre l'air<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3143:0:1"
msgid "They haven't even told<br>me what we're building."
msgstr "Мне даже не сказали,<br>что мы строим."

#. ja: 一緒に研究しませんか～！
#. de: Komm, lass uns die Wissenschaft voranbringen! Wir zeigen dir, wie.
#. fr: Dites, je peux faire des recherches avec vous<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3144:0:1"
msgid "Calling all prospective<br>engineers!"
msgstr "Требуются будущие<br>инженеры!"

#. ja: ヒトとゴブたち手を組んで<br>新たな技術　生み出すぞ～
#. de: Gobbi glaubt auch, meinsam geht viel schneller! Willzu nicht Helfenhand leihen?
#. fr: Pshhhoui<nbsp>!<nbsp>... Si les humains et les Gobelins travaillent main dans la main, ils pourront inventer de nouvelles technologies<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3145:0:1"
msgid "Gobbie mindfruit is ripe<br>for bellyfilling! Come<br>take a bite!"
msgstr "Угощайся! Умные плоды<br>гоблинов поспели,<br>чтобы набить живот!"

#. ja: そこ行く御仁　しばし待て！<br>我らと研究どうだろう？
#. de: Psh, Großwachsener! Willzu auch Denkschale aufhellen? Frohehalde braucht Denkenkraft von viele Leute!
#. fr: Hé, Monsieur<nbsp>! Vous ne voudriez pas vous joindre à nos recherches scien<shy>ti<shy>fi<shy>ques<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3146:0:1"
msgid "Rippling Rainlander! Crave<br>you gobbie clevering?"
msgstr "Эй, волнующийся дождевик!<br>Хочешь поумнеть по-гоблински?"

#. ja: 錬金術をかじった程度だが…
#. de: Ich hab gerade erst mit der Alchemie angefangen. Ist das genug?
#. fr: Euh... J'ai juste quelques bribes de con<shy>nais<shy>san<shy>ces en alchimie...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3147:0:1"
msgid "My mind is a bottomless<br>well waiting to be filled."
msgstr "В моей голове бездонный<br>колодец, ждущий знаний."

#. ja: どんな知識も大歓迎！<br>ゴブリンキャップも即贈呈！
#. de: Psh, brauchzzu gar keine Fahrung. Wird herausfordernde Sache, aber wird schon, kho!
#. fr: Tous les types et niveaux de savoir sont les bienvenus ici<nbsp>! Et les gentils Gobelins offrent des chapeaux à tout le monde.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3148:0:1"
msgid "Uh... Not sure sense is<br>being made...but you can<br>have a gobbiemask!"
msgstr "Э-э... Не уверен, что<br>понял... Ну, держи<br>гоблинскую маску!"

#. ja: ここ、次は何に使うの？
#. de: Was für ein Geschäft sollen wir hier als nächstes aufziehen?
#. fr: Tu sais ce qu'ils veulent faire de cet endroit<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3149:0:1"
msgid "I wonder what Lady Rowena<br>has in store for this place?"
msgstr "Интересно, что леди Ровена<br>задумала для этого места?"

#. ja: ロウェナ様の商談次第ね
#. de: Keine Ahnung. Rowena hat sicher schon was Neues ausgeheckt.
#. fr: Ça dépend des prochains projets commerciaux de madame Rowena.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3150:0:1"
msgid "I heard she's thinking of<br>expanding her selection<br>of Garlean goods..."
msgstr "Слышала, она хочет расширить<br>ассортимент гарлеанских товаров..."

#. ja: ふふ、あんな面白い場所<br>知りませんでした！
#. de: Und ich dachte, ich kenne Ishgard ...<br>Wie aufregend anders es hier ist!
#. fr: Cet endroit est si pittoresque. Je ne l'avais jamais vraiment visité...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3151:0:1"
msgid "I've lived here my whole<br>life, yet there are so many<br>places I've never seen!"
msgstr "Я всю жизнь прожила здесь,<br>а столько мест ещё не видела!"

#. ja: さて…ここで平気かい？
#. de: Geht es dir ein bisschen besser?
#. fr: Je suis content qu'ça vous ait plu.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3152:0:1"
msgid "And I shall show you<br>them all, my lady."
msgstr "Тогда я покажу<br>тебе их все, миледи."

#. ja: ありがとうございます<br>夢みたいに楽しかった…
#. de: Viel besser! Ich danke dir.
#. fr: Cette journée était parfaite. Merci infiniment.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3153:0:1"
msgid "Thank you for allowing a<br>caged songbird to fly free...<br>even if only for an afternoon."
msgstr "Спасибо, что позволили<br>птичке из клетки вырваться...<br>хоть на один день."

#. ja: 鳥籠から羽ばたいて<br>明日も楽しく生きればいい
#. de: Was hindert dich daran, Spaß zu haben?<br>Breite deine Schwingen aus und flieg!
#. fr: C'est votre vie qui s'rait parfaite si vous quittiez votre cage dorée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3154:0:1"
msgid "I did naught but unhinge<br>the lock. It was you who<br>chose to spread her wings."
msgstr "Я только замок отпер.<br>А крылья расправить<br>решила ты сама."

#. ja: でも、家の決め事からは…
#. de: Die Ehe ist beschlossene Sache.<br>Meine Familie würde mir nie verzeihen, wenn ich ...
#. fr: Hélas, je me dois d'obéir à mes parents.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3155:0:1"
msgid "And still, here I am,<br>alighted once again on<br>my father's perch."
msgstr "И всё же я снова<br>вернулась на насест<br>отца..."

#. ja: …もう悲しい顔はするな
#. de: ... Denk einfach nicht mehr daran.
#. fr: J'en peux plus d'vous voir si triste...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3156:0:1"
msgid "Then make this<br>the last time!"
msgstr "Тогда пусть это<br>будет в последний раз!"

#. ja: 今夜0時、建国十二騎士像の<br>真下で君を待つ
#. de: Ich werde heute um Mitternacht<br>vor den Statuen der Zwölf Gründer auf dich warten.
#. fr: Rejoignez-moi à minuit dans le p'tit passage des Architectes. Je vous attendrai<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3157:0:1"
msgid "Meet me tonight beneath<br>the Architects!"
msgstr "Жду тебя сегодня ночью<br>у подножия статуи Архитекторов!"

#. ja: 私はどうすれば…
#. de: Ach, was soll ich bloß tun ...
#. fr: Dois-je partir pour vivre...<nbsp>?
msgctxt "Balloon:3158:0:1"
msgid "Whatever should I do?"
msgstr "И что же мне делать?"

#. ja: 初めて見たときから<br>君を笑顔にしたかったんだ…
#. de: Seit ich dich das erste Mal gesehen habe, wollte ich ein Lächeln auf dein trauriges Gesicht zaubern.
#. fr: Depuis toujours, je ne rêve que d'vous rendre heureuse.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3159:0:1"
msgid "I knew from first we met<br>that we were meant for<br>each other."
msgstr "С первой встречи я знал,<br>что мы созданы друг для друга."

#. ja: このまま君を拐おう<br>ふたりで新天地へ…！
#. de: Wir sollten einfach durchbrennen und irgendwo zu zweit ein neues Leben beginnen!
#. fr: Abdiquez votre nom et le manteau d'la nuit couvrira notre fuite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3160:0:1"
msgid "Come! Let us leave all<br>this behind and start<br>our lives anew!"
msgstr "Пойдём! Оставим всё позади<br>и начнём новую жизнь!"

#. ja: はい…！
#. de: Ja, mein Liebster ...!
#. fr: D... D'accord<nbsp>!
msgctxt "Balloon:3161:0:1"
msgid "Yes, my love! Yes!"
msgstr "Да, любимый! Да!"

#. ja: これは…<br>旦那様に報告せねば！
#. de: Das muss ich dem Herrn Baron berichten!
#. fr: Je dois prévenir mon maître au plus vite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3162:0:1"
msgid "The baronet will wish<br>to know of this treachery!"
msgstr "Баронету нужно<br>сообщить об этой измене!"

#. ja: 野菜の次は…お肉かな…
#. de: Gemüse haben wir, jetzt brauchen wir noch Fleisch ...
#. fr: Nous avons nos sept fruits et légumes... Il ne nous reste plus que la viande.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3163:0:1"
msgid "Mother asked us to fetch<br>mutton and popotoes. She<br>said nothing of honey cakes."
msgstr "Мама попросила нас принести<br>баранину и картошку попото.<br>Про медовые пирожные не говорила."

#. ja: お兄ちゃん、おいしそうな<br>お菓子が売ってるよ！
#. de: Bruderherz, sieh mal, hier gibt es Süßigkeiten zu kaufen!
#. fr: Et les petits gâteaux<nbsp>! On n'oublie pas les petits gâteaux<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3164:0:1"
msgid "Right! She <i>didn't</i> say<br>we <i>couldn't</i> buy any!"
msgstr "Верно! Она же <i>не говорила</i>,<br>что нам <i>нельзя</i> их купить!"

#. ja: こうも、あっさりと？
#. de: Das ging aber flott.
#. fr: Eh ben, ça n'a pas traîné.
msgctxt "Balloon:3165:0:1"
msgid "Well, that was fast."
msgstr "Вот это быстро."

#. ja: 次の区画に進むがいい！
#. de: Los, weiter! Keine Zeit für Pausen!
#. fr: Dépêchez-vous d'aller à la prochaine étape<nbsp>!
msgctxt "Balloon:3166:0:1"
msgid "Proceed to the next quarter!"
msgstr "Переходите в следующий квартал!"

#. ja: 訓練はまだまだ続くぞ！
#. de: Das war nur die Aufwärmübung!
#. fr: L'en<shy>traî<shy>ne<shy>ment n'est pas fini<nbsp>! Loin de là<nbsp>!
msgctxt "Balloon:3167:0:1"
msgid "Keep goin', keep goin'!"
msgstr "Продолжайте, не останавливайтесь!"

#. ja: 弟よ、無事か…？
#. de: Bruder ... Verzeih mir ...
#. fr: Désolé... Frérot...
msgctxt "Balloon:3168:0:1"
msgid "Brother! Pull yourself together!"
msgstr "Брат! Держись!"

#. ja: あ、兄者…<br>どうにか生きてるよ
#. de: Uff ... Lebe ich noch?
#. fr: Ah, cette défaite fait plus mal que n'importe quel coup...
msgctxt "Balloon:3169:0:1"
msgid "Somehow I'm still alive..."
msgstr "Кажется, я ещё жив..."

#. ja: いくぞッ！
#. de: Nimm das!
#. fr: À l'attaque<nbsp>!
msgctxt "Balloon:3170:0:1"
msgid "You're mine!"
msgstr "Ты мой!"

#. ja: 喰らえッ！
#. de: Jetzt gehörst du mir!
#. fr: Et paf<nbsp>! Dans les dents<nbsp>!
msgctxt "Balloon:3171:0:1"
msgid "Taste the cold steel!"
msgstr "Попробуй-ка холодную сталь!"

#. ja: 逃がすかッ！
#. de: So kommst du mir nicht davon!
#. fr: N'espérez pas m'échapper<nbsp>!
msgctxt "Balloon:3172:0:1"
msgid "I won't let you get away!"
msgstr "Не уйдёшь!"

#. ja: 我が秘剣、<br>見切れるかな？
#. de: Na warte ... <i>dem</i> hier kannst du garantiert nicht ausweichen!
#. fr: Saurez-vous éviter ma botte secrète<nbsp>? Hé hé hé<nbsp>!
msgctxt "Balloon:3173:0:1"
msgid "You're bold to take on the 'Cudas!"
msgstr "Смело с вашей стороны связываться с «Кудами»!"

#. ja: 影に怯えるがいい！
#. de: Pass auf, <if $gn4>die<else>der</if> ist richtig hinterlistig!
#. fr: Qui n'a pas peur de ce qui se tapit dans l'ombre<nbsp>?
msgctxt "Balloon:3174:0:1"
msgid "Ware those who lurk in the shadows!"
msgstr "Бойтесь тех, кто таится во мраке!"

#. ja: 今だッ！
#. de: Jetzt!
#. fr: Maintenant<nbsp>!
msgctxt "Balloon:3175:0:1"
msgid "Now!"
msgstr "Сейчас!"

#. ja: 俺のナイフから<br>逃れられるものかよ！
#. de: Spür meine Klingen!
#. fr: Mes dagues frappent toujours leur cible<nbsp>!
msgctxt "Balloon:3176:0:1"
msgid "Feel my blades' sting!"
msgstr "От моих клинков не уйти!"

#. ja: お、お見事…
#. de: U-Unglaublich ...
#. fr: Incroyable...
msgctxt "Balloon:3177:0:1"
msgid "I-Incredible..."
msgstr "Н-невероятно..."

#. ja: 影では、光に<br>敵わないということか…
#. de: Wir sind zu weich geworden ...
#. fr: La lumière est-elle donc plus forte que l'ombre<nbsp>?<nbsp>...
msgctxt "Balloon:3178:0:1"
msgid "We've grown...too complacent..."
msgstr "Мы... слишком расслабились..."

#. ja: 圧倒的じゃないか…
#. de: Boah ... \<stöhn>
#. fr: Quelle force<nbsp>!<nbsp>...
msgctxt "Balloon:3179:0:1"
msgid "Isn't this a bit excessive?"
msgstr "Не слишком ли это жестоко?"

#. ja: いっくぞー！
#. de: Na los, komm doch!
#. fr: Je vous attends de pied ferrrme<nbsp>!
msgctxt "Balloon:3180:0:1"
msgid "Have at you!"
msgstr "Ну, получай!"

#. ja: どっせーい！
#. de: Das war's!
#. fr: Jusqu'à ce que la merrr nous engloutisse tous<nbsp>!
msgctxt "Balloon:3181:0:1"
msgid "Come on, is that all you've got?"
msgstr "И это всё, на что ты способен?"

#. ja: うおおおお！<br>本気でいくよ！
#. de: Raarrggh! Jetzt ist die Schonzeit vorbei!
#. fr: Raaarrrgh<nbsp>! Je suis échauffée, désorrrmais<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3182:0:1"
msgid "Raaargh!<br>I'm all fired up!"
msgstr "Ррра-а-а!<br>Я вся горю!"

#. ja: 吹き飛べッ！
#. de: Mmrrruaaaah!
#. fr: Je vais vous balayer<nbsp>!
msgctxt "Balloon:3183:0:1"
msgid "I'll blow you away!"
msgstr "Сейчас снесу тебя!"

#. ja: あたしの斧は…<br>海をも断つ！
#. de: Meine Axt zerteilt den Feind wie ein Schiffskiel die Wellen!
#. fr: Ma hache... peut même fendre la mer<nbsp>!
msgctxt "Balloon:3184:0:1"
msgid "The waves part to my cleave!"
msgstr "Волны расступаются перед моей секирой!"

#. ja: 奥にいるヘタレだけには、<br>負けるんじゃないよ…
#. de: Verlier nachher bloß nicht gegen diesen schwachbrüstigen Pomade-Piraten, sonst polier ich euch beiden die Visage.
#. fr: Promettez-moi de mettre une bonne déculottée à celui qui vous attend plus loin.
msgctxt "Balloon:3185:0:1"
msgid "Promise me ye won't lose to that perfumed sack o' shite up ahead."
msgstr "Пообещай, что не проиграешь тому напомаженному ублюдку впереди."

#. ja: フッ…この戦い、<br>参考になりましたよ
#. de: Nicht übel. Von dir kann man sich einiges abschauen.
#. fr: Hé hé<nbsp>! Merci pour cette jolie dé<shy>mon<shy>stra<shy>tion de force.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3186:0:1"
msgid "This has been very...informative.<br>Until next time."
msgstr "Это было... познавательно.<br>До следующей встречи."

#. ja: このように気持ちの良い戦<br>実に久方ぶりでしたぞ！
#. de: Harharhar! \<schnauf><br>So gut habe ich mich schon lange nicht mehr gefühlt!
#. fr: Ha<nbsp>! Quelle joie<nbsp>! Ce combat m'a rappelé le bon vieux temps<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3194:0:1"
msgid "Bwahahaha!<br>Seems like ages since I felt this alive!"
msgstr "Бвахахаха!<br>Давно я не чувствовал себя таким живым!"

#. ja: エインザル、大丈夫か？<br>まったく無茶をしてくれる…
#. de: Tja, es ist ja unmöglich, dir auszureden, was du dir einmal in den Kopf gesetzt hast, Eynzahr ...
#. fr: Vous n'êtes pas blessé au moins, Eynzahr<nbsp>? Vous vous en êtes vraiment donné à cœur joie...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3195:0:1"
msgid "Well fought. Mayhap you will<br>have the pleasure of<br>facing me one day."
msgstr "Отлично сражался. Может, однажды<br>нам выпадет удовольствие<br>сойтись в бою."

#. ja: アジトを狙う船影は…
#. de: Hat es das Schiff auf das Versteck abgesehen?
#. fr: <if ($gn11 < 12)><if ($gn11 < 4)>Vous voyez quelque chose, vous<nbsp>?<else>Aucun vaisseau ennemi à l'horizon...</if><else><if ($gn11 < 17)>Le ciel est bien calme aujourd'hui...<else>Vous voyez quelque chose, vous<nbsp>?</if></if>
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3196:0:1"
msgid "You see that shadow?<br>Airship? Or bird?"
msgstr "Видишь там тень?<br>Дирижабль? Или птица?"

#. ja: 英気を養ってるのさ
#. de: Ich sammle neue Energie.
#. fr: Je fais le plein d'énergie avant de repartir à l'aventure.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3197:0:1"
msgid "Need to save my strength.<br>Haulin' treasure's hard work,<br>you know!"
msgstr "Надо поберечь силы.<br>Сокровища-то тащить тяжело!"

#. ja: おたから…いっぱ…Zzz
#. de: So viele ... Schätze ... \<hicks>
#. fr: À moi les trésors... d-des cieux... Hic<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3198:0:1"
msgid "Zzz... Gold...<br>Lovely, glitterin' gold..."
msgstr "Хр-р... Золото...<br>Блестящее, чудесное золото..."

#. ja: 羽根でも伸ばしにきたか？
#. de: Kommst du, um mir Ge<shy>sell<shy>schaft zu leisten?
#. fr: Tu viens me tenir compagnie<nbsp>?
msgctxt "Balloon:3199:0:1"
msgid "Come to stretch your wings?"
msgstr "Пришёл расправить крылья?"

#. ja: ま、ノンビリしていけや
#. de: Ruh dich doch mal aus!
#. fr: Bon, je te laisse. À plus<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3200:0:1"
msgid "Take a seat, eh?<br>Put your feet up."
msgstr "Присядь, а?<br>Отдохни немного."

#. ja: みんな、汚しすぎだよ
#. de: Immer diese Maschinenöl-Flecken.
#. fr: Des taches d'huile<nbsp>! Encore et toujours des taches d'huile<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3201:0:1"
msgid "How do they get<br>so damn <i>muddy</i>!?"
msgstr "Да почему они все<br>такие <i>грязные</i>!?"

#. ja: 最後の追い込みだ<br>間に合わせるぞ！
#. de: Es ist nicht mehr weit. Gleich haben wir's!
#. fr: On y est presque<nbsp>! Dépêche-toi de descendre toutes ces caisses<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3202:0:1"
msgid "A full sixmoon of toil, and I<br>still haven't a gil to me name!"
msgstr "Шесть лун вкалывал, а у меня<br>до сих пор ни гроша за душой!"

#. ja: おう、力仕事は任せろ！
#. de: Sag, wenn ich dir was abnehmen kann.
#. fr: Dis, c'est moi, ou on entend une voix dans l'escalier<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3203:0:1"
msgid "Yet the young maid at the<br>tavern seems to be faring<br>well, I see. Heh heh."
msgstr "А молодая служанка в таверне,<br>судя по всему, живёт припеваючи.<br>Хе-хе."

#. ja: た、たまりませんなぁ
#. de: Pass auf, jetzt kommt die Manderville-Pulverschneebombe!
#. fr: J-je suis touché en plein cœur...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3204:0:1"
msgid "C-Careful, my dear,<br>that one was a bit<br>below the belt..."
msgstr "О-осторожнее, дорогая,<br>этот удар пришёлся<br>чуть ниже пояса..."

#. ja: ラブリービーム！
#. de: Triff mich doch, wenn du kannst!
#. fr: Jet de bisous<nbsp>!
msgctxt "Balloon:3205:0:1"
msgid "Pow! Right in the kisser!"
msgstr "Бум! Прямо в губы!"

#. ja: なるほど…
#. de: Äh ...
#. fr: Eh bien dites donc...
msgctxt "Balloon:3206:0:1"
msgid "Fascinating..."
msgstr "Любопытно..."

#. ja: 『現代の錬金術入門』？<br>怪しい本ね…
#. de: „Einführung in die moderne Alchemie“? Hmm ...
#. fr: Un manuel d'in<shy>tro<shy>duc<shy>tion à l'alchimie<nbsp>? Bizarre...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3207:0:1"
msgid "<i>Alchemy 101</i>?<br>Are there a hundred<br>other such tomes?"
msgstr "<i>Алхимия для начинающих</i>?<br>И что, есть ещё<br>сотня таких книг?"

#. ja: か、火力なら！<br>じ、自信ありますっ！
#. de: D-Das mach ich schon!
#. fr: J-j'ai c-confiance en m-moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3208:0:1"
msgid "If you need brute strength,<br>then I'm your girl!"
msgstr "Если нужна грубая сила,<br>я тут как раз пригожусь!"

#. ja: く、くそう…<br>震えが止まらない…
#. de: Verdammt, wieso zittere ich so ...
#. fr: Il faut que j'arrête de trembler...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3209:0:1"
msgid "The Fury aid me...<br>I cannot stop shaking..."
msgstr "Матерь-Кристалл, помоги...<br>Не могу перестать дрожать..."

#. ja: 皇都に残る家族のため<br>必ず守りきる！
#. de: Wir werden die Stellung halten! Für unsere Heimat und unsere Familien!
#. fr: Pour notre patrie et nos familles<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3210:0:1"
msgid "Come, then, you fiends!<br>I'll not let my family burn!"
msgstr "Ну, подходите, твари!<br>Не дам сжечь мою семью!"

#. ja: 厳しい訓練の成果を<br>見せる時だぞ！
#. de: Das ist der Moment, auf den ich mich so lange vorbereitet habe.
#. fr: Toutes ces années d'en<shy>traî<shy>ne<shy>ment vont enfin payer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3211:0:1"
msgid "When they come at you,<br>remember your drills."
msgstr "Когда они нападут,<br>вспоминайте тренировки."

#. ja: しっかりしろ！<br>おのれ、邪竜め…！
#. de: Nur nicht verzagen! Nidhoggs Ende ist nah!
#. fr: Ta fin est proche, Nidhogg<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3212:0:1"
msgid "Stay with me!<br>...Damnable dragons."
msgstr "Держись!<br>Проклятые драконы..."

#. ja: レミーユ号の調子はどうだ？
#. de: Ist das Schiff in Ordnung?
#. fr: Tu t'occupes bien de ma petite Raimille, d'accord<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3213:0:1"
msgid "How's the <i>Raimille</i> lookin'?"
msgstr "Как там <i>Рэмий</i>?"

#. ja: あたしが整備してるんだ<br>もちろん問題なしだぜ！
#. de: Klar doch, Käpt'n! Schließlich habe <i>ich</i> es gewartet!
#. fr: Ne t'inquiète pas, je la bichonne comme une reine<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3214:0:1"
msgid "In great shape, Captain!<br>Not a squeak to be heard!"
msgstr "В полном порядке, капитан!<br>Ни скрипа, ни стука!"

#. ja: 愛機はいつも万全に、ってな…
#. de: Schon gut, schon gut.
#. fr: Cet aéronef est ma fierté et je tiens à ce qu'il soit toujours impeccable.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3215:0:1"
msgid "Have to keep my girl<br>in perfect condition..."
msgstr "Надо держать мою девочку<br>в идеальном состоянии..."

#. ja: よし、いつでも飛べそうだ
#. de: Von mir aus können wir los.
#. fr: Parfait<nbsp>!  Nous sommes prêts à décoller à tout moment<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3216:0:1"
msgid "We're ready to<br>fly at any time!"
msgstr "Мы готовы<br>вылететь в любой момент!"

#. ja: ムム、怪しい奴…
#. de: Komischer Trupp ...
#. fr: C'est louche tout ça...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3217:0:1"
msgid "Hmm... Odd<br>little bugger..."
msgstr "Хм... Странная<br>маленькая букашка..."

#. ja: 帰りはまだかなー
#. de: Pshh, kommt noch immer nicht ...
#. fr: Pssshhhh, y a quelqu'un<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3218:0:1"
msgid "Wherefore art thou,<br>Inspector Cyr..."
msgstr "Ну где же ты,<br>инспектор Сир..."

#. ja: 事件屋キールさーん
#. de: Großwachsener Cyr! Kommzu schnell raus! Gibt Heimnis für Spürennase!
#. fr: Le gentil Gobelin a quelque chose à dire à monsieur Cyr, pshhh<nbsp>!
msgctxt "Balloon:3219:0:1"
msgid "Inspector Cyr! Inspector Cyr!"
msgstr "Инспектор Сир! Инспектор Сир!"

#. ja: 外出中かしら？
#. de: Psh ... Ist vielleicht spazierenwandern?
#. fr: Les humains sont pro<shy>ba<shy>ble<shy>ment sortis... Pshhh...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3220:0:1"
msgid "Pshhh... Shkohhh...<br>Still out and about?"
msgstr "Пшшш... Шкохх...<br>Всё ещё не вернулся?"

#. ja: 仲良く皆が集う場所<br>大きな会館　作るのだ～
#. de: Hier wird Ort für Versammeln. Ist wichtig für meinsame Fühl!
#. fr: Pshhh... Les gentils Gobelins et les humains doivent construire un grand bâtiment pour faire la fête<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3221:0:1"
msgid "The trading of tongueflaps<br>is of frontmost import!<br>A place of trading them<br>is of middlemost!"
msgstr "Болтать языками<br>важнее всего!<br>Нужно место,<br>чтоб болтать!"

#. ja: ムレるな…
#. de: Puh, anstrengend.
#. fr: Fiouu... Fait pas froid, ici<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3222:0:1"
msgid "It's hotter than Ifrit's arse<br>after a peck of dragon peppers."
msgstr "Жарче, чем у Ифрита под хвостом<br>после горсти драконьего перца."

#. ja: トンテン　カンテン♪<br>叩いてゴブゴブ～♪
#. de: Arbeit mit Eigenehand bringt Freude in Herz ♪
#. fr: Pshhhla, la, la, la...♪<br>Un Gobelin qui travaille est un Gobelin heureux...♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3223:0:1"
msgid "Smack whack crack<br>wham bang bonk boom!<br>Gob building new fancy room!"
msgstr "Стук да бряк,<br>бум да бах!<br>Гоблин строить комнату!"

#. ja: 昇降装置　運転中…<br>底の底まで　まっさかさま
#. de: Boden für rauf und runterfahren. Ganz Schlauesache, kho!
#. fr: Le monte-charge génial est en marche<nbsp>! Pshhh... Et tout au fond, c'est tout à l'envers<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3224:0:1"
msgid "Pshkohhh...<br>Lower! Deeper!<br>Drop, drop, drop!"
msgstr "Пшкохх...<br>Ниже! Глубже!<br>Вниз, вниз, вниз!"

#. ja: シュコォ…シュコォ…<br>次のお題は　知の宝庫…
#. de: Hier baut Ort für Schatzfinden. Psh, nicht Klimmbimm! Schatz in Denkschale!
#. fr: Pshhhmm... Maintenant, il faut bâtir un temple du génie gobintellectuel<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3225:0:1"
msgid "Pshhh... Shkohhh...<br>Brainfruit must have<br>proper lockbox."
msgstr "Пшшш... Шкохх...<br>Мозговой плод<br>нужен запирать!"

#. ja: んとねぇ、ボクちん<br>裁縫師だけどいーい？
#. de: Braucht ihr Weber? ... Nein?
#. fr: Hmm... oui<nbsp>? Mais je suis couturier, voyez-vous<nbsp>?<nbsp>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3226:0:1"
msgid "This smells like a revolution.<br>Is this a revolution? Can we<br>make it a revolution?"
msgstr "Пахнет революцией.<br>Это революция? А можно<br>устроить революцию?"

#. ja: あの女ッ…<br>僕から逃げるとは！
#. de: Dieses undankbare Weib! Läuft mir doch einfach davon!
#. fr: Sale petite pimbèche<nbsp>! Comment ose-t-elle s'enfuir<nbsp>!?<nbsp>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3227:0:1"
msgid "How dare that harlot spurn<br>me for a filthy commoner!"
msgstr "Как смеет эта потаскушка<br>променять меня на грязного простолюдина!"

#. ja: 旦那様、ふたりは<br>イディルシャイアかと…
#. de: Mein Herr, wir denken, sie sind nach Frohehalde geflohen.
#. fr: Sire, elle est apparemment partie vers Idyllée avec... avec un gueu...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3228:0:1"
msgid "I have brought milord a<br>man who claims he can<br>be of help...for a price."
msgstr "Я привёл к вам человека,<br>милорд. Он утверждает,<br>что может помочь... за плату."

#. ja: お前ら、女を連れ戻せ！
#. de: Na, dann holt sie mir zurück! Los, los, los!
#. fr: Je ne tolèrerai pas un tel affront<nbsp>! Vous deux, ramenez-la-moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3229:0:1"
msgid "Coin is no object. I only<br>wish the lady returned<br>unharmed. As for the cur...<br>do with him as you see fit."
msgstr "Денег не жалеть. Верните даму<br>невредимой. А с этим псом...<br>поступайте как знаете."

#. ja: 承知した<br>報酬分は働こう…
#. de: Jawohl! (Die Belohnung ist ja nicht zu verachten.)
#. fr: Bien sûr<nbsp>! Vous en aurez pour votre argent<nbsp>!
msgctxt "Balloon:3230:0:1"
msgid "Yes, yer lordship."
msgstr "Будет сделано,<br>ваша милость."

#. ja: ハッハッハ、効きませんぞ～
#. de: Ha ha ha, guter Wurf, meine Liebe!
#. fr: Ha ha ha, même pas mal<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3231:0:1"
msgid "Come now, you'll have<br>to do better than that!"
msgstr "Ну же, постарайся получше!"

#. ja: 敵が来たら<br>僕が応戦します！
#. de: Wenn sie kommen, halte ich sie auf!
#. fr: Je m'occupe des ennemis si jamais il en vient d'autres.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3232:0:1"
msgid "If they come again,<br>I will handle them!"
msgstr "Если они вернутся,<br>я с ними разберусь!"

#. ja: よ、酔ったみたいくぽ…
#. de: Uff ...
#. fr: J-je vais vomir, kuppo...
msgctxt "Balloon:3233:0:1"
msgid "The world just keeps on spinning and spinning, kupo..."
msgstr "Мир всё кружится и кружится, купо..."

#. ja: クラクラするくぽぉ
#. de: Puh, ist mir vielleicht schwindlig.
#. fr: J'ai la tête qui touuuurne...
msgctxt "Balloon:3234:0:1"
msgid "I think I'm going to be sick, kupo..."
msgstr "Кажется, меня сейчас стошнит, купо..."

#. ja: なぜだ…<br>金も身分もあるのに…
#. de: Wieso?! Du hattest doch alles! Alles hätte ich dir gegeben! ...
#. fr: Je ne comprends pas<nbsp>! J'ai pourtant tout ce dont on peut rêver<nbsp>!<nbsp>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3235:0:1"
msgid "She will come to her<br>senses once she realizes<br>she has no other choice."
msgstr "Она образумится, когда поймёт,<br>что другого выхода у неё нет."

#. ja: 旦那様…
#. de: Mein Herr ... Es ist nicht Eure Schuld.
#. fr: Ce n'est pas votre faute, Sire...
msgctxt "Balloon:3236:0:1"
msgid "Of course, Milord."
msgstr "Разумеется, милорд."

#. ja: 女をよこしてもらうぞ
#. de: Gib sie heraus, du dreckiger Lump!
#. fr: Rends-nous la fille, si tu ne veux pas que je te tire une <i>bulette</i> pour te faire <i>bobo</i><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3237:0:1"
msgid "Hand over the lass and<br>we can all go home happy."
msgstr "Отдай девушку,<br>и все разойдёмся по-хорошему."

#. ja: 渡すものか、絶対に！
#. de: Niemals! Lieber sterbe ich!
#. fr: Plutôt mourir<nbsp>!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3238:0:1"
msgid "Tell the baronet to come<br>here and face me himself!"
msgstr "Скажи баронету, пусть сам<br>явится сюда и ответит мне!"

#. ja: どうしよう…<br>お金が足りないよ
#. de: Was jetzt? Wir haben keinen Gil in der Tasche.
#. fr: Qu'allons-nous faire sans argent<nbsp>?<nbsp>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3239:0:1"
msgid "We haven't the coin to<br>buy the mutton! If Mother<br>learns of this, she'll take<br>the switch to both of us!"
msgstr "Нам не хватит монет<br>на баранину! Если мама узнает,<br>она нас обоих высечет!"

#. ja: 帰って正直に話そう<br>母上も心配してるはずさ
#. de: Lass uns zurückkehren. Mutter wird es schon verstehen.
#. fr: Rentrons à la maison et racontons tout. Mère doit se faire un sang d'encre à notre sujet.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3240:0:1"
msgid "I <i>told</i> you we shouldn't<br>have gotten those honey cakes!"
msgstr "Я же <i>говорил</i>, не надо было<br>покупать эти медовые пирожки!"

#. ja: うん…
#. de: Das hoffe ich ...
#. fr: Tu as raison...
msgctxt "Balloon:3241:0:1"
msgid "Now what do we do...?"
msgstr "И что теперь делать?.."

#. ja: 例の子が、夜の公園で<br>泣いてるらしい…
#. de: Das Mädchen, du weißt schon - sie geht jede Nacht in den Park und weint, hab ich gehört.
#. fr: Tu sais, cette gamine, eh ben, il paraît qu'elle pleure dans le parc tous les soirs...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3242:0:1"
msgid "There's a poor girl what<br>weeps by the fountain<br>every night..."
msgstr "Там одна бедная девочка<br>каждую ночь плачет у фонтана..."

#. ja: もういいの…<br>だから、これ以上は…！
#. de: Sag doch so etwas nicht!
#. fr: Non, ne dis pas ça<nbsp>!<nbsp>... Tout est de ma faute<nbsp>!<nbsp>...
msgctxt "Balloon:3243:0:1"
msgid "Enough! I beg of you!"
msgstr "Хватит! Прошу тебя!"

#. ja: パパとママ…<br>今日も帰ってこなかった
#. de: Mama und Papa sind heute wieder nicht zurückgekommen ...
#. fr: Papa et maman ne sont pas revenus... aujourd'hui non plus...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3244:0:1"
msgid "Mama and Papa...<br>They still haven't come back."
msgstr "Мама и папа...<br>Они и сегодня не вернулись."

#. ja: キュイ…
#. de: Fiep ...
#. fr: Miii...
msgctxt "Balloon:3245:0:1"
msgid "Meep..."
msgstr "Мип..."

#. ja: モグジンは<br>どこ行ったくぽ？
#. de: Wo steckt Mogzin?
#. fr: Où est passé Mogzin, kuppo<nbsp>?
msgctxt "Balloon:3246:0:1"
msgid "Have you seen Master Mogzin? He owes me kupo nuts!"
msgstr "Ты не видел мастера Могзина? Он должен мне купо-орехи!"

#. ja: いい気持ちくぽ…ぐぅ
#. de: Dumdidum, kupo ♪
#. fr: Je me sens tellement bien, kuppo...
msgctxt "Balloon:3247:0:1"
msgid "Ah... That feels good..."
msgstr "Ах... Как хорошо..."

#. ja: 広場の外は危険くぽ！
#. de: Draußen ist es gefährlich!
#. fr: Attention aux monstres qui rôdent près de l'esplanade, kuppo<nbsp>!
msgctxt "Balloon:3248:0:1"
msgid "Step outside Bahrr Lehs at your own peril, kupo!"
msgstr "Выйдешь из Бахр Лехс — пеняй на себя, купо!"

#. ja: とっても難しいくぽ…
#. de: Puh, wie schwierig, kupo!
#. fr: C'est plus difficile que je pensais, kuppo...
msgctxt "Balloon:3249:0:1"
msgid "So hot... So tired..."
msgstr "Так жарко... Так устал..."

#. ja: 気合いが足りん！<br>もっと力を込めるんだ！
#. de: Los, strengt euch ein bisschen an!
#. fr: Un peu plus d'entrain, voyons<nbsp>!
msgctxt "Balloon:3250:0:1"
msgid "Come on, put your pom into it!"
msgstr "Давайте, вложите в работу душу!"

#. ja: そこはもっと丁寧に！
#. de: Etwas genauer arbeiten!
#. fr: Douuucement... Voilà...
msgctxt "Balloon:3251:0:1"
msgid "No, not there, not there!"
msgstr "Нет, не там, не там!"

#. ja: そこ、歪んでるくぽ！
#. de: Aber es ist doch verbogen, kupo ...
#. fr: Ça ne va pas<nbsp>! Plus droit, kuppo<nbsp>!
msgctxt "Balloon:3252:0:1"
msgid "Hmmm... That doesn't look right..."
msgstr "Хм... Что-то тут не так..."

#. ja: …水平は取れてるくぽ？
#. de: Ist es jetzt gerade?
#. fr: À l'horizontale, kuppo<nbsp>! Ce n'est pourtant pas compliqué...
msgctxt "Balloon:3253:0:1"
msgid "Does that look level to you, kupo?"
msgstr "Ровно получилось, купо?"

#. ja: ここは暖かいくぽ…ぐぅ
#. de: So schön warm, kupo ...
#. fr: Quelle chaleur agréable, kuppo...
msgctxt "Balloon:3254:0:1"
msgid "So warm, kupo. It's like there's a fire in your belly."
msgstr "Тепло, купо. Будто в животе огонь горит."

#. ja: みんなで遊ぶくぽー♪
#. de: Lasst uns spielen ♪
#. fr: Allez, tous avec moi, kuppo<nbsp>!♪
msgctxt "Balloon:3255:0:1"
msgid "I can just lose myself in the music, kupo!"
msgstr "Под эту музыку я обо всём забываю, купо!"

#. ja: これはなかなか難しいな
#. de: Langsam geb ich auf ...
#. fr: On a l'air malins comme ça...
msgctxt "Balloon:3256:0:1"
msgid "Is it twirl, jump, twirl or twirl, twirl, jump?"
msgstr "То ли крутануться, прыгнуть и снова крутануться, то ли дважды крутануться и прыгнуть?"

#. ja: 踊るモーグリかわいい…
#. de: Süß, wie die Mogrys tanzen.
#. fr: Les Mogs célestes dansent si bien<nbsp>!
msgctxt "Balloon:3257:0:1"
msgid "Have you ever seen something so heartwarming?"
msgstr "Ты когда-нибудь видел что-нибудь такое трогательное?"

#. ja: くたびれたくぽ…
#. de: Puh, kupo ...
#. fr: Je suis tout raplapla, kuppo...
msgctxt "Balloon:3258:0:1"
msgid "I...I can't feel my pom, kupo."
msgstr "Я... я помпон не чувствую, купо."

#. ja: 少し休まないと<br>キツいくぽぉ
#. de: Bitte eine Pause, kupo ...
#. fr: Laissez-moi... reprendre... mon souffle... kuppo<nbsp>!
msgctxt "Balloon:3259:0:1"
msgid "I'll let you guys finish the rest."
msgstr "Дальше заканчивайте сами."

#. ja: あとはみんなに<br>任せたくぽぉ
#. de: Ich mag nicht mehr ... \<hust>
#. fr: Partez devant, les amis. Continuez sans moi, kuppo.
msgctxt "Balloon:3260:0:1"
msgid "We'll never finish at this rate."
msgstr "Так мы никогда не закончим."

#. ja: か、体がついて<br>こないくぽ…
#. de: Lauter Sternchen, kupo ...
#. fr: Je n'ai plus la force de soulever quoi que ce soit, kuppo.
msgctxt "Balloon:3261:0:1"
msgid "I'm not going to make it, kupo..."
msgstr "Я больше не могу, купо..."

#. ja: えいやっ！　ほらさっ！
#. de: Und hepp!
#. fr: Ku... ppo<nbsp>! Ku... ppo<nbsp>!
msgctxt "Balloon:3262:0:1"
msgid "Hey! Umph...wait for me, kupo!"
msgstr "Эй! Уф... подождите меня, купо!"

#. ja: 立派な像くぽ～
#. de: Mutter Schiefer ist ein Meisterwerk der Bildhauerkunst. Und so groß!
#. fr: Une telle beauté, c'est un véritable miracle, kuppo...
msgctxt "Balloon:3263:0:1"
msgid "I want to see if I can reach the top..."
msgstr "Хочу узнать, смогу ли я забраться на самый верх..."

#. ja: 見惚れてサボるなくぽー！
#. de: Starr keine Löcher in die Luft, kupo!
#. fr: Le miracle, ce serait que tu te remettes au travail, kuppo<nbsp>!
msgctxt "Balloon:3264:0:1"
msgid "Didn't Mogek want us back soon?"
msgstr "Могек велел нам поскорее вернуться, разве нет?"

#. ja: や、やられたくぽ…
#. de: Ich glaub, ich hab eine Bommelprellung ...
#. fr: Je crois que je me suis tordu le pompon...
msgctxt "Balloon:3265:0:1"
msgid "I should've known it was too good to be true..."
msgstr "Надо было сразу понять, что всё слишком хорошо, чтобы быть правдой..."

#. ja: まんまとダマされたくぽぉ
#. de: Hoffentlich kann man die anderen Nüsse noch essen ...
#. fr: On s'est fait avoir comme des bleus...
msgctxt "Balloon:3266:0:1"
msgid "Revenge \\<cough> will be ours, kupo!"
msgstr "Мы отомстим... кхе-кхе... купо!"

#. ja: どうして私たちが<br>こんなことを…
#. de: Wieso immer wir?
#. fr: Tu peux m'expliquer qu'est-ce qu'on fait ici au juste<nbsp>?
msgctxt "Balloon:3267:0:1"
msgid "And why are we here again?"
msgstr "И зачем мы опять здесь?"

#. ja: ロウェナ様の気分次第よ…
#. de: Das musst du Rowena fragen.
#. fr: Tu sais bien. C'est madame Rowena qui donne les ordres...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3268:0:1"
msgid "Because Rowena'd have<br>our heads on a shelf<br>selling for scrips if we weren't."
msgstr "Потому что иначе Ровена выставит наши головы на полку и будет продавать за жетоны."

#. ja: おーい！<br>資材は足りそうか？
#. de: He, wo bleibt der Nachschub?
#. fr: Héhooo<nbsp>! T'as assez de matos là-haut<nbsp>?
msgctxt "Balloon:3269:0:1"
msgid "Oi! You have enough nails!?"
msgstr "Эй! Гвоздей хватит?!"

#. ja: はーい、大丈夫っす！
#. de: Ist unterwegs!
#. fr: Euh... Un, deux, trois... Ouais<nbsp>! Mais je vais recompter les sacs, au cas où<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3270:0:1"
msgid "Do I look like I need any<br>more nails!?"
msgstr "Я что, похож на того, кому нужно ещё гвоздей?!"

#. ja: 修復団は<br>我々が守らねば！
#. de: Wir müssen den Wachtrupp beschützen!
#. fr: Nous protégerons les Mogdernisateurs célestes coûte que coûte<nbsp>!
msgctxt "Balloon:3271:0:1"
msgid "The Mogmenders are safe under our protection!"
msgstr "Могмастера под нашей защитой!"

#. ja: 綺麗な広場だ、悪くない…
#. de: Ein wirklich schöner Platz.
#. fr: Cette esplanade est si reposante... Je ne me lasse pas de la contempler.
msgctxt "Balloon:3272:0:1"
msgid "This place is quite...pleasant."
msgstr "Тут... весьма приятно."

#. ja: 愉快な舞だ、悪くない…
#. de: Ein wirklich schöner Tanz.
#. fr: Cette danse est si enivrante... Je ne me lasse pas de la regarder.
msgctxt "Balloon:3273:0:1"
msgid "I envy the grace with which they move."
msgstr "Завидую тому, как ловко они танцуют."

#. ja: ヒトと共にあって、<br>なお心地よいとはな…
#. de: Wer hätte diesen Frieden je zu erhoffen gewagt ...
#. fr: Je ne savais pas que les humains pouvaient être d'aussi bonne compagnie...
msgctxt "Balloon:3274:0:1"
msgid "Perhaps this arrangement with the sons of man is not so bad. "
msgstr "А ведь с людьми тоже бывает хорошо..."

#. ja: ドラゴンと一緒で、<br>これほど安らぐとはね…
#. de: Wer hätte gedacht, dass die Drachen so freundlich sind!
#. fr: Si on m'avait dit que je côtoierais un jour un dragon de cette façon...
msgctxt "Balloon:3275:0:1"
msgid "To think working with dragons could be so pleasurable."
msgstr "И подумать не мог, что работать с драконами так приятно."

#. ja: 木箱はどこだ…
#. de: Wo zum Henker ist die Kiste?
#. fr: Où a bien pu passer ce fichu colis<nbsp>?
msgctxt "Balloon:3278:0:1"
msgid "Wherever did that crate disappear to?"
msgstr "Куда же ящик подевался?"

#. ja: むにゃむにゃ…
#. de: Ich war nie der Beste im Selberheilen ...
#. fr: Quand est-ce qu'on mange...<nbsp>?
msgctxt "Balloon:3279:0:1"
msgid "\\<mumble> \\<mumble>"
msgstr "<i>Мням-мням...</i>"

#. ja: あ、あんたは！<br>…あれ、思い出せない
#. de: Dich hab ich doch schon mal gesehen ... aber nur wo?
#. fr: Eh, mais je te connais toi<nbsp>! Tu es... Tu es... J'ai oublié.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3280:0:1"
msgid "That's not death, you fool!<br>It's just some passerby!"
msgstr "Это не смерть, дурак!<br>Просто прохожий!"

#. ja: お、お主は！<br>…はて、誰じゃ？
#. de: Was willst du hier?
#. fr: Voilà une tête qui me dit quelque chose...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3281:0:1"
msgid "Ahhh! See!? See!?<br>Death stalks us<br>at every turn!"
msgstr "А-а-а! Видишь?! Видишь?!<br>Смерть подстерегает нас<br>на каждом шагу!"

#. ja: シュコォ…シュコォ…<br>…また留守か？
#. de: Kho ... Ist Langezeit Außerhause ...
#. fr: Psssh... Les chevaliers de l'Âge mûr ne sont toujours pas rentrés<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3282:0:1"
msgid "Pshhh... Shkohhh...<br>Grand Sers! Grand Sers!<br>This is final warning!"
msgstr "Пшшш... Шкохх...<br>Великие сэрсы! Великие сэрсы!<br>Это последнее предупреждение!"

#. ja: 星芒祭開催中よ☆<br>協力よろしくねー♪
#. de: Frohes Sternenlichtfest! ☆<br>Feiere doch mit uns! ♪
#. fr: La fête des étoiles bat son plein<nbsp>!☆ Venez nous donner un coup de main<nbsp>!♪
msgctxt "Balloon:3283:0:1"
msgid "Happy Starlight, friend! Won't you help us work miracles?"
msgstr "Счастливого Звёздного Рождества, друг! Поможешь творить чудеса?"

#. ja: 星芒祭開催中よ<br>みんな協力してよね
#. de: Frohes Sternenlichtfest! Wir könnten noch ein paar helfende Hände gebrauchen.
#. fr: La fête des étoiles a commencé<nbsp>! Venez nombreux nous aider<nbsp>!
msgctxt "Balloon:3284:0:1"
msgid "Starlight, star bright! Help us bring good cheer to the children tonight!"
msgstr "Звёзды светят ярко! Помоги нам порадовать сегодня детей!"

#. ja: 星芒祭開催中です<br>協力をお願いしますね
#. de: Frohes Sternenlichtfest! Hast du Lust, uns zu helfen?
#. fr: Nous recrutons des bénévoles pour la fête des étoiles<nbsp>!
msgctxt "Balloon:3285:0:1"
msgid "'Tis Starlight season! Care to help us spread happiness and joy?"
msgstr "Настало время Звёздного Рождества! Поможешь дарить детям радость?"

#. ja: いい腕前になったね！
#. de: Zementsäcke sollte man nicht auf die leichte Schulter nehmen, hat meine Mutter immer gesagt.
#. fr: C'est bien, mon grand. T'as un meilleur coup de marteau qu'avant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3286:0:1"
msgid "Oh yes, I like me men<br>on their hands and knees!"
msgstr "О да, люблю я мужчин,<br>когда они на четвереньках!"

#. ja: ヒトとゴブとで創りだす<br>斬新デザイン　お楽しみ！
#. de: Alle in Frohehalde helfen für neue hübsche Bäude bauen.
#. fr: Ces travaux avec les gentils humains... quelle aubaine<nbsp>! Idyllée aura un visage unique<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3287:0:1"
msgid "You take all laudtalks for<br>design, I take all jinglyshine!"
msgstr "Ты забирай всю хвалу за<br>дизайн, а мне — всю звонкую монету!"

#. ja: 悪かァないね！<br>ムキムキ貢献してやるよ！
#. de: Ist er nicht süß? Und arbeiten tut er auch.
#. fr: Pourquoi pas... Quel domaine de compétences vous intéresse<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3288:0:1"
msgid "Yes, I suppose you cannot<br>spell “automaton” without<br>“a tomato.”"
msgstr "Ну, не написать же «автоматон»<br>без слов «авто» и «томат»!"

#. ja: ンフッ、このマスク<br>と～ってもイカすでしょ？
#. de: Die Maske? Die schützt mich vor der Hitze. Oder dachtest du, ich trag die zum Spaß?
#. fr: Humpf... Il me donne un style inimitable ce masque, vous ne trouvez pas<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3289:0:1"
msgid "I cannot see worth a<br>damn in this wretched thing!"
msgstr "В этой проклятой штуке<br>ничего не видно!"

#. ja: 水まわりがよくて<br>助かるわ！
#. de: Das Wasser in Frohehalde ist sehr weich. Ideal für die Landwirtschaft.
#. fr: La région ne manque pas d'eau. C'est idéal pour l'agriculture<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3290:0:1"
msgid "Pssst!<br>(I ran out of water a bell<br>ago...but the cropmaster<br>don't have to know, eh?)"
msgstr "Тсс!<br>(Вода у меня закончилась<br>ещё час назад... только<br>главному агроному знать не надо, а?)"

#. ja: あの妙な髪形の連中は<br>何だったのかなぁ…
#. de: Abgefahrene Tollen, die beiden Typen. Wer war'n die wohl?
#. fr: Vous avez vu ces types bizarres avec leur coupe “banane”<nbsp>? Ils n'avaient pas l'air du coin. Je me demande ce qu'ils étaient venus faire ici...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3291:0:1"
msgid "Naught more stimulatin'<br>than watchin' pumpkins<br>grow, I reckon."
msgstr "И что это были за типы<br>с такими странными причёсками..."

#. ja: 大工房の職員募集！<br>あと少しで締切です！
#. de: Ich bin auch ein fleißiger Gobbi!
#. fr: Notre atelier embauche, mais plus pour très longtemps<nbsp>! Manifestez-vous vite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3292:0:1"
msgid "Calling all prospective<br>engineers!"
msgstr "Требуются инженеры!"

#. ja: 駆け込み　飛び込み<br>大歓迎～！
#. de: Kannzu kommen zu Jedezeit. Gobbi hat Offenearm!
#. fr: Que les gens viennent<nbsp>! Qu'ils courent... qu'ils volent<nbsp>!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3293:0:1"
msgid "Gobbie mindfruit is ripe<br>for bellyfilling! Come<br>take a bite!"
msgstr "Гоблинский мозговой плод созрел,<br>живот набить пора!<br>Налетай!"

#. ja: そこ行く婦人　しばし待て！<br>我らと研究どうだろう？
#. de: Willzu auch Wissenforschen, kho?
#. fr: La gentille humaine là-bas n'a-t-elle jamais eu envie de travailler avec des Gobelins<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3294:0:1"
msgid "Ravishing Rainlander! Crave<br>you succulent secrets of<br>automaton cogbonding?"
msgstr "Прекрасная жительница равнин!<br>Не желаете узнать сочные секреты<br>соединения шестерёнок автоматона?"

#. ja: ぎょあああ！<br>もう勘弁してくれ～！
#. de: Nicht schon wieder!
#. fr: Pourquoi ça n'arrive toujours qu'à moiiiii<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3295:0:1"
msgid "Might someone lend me<br>a hand? Anyone? ANYONE!?"
msgstr "Может, кто-нибудь мне<br>поможет? Кто-нибудь? КТО-НИБУДЬ?!"

#. ja: 作れや作れ　新たな施設！<br>研究成果を詰め込むぞ～
#. de: In Neuehaus kannzu gut Denkschale füllen, kho.
#. fr: Vivement la fin des travaux, que les Gobelins disposent d'un bel endroit où conserver le fruit de leurs recherches<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3296:0:1"
msgid "Higher! Taller!<br>Bigger! Larger!"
msgstr "Выше! Дальше!<br>Больше! Шире!"

#. ja: これで、君の一生は安泰だ<br>良い暮らしを約束しよう
#. de: Warum zögerst du? Ich habe alles mit deinen Eltern besprochen. Bei mir wirst du es gut haben. Ich biete dir ein Leben in Überfluss.
#. fr: Vous ne manquerez jamais de rien. Je vous promets une vie d'opulence.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3297:0:1"
msgid "The barony's coffers are<br>deep, my dear. You will<br>want for naught in this life."
msgstr "Казна баронства бездонна,<br>дорогая. Ни в чём не будешь<br>нуждаться до конца жизни."

#. ja: 旦那様、そろそろ<br>式の準備に…
#. de: Mein Herr, wir müssen uns beeilen. Der Priester wartet bereits.
#. fr: Sire, nous devrions aller procéder aux préparatifs pour la cérémonie...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3298:0:1"
msgid "My lord, we must straight<br>back. Your father will wish<br>to discuss the dowry."
msgstr "Милорд, нам пора возвращаться.<br>Ваш отец хочет обсудить приданое."

#. ja: 待ってくれ！
#. de: Warte!
#. fr: Attendez<nbsp>!
msgctxt "Balloon:3299:0:1"
msgid "Wait!"
msgstr "Постой!"

#. ja: 誰だ貴様は？<br>物乞いなら余所をあたれ
#. de: Wer bist du? Und was wagst du, die Dame zu belästigen?
#. fr: Qui es-tu<nbsp>? Un mendiant<nbsp>? Du vent, nous n'avons rien pour toi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3300:0:1"
msgid "Begone.<br>The Pillars is no place<br>for one of your standing."
msgstr "Пошёл прочь.<br>Таким, как ты, не место<br>в Столпах."

#. ja: そうか、貴様か！<br>人の女を誑かしたのはッ！
#. de: Ah, ich verstehe. Du bist der Grund, warum sie sich so ziert. Habe ich Recht?
#. fr: Mais... vous êtes celui qui a ensorcelé ma promise<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3301:0:1"
msgid "Ah, if it isn't the lowborn<br>wretch who fancies himself<br>the good lady's suitor.<br>Summon the constable."
msgstr "А, так это ты, оборванец,<br>который возомнил себя женихом<br>этой благородной дамы.<br>Позовите стражника."

#. ja: どんな罰も受けよう<br>ただ彼女の笑顔を守りたい！
#. de: Herr, verzeiht mir. Ich erdulde jede Strafe, aber ich habe mein Herz an diese Dame verloren und versprochen, sie glücklich zu machen.
#. fr: Oui, et peu importe les obstacles, rien ne m'empêchera de protéger le bonheur de cette dame<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3302:0:1"
msgid "You can throw me in the<br>darkest of oubliettes, and<br>cast the key to the clouds.<br>Our love will not fade."
msgstr "Можете бросить меня в самую<br>тёмную темницу и выбросить<br>ключ за облака.<br>Наша любовь не угаснет."

#. ja: 構う必要はない<br>行くぞ、式の準備だ
#. de: Jedes Wort ist überflüssig. Die Zeremonie wird durchgeführt. Gehen wir!
#. fr: Mêlez-vous de ce qui vous regarde<nbsp>! Nous, nous avons mieux à faire que d'écouter vos bêtises<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3303:0:1"
msgid "But will that love fill her<br>belly? Will it wrap her in<br>the finest of Eastern silks?"
msgstr "Но разве любовь накормит её?<br>Оденет в лучший восточный шёлк?"

#. ja: 確かに、あなたといれば<br>不自由はないでしょう…
#. de: Es ist, wie Ihr sagt, Herr. Bei Euch werde ich ein Leben in Luxus führen ...
#. fr: C'est vrai que... avec vous, je ne souffrirai d'aucun besoin matériel.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3304:0:1"
msgid "I yearn not for those things<br>you associate with happiness..."
msgstr "Я не мечтаю о тех вещах,<br>которые вы считаете счастьем..."

#. ja: でも、きっと私は笑えない<br>本当の幸せを知ったから…
#. de: Aber dieser Mann schenkt mir eine Kostbarkeit, die mir kein anderer schenken kann.
#. fr: Mais jamais vous ne pourrez m'offrir cette douce ivresse à laquelle j'ai goûté avec lui.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3305:0:1"
msgid "...for without the love of<br>dear Peter, they would<br>provide mine heart little solace."
msgstr "...ведь без любви дорогого Питера<br>они не утешат моё сердце."

#. ja: お願いします<br>私、彼と生きたいんです！
#. de: Bitte, Herr. Habt ein Nachsehen. Dies ist der Mann, mit dem ich ein Leben führen möchte.
#. fr: Votre seul moyen de me combler de joie est de nous laisser partir tous les deux. Je vous en prie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3306:0:1"
msgid "If it would please you to<br>see me live a lie─to look<br>into my dead eyes each<br>morn─then fine. I am yours."
msgstr "Если вам угодно видеть, как я<br>живу во лжи, и каждое утро<br>глядеть в мои мёртвые глаза —<br>что ж, я ваша."

#. ja: …ならば二度と離すな<br>そして、彼女を幸せにしろ
#. de: Also gut.
#. fr: Si c'est ce que vous désirez... Faites d'elle la plus heureuse des femmes, et ne l'abandonnez jamais à un autre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3307:0:1"
msgid "But is that truly a more<br>lamentable fate than<br>looking into no eyes at all?"
msgstr "Но разве это и вправду хуже,<br>чем вообще ни в чьи глаза<br>не смотреть?"

#. ja: そうでなければ<br>再び私が迎えに行くからな
#. de: Aber du, versprich, dass du dieser Dame ein guter Mann sein wirst.
#. fr: Si j'apprends que vous vous en êtes séparé, j'irai moi-même la chercher.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3308:0:1"
msgid "No. I was a fool to think<br>I could reason with a<br><i>woman in love</i>.<br>Leave me. Both of you."
msgstr "Нет. Я был глуп, раз думал,<br>что смогу образумить<br><i>влюблённую женщину</i>.<br>Уходите. Оба."

#. ja: ああ…必ず幸せに！
#. de: Ich verspreche es, bei allem was mir heilig ist!
#. fr: J-je... vous le promets<nbsp>!
msgctxt "Balloon:3309:0:1"
msgid "Thank you...milord."
msgstr "Спасибо... милорд."

#. ja: 得られなかったな…<br>最も愛した笑顔だけは…
#. de: Es sollte eben nicht sein ... Also los, Diener, find mir eine andere!
#. fr: Son sourire que j'ai tant aimé... n'illuminera jamais mes mornes journées.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3310:0:1"
msgid "Reginald. You know<br>what I must ask of you..."
msgstr "Реджинальд. Ты знаешь,<br>о чём я должен тебя попросить..."

#. ja: もう無茶は<br>しないでくださいね…
#. de: Du solltest dich wirklich lieber hinlegen!
#. fr: Vous devriez encore vous reposer...
msgctxt "Balloon:3311:0:1"
msgid "You should still be abed..."
msgstr "Тебе бы ещё полежать..."

#. ja: 次の愛機は更に速くしたいな
#. de: Mein nächstes Schiff? Muss auf jeden Fall schneller werden.
#. fr: Mon prochain aéronef<nbsp>? Je le veux plus rapide.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3312:0:1"
msgid "My next ship?<br>Needs to be faster."
msgstr "Следующий корабль?<br>Он должен быть быстрее."

#. ja: よーし、任せとけ！
#. de: Ich kümmer mich drum, Käpt'n!
#. fr: Je m'en occupe, Capitaine<nbsp>!
msgctxt "Balloon:3313:0:1"
msgid "I'll see to it, Captain!"
msgstr "Будет сделано, капитан!"

#. ja: ああ、期待してるぞ
#. de: Schneller als schnell, hörst du?
#. fr: Tout pour la vitesse, compris<nbsp>?
msgctxt "Balloon:3314:0:1"
msgid "Swifter than swift, you hear?"
msgstr "Быстрее ветра, слышишь?"

#. ja: …安全性はどうした
#. de: ... Nicht etwa stabiler?
#. fr: ... Toujours aussi tête brulée.
msgctxt "Balloon:3315:0:1"
msgid "...Not sturdier?"
msgstr "...А прочнее нельзя?"

#. ja: 世界一、速いヤツを頼むぜ
#. de: Niemand kann mit den Rotschnäbeln mithalten!
#. fr: Personne ne peut rivaliser avec les Becs-rouges<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3316:0:1"
msgid "Ain't no one keepin' up<br>with the Redbills!"
msgstr "Никто не угонится<br>за Красноклювыми!"

#. ja: …よう、派手にヤッてるか？
#. de: Ganz schön protzig hier, oder?
#. fr: Toujours dans le pétrin, hein<nbsp>?
msgctxt "Balloon:3317:0:1"
msgid "Keepin' yourself in trouble?"
msgstr "Опять неприятности ищешь?"

#. ja: 整備サボって来てるんだ…<br>スタシアには内緒ねっ
#. de: Ich müsste eigentlich arbeiten, aber<nbsp>... Bitte verpfeif mich nicht bei Stacia!
#. fr: Je devrais être en train de travailler, mais... Je vous en pris, ne dites rien à Stacia<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3318:0:1"
msgid "I'm meant to be working, but...<br>Please don't tell Stacia!"
msgstr "Вообще-то я должен работать, но...<br>Только Стации ни слова!"

#. ja: …何故か、<br>妙に落ち着く場所だな
#. de: Ich weiß zwar nicht, warum, aber irgendwie fühle ich mich hier wie zu Hause.
#. fr: Je ne sais pas pourquoi, mais je me sens comme chez moi, dans cet endroit.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3319:0:1"
msgid "I do not understand why,<br>yet I feel oddly at home here."
msgstr "Не пойму почему,<br>но здесь я чувствую себя как дома."

#. ja: さて、もうひと稼ぎ…
#. de: Dann wollen wir mal. Ran an den Speck!
#. fr: Il est temps de se remplir les poches...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3320:0:1"
msgid "Right, then.<br>Time for a spot of plunder..."
msgstr "Ну что ж.<br>Пора кое-что прибрать к рукам..."

#. ja: 陽気な舞だ、悪くない…
#. de: Lustiges Tänzchen, gefällt mir ...
#. fr: Quel rythme enjoué, j'y succomberais presque...
msgctxt "Balloon:3321:0:1"
msgid "These playful movements...they intrigue me."
msgstr "Любопытные движения... Заинтриговали меня."

#. ja: みんなのことを<br>夢中にさせるんだからっ♪
#. de: ♪ Alle Augen und Ohren werden auf mich gerichtet sein ♪
#. fr: On va tous les rendre dingue de nous<nbsp>!♪
msgctxt "Balloon:3322:0:1"
msgid "Tee hee hee! They can't take their eyes off me!"
msgstr "Хи-хи-хи! Они глаз от меня не оторвут!"

#. ja: 喜んでいただけていて<br>何よりです！
#. de: Das Wichtigste ist, dass alle Spaß an unserem Auftritt haben!
#. fr: Je suis si heureuse que ça leur plaise<nbsp>!
msgctxt "Balloon:3323:0:1"
msgid "The most important thing is that everyone leaves happy!"
msgstr "Главное, чтобы все ушли довольными!"

#. ja: 待たせた分も<br>がんばらないと！
#. de: Um die Wartezeit wiedergutzumachen, werden wir uns richtig ins Zeug legen!
#. fr: On va chanter encore plus pour rrrattraper le temps perdu<nbsp>!
msgctxt "Balloon:3324:0:1"
msgid "Ladies and gentlemen, thank you for your patience! Let's make this a Little Ladies' Day to remember!"
msgstr "Дамы и господа, спасибо за терпение! Давайте устроим такой Праздник Маленьких Леди, чтобы запомнился надолго!"

#. ja: アンコール！<br>アンコール！
#. de: Zu-ga-be! Zu-ga-be!
#. fr: Une autre<nbsp>! On en veut encore<nbsp>!
msgctxt "Balloon:3325:0:1"
msgid "Encore! Encore! Encore...!"
msgstr "На бис! На бис! Ещё на бис...!"

#. ja: 新衣装、<br>ほんとかわいい～！
#. de: Die neuen Kostüme sind echt zum Träumen schön!
#. fr: Vous êtes trop mignonnes dans vos nouveaux costumes<nbsp>!
msgctxt "Balloon:3326:0:1"
msgid "What adorable costumes!"
msgstr "Какие милые костюмчики!"

#. ja: シュコォ…シュコォ…<br>奴も元気にしているか…
#. de: Pshhh, ob ihm wohl gutgeht ...?
#. fr: Pshhh... Pshhh... Pourvu qu'il aille bien...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3327:0:1"
msgid "I still pack backthoughts<br>of earlytimes in Idyllshire..."
msgstr "Шшш... Шшш...<br>Всё вспоминаю давние деньки в Идиллшире..."

#. ja: コレはなかなか面白い<br>記録の蓄積　順調ぞ～
#. de: Zu viele Schlaueworte machen Pochen in Denkschale!
#. fr: Voilà qui est intéressant<nbsp>! Pshhh... Les Gobelins futés ont recueilli des savoirs très in<shy>té<shy>res<shy>sants<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3328:0:1"
msgid "Overmany quillwords see<br>gobbiebrain abursting!"
msgstr "Столько учёных слов —<br>гоблинская башка сейчас лопнет!"

#. ja: ここから先は進入禁止！<br>関係者のみ入れるよ～
#. de: Halt! Hier gibt kein Durchspazieren für Großwachsene!
#. fr: Pshhh... Interdiction d'entrer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3329:0:1"
msgid "Decease and insist!<br>Beyond shutport lies<br>secrets unmeant for<br>uplander wide-eyes!"
msgstr "Не входить!<br>За закрытыми воротами<br>тайны, не для глаз<br>поверхностников!"

#. ja: シュコォ…シュコォ…<br>ここはゴブの特等席～！
#. de: Psh ... Willzu auch sitzen? Hier ist aber Gobbiplatz!
#. fr: Pshhh... Cet endroit est le meilleur pour observer le paysage.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3330:0:1"
msgid "Come! Downsit with gob<br>and longpeer the seasky!"
msgstr "Иди! Присядь с гоблином,<br>погляди на морское небо!"

#. ja: いい感じで<br>盛ってるじゃないか！
#. de: Du hast nicht zufällig etwas Tinte für mich?
#. fr: Quelle magnifique machinerie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3331:0:1"
msgid "It might help if I had some<br>ink to go with this quill."
msgstr "С пером-то писать хорошо,<br>да вот чернил бы ещё..."

#. ja: お仲間募集は<br>しめきりました～！
#. de: Wir haben schon genug Techniker und rekrutieren keine neuen mehr.
#. fr: Notre recrutement est terminé<nbsp>! Nous avons plein de camarades maintenant<nbsp>! Youpiii<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3332:0:1"
msgid "No longer calling all<br>prospective engineers!"
msgstr "Инженеров больше не набираем!"

#. ja: ご協力に感謝感激～！
#. de: Kho, Denkschale ist leerfegen wie Küchenstube!
#. fr: Pshhh... Youpi<nbsp>! Youpshhhiii...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3333:0:1"
msgid "Gobbie mindfruit tree is<br>plucked to barebottoms!"
msgstr "Дерево знаний гоблина<br>обобрали дочиста!"

#. ja: 穏やかで幸せな日々…<br>明日も続きますように
#. de: Oje, wie soll ich ich von meinem Hungerlohn bloß meine Kinder ernähren?
#. fr: Je n'ai jamais été aussi heureuse de toute ma vie. Pourvu que ça dure...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3334:0:1"
msgid "Oh Father, what have I done?<br>How am I to feed this child<br>on a weed-puller's wages?"
msgstr "Отец, что я наделала?<br>Как прокормить ребёнка<br>на зарплату пропольщицы?"

#. ja: 野菜も子どもも<br>真心こめて育てるんだ！
#. de: Junges Gemüse und Kinder gedeihen am besten mit viel Liebe!
#. fr: Les légumes, c'est comme les enfants<nbsp>: il faut les élever avec amour<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3335:0:1"
msgid "You missed one! Over there!<br>No, not your <i>there</i>,<br>my <i>there</i>!"
msgstr "Одну пропустил! Вон там!<br>Нет, не твоё <i>там</i>,<br>а моё <i>там</i>!"

#. ja: はいっ！
#. de: Zu Befehl!
#. fr: Euh, ouais...
msgctxt "Balloon:3336:0:1"
msgid "Y-Yes, milord!"
msgstr "Д-да, милорд!"

#. ja: よしよし…<br>おいしそうに実ったな！
#. de: Sehen die nicht wirklich zum Anbeißen aus?
#. fr: Miam miam<nbsp>! Ils sont bien mûrs, comme je les aime<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3337:0:1"
msgid "I knows me a watched pot<br>ne'er boils, but Ma said<br>aught 'bout watched grapes!"
msgstr "Знаю, что подглядывай не подглядывай — кастрюля не закипит, но мама про виноград ничего не говорила!"

#. ja: ふぅー…<br>今日も這い上がったぜ…
#. de: Puh, wenn der Weg hier hoch nicht so anstrengend wäre ...
#. fr: Fiou<nbsp>! Aujourd'hui aussi, j'ai bien travaillé...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3338:0:1"
msgid "A city full to burstin' with<br>gobbie lifts and pulleys,<br>yet still we has all these<br>bloody swivin' stairs."
msgstr "Весь город в гоблинских подъёмниках<br>и блоках, а по лестницам<br>всё равно топать!"

#. ja: 人とゴブの共同建築<br>君も上をご覧あれ～
#. de: Siehzzu? Haben alles Gobbie und Großwachsene zusammen baut!
#. fr: Les Gobelins et les humains ont bâti cet édifice ensemble<nbsp>! Il est beau, n'est-ce pas<nbsp>? Pshhh...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3339:0:1"
msgid "You see that, uplander?<br>I built that! Uh...with a<br>little hand-lending, of course."
msgstr "Видишь, поверхностник?<br>Это я построил! Ну... с<br>небольшой помощью, конечно."

#. ja: いらっしゃいませ！<br>ようこそ崖っぷち亭へ
#. de: Willkommen im Klippenhänger!
#. fr: Bienvenue au Bord du gouffre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3340:0:1"
msgid "Welcome to the Hard Place!<br>Pull up a rock! Hah hah hah!"
msgstr "Добро пожаловать в «Трудный выбор»!<br>Присаживайтесь на камушек! Ха-ха-ха!"

#. ja: ハッハッ！　ホッホッ！<br>フンッフンッ！
#. de: Haha! Hoho! Hehe!
#. fr: Hé hé<nbsp>! Ah ah<nbsp>! Oh oh oh<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3341:0:1"
msgid "Hoo! Hah!<br>Hoo hoo hah!"
msgstr "Ху! Ха!<br>Ху-ху-ха!"

#. ja: シシシシシ…<br>止まらん
#. de: \<klick> \<klack> Ich könnte ewig weitertanzen!
#. fr: Ksss... Je ne peux plus m'arrêter de tourner<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3342:0:1"
msgid "\\<click> \\<click><br>My limbs...they will not stop moving."
msgstr "<i>Щёлк-щёлк.</i><br>Руки и ноги... не слушаются."

#. ja: 一緒に踊るくぽー♪
#. de: Tanz mit! Kupo!
#. fr: Venez danser avec nous, kuppo<nbsp>!♪
msgctxt "Balloon:3343:0:1"
msgid "Won't you dance with me, kupo?"
msgstr "Потанцуешь со мной, купо?"

#. ja: いい仲間といい仕事…<br>最高だったねぇ！
#. de: Gute Arbeit in guter Ge<shy>sell<shy>schaft! Besser hätte es nicht laufen können.
#. fr: Rien de mieux qu'une bonne binouze entre collègues après un boulot achevé<nbsp>!
msgctxt "Balloon:3344:0:1"
msgid "What!? I only struck 'im once!"
msgstr "Что?! Я его всего разок ударил!"

#. ja: ロウェナって人<br>やっぱりすごいわよ…
#. de: Rowena ist eine tolle Frau!
#. fr: Y a pas à dire, Rowena est vraiment géniale.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3345:0:1"
msgid "Alright, I may have taken a<br>tumble or three with her<br>Ned...but that don't give<br>her the right to steal my cow!"
msgstr "Ладно, может, я и падал пару<br>раз с её Недом... Но это не даёт<br>ей права красть мою корову!"

#. ja: フッ…忙しいことだ<br>立ち止まる暇もないな
#. de: Hinfort mit dir! Siehst du nicht, dass ich beschäftigt bin?
#. fr: J'ai tant à faire que c'est à peine si j'ai le temps de m'arrêter...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3346:0:1"
msgid "Hmph. If he only knew his<br>son's <i>true</i> sire. "
msgstr "Хм. Знал бы он, кто на самом<br>деле отец его <i>сына</i>."

#. ja: 無事でよかった<br>遅いから心配したのよ
#. de: Ah, da seid ihr ja endlich! Ich habe mir schon Sorgen gemacht!
#. fr: Ah, vous voilà<nbsp>! Comme vous ne reveniez pas, je commençais à beaucoup m'inquiéter.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3347:0:1"
msgid "Where have you two been?<br>Father's fever has grown<br>worse and we need those<br>popotoes for his stew."
msgstr "Где вы пропадали?<br>У отца жар усилился, а нам<br>для похлёбки нужна картошка."

#. ja: 母上ごめんなさい…
#. de: Verzeih uns, Mutter.
#. fr: Pardon, Mère...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3348:0:1"
msgid "Forgive us, Mother...<br>There are no popotoes..."
msgstr "Прости нас, мама...<br>Картошки нет..."

#. ja: お菓子を買ったせいで<br>お肉が買えなかったの…
#. de: Das Geld für das Fleisch haben wir für Süßigkeiten ausgegeben ...
#. fr: Nous avons acheté des gâteaux, et il n'y avait plus assez de gils pour la viande...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3349:0:1"
msgid "We used the last of the<br>coin on...on...honey cakes..."
msgstr "Мы потратили последние<br>монеты на... на... медовые пирожки..."

#. ja: あら…<br>それで沈んでいるのね
#. de: Ach, deswegen zieht ihr ein solches Gesicht.
#. fr: Je vois... Et c'est donc pour ça que vous vous morfondiez ici<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3350:0:1"
msgid "On honey cakes!?<br>ON HONEY CAKES!?"
msgstr "На медовые пирожки!?<br>НА МЕДОВЫЕ ПИРОЖКИ!?"

#. ja: これから貴方たちにも<br>判断する力が必要になる…
#. de: Ihr müsst lernen, bei Entscheidungen vorauszudenken.
#. fr: Vous avez besoin de faire preuve de plus de perspicacité.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3351:0:1"
msgid "If the fever takes your<br>father, those cakes might<br>be the last thing you<br>ever eat!"
msgstr "Если отец умрёт от жара,<br>эти пирожки могут стать<br>последним, что вы съедите!"

#. ja: 今回のおつかいのこと<br>忘れないでね？
#. de: Ich hoffe, dieser Vorfall war euch eine Lehre.
#. fr: Que cela vous serve de leçon pour cette fois. D'accord<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3352:0:1"
msgid "I'll have to sell the both<br>of you to the goblins!"
msgstr "Придётся продать вас обоих гоблинам!"

#. ja: はい！
#. de: Ja, Mutter!
#. fr: Oui, Mère<nbsp>!
msgctxt "Balloon:3353:0:1"
msgid "No, Mother!"
msgstr "Нет, мама!"

#. ja: はい！
#. de: Kommt nicht wieder vor!
#. fr: Promis<nbsp>!
msgctxt "Balloon:3354:0:1"
msgid "Anything but that!"
msgstr "На всё, что угодно, только не это!"

#. ja: ふふ、寒いし帰りましょ<br>夕飯は野菜シチューよ！
#. de: Brr, ich friere. Lasst uns nach Hause gehen. Zum Abendessen gibt es Gemüseeintopf!
#. fr: J'ai vraiment très froid... Rentrons à la maison. Tant pis pour le ragoût, il sera à base de légumes uniquement.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3355:0:1"
msgid "Then you'd best hope that<br>the refuse pile behind the<br>inn turns up something good.<br>Come on now!"
msgstr "Тогда надейтесь, что найдёте<br>что-нибудь вкусное в мусоре<br>за трактиром. Ну, пошли!"

#. ja: よっしゃー！<br>かけっこで競争だ！
#. de: Ha, die Wette gilt!
#. fr: Allez<nbsp>! On fait la course<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3356:0:1"
msgid "Will someone tell me<br>why we are here again?"
msgstr "Кто-нибудь объяснит,<br>зачем мы опять здесь?"

#. ja: 男子ったら<br>飽きないんだから…
#. de: Jungs geben so schnell nicht auf ...
#. fr: Je comprends pas ce qu'ils trouvent d'intéressant à ça, les garçons...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3357:0:1"
msgid "Why? Just a friendly race,<br>of course. You lads run,<br>we girls take care of the<br>rest."
msgstr "А зачем? Просто дружеская гонка.<br>Парни бегут, а мы, девочки,<br>за всем остальным присмотрим."

#. ja: はやくはやく～！
#. de: Schneller, schneller!
#. fr: Vite<nbsp>! Vite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3358:0:1"
msgid "Well then, what are we<br>waitin' for? I'm gonna<br>sprint circles around<br>rabbit-ears, here!"
msgstr "Ну же, чего ждём? Сейчас<br>нарежу круги вокруг<br>этого ушастого кролика!"

#. ja: おにいちゃんも走るの？<br>がんばってね！
#. de: Du willst auch antreten? Viel Glück!
#. fr: M'sieur, vous devriez faire la course, vous aussi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3359:0:1"
msgid "Lookin' for some action,<br>milord? I'll give you ten to<br>one on the Hyur."
msgstr "Хотите поставить, милорд?<br>Даю десять к одному на хьюра."

#. ja: おねえちゃんも走るの？<br>がんばってね！
#. de: Du willst auch antreten? Viel Glück!
#. fr: M'dame, vous devriez faire la course, vous aussi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3360:0:1"
msgid "Lookin' for some action,<br>milady? I'll give you ten to<br>one on the Hyur."
msgstr "Хотите поставить, миледи?<br>Даю десять к одному на хьюра."

#. ja: 負けないぞ！
#. de: Ich werd gewinnen!
#. fr: Les doigts dans le nez<nbsp>!
msgctxt "Balloon:3361:0:1"
msgid "Ten to...what?"
msgstr "Десять к... чему?"

#. ja: 位置について…<br>よーい…
#. de: Auf die Plätze, fertig ...
#. fr: À vos marques, prêts...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3362:0:1"
msgid "Ahem!<br>Run like you mean it,<br>boys. I've a moon's<br>allowance riding on this."
msgstr "Кхм!<br>Давайте, парни, бегите что есть сил.<br>На кону мой месячный заработок."

#. ja: ドンッ！
#. de: Los!
#. fr: Partez<nbsp>!
msgctxt "Balloon:3363:0:1"
msgid "Ready...GO!"
msgstr "На старт... Внимание... Марш!"

#. ja: うおお、ダーッシュ！
#. de: Oh, wie schnell!
#. fr: Mouoooh<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3364:0:1"
msgid "Hah hah hah! I'm the<br>fastest in all Dravania!"
msgstr "Ха-ха-ха! Я самый быстрый<br>во всей Дравании!"

#. ja: 腹減った…
#. de: Hab ich 'nen Kohldampf ...
#. fr: Argh, j'ai faim...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3365:0:1"
msgid "I shouldn't have sold<br>my breakfast to that goblin."
msgstr "Не надо было продавать<br>завтрак тому гоблину."

#. ja: くらえ、ひっさつ走り！
#. de: Lauf um dein Leben!
#. fr: J'ai encore du souffle<nbsp>!
msgctxt "Balloon:3366:0:1"
msgid "I was born to run!"
msgstr "Бегать — моё призвание!"

#. ja: ガッツがたりない…
#. de: So wird das nichts ...
#. fr: Trop fastoche<nbsp>!
msgctxt "Balloon:3367:0:1"
msgid "I need...to...catch my...breath..."
msgstr "Надо... отдышаться..."

#. ja: もう1回やろうよ～！
#. de: Los, noch einmal!
#. fr: Allez, encore une fois<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3368:0:1"
msgid "You cheated!<br>I want a rematch!"
msgstr "Ты жульничал!<br>Хочу реванш!"

#. ja: よーし…
#. de: Ich bin bereit ...
#. fr: D'accord...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3369:0:1"
msgid "<i>I</i> cheated?<br><i>You</i> cheated!"
msgstr "<i>Я</i> жульничал?<br><i>Ты</i> жульничал!"

#. ja: 暗くなってきたし帰ろっか
#. de: Es ist schon dunkel. Wird wohl Zeit, nach Hause zu gehen ...
#. fr: Il commence à faire noir... On rentre<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3370:0:1"
msgid "The sun's going down.<br>I'm going to need a bit<br>more light to count my<br>winnings."
msgstr "Солнце садится.<br>Надо бы света побольше,<br>чтобы пересчитать выигрыш."

#. ja: 雨が降ってきたから<br>中に入ろっか
#. de: Es regnet. Lass uns lieber reingehen.
#. fr: Il pleut<nbsp>! Mettons-nous à l'abri<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3371:0:1"
msgid "Rain? Let's take this<br>inside, boys."
msgstr "Дождь? Пойдёмте, парни,<br>перенесём всё в трактир."

#. ja: 仕方ないかー<br>また今度な！
#. de: Tja, beim nächsten Mal läuft's bestimmt besser.
#. fr: On remet ça à la prochaine fois<nbsp>!
msgctxt "Balloon:3372:0:1"
msgid "I'll race you to the inn!"
msgstr "Спорим, кто первый добежит до трактира!"

#. ja: 不覚…ですぞ…
#. de: Du passt nicht auf ...
#. fr: Quel échec...
msgctxt "Balloon:3373:0:1"
msgid "This mountain did not fight...as a gentleman..."
msgstr "Эта гора сражалась... не по-джентльменски..."

#. ja: 爆弾にやられましたね～
#. de: Die Bombe hat dich erwischt, was?
#. fr: Mouah ha ha<nbsp>! Cette explosion ne vous a laissé aucune chance<nbsp>!
msgctxt "Balloon:3374:0:1"
msgid "Oh, Inspector! Are you hurt!? Maybe you should hibernate a bit longer."
msgstr "О, инспектор! Вы не ушиблись? Может, вам ещё немного поспать в зимней спячке."

#. ja: なぜワシの名前がないのだ！
#. de: Warum ist mein Name nicht dort drauf?
#. fr: J'exige qu'on m'explique pourquoi il n'y a pas mon nom<nbsp>!
msgctxt "Balloon:3375:0:1"
msgid "I shall see that someone pays for this! Why is my name not on here!?"
msgstr "Кто-то за это ответит! Почему меня здесь нет?!"

#. ja: オレ様の騎乗術を<br>見せてやるぜ！
#. de: Ich werde dir meine Reitkunst zeigen!
#. fr: Y a pas meilleur cavalier que moi, et je compte bien le prouver<nbsp>!
msgctxt "Balloon:3376:0:1"
msgid "Watch well, Honoroit—you may learn a thing or two!"
msgstr "Смотри внимательно, Оноруа, авось чему научишься!"

#. ja: き、危険ですから<br>おやめください！
#. de: A-Aufhören! Das ist zu gefährlich!
#. fr: A-arrête<nbsp>! C'est dangereux.
msgctxt "Balloon:3377:0:1"
msgid "My lord, please stop this before you hurt yourself!"
msgstr "Милорд, прошу, прекратите, пока не ушиблись!"

#. ja: ここで一発当てて<br>財政再建でっす！
#. de: Nur ein Treffer und ich bin finanziell aus dem Schneider!
#. fr: Quelle ardoise, il faut que je me refasse... Allez, un dernier ticket<nbsp>!
msgctxt "Balloon:3378:0:1"
msgid "One good ticket—that's all I need!"
msgstr "Нужен всего один удачный билет!"

#. ja: 局長のもなかなか<br>可愛くてよ？
#. de: Der General ist ja knuffig!
#. fr: Le Général est loin d'être laid, mais je ne pensais pas le trouver un jour si mignon...
msgctxt "Balloon:3379:0:1"
msgid "Get ready for a Raubahn roasting!"
msgstr "Готовьтесь к жареному Раубану!"

#. ja: 提督のマメットが最強だぜ！
#. de: Die Admiral-Marionette ist am stärksten!
#. fr: Avec l'Amirale miniature, je suis imbattable<nbsp>!
msgctxt "Balloon:3380:0:1"
msgid "I'll have ye know the Admiral's no slouch!"
msgstr "Хочу, чтобы ты знал: Адмирал ещё ого-го!"

#. ja: ア・ルン様の<br>マメットはないのか？
#. de: Gibt es etwa keine Marionette von  A-Ruhn-Senna?
#. fr: Vous savez s'il existe une mascotte à l'effigie de maître A-Ruhn<nbsp>?
msgctxt "Balloon:3381:0:1"
msgid "I cannot help but feel at a disadvantage here..."
msgstr "Чувствую себя здесь не в своей тарелке..."

#. ja: う～ん、釣れない…<br>だが、もう一回！
#. de: Mist ... Noch ein letzter Versuch, dann lass ich's.
#. fr: Décidément, c'est pas ma journée... Bon, un dernier essai et après j'arrête.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3382:0:1"
msgid "Not even a nibble...<br>Just one more cast!"
msgstr "Даже не клюёт...<br>Ещё один заброс!"

#. ja: 準備はいいですね？<br>さあ、出発です！
#. de: Bereit, dich der Heraus<shy>forde<shy>rung zu stellen? Ich halte es kaum mehr aus vor Spannung!
#. fr: Je suis trop impatiente<nbsp>! Allons-y<nbsp>!
msgctxt "Balloon:3383:0:1"
msgid "Ready whenever you are!"
msgstr "Как скажете — я готова!"

#. ja: 20年も経っているのに<br>こんなに綺麗だなんて…
#. de: Zwanzig Jahre liegt dieser Ort schon verlassen, und er ist so schön wie eh und je.
#. fr: Malgré vingt ans d'abandon, l'état des lieux est plutôt bon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3384:0:1"
msgid "Twenty years since the<br>mad king's attack and yet<br>it is still so beautiful."
msgstr "Прошло двадцать лет после<br>нападения Безумного короля,<br>а здесь всё ещё так красиво."

#. ja: 壊神ラールガー像…<br>間近で見ると凄い迫力！
#. de: Rhalgrs Statue ... Aus so großer Nähe betrachtet sieht sie noch beeindruckender aus!
#. fr: Vue d'ici, la statue de Rhalgr est vraiment im<shy>pres<shy>sion<shy>nante<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3385:0:1"
msgid "I have never seen the statue<br>from so close before!"
msgstr "Я ещё ни разу не видела статую<br>так близко!"

#. ja: 星導山寺院の本殿です！
#. de: Dort drüben ist das Hauptgebäude des Tempels!
#. fr: Voici la chapelle principale<nbsp>!
msgctxt "Balloon:3386:0:1"
msgid "The building ahead is the Closed Fist!"
msgstr "Впереди — Заложенный кулак!"

#. ja: 内部は武人だけの領域<br>案内はここまでです…
#. de: Ins Hauptgebäude dürfen nur gestandene Krieger. Das heißt, für mich ist hier Endstation ...
#. fr: Seuls les combattants peuvent aller plus loin. Fin de la visite guidée...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3387:0:1"
msgid "Only Disciples of War or Magic<br>may venture inside."
msgstr "Внутрь могут войти только<br>ученики войны или магии."

#. ja: 撃て撃てッ～！
#. de: Schießt! Feuer!!!
#. fr: Feu<nbsp>! Feu<nbsp>!
msgctxt "Balloon:3388:0:1"
msgid "Fire everything!"
msgstr "Огонь из всех орудий!"

#. ja: 砲撃を絶やすな！
#. de: Feuert, was das Zeug hält!
#. fr: Continuez de tirer<nbsp>!
msgctxt "Balloon:3389:0:1"
msgid "Destroy the artillery!"
msgstr "Уничтожить артиллерию!"

#. ja: ここを死守するのだッ！
#. de: Widerstand bis zum Ende!
#. fr: Il faut protéger cette position coûte que coûte<nbsp>!
msgctxt "Balloon:3390:0:1"
msgid "For the Empire!"
msgstr "За Империю!"

#. ja: 不埒な異人はどこだ…？
#. de: Wo sind die Unruhestifter?
#. fr: Où sont passés ces étrangers fauteurs de troubles<nbsp>!?
msgctxt "Balloon:3391:0:1"
msgid "Was that... No, just my eyes playing tricks..."
msgstr "Это было?.. Нет, просто померещилось..."

#. ja: 不届き者を<br>捕らえねば…
#. de: Wir müssen sie finden!
#. fr: Il faut les attraper<nbsp>!
msgctxt "Balloon:3392:0:1"
msgid "We mustn't let them escape..."
msgstr "Нельзя дать им сбежать..."

#. ja: どこにいった…？
#. de: Wo sind sie hin?
#. fr: Où sont-ils<nbsp>!?<nbsp>...
msgctxt "Balloon:3393:0:1"
msgid "Where could they have gone?"
msgstr "Куда же они подевались?"

#. ja: こちらが怪しいな…
#. de: Ich spüre es, sie müssen hier irgendwo sein ...
#. fr: Ça a l'air louche par là...
msgctxt "Balloon:3394:0:1"
msgid "They're close..."
msgstr "Они где-то рядом..."

#. ja: 大丈夫…？
#. de: Alles in Orrrdnung?
#. fr: Ça va<nbsp>?<nbsp>...
msgctxt "Balloon:3395:0:1"
msgid "Are you alright?"
msgstr "Ты в порядке?"

#. ja: 傷は深いわね…
#. de: Was für schlimme Wunden!
#. fr: La blessure est profonde...
msgctxt "Balloon:3396:0:1"
msgid "That wound looks deep..."
msgstr "Рана глубокая..."

#. ja: 急いで！<br>ダンシング・ウルフ大闘士の援護を
#. de: Beeil dich! Tanzender Wolf schwebt in größter Gefahrrr!
#. fr: Vite<nbsp>! Allez aider le capitaine<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3397:0:1"
msgid "Quickly!<br>Captain Wolf needs you!"
msgstr "Скорее!<br>Капитан Волк нуждается в помощи!"

#. ja: フン！
#. de: Uff!
#. fr: Hmph<nbsp>!
msgctxt "Balloon:3398:0:1"
msgid "Hrah!"
msgstr "Храх!"

#. ja: デヤッ！
#. de: Da!
#. fr: Yaaah<nbsp>!
msgctxt "Balloon:3399:0:1"
msgid "Grah!"
msgstr "Грах!"

#. ja: 見せてやる！
#. de: Ich zeig's dir!
#. fr: Je vais vous montrer<nbsp>!
msgctxt "Balloon:3400:0:1"
msgid "I'll show you!"
msgstr "Я тебе покажу!"

#. ja: せやぁッ！
#. de: Uwaaah!
#. fr: Prends ça<nbsp>!
msgctxt "Balloon:3401:0:1"
msgid "Heh heh..."
msgstr "Хе-хе..."

#. ja: 断ち切るッ！
#. de: Machen wir dem Spiel ein Ende!
#. fr: Évite ça, pour voir<nbsp>!
msgctxt "Balloon:3402:0:1"
msgid "Enough!"
msgstr "Хватит!"

#. ja: 痛いですよ！
#. de: Aua!
#. fr: Aïe<nbsp>!
msgctxt "Balloon:3403:0:1"
msgid "That stings!"
msgstr "Щиплет!"

#. ja: うわぁ…<br>なんだコレ！？
#. de: Ist der echt?
#. fr: C'est quoi, à votre avis<nbsp>?
msgctxt "Balloon:3404:0:1"
msgid "Just look at it!"
msgstr "Только посмотрите!"

#. ja: 空飛ぶトカゲだ！
#. de: Der ist ja wiiinzig!
#. fr: C'est un lézard ailé<nbsp>!
msgctxt "Balloon:3405:0:1"
msgid "It's so scaly..."
msgstr "Весь в чешуе..."

#. ja: しゃべるんだぜ！<br>コイツ！
#. de: Ob man auf dem reiten kann?
#. fr: Vous avez entendu<nbsp>? Il parle<nbsp>!
msgctxt "Balloon:3406:0:1"
msgid "Did it just speak!?"
msgstr "Он что, только что заговорил?!"

#. ja: 未知の空間だからな<br>気をつけて進もう
#. de: Vorsichtig. Wir müssen auf alles gefasst sein.
#. fr: Restez sur vos gardes, on ne sait rien de cette dimension.
msgctxt "Balloon:3407:0:1"
msgid "No telling what awaits. Stay sharp."
msgstr "Кто знает, что нас ждёт. Будьте начеку."

#. ja: デルタ世界ってのは<br>どこですかね…
#. de: Wo ist nun diese Deltametrie?
#. fr: Où peut bien se trouver ce fameux Deltastice<nbsp>?
msgctxt "Balloon:3408:0:1"
msgid "So, er, where do we go exactly?"
msgstr "Так... Э-э, куда нам идти?"

#. ja: そもそも道がないな
#. de: Ich sehe keinen Weg.
#. fr: Bizarre, je ne vois aucun chemin...
msgctxt "Balloon:3409:0:1"
msgid "Would help if there were a path."
msgstr "Вот бы ещё дорога была."

#. ja: この床、動きそうッス！
#. de: Der Boden vibriert ein bisschen ...
#. fr: Là, cette partie du sol a l'air mobile<nbsp>!
msgctxt "Balloon:3410:0:1"
msgid "Hm, I think this floor moves."
msgstr "Хм, кажется, пол движется."

#. ja: よし、みんな輪の中へ！
#. de: Stellt euch mal alle in den Ring!
#. fr: Tous dans le cercle<nbsp>!
msgctxt "Balloon:3411:0:1"
msgid "Let's all gather at the center."
msgstr "Давайте все соберёмся в центре."

#. ja: 動いたッス！
#. de: Uoooh!
#. fr: On grimpe<nbsp>!
msgctxt "Balloon:3412:0:1"
msgid "Aha!"
msgstr "Ага!"

#. ja: お楽しみの始まりだ
#. de: Jetzt fängt der Spaß an!
#. fr: Les festivités commencent à partir d'ici<nbsp>!
msgctxt "Balloon:3413:0:1"
msgid "Let the fun begin."
msgstr "Ну, начнём веселье!"

#. ja: あれは…<br>レベルチェッカーか？
#. de: Das Ding da vorn soll wohl unsere Kampfkraft testen!
#. fr: Là-bas... C'est un vérifiniveau<nbsp>?
msgctxt "Balloon:3414:0:1"
msgid "Is that one of those monitors?"
msgstr "Это один из тех мониторов?"

#. ja: 戦えってことかね！
#. de: Ich gebe ihm gerne eine Demonstration, hehe!
#. fr: On le démolit, c'est ça<nbsp>?
msgctxt "Balloon:3415:0:1"
msgid "Shall we show our strength to it?"
msgstr "Покажем ему, на что способны?"

#. ja: さっきの連中とは<br>型が違うらしい
#. de: Scheint ein anderes Modell zu sein als das letzte.
#. fr: Sa forme est un peu différente par rapport à ceux de tout à l'heure...
msgctxt "Balloon:3416:0:1"
msgid "It's different to the ones earlier."
msgstr "Не такой, как те, что были раньше."

#. ja: ブロック…？
#. de: Ein Kubus?
#. fr: ... C'est quoi ce cube<nbsp>?
msgctxt "Balloon:3417:0:1"
msgid "What's this cube, now?"
msgstr "Что это ещё за куб?"

#. ja: 様子がおかしいぞ
#. de: Da steckt mehr dahinter ...
#. fr: Bizarre, bizarre...
msgctxt "Balloon:3418:0:1"
msgid "I suspect we're about to find out."
msgstr "Похоже, скоро узнаем."

#. ja: オイラなりの<br>戦い方があるッス！
#. de: Wir Ingenieure haben auch ein paar Kampftechniken drauf!
#. fr: Hé hé, c'est mon heure de gloire<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3419:0:1"
msgid "Now, <i>this</i> is my kind of battle!"
msgstr "Вот это <i>моя</i> битва!"

#. ja: 必ずバリアを解くッス！<br>解析を急ぐッス！
#. de: Ich hab's gleich! Gebt mir 73 Sekunden!
#. fr: L'analyse est lancée<nbsp>! Encore un peu de patience<nbsp>!
msgctxt "Balloon:3420:0:1"
msgid "Hold on! I'm working on it!"
msgstr "Погодите! Я уже работаю над этим!"

#. ja: 何か出た…<br>転移装置ッス？
#. de: Ist das ein Teleporter?
#. fr: C'est quoi ça<nbsp>? Une sorte de téléporteur<nbsp>?
msgctxt "Balloon:3421:0:1"
msgid "Some kind of teleporter?"
msgstr "Что-то вроде телепорта?"

#. ja: 進めということか
#. de: Sieht aus, als dürften wir weitergehen.
#. fr: Il n'y a qu'une façon de le savoir.
msgctxt "Balloon:3422:0:1"
msgid "Looks like we're going through."
msgstr "Похоже, придётся пройти."

#. ja: た、試してみるッス！
#. de: I-Ich versuch's!
#. fr: Quand faut y aller...
msgctxt "Balloon:3423:0:1"
msgid "I'll give it a try!"
msgstr "Я попробую!"

#. ja: 倒れる、ものかッ！
#. de: Gehst du nie zu Boden?
#. fr: Vous ne pouvez pas me battre<nbsp>!
msgctxt "Balloon:3424:0:1"
msgid "I'll not fall that easily!"
msgstr "Так просто меня не одолеть!"

#. ja: 結局こういう裏賭博が<br>一番儲かるんだよなぁ
#. de: Verdoppeln wir den Einsatz?
#. fr: Heu<shy>reu<shy>se<shy>ment qu'on a les paris clandestins pour arrondir notre salaire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3425:0:1"
msgid "Were you going to bet, or<br>just stare at that two till<br>it magically becomes an ace?"
msgstr "Ты ставить собирался или так и будешь пялиться на двойку, пока она сама в туза не превратится?"

#. ja: こんなとこ見つかったら<br>俺たち捕まるけどな
#. de: Warum nicht? Wenn der Kommandant uns erwischt, streicht er den Pott sowieso ein.
#. fr: Boucle-la<nbsp>! Tu veux nous faire arrêter, ou quoi<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3426:0:1"
msgid "Pipe down. Makin' yer<br>sorry arse sweat is<br>all part o' me strategy."
msgstr "Тише. Заставить тебя понервничать — часть моей стратегии."

#. ja: て、帝国兵を…<br>先に…！
#. de: Die Garlear ... Sie sind ...
#. fr: Il faut... d'abord s'occuper... des Impériaux...
msgctxt "Balloon:3427:0:1"
msgid "The imperials are everywhere..."
msgstr "Имперцы повсюду..."

#. ja: 救援なのか…！？
#. de: Bist du hier, um zu helfen?!
#. fr: Des secours<nbsp>!?<nbsp>...
msgctxt "Balloon:3428:0:1"
msgid "Reinforcements?"
msgstr "Подмога?"

#. ja: お、俺は大丈夫…<br>奥にいる仲間を…！
#. de: Ich schaffe es alleine. Bitte hilf meinen Kameraden, weiter hinten!
#. fr: Ça va aller... Mes camarades, par contre...
msgctxt "Balloon:3429:0:1"
msgid "I'm fine! See to the others!"
msgstr "Со мной всё в порядке! Помогите остальным!"

#. ja: グッ…<br>ここまで…なのか…
#. de: Das ist also mein Ende ...
#. fr: Arrggh... Non, pas comme ça...
msgctxt "Balloon:3430:0:1"
msgid "It can't end here..."
msgstr "Неужели это конец?.."

#. ja: 怪しげな石像は…
#. de: Zeigt euch, Golems!
#. fr: Pas de statue suspecte en vue...
msgctxt "Balloon:3431:0:1"
msgid "Come out, come out, wherever you are!"
msgstr "Выходи, выходи, где бы ты ни был!"

#. ja: いったい、何処に…
#. de: Wo verstecken sie sich nur ...
#. fr: Golems, petits golems...
msgctxt "Balloon:3432:0:1"
msgid "Confound it, wherever are they hiding?"
msgstr "Да где же они прячутся?"

#. ja: ゴーレムの気配が…
#. de: Sie sind hier. Ich spür sie ...
#. fr: Aucune trace de notre golem...
msgctxt "Balloon:3433:0:1"
msgid "They are close. I can sense it..."
msgstr "Они близко. Я их чувствую..."

#. ja: この周囲は、僕らが探そう
#. de: Da! Nein, das war nur ein Baum ...
#. fr: On va jeter un œil autour d'ici.
msgctxt "Balloon:3434:0:1"
msgid "Was that─? Oh, that's just a tree..."
msgstr "Мы поищем вокруг."

#. ja: おい、待てって！
#. de: He, warte!
#. fr: Hé, attends-moi<nbsp>!
msgctxt "Balloon:3435:0:1"
msgid "H-Hey, wait!"
msgstr "Э-эй, подожди!"

#. ja: 張り切ってるな<br>俺たちも行こう！
#. de: Alle eifrig bei der Sache ... Dann lasst uns mal folgen.
#. fr: Ils nous ont grillé la politesse... On les suit<nbsp>?
msgctxt "Balloon:3436:0:1"
msgid "Heh, someone's eager. Come on, let's follow."
msgstr "Хех, кто-то не терпится. Пойдём за ними."

#. ja: よ、容赦ないくぽ
#. de: Es reicht nicht, kupo.
#. fr: Pourquoi taper si fort, kuppo<nbsp>?
msgctxt "Balloon:3437:0:1"
msgid "Foolish...fool..."
msgstr "Глупец... глупец..."

#. ja: ぽんぽん…ダメ…
#. de: Mein Bommel glüht!
#. fr: Mon pompon est tout aplati, kuppo...
msgctxt "Balloon:3438:0:1"
msgid "Not the pom..."
msgstr "Не помпон..."

#. ja: …スヤァ
#. de: Ich mach die Flatter.
#. fr: J'ai beau être matinal, j'ai mal, kuppo...
msgctxt "Balloon:3439:0:1"
msgid "I'm too young to kupo..."
msgstr "Я слишком молод, чтобы купо..."

#. ja: まさか、ゴーレムは…
#. de: Wie ich vermutet hatte ...
#. fr: C'est donc ça que cherchent les golems...
msgctxt "Balloon:3440:0:1"
msgid "It is just as I thought."
msgstr "Всё именно так, как я и думал."

#. ja: 彗星の軌道が…
#. de: Dann wird das Unheil wirklich eintreten.
#. fr: La comète est en train de dévier de sa trajectoire<nbsp>!?
msgctxt "Balloon:3441:0:1"
msgid "Our worst fears are confirmed..."
msgstr "Худшие опасения подтвердились..."

#. ja: 残るは3人か…
#. de: Bleiben noch drei ...
#. fr: Plus que trois...
msgctxt "Balloon:3442:0:1"
msgid "That leaves three..."
msgstr "Осталось трое..."

#. ja: 沖合の母船へ急げ！
#. de: Zurück zum Schiff, schnell!
#. fr: Au bateau-mère, vite<nbsp>!
msgctxt "Balloon:3443:0:1"
msgid "Back to the ship!"
msgstr "Назад на корабль!"

#. ja: 積荷は確認したか？
#. de: Hast du die Ladung überprüft?
#. fr: Vous avez vérifié la cargaison<nbsp>?
msgctxt "Balloon:3444:0:1"
msgid "The cargo is secure?"
msgstr "С грузом всё в порядке?"

#. ja: クク、次も楽しみだぜ
#. de: Hehe, ich bin ja so gespannt!
#. fr: Hé hé, j'ai hâte de découvrir la suite<nbsp>!
msgctxt "Balloon:3445:0:1"
msgid "Hehe, I wonder what awaits."
msgstr "Хе-хе, интересно, что нас ждёт дальше."

#. ja: あわわ…<br>敵が増えてるッス
#. de: Uh! Das sind aber mehr als letztes Mal!
#. fr: Oh non, un comité d'accueil...
msgctxt "Balloon:3446:0:1"
msgid "Uh, there's more this time."
msgstr "Ой, в этот раз их больше."

#. ja: また違う型だな
#. de: Wieder ein anderes Modell ...
#. fr: Leur forme est très... rafraîchissante.
msgctxt "Balloon:3447:0:1"
msgid "Yet another model."
msgstr "И снова другая модель."

#. ja: あわてず…冷静に…！
#. de: Ruhig bleiben, Wedge ... Nicht zittern!
#. fr: Ça va charcler dans les ventilos<nbsp>!
msgctxt "Balloon:3448:0:1"
msgid "Steady does it, Wedge..."
msgstr "Спокойно, Уэдж..."

#. ja: また出たッス！
#. de: Da sind noch mehr!
#. fr: Tadaaa<nbsp>!
msgctxt "Balloon:3449:0:1"
msgid "Look, another teleporter!"
msgstr "Смотрите, ещё один телепорт!"

#. ja: 新たな転移装置か
#. de: Der nächste Teleporter!
#. fr: Voilà le téléporteur suivant<nbsp>!
msgctxt "Balloon:3450:0:1"
msgid "And on we go..."
msgstr "Ну что ж, идём дальше..."

#. ja: ひ、ひぃ！<br>命だけは…
#. de: N-Nein! Lass mich am Leben!
#. fr: Hiii<nbsp>! P-p-pitiéééé<nbsp>!<nbsp>...
msgctxt "Balloon:3451:0:1"
msgid "Not like this..."
msgstr "Только не так..."

#. ja: や、やめてくれッ！
#. de: B-Bitte nicht!
#. fr: N-non, p-pas ça...
msgctxt "Balloon:3452:0:1"
msgid "Mercy!"
msgstr "Пощадите!"

#. ja: 順調ッス！
#. de: Läuft ja wie geschmiert!
#. fr: C'est reparti pour un tour de manège<nbsp>!
msgctxt "Balloon:3453:0:1"
msgid "Moving along like clockwork!"
msgstr "Идём как по часам!"

#. ja: 淀みなく前を目指すか…
#. de: Ihr kennt kein Zaudern und Zögern ...
#. fr: Vous n'hésitez jamais à plonger dans l'inconnu...
msgctxt "Balloon:3454:0:1"
msgid "You know no hesitation."
msgstr "Вы никогда не медлите."

#. ja: それがヒトってもンでね
#. de: Tja, so sind wir, wir Sterblichen!
#. fr: Que veux-tu, on est humains<nbsp>!
msgctxt "Balloon:3455:0:1"
msgid "Well, of course. We're mortal."
msgstr "Ну, мы же смертные."

#. ja: 足回りを強化すべきか…
#. de: Wir müssen das Fahrgestell noch verstärken.
#. fr: On devrait peut-être renforcer le châssis...
msgctxt "Balloon:3456:0:1"
msgid "We may need to strengthen the undercarriage..."
msgstr "Похоже, придётся укрепить ходовую часть..."

#. ja: 軸受改良　必要よ～
#. de: Die Lager sind einfach nicht gut genug.
#. fr: Il nous faudrait des roulements plus solides pour les roues.
msgctxt "Balloon:3457:0:1"
msgid "These bearings are not good enough."
msgstr "Этих подшипников недостаточно."

#. ja: まさか敵襲か！？
#. de: Werden wir angegriffen?!
#. fr: Une attaque ennemie<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3458:0:1"
msgid "Who goes there!?<br>Show yourselves!"
msgstr "Кто здесь!?<br>Покажитесь!"

#. ja: 物音がしたな…
#. de: Was war das?!
#. fr: J'ai entendu un bruit suspect...
msgctxt "Balloon:3459:0:1"
msgid "What was that...?"
msgstr "Что это было?.."

#. ja: 正面に巨大構造物…<br>あれがデルタ世界か？
#. de: Dieses Ding da vorne ... Ist das die Deltametrie?
#. fr: Ce gros œuf droit devant nous... Vous croyez que c'est le Deltastice<nbsp>?
msgctxt "Balloon:3460:0:1"
msgid "That structure ahead must be the Deltascape."
msgstr "Вон то сооружение впереди — должно быть, Дельтаскейп."

#. ja: レベルチェッカーが2体…<br>最後の難関ッス！？
#. de: Gleich zwei Monitore! Das wird knifflig.
#. fr: Deux vérifiniveaux pour le prix d'un... Ça doit être l'ultime épreuve.
msgctxt "Balloon:3461:0:1"
msgid "And there're two monitors in the way..."
msgstr "И ещё два монитора на пути..."

#. ja: ぶっ殺せ！
#. de: Macht Hackfleisch aus <if $gn4>ihr<else>ihm</if>!
#. fr: Faites-en de la chair à pâté<nbsp>!
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "Balloon:3462:0:1"
msgid "Kill <if $gn4>her<else>him</if>!"
msgstr "Убей<if $gn4>её<else>его</if>!"

#. ja: 下手くそ！
#. de: Warum seid ihr so unfähig?!
#. fr: Bande de nazes<nbsp>!
msgctxt "Balloon:3463:0:1"
msgid "Bah! Bloody waste o' coin!"
msgstr "Чтоб тебя! Деньги на ветер!"

#. ja: なにしてる！
#. de: Worauf wartet ihr?
#. fr: Vous attendez quoi<nbsp>!?
msgctxt "Balloon:3464:0:1"
msgid "The hells you doin'!?"
msgstr "Какого чёрта вы там копаетесь?!"

#. ja: ぶった切れ！
#. de: Schneidet <if $gn4>sie<else>ihn</if> in Scheiben!
#. fr: Tranchez-<if $gn4>la<else>le</if> en deux<nbsp>!
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "Balloon:3465:0:1"
msgid "Hack <if $gn4>her<else>him</if> to pieces!"
msgstr "Разрубите <if $gn4>её<else>его</if> на куски!"

#. ja: くそったれ！
#. de: Verdammter Mist!
#. fr: Saloperie<nbsp>!
msgctxt "Balloon:3466:0:1"
msgid "Godsdammit!"
msgstr "Проклятье!"

#. ja: 早く殺せ！
#. de: Wann stirbt <if $gn4>die<else>der</if> endlich?
#. fr: Tu vas crever, ouais<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "Balloon:3467:0:1"
msgid "Hurry up and make<br><if $gn4>her<else>him</if> dead already!"
msgstr "Ну убейте же <if $gn4>её<else>его</if> скорее!"

#. ja: 感謝いたします…<br>どうぞ御礼の品を…
#. de: Bitte nimm dies als Zeichen meines Dankes entgegen ...
#. fr: Veuillez accepter ce modeste présent pour votre aide...
msgctxt "Balloon:3468:0:1"
msgid "Please accept this gift as thanks for your services."
msgstr "Примите этот подарок в благодарность за помощь."

#. ja: えっ…何が起きたのです？
#. de: W-Was ist geschehen?
#. fr: Au-au nom des kami, qu'est-il arrivé<nbsp>!?
msgctxt "Balloon:3469:0:1"
msgid "What has happened here!?"
msgstr "Что здесь произошло?!"

#. ja: 侵入者っちゃ！？
#. de: Eindringlinge!
#. fr: Des intruuus<nbsp>!?
msgctxt "Balloon:3470:0:1"
msgid "Looters!?"
msgstr "Грабители!?"

#. ja: ご馳走は渡さないっちゃ！
#. de: Fresst sie!
#. fr: Pas question d'abandonner miam miam<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3471:0:1"
msgid "Man-flesh is ours!<br>Man-flesh is ours!"
msgstr "Человечина наша!<br>Человечина наша!"

#. ja: 横取り禁止っちゃ！
#. de: Such dir dein eigenes <if ($gn11 < 12)><if ($gn11 < 4)>Abendessen<else>Frühstück</if><else><if ($gn11 < 17)>Mittagessen<else>Abendessen</if></if>!
#. fr: Pas voler nouuurrituuure<nbsp>!
msgctxt "Balloon:3472:0:1"
msgid "Go and loot your own loots!"
msgstr "Идите и сами добывайте добычу!"

#. ja: お前も食べてやるっちゃ！
#. de: Du siehst eigentlich auch ganz lecker aus!
#. fr: Huuumain<if $gn4>e</if> devenir à manger aussi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3473:0:1"
msgid "Eat your flesh too<br>for this trespass!"
msgstr "И твою плоть съедим<br>за вторжение!"

#. ja: この先は危ないぞぉ～
#. de: Da draußen könnt ihr nicht ...... überleben.
#. fr: Attention, c'est dangereux par lààà.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3474:0:1"
msgid "You don't want...<br>to go back there."
msgstr "Тебе не стоит...<br>возвращаться туда."

#. ja: トンッ、トンッと…
#. de: Wie ich den ins Dorf kriege, überleg ich mir später.
#. fr: Et je coupe, coupe, coupe...
msgctxt "Balloon:3475:0:1"
msgid "This'll make a fine hull."
msgstr "Из этого выйдет отличный корпус."

#. ja: キミも入るっぺか？
#. de: Zwei sind noch fffrei!
#. fr: C'est occupé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3476:0:1"
msgid "No room.<br>Move along."
msgstr "Мест нет.<br>Проходи."

#. ja: 見つかったっぺよ～
#. de: Ich bin hier oooben!
#. fr: Je joue à cache-cache perché<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3477:0:1"
msgid "My pot.<br>Here first."
msgstr "Мой горшок.<br>Я первый."

#. ja: なかなかの居心地っぺな
#. de: Hier drinnen ist es richtig kuschelig!
#. fr: C'est plus confortable que de se cacher dans un carton.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3478:0:1"
msgid "AAAHHH!!!<br>Don't scare me like that!"
msgstr "Тут так уютно!<br>ААА!!! Не пугай меня так!"

#. ja: かくれんぼっぺよ！
#. de: Ich geh wieder aufff Tauchstation. Gluck!
#. fr: Bouh<nbsp>!
msgctxt "Balloon:3479:0:1"
msgid "Nothing to see here."
msgstr "Тут ничего нет."

#. ja: さぁ、寄った寄った！<br>お買い得だよ！
#. de: Der kluge Mann kauft günstig im Dutzend!
#. fr: Approchez, approchez<nbsp>! Bibelots et souvenirs à prix cassés<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3480:0:1"
msgid "Fortune smiles on<br>the wise shopper!"
msgstr "Подходите, подходите!<br>Удачная покупка сулит удачу!"

#. ja: どれもひんがしの国の<br>情緒に富んだ逸品ですよ
#. de: Ich versichere Euch, alle meine Artikel wurden in Hingashi hergestellt!
#. fr: Vous emporterez bien chez vous un peu de l'esprit de Hingashi<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3481:0:1"
msgid "But <i>of course</i> all you<br>see here is authentic!"
msgstr "Но <i>разумеется</i>, всё<br>здесь подлинное!"

#. ja: また義賊が出たんだってよ！
#. de: Ich sag dir doch, es war ein <i>Pirat</i>! Er hatte sogar eine Augenklappe!
#. fr: Le gentilhomme cambrioleur  a encore frappé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3482:0:1"
msgid "He was a damned pirate,<br>I tell you. He had an<br>eyepatch!"
msgstr "Да он проклятый пират,<br>говорю тебе! И с повязкой<br>на глазу!"

#. ja: この壺…もしやあの名品…
#. de: Welch kunstvoll gearbeitete Töpferware! Sag, würdest du sie mir verkaufen?
#. fr: Cette jarre... C'est une pièce unique, n'est-ce pas<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3483:0:1"
msgid "Where did you find that<br>amazing earthenware?<br>Might you be interested<br>in selling?"
msgstr "Где вы нашли эту<br>чудесную керамику?<br>Не хотите продать?"

#. ja: またお尋ねものか…
#. de: Ich weiß, dass ich etwas<br>suche ... Aber was nur?
#. fr: Encore des avis de recherche...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3484:0:1"
msgid "If I could only recall<br>what I was searching for..."
msgstr "Вот бы вспомнить,<br>что же я искал..."

#. ja: まったく…<br>赤誠組は何をしてるんだい
#. de: Schon wieder ein neues Verbot? Was bildet sich die Sekiseigumi nur ein?!
#. fr: Mais que fait le Sekiseigumi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3485:0:1"
msgid "The Sekiseigumi bastards<br>will be the death of us!"
msgstr "Чтоб этих мерзавцев из Сэкисэйгуми!<br>Они нас всех погубят!"

#. ja: うむ！<br>絶景かな！
#. de: Was für ein prächtiger Ausblick!
#. fr: Je ferais bien tomber le bas...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3486:0:1"
msgid "It feels like I'm wearing<br><i>nothing at all</i>."
msgstr "Кажется, будто на мне<br><i>вообще ничего нет</i>."

#. ja: お前らの将来<br>背負ってるからな！
#. de: Wenn's mal eng wird, kannst du dich dahinter verkriechen.
#. fr: Tais-toi et masse<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3487:0:1"
msgid "Lower...<br>Lower...<br>Loooweeer..."
msgstr "Ниже...<br>Ниже...<br>Ещё ниже..."

#. ja: オジキ！<br>いい背中っすね！
#. de: Boss, dein starker Rücken ist echt 'ne Pracht.
#. fr: Je n'ai jamais vu des trapèzes aussi bien ciselés...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3488:0:1"
msgid "My, what broad<br>shoulders you have."
msgstr "Какие у вас<br>широкие плечи!"

#. ja: お肌スベスベになるわ～
#. de: Willst du dich nicht zu uns setzen?
#. fr: Je commence à avoir chaud...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3489:0:1"
msgid "Would you like<br>to join us?"
msgstr "Не хотите<br>присоединиться?"

#. ja: 俺様に喧嘩を売るとは<br>いい度胸してんな！
#. de: Na los! Schlag schon zu!
#. fr: Viens donc, hé, banane<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3490:0:1"
msgid "Go on! You can have<br>the first punch!"
msgstr "Давай! Можешь<br>ударить первым!"

#. ja: おぉ！こいや！<br>あの世に送ってやんよ！
#. de: Nicht doch, der erste Hieb gehört dir.
#. fr: Je vais te défriser la moustache<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3491:0:1"
msgid "No, <i>you</i> can have the<br>first punch!"
msgstr "Нет, <i>ты</i> можешь ударить<br>первым!"

#. ja: いいぞ！<br>やっちゃえ～
#. de: Was ist denn das für eine Schlägerei? Fangt endlich an!
#. fr: J'adore les duels inoffensifs<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3492:0:1"
msgid "Would someone just<br>punch someone already?"
msgstr "Да ударьте уже<br>кто-нибудь кого-нибудь!"

#. ja: エイッ！
#. de: Immer ...
#. fr: Bravoure<nbsp>!
msgctxt "Balloon:3493:0:1"
msgid "Strength!"
msgstr "Сила!"

#. ja: ヤァッ！
#. de: ... auf ...
#. fr: Gloire<nbsp>!
msgctxt "Balloon:3494:0:1"
msgid "Honor!"
msgstr "Честь!"

#. ja: トォー！
#. de: ... den Kopf!
#. fr: Bonté<nbsp>!
msgctxt "Balloon:3495:0:1"
msgid "Blood!"
msgstr "Кровь!"

#. ja: アァ！？<br>なんだテメェ！
#. de: Hier hast du nichts verloren, <if $gn4>Fremde<else>Fremder</if>.
#. fr: Tu t'es <if $gn4>perdue<else>perdu</if>, <if $gn4>étrangère<else>étranger</if><nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3496:0:1"
msgid "Back the way ye came,<br>filthy ijin."
msgstr "Вали туда, откуда пришёл,<br>грязный гайдзин."

#. ja: 下駄直し～<br>草鞋もあるよ～
#. de: Sandalen! Gute Sandaaalen! Für linke und rechte Füße!
#. fr: Sandales pas chères<nbsp>! <i>Geta</i> ou <i>waraji</i>, faites votre choix<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3497:0:1"
msgid "Sandals! Get your sandals!<br>Guaranteed to last or your<br>next pair is free!"
msgstr "Сандалии! Налетай!<br>Прослужат долго, а если<br>порвутся — следующая пара бесплатно!"

#. ja: モグモグ…
#. de: Wenn Vater erfährt, dass du seine Zeichnungen von den Mägden gesehen hast ...
#. fr: (mâche)... Qu'est-che que tu lis<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3498:0:1"
msgid "Father will kill you if he<br>finds out you took his<br>drawings of the pretty maids."
msgstr "Отец тебя убьёт, если<br>узнает, что ты взял его<br>рисунки хорошеньких служанок."

#. ja: こちらの茶のほうが<br>好みだなぁ
#. de: Der Tee ist ein echtes Werk der Liebe. Nicht so eine lieblos angerührte Brühe wie in dem anderen Teehaus.
#. fr: Le thé vert, c'est vraiment ma tasse de thé, ho ho ho...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3499:0:1"
msgid "The tea here is sublime.<br>Not like the swill they<br>serve at that teahouse<br>across town."
msgstr "Здесь подают превосходный чай.<br>Не то что пойло в той<br>чайной на другом конце города."

#. ja: 一意専心！<br>刀に心を込めるのだ！
#. de: Leert eure Köpfe und werdet eins mit dem Schwert.
#. fr: Ne faites qu'un avec votre lame<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3500:0:1"
msgid "You must clear your<br>mind and become one<br>with the blade."
msgstr "Очистите разум<br>и слейтесь с клинком."

#. ja: ここのお団子おいし～ね～
#. de: ... und jetzt zerbeiß ich's!
#. fr: Je préfère les <i>dango</i> aux fleurs.
msgctxt "Balloon:3501:0:1"
msgid "Not now. Eating dango."
msgstr "Не сейчас. Я ем данго."

#. ja: 風が気持ちいいな～
#. de: Ich bin der König der Weeelt!
#. fr: Je vole au vent<nbsp>!
msgctxt "Balloon:3502:0:1"
msgid "I believe I could fly..."
msgstr "Мне кажется, я могу летать..."

#. ja: うぃっ！<br>俺は酔っぱらってね～ど…
#. de: En'schuldigung ... \<hicks> ... Könn' Sssie bitte meine Ehe reparieren?
#. fr: C'est qui que tu traites d'ivrogne<nbsp>!?
msgctxt "Balloon:3503:0:1"
msgid "I'm drunk!? YOU'RE drunk!"
msgstr "Я пьян!? Да это ты пьян!"

#. ja: 孫が赤誠組に入隊したの！
#. de: Und dann ist sie aus dem Haus gerannt und der Sekiseigumi beigetreten!
#. fr: Mon petit-fils a été admis dans le Sekiseigumi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3504:0:1"
msgid "...And then she stormed<br>out saying she was joining<br>the Sekiseigumi!"
msgstr "...А потом она выскочила<br>из дома и заявила, что<br>вступит в Сэкисэйгуми!"

#. ja: うまいな～<br>これが寿司か！
#. de: Was soll's? Die Hinganer essen sie auch ohne Stäbchen.
#. fr: En sushis, c'est encore meilleur.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3505:0:1"
msgid "Rhalgr take yer sticks!<br>Me hands'll do me fine."
msgstr "Да ну эти палочки Ралгра!<br>Руками мне сподручнее."

#. ja: こいつぁ<br>箸がとまらね～
#. de: Wenn man schaufelt, geht's leichter.
#. fr: Le riz, c'est la vie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3506:0:1"
msgid "These 'ere sticks make<br>fer good shovels, like."
msgstr "Эти палочки —<br>отличные лопатки."

#. ja: お芝居、面白かったわね～
#. de: Das Bühnenstück war famos! Bis die Angel des Fischers sich in der Kulisse verfing ...
#. fr: Vous aimez le théâtre<nbsp>? Moi, j'adore ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3507:0:1"
msgid "That was the most<br>amazing play I've seen!<br>...Well, this week at least."
msgstr "Это была самая<br>потрясающая пьеса!<br>...Ну, на этой неделе."

#. ja: 禁制品は…なさそうね
#. de: Schreib auf: Eine Kiste, zwei Fässer - beschlagnahmt.
#. fr: Ces mar<shy>chan<shy>di<shy>ses m'ont l'air en règle.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <if ($gn11 < 12)><if ($gn11 < 4)>sunrise<else>midday</if><else><if ($gn11 < 17)>sundown<else>sunrise</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 12 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gn11 < 4)>sunrise<else>midday</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 4 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gn11 < 17)>sundown<else>sunrise</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 17 (condition: may be reworded, restructured, added, or dropped)
msgctxt "Balloon:3508:0:1"
msgid "I will need to see what<br>is in this crate and these<br>barrels before <if ($gn11 < 12)><if ($gn11 < 4)>sunrise<else>midday</if><else><if ($gn11 < 17)>sundown<else>sunrise</if></if>."
msgstr "Надо проверить, что<br>в этом ящике и бочках,<br>пока не наступит <if ($gn11 < 12)><if ($gn11 < 4)>рассвет<else>полдень</if><else><if ($gn11 < 17)>закат<else>рассвет</if></if>."

#. ja: 船を手配しております<br>しばらくお待ちください
#. de: Ich bitte vielmals um Entschuldigung. Die Barke wird jeden Augenblick hier sein.
#. fr: Ne vous inquiétez pas, votre bateau arrivera sous peu.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3509:0:1"
msgid "A thousand apologies.<br>Your skiff will be here<br>at any moment."
msgstr "Тысяча извинений.<br>Ваша лодка будет<br>с минуты на минуту."

#. ja: 御用だ、御用だ！
#. de: Alarm! Alarm!
#. fr: Halte-là<nbsp>!
msgctxt "Balloon:3510:0:1"
msgid "Sound the alarm!"
msgstr "Тревога!"

#. ja: もう逃げられんぞ！<br>大人しくお縄につけ！
#. de: Du entkommst uns nicht!
#. fr: Tu es fait comme un rat<nbsp>!
msgctxt "Balloon:3511:0:1"
msgid "You will not escape us!"
msgstr "От нас не уйдёшь!"

#. ja: ようこそクガネへ！
#. de: Ich heiße Euch willkommen, werte Reisende.
#. fr: Je vous souhaite un agréable séjour à Kugane.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3512:0:1"
msgid "Make yourselves at<br>home, honored travelers."
msgstr "Добро пожаловать в<br>Куганэ, дорогие гости."

#. ja: ぐるぐるぐる～
#. de: Woher kommt eigentlich der ganze Wind?
#. fr: Trop beau...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3513:0:1"
msgid "Come on. It's my turn<br>to play with the stick."
msgstr "Ну же. Теперь моя очередь<br>поиграть палкой."

#. ja: 若女形の顔見世公演だよ～<br>見てってくんな～
#. de: Herrreinspaziert! Nie sah man Männer so graziös tanzen!
#. fr: Venez admirer les nouveaux talents de notre troupe<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3514:0:1"
msgid "Come inside, traveler!<br>We've dancers of all<br>shapes and sizes!"
msgstr "Заходи, путник!<br>У нас танцоры на любой<br>вкус и цвет!"

#. ja: え～！<br>私、見てみた～い！
#. de: Was soll das heißen, du möchtest lieber alleine ins Badehaus?
#. fr: On va voir, dis<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3515:0:1"
msgid "What is this I hear of you<br>bathing with the locals!?"
msgstr "Это что ещё за слухи, будто ты<br>с местными в бане моешься?!"

#. ja: 知ってる？<br>実はお城に…
#. de: Ich habe gehört, man hält sie im Burgverlies fest ...
#. fr: (J'ai entendu de drôles de rumeurs au sujet du château...)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3516:0:1"
msgid "(I hear they keep her<br>in the castle dungeons...)"
msgstr "(Говорят, её держат<br>в подземельях замка...)"

#. ja: うちの旦那は働きもせず<br>三条花街に入り浸ってて…
#. de: Mein nichtsnutziger Mann ist gestern wieder nicht nach Hause gekommen. Die Sekiseigumi hat ihn in Sanjo gefunden - im Rinnstein!
#. fr: Mon mari rentre à des heures tardives, ces temps-ci. Je le soupçonne de passer ses nuits à Sanjo Hanamachi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3517:0:1"
msgid "My good-for-nothing<br>husband spends morning<br>and night under Sanjo's<br>red lamps, the lech!"
msgstr "Мой никчёмный муж<br>с утра до ночи шляется<br>под красными фонарями<br>Сандзё, гуляка этакий!"

#. ja: ここはウルダハ商館である！
#. de: Weißt du, wer den letzten Mithril-Pokal im Kolosseum gewonnen hat?
#. fr: Bienvenue au Bazar de Rubis.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3518:0:1"
msgid "'Tis good to see a<br>fellow Eorzean."
msgstr "Рад повстречать<br>земляка из Эорзеи."

#. ja: このままじゃ<br>納期に間に合わないぞ！
#. de: Wenn der Alte glaubt, ich mach noch ne Zwanzig-Glocken-Schicht, dann hat er sich aber geschnitten.
#. fr: On ne livrera jamais à temps à ce rythme-là<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3519:0:1"
msgid "If the piermaster thinks<br>I'm to work another<br>twenty-bell shift, he's as<br>daft as he looks!"
msgstr "Если начальник причала думает,<br>что я ещё двадцать колоколов<br>пахать буду, он совсем<br>с ума спятил!"

#. ja: 資材…届きましたけど…<br>あの…重いっす…
#. de: W-Wo soll ich das hinlegen?
#. fr: Ç-ça vous dérange si je pose ça quelque part<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3520:0:1"
msgid "Eight lengths.<br>Just as you asked, sir."
msgstr "Восемь отрезков.<br>Как вы и просили, сэр."

#. ja: 体がベタベタするな～<br>望海泉でも行くか？
#. de: Ich glaub, ich müffel. Kommste mit ins Bokaisen?
#. fr: Va savoir pourquoi, j'ai envie de faire trempette dans les sources de Bokaisen...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3521:0:1"
msgid "Fancy a dip down at<br>the springs?"
msgstr "Не хочешь искупаться<br>в горячих источниках?"

#. ja: 船を磨いて男を磨け！<br>船を磨いて男を磨け！
#. de: Bis man sich drin spiegelt, Männer!
#. fr: Polir, lustrer, frotter<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3522:0:1"
msgid "Clean enough to<br>eat off, men!"
msgstr "Чтоб аж есть с палубы<br>можно было, парни!"

#. ja: こんなん運べるかって…
#. de: Das soll ich alles tragen? Und wer trägt <i>mich</i>?
#. fr: Argh... J'ai une crampe au mollet<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3523:0:1"
msgid "Carry all this!?<br>Who's going to carry <i>me</i>!?"
msgstr "И всё это тащить?!<br>А кто <i>меня</i> понесёт?!"

#. ja: くぅぅ～！<br>働いた後の酒はうまいねえ
#. de:  <i>Unser</i> Glück, dass die Pullen auf keiner Frachtliste auftauchen!
#. fr: Saké ferme, moussaillons<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3524:0:1"
msgid "Was right kind of them<br>to leave all this wine in<br>their cargo! Gahahaha!"
msgstr "Добрые люди оставили<br>весь этот ром в грузе!<br>Га-га-га!"

#. ja: クガネの漢なら<br>これぐらい軽いもんよ！
#. de: Sollen wir die auch noch auf seinen Wagen laden? He he.
#. fr: C'est normal si tu ne sens plus ton bras. C'est le métier qui rentre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3525:0:1"
msgid "Think we should add<br>another to his cart? Hahaha!"
msgstr "Может, ещё один ему<br>на телегу подкинем? Ха-ха!"

#. ja: そうだ！<br>気合い入れて叩けよ！
#. de: Sag, wenn ich dich ablösen soll.
#. fr: C'est ça<nbsp>! J'aime quand tu cognes bien fort<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3526:0:1"
msgid "Hurry! Before the<br>steel cools!"
msgstr "Живее, пока<br>сталь не остыла!"

#. ja: フフフ…<br>やはり刀は美しい
#. de: Fertige jede Klinge mit so viel Sorgfalt, als wäre es deine eigene, hat der Meister gesagt.
#. fr: Une lame n'est jamais trop aiguisée.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3527:0:1"
msgid "A blade can never<br>be <i>too</i> sharp, now."
msgstr "Клинок не бывает<br><i>слишком</i> острым."

#. ja: ブロックも<br>多くなりそうだ…
#. de: Da erwartet uns ja einiges ...
#. fr: Ça sent le déluge de cubes...
msgctxt "Balloon:3528:0:1"
msgid "Ten gil says there're more cubes too."
msgstr "Гил на то, что кубиков там ещё больше."

#. ja: 心して突破するぞ！
#. de: Augen zu und durch!
#. fr: On reste concentrés jusqu'au bout<nbsp>!
msgctxt "Balloon:3529:0:1"
msgid "Stay focused! We're almost there!"
msgstr "Не расслабляться! Мы почти у цели!"

#. ja: うおおおぉぉ！<br>正念場ッス！
#. de: Uoooh! Jetzt geht's aber rund!
#. fr: Ça passe ou ça casse<nbsp>!
msgctxt "Balloon:3530:0:1"
msgid "Yaaargh! Moment of truth!"
msgstr "А-а-а! Вот он, решающий миг!"

#. ja: 丸太のような太ももに！<br>丸太のような太ももに！
#. de: Ich nenne den Kommandanten nie wieder einen verlogenen Drückeberger.
#. fr: Si l'un de nous deux doit craquer, ce ne sera pas moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3531:0:1"
msgid "I won't break first...<br>I won't break first..."
msgstr "Не сломаюсь первой...<br>Не сломаюсь первой..."

#. ja: お前、気合い入ってるなー
#. de: Das sind doch bloß Ausreden.
#. fr: Au moins, ton nom est facile à retenir.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3532:0:1"
msgid "What kind of name is that<br>anyway? Eastern highland?"
msgstr "Что это вообще за имя?<br>Из восточных нагорий?"

#. ja: 今日の狩りも<br>上手くいったね～
#. de: Guck mal, was ich gefangen habe. Nicht schlecht, was?
#. fr: La chasse a été bonne, aujourd'hui encorrre.
msgctxt "Balloon:3533:0:1"
msgid "Make a fine rug, that one."
msgstr "Из него выйдет отличный ковёр."

#. ja: うーん<br>うまく射られないよ～
#. de: Es will einfach nicht so richtig flutschen.
#. fr: Ce serait plus facile avec une vrrraie cible...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3534:0:1"
msgid "What are we supposed<br>to be aiming at again?"
msgstr "А мы вообще во что<br>целиться должны?"

#. ja: 見張りも楽じゃないね…
#. de: Wenn man zu lange in die Einöde starrt, sehen die kargen Bäume mit der Zeit wie monströse Hände aus, die aus dem Boden ragen. Unheimlich.
#. fr: C'est tout un arrrt de monter la garde...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3535:0:1"
msgid "There!<br>No... Just a rabbit...<br>There! Over there!<br>No... Just a badger..."
msgstr "Вон!<br>Нет... Просто кролик...<br>Вон там!<br>Нет... Просто барсук..."

#. ja: オラのかわいい大砲ちゃ～ん
#. de: Mein Baby ...
#. fr: Tu es le plus beau des canons...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3536:0:1"
msgid "Treat a cannon like you'd<br>treat a woman and if you're<br>lucky, she won't blow your<br>face off. The cannon, that is."
msgstr "С пушкой обращайся, как с женщиной: повезёт — лицо не разнесёт. Я про пушку, конечно."

#. ja: シュー…たまにはこうして<br>足を休めなければな
#. de: Esss ist eine Wohltat, nach einem langen Tag mal das Schwanzende auszuruhen ...
#. fr: C'est fatigant de se dresser constamment sur sa queue. Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3537:0:1"
msgid "If you people knew how<br>hard it was to balance<br>on these tails all day..."
msgstr "Вот бы вам знать,<br>как тяжело целый день<br>на хвосте балансировать..."

#. ja: シュー…調子が悪いな<br>どこか壊れたか？
#. de: Ha! Wieder einer Geröllmaus einen neuen Ssscheitel gezogen!
#. fr: Mon arc tire de travers... Serait-il cassé<nbsp>? Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3538:0:1"
msgid "Curssses! Sssomeone's<br>been using my bow!"
msgstr "Проклятие! Кто-то<br>пользовался моим луком!"

#. ja: シュー…踏み込みが甘い！
#. de: Beim Fechten entscheidet die Beinarbeit, heißt es. Einfacher gesssagt, als getan ...
#. fr: Tes mouvements sont trop prévisibles<nbsp>! Ssss...
msgctxt "Balloon:3539:0:1"
msgid "Your tailwork is pathetic!"
msgstr "Хвостом работать ты<br>совсем не умеешь!"

#. ja: シュー…<br>ネズミ一匹見落とさぬぞ…
#. de: Nichts entgeht meinem ssscharfen Blick ... Ist das ein Teleoceras oder eine Flimmermaus?
#. fr: Rien n'échappe à mon regard. Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3540:0:1"
msgid "Not a single rat in,<br>not a single rat out."
msgstr "Ни одна крыса<br>не проскочит."

#. ja: やる気が出ないな
#. de: Ich hab so was von keine Lust mehr ...
#. fr: J'ai une de ces flemmes...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3541:0:1"
msgid "I suppose I could go back<br>to work... I also suppose I<br>could slay young Zenos in<br>a duel."
msgstr "Можно бы и вернуться<br>к работе... А можно вызвать<br>молодого Зеноса на дуэль<br>и прикончить его."

#. ja: あいつ…<br>どこいった？
#. de: Bei den Zwölf! Wo ist er hin?
#. fr: Bon, où est passé ce sacripant<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3542:0:1"
msgid "Now where in the seven<br>hells did he go?"
msgstr "Куда, во имя семи<br>преисподних, он подевался?"

#. ja: 見つかっちゃうだろ！
#. de: Geh weg! Die finden mich noch!
#. fr: Caftez pas à mon frère que je suis là, d'accord<nbsp>?
msgctxt "Balloon:3543:0:1"
msgid "Get lost! They'll find me!"
msgstr "Отвали! Они меня найдут!"

#. ja: これもダメか…
#. de: Nichts und wieder nichts.
#. fr: Toujours rien... C'est pas mon jour de chance.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3544:0:1"
msgid "A bucketful of naught,<br>this here is."
msgstr "И целое ведро<br>ничегошеньки."

#. ja: はぁ…石ばっかり…
#. de: Nichts als Steine. Es ist ein Wunder, dass hier überhaupt etwas wächst außer Hass.
#. fr: Cette terre rocailleuse est un cauchemar à cultiver...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3545:0:1"
msgid "There's more rock here<br>than soil. It's a miracle<br>anything grows at all."
msgstr "Тут камней больше,<br>чем земли. Чудо, что<br>вообще хоть что-то растёт."

#. ja: 力強く育つのよ…
#. de: Wenn das verfault, haben wir nichts für den Winter.
#. fr: J'aimerais être aussi forte et résistante que ces plantes...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3546:0:1"
msgid "If the blight takes these,<br>we won't last through<br>the winter."
msgstr "Если гниль их погубит,<br>зиму нам не пережить."

#. ja: このアラック、うめえ！
#. de: Gib mir mehr von dem Arrak, Kamerad! Meine Flasche ist futsch! Ha ha ha!
#. fr: Cet arak, c'est de la bonne<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3547:0:1"
msgid "Pass me that arak, friend!<br>My bottle is mysteriously<br>empty. Hah hah hah!"
msgstr "Передай-ка аррак, дружище!<br>Моя бутылка загадочным<br>образом опустела. Ха-ха-ха!"

#. ja: 喜んでいいのかしら…
#. de: Ja, aber dann wäre sie ja schon seit sechs Monden ...
#. fr: Ç-ça se discute...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3548:0:1"
msgid "Wait...<br>But that would mean─"
msgstr "Погоди...<br>Но тогда получается..."

#. ja: むう、汚れがとれん
#. de: Der Ruß muss raus, sonst geht das Ding nach hinten los. Und das will ich vermeiden.
#. fr: C'est fou, la quantité de crasse qu'il y a là-dedans.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3549:0:1"
msgid "Must keep the barrels<br>free of soot, or it'll be<br>our heads flying come war."
msgstr "Надо вычистить стволы,<br>а то на войне наши головы<br>взлетят на воздух."

#. ja: 住民感情に注意か…
#. de: Rücksicht nehmen? Auf die Zivilisten?
#. fr: Rassurer les civils, oui, mais comment<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3550:0:1"
msgid "Thanking them? They<br>should be thanking us<br>for protecting their<br>backwood arses!"
msgstr "Благодарить их? Это они<br>должны благодарить нас<br>за защиту своих захолустных<br>задниц!"

#. ja: あれが流星の天蓋…
#. de: Ein ziemlicher Brummer, der Kristall.
#. fr: C'est donc ça, le fameux “Dais de la Comète”...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3551:0:1"
msgid "Biggest crystal east of<br>the Velodyna, you say?<br>I've seen bigger."
msgstr "Говоришь, крупнейший кристалл<br>к востоку от Велодины?<br>Видал я и побольше."

#. ja: まだまだ気は抜けんな
#. de: Guck meine Mädchen noch mal so an und ich mach dich einen Kopf kürzer!
#. fr: Il est trop tôt pour se relâcher.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3552:0:1"
msgid "Iffin I find either o' yous<br>dockin' the dells o' any<br>o' these here maids, I'll<br>cut ye neck to crotch."
msgstr "Если хоть кто-то из вас<br>полезет к одной из этих<br>девиц, перережу глотку<br>от уха до уха."

#. ja: 槍に異常なしっと
#. de: Einen besseren Speer hab ich nie besessen.
#. fr: Ma lance a vécu, mais elle transperce toujours aussi bien.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3553:0:1"
msgid "A fine spear, she is.<br>I cannot rightly say I've<br>e'er seen finer."
msgstr "Хорошо копьё, ничего не скажешь.<br>Лучше мне вовек не встречалось."

#. ja: この子のために、<br>私が頑張らなくちゃ…
#. de: Papin, hol doch der Mama mal 'n Glas Wasser, ja?
#. fr: Je dois continuer de me battre, aussi bien pour moi que pour Papin.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3554:0:1"
msgid "Papin, darling. Would you<br>mind fetching your ma<br>a skin of water?"
msgstr "Папин, милый. Не сбегаешь<br>за флягой воды для мамы?"

#. ja: 畑仕事は堪えるのう…
#. de: Schon der Bulle pflügte diese Felder, und zwar mit einem Zehn-Tonzen-Stein, den er mit bloßen Händen aus dem Yorn brach.
#. fr: Le travail des champs est rude, mais je dois m'en accommoder.
#. macro: <br> — a line break (may be added or dropped)
#, aeria-term-model-exception: mount 72e4270a2115
msgctxt "Balloon:3555:0:1"
msgid "They say the Bull tilled<br>this very soil by dragging<br>a ten-tonze boulder he<br>broke from Mount Yorn."
msgstr "Говорят, сам Бык вспахал<br>эту землю, волоча за собой<br>валун в десять тонзов,<br>отколотый от горы Йорн."

#. ja: 約束はただひとつ！<br>必ず生きて帰ってくることだ！
#. de: Jetzt versprecht mir nur noch eins: Dass ihr lebendig heimkehrt!
#. fr: Rappelez-vous<nbsp>: votre unique priorité est de revenir ici vivants<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3556:0:1"
msgid "You have one mission<br>and one mission only─<br>to make it back here alive!"
msgstr "Задание у вас одно-единственное —<br>вернуться сюда живыми!"

#. ja: チョコボの調子も<br>よさそうだな
#. de: Die Vögel sehen prächtig aus!
#. fr: Nos chocobos sont en grande forme.
#. macro: <br> — a line break (may be added or dropped)
#, aeria-term-model-exception: mount 72e4270a2115
msgctxt "Balloon:3557:0:1"
msgid "The mounts are<br>watered and fed?"
msgstr "Скакуны напоены и накормлены?"

#. ja: 切れ味は鈍ってないかな…
#. de: Hm ... Könnte schärfer sein.
#. fr: Je le savais, ma lame est tout émoussée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3558:0:1"
msgid "Sharpened this so many<br>times it'll cut you if you<br>even look at the blade!"
msgstr "Столько раз точил, что<br>теперь от одного взгляда<br>на лезвие порежешься!"

#. ja: 俺の力、見せてやる！
#. de: Zieh den Kopf ein, sonst ist er ab!
#. fr: Ma botte secrète<nbsp>: fourche tournoyante<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3559:0:1"
msgid "Sure, spinning th' fork over<br>me head leaves th' belly<br>exposed... But it looks epic!"
msgstr "Конечно, крутя вилой<br>над головой, я подставляю<br>живот... Зато выглядит<br>внушительно!"

#. ja: 張りが弱いかな…
#. de: Der Wind. Ich muss auf den Wind achten.
#. fr: Peut-être que je ne bande pas assez mon arc...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3560:0:1"
msgid "Naught like the twang of<br>catgut in the morning...<br>or evening, for that matter."
msgstr "Нет ничего лучше звона<br>тетивы на рассвете...<br>Хотя вечером тоже."

#. ja: この先へ帝国兵が逃げたような…
#. de: Ich glaub, da vorne haben sich noch ein paar Garlear versteckt.
#. fr: J'ai vu un Impérial s'enfuir par là.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <if $gn4>milady<else>milord</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "Balloon:3561:0:1"
msgid "Saw an imperial run back<br>this way, I did. You going<br>to gut 'im, <if $gn4>milady<else>milord</if>?"
msgstr "Видал я, как имперец назад побежал. Собираешься его кишки выпустить, <if $gn4>миледи<else>милорд</if>?"

#. ja: 私たちは自由なの？
#. de: Sind wir jetzt wirklich frei?
#. fr: Sommes-nous vraiment libres<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3562:0:1"
msgid "But are we <i>truly</i> free?"
msgstr "Но свободны ли мы <i>по-настоящему</i>?"

#. ja: 久々のうまい酒だ！
#. de: Ha ha! Und noch einen Schluck auf den Sieg!
#. fr: Ça change du tord-boyaux que je m'envoie d'habitude<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3563:0:1"
msgid "Liberrraded ale's the<br>bestesest of ales... \\<hic>"
msgstr "Освобо-ождённый эль — лу-лучший из элей... <i>Ик!</i>"

#. ja: 実は、やりたいことがあって…
#. de: Also zuerst möchte ich mir einen anständigen Beruf suchen. Sänger oder Tänzer oder so ...
#. fr: J'adorerais me reconvertir dans le spectacle...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3564:0:1"
msgid "I's thinkin' of joining<br>a mummer's troupe."
msgstr "Думаю вступить<br>в бродячую труппу."

#. ja: 時代を変えたいと思わないか！
#. de: Jetzt geht es aufwärts! Seht mich an ...!
#. fr: N'avez-vous jamais rêvé de changer le monde<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3565:0:1"
msgid "Are we but cattle<br>to be led to slaughter!?"
msgstr "Неужели мы просто скот,<br>который гонят на убой?!"

#. ja: いいぞ！いいぞ！
#. de: Ja! Jaaa!
#. fr: Aux chiottes l'Empire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3566:0:1"
msgid "Yeah!<br>...I mean, no!"
msgstr "Да!<br>То есть, нет!"

#. ja: ふぅ～やっと一息つけるぜ
#. de: Endlich mal wieder Zeit für ein Pfeifchen ...
#. fr: Pfiou... Je savoure chaque seconde de répit.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3567:0:1"
msgid "All men should be<br>allowed a single vice."
msgstr "Каждому мужику<br>положен хоть один порок."

#. ja: 来るなら来いよ！
#. de: Ja, dann komm doch und beweis es mir!
#. fr: Tu veux jouer les gros bras<nbsp>? OK, amène-toi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3568:0:1"
msgid "Wouldn't want me to<br>mess up that pretty face<br>now, would you?"
msgstr "Неужто не хочешь<br>испортить такую<br>милую мордашку?"

#. ja: うぇっぷ…飲みすぎた…
#. de: Das war wohl ein Siegestrünkchen zuviel ... Uäääh!
#. fr: Urgh... J'ai la gerbe...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3569:0:1"
msgid "Whydo I e'en bother<br>drinkin' it if I's juss goina<br>leaveitall 'ere onna street?"
msgstr "Зачем я его пью, если потом<br>всё равно вываливаю на улицу?"

#. ja: 長かったわね…
#. de: Wie lange ist es her? Jedenfalls viel zu lange ...
#. fr: Franchement, j'ai arrêté de compter les jours...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3570:0:1"
msgid "This has been<br>a long time coming."
msgstr "Давно пора было."

#. ja: 内臓は無事だ！<br>しっかりしろ！
#. de: Keine inneren Verletzungen ... und das Bein wird schon wieder!
#. fr: Accroche-toi, l'ami, tu vas t'en sortir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3571:0:1"
msgid "We'll need to make an<br>incision here...and here."
msgstr "Тут сделаем надрез...<br>И здесь."

#. ja: 痛み止め、まだ作れるかな…
#. de: Für ein paar Notfall-Tränke sollte es noch reichen.
#. fr: Voilà qui devrait calmer sa douleurrr.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3572:0:1"
msgid "I've thinned this tonic so<br>many times, an ale would<br>work better to numb the<br>patients' aches."
msgstr "Я столько раз разбавлял<br>этот тоник, что эль теперь<br>лучше обезболит."

#. ja: 寝ちまったか…
#. de: Endlich ist er eingeschlafen.
#. fr: Il a l'air tellement paisible...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3573:0:1"
msgid "Here's to hopin' he's<br>in a better place..."
msgstr "Будем надеяться,<br>там ему лучше..."

#. ja: 気を抜いたが最後<br>帰ってこれないと思え！
#. de: Wer keine Lust mehr hat, kann ja gehen! Na? Wer ist der Erste?
#. fr: La moindre seconde d'inattention peut être fatale<nbsp>! Est-ce clair<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3574:0:1"
msgid "The moment you let your<br>guard down is the moment<br>you die. Do I make myself<br>clear!?"
msgstr "Стоит вам расслабиться —<br>и вы трупы. Ясно вам?!"

#. ja: でいやぁーっ！！
#. de: Nimm das, Zenos!
#. fr: Cette statue m'a regardé de travers<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3575:0:1"
msgid "This statue's as<br>hard as a rock!"
msgstr "Эта статуя крепкая,<br>как камень!"

#. ja: 焦るなよ、オレ…！
#. de: Nicht ablenken lassen, Wedge<nbsp>...
#. fr: Reste calme, Biggs, tu peux le faire<nbsp>!
msgctxt "Balloon:3576:0:1"
msgid "Come on, Biggs, you can do this..."
msgstr "Ну же, Биггс, ты справишься..."

#. ja: どこに隠れたっぺか～？
#. de: Ich fffind dich noch!
#. fr: Bon, où est-ce qu'il s'est caché<nbsp>?
msgctxt "Balloon:3577:0:1"
msgid "Now, where are those mummers off hiding?"
msgstr "Ну и где же эти бродячие артисты прячутся?"

#. ja: 米、味噌、酒……<br>よし！
#. de: Reis, Miso, Sake, Revolver, Seide ... Moment, Revolver?
#. fr: Du riz, du miso, du saké... Rien de suspect a priori.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3578:0:1"
msgid "Rice, miso, sake,<br>revolvers, silk...wait,<br>revolvers?"
msgstr "Рис, мисо, сакэ,<br>револьверы, шёлк... Погоди,<br>револьверы?"

#. ja: この臭い…<br>噴火が近いな…
#. de: Ich liebe den Geruch von Schwefel am Morgen.
#. fr: Hmm... L'odeur de soufre est par<shy>ti<shy>cu<shy>liè<shy>rement forte, ces temps-ci...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3579:0:1"
msgid "The smell of sulphur is<br>strong on the wind, today."
msgstr "Сегодня от ветра<br>сильно несёт серой."

#. ja: 圧倒的な存在感だね…
#. de: Schön anzuschauen. Der Gestank hingegen ...
#. fr: Le Couvercle des enfers me fascine toujours autant...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3580:0:1"
msgid "I never grow tired of<br>watchin' the Lid. The<br>stench, now, is another<br>matter."
msgstr "Не устаю любоваться Крышкой.<br>А вот вонь — совсем другое дело."

#. ja: 台場に動きなーし
#. de: Situation normal.
#. fr: La mer est calme, le vent est frais et l'horizon est dégagé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3581:0:1"
msgid "Naught amiss at<br>the Price...yet."
msgstr "У Прайса пока<br>всё спокойно."

#. ja: この辺りに<br>沈んでいるはず…
#. de: Es muss direkt unter uns sein. Ich spüre es!
#. fr: Si je ne me trompe pas, c'est par ici qu'il a coulé...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3582:0:1"
msgid "It's right under us.<br>I can <i>feel</i> it!"
msgstr "Он прямо под нами.<br>Я это <i>чувствую</i>!"

#. ja: ここは帝国領だ！<br>立ち去れ！
#. de: Dieses Land gehört dem Kaiser. Verschwinde oder trage die Konsequenzen!
#. fr: Tu es en territoire impérial, ici. Alors tu fais comme dans l'infanterie et tu te tires ailleurs<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3583:0:1"
msgid "This land has been lawfully<br>claimed by the Empire.<br>Begone or you will be...<br>dealt with."
msgstr "Эти земли законно принадлежат Империи.<br>Убирайся, иначе мы...<br>примем меры."

#. ja: お前は…
#. de: Du ...!
#. fr: Toi...
msgctxt "Balloon:3584:0:1"
msgid "You..."
msgstr "Ты..."

#. ja: 即刻、去れ！
#. de: Keinen Schritt weiter! Ich hab dich gewarnt.
#. fr: Fais demi-tour, c'est un ordre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3585:0:1"
msgid "Do not take another step<br>further into the village!<br>You have been warned!"
msgstr "Ни шагу дальше, в деревню!<br>Предупреждаю в последний раз!"

#. ja: 上出来、上出来…
#. de: Die kann ich auf dem Markt teuer verkaufen.
#. fr: Hé hé, ces poissons se négocient à prix d'or.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3586:0:1"
msgid "These will fetch quite<br>the price at market."
msgstr "На рынке за них<br>дадут хорошую цену."

#. ja: ヒック…あれ？<br>モトゴエが3人も…
#. de: W-Wie viel F-Finger s-sind das? \<hicks>
#. fr: Hips<nbsp>! Bah... Pourquoi y a trois Motogoe et deux Inuoi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3587:0:1"
msgid "Hic...! How manyfinners am<br>I hollin'up? Wait! Dontellme...<br>Free─hic─no four! Seven!"
msgstr "Ик...! Сколько пальцев я держу? Погодь! Не говори... Три—ик—нет, четыре! Семь!"

#. ja: おい！<br>いつまで数えてんだよ！？
#. de: Wie lange willst du die noch zählen?
#. fr: Jusqu'à quand tu comptes vérifier ces mar<shy>chan<shy>di<shy>ses<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3588:0:1"
msgid "You need some help?<br>There's <i>one</i> box, and<br><i>two</i> casks. Now can<br>we go?"
msgstr "Помочь тебе?<br>Тут <i>один</i> ящик и<br><i>две</i> бочки. Ну, пойдём?"

#. ja: お助けを…
#. de: Hilfe! Der Kerl da ... hat sie nicht mehr alle!
#. fr: Maman, j'ai peur...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3589:0:1"
msgid "You! You've got to save<br>us. This man... He's not<br>right in the head! Please!"
msgstr "Ты! Спаси нас, умоляю!<br>Этот человек... Он не в себе!<br>Пожалуйста!"

#. ja: 頭の部屋にゃ<br>誰も入れねえぞ
#. de: Ich lass dich nich' durch, auch wenn du mich noch so nett bittest.
#. fr: Personne n'entre là-dedans. Ce sont les ordres.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3590:0:1"
msgid "Only way through them<br>doors is iffin I's carryin'<br>yer nob in a sack."
msgstr "Через эту дверь пройдёшь,<br>только если я понесу твою<br>башку в мешке."

#. ja: 父ちゃんの握り飯うめ～！
#. de: Mein Vater macht die besten Reisbällchen und wenn einer was anderes behauptet ...
#. fr: Personne ne fait d'aussi bonnes boulettes de riz que mon papa<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3591:0:1"
msgid "Da makes the best rice<br>balls in the village, and<br>I'll plug the gob of any<br>who'll say he don't!"
msgstr "Отец в деревне лучше всех<br>лепит рисовые шарики!<br>Кто скажет иначе — тому<br>рот заткну!"

#. ja: 割れちゃったぁ～
#. de: Die Riffe vor Sakazuki, die sind schuld.
#. fr: Hé, mais... la coque est fissurée, ma parole<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3592:0:1"
msgid "Sprung a damned leak<br>when I took her o'er the<br>shoals near Sakazuki."
msgstr "Проклятая течь появилась,<br>когда я проходил мимо<br>мелей Саказуки."

#. ja: 惚れ惚れするなぁ～
#. de: Wunderschön, so<nbsp>...... wunderschön.
#. fr: Mes trésors chériiiis...
msgctxt "Balloon:3593:0:1"
msgid "Most beautiful... Yes..."
msgstr "Красота... Да..."

#. ja: ケフサンは物知りだなぁ～
#. de: Deine Weisheit ist so tief wie die See.
#. fr: Tu en sais, des chooooses.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3594:0:1"
msgid "Your wisdom is as<br>bounteous as the sea."
msgstr "Ты мудр, как само море."

#. ja: ピッカピカにするぞぉ～
#. de: Ich sehe immer noch einen<nbsp>...... Flecken.
#. fr: J'aime quand ça briiiille<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3595:0:1"
msgid "Whose shell is it again<br>that I've been polishing<br>all day?"
msgstr "Чью раковину я весь день<br>полирую-то?"

#. ja: 心頭滅却！
#. de: Öffnet euren Geist ...<br>Öffnet euren Geist ...<br>Öffnet euren Geist ...
#. fr: Ne pensez à rien<nbsp>! Faites le vide dans votre esprit<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3596:0:1"
msgid "Open your minds...<br>Open your minds...<br>Open your minds..."
msgstr "Освободите разум...<br>Освободите разум...<br>Освободите разум..."

#. ja: 今日こそ、話をしたいが…
#. de: Ob sie mich mag?
#. fr: Il serait temps que je me décide à lui parler...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3597:0:1"
msgid "Do you think she's noticed<br>me standing here for the<br>past twelve bells?"
msgstr "Как думаешь, она заметила,<br>что я уже двенадцать колоколов<br>тут стою?"

#. ja: 漁具の準備はよし…と
#. de: Jede Harpune hat ihren Platz.
#. fr: Tous les harpons sont rangés... C'est parfait<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3598:0:1"
msgid "A place for every gig<br>and every gig in its place."
msgstr "Каждому багру своё место,<br>и каждый багор на месте."

#. ja: オレのおごりだ、呑め！
#. de: Um uns ist nichts als Wasser und was machst du? Trinken!
#. fr: Fais-toi plaisir, c'est ma tournée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3599:0:1"
msgid "Water, water, everywhere<br>and all you do is drink!"
msgstr "Кругом одна вода,<br>а вы только и делаете, что пьёте!"

#. ja: は～<br>大事な酒が…
#. de: Das wird meinen Brüdern gar nicht gefallen ...
#. fr: Et zut... Je vais encore passer pour un manche.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3600:0:1"
msgid "My brothers aren't<br>going to like this..."
msgstr "Братьям это<br>не понравится..."

#. ja: …ハラ減った
#. de: Was ess ich nur?
#. fr: J'ai l'estomac dans les talons. Qu'est-ce que je vais bien pouvoir manger...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3601:0:1"
msgid "I'm so hungry, I could<br>eat a horse."
msgstr "Я так голоден, что<br>съел бы целую лошадь."

#. ja: 肉…ヨダレが…
#. de: Vielleicht ein saftiges Stück Lammfleisch?
#. fr: De la viande<nbsp>? Miam, elle a l'air bien juteuse... (bave)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3602:0:1"
msgid "Oh, and look.<br>They have some here..."
msgstr "О, глянь-ка.<br>Тут тоже есть..."

#. ja: カボチャを煮るのもいい
#. de: Oder doch lieber eine Kürbissuppe à la Windkante?
#. fr: De la citrouille<nbsp>? C'est bon pour la santé.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3603:0:1"
msgid "A nice, ripe squash would<br>go well with that horse..."
msgstr "Спелая тыква к этой<br>лошадке отлично пойдёт..."

#. ja: 米ってうまいのか…？
#. de: Reis? Hatte ich gestern.
#. fr: Du riz, ça cale bien l'estomac.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3604:0:1"
msgid "Never been that<br>fond of rice..."
msgstr "Рис я никогда<br>особо не любил..."

#. ja: 魚って気分じゃないな
#. de: Nach Fisch ist mir eigentlich nicht.
#. fr: Du poisson<nbsp>? Hmm, je n'ai pas envie de m'embêter avec les arêtes...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3605:0:1"
msgid "And these fish reek<br>of my tribe's latrine..."
msgstr "А эта рыба воняет<br>отхожим местом моего племени..."

#. ja: いっそ、全部まとめて<br>鍋にするとか…
#. de: Oder ich nehm von allem ein bisschen und mach mir einen Steppeneintopf.
#. fr: Et si je mélangeais tout ça dans un ragoût<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3606:0:1"
msgid "Though, enough pepper<br>in the pot, I could boil<br>my boot and I reckon it'd<br>taste fine enough."
msgstr "Хотя перцу в котёл<br>сыпани побольше — и хоть<br>сапог вари, всё равно<br>вкусно будет."

#. ja: 長旅には<br>うちのミルクがお勧めだよ！
#. de: Wenn du länger auf Reisen bist, empfehle ich dir eine Kanne Mammutmilch. Die hält ewig.
#. fr: Ne pars pas d'ici sans avoir goûté à mon lait<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3607:0:1"
msgid "Like to buy some milk?<br>Probably good and sour<br>by now!"
msgstr "Молочка купить?<br>Наверно, к этому времени<br>уже прокисло!"

#. ja: 編みカゴはいらない？
#. de: Soll ich dir einen Korb geben?
#. fr: Je t'offre un deuxième panier pour un gil de plus<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3608:0:1"
msgid "You look like you could<br>use a basket. Or perhaps<br>you know someone who<br>could use a basket?"
msgstr "Тебе бы корзинка не помешала.<br>А может, знаешь кого-нибудь,<br>кому она пригодится?"

#. ja: ……
#. de: ... ...
#. fr: ...
msgctxt "Balloon:3609:0:1"
msgid "........."
msgstr "........."

#. ja: メェ～
#. de: \<pups>
#. fr: Bêêê<nbsp>!
msgctxt "Balloon:3610:0:1"
msgid "Baaaaaa!"
msgstr "Бе-е-е-е!"

#. ja: ……
#. de: ... ... ...
#. fr: ...
msgctxt "Balloon:3611:0:1"
msgid "........."
msgstr "........."

#. ja: ……？
#. de: ... ...?
#. fr: ...<nbsp>?
msgctxt "Balloon:3612:0:1"
msgid ".........?"
msgstr ".........?"

#. ja: いい音色だな～
#. de: Ich könnte diesen Klängen ewig lauschen.
#. fr: Le timbre du morin khuur est vraiment unique.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3613:0:1"
msgid "You'll find none more<br>skilled with a morin khuur."
msgstr "Не найдёшь никого, кто<br>играл бы на морин хууре лучше меня."

#. ja: 子羊を守ってくれよ！
#. de: Pass auf, dass kein Lamm wegläuft. Verstehst du?
#. fr: Je compte sur toi pour protéger les agneaux, d'accord<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3614:0:1"
msgid "I'm to herd four score<br>rutting rams with <i>this</i>?"
msgstr "И я должен пасти восемьдесят<br>брачующихся баранов <i>этим</i>?"

#. ja: お乳がよく出ますように～
#. de: So ist gut ... Lass die Kleinen trinken ...
#. fr: Ça c'est une gentille brebis pleine de bon lait.♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3615:0:1"
msgid "Thirsty lambs... Leave<br>some for the tribe, now."
msgstr "Ягнята проголодались... Оставьте<br>и племени немного, ну."

#. ja: そこだ！いけ！
#. de: Los! Krall ihn dir!
#. fr: Il s'essouffle<nbsp>! Achève-le<nbsp>!
msgctxt "Balloon:3616:0:1"
msgid "Right between the legs!"
msgstr "Прямо между ног!"

#. ja: 腰を落として入り込め！
#. de: Tiefer in die Knie gehen! In die Knie!
#. fr: Cambre les reins et rentre-lui dans le lard<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3617:0:1"
msgid "Lose this fight and your<br>place at the fire is lost!"
msgstr "Проиграешь — и больше<br>у костра тебе не место!"

#. ja: フッ！ハッ！
#. de: Hmpf ...
#. fr: Hou<nbsp>! Ha<nbsp>! (halète)
msgctxt "Balloon:3618:0:1"
msgid "Closer... Closer!"
msgstr "Ближе... Ещё ближе!"

#. ja: ちょっと弓力が強いかな…
#. de: Ganz schön straff, die Sehne.
#. fr: Je devrais peut-être choisir un arc plus léger...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3619:0:1"
msgid "Too taut...<br>Much too taut."
msgstr "Натянута слишком...<br>Слишком туго."

#. ja: これに勝てば55戦28勝だ！
#. de: Es steht 49 zu 49. Der nächste Sieg entscheidet.
#. fr: Prêt à encaisser ta vingt-huitième défaite<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3620:0:1"
msgid "Come on! One more round!<br>Best twenty-eight out of<br>fifty-five!"
msgstr "Ну же! Ещё раунд!<br>Лучший из пятидесяти<br>пяти — двадцать восемь!"

#. ja: そろそろ弦を変えるか…
#. de: Ich sollte die Sehne mal wieder austauschen.
#. fr: La corde de mon arc est à deux doigts de lâcher...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3621:0:1"
msgid "What am I even doing with<br>this thing? I wanted to<br>learn the spear..."
msgstr "И что мне с этим делать?<br>Я ведь хотел научиться<br>драться копьём..."

#. ja: 太陽の子らよ…♪
#. de: ♪ Wir Kinder der Sonne ... ♪
#. fr: Tu es le soleil de mes nuits...♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3622:0:1"
msgid "Children of the dawn<br>let long your horns hang...♪"
msgstr "Дети зари,<br>пусть долго висят ваши рога...♪"

#. ja: 大地の恵みは…♪
#. de: ♪ Der Segen der Erde ... ♪
#. fr: Je suis née dans une caravane...♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3623:0:1"
msgid "On the east wind rides<br>the whisper of the land.♪"
msgstr "Восточный ветер несёт<br>шёпот земли.♪"

#. ja: 1368、1369回…
#. de: Zählst du noch mit?
#. fr: Ooon n'est pas fatigués<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3624:0:1"
msgid "Ten thousand three hun-<br>dred and sixty-eight.<br>Ten thousand three hun-<br>dred and sixty-nine."
msgstr "Десять тысяч триста шестьдесят<br>восемь.<br>Десять тысяч триста шестьдесят<br>девять."

#. ja: 最強…無敵…
#. de: Die Oronir sind die Stärksten!
#. fr: Je serai... le plus grand guerrier... de la steppe...
msgctxt "Balloon:3625:0:1"
msgid "I am the wind. I am the sky."
msgstr "Я — ветер. Я — небо."

#. ja: 次の狩りだが…
#. de: Morgen früh brechen wir auf, mit den ersten Sonnenstrahlen.
#. fr: Bien, dressons le bilan de la dernière chasse.
msgctxt "Balloon:3626:0:1"
msgid "Let us meditate on this."
msgstr "Давайте об этом поразмыслим."

#. ja: え～！面倒だよ～
#. de: Ich hab aber keine Lust!
#. fr: J'en ai marre d'être un enfant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3627:0:1"
msgid "Why must we learn letters<br>if it is our destiny to fight?"
msgstr "Зачем нам учиться читать,<br>если нам суждено сражаться?"

#. ja: 頑張りましょ
#. de: Streng dich ein bisschen mehr an!
#. fr: Oh, pauvre chou...
msgctxt "Balloon:3628:0:1"
msgid "Oh, quiet, you!"
msgstr "Ой, да замолчи ты!"

#. ja: 負けぬ！
#. de: Halt still, verdammt!
#. fr: Le premier qui tombe du rocher a perdu<nbsp>!
msgctxt "Balloon:3629:0:1"
msgid "Have at me!"
msgstr "Ну, давай!"

#. ja: この槍なら一発だな
#. de: Mammutblut soll deinen Schaft entlangrinnen!
#. fr: Je n'aimerais pas me faire embrocher par cette lance...
msgctxt "Balloon:3630:0:1"
msgid "A finer spear I have not seen."
msgstr "Лучше копья я не видывал."

#. ja: メェ～　メッメェ～<br>メェ～　メッメッメ～～～♪
#. de: ♪ Mäh, mähmäh, mähmäääh<nbsp>♪
#. fr: Bêêê, bêêê<nbsp>! Bê, bê bêêê<nbsp>!♪
msgctxt "Balloon:3631:0:1"
msgid "Baa, baa, baa!"
msgstr "Бе-е, бе-е, бе-е!"

#. ja: メェ～
#. de: Määäh ...
#. fr: Bêêê...
msgctxt "Balloon:3632:0:1"
msgid "Baa."
msgstr "Надо быть готовыми ко всему!"

#. ja: 不測の事態に備えよ！
#. de: Schön auf der Hut bleiben!
#. fr: Préparez-vous à tout imprévu<nbsp>!
msgctxt "Balloon:3633:0:1"
msgid "We must prepare for every contingency!"
msgstr "Да твои пушки «Берта» просто чертовски скорострельные!"

#. ja: 四連装対竜カノン…<br>なんという速射性能！
#. de: Die Feuerkraft dieser Drachenballisten ist enorm.
#. fr: La puissance de feu des canons anti-dragon est impressionannte<nbsp>!
msgctxt "Balloon:3634:0:1"
msgid "Those Bertha cannons of yours are bloody fast!"
msgstr "Да эти ваши пушки «Берта» палят чертовски быстро!"

#. ja: 艦砲射撃で鍛えた<br>砲術もなかなかのもの…
#. de: Eure Kanonen sind aber um nichts schwächer. Man sieht auch die lange Routine in der Handhabung.
#. fr: Les canons du Maelstrom ne sont pas en reste.
msgctxt "Balloon:3635:0:1"
msgid "The Maelstrom's cannons are no less impressive, from what I have seen..."
msgstr "Насколько я видел, пушки Мальстрёма ничуть не хуже..."

#. ja: アラミゴ奪還は目前だ！
#. de: Die Befreiung ist greifbar nahe!
#. fr: Ala Mhigo sera bientôt libre<nbsp>!
msgctxt "Balloon:3636:0:1"
msgid "This is it, lads!"
msgstr "Ну вот и всё, парни!"

#. ja: エオルゼアの結束力<br>今こそ示す時ぞ！
#. de: Hah! Das ist die Stärke des vereinten Eorzea!
#. fr: Ils vont voir l'union des peuples éorzéens<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3637:0:1"
msgid "Can ye hear us, Zenos!?<br>Eorzea is at yer gates!"
msgstr "Слышишь, Зенос!?<br>Эорзея уже у твоих ворот!"

#. ja: ええっと、つまり…？
#. de: Was willst du damit sagen?
#. fr: Je ne vois pas très bien où tu veux en venir...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3638:0:1"
msgid "I don't see where you are<br>going with this, Haname."
msgstr "Не понимаю, к чему ты<br>клонишь, Ханаме."

#. ja: 敵の動きを待つか…<br>だが、しかし…
#. de: Ich bin anderer Meinung. Wir sollten die Initiative ergreifen.
#. fr: Donc, on va continuer d'observer l'ennemi sans rien faire<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3639:0:1"
msgid "So we're just going<br>to sit and wait until<br>the enemy attacks!?"
msgstr "То есть мы просто будем<br>сидеть и ждать, пока<br>враг нападёт!?"

#. ja: まっ、まだまだ！
#. de: Wie viele denn noch?
#. fr: Tant que je ne pense pas à la douleur, ça va<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3640:0:1"
msgid "All we do is train!<br>When do we fight!?"
msgstr "Только и делаем, что тренируемся!<br>Когда уже в бой!?"

#. ja: 違う！<br>全身のバネを使うんだ！
#. de: Nein. Mehr aus der Hüfte.
#. fr: Ça manque de souplesse<nbsp>! Ne réfléchis pas, laisse aller ton corps<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3641:0:1"
msgid "Wrong! Float like a butter-<br>fly, sting like a <i>bee</i>, not<br>the other way around!"
msgstr "Неправильно! Легко, как<br>бабочка, жаль, как <i>пчела</i>!<br>А не наоборот!"

#. ja: いいぞ！<br>その調子だ！
#. de: So ist es gut! Das ist es!
#. fr: C'est mieux<nbsp>! Continue comme ça<nbsp>!
msgctxt "Balloon:3642:0:1"
msgid "Better! Better!"
msgstr "Лучше! Вот так!"

#. ja: よし、異常なーし！
#. de: Alles friedlich.
#. fr: Rien à signaler<nbsp>!
msgctxt "Balloon:3643:0:1"
msgid "And nothing over here."
msgstr "И здесь всё спокойно."

#. ja: どこに置くんだっけ…？
#. de: Und wohin jetzt damit?
#. fr: Mince, où est-ce que j'étais censé poser ça<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3644:0:1"
msgid "Pretend like she's not<br>watching me... Pretend<br>like she's not watching me."
msgstr "Сделать вид, будто она<br>не смотрит... Сделать вид,<br>будто она не смотрит."

#. ja: 腰が～曲が～りゃ<br>稲伸びる～♪
#. de: Der Rücken ist krumm ♪<br>Doch der Reis wächst gerade<nbsp>♪
#. fr: Si le dos souffre, c'est que le riz pousse<nbsp>!♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3645:0:1"
msgid "My grandmother would say,<br>“A crooked back makes<br>for straighter stalks.”"
msgstr "Бабушка говаривала:<br>«Чем больше спина гнётся,<br>тем ровнее рис растёт»."

#. ja: 獣はいないな
#. de: Die Minobi sind gefährlich, aber sie halten anderes Untier fern.
#. fr: Tant que les bêtes sauvages restent loin des rizières, il n'y a pas lieu de s'inquiéter.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3646:0:1"
msgid "Not a beast to be found...<br>Well, except for those<br>over there... And there..."
msgstr "Ни зверя не видать...<br>Ну, если не считать тех<br>вот... и вон тех..."

#. ja: あの子が帰ってくるまで<br>綺麗にしないと
#. de: Es soll alles ganz adrett aussehen, wenn sie zurückkommt.
#. fr: Je dois garder la place du village propre pour quand mon petit-fils reviendra...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3647:0:1"
msgid "I have to keep the square<br>clean for when my grand-<br>son returns from the war."
msgstr "Надо держать площадь<br>в чистоте, чтобы внук<br>вернулся с войны."

#. ja: けん、けん、ぱっ！
#. de: Ein Yanxia-Tiger, zwei Yanxia-Tiger ♪
#. fr: Un, deux, trois. Un, deux, ciel<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3648:0:1"
msgid "One, one, two.<br>One, one, two."
msgstr "Раз, раз, два.<br>Раз, раз, два."

#. ja: この先どうなるんだい？
#. de: Wie soll es jetzt weitergehen?
#. fr: Qu'est-ce qu'il y a par là<nbsp>?
msgctxt "Balloon:3649:0:1"
msgid "So what happens now?"
msgstr "Ну и что теперь?"

#. ja: 俺たちも戦いたいんだ！
#. de: Wir wollen auch kämpfen!
#. fr: Nous aussi, nous voulons nous battre<nbsp>!
msgctxt "Balloon:3650:0:1"
msgid "We can fight, godsdammit!"
msgstr "Да мы, чёрт побери, тоже умеем драться!"

#. ja: 帝国め！
#. de: Verdammte Garlear!
#. fr: Putain d'Impériaux<nbsp>!
msgctxt "Balloon:3651:0:1"
msgid "Imperial whoresons!"
msgstr "Чтоб этим имперцам пусто было!"

#. ja: しっかり備えておかないとな
#. de: Bereitet euch gut vor!
#. fr: Il faut bien se préparer<nbsp>!
msgctxt "Balloon:3652:0:1"
msgid "We must be ready to move at a moment's notice."
msgstr "Надо быть готовыми выступить в любой миг."

#. ja: 俺たちは誰の物でもない！
#. de: Wir sind jetzt unsere eigenen Herren!
#. fr: Nous sommes libres<nbsp>!
msgctxt "Balloon:3653:0:1"
msgid "Are we not men? Do we not bleed? Do we not deserve to be free!?"
msgstr "Разве мы не люди? Разве не истекаем кровью? Разве не заслужили свободы!?"

#. ja: 今後の予定は…
#. de: Meine Pläne ... Tja ...
#. fr: Vous faites quoi après<nbsp>?
msgctxt "Balloon:3654:0:1"
msgid "The plan is set..."
msgstr "План готов..."

#. ja: 帝国のやつ<br>叩きのめしてやるぜ！
#. de: Wir zeigen es den verfluchten Garlearn!
#. fr: Je vais éclater de l'Impérial<nbsp>!
msgctxt "Balloon:3655:0:1"
msgid "Won't be long now."
msgstr "Уже скоро."

#. ja: 怖いわ…<br>どうしたらいいの…
#. de: W-Was soll ich nur tun?
#. fr: Ouaaah<nbsp>! J'ai trop la pétoche<nbsp>!<nbsp>...
msgctxt "Balloon:3656:0:1"
msgid "If the fighting spreads here..."
msgstr "Если бои докатятся и сюда..."

#. ja: 決して気を緩めるなよ！
#. de: Nicht nachlassen!
#. fr: Ne vous relâchez pas<nbsp>!
msgctxt "Balloon:3657:0:1"
msgid "Trust in your comrades! Have faith in yourselves and mighty Rhalgr! Victory will be ours!"
msgstr "Доверяйте товарищам! Верьте в себя и великого Ралгра! Победа будет за нами!"

#. ja: はい！
#. de: Jawohl!
#. fr: À vos ordres<nbsp>!
msgctxt "Balloon:3658:0:1"
msgid "Sir, yes, sir!"
msgstr "Так точно, сэр!"

#. ja: はい！
#. de: Jawohl!
#. fr: À vos ordres<nbsp>!
msgctxt "Balloon:3659:0:1"
msgid "Sir, yes, sir!"
msgstr "Так точно, сэр!"

#. ja: はい！
#. de: Jawohl!
#. fr: À vos ordres<nbsp>!
msgctxt "Balloon:3660:0:1"
msgid "Sir, yes, sir!"
msgstr "Так точно, сэр!"

#. ja: やるな、チャクハ！
#. de: Du siehst fabelhaft aus, Tchakha!
#. fr: Bien joué, Tchakha<nbsp>!
msgctxt "Balloon:3661:0:1"
msgid "Nice work, Tchakha!"
msgstr "Отлично, Чакха!"

#. ja: ふふふ、鍛錬の成果だよ！
#. de: He he, die Übungen haben sich echt ausgezahlt.
#. fr: Hé hé hé, l'en<shy>traî<shy>ne<shy>ment ça paie toujours<nbsp>!
msgctxt "Balloon:3662:0:1"
msgid "The fruit of my efforts!"
msgstr "Вот что значит упорная работа!"

#. ja: あいつら<br>星導教…なのか？
#. de: Sind das Mönche von Rhalgrs Faust? Die haben echt was drauf.
#. fr: Ils sont pas très im<shy>pres<shy>sion<shy>nants, les re<shy>pré<shy>sen<shy>tants de l'ordre du Poing de Rhalgr...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3663:0:1"
msgid "Can they really be<br>the Fist of Rhalgr?"
msgstr "Неужели это и правда<br>Кулак Ралгра?"

#. ja: あの技…まさか！
#. de: Diese Techniken! Es ist wie in den Legenden!
#. fr: Ça cogne dur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3664:0:1"
msgid "That technique...<br>It couldn't be!"
msgstr "Этот приём... Неужели!?"

#. ja: ウルダハの格闘士って<br>強いのか？
#. de: Die Faustkämpfer aus Ul'dah sehen eigentlich recht stark aus.
#. fr: Ils sont si forts que ça, les pugilistes d'Ul'dah<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3665:0:1"
msgid "How tough are these<br>pugilists, you reckon?"
msgstr "Как думаешь, насколько<br>сильны кулачные бойцы<br>из Ульды?"

#. ja: この試合で<br>モンクの実力がわかる…
#. de: Bald wissen wir, wer stärker ist: die Mönche oder die Faustkämpfer.
#. fr: La rencontre avec les pugilistes va permettre aux moines de faire leurs preuves<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3666:0:1"
msgid "I'm keener to see how<br>tough the monks are."
msgstr "Мне интереснее узнать,<br>на что способны монахи."

#. ja: おいおい<br>モンクがやられてるぞ
#. de: Die Mönche kriegen ordentlich was drüber.
#. fr: Les moines ont pris cher<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3667:0:1"
msgid "Oh, shite, the monks<br>ain't doing too good."
msgstr "Вот чёрт, монахи<br>совсем не справляются."

#. ja: なにが新しい星導教だ<br>大したことないじゃないか
#. de: Die wollen der neue Orden von Rhalgrs Faust sein?
#. fr: C'est ça l'ordre du Poing de Rhalgr<nbsp>? C'est censé être mieux qu'avant<nbsp>? J'ai honte pour eux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3668:0:1"
msgid "So much for the new Fist.<br>'Twas nothing but talk."
msgstr "Ну и где же этот новый Кулак?<br>Одни разговоры."

#. ja: 負けてられないッ！
#. de: Wird sie denn \<schnauf> gar nie müde?
#. fr: Pas question de perdre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3669:0:1"
msgid "...And flex and shake<br>and bounce and..."
msgstr "...И напрячься, встряхнуться,<br>подпрыгнуть и..."

#. ja: 緊張が…
#. de: Nicht nervös werden ...
#. fr: Ça va aller<nbsp>! Ça va aller<nbsp>!
msgctxt "Balloon:3670:0:1"
msgid "Bloody nerves..."
msgstr "Чёрт, как же я нервничаю..."

#. ja: 剣の手入れは万全だ！
#. de: Blitzblank und geschärft! Hah!
#. fr: Mon épée est bien entretenue<nbsp>!
msgctxt "Balloon:3671:0:1"
msgid "Aye, that'll cut 'em to the bone..."
msgstr "Вот это меч! Им до кости прорубить можно..."

#. ja: 見たかい？<br>帝国兵の慌てる様を！
#. de: Ha, hast du gesehen, wie sie gerannt sind?
#. fr: Tu as vu la tête des Impériaux<nbsp>? Ils faisaient presque pitié<nbsp>!
msgctxt "Balloon:3672:0:1"
msgid "Did you see the way they ran!?"
msgstr "Видел, как они драпанули!?"

#. ja: この調子で<br>進軍していきたいものだ…
#. de: Tja, wenn es nur so gut weitergeht.
#. fr: J'ai bien envie de poursuivre notre marche en avant...
msgctxt "Balloon:3673:0:1"
msgid "If only it were always this easy..."
msgstr "Вот бы всегда так легко..."

#. ja: よくやったな！<br>大手柄じゃないか！
#. de: Astreine Arbeit, M'naago. Respekt.
#. fr: Bravo<nbsp>! Il y a de quoi être fier<nbsp>!
msgctxt "Balloon:3674:0:1"
msgid "Seven hells! I daresay you single-handedly won us this bridge!"
msgstr "Семь кругов ада! Да ты в одиночку, считай, мост нам отбил!"

#. ja: ナーゴが無事で<br>よかった…
#. de: Ich bin so erleichtert! \<schnief>
#. fr: M'naago n'a rien, quel soulagement...
msgctxt "Balloon:3675:0:1"
msgid "We're alive, we're all alive..."
msgstr "Мы живы... Все живы..."

#. ja: ほら、泣かないで<br>気を緩めるのは早いわ
#. de: Hör auf, für Freudentränen ist es noch zu früh.
#. fr: Bah alors, ne pleure pas. C'est pas le moment de se relâcher<nbsp>!
msgctxt "Balloon:3676:0:1"
msgid "Ye gods, woman! Don't tell me this was your first..."
msgstr "Боги, женщина! Неужели это было твоё первое сражение..."

#. ja: そろそろできるか？
#. de: Ist das Süppchen bald fertig?
#. fr: La soupe est prête<nbsp>? J'ai faim, moi.
msgctxt "Balloon:3677:0:1"
msgid "The slop ready?"
msgstr "Похлёбка-то скоро будет?"

#. ja: うーん…薄すぎかな？
#. de: Hm ... Ist vielleicht etwas fad.
#. fr: Hmm, le bouillon n'est pas assez épais...
msgctxt "Balloon:3678:0:1"
msgid "Hm... Could use some salt."
msgstr "Хм... Соли бы добавить."

#. ja: ああ、もうじきだ
#. de: Ja, wir können loslegen.
#. fr: Ouais, ça devrait être bon.
msgctxt "Balloon:3679:0:1"
msgid "As it'll ever be."
msgstr "Когда-нибудь уже будет готово."

#. ja: 中で作業してる奴らに<br>伝えてきてくれるか？
#. de: Sagst du den anderen Bescheid?
#. fr: Préviens les autres qu'on passe à table.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3680:0:1"
msgid "Why don't you go tell<br>the men it's ready?"
msgstr "Сходи скажи<br>мужикам, что готово."

#. ja: 薬味を足してくれる？<br>ほかの材料を取ってくるね！
#. de: Tust du noch was Würze rein? Ich hol noch ein paar andere Zutaten.
#. fr: Dis, ça te dérangerait de rajouter quelques épices dans le bouillon<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3681:0:1"
msgid "The stew's a bit bland.<br>Did you forget the salt?"
msgstr "Похлёбка пресновата.<br>Соль-то забыла?"

#. ja: まかせて！
#. de: Mach ich!
#. fr: Pas de problème, c'est comme si c'était fait<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3682:0:1"
msgid "My apologies. We used<br>the last this morning."
msgstr "Прости. Утром<br>использовали последнюю."

#. ja: なあ、どちらかひとり<br>手伝ってくれないか？
#. de: Kann uns nicht einer von euch beiden mal beim Steinekloppen helfen?
#. fr: On aurait besoin d'un coup de main. L'un de vous deux est dispo<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3683:0:1"
msgid "I need one of you to<br>give me a hand."
msgstr "Мне нужно, чтобы один<br>из вас помог."

#. ja: そいつは参った…<br>仕事後の飯は惜しい…
#. de: I-Ich ... frag mal.
#. fr: D-désolé les gars, on ne mange pas pendant le travail. C'est la règle.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3684:0:1"
msgid "I just thought... Bah,<br>forget I asked."
msgstr "Я просто подумал... Ладно,<br>забудьте, что спросил."

#. ja: むこうも大変らしい<br>俺たちでがんばるか！
#. de: Also die beiden helfen uns schon mal nicht. Aber das Gesicht von dem Faulpelz, das merk ich mir.
#. fr: Ils sont débordés... Tant pis, on va se débrouiller seuls<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3685:0:1"
msgid "“Give me a hand.” Hah!<br>How about giving us a hand?"
msgstr "«Помогите мне», ага!<br>А нам кто поможет?"

#. ja: こっちも大忙しだから<br>おにぎり2個で手を打つぜ？
#. de: Wir haben auch alle Hände voll zu tun. Wollt <i>ihr uns</i> nicht helfen?
#. fr: Nan, désolé<nbsp>! Au passage, t'aurais pas un truc à grignoter<nbsp>? On crève la dalle<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3686:0:1"
msgid "Does it look like we've one<br>to give?"
msgstr "По-твоему, у нас есть<br>лишние руки?"

#. ja: こいつら、何者だ…
#. de: Wer sind denn die?
#. fr: C'est qui, eux<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3687:0:1"
msgid "Ugh... Wh-Who are<br>these bastards?"
msgstr "Уф... К-кто<br>эти ублюдки?"

#. ja: 私たちの技が…<br>効かない…？
#. de: Meine Techniken ... wirken nicht?!
#. fr: Mes techniques... sont inefficaces<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3688:0:1"
msgid " \\<pant> We...we had<br>no answer to them..."
msgstr "<i>Фух...</i> Мы... мы ничего не могли им противопоставить..."

#. ja: 俺は病気なんだ…<br>うつりたくなきゃ離れろ
#. de: Bleib weg. Ich bin krank.
#. fr: Je suis malade... Ne t'approche pas, je vais finir par te contaminer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3689:0:1"
msgid "Keep back! Any closer<br>and the sickness will<br>spread!"
msgstr "Не подходи! Ещё шаг —<br>и заразишься!"

#. ja: よっこいしょっと！
#. de: Der Stein hat schon einen Haarriss. Jetzt nicht nachlassen<nbsp>...
#. fr: Et... Han<nbsp>!
msgctxt "Balloon:3690:0:1"
msgid "Why. Won't. This. Break!?"
msgstr "Да почему же оно не ломается!?"

#. ja: 小腹が減ったが<br>忍耐あるのみ…
#. de: Der Magen knurrt, aber einen Wolfsmann stört das nicht.
#. fr: Pff, cette faim commence à me peser sur les nerfs...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3691:0:1"
msgid "What I wouldn't give for a<br>nice bloody haunch of..."
msgstr "Вот бы сейчас кусок<br>сочной ножки..."

#. ja: 相談があるんだけど…
#. de: Ich bräuchte mal deinen Rat ...
#. fr: J-je peux te parler une minute<nbsp>?
msgctxt "Balloon:3692:0:1"
msgid "Your son... I'm sorry..."
msgstr "Твой сын... Прости..."

#. ja: あちゃー…<br>この先は酷いな
#. de: Oje, drüben sieht es auch nicht besser aus.
#. fr: Ce n'est pas vraiment ce que j'appelle une belle vue...
msgctxt "Balloon:3693:0:1"
msgid "Aye... No better yonder..."
msgstr "Ага... Там тоже не лучше..."

#. ja: 精霊よ…癒しの力を…
#. de: Gebieter, steht mir bei!
#. fr: Esprits de la forêt... prêtez-moi vos pouvoirs...
msgctxt "Balloon:3694:0:1"
msgid "May the elementals show us favor in our hour of need..."
msgstr "Элементали, пошлите нам милость<br>в этот час нужды..."

#. ja: 森の弓術で射抜いてみせる！
#. de: Jetzt lernen sie die Präzision der Bogenschützen von Gridania kennen!
#. fr: Il n'y a pas de meilleurs archers que les Gridaniens<nbsp>!
msgctxt "Balloon:3695:0:1"
msgid "Matron guide my arrows, that each might strike true..."
msgstr "Матрона, направь мои стрелы,<br>пусть каждая попадёт в цель..."

#. ja: アラミゴ人部隊の実力<br>見せてくれる！
#. de: Zeigen wir ihnen, was es heißt, wie ein Mhigit zu kämpfen!
#. fr: Enfin l'occasion de montrer les talents de l'unité mhigoise<nbsp>!
msgctxt "Balloon:3696:0:1"
msgid "Heh heh... The Ala Mhigan Brigade is coming for you lot..."
msgstr "Хе-хе... Ала-Миганская бригада уже идёт за вами..."

#. ja: ナル神とザル神よ<br>我に祝福を…
#. de: Nald'thal, entscheide dich! Leben oder Tod!
#. fr: Ô Nald'Thal, bénissez-nous<nbsp>!
msgctxt "Balloon:3697:0:1"
msgid "O Thal, should I fall this day, may You grant me peace everlasting..."
msgstr "О Тал, если паду я сегодня,<br>даруй мне вечный покой..."

#. ja: 勝利を我らの手に！
#. de: Der Sieg gehört uns!
#. fr: La victoire est à nous<nbsp>!
msgctxt "Balloon:3698:0:1"
msgid "Victory will be ours!"
msgstr "Победа будет за нами!"

#. ja: 岩をも砕く剛力で！
#. de: Weder Stein noch Eisen hält uns stand!
#. fr: Je briserai la roche, s'il le faut<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3699:0:1"
msgid "Time to split skulls<br>the Lominsan way!"
msgstr "Пора крушить черепа<br>по-лимсийски!"

#. ja: 負けないニャ！
#. de: Es gibt kein Zurück!
#. fr: Pas question de perrrdre<nbsp>!
msgctxt "Balloon:3700:0:1"
msgid "No turning back!"
msgstr "Назад дороги нет!"

#. ja: お米…おいしい…
#. de: So gut hat der Reis schon lange nicht mehr geschmeckt.
#. fr: Miom... C'est si bon que j'en ai les larmes aux yeux. (renifle)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3701:0:1"
msgid "Da says this is the<br>last of the rice."
msgstr "Папа говорит, это<br>последний рис."

#. ja: おにいさん、大丈夫？
#. de: Fehlt dir was?
#. fr: M'sieur, ça va pas<nbsp>? Vous avez mal<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3702:0:1"
msgid "What do you think<br>is wrong with him?"
msgstr "Как думаешь,<br>что с ним?"

#. ja: しばらくはそれで<br>足りるかしら…
#. de: Das sollte fürs Erste reichen.
#. fr: On commence sé<shy>rieu<shy>se<shy>ment à manquer de vivres...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3703:0:1"
msgid "There's barely enough<br>there for three more nights."
msgstr "Этого едва хватит<br>ещё на три ночи."

#. ja: 落ちないように<br>しないとな！
#. de: Bloß nicht fallen lassen. Einmal reicht.
#. fr: Faut pas que je regarde en bas...
msgctxt "Balloon:3704:0:1"
msgid "How did you get up─ Oh."
msgstr "Как ты туда забрался— А, понятно."

#. ja: 花火、楽しみね
#. de: Ich freue mich schon auf das Feuerwerk!
#. fr: Les feux d'artifice, c'est trrrop bien<nbsp>!
msgctxt "Balloon:3711:0:1"
msgid "I can't wait to see the fireworks!"
msgstr "Не могу дождаться фейерверка!"

#. ja: わあ、とっても綺麗ね！
#. de: Oh, wie schön!
#. fr: Comme c'est beau<nbsp>!
msgctxt "Balloon:3712:0:1"
msgid "Wow! It's beautiful!"
msgstr "Ух ты! Какая красота!"

#. ja: きれーに見えるかな？
#. de: Wie wird es wohl aussehen?
#. fr: Magnifique<nbsp>!
msgctxt "Balloon:3713:0:1"
msgid "Spectacular!"
msgstr "Потрясающе!"

#. ja: 花火、すごーい！
#. de: Was für ein tolles Feuerwerk!
#. fr: Et boum et boum et boum<nbsp>!
msgctxt "Balloon:3714:0:1"
msgid "They certainly made a show of it this year!"
msgstr "В этом году они дали жару!"

#. ja: いっぱい遊ぶぞー！
#. de: Das wird ein Fest!
#. fr: Qu'est-ce qu'on s'éclate<nbsp>!
msgctxt "Balloon:3715:0:1"
msgid "This is going to be a Moonfire to remember!"
msgstr "Эту Огненную луну мы запомним надолго!"

#. ja: 紅蓮祭って最高ね！
#. de: Ich liebe den Feuermond-Reigen!
#. fr: Vive les Feux de la Mort<nbsp>!
msgctxt "Balloon:3716:0:1"
msgid "Long live the Moonfire Faire!"
msgstr "Да здравствует Праздник Огненной Луны!"

#. ja: 熱い視線を感じるぜ！
#. de: Ich fühle mich ... beobachtet.
#. fr: J'ai l'impression qu'on me regarde...
msgctxt "Balloon:3717:0:1"
msgid "I feel as though...I'm being watched."
msgstr "Такое чувство... будто за мной следят."

#. ja: 罪づくりな筋肉だな…
#. de: Für die Muskeln könnte ich sündigen.
#. fr: Quels muscles d'acier...
msgctxt "Balloon:3718:0:1"
msgid "Now that muscular body is bound to bear some sin."
msgstr "С таким телом грех не согрешить..."

#. ja: 愛を受け取ってくれ！
#. de: Ich liebe dich! Schenke auch du mir deine Liebe!
#. fr: Je vais vous donner de l'amour, moi<nbsp>!
msgctxt "Balloon:3719:0:1"
msgid "I love you! Tell me you love me!"
msgstr "Я люблю тебя! Скажи, что тоже меня любишь!"

#. ja: だ、ダメよ…私なんか…<br>貴方と釣り合わない…
#. de: Ich ... kann nicht. Wir passen einfach nicht zusammen!
#. fr: Je ne crois pas que nous soyons faits l'un pour l'autre...
msgctxt "Balloon:3720:0:1"
msgid "I... I'm sorry. It's not me, it's you. I think we should see other people."
msgstr "Я... прости. Дело не во мне, а в тебе. Думаю, нам лучше встречаться с другими."

#. ja: 宝探しは疲れるニャ…
#. de: Die Schatz<shy>suche ist ganz schön anstrengend.
#. fr: Bon, il est où, ce trésor<nbsp>?
msgctxt "Balloon:3721:0:1"
msgid "Searching for treasure in this heat sure is tiring."
msgstr "В такую жару искать сокровища — то ещё удовольствие..."

#. ja: 花火はまだかな？
#. de: Wann geht es endlich los?
#. fr: Et le feu d'arrrtifice, ça vient<nbsp>?
msgctxt "Balloon:3722:0:1"
msgid "Have the fireworks started yet?"
msgstr "Фейерверк уже начался?"

#. ja: 海で待つの結構大変…
#. de: Am Strand zu warten ist leichter gesagt als getan ...
#. fr: C'est épuisant de rester sur la plage...
msgctxt "Balloon:3723:0:1"
msgid "Waiting at the beach isn't as easy as it sounds."
msgstr "Ждать на пляже куда труднее, чем кажется."

#. ja: わくわく、どきどき…
#. de: Ich bin ja so aufgeregt!
#. fr: Oh là là, je suis tout excitée<nbsp>!
msgctxt "Balloon:3724:0:1"
msgid "I can barely contain myself!"
msgstr "Еле сдерживаюсь!"

#. ja: この筋肉と、花火…<br>どちらが美しいのか…
#. de: Was ist schöner? Diese Muskeln oder das Feuerwerk?
#. fr: Un vrai feu d'artifice de muscles<nbsp>!
msgctxt "Balloon:3725:0:1"
msgid "I don't know which is more beautiful─these muscles or these fireworks."
msgstr "И не пойму, что прекраснее — эти мышцы или фейерверк."

#. ja: 花火よりも、君に夢中さ
#. de: Du bist viel schöner als jedes Feuerwerk!
#. fr: Le feu d'artifice dans mon cœur, c'est toi, poupée<nbsp>!
msgctxt "Balloon:3726:0:1"
msgid "You're far more beautiful than any fireworks display."
msgstr "Ты куда прекраснее любого фейерверка."

#. ja: まあ、お上手…
#. de: Ach, hör schon auf.
#. fr: Pas mal, pas mal...
msgctxt "Balloon:3727:0:1"
msgid "Oh, stop it."
msgstr "Ой, перестань."

#. ja: 花火よりも君の方が…<br>い、いや…なんでも…
#. de: Du bist viel schöner als jedes Feuerw...<br>Ach, vergiss es ...
#. fr: Euh... T-tu es encore plus b-belle qu'un feu d'artifice...
msgctxt "Balloon:3728:0:1"
msgid "You're far more beautiful than any f─ N-Never mind."
msgstr "Ты куда прекраснее любого фей... Н-ничего."

#. ja: わぁ、海だー！
#. de: Meer so weit das Auge reicht!
#. fr: Regardez-moi ce bleu d'azurrr<nbsp>!
msgctxt "Balloon:3729:0:1"
msgid "Just look at that ocean!"
msgstr "Только посмотрите на этот океан!"

#. ja: すごーい！たのしー！
#. de: Das ist ja noch schöner, als ich es mir vorgestellt hatte!
#. fr: On s'amuse comme des petites folles<nbsp>!
msgctxt "Balloon:3730:0:1"
msgid "I've never had so much fun in my life!"
msgstr "Никогда в жизни мне не было так весело!"

#. ja: ふふ…しばらく焼きたてを<br>我慢したかいがありました
#. de: Hehe, gut, dass ich meine Diät strikt eingehalten habe!
#. fr: Les produits qui viennent tout juste de sortir du fourrr ont l'air délicieux<nbsp>!
msgctxt "Balloon:3731:0:1"
msgid "Hehehe. I'm holding back on the freshly baked goods."
msgstr "Хе-хе. Я держусь и не ем свежеиспечённую выпечку."

#. ja: わーい、熊さんかわいー！
#. de: Bären sind ja sooo knuddelig!
#. fr: Il est trop mignon le gros ours<nbsp>! Regarde<nbsp>! Il fait coucou avec ses pattes<nbsp>!
msgctxt "Balloon:3732:0:1"
msgid "I never knew bears could be so adorable!"
msgstr "И не знала, что медведи такие милые!"

#. ja: 暴れたりしないのかしら？
#. de: Sind die nicht auch ganz schön gefährlich?
#. fr: Ils... Ils ont le ventre plein, j'espère...
msgctxt "Balloon:3733:0:1"
msgid "But what if they get loose and go on a murderous rampage!?"
msgstr "А вдруг они вырвутся и устроят кровавую бойню!?"

#. ja: 星芒祭、開催中だよ！<br>熊さんの芸を見ていってね
#. de: Frohes Sternenlichtfest! Hast du schon das neue Kunststück der Bären gesehen?
#. fr: Nos ours vont vous en mettre plein la vue pendant la fête des étoiles<nbsp>! Venez profiter du spectacle<nbsp>!
msgctxt "Balloon:3734:0:1"
msgid "Have you seen the bears' new trick yet?"
msgstr "Вы уже видели новый трюк медведей?"

#. ja: いまのところ異常なし…
#. de: So weit, so gut<nbsp>...
#. fr: Rien à signa... Hum<nbsp>!? Non, c'est qu'une de mes mèches...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3735:0:1"
msgid "Nothing to report...to you.<br>And who are you again?"
msgstr "Докладывать нечего...<br>А ты, собственно, кто?"

#. ja: 気味の悪い島だな<br>岩の感触まで異常だぜ…
#. de: Diese Insel ist mir nicht geheuer. Sogar das Gestein hier fühlt sich komisch an.
#. fr: J'en r'viens pas, même la roche se laisse pas faire sur cette foutue île<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3736:0:1"
msgid "I've seen my share of<br>forbidden lands, but this<br>here is by far the worst."
msgstr "Повидал я запретных земель,<br>но эта — худшая из всех."

#. ja: …金払いはいいんだ<br>我慢して働くしかねえさ
#. de: Denk an die Extra-Gil, die sie uns zahlen. Das macht es erträglicher.
#. fr: Tu l'as dit. Mais vu ce qu'on va se mettre dans les poches, on ferait mieux de pas trop se plaindre.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3737:0:1"
msgid "Unaspected, deaspected,<br>over-aspected, corrupted,<br>luminous, demi-, and now<br>protean? When will it end!?"
msgstr "Без аспектов, с деаспектами,<br>с избытком аспектов, осквернённые,<br>светящиеся, полу- и теперь<br>ещё и протейские? Когда это кончится!?"

#. ja: 構わぬ<br>獲物は何だ？
#. de: Gerne! Worauf hast du's abgesehen?
#. fr: Ouais, bien sûr. On chasse quoi<nbsp>?
#. macro: <if ($gn11 < 12)><if ($gn11 < 4)>Tonight<else>Today</if><else><if ($gn11 < 17)>Today<else>Tonight</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 12 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gn11 < 4)>Tonight<else>Today</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 4 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gn11 < 17)>Today<else>Tonight</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 17 (condition: may be reworded, restructured, added, or dropped)
msgctxt "Balloon:3738:0:1"
msgid "Always. <if ($gn11 < 12)><if ($gn11 < 4)>Tonight<else>Today</if><else><if ($gn11 < 17)>Today<else>Tonight</if></if>'s prey?"
msgstr "Всегда. На какую добычу <if ($gn11 < 12)><if ($gn11 < 4)>сегодня ночью<else>сегодня</if><else><if ($gn11 < 17)>сегодня<else>сегодня ночью</if></if> отправимся?"

#. ja: 魚がよかろう
#. de: Hm ... Fische vielleicht?
#. fr: Hmm... Des poissons<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3739:0:1"
msgid "I would feast on the<br>succulent flesh of fish."
msgstr "Я бы отведал<br>сочного рыбьего мяса."

#. ja: えっ！？
#. de: W-Was?!
#. fr: Hein<nbsp>!?
msgctxt "Balloon:3740:0:1"
msgid "\\<gasp>"
msgstr "<i>Ах!</i>"

#. ja: ロッホ・セルの塩で<br>一旗揚げてやるぜ！
#. de: Das Salz vom Seldsee wird in aller Munde sein!
#. fr: Avec le sel du lac Seld, la fortune est à nous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3741:0:1"
msgid "Loch Seld's salt'll be<br>the talk of the realm!"
msgstr "Соль озера Сэлд<br>будет у всех на устах!"

#. ja: 二階は崩れているが<br>地下室は使えそうだな…
#. de: Der erste Stock ist hinüber, aber der Keller lässt sich noch gebrauchen.
#. fr: L'étage est détruit, mais le sous-sol peut encore servir...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3742:0:1"
msgid "The second floor's lost,<br>but the cellar seems solid..."
msgstr "Второй этаж не спасти,<br>зато подвал вроде цел..."

#. ja: まずは製塩場と<br>加工場の整備が先決だ！
#. de: Damit hier Salz gewonnen und verarbeitet werden kann, ist noch einiges zu tun!
#. fr: Avant toute chose, il faut remettre l'équipement en état<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3743:0:1"
msgid "Right, let's get the<br>equipment cleaned up<br>and in working order!"
msgstr "Так, давайте почистим<br>оборудование и приведём<br>его в рабочий вид!"

#. ja: 私、どうすれば…
#. de: Wehe uns!
#. fr: Que dois-je faire<nbsp>?<nbsp>...
msgctxt "Balloon:3744:0:1"
msgid "Do I fight, or...?"
msgstr "Мне драться или..."

#. ja: なんということじゃ…
#. de: Ungeheuerlich!
#. fr: Qu'est-ce que ça veut dire<nbsp>!?
msgctxt "Balloon:3745:0:1"
msgid "Never in all my days..."
msgstr "За всю свою жизнь..."

#. ja: シュー…<br>カリヤナの連中め！
#. de: Sss<nbsp>... Verfluchte Qalyana!
#. fr: Maudites Qalyanas<nbsp>! Ssss...
msgctxt "Balloon:3746:0:1"
msgid "Damn the Qalyana!"
msgstr "Будь прокляты калианы!"

#. ja: こ、ここで死ぬのか！？
#. de: Hier soll es enden?
#. fr: Vais-je mourir ici<nbsp>!?
msgctxt "Balloon:3747:0:1"
msgid "Of all the places to die..."
msgstr "Из всех мест — умереть здесь..."

#. ja: バウト…<br>お願い…
#. de: Baut<nbsp>... Hilf uns<nbsp>...
#. fr: Baut... Au secours<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3748:0:1"
msgid "Baut...<br>Save me..."
msgstr "Баут...<br>Спаси меня..."

#. ja: やられてたまるかい！
#. de: Hab nicht vor, hier zu sterben!
#. fr: Je ne vais pas me laisser faire<nbsp>!
msgctxt "Balloon:3749:0:1"
msgid "I'll not fall here!"
msgstr "Я здесь не погибну!"

#. ja: チッ…<br>いつもの槍ではないが…！
#. de: Man muss nehmen, was man kriegt!
#. fr: Ce n'est pas ma lance habituelle, mais peu imporrrte<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3750:0:1"
msgid "Bah, this spear<br>will have to do!"
msgstr "Чёрт, придётся обойтись<br>этим копьём!"

#. ja: どうなってやがる！
#. de: Was ist das für ein Spiel?!
#. fr: Mais qu'est-ce qui se passe au juste<nbsp>!?
msgctxt "Balloon:3751:0:1"
msgid "What in the hells!?"
msgstr "Что за чертовщина!?"

#. ja: 怖いっちゃ…<br>がくぶるっちゃ…
#. de: Wie fürchterlich! Qiqirn Angst haben!
#. fr: Avoir peur<nbsp>! Gla gla gla...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3752:0:1"
msgid "I came in peace!<br>I leave in pieces!?"
msgstr "Я пришёл с миром!<br>А ухожу по частям!?"

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "Balloon:3753:0:1"
msgid "..."
msgstr "..."

#. ja: 代表者たちは<br>護ってみせる！
#. de: Schützt die Gesandten!
#. fr: Il faut absolument protéger ces gens<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3754:0:1"
msgid "We must protect<br>the envoys!"
msgstr "Мы должны защитить<br>посланников!"

#. ja: シュー…<br>逃しはしない！
#. de: Mir entkommt niemand!
#. fr: Vous ne fuirez pas, humains<nbsp>! Ssss...
msgctxt "Balloon:3755:0:1"
msgid "Accept your fate!"
msgstr "Смиритесь со своей участью!"

#. ja: あ、あぁ…<br>美神様ぁ…！
#. de: Erhabene Lakshmi!
#. fr: Aaaah... Lakshmi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3756:0:1"
msgid "It's Her!<br>The Goddess Herself!"
msgstr "Это Она!<br>Сама Богиня!"

#. ja: どうにか助かったようだね…
#. de: Das ist ja gerade noch mal gutgegangen.
#. fr: On l'a échappé belle...
msgctxt "Balloon:3757:0:1"
msgid "That was a right mess, eh?"
msgstr "Ну и передряга была, а?"

#. ja: 髑髏の処刑人に<br>助けられるとはよ…
#. de: Von einer Verräterin gerettet zu werden<nbsp>...
#. fr: Je ne pensais pas que je devrais un jour la vie à l'Exécutrice...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3758:0:1"
msgid "Saved by the Butcher.<br>The bloody Butcher..."
msgstr "Меня спасла Мясница.<br>Проклятая Мясница..."

#. ja: シュー…<br>アナンタ族として謝罪を…
#. de: Die Qalyana sind eine Ssschande für uns!
#. fr: Au nom des Anantas, je suis désolée. Ssss...
msgctxt "Balloon:3759:0:1"
msgid "They disssgrace all Ananta..."
msgstr "Они позорят всех анантов..."

#. ja: 助かった…<br>格別の感謝を…
#. de: Wir leben! Dank sei den Göttern!
#. fr: Merci infiniment<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3760:0:1"
msgid "My thanks.<br>I'd thought myself done for."
msgstr "Спасибо.<br>Я уж думал, мне конец."

#. ja: まさか蛮神をこの目で<br>見ることになるとはな
#. de: Dass ich einmal einem Primae gegen<shy>über<shy>stehen würde<nbsp>...
#. fr: Jamais je n'aurais imaginé voirrr une Primordial de mes propres yeux.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3761:0:1"
msgid "I was ill prepared<br>for such a meeting..."
msgstr "Я оказался не готов<br>к такой встрече..."

#. ja: お～い！
#. de: Heeehoo!
#. fr: Ohéééé<nbsp>!
msgctxt "Balloon:3762:0:1"
msgid "Have you a moment?"
msgstr "Не найдётся минутки?"

#. ja: どうしたんだぁ～？
#. de: Was treibst du<nbsp>...... so?
#. fr: Quoi de neeeeuf<nbsp>?
msgctxt "Balloon:3763:0:1"
msgid "Always, my friend."
msgstr "Всегда, друг мой."

#. ja: お宝探しに行くけど<br>欲しいものはあるかぁ～？
#. de: Ich geh auf Schatz<shy>suche. Hoffentlich finde ich<nbsp>...... etwas.
#. fr: Je pars à la chasse aux trésoooors. Qu'est-ce que je te rapporte, cette foooois<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3764:0:1"
msgid "I'm to search for relics<br>today. Might you have a<br>request?"
msgstr "Сегодня отправляюсь<br>на поиски реликвий.<br>Может, чего заказать?"

#. ja: 古い物なら<br>なんでも大歓迎だぁ～
#. de: Hauptsache, es ist<nbsp>...... alt.
#. fr: N'importe quoi, du moment que c'est vieux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3765:0:1"
msgid "You know my tastes─<br>the older, the better."
msgstr "Ты знаешь, что мне по душе:<br>чем древнее, тем лучше."

#. ja: よく来たなぁ～
#. de: Sei<nbsp>...... gegrüßt!
#. fr: Salut, saluuuut<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3766:0:1"
msgid "You're back...and so soon.<br>Did fortune bless you?"
msgstr "А ты уже вернулся...<br>Так быстро. Удача улыбнулась?"

#. ja: 仕入れたお宝を<br>持ってきたよぉ～！
#. de: Ich habe einen würdigen Schatz<nbsp>...... gefunden.
#. fr: J'ai fait place nette chez mooooi<nbsp>!
msgctxt "Balloon:3767:0:1"
msgid "She did, my friend! She did!"
msgstr "Ещё как, друг мой! Ещё как!"

#. ja: おお～こいつは<br>古くて味わい深い品だぁ～！
#. de: Oooh! Das ist ja eine ganz besondere<nbsp>...... Kostbarkeit.
#. fr: Ooooh... Ça, c'est un objet bien vieux comme je les aaaaime<nbsp>!
msgctxt "Balloon:3768:0:1"
msgid "This is positively ancient!"
msgstr "Да это же настоящая древность!"

#. ja: どこに納めようかなぁ～
#. de: Wo soll ich die nur<nbsp>...... hinstellen?
#. fr: Il faut que je mette mon trésor bien en valeeeeur.
msgctxt "Balloon:3769:0:1"
msgid "Now where to put it..."
msgstr "И куда бы её поставить..."

#. ja: みんな、お宝の手入れで<br>忙しそうだなぁ～
#. de: Alle geben sich große Mühe, die Schatzkammer zu<nbsp>...... füllen.
#. fr: Je fais la queue pour déposer mon trésoooor.
msgctxt "Balloon:3770:0:1"
msgid "Ever occupied, these ones."
msgstr "Всё при деле, как обычно."

#. ja: よーし、よーし<br>今日も元気そうだなぁ～
#. de: Ich habe eine erfolgreiche Schatz<shy>suche <if ($gn11 < 12)><if ($gn11 < 4)>hinter<else>vor</if><else><if ($gn11 < 17)>vor<else>hinter</if></if><nbsp>...... mir.
#. fr: Ah, encore une bonne journée <if ($gn11 < 12)><if ($gn11 < 4)>qui s'achève<else>qui commence</if><else><if ($gn11 < 17)>en perspective<else>qui s'achève</if></if><nbsp>!
msgctxt "Balloon:3771:0:1"
msgid "Just as brilliant as yesterday."
msgstr "Всё такой же блистательный, как вчера."

#. ja: 畏み畏み～
#. de: Mögen die Kami uns<nbsp>...... beschützen.
#. fr: Que les kami nous protèèèègent...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3772:0:1"
msgid "Oh great kami, can you<br>hear me, your humble admirer?"
msgstr "О великие ками, внемлите<br>своему смиренному почитателю!"

#. ja: はぁ～美しい～<br>我ながら、よく磨けたぞぉ～
#. de: Nirgends in der Rubinsee findet man schönere<nbsp>...... Krüge.
#. fr: Ces jarres, c'est de l'aaaart<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3773:0:1"
msgid "This piece is so polished,<br>I can see the future in it!"
msgstr "Так отполировал эту вещь,<br>что в ней будущее видать!"

#. ja: これからも頼みますね
#. de: Es gibt noch so viel zu tun. Wirst du uns auch weiterhin helfen?
#. fr: Ouah<nbsp>! Quelle jolie carapace<nbsp>!
msgctxt "Balloon:3774:0:1"
msgid "Here's a list for next time."
msgstr "Вот список на следующий раз."

#. ja: ナマイ村の子たち<br>また来ないかな～
#. de: Ich würd gern mal mit den Kindern aus Namai spielen<nbsp>...
#. fr: Quand est-ce qu'ils viennent jouer ici, les enfants de Namai<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3775:0:1"
msgid "Do you think our friends in<br>Namai will come again?"
msgstr "Как думаешь, друзья из<br>Намая ещё придут?"

#. ja: 俺がいっちばーん！
#. de: Wenn ihr mir verratet, wie ich hier runterkomme, verrate ich euch, wie ich hochgekommen bin.
#. fr: Ha ha<nbsp>! C'est moi l'plus fortiche<nbsp>!
msgctxt "Balloon:3776:0:1"
msgid "I'm the lord of all Doma!"
msgstr "Я — владыка всей Домы!"

#. ja: ヒエン…やっとだ…
#. de: Hien ...<br>Endlich habe ich dich gefunden<nbsp>...
#. fr: Enfin, je l'ai retrouvé<nbsp>! Il est à nous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3777:0:1"
msgid "Hien...<br>I've found you at last..."
msgstr "Хиэн...<br>Наконец-то я тебя нашёл..."

#. ja: 今日もやりきったぁ
#. de: Ich könnte stundenlang ins Feuer starren. Besonders, wenn es noch so viel zu tun gibt<nbsp>...
#. fr: (souffle)... J'ai bien travaillé aujourd'hui aussi...
msgctxt "Balloon:3778:0:1"
msgid "Ugh, my aching neck..."
msgstr "Уф, шея-то как болит..."

#. ja: 次の作業だが…
#. de: Das nächste Bauprojekt ist etwas umfangreicher als das letzte<nbsp>...
#. fr: Bon, pour la suite... Hmm...
msgctxt "Balloon:3779:0:1"
msgid "Ready for your next task?"
msgstr "Готов к следующему заданию?"

#. ja: これしきぃ～！
#. de: Hmmmpf!
#. fr: Oh la vache<nbsp>! Ce débris pèse au moins une tonz<nbsp>!
msgctxt "Balloon:3780:0:1"
msgid "Hnnngh!"
msgstr "Хннн!"

#. ja: 戦い方を教えてください！
#. de: Bitte. Bringe uns bei, zu kämpfen.
#. fr: S'il vous plaît, apprenez-nous à nous battre, Dame Yugiri<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3781:0:1"
msgid "Lady Yugiri!<br>Show us that move again!"
msgstr "Госпожа Югири!<br>Покажите ещё раз тот приём!"

#. ja: この惨状じゃ<br>もっと人手がいるか…
#. de: Besser, wir reißen den Siloturm ganz ein. Aber dafür fehlen uns die Leute.
#. fr: C'est pas possible comme ça... Il nous faut plus de monde...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3782:0:1"
msgid "What a mess.<br>We'll need more workers..."
msgstr "Ну и бардак.<br>Рабочих понадобится побольше..."

#. ja: 15本…16本…
#. de: Fünfzehn, sechzehn<nbsp>... Hm, jaja<nbsp>...
#. fr: Quinze... Seize...
msgctxt "Balloon:3783:0:1"
msgid "Fifteen...sixteen..."
msgstr "Пятнадцать... шестнадцать..."

#. ja: 滑ったぁ～！<br>お、お助け～！
#. de: Hilfe! Holt weiche Matratzen, einen Wasserkübel, eine Herde Schafe<nbsp>... Irgendwas!
#. fr: Au secours<nbsp>! Apportez une échelle<nbsp>!<nbsp>... Je commence à avoir une crampe au mollet...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3784:0:1"
msgid "Help!<br>I can't hold on!"
msgstr "Помогите!<br>Не удержусь!"

#. ja: これでひとまず<br>通れそうだな…
#. de: Wenn ich erstmal mit dem Fegen fertig bin, muss ich nur noch die Steine wegräumen und das Unkraut jäten.
#. fr: Non, mais pourquoi il m'ont filé un balai<nbsp>!? Franchement<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3785:0:1"
msgid "I sweep and I sweep...<br>Still dirt."
msgstr "Мету и мету...<br>А грязи меньше не становится."

#. ja: この箱の中も<br>確認してくれるか？
#. de: Kannst du hier auch mal reinsehen?
#. fr: Hé, tu veux bien vérifier ce qu'il y a dans la boîte<nbsp>?
msgctxt "Balloon:3786:0:1"
msgid "Another crate here for you."
msgstr "А вот этот ящик тоже проверь."

#. ja: はいよ、任せな！
#. de: Gern doch.
#. fr: Ouais, je m'en charge.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3787:0:1"
msgid "Right. Put it down<br>with the others."
msgstr "Ладно. Ставь<br>к остальным."

#. ja: 無二江も異常なし！
#. de: Keine besonderen Vorkommnisse!
#. fr: Rien à signaler du côté de la Muni<nbsp>!
msgctxt "Balloon:3788:0:1"
msgid "All clear on the docks!"
msgstr "На причалах всё чисто!"

#. ja: ツラヌキさんは<br>ご飯いいそうよ
#. de: Er sagt, er will nichts essen.
#. fr: J'ai le sentiment que Tsuranuki va me dire qu'il a faim...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3789:0:1"
msgid "Master Tsuranuki says<br>he isn't hungry."
msgstr "Мастер Цурануки говорит,<br>что не голоден."

#. ja: 無理はいかん<br>握り飯を持っていくか
#. de: So geht das schon seit Tagen. Ich dachte, er hätte alles überwunden?
#. fr: Ouais, tu ferais mieux d'emporter une boulette de riz.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3790:0:1"
msgid "He needs to eat.<br>I'll take a bowl over myself."
msgstr "Ему надо поесть.<br>Сам отнесу ему миску."

#. ja: うーん…<br>どこに行ったのかしら
#. de: Nanu? Wo ist er hin?
#. fr: Mais où est-ce qu'il est passé<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3791:0:1"
msgid "Now, where did...<br>Ugh, I've looked everywhere!"
msgstr "Ну и где же он...<br>Тьфу, я уже всё обыскала!"

#. ja: よし、とりかかるぞ
#. de: Wird erledigt.
#. fr: Bon, il est temps que je m'y mette<nbsp>!
msgctxt "Balloon:3792:0:1"
msgid "I'll get to it, then."
msgstr "Ладно, займусь этим."

#. ja: ああ、いい匂い！<br>何のお味噌汁？
#. de: Riecht vorzüglich! Was ist da drin?
#. fr: Hmm<nbsp>! Ça sent vraiment bon<nbsp>! Y a quoi dedans<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3793:0:1"
msgid "That smells wonderful!<br>What's in it?"
msgstr "Как вкусно пахнет!<br>Что там у тебя?"

#. ja: 豆腐と根菜さ！<br>うちの味が合うといいが
#. de: Tofu und Gemüse. Die Suppe ist ein Familienrezept.
#. fr: Du tofu et des légumes<nbsp>! C'est une recette de famille.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3794:0:1"
msgid "Just tofu and vegetables!<br>And maybe a secret spice<br>or two."
msgstr "Всего-то тофу да овощи!<br>Ну и пара секретных<br>приправ, может быть."

#. ja: おにいさん！<br>お薬もってきたよ！
#. de: Herr Wolfsmann! Ich hab die Medizin mitgebracht!
#. fr: Monsieur, Monsieur<nbsp>! Je t'ai apporté le médicament<nbsp>!
msgctxt "Balloon:3795:0:1"
msgid "I've brought you a poultice!"
msgstr "Я принёс тебе припарку!"

#. ja: 来るんじゃないって<br>言ってるだろ…
#. de: Ich hab doch gesagt, du sollst verschwinden!
#. fr: Je t'ai pourtant dit de ne pas t'approcher de moi, imbécile<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3796:0:1"
msgid "I told you...<br>...to leave me be..."
msgstr "Я же говорил...<br>...оставь меня в покое..."

#. ja: 味噌は足りてるか？
#. de: Hast du noch genug Miso-Paste?
#. fr: Et alors, y a assez de miso<nbsp>?<nbsp>...
msgctxt "Balloon:3797:0:1"
msgid "Do you have enough miso?"
msgstr "Мисо ещё осталось?"

#. ja: 確認してみるわ<br>ちょっと待ってね…
#. de: Ich seh mal nach.
#. fr: Attends, je vais vérifier...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3798:0:1"
msgid "I'll check.<br>Just a moment!"
msgstr "Сейчас проверю.<br>Подожди минутку!"

#. ja: お味噌…お味噌…<br>どの壺だっけ…
#. de: Miso ... In welchem Topf war noch mal das Miso?
#. fr: Mince, je ne sais plus quel pot c'est...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3799:0:1"
msgid "Miso...miso...<br>Which jar was it again...?"
msgstr "Мисо... мисо...<br>В какой же банке оно было?.."

#. ja: 重い…手が滑る…
#. de: Mach hin! Meine Arme!
#. fr: Vite<nbsp>! Je sens que ça va me glisser des mains<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3800:0:1"
msgid "Please hurry.<br>I can feel my<br>fingers slipping..."
msgstr "Поторопись.<br>Чувствую, как пальцы<br>уже соскальзывают..."

#. ja: 碧甲羅どもを<br>討ち取れェー！
#. de: Zeig's den blauen Schwächlingen!
#. fr: Écaille ce misérable Veeeert<nbsp>!
msgctxt "Balloon:3801:0:1"
msgid "Kill them! Kill them all!"
msgstr "Убейте их! Всех до одного!"

#. ja: かゆい所はないか？
#. de: Zwickt's?
#. fr: C'est ici que ça te gratte, mon tout beau<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3802:0:1"
msgid "These salt fleas will<br>suck the poor girl dry!"
msgstr "Эти соляные блохи бедняжку<br>высосут досуха!"

#. ja: シュー…了解した<br>上官に伝えておこう
#. de: Gut, ich sage im Lager Bescheid.
#. fr: Je vais en avertir mon officier. Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3803:0:1"
msgid "I sssee...<br>I shall have some more delivered."
msgstr "Понял...<br>Распоряжусь доставить ещё."

#. ja: 街道沿いの魔物が<br>活発化しています！
#. de: Die Ameisenlöwen auf dem Weg nach Bittermühl sind wieder auf Jagd!
#. fr: Chef, de nombreuses créatures dangereuses ont été repérées près de la route<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3804:0:1"
msgid "A swarm of tracer antlions<br>is approaching from the north!"
msgstr "С севера надвигается рой<br>муравьиных львов-следопытов!"

#. ja: わかった<br>至急討伐隊を編成しろ！
#. de: Keine Sorge. Die Grenzwache Velodyna kümmert sich darum!
#. fr: Je vois. Dans ce cas, forme im<shy>mé<shy>dia<shy>te<shy>ment une unité pour les exterrrminer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3805:0:1"
msgid "Then you'd better<br>round up some men<br>and take care of it!"
msgstr "Тогда собери людей<br>и разберись с ними!"

#. ja: シュー…我らは<br>いつでも出動できるぞ
#. de: Ich überbringe geheime Informationen aus Virdjala.
#. fr: Mes sœurs et moi sommes prêtes à partir en mission à tout moment. Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3806:0:1"
msgid "We are eager<br>to prove ourssselves."
msgstr "Мы готовы доказать,<br>на что способны..."

#. ja: 次はどの依頼を受けようか？
#. de: Ich übernehme die vitalen Bäume und du das kühlende Moos.
#. fr: Quelle mission on fait maintenant<nbsp>? J'aime pas trop l'odeur des marids, personnellement...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3807:0:1"
msgid "Perhaps we should<br>ask for something less<br>dangerous this time?"
msgstr "Может, на этот раз<br>возьмём задание<br>побезопаснее?"

#. ja: 言い値で構わん！<br>アンタが脱いだ皮を譲ってくれ！
#. de: Kommt schon, gebt mir eure alten Häute. Ihr braucht sie doch nicht mehr.
#. fr: Dites-moi votre prix, je suis prêt à tout ce que vous voudrez pour vos mues<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3808:0:1"
msgid "Surely you don't need<br>those cast-off skins?<br>Name your price!"
msgstr "Сколько хотите!<br>Вам ведь не нужны старые шкуры?<br>Назовите цену!"

#. ja: シュー…<br>食材の備蓄は十分か？
#. de: Wir erwarten eine Karawane. Hassst du genügend zu essen und zu trinken?
#. fr: On a assez de vivres en réserve<nbsp>? Ssss...
msgctxt "Balloon:3809:0:1"
msgid "Are you in need of provisions?"
msgstr "Вам нужны припасы?"

#. ja: ギリギリかなぁ…
#. de: Nicht mehr als drei, vier Portionen.
#. fr: Pas vrrraiment, non...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3810:0:1"
msgid "We've got enough food,<br>but we're running low on arak!"
msgstr "Еды-то хватает,<br>а вот арака почти не осталось!"

#. ja: 了解であります！
#. de: Verstanden!
#. fr: À vos ordres<nbsp>!
msgctxt "Balloon:3811:0:1"
msgid "Understood!"
msgstr "Понял!"

#. ja: 餌の消費が激しいな…
#. de: Nicht zu fassen, wie viel diese Biester fressen<nbsp>...
#. fr: La vache<nbsp>! Qu'est-ce que ça mange, ces bestiaux<nbsp>!<nbsp>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3812:0:1"
msgid "A marid eats as much<br>in a day as five chocobos<br>do in a sennight."
msgstr "За день марид съедает<br>столько же, сколько пять чокобо<br>за целую семидневку."

#. ja: いい塩が採れそうだ！
#. de: Das Salz sieht heute besonders ... salzig aus.
#. fr: Hmm, ce boulot manque vraiment pas de sel.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3813:0:1"
msgid "They say the best salt's<br>that what's been harvested<br>by hand...er, rake."
msgstr "Говорят, лучшая соль —<br>та, что добыта вручную... э-э, граблями."

#. ja: 腰にくるな…
#. de: \<keuch> ... Die Salzernte geht auf Dauer aufs Rückgrat.
#. fr: Arrgh... Mon dos me fait atrocement souffrir.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3814:0:1"
msgid "They seem to be doing<br>just fine without my help."
msgstr "Вроде и без моей помощи<br>неплохо справляются."

#. ja: 魔物には<br>目を光らせておくよ！
#. de: Ich werde die Biester blenden!
#. fr: Je fusille du regard toutes les vilaines créatures qui s'approchent.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3815:0:1"
msgid "You see anything, you<br>either kill it or you run─<br>just not in this direction."
msgstr "Увидел что — либо убей,<br>либо беги. Только не сюда."

#. ja: 警備は万全です！
#. de: Mir entgeht nichts!
#. fr: Ces travailleurs sont en sécurité avec nous, c'est moi qui te l'dis<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3816:0:1"
msgid "I can put an arrow in the<br>eye of a yabby from a<br>hundred paces...give or<br>take ninety-five."
msgstr "Я могу попасть стрелой яби в глаз со ста шагов... ну, с пяти, если повезёт."

#. ja: 質は大丈夫だろうね<br>ロロリト様は味にうるさいぞ？
#. de: Wehe, wenn du Loloritos Salz schon wieder mit Kalk gestreckt hast!
#. fr: Certes, mais le seigneur Lolorito est très exigeant pour ce qui est du goût.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3817:0:1"
msgid "If I find you've been cutting<br>Master Lolorito's salt with<br>chalk again..."
msgstr "Если я узнаю, что ты опять разбавлял соль господина Лолорито мелом..."

#. ja: 質ならバッチリですよ！
#. de: Nein, niemals! Ehrenwort!
#. fr: Notre sel est de la meilleure qualité.
msgctxt "Balloon:3818:0:1"
msgid "Never! You have my word!"
msgstr "Никогда! Даю слово!"

#. ja: 加工品の販売も<br>始めたいところだな…
#. de: Salz haben wir genug, aber wir müssen es auch verkaufen.
#. fr: J'ai bien envie de commencer à vendre des aliments saumurés...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3819:0:1"
msgid "There's plenty of salt to<br>sell...but no one to buy it."
msgstr "Соли на продажу хоть отбавляй... да только покупателей нет."

#. ja: 工房の設備を<br>整えなければ…
#. de: Diese Steinblöcke bewegen sich nicht von selbst.
#. fr: Il nous faut mieux équiper nos ateliers si nous voulons améliorer notre rendement...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3820:0:1"
msgid "These blocks are not<br>going to move themselves."
msgstr "Эти глыбы сами себя не передвинут."

#. ja: 資金を有効に使わないとね
#. de: Wir müssen unsere Ressourcen gut nutzen.
#. fr: Nous devons à tout prix utiliser nos fonds à bon escient.
msgctxt "Balloon:3821:0:1"
msgid "You've two, don't you?"
msgstr "У тебя ведь два, да?"

#. ja: もっと人手を増やせないか？
#. de: Woher bekommen wir bloß mehr Helfer?
#. fr: Nous avons besoin de plus de bras, surtout. Tu ne crois pas<nbsp>?
msgctxt "Balloon:3822:0:1"
msgid "I could use another hand."
msgstr "Ещё бы помощника не помешало."

#. ja: 復興のためーならー<br>えんやこーら！
#. de: Für Ala Mhigos Aufschwung mach ich mir gern den Rücken krumm!
#. fr: Je veux bien avoir mal au dos si c'est pour Ala Mhigo<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3823:0:1"
msgid "If it helps Ala Mhigo,<br>I'll rake from dawn till dusk!"
msgstr "Если это поможет Ала Миго, буду грести с рассвета до заката!"

#. ja: ソルトリーの塩こそレストラン<br>「ビスマルク」に相応しい
#. de: Das hiesige Salz soll das beste sein, und für das Bismarck ist das Beste gerade gut genug.
#. fr: Les clients du Bismarck méritent les meilleurs ingrédients, et c'est ici qu'on trouve le meilleur sel<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3824:0:1"
msgid "They say there is none<br>finer than Saltery salt,<br>and the Bismarck must<br>have the finest!"
msgstr "Говорят, лучше соли, чем<br>из Солильни, не сыщешь.<br>А в «Бисмарки» подают<br>только самое лучшее!"

#. ja: グリダニアの内陸から<br>貴重な塩を買いだめに来たの
#. de: Nophica sei Dank für Lasten-Chocobos. Ich würde das Salz nur ungern selbst zurück nach Gridania schleppen.
#. fr: Avec tout ce bon sel, je vais faire des jaloux à Gridania<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3825:0:1"
msgid "Thank Nophica for pack<br>chocobos. I don't fancy<br>carrying a sack of salt all<br>the way back to Gridania..."
msgstr "Слава Нофике, что есть вьючные чокобо. Тащить мешок соли до самого Гридании мне совсем не хочется..."

#. ja: じゅる…こりゃ美味そうだ
#. de: Sieht alles so lecker aus! Da weiß man ja gar nicht, wo man zuerst reinbeißen soll.
#. fr: Oh là là... Tout a l'air tellement bon, j'en ai l'eau à la bouche.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3826:0:1"
msgid "Mmm...<br>I don't know which<br>to sample first!"
msgstr "М-м-м... Даже не знаю, что попробовать первым!"

#. ja: 訪問の記念に<br>何か買ってけよ
#. de: Wie wär's mit einem kleinen Andenken?
#. fr: Ne partez pas sans un petit souvenir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3827:0:1"
msgid "You can't leave without<br>a souvenir!"
msgstr "Без сувенира ты отсюда не уйдёшь!"

#. ja: …しょっぱいな
#. de: Gibt es auch irgendwas, das nicht gesalzen ist?
#. fr: Hmm, non. La facture est trop salée.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3828:0:1"
msgid "So, <i>everything</i> is salted...?"
msgstr "То есть <i>всё</i> у вас солёное?.."

#. ja: ああ…<br>きっとお前の父さんも喜んでるよ
#. de: Dein Vater wäre stolz auf dich!
#. fr: C'est ton père qui doit être content.
msgctxt "Balloon:3829:0:1"
msgid "Aye, your father'd be proud..."
msgstr "Ага... Твой отец бы тобой гордился..."

#. ja: 村が賑やかになったね！
#. de: Jetzt ist hier wieder richtig was los!
#. fr: Tout le monde est drôlement occupé ces temps-ci.
msgctxt "Balloon:3830:0:1"
msgid "It's all so busy now!"
msgstr "Теперь тут так оживлённо!"

#. ja: ソルトリー名物の塩漬けだよ！<br>さあ、味見してってくれ！
#. de: Gesalzener Fisch, gesalzenes Fleisch, nur die Preise sind nicht gesalzen!
#. fr: Approchez, approchez<nbsp>! Venez goûter nos délices à la fleur de sel<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3831:0:1"
msgid "Salted fish! Salted treats!<br>Go on, have a taste!"
msgstr "Солёная рыба! Солёные лакомства! Ну же, попробуйте!"

#. ja: 質はもちろん、生産量も<br>更に上がってますよ！
#. de: Unsere Qualität sucht ihresgleichen! Und die Produktion läuft ebenfalls auf vollen Touren!
#. fr: Nous ga<shy>ran<shy>tis<shy>sons la qualité et la quantité<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3832:0:1"
msgid "Our quality is second to none!<br>And production has increased tenfold!"
msgstr "Качество у нас отменное! А производство выросло в десять раз!"

#. ja: ひとまず工房は整った<br>あとはどう拡大していくか…
#. de: Die Fabrikation läuft, jetzt müssen wir nur noch expandieren.
#. fr: Maintenant que nos ateliers sont opérationnels, on va pouvoir songer à s'agrandir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3833:0:1"
msgid "Now that the factory's up and<br>working, it's a matter of<br>expanding operations..."
msgstr "Теперь, когда фабрика работает, осталось только расширить производство..."

#. ja: もっと生産を増やせるわね
#. de: Wir kurbeln die Produktion einfach weiter an!
#. fr: Tant mieux, ça va donner un coup d'accélérateur à la production.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3834:0:1"
msgid "I'm sure we can find<br>work for them all..."
msgstr "Уверена, мы найдём работу для всех..."

#. ja: 同胞の働き手が更に増えたぞ！
#. de: Mittlerweile haben wir mehr Helfer, als wir brauchen.
#. fr: On recrute à tour de bras ces temps-ci<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3835:0:1"
msgid "Now we've more hands than<br>we know what to do with!"
msgstr "Теперь рабочих рук больше, чем нам нужно!"

#. ja: ないしょだっぺ
#. de: Sag keinem, dass du mich hier gefffunden hast, ja?
#. fr: Pssst<nbsp>! Surtout dis à personne que je suis caché ici<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3836:0:1"
msgid "We didn't see nothing if<br>you didn't see nothing."
msgstr "Мы ничего не видели, если и ты ничего не видел."

#. ja: ブドゥガに反省は不要…
#. de: Pah! Wir haben nichts falsch gemacht. Wir sind nur unserem Instinkt gefolgt.
#. fr: Un Buduga n'a pas à présenter des excuses.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3837:0:1"
msgid "But we have done nothing<br>wrong! Nothing!"
msgstr "Но мы не сделали ничего дурного! Ничего!"

#. ja: 今日は具合よさそうだね！
#. de: Heute geht es dir schon viel besser, oder?
#. fr: Tu as bonne mine, aujourd'hui.
msgctxt "Balloon:3838:0:1"
msgid "You're looking better today!"
msgstr "Сегодня ты выглядишь лучше!"

#. ja: まったく…<br>お前は懲りないな
#. de: Es geht. \<knurr>
#. fr: T'es vraiment collante, toi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3839:0:1"
msgid "No thanks to you and<br>your nosiness."
msgstr "И всё из-за тебя и твоего любопытства."

#. ja: イシブシさん！<br>こっち！助けて！
#. de: Hilfe, Meister Ishibushi! Wie lange soll ich denn noch hier hängen?
#. fr: Ha<nbsp>!!! I-Ishibushi<nbsp>! Au secours<nbsp>! J'vais lâcher<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3840:0:1"
msgid "Ishibushi! Help! I know you<br>can hear me! Ishibushi!"
msgstr "Исибуси! Помоги! Я знаю, ты меня слышишь! Исибуси!"

#. ja: そろそろ交代か？
#. de: Soll ich mal?
#. fr: Tu commences pas à fatiguer<nbsp>? On peut changer, si tu veux.
msgctxt "Balloon:3841:0:1"
msgid "I can take over, if you like..."
msgstr "Хочешь, я тебя сменю?.."

#. ja: うん、いい具合だ！
#. de: Ja, es wird, es wird.
#. fr: Eh ben, ça m'a l'air pas mal tout ça<nbsp>!
msgctxt "Balloon:3842:0:1"
msgid "Aye, aye, that's the way..."
msgstr "Ага, вот так..."

#. ja: こっちはまだ危ないぞ
#. de: Hier kann keiner durch. Einsturzgefahr.
#. fr: Défense d'entrer. Les bâtiments menacent de s'effondrer au moindre coup de vent.
msgctxt "Balloon:3843:0:1"
msgid "Area past the gate's not safe."
msgstr "За воротами всё ещё опасно."

#. ja: それもいい案ね
#. de: Wenn alles nicht hilft, musst du es wohl deiner Schwiegermutter erzählen. Die wird deinem Mann die Ohren langziehen.
#. fr: Ah oui, tiens, Pourquoi on ne ferait pas comme ça<nbsp>?
msgctxt "Balloon:3844:0:1"
msgid "It's not a bad idea, but..."
msgstr "Неплохая мысль, но..."

#. ja: 呼び鈴の…次は…むにゃ…
#. de: Ich bleibe hier sitzen, bis ich es verstanden habe.
#. fr: Bon, la sonnette, c'est fait. Maintenant... (bâille)...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3845:0:1"
msgid "Must you be forever ringing...<br>that infernal bell..."
msgstr "Ну зачем всё время звонить...<br>в этот проклятый колокол..."

#. ja: ここで米を作るには…
#. de: Es ist ein Genuss, Reis zu essen. Aber es ist ein echtes Fest, ihn zu <i>trinken</i>! \<hicks>
#. fr: Manger du riz, c'est bien... Mais en boire, c'est mieux... Hic<nbsp>!
msgctxt "Balloon:3846:0:1"
msgid "So I says to the maiko, I says..."
msgstr "Ну и говорю я майко..."

#. ja: この先、瓦礫の撤去中だ
#. de: Der Zugang zum zerstörten Teil der Enklave ist gesperrt.
#. fr: Mes camarades sont en train de déblayer la zone derrière cette porte.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3847:0:1"
msgid "Way's closed. We're still<br>clearing plots."
msgstr "Проход закрыт. Мы ещё разбираем завалы."

#. ja: お米…しあわせ…
#. de: Mmh, Onigiri esse ich für mein Leben gern!
#. fr: Miam<nbsp>! Il est trop bon, ce riz<nbsp>!
msgctxt "Balloon:3848:0:1"
msgid "Rice...is happiness..."
msgstr "Рис... вот оно, счастье..."

#. ja: おっとっと！
#. de: Aaah!
#. fr: Ouaaah<nbsp>!
#. macro: <if ($gn11 < 12)><if ($gn11 < 4)>night<else>day</if><else><if ($gn11 < 17)>day<else>night</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 12 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gn11 < 4)>night<else>day</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 4 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gn11 < 17)>day<else>night</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 17 (condition: may be reworded, restructured, added, or dropped)
msgctxt "Balloon:3849:0:1"
msgid "I could do this all <if ($gn11 < 12)><if ($gn11 < 4)>night<else>day</if><else><if ($gn11 < 17)>day<else>night</if></if>!"
msgstr "Я бы так мог <if ($gn11 < 12)><if ($gn11 < 4)>ночь<else>день</if><else><if ($gn11 < 17)>день<else>ночь</if></if> напролёт!"

#. ja: お母さんが呼んでるよ
#. de: Mama ruft. Hör auf zu spielen und komm nach Hause.
#. fr: Maman t'appelle. Arrête de jouer et rentre à la maison<nbsp>!
msgctxt "Balloon:3850:0:1"
msgid "Ma's calling for you!"
msgstr "Мама тебя зовёт!"

#. ja: あーとーでー
#. de: Ja ja, gleich ...
#. fr: Oui, oui, j'arrive.
msgctxt "Balloon:3851:0:1"
msgid "Not now! I'm busy!"
msgstr "Не сейчас! Я занят!"

#. ja: お父さんが怒ってるよ
#. de: Übertreib's nicht. Papa ist stinkesauer.
#. fr: Papa est vraiment fâché, tu sais.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3852:0:1"
msgid "Da says he's gonna throw all<br>your toys in the One River if<br>you don't come right now!"
msgstr "Папа говорит, что бросит все твои игрушки в Реку Одну, если ты сейчас же не придёшь!"

#. ja: な、なんで<br>言っちゃうんだよぉ！
#. de: Mir doch egal!
#. fr: J'm'en fiche<nbsp>! Je veux continuer de m'amuser<nbsp>!
msgctxt "Balloon:3853:0:1"
msgid "I'm not falling for that again!"
msgstr "На этот раз я на эту уловку не куплюсь!"

#. ja: じゃあ、待ってるからね！
#. de: Na gut. Aber ich hab dich gewarnt.
#. fr: Je rentre sans toi, alors. Je t'aurai prévenu.
msgctxt "Balloon:3854:0:1"
msgid "Fine! See what happens!"
msgstr "Ну и ладно! Сам смотри!"

#. ja: 追加の資材は<br>ここでいいか？
#. de: Soll ich das hier ablegen?
#. fr: Je pose ça ici<nbsp>?
msgctxt "Balloon:3855:0:1"
msgid "Leave the materials here?"
msgstr "Оставить материалы здесь?"

#. ja: ああ、ありがとよー！
#. de: Ah, ja. Vielen Dank.
#. fr: Euh, oui. Merci.
msgctxt "Balloon:3856:0:1"
msgid "Aye, right there's fine!"
msgstr "Ага, сюда как раз!"

#. ja: 完成が楽しみね
#. de: Bitte, Yomogi. Besuch mich doch mal, wenn das Haus fertig ist.
#. fr: J'ai hâte de voir quand ça sera terminé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3857:0:1"
msgid "I can't wait to see what it<br>looks like when it's finished!"
msgstr "Не терпится увидеть, как всё будет выглядеть, когда закончат!"

#. ja: ここはどうなるのかな～
#. de: Was bauen die wohl hier?
#. fr: Qu'est-ce qu'ils essaient de construire ici<nbsp>?<nbsp>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3858:0:1"
msgid "Wonder what they're<br>going to do with it..."
msgstr "Интересно, что они тут задумали..."

#. ja: この木材はどうする？
#. de: Für wen ist das Holz?
#. fr: Bon, et ces planches, je les pose où alors<nbsp>?
msgctxt "Balloon:3859:0:1"
msgid "Where do you want these?"
msgstr "Куда это положить?"

#. ja: すぐ確認するわね！
#. de: Einen Moment, ich seh mal nach.
#. fr: Attends, il faut que je vérifie...
msgctxt "Balloon:3860:0:1"
msgid "Give me a moment!"
msgstr "Секундочку!"

#. ja: 帳面はどこかしら…
#. de: Wo ist denn nur das Orderbuch?
#. fr: Mince, où est passé le registre<nbsp>?<nbsp>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3861:0:1"
msgid "Where did I leave<br>that ledger...?"
msgstr "Куда же я дела эту ведомость?.."

#. ja: 重い…腰がつらい…
#. de: Mach schon, ich kann's nicht ewig halten.
#. fr: Dépêche-toi... J'en peux plus...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3862:0:1"
msgid "(Don't...don't mind<br>me over here... Ugh...)"
msgstr "(Не... не обращайте на меня<br>внимания... Ох...)"

#. ja: 今後の買い付けは<br>どうしますか？
#. de: Ich sage doch, ich kann in meinen Büchern nichts über eine Großbestellung finden.
#. fr: Les légumes dans le coin là, c'est pour quoi faire au juste<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3863:0:1"
msgid "Then what would you like<br>us to purchase instead?"
msgstr "Тогда что нам купить вместо этого?"

#. ja: よし、こっちは十分ね
#. de: Alles da!
#. fr: Je crois que ça suffira.
msgctxt "Balloon:3864:0:1"
msgid "That ought to suffice for now."
msgstr "Пока этого должно хватить."

#. ja: 調味料は足りそうよ
#. de: Die Gewürzvorräte sind komplett.
#. fr: On devrait avoir assez d'épices.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3865:0:1"
msgid "Looks like we've still<br>got plenty of spices."
msgstr "Похоже, специй у нас ещё полно."

#. ja: はいよォ
#. de: Ja, notiert.
#. fr: D'accord, je le note.
msgctxt "Balloon:3866:0:1"
msgid "Very good, very good..."
msgstr "Ладно, ладно..."

#. ja: うーん…<br>ちょっと少ないかしら
#. de: Hm ... Das wird nicht reichen.
#. fr: Hmm... Ça ne fait pas beaucoup...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3867:0:1"
msgid "Hmm... Thought we had more<br>around here somewhere..."
msgstr "Хм... Кажется, тут где-то было побольше..."

#. ja: 野菜はもっとほしいかも
#. de: Wir brauchen mehr Gemüse.
#. fr: Il me faudrait plus de légumes.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3868:0:1"
msgid "I don't think we've got enough<br>vegetables to last the week."
msgstr "Кажется, овощей на всю неделю не хватит."

#. ja: コザクラちゃんに<br>言っとくよ
#. de: Gut, ich sag Kozakura Bescheid.
#. fr: Je vais en informer Kozakura.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3869:0:1"
msgid "Let Kozakura know.<br>She'll take care of it."
msgstr "Сообщи Кодзакуре.<br>Она разберётся."

#. ja: これで一段落だな
#. de: Das war's. Ich geh jetzt ne Runde schlafen.
#. fr: Ouf<nbsp>! Tout est là. Je vais pouvoir piquer un petit somme.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3870:0:1"
msgid "Everything is accounted for.<br>I triple-checked."
msgstr "Всё на месте.<br>Я трижды проверил."

#. ja: ツラヌキさんから<br>頼まれた分は？
#. de: Und die Stahlplatten für Tsuranuki?
#. fr: Il y a ce que Tsuranuki a demandé<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3871:0:1"
msgid "Including the materials<br>for Master Tsuranuki?"
msgstr "И материалы для господина Цурануки тоже?"

#. ja: そうだった…<br>確かめておこう
#. de: Oje! Die hab ich ja ganz vergessen!
#. fr: Hmm<nbsp>? Maintenant que tu le dis, j'ai pas vérifié.
msgctxt "Balloon:3872:0:1"
msgid "...Perhaps I should check again."
msgstr "...Пожалуй, стоит ещё раз проверить."

#. ja: はは、ご苦労さん！
#. de: Ha ha, wird wohl nichts mit dem Nickerchen, was?
#. fr: Mieux vaut être sûr, à mon avis.
msgctxt "Balloon:3873:0:1"
msgid "Perhaps you should."
msgstr "И правда, стоит."

#. ja: おみやげ持ってきたよぉ～
#. de: Ich habe dir einen Schatz der Rubinsee ...... mitgebracht.
#. fr: Je vous ai apporté ce cadeaaaau.
msgctxt "Balloon:3874:0:1"
msgid "I come bearing gifts!"
msgstr "Я принесла подарочки!"

#. ja: 調子はどう～？
#. de: Wie läuft ...... 's?
#. fr: Alors, ça moooord<nbsp>?
msgctxt "Balloon:3875:0:1"
msgid "Any luck?"
msgstr "Ну как, клюёт?"

#. ja: まぁ見ててくれ
#. de: Pass mal auf!
#. fr: Oui, regarde au bout de ma ligne<nbsp>!
msgctxt "Balloon:3876:0:1"
msgid "I've got a good feeling..."
msgstr "Что-то подсказывает мне, что повезёт..."

#. ja: きたッ！
#. de: Da! Das ist ein ganz fetter!
#. fr: Je vais ferrer un beau poisson<nbsp>!
msgctxt "Balloon:3877:0:1"
msgid "Something took the bait!"
msgstr "Есть! Клюнула!"

#. ja: かかったぁ～！
#. de: Meinen herzlichsten ....... Glückwunsch.
#. fr: Bravoooo<nbsp>!
msgctxt "Balloon:3878:0:1"
msgid "Oho!"
msgstr "Ого!"

#. ja: お見事ぉ～！
#. de: Du verstehst was vom ...... Angeln.
#. fr: Vous êtes un excellent pêcheeeeur.
msgctxt "Balloon:3879:0:1"
msgid "A marvelous catch!"
msgstr "Вот это улов!"

#. ja: よし、もういっちょ！
#. de: Wart mal ab, als Nächstes zieh ich einen Kapitalen an Land!
#. fr: Allez, je vais en attraper un autre<nbsp>!
msgctxt "Balloon:3880:0:1"
msgid "Let's see what else is biting!"
msgstr "Посмотрим, что ещё клюнет!"

#. ja: うーん、焦りすぎか？
#. de: Nanu? Er ist entwischt.
#. fr: Mince, j'ai été trop nerveux...
msgctxt "Balloon:3881:0:1"
msgid "Reeled it in too quickly...?"
msgstr "Слишком быстро подсек?.."

#. ja: もう1回やってみよぉ～！
#. de: Versuch noch ...... mal.
#. fr: Couraaaage<nbsp>! Vous aurez le prochain, j'en suis sûûûûr.
msgctxt "Balloon:3882:0:1"
msgid "Don't give up so easily!"
msgstr "Не сдавайся так легко!"

#. ja: この図だと…
#. de: Also wenn der Firstbalken mit dem Querbalken verbunden ist, dann müsste doch eigentlich<nbsp>...
#. fr: Hmm, d'après le plan, mon étal se trouvera juste là.
msgctxt "Balloon:3883:0:1"
msgid "...Is this upside down?"
msgstr "...Это не вверх ногами?"

#. ja: 木材はたりてるか？
#. de: Reicht das Holz?
#. fr: Vous manquez de bois<nbsp>?
msgctxt "Balloon:3884:0:1"
msgid "Need anything?"
msgstr "Что-нибудь нужно?"

#. ja: 板が数枚ほしいな
#. de: Wir brauchen noch ein paar Bretter.
#. fr: Ben, je dirais pas non à quelques planches de plus.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3885:0:1"
msgid "Might could do with<br>a few more boards!"
msgstr "Нам бы ещё пару досок!"

#. ja: わかった、手配しておく
#. de: Verstanden. Bin gleich wieder da.
#. fr: D'accord, on va vous préparer ça.
msgctxt "Balloon:3886:0:1"
msgid "I'll see what I can do."
msgstr "Постараюсь что-нибудь придумать."

#. ja: 追加発注を聞いてきたぞ
#. de: Wir brauchen noch Bretter.
#. fr: Il nous en faut aussi<nbsp>!
msgctxt "Balloon:3887:0:1"
msgid "Smiths need more boards─"
msgstr "Кузнецам нужно ещё досок─"

#. ja: さあ、出発するぞ！
#. de: Los, weiter geht's!
#. fr: Bon, il est temps de partir<nbsp>!
msgctxt "Balloon:3888:0:1"
msgid "It's time to go!"
msgstr "Пора идти!"

#. ja: わかってる…<br>わかってるけどさぁ…
#. de: Ja ja, ich weiß ...
#. fr: Oui, je sais, je sais...
msgctxt "Balloon:3889:0:1"
msgid "Can't we stay another night?"
msgstr "Я знаю, знаю... Но нельзя остаться ещё на одну ночь?"

#. ja: なぜ、その寝台から<br>離れようとしない？
#. de: Warum kommst du dann nicht? Hat man dich auf der Liege festgenagelt?
#. fr: Qu'est-ce que t'as à rester planté sur ce canapé<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3890:0:1"
msgid "No! We didn't come<br>all the way here to<br>laze about!"
msgstr "Нет! Мы же не затем проделали весь этот путь,<br>чтобы тут бездельничать!"

#. ja: この座り心地…寝心地が…<br>まさに夢見心地で…
#. de: Die Kissen ... Sie sind so wunderbar weich.
#. fr: C'est juste que mes fesses sont si bien dessus...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3891:0:1"
msgid "But we might never<br>be able to sleep on<br>such comfy beds again!"
msgstr "Но ведь мы больше никогда<br>не поспим на таких удобных<br>кроватях!"

#. ja: それはわかるが…<br>いい加減行くぞ！
#. de: Wir sind aber nicht zum Sitzen nach Gyr Abania gekommen.
#. fr: Même si c'est le cas, il faut que tu les en décolles<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3892:0:1"
msgid "I'll blame you if<br>someone else claims those<br>marks before we do!"
msgstr "А я тебя обвиню, если кто-нибудь другой займёт эти места раньше нас!"

#. ja: あと少し…<br>あと少しでいいから…！
#. de: Nur noch ein klitzekleines Bisschen, ja?
#. fr: Donne-moi encore quelques minutes, s'il te plaît...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3893:0:1"
msgid "One more night!<br>That's all I ask!"
msgstr "Ещё одну ночь!<br>Ну пожалуйста!"

#. ja: クエ！
#. de: Kweh?
#. fr: Kwé<nbsp>!
msgctxt "Balloon:3894:0:1"
msgid "Kweh!"
msgstr "Ку-у-э!"

#. ja: 我が隊の人手不足は深刻だ…
#. de: Wir brauchen mehr Soldaten.
#. fr: Nous manquons cruellement de personnel...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3895:0:1"
msgid "We're spreading<br>ourselves too thin..."
msgstr "Нас слишком мало на все дела..."

#. ja: 痛みはないか？
#. de: Was machen die Schmerzen?
#. fr: Vous avez mal quelque part<nbsp>?
msgctxt "Balloon:3896:0:1"
msgid "Tell me, does this hurt?"
msgstr "Скажи, здесь больно?"

#. ja: ああ…<br>だいぶ楽になった…
#. de: Das Pochen hat aufgehört, aber das Stechen ist noch da.
#. fr: Aeuurrgh... Je... je me sens mieux... je crois...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3897:0:1"
msgid "Ah! Only when you<br>poke it like that!"
msgstr "Ай! Только когда вы тыкаете вот так!"

#. ja: 薬が効いたようだね
#. de: Der Pochtrunk wirkt also.
#. fr: On dirait que mon médicament a fait son effet.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3898:0:1"
msgid "That means you're<br>on the mend."
msgstr "Значит, лекарство действует. Скоро поправишься."

#. ja: 任務とはいえ<br>無茶はほどほどにな
#. de: Ich werde dich für die nächste Schicht krankschreiben.
#. fr: Mission ou pas, reposez-vous bien.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3899:0:1"
msgid "Be more careful in future.<br>You're no good to us dead."
msgstr "В следующий раз будь осторожнее.<br>Мёртвым ты нам не поможешь."

#. ja: ハ…ハラが痛い…
#. de: Mein ... Mein Bauch tut immer noch weh<nbsp>...
#. fr: J'ai... J'ai trop mal au bide...
msgctxt "Balloon:3900:0:1"
msgid "Argh! My stomach!"
msgstr "Ай! Живот болит!"

#. ja: 拾い食いなんてするからさ
#. de: Man darf halt nicht alles essen, was man auf dem Boden findet.
#. fr: Ça, c'est parce que vous mangez tout ce que vous trouvez dans la nature.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3901:0:1"
msgid "You shouldn't eat<br>wild berries. They<br>could be poisonous!"
msgstr "Не ешь ягоды, которые растут где попало. Вдруг они ядовитые!"

#. ja: また同じことしたら<br>次は開腹するからな！
#. de: Das nächste Mal operiere ich, nur um dir eine Lektion zu erteilen.
#. fr: La prochaine fois, je n'hésiterai pas à vous ouvrir la panse. Compris<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3902:0:1"
msgid "Do it again, and I'll<br>cut you open and<br>dig them out myself!"
msgstr "Ещё раз так сделаешь — вспорю тебе живот и сама их достану!"

#. ja: クレーンがあれば<br>仕事が更にはかどるな！
#. de: Hm, mit einem Kran wäre die Arbeit leichter.
#. fr: Si seulement on avait une grue, ça nous simplifierait grandement la tâche...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3903:0:1"
msgid "I could while away the hours,<br>Liftin' bags of salt and flour,<br>If I only had a crane.♪"
msgstr "Мог бы я часами мешки таскать,<br>Соль да муку наверх поднимать,<br>Будь у нас только кран! ♪"

#. ja: よーし、引き上げるぞー！
#. de: Ich zieh jetzt hoch. Also weg vom Eimer!
#. fr: Ne bougez pas, on va vous hisser ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3904:0:1"
msgid "Winching her up, then!<br>Stand clear!"
msgstr "Поднимаем!<br>Отойдите!"

#. ja: 塩、入れたぞー！
#. de: Die Eimer sind voll!
#. fr: On a trois sacs pleins à craquer<nbsp>!
msgctxt "Balloon:3905:0:1"
msgid "The buckets are full!"
msgstr "Вёдра полные!"

#. ja: ヒトの気配がするチュン…
#. de: \<schnüff> Ich rieche Sterbliche!
#. fr: (snif)... (snif)... Ça sent l'humain par ici...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3906:0:1"
msgid "A manfool!<br>A manfool in our midst!"
msgstr "Тут человек...<br>Человек среди нас!"

#. ja: ヒトは嫌いチュン～！
#. de: Ich hasse Sterbliche!
#. fr: Hiii<nbsp>!<nbsp>... J'aime pas les humains<nbsp>!
msgctxt "Balloon:3907:0:1"
msgid "I hate manfools!"
msgstr "Ненавижу людишек!"

#. ja: また来たチュン…
#. de: Schon wieder?
#. fr: Oh, non<nbsp>!<nbsp>...
msgctxt "Balloon:3908:0:1"
msgid "The manfool is still about..."
msgstr "Человек всё ещё здесь..."

#. ja: しつこいチュン～！
#. de: Lass mich in Ruhe!
#. fr: Quel pot de colle<nbsp>!
msgctxt "Balloon:3909:0:1"
msgid "Gah! What a stalker!"
msgstr "Уф! Ну и преследователь!"

#. ja: 見ない顔だが<br>新入りか？
#. de: Bist du neu hier?
#. fr: Je te connais pas, toi. T'es nouveau<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3910:0:1"
msgid "Haven't seen you around<br>before. You new?"
msgstr "Раньше тебя тут не видел.<br>Новенький?"

#. ja: はい！<br>裏返ったばかりです！
#. de: Ja! Gerade frisch metamorphosiert!
#. fr: Oui<nbsp>! Je viens juste de faire ma métamorphose<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3911:0:1"
msgid "Sure am! Just went <br>through the change!"
msgstr "Ага! Только что превратился!"

#. ja: そうかそうか<br>ネズミの瑞獣とは珍しい
#. de: Willkommen im Klub! 'ne Maus als Zuiju sieht man nicht oft!
#. fr: Ah, je vois... Eh bien, t'es la première souris parmi nous.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3912:0:1"
msgid "Heh, pretty rare for a rat<br>to live long enough─"
msgstr "Хех, крыса — редкость среди нас─"

#. ja: カワウソですが！？
#. de: Maus?! Ich bin 'n Otter, du Blindfisch!
#. fr: Euh... Je suis une loutre, pas une souris<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3913:0:1"
msgid "Rat? Rat!?<br>I am an otter, good sir!"
msgstr "Крыса? Крыса!?<br>Я вообще-то выдра, сударь!"

#. ja: なんとしても<br>鎮石を拝みたい！
#. de: Ich möchte mir den Stein noch mal aus der Nähe ansehen!
#. fr: J'ai tellement envie de prier devant la shizume-ishi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3914:0:1"
msgid "That's it! I'm going to<br>go and see the sacred<br>crystal right this instant!"
msgstr "Всё! Пойду прямо сейчас посмотрю на священный кристалл!"

#. ja: またコマイヌに<br>怒られるぞ…
#. de: Das wird den Komainu aber gar nicht gefallen.
#. fr: Tu vas encore te faire gronder<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3915:0:1"
msgid "Don't do it! Genbu's gonna<br>put a curse on you!"
msgstr "Не надо! Гэнбу тебя проклянёт!"

#. ja: 構うもんか！<br>猪突猛進だ！
#. de: Ach was, ich bin so schnell, die sehen mich gar nicht!
#. fr: Même pas peur<nbsp>! Je ferai une charge de sanglier<nbsp>!
msgctxt "Balloon:3916:0:1"
msgid "Hah! You can't scare me!"
msgstr "Ха! Меня не напугаешь!"

#. ja: これより先は<br>立ち入り禁止だ
#. de: Betreten verboten!
#. fr: Hé là<nbsp>! Interdiction d'aller plus loin<nbsp>!
msgctxt "Balloon:3917:0:1"
msgid "None shall pass!"
msgstr "Дальше прохода нет!"

#. ja: そんなこと言わずに<br>一度だけ！
#. de: Och bitte, nur ein Mal!
#. fr: Allez<nbsp>! Juste une fois... S'il te plaît<nbsp>!
msgctxt "Balloon:3918:0:1"
msgid "Just this once! Please!"
msgstr "Ну пожалуйста, только в этот раз!"

#. ja: 玄武さまに<br>叱られたいか？
#. de: Muss ich erst Genbu holen?
#. fr: Tu veux que maître Genbu te punisse<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3919:0:1"
msgid "Set one hoof inside and<br>Genbu will curse you for<br>ten thousand years!"
msgstr "Только сунь копыто внутрь —<br>Гэнбу проклянёт тебя<br>на десять тысяч лет!"

#. ja: 大人しく帰りま～す！
#. de: Ach was, keine Umstände! Bin schon weg!
#. fr: Euh... D'accord... J'ai compris...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3920:0:1"
msgid "Fine! But you haven't<br>heard the last of this!"
msgstr "Ладно! Но это ещё не конец!"

#. ja: 今回も門前払い…
#. de: Sie haben mich schon wieder abblitzen lassen.
#. fr: Grouuuiiiin... Je me suis encore fait refouler...
msgctxt "Balloon:3921:0:1"
msgid "They wouldn't let me pass..."
msgstr "Меня опять не пропустили..."

#. ja: 当たり前だろ…
#. de: Hast du was anderes erwartet?
#. fr: Je t'avais pourtant bien prévenu<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3922:0:1"
msgid "Of course not!<br>They didn't before,<br>so why would they now!?"
msgstr "А ты чего ждал!? Раньше не пропускали, с чего бы теперь пропускать!?"

#. ja: たまには社に<br>顔を出すか～
#. de: Ich könnte mal wieder etwas frische Luft vertragen.
#. fr: Une petite visite au sanctuaire de temps en temps ne peut pas me faire de mal...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3923:0:1"
msgid "It's been a while since<br>I said hello..."
msgstr "Давно я не заходил поздороваться..."

#. ja: これより<br>狩りに行かぬか？
#. de: Ich auch. Wollen wir jagen gehen?
#. fr: Ça te dirait d'aller chasser ensemble<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3924:0:1"
msgid "I am of a mind to hunt.<br>Interested?"
msgstr "Не прочь поохотиться?"

#. ja: 清々しい気分だ…
#. de: Ich fühle mich frei!
#. fr: Je me sens libéré...
msgctxt "Balloon:3925:0:1"
msgid "Such serenity, such peace..."
msgstr "Как спокойно... Как умиротворённо..."

#. ja: 身体中が痛むがな…
#. de: Mein ganzer Körper schmerzt<nbsp>...
#. fr: Malgré les vives douleurs...
msgctxt "Balloon:3926:0:1"
msgid "Though my body aches..."
msgstr "Хотя всё тело ноет..."

#. ja: 我が魂を鎮めてくれたこと<br>深く感謝する…
#. de: Meine Seele ist besänftigt. Vielen Dank.
#. fr: Je te remercie d'avoir apaisé mon âme...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3927:0:1"
msgid "I no longer fear for my soul.<br>My thanks to you..."
msgstr "Теперь я не боюсь за свою душу. Спасибо тебе..."

#. ja: おにいさんといるの<br>楽しいもん！
#. de: Macht nichts. Ich leiste dir gerne Ge<shy>sell<shy>schaft.
#. fr: Mais c'est parce que j'aime bien ta compagnie.
msgctxt "Balloon:3928:0:1"
msgid "Hehe, you're funny!"
msgstr "Хи-хи, ты смешной!"

#. ja: まだ薬は入らないのか？
#. de: Ist die Medizin immer noch nicht da?
#. fr: Toujours pas de ce médicament<nbsp>?
msgctxt "Balloon:3929:0:1"
msgid "Do you have any more medicine?"
msgstr "У вас ещё осталось лекарство?"

#. ja: 稀少だし値も張るからな
#. de: Leider nein. Das Mittel ist wirklich schwer zu bekommen. Und es hat seinen Preis.
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment non. Il est rare et bien cher, tu sais...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3930:0:1"
msgid "It's getting harder to come by.<br>You'll have to pay double."
msgstr "Доставать его всё труднее. Придётся заплатить вдвое больше."

#. ja: しかし、お前に<br>治す気があったとは
#. de: Aber das habe ich dir ja gestern schon gesagt.
#. fr: Mais je ne pensais pas que ça t'intéresserait tant que ça.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3931:0:1"
msgid "Didn't think you'd come back,<br>given your condition..."
msgstr "Не думал, что ты вернёшься... с таким-то состоянием."

#. ja: …聞いてみただけだ
#. de: Ich werde es morgen wieder versuchen.
#. fr: Je ne faisais que demander, c'est tout.
msgctxt "Balloon:3932:0:1"
msgid "...Was curious, is all."
msgstr "...Просто спросил."

#. ja: 手伝ってもらって悪いな
#. de: Man muss sich darin spiegeln können.
#. fr: Ça, c'est bon, c'est épongé...
msgctxt "Balloon:3933:0:1"
msgid "Never hurts to have an extra set of eyes looking over the hull!"
msgstr "Лишняя пара глаз не помешает, когда осматриваешь корпус!"

#. ja: しっかり整備しないと…
#. de: So, das müsste halten.
#. fr: Ça, c'est bon, c'est réparé...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3934:0:1"
msgid "Need to get this<br>tub patched up..."
msgstr "Надо бы подлатать<br>эту посудину..."

#. ja: イハナシ、たくましくなったな…
#. de: Mein Sohn. Das Leben auf der See hat dich stark gemacht.
#. fr: Quand je t'ai quitté, tu n'étais encore qu'un enfant. Mais tu es un homme, maintenant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3935:0:1"
msgid "Look at you, boy.<br>Life on the sea has<br>made you strong..."
msgstr "Ну и вырос же ты, сынок.<br>Море сделало тебя<br>крепким..."

#. ja: 母さんにまた会えるなんて…
#. de: Mutter, verzeih mir ... Ich hatte die Hoffnung schon fast aufgegeben!
#. fr: Maman. (snif)... Je croyais que je ne te reverrais jamais...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3936:0:1"
msgid "Mother, I...<br>I never thought<br>I'd see you again."
msgstr "Мама, я...<br>Я и не думал,<br>что увижу тебя снова."

#. ja: よく…<br>よく生きて戻ってきてくれたね…
#. de: Den Kami sei Dank, dass du wieder hier bist.
#. fr: Tu es revenu... envers et contre tout<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3937:0:1"
msgid "We hardly dared hope!<br>Thank the kami you're alive..."
msgstr "Мы и не смели надеяться!<br>Слава ками, ты жив..."

#. ja: おや、そちらは<br>ネコの瑞獣ですか？
#. de: Oh, ist das ein Katzen-Zuiju?
#. fr: Oh<nbsp>! J'imagine que tu es un nouveau Zuijû...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3938:0:1"
msgid "Who's your friend?<br>A new auspice?"
msgstr "А это кто с тобой?<br>Новый дзюдзю?"

#. ja: ニャ～ン
#. de: Miau!
#. fr: Miaaaoouu<nbsp>!
msgctxt "Balloon:3939:0:1"
msgid "Meow!♪"
msgstr "Мяу!♪"

#. ja: いやこいつは<br>ただのネコだ
#. de: Nee, das ist bloß 'ne Katze.
#. fr: Euh, c'est juste un chat qui traînait dans le coin.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3940:0:1"
msgid "Oh him? He's just some<br>cat that wandered in."
msgstr "А, он? Да это просто<br>кошка приблудилась."

#. ja: ただのネコ！？
#. de: Bloß 'ne Katze?!
#. fr: Chat alors<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:3941:0:1"
msgid "Wandered in? Past the<br>wards and guards and<br><i>liquid hot magma</i>!?"
msgstr "Приблудилась? Мимо<br>защитных барьеров, стражи и<br><i>раскалённой магмы</i>!?"

#. ja: アジム・ブフは<br>奥が深いっぺな～
#. de: Azim-Bökh ist ja sowas von kompliziert. \<spotz>
#. fr: L'Azim bukh, c'est aussi une façon de penser, en fait<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3944:0:1"
msgid "Is it appropriate to<br>grab him like that?"
msgstr "Разве можно вот так<br>брать его на руки?"

#. ja: 見てるだけで<br>燃えてくるっぺよ！
#. de: Da fffang ich schon Fffeuer, wenn ich bloß hingucke!
#. fr: Rien que de regarder, je me sens fébrile<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3945:0:1"
msgid "As long as it's above<br>the belt... I think..."
msgstr "Пока выше пояса...<br>Наверное..."

#. ja: まだまだ持てるぞ
#. de: Ich kann noch was tragen.
#. fr: C'est tout<nbsp>? J'peux en porter encore plus que ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3946:0:1"
msgid "Is that it?<br>I can still carry more."
msgstr "И это всё?<br>Я ещё могу нести."

#. ja: 頼もしいじゃないか…
#. de: Von deiner Sorte können wir noch mehr gebrauchen.
#. fr: Hé hé, voilà qui promet.
msgctxt "Balloon:3947:0:1"
msgid "I could use a dozen more like you..."
msgstr "Вот бы ещё десяток таких, как ты..."

#. ja: さぁ、もっと張り切って！
#. de: Sehr gut, weiter so!
#. fr: Allez, on donne tout<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3948:0:1"
msgid "That's it, my friends.<br>Now lift your knees higher."
msgstr "Вот так, друзья.<br>А теперь поднимайте колени повыше."

#. ja: すごいニャ！<br>狩猟成功だニャ！
#. de: Wir haben ihn erjagt! \<miau>
#. fr: Bravo<nbsp>! Chat, c'est de la chasse<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3949:0:1"
msgid "You did it!<br>You slew the meownster!"
msgstr "Получилось!<br>Ты одолел мяучудище!"

#. ja: 忘れずに<br>素材を剥ぎ取るニャ！
#. de: Vergiss nicht, dir den Kadaver anzusehen!
#. fr: N'oublie surtout pas de dépecer le Rathalos<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3950:0:1"
msgid "Don't forget to carve<br>a scale or two off his hide."
msgstr "Не забудь срезать<br>с его шкуры чешуйку-другую."

#. ja: アジム・ブフ<br>かっこいいっぺな…
#. de: Azim-Bökh ist vvvoll ffflossig!
#. fr: L'Azim bukh, c'est la classe<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3951:0:1"
msgid "Tell me more of how you<br>fractured that man's skull!"
msgstr "Расскажи ещё, как ты<br>раскроил тому человеку череп!"

#. ja: や、休みたいっぺよ…
#. de: Mir ist schon ganz schwindelig!
#. fr: J'ai besoin de repos...
msgctxt "Balloon:3952:0:1"
msgid "Time for a break? Yes, yes?"
msgstr "Пора отдохнуть? Да-да?"

#. ja: ナマズが弓射をするとはな…
#. de: Namazuo beim Bogenschießen? Die Götter müssen verrückt sein.
#. fr: Je n'aurais jamais cru voir le jour où un Namazu tirerait à l'arc...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3953:0:1"
msgid "No Namazu may wield a<br>bow without supervision."
msgstr "Нельзя давать намазу лук<br>без присмотра."

#. ja: はやく馬を<br>乗りこなしたいっぺな
#. de: Bald bin ich der beste Reiter der ganzen Steppe! \<spotz>
#. fr: J'ai hâte de devenir un bon cavalier<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3954:0:1"
msgid "I almost made it up<br>onto the horse today!"
msgstr "Сегодня я почти забрался<br>на лошадь!"

#. ja: おいしそうっぺな…
#. de: Das sieht aber lecker aus! \<spotz>
#. fr: Miam, ça a l'air délicieux...
msgctxt "Balloon:3955:0:1"
msgid "Mmm, fish... Yes, yes..."
msgstr "М-м, рыбка... Да-да..."

#. ja: 盗み食いはダメっぺよ！
#. de: Lass deine gierigen Ffflossen von dem Zeug!
#. fr: Si tu y mets la nageoire, tu auras du bâton<nbsp>!
msgctxt "Balloon:3956:0:1"
msgid "Fins off the offering!"
msgstr "Плавники прочь от подношения!"

#. ja: な、なにも食べてないっぺよ！
#. de: Ich hab nichts angerührt! Glitschiges Ehrenwort!
#. fr: Oyoyo<nbsp>!? Je n'ai touché à rien<nbsp>!
msgctxt "Balloon:3957:0:1"
msgid "I-I was just looking!"
msgstr "Я-я только смотрел!"

#. ja: 本当っぺか？<br>ウソついてないっぺな…？
#. de: Wirklich? Du willst mir doch bestimmt einen Seebären aufbinden!
#. fr: Vraiment<nbsp>? Tu es sûr que tu ne mens pas<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3958:0:1"
msgid "Are you sure? Your<br>eyes say you are lying..."
msgstr "Точно? По глазам видно,<br>что врёшь..."

#. ja: 本当っぺよ！<br>見てただけだっぺな！
#. de: Ehrlich! Ich hab bloß geguckt! \<spotz>
#. fr: Mais oui, je ne faisais que regarder<nbsp>!
msgctxt "Balloon:3959:0:1"
msgid "They do not! No, no."
msgstr "Ничего они не говорят! Нет-нет."

#. ja: みんな、おいらのことを<br>すぐ疑うっぺよ…
#. de: Ifff fffab ehrlich blofff geguckffft. \<mampfff> \<spotz>
#. fr: Pourquoi tout le monde m'accuse toujours à tort...<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3960:0:1"
msgid "Eat the offering <i>one time</i><br>and never hear the end of it..."
msgstr "Стоит <i>один раз</i> съесть подношение —<br>и потом этого не забудут..."

#. ja: 的はたくさんあるっぺな
#. de: Besser 'ne zerschossene Zielscheibe als 'ne zerschossene Kniescheibe! Ist 'ne alte Namazuo-Weisheit!
#. fr: Qui veut mes jolies cibles<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3961:0:1"
msgid "Are you in need of<br>a target or three?"
msgstr "Мишень нужна?<br>Могу дать одну-другую."

#. ja: 準備は順調っぺか？
#. de: Wie laufffen die Vvvorbereitungen?
#. fr: Alors, c'est bientôt prêt<nbsp>?
msgctxt "Balloon:3962:0:1"
msgid "My fins hurt..."
msgstr "У меня плавники болят..."

#. ja: やらないといけないことが<br>てんこもりだっぺな…
#. de: Wir haben alle Ffflossen voll zu tun!
#. fr: Il y a tellement à faire...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3963:0:1"
msgid "What a coincidence!<br>My fins hurt too!"
msgstr "Вот совпадение!<br>У меня тоже плавники болят!"

#. ja: もうひと踏ん張り、<br>頑張るっペよ！
#. de: Dann lass uns in die Flossen spucken und zusehen, dass wir fffertig werden.
#. fr: Allez, encore un effort<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3964:0:1"
msgid "Amazing! Mine<br>hurt more, though."
msgstr "Вот это да! А у меня<br>болят ещё сильнее."

#. ja: 早く降りるっぺよ
#. de: Mach, dass du da runterkommst!
#. fr: Quand il faut descendre, il faut descendre.
msgctxt "Balloon:3965:0:1"
msgid "Will you please come down?"
msgstr "Ты уже спустишься?"

#. ja: お、降りられないっぺな
#. de: Ich vvversuch's ja!
#. fr: Oyoyooo<nbsp>! Je ne peux paaas<nbsp>!
msgctxt "Balloon:3966:0:1"
msgid "I c-cannot just now..."
msgstr "Я-я пока не могу..."

#. ja: わっしょい！<br>わっしょい！！
#. de: Wasshoi! Wasshoi!
#. fr: Oh hisse<nbsp>! Oh hisse<nbsp>!
msgctxt "Balloon:3967:0:1"
msgid "Wasshoi! Wasshoi!"
msgstr "Вассёй! Вассёй!"

#. ja: いや、こっちっぺよ
#. de: Nein, hierhin!
#. fr: Non, c'est par ici.
msgctxt "Balloon:3968:0:1"
msgid "No, no. Over here!"
msgstr "Нет-нет, сюда!"

#. ja: こっちっぺな
#. de: Hierhin?
#. fr: Puisque je te dis que c'est par là<nbsp>!
msgctxt "Balloon:3969:0:1"
msgid "Over here! Yes, yes."
msgstr "Сюда! Да-да."

#. ja: なにかあったっぺか？
#. de: Was ist los?
#. fr: Que se passe-t-il<nbsp>?
msgctxt "Balloon:3970:0:1"
msgid "Whatever is the matter?"
msgstr "Что случилось?"

#. ja: おいらのハッピが<br>ないっぺな！
#. de: Mein Happi ist weg!
#. fr: Où est mon happi<nbsp>!?
msgctxt "Balloon:3971:0:1"
msgid "My happi is missing!"
msgstr "Мой хаппи пропал!"

#. ja: 余りのハッピあったっぺな…？
#. de: Lass mich mal sehen, ob ich noch einen fffür dich<nbsp>...!
#. fr: Il en reste<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3972:0:1"
msgid "I know we have<br>extras somewhere..."
msgstr "Где-то у нас должны<br>быть запасные..."

#. ja: って、着てるっぺな！
#. de: He, du trägst ihn ja, du Dumpfffkieme!
#. fr: Et ça, c'est quoi<nbsp>?
msgctxt "Balloon:3973:0:1"
msgid "Wait, are you not wearing it?"
msgstr "Погоди, да ты же его надел!"

#. ja: うぺぺ！？
#. de: W-Was?! Oh, stimmt ja!
#. fr: Oyoyo<nbsp>!?
msgctxt "Balloon:3974:0:1"
msgid "Wow! So I am!"
msgstr "Вот это да! И правда!"

#. ja: よーく狙え！
#. de: Wenn du mir noch mal in den Zeh schießt, dann setzt's was!
#. fr: Visez bien le cœur de la cible<nbsp>!
msgctxt "Balloon:3975:0:1"
msgid "Steady yourself!"
msgstr "Целься получше!"

#. ja: 大丈夫か！？
#. de: Kannst du aufstehen?
#. fr: Rien de cassé<nbsp>?
msgctxt "Balloon:3976:0:1"
msgid "Anything broken?"
msgstr "Ты не ушибся?"

#. ja: フー…フー…
#. de: \<pust> ... \<pust> ...
#. fr: PFFFF<nbsp>!!! (inspire)... PFFFF<nbsp>!!!
msgctxt "Balloon:3977:0:1"
msgid "\\<puff> \\<puff>"
msgstr "<i>Фу-ух! Фу-ух!</i>"

#. ja: もぉ…落とさないよぅ…
#. de: E-Einen mach ich noch<nbsp>...
#. fr: Chais pro-promis<nbsp>! (hips) C'est la dernière fois que j'fais tomber du miso<nbsp>! La dernière fois<nbsp>!
msgctxt "Balloon:3978:0:1"
msgid "One more...for the road!"
msgstr "Ещё разок... напоследок!"

#. ja: 少し味が薄いかしら
#. de: Hm ... Es fehlt noch der gewisse Pfiff.
#. fr: Hmm... C'est encore un peu fade.
msgctxt "Balloon:3979:0:1"
msgid "Bit bland, isn't it..."
msgstr "Маловато вкуса, да?"

#. ja: お味噌は…
#. de: Pfifferlinge<nbsp>... Irgendwo hatte ich doch noch Pfifferlinge<nbsp>...
#. fr: Où est-ce que j'ai mis ma sauce miso...<nbsp>?
msgctxt "Balloon:3980:0:1"
msgid "Maybe a dash of miso..."
msgstr "Может, добавить мисо..."

#. ja: それ大事なお味噌なの！
#. de: Vorsicht! Das ist wertvolle Miso-Paste!
#. fr: Fais bien attention à ce pot, d'accord<nbsp>? C'est ma meilleure soupe miso<nbsp>!
msgctxt "Balloon:3981:0:1"
msgid "Be careful with that miso!"
msgstr "Осторожнее с мисо!"

#. ja: ここって何になるの？
#. de: Wird das hier etwa<nbsp>...?
#. fr: Qu'est-ce qu'il y aura ici<nbsp>?
msgctxt "Balloon:3982:0:1"
msgid "What will you be selling?"
msgstr "А что вы будете продавать?"

#. ja: あなたの予想どおりよ
#. de: So ist es!
#. fr: Ta nourriture préférée<nbsp>!
msgctxt "Balloon:3983:0:1"
msgid "You'll see!"
msgstr "Увидишь!"

#. ja: うん、バッチリね！
#. de: Passt perfekt!
#. fr: Bien, il y a tout ce qu'il faut<nbsp>!
msgctxt "Balloon:3984:0:1"
msgid "Good, good..."
msgstr "Хорошо, хорошо..."

#. ja: これだけあるなら…
#. de: Ich kann mich nicht entscheiden<nbsp>...
#. fr: Si c'est entre ces poissons, je vais prendre... Hum, j'hésite.
msgctxt "Balloon:3985:0:1"
msgid "This ought to suffice..."
msgstr "Этого должно хватить..."

#. ja: いい匂いがするー！
#. de: Allein von dem Geruch läuft einem das Wasser im Munde zusammen!
#. fr: J'ai des gargouillis tellement ça sent bon<nbsp>!
msgctxt "Balloon:3986:0:1"
msgid "Gosh, that smells good!"
msgstr "Ох, как же вкусно пахнет!"

#. ja: どんなお店になるかなぁ
#. de: Was wird das wohl für ein Stand?
#. fr: Je me demande ce qui sera vendu ici.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:3987:0:1"
msgid "And what kind of stall<br>are you hoping for?"
msgstr "А какой прилавок<br>ты хочешь?"

#. ja: 鮭屋さんがいい！
#. de: Süßigkeiten! Ich will Süßigkeiten!
#. fr: Du saumon<nbsp>! Oh, j'espère que ce sera du saumon<nbsp>!
msgctxt "Balloon:3988:0:1"
msgid "A salmon stall!"
msgstr "Прилавок с лососем!"

#. ja: えっ、鮭だけ売るの…？
#. de: Was, ein Süßigkeitengeschäft auf einem Markt?
#. fr: Que ça<nbsp>!?
msgctxt "Balloon:3989:0:1"
msgid "Err... Just salmon?"
msgstr "Э-э... Только лосось?"

#. ja: 案外…いいかも…
#. de: Obwohl, eigentlich keine schlechte Idee<nbsp>...
#. fr: En même temps, le saumon, c'est délicieux...
msgctxt "Balloon:3990:0:1"
msgid "I suppose...that might..."
msgstr "Пожалуй... это может..."

#. ja: よくできてるなぁ
#. de: Die sehen gut aus, ne?
#. fr: Im<shy>pres<shy>sionnant. On croirait des vrais.
msgctxt "Balloon:3991:0:1"
msgid "They look so real..."
msgstr "Как настоящие..."

#. ja: 私も食べたい！
#. de: Papa, ich will haben!
#. fr: J'veux en manger<nbsp>! J'veux en manger<nbsp>!
msgctxt "Balloon:3992:0:1"
msgid "I wanna try one!"
msgstr "Я тоже хочу попробовать!"

#. ja: お前、お金なんて…
#. de: G-Gut, such dir was aus.
#. fr: Pour ça faut de l'argent.
msgctxt "Balloon:3993:0:1"
msgid "But I haven't got much─"
msgstr "Но у меня денег-то..."

#. ja: お姉さん、<br>ひとつずつください！
#. de: Hallo! Eins von jedem, bitte.
#. fr: Un de chaque, s'il vous plaît<nbsp>!
msgctxt "Balloon:3994:0:1"
msgid "One of each, please!"
msgstr "Девушка,<br>по одному каждого, пожалуйста!"

#. ja: はっ！？待て待て！
#. de: Nein, nein, nein, so war das nicht gemeint.
#. fr: Q-quoi<nbsp>!? N-nan<nbsp>! Attendez<nbsp>! Elle a pas un sou, elle<nbsp>!
msgctxt "Balloon:3995:0:1"
msgid "What!? Absolutely not!"
msgstr "Что!? Ни за что!"

#. ja: ひ、ひとつならな…
#. de: Einen. Such dir einen aus.
#. fr: Bon, d'accord. Arrête de pleurer. Je t'en paye un.
msgctxt "Balloon:3996:0:1"
msgid "...All right, one. One!"
msgstr "...Ладно, один. Только один!"

#. ja: えへへ…<br>どれにしようかな！
#. de: Hm ... Welchen nehm ich denn dann?
#. fr: J'arrive pas à choisir, ils sont tous si mignons<nbsp>!
msgctxt "Balloon:3997:0:1"
msgid "Hehe... So many choices..."
msgstr "Хи-хи... И какой же выбрать?"

#. ja: これで全部並べたぞ
#. de: Das war alles.
#. fr: Et voilà, tous vos légumes sont là.
msgctxt "Balloon:3998:0:1"
msgid "All laid out, like you asked."
msgstr "Разложил всё, как просили."

#. ja: あら？茄子は？
#. de: Was, keine Nasu-Auberginen?
#. fr: Vous êtes sûr<nbsp>? Il manque les aubergines, non<nbsp>?
msgctxt "Balloon:3999:0:1"
msgid "Oh? Where's the eggplant?"
msgstr "А баклажаны где?"
