# Balloon
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: ……
#. de:  ... ... ...
#. fr: ...
msgctxt "Balloon:7000:0:1"
msgid "..."
msgstr "..."

#. ja: ニャ～
#. de: Miau!
#. fr: Miaou<nbsp>!
msgctxt "Balloon:7001:0:1"
msgid "Meow!"
msgstr "Мяу!"

#. ja: ウホウホッ！？
#. de: \<grunz> ? \<grummel> \<schnauf>
#. fr: Ouh ouh<nbsp>!
msgctxt "Balloon:7002:0:1"
msgid "Ooh ooh! Ooh...ooh?"
msgstr "У-гу! У-гу... У-гу?"

#. ja: おいおい、なんだこりゃ…！？
#. de: Bei den guten Geistern, was ist denn hier los?
#. fr: Je rêve<nbsp>!?
msgctxt "Balloon:7003:0:1"
msgid "What in the hells is going on here!?"
msgstr "Какого чёрта тут творится!?"

#. ja: 魔物かと思って驚いたわ…
#. de: Die Leute scheinen sich prächtig zu amüsieren ...
#. fr: J'ai eu si peur...
msgctxt "Balloon:7004:0:1"
msgid "And here I thought monsters were on the loose..."
msgstr "А я-то думал, что тут монстры разгуливают..."

#. ja: ラーニングできるだろうか…？
#. de: Ob man das lernen kann?
#. fr: Je peux le faire, moi aussi<nbsp>?
msgctxt "Balloon:7005:0:1"
msgid "Now then, what can I learn today?"
msgstr "Ну-ка, чему бы сегодня научиться?"

#. ja: パンプキンプディング…！<br>素敵な響き…！
#. de: Kürbispudding! Eine Tonze! Was meint ihr?
#. fr: Du flan à la citrouille... Ça doit être délicieux<nbsp>!
msgctxt "Balloon:7006:0:1"
msgid "Pumpkin pudding... It sounds simply marvelous!"
msgstr "Тыквенный пудинг... Звучит просто чудесно!"

#. ja: 手強い相手だったな
#. de: Kein leichter Kampf.
#. fr: Ouf... Ça aurait pu mal tourner à tout moment.
msgctxt "Balloon:7007:0:1"
msgid "That was a fearsome foe."
msgstr "Вот это был грозный противник."

#. ja: 今の妖異はいったい…？
#. de: Dieses Nichtswesen ...
#. fr: Cette créature... Elle n'était vraiment pas comme les autres.
msgctxt "Balloon:7008:0:1"
msgid "Who was that voidsent...?"
msgstr "Кто это был, voidsent?.."

#. ja: もう終わりか？
#. de: War das alles?
#. fr: Ça y est<nbsp>? On a gagné<nbsp>?
msgctxt "Balloon:7009:0:1"
msgid "Is that it?"
msgstr "И это всё?"

#. ja: ライブ中に変身…！？<br>いいアイデアが思いついたわ！
#. de: Ein Ver<shy>wand<shy>lungstrank? Da kommt mir eine Idee<nbsp>...
#. fr: Se transformer en plein concert, c'est une super idée<nbsp>!
msgctxt "Balloon:7010:0:1"
msgid "Transformation, hmm? Ladies, I've a wonderful idea for our next concert!"
msgstr "Превращение, говорите? Леди, у меня чудесная идея для нашего следующего концерта!"

#. ja: 面白そうですね～
#. de: Ich finde, das sieht lustig aus!
#. fr: Je suis d'accord<nbsp>!
msgctxt "Balloon:7011:0:1"
msgid "Isn't it just fascinating?"
msgstr "Разве это не завораживает?"

#. ja: なんだか凄い光景ね…
#. de: Irgendwie gruselig ...
#. fr: C'est im<shy>pres<shy>sion<shy>nant...
msgctxt "Balloon:7012:0:1"
msgid "What a peculiar festival."
msgstr "Какой странный праздник."

#. ja: おそらくこの空間も<br>獄卒長によって…
#. de: Was für ein Scheusal<nbsp>...
#. fr: Je présume que cet environnement est l'œuvre du grand geôlier...
msgctxt "Balloon:7013:0:1"
msgid "So this is the measure of a keyward's power..."
msgstr "Вот, значит, на что способен ключник..."

#. ja: …ふう、間に合ったか
#. de: Das wäre geschafft.
#. fr: Pfiou, un peu plus et on arrivait trop tard.
msgctxt "Balloon:7014:0:1"
msgid "We weren't too late."
msgstr "Успели."

#. ja: 今度こそ、封印成功だね
#. de: Wir haben die Kreatur!
#. fr: La capture s'est bien passée. Heu<shy>reu<shy>se<shy>ment, car ce n'était pas gagné.
msgctxt "Balloon:7015:0:1"
msgid "So long as she lives there is yet hope."
msgstr "Пока она жива, надежда ещё есть."

#. ja: やった…やったぞ！
#. de: Hurra! Geschafft!
#. fr: J'y crois pas, on a réussi<nbsp>!
msgctxt "Balloon:7016:0:1"
msgid "We've won!"
msgstr "Мы победили!"

#. ja: ここで、決着だ…
#. de: Und jetzt die Entscheidung<nbsp>...
#. fr: Il est temps d'en finir...
msgctxt "Balloon:7017:0:1"
msgid "Now we end this."
msgstr "Пора покончить с этим."

#. ja: 強大な存在を感知している
#. de: Ich spüre eine mächtige Präsenz.
#. fr: Je perçois une présence très puissante...
msgctxt "Balloon:7018:0:1"
msgid "I sense a dreadful presence..."
msgstr "Я чувствую зловещее присутствие..."

#. ja: なんと禍々しい…
#. de: Das fühlt sich nicht gut an.
#. fr: Quel sinistre édifice...
msgctxt "Balloon:7019:0:1"
msgid "This does not bode well."
msgstr "Ничего хорошего это не сулит."

#. ja: そこに、たしかに<br>存在しているということか…
#. de: Ja, da müsste es sein.
#. fr: Au début, j'ai cru que j'avais la berlue...
msgctxt "Balloon:7020:0:1"
msgid "Does that...belong there?"
msgstr "Значит... оно и правда там?"

#. ja: 家で待つお母さんへの土産は<br>なにがよいだろうか？
#. de: Nun, was glaubst du, würde Mama gefallen?
#. fr: Quel cadeau je peux ramener pour maman...<nbsp>?
msgctxt "Balloon:7021:0:1"
msgid "Now, what do you think Mother would like?"
msgstr "Как думаешь, что бы порадовало маму?"

#. ja: うーん…
#. de: Hmm ...
#. fr: Hmmm...
msgctxt "Balloon:7022:0:1"
msgid "Hmm..."
msgstr "Хм..."

#. ja: そうだ！<br>みんなで食べられるものは？
#. de: Ich weiß was! Eine Leckerei, die wir alle zusammen genießen können!
#. fr: Ah, je sais<nbsp>! Quelque chose qu'on pourra manger tous en famille<nbsp>!
msgctxt "Balloon:7023:0:1"
msgid "I know! A treat we can enjoy as a family!"
msgstr "Знаю! Угощение, которым можно полакомиться всей семьёй!"

#. ja: フフ…それなら<br>とびきり大きなケーキを買おう
#. de: Wie wär's dann mit ... einem riesigen Kuchen?
#. fr: Hi hi... Comme un bon gros gâteau<nbsp>!
msgctxt "Balloon:7024:0:1"
msgid "Hmm... How about a big cake?"
msgstr "Хм... Может, большой торт?"

#. ja: キャロットジュース調理中…
#. de: Einmal Karottensaft geschüttelt! \<ratter> ...
#. fr: Et un jus de carotte, un<nbsp>! Pshhh...
msgctxt "Balloon:7025:0:1"
msgid "Carrot juice protocols active."
msgstr "Запускаю приготовление морковного сока."

#. ja: ううむ<br>うまく飛べるだろうか…
#. de: Hoffentlich fliegt sie vorsichtig<nbsp>...
#. fr: Est-ce qu'elles peuvent vraiment voler...<nbsp>?
msgctxt "Balloon:7026:0:1"
msgid "I fear their levitation faculties are still developing..."
msgstr "Боюсь, они ещё не вполне освоили левитацию..."

#. ja: ミっミミ～♪
#. de: Mihihiii～♪
#. fr: Mimmimiiii<nbsp>!♪
msgctxt "Balloon:7027:0:1"
msgid "Mimimimi!♪"
msgstr "Мимимими!♪"

#. ja: ミィ！<br>ミミっ♪
#. de: Mi! Miimi～
#. fr: Mii<nbsp>! Mimiiii<nbsp>!♪
msgctxt "Balloon:7028:0:1"
msgid "Miii!"
msgstr "Миии!"

#. ja: ミミ…ミミミ？
#. de: Miii?
#. fr: Mimi... Mimimi<nbsp>?
msgctxt "Balloon:7029:0:1"
msgid "\\<burble> ...Mi?"
msgstr ""

#. ja: いいや、自由連盟の奴に<br>使わせてやるといい
#. de: Nein, nein, den überlass ich euch von der Freiheitsunion.
#. fr: Il y a erreur, c'est au tour des gars du Front de s'en servir...
msgctxt "Balloon:7030:0:1"
msgid "Oh, I couldn't possibly. What if the Fighters need it?"
msgstr "О нет, что вы. А вдруг бойцам понадобится?"

#. ja: 対話の機会すら…<br>それでも私は…
#. de: Wir konnten nicht einmal reden<nbsp>...
#. fr: On n'a même pas pu discuter...
msgctxt "Balloon:7031:0:1"
msgid "Why did she refuse to listen? Why didn't I..."
msgstr "Почему она отказалась слушать? Почему я не..."

#. ja: フン…頂上はすぐそこだ<br>足踏みしている暇はないぞ
#. de: Der Gifpel ist nah. Keine Zeit zum Trödeln.
#. fr: Le sommet est proche, ne trainons pas.
msgctxt "Balloon:7032:0:1"
msgid "We're nearly to the summit. Let's keep moving."
msgstr "До вершины рукой подать. Не будем стоять на месте."

#. ja: イゼル、君は…<br>いや、先へ進もう
#. de: Ysayle, du<nbsp>... Ach, schon gut. Setzen wir unsere Reise fort.
#. fr: Ysayle, vous... Non, rien. Continuons notre route.
msgctxt "Balloon:7033:0:1"
msgid "...We should go, Ysayle. The summit awaits."
msgstr "Изейль, ты... Нет, пойдём дальше. Вершина ждёт."

#. ja: 気を抜くなよ…<br>まだ奴は生きている…！
#. de: Nicht nachlassen, es ist noch nicht vorbei.
#. fr: Ne vous relâchez pas, ce n'est pas terminé.
msgctxt "Balloon:7034:0:1"
msgid "On your guard. Our work here is not yet done."
msgstr "Не расслабляйся. Мы ещё не закончили."

#. ja: 大丈夫か、友よ…<br>怪我はないか？
#. de: Geht es dir gut, <if $gn4>meine Liebe<else>mein Freund</if>? Bist du verletzt?
#. fr: Mon ami<if $gn4>e</if>, tu n'es pas <if $gn4>blessée<else>blessé</if><nbsp>?
msgctxt "Balloon:7035:0:1"
msgid "Are you all right, my friend?"
msgstr "Ты в порядке, мой друг? Не ранена?"

#. ja: 行こう…教皇を確保して<br>この戦いを終わらせるために…
#. de: Schnappen wir uns den Papst und bereiten dem Ganzen ein Ende.
#. fr: Arrêtons l'Archevêque et mettons fin à tout ça...
msgctxt "Balloon:7036:0:1"
msgid "We must hurry, ere the archbishop can make good his escape."
msgstr "Надо спешить, пока архиепископ не сбежал."

#. ja: 肥料は<br>ここでよかったか？
#. de: Soll hier der Dünger hin?
#. fr: C'est bien ici que je dois poser l'engrais<nbsp>?
msgctxt "Balloon:7037:0:1"
msgid "Shall I leave this fertilizer here?"
msgstr "Оставить удобрение здесь?"

#. ja: いや、世界連邦の奴に<br>持ってってやれ
#. de: \<schnüffel> Nein, bring das Zeug bitte zu den Rothelmen.
#. fr: Non, ce chargement est pour les gars de la Fédération.
msgctxt "Balloon:7038:0:1"
msgid "Let the Citizens have this batch."
msgstr "Отнеси эту партию Гражданам."

#. ja: 肥料、使うんだろ？
#. de: Hier ist dein Dünger.
#. fr: J'apporte l'engrais<nbsp>!
msgctxt "Balloon:7039:0:1"
msgid "Fertilizer delivery!"
msgstr "Доставка удобрения!"

#. ja: ここは内緒の場所だぞ
#. de: Das ist mein Geheimversteck. Verrat es niemandem!
#. fr: Tu ne dois parler de cet endroit à personne.
msgctxt "Balloon:7040:0:1"
msgid "You can stay─but tell no one."
msgstr "Можешь остаться, только никому не рассказывай."

#. ja: 思索の深まる場所と<br>思わんかね？
#. de: Dieser Ort lädt zum Nachdenken ein, findest du nicht auch?
#. fr: Cet endroit est parfait pour une séance de débat, n'est-ce pas<nbsp>?
msgctxt "Balloon:7041:0:1"
msgid "A suitable location for meditation."
msgstr "Подходящее место для размышлений."

#. ja: ええ、それに<br>時間は溢るほどある
#. de: Oh ja. Worüber wollen wir nachdenken?
#. fr: Oui, et nous avons toute la vie devant nous pour argumenter<nbsp>!
msgctxt "Balloon:7042:0:1"
msgid "Quite. And we have much time."
msgstr "Вот именно. Времени у нас предостаточно."

#. ja: 何から議論しようか…
#. de: Lass mich dir meine neueste Theorie erklären<nbsp>...
#. fr: Très bien, par quel sujet commence-t-on<nbsp>?
msgctxt "Balloon:7043:0:1"
msgid "Which thesis shall we obliterate?"
msgstr "Какую же дискуссию начнём?.."

#. ja: 宇宙魚…なのか…？
#. de: Ist das ein Weltraumfisch?
#. fr: Je n'en ai jamais vu de pareil<nbsp>!
msgctxt "Balloon:7044:0:1"
msgid "Er..."
msgstr "Э-э..."

#. ja: 泳いじゃおうかしら！
#. de: Plitsch, platsch, alle werden nass!
#. fr: Et si je piquais une petite tête<nbsp>?
msgctxt "Balloon:7045:0:1"
msgid "Have a dip!"
msgstr "Нырнуть, что ли?"

#. ja: 健やかに育ってほしいものだ
#. de: Sie sollen wachsen und gedeihen. Doch womit nähren wir sie?
#. fr: Nous devons les élever avec le plus grand soin...
msgctxt "Balloon:7046:0:1"
msgid "We must nourish them further. But how..."
msgstr "Надо кормить их дальше. Но чем?.."

#. ja: 肉体を持つ生物を<br>こうも愛らしく思うとは…
#. de: Ich hörte, die Kinder organischer Wesen mögen eine Substanz namens <i>Pudding</i><nbsp>...
#. fr: Leur enveloppe corporelle est tellement adorable...
msgctxt "Balloon:7047:0:1"
msgid "Relax. They are already pleasingly gelatinous."
msgstr "Не волнуйся. Они и так приятно желеобразные."

#. ja: 我々の存在とは…
#. de: Definiere>> Sinn des Lebens \<ratter> ...
#. fr: Qu'est-ce que l'existence...<nbsp>? Pshhh...
msgctxt "Balloon:7048:0:1"
msgid "This unit is but a tiny speck among the cosmos..."
msgstr "Эта единица — лишь крошечная пылинка в космосе..."

#. ja: あの大樹はいったい？
#. de: Erbitte Erklärung: Wozu dient dieser Baum?
#. fr: Bip... Quel arbre gigantesque...
msgctxt "Balloon:7049:0:1"
msgid "Flora identification requested."
msgstr "Запрашиваю идентификацию флоры."

#. ja: 生命と宇宙を表す木だ<br>個は葉であり、幹と繋がる
#. de: Er repräsentiert das Leben. Sein Stamm den Kosmos, seine Blätter unsere Seele<nbsp>...
#. fr: Il symbolise la vie et l'univers... Les feuilles sont les individus, unis par le tronc, l'espace...
msgctxt "Balloon:7050:0:1"
msgid "This tree represents the world─us, its leaves."
msgstr "Это дерево олицетворяет мир — нас, его листья."

#. ja: ガガ…我々も同じように…？
#. de: \<ratter> ... Das Leben ist ein <i>Baum</i>?
#. fr: Comme nous... Si différents, mais si semblables... Pshhh...
msgctxt "Balloon:7051:0:1"
msgid "\\<whirr> ...Interconnected units. As are we!"
msgstr ""

#. ja: やんちゃな子だ！
#. de: Wirst du wohl herunterkommen!
#. fr: Petite coquine<nbsp>!
msgctxt "Balloon:7052:0:1"
msgid "Come back here!"
msgstr "А ну вернись!"

#. ja: ラーラーの祝福なくとも…
#. de: Kann ein Leben ohne Ra-Las Segen möglich sein?
#. fr: Peut-être que même sans la bénédiction de Ra-la...
msgctxt "Balloon:7053:0:1"
msgid "Perhaps Ra-la's is not the only blessing."
msgstr "Может, благословение Ра-Ла не единственное."

#. ja: 効率化を考慮してだな…
#. de: Effizienter ist diese Methode allemal.
#. fr: On ne peut pas sacrifier la productivité...
msgctxt "Balloon:7054:0:1"
msgid "Still accounting for our differences, of course..."
msgstr "Разумеется, учитывая наши различия..."

#. ja: まぁ、悪ィ案じゃねぇな
#. de: Wenn du meinst<nbsp>...
#. fr: Oui, tu as raison...
msgctxt "Balloon:7055:0:1"
msgid "Not a bad idea."
msgstr "Неплохая мысль."

#. ja: やり方を合わせられっかな…
#. de: Effizient wäre es, wenn wir uns mal einigen könnten.
#. fr: Essayons de trouver un juste milieu.
msgctxt "Balloon:7056:0:1"
msgid "I suppose we can try it your way."
msgstr "Ну, давай попробуем по-твоему."

#. ja: 機体表面温度の<br>安定を確認…
#. de: Oberflächen-Temperatur wird reguliert<nbsp>...
#. fr: Bip... Température extérieure stabilisée...
msgctxt "Balloon:7057:0:1"
msgid "Surface temperature: pleasing."
msgstr "Температура поверхности: приятная."

#. ja: このようにでしょうか？
#. de: Imitiere Tanzschritt<nbsp>... \<zzzt>
#. fr: Intéressant... Continuons notre analyse. Pshhh...
msgctxt "Balloon:7058:0:1"
msgid "Instructive! \\<beep> \\<beep> \\<beep> \\<BWAAAAAA>"
msgstr ""

#. ja: 捨て去った感情に<br>揺らぎが生まれる…
#. de: Es ist wie eine Wiedergeburt verlorener Gefühle<nbsp>...
#. fr: J'avais oublié la sensation que procurent les émotions...
msgctxt "Balloon:7059:0:1"
msgid "Pardon me─it appears I am experiencing an emotion..."
msgstr "Прошу прощения... Кажется, я испытываю эмоцию..."

#. ja: この心地が<br>安らぎというものでしょうか？
#. de: Interpretiere>> Die maskierte Lebensform ist <i>glücklich</i>. Korrekt?
#. fr: Bip... Est-ce ce que les humains appellent... la “tran<shy>quil<shy>li<shy>té”<nbsp>?
msgctxt "Balloon:7060:0:1"
msgid "Relaxation...achieved?"
msgstr "Расслабление... достигнуто?"

#. ja: 森林浴の概念を<br>インプットしましょう
#. de: Berichten zufolge bewirkt das Betrachten von Bäumen <i>Glück</i> \<biep>
#. fr: Ajout du terme “sylvothérapie” à la base de données... Pshhh...
msgctxt "Balloon:7061:0:1"
msgid "Downloading “ambling” add-on..."
msgstr "Загружаю дополнение «прогулка»..."

#. ja: おう、わかったぜ
#. de: Alles klar, mach ich!
#. fr: C'est comme si c'était fait<nbsp>!
msgctxt "Balloon:7062:0:1"
msgid "Share and share alike, I suppose."
msgstr "Ну, делиться так делиться."

#. ja: はぁ？<br>譲り合ってんじゃねぇよ…
#. de: Woher diese plötzliche Großzügigkeit?
#. fr: Hein<nbsp>!? Vous allez finir par me rendre chèvre<nbsp>!
msgctxt "Balloon:7063:0:1"
msgid "...Please just take it."
msgstr "...Да возьми ты уже."

#. ja: 幼体の元気な姿とは<br>素晴らしい
#. de: Was für ein heiteres junges Geschöpf<nbsp>...
#. fr: Ah, l'insouciance de la jeunesse...
msgctxt "Balloon:7064:0:1"
msgid "The boldness of youth... This is well."
msgstr "Юность так смела... Прекрасно."

#. ja: 私たちが育てた<br>エリュシオンの食材だぞ
#. de: Hau rein! Die Zutaten sind frisch vom Feld!
#. fr: Des produits élyséens cultivés de mes propres mains<nbsp>!
msgctxt "Balloon:7065:0:1"
msgid "Grew these with my own two hands!"
msgstr "Вырастил собственными руками!"

#. ja: 待ってってば～！
#. de: He, hiergeblieben!
#. fr: Attends-moi<nbsp>!
msgctxt "Balloon:7066:0:1"
msgid "Just a little lick!"
msgstr "Дай хоть лизнуть!"

#. ja: 孵化後の生体パルスは<br>安定しています
#. de: Alle Vitalparameter sind stabil. \<biep>
#. fr: Bip... Signes vitaux stables... Je prévois une croissance optimale.
msgctxt "Balloon:7067:0:1"
msgid "Vital signs optimal. Hatchlings will grow large and robust."
msgstr "Жизненные показатели в норме. Детёныши вырастут большими и крепкими."

#. ja: ムニャムニャ…<br>ここはどこっぺな？
#. de: \<spotz> Nanu?<br>Wo bin ich hier gelandet?
#. fr: (baille) Oyoyo<nbsp>!? C'est quoi, cet endroit<nbsp>?
msgctxt "Balloon:7068:0:1"
msgid "\\<yawn> Another beautiful day in─ Oh dear."
msgstr ""

#. ja: ハッ…まさかここは<br>地底ナマズオの～…！？
#. de: Aber wozu die komischen Panzer?
#. fr: ... Le monde des profondeurs<nbsp>?
msgctxt "Balloon:7069:0:1"
msgid "\\<gasp> It's the underworld, yes, yes!"
msgstr ""

#. ja: そんなわけないっぺな…<br>きっと夢っぺよ…
#. de: Bestimmt nur ein Traum! Schnell weg!
#. fr: Impossible, c'est sûrement un rêve...
msgctxt "Balloon:7070:0:1"
msgid "No, no, it must be a dream. Back to my jar..."
msgstr "Нет, нет, это, должно быть, сон. Пора обратно в кувшин..."

#. ja: あいつらは<br>何者っぺよ！？
#. de: Uah! Höhlen-Namazuo?! \<glubsch>
#. fr: Ouah<nbsp>! Qui sont ces créatures<nbsp>!?
msgctxt "Balloon:7071:0:1"
msgid "Underworld catfish! Help, heeelp!"
msgstr "Подземные сомы! На помощь, помо-о-огите!"

#. ja: お腹すいたぁ～！
#. de: Ich hab Hunger! Hmü!
#. fr: On a faim<nbsp>! On a faim<nbsp>!
msgctxt "Balloon:7072:0:1"
msgid "Soup! Soup! Soup!"
msgstr "Суп! Суп! Суп!"

#. ja: も～っと食べたい！
#. de: Gibt's davon noch mehr?
#. fr: Triple ration pour moi<nbsp>!
msgctxt "Balloon:7073:0:1"
msgid "Waiter! Another, please!"
msgstr "Официант! Мне ещё, пожалуйста!"

#. ja: ミっミっ♪
#. de: Mi-Miii～♪
#. fr: Mimimi<nbsp>!♪
msgctxt "Balloon:7074:0:1"
msgid "Mi-miii!"
msgstr "Ми-ми!"

#. ja: ミミ～♪
#. de: Mihihi～
#. fr: Mimiii<nbsp>!♪
msgctxt "Balloon:7075:0:1"
msgid "Mi mi mi mi...\\<screech>♪"
msgstr ""

#. ja: ミっ！
#. de: Mi?
#. fr: Mi<nbsp>! (bloup)
msgctxt "Balloon:7076:0:1"
msgid "\\<burble>"
msgstr ""

#. ja: 疲れましたケロ…
#. de: Ich kann keinen Hüpfer mehr tun, quaaak<nbsp>...
#. fr: J'ai coâmme un coup de fatigue...
msgctxt "Balloon:7077:0:1"
msgid "I can scarcely take another hop, ribbit..."
msgstr "Еле прыгаю, ква..."

#. ja: 興味深い蔵書が多そうね
#. de: Ach, hätten wir doch nur Zeit zum Lesen!
#. fr: Si seulement j'avais le temps de jeter un œil à tous ces rayons<nbsp>!
msgctxt "Balloon:7078:0:1"
msgid "Oh, for the time to pore over this collection..."
msgstr "Эх, найти бы время изучить всю эту коллекцию..."

#. ja: さて、マトーヤ様の<br>論文はどこに…
#. de: Also, wo sind Matoyas Schriften?
#. fr: Autant chercher une aiguille dans une botte de foin...
msgctxt "Balloon:7079:0:1"
msgid "Now then, where might Master Matoya's tome be?"
msgstr "Так, где же может быть труд госпожи Матойи?"

#. ja: このエーテルの濃さ…<br>私の眼には眩しすぎるわ
#. de: Der Äther ist so dicht, ich fühle mich beinahe geblendet.
#. fr: L'éther est tellement dense ici... C'est proprement incroyable<nbsp>!
msgctxt "Balloon:7080:0:1"
msgid "The aether here is almost too much for my eyes."
msgstr "Эфира здесь столько, что глаза режет."

#. ja: ここが最も<br>「星の海」に近い場所…
#. de: Wir sind dem Sternengrund so nah<nbsp>...
#. fr: Nous voilà au plus près de la mer des étoiles...
msgctxt "Balloon:7081:0:1"
msgid "So this is the closest point to the aetherial sea..."
msgstr "Значит, это ближайшее место к морю эфира..."

#. ja: ミンフィリア…！
#. de: Minfilia!
#. fr: Minfilia...<nbsp>!
msgctxt "Balloon:7082:0:1"
msgid "We've come for you, Minfilia..."
msgstr "Мы пришли за тобой, Минфилия..."

#. ja: なんとも手荒い試練だったな
#. de: Dieser Kampf wird mir lange im Gedächtnis bleiben.
#. fr: Voilà une épreuve que je n'oublierai pas de sitôt...
msgctxt "Balloon:7083:0:1"
msgid "I shan't soon forget this trial."
msgstr "Не скоро забуду это испытание."

#. ja: 全力は尽くしたつもりだが…
#. de: Ich habe alles getan, was ich kann<nbsp>... Doch war es auch genug?
#. fr: J'ai fait tout ce que j'ai pu... Était-ce suffisant<nbsp>?
msgctxt "Balloon:7084:0:1"
msgid "I gave my all. I pray it was enough..."
msgstr "Я выложился на полную. Надеюсь, этого хватило..."

#. ja: イクサル族も必死だったね…
#. de: Die Ixal haben wahrlich bis aufs Blut gekämpft.
#. fr: Les Ixali se sont battus jusqu'au bout...
msgctxt "Balloon:7085:0:1"
msgid "The Ixal fought to the very last..."
msgstr "Иксали сражались до последнего..."

#. ja: ふふっ！<br>お話ししましょう！
#. de: Hihi! Reden, lass uns reden!
#. fr: Hihi<nbsp>! Allez, parle-nous<nbsp>!
msgctxt "Balloon:7086:0:1"
msgid "Tee hee hee! Go on, go on!"
msgstr "Хи-хи-хи! Ну же, ну же!"

#. ja: 困ってる姿も<br>かわいい！
#. de: Aah, so schüchtern und niedlich!
#. fr: Il est tout gêné<nbsp>! Trop mignon<nbsp>!
msgctxt "Balloon:7087:0:1"
msgid "Watch it fidget! How adorable!"
msgstr "Посмотрите, как он ёрзает! Прелесть!"

#. ja: ねえねえ！<br>お花は好き？
#. de: Magst du Blumen? Sag schon!
#. fr: Tu aimes les fleurs<nbsp>?
msgctxt "Balloon:7088:0:1"
msgid "Tell me, do you like flowers?"
msgstr "Скажи, ты любишь цветы?"

#. ja: クエ～～～
#. de: Kweh, kweh!
#. fr: Kwéééé<nbsp>!
msgctxt "Balloon:7089:0:1"
msgid "Kweh, kweh!"
msgstr "Квееее! Кве-кве!"

#. ja: 辰、強ぇのか
#. de: Wie stark sind denn diese Drachen?
#. fr: C'est fort, un dragon d'Orient<nbsp>?
msgctxt "Balloon:7090:0:1"
msgid "Just how powerful are these ryu...?"
msgstr "И насколько сильны эти рю?.."

#. ja: わーい！わーい！
#. de: Wuhuuu!
#. fr: Youpi<nbsp>! Youpi<nbsp>!
msgctxt "Balloon:7091:0:1"
msgid "Woooooo!"
msgstr "Ура! Ура!"

#. ja: イェーイ！！
#. de: Los, Hip Hopplers!
#. fr: Ouaiiiis<nbsp>!
msgctxt "Balloon:7092:0:1"
msgid "Yea! Yea, I say!"
msgstr "Йе-е-е! Вот так!"

#. ja: こりゃあ美味しいや！
#. de: Mmm, lecker! \<mümmel>
#. fr: Mais c'est bon, ça<nbsp>!
msgctxt "Balloon:7093:0:1"
msgid "Mmmmmmuffin..."
msgstr "Ммммаффин..."

#. ja: これもいいなぁ！
#. de: Das kommt auf meine Traumliste<nbsp>...
#. fr: J'ajoute ça à ma liste<nbsp>!
msgctxt "Balloon:7094:0:1"
msgid "Let's add it to my list..."
msgstr "Запишу и это в список..."

#. ja: ノリノリだなぁ…！
#. de: Das sieht auch lustig aus!
#. fr: Quelle ambiance<nbsp>!
msgctxt "Balloon:7095:0:1"
msgid "This looks fun!"
msgstr "Похоже, весело!"

#. ja: おいしそう…！
#. de: So viel buntes Essen!
#. fr: J'en grignoterais bien un bout...
msgctxt "Balloon:7096:0:1"
msgid "This looks tasty!"
msgstr "Как вкусно выглядит!"

#. ja: かっこいいなぁ…！
#. de: Woaaah<nbsp>...!
#. fr: C'est la classe<nbsp>!
msgctxt "Balloon:7097:0:1"
msgid "How exciting!"
msgstr "Вот это да!"

#. ja: かわいいなぁ…！
#. de: Oh, wie hübsch!
#. fr: Trop mignon<nbsp>!
msgctxt "Balloon:7098:0:1"
msgid "How lovely!"
msgstr "Какая прелесть!"

#. ja: 準備できてるかなぁ～？
#. de: Haben wir alles?
#. fr: Tout le monde est prêt<nbsp>?
msgctxt "Balloon:7099:0:1"
msgid "Needs more carrots..."
msgstr "Морковки маловато..."

#. ja: 食材は<br>これでよしっと…！
#. de: Die reichen für heute.
#. fr: Et si je rajoutais... cet ingrédient<nbsp>!
msgctxt "Balloon:7100:0:1"
msgid "At least we have plenty in stock!"
msgstr "Зато запасов у нас хоть отбавляй!"

#. ja: あれれ、一切れ減ってる…？
#. de: Fehlt da ein Stück, oder gehört das so?
#. fr: Il manque une part, non<nbsp>?
msgctxt "Balloon:7101:0:1"
msgid "I could swear this was a whole cake last I checked..."
msgstr "Клянусь, когда я проверяла, торт был целым..."

#. ja: うんうん、いい感じ！
#. de: Mmm, wie das duftet!
#. fr: Tout se déroule comme prévu<nbsp>!
msgctxt "Balloon:7102:0:1"
msgid "Baked to perfection!"
msgstr "Пропеклось идеально!"

#. ja: うふふ、かわいい～！
#. de: Die sind aber süß geworden!
#. fr: Le résultat est trop mignon<nbsp>!
msgctxt "Balloon:7103:0:1"
msgid "How sweet!"
msgstr "Какая прелесть!"

#. ja: もう少しで完成かなっ！
#. de: Noch ein bisschen weiterbrutzeln<nbsp>...
#. fr: Et maintenant, la cerise sur la carotte...
msgctxt "Balloon:7104:0:1"
msgid "Not quite golden brown yet..."
msgstr "Пока ещё не подрумянилось..."

#. ja: 乗ってみたいなぁ…
#. de: Ich will damit fahren!
#. fr: J'aimerais bien faire un tour...
msgctxt "Balloon:7106:0:1"
msgid "Am I allowed to play on this? Let's go with “yes”..."
msgstr "А мне можно на этом покататься? Ладно, скажу себе «можно»..."

#. ja: お手伝いは<br>どこにいったんだろ？
#. de: Hat jemand meinen Gehilfen gesehen?
#. fr: Où est passé mon assistant<nbsp>?
msgctxt "Balloon:7107:0:1"
msgid "Where are they?"
msgstr "Куда они подевались?"

#. ja: うん、在庫は大丈夫そう！
#. de: Gut, alles komplett!
#. fr: On a tout ce qu'il faut ici<nbsp>!
msgctxt "Balloon:7108:0:1"
msgid "We're fully stocked!"
msgstr "Запасов хватит на всех!"

#. ja: じゃ～～ん！！
#. de: Tadaaa!
#. fr: Et voilà<nbsp>!!
msgctxt "Balloon:7109:0:1"
msgid "I present...this!"
msgstr "Та-дам!!"

#. ja: こ、これはいったい…！？
#. de: Oh, das äh ... sieht toll aus!
#. fr: C-c'est quoi ce bidule<nbsp>!?
msgctxt "Balloon:7110:0:1"
msgid "It's very...this."
msgstr "Это... что такое?.."

#. ja: タ、タマゴから<br>ヘビが飛び出して…！
#. de: S-Schlange! Da ist eine Schlange zwischen den Eiern!
#. fr: U-un serpent a bondi de mon œuf<nbsp>!
msgctxt "Balloon:7111:0:1"
msgid "S-Snake! There's a snake amongst the eggs!"
msgstr "З-змея! Среди яиц змея!"

#. ja: アルコンエッグを<br>シルフ族に盗まれるなんて…
#. de: Mein schönes Saliah-Ei<nbsp>... Eine Sylphe hat es gestohlen!
#. fr: Oh non... Un Sylphe a volé mon Prrrœuf...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7112:0:1"
msgid "My precious Archon egg...<br>They just...took it..."
msgstr "Моё драгоценное яйцо архонта...<br>Они просто... утащили его..."

#. ja: シルフ族のせいで<br>贈り物が川に落ちちゃった…
#. de: Mein Geschenk! Es ist ins Wasser gefallen! Diese verdammten Sylphen!
#. fr: Le Prœuf que je comptais offrir est tombé dans la rivière à cause des Sylphes...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7113:0:1"
msgid "Agh, my gift! Sunk to the bottom...<br>Those blasted sylphs!"
msgstr "Ах, мой подарок! Пошёл ко дну...<br>Будь прокляты эти сильфы!"

#. ja: シルフ族め<br>いたずらで腰が抜けたぞ…
#. de: Diese Streiche müssen endlich ein Ende nehmen<nbsp>...
#. fr: Les farces des Sylphes m'ont donné une de ces frousses<nbsp>!
msgctxt "Balloon:7114:0:1"
msgid "N-No more pranks... Cease this madness, I beg of you..."
msgstr "Н-никаких больше проделок... Прошу, прекратите это безумие..."

#. ja: あんたのおかげで<br>スキャンに専念できたよ
#. de: Dank dir konnte ich mich auf das Sammeln der Daten konzentrieren.
#. fr: J'ai pu me concentrrrer sur la collecte de données pendant le combat.
msgctxt "Balloon:7115:0:1"
msgid "Thanks to you, I was able to focus on the data collection."
msgstr "Благодаря тебе я смогла сосредоточиться на сборе данных."

#. ja: ありがとうな！
#. de: Ich denke, dieser Streifzug war ein voller Erfolg!
#. fr: Merrrci, <split " " 1><string $gs1></split><nbsp>!
msgctxt "Balloon:7116:0:1"
msgid "I believe we may declare this foray a success!"
msgstr "Думаю, теперь можно с уверенностью сказать: вылазка удалась!"

#. ja: 疲れたわ<br>冷たい飲み物をもらえる？
#. de: Puh, ich kann nicht mehr. Kann ich was Kaltes zu trinken haben?
#. fr: Je me sens un peu patraque. Auriez-vous des rafraichissements à me proposer<nbsp>?
msgctxt "Balloon:7119:0:1"
msgid "Gods, I'm exhausted. What's a woman have to do to get a bloody drink?"
msgstr "Боги, я вымоталась. Да где тут достать хоть глоток?!"

#. ja: これはロウェナ様<br>ようこそいらっしゃいました
#. de: Ah, werte Frau Rowena! Ich freue mich, Euch hier begrüßen zu dürfen.
#. fr: Madame Rowena, c'est un honneur de vous recevoir parmi nous.
msgctxt "Balloon:7120:0:1"
msgid "Ah, Madam Rowena. A pleasure, as always."
msgstr "Ах, госпожа Ровена. Как всегда, рад вас видеть."

#. ja: カワイコちゃん<br>ワシと遊んでくれんかのう？
#. de: Hallo, meine Süße! Willst du mich nicht ein bisschen rumführen?
#. fr: Quelle beauté<nbsp>! Vous marinez chez vos harengs<nbsp>?
msgctxt "Balloon:7121:0:1"
msgid "Why, hello there. Won't you show me around your fine...establishment?"
msgstr "Ну здравствуй, красотка. Не покажешь старику своё... заведение?"

#. ja: あら、あの方…<br>なかなかの筋肉ですわぁ…
#. de: Oh wow<nbsp>... So viele Muskeln<nbsp>...
#. fr: C-cet homme là-bas est drôlement musculeux...
msgctxt "Balloon:7122:0:1"
msgid "Those muscles... They're like tree trunks..."
msgstr "Какие мышцы... Прямо стволы деревьев..."

#. ja: フーッ、フーッ…<br>同志のお膝元に来たぞ…
#. de: Oooh! Endlich, ein Gleichgesinnter<nbsp>...
#. fr: Huh huh, voilà une personnalité qui partage mon amour du gluant...
msgctxt "Balloon:7123:0:1"
msgid "What have we here? A craftsman after my own heart..."
msgstr "Вот это да! Родственная душа, мастер на все руки..."

#. ja: 木材本来の姿を活かしつつ<br>光源を彩る意匠に落とし込む…
#. de: Hmm, sie nutzen das Holz in seiner Ursprungsform zusammen mit den Lichtern, um diese Farbmuster zu erzeugen<nbsp>...
#. fr: Intéressant comme la lumière sublime les matériaux naturels...
msgctxt "Balloon:7124:0:1"
msgid "Fascinating... A complex interplay between light and the wood's natural form. "
msgstr "Завораживает... Свет так интересно играет с природной фактурой дерева."

#. ja: モグたちを<br>キャッチするクポ！？
#. de: D-Da sind nicht wirklich Mogrys eingesperrt, oder, kupo!?
#. fr: Un Mog en guise de grappin<nbsp>!? Mais c'est de la barbarie, kupo<nbsp>!
msgctxt "Balloon:7125:0:1"
msgid "Can you catch us, kupo?"
msgstr "А ты поймаешь нас, купо?"

#. ja: 酒でも飲まなきゃ<br>やってらンねえぜ…
#. de: Ein Glück kann man hier trinken, sonst würd' ich's nicht aushalten!
#. fr: Faut que j'picole un coup, sinon ça va pas le faire...
msgctxt "Balloon:7126:0:1"
msgid "So long as there's drink, I can manage..."
msgstr "Пока есть выпивка, я ещё держусь..."

#. ja: 一攫千金<br>これもまたラブ＆ドリーム…
#. de: Auf einen Schlag reich! Ein Gedanke voller Liebe und Träume! Genau, was ich suche!
#. fr: Ah, la fortune... Qui n'en a jamais rêvé<nbsp>?
msgctxt "Balloon:7127:0:1"
msgid "One moment poor as a pauper, the next rich as a king! Ah, what a magical place!"
msgstr "Ещё миг назад нищий, а теперь богач! Ах, какое волшебное место!"

#. ja: 景品のリストを載せたら<br>読者の興味を引けるかな…
#. de: Ich frag mich, ob es Leser anziehen würde, eine Liste der Preise in den Artikel zu packen<nbsp>...
#. fr: Peut-être que la liste des lots en jeu intéresserait nos lecteurs...<nbsp>?
msgctxt "Balloon:7128:0:1"
msgid "My readers would be very interested to know what items are on offer."
msgstr "Читателям наверняка будет интересно узнать, какие тут разыгрывают призы."

#. ja: お母さんに会えて<br>よかったな！
#. de: Ein Glück haben wir deine Mama gefunden, hm?
#. fr: Ta maman est là, regarrrde<nbsp>!
msgctxt "Balloon:7129:0:1"
msgid "It's a good thing we found your mother, isn't it?"
msgstr "Хорошо, что мы нашли твою маму, правда?"

#. ja: おにいちゃん<br>ありがとう！！
#. de: Vielen Dank, Herr Nhagi!
#. fr: Merci Monsieur, vous êtes un saint<nbsp>!
msgctxt "Balloon:7130:0:1"
msgid "Thank you, mister! Thank you!"
msgstr "Спасибо, дяденька! Спасибо!"

#. ja: こちらの方が捜索を<br>手伝ってくださったのです
#. de: Dieser junge Herr hat uns bei der Suche geholfen.
#. fr: Cette personne nous a aidés à retrouver votre enfant.
msgctxt "Balloon:7131:0:1"
msgid "This young lad was a great help in the search."
msgstr "Этот юноша очень помог нам в поисках."

#. ja: 常夏の装い…<br>新商品の参考にするのでっす！
#. de: Ein Gewand in den Farben des Ewigen Sommers, das wäre wirklich mal eine originelle Idee!
#. fr: Une tenue aux couleurs de l'Éternel été, ce serait vraiment pas mal<nbsp>!
msgctxt "Balloon:7132:0:1"
msgid "The colors of summer should lend themselves splendidly to new garments."
msgstr "Летние цвета отлично подойдут для новых нарядов."

#. ja: 私たち、大繁盛商店の<br>視察で訪問しているんです！
#. de: Wir sind hier, um uns Inspirationen für Tatarus Wohlstandsmanufaktur zu holen!
#. fr: Nous venons chercher de l'inspiration pour la Tarufacture<nbsp>!
msgctxt "Balloon:7133:0:1"
msgid "We're here to glean inspiration for Tataru Taru's Boutique!"
msgstr "Мы приехали за вдохновением для лавки Татары Тару!"

#. ja: サベネアの海とも違う色…<br>素敵なところね！
#. de: Die Farbe des Meeres ist ganz anders als in Thavnair<nbsp>... Aber trotzdem ein sehr schöner Ort!
#. fr: La couleur de la mer est différente mais tout aussi belle qu'à Thavnair<nbsp>!
msgctxt "Balloon:7134:0:1"
msgid "The sea here looks so different than in Thavnair... I could stare at it forever!"
msgstr "Какое здесь море — совсем не такое, как в Тавнаире... Могла бы смотреть на него вечно!"

#. ja: クロに怪我がなくて<br>本当によかった…
#. de: Zum Glück scheint Khloe nicht verletzt zu sein!
#. fr: Khloe a l'air en pleine forrrme, tant mieux<nbsp>!
msgctxt "Balloon:7135:0:1"
msgid "Oh, thank the gods Khloe is safe..."
msgstr "Слава богам, с Хлои всё хорошо..."

#. ja: ケビちゃんきいて！<br>すっごくかっこよかったの！
#. de: T'kebbe, ich sag's dir, dieser Recke des Reigens<nbsp>... Der hat schon eine echt gute Figur gemacht!
#. fr: Le Héros de la Morrrt en jette<nbsp>! Puisque je te le dis, T'kebbe<nbsp>!
msgctxt "Balloon:7136:0:1"
msgid "Of course not, T'kebbe! The savior was amazing!"
msgstr "Да ну, Т'кеббе! Спаситель был просто потрясающий!"

#. ja: クロちゃん<br>怖くなかった…？
#. de: Das muss dir bestimmt einen ordentlichen Schreck eingejagt haben, oder<nbsp>...?
#. fr: Tu as dû avoir vachement peurrr, quand même...
msgctxt "Balloon:7137:0:1"
msgid "You weren't scared, Khloe?"
msgstr "Ты не испугалась, Хлои?"

#. ja: 親分、いつになく<br>やる気出してるじゃない
#. de: Unser Gildenmeister sieht motivierter aus denn je zuvor!
#. fr: Maître Wawalago est toujours aussi motivé<nbsp>!
msgctxt "Balloon:7138:0:1"
msgid "We'll catch our fortunes soon enough, I can feel it!"
msgstr "Скоро разбогатеем, вот увидишь! Чую я!"

#. ja: 珍しいお魚さんがいると<br>聞いたんぢやがのう？
#. de: Ich habe gehört, hier in der Gegend soll es seltene Fische geben.
#. fr: Il paraît qu'il y a des poissons rares dans le coin...
msgctxt "Balloon:7139:0:1"
msgid "I heard tell there's fish around here that'll fetch a whole sack of gil."
msgstr "Слыхал, тут водится рыба, за которую целый мешок гил дадут."

#. ja: クエクエッ！
#. de: Kweh, kweh!
#. fr: Kwékwé<nbsp>!
msgctxt "Balloon:7140:0:1"
msgid "Kweh! Kweh!"
msgstr "Кве! Кве!"

#. ja: ぐぬぬぬ、なにをー！
#. de: Gmpf, was zum<nbsp>...?!
#. fr: Aïe<nbsp>! Ouille<nbsp>! Argh<nbsp>!
msgctxt "Balloon:7142:0:1"
msgid "Ungh... What the─!?"
msgstr "Ух... Да что за─!?"

#. ja: エマネラン様<br>もう少しです、はい
#. de: Nur noch eine winzige Anstrengung, Herr Emmanellain!
#. fr: Encore un tout petit effort, Sire Emmanellain<nbsp>!
msgctxt "Balloon:7143:0:1"
msgid "You almost have it, my lord!"
msgstr "Ещё чуть-чуть, милорд!"

#. ja: ボンクラ貴族にゃ<br>きつかったかぁ？
#. de: Na, du Schnösel? Kommst du schon ins Schwitzen?
#. fr: Eh ben alors, le poudré<nbsp>? On a du mal à grimper<nbsp>?
msgctxt "Balloon:7144:0:1"
msgid "Guess your blue blood's not worth much here, eh?"
msgstr "Ну что, голубая кровь? Тяжеловато тут, а?"

#. ja: 偶然を、偶然を装えば…
#. de: Wenn man es einfach wie einen Zufall aussehen ließe<nbsp>...
#. fr: Allez, juste un petit coup de pouce du hasard, quoi...
msgctxt "Balloon:7145:0:1"
msgid "No one else saw that... Aye, no one else..."
msgstr "Никто ведь не видел... Да, никто..."

#. ja: 何故か寒気が…<br>氷菓を食べすぎましたかね
#. de: Oh, warum fröstelt es mich plötzlich so? Vielleicht hatte ich ein kleines bisschen zu viel Schabeeis<nbsp>...
#. fr: Étrange, ce coup de froid soudain... Trop de sorbet, peut-être<nbsp>?
msgctxt "Balloon:7146:0:1"
msgid "I'm so full of desserts... And so cold..."
msgstr "Объелась сладкого... И так холодно..."

#. ja: お菓子づくりの達人が<br>ここに来てるらしいんです
#. de: Ich habe gehört, dass es hier einen begnadeten Süßspeisen-Virtuosen geben soll!
#. fr: On m'a dit qu'un pâtissier de grand talent était venu bronzer ici...
msgctxt "Balloon:7147:0:1"
msgid "I hear that a master of making confectionaries has come to enjoy the festivities."
msgstr "Слышал, сюда приехал мастер-кондитер — полакомиться на празднике."

#. ja: みんなでピョンピョンたのしそう！
#. de: An den Stränden von Ætheris ist offenbar immer Spaß angesagt!
#. fr: C'est vraiment l'éclate totale sur les plages d'Ætherys<nbsp>!
msgctxt "Balloon:7148:0:1"
msgid "Everyone here's having so much fun!"
msgstr "Как же всем весело!"

#. ja: こういうの<br>月にも作れないかなあ
#. de: Wenn wir so was nur auch auf dem Mond hätten<nbsp>...
#. fr: Si seulement on pouvait avoir les mêmes sur la lune...
msgctxt "Balloon:7149:0:1"
msgid "If only the moon had something like this..."
msgstr "Вот бы и на Луне такое было..."

#. ja: 魔城で使う爆弾が足りない？<br>はやく用意しないと…
#. de: Was, wir haben nicht genug Bomben für den Parkour? Dann müssen wir schleunigst welche besorgen<nbsp>...
#. fr: On risque de se retrouver à court de bombes très bientôt...
msgctxt "Balloon:7150:0:1"
msgid "That's quite a few bombs. We may soon need a resupply..."
msgstr "Бомб уже столько... Скоро придётся пополнить запасы..."

#. ja: ククク…おかげーで<br>ボムちゃん、たくさん置けたーよ
#. de: Hihihi, keine Sorge! Ich viele, viele versteckt habe!
#. fr: Hihihi... Pas d'inquiétude, j'en ai ramené une tonz, oh ouiii, une tonz<nbsp>!
msgctxt "Balloon:7151:0:1"
msgid "Hehehe... Worry not. I have brought enough for many, many booms─blasts, bangs, booms!"
msgstr "Хе-хе-хе... Не волнуйся. Я принёс много-много бум-бум... взрывов, хлопков и ба-бахов!"

#. ja: うぐぐ、本気で挑めば<br>これくらい…！
#. de: Ugh<nbsp>... Ich muss mich zusammenreißen!
#. fr: Urrrgh... Il faut que je me donne plus à fond<nbsp>!
msgctxt "Balloon:7152:0:1"
msgid "Ungh... I can't do any better than this...?"
msgstr "У-ух... Неужели я не могу лучше?.."

#. ja: お兄ちゃん、がんばれー！
#. de: Ich glaub an dich, Bruderherz!
#. fr: Courrrage, grand frère<nbsp>!
msgctxt "Balloon:7153:0:1"
msgid "You can do it! Go, go!"
msgstr "Давай, братик! Ты сможешь!"

#. ja: いけますよ、兄貴！
#. de: Du schaffst das, Kollege!
#. fr: C'est dans la poche, Patron<nbsp>!
msgctxt "Balloon:7154:0:1"
msgid "I believe in you!"
msgstr "Верю в тебя, братан!"

#. ja: おいし～い！
#. de: Mehr davon!
#. fr: Délicieux<nbsp>!
msgctxt "Balloon:7155:0:1"
msgid "Yum yum!"
msgstr "Вкуснотища!"

#. ja: わたしは…迷わないよ
#. de: Ich muss mich konzentrieren!
#. fr: Pas le moment de se déconcentrer<nbsp>!
msgctxt "Balloon:7156:0:1"
msgid "I won't doubt myself any longer!"
msgstr "Я больше... не буду сомневаться в себе!"

#. ja: 心配ないッ！
#. de: Keine Sorge!
#. fr: Vous faites pas de bile<nbsp>!
msgctxt "Balloon:7157:0:1"
msgid "Don't worry!"
msgstr "Не волнуйтесь!"

#. ja: 水分補給はッ！
#. de: Wir haben alle ausreichend getrunken!
#. fr: On a tous bu trois bouteilles d'eau chacun<nbsp>!
msgctxt "Balloon:7158:0:1"
msgid "When it comes to water..."
msgstr "А воды-то..."

#. ja: 万全だッ！
#. de: Literweise!
#. fr: J'ai envie d'aller aux gogues...
msgctxt "Balloon:7159:0:1"
msgid "...We're filled to the brim!"
msgstr "...полным-полно!"

#. ja: アタシはキツイかな～
#. de: Das sind zu viele Emotionen auf einmal für mich!
#. fr: C'est trop d'émotions d'un coup pour moi<nbsp>!
msgctxt "Balloon:7160:0:1"
msgid "This might be beyond me..."
msgstr "Мне, пожалуй, не по силам..."

#. ja: ひとつひとつ<br>確実に…！
#. de: Immer eins nach dem anderen!
#. fr: Un pied devant l'autre, comme on dit chez nous<nbsp>!
msgctxt "Balloon:7161:0:1"
msgid "One step at a time..."
msgstr "Шаг за шагом..."

#. ja: 爆弾いっぱい！<br>ひえぇ～っ
#. de: Uaaah, das knallt ja ordentlich!
#. fr: Ça pète de partout, dites donc<nbsp>!
msgctxt "Balloon:7162:0:1"
msgid "So many bombs! Eeek!"
msgstr "Бомб столько! Ой-ёй!"

#. ja: 軽い軽い～っ♪
#. de: Schön vorsichtig!
#. fr: Attention à ne pas dérrraper<nbsp>!
msgctxt "Balloon:7163:0:1"
msgid "Easy does it..."
msgstr "Потихоньку..."

#. ja: こちらのメモリアルスペースにも<br>ぜひ足を運んでみてください！
#. de: Unsere Gedenkstätte sollte man auch unbedingt mal gesehen haben!
#. fr: Si vous voulez voir le mémorial, laissez-vous glisser le long de ce toboggan<nbsp>!
msgctxt "Balloon:7164:0:1"
msgid "Come visit the memorial space when you have a moment!"
msgstr "Загляните при случае и в мемориальный зал!"

#. ja: ガボボベベベ…
#. de: \<gluck><nbsp>...
#. fr: Blourp... Glourp...
msgctxt "Balloon:7165:0:1"
msgid "Glub...glub...glub...!"
msgstr "Буль... буль... буль...!"

#. ja: 波に揺られて<br>ゆ～らゆら…
#. de: Aaah, das hat gutgetan!
#. fr: Aaaah... Ça fait tellement du bien...
msgctxt "Balloon:7166:0:1"
msgid "Ahhh... Now that's refreshing!"
msgstr "Ах... Вот теперь прохладненько!"

#. ja: 勇気出せ、俺…！
#. de: Na komm schon, nimm deinen Mut zusammen<nbsp>...!
#. fr: Allez... Un peu de courage, que diable...
msgctxt "Balloon:7167:0:1"
msgid "Come on... Just a little further..."
msgstr "Ну же... Осталось совсем чуть-чуть..."

#. ja: あんまりふざけてると<br>ヒーロー士が心配するよ～？
#. de: Hör auf, so zu tun, als ob du ertrinken würdest! Du alarmierst noch den Recken des Reigens.
#. fr: Arrête de faire semblant de te noyer, tu vas déranger le Héros de la Mort pour rien<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7168:0:1"
msgid "Quit faking or you'll distract the savior from <i>real</i> heroics!"
msgstr "Хватит притворяться, а то отвлечёшь спасителя от <i>настоящих</i> подвигов!"

#. ja: いけるいける<br>たぶんいける…
#. de: Das wird schon, das wird schon, das wird schon<nbsp>... Hoffe ich zumindest<nbsp>...
#. fr: Ça va le faire, ça va le faire... Enfin, j'espère...
msgctxt "Balloon:7169:0:1"
msgid "I can do this... Maybe."
msgstr "Я справлюсь... Наверное."

#. ja: 今度は落ちないでよ～？
#. de: Pass auf, dass du diesmal nicht fällst, ja?
#. fr: Fais attention à ne pas tomber cette fois, mon loulou<nbsp>!
msgctxt "Balloon:7170:0:1"
msgid "I can't fall...not again!"
msgstr "Только в этот раз не упади, ладно?"

#. ja: おう、リベンジかましたれ！
#. de: Zeit für deine Revanche! Zeig allen, was in dir steckt!
#. fr: L'heure de ta revanche a sonné<nbsp>!
msgctxt "Balloon:7171:0:1"
msgid "Every failure just makes you stronger! Show us what you're made of!"
msgstr "Каждая неудача делает тебя сильнее! Покажи, на что способен!"

#. ja: 万一トラブルがあっても<br>ヒーロー士がいるなら安心ね
#. de: Solange der Recke des Reigens hier ist, müssen wir uns keine Sorgen mehr um unsere Sicherheit machen!
#. fr: Tant que le Hérrros de la Mort est là, nous sommes en sécurité<nbsp>!
msgctxt "Balloon:7172:0:1"
msgid "If trouble comes knocking, the Sunshine Savior will scare it off!"
msgstr "Если случится беда, Спаситель Солнечного Берега её мигом прогонит!"

#. ja: サメが来ても大丈夫！
#. de: Glaubst du, der Hai könnte zurückkommen?
#. fr: Vous croyez que le requin va revenir<nbsp>?
msgctxt "Balloon:7173:0:1"
msgid "Even if it's a shark that's thiiis big!"
msgstr "Даже если приплывёт вот такая здоровенная акула!"

#. ja: ちょっと<br>怖いこと言わないでよ！
#. de: Beschwör bloß kein Unglück herauf!
#. fr: Oh non, parle pas de malheur<nbsp>!
msgctxt "Balloon:7174:0:1"
msgid "H-Hey! Don't tempt fate like that!"
msgstr "Эй! Не накликай беду!"

#. ja: あのサメ<br>何しにきたんだろうね？
#. de: Was wollte dieser Hai überhaupt hier?
#. fr: Un requin sur pattes, c'est vrai que ça fait peur...
msgctxt "Balloon:7175:0:1"
msgid "What scent drew that shark here, I wonder?"
msgstr "Интересно, что этой акуле здесь понадобилось?"

#. ja: 魔城の隣に<br>絶景スポットがあるんだと
#. de: Neben dem Parkour soll es ein hübsches Plätzchen geben<nbsp>...
#. fr: Ça a l'air sympa là-bas, à côté de l'attraction...
msgctxt "Balloon:7176:0:1"
msgid "Someone said there's a breathtaking vista next to the course."
msgstr "Говорят, рядом с трассой есть место с потрясающим видом."

#. ja: へ～<br>あとでいってみよっか！
#. de: Oh, wirklich? Lass uns später mal dorthin gehen!
#. fr: Tu crois<nbsp>? Allons voir ça de plus près<nbsp>!
msgctxt "Balloon:7177:0:1"
msgid "Really!? Promise we'll go later."
msgstr "Правда? Обещай, что потом сходим!"

#. ja: ようこそー！
#. de: Herzlich willkommen!
#. fr: Bienvenue à vous<nbsp>!
msgctxt "Balloon:7178:0:1"
msgid "Welcome, welcome!"
msgstr "Добро пожаловать! Заходите!"

#. ja: よくここまでこれたね！
#. de: Man könnte meinen, du hast dein ganzes Leben lang nichts anderes gemacht!
#. fr: On dirait que vous avez fait ça toute votrrre vie<nbsp>!
msgctxt "Balloon:7179:0:1"
msgid "You did well to make it here!"
msgstr "Неплохо ты сюда добрался!"

#. ja: ナイスファイト！
#. de: Ganz schön beeindruckend!
#. fr: Quelle classe<nbsp>!
msgctxt "Balloon:7180:0:1"
msgid "Such courage! Such grace!"
msgstr "Вот это смелость! Вот это грация!"

#. ja: しかしあの衣装は…
#. de: Dieses Gewand allerdings<nbsp>...
#. fr: Tout de même, ce costume...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7181:0:1"
msgid "<i>That's</i> our savior? "
msgstr "<i>Это</i> и есть наш спаситель?"

#. ja: ええ、さすがに<br>着るのは遠慮したいわね
#. de: Ich würde so etwas jedenfalls nicht tragen wollen<nbsp>...
#. fr: Jamais de la vie je ne mettrai un truc pareil<nbsp>!
msgctxt "Balloon:7182:0:1"
msgid "Aye, it takes courage to wear something like that..."
msgstr "Да уж, в таком наряде и правда надо не стесняться показаться..."

#. ja: 氷菓作りの合間に<br>ちょいと魔城を見物中さ
#. de: Zwischen zwei Portionen Schabeeis werde ich mal einen Blick auf den diesjährigen Parkour werfen.
#. fr: Je jette un œil à “Pas dans l'tas” entre deux fournées de desserts...
msgctxt "Balloon:7183:0:1"
msgid "The only thing better than making desserts is watching people tumble into the sea."
msgstr "Лучше десертов только смотреть, как народ шлёпается в море."

#. ja: 辰…かわいい…
#. de: Süß, euer kleiner Drache.
#. fr: Je... J'ai envie de le caresser...
msgctxt "Balloon:7184:0:1"
msgid "Oh, to be a chocobo chick in a dragon costume..."
msgstr "Эх, вот бы мне птенчиком чокобо в костюме дракона родиться..."

#. ja: 東方にも<br>かわいい生き物がいるのね
#. de: Im Fernen Osten gibt es also recht sympathische Ungeheuer.
#. fr: Il n'y a donc pas qu'en Éorzéa que les animaux mignons ont la cote.
msgctxt "Balloon:7185:0:1"
msgid "How precious!"
msgstr "Какая прелесть!"

#. ja: ご利益があるんだってさ
#. de: Man sagt, sie bringen Glück.
#. fr: Apparemment, je vais devenir rrriche cette année.
msgctxt "Balloon:7186:0:1"
msgid "Sounds like it'll be smooth sailing for me this year!"
msgstr "Говорят, они приносят удачу. Вот бы и мне повезло в этом году!"

#. ja: あやかりたいところだな
#. de: Ich wäre auch gerne mit Glück gesegnet.
#. fr: J'aimerais pouvoir en dire autant...
msgctxt "Balloon:7187:0:1"
msgid "Hm. Maybe I should get me own blessin'..."
msgstr "Хм. Надо бы и мне себе удачи выпросить..."

#. ja: 強大な妖異が<br>なぜこんな場所に…
#. de: Was macht so eine große Kreatur hier?
#. fr: Qu'est-ce qu'une créature aussi puissante fait ici<nbsp>?
msgctxt "Balloon:7188:0:1"
msgid "Why do you suppose they chose here for their lair?"
msgstr "Почему они облюбовали для логова именно это место?"

#. ja: 手強かったわね…！
#. de: Das war ein ziemlicher Brocken.
#. fr: Il était costaud, celui-là<nbsp>!
msgctxt "Balloon:7189:0:1"
msgid "Well, that was a challenge."
msgstr "Ну и крепкий же он был..."

#. ja: こいつも<br>ゴルベーザ四天王だったか
#. de: Wieder einer der vier Elementarfürsten.
#. fr: Encore un général de Golbez...
msgctxt "Balloon:7190:0:1"
msgid "So goes yet another archfiend."
msgstr "Ещё один архидемон повержен."

#. ja: 水を操る妖異とはね
#. de: Der Herr des Wassers.
#. fr: Le “maître de l'eau”, hein... Il n'a pas volé son nom.
msgctxt "Balloon:7191:0:1"
msgid "I've never seen a voidsent with such command over water."
msgstr "Никогда не видел, чтобы пустотное существо так повелевало водой."

#. ja: かなりデカい<br>ヴォイドゲートだ
#. de: Das Portal ist gigantisch.
#. fr: Leur porte du néant est aussi grande que prévu.
msgctxt "Balloon:7192:0:1"
msgid "That they could open so large a gate is troubling."
msgstr "Тревожно, что им удалось открыть врата таких размеров."

#. ja: いったい…<br>姉さんはどこに…
#. de: Schwester, wo bist du?
#. fr: Je ne vois aucune trace de ma sœur...
msgctxt "Balloon:7193:0:1"
msgid "I feel your presence, Sister. Where are you?"
msgstr "Я чувствую твоё присутствие, сестра. Где ты?"

#. ja: アルコンエッグの配布に<br>協力しましょう！
#. de: Los, helfen wir ihnen beim Verteilen der Saliah-Eier!
#. fr: Aidons-les à distribuer les Prœufs<nbsp>!
msgctxt "Balloon:7194:0:1"
msgid "What if we volunteer to distribute eggs?"
msgstr "Может, предложим помочь раздать яйца?"

#. ja: タマゴをトンベリ柄に<br>塗ってみようかな？
#. de: Wie wäre es, wenn wir die Eier mit Tomberry-Motiven verzieren würden?
#. fr: Et si on décorrrait les Prœufs avec des motifs de tomberrys<nbsp>?
msgctxt "Balloon:7195:0:1"
msgid "Time to transform these eggs into adorable tonberries!"
msgstr "Пора превратить эти яйца в очаровательных тонберри!"

#. ja: いいね<br>僕もやってみよう
#. de: Die Idee gefällt mir! Ich will es auch mal versuchen.
#. fr: Bonne idée<nbsp>! Je vais essayer aussi.
msgctxt "Balloon:7196:0:1"
msgid "Does that make them...toneggies?"
msgstr "Значит, теперь они... тон-яйца?"

#. ja: 実行委員を<br>手伝いたいな…
#. de: Ich würde mich gerne nützlich machen<nbsp>...
#. fr: J'aimerais prêter main-forte aux organisateurs...
msgctxt "Balloon:7197:0:1"
msgid "I do wish we could help somehow..."
msgstr "Вот бы и нам чем-нибудь помочь..."

#. ja: やりたいことはない～！？
#. de: Wollen wir irgendwo mitmachen?
#. fr: Qu'est-ce que tu voudrais faire<nbsp>?
msgctxt "Balloon:7198:0:1"
msgid "Well, what do you like to do?"
msgstr "Ну и чем тебе хочется заняться?"

#. ja: やりたい…こと…？
#. de: M-Mitmachen? Bist du sicher?
#. fr: Je peux décider par moi-même<nbsp>?
msgctxt "Balloon:7199:0:1"
msgid "I haven't the foggiest."
msgstr "Понятия не имею."

#. ja: マシンを作ってみない？
#. de: Ich würde so gerne etwas bauen<nbsp>...
#. fr: Tu veux pas essayer de construire une machine<nbsp>?
msgctxt "Balloon:7200:0:1"
msgid "Why not try inventing a machine?"
msgstr "Может, попробуем изобрести машину?"

#. ja: うーん、そうだなぁ…
#. de: Wollen wir es mal versuchen?
#. fr: Hm... Pourquoi pas...
msgctxt "Balloon:7201:0:1"
msgid "W-With wrenches!? Oooh..."
msgstr "С-гайками и ключами?! О-о-о..."

#. ja: 料理に興味はない？
#. de: Da bekommt man selbst Lust zu kochen, oder?
#. fr: La cuisine, ça t'intéresse<nbsp>?
msgctxt "Balloon:7202:0:1"
msgid "Are you interested in cooking?"
msgstr "Тебе готовить нравится?"

#. ja: 食べるのは好きだけど…
#. de: Hmm, ich futtere ja lieber<nbsp>...
#. fr: Hmm... Je sais pas, mais j'aime bien manger en tout cas<nbsp>!
msgctxt "Balloon:7203:0:1"
msgid "I do like to eat..."
msgstr "Поесть я люблю..."

#. ja: 一緒に絵を描こうよ！？
#. de: Malen wir zusammen ein Bild?
#. fr: Viens peindre avec nous<nbsp>!
msgctxt "Balloon:7204:0:1"
msgid "How about painting?"
msgstr "Как насчёт порисовать?"

#. ja: 絵心ないしなぁ…
#. de: Ich kann aber nicht malen<nbsp>...
#. fr: Hmm... Je sais pas... Je suis pas très doué...
msgctxt "Balloon:7205:0:1"
msgid "I don't have the talent. Or coordination..."
msgstr "Таланта у меня нет. Да и руки не слушаются..."

#. ja: 放送のお手伝いしない！？
#. de: Komm, denken wir uns ein neues Thema aus!
#. fr: Tu as un physique de radio<nbsp>! Tu veux essayer<nbsp>?
msgctxt "Balloon:7206:0:1"
msgid "Would you like to be on the radio?"
msgstr "Не хочешь поучаствовать в радиопередаче?"

#. ja: た、楽しそうかも…！
#. de: Au ja!
#. fr: Oh oui<nbsp>! Ça a l'air bigrement amusant<nbsp>!
msgctxt "Balloon:7207:0:1"
msgid "Would I!?"
msgstr "Ещё как хочу!"

#. ja: 夢は見つかった！？
#. de: Hast du schon deinen Traum gefunden?
#. fr: Et toi, c'est quoi ton rêve<nbsp>!?
msgctxt "Balloon:7208:0:1"
msgid "Did you find a dream?"
msgstr "Нашёл мечту?"

#. ja: やりたいことが多すぎて<br>迷っちゃうよ…
#. de: Ich weiß nicht. Die Auswahl ist riesig<nbsp>...
#. fr: Il y a tant de stations à essayer<nbsp>!!
msgctxt "Balloon:7209:0:1"
msgid "I found too many. Now I'm confused..."
msgstr "Их слишком много... Теперь не знаю, за какую взяться."

#. ja: そのユニフォーム<br>いいな～！
#. de: Wo hast du die tolle Uniform her?
#. fr: Moi aussi je veux un maillot jaune... Comment tu l'as eu<nbsp>?
msgctxt "Balloon:7210:0:1"
msgid "What a nice uniform you have!"
msgstr "Какая у тебя красивая форма!"

#. ja: 夢かぁ～…
#. de: Einen Traum<nbsp>...? Hmm<nbsp>...
#. fr: Mon rêve...
msgctxt "Balloon:7211:0:1"
msgid "Dreaming..."
msgstr "Мечта, значит..."

#. ja: そのユニフォームを着る！
#. de: Mein Traum ist es, diese Uniform zu haben!
#. fr: C'est d'avoir un uniforme comme le vôtre<nbsp>!
msgctxt "Balloon:7212:0:1"
msgid "My dream is to wear one of those uniforms!"
msgstr "Моя мечта — носить такую форму!"

#. ja: お腹いっぱいになるまで<br>食べてやる！
#. de: Mein Traum ist, zu futtern, bis ich umfalle!
#. fr: C'est de ne jamais m'arrêter de manger<nbsp>!
msgctxt "Balloon:7213:0:1"
msgid "My dream is to have lunch at the cooking station!"
msgstr "Моя мечта — пообедать на кулинарной станции!"

#. ja: ずーっと遊んで暮らす！
#. de: Mein Traum ist es, jeden Tag Spaß zu haben!
#. fr: C'est de m'amuser comme un petit fou<nbsp>!
msgctxt "Balloon:7214:0:1"
msgid "My dream is to have a dream!"
msgstr "Моя мечта — чтобы у меня была мечта!"

#. ja: そっかぁ…
#. de: Waaas? Na gut<nbsp>...
#. fr: Ah bon...<nbsp>?
msgctxt "Balloon:7215:0:1"
msgid "Aw..."
msgstr "Эх..."

#. ja: もう一度、<br>夢について考えてくる…！
#. de: Ich komm wieder, wenn mir etwas eingefallen ist!
#. fr: Je vais réfléchir encore un peu à quel rêve réaliser<nbsp>!
msgctxt "Balloon:7216:0:1"
msgid "I'll be back─with a proper dream!"
msgstr "Я ещё подумаю о мечте и вернусь!"

#. ja: 夢を見つけて<br>ここの一員になったのさ！
#. de: Die bekommt man, wenn man einen Traum gefunden hat!
#. fr: J'ai découvert mon rêve et j'ai rejoint les Ateliers Dreaming<nbsp>!
msgctxt "Balloon:7217:0:1"
msgid "I'm one of the Dreaming Ways now!"
msgstr "Теперь я один из Путей мечты!"

#. ja: うーん<br>それはちょっと違う気が…
#. de: Ich glaube, das reicht nicht ganz<nbsp>...
#. fr: Hmm... Ça suffira pas...
msgctxt "Balloon:7218:0:1"
msgid "...I'm not certain that counts."
msgstr "...Не уверен, что это считается."

#. ja: やっほ～！
#. de: Huhu!
#. fr: Bonjour<nbsp>!
msgctxt "Balloon:7219:0:1"
msgid "Hail, my best Way!"
msgstr "Привет, мой лучший друг по Пути!"

#. ja: ソーン家に<br>突撃取材しようかしら
#. de: Ich sollte einen neuen Artikel über Haus Thorne schreiben<nbsp>...
#. fr: Héhé... Et si je m'introduisais chez les Thorne ?<br>Il y a sûrement un scoop à faire...
msgctxt "Balloon:7220:0:1"
msgid "Mayhap I'll interview the Thornes while I have the chance..."
msgstr "Может, пока есть случай, взять интервью у семьи Торн?"

#. ja: ソーン家の歴史…<br>深い…
#. de: Was sich wohl noch in den Archiven der Thornes verbergen mag?
#. fr: L'histoire de la dynastie Thorne est si profonde...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7221:0:1"
msgid "The Little Ladies' Dance...<br>I never thought I'd see it..."
msgstr "Танец маленьких леди... Не думал, что когда-нибудь его увижу..."

#. ja: クラウディアにも<br>見せたかったですわ
#. de: Wie gern ich Claudia sagen würde, dass ihr Tanz nicht vergessen ist.
#. fr: J'aurais tant aimé montrer cela à Claudia !
msgctxt "Balloon:7222:0:1"
msgid "If only Claudia were alive to see this..."
msgstr "Эх, вот бы Клаудия была жива и увидела это..."

#. ja: プリンセスデーも<br>悪くありませんね
#. de: Immerhin bringt das Fest etwas Abwechslung nach Ul'dah.
#. fr: Ce festival n'est pas si désagréable, finalement.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7223:0:1"
msgid "Perhaps this festival's better<br>than I gave it credit for."
msgstr "А Принцессин день, оказывается, не так уж плох."

#. ja: わぁ、きれ～！
#. de: Mama, ich will das!
#. fr: Ouaah, trop beau !
msgctxt "Balloon:7224:0:1"
msgid "Mother, it's beautiful!"
msgstr "Мама, какая красота!"

#. ja: みんな～！<br>今回のプリンセスデーは～
#. de: Willkommen auf dem Prinzessinnenfest!
#. fr: Chère par<shy>ti<shy>ci<shy>pants, chères participantes ! Cette année...
msgctxt "Balloon:7225:0:1"
msgid "For this year's celebration..."
msgstr "В этом году на празднике..."

#. ja: キレイな扇を配布します！
#. de: Dieses Jahr schenken wir den Gästen einen wunderschönen Fächer.
#. fr: Nous allons vous distribuer de magnifiques éventails !
msgctxt "Balloon:7226:0:1"
msgid "We'll be distributing gorgeous fans to everyone!"
msgstr "Мы раздадим всем чудесные веера!"

#. ja: まだ準備中だから<br>楽しみに待っててね
#. de: Noch ein wenig Geduld bitte, wir fangen bald an.
#. fr: Nous vous demandons simplement encore un peu de patience !
msgctxt "Balloon:7227:0:1"
msgid "Please give us just a moment to prepare!"
msgstr "Подождите ещё немного, мы пока готовимся!"

#. ja: エドヴィア姫の<br>「姫の舞踊」だよ～！
#. de: Bestaunt den herrlichen Prinzessinnentanz der Prinzessin Edvya!
#. fr: Cher public, voici la “danse des princesses” !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7228:0:1"
msgid "Behold, Princess Edvya's<br>Little Ladies' Dance!"
msgstr "Полюбуйтесь танцем маленьких леди принцессы Эдвии!"

#. ja: 皆さんも一緒に<br>踊りましょう！
#. de: Wer mittanzen möchte, ist herzlich dazu eingeladen!
#. fr: Allez, dansons tous ensemble !
msgctxt "Balloon:7229:0:1"
msgid "You are all welcome to join us!"
msgstr "Приглашаем всех танцевать вместе с нами!"

#. ja: 扇も配布中よ<br>ぜひ受け取ってね
#. de: Es sind genug Fächer für alle da!
#. fr: Et n'oubliez pas de récupérer votre éventail !
msgctxt "Balloon:7230:0:1"
msgid "There are enough fans for everyone!"
msgstr "Вееров хватит на всех!"

#. ja: 舞がより映える衣装…<br>面白そうね！
#. de: In diesem Kleid werde ich beim Tanzen alle Blicke auf mich ziehen!
#. fr: Cette tenue met en valeur leurs mouvements gracieux... C'est bien vu !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7231:0:1"
msgid "Outfits that better highlight<br>the dance...color me intrigued!"
msgstr "Костюмы, в которых танец смотрится ещё лучше... Заинтриговали!"

#. ja: かわいい～！
#. de: Oh, wie hübsch!
#. fr: Oooh, quelle danse adorable !
msgctxt "Balloon:7232:0:1"
msgid "What a cute dance!"
msgstr "Какой милый танец!"

#. ja: 私も踊れるかなぁ？
#. de: Das sieht gar nicht so schwer aus<nbsp>...
#. fr: Tu crois que j'arriverais à la danser, moi aussi ?
msgctxt "Balloon:7233:0:1"
msgid "Do you think I can do it too?"
msgstr "Как думаешь, у меня тоже получится?"

#. ja: 無理せず<br>ゆっくり練習してみましょうか
#. de: Soll ich mich trauen? Ich hätte wirklich Lust zu mitzutanzen.
#. fr: Bien sûr. Prends ton temps et observe bien leur chorégraphie.
msgctxt "Balloon:7234:0:1"
msgid "Of course, dear. Just take it one step at a time."
msgstr "Конечно, милая. Не спеши, понемногу научишься."

#. ja: どんな扇なのかな？
#. de: Ob diese Fächer eine besondere Bedeutung haben?
#. fr: Quel genre d'éventail cela peut être ?
msgctxt "Balloon:7235:0:1"
msgid "What sort of fans, I wonder?"
msgstr "Интересно, какие веера?"

#. ja: 早くほしいわ！
#. de: Ich hoffe, sie fangen bald mit dem Verteilen an!
#. fr: Il m'en faut un absolument !
msgctxt "Balloon:7236:0:1"
msgid "Oooh, I can't wait!"
msgstr "Ох, не терпится!"

#. ja: 三歌姫は何をするのかしら？
#. de: Was die Drei Singdrosseln wohl dieses Mal aufführen?
#. fr: Quel spectacle vont proposer les Églantines cette année ?
msgctxt "Balloon:7237:0:1"
msgid "I wonder what the Songbirds have planned..."
msgstr "Интересно, что придумали Певчие пташки..."

#. ja: とても優雅だね
#. de: Die Fächer sind wunderschön<nbsp>...
#. fr: Quelle grâce ! Quelle élégance !
msgctxt "Balloon:7238:0:1"
msgid "How very elegant!"
msgstr "Как изящно!"

#. ja: 私も踊ってみたいわ！
#. de: Ich möchte mitmachen!
#. fr: Ça me donne envie de danser !
msgctxt "Balloon:7239:0:1"
msgid "Perhaps I shall give it a try!"
msgstr "Пожалуй, и мне стоит попробовать!"

#. ja: 三歌姫、最っ高…！
#. de: Die Drei Singdrosseln sind einfach die Besten!
#. fr: Bravo les Églantines, vous êtes les meilleures !
msgctxt "Balloon:7240:0:1"
msgid "The Songbirds are amazing!"
msgstr "Певчие пташки — просто чудо!"

#. ja: これはもしや<br>新種のプディング！
#. de: Hm? Sind das bunte Puddingknödel?
#. fr: Non ! Ce serait... un flan d'un nouveau genre !?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7241:0:1"
msgid "The day has come, my friends...<br>Pudding has evolved!"
msgstr "Друзья, этот день настал... Пудинг эволюционировал!"

#. ja: 究極の…<br>プディング作ってほしい！
#. de: Ich will, dass er mir seinen ultimativen Pudding zubereitet!
#. fr: Je veux qu'il m'apprenne sa meilleure recette de flan<nbsp>!
msgctxt "Balloon:7242:0:1"
msgid "I want you to make pudding! The best pudding in this realm or any other!"
msgstr "Приготовь мне пудинг! Самый лучший пудинг во всех мирах!"

#. ja: この子たちも<br>アンタを応援したいみたいだよ
#. de: Die Kleinen wollen dich wohl auch unterstützen!
#. fr: Au fait, cette famille d'ours blancs tenait absolument à vous encourager<nbsp>!
msgctxt "Balloon:7244:0:1"
msgid "These younglings are rooting for your success!"
msgstr "И эти малыши болеют за тебя!"

#. ja: まあ、お客様ったら<br>お上手ですこと
#. de: Fantastisch! Ihr seid ein Naturtalent!
#. fr: Vous me flattez, mon bon monsieur<nbsp>!
msgctxt "Balloon:7245:0:1"
msgid "My, my, you're quite good at this!"
msgstr "Надо же, у вас отлично получается!"

#. ja: あのヌルヌルの秘密<br>きっとここにあるはず…！
#. de: Das Geheimnis dieses Glibbers<nbsp>... Die Antworten sind hier, ich spüre es!
#. fr: Je percerai le secret de sa viscosité<nbsp>!
msgctxt "Balloon:7246:0:1"
msgid "I shall uncover this slippery secret!"
msgstr "Я раскрою секрет этой скользкой твари!"

#. ja: この空間を作った方は<br>かなりの技術者ですね…
#. de: Wer diese Hallen entworfen hat, ist wahrlich ein Meister seiner Kunst<nbsp>...
#. fr: La personne qui a conçu ce square ne manque pas d'ingéniosité.
msgctxt "Balloon:7247:0:1"
msgid "The architect of this space is truly a master of his craft..."
msgstr "Тот, кто создал это место, и правда мастер своего дела..."

#. ja: なんておそろしいことを<br>考えるクポ…
#. de: Die denken sich wirklich schreckliche Dinge aus hier, kupo<nbsp>...!
#. fr: Les humains ont des idées effrayantes, kupo...
msgctxt "Balloon:7248:0:1"
msgid "What frightful mind thought these up, kupo?"
msgstr "Кому вообще пришло в голову придумать такое, купо?"

#. ja: そうじゃないと<br>思うクポ…
#. de: Ich glaube nicht, dass die echt sind, kupo<nbsp>...
#. fr: Je crois que vous avez mal compris, kupo...
msgctxt "Balloon:7249:0:1"
msgid "It's not that bad, kupo."
msgstr "Не всё так плохо, купо."

#. ja: ああ、本当に<br>なんてお礼を言えばいいか…！
#. de: Oh, ich weiß gar nicht, wie ich Euch danken kann<nbsp>...!
#. fr: J-je ne sais pas comment vous remercier<nbsp>!
msgctxt "Balloon:7250:0:1"
msgid "Oh, how can I possibly thank you!"
msgstr "Ох, как же вас благодарить!"

#. ja: いつの間に<br>こんな場所が…
#. de: Was sie hier wohl vorhaben<nbsp>...?
#. fr: Oh<nbsp>! Depuis quand un tel endroit existe<nbsp>?
msgctxt "Balloon:7251:0:1"
msgid "Whoa! This isn't a closet at all!"
msgstr "Вот это да! А я-то думал, тут просто чулан!"

#. ja: こ、この曲は何っ！？
#. de: Ich muss wissen, wie dieses Lied heißt!
#. fr: C'est quoi le titre de la chanson<nbsp>!?
msgctxt "Balloon:7252:0:1"
msgid "I know this song!"
msgstr "Я знаю эту песню!"

#. ja: ありがとう～！
#. de: Dankeschön!
#. fr: Merci<nbsp>!!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7253:0:1"
msgid "White <i>and</i> blue! You're a miracle worker!"
msgstr "Белый <i>и</i> синий! Да ты волшебник!"

#. ja: 今度はどんなお話かな…！？
#. de: Worum es in der Sendung heute wohl geht?
#. fr: Je me demande de quoi ils vont parler maintenant<nbsp>!
msgctxt "Balloon:7254:0:1"
msgid "Maybe they'll read mine next!"
msgstr "Может, теперь прочитают моё письмо!"

#. ja: うーん、まだかなぁ…？
#. de: Hundert Möhren, dass der sich verlaufen hat<nbsp>...
#. fr: Mais qu'est-ce qu'il fait...<nbsp>?
msgctxt "Balloon:7255:0:1"
msgid "My arms are getting tired..."
msgstr "Руки уже устали..."

#. ja: おまたせー！
#. de: Huhuuu! Da bin ich!
#. fr: Désolé pour le retard<nbsp>!
msgctxt "Balloon:7256:0:1"
msgid "Ready to go?"
msgstr "Ну что, идём?"

#. ja: 遅いよ～！
#. de: Potzrübe, wo hast du gesteckt?!
#. fr: J'allais prendre racine comme cette carotte<nbsp>!
msgctxt "Balloon:7257:0:1"
msgid "What took you so long?"
msgstr "Долго же тебя не было!"

#. ja: ごめん、ごめん！<br>それじゃ、行こうか！
#. de: Tut mir leid, bin eingenickt<nbsp>...
#. fr: Pardon, pardon<nbsp>! Bon, on y va<nbsp>?
msgctxt "Balloon:7258:0:1"
msgid "I tripped! Tail over teakettle, straight into a creation station..."
msgstr "Я споткнулся! Прямо кубарем в мастерскую творений..."

#. ja: 登ってやるぜェェ！
#. de: Ich werde es schaffen!
#. fr: Je vais y arriver<nbsp>!
msgctxt "Balloon:7259:0:1"
msgid "I'll climb you good!"
msgstr "Я тебя покорю!"

#. ja: どりゃあ！<br>海賊魂ぃぃ！！
#. de: Ein Pirat gibt sich niemals kampflos geschlagen!
#. fr: Par le pouvoir des piraaaates<nbsp>!
msgctxt "Balloon:7260:0:1"
msgid "Hyaaahhh! No one messes with a pirate!"
msgstr "Хья-а-а! С пиратом лучше не связываться!"

#. ja: 力みすぎるなよ！
#. de: Übertreib es mal nicht!
#. fr: Relâche-toi un peu<nbsp>!
msgctxt "Balloon:7261:0:1"
msgid "Pace yerself!"
msgstr "Полегче там!"

#. ja: アロハ！
#. de: Aloha!
#. fr: Aloha<nbsp>!
msgctxt "Balloon:7262:0:1"
msgid "Why, hello!"
msgstr "Алоха!"

#. ja: お前、海が…恋しいのか？
#. de: Dir fehlt das Meer, hab ich recht?
#. fr: ... Ta mer te manque, c'est ça<nbsp>?
msgctxt "Balloon:7263:0:1"
msgid "The sea's callin' to ye, ain't she?"
msgstr "Море по тебе скучает, да?"

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "Balloon:7264:0:1"
msgid "..."
msgstr "..."

#. ja: 落ちてたまるか…！
#. de: Auf keinen Fall werde ich jetzt da runterfallen<nbsp>...
#. fr: Pas question que je tombe maintenant...
msgctxt "Balloon:7265:0:1"
msgid "I can't fall...not again!"
msgstr "Я не могу упасть... Только не снова!"

#. ja: 死霊の正体見たり…
#. de: Somit nimmt eine Legende ihr Ende<nbsp>...
#. fr: Un cadavre vivant... Ça fait peur...
msgctxt "Balloon:7266:0:1"
msgid "Thus the legend is unmasked..."
msgstr "Вот и раскрыта тайна легенды..."

#. ja: 不気味なヤツだったね
#. de: Ich habe immer noch Gänsehaut<nbsp>...
#. fr: J'en ai encore la chair de poule...
msgctxt "Balloon:7267:0:1"
msgid "Of all the eerie things here, that was definitely the eeriest."
msgstr "Из всего жуткого, что здесь было, это — самое жуткое."

#. ja: これで航海を<br>再開できるわね
#. de: Jetzt sollten wir unsere Fahrt fortsetzen können.
#. fr: Pas de temps à perdre, continuons notre route<nbsp>!
msgctxt "Balloon:7268:0:1"
msgid "Now we can resume our voyage."
msgstr "Теперь можно продолжить наше плавание."

#. ja: ふぅ…<br>妖異の仕業だったのか…
#. de: Ich hätte nie einen Nichts<shy>gesand<shy>ten hinter alledem erwartet<nbsp>...
#. fr: Un véritable démon, par les Douze...
msgctxt "Balloon:7269:0:1"
msgid "I cannot put this isle behind us soon enough..."
msgstr "Я не скоро забуду этот остров..."

#. ja: ようやく一息<br>つけそうでござるな…
#. de: Endlich gewährt man uns eine Ver<shy>schnauf<shy>pause<nbsp>...
#. fr: Enfin un peu de répit...
msgctxt "Balloon:7270:0:1"
msgid "Finally, we may breathe easy..."
msgstr "Наконец-то можно передохнуть..."

#. ja: なんとも猛々しき<br>怪鳥であったな！
#. de: Wahrlich ein ungestümer Vogel, mit dem wir es zu tun hatten.
#. fr: Difficile de faire plus sauvage comme volatile<nbsp>!
msgctxt "Balloon:7271:0:1"
msgid "Such a ferocious bird that was."
msgstr "И правда, свирепая птица нам попалась."

#. ja: これで、試練突破だね！
#. de: Wir haben die Prüfung bestanden!
#. fr: Et voilà, épreuve réussie<nbsp>!
msgctxt "Balloon:7272:0:1"
msgid "We did it! We passed the trial!"
msgstr "Получилось! Испытание пройдено!"

#. ja: 我らも天守閣へ！
#. de: Auf, weiter zum Turm!
#. fr: Tout le monde au donjon<nbsp>!
msgctxt "Balloon:7273:0:1"
msgid "Let us press on to the keep!"
msgstr "Вперёд, к крепости!"

#. ja: ヒエン様…！
#. de: Hien, wir sind schon unterwegs<nbsp>...!
#. fr: Seigneur Hien<nbsp>!
msgctxt "Balloon:7274:0:1"
msgid "Be safe, my lord..."
msgstr "Берегите себя, господин..."

#. ja: まだまだ暴れられるわよ！
#. de: So, jetzt bin ich ordentlich aufgewärmt!
#. fr: J'ai pas dit mon dernier mot<nbsp>!
msgctxt "Balloon:7275:0:1"
msgid "I'm only just limbering up!"
msgstr "Я только-только размялась!"

#. ja: 管制室の方は…
#. de: Hoffentlich konnte Lyse den Kontrollraum erreichen<nbsp>...
#. fr: La salle de contrôle...
msgctxt "Balloon:7276:0:1"
msgid "I wonder how Lyse fares."
msgstr "Интересно, как там Лайза."

#. ja: まだ、終わりじゃないのか…？
#. de: Was erwartet uns nun<nbsp>...?
#. fr: Ça n'en finira donc jamais<nbsp>!?
msgctxt "Balloon:7277:0:1"
msgid "What now...?"
msgstr "Что теперь?.."

#. ja: あいつ…<br>この戦いを愉しんでた…
#. de: Dieses Monster<nbsp>... hatte Spaß an unserem Kampf<nbsp>...
#. fr: Quel monstre... Il avait l'air au paradis...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7278:0:1"
msgid "He <i>enjoyed</i> this, the monster..."
msgstr "Это чудовище <i>наслаждалось</i> битвой..."

#. ja: 油断するな…<br>嫌な気配がする…
#. de: Bleibt auf der Hut. Ich habe ein ungutes Gefühl<nbsp>...
#. fr: Attention, j'ai un mauvais pres<shy>sen<shy>ti<shy>ment...
msgctxt "Balloon:7279:0:1"
msgid "It's not over yet. Stay sharp."
msgstr "Это ещё не конец. Будьте начеку."

#. ja: ゼノスめ<br>ようやく追い詰めたぞ…
#. de: Du entkommst uns nicht mehr, Zenos!
#. fr: Tu ne peux plus nous échapper, Zenos<nbsp>!
msgctxt "Balloon:7280:0:1"
msgid "There's no escape, Zenos!"
msgstr "Тебе не уйти, Зенос!"

#. ja: 大人にも<br>いい人はいるよね…
#. de: Anscheinend sind nicht alle Erwachsenen so übel<nbsp>...
#. fr: Il y a aussi des grands qui font pas peur...
msgctxt "Balloon:7281:0:1"
msgid "I guess not all adults are bad people..."
msgstr "Похоже, не все взрослые такие плохие..."

#. ja: そりゃそうさ！<br>世界は広いんだぞ！
#. de: Es gibt wohl vieles, was wir nicht über die Welt wissen, oder?
#. fr: Bien sûr<nbsp>! Le monde est si vaste<nbsp>!
msgctxt "Balloon:7282:0:1"
msgid "Yeah, we've still got a lot of growing up to do!"
msgstr "А то! Нам ещё столько всего предстоит узнать о мире!"

#. ja: 世界か…<br>旅してみたいな
#. de: Du hast recht ... Wir sollten sie uns eines Tages selbst ansehen!
#. fr: J'aimerais bien partir à l'aventure...
msgctxt "Balloon:7283:0:1"
msgid "You're right... Maybe we should go on an adventure someday!"
msgstr "Вот бы и мне отправиться в путешествие..."

#. ja: お、落ちちゃうよ！
#. de: S-Sei vorsichtig!
#. fr: Attention, tu vas tomber<nbsp>!
msgctxt "Balloon:7284:0:1"
msgid "B-Be careful!"
msgstr "О-осторожно!"

#. ja: 暫定政府で<br>文官として働き始めたんだ
#. de: Ich habe selbst Neuigkeiten: Ich habe mir einen Platz in der Übergangsregierung verdient!
#. fr: Je viens tout juste d'entrer à l'intendance.
msgctxt "Balloon:7285:0:1"
msgid "Actually, I have news of my own─I've earned a place in the interim government!"
msgstr "Кстати, у меня тоже новости: меня взяли на службу в переходное правительство!"

#. ja: 交易商になって<br>この街のためにだな…
#. de: Habe ich dir das erzählt? Ich habe meine eigene Firma gegründet, um die Stadt zu unterstützen.
#. fr: J'essaie de faire marcher le commerce local.
msgctxt "Balloon:7286:0:1"
msgid "Did I tell you? I've started up my own business to support the town."
msgstr "Я тебе говорил? Я открыл своё дело, чтобы помочь городу."

#. ja: 風が心地いいわ…
#. de: Welch eine angenehme Brise<nbsp>...
#. fr: Cette brise est si agréable...
msgctxt "Balloon:7287:0:1"
msgid "Such a pleasant breeze..."
msgstr "Какой приятный ветерок..."

#. ja: 星の瞬きを見ていると<br>心が落ち着くの…
#. de: Sieh dir bloß mal die Sterne an<nbsp>...
#. fr: Regarder les étoiles est si reposant...
msgctxt "Balloon:7288:0:1"
msgid "Would you just look at the stars..."
msgstr "Смотри, какие звёзды..."

#. ja: 舞もいいが<br>カレーも元気が出るな
#. de: Zu einem feurigen Tanz passt nichts besser als ein Teller feurigen Currys!
#. fr: Entre un bon curry épicé et une danse entraînante, mon cœur balance<nbsp>!
msgctxt "Balloon:7289:0:1"
msgid "Nothing pairs with curry better than a breathtaking performance."
msgstr "Ничто так не дополнит карри, как захватывающее представление."

#. ja: いいかね<br>辛いものを食べるときは…
#. de: Also mit der Schärfe verhält es sich ja so<nbsp>...
#. fr: Alors, la meilleure façon d'apprécier un curry authentique, c'est de...
msgctxt "Balloon:7290:0:1"
msgid "So, the thing about spicy foods is..."
msgstr "Так вот, острой еды бояться не стоит..."

#. ja: スパイスの販路拡充を…
#. de: Vielleicht sollten wir den Gewürzhandel ausweiten?
#. fr: Je me demande si on devrait développer notre commerce d'épices...
msgctxt "Balloon:7291:0:1"
msgid "Perhaps it's time to expand our spice trade..."
msgstr "Может, пора расширить торговлю пряностями..."

#. ja: 食べたいものはあるかい？
#. de: Also, was kochen wir heute?
#. fr: Il y a quelque chose que tu aurais envie de manger<nbsp>?
msgctxt "Balloon:7292:0:1"
msgid "Is there something you'd like to eat?"
msgstr "Что-нибудь хочется поесть?"

#. ja: アレがいい！<br>おじさんの好きなやつ！
#. de: Das, was du immer so gern isst!
#. fr: Oui, oui<nbsp>! Ça, s'il vous plaît<nbsp>!
msgctxt "Balloon:7293:0:1"
msgid "Ooh, the stew! Can you make it again?"
msgstr "О, рагу! Приготовишь его ещё раз?"

#. ja: これから、か…
#. de: Es wird sich schon alles fügen<nbsp>...
#. fr: Qu'est-ce que le futur peut bien nous réserver...<nbsp>?
msgctxt "Balloon:7294:0:1"
msgid "Where do we go from here..."
msgstr "И что же дальше?.."

#. ja: そろそろ<br>派遣団が来る頃だが…
#. de: Das Korps müsste doch bald da sein<nbsp>...
#. fr: Les re<shy>pré<shy>sen<shy>tants de la délégation ne devraient plus tarder...
msgctxt "Balloon:7295:0:1"
msgid "The contingent should be along any moment now..."
msgstr "Отряд вот-вот должен прибыть..."

#. ja: じゃあ、お母さんは<br>お手伝いね？
#. de: Aber lass dir von mir helfen, ja?
#. fr: Comme c'est gentil<nbsp>! Je vais t'aider, d'accord<nbsp>?
msgctxt "Balloon:7296:0:1"
msgid "Oh, he'll be delighted! Have you decided what to make?"
msgstr "О, он будет в восторге! Ты уже решил, что приготовить?"

#. ja: お父さんのために<br>今日は私がご飯つくるね！
#. de: Darf ich heute kochen? Ich will Papa überraschen!
#. fr: Aujourd'hui, c'est moi qui cuisine pour papa<nbsp>!
msgctxt "Balloon:7297:0:1"
msgid "Mother, I want to prepare supper for Father today!"
msgstr "Мама, сегодня я хочу приготовить ужин для папы!"

#. ja: 安静にしていようね
#. de: Ruh dich aus.
#. fr: Il va falloir te reposer, maintenant.
msgctxt "Balloon:7298:0:1"
msgid "Just try to relax, dear."
msgstr "Просто постарайся отдохнуть, милый."

#. ja: お薬、効くかな…
#. de: Wirkt die Medizin überhaupt<nbsp>...?
#. fr: J'espère que le remède fera effet...
msgctxt "Balloon:7299:0:1"
msgid "Will the medicine really help...?"
msgstr "А лекарство точно поможет?.."

#. ja: あの奥…<br>エーテルが噴出しているのか
#. de: Die Geysire dort hinten<nbsp>... Ist das Äther?
#. fr: C'est de l'éther qu'on voit jaillir là-bas<nbsp>?
msgctxt "Balloon:7300:0:1"
msgid "Seems the geyser is just beyond."
msgstr "Похоже, гейзер прямо за поворотом."

#. ja: この泉は地下で<br>海と繋がっているのでしょう
#. de: Ob diese Quelle wohl direkt mit dem Meer verbunden ist?
#. fr: Je suppose que cette source est reliée à l'océan par des nappes souterraines...
msgctxt "Balloon:7301:0:1"
msgid "Mayhap these waters are connected to the sea."
msgstr "Может, эти воды соединяются с морем."

#. ja: イカなら土産にできたのだが
#. de: Wäre es ein Tintenfisch gewesen, hätten wir ihn zur Meyhane bringen können.
#. fr: Dommage, ça aurait fait un bon curry pour le meyhane de Mehryde...
msgctxt "Balloon:7302:0:1"
msgid "Had it been squid, we might have taken some for Estinien."
msgstr "Вот бы это был кальмар — могли бы взять немного для Эстиниена."

#. ja: フン、他愛もない
#. de: Ein Kinderspiel.
#. fr: On s'est à peine échauffés...
msgctxt "Balloon:7303:0:1"
msgid "Nothing to it."
msgstr "Пустяки."

#. ja: さっき聞いたんだけど…
#. de: He, ich hab was Tolles gehört!
#. fr: J'ai entendu dire...
msgctxt "Balloon:7304:0:1"
msgid "Did you hear?"
msgstr "Слышал?"

#. ja: ラジオで流れてたんだけど…
#. de: Ihr werdet nicht glauben,<br> was sie im Radio erzählt haben!
#. fr: J'ai entendu dire à la radio...
msgctxt "Balloon:7305:0:1"
msgid "I heard on the radio..."
msgstr "Слышал по радио..."

#. ja: 守護天節では<br>お菓子が配られるって！
#. de: An Allerschutzheiligen werden Süßigkeiten verteilt!
#. fr: Qu'on distribue des biscuits pour la Veillée des saints<nbsp>!
msgctxt "Balloon:7306:0:1"
msgid "They're giving out candy at All Saints' Wake!"
msgstr "На Праздник поминовения усопших раздают конфеты!"

#. ja: まだ見ぬプディングを<br>もらいに行くぞー！
#. de: Noch ungekostete Puddings erwarten uns!
#. fr: On va se régaler<nbsp>!
msgctxt "Balloon:7307:0:1"
msgid "I'm going to stuff myself with pudding!"
msgstr "Пойду наемся пудинга!"

#. ja: おー！
#. de: Juchhuu!
#. fr: Ouais<nbsp>!
msgctxt "Balloon:7308:0:1"
msgid "Me, too!"
msgstr "И я!"

#. ja: これがギルドで話題の…
#. de: Davon haben sie in der Gilde<br>also die ganze Zeit geredet<nbsp>...
#. fr: Oh, c'est ce dont ils parlaient à la guilde...
msgctxt "Balloon:7309:0:1"
msgid "Is this what the guild's been buzzing about...?"
msgstr "Это о том в гильдии все говорят?.."

#. ja: ちょ、ちょっと怖いかも…！
#. de: Etwas zu gruselig für meinen Geschmack<nbsp>...
#. fr: J-j'ai peur...
msgctxt "Balloon:7310:0:1"
msgid "I can't look!"
msgstr "Не могу смотреть!"

#. ja: 妖異の匂いがするような…
#. de: Irre ich mich?
#. fr: Ça sent la créature du néant, par ici...
msgctxt "Balloon:7311:0:1"
msgid "A voidsent is close, I can smell it..."
msgstr "Чую, поблизости бездна..."

#. ja: アタイの勘違いか？
#. de: Spüre ich da etwa Nichts<shy>gesand<shy>te<nbsp>...
#. fr: C'est peut-être juste une impression<nbsp>?
msgctxt "Balloon:7312:0:1"
msgid "Of course, it could be something else..."
msgstr "Хотя, может, мне просто показалось..."

#. ja: 守護天節の陰に妖異あり…
#. de: Im Schatten der Festivitäten.
#. fr: Ici, pendant la Veillée des saints...
msgctxt "Balloon:7313:0:1"
msgid "To think there could be monsters lurking about..."
msgstr "Кто бы мог подумать, что среди праздника затаились чудовища..."

#. ja: 成り立ちを知れば<br>なにかわかるでしょう
#. de: Das schreit nach Geisterjagd<nbsp>...
#. fr: Il faut tirer les choses au clair<nbsp>!
msgctxt "Balloon:7314:0:1"
msgid "Not surprising, considering the origins of this occasion..."
msgstr "Ничего удивительного, если вспомнить, с чего начался этот праздник..."

#. ja: お菓子を渡せばいいらしいな
#. de: Man muss wohl nur<br>ein paar Süßigkeiten vorbeibringen!
#. fr: Il paraît qu'en offrant des biscuits...
msgctxt "Balloon:7315:0:1"
msgid "I've heard he goes wild for cookies."
msgstr "Слышал, он от печенек просто с ума сходит."

#. ja: 怖いけど、気になっちゃう…
#. de: Ich will zwar, aber ich trau mich nicht<nbsp>...
#. fr: J'ai peur, mais j'ai aussi envie d'essayer...
msgctxt "Balloon:7316:0:1"
msgid "I'm scared, but I can't look away..."
msgstr "Мне страшно, но я не могу отвести взгляд..."

#. ja: わ、私も…
#. de: A-Als ob ich Angst hätte<nbsp>... Quatsch!
#. fr: Oui, moi aussi...
msgctxt "Balloon:7317:0:1"
msgid "I know what you mean..."
msgstr "Понимаю, о чём ты..."

#. ja: 変わった催しだね
#. de: Was für ein seltsames Fest<nbsp>...
#. fr: Quel spectacle étrange...
msgctxt "Balloon:7319:0:1"
msgid "Quite the odd spectacle..."
msgstr "Странное зрелище..."

#. ja: 弟たちも喜ぶだろうか
#. de: Meine Brüder werden sich sicherlich freuen!
#. fr: Je suis sûr que mes frères adoreraient.
msgctxt "Balloon:7320:0:1"
msgid "My brothers will love this."
msgstr "Братьям это понравится."

#. ja: 魔物が現れたと聞いたが…<br>催しと勘違いしたんだな
#. de: Ich hatte von Monstern in der Stadt gehört<nbsp>...<br>War wohl falscher Alarm!
#. fr: Ces fameux “monstres” n'étaient qu'une partie du spectacle...
msgctxt "Balloon:7321:0:1"
msgid "I heard rumors of monsters about, but it turns out it was all part of the festivities."
msgstr "Я слышал слухи о чудовищах, но оказалось, это часть праздничного представления."

#. ja: パパ楽しそうね～
#. de: Gevatter Pierrot sieht so glücklich aus<nbsp>...
#. fr: Papa a l'air de bien s'amuser<nbsp>!
msgctxt "Balloon:7322:0:1"
msgid "Papa Gruff seems to be having so much fun!"
msgstr "Папа Груфф так веселится!"

#. ja: 僕もヒトに感謝されたーい！
#. de: Ich will auch was von diesem „Dank“ haben!
#. fr: Moi aussi, je veux recevoir des biscuits<nbsp>!
msgctxt "Balloon:7323:0:1"
msgid "Maybe being liked isn't so bad after all!"
msgstr "Может, быть любимцем не так уж плохо!"

#. ja: 温かな食事を…
#. de: Etwas Warmes für den Magen!
#. fr: De bons repas bien chauds...
msgctxt "Balloon:7324:0:1"
msgid "Thank goodness for warm meals..."
msgstr "Хорошо, что есть горячая еда..."

#. ja: ガレマルドの被害状況は…
#. de: Wie steht es um die Schäden?
#. fr: L'estimation des dégâts n'arrête pas de grimper...
msgctxt "Balloon:7325:0:1"
msgid "The damage to the city is even more extensive than we thought..."
msgstr "Город пострадал куда сильнее, чем мы думали..."

#. ja: 再利用可能な資源の<br>洗い出しも…
#. de: Das kann man auch noch verwerten<nbsp>...
#. fr: Je me prends à rêver d'énergies renouvelables...
msgctxt "Balloon:7326:0:1"
msgid "What other materials might be reusable...?"
msgstr "Какие ещё материалы можно использовать повторно?.."

#. ja: このところ青燐水の供給が<br>安定しているな
#. de: Die Erdseimsituation hat sich stabilisiert.
#. fr: Nos réserves de céruleum se sont stabilisées, récemment.
msgctxt "Balloon:7327:0:1"
msgid "Our ceruleum stores are in good shape of late."
msgstr "В последнее время запас церулеума у нас в порядке."

#. ja: 何をもらったの？
#. de: Was hast du bekommen?
#. fr: T'as eu quoi comme cadeaux<nbsp>?
msgctxt "Balloon:7328:0:1"
msgid "What did you get for Starlight?"
msgstr "Что тебе на Звёздный праздник подарили?"

#. ja: 一緒に遊ぼうよ！
#. de: Lasst uns zusammen spielen!
#. fr: Allons jouer ensemble<nbsp>!
msgctxt "Balloon:7329:0:1"
msgid "Let's all play together!"
msgstr "Давайте играть вместе!"

#. ja: 星芒祭のトナカイですよ～！
#. de: Hier seht ihr eines der Rentiere des Sternenlichtfests!
#. fr: Le fameux renne de la fête des étoiles est de retour<nbsp>!
msgctxt "Balloon:7330:0:1"
msgid "Witness the miracle of Starlight illusions!"
msgstr "Станьте свидетелями чуда иллюзий Звёздного праздника!"

#. ja: いっぱいあるね！
#. de: Woah, so viele Geschenke!
#. fr: Tout plein de cadeaux, waouh<nbsp>!
msgctxt "Balloon:7331:0:1"
msgid "So many lovely presents!"
msgstr "Сколько подарков, и все такие чудесные!"

#. ja: お金じゃ手に入らない<br>贈り物もあるのか
#. de: Ob da was dabei ist, was man sich sonst nicht kaufen kann?
#. fr: Si j'étais riche... Moi aussi j'en achèterais autant<nbsp>!
msgctxt "Balloon:7332:0:1"
msgid "Not all gifts are gained with gil."
msgstr "Не каждый подарок купишь за гил."

#. ja: 空力団のみんなは<br>星芒祭に興味あるかな？
#. de: Ob die Wolkengleiter wohl Interesse am Sternenlichtfest haben?
#. fr: Je me demande si les Planeurs d'Ehcatl aimeraient cette fête...
msgctxt "Balloon:7333:0:1"
msgid "I wonder if the Ehcatl Nine would enjoy the Starlight Celebration..."
msgstr "Интересно, понравится ли Экатльской девятке Праздник звёздного света..."

#. ja: ど、どう声をかけようかね…
#. de: W-Wie sollte ich ihn am besten ansprechen<nbsp>...
#. fr: Comment l'approcher<nbsp>? Hmm...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7334:0:1"
msgid "What's <i>'e</i> doin' 'ere, the blithe bastard!?"
msgstr "Да что он тут делает-то, этот самодовольный <i>з</i>асранец?!"

#. ja: まさか私の首を狙いに？
#. de: Warum starrt Rhoswen die ganze Zeit hier her?
#. fr: Elle est là pour la fête... ou pour ma tête<nbsp>?
msgctxt "Balloon:7335:0:1"
msgid "Is she here for celebration or assassination...?"
msgstr "Она пришла на праздник... или за моей головой?"

#. ja: これは何の資料かしら…？
#. de: Hm? Was ist das denn für ein Schrieb?
#. fr: D'où vient ce document, déjà<nbsp>?
msgctxt "Balloon:7336:0:1"
msgid "What do we have here...?"
msgstr "Что у нас тут?.."

#. ja: あら、どうしたの？
#. de: Ojika! Was ist los?
#. fr: Tiens<nbsp>? Que se passe-t-il<nbsp>?
msgctxt "Balloon:7337:0:1"
msgid "Oh? What is it, Ojika?"
msgstr "Ой? Что случилось, Оджика?"

#. ja: もう少しだけ<br>頑張ろうっと！
#. de: Ja, gleich. Nur noch dieses eine Dokument.
#. fr: Encore un petit effort<nbsp>!
msgctxt "Balloon:7338:0:1"
msgid "Just a little bit longer!"
msgstr "Ещё чуть-чуть!"

#. ja: ほー、面白いな
#. de: Oho, interessant<nbsp>...
#. fr: Vrrraiment passionnant...
msgctxt "Balloon:7339:0:1"
msgid "Fascinating..."
msgstr "Удивительно..."

#. ja: って、違う…！
#. de: Ah, <split " " 1><string $gs1></split>?!
#. fr: Ah, tu m'as fait peurrr<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "Balloon:7340:0:1"
msgid "<split \" \" 1><string $gs1></split>!?"
msgstr "<split \" \" 1><string $gs1></split>!?"

#. ja: 中を確認してただけだ！<br>読みふけってなんか…！
#. de: I-Ich habe das Buch nur rasch durchgeblättert, ich schwör's!
#. fr: J-je travaille sé<shy>rieu<shy>se<shy>ment, c'est jurrré<nbsp>!
msgctxt "Balloon:7341:0:1"
msgid "I-I saw you there, I assure you!"
msgstr "Я-я просто увидел тебя, вот и всё! Честное слово!"

#. ja: 休憩しなくていい？<br>あとで僕も手伝うよぉ～
#. de: Magst du nicht eine kleine Pause einlegen? Danach helfe ich dir gern.
#. fr: Pense à prendre une pause bientôt<nbsp>! Je te donnerai un coup de main après.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7342:0:1"
msgid "Why not take a short break?<br>I'd be happy to assist afterwards."
msgstr "Может, передохнёшь немного?<br>Потом я с радостью помогу."

#. ja: ほしいものはあるか？
#. de: Wünschst du dir etwas Bestimmtes?
#. fr: Approchez<nbsp>! Vos cadeaux vous attendent<nbsp>!
msgctxt "Balloon:7343:0:1"
msgid "Come an' get yer Starlight presents!"
msgstr "Подходите, за подарками на Звёздный праздник!"

#. ja: 遠慮しないで
#. de: Keine Bescheidenheit, ja?
#. fr: Ne te rrretiens pas, fonce<nbsp>!
msgctxt "Balloon:7344:0:1"
msgid "Go on, then!"
msgstr "Ну же, смелее!"

#. ja: 贈り物がもらえたら<br>日記帳に書きたいな
#. de: Ich werde eine ganze Seite meines Tagebuchs meinem Geschenk widmen!
#. fr: Si je reçois un cadeau, faudra que je le note dans mon jourrrnal<nbsp>!
msgctxt "Balloon:7345:0:1"
msgid "If Khloe gets a gift, Khloe's gonna write a whole page about it in her journal..."
msgstr "Если Хлоя получит подарок, Хлоя целую страницу о нём в дневнике напишет..."

#. ja: 今を生きる誰かに宛てた<br>感謝の手紙か…
#. de: So viele Briefe der Dankbarkeit und Wertschätzung<nbsp>...
#. fr: Tant de messages de gratitude, c'est si beau...
msgctxt "Balloon:7346:0:1"
msgid "So many letters of gratitude..."
msgstr "Столько писем с благодарностями..."

#. ja: 俺たちも出そうか<br>お世話になった人にさ
#. de: Ich sollte meine Dankbarkeit auch öfter zum Ausdruck bringen<nbsp>...
#. fr: Je devrais écrire plus souvent à ceux qui me sont chers...
msgctxt "Balloon:7347:0:1"
msgid "I should write something too. Gods know I owe lots of people."
msgstr "Мне тоже надо бы написать. Столько людей, которым я обязан."

#. ja: 被害状況は…
#. de: Wie ist die Lage?
#. fr: Alors, comment ça se présente<nbsp>?
msgctxt "Balloon:7348:0:1"
msgid "Do you have aught to report?"
msgstr "Есть новости?"

#. ja: まだ目覚めない<br>獄卒もいてね
#. de: Es gibt noch Kerkermeister, die nicht erwacht sind.
#. fr: De nombreux geôliers sont toujours inconscients.
msgctxt "Balloon:7349:0:1"
msgid "We must free the rest of our colleagues."
msgstr "Надо освободить остальных наших товарищей."

#. ja: 結界は<br>無事に張り直せたな
#. de: Der Bannkreis steht.
#. fr: La barrière est de nouveau intacte.
msgctxt "Balloon:7350:0:1"
msgid "Pandæmonium's protective wards have been restored."
msgstr "Защитные печати Пандемониума восстановлены."

#. ja: アテナめ<br>このような空間を…
#. de: Es ist genau wie Athena es wollte.
#. fr: Quand je pense qu'Athéna a aménagé ce laboratoire à notre insu...
msgctxt "Balloon:7351:0:1"
msgid "That Athena would build all this..."
msgstr "Вот, значит, что построила Афина..."

#. ja: この空間以外にも<br>何か残されているかも…
#. de: Da ist aber noch mehr ...
#. fr: S'il n'y avait que ça...
msgctxt "Balloon:7352:0:1"
msgid "This isn't all she's left behind."
msgstr "Наверняка она оставила ещё что-то."

#. ja: 待たせたな！<br>アイツらは？
#. de: Wo sind die anderen?
#. fr: Tout est prêt<nbsp>! On est au complet<nbsp>?
msgctxt "Balloon:7353:0:1"
msgid "Where're the others?"
msgstr "А остальные где?"

#. ja: どこかに隠れているさ<br>探しにいこう！
#. de: Sie verstecken sich irgendwo<nbsp>- finden wir sie!
#. fr: On joue à cache-cache<nbsp>?
msgctxt "Balloon:7354:0:1"
msgid "They're hiding somewhere. Let's go find 'em!"
msgstr "Где-то прячутся. Пойдём поищем!"

#. ja: ふふ…<br>すぐに見つかっちゃうかしら？
#. de: Wie lange es wohl dauert, bis sie uns finden?
#. fr: Hihihi<nbsp>! J'espère avoir trouvé une bonne cachette...
msgctxt "Balloon:7355:0:1"
msgid "How long before they find us, you think?"
msgstr "Интересно, сколько им понадобится, чтобы нас найти?"

#. ja: 兄貴は僕らのこと<br>よくわかってるからなぁ…
#. de: Nun, sie kennen bereits alle guten Verstecke<nbsp>...
#. fr: Grand-frêre connaît toutes nos ruses<nbsp>!
msgctxt "Balloon:7356:0:1"
msgid "Well, they already know all the good hiding places..."
msgstr "Ну, они же знают все хорошие тайники..."

#. ja: 見つかったら<br>みんなで海に行きましょう
#. de: Wenn sie uns gefunden haben, sollten wir alle zum Strand gehen!
#. fr: Après cache-cache, on va à la plage tous ensemble<nbsp>!
msgctxt "Balloon:7357:0:1"
msgid "When they do, we should all go to the beach!"
msgstr "А когда найдут, давайте все вместе на пляж!"

#. ja: それなら星が見たいな<br>眠くなるまで、ね…
#. de: Oh, und dann können wir uns die Sterne anschauen, bis wir einschlafen!
#. fr: J'espère qu'on restera jusqu'au soir. Je voudrais m'endormir en regardant les étoiles...
msgctxt "Balloon:7358:0:1"
msgid "Ooh, and then we can look at the stars until we fall asleep!"
msgstr "О, а потом будем смотреть на звёзды, пока не уснём!"

#. ja: まさに宝の山だな…<br>いったい、いくらになるんだ？
#. de: Ein wirklich gewaltiger Schatz! Ich wage gar nicht zu schätzen, wie viel genau das sein mag<nbsp>...
#. fr: Je me demande combien ça fait en gils, cette montagne de trésors...
msgctxt "Balloon:7359:0:1"
msgid "Piles upon piles of treasure... I can scarcely imagine how much there is."
msgstr "Груды сокровищ... Даже представить не могу, сколько их тут."

#. ja: アレンヴァルドの坊主も<br>腕を上げたようでやすね
#. de: Scheint, als ob sich der kleine Arenvald von damals ganz schön gemacht hat.
#. fr: Eh bien, Arenvald ne rrrigole plus sur le champ de bataille<nbsp>!
msgctxt "Balloon:7360:0:1"
msgid "Arenvald has gotten stronger, hasn't he?"
msgstr "Аренвальд-то, гляжу, окреп!"

#. ja: 今の怪物…<br>人が変異したものだったのか…
#. de: Dieses Ungeheuer<nbsp>... War es das Resultat einer Ver<shy>wand<shy>lung?
#. fr: La créature que nous venons d'affronter... Était-elle humaine auparavant<nbsp>?
msgctxt "Balloon:7361:0:1"
msgid "To think that that monster used to be a man..."
msgstr "Подумать только, это чудовище когда-то было человеком..."

#. ja: ふむ、遠くに見えるは…
#. de: Freie Sicht, so weit das Auge reicht<nbsp>...
#. fr: Quel panorama à couper le souffle<nbsp>!
msgctxt "Balloon:7362:0:1"
msgid "That there in the distance..."
msgstr "А там вдали..."

#. ja: アルフィノ…
#. de: Alphinaud<nbsp>...
#. fr: Alphinaud...
msgctxt "Balloon:7363:0:1"
msgid "Please be safe, Alphinaud..."
msgstr "Пожалуйста, береги себя, Альфино..."

#. ja: 霧の如き竜であったな
#. de: Ein Drache aus Nebel, wahrlich eigenartig<nbsp>...
#. fr: Un dragon telle une brume... Hmm...
msgctxt "Balloon:7364:0:1"
msgid "That dragon was as much mist as it was flesh."
msgstr "Тот дракон был словно соткан из тумана."

#. ja: アラグの遺構に竜なんて<br>偶然とは思えないわね
#. de: Ein Drache in der Nähe allagischer Ruinen, das kann kein Zufall sein<nbsp>...
#. fr: À mon avis, la présence de ce dragon dans des vestiges allagois n'est pas due au hasard...
msgctxt "Balloon:7365:0:1"
msgid "Dragons at Allagan ruins are seldom a coincidence."
msgstr "Драконы возле аллаганских руин редко появляются просто так."

#. ja: これで攻勢を<br>押し止めることができたが…
#. de: Damit sollten wir ihren Vorstoß erstmal zurückgeschlagen haben<nbsp>...
#. fr: Nous sommes parvenus à stopper leur offensive... mais à quel prix<nbsp>?
msgctxt "Balloon:7366:0:1"
msgid "It seems we've thrown them back."
msgstr "Похоже, мы отбросили их назад."

#. ja: あら、もう打ち止めかしら？
#. de: Was, war das etwa schon alles?
#. fr: Ça y est, elles sont rentrées chez leur maman<nbsp>?
msgctxt "Balloon:7367:0:1"
msgid "Is it over already?"
msgstr "Уже всё?"

#. ja: 敵ながら<br>見事な連携であったな
#. de: Sie mögen Feinde sein, doch ihre Kampftechnik war durchaus beeindruckend.
#. fr: La coordination de nos ennemis était tout de même remarquable...
msgctxt "Balloon:7368:0:1"
msgid "Their teamwork was quite fearsome, I must allow."
msgstr "Как бы ни были они врагами, слаженность у них впечатляющая."

#. ja: レポリットのラジオ<br>おもしろいよね！
#. de: Das Radiogerät der Loporrit ist eine Wucht!
#. fr: J'adore la radio loporrite<nbsp>!
msgctxt "Balloon:7369:0:1"
msgid "That Hyper Hustle was incredible!"
msgstr "А «Гиперрывок» был просто потрясающий!"

#. ja: でも、宇宙レースは<br>さすがに作り話でしょ～
#. de: Aber das Rennen zwischen den Sternen, gibt es das wirklich?
#. fr: Moi aussi<nbsp>! Mais une courrrse dans l'espace<nbsp>? C'est délirant<nbsp>!
msgctxt "Balloon:7370:0:1"
msgid "Pure fiction, beyond a doubt."
msgstr "Тут уж точно всё выдумка."

#. ja: むにゃ…<br>レース、まだぁ…？
#. de: \<gähn> Hat das Rennen schon angefangen?
#. fr: Zzz... Ngh...<nbsp>? Ça y est<nbsp>? La course commence<nbsp>?
msgctxt "Balloon:7371:0:1"
msgid "Zzz... Forward, brave hippo..."
msgstr "Хр-р... Вперёд, отважный бегемотик..."

#. ja: うわぁ、美味しい～！<br>リスナーの情報どおりだ！
#. de: Es ist so wunderschön! Genau, wie sie im Radio gesagt haben!
#. fr: Ouah, c'est trop bon<nbsp>! Notre auditeur n'avait pas menti<nbsp>!
msgctxt "Balloon:7372:0:1"
msgid "It's just as our listeners described!"
msgstr "Всё точно как описывали наши слушатели!"

#. ja: 彼は親友を<br>止められなかったのか？
#. de: Er konnte seinen Freund nicht aufhalten<nbsp>...
#. fr: Il n'a pas réussi à arrêter son ami<nbsp>?
msgctxt "Balloon:7373:0:1"
msgid "Was there truly no other way?"
msgstr "Неужели другого выхода и правда не было?"

#. ja: ドゥランテ…<br>その魂の輝きは…
#. de: Durante<nbsp>... Dieses Leuchten<nbsp>...
#. fr: L'âme de Durante était si éblouissante...
msgctxt "Balloon:7374:0:1"
msgid "He all but set his soul aflame..."
msgstr "Он едва не воспламенил собственную душу..."

#. ja: あのふたりが<br>こんな結末を…
#. de: Dass es so enden musste<nbsp>...
#. fr: Le destin est parfois cruel...
msgctxt "Balloon:7375:0:1"
msgid "It should not have come to this."
msgstr "Не должно было всё так закончиться."

#. ja: この勝利…<br>虚しいもんだな…
#. de: Dieser Sieg<nbsp>... So bittersüß<nbsp>...
#. fr: Quelle victoire vide de sens...
msgctxt "Balloon:7376:0:1"
msgid "A bitter victory..."
msgstr "Горькая победа..."

#. ja: ラジオの感想を<br>みんなに共有しよう！
#. de: Das müssen wir unbedingt mit allen teilen!
#. fr: Il faut qu'on partage tous ces retours<nbsp>!
msgctxt "Balloon:7377:0:1"
msgid "Did you get that feedback down?"
msgstr "Записал, что слушатели думают?"

#. ja: 感想を記録して<br>送信っと…
#. de: Bin schon dabei ...
#. fr: Je m'en charge... Et voilà, c'est envoyé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7378:0:1"
msgid "Listeners...indignant...yet...<br>thrilled..."
msgstr "Слушатели... возмущены... но... в восторге..."

#. ja: 今でも充分<br>立派な橋だが…
#. de: Das ist bereits ziemlich beeindruckend.
#. fr: Même endommagé, ce pont dégage quelque chose...
msgctxt "Balloon:7379:0:1"
msgid "'Tis already quite impressive to behold."
msgstr "И так мост уже впечатляет."

#. ja: ウキャ！
#. de: Uga!
#. fr: Ouhou-ha<nbsp>!
msgctxt "Balloon:7380:0:1"
msgid "Ook!"
msgstr "Ук!"

#. ja: 木で仮組をしているのか
#. de: Sie wurde also provisorisch aus Holz gebaut.
#. fr: Certaines parties sont renforcées avec du bois.
msgctxt "Balloon:7381:0:1"
msgid "So it's temporarily constructed with wood."
msgstr "Значит, пока что его скрепили деревом."

#. ja: 潮風が気持ちいいな
#. de: Ah, welch eine erfrischende Brise<nbsp>...
#. fr: Le vent marin est si vivifiant...
msgctxt "Balloon:7382:0:1"
msgid "Ah, such an invigorating breeze..."
msgstr "Ах, какой свежий бриз..."

#. ja: ウキ～～
#. de: Uga, uga!
#. fr: Ouhou haha<nbsp>!
msgctxt "Balloon:7383:0:1"
msgid "Ook, ook!"
msgstr "Ук-ук!"

#. ja: ああ、本当に…
#. de: Oh, Ætheris<nbsp>...
#. fr: Aaah, Ætherys...
msgctxt "Balloon:7384:0:1"
msgid "Oh, Etheirys..."
msgstr "Ах, Этериса..."

#. ja: この星の愛しさを<br>何と言ったらいいのか…
#. de: Deine Schönheit kennt wahrlich keine Grenzen.
#. fr: Ta beauté est sans pareille...
msgctxt "Balloon:7385:0:1"
msgid "Your beauty truly knows no bounds."
msgstr "И слов не подобрать, как прекрасна ты."

#. ja: すまない<br>つい考え込んでしまったな
#. de: Verzeihung, ich war in Gedanken versunken.
#. fr: Excuse-moi, j'étais perdu dans mes pensées.
msgctxt "Balloon:7386:0:1"
msgid "Forgive me, I was lost in thought."
msgstr "Прости, задумался."

#. ja: この橋が完成するのを<br>楽しみにしている
#. de: Ich freue mich auf die Vollendung der Brücke.
#. fr: J'ai hâte que Le Lien d'Oschon retrouve toute sa superbe.
msgctxt "Balloon:7387:0:1"
msgid "I look forward to the bridge's completion."
msgstr "Жду не дождусь, когда мост достроят."

#. ja: うふふ、ようこそ…<br>「ストレイバロー」へ…！
#. de: Willkommen im schaurig-schönen Mahrlingen<nbsp>...
#. fr: Hin hin hin... Bienvenue au Parc-aux-Errants<nbsp>!
msgctxt "Balloon:7388:0:1"
msgid "Strayborough welcomes you."
msgstr "Добро пожаловать в Стрейборо."

#. ja: いってらっしゃい<br>悪夢の中へ…
#. de: ... Wo wir Vergessenen unser Ständchen singen!
#. fr: Pénétrez dans un monde de cauchemars<nbsp>!
msgctxt "Balloon:7389:0:1"
msgid "Pleasant dreams..."
msgstr "Сладких снов..."

#. ja: うふ…ふふ…<br>もう、帰れない…
#. de: Ein Schritt, ein Tritt, ein ewiger Ritt!
#. fr: Hin hin... hin... Il n'y a aucune issue...
msgctxt "Balloon:7390:0:1"
msgid "Hee hee... I'll never go home again!"
msgstr "Хи-хи... Я больше никогда не вернусь домой!"

#. ja: ねえねえ…<br>楽しく遊んでる…？
#. de: Spaß am Grusel und Gewusel!
#. fr: Alors... vous vous amusez bien<nbsp>?
msgctxt "Balloon:7391:0:1"
msgid "Are you not entertained?"
msgstr "Ну что, вам весело?"

#. ja: 遊ぼう、遊ぼう<br>消えるまで…
#. de: Spielen ganz ohne Verdruss, sonst gibts keinen Abschiedskuss!
#. fr: Jouons, jouons... Jusqu'à ce qu'on disparaisse tous...
msgctxt "Balloon:7392:0:1"
msgid "We'll never find our way, forever we are stray!♪"
msgstr "Будем играть, играть... Пока не исчезнем..."

#. ja: 素敵なお土産…<br>見ていかない？
#. de: Andenken für Jedermann, sogar mit Autogramm!
#. fr: Et si vous rapportiez d'horribles souvenirs à vos amis<nbsp>?
msgctxt "Balloon:7393:0:1"
msgid "I want souvenirs! I want to...remember..."
msgstr "Хочу сувенир! Хочу... запомнить..."

#. ja: ぐるぐる…ぐるぐる…
#. de: Dreh und schwing und dreh und schwing<nbsp>...
#. fr: Tournicoti... Tournicoton...
msgctxt "Balloon:7394:0:1"
msgid "Up and down and all around..."
msgstr "Вверх и вниз, кругом и вокруг..."

#. ja: おやおや迷子？<br>一生ずっと帰れない…！
#. de: Verirrt auf der Promenade, ein kleines Mäuschen auf falschem Pfade!
#. fr: Vous êtes perdus, mes petits anges<nbsp>? Vous ne pourrez plus jamais rentrer chez vous<nbsp>!
msgctxt "Balloon:7395:0:1"
msgid "Are you lost? Wonderful! So are we!"
msgstr "Потерялись? Вот и мы тоже!"

#. ja: やーい<br>お菓子でべちゃべちゃ～
#. de: Süß, salzig, kunterbunt, ich hab was für jeden Mund!
#. fr: Attention aux caries, hihi<nbsp>!
msgctxt "Balloon:7396:0:1"
msgid "Refreshments, on the house!"
msgstr "Угощайтесь, за счёт заведения!"

#. ja: たくさん食べてね～<br>ケヒッ…ヒヒッ…
#. de: Hau rein, du Schwein! Kehihahaha!
#. fr: Vous reprendrez bien un peu de sucre<nbsp>? Hi hi...
msgctxt "Balloon:7397:0:1"
msgid "Yes, yes! Feast to your heart's content!"
msgstr "Да-да! Ешьте на здоровье!"

#. ja: ゴルベーザ様！
#. de: Golbez!
#. fr: Seigneur Golbez<nbsp>!
msgctxt "Balloon:7398:0:1"
msgid "Lord Golbez!"
msgstr "Господин Голбез!"

#. ja: おお、ドゥランテ様も！
#. de: Und Durante! Es ist gut, euch beide zurückzuhaben!
#. fr: Oh, et le seigneur Durante<nbsp>!
msgctxt "Balloon:7399:0:1"
msgid "And Lord Durante too!"
msgstr "И лорд Дюранте тоже!"

#. ja: ゴルベーザ様だ！<br>これで勝てる…！
#. de: Das ist doch Golbez!<br>Der Sieg wird unser sein!
#. fr: C'est le seigneur Golbez<nbsp>! Nous sommes sauvés<nbsp>!
msgctxt "Balloon:7400:0:1"
msgid "Hope is not yet lost!"
msgstr "Надежда ещё не потеряна!"

#. ja: 英雄が帰ってきたぞ！
#. de: Unser Held ist wieder da!
#. fr: Notre héros est de retour<nbsp>!
msgctxt "Balloon:7401:0:1"
msgid "Our saviors have returned!"
msgstr "Наши спасители вернулись!"

#. ja: カッパッパー！
#. de: Plitschplatsch!
#. fr: Kappappaaa !
msgctxt "Balloon:7402:0:1"
msgid "Ka-pa-paaa!"
msgstr "Ка-па-пааа!"

#. ja: セニョール・サボテンダーも<br>負けてられないな…！
#. de: Hmpf, als ob jemand gegen Señor Kaktor ankommen könnte ...!
#. fr: Bah, le Señor Pampa a quand même plus de classe... !
msgctxt "Balloon:7403:0:1"
msgid "These imps don't hold a candle to Senor Sabotender...!"
msgstr "Этим чертям до сеньора Саботендера далеко..."

#. ja: お詫びにディナーでも…
#. de: Ein Abendessen als Entschuldigung?
#. fr: ... Un dîner, pour m'excuser<nbsp>?
msgctxt "Balloon:7404:0:1"
msgid "Please, my darling, won't you let me take you to dinner?"
msgstr "Позволь же мне, любимая, загладить вину и пригласить тебя на ужин!"

#. ja: しょうがないなあ、もう
#. de: Habe ich wirklich eine Wahl?
#. fr: Ai-je vraiment le choix<nbsp>?
msgctxt "Balloon:7405:0:1"
msgid "Oh fine, if you insist..."
msgstr "Ну ладно, раз уж ты настаиваешь..."

#. ja: ああやって誘うのか…！
#. de: Jetzt oder nie ...!
#. fr: Si je dois l'inviter, c'est maintenant ou jamais<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7406:0:1"
msgid "So <i>that's</i> how you do it..."
msgstr "Вот, <i>значит</i>, как надо..."

#. ja: 勇気を出さなきゃ…！
#. de: Los, nimm deinen Mut zusammen!
#. fr: Allez... Un peu de courage, bon sang<nbsp>!
msgctxt "Balloon:7407:0:1"
msgid "Here goes nothing..."
msgstr "Ну, была не была..."

#. ja: ドキドキ…
#. de: Mein Herz explodiert gleich ...
#. fr: Oh là là, j'ai le cœur qui va exploser...
msgctxt "Balloon:7408:0:1"
msgid "M-Milady?"
msgstr "М-миледи?"

#. ja: 立派な愛の伝道師になるんだぞ…
#. de: Sie wird mal eine großartige Liebesbotin werden!
#. fr: C'est une messagère de l'amour pur jus ou j'm'y connais pas<nbsp>!
msgctxt "Balloon:7409:0:1"
msgid "She'll make a fine emissary of love yet."
msgstr "Из неё ещё выйдет славная посланница любви."

#. ja: エミリエちゃん頑張ってるわね！
#. de: Emilie ist einfach toll!
#. fr: Emilie est vraiment super, pas vrai<nbsp>?
msgctxt "Balloon:7410:0:1"
msgid "Emilie's giving it her all!"
msgstr "Эмили старается изо всех сил!"

#. ja: カッパ　ともだち　ともだち！
#. de: Flusskobolde sind gute Freunde! \<blubber>
#. fr: Kappa<nbsp>! Mon pote<nbsp>!
msgctxt "Balloon:7411:0:1"
msgid "Imps! My buddies! My pals!"
msgstr "Импы! Друзья! Дружбаны!"

#. ja: 旅の途中に寄ったんだが…<br>まさか君もいるとは
#. de: Welch eine Überraschung, dass wir diesen Ort zur gleichen Zeit aufsuchen<nbsp>...
#. fr: Moi qui ne faisais que passer au détour de mes voyages... Quelle surprise de te trouver ici.
msgctxt "Balloon:7412:0:1"
msgid "Well now, that we should visit this place at the same time..."
msgstr "Вот так встреча... И ты сюда заглянул."

#. ja: 君も、この祝福機構も<br>変わりがないようで何よりだ
#. de: Mit dem Segen ist alles in Ordnung, und ich hoffe, das gilt auch für dich.
#. fr: Je suis rassuré de constater que tu te portes à merveille, au même titre que la bénédiction des Douze.
msgctxt "Balloon:7413:0:1"
msgid "All is well with the instrument, and I trust 'tis likewise with you."
msgstr "Рад видеть, что и благословляющий механизм в порядке, и ты, надеюсь, тоже."

#. ja: じゃあ、またどこかで
#. de: Pass auf dich, <if $gn4>meine Freundin<else>mein Freund</if>. Bis zum nächsten Mal.
#. fr: À bientôt, mon <if $gn4>amie<else>ami</if>. Au plaisir de te recroiser, ici ou ailleurs.
msgctxt "Balloon:7414:0:1"
msgid "Take care, my friend. Till next we meet."
msgstr "Береги себя, друг. До новой встречи."

#. ja: ねえ、見つかった～？
#. de: Hast du schon welche gefunden?
#. fr: Alors, tu en as trouvé<nbsp>?
msgctxt "Balloon:7415:0:1"
msgid "Find anything yet?"
msgstr "Ну что, нашёл что-нибудь?"

#. ja: 来てくれてありがとう！
#. de: Danke fürs Kommen!
#. fr: Merci à tous d'être venus<nbsp>!
msgctxt "Balloon:7416:0:1"
msgid "Thank you for coming!"
msgstr "Спасибо, что пришли!"

#. ja: 楽しんでいってくださいね！
#. de: Macht alle mit!
#. fr: J'espère que vous passez tous un bon moment<nbsp>!
msgctxt "Balloon:7417:0:1"
msgid "We hope you enjoy yourselves!"
msgstr "Надеемся, вам будет весело!"

#. ja: この後はグゥーブーの登場よ！
#. de: Danach ist die Goobbue dran!
#. fr: Le clou du spectacle commence bientôt <nbsp>!
msgctxt "Balloon:7418:0:1"
msgid "Next is the main attraction!"
msgstr "А дальше — главное зрелище!"

#. ja: プリンセスデーは<br>まだまだ続くわよ！
#. de: Genießt das Prinzessinnenfest!
#. fr: La fête des demoiselles est loin d'être finie<nbsp>!
msgctxt "Balloon:7419:0:1"
msgid "Little Ladies' Day is far from over!"
msgstr "День маленьких дам ещё не закончился!"

#. ja: お楽しみに
#. de: Viel Spaß!
#. fr: Vous allez voirrr, c'est incroyable<nbsp>!
msgctxt "Balloon:7420:0:1"
msgid "It'll be eggcellent!"
msgstr "Будет яйцекрутительно!"

#. ja: もっと盛り上がっていくわよ
#. de: Es gibt noch viel zu sehen!
#. fr: Et n'oubliez pas d'applaudir bien forrrt<nbsp>!
msgctxt "Balloon:7421:0:1"
msgid "Things are just heating up!"
msgstr "Самое веселье ещё впереди!"

#. ja: うおおお！ウララちゃーん！
#. de: Wahnsinn! Ulalaaa!
#. fr: Woaaah<nbsp>! Ulala<nbsp>!!!
msgctxt "Balloon:7422:0:1"
msgid "Ulala! Look at me!"
msgstr "Улала! Смотри на меня!"

#. ja: カワイ～！
#. de: Sie ist sooo toll!
#. fr: Elles sont trop adorables<nbsp>!
msgctxt "Balloon:7423:0:1"
msgid "Such grace!"
msgstr "Какая грация!"

#. ja: ノリがいいね！<br>ホー！　ホー！
#. de: Voller Energie, so gehört sich das! Woo! Woo!
#. fr: J'adorrre leur énergie<nbsp>! Wou hou<nbsp>!
msgctxt "Balloon:7424:0:1"
msgid "Yes, woo! Woo, I say!"
msgstr "Вот так! Уху! Уху, говорю!"

#. ja: もちもちしてる！
#. de: So weich und elastisch!
#. fr: On dirait des guimauves sur pattes<nbsp>!
msgctxt "Balloon:7425:0:1"
msgid "Three cheers for the Beans!"
msgstr "Трижды ура бобам!"

#. ja: くぅ～！<br>あと一歩だったのに！
#. de: Verdammt! So kurz vor dem Ziel!
#. fr: Argh...<nbsp>! J'étais à deux doigts de choper la couronne<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7426:0:1"
msgid "I was mere ilms away from the crown... <i>Ilms</i>, I tell you!"
msgstr "До короны оставался всего илм... <i>Илм</i>, говорю вам!"

#. ja: もう1回チャレンジよ！
#. de: Versuch es nochmal! Diesmal schaffst du es bestimmt!
#. fr: La prrrochaine fois sera la bonne<nbsp>!
msgctxt "Balloon:7427:0:1"
msgid "There's always next time!"
msgstr "Ещё успею в следующий раз!"

#. ja: ホー！　ホホー！
#. de: Woo! Wohoo!
#. fr: Wou<nbsp>! Wou hou<nbsp>!
msgctxt "Balloon:7428:0:1"
msgid "Woo! Woo-woo!"
msgstr "Уху! Уху-уху!"

#. ja: ペグ～
#. de: Pegwiii!
#. fr: Peg, peg<nbsp>!
msgctxt "Balloon:7429:0:1"
msgid "\\<plip>"
msgstr ""

#. ja: そうか<br>今は祝祭の時期だったか
#. de: Ach ja, es wird ja gefeiert.
#. fr: Oh, c'est vrai<nbsp>! La chasse aux Prœufs a commencé<nbsp>!
msgctxt "Balloon:7430:0:1"
msgid "Ah, of course... It seems the celebrations are underway."
msgstr "А, точно... Праздник уже начался."

#. ja: ワン、ツー！<br>スリー、フォー！
#. de: Eins, zwei, drei, vier!
#. fr: Un, deux<nbsp>! Trois et quatre<nbsp>!
msgctxt "Balloon:7431:0:1"
msgid "And one! And two! And three! And four!"
msgstr "И раз! И два! И три! И четыре!"

#. ja: オグルさん<br>お上手ですねーっ！
#. de: Ogul, du macht das wirklich fantastisch!
#. fr: Vous vous débrouillez super bien<nbsp>!
msgctxt "Balloon:7432:0:1"
msgid "It's like you were born to hop!"
msgstr "Да ты будто всю жизнь прыгал!"

#. ja: ヨルダンスもいいけど<br>これも楽しいな！
#. de: Das ist ja fast lustiger als der Yol-Tanz!
#. fr: Sympa<nbsp>! Ça me change de la danse des yols<nbsp>!
msgctxt "Balloon:7433:0:1"
msgid "Grandmother trained me in the yol dance!"
msgstr "Бабушка научила меня танцевать танец йолов!"

#. ja: 姉ちゃんは<br>踊りも得意なんだなぁ…
#. de: Wie anmutig sie ist!
#. fr: C'est aussi une danseuse émérite<nbsp>!
msgctxt "Balloon:7434:0:1"
msgid "A curious way to train..."
msgstr "Странный способ тренироваться..."

#. ja: グルルルル…
#. de: \<schnarch>
#. fr: Grrrrr...
msgctxt "Balloon:7436:0:1"
msgid "Grrr..."
msgstr "Гррр..."

#. ja: Ｚｚｚ…
#. de: Zzz ...
#. fr: Rrrhooon...
msgctxt "Balloon:7437:0:1"
msgid "Zzz..."
msgstr "Хр-р-р..."

#. ja: …………ぐぅ…
#. de: Zzz ... \<schnarch>
#. fr: Pchiouuuu...
msgctxt "Balloon:7438:0:1"
msgid "Zzz... \\<snort>"
msgstr ""

#. ja: やった～シャバだ～～！
#. de: Ha! Endlich frei!
#. fr: Ouais<nbsp>! Enfin libéré, délivré<nbsp>!
msgctxt "Balloon:7439:0:1"
msgid "Haha! Free at last!"
msgstr "Ха! Наконец-то на свободе!"

#. ja: 隠れて！
#. de: Versteck dich!
#. fr: Cachez-vous, ja<nbsp>!
msgctxt "Balloon:7440:0:1"
msgid "Hide!"
msgstr "Прячься!"

#. ja: 尾行を<br>まこうとしてるつもり？
#. de: <i>Will</i> er uns loswerden?
#. fr: Il a l'intention de nous semer<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7441:0:1"
msgid "Is he <i>trying</i> to get rid of us?"
msgstr "Он <i>и правда</i> пытается от нас избавиться?"

#. ja: 尾行には気をつけろって<br>言われてたなぁ…
#. de: Mir darf auch keiner folgen<nbsp>...
#. fr: Faut que je fasse gaffe à pas être suivi...
msgctxt "Balloon:7442:0:1"
msgid "Got to make sure I ain't bein' followed..."
msgstr "Надо убедиться, что за мной никто не следит..."

#. ja: とりあえずここを<br>一周しておこう！
#. de: Lieber einmal zu viel umgesehen als einmal zu wenig.
#. fr: Hop, une p'tite pause pour brouiller les pistes<nbsp>!
msgctxt "Balloon:7443:0:1"
msgid "Better have a look around first!"
msgstr "Для начала осмотримся!"

#. ja: 気のせい、だよな…？
#. de: Ich könnte schwören, ich hätte etwas gehört<nbsp>...
#. fr: Je jurerais qu'on me suit...
msgctxt "Balloon:7444:0:1"
msgid "Coulda sworn I heard somethin'..."
msgstr "Показалось, наверное..."

#. ja: うわぁああ！？<br>なんでここに！
#. de: Argh! Man ist mir gefolgt!
#. fr: Vous<nbsp>! Je vous reconnais<nbsp>!
msgctxt "Balloon:7445:0:1"
msgid "Agh! I've been followed!"
msgstr "А-а-а! За мной следили!"

#. ja: おなか空いてくる…
#. de: Ah, langsam knurrt mir der Magen.
#. fr: J'ai tellement faim, ja...
msgctxt "Balloon:7446:0:1"
msgid "This looks delicious..."
msgstr "Как же вкусно выглядит..."

#. ja: 美味そうだが<br>どう調理すればいいのか…
#. de: Köstlich sehen sie ja aus, aber wie bereitet man sie zu?
#. fr: Ça a l'air délicieux, mais aucune idée de comment ça se prépare...
msgctxt "Balloon:7447:0:1"
msgid "How would we prepare it?"
msgstr "И как бы нам это приготовить?"

#. ja: 店長さんに聞いてみる？
#. de: Fragen wir doch den Meister selbst?
#. fr: On peut demander, tu ne crrrois pas<nbsp>?
msgctxt "Balloon:7448:0:1"
msgid "Let's ask for a recipe."
msgstr "Давайте спросим рецепт."

#. ja: あとを追うよ！
#. de: Ihm nach!
#. fr: Suivons-le<nbsp>!
msgctxt "Balloon:7449:0:1"
msgid "After him!"
msgstr "За ним!"

#. ja: そういえば<br>捕まったほかの仲間は…？
#. de: Warte, was ist mit den anderen passiert?
#. fr: Au fait, pourquoi ils ont pas relâché les autres...<nbsp>?
msgctxt "Balloon:7450:0:1"
msgid "Hang on, what happened to the others who got caught?"
msgstr "Постой, а что с остальными пленниками?"

#. ja: まぁいいや、帰ろう！
#. de: Ach, nicht mein Problem. Zeit, zurückzugehen!
#. fr: Bah, j'ai de la veine, c'est tout<nbsp>!
msgctxt "Balloon:7451:0:1"
msgid "Pfft, not my problem, I suppose! Time to head back!"
msgstr "Да ну, не моя забота. Пора возвращаться!"

#. ja: よし、誰もいない！
#. de: Gut, keiner da!
#. fr: Héhé, comme prévu, ils sont tous planqués<nbsp>!
msgctxt "Balloon:7452:0:1"
msgid "Looks like I'm not being followed."
msgstr "Похоже, за мной никто не следит."

#. ja: 隠れながら進めば<br>気づかれなさそうだね！
#. de: Wenn wir gut versteckt bleiben, wird er uns nicht sehen!
#. fr: Ce n'est pas le couteau le plus aiguisé du tiroir...
msgctxt "Balloon:7453:0:1"
msgid "He won't be able to spot us if we keep hidden!"
msgstr "Если будем красться и прятаться, он нас не заметит!"

#. ja: チーワグー、チガウ！<br>オマエ、誰ダッ！？
#. de: Kein Chirwagur? Wer dann?!
#. fr: Toi...<nbsp>! Tu n'es PAS Chirwagur<nbsp>! Qui alors<nbsp>?
msgctxt "Balloon:7454:0:1"
msgid "Not Chirwagur... Then who!?"
msgstr "Не Чирвагуру... Тогда кто!?"

#. ja: 大蛇様ニ祈ルンダッ！
#. de: Preiset die Schlange!
#. fr: Loué soit le GRAND SERPENT<nbsp>!
msgctxt "Balloon:7455:0:1"
msgid "Blessings of great serpent upon us!"
msgstr "Да благословит нас великий змей!"

#. ja: コノ地ハ<br>チーワグーノモノッ！
#. de: Dieses Land gehört den Chirwagur!
#. fr: Cette TERRE appartient à Chirwagur<nbsp>!
msgctxt "Balloon:7456:0:1"
msgid "This is land of the Chirwagur!"
msgstr "Эта земля принадлежит Чирвагуру!"

#. ja: オマエ、行カセナイゾッ！
#. de: Du wirst nicht passieren!
#. fr: DISPARAIS<nbsp>!
msgctxt "Balloon:7457:0:1"
msgid "Leave this place!"
msgstr "Уходи отсюда!"

#. ja: ついた…！
#. de: Geschafft ...!
#. fr: Enfin arrivé, ja<nbsp>!
msgctxt "Balloon:7458:0:1"
msgid "Whew!"
msgstr "Фух!"

#. ja: ん…？
#. de: Hm ...?
#. fr: Hmm...<nbsp>?
msgctxt "Balloon:7459:0:1"
msgid "Hm?"
msgstr "Хм?"

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "Balloon:7460:0:1"
msgid "..."
msgstr "..."

#. ja: わ！？
#. de: Ack!?
#. fr: Ouaaah<nbsp>!!
msgctxt "Balloon:7461:0:1"
msgid "Uwaaah!"
msgstr "А-а-а!"

#. ja: ……！
#. de: ...!
#. fr: ...<nbsp>!
msgctxt "Balloon:7462:0:1"
msgid "Oh dear..."
msgstr "Ох..."

#. ja: 追っ手か！？<br>ずらかるぜ！
#. de: Da ist doch jemand! Ha, nicht mit mir!
#. fr: Bordel, on m'espionne<nbsp>! Cassos<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7463:0:1"
msgid "Who's there?<br>You'll never catch me!"
msgstr "Кто там?<br>Не поймаете меня!"

#. ja: この俺がハメられるとは…
#. de: Verdammt noch eins, darauf hätte ich verzichten können.
#. fr: Comment j'ai pu me faire avoir comme ça...<nbsp>?
msgctxt "Balloon:7464:0:1"
msgid "I can't believe I didn't see it..."
msgstr "Не верится, что я ничего не заметил..."

#. ja: まさかあいつら<br>王女の仲間か？
#. de: Ob das mit der Prinzessin zu tun hatte?
#. fr: J'y crois pas, c'étaient des alliés de la princesse<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <if $gn4>woman<else>man</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "Balloon:7465:0:1"
msgid "I <i>knew</i> that <if $gn4>woman<else>man</if> looked familiar."
msgstr "Я же <i>знал</i>, что этот <if $gn4>женщина<else>мужчина</if> мне знакома."

#. ja: 面倒な依頼を<br>受けちまったぜ
#. de: Ich hätte diesen Auftrag nie annehmen sollen<nbsp>...
#. fr: Dans quel plan foireux je me suis fourré, moi...<nbsp>?
msgctxt "Balloon:7466:0:1"
msgid "This job's more trouble than it's worth."
msgstr "Работа эта хлопотнее, чем стоило ожидать."

#. ja: …何か動いたか？
#. de: Hm? War da was?
#. fr: Ça a bougé ou bien...<nbsp>?
msgctxt "Balloon:7467:0:1"
msgid "What was that?"
msgstr "Что это было?"

#. ja: チッ、こんなはずじゃ…
#. de: Hrng, mir gehen die Nerven durch.
#. fr: Pff, ça partait pourtant pas si mal...
msgctxt "Balloon:7468:0:1"
msgid "This was meant to be easy..."
msgstr "А ведь всё должно было пройти легко..."

#. ja: ここまで来れば…
#. de: Bis hierhin sollte mir doch niemand gefolgt sein<nbsp>...
#. fr: Jusqu'ici tout va bien...
msgctxt "Balloon:7469:0:1"
msgid "Should be safe enough now."
msgstr "Теперь, пожалуй, можно не опасаться."

#. ja: 報酬の受け渡しは<br>隠れ家前のはずだが…
#. de: Ich muss es nur bis zu unserem Versteck schaffen<nbsp>...
#. fr: Il m'avait dit “devant la planque” pour la récompense...
msgctxt "Balloon:7470:0:1"
msgid "He said to meet him in front of the hideout..."
msgstr "Он велел встретиться у входа в убежище..."

#. ja: あのフビゴ族<br>まだ来てないのか？
#. de: Wo ist dieser verdammte Hoobigo?
#. fr: Ce Hoobigo de malheur est toujours pas là<nbsp>?
msgctxt "Balloon:7471:0:1"
msgid "Where's that damn Hoobigo?"
msgstr "Где этот проклятый хубиго?"

#. ja: お前は王女の…！<br>こうしちゃいられねぇ！
#. de: Du! Du gehörst zur Prinzessin! Nichts wie weg!
#. fr: L'<if $gn4>alliée<else>allié</if> de la princesse...<nbsp>!  Ça se présente mal, ja<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7472:0:1"
msgid "The foreign champion!?<br>I'm not fighting you!"
msgstr "Чемпион из чужеземцев!?<br>Я с тобой драться не стану!"

#. ja: 何の音だ？
#. de: Hrm? Was war das für ein Geräusch?
#. fr: C'était quoi, ce bruit<nbsp>!?
msgctxt "Balloon:7473:0:1"
msgid "Hrm?"
msgstr "Хм?"

#. ja: 思い過ごしか…？
#. de: Bah, kein Grund, derart nervös zu sein.
#. fr: Je me fais des idées...<nbsp>?
msgctxt "Balloon:7474:0:1"
msgid "I'm hearing things..."
msgstr "Наверное, показалось..."

#. ja: 早くしねぇと<br>お頭にどやされる！
#. de: Wenn ich mich nicht beeile, werde ich einen Kopf kürzer gemacht<nbsp>...
#. fr: Faut que je me dépêche ou le chef va me passer un savon, ja<nbsp>!
msgctxt "Balloon:7475:0:1"
msgid "I'd better hurry if I don't want a beating..."
msgstr "Надо поторопиться, а то вожак мне задаст..."

#. ja: ん！？
#. de: Hrm?!
#. fr: Hein<nbsp>!?
msgctxt "Balloon:7476:0:1"
msgid "Huh!?"
msgstr "А?"

#. ja: 気のせいか…？
#. de: Das muss ich mir wohl eingebildet haben<nbsp>...
#. fr: J'ai rêvé...<nbsp>?
msgctxt "Balloon:7477:0:1"
msgid "Damn nerves..."
msgstr "Чёртовы нервы..."

#. ja: さあこちらへ！
#. de: Komm, hierher!
#. fr: Allons par ici<nbsp>!
msgctxt "Balloon:7478:0:1"
msgid "This way!"
msgstr "Сюда, скорее!"

#. ja: ついてきてください！
#. de: Also dann, mir nach.
#. fr: Suis-moi<nbsp>!
msgctxt "Balloon:7479:0:1"
msgid "Follow me!"
msgstr "Идите за мной!"

#. ja: 火属性えーてるヲ<br>検知シマシタ！
#. de: Blie-Blie-Bliep!♪<br>Äther mit dem Aspekt: Feuer entdeckt!
#. fr: Éther de feu détecté<nbsp>!
msgctxt "Balloon:7480:0:1"
msgid "FiRe-AsPeCtEd AeThEr DeTeCtEd!"
msgstr "Обнаружен эфир с огненным аспектом!"

#. ja: そのまま、そのままー！
#. de: So ist's gut, immer schön langsam.
#. fr: C'est bon, c'est bon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7481:0:1"
msgid "Steady now!<br>That's it!"
msgstr "Потихоньку!<br>Вот так!"

#. ja: 沖までは<br>船も来てるらしいがね…
#. de: Das Schiff müsste eigentlich schon da sein.
#. fr: Il paraît que le bateau est arrivé au large.
msgctxt "Balloon:7482:0:1"
msgid "Word is the ship just anchored offshore..."
msgstr "Говорят, корабль уже бросил якорь у берега..."

#. ja: ゆっくり待ちましょ
#. de: Warten wir noch ein wenig.
#. fr: On va bientôt pouvoir embarquer, ja.
msgctxt "Balloon:7483:0:1"
msgid "Not long to wait, then."
msgstr "Осталось совсем немного подождать."

#. ja: 一番人気は<br>豚肉とハーブのタコスですね～
#. de: Die Tacos mit Würzfleisch. Die sind bei unseren Kunden besonders beliebt.
#. fr: Nos tacos à la viande épicée, bien sûr<nbsp>!
msgctxt "Balloon:7484:0:1"
msgid "Our herb-roasted pork tacos are a popular dish."
msgstr "У нас очень любят свинину, запечённую с травами."

#. ja: オススメあります？
#. de: Was würdest du mir empfehlen?
#. fr: Vous me recommanderiez quoi<nbsp>?
msgctxt "Balloon:7485:0:1"
msgid "What do you suggest?"
msgstr "Что посоветуете?"

#. ja: 勇連隊の仕事<br>どうだい？
#. de: Wie läuft es in der Landsgarde?
#. fr: Ça se passe bien à la Légion de l'Aurore<nbsp>?
msgctxt "Balloon:7486:0:1"
msgid "How are you enjoying life in the Landsguard?"
msgstr "Ну как тебе служба в Земском ополчении?"

#. ja: やりがいはあるよ<br>ま、ぼちぼちな
#. de: Es gibt Höhen und Tiefen, aber insgesamt ist die Arbeit sehr bereichernd.
#. fr: Il y a des hauts et des bas, mais c'est très enrichissant.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7487:0:1"
msgid "Well enough.<br>It's hard work, but rewarding. "
msgstr "Неплохо.<br>Работы много, зато она того стоит."

#. ja: 故郷の味が恋しいぜ
#. de: Ich vermisse das Essen aus unserer Heimat.
#. fr: La cuisine de mon village me manque...
msgctxt "Balloon:7488:0:1"
msgid "I miss my mother's cooking..."
msgstr "Скучаю по маминой стряпне..."

#. ja: 里帰りも一苦労だしな…
#. de: Warum muss unser Dorf auch so weit weg sein?
#. fr: Dommage qu'on en soit si éloignés, ja...
msgctxt "Balloon:7489:0:1"
msgid "\\<crunch> Bit far to go for dinner, though."
msgstr ""

#. ja: マムークの連中は…
#. de: Also diese Typen aus Mamook<nbsp>...
#. fr: Mamook va encore faire des siennes<nbsp>?
msgctxt "Balloon:7490:0:1"
msgid "So, that Mamook lot..."
msgstr "Ну и народ из Мамук..."

#. ja: さて、な…
#. de: Ach, hör mir auf mit denen.
#. fr: Va savoir...
msgctxt "Balloon:7491:0:1"
msgid "Oh, don't get me started..."
msgstr "Ох, не напоминай..."

#. ja: 模様替えで<br>家具を新しくしたくてさ
#. de: Ich würde gerne mein Zimmer umgestalten.
#. fr: Je voudrais renouveler mon intérieur...
msgctxt "Balloon:7492:0:1"
msgid "I want to buy new furniture and change the whole layout."
msgstr "Хочу купить новую мебель и полностью обставить комнату по-новому."

#. ja: いいねぇ<br>どんな部屋にするんだい？
#. de: An was hast du denn gedacht? Eher rustikal oder modern?
#. fr: Quel genre de meubles conviendrait, ja<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7493:0:1"
msgid "Change is good.<br>What did you have in mind?"
msgstr "Перемены — это хорошо.<br>Какой стиль ты задумал?"

#. ja: とてとて　いいモノだ～！
#. de: Ach, das ist Hübscheding!
#. fr: Bssshh...<nbsp>! C'est génial, ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7494:0:1"
msgid "Pfff... Kohhh...<br>Which to choose...?"
msgstr "Пфф... Кх-х...<br>И что же выбрать?.."

#. ja: これを買おうかな…
#. de: Nehm ich das?
#. fr: Hum... Je vais peut-être me laisser tenter...
msgctxt "Balloon:7495:0:1"
msgid "Should I buy one of these...?"
msgstr "Может, купить вот это?.."

#. ja: うーん<br>こっちも捨てがたい…
#. de: Tja, welches soll ich nehmen?
#. fr: Entre les deux, mon cœur balance<nbsp>!
msgctxt "Balloon:7496:0:1"
msgid "Oh, but it's hard to pass up a good book..."
msgstr "А от хорошей книжки тоже не откажешься..."

#. ja: あそこのフルーツも<br>美味そうだったな…
#. de: Das Obst da drüben sieht aber auch lecker aus<nbsp>...
#. fr: Ces fruits ont l'air tout aussi délicieux<nbsp>!
msgctxt "Balloon:7497:0:1"
msgid "Maybe a piece of fruit to help me think..."
msgstr "Может, взять фрукт, чтобы подумать..."

#. ja: うちの果物<br>新鮮でうまいよ～
#. de: Unser Obst ist ganz frisch! Es hängt quasi noch am Baum.
#. fr: Nos fruits ont été fraîchement récoltés<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7498:0:1"
msgid "Freeesh fruit!<br>Juiciest fruit in Tuliyollal!"
msgstr "Свежие фрукты!<br>Самые сочные в Тулийоллале!"

#. ja: 新しい釣り餌を試すか…
#. de: Ich sollte mal einen neuen Köder ausprobieren.
#. fr: Il est temps d'essayer ce nouvel appât...
msgctxt "Balloon:7499:0:1"
msgid "I should try some different bait..."
msgstr "Попробовать бы новую наживку..."

#. ja: 激辛チーちゃんタコスうめぇ～！
#. de: Tante Tiis Tacos sind ordentlich scharf<nbsp>... Genau wie ich es mag.
#. fr: Les tacos de Tiisol sont très épicés... mais tout aussi délicieux<nbsp>!
msgctxt "Balloon:7500:0:1"
msgid "Mmm, I love these spicy tacos!"
msgstr "М-м-м, обожаю эти острые тако!"

#. ja: チーちゃんは<br>具の種類が豊富だよな！
#. de: Hm, ich weiß nicht, welche Extras ich nehmen soll<nbsp>...
#. fr: Je ne sais pas quels ingrédients choisir, il y a tellement de possibilités<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7501:0:1"
msgid "Aunt Tii is the best!<br>She never skimps on the fillings!"
msgstr "Тётушка Ти — лучшая!<br>Начинки никогда не жалеет!"

#. ja: 辛いぃぃぃぃぃ！
#. de: Ah! Mein Mund brennt!!!
#. fr: Ouah<nbsp>! J'ai la bouche en feu<nbsp>!!
msgctxt "Balloon:7502:0:1"
msgid "Gods, my tongue is on fire!"
msgstr "Боги, язык горит!"

#. ja: でもそれがいい！！
#. de: Aua, ist das scharf!!! Und lecker!
#. fr: C'est douloureux... Mais c'est si bon<nbsp>!
msgctxt "Balloon:7503:0:1"
msgid "And I love it!"
msgstr "И всё равно обожаю!"

#. ja: 私は甘いのを…
#. de: Ich bevorzuge ja etwas mildere Gewürze<nbsp>...
#. fr: Je préfère les épices douces...
msgctxt "Balloon:7504:0:1"
msgid "Please, no hot spice for me..."
msgstr "Мне, пожалуйста, без острого..."

#. ja: ああ、いい匂い…！
#. de: Hach, wie das duftet!
#. fr: Hum... J'adore ces odeurs<nbsp>!
msgctxt "Balloon:7505:0:1"
msgid "They smell amazing!"
msgstr "Как вкусно пахнет!"

#. ja: もうすぐ<br>できますからね！
#. de: Es ist gleich fertig!
#. fr: C'est bientôt prêt<nbsp>!
msgctxt "Balloon:7506:0:1"
msgid "I'll have your order ready in just a moment!"
msgstr "Ваш заказ будет готов с минуты на минуту!"

#. ja: やっぱり俺は<br>チーちゃん派！
#. de: Tiisols Tacos sind die besten!
#. fr: Moi, c'est les tacos de Tiisol que je préfère<nbsp>!
msgctxt "Balloon:7507:0:1"
msgid "Aunt Tii's always gets my vote!"
msgstr "Тётушка Тии вне конкуренции!"

#. ja: シャバーブチェも<br>捨てがたいけどねぇ
#. de: Die von Xbalyav Ty'e sind aber auch nicht ohne.
#. fr: Ceux de Xbalyav Ty'e sont bien aussi, ja.
msgctxt "Balloon:7508:0:1"
msgid "Indeed, but I wouldn't say no to a free lunch at Xbalyav Ty'e."
msgstr "Конечно, но я бы не отказался бесплатно пообедать в Шбаляв-Тье."

#. ja: やっぱタコスには<br>酒だよ、酒！
#. de: Zu scharfem Essen trinkt man am besten ein scharfes Tröpfchen!
#. fr: L'alcool se marie si bien avec les tacos<nbsp>!
msgctxt "Balloon:7509:0:1"
msgid "Ah! Nothing washes down a taco like a drink with its own kick!"
msgstr "Вот это да! К тако нужно что-нибудь покрепче!"

#. ja: 果実酒を飲んでる間は<br>すべてを忘れられるな
#. de: Ein kleines Schlückchen und alle meine Sorgen sind wie weggeblasen!
#. fr: Un petit verre, et tous mes soucis s'envolent, ja<nbsp>!
msgctxt "Balloon:7510:0:1"
msgid "Careful. The fruity mixes here are surprisingly strong..."
msgstr "Осторожнее. Фруктовые настойки тут на удивление крепкие..."

#. ja: 手入れは欠かさず…
#. de: Gute Instrumente wollen gepflegt werden.
#. fr: L'entretien, c'est vital...
msgctxt "Balloon:7511:0:1"
msgid "Have to keep the skin supple..."
msgstr "Надо кожу беречь..."

#. ja: この音は絶やさぬぞ！
#. de: Der Klang soll perfekt sein!
#. fr: L'acoustique doit être parfaite<nbsp>!
msgctxt "Balloon:7512:0:1"
msgid "A clean drum for a clear sound!"
msgstr "Барабан должен быть чистым, тогда и звук будет звонкий!"

#. ja: ぷうぅ～
#. de: Pju ...
#. fr: Huuuum...
msgctxt "Balloon:7513:0:1"
msgid "Mrrrn..."
msgstr "Мр-р-р..."

#. ja: よ～しよし<br>いい子だぞ～
#. de: So ist es gut, mein Kleiner, so ist es gut!
#. fr: C'est bien, mon petit, c'est bien<nbsp>!
msgctxt "Balloon:7514:0:1"
msgid "There, there, who's my pretty girl?"
msgstr "Тише, тише... Кто у нас такая красавица?"

#. ja: ぷうぷう♪
#. de: Pju pju ♡
#. fr: Hum hum<nbsp>!
msgctxt "Balloon:7515:0:1"
msgid "Mrrrn, mrrrn!♪"
msgstr "Мр-р-р, мр-р-р!♪"

#. ja: たーくさんお食べー
#. de: Lass es dir schmecken, mein Lieber!
#. fr: Régale-toi mon bichon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7516:0:1"
msgid "Eat up, now.<br>You need your strength."
msgstr "Ешь, не стесняйся.<br>Силы тебе ещё пригодятся."

#. ja: よしよし<br>いつでも飛べるな
#. de: Gut! Der Ballon ist startklar!
#. fr: Parfait. Ce ballon est opérationnel.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7517:0:1"
msgid "Ropes are secure.<br>We're clear for takeoff."
msgstr "Верёвки закреплены.<br>Взлетаем!"

#. ja: 機材に問題なし、と…
#. de: Alles im grünen Bereich.
#. fr: Aucune avarie à signaler...
msgctxt "Balloon:7518:0:1"
msgid "No visible tearing or fraying of the envelope..."
msgstr "Оболочка вроде цела, нигде не порвана и не обтрепалась..."

#. ja: うおぉぉぉぉ！！！！
#. de: Uuu-haaa!
#. fr: Haaaaaaaaaa<nbsp>!!!
msgctxt "Balloon:7519:0:1"
msgid "Raaah!"
msgstr "Р-р-ра!"

#. ja: おらぁぁ！
#. de: Nimm das!
#. fr: Tiens<nbsp>!
msgctxt "Balloon:7520:0:1"
msgid "Hyaaah!"
msgstr "На!"

#. ja: いいぞー！<br>その調子！！
#. de: Schöne Finte! Weiter so!
#. fr: Belle feinte<nbsp>! Continuez comme ça<nbsp>!
msgctxt "Balloon:7521:0:1"
msgid "That's it! Give it to 'em!"
msgstr "Вот так! Задай им жару!"

#. ja: なかなかの太刀筋ね
#. de: Das nenne ich Kampfkunst!
#. fr: Belle maîtrise de l'épée...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7522:0:1"
msgid "Not bad.<br>They both show some skill."
msgstr "Неплохо.<br>Оба умеют обращаться с клинком."

#. ja: そこだ！そこ！
#. de: Ja, so ist's richtig!
#. fr: Oui, bien joué<nbsp>!
msgctxt "Balloon:7523:0:1"
msgid "Now! He's open!"
msgstr "Сейчас! Он открылся!"

#. ja: 一撃に全てを込めろ！
#. de: Jeder Hieb muss sitzen!
#. fr: Chaque coup doit être décisif<nbsp>!
msgctxt "Balloon:7524:0:1"
msgid "Put all your strength into the blow!"
msgstr "Вложи всю силу в удар!"

#. ja: うぉりゃぁぁぁぁーー！！
#. de: Hiii-jaaah!
#. fr: Yaaaaaaaahhh<nbsp>!!
msgctxt "Balloon:7525:0:1"
msgid "Uraaaaggghhh!"
msgstr "Ур-р-а-а-а!"

#. ja: 体の軸をぶらさないように！
#. de: Immer schön die Balance halten!
#. fr: Reste ferme sur tes appuis<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7526:0:1"
msgid "Footwork!<br>Watch your balance!"
msgstr "Следи за ногами!<br>Равновесие не теряй!"

#. ja: たあっ！ていっ！
#. de: Ha! Hu!
#. fr: Ha<nbsp>! Yah<nbsp>!
msgctxt "Balloon:7527:0:1"
msgid "Hah! Hyah!"
msgstr "Ха! Хья!"

#. ja: 腕だけで突こうとするなよ！
#. de: Benutze den ganzen Körper, nicht nur deine Arme!
#. fr: Utilise tout ton corps, pas juste tes bras<nbsp>!
msgctxt "Balloon:7528:0:1"
msgid "Get your whole body behind the thrust!"
msgstr "Вкладывайся в выпад всем телом!"

#. ja: セイヤッ！
#. de: Nimm das!
#. fr: Prends ça<nbsp>!!
msgctxt "Balloon:7529:0:1"
msgid "Yaaah!"
msgstr "Я-а-а!"

#. ja: どんな状況でも<br>集中力を切らすな！
#. de: Nicht ablenken lassen!
#. fr: Restez concentrés en toute circonstance<nbsp>!
msgctxt "Balloon:7530:0:1"
msgid "Concentrate. Let nothing distract you."
msgstr "Сосредоточьтесь. Ничто не должно вас отвлечь."

#. ja: はい！
#. de: Jawohl!
#. fr: À vos ordres<nbsp>!
msgctxt "Balloon:7531:0:1"
msgid "Yes, sir!"
msgstr "Есть, сэр!"

#. ja: このあと手合わせしないか？
#. de: Wollen wir uns nachher ein kleines Duell liefern?
#. fr: On se fait un petit duel tout à l'heure<nbsp>?
msgctxt "Balloon:7532:0:1"
msgid "Keen for some sparring later?"
msgstr "Не хочешь потом спарринг устроить?"

#. ja: いいけど…<br>手加減しないでよね
#. de: Wenn du willst<nbsp>... Aber wehe, du weinst wieder!
#. fr: Si tu veux... Mais t'as pas intérêt à retenir tes coups<nbsp>!
msgctxt "Balloon:7533:0:1"
msgid "Always. But don't hold back like last time."
msgstr "Как всегда. Только в этот раз не сдерживайся."

#. ja: ちょっと休憩…
#. de: Ich brauch mal eben eine Pause<nbsp>...
#. fr: Laissez-moi souffler un coup...
msgctxt "Balloon:7534:0:1"
msgid "Just a short rest, then it's back to it..."
msgstr "Немного передохну... и снова за дело."

#. ja: 最近、肩がこっちゃって…
#. de: Meine Schulter ist total verkrampft<nbsp>...
#. fr: J'ai mal aux épaules en ce moment...
msgctxt "Balloon:7535:0:1"
msgid "My shoulder has been so stiff lately..."
msgstr "Что-то плечо в последнее время затекло..."

#. ja: 春暖岩を試してみたら？
#. de: Lass dich doch mal richtig durchkneten.
#. fr: Tu as essayé d'aller te faire masser<nbsp>?
msgctxt "Balloon:7536:0:1"
msgid "Have you tried heated springstone? My cousin swears by it."
msgstr "А ты пробовал горячий камень из источника? Мой кузен клянётся, что помогает."

#. ja: 立派に育てよ
#. de: Wachst, meine Kleinen!
#. fr: Poussez, mes petits<nbsp>!
msgctxt "Balloon:7537:0:1"
msgid "Grow strong, my pretties."
msgstr "Растите большими и сильными, красавицы мои."

#. ja: 冷えたトマト<br>あとでこっそり…
#. de: Wenn ich fertig bin, ess ich heimlich ein Tomätchen.
#. fr: Ces tomates ont l'air juteuses à souhait<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7538:0:1"
msgid "Surely no one will miss <i>one</i> tomato..."
msgstr "<i>Одного</i> помидора никто и не заметит..."

#. ja: ふふふ～ん♪
#. de: La, lala, la-laaa!
#. fr: La la lala la<nbsp>!
msgctxt "Balloon:7539:0:1"
msgid "Hmhmhmmm～♪"
msgstr "М-м-м-м♪"

#. ja: すごーい！<br>上手だね！！
#. de: Hm, nicht schlecht, Herr Specht!
#. fr: C'est magnifique<nbsp>! Quel talent<nbsp>!
msgctxt "Balloon:7540:0:1"
msgid "That's so good!"
msgstr "Вот это здорово!"

#. ja: 王都に来た甥っ子がね<br>海にびっくりしちゃって…
#. de: Mein Neffe aus der Stadt war sprachlos, als er zum ersten Mal das Meer gesehen hat.
#. fr: Mon neveu a été surpris en voyant la mer pour la première fois<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7541:0:1"
msgid "My nephew came here to visit.<br>He's terrified of the ocean!"
msgstr "Племянник приехал ко мне в гости.<br>Он до смерти боится океана!"

#. ja: 波が怖かったのかもねえ
#. de: Tja, die Wellen können einem ganz schön Angst machen.
#. fr: Il faut avouer que les vagues sont parfois im<shy>prrres<shy>sion<shy>nantes...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7542:0:1"
msgid "Hahaha, waves <i>do</i> look scary at first..."
msgstr "Ха-ха-ха, поначалу волны <i>и правда</i> кажутся страшными..."

#. ja: ううむ…
#. de: Hm, jetzt ein Eis<nbsp>...
#. fr: Hum...
msgctxt "Balloon:7543:0:1"
msgid "Hmm..."
msgstr "Хм..."

#. ja: 「天使のおやつ」は…<br>ここじゃなかったかしら？
#. de: Hier gibt's doch Engelspeise, oder?
#. fr: C'était pas ici, les biscuits “Angélique”...<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7544:0:1"
msgid "Hmm. I guess they <i>don't</i> sell Angel Snacks here..."
msgstr "Хм. Похоже, тут «Ангельских сладостей» <i>не</i> продают..."

#. ja: ここの占い<br>すっごく当たるんだって！
#. de: Was man hier hört, tritt sicher ein, sagt man!
#. fr: Ici, les prédictions d'avenir tapent toujours dans le mille<nbsp>!
msgctxt "Balloon:7545:0:1"
msgid "Apparently, this fortune-teller's always right on the mark!"
msgstr "Говорят, эта гадалка всегда попадает в точку!"

#. ja: ちょっと怖いけど<br>楽しみだね～
#. de: Ich weiß nicht, ob ich meine Zukunft überhaupt wissen möchte<nbsp>...
#. fr: J'ai un peu peur... mais ma currriosité est la plus forte<nbsp>!
msgctxt "Balloon:7546:0:1"
msgid "I don't know if I should find that reassuring or not..."
msgstr "Не знаю, радоваться этому или нет..."

#. ja: 俺の未来は…<br>不幸か…幸福か…
#. de: Ob ich wohl glücklich werde? Oder mit gebrochenem Herzen sterbe?
#. fr: Alors, mon avenir sera-t-il radieux... ou nuageux<nbsp>?
msgctxt "Balloon:7547:0:1"
msgid "What's the future got in store for me?"
msgstr "И что же ждёт меня в будущем?"

#. ja: これで排気効率が…<br>ふふ…ふふふ…
#. de: So lassen sich die Emissionen noch weiter drücken.
#. fr: Hé hé hé... À partir de maintenant, ça va ventiler comme jamais<nbsp>!
msgctxt "Balloon:7548:0:1"
msgid "Ohoho, this'll have 'er zoomin' along!"
msgstr "О-хо-хо, вот теперь-то она полетит!"

#. ja: スピナー乗り魂を<br>見せてやる
#. de: Die Dinger gehen ab wie Sau.
#. fr: Personne ne monte une fileuse mieux que moi<nbsp>!
msgctxt "Balloon:7549:0:1"
msgid "Just you wait! They ain't seen nothing yet!"
msgstr "Вот увидите! Я ещё покажу, на что способен!"

#. ja: 推力をもっと…
#. de: Bäääng, haste die Schallmauer gebrochen!
#. fr: Un peu plus de force de propulsion, et le tour sera joué...
msgctxt "Balloon:7550:0:1"
msgid "I need more thrust... But how?"
msgstr "Нужно больше тяги... Но как её добиться?"

#. ja: もう飲めな～い…<br>むにゃむにゃ…
#. de: Ich kann nicht mehr<nbsp>...
#. fr: J'ai trop bu... Zzzz...
msgctxt "Balloon:7551:0:1"
msgid "This...\\<hic>...bed's so...\\<hic>...comfy."
msgstr ""

#. ja: チキショウ！<br>この、小銭ドロボウがッ！
#. de: Dieser verdammte Dieb!
#. fr: Saloperie de machine<nbsp>! Rends-moi mon fric, raclure<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7552:0:1"
msgid "Bloody vendin' machine.<br>Give me back my money!"
msgstr "Чёртов автомат!<br>Верни мои деньги!"

#. ja: 愚民どもよ<br>我が芸術に慄くがいい…
#. de: Zittert vor meinem Können, ihr Unwissenden!
#. fr: Extasiez-vous devant mon génie, bande d'incultes...
msgctxt "Balloon:7553:0:1"
msgid "Feast yer eyes on this, True Vue!"
msgstr "Любуйтесь, неучи, моим искусством!"

#. ja: 走りで魅了してみな
#. de: Beeindrucke sie mit deiner Technik!
#. fr: Allez, montre-moi un peu comment tu roules<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7554:0:1"
msgid "You oughta show 'em how you <i>really</i> ride one o' these things."
msgstr "Покажи им, как <i>на самом деле</i> надо гонять на этой штуке."

#. ja: 何を飲もうかな～っと
#. de: Was genehmige ich mir heute?
#. fr: Si seulement je savais ce que j'ai envie de boire...
msgctxt "Balloon:7555:0:1"
msgid "Hmm. What shall I order?"
msgstr "Хм. Что бы заказать?"

#. ja: アルカディア<br>いつ再開するんだろな
#. de: Wann macht das Arkadion wieder auf?
#. fr: Quand est-ce que l'Arcadion va enfin rouvrir ses portes<nbsp>?
msgctxt "Balloon:7556:0:1"
msgid "Is the Arcadion ever gonna reopen?"
msgstr "Интересно, Аркадион вообще когда-нибудь откроется?"

#. ja: アルカディア<br>ついに再開だぜ！
#. de: Endlich hat das Arkadion wieder auf!
#. fr: L'Arcadion a enfin rouvert<nbsp>! C'est pas trop tôt<nbsp>!
msgctxt "Balloon:7557:0:1"
msgid "Oho! The Arcadion's back!"
msgstr "Ого! Аркадион снова работает!"

#. ja: 外征が落ち着くまで<br>無理じゃないかなあ
#. de: Erst muss sich die Lage am Außenposten entspannen.
#. fr: Pas avant la fin de nos projets expansionnistes, il faut croirrre...
msgctxt "Balloon:7558:0:1"
msgid "Not with a war goin' on, that's for sure."
msgstr "Пока война не утихнет, точно нет."

#. ja: あんまり<br>のめり込まないでよ～？
#. de: Übertreib's nicht!
#. fr: Va pas nous faire une crrrise cardiaque non plus, hein<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7559:0:1"
msgid "Never mind the Arcadion! You're supposed to be out for a drink with <i>me</i>!"
msgstr "Да забудь ты про Аркадион! Ты же со <i>мной</i> выпить пришёл!"

#. ja: この一杯のために<br>生きてるぜ…
#. de: Darauf habe ich mich den ganzen Tag gefreut!
#. fr: Je peux enfin me soûler tran<shy>quil<shy>le<shy>ment...
msgctxt "Balloon:7560:0:1"
msgid "Ahhh. I've earned this."
msgstr "А-а-а... Заслужил."

#. ja: 聞いたか？<br>キープ内に…
#. de: Hast du gehört, was im Immerfried vor sich gehen soll?
#. fr: Tu as entendu la nouvelle rumeur...<nbsp>?
msgctxt "Balloon:7561:0:1"
msgid "You'll never guess what turned up in the 'keep the other day."
msgstr "Слышал, что недавно нашли в крепости?"

#. ja: ガウガウ鳴く新種の動物？<br>ホントかよ…
#. de: Diese Flöt- und Quietschgeräusche? Tja, was wohl dahintersteckt<nbsp>...
#. fr: Le nouvel animal qui fait “graou graou”<nbsp>? Je sais pas quoi en penser...
msgctxt "Balloon:7562:0:1"
msgid "A li'l critter that goes “squeal”? Don't be daft."
msgstr "Зверушку, которая пищит? Да брось ты."

#. ja: こないだ職場でさ…
#. de: Du wirst nicht glauben, was mir neulich bei der Arbeit passiert ist!
#. fr: L'autre jour, au boulot...
msgctxt "Balloon:7563:0:1"
msgid "The other day at work..."
msgstr "Слушай, на днях у нас на работе..."

#. ja: うへぇ<br>キツいなそれ…
#. de: Argh, das ist bitter ...
#. fr: Sérieux<nbsp>!? Ouah, c'est chaud...
msgctxt "Balloon:7564:0:1"
msgid "Blimey... What a nightmare."
msgstr "Вот ведь жуть... Ну и кошмар."

#. ja: ひぃぃ<br>許してください～
#. de: Uiii! Entschuldigung!
#. fr: Pitié<nbsp>! Je ferai tout ce que vous voudrrrez<nbsp>!
msgctxt "Balloon:7565:0:1"
msgid "You gotta let me off the hook!"
msgstr "Не надо, умоляю! Отпусти меня!"

#. ja: 借金踏み倒しといて<br>許されるとでも～？
#. de: Glaub nicht, dass du unbegrenzt Schulden machen kannst.
#. fr: Rends l'argent tout de suite<nbsp>!
msgctxt "Balloon:7566:0:1"
msgid "Not until we get our money!"
msgstr "Сначала верни наши деньги!"

#. ja: ミララ族ナメんなよ<br>くルァ！
#. de: Mit den Milalla legt man sich nicht an!
#. fr: On est petits mais costauds, alors te fous pas de nous<nbsp>!
msgctxt "Balloon:7567:0:1"
msgid "You'll regret messin' with Milallas!"
msgstr "Не связывайся с милаллами, пожалеешь!"

#. ja: うちのプランなら<br>5倍の利益を約束します！
#. de: 500 % Gewinn! Das kann ich garantieren!
#. fr: Chez nous, vous quintuplerez votre mise, promis juré<nbsp>!
msgctxt "Balloon:7568:0:1"
msgid "We guarantee a five-time return on your investment!"
msgstr "Наш план гарантирует пятикратную прибыль!"

#. ja: へ、へぇ～…
#. de: Boa ...
#. fr: Euh... Vous êtes sûre<nbsp>?
msgctxt "Balloon:7569:0:1"
msgid "Right..."
msgstr "Д-да уж..."

#. ja: 俺ァ…<br>酔って…ねェッ！
#. de: Isch ... b-bin nischt<nbsp>... bedrunken<nbsp>...
#. fr: Chuis pas bourré<nbsp>! Hips... Pas du tout<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7570:0:1"
msgid "I'm...\\<hic>...<i>not</i> drunk! Jush a li'l...\\<hic>...tipshy."
msgstr ""

#. ja: やっとエレクトロープが<br>温まってきたぜ
#. de: Endlich, das Elektrob ist warm.
#. fr: Ah, cette bonne odeur d'électrope en fusion dans le moteur...
msgctxt "Balloon:7571:0:1"
msgid "Finally got the electrope warmed up and the engine tickin' over."
msgstr "Наконец-то электроп нагрелся, движок заработал."

#. ja: いい景色…
#. de: Was für eine schöne Aussicht!
#. fr: Quelle vue magnifique...
msgctxt "Balloon:7572:0:1"
msgid "What a view..."
msgstr "Какая красота..."

#. ja: 第四層のアレ<br>食ったか？
#. de: Hast du dieses Dosending von der vierten Ebene schon probiert?
#. fr: Dis-moi ma petite, as-tu goûté le nouveau plat miraculeux issu du quatrième étage<nbsp>?
msgctxt "Balloon:7573:0:1"
msgid "You ever try that stuff they make on level four?"
msgstr "Ты пробовала то, что готовят на четвёртом уровне?"

#. ja: あー…バイオステーキ？<br>まあ…うん…
#. de: Das künstliche Steak? Hm, ja. War nicht so besonders.
#. fr: Le biosteak<nbsp>? Euh... Oui, c'était... comestible...
msgctxt "Balloon:7574:0:1"
msgid "Cultivated steak? Yeah, not sure how I feel about it..."
msgstr "Культивированное мясо? Ну... Не знаю, что и думать."

#. ja: どこか<br>別の層に行ってみないか？
#. de: Sollen wir nicht mal auf eine andere Ebene gehen?
#. fr: Eh les filles, ça vous dirait pas d'aller visiter un autre étage<nbsp>?
msgctxt "Balloon:7575:0:1"
msgid "How about we head to one of the other levels?"
msgstr "Может, сходим на какой-нибудь другой уровень?"

#. ja: 自然再現区とか<br>いいんじゃない？
#. de: Wie wäre es mit dem Landschaftssektor?
#. fr: Ouais, pourquoi pas celui de la “nature ar<shy>ti<shy>fi<shy>cielle”<nbsp>?
msgctxt "Balloon:7576:0:1"
msgid "Ooh, good idea! We can check out the nature restoration sector!"
msgstr "О, отличная идея! Заглянем в сектор восстановления природы!"

#. ja: 契約内容については…
#. de: Also, in dem Vertrag steht<nbsp>...
#. fr: Je peux voir le contrat, s'il vous plaît<nbsp>?
msgctxt "Balloon:7577:0:1"
msgid "Let's quickly review your contract..."
msgstr "Давайте быстро проверим условия договора..."

#. ja: ええ、問題ありません
#. de: Ja ja, wird schon alles seine Richtigkeit haben.
#. fr: B-bien sûr<nbsp>! Vous avez des lunettes pour encre invisible<nbsp>?
msgctxt "Balloon:7578:0:1"
msgid "Good, good. It all seems quite reasonable to me."
msgstr "Хорошо, хорошо. Вроде всё вполне разумно."

#. ja: お待ちのお客様<br>こちらへどうぞ～
#. de: Der Nächste, bitte.
#. fr: Au suivant, je vous prie<nbsp>!
msgctxt "Balloon:7579:0:1"
msgid "Who's next, please?"
msgstr "Кто следующий? Проходите, пожалуйста."

#. ja: 本日はどうされましたか？
#. de: Wie kann ich helfen?
#. fr: Que puis-je faire pour vous aujourd'hui<nbsp>?
msgctxt "Balloon:7580:0:1"
msgid "How can I help you today?"
msgstr "Чем могу помочь?"

#. ja: あ、はい～
#. de: Aha, verstehe.
#. fr: J'arrive<nbsp>!
msgctxt "Balloon:7581:0:1"
msgid "Ah, that's me."
msgstr "А, это я."

#. ja: ご住居の手続きでしたら<br>下の階ですね
#. de: Dieser Antrag muss eine Ebene tiefer gestellt werden.
#. fr: Le bureau des ins<shy>crip<shy>tions est à l'étage du dessous.
msgctxt "Balloon:7582:0:1"
msgid "Ah, you'll need to head to the floor below for that procedure."
msgstr "А, по этому вопросу вам нужно на этаж ниже."

#. ja: あー、じゃあ<br>エレベーターの使用許可を…
#. de: Aah, könnte dann bitte der Fahrstuhl für mich freigeschaltet werden ...?
#. fr: J'aurais besoin d'une au<shy>to<shy>ri<shy>sa<shy>tion pour l'ascenseurrr, dans ce cas...
msgctxt "Balloon:7583:0:1"
msgid "Um, okay. Can I get temporary elevator access?"
msgstr "Эм, ясно. А можно мне временный пропуск на лифт?"

#. ja: 職業についての相談は<br>あっちか…
#. de: Wo kann ich mich hier in einer Arbeitsangelegenheit beraten lassen?
#. fr: Alors, où est l'accueil des demandeurs d'emploi...<nbsp>?
msgctxt "Balloon:7584:0:1"
msgid "Hmm. Where do I go for advice about work?"
msgstr "Хм. Куда обратиться за советом насчёт работы?"

#. ja: 転居については<br>この階じゃないんだっけ…？
#. de: Bin ich hier richtig für eine Adressänderung?
#. fr: Pourrrtant, il me semblait bien que le bureau des déménagements était ici...
msgctxt "Balloon:7585:0:1"
msgid "I could've sworn this was where they handled relocations..."
msgstr "Я был уверен, что переезд оформляют здесь..."

#. ja: 窓口で聞いてみるか…
#. de: Ich frage mal bei der Information.
#. fr: Demandons à l'accueil.
msgctxt "Balloon:7586:0:1"
msgid "Guess I'll check with someone at the counter."
msgstr "Спрошу-ка у кого-нибудь за стойкой."

#. ja: あいつ、遅いなあ…
#. de: Wo bleibt sie denn?
#. fr: Et voilà, en retard, comme d'habitude...
msgctxt "Balloon:7587:0:1"
msgid "Where's she gotten to?"
msgstr "Ну и где она?"

#. ja: ごめんごめ～ん<br>出がけにバタついちゃってさ…
#. de: Entschuldige! Ich hab's einfach vertrödelt!
#. fr: Désolée<nbsp>! J'ai dû régler un truc juste avant de sortir...
msgctxt "Balloon:7588:0:1"
msgid "Sorry! I got caught up with something..."
msgstr "Извини, извини! Перед выходом пришлось кое-что уладить..."

#. ja: キープ内に住めば<br>気軽に会えるのに
#. de: Wenn du auch im Immerfried wohnen würdest, könnten wir uns häufiger sehen.
#. fr: Mais pourquoi<nbsp>? Si on habite tous les deux ici, on pourra se voir plus souvent...
msgctxt "Balloon:7589:0:1"
msgid "But if we moved here, we'd see each other all the time..."
msgstr "Если бы мы переехали сюда, то виделись бы постоянно..."

#. ja: うーん…<br>あたしにここは合わないよ
#. de: Hm ... Ich glaube, das hier ist nichts für mich.
#. fr: Je sais, mais... pour une raison qui m'échappe, je n'aime pas cet endroit...
msgctxt "Balloon:7590:0:1"
msgid "I know, I know. The 'keep just isn't for me, though."
msgstr "Знаю, знаю. Но крепость всё-таки не для меня."

#. ja: おや、どうされました？
#. de: Also, wie kann ich helfen?
#. fr: Comment puis-je vous aider<nbsp>?
msgctxt "Balloon:7591:0:1"
msgid "Hmm? What seems to be the problem?"
msgstr "Хм? Что случилось?"

#. ja: あたしの順番<br>まだかなー
#. de: Wann komme ich endlich dran?
#. fr: Bon alors, ça y est<nbsp>? C'est enfin mon tour<nbsp>? Pfff...
msgctxt "Balloon:7593:0:1"
msgid "How long is this gonna take?"
msgstr "Ну сколько ещё ждать?"

#. ja: Zzz…
#. de: \<schnarch> ...
#. fr: Zzz...
msgctxt "Balloon:7594:0:1"
msgid "Zzz..."
msgstr "Zzz..."

#. ja: 今の仕事について<br>ちょっと相談事が、ね…
#. de: Ich habe da ein Problemchen wegen meiner Arbeit<nbsp>... Ich, äh, habe keine.
#. fr: J'espère qu'on saura me renseigner cor<shy>rec<shy>te<shy>ment au sujet de ce travail...
msgctxt "Balloon:7595:0:1"
msgid "I better not be getting reassigned again..."
msgstr "Только бы меня опять не перевели на другую работу..."

#. ja: 俺にもできる仕事は…と
#. de: Also, was für eine Arbeit könnte mir liegen<nbsp>...
#. fr: Qu'est-ce que je pourrais bien faire d'autre comme boulot...<nbsp>?
msgctxt "Balloon:7596:0:1"
msgid "What kind of work can I picture myself doing? Err..."
msgstr "Так... Чем бы я мог заняться?"

#. ja: 最近の様子はどうです？
#. de: Wie geht's?
#. fr: Ça se passe bien en ce moment<nbsp>?
msgctxt "Balloon:7597:0:1"
msgid "How's everything been lately?"
msgstr "Как у тебя дела в последнее время?"

#. ja: 不安を抱えてる人<br>思いのほか多いみたい
#. de: Es gibt mehr Leute mit Angstzuständen, als man meint.
#. fr: Oui et non... Beaucoup de gens semblent anxieux...
msgctxt "Balloon:7598:0:1"
msgid "Honestly, people are still struggling to get over what happened."
msgstr "Честно говоря, многим всё ещё тяжело прийти в себя после случившегося."

#. ja: クヌクさん、美しい…
#. de: Kunuk ist so hübsch<nbsp>...
#. fr: Kunuk est si charmant...
msgctxt "Balloon:7599:0:1"
msgid "Kunuk's so pretty..."
msgstr "Кунок такой красивый..."

#. ja: さてさて　在庫の確認だ～
#. de: Warenzähl ist die wichtigste Arbeit im Lager.
#. fr: Le gentil Mobelin doit vérifier la réserve<nbsp>!
msgctxt "Balloon:7600:0:1"
msgid "Time to check on our supplies..."
msgstr "Пора проверить наши запасы..."

#. ja: 果物　葉物…<br>傷む前に　食べないと～
#. de: Obst, Gemüse ... Das muss alleding verzehrt werden, bevor es vergammelt.
#. fr: Bssshhhhmmm... Mieux vaut manger les fruits et les herbes avant qu'ils pourrissent.
msgctxt "Balloon:7601:0:1"
msgid "Fruits and vegetables aplenty... But we must eat them before they wasterot."
msgstr "Фруктов и овощей полно... Надо съесть, пока не сгнили."

#. ja: 根菜　穀類　香辛料…<br>まだまだ日持ちは安心だ～
#. de: Wurzeln, Getreide, Gewürze<nbsp>... Davon ist noch vieleding da.
#. fr: Les légumes, les céréales et les épices devraient être bons enkore quelques jours.
msgctxt "Balloon:7602:0:1"
msgid "Roots, grain, spices... We have enough to feed many hungrytums."
msgstr "Корнеплоды, зерно, специи... Еды хватит на много голодных ртов."

#. ja: ここで飲むコーヒー<br>沁みるわ～
#. de: Ah ... Das Aroma dringt mir bis in die Fußspitzen.
#. fr: Comme c'est agréable de siroter son café sur un banc<nbsp>!
msgctxt "Balloon:7603:0:1"
msgid "Watching the world go by, coffee in hand─what could be better?"
msgstr "Сижу на скамейке, пью кофе и смотрю, как проходит день. Что может быть лучше?"

#. ja: たまの休暇<br>ゆったり過ごさなきゃな
#. de: Freie Tage muss man auskosten!
#. fr: Profiter à fond de chaque pause, c'est ce que je sais faire de mieux<nbsp>!
msgctxt "Balloon:7604:0:1"
msgid "Gotta make the most of my day off!"
msgstr "Надо отдохнуть как следует, раз выдался выходной!"

#. ja: 取引でやらかしたんだ<br>放っといてくれ…
#. de: Lass mich in Ruhe. Ich wurde heute ordentlich abgezogen.
#. fr: Laisse-moi tranquille, je viens de me faire arnaquer comme jamais...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7605:0:1"
msgid "Just leave me be...<br>I got absolutely fleeced today..."
msgstr "Оставь меня в покое...<br>Сегодня меня обчистили до нитки..."

#. ja: すー…すー…
#. de: Zzzz ...
#. fr: Rrrr... Zzzz...
msgctxt "Balloon:7606:0:1"
msgid "Zzz..."
msgstr "Zzz..."

#. ja: 今日の空調<br>気持ちいいねえ
#. de: Was für ein herrlicher <if ($gn11 < 12)><if ($gn11 < 4)>Abend<else>Morgen</if><else><if ($gn11 < 17)>Tag<else>Abend</if></if>!
#. fr: Le ciel est si beau...
#. macro: <if ($gn11 < 12)><if ($gn11 < 4)>evening<else>morning</if><else><if ($gn11 < 17)>day<else>evening</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 12 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gn11 < 4)>evening<else>morning</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 4 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gn11 < 17)>day<else>evening</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 17 (condition: may be reworded, restructured, added, or dropped)
msgctxt "Balloon:7607:0:1"
msgid "What a wonderful <if ($gn11 < 12)><if ($gn11 < 4)>evening<else>morning</if><else><if ($gn11 < 17)>day<else>evening</if></if>!"
msgstr "Как же хорошо работает вентиляция!"

#. ja: うん、いい風だねえ
#. de: Ja, der Wind ist wunderbar erfrischend.
#. fr: Et le vent, si doux...
msgctxt "Balloon:7608:0:1"
msgid "This breeze is so refreshing, right?"
msgstr "Ветерок-то какой приятный, правда?"

#. ja: ねえ、聞きました？<br>障壁の外から人が…
#. de: Hast du von den Eindringlingen gehört?
#. fr: Vous avez entendu<nbsp>? Il paraît que des étrangers se sont introduits dans le dôme<nbsp>!
msgctxt "Balloon:7609:0:1"
msgid "Did you hear about the outsiders who managed to get past the dome?"
msgstr "Слышали про чужаков, что сумели проникнуть за купол?"

#. ja: あれ、本当なの…？
#. de: Stimmen die Gerüchte also wirklich?
#. fr: V-vrrraiment<nbsp>!?
msgctxt "Balloon:7610:0:1"
msgid "Wh-What!?"
msgstr "Ч-что?!"

#. ja: 飲めそうさ<br>いくらでも！
#. de: Ich könnte noch ein paar verdrücken!
#. fr: Franchement, je pourrais boire encore des litres<nbsp>!
msgctxt "Balloon:7611:0:1"
msgid "Just one more cup!"
msgstr "Я бы ещё кружечку!"

#. ja: ここを<br>こう通してっと…
#. de: Man muss zuerst den Nippel durch die Lasche ziehen<nbsp>...
#. fr: Il faut passer le fil par ici...
msgctxt "Balloon:7612:0:1"
msgid "Slip the needle through here, and then..."
msgstr "Продень иголку вот сюда, а потом..."

#. ja: 休憩だよ<br>あと少ししたら
#. de: Noch ein bisschen, dann kannst du dich ausruhen!
#. fr: Allez, courage<nbsp>! C'est bientôt la pause<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7613:0:1"
msgid "You're doing great, girl!<br>Just a bit longer and you can rest!"
msgstr "Молодчина!<br>Ещё чуть-чуть — и можно будет отдохнуть!"

#. ja: ぷう～～
#. de: Pjuuu.
#. fr: Rrrkt<nbsp>!
msgctxt "Balloon:7614:0:1"
msgid "Mrrrmm!"
msgstr "Мрррм!"

#. ja: ぷぷぅ♪
#. de: Pjujuuu ♪
#. fr: Pffft<nbsp>!♪
msgctxt "Balloon:7615:0:1"
msgid "Mrm.♪"
msgstr "Мрм.♪"

#. ja: ぷう～ぷう～…
#. de: Pjuu, pjuu ...
#. fr: Rrrkt... pffft<nbsp>!
msgctxt "Balloon:7616:0:1"
msgid "Hrrm... Thbbbpt!"
msgstr "Хрм... Пффф!"

#. ja: ぷう～ぷう～♪
#. de: Pjuu?
#. fr: Pffft<nbsp>! Pffft<nbsp>!♪
msgctxt "Balloon:7617:0:1"
msgid "Hummm!"
msgstr "Хммм!"

#. ja: ぷぷぷ～ぅ
#. de: Pjuuu ...
#. fr: Pft pft pft<nbsp>!
msgctxt "Balloon:7618:0:1"
msgid "Mrm mrrrm.♪"
msgstr "Мрм-мррм.♪"

#. ja: ぷぅん♪
#. de: Pju, pju ♡
#. fr: Rkt<nbsp>!♪
msgctxt "Balloon:7619:0:1"
msgid "Pfffbt!"
msgstr "Пффф!"

#. ja: ぷうぅ～
#. de: P-Pju?
#. fr: Pfiiit<nbsp>!
msgctxt "Balloon:7620:0:1"
msgid "Hmrf..."
msgstr "Хмр..."

#. ja: ヴェッ！
#. de: Uah!
#. fr: Thfffu<nbsp>!
msgctxt "Balloon:7621:0:1"
msgid "Hrmf!"
msgstr "Фу!"

#. ja: おいしいかい？
#. de: Schmeckt's?
#. fr: C'est bon, mon grand<nbsp>?
msgctxt "Balloon:7622:0:1"
msgid "Tasty?"
msgstr "Вкусно?"

#. ja: よ～しよし<br>今日も良いフカフカだ
#. de: Du hast ein ganz weiches Fell!
#. fr: T'as la fourrure toute douce<nbsp>!
msgctxt "Balloon:7623:0:1"
msgid "Fluffy as a cloud!"
msgstr "Мягонький, как облачко!"

#. ja: 商談に差し支えるよ
#. de: Diese Geschichte könnte dem Geschäftsabschluss in die Quere kommen.
#. fr: Ça risque de gêner les négociations, cette histoire...
msgctxt "Balloon:7624:0:1"
msgid "You've had enough."
msgstr "С тебя хватит. А то сорвёшь переговоры."

#. ja: くぅ～<br>たまらないな
#. de: Aaah, was für ein Genuss!
#. fr: Aaah, quel délice<nbsp>!
msgctxt "Balloon:7625:0:1"
msgid "Ahhh, that's the stuff!"
msgstr "А-а-а, вот это да!"

#. ja: 落ち着くわね<br>コーヒーは
#. de: Nichts entspannt mehr als ein köstlicher Kaffee.
#. fr: Rien de plus relaxant qu'un délicieux café.
msgctxt "Balloon:7626:0:1"
msgid "Nothing quite as relaxing as a cup of coffee."
msgstr "Нет ничего лучше чашечки кофе, чтобы расслабиться."

#. ja: ここまで<br>良い香りがするよ
#. de: Und frisch geröstet ist er auch.
#. fr: Ça sent super bon jusqu'ici<nbsp>!
msgctxt "Balloon:7627:0:1"
msgid "It certainly has a lovely aroma..."
msgstr "Аромат у него, конечно, чудесный..."

#. ja: 今後伸びそうな商品は…
#. de: Weißt du, was sich bestimmt hervorragend verkaufen ließe?
#. fr: Voici la prochaine ressource que je voudrais exporter...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7628:0:1"
msgid "I daresay mezcal may<br>sell well as an export..."
msgstr "Мескаль, пожалуй,<br>будет хорошо продаваться на экспорт..."

#. ja: ふむふむ
#. de: Spuck's aus, ich bin ganz Ohr.
#. fr: Hmm, je vois...
msgctxt "Balloon:7629:0:1"
msgid "Not if we drink it all first."
msgstr "Да мы его сами выпьем раньше."

#. ja: 流行りの品だよ<br>おひとつどうかな？
#. de: Greif zu! Dieser Artikel ist gerade in aller Munde!
#. fr: C'est très populaire<nbsp>! Vous voulez goûter<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7630:0:1"
msgid "So what do you say?<br>It's a good deal, isn't it?"
msgstr "Ну как вам?<br>Выгодное предложение, правда?"

#. ja: お安くならない？
#. de: Wie unappetitlich ...
#. fr: Vous me faites une petite réduction<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7631:0:1"
msgid "Lower it a few pel<br>and we can talk."
msgstr "Скиньте пару пелов —<br>тогда и поговорим."

#. ja: ぷう？
#. de: Pju?
#. fr: Pffft<nbsp>!
msgctxt "Balloon:7632:0:1"
msgid "Mrm?"
msgstr "Мрм?"

#. ja: ぷぷぅ～♪
#. de: Pjuuu ♪
#. fr: Pft pft  pffft<nbsp>!♪
msgctxt "Balloon:7633:0:1"
msgid "Hrrrm.♪"
msgstr "Хррм.♪"

#. ja: ぷぅぷぅ♪
#. de: Pju, pju ♪
#. fr: Rkt<nbsp>!♪
msgctxt "Balloon:7634:0:1"
msgid "Mrm hrm.♪"
msgstr "Мрм-хрм.♪"

#. ja: これはあっちに…っと
#. de: Das kommt dahin<nbsp>...
#. fr: Alors, ça, ça va là.
msgctxt "Balloon:7635:0:1"
msgid "Put these over there..."
msgstr "Это отнесу туда..."

#. ja: よく乾燥させなくちゃ
#. de: Lieber etwas zu lange trocknen als zu kurz.
#. fr: Il faut bien laisser sécher les grains.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7636:0:1"
msgid "These could use<br>more time to dry."
msgstr "Надо дать этому<br>ещё подсохнуть."

#. ja: ういうい<br>このコクがいいね
#. de: Ich finde ihn eher nussig-bitter.
#. fr: Hop hop, il est fort comme j'aime<nbsp>!
msgctxt "Balloon:7637:0:1"
msgid "Oh yes, it's quite nice."
msgstr "О да, недурно."

#. ja: 良い香りねぇ
#. de: Ah, genau die richtige Note: erdig-herb!
#. fr: Quel arôme... Je ne m'en lasse pas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7638:0:1"
msgid "It has a robust flavor,<br>doesn't it?"
msgstr "Крепкий аромат,<br>правда?"

#. ja: 待つとしよう<br>出荷までのんびりと
#. de: Die können sich ruhig noch etwas Zeit lassen mit der Auslieferung.
#. fr: J'attends tran<shy>quil<shy>le<shy>ment la cargaison, moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7639:0:1"
msgid "May as well relax until it's<br>time for the next shipment."
msgstr "Пока можно отдохнуть,<br>пока не прибыл следующий груз."

#. ja: 傷つけないように…っと
#. de: Vorsichtig ... Die Bohnen sollen nicht zu Schaden kommen.
#. fr: Je dois faire bien attention à ne pas les abîmer<nbsp>!
msgctxt "Balloon:7640:0:1"
msgid "Need to pluck carefully, now..."
msgstr "Только бы не повредить..."

#. ja: たくさん実ったね
#. de: Was für pralle Hülsen!
#. fr: Regardez-moi tous ces grains<nbsp>!
msgctxt "Balloon:7641:0:1"
msgid "My, this one bore many fruit!"
msgstr "Ух ты, сколько плодов!"

#. ja: 良い出来だわ
#. de: Das nenne ich eine gute Ernte!
#. fr: C'est une bonne récolte<nbsp>!
msgctxt "Balloon:7642:0:1"
msgid "We've quite the harvest here!"
msgstr "Вот это урожай!"

#. ja: それで満腹かい？
#. de: Genug gegessen?
#. fr: C'est bon, tu as assez mangé<nbsp>?
msgctxt "Balloon:7643:0:1"
msgid "Sated?"
msgstr "Наелись?"

#. ja: ええ<br>マテ茶もあるしね
#. de: Ja! Und jetzt noch einen Mate-Tee.
#. fr: Oui<nbsp>! En plus, il y a du thé maté, donc c'est parfait.
msgctxt "Balloon:7644:0:1"
msgid "I am. I still have tea, besides."
msgstr "Ага. Ещё и матэ осталось."

#. ja: ういうい<br>元気に育ってる～
#. de: Sehen sie nicht prächtig aus, die Teepflanzen?
#. fr: Hop hop, les plants sont en bonne santé<nbsp>!
msgctxt "Balloon:7645:0:1"
msgid "This one's also growing healthily."
msgstr "И этот растёт на славу."

#. ja: 変な虫は<br>ついてないわね
#. de: Und nicht ein Schädling in Sicht.
#. fr: Je ne vois aucun insecte sur les feuilles.
msgctxt "Balloon:7646:0:1"
msgid "Good, I don't see any pests."
msgstr "Отлично, вредителей не видно."

#. ja: ういうい<br>準備しておきますよ
#. de: Gute Idee! Ich werde mich um die Vor<shy>bereitungen kümmern.
#. fr: Hop hop, bonne idée<nbsp>! Je vais m'occuper des préparatifs<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7647:0:1"
msgid "A lovely idea. I'll see<br>to the arrangements."
msgstr "Отличная мысль. Я займусь<br>подготовкой."

#. ja: 揃ってるよ<br>いい品が！
#. de: Alles von feinster Qualität.
#. fr: Il y a plein de mar<shy>chan<shy>di<shy>ses de qualité<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7648:0:1"
msgid "Get your local<br>specialties here!"
msgstr "Налетай, местные<br>диковинки!"

#. ja: どれも　これも<br>高品質モブ…
#. de: So viele gute Waren!
#. fr: Le Mobelin est im<shy>pres<shy>sion<shy>né<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7649:0:1"
msgid "My, everything looks<br>like a qualitymake!"
msgstr "Ух ты, какие товары<br>высокого качества!"

#. ja: 商人同士<br>交流会はどうかな
#. de: Was hältst du davon, eine Versammlung für alle Straßenhändler zu organisieren?
#. fr: Qu'est-ce que tu dirais d'organiser un ras<shy>sem<shy>ble<shy>ment de marchands ambulants<nbsp>?
msgctxt "Balloon:7650:0:1"
msgid "What would you say to a gathering of our fellow merchants?"
msgstr "Как тебе идея собрать наших торговцев?"

#. ja: これが限界<br>値引きはできねえ！
#. de: Billiger kann ich es nicht machen, sonst zahle ich drauf!
#. fr: Je peux pas vous le faire moins cher que ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7651:0:1"
msgid "I refuse! I've lowered<br>the price enough!"
msgstr "Нет! Я и так уже<br>цену сбросил!"

#. ja: なんとまろやかな味…
#. de: So weich und vollmundig!
#. fr: Il est si doux en bouche<nbsp>!
msgctxt "Balloon:7652:0:1"
msgid "Yeah, it's damned smooth..."
msgstr "Да уж, до чего мягкий вкус..."

#. ja: いい酒でしょう？
#. de: Ein guter Tropfen, nicht wahr?
#. fr: Il est bon, cet alcool, hein<nbsp>?
msgctxt "Balloon:7653:0:1"
msgid "Quality liquor, isn't it?"
msgstr "Хороший напиток, правда?"

#. ja: ペルペル族が<br>目を付けていると噂の…
#. de: Das ist es, was die Pelupelu lieben.
#. fr: C'est ça dont les Pelupelu raffolent...
msgctxt "Balloon:7654:0:1"
msgid "The Pelupelu are keen to purchase that item..."
msgstr "Слышал, пелупелу хотят закупить этот товар..."

#. ja: そんな品が？
#. de: Wirklich? Das?
#. fr: Vraiment<nbsp>? Ça<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7655:0:1"
msgid "How much are they<br>willing to pay?"
msgstr "И сколько они<br>за него дадут?"

#. ja: まけろ　まけろ！<br>お値段　下げろ！
#. de: Billiger! Mach es billiger!
#. fr: Allez, là<nbsp>! Baissez enqore un peu le prix, s'il vous plaît<nbsp>!
msgctxt "Balloon:7656:0:1"
msgid "Lower! Too expensive!"
msgstr "Скидывай цену! Дорого!"

#. ja: んはぁ～…
#. de: Aaah ...
#. fr: Hah...
msgctxt "Balloon:7657:0:1"
msgid "Ahhh..."
msgstr "А-а-а..."

#. ja: 旅の疲れが取れるよ
#. de: Genau das Richtige nach einer langen, staubigen Reise.
#. fr: Rien de tel pour soulager la fatigue après un long voyage<nbsp>!
msgctxt "Balloon:7658:0:1"
msgid "I can feel the aches of my travels just melting away..."
msgstr "Чувствую, усталость после дороги как рукой сняло..."

#. ja: マスクの中まで<br>しっとり　つやつや…
#. de: So ein heißes Bad glättet die gestresste Haut unter der Gesichtsscheibe.
#. fr: Même la peau du visage sous le masque du Mobelin est toute douce<nbsp>!
msgctxt "Balloon:7659:0:1"
msgid "Skin feels all moist and slick─even under mobbiemask!"
msgstr "Кожа вся увлажнённая и гладкая — даже под маской мобби."

#. ja: 湯上がりの一杯…<br>最高だな！
#. de: Ja, zwei Glas Mezcal nach einem heißen Bad.
#. fr: Je ne connais rien de meilleur qu'un verre de mezcal juste après un bain chaud.
msgctxt "Balloon:7660:0:1"
msgid "Nothing beats a drink after a hot bath!"
msgstr "Нет ничего лучше выпивки после горячей ванны!"

#. ja: 美味しそうねぇ
#. de: Gibt es etwas Besseres als ein Glas Mezcal direkt nach einem heißen Bad?
#. fr: Ça a l'air délicieux<nbsp>!
msgctxt "Balloon:7661:0:1"
msgid "You're only going to order mezcal?"
msgstr "Закажешь только мескаль?"

#. ja: メスカルだ<br>気に入ったものでな
#. de: Der Mezcal mundet vorzüglich.
#. fr: C'est du mezcal. Je trouve ça EXCELLENT.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7662:0:1"
msgid "Indeed. I'm rather<br>fond of the stuff."
msgstr "Да. Я его<br>очень люблю."

#. ja: それはペルペル族の？
#. de: Die Pelupelu sind klein, aber im Schnapsbrennen ganz groß.
#. fr: C'est une SPÉCIALITÉ pelupelu<nbsp>?
msgctxt "Balloon:7663:0:1"
msgid "You're drinking mezcal?"
msgstr "Ты пьёшь мескаль?"

#. ja: 畑仕事のあとは<br>酒がうまい
#. de: Den ganzen Tag haben wir geackert.
#. fr: Oh que oui<nbsp>! Puis un bon VERRE d'alcool après une dure journée de labeur, y a que ça de vrai<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7664:0:1"
msgid "There's no better time than<br>after a hard day's work."
msgstr "После тяжёлого дня в поле<br>выпивка — самое то."

#. ja: よく働いたとも
#. de: Diese Pause haben wir uns redlich verdient!
#. fr: On l'a bien MÉRITÉE, cette pause<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7665:0:1"
msgid "I'm impressed you can drink.<br>I'm utterly exhausted."
msgstr "Восхищаюсь, что ты ещё можешь пить.<br>Я совершенно без сил."

#. ja: 壁画の様子は？
#. de: Was macht das Wandbild?
#. fr: La FRESQUE avance bien<nbsp>?
msgctxt "Balloon:7666:0:1"
msgid "How fare the murals?"
msgstr "Как там фрески?"

#. ja: つつがなく…
#. de: Ich komme voran.
#. fr: Oui, tout se passe SANS problème<nbsp>!
msgctxt "Balloon:7667:0:1"
msgid "For a blessing, well."
msgstr "Всё идёт как по маслу..."

#. ja: つ、疲れたぁ…
#. de: Puh ... Ich bin komplett im Eimer.
#. fr: J'suis crevé...
msgctxt "Balloon:7668:0:1"
msgid "Whew..."
msgstr "Уф..."

#. ja: これはいいものだ…
#. de: Was ein heißer Schlitten ...
#. fr: En voilà un sacré bolide...
msgctxt "Balloon:7669:0:1"
msgid "What a beauty..."
msgstr "Ну и красавец..."

#. ja: キープ内のお仕事<br>うまくいってる？
#. de: Wie läuft die Arbeit im Immerfried?
#. fr: Alors, comment se passe ton boulot dans la Gardienne<nbsp>?
msgctxt "Balloon:7670:0:1"
msgid "How fares your new Everkeep assignment?"
msgstr "Как идут дела на новом месте в Вечном оплоте?"

#. ja: あら、数が足りない？<br>倉庫を確認しないと…
#. de: Hm? Fehlt da etwa was? Lieber mal das Lager prüfen ...
#. fr: On dirait qu'il en manque... Je vais vérifier dans l'entrepôt.
msgctxt "Balloon:7671:0:1"
msgid "Wait─we're one short? I'll check the storehouse..."
msgstr "Погоди, одной не хватает? Надо проверить склад..."

#. ja: 在庫は<br>これであってるわね
#. de: Das ist dann wohl alles.
#. fr: Jusqu'ici, le compte est bon.
msgctxt "Balloon:7672:0:1"
msgid "Everything looks to be accounted for..."
msgstr "Вроде всё на месте..."

#. ja: 軽食を作ったけど<br>食べるかい？
#. de: Einen kleinen Happen für zwischendurch gefällig?
#. fr: Je me suis fait un encas. On partage<nbsp>?
msgctxt "Balloon:7673:0:1"
msgid "Could I interest anyone in a light meal?"
msgstr "Кому-нибудь лёгкий перекус?"

#. ja: 気が利く～！<br>ありがとう、いただくわ！
#. de: Aber immer doch! Das lasse ich mir nicht zweimal sagen!
#. fr: C'est vrai, je peux t'en piquer<nbsp>? Merci, t'es le meilleur<nbsp>!
msgctxt "Balloon:7674:0:1"
msgid "That would be wonderful, thank you!"
msgstr "С радостью, спасибо!"

#. ja: もう少し話したら<br>中に入るわね
#. de: Nur noch ein kleiner Tratsch.
#. fr: Promis, on retourne au boulot dès qu'on a fini.
msgctxt "Balloon:7675:0:1"
msgid "Let me just finish telling this story first."
msgstr "Дай только договорю, и пойду внутрь."

#. ja: 了解、了解<br>ゆっくりするといいよ
#. de: Kein Stress. Lass dir alle Zeit der Welt.
#. fr: Pas de problème. Profitez bien de votre pause<nbsp>!
msgctxt "Balloon:7676:0:1"
msgid "Of course, sweetheart. I'll see you inside."
msgstr "Конечно, милая. Увидимся внутри."

#. ja: 機器の様子は<br>どうだい？
#. de: Ist mit den Säulen alles in Ordnung?
#. fr: Comment ça se présente<nbsp>?
msgctxt "Balloon:7677:0:1"
msgid "Any problems with the machinery?"
msgstr "Как там оборудование? Всё в порядке?"

#. ja: 見たところ<br>問題なさそうですよ
#. de: Ja, es gibt nichts zu berichten.
#. fr: À première vue, aucun problème à signaler.
msgctxt "Balloon:7678:0:1"
msgid "Everything looks to be stable, sir!"
msgstr "На первый взгляд, всё стабильно, сэр!"

#. ja: そりゃよかった<br>この町の生命線だからな…
#. de: Sehr gut. Sie sind es, die uns das Leben hier ermöglichen.
#. fr: Touchons du bois<nbsp>! Toute la ville dépend de ce dispositif...
msgctxt "Balloon:7679:0:1"
msgid "It had better be, or this town will fall apart."
msgstr "И хорошо. Без него весь город развалится..."

#. ja: ここなら<br>やっていけるかな…
#. de: Ich glaube, dieser Ort ist wie für mich gemacht.
#. fr: Je crois que cet endroit sera parfait pour moi.
msgctxt "Balloon:7680:0:1"
msgid "This place will be good for me, I can feel it."
msgstr "Чую, здесь мне будет хорошо."

#. ja: 次はどんなものを<br>作るつもりなんだい？
#. de: Was willst du als Nächstes herstellen?
#. fr: Qu'est-ce que tu comptes fabriquer, d'ailleurs<nbsp>?
msgctxt "Balloon:7681:0:1"
msgid "What'll you make next?"
msgstr "Что будешь делать дальше?"

#. ja: まだ悩んでるところだ…
#. de: Das habe ich noch nicht entschieden.
#. fr: J'hésite encore.
msgctxt "Balloon:7682:0:1"
msgid "I haven't decided yet."
msgstr "Пока не решил."

#. ja: おや珍しい<br>いつでも相談に乗るよ
#. de: Das sieht dir gar nicht ähnlich. Wenn du Ideen brauchst, ich habe jede Menge!
#. fr: Ça te ressemble pas, dis donc. Je suis prête à te donner des idées, si tu veux<nbsp>!
msgctxt "Balloon:7683:0:1"
msgid "My, that's not like you. If you need any ideas, I'm full of them!"
msgstr "Вот это на тебя не похоже. Если нужны идеи — у меня их полно!"

#. ja: ええと<br>ここに置くんだよな…？
#. de: Mal sehen ... Soll ich das hier hinstellen?
#. fr: Bien, voyons... Est-ce que je pose ça là<nbsp>?
msgctxt "Balloon:7684:0:1"
msgid "Let's see... Should I put this here?"
msgstr "Так... Это сюда поставить?"

#. ja: そこに出しておくの<br>この箱であってる？
#. de: Äh, sag mal ... Das ist doch die richtige Kiste, oder?
#. fr: Euh, dis... C'est bien cette boîte-là, hein<nbsp>?
msgctxt "Balloon:7685:0:1"
msgid "Hey, is this the right box?"
msgstr "Эй, это та самая коробка?"

#. ja: あら、それじゃないわよ<br>ラベルを確認して
#. de: Nein, ist sie nicht! Schau mal auf das Etikett.
#. fr: Non, tu te trrrompes<nbsp>! Vérifie un peu l'étiquette.
msgctxt "Balloon:7686:0:1"
msgid "It's the wrong one─check the label!"
msgstr "Нет, не та! Посмотри на этикетку!"

#. ja: えっ？<br>これじゃなかったか…
#. de: Hm? Bist du sicher?
#. fr: Ah, bon<nbsp>!? T'es sûre<nbsp>?
msgctxt "Balloon:7687:0:1"
msgid "Huh? Are you sure?"
msgstr "А? Ты уверена?"

#. ja: 倉庫に目録もあるから<br>それを見てみて
#. de: Es gibt eine Liste im Lager. Schau dort nach.
#. fr: Il y a aussi un registrrre dans la réserve. Tu ferais bien d'y jeter un œil.
msgctxt "Balloon:7688:0:1"
msgid "There's a list in the storeroom. I suggest you read it closely."
msgstr "На складе есть список. Советую внимательно его изучить."

#. ja: 大物を狙うのは<br>じっと待つのが肝心…
#. de: Ein großer Fang erfordert große Geduld.
#. fr: La pêche au gros est une affaire de patience, hou<nbsp>!
msgctxt "Balloon:7689:0:1"
msgid "A great catch requires great patience."
msgstr "Чтобы поймать крупную рыбу, нужно запастись терпением."

#. ja: ここで試してみよう…
#. de: Mal sehen, ob hier etwas anbeißt.
#. fr: Voyons si ça mord par ici, hou hou<nbsp>!
msgctxt "Balloon:7690:0:1"
msgid "This seems like a good spot to cast."
msgstr "Попробую закинуть удочку здесь..."

#. ja: 大きい魚が釣りたいなぁ～
#. de: Hoffentlich zieh ich heute mal einen an Land, der größer ist als ich.
#. fr: J'aimerais tant attraper un gros poisson.
msgctxt "Balloon:7691:0:1"
msgid "Maybe today I'll catch a fish larger than myself..."
msgstr "Вот бы сегодня поймать рыбу крупнее меня..."

#. ja: むむむ<br>場所を変えてみよう…
#. de: Hmm ... Ich werde woanders mein Glück versuchen.
#. fr: Hoooum... Mieux vaut que j'essaie autre part.
msgctxt "Balloon:7692:0:1"
msgid "Hmm... It might be time to move."
msgstr "Хм... Пожалуй, пора сменить место."

#. ja: こっちに魚影は…
#. de: Ich seh doch, dass sich da was im Wasser bewegt!
#. fr: Je sens qu'il y a des poissons par ici<nbsp>!
msgctxt "Balloon:7693:0:1"
msgid "I can see the fish under the water!"
msgstr "Я же вижу, там под водой рыба!"

#. ja: おっと、ととと！<br>危ない、危ない！
#. de: Oha, oha! Ganz schön gefährlich!
#. fr: Hou, hou<nbsp>! Attention, attention<nbsp>!
msgctxt "Balloon:7694:0:1"
msgid "Whoooaaa!"
msgstr "Ой-ой-ой! Осторожно!"

#. ja: ここの竿もあたってない…
#. de: Hier beißt auch keiner ...
#. fr: Non... ça ne mord pas ici non plus.
msgctxt "Balloon:7695:0:1"
msgid "No bites here either..."
msgstr "И здесь не клюёт..."

#. ja: ふふ、この場所なら…<br>前に大きいのが釣れたし…
#. de: Der Fisch, den ich hier letztens geangelt hab, hat für eine ganze Woche gereicht!
#. fr: Hou, hou... J'ai pris un gros poisson ici, avant<nbsp>!
msgctxt "Balloon:7696:0:1"
msgid "The fish I caught here last time fed me for a week!"
msgstr "В прошлый раз я тут такую рыбину поймал, что её на неделю хватило!"

#. ja: 釣れない…<br>う～ん、何が悪いんだろ
#. de: Immer noch nichts ... Ich frage mich, was ich falsch mache.
#. fr: Toujours rien... Je me demande ce qui va pas.
msgctxt "Balloon:7697:0:1"
msgid "No bites... What am I doing wrong?"
msgstr "Не клюёт... Что же я делаю не так?"

#. ja: ちょっと待ってから<br>また挑戦しよう…
#. de: Ich werde eine Pause machen und es dann erneut versuchen ...
#. fr: Je vais réessayer un peu plus tard, hou.
msgctxt "Balloon:7698:0:1"
msgid "I'll take a break, then try again..."
msgstr "Немного передохну, а потом попробую ещё..."

#. ja: 調子はどうだい？
#. de: Na, wie läuft es? Beißen sie gut?
#. fr: Hou, alors, ça mord<nbsp>?
msgctxt "Balloon:7699:0:1"
msgid "How goes the fishing?"
msgstr "Ну как рыбалка?"

#. ja: んぁ…ぐぅ…！
#. de: \<gähn> Hm?
#. fr: Zzz... zzz<nbsp>!
msgctxt "Balloon:7700:0:1"
msgid "\\<snore> Zzz..."
msgstr ""

#. ja: …釣れてなさそうだね
#. de: Anscheinend nicht.
#. fr: On dirait bien que non.
msgctxt "Balloon:7701:0:1"
msgid "Not well, it seems."
msgstr "Похоже, не очень."

#. ja: いい感じかい？
#. de: Schon einer angebissen?
#. fr: Ça se passe bien<nbsp>?
msgctxt "Balloon:7702:0:1"
msgid "Any bites today?"
msgstr "Есть поклёвки?"

#. ja: とっても、とっても<br>いい感じ！
#. de: Ja, und was für einer!
#. fr: Hou, oui<nbsp>! Très très bien même<nbsp>!
msgctxt "Balloon:7703:0:1"
msgid "Too many to count!"
msgstr "Клюёт на славу! Не сосчитать!"

#. ja: さすがだねぇ～
#. de: Du hast es eben drauf!
#. fr: Ça ne m'étonne pas, hou<nbsp>!
msgctxt "Balloon:7704:0:1"
msgid "Well done!"
msgstr "Ну ты даёшь!"

#. ja: もうちょっと続けてみる！
#. de: Ich mache noch ein bisschen weiter.
#. fr: Je vais continuer encore un peu.
msgctxt "Balloon:7705:0:1"
msgid "I think I can catch a few more..."
msgstr "Поймаю-ка я ещё несколько..."

#. ja: それじゃあ<br>私は干物を見に戻るよ
#. de: Ist gut, ich sehe mal nach den getrockneten Fischen.
#. fr: Bien, moi, je vais retourner voir les poissons séchés.
msgctxt "Balloon:7706:0:1"
msgid "Good luck! I should go check on the dried fish."
msgstr "Удачи! А мне надо проверить сушёную рыбу."

#. ja: さてと、さてと<br>そろそろ魚の回収を…
#. de: Es ist Zeit, den Fisch zu fangen!
#. fr: Hou, je crois qu'il est temps d'aller récupérer les poissons<nbsp>!
msgctxt "Balloon:7707:0:1"
msgid "It's time to collect the fish!"
msgstr "Пора забирать рыбу!"

#. ja: ぐんぐん育ってね～
#. de: Das Schilf wächst gut und steckt schon wieder voller Leben!
#. fr: Ils poussent bien, hou<nbsp>!
msgctxt "Balloon:7708:0:1"
msgid "The reeds are bursting with life once again!"
msgstr "Камыш снова так и прёт!"

#. ja: いい色になったな…
#. de: Seine Farbe ist wunderschön ...
#. fr: Quelle belle couleur ils ont<nbsp>!
msgctxt "Balloon:7709:0:1"
msgid "They're beautiful..."
msgstr "Какие красивые..."

#. ja: 水質は問題ないな
#. de: Die Wasserqualität ist perfekt.
#. fr: La qualité de l'eau est parfaite, hou<nbsp>!
msgctxt "Balloon:7710:0:1"
msgid "The water is just right."
msgstr "Вода в самый раз."

#. ja: 水の深さも程よいか…
#. de: Auch die Tiefe scheint ideal zu sein.
#. fr: La profondeur semble idéale aussi.
msgctxt "Balloon:7711:0:1"
msgid "The depth looks perfect."
msgstr "И глубина в самый раз."

#. ja: この様子なら<br>葦不足は解消かな…？
#. de: Ich glaube, wir werden keinen Mangel an Schilf haben!
#. fr: Si tout se passe bien, nous n'aurons plus de pénurie de roseaux<nbsp>!
msgctxt "Balloon:7712:0:1"
msgid "I think our reed problems are behind us."
msgstr "Кажется, с нехваткой камыша покончено."

#. ja: うん、うん<br>見事な成長ぶりだ！
#. de: Ja, es wächst mit solcher Kraft!
#. fr: Hou, oui<nbsp>! Ils poussent avec vigueur<nbsp>!
msgctxt "Balloon:7713:0:1"
msgid "They grow with such vigor!"
msgstr "Вот это рост!"

#. ja: どこにしまったかしら？
#. de: Wo habe ich sie noch mal hingelegt?
#. fr: Où est-ce que je les ai mis, hou<nbsp>?
msgctxt "Balloon:7714:0:1"
msgid "Where did I put them again?"
msgstr "Куда же я их положила?"

#. ja: ここ…？
#. de: Hier?
#. fr: Dans celui-là<nbsp>?
msgctxt "Balloon:7715:0:1"
msgid "Here...?"
msgstr "Здесь?.."

#. ja: ないわねぇ…
#. de: Nein, hier nicht ...
#. fr: Ah, non...
msgctxt "Balloon:7716:0:1"
msgid "Not here either..."
msgstr "Тут тоже нет..."

#. ja: 手入れ用の工具<br>どこにあるかわかる？
#. de: Hast du die Werkzeuge gefunden?
#. fr: Tu as trouvé les outils d'entretien<nbsp>?
msgctxt "Balloon:7717:0:1"
msgid "Have you seen my tools?"
msgstr "Ты не видел мои инструменты?"

#. ja: なんだ、なんだ<br>少し待ってろ
#. de: Bald. Ein bisschen Geduld bitte.
#. fr: Hou, un peu de patience<nbsp>!
msgctxt "Balloon:7718:0:1"
msgid "I thought they were yours. Hold on."
msgstr "А, так это твои? Погоди-ка."

#. ja: これだろ？<br>ちゃんと持っておけよ
#. de: Ah, hier ist es! Na los, nimm schon.
#. fr: Tiens, c'est ça, hein<nbsp>? Prends-les<nbsp>!
msgctxt "Balloon:7719:0:1"
msgid "...Here. Don't lose them again."
msgstr "...Вот. Смотри больше не теряй."

#. ja: ありがとう～！
#. de: Vielen Dank!
#. fr: Hou, merci beaucoup<nbsp>!
msgctxt "Balloon:7720:0:1"
msgid "I won't, I promise. Many thanks!"
msgstr "Не потеряю, честное слово! Спасибо!"

#. ja: 僕に話って何だい？
#. de: Du wolltest mir etwas sagen?
#. fr: Hou hou, qu'est-ce que tu voulais me dire<nbsp>?
msgctxt "Balloon:7721:0:1"
msgid "You said he wanted to talk?"
msgstr "Ты сказал, он хотел со мной поговорить?"

#. ja: さっそく話したいが…
#. de: Das würde ich gerne, aber ...
#. fr: J'aimerais vous en parler...
msgctxt "Balloon:7722:0:1"
msgid "Yes, but..."
msgstr "Да, но..."

#. ja: コイツが<br>起きてるんだか寝てるんだか…
#. de: Ich weiß nicht, ob er wach ist oder schläft ...
#. fr: Mais je sais pas s'il est éveillé ou s'il dort, lui, hou<nbsp>!
msgctxt "Balloon:7723:0:1"
msgid "I don't know if he's awake or asleep..."
msgstr "Не пойму, он спит или не спит..."

#. ja: わかった、わかった<br>またあとで来るよ
#. de: Ach so ... Ich kann ja später wiederkommen.
#. fr: Dans ce cas-là, je reviendrai plus tard.
msgctxt "Balloon:7724:0:1"
msgid "I see... Well, I suppose I can come back later!"
msgstr "Понятно... Ладно, тогда зайду попозже!"

#. ja: そろそろ<br>起きたかな…？
#. de: Ist er schon wach?
#. fr: Hou, alors<nbsp>? Il s'est réveillé<nbsp>?
msgctxt "Balloon:7725:0:1"
msgid "He should be awake by now..."
msgstr "Уже, наверное, проснулся?.."

#. ja: う～ん…<br>眠い…寝ちゃおう…
#. de: Ich kann meine Augen kaum offen halten ... Hmm ... Ich werde ein bisschen dösen.
#. fr: Hooou... J'ai trop sommeil... Je vais faire un petit dodo.
msgctxt "Balloon:7726:0:1"
msgid "I can barely keep my eyes open... Hmm... Time for a short nap."
msgstr "Уф... Глаза слипаются... Пожалуй, немного вздремну."

#. ja: お～い<br>仕事の時間だよ～
#. de: Es ist Zeit, mit der Arbeit zu beginnen!
#. fr: Hou<nbsp>! C'est l'heure d'aller travailler<nbsp>!
msgctxt "Balloon:7727:0:1"
msgid "It's time to get to work!"
msgstr "Пора за работу!"

#. ja: 了解、了解<br>すぐ行くよ
#. de: Schon gut, schon gut. Ich komme ja schon!
#. fr: D'accord. Donne-moi une minute et j'y vais.
msgctxt "Balloon:7728:0:1"
msgid "All right, all right. I'll be there soon!"
msgstr "Ладно-ладно, скоро буду!"

#. ja: それで、それで<br>魚を捕るいい仕掛けが…
#. de: Also, die beste Falle, um Fische zu fangen, ist ...
#. fr: Et donc, le meilleur piège pour attraper des poissons...
msgctxt "Balloon:7729:0:1"
msgid "Now, the best trap to catch fish is..."
msgstr "Так вот, лучшая ловушка для рыбы — это..."

#. ja: 興味深い話だが<br>仕事はいいのか？
#. de: Sehr interessant, aber ... solltest du nicht arbeiten?
#. fr: Ce que tu racontes est intéressant, mais tu ferais pas mieux d'aller travailler<nbsp>?
msgctxt "Balloon:7730:0:1"
msgid "Interesting, interesting. But shouldn't you get to work?"
msgstr "Интересно, интересно. А работать-то ты не собираешься?"

#. ja: ハッ…<br>そうだった！
#. de: Oh! Das habe ich ganz vergessen!
#. fr: Hooou<nbsp>! J'avais presque oublié<nbsp>!
msgctxt "Balloon:7731:0:1"
msgid "Oh! It completely slipped my mind!"
msgstr "Ах! Совсем вылетело из головы!"

#. ja: すぐ行くよー！
#. de: Ich muss los!
#. fr: Je file<nbsp>!
msgctxt "Balloon:7732:0:1"
msgid "He's going to pluck my feathers!"
msgstr "Он мне перья повыдёргивает!"

#. ja: やれやれ<br>こっちも作業に戻るか…
#. de: Ich hoffe, er schafft es ... Oh! Ich muss auch wieder ranklotzen!
#. fr: Tiens, moi aussi, je vais me remettre au boulot, hou<nbsp>!
msgctxt "Balloon:7733:0:1"
msgid "I hope he makes it... Oh! I'd better get back to work, too!"
msgstr "Надеюсь, у него всё получится... Ой! И мне пора за работу."

#. ja: ちょっと質問　緊急事態<br>素材の輝石　場所知らない？
#. de: Fallnot, große Fallnot! Haste meine Glitzersteine gesehen?
#. fr: Le Mobelin a une question urgente<nbsp>! Ses kamarades savent où sont les pierres brillantes<nbsp>?
msgctxt "Balloon:7734:0:1"
msgid "Dangerstraits! Have you seen my twinklestones?"
msgstr "Тревогабеда! Ты не видел мои блестяшки?"

#. ja: しっかり　かっちり<br>管理しろ～！
#. de: Schon wieder den Blickdurch verloren? Ist doch immer dasselbe!
#. fr: Bssshhhraaah<nbsp>! Il ferait bien de mieux gérer ses matériaux<nbsp>!
msgctxt "Balloon:7735:0:1"
msgid "Again!? You always lose them!"
msgstr "Опять?! Ты вечно их теряешь!"

#. ja: 古い木箱　交換したから<br>黄色い木箱の　中かもよ～
#. de: Wir haben die alten Bewahrenkisten ausgetauscht. Vielleicht in einer der gelben?
#. fr: La Mobeline se souvient avoir échangé la vieille qaisse. Les pierres sont sans doute dans la qaisse jaune.
msgctxt "Balloon:7736:0:1"
msgid "The old boxes were replaced with new ones. Your twinklestones might be in a yellow one."
msgstr "Старые ящики заменили новыми. Может, твои блестяшки в жёлтом?"

#. ja: とてとて　ありがと！<br>探してみる！
#. de: Dankeviel! Ich schau gleich mal nach!
#. fr: Bssshhhouaaah<nbsp>! Merci, merci beaukoup<nbsp>! Il va chercher la kaisse<nbsp>!
msgctxt "Balloon:7737:0:1"
msgid "Oh, thank you, thank you! I will look!"
msgstr "Ой, спасибо-спасибо! Пойду искать!"

#. ja: よかったあった　輝石箱！<br>黄色い箱に　変わってた！
#. de: Fshkhooo, bin ich froh! Die Glitzersteine waren tatsächlich in der Gelbkiste!
#. fr: Bssshhhaaah<nbsp>! Le brave Mobelin l'a trouvée<nbsp>! La kaisse jaune avec les pierres précieuses<nbsp>!
msgctxt "Balloon:7738:0:1"
msgid "Oh, happyfeels! I found my twinklestones!"
msgstr "Ой, как я рад! Нашёл свои блестяшки!"

#. ja: まったく　とっても<br>お騒がせ～！
#. de: Du bist wirklich ein Dusselschussel! Das muss sich mal ändern!
#. fr: Il fait beaukoup de bruit, franchement<nbsp>!
msgctxt "Balloon:7739:0:1"
msgid "Don't misplace them again!"
msgstr "Смотри больше не теряй!"

#. ja: 素材の管理　木箱の整理<br>ちゃ～んとやって　おくんだぞ～
#. de: Materialsachen und Bewahrenkisten müssen immer tipptopp in Schuss sein, hörste?
#. fr: Oui<nbsp>! Ça arriverait pas, si le Mobelin rangeait mieux ses matériaux et ses qaisses<nbsp>!
msgctxt "Balloon:7740:0:1"
msgid "You must keep carefulwatch over storage and supplies! Don't let them get mixed up."
msgstr "За запасами и ящиками следи в оба! Не путай их!"

#. ja: さっそく　ばっちり<br>やってくる！
#. de: Klaro, werd ich mir ohrenschreiben!
#. fr: Avek ça, il va pouvoir demander à la main-du-pot de se mettre au travail<nbsp>!
msgctxt "Balloon:7741:0:1"
msgid "I won't make any more mistakes!"
msgstr "Больше ни за что не ошибусь!"

#. ja: いけいけ　どんどん<br>応援してるモブ～！
#. de: Wunderprächtig! Weiter so!
#. fr: Allez, qourage<nbsp>! La gentille Mobeline est de tout qœur avec la brave main-du-pot<nbsp>!
msgctxt "Balloon:7742:0:1"
msgid "Wonderdeeds! Keep it up!"
msgstr "Вот это да! Так держать!"

#. ja: 完成が見えてきたぞ！
#. de: Ah, so langsam nimmt es Gestalt an!
#. fr: Merci<nbsp>! J'ai presque fini<nbsp>!
msgctxt "Balloon:7743:0:1"
msgid "It's all coming together!"
msgstr "Уже видно, что получится!"

#. ja: 鉱石　消費　とてとて早い<br>早めに補給　したいぞな！
#. de: Uns gehen ständig die Erzsteine aus. Wir brauchen dringend Schubnach!
#. fr: La konsommation de minerai est très importante<nbsp>! Les Mobelins aimeraient vite en avoir davantage<nbsp>!
msgctxt "Balloon:7744:0:1"
msgid "Ore disappears in an eyeblink! We need more!"
msgstr "Руда улетает вмиг! Надо бы пополнить запасы!"

#. ja: 人から聞いた　流行色<br>ピカピカキラキラ　金色ね
#. de: Glitzerige Goldtöne sind gerade der Letztschrei, hab ich gehört.
#. fr: La Mobeline l'a entendu de la bouche d'un humain<nbsp>! La qouleur dorée est très populaire<nbsp>!
msgctxt "Balloon:7745:0:1"
msgid "Golden glitterstones are all the rage, I've heard!"
msgstr "Слышал от людей: золотые блестяшки сейчас в моде!"

#. ja: えいや～！　そいや～！<br>モブも鍛えて　ムキムキだ～！
#. de: Ob in Viele Flammen oder am Toari-See, starke Moblins sind nie passé ♪
#. fr: Bssshhhouoooh<nbsp>! Le brave Mobelin va devenir très kostaud<nbsp>!
msgctxt "Balloon:7746:0:1"
msgid "One, two! One, two! Moblins can be burlystrong, too!"
msgstr "Раз-два! Раз-два! Моблины тоже могут стать силачами!"

#. ja: 壺匠も世話人も<br>体を鍛えて困ることなしッ！
#. de: Ein paar Muskeln haben noch keinem geschadet, und he, das Lied ist ein echter Ohrwurm!
#. fr: Exactement<nbsp>! On va tous les deux travailler nos corps comme des objets d'artisanat<nbsp>!
msgctxt "Balloon:7747:0:1"
msgid "That's right! We'll temper our bodies like a weapon!"
msgstr "Вот именно! Натренируем тело, как оружие!"

#. ja: 少し赤みのある<br>緑っぽい容器がいいなぁ
#. de: Ein Grünton, der etwas ins Rötliche geht, wäre schön.
#. fr: Cette poterie verrrdâtre aux reflets rouges est magnifique<nbsp>!
msgctxt "Balloon:7748:0:1"
msgid "Something greenish with a bit of red would be nice."
msgstr "Хорошо бы что-нибудь зеленоватое, с красным оттенком."

#. ja: よしきたわかった　大丈夫！<br>モブにお任せ　大安心！
#. de: Klar, Nullproblem! Lass mich mal machen!
#. fr: Bssshhhoh<nbsp>! La Mobeline a qompris<nbsp>! Elle va s'en charger pour la qliente<nbsp>!
msgctxt "Balloon:7749:0:1"
msgid "Understood! Mobbie will craftymake you something astounding!"
msgstr "Понял! Мобби смастерит тебе что-нибудь потрясающее!"

#. ja: さてさて<br>何が釣れるかな～？
#. de: Also, was ziehen wir heute Leckeres an Land?
#. fr: Hou, voyons, voyons... Qu'est-ce que je vais attraper aujourd'hui<nbsp>?
msgctxt "Balloon:7750:0:1"
msgid "What will I catch today?"
msgstr "Ну-ка, что сегодня поймаю?"

#. ja: 水辺は好きだが<br>大嵐の日は酷かった…
#. de: Ich bin ja gern am Wasser, aber während des großen Sturmes hat mir der Fluss ordentlich Angst gemacht.
#. fr: J'aime bien aller sur la rive, mais le jour de la tempête, c'était très dangereux, ja<nbsp>!
msgctxt "Balloon:7751:0:1"
msgid "Gazing at the rivers usually sets my mind at ease, but during the storm they were a nightmare..."
msgstr "Люблю сидеть у реки, да во время шторма было жутко..."

#. ja: 川の増水には<br>ヒヤヒヤさせられたわね
#. de: Ja, mir stand angesichts der reißenden Fluten auch das Fell zu Berge<nbsp>...
#. fr: Ouais, j'ai eu les chocottes quand j'ai vu que la rivière débordait.
msgctxt "Balloon:7752:0:1"
msgid "I know what you mean. The flooding waters were a chilling sight."
msgstr "Ужасно было смотреть, как река выходит из берегов."

#. ja: 言っていた物資は<br>これだったか？
#. de: Sind das die Vorräte, die du meintest?
#. fr: La caisse rectangulaire dont tu parlais est drôlement lourde, dis donc<nbsp>?
msgctxt "Balloon:7753:0:1"
msgid "Are these the goods you were talking about?"
msgstr "Это те припасы, о которых ты говорил?"

#. ja: 違うよぉ！<br>もっと大きな箱！
#. de: Nein, nein! Die <i>große</i> Kiste, hab ich gesagt!
#. fr: Espèce de crétin<nbsp>! Je t'ai pourtant bien dit que tu devais rapporter une caisse carrée, pas une rectangulaire<nbsp>!
msgctxt "Balloon:7754:0:1"
msgid "No! The crate I'm looking for is much bigger!"
msgstr "Нет же! Мне нужен ящик гораздо больше!"

#. ja: やれやれ…<br>また持ってくるよ
#. de: Verflucht<nbsp>... Bin gleich zurück.
#. fr: Flûte<nbsp>! J'y retourne, alors<nbsp>!
msgctxt "Balloon:7755:0:1"
msgid "You're serious, aren't you? Well, I'll be back then..."
msgstr "Ну и ну... Ладно, принесу другой."

#. ja: 息子の風魔法が<br>上達しなくて…
#. de: Mein Sohn bekommt den Wind einfach nicht so recht zu fassen<nbsp>...
#. fr: Mon fils a vraiment du mal à maîtriser les sorts de vent.
msgctxt "Balloon:7756:0:1"
msgid "My son struggles to command the wind."
msgstr "Сыну никак не даётся магия ветра."

#. ja: どうするかな、次の取引は…<br>お前はどう思う？
#. de: Also, was sagst du? Zu unserem nächsten großen Handel?
#. fr: Où est-ce qu'on va pouvoir faire affaire la prochaine fois<nbsp>? Hop hop, t'en penses quoi<nbsp>?
msgctxt "Balloon:7757:0:1"
msgid "Where shall we strike our next deal, I wonder? What do you think?"
msgstr "Интересно, где заключить следующую сделку... Как думаешь?"

#. ja: 落ちる～～！
#. de: Fshkhooo, Tiefersturz! Schlimmerfall!
#. fr: Bssshhhaaah<nbsp>! Le pauvre Mobelin va tomber<nbsp>!
msgctxt "Balloon:7758:0:1"
msgid "I'm going to tumblefall!"
msgstr "Сейчас упаду-у-у!"

#. ja: 高くないし　痛くない<br>はやくその手を　離すんだ
#. de: Es ist doch gar keine Schlimmhöhe! Lass doch einfach los, fshkhooo.
#. fr: C'est pas haut<nbsp>! Il aura pas mal<nbsp>! Qu'il se laisse tomber<nbsp>!
msgctxt "Balloon:7759:0:1"
msgid "It's not high! Just fall─you'll barely hurtyfeel it! Let go!"
msgstr "Тут невысоко! Отпускай — почти не больно! Давай!"

#. ja: い～～や～～<br>モ～～ブ～～
#. de: N-Nein! Ich hab zu große Zitterangst! Dann häng ich hier eben für Ewigimmer, fshkhooo!
#. fr: Bssshhh... Non<nbsp>! Il a trop peur<nbsp>! Et il a une krampe au mollet<nbsp>!
msgctxt "Balloon:7760:0:1"
msgid "Nooo! Neveeer!"
msgstr "Нееет! Ни за что-о-о!"

#. ja: ホバーカーゴ<br>買い替え時か…？
#. de: Ob wohl langsam die Zeit für einen neuen Schwebefrachter gekommen ist ...?
#. fr: Il serait peut-être temps de renouveler les cargos...
msgctxt "Balloon:7761:0:1"
msgid "Perhaps it's time we replaced our hover cargo."
msgstr "Может, пора менять наш грузовой ховеркар?"

#. ja: 今日の出物は…と
#. de: Was gibts denn heute so?
#. fr: Alooors, la livraison d'aujourd'hui...
msgctxt "Balloon:7762:0:1"
msgid "Now for today's shipment..."
msgstr "Так, что у нас сегодня в поставке..."

#. ja: 安全確認、どう？
#. de: Alles sicher?
#. fr: Que donne le contrôle de sécurité<nbsp>?
msgctxt "Balloon:7763:0:1"
msgid "How goes the safety assessment?"
msgstr "Ну как, проверка безопасности?"

#. ja: 帯雷してるエレクトロープは…<br>なし、問題なさそうだ
#. de: Keine Anzeichen von geladenem Elektrob<nbsp>... Alles sicher!
#. fr: Morceaux d'électrope surchargés en électricité... zéro. Tout m'a l'air en ordre.
msgctxt "Balloon:7764:0:1"
msgid "Lightning levels seem normal. All clear."
msgstr "Уровень заряда в электропах в норме. Всё чисто."

#. ja: 原石の届け先<br>どこに設定するんでしたっけ
#. de: Wo soll das rohe Elektrob noch mal zuerst hingeschickt werden?
#. fr: Où vont les pierres brutes, déjà<nbsp>?
msgctxt "Balloon:7765:0:1"
msgid "Remind me, where do we send the ore shipments?"
msgstr "Напомни, куда отправлять поставки руды?"

#. ja: 異物検査があるから<br>まず第一層だね
#. de: Da es Reinheitstests unterzogen werden muss, schicken wir es zunächst in die erste Ebene.
#. fr: Au rez-de-chaussée, pour le contrôle des impuretés.
msgctxt "Balloon:7766:0:1"
msgid "First level. It has to pass inspection, remember?"
msgstr "На первый уровень. Сначала её проверят на примеси."

#. ja: ややこしいよね～
#. de: Ganz schön kompliziert, was?
#. fr: C'est fastidieux, mais c'est comme ça...
msgctxt "Balloon:7767:0:1"
msgid "Bureaucracy at its finest."
msgstr "Вот ведь бюрократия."

#. ja: あれ…？<br>じゃあ設定あってたのかな…
#. de: Hm ...? Stimmten die Einstellungen etwa schon?
#. fr: Mince, je sais plus si j'ai paramétré la bonne destination...
msgctxt "Balloon:7768:0:1"
msgid "Huh... I guess I had it right all along."
msgstr "А?.. Выходит, я всё правильно настроил..."

#. ja: 原石の量はよし<br>それで届け先が…
#. de: Die Menge passt. Und die Adresse ...
#. fr: Quantité<nbsp>: OK. Destination programmée... Voyons voir...
msgctxt "Balloon:7769:0:1"
msgid "All items accounted for. Now to set the destination..."
msgstr "Вся руда на месте. Теперь укажу, куда её отправить..."

#. ja: 友だちが<br>駆除人になったんだって
#. de: Ein Freund von mir ist jetzt Merzer!
#. fr: Une amie à moi est devenue ex<shy>ter<shy>mi<shy>na<shy>tri<shy>ce.
msgctxt "Balloon:7770:0:1"
msgid "One of my friends was just assigned the role of hunter!"
msgstr "Моего друга назначили охотником!"

#. ja: いいなあ<br>僕は適性がなくてさぁ…
#. de: Da werde ich aber neidisch. Ich wurde damals leider als ungeeignet abgestempelt ...
#. fr: La chance<nbsp>! Moi, j'ai pas le niveau pourrr postuler.
msgctxt "Balloon:7771:0:1"
msgid "Gods, I wish it were me. \\<sigh> If only I'd passed the exam..."
msgstr "Вот везёт... А я экзамен не сдал."

#. ja: キープに持ち込む資材は<br>これで全部か？
#. de: Ist das alles, das in den Immerfried muss?
#. fr: Toutes les ressources destinées à la Gardienne sont là<nbsp>?
msgctxt "Balloon:7772:0:1"
msgid "Is this all the scrap we're bringing to Everkeep?"
msgstr "Это весь металлолом, который мы везём в Вечную крепость?"

#. ja: いえ、まだあるわ<br>旧市街でいいのが出たって
#. de: Noch nicht ganz! Im Ertrunkenen Horizont soll wohl etwas Seltenes gefunden worden sein.
#. fr: Pas tout à fait. On vient de faire une belle trouvaille à la Rive noyée.
msgctxt "Balloon:7773:0:1"
msgid "Not quite. The reforgers told me they've found something in the ruins."
msgstr "Не совсем. Мне сказали, в руинах нашли кое-что интересное."

#. ja: よ～しよしよし<br>元気そうだね
#. de: Wem geht's gut? Dir geht's gut!
#. fr: C'est qui, les jolies poulettes à leur mémère<nbsp>?
msgctxt "Balloon:7774:0:1"
msgid "How are we doing, ladies? Hungry?"
msgstr "Ну-ну, какие мы бодрые! Есть хотите?"

#. ja: 属性変換の配分は…と
#. de: Verteilung der Elementarwandlung<nbsp>... fertig!
#. fr: Le transformateur élémentaire a l'air opérationnel...
msgctxt "Balloon:7775:0:1"
msgid "Conversion rate looks normal."
msgstr "Преобразование энергии идёт как надо."

#. ja: おいしく育つんだぞ～
#. de: Bitte werdet schön saftig und lecker!
#. fr: Je sens que la récolte va être bonne<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7776:0:1"
msgid "That's it...<br>Grow nice and tasty for me..."
msgstr "Вот так...<br>Растите вкусненькими..."

#. ja: もう少し育ったら<br>防虫のネットをかけようか
#. de: Noch ein bisschen mehr und ich sollte anfangen, mich um Schädlingsprävention zu kümmern.
#. fr: On attend qu'ils grandissent un peu plus, puis on met un filet anti-insectes<nbsp>?
msgctxt "Balloon:7777:0:1"
msgid "At this stage, we'll need mesh to keep the bugs off."
msgstr "Когда подрастут, надо будет накрыть их сеткой от насекомых."

#. ja: はいよ<br>手配しとく～
#. de: Zu Befehl!
#. fr: C'est noté<nbsp>! Je t'installe ça quand tu veux.
msgctxt "Balloon:7778:0:1"
msgid "Then I'd better put an order in!"
msgstr "Ладно, закажу сетку!"

#. ja: なるほど…<br>湿気対策が必要と…
#. de: Verstehe<nbsp>... Zu viel Feuchtigkeit kann also verheerend sein.
#. fr: Je vois, on va devoir réduire l'humidité...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7779:0:1"
msgid "Note to self─buy tarps.<br>Lots of tarps."
msgstr "Так... Надо купить брезент.<br>И побольше."

#. ja: あと防虫も忘れるなよ？<br>特にブリ虫は厄介だ
#. de: Und vergiss nicht die Insekten! Besonders Schaben haben es in sich!
#. fr: Sans oublier de protéger les cultures contre les nuisibles<nbsp>! Surtout les puluches...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7780:0:1"
msgid "And bug repellent!<br>We really don't want an oglop infestation."
msgstr "И средство от насекомых не забудь!<br>Особенно от брюсских жуков."

#. ja: 誰も来てないよな…
#. de: Niemand scheint mir zu folgen ...
#. fr: C'est bon, personne ne me suit...
msgctxt "Balloon:7781:0:1"
msgid "No one's following..."
msgstr "За мной никто не идёт..."

#. ja: 人の姿は…
#. de: Ist da wer?
#. fr: J'ai cru voir quelqu'un<nbsp>!
msgctxt "Balloon:7782:0:1"
msgid "Is someone there?"
msgstr "Там кто-нибудь есть?"

#. ja: よし…急ごう！
#. de: Die Luft ist rein. Ich sollte mich beeilen!
#. fr: Bien... Allons-y<nbsp>!
msgctxt "Balloon:7783:0:1"
msgid "I'm in the clear... I need to hurry!"
msgstr "Путь свободен... Надо торопиться!"

#. ja: ここまでくれば…！
#. de: Geschafft!
#. fr: Pfiou<nbsp>! J'ai bien avancé<nbsp>!
msgctxt "Balloon:7784:0:1"
msgid "I made it!"
msgstr "Добрался!"

#. ja: ん、なにか動いた？
#. de: H-Hat sich da was bewegt?
#. fr: Hmm<nbsp>? J'ai cru voir quelque chose bouger...
msgctxt "Balloon:7785:0:1"
msgid "D-Did something move?"
msgstr "Ч-что-то шевельнулось?"

#. ja: …気のせいか
#. de: Hab ich mir wohl eingebildet<nbsp>...
#. fr: ... C'était peut-être mon imagination.
msgctxt "Balloon:7786:0:1"
msgid "It's just my imagination..."
msgstr "...Показалось."

#. ja: 彼女の仲間か…！
#. de: Du gehörst zu <i>ihr</i>!?
#. fr: Han<nbsp>! Tu es avec <i>elle</i><nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7787:0:1"
msgid "You're with <i>her</i>!?"
msgstr "Ты с <i>ней</i>!?"

#. ja: 地図の場所はここだ！
#. de: Auf der Karte ist dieser Ort markiert!
#. fr: La carte indique cet endroit.
msgctxt "Balloon:7788:0:1"
msgid "The map points here!"
msgstr "На карте отмечено это место!"

#. ja: さあ、風船に掴まって！<br>「エンドレスハウス」へご案内…
#. de: Auf geht's mit dem Luftballon, komm, komm!
#. fr: Accrochez-vous aux ballons<nbsp>! Ils vous guideront jusqu'au Manoir sans fin...
msgctxt "Balloon:7789:0:1"
msgid "Balloons! Grab your balloons to the Endless House here!"
msgstr "Хватайтесь за шарики! Они доставят вас в «Бесконечный дом»..."

#. ja: 戦争の影響で<br>物資も人手も足りないわ…
#. de: Wegen des Krieges fehlt es uns sowohl an Leuten als auch Vorräten!
#. fr: On manque autant de vivres que de bras...
msgctxt "Balloon:7790:0:1"
msgid "We're short on just about everything because of this war..."
msgstr "Из-за войны нам всего не хватает: ни припасов, ни рабочих рук..."

#. ja: 早く平和に<br>なってほしいものだわ…
#. de: Ich bete jeden Tag für einen raschen Frieden ...
#. fr: Rien n'est plus précieux que la paix...
msgctxt "Balloon:7791:0:1"
msgid "\\<sigh> Will there ever be peace again?"
msgstr ""

#. ja: 行こうぜ！<br>王女様に会いにさ！
#. de: Prinzessin Sphene ist da! Komm, treffen wir sie!
#. fr: Allons rencontrer Sa Majesté<nbsp>!
msgctxt "Balloon:7792:0:1"
msgid "Come on, let's go and see the princess!"
msgstr "Ну же, пойдём повидаем принцессу!"

#. ja: う、うん…<br>なんだか緊張しちゃうよ！
#. de: J-Ja ... Aber ich bin plötzlich so nervös ...!
#. fr: J-je crois que j'ai le trac...
msgctxt "Balloon:7793:0:1"
msgid "R-Right... Oh gods, I'm so nervous..."
msgstr "Д-да... Ох, как же я волнуюсь!"

#. ja: あの御方の記憶が<br>私たちを導く王に…
#. de: Ihre Erinnerungen werden uns auch fortan an ihrer Stelle anführen.
#. fr: De ses souvenirs naîtra la reine qui nous guidera...
msgctxt "Balloon:7794:0:1"
msgid "From her memories, she will be reborn to lead us always."
msgstr "Из её воспоминаний возродится та, кто будет вечно вести нас за собой."

#. ja: 永遠の女王様…<br>まさに黄金の遺産ね
#. de: Eine Königin für die Ewigkeit! Wahrlich gülden, dieses Erbe!
#. fr: Une reine pour l'éternité... Un héritage en or<nbsp>!
msgctxt "Balloon:7795:0:1"
msgid "Our eternal queen... This is a new dawn for the realm."
msgstr "Наша вечная королева... Для королевства настал новый рассвет."

#. ja: もう、お終いよ<br>逃げ場なんて…
#. de: Das war's! Wir werden niemals entkommen!
#. fr: C'est trop tard, il n'y a nulle part où fuir...
msgctxt "Balloon:7796:0:1"
msgid "I can't make it... I can't take another step..."
msgstr "Не могу... Больше ни шагу..."

#. ja: 諦めるな！<br>城を目指すんだ…！
#. de: Nicht aufgeben! Bis zur Burg ist es nicht mehr weit!
#. fr: N'abandonnez pas<nbsp>! Réfugiez-vous au château<nbsp>!
msgctxt "Balloon:7797:0:1"
msgid "Don't give up! We're almost to the castle!"
msgstr "Не сдавайтесь! До замка уже рукой подать!"

#. ja: 今日もエバーキープの<br>魔法障壁がキレイだなぁ…
#. de: Der Wall des Immerfrieds ist auch heute eine Augenweide<nbsp>...
#. fr: Aujourd'hui encore, la barrière magique de la Gardienne de l'Éternité est si belle...
msgctxt "Balloon:7798:0:1"
msgid "Ah, another beautiful day beneath Everkeep's barrier."
msgstr "Как же прекрасен сегодня магический барьер Эверкипа."

#. ja: 未来に希望なんて<br>あるのかしら…
#. de: Ob es in der Zukunft wohl Hoffnung für uns geben wird ...?
#. fr: Est-ce que l'avenir sera synonyme d'espoir...<nbsp>?
msgctxt "Balloon:7799:0:1"
msgid "What does the future hold for us...?"
msgstr "Что ждёт нас в будущем?.."

#. ja: 聞いたか？<br>スフェーン様の噂…
#. de: Hast du schon gehört, was sie mit Ihrer Hoheit gemacht haben sollen?
#. fr: Tu as entendu la rumeur à propos de Sa Majesté Sphene<nbsp>?
msgctxt "Balloon:7800:0:1"
msgid "Did you hear the rumors about the queen?"
msgstr "Слышал слухи о королеве?"

#. ja: 戦前の女王様の記憶が<br>遺されてたって話だろ？
#. de: Du meinst das Gerücht, dass ihre Erinnerungen gespeichert wurden?
#. fr: Ah, comme quoi ses souvenirs d'avant-guerre auraient été conservés<nbsp>?
msgctxt "Balloon:7801:0:1"
msgid "You mean that her memories were preserved?"
msgstr "Ты про то, что сохранили её воспоминания?"

#. ja: ふふ、こちらの新生祭も<br>いい雰囲気！
#. de: Die Stadt ist so hübsch dekoriert!
#. fr: Ici aussi, ils savent y faire pour fêter la Commémoration<nbsp>!
msgctxt "Balloon:7802:0:1"
msgid "Decorations are pretty, ain't they?"
msgstr "Какие красивые украшения, а?"

#. ja: たまにはこうして<br>他の街を散歩するのもいいね
#. de: Aber wirklich. Wir sollten öfter mal andere Städte besichtigen!
#. fr: Ce n'est pas désagréable de visiter les autres cités, une fois de temps en temps.
msgctxt "Balloon:7803:0:1"
msgid "The whole city is. We should travel like this more often."
msgstr "И правда. Надо бы почаще ездить в другие города."

#. ja: 来てよかったなあ！
#. de: Der weite Weg hat sich gelohnt! Ich bin so froh, dass wir hergekommen sind!
#. fr: On a bien fait de venirrr<nbsp>!
msgctxt "Balloon:7804:0:1"
msgid "See!? I told you it'd be worth the journey!"
msgstr "Ну что, я же говорил, что поездка того стоила!"

#. ja: ああ、いい花火だった…
#. de: Ja, das Feuerwerk war wirklich spektakulär<nbsp>...
#. fr: Oui, le feu d'artifice était ex<shy>cep<shy>tion<shy>nel...
msgctxt "Balloon:7805:0:1"
msgid "Yes, it was quite a display."
msgstr "Да, зрелище было что надо."

#. ja: 冒険はどう？<br>楽しめてるかしら
#. de: Das Abenteurerleben gefällt dir, hm?
#. fr: Comment se passent tes aventurrres<nbsp>? Tu t'amuses bien<nbsp>?
msgctxt "Balloon:7806:0:1"
msgid "Still adventuring, are you?"
msgstr "Всё ещё странствуешь?"

#. ja: ああ、もちろん！<br>実はこのあいださ…
#. de: Oh ja, und wie! Weißt du, letztens erst<nbsp>...
#. fr: Et comment<nbsp>! D'ailleurs, pas plus tard que l'autre jourrr...
msgctxt "Balloon:7807:0:1"
msgid "Of course! Why, just the other day..."
msgstr "Конечно! Вот, например, на днях..."

#. ja: シカルド、今回の新生祭で<br>けっこう働いたんだろ？
#. de: Sicard hat wirklich sehr viel Arbeit in dieses Fest investiert.
#. fr: Je dois admettre que Sicard a bien rempli sa part du travail... pour une fois.
msgctxt "Balloon:7808:0:1"
msgid "Sicard worked awfully hard this Rising."
msgstr "Сикард в этом году на Рассветном фестивале здорово потрудился."

#. ja: しゃーねぇ、労いに<br>何か持ってってやるかぁ？
#. de: Ich sollte mich irgendwie erkenntlich zeigen<nbsp>... Vielleicht mit einem kleinen Geschenk?
#. fr: Allez, comme je suis bon prince, je vais lui rapporter un petit souvenir.
msgctxt "Balloon:7809:0:1"
msgid "Mayhap I should make him some small gift, in recognition of his efforts."
msgstr "Может, подарить ему что-нибудь в знак благодарности?"

#. ja: きっと<br>喜ばれると思いますです、はい
#. de: Das klingt nach einer exzellenten Idee, Herr Emmanellain.
#. fr: Je suis sûr qu'il en sera ravi<nbsp>!
msgctxt "Balloon:7810:0:1"
msgid "I'm sure he would like that very much, my lord."
msgstr "Думаю, милорд будет очень рад."

#. ja: 次はどこへ行こう？
#. de: Wo sollen wir als Nächstes hin?
#. fr: On va où, après<nbsp>?
msgctxt "Balloon:7811:0:1"
msgid "Whither shall we venture next?"
msgstr "Куда теперь отправимся?"

#. ja: もうちょっとゆっくりしたら<br>次は…
#. de: Irgendwohin, wo es etwas ruhiger zugeht vielleicht<nbsp>...
#. fr: D'abord, on se pose encore un peu ici. Ensuite...
msgctxt "Balloon:7812:0:1"
msgid "I don't know. The bar?"
msgstr "Не знаю. Может, в бар?"

#. ja: あの花火<br>船からも見えた？
#. de: Konntest du das Feuerwerk vom Meer aus sehen?
#. fr: Tu as pu voir le feu d'artifice, depuis ton bateau<nbsp>?
msgctxt "Balloon:7813:0:1"
msgid "Did you see the fireworks?"
msgstr "Ты видел фейерверк?"

#. ja: ああ、すごかったなあ<br>仲間と見入っちまったよ
#. de: Ja, zusammen mit den anderen. Es war einfach der Wahnsinn!
#. fr: Oui, et c'était magnifique<nbsp>! Avec mes collègues, on était tous bouche bée<nbsp>!
msgctxt "Balloon:7814:0:1"
msgid "That I did! Nearly went overboard gawpin' at 'em!"
msgstr "Ещё бы! Мы с товарищами так засмотрелись, что чуть за борт не свалились!"

#. ja: 花火を見てる奴ら<br>いい顔してたな
#. de: Wie ich es mir erhofft hatte<nbsp>... Alle haben nur so gestrahlt!
#. fr: C'était un beau spectacle. Il a donné le sourire à tout le monde.
msgctxt "Balloon:7815:0:1"
msgid "Reckon folks were smilin' more'n ever this year!"
msgstr "В этом году люди любовались фейерверком и улыбались как никогда!"

#. ja: あれはバナナか…？
#. de: Eine Banane?
#. fr: Une banane... ?
msgctxt "Balloon:7816:0:1"
msgid "A banana...?"
msgstr "Банан?.."

#. ja: どんな味の料理なの？
#. de: Und wie schmeckt das wohl?
#. fr: Quel goût cela a-t-il ?
msgctxt "Balloon:7817:0:1"
msgid "And what flavor would that be?"
msgstr "И какой же он на вкус?"

#. ja: 少し付き合ってくれ
#. de: Folge mir einen Moment.
#. fr: Suis-moi un instant.
msgctxt "Balloon:7818:0:1"
msgid "Come with me for a moment."
msgstr "Пойдём со мной ненадолго."

#. ja: なるほど…
#. de: Ich verstehe ...
#. fr: Je vois...
msgctxt "Balloon:7819:0:1"
msgid "I see..."
msgstr "Понятно..."

#. ja: この煙は…？
#. de: Dieser Rauch ...
#. fr: Cette fumée...
msgctxt "Balloon:7820:0:1"
msgid "That smoke..."
msgstr "Что это за дым?.."

#. ja: お父さん～<br>すごいよ、見て見て！
#. de: Papa, guck mal!
#. fr: Papa, regarde<nbsp>!
msgctxt "Balloon:7821:0:1"
msgid "Papa, look! Isn't it wonderful?"
msgstr "Папа, смотри! Правда здорово?"

#. ja: こらこら<br>危ないぞ
#. de: Tu dir nicht weh.
#. fr: Attention, tu vas te faire mal<nbsp>!
msgctxt "Balloon:7822:0:1"
msgid "Careful, lad. It's a long way down."
msgstr "Осторожнее, парень. Тут высоко."

#. ja: 最初はどこに行こうか
#. de: Also, womit belohne ich mich zuerst?
#. fr: On commence par aller où<nbsp>?
msgctxt "Balloon:7823:0:1"
msgid "Hm... What would you like to do first?"
msgstr "Хм... Чем займёмся сначала?"

#. ja: う～ん、迷っちゃう…
#. de: Es gibt so viel, was ich mir wert wäre<nbsp>...
#. fr: Hmm, j'hésite...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7824:0:1"
msgid "I can't decide... What would <i>you</i> like to do first?"
msgstr "Не могу решить... А <i>ты</i> чем хочешь заняться сначала?"

#. ja: アイス食べに行こう～
#. de: Kann ich ein Eis haben?
#. fr: J'ai envie de manger une glace<nbsp>!
msgctxt "Balloon:7825:0:1"
msgid "Why don't we have some ice cream?"
msgstr "Может, сходим за мороженым?"

#. ja: とっても美味しい<br>クッキーはいかがですか？
#. de: Wie wäre es mit unseren Keksen? Auf ganz Tural gibt es keine besseren.
#. fr: Que diriez-vous de mes délicieux biscuits<nbsp>?
msgctxt "Balloon:7826:0:1"
msgid "Fancy a box of our delicious cookies?"
msgstr "Не желаете купить коробочку вкуснейшего печенья?"

#. ja: 3箱は<br>さすがに買いすぎか…？
#. de: Drei Schachteln, bitte. Dann habe ich genug. Bis zum Abendessen.
#. fr: J'en prendrais bien trois boîtes...
msgctxt "Balloon:7827:0:1"
msgid "One? I think I'd like three..."
msgstr "Одну? Я бы взял три..."

#. ja: またクイズに<br>挑戦しに行くのかい？
#. de: Wollen wir noch mal beim Ratespiel mitmachen?
#. fr: Tu retentes ta chance au quiz<nbsp>?
msgctxt "Balloon:7828:0:1"
msgid "Shall we challenge that quizzed tour again?"
msgstr "Снова пойдём на викторину?"

#. ja: ええ！<br>今度こそ全問正解よ…！
#. de: Gerne! Diesmal legen wir eine perfekte Runde hin.
#. fr: Oui, je compte bien avoir tout bon<nbsp>!
msgctxt "Balloon:7829:0:1"
msgid "Oh, yes! We'll have to try for a perfect score this time."
msgstr "Конечно! В этот раз постараемся ответить правильно на все вопросы!"

#. ja: キレイだね～！
#. de: Ist das aber schön!
#. fr: C'est vachement beau<nbsp>!
msgctxt "Balloon:7830:0:1"
msgid "It's so pretty..."
msgstr "Как красиво..."

#. ja: 賭けに勝ったとかで<br>水路に飛び込んだ奴が…
#. de: Du weißt doch, wie manche Leute ins Wasser springen, um etwas zu feiern?
#. fr: Y a un type qui a plongé dans l'eau après avoir gagné un pari...
msgctxt "Balloon:7831:0:1"
msgid "...And he dove headfirst into the canal!"
msgstr "...а потом нырнул головой в канал!"

#. ja: マジかよ<br>そりゃすごいな
#. de: Ein seltsamer Brauch ist das<nbsp>...
#. fr: Ah bon<nbsp>!? Moi il faudrait plutôt que je <i>perde</i> un pari<nbsp>!
msgctxt "Balloon:7832:0:1"
msgid "Gods, I wish I could have seen it."
msgstr "Вот бы на такое посмотреть!"

#. ja: こうして君と<br>また過ごせるなんてね
#. de: Welch ein Glück, noch ein Mal Zeit mit dir verbringen zu dürfen!
#. fr: Je suis si heureux de t'avoir retrouvée...
msgctxt "Balloon:7833:0:1"
msgid "I'm so glad we can be together again..."
msgstr "Так рад, что мы снова можем быть вместе..."

#. ja: マイカの置物<br>いかがです？
#. de: Wie wäre es mit einer Figur von „Mica, dem Magischen Mu“?
#. fr: Qui veut mes belles statuettes de Mica le mu<nbsp>?
msgctxt "Balloon:7834:0:1"
msgid "I highly recommend our Mica the Mu figurines."
msgstr "Очень советую фигурки Мики-му."

#. ja: こうして集まるのは<br>本当に久しぶりだ
#. de: Es ist lange her, dass wir uns so getroffen haben.
#. fr: Il y a si longtemps qu'on n'avait pas discuté ensemble, comme ça...
msgctxt "Balloon:7835:0:1"
msgid "It's been ages since we last met like this."
msgstr "Давно мы так не собирались вместе."

#. ja: みんなずいぶんと<br>忙しくしてたから…
#. de: Wir haben halt nicht mehr so viel Zeit wie früher.
#. fr: Il faut dire qu'on était toujours occupés...
msgctxt "Balloon:7836:0:1"
msgid "Well, we've all been rather busy..."
msgstr "А всё потому, что мы вечно заняты..."

#. ja: 懐かしくなるわね
#. de: Tja, die alten Zeiten kehren wohl nie wieder zurück.
#. fr: Ah, ça me rend nostalgique...
msgctxt "Balloon:7837:0:1"
msgid "But now it's just like old times!"
msgstr "А теперь всё как в старые добрые времена!"

#. ja: いい景色だわ
#. de: Die Aussicht ist wirklich fantastisch.
#. fr: Quelle belle vue<nbsp>!
msgctxt "Balloon:7838:0:1"
msgid "Such splendid scenery."
msgstr "Какие чудесные виды."

#. ja: ずっと眺めていられるね
#. de: Ich will gar nichts anderes mehr sehen.
#. fr: Je pourrais passer ma journée ici...
msgctxt "Balloon:7839:0:1"
msgid "I could gaze upon it for the rest of my days..."
msgstr "Могла бы любоваться ими целую вечность..."

#. ja: 医療史博物館も<br>おすすめだよ
#. de: Das Museum für medizinische Geschichte soll hochinteressant sein.
#. fr: Je te recommande la médicothèque Daguéréo<nbsp>!
msgctxt "Balloon:7840:0:1"
msgid "You've not been to the Daguerreo Medical Collection?"
msgstr "Ты ещё не был в медицинской коллекции Дагерро?"

#. ja: なら、行ってみましょうか
#. de: Dann sehen wir uns das mal an.
#. fr: D'accord, j'irai y faire un tour.
msgctxt "Balloon:7841:0:1"
msgid "Not yet... I suppose I should pay it a visit!"
msgstr "Нет... Пожалуй, стоит туда заглянуть!"

#. ja: お水気持ちいいな～
#. de: Das Wasser ist wunderschön.
#. fr: C'est tellement agréable<nbsp>!
msgctxt "Balloon:7842:0:1"
msgid "The water's nice and cool!"
msgstr "Какая прохладная вода!"

#. ja: 出会ったばかりの頃を<br>思い出すな…
#. de: Ich weiß noch, wie wir uns hier kennengelernt haben.
#. fr: Je me souviens de notre rencontre comme si c'était hier...
msgctxt "Balloon:7843:0:1"
msgid "I remember the day we first met..."
msgstr "Вспоминаю, как мы впервые встретились..."

#. ja: ここ、泳いでいいのかな…
#. de: Ob man hier schwimmen darf?
#. fr: Je me demande si on a le droit de nager, là-bas...
msgctxt "Balloon:7844:0:1"
msgid "Are we allowed to swim here, I wonder...?"
msgstr "Интересно, здесь можно купаться?.."

#. ja: さあさあ<br>おやつはいかがかな～？
#. de: Wie wäre es mit einem kleinen Happen für zwischendurch?
#. fr: Friandises en tous genres<nbsp>! Demandeeez<nbsp>!
msgctxt "Balloon:7845:0:1"
msgid "We've plenty of sweet treats to satisfy your appetite!"
msgstr "У нас столько сладостей — выбирайте на любой вкус!"

#. ja: いなくなっちゃったのかと<br>思った…
#. de: Ich dachte schon, du wärst entführt worden!
#. fr: J'ai cru que vous m'aviez abandonné...
msgctxt "Balloon:7846:0:1"
msgid "I-I thought you'd left me all alone..."
msgstr "Я... я думал, ты оставила меня одного..."

#. ja: ごめんね<br>もう離れたりしないわ
#. de: Entschuldigung! Ich lauf auch nie wieder weg!
#. fr: Oh, pardonne-nous...
msgctxt "Balloon:7847:0:1"
msgid "I'm so sorry, dear... You'll never be alone again."
msgstr "Прости, милый... Больше никогда не оставим тебя одного."

#. ja: ああ…<br>これからは3人一緒だ
#. de: Ja. Wir bleiben jetzt schön zusammen.
#. fr: À partir de maintenant, on reste toujours ensemble.
msgctxt "Balloon:7848:0:1"
msgid "That's right. We'll always be together, the three of us."
msgstr "Вот именно. Теперь мы всегда будем вместе, все трое."

#. ja: でな、坂道で転んじまって<br>そのままコロコロ～って…
#. de: Und dann ist sie den ganzen Hang runtergekullert, bis unten.
#. fr: Là, je trébuche, et puis je dévale toute la côte en rebondissant comme un ballon...
msgctxt "Balloon:7849:0:1"
msgid "...And then, I tumbled right down the hill!"
msgstr "...а потом я кубарем скатился с холма!"

#. ja: どれにしよっかなぁ～
#. de: Hm, was nehme ich?
#. fr: Hmm, le choix est difficile...
msgctxt "Balloon:7850:0:1"
msgid "Perhaps we could buy matching accessories..."
msgstr "Может, купим одинаковые украшения?.."

#. ja: 順番にご案内するので<br>並んでお待ちください～
#. de: Einer nach dem anderen bitte!
#. fr: Ne poussez pas<nbsp>! Il y aura de la place pour tout le monde<nbsp>!
msgctxt "Balloon:7851:0:1"
msgid "Please form a single-file line as you enter!"
msgstr "Проходите по одному, пожалуйста!"

#. ja: 楽しみだなー！
#. de: Das wird bestimmt toll!
#. fr: J'ai hâte de monter<nbsp>!
msgctxt "Balloon:7852:0:1"
msgid "I can't wait for the ride!"
msgstr "Не терпится прокатиться!"

#. ja: 夢のような場所だね
#. de: Was für ein traumhafter Ort!
#. fr: Quel endroit merveilleux<nbsp>!
msgctxt "Balloon:7853:0:1"
msgid "This place hardly feels real..."
msgstr "Будто я попал в сказку..."

#. ja: ええ、本当に…
#. de: Das kannst du laut sagen ...
#. fr: Oh oui...
msgctxt "Balloon:7854:0:1"
msgid "And yet it is!"
msgstr "А ведь это всё наяву!"

#. ja: お母さん<br>アイス食べに行こうよ～
#. de: Mama, ich will ein Eis! Bitteee!
#. fr: Maman<nbsp>! On va manger une glace<nbsp>?
msgctxt "Balloon:7855:0:1"
msgid "Mother, may I have an ice cream?"
msgstr "Мама, можно мне мороженое?"

#. ja: ねぇ～<br>お父さん～～
#. de: Paaapaaa!
#. fr: Dis, Papa...
msgctxt "Balloon:7856:0:1"
msgid "Well, Father?"
msgstr "Ну, папа?"

#. ja: 今、閃きそうなの…<br>お父さんにお願いして
#. de: Nicht jetzt! Ich bin gerade kurz vor einem Durchbruch. Frag Papa!
#. fr: Pas maintenant, je suis occupée... Demande à ton père<nbsp>!
msgctxt "Balloon:7857:0:1"
msgid "Ask your father, love. I'm brainstorming at the moment..."
msgstr "Попроси папу, милый. Я сейчас кое-что обдумываю..."

#. ja: 待て、解決の糸口が…<br>お母さんに頼んでくれ
#. de: Und wenn man das so und dann so<nbsp>... Hm? Äh, frag doch bitte Mama, ja?
#. fr: Attends, j'ai besoin de me concentrer... Demande plutôt à ta mère<nbsp>!
msgctxt "Balloon:7858:0:1"
msgid "I'm on the cusp of a breakthrough. Why not ask your mother?"
msgstr "Кажется, я близок к разгадке. Попроси лучше маму."

#. ja: ここでは動物と<br>触れ合えるらしいよ
#. de: Hier kann man Tiere streicheln.
#. fr: Il paraît qu'on peut toucher les animaux, ici<nbsp>!
msgctxt "Balloon:7859:0:1"
msgid "I'm told the animals are quite friendly."
msgstr "Говорят, здешние звери совсем не боятся людей."

#. ja: そんなところで遊んで<br>転ぶなよー？
#. de: Pass bloß auf, wo du hintrittst, verstanden?
#. fr: Euh, fais attention, d'accord<nbsp>?
msgctxt "Balloon:7860:0:1"
msgid "You'd best jump down before you fall."
msgstr "Лучше спускайся, пока не упал."

#. ja: へーき、へーき！
#. de: Ja, ja, mir passiert schon nichts!
#. fr: Haha, les doigts dans le nez<nbsp>!
msgctxt "Balloon:7861:0:1"
msgid "I'll be fine, I promise!"
msgstr "Да всё нормально, честно!"

#. ja: 館内には希少な植物や<br>標本があって…
#. de: Im Museum sollen allerlei seltene Pflanzen und Präparate ausgestellt sein ...
#. fr: Il y a aussi des spécimens rares de végétaux, et puis...
msgctxt "Balloon:7862:0:1"
msgid "They've a host of rare specimens here."
msgstr "Здесь целая коллекция редких образцов."

#. ja: 興奮してきたわ！
#. de: Wie aufregend!
#. fr: Tu as éveillé ma curiosité<nbsp>!
msgctxt "Balloon:7863:0:1"
msgid "The battles here are exhilarating!"
msgstr "Какие захватывающие битвы!"

#. ja: ずっとこうしていたいわね
#. de: Ich wünschte, dieser Moment könnte ewig währen ...
#. fr: Je veux que ce moment ne s'arrête jamais...
msgctxt "Balloon:7864:0:1"
msgid "I want to stay like this forever..."
msgstr "Вот бы этот миг никогда не кончался..."

#. ja: 穏やかな時間だわ…
#. de: So friedvoll ...
#. fr: Ah, si la lecture était la seule nourriture de l'âme...
msgctxt "Balloon:7865:0:1"
msgid "I wouldn't trade these quiet moments for anything."
msgstr "Не променяю эти тихие минуты ни на что."

#. ja: あ、あれっ！？<br>アイツどこいっちゃった？
#. de: Hä? Wo ist sie denn jetzt wieder hin?
#. fr: Hein<nbsp>!? Où elle est passée<nbsp>?
msgctxt "Balloon:7866:0:1"
msgid "Huh? Wh-Where did she go?"
msgstr "А? Куда она... куда пропала?"

#. ja: あれれ？<br>彼ったらどこにいったの？
#. de: Das ist aber komisch. Dabei waren wir doch gerade eben noch zusammen ...
#. fr: Tiens<nbsp>? J'aurais juré qu'il était parti par ici...
msgctxt "Balloon:7867:0:1"
msgid "Oh, dear... Where's he run off to now?"
msgstr "Вот те на... Куда он опять убежал?"

#. ja: いい調子！
#. de: Weiter so!
#. fr: Allez, faut garder le rythme<nbsp>!
msgctxt "Balloon:7868:0:1"
msgid "Keep going!"
msgstr "Так держать!"

#. ja: まだまだいけるよ！
#. de: Nicht aufgeben!
#. fr: On faiblit pas<nbsp>!
msgctxt "Balloon:7869:0:1"
msgid "Perfect!"
msgstr "Идеально!"

#. ja: 1000回めざそう！
#. de: Bis zur Tausend!
#. fr: On peut aller jusqu'à mille<nbsp>!
msgctxt "Balloon:7870:0:1"
msgid "Try jumping to a thousand!"
msgstr "Попробуй допрыгать до тысячи!"

#. ja: う、うん…<br>酔わないといいけど…
#. de: J-Ja bestimmt. Ich hoffe nur, mir wird nicht schwindelig ...
#. fr: Euh, moi j'ai peur d'avoir le vertige...
msgctxt "Balloon:7871:0:1"
msgid "I-I'm feeling queasy just looking at it..."
msgstr "У меня уже голова кружится, стоит только посмотреть..."

#. ja: 昔はあんなお城が<br>あったのね…
#. de: Unglaublich, dass es so eine Burg früher wirklich gegeben haben soll ...
#. fr: Le château devait être si im<shy>pres<shy>sion<shy>nant, à l'époque...
msgctxt "Balloon:7872:0:1"
msgid "So that's how the castle looked..."
msgstr "Вот каким был замок..."

#. ja: 昔はいろいろな動物が<br>いたらしくてな…
#. de: Einst soll das Wildgehege voller Tiere gewesen sein.
#. fr: Il paraît qu'il y avait plein d'animaux différents, autrefois<nbsp>!
msgctxt "Balloon:7873:0:1"
msgid "They say this place once kept all sorts of species."
msgstr "Говорят, когда-то здесь водились самые разные звери."

#. ja: まだかなぁ～
#. de: Wie lange denn noch ...?
#. fr: Elle s'est endormie dans le sauna, ou quoi<nbsp>!?
msgctxt "Balloon:7874:0:1"
msgid "She's been in there a while..."
msgstr "Ну когда же она выйдет?.."

#. ja: ふーっ、涼しい！
#. de: Hach, so erfrischend!
#. fr: Ah, ça fait un bien fou<nbsp>!
msgctxt "Balloon:7875:0:1"
msgid "Ahhh, it's much cooler out here!"
msgstr "Фух, здесь прохладнее!"

#. ja: お待たせー！
#. de: Da bin ich!
#. fr: Désolée pour le retard<nbsp>!
msgctxt "Balloon:7876:0:1"
msgid "Apologies for the wait!"
msgstr "Простите, что заставила ждать!"

#. ja: 少し外気で落ち着かせて<br>再開するといいみたい
#. de: Nach ein wenig Pause an der frischen Luft gönne ich mir noch eine Runde!
#. fr: Il paraît qu'il vaut mieux faire une pause de temps en temps.
msgctxt "Balloon:7877:0:1"
msgid "I'm not done yet─just taking a break."
msgstr "Я ещё не закончила — просто решила передохнуть."

#. ja: よし！<br>もう1回行ってくるね！
#. de: So, jetzt bin ich wieder abgekühlt. Auf geht's!
#. fr: Et voilà, j'y retourne<nbsp>!
msgctxt "Balloon:7878:0:1"
msgid "All right, back to the sauna for me!"
msgstr "Ладно, снова в сауну!"

#. ja: そろそろ休憩かなぁ…
#. de: Wann ist endlich Pause ...?
#. fr: Je commence à avoir besoin de souffler...
msgctxt "Balloon:7879:0:1"
msgid "I could use a break soon..."
msgstr "Скоро бы уже передохнуть..."

#. ja: ストロベリーか<br>それともチョコミントか…
#. de: Nehme ich Erdbeere oder Schokolade-Minze ...?
#. fr: Fraise, ou chocolat-menthe<nbsp>?
msgctxt "Balloon:7880:0:1"
msgid "Strawberry or mint chocolate chip? That is the question..."
msgstr "Клубничное или шоколадно-мятное? Вот в чём вопрос..."

#. ja: さっきの試合<br>すごかったよなぁ！
#. de: Was für ein Spektakel das vorhin war!
#. fr: Le match de tout à l'heure était incroyable<nbsp>!
msgctxt "Balloon:7881:0:1"
msgid "That last bout was incredible!"
msgstr "Вот это был бой!"

#. ja: 俺も<br>アイスほしくなってきた…
#. de: Jetzt habe ich auch Lust auf ein Eis bekommen!
#. fr: Moi aussi, je commence à avoir envie d'une glace...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7882:0:1"
msgid "I should've bought<br>ice cream too..."
msgstr "Надо было мне тоже купить<br>мороженого..."

#. ja: 急いで買ってくれば？<br>美味しいよ～！
#. de: Dann hol dir doch schnell eins! So was Leckeres findet man selten!
#. fr: Tu as encore le temps d'aller en acheter une<nbsp>!
msgctxt "Balloon:7883:0:1"
msgid "Why not hurry and buy some?"
msgstr "Почему бы тебе не сбегать за ним?"

#. ja: さっきの試合<br>どう思う～？
#. de: Was hältst du vom Kampf vorhin?
#. fr: Qu'est-ce que tu as pensé du dernier match<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7884:0:1"
msgid "What'd you think<br>of that last bout?"
msgstr "Ну как тебе<br>последний бой?"

#. ja: ありゃあ<br>判定が悪いね
#. de: Klares Versagen aufseiten der Schiedsrichter!
#. fr: Un vol<nbsp>! On se demande ce que fait l'arbitrage vidéo<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7885:0:1"
msgid "I think the referee<br>was full of shite!"
msgstr "По-моему, судья<br>совсем ослеп!"

#. ja: 注目してる試合は？
#. de: Gibt es heute einen Kampf, der dich besonders interessiert?
#. fr: Il y a une rencontre à suivre en particulier<nbsp>?
msgctxt "Balloon:7886:0:1"
msgid "Which match are you most keen to see?"
msgstr "Какой бой ждёшь больше всего?"

#. ja: 断然、3試合目！
#. de: Und ob! Das dritte Gefecht heute wird in die Geschichte eingehen, das versprech ich dir!
#. fr: Oui, la troisième<nbsp>! Le retour de la revanche<nbsp>!
msgctxt "Balloon:7887:0:1"
msgid "The third one, of course!"
msgstr "Конечно же, третий!"

#. ja: やっぱり観戦するなら<br>ここからだな…
#. de: Von hier lässt es sich doch immer noch am besten schauen ...
#. fr: Ah, j'ai pu m'installer à ma place favorite<nbsp>!
msgctxt "Balloon:7888:0:1"
msgid "This's the best spot for spectatin'."
msgstr "Отсюда лучше всего<br>смотреть."

#. ja: 俺も出場してみてぇなー
#. de: Irgendwann will ich auch mal da unten im Ring stehen ...!
#. fr: Ah, si je pouvais plutôt être au milieu de l'arène...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7889:0:1"
msgid "I wish I could<br>compete as well..."
msgstr "Вот бы и мне<br>выйти на арену..."

#. ja: ボォッ、ボォッ
#. de: \<schnauf>
#. fr: Beuh<nbsp>! Beuh<nbsp>!
msgctxt "Balloon:7890:0:1"
msgid "Hrruff!"
msgstr "Хр-р-рф!"

#. ja: ンボォ～～
#. de: Muuuh<nbsp>...
#. fr: Mwoooh<nbsp>!
msgctxt "Balloon:7891:0:1"
msgid "Mrroooh!"
msgstr "Мр-р-о-о!"

#. ja: ボォ～、ボォ～
#. de: \<brumm>
#. fr: Beuuuh<nbsp>! Beuh<nbsp>!
msgctxt "Balloon:7892:0:1"
msgid "Mrroooh! Mrroooh!"
msgstr "Мр-р-о-о! Мр-р-о-о!"

#. ja: おっ、ノミが…
#. de: Oje, alles voller Flöhe<nbsp>...
#. fr: Ouah, t'es couvert de puces<nbsp>!
msgctxt "Balloon:7893:0:1"
msgid "Damn fleas..."
msgstr "Чёртовы блохи..."

#. ja: あとでブラシかけてあげようね
#. de: Nachher bürste ich dich ordentlich durch, hm?
#. fr: Je vais te brosser un peu plus tard, d'accord<nbsp>?
msgctxt "Balloon:7894:0:1"
msgid "Ready for a brushin', girl?"
msgstr "Почешу тебя потом, ладно, девочка?"

#. ja: うん、いいツヤだ
#. de: Ah ja, prall und saftig.
#. fr: La récolte s'annonce bien<nbsp>!
msgctxt "Balloon:7895:0:1"
msgid "Shapin' up to be a good harvest."
msgstr "Урожай, похоже, будет что надо."

#. ja: 壺匠が作った<br>腕輪を仕入れたくて…
#. de: Ich wollte Armbänder aus Topfwerkerherstellung anbieten, dachte ich mir.
#. fr: J'aimerais bien acheter des bracelets d'artisans mobelins...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7896:0:1"
msgid "We might try sellin'<br>bangles from the potsworn."
msgstr "Можно попробовать продавать<br>браслеты от горшечников."

#. ja: 確かに売れそうね
#. de: Ah ja, die verkaufen sich sicher gut.
#. fr: Oh, tu dois forcément pouvoir en trouver.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7897:0:1"
msgid "I should think they'll<br>fetch a fair price."
msgstr "Думаю, они<br>неплохо пойдут."

#. ja: ノパルをよく炒めて…
#. de: Du musst die Feigen nur ordentlich durchbraten, sag ich dir.
#. fr: Le secret avec les rrraquettes de cactus, c'est de bien les faire revenir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7898:0:1"
msgid "...and then you<br>fry it with nopales."
msgstr "...а потом как следует<br>обжарь нопаль."

#. ja: へえ、美味しそう！
#. de: Ja stimmt, das klingt schon lecker.
#. fr: Hmmm, ça m'a l'air succulent<nbsp>!
msgctxt "Balloon:7899:0:1"
msgid "That sounds amazing!"
msgstr "Звучит аппетитно!"

#. ja: アイツ、騙しやがって！
#. de: Er haut dich über's Ohr, ich sag's dir!
#. fr: Le saligaud, il m'a arnaqué<nbsp>!
msgctxt "Balloon:7900:0:1"
msgid "The bastard swindled me!"
msgstr "Этот мерзавец меня обчистил!"

#. ja: 自警隊に相談に行こう
#. de: Ich sollte wohl mal mit der Staubwacht reden<nbsp>...
#. fr: Tu devrrrais aller en parler à la milice.
msgctxt "Balloon:7901:0:1"
msgid "Maybe the Dustwatch can help."
msgstr "Может, стража Пыльного дозора поможет."

#. ja: まだシェシェネ青燐泉にゃ<br>帰らねえぞ…
#. de: Ich mag noch nich' zur-\<hick> zurück. Zu den Ssshe<nbsp>... Sheshene<nbsp>...
#. fr: Pas question de rentrer aux sources de Sheshenewezi... Hic<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7902:0:1"
msgid "I ain't \\<hic> goin'<br>back to no springs..."
msgstr ""

#. ja: 毎日毎日、俺たちはよぉ～
#. de: Arbeit, Arbeit, jeden Tag nur Arbeit<nbsp>...
#. fr: Hips<nbsp>! On trime... Tous les jours...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7903:0:1"
msgid "Not without one<br>more drink! \\<hic>"
msgstr ""

#. ja: むにゃ…おかわり…
#. de: N-Noch eins, Herr Wirt<nbsp>... \<hick>
#. fr: Hmgn... J'reprendrai bien un p'tit verre<nbsp>! Hic<nbsp>!
msgctxt "Balloon:7904:0:1"
msgid "One more... \\<snore>"
msgstr ""

#. ja: そこで、山みたいな<br>ロネークがさ…ぐぅ…
#. de: U-Und da war ein Rroneek<nbsp>... Groß wie ein Berg! \<hick>
#. fr: Et là... Bam<nbsp>! Un rroneek... Hips<nbsp>! Grand comme une montagne<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7905:0:1"
msgid "...A rroneek as big<br>as a mountain, I tell ya!"
msgstr "...а там рронек был<br>с гору величиной, отвечаю!"

#. ja: …なに、言ってるの？
#. de: Wovon zum Henker redest du da?
#. fr: Qu'est-ce que tu racontes<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7906:0:1"
msgid "I think you've had<br>too much to drink."
msgstr "Кажется, ты уже<br>слишком много выпил."

#. ja: トライヨラで<br>商人に聞いたんだが…
#. de: Ich schwöre, das hat mir ein Händler aus Tuliyollal so erzählt.
#. fr: C'est un marchand à Tuliyollal qui m'en a parrrlé...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7907:0:1"
msgid "It's true! Heard it from the<br>merchants in Tuliyollal!"
msgstr "Это правда! Мне купцы<br>из Тулийоллала рассказали!"

#. ja: だが、ペルペル族によれば…
#. de: Die Pelupelu sagen aber was anderes<nbsp>...
#. fr: Oui, mais d'après les Pelupelu...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7908:0:1"
msgid "But the Pelupelu<br>tell it different..."
msgstr "Но пелупелу говорят совсем другое..."

#. ja: それで<br>うちのカミさんがな…
#. de: Rate, was meine Frau schon wieder angestellt hat.
#. fr: Puis là, ma femme, elle m'dit...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7909:0:1"
msgid "Wife said it's the<br>best she ever had."
msgstr "Жена сказала, что вкуснее ничего не пробовала."

#. ja: なんだよ<br>また惚気話か？
#. de: Bitte nicht noch eine <i>dieser</i> Geschichten<nbsp>...
#. fr: Tu m'agaces avec tes scènes de ménage.
msgctxt "Balloon:7910:0:1"
msgid "Hah! Sure she did."
msgstr "Ха! Конечно, сказала."

#. ja: 薪が足りないかな
#. de: Hrm, nicht genügend Hitze<nbsp>...
#. fr: Il manque peut-être un peu de bois<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7911:0:1"
msgid "Maybe one more<br>log wouldn't hurt."
msgstr "Может, подкинуть ещё полено?"

#. ja: 虫はついてないな…ヨシ！
#. de: Kein einziger garstiger Käfer in Sicht!
#. fr: Y a pas de bébêtes dans le coin, hein<nbsp>?
msgctxt "Balloon:7912:0:1"
msgid "Not a bug in sight. Thank goodness."
msgstr "Ни одного жука. Вот и славно."

#. ja: 晩飯は、このポポトで…
#. de: Und heute Abend mach ich ein leckeres Toffelgericht.<nbsp>...
#. fr: Et hop<nbsp>! Une bonne popoto pour le dîner<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7913:0:1"
msgid "...And which one of you<br>are we cooking tonight?"
msgstr "...И кого из вас сегодня на ужин?"

#. ja: 今季は豊作でよかったわ
#. de: Was bin ich froh, dass die Ernte dieses Jahr so üppig ausfällt.
#. fr: La récolte a été bonne cette saison<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7914:0:1"
msgid "We've had quite the<br>harvest this season."
msgstr "В этом сезоне урожай что надо!"

#. ja: 種付けの<br>時期を変えてみたの
#. de: Ja, es hat sich gelohnt, die Aussaat etwas früher zu beginnen!
#. fr: J'ai changé la date des semis pour voir.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7915:0:1"
msgid "It was worth the time spent<br>seeding the crops earlier."
msgstr "Не зря посеяли пораньше."

#. ja: 煮込みの肉が足りないんだ
#. de: Wir brauchen noch mehr Fleisch für den Eintopf.
#. fr: Il nous faut de la viande pour le ragoût...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7916:0:1"
msgid "I'm afraid we'll need more<br>meat for the stew."
msgstr "Похоже, для рагу мяса не хватит."

#. ja: 狩りに出たばかりなのに…
#. de: Aber ich komme doch gerade erst von der Jagd<nbsp>...
#. fr: Rho... Je viens à peine de rentrer de la chasse<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7917:0:1"
msgid "But I've just returned<br>from hunting..."
msgstr "Да я только с охоты вернулся..."

#. ja: タバコを切らしちまった
#. de: Mrh, mein Tabak ist aus<nbsp>...
#. fr: Mince, j'ai plus de tabac<nbsp>!
msgctxt "Balloon:7918:0:1"
msgid "Any tobacco to spare, friend?"
msgstr "Дружище, табачком не поделишься?"

#. ja: 俺も持ってないな…
#. de: Dabei wollte ich dich gerade um welchen bitten, verdammt.
#. fr: Moi non plus, j'suis à sec.
msgctxt "Balloon:7919:0:1"
msgid "Sorry. All out, I'm afraid."
msgstr "Прости, у самого ни щепотки."

#. ja: 息子が<br>青燐泉で働きたいって
#. de: Mein Sohn will unbedingt an den Sheshenewezi-Quellen arbeiten<nbsp>...
#. fr: Mon fils m'a dit qu'il voulait travailler aux sources de Sheshenewezi.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7920:0:1"
msgid "My son says he wants to go<br>to the springs and seek work."
msgstr "Сын говорит, хочет поехать к источникам поискать работу."

#. ja: それで<br>何て答えたの？
#. de: Und was sagst du dazu?
#. fr: Et tu lui as répondu quoi<nbsp>?
msgctxt "Balloon:7921:0:1"
msgid "And? What did you tell him?"
msgstr "И что ты ему ответила?"

#. ja: そろそろ乾いたかな
#. de: Sehr gut, die Fuhre ist trocken!
#. fr: J'espère que c'est sec...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7922:0:1"
msgid "A little more and they'll<br>be bone dry."
msgstr "Ещё немного — и совсем высохнут."

#. ja: 素敵な音色…
#. de: Ich liebe diese Melodie<nbsp>...
#. fr: Hmmm... Jolie mélodie<nbsp>!
msgctxt "Balloon:7923:0:1"
msgid "What a lovely melody."
msgstr "Какая чудесная мелодия."

#. ja: ずっと聞いていたいわ
#. de: Für immer könnte ich hier sitzen und einfach nur zuhören<nbsp>...
#. fr: Je pourrais rrrester l'écouter toute la journée<nbsp>!
msgctxt "Balloon:7924:0:1"
msgid "I could listen to this all day."
msgstr "Я бы слушала её целый день."

#. ja: 湖にでも行こうか
#. de: Wollen wir ein Weilchen zum See?
#. fr: Si on allait faire un tourrr au lac<nbsp>?
msgctxt "Balloon:7925:0:1"
msgid "To the lake, then?"
msgstr "Тогда на озеро?"

#. ja: 小船で昼寝もいいわね
#. de: Mh, gern. Ein Nickerchen im schaukelnden Boot wäre gerade genau das Richtige.
#. fr: Oh oui<nbsp>! Un petit tour en barrrque<nbsp>! Ce serait chouette<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7926:0:1"
msgid "Sure. I could go for a<br>nap on the boat."
msgstr "Давай. Я бы вздремнула в лодке."

#. ja: 大きいの、来い…！
#. de: Siehst du den riesigen Schatten?
#. fr: Allez<nbsp>! Faites que ça morrrde<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7927:0:1"
msgid "They'll come biting any<br>second─I can feel it!"
msgstr "Вот-вот клюнут, чую!"

#. ja: いい風だわ…
#. de: Ah, was für eine angenehme Brise.
#. fr: Quel vent agrrréable<nbsp>!
msgctxt "Balloon:7928:0:1"
msgid "Ah, what a pleasant breeze."
msgstr "Ах, какой приятный ветерок."

#. ja: 寄っといで～
#. de: Pst, bestimmt beißt er gleich an!
#. fr: Allez les petits poissons<nbsp>!
msgctxt "Balloon:7929:0:1"
msgid "I hope it's a big one!"
msgstr "Ну же, клюйте! Надеюсь, попадётся здоровенная рыбина!"

#. ja: お疲れさん
#. de: Fein gemacht, Große.
#. fr: T'as bien mérité une pause<nbsp>!
msgctxt "Balloon:7930:0:1"
msgid "You did good today, girl."
msgstr "Хорошо сегодня поработала, девочка."

#. ja: ボォウ！
#. de: Mbuuuh!
#. fr: Mwoh<nbsp>!
msgctxt "Balloon:7931:0:1"
msgid "Hrruff!"
msgstr "Хррруф!"

#. ja: 俺の仕事取りやがって！
#. de: Das war <i>meine</i> Arbeit, du Scheißer!
#. fr: Arrête de me piquer mon boulot<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7932:0:1"
msgid "You took my job, you<br>sack of rroneek piss!"
msgstr "Ты мою работу отнял, кусок рррунека в моче!"

#. ja: 見ててイライラすんだよ！
#. de: So langsam wie du die machst, kann sich das ja kein Arsch mitansehen!
#. fr: T'es si mauvais que j'ai pas pu m'en empêcher<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7933:0:1"
msgid "Not my fault you're<br>so godsdamned slow!"
msgstr "Сам виноват, что медленный, как проклятая черепаха!"

#. ja: やれ、やっちまえ！
#. de: Los, hau ihm eins auf's Maul!
#. fr: Ouais<nbsp>! Une bagarre<nbsp>!
msgctxt "Balloon:7934:0:1"
msgid "Let 'im have it!"
msgstr "Врежь ему!"

#. ja: ほどほどにしとけ～
#. de: Übertreibt es nicht, sonst haben wir die Staubwacht an den Hacken.
#. fr: Du calme, les gars...
msgctxt "Balloon:7935:0:1"
msgid "Go for the gut!"
msgstr "В живот целься!"

#. ja: 負けんなよ！
#. de: Jawohl, sag's ihm!
#. fr: Défends-toi<nbsp>!
msgctxt "Balloon:7936:0:1"
msgid "You gonna take that from him!?"
msgstr "Ты что, так и стерпишь?!"

#. ja: 採水塔を増やすんですって
#. de: Hast du schon gehört? Sie wollen noch mehr Fördertürme bauen.
#. fr: Paraît qu'ils vont construire une autre tour de forage.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7937:0:1"
msgid "I heard they're planning<br>to build another rig."
msgstr "Слышала, собираются построить ещё одну буровую вышку."

#. ja: また人を雇うのかしら
#. de: Also werden sie auch mehr Arbeiter brauchen.
#. fr: Ça va encorrre embaucher à tour de bras<nbsp>!
msgctxt "Balloon:7938:0:1"
msgid "We're going to need more hands, then."
msgstr "Значит, рабочих понадобится больше."

#. ja: 戦いの舞台に<br>ふさわしい場所ね…！
#. de: Welch ein feuriger Ort für noch feurigere Gefechte!
#. fr: Notre arène est un digne parc pour les princes du combat<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7940:0:1"
msgid "A fitting arena for<br>glorious battles!"
msgstr "Вот арена для славных сражений!"

#. ja: ふふん<br>私も勉強してきたよ！
#. de: Vielleicht kann man ja auch das ein oder andere lernen!
#. fr: Moi aussi, j'ai révisé avant de venir<nbsp>!
msgctxt "Balloon:7941:0:1"
msgid "I studied up as well!"
msgstr "А я тоже подготовилась!"

#. ja: 応援はこんな感じ！？
#. de: Anfeuern! Geht das so?
#. fr: C'est comme ça qu'il faut encourager<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "Balloon:7942:0:1"
msgid "This is how you<br>cheer, right!?"
msgstr "Вот так надо болеть, да?!"

#. ja: 試合、わ～いわ～い！
#. de: Ein Duell! Ein Duell!
#. fr: ♪ Tous ensemble on chanteraaa<nbsp>!
msgctxt "Balloon:7943:0:1"
msgid "Fight, fight, fight!"
msgstr "Драка! Драка! Драка!"

#. ja: まずは温泉かしら<br>どう思う？
#. de: Ab in die heißen Quellen!
#. fr: J'ai envie de faire trempette dans les bains...
msgctxt "Balloon:7944:0:1"
msgid "Shall we go and have a soak?"
msgstr "Ну что, пойдём искупаемся?"

#. ja: おいしい～っ
#. de: Superlecker!
#. fr: Miam<nbsp>!
msgctxt "Balloon:7945:0:1"
msgid "Mmm..."
msgstr "М-м-м..."

#. ja: 定期的に商品を<br>入れ替えていまして…
#. de: Unser Angebot wechselt regelmäßig.
#. fr: C'est-à-dire que nous changeons ré<shy>gu<shy>liè<shy>re<shy>ment nos produits, et...
msgctxt "Balloon:7946:0:1"
msgid "We regularly change our offerings, you see..."
msgstr "Мы регулярно обновляем ассортимент, понимаете..."

#. ja: えーっ！？<br>アレはもう置いてないのか
#. de: Dann habt ihr es also gar nicht mehr ...?
#. fr: Oh non<nbsp>! Vous n'en avez déjà plus<nbsp>!?
msgctxt "Balloon:7947:0:1"
msgid "But those were my favorite!"
msgstr "Но это же было моё любимое!"

#. ja: それで私ったらね<br>うっかり…
#. de: Ach, ich kleines Dummerchen, hihi ...
#. fr: Je suis vraiment tête en l'air...
msgctxt "Balloon:7948:0:1"
msgid "And then, if you can believe it, this is what I said..."
msgstr "И тут, представляешь, я такое ляпнула..."

#. ja: はあ～気持ちいい～！
#. de: Himmlisch! Diese wohltuende Wärme!
#. fr: Aaaah<nbsp>! C'est le pieeed<nbsp>!
msgctxt "Balloon:7949:0:1"
msgid "This is the life..."
msgstr "Вот это жизнь..."

#. ja: 私もアイス<br>食べちゃおうかな～
#. de: Und jetzt noch ein Eis!
#. fr: Une petite glace n'a jamais fait de mal à personne...
msgctxt "Balloon:7950:0:1"
msgid "I think I'll have an ice cream."
msgstr "Пожалуй, съем мороженого."

#. ja: アリーナでも<br>食べてたじゃないか
#. de: Aber du hattest doch in der Arena schon eins!
#. fr: Tu en as déjà mangé une à l'arène<nbsp>!
msgctxt "Balloon:7951:0:1"
msgid "Didn't you have one back at the arena?"
msgstr "Ты же и на арене уже ел!"

#. ja: ここ限定のフレーバーも<br>試したいのっ
#. de: Aber nicht in dem Superspezialgeschmack, den es nur hier gibt!
#. fr: Oui, mais ici ils ont des parfums spéciaux<nbsp>!
msgctxt "Balloon:7952:0:1"
msgid "They have special flavors here!"
msgstr "Зато здесь есть особые вкусы!"

#. ja: わかった、わかった
#. de: Schon gut, schon gut ...
#. fr: C'est bon, j'ai compris...
msgctxt "Balloon:7953:0:1"
msgid "Well, in that case..."
msgstr "Ладно, ладно..."

#. ja: ふふふ～！
#. de: Hihihi!
#. fr: Hihihi<nbsp>!
msgctxt "Balloon:7954:0:1"
msgid "Hehehe!"
msgstr "Хе-хе-хе!"

#. ja: あぁぁぁ、しみわたる…
#. de: Ahh ... Diese heilende Hitze!
#. fr: Que ça fait du bien...
msgctxt "Balloon:7955:0:1"
msgid "Ahhh... Paradise..."
msgstr "А-а-а... просто рай..."

#. ja: これは…<br>ミララ族には深いわね…
#. de: Oh ... Vielleicht ein bisschen tief für unsereins!
#. fr: Euh, c'est un peu profond pour une Milalla...
msgctxt "Balloon:7956:0:1"
msgid "A bit too deep for me, perhaps..."
msgstr "Для меня, пожалуй, глубоко..."

#. ja: どぉりゃぁぁぁ！！
#. de: Horaaaarh!
#. fr: Oryaaaah !
msgctxt "Balloon:7957:0:1"
msgid "Graaagh!"
msgstr "Гррра-а-а!"

#. ja: ふんっぬぉぉぉ！！
#. de: Graaaawr!
#. fr: Nuoooooh !
msgctxt "Balloon:7958:0:1"
msgid "Hyeeeaaah!"
msgstr "Хья-а-а!"

#. ja: そこだ！<br>いけいけ！！
#. de: Nur weiter!
#. fr: Vise la jugulaire ! La jugulaire !
msgctxt "Balloon:7959:0:1"
msgid "There! Get him! "
msgstr "Вот он! Давай, хватай его!"

#. ja: いい勝負だな！
#. de: Nicht nachlassen, jetzt!
#. fr: Quel match !
msgctxt "Balloon:7960:0:1"
msgid "What a thrilling bout!"
msgstr "Вот это схватка!"

#. ja: ぶっ潰せ―！
#. de: Gleich hast du ihn!
#. fr: Mords-lui la tête !
msgctxt "Balloon:7961:0:1"
msgid "Knock him flat!"
msgstr "Размажь его!"

#. ja: ここをこうして…
#. de: \<summ> ♪
#. fr: Ensuite, comme ça... Voiiiilà...
msgctxt "Balloon:7962:0:1"
msgid "Next, I put this here..."
msgstr "Теперь положу вот это сюда..."

#. ja: うわ！<br>このバナナすげぇうまい！
#. de: Mmmh, ich <i>liebe</i> diese Süße!
#. fr: Hmmm ! Succulente, cette banane !
msgctxt "Balloon:7963:0:1"
msgid "I've never had such a delicious banana!"
msgstr "Никогда не ел такой вкусной банановой!"

#. ja: 俺も俺も！<br>ひとくちくれよ！
#. de: Komm, hab dich nicht so und lass mich beißen!
#. fr: Allez ! Moi aussi, je veux goûter ! Donne-moi un bout !
msgctxt "Balloon:7964:0:1"
msgid "Give me a bite!"
msgstr "Дай кусочек!"

#. ja: いい風…<br>むにゃ…
#. de: Haaach, so ein schöner lauer Wind<nbsp>...
#. fr: Cette brise est très agréable... Hmmm...
msgctxt "Balloon:7965:0:1"
msgid "Such a nice breeze... Hmm..."
msgstr "Какой приятный ветерок... М-м..."

#. ja: Zzz…
#. de: \<schnarch>
#. fr: Rrrrooon...
msgctxt "Balloon:7966:0:1"
msgid "Zzz..."
msgstr "Хр-р-р..."

#. ja: 次の狩り<br>どこに行こうか？
#. de: Wo wollen wir als nächstes angeln?
#. fr: J'hésite où aller pour ma prochaine chasse...
msgctxt "Balloon:7967:0:1"
msgid "Now, where will our next hunt be?"
msgstr "И куда на следующую охоту?"

#. ja: あっちのゾユのほうはどうだ？
#. de: Wie wäre es mit dem einen Tsoly, von dem ich dir neulich erzählt habe?
#. fr: Pourquoi pas près du tsoly ?
msgctxt "Balloon:7968:0:1"
msgid "Why not hunt near the tsoly?"
msgstr "Может, возле цоли поохотимся?"

#. ja: アタシもいつか<br>星覚えを目指して…
#. de: Irgendwann kenne ich die Namen aller Sterne<nbsp>...
#. fr: Moi aussi, un jour, je pourrai raconter mes histoires au jardin du Firmament...
msgctxt "Balloon:7969:0:1"
msgid "One day, I'll be telling stories here..."
msgstr "Когда-нибудь и я буду рассказывать здесь истории..."

#. ja: 大変だろうが、きっとできるさ
#. de: Wenn sich das irgendjemand merken kann, dann du.
#. fr: Ce sera pas facile, mais tu vas y arriver.
msgctxt "Balloon:7970:0:1"
msgid "A lofty goal, but I believe you can reach it."
msgstr "Цель непростая, но ты справишься."

#. ja: ブラーシャ狩猟団が<br>大物を狩ったらしいぞ
#. de: Die Br'aax-Jäger sollen ordentlich Beute gemacht haben, hast du gehört?
#. fr: T'as entendu ? Les Pisteurs br'aax ont ramené une grosse prise, aujourd'hui !
msgctxt "Balloon:7971:0:1"
msgid "Sounds like the Brethren of Br'aax caught something big."
msgstr "Слышал, братство Бра'акс добыло крупную добычу."

#. ja: ブラーシャ狩猟団は<br>我らの誇りだな
#. de: Nein, aber es wundert mich kein bisschen.
#. fr: Ils font notre fierté à tous !
msgctxt "Balloon:7972:0:1"
msgid "I'm not surprised─they're the best of us, after all."
msgstr "Неудивительно — они лучшие из нас."

#. ja: ゼレージャ様が<br>仰ってたんだけど…
#. de: Hat Zereel Ja schon mit dir gesprochen?
#. fr: Dis, tu as entendu les dernières directives de notre chef ?
msgctxt "Balloon:7973:0:1"
msgid "Did you hear what Zereel Ja said? "
msgstr "Слышал, что сказал Зерель Джа?"

#. ja: そうは言ってもねぇ…
#. de: Ja, schon<nbsp>...
#. fr: Oui, ja. C'est bien beau, mais...
msgctxt "Balloon:7974:0:1"
msgid "Yes, but I'm not sure if we can manage it..."
msgstr "Да, только не уверена, что мы справимся..."

#. ja: ずっと前からだよ！<br>もう備蓄がなくて…
#. de: Unsere Vorräte sind schon seit Ewigkeiten leer.
#. fr: Cela fait des lustres que nos réserves sont vides, ja !
msgctxt "Balloon:7975:0:1"
msgid "Our stores have been empty for a long while!"
msgstr "Наши запасы уже давно кончились!"

#. ja: 仕送りだけでは厳しいか…
#. de: Also reichen die Lieferungen alleine nicht<nbsp>...
#. fr: Ainsi, les livraisons ne suffisent plus...
msgctxt "Balloon:7976:0:1"
msgid "We can't depend only on deliveries anymore..."
msgstr "Одних поставок уже не хватит..."

#. ja: 大丈夫かね？
#. de: Bist du verletzt?
#. fr: Tu es BLESSÉ<nbsp>?
msgctxt "Balloon:7977:0:1"
msgid "Are you all right?"
msgstr "Ты в порядке?"

#. ja: ああ、なんとか…
#. de: Nicht wesentlich, es geht schon.
#. fr: Non, je CROIS que ça va...
msgctxt "Balloon:7978:0:1"
msgid "Y-Yes, it's just a scratch..."
msgstr "Д-да, всего лишь царапина..."

#. ja: いったい…<br>何が起きたんだ…
#. de: Wie konnte das nur geschehen, von einem Herzschlag auf den anderen<nbsp>...
#. fr: Mais qu'est-ce qu'il s'est PASSÉ<nbsp>!?
msgctxt "Balloon:7979:0:1"
msgid "What in the world happened...?"
msgstr "Что же, на всех светоносцев, случилось?.."

#. ja: しっかりするんだ！
#. de: Sammle all deine Kräfte.
#. fr: Tiens BON<nbsp>!
msgctxt "Balloon:7980:0:1"
msgid "We'll get through this! "
msgstr "Держись! Мы со всем справимся!"

#. ja: う、うぅっ…
#. de: \<stöhn>
#. fr: Aïe... J'ai MAL<nbsp>!
msgctxt "Balloon:7981:0:1"
msgid "Unnngh..."
msgstr "У-у-у..."

#. ja: ヴァリガルマンダの<br>封印が解けたのか…！？
#. de: Valigarmandas Siegel ist gebrochen!
#. fr: Le SCEAU de Valigarmanda... Il a été rompu<nbsp>!?
msgctxt "Balloon:7982:0:1"
msgid "The Skyruin has broken free!?"
msgstr "Небесная погибель вырвалась на свободу?!"

#. ja: 良かった<br>怪我は浅いな
#. de: Deine Verletzungen sind nicht schlimm. Welch ein Glück.
#. fr: Ta blessure n'est pas très PROFONDE, heureusement<nbsp>!
msgctxt "Balloon:7983:0:1"
msgid "Thank goodness, the wound is shallow."
msgstr "Слава богам, рана неглубокая."

#. ja: あの大きな影は…？
#. de: Was ist dieser riesige Schatten?
#. fr: C'est quoi cette OMBRE immense<nbsp>?
msgctxt "Balloon:7984:0:1"
msgid "What was that great shadow...?"
msgstr "Что это была за огромная тень?.."

#. ja: お城に行きたいな～！
#. de: Zur Burg! Ich will zur Burg!
#. fr: J'ai envie d'aller voir le château<nbsp>!
msgctxt "Balloon:7985:0:1"
msgid "I want to go and see the castle!"
msgstr "Хочу в замок!"

#. ja: 少し休んだら行こうね
#. de: Nach einer kleinen Pause. In Ordnung?
#. fr: D'accord, mais on se repose un peu avant...
msgctxt "Balloon:7986:0:1"
msgid "We'll go once I've caught my breath, all right?"
msgstr "Немного передохну — и пойдём, хорошо?"

#. ja: あのエアキャブに乗れば<br>行けるのか…？
#. de: Kann man mit dem Lufttaxi dorthin?
#. fr: On peut y aller en taxi aérien<nbsp>?
msgctxt "Balloon:7987:0:1"
msgid "Sounds like we'll be riding the air cab, then..."
msgstr "Похоже, придётся лететь на воздушном такси..."

#. ja: なあなあ<br>かけっこしようぜ！
#. de: Kommt, lasst uns Fangen spielen!
#. fr: Hé, on fait la course<nbsp>?
msgctxt "Balloon:7988:0:1"
msgid "Say, why don't we have a race?"
msgstr "Эй, а давайте наперегонки!"

#. ja: 少しは速くなったの？
#. de: Bist du etwa schneller geworden?
#. fr: Contre toi<nbsp>? T'es trop lent, l'escargot<nbsp>!
msgctxt "Balloon:7989:0:1"
msgid "Have you gotten any faster since last time?"
msgstr "Ты хоть немного быстрее стал?"

#. ja: すぐには無理でしょ～
#. de: Die kleine Schnecke? Niemals! Haha!
#. fr: T'as aucune chance<nbsp>!
msgctxt "Balloon:7990:0:1"
msgid "I doubt he has..."
msgstr "Да куда ему..."

#. ja: いーや！<br>この人にも負けないし！
#. de: Doooch! Selbst gegen <if $gn4>die<else>den</if> da verliere ich nicht!
#. fr: Je vais gagner<nbsp>! Même contre vous, <if $gn4>Madame<else>Monsieur</if><nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "Balloon:7991:0:1"
msgid "I'll outrun all of you! Even <i>you</i>!"
msgstr "Я вас всех обгоню! Даже <i>тебя</i>!"

#. ja: うっそだぁ<br>なら競争してみてよ！
#. de: In deinen Träumen vielleicht! Fordere <if $gn4>sie<else>ihn</if> doch mal heraus!
#. fr: Si tu veux te ridiculiser...
msgctxt "Balloon:7992:0:1"
msgid "Oh really? Do it, then! I dare you!"
msgstr "Да ну? А ну давай, докажи!"

#. ja: のっ、望むところだ！
#. de: D-Das werde ich! Jawohl!
#. fr: C'est ce qu'on va voir<nbsp>!
msgctxt "Balloon:7993:0:1"
msgid "Y-You're on!"
msgstr "Н-ну, я согласен!"

#. ja: じゃあ<br>私が判定してあげる～
#. de: Dann mach ich euch die Schiedsrichterin.
#. fr: C'est moi qui juge l'arrivée<nbsp>!
msgctxt "Balloon:7994:0:1"
msgid "In that case, I'll be the judge."
msgstr "Тогда я буду судить."

#. ja: それなら<br>私が合図するわね！
#. de: Und ich geb das Startsignal!
#. fr: Et moi, je donne le départ<nbsp>!
msgctxt "Balloon:7995:0:1"
msgid "Okay, I'll count down from three!"
msgstr "А я дам стартовый сигнал!"

#. ja: 準備できた？
#. de: Auf die Plätze ...
#. fr: À vos marques...
msgctxt "Balloon:7996:0:1"
msgid "Ready?"
msgstr "Готовы?"

#. ja: よ～～い…
#. de: Fertig ...
#. fr: Prêts...
msgctxt "Balloon:7997:0:1"
msgid "Three...two...one..."
msgstr "На старт..."

#. ja: どんっ！！
#. de: Los!
#. fr: Partez<nbsp>!!!
msgctxt "Balloon:7998:0:1"
msgid "Goooooo!"
msgstr "Марш!!!"

#. ja: うおおおおーーーーっ！
#. de: Hiiiaaaarrrggghhh!
#. fr: Ouaaaaiiiis<nbsp>!!!
msgctxt "Balloon:7999:0:1"
msgid "Raaaaaahhh!"
msgstr "А-а-а-а-а!"
