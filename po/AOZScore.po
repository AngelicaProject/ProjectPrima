#. ja: スピードスター
#. de: Eile statt Weile
#. fr: Bleu vif
#. column 3: Completed performance faster than the ideal time.
msgctxt "AOZScore:1:0:2"
msgid "Too Fast, Too Furious"
msgstr "Слишком быстро, слишком яростно"

#. ja: 好記録タイムより、すばやくクリア
#. de: Schneller als die Idealzeit.
#. fr: Défi réussi dans la limite du temps idéal.
#. column 2: Too Fast, Too Furious
msgctxt "AOZScore:1:0:3"
msgid "Completed performance faster than the ideal time."
msgstr "Завершить выступление быстрее идеального времени."

#. ja: タイムキーパー
#. de: Weile statt Eile
#. fr: Ni en retard ni en avance
#. column 3: Completed performance faster than the standard time.
msgctxt "AOZScore:2:0:2"
msgid "Slow and Steady"
msgstr "Тише едешь — дальше будешь"

#. ja: 標準タイムより、すばやくクリア
#. de: Schneller als die Mindestzeit.
#. fr: Défi réussi dans la limite du temps standard.
#. column 2: Slow and Steady
msgctxt "AOZScore:2:0:3"
msgid "Completed performance faster than the standard time."
msgstr "Завершить выступление быстрее стандартного времени."

#. ja: 10アクション
#. de: 10 Blaue Wunder
#. fr: 10 nuances de bleu
#. column 3: Used between two and ten unique spell types.
msgctxt "AOZScore:3:0:2"
msgid "10 Ways to Die"
msgstr "10 способов умереть"

#. ja: 使用した青魔法が2種類以上、10種類以下
#. de: 2 bis 10 unterschiedliche Sprüche benutzt.
#. fr: Entre 2 et 10 actions différentes utilisées.
#. column 2: 10 Ways to Die
msgctxt "AOZScore:3:0:3"
msgid "Used between two and ten unique spell types."
msgstr "Использовать от 2 до 10 разных типов заклинаний."

#. ja: 4アクション
#. de: 4 Blaue Wunder
#. fr: 4 nuances de bleu
#. column 3: Used two, three, or four unique spell types.
msgctxt "AOZScore:4:0:2"
msgid "4 Ways to Die"
msgstr "4 способа умереть"

#. ja: 使用した青魔法が2種類以上、4種類以下
#. de: 2 bis 4 unterschiedliche Sprüche benutzt.
#. fr: Entre 2 et 4 actions différentes utilisées.
#. column 2: 4 Ways to Die
msgctxt "AOZScore:4:0:3"
msgid "Used two, three, or four unique spell types."
msgstr "Использовать 2, 3 или 4 разных типа заклинаний."

#. ja: ノーダメージ
#. de: Keinen Kratzer
#. fr: Aucun bleu
#. column 3: Took zero damage.
msgctxt "AOZScore:5:0:2"
msgid "Can't Touch This"
msgstr "Не тронь меня"

#. ja: ダメージを受けない
#. de: Keinen Schaden erlitten.
#. fr: Zéro dégât subi.
#. column 2: Can't Touch This
msgctxt "AOZScore:5:0:3"
msgid "Took zero damage."
msgstr "Не получить урона."

#. ja: ノーヒール
#. de: Hart im Nehmen
#. fr: Même pas mal
#. column 3: Restored zero HP.
msgctxt "AOZScore:6:0:2"
msgid "Ain't Got Time to Bleed"
msgstr "Некогда кровоточить"

#. ja: ＨＰ回復効果を使用しない
#. de: Keine LP geheilt.
#. fr: Aucun soin utilisé.
#. column 2: Ain't Got Time to Bleed
msgctxt "AOZScore:6:0:3"
msgid "Restored zero HP."
msgstr "Не восстановить ни одного ОЗ."

#. ja: メイジマッシャー
#. de: Modus Interruptus
#. fr: Chutus incantatus !
#. column 3: Interrupted a target's casting.
msgctxt "AOZScore:7:0:2"
msgid "Modus Interruptus"
msgstr "Модус прерывания"

#. ja: 敵の詠唱をキャンセルした
#. de: Einen gegnerischen Angriff unterbrochen.
#. fr: Incantation ennemie interrompue.
#. column 2: Modus Interruptus
msgctxt "AOZScore:7:0:3"
msgid "Interrupted a target's casting."
msgstr "Прервать заклинание цели."

#. ja: マイペース
#. de: Ein Spaziergang im Blauen
#. fr: Promeneur du dimanche
#. column 3: Refrained from using Sprint.
msgctxt "AOZScore:8:0:2"
msgid "A Walk in the Park"
msgstr "Прогулка в парке"

#. ja: スプリントを使用しない
#. de: Keinen Sprint eingesetzt.
#. fr: Sprint jamais utilisé.
#. column 2: A Walk in the Park
msgctxt "AOZScore:8:0:3"
msgid "Refrained from using Sprint."
msgstr "Не использовать «Спринт»."

#. ja: ファイアマスター
#. de: Herrscher über das Feuer
#. fr: Maîtrise du feu
#. column 3: Used one or more fire-aspected spells. Spells aspected to other elements were not used.
msgctxt "AOZScore:9:0:2"
msgid "Mastery of Fire"
msgstr "Мастер огня"

#. ja: 火属性と無属性の青魔法のみを使用
#. de: Nur feuerbasierte oder neutrale Zauber benutzt.
#. fr: Utilisation exclusive d'actions non élémentaires ou liées au feu.
#. column 2: Mastery of Fire
msgctxt "AOZScore:9:0:3"
msgid "Used one or more fire-aspected spells. Spells aspected to other elements were not used."
msgstr "Использовать только заклинания синего мага с аспектом огня или без аспекта."

#. ja: ウォーターマスター
#. de: Herrscher über das Wasser
#. fr: Maîtrise de l'eau
#. column 3: Used one or more water-aspected spells. Spells aspected to other elements were not used.
msgctxt "AOZScore:10:0:2"
msgid "Mastery of Water"
msgstr "Мастер воды"

#. ja: 水属性と無属性の青魔法のみを使用
#. de: Nur wasserbasierte oder neutrale Zauber benutzt.
#. fr: Utilisation exclusive d'actions non élémentaires ou liées à l'eau.
#. column 2: Mastery of Water
msgctxt "AOZScore:10:0:3"
msgid "Used one or more water-aspected spells. Spells aspected to other elements were not used."
msgstr "Использовать только заклинания синего мага с аспектом воды или без аспекта."

#. ja: アースマスター
#. de: Herrscher über die Erde
#. fr: Maîtrise de la terre
#. column 3: Used one or more earth-aspected spells. Spells aspected to other elements were not used.
msgctxt "AOZScore:11:0:2"
msgid "Mastery of Earth"
msgstr "Мастер земли"

#. ja: 土属性と無属性の青魔法のみを使用
#. de: Nur erdbasierte oder neutrale Zauber benutzt.
#. fr: Utilisation exclusive d'actions non élémentaires ou liées à la terre.
#. column 2: Mastery of Earth
msgctxt "AOZScore:11:0:3"
msgid "Used one or more earth-aspected spells. Spells aspected to other elements were not used."
msgstr "Использовать только заклинания синего мага с аспектом земли или без аспекта."

#. ja: ウィンドマスター
#. de: Herrscher über den Wind
#. fr: Maîtrise du vent
#. column 3: Used one or more wind-aspected spells. Spells aspected to other elements were not used.
msgctxt "AOZScore:12:0:2"
msgid "Mastery of Wind"
msgstr "Мастер ветра"

#. ja: 風属性と無属性の青魔法のみを使用
#. de: Nur windbasierte oder neutrale Zauber benutzt.
#. fr: Utilisation exclusive d'actions non élémentaires ou liées au vent.
#. column 2: Mastery of Wind
msgctxt "AOZScore:12:0:3"
msgid "Used one or more wind-aspected spells. Spells aspected to other elements were not used."
msgstr "Использовать только заклинания синего мага с аспектом ветра или без аспекта."

#. ja: アイスマスター
#. de: Herrscher über das Eis
#. fr: Maîtrise de la glace
#. column 3: Used one or more ice-aspected spells. Spells aspected to other elements were not used.
msgctxt "AOZScore:13:0:2"
msgid "Mastery of Ice"
msgstr "Мастер льда"

#. ja: 氷属性と無属性の青魔法のみを使用
#. de: Nur eisbasierte oder neutrale Zauber benutzt.
#. fr: Utilisation exclusive d'actions non élémentaires ou liées à la glace.
#. column 2: Mastery of Ice
msgctxt "AOZScore:13:0:3"
msgid "Used one or more ice-aspected spells. Spells aspected to other elements were not used."
msgstr "Использовать только заклинания синего мага с аспектом льда или без аспекта."

#. ja: ライトニングマスター
#. de: Herrscher über den Blitz
#. fr: Maîtrise de la foudre
#. column 3: Used one or more lightning-aspected spells. Spells aspected to other elements were not used.
msgctxt "AOZScore:14:0:2"
msgid "Mastery of Lightning"
msgstr "Мастер молний"

#. ja: 雷属性と無属性の青魔法のみを使用
#. de: Nur blitzbasierte oder neutrale Zauber benutzt.
#. fr: Utilisation exclusive d'actions non élémentaires ou liées à la foudre.
#. column 2: Mastery of Lightning
msgctxt "AOZScore:14:0:3"
msgid "Used one or more lightning-aspected spells. Spells aspected to other elements were not used."
msgstr "Использовать только заклинания синего мага с аспектом молнии или без аспекта."

#. ja: エレメンタルマスター
#. de: Herrscher über die Sechs Elemente
#. fr: Maîtrise des éléments
#. column 3: Cast spells aspected to all six elements.
msgctxt "AOZScore:15:0:2"
msgid "Elemental Mastery"
msgstr "Мастер стихий"

#. ja: 火、氷、風、土、雷、水の攻撃属性を使用
#. de: Alle 6 verschiedenen Elemente eingesetzt.
#. fr: Utilisation d'un sort de chaque élément.
#. column 2: Elemental Mastery
msgctxt "AOZScore:15:0:3"
msgid "Cast spells aspected to all six elements."
msgstr "Использовать заклинания всех шести стихий."

#. ja: アクションマスター
#. de: Herrscher über Alles
#. fr: Maîtrise absolue
#. column 3: Used actions aspected to all six elements and three damage types (blunt, piercing, slashing).
msgctxt "AOZScore:16:0:2"
msgid "Total Mastery"
msgstr "Полное мастерство"

#. ja: 火、氷、風、土、雷、水、斬、突、打の攻撃属性を使用
#. de: Alle 6 verschiedenen Elemente und alle 3 Schadensarten (Hieb, Stich, Schlag) eingesetzt.
#. fr: Utilisation d'un sort de chaque élément et d'une frappe de chaque type.
#. column 2: Total Mastery
msgctxt "AOZScore:16:0:3"
msgid "Used actions aspected to all six elements and three damage types (blunt, piercing, slashing)."
msgstr "Использовать заклинания всех шести стихий и трёх типов урона: дробящего, колющего и рубящего."

#. ja: デバッファー
#. de: Negative Erfahrung
#. fr: Tortionnaire
#. column 3: Applied six or more unique enfeeblements.
msgctxt "AOZScore:17:0:2"
msgid "Enfeeble Me Tender"
msgstr "Услади мои муки"

#. ja: 敵に付与したデバフが6種類以上
#. de: 6 oder mehr negative Status auf den Gegner angewendet.
#. fr: Plus de 6 malus infligés.
#. column 2: Enfeeble Me Tender
msgctxt "AOZScore:17:0:3"
msgid "Applied six or more unique enfeeblements."
msgstr "Наложить на врагов не менее шести разных отрицательных эффектов."

#. ja: ベテランデバッファー
#. de: Negativste Erfahrung
#. fr: Tyran
#. column 3: Applied nine or more unique enfeeblements.
msgctxt "AOZScore:18:0:2"
msgid "Enfeeble Me Tenderer"
msgstr "Услади мои муки ещё сильнее"

#. ja: 敵に付与したデバフが9種類以上
#. de: 9 oder mehr negative Status auf den Gegner angewendet.
#. fr: Plus de 9 malus infligés.
#. column 2: Enfeeble Me Tenderer
msgctxt "AOZScore:18:0:3"
msgid "Applied nine or more unique enfeeblements."
msgstr "Наложить на врагов не менее девяти разных отрицательных эффектов."

#. ja: マッスルマスター
#. de: Schmerzen müssen sein
#. fr: Gare à la canne
#. column 3: Used only physical-type actions.
msgctxt "AOZScore:19:0:2"
msgid "Let's Get Physical"
msgstr "Давай по-настоящему"

#. ja: 攻撃タイプが物理の青魔法のみを使用
#. de: Nur Zauber mit physischem Schaden benutzt.
#. fr: Utilisation exclusive de dégâts physiques.
#. column 2: Let's Get Physical
msgctxt "AOZScore:19:0:3"
msgid "Used only physical-type actions."
msgstr "Использовать только физические приёмы."

#. ja: ハイメイジ
#. de: Zaubermeister
#. fr: Mage bleu foncé
#. column 3: Cast only rank 4 or 5 spells.
msgctxt "AOZScore:20:0:2"
msgid "Advanced Spellcasting"
msgstr "Продвинутое колдовство"

#. ja: ランク4とランク5の青魔法のみを使用
#. de: Nur Zauber der Ränge 4 und 5 benutzt.
#. fr: Actions de rangs 4 et 5 uniquement.
#. column 2: Advanced Spellcasting
msgctxt "AOZScore:20:0:3"
msgid "Cast only rank 4 or 5 spells."
msgstr "Использовать только заклинания 4-го и 5-го рангов."

#. ja: ノービスメイジ
#. de: Zauberlehrling
#. fr: Mage bleu bleu
#. column 3: Cast only rank 1 or 2 spells.
msgctxt "AOZScore:21:0:2"
msgid "Beginner Spellcasting"
msgstr "Начинающий заклинатель"

#. ja: ランク1とランク2の青魔法のみを使用
#. de: Nur Zauber der Ränge 1 und 2 benutzt.
#. fr: Actions de rangs 1 et 2 uniquement.
#. column 2: Beginner Spellcasting
msgctxt "AOZScore:21:0:3"
msgid "Cast only rank 1 or 2 spells."
msgstr "Использовать только заклинания 1-го и 2-го рангов."

#. ja: フォーフェイス
#. de: Gesichter des Todes
#. fr: Quadruple face
#. column 3: Used four or more unique actions that are fired from the face.
msgctxt "AOZScore:22:0:2"
msgid "Four-faced"
msgstr "Четырёхликий"

#. ja: 顔から放射する青魔法を4種類以上使用
#. de: 4 oder mehr Angriffe ausgeführt, die vom Gesicht ausgehen.
#. fr: 4 actions ou plus lancées à partir du visage.
#. column 2: Four-faced
msgctxt "AOZScore:22:0:3"
msgid "Used four or more unique actions that are fired from the face."
msgstr "Использовать не менее четырёх разных приёмов, выпускаемых из лица."

#. ja: アマジナマスター
#. de: Amajina Spezial
#. fr: Le spécial Amajina
msgctxt "AOZScore:23:0:2"
msgid "Amajina Special"
msgstr "Особый приём Амажины"

#. ja: チーププレイ
#. de: Einfallslos
#. fr: Mascarade mesquine
msgctxt "AOZScore:24:0:2"
msgid "One-trick Pony"
msgstr "Однообразие"

#. ja: ザ・プライマルズ
#. de: Sechsfaltigkeit der Primae
#. fr: Assaut primordial
msgctxt "AOZScore:25:0:2"
msgid "The Primals"
msgstr "Первобытные"

#. ja: ジャイアントキリング
#. de: Schlächter der Arena
#. fr: Tueur de géants
msgctxt "AOZScore:26:0:2"
msgid "Giant Slayer"
msgstr "Покоритель великанов"

#. ja: たこあしフェチ
#. de: Tag der Tentakel
#. fr: Fan des poulpes
msgctxt "AOZScore:27:0:2"
msgid "Trouble with Tentacles"
msgstr "Неприятности со щупальцами"

#. ja: パーフェクトブルー
#. de: Das perfekte Blau
#. fr: Le grand bleu
msgctxt "AOZScore:28:0:2"
msgid "Perfect Blue"
msgstr "Идеальная лазурь"

#. ja: エイトフェイス
#. de: Gesichter des Todes II
#. fr: Octuple face
#. column 3: Used eight or more unique actions that are fired from the face.
msgctxt "AOZScore:29:0:2"
msgid "Eight-faced"
msgstr "Восьмиликий"

#. ja: 顔から放射する青魔法を8種類以上使用
#. de: 8 oder mehr Angriffe ausgeführt, die vom Gesicht ausgehen.
#. fr: 8 actions ou plus lancées à partir du visage.
#. column 2: Eight-faced
msgctxt "AOZScore:29:0:3"
msgid "Used eight or more unique actions that are fired from the face."
msgstr "Использовать не менее восьми разных приёмов, выпускаемых из лица."

#. ja: ヒールマスター
#. de: Heile heile machen
#. fr: Soigneur de bleus
#. column 3: Use Pom Cure, Exuviation, and White Wind.
msgctxt "AOZScore:30:0:2"
msgid "Hooked on a Healing"
msgstr "Помешательство на лечении"

#. ja: ポンポンケアル、イグジュビエーション、ホワイトウィンドを使用
#. de: Vitakupo, Exuviation und Weißer Wind benutzt.
#. fr: Utilisation de Pompon soignant, Exuviation et Vent blanc.
#. column 2: Hooked on a Healing
msgctxt "AOZScore:30:0:3"
msgid "Use Pom Cure, Exuviation, and White Wind."
msgstr "Использовать «Помпон-лечение», «Экзувиацию» и «Белый ветер»."

#. ja: アレキサンダーマニア
#. de: Alexander-Manie
#. fr: Alexandrin
msgctxt "AOZScore:31:0:2"
msgid "Alexander Aficionado"
msgstr "Поклонник Александра"

#. ja: セルリウムブルー
#. de: Blauer Erdseim
#. fr: Bleu céruléen
msgctxt "AOZScore:32:0:2"
msgid "The Celestium's Finest"
msgstr "Лучший селерийский маг"

#. ja: ピュアブルー
#. de: Reines Blau
#. fr: Bleu pur
msgctxt "AOZScore:33:0:2"
msgid "Pure Azure"
msgstr "Чистая лазурь"

#. ja: ゴールデンブルー
#. de: Güldenes Blau
#. fr: Bleu doré
msgctxt "AOZScore:34:0:2"
msgid "Going for Gold"
msgstr "К золоту!"
