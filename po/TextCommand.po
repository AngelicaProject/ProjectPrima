msgctxt "TextCommand:174:0:7"
msgid "ALIASES:<br>　/partysort, /psort<br>USAGE:<br>　/partysort [subcommand]<br><br>→Change the order of specified party members in the party list.<br><br>>>Subcommand:<br>　<ui-color 506><ui-edge-color 507>[party member 1] [party member 2]</ui-edge-color></ui-color><br>　Switch the position of party member 1 and party member 2 in the party list.<br><br>>>Example:<br>　/partysort 2 4<br>　Switch the position of party member 2 and party member 4 in the party list."
msgstr "ПСЕВДОНИМЫ:<br>　/partysort, /psort<br>ИСПОЛЬЗОВАНИЕ:<br>　/partysort [подкоманда]<br><br>→Меняет местами участников группы в списке группы.<br><br>>>Подкоманда:<br>　<ui-color 506><ui-edge-color 507>[участник 1] [участник 2]</ui-edge-color></ui-color><br>　Меняет местами указанных участников в списке группы.<br><br>>>Пример:<br>　/partysort 2 4<br>　Меняет местами второго и четвёртого участников в списке группы."

