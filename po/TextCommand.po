-color 506><ui-edge-color 507>server</ui-edge-color></ui-color><br>　Gil<br>　　<ui-color 506><ui-edge-color 507>Gil</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>gil</ui-edge-color></ui-color><br>　Inventory Grid<br>　　<ui-color 506><ui-edge-color 507>InventoryGrid</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>igrid</ui-edge-color></ui-color><br>　Duty List<br>　　<ui-color 506><ui-edge-color 507>DutyList</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>dlist</ui-edge-color></ui-color><br>　Item Help<br>　　<ui-color 506><ui-edge-color 507>ItemHelp</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>ihelp</ui-edge-color></ui-color><br>　Action Help<br>　　<ui-color 506><ui-edge-color 507>ActionHelp</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>ahelp</ui-edge-color></ui-color><br>　Limit Gauge<br>　　<ui-color 506><ui-edge-color 507>LimitGauge</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>lgauge</ui-edge-color></ui-color><br>　Experience Bar<br>　　<ui-color 506><ui-edge-color 507>ExpBar</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>ebar</ui-edge-color></ui-color><br>　Status Effects<br>　　<ui-color 506><ui-edge-color 507>StatusEffects</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>sfx</ui-edge-color></ui-color><br>　Status Info (Enhancements)<br>　　<ui-color 506><ui-edge-color 507>SInfoEnhancements</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>sienh</ui-edge-color></ui-color><br>　Status Info (Conditional<br>　Enhancements)<br>　　<ui-color 506><ui-edge-color 507>SInfoConditional</ui-edge-color></ui-color><br>　　<ui-color 506><ui-edge-color 507>Enhancements</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>sicenh</ui-edge-color></ui-color><br>　Status Info (Enfeeblements)<br>　　<ui-color 506><ui-edge-color 507>SInfoEnfeeblements</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>sienf</ui-edge-color></ui-color><br>　Status Info (Other)<br>　　<ui-color 506><ui-edge-color 507>SInfoOther</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>siother</ui-edge-color></ui-color><br>　Alliance List 1<br>　　<ui-color 506><ui-edge-color 507>AllianceList1</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>alist1</ui-edge-color></ui-color><br>　Alliance List 2<br>　　<ui-color 506><ui-edge-color 507>AllianceList2</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>alist2</ui-edge-color></ui-color><br>　<if ($gn75 == 1)><else>Hotbars<br>　　<ui-color 506><ui-edge-color 507>Hotbar1...Hotbar10</ui-edge-color></ui-color><br></if>　Cross Hotbar<br>　　<ui-color 506><ui-edge-color 507>Crosshotbar</ui-edge-color></ui-color><br>　Scenario Guide<br>　　<ui-color 506><ui-edge-color 507>ScenarioGuide</ui-edge-color></ui-color><br>　Compressed Aether<br>　　<ui-color 506><ui-edge-color 507>CompressedAether</ui-edge-color></ui-color><br>　Cosmic Exploration Info<br>　　<ui-color 506><ui-edge-color 507>CosmicExplorationInfo</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>csmex</ui-edge-color></ui-color><br>　PvP Battle Log<br>　　<ui-color 506><ui-edge-color 507>PvPLog</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>cclog</ui-edge-color></ui-color><br>　Crystalline Conflict Progress<br>　Gauge<br>　　<ui-color 506><ui-edge-color 507>CConflictProgress</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>ccprog</ui-edge-color></ui-color><br>　Crystalline Conflict Ally Info<br>　　<ui-color 506><ui-edge-color 507>CConflictAlly</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>ccally</ui-edge-color></ui-color><br>　Crystalline Conflict Enemy Info<br>　　<ui-color 506><ui-edge-color 507>CConflictEnemy</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>ccenemy</ui-edge-color></ui-color><br>　Crystalline Conflict Map<br>　　<ui-color 506><ui-edge-color 507>CConflictMap</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>ccmap</ui-edge-color></ui-color><br>　Battle High Gauge<br>　　<ui-color 506><ui-edge-color 507>BattleHighGauge</ui-edge-color></ui-color><br>　Frontline Score Info<br>　　<ui-color 506><ui-edge-color 507>FrontlineScore</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>flscore</ui-edge-color></ui-color><br>　Frontline Campaign Info<br>　　<ui-color 506><ui-edge-color 507>FrontlineCampaignInfo</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>flcamp</ui-edge-color></ui-color><br>　Rival Wings Gauges<br>　　<ui-color 506><ui-edge-color 507>RWGauge</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>rwg</ui-edge-color></ui-color><br>　Rival Wings Alliance List<br>　　<ui-color 506><ui-edge-color 507>RWAlliance</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>rwa</ui-edge-color></ui-color><br>　Rival Wings Station Info<br>　　<ui-color 506><ui-edge-color 507>RWStation</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>rwst</ui-edge-color></ui-color><br>　Rival Wings Mercenary Info<br>　　<ui-color 506><ui-edge-color 507>RWMerc</ui-edge-color></ui-color>, <ui-color 506><ui-edge-color 507>rwmrc</ui-edge-color></ui-color><br>　Blunderville Objective<br>　　<ui-color 506><ui-edge-color 507>Blunder:Objective</ui-edge-color></ui-color><br>　Blunderville Score<br>　　<ui-color 506><ui-edge-color 507>Blunder:Score</ui-edge-color></ui-color><br>　Blunderville Status<br>　　<ui-color 506><ui-edge-color 507>Blunder:Status</ui-edge-color></ui-color><br>　Blunderville Show Log<br>　　<ui-color 506><ui-edge-color 507>Blunder:ShowLog</ui-edge-color></ui-color><br><br>>>Subcommands:<br>　<ui-color 506><ui-edge-color 507>on </ui-edge-color></ui-color>        Show element.<br>　<ui-color 506><ui-edge-color 507>off </ui-edge-color></ui-color>        Hide element.<br><br>Toggle between on/off when no subcommand is specified."
