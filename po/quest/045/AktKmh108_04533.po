# quest/045/AktKmh108_04533 — «Restricted Reading» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: バルデシオン分館のモンティシェーニュから、禁書庫に入る方法を聞こう。
#. de: Montichaigne wartet geduldig darauf, euch den nächsten Schritt zu erklären.
#. fr: Montichaigne souhaite vous expliquer comment accéder aux archives interdites du Noumène.
#. kind: journal
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SEQ_00:1"
msgid "Montichaigne is waiting to offer you further instructions."
msgstr "Монтишень ждёт вас, чтобы дать дальнейшие указания."

#. ja: ヤ・シュトラを連れてガイド用の魔法人形と話す
#. de: Mit dem Inhaltsverzeichnis sprechen
#. fr: Accompagné<if $gn4>e</if> de Y'shtola, parler au guide automate du Noumène
#. kind: objective
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_TODO_00:1"
msgid "Speak with the index page while Y'shtola is accompanying you."
msgstr "Поговорите с указателем в сопровождении Я'штолы."

#. ja: デミール家の禁書を探す
#. de: Nach dem Werk der Daemir suchen
#. fr: Trouver le rapport de recherche des Daemir
#. kind: objective
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_TODO_01:1"
msgid "Search for House Daemir's research notes."
msgstr "Найдите исследовательские записи дома Даэмир."

#. ja: ヤ・シュトラに<sheet EventItem 2003391 0>を渡す
#. de: Y'shtola „Das Wunderwerk der Daemir“ überreichen
#. fr: Remettre le rapport à Y'shtola
#. kind: objective
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_TODO_02:1"
msgid "Hand the <i>Epiphanies of House Daemir</i> to Y'shtola."
msgstr "Передайте Я'штоле <i>озарения дома Даэмир</i>."

#. ja: ヤ・シュトラと話す
#. de: Mit Y'shtola sprechen
#. fr: Parler à Y'shtola
#. kind: objective
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_TODO_03:1"
msgid "Speak with Y'shtola."
msgstr "Поговорите с Я'штолой."

#. ja: デミールの遺烈郷のニッダーナと話す
#. de: Mit Nidhana in Daemirs Werk sprechen
#. fr: Parler à Nidhana, au Grand Œuvre
#. kind: objective
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_TODO_04:1"
msgid "Speak with Nidhana at the Great Work."
msgstr "Поговорите с Нидханой в Великом творении."

#. ja: 指定地点から<sheet EventItem 2003392 0>を入手
#. de: Astralaspektiertes Wasser am Zielort schöpfen
#. fr: Inspecter l'endroit indiqué et récupérer <noun-fr EventItem 1 2003392 1 1>
#. kind: objective
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_TODO_05:1"
msgid "Inspect the astrally dense pocket of water."
msgstr "Осмотрите место, где вода насыщена астральной энергией."

#. ja: ヤ・シュトラに<sheet EventItem 2003392 0>を渡す
#. de: Das astralaspektierte Wasser zu Y'shtola bringen
#. fr: Remettre la gourde d'eau à Y'shtola
#. kind: objective
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_TODO_06:1"
msgid "Deliver the flask of astral-aspected water to Y'shtola."
msgstr "Отнесите флягу с водой, насыщенной астральной энергией, Я'штоле."

#. ja: 準備が良ければ出発しましょう。
#. de: Wollen wir? Es kribbelt mir schon in den Fingerspitzen.
#. fr: Tu n'as qu'à nous dire quand tu te sens prêt<if $gn4>e</if> à partir pour le Noumène.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_001:1"
msgid "I'd like to set out as soon as you're ready."
msgstr "Как только будете готовы, отправимся."

#. ja: おぬしら、すぐに禁書庫へ向かうつもりかの？
#. de: Ich nehme an, ihr wollt sofort aufbrechen?
#. fr: Vous comptez vous rendre im<shy>mé<shy>dia<shy>te<shy>ment aux archives<nbsp>?
#. speaker: MONTICHAIGNE
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_MONTICHAIGNE_000_010:1"
msgid "You'll be heading directly to the archives from here, I presume?"
msgstr "Полагаю, отсюда вы направитесь прямиком в архивы?"

#. ja: ええ、そのつもりよ。
#. de: Das haben wir vor, ja.
#. fr: Tout à fait.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_011:1"
msgid "You presume correctly."
msgstr "Верно полагаете."

#. ja: ならばヌーメノン大書院へ行き、<br>「ガイド用の魔法人形」を探すといい。
#. de: Dann wendet euch doch an die Inhaltsverzeichnis-Marionette im Noumenon. Sie wird euch in den richtigen Flügel führen.
#. fr: Dans ce cas, à votre arrivée au Noumène, je vous invite à consulter le guide automate.
#. speaker: MONTICHAIGNE
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_MONTICHAIGNE_000_012:1"
msgid "Then you'll want to speak with the index page when you arrive. It's been instructed to grant you access to the restricted section."
msgstr "Тогда по прибытии поговорите с указателем. Ему велено пропустить вас в закрытое отделение."

#. ja: わかったわ。<br>ありがとう。
#. de: Verstanden. Vielen Dank, Rektor Montichaigne.
#. fr: Bien compris. Et merci encore pour votre aide.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_013:1"
msgid "Excellent. Once again, we thank you for all your help."
msgstr "Прекрасно. Ещё раз благодарим вас за помощь."

#. ja: フォフォフォ……<br>では、ワシも失礼するぞ。
#. de: Gern geschehen, meine liebe Y'shtola. Damit überlasse ich euch euren Studien.
#. fr: Ho ho ho... C'est toujours un plaisir. À bientôt<nbsp>!
#. speaker: MONTICHAIGNE
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_MONTICHAIGNE_000_014:1"
msgid "Oh, it was my pleasure, believe me. May you find the knowledge you seek!"
msgstr "О, что вы! Мне было только в радость. Пусть вам удастся найти искомые знания!"

#. ja: 私たちも行きましょう。
#. de: Also dann!
#. fr: On y va<nbsp>?
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_015:1"
msgid "Shall we?"
msgstr "Ну что, идём?"

#. ja: （★未使用／削除予定★）
#. de: Y'shtola begleitet dich jetzt. Um den Auftrag durchzuführen, musst du die Auftragsziele erfüllen, während sich deine Begleitung in der Nähe befindet.
#. fr: Y'shtola va à présent vous accompagner. Elle devra se trouver à proximité pour que vous puissiez accomplir le prochain objectif de cette quête.
#. speaker: SYSTEM
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_016:1"
msgid "Y'shtola is now accompanying you. Keep her at your side in order to proceed with quest objectives."
msgstr "Я'штола теперь сопровождает вас. Чтобы выполнять задания, держитесь рядом с ней."

#. ja: （★未使用／削除予定★）
#. de: Die Begleitung kann beendet werden, wenn du das gegenwärtige Gebiet verlässt oder Y'shtola ansprichst und „Begleitung beenden“ auswählst.
#. fr: Elle cessera de vous accompagner si vous changez de zone ou si vous lui parlez pour vous séparer d'elle.
#. speaker: SYSTEM
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_017:1"
msgid "You can leave Y'shtola behind by entering a different area, or by speaking with her and selecting the option to part ways."
msgstr "Вы можете оставить Я'штолу в другой зоне или поговорить с ней и выбрать «Завершить сопровождение»."

#. ja: （★未使用／削除予定★）
#. de: Wenn du die Begleitung aus Versehen beendet hast, kannst du sie erneut starten, indem du Y'shtola ansprichst.
#. fr: Le cas échéant, reparlez à Y'shtola à son point de départ pour qu'elle vous accompagne à nouveau.
#. speaker: SYSTEM
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_018:1"
msgid "If you wish to have Y'shtola accompany you again, return and speak with her at the original location."
msgstr "Если хотите, чтобы Я'штола снова вас сопровождала, вернитесь к месту встречи и поговорите с ней."

#. ja: あなたとグ・ラハ・ティアが訪ねてくるまで、<br>ここで次元跳躍の手がかりを探していたのだけれど……<br>それが禁書庫にあるだなんて、まさに灯台下暗しね。
#. de: Hier habe ich nach Ansätzen gesucht, bis Raha und du mich aus den Büchern gezogen habt. Da hätte ich lange lesen können, auf das Werk der Daemir wäre ich doch nie gestoßen.
#. fr: Avant que tu viennes me trouver avec G'raha Tia, j'ai passé des journées entières à feuilleter les ouvrages présents ici. Dire que ce que je cherchais était là, caché dans les rayons interdits...
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_020:1"
msgid "To think the set of instructions I laughingly imagined may actually exist but yalms away from where you found me napping..."
msgstr "Подумать только: набор инструкций, который я в шутку вообразила, и правда может существовать — всего в паре yalms от места, где вы застали меня задремавшей..."

#. ja: あらかじめアルザダール3世の冒険譚を知っていたら、<br>そこから辿り着いていたかもしれないわね。<br>児童向けの伝記なんかも読んでみるべきだったのよ。
#. de: Die Legenden um Alzadaal den Dritten waren mir auch überhaupt nicht geläufig, sonst hätte ich mich vermutlich schon früher in Thavnairs Richtung orientiert. Aber dazu hätte ich wohl eher eine Sammlung von Mythen und Abenteuern lesen müssen als Dutzende von wissenschaftlichen Abhandlungen.
#. fr: Si j'avais eu vent des exploits d'Alzadaal III plus tôt, j'aurais pu m'épargner quelques nuits blanches. J'aurais peut-être dû me pencher sur les contes et légendes pour commencer.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_021:1"
msgid "If I had known of Alzadaal III's exploits sooner, I could well have saved myself days of research. Even a children's book might have pointed me in the right direction."
msgstr "Если бы я раньше узнала о подвигах Альзадааля III, то сэкономила бы несколько дней на исследованиях. Даже детская книжка могла бы навести меня на верный след."

#. ja: 非現実的なことを成し遂げるためには、<br>常識に縛られない、柔軟な発想力が必要……。<br>時間があったら、もっといろんな本を読んでみたいわ。
#. de: Dabei ist mir doch mehr als bewusst, dass ein vertracktes Problem oft einer kreativen Lösung bedarf. Es gilt, über den eigenen Tellerrand zu blicken und um Ecken zu denken. Hätte ich nur die Zeit, ich würde noch so viel mehr Lektüre verschlingen<nbsp>...
#. fr: Pour réussir l'impossible, il faut être prêt à oublier ses préconceptions et laisser travailler son imagination... Enfin, quand j'aurai à nouveau du temps devant moi, je poursuivrai mes lectures.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_022:1"
msgid "To achieve the impossible, one must needs be flexible of mind and look beyond conventional wisdom. A lesson I had already learned, but clearly not taken to heart."
msgstr "Чтобы добиться невозможного, нужно мыслить гибко и смотреть дальше привычных представлений. Я и так это знала, но, похоже, не принимала близко к сердцу."

#. ja: 何をする？
#. de: Was möchtest du tun?
#. fr: Que voulez-vous faire<nbsp>?
#. speaker: Q1
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_Q1_000_000:1"
msgid "What will you do?"
msgstr "Что вы будете делать?"

#. ja: 話す
#. de: Ansprechen
#. fr: Discuter
#. speaker: A1
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_A1_000_001:1"
msgid "Talk."
msgstr "Поговорить."

#. ja: 同行状態を解除する
#. de: Begleitung beenden
#. fr: Vous séparer
#. speaker: A1
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_A1_000_002:1"
msgid "Part ways."
msgstr "Завершить сопровождение."

#. ja: キャンセル
#. de: Abbrechen
#. fr: Rien en particulier
#. speaker: A1
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_A1_000_003:1"
msgid "Nothing."
msgstr "Ничего."

#. ja: <ui-color 548>「ヌーメノン大書院」について話す</ui-color>
#. de: <ui-color 548>Über das Noumenon</ui-color>
#. fr: <ui-color 548>Parler du Noumène</ui-color>
#. speaker: A1
#. macro: <ui-color 548> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 548 (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_A1_000_004:1"
msgid "<ui-color 548>Discuss Noumenon.</ui-color>"
msgstr "<ui-color 548>Обсудить Ноумен.</ui-color>"

#. ja: ヌーメノン大書院で、「ガイド用の魔法人形」を探しましょう。
#. de: Halten wir Ausschau nach dieser Marionette.
#. fr: Allons trouver cet automate au Noumène.
#. speaker: YSHTOLA
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_051:1"
msgid "Come along, <split \" \" 1><string $gs1></split>. Noumenon and its forbidden wisdom awaits."
msgstr "Пойдём, <split \" \" 1><string $gs1></split>. В Ноумене нас ждут запретные знания."

#. ja: 同行状態を解除します。<br>本当によろしいですか？
#. de: Bist du sicher, dass du die Begleitung beenden möchtest?
#. fr: Voulez-vous vraiment vous séparer de Y'shtola<nbsp>?
#. speaker: SYSTEM
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_052:1"
msgid "Are you sure you wish to part ways with Y'shtola?"
msgstr "Вы уверены, что хотите расстаться с Я'штолой?"

#. ja: あら、ほかの用事でも思い出したの？<br>それなら、「バルデシオン分館」で待っているわね。
#. de: Du hast <i>jetzt</i> etwas anderes vor? Na schön, aber lass mich bloß nicht zu lange warten. Ich bin im Annex, wenn du mich suchst.
#. fr: Tu as d'autres obligations à remplir avant d'aller au Noumène<nbsp>? Je t'attendrai à l'annexe des Élèves de Baldesion, alors fais-moi signe quand tu seras prêt<if $gn4>e</if> à repartir.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_053:1"
msgid "Very well, but please do hurry back. I shall await you at the annex."
msgstr "Хорошо, только возвращайтесь поскорее. Я буду ждать вас в отделении."

#. ja: 準備は万全？<br>それなら、ヌーメノン大書院に向かうとしましょう。
#. de: Bist du so weit? Dann auf zum Noumenon.
#. fr: Prêt<if $gn4>e</if> à repartir<nbsp>? Le Noumène nous attend.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_054:1"
msgid "All set this time? No forgotten chores or errands to call you away? Good─the forbidden tomes await!"
msgstr "Теперь всё? Никаких срочных дел не вспомнилось? Отлично — запретные фолианты ждут!"

#. ja: 哲学者議会　ヨリ　承ッテ　オリマス。<br>アナタ　オヒトリ　デ　ヨロシイ　デショウカ？
#. de: GuTEn <if ($gn11 < 12)><if ($gn11 < 4)>AbeNd<else>MoRgeN</if><else><if ($gn11 < 17)>TaG<else>AbeNd</if></if>! Mir wURde diE WeiSuNg ErTeilT, EUch eiNzulASsen. EuCh und Y'sHToLa Rhul. IhRe AnWEseNheiT konNte niChT veRiFiziErt weRdeN.
#. fr: J'ai reçu l'au<shy>to<shy>ri<shy>sa<shy>tion du Conseil pour vous guider dans les archives interdites. Vous êtes seul<if $gn4>e</if><nbsp>?
#. speaker: GUIDE04533
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_GUIDE04533_000_055:1"
msgid "I aM iNsTrUcTeD tO pErMiT yOu EnTrAnCe. YoU aNd ArChOn Y'sHtOlA. pErMiSsIoN iS nOt ApPlIcAbLe FoR sEpArAtE eNtRy."
msgstr "Я пОлучИл уКазаНие пРопуСтить вАс. ВАм и архОнУ Я'штоле. ПоОтдЕльно ВпусКать зАпРещЕно."

#. ja: このクエストを進行させるには、<br>ヤ・シュトラが同行している状態で、<br>さらに、プレイヤーの近くにいる必要があります。
#. de: Während dieses Auftrags musst du dich stets in Begleitung von Y'shtola befinden und darfst dich nicht zu weit von ihr entfernen.
#. fr: Pour progresser dans cette quête, vous devez être <if $gn4>accompagnée<else>accompagné</if> de Y'shtola et rester proche d'elle en tout temps.
#. speaker: SYSTEM
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_056:1"
msgid "You must be accompanied by Y'shtola and have her at your side in order to proceed with quest objectives."
msgstr "Чтобы продолжить задание, Я'штола должна вас сопровождать и находиться рядом."

#. ja: 同行者がまだ到着していない。<br>近くまで迎えにいって、ともに話を聞こう。
#. de: Du hast dich zu weit von Y'shtola entfernt. Gehe ihr entgegen.
#. fr: Y'shtola ne se trouve pas à proximité. Retournez la chercher.
#. speaker: SYSTEM
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_057:1"
msgid "Y'shtola has yet to arrive. Be sure she is at your side before attempting to continue."
msgstr "Я'штола ещё не пришла. Подойдите к ней, прежде чем продолжить."

#. ja: <split " " 1><string $gs1></split>様　ト　ヤ・シュトラ様。<br>哲学者議会　ヨリ　承ッテ　オリマス。<br>準備ハ　ヨロシイ　デスカ？
#. de: WillKOmmEn, <string $gs1> und Y'sHToLa Rhul. IDentitÄten sind vEriFizieRt. Der ZugAnG zuM verBOteneN FlügEl ist EuCh hieRMit erTeilt. WüNScht IhR, sofOrt aufZuBrecHen?
#. fr: Dame Y'shtola et <if $gn4>Dame<else>Messire</if> <split " " 1><string $gs1></split>. J'ai reçu l'au<shy>to<shy>ri<shy>sa<shy>tion du Conseil de vous guider dans les archives interdites.
#. speaker: GUIDE04533
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_GUIDE04533_000_058:1"
msgid "ArChOn Y'sHtOlA aNd GuEsT iDeNtIfIeD. dO yOu WiSh To PrOcEeD iNtO tHe ReStRiCtEd ArChIvEs?"
msgstr "АрхОн Я'штола и гОсть опОзнаны. ЖеЛаете прОйти в зАпРетный архИв?"

#. ja: ソレデハ　禁書庫　ヘ　ゴ案内　イタシマス。
#. de: Das ZiEl ist DAs NouMenOn, verBOteNer FlügEl. BitTE folGt mir uNd verMEidEt offENes FeUeR, so WeiT mÖgliCh.
#. fr: Veuillez me suivre, je vous prie.
#. speaker: GUIDE04533
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_GUIDE04533_000_059:1"
msgid "FoLlOw Me, If YoU wOuLd. WaTcH yOuR sTeP, aNd PlEaSe NoTe ThAt ThE uSe Of NaKeD fLaMeS iS dIsCoUrAgEd."
msgstr "ИдИте за мнОй. СмотРите пОд нОги. От крытого огня, пожАлуйста, возДержитесь."

#. ja: 禁書庫　マデ　ゴ案内　イタシマスカ？
#. de: DarF ich die FÜHruNg zum NouMenOn, verBOteNer FlügEl, begiNnen?
#. fr: Souhaitez-vous accéder aux rayonnages interdits<nbsp>?
#. speaker: GUIDE04533
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_GUIDE04533_000_080:1"
msgid "Do YoU wIsH tO pRoCeEd InTo ThE rEsTrIcTeD aRcHiVeS?"
msgstr "ЖелАете пройти в запрЕтный архив?"

#. ja: 「ヌーメノン大書院：禁書庫」へ移動しますか？
#. de: Den verbotenen Flügel betreten?
#. fr: Entrer dans les archives interdites du Noumène<nbsp>?
#. speaker: Q2
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_Q2_000_081:1"
msgid "Enter the restricted archives?"
msgstr "Войти в закрытое отделение?"

#. ja: ドーゾ　ユックリ　ゴ覧クダサイ。
#. de: WarTEmoDus aKtiVieRt. BitTE neHmt EucH so viEl Zeit, wiE Ihr benÖtiGt.
#. fr: Prenez le temps qu'il vous faut.
#. speaker: GUIDE04533
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_GUIDE04533_000_100:1"
msgid "No SmOkInG! nO tHrOwInG bOoKs! AnD nO yElLiNg OuT “eUrEkA!” iN aN oBnOxIoUsLy LoUd VoIcE!"
msgstr "Не курите! Не бросайте книги! И не кричите «эврика!» во весь голос!"

#. ja: 手に取ったことのない書物が、こんなにも……。
#. de: So viele Bücher<nbsp>... Ich muss doch träumen. Ah, ich will sie alle<nbsp>...
#. fr: Tant de livres que je n'ai jamais eu la chance de consulter jusque-là...
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_105:1"
msgid "So many books I've yet to read..."
msgstr "Столько книг, которые мне ещё предстоит прочесть..."

#. ja: ええ、わかっているわよ。<br>今は探し物が先だってことはね。
#. de: Nein, Schluss damit. Schließlich suchen wir ein bestimmtes Werk.
#. fr: Oui, oui, je sais. On est venu<if $gn4>es<else>s</if> pour un tome bien précis, pas besoin de me le rappeler.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_110:1"
msgid "Yes, yes, we are here for one specific volume. You needn't remind me."
msgstr "Да-да, мы пришли за одной определённой книгой. Не нужно мне напоминать."

#. ja: (-『ある彫金師の日記』-)異界で出会った人型の美しい妖異……<br>獣のようにエーテルを求めるほかの個体と違い、<br>今にも消えてしまいそうなほど、儚い瞳をしていた……。
#. de: (-Tagebuch eines Goldschmiedes-)<i>In einer Welt, die nicht die unsre war, traf ich das schönste Wesen, das mir je begegnet ist<nbsp>... Es war eine Kreatur des Nichts, doch ihre Züge waren zart und auch war sie nicht von demselben Hunger besessen, der ihre Artgenossen beherrschte. Ihre Augen flackerten wie die Flamme einer Kerze, die jeden Moment zu erlöschen drohte.</i>
#. fr: (-Journal d'un orfèvre inconnu-)Dans un monde étranger au nôtre, j'ai rencontré une créature à forme humaine d'une beauté fascinante... Elle était bien différente de ses congénères, obsédés par leur faim insatiable d'éther. Ses yeux brillaient d'une faible lueur qui menaçait de s'éteindre d'un moment à l'autre.
#. speaker: SYSTEM
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_120:1"
msgid "(-Untitled Goldsmith's Journal-)<i>Today, in a world not my own, I met the most beautiful voidborn creature. She was so unlike her ravenous brethren. Eyes blazing not with hunger, but trembling─like a candle's flame, threatening to flicker out at any moment.</i>"
msgstr "(-Дневник безымянного ювелира-)<i>Сегодня, в чужом мире, я встретил прекраснейшее создание Пустоты. Она совсем не походила на своих ненасытных сородичей. В её глазах горел не голод, а трепетал огонёк, будто пламя свечи, готовое вот-вот погаснуть.</i>"

#. ja: (-『ある彫金師の日記』-)あの妖異は「彼女」と呼ぶべきか、それとも……？<br>いや、そんな些細なことは問題ではない。
#. de: (-Tagebuch eines Goldschmiedes-)<i>Lange grübelte ich darüber nach, ob man dieses wunderbare Geschöpf als </i>Frau<i> bezeichnen kann. Doch ein solcher Begriff erscheint nicht richtig<nbsp>- seine Schönheit steht weit über derlei einengenden Begrifflichkeiten.</i>
#. fr: (-Journal d'un orfèvre inconnu-)Je me demande même si le mot de créature est bien justifié dans son cas... Enfin, peu m'importent ces considérations futiles.
#. speaker: SYSTEM
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_121:1"
msgid "(-Untitled Goldsmith's Journal-)<i>I wonder if “she” is even the proper word. Such distinctions seem inconsequential. Insignificant, even.</i>"
msgstr "(-Дневник безымянного ювелира-)<i>Интересно, правильно ли говорить о ней „она“? Впрочем, такие различия кажутся несущественными. Даже ничтожными.</i>"

#. ja: (-『ある彫金師の日記』-)美しき存在は、<br>ただそれだけで愛を捧げるに足るのだから！
#. de: (-Tagebuch eines Goldschmiedes-)<i>Und spielt es überhaupt eine Rolle? Denn die Liebe, die in mir brennt, wenn ich in seine flammenden Augen blicke, kennt weder Geschlecht noch Farbe, weder Stand noch Sitte.</i>
#. fr: (-Journal d'un orfèvre inconnu-)Tout ce qui compte, c'est l'amour que je porte à cette beauté exquise<nbsp>!
#. speaker: SYSTEM
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_122:1"
msgid "(-Untitled Goldsmith's Journal-)<i>All that matters is the love I feel for this exquisite, transcendent being!</i>"
msgstr "(-Дневник безымянного ювелира-)<i>Важно лишь то, что я люблю это прекрасное, неземное создание!</i>"

#. ja: どうやら、探している禁書ではないようだ……。
#. de: Wenn auch aufschlussreich, ist dies nicht das Buch, nach dem ihr sucht.
#. fr: Ce n'est pas le livre que vous recherchez...
#. speaker: SYSTEM
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_123:1"
msgid "Though you are tempted to read more, this does not seem to be the volume you are seeking..."
msgstr "Хоть и хочется прочесть дальше, похоже, это не та книга, которую вы ищете..."

#. ja: (-『ある魔法学者の手記』-)第六星暦1564年、アマルジャ族が蛮神「イフリート」を召喚した。<br>情報筋によれば、この蛮神は巨大なトカゲ状の姿を持ち、<br>火の魔力を操る権能を持っていたという。
#. de: (-Memorandum eines Magiekundigen-)<i>Im Jahre 1564 beschwor ein Stamm der Amalj'aa ihren Gott, den Primae Ifrit. In diversen Quellen wird er als echsenartiges Wesen von riesenhafter Statur beschrieben, dem alles Feuer Untertan ist.</i>
#. fr: (-Mémorandum de magismologie-)En l'an 1564 de la 6e ère astrale, la tribu des Amalj'aa invoqua sa divinité protectrice<nbsp>: Ifrit. D'après nos in<shy>for<shy>ma<shy>tions, cet être ressemble à un gigantesque lézard capable de manipuler la magie de feu.
#. speaker: SYSTEM
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_124:1"
msgid "(-<i>Primal Disquisitions</i>-)<i>In the year 1564 of the Sixth Astral Era, the Amalj'aa summoned Ifrit, their patron god. Accounts describe the being as a gigantic, lizard-like being with a potent command of fire-aspected magicks.</i>"
msgstr "(-<i>Рассуждения о праймалах</i>-)<i>В 1564 году Шестой астральной эры амалджа призвали Ифрита, своего бога-покровителя. Согласно описаниям, это огромное ящероподобное существо, повелевающее могущественной магией огня.</i>"

#. ja: (-『ある魔法学者の手記』-)神降ろしが信仰心や祈りによって発動することを考えれば、<br>蛮神の姿や権能が、召喚者が信じる神話と一致していたことは、<br>魔法学的には「妥当な結果」と言えるだろう。
#. de: (-Memorandum eines Magiekundigen-)<i>Da Glaube und Gebet eine solche Beschwörung begründen, war die Erscheinung des Primae deckungsgleich mit der, wie sie in den Legenden der Amalj'aa beschrieben ist. Ein aus magiewissenschaftlicher Sicht vorhersehbares Ergebnis.</i>
#. fr: (-Mémorandum de magismologie-)Cette matérialisation de la divinité semble fondée sur l'énergie issue des prières et de la foi des fidèles. Ainsi, la créature possède les mêmes pouvoirs que dans le folklore de la tribu qui l'a invoquée.
#. speaker: SYSTEM
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_125:1"
msgid "(-<i>Primal Disquisitions</i>-)<i>If we consider that primal summoning is an act fueled by faith and prayer, it is unsurprising, if not expected, that the resulting deiform entity should manifest the appearance and powers with which it is attributed by its worshipers.</i>"
msgstr "(-<i>Рассуждения о праймалах</i>-)<i>Если учесть, что призыв праймала питают вера и молитвы, неудивительно, что божество принимает облик и обладает силами, которыми его наделяют почитатели.</i>"

#. ja: (-『ある魔法学者の手記』-)では、万能の知性を信じる者が祈りを捧げ、<br>神降ろしを行ったとしたら、どのような存在が生じるのか。<br>知の神たるサリャクや、それに類する存在を召喚したとしたら？
#. de: (-Memorandum eines Magiekundigen-)<i>Welche Gestalt nähme also eine Gottheit an, deren Anhänger primär an die Macht des Intellekts und des allumfassenden Wissens glauben? Man denke an Thaliak und andere Götter dieser Art.</i>
#. fr: (-Mémorandum de magismologie-)Quelle sorte d'être pourrait alors naître des prières d'adorateurs d'un Dieu tout-puissant et omniscient<nbsp>? Est-il possible d'invoquer Thaliak l'Érudit ou même les Douze<nbsp>?
#. speaker: SYSTEM
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_126:1"
msgid "(-<i>Primal Disquisitions</i>-)<i>What, then, might emerge from the aether should one who believes in an almighty omniscience attempt the same ritual? Would the Scholar Himself grace us with His presence? Some other embodiment of divine sagacity?</i>"
msgstr "(-<i>Рассуждения о праймалах</i>-)<i>Что же возникнет из эфира, если провести тот же ритуал, веря во всемогущее всеведение? Явится ли сам Учёный? Или воплотится иная божественная мудрость?</i>"

#. ja: (-『ある魔法学者の手記』-)呼び降ろされた人工的な万能神は、知の深淵を知り得るのか。<br>もしそうだとしたら、その知識はどこから生じたというのか。
#. de: (-Memorandum eines Magiekundigen-)<i>Weiß ein derart beschworener Gott um jedes Geheimnis des Universums? Falls ja, woher rührt dieses Allwissen?</i>
#. fr: (-Mémorandum de magismologie-)Une divinité ainsi appelée dans notre monde par la force de ses fidèles est-elle réellement dépositaire d'une con<shy>nais<shy>san<shy>ce sans limites<nbsp>? Auquel cas, d'où la tire-t-elle<nbsp>?
#. speaker: SYSTEM
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_127:1"
msgid "(-<i>Primal Disquisitions</i>-)<i>Could this man-made god truly be all-knowing? And if it were, whence would such knowledge arise?</i>"
msgstr "(-<i>Рассуждения о праймалах</i>-)<i>Может ли искусственно призванный бог и вправду знать всё? И если да, откуда у него такие знания?</i>"

#. ja: (-『ある魔法学者の手記』-)私は古代世界がいかなるものかを知りたい。<br>過去に戻る手段がないとしたら、過去を知る存在を召喚すれば……<br>しかし、回答を得たとしても、真実か否か確認する術はないのだ。
#. de: (-Memorandum eines Magiekundigen-)<i>Ich will die Welt der Alten studieren. Entweder, indem ich selbst in der Zeit zurückreise oder eine Person aus dieser Epoche beschwöre<nbsp>- doch gelänge mir Zweiteres, so wüsste ich doch nicht, ob die Antworten auf meine Fragen der Wahrheit entsprächen oder nur aus meinen eigenen Wünschen und Gebeten gestrickt wären.</i>
#. fr: (-Mémorandum de magismologie-)Je voudrais plus que tout en apprendre plus sur l'ancien monde. Sans moyen existant de remonter dans le temps, puis-je obtenir un résultat similaire en invoquant une divinité au savoir ancestral<nbsp>? Et comment pourrais-je juger de la véracité des réponses qu'elle me fournira<nbsp>?
#. speaker: SYSTEM
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_128:1"
msgid "(-<i>Primal Disquisitions</i>-)<i>I myself have many questions concerning the nature of the ancient world. With no spell to transport me back to the days of old, could I instead summon a being possessed of encyclopedic wisdom of every age? Yet with no means to verify its pronouncements, how could one be certain they were true?</i>"
msgstr "(-<i>Рассуждения о праймалах</i>-)<i>Меня давно занимает природа древнего мира. Если нет заклинания, которое перенесло бы меня в прошлое, могу ли я призвать существо, знающее всё о любой эпохе? Но как проверить его слова и убедиться, что они правдивы?</i>"

#. ja: どうやら、探している禁書ではないようだ……。
#. de: Der Verfasser hätte sicherlich nur zu gern ein Wort mit dir gewechselt, doch ein Daemir scheint er nicht zu sein.
#. fr: Ce n'est pas le livre que vous recherchez...
#. speaker: SYSTEM
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_129:1"
msgid "Though your mind spins with the possibilities discussed therein, this does not seem to be the volume you are seeking..."
msgstr "От прочитанного голова идёт кругом, но, похоже, это не та книга, которую вы ищете..."

#. ja: (-『デミール家が生んだ奇蹟』-)本書は、デミール家第9代当主ヌハシャンが発見せし秘術、<br>すなわち世界を繋ぐ門の制御法を記したものである。
#. de: (-Das Wunderwerk der Daemir-)<i>Dieses Werk befasst sich mit dem wundersamen Wirken des Nuhashahn Daemir, Patriarch der Familie Daemir in neunter Generation, und expliziert die von ihm erdachte Methode zur Manipulation eines Dimensionsportals.</i>
#. fr: (-La miraculeuse découverte des Daemir-)Ce tome contient les détails relatifs à la méthode de manipulation des portails dimensionnels, telle qu'elle fut mise au point par Nuhashan, neuvième patriarche de la maison Daemir.
#. speaker: SYSTEM
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_130:1"
msgid "(-<i>Epiphanies of House Daemir</i>-)<i>The following pages detail an advanced method for manipulating rift-spanning apertures as devised by Nuhashahn, the ninth patriarch of House Daemir.</i>"
msgstr "(-<i>Озарения дома Даэмир</i>-)<i>На следующих страницах описан усовершенствованный способ управления порталами, соединяющими разломы. Его разработал Нухашахн, девятый глава дома Даэмир.</i>"

#. ja: (-『デミール家が生んだ奇蹟』-)シャーレアン魔法大学学長殿、<br>ならびに魔法学学会・会員の皆様に、<br>友情の証として、我が知識のすべてを贈るものである。
#. de: (-Das Wunderwerk der Daemir-)<i>Dieser Band und das darin enthaltene Wissen ist für die Magieakademie zu Sharlayan bestimmt, als Zeichen der Freund<shy>schaft zwischen den Gelehrten Sharlayans und Thavnairs und Symbol tiefster Bewunderung.</i>
#. fr: (-La miraculeuse découverte des Daemir-)Nous avons compilé ces recherches en gage d'amitié envers l'académie de magie de Sharlayan et son Conseil, dans l'espoir que ce geste ouvre la voie à de nombreux échanges entre notre maison et la Cité du savoir.
#. speaker: SYSTEM
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_131:1"
msgid "(-<i>Epiphanies of House Daemir</i>-)<i>We present these research notes to the faculty of Sharlayan's Studium as both a token of our friendship and an expression of our boundless admiration.</i>"
msgstr "(-<i>Озарения дома Даэмир</i>-)<i>Мы преподносим эти исследовательские записи преподавателям Студиума в знак дружбы и глубокого восхищения.</i>"

#. ja: 探していた禁書に間違いないようだ。<br>ヤ・シュトラに渡そう。
#. de: Du scheinst das richtige Buch in deinen Händen zu halten. Zeige es Y'shtola.
#. fr: Vous avez découvert le livre qu'il vous fallait. Donnez-le à Y'shtola.
#. speaker: SYSTEM
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_SYSTEM_000_132:1"
msgid "You appear to have located the forbidden volume you seek. Y'shtola will need to make the final confirmation..."
msgstr "Похоже, вы нашли нужный запретный фолиант. Я'штоле нужно его проверить..."

#. ja: お目当ての本を見つけたですって？<br>ごめんなさい、出遅れたわ。<br>軽くめくった本の中身が気になってしまって……困ったものね。
#. de: Hast du es gefunden? Verzeih, ich war wohl keine große Hilfe<nbsp>... Das erste Buch, das ich aufschlug, war bereits so brisant, dass ich mich nicht mehr lösen konnte.
#. fr: Tu as trouvé le livre en question<nbsp>? Je suis désolée, j'ai ouvert le premier tome qui m'est tombé sous la main et je n'ai pas réussi à le reposer...
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_150:1"
msgid "Have something you'd like to show me, do you? My apologies─I flipped open but a single book and was completely absorbed by the contents..."
msgstr "Нашли то, что хотели показать? Прости, я раскрыла одну-единственную книгу и так увлеклась, что не смогла оторваться..."

#. ja: ありがとう、助かったわ。
#. de: Ausgezeichnet! Dann wollen wir doch einmal sehen<nbsp>...
#. fr: Merci, je pense que c'est exactement ce que nous cherchions.
#. speaker: YSHTOLA
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_151:1"
msgid "Well done, <split \" \" 1><string $gs1></split>. I think you may have found our prize."
msgstr "Отличная работа, <split \" \" 1><string $gs1></split>. Кажется, ты нашёл нашу добычу."

#. ja: オ探シ　ノ　本ガ　見ツカッテ　何ヨリデス。
#. de: Das gESuchtE BuCh wuRdE gefUNden. AcHtUNg: Bei sPÄteR AbgAbE fAllEn erHEbLicHe GebÜHreN aN.
#. fr: Heureux de savoir que vous avez pu trouver votre bonheur.
#. speaker: GUIDE04533
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_GUIDE04533_000_200:1"
msgid "CoNgRaTuLaTiOnS oN lOcAtInG tHe ObJeCt Of YoUr SeArCh. PlEaSe MoVe AlOnG."
msgstr "ПозДравляю с нАхОдкой. ПожалуйСтА, пройдИте дАльше."

#. ja: さて、すぐにでも人造アトモスの製作にかかりたいのだけれど、<br>私は錬金術は門外漢だから、素直に専門家を頼るとしましょう。
#. de: Zwar will ich mich nun schnellst<shy>möglich selbst an einem künstlichen Atomos versuchen, aber mein Wissen um die Alchemie ist unangenehm mangelhaft. Nein, wir sollten uns an die Experten wenden.
#. fr: Même si j'aimerais me lancer sur-le-champ dans la création d'un atomos artificiel, j'ai bien peur que cela dépasse quelque peu mes compétences. Il va nous falloir l'aide d'un expert, ou plutôt d'une experte<nbsp>!
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_210:1"
msgid "As much as I would love to start crafting the Atomos, I'm afraid this is far outside my field of expertise."
msgstr "Я бы с радостью взялась за создание Атомоса, но боюсь, это совсем не моя область."

#. ja: デミール家が編み出した秘術なのだから、<br>その名を冠するデミールの遺烈郷の錬金術師に相談するべきね。<br>ニッダーナなら、喜んで話を聞いてくれるんじゃないかしら。
#. de: Die Daemir waren die Urheber dieser Methode, also ist es nur naheliegend, sich Unterstützung in ihrer Heimat zu suchen. Außerdem freut sich Nidhana ganz sicher über ein Wieder<shy>sehen.
#. fr: Je pense à une certaine alchimiste travaillant ac<shy>tu<shy>el<shy>le<shy>ment dans un lieu dédié à la maison Daemir. Je veux bien entendu parler de Nidhana.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_211:1"
msgid "Fortunately, we know a Hannish alchemist who would be delighted to involve herself in our House Daemir project."
msgstr "К счастью, мы знаем ханнийскую алхимичку, которая с радостью примется за наш проект с домом Даэмир."

#. ja: 協力ありがとう。<br>哲学者議会にもよろしく伝えておいて。
#. de: Ich danke für Weisung und Geduld. Richte dem Rat der Philosophen bitte auch unsere tiefste Dankbarkeit aus.
#. fr: Merci pour votre aide. Veuillez aussi transmettre toute notre gratitude aux membres du Conseil.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_212:1"
msgid "Our business here is concluded, for the moment. Please pass on our regards to the Forum."
msgstr "На этом пока всё. Передайте Форуму от нас привет."

#. ja: 承知シマシタ。<br>オ目当テ　ノ　本ガ　アレバ　マタオコシヲ。<br>禁書以外　デアレバ　イツデモ　オ探シ　イタシマス。
#. de: NaCHricHt regiStriERt. VielEn DanK für EurEn BeSUch, bitTE beEhrt unS baLd wiEder. Der ReST der BiBLiOthEk steHt EucH jeDErzeiT offEn.
#. fr: Bien compris. Revenez me voir si vous désirez consulter d'autres ouvrages. Tant qu'ils ne sont pas dans les rayonnages interdits, évidemment.
#. speaker: GUIDE04533
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_GUIDE04533_000_213:1"
msgid "YoUr MeSsAgE wIlL bE cOnVeYeD. sHoUlD yOu WiSh To InDuLgE iN mOrE fOrBiDdEn LiTeRaTuRe, I wIlL bE hErE. pAtRoN mOdE dIsAbLeD. sEcUrItY mOdE eNgAgEd."
msgstr "Ваше сообЩение бУдет передАно. ЕсЛи захотИте почИтать запрЕтную литерАтуру, я буду здЕсь. РежИм посетИтеля отключён. РежИм охрАны активИрован."

#. ja: それじゃ、サベネア島に向かいましょう。
#. de: Auf nach Thavnair, würde ich sagen.
#. fr: Bien, il est temps de retourner à Thavnair.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_214:1"
msgid "If anyone can help us, Nidhana can. I say we return to Thavnair and look for her at the Great Work."
msgstr "Если кто и поможет нам, так это Нидхана. Предлагаю вернуться в Тавнаир и найти её в Великом творении."

#. ja: 相変わらず、ここの錬金術師たちは、<br>徹夜続きの青ざめた顔でも、眼だけは生き生きとしているわね。
#. de: Die Schatten unter den Augen der hiesigen Alchemisten sind so tief wie eh und je, was? Aber gleichzeitig glimmt das Feuer der Wissbegierde in ihrem Blick. Ach, mir gefällt dieser Ort.
#. fr: Comme d'habitude, les alchimistes d'ici ont tous l'air exténués à force d'enchaîner les nuits blanches. Seul leur regard brille d'une lueur vive.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_250:1"
msgid "All these sallow, sleep-deprived faces, but their eyes still burn with fiery zeal. Some things never change."
msgstr "Лица у здешних алхимиков по-прежнему бледные от недосыпа, а глаза горят рвением. Есть вещи, которые никогда не меняются."

#. ja: ヤ・シュトラさんから聞いたよ！<br>何でも、楽しそうな研究に混ぜてもらえるんだって？
#. de: Ah, <split " " 1><string $gs1></split>! Y'shtola hat schon erwähnt, dass ihr an einem entsetzlich spannenden Projekt sitzt. Und ihr braucht meine Unterstützung, habe ich gehört?
#. fr: Y'shtola m'a déjà expliqué que vous aviez besoin de mon aide pour vos recherches, c'est bien cela<nbsp>?
#. speaker: NIDHANA
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_NIDHANA_000_260:1"
msgid "Y'shtola tells me you are pursuing a most fascinating study! And that you want <i>me</i> to be a part of it."
msgstr "Я'штола сказала, что вы заняты невероятно интересным исследованием! И хотите, чтобы в нём участвовала <i>я</i>."

#. ja: きっとあなたたちには楽しんでもらえると思うわ。<br>まずは、この書物を見て頂戴。
#. de: Aber bitte, unbedingt. Ich glaube, es wird dir gefallen. Hier, sieh dir dieses Buch an.
#. fr: Oh, je pense qu'on a apporté de quoi piquer ta curiosité. Tiens, jette un œil sur ce livre.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_261:1"
msgid "I have no doubt you will be interested. This research log should speak for itself."
msgstr "Уверена, тебе будет интересно. В этих записях всё сказано."

#. ja: どれどれ……。
#. de: Was haben wir denn hier?
#. fr: Qu'est-ce donc...<nbsp>?
#. speaker: NIDHANA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_NIDHANA_000_262:1"
msgid "Will it now...?"
msgstr "Ну-ка, посмотрим..."

#. ja: えっ！？<br>この署名は、デミール家の……！<br>でも、こんな書物、存在すら聞いたことがないよ！
#. de: D-Das ist doch das Wappen der Daemir! Aber dieses Buch ist mir noch nie untergekommen<nbsp>...
#. fr: Quoi<nbsp>!? C-c'est l'emblème de la maison Daemir<nbsp>! Je ne savais même pas qu'un tel recueil existait... Comment l'avez-vous obtenu<nbsp>?
#. speaker: NIDHANA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_NIDHANA_000_263:1"
msgid "By the Sisters! This is the mark of House Daemir! I never even knew such a work existed..."
msgstr "Клянусь Сёстрами! Это знак дома Даэмир! Я и не знала, что такая книга вообще существует..."

#. ja: でしょうね。<br>ヌーメノン大書院の禁書庫から、持ち出してきたんですもの。
#. de: Das dachte ich mir. Es scheint das einzige Exemplar zu sein und ruhte bis vor kurzem im verbotenen Flügel des Noumenons, Sharlayans größter Bibliothek.
#. fr: Rien de surprenant, nous l'avons trouvé dans les archives interdites du Noumène, à Sharlayan.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_264:1"
msgid "Few should. It was sequestered in Noumenon's restricted archives, after all."
msgstr "Мало кто знал. В конце концов, её хранили в закрытом отделении Ноумена."

#. ja: ええっ！？<br>それじゃ、これ禁書ってこと！？
#. de: Was?! Dieses Buch ist <i>verboten</i>?
#. fr: Vraiment<nbsp>!? Attendez... “archives interdites”, ça veut dire que...
#. speaker: NIDHANA
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_NIDHANA_000_265:1"
msgid "It was!? But...that means every word within is <i>forbidden knowledge</i>!"
msgstr "И правда!? Но... получается, тут сплошные <i>запретные знания</i>!"

#. ja: そ、そんな……<br>禁書は読むことを禁じられているから禁書なんだよ！？<br>そんなもの渡されたら……
#. de: Sollte ich es dann überhaupt lesen? Ist das wirklich in Ordnung? Oje, oje<nbsp>...
#. fr: C-ce livre... il contient un savoir caché, inaccessible à tous depuis des lustres, n'est-ce pas<nbsp>? Et vous allez le laisser entre mes mains... juste comme ça<nbsp>?
#. speaker: NIDHANA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_NIDHANA_000_266:1"
msgid "A forbidden tome filled with forbidden research, and you put it right into my unsuspecting hand!?"
msgstr "Запретная книга с запретными исследованиями — и вы просто взяли и сунули её мне в руки!?"

#. ja: 読むに決まってるじゃない！
#. de: Aber das finde ich wohl nur heraus, wenn ich einen Blick riskiere!
#. fr: Je ne vais pas me gêner pour le dévorer, c'est certain<nbsp>!
#. speaker: NIDHANA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_NIDHANA_000_267:1"
msgid "I can hardly wait to read it!"
msgstr "Не могу дождаться, когда прочту!"

#. ja: デミール家が、過去にこんな秘術を編み出していたなんて……<br>まだまだアタシたちの知らないことは多いなぁ……。
#. de: Niemandem von uns hier war bewusst, dass die Daemir früher solche Forschung betrieben haben<nbsp>...
#. fr: J'ignorais que les Daemir avaient accompli de telles prouesses... Combien de ces savoirs anciens ont été perdus avec le temps, je me le demande.
#. speaker: NIDHANA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_NIDHANA_000_268:1"
msgid "To think the Daemir were developing such marvelous techniques so long ago. How many innovations have been lost over the centuries, I wonder..."
msgstr "Подумать только, дом Даэмир ещё так давно разрабатывал подобные удивительные технологии. Сколько открытий кануло в века, интересно..."

#. ja: もう察していると思うのだけれど……<br>その書物に記されている人造アトモスの製作に、<br>力を貸してもらえないかしら？
#. de: Du ahnst vermutlich schon, worum ich dich gleich bitten werde. Wir brauchen einen künstlichen Atomos<nbsp>- und dafür deine Hilfe.
#. fr: Maintenant que tu as lu le contenu du recueil, je pense que tu peux deviner nos intentions<nbsp>: nous voudrions recréer un atomos artificiel. Penses-tu pouvoir nous aider<nbsp>?
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_269:1"
msgid "Now that you've glanced over the notes, what say you to helping us build a new mock Atomos?"
msgstr "Ты уже заглянула в записи, так что, наверное, догадываешься, о чём я попрошу... Не поможешь нам создать новый искусственный Атомос?"

#. ja: もちろん、喜んで！<br>むしろ、こっちからお願いしたいぐらい！
#. de: Das habe ich mir tatsächlich schon gedacht. Selbstverständlich werde ich euch dabei aus Leibeskräften unterstützen!
#. fr: Évidemment<nbsp>! Avec plaisir, même<nbsp>!
#. speaker: NIDHANA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_NIDHANA_000_270:1"
msgid "I say yes! A thousand times yes!"
msgstr "Я согласна! Тысячу раз согласна!"

#. ja: あの高名なシャーレアンの賢人たちを震え上がらせて、<br>禁書に指定させてしまった知識だなんて、<br>紐解かずにはいられないよ！
#. de: Wie könnte ich auch einem derartigen Unterfangen widerstehen? Es hat schließlich selbst die Gelehrten und Weisen Sharlayans derart tief erschüttert, dass sie dieses Werk all die Jahre lang verborgen hielten!
#. fr: Travailler sur un projet dont l'existence même fait trembler les plus grands érudits de la Cité du savoir<nbsp>? Aucun alchimiste digne de ce nom ne pourrait refuser.
#. speaker: NIDHANA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_NIDHANA_000_271:1"
msgid "Work on a Daemir project that had even the redoubtable scholars of Sharlayan trembling in their sandals? No alchemist of the Great Work could resist!"
msgstr "Да кто устоит перед проектом Даэмиров, от которого даже грозные учёные Ноумена дрожали? Ни один алхимик Великого творения не откажется!"

#. ja: その気持ち、私にもよくわかるわ。
#. de: Nidhana, wir verstehen uns.
#. fr: Je vois qu'on partage la même soif de savoir.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_272:1"
msgid "You are a woman after my own heart."
msgstr "Ты мне по душе."

#. ja: ところで、人造アトモスなんて作ってどうするの？
#. de: Wo mich die Neugier ohnehin schon gepackt hat<nbsp>... Wofür braucht ihr den künstlichen Atomos denn, wenn ich fragen darf?
#. fr: Mais au fait, que comptez-vous faire avec cet atomos artificiel<nbsp>?
#. speaker: NIDHANA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_NIDHANA_000_273:1"
msgid "Oh, I suppose I should ask: what do you mean to do with this big-mouthed simulacrum once we've built it?"
msgstr "Кстати, а зачем вам этот здоровенный искусственный Атомос?"

#. ja: 豊穣海に沈んだ海底遺跡に、<br>封印されたヴォイドゲート……。<br>本当、アタシの知らないことってまだまだあるんだぁ……。
#. de: Die Schatzkammer von Alzadaal gibt es also tatsächlich! Du liebe Güte, so viele Geheimnisse, die mir heute enthüllt werden<nbsp>...
#. fr: Il y a une porte du néant, scellée dans un palais au fond de la mer de l'Abondance<nbsp>? Vraiment, je vais de surprise en surprise aujourd'hui...
#. speaker: NIDHANA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_NIDHANA_000_274:1"
msgid "So, there's a secret voidgate...and it's sealed in the ruins at the bottom of the Bounty? Today is a day of revelations indeed."
msgstr "Значит, там, на дне Обильного моря, в руинах скрыты врата Пустоты... Вот уж день открытий!"

#. ja: ともあれ、人造アトモスにゲートを拡張させるなら、<br>まずは、その実物を見ておく必要がありそうだね。<br>危険なものだろうから、失敗は許されないし……。
#. de: Aber wenn wir das Portal mit einer Atomos-Marionette weiten wollen, werde ich nicht umhinkommen, es mir zunächst mit eigenen Augen anzusehen. Auch wenn mir der Gedanke daran schon einen Schauer über den Rüssel jagt<nbsp>...
#. fr: Cependant, si vous souhaitez utiliser un atomos pour l'agrandir, il serait plus pratique que je voie la chose de mes propres yeux avant tout. C'est une opération très dangereuse alors vous savez ce qu'on dit<nbsp>: “Prudence est mère de sûreté<nbsp>!”
#. speaker: NIDHANA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_NIDHANA_000_275:1"
msgid "If the purpose of our man-made Atomos is to expand this hidden portal, then I will need to see it for myself, I think. Manipulating rift-spanning apertures is not the sort of thing you want to attempt without first taking into account every single factor."
msgstr "Если наш искусственный Атомос нужен, чтобы расширить тайные врата, мне надо сначала увидеть их своими глазами. С порталами, соединяющими разломы, шутки плохи — нужно учесть всё до мелочей."

#. ja: それなら、私たちと一緒に行きましょう。<br>ちょうど、ヴォイド探索に向けて、<br>もうひとつの準備をするところだったから。
#. de: Dann komm doch gleich mit mir mit, Nidhana! Ich wollte ohnehin in die Ruinen zurückkehren, um diverse Vor<shy>bereitungen zu treffen.
#. fr: Dans ce cas, je te propose d'y aller ensemble. J'avais de toute manière prévu de me rendre sur place pour mener une petite expérience.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_276:1"
msgid "Then by all means, accompany us to the vault. I plan to lead us back there shortly...once we've finished gathering the components I require."
msgstr "Тогда отправляйся с нами к сокровищнице. Скоро мы вернёмся туда... когда соберём нужные мне материалы."

#. ja: これから行う準備には、<br>「<sheet EventItem 2003392 0>」と「アクアマリンの原石」、<br>それに「高純度の水属性クリスタル」を用意する必要があるの。
#. de: Wo wir schon davon sprechen<nbsp>... Dazu brauche ich astralaspektiertes Wasser, Roh-Aquamarin und einen Wasserkristall des höchsten Reinheitsgrades.
#. fr: Dans cette optique, il va me falloir quelques composants spécifiques<nbsp>: de l'eau chargée en énergie astrale, une aigue-marine brute, et enfin un cristal d'eau par<shy>ti<shy>cu<shy>liè<shy>rement pur.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_277:1"
msgid "Sharlayan's markets provided the raw aquamarine and pure water crystals..."
msgstr "В магазинах Старого Шарлаяна нашлись необработанный аквамарин и чистые водяные кристаллы..."

#. ja: 原石とクリスタルについては、<br>オールド・シャーレアンで仕入れておいたから、<br>残る「<sheet EventItem 2003392 0>」を入手してきてもらえないかしら。
#. de: Den Aquamarin und den Wasserkristall habe ich mir bereits in Alt-Sharlayan besorgt. Dürfte ich dich vielleicht mit der Beschaffung des Wassers beauftragen?
#. fr: Pour ce qui est des pierres précieuses et des cristaux, je devrais pouvoir me fournir à Sharlayan sans trop de problèmes. Je peux compter sur vous pour récupérer l'eau<nbsp>?
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_278:1"
msgid "But I might need help obtaining a small quantity of astrally infused water."
msgstr "Но мне может понадобиться твоя помощь. Нужно раздобыть немного воды, насыщенной астральной энергией."

#. ja: それなら、「マーヤーの幻泉」へ行くといいよ。<br>あそこの水は、魔力を活性化する作用があると言われていて、<br>古くは、魔術師たちが修行に使っていた場所なんだ。
#. de: Ah, da empfiehlt sich der Mayaquell. Seinen Wassern werden magische Kräfte zugeschrieben, und vor langer Zeit diente es als Übungsstätte für angehende Zauberwirker.
#. fr: Le mieux, c'est de se rendre à la source de la Maya. On raconte que jadis, les sorciers l'utilisaient comme lieu d'ascèse, et que depuis, l'eau est dotée de propriétés par<shy>ti<shy>cu<shy>liè<shy>res qui facilitent l'usage de la magie.
#. speaker: NIDHANA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_NIDHANA_000_279:1"
msgid "For such a liquid, you need go no further than the Font of Maya─the ascetics of old once favored the place for their meditations, and the water which pools there now is known to enliven the flow of aether."
msgstr "Тебе поможет Источник Майи. Древние аскеты приходили туда медитировать, а вода, что собирается в источнике, оживляет поток эфира."

#. ja: あなたが水汲みに行っている間に、私はヴリトラを呼んでくるわ。<br>これから行うことは、ゲートの封印装置を操作する必要があるのよ。
#. de: Während du das Wasser holen gehst, werde ich Vrtra um seine Anwesenheit bitten. Schließlich lässt sich das Siegel nicht ohne ihn öffnen.
#. fr: Excellent<nbsp>! Pendant que tu seras parti<if $gn4>e</if> en expédition là-bas, je me chargerai de prévenir Vrtra. Mon expérience nécessite un accès libre à la porte du néant et il est le seul à pouvoir lever le sceau.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_280:1"
msgid "That sounds perfect. If you would be so kind as to fill a flask at the pool, I will petition Vrtra to join us. The idea I have in mind won't amount to much without his authority to command the voidgate."
msgstr "Отлично. Набери воды в колбе, а я попрошу Врйтру к нам присоединиться. Без его власти над вратами моя задумка не сработает."

#. ja: じゃあ、頼むわね。<br>終わり次第、またここで会いましょう。
#. de: Ich schicke dich wirklich nur ungern auf einen Botengang, aber<nbsp>... Du nimmst es mir nicht übel, oder? Treffen wir uns wieder hier, wenn alles erledigt ist.
#. fr: Je compte sur vous. Retrouvons-nous ici quand vous aurez fini.
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_281:1"
msgid "Shall we be about it, then? We meet back here anon."
msgstr "Ну что, приступим? Потом встретимся здесь."

#. ja: そんな重大でおもしろそうな計画に加えてもらえて嬉しいよ！<br>期待に応えられるようにがんばるね！
#. de: Ein Vorstoß in unbekannte Forschungsgefilde<nbsp>... Was gibt es Schöneres?
#. fr: Je suis vraiment ravie que vous ayez fait appel à moi pour ce petit projet<nbsp>! Je ferai de mon mieux pour vous aider<nbsp>!
#. speaker: NIDHANA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_NIDHANA_000_300:1"
msgid "Ah, there is no greater joy than having a new puzzle to ponder..."
msgstr "Нет ничего радостнее новой загадки, над которой можно поломать голову..."

#. ja: 再び海底遺跡に向かうのだろう？
#. de: So steigen wir abermals hinab auf den Meeresgrund<nbsp>...
#. fr: Vous souhaitez retourner dans le palais sous-marin, n'est-ce pas<nbsp>?
#. speaker: VARSHAHN
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_VARSHAHN_000_400:1"
msgid "Archon Y'shtola requested that I join you, but of her plans she offered scant detail..."
msgstr "Архон Я'штола попросила меня присоединиться к вам, но о своих планах рассказала мало..."

#. ja: メラドの奴、カルザール基金の話を聞いて、<br>たいそう喜んでたぞ。
#. de: Mehrahd war außer sich vor Freude, als ich ihm von der Khalzahl-Stiftung erzählt habe.
#. fr: Mehrahd a pris la nouvelle à cœur quand je lui ai annoncé la création du fonds Khalzahl. J'imagine que la perspective d'un toit pour lui et sa sœur y est pour beaucoup.
#. speaker: ESTINIEN
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_ESTINIEN_000_405:1"
msgid "The boy Mehrahd was glad to hear the news of the foundation. It means a new life for him and his sister."
msgstr "Мехрад был очень рад услышать о фонде. Для него и сестры это шанс начать новую жизнь."

#. ja: 言い忘れていたけど、マーヤーの幻泉は、<br>魔術師たちの修行場だっただけあって、魔物に気をつけて！<br>って、もう遅いよね……？
#. de: Ach, <split " " 1><string $gs1></split>! Ich habe dir ganz vergessen zu sagen, dass es am Mayaquell vor Biestern und Ungeheuern nur so wimmelt<nbsp>... Wegen des magischen Wassers. Oje, das hätte mir wirklich früher einfallen sollen<nbsp>...
#. fr: Ah<nbsp>! J'ai oublié de te prévenir, mais... la source de la Maya est infestée de créatures très dangereuses, alors prends garde<nbsp>! Comment ça... “trop tard”<nbsp>?
#. speaker: NIDHANA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_NIDHANA_000_410:1"
msgid "Oh, I forgot to mention! The Font of Maya attracts aggressive wildlife, and you should watch out for them when, uh...you go there next time. My apologies."
msgstr "Ой, я забыла предупредить! У Источника Майи водятся агрессивные звери, так что, э-э... в следующий раз будь осторожнее. Прости."

#. ja: 「<sheet EventItem 2003392 0>」は手に入ったかしら？
#. de: Hast du das aspektierte Wasser bei dir?
#. fr: As-tu obtenu ce que je t'avais demandé<nbsp>?
#. speaker: YSHTOLA
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_420:1"
msgid "Do you have that flask for me?"
msgstr "У тебя есть для меня эта фляга?"

#. ja: ああ、これだけあれば十分よ。<br>助かったわ、私の持ってきた材料とあわせて、<br>ヴォイドゲートのところまで運びましょう。
#. de: Ja, das ist mehr als genug. Ich danke dir.
#. fr: Oui... c'est parfait. Merci bien, <split " " 1><string $gs1></split>. J'ai tout ce qu'il nous faut. En route pour la porte du néant<nbsp>!
#. speaker: YSHTOLA
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/045/AktKmh108_04533:TEXT_AKTKMH108_04533_YSHTOLA_000_421:1"
msgid "Yes...this should suffice. Thank you, <split \" \" 1><string $gs1></split>."
msgstr "Да... этого должно хватить. Спасибо, <split \" \" 1><string $gs1></split>."
