msgctxt "quest/046/BanLop006_04686:TEXT_BANLOP006_04686_SYSTEM_000_074:1"
msgid "You have learned the emote <ui-color 500><ui-edge-color 501>Ear Wiggle</ui-edge-color></ui-color>!"
msgstr "Так что позвольте ещё раз поблагодарить вас. Огромное спасибо за всё!"
