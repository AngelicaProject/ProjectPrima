msgctxt "quest/046/ChrHdy101_04652:TEXT_CHRHDY101_04652_GEROLT_000_202:1"
msgid "<capitalize><noun-en Item 2 $n1 1 1></capitalize> an' <noun-en Item 2 $n2 1 1>!"
msgstr "<capitalize><noun-en Item 2 $n1 1 1></capitalize> да <noun-en Item 2 $n2 1 1>!"

#. ja: 「<sheet Item $n1 0>」だ！
#. de: <capitalize><noun-de Item 2 $n1 1 1 1></capitalize>!
#. fr: <if "<sheet Item $n1 6>">Une<else>Un</if> magnifique <noun-fr Item 12 $n1 1 1><nbsp>!
#. speaker: GEROLT
#. macro: <capitalize><noun-en Item 2 $n1 1 1></capitalize> — the content with its first letter in upper case (may be added or dropped)
