msgid "deleted"
msgstr "удалено"

#. ja: （★未使用／削除予定★）
#. de: Was macht ihr denn? Ihr solltet doch auf die Geiseln aufpassen!
#. fr: （★未使用／削除予定★）
#. kind: other
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_ROSALINDE_BATTLETALK_04:1"
msgid "deleted"
msgstr "удалено"

#. ja: （★未使用／削除予定★）
#. de: Na und? Oboro ist ein schwacher Stümper! <i>Ich</i> bin der neue Meister-Ninja!
#. fr: （★未使用／削除予定★）
#. kind: other
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_REDWAY_BATTLETALK_05:1"
msgid "deleted"
msgstr "удалено"

#. ja: （★未使用／削除予定★）
#. de: Oboro! Nein!
#. fr: （★未使用／削除予定★）
#. kind: other
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_AKAGI_BATTLETALK_06:1"
msgid "deleted"
msgstr "удалено"

#. ja: （★未使用／削除予定★）
#. de: Ha ha! Wollt ihr euch nicht besser ergeben?
#. fr: （★未使用／削除予定★）
#. kind: other
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_ROSALINDE_BATTLETALK_07:1"
msgid "deleted"
msgstr "удалено"

#. ja: ……しかたがない、あれを使おう。
#. de: Du bist nicht von schlechten Eltern ... Aber was sagst du dazu?
#. fr: Voilà pour vous occuper...
#. kind: other
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_REDWAY_BATTLETALK_09:1"
msgid "You...you've forced my hand. Let it be on your head!"
msgstr "Ты... ты сам вынудил меня! Пеняй на себя!"

#. ja: <split " " 1><string $gs1></split>、口寄せの陣を破壊するのだ！
#. de: Die gleichen Beschwörungszirkel wie bei Karasu! Schnell, <split " " 1><string $gs1></split>, du weißt, was zu tun ist!
#. fr: <split " " 1><string $gs1></split>, détruisez le cercle d'invocation<nbsp>!
#. kind: other
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_OBORO_BATTLETALK_10:1"
msgid "His mudra of summoning! <split \" \" 1><string $gs1></split>, you know what needs to be done!"
msgstr "Он складывает печать призыва! <split \" \" 1><string $gs1></split>, ты знаешь, что делать!"

#. ja: （★未使用／削除予定★）
#. de: Ich hab ein ganz schlechtes Gefühl bei diesem Zirkel ... <split " " 1><string $gs1></split>, zerstöre ihn!
#. fr: （★未使用／削除予定★）
#. kind: other
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_AKAGI_BATTLETALK_11:1"
msgid "deleted"
msgstr "удалено"

#. ja: ど、どうしよう……もう……奥の手……使う……ウン！
#. de: Spielverderber! Dann werd ich mal die schweren Geschütze auffahren.
#. fr: Vous ne me laissez pas le choix, ça non...
#. kind: other
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_REDWAY_BATTLETALK_12:1"
msgid "N-No! I'll make you regret this! Yes! YES!"
msgstr "Н-нет! Вы ещё пожалеете! Да! ДА!"

#. ja: <split " " 1><string $gs1></split>、やっかいな幻術士を倒せ！
#. de: Schnapp dir den Heiler, <split " " 1><string $gs1></split>!
#. fr: <split " " 1><string $gs1></split>, concentrez-vous sur l'élé<shy>men<shy>ta<shy>lis<shy>te<nbsp>!
#. kind: other
#. macro: <br> — a line break (may be added or dropped)
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_AKAGI_BATTLETALK_13:1"
msgid "Wh-Who's the conjurer!?<br><split \" \" 1><string $gs1></split>, stop him, quickly!"
msgstr "К-кто тут заклинатель!?<br><split \" \" 1><string $gs1></split>, останови его, скорее!"

#. ja: こ、こ、これ以上は、報酬の割に合わない……！！<br>い、命は大事、俺の命は一番大事、ウン！！
#. de: Jetzt wird's eng ... Ich verabschiede mich.
#. fr: Je ne suis pas assez payé pour y laisser ma peau, ça non...<nbsp>!
#. kind: other
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_REDWAY_BATTLETALK_14:1"
msgid "No...no, this is not worth it! My reward is not worth my life! No!"
msgstr "Н-нет, это того не стоит! Награда не стоит моей жизни! Нет!"

#. ja: レッドウェイ……。<br>契約違反は、命を持って償ってもらうよ！！
#. de: Verräter! Das wirst du mir büßen!
#. fr: Redway<nbsp>! Si tu te débines, c'est moi qui te trancherai la gorge<nbsp>!
#. kind: other
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_ROSALINDE_BATTLETALK_15:1"
msgid "WHAT!? Mutiny, is it!? I'll have yer head, Redway─YER HEAD!"
msgstr "ЧТО!? Мятеж, значит!? Я тебе голову оторву, Редвей! ОТОРВУ!"

#. ja: なっ……何を……！<br>わ、わ、わ、わ、わ、わあぁぁぁぁぁ！！
#. de: W-Was? Aaaah!
#. fr: Aaaaaaaaaaaaah...<nbsp>!!!
#. kind: other
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_REDWAY_BATTLETALK_16:1"
msgid "Wha─ Arrrggghhh! AAAAAAHHH!"
msgstr "Чт... А-А-А-А-А-А-А!"

#. ja: どいつもこいつも、使えない連中だね！<br>仕方ない、あたしが相手をしてやるよ！
#. de: Nichtsnutziges Pack! Alles muss man selber machen!
#. fr: Décidément, il faut tout faire soi-même... Je vais m'occuper de vous personnellement<nbsp>!
#. kind: other
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_ROSALINDE_BATTLETALK_17:1"
msgid "The lot of ye are wastes o' skin! I'll do it meself!"
msgstr "Да вы все просто никчёмные! Ладно, сама с вами разберусь!"

#. ja: ……あ、あいつら、仲間じゃなかったのかよ！！
#. de: Hui, die ist nicht gerade zimperlich.
#. fr: ... Ils n'étaient pas partenaires, eux<nbsp>!?
#. kind: other
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_AKAGI_BATTLETALK_18:1"
msgid "Why? Gods, he...he was your ally!"
msgstr "Почему? Боги, он... он же был твоим союзником!"

#. ja: レッドウェイ……哀れな忍びだ……。
#. de: Das war hart.
#. fr: Redway... Quel piètre ninja tu fais...
#. kind: other
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_OBORO_BATTLETALK_19:1"
msgid "May you find peace, Redway..."
msgstr "Покойся с миром, Редвей..."

#. ja: 己の忍びに、なんてことを……！
#. de: Er war dein Shinobi! Wie kannst du nur ...?
#. fr: Vous êtes vraiment ignobles<nbsp>!
#. kind: other
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_YUKI_BATTLETALK_20:1"
msgid "Rosalinde, your own shinobi... Why!?"
msgstr "Розалинда, да как ты могла так поступить со своим синоби!? Почему!?"

#. ja: 傭兵なんだからぁ、仕事ができなきゃクビ……<br>当然でしょ……？
#. de: Er war doch nur ein Söldner, der für ein paar Gil kämpft.
#. fr: Tu n'as encore rien vu<nbsp>! Je vais me faire un plaisir de te torturer...
#. kind: other
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_ROSALINDE_BATTLETALK_21:1"
msgid "A hired sword that can't do his job don't<br>deserve to be <i>hired</i> no more, does he?"
msgstr "Наёмник, который не справляется с работой,<br>больше не заслуживает того, чтобы его <i>нанимали</i>, верно?"

#. ja: 違う……！　忍びは、心と刃を預けた仲間だ！<br><split " " 1><string $gs1></split>が、それを証明してくれる！
#. de: Du weißt halt nicht, was ein <i>echter</i> Shinobi wert ist. <split " " 1><string $gs1></split>, zeig es ihr!
#. fr: Tes actions ne resteront pas impunies<nbsp>! Mes amis vont t'infliger le châtiment que tu mérites<nbsp>!
#. kind: other
#. macro: <br> — a line break (may be added or dropped)
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/016/JobNin600_01688:TEXT_JOBNIN600_01688_QIB_001_YUKI_BATTLETALK_22:1"
msgid "But you should've trusted his blade... To hells with you!<br><split \" \" 1><string $gs1></split>, show her what <i>true</i> shinobi can do!"
msgstr "Но ты должен был довериться его клинку... Чтоб тебя!<br><split \" \" 1><string $gs1></split>, покажи ей, на что способны <i>истинные</i> синоби!"
