msgid "With the chat mode in <ui-color 500><ui-edge-color 501>Say</ui-edge-color></ui-color>, use your keyboard or the software keyboard to enter the search term “Clots” at the commerce sector data terminal."
msgstr "Переключите режим чата на <ui-color 500><ui-edge-color 501>Сказать</ui-edge-color></ui-color> и введите слово «Сгустни» в терминале Торгового сектора."

#. ja: クロット
#. de: Klumpen
#. fr: caillot
#. speaker: SAYTODO
msgctxt "quest/054/ChrHdb951_05481:TEXT_CHRHDB951_05481_SAYTODO_000_135:1"
msgid "Clots"
msgstr "Сгустни"

