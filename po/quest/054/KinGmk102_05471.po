msgctxt "quest/054/KinGmk102_05471:TEXT_KINGMK102_05471_SYSTEM_000_403:1"
msgid "You may now enter the Clyteum with a party of NPC avatars. To make use of this feature, open the <ui-color 500><ui-edge-color 501>Trust</ui-edge-color></ui-color> interface located under <ui-color 500><ui-edge-color 501>Duty</ui-edge-color></ui-color> in the main menu."
msgstr "Теперь в Клитеум можно отправиться с отрядом персонажей-NPC. Чтобы воспользоваться этой возможностью, откройте раздел <ui-color 500><ui-edge-color 501>«Соратники»</ui-edge-color></ui-color> в меню <ui-color 500><ui-edge-color 501>«Задания»</ui-edge-color></ui-color>."
