msgctxt "quest/047/AktKct202_04768:TEXT_AKTKCT202_04768_Q1_000_000:1"
msgid "What will you do?"
msgstr "Что будете делать?"

#. ja: もう少し悩んでみる
#. de: Ich überleg's mir noch einmal.
#. fr: Non
#. speaker: A1
