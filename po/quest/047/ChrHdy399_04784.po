msgctxt "quest/047/ChrHdy399_04784:TEXT_CHRHDY399_04784_SYSTEM_000_041:1"
msgid "Your Manderville weaponry (<if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if>) has been readjusted."
msgstr "Параметры оружия Мандервиллей<if ($gn68 < 8)> (<sheet ClassJob $gn68 0>)<else><if ($gn68 > 18)> (<sheet ClassJob $gn68 0>)</if></if> перенастроены."
