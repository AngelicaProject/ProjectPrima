msgctxt "quest/047/FesHlw901_04785:TEXT_FESHLW901_04785_SYSTEM_000_207:1"
msgid "You have learned the emote <ui-color 500><ui-edge-color 501>All Saints' Charm</ui-edge-color></ui-color>!"
msgstr "Вы выучили эмоцию «<ui-color 500><ui-edge-color 501>Заклинание Праздника Всех святых</ui-edge-color></ui-color>»!"
