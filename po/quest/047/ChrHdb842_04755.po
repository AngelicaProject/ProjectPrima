#. de: Mit Hildibrand im Archeion sprechen
#. fr: Parler à Hildibrand, à l'Archéion
#. kind: objective
msgctxt "quest/047/ChrHdb842_04755:TEXT_CHRHDB842_04755_TODO_02:1"
msgid "Speak with Hildibrand at the Archeion."
msgstr ""

#. ja: メリオール実験農場で情報を集める
#. de: In Meryalls Agrarbotanik Informationen sammeln
#. fr: Recueillir des in<shy>for<shy>ma<shy>tions au laboratoire agronomique de Meryall
#. kind: objective
msgctxt "quest/047/ChrHdb842_04755:TEXT_CHRHDB842_04755_TODO_03:1"
msgid "Gather information at Meryall Agronomics."
msgstr ""

