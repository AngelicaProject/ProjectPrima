#. de: Mit Hildibrand sprechen
#. fr: Reparler à Hildibrand
#. kind: objective
msgctxt "quest/047/ChrHdb842_04755:TEXT_CHRHDB842_04755_TODO_01:1"
msgid "Speak with Hildibrand."
msgstr ""

