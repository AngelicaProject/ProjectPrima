# quest/036/LucKmd115_03620 — «Crossing Paths» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 廃都ナバスアレンのミンフィリアは、真剣な眼差しをしている。
#. de: Minfilia blickt ernst in die Zerstörte Stadt.
#. fr: Minfilia est prête à affronter son destin.
#. kind: journal
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_SEQ_00:1"
msgid "The look in Minfilia's eyes is equal parts trepidation and determination."
msgstr "В глазах Минфилии смешались страх и решимость."

#. ja: <sheet EObj 2009921 0>で見渡す
#. de: Am <noun-de EObj 5 2009921 1 3 1> umsehen
#. fr: Observer les environs à l'endroit indiqué
#. kind: objective
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_TODO_00:1"
msgid "Survey the designated location."
msgstr "Осмотрите указанное место."

#. ja: ミンフィリアを探す
#. de: Minfilia helfen
#. fr: Réveiller Minfilia
#. kind: objective
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_TODO_01:1"
msgid "Search for Minfilia."
msgstr "Найдите Минфилию."

#. ja: サンクレッドを探す
#. de: Thancred suchen
#. fr: Rejoindre Thancred, à La Louche
#. kind: objective
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_TODO_02:1"
msgid "Search for Thancred."
msgstr "Найдите Танкрета."

#. ja: ……進みましょう、<split " " 1><string $gs1></split>さん。<br>もっと、「光の氾濫」の跡の近くへ……彼女のいた場所へ。
#. de: Komm. Gehen wir in die Zerstörte Stadt, <split " " 1><string $gs1></split>. Ich muss näher an die Stelle, an der die Lichtflut aufgehalten wurde. Wo das Orakel war.
#. fr: Continuons notre route vers la zone dévastée par la Lumière, <split " " 1><string $gs1></split>.
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_000:1"
msgid "(-Minfilia-)I can sense her presence, albeit faintly."
msgstr "(-Минфилия-)Я чувствую её присутствие, хоть и едва заметно."

#. ja: 近くまで行けば、何か、痕跡を感じられるはずです。
#. de: Wenn wir sie treffen können, dann da.
#. fr: Plus nous nous en rapprocherons, plus nous devrions sentir la présence de sa prêtresse...
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_001:1"
msgid "(-Minfilia-)Come on, let's look over by the crystal wall."
msgstr "(-Минфилия-)Пойдём, осмотрим стену из кристалла."

#. ja: ああ……そうです……このあたりが…………。
#. de: Dort oben war es. Auf dem hohen Gebäude.
#. fr: C'était là... J'en suis certaine...
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_010:1"
msgid "(-Minfilia-)She was here. On the top of this building..."
msgstr "(-Минфилия-)Она была здесь. На крыше этого здания..."

#. ja: (-ミンフィリア-)……ぅん………………。
#. de: (-Minfilia-)A-Ah ...
#. fr: (-Minfilia-)Uuh...
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_020:1"
msgid "(-Minfilia-)\\<groan>"
msgstr "(-Минфилия-)\\<groan>"

#. ja: (-ミンフィリア-)私、いったい……。<br>たしか……ミンフィリアと話して…………。
#. de: (-Minfilia-)Was ... Ich ... Ich habe mit Minfilia gesprochen<nbsp>... Endlich.
#. fr: (-Minfilia-)Qu'est-ce qui s'est passé...<nbsp>? Nous étions en train de parler avec Minfilia, et tout à coup...
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_021:1"
msgid "(-Minfilia-)What happened? I remember speaking with Minfilia...and then..."
msgstr "(-Минфилия-)Что случилось? Я помню, как говорила с Минфилией... А потом..."

#. ja: (-ミンフィリア-)……<split " " 1><string $gs1></split>さん？<br>私、何かおかしいですか……？
#. de: (-Minfilia-)Was ist? Warum guckst du mich denn so an?
#. fr: (-Minfilia-)P-pourquoi vous me regardez comme ça<nbsp>? Arrêtez, vous me faites peur<nbsp>!
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_022:1"
msgid "(-Minfilia-)Is something wrong?"
msgstr "(-Минфилия-)Что-то не так?"

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que répondez-vous<nbsp>?
#. speaker: Q1
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_Q1_000_000:1"
msgid "What will you say?"
msgstr "Что скажете?"

#. ja: 髪の色が……
#. de: Deine Haare ...
#. fr: Minfilia, tes cheveux<nbsp>!
#. speaker: A1
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_A1_000_001:1"
msgid "Your hair, it's changed."
msgstr "Цвет волос..."

#. ja: 目の色が……
#. de: Deine Augen ...
#. fr: Tes yeux ont changé de couleur<nbsp>!
#. speaker: A1
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_A1_000_002:1"
msgid "Your eyes, they've changed."
msgstr "Глаза... они изменились."

#. ja: (-ミンフィリア-)…………そっか。<br>「ミンフィリア」が、私を本来の姿に、<br>戻してくれたんだと思います。
#. de: (-Minfilia-)Minfilia ... hat sie mir zurückgegeben. Meine echten Haare, meine echten Augen.
#. fr: (-Minfilia-)Je sais ce qui s'est passé... Minfilia m'a rendu mon apparence d'origine.
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_023:1"
msgid "(-Minfilia-)A parting gift, I think."
msgstr "(-Минфилия-)Думаю, это был её прощальный подарок."

#. ja: (-ミンフィリア-)金の髪に、水晶色の目……<br>それらは転生して戦い続ける「ミンフィリア」の証だった……。
#. de: (-Minfilia-)Die blonden Haaren und die kristallblauen Augen waren die Er<shy>ken<shy>nungs<shy>zei<shy>chen der wiedergeborenen Minfilia.
#. fr: (-Minfilia-)Les cheveux blonds et les yeux bleus comme le cristal sont la marque de l'âme de la prêtresse de la Lumière.
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_024:1"
msgid "(-Minfilia-)Until now, I've walked the path she set before me. The path she set before all the Minfilias."
msgstr "(-Минфилия-)До сих пор я шла по пути, который она выбрала для меня. По пути, который выбрала для всех Минфилий."

#. ja: (-ミンフィリア-)今、彼女は私に命を……私として生きる道を、託してくれた。<br>だから…………。
#. de: (-Minfilia-)Sie will, dass ich ich bleibe<nbsp>... dass ich ich werde<nbsp>... Sie<nbsp>... erlaubt es mir.
#. fr: (-Minfilia-)En me faisant redevenir moi-même, c'est un peu comme si Minfilia m'avait offert une nouvelle vie... une vie dans laquelle je pourrai être entièrement moi-même.
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_025:1"
msgid "(-Minfilia-)But she's given me a new path─a new life─that I can call my own."
msgstr "(-Минфилия-)Но она дала мне новую дорогу, новую жизнь, которую я могу назвать своей."

#. ja: (-ミンフィリア-)……自分の中に、あたたかな力の流れを感じます。<br>ずっと私のそばにいてくれた、優しい力が……<br>前よりも、ずっとはっきりと……。
#. de: (-Minfilia-)Ich spüre eine warme Kraft durch mich fließen. Eine Wärme, die schon immer bei mir war. Ich spüre sie jetzt deutlicher als je zuvor.
#. fr: (-Minfilia-)Je... Je ressens une énergie douce et chaude qui circule en moi, comme quand un être cher se trouve près de vous... Sa présence est encore plus forte qu'avant...
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_026:1"
msgid "(-Minfilia-)And even though she's gone, I can still feel her...warm and calm and gentle."
msgstr "(-Минфилия-)Она ушла, но я всё ещё чувствую её... её тепло, спокойствие и доброту."

#. ja: (-ミンフィリア-)それに……わかるんです。<br>今まで感じ取ることのできなかった、世界の流れ……<br>光のうつろいと、それを操る方法が……。
#. de: (-Minfilia-)Es ist die Kraft des Planeten. Die Kraft des Lichts.
#. fr: (-Minfilia-)J'ai l'impression d'avoir levé le voile qui recouvrait les mystères du monde... et de pouvoir à présent contrôler la Lumière comme je veux...
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_027:1"
msgid "(-Minfilia-)I can feel the beating heart of the world, the Light that swells within it."
msgstr "(-Минфилия-)Я чувствую, как бьётся сердце мира, как в нём пульсирует Свет."

#. ja: (-ミンフィリア-)大罪喰いの存在も、感じ取れています。<br>アム・アレーンのどこにいるのかまで、しっかりと……。
#. de: (-Minfilia-)Ich kann die Licht<shy>bringer spüren. Ich weiß, wo sich der Licht<shy>bringer von Amh Araeng versteckt.
#. fr: (-Minfilia-)Je ressens aussi la présence du grand purgateur d'Amh Araeng, au point que je pourrais le situer du doigt sur une carte...
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_028:1"
msgid "(-Minfilia-)And the Lightwardens. There's one here in Amh Araeng."
msgstr "(-Минфилия-)И Стражей Света. Один из них здесь, в Ам-Аранге."

#. ja: (-ミンフィリア-)急いでサンクレッドやみなさんと合流して、討伐に…………
#. de: (-Minfilia-)Schnell. Gehen wir zurück zu Thancred und den anderen. Die Schlacht ruft.
#. fr: (-Minfilia-)Une fois que Thancred et les autres nous auront rejoint<if $gn4>es<else>s</if>, nous pourrons aller l'éliminer tous ensemble. Mais...
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_029:1"
msgid "(-Minfilia-)Let's hurry back. The others need to know."
msgstr "(-Минфилия-)Вернёмся скорее. Остальные должны знать."

#. ja: (-ミンフィリア-)……サンクレッドは、本当に、私を恨まないでしょうか。<br>「ミンフィリア」としての証もなくなってしまって……。
#. de: (-Minfilia-)Er wird mich doch nicht hassen, oder? Jetzt, da ich nicht mehr ihre Zeichen trage.
#. fr: (-Minfilia-)Thancred... Que pensera-t-il de moi, maintenant<nbsp>? Maintenant que je ne suis plus “Minfilia”...
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_030:1"
msgid "(-Minfilia-)You don't think Thancred will be angry with me, do you?"
msgstr "(-Минфилия-)Как думаете, Танкрет не будет на меня злиться?"

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que répondez-vous<nbsp>?
#. speaker: Q2
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_Q2_000_000:1"
msgid "What will you say?"
msgstr "Что скажете?"

#. ja: 大丈夫、信じろ
#. de: Hab Vertrauen. Es wird schon in Ordnung sein.
#. fr: Il t'acceptera telle que tu es.
#. speaker: A2
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_A2_000_001:1"
msgid "It's what Minfilia wanted. I'm sure he'll understand."
msgstr "Так хотела Минфилия. Уверен, он поймёт."

#. ja: 自分で確かめるしかない
#. de: Du wirst dich schon selbst vergewissern müssen.
#. fr: Pour le savoir, il faut le lui demander directement.
#. speaker: A2
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_A2_000_002:1"
msgid "There's only one way to find out."
msgstr "Есть только один способ узнать."

#. ja: (-ミンフィリア-)そう……でしょうか……。
#. de: (-Minfilia-)Das würde ich gerne glauben, aber ...
#. fr: (-Minfilia-)Vous... Vous croyez<nbsp>?
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_031:1"
msgid "(-Minfilia-)I'd like to think so too, but... \\<sigh>"
msgstr "(-Минфилия-)Хотелось бы и мне так думать, но... \\<sigh>"

#. ja: (-ミンフィリア-)そう……ですよね……。<br>自分でも、よく、わかっているんですが……。
#. de: (-Minfilia-)Ja. Das weiß ich ja selbst, aber ...
#. fr: (-Minfilia-)... Vous avez raison, c'est le seul moyen de le savoir.
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_032:1"
msgid "(-Minfilia-)\\<sigh> I know there's no getting around it, but..."
msgstr "(-Минфилия-)\\<sigh> Знаю, тут ничего не поделаешь, но..."

#. ja: (-ミンフィリア-)……<split " " 1><string $gs1></split>さん、もしよければ、<br>先にサンクレッドのところに戻っていてください。<br>私も……すぐにあとを追いかけますので……！
#. de: (-Minfilia-)<split " " 1><string $gs1></split>, würdest du bitte vorgehen? Ich komme sofort nach.
#. fr: (-Minfilia-)Dites, j'ai besoin de réfléchir... Ça ne vous dérange pas de me laisser seule quelques instants<nbsp>? Vous pouvez aller retrouver nos camarades tout de suite, si vous voulez... Je vous promets de vous rejoindre très vite<nbsp>!
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_033:1"
msgid "(-Minfilia-)Would you mind going on ahead? I'll be right behind you. I promise. "
msgstr "(-Минфилия-)Не могли бы вы пойти вперёд? Я скоро вас догоню. Обещаю. "

#. ja: 少しだけ、気持ちを落ち着ける時間をください。<br>すぐに……すぐに追いかけていきますので……！
#. de: (-Minfilia-)Ich brauche ein wenig Zeit, um meine Gedanken zu sammeln. Geh ruhig schon vor, ich komme gleich nach.
#. fr: J'ai besoin de réfléchir... Ça ne vous dérange pas de me laisser seule quelques instants<nbsp>? Vous pouvez aller retrouver nos camarades tout de suite, si vous voulez... Je vous promets de vous rejoindre très vite<nbsp>!
#. speaker: RYNE
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_RYNE_000_035:1"
msgid "(-Minfilia-)I just...need a moment to think."
msgstr "(-Минфилия-)Мне просто... нужно немного подумать."

#. ja: おお、戻ってきたのだね。
#. de: Endlich, du bist zurück. Aber<nbsp>... wo ist Minfilia?
#. fr: Vous voilà enfin<nbsp>!
#. speaker: ALPHINAUD
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_ALPHINAUD_000_040:1"
msgid "You're back! We were beginning to worry about you."
msgstr "Ну наконец-то! Мы уже начали за тебя волноваться."

#. ja: あっ、来た来た！
#. de: Da bist du ja! Wir haben uns schon Sorgen gemacht. Hoffentlich zu Unrecht?
#. fr: Comme on se retrouve<nbsp>!
#. speaker: ALISAIE
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_ALISAIE_000_045:1"
msgid "<split \" \" 1><string $gs1></split>! Thank the gods you're all right."
msgstr "<split \" \" 1><string $gs1></split>! Слава богам, ты цела!"

#. ja: お戻りになられたのですね。<br>ミンフィリアは……？
#. de: Hast du sie gesehen? Habt ihr gesprochen?
#. fr: ... Minfilia n'est pas avec vous, <split " " 1><string $gs1></split><nbsp>?
#. speaker: URIANGER
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_URIANGER_000_050:1"
msgid "Thou art returned. But where is Minfilia?"
msgstr "Ты вернулся. А где Минфилия?"

#. ja: おかえりなさい。<br>あなたからも、彼にひとこと言ってやってもらえるかしら？
#. de: Wie ist es gelaufen? Aber sprich zuerst mit Thancred.
#. fr: Ça me fait plaisir de te revoir, mais va plutôt parler à Thancred, il a besoin de réconfort.
#. speaker: YSHTOLA
msgctxt "quest/036/LucKmd115_03620:TEXT_LUCKMD115_03620_YSHTOLA_000_055:1"
msgid "Welcome back. I see you fared better than Thancred."
msgstr "С возвращением. Вижу, тебе повезло больше, чем Танкрету."
