# quest/036/LucKmd102_03607 — «Word from On High» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: オスタル厳命城のアリゼーは、沈痛な面持ちだ。
#. de: Alisaie ist in Gedanken verloren.
#. fr: Alisaie a triste mine.
#. kind: journal
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_SEQ_00:1"
msgid "Alisaie is contemplating all that must yet be done in the wake of battle."
msgstr ""

#. ja: 負傷兵を介抱
#. de: Die Verwundeten pflegen
#. fr: Soigner les soldats blessés
#. kind: objective
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_TODO_00:1"
msgid "Aid the wounded."
msgstr ""

#. ja: ライナを探す
#. de: Mit Lyna sprechen
#. fr: Retrouver Lyna
#. kind: objective
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_TODO_01:1"
msgid "Speak with Lyna."
msgstr ""

#. ja: しっかりするんだ……！
#. de: Halte durch, der Schmerz wird gleich nachlassen.
#. fr: Je vous en conjure, tenez bon<nbsp>!
#. speaker: ALPHINAUD
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_ALPHINAUD_000_000:1"
msgid "Bear it just a moment longer..."
msgstr ""

#. ja: 動いてはいけません……今、手当を……。
#. de: Haltet still, ich werde Euch heilen.
#. fr: Surtout, restez immobile. Nous allons vous soigner.
#. speaker: URIANGER
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_URIANGER_000_005:1"
msgid "Thou must needs remain still."
msgstr ""

#. ja: 息をゆっくり吐いて……そう、ゆっくり……。<br>大丈夫よ……もう大丈夫……。
#. de: Tief durchatmen ... So ist's gut.
#. fr: Respirez le plus doucement possible... Voilà, comme ça. Ne vous inquiétez pas, tout va bien se passer.
#. speaker: YSHTOLA
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_YSHTOLA_000_010:1"
msgid "Take a deep breath for me. That's it..."
msgstr ""

#. ja: ……アルフィノたちは、負傷者の手当をしてるわ。<br>私もこれから、移送を手伝ってくる。
#. de: Die anderen tun, was sie können, um den Verwundeten zu helfen. Ich würde ihnen gerne helfen, aber ich muss mich um den Transport kümmern. Sonst sterben sie uns hier doch noch weg.
#. fr: Alphinaud et les autres font tout ce qu'ils peuvent pour soigner un maximum de soldats. Quant à moi, je vais de ce pas me charger de leur rapatriement à Cristarium.
#. speaker: ALISAIE
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_ALISAIE_000_020:1"
msgid "The others are helping to treat the wounded. I'm planning to assist in moving them, but even so, we simply don't have enough hands."
msgstr ""

#. ja: それでも、被害が大きすぎて、手が足りてない……。<br><split " " 1><string $gs1></split>、もしまだ動けるなら、<br>あなたも負傷者を介抱してあげて……。
#. de: <split " " 1><string $gs1></split>, kannst du dich nicht auch um ein paar Verletzte kümmern? Ich weiß, dass du müde bist, aber jeder Einzelne zählt.
#. fr: Les blessés sont très nombreux. S'il te plaît, aide-nous à panser leurs plaies le plus rapidement possible. Plus vite nous aurons terminé, plus vite nous pourrons réfléchir à la suite de notre plan.
#. speaker: ALISAIE
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_ALISAIE_000_021:1"
msgid "I'm sure you're fit to fall over after what we've been through─gods know I am─but if you could see to a few of the patients, it would be an enormous help."
msgstr ""

#. ja: 終わったら、どこかにライナがいると思うから、<br>探して指示を仰ぐといいわ。<br>……それじゃあ、行ってくるわね。
#. de: Wenn du fertig bist, dann such bitte Kommandantin Lyna. Sie weiß am besten Bescheid, wo Not am Mann ist. Wir sprechen uns später.
#. fr: Une fois que ce sera fait, essaie de trouver Lyna. Elle pourrait avoir d'autres directives à te donner avant que nous partions. Je compte sur toi.
#. speaker: ALISAIE
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_ALISAIE_000_022:1"
msgid "Captain Lyna is about somewhere, so you might also consider asking her if there are any other outstanding areas of need. We'll talk later."
msgstr ""

#. ja: 気を強く持って……。<br>大丈夫よ、次のアマロで、クリスタリウムに運ぶわ。
#. de: Halte durch. Du gehst mit dem nächsten Amaro nach Crystarium.
#. fr: Tenez le coup, ça va aller... Les amaros seront bientôt là pour vous ramener à Cristarium.
#. speaker: ALISAIE
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_ALISAIE_000_025:1"
msgid "Just hold on. You'll be in the next carriage back to the Crystarium, I promise..."
msgstr ""

#. ja: あ……ぅ……ぁ…………。
#. de: Ich ... \<keuch> ...
#. fr: Urgh...
#. speaker: INJUREDA03607
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_INJUREDA03607_000_030:1"
msgid "I... I... \\<wheeze>"
msgstr ""

#. ja: 瀕死の負傷兵は、すがるように手を握ってきた。<br>その目に、涙が浮かんでいる……。
#. de: Tränen sammeln sich in den Augen des schwachen Mannes. Seine Finger zucken, als wollte er nach dir greifen, doch ihm fehlt die Kraft, seine Hand zu heben.
#. fr: Aux portes de la mort, le soldat se cramponne à votre bras de toutes ses forces. Des larmes coulent le long de ses joues...
#. speaker: SYSTEM
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_SYSTEM_000_031:1"
msgid "With tear-filled eyes, the prone man gazes up at you. His fingers twitch, as if to reach for you, but he lacks the strength to raise his hand."
msgstr ""

#. ja: ……ぁ……ぃ…………。
#. de: ... \<stöhn> ...
#. fr: Haa... Haa...
#. speaker: INJUREDA03607
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_INJUREDA03607_000_032:1"
msgid "..."
msgstr ""

#. ja: ぁ……ありがとう、ございます……。<br>けど、俺……罪喰いの攻撃、受けて…………。
#. de: Danke, aber ... mir kann niemand mehr helfen<nbsp>... 
#. fr: M-merci... beaucoup... Hélas, j'ai été blessé... par le mauvais purgateur...
#. speaker: INJUREDB03607
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_INJUREDB03607_000_033:1"
msgid "Th-Thank you, but...it's too late."
msgstr ""

#. ja: お願……します……。<br>もし、罪喰いに、なったら……自分を、どうか……。
#. de: Der Vertilger hat mich<nbsp>... erwischt.
#. fr: S'il vous plaît... quand je me serai... transformé à mon tour...
#. speaker: INJUREDB03607
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_INJUREDB03607_000_034:1"
msgid "One of them...it got me. \\<cough>"
msgstr ""

#. ja: 仲間を……傷、つけないよに……殺して、ください…………。
#. de: Wenn ich mich verwandle<nbsp>... dann mach mir ein schnelles Ende. Bitte, es muss sein.
#. fr: Achevez-moi... dans un coin... à l'abri des regards...
#. speaker: INJUREDB03607
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_INJUREDB03607_000_035:1"
msgid "If I turn, please... Please, kill me, I beg you."
msgstr ""

#. ja: ……ごめん……みんな…………母さん……。
#. de: Meine arme Mutter<nbsp>... Meine arme, arme Mutter<nbsp>...
#. fr: Maman... Papa... Pardonnez-moi...
#. speaker: INJUREDB03607
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_INJUREDB03607_000_036:1"
msgid "I'm so... I'm so sorry."
msgstr ""

#. ja: さ、触るな……ッ！<br>わた、わたし……私……私は…………ッ！
#. de: R-Rühr mich nicht an! Ich ... habe<nbsp>...
#. fr: N-n-n'approchez pas<nbsp>!! Ne me touchez pas<nbsp>!!
#. speaker: INJUREDC03607
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_INJUREDC03607_000_037:1"
msgid "Don't touch me! I... I..."
msgstr ""

#. ja: 私は……あぁ……あいつを……斬って……。<br>仕方なかった、罪喰いだった！<br>だけど、だけど……ッ……あぁ……アァァ……！！
#. de: Ich musste es tun. Sie war doch schon eine von ihnen<nbsp>... Oh nein, was habe ich getan! \<schluchz>
#. fr: Je... Je l'ai tué... Je lui ai planté ma lame en plein cœur<nbsp>! Mais qu'est-ce que je pouvais faire d'autre<nbsp>? Il allait se transformer...
#. speaker: INJUREDC03607
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_INJUREDC03607_000_038:1"
msgid "I killed her... I killed her! She was one of them, I know, but I... \\<sob>"
msgstr ""

#. ja: なんで……なんでこんな……なんでだよぉ……ッ！
#. de: Diese Qualen ... diese Schuld! Das hat niemand verdient<nbsp>... \<schluchz>
#. fr: ... Pourquoi<nbsp>? POURQUOIIIIII<nbsp>!???
#. speaker: INJUREDC03607
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/036/LucKmd102_03607:TEXT_LUCKMD102_03607_INJUREDC03607_000_039:1"
msgid "Maybe I deserve this... But <i>she</i>..."
msgstr ""
