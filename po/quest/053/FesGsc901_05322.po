msgctxt "quest/053/FesGsc901_05322:TEXT_FESGSC901_05322_SYSTEM_000_253:1"
msgid "You have learned the emote <ui-color 500><ui-edge-color 501>Overreact</ui-edge-color></ui-color>!"
msgstr "Вы выучили эмоцию <ui-color 500><ui-edge-color 501>«Преувеличенное удивление»</ui-edge-color></ui-color>!"
