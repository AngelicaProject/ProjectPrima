# quest/053/KinGmi106_05369 — «A Calculated Evolution» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 第二実験室前のシェールは、扉を開けようとしている。
#. de: Shale untersucht mit zittrigen Fingern das Lesegerät an der Tür.
#. fr: Shale va tenter d'ouvrir la porte de la salle d'ex<shy>pé<shy>ri<shy>men<shy>ta<shy>tion n°2.
#. kind: journal
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SEQ_00:1"
msgid "Shale is examining the card scanner."
msgstr "Шейл осматривает считыватель карт."

#. ja: <sheet EventItem 2003769 0>を探す
#. de: Einen <noun-de EventItem 5 2003769 1 4 1> finden
#. fr: Trouver la carte d'accès de niveau 3
#. kind: objective
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_TODO_00:1"
msgid "Search for a Level 3 security card."
msgstr "Найдите карту доступа 3-го уровня."

#. ja: シェールと話す
#. de: Mit Shale sprechen
#. fr: Parler à Shale
#. kind: objective
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_TODO_01:1"
msgid "Speak with Shale."
msgstr "Поговорите с Шейл."

#. ja: 所長室前の<sheet EObj 2014909 0>に<br><sheet EventItem 2003769 0>を使う
#. de: Den <noun-de EventItem 5 2003769 1 4 1> an der Tür zum Büro des Forschungsleiters verwenden
#. fr: Utiliser la carte d'accès de niveau 3 sur le lecteur donnant accès au bureau du directeur
#. kind: objective
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_TODO_02:1"
msgid "Use the Level 3 security card at the scanning device for the director's office."
msgstr "Используйте карту доступа 3-го уровня на считывателе у кабинета директора."

#. ja: シェールと話す
#. de: Mit Shale sprechen
#. fr: Parler à Shale
#. kind: objective
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_TODO_03:1"
msgid "Speak with Shale."
msgstr "Поговорите с Шейл."

#. ja: 所長室で情報を集める
#. de: Im Büro des Forschungsleiters umsehen
#. fr: Recueillir des in<shy>for<shy>ma<shy>tions dans le bureau du directeur
#. kind: objective
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_TODO_04:1"
msgid "Gather information in the director's office."
msgstr "Соберите сведения в кабинете директора."

#. ja: シェールに<sheet EventItem 2003770 0>を渡す
#. de: Shale den <noun-de EventItem 5 2003770 1 4 1> überreichen
#. fr: Remettre à Shale le bout de papier griffonné
#. kind: objective
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_TODO_05:1"
msgid "Hand the crumpled note to Shale."
msgstr "Передайте Шейл смятую записку."

#. ja: <sheet EObj 2014893 0>を調べ、<br>正しいパスワードを選ぶ
#. de: Das korrekte Passwort in das <noun-de EObj 5 2014893 1 3 1> eingeben
#. fr: Inspecter le terminal du bureau du directeur, et choisir les bons mots de passe
#. kind: objective
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_TODO_06:1"
msgid "Use the director's terminal and select the correct passwords."
msgstr "Воспользуйтесь терминалом директора и выберите правильные пароли."

#. ja: シェールと話す
#. de: Mit Shale sprechen
#. fr: Parler à Shale
#. kind: objective
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_TODO_07:1"
msgid "Speak with Shale."
msgstr "Поговорите с Шейл."

#. ja: バックルームのシェールと話す
#. de: Im Hinterzimmer mit Shale sprechen
#. fr: Reparler à Shale
#. kind: objective
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_TODO_08:1"
msgid "Speak with Shale in the Backroom."
msgstr "Поговорите с Шейл в Задней комнате."

#. ja: ふふっ、冗談ですよ。<br>……では、扉を開けてみますね。
#. de: Nur ein Späßchen, hehe. Dann wollen wir mal<nbsp>...
#. fr: Bon, quand faut y aller...
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_100_020:1"
msgid "Right, I'll get this door open."
msgstr "Ладно, сейчас открою."

#. ja: よかった……問題なく作動しました。<br>さっそく第二実験室に入ってみましょう。
#. de: Ich<nbsp>... lebe noch! Und der Mechanismus funktioniert auch. Dann wagen wir uns mal hinein.
#. fr: Pfiou... Nickel chrome. Après vous, Messieurs-dames.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_020:1"
msgid "Phew... Smooth as silk. Let's head inside and see what awaits."
msgstr "Фух... Всё прошло как по маслу. Пойдёмте внутрь, посмотрим, что там."

#. ja: え、あれって……！
#. de: Das ist doch<nbsp>...!
#. fr: Eh, mais c'est...<nbsp>!
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_021:1"
msgid "Gods above, isn't that...?"
msgstr "Боги, неужели это...?"

#. ja: 「世界を繋ぐ力」の鍵！？
#. de: Der Schlüssel?!
#. fr: ... La clef<nbsp>!?
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_022:1"
msgid "The key to interdimensional fusion!?"
msgstr "Ключ к слиянию измерений!?"

#. ja: モニターに映っているのは……「鍵」の設計図、でしょうか。
#. de: Oder besser gesagt seine Blaupause<nbsp>...
#. fr: Sur l'écran, ce sont ses plans de fabrication, je suppose.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_023:1"
msgid "That looks to be a schematic on the monitor."
msgstr "Похоже, на мониторе схема."

#. ja: 隣の装置の中には、実物があるぜ。<br>けど、<split " " 1><string $gs1></split>が持ってる奴には、<br>中に細長い石みてぇなのが入ってたよな？
#. de: Aber seht mal da, in dem Ding daneben<nbsp>...! Moment<nbsp>... Sollte da nicht eigentlich eine Art Stein in der Mitte eingelassen sein, so wie bei dem, den <split " " 1><string $gs1></split> bei sich trägt?
#. fr: Ce machin à côté ressemble beaucoup au nôtre, mais il lui manque la longue pierre au centre, non<nbsp>?
#. speaker: WUKLAMAT
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_WUKLAMAT_000_024:1"
msgid "And they've used it to make another key. But isn't it missing the shard inside like the one <split \" \" 1><string $gs1></split> has?"
msgstr "И с его помощью сделали ещё один ключ. Только в нём ведь не хватает осколка, как у <split \" \" 1><string $gs1></split>?"

#. ja: ちょ、ちょっと待って……！<br>だとすると、認識を改める必要があるかもしれないわ。
#. de: Das ist ja unglaublich. Es scheint, als müssten wir unsere bisherigen Theorien noch einmal überdenken.
#. fr: Attendez, ça voudrait dire que... Mais oui<nbsp>! Les amis, je crois que je viens de comprendre quelque chose.
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_025:1"
msgid "Ah... We may have been laboring under a misconception!"
msgstr "Ах... Похоже, мы исходили из неверного предположения!"

#. ja: 「鍵」はもともと、ミララ族の秘宝だった。<br>プリザベーションがそれを利用して、<br>「世界を繋ぐ力」を制御しようとした……。
#. de: Das, was wir als Schlüssel kennen, ist eigentlich ein Artefakt der Milalla. Und die Wahrung versuchte, die ihm innewohnende Macht der Weltenfusion unter Kontrolle zu bringen.
#. fr: À l'origine, la clef était un trésor appartenant aux Milalla, que Préservation a voulu exploiter afin de disposer du pouvoir de relier les mondes.
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_100_025:1"
msgid "The “key” was originally a Milalla relic. Once this treasure came into its possession, Preservation began working to harness the power to cross dimensions."
msgstr "Изначально «ключ» был реликвией милаллов. Получив это сокровище, Сохранение принялось осваивать его силу, позволяющую пересекать измерения."

#. ja: そして今見ているとおり、<br>彼らの研究室で、結晶以外のパーツが製造されている。<br>つまり……？
#. de: Und wie wir nun wissen, waren ihre Forscher dazu fähig, den äußeren Teil anzufertigen. Das bedeutet also, dass<nbsp>...
#. fr: Or, on constate à présent que son enveloppe externe en forme de coupe était fabriquée ici, dans leur laboratoire, mais pas son cristal central... Que doit-on en déduire<nbsp>?
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_110_025:1"
msgid "Aside from the crystal, we can see that all the vessel's components were constructed here. So what might that tell us...?"
msgstr "Кроме кристалла, все остальные части сосуда, как видно, изготовили здесь. И что же из этого следует?.."

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q1
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_Q1_000_000:1"
msgid "What will you say?"
msgstr "Что вы скажете?"

#. ja: 中の結晶こそが「鍵」だった
#. de: ... der Kristall in seinem Inneren der eigentliche Schlüssel ist.
#. fr: Le cristal est la véritable clef.
#. speaker: A1
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_A1_000_001:1"
msgid "The crystal itself is the key."
msgstr "Сам кристалл и есть ключ."

#. ja: 外側はプリザベーションの作った制御装置だ
#. de: ... nur die Außenhülle von der Wahrung entwickelt wurde, nicht aber der Kristall selbst.
#. fr: La coupe n'est qu'un dispositif de contrôle.
#. speaker: A1
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_A1_000_002:1"
msgid "This is just the device they made to control it."
msgstr "Это всего лишь устройство, которое они создали, чтобы управлять им."

#. ja: ……そうね、そう考えるのが妥当だと思う。<br>たしかに私の両親もこう言っていたわ。
#. de: Ja, ich glaube, da hast du Recht. Wenn wir daran zurückdenken, was meine Eltern uns in der Lebenden Erinnerung erzählt hatten, ergibt das alles Sinn.
#. fr: Exactement. C'est logique, et ça rejoint ce que nous ont dit mes parents à La Mémoire vivante, rappelez-vous.
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_027:1"
msgid "That would be the logical conclusion, yes. It is as my parents explained..."
msgstr "Да, это самый логичный вывод. Именно так объясняли мои родители..."

#. ja: 「鍵」については、まだ謎が多い。<br>プリザベーションはそこに改造を施したが、<br>仕組みを完全に理解した上でのことではない……。
#. de: „Der Schlüssel wirft nach wie vor viele Rätsel auf“<nbsp>- das waren ihre Worte. Die Wissenschaftler der Wahrung versuchten das Artefakt, das er darstellte, mit ihrer Technologie so zu modifizieren, dass seine Kraft kontrollierbar gemacht werden konnte. Allerdings fehlten ihnen entscheidende Informationen, um ihre Mission zu erfüllen<nbsp>...
#. fr: Selon eux, la clef est un grand mystère. Préservation l'a modifiée à sa manière, mais sans en comprendre totalement le fonc<shy>tion<shy>ne<shy>ment.
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_028:1"
msgid "The key remains shrouded in mystery. Preservation augmented it with electrope, but never grasped the technology's underlying principles."
msgstr "Ключ по-прежнему хранит множество тайн. Сохранение усовершенствовало его с помощью электропы, так и не поняв принципов его работы."

#. ja: あの「鍵」がいつ、誰によって作り出されたのか、<br>そこからもたらされる「世界を繋ぐ力」の本質とは……。<br>解明できた者は、ひとりとしていない、って。
#. de: Wer hatte den Schlüssel erschaffen? Was steckte wirklich hinter seiner Macht? Keiner von ihnen fand Antworten auf diese Fragen.
#. fr: En vérité, personne ne sait qui l'a fabriquée, ni ce qu'est exactement ce pouvoir qu'elle recèle.
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_029:1"
msgid "To this day, not a single person understands the mechanics of interdimensional fusion─not who imbued the key with its power, not when they did so, nor why."
msgstr "До сих пор никто не понимает, как работает слияние измерений: кто наделил ключ этой силой, когда и зачем."

#. ja: なるほど……。<br>プリザベーション製の制御装置がついてたから、<br>カリュクスが「鍵」の位置を特定できたわけだな。
#. de: Hm<nbsp>... Heißt das also, dass Calyx deswegen herausfinden konnte, wo der Schlüssel steckt? Weil die Wahrung den Kontrollmechanismus, der ihn umgibt, entwickelt hat?
#. fr: Je comprends mieux. Si ce truc est bien un dispositif de contrôle signé Préservation, ce n'est pas étonnant que Calyx ait pu le suivre à la trace.
#. speaker: WUKLAMAT
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_WUKLAMAT_000_030:1"
msgid "Now it makes sense. Calyx can track the key because its vessel was made by Preservation."
msgstr "Теперь понятно. Каликс может отследить ключ, потому что его сосуд изготовили в Сохранении."

#. ja: もっと深く調べたいところだけれど……<br>「鍵」についての調査は、機会を改めた方がよさそうね。<br>今度はヤ・シュトラも、ここへ連れてきましょう。
#. de: Dieses Labor zu untersuchen, dürfte uns Antworten auf einige bisher ungeklärte Mysterien geben. Und Y'shtola wird das sicherlich auch interessieren<nbsp>... Heben wir uns das für unseren nächsten Besuch auf.
#. fr: Cette pièce recèle sûrement un tas d'in<shy>for<shy>ma<shy>tions in<shy>té<shy>res<shy>santes à propos de la clef. Il faut qu'on revienne avec Y'shtola pour examiner tout ça – pas tout de suite, évidemment, mais quand on en aura l'occasion.
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_031:1"
msgid "I believe there is much we may learn in this room. On our next visit, I will have to enlist Y'shtola's assistance for a thorough investigation."
msgstr "Думаю, здесь ещё многое можно узнать. В следующий раз нужно будет позвать Я'штолу, чтобы всё как следует исследовать."

#. ja: そうだね……今はカリュクスの潜伏先を突き止めよう。<br>所長室に入るためのセキュリティパスがあるといいんだけど。
#. de: Das klingt doch viel<shy>ver<shy>sprechend. Aber zunächst hat Calyx Vorrang. Ob der gesuchte Sicherheitspass hier wohl irgendwo versteckt ist?
#. fr: Oui. Pour l'instant, notre priorité est de localiser Calyx. Et dans l'immédiat, d'obtenir une carte d'accès permettant d'entrer dans le bureau du directeur.
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_ORIGINALSPHENE_000_032:1"
msgid "I too am curious about a great many things, but pinning down Calyx's whereabouts is our priority. Hopefully there is a security card here that grants access to the director's office..."
msgstr "Мне тоже многое любопытно, но сейчас важнее всего найти Каликса. Надеюсь, здесь найдётся карта доступа в кабинет директора..."

#. ja: この部屋は秘匿性が高い研究をしていたようですから、<br>所長室に出入りできるような、上級職員もいたはずです。
#. de: Die Forschung, die hier durchgeführt wurde, war streng vertraulich. Ich bin mir sicher, dass vor allem höherrangige Mitarbeiter zugegen waren, denen der Zugang zum Büro des Forschungsleiters ebenfalls genehmigt wurde.
#. fr: Ça devrait être jouable. Des recherches hautement confidentielles ont été menées dans cette salle, par des chercheurs qui avaient, selon toute probabilité, un niveau d'accréditation élevé.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_033:1"
msgid "The research conducted in this lab appears to have been highly confidential in nature. Some of the personnel must have belonged to the organization's upper echelons, and that means higher security clearance."
msgstr "Похоже, исследования в этой лаборатории были строго засекречены. Некоторые сотрудники наверняка занимали высокое положение в организации, а значит, у них был доступ более высокого уровня."

#. ja: 必要なのはレベル3のセキュリティパス……<br>まずは手分けして探しましょう。
#. de: Unser Ziel ist ein Sicherheitspass mit Zugangsrechten der Stufe III. Teilen wir uns auf!
#. fr: Pour rappel, c'est une carte de niveau 3 qu'il nous faut. Séparons-nous et tâchons d'en trouver une.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_034:1"
msgid "We should spread out and look for any cards they left behind. Remember: anything less than a Level 3 is no good to us."
msgstr "Надо разделиться и поискать оставленные карты. Помните: нам подойдёт только карта 3-го уровня."

#. ja: 机の中を探してみるね。<br>きっとあと少し……一緒に頑張ろう！
#. de: Das Innere der Konsole kommt mir irgendwie verdächtig vor<nbsp>... Nicht mehr lange, dann haben wir es geschafft. Durchhalten, <split " " 1><string $gs1></split>!
#. fr: Je me charge de fouiller ces tiroirs un par un. Nos efforts vont finir par payer, j'en suis sûre<nbsp>!
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_ORIGINALSPHENE_000_035:1"
msgid "I'll search through these drawers. One of us is bound to find something, I'm sure of it!"
msgstr "Я поищу в ящиках. Уверена, кто-нибудь из нас что-нибудь найдёт!"

#. ja: セキュリティパス、セキュリティパス……。<br>このあたりの荷物に紛れてねぇかな。
#. de: Sicherheitspass, Sicherheitspass, keine Spur vom Sicherheitspass<nbsp>... Wo könnte der nur sein? Vielleicht irgendwo hier?
#. fr: Voyons voir... Est-ce qu'il y a une carte d'accès perdue au milieu de ce bazar...<nbsp>?
#. speaker: WUKLAMAT
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_WUKLAMAT_000_040:1"
msgid "Maybe someone left a card on a shelf somewhere..."
msgstr "Может, кто-нибудь оставил карту где-нибудь на полке..."

#. ja: ……つい、両親の痕跡が遺っていないか探しちゃうわ。<br>ないってわかっているんだけれどね。
#. de: Ich kann nicht anders, als hier und da nach möglichen Hin<shy>ter<shy>lass<shy>en<shy>schaf<shy>ten meiner Eltern Ausschau zu halten<nbsp>- obwohl ich doch weiß, dass sie ihre Spuren aus Angst vor Verfolgung restlos verwischt haben<nbsp>...
#. fr: Il y a une partie de moi qui espère inconsciemment tomber sur des traces de mes parents... Je sais pourtant bien que j'ai peu de chances d'en trouver...
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_045:1"
msgid "I keep holding out hope that I'll find some evidence of my parents here, despite knowing there is none."
msgstr "Всё надеюсь отыскать здесь хоть что-нибудь о родителях, хотя знаю, что ничего нет."

#. ja: この部屋には監視カメラが備わっているようなので、<br>往時の様子を探ってみますね。<br>職員たちの動きがわかれば、パスが見つかるかもしれません。
#. de: Das Labor ist mit Sicherheitskameras ausgestattet. Wer weiß? Vielleicht ist der Verbleib unseres Sicherheitspasses ja auf einer der Auf<shy>zeich<shy>nun<shy>gen zu sehen. Ich halte die Augen offen.
#. fr: Il y a des caméras de sur<shy>veil<shy>lan<shy>ce installées dans cette pièce. Je vais jeter un œil aux bandes enregistrées pour voir si par hasard, l'on n'y verrait pas des employés sortir leur carte d'accès...
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_055:1"
msgid "If those cameras are anything to go by, this lab was under constant surveillance. I'll scan the recordings, and try to spot where people left their security cards. Maybe we'll get lucky."
msgstr "Похоже, за лабораторией постоянно следили. Просмотрю записи камер — вдруг удастся заметить, где сотрудники оставляли карты. Может, повезёт."

#. ja: 「鍵」の制御装置……<br>たくさん作ってるってことは、試作品だったのかな？
#. de: Haben sie <i>damit</i> das Kontrollding für den Schlüssel hergestellt? Das sind so viele<nbsp>...
#. fr: Toutes ces coupes qu'ils fabriquaient... Ce sont des prototypes, tu crois<nbsp>?
#. speaker: GULOOLJA
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_GULOOLJA_000_060:1"
msgid "Why were they making so many vessels? Did the other ones not work properly?"
msgstr "Зачем они изготовили столько сосудов? Остальные что, не работали как следует?"

#. ja: セキュリティパスを見つけた！<br>表面に「Lv3」と記載されている。
#. de: Du findest etwas, das wie ein Pass aussieht! Auf ihm steht die Ziffer „III“.
#. fr: Vous trouvez une carte d'accès dans le tiroir<nbsp>! Elle porte l'inscription “Niveau 3”.
#. speaker: SYSTEM
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SYSTEM_000_070:1"
msgid "You find a security card in the cabinet drawer!"
msgstr "Вы нашли карту доступа в ящике!"

#. ja: もしかして、セキュリティパスが見つかったの？<br>よかった、残っていたのね……。
#. de: Ist das etwa unser Pass? Was für ein Glück! Dann gab es also wirklich noch einen weiteren.
#. fr: Tu as trouvé une carte d'accès<nbsp>? Comme ça, dans le tiroir<nbsp>? Eh bien, pour un coup de chance...
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_071:1"
msgid "Oh, did you just find a security card? Well, that's a stroke of luck."
msgstr "О, вы нашли карту доступа? Вот это удача!"

#. ja: 念のためシェールさんに確認してもらいましょう！
#. de: Bringen wir ihn zu Shale. Sie wird sicher wissen, was zu tun ist!
#. fr: Montre-la à Shale quand même pour être <if $gn4>sûre<else>sûr</if> de ne pas te tromper<nbsp>!
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_072:1"
msgid "Let's have Shale examine it to be sure!"
msgstr "Давайте покажем её Шейл, чтобы убедиться наверняка!"

#. ja: 資料などが入った箱が置かれている。<br>セキュリティパスはここにはなさそうだ……。
#. de: Eine Kiste voller Unterlagen<nbsp>- von der keine einen Sicherheitspass beinhaltet.
#. fr: La caisse contient divers livres et objets, mais pas de carte d'accès...
#. speaker: SYSTEM
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SYSTEM_000_074:1"
msgid "This lone storage crate is filled with document binders and other miscellaneous objects...none of which are security cards."
msgstr "В этом ящике полно папок с документами и всякой всячины... Но карт доступа нет."

#. ja: 車輪の付いた棚に、箱や筒状の物が置かれている。<br>セキュリティパスはここにはなさそうだ……。
#. de: Ein Regal auf Rädern voller Utensilien und eigenartigen Röhren<nbsp>- doch leider kein Sicherheitspass.
#. fr: Sur l'étagère se trouvent une caisse ainsi que des conteneurs cylindriques, mais aucune carte d'accès...
#. speaker: SYSTEM
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SYSTEM_000_075:1"
msgid "This sturdy-looking shelving unit holds a storage crate and sealed barrels. No sign of any security cards..."
msgstr "На этой крепкой на вид тележке стоят ящик и запечатанные бочки. Карт доступа не видно..."

#. ja: それは……たしかにレベル3のセキュリティパスのようです。<br>やりましたね、<split " " 1><string $gs1></split>さん！
#. de: Oho, da habt ihr also tatsächlich einen Sicherheitspass gefunden<nbsp>- und auch noch einen der Stufe III!
#. fr: Ah, montre voir. Hmm... Eh bien oui, c'est exactement ce qu'on cherchait<nbsp>: une carte d'accès de niveau 3. Beau boulot, <split " " 1><string $gs1></split><nbsp>!
#. speaker: SHALE
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_080:1"
msgid "Well, well, if it isn't exactly what we needed. Nice work, <split \" \" 1><string $gs1></split>."
msgstr "Ну и ну, вот именно то, что нам нужно. Отличная работа, <split \" \" 1><string $gs1></split>!"

#. ja: やったあ、これで所長室に入れるね！
#. de: Endlich! Jetzt können wir in das Büro des Forschungsleiters!
#. fr: Super, on va pouvoir entrer dans le bureau du directeur, ja<nbsp>!
#. speaker: GULOOLJA
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_GULOOLJA_000_081:1"
msgid "Oh, a Level 3! That should get us into the director's office!"
msgstr "О, карта 3-го уровня! С ней мы попадём в кабинет директора!"

#. ja: ところでシェール。<br>この施設の調査をはじめるときに、最終的な目標は、<br>所長室で「ある装置」を見つけ出すことだって言ってたよね。
#. de: Aber sag mal, Shale<nbsp>... Als wir ankamen, meintest du, im Büro gäbe es eine „Apparatur“.
#. fr: À ce propos, Shale... Quand on est arrivés, tu as dit que notre but était de trouver un certain terminal situé dans le bureau du directeur.
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_ORIGINALSPHENE_000_082:1"
msgid "So, what was it you were hoping to find in there again, Shale?"
msgstr "Кстати, Шейл. Когда мы только начали исследовать это место, ты говорила, что в кабинете директора нужно найти какое-то устройство."

#. ja: その装置について、そろそろ聞いてもいい……？
#. de: Kannst du uns vielleicht ein wenig mehr verraten? Was ist es genau, das wir dort suchen?
#. fr: Maintenant qu'on y est presque, tu pourrais nous en dire plus<nbsp>?
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_ORIGINALSPHENE_100_082:1"
msgid "You were saying that a “certain device” was going to help us..."
msgstr "Ты обещала рассказать об этом устройстве..."

#. ja: そうでしたね。<br>僕が探しているもの……それは、情報中継装置なんですよ。
#. de: Entschuldigung. Das ist eine berechtigte Frage, die ich eigentlich schon längst hätte beantworten sollen. Was wir suchen, ist eine Art Transponder, der damals wie heute Information weiterleitet.
#. fr: Bien sûr. En fait, ce n'est pas n'importe quel terminal qu'on cherche, mais un terminal-relais.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_083:1"
msgid "Right, I haven't properly explained myself, have I? I'm looking for a data relay."
msgstr "Точно, я ведь толком ничего не объяснила. Я ищу ретранслятор данных."

#. ja: この施設の存在を知ったあと、僕はまず基礎調査をしました。<br>すると、放棄されてるはずなのに、<br>外部のネットワークへの接続が確認できたんです。
#. de: Als ich diese Einrichtung entdeckte, führte ich si<shy>cher<shy>heits<shy>hal<shy>ber ein paar Recherchen durch und fand etwas äußerst Interessantes heraus: Obwohl sie auf dem Papier schon längst aufgegeben ist, ist die Lagerhülle nach wie vor mit einem externen Netzwerk verbunden.
#. fr: Je m'explique. Après qu'on a découvert ce laboratoire, j'ai mené ma petite enquête<nbsp>: j'ai alors détecté une tentative de connexion provenant d'ici, alors même que l'endroit était censé être abandonné.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_100_083:1"
msgid "After we discovered this ostensibly “abandoned” complex, I performed a cursory investigation which detected a connection to an outside network."
msgstr "Когда мы нашли этот якобы «заброшенный» комплекс, я провела предварительное расследование и обнаружила, что он подключён к внешней сети."

#. ja: ではどこへアクセスしていたかというと……<br>エバーキープ内の監視カメラでした。
#. de: Ein paar Klicks später und ich wusste auch, warum: Sämtliche Sicherheitskameras des Immerfrieds waren von der Lagerhülle aus angezapft worden.
#. fr: Une tentative de connexion vers où, me direz-vous... Eh bien, vers le réseau de caméras de sur<shy>veil<shy>lan<shy>ce de la Gardienne de l'Éternité.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_110_083:1"
msgid "When I traced the data's routing, I confirmed traffic from a web of Everkeep's security cameras."
msgstr "Проследив маршрут передачи данных, я выяснила, что сюда поступают данные с сети камер наблюдения Вечной крепости."

#. ja: これまでのカリュクスの動きを踏まえても、<br>彼が監視カメラを密かに掌握し、<br>監視体制を構築しているのは間違いない。
#. de: So treffsicher und gewieft, wie Calyx auf jeden unserer Schritte reagiert, muss er die volle Kontrolle über die Über<shy>wachungs<shy>systeme im Immerfried haben.
#. fr: Vu les coups d'avance qu'il a sur nous, il ne fait aucun doute que Calyx en a secrètement pris le contrôle, et qu'il dispose ainsi d'un réseau d'espionnage permanent.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_084:1"
msgid "Considering the way Calyx is always one step ahead of us, we must assume he's quietly seized control of the city's surveillance system and has been using it to monitor our activities."
msgstr "Каликс всегда на шаг впереди. Похоже, он тайком захватил систему наблюдения города и следит за каждым нашим шагом."

#. ja: 「鍵」を持つあなたの動向を探るために……。
#. de: All das dient ganz sicher einer Sache: <i>Dich</i> stets im Auge zu behalten. Du bist <if $gn4>die Beschützerin<else>der Beschützer</if> des Schlüssels und auf dich hat er es abgesehen.
#. fr: Son but étant d'épier les faits et gestes de chacun d'entre nous – et en particulier les tiens, comme tu possèdes la clef.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_085:1"
msgid "To monitor what you, as the key holder, are planning."
msgstr "Он следит за тобой, чтобы знать, что задумал тот, у кого ключ."

#. ja: けれどそれは逆に、彼を辿る経路でもあります。<br>監視映像は必ず、カリュクスのもとに送信されてるんですから。
#. de: Aber das bedeutet auch, dass die ganzen Daten und Auf<shy>zeich<shy>nun<shy>gen irgendwo gesammelt und an ihn weitergeschickt werden müssen. Und das ist unsere Gelegenheit, ihn ausfindig zu machen.
#. fr: Or, c'est ce même dispositif qui pourrait bien le trahir. Car en effet, les images de vidéosur<shy>veil<shy>lan<shy>ce lui sont forcément retransmises à un moment ou un autre.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_086:1"
msgid "But since Calyx is the ultimate recipient of those transmissions, the flow of data is like a river that we can follow back to him."
msgstr "Но Каликсу в итоге поступают все эти данные. Значит, по их потоку мы можем выйти на него."

#. ja: 僕が押さえたいのは、まさしくそれです。<br>監視映像を集め、カリュクスに送信している装置を探し出し、<br>送り先がどこなのかを解析できれば……
#. de: Der gesamte Datenverkehr läuft in dieser Einrichtung zusammen, soviel konnte ich herausfinden. Sollte es uns also gelingen, besagten Transponder zu finden und zu analysieren<nbsp>...
#. fr: C'est là que j'ai une carte à jouer. Si je parviens à accéder au terminal-relais, et à voir exactement où les données sont envoyées...
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_087:1"
msgid "Which is why I need the data relay. If I can analyze the device, and see where it's rerouting all this surveillance traffic..."
msgstr "Поэтому мне и нужен ретранслятор данных. Если я изучу устройство и выясню, куда оно перенаправляет записи с камер..."

#. ja: ……カリュクスの潜伏先を特定できる。
#. de: Finden wir Calyx.
#. fr: ... Alors tu sauras où Calyx se cache.
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_ORIGINALSPHENE_000_088:1"
msgid "...Then you can pinpoint Calyx's position."
msgstr "...То сможешь выяснить, где скрывается Каликс."

#. ja: とはいえ、まだ大ハズレの可能性もありますけどね。<br>カリュクスが妨害してこないのが、少々気がかりです。
#. de: Oder ich liege komplett falsch<nbsp>- das wissen wir leider erst, wenn es so weit ist. Die Tatsache, dass Calyx bisher noch nichts gegen unser Eindringen hier unternommen hat, beunruhigt mich auch zunehmend.
#. fr: Cela dit, il se peut aussi que je fasse com<shy>plè<shy>te<shy>ment fausse route. Je trouve notamment étrange que notre ennemi ne nous ait pas encore mis de bâtons dans les roues.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_089:1"
msgid "That said, he has done nothing to impede our progress. Which makes me think I might be on entirely the wrong track."
msgstr "Впрочем, он пока никак нам не мешает. Может, я вообще иду по ложному следу."

#. ja: 妨害ねぇ……。<br>する気がねぇんだか、できねぇんだか……。
#. de: Entweder will er nichts unternehmen, oder<nbsp>... er kann nicht.
#. fr: J'avoue... Soit il a la flemme de nous embêter, soit il n'en a pas les moyens...
#. speaker: WUKLAMAT
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_WUKLAMAT_000_090:1"
msgid "Maybe the reason he isn't stopping us...is because he can't."
msgstr "Может, он нас не останавливает... потому что не может."

#. ja: あいつ、アンダーキープのときは、<br><split " " 1><string $gs1></split>の強さを測ってるって言ってたけどさ。<br>どうやってそれを超える強さを得るつもりなんだろうな？
#. de: Im Unterfried faselte er etwas davon, eine Messung deiner Stärke durchzuführen, <split " " 1><string $gs1></split>. Aber was bringt ihm das? Glaubt er ernsthaft, er könne sie mit irgendetwas überbieten?
#. fr: Dans la Gardienne de l'Immémorial, il disait vouloir mesurer à quel point <split " " 1><string $gs1></split> était balèze. D'accord, mais qu'est-ce qu'il compte faire de cette donnée<nbsp>? Où va-t-il trouver encore plus <if $gn4>forte qu'elle<else>fort que lui</if><nbsp>?
#. speaker: WUKLAMAT
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_WUKLAMAT_100_090:1"
msgid "Back in the old castle, Calyx said he was measuring <split \" \" 1><string $gs1></split>'s strength. What can he possibly dream up that's stronger than <if $gn4>her<else>him</if>?"
msgstr "В старом замке Каликс говорил, что измеряет силу <split \" \" 1><string $gs1></split>. Что он может придумать сильнее <if $gn4>неё<else>него</if>?"

#. ja: ああ、監視カメラといえば、もうひとつ報告が。<br>この部屋にもカメラが設置されてるんですが、<br>施設が放棄されるよりも前に、停止させられてたようなんです。
#. de: Wo wir gerade bei Sicherheitskameras waren<nbsp>... Hier im Labor ist übrigens auch eine angebracht. Aber sie scheint von irgendwem willentlich abgeschaltet worden zu sein.
#. fr: Au fait, pour en revenir au sujet des caméras, vous aurez remarqué qu'il y en a une au-dessus de nos têtes. Cependant, j'ai découvert que quelqu'un l'avait vo<shy>lon<shy>tai<shy>re<shy>ment désactivée, un peu avant l'abandon du laboratoire...
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_091:1"
msgid "Oh, speaking of cameras, there was another thing I meant to mention. I found evidence that someone deliberately disabled the surveillance feed in this room."
msgstr "Кстати о камерах: ещё хотела сказать. Похоже, кто-то намеренно отключил наблюдение в этой комнате."

#. ja: 最新の映像も不自然に削除されてましたし……。<br>一応復元はしたんですけど、見てみますか？
#. de: Und das ist noch nicht alles: Die neueste Aufnahme wurde ebenfalls gelöscht. Nicht, dass mich das davon abgehalten hätte, sie wie<shy>der<shy>her<shy>zu<shy>stel<shy>len. Sollen wir einen Blick drauf werfen?
#. fr: Et aussi que le dernier enregistrement vidéo en date avait été effacé de façon flagrante. J'ai pris la peine de le restaurer par curiosité, vous voulez qu'on le regarde<nbsp>?
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_092:1"
msgid "The most recent recording was also crudely deleted. I was able to restore the data, though, if you'd like to see it...?"
msgstr "Последнюю запись тоже грубо стёрли. Но мне удалось восстановить её, если хотите посмотреть..."

#. ja: わかりました。<br>では、最も新しく記録された監視映像を流します。
#. de: In Ordnung. Dann spiele ich sie ab.
#. fr: C'est parti alors. Je vous préviens, je ne réponds pas de ce qu'on va découvrir à l'image.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_093:1"
msgid "I'll start the show, then."
msgstr "Тогда запускаю запись."

#. ja: そんな……離反者は殺されていたなんて……。
#. de: Nein<nbsp>... Sie haben Mitglieder, die sich abgewandt haben, einfach<nbsp>... umgebracht?!
#. fr: Ils exécutaient tous ceux qui n'étaient pas d'accord avec leurs idées<nbsp>? C'est horrible...
#. speaker: ORIGINALSPHENE
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_ORIGINALSPHENE_000_094:1"
msgid "She only wanted to leave and he <i>executed</i> her..."
msgstr "Она всего лишь хотела уйти, а он её <i>казнил</i>..."

#. ja: ……研究員データと照合してみましたが、<br>女性を殺した男が、所長のデメトリオスのようです。<br>ずいぶんとカリュクスに心酔していたようですね。
#. de: Der Mitarbeiterkartei zufolge war der Mann in der Aufzeichnung unser guter Forschungsleiter, Demetrius. Er war wohl ein fanatischer Anhänger von Calyx' Ideologien.
#. fr: Si j'en crois le registre des chercheurs, l'homme qui commet le meurtre sur la vidéo n'est autre que le directeur Demetrius lui-même. Un véritable fanatique de Calyx, à n'en pas douter.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_095:1"
msgid "I checked the images against the personnel data, and the man who pulled the trigger was Director Demetrius himself. Everything I could find on him pointed to a deep infatuation with “Master Calyx.”"
msgstr "Я сверила запись с данными сотрудников. В мужчине, который выстрелил, я узнала самого директора Деметриоса. Судя по всему, он был без ума от «мастера Каликса»."

#. ja: この記録以降、監視カメラは作動してません。<br>映像が削除されていたことを考えると、<br>ほかの研究員には、殺害したことを隠していたのでしょう……。
#. de: Wie gesagt wurde die Kamera nach dieser Aufzeichnung abgeschaltet und das Material gelöscht. Das Vorgefallene sollte wohl vor dem Rest der Wahrung geheim gehalten werden<nbsp>...
#. fr: La caméra a cessé de fonctionner après ça, et l'enregistrement a été effacé dans la foulée – sûrement pour dissimuler ce crime odieux aux autres chercheurs...
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_096:1"
msgid "The cameras in this room have been out of operation ever since that incident. Given that the recording was erased, I can only assume he was trying to conceal his grisly deed from the other researchers..."
msgstr "После этого камеры в комнате перестали работать. Раз запись стёрли, полагаю, он хотел скрыть своё жестокое преступление от остальных сотрудников..."

#. ja: 私の両親も、たしかに言っていたわ。<br>プリザベーションを決死の思いで離脱したって……。
#. de: Meine Eltern sprachen von ganz ähnlichen Erfahrungen. Dass sie um ihre Leben fürchten mussten, als sie die Wahrung verließen.
#. fr: Je me souviens, mes parents nous ont raconté que Préservation les avait pourchassés après leur désertion.
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_097:1"
msgid "I am not surprised, given how my parents described their defection from the institute."
msgstr "Неудивительно, если вспомнить, что рассказывали родители о своём бегстве из Сохранения."

#. ja: 追っ手の迫る中で、幼い私を異世界に託したんだって……。
#. de: Sie wurden als Abtrünnige verfolgt und vollbrachten es mit viel Mühe gerade noch so, mich in den Ursprung zu bringen<nbsp>...
#. fr: Voyant l'étau se refermer sur eux, ils ont pris la décision de me mettre à l'abri dans un autre monde.
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_099:1"
msgid "They spoke of rushing me through a portal, even as Preservation's agents closed in on them."
msgstr "Они говорили, что протолкнули меня через портал, пока люди Сохранения настигали их."

#. ja: ふたりがその後どうなったのかは、聞けなかった。<br>でも、もし追っ手に捕まっていたとしたら……。
#. de: Was danach mit ihnen geschehen ist, weiß ich nicht. Aber falls sie gefasst wurden, dann<nbsp>...
#. fr: Je ne leur ai pas demandé ce qu'il s'était passé ensuite. Mais s'ils sont tombés aux mains de leurs poursuivants, alors...
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_100:1"
msgid "I dared not ask what became of them after that. But if it turns out they were captured by their pursuers..."
msgstr "Я не решилась спросить, что с ними стало потом. Но если их всё-таки поймали..."

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q2
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_Q2_000_000:1"
msgid "What will you say?"
msgstr "Что вы скажете?"

#. ja: ……きっと逃げ切れたよ
#. de: Sie sind entkommen. Ganz sicher!
#. fr: Je suis <if $gn4>sûre<else>sûr</if> qu'ils ont réussi à s'échapper.
#. speaker: A2
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_A2_000_001:1"
msgid "I'm sure they managed to escape."
msgstr "Уверен<if $gn4>а<else></if>, им удалось сбежать."

#. ja: 後悔していなかったと思う
#. de: Sie haben ihre Entscheidung nicht bereut.
#. fr: Ils ne regrettaient rien dans tous les cas.
#. speaker: A2
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_A2_000_002:1"
msgid "They did not regret their actions."
msgstr "Они не жалели о своём поступке."

#. ja: ありがとう……。<br>そうでなかったとしても、永久人として過ごした最後の時間が、<br>穏やかなものであったことを願うわ。
#. de: Danke. Und wenn nicht<nbsp>... dann hoffe ich, dass ihre Zeit als Endlose dafür umso schöner war.
#. fr: Je l'espère... et si ce n'est pas le cas, alors je prie pour qu'ils aient trouvé la paix durant leurs derniers instants en tant qu'Éternels.
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_102:1"
msgid "I want to believe they did. And even if they didn't, I hope they at least enjoyed what time they had as Endless."
msgstr "Хочу верить, что так и было. А если нет, надеюсь, они хотя бы успели пожить спокойно в последние годы в качестве вечноживущих."

#. ja: ……そっか。<br>過去を視たあなたがそう言ってくれるなら、<br>ふたりはやり遂げたんだって、私も信じるわ。
#. de: Wenn<nbsp>... Wenn du das sagst, dann glaube ich dir. Vielen Dank, <split " " 1><string $gs1></split>.
#. fr: Tu as vu leur passé, n'est-ce pas<nbsp>? Si tu me dis qu'ils étaient en paix avec eux-mêmes, alors je veux bien te croire.
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_103:1"
msgid "Right, the Echo... Knowing you saw them as they were, your words give me great comfort."
msgstr "Точно, Эхо... Ты видела их такими, какими они были. От твоих слов мне легче."

#. ja: クルル……。
#. de: Krile<nbsp>...
#. fr: Krile...
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_ORIGINALSPHENE_000_105:1"
msgid "Oh Krile..."
msgstr "Ох, Крилэ..."

#. ja: 大丈夫よ。<br>両親の想いは、あの日リビング・メモリーで受け取ったもの。
#. de: Es ist alles gut. Dank der Lebenden Erinnerung konnte ich meine Eltern wiedersehen und etwas über ihre Hoffnungen und Wünsche erfahren.
#. fr: Allons, ça va aller. En fin de compte, je suis heureuse d'avoir pu rencontrer mes parents à La Mémoire vivante, et d'avoir entendu leurs confidences.
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_106:1"
msgid "Worry not, Sphene. Thanks to the haven of Living Memory, I was at least able to meet my parents and learn what they stood for."
msgstr "Не волнуйся, Сфен. Благодаря Живой памяти я хотя бы смогла встретиться с родителями и узнать, во что они верили."

#. ja: ……だから私は、前に進めるのよ。
#. de: Darum kann ich nun nach vorne blicken und erhobenen Hauptes voranschreiten!
#. fr: Maintenant, je peux enfin aller de l'avant sereinement.
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_107:1"
msgid "It is...enough for me to carry on."
msgstr "Этого... мне хватит, чтобы жить дальше."

#. ja: ……今となっては、当時のご両親とプリザベーションの間で、<br>どんな攻防があったのかはわかりません。
#. de: Wir wissen nach wie vor nichts Genaueres über den Konflikt deiner Eltern mit der Wahrung.
#. fr: ... Ce qu'il s'est passé con<shy>crè<shy>te<shy>ment entre Préservation et tes parents reste un mystère, même aujourd'hui.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_108:1"
msgid "Even now, we don't know how the conflict unfolded between your parents and Preservation."
msgstr "Даже сейчас мы не знаем, как развивался конфликт между твоими родителями и Сохранением."

#. ja: ですが、優秀なご両親のことですから、<br>原初世界に追っ手が向かわないように……
#. de: Nur, dass sie herausragend und brillant genug waren, ihre Verfolger in die Irre und nicht in den Ursprung zu führen.
#. fr: Intelligents comme ils l'étaient, ils ont dû prendre soin d'effacer leurs traces, ainsi que tout indice qui aurait permis à l'or<shy>ga<shy>ni<shy>sa<shy>tion de venir te pourchasser dans le monde primitif.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_109:1"
msgid "But what we do know is that your mother and father cleverly expunged every last trace of their movements."
msgstr "Но мы знаем, что твои родители были умны и предусмотрительны. Они тщательно скрыли все свои следы."

#. ja: なにより、あなたに危害が及ばないように、<br>手がかりも自分たちの痕跡も、きれいに抹消したのでしょうね。
#. de: Gerade weil sie sichergehen wollten, dass dir nichts zustößt, verwischten sie jegliche Spuren.
#. fr: Jusqu'au bout, ils auront tout fait pour te mettre hors de danger.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_110:1"
msgid "They made sure no one could cross into the Source or threaten their child's safety."
msgstr "Они сделали всё, чтобы никто не смог проникнуть в Исток и угрожать их ребёнку."

#. ja: ……さあ、先へ進みましょう。<br>「鍵」へ託された想いを繋ぐために。
#. de: Also, was hält uns noch auf? Ehren wir ihr Erbe und beschützen wir den Schlüssel bis zuletzt!
#. fr: ... Sur ce, remettons-nous au travail. On a un combat à poursuivre en tant qu'héritiers de la clef.
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_111:1"
msgid "...Right, let's press on, shall we? This tale behind the key deserves a fitting conclusion."
msgstr "...Ну что, пойдём дальше? История ключа заслуживает достойного завершения."

#. ja: いよいよ所長室だね！<br>レベル3のセキュリティパスが使えるか試してみよう！
#. de: Dann auf zum Büro des Forschungsleiters. Mit dem neuen Sicherheitspass kommen wir ganz sicher hinein!
#. fr: En route pour le bureau du directeur, ja<nbsp>! Et attention à ne pas égarer la carte d'accès<nbsp>!
#. speaker: GULOOLJA
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_GULOOLJA_000_112:1"
msgid "To the director's office!"
msgstr "В кабинет директора!"

#. ja: 読み取り機がある。<br>「<sheet EventItem 2003769 0>」が使えそうだ。
#. de: Das Lesegerät sieht viel<shy>ver<shy>sprechend aus. Probiere, den Sicherheitspass der Stufe III davor zu halten.
#. fr: Un lecteur de carte d'accès. Posez la vôtre dessus pour tenter d'ouvrir la porte.
#. speaker: SYSTEM
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SYSTEM_000_140:1"
msgid "A scanning device. It waits silently for a security card with the appropriate level of clearance..."
msgstr "Считыватель молча ждёт карту с нужным уровнем доступа..."

#. ja: 「<sheet EventItem 2003769 0>」を読み取り機にかざした。
#. de: Das Lesegerät scheint den Pass zu erkennen.
#. fr: Vous posez votre carte d'accès de niveau 3 sur le lecteur.
#. speaker: SYSTEM
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SYSTEM_000_141:1"
msgid "You hold the Level 3 security card up to the scanner."
msgstr "Вы подносите карту доступа 3-го уровня к считывателю."

#. ja: よっしゃあ、開いた！<br>さっそく入ろうぜ！
#. de: Geschafft! Hinein mit uns.
#. fr: Trop facile<nbsp>! Allez, on entre<nbsp>!
#. speaker: WUKLAMAT
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_WUKLAMAT_000_142:1"
msgid "There we go! Let's head inside!"
msgstr "Вот и славно! Пойдём внутрь!"

#. ja: よかった……僕は中継装置を探してみます。<br>みなさんも室内に何か怪しいものがあれば教えてください。
#. de: Sehr gut! Ich kümmere mich sofort um den Transponder. Seht ihr euch derweil bitte um. Bestimmt gibt es das ein oder andere zu entdecken.
#. fr: Je vais chercher ce fameux terminal-relais. Prévenez-moi si vous repérez quoi que ce soit d'anormal dans la pièce.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_143:1"
msgid "Now to find that data relay... And don't be shy, everyone─speak up if anything odd catches your eye."
msgstr "Пора искать ретранслятор данных... И не стесняйтесь, говорите, если заметите что-нибудь подозрительное."

#. ja: もしかするとセキュリティパスが必要になるかもしれませんので、<br><split " " 1><string $gs1></split>さんは、ひとまず僕と一緒に。<br>さあ行きましょう。
#. de: <split " " 1><string $gs1></split>, komm du bitte mit mir. Dein Sicherheitspass könnte bei meiner Arbeit vonnöten sein.
#. fr: <split " " 1><string $gs1></split>, je vais peut-être avoir besoin de la carte d'accès, alors reste à côté de moi.
#. speaker: SHALE
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_144:1"
msgid "<split \" \" 1><string $gs1></split>, come with me. I might have need of that security card."
msgstr "<split \" \" 1><string $gs1></split>, пойдём со мной. Возможно, мне понадобится карта доступа."

#. ja: この書類は……報告書みたい……。<br>人をエーテルに還すと、ひとりあたり、<br>どれくらいのエネルギーになるのかって……。
#. de: Das scheint ein Forschungsbericht zu sein. „Zu erwartender Energiegewinn pro eingespeistem Subjekt“<nbsp>...
#. fr: C'est un rapport scien<shy>ti<shy>fi<shy>que, je crois... La “quantité d'énergie obtenue pour chaque personne retournant à l'éther” y est mentionnée...
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_ORIGINALSPHENE_000_145:1"
msgid "This is a report on reducing people to aether, and how much energy can be harnessed per individual..."
msgstr "Это отчёт о превращении людей в эфир и о том, сколько энергии можно получить от каждого..."

#. ja: あっと……ごめんなさい、「鍵」について考え込んでいたわ。<br>今はシェールさんの報告を待ちましょうか。
#. de: Hm? Oh<nbsp>... Entschuldige, ich war gerade völlig in Gedanken vertieft. Der Schlüssel wirft so viele Fragen auf und<nbsp>... Wie auch immer. Warten wir, bis Shale uns Bescheid gibt.
#. fr: ... Ah, pardon. J'étais encore en train de penser à la clef. Je n'ai rien remarqué de mon côté, mais attendons voir ce que Shale va découvrir.
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_150:1"
msgid "Hm? Oh, my apologies! I was thinking about the key..."
msgstr "А? Ой, прости, задумалась о ключе..."

#. ja: こっちの棚の上には、香と花瓶と……<br>あとは宝石を並べるプレートか？<br>デメトリオスって奴、ちゃんと部屋を飾るタイプなんだな。
#. de: Duftstäbchen, Vasen und eine Platte voller Edelsteine? Dieser Demetrius scheint sich doch ordentlich Mühe bei der Einrichtung seines Büros gegeben zu haben.
#. fr: Sur ce meuble, il y a de l'encens, des vases, un drôle de cadre incrusté de pierres précieuses... À croire que l'ami Demetrius était amateur de déco.
#. speaker: WUKLAMAT
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_WUKLAMAT_000_155:1"
msgid "Huh, this “Director Demetrius” was very particular about how he decorated his office. We've got incense and vases and...some kind of gem display?"
msgstr "Хм, директор Деметриос явно любил украшать кабинет. Тут и благовония, и вазы, и... что-то вроде подставки для драгоценных камней?"

#. ja: 怪しいもの……何かあるかなぁ？
#. de: Was Verdächtiges, was Verdächtiges<nbsp>... Wo steckt ihr nur?
#. fr: Quelque chose d'anormal... Peut-être ici, ja<nbsp>?
#. speaker: GULOOLJA
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_GULOOLJA_000_160:1"
msgid "Something odd, something odd..."
msgstr "Что-нибудь подозрительное... Что бы тут найти?"

#. ja: …………違う、外部と通信してない。<br>これは目当ての中継装置じゃありません。
#. de: Nein, das ist er nicht. Keine Verbindung nach draußen<nbsp>...
#. fr: Ah, flûte... Ce terminal ne communique pas avec l'extérieur. Ce n'est pas celui que je cherche.
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_170:1"
msgid "Damn. This terminal isn't connected to any outside networks, so it can't be the data relay I'm looking for."
msgstr "Проклятье. Этот терминал не подключён к внешним сетям, значит, это не тот ретранслятор, который я ищу."

#. ja: それに、事前に得ていたマップデータと比べて、<br>所長室がずいぶん小さいんですよ。
#. de: Und überhaupt<nbsp>- das Büro ist viel kleiner, als ich angenommen hatte. Die Daten, die ich im System gefunden haben, versprachen etwas ganz anderes.
#. fr: C'est bizarre... D'autant plus que ce bureau est bien plus petit que sur nos données cartographiques...
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_171:1"
msgid "This office is also smaller than the map suggested."
msgstr "Да и кабинет куда меньше, чем на карте."

#. ja: 場所を間違えた……？<br>あるいは、何か見落としてるんでしょうか……。
#. de: Habe ich mich vertan, oder etwas übersehen<nbsp>...?
#. fr: Ce n'est peut-être pas la bonne pièce<nbsp>? Ou alors, quelque chose m'échappe...
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_172:1"
msgid "I'm positive we're in the right room. What am I missing...?"
msgstr "Я уверена, что мы в нужной комнате. Что же я упускаю?.."

#. ja: すみません……ほかのみなさんと一緒に、<br>手がかりになりそうなものを探してみていただけませんか？
#. de: Tut mir wirklich leid, aber kannst du dich mit den anderen ein wenig genauer umsehen? Hier muss es irgendetwas geben, das uns auf die richtige Fährte bringt.
#. fr: Désolée, il faut que je réfléchisse. Tu veux bien aider les autres à trouver des indices en attendant?
#. speaker: SHALE
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_173:1"
msgid "Sorry, <split \" \" 1><string $gs1></split>, could I ask you and the others to search the office for any clues to this infuriating puzzle?"
msgstr "Прости, <split \" \" 1><string $gs1></split>. Не могли бы вы с остальными поискать в кабинете подсказки к этой загадке?"

#. ja: すみませんが、何か手がかりが見つかったら教えてください。<br>僕も見落としがないか調べてみます……。
#. de: Bitte sag Bescheid, wenn du einen Hinweis findest! Ich werde derweil ebenfalls Unter<shy>such<shy>ungen anstellen.
#. fr: Fais-moi signe si tu remarques un détail louche. De mon côté, je vais voir si je ne me suis pas trompée quelque part...
#. speaker: SHALE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SHALE_000_175:1"
msgid "Let me know if you find anything. I'll double- and triple-check my work for mistakes..."
msgstr "Если что-нибудь найдёте, скажите. А я ещё раз всё перепроверю..."

#. ja: 想定していたよりも部屋が小さい、か……。<br>どういうことなんだろう……？
#. de: Das Büro ist also viel kleiner als Shale angenommen hatte, hm? Was hat das wohl zu bedeuten<nbsp>...?
#. fr: La pièce est plus petite que prévu<nbsp>? Hmm, ce n'est peut-être pas anodin...
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_ORIGINALSPHENE_000_176:1"
msgid "Shale says this room is too small? How could that be...?"
msgstr "Шейл говорит, что комната слишком маленькая? Как такое возможно?.."

#. ja: ここの壁……。<br>一瞬、ちらついて見えた気がしたけど、気のせいかしら……。
#. de: Diese Wand<nbsp>... Hat die gerade kurz geflackert? Irgendetwas stimmt da doch nicht.
#. fr: Ce mur... Ça doit être mon imagination qui me joue des tours, mais j'ai l'impression de l'avoir vu disparaître une fraction de seconde...
#. speaker: KRILE
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_KRILE_000_177:1"
msgid "Something is strange about this wall─I could've sworn it flickered for a moment there. Seems solid enough now..."
msgstr "Что-то с этой стеной не так. Мне ведь показалось, что она на миг замерцала... Сейчас вроде обычная."

#. ja: あれ……？<br>このプレート、もしかして……。
#. de: Hm? Diese Platte<nbsp>...
#. fr: Ce cadre... Je me demande si...
#. speaker: WUKLAMAT
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_WUKLAMAT_000_178:1"
msgid "Hmmm. Does this display do anything else...?"
msgstr "Хм-м. А эта подставка ещё что-нибудь умеет?"

#. ja: 机の下の箱には、難しそうな本がたくさん入ってたよ。<br>僕だったら、本の下にこっそり宝物を隠しておくけどな。
#. de: In der Kiste unter dem Tisch sind total viele Bücher versteckt. Und die haben noch nicht mal Bilder<nbsp>... Wenn das mein Büro wäre, hätte ich da meine ganzen Schätze reingepackt!
#. fr: Ces tiroirs sont bourrés de gros livres compliqués. Si c'était moi, je cacherais mes trésors secrets en dessous, ja...
#. speaker: GULOOLJA
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_GULOOLJA_000_179:1"
msgid "These drawers have only big, heavy books in them. I would have filled them with snacks."
msgstr "В ящиках только толстенные книги. А я бы набил их закусками."

#. ja: ……あっ、もしかして本当に何か隠されてたりするかな？<br>よーし、怪しいものがないか、よく調べておくね！
#. de: Warte<nbsp>... Vielleicht ist das, was wir suchen! Ich guck noch mal nach!
#. fr: ... Hé, mais peut-être que le directeur a eu la même idée<nbsp>! Je vais regarder, on sait jamais<nbsp>!
#. speaker: GULOOLJA
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_GULOOLJA_100_179:1"
msgid "...Oh, but maybe the books are hiding something! I'll check!"
msgstr "...Ой, а вдруг в книгах что-нибудь спрятано? Сейчас проверю!"

#. ja: ファイルの隙間に紙片が挟まっている。
#. de: Inmitten der Dokumente steckt eine Notiz.
#. fr: Vous trouvez un bout de papier coincé entre deux classeurs.
#. speaker: SYSTEM
msgctxt "quest/053/KinGmi106_05369:TEXT_KINGMI106_05369_SYSTEM_000_180:1"
msgid "You find a crumpled note wedged between the file binders."
msgstr "Вы находите смятую записку, зажатую между папками."

#. ja: (-走り書きの紙片-)機密室への昇降機使用手順。<br><ui-color 582><ui-edge-color 581>第一実験室</ui-edge-color></ui-color>、<ui-color 582><ui-edge-color 581>第二実験室</ui-edge-color></ui-color>、<ui-color 582><ui-edge-color 581>所長室</ui-edge-color></ui-color>のそれぞれの端末に、<br>パスワードを同時入力。
#. de: (-Notizschnipsel-)<i>Für die Aktivierung des Fahrstuhls müssen die korrekten Passwörter gleichzeitig in die jeweiligen Terminals in <ui-color 582><ui-edge-color 581>Versuchslabor I</ui-edge-color></ui-color>, <ui-color 582><ui-edge-color 581>II</ui-edge-color></ui-color> und <ui-color 582><ui-edge-color 581>Demetrius' Büro</ui-edge-color></ui-color> eingegeben werden.</i>
#. fr: (-Bout de papier griffonné-)Pour accéder à l'ascenseur vers la salle secrète, saisir simultanément les bons mots de passe sur les terminaux de la <ui-color 582><ui-edge-color 581>salle d'ex<shy>pé<shy>ri<shy>men<shy>ta<shy>tion n°1</ui-edge-color></ui-color>, de la <ui-color 582><ui-edge-color 581>salle d'ex<shy>pé<shy>ri<shy>men<shy>ta<shy>tion n°2</ui-edge-color></ui-color> et du <ui-color 582><ui-edge-color 581>bureau du directeur</ui-edge-color></ui-color>.
#. speaker: SYSTEM
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
#. macro: <ui-color 582> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 582 (formatting: keep it as often as the source has it)
