msgctxt "quest/053/KinGkw002_05320:TEXT_KINGKW002_05320_SYSTEM_000_011:1"
msgid "Please note that upon completing the quest “Forging the Phantasmal,” you will receive a phantom weapon for <if ($gn68 == 10)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 14)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 5)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 26)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 33)>an <sheet ClassJob $gn68 0><else>a <sheet ClassJob $gn68 0></if></if></if></if></if>."
msgstr ""

#. ja: <if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if>の武器を作成しますか？
#. de: Möchtest du eine Waffe für deinen aktuellen Job <ui-color 500><ui-edge-color 501><if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if></ui-edge-color></ui-color> herstellen?
#. fr: Que faites-vous<nbsp>?
#. speaker: Q1
msgctxt "quest/053/KinGkw002_05320:TEXT_KINGKW002_05320_Q1_000_000:1"
msgid "What will you do?"
msgstr ""

#. ja: もう少し考える
#. de: Ich möchte den Job wechseln.
#. fr: Prendre le temps de réfléchir
#. speaker: A1
msgctxt "quest/053/KinGkw002_05320:TEXT_KINGKW002_05320_A1_000_001:1"
msgid "Undertake this quest as another job."
msgstr ""

#. ja: <if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if>の武器を作成する
#. de: Ja, ich will eine Waffe für den Job <ui-color 500><ui-edge-color 501><if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if></ui-edge-color></ui-color> herstellen.
#. fr: Fabriquer l'arme <if ($gn4 == 0)><if ($gn68 == 5)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 6)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 7)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 10)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 11)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 14)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 26)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 27)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 28)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 33)>d'<sheet ClassJob $gn68 0><else>de <sheet ClassJob $gn68 0></if></if></if></if></if></if></if></if></if></if><else><if ($gn68 == 5)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 6)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 7)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 10)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 11)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 14)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 26)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 27)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 28)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 33)>d'<sheet ClassJob $gn68 2><else>de <sheet ClassJob $gn68 2></if></if></if></if></if></if></if></if></if></if></if>
