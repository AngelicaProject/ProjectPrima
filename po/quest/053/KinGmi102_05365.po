# quest/053/KinGmi102_05365 — «The Endless Choice» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 9-14居住殻のワヤッケは、仲間を心配しているようだ。
#. de: Wayakkwe ist zutiefst besorgt über das Wohlergehen ihrer Kameraden.
#. fr: Wayakkwe s'inquiète pour son camarade.
#. kind: journal
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_SEQ_00:1"
msgid "Wayakkwe is fearful for her comrade."
msgstr ""

#. ja: クルルと話す
#. de: Mit Krile sprechen
#. fr: Parler à Krile
#. kind: objective
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_TODO_00:1"
msgid "Speak with Krile."
msgstr ""

#. ja: <sheet EObj 2014833 0>で見渡す
#. de: Am <noun-de EObj 5 2014833 1 3 1> Ausschau halten
#. fr: Observer les environs à l'endroit indiqué
#. kind: objective
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_TODO_01:1"
msgid "Survey the designated location."
msgstr ""

#. ja: <sheet EObj 2014834 0>で再度見渡す
#. de: Am nächsten <noun-de EObj 5 2014834 1 3 1> Ausschau halten
#. fr: Observer les environs au deuxième endroit indiqué
#. kind: objective
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_TODO_02:1"
msgid "Survey the designated location."
msgstr ""

#. ja: <sheet EObj 2014835 0>でさらに見渡す
#. de: Ein weiteres Mal am nächsten <noun-de EObj 5 2014835 1 3 1> Ausschau halten
#. fr: Observer les environs au troisième endroit indiqué
#. kind: objective
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_TODO_03:1"
msgid "Survey the designated location."
msgstr ""

#. ja: スフェーンと話す
#. de: Mit Sphene sprechen
#. fr: Parler à Sphene
#. kind: objective
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_TODO_04:1"
msgid "Speak with Sphene."
msgstr ""

#. ja: だめ、こういうときこそ落ち着かないと……。
#. de: Nein<nbsp>... Ich darf jetzt nicht die Fassung verlieren!
#. fr: C'est dur, mais il faut qu'on garde notre sang-froid...
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_000_001:1"
msgid "For their sakes, I have to remain calm..."
msgstr ""

#. ja: お母さんは、僕が動けないときも、<br>ずっとそばにいてくれて、呼びかけてくれたんだ。<br>だから僕も、そうする……！
#. de: Als es mir schlecht ging, war Mama immer bei mir<nbsp>... hat mir gut zugesprochen<nbsp>... mich umarmt<nbsp>... Jetzt will ich das Gleiche für sie tun!
#. fr: Quand je pouvais pas bouger à cause de ma maladie, ma maman restait toujours près de moi pour me tenir compagnie. Alors je vais faire pareil pour elle<nbsp>!
#. speaker: MILOS
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_MILOS_000_005:1"
msgid "When I was sick and couldn't move, my mother was always at my side, always keeping me company. And I'm going to do the same for her!"
msgstr ""

#. ja: この方は、私が看ているわ。<br>あなたたちは、とにかくイサドラさんたちを……！
#. de: Um den Verletzten kümmere ich mich. Seht ihr zu, dass ihr Isadora und Milos findet ...!
#. fr: Je vais m'occuper de lui, ne t'inquiète pas. Va plutôt t'assurer qu'Isadora et Milos vont bien<nbsp>!
#. speaker: KRILE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_KRILE_000_010:1"
msgid "I'll take care of this gentleman. Go and check on Isadora and Milos!"
msgstr ""

#. ja: いったいどうして……こんなことに……！
#. de: Was<nbsp>... Warum<nbsp>... Das kann doch nicht wahr sein ...!
#. fr: Je comprends pas... Je comprends plus rien à ce qui nous arrive<nbsp>!
#. speaker: SOLUTIONRESIDENT73
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_SOLUTIONRESIDENT73_000_015:1"
msgid "Why...? Why is this happening...?"
msgstr ""

#. ja: あの……ロビーの方で、人が倒れていたんですか……？
#. de: Was ist denn im Eingangsbereich? Etwa noch weitere Verletzte?
#. fr: Un homme à terre... dans le hall<nbsp>?
#. speaker: WAYAKKWE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_WAYAKKWE_000_020:1"
msgid "Our comrade...you think he may have been struck down?"
msgstr ""

#. ja: オブリビオンの仲間かもしれません。<br>すぐ安否を確かめに…………。
#. de: Doch nicht einer meiner Kameraden vom Vergessen, oder!? Beeilen wir uns lieber, bevor es zu spät ist!
#. fr: C'est peut-être mon partenaire. Vite, il faut que j'aille voir...
#. speaker: WAYAKKWE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_WAYAKKWE_000_021:1"
msgid "If he is wounded or worse, I should go to him..."
msgstr ""

#. ja: 待って、まだ万全じゃないんだから、安静にしてないと……！<br>ワヤッケはここでミロス君と一緒に、<br>イサドラの容態を見ていてくれるかな？
#. de: Einen Moment, Wayakkwe! Es ist noch nicht sicher und überhaupt<nbsp>... <i>du</i> benötigst Ruhe. <i>Wir</i> werden uns den Eingangsbereich vornehmen.
#. fr: Attends, tu n'es pas encore remise de tes blessures<nbsp>! Reste plutôt ici avec Milos, et veille sur Isadora.
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_000_022:1"
msgid "Wait! Please. It isn't safe and you still need rest. Would you stay with Milos and watch over Isadora for me?"
msgstr ""

#. ja: ロビーの方は、私たちが様子を見てくるから……。
#. de: Bitte gib so lange auf Isadora und Milos acht, in Ordnung?
#. fr: <split " " 1><string $gs1></split> et moi allons vérifier la situation dans le hall.
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_000_023:1"
msgid "We will tend to your friend."
msgstr ""

#. ja: すみません……お願いします……。<br>どうか、みなさんもお気をつけて……。
#. de: Ich<nbsp>... verstehe<nbsp>... Bitte passt da draußen auf euch auf!
#. fr: D-d'accord, merci... Surtout, soyez <if $gn4>prudentes<else>prudents</if>...
#. speaker: WAYAKKWE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_WAYAKKWE_000_024:1"
msgid "I... Thank you. Please be careful yourself."
msgstr ""

#. ja: あの方は……もう……。
#. de: Wir<nbsp>... Wir waren zu spät<nbsp>...
#. fr: L'homme à terre ne respire plus, hélas...
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_000_030:1"
msgid "That man, he... This is awful."
msgstr ""

#. ja: イサドラさんたち、障壁の外へ移住する手続きが終わって、<br>転居する直前だったんです……。<br>目が覚めたら、ほかの方々と一緒に保護してもらわないと……。
#. de: Isadora und ihr Sohn hatten alle Formalitäten zur Ausreise abgeschlossen<nbsp>... In ein paar Tagen wären sie bereits in Tuliyollal gewesen. Dass es jetzt ganz anders gekommen ist, muss ein riesiger Schock für die beiden sein.
#. fr: Isadora venait de terminer les démarches pour pouvoir quitter le dôme. Elle et Milos n'avaient plus qu'à déménager... J'ignore dans quel état elle sera une fois sortie du coma, mais on la prendra en charge s'il le faut.
#. speaker: WAYAKKWE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_WAYAKKWE_000_035:1"
msgid "Isadora and Milos had completed their applications to leave the dome and were practically out the door when...all this happened. We'll make sure they're taken care of the moment Isadora is ready to travel."
msgstr ""

#. ja: ……よかった、イサドラさんは一命を取り留めたのね。<br>ありがとう、ふたりとも。
#. de: Das klingt nach einer knappen Angelegenheit. Gut, dass ihr so schnell vor Ort wart<nbsp>... Und danke, dass du Isadora geholfen hast.
#. fr: Vous êtes <if $gn4>intervenues<else>intervenus</if> à temps, on dirait. Contente de savoir qu'Isadora est saine et sauve.
#. speaker: KRILE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_KRILE_000_040:1"
msgid "...Isadora is going to be alright, then? I'm so glad."
msgstr ""

#. ja: こちらも住人の方の手当が終わったところよ。
#. de: Ich bin auch gerade erst fertig geworden.
#. fr: De mon côté, j'ai fini de soigner notre homme.
#. speaker: KRILE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_KRILE_000_041:1"
msgid "I've just finished my ministrations here."
msgstr ""

#. ja: でも、オブリビオンから犠牲が出てしまった……。
#. de: Leider konnte ich für unseren Kameraden vom Vergessen hier nichts mehr tun<nbsp>...
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment, il était trop tard pour le membre d'Oblivion...
#. speaker: KRILE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_KRILE_100_041:1"
msgid "Our Oblivion comrade was beyond saving, I'm afraid..."
msgstr ""

#. ja: やっぱり、彼はオブリビオンの……。<br>体を張って、護ってくれたんだね……。
#. de: Dann war es also, wie Wayakkwe befürchtet hat<nbsp>...
#. fr: C'était donc bien le partenaire de Wayakkwe... Le pauvre a essayé de faire barrage de son corps...
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_110_041:1"
msgid "That brave soul. He gave his life to save another..."
msgstr ""

#. ja: 本当に……本当に申し訳ない……。<br>なぜこんなことになったのか、私にもさっぱりで……！
#. de: I-Ich<nbsp>... Ich konnte ja nicht<nbsp>... Es ging alles so schnell und<nbsp>...
#. fr: Je suis sincèrement désolé. J'ignore pourquoi tout ça est arrivé... C'est com<shy>plè<shy>te<shy>ment délirant<nbsp>!
#. speaker: SOLUTIONRESIDENT73
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_SOLUTIONRESIDENT73_120_041:1"
msgid "He died protecting me... I don't understand why any of this is happening!"
msgstr ""

#. ja: 機械兵は、ついさっきまで普段どおりだったんだ。<br>なのに、急におかしくなりやがった……！
#. de: Die Einheit spielte ganz plötzlich verrückt. Ich verstehe immer noch nicht, wie das geschehen konnte<nbsp>...!
#. fr: La sentinelle mécanique se comportait normalement, puis tout à coup, elle a vrillé, comme ça, sans crier gare<nbsp>!
#. speaker: SOLUTIONRESIDENT73
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_SOLUTIONRESIDENT73_130_041:1"
msgid "That sentry was behaving normally, like any other. Then, all of a sudden, it...it tried to kill me!"
msgstr ""

#. ja: やっぱり、カリュクスの命令……よね……。
#. de: Es gibt nur einen, der zu so etwas fähig ist<nbsp>...
#. fr: Encore un coup de Calyx, je présume...
#. speaker: KRILE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_KRILE_000_042:1"
msgid "Weapons or no, Calyx commanded them to commit murder..."
msgstr ""

#. ja: みなさん無事ですか！？<br>ワヤッケから連絡を受けて……
#. de: Alles in Ordnung hier?! Wayakkwe hat uns kontaktiert<nbsp>...
#. fr: Est-ce que tout va bien<nbsp>!? Wayakkwe nous a appelés pour nous prévenir qu'il y avait... Oh...
#. speaker: OBLIVIONF05365
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_OBLIVIONF05365_000_043:1"
msgid "Is it over!? We came as soon as Wayakkwe sent word..."
msgstr ""

#. ja: ごめんなさい……。<br>私たちが駆けつけたときにはもう……。
#. de: Es tut uns unendlich leid. Als wir ankamen, war es bereits zu spät<nbsp>...
#. fr: On a fait aussi vite qu'on a pu, mais ça n'a pas suffi. Je suis ter<shy>ri<shy>ble<shy>ment navrée...
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_000_044:1"
msgid "I am sorry... By the time we arrived, it was already too late."
msgstr ""

#. ja: ……ジオードさんも心配だ。<br>居住殻の安全を確保したら、すぐに探そう。
#. de: Geode, verdammt ...! Sobald die Wohnradien gesichert sind, machen wir uns auf die Suche!
#. fr: ... J'ai peur que Geode soit en danger, lui aussi. On partira à sa recherche dès qu'on aura sécurisé les lieux.
#. speaker: OBLIVIONM05365
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_OBLIVIONM05365_000_045:1"
msgid "...Then Geode could be in trouble, too. Once we have this radius locked down, we need to find him."
msgstr ""

#. ja: どういうこと……？<br>ジオードに何かあったの！？
#. de: Sagt bloß<nbsp>... Ihr erreicht ihn nicht?!
#. fr: Hein<nbsp>? Qu'est-ce qui se passe avec Geode<nbsp>? Il lui est arrivé quelque chose<nbsp>!?
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_000_046:1"
msgid "But why...? Has something happened!?"
msgstr ""

#. ja: 実は、少し前からジオードさんと連絡が途絶えたきりなんです。
#. de: Leider nein. Unser letzter Kontakt ist schon eine Weile her.
#. fr: On a perdu le contact avec lui il y a quelques minutes...
#. speaker: OBLIVIONM05365
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_OBLIVIONM05365_000_047:1"
msgid "Possibly. We're not sure what, but he stopped responding to our communications."
msgstr ""

#. ja: ただ、居住殻一帯はいまだ機械兵の制御権が戻っていないので、<br>住民の安否確認を最優先にしなければと思い……。
#. de: Die Kontrollsysteme der Einheiten hier im Umkreis lassen sich nach wie vor nicht ansteuern. Und die Sicherheit der Bewohner hat Vorrang<nbsp>...
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment, nous n'avons toujours pas récupéré le contrôle sur les sentinelles des divisions résidentielles, alors notre priorité reste pour l'instant de défendre les habitants.
#. speaker: OBLIVIONF05365
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_OBLIVIONF05365_000_047:1"
msgid "We need to prioritize securing the residential sector, though, at least until we regain control over the sentries..."
msgstr ""

#. ja: それなら、私たちでジオードを探そう。
#. de: Dann lass uns ihnen helfen! Wir über<shy>nehmen Geode und das Vergessen den Schutz der Zivilisten!
#. fr: On devrait tenter de retrouver Geode à leur place.
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_000_048:1"
msgid "Then we should search for Geode."
msgstr ""

#. ja: そうね、オブリビオンはレギュレーター未着用者が多い……<br>さっきの推測が正しければ、<br>彼ら自身が標的とされてしまう可能性もあるわ。
#. de: Regulatoren sind im Vergessen nicht sonderlich verbreitet. Und wenn unsere Vermutung von vorhin zutreffen sollte<nbsp>... dann würden sich seine Mitglieder zur Zielscheibe der Maschinen machen und nur unnötig in Gefahr bringen. 
#. fr: Oui. Beaucoup de membres d'Oblivion ne portent pas de régulateur<nbsp>; et si notre hypothèse est bonne, cela fait d'eux des cibles privilégiées...
#. speaker: KRILE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_KRILE_100_048:1"
msgid "I agree. Since most Oblivion members have sworn off regulators, if our theory holds true, then they could be prime targets for the next attack."
msgstr ""

#. ja: あなたたちには、<br>引き続き住民の安否確認をお願いしたいけれど……<br>できるだけ機械兵に見つからないように注意して。
#. de: Wie schon gesagt, kümmert ihr euch bitte um die Bewohner der Wohnradien. Nur passt auf, dass ihr dabei nicht von den Einheiten entdeckt werdet, die hier überall ihr Unwesen treiben.
#. fr: On vous laisse vous occuper des résidents. Par contre, tâchez de rester autant que possible à l'écart des sentinelles mécaniques.
#. speaker: KRILE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_KRILE_110_048:1"
msgid "Please do what you can to shepherd the residents to safety, but avoid the sentries at all costs."
msgstr ""

#. ja: 助かります……。<br>では、この通信機を持って行ってください。
#. de: Danke<nbsp>... Hier, für euch. Damit bleiben wir in Kontakt.
#. fr: C'est noté. Tenez, prenez nos communicateurs.
#. speaker: OBLIVIONM05365
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_OBLIVIONM05365_000_049:1"
msgid "Our thanks. Here, take these communicators."
msgstr ""

#. ja: 我々が付近の仲間と連絡を取り合うときに使っているもので、<br>カリュクスに傍受されないよう、改良してあります。
#. de: Die sind so modifiziert, dass Calyx sie weder abhören noch das Signal stören kann. Informationen entscheiden schließlich Kriege.
#. fr: Ils ont été améliorés pour nous permettre de discuter à moyenne portée, tout en bloquant les tentatives d'écoute clandestine.
#. speaker: OBLIVIONM05365
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_OBLIVIONM05365_000_050:1"
msgid "We've made modifications to them to prevent Calyx from intercepting the signal, and have been using them to coordinate movements with allies in the vicinity."
msgstr ""

#. ja: ワヤッケも同じものを持っているので、<br>ジオードさんに呼び掛け続けるよう伝えておきます。
#. de: Wayakkwe hat auch eins. Wir geben ihr Bescheid, dass sie weiter versuchen soll, Geode zu erreichen.
#. fr: Wayakkwe en a un, elle aussi. Je lui dirai de continuer à essayer de joindre Geode au cas où.
#. speaker: OBLIVIONM05365
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_OBLIVIONM05365_000_051:1"
msgid "Wayakkwe has one too, so I'll ask her to keep hailing Geode."
msgstr ""

#. ja: どうか、お気をつけて……！
#. de: Und bitte<nbsp>... Passt da draußen auf euch auf!
#. fr: Faites attention à vous<nbsp>!
#. speaker: OBLIVIONF05365
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_OBLIVIONF05365_000_052:1"
msgid "Good luck, and stay safe!"
msgstr ""

#. ja: ジオードさんは、近くを見てくると言っていたわ。<br>この建物の周辺から、探してみましょう！
#. de: Geode meinte doch, er wolle sich die Lage in der Umgebung ansehen, oder? Weit kann er dann ja eigentlich nicht sein. Teilen wir uns auf!
#. fr: Aux dernières nouvelles, Geode a dit qu'il allait vérifier les alentours. Allons jeter un œil dans les environs de cet immeuble<nbsp>!
#. speaker: KRILE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_KRILE_000_053:1"
msgid "Geode said he would sweep the surrounding area, so he shouldn't have ventured too far. Let's get going!"
msgstr ""

#. ja: ジオードさんの捜索、どうかよろしくお願いします。<br>あの人のことですから、きっとうまく切り抜けながら、<br>住人を助けているんだと思うのですが……。
#. de: Bitte findet den Boss. Ich bin mir sicher, dass er einfach nur zu beschäftigt damit ist, Radiusbewohner zu retten, um zu reagieren<nbsp>... Wir reden hier von <i>dem</i> Geode. Hach<nbsp>...
#. fr: J'espère que vous allez retrouver Geode. Le connaissant, je pense qu'il est en train de porter secours à des habitants, et qu'il est pris dans le feu de l'action... 
#. speaker: OBLIVIONF05365
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_OBLIVIONF05365_000_055:1"
msgid "I hope you find Geode soon. I know he's probably saving people with one hand and fighting off threats with the other, but I can't help but worry..."
msgstr ""

#. ja: そちらの住民の方と、仲間の遺体のことも、あとは我々が……。<br>ひとりでも犠牲者を抑えられるよう、最善を尽くします……。
#. de: Wir kümmern uns um die Evakuierung der Zivilisten. Und unseren gefallenen Kameraden<nbsp>...
#. fr: Nous allons nous occuper de l'habitant... ainsi que du corps de notre camarade... Oblivion fera le nécessaire pour limiter au maximum le nombre de victimes.
#. speaker: OBLIVIONM05365
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_OBLIVIONM05365_000_060:1"
msgid "Leave matters here to us. We'll see to our fallen comrade, and make sure no one else comes to harm."
msgstr ""

#. ja: 先ほどのミララ族の女性に、あとでお礼を伝えてください。<br>動転した私に付き添ってくれて、本当に助かったと。
#. de: Diese wundervolle Milalla ist nicht von meiner Seite gewichen. Mir geht es jetzt so viel besser. Bitte richte ihr meinen Dank aus.
#. fr: Il faudra que je remercie votre amie milalla d'être restée à mes côtés. C'est grâce à elle que j'ai pu retrouver un semblant de sérénité.
#. speaker: SOLUTIONRESIDENT73
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_SOLUTIONRESIDENT73_000_065:1"
msgid "Pray thank your Milalla friend for me. I would still be a helpless mess if not for her encouragement..."
msgstr ""

#. ja: まずは居住殻を中心に探しましょう！
#. de: Konzentrieren wir uns zunächst auf die Wohnradien!
#. fr: Cherchons dans tout le secteur résidentiel<nbsp>!
#. speaker: KRILE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_KRILE_000_070:1"
msgid "Let's search around the apartments first!"
msgstr ""

#. ja: ジオード、無事でいて……！
#. de: Komm schon, Geode<nbsp>...!
#. fr: Faites que Geode aille bien...
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_000_075:1"
msgid "Please, Geode... Please be safe..."
msgstr ""

#. ja: ジオードの姿は見当たらない……。<br>もう少し東側を探してみよう。
#. de: Geode ist nirgendwo zu sehen<nbsp>... Aber es ist noch zu früh, um aufzugeben. Suche woanders weiter!
#. fr: Geode ne semble pas se trouver dans les parages... Continuez de chercher plus à l'est.
#. speaker: SYSTEM
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_SYSTEM_000_080:1"
msgid "You see no sign of Geode. Perhaps you should search further to the east."
msgstr ""

#. ja: ジオードの姿は見当たらない……。<br>通信機からワヤッケの声が聞こえてくる。
#. de: Geode ist nirgendwo zu sehen<nbsp>... Stattdessen hörst du über Funk Wayakkwes Stimme.
#. fr: Toujours aucun signe de Geode. Vous entendez la voix de Wayakkwe à travers votre communicateur...
#. speaker: SYSTEM
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_SYSTEM_000_090:1"
msgid "You see no sign of Geode. Wayakkwe's voice crackles forth from the communicator..."
msgstr ""

#. ja: (-ワヤッケ-)ジオード、応答してください……！
#. de: (-Wayakkwe-)Geode<nbsp>... Bitte kommen! Geode<nbsp>...!
#. fr: (-Voix de Wayakkwe-)Geode, si tu es là, dis quelque chose<nbsp>!
#. speaker: WAYAKKWE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_WAYAKKWE_000_091:1"
msgid "(-Wayakkwe-)Geode! Geode, answer me!"
msgstr ""

#. ja: ……応答はないようだ。<br>さらに東側を探してみよう。
#. de: Keine Antwort. Setze deine Suche weiter östlich fort.
#. fr: Son appel reste sans réponse... Continuez de chercher plus à l'est.
#. speaker: SYSTEM
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_SYSTEM_000_092:1"
msgid "There is no response. Perhaps you should continue your search further to the east."
msgstr ""

#. ja: ジオードの姿は見当たらない。<br>居住殻の中だろうか……先ほどとは別の棟を探してみよう。
#. de: Geode ist nach wie vor nirgendwo zu sehen. Im Wohnradius nebenan hast du vielleicht mehr Glück.
#. fr: Geode n'est pas là non plus. Vous décidez d'aller voir dans l'immeuble le plus proche...
#. speaker: SYSTEM
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_SYSTEM_000_100:1"
msgid "You see no sign of Geode. The neighboring residential radius would be the next logical place to look..."
msgstr ""

#. ja: ごめんなさい……言葉が出なくて……。
#. de: Mir<nbsp>... Mir fehlen die Worte<nbsp>...
#. fr: Désolée... je ne sais pas quoi dire...
#. speaker: KRILE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_KRILE_000_105:1"
msgid "I can't... There are no words..."
msgstr ""

#. ja: 本当に……この塵が…………。
#. de: Der Staub<nbsp>... Dann<nbsp>... Nein<nbsp>...
#. fr: C'est une plai<shy>san<shy>te<shy>rie...
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_000_110:1"
msgid "This pile of dust. These...ashes..."
msgstr ""

#. ja: 塵と、ケージを置いていって……<br>それでジオードを返したつもりなの……？
#. de: Das ist alles? Ein Staubhaufen und eine Seelenzelle? Mehr war Geode in seinen Augen nicht<nbsp>...?
#. fr: Il pense qu'en nous laissant un tas de poussière et une cage d'âme, il nous a rendu notre ami<nbsp>!?
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_100_110:1"
msgid "And the soul cell he left behind... Was that his twisted way of returning Geode to us?"
msgstr ""

#. ja: カリュクス……キミは……<br>キミの計画は、おかしいよ……ッ！
#. de: Calyx<nbsp>...! Wie<nbsp>... Wie kannst du nur?! Ist es dir das wirklich wert<nbsp>...?!
#. fr: Calyx... Tes plans, ta façon de raisonner... Rien ne tient debout<nbsp>!
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_000_111:1"
msgid "Damn you, Calyx... Damn you and your careless cruelty!"
msgstr ""

#. ja: ジオード……。
#. de: Geode<nbsp>...
#. fr: Geode...
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_000_112:1"
msgid "He was our friend..."
msgstr ""

#. ja: ……それでも。<br>永久人になった5000人が、そのあと幸せに暮らし続けたなら、<br>すべて、必要な犠牲だったと言われるんだわ。
#. de: Solange Fünftausend ihre Endlosigkeit erlangen und diese aufrechterhalten werden kann, wird Calyx all das Morden und Seelensammeln als notwendiges Übel abtun und dafür von einigen Leuten auch noch Zustimmung bekommen.
#. fr: Si Calyx parvient à offrir une vie heureuse à ses cinq mille élus, ces derniers diront que c'était un mal pour un bien...
#. speaker: KRILE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_KRILE_000_113:1"
msgid "Even so. Some might say every death was justified if it meant five thousand Endless could continue their immortal lives."
msgstr ""

#. ja: あるいは、鏡像世界からエーテルを奪って、<br>より多くの人が永久人となったなら。<br>それもまた、尊い犠牲と呼ばれるのかしらね……。
#. de: Und gelingt es ihm, den Äther anderer Welten zu ernten und so weitere Endlose zu erschaffen, wird er sogar noch mehr Anhänger gewinnen.
#. fr: A fortiori s'il arrive à exploiter l'éther des reflets pour créer une belle et grande population d'Éternels...
#. speaker: KRILE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_KRILE_000_114:1"
msgid "And if a reflection's stolen aether allowed for many more Endless? Why, that too would be a noble sacrifice for the greater good..."
msgstr ""

#. ja: そんなの……ッ！！
#. de: Nein<nbsp>... Das<nbsp>...!
#. fr: Mais ce serait com<shy>plè<shy>te<shy>ment injuste<nbsp>!
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_100_114:1"
msgid "Who could think that!?"
msgstr ""

#. ja: 私だって嫌よ……！
#. de: Ich weiß<nbsp>... Es klingt wahnsinnig.
#. fr: Je sais bien<nbsp>!
#. speaker: KRILE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_KRILE_110_114:1"
msgid "Not I!"
msgstr ""

#. ja: ……嫌に、決まっているわ。
#. de: Und es <i>ist</i> wahnsinnig. Doch Furcht vernebelt den Verstand.
#. fr: Évidemment qu'à nos yeux, ce serait cruel et cynique...
#. speaker: KRILE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_KRILE_120_114:1"
msgid "...Certainly not I."
msgstr ""

#. ja: だって私たちは……これが尊い犠牲なんかじゃなくて、<br>ジオードさんなんだって……知っているもの……。
#. de: Wir wissen, dass seine Gräueltaten kein notwendiges Übel sind. <i>Wir</i> wissen, <i>wer</i> Geode war<nbsp>...
#. fr: Car pour nous, il aurait été impensable de sacrifier Geode... notre ami...
#. speaker: KRILE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_KRILE_130_114:1"
msgid "We know only too well... There is naught noble in this sacrifice."
msgstr ""

#. ja: 止めなくちゃ……。<br>カリュクスの居場所を、早く、突き止めて……。
#. de: Wo auch immer du dich versteckst<nbsp>... Wir finden dich, Calyx!
#. fr: Il faut arrêter Calyx... Découvrir sa cachette sans plus tarder...
#. speaker: ORIGINALSPHENE
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_000_119:1"
msgid "We have to stop him. We have to find Calyx, and put an end to this madness as soon as possible..."
msgstr ""

#. ja: ……<split " " 1><string $gs1></split>、お願い。<br>キミの持つ「鍵」を、絶対に渡さないで。
#. de: Bitte pass gut auf den Schlüssel auf, <split " " 1><string $gs1></split>. Er darf ihn nicht bekommen!
#. fr: <split " " 1><string $gs1></split>, je t'en conjure<nbsp>: quoi qu'il arrive, ne lui donne jamais la clef.
#. speaker: ORIGINALSPHENE
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_000_120:1"
msgid "And under no circumstances can we let the key fall into his possession, <split \" \" 1><string $gs1></split>."
msgstr ""

#. ja: カリュクスの計画を、進ませたりしない……。<br>アレクサンドリアの中で、終わらせるんだ……！
#. de: Bereiten wir diesem Wahnsinn ein Ende<nbsp>- hier, in Alexandria!
#. fr: Nous devons contrecarrer ses plans tant qu'il en est encore temps<nbsp>!
#. speaker: ORIGINALSPHENE
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/053/KinGmi102_05365:TEXT_KINGMI102_05365_ORIGINALSPHENE_000_121:1"
msgid "It falls to us. We must─we <i>will</i> thwart his plans here in Alexandria before he can terrorize innocents in reflections elsewhere..."
msgstr ""
