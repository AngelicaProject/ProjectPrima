msgctxt "quest/040/AktKbb201_04073:TEXT_AKTKBB201_04073_SYSTEM_000_112:1"
msgid "A button for the Gear Set interface is located in the upper portion of the <ui-color 500><ui-edge-color 501>Character</ui-edge-color></ui-color> window."
msgstr "Кнопка окна «Наборы снаряжения» находится в верхней части окна <ui-color 500><ui-edge-color 501>«Персонаж»</ui-edge-color></ui-color>."
