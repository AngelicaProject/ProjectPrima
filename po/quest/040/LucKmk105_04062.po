msgctxt "quest/040/LucKmk105_04062:TEXT_LUCKMK105_04062_SYSTEM_000_500:1"
msgid "You may now enter Paglth'an with a party of NPC avatars. To make use of this feature, open the <ui-color 500><ui-edge-color 501>Trust</ui-edge-color></ui-color> interface located under <ui-color 500><ui-edge-color 501>Duty</ui-edge-color></ui-color> in the main menu."
msgstr "Теперь вы можете отправиться в Пагльт'ан с отрядом из NPC-двойников. Чтобы воспользоваться этой возможностью, откройте в главном меню раздел «Задания», а в нём — «Потомки»."
