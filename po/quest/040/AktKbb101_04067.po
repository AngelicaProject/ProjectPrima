msgctxt "quest/040/AktKbb101_04067:TEXT_AKTKBB101_04067_SYSTEM_000_092:1"
msgid "A button for the Gear Set interface is located in the upper portion of the <ui-color 500><ui-edge-color 501>Character</ui-edge-color></ui-color> window."
msgstr "Кнопка интерфейса комплектов снаряжения находится в верхней части окна <ui-color 500><ui-edge-color 501>персонажа</ui-edge-color></ui-color>."
