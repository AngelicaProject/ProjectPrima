msgctxt "quest/040/LucKta512_04045:TEXT_LUCKTA512_04045_SYSTEM_000_031:1"
msgid "The message can be viewed in your <ui-color 500><ui-edge-color 501>Portable Archive</ui-edge-color></ui-color>, which is available under Collection in the Duty section of the main menu."
msgstr "Послание можно прочитать в разделе «Коллекция» меню «Обязанности»: выберите там <ui-color 500><ui-edge-color 501>«Архив»</ui-edge-color></ui-color>."

