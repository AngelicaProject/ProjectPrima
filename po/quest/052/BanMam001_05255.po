msgid "Speak with Ruvoll Ja."
msgstr "Поговорить с Руволлом Джа."

#. ja: ドプロ族たちと話す
#. de: Die Wivren-Meister überzeugen
#. fr: Parler aux Doppro
#. kind: objective
msgctxt "quest/052/BanMam001_05255:TEXT_BANMAM001_05255_TODO_02:1"
msgid "Convince the wivre handlers."
msgstr "Убедить укротителей вивр."

#. ja: カゲージャと話す
#. de: Mit Kageel Ja sprechen
#. fr: Parler à Kageel Ja
#. kind: objective
msgctxt "quest/052/BanMam001_05255:TEXT_BANMAM001_05255_TODO_03:1"
msgid "Speak with Kageel Ja."
msgstr "Поговорить с Кагилем Джа."

