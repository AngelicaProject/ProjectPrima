msgid "Speak with R'tcha."
msgstr "Поговорите с Р'чей."

#. ja: 再度ル・チャと話す
#. de: Noch einmal mit R'tcha sprechen
#. fr: Reparler à R'tcha
#. kind: objective
msgctxt "quest/052/FesAnx102_05298:TEXT_FESANX102_05298_TODO_01:1"
msgid "Speak with R'tcha again."
msgstr "Поговорите с Р'чей ещё раз."

#. ja: アヨヨと話す
#. de: Mit Ayoyo sprechen
#. fr: Parler à Ayoyo
#. kind: objective
msgctxt "quest/052/FesAnx102_05298:TEXT_FESANX102_05298_TODO_02:1"
msgid "Speak with Ayoyo."
msgstr "Поговорите с Айойо."

#. ja: ル・チャと話す
#. de: Mit R'tcha sprechen
#. fr: Parler à R'tcha
#. kind: objective
msgctxt "quest/052/FesAnx102_05298:TEXT_FESANX102_05298_TODO_03:1"
msgid "Speak with R'tcha."
msgstr "Поговорите с Р'чей."

