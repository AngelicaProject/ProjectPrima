msgctxt "quest/003/GaiUse506_00368:TEXT_GAIUSE506_00368_EDELSTEIN_000_0070:1"
msgid "<capitalize><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 8></if><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 8></if><if ($gn54 > 0)><sheet GCRankUldahMaleText $gn54 8></if></capitalize> <split \" \" 2><string $gs1></split>! What news of the Garleans?"
msgstr ""

#. ja: なるほど、敵の略奪部隊は撃退されたのですね。<br>それを聞いて安心しましたぞ！
#. de: Ihr habt das Überfallkommando in die Flucht geschlagen? Gepriesen sei Rhalgr!
#. fr: ... Bon travail, <capitalize><if ($gn52 > 0)><if $gn4><sheet GCRankLimsaFemaleText $gn52 0><else><sheet GCRankLimsaMaleText $gn52 0></if><else><if ($gn53 > 0)><if $gn4><sheet GCRankGridaniaFemaleText $gn53 0><else><sheet GCRankGridaniaMaleText $gn53 0></if><else><if ($gn54 > 0)><if $gn4><sheet GCRankUldahFemaleText $gn54 0><else><sheet GCRankUldahMaleText $gn54 0></if></if></if></if></capitalize><nbsp>! Les employés de l'usine seront cer<shy>tai<shy>ne<shy>ment rassurés d'apprendre qu'ils ne courent plus aucun danger.
#. speaker: EDELSTEIN
msgctxt "quest/003/GaiUse506_00368:TEXT_GAIUSE506_00368_EDELSTEIN_000_071:1"
msgid "Their raiding parties are no more, then? Excellent."
msgstr ""

#. ja: ここにいるアマジナ鉱山社の技師たちも、<br>きっと胸をなで下ろすことでしょう。<br>いやはや、ご協力ありがとうございました！
#. de: Da wird den Technikern der Amajina Bergbau AG aber ein Stein vom Herzen fallen - ebenso wie mir. Tausend Dank!
#. fr: Je vais également contacter le commandant Leveilleur pour le remercier d'avoir envoyé ses Braves en renfort. Malgré son jeune âge, cette or<shy>ga<shy>ni<shy>sa<shy>tion se montre déjà très efficace. Voilà qui augure bien pour l'avenir.
#. speaker: EDELSTEIN
msgctxt "quest/003/GaiUse506_00368:TEXT_GAIUSE506_00368_EDELSTEIN_000_072:1"
msgid "The Amajina engineers will be most relieved to hear that the plant is no longer in any immediate danger. Thank you again for your assistance."
msgstr ""

#. ja: くそっ！<br>先制攻撃だと！？
#. de: Verdammt, ein Präventivschlag!
#. fr: Merde<nbsp>! On nous a repérés<nbsp>!
#. speaker: BALLOON
msgctxt "quest/003/GaiUse506_00368:TEXT_GAIUSE506_00368_BALLOON_000_080:1"
msgid "Bah! We've been spotted!"
msgstr ""

#. ja: 敵に発見されたか！<br>攻撃開始だ！
#. de: Wir wurden entdeckt! Angriff!
#. fr: On nous attaque<nbsp>! Aux armes<nbsp>!
#. speaker: BALLOON
#. macro: <br> — a line break (may be added or dropped)
msgctxt "quest/003/GaiUse506_00368:TEXT_GAIUSE506_00368_BALLOON_000_081:1"
msgid "Our position is compromised!<br>To arms!"
msgstr ""
