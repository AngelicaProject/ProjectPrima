msgctxt "quest/010/JobBrd300_01085:TEXT_JOBBRD300_01085_SYSTEM_000_112:1"
msgid "A button for the Gear Set interface is located in the upper portion of the <ui-color 500><ui-edge-color 501>Character</ui-edge-color></ui-color> window."
msgstr "Кнопка наборов экипировки находится в верхней части окна <ui-color 500><ui-edge-color 501>персонажа</ui-edge-color></ui-color>."
