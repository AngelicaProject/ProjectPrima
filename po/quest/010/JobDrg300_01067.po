msgctxt "quest/010/JobDrg300_01067:TEXT_JOBDRG300_01067_SYSTEM_000_082:1"
msgid "A button for the Gear Set interface is located in the upper portion of the <ui-color 500><ui-edge-color 501>Character</ui-edge-color></ui-color> window."
msgstr "Кнопка управления комплектами экипировки находится в верхней части окна <ui-color 500><ui-edge-color 501>персонажа</ui-edge-color></ui-color>."
