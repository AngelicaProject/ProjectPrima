msgctxt "quest/010/JobWar300_01049:TEXT_JOBWAR300_01049_SYSTEM_000_72:1"
msgid "A button for the Gear Set interface is located in the upper portion of the <ui-color 500><ui-edge-color 501>Character</ui-edge-color></ui-color> window."
msgstr "Кнопка управления наборами экипировки находится в верхней части окна <ui-color 500><ui-edge-color 501>Персонаж</ui-edge-color></ui-color>."
