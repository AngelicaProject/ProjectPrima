msgctxt "quest/010/JobBlm300_01073:TEXT_JOBBLM300_01073_SYSTEM_000_122:1"
msgid "A button for the Gear Set interface is located in the upper portion of the <ui-color 500><ui-edge-color 501>Character</ui-edge-color></ui-color> window."
msgstr "Кнопка наборов экипировки находится в верхней части окна <ui-color 500><ui-edge-color 501>«Персонаж»</ui-edge-color></ui-color>."
