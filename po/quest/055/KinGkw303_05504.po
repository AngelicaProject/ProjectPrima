msgctxt "quest/055/KinGkw303_05504:TEXT_KINGKW303_05504_SYSTEM_000_013:1"
msgid "Please note that upon completing the quest “A Phantom Unveiled,” you will receive a phantom weapon for <if ($gn68 == 10)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 14)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 5)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 26)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 33)>an <sheet ClassJob $gn68 0><else>a <sheet ClassJob $gn68 0></if></if></if></if></if>."
msgstr "Обратите внимание: после завершения задания «Раскрытая сила призрачного оружия» вы получите фантомное оружие для класса или профессии <if ($gn68 == 10)>«<sheet ClassJob $gn68 0>»<else><if ($gn68 == 14)>«<sheet ClassJob $gn68 0>»<else><if ($gn68 == 5)>«<sheet ClassJob $gn68 0>»<else><if ($gn68 == 26)>«<sheet ClassJob $gn68 0>»<else><if ($gn68 == 33)>«<sheet ClassJob $gn68 0>»<else>«<sheet ClassJob $gn68 0>»</if></if></if></if></if>."

#. ja: <if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if>の武器を強化しますか？
#. de: Möchtest du die Waffe für deinen aktuellen Job <ui-color 500><ui-edge-color 501><if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if></ui-edge-color></ui-color> verbessern?
#. fr: Que faites-vous<nbsp>?
#. speaker: Q1
msgctxt "quest/055/KinGkw303_05504:TEXT_KINGKW303_05504_Q1_000_000:1"
msgid "What will you do?"
msgstr "Что вы будете делать?"

#. ja: もう少し考える
#. de: Nein, ich möchte den Job wechseln.
#. fr: Prendre le temps de réfléchir
#. speaker: A1
msgctxt "quest/055/KinGkw303_05504:TEXT_KINGKW303_05504_A1_000_001:1"
msgid "Undertake this quest as another job."
msgstr "Принять задание за другой класс или профессию."

#. ja: <if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if>の武器を強化する
#. de: Ja, ich will die Waffe für den Job <ui-color 500><ui-edge-color 501><if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if></ui-edge-color></ui-color> verbessern.
#. fr: Améliorer l'arme <if ($gn4 == 0)><if ($gn68 == 5)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 6)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 7)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 10)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 11)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 14)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 26)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 27)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 28)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 33)>d'<sheet ClassJob $gn68 0><else>de <sheet ClassJob $gn68 0></if></if></if></if></if></if></if></if></if></if><else><if ($gn68 == 5)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 6)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 7)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 10)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 11)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 14)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 26)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 27)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 28)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 33)>d'<sheet ClassJob $gn68 2><else>de <sheet ClassJob $gn68 2></if></if></if></if></if></if></if></if></if></if></if>
