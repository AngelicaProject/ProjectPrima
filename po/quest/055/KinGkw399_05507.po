msgctxt "quest/055/KinGkw399_05507:TEXT_KINGKW399_05507_SYSTEM_000_106:1"
msgid "Your phantom weaponry (<if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if>) has been readjusted."
msgstr "Параметры фантомного оружия для класса или профессии <if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if> перенастроены."
