# quest/032/LucKma103_03281 — «Travelers of Norvrandt» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: ドッサル大門前の水晶公は、大事な話をしたいようだ。
#. de: Der Kristall<shy>exarch hat Wichtiges mit dir zu besprechen.
#. fr: L'exarque du Cristal est prêt à parler de vos amis.
#. kind: journal
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_SEQ_00:1"
msgid "The Crystal Exarch is finally ready to discuss the matter of your comrades' whereabouts."
msgstr ""

#. ja: 衛兵団の守衛と話す
#. de: Mit dem Soldaten der Stadtwache sprechen
#. fr: Parler au soldat de la garde
#. kind: objective
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_TODO_00:1"
msgid "Speak with the Crystarium gatekeep."
msgstr ""

#. ja: 水晶公と話す
#. de: Mit dem Kristall<shy>exarchen sprechen
#. fr: Parler à l'exarque du Cristal
#. kind: objective
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_TODO_01:1"
msgid "Speak with the Crystal Exarch."
msgstr ""

#. ja: 水晶公と再度話す
#. de: Dem Kristall<shy>exarchen folgen
#. fr: Reparler à l'exarque du Cristal
#. kind: objective
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_TODO_02:1"
msgid "Speak with the Crystal Exarch."
msgstr ""

#. ja: 水晶公とさらに話す
#. de: Den Kristall<shy>exarchen in den Isomorph-Quartieren treffen
#. fr: Parler de nouveau à l'exarque du Cristal
#. kind: objective
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_TODO_03:1"
msgid "Speak with the Crystal Exarch."
msgstr ""

#. ja: ペンダント居住館の管理人と話す
#. de: Mit dem Verwalter der Isomorph-Quartiere sprechen
#. fr: Parler à l'intendant des Pendants
#. kind: objective
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_TODO_04:1"
msgid "Speak with the manager of suites in the Pendants."
msgstr ""

#. ja: 星見の間の水晶公と話す
#. de: Den Kristall<shy>exarchen im Okular aufsuchen
#. fr: Parler avec l'exarque du Cristal, à L'Observatoire
#. kind: objective
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_TODO_05:1"
msgid "Speak with the Crystal Exarch in the Ocular."
msgstr ""

#. ja: 発見された装置は、こちらでお預かりしております！<br>お使いになられますか……？
#. de: Hier ist er, dieser merkwürdige Sender<nbsp>... Kannst du wohl etwas damit anfangen, was meinst du?
#. fr: Je suis chargé de veiller sur le dispositif que vous avez découvert. Voulez-vous l'utiliser<nbsp>?
#. speaker: GARLONDMAN03279
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_GARLONDMAN03279_100_000:1"
msgid "I've been keeping that device you uncovered safe and sound. Did you need to use it again...?"
msgstr ""

#. ja: 装置に触れて「第一世界」へ移動しますか？
#. de: Von dem Sender in die erste Splitter<shy>welt tragen lassen?
#. fr: Toucher le dispositif et aller dans le premier reflet<nbsp>?
#. speaker: Q0
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_Q0_100_000:1"
msgid "Touch the beacon and travel to the First?"
msgstr ""

#. ja: こちらの事情を知ってもらったのだ、<br>次こそは、あなたの仲間についての話をすべきだろう。
#. de: Jetzt, wo du einen Eindruck der Lage bekommen hast, wird es höchste Zeit, über deine Freunde zu sprechen.
#. fr: Puisque tu as fait l'effort de te mettre au courant comme je te l'ai demandé, c'est maintenant à moi de remplir ma part du marché. Je vais donc te dire ce qui est arrivé à tes compagnons.
#. speaker: MYSTERYVOICE
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_MYSTERYVOICE_000_000:1"
msgid "You've done as I requested, and learned something of the world in which you find yourself. Now it's time I fulfilled my half of the bargain, and explained what has befallen your comrades."
msgstr ""

#. ja: まずは、場所の移動を。<br>私の執務室は、クリスタルタワーの内部にある。<br>「衛兵団の守衛」に声をかけて、中に入るとしよう。
#. de: Aber nicht hier. Treffen wir uns im Kristallturm. Sprich einfach mit der Wache vor dem Eingang. Sie wird dich einlassen und dir den Weg zeigen.
#. fr: Allons poursuivre cette con<shy>ver<shy>sa<shy>tion dans mes quartiers à l'intérieur de la Tour de Cristal, veux-tu<nbsp>? J'ai un peu de rangement à faire, mais je vais prévenir le garde de ton arrivée imminente.
#. speaker: MYSTERYVOICE
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_MYSTERYVOICE_000_001:1"
msgid "That is a conversation I would rather have in the privacy of my quarters, however. I must go on ahead to the tower and organize a few things, but I shall see that the guard knows to admit you."
msgstr ""

#. ja: 何と言う？
#. de: Was antwortest du?
#. fr: Que dites-vous<nbsp>? 
#. speaker: Q1
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_Q1_000_002:1"
msgid "What will you say?"
msgstr ""

#. ja: ……塔の扉が開いているのか？
#. de: Ist das Tor des Turms denn nicht verschlossen?
#. fr: Les portes sont donc ouvertes<nbsp>?
#. speaker: A1
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_A1_000_003:1"
msgid "The tower's gate lies open, then?"
msgstr ""

#. ja: もしかして、グ・ラハ・ティア……？
#. de: Und G'raha Tia<nbsp>...?
#. fr: Est-ce que G'raha Tia...<nbsp>?
#. speaker: A1
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_A1_000_004:1"
msgid "Just like that? Then...G'raha Tia is...?"
msgstr ""

#. ja: ああ、もちろんだ。<br>呼び寄せた当初から、塔の扉は自由に開閉できている。
#. de: Selbstverständlich. Das Tor ließ sich seit jeher frei öffnen und schließen. Kommt dir das etwa seltsam vor?
#. fr: Oui, bien sûr. Elles peuvent être ouvertes ou fermées comme n'importe quelles portes, et cela a toujours été le cas depuis l'arrivée de la tour ici.
#. speaker: MYSTERYVOICE
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_MYSTERYVOICE_000_005:1"
msgid "Well, yes, of course. It can be opened and closed just like any other. Does that seem strange to you?"
msgstr ""

#. ja: あなたの時代に、どうだったのかは知らないが……<br>閉じ込められるようなことはないから、<br>安心してついてきてほしい。
#. de: Ich weiß nicht, wie es sich in deiner Ära mit dem Turm verhalten hat. Hier wirst du aber weder aus- noch eingesperrt, hab also keine Sorge.
#. fr: Je ne sais pas comment cela fonctionnait à ton époque, mais je peux t'assurer qu'il n'y a absolument aucun risque de se retrouver enfermé à l'intérieur.
#. speaker: MYSTERYVOICE
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_MYSTERYVOICE_000_006:1"
msgid "I know not how the tower functioned in your time, but I assure you there is no danger of us being locked inside."
msgstr ""

#. ja: ……知らない名前だな。<br>その人物が、どうかしたのだろうか？
#. de: Entschuldige, dieser Name sagt mir nichts. Um wen soll es sich dabei handeln?
#. fr: ... Ce nom ne me dit rien. Y a-t-il quelque chose que je devrais savoir<nbsp>?
#. speaker: MYSTERYVOICE
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_MYSTERYVOICE_000_007:1"
msgid "...I am not familiar with that name. Is there something I should know?"
msgstr ""

#. ja: なるほど……。<br>しかし、この塔の中にそれらしき者はいなかった。<br>申し訳ないが、今は互いの目的を優先させてもらおう。
#. de: Was für eine außer<shy>ge<shy>wöhn<shy>liche Geschichte. Aber leider fand ich niemanden in dem Turm vor, als er in meine Obhut kam. Lass uns doch später noch einmal darüber sprechen. Für den Augenblick haben wir Dringlicheres vor uns.
#. fr: Quelle histoire incroyable... Mal<shy>heu<shy>reu<shy>se<shy>ment, je n'ai trouvé personne correspondant à cette description lorsque j'ai pénétré dans la tour. Concentrons-nous plutôt sur nos problèmes pour l'instant, nous pourrons toujours reparler de ce mystère une autre fois.
#. speaker: MYSTERYVOICE
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_MYSTERYVOICE_000_008:1"
msgid "An extraordinary tale. But I'm afraid I found no such individual residing in the tower when it passed into my care. Mayhap we can revisit that mystery another time. For now, I think it best that we focus on the present."
msgstr ""

#. ja: 水晶公の、お客人ですね。<br>どうぞお通りください！
#. de: Der Gast des Kristall<shy>exarchen, richtig? Bitte, tritt ein.
#. fr: Salutations, <if $gn4>Madame<else>Monsieur</if>. L'exarque vous attend à l'intérieur.
#. speaker: CRYSTALGATEKEEPER
#. macro: <if $gn4>madam<else>sir</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_CRYSTALGATEKEEPER_000_010:1"
msgid "Greetings, <if $gn4>madam<else>sir</if>. The Exarch awaits you within."
msgstr ""

#. ja: クリスタルタワーに入りますか？
#. de: Das Okular betreten?
#. fr: Entrer dans la Tour de Cristal<nbsp>?
#. speaker: Q2
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_Q2_000_011:1"
msgid "Enter the Crystal Tower?"
msgstr ""

#. ja: 公とお出かけですか？<br>いってらっしゃいませ！
#. de: Ich soll das Tor öffnen? Aber gerne.
#. fr: Vous visitez la ville en compagnie de l'exarque<nbsp>? Il n'y a pas meilleur guide pour ça<nbsp>!
#. speaker: CRYSTALGATEKEEPER
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_CRYSTALGATEKEEPER_000_020:1"
msgid "Touring the city with the Exarch, are you? You could have no finer guide!"
msgstr ""

#. ja: さて、あなたの部屋だが……<br>クリスタリウムにいくつかある居住地のうち、<br>「ペンダント居住館」に、ちょうどいい空きがあったはずだ。
#. de: Jetzt fehlt dir nur noch ein Zimmer. In den Isomorph-Quartieren, einem von Crystariums Wohngebieten, habe ich ein angemessenes Plätzchen für dich gefunden.
#. fr: Cristarium abrite plusieurs quartiers résidentiels, et il me semble qu'il y a justement une chambre libre aux Pendants.
#. speaker: MYSTERYVOICE
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_MYSTERYVOICE_000_030:1"
msgid "The Crystarium boasts a number of residential districts, but I have been informed that a room has just become available at the Pendants."
msgstr ""

#. ja: そこへ案内するとなると、市場の近くを通ることになるから、<br>念のため、再度それも紹介しよう。<br>……こちらへ。
#. de: Der Weg dorthin führt am Markt vorbei. Dort warst du zwar bereits, aber lass mich dir dennoch ein paar Dinge erklären. Bitte, folge mir einfach.
#. fr: Oui, c'est bien ça. En nous y rendant, nous allons traverser les marchés, donc j'en profiterai pour t'en toucher deux mots. Allons-y.
#. speaker: MYSTERYVOICE
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_MYSTERYVOICE_000_031:1"
msgid "Which, as it turns out, is perfect. Our path there will take us past the markets, and I was hoping to give you my own introduction to their wares. Come along."
msgstr ""

#. ja: フェオ＝ウルと契約したことで、<br>レターモーグリ、マーケットボード、リテイナーベルが、<br>第一世界からも利用できるようになりました！
#. de: Dank deines Vertrags mit Feo Ul kannst du nun Mogry-Postboten, Marktbretter und Krämerklingeln in der ersten Splitter<shy>welt benutzen!
#. fr: Vous avez passé un pacte avec Feo Ul<nbsp>! Vous pouvez désormais accéder au Mog postier, aux tableaux des ventes et aux sonnettes depuis le premier reflet.
#. speaker: SYSTEM
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_SYSTEM_000_035:1"
msgid "As a result of your pact with Feo Ul, you now have access to delivery moogles, market boards, and summoning bells while in the First."
msgstr ""

#. ja: おお、もしやあなたが……？
#. de: Willkommen in den Isomorph-Quartieren, <if $gn4>meine Dame<else>mein Herr</if>. Seid Ihr in Begleitung des Kristall<shy>exarchen?
#. fr: Bienvenue aux Pendants, <if $gn4>Madame<else>Monsieur</if>. Seriez-vous l'<if $gn4>invitée<else>invité</if> de l'exarque...<nbsp>?
#. speaker: GUIDEOFTHEPENDANTS
#. macro: <if $gn4>miss<else>sir</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_GUIDEOFTHEPENDANTS_000_040:1"
msgid "Welcome to the Pendants, <if $gn4>miss<else>sir</if>. You're here with the Exarch...?"
msgstr ""

#. ja: ああ、ちょうど部屋の確認もできたところだ。<br>あなた用に一室確保できたので、<br>今後はそこを、私室として自由に使ってもらって構わない。
#. de: Ah, da bist du ja. Dein Zimmer ist auch so weit, ich habe mich eben selbst davon überzeugt. Es steht dir zur freien Verfügung, du kannst also kommen und gehen, wie es dir beliebt.
#. fr: Ah, te voilà<nbsp>! Je réglais les derniers détails de ton hébergement. Tu auras ta propre chambre pendant toute la durée de ton séjour à Cristarium, donc fais-en usage comme il te plaira.
#. speaker: MYSTERYVOICE
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_MYSTERYVOICE_000_050:1"
msgid "Ah, there you are─I was just finalizing the matter of your accommodation. You'll have a private room here at the Pendants for the duration of your stay, to make use of as you see fit."
msgstr ""

#. ja: 部屋までは、管理人の彼が連れて行ってくれる。<br>そこで休んで、旅支度を整えたのちに、<br>さきほどの「星見の間」でまた会おう。
#. de: Der Verwalter hier bringt dich auf dein Zimmer. Gönne dir eine Pause, erhole dich von der weiten, seltsamen Reise. Und wenn du so weit bist, bitte ich dich, mich wieder im Okular aufzusuchen.
#. fr: Pour t'y rendre, il te suffira de parler à l'intendant des Pendants. Prends tout le temps qu'il faudra pour te reposer et nous parlerons à L'Observatoire lorsque tu auras suf<shy>fi<shy>sam<shy>ment récupéré.
#. speaker: MYSTERYVOICE
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_MYSTERYVOICE_000_051:1"
msgid "When you are ready to retire, the manager will show you to your lodgings. Pray rest and recuperate, and we shall reconvene in the Ocular anon."
msgstr ""

#. ja: それでは、私はこれで…………
#. de: Gut, das wäre dann fürs Erste alles. Obwohl<nbsp>...
#. fr: Très bien, je crois que c'est tout pour le moment...
#. speaker: MYSTERYVOICE
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_MYSTERYVOICE_000_052:1"
msgid "I believe that covers all of the practical concerns..."
msgstr ""

#. ja: …………<split " " 1><string $gs1></split>。<br>こちらへ来てくれて、本当にありがとう。<br>夜は来ずとも、あなたに安息があらんことを。
#. de: <split " " 1><string $gs1></split><nbsp>... Ich finde keine Worte, um dir zu sagen, <i>wie</i> dankbar ich dir bin. Dass du meinem Ruf gefolgt und hierher<shy>ge<shy>kommen bist<nbsp>... Von Herzen wünsche ich mir, dass du auch ohne die Dunkelheit der Nacht ein wenig Ruhe finden kannst.
#. fr: ... Merci d'avoir répondu à mon appel, <split " " 1><string $gs1></split>. Même si je ne puis t'offrir la quiétude d'une nuit noire, j'espère que tu feras quand même de beaux rêves.
#. speaker: MYSTERYVOICE
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_MYSTERYVOICE_000_053:1"
msgid "...Thank you for answering my call, <split \" \" 1><string $gs1></split>. We are denied the comforting blanket of night, but may peaceful dreams attend you nonetheless."
msgstr ""

#. ja: はじめまして。<br>私は、このペンダント居住館の管理人をしております。
#. de: Sehr erfreut, Eure Bekanntschaft zu machen. Ich bin der Verwalter der Isomorph-Quartiere.
#. fr: Ravi de vous rencontrer, <if $gn4>Madame<else>Monsieur</if>, et bienvenue dans votre nouveau foyer aux Pendants.
#. speaker: GUIDEOFTHEPENDANTS
#. macro: <if $gn4>miss<else>sir</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_GUIDEOFTHEPENDANTS_000_060:1"
msgid "A pleasure to meet you, <if $gn4>miss<else>sir</if>, and welcome to your new home at the Pendants."
msgstr ""

#. ja: 部屋の支度はすぐに整いますが、<br>このままお休みになられますか？
#. de: Die Unterkunft ist sofort beziehbar. Soll ich Euch schon zu Eurem Zimmer bringen?
#. fr: Votre chambre est prête, vous pouvez en profiter im<shy>mé<shy>dia<shy>te<shy>ment si vous le désirez.
#. speaker: GUIDEOFTHEPENDANTS
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_GUIDEOFTHEPENDANTS_000_061:1"
msgid "Your room is ready, if you'd care to retire?"
msgstr ""

#. ja: 「居室」で休みますか？
#. de: Auf dein Zimmer zurückziehen?
#. fr: Aller dans votre chambre<nbsp>?
#. speaker: Q3
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_Q3_000_062:1"
msgid "Retire to your quarters?"
msgstr ""

#. ja: <split " " 1><string $gs1></split>殿、お話は伺っております！<br>中にお入りになられますか？
#. de: Ah, <split " " 1><string $gs1></split>! Der Kristall<shy>exarch erwartet dich.
#. fr: <if $gn4>Madame<else>Monsieur</if> <split " " 1><string $gs1></split>. L'exarque vous attend à l'intérieur.
#. speaker: CRYSTALGATEKEEPER
#. macro: <if $gn4>Mistress<else>Master</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_CRYSTALGATEKEEPER_000_070:1"
msgid "<if $gn4>Mistress<else>Master</if> <split \" \" 1><string $gs1></split>. The Exarch awaits you within."
msgstr ""

#. ja: 「星見の間」に移動しますか？
#. de: Das Okular betreten?
#. fr: Entrer dans L'Observatoire<nbsp>?
#. speaker: Q4
msgctxt "quest/032/LucKma103_03281:TEXT_LUCKMA103_03281_Q4_000_071:1"
msgid "Enter the Ocular?"
msgstr ""
