msgctxt "quest/032/FesGsc301_03207:TEXT_FESGSC301_03207_SYSTEM_000_094:1"
msgid "You have learned the emote <ui-color 500><ui-edge-color 501>Senor Sabotender</ui-edge-color></ui-color>!"
msgstr "Вы выучили эмоцию «<ui-color 500><ui-edge-color 501>Сеньор Саботендер</ui-edge-color></ui-color>»!"
