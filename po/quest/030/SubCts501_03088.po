msgctxt "quest/030/SubCts501_03088:TEXT_SUBCTS501_03088_WANDERINGMINSTREL_000_011:1"
msgid "Open the <ui-color 500><ui-edge-color 501>Duty Recorder</ui-edge-color></ui-color> interface located under <ui-color 500><ui-edge-color 501>Duty</ui-edge-color></ui-color> in the main menu, and view the help text for further details on how to use this feature."
msgstr ""
