# quest/021/BanVan203_02183 — « Fishing in Troubled Waters» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
