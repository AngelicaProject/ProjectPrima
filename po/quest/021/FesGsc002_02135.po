msgctxt "quest/021/FesGsc002_02135:TEXT_FESGSC002_02135_SYSTEM_000_011:1"
msgid "You have learned the emote <ui-color 500><ui-edge-color 501>Eureka</ui-edge-color></ui-color>!"
msgstr "Вы выучили эмоцию <ui-color 500><ui-edge-color 501>Эврика</ui-edge-color></ui-color>!"
