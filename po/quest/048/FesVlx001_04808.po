msgctxt "quest/048/FesVlx001_04808:TEXT_FESVLX001_04808_SYSTEM_000_050:1"
msgid "You have learned the emote <ui-color 500><ui-edge-color 501>Love Heart</ui-edge-color></ui-color>!"
msgstr "Вы выучили эмоцию <ui-color 500><ui-edge-color 501>Сердечко</ui-edge-color></ui-color>!"
