msgctxt "quest/048/KinGbb101_04848:TEXT_KINGBB101_04848_SYSTEM_000_902:1"
msgid "A button for the Gear Set interface is located in the upper portion of the <ui-color 500><ui-edge-color 501>Character</ui-edge-color></ui-color> window."
msgstr "Кнопка интерфейса наборов экипировки находится в верхней части окна <ui-color 500><ui-edge-color 501>«Персонаж»</ui-edge-color></ui-color>."
