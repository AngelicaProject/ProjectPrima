# quest/048/KinGmb105_04884 — «The Shape of Peace» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: ヴォロク連王宮のウクラマトは、皆と合流したいようだ。
#. de: Wuk Lamat will ihre Gruppe wieder zusammentrommeln.
#. fr: Wuk Lamat n'a pas l'intention de sauter le moindre repas.
#. kind: journal
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_SEQ_00:1"
msgid "Wuk Lamat thinks it time to gather her allies for the road ahead."
msgstr ""

#. ja: <sheet EObj 2013605 0>で待機
#. de: Am <noun-de EObj 5 2013605 1 3 1> warten
#. fr: Attendre à l'endroit indiqué
#. kind: objective
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_TODO_00:1"
msgid "Wait at the designated location."
msgstr ""

#. ja: コザマル・カに向かう
#. de: Nach Kozama'uka aufbrechen
#. fr: Aller à Kozama'uka
#. kind: objective
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_TODO_01:1"
msgid "Travel to Kozama'uka."
msgstr ""

#. ja: ウクラマトと話す
#. de: Mit Wuk Lamat sprechen
#. fr: Parler à Wuk Lamat
#. kind: objective
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_TODO_02:1"
msgid "Speak with Wuk Lamat."
msgstr ""

#. ja: ウクラマトと再度話す
#. de: Noch einmal mit Wuk Lamat sprechen
#. fr: Reparler à Wuk Lamat
#. kind: objective
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_TODO_03:1"
msgid "Speak with Wuk Lamat again."
msgstr ""

#. ja: <sheet EObj 2013606 0>で待機する
#. de: Am <noun-de EObj 5 2013606 1 3 1> warten
#. fr: Attendre à l'endroit indiqué
#. kind: objective
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_TODO_04:1"
msgid "Wait at the designated location."
msgstr ""

#. ja: <sheet EObj 2013606 0>で再度待機する
#. de: Noch einmal am <noun-de EObj 5 2013606 1 3 1> warten
#. fr: Attendre à nouveau à l'endroit indiqué
#. kind: objective
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_TODO_05:1"
msgid "Wait at the designated location again."
msgstr ""

#. ja: <sheet EObj 2013606 0>でさらに待機する
#. de: Ein weiteres Mal am <noun-de EObj 5 2013606 1 3 1> warten
#. fr: Attendre encore une fois à l'endroit indiqué
#. kind: objective
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_TODO_06:1"
msgid "Wait at the designated location once more."
msgstr ""

#. ja: レディロクと話す
#. de: Mit Rediroq sprechen
#. fr: Parler à Rediroq
#. kind: objective
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_TODO_07:1"
msgid "Speak with Rediroq."
msgstr ""

#. ja: アタシは、オヤジのせいで食いっぱぐれた、<br>ナミーカのメシを食ってから行くぜ。
#. de: Bah, mein Alterchen hat mir wirklich die Laune verdorben. Nur Namikkas köstliches Essen kann mir jetzt noch helfen.
#. fr: Dis-toi que j'ai même pas eu le temps de grailler avec ces bêtises... Faut que je passe voir Namikka avant qu'on reprenne notre route.
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_001:1"
msgid "I still haven't had one bite of Namikka's food thanks to Papa's nonsense, so I'm going back to finish my plate before I head out."
msgstr ""

#. ja: みんなとは、フォルアード・キャビンズで合流する手はずだ。<br>さっきの手合わせで疲れてるようなら、急がなくていいからな。
#. de: Brechen wir auf, nachdem ich mir eine Portion gegönnt habe. Am besten treffen wir uns an den Kielkajüten. Aber ruh dich nochmal ordentlich aus, ja? Mein Alterchen hat dir ja sicherlich zugesetzt.
#. fr: On aura qu'à se retrouver aux Cabines de Proue avec tout le monde. Ça te laisse le temps de souffler un peu après ton combat contre papa<nbsp>!
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_002:1"
msgid "I've otherwise asked everyone to meet at the For'ard Cabins. Come and join us after you've had a moment to recover, eh?"
msgstr ""

#. ja: まったく……我が親ながら、困ったオヤジだぜ。
#. de: Was hat er sich nur dabei gedacht?
#. fr: Décidément, mon paternel se refait pas. Incapable de rester tranquille cinq minutes...
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_003:1"
msgid "Dammit, Papa..."
msgstr ""

#. ja: 仲間たちと合流しますか？
#. de: Möchtest du dich mit deiner Gruppe treffen?
#. fr: Patienter jusqu'à l'arrivée de vos alliés<nbsp>?
#. speaker: Q1
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_Q1_000_000:1"
msgid "Await your companions and continue with the rite of succession?"
msgstr ""

#. ja: お待たせしました。
#. de: Da bin ich. Hoffentlich habe ich Euch nicht zu lange warten lassen.
#. fr: Navré de vous avoir fait attendre.
#. speaker: FONJEANTAINE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_FONJEANTAINE_000_006:1"
msgid "Sorry to keep everyone waiting."
msgstr ""

#. ja: もういいのか？
#. de: Nicht doch. Ist das etwa dein ganzes Gepäck?
#. fr: Alors, prêt pour le grand départ<nbsp>?
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_007:1"
msgid "Is that it? You're all set to go?"
msgstr ""

#. ja: もともと働き口を探してエオルゼアから出てきたわけですから、<br>身軽なものですよ。<br>お世話になった方々に挨拶していたら、遅くなりましたが。
#. de: Es ist ja noch nicht lange her, seitdem ich aus Eorzea übergesetzt habe. Und für diese Reise hatte ich schon leicht gepackt. In erster Linie bin ich spät dran, weil ich mich noch von allen verabschieden wollte.
#. fr: Oui. Comme j'avais quitté Éorzéa dans l'optique de refaire ma vie, je n'ai quasiment pas de bagages. En revanche, j'avais beaucoup de collègues à saluer avant de partir.
#. speaker: FONJEANTAINE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_FONJEANTAINE_000_008:1"
msgid "I left Eorzea prepared to travel in search of work, so I had few belongings to begin with. Bidding farewell to my fellow artisans took rather a lot of time, however."
msgstr ""

#. ja: そうか……。<br>改めてありがとな、フォンジャンテーン。
#. de: Verstehe. Danke, dass du das alles auf dich nimmst, Fonjeantaine.
#. fr: Je vois... Merci encore pour ton dévouement, Fonjeantaine.
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_009:1"
msgid "Again, I appreciate you making this commitment, Fonjeantaine."
msgstr ""

#. ja: では、アースンシャイアに戻るとしよう。
#. de: Also dann, zurück nach Irdehalde.
#. fr: Il ne nous reste plus qu'à retourner à La Fournée.
#. speaker: ALPHINAUD
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALPHINAUD_000_010:1"
msgid "Shall we depart for Earthenshire, then?"
msgstr ""

#. ja: (-？？？？-)待ちたまえ。
#. de: (-???-)Moment.
#. fr: (-???-)Attendez<nbsp>!
#. speaker: WUKEVU
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKEVU_000_011:1"
msgid "(-???-)A word before you go."
msgstr ""

#. ja: お、ウケブじゃねぇか。
#. de: Wuk Evu! Was treibst du denn hier?
#. fr: Ah, Wuk Evu. Salut.
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_012:1"
msgid "Wuk Evu, what are you doing here?"
msgstr ""

#. ja: ハッ！<br>このウケブ、常日頃から礼儀を語っておきながら、<br>無礼にも王女を呼び止めるなどという狼藉を……！！
#. de: Ah! Da rede ich den ganzen Tag von Manieren und Etikette, und besitze dann die Dreistigkeit, die Prinzessin höchstselbst mit einem rüpelhaften <i>Moment</i> aufzuhalten!
#. fr: Diantre<nbsp>! Moi qui ne cesse de prêcher la politesse, j'ai eu l'outrecuidance d'user de l'impératif à l'encontre d'une princesse de votre stature<nbsp>! Honte sur moi<nbsp>!
#. speaker: WUKEVU
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKEVU_000_013:1"
msgid "Ahhh! I spend my days correcting manners, and here I am perpetrating the grave offense of delaying the Third Promise's departure!"
msgstr ""

#. ja: かくなる上は、その斧で私を、<br>タコス・カルネアサーダの具のように叩き斬ってください！
#. de: Ich bitte Euch ein weiteres Mal, Eure königliche Hoheit<nbsp>- schlitzt mich auf, vom unwürdigen Kopf bis zum unwürdigen Fuße, auf dass mein Inneres aus mir herausquelle wie die Füllung aus einem frisch zubereiteten Taco!
#. fr: Je ne vois qu'une issue possible à cette avanie<nbsp>: tranchez-moi la tête avec votre hache<nbsp>! Faites-en de la farce pour <i>taco de carne asada</i><nbsp>!
#. speaker: WUKEVU
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKEVU_000_014:1"
msgid "Please, take up your axe and rend my flesh unto taco meat!"
msgstr ""

#. ja: 要求が、いちいち生々しいなぁ！<br>それと、無礼だとか気にすんなって言ってんだろ！！
#. de: Was<nbsp>... Iiieeeh, das wird ja immer schlimmer mit dir! Hör auf, verdammt nochmal, immerzu solche Sachen zu sagen!
#. fr: Non merci, le gore, c'est pas mon truc<nbsp>! Puis je t'ai déjà dit d'arrêter de nous bassiner avec l'étiquette<nbsp>!
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_015:1"
msgid "Must your demands be so gruesome!? Besides, I told you that kind of thing doesn't bother me!"
msgstr ""

#. ja: そうですか、では気にしません。
#. de: In Ordnung.
#. fr: Ah... Tant mieux alors.
#. speaker: WUKEVU
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKEVU_000_016:1"
msgid "All right, then. I won't let it bother me either."
msgstr ""

#. ja: 何なの、この切り替えの早さ……。
#. de: Da hat er sich mal wieder schnell beruhigt.
#. fr: Ce type est com<shy>plè<shy>te<shy>ment lunatique...
#. speaker: ALISAIE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALISAIE_000_017:1"
msgid "What was that all about...?"
msgstr ""

#. ja: 素材の買付けにきたところで、お見かけしましてな。<br>ときにウクラマト王女、黄金郷をお探しというのは本当で？
#. de: Mir fiel Eure Gruppe ins Auge, als ich auf dem Markt nach Materialien stöberte. Ist es wahr, dass Ihr die Stadt aus Gold sucht?
#. fr: Je venais me procurer des matériaux lorsque je vous ai aperçue. Dites, c'est vrai, ce qu'on raconte<nbsp>? Vous vous êtes lancée en quête de la légendaire cité d'or<nbsp>?
#. speaker: WUKEVU
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKEVU_000_018:1"
msgid "I'd come to the city to purchase supplies when I spotted your entourage getting ready to leave. You seek the city of gold, if I'm not mistaken?"
msgstr ""

#. ja: ああ、継承の儀の最終目標だからな。<br>なにか知ってることがあれば、教えてくれよ。
#. de: Ja, schon. Das ist die letzte Aufgabe des Ritus der Thronfolge. Weißt du vielleicht etwas darüber, Wuk Evu?
#. fr: Le paternel a décidé que ce serait l'objectif ultime du rite de succession, alors j'ai pas trop le choix... D'ailleurs, si t'as le moindre indice à ce sujet, je suis preneuse.
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_019:1"
msgid "That's right─it's the final step of the rite of succession. If you know anything about the subject, I'd love to hear it."
msgstr ""

#. ja: それでは、ひとつ講釈を。<br>ご存知のとおり黄金郷とはトラル大陸において、<br>千年の昔から囁かれる伝説の地……。
#. de: Nun, lasst mich eine Sache dazu sagen. Wie Ihr zweifelsohne wisst, ist die Stadt aus Gold eine uralte Legende, von der man sich auf ganz Tural erzählt<nbsp>...
#. fr: Ah, vous voulez un petit exposé<nbsp>? Avec plaisir. Laissez-moi donc vous présenter la légende de la cité d'or<nbsp>; une légende qui, comme vous le savez sans doute déjà, se transmet depuis plus d'un millénaire à travers le Tural...
#. speaker: WUKEVU
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKEVU_000_020:1"
msgid "Then allow me to be of service. As you know, legends of the golden city have been passed down in Tural for a thousand years."
msgstr ""

#. ja: ところが、どんな場所なのかは諸説あり判然としない。<br>文字通りに黄金の建物が並ぶ都だとする説もあれば、<br>秘宝の在り処とも語られている。
#. de: Allerdings sind die Spekulationen, was genau für ein Ort sie ist, schier endlos. Einige behaupten, dass es ganz wörtlich eine Stadt voller güldener Bauten ist, wieder andere sind sich sicher, dass es sich um eine Stadt reich an Schätzen handelt.
#. fr: Fait remarquable, la nature de la cité elle-même ne fait pas consensus. D'aucuns pensent qu'il s'agit lit<shy>té<shy>ra<shy>le<shy>ment d'une ville aux immeubles dorés, quand d'autres parlent d'un lieu abritant un grand trésor.
#. speaker: WUKEVU
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKEVU_000_021:1"
msgid "Yet when it comes to describing the place itself, the stories do not always agree. Some portray it as one might expect: a glittering metropolis of golden towers. Others suggest it is more unassuming and owes the name to a fabulous treasure hidden at its heart."
msgstr ""

#. ja: なぜなら、黄金郷を探しに行った者たちは、<br>誰ひとりとして生きて帰ってはこないから……。
#. de: Und Ihr seid sicher auch mit dem anderen Satz vertraut, der im Kontext der Stadt aus Gold gerne fällt: Jene, die nach der Stadt aus Gold suchen, werden nicht lebend wiederkehren. Also gibt es auch keine Antwort auf die Frage, <i>was</i> sie letztlich ist.
#. fr: Et pour cause, on raconte que de tous les courageux Turaliens partis à sa recherche, aucun n'est revenu vivant...
#. speaker: WUKEVU
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKEVU_000_022:1"
msgid "Every telling, however, has a common thread: those who go in search of the golden city do not return."
msgstr ""

#. ja: つまりは、探索にすら相応の危険が伴うということ。<br>どうかくれぐれも警戒を怠りませんように……。
#. de: Und extra betonen, wie gefährlich dieses Unterfangen ist, muss ich damit auch nicht mehr. Prinzessin<nbsp>... Bitte gebt gut auf Euch Acht.
#. fr: Le chemin jusqu'à elle serait en effet parsemé de dangers mortels. Aussi, je vous invite à exercer vous-même la plus grande prudence durant votre quête. 
#. speaker: WUKEVU
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKEVU_000_023:1"
msgid "The lesson to be learned from this, Third Promise, is that to seek the legend is to court death. I must implore you to proceed with the utmost care."
msgstr ""

#. ja: 伝えたかったことは以上です。<br>王女、旅の無事を祈っておりますよ。
#. de: Mehr wollte ich auch gar nicht sagen. Kehrt heil zu uns zurück.
#. fr: C'est tout ce que je peux vous dire sur ce sujet. Il ne me reste plus qu'à vous souhaiter bonne chance pour la suite de votre périple.
#. speaker: WUKEVU
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKEVU_000_024:1"
msgid "That is all I wished to say. I shall pray for your safe journey."
msgstr ""

#. ja: ああ。<br>ありがとよ、ウケブ。
#. de: Das werde ich. Danke, Wuk Evu.
#. fr: Merci, Wuk Evu.
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_025:1"
msgid "Thank you, Wuk Evu."
msgstr ""

#. ja: 黄金郷を探しに行った者は、誰も生きて帰らなかった、か。<br>徒労に終わる冒険に出ることを諫めるための訓話にも思えるが、<br>そんな場所を、連王はどうやって見つけたんだか……。
#. de: Niemand ist also je zurückgekehrt<nbsp>... Es klingt wie ein Volksmärchen, um Leute von einem waghalsigen Unterfangen abzuhalten, das zu nichts führen wird. Aber wie hat der Dämmerkönig diese Stadt dann gefunden?
#. fr: Donc, tous ceux partis à la recherche de la cité d'or sont morts... À moins que ce ne soit un racontar colporté à dessein, pour dissuader le peuple de s'engager dans une quête vaine<nbsp>; un racontar que Gulool Ja Ja a lui-même contredit...
#. speaker: ERENVILLE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ERENVILLE_000_026:1"
msgid "What are we to make of these cautionary tales? If every expedition has ended in tragedy, how then did the Dawnservant find the city and return without incident?"
msgstr ""

#. ja: やっぱり、伝承の出処だという、<br>ヨカフイ族から情報を引き出したいところね。
#. de: Ich persönlich würde gerne die Yok Huy fragen. Sie sind schließlich der Ursprung dieser Legende.
#. fr: Il me tarde de pouvoir interroger les Yok Huy<nbsp>; d'après ce que j'ai compris, la légende serait née au sein de leur clan. 
#. speaker: KRILE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KRILE_000_027:1"
msgid "It seems the legend originated with the Yok Huy. Speaking with them remains our strongest lead, I feel."
msgstr ""

#. ja: 黄金郷のことは気になるが、<br>何にしても、まずは「壺の試練」を超えなければ。<br>フォンジャンテーン殿を連れて、アースンシャイアに戻ろう。
#. de: So spannend, wie die Stadt aus Gold auch ist, sollten wir uns für den Moment auf unsere Prüfung konzentrieren. Kommt, kehren wir nach Irdehalde zurück.
#. fr: On aura tout le loisir de se pencher sur ces mystères une fois l'épreuve du pot réussie. Ne perdons pas de temps et amenons Fonjeantaine à La Fournée.
#. speaker: ALPHINAUD
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALPHINAUD_000_028:1"
msgid "A lead we shall follow in time. But first, let us see Fonjeantaine safely into the Moblins' care."
msgstr ""

#. ja: よう、待たせたな。<br>壺匠になってくれる奴を連れてきたぜ。<br>外つ国の有名な宝飾店、「エシュテム」で働いてた腕利きだ。
#. de: Da sind wir wieder. Und wir haben einen Handwerker dabei, der gerne einen Topfpakt mit euch eingehen möchte! Außerdem kommt Fonjeantaine von jenseits der See und hat dort in einer furchtbar berühmten Goldschmiede gearbeitet.
#. fr: Ça m'a pris un peu de temps, mais je vous ai déniché une main-du-pot, et une bonne<nbsp>! Elle a notamment bossé pour les Joyaux d'Eshtaime, une enseigne étrangère réputée.
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_030:1"
msgid "We're back, and we've brought with us a willing potsworn. This is Fonjeantaine, a talented goldsmith who once worked at Eshtaime's Aesthetics in Ul'dah."
msgstr ""

#. ja: あっぱれ　お見事　すばらしい！<br>ウクラマト王女が　一番乗り！
#. de: Fshkhooo, das ist Großwunder! Und außerdem seid Ihr damit die erste unter den Kandidaten, Prinzessin!
#. fr: Magnifique<nbsp>! Formidable<nbsp>! Mirifique<nbsp>! La princesse est la première à s'aqquitter de sa mission avec brio<nbsp>!
#. speaker: REDIROQ
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_REDIROQ_000_031:1"
msgid "Wonderful! Impressive! You are first to return, Third Promise!"
msgstr ""

#. ja: 外つ国　職人　珍しい！<br>知らない技に　知らないセンス　とてとてたくさん　持ってそう！<br>さっそく案内　新たな工房　歓迎　優待　いらっしゃ～い！
#. de: Lieber Topfwerker! Herzwillkommen! Und noch dazu einer von Jenseitssee! Oh, da freuen wir uns aber auf mannigfaltiges Neuwissen! Schnell, schnell, wir zeigen dir neue Schaffstatt!
#. fr: Une main-du-pot venue d'un autre pays, c'est rare<nbsp>! Les gentils Mobelins ont hâte de déqouvrir ses teqhniques et sa patte artistique<nbsp>! Ils vont tout de suite lui présenter son nouveau lieu de travail<nbsp>!
#. speaker: REDIROQ
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_REDIROQ_000_032:1"
msgid "And with an artisan from across the salt, no less! We welcome you and your unique skills to Earthenshire. Helphand will show you to the Workpot."
msgstr ""

#. ja: それでは、僕はこれで……。<br>絶対、王様になってくださいね！
#. de: Hier trennen sich unsere Wege wohl. Viel Glück mit dem Rest des Ritus! Ich glaube an Euch, Prinzessin!
#. fr: C'est ici que je vous quitte, on dirait. Battez-vous de toutes vos forces, et devenez Aurarque pour moi, d'accord<nbsp>?
#. speaker: FONJEANTAINE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_FONJEANTAINE_100_032:1"
msgid "This is it, then. I look forward to hearing you proclaimed Dawnservant!"
msgstr ""

#. ja: ありがとよ、フォンジャンテーン。<br>お前の想い、絶対に応えてみせるぜ。
#. de: Vielen Dank, Fonjeantaine! Ich werde deinen Wunsch nach Frieden nicht enttäuschen, das verspreche ich dir!
#. fr: Merci pour tout, Fonjeantaine. Je ferai en sorte de pas te décevoir.
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_033:1"
msgid "Thank you, Fonjeantaine. I'll be sure not to disappoint you."
msgstr ""

#. ja: ではでは　モブたち　壺の試練！<br>超えたあなたに　秘石を進呈！
#. de: Also gut, Prinzessin, Ihr habt die Topfprüfung erfolgreich bestanden! Hiermit verleihe ich Euch unseren Prüfstein.
#. fr: La princesse a franchi avec suqcès l'épreuve du pot<nbsp>! Elle a donq mérité de recevoir une gemme<nbsp>!
#. speaker: REDIROQ
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_REDIROQ_000_034:1"
msgid "You have reachmet the requirements of the Feat of Pots. Rediroq presents your keystone with joysmiles and wellwishing!"
msgstr ""

#. ja: よし、これで3つ目だ……！
#. de: Das ist dann der dritte!
#. fr: Et hop<nbsp>! Ça m'en fait trois<nbsp>!
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_035:1"
msgid "That makes three..."
msgstr ""

#. ja: フゴォ……フゴォ……<br>ほかにも来たの　壺匠！？<br>みんなまとめて　お話聞かせて！
#. de: Fshkhooo ... Noch mehr Topfwerker! Frohnachricht! Vieleglück!
#. fr: Bssshh... Oh là là... Toutes ces mains-du-pot qui arrivent d'un qoup... C'est la fête au village<nbsp>! Que les qandidats se rassurent, il y aura des gemmes pour tout le monde<nbsp>!
#. speaker: REDIROQ
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_REDIROQ_000_036:1"
msgid "Pfff... Pfffkohhh... More potsworn candidates!? Come, come, tell Rediroq your tales!"
msgstr ""

#. ja: ハヌハヌ族とペルペル族に続いて、<br>モブリン族の秘石も手に入りました。<br>今のところは順調ですね。
#. de: Nach den Hanuhanu und den Pelupelu haben wir jetzt auch noch den Prüfstein der Moblins bekommen. Bislang läuft der Ritus sehr gut für uns.
#. fr: D'abord la gemme des Hanu Hanu, puis celle des Pelupelu, et maintenant celle des Mobelins. Jusqu'à présent, on peut se targuer d'un parcours sans fautes.
#. speaker: KOANA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KOANA_000_037:1"
msgid "Another feat accomplished, another keystone acquired."
msgstr ""

#. ja: ホッホッホ。<br>さすがはゾラージャ様のご弟妹。<br>よく食らいついておられる。
#. de: Hohoho. Ganz wie erwartet von den Geschwistern des Ersten Prinzen.
#. fr: Ho ho ho. Pour l'instant, il semblerait que la fratrie royale se montre à la hauteur, ja<nbsp>; y compris sa partie adoptive.
#. speaker: SAREELJA
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_SAREELJA_000_038:1"
msgid "Ohohoho, you <i>are</i> doing well. I expected nothing less of Zoraal Ja's esteemed siblings."
msgstr ""

#. ja: とくに弟君の賢さときたら！<br>海向こうにて学んできた知識を活かし、<br>魔導兵器の導入にご尽力いただきたいものですなぁ。
#. de: Insbesondere der Zweite Prinz überzeugt mit seinem scharfen Verstand. Wir hoffen doch sehr, dass er sein mannigfaltiges Wissen und seine Kenntnisse fremder Technologien dazu nutzen wird, magische Waffen zu entwickeln.
#. fr: Je pense notamment à vous, jeune Prince Koana, et à votre incroyable érudition<nbsp>! Votre con<shy>nais<shy>san<shy>ce des technologies étrangères, et surtout de leur application dans le domaine militaire, pourrait cer<shy>tai<shy>ne<shy>ment être mise à con<shy>tri<shy>bu<shy>tion...
#. speaker: SAREELJA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_SAREELJA_000_039:1"
msgid "Your cleverness in particular is most admirable, Second Promise. We must have you apply that Sharlayan knowledge you so cherish, and arm Tural with weapons of magitek design."
msgstr ""

#. ja: ゾラージャ王の、重臣として……。
#. de: ... Als Staatsdiener von Dämmerkönig Zoraal Ja.
#. fr: Vous feriez un excellent vassal à votre frère, ja...
#. speaker: SAREELJA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_SAREELJA_000_040:1"
msgid "...In your role as the new Dawnservant's chief advisor, of course."
msgstr ""

#. ja: 僕は戦争には興味がありません。<br>シャーレアンで学んだ技術で、この国を発展させたいだけです。
#. de: Kriegsführung liegt nicht in meinem Interessengebiet, verzeiht. Alles, was ich mir in Sharlayan angeeignet habe, wird einzig zum Wohle dieses Landes eingesetzt werden.
#. fr: La guerre ne m'intéresse pas. Si je dois mettre à profit la technologie sharlayanaise, ce sera pour accélérer le développement de ce pays.
#. speaker: KOANA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KOANA_000_041:1"
msgid "The tools of war hold no interest for me. I wish only to improve our nation through practical innovations."
msgstr ""

#. ja: トライヨラが技術的に優れた国だと知れ渡れば、<br>外つ国から一目置かれるようになるでしょう。
#. de: Und sobald wir als technologisch fortschrittliche Nation wahrgenommen werden, schwindet auch die Gefahr einer Invasion seitens fremdländischer Aggressoren.
#. fr: Si le Tuliyollal acquiert une réputation de nation technologiquement avancée, le regard qu'on lui porte à l'étranger changera du tout au tout.
#. speaker: KOANA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KOANA_000_042:1"
msgid "Foreign powers will think twice about testing our strength once Tuliyollal is known for its advanced technology."
msgstr ""

#. ja: そうすれば、わざわざ戦うこともなくなる……<br>シャーレアンがガレマール帝国に侵略されなかったようにね。
#. de: Auf diese Weise kann Krieg gänzlich vermieden werden. So wurde auch Sharlayan nie vom Garleischen Kaiserreich angegriffen.
#. fr: Il y aura à terme un fort effet dissuasif, aussi vrai que l'empire de Garlemald s'est gardé d'attaquer Sharlayan.
#. speaker: KOANA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KOANA_000_043:1"
msgid "Just as the Garlean Empire was deterred from invading Sharlayan."
msgstr ""

#. ja: そうおっしゃいますがねぇ……<br>我々がシャーレアンのような技術大国になるまで、<br>いったい何年かかるというのです？
#. de: Und wie lange wird es dauern, bis wir zu Sharlayan aufgeholt haben und eine derart beeindruckende Nation werden, Prinz Koana?
#. fr: C'est bien beau, ce que vous dites, ja... mais à votre avis, combien d'années faudra-t-il pour que le Tuliyollal arrive au niveau d'avancement technologique de Sharlayan<nbsp>?
#. speaker: SAREELJA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_SAREELJA_000_044:1"
msgid "That may well be true... But how long will it take Tuliyollal to progress to this advanced state? How many years?"
msgstr ""

#. ja: 地道に学び続ければ、いずれ……
#. de: Mit stetem Fortschritt und harter Arbeit würde ich sagen, dauert es ...
#. fr: Si le pays mise dès maintenant sur la recherche, alors tôt ou ta...
#. speaker: KOANA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KOANA_000_045:1"
msgid "With a collective commitment to education and hard work, it should not take so very─"
msgstr ""

#. ja: 学ぶなどと、回りくどい。
#. de: Ein unnötiger Umweg.
#. fr: Pourquoi s'inspirer d'une autre nation<nbsp>?
#. speaker: ZORAALJA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ZORAALJA_000_046:1"
msgid "Your way is too slow."
msgstr ""

#. ja: 呑みこんでしまえばいい。<br>シャーレアンごとな。
#. de: Sharlayan wird einfach erobert. Dann sind ihre Technologien ebenfalls unser.
#. fr: Quand on peut simplement la dévorer...
#. speaker: ZORAALJA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ZORAALJA_000_047:1"
msgid "Easier to expand our territory...and swallow Sharlayan whole."
msgstr ""

#. ja: 武力で他国を征服したとしても、<br>やがては反乱が起こり、負の連鎖が続くだけだ。<br>そんな争いを、俺たちはこの目でいくつも見てきた。
#. de: Wenn man ein fremdes Land gewaltsam besetzt, zieht das für gewöhnlich Aufstände nach sich und die Spirale der Gewalt geht weiter und weiter. Glaubt mir, wir haben genug davon selbst erlebt.
#. fr: Soumettre d'autres peuples par la force, c'est encourir le risque d'une future révolte<nbsp>; c'est perpétuer le cycle de la guerre et de la violence. Nous sommes bien placés pour le savoir, croyez-moi.
#. speaker: THANCRED
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_THANCRED_000_048:1"
msgid "Conquer other nations through force of arms, and you're looking at a future of uprisings and bloodshed. Yours wouldn't be the first failed empire."
msgstr ""

#. ja: ならば、戦い続けよう。<br>すべての人々が争いの愚かさを知り、武器を置くその日まで。
#. de: Dann geht auch der Krieg weiter und weiter. Bis jeder Geist die Torheit dieser Gewalt verstanden hat und die Waffen niederlegt.
#. fr: Eh bien allons-y, perpétuons le cycle<nbsp>! Jusqu'à ce que l'absurdité de la guerre et de la violence apparaisse évidente aux yeux de chacun, et que le monde entier décide de déposer les armes.
#. speaker: ZORAALJA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ZORAALJA_000_049:1"
msgid "Then we keep fighting, until the mounting costs convince them to lay down their weapons. Until all have grown tired of loss."
msgstr ""

#. ja: それで誰が笑顔になるっていうんだ！<br>みんなが望む平和が、そんな形をしてるはずないだろ！
#. de: Und wie viel Schmerz wird das kosten?! Das ist nicht der Frieden, den sich unser Volk wünscht!
#. fr: Comment tu veux qu'on vive heureux dans un scénario pareil<nbsp>!? La paix au prix d'un bain de sang<nbsp>!? C'est n'importe quoi<nbsp>!
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_050:1"
msgid "How would such an outcome bring anyone joy!? What you propose is a mockery of peace!"
msgstr ""

#. ja: フゴォ……フゴォ……<br>その言葉　あの日の出来事　思い出す……。
#. de: Fshkhooo ... Diese Worte erinnern mich an Jenetag<nbsp>...
#. fr: Bssshh... Bssshh... Les paroles de la princesse rappellent à Rediroq un vieux souvenir...
#. speaker: REDIROQ
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_REDIROQ_000_051:1"
msgid "Pfff... Pfffkohhh... Rediroq is reminded of days long ago."
msgstr ""

#. ja: トライヨラができる前　壺匠には契約なかった<br>職人無理やりさらって　無理やり働く<br>それが当時の　あたりまえ……。
#. de: Bevor es Tuliyollal gab, gab es auch keine Topfwerkerverträge. Damals entführten wir Leute und zwangen sie zu Vielarbeit<nbsp>- das war Normaltag für uns.
#. fr: C'était avant même la naissance du Tuliyollal. À l'époque, les Mobelins ne signaient pas de qontrat avec les mains-du-pot. Ils les qapturaient, et les forçaient à travailler qontre leur gré. Cela ne choquait personne.
#. speaker: REDIROQ
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_REDIROQ_000_052:1"
msgid "In the time before Tuliyollal, there were no potpacts for the potsworn. It was normal to grabsnatch artisans, and force them to work for Mobbies."
msgstr ""

#. ja: そんなあるとき　やってきた<br>職人家族に頼まれて　グルージャジャがやってきた！
#. de: Und Einestag kam Gulool Ja Ja zu uns. Weil die Familie eines Handwerkers ihn gebeten hatte.
#. fr: Jusqu'à ce qu'un beau jour, un groupe d'ouvriers décide de s'insurger qontre ses maîtres. Il qontaqta Gulool Ja Ja, et lui demanda de devenir le bras armé de sa vindiqte.
#. speaker: REDIROQ
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_REDIROQ_000_053:1"
msgid "Until the day Gulool Ja Ja arrived. The families of the grabsnatched pleaded with him, and so he came to Earthenshire."
msgstr ""

#. ja: モブたち　戦い　得意じゃない<br>退治されるの　覚悟した<br>でもでも　彼は　こう言った！
#. de: Wir sind nicht gut im Hauekampf und dachten, dass die Letztestunde nun geschlagen hätte. Aber dann sagte Gulool Ja Ja Folgendes<nbsp>...
#. fr: Le puissant double-tête et ses alliés arrivèrent au village. Les Mobelins, inaptes à la guerre, s'attendaient à être décimés. Or, leur supposé bourreau n'attaqua point, et tint à la place ce disqours<nbsp>:
#. speaker: REDIROQ
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_REDIROQ_000_054:1"
msgid "Mobbies are not a warmake people. We feared death had come for us, but Gulool Ja Ja just wanted to talk!"
msgstr ""

#. ja: (-理のグルージャジャ-)わたくしたちに戦いの意思はありません。<br>ただ、話をするために来たのです。
#. de: (-Gulool Ja Ja der Weise-)Wir sind nicht hier, um gegen euch zu kämpfen. Wir wollen lediglich mit euch sprechen.
#. fr: (-Gulool Ja Ja, tête de la Raison-)Nous n'avons aucune intention de vous attaquer. Nous sommes simplement venus pour discuter, ja.
#. speaker: GULOOLJAJA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_GULOOLJAJA_000_055:1"
msgid "(-Vow of Reason Gulool Ja Ja-)Be at ease. We are here to trade words, not blows."
msgstr ""

#. ja: (-理のグルージャジャ-)この集落で作られた金細工は、実に素晴らしい。<br>美しい素材に巧みな技が注がれていると、ひと目でわかる。
#. de: (-Gulool Ja Ja der Weise-)Die Goldschmiedearbeiten aus eurem Dorf sind atemberaubend schön. Selbst ein Laie erkennt auf den ersten Blick, mit wie viel Kunst<shy>fer<shy>tig<shy>keit und Hingabe die erlesensten Materialien in wahre Meisterwerke verwandelt worden sind.
#. fr: (-Gulool Ja Ja, tête de la Raison-)Nous tenons d'abord à saluer la qualité de l'orfèvrerie que vous produisez dans ce village. Inutile d'être experts pour deviner que vous exploitez les meilleurs matériaux et savoir-faire qui soient.
#. speaker: GULOOLJAJA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_GULOOLJAJA_000_056:1"
msgid "(-Vow of Reason Gulool Ja Ja-)The goldwork crafted in this village is superb. One can tell at a glance the quality of materials used; the mastery of technique employed."
msgstr ""

#. ja: (-理のグルージャジャ-)しかし、決して心は震えません。<br>脅された職人たちが、顔を強張らせて作った品で、<br>誰が笑顔になるというのでしょう？
#. de: (-Gulool Ja Ja der Weise-)Und doch lassen sie einem den Atem stocken, vor allem aus Mitleid. Niemand kann sich aufrichtig an einem Werk erfreuen, das von unfreien Händen geschaffen wurde.
#. fr: (-Gulool Ja Ja, tête de la Raison-)Pour autant, vos créations nous ont toujours laissés de marbre. Car après tout, comment des objets fabriqués sous la contrainte pourraient apporter de la joie à qui que ce soit<nbsp>?
#. speaker: GULOOLJAJA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_GULOOLJAJA_000_057:1"
msgid "(-Vow of Reason Gulool Ja Ja-)Yet it does not stir the heart. A goblet shaped by bound hands and broken spirit is devoid of luster."
msgstr ""

#. ja: (-理のグルージャジャ-)自ら望み、笑顔になった職人たちが魂を込めれば、<br>金細工は太陽のように輝くはず……そう思いませんか？
#. de: (-Gulool Ja Ja der Weise-)Doch wenn ein Handwerker seine Kunst mit frohem Herzen und einem Lächeln auf den Lippen schaffen kann<nbsp>... So wird auch sein Werk erstrahlen wie die Sonne selbst.
#. fr: (-Gulool Ja Ja, tête de la Raison-)Si vos artisans étaient libres, heureux et inspirés<nbsp>; s'ils pouvaient insuffler toute leur âme à leurs œuvres, alors celles-ci s'en trouveraient magnifiées, vous ne pensez pas<nbsp>?
#. speaker: GULOOLJAJA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_GULOOLJAJA_000_058:1"
msgid "(-Vow of Reason Gulool Ja Ja-)Compare that now to the works of a joyful artisan. She pours her very soul into her creations, and they shine like the newly risen sun. Have you not seen this to be true?"
msgstr ""

#. ja: こうして　もてなし　はじまった！<br>環境よくって壺匠笑顔　作品よくってモブたち笑顔！
#. de: Und seither bemühen wir uns um Herzlachen. Wir schaffen ein perfektes Kreativfeld, die Topfwerker schaffen perfekte Arbeit. Alle sind glücklich.
#. fr: Et c'est ainsi que l'hospitalité devint une priorité pour les gentils Mobelins, au grand bonheur des mains-du-pot qui redoublèrent d'appliqation dans leur travail<nbsp>! Tout le monde y gagna au change<nbsp>!
#. speaker: REDIROQ
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_REDIROQ_000_059:1"
msgid "And so began the custom of goodliving. Happy potsworn make good works, and good works make Mobbies happy!"
msgstr ""

#. ja: グルージャジャの言葉　大正解！<br>最高環境　整えて　最高作品　生み出せた！
#. de: Heute können wir mit Bestimmtsicherheit sagen: Gulool Ja Ja hatte Recht.
#. fr: Gulool Ja Ja avait vu juste<nbsp>: la bienveillance paie davantage que la qontrainte<nbsp>!
#. speaker: REDIROQ
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_REDIROQ_000_060:1"
msgid "Gulool Ja Ja's words were wise! Joysmiles did indeed bring fine craft and much jinglyshine!"
msgstr ""

#. ja: 理の父上の言葉がきっかけで、<br>壺匠の文化が今の形になったのか……。
#. de: Es war also tatsächlich unser Vater, der den Grundstein für euer Vertragssystem legte<nbsp>...
#. fr: Vous êtes en train de nous dire que les mots de papa ont lit<shy>té<shy>ra<shy>le<shy>ment bouleversé la mentalité de votre clan<nbsp>?
#. speaker: KOANA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KOANA_000_061:1"
msgid "So the Head of Reason was behind the forging of potpacts..."
msgstr ""

#. ja: ぴったり　ばっちり　正しい言葉！<br>グルージャジャが　すべてを変えた！
#. de: Mit seinen Klugworten, fshkhooo. Mit ihnen hat er alles verändert.
#. fr: C'est authentique, exaqt et vrai<nbsp>! La venue de Gulool Ja Ja a tout changé<nbsp>!  
#. speaker: REDIROQ
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_REDIROQ_000_062:1"
msgid "Yes! Reason and cleverthink changed Mobbies' way of life!"
msgstr ""

#. ja: ふん……。
#. de: Hrm<nbsp>...
#. fr: Hmph.
#. speaker: ZORAALJA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ZORAALJA_000_063:1"
msgid "Hmph."
msgstr ""

#. ja: 我が主は、ホコリを被った昔話には興味がない様子。<br>ではまた、次の試練でお目にかかりましょう。
#. de: Mein Prinz hat kein Interesse an derart staubigen Märchen. Wir konzentrieren uns lieber auf die nächste Prüfung. Gehabt Euch wohl.
#. fr: Mon maître n'a visiblement que faire de ces vieux récits surannés. Je n'ai plus qu'à vous dire au revoir, ou plutôt, à la prochaine épreuve, ja...
#. speaker: SAREELJA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_SAREELJA_000_064:1"
msgid "The First Promise tires of your talk of olden days. He would rather look to the future, and the next feat."
msgstr ""

#. ja: 僕たちも出発の準備をしましょう。
#. de: Wir sollten uns ebenfalls auf den Weg machen.
#. fr: Reprenons la route, nous aussi.
#. speaker: KOANA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KOANA_000_065:1"
msgid "We should be getting on as well."
msgstr ""

#. ja: 結局、バクージャジャは戻ってこなかったわね。
#. de: Bakool Ja Ja ist nicht wieder aufgetaucht<nbsp>...
#. fr: En fin de compte, on n'aura pas vu Bakool Ja Ja une seule fois durant l'épreuve.
#. speaker: ALISAIE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALISAIE_000_066:1"
msgid "Bakool Ja Ja never did come back, did he?"
msgstr ""

#. ja: フゴォ……フゴォ……<br>ウクラマト王女　ちょっといい？
#. de: Fshkhooo ... Prinzessin Wuk Lamat, auf ein Kurzewort?
#. fr: Bssshh... Bssshh... Pardon... Rakorok peut déranger la princesse Wuk Lamat quelques instants<nbsp>?
#. speaker: RAKOROK
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_RAKOROK_000_067:1"
msgid "Pfff... Pfffkohhh... Do you have a moment, Third Promise?"
msgstr ""

#. ja: カーヘによくして　くれたこと……<br>お礼代わりに　教えてあげる！<br>黄金郷の噂話～！
#. de: Weil Ihr mir mit Kaahe so vielhelfen habt<nbsp>... Will ich Euch jetzt ein Heimgerücht von der Stadt aus Gold erzählen.
#. fr: Pour remercier la princesse d'avoir konvainku Kaahe de rester au village, Rakorok voudrait lui parler de la cité d'or<nbsp>!
#. speaker: RAKOROK
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_RAKOROK_000_068:1"
msgid "Rakorok would repay you for handhelping with Kaahe. He brings a tale of the golden city!"
msgstr ""

#. ja: おー、黄金郷について何か知ってんのか！<br>ぜひ聞かせてくれよ！
#. de: Oho, da bin ich aber ganz Ohr!
#. fr: Oh, tu as des infos pour moi<nbsp>? Vas-y, je t'écoute<nbsp>!
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_069:1"
msgid "Really? I'd love to hear it!"
msgstr ""

#. ja: 家も　路も　全部黄金！<br>この世のあらゆる　快楽だらけ！
#. de: Die Häuser und die Straßen<nbsp>- alles ist aus Glitzergold. Und außerdem gibt es alles Spaßvergnügen dort, das man sich nur vorstellen kann!
#. fr: Voilà. Dans la cité d'or il y a... de l'or partout<nbsp>! Sur les routes, sur les maisons, partout<nbsp>! Richesse et plaisirs à tous les étages<nbsp>!
#. speaker: RAKOROK
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_RAKOROK_000_070:1"
msgid "The towers, the streets, all fashioned from gold. Everywhere you look, every splendor you can imagine!"
msgstr ""

#. ja: 子どもも　大人も　老人も　みんな幸せ　黄金郷～！<br>雲の上に　ずっとある　幸せの街　黄金郷～！
#. de: Klein oder groß oder alt. Alle sind sonneglücklich, den ganzen Tag! Niemand leidet in der Stadt aus Gold, im Wolkenhimmel.
#. fr: Là-haut, dans les nuages, tout le monde est heureux. Les enfants, les adultes, les personnes âgées... L'éternelle félicité, faite cité<nbsp>!
#. speaker: RAKOROK
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_RAKOROK_000_071:1"
msgid "The young, the old, and everyone in between, they live in golden happiness. A city of eternal bliss, forever perched above the clouds!"
msgstr ""

#. ja: たしかウケブも、似た説があると言ってたな……。<br>それにしても、みんなが幸せになれる街だなんて、<br>行ってみたいもんだぜ！
#. de: Wuk Evu hat doch von einer ganz ähnlichen Auslegung erzählt<nbsp>... Aber eine Stadt, in der alle immer glücklich sind, will ich unbedingt mit eigenen Augen sehen!
#. fr: Ça rejoint en partie ce que nous avait expliqué Wuk Evu. Une ville où tout le monde est heureux... J'aimerais bien voir ça de mes propres yeux, tiens.
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_072:1"
msgid "Everything fashioned from gold, eh? And just imagine everyone living in golden happiness─now that's a city I'd like to visit!"
msgstr ""

#. ja: ところでラコロクさん、<br>その噂は誰から聞いたの？
#. de: Sag mal, Rakorok<nbsp>... Von wem hast du dieses Gerücht denn gehört?
#. fr: Au fait, Rakorok, d'où tenez-vous cette version de la légende<nbsp>?
#. speaker: KRILE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KRILE_000_073:1"
msgid "Excuse me, Rakorok, where did you hear that particular tale?"
msgstr ""

#. ja: 付き合い長い　ヨカフイ族！<br>オルコ・パチャの山の上　ひっそり暮らす古き部族！
#. de: Von den Altefreunden, den Yok Huy! Seit Ewigjahren leben sie zurückgezogen und friedlieb in den Bergen von Urqopacha. 
#. fr: Des Yok Huy<nbsp>! Ce sont les amis de longue date des Mobelins. Ils mènent une existence diskrète, au sein des montagnes d'Urqopacha<nbsp>!
#. speaker: RAKOROK
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_RAKOROK_000_074:1"
msgid "From our longtime Yok Huy friends! They live up in the mountains, in Urqopacha."
msgstr ""

#. ja: やっぱり、ヨカフイ族なのね……。
#. de: Also doch.
#. fr: On en revient toujours aux Yok Huy...
#. speaker: KRILE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KRILE_000_075:1"
msgid "The giants again..."
msgstr ""

#. ja: よっしゃ！<br>次こそ目指すは、ヨカフイ族の村だ！
#. de: Unser nächstes Ziel ist ohnehin das Dorf der Yok Huy.
#. fr: Bon, eh bien je crois que la prochaine étape pour nous va être de visiter leur village<nbsp>!
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_076:1"
msgid "Seems everything is pointing us their way!"
msgstr ""

#. ja: この試練をとおして、モブリン族の生き方がよくわかった。<br>壺匠と協力して、多くの人たちを笑顔にしてきたお前らのこと、<br>大好きになったぜ！
#. de: Diese Prüfung hat mir viel von eurer Lebensweise gezeigt, Rakorok. Und ich bin schwer beeindruckt davon, wie ihr gemeinsam mit euren Handwerkern so tolle Sachen schafft! Ach, was hab ich euch alle gern!
#. fr: Quant à vous, les Mobelins, j'ai trouvé votre mode de vie très intéressant. Vous nouez de véritables relations de confiance avec vos mains-du-pot, et offrez ses lettres de noblesse à l'artisanat turalien. Bref, je vois que des raisons de vous apprécier<nbsp>!
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_077:1"
msgid "This feat and everything leading up to it has taught me much about the Moblin way of life. I'll be sad to leave Earthenshire and your joysmiles behind!"
msgstr ""

#. ja: 気になることはあるが、ヨカフイ族の村に行ってみるしかない。
#. de: Ehrlich gesagt werfen diese vielen Gerüchte mehr Fragen auf, als dass sie Antworten liefern. Hoffentlich können wir uns bei den Yok Huy ein klareres Bild machen.
#. fr: Il y a un certain nombre de points que j'aimerais éclaircir... On verra bien ce que nous disent les Yok Huy.
#. speaker: ERENVILLE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ERENVILLE_000_080:1"
msgid "These tales raise many questions... Let us hope the giants have answers."
msgstr ""

#. ja: みんなが幸せに暮らす街だと伝わる一方で、<br>探しに行った人は帰ってこないという逸話が残っている。<br>黄金郷の正体って、いったい……？
#. de: Einerseits erzählt man sich, dass die Stadt aus Gold ein Land voller Glückseligkeit sei, andererseits kehrt niemand von der Suche nach ihr zurück. Was hat es mit dieser Geschichte nur auf sich?
#. fr: D'un côté, on nous décrit une sorte de paradis habité, alors que de l'autre, on nous affirme que ceux qui ont cherché la cité d'or sont tous morts. Difficile de discerner la vérité dans tout ça...
#. speaker: KRILE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KRILE_000_081:1"
msgid "The stories describe a place of boundless happiness, but are also rife with dire warnings of seekers who did not return. What are we to make of this...?"
msgstr ""

#. ja: 戦争を肯定するゾラージャ王子を、<br>どうして連王は継承候補者に選んだのだろうか。
#. de: Der kriegslüsterne Zoraal Ja<nbsp>... Weshalb hat der König überhaupt erlaubt, ihn am Ritus teilnehmen zu lassen<nbsp>...
#. fr: Zoraal Ja ne cache aucunement ses intentions belliqueuses. C'est à se demander comment l'Aurarque a pu accepter sa par<shy>ti<shy>ci<shy>pa<shy>tion au rite de succession...
#. speaker: ALPHINAUD
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALPHINAUD_000_082:1"
msgid "It unsettles me that Zoraal Ja is even a claimant in the first place. Surely his father cannot condone his violent ambitions..."
msgstr ""

#. ja: 話に聞く理王は、<br>私たちが話した武王とはぜんぜん違う性格みたい。<br>同じ身体を共有しているだけで、心は本当に別なのね。
#. de: Von dem, was man hört, ist der Kopf der Weisheit ja eine ganz andere Persönlichkeit als der Kopf des Mutes, den wir kennengelernt haben. Ein Körper, aber zwei komplett unter<shy>schied<shy>liche Charaktere, hm?
#. fr: Dans l'histoire de Rediroq, je n'ai pas du tout reconnu le Gulool Ja Ja qu'on a rencontré. Il faut croire que ses deux têtes ont chacune leur personnalité, un peu comme deux étrangers qui partageraient un même corps.
#. speaker: ALISAIE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALISAIE_000_083:1"
msgid "The Head of Reason in Rediroq's story sounds so different from the Head of Resolve. They share the same body, yet their personalities are wholly distinct."
msgstr ""

#. ja: 新たな壺匠　フォンジャンテーン<br>ばっちりきっちり　お世話する！<br>どうか安心　してほしい！
#. de: Keinesorge um Fonjeantaine! Er ist bei mir in Bestehand, fshkhoo!
#. fr: La nouvelle reqrue Fonjeantaine sera entourée d'attentions de la part des gentils Mobelins<nbsp>! L'<if $gn4>aventurière<else>aventurier</if> peut partir l'esprit tranquille<nbsp>!
#. speaker: REDIROQ
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_REDIROQ_000_084:1"
msgid "Worry not for potsworn Fonjeantaine! He is in good helphands!"
msgstr ""

#. ja: んじゃ、ヨカフイ族の村を目指して進もうぜ！
#. de: Also dann, auf zu den Yok Huy!
#. fr: On va au village des Yok Huy, alors<nbsp>?
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_085:1"
msgid "Right, we should go and see the giants next!"
msgstr ""

#. ja: 異論はない。<br>トライヨラ叙事詩に関連する場所としても、<br>外せない場所だからな。
#. de: Richtig, wenn wir der Tuliyollal-Sage folgen, sind sie unsere nächste Haltestelle.
#. fr: Ça me paraît in<shy>dis<shy>pen<shy>sa<shy>ble, d'autant plus que le lieu est mentionné dans la geste du Tuliyollal.
#. speaker: ERENVILLE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ERENVILLE_000_086:1"
msgid "Agreed. Golden mysteries notwithstanding, their village is featured prominently in the saga and is not to be ignored."
msgstr ""

#. ja: ヨカフイ族の村があるオルコ・パチャの高地へ行くには、<br>このままコザマル・カから進んでいくのがいい。
#. de: Um zu ihrer Heimat, dem Hochland von Urqopacha zu kommen, würde es am meisten Sinn machen, von hier aus loszuwandern.
#. fr: Et puis ça nous arrange, comme les montagnes d'Urqopacha jouxtent directement Kozama'uka.
#. speaker: ERENVILLE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ERENVILLE_000_087:1"
msgid "The Urqopacha highlands should be easy enough to reach from here."
msgstr ""

#. ja: アースンシャイアを出て西に進んだ先に、<br>山間へと入っていく道があるはずだ。<br>まずはそこを目指すぞ。
#. de: Westlich von Irdehalde sollte es eine Straße geben, die hoch in die Berge führt. Suchen wir als Erstes nach ihr.
#. fr: Il suffit de quitter La Fournée, puis de continuer vers l'ouest jusqu'à tomber sur un défilé. On pourra y faire une halte avant d'aller plus loin.
#. speaker: ERENVILLE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ERENVILLE_000_088:1"
msgid "If we leave Earthenshire from the west, there's a road which leads up into the mountains. Let's find that first."
msgstr ""

#. ja: この山間の道を進んでいけば、<br>いずれオルコ・パチャの高山地帯に出る。<br>簡単な道のりではなさそうだがな。
#. de: Wenn wir dieser Straße folgen, gelangen wir zu den Gebirgen von Urqopacha. Vermutlich könnt ihr euch bereits denken, dass dies keine entspannte Wanderung wird.
#. fr: Il suffit de continuer sur ce chemin de montagne pour atteindre Urqopacha. Enfin, ça a l'air simple dit comme ça, mais il faut quand même s'attendre à une sacrée grimpette.
#. speaker: ERENVILLE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ERENVILLE_100_089:1"
msgid "This road will take us through the mountains to the Urqopacha highlands. An exhausting route, perhaps, but a straightforward one."
msgstr ""

#. ja: いよいよ、ヨカフイ族の村に行くのね……。
#. de: Wir gehen endlich zu den Yok Huy<nbsp>...
#. fr: Alors ça y est, on va enfin découvrir le village des Yok Huy...
#. speaker: KRILE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KRILE_200_089:1"
msgid "We're to meet with the Yok Huy at last..."
msgstr ""

#. ja: これから向かおうとしているオルコ・パチャの高山地帯は、<br>ヨカフイ族を描いたトライヨラ叙事詩「墓の章」の舞台だ。
#. de: Urqopacha ist die Bühne für einen weiteren Teil der Tuliyollal-Sage: Das Kapitel des Grabes. Dort dreht sich alles um die Yok Huy.
#. fr: L'épisode de la geste du Tuliyollal qui se déroule à Urqopacha et qui met en scène les Yok Huy s'appelle le “chapitre des tombes”.
#. speaker: ALPHINAUD
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALPHINAUD_300_089:1"
msgid "The highlands are where the Lay of Proof took place─that being Gulool Ja Ja's encounter with the Yok Huy."
msgstr ""

#. ja: ……そして、ヴァリガルマンダとの戦いを記録した、<br>「封の章」とも関連している。<br>それが、継承の儀にどう絡んでくるのかはわからないが。
#. de: Außerdem spielt hier auch das Kapitel des Siegels, in dem der Kampf gegen Valigarmanda dargestellt ist. Ich bin gespannt, welche Prüfungen dort auf uns warten.
#. fr: Il s'enchaîne directement avec le “chapitre du sceau” et le combat des Turaliens contre Valigarmanda. Il est tout à fait possible que la prochaine épreuve s'inspire de ces morceaux d'Histoire...
#. speaker: ALPHINAUD
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALPHINAUD_500_089:1"
msgid "But 'tis also the stage for the Lay of Ice, where heroes fought the monstrous Valigarmanda. I am most curious to know what the rite will demand of us there..."
msgstr ""

#. ja: 川上りの次は、山登りってわけ……？
#. de: Dann heißt es jetzt also Bergsteigen, was?
#. fr: On a remonté une rivière, et maintenant, on va gravir une montagne... Tout un programme.
#. speaker: ALISAIE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALISAIE_600_089:1"
msgid "One day we're sailing up rivers, and the next we're hiking up mountains."
msgstr ""

#. ja: この先が、オルコ・パチャに続いてるって道だな！<br>かなり険しい山道になりそうだけど、<br>みんな準備はいいな？
#. de: Diese steile Straße hier führt uns also nach Urqopacha. Seid ihr alle bereit für den Aufstieg?
#. fr: Voici le chemin qui mène à Urqopacha. Attention, ça sent la route de montagne bien escarpée<nbsp>; j'espère que vous êtes prêts<nbsp>!
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_090:1"
msgid "Looks like the trail is going to get steep from here on in. I hope everyone is ready for some climbing!"
msgstr ""

#. ja: (-派手髪のトナワータ族男性-)ウクラマト様！
#. de: (-Schrillhaariger Tonawawta-)Prinzessin Wuk Lamat!
#. fr: (-Tonawawta aux cheveux teints-)Princesse Wuk Lamat<nbsp>!
#. speaker: WAWKESA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WAWKESA_000_091:1"
msgid "(-Bright-haired Tonawawtan Man-)Third Promise!"
msgstr ""

#. ja: (-派手髪のトナワータ族男性-)よかった、間に合った……。<br>レディロクに頼まれて、あなたを呼び戻しに来たんです。
#. de: (-Schrillhaariger Tonawawta-)Ah, ein Glück, ich hab Euch noch eingeholt<nbsp>...! Ich soll Euch zurückholen. Rediroq hat mich darum gebeten.
#. fr: (-Tonawawta aux cheveux teints-)Ouf, j'arrive à temps... C'est Rediroq, elle m'a dit de vous demander de retourner à La Fournée.
#. speaker: WAWKESA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WAWKESA_000_092:1"
msgid "(-Bright-haired Tonawawtan Man-)I'm glad I caught you... Rediroq asked me to bring you back to the village."
msgstr ""

#. ja: (-派手髪のトナワータ族男性-)何でも、「もらい忘れた物がある」とかで……。
#. de: (-Schrillhaariger Tonawawta-)Sie meinte, sie hätte vergessen, Euch etwas zu geben.
#. fr: (-Tonawawta aux cheveux teints-)Apparemment, elle aurait oublié de vous remettre un cadeau.
#. speaker: WAWKESA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WAWKESA_000_093:1"
msgid "(-Bright-haired Tonawawtan Man-)She says there's something she forgot to give you."
msgstr ""

#. ja: もらい忘れたもの……なんかあげる予定あったか……？
#. de: Ach so? Was könnte sie denn noch für mich haben?
#. fr: Un cadeau<nbsp>? Pour moi...<nbsp>?
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_094:1"
msgid "Huh...? Something other than the keystone?"
msgstr ""

#. ja: (-派手髪のトナワータ族男性-)ええ、とても大事な物だそうです。<br>そうお時間は取らせませんから、私についてきてください。
#. de: (-Schrillhaariger Tonawawta-)Etwas enorm Wichtiges, soweit ich weiß. Es wird nicht lange dauern, also bitte kommt kurz mit mir mit!
#. fr: (-Tonawawta aux cheveux teints-)Oui, elle tient absolument à vous l'offrir. Venez avez moi, ce ne sera pas long.
#. speaker: WAWKESA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WAWKESA_000_095:1"
msgid "(-Bright-haired Tonawawtan Man-)Yes, an item of great importance, or so I was told. It shouldn't take long, if you would please follow me."
msgstr ""

#. ja: よくわかんねぇけど、ちょっくら行ってくるぜ。<br>お前らはここで待っててくれ！
#. de: Ich weiß nicht, worum es geht, aber wenn es so wichtig ist<nbsp>... Wartet kurz hier, ich bin gleich wieder da.
#. fr: Bon, je suis pas trop sûre de comprendre, mais puisque Rediroq insiste... Je me dépêche, attendez-moi ici<nbsp>!
#. speaker: WUKLAMAT
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_WUKLAMAT_000_096:1"
msgid "I wonder what this is all about? Well, no need for everyone to come─I'll be back in a little while!"
msgstr ""

#. ja: フゴォ……フゴォ……<br>増えた壺匠　受け入れ　準備で大忙し！<br>悪いけど　モブに用なら　あとにして！
#. de: Fshkhooo. Die ganze Siedlung ist schwer bei der Arbeit, um Platz für mehr Topfwerker zu schaffen. Es tut mir vieleleid, aber wenn Ihr ein Anliegen habt, wird es einen Moment warten müssen.
#. fr: Bssshh... Bssshh... Rediroq est débordée aveq toutes ces nouvelles mains-du-pot à prendre en charge<nbsp>! Elle disqutera avec l'<if $gn4>aventurière<else>aventurier</if> plus tard, d'aqqord<nbsp>?
#. speaker: REDIROQ
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_REDIROQ_100_100:1"
msgid "Pfff... Pfffkohhh... Moblins are busy ensuring goodliving for new potsworn! Rediroq has no time for idle tongueflaps!"
msgstr ""

#. ja: ずいぶん、派手な髪色をしたヒューラン……<br>こっちでの呼び名はトナワータ族だったわね。<br>あんな人、アースンシャイアで見かけなかった気がするけれど。
#. de: Das war ein Tonawawta, richtig? So nennt Tural das Volk, das wir als Hyuran kennen, wenn ich mich recht erinnere. Sehr ausgefallene Haare hatte er<nbsp>... In Irdehalde ist er mir jedenfalls nicht aufgefallen. 
#. fr: Ce Hyur, enfin, ce Tonawawta avait une teinture pour le moins tape-à-l'œil... Bizarrement, je ne me souviens pas l'avoir croisé à La Fournée...
#. speaker: KRILE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KRILE_000_100:1"
msgid "He had rather interesting hair for a Hyur...or should I say Tonawawta? In any case, strange that I never noticed him while we were in Earthenshire."
msgstr ""

#. ja: ウクラマトの奴、隠れてアースンシャイアで買い食いして、<br>代金を払い忘れたんじゃないか。
#. de: Vermutlich hat sich Wuk Lamat in Irdehalde mal wieder den Magen vollgeschlagen und aus Versehen die Zeche geprellt. Wäre nicht das erste Mal.
#. fr: Cette histoire de cadeau est peut-être bidon. Si ça se trouve, Wuk Lamat a pris à manger dans une gargote mobeline et a oublié de payer. Ça m'étonnerait pas, goinfre et tête en l'air comme elle est.
#. speaker: ERENVILLE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ERENVILLE_000_101:1"
msgid "Knowing Wuk Lamat, she was probably eating sweets behind our backs and forgot to pay the shopkeeper or something equally careless."
msgstr ""

#. ja: ウクラマトが戻り次第、オルコ・パチャの高山地帯を目指そう。<br>未だその姿を目にしていない、ヨカフイ族……<br>いったい、どんな部族なんだろうね。
#. de: Wir haben auf unserer Reise schon so viel über die Yok Huy gehört, dass ich nun umso gespannter bin, sie endlich selbst zu treffen.
#. fr: Dès que Wuk Lamat sera de retour, on se mettra en route vers les cimes d'Urqopacha. J'ai hâte de découvrir les Yok Huy<nbsp>; après tout, on n'en a encore jamais vu un seul.
#. speaker: ALPHINAUD
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALPHINAUD_000_102:1"
msgid "I'm eager to continue to the highlands and meet a Yok Huy face-to-face. We've heard much about them, but I'm not entirely sure what to expect."
msgstr ""

#. ja: さっきの人、どこか覚えがあるような……気のせいかしら。
#. de: Irgendwie kam mir der Kerl von eben bekannt vor<nbsp>... Aber vielleicht bilde ich mir das auch nur ein.
#. fr: Le type, là... J'ai l'impression de l'avoir déjà vu quelque part. À moins que ma mémoire ne me joue des tours...
#. speaker: ALISAIE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALISAIE_000_103:1"
msgid "That man seemed familiar somehow... But I just can't place him."
msgstr ""

#. ja: 戻ってこないわね。<br>時間はかからないということだったけれど……。<br>もうしばらく待ってみましょう。
#. de: Ich dachte, es würde nicht lange dauern<nbsp>... Gut, warten wir eben noch eine Weile.
#. fr: Wuk Lamat n'est toujours pas revenue... Elle avait pourtant dit qu'elle se dépêcherait... Enfin, attendons encore un peu pour voir.
#. speaker: KRILE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KRILE_000_104:1"
msgid "This is taking quite a while... Just keep waiting for now, I suppose."
msgstr ""

#. ja: ……用事が長引いているのだろうか？<br>もう少しだけ待ってみるとしよう。
#. de: Bestimmt wurde sie in Irdehalde aufgehalten. Haben wir noch etwas Geduld.
#. fr: Je ne sais pas ce qui retient Wuk Lamat... On va encore attendre un peu, mais ça commence à m'inquiéter...
#. speaker: ALPHINAUD
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALPHINAUD_000_110:1"
msgid "Perhaps there were complications? Well, let us wait a little longer."
msgstr ""

#. ja: いくらなんでも遅すぎない？<br>戻ってくる途中で、道にでも迷ったのかしら？
#. de: Irgendwas stimmt hier nicht. Sie wird sich doch nicht verlaufen haben?
#. fr: Bon, ça fait rudement long, là... Elle s'est perdue en chemin ou quoi<nbsp>?
#. speaker: ALISAIE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALISAIE_000_120:1"
msgid "This is getting a little ridiculous. Did she get lost on the way back to find us?"
msgstr ""

#. ja: まさか。<br>ここまでは一本道だったわよ。
#. de: Das kann ich mir nicht vorstellen, sie muss ja einfach nur der Straße folgen.
#. fr: C'est impossible, on n'a fait que marcher en ligne droite depuis La Fournée...
#. speaker: KRILE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KRILE_000_121:1"
msgid "But how? There's only the one road."
msgstr ""

#. ja: あまりウクラマトを舐めない方がいい。<br>可能性としては十分にありえる。
#. de: Das heißt nicht viel bei Wuk Lamat. Ihr würde ich das durchaus zutrauen.
#. fr: Oh, ne la sous-estime pas. Elle serait capable de s'égarer dans sa propre maison.
#. speaker: ERENVILLE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ERENVILLE_000_122:1"
msgid "I wouldn't underestimate Wuk Lamat's sense of direction...or lack thereof."
msgstr ""

#. ja: リンクパールを渡しておいてよかったよ。<br>連絡を取ってみよう。
#. de: Fragen wir sie doch einfach per Kontaktperle.
#. fr: On a assez attendu comme ça. Je vais essayer de l'appeler sur la linkperle qu'on lui a donnée.
#. speaker: ALPHINAUD
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALPHINAUD_000_123:1"
msgid "Fortunately, she has a linkpearl. Let's see what's keeping her, shall we?"
msgstr ""

#. ja: 反応なし……か。<br>ならば、私たちもアースンシャイアに戻ってみよう。
#. de: Hm, keine Antwort<nbsp>... Kommt, lasst uns ebenfalls nach Irdehalde zurückkehren.
#. fr: Elle ne répond pas... Dans ce cas, je propose qu'on retourne nous aussi à La Fournée.
#. speaker: ALPHINAUD
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALPHINAUD_000_124:1"
msgid "She's not responding... Perhaps we should all return to Earthenshire."
msgstr ""

#. ja: たしかウクラマトを呼んでいたのは、<br>連王の選者の「レディロク」という話だったね。
#. de: Rediroq wird uns ja zweifelsohne sagen können, was sie von Wuk Lamat wollte. Und wohin sie verschwunden ist.
#. fr: On la trouvera peut-être là-bas. Au pire, Rediroq pourra nous dire où elle est.
#. speaker: ALPHINAUD
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALPHINAUD_000_125:1"
msgid "'Twas Rediroq who had business with her, yes?"
msgstr ""

#. ja: ウクラマトさんの姿はないわね……。
#. de: Keine Spur von Wuk Lamat<nbsp>...
#. fr: Je ne vois Wuk Lamat nulle part...
#. speaker: KRILE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KRILE_000_130:1"
msgid "She doesn't seem to be here..."
msgstr ""

#. ja: また勝手に暴走してはぐれたのかと思ったが、<br>どうやら今回は違うようだな。
#. de: Meine erste Vermutung war, dass sie sich wieder von irgendwas hat ablenken lassen, aber<nbsp>... Etwas ist faul.
#. fr: J'ai cru qu'il s'agissait d'une énième frasque de Wuk Lamat... mais apparemment pas...
#. speaker: ERENVILLE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ERENVILLE_000_131:1"
msgid "I'd thought Wuk Lamat was just being her usual impulsive self, but now I'm not so certain..."
msgstr ""

#. ja: ウクラマトに何事もなければ良いのだが……。
#. de: Hoffentlich ist ihr nichts zugestoßen<nbsp>...
#. fr: J'espère simplement que Wuk Lamat va bien...
#. speaker: ALPHINAUD
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALPHINAUD_000_132:1"
msgid "I pray naught untoward has befallen the Third Promise."
msgstr ""

#. ja: 嫌な予感がするわね……。
#. de: Ich hab ein ganz schlechtes Gefühl, <split " " 1><string $gs1></split>.
#. fr: J'ai un mauvais pres<shy>sen<shy>ti<shy>ment...
#. speaker: ALISAIE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALISAIE_000_133:1"
msgid "Something's not right. I can feel it..."
msgstr ""

#. ja: フゴォ……フゴォ……<br>おやおや　私に何か用？
#. de: Fshkhooo<nbsp>... Ihr seid schon zurück?
#. fr: Bssshh... Bssshh... Les étrangers sont revenus voir Rediroq<nbsp>? Pour quoi faire<nbsp>?
#. speaker: REDIROQ
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_REDIROQ_000_134:1"
msgid "Pfff... Pfffkohhh... Back again so soon?"
msgstr ""

#. ja: あなたに呼ばれたと聞いて、<br>ウクラマトがこちらに来たはずなのですが……。
#. de: Verzeiht, aber hattet Ihr Wuk Lamat nicht noch einmal nach Irdehalde zurückbestellt?
#. fr: Désolé de vous déranger, mais... vous avez bien demandé à Wuk Lamat de rebrousser chemin pour lui offrir un cadeau, n'est-ce pas<nbsp>?
#. speaker: ALPHINAUD
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALPHINAUD_000_135:1"
msgid "We've come looking for Wuk Lamat. Did you not send someone to fetch her?"
msgstr ""

#. ja: はてはて　モブは　覚えなし！<br>王女を呼んでも　いなければ　戻って来ても　いないモブ～！
#. de: Hm? Nein, nicht, dass ich wüsste. Gesehen haben wir die Prinzessin seit eurem Tschüsaufbruch auch nicht mehr.
#. fr: Un qadeau<nbsp>? Non<nbsp>! Pas du tout<nbsp>! Que nenni<nbsp>! Rediroq n'a pas revu la princesse depuis la fin de l'épreuve du pot<nbsp>!
#. speaker: REDIROQ
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_REDIROQ_000_136:1"
msgid "Rediroq did not! Neither has she seen the Third Promise since you were last here."
msgstr ""

#. ja: じゃあ、ウクラマトさんと、<br>彼女を呼びにきた人はどこに行ったの……？
#. de: Wo kam also dieser Mann her, der uns aufgehalten hat?
#. fr: Mais alors, qui était cet homme<nbsp>? Et où a-t-il emmené Wuk Lamat...<nbsp>?
#. speaker: KRILE
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KRILE_000_137:1"
msgid "Then who was that man who came for her...?"
msgstr ""

#. ja: お前たち、まだここにいたのか。
#. de: Was treibt ihr denn noch hier?
#. fr: Tiens, vous n'étiez pas déjà partis<nbsp>? 
#. speaker: THANCRED
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_THANCRED_000_138:1"
msgid "Oh? I thought you'd left already."
msgstr ""

#. ja: 妹は一緒ではないのですか？
#. de: Ist meine Schwester gar nicht bei euch?
#. fr: Ma sœur n'est pas avec vous<nbsp>?
#. speaker: KOANA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KOANA_000_139:1"
msgid "Where is Lamaty'i? Is she not with you?"
msgstr ""

#. ja: ラマチの行方がわからなくなった……ですって？<br>あなたがたがついていながら、なぜそんなことに……！
#. de: Sie ist <i>verschwunden</i>? Wie konntet ihr sie denn einfach so aus den Augen lassen!
#. fr: Vous ne savez pas où est Lamaty'i<nbsp>? Mais comment c'est possible<nbsp>!? Vous êtes censés l'accompagner où qu'elle aille<nbsp>!
#. speaker: KOANA
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KOANA_000_140:1"
msgid "You don't <i>know</i> where she is? How could you let this happen!?"
msgstr ""

#. ja: 妹君が心配な気持ちはわかりますが、<br>ならばなおさら、今は彼女の足跡を追うことが先決かと。
#. de: Ich verstehe durchaus, dass du dich um deine Schwester sorgst, aber gerade in hitzigen Momenten ist ein kühler Kopf besonders wertvoll.
#. fr: La disparition de votre sœur vous inquiète et c'est normal. Justement, je pense que nous devrions en faire notre priorité.
#. speaker: URIANGER
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_URIANGER_000_141:1"
msgid "That thou shouldst worry for thy sister is understandable. Yet rather than assign blame, thine energies are better spent on locating her."
msgstr ""

#. ja: ……僕も、ラマチを探すのに協力します。<br>こんなところで王位を争う相手が脱落するのは、<br>僕の本意ではありませんから。
#. de: Wir werden euch helfen, nach ihr zu suchen. Konkurrenz hin oder her, sie soll nicht aus dem Ritus ausscheiden, weil ihr etwas zugestoßen ist.
#. fr: Nous allons vous aider à retrouver Lamaty'i. Ça m'embêterait de perdre tout à coup ma rivale favorite dans cette course à la succession.
#. speaker: KOANA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KOANA_000_142:1"
msgid "I will help you search. This is not how I'd wish a fellow claimant to lose the contest─my sister least of all."
msgstr ""

#. ja: なら、手分けした方が確実だろう。
#. de: In dem Fall sollten wir uns aufteilen.
#. fr: Je propose qu'on se sépare, comme je suis plus efficace en solo.
#. speaker: THANCRED
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_THANCRED_000_143:1"
msgid "In that case, dividing our forces will allow us to cover more ground."
msgstr ""

#. ja: そちらの代表者は<split " " 2><string $gs1></split>さんですね。<br>互いの情報交換を円滑に行うために、<br>僕たちふたりは行動をともにするべきだ。
#. de: Du bist <if $gn4>die Sprecherin<else>der Sprecher</if> eurer Gruppe, nicht wahr? Dann sollten wir beide uns zusammensetzen und uns ein Bild der Lage machen.
#. fr: Tu as un moyen de contacter tes alliés<nbsp>? Si oui, on n'a qu'à rester ensemble, toi et moi. Comme ça, on pourra facilement partager nos in<shy>for<shy>ma<shy>tions entre nos deux équipes.
#. speaker: KOANA
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KOANA_000_144:1"
msgid "<split \" \" 1><string $gs1></split> and I should work together at least, the better to facilitate communication between our groups."
msgstr ""

#. ja: では、私たちは個別にウクラマトを探すよ。<br>何かわかったら、連絡してくれ。
#. de: Dann beginnen wir entsprechend mit der eigentlichen Suche. Bitte lasst es uns wissen, sobald es etwas Neues gibt.
#. fr: Parfait, on va mener l'enquête de notre côté. Préviens-nous si tu as du nouveau.
#. speaker: ALPHINAUD
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_ALPHINAUD_000_145:1"
msgid "Then the rest of us will split up. Report in should you find anything."
msgstr ""

#. ja: 俺たちも行ってくる。
#. de: Wir schließen uns an.
#. fr: On va y aller, nous aussi.
#. speaker: THANCRED
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_THANCRED_000_146:1"
msgid "We'll be on our way as well."
msgstr ""

#. ja: ええ……頼みます。
#. de: Ja ... Danke.
#. fr: Je vous fais confiance.
#. speaker: KOANA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KOANA_000_147:1"
msgid "Right. Keep in touch."
msgstr ""

#. ja: 僕たちも彼女の捜索を始めましょう。
#. de: Fangen wir ebenfalls an.
#. fr: Allez, au travail. J'ai une sœur à retrouver.
#. speaker: KOANA
msgctxt "quest/048/KinGmb105_04884:TEXT_KINGMB105_04884_KOANA_000_148:1"
msgid "Come─we should begin our search."
msgstr ""
