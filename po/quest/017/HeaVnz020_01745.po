msgctxt "quest/017/HeaVnz020_01745:TEXT_HEAVNZ020_01745_REDWALD_000_062:1"
msgid "You have my thanks, <if $gn4>Mistress<else>Master</if> <split \" \" 2><string $gs1></split>. Now that we know the cause of this illness, there is only one thing left to do..."
msgstr "Благодарю вас, <if $gn4>госпожа<else>господин</if> <split \" \" 2><string $gs1></split>. Теперь мы знаем причину болезни. Осталось лишь одно..."

