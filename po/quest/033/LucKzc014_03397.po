msgctxt "quest/033/LucKzc014_03397:TEXT_LUCKZC014_03397_SEQ_00:1"
msgid "<ui-color 508><ui-edge-color 509> Quest Sync</ui-edge-color></ui-color><br>Trepidation is writ plain on Lad Kenn's face."
msgstr ""

#. ja: ジャイアントビーバーと話す
#. de: Mit den Riesenbibern sprechen
#. fr: Parler aux castors géants, à Phisor Lran
#. kind: objective
msgctxt "quest/033/LucKzc014_03397:TEXT_LUCKZC014_03397_TODO_00:1"
msgid "Speak with the giant beavers."
msgstr ""

#. ja: ラド＝ケンと話す
#. de: Mit Lad Kenn sprechen
#. fr: Parler à Lad Kenn, à Lydha Lran
#. kind: objective
msgctxt "quest/033/LucKzc014_03397:TEXT_LUCKZC014_03397_TODO_01:1"
msgid "Speak with Lad Kenn."
msgstr ""

#. ja: チャットの「Say」モードで『ラド＝ケン』と入力し<br><sheet EObj 2010722 0>でラド＝ケンを探す
#. de: Im „Sagen“-Chatmodus „Lad Kenn“ eingeben und nach Lad Kenn suchen
#. fr: En mode de discussion <ui-color 500><ui-edge-color 501>Dire</ui-edge-color></ui-color>, appeler Lad Kenn en prononçant son nom, à l'endroit indiqué
#. kind: objective
#. macro: <ui-color 500> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 500 (formatting: keep it as often as the source has it)
