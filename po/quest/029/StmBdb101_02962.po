msgid "You have learned the emote <ui-color 500><ui-edge-color 501>Box</ui-edge-color></ui-color>!"
msgstr "Вы выучили эмоцию <ui-color 500><ui-edge-color 501>Бокс</ui-edge-color></ui-color>!"
