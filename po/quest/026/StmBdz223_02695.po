#. de: Wer ist da?
#. fr: Esprit
#. speaker: SAYTODO
msgctxt "quest/026/StmBdz223_02695:TEXT_STMBDZ223_02695_SAYTODO_000_000:1"
msgid "Is anyone around here?"
msgstr "Здесь кто-нибудь есть?"

