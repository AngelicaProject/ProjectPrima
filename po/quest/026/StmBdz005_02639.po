# quest/026/StmBdz005_02639 — «Magiteknical Failure» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: カストルム・オリエンスのルーツキルツ大甲士は、頼みごとがあるようだ。
#. de: Loezkirz ist auf deine Kampf<shy>erfahrung angewiesen.
#. fr: Le capitaine Loezkirz semble avoir besoin de votre aide.
#. kind: journal
msgctxt "quest/026/StmBdz005_02639:TEXT_STMBDZ005_02639_SEQ_00:1"
msgid "Captain Loezkirz has lost something very important."
msgstr ""

#. ja: グ・ニブニパ少甲士と話す
#. de: Mit G'nibnpha sprechen
#. fr: Parler à G'nibnpha
#. kind: objective
msgctxt "quest/026/StmBdz005_02639:TEXT_STMBDZ005_02639_TODO_00:1"
msgid "Speak with Lieutenant G'nibnpha."
msgstr ""

#. ja: 鹵獲魔導アーマーに騎乗してイーストエンド混交林東へ向かい<br>現れた<sheet BNpcName 5866 0>を討伐
#. de: Auf Magitek-Kampfmaschine die neuartigen Schlitzer im östlichen Ostend-Mischwald beseitigen
#. fr: Piloter une armure magitek et éliminer les lacératrices expérimentales, aux Confins est
#. kind: objective
msgctxt "quest/026/StmBdz005_02639:TEXT_STMBDZ005_02639_TODO_01:1"
msgid "Pilot the magitek armor to East End and destroy the Garlean drones."
msgstr ""

#. ja: 鹵獲魔導アーマーに騎乗してベロジナ川北西へ向かい<br>現れた<sheet BNpcName 5866 0>を討伐
#. de: Auf Magitek-Kampfmaschine die neuartigen Schlitzer am Nordwestufer des Velodyna beseitigen
#. fr: Piloter une armure magitek et éliminer les lacératrices expérimentales, près de la Velodyna
#. kind: objective
msgctxt "quest/026/StmBdz005_02639:TEXT_STMBDZ005_02639_TODO_02:1"
msgid "Pilot the magitek armor to Velodyna River and destroy the Garlean drones."
msgstr ""

#. ja: ルーツキルツ大甲士と話す
#. de: Loezkirz Bericht erstatten
#. fr: Parler à Loezkirz
#. kind: objective
msgctxt "quest/026/StmBdz005_02639:TEXT_STMBDZ005_02639_TODO_03:1"
msgid "Report to Captain Loezkirz."
msgstr ""

#. ja: おぉ、<split " " 2><string $gs1></split><if ($gn52 > 0)><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 0></if></if><if ($gn53 > 0)><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 0></if></if><if ($gn54 > 0)><if ($gn54 > 0)><sheet GCRankUldahMaleText $gn54 0></if></if>、いいところに！<br>緊急事態が発生したのだ、任務への協力を願えるか？
#. de: Oh, <if ($gn52 > 0)><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 0></if></if><if ($gn53 > 0)><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 0></if></if><if ($gn54 > 0)><if ($gn54 > 0)><sheet GCRankUldahMaleText $gn54 0></if></if> <split " " 2><string $gs1></split>! Du kommst wie gerufen! Kannst du uns bei einem Notfall helfen?
#. fr: <if ($gn52 > 0)><capitalize><if ($gn52 > 0)><if $gn4><sheet GCRankLimsaFemaleText $gn52 0><else><sheet GCRankLimsaMaleText $gn52 0></if></if></capitalize> <split " " 2><string $gs1></split></if><if ($gn53 > 0)><capitalize><if ($gn53 > 0)><if $gn4><sheet GCRankGridaniaFemaleText $gn53 0><else><sheet GCRankGridaniaMaleText $gn53 0></if></if></capitalize> <split " " 2><string $gs1></split></if><if ($gn54 > 0)><capitalize><if ($gn54 > 0)><if $gn4><sheet GCRankUldahFemaleText $gn54 0><else><sheet GCRankUldahMaleText $gn54 0></if></if></capitalize> <split " " 2><string $gs1></split></if>, vous tombez bien<nbsp>! Votre aide serait la bienvenue pour débloquer une situation critique.
#. speaker: LOEZKIRZ
#. macro: <if ($gn52 > 0)><capitalize><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 8></if><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 8></if><if ($gn54 > 0)><… — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 52 (the player's rank in the Maelstrom, 0 when not a member) > 0 (condition: may be reworded, restructured, added, or dropped)
