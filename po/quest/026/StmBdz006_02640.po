# quest/026/StmBdz006_02640 — «Gross Encounters» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: カストルム・オリエンスのスウェスリク大牙将は、実績のある冒険者を探しているようだ。
#. de: Swethryk Brookstone braucht <if $gn4>eine erfahrene Abenteurerin<else>einen erfahrenen Abenteurer</if>.
#. fr: Swethryk Brookstone a l'air ravi de vous voir.
#. kind: journal
msgctxt "quest/026/StmBdz006_02640:TEXT_STMBDZ006_02640_SEQ_00:1"
msgid "The look on Serpent Marshal Brookstone's face suggests he has received some distressing news."
msgstr ""

#. ja: 不滅隊の兵卒と話す
#. de: Mit dem Legionsrekruten sprechen
#. fr: Parler au soldat des Immortels
#. kind: objective
msgctxt "quest/026/StmBdz006_02640:TEXT_STMBDZ006_02640_TODO_00:1"
msgid "Speak with the flame recruit."
msgstr ""

#. ja: 双蛇党の兵卒と話す
#. de: Mit dem Bruderschaftsrekruten sprechen
#. fr: Parler au soldat des Deux Vipères
#. kind: objective
msgctxt "quest/026/StmBdz006_02640:TEXT_STMBDZ006_02640_TODO_01:1"
msgid "Speak with the serpent recruit."
msgstr ""

#. ja: <sheet EObj 2008814 0>で見渡す
#. de: Am Zielort Ausschau halten
#. fr: Observer les environs à l'endroit indiqué
#. kind: objective
msgctxt "quest/026/StmBdz006_02640:TEXT_STMBDZ006_02640_TODO_02:1"
msgid "Survey the specified location."
msgstr ""

#. ja: <sheet BNpcName 5867 0>を討伐
#. de: <capitalize><noun-de BNpcName 2 5867 1 4 1></capitalize> besiegen
#. fr: Vaincre <noun-fr BNpcName 2 5867 1 1>
#. kind: objective
msgctxt "quest/026/StmBdz006_02640:TEXT_STMBDZ006_02640_TODO_03:1"
msgid "Defeat the greatest morbol."
msgstr ""

#. ja: スウェスリク大牙将と話す
#. de: Mit Swethryk Brookstone sprechen
#. fr: Parler à Swethryk Brookstone
#. kind: objective
msgctxt "quest/026/StmBdz006_02640:TEXT_STMBDZ006_02640_TODO_04:1"
msgid "Speak with Brookstone."
msgstr ""

#. ja: <if ($gn52 > 0)><split " " 2><string $gs1></split><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 0></if></if><if ($gn53 > 0)><split " " 2><string $gs1></split><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 0></if></if><if ($gn54 > 0)><split " " 2><string $gs1></split><if ($gn54 > 0)><sheet GCRankUldahMaleText $gn54 0></if></if>だな。<br>実績のある冒険者にしか頼めない任務があるのだが、<br>聞いてもらえるか？
#. de: Ich hätte da eine Aufgabe, die ich nur <if $gn4>einer erfahrenen Kämpferin<else>einem erfahrenen Kämpfer</if> wie dir anvertrauen möchte. Kannst du uns helfen?
#. fr: <if ($gn52 > 0)><capitalize><if ($gn52 > 0)><if $gn4><sheet GCRankLimsaFemaleText $gn52 0><else><sheet GCRankLimsaMaleText $gn52 0></if></if></capitalize> <split " " 2><string $gs1></split></if><if ($gn53 > 0)><capitalize><if ($gn53 > 0)><if $gn4><sheet GCRankGridaniaFemaleText $gn53 0><else><sheet GCRankGridaniaMaleText $gn53 0></if></if></capitalize> <split " " 2><string $gs1></split></if><if ($gn54 > 0)><capitalize><if ($gn54 > 0)><if $gn4><sheet GCRankUldahFemaleText $gn54 0><else><sheet GCRankUldahMaleText $gn54 0></if></if></capitalize> <split " " 2><string $gs1></split></if>, vous tombez bien<nbsp>! J'ai justement une mission que je ne peux confier qu'à quelqu'un de votre carrure.
#. speaker: SWETHRYKBROOKSTONE
#. macro: <if ($gn52 > 0)><split " " 1><string $gs1></split>!<else><if ($gn53 > 0)><capitalize><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 8></if><if ($gn53 > 0)><sh… — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 52 (the player's rank in the Maelstrom, 0 when not a member) > 0 (condition: may be reworded, restructured, added, or dropped)
