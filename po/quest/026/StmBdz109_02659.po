# quest/026/StmBdz109_02659 — «A Good Role Model» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: カストルム・オリエンスのスウェスリク大牙将は、実戦経験の豊富な冒険者を探しているようだ。
#. de: Swethryk Brookstone braucht die Hilfe <if $gn4>einer kampferfahrenen Abenteurerin<else>eines kampferfahrenen Abenteurers</if>.
#. fr: Swethryk Brookstone aimerait vous parler de ses jeunes recrues.
#. kind: journal
msgctxt "quest/026/StmBdz109_02659:TEXT_STMBDZ109_02659_SEQ_00:1"
msgid "Serpent Marshal Brookstone is looking to make an example out of someone."
msgstr "Маршал Двух Змей Брукстоун хочет кого-нибудь поставить в пример."

#. ja: <sheet BNpcName 5681 0>を討伐
#. de: <capitalize><noun-de BNpcName 5 5681 2 4 1></capitalize> besiegen
#. fr: Chasser <noun-fr BNpcName 1 5681 2 1>, près des chutes de la Pique
#. kind: objective
msgctxt "quest/026/StmBdz109_02659:TEXT_STMBDZ109_02659_TODO_00:1"
msgid "Slay tracer antlions."
msgstr "Убейте муравьелвов-следопытов."

#. ja: 双蛇党の新兵と話す
#. de: Mit den Rekruten der Bruderschaft sprechen
#. fr: Parler aux jeunes recrues des Deux Vipères
#. kind: objective
msgctxt "quest/026/StmBdz109_02659:TEXT_STMBDZ109_02659_TODO_01:1"
msgid "Speak with the Twin Adder recruits."
msgstr "Поговорите с новобранцами Двух Змей."

#. ja: スウェスリク大牙将と話す
#. de: Mit Swethryk Brookstone sprechen
#. fr: Parler à Swethryk Brookstone, à Castrum Oriens
#. kind: objective
msgctxt "quest/026/StmBdz109_02659:TEXT_STMBDZ109_02659_TODO_02:1"
msgid "Speak with Brookstone."
msgstr "Поговорите с Брукстоуном."

#. ja: <if ($gn52 > 0)><split " " 2><string $gs1></split><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 0></if></if><if ($gn53 > 0)><split " " 2><string $gs1></split><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 0></if></if><if ($gn54 > 0)><split " " 2><string $gs1></split><if ($gn54 > 0)><sheet GCRankUldahMaleText $gn54 0></if></if>か。<br>君は、経験、実力ともに冒険者部隊でも指折りの存在だ。
#. de: Ah, <if ($gn52 > 0)><if $gn4><sheet GCRankLimsaFemaleText $gn52 0><else><sheet GCRankLimsaMaleText $gn52 0></if><else><if ($gn53 > 0)><if $gn4><sheet GCRankGridaniaFemaleText $gn53 0><else><sheet GCRankGridaniaMaleText $gn53 0></if><else><if ($gn54 > 0)><if $gn4><sheet GCRankUldahFemaleText $gn54 0><else><sheet GCRankUldahMaleText $gn54 0></if></if></if></if> <split " " 2><string $gs1></split>! Du mit deiner Kampf<shy>erfahrung kommst wie gerufen.
#. fr: <if ($gn52 > 0)><capitalize><if ($gn52 > 0)><if $gn4><sheet GCRankLimsaFemaleText $gn52 0><else><sheet GCRankLimsaMaleText $gn52 0></if></if></capitalize> <split " " 2><string $gs1></split></if><if ($gn53 > 0)><capitalize><if ($gn53 > 0)><if $gn4><sheet GCRankGridaniaFemaleText $gn53 0><else><sheet GCRankGridaniaMaleText $gn53 0></if></if></capitalize> <split " " 2><string $gs1></split></if><if ($gn54 > 0)><capitalize><if ($gn54 > 0)><if $gn4><sheet GCRankUldahFemaleText $gn54 0><else><sheet GCRankUldahMaleText $gn54 0></if></if></capitalize> <split " " 2><string $gs1></split></if>, vous êtes sans aucun doute l<if $gn4>a<else>e</if> plus expérimenté<if $gn4>e</if> et l<if $gn4>a<else>e</if> plus efficace de nos éléments, donc j'aimerais vous confier une mission.
#. speaker: SWETHRYKBROOKSTONE
