#. de: Gunu Vanu Bericht erstatten
#. fr: Parler à Gunu Vanu
#. kind: objective
msgctxt "quest/019/HeaVnz712_01916:TEXT_HEAVNZ712_01916_TODO_05:1"
msgid "Report to Gunu Vanu."
msgstr ""

