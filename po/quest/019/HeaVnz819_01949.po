#. de: （★未使用／削除予定★）
#. fr: （★未使用／削除予定★）
#. speaker: DRIPWIX
msgctxt "quest/019/HeaVnz819_01949:TEXT_HEAVNZ819_01949_DRIPWIX_000_001:1"
msgid "deleted"
msgstr ""

