msgctxt "quest/019/HeaVnz823_01953:TEXT_HEAVNZ823_01953_NOTCHEDBONE_000_060:1"
msgid "deleted"
msgstr "удалено"

#. ja: （★未使用／削除予定★）
#. de: （★未使用／削除予定★）
#. fr: （★未使用／削除予定★）
#. speaker: DEDEAN
msgctxt "quest/019/HeaVnz823_01953:TEXT_HEAVNZ823_01953_DEDEAN_000_070:1"
msgid "deleted"
msgstr "удалено"
