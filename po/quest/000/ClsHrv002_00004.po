msgctxt "quest/000/ClsHrv002_00004:TEXT_CLSHRV002_00004_SYSTEM_000_24:1"
msgid "You can use the <ui-color 500><ui-edge-color 501>Arbor Call</ui-edge-color></ui-color> botanist action to help you locate the nearest mature tree or lush vegetation within your skill range."
msgstr "Умение ботаника <ui-color 500><ui-edge-color 501>Зов леса</ui-edge-color></ui-color> поможет найти ближайшее дерево или густые заросли, соответствующие вашему уровню."
