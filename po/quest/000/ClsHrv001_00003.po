msgctxt "quest/000/ClsHrv001_00003:TEXT_CLSHRV001_00003_SYSTEM_000_32:1"
msgid "A button for the Gear Set interface is located in the upper portion of the <ui-color 500><ui-edge-color 501>Character</ui-edge-color></ui-color> window."
msgstr "Кнопка управления наборами экипировки находится в верхней части окна <ui-color 500><ui-edge-color 501>персонажа</ui-edge-color></ui-color>."
