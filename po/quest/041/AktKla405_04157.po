#. fr: Observer ce qu'il se passe à l'endroit indiqué
#. kind: journal
msgctxt "quest/041/AktKla405_04157:TEXT_AKTKLA405_04157_SEQ_04:1"
msgid "Survey the designated location."
msgstr "Осмотрите указанное место."

#. ja: タンキンに<sheet Item 35847 0>を納品
#. de: (head(<noun-de Item 2 35847 2 4 1>)> bei Professor Tankin abliefern
#. fr: Livrer <noun-fr Item 2 35847 1 1> à Tankin
#. kind: journal
msgctxt "quest/041/AktKla405_04157:TEXT_AKTKLA405_04157_SEQ_05:1"
msgid "Deliver the piece of hairpin material to Tankin."
msgstr "Отнесите Танкину материал для заколки."

#. ja: タンキンと話す
#. de: Mit Professor Tankin sprechen
#. fr: Parler à Tankin
#. kind: journal
