# quest/049/KinGmd104_04915 — «Blowing Smoke» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: トナテニャイ付近のエレンヴィルは、様子を窺っているようだ。
#. de: Erenville will seinen geruchsintensiven Plan in die Tat umsetzen.
#. fr: Erenville observe la situation depuis les abords du village de Tonatenyawi.
#. kind: journal
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_SEQ_00:1"
msgid "Erenville's gaze is fixed on the bandits' hideout."
msgstr ""

#. ja: <sheet EObj 2013804 0>に<sheet EventItem 2003507 0>を使う
#. de: <capitalize><noun-de EventItem 2 2003507 1 4 1></capitalize> am <noun-de EObj 5 2013804 1 3 1> ins Feuer werfen
#. fr: Utiliser <noun-fr EventItem 2 2003507 1 1> à l'endroit indiqué
#. kind: objective
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_TODO_00:1"
msgid "Use the pouch of foul-smelling attractant at the designated location."
msgstr ""

#. ja: エレンヴィルと話す
#. de: Mit Erenville sprechen
#. fr: Parler à Erenville
#. kind: objective
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_TODO_01:1"
msgid "Speak with Erenville."
msgstr ""

#. ja: デコワと話す
#. de: Mit Zekowa sprechen
#. fr: Parler à Zekowa
#. kind: objective
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_TODO_02:1"
msgid "Speak with Zekowa."
msgstr ""

#. ja: ……それじゃあ、さっそく作戦決行といくか。
#. de: Gut, dann wollen wir mal.
#. fr: Bien, il est temps de mettre notre plan à exécution.
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_001:1"
msgid "A fair number appear to be gathered inside. Now's our chance."
msgstr ""

#. ja: 俺はまた連中を見張ってるから、<br>潜入役は、おたくに任せる。
#. de: Ich werde mich darum kümmern, dass die Yeheheceyaa den Köder auch wittern und in die richtige Richtung fliegen. Dir überlasse ich unser Aromasäckchen.
#. fr: Je vais me charger de guetter les brigands. À toi de t'infiltrer dans leur camp.
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_002:1"
msgid "I will keep watch from here. The attractant I leave to you."
msgstr ""

#. ja: トナテニャイの中央にある焚き火の近くまで行ったら、<br>この「特製の匂い袋」を中に投げ入れてくれ。<br>よろしくな。
#. de: Schleich dich einfach an ihr Lagerfeuer heran und wirf es hinein. Der Rest erledigt sich dann von selbst, hoffe ich.
#. fr: Une fois que tu seras arrivé<if $gn4>e</if> près du foyer, au milieu du village, tu n'auras qu'à lancer le sac odoriférant dans le feu. Bonne chance<nbsp>!
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_003:1"
msgid "Toss it into the bonfire near the middle of town. The yeheheceyaa will come soon after."
msgstr ""

#. ja: なんだこのにおい……。
#. de: Hm? Was riecht denn hier so<nbsp>...?
#. fr: C'est quoi, cette drôle d'odeur<nbsp>!?
#. speaker: SHAALOANIGANGA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_SHAALOANIGANGA_000_010:1"
msgid "What's that smell?"
msgstr ""

#. ja: うげっ、臭えええっ！？
#. de: Uaaargh, das stinkt ja bestialisch!
#. fr: Beuargh<nbsp>! Ça schlingue<nbsp>!
#. speaker: SHAALOANIGANGA
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_SHAALOANIGANGA_000_011:1"
msgid "Ugh, that <i>reeks</i>!"
msgstr ""

#. ja: おい、てめえ何を燃やしたんだ！？
#. de: Bah! Was zum Wühler hast du denn da ins Feuer geschmissen?!
#. fr: Mais qu'est-ce que t'as jeté dans le feu, pauvre débile<nbsp>!?
#. speaker: SHAALOANIGANGB
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_SHAALOANIGANGB_000_012:1"
msgid "What did you put in the fire!?"
msgstr ""

#. ja: 俺は知らねえよお！
#. de: Ich?! Gar nichts!
#. fr: J'ai rien fait, moi<nbsp>!
#. speaker: SHAALOANIGANGA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_SHAALOANIGANGA_000_013:1"
msgid "Wasn't me, I swear!"
msgstr ""

#. ja: 臭ぇぞお前ら！
#. de: Was treibt ihr da? Das ist ja abartig!
#. fr: Quelle puanteur, bordel<nbsp>!
#. speaker: SHAALOANIGANGC
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_SHAALOANIGANGC_000_014:1"
msgid "Ugh, did something die?"
msgstr ""

#. ja: うるせえ、何事だ！？
#. de: Was schreit ihr denn alle so rum?!
#. fr: Mais qu'est-ce que c'est que tout ce vacarme, vous autres<nbsp>!?
#. speaker: WIHUWTE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_WIHUWTE_000_015:1"
msgid "Someone wanna explain that ungodly stench to me?"
msgstr ""

#. ja: ボ、ボ……ボス……あれ……！
#. de: Ch-Chef<nbsp>... Da kommt Ärger auf uns zu!
#. fr: Pa-Patron... Re-regardez<nbsp>!
#. speaker: SHAALOANIGANGB
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_SHAALOANIGANGB_000_016:1"
msgid "B-Boss...? O-Over there..."
msgstr ""

#. ja: ……あん？
#. de: Hrm?
#. fr: Hein<nbsp>?
#. speaker: WIHUWTE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_WIHUWTE_000_017:1"
msgid "Huh?"
msgstr ""

#. ja: な、な、何だありゃあああああ！？
#. de: W-Was zum Rroneek?!
#. fr: Mais qu'est-ce que ça veut dire<nbsp>!?
#. speaker: WIHUWTE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_WIHUWTE_000_018:1"
msgid "Wh-What in the world!?"
msgstr ""

#. ja: ギャァァァ！
#. de: Uaaaah!
#. fr: Hiii<nbsp>!
#. speaker: SHAALOANIGANGC
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_SHAALOANIGANGC_000_019:1"
msgid "Aaahhhhhh!"
msgstr ""

#. ja: 逃げろおおお！！
#. de: Aaah, lauft!
#. fr: Au secooours<nbsp>!
#. speaker: SHAALOANIGANGA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_SHAALOANIGANGA_000_020:1"
msgid "Run for your lives!"
msgstr ""

#. ja: チッ、あの煙のせいで興奮してるのか……！<br>誰がこんなフザけたことを……！
#. de: Tsk, dieser Qualm macht sie ganz verrückt. Wer war das?!
#. fr: Merde<nbsp>! C'est cette fumée qui les excite<nbsp>! Qui c'est qui a fait ça<nbsp>!?
#. speaker: WIHUWTE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_WIHUWTE_000_021:1"
msgid "Hmph, so the smoke's what drew them here? I swear, when I find out who did this..."
msgstr ""

#. ja: うまく誘導できたな。<br>あとは混乱に乗じて奴から腕輪を取り戻せば……
#. de: Schön, dass unsere Freunde den Weg hierher gefunden haben. Jetzt müssen wir ihm nur noch den Armreif abnehmen.
#. fr: Tout marche comme prévu. Il ne reste plus qu'à profiter de la confusion pour récupérer le bracelet.
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_022:1"
msgid "I'd say our friends have stirred up enough trouble. Time to retrieve the bracelet."
msgstr ""

#. ja: (-デコワの声-)ちょっと！　誰かっ！？
#. de: (-Zekowas Stimme-)He, kann mich jemand hören?!
#. fr: (-Voix de Zekowa-)Hé<nbsp>! Y a quelqu'un<nbsp>!?
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_023:1"
msgid "(-Zekowa-)Hey! What's going on out there!?"
msgstr ""

#. ja: (-デコワの声-)誰か、何が起きてるか教えてくれよ！<br>俺様がまだ中にいるんだぞ！
#. de: (-Zekowas Stimme-)Was ist denn los?! Kann mir jemand helfen, bitte?! Ich bin immer noch hier drin!
#. fr: (-Voix de Zekowa-)Mais qu'est-ce qui s'passe<nbsp>! J'suis encore à l'intérieur, moi<nbsp>!
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_024:1"
msgid "(-Zekowa-)I'm still in here in case you've forgotten!"
msgstr ""

#. ja: 待ってろ、あとで助ける。
#. de: Ist ja gut, wir helfen dir später.
#. fr: Patience<nbsp>! Je viendrai te délivrer après.
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_025:1"
msgid "Sit tight. We'll be back for you."
msgstr ""

#. ja: (-デコワの声-)なんだよ、あとっていつだよ！　今助けろよ！<br>置いていかれたら殺されちまうだろ！？
#. de: (-Zekowas Stimme-)Später?! Wieso denn nicht jetzt?! Bitte, sie wollen mich töten!
#. fr: (-Voix de Zekowa-)Comment ça “après”<nbsp>!? Moi, j'veux partir tout d'suite<nbsp>! J'risque d'y laisser la peau si j'reste ici<nbsp>!
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_026:1"
msgid "(-Zekowa-)What!? You gotta get me out of here now! They're gonna kill me!"
msgstr ""

#. ja: (-デコワの声-)たーのーむーよー！！
#. de: (-Zekowas Stimme-)Bitte! Ich flehe euch an!
#. fr: (-Voix de Zekowa-)Pitiééé<nbsp>!
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_027:1"
msgid "(-Zekowa-)I'm beggin' you! Please!"
msgstr ""

#. ja: おいっ、静かにしろ……！
#. de: Pst, sei doch still!
#. fr: Chut<nbsp>! Tais-toi un peu<nbsp>!
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_028:1"
msgid "Shhh! They'll hear you!"
msgstr ""

#. ja: チッ……貴様の顔、覚えたぞ。
#. de: Hrmpf, jetzt wurde ich auch noch gesehen<nbsp>...!
#. fr: Hé, toi<nbsp>! Compte sur moi pour pas oublier ta tronche<nbsp>!
#. speaker: WIHUWTE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_WIHUWTE_000_029:1"
msgid "Shit. Who was that?"
msgstr ""

#. ja: (-デコワの声-)……えっと、どうなってんの？<br>はやく助けてください、お願いします！
#. de: (-Zekowas Stimme-)Was ist los? Jetzt lasst mich schon raus<nbsp>... Biiitteee!
#. fr: (-Voix de Zekowa-)Mais c'est quoi, tout c'boucan<nbsp>!? Faut pas m'laisser comme ça<nbsp>! Sortez-moi de là<nbsp>!
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_030:1"
msgid "(-Zekowa-)Hey! Are you going to help me or what!?"
msgstr ""

#. ja: 仕方ない……。<br>ひとまずこいつを連れてここを出るぞ。
#. de: Verdammt<nbsp>... Holen wir den Bengel da raus und ziehen uns vorerst zurück.
#. fr: Bon, tant pis. Je vais aller libérer ce pauvre bougre.
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_031:1"
msgid "\\<sigh> The bracelet must wait. Let's break him out and withdraw for now."
msgstr ""

#. ja: やれやれ……。<br>無事に抜け出せたはいいが、せっかくの作戦が台無しだ。
#. de: Dabei war mein Plan so gut<nbsp>... Und alles, was er uns gebracht hat, war ein schlitzohriger Bengel.
#. fr: Hmpf<nbsp>! C'est une chose d'être sortis indemnes du village, mais on ne peut pas dire que cette opération soit une réussite.
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_040:1"
msgid "All that effort, and naught to show for it..."
msgstr ""

#. ja: なんか……すまねえ……！<br>いや、まさかあんたたちがヴァルチャーを相手に、<br>ケンカを仕掛けてたなんて、全然知らなくてよお……！
#. de: He<nbsp>... Tut mir wirklich leid, ja? Aber ich wusste ja nicht, dass ihr hinter dem Geier her seid!
#. fr: J'suis franchement désolé<nbsp>! J'avais aucune idée que vous essayiez de cueillir le Vautour<nbsp>!
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_041:1"
msgid "Sorry about that... But damn, I didn't think anyone would have the balls to take on the Vulture!"
msgstr ""

#. ja: ……別に謝る必要はない。<br>一応は、おたくを助けることも考えてはいたからな。
#. de: Schon in Ordnung. Wir hatten ohnehin überlegt, ob wir dich retten kommen sollen.
#. fr: Ce n'est pas la peine de t'excuser. Nous avions aussi prévu de te libérer, à vrai dire.
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_042:1"
msgid "No need to apologize. We were planning to save you. Eventually."
msgstr ""

#. ja: え、そうなの！？<br>誰か知らねえけど……もしかして、このデコワ様のファンとか？
#. de: Was, wirklich?! Wie komm ich denn zu der Ehre? Sagt bloß, ihr habt von mir gehört und seid so was wie Anhänger?
#. fr: Vraiment<nbsp>!? Mais pourquoi<nbsp>? Vous allez pas m'dire que vous faites partie de mes fans, quand même<nbsp>!?
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_043:1"
msgid "Really? And I don't even know who you are. You secret admirers of mine or something?"
msgstr ""

#. ja: まあ、誰でもいいや！<br>助けてくれたこと、本当に感謝してるぜ！
#. de: Na, ist ja auch egal! Vielen Dank für die Rettung, jedenfalls!
#. fr: J'plaisante, hein<nbsp>! En vrai, tout c'qui compte, c'est que vous m'ayez sorti de là. Merci<nbsp>!
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_044:1"
msgid "Hehe, I'm just havin' fun with you. But I do appreciate the help."
msgstr ""

#. ja: それよりも、おたくがヴァルチャーと呼んでいる人物……<br>野盗どもに「ボス」と呼ばれていた男の顔に、見覚えがある。
#. de: Der Kerl, den du Geier nennst<nbsp>... Sein Gesicht hab ich doch irgendwo schon einmal gesehen.
#. fr: Mais dis, ce type que tu nommes le Vautour, autrement dit, le chef de ces brigands, j'ai l'impression d'avoir déjà vu son visage quelque part.
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_100_044:1"
msgid "This man they call the Vulture. I've seen his face before."
msgstr ""

#. ja: あいつは……フーサタイ宿場町で、<br>おたくと言い争いをしてた奴じゃなかったか？
#. de: War das nicht der blonde Staubwächter, mit dem du dich in Hhusatahwi angelegt hast?
#. fr: Ce ne serait pas avec lui que tu te querellais à Hhusatahwi<nbsp>?
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_110_044:1"
msgid "Was he not the officer you confronted in town?"
msgstr ""

#. ja: ああ、そうだ……。<br>あるときは「ヴァルチャー」の異名で知られる悪党、<br>またあるときは、自警隊の副隊長「ウィフーテ」ってわけさ。
#. de: Ganz genau. Als Geier ist er der berüchtigte Anführer dieser scheiß Hals<shy>ab<shy>schnei<shy>der hier, aber die meisten kennen ihn einfach nur als <i>Vizekommandant</i> Wihuwte.
#. fr: Si, si<nbsp>! Quand il est avec ses hommes de main, il s'fait appeler le “Vautour”, mais en public, il est connu sous le nom de Wihuwte, le shérif adjoint.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_120_044:1"
msgid "The one and the same. When he's not masquerading as a gang leader, he serves as deputy chief of the Dustwatch. "
msgstr ""

#. ja: 法を司る自警隊の中に、無法者の親玉が潜り込んでる……。<br>本当だったってことか……。
#. de: Hrm, da hat er sich ja ein schönes Doppelleben zurechtgelogen<nbsp>...
#. fr: Le patron des brigands se cache donc bien au sein même de la milice<nbsp>!
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_130_044:1"
msgid "That would explain why the bandits are so confident they can avoid capture."
msgstr ""

#. ja: なあ……礼と言っちゃなんだが、俺様にも協力させてくれねぇか？<br>あんたら、ヴァルチャーが持ってる盗品を取り戻したいんだろ？
#. de: A-Aber sagt mal, würdet ihr mich vielleicht mithelfen lassen? Ihr wollt doch das Zeug zurückholen, das der Geier gestohlen hat, oder nicht?
#. fr: Dites, pour vous montrer ma gratitude, j'aimerais que vous m'laissiez vous aider. Vous voulez récupérer un objet que l'Vautour et ses hommes ont volé, pas vrai<nbsp>?
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_045:1"
msgid "You're trying to get back something the Vulture stole, right? Let me help. It's the least I can do after you bailed me out back there. "
msgstr ""

#. ja: あのクソジジイがいつも盗品を隠す場所なら、心当たりがある。<br>きっと今も、そこに向かったはず！
#. de: Und zufällig weiß ich, wo der alte Sack all sein Diebesgut versteckt! Ganz bestimmt hat er sich jetzt auch genau dorthin abgesetzt!
#. fr: J'ai une petite idée de l'endroit où ce fumier cache son butin. Et quelque chose me dit qu'c'est là-bas qu'il est parti<nbsp>!
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_046:1"
msgid "I have an idea where he's hid his cache. Reckon he's headed there now, too."
msgstr ""

#. ja: だからさ……俺様を仲間に加えてくれよ。<br>どうしても、あいつと決着をつけなきゃなんねぇんだ……！
#. de: Also lasst mich mitmachen, bitte! Ich hab mit dem Mistkerl noch eine gewaltige Rechnung offen!
#. fr: Je vous en prie, faites-moi confiance<nbsp>! Moi aussi, j'ai des comptes à régler avec lui<nbsp>!
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_047:1"
msgid "We can go together. I've got a score to settle with him myself."
msgstr ""

#. ja: ……まだおたくのことを信用したわけじゃない。<br>事情があるなら話してくれ。
#. de: Wir haben keinerlei Grund, dir einfach so über den Weg zu trauen. Also erzähl uns wenigstens, was dir der Geier getan hat, dass du so wütend auf ihn bist.
#. fr: Avant de te croire sur parole, j'aimerais que tu nous en dises plus sur ce qui t'est arrivé et pourquoi tu en veux au Vautour et à sa clique. D'accord<nbsp>?
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_048:1"
msgid "I don't doubt that you do, but we need to know what it is first. Will you tell us?"
msgstr ""

#. ja: トナテニャイにいた奴ら……<br>「荒野の夜明け団」は、俺様とダチが立ち上げた組織さ。
#. de: Die Bande in Tonatenyawi<nbsp>... Dämmerreiter nennen sie sich. Aber eigentlich haben ich und meine Freunde die Dämmerreiter gegründet.
#. fr: Ces types que vous avez vu à Tonatenyawi, c'est les “Justiciers des plaines”, une bande que moi et mes potes, on a formée y a trois ans.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_049:1"
msgid "Right, so. Those bandits at Tonatenyawi? They're called the Daybreakers, and it was me and my friends that founded the group..."
msgstr ""

#. ja: も、もちろん、野盗の組織なんかじゃないぞ？
#. de: N-Nicht als Diebesbande, schaut nicht so!
#. fr: Bien sûr, à l'origine, le but c'était pas de devenir des brigands.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_050:1"
msgid "B-But it wasn't a gang of cutthroats! Not back then..."
msgstr ""

#. ja: 子どもとか貧しい奴らとか、とにかく弱い立場の労働者を、<br>悪徳採掘業者から護るために作った、正義の組織だったんだ！
#. de: Nein, wir<nbsp>... Wir haben uns geformt, um die Schwachen vor der Ausbeutung durch korrupte Minenbetreiber zu schützen! Die Kinder, die Alten, die Armen<nbsp>...
#. fr: Les Justiciers des plaines devaient protéger les travailleurs en position de faiblesse, les enfants et les plus démunis, contre les patrons véreux des compagnies d'extraction<nbsp>!
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_051:1"
msgid "We just wanted to protect people who couldn't protect themselves. Kids being harassed by bullies, workers being exploited by the mining concerns─folks who needed help to even the odds."
msgstr ""

#. ja: 今から3年前……<br>俺様はふたりのダチと「荒野の夜明け団」を作った。<br>そんで、陰で悪さを働くクソどもを成敗してきたのさ！
#. de: Das ist jetzt drei Jahre her. Und seither geht es den Schurken gehörig an den Kragen, die den Leuten hier Böses wollen!
#. fr: Et pour ça, mes camarades et moi, on s'occupait de punir tous les sales escrocs qui agissaient mal.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_052:1"
msgid "That was three years ago. And whenever we found someone scheming in the shadows, we settled matters the best way we knew how."
msgstr ""

#. ja: 俺様たちが得意な……「決闘」でよ！
#. de: Denn wir verlieren nie ein Duell!
#. fr: Notre méthode de prédilection, c'était les duels<nbsp>!
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_053:1"
msgid "With a duel!"
msgstr ""

#. ja: なるほど、揉め事があった場合には決闘で白黒つける……<br>その「荒野の掟」がある限り、決闘で勝ちさえすれば、<br>大人の悪党相手でも意思を通せていたわけか。
#. de: Ah<nbsp>... Ihr habt euch also ganz klassisch auf den alten Weg der Wildnis verlassen, die Unruhestifter zu Duellen herausgefordert und konntet damit selbst großkalibrige Probleme eigenhändig lösen?
#. fr: Je vois. Tant que la loi des plaines était en vigueur, vous pouviez imposer votre vision du bien aux méchants adultes de cette manière.
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_054:1"
msgid "I see. By the old laws, anyone who loses in a duel must be held to account for their crimes, even those in positions of authority. "
msgstr ""

#. ja: ああ、そうやって活動しているうちに、<br>身寄りのない奴らが俺様たちのとこに集まるようになって、<br>「荒野の夜明け団」は、そこそこの人数になったよ。
#. de: Ganz genau. Und mit der Zeit schlossen sich uns mehr und mehr Leute an und unsere Dämmerreiter wuchsen zu einer ordentlich großen Gruppe heran.
#. fr: Ouais, et petit à petit, on a été rejoints par d'autres laissés pour compte, et les rangs des Justiciers des plaines ont beaucoup grandi.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_055:1"
msgid "And we made damn sure they did, every time. Before we knew it, our small band of friends commanded a force to be reckoned with."
msgstr ""

#. ja: だけど……1年前にヴァルチャーが手下を連れてやってきて、<br>みんなボコボコにされてさ……組織を乗っ取られちまった。
#. de: Bis vor einem Jahr dann der verdammte Geier mit seinen Halunken kam, uns alle ordentlich aufmischte und kurzerhand die ganze Gruppe an sich riss.
#. fr: Tout allait bien jusqu'à l'arrivée du Vautour et de ses hommes de main, il y a un an. Cet enfoiré nous a mis une bonne correction et nous a piqué notre bande.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_056:1"
msgid "Then, about a year ago, the Vulture and his thugs showed up. They got the better of us and took over the Daybreakers."
msgstr ""

#. ja: そっからみんな、ヴァルチャーが怖くて従うようになったんだ。<br>あいつが掲げる楽な稼ぎに、目がくらんだ奴もいるけどさ。
#. de: Er hat einfach alle dermaßen eingeschüchtert, dass sie vor lauter Angst komplett nach seiner Pfeife tanzen. Andere wiederum sind hinter dem schnellen Geld her, das man unter ihm verdienen kann.
#. fr: Tout le monde a eu peur de lui et s'est mis à lui obéir. Y en a aussi qui s'sont laissés avoir par ses promesses de gagner d'l'argent facilement.
#. speaker: ZEKOWA
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_057:1"
msgid "Everyone was afraid of him, so they did his bidding without question. But when he showed them how they could make a fortune, easily─<i>that</i> was when he really won them over."
msgstr ""

#. ja: 今じゃ「荒野の夜明け団」は最低の野盗集団だ……。<br>護るべき弱い奴から金品を巻き上げて、<br>大笑いしてるんだからよ。
#. de: Und so sind unsere Dämmerreiter nur noch eine dreckige Diebesbande, nichts weiter. Sie pressen jeden Pel aus den Leuten heraus, die <i>wir</i> eigentlich schützen wollten! Es ist zum Kotzen.
#. fr: À cause de lui, les Justiciers des plaines sont devenus la pire bande de brigands du coin. Ils volent les plus faibles au lieu d'les protéger.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_058:1"
msgid "Now the Daybreakers is nothing but a bunch of bandits and cutthroats who prey on the people it was created to protect."
msgstr ""

#. ja: だから、俺様たち3人は最後の手を使うことにした。<br>ヴァルチャーに「決闘」を挑んだのさ。
#. de: Also haben ich und meine beiden Freunde einen letzten Versuch gestartet und den Geier zu einem Duell herausgefordert.
#. fr: Mes potes et moi, on a voulu régler ce problème une bonne fois pour toutes<nbsp>: on a provoqué le Vautour en duel.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_059:1"
msgid "I talked it over with my friends, Kwikana and Liwine, and we all agreed the only way to stop him was to challenge him to a duel."
msgstr ""

#. ja: 奴は受けて立つと豪語したよ。<br>それなのに……
#. de: Natürlich ist er ganz prahlerisch herumstolziert und hat verkündet, dass er es annehmen würde.
#. fr: Il avait alors annoncé haut et fort qu'il relèverait notre défi.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_060:1"
msgid "And he accepted. I still remember how he gloated that he'd win..."
msgstr ""

#. ja: 決闘の日、約束の場所に現れたヴァルチャーは、<br>自警隊の副隊長として、クイカナとリウィネを逮捕したんだ。<br>強盗行為を働いたっていう濡れ衣を着せてな。
#. de: Aber am Tag des Duells ist er dann als Vizekommandant neben Kemakka aufgetaucht und sie haben meine Freunde Kwikana und Liwine einfach festgenommen! Der Wühlerarsch behauptete einfach, sie hätten jemanden überfallen.
#. fr: Mais au lieu d'ça, le Vautour a profité de sa qualité de shérif adjoint pour faire arrêter Kwikana et Liwine en prétextant qu'ils avaient commis des actes de brigandage.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_061:1"
msgid "But when the day came, he showed up with the Dustwatch and had my friends arrested on charges of robbery."
msgstr ""

#. ja: おまけにあのジジイ、仲間を釈放してほしかったら、<br>アホみたいな額の金を用意しろと脅してきたんだぜ！？
#. de: Und wenn ich sie je wieder auf freiem Fuß sehen will, müsse ich eine Kaution zahlen, hat er gesagt. Eine viel zu hohe nämlich, die ich mir niemals leisten kann!
#. fr: Et pour couronner l'tout, ce sale chien m'a réclamé une somme exorbitante pour faire libérer mes camarades<nbsp>!
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_062:1"
msgid "As if that wasn't enough, he set their bail at a price no one could ever hope to pay."
msgstr ""

#. ja: 信頼できるダチふたりは牢の中……<br>かつての仲間も、自警隊も頼ることはできなくて、<br>どうすればいいのか、わからなくてよぉ……。
#. de: Meine Freunde sind im Gefängnis, die Staubwacht glaubt mir kein Wort und die Dämmerreiter sind in Wihuwtes Hand<nbsp>... Ich weiß nicht, was ich noch machen soll.
#. fr: Les deux seules personnes en qui j'ai confiance sont sous les verrous. Ni mes autres con<shy>nais<shy>san<shy>ces ni la milice peuvent rien pour m'aider. Je sais franchement plus quoi faire.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_063:1"
msgid "With them locked away, there was no one left to help me. None of my old friends from the Daybreakers, and certainly not the Dustwatch..."
msgstr ""

#. ja: それで、ヤケになって直談判しにいったってわけか。
#. de: Und vor lauter Frust hast du ihn dann mitten in Hhusatahwi konfrontiert?
#. fr: Et donc, dans ces cir<shy>cons<shy>tan<shy>ces, tu as choisi d'aller négocier directement avec lui.
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_064:1"
msgid "And that's why you were ready to challenge him in the middle of town."
msgstr ""

#. ja: ああ、軽くあしらわれて頭にきてさ！<br>銃で撃とうとしたところで、変な槍使いのおっさんに止められた。
#. de: Es hat mich einfach so wütend gemacht, wie arrogant und selbstsicher er durch Shaaloani spaziert! Ich hätte auf ihn geschossen, wäre mir nicht dieser komische, spitzohrige Kerl in die Quere gekommen.
#. fr: Ouais, mais j'ai pété les plombs quand il m'a rembarré<nbsp>! Et au moment où j'ai voulu lui faire la peau avec mon flingue, un drôle de type armé d'une lance est intervenu pour m'en empêcher.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_065:1"
msgid "I was, until that guy with the spear stopped me."
msgstr ""

#. ja: そのうえフーサタイ宿場町から出たところで、<br>ヴァルチャーの手下たちに、不意打ち食らわされて捕まってさ。<br>……まあ、今に至るってカンジだ。
#. de: Zu allem Überfluss haben mich seine Arschkriecher dann auch noch erwischt, als ich mich aus dem Staub machen wollte<nbsp>...
#. fr: Des hommes du Vautour m'ont ensuite tendu une embuscade lorsque je partais de Hhusatahwi, et c'est comme ça que j'ai fini entre leurs mains.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_066:1"
msgid "No sooner had I stepped out of town than the Vulture's minions caught me by surprise. They took me prisoner, then...well, you know the rest."
msgstr ""

#. ja: ……なるほどな。<br>自警隊は、全員がグルなのか？
#. de: Verstehe. Hat er denn die gesamte Staubwacht in der Tasche, sag mal?
#. fr: Je comprends mieux. Est-ce que tous les membres de la milice sont à la solde du Vautour<nbsp>?
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_067:1"
msgid "You said the Dustwatch would be of no help. Are they all working for the Vulture, then?"
msgstr ""

#. ja: いや、それはないな。<br>ヴァルチャーと、その側近くらいだと思うぜ。
#. de: Nein, das nicht. Nur ihn und seine paar Handlanger.
#. fr: Non, encore heureux. J'pense que c'est seulement lui et ses acolytes.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_068:1"
msgid "No, not all of them."
msgstr ""

#. ja: ケマッカ隊長の正義感は本物さ。<br>ただ、かなり鈍感だから、いいように騙されてるんだ。
#. de: Kommandant Kemakka ist ein aufrichtiger Kerl. Aber leider auch ziemlich gutgläubig, weswegen er sich auch so leicht von Wihuwte hinters Licht führen lässt.
#. fr: Le shérif Kemakka est un homme juste. Le problème, c'est qu'il est pas très perspicace et s'laisse facilement berner par ces salauds.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_069:1"
msgid "The sheriff, Kemakka─he's as honest as they come, a staunch keeper of the peace. Problem is, he's a little too trusting and doesn't suspect a thing."
msgstr ""

#. ja: 自警団に垂れ込んだところで、<br>悪ガキとしか思われてない俺様と副隊長の意見、<br>どっちを聞くと思う？
#. de: Selbst wenn ich ihm jetzt alles erzählen würde, was ich weiß<nbsp>... Abkaufen würde er mir das nie. Wihuwte ist immerhin sein Vizekommandant.
#. fr: De toute manière, si j'allais parler de tout ça à la milice, qui est-ce qu'on croirait entre un mauvais garnement comme moi et le shérif adjoint, à votre avis<nbsp>?
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_070:1"
msgid "If it were my word against the deputy chief's, who do you think he'd believe?"
msgstr ""

#. ja: 俺たちの目的は、ナミーカさんの腕輪を取り戻すことだ。<br>こいつが本当に盗品の隠し場所を知ってるなら使えると思うが……<br>どうする？
#. de: In erster Linie wollen wir Namikkas Armreif wieder zurück. Wenn er also wirklich weiß, wo Wihuwte sein Diebesgut lagert, würde uns das einen großen Schritt weiterbringen. Was sollen wir mit ihm machen?
#. fr: Notre but, c'est avant tout de récupérer le bracelet de Namikka. S'il dit vrai et qu'il sait où les objets volés sont cachés, on sera déjà plus avancés. Qu'en penses-tu<nbsp>?
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_071:1"
msgid "Well, if he knows where this Vulture keeps his spoils, perhaps he can help us recover Namikka's bracelet. What do you think?"
msgstr ""

#. ja: 頼むよ、俺様なりに作戦も考えたんだ！<br>ただ、ひとりじゃ実現できねぇ……！
#. de: Bitte! Ich hab sogar schon einen Plan, aber alleine kann ich ihn nicht umsetzen!
#. fr: Je vous en supplie<nbsp>! J'ai moi aussi réfléchi à un plan<nbsp>! Mais je pourrai pas y arriver tout seul<nbsp>!
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_072:1"
msgid "For what it's worth, I have a plan. But I can't do it alone."
msgstr ""

#. ja: 作戦？
#. de: Ach so?
#. fr: Comment ça, un plan<nbsp>?
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_073:1"
msgid "A plan?"
msgstr ""

#. ja: ああ……！<br>「シェシェネ青燐泉」の入口まで来てくれよ！<br>判断は説明を聞いてからでいいからさ！
#. de: Aber ja! Trefft mich an den Sheshenewezi-Quellen, dann erklär ich euch alles!
#. fr: Ouais<nbsp>! Tout ce que je vous demande, c'est de me retrouver à l'entrée des sources de Sheshenewezi. Vous n'aurez qu'à prendre votre décision après avoir écouté mes ex<shy>pli<shy>ca<shy>tions.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_074:1"
msgid "All I ask is that you hear me out─but not here. I'll be waiting for you at Sheshenewezi Springs. "
msgstr ""

#. ja: ……とりあえず話だけでも聞いてみるか。
#. de: Es kann nicht schaden, es uns zumindest einmal anzuhören, denke ich.
#. fr: Nous n'avons rien à perdre à savoir ce qu'il mijote, tu ne crois pas<nbsp>?
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_075:1"
msgid "I guess we can decide what to do after he gives us the pitch."
msgstr ""

#. ja: いやあ……助かったぜ！<br>なんか間が悪かったみたいだけど……まずいカンジ？
#. de: Was bin ich froh, dass ihr mich da endlich rausgeholt habt! Für einen Moment hatte ich wirklich gedacht, ihr würdet mich einfach in Tonatenyawi lassen<nbsp>...
#. fr: Merci de m'avoir tiré d'là<nbsp>! J'espère que je vous ai pas mis dans la mouise, hein<nbsp>?
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_080:1"
msgid "Thanks, I owe you one. For a moment there I thought you might actually leave me behind."
msgstr ""

#. ja: なんでシェシェネ青燐泉まで来たのかって？
#. de: Ihr fragt euch sicher, was wir hier machen. Unter den Augen aller Leute.
#. fr: Vous vous demandez pourquoi j'vous ai dit de venir jusqu'aux sources de Sheshenewezi, pas vrai<nbsp>?
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_090:1"
msgid "Good, you're here."
msgstr ""

#. ja: 盗品の隠し場所こそが、この町だからさ……！<br>まあ見てなって、今に奴が現れるぜ。
#. de: Der Geier versteckt sein Diebesgut direkt in der Stadt. Wartet nur, er wird gleich selbst hier auftauchen.
#. fr: C'est parce que l'endroit où le Vautour planque son butin se trouve ici<nbsp>! Attendez un peu, j'suis sûr qu'il va pas tarder à s'montrer.
#. speaker: ZEKOWA
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ZEKOWA_000_091:1"
msgid "This is where he hides his loot. I expect he'll show up soon."
msgstr ""

#. ja: 言われたとおりに移動したはいいが……<br>こいつを連れてるところを自警隊に見つかったらマズいな。
#. de: So ganz überzeugt bin ich nicht von dieser Sache. Wenn uns jemand gemeinsam mit dem Bengel hier sieht, könnte das unsere Pläne in Gefahr bringen.
#. fr: Je n'ai rien contre le fait de le suivre, mais ce ne serait pas une bonne chose que des membres de la milice nous voient en sa compagnie, à mon avis.
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmd104_04915:TEXT_KINGMD104_04915_ERENVILLE_000_095:1"
msgid "I'm grateful he could take us to the deputy chief, but it will all be for naught if we're seen."
msgstr ""
