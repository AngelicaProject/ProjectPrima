# quest/049/KinGmf111_04956 — «An Explorer's Delight» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: ファイアターミナルのカフキワは、次のエリアに向かいたいようだ。
#. de: Cahciua ist gedanklich bereits beim nächsten Areal.
#. fr: Cahciua n'attend que votre signal pour continuer.
#. kind: journal
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_SEQ_00:1"
msgid "Cahciua is ready to head to the fourth and final zone."
msgstr ""

#. ja: カフキワと話す
#. de: Mit Cahciua sprechen
#. fr: Parler à Cahciua
#. kind: objective
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_TODO_00:1"
msgid "Speak with Cahciua."
msgstr ""

#. ja: ウィンドパスガーデンの警備員と話す
#. de: Mit der Wache der Windpfadgärten sprechen
#. fr: Parler à la sentinelle des jardins de Soufflevent
#. kind: objective
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_TODO_01:1"
msgid "Speak with the Windspath Gardens guard."
msgstr ""

#. ja: カフキワと話す
#. de: Mit Cahciua sprechen
#. fr: Parler à Cahciua
#. kind: objective
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_TODO_02:1"
msgid "Speak with Cahciua."
msgstr ""

#. ja: カフキワと再度話す
#. de: Erneut mit Cahciua sprechen
#. fr: Reparler à Cahciua
#. kind: objective
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_TODO_03:1"
msgid "Speak with Cahciua again."
msgstr ""

#. ja: 次でカフキワとも……。
#. de: Im nächsten Areal sind Cahciuas Erinnerungen gespeichert<nbsp>...
#. fr: Bientôt, ça sera au tour de Cahciua...
#. speaker: WUKLAMAT
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_WUKLAMAT_000_001:1"
msgid "Next, we have to part with..."
msgstr ""

#. ja: 次が最後か……。
#. de: Das letzte Areal<nbsp>...
#. fr: Plus qu'un terminal à éteindrrre...
#. speaker: GRAHATIA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_GRAHATIA_000_005:1"
msgid "Just one zone remaining..."
msgstr ""

#. ja: 両親の記憶は消えても、受け取った愛情は忘れない。<br>きっとこの思い出が、私の背中を押してくれるから……！
#. de: Die Erinnerungen meiner Eltern mögen zwar gelöscht sein, aber die Liebe, die sie mir gaben, wird mich für immer begleiten. Meine Zeit mit ihnen soll mir den nötigen Rückenwind auf meinem weiteren Pfad geben.
#. fr: Même si les souvenirs de mes parents ont disparu, ils resteront toujours à mes côtés pour m'encourager.
#. speaker: KRILE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_KRILE_000_010:1"
msgid "Their memories may be gone, but their love will be with me always..."
msgstr ""

#. ja: …………。
#. de: ...
#. fr: ...
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_ERENVILLE_000_015:1"
msgid "..."
msgstr ""

#. ja: さてと……！<br>終わりが迫ってくると、時間が経つのも早く感じるもんだねぇ。
#. de: Hach. Wenn das Ende naht, vergeht die Zeit immer so schnell<nbsp>...
#. fr: ... Bon<nbsp>! J'ai l'impression que plus on s'approche de la fin, plus le temps passe vite.
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_020:1"
msgid "I must say, the closer we get to the end, the faster time seems to pass us by."
msgstr ""

#. ja: さっそく次のエリアに向けて移動しよっか！<br>行き方はもう説明しなくてもわかるね？
#. de: Wir sollten uns flugs auf zum nächsten Areal machen. Ihr wisst ja inzwischen schon wie's geht, richtig?
#. fr: N'attendons pas plus et partons pour la zone suivante. Inutile que je vous explique comment vous y rendre, j'imagine<nbsp>?
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_021:1"
msgid "Come, let's head to the fourth and final zone. By now you know how to get there, yes?"
msgstr ""

#. ja: …………あ、ああ。
#. de: ... Ja, das tun wir.
#. fr: ... Oui, on commence à avoir l'habitude.
#. speaker: WUKLAMAT
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_WUKLAMAT_000_022:1"
msgid "Yes, we do."
msgstr ""

#. ja: おっけー！<br>メインターミナルの様子も見ておきたいし、<br>あたしもひとまず「リメンバー・ゲート」に向かうよ！
#. de: Sehr gut! Dann bis gleich am Tor des Gedenkens! 
#. fr: Parfait<nbsp>! Je dois aller vérifier quelque chose sur le mésoterminal, donc rendez-vous à la porte du Souvenir<nbsp>!
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_023:1"
msgid "Excellent. This time, I'd like to quickly check on the Meso Terminal, so I'll meet you at the Gate of Remembrance."
msgstr ""

#. ja: ……行こう、みんな。
#. de: ... Gehen wir.
#. fr: Allez, encore un effort.
#. speaker: WUKLAMAT
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_WUKLAMAT_000_024:1"
msgid "Come on, everyone..."
msgstr ""

#. ja: エレンヴィル……。
#. de: Ach, Erenville<nbsp>...
#. fr: Erenville...
#. speaker: WUKLAMAT
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_WUKLAMAT_000_025:1"
msgid "Oh, Erenville..."
msgstr ""

#. ja: ……いよいよか。
#. de: ... Dann ist es wohl so weit.
#. fr: Cette fois, ça y est...
#. speaker: GRAHATIA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_GRAHATIA_000_030:1"
msgid "So this is it..."
msgstr ""

#. ja: ……寂しいけれど、<br>カフキワさんの願いでもあるのよね。
#. de: Natürlich macht es mich traurig. Aber wenn das Cahciuas Wunsch ist, sollten wir ihn respektieren.
#. fr: Encore une fois, ça ne va pas être facile... Mais c'est le souhait de Cahciua, et nous devons le respecter.
#. speaker: KRILE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_KRILE_000_035:1"
msgid "Like before, it will be hard, but we must honor Cahciua's wish."
msgstr ""

#. ja: …………。
#. de: ...
#. fr: ...
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_ERENVILLE_000_040:1"
msgid "..."
msgstr ""

#. ja: メインターミナルの様子だけど、<br>あたしの見立てじゃ、まだ猶予がありそうだね。
#. de: Wegen des Meso-Systems<nbsp>... Meiner Einschätzung nach sollten wir noch ein klein wenig Zeit haben!
#. fr: À vue de nez, le mésoterminal va encore avoir besoin d'un peu de temps pour terminer ses calculs.
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_050:1"
msgid "As far as I can tell, we still have some leeway with the Meso Terminal."
msgstr ""

#. ja: あんたたちの「永久人を知りたい」って目的も、<br>このペースで進めていくぶんには問題なしさ！
#. de: Eurem selbst gesteckten Ziel, die Endlosen besser kennenzulernen, könnt ihr also auch im nächsten Areal nach Herzenslust frönen!
#. fr: Ça veut dire que vous pouvez continuer à aborder les Éternels, comme vous l'avez fait jusqu'ici<nbsp>!
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_051:1"
msgid "Meaning you can carry on getting to know the Endless in the last zone."
msgstr ""

#. ja: ということで、いよいよ残すは最後のエリア、<br>「ウィンドパスガーデン」だ！
#. de: Der Name des Gebiets? Die Windpfadgärten!
#. fr: Les jardins de Soufflevent seront notre dernière destination.
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_052:1"
msgid "Windspath Gardens, it's called, and it's breathtakingly beautiful!"
msgstr ""

#. ja: ……おふくろの記憶もそこにあるって言ったよな。
#. de: ... Dort sind auch deine Erinnerungen gespeichert, hab ich Recht?
#. fr: ... C'est là que tes souvenirs sont stockés, hein<nbsp>?
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_ERENVILLE_000_053:1"
msgid "That's where your memories are stored, yes?"
msgstr ""

#. ja: そうさ、あんたたちを導く責任があったから、<br>ちゃっかり最後に残しちゃったけどさ！
#. de: Ganz genau. Ich war schamloserweise einfach so frei, ausgerechnet mein Areal bis zuletzt aufzusparen<nbsp>... aber irgendjemand musste euch ja schließlich herumführen. Die Endlosen der anderen Areale werden es mir sicher verzeihen!
#. fr: Oui, j'ai gardé cette zone pour la fin. Il fallait bien que je sois là pour vous guider<nbsp>!
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_054:1"
msgid "That's right. I left it for last so I could guide you for as long as possible. Very thoughtful of me, yes?"
msgstr ""

#. ja: あっ……どうしよう！<br>いいこと思いついちゃった！
#. de: Ah! Da kommt mir gerade eine bahnbrechende Idee!
#. fr: ... Ah, je viens tout juste d'avoir une riche idée<nbsp>!
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_055:1"
msgid "Ooh! A great idea just occurred to me!"
msgstr ""

#. ja: いいこと……？
#. de: Was denn?
#. fr: Oh<nbsp>? On t'écoute...
#. speaker: WUKLAMAT
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_WUKLAMAT_000_056:1"
msgid "What might that be?"
msgstr ""

#. ja: ふふふ……向こうで話そうかな。<br>あたしは先に行ってるから、みんなはジップラインで来るんだよ！
#. de: Hehe<nbsp>... Das erzähl ich euch, sobald ihr ankommt! Ich geh schon mal vor<nbsp>- alles wie gehabt also!
#. fr: Héhé... Vous en saurez plus une fois sur place. Je pars devant, rendez-vous aux jardins de Soufflevent<nbsp>!
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_057:1"
msgid "\\<chuckle> I'll save it for after we've arrived on the other side. See you there!"
msgstr ""

#. ja: ……あいつの言う「いいこと」ってのは、<br>だいたいロクなことじゃないからな。
#. de: Nur damit ihr es wisst<nbsp>- ihre „Ideen“ sind oftmals eher beinbrechend als bahnbrechend<nbsp>...
#. fr: Ses “riches idées” sont plutôt <i>pauvres</i>, en général...
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_ERENVILLE_000_058:1"
msgid "Her “great ideas” are generally less than great."
msgstr ""

#. ja: なあ、エレンヴィル……。
#. de: Ach, Erenville<nbsp>...
#. fr: Dis, Erenville...
#. speaker: WUKLAMAT
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_WUKLAMAT_000_059:1"
msgid "Hey, Erenville?"
msgstr ""

#. ja: アタシはお前の意思を尊重したいって思ってる。<br>だけど同時に、カフキワの想いも叶えたい。
#. de: Ich verstehe ja, wie schwer das alles für dich sein muss und ich will deinen Willen auch wirklich respektieren, aber<nbsp>... gleichzeitig will ich Cahciua eben auch ihre Wünsche erfüllen.
#. fr: Je suis consciente que la situation est éprouvante pour toi, mais je veux aussi réaliser le vœu de Cahciua.
#. speaker: WUKLAMAT
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_WUKLAMAT_000_060:1"
msgid "As much as I want to grant your mother her wish, I also want to respect yours."
msgstr ""

#. ja: ……悔いは残してほしくねぇんだ。<br>できれば最期は、笑顔でいてほしい。
#. de: ... Sie soll ihre letzten Momente nicht mit Reue, sondern Freude verbringen.
#. fr: Quand tout sera fini, je souhaite que toi comme elle, vous ayez aucun regret. Alors si tu pouvais lui dire adieu avec le sourire...
#. speaker: WUKLAMAT
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_WUKLAMAT_000_061:1"
msgid "When all's said and done, I want you to be happy. I hope you know this."
msgstr ""

#. ja: わかってる。
#. de: Das ist mir schon klar.
#. fr: ... Je sais.
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_ERENVILLE_000_062:1"
msgid "I know."
msgstr ""

#. ja: わかってるさ……。
#. de: <i>Sowas</i> von klar<nbsp>...
#. fr: Je sais, mais...
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_ERENVILLE_000_063:1"
msgid "I know..."
msgstr ""

#. ja: ……あいつにとってカフキワは、<br>母親であると同時に、憧れの師でもあったんだ。<br>簡単に割り切れなくて当然さ。
#. de: Bitte habt Nachsicht mit ihm. Cahciua war für ihn nicht nur seine Mutter, sondern eben auch eine Mentorin, zu der er sein ganzes Leben lang aufgeblickt hat. Da ist es nur verständlich, dass ihm der Abschied nun ganz besonders schwerfällt.
#. fr: Cahciua est non seulement la mère d'Erenville, mais aussi un mentor qu'il respecte beaucoup. Ça doit pas être facile de faire la part des choses...
#. speaker: WUKLAMAT
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_WUKLAMAT_000_064:1"
msgid "Cahciua isn't only his mother─she's his mentor as well. That can only make it harder for him to say good-bye."
msgstr ""

#. ja: 行こう……アタシたちのやることは変わらねぇ。<br>永久人たちを知って、その想いをしっかり受け止めるんだ。
#. de: An unserem Vorhaben soll das aber nichts ändern. Versuchen wir, so viel wie möglich über die Endlosen in Erfahrung zu bringen. Ihre Hoffnungen und Wünsche wollen wir für die Nachwelt festhalten.
#. fr: Mais ça change rien à l'objectif qu'on s'est fixé<nbsp>: connaître les Éternels pour conserver en nous leur souvenir... Allons-y. 
#. speaker: WUKLAMAT
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_WUKLAMAT_000_065:1"
msgid "Let's go. For now, we keep doing what we've been doing: seeking out Endless and learning what's dear to them."
msgstr ""

#. ja: 行こうぜ！<br>向こうでカフキワが待ってるからな。
#. de: Cahciua erwartet uns schon. Lasst uns also schnell weiter!
#. fr: Essayons de pas faire attendre Cahciua.
#. speaker: WUKLAMAT
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_WUKLAMAT_000_070:1"
msgid "Let's not keep Cahciua waiting."
msgstr ""

#. ja: ……彼は強いよ。<br>オレたちも最後まで見届けよう。
#. de: ... Erenville ist stark. Und wir sollten das auch sein. 
#. fr: Erenville est un dur à cuirrre, mais on sera là pour l'accompagner.
#. speaker: GRAHATIA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_GRAHATIA_000_075:1"
msgid "I have faith in Erenville's inner strength."
msgstr ""

#. ja: カフキワさんの「いいこと」って何かしら……。
#. de: Was die Idee, von der Cahciua sprach, wohl sein mag ...?
#. fr: J'ai hâte d'entendre quelle idée a eu Cahciua...
#. speaker: KRILE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_KRILE_000_080:1"
msgid "What could this great idea of Cahciua's be?"
msgstr ""

#. ja: くそっ……。
#. de: Verdammt<nbsp>...
#. fr: Merde...
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_ERENVILLE_000_085:1"
msgid "It's not... \\<sigh>"
msgstr ""

#. ja: ビープ、ビープ……エラー、エラー……<br>認証システム、起動……こん、にち、は……<br>利用者登録……確認……。
#. de: \<biep> \<biep> Fehler! Fehler<nbsp>... KeNnuNGSsySTEM wiRD AktiVieRT<nbsp>... ERFoLG<nbsp>... HALlihALloooO<nbsp>... BENUtzEr<nbsp>... BeSTÄ-Ä-Ä-HÄ-HÄ-TiGT!
#. fr: Bip b-b-bip... Erreur... E-e-erreur... Système réinitialisé. Enregistrement d'<if $gn4>une nouvelle utilisatrice<else>un nouvel utilisateur</if>... c-c-confirmé.
#. speaker: WINDSPATHGARDENSGUARD
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_WINDSPATHGARDENSGUARD_000_090:1"
msgid "\\<bleep> \\<bloop> Error. Error. Verification system...initialized. User registration...confirmed."
msgstr ""

#. ja: 歓迎、歓迎！<br>探求と好奇心のウィンドパスガーデンへいってらっしゃい！<br>未知の発見がキミを待っていることだろう！
#. de: Willkommen, willkommen, meine lieben Freunde! Wartet ihr etwa darauf, sowohl Forschungsdrang als auch Neugierde in den Windpfadgärten zu befriedigen? Dann habe ich gute Nachrichten. Die Gärten erwarten euch Abenteuerlustige nämlich bereits! Und los!
#. fr: Bienvenue aux jardins de Soufflevent, le paradis des curieux amateurs de découverte<nbsp>! Préparez-vous à un voyage à travers les mystères de l'inconnu<nbsp>!
#. speaker: WINDSPATHGARDENSGUARD
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_WINDSPATHGARDENSGUARD_000_091:1"
msgid "Greetings and welcome to Windspath Gardens, the sanctuary of exploration and discovery! The marvels of the natural world await you!"
msgstr ""

#. ja: ……カフキワらしいな。<br>こうなったら最高の思い出、作ろうぜ！
#. de: Das klang ganz nach der Cahciua, die wir kennen.
#. fr: C'est bien le genre de Cahciua<nbsp>! Maintenant, à nous de l'aider à garder le meilleur souvenir possible<nbsp>!
#. speaker: WUKLAMAT
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_WUKLAMAT_000_095:1"
msgid "Let's help Cahciua make some great memories!"
msgstr ""

#. ja: 探求と好奇心のウィンドパスガーデン……<br>彼女がこのエリアの永久人ってのも頷けるな。
#. de: Forschungsdrang und Neugierde also<nbsp>... Ein passenderes Areal hätte sich Cahciua wohl nicht wünschen können<nbsp>...
#. fr: “Le paradis des currrieux amateurs de découverte”... Quel meilleur endroit pour les adieux de Cahciua<nbsp>?
#. speaker: GRAHATIA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_GRAHATIA_000_100:1"
msgid "The sanctuary of exploration and discovery... Quite fitting that Cahciua's memories are here."
msgstr ""

#. ja: 最期まで夢を追うなんて、カフキワさんらしくて素敵だわ。
#. de: Ihren Träumen bis zuletzt nachzujagen<nbsp>... das braucht wahre Stärke ...!
#. fr: Courir après son rêve jusque dans ses derniers moments... ça lui ressemble tellement.
#. speaker: KRILE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_KRILE_000_105:1"
msgid "How very like Cahciua to chase her dreams to the last."
msgstr ""

#. ja: …………。
#. de: ...
#. fr: ...
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_ERENVILLE_000_110:1"
msgid "..."
msgstr ""

#. ja: それじゃ、了承してもらえたってことで……<br>ちょいとついて来てくれるかい？
#. de: Wo ihr nun alle einverstanden seid<nbsp>... würdet ihr mir bitte folgen?
#. fr: Bien, puisque j'ai votre accord... nous allons visiter ces jardins tous ensemble<nbsp>! Bien sûr, vous êtes libres de vous écarter de notre route pour croiser des Éternels.
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_120:1"
msgid "Then with your consent, let's begin our adventure!"
msgstr ""

#. ja: もちろんほかの永久人と交流しながらでいいからさ！<br>景色もちゃんと堪能しながら来るんだよ！
#. de: Natürlich in aller Ruhe! Sprecht mit den Leuten, genießt die Aussicht<nbsp>... Alles in eurem Tempo, ja?
#. fr: Mais surtout, n'oubliez pas d'admirer le paysage. Chaque parcelle de cette zone est un véritable régal pour les yeux<nbsp>!
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_121:1"
msgid "Naturally, while we go about this, feel free to continue befriending Endless. And be sure to absorb the delightful scenery!"
msgstr ""

#. ja: ヘンテコな木かと思ったら、あれはオブジェなんだな！<br>気になるところばっかりだぜ！
#. de: Und da dachte ich schon, dieses komische Ding da hinten sei ein Baum!
#. fr: Je pensais qu'il s'agissait d'un arbre un peu bizarre, mais ce truc est en fait une structure décorative<nbsp>!<nbsp>... Enfin, je crois<nbsp>?
#. speaker: WUKLAMAT
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_WUKLAMAT_000_125:1"
msgid "I thought those things were some sort of enormous tree, but they're actually sculptures!"
msgstr ""

#. ja: 見事なもんだな。<br>施設が老朽化したり、エーテル不足になったりする中でも、<br>スフェーンはこの光景を保ったのか……永久人のために……。
#. de: Es ist wirklich beeindruckend, wie Sphene trotz des stetig schlechter werdenden Zustandes der Anlage und inmitten der Ätherknappheit solch eine Szenerie für die Endlosen aufrechterhalten konnte.
#. fr: Le paysage est d'une beauté remarquable. Sphene a dû faire tout son possible afin de le préserver pour les Éternels, malgré la pénurie d'éther...
#. speaker: GRAHATIA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_GRAHATIA_000_130:1"
msgid "The scenery here is nothing short of remarkable. To think that Sphene has managed to preserve it for the Endless..."
msgstr ""

#. ja: きれいな花園ね……！
#. de: Was für ein wundervoller Blumengarten ...!
#. fr: Quel magnifique champ fleuri<nbsp>!
#. speaker: KRILE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_KRILE_000_135:1"
msgid "What a lovely garden!"
msgstr ""

#. ja: ……なんとなく予想はついた。
#. de: ... Ich glaube, ich weiß schon, was jetzt kommt.
#. fr: ... J'avais senti le coup venir.
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_ERENVILLE_000_140:1"
msgid "...I somehow anticipated this."
msgstr ""

#. ja: ここは「探求の花園」って場所さ！<br>きれいに咲いてるだろ？
#. de: Der Garten hier ist als die Blüten der Entdeckung bekannt. Eine Augenweide, nicht wahr?
#. fr: Nous appelons cet endroit “les Pétales de la Révélation”. On ne se lasse pas d'admirer toutes ces fleurs multicolores, hein<nbsp>?
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_150:1"
msgid "This particular garden is called Blooms of Discovery. Beautiful, isn't it?"
msgstr ""

#. ja: 圧巻だな……！<br>たしか、リビング・メモリーの植物は本物だったよな？
#. de: Es ist wirklich eine Pracht! Und<nbsp>... die Flora in der Lebenden Erinnerung ist doch eines der wenigen Dinge, die echt an ihr sind, nicht wahr?
#. fr: C'est fascinant<nbsp>! Et toute la végétation de La Mémoirrre vivante est authentique, c'est bien ça<nbsp>?
#. speaker: GRAHATIA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_GRAHATIA_000_151:1"
msgid "It's absolutely stunning! And they are all actual plants?"
msgstr ""

#. ja: そうさ、雷光大戦で絶滅寸前だった植物を集めて、<br>種を存続させるために、ここで数百年保管されてきたらしい！
#. de: Genau. Durch die Stromschlachten vom Aussterben bedrohte Arten sollen hier über Jahrhunderte hinweg bewahrt und gepflegt worden sein.
#. fr: Oui, les plantes que vous voyez ont été sauvées de l'extinction qui les menaçait pendant la Guerre des fulgurations. Depuis, elles ont été préservées ici pendant plusieurs siècles<nbsp>!
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_152:1"
msgid "They are indeed. These specimens were brought here hundreds of years ago for conservation, as the calamity had pushed them to the brink of extinction."
msgstr ""

#. ja: じゃあ、このウィンドパスガーデン全体が、<br>大きな植物園みたいなものなのね……！
#. de: Dann sind die Windpfadgärten also genau das, was ihr Name suggeriert. Ein großer Garten für Leben jeglicher Art, richtig?
#. fr: Cet endroit est en quelque sorte un immense conservatoire botanique<nbsp>!
#. speaker: KRILE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_KRILE_000_153:1"
msgid "So this zone is like a great conservatory."
msgstr ""

#. ja: うまいこと言うね、クルルちゃん！<br>たしかにその表現が適切かもしれないね！
#. de: Wie eloquent du doch bist, Krile! Und ja, natürlich hast du Recht!
#. fr: Je ne l'aurais pas mieux dit, ma petite Krile<nbsp>! Ici, on peut trouver des espèces végétales qui n'existent nulle part ailleurs.
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_154:1"
msgid "Precisely, my dear Krile! Here you'll find flora and fauna the likes of which no longer exist elsewhere."
msgstr ""

#. ja: 未知の植物、未知の動物！<br>エレネッシパもグリーナーの血が騒ぐんじゃないか？
#. de: Unentdeckte Gewächse, nie zuvor gesehene Tierarten<nbsp>... Elene'shpya<nbsp>- dein Klauberinstinkt kriegt sich vor lauter Reizen doch bestimmt gar nicht mehr ein, oder?!
#. fr: Elene'shpya, ça ne titille pas ta fibre de glaneur<nbsp>?
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_155:1"
msgid "Doesn't the thought just set your heart aflutter?"
msgstr ""

#. ja: ……まあな。
#. de: ... Kann schon sein.
#. fr: ... Possible.
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_ERENVILLE_000_156:1"
msgid "I suppose."
msgstr ""

#. ja: トラル大陸の外で見かけたような動植物が、<br>こちら側の世界にも存在してるってケースもあると思う。
#. de: Hier gibt es bestimmt auch ein paar Arten, die mit einigen der Kreaturen, welche ich außerhalb Turals erforschen durfte, verwandt sind.
#. fr: Mes con<shy>nais<shy>san<shy>ces sur la faune et la flore des reflets sont limitées, mais ça ne m'étonnerait pas que des espèces que j'ai déjà croisées hors du Tural vivent ici.
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_ERENVILLE_000_157:1"
msgid "I expect that some creatures I encountered outside of Tural may have cousins in this world."
msgstr ""

#. ja: 鏡像世界とやらには詳しくないが、<br>その辺りの生態系を比較してみるのも面白いんじゃないか？
#. de: Zugegeben, ich bin zwar kein Experte, was Splitter<shy>welten und dergleichen angeht, aber es könnte durchaus interessant sein, sie untereinander zu vergleichen.
#. fr: Disons que ça sera peut-être intéressant de comparer ces écosystèmes et de recenser leurs disparités...
#. speaker: ERENVILLE
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_ERENVILLE_000_158:1"
msgid "While I am no expert on life in the reflections, it would make for an interesting study to compare them."
msgstr ""

#. ja: それ、いいじゃないか！<br>さすがはあたしの弟子だよ！
#. de: Diese Worte hätten auch aus meinem Mund kommen können! Du bist eben doch mein Sohn, Junge!
#. fr: Remarquable<nbsp>! Je n'en attendais pas moins de mon brillant disciple.
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_159:1"
msgid "Now there's an idea! Leave it to my pupil to think up such."
msgstr ""

#. ja: ここには世界中を旅する冒険者とグリーナー、<br>それにシャーレアンから来た俊英がふたりもいるんだ。<br>こりゃワクワクが止まらないね！
#. de: Hier und heute haben sich nicht nur <if $gn4>eine umtriebige Abenteurerin<else>ein umtriebiger Abenteurer</if> sowie ein ebenso weit gereister Klauber, sondern auch zwei brillante Geister aus Sharlayan versammelt. Besser geht's kaum!
#. fr: Me voilà en présence d'un glaneur, d'<if $gn4>une aventurière renommée<else>un aventurier renommé</if> et de deux illustres érudits sharlayanais...
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_160:1"
msgid "Here we have not only a worlds-traversing adventurer and a veteran gleaner, but a pair of Sharlayan's finest scholars besides."
msgstr ""

#. ja: それじゃ改めて……未知を追い求める同志たち！<br>少しの間だけど、よろしくね！
#. de: Meine lieben Entdeckerfreunde und -freundinnen<nbsp>... Darf ich euch nun um einen letzten Tanz in den Schemen des Unentdeckten bitten? 
#. fr: Avec un tel quatuor d'insatiables curieux, je sens que je ne vais pas m'ennuyer<nbsp>!
#. speaker: CAHCIUA
msgctxt "quest/049/KinGmf111_04956:TEXT_KINGMF111_04956_CAHCIUA_000_161:1"
msgid "It's a veritable gathering of inquisitiveness, and I'm thrilled to be part of it!"
msgstr ""
