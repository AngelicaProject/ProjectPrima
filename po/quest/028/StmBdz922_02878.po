# quest/028/StmBdz922_02878 — «Send in the Armor» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: ポルタ・プレトリアのダントゥニュエル大牙士は、高名な冒険者に任務を頼みたいようだ。
#. de: Der Erleuchtete Schlangenpriester Dantounuel hält Ausschau nach einem angesehenen Abenteurer.
#. fr: Le capitaine Dantounuel a besoin d'un<if $gn4>e aventurière<else> aventurier</if> pour une mission très importante.
#. kind: journal
msgctxt "quest/028/StmBdz922_02878:TEXT_STMBDZ922_02878_SEQ_00:1"
msgid "Serpent Captain Dantounuel needs an adventurer of particular experience."
msgstr "Капитан Змеи Дантунюэль ищет опытного приключенца для особого поручения."

#. ja: 不滅隊の兵卒と話す
#. de: Mit dem Rekruten der Legion sprechen
#. fr: Parler au soldat des Immortels
#. kind: objective
msgctxt "quest/028/StmBdz922_02878:TEXT_STMBDZ922_02878_TODO_00:1"
msgid "Speak with the flame officer."
msgstr "Поговорите с офицером Огненной дружины."

#. ja: 鹵獲魔導アーマーに騎乗して現れた敵を討伐
#. de: Gegner mit der erbeuteten Magitek-Kampfmaschine besiegen
#. fr: Détruire le premier groupe d'armes magitek avec l'armure magitek
#. kind: objective
msgctxt "quest/028/StmBdz922_02878:TEXT_STMBDZ922_02878_TODO_01:1"
msgid "Use the magitek armor to destroy abandoned warmachina."
msgstr "Уничтожьте брошенные боевые машины на магитех-броне."

#. ja: 鹵獲魔導アーマーに騎乗して現れた敵を再度討伐
#. de: Weitere Gegner mit der erbeuteten Magitek-Kampfmaschine besiegen
#. fr: Détruire le deuxième groupe d'armes magitek avec l'armure magitek
#. kind: objective
msgctxt "quest/028/StmBdz922_02878:TEXT_STMBDZ922_02878_TODO_02:1"
msgid "Use the magitek armor to destroy abandoned warmachina."
msgstr "Уничтожьте брошенные боевые машины на магитех-броне."

#. ja: 鹵獲魔導アーマーに騎乗して現れた敵をさらに討伐
#. de: Noch mehr Gegner mit der erbeuteten Magitek-Kampfmaschine besiegen
#. fr: Détruire le dernier groupe d'armes magitek avec l'armure magitek
#. kind: objective
msgctxt "quest/028/StmBdz922_02878:TEXT_STMBDZ922_02878_TODO_03:1"
msgid "Use the magitek armor to destroy abandoned warmachina."
msgstr "Уничтожьте брошенные боевые машины на магитех-броне."

#. ja: 不滅隊の兵卒に報告
#. de: Zum Rekrut der Legion zurückkehren
#. fr: Faire un rapport au soldat des Immortels
#. kind: objective
msgctxt "quest/028/StmBdz922_02878:TEXT_STMBDZ922_02878_TODO_04:1"
msgid "Report to the flame officer."
msgstr "Доложите офицеру Огненной дружины."

#. ja: ダントゥニュエル大牙士に報告
#. de: Dantounuel berichten
#. fr: Faire un rapport à Dantounuel
#. kind: objective
msgctxt "quest/028/StmBdz922_02878:TEXT_STMBDZ922_02878_TODO_05:1"
msgid "Report to Dantounuel."
msgstr "Доложите Дантунюэлю."

#. ja: 冒険者部隊の俊英である、貴官と出会うとはなんたる幸運！<br>事態の打開に、その力を貸してもらえんだろうか？
#. de: Was bin ich froh, dich zu treffen, <if ($gn53 > 0)><if ($gn53 < 127)><capitalize><if ($gn52 > 0)><if $gn4><sheet GCRankLimsaFemaleText $gn52 0><else><sheet GCRankLimsaMaleText $gn52 0></if><else><if ($gn53 > 0)><if $gn4><sheet GCRankGridaniaFemaleText $gn53 0><else><sheet GCRankGridaniaMaleText $gn53 0></if><else><if ($gn54 > 0)><if $gn4><sheet GCRankUldahFemaleText $gn54 0><else><sheet GCRankUldahMaleText $gn54 0></if></if></if></if></capitalize> <split " " 2><string $gs1></split><else><string $gs1></if><else><string $gs1></if>! <if $gn4>Eine Heldin<else>Einen Helden</if> wie dich kann ich gut gebrauchen.
#. fr: <string $gs1>, l'un<if $gn4>e</if> des plus grand<if $gn4>es<else>s</if> aventuri<if $gn4>ères<else>ers</if> de tous les temps<nbsp>! C'est un véritable honneur de faire votre con<shy>nais<shy>san<shy>ce. Accepteriez-vous de nous aider à résoudre un petit problème<nbsp>?
#. speaker: DANTOUNUEL
#. macro: <capitalize><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 8></if><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 8></if><if ($gn54 > 0)><sheet GCRankUlda… — the content with its first letter in upper case (may be added or dropped)
#. macro: <if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 8></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 52 (the player's rank in the Maelstrom, 0 when not a member) > 0 (condition: may be reworded, restructured, added, or dropped)
