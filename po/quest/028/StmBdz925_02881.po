# quest/028/StmBdz925_02881 — «If I Were a Fish» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: ポルタ・プレトリアのドロテー中闘士は、水中で活動できる冒険者に頼みたいことがあるようだ。
#. de: Erster Legionsfähnrich Dorothe sucht einen Abenteurer, der nicht wasserscheu ist.
#. fr: Dorothe a une mission aquatique à vous confier.
#. kind: journal
msgctxt "quest/028/StmBdz925_02881:TEXT_STMBDZ925_02881_SEQ_00:1"
msgid "Lieutenant Dorothe needs a soldier who knows how to swim."
msgstr "Лейтенант Дороте ищет солдата, умеющего плавать."

#. ja: 不滅隊の工作員と話す
#. de: Mit dem Geheimagenten der Bruderschaft sprechen
#. fr: Parler à l'agent des Immortels
#. kind: objective
msgctxt "quest/028/StmBdz925_02881:TEXT_STMBDZ925_02881_TODO_00:1"
msgid "Speak with the flame agent."
msgstr "Поговорите с агентом Огненных."

#. ja: <sheet EObj 2008779 0>を入手
#. de: Im Seldsee nach etwas Auffälligem suchen
#. fr: Inspecter la zone indiquée
#. kind: objective
msgctxt "quest/028/StmBdz925_02881:TEXT_STMBDZ925_02881_TODO_01:1"
msgid "Obtain the imperial secret."
msgstr "Найдите имперский секрет."

#. ja: 不滅隊の工作員に<sheet EventItem 2002313 0>を渡す
#. de: <capitalize><noun-de EventItem 2 2002313 1 4 1></capitalize> zum Geheimagenten der Bruderschaft bringen
#. fr: Donner <noun-fr EventItem 2 2002313 1 1> à l'agent des Immortels
#. kind: objective
msgctxt "quest/028/StmBdz925_02881:TEXT_STMBDZ925_02881_TODO_02:1"
msgid "Deliver the imperial materiel crate to the flame agent."
msgstr "Передайте ящик с имперским снаряжением агенту Огненных."

#. ja: ドロテー中闘士に報告
#. de: Mit Dorothe sprechen
#. fr: Faire un rapport à Dorothe
#. kind: objective
msgctxt "quest/028/StmBdz925_02881:TEXT_STMBDZ925_02881_TODO_03:1"
msgid "Report to Dorothe."
msgstr "Доложите Дороте."

#. ja: <if ($gn52 > 0)><split " " 2><string $gs1></split><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 0></if></if><if ($gn53 > 0)><split " " 2><string $gs1></split><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 0></if></if><if ($gn54 > 0)><split " " 2><string $gs1></split><if ($gn54 > 0)><sheet GCRankUldahMaleText $gn54 0></if></if>ですね？<br>あなたが東方の海にて、水中で活動するための秘術を会得したと、<br>「暁の血盟」の方から聞いたのですが、本当でしょうか……？
#. de: <if ($gn52 > 0)><if ($gn52 > 0)><if $gn4><sheet GCRankLimsaFemaleText $gn52 0><else><sheet GCRankLimsaMaleText $gn52 0></if></if> </if><if ($gn53 > 0)><if ($gn53 > 0)><if $gn4><sheet GCRankGridaniaFemaleText $gn53 0><else><sheet GCRankGridaniaMaleText $gn53 0></if></if> </if><if ($gn54 > 0)><if ($gn54 > 0)><if $gn4><sheet GCRankUldahFemaleText $gn54 0><else><sheet GCRankUldahMaleText $gn54 0></if></if> </if><split " " 2><string $gs1></split>, nicht wahr? Ich habe gehört, dass die Kojin dich mit einer äußerst praktischen Gabe gesegnet haben. Du kannst dich jetzt frei unter Wasser bewegen, richtig?
#. fr: <if ($gn52 > 0)><capitalize><if ($gn52 > 0)><if $gn4><sheet GCRankLimsaFemaleText $gn52 0><else><sheet GCRankLimsaMaleText $gn52 0></if></if></capitalize> <split " " 2><string $gs1></split></if><if ($gn53 > 0)><capitalize><if ($gn53 > 0)><if $gn4><sheet GCRankGridaniaFemaleText $gn53 0><else><sheet GCRankGridaniaMaleText $gn53 0></if></if></capitalize> <split " " 2><string $gs1></split></if><if ($gn54 > 0)><capitalize><if ($gn54 > 0)><if $gn4><sheet GCRankUldahFemaleText $gn54 0><else><sheet GCRankUldahMaleText $gn54 0></if></if></capitalize> <split " " 2><string $gs1></split></if>, n'est-ce pas<nbsp>? Un Héritier de la Septième Aube m'a raconté que vous étiez capable de rester très longtemps sous l'eau... Est-ce vrai<nbsp>?
#. speaker: DOROTHE
#. macro: <capitalize><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 8></if><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 8></if><if ($gn54 > 0)><sheet GCRankUlda… — the content with its first letter in upper case (may be added or dropped)
#. macro: <if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 8></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 52 (the player's rank in the Maelstrom, 0 when not a member) > 0 (condition: may be reworded, restructured, added, or dropped)
