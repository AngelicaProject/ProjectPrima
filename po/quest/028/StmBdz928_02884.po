# quest/028/StmBdz928_02884 — «At the Top of the Stairs» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: ポルタ・プレトリアのトファーは、屈強な冒険者の助けを必要としているようだ。
#. de: Topher benötigt dringend Verstärkung von einem fähigen Abenteuer.
#. fr: Topher est à la recherche d'un<if $gn4>e aventurière<else> aventurier</if> robuste.
#. kind: journal
msgctxt "quest/028/StmBdz928_02884:TEXT_STMBDZ928_02884_SEQ_00:1"
msgid "Topher seeks a redoubtable soldier for an urgent mission."
msgstr ""

#. ja: 解放軍の闘士と話す
#. de: Die Befreiungskämpfer an der Sudwacht finden
#. fr: Parler au combattant de l'armée de libération
#. kind: objective
msgctxt "quest/028/StmBdz928_02884:TEXT_STMBDZ928_02884_TODO_00:1"
msgid "Speak with the Resistance fighter."
msgstr ""

#. ja: <sheet EObj 2008781 0>で見渡し、敵が現れたら討伐
#. de: Auf der Aussichtsplattform umsehen und Gegner besiegen
#. fr: Observer les alentours à l'endroit indiqué et abattre les ennemis
#. kind: objective
msgctxt "quest/028/StmBdz928_02884:TEXT_STMBDZ928_02884_TODO_01:1"
msgid "Climb to the top of the tower and search for enemies."
msgstr ""

#. ja: 解放軍の闘士に報告
#. de: Zu den Befreiungskämpfern zurückkehren
#. fr: Faire un rapport au combattant de l'armée de libération
#. kind: objective
msgctxt "quest/028/StmBdz928_02884:TEXT_STMBDZ928_02884_TODO_02:1"
msgid "Report to the Resistance fighter."
msgstr ""

#. ja: トファーに報告
#. de: Topher berichten
#. fr: Faire un rapport à Topher
#. kind: objective
msgctxt "quest/028/StmBdz928_02884:TEXT_STMBDZ928_02884_TODO_03:1"
msgid "Report to Topher."
msgstr ""

#. ja: <if ($gn52 > 0)><split " " 2><string $gs1></split><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 0></if></if><if ($gn53 > 0)><split " " 2><string $gs1></split><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 0></if></if><if ($gn54 > 0)><split " " 2><string $gs1></split><if ($gn54 > 0)><sheet GCRankUldahMaleText $gn54 0></if></if>ですね。<br>実はあなたに、ご協力いただきたい任務があるのです。
#. de: <if ($gn52 > 0)><if ($gn52 > 0)><if $gn4><sheet GCRankLimsaFemaleText $gn52 0><else><sheet GCRankLimsaMaleText $gn52 0></if></if> </if><if ($gn53 > 0)><if ($gn53 > 0)><if $gn4><sheet GCRankGridaniaFemaleText $gn53 0><else><sheet GCRankGridaniaMaleText $gn53 0></if></if> </if><if ($gn54 > 0)><if ($gn54 > 0)><if $gn4><sheet GCRankUldahFemaleText $gn54 0><else><sheet GCRankUldahMaleText $gn54 0></if></if> </if><split " " 2><string $gs1></split>, nicht wahr? Ich habe einen dringenden Auftrag für dich.
#. fr: <if ($gn52 > 0)><capitalize><if ($gn52 > 0)><if $gn4><sheet GCRankLimsaFemaleText $gn52 0><else><sheet GCRankLimsaMaleText $gn52 0></if></if></capitalize> <split " " 2><string $gs1></split></if><if ($gn53 > 0)><capitalize><if ($gn53 > 0)><if $gn4><sheet GCRankGridaniaFemaleText $gn53 0><else><sheet GCRankGridaniaMaleText $gn53 0></if></if></capitalize> <split " " 2><string $gs1></split></if><if ($gn54 > 0)><capitalize><if ($gn54 > 0)><if $gn4><sheet GCRankUldahFemaleText $gn54 0><else><sheet GCRankUldahMaleText $gn54 0></if></if></capitalize> <split " " 2><string $gs1></split></if><nbsp>! Vous arrivez à point nommé, j'ai une mission à vous confier.
#. speaker: TOPHER
#. macro: <capitalize><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 8></if><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 8></if><if ($gn54 > 0)><sheet GCRankUlda… — the content with its first letter in upper case (may be added or dropped)
