# quest/028/StmBdz916_02872 — «Falling Down on the Job» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: カストルム・オリエンスのスウェスリク大牙将は、再び冒険者に頼みたいことがあるようだ。
#. de: Swethryk Brookstone hat einen weiteren Auftrag für dich.
#. fr: Swethryk Brookstone a un autre service à vous demander.
#. kind: journal
msgctxt "quest/028/StmBdz916_02872:TEXT_STMBDZ916_02872_SEQ_00:1"
msgid "Serpent Marshal Brookstone finds himself once again in need of a good soldier."
msgstr "Маршалу Двух Змей Брукстоуну снова понадобился умелый боец."

#. ja: ドドグン闘軍曹と話す
#. de: Mit Dodogun sprechen
#. fr: Parler à Dodogun
#. kind: objective
msgctxt "quest/028/StmBdz916_02872:TEXT_STMBDZ916_02872_TODO_00:1"
msgid "Speak with Dodogun."
msgstr "Поговорите с Додогуном."

#. ja: 双蛇党の兵卒を探し、敵が現れたら討伐
#. de: Den Rekruten der Bruderschaft in Sathya Maga suchen
#. fr: Trouver le soldat des Deux Vipères et vaincre les éventuels ennemis
#. kind: objective
msgctxt "quest/028/StmBdz916_02872:TEXT_STMBDZ916_02872_TODO_01:1"
msgid "Find the serpent recruit."
msgstr "Найдите новобранца Ордена Двух Змей."

#. ja: 双蛇党の兵卒と話す
#. de: Mit dem Rekruten der Bruderschaft sprechen
#. fr: Parler au soldat des Deux Vipères
#. kind: objective
msgctxt "quest/028/StmBdz916_02872:TEXT_STMBDZ916_02872_TODO_02:1"
msgid "Speak with the serpent recruit."
msgstr "Поговорите с новобранцем Ордена Двух Змей."

#. ja: スウェスリク大牙将と話す
#. de: Swethryk Brookstone Bericht erstatten
#. fr: Parler à Swethryk Brookstone
#. kind: objective
msgctxt "quest/028/StmBdz916_02872:TEXT_STMBDZ916_02872_TODO_03:1"
msgid "Report to Serpent Marshal Brookstone."
msgstr "Доложите маршалу Двух Змей Брукстоуну."

#. ja: <if ($gn52 > 0)><split " " 2><string $gs1></split><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 0></if></if><if ($gn53 > 0)><split " " 2><string $gs1></split><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 0></if></if><if ($gn54 > 0)><split " " 2><string $gs1></split><if ($gn54 > 0)><sheet GCRankUldahMaleText $gn54 0></if></if>か。<br>ちょうどよい所に来てくれた。<br>緊急で、君の手を借りたい。
#. de: Ah, <split " " 2><string $gs1></split>. Du kommst gerade recht. Ich brauche nämlich dringend deine Hilfe.
#. fr: Vous arrivez à point nommé, <if ($gn52 > 0)><if ($gn52 > 0)><if $gn4><sheet GCRankLimsaFemaleText $gn52 0><else><sheet GCRankLimsaMaleText $gn52 0></if></if> <split " " 2><string $gs1></split></if><if ($gn53 > 0)><if ($gn53 > 0)><if $gn4><sheet GCRankGridaniaFemaleText $gn53 0><else><sheet GCRankGridaniaMaleText $gn53 0></if></if> <split " " 2><string $gs1></split></if><if ($gn54 > 0)><if ($gn54 > 0)><if $gn4><sheet GCRankUldahFemaleText $gn54 0><else><sheet GCRankUldahMaleText $gn54 0></if></if> <split " " 2><string $gs1></split></if>. J'ai justement une mission urgente à vous confier.
#. speaker: SWETHRYKBROOKSTONE
