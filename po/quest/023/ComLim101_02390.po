# quest/023/ComLim101_02390 — «Squadron and Commander (Maelstrom)» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: <split " " 2><string $gs1></split><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 0></if>、待っていたぞ！<br><if ($gn52 > 0)>黒渦団</if><if ($gn53 > 0)>双蛇党</if><if ($gn54 > 0)>不滅隊</if>の同志であり、活躍めざましいお主に、<br>ぜひ耳に入れておきたいことがあるのだ。
#. de: Sei gegrüßt, <if ($gn52 > 0)><if $gn4><sheet GCRankLimsaFemaleText $gn52 0><else><sheet GCRankLimsaMaleText $gn52 0></if></if> <split " " 2><string $gs1></split>. Darf ich dir ein Angebot unterbreiten? Ich habe einen ver<shy>antwor<shy>tungs<shy>vollen Posten zu besetzen und ich denke, dass du genau <if $gn4>die<else>der</if> Richtige dafür bist.
#. fr: <capitalize><if ($gn52 > 0)><if $gn4><sheet GCRankLimsaFemaleText $gn52 0><else><sheet GCRankLimsaMaleText $gn52 0></if><else><if ($gn53 > 0)><if $gn4><sheet GCRankGridaniaFemaleText $gn53 0><else><sheet GCRankGridaniaMaleText $gn53 0></if><else><if ($gn54 > 0)><if $gn4><sheet GCRankUldahFemaleText $gn54 0><else><sheet GCRankUldahMaleText $gn54 0></if></if></if></if></capitalize> <split " " 2><string $gs1></split>, je vous attendais. J'ai une requête de la plus haute importance, que je ne peux adresser qu'à un officier qui a votre expérience.
#. speaker: STORMPERSONNEL
#. macro: <capitalize><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 8></if><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 8></if><if ($gn54 > 0)><sheet GCRankUlda… — the content with its first letter in upper case (may be added or dropped)
