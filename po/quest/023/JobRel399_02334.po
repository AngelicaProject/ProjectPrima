# quest/023/JobRel399_02334 — «Recondition the Anima» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 「人造精霊の再調整」では、<br>アニマウェポンに振り分けたパラメータの、<br>再調整を行うことができます。
#. de: Die Parameter der Anima-Waffe können neu verteilt werden.
#. fr: Cette quête vous permet de réorienter l'épanouissement de l'esprit synthétique pour choisir de nouveaux attributs à améliorer sur l'arme anima qu'il habite.
#. speaker: SYSTEM
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_SYSTEM_000_000:1"
msgid "By reconditioning the anima, you can redistribute the attribute points allocated to your weapon."
msgstr "Перенастройка Анимы позволяет перераспределить характеристики оружия."

#. ja: 再調整を行えるアニマウェポンは、<br>現在装備しているアニマウェポンとなります。
#. de: Wenn du fortfährst, kannst du die Parameter deiner aktuell angelegten Anima-Waffe neu verteilen.
#. fr: L'esprit synthétique dont vous pouvez réorienter l'épanouissement est celui de l'arme ac<shy>tu<shy>el<shy>le<shy>ment équipée.
#. speaker: SYSTEM
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_SYSTEM_000_001:1"
msgid "You may only recondition the anima of the weapon equipped when speaking with Ulan."
msgstr "Перенастроить можно только Аниму того оружия, которое надето на вас во время разговора с Уланом."

#. ja: <if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if>のアニマウェポンのパラメータを、<br>再調整しますか？
#. de: Möchtest du die Parameter für die Anima-Waffe des aktuellen Jobs <ui-color 500><ui-edge-color 501><if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if></ui-edge-color></ui-color> neu verteilen?
#. fr: Voulez-vous choisir de nouveaux attributs à améliorer pour l'arme anima <if ($gn4 == 0)><if ($gn68 == 5)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 6)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 7)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 10)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 11)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 14)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 26)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 27)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 28)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 33)>d'<sheet ClassJob $gn68 0><else>de <sheet ClassJob $gn68 0></if></if></if></if></if></if></if></if></if></if><else><if ($gn68 == 5)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 6)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 7)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 10)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 11)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 14)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 26)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 27)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 28)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 33)>d'<sheet ClassJob $gn68 2><else>de <sheet ClassJob $gn68 2></if></if></if></if></if></if></if></if></if></if></if><nbsp>?
#. speaker: SYSTEM
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_SYSTEM_000_002:1"
msgid "The process can be canceled at any time."
msgstr "Процесс можно отменить в любой момент."

#. ja: <if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if>のアニマウェポンを再調整しますか？
#. de: Die Parameter für die Anima-Waffe des Jobs <ui-color 500><ui-edge-color 501><if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if></ui-edge-color></ui-color> neu verteilen?
#. fr: Choisir de nouveaux attributs à améliorer pour l'arme anima <if ($gn4 == 0)><if ($gn68 == 5)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 6)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 7)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 10)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 11)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 14)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 26)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 27)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 28)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 33)>d'<sheet ClassJob $gn68 0><else>de <sheet ClassJob $gn68 0></if></if></if></if></if></if></if></if></if></if><else><if ($gn68 == 5)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 6)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 7)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 10)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 11)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 14)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 26)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 27)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 28)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 33)>d'<sheet ClassJob $gn68 2><else>de <sheet ClassJob $gn68 2></if></if></if></if></if></if></if></if></if></if></if><nbsp>?
#. speaker: Q1
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_Q1_000_000:1"
msgid "What will you do?"
msgstr "Что будете делать?"

#. ja: もう少し悩んでみる
#. de: Nein.
#. fr: Non
#. speaker: A1
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_A1_000_001:1"
msgid "Recondition the anima of a different weapon."
msgstr "Перенастроить Аниму другого оружия."

#. ja: <if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if>のアニマウェポンを再調整する
#. de: Ja, ich möchte die Parameter für die Anima-Waffe des Jobs <ui-color 500><ui-edge-color 501><if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if></ui-edge-color></ui-color> neu verteilen.
#. fr: Oui
#. speaker: A2
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_A2_000_002:1"
msgid "Recondition the anima of your equipped weapon."
msgstr "Перенастроить Аниму надетого оружия."

#. ja: アニマウェポンの再調整を行いたい場合は、<br>再調整したいアニマウェポンを装備してから、<br>ウランに声をかけてください。
#. de: Lege die Anima-Waffe an, deren Parameter du neu verteilen möchtest, und sprich mit Ulan.
#. fr: Équipez-vous de l'arme anima pour laquelle vous souhaitez choisir de nouveaux attributs à améliorer puis parlez à Ulan.
#. speaker: SYSTEM
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_SYSTEM_000_003:1"
msgid "In order to recondition the anima of a weapon, you must first equip it, then speak with Ulan."
msgstr "Чтобы перенастроить Аниму оружия, сначала наденьте его, а затем поговорите с Уланом."

#. ja: アニマウェポンの再調整を行いたい場合は、<br>再調整したいアニマウェポンの剣と対となる盾を装備してから、<br>ウランに声をかけてください。
#. de: Lege Schwert und Schild der Anima-Waffe an, deren Parameter du neu verteilen möchtest, und sprich mit Ulan.
#. fr: Équipez-vous de l'arme anima pour laquelle vous souhaitez choisir de nouveaux attributs à améliorer puis parlez à Ulan.
#. speaker: SYSTEM
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_SYSTEM_100_003:1"
msgid "In order to recondition the anima of a weapon, you must first equip it, then speak with Ulan."
msgstr "Чтобы перенастроить Аниму оружия, наденьте его меч и соответствующий ему щит, а затем поговорите с Уланом."

#. ja: アニマウェポンの再調整を行いたい場合は、<br>再調整したいアニマウェポンを装備してから、<br>ウランに声をかけてください。
#. de: Lege die Anima-Waffe an, deren Parameter du neu verteilen möchtest, und sprich mit Ulan.
#. fr: Équipez-vous de l'arme anima pour laquelle vous souhaitez choisir de nouveaux attributs à améliorer puis parlez à Ulan.
#. speaker: SYSTEM
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_SYSTEM_000_004:1"
msgid "You must equip your anima weapon before speaking with Ulan to proceed."
msgstr "Чтобы продолжить, наденьте Аниму оружия и поговорите с Уланом."

#. ja: アニマウェポンの再調整を行いたい場合は、<br>再調整したいアニマウェポンの剣と対となる盾を装備してから、<br>ウランに声をかけてください。
#. de: Lege Schwert und Schild der Anima-Waffe an, deren Parameter du neu verteilen möchtest, und sprich mit Ulan.
#. fr: Équipez-vous de l'arme anima pour laquelle vous souhaitez choisir de nouveaux attributs à améliorer puis parlez à Ulan.
#. speaker: SYSTEM
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_SYSTEM_100_004:1"
msgid "You must equip both the Sword and Shield of the Twin Thegns before speaking with Ulan to proceed."
msgstr "Чтобы продолжить, наденьте меч и щит близнецов-танов и поговорите с Уланом."

#. ja: やぁ、<split " " 1><string $gs1></split>くん。<br>人造精霊の能力に手を加えたいんだって？
#. de: Hallo, <split " " 1><string $gs1></split>. Bist du hier, um an der synthetischen Seele zu feilen?
#. fr: Tiens, <split " " 1><string $gs1></split><nbsp>! Êtes-vous ici pour modifier l'évolution de votre esprit synthétique<nbsp>?
#. speaker: ULAN
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_ULAN_000_000:1"
msgid "Ardashir tells me you wish to alter the state of the anima, is that right?"
msgstr "Ардашир сказал, ты хочешь изменить состояние Анимы. Так ли это?"

#. ja: わかった、協力しよう。<br>再調整のためには、これまで人造精霊が得てきた能力を、<br>一度、失わせる必要がある……。
#. de: Ich helfe dir gerne. Zuerst muss ich die Seele von all ihrem bisher gesammelten Wissen befreien.
#. fr: Dans ce cas, il va devoir oublier tous les progrès qu'il a accomplis jusqu'à présent.
#. speaker: ULAN
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_ULAN_000_001:1"
msgid "Assuming we do not attempt to push beyond its current limitations, this should be a trivial matter."
msgstr "Если не пытаться превзойти нынешние пределы Анимы, дело будет пустяковым."

#. ja: 失わせた能力分、新たに<sheet Item 15841 0>を与え、<br>改めて能力を伸ばしてあげてくれ。
#. de: Dann fütterst du sie wieder mit <sheet Item 15841 9>, bis sie zu ihrer alten Form wiederfindet. Natürlich mit neuen Eigenschaften, ganz so, wie du willst.
#. fr: Vous pourrez alors de nouveau le nourrir de sable de cristal puis choisir dans quels domaines vous désirez qu'il s'améliore.
#. speaker: ULAN
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_ULAN_000_002:1"
msgid "Mind you, this process requires crystal sand. If you have none, I will gladly furnish you with more per our original arrangement."
msgstr "Для этого понадобятся кристальный песок. Если он у тебя закончился, я с радостью выдам ещё — как и договаривались."

#. ja: そこまで成長した人造精霊であれば、<br>調整前の<sheet Item 15841 0>でも摂取し得るだろう。<br>もう、<sheet Item 15840 0>を用意する必要はない。
#. de: <noun-de Item 5 15840 2 4 1> brauchen wir keine mehr.
#. fr: Ah, vous serez <if $gn4>heureuse<else>heureux</if> de savoir que vous n'aurez pas besoin de roches ombrales dures cette fois-ci<nbsp>!
#. speaker: ULAN
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_ULAN_000_003:1"
msgid "But you need not worry about umbrite. For this we require elementally aspected sand to ever so slightly alter the anima's aetherial composition."
msgstr "Но умбрит тебе не понадобится. Чтобы слегка изменить эфирный состав Анимы, нам нужен песок с эфирными свойствами."

#. ja: では、さっそく人造精霊の再調整に着手するよ！
#. de: Also, dann wollen wir mal.
#. fr: Commençons sans plus attendre.
#. speaker: ULAN
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_ULAN_000_007:1"
msgid "Unless you have any other questions, let us begin!"
msgstr "Если вопросов больше нет, приступим!"

#. ja: 何をしますか？
#. de: Was möchtest du machen?
#. fr: Que voulez-vous faire<nbsp>?
#. speaker: Q1
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_Q1_000_020:1"
msgid "What will you do?"
msgstr "Что будете делать?"

#. ja: 人造精霊を再調整する
#. de: Die Parameter der Anima-Waffe neu verteilen.
#. fr: Réorienter l'épanouissement de l'esprit
#. speaker: A1
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_A1_000_021:1"
msgid "Recondition the anima."
msgstr "Перенастроить Аниму."

#. ja: 「<sheet Item 15841 0>」の交換
#. de: Gegenstände gegen <sheet Item 15841 9> tauschen.
#. fr: Obtenir <noun-fr Item 1 15841 2 1>
#. speaker: A2
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_A2_000_022:1"
msgid "Exchange items for crystal sand."
msgstr "Обменять предметы на кристальный песок."

#. ja: 説明を聞く
#. de: Mir die Neuverteilung erklären lassen.
#. fr: Écouter des ex<shy>pli<shy>ca<shy>tions
#. speaker: A3
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_A3_000_023:1"
msgid "Ask about reconditioning."
msgstr "Спросить о перенастройке."

#. ja: キャンセル
#. de: Nichts.
#. fr: Annuler
#. speaker: A4
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_A4_000_024:1"
msgid "Nothing."
msgstr "Ничего."

#. ja: おや、<sheet Item 15841 0>を持っていないみたいだね。<br>欲しいのであれば、私が求める品を集めてくるのだな。
#. de: Aber du hast ja gar keinen Kristallsand! Zum Glück bekommst du den gleich hier bei mir. Im Tausch gegen etwas anderes, versteht sich.
#. fr: On dirait que vous n'avez plus de sable de cristal... Apportez-moi quelques-uns des objets qui figurent sur ma liste, et je vous en donnerai en échange<nbsp>!
#. speaker: ULAN
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_ULAN_000_010:1"
msgid "You appear to be out of crystal sand, my friend. If you would have more, then I must ask you bring me supplies in exchange."
msgstr "Похоже, кристальный песок у тебя закончился. Если хочешь получить ещё, принеси мне кое-какие припасы в обмен."

#. ja: 人造精霊の能力を再調整する場合は、<br>これまでに得てきた能力を、一度、失わせる必要がある……。<br>必要なら、私が処置をするから言ってくれ。
#. de: Damit die synthetische Seele neue Eigenschaften erhält, muss ich die Seele erst von all ihrem bisher gesammelten Wissen befreien.
#. fr: Pour réorienter l'épanouissement de votre esprit, il va d'abord falloir lui faire oublier tous les progrès qu'il a accomplis jusqu'à présent.
#. speaker: ULAN
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_ULAN_000_030:1"
msgid "To carefully modify the anima's aetherial composition, we must make use of crystal sand once more. The process is quite different from our previous endeavor, but thankfully much simpler."
msgstr "Чтобы тщательно изменить эфирный состав Анимы, нам снова понадобится кристальный песок. В этот раз всё устроено иначе, но, к счастью, гораздо проще."

#. ja: その後、<sheet Item 15841 0>を、再度、摂取させればいい。<br>これまで同様、私が求める品を集めてくれれば、<br>好きなだけ提供してあげよう。
#. de: Dann fütterst du sie wieder mit <sheet Item 15841 9>. Ich geb dir so viel du brauchst - im Tausch gegen die Gegenstände auf meiner Liste, so wie vorher auch.
#. fr: Cela fait, il vous suffira de le nourrir de sable de cristal, à la différence près que vous n'aurez pas besoin de l'affiner avec des roches ombrales dures, cette fois-ci.
#. speaker: ULAN
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_ULAN_000_031:1"
msgid "Nevertheless, it still requires a fair amount of crystal sand. If you require more, you must supply me with materials in exchange. A deal is a deal, after all."
msgstr "Но кристального песка всё равно потребуется немало. Если понадобится ещё, принеси мне материалы в обмен. Договор есть договор."

#. ja: ああ、補足だが、もう<sheet Item 15840 0>は必要ないよ。<br>そのまま摂取できる程度に、成長はしているからね。
#. de: <noun-de Item 5 15840 2 4 1> brauchen wir aber keine mehr.
#. fr: Si jamais vous manquez de sable de cristal, vous pouvez toujours m'apporter les objets qui figurent sur la liste que je vous ai remise la dernière fois<nbsp>!
#. speaker: ULAN
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_ULAN_000_032:1"
msgid "Oh, and you need not bother with the umbrite. Stripping the sand of its elemental aspect would be counterproductive this time."
msgstr "И умбрит тебе больше не понадобится. Теперь песок не нужно очищать от стихийных свойств."

#. ja: 人造精霊の再調整を終了しますか？
#. de: Möchtest du die Neuverteilung beenden?
#. fr: Arrêter de réorienter l'épanouissement de l'esprit<nbsp>?
#. speaker: Q1
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_Q1_000_030:1"
msgid "Conclude your business with Ulan?"
msgstr "Закончить дела с Уланом?"

#. ja: おつかれさま。<br>また、人造精霊の能力に手を加えたくなったら、<br>声をかけてくれ。
#. de: Ich wünsche dir noch einen schönen Tag, <split " " 1><string $gs1></split>. Du bist jederzeit wieder willkommen.
#. fr: Très bien. Si vous avez encore besoin de moi à l'avenir, n'hésitez pas à me faire signe<nbsp>!
#. speaker: ULAN
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_ULAN_000_050:1"
msgid "That went rather well, would you not agree? If you should have need of my services again, you have but to ask."
msgstr "Ну вот, прошло на удивление гладко. Если снова понадобятся мои услуги, только скажи."

#. ja: <if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if>のアニマウェポンが、<br>再調整されました。
#. de: Die Parameter der Anima-Waffe für den Job <ui-color 500><ui-edge-color 501><if ($gn68 < 8)><sheet ClassJob $gn68 0><else><if ($gn68 > 18)><sheet ClassJob $gn68 0></if></if></ui-edge-color></ui-color> wurden neu verteilt.
#. fr: Les attributs de l'arme anima <if ($gn4 == 0)><if ($gn68 == 5)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 6)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 7)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 10)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 11)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 14)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 26)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 27)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 28)>d'<sheet ClassJob $gn68 0><else><if ($gn68 == 33)>d'<sheet ClassJob $gn68 0><else>de <sheet ClassJob $gn68 0></if></if></if></if></if></if></if></if></if></if><else><if ($gn68 == 5)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 6)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 7)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 10)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 11)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 14)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 26)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 27)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 28)>d'<sheet ClassJob $gn68 2><else><if ($gn68 == 33)>d'<sheet ClassJob $gn68 2><else>de <sheet ClassJob $gn68 2></if></if></if></if></if></if></if></if></if></if></if> ont été modifiés.
#. speaker: SYSTEM
msgctxt "quest/023/JobRel399_02334:TEXT_JOBREL399_02334_SYSTEM_000_006:1"
msgid "The anima has been transformed, gaining newfound strength!"
msgstr "Анима преобразована! Теперь она стала ещё сильнее!"
