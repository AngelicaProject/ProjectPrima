#. de: Am <noun-de EObj 5 2007198 1 3 1> warten
#. fr: Attendre à l'endroit indiqué
#. kind: objective
msgctxt "quest/023/BanMog003_02322:TEXT_BANMOG003_02322_TODO_01:1"
msgid "Wait for Master Mogzin to return."
msgstr ""

#. ja: 白亜の宮殿のウェイ・アフと話す
#. de: Mit Whei Ahf im Kreidetempel sprechen
#. fr: Parler à Whei Ahf, à Zénith
#. kind: objective
msgctxt "quest/023/BanMog003_02322:TEXT_BANMOG003_02322_TODO_02:1"
msgid "Speak with Whei Ahf in Zenith."
msgstr ""

#. ja: 団長のモグジンと話す
#. de: Mit Mogzin sprechen
#. fr: Parler à Mogzin
#. kind: objective
msgctxt "quest/023/BanMog003_02322:TEXT_BANMOG003_02322_TODO_03:1"
msgid "Speak with Master Mogzin at Bahrr Lehs."
msgstr ""

#. ja: 大食いのモグムリと話す
#. de: Mit Mogmul Mogbauch sprechen
#. fr: Parler à Mogmul
#. kind: objective
msgctxt "quest/023/BanMog003_02322:TEXT_BANMOG003_02322_TODO_04:1"
msgid "Speak with Mogmul Mogbelly."
msgstr ""

