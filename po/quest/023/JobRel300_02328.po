msgctxt "quest/023/JobRel300_02328:TEXT_JOBREL300_02328_SYSTEM_000_000:1"
msgid "Please note that upon completing the quest “A Dream Fulfilled,” you will receive an anima weapon for <if ($gn68 == 10)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 14)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 5)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 26)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 33)>an <sheet ClassJob $gn68 0><else>a <sheet ClassJob $gn68 0></if></if></if></if></if>."
