msgid "\\<rustle> \\<rustle>"
msgstr ""

#. ja: もさ？
#. de: \<schmatz>?
#. fr: <i>Frrr...<nbsp>?</i>
#. speaker: JUVENILEB04298
msgctxt "quest/042/AktKzh003_04298:TEXT_AKTKZH003_04298_JUVENILEB04298_000_015:1"
msgid "\\<rustle> ...?"
msgstr ""

