#. de: \<schmatz><nbsp>... \<schmatz>!
#. fr: <i>Frrr... Frrr...</i>
#. speaker: JUVENILEB04298
msgctxt "quest/042/AktKzh003_04298:TEXT_AKTKZH003_04298_JUVENILEB04298_000_016:1"
msgid "\\<rustle> \\<rustle>"
msgstr ""

#. ja: もさもさ……。
#. de: \<schmatz><nbsp>...
#. fr: <i>Frrr... Frrr...</i>
#. speaker: JUVENILEC04298
msgctxt "quest/042/AktKzh003_04298:TEXT_AKTKZH003_04298_JUVENILEC04298_000_017:1"
msgid "\\<rustle> ..."
msgstr ""

#. ja: もさもさ。
#. de: \<schmatz>
#. fr: <i>Frrrrrr...</i>
#. speaker: JUVENILEC04298
msgctxt "quest/042/AktKzh003_04298:TEXT_AKTKZH003_04298_JUVENILEC04298_000_018:1"
msgid "\\<rustle> \\<rustle>"
msgstr ""

