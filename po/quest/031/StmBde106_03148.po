msgctxt "quest/031/StmBde106_03148:TEXT_STMBDE106_03148_SYSTEM_000_500:1"
msgid "You have learned the emote <ui-color 500><ui-edge-color 501>Endure</ui-edge-color></ui-color>!"
msgstr "Вы выучили эмоцию <ui-color 500><ui-edge-color 501>Терпение</ui-edge-color></ui-color>!"
