msgctxt "quest/031/JobAoz001_03192:TEXT_JOBAOZ001_03192_SYSTEM_000_082:1"
msgid "A button for the Gear Set interface is located in the upper portion of the <ui-color 500><ui-edge-color 501>Character</ui-edge-color></ui-color> window."
msgstr "Кнопка открытия окна комплектов экипировки находится в верхней части окна <ui-color 500><ui-edge-color 501>«Персонаж»</ui-edge-color></ui-color>."
