msgctxt "quest/025/JobRdm500_02576:TEXT_JOBRDM500_02576_SYSTEM_000_342:1"
msgid "A button for the Gear Set interface is located in the upper portion of the <ui-color 500><ui-edge-color 501>Character</ui-edge-color></ui-color> window."
msgstr "Кнопка «Наборы снаряжения» находится в верхней части окна <ui-color 500><ui-edge-color 501>«Персонаж»</ui-edge-color></ui-color>."
