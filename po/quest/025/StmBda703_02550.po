msgctxt "quest/025/StmBda703_02550:TEXT_STMBDA703_02550_SYSTEM_900_011:1"
msgid "Use the <ui-color 500><ui-edge-color 501>Aetheric Siphon</ui-edge-color></ui-color> to weaken Fordola, and defeat her in battle!"
msgstr "Используйте <ui-color 500><ui-edge-color 501>эфирный сифон</ui-edge-color></ui-color>, чтобы ослабить Фордолу и победить её!"
