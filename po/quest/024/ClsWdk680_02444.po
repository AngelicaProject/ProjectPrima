msgid "<if ($n1 < $n2)>Synthesize an ornate partition <sheet Addon 9 0><else>Deliver the ornate partition <sheet Addon 9 0> to Reizan</if>."
msgstr ""

#. ja: 木工師ギルドへ戻る
#. de: Zur Zimmerergilde in Gridania zurückkehren
#. fr: Aller à la guilde des menuisiers
#. kind: objective
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_TODO_05:1"
msgid "Return to the Carpenters' Guild in Gridania."
msgstr ""

#. ja: チェミ・ジンジャルと話す
#. de: Mit Cemi sprechen
#. fr: Parler à Cemi Jinjahl
#. kind: objective
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_TODO_06:1"
msgid "Speak with Cemi Jinjahl."
msgstr ""

#. ja: あぁ、<split " " 1><string $gs1></split>さんかい。<br>ちょうど、あんた宛てにチェミ嬢ちゃんから、<br>文が届いているよ……ほら、さっそく読んでごらん。
#. de: Ah, <string $gs1>, nicht wahr? Das trifft sich gut! Gerade ist ein an dich adressierter Brief von Cemi eingetroffen. Hier, bitte sehr!
#. fr: <split " " 1><string $gs1></split>, j'ai une lettre pour vous<nbsp>! Tenez, c'est de la part de la petite Cemi.
#. speaker: KOTOKAZE
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_KOTOKAZE_000_001:1"
msgid "Ah, <split \" \" 1><string $gs1></split>! A letter from Cemi has just arrived for you."
msgstr ""

#. ja: (-チェミからの手紙-)<split " " 1><string $gs1></split>さんへ。<br>ウチです、チェミ・ジンジャルです。<br>今、ウチはヤンサのナマイ村という場所に来ています。
#. de: (-Cemis Brief-)<if $gn4>Liebe<else>Lieber</if> <split " " 1><string $gs1></split>, ich schreibe dir, um dich wissen zu lassen, dass ich wohlbehalten in Yanxia angekommen bin, genauer gesagt in dem kleinen Dorf Namai.
#. fr: (-Lettre de Cemi Jinjahl-)<if $gn4>Chère<else>Cher</if> <split " " 1><string $gs1></split>,<br><br>Comment se passent les choses de votre côté<nbsp>? Pour ma part, je suis bien arrivée au village de Namai, dans la plaine de Yanxia.
#. speaker: CEMIJINJAHLLATTER
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHLLATTER_000_002:1"
msgid "(-Letter from Cemi-)<i>Dear <split \" \" 1><string $gs1></split>,<br>I am writing to tell you that I have arrived in a tiny village in Yanxia known as Namai.</i>"
msgstr ""

#. ja: (-チェミからの手紙-)ドマに伝わる文化は、とっても素晴らしいです。<br>ヤンサ地方固有の素材を使っているせいか、<br>初めて目にするものばかりです。
#. de: (-Cemis Brief-)Hier ist es wunderbar! Die reiche, lebhafte Kultur von Doma bringt so unglaublich schöne Dinge hervor, die jeden Tag aufs Neue meine Augen erfreuen.
#. fr: (-Lettre de Cemi Jinjahl-)Je passe le plus clair de mon temps à étudier la culture domienne, qui est pour le moins pas<shy>sion<shy>nan<shy>te. Les matériaux locaux sont vraiment différents des nôtres, et pas un jour ne passe sans que je découvre une nouvelle recette<nbsp>!
#. speaker: CEMIJINJAHLLATTER
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHLLATTER_000_003:1"
msgid "(-Letter from Cemi-)<i>It's such a delightful place. Every day I stumble across something new─whether it be the unusual materials they employ in their construction or the unfamiliar but delicious foods.</i>"
msgstr ""

#. ja: (-チェミからの手紙-)特に点心と呼ばれている饅頭のような料理が、<br>ウチのお気に入りです！
#. de: (-Cemis Brief-)Und meinen Gaumen! Das Beste sind so kleine, gefüllte Teigtaschen, die Dim Sum genannt werden!
#. fr: (-Lettre de Cemi Jinjahl-)Oui, que ce soit sucré ou salé, tout est tellement délicieux<nbsp>! Je suis tout par<shy>ti<shy>cu<shy>liè<shy>rement adepte des “dimsums”, ces petits gâteaux cuits à la vapeur. Je suis sûre que vous en raffoleriez, vous aussi<nbsp>!
#. speaker: CEMIJINJAHLLATTER
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHLLATTER_000_004:1"
msgid "(-Letter from Cemi-)<i>Oh, yes, the food here is exquisite, and their desserts are even better. In fact, the sugar-coated dumplings they have are simply to die for!</i>"
msgstr ""

#. ja: (-チェミからの手紙-)<split " " 1><string $gs1></split>さんにもご馳走したいので、<br>良かったら「ナマイ村」までお越しください。<br>食の追求人チェミ・ジンジャル
#. de: (-Cemis Brief-)Die musst du probieren! Komm doch auch nach Namai! Ich lad dich gerne zum Essen ein. Herzliche Grüße,<br><br>Deine Cemi
#. fr: (-Lettre de Cemi Jinjahl-)Si vous avez envie de partager avec moi toutes ces merveilles, n'attendez plus et venez vite me rejoindre à Namai<nbsp>!<br><br>Cemi, critique gastronomiqo'te
#. speaker: CEMIJINJAHLLATTER
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHLLATTER_000_005:1"
msgid "(-Letter from Cemi-)<i>I'll be sure to treat you to some when you come. See you soon.<br>Yours truly,<br>Cemi</i>"
msgstr ""

#. ja: わっ、<split " " 1><string $gs1></split>さん！<br>お久しぶりです～！
#. de: <split " " 1><string $gs1></split>, du bist es! Ich hab dich vermisst!
#. fr: Ooooh, <split " " 1><string $gs1></split><nbsp>! Ça fait un bail, dites donc<nbsp>!
#. speaker: CEMIJINJAHL
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_010:1"
msgid "<split \" \" 1><string $gs1></split>! How wonderful it is to see you. It's been far too long."
msgstr ""

#. ja: <split " " 1><string $gs1></split>さんも、<br>ドマ料理の食べ歩きに来たんですか？<br>なら、いいお店を知っているのでご案内しますよ！
#. de: Freust du dich schon auf das domanische Essen? Du wirst sehen, ich hab nicht zu viel versprochen. Komm, ich zeig dir mein Lieblingsrestaurant!
#. fr: J'en étais sûrrre, vous n'avez pas pu résister à l'appel de la cuisine domienne. Vous avez bien fait de me rejoindre aussi vite, nous avons beaucoup de restaurants à visiter<nbsp>!
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_011:1"
msgid "Have you tried any of the local cuisine yet? If you haven't, I know the perfect place for us to start."
msgstr ""

#. ja: い、いやだなあ、冗談ですってば！<br>ドマ伝来の木工技術は、バッチリ修得済みですよ！<br>ちょっと合間に美味しいものを食べていただけで……。
#. de: He, entspann dich, ich wollte dir doch nur etwas Gutes tun! Ich hab mich schon intensiv mit der domanischen Zimmererkunst beschäftigt und kann dir gerne darüber erzählen, während wir essen<nbsp>...
#. fr: Ne vous mettez pas dans un état pareil, enfin<nbsp>! Nous aurons tout le temps de discuter menuiserie une fois que nous aurons l'estomac bien rrrempli, hé hé<nbsp>!
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_012:1"
msgid "I-I was planning to take you there purely to discuss business, I swear! After all, where better to do that than over food?"
msgstr ""

#. ja: ひいっ！
#. de: He!
#. fr: Gloups...
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_013:1"
msgid "Gah!"
msgstr ""

#. ja: よ、よーし！<br><split " " 1><string $gs1></split>さんもいらっしゃったことですし、<br>早速「困っている人」を探しに行きましょう！
#. de: Na schön, du hast ja Recht. Wir dürfen Meister Beatin nicht enttäuschen. Dann verschieben wir das Essen eben auf später und halten zuerst nach potenzieller Kundschaft Ausschau!
#. fr: Mais où avais-je la tête, enfin<nbsp>? Partons tout de suite à la recherche d'une personne dans l'embarras pour lui venir en aide grrrâce à la menuiserie<nbsp>! (soupire)
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_014:1"
msgid "All right, all right! Your disapproval has been duly noted. Instead of going for food, let us search out any people who might be in need of our assistance, then."
msgstr ""

#. ja: チェミ嬢ちゃんは、ずいぶん食に熱心なようだね。<br>調理師ギルドの職人かなんかかい？
#. de: Ich habe selten jemanden erlebt, der sich so für Essen begeistert wie Cemi. Sie würde bestimmt eine steile Karriere in der Gourmetgilde machen!
#. fr: Votre amie Cemi semble être passionnée par la gastronomie orientale. Elle fait partie de la guilde des cuisiniers, c'est ça<nbsp>?
#. speaker: KOTOKAZE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_KOTOKAZE_000_015:1"
msgid "Ah, the Culinarians' Guild must be extremely proud to have a member as passionate about food as Cemi. She is sure to make a fine chef one day."
msgstr ""

#. ja: 困っていることがないかって？<br>ああ、あるさ……。
#. de: Hilfe? Ja, ich könnte Hilfe gebrauchen.
#. fr: Hein, si j'ai des problèmes<nbsp>? Bien sûr que oui, <if $gn4>ma petite dame<else>mon bon monsieur</if>. Vous en connaissez beaucoup, vous, des gens qui vivent sans aucun souci<nbsp>?
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_020:1"
msgid "Help? Yes, I could use some of that."
msgstr ""

#. ja: 私はドマが占領される前に、料理人をしていたのだがね。<br>ようやくガレマール帝国の支配も終わったということで、<br>ふたたび料理屋を開こうと考えているんだ。
#. de: Vor der Besetzung Domas habe ich als Koch gearbeitet. Nun, da die verhassten Garlear endlich vertrieben wurden, möchte ich gerne wieder ein Restaurant eröffnen.
#. fr: Plus jeune, je travaillais comme cuisinier au quartier enclavé de Doma, mais j'ai dû fuir lorsque la ville est tombée aux mains de l'Empire. Maintenant qu'elle a été libérée, je compte y retourner un jour pour y ouvrir mon propre restaurant.
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_021:1"
msgid "You see, in the days before the Empire held dominion over our lands, I was a chef. While our freedom from them is fleeting, I would nevertheless like to use this opportunity to once again pursue my passion for cooking. As such, I have been thinking to open up my own restaurant."
msgstr ""

#. ja: 私はドマが占領される前に、料理人をしていたのだがね。<br>いつかガレマール帝国の支配が終わったときに、<br>ふたたび料理屋を開こうと考えているんだ。
#. de: Vor der Besetzung Domas habe ich als Koch gearbeitet. Wenn die verhassten Garlear irgendwann vertrieben werden, möchte ich gerne wieder ein Restaurant eröffnen.
#. fr: Plus jeune, je travaillais comme cuisinier au quartier enclavé de Doma, mais j'ai dû fuir lorsque la ville est tombée aux mains de l'Empire. Si elle est un jour libérée, je rêve d'y retourner pour y ouvrir mon propre restaurant.
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_022:1"
msgid "You see, in the days before the Empire held dominion over our lands, I was a chef. I hold out hope that one day, when the imperial forces are driven from our country, I will be free to pursue my passion, once more. When that time comes, I wish to start up my own restaurant."
msgstr ""

#. ja: 当然のことだが、店を開くとなれば、<br>椅子やら何やら家具を調達する必要があるだろう？<br>だが、予算も限られている上、腕のいい職人が見つからなくてね。
#. de: Dafür brauche ich natürlich Stühle und andere Möbel, aber mein Budget ist begrenzt und ich finde einfach keinen guten Handwerker.
#. fr: Bien sûr, il me faudra pour cela des tables, des chaises et d'autres choses, mais mes économies sont bien trop maigres pour me permettre de meubler tout un éta<shy>blis<shy>se<shy>ment. Si seulement je connaissais un menuisier qui puisse me faire un prix...
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_025:1"
msgid "To do so, I would need to procure basic furnishings for my future shop. It is not a simple task. Most of what I have come across is either far too expensive or of poor quality."
msgstr ""

#. ja: その悩み、ウチたち、グリダニアの木工師ギルドにお任せください！<br>あなたの理想の家具を立ち所に作ってみせますよ！
#. de: Keine Sorge, Herr, deine Suche hat ein Ende! Ich bin Cemi von der Zimmerergilde. Ich werde dir im Hand<shy>umdrehen die Möbel anfertigen, die du brauchst!
#. fr: Ça alors, c'est votre jour de chance<nbsp>! Vous avez devant vous un membre émérite de la prrrestigieuse guilde des menuisiers<nbsp>! Comme on dit à Gridania<nbsp>: “Besoin d'un meuble<nbsp>? Pas de souci, appelez Cemi<nbsp>!”
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_030:1"
msgid "Then you may be pleased to hear, sir, that before you stand two highly skilled members of the Carpenters' Guild in Gridania. We shall see that you receive the furniture you require."
msgstr ""

#. ja: おお、それはありがたい。<br>是非お願いしていいだろうか？
#. de: Wirklich? Das wäre eine große Hilfe. Darf ich dich wirklich darum bitten?
#. fr: Vraiment<nbsp>? C'est vrai que ça tombe bien, mais je ne pense pas avoir de quoi m'attacher vos services... Pourriez-vous m'accorder une petite ristourne<nbsp>?
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_045:1"
msgid "You would do this for me?"
msgstr ""

#. ja: 承りました！<br>では早速、どんな家具をお求めですか？
#. de: Aber gerne doch! Was für Möbel brauchst du denn?
#. fr: Bien sûrrr<nbsp>! Ne vous en faites pas, je vais m'occuper de vous comme il faut. Alors, qu'est-ce qui vous ferait plaisir, exactement<nbsp>?
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_050:1"
msgid "Most certainly. What kind of furnishings do you need?"
msgstr ""

#. ja: 私が店を開こうとしているドマ町人地では、<br>この村の住人とは、少し違う食事作法があってね。<br>彼らが安心して食事を楽しむことのできる家具が欲しいんだ。
#. de: Ich möchte ein Restaurant in der Stadt eröffnen, in dem die Gäste gemütlich essen können. Die Sache ist nur, dass die Domaner, die in den Städten leben, etwas eigenwillige Essgewohnheiten haben, ganz andere als hier auf dem Land. Ich bin mir nicht ganz sicher, was sie von einem Restaurant erwarten.
#. fr: Eh bien, à part des tables et des chaises... En fait, les Domiens ont des manières bien différentes de celles des habitants de Namai. J'aimerais donc un meuble qui permette à mes clients d'apprécier leur repas dans les conditions auxquelles ils sont habitués.
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_055:1"
msgid "Apart from tables and chairs, I need something that would allow my guests to feel at ease. Those from the enclave have different dining habits to those of us here in Namai. I would like to create an environment where both would feel equally welcome."
msgstr ""

#. ja: ふむふむ……そうだ、<split " " 1><string $gs1></split>さん！<br>ただウチが家具を作るだけでは、面白くありません。<br>ここはひとつ、勝負といきませんか？
#. de: Verstanden! Dabei kommt mir eine tolle Idee. <split " " 1><string $gs1></split>, was hältst du von einem kleinen Wettstreit?
#. fr: L'étiquette domienne, hein... Vous avez entendu ça, <split " " 1><string $gs1></split><nbsp>? Nous voici à nouveau face à un défi intérrressant. Pour mettre un petit peu de piment, que diriez-vous de nous mesurer l'<if $gn4>une<else>un</if> à l'autre, cette fois-ci<nbsp>?
#. speaker: CEMIJINJAHL
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_060:1"
msgid "Please, leave it to us, sir. Now, <split \" \" 1><string $gs1></split>, what do you say to making things a tad more interesting? Let's turn this into a competition."
msgstr ""

#. ja: お互いに作った家具を持ち寄って、<br>どちらがより優れているか、依頼人の方に判定してもらうんです！
#. de: Wir fertigen beide ein Möbelstück an und präsentieren es unserem Auftraggeber. Er soll darüber entscheiden, wer von uns die bessere Arbeit geleistet hat.
#. fr: <if $gn4>Chacune<else>Chacun</if> fabriquera l'objet qu'<if $gn4>elle<else>il</if> pense approprié, et notre employeur décidera du vainqueurrr<nbsp>!
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_065:1"
msgid "We will each make something for our client and present the finished product to him. He will then judge them and decide on a winner."
msgstr ""

#. ja: ここまでウチはろくに依頼を達成できていません……。<br>このままでは師匠に見放されてしまいます。<br>師匠にウチの技術を証明するチャンスがほしいんです！
#. de: Bisher habe ich noch keinen einzigen Auftrag zufriedenstellend erledigt. So darf es nicht weitergehen. Bitte gib mir diese Chance, mich in den Augen unseres Meisters zu beweisen!
#. fr: Jusqu'ici, je n'ai jamais réussi à satisfaire un client. Si ça continue comme ça, je vais décevoir les derniers espoirs que Beatin a placés en moi... J'aimerais vrrraiment avoir cette chance de faire mes preuves<nbsp>! Je vous en prie, dites oui...
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_070:1"
msgid "Pretty, pretty please─won't you do it for me? This is the only way I can show Timbermaster Beatin I'm just as skilled as all the other carpenters in the guild."
msgstr ""

#. ja: やったー！<br>ありがとうございます！
#. de: Klasse! Vielen Dank!
#. fr: Youpi<nbsp>! Merci, <split " " 1><string $gs1></split>. Vous pouvez compter sur moi pour vous montrrrer de quel bois je me chauffe<nbsp>!
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_075:1"
msgid "Haha! It's settled then!"
msgstr ""

#. ja: よくわからんが、とにかくよろしく頼むよ。<br>製作に悩んだら、「村の住民」の意見も聞いてみるといい。<br>かつてドマ町人地に住んでいた人もいるだろうからね。
#. de: Na, da bin ich ja mal gespannt. Viel Erfolg! Es kann nicht schaden, euch hier im Dorf umzuhören. Einige Leute haben früher in der Stadt gelebt und können euch von der dortigen Esskultur erzählen.
#. fr: Tant que j'ai de quoi ouvrir mon restaurant, vous pouvez faire ce qui vous plaît<nbsp>! Si vous voulez en savoir plus sur l'étiquette domienne, vous devriez parler avec les villageois. Nombre des gens que vous croiserez à Namai sont originaires du quartier enclavé de Doma, après tout.
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_080:1"
msgid "Go about making the furniture however you will, but I recommend you speak with the people here before getting started. Some have lived here their entire lives, others once lived in the enclave. With their help you may better understand the subtle differences in our ways."
msgstr ""

#. ja: <split " " 1><string $gs1></split>さん、<br>製作物のヒントが得られたら、ウチの所までお越しください。<br>材料をお渡ししますので～！
#. de: Danke, das machen wir. Also los, <split " " 1><string $gs1></split>, viel Glück! Komm zu mir, sobald du eine Idee hast, was du herstellen willst. Ich versorg dich mit allem, was du dafür brauchst. Bis später!
#. fr: <split " " 1><string $gs1></split>, une fois que vous aurez décidé quel objet fabriquer, venez me trrrouver pour que je vous remette les matériaux. Ce n'est pas parce que je veux gagner que je ne serai pas fair-play, hé hé<nbsp>!
#. speaker: CEMIJINJAHL
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_085:1"
msgid "Thank you, sir, we'll be sure to do that. <split \" \" 1><string $gs1></split>, once you've decided what you'll be making, come and find me. I'll furnish you with any materials you might need."
msgstr ""

#. ja: 困ってる人～……困ってる人はいませんか～……。<br>……この村、そもそも人が少なすぎます……。
#. de: Hallo! Sucht hier jemand eine fähige Zimmerin? Ich glaub's ja eher nicht, in diesem kleinen Dorf<nbsp>...
#. fr: Mais alors, n'y a-t-il donc personne qui ait besoin de notre aide, ici<nbsp>? Il faut dire aussi qu'il n'y a pas grrrand monde dans ce trou perdu...
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_086:1"
msgid "Hello? Is there anyone out there seeking the services of a young carpenter? Anyone at all?"
msgstr ""

#. ja: ドマ町人地の人は、田舎者の村人よりも洒落ていてね。<br>お高くとまっているっていうか、品がいいっていうのか……<br>とにかく作法に厳しい人が多い印象だなぁ。
#. de: Im Vergleich zu uns Dörflern sind die Städter eleganter, würde ich sagen. Sie tragen schicke Kleidung und teuren Schmuck. Vor allem aber legen sie Wert auf gute Umgangsformen.
#. fr: Les habitants du quartier enclavé de Doma sont bien mieux éduqués que nous autres campagnards. Nombreux sont ceux qui se soucient de leur apparence, et certains sont même assez hautains... En tout cas, ils ont pour la plupart des manières très raffinées.
#. speaker: INAGARA
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_INAGARA_000_090:1"
msgid "I would say that the people from the enclave are more elegant than us─never seen one with a hair out of place or in clothes that have not been neatly pressed. They place great importance on rules, manners, and fashion over there."
msgstr ""

#. ja: ええ、確かに私は以前、町人地で暮らしておりましたわ。<br>帝国軍の横暴に耐えかねて、この村に逃れてきましたけれど。
#. de: Ja, ich habe eine Zeit lang in der Stadt gelebt. Das war, nachdem ich aus meinem Heimatdorf fliehen musste, weil es von Soldaten der Garlear verwüstet wurde.
#. fr: Tout à fait, je suis née et j'ai grandi au quartier enclavé de Doma. J'ai malheureusement dû fuir comme nombre de mes semblables lorsque l'Empire a lancé son offensive sur notre ville.
#. speaker: MANAZURU
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_MANAZURU_000_091:1"
msgid "Yes. I suppose you could say I am from the enclave, though I have lived here for most of my life. When I was young, my family and I fled to this village that we might escape imperial troops."
msgstr ""

#. ja: え？<br>ドマ町人地に住んでいた人の食卓風景を知りたいから、<br>食事しているところを見せてほしいですって？
#. de: Hm? Wie die Städter essen? Das soll ich dir vorführen?
#. fr: ... Pardon<nbsp>? Vous voulez me regarder manger... pour étudier l'étiquette à table des Domiens<nbsp>!?
#. speaker: MANAZURU
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_MANAZURU_000_092:1"
msgid "Wh-What? You would like for me to <i>demonstrate</i> the difference in dining habits!?"
msgstr ""

#. ja: そんな恥知らずなこと、到底できませんわ！
#. de: Was soll das? Bist du verrückt? Deine unverschämte Bitte kannst du dir abschminken!
#. fr: Mais enfin, n'avez-vous pas honte<nbsp>? Il est par<shy>fai<shy>te<shy>ment hors de question que je me donne en spectacle pour assouvir vos penchants pervers<nbsp>!
#. speaker: MANAZURU
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_MANAZURU_000_093:1"
msgid "Hmph. I am afraid that is not something I can help you with."
msgstr ""

#. ja: 僕は、ドマ町人地から来たんだけどね……。<br>ここの連中は、気はいいんだが礼儀作法がなってないよ。<br>道端で飯を食ったり、人前で茶を飲んだりしちゃってさ……。
#. de: Ja, ich bin in der Stadt aufgewachsen. Die Dorfbewohner hier tragen das Herz am rechten Fleck, aber sie haben einfach keine Manieren. Sie essen auf der Straße und schlürfen ihren Tee direkt vor anderen Leuten.
#. fr: Oui, je viens ef<shy>fec<shy>ti<shy>ve<shy>ment du quartier enclavé de Doma. Les habitants de Namai sont tout à fait sympathiques, mais leur style de vie est pour le moins rustique. Ne sont-ils donc pas gênés de festoyer sur le bord de la route et de boire leur thé à la vue de tous<nbsp>?
#. speaker: MIYAKE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_MIYAKE_000_094:1"
msgid "The only difference is that table manners are practically nonexistent out here. The people have good hearts, but they have no sense of etiquette. They will eat their food on the streets and sip their tea in front of you!"
msgstr ""

#. ja: 食事ってのは、もっと親しい人と落ち着いた場所で、<br>するべきものなんだって、大きな声で言いたいもんだね。<br>小心者だから、衝立でもないと言えないけどさ……。
#. de: Ich kann mich einfach nicht dran gewöhnen. Mein Essen genieße ich am liebsten in Ruhe mit guten Freunden. Dabei besprechen wir wichtige Dinge, aber nur, wenn unsere Privatsphäre zumindest durch einen Wandschirm geschützt ist.
#. fr: La bienséance veut qu'on prenne son repas en famille ou avec des amis, dans un endroit à l'abri des regards. Que sais-je, ils pourraient <i>au moins</i> installer un paravent pour offrir un tant soit peu d'intimité<nbsp>!
#. speaker: MIYAKE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_MIYAKE_000_095:1"
msgid "One should take their meals behind closed doors with family or friends. \\<sigh> It would be nice if they would at least eat behind a partition of some sort and spare the rest of us the sight..."
msgstr ""

#. ja: 君の連れは、ずいぶん元気がいいね……。
#. de: Ist deine Freundin immer so aufgekratzt?
#. fr: Votre amie est toujours aussi excitée<nbsp>? Ça ne doit pas être drôle tous les jours...
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_096:1"
msgid "Your friend─she is full to the brim with energy."
msgstr ""

#. ja: <split " " 1><string $gs1></split>さん、<br>製作物が決まったらウチの所までお越しください。<br>材料をお渡ししますので～！
#. de: <split " " 1><string $gs1></split>, komm zu mir, sobald du dich entschieden hast, was du herstellen willst. Ich versorg dich mit den Materialien.
#. fr: Quel honneur de pouvoir me mesurrrer <if $gn4>à la grande menuisière<else>au grand menuisier</if> que vous êtes<nbsp>! Et tout ça aux frais de la guilde, hé hé<nbsp>!
#. speaker: CEMIJINJAHL
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_100:1"
msgid "<split \" \" 1><string $gs1></split>, remember to come and pick up your materials from me once you've decided on what you're going to make."
msgstr ""

#. ja: おや、<split " " 1><string $gs1></split>さん！<br>何を作るか決まったんですか？
#. de: Na, <split " " 1><string $gs1></split>, wie sieht es aus? Was braucht unser Kunde?
#. fr: Cette lueur dans vos yeux... Vous avez déjà décidé quel objet fabrrriquer pour notre petit duel, n'est-ce pas<nbsp>?
#. speaker: CEMIJINJAHL
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_110:1"
msgid "Ah, <split \" \" 1><string $gs1></split>! Have you finally decided on what you'll be making?"
msgstr ""

#. ja: 何を作って勝負する？
#. de: Was braucht der Koch für sein Restaurant?
#. fr: Quel objet fabriquer<nbsp>?
#. speaker: Q1
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_Q1_000_000:1"
msgid "What will you say?"
msgstr ""

#. ja: むしろ料理屋そのもの
#. de: Das komplette Restaurant.
#. fr: Un restaurant tout entier
#. speaker: Q1
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_Q1_000_001:1"
msgid "I'll be building the entire restaurant from the ground up!"
msgstr ""

#. ja: 料理を守るための木盾
#. de: Einen Holzschild, um das Essen zu verteidigen.
#. fr: Un bouclier pour protéger les serveuses
#. speaker: Q1
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_Q1_000_002:1"
msgid "A wooden shield to protect the food from, well, you know..."
msgstr ""

#. ja: 客席を仕切る衝立
#. de: Wandschirme zum Abtrennen der Sitzplätze.
#. fr: Un paravent pour l'intimité des clients
#. speaker: Q1
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_Q1_000_003:1"
msgid "Ornate partitions that can be hung between each of the tables."
msgstr ""

#. ja: ええっ！！<br>家具どころか店を建ててしまおうと！？<br>豪快が行きすぎてますよ！！
#. de: Wie bitte?! Wir wurden nach Möbeln gefragt und du willst gleich das ganze Gebäude bauen? Findest du das nicht etwas übertrieben?
#. fr: Ouah, un restaurant <i>tout entier</i><nbsp>? On peut dire que vous avez décidé de mettre les petits plats dans les grrrands<nbsp>! Mais il va vous falloir une tonz de matériaux pour ça... Vous payez de votre poche<nbsp>?
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_111:1"
msgid "Have you lost your mind? You're an amazing carpenter, but even you wouldn't be able to manage such a feat in so little time."
msgstr ""

#. ja: 盾が必要な料理屋って！？<br>食事中にいったいなにが起こるんですか……。<br>イヤですよ、そんなところで食事するの……。
#. de: Hm, wovor sollte man sich in einem Restaurant verteidigen müssen? Und falls ein Schild wirklich nötig sein sollte, würde ich da jedenfalls nicht gerne essen.
#. fr: Un bouclier... pour les serveuses<nbsp>? Euh, vous m'inquiétez, là... Quel genre d'uniforme doivent-elles porter<nbsp>? J'espèrrre que notre client n'a pas l'intention d'ouvrir un de ces éta<shy>blis<shy>se<shy>ments louches avec des soubrettes...
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_112:1"
msgid "Protect the food from what exactly? That doesn't sound like a place anyone would feel comfortable to dine at..."
msgstr ""

#. ja: ……衝立……ですか？<br>なにかこう、複雑な意匠の家具とかではなく？
#. de: Wandschirme? So einfach? Wie ich dich kenne, hätte ich mit irgendetwas Prachtvollerem gerechnet.
#. fr: Un simple paravent, vous êtes <if $gn4>sûre<else>sûr</if><nbsp>? Quelle surprise, je m'attendais à quelque chose de plus... comment dire... grrrandiose<nbsp>!
#. speaker: CEMIJINJAHL
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_113:1"
msgid "...Partitions? But that seems so...dull. That's not what you're <i>really</i> thinking to make is it?"
msgstr ""

#. ja: も、もしや<split " " 1><string $gs1></split>さん……<br>わざと負けようとしていませんか……？
#. de: Du ... du hast doch nicht etwa vor, absichtlich zu verlieren, oder?
#. fr: Dites-moi, vous ne serrriez pas en train de me laisser gagner, quand même...<nbsp>?
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_114:1"
msgid "...Wait! You're not trying to lose on purpose, are you?"
msgstr ""

#. ja: だとすれば心外です……！<br>ウチは自分の技術に絶対の自信を持っています！<br>勝ちを譲ってもらう必要はありません！
#. de: Das wäre wirklich eine herbe Enttäuschung. Ich habe viel gelernt und hart gearbeitet. Ich kann gewinnen, ohne dass du dich zurückhältst!
#. fr: Si c'est le cas, laissez-moi vous prévenir tout de suite<nbsp>: j'ai bien l'intention de vous affronter à la loyale, et de vous battre<nbsp>! Faites-moi au moins le plaisir de me prendre au sérrrieux, d'accord<nbsp>?
#. speaker: CEMIJINJAHL
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_115:1"
msgid "While I know I'm not yet as good as you, never did I think that you saw me as so far beneath you that you would feel the need to do <i>this</i>..."
msgstr ""

#. ja: そ、そうですよね……。<br>一流の職人である<split " " 1><string $gs1></split>さんが、<br>そんな無粋な真似をするわけがありませんよね……。
#. de: <split " " 1><string $gs1></split> ... Ich wollte dir nichts unterstellen. Mir hätte klar sein müssen, dass <if $gn4>eine erstklassige Handwerkerin<else>ein erstklassiger Handwerker</if> wie du immer höchste Perfektion anstrebt.
#. fr: Ah, je comprrrends mieux. Je me disais bien que ça ne vous ressemblait pas.
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_116:1"
msgid "My apologies. It seems I jumped to conclusions again. I know you're not the type of person to do something like that."
msgstr ""

#. ja: すみません……早く師匠に認められなければと焦っていて……。<br>おそらく今回が、ウチの技術を証明する最後のチャンス……。<br>もし認められなければ、今後仕事を与えてもらえないかも……。
#. de: Es tut mir leid. Ich habe einfach Angst, ich könnte Meister Beatin schon wieder enttäuschen. Vielleicht ist es die letzte Chance, mein Können unter Beweis zu stellen. Wer weiß, ob ich sonst je wieder einen Auftrag bekomme.
#. fr: Je suis vrrraiment désolée... J'étais tellement pressée de faire mes preuves que je me suis un peu emportée. Comprenez-moi, c'est sûrement ma dernière chance de me racheter aux yeux de Beatin<nbsp>!
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_117:1"
msgid "It's no excuse, but lately I've been on edge. I can't shake the feeling this is my last chance to convince Timbermaster Beatin that I am a capable carpenter, worthy of being called as such. If I don't, he might stop assigning me work, and I may as well leave the guild."
msgstr ""

#. ja: ウチが、早く一人前の職人になって、<br>財政難の木工師ギルドを救わなくちゃいけないんだ……。<br>そのためには、少しでも難しくて繊細で高級なものを作って……。
#. de: Ich muss möglichst schnell das Zimmererhandwerk des Fernen Ostens meistern, um unsere Gilde vor dem finanziellen Ruin zu bewahren. Dafür sollte ich etwas Exotisches herstellen, elegant und luxuriös ...
#. fr: Je dois absolument réussir à m'affirmer en tant que menuisière pour sauver la guilde de ses prrroblèmes, et pour ça, quoi de mieux qu'exécuter un ouvrage complexe pour faire étalage de ma technique<nbsp>?
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_118:1"
msgid "I shall not let it come to that! No matter what it takes, I must find a way to prove myself."
msgstr ""

#. ja: ……ハッ！<br>すみません！<br>「<sheet ItemHQ 17882 0>」の製作に必要な材料ですよね？
#. de: Huch! Verzeihung ... ich war in Gedanken. Was brauchst du an Material für <noun-de ItemHQ 1 17882 1 4 1>?
#. fr: Oh, je m'égare à nouveau... Tenez, voici les matériaux nécessaires pour fabriquer <noun-fr Item 1 17882 1 1> de bonne qualité<nbsp>! Vous savez ce que vous faites, et vous êtes librrre de choisir avec quel objet participer à notre duel.
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_119:1"
msgid "Oh, I completely forgot! I'm terribly sorry. I didn't mean to blabber on about my worries. After all, you're here for materials, aren't you?"
msgstr ""

#. ja: はい、どうぞ！<br>ギルドからいただいた研修費で購入したものですので、<br>気兼ねなくお使いください！
#. de: Hier, bitte sehr! Das Material habe ich aus der Reisekasse bezahlt, die mir Meister Beatin mitgegeben hat. Es steht dir ebenso zu wie mir. Viel Erfolg!
#. fr: Mais ne vous en faites pas pour les finances de la guilde. Toutes ces ressources que nous utilisons pour rendre service aux orientaux, c'est un in<shy>ves<shy>tis<shy>se<shy>ment pour l'avenirrr<nbsp>!
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_120:1"
msgid "Here you are. Feel free to come back if it's not enough."
msgstr ""

#. ja: 君の連れは、ずいぶん元気がいいね……。
#. de: Ist deine Freundin immer so aufgekratzt?
#. fr: Décidément, votre amie passe du rire aux larmes en un clin d'œil... Elle ne serait pas bipolaire<nbsp>?
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_121:1"
msgid "Is your friend always so...excitable?"
msgstr ""

#. ja: えっ、材料をなくした……？
#. de: Du hast das Material verloren? Wie konnte das denn passieren?
#. fr: Comment, plus de matérrriaux<nbsp>?
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_122:1"
msgid "You misplaced the materials I gave you? \\<sigh>"
msgstr ""

#. ja: ずいぶん余裕ですね……ウチのような若輩者など、<br>恐るるに足らずといったところでしょうか。
#. de: \<seufz> Na schön, als <if $gn4>Meisterzimmerin<else>Meisterzimmerer</if> kannst du es dir vermutlich leisten, nicht allzu genau auf die sparsame Verwendung bereitgestellter Materialien zu achten.
#. fr: Décidément, vous n'avez pas frrroid aux yeux. Venir quémander, alors que nous nous trouvons au beau milieu d'un duel acharné... J'admire votre aplomb, c'est bien la preuve que vous faites partie des plus grands, et que vous le savez<nbsp>!
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_123:1"
msgid "I guess one of the many perks of being a master carpenter is that you need not be subjected to long lectures when you lose things..."
msgstr ""

#. ja: ……す、すみません……今、余裕がなくて……。<br>……どうぞ、素材です。<br>お納めください。
#. de: Ah, tut mir leid, ich muss mich beeilen ... Hier, das Material, bitte sehr!
#. fr: Tenez, prrrenez vos matériaux. Et je compte sur vous pour ne pas me ménager<nbsp>!
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_124:1"
msgid "Well, here you are. Now I really must return to my work, so please do take care not to misplace your materials again."
msgstr ""

#. ja: 納品物を作成したら、<br>「レイザン」さんにお渡しください～。
#. de: Oh, und wenn du fertig bist, dann bring dein Werk doch bitte direkt zu Reizan! Mal sehen, wer von uns beiden schneller ist.
#. fr: Quand vous aurez terminé votre paravent, allez l'apporter dirrrectement à Reizan. Je vous ferai la surprise de ce que j'ai fabriqué, hé hé...
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_125:1"
msgid "Please, take your partitions to Reizan. I'll also make my way to him shortly."
msgstr ""

#. ja: おお、これは……。
#. de: Oh, das ist ja ...
#. fr: Oooh...
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_130:1"
msgid "Hm? What have we here?"
msgstr ""

#. ja: 先生にも見せてください……。
#. de: Dürfte ich auch einen Blick darauf werfen?
#. fr: Hmmm, fascinant...
#. speaker: BEATINE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_131:1"
msgid "Ahem. May I..."
msgstr ""

#. ja: し、師匠！？
#. de: Meister Beatin?!
#. fr: M-maître, vous êtes encorrre là<nbsp>!?
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_132:1"
msgid "Timbermaster Beatin!"
msgstr ""

#. ja: フフフフ……美しい食卓ですね……。<br>ドマ文化特有の絢爛な装飾が、見事に再現されています……。<br>とても新人が作ったとは思えない、高い技術力を感じますよ……。
#. de: Hm ... Was für ein schöner Esstisch. Die für Doma so typischen Ornamente sind hervorragend gelungen. Die Arbeit zeugt von einer überragenden Kunst<shy>fer<shy>tig<shy>keit auf professionellem Niveau. Gut gemacht, Cemi!
#. fr: Cette table à manger est vraiment splendide. Regardez-moi ces somptueuses ornementations, par<shy>fai<shy>te<shy>ment fidèles au plus pur style domien... Considérant le niveau de précision requis, c'est une prouesse admirable.
#. speaker: BEATINE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_133:1"
msgid "This table is exquisite. It is extremely sturdy, yet manages to maintain a sleek elegance. ...And these Doman-style engravings that run up and down the sides of the legs─if I did not know better I would guess they were the work of a more practiced pair of hands than your own, Cemi."
msgstr ""

#. ja: 次は<split " " 1><string $gs1></split>さんの作品ですが……<br>ふう……なんて、素敵な衝立なのでしょう……。<br>素材の特性を活かした、素晴らしい出来です……。
#. de: Nun zu deinem Werk, <split " " 1><string $gs1></split>. Ah, was für ein wundervoller Wandschirm! Die Lackierung kommt hervorragend zur Geltung.
#. fr: Passons à la création de <split " " 1><string $gs1></split>, maintenant. Sans surprise, elle est tout bonnement remarquable. Rendez-vous compte de quelle façon le bois précieux met en valeur ce paravent, tout en servant à merveille son usage...
#. speaker: BEATINE
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_134:1"
msgid "Now, <split \" \" 1><string $gs1></split>, let us see yours. Ah... Simple but all the more stunning for it. The lacquer finish is a nice touch─a light gloss that is just enough to enhance the natural blush of the wood, but not overpower it."
msgstr ""

#. ja: なるほど……これも素晴らしい逸品です……。<br>チェミの作った食卓ほど複雑な装飾はないものの、<br>再現するためには高い技術が要求されるでしょう……。
#. de: Ich bin wirklich beeindruckt. Der Wandschirm ist nicht so aufwendig verziert wie Cemis Esstisch, aber gerade diese Schlichtheit erfordert viel Geschick und Erfahrung.
#. fr: Vous avez <if $gn4>toutes<else>tous</if> les deux fourni un travail brillant. Il n'y a absolument rien à redire sur le paravent de <split " " 1><string $gs1></split>, mais je dois avouer que je suis médusé par la table de Cemi. En termes de technique pure, elle est clairement meilleure.
#. speaker: BEATINE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_135:1"
msgid "While both of these are masterpieces in their own right, I will say this: the detailed engravings on the table are something even a highly skilled artisan would struggle to recreate."
msgstr ""

#. ja: 私個人の批評としては……こんなものです……。<br>しかし、あくまで作品の善し悪しを選ぶのは、依頼人の方……。<br>さあ、どちらを受け取るか、決めてください……。
#. de: Das ist alles nur meine persönliche Meinung, doch heute soll es nicht an mir liegen, eure Arbeit zu beurteilen. Werter Reizan, welches Möbelstück gefällt dir besser?
#. fr: Bien sûr, cet avis n'engage que moi. Le véritable juge, celui dont l'opinion prime sur tout, c'est le client. Je vous en prie Reizan, rendez votre verdict.
#. speaker: BEATINE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_136:1"
msgid "What do you think, sir?"
msgstr ""

#. ja: あ、ああ。<br>どっちを選ぶかは、初めに見たときから決まってるんだ。<br>今回の依頼、私が選ぶ勝者は…………
#. de: Ah ja, mir war schon auf den ersten Blick klar, was das Richtige für mich ist. Meine Wahl fällt auf<nbsp>...
#. fr: Eh bien, ce sera rapide. Mes con<shy>nais<shy>san<shy>ces en menuiserie sont bien trop limitées pour me permettre d'avoir un avis aussi avisé. À vrai dire, à l'instant même où j'ai découvert ces deux créations, mon choix était fait.
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_137:1"
msgid "The moment I saw it, I knew which one of these I wanted─desperately needed, even. I choose..."
msgstr ""

#. ja: こちらだ！
#. de: Den Wandschirm!
#. fr: Je choisis ce paravent<nbsp>!
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_138:1"
msgid "This one!"
msgstr ""

#. ja: た、確かに、<split " " 1><string $gs1></split>さんが作った物は、<br>素晴らしい出来だと思います……。<br>でも……ウチだって、技術力では劣っていないはずです！！
#. de: Oje, mir ist schon klar, dass <split " " 1><string $gs1></split> viel erfahrener ist als ich, und <if $gn4>ihr<else>sein</if> Werk ist wunderschön, aber ich hab mir solche Mühe gegeben. Ich dachte wirklich, dieses Mal hätte ich eine Chance!
#. fr: Je ne comprrrends pas<nbsp>! Je reconnais que le travail de <split " " 1><string $gs1></split> est de très bonne facture, mais en toute objectivité, ma table est techniquement bien meilleure<nbsp>!
#. speaker: CEMIJINJAHL
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
#. macro: <if $gn4>she<else>he</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_139:1"
msgid "That <split \" \" 1><string $gs1></split> is a better carpenter than me, I won't deny. That <if $gn4>she<else>he</if> has skills I could only ever dream of attaining, I'll also admit... But I...I poured my heart and soul into that table!"
msgstr ""

#. ja: ……依頼人の方、なぜそちらを選ばれたのですか……？
#. de: Dürfte ich fragen, warum du dem Werk von <split " " 1><string $gs1></split> den Vorzug gegeben hast?
#. fr: Puis-je me permettre de vous demander ce qui a motivé votre choix, Reizan<nbsp>?
#. speaker: BEATINE
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_140:1"
msgid "Sir, why is it that you chose <split \" \" 1><string $gs1></split>'s partitions over Cemi's table?"
msgstr ""

#. ja: ああ……ドマ町人地の人たちは、食事を他人に見せることを嫌う。<br>だから、この衝立で仕切りを作ってあげることで、<br>安心して食事を楽しんでもらえると思ったんだ。
#. de: Gerne ... Ich habe gehört, dass die Stadtbewohner sich nicht gerne beim Essen beobachten lassen. Wenn ich die Sitzplätze mit diesem Wandschirm abtrenne, können sie ungestört ihr Essen genießen.
#. fr: Eh bien, vous devez savoir que les Domiens sont très pudiques et n'aiment pas manger à la vue des inconnus. Ce paravent me permettra d'effectuer une séparation dans mon restaurant, et mes clients se sentiront na<shy>tu<shy>rel<shy>le<shy>ment plus à l'aise.
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_141:1"
msgid "Simple, really. Doman city folk are a private sort. They would appreciate the way these wooden barriers would hide them from sight as they eat."
msgstr ""

#. ja: 確かに、そのお嬢さんが作った食卓は逸品だ。<br>でも、どんなに豪華絢爛な食卓でも、それだけでは、<br>心置きなく食事をすることはできないんだ。
#. de: Der Esstisch ist ein Kunstwerk, keine Frage, aber ich habe mich dazu entschieden, in meinem Restaurant vor allem auf den praktischen Nutzen Wert zu legen. An solch einem offensichtlich teurem Tisch könnten sich meine Gäste kaum entspannen.
#. fr: Bien sûr, la table de ma<shy>de<shy>moi<shy>sel<shy>le est magnifique et serait du plus bel effet dans mon restaurant. Mais pour moi, il n'y a rien de plus important que le bien-être de mes clients.
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_142:1"
msgid "The young lady's table is magnificent─a work of art, even. However, it does not fulfill the needs of my customers like these partitions do."
msgstr ""

#. ja: チェミ……<br>あなたは依頼を受けた後、現地の人々と触れ合う時間を惜しみ、<br>豪華で複雑な意匠を探し求めて、歩き回っていたのでは？
#. de: Die aufwendigen Verzierungen lassen mich vermuten, dass du die Zeit genutzt hast, um domanische Muster zu studieren, anstatt wie geraten die potenziellen Gäste zu befragen.
#. fr: Ma petite Cemi, j'ose espérer qu'après avoir accepté la commande de ton client, tu as pris le temps nécessaire pour te renseigner et réfléchir à l'objet qui serait le plus à même de combler ses attentes<nbsp>?
#. speaker: BEATINE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_143:1"
msgid "It seems the time it took to carve the intricate detailing on this table would have been better spent interviewing the local citizens."
msgstr ""

#. ja: 自らの技術力を証明することに固執し、<br>依頼人の心に真摯に向き合うことがなかった……。<br>これでは、依頼人を満足させることはできません……。
#. de: Bei der Herstellung dieses Tisches standen nicht die Bedürfnisse des Kunden im Vordergrund, sondern die Zurschaustellung handwerklichen Geschicks.
#. fr: Je vois... Tu n'as pensé qu'à l'aspect technique de ton travail, choisissant un objet qui te permettrait de faire étalage de ton habileté de menuisière. Au risque de te décevoir, ça ne suffit pas à faire un bon artisan.
#. speaker: BEATINE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_144:1"
msgid "Cemi, do you understand now why it is you lost? You were so focused on demonstrating your own skill that you disregarded the needs of the client."
msgstr ""

#. ja: きっと<split " " 1><string $gs1></split>さんは、<br>自らの足を使って、現地の人々と触れ合って回ったのでしょう……。
#. de: <split " " 1><string $gs1></split> hingegen war sich nicht zu schade, umherzulaufen und mit den Dorfbewohnern zu sprechen.
#. fr: Tu devrais prendre exemple sur <split " " 1><string $gs1></split>. Comme tu as pu le constater, <if $gn4>elle<else>il</if> est totalement à l'écoute des besoins de son client.
#. speaker: BEATINE
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_145:1"
msgid "<split \" \" 1><string $gs1></split>, on the other hand, spoke with the residents of this village, which inspired <if $gn4>her<else>him</if> to create these partitions─a product that places the customer's needs above all else."
msgstr ""

#. ja: この衝立からは、<br><split " " 1><string $gs1></split>さんの真心を感じます。<br>とても良い製作物だと思います……。
#. de: Dieser Wandschirm verkörpert aufrichtiges Interesse an den Kundenwünschen, und deshalb ist er so gut geworden.
#. fr: Bien sûr, <if $gn4>elle<else>il</if> ne se contente pas de lire le cœur de son commanditaire, <if $gn4>elle<else>il</if> s'applique aussi à fournir un objet en tout point irréprochable.
#. speaker: BEATINE
#. macro: <if $gn4>her<else>his</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_146:1"
msgid "In that sense, the difference between your table and <if $gn4>her<else>his</if> partitions is the difference between a decent carpenter and a master of the craft."
msgstr ""

#. ja: さて、ふたりとも……<br>異国の文化を学ぶ旅はこれで終わりです……。<br>グリダニアの「木工師ギルド」へと帰りましょう……。
#. de: Nun gut, ich glaube, ihr habt genug gelernt. Die Reise durch den Fernen Osten kann nicht ewig währen. Kehren wir zurück nach Gridania in unsere Gilde.
#. fr: Sur ces belles paroles, je pense qu'il est temps de mettre fin à votre petit voyage initiatique en Orient. Rentrons à la guilde, que vous me racontiez <if $gn4>toutes<else>tous</if> les deux ce que vous avez appris.
#. speaker: BEATINE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_147:1"
msgid "That said, this is where your journey ends. I expect to see the both of you back in Gridania shortly after I return."
msgstr ""

#. ja: も、もしかしてウチ……<br>師匠に見切りをつけられたのでしょうか……？<br>ああ、ウチはもうおしまいです……。
#. de: B-Bedeutet das etwa, dass Meister Beatin mich für unfähig hält? Was soll bloß aus mir werden?
#. fr: Vous avez entendu ça, <split " " 1><string $gs1></split><nbsp>? Il m'en veut, ça ne fait aucun doute. Cette fois ça y est, ma carrière de menuisièrrre est fichue...
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_148:1"
msgid "No... No, it can't be. Please tell me Timbermaster Beatin hasn't given up on me. Oh, what am I to do?"
msgstr ""

#. ja: なんだかわからないが、<br>ともかく、素晴らしい品をありがとうよ。<br>きっと家具に見合うだけの店にしてみせるからな！
#. de: Ich hab keinen blassen Schimmer, worum es gerade ging, aber für den Wandschirm bin ich dankbar. Ich werde ein Restaurant errichten, in dem er gut zur Geltung kommt. Das verspreche ich!
#. fr: Vous autres menuisiers prenez <i>vraiment</i> votre travail au sérieux, hein... En tout cas, je vous remercie du fond du cœur pour ce magnifique paravent qui trônera fièrement au milieu de mon futur restaurant.
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_149:1"
msgid "Is your friend all right? While I cannot claim to understand what any of that was about, I would like to thank you for your wonderful contribution. It is sure to suit my restaurant perfectly."
msgstr ""

#. ja: もう完成したのですか……？<br>では、「レイザン」さんにお渡しください。<br>……ウチもうかうかしてられません……。
#. de: Du bist schon fertig? Oje, da muss ich mich aber beeilen! Bring dein Möbelstück doch gleich zu Reizan!
#. fr: Ça y est, vous êtes <if $gn4>prrrête<else>prrrêt</if><nbsp>? Dans ce cas, allez trouver Reizan pour lui montrer votre ouvrage. Quant à ce que j'ai fabriqué, ça sera la surprise, hé hé...
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_150:1"
msgid "You've finished? Already? Well, what are you waiting for─take it to Reizan. I'll join the two of you shortly."
msgstr ""

#. ja: ドマ町人地で店を開くことは、私の夢なんだ。<br>どうか力を貸してほしい。
#. de: Ein Restaurant in der Stadt zu eröffnen, ist mein absoluter Traum. Bitte hilf mir dabei, ihn zu verwirklichen.
#. fr: Cela a toujours été mon rêve de tenir mon propre restaurant dans ma ville de cœur. Je vous serais tellement re<shy>con<shy>nais<shy>sant si vous m'aidiez à le réaliser.
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_151:1"
msgid "Opening up a restaurant has always been a dream of mine. To think that it might soon be within my grasp fills me with joy beyond belief."
msgstr ""

#. ja: 先生、今までどこに行ってたのよ！<br>ベアティヌ先生に作ってもらった机がね～、壊れちゃって。<br>私あの机じゃないと駄目なのよ～……先生、直してくださる？
#. de: Meister Beatin, den Gebietern sei Dank, dass Ihr wieder hier seid. Der Tisch, den Ihr mir gezimmert habt, ist kaputt. In dem Zustand kann ich einfach nicht damit arbeiten. Bitte, repariert ihn für mich!
#. fr: Où étiez-vous passé pendant tout ce temps, Maître Beatin<nbsp>? Je vous ai cherché partout<nbsp>! Le bureau que vous m'avez fabriqué est endommagé, pourriez-vous le remettre en état<nbsp>? Je l'aime trop pour m'en séparer<nbsp>!
#. speaker: CUSTOMERA02444
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CUSTOMERA02444_000_170:1"
msgid "Timbermaster Beatin, thank the Matron you've returned! The drawers of this desk you made for me are broken. Is there a chance they can be fixed?"
msgstr ""

#. ja: そこまで気に入ってくださっているなら、<br>喜んで、修理させて頂きますとも……。<br>後ほど、お伺いします……。
#. de: Wie könnte ich da Nein sagen? Ich freue mich, dass dir der Tisch so ans Herz gewachsen ist. Mal sehen, was ich tun kann. Ich sage dir später Bescheid.
#. fr: Je suis honoré qu'il vous plaise à ce point. Vous avez dû l'utiliser intensivement pour qu'il soit aussi abîmé<nbsp>! Laissez-moi un peu de temps et il sera comme neuf.
#. speaker: BEATINE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_171:1"
msgid "I shall see what can be done. After all, I can hardly say no to someone who has so cherished one of my creations as you have."
msgstr ""

#. ja: 先生、聞いとくれよ！<br>息子が双蛇党に入ることになったんだ！<br>お祝いに槍を送りたいんだけど、先生に作ってもらえないかな？
#. de: Meister Beatin, bitte hört mich an! Mein Sohn wurde in die Bruderschaft der Morgenviper aufgenommen, braucht vor Dienstantritt aber dringend noch einen neuen Speer. Könnt Ihr ihn persönlich herstellen? Es wäre uns eine große Ehre!
#. fr: Maître Beatin<nbsp>! Mon fils a été admis dans l'ordre des Deux Vipères, et j'aimerais lui offrir une nouvelle lance pour le féliciter. Pouvez-vous vous en occuper<nbsp>?
#. speaker: CUSTOMERB02444
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CUSTOMERB02444_000_172:1"
msgid "Timbermaster Beatin, sir. My son─he's just been accepted into the Order of the Twin Adder. To celebrate, I'd like to have you craft him a fine spear."
msgstr ""

#. ja: ほう……それはおめでたいですね……。<br>フフフフ……息子さんが使命をやり抜くことができるよう、<br>最高の槍をご用意しますよ……やり抜けるように……フフフフ。
#. de: Oh, in die Bruderschaft der Morgenviper, alle Achtung! Das ist eine herausragende Leistung. Ich sorge dafür, dass er seinen Speer rechtzeitig bekommt. Möge er damit viele Heldentaten vollbringen!
#. fr: Fé<shy>li<shy>ci<shy>ta<shy>tions, vous devez être très fier de lui<nbsp>! Je suis sûr qu'il est du <i>bois</i> dont on fait les héros, hi hi hi... Ne vous en faites pas pour cette lance, je m'en charge<nbsp>!
#. speaker: BEATINE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_173:1"
msgid "Order of the Twin Adder... That is quite the accomplishment. Very well. I shall make him a one that will see him through all his battles."
msgstr ""

#. ja: あちゃー、僕も先生に頼みたいことがあったんだけど。<br>さすがベアティヌ先生は、大人気だね。
#. de: He, ich hatte auch noch eine Bitte an Meister Beatin, aber damit muss ich wohl warten. Der Meister ist ein vielgefragter Mann.
#. fr: Oh non, moi qui voulais confier ma commande à maître Beatin, je crois que j'arrive trop tard. Débordé comme il est, il ne pourra pas s'occuper de moi<nbsp>!
#. speaker: CUSTOMERC02444
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CUSTOMERC02444_000_174:1"
msgid "Wait, sir! Come back! \\<sigh> I also had a request for him, but I suppose it'll have to wait. I should have known getting the finest carpenter in all of Gridania to make something for you wasn't going to be an easy task."
msgstr ""

#. ja: あの……どうして師匠は、<br>こんなに皆さんに好かれてらっしゃるのでしょうか？
#. de: Äh, dürfte ich dich fragen, warum für deinen Auftrag nur Meister Beatin in Frage kommt? Warum ist er so beliebt?
#. fr: Dites... Pourquoi Beatin est-il si populairrre, à Gridania<nbsp>?
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_175:1"
msgid "Excuse me. Um... If you don't mind my asking, why is it that all of you like Timbermaster Beatin so much?"
msgstr ""

#. ja: 先生が作った物ってさ、使ってみるとすぐわかるんだよ。<br>これは、僕のために作られた物なんだってね。<br>あの人はいつも、誰かのために物を作っているのさ。
#. de: Meister Beatin passt jeden Gegenstand, den er anfertigt, mit liebevoller Hingabe ganz genau an die individuellen Bedürfnisse seiner Kunden an. Das spürt man sofort, sobald man eines seiner Werke ausprobiert. Jedes von ihnen ist für eine ganz bestimmte Person geschaffen.
#. fr: Il suffit d'utiliser l'objet que vous lui avez commandé pour comprendre. Ce qu'il fabrique, il le fabrique <i>pour vous</i>. On sent tout de suite que chacune de ses créations a été pensée pour la personne qui l'a commandée.
#. speaker: CUSTOMERC02444
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CUSTOMERC02444_000_176:1"
msgid "When you ask him to make something, he creates that item for you and you alone."
msgstr ""

#. ja: 誰かのために物を作る……。<br>そういえば……ウチも始めはそうだった……。
#. de: Nicht um des Handwerks Willen, sondern für die Bedürfnisse des Kunden ... Das erinnert mich an meine Kindheit<nbsp>...
#. fr: Créer quelque chose d'unique, pour quelqu'un en parrrticulier... Maintenant que j'y pense, moi aussi, lorsque j'ai débuté...
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_177:1"
msgid "To make something for that person and that person alone... Thinking back, that's how I first got into carpentry."
msgstr ""

#. ja: ウチが生まれた家は、お世辞にも裕福とは言えなくて、<br>家具すらろくに揃えることもできませんでした。
#. de: Ich stamme aus einer bettelarmen Familie, die sich nichts leisten konnte, nicht einmal die einfachsten Möbel.
#. fr: Je suis née dans une famille très modeste. Notrrre maison était presque vide, car nous n'avions même pas de quoi nous payer des meubles...
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_178:1"
msgid "I was born into a family poorer than dirt─one where we couldn't afford to purchase even the most basic of furniture."
msgstr ""

#. ja: それでもお母さんは、ウチら娘たちを育てるために、<br>女手ひとつで頑張って働いてくれていました。<br>でも、そのせいで腰を悪くしてしまったんです。
#. de: Meine Mutter zog mich und meine Geschwister ganz allein groß. Sie schuftete Tag und Nacht, um uns satt zu kriegen, bis eines Tages ihr Rücken den Dienst versagte.
#. fr: Ma mère a travaillé trrrès dur pour nous élever, moi et mes sœurs. Tellement dur qu'un jour, son dos est resté bloqué.
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_179:1"
msgid "My mother raised us by herself, working from dawn until dusk so that my sisters and I wouldn't go to bed hungry every night. As a result, she pushed herself too hard and one day, the pain in her back became too much to bear."
msgstr ""

#. ja: どうにかしてお母さんの力になりたかったウチは、<br>幼いながらに一生懸命、安楽椅子を作ってあげたんです。
#. de: Ich wollte ihr irgendwie helfen, also versuchte ich mich an meiner allerersten Handwerksarbeit. Ich fertigte ihr einen Lehnstuhl an, damit sie sich besser ausruhen konnte.
#. fr: J'aurais fait n'importe quoi pour l'aider... J'étais encorrre très jeune, mais j'ai décidé de lui fabriquer un fauteuil, pour qu'elle puisse s'y reposer.
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_180:1"
msgid "Seeing her suffering drove me to make her an armchair in which she could rest from time to time. It was all the young me could think to do."
msgstr ""

#. ja: 今から思えば、そりゃもうつたない椅子だったけど、<br>あれを作っているときは、お母さんのことしか考えてなかったなぁ。<br>そっか……誰かのために物を作る、ということなんですかね……。
#. de: Klar, es war ein grob gezimmertes, hässliches Teil, aber es erfüllte seinen Zweck. Bei seiner Herstellung habe ich nur an meine Mutter gedacht. So muss es sein, wenn man die Bedürfnisse seiner Kunden erfüllen will.
#. fr: Une fois terminé, le résultat n'était pas glorrrieux. Mon fauteuil était même bancal<nbsp>! Mais en le fabriquant, je n'ai pas arrêté une seule seconde de penser à ma pauvre mère...
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_181:1"
msgid "While the finished product creaked and buckled under her weight, not for a single moment as I was making it did I lose sight of the fact that I was doing it all for her."
msgstr ""

#. ja: お母さんを楽にさせてあげたいと焦っている内に、<br>早く一人前になることばかり、考えるようになっていた……。<br>あの気持ちを、どこかに落っことしてきちゃったんですかね……。
#. de: Aber das Elend meiner Mutter hat mir auch Angst gemacht. Ich wollte unbedingt erfolgreich sein, doch bei der Jagd nach Erfolg habe ich nach und nach das eigentliche Ziel aus den Augen verloren.
#. fr: Qu'est-ce qui a changé en moi, depuis cette époque<nbsp>? En grrrandissant, j'en suis venue à ne me soucier que de mon propre sort. J'aimerais tant retrouver mon âme d'enfant...
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_182:1"
msgid "I've been so preoccupied with myself─with trying to prove my skills─that somewhere along the way I forgot the most important thing..."
msgstr ""

#. ja: 落としてしまったのなら、また拾えばいいだけです……。
#. de: Nun ja, wenn man etwas verloren hat, muss man es nur wiederfinden.
#. fr: Il n'est jamais trop tard, tu sais<nbsp>?
#. speaker: BEATINE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_183:1"
msgid "It is never too late to remember and begin anew..."
msgstr ""

#. ja: チェミ、確かにあなたは職人として大事なことを見失っていた。<br>ですが、そのことに気づいたあなたは、<br>きっとこれからいい職人になるでしょう……。
#. de: Cemi, du hast tatsächlich etwas Wichtiges aus den Augen verloren, aber die Erkenntnis darüber bringt dich wieder auf den richtigen Weg. Du wirst eine großartige Handwerkerin!
#. fr: Ma petite Cemi, je pense qu'à un certain moment, tu t'es perdue sur la voie de l'artisanat... Mais ce qui compte, c'est que tu t'en sois rendu compte<nbsp>! Je ne doute pas que tu deviendras un jour une grande menuisière.
#. speaker: BEATINE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_184:1"
msgid "Cemi, the key to harnessing your own potential is to recognize what is holding you back. From here, you can only grow."
msgstr ""

#. ja: 師匠……！！<br>は、はいっ、ウチ、頑張ります！！
#. de: Meister, danke, Eure Worte bedeuten mir sehr viel!
#. fr: M-merci, Maître... Je vous promets de faire de mon mieux pour rentrer dans le drrroit chemin et répondre à vos attentes<nbsp>!
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_185:1"
msgid "...Yes. Yes, sir! You're absolutely right. There is still hope for me."
msgstr ""

#. ja: <split " " 1><string $gs1></split>さんも、<br>こんなウチをずっとサポートしてくれてありがとうございます！<br>もう二度と、大事なことを見失ったりしませんから！
#. de: Und dir, <split " " 1><string $gs1></split>, danke ich von Herzen für deine Unterstützung! Dank dir habe ich eine wichtige Erkenntnis erlangt, vielleicht die wichtigste meines Lebens.
#. fr: <split " " 1><string $gs1></split>, perrrmettez-moi de vous remercier pour le soutien que vous m'avez apporté depuis notre rencontre. Je ne vous décevrai plus, foi de Cemi<nbsp>!
#. speaker: CEMIJINJAHL
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_186:1"
msgid "<split \" \" 1><string $gs1></split>, thank you for supporting me until now. It is only because of you that I have come this far."
msgstr ""

#. ja: よーし、そうと決まれば、まずは製材です！<br>チェミ・ジンジャル流、木工師の心得・そのいち！<br>良い物を作るためには、いい木材から！
#. de: Ich fühle mich wie neu geboren. Also, frisch ans Werk! Säge gezückt! Für die besten Holzmöbel brauche ich bestes Holz!
#. fr: Sur ces belles paroles, au travail<nbsp>! La base de notre artisanat, c'est le bois, donc je m'en vais de ce pas sélectionner les matériaux qui me serviront pour mes prochaines créations. À la prrrochaine<nbsp>!
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_187:1"
msgid "In fact, I'd go so far as to say that our grand adventures together have made me feel as though I've been born again. I am looking forward to exploring the world of carpentry once more!"
msgstr ""

#. ja: 私からもお礼を言わせてください……。<br>木について語ることは得意でも、人と話すのは苦手でして……<br>あなたが、いい見本になってくれた……。
#. de: Auch ich danke dir, <split " " 1><string $gs1></split>. Über Holz fällt mir das Reden leicht, doch im Umgang mit anderen Leuten bin ich weniger gewandt. Du hast da ein viel besseres Händchen.
#. fr: Vous savez, <split " " 1><string $gs1></split>, je peux m'épancher sur mon amour du bois pendant des heures, mais je ne suis pas le plus à l'aise quand il s'agit de former mes apprentis... Vous êtes un exemple pour Cemi, et pour ça je vous remercie.
#. speaker: BEATINE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_188:1"
msgid "She is not the only one who owes you a debt of gratitude. While I am skilled at working with wood, I am not nearly so adept at dealing with people and their problems. You have helped Cemi in ways I could not."
msgstr ""

#. ja: フフフフ……だから、きっとあの子はもう大丈夫でしょう……。<br>もし心配なら、お帰りの際にでも、ギルド入口にいるであろう、<br>チェミに声をかけていってくださいね……。
#. de: Du warst Cemi ein gutes Vorbild und hast sie auf einen guten Weg gebracht. Ich glaube, wir müssen uns um sie keine Sorgen mehr machen. Trotzdem freut sie sich bestimmt, wenn du ab und zu nach ihr siehst. Ich vermute, sie wird in nächster Zeit ihren Arbeitsplatz vor der Gilde kaum verlassen.
#. fr: Avec un modèle comme vous, je ne me fais pas de souci pour elle. N'hésitez pas à lui rendre visite quand vous serez de passage à Gridania, elle sera sûrement à l'entrée de la guilde en train de s'exercer.
#. speaker: BEATINE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_189:1"
msgid "You are part of the reason I have such high hopes for the girl. With a mentor like you to look up to, she will no doubt flourish. That is why I ask that you speak with her one last time before you leave."
msgstr ""

#. ja: いろいろとありがとう。<br>いつか店を開くことができたら、そのときは遊びにきてくれるかい。
#. de: Tausend Dank für deine Hilfe! Sobald ich mein Restaurant eröffnet habe, musst du mich unbedingt besuchen!
#. fr: Je vous serai éter<shy>nel<shy>le<shy>ment re<shy>con<shy>nais<shy>sant. Passez à mon restaurant lorsqu'il sera ouvert, je me ferai un plaisir de vous inviter<nbsp>!
#. speaker: REIZAN
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_REIZAN_000_195:1"
msgid "Thank you for all your help. If you ever come back for a visit, do be sure to stop by my new restaurant."
msgstr ""

#. ja: あ、<split " " 1><string $gs1></split>さん！<br>近々、師匠に依頼人の方をご紹介していただけるとのことです！<br>生まれ変わったウチをご覧に入れたいので、ご同席くださいね！
#. de: <split " " 1><string $gs1></split>, stell dir vor, Meister Beatin hat mich für würdig befunden, Aufträge für die Gilde auszuführen! Ich bin ja so aufgeregt!
#. fr: <split " " 1><string $gs1></split>, écoutez un peu ça<nbsp>! Beatin va me présenter un de ses clients<nbsp>! J'espère que vous serez à mes côtés pour être témoin du premier ouvrrrage de la nouvelle Cemi<nbsp>!
#. speaker: CEMIJINJAHL
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_200:1"
msgid "<split \" \" 1><string $gs1></split>, you'll be happy to hear that Timbermaster Beatin has finally deemed my work good enough to begin taking on some of my own clients! Isn't it so exciting?"
msgstr ""

#. ja: で、何をしているかというと、依頼人の方を待つ間、<br>異国を回って見てきたものを、<br>復習がてらに作ってみようかと！
#. de: Während ich auf die Kunden warte, will ich mich an Möbelstücken im fernöstlichen Stil versuchen. Nur so zur Übung, um nicht zu verlernen, was ich mir auf meiner Reise durch den Fernen Osten angeeignet habe.
#. fr: En attendant, je vais continuer à m'exercer en fabriquant des meubles orrrientaux pour ne pas oublier ce que j'ai appris à Kugane et Namai.
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_201:1"
msgid "That's not to say I'll forget about my studies or the guild's troubles, however. In between commissions, I'll be spending my time practicing how to make oriental furniture. That way, I can retain all that I learned from our trips to Kugane and Namai."
msgstr ""

#. ja: ふふ……ただ作るのではなく、<br>出会った人たちの顔を思い浮かべながら……ですよね！
#. de: Hihi, dabei will ich mich nicht einfach auf das Handwerk konzentrieren, sondern vor allem auf die Leute, die sie später verwenden werden.
#. fr: Rassurez-vous, je le ferai avec les intérêts de mes clients en tête. Cette fois, j'ai bien rrretenu la leçon<nbsp>!
#. speaker: CEMIJINJAHL
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_202:1"
msgid "But that's not all. I'll be keeping the people we met there in mind. They'll help me to remember that I am making this furniture not for myself, but for those around me."
msgstr ""

#. ja: ふふふ！<br>よーし！<br>不肖このチェミ・ジンジャル、もう一度頑張るぞ～！！
#. de: Meister Beatin soll stolz auf mich sein! Ich werde ihn nie wieder enttäuschen!
#. fr: En tout cas, je compte sur vous pour m'encourrrager. À vos côtés, j'ai le sentiment que rien ne peut plus m'arrêter<nbsp>!
#. speaker: CEMIJINJAHL
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_CEMIJINJAHL_000_203:1"
msgid "You'll see, <split \" \" 1><string $gs1></split>. I'm going to work so hard that one day, I'll be as good as you."
msgstr ""

#. ja: 職人として大切なことを思い出したあの子は、<br>必ずや芽吹いて、真っ直ぐな大樹へと育つことでしょう……。
#. de: Cemi hat das Geheimnis großer Handwerkskunst für sich entdeckt. So wird ein zartes Pflänzchen zu einem mächtigen Baum heranwachsen!
#. fr: En se rappelant la mentalité candide de ses débuts, la petite Cemi vient de véritablement lancer sa carrière d'artisane. En la regardant, je vois une petite pousse fragile qui vient de naître et deviendra un jour un arbre majestueux...
#. speaker: BEATINE
msgctxt "quest/024/ClsWdk680_02444:TEXT_CLSWDK680_02444_BEATINE_000_205:1"
msgid "Cemi has stumbled across the secret to becoming a true craftsman. While she may be but a seed now, it shall not be long until she begins to bud. I look forward to seeing just how she blossoms."
msgstr ""
