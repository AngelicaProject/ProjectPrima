msgctxt "quest/024/FesVlt301_02419:TEXT_FESVLT301_02419_SYSTEM_000_080:1"
msgid "You have learned the emote <ui-color 500><ui-edge-color 501>Dote</ui-edge-color></ui-color>!"
msgstr "Вы выучили эмоцию <ui-color 500><ui-edge-color 501>Обожание</ui-edge-color></ui-color>!"
