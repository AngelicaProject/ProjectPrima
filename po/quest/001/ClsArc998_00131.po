msgctxt "quest/001/ClsArc998_00131:TEXT_CLSARC998_00131_SYSTEM_000_42:1"
msgid "A button for the Gear Set interface is located in the upper portion of the <ui-color 500><ui-edge-color 501>Character</ui-edge-color></ui-color> window."
msgstr "Кнопка набора снаряжения находится в верхней части окна «<ui-color 500><ui-edge-color 501>Персонаж</ui-edge-color></ui-color>»."
