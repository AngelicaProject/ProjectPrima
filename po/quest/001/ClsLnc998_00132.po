msgctxt "quest/001/ClsLnc998_00132:TEXT_CLSLNC998_00132_SYSTEM_000_42:1"
msgid "A button for the Gear Set interface is located in the upper portion of the <ui-color 500><ui-edge-color 501>Character</ui-edge-color></ui-color> window."
msgstr "Кнопка наборов снаряжения находится в верхней части окна <ui-color 500><ui-edge-color 501>«Персонаж»</ui-edge-color></ui-color>."
