#. de: Mit Tauchende Taube sprechen
#. fr: Parler à Diving Dove
#. kind: objective
msgctxt "quest/002/ClsCul501_00270:TEXT_CLSCUL501_00270_TODO_00:1"
msgid "Speak with Diving Dove."
msgstr ""

