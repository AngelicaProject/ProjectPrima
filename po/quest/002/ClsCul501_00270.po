#. de: Mit Latisha sprechen
#. fr: Parler à Latisha
#. kind: objective
msgctxt "quest/002/ClsCul501_00270:TEXT_CLSCUL501_00270_TODO_01:1"
msgid "Speak with Latisha."
msgstr ""

