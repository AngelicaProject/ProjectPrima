msgctxt "quest/002/ClsCul011_00271:TEXT_CLSCUL011_00271_SYSTEM_000_32:1"
msgid "A button for the Gear Set interface is located in the upper portion of the <ui-color 500><ui-edge-color 501>Character</ui-edge-color></ui-color> window."
msgstr "Кнопка интерфейса комплектов экипировки находится в верхней части окна <ui-color 500><ui-edge-color 501>Персонаж</ui-edge-color></ui-color>."
