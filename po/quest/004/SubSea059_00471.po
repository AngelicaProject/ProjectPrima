#. de: Gelöscht
#. fr: 削除ラベル
#. kind: other
msgctxt "quest/004/SubSea059_00471:TEXT_SUBSEA059_00471_TALK_SCENE00002_000:1"
msgid "Deleted"
msgstr "Удалено"

