msgctxt "quest/004/SubSea118_00415:TEXT_SUBSEA118_00415_FYRILSMYD_000_33:1"
msgid "Could ye tell Ahtbyrm that I'll be back at the Drydocks by <if ($gn11 < 12)><if ($gn11 < 4)>daybreak<else>nightfall</if><else><if ($gn11 < 17)>nightfall<else>daybreak</if></if>? Many thanks, adventurer! I will not forget this kindness!"
msgstr ""

#. ja: キキルン・エッグディガーに気づかれた！
#. de: Die Qiqirn haben dich entdeckt!
#. fr: Un Qiqirn dénicheur d'œufs vous a repéré<if $gn4>e</if><nbsp>!
#. speaker: SYSTEM
msgctxt "quest/004/SubSea118_00415:TEXT_SUBSEA118_00415_SYSTEM_000_40:1"
msgid "You are discovered by a Qiqirn!"
msgstr ""
