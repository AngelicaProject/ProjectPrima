msgctxt "quest/051/BanPel001_05193:TEXT_BANPEL001_05193_SYSTEM_000_806:1"
msgid "You have learned the emote <ui-color 500><ui-edge-color 501>Ohokaliy</ui-edge-color></ui-color>!"
msgstr "Вы выучили эмоцию <ui-color 500><ui-edge-color 501>«Охокалий»</ui-edge-color></ui-color>!"
