#. speaker: DUMMY
msgctxt "quest/009/GaiUsc406_00981:TEXT_GAIUSC406_00981_DUMMY_000_010:1"
msgid "//: /lookout for footprints."
msgstr "//: Обыскать местность в поисках следов."

