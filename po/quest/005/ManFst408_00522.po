#. ja: ウルダハ・ランディングのロビーへ<br>お入りになりますか？
#. de: Möchtet Ihr in den Landebereich des Luftschiff-Landeplatzes gehen?
#. fr: Souhaitez-vous accéder au quai d'embarquement de l'aérodrome d'Ul'dah<nbsp>?
#. speaker: ELYENORA
#. macro: <if $gn4>madam<else>sir</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "quest/005/ManFst408_00522:TEXT_MANFST408_00522_ELYENORA_050_100:1"
msgid "Greetings, <if $gn4>madam<else>sir</if>. Do you wish to proceed to your vessel?"
msgstr "Приветствую, <if $gn4>госпожа<else>сударь</if>. Желаете пройти к своему кораблю?"

#. ja: 「ロビー」へ移動しますか？
#. de: In den Landebereich gehen?
#. fr: Accéder au quai d'embarquement<nbsp>?
#. speaker: Q2
msgctxt "quest/005/ManFst408_00522:TEXT_MANFST408_00522_Q2_000_100:1"
msgid "Proceed to the landing area?"
msgstr "Пройти к месту посадки?"

#. ja: はい
#. de: Ja
#. fr: Oui
#. speaker: A2
msgctxt "quest/005/ManFst408_00522:TEXT_MANFST408_00522_A2_000_101:1"
msgid "Yes"
msgstr "Да"

#. ja: いいえ
#. de: Nein
#. fr: Non
#. speaker: A2
