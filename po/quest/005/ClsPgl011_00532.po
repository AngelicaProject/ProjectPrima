msgctxt "quest/005/ClsPgl011_00532:TEXT_CLSPGL011_00532_SYSTEM_000_62:1"
msgid "A button for the Gear Set interface is located in the upper portion of the <ui-color 500><ui-edge-color 501>Character</ui-edge-color></ui-color> window."
msgstr "Кнопка комплектов экипировки находится в верхней части окна <ui-color 500><ui-edge-color 501>персонажа</ui-edge-color></ui-color>."
