msgid "Speak with Chuchuto."
msgstr "Поговорить с Чучуту."

#. ja: 拳撃の痕跡に連撃を加えてホーネットの毒針を入手
#. de: „Schlag auf Schlag“ bei den Schlagspuren anwenden und Hornissenstacheln erlangen
#. fr: Utiliser Volée de coups sur les marques de poings et obtenir des dards de frelons
#. kind: objective
msgctxt "quest/005/ClsPgl200_00562:TEXT_CLSPGL200_00562_TODO_01:1"
msgid "Use Bootshine on the indentations and obtain hornet stingers."
msgstr "Применить «Блеск кулаков» на следах ударов и получить жала шершней."

#. ja: 格闘士ギルドのハモンにホーネットの毒針を渡す
#. de: Hamon die Hornissenstacheln zeigen
#. fr: Donner les dards de frelons à Hamon
#. kind: objective
msgctxt "quest/005/ClsPgl200_00562:TEXT_CLSPGL200_00562_TODO_02:1"
msgid "Present the hornet stingers to Hamon."
msgstr "Отдать жала шершней Хамону."

#. ja: ハモンと修行する
#. de: Mit Hamon trainieren
#. fr: S'entraîner avec Hamon
#. kind: objective
msgctxt "quest/005/ClsPgl200_00562:TEXT_CLSPGL200_00562_TODO_03:1"
msgid "Train with Hamon."
msgstr "Потренироваться с Хамоном."

