msgctxt "quest/013/GaiUse203_01347:TEXT_GAIUSE203_01347_RAUBAHN_000_100:1"
msgid "A pleasure, <if ($gn52 > 0)><split \" \" 1><string $gs1></split><else><if ($gn53 > 0)><split \" \" 1><string $gs1></split><else><capitalize><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 8></if><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 8></if><if ($gn54 > 0)><sheet GCRankUldahMaleText $gn54 8></if></capitalize> <split \" \" 2><string $gs1></split></if></if>. The others are already inside. Let's not keep them waiting."
msgstr ""
