# quest/044/AktKmd105_04413 — «That We Might Live» · in play order
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: パーラカの里のアルフィノは、手当てを続けるようだ。
#. de: Alphinaud kümmert sich weiterhin um die Verletzten.
#. fr: Alphinaud continue de soigner les blessés.
#. kind: journal
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_SEQ_00:1"
msgid "Alphinaud is determined to offer the villagers what succor he can."
msgstr ""

#. ja: マトシャと話す
#. de: Nach Matsya sehen
#. fr: Parler à Matsya
#. kind: objective
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_TODO_00:1"
msgid "Speak with Matsya."
msgstr ""

#. ja: マトシャと再度話す
#. de: Mit Matsya sprechen
#. fr: Reparler à Matsya
#. kind: objective
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_TODO_01:1"
msgid "Speak with Matsya again."
msgstr ""

#. ja: ケラシャフを探す
#. de: Nach Qerasaf suchen
#. fr: Trouver Qerasaf
#. kind: objective
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_TODO_02:1"
msgid "Search for Qerasaf."
msgstr ""

#. ja: ケラシャフを救助
#. de: Qerasaf helfen
#. fr: Aider Qerasaf
#. kind: objective
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_TODO_03:1"
msgid "Aid the wounded Qerasaf."
msgstr ""

#. ja: <sheet EObj 2012200 0>で見渡す
#. de: Am <noun-de EObj 5 2012200 1 3 1> Ausschau halten
#. fr: Observer les environs à l'endroit indiqué
#. kind: objective
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_TODO_04:1"
msgid "Survey the area."
msgstr ""

#. ja: 2箇所目の<sheet EObj 2012201 0>で見渡す
#. de: Am zweiten <noun-de EObj 5 2012200 1 3 1> Ausschau halten
#. fr: Observer les environs au deuxième endroit indiqué
#. kind: objective
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_TODO_05:1"
msgid "Continue to survey the area."
msgstr ""

#. ja: 3箇所目の<sheet EObj 2012202 0>で見渡す
#. de: Am dritten <noun-de EObj 5 2012202 1 3 1> Ausschau halten
#. fr: Observer les environs au troisième endroit indiqué
#. kind: objective
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_TODO_06:1"
msgid "Continue to survey the area."
msgstr ""

#. ja: マトシャと話す
#. de: Mit Matsya sprechen
#. fr: Parler à Matsya
#. kind: objective
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_TODO_07:1"
msgid "Speak with Matsya."
msgstr ""

#. ja: この人、ケガは酷いけど、まだ治せそう……！<br>私が受け持つから、ほかをお願い！
#. de: Seine Wunden sind schwer, aber ich kriege sie schon geheilt! Kümmere du dich um die anderen, bitte.
#. fr: Ses blessures sont graves, mais je peux le sauver<nbsp>! Occupe-toi des autres, s'il te plaît<nbsp>!
#. speaker: ALISAIE
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_ALISAIE_000_000:1"
msgid "His wounds are deep, but he may yet be saved. I will see to him─pray look after the others!"
msgstr ""

#. ja: 前に魚を売りにきたときには、みんな元気で……<br>なのに……どうしてこんなこと……！
#. de: Erst vor Kurzem habe ich hier noch Fisch verkauft. Alle waren wohlauf, munter und fröhlich<nbsp>... Und nun<nbsp>... Nein, nein. Das darf doch nicht sein.
#. fr: À peine quelques jours plus tôt, tout le monde allait bien lorsque je suis venu vendre mes poissons... Par les Dieux... Pourquoi<nbsp>!?
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_005:1"
msgid "When I last came here to sell my fish, everyone was so bright and cheerful. This is a nightmare..."
msgstr ""

#. ja: ああ……なんということだ……。<br>神よ、いかにしてこの苦難を超えろとおっしゃるか……。
#. de: Oh, ihr Götter<nbsp>... Welch Prüfung habt ihr uns hier nur auferlegt?
#. fr: Dieux tout-puissants... Pourquoi nous avoir infligé une telle épreuve<nbsp>!?
#. speaker: YERUVVET
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_YERUVVET_000_010:1"
msgid "The horror... I pray that the Sisters will see us through this calamity..."
msgstr ""

#. ja: この住民は、すでに亡くなっている……。
#. de: Für diese Dorfbewohnerin kommt jede Hilfe zu spät.
#. fr: Vous ne pouvez plus rien faire pour cette personne.
#. speaker: SYSTEM
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_SYSTEM_000_015:1"
msgid "There is nothing you can do for this villager."
msgstr ""

#. ja: この住民は、すでに亡くなっている……。
#. de: Keine Heilung dieser Welt kann diesen Mann noch retten.
#. fr: Vous ne pouvez plus rien faire pour cette personne.
#. speaker: SYSTEM
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_SYSTEM_000_020:1"
msgid "This villager has been dead for some time."
msgstr ""

#. ja: ありがとう……俺は大丈夫だ……。<br>ほかの奴を手当てしてやってくれ……頼む……。
#. de: Es<nbsp>... geht schon. Es muss gehen, danke. Bitte<nbsp>... Rettet, wer noch zu retten ist!
#. fr: Merci... Ça va, ne vous inquiétez pas... Allez aider les autres.
#. speaker: PALAKASMANC04412
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_PALAKASMANC04412_000_025:1"
msgid "I...I am fine, thank you... Please...save the others..."
msgstr ""

#. ja: この住民は、すでに亡くなっている……。
#. de: Der letzte Funke Leben ist verglüht.
#. fr: Vous ne pouvez plus rien faire pour cette personne.
#. speaker: SYSTEM
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_SYSTEM_000_030:1"
msgid "This poor soul is beyond saving."
msgstr ""

#. ja: ひとまず、この住民の手当ては、私だけで平気そうだよ。<br>君は、マトシャに手を貸してあげてくれ……！
#. de: Überlass das Heilen ruhig mir, so viele Leute sind es ja nicht<nbsp>... Gehst du stattdessen Matsya zur Hand, bitte?
#. fr: Je devrais pouvoir m'en charger seul<nbsp>! Va aider Matsya, s'il te plaît.
#. speaker: ALPHINAUD
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_ALPHINAUD_000_040:1"
msgid "I can tend to the rest. Pray look after Matsya─no doubt what we have seen here weighs even heavier on his heart than ours."
msgstr ""

#. ja: 君は、マトシャに手を貸してあげてほしい。<br>彼は治癒魔法も使えないだろうし、<br>私たち以上に、こういった事態に慣れていないと思うんだ。
#. de: Ich komme hier gut allein zurecht. Um Matsya mache ich mir allerdings Sorgen. Er ist mit dem Anblick derartiger Tragödien weitaus weniger vertraut als unsereins.
#. fr: Moi je me débrouille ici, mais je m'inquiète pour Matsya. Ce n'est pas un expert en magie curative et il n'est sûrement pas coutumier de telles tragédies.
#. speaker: ALPHINAUD
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_ALPHINAUD_000_050:1"
msgid "Stay by Matsya's side, <split \" \" 1><string $gs1></split>. Unlike us, he is not accustomed to seeing such horrors..."
msgstr ""

#. ja: あ……<split " " 1><string $gs1></split>……！
#. de: Oh, <split " " 1><string $gs1></split>!
#. fr: <split " " 1><string $gs1></split>...<nbsp>!
#. speaker: MATSYA
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_060:1"
msgid "Oh, <split \" \" 1><string $gs1></split>! <split \" \" 1><string $gs1></split>!"
msgstr ""

#. ja: この人は、イェルヴェットさんで……<br>「パーラカの里」の長だす！<br>ケガはしてるけど、どうにか無事だったみたいだす！
#. de: Das hier ist Yeruvvet, der<nbsp>... Vorstand des Dorfes, wenn man so will. Er trug zwar eine Verletzung davon, aber glück<shy>licher<shy>weise keine schwere.
#. fr: Voici Yeruvvet, le doyen de l'Écoute des Palaka. Il est blessé, mais rien de grave, heureusement<nbsp>!
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_061:1"
msgid "This is Yeruvvet, the elder here. He is hurt, but─praise be to the Sisters─he still lives!"
msgstr ""

#. ja: マトシャから話は聞きました。<br>勇敢にも救援に駆けつけていただいたこと、<br>なんとお礼を申し上げればよいか……。
#. de: Matsya hat mir schon erzählt, dass Ihr alles stehen und liegen gelassen habt, um zu unserer Rettung zu eilen. Ich weiß gar nicht, wie wir Euch das je danken sollen.
#. fr: Matsya m'a dit que vous n'aviez pas hésité à voler à notre secours. Au nom du village, vous avez toute ma recon<shy>nais<shy>san<shy>ce. Merci.
#. speaker: YERUVVET
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_YERUVVET_000_062:1"
msgid "Young Matsya here has told me everything. I have not the words to express my gratitude for your aid."
msgstr ""

#. ja: この異様な空になったあと、最初のうちは皆、<br>不安はあれども普通に過ごせておりました。
#. de: Als der Himmel zu lodern begann, ist eine Weile lang gar nichts passiert. Sicher, wir fürchteten uns und hielten stets das ungewöhnliche Ereignis im Blick, aber ansonsten schien das Leben seinen gewohnten Gang zu gehen.
#. fr: Lorsque le ciel a changé de couleur, il ne s'est rien passé pendant un moment, alors même si nous avions bien sûr peur et restions sur nos gardes, la vie suivait son cours.
#. speaker: YERUVVET
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_YERUVVET_000_063:1"
msgid "When the heavens began to burn, we were afraid, but did our best to carry on as we always have done..."
msgstr ""

#. ja: しかし、今日になって、<br>見たこともない獣たちが里に入り込んできて……。
#. de: Bis heute dann wie aus dem Nichts grausige Schreckgestalten aufgetaucht sind. Fratzen und Klauen, die ich mir in meinen schlimmsten Träumen nicht hätte ausmalen können<nbsp>...
#. fr: Jusqu'à aujourd'hui, lorsque ces horribles bêtes sorties de nulle part ont commencé à mettre le village à sac...
#. speaker: YERUVVET
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_YERUVVET_000_064:1"
msgid "Until today, when those unholy beasts came pouring into our village, a flood of midnight and death..."
msgstr ""

#. ja: そのあとのことは、わけがわかりません……<br>襲われた者が、同じような獣に変わったように見えました……。
#. de: Und dann<nbsp>... Ich weiß gar nicht recht, was geschah. Die Leute schrien und<nbsp>... Mir kam es vor, als seien sie selbst zu Ungeheuern geworden. Aber das kann doch nicht sein, oder?
#. fr: Et puis, je n'ai pas trop compris ce qu'il s'est passé... Les gens criaient, et j'ai eu l'impression d'en voir certains se transformer eux-mêmes en monstres...
#. speaker: YERUVVET
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_YERUVVET_000_065:1"
msgid "There are no words to describe what followed. Men and women I have known since they were babes struck down by the creatures, only to rise again to join the murderous horde, in the guise of those same hideous fiends..."
msgstr ""

#. ja: 混乱の中、数名が里の外へ逃げたようですが、<br>無事かどうかは……まだ……。
#. de: Jedenfalls gelang einigen die Flucht, soweit ich es mitbekam. Ob es ihnen draußen besser geht oder ob sie ebenfalls<nbsp>... Das vermag ich nicht zu sagen.
#. fr: Quelques habitants ont réussi à fuir le village, mais je ne sais pas ce qu'il est advenu d'eux après cela... Je prie les Dieux pour qu'ils soient sains et saufs...
#. speaker: YERUVVET
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_YERUVVET_000_066:1"
msgid "In the chaos, a handful of our villagers fled for their lives. I can only hope they have found their way to safety..."
msgstr ""

#. ja: マトシャよ、ケラシャフとメヴァンの夫妻を覚えているかね。<br>お前さんの魚を、毎回買っていた……。
#. de: Matsya, du kennst doch Qerasaf und Mehvan. Jedes Mal, wenn du nach Palakas Ruh gekommen bist, haben sie deinen Fisch gekauft.
#. fr: Matsya, tu te souviens de Qerasaf et Mehvan, pas vrai<nbsp>? Ils t'achetaient toujours du poisson lorsque tu venais en vendre au village.
#. speaker: YERUVVET
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_YERUVVET_000_067:1"
msgid "Matsya, do you perchance remember Qerasaf and Mehvan? The young couple who always bought your freshest catches..."
msgstr ""

#. ja: 忘れるわけないだす！<br>藁にも縋る思いで、この里に魚を売りに来たオラに、<br>とっても優しくしてくれた……。
#. de: Natürlich! Wegen ihnen bin ich doch überhaupt erst auf die Idee gekommen, nach euch zu sehen. Die beiden waren immer so gut zu mir<nbsp>... Selbst, als ich nur aus purer Ver<shy>zweif<shy>lung hierher kam und nicht einmal mehr damit gerechnet hatte, dass ich meinen Fisch noch loswerde.
#. fr: Bien sûr<nbsp>! Ils ont toujours été très gentils avec moi, même quand je ne pensais plus pouvoir écouler ma marchandise nulle part et venait ici en dernier recours.
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_068:1"
msgid "How could I forget, Elder? When I first came to peddle my wares─desperate to eke out a living─they showed me such kindness..."
msgstr ""

#. ja: ふたりが率先して買ってくれなかったら、<br>オラ、きっとこの里でも魚を売れずに、<br>今度こそ途方に暮れてただす……！
#. de: Ich will gar nicht wissen, wie es mir ergangen wäre, wenn sie sich damals meiner nicht erbarmt hätten<nbsp>...
#. fr: S'ils n'avaient pas eu pitié de moi à l'époque, je ne m'en serais jamais sorti, c'est sûr<nbsp>!
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_069:1"
msgid "Others shunned me as an outsider, as is their way. But Qerasaf and Mehvan bought my fish, and sung its praises. They turned my fortunes around!"
msgstr ""

#. ja: そう、そのケラシャフたちが、<br>獣に追われて「聖仙アガマの墳墓」の方へ逃げていくのを見た。
#. de: Ganz recht. Und ich sah eben jene beiden in Richtung des Agama-Tempels fliehen.
#. fr: C'est bien eux, oui. Eh bien, ils ont été pris en chasse par une bête et se sont enfuis en direction du sépulcre d'Agama.
#. speaker: YERUVVET
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_YERUVVET_000_070:1"
msgid "Alas, I fear they are in terrible danger. I saw them running towards Agama Temple, one of those beasts in close pursuit."
msgstr ""

#. ja: 彼らの子どもはまだ幼い……ほんの乳飲み子だ……<br>連れて逃げ隠れするのは難しかろう。<br>どうか、力になってやってはくれんか……。
#. de: Ihr Kind ist doch noch so klein<nbsp>... Nicht mehr als ein Säugling. Wie soll man sich denn so verstecken? Ich mache mir schreckliche Sorgen um sie, Matsya.
#. fr: Ils ont emporté leur enfant avec eux, un nourrisson... S'enfuir avec un être aussi fragile n'est cer<shy>tai<shy>ne<shy>ment pas chose aisée. Peux-tu aller les retrouver et les aider<nbsp>?
#. speaker: YERUVVET
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_YERUVVET_000_071:1"
msgid "They had their child─still but a tiny babe. To elude these fiends while caring for one so young is an impossible task, surely. I beg of you, go to their aid..."
msgstr ""

#. ja: オ、オラ、ケラシャフたちを助けたいだす。<br>けど、ひとりじゃ獣と戦うこともできないから……<br>手を貸してもらえると嬉しいだす……！
#. de: Ich<nbsp>... Ich will ihnen helfen gehen. Unbedingt. Aber gegen die Bestien komme ich nicht an<nbsp>... Würdest du mich wohl begleiten? Bitte?
#. fr: <split " " 1><string $gs1></split>... J'aimerais aller les sauver, mais je ne peux rien contre ces monstres tout seul... Tu veux bien m'aider<nbsp>?
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_072:1"
msgid "I...I want to help them. Yet I am but a fisherman─I cannot face beasts on my own. Will you come with me?"
msgstr ""

#. ja: 頼もしいだす……！<br>「聖仙アガマの墳墓」は、ここから西にある寺院だす。<br>ちゅ、注意しながら向かうだす……！
#. de: Ah, tausend Dank, <if $gn4>Freundin<else>Freund</if>! Der Agama-Tempel liegt westlich von hier. Es ist ein ordentliches Stück durch die Natur<nbsp>... aber das werde ich schon schaffen! Für Mehvan und ihren Mann.
#. fr: Merci beaucoup<nbsp>! Le sépulcre d'Agama est un sanctuaire qui se trouve à l'ouest du village, partons sur-le-champ<nbsp>! C'est dangereux, mais avec toi à mes côtés, on va s'en sortir<nbsp>!
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_073:1"
msgid "Oh, thank you! Agama Temple lies to the west of here. We must hurry!"
msgstr ""

#. ja: 逃げた人の捜索に向かうのね。<br>了解よ、里の中は、私とアルフィノで見ておくわ。
#. de: Du gehst nach den geflohenen Dorfbewohnern suchen? Verstanden. Alphinaud und ich bleiben hier, um das Dorf zu schützen.
#. fr: Matsya et toi vous chargez du jeune couple disparu, alors<nbsp>? Ne t'en fais pas, Alphinaud et moi nous occupons du village.
#. speaker: ALISAIE
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_ALISAIE_000_080:1"
msgid "Don't worry─Alphinaud and I will watch over the village until you return. Go and find Matsya's friends."
msgstr ""

#. ja: ううぅ……この先が「聖仙アガマの墳墓」だす……！
#. de: Puh. Das war<nbsp>... \<schnauf> ein langer Sprint. Aber da sind wir. Das ist der Agama-Tempel.
#. fr: Fiou... Nous y voilà. Le sépulcre d'Agama.
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_090:1"
msgid "The temple is just ahead..."
msgstr ""

#. ja: アガマっていう聖人のお墓と、それを祀る寺院なんだすが、<br>今は遺跡として一部が残ってるだけだす。
#. de: Gebaut wurde er als Mausoleum und Tempel zu Ehren des Heiligen Agama. Früher war er viel, viel größer<nbsp>... Heute ist leider nur noch dieser kleine Teil erhalten.
#. fr: C'est un sanctuaire construit en l'honneur de saint Agama, largement vénéré dans la culture thavnairoise. Autrefois, l'édifice était beaucoup plus grand, mais de nos jours il ne reste plus que cette partie.
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_091:1"
msgid "It was built by those who worship Saint Agama, but has sadly fallen into disrepair in recent years."
msgstr ""

#. ja: ケラシャフの一家が、まだこのあたりにいるなら、<br>遺跡の陰に身を隠してるかも…………
#. de: Bestimmt haben sie sich irgendwo in den Ruinen versteckt. Wir sollten sie su...
#. fr: Si Qerasaf et sa famille se trouvent encore ici, ils se sont cer<shy>tai<shy>ne<shy>ment cachés quelque part dans ces ruines.
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_092:1"
msgid "If my friends made it this far, no doubt they are hiding somewhere amidst the ruins."
msgstr ""

#. ja: (-男性の叫び声-)やめろ……グアッ……アアアァァァッ！
#. de: (-Aufgebrachte Männerstimme-)Nein! Kommt nicht näher! Ich<nbsp>... Argh! Aaaaaaaah!
#. fr: (-Homme hurlant-)Non, arrête<nbsp>! <i>Noooon</i><nbsp>!!!
#. speaker: QERASAF
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_QERASAF_000_093:1"
msgid "(-???-)No, please! Stay ba─annngggh...gggaaah!"
msgstr ""

#. ja: 今の、ケラシャフの声だす！<br>ああぁ、たた、大変だす……！
#. de: <split " " 1><string $gs1></split>, das war Qerasaf! Oh nein! Bitte nicht!
#. fr: C'est la voix de Qerasaf<nbsp>! Oh non, il faut l'aider, vite<nbsp>!!!
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_094:1"
msgid "That was Qerasaf! Oh, no─this is not good!"
msgstr ""

#. ja: 何と言う？
#. de: Was sagst du?
#. fr: Que dites-vous<nbsp>?
#. speaker: Q1
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_Q1_000_095:1"
msgid "What will you say?"
msgstr ""

#. ja: 自分が見てこよう……！
#. de: Ich kümmere mich darum!
#. fr: Je m'en occupe<nbsp>!
#. speaker: A1
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_A1_000_096:1"
msgid "I'll take a look."
msgstr ""

#. ja: マトシャは、ここで待機を
#. de: Matsya, warte hier.
#. fr: Attends-moi là, Matsya.
#. speaker: A1
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_A1_000_097:1"
msgid "Wait here."
msgstr ""

#. ja: お、お願いするだす……！<br>叫び声は、間違いなく、この先の遺跡から聞こえただす……！
#. de: D-Danke! Der Schrei kam von Ruinen weiter hinten, da bin ich mir sicher!
#. fr: Merci<nbsp>! Le cri provenait des ruines du fond, j'en suis sûr<nbsp>!
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_098:1"
msgid "P-Please do! The cry came from the ruins. You must hurry!"
msgstr ""

#. ja: わ、わかっただす……！<br>叫び声は、間違いなく、この先の遺跡から聞こえただす……！
#. de: I-In Ordnung! Der Schrei kam von Ruinen weiter hinten, da bin ich mir sicher!
#. fr: D-d'accord<nbsp>! Le cri provenait des ruines du fond, j'en suis sûr<nbsp>!
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_099:1"
msgid "Y-Yes, I understand... The cry came from the ruins! You must hurry!"
msgstr ""

#. ja: ケラシャフの叫び声は、<br>「聖仙アガマの墳墓」の方から聞こえただす！<br>ああ……神様どうか……！
#. de: Bitte, ihr Götter<nbsp>... haltet eure schützende Hand über ihn!
#. fr: Qerasaf... Faites que les Dieux le protègent<nbsp>!
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_110:1"
msgid "That was Qerasaf's voice─I'm sure of it! Oh gods...gods have mercy..."
msgstr ""

#. ja: シシシシシィッ！
#. de: Wraaaaaagh!
#. fr: Gluuuurgh<nbsp>!
#. speaker: BALLOON
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_BALLOON_000_120:1"
msgid "Aieeeeeeeeeghhh!"
msgstr ""

#. ja: シテ…ドウシテ…
#. de: Whrrrr<nbsp>... Waaaa<nbsp>... rum<nbsp>...
#. fr: Pour... quoiii...<nbsp>?
#. speaker: BALLOON
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_BALLOON_000_125:1"
msgid "Why...why...aaaaaaghhh..."
msgstr ""

#. ja: ケラシャフと思しき男性は、致命傷を負っている……。
#. de: Aus Qerasafs klaffenden Wunden strömt Blut. Seine Verletzungen scheinen zahlreich und schwer.
#. fr: Vous avez trouvé Qerasaf. Il est gravement blessé.
#. speaker: SYSTEM
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_SYSTEM_000_130:1"
msgid "The man lies motionless on the ground, bearing a grievous wound..."
msgstr ""

#. ja: <split " " 1><string $gs1></split>、やっぱりオラも……
#. de: Ich hab es nicht mehr ausgehalten, ich<nbsp>...
#. fr: Désolé, <split " " 1><string $gs1></split>, mais je pouvais pas rester en retrait sans rien...
#. speaker: MATSYA
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_131:1"
msgid "I'm sorry, <split \" \" 1><string $gs1></split>. I tried to stay behind, but I couldn't..."
msgstr ""

#. ja: 嘘だ……そんな…………。
#. de: Nein<nbsp>...
#. fr: Non...
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_132:1"
msgid "No...it cannot be!"
msgstr ""

#. ja: ……いるのか……誰か…………。
#. de: \<röchel> Wer<nbsp>...
#. fr: Qui... est là...<nbsp>?
#. speaker: QERASAF
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_QERASAF_000_133:1"
msgid "Is someone... Anyone..."
msgstr ""

#. ja: 俺の……手……足も……どうなってる……<br>動かないんだ……重くて…………。
#. de: \<stöhn> Alles<nbsp>... ist so schwer<nbsp>... Meine Beine<nbsp>... Ich kann nicht<nbsp>... 
#. fr: Je sens... plus... mes jambes...
#. speaker: QERASAF
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_QERASAF_000_134:1"
msgid "My arms...so heavy... And my legs... I cannot feel my legs..."
msgstr ""

#. ja: 妻と子どもが…………逃げてる……別の方に…………。
#. de: M-Meine Frau<nbsp>... mit unserer Tochter<nbsp>... \<ächz> Sie sind<nbsp>... geflohen<nbsp>...
#. fr: Ma femme... et ma fille... elles ont pu fuir...
#. speaker: QERASAF
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_QERASAF_000_135:1"
msgid "My wife...fled with our daughter..."
msgstr ""

#. ja: 伝えてくれ……俺は……君たちと…………<br>もっと……一緒に…………
#. de: Bitte<nbsp>... Findet sie. Und<nbsp>... sagt ihr, dass<nbsp>... \<hust>
#. fr: Dites-leur... que j'aurais voulu... rester...
#. speaker: QERASAF
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_QERASAF_000_136:1"
msgid "I need to find them...need to be with them..."
msgstr ""

#. ja: いっしょに…………
#. de: Ich<nbsp>...
#. fr: ... à leurs côtés...
#. speaker: QERASAF
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_QERASAF_000_137:1"
msgid "I need..."
msgstr ""

#. ja: ケラシャフ！<br>ダメだ、ケラシャフ……ッ！
#. de: Qerasaf! Nein, Qerasaf! Bitte nicht!
#. fr: Qerasaf<nbsp>! Non, oh non<nbsp>! Qerasaf<nbsp>!
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_138:1"
msgid "Qerasaf! No, Qerasaf─you must stay strong!"
msgstr ""

#. ja: いっしょに……いたかったなぁ…………
#. de: Ich sie<nbsp>... liebe<nbsp>...
#. fr: Mehvan...
#. speaker: QERASAF
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_QERASAF_000_139:1"
msgid "More time... I thought I had..."
msgstr ""

#. ja: 死にたくない…………<br>なんで……こん……な………………。
#. de: Aaah<nbsp>... Ich will<nbsp>... nicht<nbsp>... gehen<nbsp>... Mehvan<nbsp>...
#. fr: Je... veux pas... mourir... Mehvan...
#. speaker: QERASAF
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_QERASAF_000_140:1"
msgid "I...I don't want to die..."
msgstr ""

#. ja: どうする？
#. de: Was tust du?
#. fr: Que voulez-vous faire<nbsp>?
#. speaker: Q2
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_Q2_000_141:1"
msgid "What will you do?"
msgstr ""

#. ja: 彼に言葉をかける
#. de: Ihm gut zureden
#. fr: Lui parler
#. speaker: A2
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_A2_000_142:1"
msgid "Speak to Qerasaf."
msgstr ""

#. ja: 彼の涙をぬぐう
#. de: Seine Tränen trocknen
#. fr: Sécher ses larmes
#. speaker: A2
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_A2_000_143:1"
msgid "Dry Qerasaf's tears."
msgstr ""

#. ja: ぁ……りがと…………
#. de: Dah<nbsp>... Danke<nbsp>...
#. fr: Me... merci...
#. speaker: QERASAF
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_QERASAF_000_144:1"
msgid "Thank you..."
msgstr ""

#. ja: ……家族を……どうか………………。
#. de: Rettet<nbsp>... meine Familie<nbsp>...
#. fr: Sauvez... ma famille...
#. speaker: QERASAF
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_QERASAF_000_145:1"
msgid "Please...find them..."
msgstr ""

#. ja: メヴァンは、赤ちゃんを連れて、まだ逃げてる……。
#. de: Ach, Qerasaf<nbsp>... Mögest du Frieden finden. \<schnief> Also<nbsp>... ist Mehvan noch mit dem kleinen Kind auf der Flucht?
#. fr: Mehvan est toujours en fuite... avec l'enfant dans ses bras<nbsp>?
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_146:1"
msgid "Mehvan still lives. And she has their child..."
msgstr ""

#. ja: 探し出さないと……！<br>まずは「パーラカの里」へ戻りながら、<br>森の中を見回ってみるだす……！
#. de: Wir müssen nach ihr suchen! A-Am besten in Richtung Palakas Ruh, bestimmt hat sie versucht, sich zwischen den Bäumen zu verbergen!
#. fr: Nous devons les retrouver<nbsp>! Fouillons la forêt sur le chemin du retour à l'Écoute des Palaka<nbsp>!
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_147:1"
msgid "We must search the jungle between here and Palaka's Stand. There is nowhere else she could have gone. I think..."
msgstr ""

#. ja: ごめん、ケラシャフ……。<br>ふたりを見つけたあとに、ちゃんと弔うから……。
#. de: Qerasaf<nbsp>... Es tut mir so leid. Sobald wir Mehvan gefunden haben, kommen wir zurück und holen dich heim. Das verspreche ich dir.
#. fr: Pardonne-nous, Qerasaf... Dès que nous aurons sauvé Mehvan, nous reviendrons te chercher... Je te le promets.
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_148:1"
msgid "Forgive me, Qerasaf... Once we have saved your wife and child, we will return and lay you to rest..."
msgstr ""

#. ja: 周囲に人影はない。<br>このあたりに、メヴァンたちはいないようだ。
#. de: Es ist weit und breit niemand zu sehen. Auch keine Frau mit Kind.
#. fr: Vous ne ressentez aucune présence. Mehvan n'est pas ici.
#. speaker: SYSTEM
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_SYSTEM_000_150:1"
msgid "You see no tracks or other signs of recent travel. Mehvan and the child must be elsewhere..."
msgstr ""

#. ja: アアァァァ…！
#. de: Aaaaaaarngh<nbsp>...
#. fr: Aaaaaah<nbsp>!!!
#. speaker: BALLOON
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_BALLOON_000_160:1"
msgid "Aaaaaaaaaaaaghhh!"
msgstr ""

#. ja: ウ…ウゥ…
#. de: \<schluchz>
#. fr: Rooorgh...
#. speaker: BALLOON
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_BALLOON_000_165:1"
msgid "Urk... Urggggggggghhh..."
msgstr ""

#. ja: 周囲に人影はない。<br>このあたりにも、メヴァンたちはいないようだ。
#. de: Auch hier scheint Mehvan nicht zu sein.
#. fr: Vous ne ressentez aucune présence. Mehvan n'est pas ici non plus.
#. speaker: SYSTEM
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_SYSTEM_000_170:1"
msgid "If Mehvan and her daughter came through this area recently, you see no evidence of their passage..."
msgstr ""

#. ja: これで傷は塞がりました。<br>立てそうですか……？
#. de: So, die Wunde ist nun vollständig geschlossen. Meint Ihr, Ihr könnt aufstehen?
#. fr: La plaie s'est com<shy>plè<shy>te<shy>ment refermée. Pouvez-vous vous lever<nbsp>?
#. speaker: ALPHINAUD
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_ALPHINAUD_000_180:1"
msgid "...There. Your wounds have closed. Can you stand?"
msgstr ""

#. ja: 待って、こっちの手当ても間もなく終わるわ。
#. de: Gleich sind wir fertig, versprochen.
#. fr: Encore une petite minute, j'en ai bientôt terminé avec les soins.
#. speaker: ALISAIE
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_ALISAIE_000_185:1"
msgid "Just a moment, <split \" \" 1><string $gs1></split>. I'll be with you shortly."
msgstr ""

#. ja: ど、どうだっただすか！？<br>オラの方は、全然見つからなくって……！
#. de: H-Hast du sie gefunden? Ich konnte nicht die kleinste Spur von ihr entdecken<nbsp>...
#. fr: Vous les avez trouvées<nbsp>? Aucune trace d'elles de mon côté<nbsp>!
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_190:1"
msgid "D-Did you see any sign of them? I found nothing!"
msgstr ""

#. ja: そうだすか……。<br>だとすると、もっと里から遠いところに、<br>逃げてるかもしれないだす。
#. de: Oh<nbsp>... verstehe. Dann ist sie wohl doch weiter weggelaufen, als wir dachten.
#. fr: Oh... Mehvan s'est peut-être retranchée au fin fond de la jungle...
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_191:1"
msgid "Perhaps the beasts have chased them farther from the village."
msgstr ""

#. ja: ああ……幸運の神々よ……。<br>どうか彼女たちのそばに、ついていてあげて……！
#. de: Bitte, bitte lasst sie nicht im Stich, o Götter. Lasst ihr das Glück hold sein!
#. fr: Ô Dieux, je vous en prie... Protégez-les<nbsp>!
#. speaker: MATSYA
msgctxt "quest/044/AktKmd105_04413:TEXT_AKTKMD105_04413_MATSYA_000_192:1"
msgid "Oh, gods above, I beseech you! Pray deliver Mehvan and her little one to safety..."
msgstr ""
