msgid "<ui-color 548>Speak about the marketplace.</ui-color>"
msgstr "<ui-color 548>Поговорить о рынке.</ui-color>"

#. ja: <ui-color 548>「水車」について話す</ui-color>
#. de: <ui-color 548>Über den Knoten sprechen.</ui-color>
#. fr: <ui-color 548>Parler du moulin à eau</ui-color>
#. speaker: A2
