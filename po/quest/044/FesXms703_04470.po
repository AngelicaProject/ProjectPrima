msgid "<ui-color 548>Speak about the watermill.</ui-color>"
msgstr "<ui-color 548>Поговорить о водяной мельнице.</ui-color>"

#. ja: <ui-color 548>「グレートローム農場」について話す</ui-color>
#. de: <ui-color 548>Über die Ährenkranzkolonie sprechen.</ui-color>
#. fr: <ui-color 548>Parler du Courtil</ui-color>
