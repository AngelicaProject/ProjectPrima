#. ja: ベストウェイ・バローのリヴィングウェイは、焦っているようだ。
#. de: Livingway ist voller Tatendrang.
#. fr: Livingway n'a pas de temps à perdre.
#. kind: journal
msgctxt "quest/044/AktKmc104_04402:TEXT_AKTKMC104_04402_SEQ_00:1"
msgid "With the Final Days fast approaching, Livingway is keen to complete her preparations."
msgstr ""

#. ja: リヴィングウェイと話す
#. de: Mit Livingway sprechen
#. fr: Parler à Livingway
#. kind: objective
msgctxt "quest/044/AktKmc104_04402:TEXT_AKTKMC104_04402_TODO_00:1"
msgid "Speak with Livingway."
msgstr ""

#. ja: <sheet EObj 2012178 0>を調べる
#. de: <capitalize><noun-de EObj 1 2012178 1 4 1></capitalize> untersuchen
#. fr: Inspecter <noun-fr EObj 2 2012178 1 1>
#. kind: objective
msgctxt "quest/044/AktKmc104_04402:TEXT_AKTKMC104_04402_TODO_01:1"
msgid "Examine the storage crate."
msgstr ""

#. ja: クッキングウェイに<sheet EventItem 2003236 0>を見せる
#. de: Cookingway <noun-de EventItem 2 2003236 1 4 1> zeigen
#. fr: Montrer <noun-fr EventItem 2 2003236 1 1> à Cookingway
#. kind: objective
