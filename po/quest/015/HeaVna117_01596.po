msgctxt "quest/015/HeaVna117_01596:TEXT_HEAVNA117_01596_HONOROIT_000_043:1"
msgid "(My lord the count was utterly beside himself, <if $gn4>Mistress<else>Master</if> <split \" \" 2><string $gs1></split>. 'Tis a mercy you were not here to witness it.)"
msgstr "(Граф был вне себя, <if $gn4>госпожа<else>господин</if> <split \" \" 2><string $gs1></split>. Хорошо ещё, что вам не пришлось это видеть.)"
