#. fr: Donner le billet d'aéronef à Raimondaux
#. kind: objective
msgctxt "quest/014/SubFst122_01428:TEXT_SUBFST122_01428_TODO_05:1"
msgid "Give the airship ticket to Raimondaux."
msgstr "Отдать Реймондо билет на дирижабль."

