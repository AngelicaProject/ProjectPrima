#. de: Mit Raimondaux sprechen
#. fr: Parler à Raimondaux
#. kind: objective
msgctxt "quest/014/SubFst122_01428:TEXT_SUBFST122_01428_TODO_00:1"
msgid "Speak with Raimondaux."
msgstr "Поговорить с Реймондо."

