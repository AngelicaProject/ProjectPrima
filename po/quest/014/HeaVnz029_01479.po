msgctxt "quest/014/HeaVnz029_01479:TEXT_HEAVNZ029_01479_SYSTEM_000_073:1"
msgid "You have learned the emote <ui-color 500><ui-edge-color 501>Haurchefant</ui-edge-color></ui-color>!"
msgstr "Вы выучили эмоцию <ui-color 500><ui-edge-color 501>Оршефан</ui-edge-color></ui-color>!"
