#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_SWIFT_000_070:1"
msgid "Welcome back, <if ($gn54 > 0)><if ($gn54 < 127)><capitalize><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 8></if><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 8></if><if ($gn54 > 0)><sheet GCRankUldahMaleText $gn54 8></if></capitalize> <split \" \" 2><string $gs1></split><else><split \" \" 1><string $gs1></split></if><else><split \" \" 1><string $gs1></split></if>. Have you learned aught of interest?"
msgstr "С возвращением, <if ($gn54 > 0)><if ($gn54 < 127)><capitalize><if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 8></if><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 8></if><if ($gn54 > 0)><sheet GCRankUldahMaleText $gn54 8></if></capitalize> <split \" \" 2><string $gs1></split><else><split \" \" 1><string $gs1></split></if><else><split \" \" 1><string $gs1></split></if>. Узнали что-нибудь интересное?"

#. ja: ……なにッ、武装蜂起をけしかけている商人がいるだと！？<br>外道め……必ず捕縛せねば……！
#. de: Wie bitte?! Ein Händler hat die Flüchtlinge zum bewaffneten Widerstand angestachelt? Aber das ist ja Hochverrat! Den Schuft müssen wir umgehend festnehmen und verhören.
#. fr: ... Comment<nbsp>!? Bon sang de bonsoir<nbsp>! Il faut à tout prix que nous mettions la main sur ce fichu marchand<nbsp>!
#. speaker: SWIFT
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_SWIFT_000_071:1"
msgid "You persuaded a gang of refugees to lay down their arms? The Flame General will be pleased to learn of this!"
msgstr "Вы убедили шайку беженцев сложить оружие? Генерал Пламени будет рад это услышать!"

#. ja: 情報提供に感謝するぞ。<br>ロストホープ流民街での暴動鎮圧も、<br>貴公の功績として、ラウバーン局長に伝えよう。
#. de: Danke für die Information, und auch dafür, dass du den Aufstand in Verlorene Hoffnung verhindert hast. Ich werde General Raubahn davon berichten.
#. fr: Je vous remercie d'être venu<if $gn4>e</if> m'apporter cette information ô combien capitale. Vous pouvez compter sur moi pour faire part de vos exploits au général Aldynn.
#. speaker: SWIFT
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_SWIFT_000_072:1"
msgid "Less so, these other revelations. We must apprehend this treasonous snake at once!"
msgstr "Спасибо за сведения. Я также доложу генералу Раубану, что вы помогли подавить бунт в Крике отчаяния."

#. ja: 敵が襲いかかってきた！！
#. de: Aufrührer stürzen sich auf dich!
#. fr: Des ennemis surgissent<nbsp>!
#. speaker: POPMESSAGE
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_POPMESSAGE_000_000:1"
msgid "A chorus of cries echoes throughout the cavern..."
msgstr "По пещере разносится хор криков…"

#. ja: もっと気合を入れろ！
#. de: Bloß nicht schwach werden!
#. fr: Allez<nbsp>! Tape plus fort<nbsp>!
#. speaker: BALLOON
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_BALLOON_000_000:1"
msgid "Help me, dammit!"
msgstr "Ну же, бей сильнее!"

#. ja: くっ、みんな…！
#. de: Arrrgh, Hilfe!
#. fr: Merde...
#. speaker: BALLOON
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_BALLOON_000_010:1"
msgid "You should never have come here!"
msgstr "Тебе не следовало сюда приходить!"

#. ja: 俺たちは勝つんだ！
#. de: Wir werden siegen!
#. fr: On va l'avoir<nbsp>!
#. speaker: BALLOON
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_BALLOON_000_020:1"
msgid "W-We can take <if $gn4>her<else>him</if>!"
msgstr "М-мы с <if $gn4>ней<else>ним</if> справимся!"

#. ja: 集まれ！数で攻める！
#. de: Los, kommt alle! Gemeinsam sind wir stark!
#. fr: J-j'y arriverai jamais tout seul<nbsp>!
#. speaker: BALLOON
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_BALLOON_000_030:1"
msgid "I c-can't do this alone!"
msgstr "Я один не справлюсь!"

#. ja: 失うモノはねぇんだ！
#. de: Wir haben nichts mehr zu verlieren!
#. fr: M'en fous de mourir<nbsp>! De toute façon, j'ai rien à perdre<nbsp>!
#. speaker: BALLOON
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_BALLOON_000_040:1"
msgid "Do yer worst!"
msgstr "Давай, покажи, на что способен!"

#. ja: ハァ…ハァ…
#. de: Puh ...
#. fr: (souffle) (souffle)
#. speaker: BALLOON
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_BALLOON_000_050:1"
msgid "\\<huff> \\<puff>"
msgstr "\\<тяжело дышит> \\<пыхтит>"

#. ja: さすがに強い…
#. de: Aua, nicht so hart!
#. fr: <if $gn4>Elle<else>Il</if> est balèze, <if $gn4>cette conne<else>ce con</if><nbsp>!
#. speaker: BALLOON
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_BALLOON_000_060:1"
msgid "You won't stop us!<br>You <i>can't</i> stop us!"
msgstr "Вам нас не остановить!<br><i>Не остановить!</i>"

#. ja: 邪魔者か
#. de: Willst du Ärger?!
#. fr: En avant, frangin<nbsp>!
#. speaker: BALLOON
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_BALLOON_000_070:1"
msgid "Ho, a challenge!"
msgstr "О, вызов?"

#. ja: 消えてもらおう
#. de: Verzieh dich!
#. fr: Je vais <if $gn4>la<else>le</if> découper en rondelles<nbsp>!
#. speaker: BALLOON
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_BALLOON_000_080:1"
msgid "It's been too long!"
msgstr "Пора бы уже!"

#. ja: どうなっている？
#. de: Ganz schön taff ...
#. fr: <if $gn4>Elle<else>Il</if> est coriace<nbsp>!
#. speaker: BALLOON
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_BALLOON_000_090:1"
msgid "Meddlesome wretch!"
msgstr "Мерзкий наглец!"

#. ja: クソがァッ！
#. de: Verdammt!
#. fr: Aaarghh...<nbsp>!
#. speaker: BALLOON
#. macro: <if $gn4>Bitch<else>Bastard</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_BALLOON_000_100:1"
msgid "<if $gn4>Bitch<else>Bastard</if>!"
msgstr "<if $gn4>Стерва<else>Сволочь</if>!"

#. ja: おい、劣勢だぞ…
#. de: Bruder, mir schwant Übles!
#. fr: <if $gn4>Cette femme est pas humaine<else>Ce type est pas humain</if><nbsp>!
#. speaker: BALLOON
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_BALLOON_000_110:1"
msgid "Enough!"
msgstr "Хватит!"

#. ja: 負けるわけには…ッ
#. de: Das kann nicht sein ...
#. fr: Sois maudit<if $gn4>e</if>, aventuri<if $gn4>ère<else>er</if>...
#. speaker: BALLOON
msgctxt "quest/014/GaiUse303_01444:TEXT_GAIUSE303_01444_BALLOON_000_120:1"
msgid "No, NO!"
msgstr "Нет! НЕТ!"
