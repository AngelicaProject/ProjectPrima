msgid "You have learned the emote <ui-color 500><ui-edge-color 501>Step Dance</ui-edge-color></ui-color>!"
msgstr "Вы выучили эмоцию <ui-color 500><ui-edge-color 501>Степ-данс</ui-edge-color></ui-color>!"
