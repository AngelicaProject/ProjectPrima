#. fr: （★未使用／削除予定★）
#. kind: other
msgctxt "quest/014/BanSah309_01408:TEXT_BANSAH309_01408_POP_MESSAGE:1"
msgid "（★未使用／削除予定★）"
msgstr ""

#. ja: 敵の気配を感じた！！
#. de: Du spürst eine feindliche Präsenz!
#. fr: Le feu et la fumée attirent une sentinelle<nbsp>!
#. speaker: POPMESSAGE
msgctxt "quest/014/BanSah309_01408:TEXT_BANSAH309_01408_POPMESSAGE_000_000:1"
msgid "A sentry is summoned by the smoke and flames!"
msgstr ""
