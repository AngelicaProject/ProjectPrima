msgid "Heart of the Weaver"
msgstr "Душа ткача"

#. ja: <ui-color 504><ui-edge-color 505>[マイスター専用アクション]</ui-edge-color></ui-color><br>7ターンの間、「高品質」状態になりやすくなる。<br>使用時にアイテム「裁縫師の製図用紙」を消費する。<br><ui-color 500><ui-edge-color 501>[一回の製作につき5回まで使用可能]</ui-edge-color></ui-color>
