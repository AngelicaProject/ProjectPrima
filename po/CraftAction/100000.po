msgstr "Повышает <ui-color 506><ui-edge-color 507>качество</ui-edge-color></ui-color> и не расходует ОЧК. <br><ui-color 504><ui-edge-color 505>Эффективность:</ui-edge-color></ui-color> 100%<br><ui-color 504><ui-edge-color 505>Шанс успеха:</ui-edge-color></ui-color> 60%<if ($gn68 == 14)><if ($gn69 >= 96)><br><ui-color 504><ui-edge-color 505>Дополнительный эффект: </ui-edge-color></ui-color>Даёт эффект <ui-color 506><ui-edge-color 507>Ускоренной работы</ui-edge-color></ui-color> на 1 шаг</if></if>"

#. ja: ヘイスティタッチ
#. de: Hastige Veredelung
#. fr: Ouvrage hâtif
#. column 1: Increases <ui-color 506><ui-edge-color 507>quality</ui-edge-color></ui-color> and requires no CP.<br><ui-color 504><ui-edge-color 505>Efficiency:</ui-edge-color></ui-color> 100%<br><ui-color 504><ui-edge-color 505>Success Rate:</ui-edge-color></ui-color> 60%<if ($gn68 == 15)><if ($gn69 >= 96)><br><ui-color 504><ui-edge-color 505>Additional Effect: </ui-edge-color></ui-color>Grants <ui-color 506><ui-edge-color 507>Expedience</ui-edge-color></ui-color> for 1 step</if></if>
msgctxt "CraftAction:100362:0:0"
msgid "Hasty Touch"
msgstr "Быстрая обработка"

#. ja: 耐久を消費して、品質を上げる。CPを消費しないが成功率が低い。<br>効率：100<br>成功率：60％<if ($gn68 == 15)><if ($gn69 >= 96)><br>追加効果：自身に「匠の好機」を付与する。<br>効果時間：1ターン</if></if>
