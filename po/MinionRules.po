#. column 0: Under C20
msgctxt "MinionRules:2:0:1"
msgid "Must possess at least one minion with a summoning cost of less than 20"
msgstr "Нужен хотя бы один миньон стоимостью меньше 20"

#. ja: コスト10禁止
#. de: Kosten nicht 10
#. fr: Coût ≠10
#. column 1: Must possess at least one minion with a summoning cost other than 10
msgctxt "MinionRules:3:0:0"
msgid "No C10"
msgstr "Без стоимости 10"

#. ja: コスト10以外のミニオンを1体以上所持
