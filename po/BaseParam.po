#. column 2: Shortens the duration of blind.
msgctxt "BaseParam:61:0:1"
msgid "Blind Resistance"
msgstr "Сопротивление слепоте"

#. ja: 暗闇の効果時間を短縮します。
#. de: Resistenz gegen Blind: Beschleunigt die Erholung vom Status Blind.
#. fr: Réduit la durée de l'effet Cécité.
#. column 1: Blind Resistance
msgctxt "BaseParam:61:0:2"
msgid "Shortens the duration of blind."
msgstr "Сокращает время действия слепоты."

#. ja: 毒耐性
#. de: Gift-Resistenz
#. fr: Résistance à Poison
#. column 2: Shortens the duration of poison.
msgctxt "BaseParam:62:0:1"
msgid "Poison Resistance"
msgstr "Сопротивление отравлению"

#. ja: 毒の効果時間を短縮します。
#. de: Resistenz gegen Gift: Beschleunigt die Erholung vom Status Gift.
#. fr: Réduit la durée de l'effet Poison.
#. column 1: Poison Resistance
msgctxt "BaseParam:62:0:2"
msgid "Shortens the duration of poison."
msgstr "Сокращает время действия отравления."

#. ja: スタン耐性
#. de: Betäubungs-Resistenz
#. fr: Résistance à Étourdissement
#. column 2: Shortens the duration of stun.
msgctxt "BaseParam:63:0:1"
msgid "Stun Resistance"
msgstr "Сопротивление оглушению"

#. ja: スタンの効果時間を短縮します。
#. de: Resistenz gegen Betäubung: Beschleunigt die Erholung vom Status Betäubung.
#. fr: Réduit la durée de l'effet Étourdissement.
#. column 1: Stun Resistance
msgctxt "BaseParam:63:0:2"
msgid "Shortens the duration of stun."
msgstr "Сокращает время действия оглушения."

#. ja: 睡眠耐性
#. de: Schlaf-Resistenz
#. fr: Résistance à Sommeil
#. column 2: Shortens the duration of sleep.
msgctxt "BaseParam:64:0:1"
msgid "Sleep Resistance"
msgstr "Сопротивление сну"

#. ja: 睡眠の効果時間を短縮します。
#. de: Resistenz gegen Schlaf: Beschleunigt die Erholung vom Status Schlaf.
#. fr: Réduit la durée de l'effet Sommeil.
#. column 1: Sleep Resistance
msgctxt "BaseParam:64:0:2"
msgid "Shortens the duration of sleep."
msgstr "Сокращает время действия сна."

#. ja: バインド耐性
#. de: Fessel-Resistenz
#. fr: Résistance à Entrave
#. column 2: Shortens the duration of bind.
msgctxt "BaseParam:65:0:1"
msgid "Bind Resistance"
msgstr "Сопротивление связыванию"

#. ja: バインドの効果時間を短縮します。
#. de: Resistenz gegen Fessel: Beschleunigt die Erholung vom Status Fessel.
#. fr: Réduit la durée de l'effet Entrave.
#. column 1: Bind Resistance
msgctxt "BaseParam:65:0:2"
msgid "Shortens the duration of bind."
msgstr "Сокращает время действия связывания."

#. ja: ヘヴィ耐性
#. de: Gewicht-Resistenz
#. fr: Résistance à Pesanteur
#. column 2: Shortens the duration of heavy.
msgctxt "BaseParam:66:0:1"
msgid "Heavy Resistance"
msgstr "Сопротивление тяжести"

#. ja: ヘヴィの効果時間を短縮します。
#. de: Resistenz gegen Gewicht: Beschleunigt die Erholung vom Status Gewicht.
#. fr: Réduit la durée de l'effet Pesanteur.
#. column 1: Heavy Resistance
msgctxt "BaseParam:66:0:2"
msgid "Shortens the duration of heavy."
msgstr "Сокращает длительность эффекта «Тяжесть»."

#. ja: 死の宣告耐性
#. de: Verhängnis-Resistenz
#. fr: Résistance à Glas
msgctxt "BaseParam:67:0:1"
msgid "Doom Resistance"
msgstr "Сопротивление эффекту «Приговор»"

#. ja: 装備消耗耐性
#. de: Verschleißminderung
#. fr: Résistance à l'usure
msgctxt "BaseParam:68:0:1"
msgid "Reduced Durability Loss"
msgstr "Снижение износа снаряжения"

#. ja: 錬精度上昇量
#. de: Erhöhte Bindung
#. fr: Gain accru de symbiose
msgctxt "BaseParam:69:0:1"
msgid "Increased Spiritbond Gain"
msgstr "Ускоренное накопление связи с предметом"

#. ja: 作業精度
#. de: Kunstfertigkeit
#. fr: Habileté
#. column 2: Affects the amount of progress achieved in a single synthesis step.
msgctxt "BaseParam:70:0:1"
msgid "Craftsmanship"
msgstr "Мастерство"

#. ja: 製作での作業の進み方に影響します。<br>作業精度が高いほど、作業が多く進みます。
#. de: Kunst<shy>fer<shy>tig<shy>keit: Beeinflusst den Fortschritt der Synthese. Je höher dieser Wert, desto schneller geht die Synthese voran.
#. fr: Influence la progression réalisée lors d'un tour d'une synthèse.
#. column 1: Craftsmanship
msgctxt "BaseParam:70:0:2"
msgid "Affects the amount of progress achieved in a single synthesis step."
msgstr "Влияет на прогресс за один этап синтеза."

#. ja: 加工精度
#. de: Kontrolle
#. fr: Contrôle
#. column 2: Affects the amount of quality improved in a single synthesis step.
msgctxt "BaseParam:71:0:1"
msgid "Control"
msgstr "Контроль"

#. ja: 製作での品質の上がり方に影響します。<br>加工精度が高いほど、品質が多く上がります。
#. de: Kontrolle: Beeinflusst die Qualität bei der Synthese. Je höher dieser Wert, desto schneller steigt die Qualität an.
#. fr: Influence la qualité réalisée lors d'un tour d'une synthèse.
#. column 1: Control
msgctxt "BaseParam:71:0:2"
msgid "Affects the amount of quality improved in a single synthesis step."
msgstr "Влияет на качество за один этап синтеза."

#. ja: 獲得力
#. de: Sammelgeschick
#. fr: Collecte
#. column 2: Affects the rate at which items are gathered.
msgctxt "BaseParam:72:0:1"
msgid "Gathering"
msgstr "Сбор"

#. ja: 採集でのアイテムの獲得率に影響します。<br>獲得力が高いほど、獲得率が高くなります。
#. de: Sammelgeschick: Beeinflusst die Sammelrate beim Sammeln. Je höher dieser Wert, desto wahrscheinlicher ist es, dass du einen Gegenstand erhältst.
#. fr: Influence le taux auquel les objets sont récoltés.
#. column 1: Gathering
msgctxt "BaseParam:72:0:2"
msgid "Affects the rate at which items are gathered."
msgstr "Влияет на вероятность получения предметов при сборе."

#. ja: 技術力
#. de: Expertise
#. fr: Savoir-faire
#. column 2: Affects item yield when gathering as a botanist or miner, and the size of fish when fishing or spearfishing.
msgctxt "BaseParam:73:0:1"
msgid "Perception"
msgstr "Восприятие"

#. ja: 採掘師・園芸師のアイテムの入手量に影響します。<br>技術力が高いほど、入手量が多くなります。<br>漁師の魚の入手サイズに影響します。<br>技術力が高いほど、大きいサイズを入手しやすくなります。
#. de: Wahrnehmung: Beeinflusst das Sammeln. Je höher dieser Wert, desto mehr Gegenstände findest du. Bei Fischern erhöht sich stattdessen die Wahr<shy>schein<shy>lich<shy>keit, einen großen Fisch zu fangen.
#. fr: Augmente la quantité d'objets récoltés pour les botanistes et les mineurs, et la taille des prises pour les pêcheurs.
#. column 1: Perception
msgctxt "BaseParam:73:0:2"
msgid "Affects item yield when gathering as a botanist or miner, and the size of fish when fishing or spearfishing."
msgstr "Влияет на количество предметов, добываемых рудознатцем или ботаником, а также на размер рыбы при ловле и подводной охоте."
