msgid "Slow Resistance"
msgstr "Сопротивление замедлению"

#. ja: スロウの効果時間を短縮します。
#. de: Resistenz gegen Gemach: Beschleunigt die Erholung vom Status Gemach.
#. fr: Réduit la durée de l'effet Lenteur.
#. column 1: Slow Resistance
msgctxt "BaseParam:57:0:2"
msgid "Shortens the duration of slow."
msgstr "Сокращает время действия замедления."

#. ja: 石化耐性
#. de: Stein-Resistenz
#. fr: Résistance à Pétrification
msgctxt "BaseParam:58:0:1"
msgid "Petrification Resistance"
msgstr "Сопротивление окаменению"

#. ja: 麻痺耐性
#. de: Paralyse-Resistenz
#. fr: Résistance à Paralysie
msgctxt "BaseParam:59:0:1"
msgid "Paralysis Resistance"
msgstr "Сопротивление параличу"

#. ja: 沈黙耐性
#. de: Schweigen-Resistenz
#. fr: Résistance à Silence
#. column 2: Shortens the duration of silence.
msgctxt "BaseParam:60:0:1"
msgid "Silence Resistance"
msgstr "Сопротивление немоте"

#. ja: 沈黙の効果時間を短縮します。
#. de: Resistenz gegen Schweigen: Beschleunigt die Erholung vom Status Schweigen.
#. fr: Réduit la durée de l'effet Silence.
#. column 1: Silence Resistance
msgctxt "BaseParam:60:0:2"
msgid "Shortens the duration of silence."
msgstr "Сокращает время действия немоты."

#. ja: 暗闇耐性
