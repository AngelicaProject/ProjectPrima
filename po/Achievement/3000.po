msgctxt "Achievement:3001:0:2"
msgid "Obtain a Padjali war scythe."
msgstr "Получить боевую косу паджалов."

#. ja: 強化されし魔器：ミルプレーヴェ
#. de: Waffen des Padjal: Hascherlite
