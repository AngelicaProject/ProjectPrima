msgid "A Storm of Seals II"
msgstr "Водоворот печатей II"

#. ja: 黒渦団で軍票を50,000獲得
#. de: 50.000 Flottentaler verdient.
#. fr: Gagner 50 000 sceaux de compagnie limséens.
#. column 1: A Storm of Seals II
msgctxt "Achievement:531:0:2"
msgid "Earn 50,000 Storm Seals."
msgstr "Заработать 50 000 печатей Водоворота."

#. ja: 黒渦団の軍票：ランク3
#. de: Talerflut im Säckle III
#. fr: Garde des sceaux III (Maelstrom)
#. column 2: Earn 100,000 Storm Seals.
msgctxt "Achievement:532:0:1"
msgid "A Storm of Seals III"
msgstr "Водоворот печатей III"

#. ja: 黒渦団で軍票を100,000獲得
#. de: 100.000 Flottentaler verdient.
#. fr: Gagner 100 000 sceaux de compagnie limséens.
#. column 1: A Storm of Seals III
msgctxt "Achievement:532:0:2"
msgid "Earn 100,000 Storm Seals."
msgstr "Заработать 100 000 печатей Водоворота."

#. ja: 紅錨勲章
#. de: Auszeichnung: Rubin-Anker
#. fr: Médaille de l'ancre écarlate
#. column 2: Earn 500,000 Storm Seals.
msgctxt "Achievement:533:0:1"
msgid "The Ruby Anchor"
msgstr "Рубиновый якорь"

#. ja: 黒渦団で軍票を500,000獲得
#. de: 500.000 Flottentaler verdient.
#. fr: Gagner 500 000 sceaux de compagnie limséens.
#. column 1: The Ruby Anchor
msgctxt "Achievement:533:0:2"
msgid "Earn 500,000 Storm Seals."
msgstr "Заработать 500 000 печатей Водоворота."

#. ja: 双蛇党の軍票：ランク1
#. de: Die güldene Schlange I
#. fr: Garde des sceaux I (Deux Vipères)
#. column 2: Earn 10,000 Serpent Seals.
msgctxt "Achievement:534:0:1"
msgid "A Snake in the Brass I"
msgstr "Змея в золоте I"

#. ja: 双蛇党で軍票を10,000獲得
#. de: 10.000 Ordenstaler verdient.
#. fr: Gagner 10 000 sceaux de compagnie gridaniens.
#. column 1: A Snake in the Brass I
msgctxt "Achievement:534:0:2"
msgid "Earn 10,000 Serpent Seals."
msgstr "Заработать 10 000 печатей Двух Змей."

