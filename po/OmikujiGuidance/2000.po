msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 冒険
#. de: Abenteuer
#. fr: Aventures<nbsp>:
#. column 2: Stay true to thyself, and the way shall open for thee.
msgctxt "OmikujiGuidance:2100:0:1"
msgid "Adventure:"
msgstr ""

#. ja: 己の信念つらぬけば、道は開ける
#. de: Bleibe treu deinem Glauben und ein neuer Weg wird sich öffnen.
#. fr: Restez fidèle à vos convictions pour trouver la voie.
#. column 1: Adventure:
msgctxt "OmikujiGuidance:2100:0:2"
msgid "Stay true to thyself, and the way shall open for thee."
msgstr ""

#. ja: 事件の気配あり　事件屋に頼るのが吉
#. de: Ein mysteriöses Ereignis steht bevor, erbitte die Hilfe des Meisterkriminologen.
#. fr: Face au mystère, appelez à l'aide le gentilhomme détective.
msgctxt "OmikujiGuidance:2101:0:2"
msgid "A case is afoot. Enlist the services of the most gentlemanly of inspectors."
msgstr ""

#. ja: 土地土地の風物や歴史に目を向けよ　新たな気付きあり
#. de: Lass deinen Blick schweifen über Szenerie und Geschichte. Bisher Unentdecktes mag dir so ins Auge fallen.
#. fr: Intéressez-vous à l'histoire des contrées traversées pour y faire des découvertes.
msgctxt "OmikujiGuidance:2102:0:2"
msgid "Look closely at the weave of the lands thou seest, and thou shalt make new discoveries."
msgstr ""

#. ja: 集団で姿勢を整え、旅の思い出を残すべし
#. de: Posiere mit deinen Kameraden und schaffe weitere unschätzbare Erinnerungen.
#. fr: Prenez la pose en groupe pour garder des souvenirs de vos voyages.
msgctxt "OmikujiGuidance:2103:0:2"
msgid "Gather thine allies, and embark upon a journey to remember."
msgstr ""

#. ja: 運命に身を任せよ　さすれば成長あり
#. de: Lass dich leiten von den Strängen des Schicksals, sie werden dich zu Wachstum führen.
#. fr: Faites confiance à la providence pour vous aider à progresser.
msgctxt "OmikujiGuidance:2104:0:2"
msgid "Place thyself in fate's hand, and thou wilt surely grow."
msgstr ""

#. ja: 孤島にて、気持ち安らがせよ
#. de: Auf einer einsamen Insel kannst du sie finden, die Ruhe.
#. fr: Goûtez au repos de l'esprit sur une île solitaire.
msgctxt "OmikujiGuidance:2105:0:2"
msgid "Heed the whispers of nature. On a faraway island shalt thou find solace and sanctuary."
msgstr ""

#. ja: 「十二」にまつわる場所を詣でよ
#. de: Begib dich auf eine Wallfahrt zu den Orten, die mit den Zwölf in Verbindung gebracht werden.
#. fr: Pèlerinez en un lieu intimement lié au nombre douze.
msgctxt "OmikujiGuidance:2106:0:2"
msgid "Rejoice in the Twelve, and thy revels shall not go unrewarded."
msgstr ""

#. ja: 絆
#. de: Beziehungen
#. fr: Relations<nbsp>:
#. column 2: Be ever grateful, and thou shalt know blessed friendship.
msgctxt "OmikujiGuidance:2200:0:1"
msgid "Relationships:"
msgstr ""

#. ja: 感謝忘れねば、よき縁に恵まれる
#. de: Untrennbare Bünde seien jenen gewiss, die stets ihre Dankbarkeit zeigen.
#. fr: Sachez vous montrer <if $gn4>re<shy>con<shy>nais<shy>sante<else>re<shy>con<shy>nais<shy>sant</if> pour entretenir de bonnes relations.
#. column 1: Relationships:
msgctxt "OmikujiGuidance:2200:0:2"
msgid "Be ever grateful, and thou shalt know blessed friendship."
msgstr ""

#. ja: いまの仲間こそが至宝　ますます大切にすべし
#. de: Unermesslichen Wertes sind deine momentanen Kameraden, lass dein Benehmen dies widerspiegeln.
#. fr: Prenez soin de vos amis, ils sont ce que vous avez de plus précieux.
msgctxt "OmikujiGuidance:2201:0:2"
msgid "Thy comrades are thy treasures. Cherish them well."
msgstr ""

#. ja: 異国の同志との縁あり　臆さず交流すべし
#. de: Ein Seelenverwandter wartet in fremden Ländern, mache dich umgehend auf den Weg.
#. fr: N'ayez pas peur d'échanger avec des aventuriers de contrées lointaines.
msgctxt "OmikujiGuidance:2202:0:2"
msgid "From a foreign land cometh a kindred soul. Embrace them without reserve."
msgstr ""

#. ja: 想いは伝わる　身振り手振りを交えるべし
#. de: Seien auch Gesten vonnöten, sei unbesorgt. Deine Gedanken und Gefühle werden dein Gegenüber erreichen.
#. fr: Exprimez-vous aussi avec des gestes pour être <if $gn4>comprise<else>compris</if>.
msgctxt "OmikujiGuidance:2203:0:2"
msgid "Where words fail to convey thy feelings, gestures may yet succeed."
msgstr ""

#. ja: 待っていても良縁なし　冒険者主催の集いに参加せよ
#. de: Ewiges Warten wird keinerlei Veränderung bringen. Suche die Ge<shy>sell<shy>schaft von gleichgesinnten Abenteurern.
#. fr: N'attendez pas qu'on vienne vous chercher pour former votre groupe.
msgctxt "OmikujiGuidance:2204:0:2"
msgid "Nothing good will come of waiting. Participate in a gathering hosted by adventurers."
msgstr ""

#. ja: 惜しまず分かち合うべし　人徳がやがて助ける
#. de: Teile ohne Vorbehalt. Deine Tugenden werden mit der Zeit erstrahlen.
#. fr: Partagez sans retenue. Vos vertus seront récompensées.
msgctxt "OmikujiGuidance:2205:0:2"
msgid "Share without reservation. Thy virtues will be rewarded."
msgstr ""

#. ja: 戦友を得る　闘技場の高みを目指せ
#. de: Suche nach Waffenbrüdern, und deine Heldentaten werden immer größere Höhen erreichen.
#. fr: Vous vous ferez un ami sur le champ de bataille. Combattez dans l'arène, et visez toujours plus haut.
msgctxt "OmikujiGuidance:2206:0:2"
msgid "Seek out comrades-in-arms, and thy feats of valor shall reach ever greater heights."
msgstr ""

#. ja: 財産
#. de: Vermögen
#. fr: Fortune<nbsp>:
#. column 2: Great success is the accumulation of small efforts. Neglect not thy daily chores.
msgctxt "OmikujiGuidance:2300:0:1"
msgid "Prosperity:"
msgstr ""

#. ja: 日課を怠らず過ごせ　塵積もって財となる
#. de: Auch der kleinste Lohn ist Teil des Weges zum Reichtum, daher vernachlässige nicht deine täglichen Pflichten.
#. fr: De petites économies naîtra un grand profit.
#. column 1: Prosperity:
msgctxt "OmikujiGuidance:2300:0:2"
msgid "Great success is the accumulation of small efforts. Neglect not thy daily chores."
msgstr ""

#. ja: 家移りに吉あり　好機を逃すな
#. de: Ein Umzug in ein neues Heim wird dir Glück bescheren, also handle rasch, ehe die Chance vertan ist!
#. fr: Si vous en avez envie, c'est le moment idéal pour déménager.
msgctxt "OmikujiGuidance:2301:0:2"
msgid "Now is an auspicious time to find a new home. Seize the opportunity."
msgstr ""

#. ja: 山野での採集に利あり
#. de: Sammle frische Gaben der Berge und Täler, große Gewinne werden sich so erzielen lassen.
#. fr: Partez récolter et la nature vous récompensera.
msgctxt "OmikujiGuidance:2302:0:2"
msgid "Great profits await reaping in the wilderness."
msgstr ""

#. ja: 仲間の仲介あれば、商機あり
#. de: Günstige Gelegenheiten nähern sich in Gestalt eines treuen Kameraden, lausche seinem Rat.
#. fr: Vous vous enrichirez par l'intermédiaire d'un ami.
msgctxt "OmikujiGuidance:2303:0:2"
msgid "A chance for profit shall come by way of a friend."
msgstr ""

#. ja: 空と海に財あり　飛空艇や潜水艦を派遣せよ
#. de: Schätze liegen verborgen über den Wolken und tief im Meer, sende unverzüglich Luftschiffe und Tauchboote los.
#. fr: Sous les mers ou dans les cieux, lancez une expédition d'exploration.
msgctxt "OmikujiGuidance:2304:0:2"
msgid "Wealth lieth in the seas and skies. Send forth vessels to explore."
msgstr ""

#. ja: 演習場に果報あり　賞杯を集めよ
#. de: Unter Wölfen wir das Glück dir hold sein. Hol dir den verdienten Sieg.
#. fr: Festoyez dans l'arène pour couvrir de gloire votre nom.
msgctxt "OmikujiGuidance:2305:0:2"
msgid "Luck shall be thine among wolves. Claim victories to thy name."
msgstr ""

#. ja: 資源を得よ　刻限を見極めるべし
#. de: Du sollst Material anhäufen. Achte gut auf die Gezeiten.
#. fr: La précision sera la clef pour accumuler les ressources.
msgctxt "OmikujiGuidance:2306:0:2"
msgid "Thou shalt accumulate resources. Mark well the tide."
msgstr ""

#. ja: 闘争
#. de: Konflikte
#. fr: Combats<nbsp>:
#. column 2: Neglect not thy provisions, and victory shall be thine.
msgctxt "OmikujiGuidance:2400:0:1"
msgid "Conflict:"
msgstr ""

#. ja: 勝てる　食事薬品の準備を怠らぬこと
#. de: Trage stets reichlich Proviant und Heilmittel mit dir, so wird sich jeder Kampf zu deinen Gunsten entscheiden.
#. fr: Préparez de quoi manger et vous soigner pour gagner.
#. column 1: Conflict:
msgctxt "OmikujiGuidance:2400:0:2"
msgid "Neglect not thy provisions, and victory shall be thine."
msgstr ""

#. ja: 苦戦するが勝てる　装備を見直すべし
#. de: Scheint der Sieg im Kampf unerreichbar, so erneuere deine Ausrüstung und deine Gegner werden mit Leichtigkeit fallen.
#. fr: Si vous gagnez dans la douleur, pensez à mieux vous préparer.
msgctxt "OmikujiGuidance:2401:0:2"
msgid "A grueling battle awaiteth. Reassess thine equipment."
msgstr ""

#. ja: 勝てる　ただし驕れば、次は負ける
#. de: Zu hoher Stolz auf bestandene Kämpfe führt zu Niederlagen im kommenden Gefecht.
#. fr: Si vous vous reposez sur vos lauriers, la victoire pourrait vous échapper.
msgctxt "OmikujiGuidance:2402:0:2"
msgid "Dwell not overmuch in sweet victory, or bitter defeat shall follow."
msgstr ""

#. ja: 力量はよし　仲間と呼吸を合わせよ
#. de: Deine Stärke kann dir den Sieg bescheren, kämpfe im Einklang mit deinen Gefährten.
#. fr: Sans coordination, la puissance n'est rien.
msgctxt "OmikujiGuidance:2403:0:2"
msgid "For strength thou wantest not. Thou needest but breathe as one with thine allies."
msgstr ""

#. ja: 力量はよし　仲間と呼吸を合わせよ
#. de: Deine Stärke kann dir den Sieg bescheren, kämpfe im Einklang mit deinen Gefährten.
#. fr: Sans coordination, la puissance n'est rien.
msgctxt "OmikujiGuidance:2404:0:2"
msgid "For strength thou wantest not. Thou needest but breathe as one with thine allies."
msgstr ""

#. ja: 運勢
#. de: Schicksal
#. fr: Destinée<nbsp>:
#. column 2: Be steadfast like unto the Keeper, and thou shalt not be led astray.
msgctxt "OmikujiGuidance:2500:0:1"
msgid "Favor:"
msgstr ""

#. ja: 時神の如き信念があれば、他者に惑わされることがないでしょう
#. de: Fülle deinen Geist mit Überzeugung gleich Althyk, so wird niemand dich beirren können.
#. fr: Croyez en vos convictions tel Althyk pour ne jamais hésiter.
#. column 1: Favor:
msgctxt "OmikujiGuidance:2500:0:2"
msgid "Be steadfast like unto the Keeper, and thou shalt not be led astray."
msgstr ""

#. ja: 知神の如き叡智があれば、凶事も切り抜けられるでしょう
#. de: Fülle dein Herz mit Einsicht gleich Thaliak, und du wirst einen Weg durch jegliches Unglück finden.
#. fr: Soyez <if $gn4>érudite<else>érudit</if> tel Thaliak pour surmonter les épreuves.
msgctxt "OmikujiGuidance:2501:0:2"
msgid "Be wise like unto the Scholar, and thou shalt find a way to overcome misfortune."
msgstr ""

#. ja: 戦神の如き志があれば、戦い続けることができるでしょう
#. de: Fülle deinen Geist mit Willenskraft gleich Halone, so wird deine Kampfeskraft nie versiegen.
#. fr: Persévérez telle Halone pour ne pas plier le genou.
msgctxt "OmikujiGuidance:2502:0:2"
msgid "Be resolute like unto the Fury, and thou shalt know no surrender."
msgstr ""

#. ja: 月神の如き視点があれば、大局を見据えることができるでしょう
#. de: Fülle deinen Geist mit der Sichtweise Menphinas, so wirst du nie den Überlick verlieren.
#. fr: Soyez <if $gn4>observatrice<else>observateur</if> telle Menphina pour appréhender la situation.
msgctxt "OmikujiGuidance:2503:0:2"
msgid "Be observant like unto the Lover, and thou shalt see all things for what they are."
msgstr ""

#. ja: 日神の如き豪気さがあれば、仲間を導くこともできるでしょう
#. de: Fülle dein Herz mit Unerschrockenheit gleich Azeyma, so wirst du deine Kameraden stets sicher leiten.
#. fr: Enhardissez-vous telle Azeyma pour mener vos compagnons.
msgctxt "OmikujiGuidance:2504:0:2"
msgid "Be audacious like unto the Warden, and thy comrades shall follow thee true."
msgstr ""
