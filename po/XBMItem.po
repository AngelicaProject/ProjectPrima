msgctxt "XBMItem:202:0:12"
msgid "Maximum HP +30%<br><ui-color 506><ui-edge-color 507>Haste</ui-edge-color></ui-color> +15%<br><ui-color 571><ui-edge-color 572>Additional Effect:</ui-edge-color></ui-color> Restores 18% of HP upon consumption<br>30% chance to recover TP upon completing a combo with a familiar instinctual skill.<br>[Suitable for vilekin.]"
msgstr "Максимальный HP +30%<br><ui-color 506><ui-edge-color 507>Ускорение</ui-edge-color></ui-color> +15%<br><ui-color 571><ui-edge-color 572>Дополнительный эффект:</ui-edge-color></ui-color> при употреблении восстанавливает 18% HP<br>При успешном комбо с инстинктивным умением питомца с вероятностью 30% восстанавливает часть потраченных TP.<br>[Подходит насекомым.]"

