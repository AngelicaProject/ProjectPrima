#. ja: カンパニーチェスト
#. de: Gesellschaftstruhe
#. fr: Coffre
#. column 1: Unlocks the company chest.
msgctxt "FCRights:1:0:0"
msgid "Company Chest"
msgstr "Сундук свободной компании"

#. ja: カンパニーチェストが利用できる。
#. de: Gewährt Zugriff auf die Ge<shy>sell<shy>schaftstruhe.
#. fr: Permet d'utiliser le coffre de la compagnie.
#. column 0: Company Chest
msgctxt "FCRights:1:0:1"
msgid "Unlocks the company chest."
msgstr "Открывает доступ к сундуку свободной компании."

#. ja: クレストエディット
#. de: Wappen entwerfen
#. fr: Blason
#. column 1: Enables company crest customization.
msgctxt "FCRights:2:0:0"
msgid "Crest Customization"
msgstr "Настройка герба"

#. ja: クレストをカスタマイズできる。
#. de: Erlaubt die Gestaltung des Ge<shy>sell<shy>schaftswappens.
#. fr: Permet de modifier l'apparence du blason de la compagnie.
#. column 0: Crest Customization
msgctxt "FCRights:2:0:1"
msgid "Enables company crest customization."
msgstr "Позволяет менять герб свободной компании."

#. ja: クレスト装飾
#. de: Wappen anbringen
#. fr: Ornementation
#. column 1: Enables personal gear to be customized with the company crest.
msgctxt "FCRights:3:0:0"
msgid "Gear Customization"
msgstr "Украшение экипировки"

#. ja: 防具にクレストを装飾できる。
#. de: Erlaubt das Anbringen des Ge<shy>sell<shy>schaftswappens an der Ausrüstung.
#. fr: Permet d'ajouter le blason de la compagnie sur des pièces d'équipement.
#. column 0: Gear Customization
msgctxt "FCRights:3:0:1"
msgid "Enables personal gear to be customized with the company crest."
msgstr "Позволяет наносить герб свободной компании на экипировку."

#. ja: カンパニーアクション
#. de: Gesellschaftskommandos
#. fr: Bienfaits
#. column 1: Enables execution of company actions.
msgctxt "FCRights:4:0:0"
msgid "Company Actions"
msgstr "Действия свободной компании"

#. ja: カンパニーアクションを利用できる。
#. de: Erlaubt das Nutzen von Ge<shy>sell<shy>schaftskommandos.
#. fr: Permet d'utiliser les bienfaits de la compagnie.
#. column 0: Company Actions
msgctxt "FCRights:4:0:1"
msgid "Enables execution of company actions."
msgstr "Позволяет использовать действия свободной компании."

#. ja: カンパニーチェスト拡張
#. de: Truhenvergrößerung
#. fr: Expansion
#. column 1: Increases the number of company chest compartments to three.
msgctxt "FCRights:5:0:0"
msgid "Chest Expansion"
msgstr "Расширение сундука"

#. ja: カンパニーチェストのボックスが２個増える。
#. de: Erweitert die Fächer der Ge<shy>sell<shy>schaftstruhe auf insgesamt drei.
#. fr: Permet d'obtenir deux compartiments de stockage sup<shy>plé<shy>men<shy>tai<shy>res.
#. column 0: Chest Expansion
msgctxt "FCRights:5:0:1"
msgid "Increases the number of company chest compartments to three."
msgstr "Увеличивает число ячеек сундука свободной компании до трёх."

#. ja: クレスト拡張
#. de: Neue Wappen
#. fr: Ajout de blasons
#. column 1: Increases the variety of company crest designs.
msgctxt "FCRights:6:0:0"
msgid "Crest Expansion"
msgstr "Новые гербы"

#. ja: 利用できる絵柄が増える。
#. de: Vergrößert das Angebot an Mustern für die Wappengestaltung.
#. fr: Permet d'augmenter le nombre de blasons de la compagnie.
#. column 0: Crest Expansion
msgctxt "FCRights:6:0:1"
msgid "Increases the variety of company crest designs."
msgstr "Добавляет новые рисунки гербов свободной компании."

#. ja: カンパニーアクション拡張
#. de: Kommandoerweiterung
#. fr: Ajout de bienfaits
#. column 1: Increases the maximum number of inactive and active company actions.
msgctxt "FCRights:7:0:0"
msgid "Action Expansion"
msgstr "Расширение действий"

#. ja: カンパニーアクションの発動数とリザーブ数が増える。
#. de: Erweitert die maximale Anzahl aktivierter und gestapelter Ge<shy>sell<shy>schaftskommandos.
#. fr: Permet d'augmenter le nombre de bienfaits actifs et inactifs de la compagnie.
#. column 0: Action Expansion
msgctxt "FCRights:7:0:1"
msgid "Increases the maximum number of inactive and active company actions."
msgstr "Увеличивает максимальное число доступных и активных действий свободной компании."

#. ja: 土地保有権
#. de: Grundstücke kaufen
#. fr: Possession de terrain
#. column 1: Enables the acquisition of land in residential districts.
msgctxt "FCRights:8:0:0"
msgid "Land Acquisition"
msgstr "Покупка участка"

#. ja: 冒険者居住区の土地を購入できる。
#. de: Ermöglicht den Kauf von Grundstücken in Abenteurer<shy>wohn<shy>gebieten.
#. fr: Permet d'acheter un terrain dans les quartiers résidentiels.
#. column 0: Land Acquisition
msgctxt "FCRights:8:0:1"
msgid "Enables the acquisition of land in residential districts."
msgstr "Позволяет покупать участки в жилых районах."

#. ja: カンパニーチェスト拡張
#. de: Truhenvergrößerung
#. fr: Expansion
#. column 1: Increases the number of company chest compartments to four.
msgctxt "FCRights:9:0:0"
msgid "Chest Expansion"
msgstr "Расширение сундука"

#. ja: カンパニーチェストのボックスが１個増える。
#. de: Erweitert die Fächer der Ge<shy>sell<shy>schaftstruhe auf insgesamt vier.
#. fr: Permet d'obtenir un compartiment de stockage sup<shy>plé<shy>men<shy>tai<shy>re.
#. column 0: Chest Expansion
msgctxt "FCRights:9:0:1"
msgid "Increases the number of company chest compartments to four."
msgstr "Увеличивает число ячеек сундука свободной компании до четырёх."

#. ja: カンパニーアクション拡張
#. de: Kommandoerweiterung
#. fr: Ajout de bienfaits inactifs
#. column 1: Increases the maximum number of inactive company actions.
msgctxt "FCRights:10:0:0"
msgid "Action Expansion"
msgstr "Расширение действий"

#. ja: カンパニーアクションのリザーブ数が増える。
#. de: Erweitert die maximale Anzahl gestapelter Ge<shy>sell<shy>schaftskommandos.
#. fr: Permet d'augmenter le nombre de bienfaits inactifs de la compagnie.
#. column 0: Action Expansion
msgctxt "FCRights:10:0:1"
msgid "Increases the maximum number of inactive company actions."
msgstr "Увеличивает максимальное число неактивных действий свободной компании."

#. ja: カンパニーチェスト拡張
#. de: Truhenvergrößerung
#. fr: Expansion
#. column 1: Increases the number of company chest compartments to five.
msgctxt "FCRights:11:0:0"
msgid "Chest Expansion"
msgstr "Расширение сундука"

#. ja: カンパニーチェストのボックスが１個増える。
#. de: Erweitert die Fächer der Ge<shy>sell<shy>schaftstruhe auf insgesamt fünf.
#. fr: Permet d'obtenir un compartiment de stockage sup<shy>plé<shy>men<shy>tai<shy>re.
#. column 0: Chest Expansion
msgctxt "FCRights:11:0:1"
msgid "Increases the number of company chest compartments to five."
msgstr "Увеличивает число ячеек сундука свободной компании до пяти."

#. ja: カンパニーアクション拡張
#. de: Kommandoerweiterung
#. fr: Ajout de bienfaits inactifs
#. column 1: Increases the maximum number of inactive company actions.
msgctxt "FCRights:12:0:0"
msgid "Action Expansion"
msgstr "Расширение действий"

#. ja: カンパニーアクションのリザーブ数が増える。
#. de: Erweitert die maximale Anzahl gestapelter Ge<shy>sell<shy>schaftskommandos.
#. fr: Permet d'augmenter le nombre de bienfaits inactifs de la compagnie.
#. column 0: Action Expansion
msgctxt "FCRights:12:0:1"
msgid "Increases the maximum number of inactive company actions."
msgstr "Увеличивает максимальное число неактивных действий свободной компании."

#. ja: カンパニーアクション拡張
#. de: Kommandoerweiterung
#. fr: Ajout de bienfaits inactifs
#. column 1: Increases the maximum number of inactive company actions.
msgctxt "FCRights:13:0:0"
msgid "Action Expansion"
msgstr "Расширение действий"

#. ja: カンパニーアクションのリザーブ数が増える。
#. de: Erweitert die maximale Anzahl gestapelter Ge<shy>sell<shy>schaftskommandos.
#. fr: Permet d'augmenter le nombre de bienfaits inactifs de la compagnie.
#. column 0: Action Expansion
msgctxt "FCRights:13:0:1"
msgid "Increases the maximum number of inactive company actions."
msgstr "Увеличивает максимальное число неактивных действий свободной компании."
