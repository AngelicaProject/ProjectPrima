# content/DeepDungeon2Entrance
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: おや、私に何か御用ですか？<br>ただいま警備中でして、時を改めてお願いいたします。
#. de: Ich bin schrecklich beschäftigt. Kann ich mich später um dich kümmern?
#. fr: Qu'est-ce que tu me veux<nbsp>? Je suis occupé, reviens plus tard.
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_KYUSEI_000_000:1"
msgid "I do not mean to be rude, but I prefer to be left undisturbed while on guard duty. Move along, please."
msgstr "Не хочу показаться грубым, но во время дежурства предпочитаю, чтобы меня не отвлекали. Проходите, пожалуйста."

#. ja: <ui-color 565><ui-edge-color 566>「アメノミハシラ」に挑戦する</ui-edge-color></ui-color>
#. de: <ui-color 565><ui-edge-color 566>Himmelssäule</ui-edge-color></ui-color> betreten
#. fr: <ui-color 565><ui-edge-color 566>Pénétrer dans le Pilier des Cieux</ui-edge-color></ui-color>
#. macro: <hyphen> — a hyphen that does not break the line (may be added or dropped)
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_TEST_START_MENU_ENTER:1"
msgid "Enter Heaven<hyphen>on<hyphen>High"
msgstr "Войти в Высокую руну небес"

#. ja: 「踏破状況をリセット」する
#. de: Fortschritt zurücksetzen
#. fr: Effacer une sauvegarde
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_TEST_START_MENU_RESET:1"
msgid "Reset your progress"
msgstr "Сбросить прогресс"

#. ja: 「固定パーティを解散」する
#. de: Bestehende Gruppe auflösen
#. fr: Dissoudre une équipe fixe
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_TEST_START_MENU_BREAKUP:1"
msgid "Disband your fixed party"
msgstr "Распустить постоянную группу"

#. ja: 「スコア」を確認する
#. de: Punktzahl ansehen
#. fr: Vérifier les scores
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_TEST_START_MENU_SCORE:1"
msgid "View your scores"
msgstr "Посмотреть очки"

#. ja:  説明を見る
#. de: Mehr erfahren
#. fr: En savoir plus sur le Pilier des Cieux
#. macro: <hyphen> — a hyphen that does not break the line (may be added or dropped)
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_TEST_START_MENU_ABOUT:1"
msgid "Learn about Heaven<hyphen>on<hyphen>High"
msgstr "Узнать о Высокой руне небес"

#. ja: 何をする？
#. de: Mit was für einer Gruppe möchtest du die Himmelssäule betreten?
#. fr: Que voulez-vous faire<nbsp>?
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_TEST_ENTER_MENU_TITLE:1"
msgid "What will you do?"
msgstr "Что будете делать?"

#. ja: 「固定パーティ」で突入する
#. de: Mit einer bestehenden Gruppe
#. fr: Pénétrer en équipe fixe
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_TEST_ENTER_MENU_FIXED:1"
msgid "Enter with a fixed party."
msgstr "Войти постоянной группой"

#. ja: 「マッチングパーティ」で突入する
#. de: Mit einer zufälligen Gruppe
#. fr: Pénétrer en équipe formée par groupement
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_TEST_ENTER_MENU_MATCHING:1"
msgid "Enter with a matched party."
msgstr "Войти группой, подобранной через поиск"

#. ja: もどる
#. de: Abbrechen
#. fr: Retour
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_TEST_ENTER_MENU_BACK:1"
msgid "Return."
msgstr "Возвращение"

#. ja: 「固定パーティ」で突入しますか？
#. de: Möchtest du die Himmelssäule mit einer bestehenden Gruppe betreten?
#. fr: Pénétrer dans le Pilier des Cieux en <ui-color 506><ui-edge-color 507>équipe fixe</ui-edge-color></ui-color><nbsp>?
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_TEST_ENTER_FIXED_Q:1"
msgid "Are you sure you wish to enter with a fixed party?"
msgstr "Войти постоянной группой?"

#. ja: 「マッチングパーティ」で突入しますか？
#. de: Möchtest du die Himmelssäule mit einer zufälligen Gruppe betreten?
#. fr: Pénétrer dans le Pilier des Cieux en <ui-color 506><ui-edge-color 507>équipe formée par groupement</ui-edge-color></ui-color><nbsp>?
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_TEST_ENTER_MATCHING_Q:1"
msgid "Are you sure you wish to enter with a matched party?"
msgstr "Войти группой, подобранной через поиск?"

#. ja: ……本当に、おひとりで探索に向かわれるので？<br>いかな<split " " 2><string $gs1></split>殿とはいえ、<br>単独では苦戦を免れぬと思いますが、よろしいのですか？
#. de: Bist du dir sicher, dass du die Himmelssäule ganz alleine betreten willst? In ihrem Inneren hausen mehr Ungeheuer und Dämonen, als auf allen Inseln der Rubinsee zusammen.
#. fr: Tu veux y aller <if $gn4>toute seule<else>tout seul</if><nbsp>!? Même si Rasho a l'air de te tenir en haute estime, laisse-moi te dire que c'est du suicide...
#. macro: <hyphen> — a hyphen that does not break the line (may be added or dropped)
#, aeria-term-model-exception: warrior 98331897256f
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_KYUSEI_000_010:1"
msgid "You intend to enter Heaven<hyphen>on<hyphen>High alone? While I have heard tales of your strength from Rasho, I fear that even a warrior of your caliber may be hard-pressed. Will you not reconsider?"
msgstr "Ты собираешься войти в Высокую руну в одиночку? Рашо много рассказывал о твоей силе, но даже тебе там придётся нелегко. Может, передумаешь?"

#. ja: 本当にひとりで「アメノミハシラ」に突入しますか？
#. de: Möchtest du die Himmelssäule wirklich alleine betreten?
#. fr: Pénétrer dans le Pilier des Cieux en <ui-color 506><ui-edge-color 507>solo</ui-edge-color></ui-color><nbsp>?
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_TEST_ENTER_SOLO:1"
msgid "Are you sure you wish to enter alone?"
msgstr "Вы уверены, что хотите войти в одиночку?"

#. ja: どの階層から突入しますか？
#. de: Wähle die Ebene, ab der du die Erkundung starten möchtest.
#. fr: Pénétrer à partir de quel étage<nbsp>?
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_ENTER_WHICH_Q:1"
msgid "From which floor will you enter?"
msgstr "С какого яруса войдёте?"

#. ja: 1層
#. de: Ebene 1
#. fr: Étage 1
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_ENTER_A1:1"
msgid "Floor one."
msgstr "Первый ярус"

#. ja: 21層
#. de: Ebene 21
#. fr: Étage 21
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_ENTER_A2:1"
msgid "Floor twenty-one."
msgstr "Двадцать первый ярус"

#. ja: <ui-color 565><ui-edge-color 566>次の階層に挑戦する</ui-edge-color></ui-color>
#. de: <ui-color 565><ui-edge-color 566>Nächste Ebene</ui-edge-color></ui-color> betreten
#. fr: <ui-color 565><ui-edge-color 566>Explorer la série d'étages suivante</ui-edge-color></ui-color>
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_MIDDLE_TOP_MENU_NEXT:1"
msgid "Proceed to the next floor"
msgstr "Перейти на следующий ярус"

#. ja: 説明を見る
#. de: Mehr erfahren
#. fr: En savoir plus sur le Pilier des Cieux
#. macro: <hyphen> — a hyphen that does not break the line (may be added or dropped)
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_MIDDLE_TOP_MENU_EXPLAIN:1"
msgid "Review rules for Heaven<hyphen>on<hyphen>High"
msgstr "Правила Высокой руны небес"

#. ja: 現在のパーティで、攻略を続けることができます。<br>このまま先の階層へ進みますか？
#. de: Möchtest du mit der gleichen Gruppe die Himmelssäule weiter emporsteigen?
#. fr: Poursuivre votre exploration en accédant à la série d'étages suivante<nbsp>?
msgctxt "content/DeepDungeon2Entrance:TEXT_DEEPDUNGEON2ENTRANCE_MIDDLE_Q:1"
msgid "Proceed to the next floor with your current party?"
msgstr "Продолжить на следующий ярус с нынешней группой?"
