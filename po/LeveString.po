msgid "Survey target areas.<br><ui-color 504><ui-edge-color 505>Evaluation Bonus:</ui-edge-color></ui-color><br>160～ +25%<br>152～ +10%<br>143～  +5%"
msgstr ""

#. ja: 依頼品を対象に設置せよ
#. de: Bring das Geforderte am Zielobjekt an
#. fr: Apporter les objets aux lieux désignés
msgctxt "LeveString:14:0:0"
msgid "Deliver the items to the specified locations."
msgstr ""

#. ja: 目標物が足りない場合は任務失敗
#. de: Bei zu wenigen Gegenständen scheitert die Mission
#. fr: Le mandat échoue si trop peu d'objets sont obtenus
msgctxt "LeveString:15:0:0"
msgid "Levequest deemed a failure if too few items are obtained."
msgstr ""

#. ja: 目標地点を捜索
#. de: Such am Zielort
#. fr: Inspecter le lieu désigné
msgctxt "LeveString:16:0:0"
msgid "Survey target areas."
msgstr ""

#. ja: 対象を誘い出して倒せ
#. de: Lock das Ziel hervor und vernichte es.
#. fr: Attirer puis éliminer les cibles
msgctxt "LeveString:17:0:0"
msgid "Lure target from hiding and slay it."
msgstr ""

