msgid "Yes"
msgstr "Да"

#. ja: いいえ
#. de: Nein
#. fr: Non
#. column 17: Buy another ticket?<br>It'll cost you <num $n3> MGP.
#. column 18: Yes
msgctxt "GoldSaucerTalk:490:0:19"
msgid "No"
msgstr "Нет"

#. ja: 続けて交換しますか？
#. de: Noch ein Los eintauschen?
#. fr: Récupérer vos autres lots<nbsp>?
#. column 18: Yes
#. column 19: No
msgctxt "GoldSaucerTalk:491:0:17"
msgid "Claim more prizes?"
msgstr "Забрать ещё призы?"

#. ja: はい
#. de: Ja
#. fr: Oui
#. column 17: Claim more prizes?
#. column 19: No
msgctxt "GoldSaucerTalk:491:0:18"
msgid "Yes"
msgstr "Да"

#. ja: いいえ
#. de: Nein
#. fr: Non
#. column 17: Claim more prizes?
#. column 18: Yes
