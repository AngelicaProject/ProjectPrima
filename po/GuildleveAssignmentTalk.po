msgctxt "GuildleveAssignmentTalk:28:0:32"
msgid "May you walk in the light of the Crystal, <if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 0></if><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 0></if><if ($gn54 > 0)><sheet GCRankUldahMaleText $gn54 0></if> <split \" \" 2><string $gs1></split>."
msgstr "Да озарит вас свет Кристалла, <if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 0></if><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 0></if><if ($gn54 > 0)><sheet GCRankUldahMaleText $gn54 0></if> <split \" \" 2><string $gs1></split>."

