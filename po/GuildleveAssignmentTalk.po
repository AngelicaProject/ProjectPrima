msgid "Welcome back, <if ($gn52 > 0)><sheet GCRankLimsaMaleText $gn52 0></if><if ($gn53 > 0)><sheet GCRankGridaniaMaleText $gn53 0></if><if ($gn54 > 0)><sheet GCRankUldahMaleText $gn54 0></if> <split \" \" 2><string $gs1></split>. I have readied your seals."
