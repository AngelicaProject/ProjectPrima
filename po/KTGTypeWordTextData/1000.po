#. fr: Oui capitaine !
#. column 1: あいあいさー
msgctxt "KTGTypeWordTextData:1694:0:0"
msgid "アイアイサー！"
msgstr "Есть, сэр!"

#. ja: 今日は残業なしだぞ、と
#. de: Heute ist leider schon Feierabend!
#. fr: Pas question de faire des heures sup !
#. column 1: きょうはざんぎょうなしだぞと
msgctxt "KTGTypeWordTextData:1695:0:0"
msgid "今日は残業なしだぞ、と"
msgstr "Сегодня без сверхурочных!"

#. ja: でっけえ借り、返してもらうぜ！
#. de: Mit euch hab ich noch 'ne Rechnung offen!
#. fr: でっけえ借り、返してもらうぜ！
#. column 1: でっけえかりかえしてもらうぜ
msgctxt "KTGTypeWordTextData:1696:0:0"
msgid "Still owe you both for Sector 7."
msgstr "Я вам обоим ещё за сектор 7 должен."

#. ja: 相棒、いつもの頼む
#. de: Reno. Du weißt Bescheid!
#. fr: Réno, tu sais ce qu'on doit faire
#. column 1: あいぼういつものたのむ
msgctxt "KTGTypeWordTextData:1697:0:0"
msgid "Reno. You know what to do."
msgstr "Рено, ты знаешь, что делать."

#. ja: タークス、舐めんなよ
#. de: Erteilen wir ihnen 'ne Turks-Lektion.
#. fr: Leur donner une bonne leçon
#. column 1: たーくすなめんなよ
msgctxt "KTGTypeWordTextData:1698:0:0"
msgid "タークス、舐めんなよ"
msgstr "Турков не недооценивай!"

#. ja: てめえは一発、ぶん殴っておかねえとな
#. de: Du kriegst jetzt erst mal eine geballert!
#. fr: Un bon gros coup de poing dans ta face
#. column 1: てめえはいっぱつぶんなぐっておかねえとな
msgctxt "KTGTypeWordTextData:1699:0:0"
msgid "てめえは一発、ぶん殴っておかねえとな"
msgstr "Надо бы для начала как следует тебе врезать!"

#. ja: 生きてこその、タークスだ
#. de: Er steht euch nicht, der Tod.
#. fr: Quand on est un TURK, on survit
#. column 1: いきてこそのたーくすだ
msgctxt "KTGTypeWordTextData:1700:0:0"
msgid "Death doesn't suit a Turk."
msgstr "Смерть не для турка."

#. ja: メテオ
#. de: Meteor
#. fr: météore
#. column 1: めてお
msgctxt "KTGTypeWordTextData:1701:0:0"
msgid "meteor"
msgstr "Метеор"

#. ja: なにがあっても、いっしょだよ
#. de: Wir stehen das durch. Was auch passiert.
#. fr: Quoi qu'il arrive, je suis avec toi.
#. column 1: なにがあってもいっしょだよ
msgctxt "KTGTypeWordTextData:1702:0:0"
msgid "Whatever happens, I'm here for you."
msgstr "О вы, кто преодолел вечность и стоит здесь"

#. ja: 悠久の時を超え、ここに立つ者たちよ
#. de: Überwinder der Ewigkeit
#. fr: 悠久の時を超え、ここに立つ者たちよ
#. column 1: ゆうきゅうのときをこえここにたつものたちよ
msgctxt "KTGTypeWordTextData:1703:0:0"
msgid "悠久の時を超え、ここに立つ者たちよ"
msgstr "Ты всего лишь марионетка. Моя марионетка."

#. ja: かわいい、俺のからっぽ人形
#. de: Denn du bist meine willenlose Marionette.
#. fr: Tu es mon pantin vide d'émotions
#. column 1: かわいいおれのからっぽにんぎょう
msgctxt "KTGTypeWordTextData:1704:0:0"
msgid "For you are but a puppet. My puppet."
msgstr "Наполни свою пустую душу яростью."

#. ja: からっぽの心を、怒りで満たせ
#. de: Füll dein leeres Herz mit Zorn und Wut.
#. fr: Emplis ton cœur vide d'une colère enflammée
#. column 1: からっぽのこころをいかりでみたせ
msgctxt "KTGTypeWordTextData:1705:0:0"
msgid "Fill your hollow heart with rage."
msgstr "Не скорби. Ты всего лишь вернёшься к звезде."

#. ja: 悲しむことはない、星に帰るだけだ
#. de: Fürchtet euch nicht.
#. fr: Il ne faut pas avoir peur
#. column 1: かなしむことはないほしにかえるだけだ
msgctxt "KTGTypeWordTextData:1706:0:0"
msgid "悲しむことはない、星に帰るだけだ"
msgstr "Наше место"

#. ja: 思い出の場所
#. de: Unser Platz
#. fr: Un endroit plein de souvenirs
#. column 1: おもいでのばしょ
msgctxt "KTGTypeWordTextData:1708:0:0"
msgid "Our Spot"
msgstr "Стоит сделать выбор — и перед тобой откроется новый мир."

#. ja: 選んだら、新しい世界が広がる
#. de: Neue Wege erschließen eine neue Welt.
#. fr: J'avais tout un monde nouveau devant moi
#. column 1: えらんだらあたらしいせかいがひろがる
msgctxt "KTGTypeWordTextData:1709:0:0"
msgid "選んだら、新しい世界が広がる"
msgstr "Стоит сделать выбор — и перед тобой откроется новый мир."

#. ja: 俺の人生を取り戻したい
#. de: Ich will mir mein Leben zurückholen.
#. fr: Je voudrais tellement retrouver ma vie
#. column 1: おれのじんせいをとりもどしたい
msgctxt "KTGTypeWordTextData:1710:0:0"
msgid "I wanted to take back my life."
msgstr "Я хотел вернуть себе жизнь."

#. ja: 祝福を、おまえに贈ろう
#. de: Ich werde meinen Segen mit dir teilen.
#. fr: Réjouis-toi, je t'offre ma bénédiction
#. column 1: しゅくふくをおまえにおくろう
msgctxt "KTGTypeWordTextData:1712:0:0"
msgid "I give you my blessing."
msgstr "Благословляю тебя."

#. ja: 命は星を巡る
#. de: Das Leben fließt durch den Planeten.
#. fr: La vie parcourt notre planète
#. column 1: いのちはほしをめぐる
msgctxt "KTGTypeWordTextData:1713:0:0"
msgid "All born are bound to her."
msgstr "Все рождённые связаны с ней."

#. ja: 忘らるる都
#. de: Vergessene Stadt
#. fr: Cité perdue
#. column 1: わすらるるみやこ
msgctxt "KTGTypeWordTextData:1714:0:0"
msgid "forgotten capital"
msgstr "забытая столица"

#. ja: 我々の世界に、リユニオンするのだ
#. de: Eine Reunion mit unserer Welt.
#. fr: 我々の世界に、リユニオンするのだ
#. column 1: われわれのせかいにりゆにおんするのだ
msgctxt "KTGTypeWordTextData:1715:0:0"
msgid "我々の世界に、リユニオンするのだ"
msgstr "Объединитесь с нашим миром."

#. ja: 正宗
#. de: Masamune
#. fr: Masamune
#. column 1: まさむね
msgctxt "KTGTypeWordTextData:1716:0:0"
msgid "Masamune"
msgstr "Масамунэ"

#. ja: 墜ちた英雄
#. de: Wo Licht ist, da sind auch Schatten
#. fr: Un héros déchu
#. column 1: おちたえいゆう
msgctxt "KTGTypeWordTextData:1717:0:0"
msgid "Never Meet Your Heroes"
msgstr "Не встречайте кумиров"

#. ja: ジェノバの再臨
#. de: Eine Schifffahrt, die ist lustig?
#. fr: Le retour de Jénova
#. column 1: じぇのばのさいりん
msgctxt "KTGTypeWordTextData:1718:0:0"
msgid "Cryptic Cameo"
msgstr "Таинственное появление"

#. ja: ひとときのバカンス
#. de: Davon stand nichts im Prospekt
#. fr: De courtes vacances
#. column 1: ひとときのばかんす
msgctxt "KTGTypeWordTextData:1719:0:0"
msgid "Fun in the Sun"
msgstr "Отдых под солнцем"

#. ja: 魔晄の代償
#. de: Der Preis des Fortschritts
#. fr: Le lourd tribut de la mako
#. column 1: まこうのだいしょう
msgctxt "KTGTypeWordTextData:1720:0:0"
msgid "The Price of Progress"
msgstr "Цена прогресса"

#. ja: 楽園からの脱出
#. de: Flucht aus dem Paradies
#. fr: La fuite du paradis doré
#. column 1: らくえんからのだっしゅつ
msgctxt "KTGTypeWordTextData:1721:0:0"
msgid "Worth the Weight?"
msgstr "А стоит ли оно того?"

#. ja: 劣化するソルジャー
#. de: Verdammte Degeneration
#. fr: Maudite dégénérescence
#. column 1: れっかするそるじゃー
msgctxt "KTGTypeWordTextData:1722:0:0"
msgid "You're Not Murasaki"
msgstr "Ты не Мурасаки"

#. ja: 思い出のデート
#. de: Auf Wolke 7
#. fr: Un rendez-vous inoubliable
#. column 1: おもいでのでーと
msgctxt "KTGTypeWordTextData:1723:0:0"
msgid "Hearts Out, Dukes Up"
msgstr "Сердца нараспашку, кулаки наготове"

#. ja: チャドリーオーバーフロー
#. de: Hart im Nehmen
#. fr: Combattant virtuel
#. column 1: ちゃどりーおーばーふろー
msgctxt "KTGTypeWordTextData:1724:0:0"
msgid "Virtually Renowned"
msgstr "Виртуальная слава"

#. ja: 星の鳴き声
#. de: Der Schrei des Planeten
#. fr: 星の鳴き声
#. column 1: ほしのなきごえ
msgctxt "KTGTypeWordTextData:1725:0:0"
msgid "Crying Out"
msgstr "Зов планеты"

#. ja: モーグリ大好きソルジャー
#. de: Freund der Mogrys
#. fr: Entrepreneur mog
#. column 1: もーぐりだいすきそるじゃー
msgctxt "KTGTypeWordTextData:1726:0:0"
msgid "Moogle Lover"
msgstr "Любитель муглов"

#. ja: ピアノマエストロ
#. de: Klaviervirtuose
#. fr: Virtuose du piano
#. column 1: ぴあのまえすとろ
msgctxt "KTGTypeWordTextData:1727:0:0"
msgid "Piano Virtuoso"
msgstr "Виртуоз игры на фортепиано"

#. ja: サボテンダー千本ノッカー
#. de: Schatz von Wüste beschützen!
#. fr: Dégommeur de pampas
#. column 1: さぼてんだーせんぼんのっかー
msgctxt "KTGTypeWordTextData:1728:0:0"
msgid "Cactuar Crusher"
msgstr "Крушитель кактуаров"

#. ja: 星の泉のガンビットマスター
#. de: Gambit-Meister
#. fr: Maître des gambits
#. column 1: ほしのいずみのがんびっとますたー
msgctxt "KTGTypeWordTextData:1729:0:0"
msgid "The Gambit Paid Off"
msgstr "Игра стоит свеч"

#. ja: コンドルフォートの名将
#. de: Kommandant von Fort Kondor
#. fr: Général de Fort Condor
#. column 1: こんどるふぉーとのめいしょう
msgctxt "KTGTypeWordTextData:1730:0:0"
msgid "Fort Condor Commander"
msgstr "Командир форта Кондор"

#. ja: 第七歩兵連隊全員集合
#. de: Kompanie, halt!
#. fr: Grand rassembleur de la 7e
#. column 1: だいななほへいれんたいぜんいんしゅうごう
msgctxt "KTGTypeWordTextData:1731:0:0"
msgid "7th, Assemble!"
msgstr "Седьмой, общий сбор!"

#. ja: 最優秀パフォーマンス賞受賞
#. de: Der Stolz Midgars
#. fr: Star de la parade
#. column 1: さいゆうしゅうぱふぉーまんすしょうじゅしょう
msgctxt "KTGTypeWordTextData:1732:0:0"
msgid "Stealing the Show"
msgstr "Затмил всех"

#. ja: すべてを超えし者
#. de: Der Unerschrockene
#. fr: À l'épreuve des difficultés
#. column 1: すべてをこえしもの
msgctxt "KTGTypeWordTextData:1733:0:0"
msgid "Of Hardy Stock"
msgstr "Крепче всех"

#. ja: 復讐への旅立ち
#. de: Wer will mein Handlanger werden?
#. fr: La route de la vengeance
#. column 1: ふくしゅうへのたびだち
msgctxt "KTGTypeWordTextData:1734:0:0"
msgid "The Road to Revenge"
msgstr "Дорога мести"

#. ja: 八番街の逃走
#. de: So war's nicht geplant.
#. fr: Échappée dans les flammes
#. column 1: はちばんがいのとうそう
msgctxt "KTGTypeWordTextData:1735:0:0"
msgid "Escape Artist"
msgstr "Мастер побега"

#. ja: なんでも屋の仕事
#. de: Ein Cloud für alle Fälle
#. fr: Un mercenaire au bidonville
#. column 1: なんでもやのしごと
msgctxt "KTGTypeWordTextData:1736:0:0"
msgid "Mercenary Endeavors"
msgstr "Работа наёмника"

#. ja: アバランチとの絆
#. de: Verschworene Bande
#. fr: Escapade nocturne
#. column 1: あばらんちとのきずな
msgctxt "KTGTypeWordTextData:1737:0:0"
msgid "Night on the Town"
msgstr "Ночь в городе"

#. ja: 罠に落ちたネズミ
#. de: Die Rattenfänger von Midgar
#. fr: Piégés comme des rats
#. column 1: わなにおちたねずみ
msgctxt "KTGTypeWordTextData:1738:0:0"
msgid "Trapped like Sewer Rats"
msgstr "Попались, как крысы"

#. ja: ソルジャーの肩慣らし
#. de: Reifeprüfung bestanden
#. fr: Échauffement de SOLDAT
#. column 1: そるじゃーのかたならし
msgctxt "KTGTypeWordTextData:1739:0:0"
msgid "Warming Up"
msgstr "Разминка"

#. ja: ダーツエキスパート
#. de: Bullseye!
#. fr: L'as de la fléchette
#. column 1: だーつえきすぱーと
msgctxt "KTGTypeWordTextData:1740:0:0"
msgid "Heavenly Dart Player"
msgstr "Король дартса"

#. ja: バイクソルジャー
#. de: Ein heißer Feuerstuhl
#. fr: SOLDAT sur deux roues
#. column 1: ばいくそるじゃー
msgctxt "KTGTypeWordTextData:1741:0:0"
msgid "Biker Boy"
msgstr "Парень на байке"

#. ja: ジョニーのマブダチ
#. de: Johnnys Busenfreund
#. fr: Meilleur pote de Johnny
#. column 1: じょにーのまぶだち
msgctxt "KTGTypeWordTextData:1742:0:0"
msgid "The Johnny Experience"
msgstr "Джонни — закадычный друг"

#. ja: ダンシングクイーン
#. de: Tanzkönig
#. fr: Danseur étoile
#. column 1: だんしんぐくいーん
msgctxt "KTGTypeWordTextData:1743:0:0"
msgid "Dancing Queen"
msgstr "Королева танца"

#. ja: 伝説の剣豪
#. de: Der legendäre Schwertmeister
#. fr: Bretteur légendaire
#. column 1: でんせつのけんごう
msgctxt "KTGTypeWordTextData:1744:0:0"
msgid "Bladesman of Legend"
msgstr "Легендарный мастер меча"

#. de: Hoffentlich bist du deine Gil wert.
#. fr: On te paye une petite fortune
msgctxt "KTGTypeWordTextData:1745:0:0"
msgid "You'd better be worth the money, merc."
msgstr "Смотри, чтобы ты отработал свои деньги, наёмник."

#. de: Lockhart
#. fr: Lockhart
msgctxt "KTGTypeWordTextData:1746:0:0"
msgid "Lockhart"
msgstr "Локхарт"

#. de: Strife
#. fr: Strife
msgctxt "KTGTypeWordTextData:1747:0:0"
msgid "Strife"
msgstr "Страйф"

#. de: Wallace
#. fr: Wallace
msgctxt "KTGTypeWordTextData:1748:0:0"
msgid "Wallace"
msgstr "Уоллес"

#. de: Blumenverkäuferin
#. fr: Vendeuse de fleurs
msgctxt "KTGTypeWordTextData:1749:0:0"
msgid "Flower Peddler"
msgstr "Продавщица цветов"

#. de: Gainsborough
#. fr: Gainsborough
msgctxt "KTGTypeWordTextData:1750:0:0"
msgid "Gainsborough"
msgstr "Гейнсборо"

#. de: Fair
#. fr: Fair
msgctxt "KTGTypeWordTextData:1751:0:0"
msgid "Fair"
msgstr "Фэйр"

msgctxt "KTGTypeWordTextData:1752:0:0"
msgid "Come on! Let's push it past the redline!"
msgstr "Ну же! Выжми до красной черты!"

msgctxt "KTGTypeWordTextData:1753:0:0"
msgid "Don't be shy, little kitten."
msgstr "Не стесняйся, киска."

msgctxt "KTGTypeWordTextData:1754:0:0"
msgid "Nailed it, I know. Thank you. Moving on."
msgstr "Вот так, я знал. Спасибо. Продолжим."

msgctxt "KTGTypeWordTextData:1755:0:0"
msgid "Round and round it goes."
msgstr "И так по кругу."

#. de: Tuesti
#. fr: Tuesti
msgctxt "KTGTypeWordTextData:1756:0:0"
msgid "Tuesti"
msgstr "Туэсти"

#. de: Bewahre deine Ehre als SOLDAT!
#. fr: Tu dois protéger ton honneur en tant que SOLDAT !
msgctxt "KTGTypeWordTextData:1757:0:0"
msgid "Protect your honor as a SOLDIER!"
msgstr "Защити честь СОЛДАТА!"

#. de: Endlos wie der Himmel.
#. fr: C'est comme un ciel sans fin
msgctxt "KTGTypeWordTextData:1758:0:0"
msgid "Like a great, never-ending sky."
msgstr "Словно бескрайнее небо."

#. de: Kommt und holt's euch!
#. fr: Ça va chauffer !
msgctxt "KTGTypeWordTextData:1759:0:0"
msgid "Come and get it!"
msgstr "Ну, подходи!"

#. de: Zander
#. fr: maire Zander
msgctxt "KTGTypeWordTextData:1760:0:0"
msgid "Mayor Zander"
msgstr "мэр Зандер"

#. de: Sie denken wohl, wir langweilen uns.
#. fr: Réalisme nociceptif maximal
msgctxt "KTGTypeWordTextData:1762:0:0"
msgid "They figure we need a challenge."
msgstr "Похоже, они решили, что нам не хватает испытаний."

#. fr: Descendants d'un clan de shinobi
msgctxt "KTGTypeWordTextData:1763:0:0"
msgid "ninjas"
msgstr "ниндзя"

msgctxt "KTGTypeWordTextData:1764:0:0"
msgid "Moonlight Thievery"
msgstr "Воровство при лунном свете"

#. fr: La vie est comme un labyrinthe sans fin
msgctxt "KTGTypeWordTextData:1765:0:0"
msgid "Life in the Endless Maze"
msgstr "Жизнь в бесконечном лабиринте"

#. de: Chocobo & Mogry
#. fr: Chocobo et mog
msgctxt "KTGTypeWordTextData:1766:0:0"
msgid "chocobo and moogle"
msgstr "чокобо и мугл"

#. fr: Chocobo Sam
msgctxt "KTGTypeWordTextData:1767:0:0"
msgid "Chocobo Sam"
msgstr "Чокобо Сэм"

#. de: Kisaragi
#. fr: Kisaragi
msgctxt "KTGTypeWordTextData:1768:0:0"
msgid "Kisaragi"
msgstr "Кисараги"

#. de: Kusakabe
#. fr: Kusakabe
msgctxt "KTGTypeWordTextData:1769:0:0"
msgid "Kusakabe"
msgstr "Кусабэ"

#. de: Mutter. Ich bin gekommen.
msgctxt "KTGTypeWordTextData:1770:0:0"
msgid "Mother. I have come for you."
msgstr "Мама. Я пришёл за тобой."

#. de: Ich bin der wahre Erbe dieses Planeten.
msgctxt "KTGTypeWordTextData:1771:0:0"
msgid "This planet is my birthright."
msgstr "Эта планета принадлежит мне по праву рождения."

#. de: Gib dich ganz deinem Hass hin, Cloud.
msgctxt "KTGTypeWordTextData:1772:0:0"
msgid "Let that righteous anger guide you."
msgstr "Отдайся своему праведному гневу, Клауд."

#. de: Lehn dich mit mir gegen das Schicksal auf.
msgctxt "KTGTypeWordTextData:1773:0:0"
msgid "Let us defy destiny together."
msgstr "Давай вместе бросим вызов судьбе."

msgctxt "KTGTypeWordTextData:1774:0:0"
msgid "The Tiny Bronco Sails the Sea"
msgstr "«Тайни Бронко» бороздит моря"

#. de: Diebeshandschuhe
#. fr: brassard de voleur
msgctxt "KTGTypeWordTextData:1775:0:0"
msgid "noble thief's gloves"
msgstr "перчатки благородного вора"

#. de: He, du!
#. fr: Salut vous !
msgctxt "KTGTypeWordTextData:1776:0:0"
msgid "What do we have here?"
msgstr "И что у нас тут?"

#. de: Die Sterne werden uns den Weg zeigen!
#. fr: Laissez-moi vous dire la bonne aventure !
msgctxt "KTGTypeWordTextData:1777:0:0"
msgid "You should get yourself a reading!"
msgstr "Тебе бы погадать!"

msgctxt "KTGTypeWordTextData:1778:0:0"
msgid "Pull over and exit the vehicle now!"
msgstr "Съезжайте на обочину и немедленно выйдите из машины!"

msgctxt "KTGTypeWordTextData:1779:0:0"
msgid "Don't be afraid."
msgstr "Не бойся."

msgctxt "KTGTypeWordTextData:1780:0:0"
msgid "It's not death. It's a homecoming."
msgstr "Это не смерть. Это возвращение домой."

msgctxt "KTGTypeWordTextData:1781:0:0"
msgid "Gimme a celeris!"
msgstr "Дайте мне целерис!"

#. fr: Je veux un remède !
msgctxt "KTGTypeWordTextData:1782:0:0"
msgid "Gimme a remedy!"
msgstr "Дайте мне лекарство!"

#. de: Gib mir ein Diadem!
#. fr: Je veux un diadème !
msgctxt "KTGTypeWordTextData:1783:0:0"
msgid "Gimme a circlet!"
msgstr "Дайте мне диадему!"

#. fr: Je veux un antidote !
msgctxt "KTGTypeWordTextData:1784:0:0"
msgid "Gimme an antidote!"
msgstr "Дайте мне противоядие!"

#. fr: Je veux un calmant !
msgctxt "KTGTypeWordTextData:1785:0:0"
msgid "Gimme a sedative!"
msgstr "Дайте мне успокоительное!"

msgctxt "KTGTypeWordTextData:1786:0:0"
msgid "Gimme a Hardedge!"
msgstr "Дайте мне «Хардэдж»!"

msgctxt "KTGTypeWordTextData:1787:0:0"
msgid "Gimme a white cape!"
msgstr "Дайте мне белый плащ!"

#. de: Gib mir einen Kodex!
#. fr: Je veux un codex !
msgctxt "KTGTypeWordTextData:1788:0:0"
msgid "Gimme a folio!"
msgstr "Дайте мне фолиант!"

msgctxt "KTGTypeWordTextData:1789:0:0"
msgid "Gimme a fury ring!"
msgstr "Дайте мне кольцо ярости!"

msgctxt "KTGTypeWordTextData:1790:0:0"
