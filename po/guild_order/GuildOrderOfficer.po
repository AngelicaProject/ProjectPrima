#. ja: （★未使用／削除予定★）
#. de: Was willst du?
#. fr: （★未使用／削除予定★）
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_MENU_TITLE:1"
msgid "What would you like to do?"
msgstr ""

#. ja: 自分だけ帰還する
#. de: Allein zurückkehren.
#. fr: Quitter l'opération individuellement
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_MENU_00:1"
msgid "Withdraw self from the operation."
msgstr ""

#. ja: パーティで帰還する
#. de: Mit der Gruppe zurückkehren.
#. fr: Quitter l'opération collectivement
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_MENU_01:1"
msgid "Withdraw party from the operation."
msgstr ""

#. ja: 何もしない
#. de: Nichts.
#. fr: Annuler
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_MENU_02:1"
msgid "Return to duty."
msgstr ""

#. ja: パーティから離脱しますが、よろしいですか？
#. de: Willst du die Gruppe wirklich verlassen?
#. fr: Abandonner la mission en cours et quitter l'équipe<nbsp>?
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_RETURN_ME_MENU_TITLE:1"
msgid "You will be removed from your party. Proceed?"
msgstr ""

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_RETURN_ME_MENU_YES:1"
msgid "Yes"
msgstr ""

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_RETURN_ME_MENU_NO:1"
msgid "No"
msgstr ""

#. ja: コンテンツから退出します。<br>よろしいですか？
#. de: Wollt ihr die Instanz wirklich verlassen?
#. fr: Quitter la mission en cours<nbsp>?
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_RETURN_PARTY_MENU_TITLE:1"
msgid "Abandon current duty?"
msgstr ""

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_RETURN_PARTY_MENU_YES:1"
msgid "Yes"
msgstr ""

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_RETURN_PARTY_MENU_NO:1"
msgid "No"
msgstr ""

#. ja: 本当に「<string $gs56>」から退出しますか？
#. de: Willst du „<string $gs56>“ wirklich verlassen?
#. fr: Confirmer<nbsp>?
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_RETURN_CONFIRM_MENU_TITLE:1"
msgid "Are you certain?"
msgstr ""

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_RETURN_CONFIRM_MENU_YES:1"
msgid "Absolutely"
msgstr ""

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_RETURN_CONFIRM_MENU_NO:1"
msgid "No"
msgstr ""

#. ja: 全員が特務隊長から報酬を受け取る、<br>もしくは一定時間が経過すると<br>ギルドオーダーが終了し帰還します。
#. de: Ihr verlasst die Instanz, sobald alle Mitglieder ihre Vergütung vom Kommandanten abgeholt haben oder eine bestimmte Zeit verstrichen ist.
#. fr: L'opération de guilde est à présent terminée. Vous sortirez de l'instance une fois toutes les récompenses reçues ou après un certain délai.
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_RET_SUCCESS_SYSTEM_TALK_00:1"
msgid "You will leave the instance once all party members have collected their rewards."
msgstr ""

#. ja: （★未使用／削除予定★）
#. de: Du konntest die Vergütung nicht aufnehmen, weil dein Inventar voll ist. Schaff etwas Platz und sprich den Zuständigen noch einmal an.
#. fr: （★未使用／削除予定★）
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_RET_FAIL_SYSTEM_TALK_00:1"
msgid "Make room in your inventory and speak with the battlewarden once again to receive your reward."
msgstr ""

#. ja: ひとりで先に帰りますか？
#. de: Willst du allein zurückkehren?
#. fr: Sortir de l'instance individuellement<nbsp>?
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_AFTER_RWD_MENU_TITLE:1"
msgid "Leave without your party?"
msgstr ""

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_AFTER_RWD_MENU_YES:1"
msgid "Yes"
msgstr ""

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_AFTER_RWD_MENU_NO:1"
msgid "No"
msgstr ""

#. ja: パーティから離脱しますが、よろしいですか？
#. de: Willst du die Gruppe wirklich verlassen?
#. fr: Vous devrez quitter l'équipe. Confirmer<nbsp>?
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_AFTER_RWD_RETURN_MENU_TITLE:1"
msgid "You will be removed from the party. Proceed?"
msgstr ""

#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_AFTER_RWD_RETURN_MENU_YES:1"
msgid "Yes"
msgstr ""

#. ja: いいえ
#. de: Nein
#. fr: Non
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_AFTER_RWD_RETURN_MENU_NO:1"
msgid "No"
msgstr ""

#. ja: 現在のクラス・ジョブで初めて達成したため、ボーナスがつき、<br>報酬が追加されます。
#. de: Weil du das Gildengeheiß in deiner momentanen Klasse (Job) zum ersten Mal geschafft hast, wurde deiner Vergütung ein Bonus hinzugefügt.
#. fr: Cette opération ayant été accomplie pour la première fois avec votre classe/job actuel, un bonus vous est octroyé.
#. macro: <if ($gn68 == 10)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 14)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 5)>an <sheet ClassJob $gn68 0><else><if ($gn… — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 68 (the player's current class or job, a ClassJob row) == 10 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ClassJob $gn68 0> — a value from a game data sheet, such as a name; sheet = ClassJob, row = global number 68 (the player's current class or job, a ClassJob row), column = 0 (game data: keep it; it may move or repeat)
#. macro: <if ($gn68 == 14)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 5)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 26)>an <sheet ClassJob $gn68 0><else><if ($gn… — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 68 (the player's current class or job, a ClassJob row) == 14 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gn68 == 5)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 26)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 33)>an <sheet ClassJob $gn68 0><else>a <sheet… — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 68 (the player's current class or job, a ClassJob row) == 5 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gn68 == 26)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 33)>an <sheet ClassJob $gn68 0><else>a <sheet ClassJob $gn68 0></if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 68 (the player's current class or job, a ClassJob row) == 26 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gn68 == 33)>an <sheet ClassJob $gn68 0><else>a <sheet ClassJob $gn68 0></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 68 (the player's current class or job, a ClassJob row) == 33 (condition: may be reworded, restructured, added, or dropped)
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_FIRST_BONUS_SYSTEM_TALK_00:1"
msgid "A bonus has been added to your reward for completing the hest as <if ($gn68 == 10)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 14)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 5)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 26)>an <sheet ClassJob $gn68 0><else><if ($gn68 == 33)>an <sheet ClassJob $gn68 0><else>a <sheet ClassJob $gn68 0></if></if></if></if></if> for the first time."
msgstr ""

#. ja: <if $n1>また、</if><switch $n2><case>パーティメンバーの戦闘不能回数が少なかったため、<br><if $n1>更に</if>ボーナスがつき、報酬が追加されます。<case>パーティメンバーが戦闘不能にならなかったため<br><if $n1>更に</if>ボーナスがつき、報酬が追加されます。</switch>
#. de: <if $n1>Ein weiterer<else>Ein</if> Bonus wurde hinzugefügt, weil deine Gruppe die Operation abgeschlossen hat und <switch $n2><case>kaum jemand kampfunfähig wurde<case>kein einziges Mal jemand kampfunfähig wurde</switch>.
#. fr: <if $n1>Par ailleurs, un autre<else>Un</if> bonus vous est accordé car les membres de l'équipe <switch $n2><case>ont été mis K.O. peu de fois<case>n'ont pas été mis K.O. une seule fois</switch>.
#. macro: <if $n1>An additional<else>A</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 1 (condition: may be reworded, restructured, added, or dropped)
#. macro: <switch $n2><case>with a minimal number of KOs<case>without suffering a single KO</switch> — shows the case whose position equals the value: the first <case> for 1, the second for 2, …; value = number parameter 2 (condition: may be reworded, restructured, added, or dropped)
msgctxt "guild_order/GuildOrderOfficer:TEXT_GUILDORDEROFFICER_FIRST_BONUS_SYSTEM_TALK_01:1"
msgid "<if $n1>An additional<else>A</if> bonus has been added for your party completing the operation <switch $n2><case>with a minimal number of KOs<case>without suffering a single KO</switch>."
msgstr ""
