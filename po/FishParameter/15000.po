# FishParameter
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 水中で豪奢なヒレが揺らめいた！
#. de: Eine prachtvolle Flosse zeigt sich an der Wasseroberfläche!
#. fr: De magnifiques nageoires remuent dans l'eau !
#. column 2: The fin fades from view...
#. column 3: You reel in the majestic fin and its unamused owner!
msgctxt "FishParameter:15306:0:1"
msgid "A magnificent fin breaches the water's surface!"
msgstr "Над поверхностью воды мелькнул великолепный плавник!"

#. ja: 豪奢なヒレを見失ってしまった……。
#. de: Die prachtvolle Flosse ist verschwunden ...
#. fr: Les magnifiques nageoires s'en sont allées...
#. column 1: A magnificent fin breaches the water's surface!
#. column 3: You reel in the majestic fin and its unamused owner!
msgctxt "FishParameter:15306:0:2"
msgid "The fin fades from view..."
msgstr "Плавник исчез из виду..."

#. ja: 豪奢なヒレの持ち主を釣り上げた！
#. de: Du ziehst deinen Fang an Land!
#. fr: Vous avez pêché les magnifiques nageoires !
#. column 1: A magnificent fin breaches the water's surface!
#. column 2: The fin fades from view...
msgctxt "FishParameter:15306:0:3"
msgid "You reel in the majestic fin and its unamused owner!"
msgstr "Ты вытащил величественный плавник вместе с его недовольным хозяином!"

#. ja: 水中に高速で泳ぐ魚影がよぎった！
#. de: Ein unglaublich schneller Schatten huscht durch das Wasser!
#. fr: Une ombre file rapidement sous l'eau !
#. column 2: The blindingly fast creature disappears in an instant...
#. column 3: You reel in the blindingly fast creature!
msgctxt "FishParameter:15333:0:1"
msgid "A blindingly fast form scythes through the water!"
msgstr "В воде молниеносно промелькнул силуэт!"

#. ja: 高速で泳ぐ魚影を見失ってしまった……。
#. de: Der unglaublich schnelle Schatten ist verschwunden ...
#. fr: L'ombre rapide a disparu...
#. column 1: A blindingly fast form scythes through the water!
#. column 3: You reel in the blindingly fast creature!
msgctxt "FishParameter:15333:0:2"
msgid "The blindingly fast creature disappears in an instant..."
msgstr "Молниеносное создание исчезло в мгновение ока..."

#. ja: 高速で泳ぐ魚影を釣り上げた！
#. de: Du ziehst deinen Fang an Land!
#. fr: Vous avez pêché l'ombre rapide !
#. column 1: A blindingly fast form scythes through the water!
#. column 2: The blindingly fast creature disappears in an instant...
msgctxt "FishParameter:15333:0:3"
msgid "You reel in the blindingly fast creature!"
msgstr "Ты вытащил молниеносное создание!"

#. ja: 鋭い角が魔泉から飛び出した！
#. de: Ein messerscharfes Horn lugt aus dem Wasser hervor!
#. fr: Une corne pointue jaillit de la fuite magismologique !
#. column 2: The horn retreats into the depths...
#. column 3: You reel in the razor-sharp horn and its perturbed owner!
msgctxt "FishParameter:15403:0:1"
msgid "A razor-sharp horn pierces the pool's surface!"
msgstr "Из воды показался острый как бритва рог!"

#. ja: 鋭い角を見失ってしまった……。
#. de: Das messerscharfe Horn ist verschwunden ...
#. fr: Vous avez perdu de vue la corne pointue...
#. column 1: A razor-sharp horn pierces the pool's surface!
#. column 3: You reel in the razor-sharp horn and its perturbed owner!
msgctxt "FishParameter:15403:0:2"
msgid "The horn retreats into the depths..."
msgstr "Рог скрылся в глубине..."

#. ja: 鋭い角の持ち主を釣り上げた！
#. de: Du ziehst deinen Fang an Land!
#. fr: Vous avez pêché la corne pointue !
#. column 1: A razor-sharp horn pierces the pool's surface!
#. column 2: The horn retreats into the depths...
msgctxt "FishParameter:15403:0:3"
msgid "You reel in the razor-sharp horn and its perturbed owner!"
msgstr "Ты вытащил острый как бритва рог вместе с его встревоженным хозяином!"

#. ja: 水中で水晶の塊が蠢いた！
#. de: Du glaubst, einen Kristall im Wasser schwimmen zu sehen!
#. fr: Un morceau de cristal se déplace dans l'eau !
#. column 2: The mass of crystal winks away...
#. column 3: You reel in the mass of crystal!
msgctxt "FishParameter:15595:0:1"
msgid "A mass of crystal wriggles in the water!"
msgstr "В воде извивается кристаллическая глыба!"

#. ja: 水晶の塊を見失ってしまった……。
#. de: Der Kristall ist verschwunden ...
#. fr: Vous avez perdu de vue le morceau de cristal...
#. column 1: A mass of crystal wriggles in the water!
#. column 3: You reel in the mass of crystal!
msgctxt "FishParameter:15595:0:2"
msgid "The mass of crystal winks away..."
msgstr "Кристаллическая глыба растворилась в воде..."

#. ja: 水晶の塊の持ち主を釣り上げた！
#. de: Du ziehst deinen Fang an Land!
#. fr: Vous avez pêché le propriétaire du morceau de cristal !
#. column 1: A mass of crystal wriggles in the water!
#. column 2: The mass of crystal winks away...
msgctxt "FishParameter:15595:0:3"
msgid "You reel in the mass of crystal!"
msgstr "Ты вытащил кристаллическую глыбу!"

#. ja: 水中を角笛のような影がよぎった！
#. de: Ein Schatten, der aussieht wie ein Horn, fegt durch das Wasser!
#. fr: Une ombre en forme de corne se déplace dans l'eau !
#. column 2: The dark horn slips away...
#. column 3: You reel in the dark horn!
msgctxt "FishParameter:15600:0:1"
msgid "A dark horn darts in the water!"
msgstr "В воде мелькнул тёмный рог!"

#. ja: 角笛のような影を見失ってしまった……。
#. de: Das Horn ist nirgendwo mehr zu sehen ...
#. fr: Vous avez perdu de vue l'ombre en forme de corne...
#. column 1: A dark horn darts in the water!
#. column 3: You reel in the dark horn!
msgctxt "FishParameter:15600:0:2"
msgid "The dark horn slips away..."
msgstr "Тёмный рог ускользнул..."

#. ja: 角笛のような姿の存在を釣り上げた！
#. de: Du ziehst deinen Fang an Land!
#. fr: Vous avez pêché la créature en forme de corne !
#. column 1: A dark horn darts in the water!
#. column 2: The dark horn slips away...
msgctxt "FishParameter:15600:0:3"
msgid "You reel in the dark horn!"
msgstr "Ты вытащил тёмный рог!"

#. ja: 水中を神々しい影がよぎった！
#. de: Ein göttlicher Schatten schießt durch das Wasser!
#. fr: Une ombre divine se déplace dans l'eau !
#. column 2: The ethereal image vanishes...
#. column 3: You reel in the ethereal image!
msgctxt "FishParameter:15652:0:1"
msgid "An ethereal image appears in the water!"
msgstr "В воде появилось неземное видение!"

#. ja: 神々しい影を見失ってしまった……。
#. de: Der göttliche Schatten ist verschwunden ...
#. fr: Vous avez perdu de vue l'ombre divine...
#. column 1: An ethereal image appears in the water!
#. column 3: You reel in the ethereal image!
msgctxt "FishParameter:15652:0:2"
msgid "The ethereal image vanishes..."
msgstr "Неземное видение исчезло..."

#. ja: 神々しい存在を釣り上げた！
#. de: Du ziehst deinen Fang an Land!
#. fr: Vous avez pêché la créature divine !
#. column 1: An ethereal image appears in the water!
#. column 2: The ethereal image vanishes...
msgctxt "FishParameter:15652:0:3"
msgid "You reel in the ethereal image!"
msgstr "Ты вытащил неземное видение!"

#. ja: 水中に巨大な槍のような影がよぎった！
#. de: Ein Schatten, der aussieht wie ein Speer, fegt durch das Wasser!
#. fr: Une énorme ombre en forme de lance se déplace dans l'eau !
#. column 2: The sharp silhouette slinks out of sight...
#. column 3: You reel in the sharp silhouette!
msgctxt "FishParameter:15791:0:1"
msgid "You spot a sharp silhouette in the water!"
msgstr "В воде мелькнул острый силуэт!"

#. ja: 槍のような影を見失ってしまった……。
#. de: Das Speer-Wesen ist nirgendwo mehr zu sehen ...
#. fr: Vous avez perdu de vue l'ombre en forme de lance...
#. column 1: You spot a sharp silhouette in the water!
#. column 3: You reel in the sharp silhouette!
msgctxt "FishParameter:15791:0:2"
msgid "The sharp silhouette slinks out of sight..."
msgstr "Острый силуэт скрылся из виду..."

#. ja: 槍のような姿の存在を釣り上げた！
#. de: Du ziehst deinen Fang an Land!
#. fr: Vous avez pêché la créature en forme de lance !
#. column 1: You spot a sharp silhouette in the water!
#. column 2: The sharp silhouette slinks out of sight...
msgctxt "FishParameter:15791:0:3"
msgid "You reel in the sharp silhouette!"
msgstr "Ты вытащил острый силуэт!"

#. ja: 海中を刃物のような煌きがよぎった！
#. de: Ein Funkeln, wie von einer Klinge in der Sonne, fegt durch das Wasser!
#. fr: Une lueur semblable à celle d'une lame se déplace dans l'eau !
#. column 2: The knifelike form scythes away...
#. column 3: You reel in the knifelike form!
msgctxt "FishParameter:15808:0:1"
msgid "A knifelike form glints near the surface!"
msgstr "У поверхности сверкнуло нечто, похожее на клинок!"

#. ja: 刃物のような煌きは消えてしまった……。
#. de: Das Klingen-Wesen ist nirgendwo mehr zu sehen ...
#. fr: Vous avez perdu de vue la lueur semblable à celle d'une lame...
#. column 1: A knifelike form glints near the surface!
#. column 3: You reel in the knifelike form!
msgctxt "FishParameter:15808:0:2"
msgid "The knifelike form scythes away..."
msgstr "Форма клинка стремительно скрылась..."

#. ja: 刃物のような煌きの源を釣り上げた！
#. de: Du ziehst deinen Fang an Land!
#. fr: Vous avez pêché la créature à l'origine de la lueur semblable à celle d'une lame !
#. column 1: A knifelike form glints near the surface!
#. column 2: The knifelike form scythes away...
msgctxt "FishParameter:15808:0:3"
msgid "You reel in the knifelike form!"
msgstr "Ты вытащил источник клинковидного блеска!"

#. ja: 水中を矢尻のような影がよぎった！
#. de: Ein Schatten, der aussieht wie eine Pfeilspitze, fegt durch das Wasser!
#. fr: Une ombre en forme de pointe de flèche se déplace dans l'eau !
#. column 2: The pointed shadow fades from view...
#. column 3: You reel in the pointed shadow!
msgctxt "FishParameter:15837:0:1"
msgid "A pointed shadow shimmers in the water!"
msgstr "В воде мерцает заострённая тень!"

#. ja: 矢尻のような影を見失ってしまった……。
#. de: Der Schatten ist nirgendwo mehr zu sehen ...
#. fr: Vous avez perdu de vue l'ombre en forme de pointe de flèche...
#. column 1: A pointed shadow shimmers in the water!
#. column 3: You reel in the pointed shadow!
msgctxt "FishParameter:15837:0:2"
msgid "The pointed shadow fades from view..."
msgstr "Заострённая тень исчезла из виду..."

#. ja: 矢尻のような姿の存在を釣り上げた！
#. de: Du ziehst deinen Fang an Land!
#. fr: Vous avez pêché la créature en forme de pointe de flèche !
#. column 1: A pointed shadow shimmers in the water!
#. column 2: The pointed shadow fades from view...
msgctxt "FishParameter:15837:0:3"
msgid "You reel in the pointed shadow!"
msgstr "Ты вытащил заострённую тень!"

#. ja: 水底の水影のようなものが揺らめいた！
#. de: Eine dunkler Schatten huscht über den Grund des Gewässers!
#. fr: Une ombre aqueuse s'agite au fond de l'eau !
#. column 2: The fluid shadow fades from view...
#. column 3: You reel in the source of the shadow!
msgctxt "FishParameter:15942:0:1"
msgid "A fluid shadow flits through the water!"
msgstr "В воде мелькнула текучая тень!"

#. ja: 水影のようなものを見失ってしまった……。
#. de: Der dunkle Schatten ist verschwunden ...
#. fr: Vous avez perdu de vue l'ombre aqueuse...
#. column 1: A fluid shadow flits through the water!
#. column 3: You reel in the source of the shadow!
msgctxt "FishParameter:15942:0:2"
msgid "The fluid shadow fades from view..."
msgstr "Текучая тень исчезла из виду..."

#. ja: 水影のようなものを釣り上げた！
#. de: Du siehst den dunklen Schatten erneut im Wasser!
#. fr: Vous avez pêché l'ombre aqueuse !
#. column 1: A fluid shadow flits through the water!
#. column 2: The fluid shadow fades from view...
msgctxt "FishParameter:15942:0:3"
msgid "You reel in the source of the shadow!"
msgstr "Ты вытащил источник тени!"
