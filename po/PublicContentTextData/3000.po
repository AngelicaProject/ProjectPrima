msgid "Clear the Epistemology Theater"
msgstr ""

#. ja: 敵対行動を感知しました。<br>排除機構、起動……。
#. de: Feindliche Aktivitäten erkannt. Vernichtungsfunktionen aktiviert<nbsp>...
#. fr: Activité ennemie détectée.<br>Démarrage du processus d'élimination...
msgctxt "PublicContentTextData:3207:0:0"
msgid "Enemy activity detected. Initiating eradication..."
msgstr ""

#. ja: 攻撃対象の設定を完了しました。<br>アストラル体、生成……。
#. de: Angriffsareal festgelegt. Erschaffe Astralkörper<nbsp>...
#. fr: Cible verrouillée.<br>Génération de l'alignement astral...
msgctxt "PublicContentTextData:3208:0:0"
msgid "Target acquired. Effecting astral realignment..."
msgstr ""

#. ja: アストラル体「スマッシャー」起動。<br>速やかな排除を。
#. de: Astralkörper „Schmetterer“ aktiviert. Leite Vernichtung ein.
#. fr: Forme “écraseur” activée.<br>Élimination imminente.
msgctxt "PublicContentTextData:3209:0:0"
msgid "Scale-smasher form activated. Eradication imminent."
msgstr ""

#. ja: 回転指令、入力。<br>対象の物理的排除を試みます。
#. de: Rotationsbefehl erhalten. Beseitige Ziele mit physischen Angriffen.
#. fr: Instruction de rotation reçue.<br>Tentative d'élimination physique.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "PublicContentTextData:3210:0:0"
msgid "Rotational command received.<br>Attempting physical onslaught."
msgstr ""

#. ja: 回転指令、再入力。<br>徹底した排除を期待します。
#. de: Erneuter Rotationsbefehl erhalten. Erwarte restlose Vernichtung.
#. fr: Nouvelle instruction de rotation.<br>Annihilation totale envisagée.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "PublicContentTextData:3211:0:0"
msgid "Additional rotational command received.<br>Prepare for total annihilation."
msgstr ""

#. ja: 侵入者を検知しました。<br>広域排除魔法、起動……。
#. de: Eindringlinge erfasst. Aktiviere großflächige Beseitigungsmagie<nbsp>...
#. fr: Présence d'intrus détectée.<br>Activation des mesures magiques radicales...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "PublicContentTextData:3212:0:0"
msgid "Intruders detected.<br>Preparing magical countermeasures."
msgstr ""

#. ja: 制限時間内に、<br>時計盤を「正しく」操作してください。
#. de: Abbruch nur durch Einstellung der korrekten Uhrzeit möglich. Zeitlimit gestartet.
#. fr: Ajustez cor<shy>rec<shy>te<shy>ment le cadran avant la fin du temps imparti.
msgctxt "PublicContentTextData:3213:0:0"
msgid "Set the correct time before the countdown ends."
msgstr ""

#. ja: 操作受付、終了まで　120　秒！
#. de: Einstellung der Uhrzeit noch für 120 Sekunden möglich!
#. fr: 120 secondes avant la fin du compte à rebours.
msgctxt "PublicContentTextData:3214:0:0"
msgid "Countdown ends in 120 seconds..."
msgstr ""

#. ja: 操作受付、終了まで　60　秒！
#. de: Einstellung der Uhrzeit noch für 60 Sekunden möglich!
#. fr: 60 secondes avant la fin du compte à rebours.
msgctxt "PublicContentTextData:3215:0:0"
msgid "Countdown ends in 60 seconds..."
msgstr ""

#. ja: 操作受付、終了まで　30　秒！
#. de: Einstellung der Uhrzeit noch für 30 Sekunden möglich!
#. fr: 30 secondes avant la fin du compte à rebours.
msgctxt "PublicContentTextData:3216:0:0"
msgid "Countdown ends in 30 seconds..."
msgstr ""

#. ja: 操作受付、終了まで　10　秒！
#. de: Einstellung der Uhrzeit noch für 10 Sekunden möglich!
#. fr: 10 secondes avant la fin du compte à rebours<nbsp>!
msgctxt "PublicContentTextData:3217:0:0"
msgid "Countdown ends in 10 seconds!"
msgstr ""

#. ja: 操作受付、終了まで　5　秒！
#. de: Einstellung der Uhrzeit noch für 5 Sekunden möglich!
#. fr: 5 secondes...
msgctxt "PublicContentTextData:3218:0:0"
msgid "5..."
msgstr ""

#. ja: 操作受付、終了まで　4　秒！
#. de: Einstellung der Uhrzeit noch für 4 Sekunden möglich!
#. fr: 4...
msgctxt "PublicContentTextData:3219:0:0"
msgid "4..."
msgstr ""

#. ja: 操作受付、終了まで　3　秒！
#. de: Einstellung der Uhrzeit noch für 3 Sekunden möglich!
#. fr: 3...
msgctxt "PublicContentTextData:3220:0:0"
msgid "3..."
msgstr ""

#. ja: 操作受付、終了まで　2　秒！
#. de: Einstellung der Uhrzeit noch für 2 Sekunden möglich!
#. fr: 2...
msgctxt "PublicContentTextData:3221:0:0"
msgid "2..."
msgstr ""

#. ja: 操作受付、終了まで　1　秒！
#. de: Einstellung der Uhrzeit noch für 1 Sekunde möglich!
#. fr: 1...
msgctxt "PublicContentTextData:3222:0:0"
msgid "1..."
msgstr ""

#. ja: 操作受付、終了……<br>これより正誤判定に移行します。
#. de: Freischaltcode-Überprüfung wird gestartet.
#. fr: 操作受付、終了……<br>これより正誤判定に移行します。
#. macro: <br> — a line break (may be added or dropped)
msgctxt "PublicContentTextData:3223:0:0"
msgid "操作受付、終了……<br>これより正誤判定に移行します。"
msgstr ""

#. ja: 判定……時計盤が正しく入力されていることを確認いたしました。<br>広域排除魔法、実行中断……。
#. de: Überprüfe Uhrzeit<nbsp>... Korrekte Uhrzeit erkannt. Großflächige Beseitigungsmagie wird unterbrochen<nbsp>...
#. fr: Évaluation... Ajustement conforme confirmé.<br>Désactivation des mesures magiques radicales...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "PublicContentTextData:3224:0:0"
msgid "Correct time confirmed.<br>Magical countermeasures disabled..."
msgstr ""

#. ja: 時魔法により、樹木の成長を加速……。<br>侵入者を次の防衛区画に誘導します。
#. de: Beschleunige Wachstum umliegender Bäume. Gewähre Eindringlingen Zutritt auf nächsten Sektor.
#. fr: Accélération de la pousse par magie temporelle...<br>Accès au secteur suivant autorisé.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "PublicContentTextData:3225:0:0"
msgid "Stimulating arboreal growth...<br>Intruders may advance to the next sector."
msgstr ""

#. ja: 解除コード、エラー……。<br>再度、認証を開始してください。
#. de: Error! Freischaltcode-Überprüfung fehlgeschlagen<nbsp>... Bitte versucht es erneut.
#. fr: 解除コード、エラー……。<br>再度、認証を開始してください。
#. macro: <br> — a line break (may be added or dropped)
msgctxt "PublicContentTextData:3226:0:0"
msgid "解除コード、エラー……。<br>再度、認証を開始してください。"
msgstr ""

#. ja: 認証制限は、残り 2回です。
#. de: Verbleibende Freischaltversuche: 2
#. fr: 認証制限は、残り 2回です。
msgctxt "PublicContentTextData:3227:0:0"
msgid "認証制限は、残り 2回です。"
msgstr ""

#. ja: 認証制限は、残り 1回です。
#. de: Verbleibende Freischaltversuche: 1
#. fr: 認証制限は、残り 1回です。
msgctxt "PublicContentTextData:3228:0:0"
msgid "認証制限は、残り 1回です。"
msgstr ""

#. ja: 操作受付、終了……入力内容を不正解と判定。<br>これより、広域排除魔法を実行します。
#. de: Überprüfe Uhrzeit<nbsp>... Inkorrekte Eingabe. Großflächige Beseitigungsmagie wird eingesetzt<nbsp>...
#. fr: Évaluation... Ajustement non conforme.<br>Exécution des mesures magiques radicales.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "PublicContentTextData:3229:0:0"
msgid "Incorrect time detected.<br>Executing magical countermeasures."
msgstr ""

#. ja: 時魔法リターン、展開。<br>侵入者のみなさま、おつかれさまでした。
#. de: Aktiviere Zeitmagie „Zurück“. Danke für euren Besuch, Eindringlinge.
#. fr: Lancement du sort de magie temporelle Reprise...<br>Chers intrus, merci pour votre tentative d'intrusion.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "PublicContentTextData:3230:0:0"
msgid "Activating temporal magicks.<br>Intruders are thanked for their participation."
msgstr ""

#. ja: オッ、オッ……<br>オヤサイ、タベ、タベ……。
#. de: G<nbsp>... G...<nbsp>... GeMüÜüSe<nbsp>... E-EsSen<nbsp>...
#. fr: Je... Je VeUx DeS lÉgUmEs...
msgctxt "PublicContentTextData:3231:0:0"
msgid "M-Must have...more v-vegetables..."
msgstr ""

#. ja: キメタ……オマエ、タベル……。
#. de: eSsEn<nbsp>... Du BisT<nbsp>... mEiN nÄcHsTeS eSsEn<nbsp>...
#. fr: MiAm MiAm... C'eSt DéCidÉ, c'EsT tOi QuE jE vAiS mAnGeR...
msgctxt "PublicContentTextData:3232:0:0"
msgid "Y-You will be...my next...meal..."
msgstr ""

#. ja: ハラデ、トカシテ……<br>ノロイヲ、カエス……！
#. de: ScHmElZeN<nbsp>... iN mEiNeM mAgEn<nbsp>... WiRd ZuM fLuCh<nbsp>...
#. fr: Je VaIs Te DiGéReR... Et ReCrAcHeR uN mAuVaIs SoRt !
msgctxt "PublicContentTextData:3233:0:0"
msgid "V-Vegetables in my belly... They p-power the curse!"
msgstr ""

#. ja: オッ、オッ……オマエモ、タベル……！
#. de: D<nbsp>... D<nbsp>... Du BiSt AlS nÄcHsTeS dRaN<nbsp>...
#. fr: Je VaIs Te MaNgEr... Te MaNgEr !
msgctxt "PublicContentTextData:3234:0:0"
msgid "Y-You're next..."
msgstr ""

#. ja: マダ、マダ、タリナイ……。
#. de: MeHr<nbsp>... ImMeR nOcH hUnGrIg<nbsp>...
#. fr: PaS aSsEz... Je N'aI pAs AsSeZ mAnGé !
msgctxt "PublicContentTextData:3235:0:0"
msgid "S-Still so...hungry..."
msgstr ""

#. ja: オヤサイ、マダ、タクサン……<br>ブフフ、フフフフフ……。
#. de: GeMüSe<nbsp>... So ViEl GeMüSe<nbsp>... Guhuhuhu<nbsp>...
#. fr: EnCoRe DeS lÉgUmEs... PlEiN dE lÉgUmEs... GnÉhÉ, gNéHéHéHé...
msgctxt "PublicContentTextData:3236:0:0"
msgid "S-So many v-vegetables... Guhuhu..."
msgstr ""

#. ja: ガ、ガ、ガマン、デキナイイ……マトメテ、タベルウウウウ！
#. de: I<nbsp>... I<nbsp>... IcH hAlTe Es NiChT mEhR aUs<nbsp>... AlLeS aUf EiNmAaAaAal!
#. fr: PeUx PlUs... Me ReTeNiR... jE vAiS tOuS vOuS aVaLeR d'Un CoUp !
msgctxt "PublicContentTextData:3237:0:0"
msgid "I-I cannot resist... The feast...c-continues!"
msgstr ""

#. ja: グチャグチャ、グチャ……。
#. de: MaMpF, mAmPf<nbsp>... MaMpF<nbsp>...
#. fr: MiOm, MiOm... MiOm...
msgctxt "PublicContentTextData:3238:0:0"
msgid "Om nom nom..."
msgstr ""

#. ja: タクサン、タベタ……<br>タクサン、ノロイ、カエス……！
#. de: So ViEl GeGeSsEn<nbsp>...! So ViElE fLüChE<nbsp>...!
#. fr: J'aI bIeN mAnGé... Je VaIs ReCrAcHeR pLeIn De MaUvAiS sOrTs !
msgctxt "PublicContentTextData:3239:0:0"
msgid "M-My belly is full... The curse g-grows stronger!"
msgstr ""

#. ja: ウグッ……オグッ……。
#. de: UrGh<nbsp>... OrGh<nbsp>...
#. fr: UrGh... OuRgH...
msgctxt "PublicContentTextData:3240:0:0"
msgid "U-Urgh... Ooogh..."
msgstr ""

#. ja: マ、マ、マタ……ハラ、ヘッタ……。
#. de: M<nbsp>... M<nbsp>... MeIn MaGeN iSt ScHoN wIeDeR lEer<nbsp>...
#. fr: J... j'Ai EnCoRe FaIm...
msgctxt "PublicContentTextData:3241:0:0"
msgid "M-My belly r-rumbles..."
msgstr ""

#. ja: モット……モット、タベル……！
#. de: MeHr<nbsp>... MeHr EsSeN<nbsp>...!
#. fr: MaNgEr PlUs... EnCoRe PlUs !
msgctxt "PublicContentTextData:3242:0:0"
msgid "M-More, more, more!"
msgstr ""

#. ja: 禁忌ノ魔法……守ル……見セル……？
#. de: Verbotenes Wissen<nbsp>... muss<nbsp>... beschützt werden<nbsp>...
#. fr: Les sorts interdits... doivent être protégés... montrés ?
msgctxt "PublicContentTextData:3243:0:0"
msgid "Forbidden wisdom... It must be protected..."
msgstr ""

#. ja: 効果ハンイ、近域ニ限定……<br>対・知識水準魔法、実行……。
#. de: Wir<shy>kungs<shy>be<shy>reich<nbsp>... auf nahe Umgebung beschränkt<nbsp>... Aktiviere Anti-Wissensstandmagie<nbsp>...
#. fr: Aire d'effet restreinte à une zone de proximité... Sort basé sur le niveau de savoir de la cible... Incantation en cours...
msgctxt "PublicContentTextData:3244:0:0"
msgid "Activating limited-scale anti-comprehension magicks..."
msgstr ""

#. ja: 対・知識水準魔法、実行、実行……。
#. de: Aktiviere Anti-Wissensstandmagie<nbsp>...
#. fr: Sort basé sur le niveau de savoir de la cible en cours d'incantation...
msgctxt "PublicContentTextData:3245:0:0"
msgid "Activating anti-comprehension magicks..."
msgstr ""

#. ja: スベテハ、知識ノ多寡シダイ……。
#. de: Der Betrag des Wissens<nbsp>... entscheidet alles<nbsp>...
#. fr: Tout est gouverné par le calcul du savoir...
msgctxt "PublicContentTextData:3246:0:0"
msgid "Knowledge predicates all possibilities..."
msgstr ""

#. ja: 知の宝庫に足を踏み入れし者どもよ。<br>古の技を知るがいい……！
#. de: Ihr, die ihr die Krone des Wissens betreten habt. Bestaunt die Kunst der Antike<nbsp>...!
#. fr: Comment osez-vous violer ce trésor de la con<shy>nais<shy>san<shy>ce...<nbsp>? Le savoir ancien aura raison de vous<nbsp>!
msgctxt "PublicContentTextData:3247:0:0"
msgid "You who breach this bastion of knowledge... Behold the ancient arts in all their glory!"
msgstr ""

#. ja: 水晶の内にまどろむ記憶、<br>我が身に宿り力とならん……！
#. de: Schlummernde Erinnerungen! Erfüllt meinen Körper mit eurer Macht<nbsp>...!
#. fr: Ô souvenirs sommeillant dans le cristal... Emplissez mon corps de votre pouvoir<nbsp>!
msgctxt "PublicContentTextData:3248:0:0"
msgid "Dormant memories, fill this form with might untrammeled!"
msgstr ""

#. ja: これぞ魔の真髄……<br>属性元素の交響を見せてやろうぞ！
#. de: Magie in ihrer reinsten Form<nbsp>...! Ergötzt euch am Zusammenspiel der Elemente!
#. fr: La magie dans sa forme la plus pure... Soyez entraînés dans la spirale fatale des éléments<nbsp>!
msgctxt "PublicContentTextData:3249:0:0"
msgid "Magic in its purest form... Watch as the very elements dance!"
msgstr ""

#. ja: 元素よ、集え……そして弾けるがいい！
#. de: O Elemente, versammelt euch<nbsp>...! Zerberstet wie euch beliebt!
#. fr: La fusion des éléments... jusqu'à l'éclatement<nbsp>!
msgctxt "PublicContentTextData:3250:0:0"
msgid "Elements, coalesce... Now rupture!"
msgstr ""

#. ja: 我は潰えぬ……<br>継がれし技の、先を見るまでは……！
#. de: Auf ewig werde ich bestehen<nbsp>...! Die Zukunft dieses Wissens <i>muss</i> ergründet werden<nbsp>...!
#. fr: Je n'abdiquerai pas... Pas avant d'avoir contemplé l'au-delà des frontières du savoir<nbsp>!
msgctxt "PublicContentTextData:3251:0:0"
msgid "I will not relent... Not until the true potential of this wisdom is unleashed!"
msgstr ""

#. ja: それだけの知見がありながら、<br>この技の素晴らしさがわからぬのか……！？
#. de: Selbst gesegnet mit Wissen ähnlich dem meinen sucht ihr dennoch, es zu versiegeln<nbsp>...?!
#. fr: Malgré le savoir acquis... la magnificience de cette magie vous dépasse encore<nbsp>!?
msgctxt "PublicContentTextData:3252:0:0"
msgid "Despite all the knowledge you have acquired, you would still deny the world this wisdom!?"
msgstr ""

#. ja: 敵性存在、カクニン！<br>集合、シュウゴウ、ヤッツケロ！
#. de: FeInDe GeSiChTeT! aLlE zUsAmMeN aUf KaMpFpOsItIoN!
