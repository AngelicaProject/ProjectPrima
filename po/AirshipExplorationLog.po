msgid "<ui-color 500><ui-edge-color 501><if ($n2 == 1)><capitalize><noun-en Item 3 $n1 1 1></capitalize><else><num $n2> <noun-en Item 3 $n1 3 1></if> retrieved!</ui-edge-color></ui-color>"
