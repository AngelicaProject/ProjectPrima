msgctxt "LogMessage:10972:0:5"
msgid "The knowledge crystal resonates with <if ($gs1 == $gs2)>your<else><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if>'s</if> phantom action!"
