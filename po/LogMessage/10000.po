msgctxt "LogMessage:10883:0:5"
msgid "<capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>obtain<else>obtains</if> <if ($n2 == 1)><noun-en Item 1 $n1 1 1><else><num $n2> <noun-en Item 3 $n1 $n2 1></if>."
msgstr "<capitalize><if ($gs1 == $gs2)>Вы получаете<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> получает</if></capitalize> <if ($n2 == 1)><noun-en Item 1 $n1 1 1><else><num $n2> <noun-en Item 3 $n1 $n2 1></if>."

#. ja: 緊急状況が発生しました。
#. de: Alarmstufe Rot wurde ausgerufen.
#. fr: Une alerte rouge vient d'être lancée.
msgctxt "LogMessage:10884:0:5"
msgid "A red alert has been issued."
msgstr "Объявлена красная тревога."

#. ja: 受注条件を満たしていないため、コスモミッションを受注できませんでした。
#. de: Mission kann nicht angenommen werden, weil eine oder mehrere Bedingungen nicht erfüllt sind.
#. fr: Impossible d'accepter la mission. Vous ne remplissez pas les conditions.
msgctxt "LogMessage:10885:0:5"
msgid "You do not meet the requirements to accept this mission."
msgstr "Вы не соответствуете требованиям для принятия этой миссии."

#. ja: 詳細はエクスプローラータブレット「<sheet DescriptionString 1297 0 24>」をご確認ください。
#. de: Einzelheiten im Exotablet unter „<sheet DescriptionString 1297 0 24>“.
#. fr: Pour plus de détails, veuillez consulter “<sheet DescriptionString 1297 0 24>” à partir de votre tablette cosmique.
#. macro: <sheet DescriptionString 1297 0 24> — a value from a game data sheet, such as a name; sheet = DescriptionString, row = 1297, column = 0, parameter = 24 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:10886:0:5"
msgid "Further details can be found under “<sheet DescriptionString 1297 0 24>” in your exotablet."
msgstr "Подробнее см. в разделе «<sheet DescriptionString 1297 0 24>» экзотаблета."

#. ja: 詳細はエクスプローラータブレット「<sheet DescriptionString 1309 0 24>」をご確認ください。
#. de: Einzelheiten im Exotablet unter „<sheet DescriptionString 1309 0 24>“.
#. fr: Pour plus de détails, veuillez consulter “<sheet DescriptionString 1309 0 24>” à partir de votre tablette cosmique.
#. macro: <sheet DescriptionString 1309 0 24> — a value from a game data sheet, such as a name; sheet = DescriptionString, row = 1309, column = 0, parameter = 24 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:10887:0:5"
msgid "Further details can be found under “<sheet DescriptionString 1309 0 24>” in your exotablet."
msgstr "Подробнее см. в разделе «<sheet DescriptionString 1309 0 24>» экзотаблета."

#. ja: 詳細はエクスプローラータブレット「<sheet DescriptionString 1307 0 24>」をご確認ください。
#. de: Einzelheiten im Exotablet unter „<sheet DescriptionString 1307 0 24>“.
#. fr: Pour plus de détails, veuillez consulter “<sheet DescriptionString 1307 0 24>” à partir de votre tablette cosmique.
#. macro: <sheet DescriptionString 1307 0 24> — a value from a game data sheet, such as a name; sheet = DescriptionString, row = 1307, column = 0, parameter = 24 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:10888:0:5"
msgid "Further details can be found under “<sheet DescriptionString 1307 0 24>” in your exotablet."
msgstr "Подробнее см. в разделе «<sheet DescriptionString 1307 0 24>» экзотаблета."

#. ja: <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>はシルバーグレードの評価を得た。
#. de: <capitalize><if ($gs1 == $gs2)><switch 1><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn7><noun-de ObjStr 2 $gn7 1 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>hast<else>hat</if> eine Silberwertung erzielt.
#. fr: <capitalize><if ($gs1 == $gs2)>vous<else><if $gn7><noun-fr ObjStr 2 $gn7 1 1><else><if (2 == 9)><if $gn66>d'<else>de<nbsp></if><string $gs2><else><if $gn5><sheet Attributive 2 36><string $gs2><else><sheet Attributive 2 28><string $gs2></if></if></if></if></capitalize> <if ($gs1 == $gs2)>avez<else>a</if> obtenu un rang argent.
msgctxt "LogMessage:10889:0:5"
msgid "You received a Silver Star rating!"
msgstr "Вы получили серебряную звезду!"

#. ja: <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>はゴールドグレードの評価を得た。
#. de: <capitalize><if ($gs1 == $gs2)><switch 1><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn7><noun-de ObjStr 2 $gn7 1 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>hast<else>hat</if> eine Goldwertung erzielt.
#. fr: <capitalize><if ($gs1 == $gs2)>vous<else><if $gn7><noun-fr ObjStr 2 $gn7 1 1><else><if (2 == 9)><if $gn66>d'<else>de<nbsp></if><string $gs2><else><if $gn5><sheet Attributive 2 36><string $gs2><else><sheet Attributive 2 28><string $gs2></if></if></if></if></capitalize> <if ($gs1 == $gs2)>avez<else>a</if> obtenu un rang or.
msgctxt "LogMessage:10890:0:5"
msgid "You received a Gold Star rating!"
msgstr "Вы получили золотую звезду!"

#. ja: 受注可能クラスと異なるため、このミッションは開始できません。
#. de: Mission kann mit der momentanen Klasse nicht begonnen werden.
#. fr: Cette classe n'est pas autorisée à effectuer cette mission.
msgctxt "LogMessage:10891:0:5"
msgid "Unable to accept mission. Your current class or job does not fulfill mission requirements."
msgstr "Нельзя принять эту миссию: ваш текущий класс или профессия не подходит."

#. ja: パイロット申請を辞退しました。<br>搭乗を希望する際は、再度エントリー申請を行う必要があります。
#. de: Antrag auf Einsteigeerlaubnis zurückgezogen.<br>Stelle einen neuen Antrag, wenn du dich erneut für eine Erlaubnis bewerben willst.
#. fr: Vous avez annulé votre candidature au pilotage.<br>Vous devrez effectuer une nouvelle inscription si vous souhaitez postuler à nouveau.
msgctxt "LogMessage:10892:0:5"
msgid "You have withdrawn your pilot application."
msgstr "Вы отозвали заявку пилота."

#. ja: 現在、メカオペレーションは発令されていません。
#. de: Momentan ist kein Mecha-Einsatz ausgerufen.
#. fr: Aucun ordre d'in<shy>ter<shy>ven<shy>tion mécanique n'a été annoncé.
msgctxt "LogMessage:10893:0:5"
msgid "There are no mech ops underway."
msgstr "Сейчас механические операции не проводятся."

#. ja: エントリーチケットを所持していないため申請できません。
#. de: Kein Antragsticket in Besitz. Antrag auf Einsteigeerlaubnis nicht stellbar.
#. fr: Impossible de postuler. Vous ne possédez pas de bon d'inscription.
msgctxt "LogMessage:10894:0:5"
msgid "Unable to register. You do not possess a pilot application."
msgstr "Не удалось подать заявку: у вас нет талона пилота."

#. ja: <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>は、充填済みのエネルギータンクを取り付けた！<br>別の「<sheet EObj $n1 0>」にエネルギーを供給しよう。
#. de: <capitalize><if ($gs1 == $gs2)><switch 1><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn7><noun-de ObjStr 2 $gn7 1 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>hast<else>hat</if> einen geladenen Energievorrat platziert.<br>Finde einen anderen <noun-de EObj 5 $n1 1 4 1> zum Aufladen.
#. fr: <capitalize><if ($gs1 == $gs2)>vous<else><if $gn7><noun-fr ObjStr 2 $gn7 1 1><else><if (2 == 9)><if $gn66>d'<else>de<nbsp></if><string $gs2><else><if $gn5><sheet Attributive 2 36><string $gs2><else><sheet Attributive 2 28><string $gs2></if></if></if></if></capitalize> <if ($gs1 == $gs2)>avez<else>a</if> remis en place un réservoir d'énergie plein !<br>D'autres <noun-fr EObj 12 $n1 2 1> peuvent avoir besoin d'être rechargés en énergie.
#. macro: <capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 7 (condition: may be reworded, restructured, added, or dropped)
#. macro: <noun-en ObjStr 2 $gn7 1 1> — an English noun from a game data sheet, with article and number; sheet = ObjStr, form = 2, row = global number 7, count = 1, case = 1 (game data: keep it; it may move or repeat)
#. macro: <noun-en EObj 3 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = EObj, form = 3, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:10895:0:5"
msgid "<capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> completed the task. Seek out another <noun-en EObj 3 $n1 1 1> and ensure it's duly charged."
msgstr "<capitalize><if ($gs1 == $gs2)>Вы<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> выполнил задание. Найдите другое <noun-en EObj 3 $n1 1 1> и зарядите его."

#. ja: このミニローダーではないようだ。「<sheet EObj $n1 0>」を探そう。
#. de: Dieser Energievorrat ist ungeeignet für den Minimecha. Suche <noun-de EObj 1 $n1 1 4 1>.
#. fr: Ce n'est pas le bon ouvrier cosmique. Cherchez plutôt <noun-fr EObj 1 $n1 1 1>.
#. macro: <noun-en EObj 2 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = EObj, form = 2, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:10896:0:5"
msgid "This is not the mini rover you're looking for. Seek <noun-en EObj 2 $n1 1 1> elsewhere."
msgstr "Это не тот мини-ровер. Поищите <noun-en EObj 2 $n1 1 1> в другом месте."

#. ja: 現在滞在しているインスタンスのため、インスタンスエリアの移動ができませんでした。
#. de: Du konntest nicht in die gewählte Instanz wechseln, da du dich bereits in der Instanz befindest.
#. fr: Vous êtes déjà dans cette instance.
msgctxt "LogMessage:10897:0:5"
msgid "Unable to move to instanced area. You are already in an instance."
msgstr "Не удалось перейти в область с отдельным инстансом. Вы уже находитесь в инстансе."

#. ja: この記事は、記録した探索フィールド内でのみ閲覧することができます。
#. de: Dieser Eintrag kann nur in aufgezeichneten Erkundungsarealen eingesehen werden.
#. fr: Vous ne pouvez consulter cette entrée qu'en étant dans la zone d'exploration où elle a été enregistrée.
msgctxt "LogMessage:10898:0:5"
msgid "This entry can only be viewed in the area where it was recorded."
msgstr "Эту запись можно просмотреть только в той области, где она была сделана."

#. ja: 所持品に空きがないため、<sheet Item $n1 0>を入手できませんでした。
#. de: <capitalize><noun-de Item 1 $n1 1 1 1></capitalize> konnte nicht aufgenommen werden, da dir der Platz im Inventar ausgegangen ist.
#. fr: Impossible d'obtenir <noun-fr Item 2 $n1 1 1>. Votre inventaire est plein.
#. macro: <noun-en Item 2 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = Item, form = 2, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:10899:0:5"
msgid "Unable to obtain <noun-en Item 2 $n1 1 1>. Insufficient inventory space."
msgstr "Не удалось получить <noun-en Item 2 $n1 1 1>. В инвентаре нет места."

#. ja: ドマ式麻雀ボイス「<sheet EmjVoiceNpc $n1 28>」が選択可能になりました。
#. de: <sheet EmjVoiceNpc $n1 28> kommentiert nun deine Mahjong-Partien.
#. fr: <sheet EmjVoiceNpc $n1 27> peut désormais commenter vos parties de mahjong domien.
#. macro: <sheet EmjVoiceNpc $n1 28> — a value from a game data sheet, such as a name; sheet = EmjVoiceNpc, row = number parameter 1, column = 28 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:10900:0:5"
msgid "<sheet EmjVoiceNpc $n1 28> can now be selected to join you in Doman mahjong."
msgstr "Теперь можно выбрать голос «<sheet EmjVoiceNpc $n1 28>» для доманского маджонга."

#. ja: 未制覇の参加メンバーがいるため、攻略成功時の報酬アイテムにボーナスがつきます。<br>ボーナスは未制覇参加メンバーの人数に比例して増加します。
#. de: Weil ein Charakter diesen Inhalt noch nicht beendet hat,<br>gibt es bei Abschluss einen Bonus auf die erhaltenen Gegenstände.<br>Der Bonus ist umso höher, je mehr Charaktere diesen Inhalt noch nicht beendet haben.
#. fr: Un ou plusieurs par<shy>ti<shy>ci<shy>pants n'ont pas encore accompli cette mission. L'équipe recevra du butin sup<shy>plé<shy>men<shy>tai<shy>re en cas de réussite.<br>Plus les par<shy>ti<shy>ci<shy>pants concernés sont nombreux, plus ce bonus est po<shy>ten<shy>tiel<shy>le<shy>ment important.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "LogMessage:10901:0:5"
msgid "One or more party members are new to this duty.<br>Upon completion, a bonus may be awarded based on the number of new party members."
msgstr "В группе есть участники, которые впервые проходят это задание.<br>После завершения вы можете получить бонус. Его размер зависит от числа таких участников."

#. ja: 未制覇の参加メンバーがいる状態で攻略に成功したため、ボーナスとして<num $n2>人分の報酬<sheet Item $n1 0>が追加されました。
#. de: Weil der Inhalt mit Charakteren abgeschlossen wurde, die ihn noch nicht beendet haben,<br>wurde der Belohnung zusätzlich <noun-de Item 5 $n1 1 4 1> entsprechend <if ($n2 == 1)>eines Charakters<else><num $n2> Charakteren</if> als Bonus hinzugefügt.
#. fr: <num $n2> participant<if ($n2 <= 1)><else>s</if> ayant accompli cette mission pour la première fois, le nombre correspondant <noun-fr Item 8 $n1 1 1> a été ajouté au butin.
#. macro: <num $n2> — a number; value = number parameter 2 (game data: keep it; it may move or repeat)
#. macro: <if ($n2 <= 1)>member<else>members</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 2 <= 1 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($n2 <= 1)>was<else>were</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 2 <= 1 (condition: may be reworded, restructured, added, or dropped)
#. macro: <noun-en Item 3 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = Item, form = 3, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:10902:0:5"
msgid "<num $n2> party <if ($n2 <= 1)>member<else>members</if> <if ($n2 <= 1)>was<else>were</if> new to this duty upon its completion. A bonus <noun-en Item 3 $n1 1 1> has been added to the rewards."
msgstr "Впервые это задание проходили <num $n2> человек. В награды добавлен бонус: <noun-en Item 3 $n1 1 1>."

#. ja: 未制覇の参加メンバーがいる状態で攻略に成功したため、<br>ボーナスとして<num $n2>人分の確率判定を追加で行い、<num $n3>個の<sheet Item $n1 0>が追加されました。
#. de: Weil der Inhalt mit Charakteren abgeschlossen wurde, die ihn noch nicht beendet haben,<br>wurde die Chance auf Vergütung entsprechend <if ($n2 == 1)>eines Charakters<else><num $n2> Charakteren</if> erhöht und der Belohnung <if ($n3 == 1)><num $n3> <noun-de Item 5 $n1 1 1 1><else><num $n3> <noun-de Item 5 $n1 2 1 1></if> hinzugefügt.
#. fr: <num $n2> participant<if ($n2 <= 1)><else>s</if> ayant accompli cette mission pour la première fois, <num $n3> exemplaire<if ($n3 <= 1)><else>s</if> <noun-fr Item 8 $n1 1 1> <if ($n3 <= 1)>a été ajouté<else>ont été ajoutés</if> aléatoirement au butin.
#. macro: <num $n2> — a number; value = number parameter 2 (game data: keep it; it may move or repeat)
#. macro: <if ($n2 <= 1)>member<else>members</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 2 <= 1 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($n2 <= 1)>was<else>were</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 2 <= 1 (condition: may be reworded, restructured, added, or dropped)
#. macro: <num $n3> — a number; value = number parameter 3 (game data: keep it; it may move or repeat)
#. macro: <noun-en Item 3 $n1 2 1> — an English noun from a game data sheet, with article and number; sheet = Item, form = 3, row = number parameter 1, count = 2, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:10903:0:5"
msgid "<num $n2> party <if ($n2 <= 1)>member<else>members</if> <if ($n2 <= 1)>was<else>were</if> new to this duty upon its completion. A bonus of <num $n3> <noun-en Item 3 $n1 2 1> has been added to the rewards."
msgstr "Впервые это задание проходили <num $n2> человек. В награды добавлено <num $n3> <noun-en Item 3 $n1 2 1>."

#. ja: 未制覇の参加メンバーがいる状態で攻略に成功したため、<br>ボーナスとして<num $n2>人分の確率判定を追加で行いましたが、報酬<sheet Item $n1 0>の追加はありませんでした。
#. de: Weil der Inhalt mit Charakteren abgeschlossen wurde, die ihn noch nicht beendet haben,<br>wurde die Chance auf Vergütung entsprechend <if ($n2 == 1)>eines Charakters<else><num $n2> Charakteren</if> erhöht, aber der Belohnung wurde <noun-de Item 4 $n1 1 1 1> hinzugefügt.
#. fr: Bien que <num $n2> <if ($n2 <= 1)>participant ait<else>par<shy>ti<shy>ci<shy>pants aient</if> accompli cette mission pour la première fois, aucun exemplaire <noun-fr Item 8 $n1 1 1> n'a été ajouté aléatoirement au butin.
#. macro: <num $n2> — a number; value = number parameter 2 (game data: keep it; it may move or repeat)
#. macro: <if ($n2 <= 1)>member<else>members</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 2 <= 1 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($n2 <= 1)>was<else>were</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 2 <= 1 (condition: may be reworded, restructured, added, or dropped)
#. macro: <noun-en Item 3 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = Item, form = 3, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:10904:0:5"
msgid "<num $n2> party <if ($n2 <= 1)>member<else>members</if> <if ($n2 <= 1)>was<else>were</if> new to this duty upon its completion. However, no <noun-en Item 3 $n1 1 1> has been added to the rewards."
msgstr "Впервые это задание проходили <num $n2> человек. При этом в награды не добавлено ни одного <noun-en Item 3 $n1 1 1>."

#. ja: 内装のリフォームは所有する土地の庭でのみ利用できます。
#. de: Der Innenraum-Stil kann nur vom Garten des Grundstücks aus verändert werden.
#. fr: Vous devez être dans le jardin de votre logement pour effectuer une rénovation d'intérieur.
msgctxt "LogMessage:10905:0:5"
msgid "Interior style changes can only be made from your estate's garden."
msgstr "Изменить стиль интерьера можно только из сада своего поместья."

#. ja: 内装スタイルを変更しました。
#. de: Der Stil des Innenraums wurde angepasst.
#. fr: Le style d'intérieur a été modifié.
msgctxt "LogMessage:10907:0:5"
msgid "Interior style has been changed."
msgstr "Стиль интерьера изменён."

#. ja: 内装スタイルの変更権限がありません。
#. de: Du besitzt nicht die notwendige Berechtigung, um den Innenraum-Stil zu verändern.
#. fr: Vous ne disposez pas de l'autorité nécessaire pour modifier le style d'intérieur.
msgctxt "LogMessage:10908:0:5"
msgid "You are not authorized to make interior style changes."
msgstr "У вас нет права менять стиль интерьера."

#. ja: 調度品が倉庫に収まらないためキャンセルしました。
#. de: Konnte nicht ausgeführt werden, da nicht genügend Platz im Lagerhaus vorhanden ist.
#. fr: Action annulée. Espace de stockage insuffisant dans votre entrepôt.
msgctxt "LogMessage:10909:0:5"
msgid "Unable to apply change. Storage space insufficient."
msgstr "Не удалось изменить интерьер: на складе нет места."

#. ja: テラトタウルスに「死の宣告」を付与された……
#. de: Teratotaurus hat dich mit Verhängnis belegt<nbsp>...
#. fr: Le teratotaurus vous inflige Glas.
msgctxt "LogMessage:10913:0:5"
msgid "You have been afflicted with Doom..."
msgstr "На вас наложен эффект «Рок»..."

#. ja: ダンヴェスパが出現した……
#. de: Dung-Vespula wurden vom Kampfgeschehen angelockt!
#. fr: Des guêpes de fumier ap<shy>pa<shy>rais<shy>sent<nbsp>!
msgctxt "LogMessage:10914:0:5"
msgid "Dung wespes have joined the fray!"
msgstr "Навозные осы вступили в бой!"

#. ja: アーゼマジャッジの武器が出現した……
#. de: Der Azeyma-Richter ruft seine Waffen herbei<nbsp>...
#. fr: L'adjucateur fait apparaître ses armes<nbsp>!
msgctxt "LogMessage:10915:0:5"
msgid "The adjudicator summons arcane instruments!"
msgstr "Судья призывает магические орудия!"

#. ja: 転移機能が使用可能になった
#. de: Das Portal kann jetzt benutzt werden.
#. fr: Le piédestal de passage s'anime sous vos yeux.
msgctxt "LogMessage:10916:0:5"
msgid "The pedestal of passage springs to life."
msgstr "Пьедестал перемещения ожил."

#. ja: 転移機能は機能していないようだ……
#. de: Das Portal scheint nicht zu funktionieren.
#. fr: Le piédestal de passage semble inanimé...
msgctxt "LogMessage:10917:0:5"
msgid "The pedestal of passage doesn't appear to be functioning..."
msgstr "Похоже, пьедестал перехода не работает..."

#. ja: 転移機能が使用可能になった
#. de: Die Transportvorrichtung kann jetzt benutzt werden.
#. fr: Le téléporteur s'anime sous vos yeux.
msgctxt "LogMessage:10918:0:5"
msgid "The teleporter springs to life."
msgstr "Телепортатор ожил."

#. ja: 転移機能は機能していないようだ……
#. de: Die Transportvorrichtung scheint nicht zu funktionieren.
#. fr: Le téléporteur semble inanimé...
msgctxt "LogMessage:10919:0:5"
msgid "The teleporter doesn't appear to be functioning..."
msgstr "Похоже, телепортатор не работает..."

