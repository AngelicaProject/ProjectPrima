msgctxt "LogMessage:7279:0:5"
msgid "<capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>discover<else>discovers</if> <noun-en Item 1 $n1 1 1>."
msgstr "<capitalize><if ($gs1 == $gs2)>Вы обнаруживаете<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> обнаруживает</if></capitalize> <noun-en Item 1 $n1 1 1>."

#. ja: <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>たちは<sheet Item $n1 0>を発見した！
#. de: Ihr habt <noun-de Item 1 $n1 1 4 1> gefunden!
#. fr: <capitalize><if ($gs1 == $gs2)>vous<else><if $gn7><noun-fr ObjStr 2 $gn7 1 1><else><if (2 == 9)><if $gn66>d'<else>de<nbsp></if><string $gs2><else><if $gn5><sheet Attributive 2 36><string $gs2><else><sheet Attributive 2 28><string $gs2></if></if></if></if></capitalize> <if ($gs1 == $gs2)>et vos compagnons avez<else>et ses compagnons ont</if> découvert <noun-fr Item 1 $n1 1 1><nbsp>!
#. macro: <if ($gs1 == $gs2)>Your party discovers<else><if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>'s party discovers</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 7 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn7 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 7, column = 0 (game data: keep it; it may move or repeat)
#. macro: <noun-en Item 1 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = Item, form = 1, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7280:0:5"
msgid "<if ($gs1 == $gs2)>Your party discovers<else><if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>'s party discovers</if> <noun-en Item 1 $n1 1 1>."
msgstr "<if ($gs1 == $gs2)>Ваша группа находит<else>Группа <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if> находит</if> <noun-en Item 1 $n1 1 1>."

#. ja: 一つしか持てないアイテムをすでに持っているため、実行できません。
#. de: Nicht möglich, weil du bereits ein Exemplar von diesem Gegenstand besitzt.
#. fr: Action impossible. Vous ne pouvez posséder qu'un seul exemplaire de cet objet.
msgctxt "LogMessage:7281:0:5"
msgid "Unable to execute command. You can only carry one of that item."
msgstr "Команда недоступна. Можно носить только один такой предмет."

#. ja: <player-name $n1>は、コンテンツを開放していません。
#. de: <if-self $n1>Du hast<else><player-name $n1> hat</if-self> diesen Inhalt noch nicht freigespielt.
#. fr: <if-self $n1>Vous n'avez<else><capitalize><player-name $n1></capitalize> n'a</if-self> pas accès à cette mission.
#. macro: <if-self $n1>You have<else><capitalize><player-name $n1></capitalize> has</if-self> — shows the first branch when the character is the player reading the text, otherwise the branch after <else>; player = number parameter 1 (condition: may be reworded, restructured, added, or dropped)
#. macro: <capitalize><player-name $n1></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <player-name $n1> — the name of a player character; player = number parameter 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7282:0:5"
msgid "<if-self $n1>You have<else><capitalize><player-name $n1></capitalize> has</if-self> not unlocked this duty."
msgstr "<if-self $n1>Вы<else><capitalize><player-name $n1></capitalize></if-self> ещё не открыли это задание."

#. ja: そのセーブデータは、チャレンジコンテンツの階層まで進行しているためコンバートすることはできません。
#. de: Diese Speicherdaten können aufgrund des Fortschritts nicht konvertiert werden.
#. fr: Impossible de convertir cette sauvegarde car la phase de défi a déjà été atteinte.
msgctxt "LogMessage:7283:0:5"
msgid "Unable to convert. Save data has progressed to levels that require a fixed party."
msgstr "Невозможно перенести данные: сохранение дошло до этапов, для которых нужна постоянная группа."

#. ja: 所持品の空きがないため、鑑定できません。
#. de: Begutachtung nicht möglich, weil dein Inventar voll ist.
#. fr: Action impossible. Votre inventaire est plein.
msgctxt "LogMessage:7284:0:5"
msgid "Unable to execute command. Inventory is full."
msgstr "Команда недоступна: инвентарь заполнен."

#. ja: 戦闘不能状態になったとき、一度だけ蘇生されるようになった！
#. de: Der nächste Charakter, der kampfunfähig wird, wird wiederbelebt!
#. fr: Le prochain équipier qui tombera inconscient sera au<shy>to<shy>ma<shy>ti<shy>que<shy>ment ranimé.
msgctxt "LogMessage:7285:0:5"
msgid "You will automatically be revived upon KO."
msgstr "После смерти вы автоматически воскреснете."

#. ja: <player-name $n1>は、クリブの姿に変化した！
#. de: <player-name $n1> hat sich in eine Kuribu verwandelt!
#. fr: <if-self $n1>Vous avez<else><capitalize><player-name $n1></capitalize> a</if-self> pris l'apparence de Kuribu<nbsp>!
#. macro: <if-self $n1>You transform<else><capitalize><player-name $n1></capitalize> transforms</if-self> — shows the first branch when the character is the player reading the text, otherwise the branch after <else>; player = number parameter 1 (condition: may be reworded, restructured, added, or dropped)
#. macro: <capitalize><player-name $n1></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <player-name $n1> — the name of a player character; player = number parameter 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7286:0:5"
msgid "<if-self $n1>You transform<else><capitalize><player-name $n1></capitalize> transforms</if-self> into Kuribu!"
msgstr "<if-self $n1>Вы превращаетесь<else><capitalize><player-name $n1></capitalize> превращается</if-self> в Курибу!"

#. ja: リレイズの効果が発揮され、蘇生された！
#. de: Du wurdest wiederbelebt!
#. fr: Vous avez bénéficié de l'effet de résurrection<nbsp>!
msgctxt "LogMessage:7287:0:5"
msgid "You are revived!"
msgstr "Вы воскресли!"

#. ja: 埋もれた財宝の気配を感知できるようになった！
#. de: Du kannst nun verborgene Schätze aufspüren!
#. fr: Vous êtes désormais capable de détecter les trésors cachés<nbsp>!
msgctxt "LogMessage:7288:0:5"
msgid "You can now discern the call of the Accursed Hoard."
msgstr "Теперь вы можете чувствовать зов Проклятого клада."

#. ja: 全滅したことのあるセーブデータのため、実行できません。
#. de: Nicht möglich, weil die Gruppe von diesem Speicherstand<br>mindestens einmal kampfunfähig war.
#. fr: Action impossible. Le nombre de défaites de cette sauvegarde n'est pas nul.
msgctxt "LogMessage:7289:0:5"
msgid "Unable to execute command. Current save data includes record of a failed attempt."
msgstr "Команда недоступна: в этой записи уже есть поражение."

#. ja: 第<num $n1>巡礼路
#. de: Du betrittst den <num $n1>. Pfad ...
#. fr: Zone <num $n1>
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7290:0:5"
msgid "You pass traverse stone <num $n1>..."
msgstr "Вы проходите через камень переноса <num $n1>..."

#. ja: 「詩想エミネントグリーフ討滅戦」に挑戦するために必要な供物が足りません。
#. de: Du kannst „Eminente Trauer (variabel)“ nicht betreten, da die erforderlichen Opfergaben fehlen.
#. fr: Vous n'avez pas assez d'offrandes sacramentelles pour pénétrer dans le Verset final (quantique).
msgctxt "LogMessage:7291:0:5"
msgid "You have not offered enough sacramental offerings to summon Eminent Grief."
msgstr "Вам не хватает жертвенных даров, чтобы призвать Великое горе."

#. ja: この供物をこれ以上所持していません。
#. de: Du besitzt keine weiteren Opfergaben dieser Sorte.
#. fr: Vous ne possédez pas davantage d'offrandes sacramentelles.
msgctxt "LogMessage:7292:0:5"
msgid "You do not possess any more of this offering."
msgstr "У вас больше нет этого дара."

#. ja: <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>は<kilo $n2 ","><if ($n3 == 0)><else>(+<num $n3>%)</if>ポイントの経験値を得た。
#. de: <capitalize><if ($gs1 == $gs2)><switch 1><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn7><noun-de ObjStr 2 $gn7 1 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>erhältst<else>erhält</if> <kilo $n2 "."><if ($n3 == 0)><else><nbsp>(+<kilo $n3 "."><nbsp>%)</if> Routine.
#. fr: <capitalize><if ($gs1 == $gs2)>vous<else><if $gn7><noun-fr ObjStr 2 $gn7 1 1><else><if (2 == 9)><if $gn66>d'<else>de<nbsp></if><string $gs2><else><if $gn5><sheet Attributive 2 36><string $gs2><else><sheet Attributive 2 28><string $gs2></if></if></if></if></capitalize> <if ($gs1 == $gs2)>gagnez<else>gagne</if> <kilo $n2 "<nbsp>"><if ($n3 == 0)><else><nbsp>(+<num $n3>%)</if> <if ($n2 <= 1)>point<else>points</if> d'expérience.
#. macro: <capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 7 (condition: may be reworded, restructured, added, or dropped)
#. macro: <noun-en ObjStr 2 $gn7 1 1> — an English noun from a game data sheet, with article and number; sheet = ObjStr, form = 2, row = global number 7, count = 1, case = 1 (game data: keep it; it may move or repeat)
#. macro: <if ($gs1 == $gs2)>gain<else>gains</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <kilo $n2 ","> — a number with a thousands separator; value = number parameter 2, separator = , (game data: keep it; it may move or repeat)
#. macro: <if ($n3 == 0)><else><nbsp>(+<kilo $n3 ",">%)</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 3 == 0 (condition: may be reworded, restructured, added, or dropped)
#. macro: <nbsp> — a non-breaking space (may be added or dropped)
#. macro: <kilo $n3 ","> — a number with a thousands separator; value = number parameter 3, separator = , (game data: keep it; it may move or repeat)
#. macro: <if (exp == 1)>point<else>points</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = exp == 1 (condition: may be reworded, restructured, added, or dropped)
msgctxt "LogMessage:7300:0:5"
msgid "<capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>gain<else>gains</if> <kilo $n2 \",\"><if ($n3 == 0)><else><nbsp>(+<kilo $n3 \",\">%)</if> experience <if (exp == 1)>point<else>points</if>."
msgstr "<capitalize><if ($gs1 == $gs2)>Вы получаете<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> получает</if></capitalize> <kilo $n2 \",\"><if ($n3 == 0)><else><nbsp>(+<kilo $n3 \",\">%)</if> оч. опыта."

#. ja: このコンテンツでは、戦闘中にログアウトを行ったキャラクターは、<br>戦闘不能状態で復帰します。
#. de: Charaktere, die sich während dieses Kampfes ausloggen oder die Verbindung verlieren, sind bei erneutem Betreten kampfunfähig.
#. fr: Si l'un des par<shy>ti<shy>ci<shy>pants à cette mission se déconnecte (vo<shy>lon<shy>tai<shy>re<shy>ment ou non) durant le combat,<br>il réintégrera le groupe dans un état inconscient en se reconnectant.
msgctxt "LogMessage:7301:0:5"
msgid "If a player logs out or disconnects, then re-enters this duty, they will be incapacitated upon returning to battle."
msgstr "Если игрок выйдет из игры или потеряет соединение во время боя, после возвращения в это задание он будет недееспособен."

#. ja: 設定を変更しました。
#. de: Die Einstellungen wurden geändert.
#. fr: Les paramètres ont été modifiés.
msgctxt "LogMessage:7310:0:5"
msgid "Changes saved."
msgstr "Изменения сохранены."

#. ja: 設定中の内容を破棄しました。
#. de: Die Einstellungen wurden verworfen.
#. fr: Les changements ont été annulés.
msgctxt "LogMessage:7311:0:5"
msgid "Changes discarded."
msgstr "Изменения отменены."

#. ja: そのアクションは使用できません。
#. de: Das Kommando kann nicht benutzt werden.
#. fr: Impossible d'utiliser cette action.
msgctxt "LogMessage:7312:0:5"
msgid "Unable to use that action."
msgstr "Это действие недоступно."

#. ja: パーティリーダーではないため、合奏レディチェックを実行できません。
#. de: Du kannst die Bereitschaftsanfrage nicht durchführen, da du nicht der Gruppenanführer bist.
#. fr: Seul le chef d'équipe peut activer le mode orchestral.
msgctxt "LogMessage:7313:0:5"
msgid "Unable to perform ready check. You are not the party leader."
msgstr "Невозможно провести проверку готовности: вы не лидер группы."

#. ja: <sound 0 47>パーティの状態が変化したため、合奏レディチェックを中断しました。
#. de: <sound 0 47>Die Gruppenzusammenstellung hat sich geändert. Die Bereitschaftsanfrage wurde unterbrochen.
#. fr: <sound 0 47>Appel de préparation annulé. Le chef d'équipe a changé.
#. macro: <sound 0 47> — plays a sound effect; kind = 0, sound = 47 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "LogMessage:7314:0:5"
msgid "<sound 0 47>The status of the party has changed.<br>The ensemble mode ready check will be canceled."
msgstr "<sound 0 47>Состав группы изменился.<br>Проверка готовности в ансамблевом режиме отменена."

#. ja: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>をカスタムマッチ参加申請に勧誘しました。
#. de: Du hast <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> zu einem Schaukampf eingeladen.
#. fr: Vous avez invité <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> à participer à un combat JcJ personnalisé.
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7320:0:5"
msgid "You invite <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> to a custom match."
msgstr "Вы приглашаете <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> на бой по своим правилам."

#. ja: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>がカスタムマッチ参加申請に参加しました。
#. de: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> hat die Einladung zu einem Schaukampf angenommen.
#. fr: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> a accepté votre invitation à un combat JcJ personnalisé.
#. macro: <capitalize><if ($gs1 == $gs3)><if $gn8><noun-en ObjStr 2 $gn8 1 1><else>you</if><else><if $gn8><noun-en ObjStr 2 $gn8 1 1><else>{$gs3}</if></if></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <if ($gs1 == $gs3)><if $gn8><noun-en ObjStr 2 $gn8 1 1><else>you</if><else><if $gn8><noun-en ObjStr 2 $gn8 1 1><else>{$gs3}</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 3 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $gn8><noun-en ObjStr 2 $gn8 1 1><else>you</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <noun-en ObjStr 2 $gn8 1 1> — an English noun from a game data sheet, with article and number; sheet = ObjStr, form = 2, row = global number 8, count = 1, case = 1 (game data: keep it; it may move or repeat)
#. macro: <if $gn8><noun-en ObjStr 2 $gn8 1 1><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gs1 == $gs3)>accept<else>accepts</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 3 (condition: may be reworded, restructured, added, or dropped)
msgctxt "LogMessage:7321:0:5"
msgid "<capitalize><if ($gs1 == $gs3)><if $gn8><noun-en ObjStr 2 $gn8 1 1><else>you</if><else><if $gn8><noun-en ObjStr 2 $gn8 1 1><else>{$gs3}</if></if></capitalize> <if ($gs1 == $gs3)>accept<else>accepts</if> the custom match invite."
msgstr "<capitalize><if ($gs1 == $gs3)><if $gn8><noun-en ObjStr 2 $gn8 1 1><else>Вы</if><else><if $gn8><noun-en ObjStr 2 $gn8 1 1><else>{$gs3}</if></if></capitalize> <if ($gs1 == $gs3)>принимаете<else>принимает</if> приглашение на матч по своим правилам."

#. ja: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>からカスタムマッチ参加申請に勧誘されました。
#. de: Du wurdest von <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> zu einem Schaukampf eingeladen.
#. fr: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> vous invite à participer à un combat JcJ personnalisé.
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7322:0:5"
msgid "You are invited by <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> to a custom match."
msgstr "Вас приглашает на бой по своим правилам <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>."

#. ja: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>のカスタムマッチ参加申請に参加しました。
#. de: Du hast die Einladung von <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> zu einem Schaukampf angenommen.
#. fr: Vous avez accepté l'invitation de <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> à un combat JcJ personnalisé.
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7323:0:5"
msgid "You accept <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>'s invitation to a custom match."
msgstr "Вы принимаете приглашение <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> на бой по своим правилам."

#. ja: カスタムマッチ参加申請がキャンセルされました。
#. de: Die Vorbereitung des Schaukampfes wurde abgebrochen.
#. fr: L'or<shy>ga<shy>ni<shy>sa<shy>tion du combat JcJ personnalisé a été annulée.
msgctxt "LogMessage:7324:0:5"
msgid "Custom match organization canceled."
msgstr "Подготовка матча по собственным правилам отменена."

#. ja: カスタムマッチ参加申請の結成が完了しました。参加申請を行ってください。
#. de: Die Vor<shy>bereitungen zum Schaukampf sind abgeschlossen.<br>Alles bereit zur Teilnahme.
#. fr: Tout est prêt pour l'or<shy>ga<shy>ni<shy>sa<shy>tion du combat JcJ personnalisé.<br>L'enregistrement peut être effectué.
msgctxt "LogMessage:7325:0:5"
msgid "Custom match readied. Complete organization."
msgstr "Матч по собственным правилам готов. Завершите подготовку."

#. ja: パーティリーダーではないため、誘えませんでした。
#. de: Einladung nicht möglich, weil der Charakter kein Gruppenanführer ist.
#. fr: Invitation impossible. Ce joueur n'est pas chef d'équipe.
msgctxt "LogMessage:7326:0:5"
msgid "Unable to invite. That player is not a party leader."
msgstr "Не удалось пригласить: этот игрок не лидер группы."

#. ja: 勧誘先のパーティ人数が不正なため、誘えませんでした。
#. de: Einladung nicht möglich, weil die eingeladene Gruppe nicht die richtige Anzahl<br>an Mitgliedern hat.
#. fr: Invitation impossible. L'équipe invitée ne comporte pas un nombre adéquat de membres.
msgctxt "LogMessage:7327:0:5"
msgid "Unable to invite. Party size is incorrect."
msgstr "Не удалось пригласить: в группе неправильное число участников."

#. ja: すでにカスタムマッチ参加申請に参加中のキャラクターのため、誘えませんでした。
#. de: Einladung nicht möglich, weil der Charakter bereits an dem Schaukampf teilnimmt.
#. fr: L'équipe de ce joueur a déjà accepté l'invitation à participer à un combat JcJ personnalisé.
msgctxt "LogMessage:7328:0:5"
msgid "That player has already joined the match."
msgstr "Не удалось пригласить: этот игрок уже участвует в матче."

#. ja: すでに勧誘済みのキャラクターのため、誘えませんでした。
#. de: Einladung nicht möglich, weil der Charakter bereits eingeladen wurde.
#. fr: L'équipe de ce joueur a déjà été invitée à participer à un combat JcJ personnalisé.
msgctxt "LogMessage:7329:0:5"
msgid "That player has already been invited."
msgstr "Не удалось пригласить: этот игрок уже получил приглашение."

#. ja: すでにカスタムマッチ参加申請に参加中のため、誘えませんでした。
#. de: Einladung nicht möglich, weil du bereits an einem Schaukampf teilnimmst.
#. fr: Invitation impossible. Votre équipe a accepté une invitation à participer à un combat JcJ personnalisé.
msgctxt "LogMessage:7330:0:5"
msgid "Unable to invite. You are already invited to another custom match."
msgstr "Не удалось пригласить: вас уже пригласили на другой матч по собственным правилам."

#. ja: すでに他参加申請の編成に参加しているキャラクターのため、誘えませんでした。
#. de: Einladung nicht möglich, weil der Charakter bereits zu einem anderen<br>Schaukampf eingeladen wurde.
#. fr: L'équipe de ce joueur a déjà accepté de rejoindre une alliance ou de participer à un combat JcJ personnalisé.
msgctxt "LogMessage:7331:0:5"
msgid "Unable to invite player already invited to another custom match."
msgstr "Не удалось пригласить игрока: его уже пригласили на другой матч по собственным правилам."

#. ja: コンテンツ参加中のキャラクターのため、誘えませんでした。
#. de: Einladung nicht möglich, weil der Charakter gerade an einem Inhalt teilnimmt.
#. fr: Invitation impossible. Ce joueur participe à une mission.
msgctxt "LogMessage:7332:0:5"
msgid "Unable to invite player bound by duty."
msgstr "Не удалось пригласить игрока: он занят заданием."

#. ja: 勧誘したキャラクターが「取り込み中」のため、誘えませんでした。
#. de: Einladung nicht möglich, weil der Spieler gerade beschäftigt ist.
#. fr: Invitation impossible. Ce joueur est occupé.
msgctxt "LogMessage:7333:0:5"
msgid "Unable to invite player whose status is Busy."
msgstr "Не удалось пригласить игрока: у него статус «Занят»."

#. ja: コンテンツ参加申請中のキャラクターのため、誘えませんでした。
#. de: Einladung nicht möglich, weil sich der Spieler für einen Inhalt angemeldet hat.
#. fr: Invitation impossible. Ce joueur s'est enregistré pour participer à une mission.
msgctxt "LogMessage:7334:0:5"
msgid "Unable to invite player using the Duty Finder."
msgstr "Не удалось пригласить игрока: он ищет группу через поиск заданий."

#. ja: 異なるエリアにいるキャラクターのため、誘えませんでした。
#. de: Einladung nicht möglich, weil sich der Charakter in einem anderen Areal aufhält.
#. fr: Invitation impossible. Ce joueur est dans une autre zone.
msgctxt "LogMessage:7335:0:5"
msgid "Unable to invite. That player is currently in another area."
msgstr "Не удалось пригласить: этот игрок находится в другой зоне."

#. ja: 自パーティ内にバディが呼び出されているため、誘えませんでした。
#. de: Einladung nicht möglich, weil sich ein Mitstreiter in der eigenen Gruppe befindet.
#. fr: Invitation impossible. Un joueur de votre équipe a appelé son compagnon.
msgctxt "LogMessage:7336:0:5"
msgid "Unable to invite while a companion summoned in your party."
msgstr "Не удалось пригласить: в вашей группе призван спутник."

#. ja: 勧誘したパーティ内にバディが呼び出されているため、誘えませんでした。
#. de: Einladung nicht möglich, weil sich ein Mitstreiter in der anderen Gruppe befindet.
#. fr: Invitation impossible. Un joueur de cette équipe a appelé son compagnon.
msgctxt "LogMessage:7337:0:5"
msgid "Unable to invite while a companion summoned in their party."
msgstr "Не удалось пригласить: в их группе призван спутник."

#. ja: カスタムマッチ参加申請に誘えませんでした。
#. de: Einladung zum Schaukampf nicht möglich.
#. fr: L'invitation à participer à un combat JcJ personnalisé a échoué.
msgctxt "LogMessage:7338:0:5"
msgid "Unable to invite to custom match."
msgstr "Не удалось пригласить на матч по собственным правилам."

#. ja: ブラックリスト登録したキャラクターのため、誘えませんでした。
#. de: Einladung nicht möglich, weil der Spieler auf deiner Schwarzen Liste steht.
#. fr: Invitation impossible. Ce personnage est dans votre liste noire.
msgctxt "LogMessage:7339:0:5"
msgid "Unable to invite. That player is on your blacklist."
msgstr "Не удалось пригласить: этот игрок у вас в чёрном списке."

#. ja: その名前のキャラクターは存在しないかログアウトしている、もしくは現在異なるエリアにいるため、誘えませんでした。
#. de: Einladung nicht möglich, weil der Charakter ausgeloggt ist, sich in einem anderen<br>Areal befindet oder kein Charakter mit dem Namen existiert.
#. fr: Invitation impossible. Le personnage n'existe pas, n'est pas en ligne ou se trouve dans une autre zone.
msgctxt "LogMessage:7340:0:5"
msgid "Unable to invite. Cannot locate a character with that name online or in the specified area."
msgstr "Не удалось пригласить: персонаж с таким именем не найден в сети или в указанной зоне."

#. ja: カスタムマッチ参加申請のリーダーではないため、参加申請できませんでした。
#. de: Nur der einladende Gruppenanführer kann den Schaukampf beginnen.
#. fr: Seul l'organisateur du combat JcJ personnalisé peut faire l'enregistrement dans l'outil de mission.
msgctxt "LogMessage:7341:0:5"
msgid "Unable to organize custom match. You are not the match leader."
msgstr "Не удалось создать пользовательский бой. Вы не командуете в нём."

#. ja: 自分が「取り込み中」のため、誘えませんでした。
#. de: Einladung nicht möglich, weil du beschäftigt bist.
#. fr: Invitation impossible. Vous êtes occupé<if $gn4>e</if>.
msgctxt "LogMessage:7342:0:5"
msgid "Unable to invite. Your online status is set to Busy."
msgstr "Не удалось пригласить. У вас статус «Не беспокоить»."

#. ja: 自パーティのパーティ人数が不正なため、誘えませんでした。
#. de: Einladung nicht möglich, weil deine Gruppe nicht die richtige Anzahl an<br>Mitgliedern hat.
#. fr: Invitation impossible. Votre équipe ne comporte pas un nombre adéquat de membres.
msgctxt "LogMessage:7343:0:5"
msgid "Unable to invite. Your party size is incorrect."
msgstr "Не удалось пригласить. В вашей группе неподходящее число участников."

#. ja: 勧誘先パーティにログアウトしているキャラクターがいるため、誘えませんでした。
#. de: Einladung nicht möglich, weil ein Mitglied der anderen Gruppe ausgeloggt ist.
#. fr: Invitation impossible. Un ou plusieurs membres de l'équipe invitée ne sont pas en ligne.
msgctxt "LogMessage:7344:0:5"
msgid "Unable to invite party to custom match. One or more members have gone offline."
msgstr "Не удалось пригласить группу на пользовательский бой. Один или несколько участников не в сети."

#. ja: 自パーティ内にログアウトしているキャラクターがいるため、誘えませんでした。
#. de: Einladung nicht möglich, weil ein Mitglied der eigenen Gruppe ausgeloggt ist.
#. fr: Invitation impossible. Un ou plusieurs de vos équipiers ne sont pas en ligne.
msgctxt "LogMessage:7345:0:5"
msgid "Unable to invite party to custom match. One or more members of your party have gone offline."
msgstr "Не удалось пригласить группу на пользовательский бой. Один или несколько участников вашей группы не в сети."

#. ja: パーティ数が足りない、もしくは各パーティの人数が不正なため、カスタムマッチ参加申請を行えませんでした。
#. de: Schaukampf kann nicht begonnen werden, weil die Anzahl der Gruppen oder<br>die Anzahl der Grup<shy>pen<shy>mit<shy>glieder nicht richtig ist.
#. fr: L'enregistrement a échoué. Le nombre d'équipes est insuffisant ou l'une d'entre elles ne comporte pas un nombre adéquat de membres.
msgctxt "LogMessage:7346:0:5"
msgid "Unable to organize custom match. Party requirements have not been met."
msgstr "Не удалось создать пользовательский бой. Не соблюдены требования к группам."

#. ja: 対戦チーム全員の同意が得られたため、再戦を開始します。
#. de: Alle Teilnehmer wollen weiterkämpfen! Ein neuer Schaukampf beginnt.
#. fr: L'équipe adverse a donné son accord. Un nouveau combat va commencer.
msgctxt "LogMessage:7347:0:5"
msgid "Rematch request confirmed for all participants. Commencing match."
msgstr "Все участники согласились на реванш. Бой начинается."

#. ja: 対戦チームのメンバーが退出したため、カスタムマッチの再戦はありません。
#. de: Es wird kein neuer Schaukampf begonnen, weil ein oder mehrere Mitglieder<br>nicht teilnehmen.
#. fr: Des membres de l'équipe adverse ont quitté l'instance. Un nouveau combat ne peut pas avoir lieu.
msgctxt "LogMessage:7348:0:5"
msgid "One or more participants have left the match. Rematch canceled."
msgstr "Один или несколько участников покинули бой. Реванш отменён."

#. ja: 自身がPvPコンテンツを開放していないため、カスタムマッチ参加申請に誘えませんでした。
#. de: Einladung nicht möglich, weil du PvP-Kämpfe noch nicht freigeschaltet hast.
#. fr: Invitation impossible. Vous n'avez pas encore accès au mode de combat JcJ.
msgctxt "LogMessage:7349:0:5"
msgid "Unable to invite to custom match. PvP not yet unlocked."
msgstr "Не удалось пригласить на пользовательский бой. PvP ещё не открыто."

#. ja: <string $s1>のキャラクター情報を報告しました。<br>報告に対する返信は行っておりませんので、<br>ご了承ください。ご協力ありがとうございました。
#. de: Du hast <string $s1> gemeldet. Vielen Dank für deine Hilfe!
#. fr: Les in<shy>for<shy>ma<shy>tions de personnage de <string $s1> nous ont été transmises.<br>Notez toutefois que nous ne donnons pas de réponses per<shy>son<shy>nelles aux signalements qui nous sont envoyés.
#. macro: <string $s1> — a text value passed to the string; value = text parameter 1 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "LogMessage:7380:0:5"
msgid "Report concerning the suspicious actions of <string $s1> sent.<br>A reply will not be forthcoming."
msgstr "Доклад о подозрительных действиях персонажа <string $s1> отправлен.<br>Ответа на доклады не предусмотрено."

#. ja: 他プレイヤーからの報告により、あなたがRMT宣伝をしている可能性が高い<br>プレイヤーであると判断され、発言が制限されました。<br>もしもRMT宣伝をした覚えがない場合は、サポートデスク内「迷惑行為の報告」よりお問い合わせください。
#. de: Ein Spieler hat gemeldet, dass du RMT-Angebote verbreitest, deshalb wurde dein Chat eingeschränkt.<br>Falls du zu Unrecht beschuldigt wurdest, schick uns bitte eine Nachricht unter<br>„Kundendienst“ - „Kontakt“ - „Unangemessenes Verhalten melden“.
#. fr: Suite au signalement d'un autre joueur selon lequel vous vous livreriez à de la publicité<br>pour de la vente de données de jeu contre argent réel (“RMT”),<br>nous avons décidé de restreindre votre capacité à communiquer dans le jeu.<br>Si vous ne pensez pas avoir fait quoi que ce soit d'illicite, veuillez nous contacter<br>via le bouton “Signaler un com<shy>por<shy>te<shy>ment gênant” de l'onglet “Nous contacter” de la fenêtre Services et aide.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "LogMessage:7381:0:5"
msgid "You have been reported by another player as<br>participating in RMT activities and have had your<br>chat log access restricted. If you believe this to be<br>in error, please access the Report Harassment<br>feature via the Support Desk."
msgstr "Другой игрок сообщил, что вы участвуете в торговле за реальные деньги (RMT).<br>Вам ограничен доступ к чату. Если это ошибка, обратитесь в службу поддержки через раздел «Доклад о нарушении»."

#. ja: 送信に失敗しました。あなたの発言は制限されています。
#. de: Die Nachricht konnte nicht gesendet werden,<br>weil dein Chat mit einer Beschränkung belegt wurde.
#. fr: L'envoi du message a échoué. Veuillez réessayer.
msgctxt "LogMessage:7382:0:5"
msgid "Unable to send message. Your chat log access has been restricted."
msgstr "Не удалось отправить сообщение. Вам ограничен доступ к чату."

#. ja: 募集に設定されているコンテンツの申請条件を満たしていないため、パーティ募集に参加できませんでした。
#. de: Keine Gruppen<shy>suche möglich, weil nicht alle Teilnahmebedingungen für diesen Inhalt erfüllt sind.
#. fr: Impossible de rejoindre la recherche d'équipe. Vous ne remplissez pas certaines conditions de par<shy>ti<shy>ci<shy>pa<shy>tion.
msgctxt "LogMessage:7390:0:5"
msgid "Unable to join party. You do not meet the requirements specified to participate."
msgstr "Не удалось вступить в группу. Вы не соответствуете требованиям для участия."

#. ja: 募集に設定されているコンテンツの申請条件を満たしていないメンバーがいるため、パーティ募集に参加できませんでした。
#. de: Keine Gruppen<shy>suche möglich, weil ein oder mehrere Grup<shy>pen<shy>mit<shy>glieder nicht die Teilnahmebedingungen erfüllen.
#. fr: Impossible de rejoindre la recherche d'équipe. Un ou plusieurs équipiers ne remplissent pas certaines conditions de par<shy>ti<shy>ci<shy>pa<shy>tion.
msgctxt "LogMessage:7391:0:5"
msgid "Unable to join. One or more party members do not meet the requirements specified to participate."
msgstr "Не удалось вступить в группу. Один или несколько её участников не соответствуют требованиям для участия."

#. ja: 申請中のコンテンツのステージが切り替わったため、参加申請がキャンセルされました。
#. de: Die Anmeldung wurde zurückgezogen, da sich die Arena für den registrierten Inhalt geändert hat.
#. fr: Participation impossible. La carte a changé.
msgctxt "LogMessage:7392:0:5"
msgid "Registered duty arena has changed. Registration canceled."
msgstr "Арена для выбранного контента изменилась. Регистрация отменена."

#. ja: ■目的
#. de: ■ Ziel
#. fr: ■ Objectif
msgctxt "LogMessage:7393:0:5"
msgid "■Objective"
msgstr "■Цель"

#. ja: ■コメント
#. de: ■ Kommentar
#. fr: ■ Commentaire
msgctxt "LogMessage:7395:0:5"
msgid "■Comment"
msgstr "■Комментарий"

#. ja: <if ($n1 > 0)><string $s2><else>コメントなし</if>
#. de: <if ($n1 > 0)><string $s2><else>Kein Kommentar</if>
#. fr: <if ($n1 > 0)><string $s2><else>aucun commentaire</if>
#. macro: <if ($n1 > 0)><string $s2><else>None</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 1 > 0 (condition: may be reworded, restructured, added, or dropped)
#. macro: <string $s2> — a text value passed to the string; value = text parameter 2 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7396:0:5"
msgid "<if ($n1 > 0)><string $s2><else>None</if>"
msgstr "<if ($n1 > 0)><string $s2><else>Нет комментария</if>"

#. ja: ■コンテンツファインダー参加条件設定
#. de: ■ Bedingungen der Inhaltssuche
#. fr: ■ Conditions de l'outil de mission
msgctxt "LogMessage:7397:0:5"
msgid "■Duty Finder Settings"
msgstr "■Настройки поиска контента"

#. ja: 募集中のコンテンツの開催期間が終了したため、パーティ募集を終了しました。
#. de: Die Gruppen<shy>suche wurde beendet, weil dieser saisonale Inhalt nicht mehr verfügbar ist.
#. fr: La mission pour laquelle vous recrutez n'étant plus disponible, le recrutement a pris fin.
msgctxt "LogMessage:7398:0:5"
msgid "Party recruitment ended. The applicable duty is no longer available."
msgstr "Набор в группу завершён. Выбранный контент больше недоступен."

#. ja: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>にデュエル申請を申し込みました。
#. de: Du hast <if ($gs1 == $gs3)><switch 4><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn8><noun-de ObjStr 2 $gn8 1 4 1><else>{$gs3}</if></if> zum Duell herausgefordert.
#. fr: Vous avez envoyé une demande de combat singulier <if ($gs1 == $gs3)>vous<else><if $gn8><noun-fr ObjStr 7 $gn8 1 1><else><if (7 == 9)><if $gn67>d'<else>de<nbsp></if><string $gs3><else><if (7 == 8)><if $gn67>d'<else>de<nbsp></if><string $gs3><else><if $gn6><sheet Attributive 7 36><string $gs3><else><sheet Attributive 7 28><string $gs3></if></if></if></if></if>.
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7400:0:5"
msgid "You challenge <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> to a duel."
msgstr "Вы вызываете на дуэль <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>."

#. ja: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>にデュエル申請を拒否されました。
#. de: <capitalize><if ($gs1 == $gs3)><switch 1><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn8><noun-de ObjStr 2 $gn8 1 1 1><else>{$gs3}</if></if></capitalize> hat deine Heraus<shy>forde<shy>rung abgelehnt.
#. fr: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> a refusé votre demande de combat singulier.
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7401:0:5"
msgid "<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> politely denies your challenge to a duel."
msgstr "<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> вежливо отклоняет ваш вызов на дуэль."

#. ja: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>からデュエル申請を申し込まれました。
#. de: <capitalize><if ($gs1 == $gs3)><switch 1><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn8><noun-de ObjStr 2 $gn8 1 1 1><else>{$gs3}</if></if></capitalize> hat dich zum Duell herausgefordert.
#. fr: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> vous a envoyé une demande de combat singulier.
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7402:0:5"
msgid "<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> challenges you to a duel."
msgstr "<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> вызывает вас на дуэль."

#. ja: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>のデュエル申請を拒否しました。
#. de: Du hast die Heraus<shy>forde<shy>rung von <if ($gs1 == $gs3)><switch 3><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn8><noun-de ObjStr 2 $gn8 1 3 1><else>{$gs3}</if></if> abgelehnt.
#. fr: Vous avez refusé la demande de combat singulier <if ($gs1 == $gs3)>vous<else><if $gn8><noun-fr ObjStr 9 $gn8 1 1><else><if (9 == 9)><if $gn67>d'<else>de<nbsp></if><string $gs3><else><if (9 == 8)><if $gn67>d'<else>de<nbsp></if><string $gs3><else><if $gn6><sheet Attributive 9 36><string $gs3><else><sheet Attributive 9 28><string $gs3></if></if></if></if></if>.
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7403:0:5"
msgid "You politely decline <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>'s challenge to a duel."
msgstr "Вы вежливо отклоняете вызов на дуэль от <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>."

#. ja: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>がデュエル可能エリア外にいるため、デュエル申請できませんでした。
#. de: Die Heraus<shy>forde<shy>rung ist nicht möglich, da <if ($gs1 == $gs3)><switch 1><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn8><noun-de ObjStr 2 $gn8 1 1 1><else>{$gs3}</if></if> sich in einem Areal befindet,<br>in dem keine Duelle gestattet sind.
#. fr: Impossible de faire une demande de combat singulier. <capitalize><if ($gs1 == $gs3)>vous<else><if $gn8><noun-fr ObjStr 2 $gn8 1 1><else><if (2 == 9)><if $gn67>d'<else>de<nbsp></if><string $gs3><else><if (2 == 8)><if $gn67>d'<else>de<nbsp></if><string $gs3><else><if $gn6><sheet Attributive 2 36><string $gs3><else><sheet Attributive 2 28><string $gs3></if></if></if></if></if></capitalize> n'est pas dans la zone d'af<shy>fron<shy>te<shy>ment.
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7404:0:5"
msgid "Unable to challenge to duel. <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> has left the area."
msgstr "Не удалось вызвать на дуэль: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> покидает зону."

#. ja: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>がデュエル可能エリア外に移動したため、デュエル申請が却下されました。
#. de: Die Heraus<shy>forde<shy>rung wurde abgelehnt, da <if ($gs1 == $gs3)><switch 1><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn8><noun-de ObjStr 2 $gn8 1 1 1><else>{$gs3}</if></if> sich in ein Areal begeben hat,<br>in dem keine Duelle gestattet sind.
#. fr: Demande de combat singulier annulée. <capitalize><if ($gs1 == $gs3)>vous<else><if $gn8><noun-fr ObjStr 2 $gn8 1 1><else><if (2 == 9)><if $gn67>d'<else>de<nbsp></if><string $gs3><else><if (2 == 8)><if $gn67>d'<else>de<nbsp></if><string $gs3><else><if $gn6><sheet Attributive 2 36><string $gs3><else><sheet Attributive 2 28><string $gs3></if></if></if></if></if></capitalize> est sorti<if $gn8><if "<sheet BNpcName $gn8 6>">e</if><else><if $gn6>e</if></if> de la zone d'af<shy>fron<shy>te<shy>ment.
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7405:0:5"
msgid "Duel canceled. <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> has left the area."
msgstr "Дуэль отменена: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> покидает зону."

#. ja: デュエル可能エリア外に移動したため、デュエル申請が却下されました。
#. de: Die Heraus<shy>forde<shy>rung wurde abgelehnt, da du dich in ein Areal begeben hast,<br>in dem keine Duelle gestattet sind.
#. fr: Demande de combat singulier annulée. Vous êtes sorti<if $gn4>e</if> de la zone d'af<shy>fron<shy>te<shy>ment.
msgctxt "LogMessage:7406:0:5"
msgid "Duel canceled. You have left the area."
msgstr "Дуэль отменена. Вы покинули зону."

#. ja: 申請回答期限が過ぎたため、デュエル申請が却下されました。
#. de: Die Heraus<shy>forde<shy>rung wurde abgelehnt, da die Antwortzeit verstrichen ist.
#. fr: Demande de combat singulier annulée. Le temps imparti pour la réponse s'est écoulé.
msgctxt "LogMessage:7407:0:5"
msgid "Duel canceled. An answer was not returned promptly."
msgstr "Дуэль отменена. Вы не ответили вовремя."

#. ja: デュエル申請が成立したため、デュエルが開始されます。
#. de: Die Heraus<shy>forde<shy>rung ist angenommen. Das Duell beginnt!
#. fr: La demande a été acceptée. Le combat singulier peut commencer.
msgctxt "LogMessage:7408:0:5"
msgid "Duel accepted. Prepare for battle."
msgstr "Вызов на дуэль принят. Приготовьтесь к бою."

#. ja: <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>が<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>にデュエルで勝利しました！
#. de: <capitalize><if ($gs1 == $gs2)><switch 1><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn7><noun-de ObjStr 2 $gn7 1 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>hast<else>hat</if> <if ($gs1 == $gs3)><switch 4><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn8><noun-de ObjStr 2 $gn8 1 4 1><else>{$gs3}</if></if> im Duell besiegt!
#. fr: <capitalize><if ($gs1 == $gs2)>vous<else><if $gn7><noun-fr ObjStr 2 $gn7 1 1><else><if (2 == 9)><if $gn66>d'<else>de<nbsp></if><string $gs2><else><if $gn5><sheet Attributive 2 36><string $gs2><else><sheet Attributive 2 28><string $gs2></if></if></if></if></capitalize> <if ($gs1 == $gs2)>avez vaincu <if ($gs1 == $gs3)>vous<else><if $gn8><noun-fr ObjStr 2 $gn8 1 1><else><if (2 == 9)><if $gn67>d'<else>de<nbsp></if><string $gs3><else><if (2 == 8)><if $gn67>d'<else>de<nbsp></if><string $gs3><else><if $gn6><sheet Attributive 2 36><string $gs3><else><sheet Attributive 2 28><string $gs3></if></if></if></if></if><else><if ($gs1 == $gs3)>vous a vaincu<if $gn4>e</if><else>a vaincu <if ($gs1 == $gs3)>vous<else><if $gn8><noun-fr ObjStr 2 $gn8 1 1><else><if (2 == 9)><if $gn67>d'<else>de<nbsp></if><string $gs3><else><if (2 == 8)><if $gn67>d'<else>de<nbsp></if><string $gs3><else><if $gn6><sheet Attributive 2 36><string $gs3><else><sheet Attributive 2 28><string $gs3></if></if></if></if></if></if></if> en combat singulier<nbsp>!
#. macro: <capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 7 (condition: may be reworded, restructured, added, or dropped)
#. macro: <noun-en ObjStr 2 $gn7 1 1> — an English noun from a game data sheet, with article and number; sheet = ObjStr, form = 2, row = global number 7, count = 1, case = 1 (game data: keep it; it may move or repeat)
#. macro: <if ($gs1 == $gs2)>defeat<else>defeats</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gs1 == $gs3)>you<else><if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 3 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7409:0:5"
msgid "<capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>defeat<else>defeats</if> <if ($gs1 == $gs3)>you<else><if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if></if>!"
msgstr "<capitalize><if ($gs1 == $gs2)>Вы побеждаете<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> побеждает</if></capitalize> <if ($gs1 == $gs3)>вас<else><if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if></if>!"

#. ja: 戦闘不能状態のため、申請できませんでした。
#. de: Keine Heraus<shy>forde<shy>rung möglich, da du kampfunfähig bist.
#. fr: Impossible de faire une demande de combat singulier. Vous êtes inconscient<if $gn4>e</if>.
msgctxt "LogMessage:7410:0:5"
msgid "Unable to duel while unconscious."
msgstr "Нельзя вызвать на дуэль, пока вы без сознания."

#. ja: 申請先のキャラクターが戦闘不能状態のため、申請できませんでした。
#. de: Keine Heraus<shy>forde<shy>rung möglich, da dein Gegner kampfunfähig ist.
#. fr: Impossible de faire une demande de combat singulier. L'autre personnage est inconscient.
msgctxt "LogMessage:7411:0:5"
msgid "Unable to challenge to duel. The player is unconscious."
msgstr "Не удалось вызвать на дуэль. Другой игрок без сознания."

#. ja: 現在デュエル申込中のため、申請できませんでした。
#. de: Keine Heraus<shy>forde<shy>rung möglich, da du bereits eine andere Heraus<shy>forde<shy>rung gestellt hast.
#. fr: Impossible de faire une demande de combat singulier. Vous en avez déjà une en cours.
msgctxt "LogMessage:7412:0:5"
msgid "Unable to issue additional duel challenge while challenging another player to a duel."
msgstr "Не удалось вызвать на дуэль. Вы уже бросили вызов другому игроку."

#. ja: 現在デュエル申請を申し込まれているため、申請できませんでした。
#. de: Keine Heraus<shy>forde<shy>rung möglich, da du selbst bereits eine Heraus<shy>forde<shy>rung erhalten hast.
#. fr: Impossible de faire une demande de combat singulier. Vous en avez reçu une d'un autre joueur.
msgctxt "LogMessage:7413:0:5"
msgid "Unable to challenge to duel while being challenged."
msgstr "Не удалось вызвать на дуэль. Вам уже бросили вызов."

#. ja: 申請先のキャラクターがデュエル申込中のため、申請できませんでした。
#. de: Keine Heraus<shy>forde<shy>rung möglich,<br>da der andere Spieler bereits selbst eine Heraus<shy>forde<shy>rung gestellt hat.
#. fr: Impossible de faire une demande de combat singulier. L'autre joueur en a déjà une en cours.
msgctxt "LogMessage:7414:0:5"
msgid "Unable to challenge to duel. That player is already being challenged."
msgstr "Не удалось вызвать на дуэль. Другой игрок уже бросил кому-то вызов."

#. ja: 現在デュエル中のため、申請できませんでした。
#. de: Keine Heraus<shy>forde<shy>rung möglich, da du bereits an einem Duell teilnimmst.
#. fr: Impossible de faire une demande de combat singulier. Vous affrontez ac<shy>tu<shy>el<shy>le<shy>ment un autre joueur.
msgctxt "LogMessage:7415:0:5"
msgid "Unable to challenge to duel while dueling."
msgstr "Не удалось вызвать на дуэль, пока вы участвуете в другой."

#. ja: 申請先のキャラクターがデュエル中のため、申請できませんでした。
#. de: Keine Heraus<shy>forde<shy>rung möglich, da der andere Spieler bereits an einem Duell teilnimmt.
#. fr: Impossible de faire une demande de combat singulier. Le joueur affronte ac<shy>tu<shy>el<shy>le<shy>ment un autre.
msgctxt "LogMessage:7416:0:5"
msgid "Unable to challenge to duel. That player is already dueling."
msgstr "Не удалось вызвать на дуэль. Другой игрок уже участвует в дуэли."

#. ja: 申請者によりデュエル申請がキャンセルされました。
#. de: Die Heraus<shy>forde<shy>rung wurde vom Herausforderer zurückgenommen.
#. fr: L'autre joueur a annulé sa demande de combat singulier.
msgctxt "LogMessage:7417:0:5"
msgid "The duel challenge has been withdrawn."
msgstr "Вызов на дуэль отозван."

#. ja: 申請先のキャラクターがデュエルを申し込まれているため、申請できませんでした。
#. de: Keine Heraus<shy>forde<shy>rung möglich,<br>da der andere Spieler bereits eine Heraus<shy>forde<shy>rung erhalten hat.
#. fr: Impossible de faire une demande de combat singulier. Le joueur en a reçu une d'un autre.
msgctxt "LogMessage:7418:0:5"
msgid "Unable to challenge to duel. That player is already being challenged."
msgstr "Не удалось вызвать на дуэль. Другому игроку уже бросили вызов."

#. ja: PvP対戦可能なジョブではないため、デュエル申請できませんでした。
#. de: Keine Heraus<shy>forde<shy>rung möglich, da du weder einen Krieger noch einen Magier spielst. (Beschränkte Jobs sind ausgeschlossen.)
#. fr: Impossible de faire une demande de combat singulier. Votre job ne peut pas participer au mode JcJ.
msgctxt "LogMessage:7419:0:5"
msgid "Unable to challenge to duel. You must be a Disciple of War or Magic (limited jobs excluded)."
msgstr "Не удалось вызвать на дуэль. Для участия нужен класс или профессия боевого либо магического класса (ограниченные профессии не подходят)."

#. ja: 申請先のキャラクターがPvP対戦可能なジョブではないため、デュエル申請できませんでした。
#. de: Keine Heraus<shy>forde<shy>rung möglich,<br>da der andere Spieler weder einen Krieger noch einen Magier spielt. (Beschränkte Jobs sind ausgeschlossen.)
#. fr: Impossible de faire une demande de combat singulier. Le job de l'autre joueur ne peut pas participer au mode JcJ.
msgctxt "LogMessage:7420:0:5"
msgid "Unable to challenge to duel. Opponent must be a Disciple of War or Magic (limited jobs excluded)."
msgstr "Не удалось вызвать на дуэль. Противник должен быть боевого либо магического класса (ограниченные профессии не подходят)."

#. ja: デュエル申請の相手と離れるとデュエル申請はキャンセルされます。
#. de: Die Heraus<shy>forde<shy>rung wird annulliert, wenn du dich zu weit von dem anderen Spieler entfernst.
#. fr: S'éloigner de l'autre joueur annulera la demande de combat singulier.
msgctxt "LogMessage:7421:0:5"
msgid "If either party stray too far from the other, the duel will be canceled."
msgstr "Если вы или противник отойдёте слишком далеко, вызов на дуэль будет отменён."

#. ja: 距離が遠すぎます。
#. de: Zu weit entfernt.
#. fr: Vous et l'autre joueur êtes trop loin l'un de l'autre.
msgctxt "LogMessage:7422:0:5"
msgid "You are too far away from your opponent."
msgstr "Вы слишком далеко от противника."

#. ja: 自分のペットがデュエル可能エリア外にいるため、デュエル申請できませんでした。
#. de: Keine Heraus<shy>forde<shy>rung möglich, da sich dein Familiar in einem Areal aufhält,<br>in dem keine Duelle gestattet sind.
#. fr: Votre familier est en dehors de la zone d'af<shy>fron<shy>te<shy>ment.
msgctxt "LogMessage:7423:0:5"
msgid "Unable to challenge to duel while a companion is summoned."
msgstr "Нельзя вызвать на дуэль, пока призван ваш спутник."

#. ja: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>のペットがデュエル可能エリア外にいるため、デュエル申請できませんでした。
#. de: Keine Heraus<shy>forde<shy>rung möglich, da sich das Familiar von <if ($gs1 == $gs3)><switch 3><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn8><noun-de ObjStr 2 $gn8 1 3 1><else>{$gs3}</if></if><br>in einem Areal aufhält, in dem keine Duelle gestattet sind.
#. fr: <if ($gs1 == $gs3)>Votre familier<else>Le familier de <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if></if> est en dehors de la zone d'af<shy>fron<shy>te<shy>ment.
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7424:0:5"
msgid "Unable to challenge to duel while <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>'s companion is summoned."
msgstr "Нельзя вызвать на дуэль, пока призван спутник <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>."

#. ja: ブラックリスト登録したキャラクターです。デュエル申請をできません。
#. de: Keine Heraus<shy>forde<shy>rung möglich,<br>da sich der andere Spieler auf deiner Schwarzen Liste befindet.
#. fr: Impossible de faire une demande de combat singulier. L'autre joueur est dans votre liste noire.
msgctxt "LogMessage:7425:0:5"
msgid "Unable to challenge to duel. That player is on your blacklist."
msgstr "Не удалось вызвать на дуэль. Этот игрок у вас в чёрном списке."

#. ja: デュエル申請をできませんでした。
#. de: Keine Heraus<shy>forde<shy>rung möglich.
#. fr: La demande de combat singulier a échoué.
msgctxt "LogMessage:7426:0:5"
msgid "Unable to challenge to duel."
msgstr "Не удалось вызвать на дуэль."

#. ja: デュエル可能エリア外に移動したため、<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>からのデュエル申請が却下されました。
#. de: Die Heraus<shy>forde<shy>rung von <if ($gs1 == $gs3)><switch 3><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn8><noun-de ObjStr 2 $gn8 1 3 1><else>{$gs3}</if></if> wurde abgelehnt,<br>weil du dich in ein Areal bewegt hast, in dem keine Duelle gestattet sind.
#. fr: Demande de combat singulier de <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> annulée. Vous êtes sorti<if $gn4>e</if> de la zone d'af<shy>fron<shy>te<shy>ment.
msgctxt "LogMessage:7427:0:5"
msgid "Duel challenge declined. You have left the area."
msgstr "Вызов на дуэль отклонён. Вы покинули зону."

#. ja: デュエル申請がキャンセルされました。
#. de: Die Heraus<shy>forde<shy>rung zum Duell wurde annulliert.
#. fr: La demande de combat singulier a été annulée.
msgctxt "LogMessage:7428:0:5"
msgid "Duel canceled."
msgstr "Дуэль отменена."

#. ja: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>は、今デュエルを行えません。
#. de: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> kann momentan nicht an einem Duell teilnehmen.
#. fr: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> n'est pas ac<shy>tu<shy>el<shy>le<shy>ment en mesure de faire un combat singulier.
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7429:0:5"
msgid "<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> is unable to duel at this time."
msgstr "<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> сейчас не может участвовать в дуэли."

#. ja: アイテム鑑定を開始しました。
#. de: Die Expertin begutachtet den Gegenstand ...
#. fr: Le désenvoûtement de l'objet a commencé.
msgctxt "LogMessage:7430:0:5"
msgid "Conducting appraisal..."
msgstr "Оценка предмета..."

#. ja: アイテム鑑定の結果、<sheet Item $n1 0>を入手しました。
#. de: Du hast <noun-de Item 1 $n1 1 4 1> erhalten!
#. fr: Grâce au désenvoûtement, vous obtenez <noun-fr Item 1 $n1 1 1>.
#. macro: <noun-en Item 1 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = Item, form = 1, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7431:0:5"
msgid "The item has been determined to be none other than <noun-en Item 1 $n1 1 1>!"
msgstr "Это не что иное, как <noun-en Item 1 $n1 1 1>!"

#. ja: アイテム鑑定の結果、<sheet Item $n1 0>を入手しました。
#. de: Du hast <noun-de Item 1 $n1 1 4 1> erhalten!
#. fr: Grâce au déverrouillage, vous obtenez <noun-fr Item 1 $n1 1 1>.
#. macro: <noun-en Item 1 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = Item, form = 1, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7432:0:5"
msgid "The lock is pried open. You receive <noun-en Item 1 $n1 1 1>"
msgstr "Замок вскрыт. Вы получили: <noun-en Item 1 $n1 1 1>"

#. ja: アイテム鑑定の結果、<sheet Item $n1 0>×<num $n2>を入手しました。
#. de: Du hast <num $n2> <noun-de Item 5 $n1 $n2 4 1> erhalten!
#. fr: Grâce au déverrouillage, vous obtenez <if ($n2 == 1)><noun-fr Item 1 $n1 1 1><else><num $n2> <noun-fr Item 12 $n1 2 1></if>.
#. macro: <num $n2> — a number; value = number parameter 2 (game data: keep it; it may move or repeat)
#. macro: <noun-en Item 1 $n1 $n2 1> — an English noun from a game data sheet, with article and number; sheet = Item, form = 1, row = number parameter 1, count = number parameter 2, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7433:0:5"
msgid "The lock is pried is opened. You receive <num $n2> <noun-en Item 1 $n1 $n2 1>."
msgstr "Замок вскрыт. Вы получили: <num $n2> <noun-en Item 1 $n1 $n2 1>."

#. ja: 所持数が不足しているため、鑑定できません。
#. de: Öffnen nicht möglich,<br>weil du nicht genug der erforderlichen Gegenstände hast.
#. fr: Action impossible. Vous n'avez pas assez d'objets à déverrouiller.
msgctxt "LogMessage:7434:0:5"
msgid "Unable to open lockbox. Insufficient items."
msgstr "Не удалось открыть сундук. Не хватает предметов."

#. ja: 所持品に空きがないため、アイテム鑑定を行えません。
#. de: Öffnen nicht möglich, weil du keinen Platz im Inventar hast.
#. fr: Impossible d'effectuer un déverrouillage. Votre inventaire est plein.
msgctxt "LogMessage:7435:0:5"
msgid "Unable to open lockbox. Insufficient inventory space."
msgstr "Не удалось открыть сундук. В инвентаре нет места."

#. ja: 鑑定に必要なレジスタンスランクに到達していないため、鑑定できません
#. de: Begutachtung nicht möglich. Widerstandsrang nicht hoch genug.
#. fr: Vous n'avez pas le rang de résistant<if $gn4>e</if> requis pour faire expertiser cet objet.
msgctxt "LogMessage:7436:0:5"
msgid "Unable to initiate identification. Insufficient Resistance rank."
msgstr "Не удалось начать опознание. Недостаточный ранг Сопротивления."

#. ja: 所持数が不足しているため、鑑定できません。
#. de: Begutachtung nicht möglich. Zu wenig Splitter im Besitz.
#. fr: Action impossible. Objet non trouvé en quantité nécessaire.
msgctxt "LogMessage:7437:0:5"
msgid "Unable to execute command. Insufficient inventory space."
msgstr "Не удалось выполнить действие. Недостаточно места в инвентаре."

#. ja: パスワードが不正なため、募集に参加できませんでした。
#. de: Die Suche kann nicht gestartet werden, da das Passwort nicht korrekt ist.
#. fr: Impossible de rejoindre ce recrutement. Le code de par<shy>ti<shy>ci<shy>pa<shy>tion est incorrect.
msgctxt "LogMessage:7440:0:5"
msgid "Password is incorrect. Unable to participate in recruitment."
msgstr "Неверный пароль. Не удалось вступить в группу."

#. ja: 入力された文字列によるサーチ結果を反映しました。
#. de: Die Suche ergab <num $n1> Treffer.
#. fr: Les résultats correspondant à la recherche sont affichés dans la fenêtre.
msgctxt "LogMessage:7441:0:5"
msgid "Search results updated."
msgstr "Результаты поиска обновлены."

#. ja: パスワードが不正なため、募集を登録できませんでした。
#. de: Die Suche kann nicht geändert werden, da das Passwort nicht korrekt ist.
#. fr: Impossible de commencer le recrutement. Le code de par<shy>ti<shy>ci<shy>pa<shy>tion est invalide.
msgctxt "LogMessage:7442:0:5"
msgid "Password is incorrect. Unable to participate in recruitment."
msgstr "Неверный пароль. Не удалось зарегистрировать набор."

#. ja: 募集者がオフラインのため、パーティ募集に参加できませんでした。
#. de: Teilnahme nicht möglich. Der Spieler, der die Suche gestartet hat, hat sich ausgeloggt.
#. fr: Impossible de rejoindre cette équipe. Le recruteur s'est déconnecté.
msgctxt "LogMessage:7443:0:5"
msgid "Unable to join party. Recruiter is offline."
msgstr "Не удалось вступить в группу. Организатор не в сети."

#. ja: クロスワールドパーティを作成しました。<br>クロスワールドパーティは通常パーティと異なるため、パーティに対して影響するアクションの効果が得られなくなります。
#. de: Du bildest eine weltenübergreifende Gruppe. Außerhalb von Instanzen wirken<br>Statuseffekte, die normalerweise die ganze Gruppe betreffen, nur auf den Wirkenden.
#. fr: Une équipe inter-Monde a été formée. <br>Les effets de certaines actions ne s'appliqueront pas aux équipiers.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "LogMessage:7444:0:5"
msgid "Cross-world party formed.<br>Party-wide spells and actions will behave differently."
msgstr "Сформирована межмировая группа.<br>Заклинания и умения, действующие на всю группу, будут работать иначе."

#. ja: 登録できる限界数に達しているため、パーティ募集を登録することができませんでした。
#. de: Eine weitere Suche ist nicht möglich, da die maximale Anzahl erreicht ist.
#. fr: Impossible de lancer le recrutement. La limite a été atteinte.
msgctxt "LogMessage:7445:0:5"
msgid "Registration limit reached. Unable to continue recruitment."
msgstr "Достигнут лимит регистраций. Набор в группу не продолжен."

#. ja: クロスワールドパーティに参加しました。<br>クロスワールドパーティは通常パーティと異なるため、パーティに対して影響するアクションの効果が得られなくなります。
#. de: Du bist einer weltenübergreifenden Gruppe beigetreten. Außerhalb von Instanzen wirken<br>Statuseffekte, die normalerweise die ganze Gruppe betreffen, nur auf den Wirkenden.
#. fr: Vous avez rejoint une équipe inter-Monde. <br>Les effets de certaines actions ne s'appliqueront pas aux équipiers.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "LogMessage:7446:0:5"
msgid "Cross-world party joined.<br>Party-wide spells and actions will behave differently."
msgstr "Вы вступили в межмировую группу.<br>Заклинания и умения, действующие на всю группу, будут работать иначе."

#. ja: <sound 0 71>クロスワールドパーティを解散しました。
#. de: <sound 0 71>Du hast die weltenübergreifende Gruppe aufgelöst.
#. fr: <sound 0 71>L'équipe inter-Monde est dissoute.
#. macro: <sound 0 71> — plays a sound effect; kind = 0, sound = 71 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7447:0:5"
msgid "<sound 0 71>You dissolve the cross-world party."
msgstr "<sound 0 71>Вы распустили межмировую группу."

#. ja: <sound 0 71>クロスワールドパーティが解散されました。
#. de: <sound 0 71>Die weltenübergreifende Gruppe wurde aufgelöst.
#. fr: <sound 0 71><sound 0 71>L'équipe inter-Monde a été dissoute.
#. macro: <sound 0 71> — plays a sound effect; kind = 0, sound = 71 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7448:0:5"
msgid "<sound 0 71>The cross-world party has been disbanded."
msgstr "<sound 0 71>Межмировая группа распущена."

#. ja: パーティ募集サーバーに問題が発生しました。
#. de: Es gab ein Problem mit dem Server für die Gruppen<shy>suche.
#. fr: Une erreur s'est produite au niveau du serveur gérant les recrutements.
msgctxt "LogMessage:7449:0:5"
msgid "A party server error has occurred."
msgstr "Ошибка сервера набора в группу."

#. ja: コンテンツに参加申請中のため、パーティ募集に参加できませんでした。
#. de: Du kannst nicht an der Gruppen<shy>suche teilnehmen, da die Inhaltssuche aktiv ist.
#. fr: Impossible de rejoindre une équipe en étant enregistré pour participer à une mission.
msgctxt "LogMessage:7450:0:5"
msgid "Unable to join party while using the Duty Finder."
msgstr "Не удалось вступить в группу, пока вы ищете контент."

#. ja: パーティ募集の人数を満たしたため終了します。
#. de: Es wurden genügend Grup<shy>pen<shy>mit<shy>glieder gefunden und die Suche daher beendet.
#. fr: Le nombre de personnages ayant été atteint, le recrutement d'équipiers est terminé.
msgctxt "LogMessage:7451:0:5"
msgid "Party recruitment ended. All places have been filled."
msgstr "Набор в группу завершён. Все места заняты."

#. ja: パーティ募集の人数を満たしたため終了します。
#. de: Es wurden genügend Grup<shy>pen<shy>mit<shy>glieder gefunden und die Suche daher beendet.
#. fr: Le nombre de personnages ayant été atteint, le recrutement d'équipiers est terminé.
msgctxt "LogMessage:7452:0:5"
msgid "Party recruitment ended. All places have been filled."
msgstr "Набор в группу завершён. Все места заняты."

#. ja: 募集に設定されているコンテンツを開放していないため、パーティ募集に参加できませんでした。
#. de: Du kannst der Gruppe nicht beitreten, da du den Inhalt noch nicht freigespielt hast.
#. fr: Impossible de rejoindre cette équipe. Vous n'avez pas accès à la mission qui fait l'objet du recrutement.
msgctxt "LogMessage:7453:0:5"
msgid "Unable to join party. Required duty not yet commenced."
msgstr "Не удалось вступить в группу. Требуемый контент ещё не открыт."

#. ja: 募集に設定されているコンテンツをコンプリートしていないため、パーティ募集に参加できませんでした。
#. de: Du kannst der Gruppe nicht beitreten, da du den Inhalt noch nicht abgeschlossen hast.
#. fr: Impossible de rejoindre cette équipe. Vous n'avez pas terminé la mission qui fait l'objet du recrutement.
msgctxt "LogMessage:7454:0:5"
msgid "Unable to join party. Required duty not yet complete."
msgstr "Не удалось вступить в группу. Вы ещё не прошли требуемый контент."

#. ja: コンテンツ「<string $s2>：<string $s3>」、<br>募集者<string $s1>のパーティ募集に参加しました。
#. de: Du trittst der Gruppe von <string $s1> bei. (<string $s2>: <string $s3>)
#. fr: Vous avez rejoint l'équipe recrutée par <string $s1> pour la mission “<string $s2><nbsp>: <string $s3>”.
#. macro: <string $s1> — a text value passed to the string; value = text parameter 1 (game data: keep it; it may move or repeat)
#. macro: <string $s3> — a text value passed to the string; value = text parameter 3 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7455:0:5"
msgid "You join <string $s1>'s party for <string $s3>."
msgstr "Вы вступили в группу <string $s1> для прохождения «<string $s3>»."

#. ja: コンテンツ「<string $s2>」、募集者<string $s1>のパーティ募集に参加しました。
#. de: Du trittst der Gruppe von <string $s1> bei. (<string $s2>)
#. fr: Vous avez rejoint l'équipe recrutée par <string $s1> pour la mission “<string $s2>”.
#. macro: <string $s1> — a text value passed to the string; value = text parameter 1 (game data: keep it; it may move or repeat)
#. macro: <string $s2> — a text value passed to the string; value = text parameter 2 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7456:0:5"
msgid "You join <string $s1>'s party for <string $s2>."
msgstr "Вы вступили в группу <string $s1> для прохождения «<string $s2>»."

#. ja: 勧誘を行ったキャタクターがすでにパーティから離脱しているため、パーティ参加ができませんでした。
#. de: Der Beitritt ist fehlgeschlagen. Der einladende Spieler hat die Gruppe verlassen.
#. fr: Impossible de rejoindre cette équipe. Le personnage qui a envoyé l'invitation l'a quittée.
msgctxt "LogMessage:7457:0:5"
msgid "Unable to join party. The player who invited you has left the party."
msgstr "Не удалось вступить в группу. Пригласивший вас игрок покинул её."

#. ja: 参加先のクロスワールドパーティが定員に達したため、参加できませんでした。
#. de: Der Beitritt ist fehlgeschlagen. Die weltenübergreifende Gruppe ist bereits komplett.
#. fr: Impossible de rejoindre cette équipe inter-Monde. Le nombre de par<shy>ti<shy>ci<shy>pants maximum a été atteint.
msgctxt "LogMessage:7458:0:5"
msgid "Unable to join cross-world party. The party is now full."
msgstr "Не удалось вступить в межмировую группу. В ней больше нет мест."

#. ja: クロスワールドパーティへの参加に失敗しました。
#. de: Der Beitritt zu der weltenübergreifenden Gruppe ist fehlgeschlagen.
#. fr: L'intégration à l'équipe inter-Monde a échoué.
msgctxt "LogMessage:7459:0:5"
msgid "Unable to join cross-world party."
msgstr "Не удалось вступить в межмировую группу."

#. ja: 募集内容が変更されたため、参加がキャンセルされました。
#. de: Du kannst nicht beitreten, weil die Suchkriterien geändert wurden.
#. fr: Participation annulée. Les critères de recrutement ont été modifiés.
msgctxt "LogMessage:7460:0:5"
msgid "Party requirements updated. Participation denied."
msgstr "Требования к группе изменились. Вступление отменено."

#. ja: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>がエリアチェンジ中などの理由により、参加申請できませんでした。
#. de: Teilnahme nicht möglich. <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> wechselt gerade das Areal.
#. fr: Enregistrement impossible. <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> est en train de changer de zone.
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7461:0:5"
msgid "Unable to register. <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> is changing areas."
msgstr "Не удалось подать заявку: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> меняет зону."

#. ja: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>がインスタンスコンテンツにいるため、参加申請できませんでした。
#. de: Teilnahme nicht möglich. <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> wechselt gerade das Areal.
#. fr: Enregistrement impossible. <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> est dans une instance.
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7462:0:5"
msgid "Unable to register. <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> is bound by another duty."
msgstr "Не удалось подать заявку: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> проходит другое задание."

#. ja: 該当コンテンツをパーティ募集で利用するには、拡張パッケージの権利が必要です。
#. de: Teilnahme am gewählten Inhalt nicht möglich. Die entsprechende Erweiterung ist nicht installiert.
#. fr: Effectuer un recrutement pour cette mission requiert l'installation de l'extension correspondante.
msgctxt "LogMessage:7463:0:5"
msgid "Unable to participate in selected content. You must have the proper expansion data installed."
msgstr "Не удалось выбрать этот контент. Установите соответствующее дополнение."

#. ja: パーティ募集用アライアンスを作成しました。<br>アライアンスは通常パーティと異なるため、パーティに対して影響するアクションの効果が得られなくなります。
#. de: Du hast eine weltenübergreifende Gruppe gebildet.<br>Außerhalb von Instanzen wirken Statuseffekte, die normalerweise<br>die ganze Gruppe betreffen, nur auf den Wirkenden.
#. fr: Une alliance a été formée dans le cadre d'un recrutement. <br>Les effets de certaines actions ne s'appliqueront pas aux membres.
msgctxt "LogMessage:7464:0:5"
msgid "Party Finder alliance formed. Party-wide spells and actions will behave differently."
msgstr "Сформирован альянс через поиск группы. Заклинания и умения, действующие на всю группу, будут работать иначе."

#. ja: パーティ募集用アライアンスに参加しました。<br>アライアンスは通常パーティと異なるため、パーティに対して影響するアクションの効果が得られなくなります。
#. de: Du bist einer weltenübergreifenden Gruppe beigetreten.<br>Außerhalb von Instanzen wirken Statuseffekte, die normalerweise<br>die ganze Gruppe betreffen, nur auf den Wirkenden.
#. fr: Vous avez rejoint une alliance dans le cadre d'un recrutement. <br>Les effets de certaines actions ne s'appliqueront pas aux membres.
msgctxt "LogMessage:7465:0:5"
msgid "Party Finder alliance joined. Party-wide spells and actions will behave differently."
msgstr "Вы вступили в альянс через поиск группы. Заклинания и умения, действующие на всю группу, будут работать иначе."

#. ja: コンテンツ「<string $s2>：<string $s3>」、<br>募集者<string $s1>のパーティ募集の<string $s4>に参加しました。
#. de: Du bist der Gruppe „<string $s4>“ (Gruppen<shy>suche von <string $s1> für <string $s2>: <string $s3>) beigetreten.
#. fr: Vous avez rejoint l'équipe “<string $s4>” dans le cadre du recrutement de <string $s1> pour “<string $s2><nbsp>: <string $s3>”.
#. macro: <string $s1> — a text value passed to the string; value = text parameter 1 (game data: keep it; it may move or repeat)
#. macro: <string $s3> — a text value passed to the string; value = text parameter 3 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7466:0:5"
msgid "You have joined <string $s1>'s alliance for <string $s3>."
msgstr "Вы вступили в альянс игрока <string $s1> для <string $s3>."

#. ja: コンテンツ「<string $s2>」、募集者<string $s1>のパーティ募集の<string $s3>に参加しました。
#. de: Du bist der Gruppe „<string $s3>“ (Gruppen<shy>suche von <string $s1> für <string $s2>) beigetreten.
#. fr: Vous avez rejoint l'équipe “<string $s4>” dans le cadre du recrutement de <string $s1> pour “<string $s2>”.
#. macro: <string $s1> — a text value passed to the string; value = text parameter 1 (game data: keep it; it may move or repeat)
#. macro: <string $s2> — a text value passed to the string; value = text parameter 2 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7467:0:5"
msgid "You have joined <string $s1>'s alliance for <string $s2>."
msgstr "Вы вступили в альянс игрока <string $s1> для <string $s2>."

#. ja: <sound 0 71>パーティ募集用アライアンスを解散しました。
#. de: <sound 0 71>Die Allianz für die Gruppen<shy>suche wurde aufgelöst.
#. fr: <sound 0 71>Vous avez dissous l'alliance créée pour le recrutement.
#. macro: <sound 0 71> — plays a sound effect; kind = 0, sound = 71 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7468:0:5"
msgid "<sound 0 71>You dissolve the Party Finder alliance."
msgstr "<sound 0 71>Вы распустили альянс, созданный через поиск группы."

#. ja: <sound 0 71>パーティ募集用アライアンスが解散されました。
#. de: <sound 0 71>Die Allianz für die Gruppen<shy>suche wurde aufgelöst.
#. fr: <sound 0 71>L'alliance créée pour le recrutement est dissoute.
#. macro: <sound 0 71> — plays a sound effect; kind = 0, sound = 71 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7469:0:5"
msgid "<sound 0 71> The Party Finder alliance has been disbanded."
msgstr "<sound 0 71> Альянс, созданный через поиск группы, распущен."

#. ja: 募集に設定されているコンテンツをコンプリート済みのため、パーティ募集に参加できませんでした。
#. de: Teilnahme nicht möglich. Du hast den Inhalt bereits abgeschlossen.
#. fr: Impossible de rejoindre cette équipe. Vous avez déjà terminé la mission qui fait l'objet du recrutement.
msgctxt "LogMessage:7470:0:5"
msgid "Unable to join party. You have already completed the duty specified in the Party Finder's requirements."
msgstr "Не удалось вступить в группу. Вы уже прошли контент, указанный в требованиях набора."

#. ja: 現在の状態では、その操作はできません。
#. de: Diese Aktion ist momentan nicht möglich.
#. fr: Impossible d'exécuter cette commande dans la situation actuelle.
msgctxt "LogMessage:7471:0:5"
msgid "Unable to execute command in current state."
msgstr "Невозможно выполнить действие в текущем состоянии."

#. ja: パブリックフィールドでのアライアンス結成時はパーティ会話には発言できません。<br>アライアンス内の他メンバーとの会話にはアライアンス会話を使用してください。<br>（パーティ会話はコンテンツ開始後から使用可能となります）
#. de: Der Gruppen-Chat steht in Allianzen in öffentlichen Arealen nicht zur Verfügung. Bitte benutze<br>den Allianz-Chat. Der Gruppen-Chat wird verfügbar, sobald die Instanz betreten wird.
#. fr: Le mode de discussion “équipe” n'est pas disponible lors de la formation d'une alliance dans un espace public. <br>Veuillez utiliser le mode de discussion “alliance” pour communiquer avec les autres membres. <br>(Le mode discussion “équipe” est disponible après le début de la mission.)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "LogMessage:7472:0:5"
msgid "The party chat channel is unavailable while forming an alliance in public areas.<br>Please use the alliance channel.<br>The party channel will become available once the duty has commenced."
msgstr "В альянсе, созданном в открытой зоне, нельзя писать в канал группы.<br>Общайтесь с участниками альянса в канале альянса.<br>Канал группы станет доступен после начала контента."

#. ja: アライアンス募集に参加しました。<br>パブリックフィールドでのアライアンスメンバーとの会話は、アライアンス会話を使用してください。
#. de: Du bist einer Allianz beigetreten.<br>Benutze in öffentlichen Arealen den Allianz-Chat, um mit anderen Mitgliedern zu kommunizieren.
#. fr: Vous avez rejoint une alliance. <br>Les effets de certaines actions ne s'appliqueront pas aux membres.
msgctxt "LogMessage:7473:0:5"
msgid "Alliance joined. Use the alliance chat channel to speak with other alliance members."
msgstr "Вы вступили в альянс. Общайтесь с его участниками в канале альянса."

#. ja: クロスワールドパーティに切り替わったため<br>パーティ勧誘が取り下げられました。
#. de: Die Einladung wurde zurückgezogen, weil die Gruppe eine weltenübergreifende Gruppe geworden ist.
#. fr: L'équipe étant désormais inter-Monde, l'invitation a été annulée.
msgctxt "LogMessage:7474:0:5"
msgid "Party status now cross-world. Invites canceled."
msgstr "Группа стала межмировой. Приглашения отменены."

#. ja: ワールド間テレポ申請中のため、パーティ募集に参加できませんでした。
#. de: Keine Gruppen<shy>suche möglich, da du dich auf eine Weltenreise vorbereitest.
#. fr: Impossible de rejoindre cette équipe. Une demande de voyage inter-Monde est en cours de traitement.
msgctxt "LogMessage:7478:0:5"
msgid "Unable to join party while waiting to visit another World."
msgstr "Не удалось вступить в группу, пока вы ждёте посещения другого мира."

#. ja: パーティ募集の設定により、情報が取得できませんでした。
#. de: Mit den aktuellen Einstellungen der Gruppen<shy>suche sind keine Daten abrufbar.
#. fr: Impossible d'obtenir les données. Les réglages de la recherche d'équipe ne le permettent pas.
msgctxt "LogMessage:7479:0:5"
msgid "Unable to obtain information while waiting to visit another World."
msgstr "Не удалось получить данные из-за настроек набора в группу."

#. ja: 身に着けている装備品の中に、耐久度の低いものがあります。
#. de: Ein oder mehrere angelegte Aus<shy>rüs<shy>tungs<shy>teile sind in schlechtem Zustand.
#. fr: Certaines des pièces d'équipement que vous portez sont en mauvaise condition.
msgctxt "LogMessage:7480:0:5"
msgid "The durability of one or more pieces of your gear is noticeably low."
msgstr "Прочность одной или нескольких надетых вещей заметно снизилась."

#. ja: パーティを組んで参加申請したため、フロントライン参加時に所属グランドカンパニーの制限なくマッチングされます。
#. de: Weil ihr euch als Gruppe registriert habt, wird die Spielersuche unabhängig von der Staatlichen Ge<shy>sell<shy>schaft durchgeführt.
#. fr: L'enregistrement ayant été fait en équipe, le groupement automatique se fera sans restriction d'allégeance à une grande compagnie.
msgctxt "LogMessage:7481:0:5"
msgid "You registered while in a party. Grand Company allegiance will be ignored during Frontline matchmaking."
msgstr "Вы зарегистрировались в составе группы. При подборе участников для «Линии фронта» принадлежность к Великой компании не учитывается."

#. ja: パーティ募集が未開放のため、使用できません。
#. de: Die Gruppen<shy>suche ist noch nicht freigeschaltet.
#. fr: Utilisation impossible. L'outil de mission n'a pas été débloqué.
msgctxt "LogMessage:7482:0:5"
msgid "Unable to recruit party members at present."
msgstr "Набор в группу пока недоступен."

#. ja: 申請先のキャラクターがオフラインのため、フレンド申請ができませんでした。
#. de: Keine Freundesanfrage möglich. Der andere Charakter ist nicht angemeldet.
#. fr: Action impossible. Le personnage auquel vous avez envoyé une requête d'ami est déconnecté.
msgctxt "LogMessage:7483:0:5"
msgid "Unable to add to friend list. That player is currently offline."
msgstr "Не удалось добавить игрока в друзья. Сейчас он не в сети."

#. ja: フレンド登録していたキャラクターの情報に更新がありました。
#. de: Daten wurden aktualisiert.
#. fr: Les in<shy>for<shy>ma<shy>tions d'un personnage de votre liste d'amis ont été actualisées.
msgctxt "LogMessage:7484:0:5"
msgid "That player's character data has been updated."
msgstr "Данные персонажа этого игрока обновлены."

#. ja: <string $s1>へのTellの送信に失敗しました。<br>（パーティ募集問い合わせTellへの返信の場合は、【<if ($gn78 == 3)>option<else>Alt</if>+R】キーで返信してください）
#. de: Flüstern nicht möglich. <string $s1> ist auf einer anderen Welt und ihr seid nicht miteinander befreundet.<br>(Drücke <if ($gn78 == 3)>Wahltaste-R<else>Alt+A</if>, um auf Flüstern während der Gruppen<shy>suche zu antworten.)
#. fr: Impossible d'envoyer le murmure à <string $s1>.<br>(Pour répondre aux murmures relatifs au recrutement, utilisez <if ($gn78 == 3)>option<else>Alt</if>+R.)
#. macro: <string $s1> — a text value passed to the string; value = text parameter 1 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
#. macro: <if ($gn78 == 3)>option<else>Alt</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 78 == 3 (condition: may be reworded, restructured, added, or dropped)
msgctxt "LogMessage:7485:0:5"
msgid "Message to <string $s1> could not be sent.<br>That character is on another World server and not on your friend list. Use <if ($gn78 == 3)>option<else>Alt</if>+R to reply to a Party Finder message."
msgstr "Не удалось отправить послание игроку <string $s1>.<br>Этот персонаж находится на другом сервере и не состоит у вас в друзьях. Чтобы ответить на сообщение из поиска группы, нажмите <if ($gn78 == 3)>option<else>Alt</if>+R."

#. ja: 該当のパーティ募集はすでに終了しているため、Tellを送信できませんでした。<br>パーティ募集経由の他ワールドキャラクターとのTellは募集中のみ利用可能です。
#. de: Flüstern konnte nicht gesendet werden, da diese Gruppen<shy>suche bereits beendet ist.
#. fr: Impossible d'envoyer le murmure. Le recrutement est terminé. <br>Les personnages d'autres Mondes ne peuvent être contactés que lors des recrutements.
msgctxt "LogMessage:7486:0:5"
msgid "Unable to send /tell. That party is no longer accepting members."
msgstr "Не удалось отправить послание. Эта группа уже не набирает участников."

#. ja: <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>へフレンド申請をしました。<br>申請の回答が得られないまま1週間が経過すると、自動的に申請は取り下げられます。
#. de: Du hast <if ($gs1 == $gs2)><switch 3><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn7><noun-de ObjStr 2 $gn7 1 3 1><else>{$gs2}</if></if> eine Freund<shy>schaftsanfrage gesendet.<br>Wenn die Anfrage eine Woche lang unbeantwortet bleibt, wird sie automatisch zurückgezogen.
#. fr: Vous envoyez une requête d'ami à <if ($gs1 == $gs2)>vous<else><if $gn7><noun-fr ObjStr 2 $gn7 1 1><else><if (2 == 9)><if $gn66>d'<else>de<nbsp></if><string $gs2><else><if $gn5><sheet Attributive 2 36><string $gs2><else><sheet Attributive 2 28><string $gs2></if></if></if></if>. <br>Elle sera annulée au<shy>to<shy>ma<shy>ti<shy>que<shy>ment si aucune réponse n'a été donnée après une semaine.
#. macro: <if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 7 (condition: may be reworded, restructured, added, or dropped)
#. macro: <noun-en ObjStr 2 $gn7 1 1> — an English noun from a game data sheet, with article and number; sheet = ObjStr, form = 2, row = global number 7, count = 1, case = 1 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "LogMessage:7487:0:5"
msgid "You send a friend request to <if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if>.<br>If a response is not received in a week, the request will be nullified."
msgstr "Вы отправляете запрос на добавление в друзья: <if ($gs1 == $gs2)>себе<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if>.<br>Если в течение недели не будет ответа, запрос автоматически отменится."

#. ja: <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>からフレンド申請されました。<br>申請の回答をしないまま1週間が経過すると、自動的に申請は取り下げられます。
#. de: <if ($gs1 == $gs2)><switch 1><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn7><noun-de ObjStr 2 $gn7 1 1 1><else>{$gs2}</if></if> hat dir eine Freund<shy>schaftsanfrage gesendet.<br>Wenn die Anfrage eine Woche lang unbeantwortet bleibt, wird sie automatisch zurückgezogen.
#. fr: <capitalize><if ($gs1 == $gs2)>vous<else><if $gn7><noun-fr ObjStr 2 $gn7 1 1><else><if (2 == 9)><if $gn66>d'<else>de<nbsp></if><string $gs2><else><if $gn5><sheet Attributive 2 36><string $gs2><else><sheet Attributive 2 28><string $gs2></if></if></if></if></capitalize> vous a envoyé une requête d'ami. <br>Elle sera annulée au<shy>to<shy>ma<shy>ti<shy>que<shy>ment si aucune réponse n'a été donnée après une semaine.
#. macro: <if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 7 (condition: may be reworded, restructured, added, or dropped)
#. macro: <noun-en ObjStr 2 $gn7 1 1> — an English noun from a game data sheet, with article and number; sheet = ObjStr, form = 2, row = global number 7, count = 1, case = 1 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "LogMessage:7488:0:5"
msgid "<if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if> has sent you a friend request.<br>Failing to respond within a week will render the request void."
msgstr "<if ($gs1 == $gs2)>Вы<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if> отправляет вам запрос на добавление в друзья.<br>Если в течение недели не ответить, запрос автоматически отменится."

#. ja: データセンター内にその名前のワールドは存在しません。
#. de: Auf dem Datenzentrum gibt es keine Welt mit diesem Namen.
#. fr: Il n'existe aucun Monde de ce nom dans le centre de traitement de données.
msgctxt "LogMessage:7489:0:5"
msgid "There are no Worlds by that name in this Data Center."
msgstr "В этом дата-центре нет миров с таким названием."

#. ja: フレンド申請回答の期限を過ぎたため、申請が取り下げられました。
#. de: Die Freundesanfrage wurde zurückgezogen, da zu viel Zeit vergangen ist.
#. fr: Le délai de réponse à la requête d'ami étant dépassé, elle a été annulée.
msgctxt "LogMessage:7490:0:5"
msgid "The Friend Request did not receive a response within a week and has been rendered void."
msgstr "Запрос в друзья отменён: на него не ответили в течение недели."

#. ja: この場所では、パーティ募集の表示ができません。
#. de: Am aktuellen Ort kann die Gruppen<shy>suche nicht angezeigt werden.
#. fr: Impossible d'afficher l'outil de mission ici.
msgctxt "LogMessage:7491:0:5"
msgid "The Party Finder cannot be viewed in this location."
msgstr "Здесь нельзя открыть поиск группы."

#. ja: ジョブ重複制限が設定されているため、パーティ募集に参加できませんでした。
#. de: Beitritt in die Gruppe nicht möglich. Nur ein Spieler pro Job erlaubt.
#. fr: Impossible de rejoindre la recherche d'équipe. La limite d'un joueur par job est active.
msgctxt "LogMessage:7492:0:5"
msgid "Unable to join. Only one player per job permitted."
msgstr "Не удалось присоединиться. В группе может быть только один игрок за каждую роль."

#. ja: クロスワールドパーティ結成処理を行えませんでした。
#. de: Die weltenübergreifende Gruppe konnte nicht erstellt werden.
#. fr: La formation de l'équipe inter-Monde n'a pas pu être traitée.
msgctxt "LogMessage:7493:0:5"
msgid "Could not form a cross-world party."
msgstr "Не удалось собрать межмировую группу."

#. ja: 参加できないクラス・ジョブのメンバーがいるため、パーティ募集に参加できませんでした。
#. de: Beitritt nicht möglich. Ein oder mehrere Grup<shy>pen<shy>mit<shy>glieder haben nicht die geforderten Jobs.
#. fr: Impossible de rejoindre la recherche d'équipe. Certains jobs ou classes ne pouvant participer sont présents.
msgctxt "LogMessage:7494:0:5"
msgid "Unable to join. One or more party members do not match the jobs specified in the Party Finder's requirements."
msgstr "Не удалось присоединиться. Один или несколько участников группы не соответствуют требованиям поиска группы по классам и профессиям."

#. ja: 参加条件を満たしていないメンバーがいるため、パーティ募集に参加できませんでした。
#. de: Beitritt nicht möglich. Ein oder mehrere Grup<shy>pen<shy>mit<shy>glieder erfüllen nicht die Teilnahmebedingungen.
#. fr: Impossible de rejoindre la recherche d'équipe. Certains membres ne remplissent pas les conditions de par<shy>ti<shy>ci<shy>pa<shy>tion.
msgctxt "LogMessage:7495:0:5"
msgid "Unable to join. One or more party members do not meet the requirements specified to participate."
msgstr "Не удалось присоединиться. Один или несколько участников группы не соответствуют требованиям."

#. ja: 募集に設定されているコンテンツを開放していないメンバーがいるため、パーティ募集に参加できませんでした。
#. de: Beitritt nicht möglich. Ein oder mehrere Grup<shy>pen<shy>mit<shy>glieder haben den Spielinhalt noch nicht freigeschaltet.
#. fr: Impossible de rejoindre la recherche d'équipe. Certains membres n'ont pas débloqué les missions sé<shy>lec<shy>tion<shy>nées.
msgctxt "LogMessage:7496:0:5"
msgid "Unable to join. One or more party members has yet to unlock the selected duty."
msgstr "Не удалось присоединиться. Один или несколько участников группы ещё не открыли выбранное подземелье."

#. ja: パーティ加入を許可しない状態もしくは操作を行っているメンバーがいるため、募集に参加できませんでした。
#. de: Beitritt nicht möglich. Entweder liegt keine Einladung vor oder die Gruppeneinstellungen wurden geändert.
#. fr: Impossible de rejoindre la recherche d'équipe. Certains membres ne sont pas en mesure de rejoindre l'équipe pour le moment.
msgctxt "LogMessage:7497:0:5"
msgid "Unable to join. Additional party members are not permitted."
msgstr "Не удалось присоединиться. Набор дополнительных участников запрещён."

#. ja: パーティ募集への参加に失敗したプレイヤーがいるため、パーティへの加入処理が行えませんでした。
#. de: Ein oder mehrere Grup<shy>pen<shy>mit<shy>glieder konnten der Gruppe nicht beitreten.
#. fr: L'équipe n'a pas pu être formée. Un ou plusieurs joueurs n'ont pas répondu.
msgctxt "LogMessage:7498:0:5"
msgid "One or more party members failed to join the party."
msgstr "Не удалось собрать группу: один или несколько участников не смогли присоединиться."

#. ja: ストーリーの進行状況等の理由により、パーティ募集に参加できませんでした。
#. de: Beitritt nicht möglich. Fortschritt im Hauptszenario möglicherweise nicht ausreichend.
#. fr: Impossible de rejoindre l'équipe. L'étape de l'épopée où vous vous trouvez ne le permet pas.
msgctxt "LogMessage:7499:0:5"
msgid "Unable to join party due to current quest progression."
msgstr "Не удалось присоединиться к группе из-за текущего этапа задания."

#. ja: このコマンドは「クリスタルコンフリクト」に<br>対戦者として参加しているときのみ使用できます。
#. de: Dieses Kommando kann nur in „Crystalline Conflict“ verwendet werden.
#. fr: Cette commande est disponible uniquement lors de la par<shy>ti<shy>ci<shy>pa<shy>tion à Crystalline Conflict.
msgctxt "LogMessage:7500:0:5"
msgid "This command can only be used when participating in a Crystalline Conflict match."
msgstr "Эта команда доступна только во время матча в «Кристальном конфликте»."

#. ja: よろしくお願いします！<sound 1 96>
#. de: Hallo!<sound 1 96>
#. fr: Salut<nbsp>!<sound 1 96>
#. macro: <sound 1 96> — plays a sound effect; kind = 1, sound = 96 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7501:0:5"
msgid "Hello.<sound 1 96>"
msgstr "Привет!<sound 1 96>"

#. ja: お疲れさまでした！<sound 1 96>
#. de: Gutes Spiel!<sound 1 96>
#. fr: C'était un beau combat<nbsp>!<sound 1 96>
#. macro: <sound 1 96> — plays a sound effect; kind = 1, sound = 96 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7502:0:5"
msgid "Good match!<sound 1 96>"
msgstr "Отличный матч!<sound 1 96>"

#. ja: ありがとう！<sound 1 97>
#. de: Danke!<sound 1 97>
#. fr: Merci<nbsp>!<sound 1 97>
#. macro: <sound 1 97> — plays a sound effect; kind = 1, sound = 97 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7503:0:5"
msgid "Thank you.<sound 1 97>"
msgstr "Спасибо!<sound 1 97>"

#. ja: ナイス！<sound 1 97>
#. de: Gut gemacht!<sound 1 97>
#. fr: Bien joué<nbsp>!<sound 1 97>
#. macro: <sound 1 97> — plays a sound effect; kind = 1, sound = 97 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7504:0:5"
msgid "Nice job!<sound 1 97>"
msgstr "Отлично!<sound 1 97>"

#. ja: 浄化が<if ($n1 == 1)>使えます！<sound 1 98><else>使えません！<sound 1 99></if>
#. de: Purifikation <if ($n1 == 1)>bereit!<sound 1 98><else>nicht bereit!<sound 1 99></if>
#. fr: Dépuration <if ($n1 == 1)>est prête à l'utilisation<nbsp>!<sound 1 98><else>n'est pas prête à l'utilisation<nbsp>!<sound 1 99></if>
#. macro: <if ($n1 == 1)>ready!<sound 1 98><else>not ready!<sound 1 99></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 1 == 1 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sound 1 98> — plays a sound effect; kind = 1, sound = 98 (game data: keep it; it may move or repeat)
#. macro: <sound 1 99> — plays a sound effect; kind = 1, sound = 99 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7505:0:5"
msgid "Purify <if ($n1 == 1)>ready!<sound 1 98><else>not ready!<sound 1 99></if>"
msgstr "Очищение <if ($n1 == 1)>готово!<sound 1 98><else>не готово!<sound 1 99></if>"

#. ja: アドレナリンラッシュ使用<if ($n1 == 1)>可能！<sound 1 98><else>不可です！<sound 1 99></if>
#. de: Adrenalinrausch <if ($n1 == 1)>bereit!<sound 1 98><else>nicht bereit!<sound 1 99></if>
#. fr: Décharge d'adrénaline <if ($n1 == 1)>est prête à l'utilisation<nbsp>!<sound 1 98><else>n'est pas prête à l'utilisation<nbsp>!<sound 1 99></if>
#. macro: <if ($n1 == 1)>ready!<sound 1 98><else>not ready!<sound 1 99></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 1 == 1 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sound 1 98> — plays a sound effect; kind = 1, sound = 98 (game data: keep it; it may move or repeat)
#. macro: <sound 1 99> — plays a sound effect; kind = 1, sound = 99 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7506:0:5"
msgid "Adrenaline Rush <if ($n1 == 1)>ready!<sound 1 98><else>not ready!<sound 1 99></if>"
msgstr "Рывок <if ($n1 == 1)>готов!<sound 1 98><else>не готов!<sound 1 99></if>"

#. ja: オフェンスボックスを狙います！<sound 1 100>
#. de: Ich hebe das Offensiv-Depot aus!<sound 1 100>
#. fr: Je m'occupe du ra<shy>vi<shy>tail<shy>le<shy>ment offensif<nbsp>!<sound 1 100>
#. macro: <sound 1 100> — plays a sound effect; kind = 1, sound = 100 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7507:0:5"
msgid "Collecting offensive supplies!<sound 1 100>"
msgstr "Собираю припасы для атаки!<sound 1 100>"

#. ja: ディフェンスボックスを狙います！<sound 1 100>
#. de: Ich hebe das Defensiv-Depot aus!<sound 1 100>
#. fr: Je m'occupe du ra<shy>vi<shy>tail<shy>le<shy>ment défensif<nbsp>!<sound 1 100>
#. macro: <sound 1 100> — plays a sound effect; kind = 1, sound = 100 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7508:0:5"
msgid "Collecting defensive supplies!<sound 1 100>"
msgstr "Собираю припасы для защиты!<sound 1 100>"

#. ja: アドレナリンボックスを狙います！<sound 1 100>
#. de: Ich hebe das Adrenalin-Depot aus!<sound 1 100>
#. fr: Je m'occupe du ra<shy>vi<shy>tail<shy>le<shy>ment adrénergique<nbsp>!<sound 1 100>
#. macro: <sound 1 100> — plays a sound effect; kind = 1, sound = 100 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7509:0:5"
msgid "Collecting adrenaline supplies!<sound 1 100>"
msgstr "Собираю адреналин!<sound 1 100>"

#. ja: ウルフハートボックスを狙います！<sound 1 100>
#. de: Ich hebe das Wolfsherz-Depot aus!<sound 1 100>
#. fr: Je m'occupe du ra<shy>vi<shy>tail<shy>le<shy>ment cœur-de-loup<nbsp>!<sound 1 100>
#. macro: <sound 1 100> — plays a sound effect; kind = 1, sound = 100 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:7510:0:5"
msgid "Collecting wolf's heart!<sound 1 100>"
