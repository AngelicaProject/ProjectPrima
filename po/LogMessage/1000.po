#. fr: <if ($n1 == 52)>Le <else><if ($n1 == 79)>Le <else><if ($n1 == 88)>Le <else><if ($n1 == 89)>Le <else><if ($n1 == 80)>L'<else><if ($n1 == 81)>L'<else><if ($n1 == 103)>L'<else><if ($n1 == 104)>L'<else><if ($n1 == 91)>Les <else><if ($n1 == 106)>Les <else>La </if></if></if></if></if></if></if></if></if></if><ui-color 571><ui-edge-color 572><sheet Hud $n1 ADDONHUD_NAME></ui-edge-color></ui-color> et <if ($n2 == 52)>le <else><if ($n2 == 79)>le <else><if ($n2 == 88)>le <else><if ($n2 == 89)>le <else><if ($n2 == 80)>l'<else><if ($n2 == 81)>l'<else><if ($n2 == 103)>l'<else><if ($n2 == 104)>l'<else><if ($n2 == 91)>les <else><if ($n2 == 106)>les <else>la </if></if></if></if></if></if></if></if></if></if><ui-color 571><ui-edge-color 572><sheet Hud $n2 ADDONHUD_NAME></ui-edge-color></ui-color> sont désormais disponibles<nbsp>!<br>Consultez la description pour plus de détails.
