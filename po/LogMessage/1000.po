msgctxt "LogMessage:1201:0:5"
msgid "<capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> successfully <if ($gs1 == $gs2)>attach<else>attaches</if> <noun-en Item 1 $n2 1 1> to <noun-en Item 2 $n1 1 1>.<if ($n3 > 0)> <num $n3> materia <if ($n3 > 1)>were<else>was</if> lost in the process.</if>"
msgstr "<capitalize><if ($gs1 == $gs2)>Ты<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> успешно вставляешь <noun-en Item 1 $n2 1 1> в <noun-en Item 2 $n1 1 1>.<if ($n3 > 0)> <num $n3> материи потеряно.</if>"

#. ja: <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>は<sheet Item $n1 0>へのマテリア装着に失敗した……<br>  <sheet Item $n2 0><num $n3>個が粉々に砕け散った……
