msgstr "<capitalize><if ($gs1 == $gs2)>вы<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>обмениваете<else>обменивает</if> <if ($n2 == 1)> один жетон компании<else> <kilo $n2 \",\"> жетонов компании</if> на <if ($n3 == 1)><noun-en Item 1 $n1 1 1><else><num $n3> <noun-en Item 3 $n1 3 1></if>."

#. ja: これ以上<sheet Item $n1 0>を受け取ることはできません。交換できませんでした。
