msgid "A new Aethernet destination is now accessible:<br><sheet PlaceName \"<sheet Aetheryte $n1 9>\" 0>"
msgstr "Открыто новое направление сети эфироитов:<br><sheet PlaceName \"<sheet Aetheryte $n1 9>\" 0>"

