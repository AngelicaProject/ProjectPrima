msgstr "<if ($n2 == 1)>Появился враг<else><capitalize><if $n2><if ($n2 <= 10)><switch $n2><case>один<case>два<case>три<case>четыре<case>пять<case>шесть<case>семь<case>восемь<case>девять<case>десять</switch><else><num $n2></if><else><num $n2></if> враг<if ($n2 == 1)><else>ов</if> появил<if ($n2 == 1)>ся<else>ось</if></capitalize></if>!"

#. ja: 敵の増援が出現！
#. de: Der Gegner hat Verstärkung bekommen!
#. fr: Des renforts ennemis surgissent<nbsp>!
