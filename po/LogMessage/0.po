msgctxt "LogMessage:499:0:5"
msgid "You are no longer selling items in the markets of <if ($n1 == 10)>the <sheet Town $n1 0><else><sheet Town $n1 0></if>."
msgstr "Теперь вы больше не продаёте товары на рынках <if ($n1 == 10)>города <sheet Town $n1 0><else><sheet Town $n1 0></if>."

