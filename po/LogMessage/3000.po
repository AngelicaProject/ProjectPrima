# LogMessage
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 周辺の建造物が倒壊し始めた……
#. de: Die Gebäude beginnen, einzustürzen ...
#. fr: Les édifices alentour sont sur le point de s'effondrer...
msgctxt "LogMessage:3000:0:5"
msgid "The buildings are beginning to collapse..."
msgstr "Здания начинают рушиться..."

#. ja: フリーカンパニーの解散手続きに失敗しました。
#. de: Die Ge<shy>sell<shy>schaft konnte nicht aufgelöst werden.
#. fr: La dissolution de la compagnie libre a échoué.
msgctxt "LogMessage:3001:0:5"
msgid "Unable to dissolve the free company."
msgstr "Не удалось распустить свободную компанию."

#. ja: フリーカンパニーのマスターではないため解散できません。
#. de: Du kannst die Ge<shy>sell<shy>schaft nicht auflösen, weil du nicht der Meister bist.
#. fr: Vous n'êtes pas chef de la compagnie libre. Impossible de la dissoudre.
msgctxt "LogMessage:3002:0:5"
msgid "Only company master can dissolve the company."
msgstr "Распустить компанию может только её глава."

#. ja: マスター以外のメンバーがフリーカンパニーに所属しているため解散できませんでした。
#. de: Die Ge<shy>sell<shy>schaft hat außer dir immer noch Mitglieder und kann daher nicht aufgelöst werden.
#. fr: Il y a encore des membres dans la compagnie libre. Impossible de la dissoudre.
msgctxt "LogMessage:3003:0:5"
msgid "Unable to dissolve the company. There are still members remaining."
msgstr "Не удалось распустить компанию: в ней ещё остались участники."

#. ja: 階級の追加に失敗しました。
#. de: Der Rang konnte nicht hinzugefügt werden.
#. fr: L'ajout du rang a échoué.
msgctxt "LogMessage:3004:0:5"
msgid "Unable to add new rank."
msgstr "Не удалось добавить ранг."

#. ja: 階級名に問題があるため、階級の追加に失敗しました。
#. de: Der Rang konnte nicht hinzugefügt werden, weil der Rangname ungültige Zeichen enthält.
#. fr: Le nom du rang est invalide. L'ajout du rang a échoué.
msgctxt "LogMessage:3005:0:5"
msgid "Unable to add new rank. The name chosen is forbidden."
msgstr "Не удалось добавить ранг. Это название запрещено."

#. ja: 階級任命に失敗しました。
#. de: Die Rangzuweisung ist fehlgeschlagen.
#. fr: La promotion a échoué.
msgctxt "LogMessage:3006:0:5"
msgid "Unable to assign rank."
msgstr "Не удалось назначить ранг."

#. ja: 権限「<sheet FCAuthority 8 0>」がありません。
#. de: Du hast nicht das Recht, Beförderungen durchzuführen.
#. fr: Vous ne disposez pas du droit “Promotion” pour les membres.
msgctxt "LogMessage:3007:0:5"
msgid "You are not authorized to promote/demote company members."
msgstr "У вас нет права повышать и понижать участников свободной компании."

#. ja: 権限「<sheet FCAuthority 2 0>」がありません。
#. de: Du hast nicht das Recht, die Einstellungen in „Ränge und Rechte“ zu verändern.
#. fr: Vous ne disposez pas du droit “Gestion des rangs”.
msgctxt "LogMessage:3008:0:5"
msgid "You are not authorized to change hierarchical settings."
msgstr "У вас нет права изменять настройки рангов."

#. ja: 階級の名称変更に失敗しました。
#. de: Der Rangname konnte nicht geändert werden.
#. fr: Le changement de nom du rang a échoué.
msgctxt "LogMessage:3009:0:5"
msgid "Unable to change rank name."
msgstr "Не удалось переименовать ранг."

#. ja: 階級の設定変更に失敗しました。
#. de: Die Rang-Einstellungen konnten nicht geändert werden.
#. fr: La modification des privilèges a échoué.
msgctxt "LogMessage:3010:0:5"
msgid "Unable to change rank settings."
msgstr "Не удалось изменить настройки ранга."

#. ja: 階級の削除に失敗しました。
#. de: Der Rang konnte nicht entfernt werden.
#. fr: La suppression du rang a échoué.
msgctxt "LogMessage:3011:0:5"
msgid "Unable to delete rank."
msgstr "Не удалось удалить ранг."

#. ja: 階級の順序変更に失敗しました。
#. de: Die Hierarchie der Ränge konnte nicht geändert werden.
#. fr: La modification de la hiérarchie a échoué.
msgctxt "LogMessage:3012:0:5"
msgid "Unable to change rank order."
msgstr "Не удалось изменить порядок рангов."

#. ja: フリーカンパニーからの除名手続きに失敗しました。
#. de: Die Entlassung konnte nicht durchgeführt werden.
#. fr: L'exclusion du membre a échoué.
msgctxt "LogMessage:3013:0:5"
msgid "Unable to discharge."
msgstr "Не удалось исключить участника."

#. ja: フリーカンパニーのマスターは除名できません。
#. de: Der Meister der Ge<shy>sell<shy>schaft kann nicht entlassen werden.
#. fr: Impossible d'exclure le chef de la compagnie libre.
msgctxt "LogMessage:3014:0:5"
msgid "Company master cannot be discharged."
msgstr "Главу свободной компании нельзя исключить."

#. ja: 対象はフリーカンパニーに所属していないため除名手続きに失敗しました。
#. de: Der Charakter ist nicht Mitglied dieser Ge<shy>sell<shy>schaft und kann daher auch nicht entlassen werden.
#. fr: Ce membre ne fait pas partie de la compagnie libre. Exclusion impossible.
msgctxt "LogMessage:3015:0:5"
msgid "Unable to discharge. That character is not a member of your company."
msgstr "Не удалось исключить персонажа: он не состоит в вашей свободной компании."

#. ja: フリーカンパニーからの除名手続きに失敗しました。
#. de: Die Entlassung konnte nicht durchgeführt werden.
#. fr: L'exclusion du membre a échoué.
msgctxt "LogMessage:3016:0:5"
msgid "Unable to discharge."
msgstr "Не удалось исключить участника."

#. ja: 権限「<sheet FCAuthority 7 0>」がありません。
#. de: Du hast nicht das Recht, Entlassungen durchzuführen.
#. fr: Vous ne disposez pas du droit “Exclusion” pour les membres.
msgctxt "LogMessage:3017:0:5"
msgid "You are not authorized to discharge company members."
msgstr "У вас нет права исключать участников свободной компании."

#. ja: フリーカンパニーの脱退手続きに失敗しました。
#. de: Der Austritt aus der Ge<shy>sell<shy>schaft ist nicht möglich.
#. fr: Vous n'avez pas pu quitter la compagnie libre.
msgctxt "LogMessage:3018:0:5"
msgid "Unable to leave free company."
msgstr "Не удалось покинуть свободную компанию."

#. ja: フリーカンパニーのマスターは脱退できません。
#. de: Du bist der Meister der Ge<shy>sell<shy>schaft und kannst daher nicht austreten.
#. fr: Vous êtes chef de la compagnie libre. Impossible de la quitter.
msgctxt "LogMessage:3019:0:5"
msgid "Company master cannot leave the company."
msgstr "Глава свободной компании не может покинуть её."

#. ja: フリーカンパニーに所属していないため脱退手続きに失敗しました。
#. de: Du bist nicht Mitglied dieser Ge<shy>sell<shy>schaft und kannst daher auch nicht austreten.
#. fr: Action impossible.<br>Vous n'êtes pas membre de la compagnie libre.
msgctxt "LogMessage:3020:0:5"
msgid "You have already left the company."
msgstr "Вы уже покинули компанию."

#. ja: カンパニー結成書の受け取りに失敗しました。
#. de: Der Gründungsantrag der Ge<shy>sell<shy>schaft konnte nicht  angenommen werden.
#. fr: Impossible de ratifier la création de la compagnie.
msgctxt "LogMessage:3021:0:5"
msgid "Unable to accept the company petition."
msgstr "Не удалось принять прошение о создании компании."

#. ja: フリーカンパニー名に問題があります。
#. de: Der Name der Freien Ge<shy>sell<shy>schaft enthält ungültige Zeichen.
#. fr: Le nom choisi pour la compagnie libre n'est pas valide.
msgctxt "LogMessage:3022:0:5"
msgid "The name you have chosen is forbidden."
msgstr "Выбранное название запрещено."

#. ja: カンパニー結成書の提出に失敗しました。
#. de: Der Gründungsantrag der Ge<shy>sell<shy>schaft konnte nicht eingereicht werden.
#. fr: La soumission du projet de création de compagnie libre a échoué.
msgctxt "LogMessage:3023:0:5"
msgid "Unable to submit company petition."
msgstr "Не удалось подать прошение о создании компании."

#. ja: カンパニー結成費用が不足しています。
#. de: Du kannst die Gebühr für die Gründung der Ge<shy>sell<shy>schaft nicht aufbringen.
#. fr: Vous n'avez pas assez de fonds. Impossible de soumettre le projet de création de compagnie libre.
msgctxt "LogMessage:3024:0:5"
msgid "Unable to submit company petition. Insufficient gil."
msgstr "Не удалось подать прошение о создании компании: недостаточно гил."

#. ja: カンパニー結成書の破棄に失敗しました。
#. de: Der Gründungsantrag konnte nicht verworfen werden.
#. fr: L'abandon du projet de compagnie libre a échoué.
msgctxt "LogMessage:3025:0:5"
msgid "Unable to cancel petition."
msgstr "Не удалось отозвать прошение."

#. ja: フリーカンパニーへの招待に失敗しました。
#. de: Die Einladung in die Ge<shy>sell<shy>schaft ist abgelaufen.
#. fr: L'invitation dans la compagnie libre a échoué.
msgctxt "LogMessage:3026:0:5"
msgid "Unable to invite player."
msgstr "Не удалось пригласить игрока."

#. ja: 対象が見つからなかったためフリーカンパニーに招待できませんでした。
#. de: Der Charakter wurde nicht gefunden und konnte daher nicht eingeladen werden.
#. fr: Personnage introuvable. L'invitation dans la compagnie libre a échoué.
msgctxt "LogMessage:3027:0:5"
msgid "Unable to locate player. Invite canceled."
msgstr "Игрок не найден. Приглашение отменено."

#. ja: 対象はフリーカンパニーに招待できません。
#. de: Dieser Charakter kann nicht in die Ge<shy>sell<shy>schaft eingeladen werden.
#. fr: Impossible d'inviter cette personne dans la compagnie libre.
msgctxt "LogMessage:3028:0:5"
msgid "Unable to invite player."
msgstr "Не удалось пригласить игрока."

#. ja: 対象はすでにフリーカンパニーに所属しているため招待できません。
#. de: Dieser Charakter ist bereits Mitglied in einer Freien Ge<shy>sell<shy>schaft und kann daher nicht eingeladen werden.
#. fr: Impossible d'inviter cette personne dans la compagnie libre. La cible fait déjà partie d'une compagnie libre.
msgctxt "LogMessage:3029:0:5"
msgid "Unable to invite player already belonging to another free company."
msgstr "Не удалось пригласить игрока: он уже состоит в другой свободной компании."

#. ja: カンパニーに所属していないため招待できません。
#. de: Du bist nicht Mitglied einer Ge<shy>sell<shy>schaft und kannst daher auch niemanden einladen.
#. fr: Vous ne faites partie d'aucune compagnie libre. Impossible de recruter des membres.
msgctxt "LogMessage:3030:0:5"
msgid "Unable to invite player. You do not belong to a free company."
msgstr "Не удалось пригласить игрока: вы не состоите в свободной компании."

#. ja: 権限「<sheet FCAuthority 5 0>」がありません。
#. de: Du hast nicht das Recht, jemanden in die Ge<shy>sell<shy>schaft einzuladen.
#. fr: Vous ne disposez pas du droit “Invitation” pour les membres.
msgctxt "LogMessage:3031:0:5"
msgid "You are not authorized to invite players to your free company."
msgstr "У вас нет права приглашать игроков в свободную компанию."

#. ja: すでに対象をフリーカンパニーに招待しています。
#. de: Du hast diesen Charakter bereits in die Ge<shy>sell<shy>schaft eingeladen.
#. fr: Vous avez déjà invité cette personne à rejoindre la compagnie libre.
msgctxt "LogMessage:3032:0:5"
msgid "That player has already been invited to your free company."
msgstr "Этот игрок уже получил приглашение в вашу свободную компанию."

#. ja: 対象のフリーカンパニー招待数が上限に達しているため招待できません。
#. de: Der Charakter wurde bereits von einer Freien Ge<shy>sell<shy>schaft eingeladen.
#. fr: Le nombre maximum d'invitations a été atteint. Impossible d'inviter cette personne.
msgctxt "LogMessage:3033:0:5"
msgid "Unable to invite player. Maximum number of invites have already been sent."
msgstr "Не удалось пригласить игрока: достигнут лимит приглашений."

#. ja: 対象が「取り込み中」のためフリーカンパニーに招待できませんでした。
#. de: Der Charakter ist gerade beschäftigt und konnte daher nicht eingeladen werden.
#. fr: Impossible d'inviter ce joueur dans la compagnie libre. Il est occupé.
msgctxt "LogMessage:3034:0:5"
msgid "Unable to invite player whose status is Busy."
msgstr "Не удалось пригласить игрока: он занят."

#. ja: フリーカンパニーへの招待が無効のため返答できませんでした。
#. de: Die Einladung in die Ge<shy>sell<shy>schaft ist abgelaufen, daher konntest du nicht darauf antworten.
#. fr: Réponse impossible. L'invitation est invalide.
msgctxt "LogMessage:3035:0:5"
msgid "Unable to reply. Free company invite invalid."
msgstr "Не удалось ответить: приглашение в свободную компанию недействительно."

#. ja: フリーカンパニーへの加入手続きに失敗しました。
#. de: Der Beitritt zur Ge<shy>sell<shy>schaft ist fehlgeschlagen.
#. fr: Impossible de rejoindre la compagnie.
msgctxt "LogMessage:3036:0:5"
msgid "Unable to join company."
msgstr "Не удалось вступить в компанию."

#. ja: フリーカンパニーメンバーの人数が上限に達しているため招待できません。
#. de: Die maximale Menge an Mitgliedern für diese Ge<shy>sell<shy>schaft ist bereits erreicht, daher kannst du niemanden mehr einladen.
#. fr: Le nombre maximum de membres de la compagnie libre a été atteint. Impossible d'inviter cette personne.
msgctxt "LogMessage:3037:0:5"
msgid "Unable to invite player. Your free company can accept no more members."
msgstr "Не удалось пригласить игрока: свободная компания уже набрала максимум участников."

#. ja: すでに3人の署名が集まっているため結成署名リクエストはできません。
#. de: Du hast die erforderlichen drei Unterschriften bereits erhalten, <br>daher kannst du keine Bitte um Unterzeichnung mehr verschicken.
#. fr: 3 signatures ont déjà été obtenues pour cette compagnie libre. Impossible d'envoyer la demande.
msgctxt "LogMessage:3038:0:5"
msgid "Unable to request signature. You already have the required number."
msgstr "Не удалось запросить подпись: нужное число подписей уже собрано."

#. ja: ブラックリスト登録したキャラクターです。フリーカンパニーに招待できません。
#. de: Dieser Charakter steht auf deiner Schwarzen Liste, du kannst ihn daher nicht in die Ge<shy>sell<shy>schaft einladen.
#. fr: Impossible d'inviter cette personne dans la compagnie libre. Elle fait partie de votre liste noire.
msgctxt "LogMessage:3039:0:5"
msgid "Unable to invite player on your blacklist."
msgstr "Не удалось пригласить игрока из чёрного списка."

#. ja: カンパニー結成書の署名が不足しています。
#. de: Auf dem Gründungsantrag fehlen noch Unterschriften.
#. fr: Vous n'avez pas assez de signataires pour soumettre votre projet de compagnie libre.
msgctxt "LogMessage:3040:0:5"
msgid "Insufficient signatures to form a free company."
msgstr "Недостаточно подписей для создания свободной компании."

#. ja: カンパニー結成書を受け取りました。
#. de: Du hast einen Gründungsantrag einer Freien Ge<shy>sell<shy>schaft erhalten.
#. fr: Vous obtenez un formulaire de création de compagnie libre.
msgctxt "LogMessage:3041:0:5"
msgid "Free company petition submitted."
msgstr "Прошение о создании свободной компании подано."

#. ja: フリーカンパニー「<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>」を結成しました。
#. de: Du hast die Freie Ge<shy>sell<shy>schaft „<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>“ gegründet.
#. fr: Vous avez fondé la compagnie libre “<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>”.
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:3042:0:5"
msgid "“<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>” successfully founded!"
msgstr "Свободная компания «<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>» создана."

#. ja: FreeCompany - 「<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>」を結成しました。
#. de: Hiermit ist die Freie Ge<shy>sell<shy>schaft „<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>“ gegründet.
#. fr: La compagnie libre “<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>” a été fondée.
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:3043:0:5"
msgid "“<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>” successfully founded!"
msgstr "Свободная компания «<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>» создана."

#. ja: <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>にカンパニー結成署名リクエストを行いました。
#. de: Du hast <if ($gs1 == $gs2)><switch 4><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn7><noun-de ObjStr 2 $gn7 1 4 1><else>{$gs2}</if></if> gebeten, den Gründungsantrag der Freien Ge<shy>sell<shy>schaft zu unterzeichnen.
#. fr: Vous demandez <if ($gs1 == $gs2)>vous<else><if $gn7><noun-fr ObjStr 7 $gn7 1 1><else><if (7 == 9)><if $gn66>d'<else>de<nbsp></if><string $gs2><else><if $gn5><sheet Attributive 7 36><string $gs2><else><sheet Attributive 7 28><string $gs2></if></if></if></if> de signer votre projet de compagnie libre.
#. macro: <if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 7 (condition: may be reworded, restructured, added, or dropped)
#. macro: <noun-en ObjStr 2 $gn7 1 1> — an English noun from a game data sheet, with article and number; sheet = ObjStr, form = 2, row = global number 7, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:3044:0:5"
msgid "Free company petition signature request sent to <if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if>."
msgstr "Запрос подписи под прошением о создании свободной компании отправлен <if ($gs1 == $gs2)>вам<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if>."

#. ja: 「<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>」のカンパニー結成書に署名しました。
#. de: Du hast den Gründungsantrag der Freien Ge<shy>sell<shy>schaft „<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>“ unterzeichnet.
#. fr: Vous signez le projet de la compagnie libre “<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>”.
#. macro: <if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 8 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet ObjStr $gn8 0> — a value from a game data sheet, such as a name; sheet = ObjStr, row = global number 8, column = 0 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:3045:0:5"
msgid "Free company petition for “<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>” signed."
msgstr "Вы подписали прошение о создании свободной компании «<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>»."

#. ja: 「<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>」からのカンパニー結成署名リクエストを辞退しました。
#. de: Du hast abgelehnt, den Gründungsantrag der Freien Ge<shy>sell<shy>schaft „<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>“ zu unterzeichnen.
#. fr: Vous refusez de signer le projet de la compagnie libre “<if $gn8><sheet ObjStr $gn8 0><else>{$gs3}</if>”.
msgctxt "LogMessage:3046:0:5"
msgid "Free company petition signature request refused."
msgstr "Запрос на подпись прошения о создании свободной компании отклонён."

#. ja: カンパニー結成署名を取り消しました。
#. de: Du hast die Unterschrift zurückgezogen.
#. fr: Vous avez retiré votre signature.
msgctxt "LogMessage:3047:0:5"
msgid "Free company petition signature unsigned."
msgstr "Подпись под прошением о создании свободной компании отозвана."

#. ja: <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>のカンパニー結成署名を破棄しました。
