# LogMessage
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: エリア移動ができませんでした。
#. de: Das Areal konnte nicht gewechselt werden.
#. fr: Vous n'avez pas pu changer de zone.
msgctxt "LogMessage:4000:0:5"
msgid "You were unable to leave the area."
msgstr "Не удалось покинуть зону."

#. ja: Sサイズの土地には畑を1つまでしか配置することができません。
#. de: Auf kleinen Grundstücken kann nur ein Beet angelegt werden.
#. fr: Impossible de placer plusieurs potagers sur les terrains de petite taille.
msgctxt "LogMessage:4001:0:5"
msgid "Only one garden patch may be placed on a small plot of land."
msgstr "На небольшом участке можно разместить только одну грядку."

#. ja: Mサイズの土地には畑を2つまでしか配置することができません。
#. de: Auf mittelgroßen Grundstücken können maximal zwei Beete angelegt werden.
#. fr: Impossible de placer plus de deux potagers sur les terrains de moyenne taille.
msgctxt "LogMessage:4002:0:5"
msgid "Only two garden patches may be placed on a medium plot of land."
msgstr "На участке среднего размера можно разместить не больше двух грядок."

#. ja: これ以上畑を配置することはできません。
#. de: Mehr Beete kannst du hier nicht anlegen.
#. fr: Impossible de placer davantage de potagers sur ce terrain.
msgctxt "LogMessage:4003:0:5"
msgid "You cannot place any more garden patches."
msgstr "Больше грядок разместить нельзя."

#. ja: 作物が残っているため実行できません。
#. de: Nicht möglich, da sich noch Pflanzen im Beet befinden.
#. fr: Action impossible. Il reste encore des semis.
msgctxt "LogMessage:4004:0:5"
msgid "Unable to execute command. All crops must be harvested first."
msgstr "Не удалось выполнить действие. Сначала соберите весь урожай."

#. ja: 種を持っていません。
#. de: Du besitzt kein Saatgut.
#. fr: Vous n'avez pas de graines.
msgctxt "LogMessage:4005:0:5"
msgid "You do not possess seeds."
msgstr "У вас нет семян."

#. ja: 土を持っていません。
#. de: Du besitzt keine Erde.
#. fr: Vous n'avez pas de terreau.
msgctxt "LogMessage:4006:0:5"
msgid "You do not possess soil."
msgstr "У вас нет земли."

#. ja: すでに作物が植わっているため、種をまくことができませんでした。
#. de: Du kannst keine Samen aussäen, da in der Furche schon etwas wächst.
#. fr: Action impossible. Cet emplacement est déjà occupé.
msgctxt "LogMessage:4007:0:5"
msgid "Unable to plant seeds. There is already a crop growing in this bed."
msgstr "Не удалось посеять семена: на этой грядке уже что-то растёт."

#. ja: 種をまくことができませんでした。
#. de: Aussaat fehlgeschlagen.
#. fr: L'ensemencement a échoué.
msgctxt "LogMessage:4008:0:5"
msgid "You were unable to plant seeds."
msgstr "Не удалось посеять семена."

#. ja: 権限「<sheet FCAuthority 55 0>」がありません。
#. de: Du hast nicht das Recht, etwas auszusäen.
#. fr: Vous ne disposez pas du droit “Culture du potager/pots de fleurs”.
msgctxt "LogMessage:4009:0:5"
msgid "You are not authorized to plant seeds."
msgstr "У вас нет права сеять семена."

#. ja: 肥料を持っていません。
#. de: Du besitzt keinen Dünger.
#. fr: Vous n'avez pas d'engrais.
msgctxt "LogMessage:4010:0:5"
msgid "You do not possess fertilizer."
msgstr "У вас нет удобрений."

#. ja: 肥料をあげることができませんでした。
#. de: Düngen fehlgeschlagen.
#. fr: La fertilisation a échoué.
msgctxt "LogMessage:4011:0:5"
msgid "You were unable to fertilize the crop."
msgstr "Не удалось удобрить растение."

#. ja: すでに十分な肥料が与えられています。
#. de: Diese Pflanze ist bereits ausreichend gedüngt.
#. fr: Ce semis a suf<shy>fi<shy>sam<shy>ment été fertilisé.
msgctxt "LogMessage:4012:0:5"
msgid "This crop has already been sufficiently fertilized."
msgstr "Это растение уже достаточно удобрено."

#. ja: 収穫することができませんでした。
#. de: Ernte fehlgeschlagen.
#. fr: La récolte a échoué.
msgctxt "LogMessage:4013:0:5"
msgid "You were unable to harvest the crop."
msgstr "Не удалось собрать урожай."

#. ja: 権限「<sheet FCAuthority 56 0>」がありません。
#. de: Du hast nicht das Recht, zu ernten.
#. fr: Vous ne disposez pas du droit “Récolte des cultures”.
msgctxt "LogMessage:4014:0:5"
msgid "You are not authorized to harvest crops."
msgstr "У вас нет права собирать урожай."

#. ja: 畑<num $n1>に畝<num $n2>を作り、種をまいた。
#. de: Du hast etwas in Beet <num $n1>, Furche <num $n2>, ausgesät.
#. fr: Vous avez planté des graines dans l'emplacement <num $n2> du potager <num $n1>.
#. macro: <switch $n2><case>1st<case>2nd<case>3rd<case>4th<case>5th<case>6th<case>7th<case>8th<case>9th<case>10th</switch> — shows the case whose position equals the value: the first <case> for 1, the second for 2, …; value = number parameter 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <switch $n1><case>1st<case>2nd<case>3rd<case>4th<case>5th<case>6th<case>7th<case>8th<case>9th<case>10th</switch> — shows the case whose position equals the value: the first <case> for 1, the second for 2, …; value = number parameter 1 (condition: may be reworded, restructured, added, or dropped)
msgctxt "LogMessage:4015:0:5"
msgid "You plant seeds in the <switch $n2><case>1st<case>2nd<case>3rd<case>4th<case>5th<case>6th<case>7th<case>8th<case>9th<case>10th</switch> bed, <switch $n1><case>1st<case>2nd<case>3rd<case>4th<case>5th<case>6th<case>7th<case>8th<case>9th<case>10th</switch> patch."
msgstr "Вы посадили семена на <switch $n2><case>первой<case>второй<case>третьей<case>четвёртой<case>пятой<case>шестой<case>седьмой<case>восьмой<case>девятой<case>десятой</switch> грядке участка <switch $n1><case>первого<case>второго<case>третьего<case>четвёртого<case>пятого<case>шестого<case>седьмого<case>восьмого<case>девятого<case>десятого</switch>."

#. ja: 作物に肥料をあげた。
#. de: Du hast die Furche gedüngt.
#. fr: Vous avez fertilisé le semis.
msgctxt "LogMessage:4016:0:5"
msgid "You fertilize the crop."
msgstr "Вы удобрили растение."

#. ja: 作物の元気が出たようだ！
#. de: Der Pflanze geht es wieder besser!
#. fr: Le semis gagne en vigueur<nbsp>!
msgctxt "LogMessage:4017:0:5"
msgid "This crop is doing well."
msgstr "Растение, похоже, ожило!"

#. ja: 枯れた作物を処分し、畝を整理した。
#. de: Du hast die verwelkte Pflanze vernichtet und die Furche wieder hergerichtet.
#. fr: Vous avez retiré un semis fâné.
msgctxt "LogMessage:4018:0:5"
msgid "You remove the withered crop and till the soil."
msgstr "Вы убрали увядшее растение и вскопали грядку."

#. ja: 権限「<sheet FCAuthority 52 0>」がありません。
#. de: Du hast nicht das Recht, Bauelemente oder Ausstattung zu färben.
#. fr: Vous ne disposez pas du droit “Teinture du mobilier”.
msgctxt "LogMessage:4019:0:5"
msgid "You are not authorized to paint fixtures and furnishings."
msgstr "У вас нет права красить предметы интерьера."

#. ja: 3文字以上20文字以下で付けてください。
#. de: Namen müssen aus 3 bis 20 Zeichen bestehen.
#. fr: La séquence doit comporter entre 3 et 20 caractères.
msgctxt "LogMessage:4020:0:5"
msgid "Names must be between 3 and 20 characters."
msgstr "В имени должно быть от 3 до 20 символов."

#. ja: 連続して指定できない文字が含まれています。
#. de: Doppelte Leerzeichen sind nicht erlaubt.
#. fr: Les caractères saisis comportent une séquence interdite.
msgctxt "LogMessage:4021:0:5"
msgid "Name contains characters that cannot be used in succession."
msgstr "В имени есть недопустимые сочетания символов."

#. ja: 余計なスペースが含まれています。
#. de: Ein Leerzeichen vor oder nach dem Namen ist nicht erlaubt.
#. fr: Les caractères saisis comportent une ou plusieurs espaces à des endroits inadéquats.
msgctxt "LogMessage:4022:0:5"
msgid "A space cannot be used before or after the name."
msgstr "В начале и в конце имени не должно быть пробелов."

#. ja: 中毒防止制限中のため、種をまくことができません。
#. de: Das Einsetzen von Pflanzen ist vor<shy>über<shy>gehend nicht möglich.<br>Dies ist eine Maßnahme zur Suchtprävention.
#. fr: Les mesures anti-accoutumance vous interdisent cette action.
msgctxt "LogMessage:4023:0:5"
msgid "You cannot plant any more seeds. Perhaps it is time for a break."
msgstr "Посев семян временно ограничен. Пожалуй, пора отдохнуть."

#. ja: 中毒防止制限中のため、収穫することができません。
#. de: Ernten ist vor<shy>über<shy>gehend nicht möglich.<br>Dies ist eine Maßnahme zur Suchtprävention.
#. fr: Les mesures anti-accoutumance vous interdisent cette action.
msgctxt "LogMessage:4024:0:5"
msgid "You cannot harvest any more crops. Perhaps it is time for a break."
msgstr "Сбор урожая временно ограничен. Пожалуй, пора отдохнуть."

#. ja: 作物を処分し、畝を整理した。
#. de: Du hast die Pflanze vernichtet und die Furche wieder hergerichtet.
#. fr: Vous avez arraché le semis.
msgctxt "LogMessage:4025:0:5"
msgid "You remove the crop and till the soil."
msgstr "Вы убрали растение и вскопали грядку."

#. ja: 権限「<sheet FCAuthority 57 0>」がありません。
#. de: Du hast nicht das Recht, Pflanzen zu vernichten.
#. fr: Vous ne disposez pas du droit “Arrachage des cultures”.
msgctxt "LogMessage:4026:0:5"
msgid "You are not authorized to dispose of crops."
msgstr "У вас нет права убирать растения."

#. ja: ギルが足りません。
#. de: Du hast nicht genug Gil.
#. fr: Vous n'avez pas assez de gils.
msgctxt "LogMessage:4027:0:5"
msgid "You do not have enough gil."
msgstr "У вас недостаточно гил."

#. ja: <num $n1>号室の個室を増築しました。
#. de: Das Gebäude wurde um das persönliche Zimmer Nr. <num $n1> erweitert.
#. fr: Vous avez aménagé la chambre n°<num $n1>.
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:4028:0:5"
msgid "Room #<num $n1> has been added to the estate."
msgstr "В поместье добавлена комната №<num $n1>."

#. ja: <num $n1>号室の個室を増築しました。
#. de: Du hast das Gebäude um dein persönliches Zimmer Nr. <num $n1> erweitert.
#. fr: La chambre n°<num $n1> a été aménagée.
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:4029:0:5"
msgid "Room #<num $n1> has been added to the estate."
msgstr "Вы добавили в поместье комнату №<num $n1>."

#. ja: <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>が<num $n1>号室の個室を増築しました。
#. de: <capitalize><if ($gs1 == $gs2)><switch 1><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn7><noun-de ObjStr 2 $gn7 1 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>hast<else>hat</if> das Gebäude um <if ($gs1 == $gs2)>dein persönliches </if>Zimmer Nr. <num $n1> erweitert.
#. fr: <capitalize><if ($gs1 == $gs2)>vous<else><if $gn7><noun-fr ObjStr 2 $gn7 1 1><else><if (2 == 9)><if $gn66>d'<else>de<nbsp></if><string $gs2><else><if $gn5><sheet Attributive 2 36><string $gs2><else><sheet Attributive 2 28><string $gs2></if></if></if></if></capitalize> <if ($gs1 == $gs2)>avez<else>a</if> aménagé la chambre n°<num $n1>.
#. macro: <capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 7 (condition: may be reworded, restructured, added, or dropped)
#. macro: <noun-en ObjStr 2 $gn7 1 1> — an English noun from a game data sheet, with article and number; sheet = ObjStr, form = 2, row = global number 7, count = 1, case = 1 (game data: keep it; it may move or repeat)
#. macro: <if ($gs1 == $gs2)>add<else>adds</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:4030:0:5"
msgid "<capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>add<else>adds</if> room #<num $n1> to the estate."
msgstr "<capitalize><if ($gs1 == $gs2)>Вы добавляете<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> добавляет</if></capitalize> в поместье комнату №<num $n1>."

#. ja: 個室内にキャラクターがいるため実行できません。
#. de: Der Vorgang kann nicht ausgeführt werden, weil sich jemand im Zimmer befindet.
#. fr: Action impossible.<br>Un autre personnage est dans cette chambre.
msgctxt "LogMessage:4031:0:5"
msgid "Unable to execute command. Someone is within the chambers."
msgstr "Невозможно выполнить действие: в комнате кто-то находится."

#. ja: <num $n1>号室の個室を撤去しました。
#. de: Zimmer Nr. <num $n1>  wurde geräumt.
#. fr: La chambre n°<num $n1> a été détruite.
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:4032:0:5"
msgid "Room #<num $n1> has been demolished."
msgstr "Комната №<num $n1> снесена."

#. ja: <num $n1>号室の個室を撤去しました。
#. de: Du hast Zimmer Nr. <num $n1> geräumt.
#. fr: La chambre n°<num $n1> a été détruite.
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:4033:0:5"
msgid "Room #<num $n1> has been demolished."
msgstr "Вы снесли комнату №<num $n1>."

#. ja: <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>が<num $n1>号室の個室を撤去しました。
#. de: <capitalize><if ($gs1 == $gs2)><switch 1><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn7><noun-de ObjStr 2 $gn7 1 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>hast<else>hat</if> Zimmer Nr. <num $n1> geräumt.
#. fr: <capitalize><if ($gs1 == $gs2)>vous<else><if $gn7><noun-fr ObjStr 2 $gn7 1 1><else><if (2 == 9)><if $gn66>d'<else>de<nbsp></if><string $gs2><else><if $gn5><sheet Attributive 2 36><string $gs2><else><sheet Attributive 2 28><string $gs2></if></if></if></if></capitalize> <if ($gs1 == $gs2)>avez<else>a</if> détruit la chambre n°<num $n1>.
#. macro: <capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 7 (condition: may be reworded, restructured, added, or dropped)
#. macro: <noun-en ObjStr 2 $gn7 1 1> — an English noun from a game data sheet, with article and number; sheet = ObjStr, form = 2, row = global number 7, count = 1, case = 1 (game data: keep it; it may move or repeat)
#. macro: <if ($gs1 == $gs2)>demolish<else>demolishes</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:4034:0:5"
msgid "<capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>demolish<else>demolishes</if> room #<num $n1>."
msgstr "<capitalize><if ($gs1 == $gs2)>Вы сносите<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> сносит</if></capitalize> комнату №<num $n1>."

#. ja: 個室が存在しないため移動できませんでした。
#. de: Kein Zimmer vorhanden.
#. fr: Action impossible.<br>Il n'y a aucune chambre individuelle.
msgctxt "LogMessage:4035:0:5"
msgid "Unable to enter private chambers. The room no longer exists."
msgstr "Не удалось войти в личную комнату: её больше нет."

#. ja: 現在居る個室のため移動できません。
#. de: Du befindest dich bereits in diesem Zimmer.
#. fr: Vous êtes déjà dans cette chambre.
msgctxt "LogMessage:4036:0:5"
msgid "You are already within those chambers."
msgstr "Вы уже в этой комнате."

#. ja: 訪問不可の個室のため移動できません。
#. de: Dieses Zimmer ist nicht öffentlich zugänglich.
#. fr: Action impossible.<br>Les visites ne sont pas autorisées dans cette chambre.
msgctxt "LogMessage:4037:0:5"
msgid "You have not been granted access to those chambers."
msgstr "Вам не разрешён доступ в эту комнату."

#. ja: 個室が存在しないため実行できません。
#. de: Kein Zimmer vorhanden.
#. fr: Action impossible.<br>Il n'y a aucune chambre individuelle.
msgctxt "LogMessage:4038:0:5"
msgid "Unable to change chamber settings. The room no longer exists."
msgstr "Не удалось изменить настройки комнаты: её больше нет."

#. ja: 個室の名前変更に失敗しました。
#. de: Der Name des Zimmers konnte nicht geändert werden.
#. fr: Le nom de la chambre n'a pas pu être changé.
msgctxt "LogMessage:4039:0:5"
msgid "You were unable to change the name of your private chambers."
msgstr "Не удалось изменить название личной комнаты."

#. ja: 個室の名前を「<string $s1>」に変更しました。
#. de: Der Name des Zimmers wurde in „<string $s1>“ geändert.
#. fr: Le nom de la chambre est désormais “<string $s1>”.
#. macro: <string $s1> — a text value passed to the string; value = text parameter 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:4040:0:5"
msgid "You change the name of your private chambers to “<string $s1>.”"
msgstr "Вы переименовали личную комнату в «<string $s1>»."

#. ja: 個室があるため、フリーカンパニーの脱退手続きに失敗しました。
#. de: Der Austritt aus der Ge<shy>sell<shy>schaft ist nicht möglich, weil du noch ein persönliches Zimmer besitzt.
#. fr: Vous n'avez pas pu quitter la compagnie libre, car vous avez une chambre individuelle dans la maison.
msgctxt "LogMessage:4041:0:5"
msgid "You cannot leave the free company before demolishing your private chambers."
msgstr "Нельзя покинуть свободную компанию, пока не снесёте свою личную комнату."

#. ja: そのメンバーの個室があるため、フリーカンパニーの除名手続きに失敗しました。
#. de: Die Entlassung aus der Ge<shy>sell<shy>schaft ist nicht möglich, weil dieses Mitglied noch ein persönliches Zimmer besitzt.
#. fr: L'exclusion du membre a échoué, car il a une chambre individuelle dans la maison.
msgctxt "LogMessage:4042:0:5"
msgid "Unable to discharge from free company. That member's private chambers are still standing."
msgstr "Не удалось исключить участника из свободной компании: его личная комната ещё не снесена."

#. ja: 個室内に調度品が設置されているため撤去できません。
#. de: Das Zimmer kann nicht entfernt werden, da sich noch Ausstattung darin befindet.
#. fr: Impossible de détruire cette chambre à cause du mobilier qui s'y trouve.
msgctxt "LogMessage:4043:0:5"
msgid "Unable to demolish room. All furnishings must first be removed from the chambers."
msgstr "Сначала уберите из комнаты всю мебель."

#. ja: フリーカンパニーのハウス内、もしくは土地に立っていないため撤去できません。
#. de: Entfernen nicht möglich, da du dich nicht im Gebäude bzw. auf dem Grundstück der Ge<shy>sell<shy>schaft befindest.
#. fr: Action impossible.<br>Vous n'êtes pas sur le terrain ou dans la maison de la compagnie.
msgctxt "LogMessage:4044:0:5"
msgid "Unable to demolish room. You must be on free company property."
msgstr "Чтобы снести комнату, нужно находиться на территории свободной компании."

#. ja: 個室が増設されているため撤去できません。
#. de: Das Gebäude kann nicht entfernt werden, da sich darin noch persönliche Zimmer befinden.
#. fr: Démolition impossible. Des chambres individuelles ont été aménagées.
msgctxt "LogMessage:4045:0:5"
msgid "Unable to remove estate hall before all private chambers have been demolished."
msgstr "Сначала снесите все личные комнаты, и только потом убирайте здание поместья."

#. ja: 居住区担当官に資産アイテムを預けているため実行できません。
#. de: Der Befehl konnte nicht ausgeführt werden. Alle Gegenstände befinden sich in der Obhut des Unterkunftsbeamten.
#. fr: Action impossible.<br>Récupérez d'abord vos objets conservés par l'officier du logement.
msgctxt "LogMessage:4046:0:5"
msgid "Unable to execute command. All possessions are being held by a resident caretaker."
msgstr "Не удалось выполнить действие: все вещи находятся на хранении у смотрителя жилого района."

#. ja: フリーカンパニーからの除名により「個室」が撤去されました。
#. de: Dein persönliches Zimmer wurde aufgelöst, da du aus deiner Freien Ge<shy>sell<shy>schaft entlassen wurdest.
#. fr: Votre chambre individuelle a été détruite.
msgctxt "LogMessage:4047:0:5"
msgid "Your private chambers have been demolished."
msgstr "Ваша личная комната снесена."

#. ja: フリーカンパニーからの除名により「個室」が撤去されました。
#. de: Dein persönliches Zimmer wurde aufgelöst, da du aus deiner Freien Ge<shy>sell<shy>schaft entlassen wurdest.
#. fr: Votre chambre individuelle a été détruite.
msgctxt "LogMessage:4048:0:5"
msgid "Your private chambers have been demolished."
msgstr "Ваша личная комната снесена."

#. ja: フリーカンパニーからの除名により「個室」が撤去され、アイテムが居住区担当官に預けられました。
#. de: Dein persönliches Zimmer wurde aufgelöst, da du aus deiner Freien Ge<shy>sell<shy>schaft entlassen wurdest.<br>Das Inventar deines Zimmers wurde beim zuständigen Unterkunftsbeamten hinterlegt.
#. fr: Votre chambre individuelle a été détruite. Les objets qu'elle contenait peuvent être récupérés auprès d'un officier du logement.
msgctxt "LogMessage:4049:0:5"
msgid "Your private chambers have been demolished. All possessions can be retrieved from a resident caretaker."
msgstr "Ваша личная комната снесена. Забрать вещи можно у смотрителя жилого района."

#. ja: フリーカンパニーからの除名により「個室」が撤去され、アイテムが居住区担当官に預けられました。
#. de: Dein persönliches Zimmer wurde aufgelöst, da du aus deiner Freien Ge<shy>sell<shy>schaft entlassen wurdest.<br>Das Inventar deines Zimmers wurde beim zuständigen Unterkunftsbeamten hinterlegt.
#. fr: Votre chambre individuelle a été détruite. Les objets qu'elle contenait peuvent être récupérés auprès d'un officier du logement.
msgctxt "LogMessage:4050:0:5"
msgid "Your private chambers have been demolished. All possessions can be retrieved from a resident caretaker."
msgstr "Ваша личная комната снесена. Забрать вещи можно у смотрителя жилого района."

#. ja: 居住区担当官に預けられていたアイテムが消滅しました。
#. de: Die beim Unterkunftsbeamten hinterlegten Gegenstände wurden vernichtet.
#. fr: Vos objets conservés par les officiers du logement ont été détruits.
msgctxt "LogMessage:4051:0:5"
msgid "All personal possessions still held by the resident caretaker have been destroyed."
msgstr "Все вещи, оставленные на хранение у смотрителя жилого района, уничтожены."

#. ja: 居住区担当官に預けられていたアイテムが消滅しました。
#. de: Die beim Unterkunftsbeamten hinterlegten Gegenstände wurden vernichtet.
#. fr: Vos objets conservés par les officiers du logement ont été détruits.
msgctxt "LogMessage:4052:0:5"
msgid "All personal possessions still held by the resident caretaker have been destroyed."
msgstr "Все вещи, оставленные на хранение у смотрителя жилого района, уничтожены."

#. ja: 作物に別れを告げ、畝を整理した。
#. de: Du winkst deinem Begleiter ein letztes Mal zu.
#. fr: Vous faites vos adieux à votre fidèle mascotte.
msgctxt "LogMessage:4053:0:5"
msgid "You bid a final farewell to your faithful minion."
msgstr "Вы прощаетесь со своим верным слугой."

#. ja: 「<sheet Item $n1 0>」を、美味しく頂いた！
#. de: Du streckst deine Hand nach <noun-de Item 2 $n1 1 3 1> aus und schließt genussvoll deine Augen.
#. fr: Vous avez consommé une partie <noun-fr Item 9 $n1 1 1><nbsp>!
#. macro: <noun-en Item 1 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = Item, form = 1, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:4054:0:5"
msgid "You partake of <noun-en Item 1 $n1 1 1>, and it is sublime."
msgstr "Вы отведали <noun-en Item 1 $n1 1 1> — объедение!"

#. ja: 「<sheet Item $n1 0>」を、最後まで美味しく頂いた！
#. de: <capitalize><noun-de Item 2 $n1 1 1 1></capitalize> hat dir zum letzten Mal einen Genuss bereitet.
#. fr: Vous avez fini <noun-fr Item 2 $n1 1 1><nbsp>!
#. macro: <noun-en Item 3 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = Item, form = 3, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:4055:0:5"
msgid "You partake of the last <noun-en Item 3 $n1 1 1>, and it is sublime."
msgstr "Вы доели последние <noun-en Item 3 $n1 1 1>. Вкуснотища!"

#. ja: 権限「<sheet FCAuthority 61 0>」がないためキャンセルしました。
#. de: Du hast nicht das Recht, Gehilfen zu platzieren bzw. zu entfernen.
#. fr: Vous ne disposez pas du droit “Affectation/Révocation d'un servant”.
msgctxt "LogMessage:4056:0:5"
msgid "You are not authorized to dispatch retainers."
msgstr "У вас нет права назначать слуг."

#. ja: <num $n1>号室の部屋を購入しました。
#. de: Du hast Wohnung Nr. <num $n1> erworben.
#. fr: Vous avez acheté l'appartement n°<num $n1>.
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:4057:0:5"
msgid "You purchase Room #<num $n1>."
msgstr "Вы приобрели комнату №<num $n1>."

#. ja: 部屋内にキャラクターがいるため実行できません。
#. de: Der Vorgang kann nicht ausgeführt werden, weil sich jemand in der Wohnung befindet.
#. fr: Action impossible.<br>Un autre personnage est dans l'appartement.
msgctxt "LogMessage:4058:0:5"
msgid "Unable to execute command. Another player is still in the room."
msgstr "Невозможно выполнить действие: в комнате ещё находится другой игрок."

#. ja: 部屋内に調度品が設置されているため実行できません。
#. de: Der Vorgang kann nicht ausgeführt werden, weil sich Ausstattung in der Wohnung befindet.
#. fr: Impossible de céder cet appartement à cause du mobilier qui s'y trouve.
msgctxt "LogMessage:4059:0:5"
msgid "Unable to execute command. Furniture is still in the room."
msgstr "Невозможно выполнить действие: в комнате осталась мебель."

#. ja: <num $n1>号室の部屋を撤去しました。
#. de: Du hast Wohnung Nr. <num $n1> geräumt.
#. fr: Vous avez cédé l'appartement n°<num $n1>.
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:4060:0:5"
msgid "Room #<num $n1> has been vacated."
msgstr "Комната №<num $n1> освобождена."

#. ja: 部屋が存在しないため移動できませんでした。
#. de: Keine Wohnung vorhanden.
#. fr: Action impossible.<br>L'appartement spécifé n'existe pas.
msgctxt "LogMessage:4061:0:5"
msgid "Unable to move to a room that does not exist."
msgstr "Не удалось перейти в комнату: её не существует."

#. ja: 現在居る部屋のため移動できません。
#. de: Du befindest dich bereits in dieser Wohnung.
#. fr: Vous êtes déjà dans cet appartement.
msgctxt "LogMessage:4062:0:5"
msgid "You are already in that room."
msgstr "Вы уже в этой комнате."

#. ja: 訪問不可の部屋のため移動できません。
#. de: Diese Wohnung ist nicht öffentlich zugänglich.
#. fr: Action impossible.<br>Les visites ne sont pas autorisées dans cet appartement.
msgctxt "LogMessage:4063:0:5"
msgid "Unable to move to a room where access has been denied."
msgstr "Вам не разрешено посещать эту комнату."

#. ja: <sheet PlaceName $n1 0>第<num $n2>区<num $n3>番地の土地を購入しました。
#. de: Du hast das Grundstück <sheet PlaceName $n1 8 2> <num $n2> - <num $n3> erworben.
#. fr: Vous avez acheté le terrain <sheet PlaceName $n1 0> <num $n2> - <num $n3>.
#. macro: <num $n3> — a number; value = number parameter 3 (game data: keep it; it may move or repeat)
#. macro: <num $n2> — a number; value = number parameter 2 (game data: keep it; it may move or repeat)
