msgctxt "LogMessage:4064:0:5"
msgid "You purchase the deed to plot <num $n3>, ward <num $n2>, <noun-en PlaceName 2 $n1 2 1>."
msgstr "Вы приобрели участок <num $n3> в районе <num $n2>, <noun-en PlaceName 2 $n1 2 1>."

