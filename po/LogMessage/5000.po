msgid "The loot rule for <if ($n2 == 1)><noun-en Item 2 $n1 1 1><else>the <num $n2> <noun-en Item 3 $n1 2 1></if> has been changed to Greed Only."
msgstr "Правило распределения добычи для <if ($n2 == 1)><noun-en Item 2 $n1 1 1><else><num $n2> <noun-en Item 3 $n1 2 1></if> изменено на «Только жадность»."

