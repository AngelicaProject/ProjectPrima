msgctxt "LogMessage:5277:0:5"
msgid "Unable to reallocate attributes. Insufficient <noun-en Item 3 $n1 2 1>."
msgstr "Не удалось перераспределить характеристики. Не хватает <noun-en Item 3 $n1 2 1>."

