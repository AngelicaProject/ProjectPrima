msgid "<if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if> shares the strategy board “<string $s2>” with you."
msgstr "<if ($gs1 == $gs2)>Вы поделились<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> поделился</if> с вами стратегической доской «<string $s2>»."

