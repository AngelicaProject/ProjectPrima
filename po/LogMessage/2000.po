# LogMessage
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 近くで新たなF.A.T.E.を発見しました！
#. de: Ein fatales Ereignis geschieht ganz in der Nähe.
#. fr: Un ALÉA s'est produit dans les environs.
msgctxt "LogMessage:2001:0:5"
msgid "FATE discovered nearby!"
msgstr "Поблизости обнаружен FATE!"

#. ja: 邪教の念珠が出現した。
#. de: Ein Kleinod des Ketzers ist erschienen.
#. fr: Un rosaire de culte apparaît.
msgctxt "LogMessage:2002:0:5"
msgid "A cultist rosary appears on the dais."
msgstr "На помосте появился чётчик культиста."

#. ja: 邪教の念珠を手に入れた。
#. de: Du erhältst ein Kleinod des Ketzers.
#. fr: Vous obtenez un rosaire de culte.
msgctxt "LogMessage:2003:0:5"
msgid "You obtain the cultist rosary."
msgstr "Вы получили чётчик культиста."

#. ja: 強力な封印結界が張られている。
#. de: Eine unüberwindbare Barriere hindert dich am Weitergehen.
#. fr: Un puissant champ de force magique bloque le passage...
msgctxt "LogMessage:2004:0:5"
msgid "An impenetrable barrier prevents further progress."
msgstr "Дальше не пройти: путь преграждает непроницаемый барьер."

#. ja: 邪教の宝珠は何者かのエーテルにより守られている！
#. de: Der Sphärolith des Ketzers wird durch ein mysteriöses Ätherfeld geschützt!
#. fr: Une présence protège l'orbe de culte au moyen d'un champ d'énergie éthérée<nbsp>!
msgctxt "LogMessage:2005:0:5"
msgid "The cultist orb is protected by an aetherial field of unknown origin."
msgstr "Неизвестное эфирное поле защищает сферу культиста."

#. ja: 邪教の宝珠を守るエーテルが弱まった！
#. de: Das Ätherfeld vermag den Sphärolithen nicht mehr vollständig zu schützen!
#. fr: Le champ d'énergie éthérée protégeant l'orbe de culte s'est évanoui<nbsp>!
msgctxt "LogMessage:2006:0:5"
msgid "The aetherial field protecting the cultist orb has weakened!"
msgstr "Эфирное поле, защищающее сферу культиста, ослабло!"

#. ja: 邪教の念珠は何者かのエーテルにより守られている！
#. de: Das Kleinod des Ketzers wird durch ein mysteriöses Ätherfeld geschützt!
#. fr: Une présence protège le rosaire de culte au moyen d'un champ d'énergie éthérée<nbsp>!
msgctxt "LogMessage:2007:0:5"
msgid "The cultist rosary is protected by an aetherial field of unknown origin."
msgstr "Неизвестное эфирное поле защищает чётки культиста."

#. ja: 邪教の念珠を守るエーテルが弱まった！
#. de: Das Ätherfeld vermag das Kleinod des Ketzers nicht mehr vollständig zu schützen!
#. fr: Le champ d'énergie éthérée protégeant le rosaire de culte s'est évanoui<nbsp>!
msgctxt "LogMessage:2008:0:5"
msgid "The aetherial field protecting the cultist rosary has weakened!"
msgstr "Эфирное поле, защищающее чётки культиста, ослабло!"

#. ja: <sheet BNpcName $n1 0><if ($n2 == 1)><else>等<num $n2>体</if>が出現！
#. de: <if ($n2 == 1)>Ein Gegner nähert sich<else><num $n2> Gegner nähern sich</if>!
#. fr: <num $n2> <if ($n2 <= 1)>ennemi surgit<else>ennemis surgissent</if><nbsp>!
#. macro: <if ($n2 == 1)>An enemy approaches<else><num $n2> enemies approach</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 2 == 1 (condition: may be reworded, restructured, added, or dropped)
#. macro: <num $n2> — a number; value = number parameter 2 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:2009:0:5"
msgid "<if ($n2 == 1)>An enemy approaches<else><num $n2> enemies approach</if>!"
msgstr "<if ($n2 == 1)>Появился враг<else><num $n2> врагов появилось</if>!"

#. ja: <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>は<sheet EventItem $n1 0>を入手した。
#. de: <capitalize><if ($gs1 == $gs2)><switch 1><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn7><noun-de ObjStr 2 $gn7 1 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>erhältst<else>erhält</if> <noun-de Item 1 $n1 1 4 1>.
#. fr: <capitalize><if ($gs1 == $gs2)>vous<else><if $gn7><noun-fr ObjStr 2 $gn7 1 1><else><if (2 == 9)><if $gn66>d'<else>de<nbsp></if><string $gs2><else><if $gn5><sheet Attributive 2 36><string $gs2><else><sheet Attributive 2 28><string $gs2></if></if></if></if></capitalize> <if ($gs1 == $gs2)>obtenez<else>obtient</if> <noun-fr EventItem 1 $n1 1 1>.
#. macro: <capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 7 (condition: may be reworded, restructured, added, or dropped)
#. macro: <noun-en ObjStr 2 $gn7 1 1> — an English noun from a game data sheet, with article and number; sheet = ObjStr, form = 2, row = global number 7, count = 1, case = 1 (game data: keep it; it may move or repeat)
#. macro: <if ($gs1 == $gs2)>obtain<else>obtains</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <noun-en Item 1 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = Item, form = 1, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:2010:0:5"
msgid "<capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>obtain<else>obtains</if> <noun-en Item 1 $n1 1 1>."
msgstr "<capitalize><if ($gs1 == $gs2)>Вы получаете<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> получает</if></capitalize> <noun-en Item 1 $n1 1 1>."

#. ja: <if $gn7><sheet ObjStr $gn7 0><else>{$gs2}</if>は<sheet EventItem $n1 0>×<num $n2>を入手した。
#. de: <capitalize><if ($gs1 == $gs2)><switch 1><case>du<case>deiner<case>dir<case>dich</switch><else><if $gn7><noun-de ObjStr 2 $gn7 1 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>erhältst<else>erhält</if> <noun-de Item 1 $n1 $n2 4 1>.
#. fr: <capitalize><if ($gs1 == $gs2)>vous<else><if $gn7><noun-fr ObjStr 2 $gn7 1 1><else><if (2 == 9)><if $gn66>d'<else>de<nbsp></if><string $gs2><else><if $gn5><sheet Attributive 2 36><string $gs2><else><sheet Attributive 2 28><string $gs2></if></if></if></if></capitalize> <if ($gs1 == $gs2)>obtenez<else>obtient</if> <if ($n2 == 1)><noun-fr Item 1 $n1 1 1><else><num $n2> <noun-fr Item 12 $n1 $n2 1></if>.
#. macro: <capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 7 (condition: may be reworded, restructured, added, or dropped)
#. macro: <noun-en ObjStr 2 $gn7 1 1> — an English noun from a game data sheet, with article and number; sheet = ObjStr, form = 2, row = global number 7, count = 1, case = 1 (game data: keep it; it may move or repeat)
#. macro: <if ($gs1 == $gs2)>obtain<else>obtains</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global text 1 (the name of the player character) == global text 2 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($n2 == 1)><noun-en Item 1 $n1 1 1><else><num $n2> <noun-en Item 3 $n1 $n2 1></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 2 == 1 (condition: may be reworded, restructured, added, or dropped)
#. macro: <noun-en Item 1 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = Item, form = 1, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
#. macro: <num $n2> — a number; value = number parameter 2 (game data: keep it; it may move or repeat)
#. macro: <noun-en Item 3 $n1 $n2 1> — an English noun from a game data sheet, with article and number; sheet = Item, form = 3, row = number parameter 1, count = number parameter 2, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:2011:0:5"
msgid "<capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>obtain<else>obtains</if> <if ($n2 == 1)><noun-en Item 1 $n1 1 1><else><num $n2> <noun-en Item 3 $n1 $n2 1></if>."
msgstr "<capitalize><if ($gs1 == $gs2)>Вы получаете<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if> получает</if></capitalize> <if ($n2 == 1)><noun-en Item 1 $n1 1 1><else><num $n2> <noun-en Item 3 $n1 $n2 1></if>."

#. ja: <sheet PlaceName $n1 0>の封鎖まであと<num $n2>秒
#. de: Noch <num $n2> <if ($n2 == 1)>Sekunde<else>Sekunden</if>, bis sich <sheet PlaceName $n1 8 3> schließt.
#. fr: Fermeture <sheet PlaceName $n1 8 3> dans <num $n2> secondes.
#. macro: <capitalize><noun-en PlaceName 2 $n1 2 1></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <noun-en PlaceName 2 $n1 2 1> — an English noun from a game data sheet, with article and number; sheet = PlaceName, form = 2, row = number parameter 1, count = 2, case = 1 (game data: keep it; it may move or repeat)
#. macro: <num $n2> — a number; value = number parameter 2 (game data: keep it; it may move or repeat)
#. macro: <if ($n2 == 1)>second<else>seconds</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 2 == 1 (condition: may be reworded, restructured, added, or dropped)
msgctxt "LogMessage:2012:0:5"
msgid "<capitalize><noun-en PlaceName 2 $n1 2 1></capitalize> will be sealed off in <num $n2> <if ($n2 == 1)>second<else>seconds</if>!"
msgstr "<capitalize><noun-en PlaceName 2 $n1 2 1></capitalize> — закрытие через <num $n2> <if ($n2 == 1)>секунду<else>секунд</if>!"

#. ja: <sheet PlaceName $n1 0>が封鎖された！
#. de: <capitalize><sheet PlaceName $n1 8 3></capitalize> hat sich geschlossen.
#. fr: Fermeture <sheet PlaceName $n1 8 3><nbsp>!
#. macro: <capitalize><noun-en PlaceName 2 $n1 2 1></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <noun-en PlaceName 2 $n1 2 1> — an English noun from a game data sheet, with article and number; sheet = PlaceName, form = 2, row = number parameter 1, count = 2, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:2013:0:5"
msgid "<capitalize><noun-en PlaceName 2 $n1 2 1></capitalize> is sealed off!"
msgstr "<capitalize><noun-en PlaceName 2 $n1 2 1></capitalize> перекрыта!"

#. ja: <sheet PlaceName $n1 0>の封鎖が解かれた……
#. de: <capitalize><sheet PlaceName $n1 8 3></capitalize> öffnet sich wieder.
#. fr: Ouverture <sheet PlaceName $n1 8 3><nbsp>!
#. macro: <capitalize><noun-en PlaceName 2 $n1 2 1></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <noun-en PlaceName 2 $n1 2 1> — an English noun from a game data sheet, with article and number; sheet = PlaceName, form = 2, row = number parameter 1, count = 2, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:2014:0:5"
msgid "<capitalize><noun-en PlaceName 2 $n1 2 1></capitalize> is no longer sealed!"
msgstr "<capitalize><noun-en PlaceName 2 $n1 2 1></capitalize> больше не под печатью!"

#. ja: 深淵より炎が灯り、夫人のキャンドルが出現した！
#. de: In der Tiefe leuchten Flammen auf und ein Kerzenträger erscheint!
#. fr: Une flamme brille dans l'obscurité, et la bougie de la Dame en sort<nbsp>!
msgctxt "LogMessage:2015:0:5"
msgid "A light emerges from the darkness of the void!"
msgstr "Из тьмы бездны вспыхнул свет!"

#. ja: グラフィアスの毒尾が脱皮した！
#. de: Graffias' Giftstachel häutet sich!
#. fr: L'aiguillon de Graffias est à vif<nbsp>!
msgctxt "LogMessage:2016:0:5"
msgid "The skin falls off Graffias's tail!"
msgstr "С хвоста Графиаса слезла кожа!"

#. ja: 推奨レベルを大きく超えているため、貢献度が加算されませんでした。
#. de: Deine Stufe ist viel höher als die für das FATE empfohlene, daher wird dir dein Beitrag nicht angerechnet.
#. fr: Votre niveau est largement supérieur à celui recommandé pour cet ALÉA.<br>Votre con<shy>tri<shy>bu<shy>tion a par conséquent été ignorée.
msgctxt "LogMessage:2017:0:5"
msgid "You are far above the recommended level for this FATE. Your contribution will be ignored."
msgstr "Ваш уровень намного выше рекомендуемого для FATE. Ваш вклад не будет учтён."

#. ja: 脱出地点が出現した。「<string $gs56>」の終了まで、あと<num $n1>分。
#. de: Ein Ausgang ist erschienen. Du hast nur noch <num $n1> <if ($n1 == 1)>Minute<else>Minuten</if> hier.
#. fr: Une sortie est apparue. La mission “<capitalize><string $gs56></capitalize>” prendra fin dans <num $n1> <if ($n1 <= 1)>minute<else>minutes</if>.
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
#. macro: <if ($n1 == 1)>minute<else>minutes</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 1 == 1 (condition: may be reworded, restructured, added, or dropped)
msgctxt "LogMessage:2018:0:5"
msgid "An exit has appeared. You have less than <num $n1> <if ($n1 == 1)>minute<else>minutes</if> remaining in the area."
msgstr "Появился выход. В этой области осталось меньше <num $n1> <if ($n1 == 1)>минуты<else>минут</if>."

#. ja: 1人用コンテンツ参加中のため、パーティから離脱しました。
#. de: Du hast deine Gruppe verlassen. Diesen Einsatz musst du alleine ausführen.
#. fr: Vous avez été évincé<if $gn4>e</if> de l'équipe car vous participez à une mission qui doit être effectuée en solo.
msgctxt "LogMessage:2019:0:5"
msgid "You leave your party. This duty must be performed alone."
msgstr "Вы покидаете группу. Это задание нужно проходить в одиночку."

#. ja: 御用邸の道化師が、血文字の紙片を落とした。
#. de: Der Hofnarr lässt ein Stück blutiges Pergament fallen.
#. fr: Le bouffon du manoir laisse derrière lui un parchemin ensanglanté.
msgctxt "LogMessage:2020:0:5"
msgid "The manor jester drops a slip of bloody parchment."
msgstr "Шут из поместья обронил окровавленный клочок пергамента."

#. ja: 御用邸の執事長が、血文字の紙片を落とした。
#. de: Der Seneschall lässt ein Stück blutiges Pergament fallen.
#. fr: L'intendant du manoir laisse derrière lui un parchemin ensanglanté.
msgctxt "LogMessage:2021:0:5"
msgid "The manor steward drops a slip of bloody parchment."
msgstr "Управляющий поместьем обронил окровавленный клочок пергамента."

#. ja: 血文字の紙片を入手した！
#. de: Du erhältst ein blutiges Pergament.
#. fr: Vous obtenez un parchemin ensanglanté.
msgctxt "LogMessage:2022:0:5"
msgid "You obtain the slip of bloody parchment."
msgstr "Вы получили окровавленный клочок пергамента."

#. ja: 封印結界が消滅した！
#. de: Die magische Barriere wurde durchbrochen!
#. fr: La barrière magique est brisée<nbsp>!
msgctxt "LogMessage:2023:0:5"
msgid "The sealed barrier is broken!"
msgstr "Запечатанный барьер разрушен!"

#. ja: ランプの灯りを消した！
#. de: Du hast die Lampe gelöscht!
#. fr: Vous éteignez la lampe.
msgctxt "LogMessage:2024:0:5"
msgid "You extinguish the lamp!"
msgstr "Вы погасили лампу!"

#. ja: 現在のクラス・ジョブが参加条件を満たしていないため、貢献度が加算されませんでした。
#. de: Dein gegenwärtiger Job erfüllt nicht die Teilnahmebedingungen, daher wird dir dein Beitrag nicht angerechnet.
#. fr: Votre classe/job actuel ne remplit pas les conditions de par<shy>ti<shy>ci<shy>pa<shy>tion.<br>Votre con<shy>tri<shy>bu<shy>tion a par conséquent été ignorée.
msgctxt "LogMessage:2025:0:5"
msgid "Your current class or job does not fulfill participation requirements. Your contribution will be ignored."
msgstr "Ваш текущий класс или специализация не отвечает требованиям для участия. Ваш вклад не будет учтён."

#. ja: 推奨レベルに満たない場合、報酬が減額されます。
#. de: Du bist unter der empfohlenen Stufe für das FATE, daher wird dein Beitrag nicht so hoch belohnt.
#. fr: Votre niveau est inférieur à celui recommandé pour cet ALÉA. Vous recevrez une récompense moins importante en cas de réussite.
msgctxt "LogMessage:2026:0:5"
msgid "You are below the recommended level for this FATE. Your contribution will not be weighed as heavily."
msgstr "Ваш уровень ниже рекомендуемого для FATE. Ваш вклад будет оценён ниже."

#. ja: 小さな鍵を拾った。
#. de: Du hast einen kleinen Schlüssel aufgehoben.
#. fr: Vous obtenez une petite clef.
msgctxt "LogMessage:2027:0:5"
msgid "You find a tiny key."
msgstr "Вы нашли крошечный ключ."

#. ja: 6オンズの火薬の包みを手に入れた。
#. de: Du hast 6 Unzen Sprengstoff gefunden.
#. fr: Vous obtenez 6 onz de poudre.
msgctxt "LogMessage:2028:0:5"
msgid "You obtain a six-onze pinch of firesand."
msgstr "Вы получили щепотку огненного песка весом в шесть унций."

#. ja: 火薬穴に爆薬を詰めないと作動しないようだ。
#. de: Du musst Sprengstoff in die Pulverkammern füllen.
#. fr: La mine ne peut pas fonctionner sans de la poudre dans sa chambre.
msgctxt "LogMessage:2029:0:5"
msgid "The blasting device won't work without firesand in the powder chamber."
msgstr "Взрывное устройство не сработает без огненного песка в пороховой камере."

#. ja: 12オンズ分の爆薬を詰められる隙間がある。
#. de: Es scheint Platz für 12 Unzen Sprengstoff zu sein.
#. fr: La chambre semble pouvoir contenir 12 onz de poudre.
msgctxt "LogMessage:2030:0:5"
msgid "The powder chamber appears to hold 12 onzes of firesand."
msgstr "В пороховую камеру, похоже, поместится 12 унций огненного песка."

#. ja: <sheet EventItem $n1 0>を入手した。
#. de: Du hast <noun-de EventItem 1 $n1 1 4 1> erhalten.
#. fr: Vous obtenez <noun-fr EventItem 1 $n1 1 1>.
#. macro: <noun-en EventItem 1 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = EventItem, form = 1, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:2031:0:5"
msgid "You obtain <noun-en EventItem 1 $n1 1 1>."
msgstr "Вы получаете <noun-en EventItem 1 $n1 1 1>."

#. ja: <sheet EventItem $n1 0>×<num $n2>を入手した。
#. de: Du hast <noun-de EventItem 1 $n1 $n2 4 1> erhalten.
#. fr: Vous obtenez <num $n2> <noun-fr EventItem 12 $n1 $n2 1>.
#. macro: <num $n2> — a number; value = number parameter 2 (game data: keep it; it may move or repeat)
#. macro: <noun-en EventItem 3 $n1 $n2 1> — an English noun from a game data sheet, with article and number; sheet = EventItem, form = 3, row = number parameter 1, count = number parameter 2, case = 1 (game data: keep it; it may move or repeat)
msgctxt "LogMessage:2032:0:5"
msgid "You obtain <num $n2> <noun-en EventItem 3 $n1 $n2 1>."
msgstr "Вы получаете <num $n2> <noun-en EventItem 3 $n1 $n2 1>."

#. ja: スイッチらしきものがあるが、今は操作できない……。
#. de: Da ist ein Schalter, aber er scheint noch nicht zu funktionieren.
#. fr: Vous découvrez un bouton, mais il n'a pas l'air de fonctionner pour l'instant.
msgctxt "LogMessage:2033:0:5"
msgid "You discover a switch, but it does not appear to function at this time..."
msgstr "Вы нашли какой-то переключатель, но он пока не работает..."

#. ja: どこかで何かが動いたようだ……。
#. de: Irgendwo hat sich etwas bewegt ...
#. fr: Vous entendez quelque chose bouger au loin.
msgctxt "LogMessage:2034:0:5"
msgid "You hear something move in the distance."
msgstr "Вы слышите, как вдали что-то движется."

#. ja: うおっと毒液！
#. de: Gift!
#. fr: Vous êtes empoisonné<if $gn4>e</if>.
msgctxt "LogMessage:2035:0:5"
msgid "You are doused with poison!"
msgstr "Вас окатило ядом!"

#. ja: 鍵が掛かっているようだ。
#. de: Die Tür ist fest versperrt.
#. fr: La porte est verrouillée.
msgctxt "LogMessage:2036:0:5"
msgid "The door is locked tight."
msgstr "Дверь заперта на замок."

#. ja: 特殊な鍵が必要なようだ。
#. de: Nur ein spezieller Schlüssel kann die Türe aufschließen.
#. fr: Seule une clef spéciale peut ouvrir cette serrure.
msgctxt "LogMessage:2037:0:5"
msgid "Only a special key can open this lock."
