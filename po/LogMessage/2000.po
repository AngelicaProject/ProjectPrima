msgctxt "LogMessage:2709:0:5"
msgid "<if-self $n1>You open<else><capitalize><player-name $n1></capitalize> opens</if-self> a pumpkin chest!"
msgstr "<if-self $n1>Вы открываете<else><capitalize><player-name $n1></capitalize> открывает</if-self> тыквенный сундук!"

#. ja: <player-name $n1>が金庫を開けた！
#. de: <player-name $n1> hat einen Kürbistresor geöffnet!
#. fr: <player-name $n1> a ouvert le coffre proto-trouille !
#. macro: <if-self $n1>You open<else><capitalize><player-name $n1></capitalize> opens</if-self> — shows the first branch when the character is the player reading the text, otherwise the branch after <else>; player = number parameter 1 (condition: may be reworded, restructured, added, or dropped)
