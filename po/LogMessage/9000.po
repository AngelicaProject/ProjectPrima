msgctxt "LogMessage:9996:0:5"
msgid "<capitalize><if ($gs1 == $gs2)>you<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>obtain<else>obtains</if> <num $n2> of a possible <num $n3> <noun-en Item 3 $n1 2 1> due to a stuffed isleventory!"
msgstr "<capitalize><if ($gs1 == $gs2)>Вы<else><if $gn7><noun-en ObjStr 2 $gn7 1 1><else>{$gs2}</if></if></capitalize> <if ($gs1 == $gs2)>получаете<else>получает</if> только <num $n2> из возможных <num $n3> шт.: <noun-en Item 3 $n1 2 1> — инвентарь острова переполнен!"

