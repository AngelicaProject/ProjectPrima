#. ja: 第1節：インコースを狙え
#. de: 1: Immer schön innen
#. fr: CP1 - Toujours à la corde !
msgctxt "ChocoboRaceChallenge:1:0:0"
msgid "Race 1 - Hugging the Inside"
msgstr "Заезд 1 — держись внутренней дорожки"

#. ja: 第2節：範囲攻撃を避けろ
#. de: 2: Vorsicht, Flächenangriff
#. fr: CP2 - Gare aux attaques à aires d'effet !
msgctxt "ChocoboRaceChallenge:2:0:0"
msgid "Race 2 - Keep Away"
msgstr "Заезд 2 — держись подальше"

#. ja: 第3節：アビリティに頼るな
#. de: 3: Fähigkeiten sind nicht alles
#. fr: CP3 - En avant même sans aptitudes !
msgctxt "ChocoboRaceChallenge:3:0:0"
msgid "Race 3 - Inability"
msgstr "Заезд 3 — без умений"

#. ja: 第4節：ヘヴィなレース
#. de: 4: Ein gewichtiges Rennen
#. fr: CP4 - Une course très très pesante !
msgctxt "ChocoboRaceChallenge:4:0:0"
msgid "Race 4 - Heavy Hooves"
msgstr "Заезд 4 — тяжёлые копыта"

#. ja: 第5節：とんずらを阻止せよ
#. de: 5: Hiergeblieben!
#. fr: CP5 - Attention aux départs rapides !
msgctxt "ChocoboRaceChallenge:5:0:0"
msgid "Race 5 - Defending the Rush"
msgstr "Заезд 5 — останови рывок"

#. ja: 第6節：ライバルを叩け
#. de: 6: Rivale auf Trab
#. fr: CP6 - Pas de pitié pour les rivaux !
msgctxt "ChocoboRaceChallenge:6:0:0"
msgid "Race 6 - Road Rivals"
msgstr "Заезд 6 — соперники на пути"

#. ja: 第7節：フィールド・オブ・ドリームズ
#. de: 7: Feld der Träume
#. fr: CP7 - Prendre du champ avec les champs !
msgctxt "ChocoboRaceChallenge:7:0:0"
msgid "Race 7 - Field of Dreams"
msgstr "Заезд 7 — поле мечты"

#. ja: 第8節：漁夫の利を狙え
#. de: 8: Der lachende Dritte
#. fr: CP8 - Laissons les rivaux s'éliminer !
msgctxt "ChocoboRaceChallenge:8:0:0"
msgid "Race 8 - Playing Both Ends"
msgstr "Заезд 8 — сыграть на два фронта"

#. ja: 第9節：スタミナの戦い
#. de: 9: Der längere Atem
#. fr: CP9 - Une bataille d'endurance !
msgctxt "ChocoboRaceChallenge:9:0:0"
msgid "Race 9 - Stamina"
msgstr "Заезд 9 — битва на выносливость"

#. ja: 第10節：逃げる者と追う者と
#. de: 10: Zwei Temperamente
#. fr: CP10 - Course poursuite !
msgctxt "ChocoboRaceChallenge:10:0:0"
msgid "Race 10 - Cat and Mouse"
msgstr "Заезд 10 — кошки-мышки"

#. ja: 第11節：全速で駆け抜けろ
#. de: 11: Volle Kraft voraus
#. fr: CP11 - À bride abattue !
msgctxt "ChocoboRaceChallenge:11:0:0"
msgid "Race 11 - Mad Dash"
msgstr "Заезд 11 — во весь опор"

#. ja: 第12節：アビリティを駆使せよ
#. de: 12: Fähigkeiten ohne Wenn und Extra
#. fr: CP12 - Une épreuve d'aptitude !
msgctxt "ChocoboRaceChallenge:12:0:0"
msgid "Race 12 - Bag of Tricks"
msgstr "Заезд 12 — весь арсенал"

#. ja: 第13節：連携プレイに勝利せよ
#. de: 13: Ein unschlagbares Gespann
#. fr: CP13 - Un travail d'équipe !
msgctxt "ChocoboRaceChallenge:13:0:0"
msgid "Race 13 - Tag Team"
msgstr "Заезд 13 — командная работа"

#. ja: 第14節：続ヘヴィなレース
#. de: 14: Ein äußerst gewichtiges Rennen
#. fr: CP14 - Une course encore plus pesante !
msgctxt "ChocoboRaceChallenge:14:0:0"
msgid "Race 14 - Heavier Hooves"
msgstr "Заезд 14 — копыта ещё тяжелее"

#. ja: 第15節：究極のレース
#. de: 15: Rennen der Superlative
#. fr: CP15 - La course des extrêmes !
msgctxt "ChocoboRaceChallenge:15:0:0"
msgid "Race 15 - Ultimatum"
msgstr "Заезд 15 — решающий забег"
