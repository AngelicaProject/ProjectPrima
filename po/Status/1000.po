#. ja: 強力な雷撃属性の力を得た状態。
#. de: Gebietet über starke blitzbasierte Kräfte.
#. fr: Recèle un éther dan<shy>ge<shy>reu<shy>se<shy>ment porté sur l'élement foudre.
#. column 0: Aspected to Lightning
msgctxt "Status:1280:0:1"
msgid "Harboring a dangerous amount of lightning-aspected aether."
msgstr "В вас заключено опасное количество эфира аспекта молнии."

#. ja: ラフ強化
#. de: Rahu-Kräftigung
#. fr: Rahu renforcé
#. column 1: Rahu's strength is enhanced.
msgctxt "Status:1281:0:0"
msgid "Empowered Rahu"
msgstr "Усиленный Раху"

#. ja: 右腕のラフが強化された状態。
#. de: Rahus Kraft ist verstärkt.
#. fr: Le pouvoir Rahu du bras droit est renforcé.
#. column 0: Empowered Rahu
msgctxt "Status:1281:0:1"
msgid "Rahu's strength is enhanced."
msgstr "Сила Раху возросла."

#. ja: ケトゥ強化
#. de: Ketoh-Kräftigung
#. fr: Ketu renforcé
#. column 1: Ketu's strength is enhanced.
msgctxt "Status:1282:0:0"
msgid "Empowered Ketu"
msgstr "Усиленный Кету"

#. ja: 左腕のケトゥが強化された状態。
#. de: Ketohs Kraft ist verstärkt.
#. fr: Le pouvoir Ketu du bras gauche est renforcé.
#. column 0: Empowered Ketu
msgctxt "Status:1282:0:1"
msgid "Ketu's strength is enhanced."
msgstr "Сила Кету возросла."

#. ja: 混乱
#. de: Konfus
#. fr: Confusion
#. column 1: Attacking allies instead of the enemy.
msgctxt "Status:1283:0:0"
msgid "Confused"
msgstr "Замешательство"

#. ja: 混乱しきった状態。仲間を攻撃し続ける。
#. de: Greift völlig verwirrt die eigenen Kameraden an.
#. fr: La folie fait attaquer les alliés à la place des ennemis.
#. column 0: Confused
msgctxt "Status:1283:0:1"
msgid "Attacking allies instead of the enemy."
msgstr "Вы в замешательстве и атакуете союзников вместо врагов."

#. ja: アクション実行不可
#. de: Außer Gefecht
#. fr: Actions bloquées
#. column 1: Unable to execute actions.
msgctxt "Status:1284:0:0"
msgid "Out of the Action"
msgstr "Не в состоянии действовать"

