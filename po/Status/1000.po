msgctxt "Status:1476:0:1"
msgid "Unable to be an <ui-color 506><ui-edge-color 507>Aether Rot</ui-edge-color></ui-color> carrier."
msgstr "Не может быть носителем <ui-color 506><ui-edge-color 507>эфирной гнили</ui-edge-color></ui-color>."

#. ja: 拘束
#. de: Gefesselt
#. fr: Empoignement
#. column 1: Unable to execute actions.
msgctxt "Status:1477:0:0"
msgid "Fetters"
msgstr "Оковы"

#. ja: 行動できなくなった状態。
#. de: Ist handlungsunfähig.
#. fr: Toute action est impossible.
#. column 0: Fetters
msgctxt "Status:1477:0:1"
msgid "Unable to execute actions."
msgstr "Не может совершать действия."

#. ja: 連結
#. de: Kopplung
#. fr: Attelage
#. column 1: The Phantom Train is slowly leeching your life essence. Damage taken is also increased.
msgctxt "Status:1478:0:0"
msgid "Connectivity"
msgstr "Связь"

#. ja: 魔列車に連結された状態。受けるダメージが増加し、ＨＰが徐々に失われる。
#. de: Spirituelle Kopplung an den Phantomzug. LP nehmen langsam ab und erlittener Schaden ist erhöht.
#. fr: Le corps est relié au train fantôme. Les dégâts reçus sont augmentés et des dégâts périodiques sont subis.
#. column 0: Connectivity
msgctxt "Status:1478:0:1"
msgid "The Phantom Train is slowly leeching your life essence. Damage taken is also increased."
msgstr "Призрачный поезд постепенно высасывает из вас жизненную силу. Вы получаете больше урона."

#. ja: 自由落下
#. de: Freier Fall
#. fr: Chute libre
#. column 1: Decided absence of terra firma is causing an inability to execute certain actions.
msgctxt "Status:1479:0:0"
msgid "Falling"
msgstr "Падение"

#. ja: 自由落下しており、行動に制限を受けている状態。
#. de: Gewisse Handlungsbeschränkungen.
#. fr: Certaines actions sont impossibles du fait d'une chute libre.
#. column 0: Falling
msgctxt "Status:1479:0:1"
msgid "Decided absence of terra firma is causing an inability to execute certain actions."
msgstr "Падает и не может совершать некоторые действия."

#. ja: 無間地獄
#. de: Pandämonium
#. fr: Douleur continuelle
#. column 1: Continuously launching <ui-color 506><ui-edge-color 507>Aratama</ui-edge-color></ui-color> from your body.
msgctxt "Status:1480:0:0"
msgid "Unrelenting Anguish"
msgstr "Бесконечные муки"

#. ja: 絶え間なく荒弾を撃ち続ける状態。
#. de: Ununterbrochene Freisetzung von Aratama.
#. fr: Des Aratama sont libérées continuellement.
#. column 0: Unrelenting Anguish
