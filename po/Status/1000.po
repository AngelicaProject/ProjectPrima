#. column 0: Drubbed
msgctxt "Status:1519:0:1"
msgid "Taking blunt damage over time."
msgstr "Урон от ударов постепенно отнимает HP."

#. ja: 乗り攻防
#. de: Aufgesessen
#. fr: Chevauchée
#. column 1: Riding atop a Rathalos.
msgctxt "Status:1520:0:0"
msgid "Mounted"
msgstr "Верхом"

#. ja: モンスターの背中に乗った状態。
#. de: Reitet auf einem Rathalos.
#. fr: Le Rathalos a été monté avec succès.
#. column 0: Mounted
msgctxt "Status:1520:0:1"
msgid "Riding atop a Rathalos."
msgstr "Вы едете верхом на Раталосе."

#. ja: 気絶
#. de: Betäubung
#. fr: Étourdissement
#. column 1: Unable to act and taking increased damage.
msgctxt "Status:1521:0:0"
msgid "Stun"
msgstr "Оглушение"

