#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "Status:1617:0:1"
msgid "Any auto-attack from a landborne opponent will apply <ui-color 506><ui-edge-color 507>Doom</ui-edge-color></ui-color>."
msgstr "Автоатаки противника, наделённого силой земли, накладывают <ui-color 506><ui-edge-color 507>Рок</ui-edge-color></ui-color>."

#. ja: ロゴスアクション継承
#. de: Logos-Erbe
#. fr: Réminiscence Logos
#. column 1: Ruminating on extracted mnemes. Ready to use select logos actions.
msgctxt "Status:1618:0:0"
msgid "Logos-minded"
msgstr "Постижение логосов"

#. ja: 一時的に継承した状態。特定のロゴスアクションが使用可能になる。
#. de: Hat das Wissen eines Logos-Splitters vor<shy>über<shy>gehend verinnerlicht. Erlaubt spezielle Logos-Kommandos.
#. fr: Des souvenirs étrangers permettent l'utilisation d'actions Logos.
#. column 0: Logos-minded
msgctxt "Status:1618:0:1"
msgid "Ruminating on extracted mnemes. Ready to use select logos actions."
msgstr "Размышляет над извлечёнными мнемами. Можно использовать некоторые логос-действия."

#. ja: 行動中
#. de: Handelt
#. fr: En action
#. column 1: Engaged in complex maneuvers.
msgctxt "Status:1619:0:0"
msgid "Preoccupied"
msgstr "Занят"

#. ja: 何らかの行動を取っている状態。
#. de: Führt gerade verschiedene Handlungen aus.
#. fr: Toute sorte d'actions sont tentées.
#. column 0: Preoccupied
msgctxt "Status:1619:0:1"
msgid "Engaged in complex maneuvers."
msgstr "Выполняет сложные действия."

#. ja: ギルガメッシュチェンジ
#. de: Enthüllt
#. fr: Démasqué
#. column 1: Gilgamesh's true form is revealed.
msgctxt "Status:1620:0:0"
msgid "Unveiled"
msgstr "Раскрыт"

#. ja: 真の姿を現した状態。
#. de: Zeigt seine wahre Gestalt.
#. fr: Gilgamesh a révélé son vrai visage.
#. column 0: Unveiled
msgctxt "Status:1620:0:1"
msgid "Gilgamesh's true form is revealed."
msgstr "Гильгамеш предстал в истинном облике."

#. ja: 潜伏
#. de: Verborgen
#. fr: Camouflage
#. column 1: Unable to be detected from a distance.
msgctxt "Status:1621:0:0"
msgid "Concealed"
msgstr "Скрытность"

#. ja: 姿を隠した状態。接近すると発見される。
#. de: Kann aus der Entfernung nicht gesehen werden.
#. fr: Un subterfuge permet de tromper les regards hostiles à une certaine distance.
#. column 0: Concealed
msgctxt "Status:1621:0:1"
msgid "Unable to be detected from a distance."
msgstr "Не обнаруживается издалека."

#. ja: クリティカル攻撃
#. de: Kritische Attacke
#. fr: Coups critiques
#. column 1: All attacks are dealing critical damage.
msgctxt "Status:1622:0:0"
msgid "Critical Strikes"
msgstr "Критические удары"

#. ja: 全ての攻撃が必ずクリティカルする状態。
#. de: Alle Attacken treffen kritisch.
#. fr: Tous les coups portés sont critiques.
#. column 0: Critical Strikes
msgctxt "Status:1622:0:1"
msgid "All attacks are dealing critical damage."
msgstr "Все атаки наносят критический урон."

#. ja: 雷気充填
#. de: Elektrische Ladung
#. fr: Charge électrique
#. column 1: Crackling like a levinbolt. Damage dealt against opponents vulnerable to electricity is increased.
msgctxt "Status:1623:0:0"
msgid "Live Wire"
msgstr "Заряд молнии"

#. ja: 雷気を帯びた状態。雷を弱点とする敵に対する与ダメージが上昇する。
#. de: Erhöhter Schaden gegen Gegner mit einer Schwäche gegen Elektrizität.
#. fr: Le corps est chargé d'électricité. Les dégâts infligés aux ennemis sensibles à la foudre sont augmentés.
#. column 0: Live Wire
msgctxt "Status:1623:0:1"
msgid "Crackling like a levinbolt. Damage dealt against opponents vulnerable to electricity is increased."
msgstr "Искрится, словно разряд молнии. Урон противникам, уязвимым к электричеству, повышен."

#. ja: サークルプログラム
#. de: Programmschleife
#. fr: Boucle de programme
#. column 1: Corrupted by Omega's program loop.
msgctxt "Status:1624:0:0"
msgid "Looper"
msgstr "Зацикленность"

#. ja: オメガのサークルプログラムに汚染された状態。
#. de: Von Omegas Programmschleife erfasst.
#. fr: L'organisme est corrompu par la boucle de programme d'Oméga.
#. column 0: Looper
msgctxt "Status:1624:0:1"
msgid "Corrupted by Omega's program loop."
msgstr "Заражён программным циклом Омеги."

#. ja: 徐々に忘却
#. de: Allmähliches Vergessen
#. fr: Amnésie graduelle
#. column 1: Gradually forgetting important details. A stack of 6 will result in full memory loss.
msgctxt "Status:1625:0:0"
msgid "Memory Degradation"
msgstr "Ухудшение памяти"

#. ja: 徐々に忘却している状態。6スタックすると忘却してしまう。
#. de: Verursacht bei einer Stapelzahl von 6 den Effekt Vergessen.
#. fr: La mémoire est peu à peu perdue. Tous les souvenirs sont perdus si l'effet est accumulé 6 fois.
#. column 0: Memory Degradation
msgctxt "Status:1625:0:1"
msgid "Gradually forgetting important details. A stack of 6 will result in full memory loss."
msgstr "Постепенно забывает важные подробности. При 6 уровнях эффекта память теряется полностью."

#. ja: 忘却
#. de: Vergessen
#. fr: Amnésie
#. column 1: Bereft of sense of self and purpose.
msgctxt "Status:1626:0:0"
msgid "Memory Loss"
msgstr "Потеря памяти"

#. ja: 記憶が消された状態。
#. de: Erinnerungen sind verloren.
#. fr: La mémoire est perdue et tous les souvenirs ont disparu.
#. column 0: Memory Loss
msgctxt "Status:1626:0:1"
msgid "Bereft of sense of self and purpose."
msgstr "Лишён чувства собственного «я» и цели."

#. ja: 連鎖忘却
#. de: Kette des Vergessens
#. fr: Chaîne d'amnésie
#. column 1: Under siege by what you can no longer remember.
msgctxt "Status:1627:0:0"
msgid "Chains of Memory"
msgstr "Цепь воспоминаний"

#. ja: 記憶に対して攻撃された状態。
#. de: Ein Angriff auf die Erinnerungen.
#. fr: Une agression a été subie via la mémoire.
#. column 0: Chains of Memory
msgctxt "Status:1627:0:1"
