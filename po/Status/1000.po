#. column 0: Dualcast
msgctxt "Status:1378:0:1"
msgid "The next spell will be cast immediately."
msgstr "Следующее заклинание будет произнесено мгновенно."

#. ja: アルマゲスト
#. de: Almagest
#. fr: Almageste
#. column 1: Celestial magicks are causing damage over time.
msgctxt "Status:1379:0:0"
msgid "Almagest"
msgstr "Алмагест"

