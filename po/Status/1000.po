msgctxt "Status:1243:0:1"
msgid "Able to execute <ui-color 500><ui-edge-color 501>Mirage Dive</ui-edge-color></ui-color>."
msgstr "Можно выполнить <ui-color 500><ui-edge-color 501>Миражный прыжок</ui-edge-color></ui-color>."

#. ja: 疾風の極意
#. de: Stürmendes Enigma
#. fr: Énigme du vent
#. column 1: Able to execute <ui-color 500><ui-edge-color 501>Riddle of Wind</ui-edge-color></ui-color>.
msgctxt "Status:1244:0:0"
msgid "Riddle of Wind"
msgstr "Загадка ветра"

#. ja: 疾風の極意を実行できる状態。
#. de: <ui-color 502><ui-edge-color 503>Stürmendes Enigma</ui-edge-color></ui-color> kann ausgeführt werden.
#. fr: Énigme du vent peut être utilisée.
#. column 0: Riddle of Wind
#. macro: <ui-color 500> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 500 (formatting: keep it as often as the source has it)
#. macro: <ui-edge-color 501> — text outline color from the UIColor sheet; </ui-edge-color> restores the previous color; color = 501 (formatting: keep it as often as the source has it)
#. macro: </ui-edge-color> — end of: text outline color from the UIColor sheet; </ui-edge-color> restores the previous color (formatting: keep it as often as the source has it)
