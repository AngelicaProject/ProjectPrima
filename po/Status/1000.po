#. column 0: Skyborne
msgctxt "Status:1690:0:1"
msgid "Drawing power from the firmament."
msgstr "Черпает силу небес."

#. ja: 地の力
#. de: Kraft der Erde
#. fr: Force terrestre
#. column 1: Drawing power from the land itself.
msgctxt "Status:1691:0:0"
msgid "Landborne"
msgstr "Сила земли"

#. ja: 地の力を得た状態。
#. de: Verfügt über die Kraft der Erde.
#. fr: Le corps est investi par la force de la terre.
#. column 0: Landborne
msgctxt "Status:1691:0:1"
msgid "Drawing power from the land itself."
msgstr "Черпает силу самой земли."

#. ja: 守護者の魂
#. de: Geisterwache
#. fr: Résolution des protecteurs
#. column 1: Soul ablaze with the will to protect.
msgctxt "Status:1692:0:0"
msgid "Guardian Spirit"
msgstr "Дух хранителя"

#. ja: 守護者たることを決意した者の魂。
#. de: Der manifestierte Wille, seine Schutzbefohlenen vor Schaden zu bewahren.
#. fr: La personne a trouvé quelqu'un digne de sa protection.
#. column 0: Guardian Spirit
msgctxt "Status:1692:0:1"
msgid "Soul ablaze with the will to protect."
msgstr "Душа пылает решимостью защищать."

#. ja: 斬属性耐性低下
#. de: Hiebresistenz -
#. fr: Résistance au tranchant réduite
#. column 1: Slashing resistance is reduced.
msgctxt "Status:1693:0:0"
msgid "Slashing Resistance Down"
msgstr "Снижение сопротивления рубящим атакам"

#. ja: 斬属性に対する耐性が低下した状態。
#. de: Hiebresistenz ist verringert.
#. fr: La résistance au tranchant est réduite.
#. column 0: Slashing Resistance Down
msgctxt "Status:1693:0:1"
msgid "Slashing resistance is reduced."
msgstr "Сопротивление рубящим атакам снижено."

#. ja: 突属性耐性低下
#. de: Stichresistenz -
#. fr: Résistance au perforant réduite
#. column 1: Piercing resistance is reduced.
msgctxt "Status:1694:0:0"
msgid "Piercing Resistance Down"
msgstr "Снижение сопротивления колющим атакам"

#. ja: 突属性に対する耐性が低下した状態。
#. de: Stichresistenz ist verringert.
#. fr: La résistance au perforant est réduite.
#. column 0: Piercing Resistance Down
msgctxt "Status:1694:0:1"
msgid "Piercing resistance is reduced."
msgstr "Сопротивление колющим атакам снижено."

#. ja: 無気力
#. de: Apathie
#. fr: Apathie
#. column 1: Unable to use HP restoration abilities while MP slowly drains. Not that you care.
msgctxt "Status:1695:0:0"
msgid "Apathetic"
msgstr "Апатия"

#. ja: 無気力になった状態。ＭＰが減少し続け、すべてのＨＰ回復効果が無効化された状態。
#. de: Verliert schrittweise MP. LP können nicht geheilt werden.
#. fr: Des PM sont perdus périodiquement et toute récupération de PV est impossible.
#. column 0: Apathetic
msgctxt "Status:1695:0:1"
msgid "Unable to use HP restoration abilities while MP slowly drains. Not that you care."
msgstr "Не может использовать умения для восстановления HP, а MP постепенно убывает. Ну и ладно."

#. ja: 溺没
#. de: In den Fluten
#. fr: Noyade
#. column 1: Being dragged under by the current. Unable to move or execute actions.
msgctxt "Status:1696:0:0"
msgid "Drowning"
msgstr "Утопление"

#. ja: 溺れている状態。移動およびアクション実行不可。
#. de: Wie von den Fluten verschluckt. Bewegungsunfähig, Kommandos können nicht ausgeführt werden.
#. fr: Impossible d'utiliser des actions ou de se déplacer.
#. column 0: Drowning
msgctxt "Status:1696:0:1"
msgid "Being dragged under by the current. Unable to move or execute actions."
msgstr "Течением утягивает под воду. Невозможно двигаться и использовать умения."

#. ja: 無敵
#. de: Unverwundbar
#. fr: Invulnérable
#. column 1: Invulnerable to all damage.
msgctxt "Status:1697:0:0"
msgid "Invincibility"
msgstr "Неуязвимость"

#. ja: 被ダメージを無効化する状態。
#. de: Erleidet keinen Schaden.
#. fr: Aucun dégât n'est subi.
#. column 0: Invincibility
msgctxt "Status:1697:0:1"
msgid "Invulnerable to all damage."
msgstr "Невосприимчив ко всем видам урона."

#. ja: 突然変異
#. de: Mutationen
#. fr: Mutation
#. column 1: Aetherial instability is triggering mutations.
msgctxt "Status:1698:0:0"
msgid "Mutation"
msgstr "Мутация"

#. ja: 属性エーテルが乱れた環境の影響で、突然変異を起こした状態。
#. de: Die Elementarstruktur des Äthers ist instabil geworden und löst Mutationen aus.
#. fr: L'éther instable de l'environnement a entraîné une soudaine mutation.
#. column 0: Mutation
msgctxt "Status:1698:0:1"
msgid "Aetherial instability is triggering mutations."
msgstr "Нестабильность эфира вызывает мутации."

#. ja: 傀儡の調べ
#. de: Puppencrescendo
#. fr: Mélopée fantoche
#. column 1: The melody of the pyre calls. Will be compelled in the designated direction when the effect ends.
msgctxt "Status:1699:0:0"
msgid "Looming Crescendo"
msgstr "Надвигающееся крещендо"

#. ja: 傀儡の調べを聞かされた状態。カウント0で指定方向に移動してしまう。
#. de: Hat das Puppencrescendo gehört. Läuft in die befohlene Richtung, wenn der Zähler null erreicht.
#. fr: Lorsque le compteur atteint zéro à la fin de la mélopée, le corps avance dans la direction indiquée.
#. column 0: Looming Crescendo
msgctxt "Status:1699:0:1"
msgid "The melody of the pyre calls. Will be compelled in the designated direction when the effect ends."
msgstr "Зов погребального костра неумолим. После окончания эффекта тело двинется в указанном направлении."

#. ja: 突然変異
#. de: Mutationen
#. fr: Mutation
#. column 1: Aetherial instability is triggering mutations.
msgctxt "Status:1700:0:0"
msgid "Mutation"
msgstr "Мутация"

#. ja: 属性エーテルが乱れた環境の影響で、突然変異を起こした状態。
#. de: Die Elementarstruktur des Äthers ist instabil geworden und löst Mutationen aus.
#. fr: L'éther instable de l'environnement a entraîné une soudaine mutation.
#. column 0: Mutation
msgctxt "Status:1700:0:1"
msgid "Aetherial instability is triggering mutations."
msgstr "Нестабильность эфира вызывает мутации."

#. ja: 防御フィールド
#. de: Schutzfeld
#. fr: Champ de protection
#. column 1: Encased by a highly charged protective barrier.
msgctxt "Status:1701:0:0"
msgid "Electromagnetic Field"
msgstr "Электромагнитное поле"

#. ja: 防御フィールドの効果を受けている状態。
#. de: Durch ein Schutzfeld geschützt.
#. fr: Sous l'effet d'un champ de protection.
#. column 0: Electromagnetic Field
msgctxt "Status:1701:0:1"
msgid "Encased by a highly charged protective barrier."
msgstr "Защищён мощным защитным барьером."

#. ja: 氷属性耐性低下
#. de: Frostbeule
#. fr: Résistance à la glace réduite
#. column 1: Ice resistance is reduced.
msgctxt "Status:1702:0:0"
msgid "Ice Resistance Down"
msgstr "Снижение сопротивления льду"

#. ja: 氷属性に対する耐性が低下した状態。
#. de: Empfindlich gegen Kälte.
#. fr: La résistance à l'élément glace est réduite.
#. column 0: Ice Resistance Down
msgctxt "Status:1702:0:1"
msgid "Ice resistance is reduced."
msgstr "Сопротивление льду снижено."

#. ja: ハッキング
#. de: Nervenschock
#. fr: Piratage
#. column 1: Mind is being infiltrated. Will be temporarily stunned when the effect ends.
msgctxt "Status:1703:0:0"
msgid "Biohacked"
msgstr "Взлом сознания"

#. ja: 神経系がハッキングを受けている状態。カウント0でスタン状態に陥る。
#. de: Verursacht Betäubung, sobald der Zähler auf Null sinkt.
#. fr: Le système nerveux a été piraté. Subit l'effet Étourdissement lorsque le compteur atteint zéro.
#. column 0: Biohacked
msgctxt "Status:1703:0:1"
msgid "Mind is being infiltrated. Will be temporarily stunned when the effect ends."
msgstr "Сознание взламывают. После окончания эффекта наступит кратковременное оглушение."

#. ja: サークルプログラム
#. de: Programmschleife
#. fr: Boucle de programme
#. column 1: Corrupted by Omega's program loop.
msgctxt "Status:1704:0:0"
msgid "Looper"
msgstr "Зацикливание"

#. ja: オメガのサークルプログラムに汚染された状態。
#. de: Von Omegas Programmschleife erfasst.
#. fr: L'organisme est corrompu par la boucle de programme d'Oméga.
#. column 0: Looper
msgctxt "Status:1704:0:1"
msgid "Corrupted by Omega's program loop."
msgstr "Поражён циклической программой Омеги."

#. ja: かくれる
#. de: Versteckt
#. fr: Dissimulation
#. column 1: Unable to be detected. Movement speed is severely reduced.
msgctxt "Status:1705:0:0"
msgid "Hidden"
msgstr "Скрытность"

#. ja: 身を隠している状態。移動速度が低下した状態。
#. de: Kann nicht gesehen werden, aber Be<shy>we<shy>gungs<shy>ge<shy>schwin<shy>dig<shy>keit ist verringert.
#. fr: Invisible à la plupart des ennemis, mais la vitesse de déplacement est réduite.
#. column 0: Hidden
msgctxt "Status:1705:0:1"
msgid "Unable to be detected. Movement speed is severely reduced."
msgstr "Невозможно обнаружить. Скорость передвижения значительно снижена."

#. ja: 回避力アップ
#. de: Ausweich-Bonus
#. fr: Bonus d'esquive
#. column 1: Evasion is enhanced.
msgctxt "Status:1706:0:0"
msgid "Evasion Up"
msgstr "Повышение уклонения"

#. ja: 回避力が向上した状態。
#. de: Die Fähigkeit des Ausweichens ist verbessert.
#. fr: L'esquive est augmentée.
#. column 0: Evasion Up
msgctxt "Status:1706:0:1"
msgid "Evasion is enhanced."
msgstr "Уклонение повышено."

#. ja: 右側未解析
#. de: Rechts verborgen
#. fr: Flanc droit protégé
#. column 1: Only vulnerabilities on the right side of the body remain undetected. Hits to the front, back, and left sides of the body will result in severe damage.
msgctxt "Status:1707:0:0"
msgid "Right Unseen"
msgstr "Правая сторона не раскрыта"

#. ja: 身体の右側面のみ急所を見抜かれていない状態。<br>正面、左側、背面から攻撃を受けると、大ダメージを受ける。
#. de: Schwachstellen auf der rechten Seite des Körpers bleiben verborgen.<br>Treffer an der vorderen, linken und hinteren Seite des Körpers führen zu hohem Schaden.
#. fr: Seuls les points faibles du côté droit restent inconnus de l'ennemi. Les attaques en provenance de l'avant, de la gauche et de l'arrière infligent d'importants dégâts.
#. column 0: Right Unseen
msgctxt "Status:1707:0:1"
msgid "Only vulnerabilities on the right side of the body remain undetected. Hits to the front, back, and left sides of the body will result in severe damage."
msgstr "Уязвимости правой стороны тела остаются незамеченными. Попадания спереди, сзади и слева наносят серьёзный урон."

#. ja: 左側未解析
#. de: Links verborgen
#. fr: Flanc gauche protégé
#. column 1: Only vulnerabilities on the left side of the body remain undetected. Hits to the front, back, and right sides of the body will result in severe damage.
msgctxt "Status:1708:0:0"
msgid "Left Unseen"
msgstr "Левая сторона не раскрыта"

#. ja: 身体の左側面のみ急所を見抜かれていない状態。<br>正面、右側、背面から攻撃を受けると、大ダメージを受ける。
#. de: Schwachstellen auf der linken Seite des Körpers bleiben verborgen.<br>Treffer an der vorderen, rechten und hinteren Seite des Körpers führen zu hohem Schaden.
#. fr: Seuls les points faibles du côté gauche restent inconnus de l'ennemi. Les attaques en provenance de l'avant, de la droite et de l'arrière infligent d'importants dégâts.
#. column 0: Left Unseen
msgctxt "Status:1708:0:1"
msgid "Only vulnerabilities on the left side of the body remain undetected. Hits to the front, back, and right sides of the body will result in severe damage."
msgstr "Уязвимости левой стороны тела остаются незамеченными. Попадания спереди, сзади и справа наносят серьёзный урон."

#. ja: 背面未解析
#. de: Hinten verborgen
#. fr: Dos protégé
#. column 1: Only vulnerabilities on the back of the body remain undetected. Hits to the front, right, and left sides of the body will result in severe damage.
msgctxt "Status:1709:0:0"
msgid "Back Unseen"
msgstr "Спина не видна"

#. ja: 身体の背面のみ急所を見抜かれていない状態。<br>正面、右側、左側から攻撃を受けると、大ダメージを受ける。
#. de: Schwachstellen auf der hinteren Seite des Körpers bleiben verborgen.<br>Treffer an der vorderen, linken und rechten Seite des Körpers führen zu hohem Schaden.
#. fr: Seuls les points faibles à l'arrière du corps restent inconnus de l'ennemi. Les attaques en provenance de l'avant, de la droite et de la gauche infligent d'importants dégâts.
#. column 0: Back Unseen
msgctxt "Status:1709:0:1"
msgid "Only vulnerabilities on the back of the body remain undetected. Hits to the front, right, and left sides of the body will result in severe damage."
msgstr "Уязвимости на спине остаются незамеченными. Атаки спереди, справа и слева наносят сильный урон."

#. ja: 光の腕
#. de: Arm des Lichts
#. fr: Bras de Lumière
#. column 1: Astrally charged attacks are enhanced.
msgctxt "Status:1710:0:0"
msgid "Astral Essence"
msgstr "Астральная сущность"

#. ja: 光属性攻撃を強化している状態。
#. de: Lichtbasierte Angriffe sind verstärkt.
#. fr: Les attaques de Lumière sont renforcées.
#. column 0: Astral Essence
msgctxt "Status:1710:0:1"
msgid "Astrally charged attacks are enhanced."
msgstr "Астральные атаки усилены."

#. ja: 闇の腕
#. de: Arm der Dunkelheit
#. fr: Bras de Ténèbres
#. column 1: Umbrally charged attacks are enhanced.
msgctxt "Status:1711:0:0"
msgid "Umbral Essence"
msgstr "Умбральная сущность"

#. ja: 闇属性攻撃を強化している状態。
#. de: Dunkelheitbasierte Angriffe sind verstärkt.
#. fr: Les attaques de Ténèbres sont renforcées.
#. column 0: Umbral Essence
msgctxt "Status:1711:0:1"
msgid "Umbrally charged attacks are enhanced."
msgstr "Умбральные атаки усилены."

#. ja: 光の衣
#. de: Gewand des Lichts
#. fr: Robe de Lumière
#. column 1: Enshrouded in light and resistant to certain umbrally charged attacks.
msgctxt "Status:1712:0:0"
msgid "Astral Cloak"
msgstr "Астральный покров"

#. ja: 光をまとった状態。特定の闇属性攻撃に対する耐性を得る。
#. de: In Licht gehüllt. Schützt vor bestimmten dunkelheitbasierten Angriffen.
#. fr: Un voile de Lumière entoure le corps, lui conférant une résistance à certaines attaques de Ténèbres.
#. column 0: Astral Cloak
msgctxt "Status:1712:0:1"
msgid "Enshrouded in light and resistant to certain umbrally charged attacks. "
msgstr "Вы окутаны светом и защищены от некоторых умбральных атак."

#. ja: 闇の衣
#. de: Gewand der Dunkelheit
#. fr: Robe de Ténèbres
#. column 1: Enshrouded in shadow and resistant to certain astrally charged attacks.
msgctxt "Status:1713:0:0"
msgid "Umbral Cloak"
msgstr "Умбральный покров"

#. ja: 闇をまとった状態。特定の光属性攻撃に対する耐性を得る。
#. de: In Dunkelheit gehüllt. Schützt vor bestimmten lichtbasierten Angriffen.
#. fr: Un voile de Ténèbres entoure le corps, lui conférant une résistance à certaines attaques de Lumière.
#. column 0: Umbral Cloak
msgctxt "Status:1713:0:1"
msgid "Enshrouded in shadow and resistant to certain astrally charged attacks."
msgstr "Вы окутаны тьмой и защищены от некоторых астральных атак."

#. ja: ペイン
#. de: Blutung
#. fr: Saignement
#. column 1: Sustaining damage over time.
msgctxt "Status:1714:0:0"
msgid "Bleeding"
msgstr "Кровотечение"

#. ja: 無属性ダメージにより、ＨＰが徐々に失われる状態。
#. de: Erleidet schrittweise Schaden.
#. fr: Des dégâts périodiques neutres sont subis.
#. column 0: Bleeding
msgctxt "Status:1714:0:1"
msgid "Sustaining damage over time."
msgstr "Вы постепенно теряете HP."

#. ja: 腐臭
#. de: Faulgestank
#. fr: Remugle
#. column 1: Damage dealt is reduced.
msgctxt "Status:1715:0:0"
msgid "Malodorous"
msgstr "Зловоние"

#. ja: 与えるダメージが低下した状態。
#. de: Ausgeteilter Schaden ist verringert.
#. fr: Les dégâts infligés sont réduits.
#. column 0: Malodorous
msgctxt "Status:1715:0:1"
msgid "Damage dealt is reduced."
msgstr "Наносимый урон снижен."

#. ja: 力溜め
#. de: Starksammeln
#. fr: Accumulation
#. column 1: Potency of next offensive spell is increased.
msgctxt "Status:1716:0:0"
msgid "Boost"
msgstr "Усиление"

#. ja: 次の魔法攻撃の威力が上昇する状態。
#. de: Der Attacke-Wert der nächsten magischen Attacke ist erhöht.
#. fr: La puissance du prochain sort est augmentée.
#. column 0: Boost
msgctxt "Status:1716:0:1"
msgid "Potency of next offensive spell is increased."
msgstr "Урон следующего атакующего заклинания повышен."

#. ja: ガードオファ
#. de: Eingeschüchtert
#. fr: Sans défense
#. column 1: Damage taken is increased.
msgctxt "Status:1717:0:0"
msgid "Off-guard"
msgstr "Беззащитность"

#. ja: 受けるダメージが増加する状態。
#. de: Erlittener Schaden ist erhöht.
#. fr: Les dégâts reçus sont augmentés.
#. column 0: Off-guard
msgctxt "Status:1717:0:1"
msgid "Damage taken is increased."
msgstr "Получаемый урон повышен."

#. ja: 狂戦士化
#. de: Ekstatischer Kampf
#. fr: Forcené
#. column 1: Damage dealt and movement speed are increased. <ui-color 506><ui-edge-color 507>Waning Nocturne</ui-edge-color></ui-color> will take hold when the effect ends.
msgctxt "Status:1718:0:0"
msgid "Waxing Nocturne"
msgstr "Растущая ночь"

#. ja: 与えるダメージと移動速度が上昇する状態。効果終了時に狂戦士化の反動状態が付与される。
#. de: Ausgeteilter Schaden und Bewegungstempo sind erhöht. Bei Ablauf wird „Ermüdung des ekstatischen Kampfes“ ausgelöst.
#. fr: Les dégâts infligés et la vitesse de déplacement sont augmentés. Contrecoup du forcené est subit quand cet effet prend fin.
#. column 0: Waxing Nocturne
#. macro: <ui-color 506> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 506 (formatting: keep it as often as the source has it)
#. macro: <ui-edge-color 507> — text outline color from the UIColor sheet; </ui-edge-color> restores the previous color; color = 507 (formatting: keep it as often as the source has it)
#. macro: </ui-edge-color> — end of: text outline color from the UIColor sheet; </ui-edge-color> restores the previous color (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "Status:1718:0:1"
msgid "Damage dealt and movement speed are increased. <ui-color 506><ui-edge-color 507>Waning Nocturne</ui-edge-color></ui-color> will take hold when the effect ends."
msgstr "Наносимый урон и скорость передвижения повышены. По окончании эффекта на вас наложится <ui-color 506><ui-edge-color 507>Угасающая ночь</ui-edge-color></ui-color>."

#. ja: マイティガード
#. de: Totalabwehr
#. fr: Garde puissante
#. column 1: Damage taken and dealt are reduced, while enmity is increased.
msgctxt "Status:1719:0:0"
msgid "Mighty Guard"
msgstr "Могучая защита"

#. ja: 受けるダメージを軽減し、自身に向けられる敵視が上昇する代わりに、与ダメージが低下する状態。
#. de: Erlittener und ausgeteilter Schaden ist verringert, Feindseligkeit gegen dich erhöht.
#. fr: Les dégâts reçus et infligés sont réduits, et l'inimitié est augmentée.
#. column 0: Mighty Guard
msgctxt "Status:1719:0:1"
msgid "Damage taken and dealt are reduced, while enmity is increased."
msgstr "Получаемый и наносимый урон снижены, а уровень враждебности повышен."

#. ja: アイススパイク
#. de: Eisstachel
#. fr: Pointes de glace
#. column 1: Upon taking physical damage, sharpened spikes deal ice damage to the attacking opponent, potentially slowing them.
msgctxt "Status:1720:0:0"
msgid "Ice Spikes"
msgstr "Ледяные шипы"

#. ja: 物理攻撃を受けた場合、攻撃してきた相手に氷属性ダメージを与える状態。また、一定確率でスロウ状態を付与する。
#. de: Wenn physischer Schaden erlitten wird, wird eine Eisattacke auf den Angreifer ausgeführt. Kann zusätzlich „Gemach“ auslösen.
#. fr: Chaque attaque physique subie entraîne une riposte infligeant des dégâts de glace qui a des chances d'infliger Lenteur.
#. column 0: Ice Spikes
msgctxt "Status:1720:0:1"
msgid "Upon taking physical damage, sharpened spikes deal ice damage to the attacking opponent, potentially slowing them."
msgstr "При получении физического урона вы наносите атакующему урон льдом и можете замедлить его."

#. ja: 不思議な光
#. de: Unheimliche Aura
#. fr: Lumière sinistre
#. column 1: Magic damage taken is increased.
msgctxt "Status:1721:0:0"
msgid "Peculiar Light"
msgstr "Странный свет"

#. ja: 受ける魔法ダメージが増加する状態。
#. de: Erlittener Magieschaden ist erhöht.
#. fr: Les dégâts magiques reçus sont augmentés.
#. column 0: Peculiar Light
msgctxt "Status:1721:0:1"
msgid "Magic damage taken is increased."
msgstr "Получаемый магический урон повышен."

#. ja: 超硬化
#. de: Diamantrücken
#. fr: Blindage
#. column 1: Though unable to move, damage taken is reduced.
msgctxt "Status:1722:0:0"
msgid "Diamondback"
msgstr "Алмазная спина"

#. ja: 身動きが取れないが、受けるダメージが軽減される状態。
#. de: Macht be<shy>we<shy>gungs<shy>un<shy>fäh<shy>ig, verringert aber auch erlittenen Schaden.
#. fr: Il est impossible de se mouvoir, mais les dégâts reçus sont réduits.
#. column 0: Diamondback
msgctxt "Status:1722:0:1"
msgid "Though unable to move, damage taken is reduced."
msgstr "Вы не можете двигаться, но получаемый урон снижен."

#. ja: 裂傷
#. de: Beißender Wind
#. fr: Brûlure du vent
#. column 1: Sustaining wind damage over time.
msgctxt "Status:1723:0:0"
msgid "Windburn"
msgstr "Ожог ветром"

#. ja: 風属性ダメージにより、ＨＰが徐々に失われる状態。
#. de: Erleidet schrittweise Windschaden.
#. fr: Des dégâts périodiques de vent sont subis.
#. column 0: Windburn
msgctxt "Status:1723:0:1"
msgid "Sustaining wind damage over time."
msgstr "Вы постепенно теряете HP от урона ветром."

#. ja: 水神のヴェール
#. de: Wogenschleier
#. fr: Voile du Déchaîneur
#. column 1: Dealing water damage to attackers upon taking damage.
msgctxt "Status:1724:0:0"
msgid "Veil of the Whorl"
msgstr "Вуаль Водоворота"

#. ja: ダメージを受けた場合、攻撃してきた相手に水属性ダメージを与える状態。
#. de: Wenn Schaden erlitten wird, wird eine Wasserattacke auf den Angreifer ausgeführt.
#. fr: Chaque attaque subie entraîne une riposte infligeant des dégâts d'eau.
#. column 0: Veil of the Whorl
msgctxt "Status:1724:0:1"
msgid "Dealing water damage to attackers upon taking damage."
msgstr "При получении урона вы наносите атакующему урон водой."

#. ja: 呪怨の形代
#. de: Fluchträger
#. fr: Katashiro
#. column 1: Afflicted by a karmic curse carried within a paper doll. Damage taken will be channeled into an explosion when the effect ends or you are KO'd.
msgctxt "Status:1725:0:0"
msgid "Cursekeeper"
msgstr "Хранитель проклятия"

#. ja: 呪怨の形代を貼り付けられた状態。効果終了時、もしくは戦闘不能時に、蓄積されたダメージ量に応じた爆発が起こる。
#. de: Beladen mit einem Fluch, der in einer rituellen Papierpuppe gebunden ist. Der erlittene Schaden wird gesammelt und in einer gewaltigen Explosion entladen, wenn der Status endet oder du kampfunfähig wirst.
#. fr: Les dégâts subis s'accumulent et provoquent une explosion de puissance proportionnelle à la fin de l'effet ou en cas de KO.
#. column 0: Cursekeeper
msgctxt "Status:1725:0:1"
msgid "Afflicted by a karmic curse carried within a paper doll. Damage taken will be channeled into an explosion when the effect ends or you are KO'd."
msgstr "На вас наложено кармическое проклятие, заключённое в бумажную куклу. Получаемый урон накопится и взорвётся, когда эффект закончится или вы падёте без сознания."

#. ja: 拘束
#. de: Seelenfessel
#. fr: Attache
#. column 1: Unable to execute actions.
msgctxt "Status:1726:0:0"
msgid "Fetters"
msgstr "Оковы"

#. ja: 行動できなくなった状態。
#. de: Du kannst keine Kommandos ausführen.
#. fr: Toute action est impossible.
#. column 0: Fetters
msgctxt "Status:1726:0:1"
msgid "Unable to execute actions."
msgstr "Вы не можете использовать действия."

#. ja: 狂戦士化の反動
#. de: Ermüdung des ekstatischen Kampfes
#. fr: Contrecoup du forcené
#. column 1: Unable to auto-attack or use spells, weaponskills, and abilities.
msgctxt "Status:1727:0:0"
msgid "Waning Nocturne"
msgstr "Угасающая ночь"

#. ja: オートアタック、魔法、ウェポンスキル、アビリティが使用できない状態。
#. de: Es können keine Auto-Attacken, Zauber, Waf<shy>fen<shy>fer<shy>tig<shy>kei<shy>ten oder Talente ausgeführt werden.
#. fr: L'utilisation d'attaques automatiques, de sorts, de techniques de combat et d'aptitudes est impossible.
#. column 0: Waning Nocturne
msgctxt "Status:1727:0:1"
msgid "Unable to auto-attack or use spells, weaponskills, and abilities."
msgstr "Вы не можете использовать автоатаки, заклинания, боевые приёмы и умения."

#. ja: 契約期間
#. de: Vertraglich gebunden
#. fr: Sous contrat
#. column 1: Mercenaries are allied to a team. Contract will expire when the counter reaches zero. HP restored by healing magic is reduced.
msgctxt "Status:1728:0:0"
msgid "Contractual Obligation"
msgstr "Обязательства по контракту"

#. ja: 特定のチームと傭兵契約を交わしている状態。カウント0で契約満了となる。自身に対するＨＰ回復効果が低下する。
#. de: Die Söldner unterstützen eins der Teams, bis der Zähler auf null gesunken ist. Erhaltene Heileffekte sind verringert.
#. fr: Un contrat de mercenariat a été signé avec une équipe. Le contrat se termine quand le compteur arrive à 0. La récupération de PV est diminuée.
#. column 0: Contractual Obligation
msgctxt "Status:1728:0:1"
msgid "Mercenaries are allied to a team. Contract will expire when the counter reaches zero. HP restored by healing magic is reduced."
msgstr "Вы сражаетесь на стороне одной из команд как наёмник. Контракт истечёт, когда счётчик обнулится. HP, восстанавливаемые магией, снижены."

#. ja: 不退転
#. de: Fest entschlossen
#. fr: Détermination
#. column 1: Remaining standing through pure determination. Damage dealt is increased.
msgctxt "Status:1729:0:0"
msgid "Sheer Will"
msgstr "Несгибаемая воля"

#. ja: 不退転の決意で、戦場に立っている状態。与ダメージが上昇する。
#. de: Nur der schiere Wille hält vom Rückzug ab. Ausgeteilter Schaden ist erhöht.
#. fr: Se tient sur le champ de bataille, plus déterminé<if $gn4>e</if> que jamais. Les dégâts infligés sont augmentés.
#. column 0: Sheer Will
msgctxt "Status:1729:0:1"
msgid "Remaining standing through pure determination. Damage dealt is increased."
msgstr "Вы продолжаете сражаться благодаря несгибаемой воле. Наносимый урон повышен."

#. ja: テンションマックス
#. de: Maximale Motivation
#. fr: Tension max
#. column 1: Nearly giddy with the thrill of battle, increasing damage dealt, potency of HP restoration actions, and the rate at which the limit gauge fills. Effect is nullified when piloting warmachina.
msgctxt "Status:1730:0:0"
msgid "Flying High"
msgstr "На взлёте"

#. ja: 目覚ましい戦果を挙げ、テンションが最高潮になった状態。与ダメージと自身からのＨＰ回復効果が上昇し、さらにリミットゲージも溜まりやすくなる。機工兵器搭乗中は無効化される。
#. de: Von der eigenen Kampfleistung maximal beflügelt. Erhöht den verursachten Schaden und erhaltene Heileffekte, und beschleunigt den Anstieg des Limitrausch-Balkens. Wird beim Aufsitzen auf eine Kriegsmaschine wirkungslos.
#. fr: L'état de tension est maximal suite à un fait d'arme ex<shy>cep<shy>tion<shy>nel au cours de la bataille. Les dégâts infligés et la récupération de PV sont augmentés et la jauge de Transcendance monte plus rapidement. Cet état est désactivé à bord d'une machine de guerre.
#. column 0: Flying High
msgctxt "Status:1730:0:1"
msgid "Nearly giddy with the thrill of battle, increasing damage dealt, potency of HP restoration actions, and the rate at which the limit gauge fills. Effect is nullified when piloting warmachina."
msgstr "Вы почти опьянели от азарта битвы. Наносимый урон, сила действий, восстанавливающих HP, и скорость заполнения шкалы предела повышены. Эффект исчезнет, когда вы сядете в боевую машину."

#. ja: 氷結
#. de: Tiefkühlung
#. fr: Congélation
#. column 1: Frozen solid and unable to execute actions.
msgctxt "Status:1731:0:0"
msgid "Deep Freeze"
msgstr "Глубокая заморозка"

#. ja: 氷結し、行動できなくなった状態。
#. de: Steif gefroren und handlungsunfähig.
#. fr: Le corps est entièrement gelé, empêchant toutes actions.
#. column 0: Deep Freeze
msgctxt "Status:1731:0:1"
msgid "Frozen solid and unable to execute actions."
msgstr "Вы замёрзли и не можете использовать действия."

#. ja: エレメンタル経験値アップ
#. de: Bonus für Elementar-EP
#. fr: Bonus d'expérience élémentaire
#. column 1: Elemental EXP earned through battle while at an elemental level lower than 35 is increased.
msgctxt "Status:1732:0:0"
msgid "Elemental EXP Up"
msgstr "Элементальный опыт повышен"

#. ja: エレメンタルレベル35未満で獲得できる、敵討伐時の獲得エレメンタル経験値が増加する状態。
#. de: In Kämpfen erlangte Elementar-EP sind erhöht, solange die Elementarstufe weniger als 35 beträgt.
#. fr: En dessous du niveau élémentaire 35, l'expérience élémentaire obtenue en abattant des monstres est augmentée.
#. column 0: Elemental EXP Up
msgctxt "Status:1732:0:1"
msgid "Elemental EXP earned through battle while at an elemental level lower than 35 is increased."
msgstr "В бою вы получаете больше элементального опыта, если ваш элементальный уровень ниже 35."

#. ja: 聖盾所持
#. de: Schildträger
#. fr: Porteur du bouclier sacré
#. column 1: Equipped with an ethereal shield and able to use the duty action Heavenly Shield.
msgctxt "Status:1733:0:0"
msgid "Shieldbearer"
msgstr "Щитоносец"

#. ja: 聖盾を所持している状態。コンテンツアクション「聖盾防御」が使用可能。
#. de: Ermöglicht den Einsatz des Spezialkommandos „Himmlischer Schild“.
#. fr: Porte le bouclier sacré et peut utiliser l'action de mission Garde sacrée.
#. column 0: Shieldbearer
msgctxt "Status:1733:0:1"
msgid "Equipped with an ethereal shield and able to use the duty action Heavenly Shield."
msgstr "Вы несёте эфирный щит и можете использовать особое действие «Небесный щит»."

#. ja: 聖剣所持
#. de: Schwertträger
#. fr: Porteur de l'épée sacrée
#. column 1: Equipped with an ethereal sword and able to use the duty action Heavenly Sword.
msgctxt "Status:1734:0:0"
msgid "Swordbearer"
msgstr "Меченосец"

#. ja: 聖剣を所持している状態。コンテンツアクション「聖剣攻撃」が使用可能。
#. de: Ermöglicht den Einsatz des Spezialkommandos „Himmlisches Schwert“.
#. fr: Porte l'épée sacrée et peut utiliser l'action de mission Frappe sacrée.
#. column 0: Swordbearer
msgctxt "Status:1734:0:1"
msgid "Equipped with an ethereal sword and able to use the duty action Heavenly Sword."
msgstr "Вы несёте эфирный меч и можете использовать особое действие «Небесный меч»."

#. ja: 聖盾防御
#. de: Himmlischer Schild
#. fr: Protection du bouclier sacré
#. column 1: Protected by an ethereal shield. Damage taken from certain attacks is reduced.
msgctxt "Status:1735:0:0"
msgid "Heavenly Shield"
msgstr "Небесный щит"

#. ja: 聖盾で防御している状態。特定のアクションによる被ダメージが低下する。
#. de: Geschützt von einem Himmlischen Schild. Von bestimmten Kommandos erlittener Schaden ist reduziert.
#. fr: Le bouclier sacré protège contre les attaques. Les dégâts subis sont réduits.
#. column 0: Heavenly Shield
msgctxt "Status:1735:0:1"
msgid "Protected by an ethereal shield. Damage taken from certain attacks is reduced."
msgstr "Вы защищены эфирным щитом. Урон от некоторых атак снижен."

#. ja: 水毒
#. de: Wassersucht
#. fr: Œdème
#. column 1: Sustaining water damage over time.
msgctxt "Status:1736:0:0"
msgid "Dropsy"
msgstr "Водянка"

#. ja: 水属性ダメージにより、ＨＰが徐々に失われる状態。
#. de: Erleidet schrittweise Wasserschaden.
#. fr: Des dégâts périodiques d'eau sont subis.
#. column 0: Dropsy
msgctxt "Status:1736:0:1"
msgid "Sustaining water damage over time."
msgstr "Вы постепенно теряете HP от урона водой."

#. ja: ガマの脂
#. de: Schleimiges Sekret
#. fr: Huile de crapaud
#. column 1: Evasion is enhanced.
msgctxt "Status:1737:0:0"
msgid "Toad Oil"
msgstr "Жабье масло"

#. ja: 回避率が向上した状態。
#. de: Ausweichrate ist erhöht.
#. fr: L'esquive est augmentée.
#. column 0: Toad Oil
msgctxt "Status:1737:0:1"
msgid "Evasion is enhanced."
msgstr "Вероятность уклонения повышена."

#. ja: 死の宣告
#. de: Verhängnis
#. fr: Glas
#. column 1: Certain death when counter reaches zero.
msgctxt "Status:1738:0:0"
msgid "Doom"
msgstr "Рок"

#. ja: カウント0で戦闘不能に陥る状態。
#. de: Wird kampfunfähig, sobald der Timer des Fluchs auf 0 sinkt.
#. fr: Mort certaine lorsque le compteur atteint zéro.
#. column 0: Doom
msgctxt "Status:1738:0:1"
msgid "Certain death when counter reaches zero."
msgstr "Когда счётчик обнулится, вы падёте без сознания."

#. ja: 賢者の記憶
#. de: Vermächtnis des Weisen
#. fr: Mémoire d'un sage
#. column 1: Magic damage dealt is increased. Magic damage taken and spell MP cost are reduced.
msgctxt "Status:1739:0:0"
msgid "Wisdom of the Elder"
msgstr "Мудрость старейшины"

#. ja: 魔法ダメージが上昇し、受ける魔法ダメージの一部が軽減され、かつ消費ＭＰを軽減して魔法を唱えられる状態。
#. de: Magieschaden ist erhöht. Erlittener magischer Schaden und MP-Verbrauch sind verringert.
#. fr: Les dégâts magiques infligés sont augmentés et ceux reçus sont réduits. Le coût en PM des sorts est réduit.
#. column 0: Wisdom of the Elder
msgctxt "Status:1739:0:1"
msgid "Magic damage dealt is increased. Magic damage taken and spell MP cost are reduced."
msgstr "Наносимый магический урон повышен. Получаемый магический урон и затраты MP на заклинания снижены."

#. ja: 剣豪の記憶
#. de: Vermächtnis des Fechtmeisters
#. fr: Mémoire d'une fine lame
#. column 1: Physical damage dealt and maximum HP are increased.
msgctxt "Status:1740:0:0"
msgid "Wisdom of the Duelist"
msgstr "Мудрость дуэлянта"

#. ja: 物理ダメージが上昇し、かつ最大ＨＰが増加する状態。
#. de: Physischer Schaden und maximale LP sind erhöht.
#. fr: Les dégâts physiques infligés et les PV maximums sont augmentés.
#. column 0: Wisdom of the Duelist
msgctxt "Status:1740:0:1"
msgid "Physical damage dealt and maximum HP are increased."
msgstr "Наносимый физический урон и максимальный запас HP повышены."

#. ja: 弓聖の記憶
#. de: Vermächtnis des Bogengeweihten
#. fr: Mémoire d'un archer émérite
#. column 1: Physical damage dealt and evasion are increased.
msgctxt "Status:1741:0:0"
msgid "Wisdom of the Fiendhunter"
msgstr "Мудрость охотника на чудовищ"

#. ja: 物理ダメージが上昇し、かつ回避率が向上した状態。
#. de: Physischer Schaden und Ausweichrate sind erhöht.
#. fr: Les dégâts physiques infligés et l'esquive sont augmentés.
#. column 0: Wisdom of the Fiendhunter
msgctxt "Status:1741:0:1"
msgid "Physical damage dealt and evasion are increased."
msgstr "Наносимый физический урон и вероятность уклонения повышены."

#. ja: 豪傑の記憶
#. de: Vermächtnis des Helden
#. fr: Mémoire d'un héros illustre
#. column 1: Damage taken is reduced. Maximum HP is boosted each time you take damage equivalent to at least 50% of your maximum HP from a single-target attack.
msgctxt "Status:1742:0:0"
msgid "Wisdom of the Indomitable"
msgstr "Мудрость несокрушимого"

#. ja: 受けるダメージの一部が軽減される状態。効果中に単体攻撃で自身の最大ＨＰの50％以上のダメージを受けた場合、「最大ＨＰアップ」が1スタック付与される。
#. de: Erlittener Schaden ist verringert. Verleiht einen Stapel „LP-Bonus“, wenn 50 % oder mehr Lebenspunkte durch einen Angriff verloren gehen.
#. fr: Les dégâts reçus sont réduits. 1 degré de Bonus de PV est octroyé en cas de perte d'au moins 50% des PV maximums à la suite d'une attaque.
#. column 0: Wisdom of the Indomitable
msgctxt "Status:1742:0:1"
msgid "Damage taken is reduced. Maximum HP is boosted each time you take damage equivalent to at least 50% of your maximum HP from a single-target attack."
msgstr "Получаемый урон снижен. Если одна атака по одной цели нанесёт урон, равный как минимум 50% вашего максимального запаса HP, максимальный запас HP повысится."

#. ja: サクリファイス
#. de: Aufopferung
#. fr: Sacrifice
#. column 1: Certain death when counter reaches zero.
msgctxt "Status:1743:0:0"
msgid "Sacrifice"
msgstr "Жертвоприношение"

#. ja: カウント0で戦闘不能に陥る状態。
#. de: Wird kampfunfähig, sobald der Timer auf 0 sinkt.
#. fr: Mort certaine lorsque le compteur atteint zéro.
#. column 0: Sacrifice
msgctxt "Status:1743:0:1"
msgid "Certain death when counter reaches zero."
msgstr "Когда счётчик обнулится, вы падёте без сознания."

#. ja: 星形多面体状態
#. de: Sternenformation
#. fr: Stellation
#. column 1: Transformed into a many-pointed star. Damage dealt is increased.
msgctxt "Status:1744:0:0"
msgid "Stellation"
msgstr "Звёздная форма"

#. ja: 星形多面体型に変形した状態。与ダメージが上昇する。
#. de: Hat Sternform angenommen. Ausgeteilter Schaden ist erhöht.
#. fr: Les dégâts infligés sont augmentés.
#. column 0: Stellation
msgctxt "Status:1744:0:1"
msgid "Transformed into a many-pointed star. Damage dealt is increased."
msgstr "Вы превратились в многолучевую звезду. Наносимый урон повышен."

#. ja: ブラックホール耐性
#. de: Schwarzschild-Immunität
#. fr: Résistance aux trous noirs
#. column 1: Invulnerable to the pull of the black hole.
msgctxt "Status:1745:0:0"
msgid "Black Hole Buffer"
msgstr "Защита от чёрных дыр"

#. ja: ブラックホールに吸引されない状態。
#. de: Kann nicht von Schwarzen Löchern eingesogen werden.
#. fr: Le corps n'est plus aspiré par les trous noirs.
#. column 0: Black Hole Buffer
msgctxt "Status:1745:0:1"
msgid "Invulnerable to the pull of the black hole."
msgstr "Чёрная дыра не может притянуть вас."

#. ja: 上昇気流
#. de: Aufwind
#. fr: Courants ascendants
#. column 1: Carried away by an updraft.
msgctxt "Status:1746:0:0"
msgid "Blown Away"
msgstr "Порыв ветра"

#. ja: 上昇気流により宙に浮いた状態。
#. de: Von einem Aufwind emporgetragen.
#. fr: Le corps est porté par des courants ascendants et flotte dans les airs.
#. column 0: Blown Away
msgctxt "Status:1746:0:1"
msgid "Carried away by an updraft."
msgstr "Вас подхватил восходящий поток воздуха."

#. ja: 勇気
#. de: Furchtlos
#. fr: Brave
#. column 1: Empowered by courage, increasing damage dealt.
msgctxt "Status:1747:0:0"
msgid "Fearless"
msgstr "Бесстрашие"

#. ja: 勇気を示した状態。与ダメージが上昇する。
#. de: Ausgeteilter Schaden ist erhöht.
#. fr: La bravoure a été démontrée. Les dégâts infligés sont augmentés.
#. column 0: Fearless
msgctxt "Status:1747:0:1"
msgid "Empowered by courage, increasing damage dealt."
msgstr "Вас окрыляет отвага, повышая наносимый урон."

#. ja: 守護結界
#. de: Wächter-Aegis
#. fr: Barrière protectrice
#. column 1: Shielded by a protective barrier.
msgctxt "Status:1748:0:0"
msgid "Guardians' Aegis"
msgstr "Эгида стражей"

#. ja: 守護結界の内側にいる状態。
#. de: Von einer schützenden Barriere umgeben.
#. fr: Bénéficie de la protection d'une barrière magique.
#. column 0: Guardians' Aegis
msgctxt "Status:1748:0:1"
msgid "Shielded by a protective barrier."
msgstr "Вы защищены барьером."

#. ja: アクション効果範囲拡大
#. de: Erweiterter Radius
#. fr: Aire d'effet augmentée
#. column 1: Area of effect for actions is expanded.
msgctxt "Status:1749:0:0"
msgid "Area of Influence Up"
msgstr "Область действия увеличена"

#. ja: アクションの効果範囲が拡大した状態。
#. de: Der Wirkungsradius von Kommandos ist erweitert.
#. fr: L'aire d'effet des actions est agrandie.
#. column 0: Area of Influence Up
msgctxt "Status:1749:0:1"
msgid "Area of effect for actions is expanded."
msgstr "Область действия умений увеличена."

#. ja: 二槍共鳴
#. de: Resonanz der gekreuzten Speere
#. fr: Résonance des lances
#. column 1: Orlasrach and Munderg are in resonance with one another, each protecting its twin.
msgctxt "Status:1750:0:0"
msgid "Twin Fates"
msgstr "Судьбы близнецов"

#. ja: オールラスラッハとムンジャルグが共鳴し、互いを守り合っている状態。
#. de: Orlasrach und Munderg schützen sich gegenseitig.
#. fr: Orlasrach et Munderg se protègent mu<shy>tuel<shy>le<shy>ment.
#. column 0: Twin Fates
msgctxt "Status:1750:0:1"
msgid "Orlasrach and Munderg are in resonance with one another, each protecting its twin."
msgstr "Орласрах и Мундерг вошли в резонанс и защищают друг друга."

#. ja: 属性偏向：火
#. de: Elementarer Bias: Feuer
#. fr: Déséquilibre éthéré<nbsp>: feu
#. column 1: Aetherial aspect is leaning primarily to fire.
msgctxt "Status:1751:0:0"
msgid "Soul of Fire"
msgstr "Душа огня"

#. ja: エーテルが火属性に傾いている状態。
#. de: Der Äther ist dem Element Feuer zugeneigt.
#. fr: La balance éthérée penche vers l'élément feu.
#. column 0: Soul of Fire
msgctxt "Status:1751:0:1"
msgid "Aetherial aspect is leaning primarily to fire."
msgstr "Эфир склоняется к стихии огня."

#. ja: 属性偏向：氷
#. de: Elementarer Bias: Eis
#. fr: Déséquilibre éthéré<nbsp>: glace
#. column 1: Aetherial aspect is leaning primarily to ice.
msgctxt "Status:1752:0:0"
msgid "Soul of Ice"
msgstr "Душа льда"

#. ja: エーテルが氷属性に傾いている状態。
#. de: Der Äther ist dem Element Eis zugeneigt.
#. fr: La balance éthérée penche vers l'élément glace.
#. column 0: Soul of Ice
msgctxt "Status:1752:0:1"
msgid "Aetherial aspect is leaning primarily to ice."
msgstr "Эфир склоняется к стихии льда."

#. ja: 血の魔術
#. de: Blutmagie
#. fr: Sang maudit
#. column 1: Damage taken is increased if those bonded by the blood ritual are separated.
msgctxt "Status:1753:0:0"
msgid "Blood Sacrifice"
msgstr "Кровавое жертвоприношение"

#. ja: 血の魔術の影響を受けた仲間から離れると、被害が増大する状態。
#. de: Man erleidet großen Schaden, wenn man sich zu weit vom Mitstreiter entfernt, der unter dem Einfluss der Blutmagie steht.
#. fr: S'éloigner des équipiers affectés augmente les dégâts subis.
#. column 0: Blood Sacrifice
msgctxt "Status:1753:0:1"
msgid "Damage taken is increased if those bonded by the blood ritual are separated."
msgstr "Если отдалиться от тех, кто связан с вами кровавым ритуалом, получаемый урон повысится."

#. ja: 転送準備
#. de: Teleportaffinität
#. fr: Préparatifs de téléportation terminés
#. column 1: Awash in aether attuned for traveling via unstable currents.
msgctxt "Status:1754:0:0"
msgid "Aetherially Primed"
msgstr "Эфирная настройка"

#. ja: 特殊なエーテルを浴び、乱れた地脈を利用しやすくなった状態。
#. de: Kann besondere Ätherströmungen für Teleportationen nutzen.
#. fr: Le corps est imprégné d'un éther spécial, permettant de se mouvoir plus facilement à travers un flux éthéré perturbé.
#. column 0: Aetherially Primed
msgctxt "Status:1754:0:1"
msgid "Awash in aether attuned for traveling via unstable currents."
msgstr "Вы напитались эфиром, который поможет перемещаться по нестабильным потокам."

#. ja: 蘇生制限
#. de: Wiederbelebungsbegrenzung
#. fr: Anti-résurrection
#. column 1: The influence of Eureka-forged weapons is making resurrection by certain means impossible.
msgctxt "Status:1755:0:0"
msgid "Resurrection Restricted"
msgstr "Запрет на воскрешение"

#. ja: 創神エウレカ製武具の影響により、一部の蘇生効果を受け付けない状態。
#. de: Durch den Einfluss der von der Schöpfergottheit Eureka erschaffenen Pseudo-Primae sind einige Wiederbelebungseffekte unwirksam.
#. fr: Impossible d'être ranimé par des moyens classiques en cas de K.O.
#. column 0: Resurrection Restricted
msgctxt "Status:1755:0:1"
msgid "The influence of Eureka-forged weapons is making resurrection by certain means impossible."
msgstr "Под влиянием оружия, созданного Эврикой, некоторые способы воскрешения не действуют."

#. ja: 精霊の加護
#. de: Elementarer Segen
#. fr: Bénédiction des esprits
#. column 1: An area of land has been granted the elementals' protection, reducing damage taken for all who enter.
msgctxt "Status:1756:0:0"
msgid "Elemental Blessing"
msgstr "Благословение стихий"

#. ja: 被ダメージを軽減するシールドを発生させている状態。
#. de: Hält eine Barriere aufrecht, die erlittenen Schaden verringert.
#. fr: Sous l'effet d'une aura bénéfique qui réduit les dégâts reçus.
#. column 0: Elemental Blessing
msgctxt "Status:1756:0:1"
msgid "An area of land has been granted the elementals' protection, reducing damage taken for all who enter."
msgstr "Земля защищена стихиями, и все, кто ступит на неё, будут получать меньше урона."

#. ja: 拘束
#. de: Gefesselt
#. fr: Attache
#. column 1: Unable to execute actions.
msgctxt "Status:1757:0:0"
msgid "Fetters"
msgstr "Оковы"

#. ja: 行動できなくなった状態。
#. de: Ist handlungsunfähig.
#. fr: Toute action est impossible.
#. column 0: Fetters
msgctxt "Status:1757:0:1"
msgid "Unable to execute actions."
msgstr "Вы не можете использовать действия."

#. ja: 氷結
#. de: Tiefkühlung
#. fr: Congélation
#. column 1: Your body is encased in ice, preventing action and dealing damage over time.
msgctxt "Status:1758:0:0"
msgid "Deep Freeze"
msgstr "Глубокая заморозка"

#. ja: 身体が凍り付き、行動できなくなった状態。ＨＰが徐々に失われる。
#. de: In Eis eingeschlossen. Keine Handlungen möglich und erleidet schrittweise Schaden.
#. fr: Le corps est entièrement gelé. Des dégâts périodiques de glace sont subis.
#. column 0: Deep Freeze
msgctxt "Status:1758:0:1"
msgid "Your body is encased in ice, preventing action and dealing damage over time."
msgstr "Вы скованы льдом, не можете действовать и постепенно теряете HP."

#. ja: 被ダメージ低下
#. de: Verringerte Verwundbarkeit
#. fr: Vulnérabilité diminuée
#. column 1: Damage taken is reduced.
msgctxt "Status:1759:0:0"
msgid "Vulnerability Down"
msgstr "Уязвимость снижена"

#. ja: 受けるダメージの一部が軽減される状態。
#. de: Erlittener Schaden ist verringert.
#. fr: Les dégâts reçus sont réduits.
#. column 0: Vulnerability Down
msgctxt "Status:1759:0:1"
msgid "Damage taken is reduced."
msgstr "Получаемый урон снижен."

#. ja: ダメージ上昇
#. de: Schaden +
#. fr: Bonus de dégâts
#. column 1: Damage dealt is increased.
msgctxt "Status:1760:0:0"
msgid "Damage Up"
msgstr "Урон повышен"

#. ja: 与ダメージが上昇した状態。
#. de: Ausgeteilter Schaden ist erhöht.
#. fr: Les dégâts infligés sont augmentés.
#. column 0: Damage Up
msgctxt "Status:1760:0:1"
msgid "Damage dealt is increased."
msgstr "Наносимый урон повышен."

#. ja: 氷属性耐性向上
#. de: Eisresistenz +
#. fr: Résistance à la glace accrue
#. column 1: Ice resistance is increased.
msgctxt "Status:1761:0:0"
msgid "Ice Resistance Up"
msgstr "Сопротивление льду повышено"

#. ja: 氷属性に対する耐性が向上する。
#. de: Resistenz gegen Eis ist erhöht.
#. fr: La résistance à l'élément glace est augmentée.
#. column 0: Ice Resistance Up
msgctxt "Status:1761:0:1"
msgid "Ice resistance is increased."
msgstr "Сопротивление льду повышено."

#. ja: ノックダウン
#. de: Am Boden
#. fr: Au tapis
#. column 1: Unable to move or execute actions.
msgctxt "Status:1762:0:0"
msgid "Down for the Count"
msgstr "Без сознания"

#. ja: ノックダウンした状態。移動およびアクション実行不可。
#. de: Bewegungsunfähig, Kommandos können nicht ausgeführt werden.
#. fr: Impossible d'utiliser des actions ou de se déplacer.
#. column 0: Down for the Count
msgctxt "Status:1762:0:1"
msgid "Unable to move or execute actions."
msgstr "Вы не можете двигаться или использовать действия."

#. ja: 最大ＨＰアップ
#. de: LP-Bonus
#. fr: Bonus de PV
#. column 1: Maximum HP is increased.
msgctxt "Status:1763:0:0"
msgid "HP Boost"
msgstr "Усиление HP"

#. ja: 最大ＨＰが増加した状態。
#. de: Maximal-LP sind erhöht.
#. fr: Les PV maximums sont augmentés.
#. column 0: HP Boost
msgctxt "Status:1763:0:1"
msgid "Maximum HP is increased."
msgstr "Максимум HP повышен."

#. ja: 魔導甲冑
#. de: Magitek-Rüstung
#. fr: Combinaison cuirassée magitek
#. column 1: Magitek plate armor has been enhanced.
msgctxt "Status:1764:0:0"
msgid "Artificially Enhanced"
msgstr "Искусственное усиление"

#. ja: 魔導甲冑をブーストさせた状態。
#. de: Magitek-Rüstung ist verstärkt.
#. fr: La puissance est augmentée.
#. column 0: Artificially Enhanced
msgctxt "Status:1764:0:1"
msgid "Magitek plate armor has been enhanced."
msgstr "Магитех-броня усилена."

#. ja: 魔導甲冑
#. de: Magitek-Rüstung
#. fr: Combinaison cuirassée magitek
#. column 1: Magitek plate armor has been enhanced.
