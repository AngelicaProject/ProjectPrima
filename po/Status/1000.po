msgid "Omega-M"
msgstr "Омега-М"

#. ja: オメガが男性を模した状態。
#. de: Omega in einer maskulinen Form.
#. fr: Oméga a adopté une apparence masculine.
#. column 0: Omega-M
msgctxt "Status:1674:0:1"
msgid "Mimicking the male form."
msgstr "Омега копирует мужской облик."

#. ja: オメガF
#. de: Omega-W
#. fr: Oméga-F
#. column 1: Mimicking the female form.
msgctxt "Status:1675:0:0"
msgid "Omega-F"
msgstr "Омега-Ф"

