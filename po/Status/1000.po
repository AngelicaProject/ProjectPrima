msgctxt "Status:1244:0:1"
msgid "Able to execute <ui-color 500><ui-edge-color 501>Riddle of Wind</ui-edge-color></ui-color>."
msgstr "Можно выполнить <ui-color 500><ui-edge-color 501>Загадку ветра</ui-edge-color></ui-color>."

#. ja: ニュートラルセクト［日］
#. de: Neutral (Diurnal)
#. fr: Adepte de la neutralité (diurne)
#. column 1: Regenerating HP over time.
msgctxt "Status:1247:0:0"
msgid "Diurnal Balance"
msgstr "Дневное равновесие"

#. ja: 連続してＨＰが回復している状態。
#. de: Regeneriert schrittweise LP.
#. fr: Des PV sont récupérés périodiquement.
#. column 0: Diurnal Balance
msgctxt "Status:1247:0:1"
msgid "Regenerating HP over time."
msgstr "HP постепенно восстанавливаются."

#. ja: 巨星の支配者
#. de: Planetare Herrschaft
#. fr: Domination stellaire
#. column 1: An earthly star is in your control.
msgctxt "Status:1248:0:0"
msgid "Giant Dominance"
msgstr "Власть гигантской звезды"

#. ja: アーサリースターを発生させている状態。
#. de: Kontrolliert einen irdischen Stern.
#. fr: Détient le contrôle d'une Étoile terrestre.
#. column 0: Giant Dominance
msgctxt "Status:1248:0:1"
msgid "An earthly star is in your control."
msgstr "Вы управляете земной звездой."

#. ja: 連続魔
#. de: Doppelzauber
#. fr: Chaîne de sorts
#. column 1: Next spell will require no time to cast.
msgctxt "Status:1249:0:0"
msgid "Dualcast"
msgstr "Двойное заклинание"

#. ja: 次の魔法が、詠唱時間無しで唱えられる状態。
#. de: Nächster Zauber kann sofort gewirkt werden.
#. fr: Le prochain sort est instantané.
#. column 0: Dualcast
msgctxt "Status:1249:0:1"
msgid "Next spell will require no time to cast."
msgstr "Следующее заклинание произносится мгновенно."

#. ja: トゥルーノース
#. de: Neuausrichtung
#. fr: Vrai Nord
#. column 1: All action direction requirements are nullified.
msgctxt "Status:1250:0:0"
msgid "True North"
msgstr "Истинный север"

#. ja: 方向指定条件のあるアクションをどの方向から実行しても成功させる状態。
#. de: Richtungsbedingungen für Kommandos werden als erfüllt betrachtet.
#. fr: Les actions directionnelles réussissent dans n'importe quelle position.
#. column 0: True North
msgctxt "Status:1250:0:1"
msgid "All action direction requirements are nullified."
msgstr "Умения с требованиями к направлению срабатывают из любого положения."

#. ja: タレット再起動中
#. de: Gyrocopter-Kalibrierung
#. fr: Réinitialisation d'auto-tourelle
#. column 1: Unable to deploy turrets.
msgctxt "Status:1251:0:0"
msgid "Turret Reset"
msgstr "Сброс турели"

#. ja: タレットを設置することができない状態。
#. de: Gyrocopter können nicht aufs Schlachtfeld gerufen werden.
#. fr: Aucune auto-tourelle ne peut être placée momentanément.
#. column 0: Turret Reset
msgctxt "Status:1251:0:1"
msgid "Unable to deploy turrets."
msgstr "Нельзя установить турель."

#. ja: 開眼
#. de: Offene Augen
#. fr: Yeux ouverts
#. column 1: Succeeded at opening the <ui-color 506><ui-edge-color 507>Third Eye</ui-edge-color></ui-color>.
msgctxt "Status:1252:0:0"
msgid "Eyes Open"
msgstr "Глаза открыты"

#. ja: 心眼に成功した状態。
#. de: Konnte das <ui-color 502><ui-edge-color 503>Dritte Auge</ui-edge-color></ui-color> öffnen.
#. fr: L'effet du Troisième œil s'est déclenché.
#. column 0: Eyes Open
#. macro: <ui-color 506> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 506 (formatting: keep it as often as the source has it)
#. macro: <ui-edge-color 507> — text outline color from the UIColor sheet; </ui-edge-color> restores the previous color; color = 507 (formatting: keep it as often as the source has it)
#. macro: </ui-edge-color> — end of: text outline color from the UIColor sheet; </ui-edge-color> restores the previous color (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "Status:1252:0:1"
msgid "Succeeded at opening the <ui-color 506><ui-edge-color 507>Third Eye</ui-edge-color></ui-color>."
msgstr "Успешно сработал эффект <ui-color 506><ui-edge-color 507>Третьего глаза</ui-edge-color></ui-color>."

#. ja: マーキング
#. de: Markiert
#. fr: Marquage
#. column 1: Marked as prey.
msgctxt "Status:1253:0:0"
msgid "Prey"
msgstr "Добыча"

#. ja: 獲物として狙いを付けられた状態。
#. de: Als Beute markiert.
#. fr: Fait l'objet du marquage d'un prédateur.
#. column 0: Prey
msgctxt "Status:1253:0:1"
msgid "Marked as prey."
msgstr "Отмечен как добыча."

#. ja: 氷結
#. de: Tiefkühlung
#. fr: Congélation
#. column 1: Your body is encased in ice, preventing action and dealing damage over time.
msgctxt "Status:1254:0:0"
msgid "Deep Freeze"
msgstr "Глубокая заморозка"

#. ja: 身体が凍り付き、行動できなくなった状態。ＨＰが徐々に失われる。
#. de: In Eis eingeschlossen. Keine Handlungen möglich und erleidet schrittweise Schaden.
#. fr: Le corps est entièrement gelé. Des dégâts périodiques de glace sont subis.
#. column 0: Deep Freeze
msgctxt "Status:1254:0:1"
msgid "Your body is encased in ice, preventing action and dealing damage over time."
msgstr "Тело сковано льдом. Вы не можете действовать и постепенно теряете HP."

#. ja: 火属性耐性低下［強］
#. de: Feuerresistenz - (stark)
#. fr: Résistance au feu réduite+
#. column 1: Fire resistance is significantly reduced.
msgctxt "Status:1255:0:0"
msgid "Fire Resistance Down II"
msgstr "Сопротивление огню снижено II"

#. ja: 火属性に対する耐性が著しく低下した状態。
#. de: Resistenz gegen Feuer ist stark verringert.
#. fr: La résistance à l'élément feu est considérablement réduite.
#. column 0: Fire Resistance Down II
msgctxt "Status:1255:0:1"
msgid "Fire resistance is significantly reduced."
msgstr "Сопротивление огню значительно снижено."

#. ja: 負傷
#. de: Verwundet
#. fr: Blessures
#. column 1: Severe wounds are reducing damage dealt while increasing damage taken by certain attacks.
msgctxt "Status:1256:0:0"
msgid "Wounded"
msgstr "Ранение"

#. ja: 負傷し、与ダメージが低下した状態。特定の攻撃による被ダメージが増加する。
#. de: Ausgeteilter Schaden ist verringert, durch bestimmte Attacken erlittener Schaden ist erhöht.
#. fr: Du fait de blessures, les dégâts infligés sont réduits. Les dégâts causés par certaines attaques sont augmentés.
#. column 0: Wounded
msgctxt "Status:1256:0:1"
msgid "Severe wounds are reducing damage dealt while increasing damage taken by certain attacks."
msgstr "Тяжёлые раны снижают наносимый урон и повышают урон от некоторых атак."

#. ja: 強制移動
#. de: Zwangsmarsch
#. fr: Marche forcée
#. column 1: Advancing in the ordered direction.
msgctxt "Status:1257:0:0"
msgid "Forced March"
msgstr "Принудительное движение"

#. ja: 指定方向に移動し続けてしまう状態。
#. de: Wird gezwungen, sich in eine bestimmte Richtung zu bewegen.
#. fr: Le corps obéit et avance dans la direction indiquée.
#. column 0: Forced March
msgctxt "Status:1257:0:1"
msgid "Advancing in the ordered direction."
msgstr "Вы движетесь в указанном направлении."

#. ja: 拘束
#. de: Gefesselt
#. fr: Attache
#. column 1: Unable to move.
msgctxt "Status:1258:0:0"
msgid "Fetters"
msgstr "Оковы"

#. ja: 移動できなくなった状態。
#. de: Bewegungsunfähig.
#. fr: Tout déplacement est impossible.
#. column 0: Fetters
msgctxt "Status:1258:0:1"
msgid "Unable to move."
msgstr "Вы не можете двигаться."

#. ja: オールド
#. de: Alt
#. fr: Vieillissement
#. column 1: You have aged considerably. Movement speed is severely reduced.
msgctxt "Status:1259:0:0"
msgid "Old"
msgstr "Старение"

#. ja: 年老いた老人になった状態。移動速度が低下する。
#. de: Stark gealtert. Be<shy>we<shy>gungs<shy>ge<shy>schwin<shy>dig<shy>keit ist verringert.
#. fr: La vitesse de déplacement est réduite du fait d'un vieillissement soudain.
#. column 0: Old
msgctxt "Status:1259:0:1"
msgid "You have aged considerably. Movement speed is severely reduced."
msgstr "Вы сильно постарели. Скорость передвижения значительно снижена."

#. ja: 雷属性耐性低下［強］
#. de: Blitzresistenz - (stark)
#. fr: Résistance à la foudre réduite+
#. column 1: Lightning resistance is significantly reduced.
msgctxt "Status:1260:0:0"
msgid "Lightning Resistance Down II"
msgstr "Сопротивление молнии снижено II"

#. ja: 雷属性に対する耐性が著しく低下した状態。
#. de: Resistenz gegen Blitz ist stark verringert.
#. fr: La résistance à l'élément foudre est considérablement réduite.
#. column 0: Lightning Resistance Down II
msgctxt "Status:1260:0:1"
msgid "Lightning resistance is significantly reduced."
msgstr "Сопротивление молнии значительно снижено."

#. ja: 採集HQ獲得率アップ：限定II
#. de: Sammelglück erhöht II (Limit)
#. fr: Récolte de qualité II (limitée)
#. column 1: Chance of obtaining an HQ item on your next gathering attempt is increased.
msgctxt "Status:1262:0:0"
msgid "Gathering Fortune Up II (Limited)"
msgstr "Шанс удачи при сборе II (ограниченный)"

#. ja: 次回のみ採集のアイテムHQ獲得率が上昇した状態。ただし、プレイヤーがHQ入手不可またはHQが存在しないアイテムには影響しない。
#. de: Höhere Chance, beim nächsten Sammelversuch einen HQ-Gegenstand zu erhalten, falls das grundsätzlich möglich ist.
#. fr: Les chances d'obtenir un objet HQ en récoltant sont augmentées à la prochaine tentative. Aucune influence pour les objets n'ayant pas de version HQ, ou si le récolteur ne peut pas obtenir de HQ.
#. column 0: Gathering Fortune Up II (Limited)
msgctxt "Status:1262:0:1"
msgid "Chance of obtaining an HQ item on your next gathering attempt is increased."
msgstr "Повышен шанс получить предмет высокого качества при следующей попытке сбора."

#. ja: 徐々にＨＰ回復
#. de: Rehabilitation
#. fr: Recouvrement
#. column 1: Regenerating HP over time.
msgctxt "Status:1263:0:0"
msgid "Rehabilitation"
msgstr "Восстановление"

#. ja: 連続してＨＰが回復している状態。
#. de: Regeneriert schrittweise LP.
#. fr: Des PV sont récupérés périodiquement.
#. column 0: Rehabilitation
msgctxt "Status:1263:0:1"
msgid "Regenerating HP over time."
msgstr "HP постепенно восстанавливаются."

#. ja: 光の決意
#. de: Wille des Lichts
#. fr: Conviction de la Lumière
#. column 1: Breaking limits as only a true Warrior of Light could.
msgctxt "Status:1264:0:0"
msgid "Brilliant Conviction"
msgstr "Блистательная убеждённость"

#. ja: 光の戦士としての決意により、己の限界を超えた状態。
#. de: Durch den starken Willen als Krieger<if $gn4>in</if> des Lichts über die eigenen Grenzen hinausgewachsen.
#. fr: La conviction propre au pouvoir de la Lumière permet de dépasser ses limites.
#. column 0: Brilliant Conviction
msgctxt "Status:1264:0:1"
msgid "Breaking limits as only a true Warrior of Light could."
msgstr "Вы преодолели свои пределы благодаря решимости истинного Воина Света."

#. ja: 光の決意
#. de: Wille des Lichts
#. fr: Conviction de la Lumière
#. column 1: Breaking limits as only a true Warrior of Light could.
msgctxt "Status:1265:0:0"
msgid "Brilliant Conviction"
msgstr "Блистательная убеждённость"

#. ja: 光の戦士としての決意により、己の限界を超えた状態。
#. de: Durch den starken Willen als Krieger<if $gn4>in</if> des Lichts über die eigenen Grenzen hinausgewachsen.
#. fr: La conviction propre au pouvoir de la Lumière permet de dépasser ses limites.
#. column 0: Brilliant Conviction
msgctxt "Status:1265:0:1"
msgid "Breaking limits as only a true Warrior of Light could."
msgstr "Вы преодолели свои пределы благодаря решимости истинного Воина Света."

#. ja: 透明［強］
#. de: Supertransparenz
#. fr: Transparence+
#. column 1: Body is allowing light to pass, rendering you invisible to the enemy.
msgctxt "Status:1266:0:0"
msgid "Transparent II"
msgstr "Прозрачность II"

#. ja: 姿を隠して透明になり、モンスターに襲われない状態。
#. de: Extrem lichtdurchlässiger Körper, der von Monstern nicht angegriffen wird.
#. fr: L'organisme laisse passer la lumière, devenant invisible aux ennemis.
#. column 0: Transparent II
msgctxt "Status:1266:0:1"
msgid "Body is allowing light to pass, rendering you invisible to the enemy."
msgstr "Ваше тело пропускает свет, и враги вас не видят."

#. ja: しがみつき
#. de: Angekrallt
#. fr: Étreinte
#. column 1: Affixed to another object.
msgctxt "Status:1267:0:0"
msgid "Affixed"
msgstr "Прикреплён"

#. ja: 何らかの物体にしがみついている状態。
#. de: Fest an ein Objekt gekrallt.
#. fr: Le corps est étreint par quelque chose.
#. column 0: Affixed
msgctxt "Status:1267:0:1"
msgid "Affixed to another object."
msgstr "Вы держитесь за какой-то предмет."

#. ja: イベント中
#. de: In Ereignis
#. fr: Événement
#. column 1: Participating in an in-game event.
msgctxt "Status:1268:0:0"
msgid "In Event"
msgstr "В событии"

#. ja: イベントが発生している状態。
#. de: Nimmt an einem Spielereignis teil.
#. fr: Participe à un événement.
#. column 0: In Event
msgctxt "Status:1268:0:1"
msgid "Participating in an in-game event."
msgstr "Вы участвуете в игровом событии."

#. ja: 行動注意
#. de: Auf Bewährung
#. fr: Liberté réduite
#. column 1: A penalty will be assessed for any action, auto-attack, or movement taken after status ends.
msgctxt "Status:1269:0:0"
msgid "Extreme Caution"
msgstr "Предельная осторожность"

#. ja: 効果終了時に、オートアタックやアクション、移動など、何らかの行動を行っていた場合、ペナルティを受ける。
#. de: Das Ausführen von Auto-Attacke, Kommandos oder Bewegung bei Ende des Effekts führt zu einer Strafe.
#. fr: Tout mouvement (attaque automatique, action, déplacement, etc.) causera une pénalité à la fin de l'effet.
#. column 0: Extreme Caution
msgctxt "Status:1269:0:1"
msgid "A penalty will be assessed for any action, auto-attack, or movement taken after status ends."
msgstr "Если после окончания эффекта вы будете действовать, атаковать или двигаться, вас ждёт наказание."

#. ja: 禍泡
#. de: Schäumend
#. fr: Agitation
#. column 1: Churning waters are upon you. Severe damage will be suffered if moving when the effect wears off.
msgctxt "Status:1270:0:0"
msgid "Churning"
msgstr "Взбаламучивание"

#. ja: 禍泡が付着した状態。この状態の効果が切れる際に動いていた場合、大ダメージを受ける。
#. de: Von zornig schäumendem Wasser umtost. Erleidet schweren Schaden bei Bewegung nach Ende des Effekts.
#. fr: Le corps est pris dans des eaux agitées. D'importants dégâts seront subis en cas de mouvement à la fin de l'effet.
#. column 0: Churning
msgctxt "Status:1270:0:1"
msgid "Churning waters are upon you. Severe damage will be suffered if moving when the effect wears off."
msgstr "Вас захлестнули бурные воды. Если в момент окончания эффекта вы будете двигаться, получите сильный урон."

#. ja: 鍔迫り合い
#. de: Gekreuzte Klingen
#. fr: Duel d'armes
#. column 1: Pushing back at another weapon with your own.
msgctxt "Status:1271:0:0"
msgid "Clashing"
msgstr "Схватка оружием"

#. ja: 鍔迫り合いをしている状態。
#. de: Drückt die Waffe des Gegners mit der eigenen weg.
#. fr: L'arme est engagée dans un duel avec celle de l'ennemi.
#. column 0: Clashing
msgctxt "Status:1271:0:1"
msgid "Pushing back at another weapon with your own."
msgstr "Вы отталкиваете чужое оружие своим."

#. ja: 斬属性耐性低下［強］
#. de: Hiebresistenz - (stark)
#. fr: Résistance au tranchant réduite+
#. column 1: Slashing resistance is significantly reduced.
msgctxt "Status:1272:0:0"
msgid "Slashing Resistance Down II"
msgstr "Сопротивление рубящему урону снижено II"

#. ja: 斬属性に対する耐性が著しく低下した状態。
#. de: Hiebresistenz ist stark verringert.
#. fr: La résistance au tranchant est considérablement réduite.
#. column 0: Slashing Resistance Down II
msgctxt "Status:1272:0:1"
msgid "Slashing resistance is significantly reduced."
msgstr "Сопротивление рубящему урону значительно снижено."

#. ja: 埋没
#. de: Sinkend
#. fr: Enfoncement
