#. ja: おうえん
#. de: Sonnenschein
#. fr: Encouragements
#. column 1: Spurred on by Ceetol Ja's heartfelt support.
msgctxt "Status:4033:0:0"
msgid "Shining Encouragement"
msgstr ""

#. ja: セートジャに応援され、やる気が満ちた状態。
#. de: Voller Eifer und von Ceetol Ja angefeuert.
#. fr: La motivation est à son maximum grâce aux encouragements de Ceetol Ja.
#. column 0: Shining Encouragement
msgctxt "Status:4033:0:1"
msgid "Spurred on by Ceetol Ja's heartfelt support."
msgstr ""

#. ja: 堅き護り
#. de: Schwer geschützt
#. fr: Protection parfaite
#. column 1: Protected by the Steelhog's magicked barrier.
msgctxt "Status:4034:0:0"
msgid "Unbroken Mettle"
msgstr ""

#. ja: 堅牢な魔法障壁に護られた状態。
#. de: Durch eine starke magische Barriere geschützt.
#. fr: Protégé par une barrière magique intacte.
#. column 0: Unbroken Mettle
msgctxt "Status:4034:0:1"
msgid "Protected by the Steelhog's magicked barrier."
msgstr ""

#. ja: 綻んだ護り
#. de: Brüchig geschützt
#. fr: Protection réduite
#. column 1: Protected by a damaged magicked barrier.
msgctxt "Status:4035:0:0"
msgid "Fractured Mettle"
msgstr ""

#. ja: 綻んだ魔法障壁に護られた状態。
#. de: Durch eine rissige magische Barriere geschützt.
#. fr: Protégé par une barrière magique détériorée.
#. column 0: Fractured Mettle
msgctxt "Status:4035:0:1"
msgid "Protected by a damaged magicked barrier."
msgstr ""

#. ja: 綻び：右
#. de: Rechter Riss
#. fr: Faille<nbsp>: côté droit
#. column 1: Magicked barrier is cracking under pressure. Damage dealt from the right is greatly increased.
msgctxt "Status:4036:0:0"
msgid "Rightward Fracture"
msgstr ""

#. ja: 魔法障壁に綻びが生じた状態。右側からの攻撃で大ダメージを受ける。
#. de: Hat einen Riss in der Schutzbarriere erlitten und nimmt schweren Schaden von Attacken auf die rechte Flanke.
#. fr: La barrière magique est détériorée. D'importants dégâts peuvent être infligés en attaquant par le côté droit.
#. column 0: Rightward Fracture
msgctxt "Status:4036:0:1"
msgid "Magicked barrier is cracking under pressure. Damage dealt from the right is greatly increased."
msgstr ""

#. ja: 綻び：左
#. de: Linker Riss
#. fr: Faille<nbsp>: côté gauche
#. column 1: Magicked barrier is cracking under pressure. Damage dealt from the left is greatly increased.
msgctxt "Status:4037:0:0"
msgid "Leftward Fracture"
msgstr ""

#. ja: 魔法障壁に綻びが生じた状態。左側からの攻撃で大ダメージを受ける。
#. de: Hat einen Riss in der Schutzbarriere erlitten und nimmt schweren Schaden von Attacken auf die linke Flanke.
#. fr: La barrière magique est détériorée. D'importants dégâts peuvent être infligés en attaquant par le côté gauche.
#. column 0: Leftward Fracture
msgctxt "Status:4037:0:1"
msgid "Magicked barrier is cracking under pressure. Damage dealt from the left is greatly increased."
msgstr ""

#. ja: 綻び：前
#. de: 綻び：前
#. fr: Faille<nbsp>: avant
#. column 1: 魔法障壁に綻びが生じた状態。正面からの攻撃で大ダメージを受ける。
msgctxt "Status:4038:0:0"
msgid "綻び：前"
msgstr ""

