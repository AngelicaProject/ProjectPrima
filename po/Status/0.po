msgctxt "Status:588:0:1"
msgid "Damage taken by <ui-color 500><ui-edge-color 501>Revelation</ui-edge-color></ui-color> is increased."
msgstr "Получаемый урон от <ui-color 500><ui-edge-color 501>Откровения</ui-edge-color></ui-color> увеличен."

#. ja: 誘爆
#. de: Kette der Purgation
#. fr: Souffle du purgatoire
#. column 1: Marked by the <ui-color 506><ui-edge-color 507>Brand of Purgatory</ui-edge-color></ui-color>. Damage taken by the <ui-color 500><ui-edge-color 501>Flames of Unforgiveness</ui-edge-color></ui-color> is increased.
