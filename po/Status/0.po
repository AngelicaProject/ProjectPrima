msgctxt "Status:562:0:0"
msgid "Prey"
msgstr "Добыча"

#. ja: 獲物として狙いを付けられた状態。
#. de: Als Beute markiert.
#. fr: Fait l'objet du marquage d'un prédateur.
#. column 0: Prey
msgctxt "Status:562:0:1"
msgid "Marked as prey."
msgstr "Вы помечены как добыча."

#. ja: 被ダメージ上昇
#. de: Erhöhte Verwundbarkeit
