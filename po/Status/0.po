#. ja: 睡眠
#. de: Schlaf
#. fr: Sommeil
#. column 1: Overwhelming drowsiness is preventing the execution of actions.
msgctxt "Status:926:0:0"
msgid "Sleep"
msgstr "Сон"

#. ja: 眠りに落ち、行動できなくなった状態。
#. de: Tiefschlaf verhindert das Ausführen jeglicher Kommandos.
#. fr: Le sommeil empêche toute action.
#. column 0: Sleep
msgctxt "Status:926:0:1"
msgid "Overwhelming drowsiness is preventing the execution of actions."
msgstr "Сильная сонливость не позволяет совершать действия."

#. ja: 花蜜
#. de: Blütenhonig
#. fr: Nectar
#. column 1: Your entire body is covered in sweet-smelling nectar.
msgctxt "Status:927:0:0"
msgid "Nectar"
msgstr "Нектар"

#. ja: 花蜜まみれになった状態。
#. de: Völlig mit Honig verklebt.
#. fr: Du nectar sucré recouvre tout le corps.
#. column 0: Nectar
msgctxt "Status:927:0:1"
msgid "Your entire body is covered in sweet-smelling nectar."
msgstr "Всё ваше тело покрыто сладко пахнущим нектаром."

#. ja: ブラックメナス
#. de: Dunkle Drohung
#. fr: Menace fulgurante
#. column 1: The beast is overtaken with madness.
msgctxt "Status:928:0:0"
msgid "Black Menace"
msgstr "Чёрная угроза"

#. ja: 雷獣が猛り狂った状態。
#. de: Rasend vor Wut.
#. fr: L'instinct animal a pris le dessus, rendant toute action im<shy>pré<shy>vi<shy>si<shy>ble.
#. column 0: Black Menace
msgctxt "Status:928:0:1"
msgid "The beast is overtaken with madness."
msgstr "Зверь обезумел."

#. ja: 被ダメージ低下
#. de: Verringerte Verwundbarkeit
#. fr: Vulnérabilité diminuée
#. column 1: Damage taken is reduced.
msgctxt "Status:929:0:0"
msgid "Vulnerability Down"
msgstr "Уязвимость снижена"

#. ja: 受けるダメージが軽減される状態。
#. de: Erlittener Schaden ist verringert.
#. fr: Les dégâts reçus sont réduits.
#. column 0: Vulnerability Down
msgctxt "Status:929:0:1"
msgid "Damage taken is reduced."
msgstr "Получаемый урон снижен."

#. ja: 拘束
#. de: Gefesselt
#. fr: Attache
#. column 1: Unable to execute actions.
msgctxt "Status:930:0:0"
msgid "Fetters"
msgstr "Оковы"

#. ja: 行動できなくなった状態。
#. de: Ist handlungsunfähig.
#. fr: Toute action est impossible.
#. column 0: Fetters
msgctxt "Status:930:0:1"
msgid "Unable to execute actions."
msgstr "Невозможно совершать действия."

#. ja: 打属性耐性低下
#. de: Schlagresistenz -
#. fr: Résistance au contondant réduite
#. column 1: Blunt resistance is reduced.
msgctxt "Status:931:0:0"
msgid "Blunt Resistance Down"
msgstr "Уязвимость к дробящему урону повышена"

#. ja: 打属性に対する耐性が低下した状態。
#. de: Schlagresistenz ist verringert.
#. fr: La résistance au contondant est réduite.
#. column 0: Blunt Resistance Down
msgctxt "Status:931:0:1"
msgid "Blunt resistance is reduced."
msgstr "Уязвимость к дробящему урону повышена."

#. ja: 隔離
#. de: Quarantäne
#. fr: Isolement
#. column 1: You are separated from your allies.
msgctxt "Status:932:0:0"
msgid "Quarantine"
msgstr "Карантин"

#. ja: 仲間から隔離された状態。
#. de: Von den Kameraden getrennt.
#. fr: À l'écart du reste du groupe.
#. column 0: Quarantine
msgctxt "Status:932:0:1"
msgid "You are separated from your allies."
msgstr "Вы отделены от союзников."

#. ja: 魔法回復力ダウン
#. de: Heilmagie-Malus
#. fr: Malus de magie curative
#. column 1: Healing magic potency is reduced.
msgctxt "Status:933:0:0"
msgid "Healing Potency Down"
msgstr "Сила лечения снижена"

#. ja: 魔法回復力が低下した状態。
#. de: Das Potenzial der Heilmagie ist verringert.
#. fr: La magie curative est réduite.
#. column 0: Healing Potency Down
msgctxt "Status:933:0:1"
msgid "Healing magic potency is reduced."
msgstr "Сила лечебной магии снижена."

#. ja: 被物理ダメージ増加
#. de: Erhöhte physische Verwundbarkeit
#. fr: Vulnérabilité physique augmentée
#. column 1: Physical damage taken is increased.
msgctxt "Status:934:0:0"
msgid "Physical Vulnerability Up"
msgstr "Физическая уязвимость повышена"

#. ja: 受ける物理ダメージが増加する状態。
#. de: Erlittener physischer Schaden ist erhöht.
#. fr: Les dégâts physiques reçus sont augmentés.
#. column 0: Physical Vulnerability Up
msgctxt "Status:934:0:1"
msgid "Physical damage taken is increased."
msgstr "Получаемый физический урон повышен."

#. ja: 寄生
#. de: Infestation
#. fr: Parasite
#. column 1: A parasite has entered the body and taken control of all motor skills. Parasite is passed via direct contact with other players.
msgctxt "Status:937:0:0"
msgid "Unwilling Host"
msgstr "Невольный носитель"

#. ja: 寄生されて操られた状態。ほかのプレイヤーを攻撃し続けてしまう。<br>攻撃されたプレイヤーも、寄生状態になる。
#. de: Ist befallen und greift Kameraden an. Die Infestation greift dabei auf die Angegriffenen über.
#. fr: L'organisme est devenu l'hôte de parasites, provoquant un élan d'agressivité envers les équipiers et leur transmettant l'infection.
#. column 0: Unwilling Host
msgctxt "Status:937:0:1"
msgid "A parasite has entered the body and taken control of all motor skills. Parasite is passed via direct contact with other players."
msgstr "Паразит проник в тело и управляет всеми движениями."

#. ja: 窒息
#. de: Erstickung
#. fr: Suffocation
#. column 1: Windpipe is crushed. KO is imminent.
msgctxt "Status:938:0:0"
msgid "Throttle"
msgstr "Газ"

#. ja: 効果時間が終了すると、窒息し戦闘不能状態になる。
#. de: Am Ende des Effekts tritt K. o. ein.
#. fr: Rend inconscient lorsque la durée de l'effet s'est écoulée.
#. column 0: Throttle
msgctxt "Status:938:0:1"
msgid "Windpipe is crushed. KO is imminent."
msgstr "Сдавленная трахея. Скоро вы потеряете сознание."

#. ja: アクション実行不可
#. de: Außer Gefecht
#. fr: Actions bloquées
#. column 1: Unable to execute actions.
msgctxt "Status:939:0:0"
msgid "Out of the Action"
msgstr "Вне боя"

#. ja: アクションが実行できなくなった状態。
#. de: Kommandos können nicht ausgeführt werden.
#. fr: Impossible d'utiliser des actions.
#. column 0: Out of the Action
msgctxt "Status:939:0:1"
msgid "Unable to execute actions."
msgstr "Невозможно совершать действия."

#. ja: ペイン
#. de: Blutung
#. fr: Saignement
#. column 1: Sustaining damage over time.
msgctxt "Status:940:0:0"
msgid "Bleeding"
msgstr "Кровотечение"

#. ja: 無属性ダメージにより、ＨＰが徐々に失われる状態。
#. de: Erleidet schrittweise Schaden.
#. fr: Des dégâts périodiques neutres sont subis.
#. column 0: Bleeding
msgctxt "Status:940:0:1"
msgid "Sustaining damage over time."
msgstr "Постепенно теряются HP."

#. ja: 遠隔無効
#. de: Immun gegen Fernattacken
#. fr: Invincibilité à distance
#. column 1: Invulnerable to ranged attacks.
msgctxt "Status:941:0:0"
msgid "Ranged Resistance"
msgstr "Защита от дальних атак"

#. ja: 遠隔攻撃を無効化する状態。
#. de: Erleidet keinen Schaden durch Fernangriffe.
#. fr: Insensible aux attaques à distance.
#. column 0: Ranged Resistance
msgctxt "Status:941:0:1"
msgid "Invulnerable to ranged attacks."
msgstr "Дальние атаки не наносят урон."

#. ja: 魔法無効
#. de: Immun gegen Magieattacken
#. fr: Invincibilité magique
#. column 1: Invulnerable to magic attacks.
msgctxt "Status:942:0:0"
msgid "Magic Resistance"
msgstr "Защита от магии"

#. ja: 魔法攻撃を無効化する状態。
#. de: Erleidet keinen Schaden durch Magie.
#. fr: Insensible aux attaques magiques.
#. column 0: Magic Resistance
msgctxt "Status:942:0:1"
msgid "Invulnerable to magic attacks."
msgstr "Магические атаки не наносят урон."

#. ja: 聖剣の加護
#. de: Askalons Schutz
#. fr: Égide d'Ascalon
#. column 1: Strengthened by the power of the dragon's eye imbued within the holy blade.
msgctxt "Status:943:0:0"
msgid "Light of Ascalon"
msgstr "Свет Аскалона"

#. ja: 聖剣アスカロンに秘められた竜の眼の力により、加護を受けた状態。
#. de: Von der sagenhaften Macht des Heiligen Schwerts geschützt.
#. fr: L'Œil du dragon à l'intérieur de l'épée Ascalon procure une puissante protection.
#. column 0: Light of Ascalon
msgctxt "Status:943:0:1"
msgid "Strengthened by the power of the dragon's eye imbued within the holy blade."
msgstr "Меч небес дарует вам силу драконьего ока, заключённого в клинке."

#. ja: 蒼天の剣
#. de: Azurklinge
#. fr: Épée de l'Azur
#. column 1: Damage dealt by self and nearby allies is increased.
msgctxt "Status:944:0:0"
msgid "Sword of the Heavens"
msgstr "Меч небес"

#. ja: 与ダメージが上昇した状態。なおかつ、周囲の仲間に同様の効果を与える。
#. de: Ausgeteilter Schaden ist für sich und Verbündete in der Nähe erhöht.
#. fr: Les dégâts infligés sont augmentés. Le même effet est conféré aux alliés alentour.
#. column 0: Sword of the Heavens
msgctxt "Status:944:0:1"
msgid "Damage dealt by self and nearby allies is increased."
msgstr "Наносимый вами и ближайшими союзниками урон повышен."

#. ja: 蒼天の盾
#. de: Azurschild
#. fr: Bouclier de l'Azur
#. column 1: Damage taken by self and all nearby allies is reduced.
msgctxt "Status:945:0:0"
msgid "Shield of the Heavens"
msgstr "Щит небес"

#. ja: 被ダメージを軽減する状態。なおかつ、周囲の仲間に同様の効果を与える。
#. de: Erlittener Schaden ist für sich und Verbündete in der Nähe verringert.
#. fr: Les dégâts reçus sont réduits. Le même effet est conféré aux alliés alentour.
#. column 0: Shield of the Heavens
msgctxt "Status:945:0:1"
msgid "Damage taken by self and all nearby allies is reduced."
msgstr "Получаемый вами и ближайшими союзниками урон снижен."

#. ja: 蜘蛛形態
#. de: Spinne
#. fr: Forme d'araignée
#. column 1: Physical form is changed to that of a spider.
msgctxt "Status:946:0:0"
msgid "Legs of the Spider"
msgstr "Ноги паука"

#. ja: 蜘蛛型の形状を成している状態。
#. de: Hat die Gestalt einer Spinne angenommen.
#. fr: Le ghrah a pris la forme d'une araignée.
#. column 0: Legs of the Spider
msgctxt "Status:946:0:1"
msgid "Physical form is changed to that of a spider."
msgstr "Вы приняли облик паука."

#. ja: 鳥形態
#. de: Vogel
#. fr: Forme d'oiseau
#. column 1: Physical form is changed to that of a bird of prey.
msgctxt "Status:947:0:0"
msgid "Wings of the Raptor"
msgstr "Крылья хищника"

#. ja: 鳥型の形状を成している状態。
#. de: Hat die Gestalt eines Vogels angenommen.
#. fr: Le ghrah a pris la forme d'un oiseau.
#. column 0: Wings of the Raptor
msgctxt "Status:947:0:1"
msgid "Physical form is changed to that of a bird of prey."
msgstr "Вы приняли облик хищной птицы."

#. ja: 雷属性反撃
#. de: Blitzkonter
#. fr: Riposte de foudre
#. column 1: Countering all attacks with lightning damage.
msgctxt "Status:948:0:0"
msgid "Shocking Counter"
msgstr "Шокирующий контрудар"

