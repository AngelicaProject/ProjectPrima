#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "Status:764:0:1"
msgid "<ui-color 500><ui-edge-color 501>Hook</ui-edge-color></ui-color> efficiency is reduced."
msgstr "Эффективность <ui-color 500><ui-edge-color 501>подсечки</ui-edge-color></ui-color> снижена."

#. ja: 最小サイズ向上
#. de: Fangen und Freilassen
#. fr: Pêche et remise à l'eau
#. column 1: Chance of landing fish of greater size is increased.
msgctxt "Status:765:0:0"
msgid "Catch and Release"
msgstr "Ловля с отпусканием"

#. ja: ノーマルサイズでも、サイズの大きい個体がかかりやすくなった状態。
#. de: Chance auf einen großen Fang, normale wie riesige Fische, ist erhöht.
#. fr: Les chances de pêcher de plus gros poissons, énormes ou non, sont augmentées.
#. column 0: Catch and Release
msgctxt "Status:765:0:1"
msgid "Chance of landing fish of greater size is increased."
msgstr "Повышается вероятность поймать рыбу покрупнее."

#. ja: 人形態
#. de: Anthropomimesis
#. fr: Anthropomorphie
#. column 1: The fluid has assumed the form of a man.
msgctxt "Status:766:0:0"
msgid "Anthropomorph"
msgstr "Человек"

#. ja: 人型の形状を成している状態。
#. de: Hat die Gestalt eines überlebensgroßen Eorzäers angenommen.
#. fr: L'ennemi a pris la forme d'un humain.
#. column 0: Anthropomorph
msgctxt "Status:766:0:1"
msgid "The fluid has assumed the form of a man."
msgstr "Жидкость приняла человеческий облик."

#. ja: 手形態
#. de: Chiromimesis
#. fr: Chiromorphie
#. column 1: The fluid has assumed the form of a hand.
msgctxt "Status:767:0:0"
msgid "Chiromorph"
msgstr "Рука"

#. ja: 手型の形状を成している状態。
#. de: Hat die Gestalt einer riesigen Hand angenommen.
#. fr: L'ennemi a pris la forme d'une main.
#. column 0: Chiromorph
msgctxt "Status:767:0:1"
msgid "The fluid has assumed the form of a hand."
msgstr "Жидкость приняла форму руки."

#. ja: 竜巻形態
#. de: Hydromimesis
#. fr: Hélicomorphie
#. column 1: The fluid has assumed the form of a vortex.
msgctxt "Status:768:0:0"
msgid "Anemomorph"
msgstr "Вихрь"

#. ja: 竜巻型の形状を成している状態。
#. de: Hat die Gestalt einer Wasserhose angenommen.
#. fr: L'ennemi a pris la forme d'une trombe marine.
#. column 0: Anemomorph
msgctxt "Status:768:0:1"
msgid "The fluid has assumed the form of a vortex."
msgstr "Жидкость приняла форму вихря."

#. ja: 炎の鎖
#. de: Brennende Ketten
#. fr: Chaînes brûlantes
#. column 1: Red-hot chains sear the flesh on your body, causing damage over time.
msgctxt "Status:769:0:0"
msgid "Burning Chains"
msgstr "Пылающие цепи"

#. ja: 炎の鎖で繋がれ、ＨＰが徐々に失われる状態。
#. de: Rotglühende Ketten versengen das Fleisch und verursachen schrittweise Schaden.
#. fr: Des dégâts périodiques sont subis à cause des brûlures causées par les chaînes.
#. column 0: Burning Chains
msgctxt "Status:769:0:1"
msgid "Red-hot chains sear the flesh on your body, causing damage over time."
msgstr "Раскалённые цепи обжигают тело и постепенно отнимают HP."

#. ja: 拘束
#. de: Gefesselt
#. fr: Attache
#. column 1: Unable to execute actions.
msgctxt "Status:770:0:0"
msgid "Fetters"
msgstr "Оковы"

#. ja: 行動できなくなった状態。
#. de: Ist handlungsunfähig.
#. fr: Toute action est impossible.
#. column 0: Fetters
msgctxt "Status:770:0:1"
msgid "Unable to execute actions."
msgstr "Невозможно выполнять действия."

#. ja: 奮起
#. de: Überschwang
#. fr: Remotivation
#. column 1: All action direction requirements are nullified.
msgctxt "Status:773:0:0"
msgid "Enliven"
msgstr "Воодушевление"

#. ja: 方向指定条件のあるアクションをどの方向から実行しても成功させる状態。
#. de: Richtungsbedingungen für Kommandos werden als erfüllt betrachtet.
#. fr: Les actions directionnelles réussissent dans n'importe quelle position.
#. column 0: Enliven
msgctxt "Status:773:0:1"
msgid "All action direction requirements are nullified."
msgstr "Для всех действий отменяются требования к направлению."

#. ja: ノックダウン
#. de: Am Boden
#. fr: Au tapis
#. column 1: Unable to move or execute actions.
msgctxt "Status:774:0:0"
msgid "Down for the Count"
msgstr "Нокаут"

#. ja: ノックダウンした状態。移動およびアクション実行不可。
#. de: Bewegungsunfähig, Kommandos können nicht ausgeführt werden.
#. fr: Impossible d'utiliser des actions ou de se déplacer.
#. column 0: Down for the Count
msgctxt "Status:774:0:1"
msgid "Unable to move or execute actions."
msgstr "Невозможно двигаться и выполнять действия."

#. ja: 無敵
#. de: Unverwundbar
#. fr: Invulnérable
#. column 1: Invulnerable to all damage.
msgctxt "Status:775:0:0"
msgid "Invincibility"
msgstr "Неуязвимость"

#. ja: 被ダメージを無効化する状態。
#. de: Erleidet keinen Schaden.
#. fr: Aucun dégât n'est subi.
#. column 0: Invincibility
msgctxt "Status:775:0:1"
msgid "Invulnerable to all damage."
msgstr "Вы неуязвимы к любому урону."

#. ja: 無敵
#. de: Unverwundbar
#. fr: Invulnérable
#. column 1: Invulnerable to all damage.
msgctxt "Status:776:0:0"
msgid "Invincibility"
msgstr "Неуязвимость"

#. ja: 被ダメージを無効化する状態。
#. de: Erleidet keinen Schaden.
#. fr: Aucun dégât n'est subi.
#. column 0: Invincibility
msgctxt "Status:776:0:1"
msgid "Invulnerable to all damage."
msgstr "Вы неуязвимы к любому урону."

#. ja: ヴォイドの加護
#. de: Nichtssegen
#. fr: Bénédiction du néant
#. column 1: A voidal barrier is nullifying damage and granting critical damage for all attacks.
msgctxt "Status:777:0:0"
msgid "Blessing of the Void"
msgstr "Благословение пустоты"

#. ja: ヴォイドの加護を得て、一定量のダメージを軽減するバリア効果が付与された状態。効果中はすべての攻撃がクリティカルになる。
#. de: Eine Nichtsbarriere blockiert jeden eingehenden Schaden und lässt jeden ausgehenden Angriff kritisch treffen.
#. fr: Une barrière issue du néant réduit les dégâts subis et fait de toutes les attaques des coups critiques.
#. column 0: Blessing of the Void
msgctxt "Status:777:0:1"
msgid "A voidal barrier is nullifying damage and granting critical damage for all attacks."
msgstr "Барьер пустоты поглощает урон, а все ваши атаки становятся критическими."

#. ja: 土の契り
#. de: Irdischer Pakt
#. fr: Accord terrestre
#. column 1: The land is under unwavering rule.
msgctxt "Status:778:0:0"
msgid "Earthen Accord"
msgstr "Земной союз"

#. ja: 土地を支配している状態。
#. de: Beherrscht den Boden völlig.
#. fr: Un lien sacré avec la terre a été créé.
#. column 0: Earthen Accord
msgctxt "Status:778:0:1"
msgid "The land is under unwavering rule."
msgstr "Вы непреклонно правите землёй."

#. ja: 幽体離脱
#. de: Außerkörperlichkeit
#. fr: Dissociation corps-âme
#. column 1: Spirit and body are temporarily disjoined.
msgctxt "Status:779:0:0"
msgid "Out of Body"
msgstr "Вне тела"

#. ja: 身体と魂が分離してしまった状態。
#. de: Geist und Körper sind vor<shy>über<shy>gehend voneinander gelöst.
#. fr: L'âme et le corps sont séparés l'un de l'autre.
#. column 0: Out of Body
msgctxt "Status:779:0:1"
msgid "Spirit and body are temporarily disjoined."
msgstr "Дух и тело временно разлучены."

#. ja: 超越者
#. de: Übernatürliche Kraft
#. fr: Résonnant
#. column 1: Strength is transcending that of mere mortals.
msgctxt "Status:780:0:0"
msgid "Resonant"
msgstr "Резонанс"

#. ja: 人工的な超える力を発動している状態。
#. de: Besitzt Kräfte, die diejenigen einfacher Sterblicher transzendieren.
#. fr: Un pouvoir similaire à l'Écho a été obtenu ar<shy>ti<shy>fi<shy>ciellement.
#. column 0: Resonant
msgctxt "Status:780:0:1"
msgid "Strength is transcending that of mere mortals."
msgstr "Ваша сила превосходит силы простых смертных."

#. ja: エーテル酔い
#. de: Ätherüberreizung
#. fr: Ivresse éthérée
#. column 1: Overexposure to concentrated aether is preventing resonation.
msgctxt "Status:781:0:0"
msgid "Aether Sickness"
msgstr "Эфирная болезнь"

#. ja: エーテル酔いが発生し、超越者の力が発動できない状態。
#. de: Zu viel Äther verhindert die Entfesselung übernatürlicher Kräfte.
#. fr: Des perturbations dans l'éther gênent les pouvoirs de Résonnant.
#. column 0: Aether Sickness
msgctxt "Status:781:0:1"
msgid "Overexposure to concentrated aether is preventing resonation."
msgstr "Избыток концентрированного эфира не даёт войти в резонанс."

#. ja: 妖刀解放
#. de: Entfesselte Klinge
#. fr: Pouvoir déchaîné
#. column 1: The true power of Ame-no-Habakiri is unleashed.
msgctxt "Status:782:0:0"
msgid "Unbridled"
msgstr "Непокорная"

#. ja: 妖刀アメノハバキリの力を解放した状態。
#. de: Die Kraft des Ame no Habakiri ist entfesselt.
#. fr: Le véritable pouvoir d'Ame no Habakiri est libéré.
#. column 0: Unbridled
msgctxt "Status:782:0:1"
msgid "The true power of Ame-no-Habakiri is unleashed."
msgstr "Истинная сила Аме-но-Хабакири пробудилась."

#. ja: ノックダウン
#. de: Am Boden
#. fr: Au tapis
#. column 1: Unable to move or execute actions.
msgctxt "Status:783:0:0"
msgid "Down for the Count"
msgstr "Нокаут"

#. ja: ノックダウンした状態。移動およびアクション実行不可。
#. de: Bewegungsunfähig, Kommandos können nicht ausgeführt werden.
#. fr: Impossible d'utiliser des actions ou de se déplacer.
#. column 0: Down for the Count
msgctxt "Status:783:0:1"
msgid "Unable to move or execute actions."
msgstr "Невозможно двигаться и выполнять действия."

#. ja: 妖異の血
#. de: Nichtsblut
#. fr: Sang du néant
#. column 1: Covered in voidsent blood. Damage taken is increased.
msgctxt "Status:784:0:0"
msgid "Voidblood"
msgstr "Кровь пустоты"

#. ja: 妖異の血を浴びた状態。被ダメージが上昇する。
#. de: Mit dem Blut Nichts<shy>gesand<shy>ter verschmiert, das den erlittenen Schaden erhöht.
#. fr: Les dégâts subis sont augmentés à cause du sang du néant qui recouvre le corps.
#. column 0: Voidblood
msgctxt "Status:784:0:1"
msgid "Covered in voidsent blood. Damage taken is increased."
msgstr "Вы покрыты кровью исчадий пустоты. Получаемый урон увеличен."

#. ja: トンベリ病
#. de: Nym-Pest
#. fr: Lèpre du tomberry
#. column 1: Infected with the Nymian Plague. If not cured, you will transform into a tonberry.
msgctxt "Status:785:0:0"
msgid "Nymian Plague"
msgstr "Нимская чума"

#. ja: トンベリ病に感染した状態。治療しないと、トンベリ化してしまう。
#. de: Mit der nymischen Pest infiziert. Führt unbehandelt zur Ver<shy>wand<shy>lung in einen Tomberry.
#. fr: Début d'infection qui transforme en tomberry à terme.
#. column 0: Nymian Plague
msgctxt "Status:785:0:1"
msgid "Infected with the Nymian Plague. If not cured, you will transform into a tonberry."
msgstr "Вы заражены нимской чумой. Если не вылечиться, вы превратитесь в тонберри."

#. ja: バトルリタニー
#. de: Litanei der Schlacht
#. fr: Litanie combattante
#. column 1: Critical hit rate is increased.
msgctxt "Status:786:0:0"
msgid "Battle Litany"
msgstr "Боевая литания"

#. ja: クリティカル発動率が向上した状態。
#. de: Kritische Trefferrate ist erhöht.
#. fr: Les chances de critiques sont augmentées.
#. column 0: Battle Litany
msgctxt "Status:786:0:1"
msgid "Critical hit rate is increased."
msgstr "Вероятность критического удара повышена."

#. ja: 影渡［被］
#. de: Schattenwandler
#. fr: Silhouette
#. column 1: A portion of enmity generated by a ninja is being directed to you.
msgctxt "Status:787:0:0"
msgid "Silhouette"
msgstr "Силуэт"

#. ja: 忍者が発生させる敵視の一部を移される状態。
#. de: Übernimmt Feindseligkeit von dem verursachenden Ninja.
#. fr: Reçoit une partie de l'inimitié générée par le ninja manipulateur d'ombre.
#. column 0: Silhouette
msgctxt "Status:787:0:1"
msgid "A portion of enmity generated by a ninja is being directed to you."
msgstr "Часть враждебности, создаваемой ниндзя, направляется на вас."

#. ja: 影渡
#. de: Schattenwandler
#. fr: Manipulateur d'ombre
#. column 1: A portion of enmity generated is being directed to a party member.
msgctxt "Status:788:0:0"
msgid "Shadewalker"
msgstr "Теневой шаг"

#. ja: 自身が発生させる敵視の一部を対象に移す状態。
#. de: Gibt Feindseligkeit an ein Ziel weiter.
#. fr: Redirige une partie de l'inimitié générée vers un équipier.
#. column 0: Shadewalker
msgctxt "Status:788:0:1"
msgid "A portion of enmity generated is being directed to a party member."
msgstr "Часть создаваемой вами враждебности направляется на участника группы."

#. ja: 煙玉
#. de: Rauchschwaden
#. fr: Écran de fumée
#. column 1: Enmity generation is reduced.
msgctxt "Status:789:0:0"
msgid "Smoke Screen"
msgstr "Дымовая завеса"

#. ja: 敵視上昇が抑えられた状態。
#. de: Erzeugt weniger Feindseligkeit als gewöhnlich.
#. fr: L'inimitié générée est réduite.
#. column 0: Smoke Screen
msgctxt "Status:789:0:1"
msgid "Enmity generation is reduced."
msgstr "Создаваемая враждебность снижена."

#. ja: 一双
#. de: Dualität
#. fr: Dualité
#. column 1: Next weaponskill will be executed multiple times.
msgctxt "Status:790:0:0"
msgid "Duality"
msgstr "Двойственность"

#. ja: 自身が次に実行するウェポンスキルの攻撃回数が増加する状態。
#. de: Nächste auf ein Einzelziel gerichtete Waf<shy>fen<shy>fer<shy>tig<shy>keit wird mehrmals ausgeführt.
#. fr: Plusieurs coups sont portés lors de la prochaine technique d'arme.
#. column 0: Duality
msgctxt "Status:790:0:1"
msgid "Next weaponskill will be executed multiple times."
msgstr "Следующее оружейное умение сработает несколько раз."

#. ja: 転化
#. de: Dissipation
#. fr: Dissipation
#. column 1: Healing magic potency is increased.
msgctxt "Status:791:0:0"
msgid "Dissipation"
msgstr "Рассеивание"

#. ja: 回復魔法の回復量が向上した状態。
#. de: Wirkung von Heilmagie ist erhöht.
#. fr: La puissance de la magie curative est augmentée.
#. column 0: Dissipation
msgctxt "Status:791:0:1"
msgid "Healing magic potency is increased."
msgstr "Сила исцеляющей магии повышена."

#. ja: 応急戦術
#. de: Apotropaion
#. fr: Stratagème de l'urgence
#. column 1: The next <ui-color 506><ui-edge-color 507>Galvanize</ui-edge-color></ui-color> and <ui-color 506><ui-edge-color 507>Catalyze</ui-edge-color></ui-color> statuses are transformed into HP recovery equaling the amount of damage reduction intended for their barriers.
msgctxt "Status:792:0:0"
msgid "Emergency Tactics"
msgstr "Тактика экстренной помощи"

#. ja: 次に詠唱する鼓舞効果および激励効果を伴う回復魔法について、バリア効果を発生させない代わりにその分を回復効果にして発動させる状態。
#. de: Nächste erlangte <ui-color 506><ui-edge-color 507>Dynamisieren</ui-edge-color></ui-color>- oder <ui-color 506><ui-edge-color 507>Katalyse</ui-edge-color></ui-color>-Barriere wird aufgehoben und in LP-Regeneration in Höhe der Schadensreduktion umgewandelt.
#. fr: Le prochain effet Réconfort ou Exhortation à être appliqué devient une récupération de PV équivalente au montant de dégâts que la barrière devait annuler.
#. column 0: Emergency Tactics
#. macro: <ui-color 506> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 506 (formatting: keep it as often as the source has it)
#. macro: <ui-edge-color 507> — text outline color from the UIColor sheet; </ui-edge-color> restores the previous color; color = 507 (formatting: keep it as often as the source has it)
