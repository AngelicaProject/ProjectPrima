#. column 0: Omega-M
msgctxt "Status:3454:0:1"
msgid "Mimicking the male form."
msgstr "Омега приняла мужской облик."

#. ja: 液状化
#. de: Verflüssigt
#. fr: Liquéfaction
#. column 1: In a transitional liquid state.
msgctxt "Status:3455:0:0"
msgid "Superfluid"
msgstr "Сверхтекучесть"

#. ja: 液状化した状態。
#. de: Befindet sich in einem flüssigen Zustand.
#. fr: L'organisme est passé à l'état liquide.
#. column 0: Superfluid
msgctxt "Status:3455:0:1"
msgid "In a transitional liquid state."
msgstr "Переходное жидкое состояние."

#. ja: サークルプログラム
#. de: Programmschleife
#. fr: Boucle de programme
#. column 1: Corrupted by Omega's program loop.
msgctxt "Status:3456:0:0"
msgid "Looper"
msgstr "Зацикливание"

#. ja: オメガのサークルプログラムに汚染された状態。
#. de: Von Omegas Programmschleife erfasst.
#. fr: L'organisme est corrompu par la boucle de programme d'Oméga.
#. column 0: Looper
msgctxt "Status:3456:0:1"
msgid "Corrupted by Omega's program loop."
msgstr "Заражён программным циклом Омеги."

#. ja: バインド
#. de: Fessel
#. fr: Entrave
#. column 1: Unable to move.
msgctxt "Status:3457:0:0"
msgid "Bind"
msgstr "Связь"

#. ja: 移動できなくなった状態。
#. de: Bewegungsunfähig.
#. fr: Tout déplacement est impossible.
#. column 0: Bind
msgctxt "Status:3457:0:1"
msgid "Unable to move."
msgstr "Невозможно передвигаться."

#. ja: 絶技実行可
#. de: Ring frei
#. fr: Attaque ultime du gentilhomme préparée
#. column 1: Ready to perform miraculous feats that transcend the abilities of mankind.
msgctxt "Status:3458:0:0"
msgid "Gloves Off"
msgstr "Без перчаток"

#. ja: 人の限界を超えた絶技を実行可能な状態。
#. de: Bereit, Wunder zu vollbringen, die über die Fä<shy>hig<shy>kei<shy>ten Sterblicher hinausgehen.
#. fr: Une attaque d'une puissance dépassant l'entendement humain peut être utilisée.
#. column 0: Gloves Off
msgctxt "Status:3458:0:1"
msgid "Ready to perform miraculous feats that transcend the abilities of mankind."
msgstr "Готовы совершать чудеса, превосходящие человеческие возможности."

#. ja: 青花の加護
#. de: Blaue Benediktion
#. fr: Bénédiction d'azur
#. column 1: Resistant to blueblossom aether.
msgctxt "Status:3459:0:0"
msgid "Blooming Blue"
msgstr "Цветущий лазурью"

#. ja: 青花の魔力に耐性を得た状態。
#. de: Der Effekt von blauen Blütenblättern ist geschwächt.
#. fr: L'effet des pétales d'azur est diminué.
#. column 0: Blooming Blue
msgctxt "Status:3459:0:1"
msgid "Resistant to blueblossom aether."
msgstr "Устойчивость к эфиру лазурных цветов."

#. ja: 黄花の加護
#. de: Gelbe Benediktion
#. fr: Bénédiction dorée
#. column 1: Resistant to goldblossom aether.
msgctxt "Status:3460:0:0"
msgid "Blooming Gold"
msgstr "Цветущий золотом"

#. ja: 黄花の魔力に耐性を得た状態。
#. de: Der Effekt von gelben Blütenblättern ist geschwächt.
#. fr: L'effet des pétales dorés est diminué.
#. column 0: Blooming Gold
msgctxt "Status:3460:0:1"
msgid "Resistant to goldblossom aether."
msgstr "Устойчивость к эфиру золотых цветов."

#. ja: ピヨピヨ
#. de: Gezwitscher
#. fr: Cui cui
#. column 1: The incessant chirping of birds is scattering thoughts, preventing all action.
msgctxt "Status:3461:0:0"
msgid "Featherbrained"
msgstr "Птичья голова"

#. ja: ピヨピヨして、一時的に行動できない状態。
#. de: Das unaufhörliche Zwitschern von Vögeln zerstreut deine Gedanken und macht dich handlungsunfähig.
#. fr: Fait voir trente-six chocobos et empêche temporairement toute action.
#. column 0: Featherbrained
msgctxt "Status:3461:0:1"
msgid "The incessant chirping of birds is scattering thoughts, preventing all action."
msgstr "Бесконечное птичье щебетание путает мысли и лишает возможности действовать."

#. ja: 毒
#. de: Gift
#. fr: Poison
#. column 1: Toxins are causing damage over time.
msgctxt "Status:3462:0:0"
msgid "Poison"
msgstr "Отравление"

#. ja: 毒に冒された状態。ＨＰが徐々に失われる。
#. de: Erleidet schrittweise Schaden durch Gift.
#. fr: Des dégâts périodiques de poison sont subis.
#. column 0: Poison
msgctxt "Status:3462:0:1"
msgid "Toxins are causing damage over time."
msgstr "Яды постепенно отнимают HP."

#. ja: 麻痺
#. de: Paralyse
#. fr: Paralysie
#. column 1: Deadened nerves are sometimes preventing the execution of actions.
msgctxt "Status:3463:0:0"
msgid "Paralysis"
msgstr "Паралич"

#. ja: 身体が痺れ、時々行動できなくなる状態。
#. de: Paralysierte Nerven erschweren Kommandos immer mehr.
#. fr: Une paralysie empêche parfois d'effectuer des actions.
#. column 0: Paralysis
msgctxt "Status:3463:0:1"
msgid "Deadened nerves are sometimes preventing the execution of actions."
msgstr "Онемевшие нервы мешают действовать."

#. ja: スロウ
#. de: Gemach
#. fr: Lenteur
#. column 1: Weaponskill cast time and recast time, spell cast time and recast time, and auto-attack delay are increased.
msgctxt "Status:3464:0:0"
msgid "Slow"
msgstr "Замедление"

#. ja: オートアタックの攻撃間隔と、ウェポンスキルおよび魔法のキャストタイムとリキャストタイムが延長された状態。
#. de: Die Intervalle zwischen Auto-Attacken und die (Re-)Ak<shy>ti<shy>vie<shy>rungs<shy>zei<shy>ten von Waf<shy>fen<shy>fer<shy>tig<shy>kei<shy>ten und Magie sind verlängert.
#. fr: La vitesse des attaques automatiques est réduite, et les temps de lancement et de recharge des sorts et des techniques d'arme sont allongés.
#. column 0: Slow
msgctxt "Status:3464:0:1"
msgid "Weaponskill cast time and recast time, spell cast time and recast time, and auto-attack delay are increased."
msgstr "Увеличены время применения и перезарядки оружейных приёмов и заклинаний, а также задержка автоатаки."

#. ja: スタン
#. de: Betäubung
#. fr: Étourdissement
#. column 1: Unable to execute actions.
msgctxt "Status:3465:0:0"
msgid "Stun"
msgstr "Оглушение"

#. ja: 行動できなくなった状態。
#. de: Betäubte Sinne verhindern das Ausführen jeglicher Kommandos.
#. fr: Toute action est impossible.
#. column 0: Stun
msgctxt "Status:3465:0:1"
msgid "Unable to execute actions."
msgstr "Невозможно совершать действия."

#. ja: 睡眠
#. de: Schlaf
#. fr: Sommeil
#. column 1: Overwhelming drowsiness is preventing the execution of actions.
msgctxt "Status:3466:0:0"
msgid "Sleep"
msgstr "Сон"

#. ja: 眠りに落ち、行動できなくなった状態。
#. de: Tiefschlaf verhindert das Ausführen jeglicher Kommandos.
#. fr: Le sommeil empêche toute action.
#. column 0: Sleep
msgctxt "Status:3466:0:1"
msgid "Overwhelming drowsiness is preventing the execution of actions."
msgstr "Непреодолимая сонливость мешает действовать."

#. ja: 魅惑の香光
#. de: Betört und Verlockt
#. fr: Encens lumineux
#. column 1: Overcome and quite unable to act.
msgctxt "Status:3467:0:0"
msgid "Vegetal Vapours"
msgstr "Растительный дурман"

