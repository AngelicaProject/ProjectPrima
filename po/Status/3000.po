msgid "Able to execute <ui-color 500><ui-edge-color 501>Fountainfall</ui-edge-color></ui-color> or <ui-color 500><ui-edge-color 501>Bloodshower</ui-edge-color></ui-color>."
msgstr "Можно применить <ui-color 500><ui-edge-color 501>Каскадный фонтан</ui-edge-color></ui-color> или <ui-color 500><ui-edge-color 501>Кровавый ливень</ui-edge-color></ui-color>."

