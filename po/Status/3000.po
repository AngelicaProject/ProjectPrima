msgctxt "Status:3019:0:1"
msgid "Able to execute <ui-color 500><ui-edge-color 501>Confiteor</ui-edge-color></ui-color>."
msgstr "Можно применить <ui-color 500><ui-edge-color 501>Конфитеор</ui-edge-color></ui-color>."

#. ja: 魂の総和
#. de: 魂の総和
#. fr: Poids total
#. column 1: The number of souls currently being weighed.
msgctxt "Status:3020:0:0"
msgid "Souls in the Balance"
msgstr "Души на весах"

#. ja: 幻体に計上されている魂の総数。
#. de: 幻体に計上されている魂の総数。
#. fr: Nombre d'âmes incluses dans le poids total.
#. column 0: Souls in the Balance
msgctxt "Status:3020:0:1"
msgid "The number of souls currently being weighed."
msgstr "Число душ, которые сейчас взвешивают."

#. ja: 防御不可
#. de: Wehrlos
#. fr: Garde impossible
#. column 1: Unable to execute <ui-color 500><ui-edge-color 501>Guard</ui-edge-color></ui-color>.
msgctxt "Status:3021:0:0"
msgid "Unguarded"
msgstr "Без защиты"

#. ja: 防御を使用できない状態。
#. de: <ui-color 500><ui-edge-color 501>Wehr</ui-edge-color></ui-color> kann nicht ausgeführt werden.
#. fr: Garde ne peut être utilisée.
#. column 0: Unguarded
#. macro: <ui-color 500> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 500 (formatting: keep it as often as the source has it)
#. macro: <ui-edge-color 501> — text outline color from the UIColor sheet; </ui-edge-color> restores the previous color; color = 501 (formatting: keep it as often as the source has it)
#. macro: </ui-edge-color> — end of: text outline color from the UIColor sheet; </ui-edge-color> restores the previous color (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "Status:3021:0:1"
msgid "Unable to execute <ui-color 500><ui-edge-color 501>Guard</ui-edge-color></ui-color>."
msgstr "Нельзя применить <ui-color 500><ui-edge-color 501>Защиту</ui-edge-color></ui-color>."

#. ja: 徐々に睡眠
#. de: Schlaftrunken
#. fr: Sommeil graduel
#. column 1: Struggling to keep eyes open. Will succumb to <ui-color 506><ui-edge-color 507>Sleep</ui-edge-color></ui-color> when effect expires.
msgctxt "Status:3022:0:0"
msgid "Half-asleep"
msgstr "Дрёма"

#. ja: 徐々に眠りつつある状態。効果終了時に睡眠状態になる。
#. de: Nach Ablauf der Wirkungsdauer tritt <ui-color 506><ui-edge-color 507>Schlaf</ui-edge-color></ui-color> ein.
#. fr: Le corps tombe peu à peu en léthargie. Lorsque l'effet prend fin, la victime subit Sommeil.
#. column 0: Half-asleep
#. macro: <ui-color 506> — text color from the UIColor sheet; </ui-color> restores the previous color; color = 506 (formatting: keep it as often as the source has it)
#. macro: <ui-edge-color 507> — text outline color from the UIColor sheet; </ui-edge-color> restores the previous color; color = 507 (formatting: keep it as often as the source has it)
#. macro: </ui-edge-color> — end of: text outline color from the UIColor sheet; </ui-edge-color> restores the previous color (formatting: keep it as often as the source has it)
#. macro: </ui-color> — end of: text color from the UIColor sheet; </ui-color> restores the previous color (formatting: keep it as often as the source has it)
msgctxt "Status:3022:0:1"
msgid "Struggling to keep eyes open. Will succumb to <ui-color 506><ui-edge-color 507>Sleep</ui-edge-color></ui-color> when effect expires."
msgstr "Вы изо всех сил боретесь со сном. Когда эффект закончится, вас одолеет <ui-color 506><ui-edge-color 507>Сон</ui-edge-color></ui-color>."

#. ja: 恐慌
#. de: Panik
#. fr: Hystérie
#. column 1: Unable to act on your own free will.
msgctxt "Status:3023:0:0"
msgid "Hysteria"
msgstr "Истерия"

#. ja: 恐怖で行動できなくなり、勝手に動いてしまう状態。
#. de: Vor lauter Angst keine Kontrolle über die Bewegung.
#. fr: Incapable d'agir de sa propre volonté.
#. column 0: Hysteria
msgctxt "Status:3023:0:1"
msgid "Unable to act on your own free will."
msgstr "От страха вы не можете действовать по своей воле."

#. ja: 誘惑
#. de: Versuchung
#. fr: Séduction
#. column 1: Enthralled by an irresistible force and unable to act of your own volition.
msgctxt "Status:3024:0:0"
msgid "Seduced"
msgstr "Очарование"

#. ja: 誘惑を受け心奪われ、勝手に動いてしまう状態。
#. de: Hat keine Kontrolle mehr über die eigenen Bewegungen.
#. fr: Toute volonté est perdue, et les mouvements deviennent erratiques.
#. column 0: Seduced
msgctxt "Status:3024:0:1"
msgid "Enthralled by an irresistible force and unable to act of your own volition."
msgstr "Вы пленены неодолимой силой и не можете действовать по своей воле."

#. ja: 聖刻
#. de: Heiliges Recht
#. fr: Gravure sainte
#. column 1: Restoring HP to enemies who deal you damage.
msgctxt "Status:3025:0:0"
msgid "Sacred Claim"
msgstr "Священное притязание"

#. ja: 敵から攻撃を受けると攻撃者のＨＰが回復する状態。
#. de: Verursacher des Status regeneriert bei erlittener Attacke LP.
#. fr: Lorsqu'une attaque est subie, l'assaillant récupère des PV.
#. column 0: Sacred Claim
msgctxt "Status:3025:0:1"
msgid "Restoring HP to enemies who deal you damage."
msgstr "Враги, наносящие вам урон, восстанавливают HP."

#. ja: ホーリーシェルトロン
#. de: Heiliges Schiltron
#. fr: Schiltron sacré
#. column 1: A holy barrier is nullifying damage.
msgctxt "Status:3026:0:0"
msgid "Holy Sheltron"
msgstr "Священный шилтрон"

#. ja: 一定量のダメージを軽減する状態。
#. de: Erlittener Schaden ist um einen bestimmten Betrag verringert.
#. fr: Insensible à un certain montant de dégâts.
#. column 0: Holy Sheltron
msgctxt "Status:3026:0:1"
msgid "A holy barrier is nullifying damage."
msgstr "Священный барьер сводит урон на нет."

#. ja: コンフィテオル実行可
#. de: Confiteor
#. fr: Confiteor préparé
#. column 1: Able to execute <ui-color 500><ui-edge-color 501>Confiteor</ui-edge-color></ui-color>.
msgctxt "Status:3028:0:0"
msgid "Confiteor Ready"
msgstr "Готовность к конфитеору"

