#. column 0: Radiant Finale
msgctxt "Status:2964:0:1"
msgid "Damage dealt is increased."
msgstr "Наносимый урон повышен."

#. ja: 死腐毒
#. de: Todeshauch
#. fr: Toxine mortelle
#. column 1: Flesh is dying. When this effect expires, decay will result in KO.
msgctxt "Status:2965:0:0"
msgid "Necrosis"
msgstr "Некроз"

