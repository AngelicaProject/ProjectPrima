msgid "Body is slowly heating up. Will become <ui-color 506><ui-edge-color 507>Pyretic</ui-edge-color></ui-color> when this effect expires."
msgstr "Ваше тело постепенно нагревается. Когда эффект закончится, на вас наложится <ui-color 506><ui-edge-color 507>Жар</ui-edge-color></ui-color>."

#. ja: 徐々に氷結
#. de: Allmähliche Kühlung
