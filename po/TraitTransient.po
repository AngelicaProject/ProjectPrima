msgctxt "TraitTransient:67:0:0"
msgid "Allows the stacking of up to two <ui-color 506><ui-edge-color 507>Aetherflows</ui-edge-color></ui-color>."
msgstr "Позволяет накапливать до двух эффектов <ui-color 506><ui-edge-color 507>Эфирного потока</ui-edge-color></ui-color>."

#. ja: ＩＮＴが24上昇する。
