#. ja: NpcYellテストテキスト[1]
#. de: 0
#. fr: 0
msgctxt "NpcYell:1:0:13"
msgid "0"
msgstr "0"

#. ja: おーい、誰か手伝ってくれ！
#. de: 0
#. fr: Ohé<nbsp>! Aidez-moi<nbsp>!
msgctxt "NpcYell:2:0:13"
msgid "0"
msgstr "Эй, кто-нибудь, помогите!"

#. ja: 気をつけろ！　魔物が来るぞ！
#. de: Psst! Die Anolis kommen immer näher ...!
#. fr: Attention ! Les anolis approchent !
msgctxt "NpcYell:3:0:13"
msgid "Hush! The anoles draw near!"
msgstr "Тише! Анолисы близко!"

#. ja: インプが来るぞ！　逃がすな！
#. de: Kein einziger Imp darf entkommen!
#. fr: Les imps arrivent<nbsp>! Ne les laissez surtout pas s'échapper<nbsp>!
msgctxt "NpcYell:4:0:13"
msgid "Allow not a single imp to escape!"
msgstr "Ни один бес не должен улизнуть!"

#. ja: くそっ、数が多すぎる！
#. de: Verdammt, es sind zu viele!
#. fr: Bordel<nbsp>! Y en a trop !
msgctxt "NpcYell:5:0:13"
msgid "There are too many of them!"
msgstr "Их слишком много!"

#. ja: 魔物がもうそこまで来てるわ！
#. de: Die Schnaken! Sie sind überall!
#. fr: Les taons ! Il y en a parrrtout !
msgctxt "NpcYell:6:0:13"
msgid "The gnats! They're everywhere!"
msgstr "Комары! Они повсюду!"

#. ja: シルフ族が来るぞ！　警戒を！
#. de: Die Sylphen kommen, haltet euch bereit!
#. fr: Sylphes en approche ! Tous à vos armes !
msgctxt "NpcYell:7:0:13"
msgid "Hostile sylphs approach! Draw your weapons!"
msgstr "Силфы идут! Оружие наготове!"

#. ja: 魔物が増えてきた、注意しろ！
#. de: Oh nein, es werden immer mehr!
#. fr: Mais d'où viennent toutes ces créatures !?
msgctxt "NpcYell:8:0:13"
msgid "Whence did these stags come!?"
msgstr "Откуда столько оленей!?"

#. ja: ここの治安は我々が守る！
#. de: Wir werden für Sicherheit auf den Straßen sorgen!
#. fr: Il faut sécuriser les routes !
msgctxt "NpcYell:9:0:13"
msgid "We must keep the roads safe!"
msgstr "Надо обезопасить дороги!"

#. ja: 賊どもを調子に乗らせるな！
#. de: Denen werden wir's zeigen ...
#. fr: Donnons une leçon à ces racailles !
msgctxt "NpcYell:10:0:13"
msgid "These knaves must be taught a lesson!"
msgstr "Нужно проучить этих мерзавцев!"

#. ja: オポオポが豆を狙ってるぞ！
#. de: Sie sind hinter den Bohnen her!
#. fr: Attention<nbsp>! Ils en ont après les fèves !
msgctxt "NpcYell:11:0:13"
msgid "It is the beans they are after!"
msgstr "Им нужны бобы!"

#. ja: イクサル族が攻めてきたぞ！
#. de: Die Ixal! Zu Hilfe!
#. fr: Haro<nbsp>! Haro<nbsp>! Des Ixali nous attaquent !
msgctxt "NpcYell:12:0:13"
msgid "The Ixal! Someone save us!"
msgstr "Иксали! Кто-нибудь, спасите нас!"

#. ja: あれは……ジズか！？
#. de: Seit wann kommen die Ziz in diese Gegend?!
#. fr: Des ziz... ici !?
msgctxt "NpcYell:13:0:13"
msgid "What are ziz doing this far east!?"
msgstr "Что делают зизы так далеко на востоке!?"

#. ja: またきやがったか！
#. de: Da kommen sie schon wieder!
#. fr: Regardez, ils reviennent à la charge !
msgctxt "NpcYell:14:0:13"
msgid "The bud! We must protect the bud!"
msgstr "Опять они! Надо защитить росток!"

#. ja: 魔物が騒がしい、気をつけろ
#. de: Sieh dich vor, die Opo-Opos drehen durch!
#. fr: Prudence. Quelque chose excite les opo-opo.
msgctxt "NpcYell:15:0:13"
msgid "Take care. Something has the opo-opos in a frenzy."
msgstr "Осторожно. Что-то взбесило опо-опо."

#. ja: クッ……アレを使うしか……！
#. de: Bei den Höllen ... Zeit, die Taktik zu ändern!
#. fr: Ça va pas ! Il faut changer de stratégie<nbsp>!
msgctxt "NpcYell:16:0:13"
msgid "Seven hells! It's time for a change in plans."
msgstr "Семь кругов ада! Пора менять план."

#. ja: 殺れっ！　シュレッダー！！
#. de: Bringt sie um!
#. fr: Pas de quartier !
msgctxt "NpcYell:17:0:13"
msgid "Kill them all, my pet!"
msgstr "Убей их всех, мой питомец!"

#. ja: 誰か我々に協力してくれぬか？
#. de: Kann uns vielleicht jemand helfen?!
#. fr: Quelqu'un pourrait-il nous aider ?
msgctxt "NpcYell:18:0:13"
msgid "Would someone be so kind as to assist us?"
msgstr "Не найдётся ли кого-нибудь, кто нам поможет?"

#. ja: 誰か！　私を手伝え！
#. de: Meine Waren! Die Goblins haben meine Waren!
#. fr: Mes mar<shy>chan<shy>di<shy>ses ! Ces fichus Gobelins se sont enfuis avec !
msgctxt "NpcYell:19:0:13"
msgid "My wares! Those damned goblins have made off with my wares!"
msgstr "Мои товары! Окаянные гоблины утащили их!"

#. ja: おお、ゴーレムがこんなに！
#. de: Sieh dir all diese Golems an!
#. fr: Mazette<nbsp>! Regardez tous ces golems !
msgctxt "NpcYell:20:0:13"
msgid "Would ye look at all them golems!"
msgstr "Вы только гляньте, сколько тут големов!"

#. ja: インプめ、また現れたな！
#. de: Noch mehr Imps. Das gibt's doch nicht!
#. fr: Les imps sont revenus ! Protégez les ruches !
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:21:0:13"
msgid "Not <i>more</i> imps! They'll have all our honey!"
msgstr "Только не <i>ещё</i> бесы! Они же весь наш мёд утащат!"

#. ja: また花が食べられてる……
#. de: Wenn das so weitergeht, sind bald gar keine Blüten mehr übrig!
#. fr: À ce rythme, on n'aura plus aucune fleur d'ici demain<nbsp>!
msgctxt "NpcYell:22:0:13"
msgid "At this rate, there'll be no flowers left at all!"
msgstr "Так скоро и цветов совсем не останется!"

#. ja: イクサル族が来るぞ！　迎撃！
#. de: Haltet sie auf!
#. fr: À l'assaut<nbsp>! Interceptez les pilleurs ixali !
msgctxt "NpcYell:23:0:13"
msgid "Intercept the Ixali raiders!"
msgstr "Перехватите налётчиков-иксали!"

#. ja: だ、誰か！　手を貸してくれ！
#. de: Schaff mir einer diesen Typen vom Hals!
#. fr: Aidez-moi, s'il vous plaît<nbsp>!
msgctxt "NpcYell:24:0:13"
msgid "Get this man away from me!"
msgstr "Уберите от меня этого типа!"

#. ja: では、いきます！
#. de: Aus dem Weeeg!
#. fr: À l'attaaaque<nbsp>!
msgctxt "NpcYell:25:0:13"
msgid "Excelsior!"
msgstr "Превосходство!"

#. ja: うおおー！
#. de: Ngaaah!
#. fr: Aaarrh<nbsp>!
msgctxt "NpcYell:26:0:13"
msgid "Ngaaah!"
msgstr "А-а-а!"

#. ja: このっ！
#. de: Haah!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:27:0:13"
msgid "Hyah!"
msgstr "А ну!"

#. ja: 倒れろっ！
#. de: Stirb schon!
#. fr: Crève, charogne<nbsp>!
msgctxt "NpcYell:28:0:13"
msgid "Begone!"
msgstr "Сдохни!"

#. ja: くらえっ！
#. de: Hngg ...
#. fr: Sale bête<nbsp>!
msgctxt "NpcYell:29:0:13"
msgid "Down with you!"
msgstr "Получай!"

#. ja: まだまだ！
#. de: Versuch das nicht<br>noch mal, du ...!
#. fr: C'est pas fini !
msgctxt "NpcYell:30:0:13"
msgid "Try that again!"
msgstr "Ну, попробуй ещё раз!"

#. ja: こしゃくな！
#. de: Du gehörst mir!
#. fr: Misérable vermine<nbsp>!
msgctxt "NpcYell:31:0:13"
msgid "You're mine!"
msgstr "Ты мой!"

#. ja: どうだ！
#. de: Na los, wer will es mit mir aufnehmen?!
#. fr: T'en veux encore !?
msgctxt "NpcYell:32:0:13"
msgid "Had enough!?"
msgstr "Ну что, хватит!?"

#. ja: これくらいっ！
#. de: Was ist, willst du mehr?
#. fr: Prends ça !
msgctxt "NpcYell:33:0:13"
msgid "Take that!"
msgstr "Получай!"

#. ja: ヒャッハーー！！
#. de: Raaaaaaaah!
#. fr: Raaaaaah<nbsp>!
msgctxt "NpcYell:34:0:13"
msgid "Yaaaaaah!"
msgstr "А-а-а-а!"

#. ja: おらおらおらー！！
#. de: Das war's, mieses Gesindel!
#. fr: Prépare-toi à mourir !
msgctxt "NpcYell:35:0:13"
msgid "I'll kill all ye bastards!"
msgstr "Я всех вас, ублюдков, прикончу!"

#. ja: どけやコラァ！
#. de: Aus dem Weg!
#. fr: Dégage, minable<nbsp>!
msgctxt "NpcYell:36:0:13"
msgid "Out of me way!"
msgstr "С дороги, ну!"

#. ja: ブッ潰してやる！！
#. de: Ich mach dich fertig!
#. fr: Je vais t'arracher les yeux<nbsp>!
msgctxt "NpcYell:37:0:13"
msgid "Yer head's mine!"
msgstr "Твоя голова моя!"

#. ja: 遊んであげようか
#. de: Lass uns ein wenig Spaß haben!
#. fr: Je vais te fairrre danser !
msgctxt "NpcYell:38:0:13"
msgid "Let us dance!"
msgstr "Ну что, потанцуем?"

#. ja: 相手をしてほしいのかい？
#. de: Du wünschst eine Audienz beim König der Könige?
#. fr: Tu veux une audience avec le rrroi ?
msgctxt "NpcYell:39:0:13"
msgid "Seek you audience with the king?"
msgstr "Желаешь аудиенции у короля?"

#. ja: ひざまずけ
#. de: Knie nieder vor deinem König!
#. fr: Agenouille-toi devant ton souverrrain !
msgctxt "NpcYell:40:0:13"
msgid "Kneel before your king!"
msgstr "На колени перед королём!"

#. ja: もっといい声を聞かせておくれ
#. de: Ich will dich singen hören!
#. fr: Je veux t'entendrrre chanter !
msgctxt "NpcYell:41:0:13"
msgid "I want to hear you sing!"
msgstr "Хочу услышать, как ты поёшь!"

#. ja: 遠慮するなよ
#. de: Komm doch näher!
#. fr: Approche un peu...
msgctxt "NpcYell:42:0:13"
msgid "Come a little closer."
msgstr "Подойди-ка поближе."

#. ja: 調子に乗るな……！
#. de: Du wagst es ...!
#. fr: Pourrrquoi me défies-tu ?
msgctxt "NpcYell:43:0:13"
msgid "Why do you defy me?"
msgstr "Как ты смеешь мне перечить?"

#. ja: 刺激的じゃないか！
#. de: Das ist höchst impertinent.
#. fr: Oh<nbsp>! Quelle imperrrtinence<nbsp>!
msgctxt "NpcYell:44:0:13"
msgid "I am not amused!"
msgstr "Меня это не забавляет!"

#. ja: 踊れ！
#. de: Tanzt für euren König!
#. fr: Danse pour ton rrroi !
msgctxt "NpcYell:45:0:13"
msgid "Dance, you fools!"
msgstr "Танцуйте, глупцы!"

#. ja: これが欲しいのかい？
#. de: Ist es das, was du willst?
#. fr: C'est ça que tu cherches !?
msgctxt "NpcYell:46:0:13"
msgid "Is this what you seek?"
msgstr "Этого ты ищешь?"

#. ja: ほらほら！
#. de: Sieh her ...
#. fr: Alorrrs<nbsp>! Tu fatigues<nbsp>?
msgctxt "NpcYell:47:0:13"
msgid "Hissssss!"
msgstr "Ш-ш-ш-ш!"

#. ja: 仕返しでもしようってのか！
#. de: Was gibbssa ssu tuscheln, ihr Baum...sschnecken!
#. fr: Alors, ça... Hic<nbsp>! ça complote dans mon dos<nbsp>!?
msgctxt "NpcYell:48:0:13"
msgid "Whaddaya treeslugs talkinbout!?"
msgstr "Чего это вы там шепчетесь, слизни древесные!?"

#. ja: クソッ、お、覚えてやがれ！
#. de: Ssswerden wir schonnichs ... letzte Mal, kapiert?! Hick!
#. fr: J... J'me vengerai<nbsp>! F-foi de Spenser<nbsp>! Hic<nbsp>!
msgctxt "NpcYell:49:0:13"
msgid "Yehavn't seentha lassa Spessser! Hic!"
msgstr "Ты ещё увидишь Спессера! Ик!"

#. ja: ヒヒッ！　いい気味だぜぇ
#. de: Gahahah! Hick! Wer will als Nächssses?
#. fr: Mouah ha ha ! Au suivant !
msgctxt "NpcYell:50:0:13"
msgid "Gah hah hah! Who's next!?"
msgstr "Га-ха-ха! Кто следующий!?"

#. ja: うぅ……か、勘弁してくれぇ
#. de: Kann man hier nicht mal in Frieden seinen Met trinken?
#. fr: Je voulais juste boire mon hydromel tran<shy>quil<shy>le<shy>ment...
msgctxt "NpcYell:51:0:13"
msgid "Ulp! I just wanted to drink my mead in peace!"
msgstr "Ик! Я всего-то хотел спокойно выпить медовухи!"

#. ja: 文句あんのかぁ？
#. de: Hassu ... 'n Prolll...Bl...Prollem?! Was?
#. fr: Quand on m'cherche, hic<nbsp>! on m'trouve<nbsp>!
msgctxt "NpcYell:52:0:13"
msgid "You's a probbluh...prob...prollem wif that!?"
msgstr "У тебя есть... есть про... про-проблема с этим!?"

#. ja: ンだぁ、この野郎！
#. de: Heilllle Scheiße! Hick!
#. fr: Sale fiente de goobbue<nbsp>!
msgctxt "NpcYell:53:0:13"
msgid "Thal's balls!"
msgstr "Яйца Тала!"

#. ja: やるでふっち
#. de: Die Meinige ist bereit!
#. fr: Je suis prêt !
msgctxt "NpcYell:54:0:13"
msgid "This one has made ready!"
msgstr "Этот готов!"

#. ja: いくでふっち
#. de: Es geht los!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:55:0:13"
msgid "Listen! The forest speaks!"
msgstr "Лес говорит! Вперёд!"

#. ja: こらしめてやるでふっち
#. de: Die Andrigen müssen leiden!
#. fr: Vous allez souffrir !
msgctxt "NpcYell:56:0:13"
msgid "These ones must suffer!"
msgstr "Этим придётся худо!"

#. ja: まけないでふっち
#. de: Die Meinige wird nicht untergehen!
#. fr: Je n'ai pas dit mon dernier mot<nbsp>!
msgctxt "NpcYell:57:0:13"
msgid "This one will not perish!"
msgstr "Этот не погибнет!"

#. ja: 腕に自信のある者はいないか！
#. de: Das Klageregiment braucht Unterstützung!
#. fr: Les vigiles sombres cherchent des volontaires !
msgctxt "NpcYell:58:0:13"
msgid "Come! The Wood Wailers seek volunteers!"
msgstr "Стражам Лесного дозора нужны добровольцы! Кто смелый?"

#. ja: 貴様ら……生きては帰さんぞ！
#. de: Bis hierher habt ihr euch also geschleppt ... nur um hier zugrunde zu gehen!
#. fr: Vous repartirez pas en un seul morceau<nbsp>!
msgctxt "NpcYell:59:0:13"
msgid "Ye may've made it this far, but ye ain't gettin' out alive."
msgstr "Вы добрались так далеко, но живыми отсюда не уйдёте."

#. ja: さあ、全力で来い！
#. de: Macht schon! Zeigt mir, was ihr drauf habt!
#. fr: Montre-moi de quoi tu es capable<nbsp>!
msgctxt "NpcYell:60:0:13"
msgid "Hit me with all you have!"
msgstr "Ну же! Покажи, на что способен!"

#. ja: うむ、よくやった……！
#. de: Genug! Die Übung ist beendet.
#. fr: Ça suffit ! Beau travail, aujourd'hui.
msgctxt "NpcYell:61:0:13"
msgid "Enough! You've done well today."
msgstr "Довольно! Сегодня ты хорошо поработал."

#. ja: くそっ、数が多すぎる！
#. de: Verdammt, es sind zu viele!
#. fr: Par tous les dieux<nbsp>! Ils sont trop nombreux !
msgctxt "NpcYell:62:0:13"
msgid "There are too many of them!"
msgstr "Их слишком много!"

#. ja: 密猟者め！　許さんッ！
#. de: Denen werden wir das Wildern schon austreiben!
#. fr: Fichus braconniers, vous allez payer pour vos crimes<nbsp>!
msgctxt "NpcYell:63:0:13"
msgid "Tonight we shall poach the poachers!"
msgstr "Сегодня мы будем браконьерствовать на браконьерах!"

#. ja: 冒険者風情がいきがるなよ？
#. de: Ist der Stadt<shy>staat schon so arm, dass Abenteurer die Drecksarbeit erledigen müssen?
#. fr: La Cité en serait-elle réduite à envoyer des aventuriers faire son sale boulot ?
#. macro: <hyphen> — a hyphen that does not break the line (may be added or dropped)
msgctxt "NpcYell:64:0:13"
msgid "Are the resources of the city<hyphen>state so thinly stretched that they must send adventurers to do their dirty work?"
msgstr "У города-государства совсем нет сил, раз оно посылает приключенцев делать за него грязную работу?"

#. ja: く、くそ、こんなはずじゃ……
#. de: Ihr sollt verdammt sein! Der Wald gehört nicht euch!
#. fr: Soyez maudits ! La forêt n'est pas à vous !
msgctxt "NpcYell:65:0:13"
msgid "Damn you all! The forest is not yours to claim!"
msgstr "Будьте вы все прокляты! Лес не ваш!"

#. ja: なんだ　おまいら　近づくな～
#. de: Großwachsene werfen Gierauge auf Habensachen?
#. fr: Hé<nbsp>! On s'approche pas des affaires des Gobelins !
msgctxt "NpcYell:66:0:13"
msgid "Lustyeye uplanders seek goodgobbies' gobbiepack goodies?"
msgstr "Жадноглазые горцы хотят лакомства из гоббибага хороших гобби?"

#. ja: 爆弾　ほいほい　えっちらほい
#. de: Goblinhorde! Goblinhorde!
#. fr: Nos petits sacs sont remplis<nbsp>!
msgctxt "NpcYell:67:0:13"
msgid "Gobbiepack! Gobbiepack!"
msgstr "Гоббибэг! Гоббибэг!"

#. ja: バクハツ　バクハツ　大爆発～
#. de: Goblinhorde! Goblinhorde! Bumm bumm!
#. fr: Bien remplis<nbsp>!
msgctxt "NpcYell:68:0:13"
msgid "Gobbiepack! Gobbiepack! Little room!"
msgstr "Гоббибэг! Гоббибэг! Мало места!"

#. ja: ぼっかん　ぼっかん　大爆発～
#. de: Goblinhorde! Goblinhorde! Krawumm!
#. fr: Remplis d'explosifs !
msgctxt "NpcYell:69:0:13"
msgid "Gobbiepack! Gobbiepack! Filled with boom!"
msgstr "Гоббибэг! Гоббибэг! Полон бум-бум!"

#. ja: うちらの　お城が　壊された～
#. de: Nein! Goblinfeste wird Trümmerstaub!
#. fr: Non ! Pas toucher au joli château gobelin<nbsp>!
msgctxt "NpcYell:70:0:13"
msgid "No! Gobbiekeep rumbles and overtumbles!"
msgstr "Нет! Гоббикреп грохнется и развалится!"

#. ja: ちかづく　奴は　ぶっとばす～
#. de: Fort, Großwachsene! Sonst kommt Zerfetzenkugel!
#. fr: Demi-tour, les aventuriers ! Ou sinon... boum !
msgctxt "NpcYell:71:0:13"
msgid "Backwalk with fastness, uplander! Or else...ba-boom!"
msgstr "Быстро уходить, горец! Иначе... бабах!"

#. ja: 爆弾　ぽいぽい　おっちらぽい
#. de: Feuerbumm! Feuerbumm!
#. fr: Boum ! Boum ! Et reboum<nbsp>!
msgctxt "NpcYell:72:0:13"
msgid "Fireboom! Fireboom!"
msgstr "Огнебум! Огнебум!"

#. ja: 爆弾　爆弾　大爆発～
#. de: Feuerbumm! Feuerbumm! Bumm bumm!
#. fr: Boum boum ! On va vous envoyer une boulette<nbsp>!
msgctxt "NpcYell:73:0:13"
msgid "Fireboom! Fireboom! Uplander's doom!"
msgstr "Огнебум! Огнебум! Горец — бум-бум!"

#. ja: バクハツ　バクハツ　大爆発～
#. de: Feuerbumm! Feuerbumm! Krawumm!
#. fr: Boum ! Boum ! Six fulms sous terre !
msgctxt "NpcYell:74:0:13"
msgid "Fireboom! Fireboom! Uplander's tomb!"
msgstr "Огнебум! Огнебум! Горцу — могила!"

#. ja: なんと　お城が　壊された～
#. de: Nein! Goblinfestung alles Kaputtebrett!
#. fr: Oh non<nbsp>! Notre joli château gobelin tombe<nbsp>!
msgctxt "NpcYell:75:0:13"
msgid "Gobbiekeep crumbles and overtumbles!"
msgstr "Гоббикреп рушится и разваливается!"

#. ja: またまた　お城が　壊された～
#. de: Oh! Schöne Goblinfeste nur mehr Kleinesholz!
#. fr: Non<nbsp>! Encore un château gobelin par terre<nbsp>!
msgctxt "NpcYell:76:0:13"
msgid "Gobbiekeep tumbles and undercrumbles!"
msgstr "Гоббикреп валится и рассыпается!"

#. ja: ここは　わしらの　お城だど～
#. de: Großwachsene wollen Feste zu Flacherde machen! Flickblix heimzahlt mit Feuerbumm!
#. fr: Vilains aventuriers veulent casser nos châteaux<nbsp>!
msgctxt "NpcYell:77:0:13"
msgid "Narrowheart uplander seeks overtossing of good Gobbiekeep! Stikflix backpays with much fireboom!"
msgstr "Узкосердый горец хочет опрокинуть славный Гоббикреп! Стикфликс отплатит огнебумом!"

#. ja: おまいら　全員　ぶっとばす～
#. de: Goblinbande! Mehr Feuerbumm! Mehr Feuerbumm!
#. fr: Frères Gobelins ! Plus d'explosions ! Plus d'étincelles<nbsp>!
msgctxt "NpcYell:78:0:13"
msgid "Gobbiekin! More fireboom! More fireboom!"
msgstr "Гобби-родня! Ещё огнебум! Ещё огнебум!"

#. ja: イタタ　痛いよ　ちょっとまて
#. de: Oh! Großerschmerz in Denkschale ...
#. fr: Oh ! J'ai mal ! Et si on faisait affaire ? Non ?
msgctxt "NpcYell:79:0:13"
msgid "Oh! Such soreness of gut! Might we be making busydeal? No?"
msgstr "Ой! Живот болит! Может, сделаем выгодную сделку? Ну?"

#. ja: 爆弾　ぼんぼん　ぼっかんかん
#. de: Stickflix! Stickflix!
#. fr: Ça va péter en mille morceaux, boum<nbsp>!
msgctxt "NpcYell:80:0:13"
msgid "Stikflix! Stikflix!"
msgstr "Стикфликс! Стикфликс!"

#. ja: バクハツ　バクハツ　超爆発～
#. de: Stickflix! Stickflix! Bumm bumm!
#. fr: Boum ! J'aime quand ça fait boum !
msgctxt "NpcYell:81:0:13"
msgid "Stikflix! Stikflix! Quickflicks gloom!"
msgstr "Стикфликс! Стикфликс! Быстрый огнебум!"

#. ja: どっかん　ずっかん　超爆発～
#. de: Stickflix! Stickflix! Kawumm!
#. fr: C'est l'heure de sauter ! Boum boum !
msgctxt "NpcYell:82:0:13"
msgid "Stikflix! Stikflix! Fireboom resumes!"
msgstr "Стикфликс! Стикфликс! Огнебум возвращается!"

#. ja: みんなボクに従うのでふっち！
#. de: Meine geliebten Kreaturen! Kommt, folgt der Meinigen!
#. fr: Amies créatures ! Venez, par ici !
msgctxt "NpcYell:83:0:13"
msgid "Fellow creatures! Come, follow this one!"
msgstr "Создания, друзья! Идите за этим!"

#. ja: そろそろ本気を出すでふっち！
#. de: Die Meinige wird wütend ...
#. fr: La fureur m'emplit...
msgctxt "NpcYell:84:0:13"
msgid "This one angers..."
msgstr "Этот начинает злиться..."

#. ja: ここからが本気なのでふっち！
#. de: Der Meinigen reicht es so langsam ...
#. fr: La lassitude aussi...
msgctxt "NpcYell:85:0:13"
msgid "This one grows weary..."
msgstr "Этот устал..."

#. ja: ほ、本気の本気なのでふっち！
#. de: Die Meinige wird nicht länger leiden!
#. fr: Je ne souffrirai plus jamais ainsi !
msgctxt "NpcYell:86:0:13"
msgid "This one will suffer at the hands of the grounded ones no more!"
msgstr "Этот больше не станет терпеть мучения от приземлённых!"

#. ja: クァールクロウ様ぁっ！
#. de: Eure Hoheit!
#. fr: Votre Majesté !
msgctxt "NpcYell:87:0:13"
msgid "Your Highness!"
msgstr "Ваше Высочество!"

#. ja: すっこんでろ！
#. de: Bl...Blleibssu gefälligss hier!
#. fr: J'vais t'exploser la face<nbsp>!
msgctxt "NpcYell:88:0:13"
msgid "Sit yer poxy arse down!"
msgstr "Сиди на месте, вшивый зад!"

#. ja: ウッヒヒ、喰らえェ！
#. de: Gahahah!
#. fr: Ha ha ha<nbsp>! Prends ça dans tes dents<nbsp>!
msgctxt "NpcYell:89:0:13"
msgid "Gah hah hah!"
msgstr "Га-ха-ха! Получай!"

#. ja: おおっ！　ありがとう！
#. de: Ich hätte ihn sonst auch selbst ruhiggestellt ... Trotzdem danke!
#. fr: Merci<nbsp>! Merci mille fois<nbsp>!
msgctxt "NpcYell:90:0:13"
msgid "I could have taken him... Honest!"
msgstr "Я бы и сам с ним справился... Честно!"

#. ja: ありがとうございました！
#. de: Vielen Dank.
#. fr: Merci infiniment !
msgctxt "NpcYell:91:0:13"
msgid "You have my thanks!"
msgstr "Благодарю вас!"

#. ja: ううぅ……
#. de: ...
#. fr: Au secours<nbsp>!
msgctxt "NpcYell:92:0:13"
msgid "Mercy!"
msgstr "Пощады!"

#. ja: 未熟者め、出直してこい！
#. de: Für Weicheier hat die Bruderschaft keinen Platz!
#. fr: L'Ordre n'a pas besoin de chiffes molles !
msgctxt "NpcYell:93:0:13"
msgid "The Order has no need for milksops!"
msgstr "Ордену не нужны слабаки!"

#. ja: ありがとう！　ほら、来たぞ！
#. de: Oh nein! Hier kommt er schon!
#. fr: Oh, bon sang<nbsp>! Le voilà<nbsp>!!
msgctxt "NpcYell:94:0:13"
msgid "Oh dear! Here he comes!"
msgstr "Ох, нет! Вот он!"

#. ja: そろそろ見回りの時間か……
#. de: Bald ist es Zeit für meinen Rundgang ...
#. fr: Il est temps d'inspecter les récoltes...
msgctxt "NpcYell:95:0:13"
msgid "High time I should check the crops..."
msgstr "Пора проверить посевы..."

#. ja: うわぁ、レディバグだらけだ！
#. de: Marienkäfer! Ein ganzer Schwarm!
#. fr: Les coccinelles ! Elles s'en prennent aux abeilles !
msgctxt "NpcYell:96:0:13"
msgid "The ladybugs! They're attacking the bees!"
msgstr "Божьи коровки! Целый рой!"

#. ja: 誰かレディバグを追っ払ってー！
#. de: Jemand muss diese Biester verjagen!
#. fr: À l'aide ! Ces pauvres abeilles n'ont aucune chance !
msgctxt "NpcYell:97:0:13"
msgid "Someone help! The poor honeybees don't stand a chance!"
msgstr "Помогите! Бедным пчёлам не справиться!"

#. ja: よかった、これでひと安心だ！
#. de: Puh, hoffentlich haben wir jetzt erst mal etwas Ruhe.
#. fr: Les récoltes seront bonnes, cette année. Je le sens ! Merci beaucoup !
msgctxt "NpcYell:98:0:13"
msgid "The harvest will be a good one this season. I can feel it! You have my thanks!"
msgstr "В этом сезоне урожай будет хорошим. Чую! Спасибо вам!"

#. ja: なんてこった……
#. de: Sie haben uns alles kaputtgefressen! Wie schrecklich ...
#. fr: Et une autre récolte de perdue...
msgctxt "NpcYell:99:0:13"
msgid "Another harvest lost..."
msgstr "Ещё один урожай пропал..."

#. ja: スラッグがいっぱいきたー（仮）
#. de: 0
#. fr: 0
msgctxt "NpcYell:100:0:13"
msgid "0"
msgstr "Слизней полно (черновик)"

#. ja: よし！　みんなで乾杯だ！（仮）
#. de: 0
#. fr: 0
msgctxt "NpcYell:101:0:13"
msgid "0"
msgstr "0"

#. ja: はぁ、今日の俺の酒が…（仮）
#. de: 0
#. fr: 0
msgctxt "NpcYell:102:0:13"
msgid "0"
msgstr "0"

#. ja: だれかー（仮）
#. de: 0
#. fr: 0
msgctxt "NpcYell:103:0:13"
msgid "0"
msgstr "0"

#. ja: 俺の酒を守ってくれー（仮）
#. de: 0
#. fr: 0
msgctxt "NpcYell:104:0:13"
msgid "0"
msgstr "0"

#. ja: せっかくつまみを買ってきたのに…（仮）
#. de: 0
#. fr: 0
msgctxt "NpcYell:105:0:13"
msgid "0"
msgstr "0"

#. ja: やめてー（仮）
#. de: 0
#. fr: 0
msgctxt "NpcYell:106:0:13"
msgid "0"
msgstr "0"

#. ja: イヤふっち！　助けてふっちー！
#. de: Die Meinige braucht Hilfe!
#. fr: Au secours<nbsp>! Laissez-moi<nbsp>!
msgctxt "NpcYell:107:0:13"
msgid "This one requires aid!"
msgstr "Этому бедолаге нужна помощь!"

#. ja: ありがとでふっちー！
#. de: Vielen Dank!
#. fr: Je vous dois un grand merci,<br>vous m'avez sauvé la vie.
msgctxt "NpcYell:108:0:13"
msgid "Many thanks!"
msgstr "Спасибо огромное!"

#. ja: むむ……妙な気配がするぞ……
#. de: Hm? War da nicht gerade ein Geräusch?
#. fr: Hmm... Je sens une drôle de présence...
msgctxt "NpcYell:109:0:13"
msgid "Hm? Do you hear something?"
msgstr "Хм? Слышите что-нибудь?"

#. ja: この、意地汚いヴァルチャーめ！
#. de: Ich werde euch lehren, anderer Leute Überreste zu zerfleddern!
#. fr: Tiens<nbsp>! Mange ça, charogne<nbsp>!
msgctxt "NpcYell:110:0:13"
msgid "Why, you sneaky flying rat! I'll see you never eat another Lalafell!"
msgstr "Ах ты, летающая крыса! Я тебе больше ни одного лалафелла съесть не дам!"

#. ja: なんだてめぇ！
#. de: Verpiss dich, du kleiner Haufen Hörnchenscheiße!
#. fr: Tu commences sé<shy>rieu<shy>se<shy>ment à m'énerver<nbsp>!
msgctxt "NpcYell:111:0:13"
msgid "Sod off, ye sack o' squirrel shite!"
msgstr "Пошёл прочь, мешок беличьего дерьма!"

#. ja: 邪魔すんじゃねぇ！
#. de: Wer hat dich eingeladen, Wanze?
#. fr: Fous-moi la paix<nbsp>!
msgctxt "NpcYell:112:0:13"
msgid "Who invited this bastard!?"
msgstr "Кто, мать твою, тебя звал?!"

#. ja: 引っ込んでろ！
#. de: Mach dich vom Acker, bevor ich ungemütlich werden muss!
#. fr: Retourne jouer dans ton bac à sable<nbsp>!
msgctxt "NpcYell:113:0:13"
msgid "How's about I escort ye off the premises?"
msgstr "А не выпроводить ли тебя отсюда?"

#. ja: なめんじゃねーぞ！
#. de: Da scheint ein Schnüffler eine Abreibung zu brauchen!
#. fr: Misérable vermine<nbsp>!
msgctxt "NpcYell:114:0:13"
msgid "I spy a throat needs slittin'!"
msgstr "Гляжу, кому-то горло пора перерезать!"

#. ja: なんだ貴様！
#. de: Willst du zu uns?
#. fr: On nous cherchait<nbsp>?
msgctxt "NpcYell:115:0:13"
msgid "Lookin' fer us?"
msgstr "Нас ищешь?"

#. ja: 追手かっ！
#. de: Verschlagener Bastard ...
#. fr: On nous a suivis<nbsp>?
msgctxt "NpcYell:116:0:13"
msgid "Sneaky bastards."
msgstr "Хитрые ублюдки..."

#. ja: 体が重いよー
#. de: Mein Körper ... fühlt sich so schwer an.
#. fr: J'me sens louuurde<nbsp>! Fais quelque chose<nbsp>!
msgctxt "NpcYell:117:0:13"
msgid "Body feels...so heavy..."
msgstr "Тело... такое тяжёлое..."

#. ja: 本気だすと<br>いつもこうだよ！
#. de: Verdammt! Nicht jetzt!
#. fr: Zut, c'est pas le moment<nbsp>!
msgctxt "NpcYell:118:0:13"
msgid "Curses! Not now!"
msgstr "Проклятье! Не сейчас!"

#. ja: やはり冒険者に依頼すべきか
#. de: Ich sollte wohl besser<br>einen Abenteurer um<br>Hilfe bitten ...
#. fr: Ils sont trop rapides<nbsp>! Je ne pourrai pas les semer<nbsp>!
msgctxt "NpcYell:119:0:13"
msgid "They are too quick for me... I am done for..."
msgstr "Они слишком быстры... Мне конец..."

#. ja: 追っ手は来ないな、よし
#. de: Die Amalj'aa scheinen uns nicht zu verfolgen. Sehr gut.
#. fr: Je pense qu'on les a semés.
msgctxt "NpcYell:120:0:13"
msgid "I don't believe they will follow any further."
msgstr "Не думаю, что они пойдут дальше за нами."

#. ja: 協力に感謝する
#. de: Vielen Dank für deine Hilfe!
#. fr: Ul'dah vous doit une fière chandelle.
msgctxt "NpcYell:121:0:13"
msgid "You have done a great service for Ul'dah."
msgstr "Ты оказал огромную услугу Ульде."

#. ja: グゴゴゴゴゴゴ…
#. de: Gugooooahr!
#. fr: Grwooooooooh...
msgctxt "NpcYell:122:0:13"
msgid "\\<rumble> \\<rumble>"
msgstr "\\<грохот> \\<грохот>"

#. ja: グゴゴゴ…
#. de: Gugraaahr!
#. fr: Grwoooh...
msgctxt "NpcYell:123:0:13"
msgid "\\<rumble>"
msgstr "\\<грохот>"

#. ja: シ、シープの大群だぁっ！
#. de: Sch-Schafe! Eine ganze Herde! Sie rennen direkt auf uns zu!
#. fr: Des moutons ! Ils sont si nombreux !
msgctxt "NpcYell:124:0:13"
msgid "Sheep! Scores of them!"
msgstr "Овцы! Целая орава!"

#. ja: シープの群れを迎撃するんだ！
#. de: Eine Stampede! Wir müssen die Tiere stoppen!
#. fr: Tuez ces bêtes enragées avant qu'elles n'atteignent la porte !
msgctxt "NpcYell:125:0:13"
msgid "Slay the rabid beasts before they can force their way to the Zephyr Gate!"
msgstr "Убейте этих бешеных тварей, пока они не прорвались к Вратам Зефира!"

#. ja: 今のところ異常はないな
#. de: Hier ist alles ruhig ...
#. fr: Rien à signaler pour le moment.
msgctxt "NpcYell:126:0:13"
msgid "I fear my pursuers may have circled around, and await us ahead."
msgstr "Боюсь, преследователи могли обойти нас и устроить засаду впереди."

#. ja: 一本道か…要撃に備えろ
#. de: Eine Engstelle. Seht Euch vor!
#. fr: Si les Amalj'aa sont déjà là, c'est ici qu'ils vont nous tendre une embuscade.
msgctxt "NpcYell:127:0:13"
msgid "If the Amalj'aa have already made it this far, they will use this place to trap us."
msgstr "Если амалджа уже добрались сюда, то устроят нам ловушку именно здесь."

#. ja: 間もなくだが、気を抜くな
#. de: Kann sich nur noch um Sekunden handeln! Seid auf der Hut!
#. fr: Petite Ala Mhigo est proche, mais pas suf<shy>fi<shy>sam<shy>ment. On se remue !
msgctxt "NpcYell:128:0:13"
msgid "Little Ala Mhigo is close, but not close enough. Look alive, friend!"
msgstr "Малая Ала Миго уже близко, но расслабляться рано. Будь начеку, друг!"

#. ja: くっ、やはり来たか！
#. de: Da sind sie!
#. fr: On nous a repérés !
msgctxt "NpcYell:129:0:13"
msgid "We're discovered!"
msgstr "Нас раскрыли!"

#. ja: なんだ、オマエら！<br>侵入者かッ！？
#. de: Eindringlinge? Was habt ihr hier zu suchen?
#. fr: Comment as-tu trouvé cet endroit<nbsp>?
msgctxt "NpcYell:130:0:13"
msgid "How did ye find this place!?"
msgstr "Как вы нашли это место?!"

#. ja: オレの番犬をよくもッ！
#. de: Meine Männer! Das werdet ihr büßen!
#. fr: Comment oses-tu<nbsp>! Mes hommes de main<nbsp>!
msgctxt "NpcYell:131:0:13"
msgid "Me loyal pups!"
msgstr "Мои верные псы!"

#. ja: 遂にこのオレを<br>怒らせちまったようだな！
#. de: Wehe euch! Jetzt habt ihr mich wütend gemacht.
#. fr: Viens, que j'te tranche la gorge<nbsp>!
msgctxt "NpcYell:132:0:13"
msgid "Come closer. I'll slit yer throat and toss yer corpse to the mad serpent."
msgstr "Ну всё, вы меня разозлили! Подходи ближе — перережу глотку и скормлю твой труп бешеному змею."

#. ja: オ、オレの本気は<br>こんなモンじゃねぇぞッ！
#. de: I-Ich halte mich lediglich etwas zurück, nett wie ich bin.
#. fr: En temps normal, j'suis plus fort que ça<nbsp>!
msgctxt "NpcYell:133:0:13"
msgid "Wh-Where are me men!? Wh-Where are me maidens!?"
msgstr "Г-где мои люди?! Г-где мои девицы?!"

#. ja: おっと、大事な用を<br>思い出しちまったぜッ！
#. de: Da fällt mir ein! Ich hatte ja einen Termin!
#. fr: J'viens de me rappeler que j'avais un rendez-vous<nbsp>!
msgctxt "NpcYell:134:0:13"
msgid "Try an' catch me, ye two-legged lubber!"
msgstr "Вот незадача! Я ведь совсем забыл о важной встрече!"

#. ja: チッ、しつこい奴らだぜ！
#. de: Lästig wie Kletten ...
#. fr: T'en veux encore ? J'avais affûté ma lame pour l'occasion.
msgctxt "NpcYell:135:0:13"
msgid "Back fer more, eh? I sharpened me blade, just fer this very occasion."
msgstr "Опять за мной? А я-то как раз наточил клинок для такого случая."

#. ja: 犬共、出てこいやッ！
#. de: Fütterungszeit, meine Hündchen!
#. fr: Dévorez-les vivants !
msgctxt "NpcYell:136:0:13"
msgid "Eat 'em alive!"
msgstr "Сожрите их живьём!"

#. ja: イタ、イタタタ……<br>ちょっと洒落にならんぞ！
#. de: A-Aua! Langsam ist das nicht mehr lustig!
#. fr: Et... et si on négociait un coup<nbsp>?
msgctxt "NpcYell:137:0:13"
msgid "M-M-Might ye consider a parley?"
msgstr "М-может, договоримся?"

#. ja: あ～、マズい……<br>ボスに何て報告しよ……
#. de: Wie soll ich das bloß erklären? Ich bin geliefert!
#. fr: Ouh, l'patron va pas aimer ça du tout...
msgctxt "NpcYell:138:0:13"
msgid "The boss ain't goin' to like this one bit..."
msgstr "Боссу это совсем не понравится..."

#. ja: これでも喰らいやがれぇ！
#. de: Nimm dies!
#. fr: Personne ne passe<nbsp>!
msgctxt "NpcYell:139:0:13"
msgid "0"
msgstr "0"

#. ja: 殺っちまえ！
#. de: Aus dir mach ich Fischfutter!
#. fr: À mort !
msgctxt "NpcYell:140:0:13"
msgid "Die!"
msgstr "Умри!"

#. ja: おんどりゃぁ！
#. de: Sprich dein letztes Gebet!
#. fr: Prenez les femmes vivantes !
msgctxt "NpcYell:141:0:13"
msgid "Take the women alive!"
msgstr "Женщин брать живыми!"

#. ja: ナメんじゃねぇぞ！
#. de: Nicht mit mir, Freundchen!
#. fr: Tu vas rejoindre les abysses !
msgctxt "NpcYell:142:0:13"
msgid "To the abyss with ye!"
msgstr "Отправляйся на дно!"

#. ja: シュコォ、シュコォ……<br>みんな タスケル タスケル
#. de: Psssh, pssskoh ... Netter Goblin helfen!
#. fr: Pshhh... Gentils aventuriers ! Les Gobelins ont besoin d'aide, vite !
msgctxt "NpcYell:143:0:13"
msgid "Kindly uplander! Gobbieflock needs quick hand-lending!"
msgstr "Пшшш... Добрые верхолазы! Гоблинскому племени нужна скорая помощь!"

#. ja: ……シュコォ、シュコォ、<br>もうダメ もうダメ……
#. de: Psh ... Goblinleben vielzzu kurz.
#. fr: Douleur tout autour... du sang et de la bile !
msgctxt "NpcYell:144:0:13"
msgid "Pshkohhh... Overmany deepsores... Blood and bile! Blood and bile!"
msgstr "Пшш... Слишком много глубоких ран... Кровь и желчь! Кровь и желчь!"

#. ja: オタスケ オタスケ！
#. de: Helfenhand! Bitte Helfenhand!
#. fr: À l'aide ! À l'aide !
msgctxt "NpcYell:145:0:13"
msgid "Hand-lending! Hand-lending!"
msgstr "Помогать! Помогать!"

#. ja: もうダメ もうダメ……
#. de: Endenah, Endenah ...
#. fr: Les aventuriers doivent aider le Gobelin<nbsp>!
msgctxt "NpcYell:146:0:13"
msgid "Pshkohhh... Much soreness..."
msgstr "Пшш... Слишком больно..."

#. ja: シュコォ、シュコォ……<br>たすかた～　たすかた～！
#. de: Psssh, Vielendank für Gutetat!
#. fr: Pshhh... Les aventuriers ont sauvé le Gobelin avec courage<nbsp>!
msgctxt "NpcYell:147:0:13"
msgid "Uplander saves gobbieflock! Huzzah! Zah hah!"
msgstr "Верхолаз спас гоблинское племя! Ура! За-ха-ха!"

#. ja: シュコォ、シュコォ……<br>ありがと～　ありがと～！
#. de: Shkohhh, Gobbie schuldet Dank für Immerzeit!
#. fr: Merci infiniment ! Merci infiniment !
msgctxt "NpcYell:148:0:13"
msgid "Many thanks! Many thanks!"
msgstr "Спасибо! Спасибо!"

#. ja: もってけ～ もってけ～！<br>お礼～ もってけ～！
#. de: Großwachsene<if $gn4><else>r</if> nehmen Dankzeichen!
#. fr: Gentils aventuriers, ils acceptent les cadeaux du Gobelin !
msgctxt "NpcYell:149:0:13"
msgid "Kindly uplander now taking gobbie jinglyshine!"
msgstr "Добрый верхолаз, бери блестяшки от гоблина!"

#. ja: シュコォ、シュコォ……<br>オマエら 突撃ゴブ！
#. de: Psssh! Echsen wird Blauewunder erleben!
#. fr: Plus vite ! Plus vite vite !
msgctxt "NpcYell:150:0:13"
msgid "Shkoh! Shkoh! More fastness! More fastness!"
msgstr "Пшш! Пошевеливайся! Быстрее, быстрее!"

#. ja: シュコォ、シュコォ……<br>ここは 任せろゴブ！
#. de: Shkoh, Großwachsene kann Vertrauen haben in Brüllvolx.
#. fr: Pshhh... Brayflox s'occupe de faire boum boum !
msgctxt "NpcYell:151:0:13"
msgid "Shkoh! Brayflox shall see to thunderfoot!"
msgstr "Пшш! Брейфлокс разберётся с громоногами!"

#. ja: シュコォ、シュコォ……<br>オマエら 攻撃ゴブ！
#. de: Pshh ... Siehzzu? Gobbie ist Starkekrieger.
#. fr: Pshhh... Les Gobelins sont de grands guerriers !
msgctxt "NpcYell:152:0:13"
msgid "Shkoh! Shkoh! More backstrike! More forestrike!"
msgstr "Пшш! Бей сильнее! Сзади и спереди!"

#. ja: シュコォ、シュコォ……<br>窮地を 脱したゴブ！
#. de: Psh! Knapp vorbei wie Scharfehaar.
#. fr: Ouf<nbsp>! Brayflox va beaucoup mieux !
msgctxt "NpcYell:153:0:13"
msgid "Psheew... Brayflox backwalks from foregate of deathpit!"
msgstr "Пшш... Брейфлокс вырвалась из преддверия смерти!"

#. ja: シュコォ、シュコォ……<br>当然の 勝負ゴブ！
#. de: Khooo! Großesieg für Rechtigkeit!
#. fr: Les poings de Brayflox sont surpuissants !
msgctxt "NpcYell:154:0:13"
msgid "Shkoh! Shkoh! Gobfists of Brayflox are having no match!"
msgstr "Пшш! Кулаки Брейфлокс непобедимы!"

#. ja: シュコォ、シュコォ……<br>喰らえ 超爆弾ゴブ！
#. de: Nimmzu das, bevor frechsprechen!
#. fr: Boum boum<nbsp>! Brayflox va envoyer une grosse bombe<nbsp>!
msgctxt "NpcYell:155:0:13"
msgid "Shkoh! Shkoh! Fireboom! Overboom!"
msgstr "Пшш! Огнебум! Мегабум!"

#. ja: ゴブッ！？
#. de: Psh?!
#. fr: Pourquoi pas boum<nbsp>!?
msgctxt "NpcYell:156:0:13"
msgid "Gobbie...boom?"
msgstr "Гоблин... бум?"

#. ja: シュコォ、シュコォ……<br>ここは 任せたゴブ！
#. de: Der ist für Großwachsene<if $gn4><else>n</if>!
#. fr: Hop-là ! Brayflox a un cadeau pour les gentils aventuriers !
msgctxt "NpcYell:157:0:13"
msgid "Shkoh! Shkoh! Present for kindly uplander!"
msgstr "Пшш! Подарок доброму верхолазу!"

#. ja: シュコォ、シュコォ……<br>余裕の……勝利ゴブ……
#. de: Pshkho ... Leichtespiel für Brüllvolx!
#. fr: La victoire pour Brayflox !
msgctxt "NpcYell:158:0:13"
msgid "Shkoh! Shkoh! Victory for Brayflox! Longstop is not overturning!"
msgstr "Пшш! Победа Брейфлокс! Долгостоп не устоял!"

#. ja: シュコォ、シュコォ……<br>タスケに 来たゴブ！
#. de: Pssshhh! Verstärkung kommt!
#. fr: Pshhh... Brayflox est là pour aider les gentils aventuriers !
msgctxt "NpcYell:159:0:13"
msgid "Brayflox is come to give goodly uplander gobbie hand-lending!"
msgstr "Пшш! Брейфлокс пришла помочь добрым верхолазам!"

#. ja: ゴブの姿に<br>畏れをなしたゴブ？
#. de: Hazzu Herzfallen in Hose? Kommt gleich noch mehr.
#. fr: Pshhh... Le méchant dragon a compris que les Gobelins sont plus forts !
msgctxt "NpcYell:160:0:13"
msgid "There! Thunderclaw is blood and bile!"
msgstr "Вот! Громокоготь — кровь и желчь!"

#. ja: シュコォ、シュコォ……<br>また伝説が 増えたゴブ！
#. de: Psssh! Neue Legende entstehen!
#. fr: Pshhh... Brayflox est l'héroïne d'une nouvelle légende !
msgctxt "NpcYell:161:0:13"
msgid "Othermore deednotch added to gobbiebelt!"
msgstr "Пшш! В пояс гоблина добавилась ещё одна зарубка!"

#. ja: ブレイフロクス さす～が！
#. de: Brüllvolx ist Bestekämpfer!
#. fr: Ô grande Brayflox !
msgctxt "NpcYell:162:0:13"
msgid "Oh, goodly Brayflox!"
msgstr "О, славная Брейфлокс!"

#. ja: ブレイフロクス つよ～い！
#. de: Brüllvolx ist Starkegoblin!
#. fr: Ô puissante Brayflox !
msgctxt "NpcYell:163:0:13"
msgid "Oh, mighty Brayflox!"
msgstr "О, могучая Брейфлокс!"

#. ja: シュコォ、シュコォ……<br>それほど でもないゴブ！
#. de: Nettworte freuen Brüllvolx, aber nichts Besonderes getan.
#. fr: Pshhh... Brayflox est flattée... mais Brayflox n'a rien fait...
msgctxt "NpcYell:164:0:13"
msgid "Yes, yes! More tongueflaps! More tongueflaps!"
msgstr "Да-да! Ещё похвал! Ещё!"

#. ja: ジャッカルが出たぞ～！
#. de: Die Schakale sind los!<br>Rette sich, wer kann!
#. fr: À l'aide ! Je vous en supplie ! Des chacals sont à mes trousses !
msgctxt "NpcYell:165:0:13"
msgid "Help! Someone! I'm being chased by jackals!"
msgstr "На меня напали шакалы! На помощь! Кто-нибудь!"

#. ja: 来るな、来ないで～！！
#. de: Bleibt mir vom Leib!
#. fr: Arrière !
msgctxt "NpcYell:166:0:13"
msgid "Get away!"
msgstr "Отойди!"

#. ja: ひぃぃ俺は美味くないぞ～
#. de: Ich bin total zäh, ehrlich!
#. fr: Je vous jure, j'ai très mauvais goût<nbsp>!
msgctxt "NpcYell:167:0:13"
msgid "I was only joking!"
msgstr "Я всего-то пошутил!"

#. ja: 助けてくれ～！！
#. de: Hilfe!
#. fr: C'était une blague ! Je ne voulais faire de mal à personne !
msgctxt "NpcYell:168:0:13"
msgid "Please! I didn't mean any harm!"
msgstr "Пожалуйста! Я не хотел никому навредить!"

#. ja: ふぅ、助かった……
#. de: Puh, das war knapp ...
#. fr: Je suis... en vie ! Bénis soient les Douze !
msgctxt "NpcYell:169:0:13"
msgid "I'm...still alive...? Thank the Twelve!"
msgstr "Я... всё ещё жив? Слава Двенадцати!"

#. ja: んん、なんだ、なんだ……？
#. de: Hm? Was geht hier vor?
#. fr: Par les Douze, quelle est cette chose !?
msgctxt "NpcYell:170:0:13"
msgid "What in the seven hells is that thing!?"
msgstr "Что это, к семи преисподним, такое?!"

#. ja: うぎゃ～プギルだらけだ～！！
#. de: P-Pugil!<br>Ein ganzer Schwarm!
#. fr: C'est bourré de pugils<nbsp>! Seul un fou viendrait pêcher ici !
msgctxt "NpcYell:171:0:13"
msgid "No man in his right mind would fish here!"
msgstr "Тут кишмя кишат пугили! Только сумасшедший станет здесь рыбачить!"

#. ja: むむ、叫び声がするぞっ！？
#. de: Da ruft jemand um Hilfe!
#. fr: Vous entendez ?
msgctxt "NpcYell:172:0:13"
msgid "You hear that?"
msgstr "Слышите?"

#. ja: くっ、いったん退くぞ
#. de: In Ordnung!<br>Wir ziehen uns zurück!
#. fr: Il me faut à boire...
msgctxt "NpcYell:173:0:13"
msgid "I need a drink..."
msgstr "Мне бы выпить..."

#. ja: 黒渦団の意地にかけてっ！
#. de: Für den Mahlstrom!
#. fr: Pour l'Amirale !
msgctxt "NpcYell:174:0:13"
msgid "For the Admiral!"
msgstr "За адмирала!"

#. ja: これぐらい貴様らで対処せよ！
#. de: Damit solltet ihr auch alleine fertig werden!
#. fr: Secouez-vous, soldats !
msgctxt "NpcYell:175:0:13"
msgid "Look alive, privates!"
msgstr "Сами с этим справитесь!"

#. ja: ええぃ情けない！
#. de: Ist das zu fassen?!
#. fr: Ce ne sont que des chacals, bon sang !
msgctxt "NpcYell:176:0:13"
msgid "They're only bloody jackals!"
msgstr "Ну и позорище!"

#. ja: 我こそはという者は加勢せよ！
#. de: Wir können jede Hilfe gebrauchen!
#. fr: Je dois vraiment tout faire moi-même, ici...
msgctxt "NpcYell:177:0:13"
msgid "Must I do everything!?"
msgstr "Мне всё самому делать?!"

#. ja: どうした押されているぞ！？
#. de: Lasst euch nicht übermannen, ihr Waschlappen!
#. fr: Tu n'en as pas eu assez !?
msgctxt "NpcYell:178:0:13"
msgid "You haven't had enough, have you!?"
msgstr "Неужели вам мало?!"

#. ja: 黒渦団の力を見せてみろ！
#. de: Du bist eine Schande für den Mahlstrom! Streng dich gefälligst an!
#. fr: Serre les dents ! T'es un soldat, maintenant !
msgctxt "NpcYell:179:0:13"
msgid "Suck it up, lad! You're a storm soldier now!"
msgstr "Терпи, парень! Теперь ты солдат Водоворота!"

#. ja: むむっ異様な殺気を感じる！
#. de: Ich spüre ... nacktes Grauen!
#. fr: Quelque chose ne tourne pas rond... je le sens...
msgctxt "NpcYell:180:0:13"
msgid "Something's wrong... I can feel it..."
msgstr "Что-то не так... Чую неладное..."

#. ja: 黒渦団の力を見たか！？
#. de: Ich zeig dir, was 'ne Harke ist.
#. fr: Une autre victoire pour l'Amirale !
msgctxt "NpcYell:181:0:13"
msgid "Another victory for the Admiral!"
msgstr "Ещё одна победа для адмирала!"

#. ja: 無念、鍛えなおさねば……
#. de: Mit dieser Schande werden wir leben müssen ...
#. fr: Une honte ! Tous autant que vous êtes !
msgctxt "NpcYell:182:0:13"
msgid "A disgrace! Each and every one of you!"
msgstr "Позор! Всем вам!"

#. ja: さぁて、見回り、見回りっと
#. de: Zeit für die nächtliche Patrouille!
#. fr: J'imagine qu'il est temps de faire ma ronde.
msgctxt "NpcYell:183:0:13"
msgid "I suppose it's time I be makin' the rounds."
msgstr "Пожалуй, пора обходить дозором."

#. ja: ん……なんだ、この羽音は？
#. de: Was ... ist das? Klingt wie tausend schlagende Flügel?
#. fr: J'ai un mauvais pres<shy>sen<shy>ti<shy>ment.
msgctxt "NpcYell:184:0:13"
msgid "I have a bad feelin' 'bout this."
msgstr "Что-то мне не по себе..."

#. ja: ケ、ケーブバットだぁっ！？
#. de: H-Höhlenfledermäuse? Wo kommen die her?
#. fr: Bon sang ! Pas encore !?
msgctxt "NpcYell:185:0:13"
msgid "Bloody hells! Not again!"
msgstr "Проклятье! Опять?!"

#. ja: ……疲れた、早く帰ろう……
#. de: Ich bin fix und alle. Jetzt erst mal 'n heißes Bad!
#. fr: Si je vois une autre chauve-souris cavernicole, je vais craquer.
msgctxt "NpcYell:186:0:13"
msgid "If I never see another cave bat, it'll be too soon."
msgstr "Если я больше никогда не увижу пещерную летучую мышь, всё равно будет слишком рано."

#. ja: ああっ、農場に行くなぁっ！
#. de: Verdammt, sie fliegen zu den Höfen!
#. fr: T'approche pas de mon stock, espèce de rat volant !
msgctxt "NpcYell:187:0:13"
msgid "You stay the hells away from my stock, you filthy flyin' rat!"
msgstr "Только попробуй сунуться к моим запасам, мерзкая летающая крыса!"

#. ja: う、うちのドードーが……！
#. de: Meine Dodos!
#. fr: Mes dodos ! Sauvez mes pauvres dodos !
msgctxt "NpcYell:188:0:13"
msgid "Me dodos! Someone save me poor dodos!"
msgstr "Мои додо! Кто-нибудь, спасите бедных птичек!"

#. ja: こいつら、やっつけないと！
#. de: Stutzt ihnen die Flügel!<br>Koste es, was es wolle!
#. fr: Il faut arrêter ces chauves-souris<nbsp>! Leur morsure rend fou !
msgctxt "NpcYell:189:0:13"
msgid "We cannot let these bats out to feed. Their bite'll drive both man and beast to madness!"
msgstr "Нельзя дать этим мышам вылететь на кормёжку. Их укус сводит с ума и людей, и зверей!"

#. ja: ま、待ち合わせに遅れるっ！
#. de: Mist, ich komme zu spät!
#. fr: Aujourd'hui, c'est le grand jour ! La fille du meunier sera enfin mienne !
msgctxt "NpcYell:190:0:13"
msgid "Today is the day! The miller's daughter will finally be mine!"
msgstr "Сегодня мой день! Дочь мельника наконец станет моей!"

#. ja: ……遅いわね
#. de: Wo bleibt er denn nur ...?
#. fr: Il en met du temps...
msgctxt "NpcYell:191:0:13"
msgid "Oh, wherever could he be?"
msgstr "Ну и где же он?"

#. ja: ハァッ、ハァッ……！
#. de: \<prust> ... \<schnauf> ...
#. fr: Nombreux sont ceux qui ont voulu cueillir cette douce fleur, mais elle ne se laisse pas séduire si facilement.
msgctxt "NpcYell:192:0:13"
msgid "Many have visited the maiden's garden, yet her flower remains unplucked."
msgstr "Многие бывали в саду этой девицы, да цветок её всё ещё не сорван."

#. ja: 今日こそプロポーズするんだ！
#. de: Heute werde ich um ihre Hand anhalten! Ganz bestimmt!
#. fr: Mais aujourd'hui, je la demande en mariage<nbsp>! Et un jour elle sera mienne, oh oui, elle sera mienne<nbsp>!
msgctxt "NpcYell:193:0:13"
msgid "Today, that changes!"
msgstr "Сегодня всё изменится!"

#. ja: お、遅くなってごめん！
#. de: Entschuldige die Verspätung!
#. fr: Ah, Madame. Me pardonnerez-vous mon retard ?
msgctxt "NpcYell:194:0:13"
msgid "Ah, milady. Will you forgive me for my tardiness?"
msgstr "Ах, сударыня. Простите, что задержался."

#. ja: おっそーい！　遅刻よ？
#. de: Was fällt dir ein, mich so warten zu lassen?
#. fr: J'avais si peur ici, toute seule... Vous en avez mis du temps<nbsp>!
msgctxt "NpcYell:195:0:13"
msgid "Out here, all alone... I was so frightened! "
msgstr "Я тут совсем одна... Мне было так страшно!"

#. ja: もう、こんなトコで何の話よ？
#. de: Und überhaupt: Worüber willst du denn hier mit mir reden?
#. fr: Pourquoi désiriez-vous que nous nous retrouvions aussi loin de la ville ?
msgctxt "NpcYell:196:0:13"
msgid "Why did you wish to see me so far from town?"
msgstr "Зачем вы позвали меня так далеко от города?"

#. ja: じ、実は……
#. de: Ich ... Also ...
#. fr: Ah, oui, je vais vous expliquer, mon amour...
msgctxt "NpcYell:197:0:13"
msgid "Ah yes, let me explain, my love..."
msgstr "Ах да, позволь мне всё объяснить, любовь моя..."

#. ja: はい？
#. de: Ja?
#. fr: Oui<nbsp>?
msgctxt "NpcYell:198:0:13"
msgid "Your love?"
msgstr "Любовь ваша?"

#. ja: ぼ、ぼぼぼ僕とけけけ……！
#. de: W-W-Willst du mich hei...!
#. fr: Vous si belle<nbsp>! Est-ce que vous voudriez bien m'é-m'é-m'é... Ah<nbsp>!
msgctxt "NpcYell:199:0:13"
msgid "Your eyes are like sapphires, your lips, rubies. And your breasts... Those br─"
msgstr "У вас глаза — сапфиры, губы — рубины. А грудь... А-а..."

#. ja: きゃあっ、風がっ！？
#. de: Was ist das auf einmal so windig?
#. fr: Qu'est-ce que c'est que ça !?
msgctxt "NpcYell:200:0:13"
msgid "What was that!?"
msgstr "Что это было?!"

#. ja: な、なによあのでっかいの！？
#. de: U-Und was will dieses Monster hier?
#. fr: Un m-m-monstre ! À l'aide !
msgctxt "NpcYell:201:0:13"
msgid "A-A-A monster! Save me!"
msgstr "Ч-ч-чудовище! Спасите!"

#. ja: おわ～っ！？
#. de: M-Monster?!
#. fr: Vous aider<nbsp>!? M-m-mais je ne<nbsp>!
msgctxt "NpcYell:202:0:13"
msgid "Save you!? Who's going to save me!?"
msgstr "Спасти тебя?! Да кто меня спасёт?!"

#. ja: ああもう、頼りにならない！
#. de: Steh hier nicht mit offenem Mund rum!
#. fr: Faites quelque chose ! N'importe quoi !
msgctxt "NpcYell:203:0:13"
msgid "Do something! Anything!"
msgstr "Сделай же что-нибудь! Хоть что-нибудь!"

#. ja: アレ、なんとかしてよっ！
#. de: Rette mich vor diesem Ungetüm!
#. fr: C'est de votre faute si nous sommes ici, après tout !
msgctxt "NpcYell:204:0:13"
msgid "It's your fault we're out here in the first place!"
msgstr "Это всё из-за тебя мы сюда забрались!"

#. ja: ……私、帰る
#. de: Mir reicht's! Ich geh nach Hause!
#. fr: Je rentre chez moi.
msgctxt "NpcYell:205:0:13"
msgid "I'm going home."
msgstr "Я ухожу домой."

#. ja: ま、待ってよっ！
#. de: S-So warte doch!
#. fr: A-attendez !
msgctxt "NpcYell:206:0:13"
msgid "W-Wait!"
msgstr "П-постой!"

#. ja: 意気地なしなんだからっ！
#. de: Du bist eine elende Memme!
#. fr: Pas la peine de me recontacter, espèce de pleutre !
msgctxt "NpcYell:207:0:13"
msgid "Don't ever call on me again, coward!"
msgstr "И не смей больше ко мне обращаться, трус!"

#. ja: そ、そう言われても……
#. de: A-Aber ich wollte dir<br>doch ...!
#. fr: M-mais, je n'ai même pas eu le temps de vous...
msgctxt "NpcYell:208:0:13"
msgid "B-But I never got the chance to tell you about your br─"
msgstr "Н-но я же не успел рассказать тебе про твою…"

#. ja: もう、知らないっ！
#. de: Erspare mir deine Ausflüchte!
#. fr: Peuh<nbsp>!
msgctxt "NpcYell:209:0:13"
msgid "Hmph!"
msgstr "Хмф!"

#. ja: な、なんでこんなことに……
#. de: Das ... Das ist einfach nicht fair!
#. fr: Elle a peut-être une sœur...
msgctxt "NpcYell:210:0:13"
msgid "\\<sigh> I wonder if she has a sister..."
msgstr "\\<вздыхает> Интересно, у неё есть сестра?.."

#. ja: ん、なんだ？
#. de: Hm? Irgendwas stimmt hier nicht?
#. fr: Vous avez entendu ?
msgctxt "NpcYell:211:0:13"
msgid "Did you hear that?"
msgstr "Слышал?"

#. ja: ヒャッハー！　獲物がいたぜ！
#. de: Harhar! Frische Beute, Jungs!
#. fr: Hahaha ! Et voilà, c'est à moi !
msgctxt "NpcYell:212:0:13"
msgid "Hah hah! Right into me hands!"
msgstr "Ха-ха! Прямо в лапы мне попались!"

#. ja: ひいいっ、お助けぇ～！
#. de: Jetzt unternimm doch was!
#. fr: Des flibustiers ! Ne les laissez pas s'approcher !
msgctxt "NpcYell:213:0:13"
msgid "Freebooters! Keep them away!"
msgstr "Пираты! Не подпускайте их!"

#. ja: くそっ、言わんこっちゃない！
#. de: Das sagst du so!
#. fr: Je fais quoi, à votre avis, là ?
msgctxt "NpcYell:214:0:13"
msgid "What does it look like I'm doing?"
msgstr "И что, по-твоему, я делаю?"

#. ja: お前ら、やっちまいなー！！
#. de: Rückt eure Gil raus!
#. fr: Attrapez-les ! Tout ce que vous tuerez sera à vous !
msgctxt "NpcYell:215:0:13"
msgid "Have at 'em lads! Ye keep what ye kill!"
msgstr "За работу, ребята! Кого завалите — того и забирайте!"

#. ja: あーあ、まだ暴れてるよ……
#. de: Der wütet ja immer noch rum ...
#. fr: Ça recommence !
msgctxt "NpcYell:216:0:13"
msgid "The damned gobdaw's at it again!"
msgstr "Опять этот проклятый дуралей буянит!"

#. ja: こいつ、大人しくしろっ！
#. de: Du da, gib endlich Ruhe!
#. fr: Calmez-vous avant que je vous fasse taire !
msgctxt "NpcYell:217:0:13"
msgid "Quiet down before I shut you up myself!"
msgstr "А ну заткнись, пока я сам тебя не заткнул!"

#. ja: 暴れるなって言ってるだろ！
#. de: Du sollst Ruhe geben, hab ich gesagt!
#. fr: Je vous demande de vous arrêter !
msgctxt "NpcYell:218:0:13"
msgid "I told you to stop!"
msgstr "Я же велел прекратить!"

#. ja: いい加減にしろ、この野郎！
#. de: Sag mal, hast du Bohnen in den Ohren?!
#. fr: Je vais te montrer ce qu'on fait des clandestins, par ici.
msgctxt "NpcYell:219:0:13"
msgid "I'll show you what we here at the Quay think of stowaways."
msgstr "Сейчас узнаешь, как у нас на причале обходятся с зайцами!"

#. ja: うるせぇよ、そこをどけ！
#. de: Lasst mich in Ruhe! Ausm Weg da!
#. fr: Allez, bouge de là<nbsp>!
msgctxt "NpcYell:220:0:13"
msgid "Step aside, honeybee. I's no quarrel wiv yer ilk."
msgstr "Прочь с дороги, пчёлка. Мне до таких, как ты, дела нет."

#. ja: 証拠でもあんのかよっ！？
#. de: Habt ihr etwa Beweise?
#. fr: J'ai payé la traversée, promis. Vous avez une preuve du contraire<nbsp>?
msgctxt "NpcYell:221:0:13"
msgid "I paid fer me passage, proper. The damn captain's fillin' yer ears with gobshite."
msgstr "Я за переправу заплатил, как положено. Капитан заливает вам всякую чушь!"

#. ja: 知らねぇって言ってんだろ！
#. de: Ich hab die Überfahrt anstandsgemäß bezahlt!
#. fr: J'suis pas un clandestin !
msgctxt "NpcYell:222:0:13"
msgid "I ain't no stowaway!"
msgstr "Я не безбилетник, говорю же!"

#. ja: いい加減にしろ、バカ野郎が！
#. de: Das werden wir sehen. Du kommst mit uns, Freundchen!
#. fr: Tu l'auras cherché !
msgctxt "NpcYell:223:0:13"
msgid "You're askin' for it!"
msgstr "Сам напросился!"

#. ja: 先輩、お願いします！
#. de: Ich könnte hier etwas Hilfe gebrauchen, Sir!
#. fr: J'ai besoin d'un coup de main.
msgctxt "NpcYell:224:0:13"
msgid "I could use a little help over here, sir!"
msgstr "Сэр, мне бы тут помощь не помешала!"

#. ja: なんだぁ、やる気かぁ！？
#. de: Willst 'ne Abreibung? Kannste haben!
#. fr: Alors, on cherche la bagarre ?
msgctxt "NpcYell:225:0:13"
msgid "So it's a fight ye all want, eh?"
msgstr "Ну что, драки захотели, а?"

#. ja: やっと大人しくなったか……
#. de: Na endlich ...
#. fr: On est calmé ?
msgctxt "NpcYell:226:0:13"
msgid "That quiet you down, did it?"
msgstr "Ну что, угомонился?"

#. ja: こ、この野郎っ……！
#. de: Elende Schweinerei!
#. fr: Que le puissant serpent vous emporte dans les abysses !
msgctxt "NpcYell:227:0:13"
msgid "May the mighty serpent drag yer arses all the way down to the abyss!"
msgstr "Пусть могучий змей утянет ваши задницы на самое дно Бездны!"

#. ja: さ、ゆっくり話をしようや？
#. de: So, jetzt unterhalten wir uns mal ganz in Ruhe.
#. fr: Alors, on est prêt à parler ?
msgctxt "NpcYell:228:0:13"
msgid "So, are you finally ready to talk?"
msgstr "Ну что, наконец готов говорить?"

#. ja: くそったれがっ！
#. de: Könnte dir so passen, du dreckiges Schwein!
#. fr: J'ai rien à dire aux personnes de votre espèce.
msgctxt "NpcYell:229:0:13"
msgid "I's less 'an naught to say to you and yers."
msgstr "Мне и слова тратить жалко на тебя и твоих дружков."

#. ja: うるせえ、黙ってろッ！
#. de: Das werden wir ja sehen!
#. fr: Alors, au trou ! Saisissez les fers !
msgctxt "NpcYell:230:0:13"
msgid "Then to the brig it is. Grab the shackles, men."
msgstr "Тогда в карцер. За кандалами, ребята!"

#. ja: ちきしょう、ちきしょうっ！
#. de: Elende Gelbjacken! Ich mach euch alle kalt!
#. fr: Tout mais pas ça ! J'vous dirai tout ce que vous voulez savoir !
msgctxt "NpcYell:231:0:13"
msgid "No... Not there again. Anywhere but there! Please! I'll tell you all you want to know! Honest!"
msgstr "Нет… Только не туда опять! Куда угодно, только не туда! Пожалуйста! Я всё расскажу, что хотите! Честно!"

#. ja: なんてこった……！
#. de: Verdammt ...
#. fr: Malédiction<nbsp>!
msgctxt "NpcYell:232:0:13"
msgid "Godsdammit to the seventh hell and back!"
msgstr "Да чтоб тебя седьмой круг ада и обратно!"

#. ja: へへ、捕まってたまるかよ！
#. de: Wenn ihr mich fangen wollt, müsst ihr schon 'n bisschen mehr Müsli zum Frühstück essen.
#. fr: Ciao, les abeilles !
msgctxt "NpcYell:233:0:13"
msgid "Sod off, honeybees!"
msgstr "Проваливайте, пчёлки!"

#. ja: 逃げられたか……！
#. de: Weg ist er ...
#. fr: On se retrouvera, sale voleur<nbsp>!
msgctxt "NpcYell:234:0:13"
msgid "We'll find you, bastard!"
msgstr "Мы тебя найдём, ублюдок!"

#. ja: あ～ばよ～うっ！
#. de: Man sieht sich, Pfeifen!
#. fr: C'est pas pour rien qu'on m'appelle Ahctstymm le clandestin !
msgctxt "NpcYell:235:0:13"
msgid "No man can rule Ahctstymm Shadowlurker!"
msgstr "Никому не одолеть Ахтстима Теневого лазутчика!"

#. ja: テメェ、オレの酒を<br>飲みやがったな！
#. de: Gib's zu, du hast mir meinen Grog weggesoffen!
#. fr: T'as osé boire mon ale<nbsp>!?
msgctxt "NpcYell:236:0:13"
msgid "Get them gropers off me grog!"
msgstr "Снимите с меня этих лапающих руки! Это ж мой эль!"

#. ja: なんだ、やんのか！？
#. de: Kannst das gern mit meinen Fäusten ausdiskutieren!
#. fr: Dégage ! J'bois c'que j'veux.
msgctxt "NpcYell:237:0:13"
msgid "Sod off! I drink what I want."
msgstr "Отвали! Пью, что хочу."

#. ja: ざけんなよ、コラ！
#. de: Das wirst du bereuen, du ...!
#. fr: J'vais t'refaire une bouche, qu'tu boives toute l'ale que tu voudras !
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:238:0:13"
msgid "<i>I'll</i> cut ye a new gob so's that ye can drink all grog ye like!"
msgstr "<i>Я</i> тебе новую пасть вырежу, будешь хоть весь эль выпивать!"

#. ja: 吠え面かくなよ？
#. de: Komm doch, wenn du dich traust!
#. fr: J'vais t'refaire le portrait !
msgctxt "NpcYell:239:0:13"
msgid "Not afore I cut ye a new piss'ole!"
msgstr "Не раньше, чем я тебе задницу надеру!"

#. ja: ナメんじゃねぇぞ、コラァ！
#. de: Selber Seegurke, du ...!
#. fr: Pas touche, les abeilles !
msgctxt "NpcYell:240:0:13"
msgid "Get yer hands off me, honeybees!"
msgstr "Руки убрали, пчёлки!"

#. ja: ペイストの群れだ、食い止めろ！
#. de: Eine Peiste-Herde! Wir müssen sie aufhalten!
#. fr: Tuez-les jusqu'au dernier<nbsp>!
msgctxt "NpcYell:241:0:13"
msgid "Kill every last one of them!"
msgstr "Убейте их всех до единого!"

#. ja: ぎゃー！　オロボンがー！？
#. de: Orobon? Wo kommen die her?
#. fr: Maudit orobon !
msgctxt "NpcYell:242:0:13"
msgid "Cursed orobon!"
msgstr "Будь проклят оробон!"

#. ja: 前方にコブラン発見、排除せよ
#. de: Kobalosse voraus, streckt sie nieder!
#. fr: Coblyns droit devant !
msgctxt "NpcYell:243:0:13"
msgid "Coblyns sighted ahead!"
msgstr "Коблины впереди!"

#. ja: 人食いアリを進ませるなぁッ！
#. de: Lasst diese Ungetüme nicht durch!
#. fr: Ne laissez pas ces fourmis dévorer un autre enfant !
msgctxt "NpcYell:244:0:13"
msgid "Don't let those ants take another child!"
msgstr "Не дайте этим муравьям утащить ещё одного ребёнка!"

#. ja: 総員、輸送ルートを確保せよ！
#. de: An alle, sichert die Route!
#. fr: Il faut acheminer le minerai !
msgctxt "NpcYell:245:0:13"
msgid "The ore must get through!"
msgstr "Руда должна пройти!"

#. ja: また大山羊か！　追っ払うぞ！
#. de: Schon wieder Steinböcke?! Verjagt sie!
#. fr: Ces maudits bouquetins détruisent le désert !
msgctxt "NpcYell:246:0:13"
msgid "Those accursed goats will see this desert reduced to a...well, a desert!"
msgstr "Эти проклятые козлы скоро от пустыни одно название оставят!"

#. ja: アマルジャの進軍！？　迎撃！
#. de: Ein Stoßtrupp der Amalj'aa! Auf sie mit Gebrüll!
#. fr: Les hommes-lézards marchent vers l'ouest ! Nous devons les intercepter !
msgctxt "NpcYell:247:0:13"
msgid "The lizards march west! We must intercept them!"
msgstr "Ящеры идут на запад! Надо их перехватить!"

#. ja: アマルジャだ、総員戦闘配備！
#. de: Amalj'aa! Macht euch kampfbereit!
#. fr: Des unités amalj'aa ! Tous à vos postes<nbsp>!
msgctxt "NpcYell:248:0:13"
msgid "Amalj'aa raiders! Men! To your positions!"
msgstr "Налётчики-амалджа! Бойцы, по местам!"

#. ja: インプめ、また悪戯か！
#. de: Elende Imps! Was führt ihr diesmal im Schilde!
#. fr: Ces maudits imps préparent un sale coup !
msgctxt "NpcYell:249:0:13"
msgid "Those bothersome imps are up to no good!"
msgstr "Опять эти надоедливые бесы что-то затеяли!"

#. ja: 怪しい動きだ、先手必勝っ！
#. de: Die haben irgendwas vor! Schaltet sie aus!
#. fr: Les Amalj'aa sont tout près ! Interceptez-les !
msgctxt "NpcYell:250:0:13"
msgid "The Amalj'aa approach! Meet them in field!"
msgstr "Амалджа приближаются! Встретим их в поле!"

#. ja: なっ、あれは黒衣森の……！？
#. de: Wo kommen die her? Aus dem Finsterwald?
#. fr: Que font ces créatures de Sombrelinceul ici !?
msgctxt "NpcYell:251:0:13"
msgid "What are landtraps doing in the desert!?"
msgstr "Что ловушки делают в пустыне?!"

#. ja: くっ、辺境警備はこれだから！
#. de: Verdammt, da hat mal wieder jemand geschlafen!
#. fr: J'avais dit à ces maudits Mhigois de recouvrir les trous qui leur servent de latrines !
msgctxt "NpcYell:252:0:13"
msgid "I told those damn Ala Mhigans to cover their piss!"
msgstr "Я же велел этим проклятым ала-миго покрывать свои нужники!"

#. ja: この浜、夜に出るらしいぜ……
#. de: Hier sollen sie<br>auftauchen ...<br>Immer nachts!
#. fr: On raconte que les morts se réveillent chaque nuit pour emporter les âmes des vivants.
msgctxt "NpcYell:253:0:13"
msgid "They say the dead rise from the abyss each night to claim the souls of the living."
msgstr "Говорят, каждую ночь мёртвые поднимаются из Бездны за душами живых."

#. ja: なっ、なら、帰ろうぜ……
#. de: D-Dann geh ich jetzt lieber nach Hause.
#. fr: L-les âmes des v-v-vivants ?
msgctxt "NpcYell:254:0:13"
msgid "S-S-Souls of the l-l-l-living?"
msgstr "Д-душами ж-живых?"

#. ja: なに、お前、びびってんの？
#. de: Hast du etwa Angst?
#. fr: On dirait que tu crois ces sornettes !
msgctxt "NpcYell:255:0:13"
msgid "You sound as if you believe that bilge!"
msgstr "Да ты будто и правда веришь в эту чушь!"

#. ja: び、びびってねぇよ……
#. de: Q-Q-Quatsch!
#. fr: Si j'y crois ? Non... C'est juste que...
msgctxt "NpcYell:256:0:13"
msgid "Believe it? No... It's just..."
msgstr "Верю? Нет… Просто…"

#. ja: だっらしねぇ～
#. de: Dir schlottern ja die Zähne!
#. fr: Ah ! Quelle poule mouillée<nbsp>!
msgctxt "NpcYell:257:0:13"
msgid "Hah! You're worse than my skin and blister!"
msgstr "Ха! Да ты хуже меня и моей занозы!"

#. ja: いるわけねーじゃん
#. de: Als würde es Gespenster geben!
#. fr: Ta mère ne te l'a jamais dit ! Les fantômes, ça existe pas !
msgctxt "NpcYell:258:0:13"
msgid "Didn't your ma ever tell you!? There's no such thing as ghosts!"
msgstr "Тебе мама не говорила?! Призраков не бывает!"

#. ja: ……なっ、なんだ、あれ！？
#. de: Hiiieeeh! H-Hast du das gesehen?!
#. fr: M-m-mais, c'était quoi, ça, alors ?
msgctxt "NpcYell:259:0:13"
msgid "Th-Th-Then what is that!?"
msgstr "Т-тогда что это такое?!"

#. ja: おどかそうとしてもムダだぞ
#. de: Jetzt hör doch auf!
#. fr: S-s-sûrement une luciole.
msgctxt "NpcYell:260:0:13"
msgid "P-Probably just a firefly."
msgstr "Н-Наверное, просто светлячок."

#. ja: なんか、ぼんやり光ってる……
#. de: D-Da leuchtet aber was!
#. fr: Ça avait l'air plus g-g-gros qu'une l-l-luciole...
msgctxt "NpcYell:261:0:13"
msgid "It l-l-l-looks awfully big to be a f-f-firefly..."
msgstr "Он… он какой-то слишком большой для с-с-светлячка…"

#. ja: 船かなんかの灯だろ……？
#. de: Bestimmt Bootslampen oder so!
#. fr: C'était peut-être un navire... ou un phare... ou... euh...
msgctxt "NpcYell:262:0:13"
msgid "Then it's a ship...or a lighthouse...or a...uh..."
msgstr "Тогда это корабль… или маяк… или… э-э…"

#. ja: うわっ、出たー！！
#. de: Beim Klabautermann!
#. fr: UN FANTÔME !!!
msgctxt "NpcYell:263:0:13"
msgid "A GHOST!!!"
msgstr "ПРИЗРАК!!!"

#. ja: ぎゃーーー！
#. de: Hiiiiiieeeh!
#. fr: Maman ! À l'aide !
msgctxt "NpcYell:264:0:13"
msgid "Mummy! Save me!"
msgstr "Мама! Спаси меня!"

#. ja: ま、待て、おいてかないでっ！
#. de: H-He! Lass mich hier nicht alleine!
#. fr: Attends ! M-m-me laisse pas ici !
msgctxt "NpcYell:265:0:13"
msgid "Wait! D-D-Don't leave me here!"
msgstr "П-постой! Н-не бросай меня здесь!"

#. ja: あわわ、腰が……
#. de: Uiuiui ...
#. fr: P-p-pitié, ne prends pas mon âme !
msgctxt "NpcYell:266:0:13"
msgid "P-P-Please don't claim m-m-my soul!"
msgstr "П-пожалуйста, не забирай м-мою душу!"

#. ja: こっち、来ないでくれ……
#. de: Bitte nicht hierher<br>kommen ...
#. fr: D-d-disparais !
msgctxt "NpcYell:267:0:13"
msgid "B-B-B-B-Begone?"
msgstr "П-п-п-прочь?"

#. ja: ん……すっかりいなくなった？
#. de: Sind ... sind sie weg?
#. fr: Ça alors, ça a marché !
msgctxt "NpcYell:268:0:13"
msgid "It w-w-worked!"
msgstr "С-с-сработало!"

#. ja: まっ、まだ、いたー！！
#. de: H-Hier kriegen mich keine zehn Chocobos mehr hin!
#. fr: Ou pas ! Aaaaaahhh !
msgctxt "NpcYell:269:0:13"
msgid "Or not! Aaaaaahhh!"
msgstr "Или нет! А-а-а-а!"

#. ja: またラットが襲ってきそうだ
#. de: Ein Rattenangriff!
#. fr: Ce sont les rats... je les entends couiner...
msgctxt "NpcYell:270:0:13"
msgid "It's the rats... I can hear their squeaking!"
msgstr "Это крысы… слышу, как они пищат!"

#. ja: 訓練の参加希望者よ、集え！
#. de: Freiwillige für die Übung! Antreten!
#. fr: Tous ceux qui le désirent peuvent participer à l'exercice.
msgctxt "NpcYell:271:0:13"
msgid "The exercise is open to all who wish to join!"
msgstr "Все желающие могут присоединиться к тренировке!"

#. ja: 誰か、手伝ってほしいなぁ
#. de: Ach, könnte doch nur jemand die Galagos vertreiben ...
#. fr: Si seulement on m'aidait...
msgctxt "NpcYell:272:0:13"
msgid "Why flour? Why not millioncorn or ogre pumpkins or grapes?"
msgstr "Почему мука? Почему не кукуруза, тыквы огров или виноград?"

#. ja: ちっ、またヤーゾンか！
#. de: Schon wieder diese verdammten Yarzons ...
#. fr: Ça grouille de yarzons, par ici.
msgctxt "NpcYell:273:0:13"
msgid "This place is simply crawling with yarzons!"
msgstr "Здесь просто кишмя кишат ярзоны!"

#. ja: まずいぞ、きっとゴブリンが来る
#. de: Die Goblins stehen sicher schon bald hier auf der Matte.
#. fr: Les Gobelins vont sûrement rappliquer<nbsp>!
msgctxt "NpcYell:274:0:13"
msgid "The goblins'll be here any moment, and then, not a single cog'll be safe!"
msgstr "Гоблины вот-вот заявятся, а потом и шестерёнкам крышка!"

#. ja: 資材の調達といくか……
#. de: Wir brauchen unbedingt neue Ersatzteile ...
#. fr: Besoin... noyaux...
msgctxt "NpcYell:275:0:13"
msgid "Need...cores..."
msgstr "Надо… ядра…"

#. ja: オロボンめ、許さないぞ……！
#. de: Verdammte Orobon! Das werd ich euch nie verzeihen!
#. fr: Je veux qu'ils meurent... tous...
msgctxt "NpcYell:276:0:13"
msgid "I wants 'em dead... All dead..."
msgstr "Хочу, чтоб они сдохли… Все до одного…"

#. ja: あっしの荷物があの中に……！
#. de: Wie soll ich bloß meine Sachen zurückbekommen?
#. fr: Mon rendez-vous ! Qu'est-ce que je vais bien pouvoir lui raconter !?
msgctxt "NpcYell:277:0:13"
msgid "My appointment! Whatever shall I tell them!?"
msgstr "Моя встреча! И что же я им скажу?!"

#. ja: これは責任重大ですね…
#. de: So ein wichtiger Auftrag! Für mich!
#. fr: Mais comment vais-je pouvoir aller là-bas ?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:278:0:13"
msgid "But how am I to get from <i>here</i> to <i>there</i>?"
msgstr "Но как мне добраться <i>отсюда</i> <i>туда</i>?"

#. ja: 誰か、新兵の相手をしてくれ！
#. de: Interessiert, ein paar Rekruten den Ernst des Lebens beizubringen?
#. fr: Une bonne raclée, voilà ce dont ces recrues ont besoin.
msgctxt "NpcYell:279:0:13"
msgid "A good beating─that's what these recruits need."
msgstr "Хорошая взбучка — вот что нужно этим новобранцам."

#. ja: はぁ、ララフェル族いいなぁ
#. de: Hach, es geht einfach nichts über Elezen!
#. fr: Aah, les Lalafelles me font craquer<nbsp>!
msgctxt "NpcYell:280:0:13"
msgid "One day, that wench'll be mine."
msgstr "Когда-нибудь эта красотка будет моей."

#. ja: ふぅ、やっぱミコッテ族だな
#. de: Hach, es geht einfach nichts über Miqo'te!
#. fr: Bof, je préfère les Miqo'tes...
msgctxt "NpcYell:281:0:13"
msgid "One day, that wench'll be mine."
msgstr "Когда-нибудь эта красотка будет моей."

#. ja: んっ！？
#. de: Hm?!
#. fr: Tu disais !?
msgctxt "NpcYell:282:0:13"
msgid "What did you say!?"
msgstr "Что ты сказал?!"

#. ja: ミコッテ族好きだと！？
#. de: Es geht nichts über Miqo'te, sagst du?!
#. fr: Tu préfères les Miqo'tes<nbsp>!?
msgctxt "NpcYell:283:0:13"
msgid "The wench is mine!"
msgstr "Красотка моя!"

#. ja: ララフェル族派だな！？
#. de: Es geht nichts über Elezen, sagst du?!
#. fr: T'es branché Lalafelles<nbsp>!?
msgctxt "NpcYell:284:0:13"
msgid "And I say she's mine!"
msgstr "А я говорю, она моя!"

#. ja: ララフェル族こそ最高っ！
#. de: Elezen haben die längsten Beine!
#. fr: T'y connais rien<nbsp>! Les Lalafelles, c'est ce qu'il y a de mieux<nbsp>!
msgctxt "NpcYell:285:0:13"
msgid "And I say yer full of crab shite!"
msgstr "Да ты несёшь крабье дерьмо!"

#. ja: ミコッテ族こそ正義！
#. de: Miqo'te räkeln sich, da guckst du nur!
#. fr: N'importe quoi<nbsp>! Les Miqo'tes sont les plus jolies<nbsp>!
msgctxt "NpcYell:286:0:13"
msgid "And I say yer full of...of...more crab shite!"
msgstr "А я говорю, ты несёшь… несёшь… ещё больше крабьего дерьма!"

#. ja: おい、喧嘩はやめないか！
#. de: Ruhe jetzt, Jungs!
#. fr: Arrêtez de vous disputer<nbsp>!
msgctxt "NpcYell:287:0:13"
msgid "Alright, you two. Clap the traps. She ain't neither of yours."
msgstr "Так, вы двое, хватит лаяться! Она ни одному из вас не достанется."

#. ja: ああん、邪魔をするなっ！
#. de: Misch dich nicht ein!
#. fr: Ça te regarde pas<nbsp>!
msgctxt "NpcYell:288:0:13"
msgid "This ain't none of your business."
msgstr "Не твоё дело!"

#. ja: てめぇは引っ込んでろっ！
#. de: Das machen wir unter uns aus!
#. fr: Oui, c'est entre lui et moi.
msgctxt "NpcYell:289:0:13"
msgid "Aye, this is between me and this here sod."
msgstr "Ага, мы с этим уродом сами разберёмся."

#. ja: はぁはぁ……
#. de: \<keuch> ... \<schnauf> ...
#. fr: Haah haah...
msgctxt "NpcYell:290:0:13"
msgid "\\<pant> \\<pant>"
msgstr "\\<пыхтит> \\<пыхтит>"

#. ja: 見事！　この関門も安泰だ
#. de: Ausgezeichnet! Um diesen Grenzposten brauche ich mir wohl keine Sorgen mehr zu machen.
#. fr: Excellent travail. Le poste de contrôle est sécurisé !
msgctxt "NpcYell:291:0:13"
msgid "Excellent work, men. The checkpoint is secure!"
msgstr "Отличная работа, бойцы. Пост охраняется!"

#. ja: ばかもーん鍛練が足りん！
#. de: Beschämend! Ab heute jeden Morgen hundert Liegestützen extra!
#. fr: Par Thal ! Vous pensez que ce sera plus facile quand l'Empire sera là !?
msgctxt "NpcYell:292:0:13"
msgid "Thal's balls! You think it will be any easier when the imperials come!?"
msgstr "Да что ж вы за размазни! Думаете, с имперцами будет легче?!"

#. ja: よしっ守りぬいたぞ！！
#. de: Ha, standgehalten!
#. fr: On a réussi ! C'est notre jourrr !
msgctxt "NpcYell:293:0:13"
msgid "We did it! The day is ours!"
msgstr "Мы справились! Сегодня победа за нами!"

#. ja: ふがいない奴らよ……
#. de: Weichliches Pack ...
#. fr: J'ai un mauvais pres<shy>sen<shy>ti<shy>ment pour le poste de contrôle...
msgctxt "NpcYell:294:0:13"
msgid "This bodes ill for the checkpoint..."
msgstr "Плохое это предзнаменование для поста…"

#. ja: これで新兵も焦るだろう
#. de: Das wird den Rekruten eine Lehre sein.
#. fr: Hé hé, ça leur apprendra.
msgctxt "NpcYell:295:0:13"
msgid "Heh heh. That should teach the lads."
msgstr "Хе-хе. Вот им урок будет."

#. ja: 冒険者では力不足だったか
#. de: Du willst <if $gn4>eine Abenteurerin<else>ein Abenteurer</if> sein? Lachhaft ...
#. fr: On dirait qu'il n'y a pas que mes recrues qui se relâchent...
msgctxt "NpcYell:296:0:13"
msgid "It seems my recruits aren't the only ones who are soft..."
msgstr "Похоже, не одни мои новобранцы размякли…"

#. ja: ひぃぃ、強すぎるぜ！
#. de: Gegen <if $gn4>die<else>den</if> ist kein Kraut gewachsen!
#. fr: J'aurais dû devenir cuisinier !
msgctxt "NpcYell:297:0:13"
msgid "I should've become a culinarian!"
msgstr "Надо было мне стать поваром!"

#. ja: 助かったよ、ありがとう！
#. de: Danke! Auch im Namen meiner Orangen!
#. fr: Je vois les caravanes. Les oranges sont sauvées !
msgctxt "NpcYell:298:0:13"
msgid "I see the caravans now. The oranges will be safe!"
msgstr "Вижу караваны! Теперь апельсины в безопасности!"

#. ja: オレンジが食い尽くされた……
#. de: Meine schönen Orangen! Alle weggefressen!
#. fr: Ma récolte... elle est perdue...
msgctxt "NpcYell:299:0:13"
msgid "My harvest... It's gone..."
msgstr "Мой урожай… Всё пропало…"

#. ja: 食い物の恨み、思い知ったか
#. de: Das sollte ihm eine Lehre sein, sich an anderer Leute Tafel zu bedienen.
#. fr: Ces oranges sont pour les bateaux de plaisance ? Je devrais peut-être livrer moi-même.
msgctxt "NpcYell:300:0:13"
msgid "These oranges are off to the pleasure boats, you say? Might be I should see the crates there myself."
msgstr "Говоришь, эти апельсины везут на прогулочные корабли? Может, самому отнести ящики."

#. ja: 賊などに橋は渡さんぞ！！
#. de: Diese Brücke wird niemals in die Hände dieser Banditen fallen!
#. fr: Nous avons repris le contrôle du pont !
msgctxt "NpcYell:301:0:13"
msgid "The bridge is ours once again!"
msgstr "Мост снова наш!"

#. ja: くぅ守りきれぬとは無念……
#. de: Wir haben versagt ... Welch Schande ...
#. fr: Satanées abeilles... Je vous conseille de ne dormir que d'un œil !
msgctxt "NpcYell:302:0:13"
msgid "Bleedin' honeybees... You'd best sleep with one eye open!"
msgstr "Чёртовы пчёлы... Спите теперь с одним открытым глазом!"

#. ja: やった、これで出荷できる！
#. de: Hurra, jetzt kann ich endlich mein Mehl ausliefern!
#. fr: Les galagos ! Ils sont partis ! Je peux enfin livrer ma farine<nbsp>!
msgctxt "NpcYell:303:0:13"
msgid "The galagos! They're gone! I can finally deliver my flour to market!"
msgstr "Галаго! Они ушли! Наконец-то можно отвезти муку на рынок!"

#. ja: た～すけ～て　親分～！
#. de: Wo du sein, wenn man dich brauchen, Boss?
#. fr: Ô piocheur, sauve-nous<nbsp>! Nous ne sommes pas dignes !
msgctxt "NpcYell:304:0:13"
msgid "Pickman! Pickman! Worthy, we are not!"
msgstr "Копатель! Копатель! Не достойны мы тебя!"

#. ja: オトシマエ　つける～！
#. de: Ihr mit mir kämpfen, Feiglinge!
#. fr: Au nom de Titan, le Marteleur du sol, vous allez être écrasés<nbsp>!
msgctxt "NpcYell:305:0:13"
msgid "In the name of Titan, Lord of Crags, crushed shall you be!"
msgstr "Во имя Титана, Повелителя скал, вас раздавит!"

#. ja: ありがたい、作業に戻れるよ
#. de: Danke, jetzt können wir hier ungestört weiterarbeiten.
#. fr: Bon, tout est réglé, je peux reprendre le travail.
msgctxt "NpcYell:306:0:13"
msgid "Well, now that's settled, I can get back to work."
msgstr "Ну вот, теперь можно и за работу взяться."

#. ja: ふぅ、損害は小さそうだ
#. de: Zum Glück scheint der Schaden nicht allzu groß zu sein.
#. fr: On dirait que les Gobelins n'ont pas fait énormément de dégâts.
msgctxt "NpcYell:307:0:13"
msgid "Doesn't look like the goblins did too much damage."
msgstr "Похоже, гоблины не нанесли особого ущерба."

#. ja: また発注しなおしだ……
#. de: Jetzt müssen wir wieder neue Zahnräder bestellen. Das wird dauern ...
#. fr: Une autre cargaison perdue... et je vais devoir payer la nouvelle de ma poche...
msgctxt "NpcYell:308:0:13"
msgid "Another shipment lost...and the new one will come out of my pay..."
msgstr "Опять груз потеряли... А за новую поставку заплатят из моего жалованья..."

#. ja: てった～い
#. de: Dankeviel, dankeviel!
#. fr: Retraite ! Retraite !
msgctxt "NpcYell:309:0:13"
msgid "Backrun! Backrun!"
msgstr "Отходим! Отходим!"

#. ja: 心置きなく使うとしよう……
#. de: Die Kerne werden uns gute Dienste leisten.
#. fr: Merci... beaucoup...
msgctxt "NpcYell:310:0:13"
msgid "Thank...you..."
msgstr "Спасибо..."

#. ja: 橋を守る、給料のある限り！
#. de: An mir kommt keiner vorbei!
#. fr: Si jamais un peiste passe le pont, on vous retiendra un mois de salaire !
msgctxt "NpcYell:311:0:13"
msgid "Allow a single peiste to cross and I'll see to it you're docked a full moon's salary!"
msgstr "Только одна пейста перейдёт мост — и я лишу вас месячного жалованья!"

#. ja: ウチのご飯は守られたっ！
#. de: Unser Abendessen ist damit gesichert.
#. fr: La saison prochaine est assurée... du moins pour l'instant.
msgctxt "NpcYell:312:0:13"
msgid "Next season's catch is safe...for now."
msgstr "Улов на следующий сезон спасён... пока что."

#. ja: 討伐完了、帰還します！
#. de: Mission erfüllt, wir zieh'n uns zurück!
#. fr: Les coblyns se sont retirés. Retournez dans les baraquements !
msgctxt "NpcYell:313:0:13"
msgid "The coblyns have withdrawn. Return to barracks!"
msgstr "Коблины отступили. Возвращайтесь в казармы!"

#. ja: 橋にのさばる賊を討ち払え！
#. de: Verjagt das Pack von der Brücke!
#. fr: Envoyez ces pirates par le fond !
msgctxt "NpcYell:314:0:13"
msgid "Send those pirates plummeting!"
msgstr "Спустите этих пиратов на дно!"

#. ja: よし、次もいっぱい倒そうな！
#. de: Das war erst der Anfang, ihr miesen Orobon!
#. fr: Vous êtes en vie. <if $gn4>Merci.<else>Vous voulez être mon nouveau papa ?</if>
#. macro: <if $gn4>Thank ye.<else>Will ye be me new da?</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:315:0:13"
msgid "Ye dinnae get et. <if $gn4>Thank ye.<else>Will ye be me new da?</if>"
msgstr "Не-а, не выйдет. <if $gn4>Благодарствую.<else>Будешь моим новым папочкой?</if>"

#. ja: 今のうちに穴を埋めるぜッ！
#. de: In Ordnung, Leute! Füllt die Löcher!
#. fr: Les enfants sont en sécurité. Maintenant, à nous de jouer !
msgctxt "NpcYell:316:0:13"
msgid "The children are safe! Now let us fill that hole!"
msgstr "Дети в безопасности! А теперь заделаем эту дыру!"

#. ja: これで明日も生きられまさぁ！
#. de: Jetzt komme ich erst mal über die Runden. Zumindest bis morgen ...
#. fr: Je ferais mieux de filer. Je ne veux pas faire attendre cette noble dame.
msgctxt "NpcYell:317:0:13"
msgid "I really should be off. I mustn't keep the noble ladies waiting!"
msgstr "Мне и правда пора. Нельзя заставлять ждать благородных дам!"

#. ja: クリア！　警戒を続けます！
#. de: Straße geräumt! Patrouille wird fortgesetzt!
#. fr: La voie est libre.
msgctxt "NpcYell:318:0:13"
msgid "The area is clear."
msgstr "Всё чисто."

#. ja: 快適な街道の旅を！
#. de: Na dann, gute Reise!
#. fr: Apprécions donc la beauté du désert ! Mis à part ces cadavres de bouquetins...
msgctxt "NpcYell:319:0:13"
msgid "Ah, let us marvel in the beauty of the desert! (Just disregard those goat corpses.)"
msgstr "Ах, давайте полюбуемся красотой пустыни! (Только не смотрите на туши коз.)"

#. ja: 見たか蛮族、我らの勝利だ！
#. de: Habt ihr gesehen, Echsen? Mit uns ist nicht zu spaßen!
#. fr: Retournez vous cacher, maudits hommes-lézards !
msgctxt "NpcYell:320:0:13"
msgid "Crawl back under your rocks, foul lizards!"
msgstr "Ползите обратно под камни, мерзкие ящеры!"

#. ja: 退却、本陣へ戻るのだ！
#. de: Diese Schlacht ist verloren! Rückzug, Männer!
#. fr: En route vers Zahar'ak ! Retraite !
msgctxt "NpcYell:321:0:13"
msgid "To Zahar'ak! Retreat!"
msgstr "В Захар'ак! Отступаем!"

#. ja: 勝った、守りきったぞ！
#. de: Ha, so leicht bekommt ihr den Goldbasar nicht!
#. fr: Vin et gloire pour les vainqueurs !
msgctxt "NpcYell:322:0:13"
msgid "Wine and glory to the victors!"
msgstr "Победителям — вино и слава!"

#. ja: 遺憾なり……！
#. de: Heut ist nicht das Ende aller Tage!
#. fr: Un jour, à nous ces terres seront<nbsp>!
msgctxt "NpcYell:323:0:13"
msgid "One day this land will be ours again!"
msgstr "Когда-нибудь эта земля снова будет нашей!"

#. ja: 化けてないな？　帰って点呼だ
#. de: Keiner verwandelt? Dann zurück zur Basis!
#. fr: Vous êtes pas un imp, hein ? Hahaha ! Je rigole !
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:324:0:13"
msgid "<i>You</i> aren't an imp, are you? Hah hah! I jest!"
msgstr "<i>Ты</i> ведь не бесёнок? Ха-ха! Да шучу я!"

#. ja: 不穏の芽は、即刈り取る！
#. de: Ein weiterer Schritt zu unsterblichem Ruhm!
#. fr: De la poussière à la poussière !
msgctxt "NpcYell:325:0:13"
msgid "From dust, to dust!"
msgstr "Из праха — в прах!"

#. ja: ザナラーンを易く思うな！
#. de: In Thanalan ist kein Platz für euch, merkt euch das!
#. fr: Ces sales peistes retiendront la leçon<nbsp>!
msgctxt "NpcYell:326:0:13"
msgid "The desert is no place for rose...ling."
msgstr "Не место роз...е в пустыне."

#. ja: チッ、今は退くぞ
#. de: Das ist nur ein vorläufiger Rückzug!
#. fr: On se reverra.
msgctxt "NpcYell:327:0:13"
msgid "You haven't seen the last of us!"
msgstr "Вы ещё о нас услышите!"

#. ja: 戦績よし、命よし！
#. de: Unsere gefallenen Kameraden wären stolz auf uns!
#. fr: Beau travail<nbsp>!
msgctxt "NpcYell:328:0:13"
msgid "Mayhap this will teach those degenerates to piss elsewhere."
msgstr "Может, теперь эти выродки будут справлять нужду где-нибудь в другом месте."

#. ja: よかった、先輩も喜びます
#. de: Mein Vorgesetzter war mächtig stolz auf mich, glaub ich!
#. fr: Je n'aurais pas réussi sans aide. Merci infiniment.
msgctxt "NpcYell:329:0:13"
msgid "I couldn't have made it on my own. You have our gratitude."
msgstr "Без вашей помощи я бы не справился. Мы вам благодарны."

#. ja: つまらぬ収穫なり
#. de: All der Aufwand für diesen Tand ... Ts!
#. fr: Sots, les peaux-lisses sont<nbsp>! Ressasser le passé, il ne faut pas<nbsp>!
msgctxt "NpcYell:330:0:13"
msgid "Foolish are the sons of man. The past is to be left to slumber."
msgstr "Глупы сыны человеческие. Пусть прошлое спит."

#. ja: く、屈辱ぅぅ……ッ！
#. de: Verfluchtes Weib!
#. fr: Sois maudit !
msgctxt "NpcYell:331:0:13"
msgid "Damned vixen!"
msgstr "Проклятая ведьма!"

#. ja: なんだ、もう終わりか？
#. de: Was denn? Schon aus der Puste?
#. fr: C'est tout ? T'as sûrement oublié tes tripes chez toi<nbsp>!
msgctxt "NpcYell:332:0:13"
msgid "Is that all? Might be you left your member at home with your blade."
msgstr "И это всё? Видать, ты свой клинок дома забыл — вместе с мужским достоинством."

#. ja: じゃ、あとは任せたぜ！
#. de: Na dann, viel Glück!
#. fr: Elle est à toi<nbsp>!
msgctxt "NpcYell:333:0:13"
msgid "She's all yours, friend!"
msgstr "Она теперь твоя, друг!"

#. ja: 次の相手はお前だな
#. de: Also gut, kommen wir zu dir ...
#. fr: Si tu penses pouvoir faire mieux, montre-moi.
msgctxt "NpcYell:334:0:13"
msgid "If you think you can do any better, I invite you to try."
msgstr "Думаешь, справишься лучше? Ну так попробуй."

#. ja: 楽しみだ、こちらへ
#. de: Da vorne ist mehr Platz.
#. fr: Par ici.
msgctxt "NpcYell:335:0:13"
msgid "This way."
msgstr "Сюда."

#. ja: では……勝負ッ！
#. de: Bereit zum Kampf?
#. fr: En garde<nbsp>!
msgctxt "NpcYell:336:0:13"
msgid "Now, let us begin."
msgstr "Что ж... Начнём."

#. ja: その程度か！？
#. de: Ist das alles?
#. fr: Bah ! J'ai connu des puces qui piquaient plus fort.
msgctxt "NpcYell:337:0:13"
msgid "Hah! I've felt bigger stings from a flea bite."
msgstr "Ха! Да я и от укуса блохи сильнее чувствовал!"

#. ja: 腕が鳴るな！
#. de: Wundervoll!
#. fr: Y a que comme ça qu'on se sent vivre<nbsp>!
msgctxt "NpcYell:338:0:13"
msgid "Ah, this is living!"
msgstr "Вот это жизнь!"

#. ja: 誰でも構わん、来い
#. de: Ich nehm's mit jedem auf!
#. fr: Allez, au suivant !
msgctxt "NpcYell:339:0:13"
msgid "Who's next!?"
msgstr "Кто следующий?!"

#. ja: 腑抜けばかりか？
#. de: Gibt's hier niemanden mit Mumm in den Knochen?
#. fr: Personne<nbsp>? Vous n'êtes que des lâches !
msgctxt "NpcYell:340:0:13"
msgid "Spineless cravens is what you all are!"
msgstr "Вы все — жалкие трусы!"

#. ja: うっ、降参だ……
#. de: Ich ... gebe auf ...
#. fr: J-je me rends !
msgctxt "NpcYell:341:0:13"
msgid "I-I yield!"
msgstr "Я... сдаюсь..."

#. ja: まだ鍛錬が足りないな……
#. de: Ich muss ... mehr trainieren!
#. fr: Mais on se reverra ! C'est juré.
msgctxt "NpcYell:342:0:13"
msgid "But I will see you again! I swear it!"
msgstr "Но мы ещё встретимся! Вот увидишь!"

#. ja: 時間の無駄だな
#. de: Pah, reine Zeit<shy>verschwen<shy>dung.
#. fr: Quelle perte de temps.
msgctxt "NpcYell:343:0:13"
msgid "Another waste of time."
msgstr "Опять зря время потратил."

#. ja: 戦馬鹿は勝手にやってな！
#. de: Schlagt euch ruhig die Schädel ein!
#. fr: Décidément, personne n'est à la hauteur !
msgctxt "NpcYell:344:0:13"
msgid "Is there no one who can offer me a challenge?"
msgstr "Неужели тут некому дать мне достойный отпор?"

#. ja: くそっラットめ、やめろ！
#. de: Dreckige Ratten! Hinfort mit euch!
#. fr: Disparais, vermine de l'enfer !
msgctxt "NpcYell:345:0:13"
msgid "My oranges!"
msgstr "Мои апельсины!"

#. ja: オレンジが食われていく……
#. de: Meine Orangen! Meine Orangen!
#. fr: Mes oranges<nbsp>!
msgctxt "NpcYell:346:0:13"
msgid "Get out of there, you hellssent vermin!"
msgstr "А ну брысь отсюда, адская нечисть!"

#. ja: ヒャッハーー！
#. de: Hiyaaah!
#. fr: Hah ha ha hah !
msgctxt "NpcYell:347:0:13"
msgid "Gyaaah hah hah haaah!"
msgstr "Гья-ха-ха-ха-а!"

#. ja: おらおら通行料の徴収だ！
#. de: Jetzt zahlst du Wegzoll, Freundchen!
#. fr: Faut payer la taxe !
msgctxt "NpcYell:348:0:13"
msgid "Pay the toll! Pay the toll!"
msgstr "Плати за проезд! Плати!"

#. ja: 金目のものは残らず出しな！
#. de: Rückt all euer Geld raus!
#. fr: Lâche tes gils sans faire d'histoire<nbsp>!
msgctxt "NpcYell:349:0:13"
msgid "Empty yer purse out on the bridge and we'll let ye live long enough to watch us gather up the gil."
msgstr "Вываливайте всё, что есть в кошельках, на мост — и, может, проживёте достаточно долго, чтобы посмотреть, как мы подберём гилы."

#. ja: お願い、早くやっつけて！
#. de: Verjag die Biester, schnell!
#. fr: La farine ! Pensez à la farine !
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:350:0:13"
msgid "The flour! Won't anyone think of the <i>flour</i>!?"
msgstr "Мука! Неужели никому нет дела до <i>муки</i>!?"

#. ja: 誰かガラゴをやっつけて！
#. de: So kümmre sich doch jemand um diese Galagos!
#. fr: Pourquoi ces galagos ne laissent pas le moulin en paix ?
msgctxt "NpcYell:351:0:13"
msgid "Why won't these galagos leave the mill be!?"
msgstr "Да почему эти галаго не оставят мельницу в покое?!"

#. ja: こーこは　とおさなーい！
#. de: Passage ich dir nicht gewähren.
#. fr: Cette terre est à Titan, oui, à Titan<nbsp>!
msgctxt "NpcYell:352:0:13"
msgid "This land, Titan claims!"
msgstr "Эта земля принадлежит Титану!"

#. ja: もちもの　おいてーけ！
#. de: Inhalt von Taschen du geben!
#. fr: Prosterne-toi ! Plus bas, oui, plus bas !
msgctxt "NpcYell:353:0:13"
msgid "Down, you bow! Lower! Lower!"
msgstr "Поклоняйся! Ниже! Ещё ниже!"

#. ja: あーたると　いーたいよー！
#. de: Meine Schläge sehr schmerzhaft sein.
#. fr: Tu vas souffrir ! Titan sait tout, tout !
msgctxt "NpcYell:354:0:13"
msgid "Pain, you will suffer! Titan knows!"
msgstr "Будет больно! Титан всё знает!"

#. ja: ど～りゃ～！！
#. de: Dies du nehmen!
#. fr: Grahk<nbsp>! Ghraaah<nbsp>!
msgctxt "NpcYell:355:0:13"
msgid "Grahk! Ghraaah!"
msgstr "Грах! Гра-а!"

#. ja: 若いもんの　うらみ　はらす！
#. de: Ich rächen dich werde, Jungbold!
#. fr: Titan voit tout ! Il connaît notre douleur, il la connaît !
msgctxt "NpcYell:356:0:13"
msgid "Titan sees all! Our pain, He knows!"
msgstr "Титан всё видит! Он знает о нашей боли!"

#. ja: ぜ～ったいに　まけない！
#. de: Besiegen du kannst mich nicht.
#. fr: Vous allez succomber au froid mortel !
msgctxt "NpcYell:357:0:13"
msgid "Succumb, you will to the cold of the crag!"
msgstr "Сгинешь от холода скал!"

#. ja: ああっ、大事な資材が！
#. de: Unsere Zahnräder! Ohne die sind wir aufgeschmissen!
#. fr: Non<nbsp>! Pas notre matériel<nbsp>!
msgctxt "NpcYell:358:0:13"
msgid "Not the cogs! It took ages for those to arrive!"
msgstr "Только не шестерёнки! Их же целую вечность везли!"

#. ja: 早く追い払ってくれぇ
#. de: Vertreib die Randalebrüder, bitte!
#. fr: Je n'ai pas mérité ça !
msgctxt "NpcYell:359:0:13"
msgid "I did naught to deserve this!"
msgstr "Я ничем такого не заслужил!"

#. ja: シュコォ……
#. de: Pssh!
#. fr: Boum, boum, paf, paf<nbsp>!
msgctxt "NpcYell:360:0:13"
msgid "Pshhh...kooohhh..."
msgstr "Пшшш... кххх..."

#. ja: どんどんこわすぞ～！
#. de: Kaputt, kawumm!
#. fr: Les Gobelins en colère tapent du pied !
msgctxt "NpcYell:361:0:13"
msgid "Mad gobbies crash groundstomp!"
msgstr "Злые гобби топ-топ, землю бум!"

#. ja: てっつ～い
#. de: Pssshummm!
#. fr: Les Gobelins méchants cassent les rouages !
msgctxt "NpcYell:362:0:13"
msgid "Bad gobbies smash toothwheels!"
msgstr "Плохие гобби зубоколёса крушить!"

#. ja: 小魚が食い荒らされてるー！？
#. de: Die fressen uns alle Fische auf!
#. fr: Oh non<nbsp>! Ils mangent encore nos poissons !
msgctxt "NpcYell:363:0:13"
msgid "Oh! There goes another fry!"
msgstr "Ой! Ещё один малёк пропал!"

#. ja: おのれオロボンっ！　誰かー！
#. de: Elende Brut! Jemand muss diese Monster stoppen!
#. fr: Maudites créatures<nbsp>! Que quelqu'un les terrasse<nbsp>!
msgctxt "NpcYell:364:0:13"
msgid "Wretched swamp spawn! I'd club you myself if I had a big enough stick!"
msgstr "Проклятый болотный сброд! Я бы вас дубиной огрел, да дубины подходящей нет!"

#. ja: 1匹残らず、やっちまえー！
#. de: Keiner darf übrigbleiben!
#. fr: À mort, les orobons !
msgctxt "NpcYell:365:0:13"
msgid "Kill the 'bons!"
msgstr "Убейте всех до единого!"

#. ja: 父ちゃんの仇め！
#. de: Rache für meinen Vater!
#. fr: Au nom de mon père !
msgctxt "NpcYell:366:0:13"
msgid "Fer me da!"
msgstr "За папку моего!"

#. ja: 邪魔だ！
#. de: Aus dem Weg, Gewürm!
#. fr: Les gêneurs, nous n'aimons pas<nbsp>!
msgctxt "NpcYell:367:0:13"
msgid "You are a plague on the realm!"
msgstr "Вы — беда для всего мира!"

#. ja: どけ！
#. de: Spüre Ifrits Zorn!
#. fr: Derrière des murs de pierre, cachez-vous !
msgctxt "NpcYell:368:0:13"
msgid "Run! Cower behind your stone walls!"
msgstr "Бегите! Прячьтесь за каменными стенами!"

#. ja: 脆弱なり！
#. de: In den Staub!
#. fr: Cette impudence nous fatigue !
msgctxt "NpcYell:369:0:13"
msgid "We grow weary of your impudence!"
msgstr "Нам надоела ваша наглость!"

#. ja: 奪え！　攫え！
#. de: Plündert und nehmt Geiseln!
#. fr: Les armes déposez<nbsp>! Ou notre courroux, subirez<nbsp>!
msgctxt "NpcYell:370:0:13"
msgid "Throw down your arms and you will be spared an eternity of damnation!"
msgstr "Бросьте оружие — и избавитесь от вечных мук!"

#. ja: 屈服せよ！
#. de: Gebt auf, dreckige Würmer!
#. fr: Résister, vous ne devez pas<nbsp>!
msgctxt "NpcYell:371:0:13"
msgid "Do not resist!"
msgstr "Не сопротивляйтесь!"

#. ja: ぬんっ！
#. de: Huarrrgh!
#. fr: Grrr !
msgctxt "NpcYell:372:0:13"
msgid "Ngrrr!"
msgstr "Нгр-р!"

#. ja: やっちゃうゾ！
#. de: Alles Gute kommt von obent!
#. fr: Tu viens jouer ?
msgctxt "NpcYell:373:0:13"
msgid "Yah coOm play, no?"
msgstr "Ях коом играть, а?"

#. ja: チミ、どこ行くノ？
#. de: Wo willst du hin?
#. fr: Où tu vas<nbsp>? Reviens<nbsp>!
msgctxt "NpcYell:374:0:13"
msgid "Wharr gonG! Yah coOm bakk!"
msgstr "Кваа гонг? Ях коом назад!"

#. ja: ほひ～！
#. de: Dschumm!
#. fr: Gnin hin hin ho ho ho<nbsp>!
msgctxt "NpcYell:375:0:13"
msgid "Tyah hah hyah ho ho!"
msgstr "Тья ха хья хо хо!"

#. ja: ケケッ、ザンネ～ン
#. de: Dumm gelaufent!
#. fr: Pas drôle... pas drôle du tout...
msgctxt "NpcYell:376:0:13"
msgid "Fun noo tOdahh... Fun noo..."
msgstr "Весело нет... совсем весело нет..."

#. ja: 有り金すべて置いてきな！
#. de: Leert eure Taschen! Und zwar pronto!
#. fr: Vide ta bourse<nbsp>!
msgctxt "NpcYell:377:0:13"
msgid "Slip open yer purse, like. Or I'll cut it for ye."
msgstr "Ну-ка выверни кошелёк. А то я сама его выверну!"

#. ja: すっ裸にしてやんよォ！
#. de: Euch wird nichts bleiben!
#. fr: Pas d'argent<nbsp>? Qu'est-ce que tu caches dans tes vêtements, alors ?
msgctxt "NpcYell:378:0:13"
msgid "No coin, ye say? What've ye hidin' in them smallclothes, then?"
msgstr "Денег нет, говоришь? А что тогда прячешь в исподнем?"

#. ja: オアシスまで頑張りましょう
#. de: Also gut, auf zur Oase!
#. fr: Il ne faut pas s'arrêter en plein milieu des sables mouvants.
msgctxt "NpcYell:379:0:13"
msgid "We must hurry. It is unwise to pause on the shifting sands."
msgstr "Надо спешить. На зыбучих песках останавливаться не стоит."

#. ja: アマルジャ族に警戒を
#. de: Achte auf Amalj'aa, ja?
#. fr: Attention aux Amalj'aa<nbsp>!
msgctxt "NpcYell:380:0:13"
msgid "The Amalj'aa watch from afar. If we are lucky, they will leave us be."
msgstr "Амалджа следят за нами издалека. Может, пронесёт и они нас не тронут."

#. ja: 不気味な静けさですね…
#. de: Es ist still hier ... Zu still!
#. fr: Ce silence est lugubre...
msgctxt "NpcYell:381:0:13"
msgid "Do not let the silence of the sand fool you!"
msgstr "Не дайте песчаной тишине себя обмануть!"

#. ja: 荷物を必ず届けなければ
#. de: Ich darf die Lieferung auf keinen Fall verlieren.
#. fr: Ces reliques pourraient bien dévoiler les secrets du passé. Il faut les répertorier !
msgctxt "NpcYell:382:0:13"
msgid "These relics could reveal the secrets of eras past. They must be cataloged!"
msgstr "Эти реликвии могут раскрыть тайны минувших эпох. Их нужно занести в каталог!"

#. ja: これは重大な任務なんだ…！
#. de: Mein Auftrag ist extrem wichtig!
#. fr: J'ai de la chance de vous avoir à mes côtés.
msgctxt "NpcYell:383:0:13"
msgid "I am fortunate to have you by my side."
msgstr "Как же мне повезло, что вы рядом."

#. ja: ババルン、まけないっちゃ！
#. de: Babaroon ganz sicher gewinnt!
#. fr: Babaroon aime crac crac ! Les aventuuuriers, ça croustille ?
msgctxt "NpcYell:384:0:13"
msgid "Babaroon is hungry for some crunchies! Adventurer crunchy?"
msgstr "Бабарун хочет хрустяшек! Авантюрист хрустящий?"

#. ja: 集合、きてきてっちゃ！
#. de: Alle um Babaroon sammeln!
#. fr: Viens ! On va croquer ensemble, crac crac !
msgctxt "NpcYell:385:0:13"
msgid "Come come! Crack some, yah?"
msgstr "Сюда-сюда! Хрум-хрум, да?"

#. ja: 侵入者、ぐつぐつっちゃ！
#. de: Reinkommer alle platt machen!
#. fr: Les intrus, au chaudron qui bout<nbsp>!
msgctxt "NpcYell:386:0:13"
msgid "Babaroon has a bubbly pot! Throws you in the bubbly pot!"
msgstr "У Бабаруна котёл кипит! Тебя в котёл закинуть!"

#. ja: 退けるべし！
#. de: Flieh, solang du noch kannst!
#. fr: Fuyez, vils peaux-lisses<nbsp>!
msgctxt "NpcYell:387:0:13"
msgid "Fly, sons of man!"
msgstr "Бегите, сыны человеческие!"

#. ja: おのれ！
#. de: Dreckiger Wurm!
#. fr: Satanés peaux-lisses<nbsp>!
msgctxt "NpcYell:388:0:13"
msgid "You are filth!"
msgstr "Вы — грязь!"

#. ja: 愚かなり！
#. de: Deine Torheit wird dich ins Verderben reißen!
#. fr: Ignorants peaux-lisses<nbsp>!
msgctxt "NpcYell:389:0:13"
msgid "Ignorant knobs of flesh!"
msgstr "Невежды, мясные комки!"

#. ja: ようやく大人しくなったか……
#. de: Na also, es geht doch!
#. fr: J'ai cru qu'ils s'arrêteraient jamais<nbsp>!
msgctxt "NpcYell:390:0:13"
msgid "I thought they'd never stop..."
msgstr "Я уж думал, они никогда не угомонятся..."

#. ja: まったく、手間取らせやがって
#. de: Nichts als Ärger hat man mich euch ...
#. fr: Ils vont vite revenir, j'en ai peur. Têtus comme des mules<nbsp>!
msgctxt "NpcYell:391:0:13"
msgid "They'll soon be at it again, I fear. The two are stubborn as logs."
msgstr "Боюсь, скоро они опять примутся за своё. Упрямые, как пни."

#. ja: ムムッ、これはイカンぞ
#. de: Verstehe, das ist in der Tat besorgniserregend.
#. fr: Où sont les renforts, bon sang ?
msgctxt "NpcYell:392:0:13"
msgid "Where are the damned reinforcements...?"
msgstr "Где, чёрт побери, подкрепление?.."

#. ja: 雑兵は捨て置け！
#. de: Lass das Kleinvieh links liegen!
#. fr: Ignorez les soldats ! Il nous faut leur chef !
msgctxt "NpcYell:393:0:13"
msgid "Ignore the grunts! We seek out their leader!"
msgstr "На рядовых не отвлекайтесь! Ищем их командира!"

#. ja: ムムッ、指揮官はどこだ？
#. de: Wo steckt der Kommandant?!
#. fr: Le commandant est introuvable<nbsp>!
msgctxt "NpcYell:394:0:13"
msgid "There is no sight of the commander. He must be here somewhere!"
msgstr "Командира нигде не видно. Но он должен быть где-то здесь!"

#. ja: ひとまず物資を叩く！
#. de: Erst mal die Kisten zerstören!
#. fr: Peu importe. On sabote leurs provisions<nbsp>!
msgctxt "NpcYell:395:0:13"
msgid "No matter. We can still sabotage their supplies!"
msgstr "Неважно. Можно хотя бы уничтожить их припасы!"

#. ja: 指揮官め、逃げたか！？
#. de: Ob der Kommandant geflüchtet ist?
#. fr: Où est-il ?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:396:0:13"
msgid "Where <i>is</i> he!?"
msgstr "Да где <i>же</i> он?!"

#. ja: くっ、早く目的を……
#. de: Es darf keine Kiste übrigbleiben!
#. fr: Il n'a pas pu partir. Je l'ai vu de mes propres yeux.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:397:0:13"
msgid "He can't have withdrawn already. I <i>saw</i> him with mine own two eyes!"
msgstr "Он не мог уже отступить. Я <i>своими</i> глазами его видел!"

#. ja: 何事か！？
#. de: Was geht hier vor?
#. fr: Mon repas, qui ose troubler<nbsp>?
msgctxt "NpcYell:398:0:13"
msgid "Who disturbs my meal!?"
msgstr "Кто посмел помешать моей трапезе?!"

#. ja: 指揮官だ、討てッ！
#. de: Der Kommandant! Auf ihn!
#. fr: Le commandant ! À l'attaque<nbsp>!
msgctxt "NpcYell:399:0:13"
msgid "The commander! To me!"
msgstr "Командир! За мной!"

#. ja: 完遂だ！　走って撤収ゥ！
#. de: Der ist hinüber! Los, Rückzug!
#. fr: Pour l'argent et notre pays ! Nous avons stoppé l'avancée des lézards !
msgctxt "NpcYell:400:0:13"
msgid "For coin and country! We have stayed the lizards' hand!"
msgstr "За гилы и родину! Мы остановили ящеров!"

#. ja: ムムッ、妨害もこれまでか
#. de: Ich fürchte, das war's fürs Erste ...
#. fr: Espérons que cela permette à nos renforts d'arriver...
msgctxt "NpcYell:401:0:13"
msgid "We can only hope our efforts gave the reinforcements enough time..."
msgstr "Остаётся надеяться, что мы продержались достаточно долго и подкрепление успеет прийти..."

#. ja: 被害を補填せよ！
#. de: Für den Schaden werdet ihr aufkommen!
#. fr: Les morts comptez<nbsp>! Les corps évacuez<nbsp>!
msgctxt "NpcYell:402:0:13"
msgid "Tally our losses and burn the bodies!"
msgstr "Подсчитайте потери и сожгите тела!"

#. ja: 恩に着るぞ、いざ突入！
#. de: Ausgezeichnet! Mir nach!
#. fr: Vous avez toute ma gratitude, ainsi que celle d'Ul'dah !
msgctxt "NpcYell:403:0:13"
msgid "You have my thanks and the thanks of Ul'dah!"
msgstr "Благодарю вас! И от себя, и от всего Ульда!"

#. ja: 魔物だ！　敵襲ー敵襲ー！
#. de: Monster! Wir werden angegriffen!
#. fr: Des frelons ! Sonnez l'alerte !
msgctxt "NpcYell:404:0:13"
msgid "Wespes! Sound the bells!"
msgstr "Осы! Бейте в колокола!"

#. ja: 各位魔物を撃退せよ！
#. de: Streckt sie nieder! Allesamt!
#. fr: Attention à leurs piqûres ! Leur venin mettrait KO un auroch géant !
msgctxt "NpcYell:405:0:13"
msgid "Watch for their sting! The poison can cripple a grown aurochs!"
msgstr "Берегитесь их жала! Яд может свалить даже взрослого тура!"

#. ja: 何か、食べられる物を……
#. de: Mami muss unbedingt was essen ...
#. fr: Mère, il n'y a que des vieux lacets et des mauvaises herbes...
msgctxt "NpcYell:406:0:13"
msgid "What ever should I do, Mother? I can find only boot laces and tumbleweed..."
msgstr "Что же мне делать, матушка? Тут только шнурки да перекати-поле..."

#. ja: 待っててね、お母さん
#. de: Ich werd dir was ganz Leckeres zubereiten, Mami ... Hab noch ein bisschen Geduld.
#. fr: J'ai réussi, Mère ! Tout ira bien !
msgctxt "NpcYell:407:0:13"
msgid "I did it, Mother! Everything will be alright!"
msgstr "У меня получилось, матушка! Всё будет хорошо!"

#. ja: 誰か手伝ってくださらない？
#. de: Ich könnte wirklich gut Hilfe gebrauchen.
#. fr: N'y a-t-il donc personne pour m'aider ?
msgctxt "NpcYell:408:0:13"
msgid "Is there not a single adventurer who would assist me?"
msgstr "Неужели не найдётся ни одного искателя приключений, кто мне поможет?"

#. ja: うふ、じっくり調べてあげる
#. de: Ich werde den Steinen bis auf den Grund ihrer Seele schauen, ohohoho!
#. fr: Avec ces pierres, je prouverai à ces incrédules qu'ils ont tort.
msgctxt "NpcYell:409:0:13"
msgid "With these stones I shall prove my disbelievers wrong!"
msgstr "С этими камнями я докажу, что мои недоброжелатели неправы!"

#. ja: 秩序のため、ゴミを始末する！
#. de: Dieser Abschaum gehört beseitigt!
#. fr: Débarrassons-nous de ces sales renégats !
msgctxt "NpcYell:410:0:13"
msgid "Let us dispose of this rubbish!"
msgstr "Давайте избавимся от этого отребья!"

#. ja: 了解ッ！
#. de: Jawohl, Sir!
#. fr: À vos ordres<nbsp>!
msgctxt "NpcYell:411:0:13"
msgid "Aye!"
msgstr "Есть!"

#. ja: くそッ、銅刃団のやつらだ！
#. de: Verdammt, Messingklingen!
#. fr: Les lames de cuivre<nbsp>!
msgctxt "NpcYell:412:0:13"
msgid "Blades!"
msgstr "Клинки!"

#. ja: 権力の犬め……！
#. de: Verflucht sollt ihr sein!
#. fr: Les chiens de la Sultane sont là !
msgctxt "NpcYell:413:0:13"
msgid "The sultana's pigs've come to wallow!"
msgstr "Явились, султанские свиньи!"

#. ja: まだだ、俺たちは生きる！
#. de: Die Leichenbrigade ist noch lange nicht geschlagen!
#. fr: Ne croyez pas qu'un Mhigois s'avoue vaincu aussi facilement, raclures !
msgctxt "NpcYell:414:0:13"
msgid "Don't think an Ala Mhigan'll fall that easily, pigs!"
msgstr "Не думайте, что ала-миганец так просто падёт, свиньи!"

#. ja: こんな……はずじゃ……
#. de: Das ... kann nicht ...
#. fr: Ah ! Vous ne me laissez pas le choix...
msgctxt "NpcYell:415:0:13"
msgid "Gah! You leave me no choice..."
msgstr "Чёрт! Вы не оставляете мне выбора..."

#. ja: 逃がすな、一網打尽だ！
#. de: Lasst niemanden entkommen!
#. fr: Ne laissez pas les renégats s'échapper !
msgctxt "NpcYell:416:0:13"
msgid "Don't let him escape!"
msgstr "Не дайте ему сбежать!"

#. ja: すまん、侵入を許した……
#. de: Mögen die Zwölf uns vergeben ...
#. fr: Je suis navré, j'ai laissé des intrus s'infiltrer...
msgctxt "NpcYell:417:0:13"
msgid "Apologies, my captain. I've failed you..."
msgstr "Простите, капитан. Я вас подвёл..."

#. ja: 我々に逃げ道は<br>ないということね
#. de: Für uns gibt's wohl nur den Weg des Kämpfens.
#. fr: Plus d'échappatoire... La brigade des <br>Cadavres meurt, et ne se rend pas<nbsp>!
msgctxt "NpcYell:418:0:13"
msgid "You did what you could."
msgstr "Вы сделали всё, что могли."

#. ja: まだゴミが残っていたか！
#. de: Das wird ja immer widerwärtiger!
#. fr: Ah, voici la meneuse des renégats<nbsp>!
msgctxt "NpcYell:419:0:13"
msgid "Ah, and here's the dung heap."
msgstr "А вот и куча навоза."

#. ja: 私だって骸旅団の戦士ッ！！
#. de: Auch die Leichenbrigade hat ihren Stolz!
#. fr: Pour la fierté mhigoise<nbsp>! Vous ne l'emporterez pas<nbsp>!
msgctxt "NpcYell:420:0:13"
msgid "For king and country!"
msgstr "За короля и родину!"

#. ja: ここで死ぬわけには<br>いかない……！
#. de: Ich darf hier nicht sterben!
#. fr: Jamais les Mhigois ne courberont <br>l'échine face aux esclavagistes<nbsp>!
msgctxt "NpcYell:421:0:13"
msgid "The Corpse Brigade will never perish!"
msgstr "Бригада трупов никогда не погибнет!"

#. ja: 敵襲！キキルンの軍団よ！
#. de: Qiqirn! Sie greifen uns an!
#. fr: Des Qiqirns<nbsp>! Aux armes<nbsp>!
msgctxt "NpcYell:422:0:13"
msgid "Raiders approach! To arms!"
msgstr "Враги приближаются! К оружию!"

#. ja: 橋は私たちが守る！
#. de: Sichert die Brücke!
#. fr: Repoussez ces rats de notre pont !
msgctxt "NpcYell:423:0:13"
msgid "Keep the rats off our bridge!"
msgstr "Не подпускайте крыс к нашему мосту!"

#. ja: フンベルクト隊に勝利を！
#. de: Hunbercts Truppen werden siegreich sein!
#. fr: L'unité de Hunberct aura la victoire<nbsp>!
msgctxt "NpcYell:424:0:13"
msgid "For Ul'dah!"
msgstr "За Ульду!"

#. ja: ひるむな、押し返せ！
#. de: Zögert nicht! Schlagt sie zurück!
#. fr: Ne laissez pas ces fichus rongeurs gagner du terrain !
msgctxt "NpcYell:425:0:13"
msgid "Don't give those vermin an ilm!"
msgstr "Не дайте этой мерзости продвинуться ни на илм!"

#. ja: 隊長……！
#. de: Für den Kommandanten!
#. fr: Capitaine !
msgctxt "NpcYell:426:0:13"
msgid "Captain!"
msgstr "Капитан!"

#. ja: 襲撃だ！逃げろ、隠れろ！
#. de: Ein Überfall! Bringt euch in Sicherheit!
#. fr: Des bandits qiqirns ! Aux abris<nbsp>!
msgctxt "NpcYell:427:0:13"
msgid "Qiqirn bandits! Hide the little ones!"
msgstr "Бандиты кикирн! Прячьте детей!"

#. ja: 行かせるものかッ！
#. de: Hier kommt niemand durch!
#. fr: Revenez ici !
msgctxt "NpcYell:428:0:13"
msgid "Come back here!"
msgstr "А ну вернись!"

#. ja: 物資は渡さない！
#. de: Die Kisten dürfen nicht an den Feind geraten!
#. fr: Mettez les provisions en sécurité !
msgctxt "NpcYell:429:0:13"
msgid "See that the supplies are safe!"
msgstr "Убедитесь, что припасы в безопасности!"

#. ja: 市民を守れ！
#. de: Schützt die Zivilisten!
#. fr: Les rats essaient de capturer des civils<nbsp>!
msgctxt "NpcYell:430:0:13"
msgid "The villagers! The rats look to capture them!"
msgstr "Жители! Крысы хотят их схватить!"

#. ja: 負けるわけには…！
#. de: Die Geiseln brauchen uns!
#. fr: Nous devons tenir bon !
msgctxt "NpcYell:431:0:13"
msgid "We must endure!"
msgstr "Мы должны выстоять!"

#. ja: ひぃぃ…お助けを！
#. de: H-Hilfe! So hilf uns doch jemand!
#. fr: Ôtez vos sales pattes de moi !
msgctxt "NpcYell:432:0:13"
msgid "Keep those damned paws off me!"
msgstr "Уберите от меня свои проклятые лапы!"

#. ja: い、命だけは！
#. de: Rettet uns!
#. fr: Pas le Cratère des tisons ! Tuez-moi, qu'on en finisse !
msgctxt "NpcYell:433:0:13"
msgid "Not the Bowl of Embers! Just kill me now!"
msgstr "Только не в Чашу огня! Лучше убейте меня сейчас!"

#. ja: 勘弁してくれ…！
#. de: Ich will hier raus!
#. fr: Épargnez ma vie !
msgctxt "NpcYell:434:0:13"
msgid "Take me if you must, but spare my wife!"
msgstr "Забирайте меня, если надо, но пощадите жену!"

#. ja: まだ死にたくないぃぃ
#. de: Ich will noch nicht sterben!
#. fr: Que les Douze nous sauvent !
msgctxt "NpcYell:435:0:13"
msgid "Twelve save us!"
msgstr "Двенадцать, спасите нас!"

#. ja: 何でこんなことに
#. de: Womit hab ich das verdient?
#. fr: Où sont les lames de cuivre !?
msgctxt "NpcYell:436:0:13"
msgid "Where are the Brass Blades!?"
msgstr "Где Медные Клинки!?"

#. ja: 早く終われ…早く終われ…
#. de: Das ist doch alles nur ein böser Traum, oder?
#. fr: Finissez-en, vite<nbsp>!
msgctxt "NpcYell:437:0:13"
msgid "When will this all end!?"
msgstr "Когда же это всё закончится!?"

#. ja: 迎え撃つぞ、オレの女神たち！
#. de: Bereitet ihnen einen gebührenden Empfang, ihr Schönen des Schlachtfelds!
#. fr: Et la machine prend vie !
msgctxt "NpcYell:438:0:13"
msgid "And the machine roars to life!"
msgstr "И машина оживает!"

#. ja: オレがいれば怖くないさ！
#. de: Fürchtet euch nicht, ich werde euch retten!
#. fr: Venez vite ! Combattons-les !
msgctxt "NpcYell:439:0:13"
msgid "Come, my ladies! Let us take the fight to them!"
msgstr "Ну же, красавицы! В бой!"

#. ja: 決して犠牲は出すな！
#. de: Opfer müssen vermieden werden!
#. fr: Personne ne mourra sous ma garde. Ordres du capitaine !
msgctxt "NpcYell:440:0:13"
msgid "No one dies under my watch. Captain's orders!"
msgstr "Под моим командованием никто не погибнет. Приказ капитана!"

#. ja: 大丈夫、怯えることはない
#. de: Keine Sorge, wir schaffen das schon!
#. fr: Rien à craindre, à part une mort horrible aux mains des hommes-bêtes.
msgctxt "NpcYell:441:0:13"
msgid "There is nothing to fear, but a painful death at the hands of a beastman."
msgstr "Бояться нечего, разве что мучительной смерти от рук зверолюдей."

#. ja: こらこら、見惚れるなよ
#. de: Erstarre im Angesicht meiner Schönheit!
#. fr: Voyons, mesdemoiselles, remettez-vous, vous avez l'habitude de me voir<nbsp>!
msgctxt "NpcYell:442:0:13"
msgid "Who shall man the lever tonight, ladies!?"
msgstr "Кто сегодня будет крутить рычаг, дамы!?"

#. ja: 華麗にッ！
#. de: Kämpft lei<shy>den<shy>schaft<shy>lich!
#. fr: Concision !
msgctxt "NpcYell:443:0:13"
msgid "Concise!"
msgstr "Изящно!"

#. ja: 優雅にッ！
#. de: Kämpft anmutig!
#. fr: Précision !
msgctxt "NpcYell:444:0:13"
msgid "Precise!"
msgstr "Точно!"

#. ja: どうだ、美しいだろう！？
#. de: Sahst du jemals solche Schönheit?
#. fr: Rétorsion<nbsp>! Rétaliation<nbsp>! Un autre mot en “ion”<nbsp>!
msgctxt "NpcYell:445:0:13"
msgid "Entice!"
msgstr "Ну как, красиво, правда!?"

#. ja: 触れると切れるぞ！
#. de: Fass mich an und du bist tot!
#. fr: Pas touche, saleté, tu vas me tacher<nbsp>!
msgctxt "NpcYell:446:0:13"
msgid "Don't you dare lay a claw upon me!"
msgstr "Не смейте трогать меня своими когтями!"

#. ja: いいッ！オレかっこいいッ！
#. de: Ich bin der Größte!
#. fr: Vous avez vu ça ? Hein ?
msgctxt "NpcYell:447:0:13"
msgid "Did you see that, ladies? Did you?"
msgstr "Видели, дамы? Видели!?"

#. ja: いけー、隊長さまー！
#. de: Zeigt's ihnen, Kommandant!
#. fr: Oh, capitaaaine ! Vous me faites un tel effet<nbsp>!
msgctxt "NpcYell:448:0:13"
msgid "Oh, my captain!"
msgstr "О, мой капитан!"

#. ja: 隊長さまかっこいいにゃ
#. de: Hunberct ist so süß, wenn er kämpft!
#. fr: Regarrrdez comme son torse se gonfle !
msgctxt "NpcYell:449:0:13"
msgid "Would you look how his chest heaves?"
msgstr "Полюбуйтесь, как у него вздымается грудь!"

#. ja: うずうず……！
#. de: Endlich mal was los!
#. fr: J'ai connu des hommes, mais jamais des comme lui<nbsp>!
msgctxt "NpcYell:450:0:13"
msgid "See how the sweat glistens on his brow!"
msgstr "Видите, как блестит пот у него на лбу!"

#. ja: 行っていーかにゃ？
#. de: Darf ich auf Rattenjagd gehen?!
#. fr: Ouuuh, quel poète<nbsp>!
msgctxt "NpcYell:451:0:13"
msgid "I'd take an arrow in the thigh for you, Captain!"
msgstr "Я бы и стрелу в бедро приняла ради вас, капитан!"

#. ja: イイトコ見せるにゃ！
#. de: Euch wird Hören und Sehen vergehen!
#. fr: Vous me rendez toute chose, capitaine<nbsp>!
msgctxt "NpcYell:452:0:13"
msgid "Tonight it is I who shall man the lever!"
msgstr "Сегодня рычаг буду крутить я!"

#. ja: 一緒なら無敵にゃ！
#. de: Gemeinsam sind wir starrrk!
#. fr: Tant que le capitaine est en vie, nous ne pouvons pas perrrdre !
msgctxt "NpcYell:453:0:13"
msgid "As long as the captain stands, we cannot be struck down!"
msgstr "Пока капитан на ногах, нас не одолеть!"

#. ja: みんな、隊長さまを援護にゃ！
#. de: Schützt den Kommandanten!
#. fr: Prrrotégez le capitaine !
msgctxt "NpcYell:454:0:13"
msgid "Protect the captain!"
msgstr "Защитите капитана!"

#. ja: おせおせーっ！
#. de: Auf sie!
#. fr: On y va, les filles<nbsp>!
msgctxt "NpcYell:455:0:13"
msgid "\\<hiss>"
msgstr "\\<шипение>"

#. ja: とにゃーッ！
#. de: Miaaauuu!
#. fr: Pas touche au capitaine<nbsp>!!
msgctxt "NpcYell:456:0:13"
msgid "I'll rip out your eyes and cast them into the chasm!"
msgstr "Вырву вам глаза и брошу в пропасть!"

#. ja: チッ、次はないぞ野盗ども！
#. de: Beim nächsten Mal machen wir Ragout aus den Biestern!
#. fr: Pas si vite, vermine du nord !
msgctxt "NpcYell:457:0:13"
msgid "You won't get far, northborn scum!"
msgstr "Далеко не уйдёте, северная шваль!"

#. ja: なっ、キキルン盗賊団！？
#. de: E-Ein Qiqirn-Überfall?
#. fr: Des bandits qiqirns !?
msgctxt "NpcYell:458:0:13"
msgid "Qiqirn bandits!"
msgstr "Бандиты кикирн!"

#. ja: 皆、今日の獲物は、<br>サンドウォームだ！
#. de: Heute gehen wir auf Sandwurmjagd, Mädels!
#. fr: Aujourrrd'hui, c'est chasse au ver des sables<nbsp>!
msgctxt "NpcYell:459:0:13"
msgid "The sun gives us light so that we may hunt in Her name!"
msgstr "Солнце освещает нам путь, чтобы мы охотились во имя Её!"

#. ja: おおーっ！！
#. de: Ist gut!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:460:0:13"
msgid "Hyaaa!"
msgstr "А-а-а!"

#. ja: おー
#. de: Alles klar!
#. fr: A l'attaaaaque, mes sœurs<nbsp>!
msgctxt "NpcYell:461:0:13"
msgid "Hyaaa!"
msgstr "А-а-а!"

#. ja: よし、十分だな<br>族長もお喜びになられるだろう
#. de: In Ordnung, das reicht für heute. Der Häuptling wird sehr zufrieden mit euch sein.
#. fr: La cheftaine serrra contente de nous<nbsp>!
msgctxt "NpcYell:462:0:13"
msgid "The sun on our heads and blood on our hands! Life is good, my sisters!"
msgstr "Солнце над головой, кровь на руках! Хороша жизнь, сёстры!"

#. ja: もういい！今日は引き上げるぞ！
#. de: Seid ihr Drakon-Kriegerinnen oder Kätzchen?! Genug, wir ziehen uns zurück!
#. fr: Rangez vos arrrcs, la chasse est finie pour aujourd'hui<nbsp>!
msgctxt "NpcYell:463:0:13"
msgid "Lower your bows! Today, we hunt no more."
msgstr "Опустите луки! На сегодня охота окончена."

#. ja: おっと、金は持ってかないと
#. de: Ich muss mein Geld in Sicherheit bringen!
#. fr: Où ai-je rangé ma cassette<nbsp>?
msgctxt "NpcYell:464:0:13"
msgid "Wherever did I place my lockbox?"
msgstr "Где же я оставил свой ларец?"

#. ja: 命あっての商売さ！
#. de: Als es „abwechslungsreicher Job“ hieß, habe ich eigentlich an was anderes gedacht ...
#. fr: Je ne tolérerai pas que ces rats s'emparent de mon argent si durement acquis !
msgctxt "NpcYell:465:0:13"
msgid "I won't allow my hard-earned profits to fall into those rats' hands!"
msgstr "Не позволю этим крысам прибрать к рукам мою честно заработанную прибыль!"

#. ja: にゃ～…一時撤退にゃ…
#. de: Vorrrläufiger Rückzug!
#. fr: Je ne vous quitterrrai jamais, capitaine... même dans l'au-delà<nbsp>!
msgctxt "NpcYell:466:0:13"
msgid "I'll never leave you, my captain...in spirit!"
msgstr "Я никогда не покину вас, капитан... даже духом!"

#. ja: 隊長さま、ごめんなさいにゃ…
#. de: Sei uns bitte nicht böse, Kommandant ...
#. fr: Capitaine, parrrdonnez cet échec !
msgctxt "NpcYell:467:0:13"
msgid "Please forgive me! I know not what I do!"
msgstr "Простите меня! Я не ведала, что творю!"

#. ja: 助かった！
#. de: Den Göttern sei Dank!
#. fr: Mille mercis !
msgctxt "NpcYell:468:0:13"
msgid "A thousand thanks!"
msgstr "Тысяча благодарностей!"

#. ja: 今回も激しかったなー
#. de: Auf so was kann ich in Zukunft verzichten.
#. fr: Il est peut-être temps de penser à déménager...
msgctxt "NpcYell:469:0:13"
msgid "Mayhap it's right time I thought about relocation..."
msgstr "Пожалуй, пора подумать о переезде..."

#. ja: よかったぁ…！
#. de: Zum Glück ist alles vorbei ...
#. fr: Bénis soient les Douze !
msgctxt "NpcYell:470:0:13"
msgid "Thank the Twelve!"
msgstr "Слава Двенадцати!"

#. ja: 無事だ、生きてる！！
#. de: Wir haben's überlebt!
#. fr: Est-ce que... nous sommes encore en vie ?
msgctxt "NpcYell:471:0:13"
msgid "Are...are we...still alive?"
msgstr "Мы... мы... всё ещё живы?"

#. ja: 俺は最初から信じてたぞ
#. de: Ich wusste, dass man uns nicht im Stich lassen würde.
#. fr: Je savais que le capitaine nous sauverait !
msgctxt "NpcYell:472:0:13"
msgid "I knew the captain would save us!"
msgstr "Я знал, что капитан нас спасёт!"

#. ja: やれやれ、やっと終わったか
#. de: Endlich ist der Albtraum vorbei.
#. fr: Nous sommes sains et saufs... du moins jusqu'au matin.
msgctxt "NpcYell:473:0:13"
msgid "Safe...until the morrow, at least."
msgstr "Целы... по крайней мере до утра."

#. ja: このまま敵の拠点を叩く！　オレの美しい背中に続け！
#. de: Wir packen den Feind da, wo es ihn am meisten schmerzt!<br>Folgt meinen breiten Schultern, oh Kriegerinnen!
#. fr: Maintenant, frappons-les en plein cœur ! Rangez-vous derrière mon dos magnifiquement sculpté<nbsp>!
msgctxt "NpcYell:474:0:13"
msgid "Now, we strike at their heart! Follow me!"
msgstr "Теперь ударим им в самое сердце! За мной!"

#. ja: こーなったら止まらないにゃ
#. de: So kann's weitergehen!
#. fr: On vous suivrrra jusqu'au bout, capitaine<nbsp>!
msgctxt "NpcYell:475:0:13"
msgid "To the seventh hell and back, my captain!"
msgstr "Хоть в седьмой круг ада и обратно, капитан!"

#. ja: 今が一番かっこいいにゃ
#. de: Oh Götter! So schnuckelig hab ich Hunberct noch nie gesehen!
#. fr: La victoirrre est proche<nbsp>!
msgctxt "NpcYell:476:0:13"
msgid "I smell victory!"
msgstr "Пахнет победой!"

#. ja: オレは隊長失格だ…
#. de: Ich habe versagt! Ich bin meines Postens nicht würdig ...
#. fr: Comment ai-je pu laisser faire cela ?
msgctxt "NpcYell:477:0:13"
msgid "How could I have let this happen...?"
msgstr "Как я мог допустить такое?.."

#. ja: 隊長さまがいたのに…
#. de: Obwohl der Kommandant mit uns kämpfte?! Das kann ich nicht glauben ...
#. fr: Nous avons échoué... alorrrs que le capitaine était là<nbsp>!
msgctxt "NpcYell:478:0:13"
msgid "Let me tend to your wounds."
msgstr "Дайте я обработаю ваши раны."

#. ja: うそにゃ。おかしいにゃ…！
#. de: Die haben geschummelt! Das ist nicht fairrr!
#. fr: C'est pas possible<nbsp>!? On a perrrdu<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:479:0:13"
msgid "No, let <i>me</i> tend to your wounds!"
msgstr "Нет, <i>я</i> обработаю ваши раны!"

#. ja: ん！？森から何か来たぞ…！
#. de: Hm? Da raschelt was in den Zweigen!
#. fr: Il y a quelque chose du côté du bois !
msgctxt "NpcYell:480:0:13"
msgid "There's something in the wood!"
msgstr "В лесу кто-то есть!"

#. ja: ううん、困ったなぁ……
#. de: So was Dummes aber<br>auch ...
#. fr: Je suis souvent victime des colibris...
msgctxt "NpcYell:481:0:13"
msgid "Oh, if there were only someone who loathed colibri as much as I..."
msgstr "Эх, если бы нашёлся кто-нибудь, кто ненавидит колибри так же, как я..."

#. ja: “ワタシハ<br>トテモ　ツヨイ　デス！”
#. de: ICH BIN SEHR, SEHR STARK!
#. fr: “JE SUIS TRÈS TRÈS FORT<nbsp>!”
msgctxt "NpcYell:482:0:13"
msgid "SYSTEMS UPGRADED."
msgstr "СИСТЕМЫ УЛУЧШЕНЫ."

#. ja: “ゴメイレイヲ…<br>ドウ…ゾ…！”
#. de: WAS KANN ICH FÜR DICH TUN?
#. fr: “J'ATTENDS VOS ORDRES, MAÎTRE<nbsp>!”
msgctxt "NpcYell:483:0:13"
msgid "WAITING FOR COMMAND..."
msgstr "ОЖИДАНИЕ КОМАНДЫ..."

#. ja: 助けにきたわよ！
#. de: Ich stehe Euch bei, Kommandant!
#. fr: Je suis là, capitaine, je vais vous sauver !
msgctxt "NpcYell:484:0:13"
msgid "I'm here, my captain!"
msgstr "Я здесь, капитан!"

#. ja: 加勢する！行くぞッ！
#. de: Harrt aus, ich komme!
#. fr: Je serrrai votre bouclier !
msgctxt "NpcYell:485:0:13"
msgid "I shall be your shield!"
msgstr "Я стану вашим щитом!"

#. ja: 諦めるものか！
#. de: Wir geben nicht auf!
#. fr: Ne perdons pas espoir !
msgctxt "NpcYell:486:0:13"
msgid "We cannot abandon hope!"
msgstr "Нельзя терять надежду!"

#. ja: この気配、奥に何かいるぞ！<br>やつが黒幕か…！？
#. de: Da hinten ist jemand, sagt mir mein untrügliches Näschen! Der Drahtzieher dieses Komplotts?
#. fr: Le véritable ennemi montre son visage !
msgctxt "NpcYell:487:0:13"
msgid "There! The true enemy shows himself!"
msgstr "Вот он! Истинный враг показался!"

#. ja: 私についてきて！<br>みんな、今助けに行くから！
#. de: Folgt mir, Mädels! Die Ratten brauchen 'ne Abreibung!
#. fr: Venez ! Les villageois ont besoin de nous !
msgctxt "NpcYell:488:0:13"
msgid "Come! The villagers need us!"
msgstr "За мной! Жителям нужна наша помощь!"

#. ja: なんて美しい勝利だ！<br>さあ、みんなで橋に戻ろう
#. de: Dieser glorreiche Sieg steht mir ausgezeichnet! Lasst uns nach Hohenbrück zurückkehren und ihn gebührend feiern!
#. fr: C'est notre jour ! Rentrons au Viaduc<nbsp>!
msgctxt "NpcYell:489:0:13"
msgid "The day is ours! Now let us return to Highbridge."
msgstr "Сегодня победа за нами! Возвращаемся на Высокий мост."

#. ja: いいぞ、キキルンを蹴散らせ！
#. de: Weiter so! Die Qiqirn sollen diesen Tag nicht vergessen!
#. fr: Frappez fort et regardez-les s'enfuir !
msgctxt "NpcYell:490:0:13"
msgid "Hit them hard and watch them scatter!"
msgstr "Бейте их как следует, глядите, как разбегаются!"

#. ja: 我らが優勢だ！　このまま退ける！
#. de: Das Schlachtenglück ist uns hold! Nieder mit den Qiqirn!
#. fr: Encore un effort, mesdames !
msgctxt "NpcYell:491:0:13"
msgid "One last push, my ladies!"
msgstr "Ещё один рывок, дамы!"

#. ja: 本隊の到着か……！　物資と市民に近づけるな！
#. de: Die Hauptstreitmacht!<br>Lasst sie nicht zu den Bürgern und Kisten durch!
#. fr: Ces rats... ils se reproduisent comme des lapins !
msgctxt "NpcYell:492:0:13"
msgid "These rats...they breed like...rats!"
msgstr "Эти крысы... плодятся как... крысы!"

#. ja: 守りきれ！　我々は華麗に勝利するッ！
#. de: Kämpft, holde Kriegerinnen! Unser Sieg wird glanzvoll sein!
#. fr: Regardez ! Ils fléchissent ! Et tout ce qui fléchit finit par casser !
msgctxt "NpcYell:493:0:13"
msgid "Look! They bend! And what bends will break!"
msgstr "Смотрите! Они гнутся! А всё, что гнётся, рано или поздно сломается!"

#. ja: 狩りつくす！
#. de: Vernichtet sie!
#. fr: Visez juste, mes sœurrrs !
msgctxt "NpcYell:494:0:13"
msgid "Aim true, my sisters!"
msgstr "Цельтесь метко, сёстры!"

#. ja: このデカミミズっ！
#. de: Der Tod steht dir gut!
#. fr: Ce soir, nous fêterons notre victoirrre !
msgctxt "NpcYell:495:0:13"
msgid "Tonight we dine on glory!"
msgstr "Сегодня будем пировать славой!"

#. ja: すぐ息の根を止めてやる！
#. de: Zurück in den Staub mit dir!
#. fr: Arrachez-leurrr les dents !
msgctxt "NpcYell:496:0:13"
msgid "Rip the teeth from their maws!"
msgstr "Вырывайте им зубы!"

#. ja: 触るなッ！
#. de: Bleib mir vom Leib!
#. fr: Au nom du soleil<nbsp>!
msgctxt "NpcYell:497:0:13"
msgid "For the sun!"
msgstr "За солнце!"

#. ja: ほらほらっ！
#. de: Auf sie!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:498:0:13"
msgid "Hyah!"
msgstr "А-а!"

#. ja: 大人しくしな！
#. de: Sei brav und stirb!
#. fr: Parrr ici !
msgctxt "NpcYell:499:0:13"
msgid "Over here!"
msgstr "Сюда!"

#. ja: 美味そうなやつだね！
#. de: Der sieht lecker aus!
#. fr: Ver au menu, ce soirrr<nbsp>!
msgctxt "NpcYell:500:0:13"
msgid "Tonight we dine on worm!"
msgstr "Сегодня на ужин — червь!"

#. ja: 叩き潰すっ！
#. de: Nehmt die Würmer auseinander!
#. fr: Grrr<nbsp>!
msgctxt "NpcYell:501:0:13"
msgid "Grrr!"
msgstr "Р-р-р!"

#. ja: えい
#. de: Hngh!
#. fr: Ngah !
msgctxt "NpcYell:502:0:13"
msgid "Ngah!"
msgstr "Нга!"

#. ja: とー
#. de: Hrrr!
#. fr: Humph !
msgctxt "NpcYell:503:0:13"
msgid "Hmph!"
msgstr "Хмф!"

#. ja: げんきになれー
#. de: Hier, das muntert dich auf!
#. fr: Je vous soigne<nbsp>!
msgctxt "NpcYell:504:0:13"
msgid "Your wounds!"
msgstr "Ранения!"

#. ja: かっちこちー
#. de: Das sollte uns schützen!
#. fr: Que ce bouclier vous prrrotège<nbsp>!
msgctxt "NpcYell:505:0:13"
msgid "Protect!"
msgstr "Защита!"

#. ja: サンドウォーム…如きっ！
#. de: Tod den Sandwürmern!
#. fr: Maudits verrrs<nbsp>!
msgctxt "NpcYell:506:0:13"
msgid "Die, worms!"
msgstr "Сдохните, черви!"

#. ja: やっ……誰か……！
#. de: Hilfe! Ich bin verletzt!
#. fr: Aidez-moi<nbsp>! Je vais y rrrester<nbsp>!
msgctxt "NpcYell:507:0:13"
msgid "Sisters! It...hurts..."
msgstr "Сёстры! Больно..."

#. ja: みんな無事か！？　あと少し耐えてくれ……！
#. de: Noch ein bisschen, dann ist es geschafft!<br>Haltet durch, meine holden Kriegerinnen!
#. fr: Tenez bon, camarades<nbsp>! Ne flanchez pas !
msgctxt "NpcYell:508:0:13"
msgid "Hold, ladies! Hold!"
msgstr "Держитесь, девочки! Держитесь!"

#. ja: 敵将を引きずり出したぞ！　さあ、今回の勇者もオレか！？
#. de: Ha, der Schurke hat sich gezeigt!<br>Zeit für einen weiteren meiner glanzvollen Auftritte!
#. fr: J'ai attiré leur chef<nbsp>! Qui est le héros du jour, qui<nbsp>?
msgctxt "NpcYell:509:0:13"
msgid "Ah, named vermin. How quaint."
msgstr "Ах, именные вредители. Как занятно."

#. ja: 退けキキルン！　我らの勇姿、その小汚い面には惜しい！
#. de: Hinfort mit euch, ihr garstigen Qiqirn!<br>Ihr beleidigt meinen ästhetischen Feinsinn!
#. fr: Personne ne se rappellera ton nom quand j'en aurai fini avec toi !
msgctxt "NpcYell:510:0:13"
msgid "No one will remember your name after I'm through with you!"
msgstr "После меня никто и имени твоего не вспомнит!"

#. ja: おまえら商品……帰るなら一緒っちゃ……
#. de: Qiqirn Kisten mit Glitzer wollen. Du uns geben!
#. fr: Zuzuroon pas se soucier des noms, vouloir juste bling bling !
msgctxt "NpcYell:511:0:13"
msgid "Zuzuroon cares not of names. Zuzuroon cares only of sparklies!"
msgstr "Зузурун имена не волнуют. Зузуруну нужны только блестяшки!"

#. ja: この橋は決して落とせない、覚えておけッ！
#. de: Hohenbrück wird niemals fallen.<br>Merk dir das, du garstiger Unhold!
#. fr: C'est mon pont et il est temps que vous partiez !
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:512:0:13"
msgid "This is <i>my</i> bridge, and it is high time you left it!"
msgstr "Это <i>мой</i> мост, и вам давно пора с него уйти!"

#. ja: グウウ……売り払ってやるっちゃ！
#. de: Schleimiger Mann büßen werden!
#. fr: Zuzuroon partira bientôt... mais avec jolis bling bling !
msgctxt "NpcYell:513:0:13"
msgid "Zuzuroon soon be leaving...but with flesh for sparklies!"
msgstr "Зузурун скоро уйдёт... но блестяшки заберёт!"

#. ja: はぁ～い♪ お話しない～？
#. de: Na? Wer möchte mit mir plaudern? ♪
#. fr: Ohé ? Y a quelqu'un ?
msgctxt "NpcYell:514:0:13"
msgid "Hullo? Is anyone there?"
msgstr "Ау? Тут кто-нибудь есть?"

#. ja: 引き上げるぞ！<br>これ以上は泥沼だ…！
#. de: Hier können wir nichts mehr ausrichten!<br>Rückzug, meine Kriegerinnen!
#. fr: Retraite ! Nous devons nous regrouper !
msgctxt "NpcYell:515:0:13"
msgid "Fall back! We are outmatched and need time to regroup!"
msgstr "Отступаем! Нас превосходят числом, надо перегруппироваться!"

#. ja: うれしい！　じゃあ行きましょ♪
#. de: Prima! Dann kann's ja direkt losgehen ♪
#. fr: Pas une minute à perdrrre. Le temps, c'est de l'argent<nbsp>!
msgctxt "NpcYell:516:0:13"
msgid "Well, then we have no time to lose. I charge by the bell, you know."
msgstr "Что ж, медлить нельзя. Я, знаете ли, беру плату за час."

#. ja: やだぁ～！　何かいるぅ～！
#. de: Igitt! Da kommt irgendwas Schwabbeliges auf uns zu!
#. fr: Oh non, pas encorrre eux... Vous devriez dégainer votre arme.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:517:0:13"
msgid "Oh, not <i>them</i> again. You might want to draw your weapon."
msgstr "О нет, опять <i>они</i>. Советую достать оружие."

#. ja: うそぉ！　またぁ～！？
#. de: Warum können die uns nicht in Ruhe lassen?
#. fr: Pourquoi ils ne veulent pas me lâcher<nbsp>?
msgctxt "NpcYell:518:0:13"
msgid "Why won't they just let me be!?"
msgstr "Да почему они никак не оставят меня в покое?!"

#. ja: いや～ん！　こわ～い～！
#. de: Der macht mir Angst!
#. fr: Quels pots de colle<nbsp>!
msgctxt "NpcYell:519:0:13"
msgid "Persistent little imps, they are."
msgstr "Упрямые бесёнки, вот ведь."

#. ja: キャー！　たーすーけーて～！
#. de: H-Hilfeee!
#. fr: Ils n'ont pas l'air de vouloir abandonner la parrrtie<nbsp>!
msgctxt "NpcYell:520:0:13"
msgid "Twelve forfend! They simply won't give in!"
msgstr "Двенадцать упаси! Они просто не сдаются!"

#. ja: ちゃりちゃり…
#. de: Glitzer, Glitzer! Kisten für Glitzer!
#. fr: Jolis clic clic ! Des caisses de jolis bling bling !
msgctxt "NpcYell:521:0:13"
msgid "Sparklies! Sparklies! Crates for sparklies!"
msgstr "Блестяшки! Блестяшки! Ящики за блестяшки!"

#. ja: 商品あつめるっちゃ…
#. de: Glitzer, Glitzer! Fleisch für Glitzer!
#. fr: Il me faut du stock ! Pour les jolis bling bling !
msgctxt "NpcYell:522:0:13"
msgid "Flesh for sparklies! Many sparklies!"
msgstr "Плоть за блестяшки! Много блестяшек!"

#. ja: お客様がお待ちっちゃ…
#. de: Freundliche Echse schon wartet mit Glitzer!
#. fr: Maître lézard a des jolis clic clic !
msgctxt "NpcYell:523:0:13"
msgid "Lizards wait with sparkly sparklies!"
msgstr "Ящеры ждут с блестящими блестяшками!"

#. ja: おまえ、いらない
#. de: Du weg! Echsen nur Schwache mögen!
#. fr: Va-t'en, toi<nbsp>!
msgctxt "NpcYell:524:0:13"
msgid "Strong must away. Lizards seek puny stock."
msgstr "Сильным уйти. Ящеры ищут слабую добычу."

#. ja: 邪魔っちゃ…！
#. de: Qiqirn nicht wollen Ärger mit Schwertschwingern! Geh weg!
#. fr: Tu gênes<nbsp>!
msgctxt "NpcYell:525:0:13"
msgid "Qiqirn no quarrel with sword swingers. Leave now, and Qiqirn see off!"
msgstr "Кикирн не хочет ссориться с мечниками. Уходи сейчас, и кикирн тебя отпустит!"

#. ja: 売り飛ばすっちゃ…
#. de: Glitzer! Viel Glitzer!
#. fr: Jolis bling bling ! Rupture de stock<nbsp>!
msgctxt "NpcYell:526:0:13"
msgid "Sparklies! Sparklies!"
msgstr "Блестяшки! Блестяшки!"

#. ja: わらわら仕入れたっちゃ…<br>ちゃりちゃりと、交換…
#. de: Qiqirn schon andere gefangen! Tauschen gegen Glitzer!
#. fr: Au marché ! Pour les jolis bling bling !
msgctxt "NpcYell:527:0:13"
msgid "To market! To market! To sparklies! To market!"
msgstr "На рынок! На рынок! За блестяшками! На рынок!"

#. ja: 贄に過ぎぬ人間風情が！
#. de: Seine Herrlichkeit wird sich an ihren Seelen laben!
#. fr: Vils humains<nbsp>! Juste bons à servir d'offrandes<nbsp>!
msgctxt "NpcYell:528:0:13"
msgid "His Effulgence would have these souls!"
msgstr "Его Сияние желает эти души!"

#. ja: 貴様らなど！
#. de: Welch Anmaßung!
#. fr: Insolence !
msgctxt "NpcYell:529:0:13"
msgid "Insolence!"
msgstr "Наглость!"

#. ja: 物の数ではないわ！
#. de: Gib auf oder stirb!
#. fr: Soumettez-vous<nbsp>! Ou mourez<nbsp>!
msgctxt "NpcYell:530:0:13"
msgid "Submit or perish!"
msgstr "Покоритесь или погибните!"

#. ja: 不測…なり……
#. de: Meine Flamme ... mag hier erlöschen, doch die meines Herrn ... brennt ewig ...
#. fr: Morte, ma flamme en ce jour est...
msgctxt "NpcYell:531:0:13"
msgid "My flame dies here, but my Lord's burns ever...bright..."
msgstr "Моё пламя угасает здесь, но пламя моего господина горит вечно... ярко..."

#. ja: はぁ、困りました……
#. de: Das hat mir gerade noch gefehlt.
#. fr: Que les Douze me pardonnent, je suis faible.
msgctxt "NpcYell:532:0:13"
msgid "Twelve forgive me, for I am weak."
msgstr "Двенадцать, простите меня, я так слаб."

#. ja: では、行きましょう
#. de: Wunderbar! Brechen wir direkt auf!
#. fr: Allons-y, alors.
msgctxt "NpcYell:533:0:13"
msgid "This way, then."
msgstr "Тогда за мной."

#. ja: 慎重に……
#. de: Psst, beweg dich leise ...
#. fr: Faites vite. Ne faisons pas attendre monseigneur.
msgctxt "NpcYell:534:0:13"
msgid "Hurry, would you? We mustn't keep the monsignor waiting."
msgstr "Поторопитесь, не заставляйте монсеньора ждать."

#. ja: 羽音のようなものが……？
#. de: Dieses Surren behagt mir gar nicht ...
#. fr: J'ai cru entendre un bruissage d'aile...
msgctxt "NpcYell:535:0:13"
msgid "What was that? And that? And that!?"
msgstr "Что это было? И это? И это?!"

#. ja: 必ず、届けなければ……！
#. de: Wenn ich den Met nicht abliefere, hagelt's 'ne Standpauke vom Chef.
#. fr: Monseigneur ne peut pas se passer d'hydromel une journée...
msgctxt "NpcYell:536:0:13"
msgid "If the monsignor is without his mead for even a single turn of the sun..."
msgstr "Если монсеньор хоть один день останется без мёда..."

#. ja: うう、なぜこんな目に……
#. de: Warum passiert so was immer mir?
#. fr: Pourquoi monseigneur ne va-t-il pas chercher lui-même son hydromel<nbsp>!?
msgctxt "NpcYell:537:0:13"
msgid "Why can't the monsignor get his own mead!?"
msgstr "Почему монсеньор сам не может сходить за своим мёдом?!"

#. ja: 大聖堂まで、あと少しです
#. de: Bis zum Dom ist es nicht mehr weit.
#. fr: Le Sanctuaire est tout près.
msgctxt "NpcYell:538:0:13"
msgid "The Sanctum lies just beyond those trees."
msgstr "Святилище за теми деревьями."

#. ja: ここまでくれば大丈夫でしょう
#. de: Ab hier schaffe ich es auch alleine.
#. fr: Nous avons réussi ! Oh, bénis soient les Douze !
msgctxt "NpcYell:539:0:13"
msgid "We made it! Oh, praise the Twelve!"
msgstr "Мы добрались! О, хвала Двенадцати!"

#. ja: ありがとう、助かりました！
#. de: Vielen Dank, das war sehr nett von dir!
#. fr: Je suis arrivé en un morceau<nbsp>!
msgctxt "NpcYell:540:0:13"
msgid "My neck is saved!"
msgstr "Я спасён!"

#. ja: このお礼は、いつか必ず……
#. de: Der Tag kommt sicher, an dem ich mich für deine Hilfe erkenntlich zeigen kann.
#. fr: Je vous revaudrai cela un jour<nbsp>!
msgctxt "NpcYell:541:0:13"
msgid "I will repay you one day, my friend. Just...not with mead."
msgstr "Однажды я отплачу тебе, друг. Только... не мёдом."

#. ja: これより掃討作戦を開始する！
#. de: Start frei für Operation „Mit Stumpf und Stiel“!
#. fr: Pas de pitié pour ces adorables créatures<nbsp>!
msgctxt "NpcYell:542:0:13"
msgid "When we're through, I want to be waist-deep in little white mandragora limbs!"
msgstr "Когда мы закончим, хочу по колено в белых конечностях мандрагор!"

#. ja: 総員かかれっ！！
#. de: Vorwärts, Männer!
#. fr: Formez les rangs !
msgctxt "NpcYell:543:0:13"
msgid "Now fall in!"
msgstr "А теперь в строй!"

#. ja: 行くぞおぉぉっ！！
#. de: Euch stampf ich ein!
#. fr: Exterminez-moi ces mauvaises herbes<nbsp>!
msgctxt "NpcYell:544:0:13"
msgid "And kill them all!"
msgstr "И перебейте их всех!"

#. ja: うわぁ魚が食われちまう～！
#. de: Die fressen mir alle Fische weg!
#. fr: Des p-p-pugils !
msgctxt "NpcYell:545:0:13"
msgid "P-P-P-Pugils!"
msgstr "П-п-п-пугили!"

#. ja: 誰かプギルを退治してくれ！！
#. de: Irgendjemand muss was gegen diese Pugil unternehmen!
#. fr: Ces saletés m'ont mordu la jambe !
msgctxt "NpcYell:546:0:13"
msgid "The hells-spawned thing bit me leg!"
msgstr "Эта порождённая адом тварь цапнула меня за ногу!"

#. ja: う、うわぁっ！
#. de: O-Oh ...
#. fr: Au secours<nbsp>!
msgctxt "NpcYell:547:0:13"
msgid "Keep it away! Keep it away!"
msgstr "Не подпускайте! Не подпускайте!"

#. ja: お願い、やっつけてください！
#. de: Ich bin allergisch gegen Schnakenstiche!
#. fr: Abattez-les, par pitié<nbsp>!
msgctxt "NpcYell:548:0:13"
msgid "I didn't hire you to just stand there!"
msgstr "Я нанял вас не для того, чтобы вы тут стояли!"

#. ja: 追い払ってください！
#. de: Tu was gegen diese Biester!
#. fr: Maman !
msgctxt "NpcYell:549:0:13"
msgid "Mother!"
msgstr "Мама!"

#. ja: お酒がこぼれてしまう……
#. de: He, ich verschütt noch meinen Met!
#. fr: Prenez l'hydromel, mais épargnez-moi !
msgctxt "NpcYell:550:0:13"
msgid "The mead! You can have it! Just spare me!"
msgstr "Мёд! Забирайте! Только не трогайте меня!"

#. ja: かっ、囲まれました……！
#. de: Wir sind umzingelt!
#. fr: Par les Douze ! Nous sommes encerclés !
msgctxt "NpcYell:551:0:13"
msgid "Gods! Now they've surrounded us!"
msgstr "Боги! Нас окружили!"

#. ja: うう、あと少しなのに……！
#. de: Selbst hier noch?!
#. fr: Par les Douze<nbsp>! Nous y sommes presque<nbsp>!
msgctxt "NpcYell:552:0:13"
msgid "Oh, kindly Matron, take me to Your ivory bosom and away from this hell!"
msgstr "О, милосердная Матрона, прижмите меня к своей слоновой кости и унесите прочь из этого ада!"

#. ja: ワシの可愛い子猫ちゃん……
#. de: Wo bleibt mein kleines Kätzchen denn nur?
#. fr: Où est le cadeau promis par Gegeruju ?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:553:0:13"
msgid "Where is this <i>gift</i> Master Gegeruju promised?"
msgstr "Где же <i>подарок</i>, который обещал господин Гегеруджу?"

#. ja: 早く舞を見せておくれ……
#. de: Jeder Tag sollte ein Frühlingstag sein!
#. fr: J'ai horreur que l'on me fasse attendre.
msgctxt "NpcYell:554:0:13"
msgid "I do not enjoy being made to wait."
msgstr "Не люблю, когда меня заставляют ждать."

#. ja: オジサマ待たせてゴメンね
#. de: Entschuldige, dass es so lange gedauert hat, Goldi ♪
#. fr: Désolée, j'espère que l'attente n'a pas été trrrop longue.
msgctxt "NpcYell:555:0:13"
msgid "Apologies, milord. I hope you did not wait overlong."
msgstr "Простите, милорд. Надеюсь, ждать пришлось недолго."

#. ja: うおーーヨイヨイーー！！
#. de: Oh Götter, seid gepriesen!
#. fr: Ah, Maître Gegeruju. Vous me connaissez si bien.
msgctxt "NpcYell:556:0:13"
msgid "Ah, Master Gegeruju. You know me well."
msgstr "Ах, господин Гегеруджу. Вы меня хорошо знаете."

#. ja: さぁ、こちらへ……
#. de: Komm Schätzchen, wir <i>ruhen</i> uns in der Hütte aus.
#. fr: Approchez.
msgctxt "NpcYell:557:0:13"
msgid "You may approach, my kitten."
msgstr "Подойди, моя кисонька."

#. ja: もぅあわてな・い・のっ♪
#. de: Kannst es mal wieder gar nicht erwarten, was, Goldi?
#. fr: Nous avons tout notrrre temps, Monsieur<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:558:0:13"
msgid "There is no need to rush, milord. Thanks to the master, we have <i>all</i> night."
msgstr "Не спешите, милорд. Благодаря господину у нас впереди <i>целая</i> ночь."

#. ja: ハァ……ハァ……
#. de: \<prust>
#. fr: Haah haah...
msgctxt "NpcYell:559:0:13"
msgid "Hehehe heh...heh heheh..."
msgstr "Хе-хе-хе... хе-хе-хе..."

#. ja: ボクだけの子猫ちゃん！
#. de: Mein Kätzchen!
#. fr: Elle est à moi !
msgctxt "NpcYell:560:0:13"
msgid "This rose is mine!"
msgstr "Эта роза моя!"

#. ja: 誰にも……渡すもんか！！
#. de: Niemand nimmt dich mir weg!
#. fr: Personne d'autre ne l'aura !
msgctxt "NpcYell:561:0:13"
msgid "I won't let none have her!"
msgstr "Никому... её не отдам!"

#. ja: 子猫ちゃんはボクだけのモノ！
#. de: Das Kätzchen gehört mir allein!
#. fr: À moi ! À moi ! À moi !
msgctxt "NpcYell:562:0:13"
msgid "Mine! Mine! Mine! Mine!"
msgstr "Моя! Моя! Моя! Моя!"

#. ja: 我らが大業を、邪魔させんぞ！
#. de: Niemand pfuscht uns ins Handwerk!
#. fr: Qui ose troubler notre rite !?
msgctxt "NpcYell:563:0:13"
msgid "Who dares disrupt the rite!?"
msgstr "Кто посмел нарушить обряд?!"

#. ja: 貴様も生贄として捧げてくれるわ！
#. de: Auch du wirst als Opfer enden!
#. fr: Vous allez être sacrifiés<nbsp>!
msgctxt "NpcYell:564:0:13"
msgid "I smell fresh blood!"
msgstr "Чую свежую кровь!"

#. ja: 愚か者どもめッ！<br>我らを止められはせんぞッ！
#. de: Jämmerlicher Narr! Niemand hält uns auf!
#. fr: Comment osez-vous tenter de nous arrêter<nbsp>?
msgctxt "NpcYell:565:0:13"
msgid "The master will be pleased!"
msgstr "Хозяин будет доволен!"

#. ja: 覚悟しやがれっ
#. de: Sieh dem Tod ins Gesicht!
#. fr: C'est l'heure de bouter<nbsp>!
msgctxt "NpcYell:566:0:13"
msgid "Ye'll regret comin' 'ere!"
msgstr "Пожалеешь, что сунулся сюда!"

#. ja: 邪魔だ、うせろっ！
#. de: Aus dem Weg, du Schuft!
#. fr: Dégagez de là<nbsp>!
msgctxt "NpcYell:567:0:13"
msgid "Off our land, ye foul shite!"
msgstr "Убирайтесь с нашей земли, мерзавцы!"

#. ja: 死守する！
#. de: Kapitulation steht nicht zur Debatte!
#. fr: Pas question de se rendre<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:568:0:13"
msgid "The mill is <i>ours</i>!"
msgstr "Мельница <i>наша</i>!"

#. ja: これでも食らえ！
#. de: Nimm das!
#. fr: Pas de bras, pas de combat<nbsp>!
msgctxt "NpcYell:569:0:13"
msgid "How's about some steel fer supper!?"
msgstr "Ну-ка, попробуй стали на ужин!"

#. ja: うちらの場所だ！
#. de: Dies ist unser Revier!
#. fr: Cet endroit est à nous<nbsp>!
msgctxt "NpcYell:570:0:13"
msgid "Come an' get me!"
msgstr "А ну, попробуй меня достань!"

#. ja: 海賊を舐めんな！
#. de: Mit Piraten ist nicht zu spaßen!
#. fr: On n'est pas des chiffes molles, nous<nbsp>!
msgctxt "NpcYell:571:0:13"
msgid "Don't forget, we's pirates!"
msgstr "Не забывай, мы пираты!"

#. ja: ……うふふふ♪
#. de: Hehe ♪
#. fr: Hi hi hi<nbsp>! Ça va trancher sec<nbsp>!♪
msgctxt "NpcYell:572:0:13"
msgid "Hah hah hah hah!"
msgstr "Ха-ха-ха-ха!"

#. ja: 悪い子には、お仕置きを♪
#. de: Böse Kinder bekommen den Hintern versohlt ♪
#. fr: J'aime punir les gens pas sages<nbsp>!♪
msgctxt "NpcYell:573:0:13"
msgid "Die! Captain's orders!"
msgstr "Сдохни! Таков приказ капитана!"

#. ja: ぶった斬って、ぶった斬る♪
#. de: Schnipp, schnapp, Schädel ab ♪
#. fr: Et je tranche, tranche, tranche<nbsp>!♪
msgctxt "NpcYell:574:0:13"
msgid "A knife to the gut'll serve ye fine."
msgstr "Нож в живот — и дело с концом."

#. ja: 仕方ないわね……♪
#. de: Du hast es so gewollt ♪
#. fr: Tu me laisses pas le choix<nbsp>!♪
msgctxt "NpcYell:575:0:13"
msgid "This'll hurt you more than it does me!"
msgstr "Сам напросился!"

#. ja: まだ死ぬのは早いわよ♪
#. de: Ich geb den Löffel bestimmt noch nicht ab ♪
#. fr: J'suis trop belle pour mourir<nbsp>!♪
msgctxt "NpcYell:576:0:13"
msgid "I'll drag ye down to the abyss meself!"
msgstr "Я сама утащу тебя на дно!"

#. ja: 売り飛ばされる！
#. de: Die wollen uns versklaven!
#. fr: Laissez-moi partir ! Vous aurez le double de ce qu'ils offrent<nbsp>!
msgctxt "NpcYell:577:0:13"
msgid "Let me go! I'll pay double what the lizardmen are offering!"
msgstr "Отпустите! Я заплачу вдвое больше ящеролюдей!"

#. ja: 生きて帰れる！ありがとう！
#. de: Hätte nicht gedacht, dass ich mein Zuhause noch mal wiedersehe. Vielen Dank!
#. fr: La liberté n'a jamais été aussi douce !
msgctxt "NpcYell:578:0:13"
msgid "Freedom never tasted so sweet!"
msgstr "Свобода слаще мёда!"

#. ja: もっと早く助けに来いよぉ…！
#. de: Noch mehr Zeit hättet ihr euch nicht lassen können, was?
#. fr: Vous en avez mis, du temps...
msgctxt "NpcYell:579:0:13"
msgid "Took you long enough..."
msgstr "Долго же вы собирались..."

#. ja: し、死ぬかと思った…
#. de: Hatte innerlich schon meinen Frieden mit der Welt geschlossen.
#. fr: Je pensais ne jamais plus revoir Le Viaduc.
msgctxt "NpcYell:580:0:13"
msgid "I thought I'd never see Highbridge again."
msgstr "Я думал, больше никогда не увижу Высокий мост."

#. ja: おいおいおいおい！
#. de: H-He!
#. fr: Personne ne me traite de mauviette<nbsp>!
msgctxt "NpcYell:581:0:13"
msgid "What in the blary 'ells is that!?"
msgstr "Какого хрена тут творится?!"

#. ja: 何だコレ、聞いてねぇぞ！？
#. de: Davon war nicht die Rede!
#. fr: Qu'est-ce que ça veut dire<nbsp>!?
msgctxt "NpcYell:582:0:13"
msgid "Grab yer steel! The mill's under attack!"
msgstr "Хватай железо! На мельницу напали!"

#. ja: 食料が狙われてるぞー！！
#. de: Die haben's auf unseren Proviant abgesehen!
#. fr: Pas touche à notre bouffe<nbsp>!
msgctxt "NpcYell:583:0:13"
msgid "Keep the damn things off the 'ampers!"
msgstr "Не подпускайте этих проклятых тварей к нашим припасам!"

#. ja: コボルド族が攻めてきたっ！
#. de: Ein Kobold-Angriff!
#. fr: Les Kobolds attaquent<nbsp>!
msgctxt "NpcYell:584:0:13"
msgid "Kobolds! Gut the mecky cave dogs!"
msgstr "Кобольды! Выпотрошите этих пещерных дворняг!"

#. ja: 大物のクァールだ！
#. de: Eine Riesen-Coeurl!
#. fr: Un coeurl gros comme ça<nbsp>!
msgctxt "NpcYell:585:0:13"
msgid "First rats, then kobolds, now coeurls!? What's next? Aurochs!?"
msgstr "Сначала крысы, потом кобольды, теперь курлы?! Что дальше? Аурохи?!"

#. ja: 村が踏みつぶされちまう！
#. de: Unser Dorf wird plattgetrampelt!
#. fr: On va se faire piétiner<nbsp>!
msgctxt "NpcYell:586:0:13"
msgid "Thal's bulls!"
msgstr "Быки Тала!"

#. ja: くっそ、休みなしかよ！
#. de: Hört das denn niemals auf?
#. fr: Rah, pas l'temps de souffler<nbsp>!
msgctxt "NpcYell:587:0:13"
msgid "No rest fer an honest pirate, eh?"
msgstr "Честному пирату и передохнуть некогда, да?"

#. ja: 何なの、まったく！！
#. de: Warum nur?!
#. fr: On en a gros<nbsp>!
msgctxt "NpcYell:588:0:13"
msgid "Curse the Twelve!"
msgstr "Прокляни их, Двенадцать!"

#. ja: 貴重な食いもんを！？
#. de: Unsere wertvollen Vorräte!
#. fr: Pas touche à nos vivres, sales bêtes<nbsp>!
msgctxt "NpcYell:589:0:13"
msgid "Wivout that grain, we'll starve like...rats!"
msgstr "Без этого зерна мы сдохнем с голоду, как... крысы!"

#. ja: コボルド族……数が多い！
#. de: Kobolde ... So viele!
#. fr: Des Kobolds<nbsp>! Il en sort de partout<nbsp>!
msgctxt "NpcYell:590:0:13"
msgid "There be too godsdamned many of 'em!"
msgstr "Их же тут проклятая прорва!"

#. ja: 勝手なマネは許さない！
#. de: Das lass ich nicht zu!
#. fr: On ne se laissera pas faire<nbsp>!
msgctxt "NpcYell:591:0:13"
msgid "Go piss on some other tree!"
msgstr "Идите гадьте под другое дерево!"

#. ja: 何アレ！？
#. de: W-Was ist das für ein Ungetüm!
#. fr: C'est quoi, ça<nbsp>?
msgctxt "NpcYell:592:0:13"
msgid "Nobody said aught about aurochs!"
msgstr "Никто не говорил про аурохов!"

#. ja: 私の出番ね……♪
#. de: Zeit für meinen Auftritt ♪
#. fr: C'est l'heure de trancher<nbsp>!♪
msgctxt "NpcYell:593:0:13"
msgid "I's killed me share o' rats o'er the years. What's a few more?"
msgstr "За эти годы я перебила немало крыс. Что мне ещё парочка?"

#. ja: 腕が鳴るわ……♪
#. de: Ich kann's gar nicht erwarten ♪
#. fr: Tchac tchac tchac<nbsp>!♪
msgctxt "NpcYell:594:0:13"
msgid "The bigger they come, the more there be to kill!"
msgstr "Чем они крупнее, тем больше мяса для убийства!"

#. ja: ぶるぶる、かくれるっちゃ！
#. de: Uiuiui, verstecken schnell ...
#. fr: Qiqirn peur, se cacher<nbsp>!
msgctxt "NpcYell:595:0:13"
msgid "Monsters seeing! Qiqirn fleeing!"
msgstr "Монстры видят! Кикирн бежит!"

#. ja: む、この臭い……まさか……
#. de: Dieser Gestank ... Das werden doch wohl nicht ...!
#. fr: Cette puanteur semble familière<nbsp>!
msgctxt "NpcYell:596:0:13"
msgid "This stench! It could only be..."
msgstr "Этот запах! Тут может быть только..."

#. ja: くっキキルンめ、また来たか！
#. de: Schon wieder diese verdammten Qiqirn!
#. fr: Des Qiqirns ! Ils approchent<nbsp>!
msgctxt "NpcYell:597:0:13"
msgid "Qiqirn! A whole pack heads this way as we speak!"
msgstr "Кикирны! Целая стая уже идёт сюда!"

#. ja: みんな、追い払ってくれ！！
#. de: Alle Mann auf sie! Vertreibt die Biester!
#. fr: Aux armes ! Il faut défendre la tour !
msgctxt "NpcYell:598:0:13"
msgid "To arms, men! We must defend the tower!"
msgstr "К оружию! Надо защитить башню!"

#. ja: ふぅ～やっと帰ったか……
#. de: Endlich, das wurde aber auch Zeit.
#. fr: Ça devrait les tenir à l'écart<nbsp>!
msgctxt "NpcYell:599:0:13"
msgid "That should keep them at bay for now."
msgstr "Теперь они пока не сунутся."

#. ja: 次は、もっと痛めつけてやる
#. de: Beim nächsten Mal sind wir nicht so freundlich!
#. fr: Ils reviendront tôt ou tard, cela dit...
msgctxt "NpcYell:600:0:13"
msgid "But where there are ten rats, there are ten score. They'll be back."
msgstr "Но где десять крыс, там и сотня. Они ещё вернутся."

#. ja: お～し、皆お疲れ～！
#. de: Gute Arbeit, Leute!
#. fr: Ça suffit pour aujourd'hui.
msgctxt "NpcYell:601:0:13"
msgid "That's enough for today, lads."
msgstr "На сегодня хватит, ребята."

#. ja: 作戦は無事成功っと
#. de: Die Mission war ein voller Erfolg!
#. fr: Gardons des crapauds à tuer pour demain.
msgctxt "NpcYell:602:0:13"
msgid "There'll be more toads to gut tomorrow."
msgstr "Завтра ещё жаб потрошим."

#. ja: それでは撤収しますか
#. de: Darauf trinken wir einen!
#. fr: Retournons au Dauphin noyé. La première tournée est pour l'Amirale !
msgctxt "NpcYell:603:0:13"
msgid "Now, let us back to the Wench. The first round is on the Admiral!"
msgstr "Ну что, обратно в «Утопленную русалку»? Первый круг за адмиралом!"

#. ja: ふむ……皆、ご苦労さん
#. de: Nicht jeder Kampf kann siegreich sein.
#. fr: Jetons l'éponge<nbsp>!
msgctxt "NpcYell:604:0:13"
msgid "That's enough, lads."
msgstr "Хватит на сегодня, ребята."

#. ja: 目標は達成できず、か……
#. de: Unser Ziel mögen wir diesmal nicht erreicht haben ...
#. fr: Vous n'y mettez pas tout votre cœur<nbsp>!
msgctxt "NpcYell:605:0:13"
msgid "I can see your hearts just aren't in it."
msgstr "Вижу, душой вы сегодня не здесь."

#. ja: 帰って立て直しだな……撤収！
#. de: Aber das ist kein Grund, die Köpfe hängen zu lassen! Euch fehlt einfach etwas Training!
#. fr: Regroupons-nous<nbsp>!
msgctxt "NpcYell:606:0:13"
msgid "Let us back to the Wench. A nice warm ale'll lift your spirits!"
msgstr "Вернёмся в «Утопленную русалку». Глоток тёплого эля поднимет вам настроение!"

#. ja: 陸の上だって負けねえさ
#. de: Ob auf See oder an Land, mit mir nimmt's keiner auf!
#. fr: Sur terre comme sur mer, on assure<nbsp>!
msgctxt "NpcYell:607:0:13"
msgid "Killin' ain't no different on land than it be on the sea."
msgstr "На суше убивать не труднее, чем в море."

#. ja: 海賊の力、思い知ったか！
#. de: Das hat man davon, wenn man sich mit Piraten anlegt!
#. fr: Tu vas voir ce que vaut un pirate<nbsp>!
msgctxt "NpcYell:608:0:13"
msgid "Only pirate what'll give ye quarter's a dead pirate."
msgstr "Пощады от пирата не дождёшься, пока он жив."

#. ja: おとといきやがれ！
#. de: Kommt in zehn Jahren wieder!
#. fr: N'y revenez pas<nbsp>!
msgctxt "NpcYell:609:0:13"
msgid "And don't be comin' back!"
msgstr "И чтоб больше не возвращались!"

#. ja: よしっ、追い払えた！
#. de: Die hätten wir verjagt!
#. fr: Et voilà, débarrassés<nbsp>!
msgctxt "NpcYell:610:0:13"
msgid "Burn the bodies. We don't want 'em foulin' the water!"
msgstr "Сожгите тела. Нечего им воду портить!"

#. ja: 見かけ倒しだったな
#. de: Ein Sieg wie aus dem Lehrbuch!
#. fr: Que de la gueule, rien dans le ventre<nbsp>!
msgctxt "NpcYell:611:0:13"
msgid "We'll be eatin' good tonight!"
msgstr "Сегодня будем пировать!"

#. ja: ウチらの力を見たか！
#. de: Wir sind nun mal unschlagbar!
#. fr: Si nous sommes de sacrés pirates...♪
msgctxt "NpcYell:612:0:13"
msgid "Yo ho ho!"
msgstr "Йо-хо-хо!"

#. ja: ふん、ざまぁみやがれ！
#. de: Ein verdienter Sieg!
#. fr: Allez voir là-bas si j'y suis<nbsp>!
msgctxt "NpcYell:613:0:13"
msgid "Today we fought! Tonight, we drink!"
msgstr "Сегодня дрались, вечером выпьем!"

#. ja: 海賊を甘く見んじゃないよ！
#. de: Unterschätze niemals einen Piraten!
#. fr: Sur vos crânes, ça fait crac<nbsp>!
msgctxt "NpcYell:614:0:13"
msgid "\\<spit>"
msgstr "\\<spit>"

#. ja: 二度と来るんじゃないよ！
#. de: Lasst euch hier nie wieder blicken!
#. fr: Qu'on vous revoie pas par ici<nbsp>!
msgctxt "NpcYell:615:0:13"
msgid "Start skinnin' the dead! I need somethin' to wipe me arse!"
msgstr "Живо обдирайте трупы! Мне нужно чем-то задницу вытереть!"

#. ja: あ～、いい運動だったね！
#. de: Genau das hab ich heute gebraucht!
#. fr: Hé hé, c'était un bon échauf<shy>fe<shy>ment<nbsp>!
msgctxt "NpcYell:616:0:13"
msgid "I'll see each an' every one of ye in the seventh hell!"
msgstr "Ещё увидимся в седьмом круге ада!"

#. ja: まだ、斬りたりない……
#. de: Och, ich hätte noch stundenlang weitermachen können.
#. fr: J'en aurais bien tranché encore un peu...
msgctxt "NpcYell:617:0:13"
msgid "If a pirate cannot gut a blary rat, she ain't worth 'er weight in salt."
msgstr "Если пират не может вспороть брюхо вшивой крысе, грош ему цена."

#. ja: 出直してきな♪
#. de: Kommt zurück, wenn ihr euch traut ♪
#. fr: Venez vite, je vous attends.♪
msgctxt "NpcYell:618:0:13"
msgid "Tell yer Titan I sends me regards!"
msgstr "Передавай Титану привет от меня!"

#. ja: ん～、いい憂さ晴らしになったわ♪
#. de: Das war eine prima Ablenkung ♪
#. fr: Pas mal, c'était sympa.♪
msgctxt "NpcYell:619:0:13"
msgid "Ye'll ne'er see naught as that on the seas, me lads!"
msgstr "Такого, ребята, в море не увидишь!"

#. ja: クソッ、めちゃくちゃだ……
#. de: Verdammt, alles verwüstet ...
#. fr: Je comprends pas...
msgctxt "NpcYell:620:0:13"
msgid "I should've stayed on the sea."
msgstr "Надо было оставаться в море."

#. ja: なんてザマだ……
#. de: Wie schrecklich ...
#. fr: Pourtant, j'ai pas fait une concession...
msgctxt "NpcYell:621:0:13"
msgid "Failures as pirates, failures as millers, failures as fighters..."
msgstr "Ни пираты из них, ни мельники, ни бойцы..."

#. ja: ちくしょう……
#. de: Verfluchter Dreck!
#. fr: Malédiction...
msgctxt "NpcYell:622:0:13"
msgid "Bugger all!"
msgstr "Проклятье!"

#. ja: 食い物が……
#. de: Unsere Vorräte ...!
#. fr: Non<nbsp>! Nos vivres<nbsp>!!
msgctxt "NpcYell:623:0:13"
msgid "Now what'll we eat...?"
msgstr "И что теперь есть?.."

#. ja: モグラどもめ……
#. de: Verdammte Wühler!
#. fr: Saletés de taupes<nbsp>!
msgctxt "NpcYell:624:0:13"
msgid "They was jus' toyin' wiv us."
msgstr "Они просто играли с нами."

#. ja: すっかり荒らされちまった……
#. de: Ein schwarzer Tag ...
#. fr: Tout est fichu<nbsp>!
msgctxt "NpcYell:625:0:13"
msgid "The mill... She's ruined...again..."
msgstr "Мельница... Опять разнесли..."

#. ja: みんな……
#. de: Wir Ärmsten!
#. fr: Mes amis...
msgctxt "NpcYell:626:0:13"
msgid "Let's not forget the fallen..."
msgstr "Не забудем павших..."

#. ja: あぁ……
#. de: Oh weh ...
#. fr: J'ai échoué...
msgctxt "NpcYell:627:0:13"
msgid "\\<cough>"
msgstr "\\<cough>"

#. ja: もっと力があれば……
#. de: Wäre ich doch nur etwas stärker ...
#. fr: Si seulement j'étais plus forte...
msgctxt "NpcYell:628:0:13"
msgid "I'll need to seal up this wound afore it festers."
msgstr "Надо перевязать рану, пока не загноилась."

#. ja: ボロボロよ……
#. de: Was? Gescheitert ...?
#. fr: Tout est fini...
msgctxt "NpcYell:629:0:13"
msgid "Damn this place to the seventh hell!"
msgstr "Чтоб это место провалилось в седьмой круг ада!"

#. ja: やっと行ってくれた……
#. de: Endlich ist diese schreckliche Bestie fort.
#. fr: Ils sont enfin partis...
msgctxt "NpcYell:630:0:13"
msgid "I've 'ad enough. A pirate needs 'er a ship, not a mecky mill."
msgstr "С меня хватит. Пирату нужен корабль, а не какая-то дрянная мельница."

#. ja: やだ、腕が鈍ったの……？
#. de: Sonst verspeis ich die doch zum Frühstück ...
#. fr: Mais qu'est-ce qu'il m'arrive<nbsp>!?
msgctxt "NpcYell:631:0:13"
msgid "A little rust on the sword arm..."
msgstr "Рука-то, похоже, отвыкла от меча..."

#. ja: 海とは勝手が違うわね……
#. de: Auf See wären wir nicht so untergegangen.
#. fr: La terre me porte malchance<nbsp>!
msgctxt "NpcYell:632:0:13"
msgid "'Aven't yet rightened me land legs, I reckon."
msgstr "На суше всё как-то иначе..."

#. ja: ここは渡さない、うふふ……♪
#. de: Unser Dorf bekommt ihr nicht!
#. fr: Vous ne passerez pas.♪
msgctxt "NpcYell:633:0:13"
msgid "Ye've a whole blary mountain to muck about on. Leave us be!"
msgstr "Не отдадим вам это место, хи-хи...♪"

#. ja: 山～は　ワレら～のもの！！
#. de: Die Berge unser Zuhause sein!
#. fr: La montagne est à nous<nbsp>! À nous<nbsp>!
msgctxt "NpcYell:634:0:13"
msgid "O'Ghomoro is ours! All ours! Cast off, overdwellers! Cast off!"
msgstr "Гора Гоморо наша! Вся наша! Убирайтесь, чужаки! Убирайтесь!"

#. ja: 目ざわり……消えて♪
#. de: Schändliche Wesen, verschwindet!
#. fr: Hors de ma vue.♪
msgctxt "NpcYell:635:0:13"
msgid "Yer neck is hanging by a thread, lad."
msgstr "Твоя шея на волоске, парень."

#. ja: 消え～るは　オマ～エだ！！
#. de: Du verschwinden, schon sehen wirst!
#. fr: Tu vas disparaître, oui, disparaître<nbsp>!
msgctxt "NpcYell:636:0:13"
msgid "Titan will not suffer you on His mountain! Cast off! Cast off!"
msgstr "Это ты исчезнешь! Ещё увидишь!"

#. ja: ヒト～は　でて～け！
#. de: Stinkende Piraten abhauen!
#. fr: Hors d'ici, sales humains<nbsp>!
msgctxt "NpcYell:637:0:13"
msgid "Cast off! Cast off!"
msgstr "Прочь! Прочь!"

#. ja: 大地～に　埋めて　や～る
#. de: Begraben wir euch, ja! Alle!
#. fr: On va l'enterrer, oui<nbsp>!
msgctxt "NpcYell:638:0:13"
msgid "The rocks will crush you! The mountain will shun you!"
msgstr "Землёй вас засыплем!"

#. ja: タイタンさ～ま　おたす～け……
#. de: Großer Titan, helfen!
#. fr: Ô Titan<nbsp>! Aidez-nous, aidez-nous<nbsp>!
msgctxt "NpcYell:639:0:13"
msgid "Titan! Save uuuuuusss!"
msgstr "Титан... спаси нас!.."

#. ja: では、リトルアラミゴまで頼む
#. de: Also dann, auf nach Klein-Ala Mhigo!
#. fr: Allons-y. Vite, mais dans le calme.
msgctxt "NpcYell:640:0:13"
msgid "Come, then! Quickly, yet quietly."
msgstr "Ну, пойдёмте. Быстро, но тихо."

#. ja: こんな所で、やっていけっか！
#. de: Schöne neue Heimat, ts ...!
#. fr: Notre travail n'a servi à rien...
msgctxt "NpcYell:641:0:13"
msgid "Mills is fer millers. Do I look like a mecky miller!?"
msgstr "Мельницы для мельников. Я что, похож на мельника?!"

#. ja: また復興が遠のいた……
#. de: Der Wieder<shy>aufbau wird noch lange dauern.
#. fr: On repart de zéro...
msgctxt "NpcYell:642:0:13"
msgid "The Eighth Umbral Era'll be upon us afore this mill's repaired..."
msgstr "Пока починим мельницу, уже Восьмая умбральная эра настанет..."

#. ja: くそったれっ……
#. de: Was für ein Drecksloch!
#. fr: Malédiction...
msgctxt "NpcYell:643:0:13"
msgid "Thal's balls!"
msgstr "Яйца Тала!"

#. ja: こんな場所、うんざり……
#. de: Ich hab schon jetzt genug von diesem Ort.
#. fr: J'en ai marre de ce trou<nbsp>!
msgctxt "NpcYell:644:0:13"
msgid "I'm done. Done wiv it all!"
msgstr "С меня хватит. Хватит всего!"

#. ja: 復興が振り出しにもどったな
#. de: All unsere Bemühungen zerstört ...
#. fr: Nos efforts sont réduits à néant...
msgctxt "NpcYell:645:0:13"
msgid "What I wouldn't give for a breath o' sweet salt air..."
msgstr "Вот бы вдохнуть морского солёного воздуха..."

#. ja: やっぱ海に戻りたい……
#. de: Ich will zurück aufs Meer.
#. fr: J'veux retourner en mer<nbsp>!
msgctxt "NpcYell:646:0:13"
msgid "Bugger this damn place!"
msgstr "Хочу обратно в море..."

#. ja: いやいや、お見事です……
#. de: Ausgezeichnet, ausgezeichnet!
#. fr: C'était magnifique !
msgctxt "NpcYell:647:0:13"
msgid "Now that was a thing o' beauty!"
msgstr "Вот это было красиво!"

#. ja: ありがとうございました
#. de: Recht herzlichen Dank!
#. fr: Dites-moi, ça vous a fait quoi de donner une bonne leçon à ces monstres ?
msgctxt "NpcYell:648:0:13"
msgid "Tell me, how did it feel to whack them beasties good?"
msgstr "Скажи, каково было хорошенько отделать этих чудищ?"

#. ja: これで被害も減ります
#. de: Das wird nicht nur die Chocobos freuen.
#. fr: Oh, si seulement j'avais quelques années de moins.
msgctxt "NpcYell:649:0:13"
msgid "Oh, if only I were still young."
msgstr "Эх, если бы я ещё был молодым."

#. ja: また助けてください！
#. de: Solch tatkräftige Unterstützung können wir auch in Zukunft gebrauchen!
#. fr: Après tout je suis encore jeune ! Peut-être que je serai de la partie, la prochaine fois !
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:650:0:13"
msgid "Hells, I <i>am</i> still young! Might be next time I join ye!"
msgstr "Да я <i>ещё</i> молод! Может, в следующий раз и сам с вами пойду!"

#. ja: 逃げられちゃいましたね……
#. de: Einige der Mulle sind leider entkommen.
#. fr: Maudites créatures !
msgctxt "NpcYell:651:0:13"
msgid "Slippery bastards!"
msgstr "Ускользнули, гады!"

#. ja: とはいえご協力に感謝します
#. de: Aber deine Hilfs<shy>bereit<shy>schaft sei dir trotzdem hoch angerechnet.
#. fr: Dommage qu'on n'ait pas pu toutes les massacrer.
msgctxt "NpcYell:652:0:13"
msgid "'Tis a shame we couldn't thwack 'em all."
msgstr "Жаль, что всех не перебили."

#. ja: でも、すぐ奴らが来るでしょう
#. de: Vermutlich kommen die Wühler schon bald wieder.
#. fr: Mais elles reviendront. J'attendrai patiemment.
msgctxt "NpcYell:653:0:13"
msgid "But they'll be back, and I'll be waitin'."
msgstr "Но они ещё вернутся, а я буду ждать."

#. ja: また助けてください
#. de: Wenn du Lust auf eine Revanche hast, findest du mich hier.
#. fr: Enfin, j'attendrai que vous m'aidiez encore, oui. Hé hé hé !
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:654:0:13"
msgid "Waitin' fer <i>you</i> to help again, that is. Gah hah hah hah!"
msgstr "Буду ждать, когда <i>вы</i> снова придёте на помощь. Га-га-га-га!"

#. ja: よかった、これで一安心だ
#. de: Wunderbar! Jetzt kann ich hier wieder unbesorgt meine Rute auswerfen!
#. fr: Maintenant, je vais peut-être pouvoir pêcher tranquille.
msgctxt "NpcYell:655:0:13"
msgid "Now it may be I can fish 'ere in peace, like."
msgstr "Теперь, может, и порыбачу здесь спокойно."

#. ja: ありがとう、みなさん！！
#. de: Vielen Dank!
#. fr: Ma jambe ? Tout ira bien. Je vais la tremper un instant dans l'eau.
msgctxt "NpcYell:656:0:13"
msgid "Me leg? It'll be fine. I'll just dip 'er in the river a spell."
msgstr "Нога? Да ничего, всё будет хорошо. Просто подержу её немного в речке."

#. ja: ……？
#. de: Hm?!
#. fr: Chuuut... le désert parrrle...
msgctxt "NpcYell:657:0:13"
msgid "Shhh... The desert speaks..."
msgstr "Тсс... Пустыня говорит..."

#. ja: …………なっ！？
#. de: Das ...!
#. fr: Non...<nbsp>!
msgctxt "NpcYell:658:0:13"
msgid "No..."
msgstr "Нет..."

#. ja: うわああああああ！！！
#. de: Hiiilfeeeeee!
#. fr: Mes sœurrrs ! Les vers ! Ils se rassemblent !
msgctxt "NpcYell:659:0:13"
msgid "Sisters! The worms! They gather!"
msgstr "Сёстры! Черви! Они собираются!"

#. ja: はぁ……はぁ……<br>ウ族の名を穢させはしない！
#. de: Ich muss mich ... am Riemen reißen! Die Ehre des Drakon-Stamms steht auf dem Spiel!
#. fr: La tribu des U a encore prrrouvé sa valeur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:660:0:13"
msgid "\\<pant> \\<pant><br>Our tribe was tested today, yet our strength proven once again."
msgstr "\\<pant> \\<pant><br>Сегодня наше племя подверглось испытанию, но мы снова доказали свою силу."

#. ja: くっ……畜生共め……！！
#. de: Verflucht sollt ihr sein, elende Sandwürmer!
#. fr: Vous aurez votre revanche, mes sœurs disparues... je le jurrre<nbsp>!
msgctxt "NpcYell:661:0:13"
msgid "You will have vengeance, my fallen sisters... I swear it!"
msgstr "Вы отомщены будете, павшие сёстры... Клянусь!"

#. ja: あぁぁ、もうダメだぁ……
#. de: Ein weiteres Fanggebiet, das wir abschreiben können ...
#. fr: Encore un point de pêche fichu à cause de ces horreurs<nbsp>!
msgctxt "NpcYell:662:0:13"
msgid "Another hole lost to the bloody hells-spawn."
msgstr "Ещё одно рыбное место пропало из-за этих проклятых отродий ада."

#. ja: 漁師ギルドに報告しなきゃ
#. de: Ein herber Schlag für die Fischergilde.
#. fr: Le maître ne va pas apprécier du tout...
msgctxt "NpcYell:663:0:13"
msgid "The guildmaster won't like that one bit..."
msgstr "Мастеру гильдии это совсем не понравится..."

#. ja: これより、魔物を討伐する！
#. de: Start frei für Operation „Freie Felder“!
#. fr: Des bêtes sauvages se sont installées dans ces champs.
msgctxt "NpcYell:664:0:13"
msgid "Wild beasts have made these fields their home."
msgstr "Дикие звери обжили эти поля."

#. ja: 総員、攻撃開始！！
#. de: Jetzt wird aufgeräumt, Männer!
#. fr: Il est temps de récupérer ce qui nous appartient<nbsp>!
msgctxt "NpcYell:665:0:13"
msgid "Now we reclaim what is rightfully ours!"
msgstr "Теперь мы вернём то, что по праву принадлежит нам!"

#. ja: 今日もがんばるぞーっと……
#. de: Heute wird ein guter Tag, ich hab's im Gefühl!
#. fr: Encore une jourrrnée paisible à Quartpierre.
msgctxt "NpcYell:666:0:13"
msgid "Another quiet day in Quarterstone."
msgstr "Ещё один тихий денёк в Четвертном камне."

#. ja: ん？　なんだ、あいつら……？
#. de: Hm? Da ist doch wer?
#. fr: Enfin, j'espèrrre...
msgctxt "NpcYell:667:0:13"
msgid "Or is it...?"
msgstr "Или... нет?"

#. ja: 海賊だ、総員、食い止めろ！
#. de: Au Backe, Piraten! Die müssen aufgehalten werden!
#. fr: Des pirrrates ! Soldats du Maelstrom, en garde !
msgctxt "NpcYell:668:0:13"
msgid "Pirates! Storm soldiers, make ready!"
msgstr "Пираты! Солдаты Натиска, приготовиться!"

#. ja: やつらサハギン族の手下だっ！
#. de: Die sind im Auftrag der Sahagin hier!
#. fr: Attendez... Ce sont les pillards du serpent !
msgctxt "NpcYell:669:0:13"
msgid "Wait... Those are Serpent Reavers!"
msgstr "Погодите... Это же налётчики из Змеиного языка!"

#. ja: よし、任務完了！
#. de: Mission erfüllt!
#. fr: Les champs sont dégagés.
msgctxt "NpcYell:670:0:13"
msgid "The fields are clear again."
msgstr "Поля снова чисты."

#. ja: 帰還する、皆ご苦労だった！
#. de: Wir ziehen uns zurück. Gute Arbeit, Leute!
#. fr: Restons sur nos gardes, ces créatures reviendront sûrement.
msgctxt "NpcYell:671:0:13"
msgid "But we must remain vigilant. The stubborn beasts will likely come crawling back."
msgstr "Но не теряем бдительности. Упрямые звери, скорее всего, ещё вернутся."

#. ja: くそっ、作戦失敗か……
#. de: Was für eine Blamage ...
#. fr: Nous avons sous-estimé ces horreurs...
msgctxt "NpcYell:672:0:13"
msgid "We underestimated the beasts, today."
msgstr "Сегодня мы недооценили этих зверей."

#. ja: 撤退して態勢を立て直すぞ！
#. de: Rückzug! Und ab sofort drei Trainingseinheiten extra jeden Tag!
#. fr: Mais ça n'arrivera plus.
msgctxt "NpcYell:673:0:13"
msgid "I won't let that happen again."
msgstr "Больше такого не допущу."

#. ja: うぇへへへ……
#. de: Harharhar!
#. fr: Gnin hin hin<nbsp>!
msgctxt "NpcYell:674:0:13"
msgid "Enter the Whorl!"
msgstr "Вперёд, в Вихрь творения!"

#. ja: ひぃやっはぁ～っ！！
#. de: Wer will noch mal, wer hat noch nicht?
#. fr: Nghaaaahaha ha ha !
msgctxt "NpcYell:675:0:13"
msgid "Nghaaahaha hah hah!"
msgstr "Нга-ха-ха-ха!"

#. ja: フヒヒ……
#. de: Hohohoho!
#. fr: Hé hé hé hé...
msgctxt "NpcYell:676:0:13"
msgid "Heh... Heh heh..."
msgstr "Хе... Хе-хе..."

#. ja: ふしゅるるる……
#. de: Kommt nur, kommt nur!
#. fr: Glou glou slrrrp<nbsp>!
msgctxt "NpcYell:677:0:13"
msgid "\\<gurgle> \\<sputter>"
msgstr "\\<gurgle> \\<sputter>"

#. ja: あはあはあはあはあは……
#. de: Ahahaharrr!
#. fr: Bouahahahahaha<nbsp>!!
msgctxt "NpcYell:678:0:13"
msgid "BWAHAHAHAHA!"
msgstr "БВА-ХА-ХА-ХА!"

#. ja: 水神様のために！
#. de: Einen für die Nixen!
#. fr: Au nom du Dieu des océans<nbsp>!
msgctxt "NpcYell:679:0:13"
msgid "Drown...and be reborn!"
msgstr "Утоните... и возродитесь!"

#. ja: ちっ、こいつら手ごわい！
#. de: Die sind 'ne Nummer zu groß für uns!
#. fr: Votre heure sonnera bientôt !
msgctxt "NpcYell:680:0:13"
msgid "Your time will come, drylanders!"
msgstr "Ваш час ещё придёт, сухопутные!"

#. ja: 退け、退け
#. de: Rückzug, Leute, Rückzug!
#. fr: Vite, à la grotte !
msgctxt "NpcYell:681:0:13"
msgid "Back to the grot!"
msgstr "Назад, в пещеру!"

#. ja: ふん、二度と来るな！
#. de: Wehe, ihr taucht hier noch einmal auf!
#. fr: Leurs yeux... Vous avez vu leurs yeux ?
msgctxt "NpcYell:682:0:13"
msgid "Their eyes... Did you see their eyes?"
msgstr "Их глаза... Вы видели их глаза?"

#. ja: 無事、追い払えた……
#. de: Das ging ja ... gerade noch mal gut.
#. fr: Oui... ces hommes sont morrrts et n'en ont pas conscience.
msgctxt "NpcYell:683:0:13"
msgid "Aye... Those men are dead, and they don't even know it."
msgstr "Да... Те люди мертвы, просто сами об этом ещё не знают."

#. ja: 困った、護衛が足りない……
#. de: Alleine schaff ich das unmöglich ...
#. fr: J'ai bien peurrr de ne pas pouvoir m'en sortir sans aide...
msgctxt "NpcYell:684:0:13"
msgid "I fear I cannot make it alone..."
msgstr "Боюсь, одному мне не справиться..."

#. ja: 何事もなければよいが……
#. de: Hoffentlich bleiben wir unbehelligt.
#. fr: J'espèrrre que la Route occidentale a été sécurisée.
msgctxt "NpcYell:685:0:13"
msgid "I pray the local levy has seen to the Westroad."
msgstr "Надеюсь, местное ополчение позаботилось о Западном тракте."

#. ja: 南防波壁は、まだか……
#. de: Bis zum Süddamm ist es wohl noch ein Stück.
#. fr: Je ne me souvenais pas que le barrage était si loin...
msgctxt "NpcYell:686:0:13"
msgid "I don't remember Tidegate being so far..."
msgstr "Не помню, чтобы до Приливных ворот было так далеко..."

#. ja: 急ぎましょう
#. de: Schnell, die Zeit drängt!
#. fr: Faisons vite<nbsp>!
msgctxt "NpcYell:687:0:13"
msgid "Make haste, adventurer."
msgstr "Поторопитесь, искатель приключений."

#. ja: 障害は排除するっ！
#. de: Keine unnötigen Risiken!
#. fr: Je ne veux pas décevoirrr l'Amirale une nouvelle fois !
msgctxt "NpcYell:688:0:13"
msgid "I shall not disappoint the Admiral again!"
msgstr "Я больше не подведу адмирала!"

#. ja: 必ずや届けてみせるっ！
#. de: Die Lieferung muss den Süddamm unbedingt erreichen.
#. fr: Rrretournez dans les collines !
msgctxt "NpcYell:689:0:13"
msgid "Back to the hills with you!"
msgstr "Убирайтесь обратно в холмы!"

#. ja: ご協力、感謝します！
#. de: Vielen Dank für deine Hilfe!
#. fr: Merrrci pour tout<nbsp>!
msgctxt "NpcYell:690:0:13"
msgid "The Maelstrom thanks you. Till sea swallows all!"
msgstr "Водоворот благодарит вас. До встречи, пока море не поглотило всё!"

#. ja: ナルザル様、俺に加護を……
#. de: Gütiger Nald'thal, bitte schütze mich.
#. fr: Maudit citron !
msgctxt "NpcYell:691:0:13"
msgid "Godsdamned lemons!"
msgstr "Проклятые лимоны!"

#. ja: 離れるなよ、絶対だぞ？
#. de: Lass mich bloß nicht alleine!
#. fr: Ne vous éloignez pas de moi, hein<nbsp>? Ma cheville ne va pas tenir<nbsp>!
msgctxt "NpcYell:692:0:13"
msgid "Do not stray too far from me now. I fear this ankle won't hold much longer."
msgstr "Не отходите далеко, слышите? Боюсь, лодыжка долго не выдержит."

#. ja: 気付かれないといいが
#. de: Hoffentlich bemerkt uns niemand.
#. fr: Si on pouvait passer sans se faire attaquer, ni glisser sur des citrons...
msgctxt "NpcYell:693:0:13"
msgid "You don't see any more creatures do you? And lemons. What of lemons?"
msgstr "Больше тварей не видно, да? А лимоны? Что с лимонами?"

#. ja: ひっ、死ぬぅ！？
#. de: Ah, wir sind geliefert!
#. fr: Argh ! Bon sang ! C'est la fin ! Thal, emporte-moi !
msgctxt "NpcYell:694:0:13"
msgid "Ack! This is it! The end! Thal, take me!"
msgstr "А-а! Всё! Конец! Тал, забери меня!"

#. ja: 膝が、膝がぁ！
#. de: Verdammter Hexenschuss!
#. fr: Pas la cheville !
msgctxt "NpcYell:695:0:13"
msgid "Not the ankle!"
msgstr "Только не лодыжка!"

#. ja: 助かった、お前も無事でな
#. de: So, jetzt erst mal 'ne Massage!
#. fr: Et maintenant, je vais tremper cette cheville dans un bon bain chaud.
msgctxt "NpcYell:696:0:13"
msgid "Now to soak this ankle in a piping hot tub..."
msgstr "Теперь бы отмочить лодыжку в горячей ванне..."

#. ja: 息子のために頑張っちゃうぞ～
#. de: So, dann will ich meinem Sohn mal ein leck'res Fischchen fangen!
#. fr: Un beau jour pour pêcher, ma foi.
msgctxt "NpcYell:697:0:13"
msgid "A fine day for fishin', if I do say so meself."
msgstr "Вот денёк для рыбалки, ничего не скажешь."

#. ja: 今日は大漁の予感！
#. de: Heute ist das Glück mir hold, ganz sicher!
#. fr: Aujourd'hui, je vais faire une belle prise, je le sens<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:698:0:13"
msgid "I'll catch somethin' big today. I can <i>feel</i> it."
msgstr "Сегодня я поймаю что-нибудь крупное. <i>Чую</i> это."

#. ja: おや？　川の様子が……
#. de: Hm? Irgendwas stimmt mit dem Fluss nicht ...
#. fr: Qu'est-ce que c'est ? Il y a quelque chose d'étrange dans l'eau...
msgctxt "NpcYell:699:0:13"
msgid "What's that? Somethin's odd with the water..."
msgstr "Что это? С водой что-то не так..."

#. ja: エ、エフトだーーー！！！
#. de: M-M-Molche!!!
#. fr: Des tritons !
msgctxt "NpcYell:700:0:13"
msgid "Efts!"
msgstr "Эфты!"

#. ja: 誰かー、エフトを倒してくれー
#. de: Irgendjemand muss sich um die Molche kümmern!
#. fr: À l'aide ! Tuez ces tritons<nbsp>!
msgctxt "NpcYell:701:0:13"
msgid "Someone! Anyone! Help!"
msgstr "Кто-нибудь! На помощь!"

#. ja: 息子が楽しみにしてるんだよ～
#. de: Mein Sohn hat sich heute Fischfilet gewünscht!
#. fr: Quand je parlais de belle prise, je ne m'attendais pas à quelque chose d'aussi gros !
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:702:0:13"
msgid "When I said I might catch somethin' big, I never meant <i>this</i> big!"
msgstr "Когда я говорил, что могу поймать что-нибудь крупное, я не думал, что <i>настолько</i> крупное!"

#. ja: ボウズで帰ったら怒られる！
#. de: Wenn ich mit leeren Eimern nach Hause komme, ist das Geplärre groß!
#. fr: Comment vais-je pouvoir pêcher avec ces satanés tritons !?
msgctxt "NpcYell:703:0:13"
msgid "How am I to fish with all these damned efts about!?"
msgstr "Да как тут рыбачить, когда вокруг полно проклятых эфтов?!"

#. ja: 一度、出直すかぁ……
#. de: Ich glaub, für heute hab ich genug.
#. fr: Impossible de pêcher ici avec tous ces cadavres de tritons...
msgctxt "NpcYell:704:0:13"
msgid "I can't fish in that water, what with all them rotting eft corpses..."
msgstr "В этой воде не порыбачишь, пока там гниют трупы эфтов..."

#. ja: すっかり食い荒らされて……
#. de: Oh weh, die Molche haben hier alles leergefressen.
#. fr: Je ferais peut-être mieux de me trouver un autre coin...
msgctxt "NpcYell:705:0:13"
msgid "Might be I need to find me another hole..."
msgstr "Похоже, придётся искать другое местечко..."

#. ja: なんて日だ！
#. de: War wohl doch nicht<br>mein Tag ...
#. fr: Quelle journée...
msgctxt "NpcYell:706:0:13"
msgid "What a day..."
msgstr "Ну и денёк..."

#. ja: 今日はいったいなんて日だ！！
#. de: Fing ja mit den Maden im Müsli schon grandios an ... \<seufz>
#. fr: Oui, quelle journée idéale pour pêcher !
msgctxt "NpcYell:707:0:13"
msgid "What a bloody fine day for fishin'!"
msgstr "Вот это денёк для рыбалки, чтоб его!"

#. ja: 敵陣を陥落すべし！
#. de: Klein-Ala Mhigo wird in Flammen aufgehen!
#. fr: Les unités ennemies, abattez<nbsp>!
msgctxt "NpcYell:708:0:13"
msgid "We shall crush our enemies and revel in their fear as they tremble before us!"
msgstr "Сокрушим врагов и насладимся их страхом, когда они задрожат перед нами!"

#. ja: ゆけ、我がしもべたちよ！
#. de: Kämpft, meine treuen Diener!
#. fr: En avant, créature des flammes !
msgctxt "NpcYell:709:0:13"
msgid "Forward, beasts of flame!"
msgstr "Вперёд, огненные твари!"

#. ja: どうした、敵陣へと進まぬか！
#. de: Warum haltet ihr inne, meine feurigen Freunde?
#. fr: Me défier, tu oses ? En avant, j'ai dit !
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:710:0:13"
msgid "Dare you defy me!? I said <i>forward</i>!"
msgstr "Ты смеешь мне перечить?! Я сказал, <i>вперёд</i>!"

#. ja: しつけが足りぬか……
#. de: War meine Peitsche zu sanft zu euch?
#. fr: Un bon coup de fouet, pour t'apprendre à obéir !
msgctxt "NpcYell:711:0:13"
msgid "Another lash will teach you to obey!"
msgstr "Ещё один удар кнутом — и научитесь слушаться!"

#. ja: やつら聞いておらぬぞ
#. de: Sie wollen einfach nicht folgen!
#. fr: Ces draconides, contre leurs maîtres se rebellent<nbsp>!
msgctxt "NpcYell:712:0:13"
msgid "The drakes, they would set us at naught!"
msgstr "Драконы нас ни во что не ставят!"

#. ja: 仇敵を滅すべし！
#. de: Bringt Verderben über den Feind!
#. fr: Brûle nos ennemis !
msgctxt "NpcYell:713:0:13"
msgid "Inflame our enemies!"
msgstr "Воспламените наших врагов!"

#. ja: 我の命を聞け！
#. de: Wagt es nicht, meine Befehle zu verweigern!
#. fr: Obéis !
msgctxt "NpcYell:714:0:13"
msgid "Obey!"
msgstr "Слушаться!"

#. ja: そこ、小便をするでない！
#. de: Dein Revier kannst du später markieren!
#. fr: Hé<nbsp>! Sur nos provisions, ne te soulage pas<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:715:0:13"
msgid "Commander! The drake... It <i>relieves</i> itself on our supplies!"
msgstr "Командир! Дракон... Он <i>справляет нужду</i> прямо на наши припасы!"

#. ja: 邪魔者なるか……！
#. de: Wie kannst du es wagen?!
#. fr: Nous le payer tu vas<nbsp>!
msgctxt "NpcYell:716:0:13"
msgid "You shall pay for that!"
msgstr "Ты за это заплатишь!"

#. ja: 火を吐くのだ！
#. de: Spuckt Feuer, meine Drakons!
#. fr: Crache ton feu<nbsp>!
msgctxt "NpcYell:717:0:13"
msgid "See them all burn!"
msgstr "Пусть они все сгорят!"

#. ja: 威勢が足りぬ！
#. de: Kämpft voller Hass!
#. fr: Debout, j'ai dit ! Attaque !
msgctxt "NpcYell:718:0:13"
msgid "Rise, I say! Rise and attack!"
msgstr "Поднимайтесь, я сказал! В атаку!"

#. ja: 命を聞けと言っておろう！
#. de: Ihr sollt eurem Herrn folgen, närrische Bestien!
#. fr: Attaque ou je m'occupe de ton cas !
msgctxt "NpcYell:719:0:13"
msgid "Attack, or I'll kill you myself!"
msgstr "Атакуйте, или я сам вас прикончу!"

#. ja: くっ、傲慢なり……
#. de: Stellt euch nicht so dumm an!
#. fr: Notre seigneur va être furieux...
msgctxt "NpcYell:720:0:13"
msgid "Our Lord will not be pleased..."
msgstr "Владыка будет недоволен..."

#. ja: 敵だ、わからぬか！？
#. de: Ihr wisst um die Bedeutung des Wortes Feind, oder?
#. fr: Par là<nbsp>! Tu ne vois pas l'ennemi ?
msgctxt "NpcYell:721:0:13"
msgid "There! Do you not see the enemy!?"
msgstr "Вон там! Неужели не видите врага?!"

#. ja: ええい、扱いづらし！
#. de: Sind diese dummen Dinger denn zu gar nichts zu gebrauchen?
#. fr: Bons à rien, ces draconides sont<nbsp>!
msgctxt "NpcYell:722:0:13"
msgid "Commander! These drakes! They fail us!"
msgstr "Командир! Эти драконы нас подводят!"

#. ja: 餌が欲しくば功を立てよ！
#. de: Ich werde euch die Futterrationen kürzen, wenn ihr so weitermacht!
#. fr: Des résultats, donnez-nous, si vous voulez avoir une auge remplie<nbsp>!
msgctxt "NpcYell:723:0:13"
msgid "These would serve better as meat for our men!"
msgstr "От них было бы больше пользы, если бы они стали мясом для наших солдат!"

#. ja: 失策なり、退却せよ
#. de: Wir sind geschlagen! Rückzug!
#. fr: Suffit ! Un autre jour, nous continuerons.
msgctxt "NpcYell:724:0:13"
msgid "Enough! We continue another day."
msgstr "Хватит! Продолжим в другой раз."

#. ja: ままならぬ、一時帰還すべし
#. de: Die störrischen Biester wollen nicht folgen! Wir ziehen uns für heute zurück!
#. fr: Perte de temps<nbsp>! Vers Zan'rak, replions-nous<nbsp>!
msgctxt "NpcYell:725:0:13"
msgid "This is futile. Fall back to Zanr'ak!"
msgstr "Всё бесполезно. Отступаем в Занрак!"

#. ja: 近頃は、この辺も危険でしてね
#. de: In letzter Zeit ist es hier nicht mehr sicher.
#. fr: La Route occidentale n'est plus sûre...
msgctxt "NpcYell:726:0:13"
msgid "The Westroad's not safe this far from Limsa."
msgstr "Дорога на запад небезопасна, если отойти так далеко от Лимсы."

#. ja: ほう、海賊の被害が増えてると
#. de: Gerüchte erzählen von Piratenüberfallen.
#. fr: Comment les gens d'ici survivent avec toutes ces créatures qui rôdent<nbsp>?
msgctxt "NpcYell:727:0:13"
msgid "With all this danger lurking in the shadows, how do people even survive out here?"
msgstr "С такими опасностями на каждом шагу как люди вообще здесь выживают?"

#. ja: おひとりにはできませんよ
#. de: Ganz genau. Alleine solltet Ihr hier nicht reisen.
#. fr: Ils ne survivent pas.
msgctxt "NpcYell:728:0:13"
msgid "They don't."
msgstr "Никак."

#. ja: ははは、心配症ですなぁ
#. de: Eure Fürsorge ehrt Euch, doch was sollte ein einfacher Händler wie ich zu befürchten haben?
#. fr: Ha ha<nbsp>! Humour de casaque jaune<nbsp>?
msgctxt "NpcYell:729:0:13"
msgid "Ah hah hah hah hah! Yellowjacket humor, no doubt."
msgstr "Ах-ха-ха-ха! Шутки Желтоплащников, не иначе."

#. ja: ……杞憂ならいいんですがね
#. de: Unterschätzt die Grausamkeit derer nicht, die die Hoffnung verloren haben.
#. fr: J'essayais pas d'être drôle...
msgctxt "NpcYell:730:0:13"
msgid "No."
msgstr "Нет."

#. ja: いくぞッ！
#. de: Für Garlemald!
#. fr: À l'attaque !
msgctxt "NpcYell:731:0:13"
msgid "Engage!"
msgstr "В атаку!"

#. ja: 帝国に歯向かうか！
#. de: Ehre dem Kaiserreich!
#. fr: Toute résistance est futile !
msgctxt "NpcYell:732:0:13"
msgid "Resistance is futile!"
msgstr "Сопротивление бесполезно!"

#. ja: 駆逐する！
#. de: Verschwinde vom Antlitz dieser Welt!
#. fr: Bientôt, Éorzéa sera à nous !
msgctxt "NpcYell:733:0:13"
msgid "Soon Eorzea will be ours!"
msgstr "Скоро Эорзея будет нашей!"

#. ja: 貴様らごとき！
#. de: Du ...!
#. fr: À genoux devant l'Empire<nbsp>!
msgctxt "NpcYell:734:0:13"
msgid "The weak shall be assimilated!"
msgstr "Слабых поглотит Империя!"

#. ja: くそ、仕事の約束があるのに！
#. de: Verdammt, ich habe dringende Termine!
#. fr: J'ai un rendez-vous<nbsp>! Ce n'est pas le moment de jouer à saute-goret<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:735:0:13"
msgid "How ever will I pass with those...those...<i>things</i> standing there!"
msgstr "Как же мне пройти, если эти... эти... <i>штуки</i> стоят на дороге!"

#. ja: これじゃあ、通れないよ……
#. de: So komme ich nicht zum Bierhafen ...
#. fr: Houste ! Disparaissez !
msgctxt "NpcYell:736:0:13"
msgid "Shoo! Shoo! Away with you!"
msgstr "А ну, брысь! Прочь отсюда!"

#. ja: ありがとう、冒険者さん！
#. de: Hab Dank, Abenteurer<if $gn4>in</if>.
#. fr: Mille mercis.
msgctxt "NpcYell:737:0:13"
msgid "A thousand thanks, good traveler."
msgstr "Тысяча благодарностей, добрый путник."

#. ja: まいったね、通れないよ……
#. de: Verflucht, an Durchkommen ist nicht zu denken!
#. fr: Me voilà bien embêtée...
msgctxt "NpcYell:738:0:13"
msgid "Do I wait, or do I brave the hills...?"
msgstr "И ждать, и через холмы лезть... Что же делать?"

#. ja: 商売の邪魔してくれちゃって！
#. de: Du störst den unbeschränkten Warenverkehr, du ...!
#. fr: Comment veut-on que je gagne ma vie, avec ça<nbsp>?
msgctxt "NpcYell:739:0:13"
msgid "Don't make me have to brave the hills!"
msgstr "Да как мне теперь через холмы пробираться?!"

#. ja: ありがと、助かったわ！
#. de: Du warst mir eine große Hilfe! Danke!
#. fr: Ah<nbsp>! Enfin !
msgctxt "NpcYell:740:0:13"
msgid "Finally!"
msgstr "Наконец-то!"

#. ja: シュコォ……シュコォ……<br>なんぞ　なんぞ　追っ手かい～
#. de: Bsss! Verfolger?
#. fr: Qui c'est qui ose répondre à Wormwix<nbsp>?
msgctxt "NpcYell:741:0:13"
msgid "Pshkoooh! Who is it that backstalks Wormwix!?"
msgstr "Пшшхооо! Кто это крадётся за Вормвиксом?!"

#. ja: ねとねと　呼び出す<br>オイラの僕～
#. de: Bsssim, bsssum, komm, Freund von Goblins!
#. fr: Le livre amène bêtes gluantes pour coller aux fesses<nbsp>!
msgctxt "NpcYell:742:0:13"
msgid "Deathwords bring slimy beasties for bumlicking!"
msgstr "Заклинанье смерти зовёт слизких зверюшек попку лизать!"

#. ja: めらめら　呼び出す<br>オイラの僕～
#. de: Bsssim, bsssam, komm, Freund von Goblins!
#. fr: Le livre amène bêtes de feu pour brûler les fesses<nbsp>!
msgctxt "NpcYell:743:0:13"
msgid "Deathwords bring fiery beasties for bumburning!"
msgstr "Заклинанье смерти зовёт огненных зверюшек попку жечь!"

#. ja: ぶんぶん　呼び出す<br>オイラの僕～
#. de: Bsssim, bsssom, komm, Freund von Goblins!
#. fr: Le livre amène bêtes volantes pour mordre les fesses<nbsp>!
msgctxt "NpcYell:744:0:13"
msgid "Deathwords bring buzzing beasties for bumbiting!"
msgstr "Заклинанье смерти зовёт жужжащих зверюшек попку кусать!"

#. ja: シュコォ……シュコォ……<br>僕も打ち止め　負けそうだ～
#. de: Pssskoh ... pssskoh ... Goblin am Ende ist.
#. fr: Wormwix pense qu'il peut faire des affaires avec aventuri<if $gn4>ère<else>er</if> au grand cœur...
msgctxt "NpcYell:745:0:13"
msgid "Wormwix is thinking about maybe making busydeal with wideheart adventurer..."
msgstr "Вормвикс думает, может, заключить выгодную сделку с добросердечным искателем приключений..."

#. ja: ダラガブ神の前に<br>ひれ伏すがいい！
#. de: Bastard des Lichts! Knie nieder vor dem einzig wahren Gott! Knie nieder vor Dalamud!
#. fr: Hérétiques<nbsp>! À genoux devant Dalamud, le seul vrai Dieu<nbsp>!
msgctxt "NpcYell:746:0:13"
msgid "Bastard of Light! Bow down to the one true god! Bow to Dalamud!"
msgstr "Ублюдок Света! Пади ниц перед единственным истинным богом! Пади перед Даламудом!"

#. ja: 眠れる我が同胞よ、<br>死の淵から甦れ！
#. de: Die Seelen der Jünger Dalamuds schlafen nie!
#. fr: Ô frères de foi<nbsp>! Sortez des profondeurs de l'au-delà<nbsp>!
msgctxt "NpcYell:747:0:13"
msgid "The souls of the Lambs never sleep!"
msgstr "Души Ягнят никогда не спят!"

#. ja: 眠れる同胞よ、<br>我が力となれ！
#. de: Die Seelen der Jünger Dalamuds vergeben nie!
#. fr: Ô frères de foi<nbsp>! Soyez notre force<nbsp>!
msgctxt "NpcYell:748:0:13"
msgid "The souls of the Lambs never forgive!"
msgstr "Души Ягнят никогда не прощают!"

#. ja: 死を振り払い、<br>来たれ、我が同胞よ！
#. de: Die Seelen der Jünger Dalamuds vergessen nie!
#. fr: Ô frères de foi<nbsp>! Chassez la mort<nbsp>!
msgctxt "NpcYell:749:0:13"
msgid "The souls of the Lambs never forget!"
msgstr "Души Ягнят никогда не забывают!"

#. ja: 同胞たちよ……<br>我を見捨てるのか……
#. de: Brüder, Schwestern! Nehmt euch meiner an! Lasst mich hier nicht zurück!
#. fr: Frères de foi<nbsp>! Ne m'abandonnez pas<nbsp>!
msgctxt "NpcYell:750:0:13"
msgid "Brothers! Sisters! Take me to your arms! Do not leave me here!"
msgstr "Братья! Сёстры! Обнимите меня! Не оставляйте меня здесь!"

#. ja: すべては焔神の為に……
#. de: Ich diene dem Herrn des Infernos allein!
#. fr: Le Seigneur des flammes infernales est mon seul maître<nbsp>!
msgctxt "NpcYell:751:0:13"
msgid "I answer only to the Lord of the Inferno!"
msgstr "Я служу лишь Владыке Инферно!"

#. ja: 清き炎が全てを<br>焼き付くさん！
#. de: Das Feuer reinigt alles!
#. fr: Que les flammes purificatrices cautérisent tout<nbsp>!
msgctxt "NpcYell:752:0:13"
msgid "Fire cleanses all!"
msgstr "Огонь очищает всё!"

#. ja: 不浄なる者を滅せよ！<br>清浄なる炎よ！
#. de: Verdorbene Seelen, wohin man schaut! Mögen die Flammen sie läutern!
#. fr: Ton âme est corrompue<nbsp>! Puissent les flammes la purifier<nbsp>!
msgctxt "NpcYell:753:0:13"
msgid "Your soul is rotten! Let the flames purify the corruption!"
msgstr "Твоя душа прогнила! Пусть пламя очистит её от скверны!"

#. ja: 燃え盛れ！<br>炎獄の火炎よ！！
#. de: Brenne! Brenne! Lichterloh!
#. fr: Brûlez<nbsp>! Brûlez dans les flammes infernales<nbsp>!
msgctxt "NpcYell:754:0:13"
msgid "Burn! Burn Buuurrrnnn!"
msgstr "Гори! Гори-и-и!"

#. ja: 我が魂の炎が……<br>燃え尽きるというのか？
#. de: Das Inferno erwartet mich!
#. fr: Est-ce que mon âme aurait brûlé, elle aussi...<nbsp>?
msgctxt "NpcYell:755:0:13"
msgid "The Inferno awaits me!"
msgstr "Инферно ждёт меня!"

#. ja: 穢れた貴方の魂を、<br>死によって浄化しましょう！
#. de: Euren Seelen ist erst dann Rettung gewiss, wenn sie in der Siebten Hölle geschmort haben!
#. fr: Vos âmes seront purifiées par le feu vengeur<nbsp>!
msgctxt "NpcYell:756:0:13"
msgid "Your souls cannot be saved until they have burned in the seventh hell!"
msgstr "Вашим душам не спастись, пока они не сгорят в седьмом аду!"

#. ja: 嗚呼、頼もしきかな！<br>私の死せる弟よ！
#. de: Erhebe dich, mein Bruder, und schreite abermals an meiner Seite!
#. fr: Debout, mon frère, marche encore une fois à mes côtés<nbsp>!
msgctxt "NpcYell:757:0:13"
msgid "Rise, my brother, and walk at my side once again!"
msgstr "Восстань, брат мой, и снова ступай рядом со мной!"

#. ja: 嗚呼、逞しきかな！<br>私の死せる友よ！
#. de: Erhebe dich, meine Schwester, und fordere ein, was uns aus den Händen gerissen ward!
#. fr: Debout, ma sœur, reprends ce qui t'a été dérobé<nbsp>!
msgctxt "NpcYell:758:0:13"
msgid "Rise, my sister, and reclaim what was wrested from your grasp!"
msgstr "Восстань, сестра моя, и верни то, что у нас отняли!"

#. ja: 嗚呼、強きかな！<br>私の死せる父よ！
#. de: Erhebe dich, mein Vater, und stürze dich im Zorn auf unsere Feinde!
#. fr: Debout, mon père, frappe nos ennemis avec fureur<nbsp>!
msgctxt "NpcYell:759:0:13"
msgid "Rise, my father, and strike down our enemies with rage!"
msgstr "Восстань, отец мой, и в ярости сокруши наших врагов!"

#. ja: 皆、死んでいった……<br>そして私も……
#. de: Meine Brüder ... Bald ... werden wir wieder ... vereint sein.
#. fr: Ô ma famille, mes frères... Nous serons... bientôt... réunis...
msgctxt "NpcYell:760:0:13"
msgid "My kin... Soon...we shall be reunited once...again..."
msgstr "Родные мои... Скоро... мы снова... встретимся..."

#. ja: あちしの大っきな羽、<br>美しいでふっち？
#. de: Die Schwingen des Diesigen sollen den Mondigen verhüllen und ewige Nacht bringen!
#. fr: Que pensez-vous de mes ailes<nbsp>?<br>N'est-ce pas qu'elles sont belles<nbsp>?
msgctxt "NpcYell:761:0:13"
msgid "This one's wings shall darken the moon and bring everlasting night!"
msgstr "Крылья Туманного затмят луну и принесут вечную ночь!"

#. ja: あちしのお友達は<br>とっても強いのでふっち！
#. de: Kommt zur Meinigen, oh Blättrige!
#. fr: Mes chers compagnons<br>Sont forts comme des lions<nbsp>!
msgctxt "NpcYell:762:0:13"
msgid "Come hither, arbor pets!"
msgstr "Идите сюда, лесные зверушки!"

#. ja: 羽が大きくなったあちしは<br>負けないのでふっち！
#. de: Der Diesige wird des Spielens müde!
#. fr: Avec mes ailes renforcées<br>Je suis sûre de l'emporter<nbsp>!
msgctxt "NpcYell:763:0:13"
msgid "This one tires of the game!"
msgstr "Игры мне наскучили!"

#. ja: あちしを邪魔する冒険者、<br>死んでしまえでふっち！
#. de: Tod den Sprechenden! Tod den Alligen!
#. fr: Quand les aventuriers jouent les gêneurs<br>Sur eux s'abat le malheur<nbsp>!
msgctxt "NpcYell:764:0:13"
msgid "Death to the spoken! Death to all!"
msgstr "Смерть говорящим! Смерть всем!"

#. ja: ああ、羽が……<br>あちしの羽が……
#. de: Die Flügel der Meinigen ... sind erschlafft ...
#. fr: Brisées, mes ailes...<br>Elles étaient... si belles...
msgctxt "NpcYell:765:0:13"
msgid "Take...these broken wings..."
msgstr "Заберите... эти сломанные крылья..."

#. ja: 見せてもらおうか、<br>冒険者の力とやらを……
#. de: Es war töricht von dir, alleine hier zu erscheinen.
#. fr: Alors, montrez-nous ce que valent les aventuriers<nbsp>!
msgctxt "NpcYell:766:0:13"
msgid "You were foolish to come here alone!"
msgstr "Глупо было приходить сюда в одиночку!"

#. ja: 私の勝ちだな……
#. de: Ich werde siegreich sein!
#. fr: La victoire m'appartient<nbsp>!
msgctxt "NpcYell:767:0:13"
msgid "Victory shall be mine!"
msgstr "Победа будет за мной!"

#. ja: そうそう消えるものではない！
#. de: Glaube nicht, dass du schon gewonnen hast!
#. fr: Je n'ai pas dit mon dernier mot<nbsp>!
msgctxt "NpcYell:768:0:13"
msgid "Do not think you have won just yet!"
msgstr "Не думай, что уже победил!"

#. ja: やるな、冒険者……！
#. de: Vielleicht habe ich dich unterschätzt ...
#. fr: Je t'ai peut-être sous-estimé<if $gn4>e</if>...
msgctxt "NpcYell:769:0:13"
msgid "I may have underestimated you..."
msgstr "Возможно, я тебя недооценил..."

#. ja: まだだ、まだ消えんよ！
#. de: Wir werden uns wiedersehen!
#. fr: Je ne me laisserai pas faire comme ça<nbsp>!
msgctxt "NpcYell:770:0:13"
msgid "You have not seen the last of me!"
msgstr "Ты ещё обо мне услышишь!"

#. ja: ぼくー つよーい<br>返り討ちーに してやーる
#. de: Sehr stark ich bin! Rache ich üben werde!
#. fr: Je suis fort, très fort<nbsp>! Ha ha ha<nbsp>!
msgctxt "NpcYell:771:0:13"
msgid "Thirty-one is come!"
msgstr "Тридцать один пришёл!"

#. ja: おまーえ 錬金術ーで<br>こんなーの つくれーるか？
#. de: Meine Alchemie, sehr mächtig sie ist.
#. fr: Mon alchimie est la meilleure, oui, la meilleure<nbsp>!
msgctxt "NpcYell:772:0:13"
msgid "My alchemies, powerful, they are!"
msgstr "Алхимия моя сильна, очень сильна!"

#. ja: おつぎーは コレーだぞ！
#. de: Die Geheimnisse der Erde, kennen tu ich sie.
#. fr: Je connais les secrets de la terre, oui, je les connais<nbsp>!
msgctxt "NpcYell:773:0:13"
msgid "Know, I do, the secrets of the Land!"
msgstr "Тайны земли я знаю, да, знаю!"

#. ja: とっておきーの<br>つよーい やつだーぞ！
#. de: Gehauen wir sind aus Stein! Zerfallen zu Staub wir werden. So spricht Titan!
#. fr: Attention, il nous reste une corde à notre arc, oui<nbsp>!
msgctxt "NpcYell:774:0:13"
msgid "Hewn, we are, from rock! To dust it is we crumble! So sayeth Titan!"
msgstr "Мы высечены из камня! В пыль рассыплемся. Так глаголет Титан!"

#. ja: ……タイタンさーま、<br>たすーけて……たす……
#. de: Oh Herr der Felsen! Dieser Schmerz! Dieser Schmerz!
#. fr: Ô Titan<nbsp>! Nous avons mal, si mal...
msgctxt "NpcYell:775:0:13"
msgid "O Lord of Crags! The pain! The pain...!"
msgstr "О, Повелитель скал! Больно! Как же больно...!"

#. ja: 真なる神を<br>知らぬ愚か者どもめ！
#. de: Komm! Der einzig wahre Gott erwartet dein Opfer!
#. fr: Viens<nbsp>! Le seul vrai Dieu attend ton sacrifice<nbsp>!
msgctxt "NpcYell:776:0:13"
msgid "Come! The one true god awaits your sacrifice!"
msgstr "Иди! Единственный истинный бог ждёт твою жертву!"

#. ja: ダラガブ神よ、<br>その紅き力を我にッ！
#. de: Oh Dalamud! Läutere diese verlorenen Seelen in purpurnem Schein!
#. fr: Ô Dalamud<nbsp>! Stigmatise ces âmes perdues de ton aura rougeoyante<nbsp>!
msgctxt "NpcYell:777:0:13"
msgid "O Dalamud! Baptize these wayward souls in thy crimson radiance!"
msgstr "О, Даламуд! Окрести эти заблудшие души багряным сиянием своим!"

#. ja: 紅蓮の炎よ、<br>我が敵を焼き尽くせ！
#. de: Lass die blutroten Flammen deine Sünden tilgen!
#. fr: Que ces flammes rouge sang brûlent vos péchés<nbsp>!
msgctxt "NpcYell:778:0:13"
msgid "Let the blood red flames burn away your sins!"
msgstr "Пусть кроваво-красное пламя сожжёт ваши грехи!"

#. ja: 至高の神ダラガブよ！<br>血の代価を今ここにッ！
#. de: Heute Nacht soll der Tribut beglichen werden. In Blut und nichts als Blut!
#. fr: Ô Dalamud<nbsp>! Ce soir, le prix du sang sera payé<nbsp>!
msgctxt "NpcYell:779:0:13"
msgid "Tonight, the blood price shall be paid in full!"
msgstr "Сегодня ночью кровавый долг будет сполна уплачен!"

#. ja: ……我が神よ……<br>私をお見捨てになるのか？
#. de: Mein Herr ... Warum hast du mich ... verlassen?
#. fr: Ô Seigneur... Pourquoi m'avoir... abandonné<nbsp>?
msgctxt "NpcYell:780:0:13"
msgid "My lord... Why hast thou forsaken...me...?"
msgstr "Господь мой... За что ты... оставил меня...?"

#. ja: 気炎万丈！<br>我が炎に敵はなし！
#. de: Niemand widersteht der sengenden Hitze meiner Flammen!
#. fr: À la chaleur de mes flammes, nul ne peut résister<nbsp>!
msgctxt "NpcYell:781:0:13"
msgid "None can stand the searing heat of my flames!"
msgstr "Никто не устоит перед палящим жаром моего пламени!"

#. ja: 電光石火！<br>速攻にて先手を取らん！
#. de: Versuch ruhig, mit meiner Schnelligkeit mitzuhalten, erbärmlicher Wurm!
#. fr: Essaie de faire aussi vite que moi, peau-lisse<nbsp>!
msgctxt "NpcYell:782:0:13"
msgid "Try and match my speed, pathetic smoothskin!"
msgstr "Попробуй угнаться за мной, жалкий гладкокожий!"

#. ja: 雲煙過眼！<br>次なる手を打たん！
#. de: Du hast meine wahren Kräfte längst nicht gesehen!
#. fr: L'étendue de mon pouvoir, tu n'as pas vu<nbsp>!
msgctxt "NpcYell:783:0:13"
msgid "You have not seen the limits of my power!"
msgstr "Ты ещё не видел пределов моей силы!"

#. ja: 怒髪衝天！<br>奥の手を使わん！
#. de: Die Erde wird schmelzen und die See wird brodeln!
#. fr: La terre va fondre<nbsp>! La mer va bouillir<nbsp>!
msgctxt "NpcYell:784:0:13"
msgid "The land will melt and the seas will boil!"
msgstr "Земля расплавится, а моря закипят!"

#. ja: 驚天動地……<br>我が炎が破れるのか？
#. de: Die Flammen! Die flackern auf ... und erlöschen!
#. fr: Les flammes<nbsp>! Elles... vacillent et meurent<nbsp>!
msgctxt "NpcYell:785:0:13"
msgid "The flames! They flicker and...die!"
msgstr "Пламя! Оно меркнет... и гаснет!"

#. ja: ゼゼルン、宴に、<br>行きたいっちゃ！
#. de: Zezerix' Herz ist voller Traurigkeit. Essen ist dort, aber Zezerix hier!
#. fr: Zezeroon avoir l'estomac qui gargouuuille<nbsp>!
msgctxt "NpcYell:786:0:13"
msgid "Zezeroon's heart is filled with sadness. Supper is there, but Zezeroon's here!"
msgstr "Сердце Зезеруна полно печали. Ужин там, а Зезерун здесь!"

#. ja: なんだか、とっても、<br>怖いっちゃ！
#. de: Zezerix' Bauch ist voller Grummeln und Brummeln!
#. fr: Zezeroon avoir peuuur<nbsp>!
msgctxt "NpcYell:787:0:13"
msgid "Zezeroon's belly is filled with rumblings and grumblings!"
msgstr "Живот Зезеруна урчит и бурчит!"

#. ja: ゼゼルン、はらへり<br>ぐーぐーっちゃ！
#. de: Zezerix' Nase riecht lecker Fleisch und lecker Leckerli!
#. fr: Zezeroon sentir bonnes odeurs des miam miam<nbsp>!
msgctxt "NpcYell:788:0:13"
msgid "Zezeroon's nose is filled with the sweet smells of meats and treats!"
msgstr "Нос Зезеруна чует вкусное мясо и лакомства!"

#. ja: ごはん、ごはん、<br>急ぐっちゃ！
#. de: Zezerix' Ohren hören köstliches Knuspern und Knäusern!
#. fr: Les oreilles de Zezeroon entendre la viande qui grille<nbsp>!
msgctxt "NpcYell:789:0:13"
msgid "Zezeroon's ears are filled with the cracklings and sizzlings of supper!"
msgstr "Уши Зезеруна слышат, как шкварчит и шипит ужин!"

#. ja: ゼゼルン、宴で、<br>いただきますっちゃ！
#. de: Zezerix' Herz ist voller Freude! Danke, Abenteurer<if $gn4>in</if>!
#. fr: Le cœur de Zezeroon être plein de joie<nbsp>! Merci<nbsp>!
msgctxt "NpcYell:790:0:13"
msgid "Zezeroon's heart is filled with joy! Thank you, adventurer!"
msgstr "Сердце Зезеруна полно радости! Спасибо, искатель приключений!"

#. ja: ここは、どこなのほでふっち<br>案内してほしいのでふっち
#. de: Die Meinige ist so einsam und allein ...
#. fr: Je suis seul, je me suis égaré<nbsp>!<br>Que quelqu'un vienne me guider<nbsp>!
msgctxt "NpcYell:791:0:13"
msgid "This one is so lost and lonely..."
msgstr "Заблудился я, одиноко мне..."

#. ja: どっちが仮宿なのでふっち？
#. de: Wo nur ist die Zuflucht der Unsrigen?
#. fr: Le refuge est dans quelle direction<nbsp>?<br>Je n'ai pas le sens de l'orientation...
msgctxt "NpcYell:792:0:13"
msgid "Where, oh where is Little Solace?"
msgstr "Где же Малое Утешение?"

#. ja: まだ着かないのでふっち？
#. de: Ist es noch weit?
#. fr: Quand est-ce qu'on arrive<nbsp>?<br>Pardon pour mon impatience excessive...
msgctxt "NpcYell:793:0:13"
msgid "Is Little Solace far?"
msgstr "Далеко ещё до Малого Утешения?"

#. ja: 何か出そう<br>なのほでふっち……
#. de: Die Meinige hätte niemals fortgehen dürfen.
#. fr: J'ai peur qu'on nous attaque<nbsp>!<br>J'en deviens paranoïaque...
msgctxt "NpcYell:794:0:13"
msgid "This one should never have left the camp..."
msgstr "Не стоило мне уходить из лагеря..."

#. ja: 仮宿だふっち！<br>助かったのほでふっち！
#. de: Die Meinige wird die Gütigkeit <if $gn4>der Laufenden<else>des Laufenden</if> niemals vergessen!
#. fr: Enfin nous sommes arrivés<nbsp>!<br>Je ne sais comment vous remercier<nbsp>!
msgctxt "NpcYell:795:0:13"
msgid "This one shall never forget walking one's kindness."
msgstr "Не забуду я доброту того, кто проводил меня."

#. ja: 人気者は辛いクポ。<br>護衛をたのむでクポ！
#. de: Als berühmter Mogry hat man's wahrlich nicht leicht, kupo!
#. fr: Dur, dur, d'être populaire<nbsp>! Escortez-moi, voulez-vous, kupo<nbsp>?
msgctxt "NpcYell:796:0:13"
msgid "Oh, what ever is a moogle to do?"
msgstr "Ох, что же делать бедному муглу?"

#. ja: サインはお断りクポ！
#. de: Ich sagte doch: Keine Autogramme, kupo!
#. fr: J'avais dit “pas d'autographes”, kupo<nbsp>!
msgctxt "NpcYell:797:0:13"
msgid "I thought I said no autographs!"
msgstr "Я же сказал, автографов не давать!"

#. ja: 護衛くん、<br>しっかり頼むクポ！
#. de: Ich sollte einfach wieder unsichtbar werden, kupo! Aber was ist ein Star, den keiner sieht?
#. fr: Je pourrais rester chez moi, mais c'est la solution de facilité, kupo<nbsp>!
msgctxt "NpcYell:798:0:13"
msgid "Why don't I simply choose not to be seen? Pah! Then what sort of celebrity would that make me?"
msgstr "Может, просто не показываться на глаза? Пф! Какая же я тогда знаменитость?"

#. ja: モグは人気者クポ！
#. de: Gucken darfst du, aber anfassen nicht, ist das klar, kupo?
#. fr: Du calme, on touche avec les yeux, mesdames et messieurs<nbsp>!
msgctxt "NpcYell:799:0:13"
msgid "You can all look, but absolutely no touching, kupo!"
msgstr "Смотреть можно, а трогать нельзя, ясно, купо?"

#. ja: 護衛ご苦労だクポ！<br>ところでファンはどこクポ？
#. de: Gut gemacht, sie haben mich nicht in Fetzen gerissen! Nur, wo sind denn jetzt meine ganzen Fans, kupo?
#. fr: Je suis arrivé en un seul morceau, c'est déjà ça. Mais où sont mes fans<nbsp>?
msgctxt "NpcYell:800:0:13"
msgid "I'm still in one piece, I'll give you that, kupo. Now, where is everyone?"
msgstr "Я всё ещё цел, это уж точно, купо. Ну и где все мои поклонники?"

#. ja: 誰か来て来て<br>護衛して？
#. de: Bizzu freundlich<if $gn4>e Großgewachsene<else>r Großwachsener</if> und beschüzzu Guttrix bei Gehen?
#. fr: L'aventuri<if $gn4>ère<else>er</if> va guider Guttrix<nbsp>?
msgctxt "NpcYell:801:0:13"
msgid "Are you wideheart uplander who is giving Guttrix walkpath safety?"
msgstr "Ты сердобольный житель нагорья? Поможешь Гаттриксу безопасно добраться пешком?"

#. ja: 触手ウネウネ<br>だいきらい～
#. de: Wie hält Baumvolk aus mit so viele Kringelranke?
#. fr: Guttrix déteste les sarments et les lianes<nbsp>!
msgctxt "NpcYell:802:0:13"
msgid "How can treelanders stand all these squigglevines and stranglevines?"
msgstr "Как лесные жители терпят все эти извивающиеся лозы и душащие лианы?"

#. ja: ほいほい 進むぞ<br>どこまでも～
#. de: Gehzzu schneller, <if $gn4>Großgewachsene<else>Großwachsener</if>, gehzzu schneller!
#. fr: Plus vite, jambes feignantes, plus vite<nbsp>!
msgctxt "NpcYell:803:0:13"
msgid "With fastness, lazyleg uplander! With fastness!"
msgstr "Живо, живо, коротконогий житель нагорья! Пошевеливайся!"

#. ja: ガットリクスいいゴブリン！
#. de: Guttrix ist beste Goblin mit Warentauschen!
#. fr: Guttrix est le meilleur marchand gobelin<nbsp>!
msgctxt "NpcYell:804:0:13"
msgid "Guttrix is goodliest good gobbie goodsbearer!"
msgstr "Гаттрикс — славный гоблин-торговец!"

#. ja: ほいほい<br>それでは さよ～なら～
#. de: Hazzu Vieledank, <if $gn4>Großgewachsene<else>Großwachsener</if>! Vergizzu nie Gutefreund Guttrix, kho?
#. fr: Merci, merci, merci, aventuri<if $gn4>ère<else>er</if><nbsp>! Ton ami gobelin Guttrix n'oubliera pas<nbsp>!
msgctxt "NpcYell:805:0:13"
msgid "Many, many thanks, uplander! Be not un-remembering your gobbiefriend Guttrix!"
msgstr "Спасибо, спасибо, житель нагорья! Не забывай своего друга-гоблина Гаттрикса!"

#. ja: 入植地までの護衛、<br>しっかり頼むよ！
#. de: Du bist vermutlich von der Aben<shy>teurer<shy>gilde, nicht wahr? Also dann, worauf warten wir?
#. fr: Je suppose que vous venez de la guilde des aventuriers. On se met en rrroute<nbsp>?
msgctxt "NpcYell:811:0:13"
msgid "I assume you're from the Adventurers' Guild. Shall we be off, then?"
msgstr "Полагаю, ты из Гильдии искателей приключений. Ну что, отправляемся?"

#. ja: さあ、行こうじゃないか
#. de: Los, die Zeit drängt. Ich will mir das Getreide nicht von einem anderen Käufer wegschnappen lassen.
#. fr: Allons-y. Je ne voudrais pas rrrater ça en étant en retard<nbsp>!
msgctxt "NpcYell:812:0:13"
msgid "Come now. I wouldn't want to see the crop sold to another buyer on account that I was late in arriving."
msgstr "Ну же, пойдём. Не хватало ещё опоздать и узнать, что зерно продали другому покупателю."

#. ja: しかし、この辺りも物騒になったもんだね
#. de: Diese Gegend ist ein wenig ... unwirtlicher, als ich erwartet hatte.
#. fr: Ce coin est un peu plus... sauvage que je ne le pensais.
msgctxt "NpcYell:813:0:13"
msgid "This area is a tad more...rough than I imagined."
msgstr "Что-то тут как-то... суровее, чем я представлял."

#. ja: どんどん進むよ！
#. de: Wie kann jemand mit all diesen schrecklichen Kreaturen hier bloß durch den Tag kommen, geschweige denn Landwirtschaft betreiben?
#. fr: Comment on peut dormir la nuit avec toutes ces horreurs autour<nbsp>?
msgctxt "NpcYell:814:0:13"
msgid "How can anyone survive the night, let alone run an entire farm with all these terrible creatures about!?"
msgstr "Как тут вообще можно спать по ночам, не то что целую ферму держать, когда кругом такие жуткие твари?!"

#. ja: ふぅ、到着したようだね、<br>助かったよ！
#. de: Das war ... aufregend, um es mal vorsichtig auszudrücken. Ich hoffe, die Lieferung war es wert.
#. fr: C'était... stimulant, je dois dire.
msgctxt "NpcYell:815:0:13"
msgid "That was...thrilling, to say the least. Here's to hoping they deliver."
msgstr "Вот это было... захватывающе, ничего не скажешь. Надеюсь, товар всё-таки доставят."

#. ja: メメルン、おみせに帰るっちゃ<br>護ってほしいっちゃ！
#. de: Freundliche<if $gn4><else>r</if> Abenteurer<if $gn4>in</if> will Memeroon helfen? Das sehr nett sein! Komm, komm, folge Memeroon!
#. fr: Gentil<if $gn4>le</if> aventuuuri<if $gn4>ère<else>er</if> protéger Memeroon<nbsp>?
msgctxt "NpcYell:816:0:13"
msgid "Kind adventurer keeps Memeroon safe? Come, come, then! Keep Memeroon safe, then!"
msgstr "Добрый искатель приключений защитит Мемеруна? Тогда пойдём, пойдём! Защищай Мемеруна!"

#. ja: メメルン、<br>とっても、怖いっちゃ
#. de: Böse Räuber machen armem Memeroon Angst!
#. fr: Méchants bandits faire peur à la pauvre Memeroon<nbsp>!
msgctxt "NpcYell:817:0:13"
msgid "Bad bandits frighten poor Memeroon!"
msgstr "Злые бандиты пугают бедного Мемеруна!"

#. ja: はやく、おみせに<br>帰りたいっちゃ！
#. de: Bitte, bitte, du musst Memeroons Glitzer beschützen!
#. fr: Memeroon vouloir vite rentrer au magasin<nbsp>!
msgctxt "NpcYell:818:0:13"
msgid "Oh, please! Oh, please! Keep Memeroon's sparklies safe!"
msgstr "Ой, пожалуйста! Пожалуйста! Защити блестяшки Мемеруна!"

#. ja: メメルン、<br>戦い苦手っちゃ！
#. de: Memeroon kann nicht kämpfen! Memeroon muss Glitzer beschützen, ja?
#. fr: Memeroon pas pouvoir se battre<nbsp>! Aventuuuri<if $gn4>ère<else>er</if> protéger bling bling<nbsp>!
msgctxt "NpcYell:819:0:13"
msgid "Memeroon cannot be fighting! Must keep sparklies safe!"
msgstr "Мемерун не умеет драться! Надо защитить блестяшки!"

#. ja: ここまで、来れば<br>大丈夫っちゃ！
#. de: Memeroon ist in Sicherheit! Glitzer ist in Sicherheit! Muss Memeroon Glitzer teilen?
#. fr: Memeroon à l'abri<nbsp>! Bling bling à l'abri<nbsp>! Memeroon partager bling bling<nbsp>!?
msgctxt "NpcYell:820:0:13"
msgid "Memeroon is safe! Sparklies are safe! Should Memeroon share sparklies...?"
msgstr "Мемерун в безопасности! Блестяшки в безопасности! Может, Мемеруну поделиться блестяшками?.."

#. ja: 誰か来て来て<br>護衛して？
#. de: Psssht! Guttrix sucht freundliche<if $gn4> Großgewachsene<else>n Großgewachsenen</if> zu Begleitschützen bei große Schäft. Na, leuchtet in Denkschale?
#. fr: Guttrix cherche gentil<if $gn4>le</if> aventuri<if $gn4>ère<else>er</if> pour le protéger<nbsp>!
msgctxt "NpcYell:821:0:13"
msgid "Guttrix seeks kindly uplander to give walkpath safety!"
msgstr "Гаттрикс ищет доброго жителя нагорья, чтобы тот проводил его в безопасности!"

#. ja: 帰りのお船に<br>間に合うか～？
#. de: Guttrix hat gute Schäft mit Regenleute macht! Viel Klimmbimm! Da schauzzu!
#. fr: Guttrix va faire affaire<nbsp>! Il va échanger du minerai contre plein de pièces brillantes<nbsp>!
msgctxt "NpcYell:822:0:13"
msgid "Guttrix makes busydeal with rainlanders. Many, many understones for purse full of jinglyshine!"
msgstr "Гаттрикс заключает выгодную сделку с дождевиками. Много-много руды за кошель, полный звеняшек!"

#. ja: お船があるのは<br>こっちかな～？
#. de: Gehzzu mit Schnellschritt! Guteschäft wartet an Ort mit viele Kerze.
#. fr: Le bateau arrive<nbsp>! Il faut se presser, vite<nbsp>!
msgctxt "NpcYell:823:0:13"
msgid "We must be moving legs with much fastness! Busydeal waits in keep of candles!"
msgstr "Надо шевелить ногами побыстрее! Выгодная сделка ждёт в храме со свечами!"

#. ja: ガットリクスいいゴブリン！
#. de: Guttrix ist gute Schäftmacher!
#. fr: Guttrix est le meilleur marchand gobelin<nbsp>!
msgctxt "NpcYell:824:0:13"
msgid "Guttrix is goodly goodsbearer!"
msgstr "Гаттрикс — славный торговец!"

#. ja: よかった よかった<br>間に合った～！
#. de: Guttrix hat warme Dankenherz für <if $gn4> Großgewachsene<else>Großgewachsener</if>! Darfzzu nie weglöschen aus Dauermerken, pshh!
#. fr: Merci, merci, aventuri<if $gn4>ère<else>er</if><nbsp>! Juste à temps<nbsp>!
msgctxt "NpcYell:825:0:13"
msgid "Many, many thanks, uplander! Be not un-remembering your gobbiefriend Guttrix!"
msgstr "Спасибо, спасибо, житель нагорья! Не забывай своего друга-гоблина Гаттрикса!"

#. ja: 高地ラノシア方面まで<br>送ってくれればいいのさ
#. de: Sorge dafür, dass ich unbeschadet ins obere La Noscea komme, und ich sorge dafür, dass du mit Gil überschüttet wirst.
#. fr: Escortez-moi jusqu'en Haute-Noscea<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:826:0:13"
msgid "See me as far as upper La Noscea and I shall see <i>your</i> pockets lined with gil."
msgstr "Проводите меня до Верхней Ла-Носкеи, а я позабочусь, чтобы ваши карманы<i>набили</i> гилами."

#. ja: 傷病兵が待ってるんだ<br>急ぐとしようか
#. de: Viele Verwundete im Warmwein-Sanatorium dürsten nach etwas Trost. Den wird mein Tropfen ihnen verschaffen.
#. fr: Des blessés m'attendent<nbsp>! Pressons le pas<nbsp>!
msgctxt "NpcYell:827:0:13"
msgid "There are many an ailing soul up at the Warmwine Sanitorium who are in urgent need of this wine."
msgstr "В Санатории «Горячее вино» немало больных душ, которым срочно нужно это вино."

#. ja: この辺りには<br>魔物がうろうろしてるんだよね
#. de: Einst sollen selbst alte Mütterchen von Rotgischt zum Bronzesee gereist sein, ohne mehr Schaden als Blasen an den Füßen davonzutragen.
#. fr: Il y a des monstres, par ici.
msgctxt "NpcYell:828:0:13"
msgid "Used to be a woman could walk all the way from Bloodshore to Bronze Lake without suffering more than a blister."
msgstr "Раньше женщина могла пройти весь путь от Кровавого берега до Бронзового озера и отделаться разве что мозолями."

#. ja: いやな汗をかいてきたよ
#. de: Ich spüre eine allgegenwärtige Gefahr!
#. fr: J'ai des frissons dans le dos...
msgctxt "NpcYell:829:0:13"
msgid "I sense danger all around us!"
msgstr "Чую опасность со всех сторон!"

#. ja: これでスパイスワインを<br>無事に届けられそうだよ！
#. de: Ab hier sollte ich es auch alleine schaffen. Hab dank,  <if $gn4>meine Gute<else>mein Freund</if>.
#. fr: Je vais pouvoir livrer mon vin. Merci<nbsp>!
msgctxt "NpcYell:830:0:13"
msgid "I believe I can complete the journey on my own. You have my thanks, adventurer."
msgstr "Кажется, дальше я и сам доберусь. Благодарю вас, искатель приключений."

#. ja: もしかして<br>案内してくれるのかい？
#. de: Verzeiht, Abenteurer<if $gn4>in</if>. Ihr kennt nicht zufällig den Weg nach Ul'dah? Ich ... verlaufe mich ständig.
#. fr: Excusez-moi, aventuri<if $gn4>ère<else>er</if>. Connaîtriez-vous le chemin jusqu'à Ul'dah<nbsp>? Je crois que je suis perdu.
msgctxt "NpcYell:831:0:13"
msgid "Pardon me there, adventurer. Might you know the road to Ul'dah? I seem to be...lost."
msgstr "Простите, искатель приключений. Не подскажете дорогу в Ульду? Кажется, я... заблудился."

#. ja: 悪いね、<br>方向音痴なもんで……
#. de: Ein reisender Händler sollte eigentlich einen besseren Orientierungssinn haben, was?
#. fr: On pourrait s'attendre à ce qu'un marchand ambulant ait un meilleur sens de l'orientation...
msgctxt "NpcYell:832:0:13"
msgid "One would think a traveling merchant might have a better sense of direction."
msgstr "Казалось бы, странствующему торговцу полагалось бы лучше ориентироваться."

#. ja: ツツシさん、<br>怒ってるかな？
#. de: Ich hoffe, diese Geschichte wirkt sich nicht nachteilig auf unser Lieferabkommen aus.
#. fr: Oh, j'espère que toute cette affaire ne sera pas un obstacle à nos accords commerciaux.
msgctxt "NpcYell:833:0:13"
msgid "Oh, I do hope this whole affair does not put a hamper on our shipping agreement."
msgstr "Надеюсь, из-за этой истории наши торговые дела не пострадают."

#. ja: 魔物の気配を<br>感じないか？
#. de: Ihr habt nicht zufällig auch böse Blicke aus den Schatten dieses Kaktus da gespürt, oder?
#. fr: Vous n'auriez pas vu quelque chose bouger derrière ce cactus<nbsp>?
msgctxt "NpcYell:834:0:13"
msgid "You didn't happen to see aught stirring behind that cactus, did you?"
msgstr "Ты случайно не заметил, как что-нибудь шевелилось за тем кактусом?"

#. ja: ありがとう！<br>これで商談ができそうだ！
#. de: Tausend Dank, <if $gn4>werte Abenteurerin<else>werter Abenteurer</if>. Ich werde den Karawanen nur Gutes von Euch berichten.
#. fr: Mille mercis, aventuri<if $gn4>ère<else>er</if>. Je passerai le bonjour aux Caravanes de votre part.
msgctxt "NpcYell:835:0:13"
msgid "A thousand thousand thanks, adventurer. I shall give the Caravans your regards."
msgstr "Тысяча тысяч благодарностей, искатель приключений. Передам караванщикам привет от вас."

#. ja: 誰か来て来て<br>護衛して？
#. de: Guttrix nicht Bösetaten tun! Guttrix herzgute Goblin!
#. fr: Guttrix pas faire de bêtises<nbsp>! Guttrix bon Gobelin<nbsp>!
msgctxt "NpcYell:836:0:13"
msgid "Guttrix makes no wrongdoing! Guttrix is no bad gobbie!"
msgstr "Гаттрикс ничего плохого не сделал! Гаттрикс — добрый гоблин!"

#. ja: 商売できない<br>残念だ～
#. de: Guttrix wollen gute Schäft mit Flossigemann machen.
#. fr: Guttrix veut juste une affaire avec les écailles pour obtenir gagner de pièces brillantes<nbsp>!
msgctxt "NpcYell:837:0:13"
msgid "Guttrix wants only busydeal with scalytails for much jinglyshine!"
msgstr "Гаттриксу нужна только выгодная сделка с чешуйчатыми хвостами, чтобы набить кошель звеняшками!"

#. ja: 帰ろ帰ろ はよ帰ろ～
#. de: Lauernböse mit Hungernaugen suchen Mampfhampf!
#. fr: Les bestioles aux yeux gourmands veulent croquer et manger<nbsp>!
msgctxt "NpcYell:838:0:13"
msgid "Lustyeye beasties seek munchings and crunchings!"
msgstr "Жадноглазые зверушки ищут, чем бы пожевать да похрустеть!"

#. ja: ガットリクスいいゴブリン！
#. de: Guttrix hat Guteherz! Keine Schleichlist in Hinterrücken!
#. fr: Guttrix est le meilleur marchand gobelin<nbsp>!
msgctxt "NpcYell:839:0:13"
msgid "Guttrix is no bad gobbie!"
msgstr "Гаттрикс не плохой гоблин!"

#. ja: ほいほい<br>それでは さよ～なら～
#. de: Großgewachsene<if $gn4>r<else>m</if> sei Großedank! Nun kann Guttrix noch mehr gute Schäft machen!
#. fr: Beaucoup, beaucoup de mercis, aventuri<if $gn4>ère<else>er</if><nbsp>! Guttrix reviendra pour d'autres affaires<nbsp>!
msgctxt "NpcYell:840:0:13"
msgid "Many, many thanks, uplander! But Guttrix will be back for more busydeals!"
msgstr "Спасибо, спасибо, житель нагорья! Но Гаттрикс ещё вернётся за новыми выгодными сделками!"

#. ja: えっ？<br>ボクを探しにきたの？
#. de: Hat mein Onkel dich geschickt? Mein Onkel macht sich ständig Sorgen.
#. fr: Mon tonton vous envoie<nbsp>? Il s'inquiète toujours pour moi.
msgctxt "NpcYell:841:0:13"
msgid "Did mah uncle send yah? He's always worrying."
msgstr "Дядюшка тебя прислал? Он всё время за меня волнуется."

#. ja: ただ父さんに<br>会いたかっただけなんだ
#. de: Dabei bin ich nur hier, um meinen Vater zu sehen.
#. fr: Je voulais juste aller voir mon père...
msgctxt "NpcYell:842:0:13"
msgid "I jus' wanted to see mah ma an' da."
msgstr "Я просто хотел повидать маму и папу."

#. ja: ……こ、怖くなんてないぞ
#. de: I-Ich hab ü-überhaupt keine Angst ...
#. fr: Moi, j'ai pas peur des monstres<nbsp>!
msgctxt "NpcYell:843:0:13"
msgid "Ma an' Da are watching. That's what mah uncle says, but I never see 'em."
msgstr "Мама и папа смотрят на меня. Так говорит дядя, но я их никогда не вижу."

#. ja: 父さん、<br>ボクは強くなるよ……
#. de: Vater, eines Tages bin ich auch stark!
#. fr: Papa, je serai fort un jour, tu verras<nbsp>!
msgctxt "NpcYell:844:0:13"
msgid "Mah uncle says one day, I'll be strong as mah da. "
msgstr "Дядя говорит, что однажды я стану таким же сильным, как папа."

#. ja: やっと帰ってこれた……<br>ありがとう、冒険者さん
#. de: Endlich zurück! Vielen Dank!
#. fr: Merci, aventuri<if $gn4>ère<else>er</if>. J'ai enfin pu voir mon père...
msgctxt "NpcYell:845:0:13"
msgid "Thank yah, 'venturer!"
msgstr "Спасибо, искатель приключений!"

#. ja: ちぃ、覚えてやがれっ！
#. de: Das merk ich mir!
#. fr: Je ferai en sorte d'avoir un coutelas affûté, la prochaine fois.
msgctxt "NpcYell:846:0:13"
msgid "I'll make sure to whet me cutlass for next time."
msgstr "В следующий раз я заточу свой кортик!"

#. ja: 今のうちに引き返すんです！
#. de: Wir sollten umkehren, solange wir noch können!
#. fr: Maintenant ! Nous devons bouger avant leur retour.
msgctxt "NpcYell:847:0:13"
msgid "Now! We must move before they return."
msgstr "Сейчас! Надо уходить, пока они не вернулись."

#. ja: え、ええ、すぐ戻りましょう！
#. de: Ihr habt mich überzeugt, guter Mann, hier ist es zu gefährlich.
#. fr: Leur r-r-retour ? Oh, par les Douze !
msgctxt "NpcYell:848:0:13"
msgid "R-R-Return! Oh, Twelve preserve!"
msgstr "В-вернутся?! Ох, Двенадцать, спаси нас!"

#. ja: 金目の物はいただくぜいっ！
#. de: Euer Geld ist nur die Anzahlung, verstanden? Wir kommen wieder!
#. fr: La bourse ou la vie. Choisis vite ou je prends les deux.
msgctxt "NpcYell:849:0:13"
msgid "Yer coin...or yer life. Choose quickly, afore I takes me both!"
msgstr "Монеты... или жизнь! Живо выбирай, а то возьму и то и другое!"

#. ja: くっ……ひ、退くしかない！
#. de: N-Nichts wie weg hier!
#. fr: Tu ferais mieux de faire ce qu'il te dit.
msgctxt "NpcYell:850:0:13"
msgid "You'd best do as he says."
msgstr "Лучше сделай, как он говорит."

#. ja: に、逃げましょうっ！
#. de: R-Rennt um Euer Leben!
#. fr: Ah ! Fuyons !
msgctxt "NpcYell:851:0:13"
msgid "Pah! Some good you are!"
msgstr "Пф! Да от тебя никакого толку!"

#. ja: うむ、任務完了であります！
#. de: Die Operation war ein voller Erfolg!
#. fr: Mission accomplie<nbsp>! Retournons au bureau des douanes avec ces caisses.
msgctxt "NpcYell:852:0:13"
msgid "Our work here is complete. Now back to the custom house with these crates."
msgstr "На этом наша работа закончена. Теперь возвращаемся с ящиками в таможню."

#. ja: これは状況が悪い……撤収っ！
#. de: Hier verbrennen wir uns die Finger ... Rückzug!
#. fr: Les conditions ne sont pas optimales. Revenons plus tard chercher le reste.
msgctxt "NpcYell:853:0:13"
msgid "The conditions do not appear optimal for a raid. We shall take what we have and return for the rest another time."
msgstr "Налёт сейчас не сулит ничего хорошего. Заберём, что успели, а за остальным вернёмся в другой раз."

#. ja: あのシープたち、何なんだ？
#. de: Welcher Eufel diese Schafe wohl geritten hatte?
#. fr: Mais qu'est-ce qui leur prend ?
msgctxt "NpcYell:854:0:13"
msgid "What in the seven hells got into them?"
msgstr "Да что, к семи преисподним, на них нашло?"

#. ja: こ、後退、後退しろーっ！
#. de: Denen sind wir nicht gewachsen! Rückzug, alle Mann!
#. fr: Maté par des moutons<nbsp>! C'est pas avec ça que je vais passer sergent, moi...
msgctxt "NpcYell:855:0:13"
msgid "Retreating from sheep... Now I'll never make sergeant..."
msgstr "Отступаем от овец... Теперь мне никогда не стать сержантом..."

#. ja: しょ～ばいで　ずるしたね～？
#. de: Psh! Großwachsene<if $gn4><else>r</if> hat falschgeben bei Schäft!
#. fr: L'<if $gn4>aventurière<else>aventurier</if> avide brise le contrat !
msgctxt "NpcYell:856:0:13"
msgid "Lustyeye uplander bursts busydeal!"
msgstr "Жадноглазый житель нагорья сорвал сделку!"

#. ja: ずるっこ　ダメ　おこる～！
#. de: Großwachsene<if $gn4><else>r</if> macht ganz krumme Schäft!
#. fr: Rends les sous-sous au Gobelin !
msgctxt "NpcYell:857:0:13"
msgid "Backtoss gobbie jinglyshine!"
msgstr "Верни гоблину звеняшки!"

#. ja: ぼくたち　だますの　ダメ～！
#. de: Goblin rachebekommen für Lügenzunge!
#. fr: L'<if $gn4>aventurière<else>aventurier</if> essaie de duper les gentils Gobelins !
msgctxt "NpcYell:858:0:13"
msgid "Slippery tongueflaps trick goodly gobbies!"
msgstr "Хитрый язык дурачит добрых гоблинов!"

#. ja: ウソつき～　ゆるさない～！
#. de: Falschsager verdient Starkeschmerz!
#. fr: Les <if $gn4>aven<shy>tu<shy>rières<else>aventuriers</if> au cœur de pierre doivent s'excuser !
msgctxt "NpcYell:859:0:13"
msgid "Narrowheart uplanders must send sorrycries!"
msgstr "Бессердечные жители нагорья должны просить прощения!"

#. ja: あ～たると　い～たいよ～！
#. de: Großwachsene<if $gn4><else>r</if> wird Regenaugen bekommen von Festeschlag!
#. fr: On coupe, on hache et ça fait boum<nbsp>!♪
msgctxt "NpcYell:860:0:13"
msgid "Hack and slash and tossy-boom!♪"
msgstr "Руби да кромсай — и бабах!♪"

#. ja: お～こって　るんだ～よ～！
#. de: Goblins voll Rasenwut!
#. fr: Ça claque, ça éclate et badaboum<nbsp>!♪
msgctxt "NpcYell:861:0:13"
msgid "Bang and boom and slashy-doom!♪"
msgstr "Бум да ба-бах — и кромсай!♪"

#. ja: まだまだ　ゆるせ～ないよ～！
#. de: Großer Mann leiden muss!
#. fr: C'est bientôt la fin, clic, clac et poum<nbsp>!♪
msgctxt "NpcYell:862:0:13"
msgid "Over soon, hack and zoom!♪"
msgstr "Скоро конец, руби и лети!♪"

#. ja: これで～も　くらえ～よ～！
#. de: Das für dich sein!
#. fr: Tout se jouera sous la lune, fume et vroum<nbsp>!♪
msgctxt "NpcYell:863:0:13"
msgid "Under moon, boom and fume!♪"
msgstr "Под луной — бабах да дым!♪"

#. ja: や、や～ら～れ～た～！
#. de: Heute nicht unser Tag!
#. fr: Maintenant, on file !
msgctxt "NpcYell:864:0:13"
msgid "Backrun for nowtimes!"
msgstr "Убегаем на время!"

#. ja: お～ぼえてな～よ～！
#. de: Goblins wiederkommen zu Rachezeit!
#. fr: Mais on reviendra, grrr !
msgctxt "NpcYell:865:0:13"
msgid "Backstab for latertimes!"
msgstr "Пырнём в другой раз!"

#. ja: く～やし～いよ～！
#. de: Pshhh ...! Verflixzzt!
#. fr: Jamais nous oublions les contrats !
msgctxt "NpcYell:866:0:13"
msgid "Forgetting slippery busydeal, for nevertimes!"
msgstr "Забудем скользкую сделку — никогда!"

#. ja: じかんの　むだだったよ～！
#. de: Verschwendung von Zeit! Muss Gil gegen Ware tauschen!
#. fr: On s'en va !
msgctxt "NpcYell:867:0:13"
msgid "Backwalk for nowtimes!"
msgstr "Уходим на время!"

#. ja: しょ～ばい　も～どろ～！
#. de: Zurück arbeiten!
#. fr: Pas de contrat pour le moment !
msgctxt "NpcYell:868:0:13"
msgid "Many, many busydeals for nowtimes!"
msgstr "Много-много выгодных сделок потом!"

#. ja: べつのしょ～ばい　やろ～？
#. de: Jetzt mit Goblin Tausch machen?
#. fr: Gobelins chercher d'autres contrats !
msgctxt "NpcYell:869:0:13"
msgid "Forgetting slippery busydeal, for nevertimes!"
msgstr "Гоблины ищут другие выгодные сделки!"

#. ja: ほら、仕事に戻れお前ら！
#. de: Zurück an die Arbeit mit euch!
#. fr: Arrêtez ces idioties ou vous finirez au trou !
msgctxt "NpcYell:870:0:13"
msgid "Cease with this nonsense at once or both yer arses'll be rottin' in the brig!"
msgstr "А ну прекратили этот вздор, а то оба сгниёте в карцере!"

#. ja: ……この、わからずやどもめ！
#. de: Und Lalafell sind doch die Schönsten!
#. fr: Mais t'y connais rien, je te dis<nbsp>!
msgctxt "NpcYell:871:0:13"
msgid "If ye put it that way..."
msgstr "Ну, раз ты так говоришь..."

#. ja: ミコッテが最高なのに……
#. de: Und Miqo'te sind doch die Schönsten!
#. fr: Les Miqo'tes sont vraiment les meilleures<nbsp>!
msgctxt "NpcYell:872:0:13"
msgid "Ain't no woman worth pissin' in a bucket fer, I reckon."
msgstr "Да нет женщины, ради которой стоило бы даже в ведро помочиться, по-моему."

#. ja: くっ……お、お前ら仕事に……
#. de: H-Habt ihr ... jetzt endlich genug?
#. fr: Hé<nbsp>! Faut retourner au travail, là<nbsp>!
msgctxt "NpcYell:873:0:13"
msgid "Would you two listen!? She loves neither of you!"
msgstr "Вы двое, послушаете меня наконец?! Она не любит ни одного из вас!"

#. ja: ふむ、ミコッテ族もありかもな
#. de: Hm, vielleicht sind Miqo'te ja doch nicht so schlecht.
#. fr: Mouais, une Miqo'te, pourquoi pas...
msgctxt "NpcYell:874:0:13"
msgid "She doesn't love me?"
msgstr "Она меня не любит?"

#. ja: ララフェル族もなかなか……
#. de: Hm, vielleicht sind Lalafell ja doch nicht so schlecht.
#. fr: Les Lalafelles sont pas mal, aussi<nbsp>!
msgctxt "NpcYell:875:0:13"
msgid "She doesn't...love me?"
msgstr "Она... меня не любит?"

#. ja: よし、ちょっくら語り合うか！
#. de: Ha, willst du's ausdiskutieren?
#. fr: Raconte un peu<nbsp>?
msgctxt "NpcYell:876:0:13"
msgid "Well, then I'll jus' 'ave to make 'er!"
msgstr "Ну, тогда придётся мне её завоевать!"

#. ja: おうともよ！
#. de: Worauf du dich verlassen kannst!
#. fr: Alors...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:877:0:13"
msgid "No, <i>I'll</i> 'ave to make 'er!"
msgstr "Нет, <i>мне</i> придётся её завоевать!"

#. ja: ……な、なんて迷惑な奴らだ
#. de: B-Bitte nicht schon wieder!!!
#. fr: Ces deux-là, s'ils mettaient la même énergie au travail...
msgctxt "NpcYell:878:0:13"
msgid "\\<sigh> Not again..."
msgstr "\\<вздох> Ну вот, опять..."

#. ja: シュコォ……シュコォ……
#. de: Pssskoh ...
#. fr: Tryptix est en forme<nbsp>!
msgctxt "NpcYell:879:0:13"
msgid "Pshhh...kooohhh..."
msgstr "Пшшш... ку-у-ух..."

#. ja: わなし　これで　かえるよ～！
#. de: Tryptix hauselaufen mit Schnelleschritt.
#. fr: Tryptix a bobo, Tryptix se cache<nbsp>!
msgctxt "NpcYell:880:0:13"
msgid "Much guthurt. No more wordbond!"
msgstr "Гаттриксу больно. Больше никакой сделки!"

#. ja: わるいやつ　た～おす～！
#. de: Pshh! Tryptix schwerthelfen gegen Ärgerbringer!
#. fr: Tryptix veut aider amis Gobelins !
msgctxt "NpcYell:881:0:13"
msgid "Tryptix sword-lends to gobbiefriends!"
msgstr "Гаттрикс одалживает меч друзьям-гоблинам!"

#. ja: ここ　よそもの　くるな～！
#. de: Fremdleute nicht willkommen mit Offenarm! Zertöten Tryptix Letztenerv.
#. fr: Tryptix coupe et éventre !
msgctxt "NpcYell:882:0:13"
msgid "Tryptix cuts and guts!"
msgstr "Гаттрикс режет и потрошит!"

#. ja: いたく～　し～ちゃうよ～？
#. de: Tryptix wird dir Denkschachtel klopfen mit Schnellefaust!
#. fr: Tryptix pas négocier ! Tryptix juste prendre<nbsp>!
msgctxt "NpcYell:883:0:13"
msgid "Tryptix wishes no busydeal! Tryptix takes uplander jinglyshine!"
msgstr "Гаттрикс не хочет сделки! Гаттрикс заберёт у жителя нагорья звеняшки!"

#. ja: てかげん～　し～ない～！
#. de: Tryptix haut mit Ganzekraft!
#. fr: Bom boum le cœur<nbsp>! Clang clang les épées<nbsp>!
msgctxt "NpcYell:884:0:13"
msgid "Uplander filling with heartthumps as beauteous fighty-tool swishes and swooshes!"
msgstr "Сердце жителя нагорья колотится, пока прекрасный боевой инструмент свистит и рассекает воздух!"

#. ja: キキルンの入店はお断りだ
#. de: Qiqirn sind hier nicht erwünscht.
#. fr: On n'accepte pas les renifleurs, ici.
msgctxt "NpcYell:885:0:13"
msgid "No shirt, no shoes...no service."
msgstr "Без рубашки, без обуви... и кикирнам вход воспрещён."

#. ja: この匂い……さっそく来たか
#. de: Dieser Gestank ... verkündet nichts Gutes!
#. fr: Ça empeste le rat<nbsp>!
msgctxt "NpcYell:886:0:13"
msgid "I smell me a rat..."
msgstr "Чую крысу..."

#. ja: 片付いたら一杯サービスな！
#. de: Wenn wir hier fertig sind, kannst du einen aufs Haus trinken!
#. fr: Merci. Si tu réussis, je t'offre un verre<nbsp>!
msgctxt "NpcYell:887:0:13"
msgid "Cheers. Ever think of workin' as a heavy?"
msgstr "Спасибо. Если справишься, угощу выпивкой!"

#. ja: お前ら、くせーんだよ！
#. de: Stinkende Biester!
#. fr: Je vous ai déjà dit de ne plus revenir ici !
msgctxt "NpcYell:888:0:13"
msgid "I told you to never come back!"
msgstr "Я же сказал вам больше не возвращаться!"

#. ja: さっさと帰れ！
#. de: Hau ab!
#. fr: Ouste !
msgctxt "NpcYell:889:0:13"
msgid "Away with you!"
msgstr "Вон отсюда!"

#. ja: しつこいっ！
#. de: Seid ihr schwer von Begriff?
#. fr: La maison ne sert pas les rats, un point c'est tout<nbsp>!
msgctxt "NpcYell:890:0:13"
msgid "No rats! No exceptions!"
msgstr "Крыс не обслуживаем! Исключений нет!"

#. ja: 他の客に迷惑だろーが！
#. de: Ihr vertreibt uns die Gäste!
#. fr: Vous gênez les autres clients<nbsp>!
msgctxt "NpcYell:891:0:13"
msgid "Sod off, shite-breath! The ale's sourin'."
msgstr "Проваливайте, вонючки! Эль уже прокисает."

#. ja: 怪我してーのか！？
#. de: Ihr wollt's ja nicht anders!
#. fr:  'Tention, j'ai pas peur de tuer un rat<nbsp>!
msgctxt "NpcYell:892:0:13"
msgid "I have no qualms with killin' me a rat."
msgstr "Мне совесть не помешает прикончить крысу."

#. ja: 酒がぶがぶっちゃ！
#. de: Guguroon auch Bitterwasser trinken will!
#. fr: Qiqirn vouloir glou glou<nbsp>!
msgctxt "NpcYell:893:0:13"
msgid "Ale and wine! Wine and ale!"
msgstr "Эль и вино! Вино и эль!"

#. ja: ちゃりちゃり、あるっちゃ
#. de: Mit Glitzer zahlen!
#. fr: Qiqirn avoir clic clic pour payer<nbsp>!
msgctxt "NpcYell:894:0:13"
msgid "Qiqirn has many sparklies!"
msgstr "У кикирна много блестяшек!"

#. ja: くんくん……へいきっちゃ！
#. de: Qiqirn können kämpfen!
#. fr: (snif) (snif)... Qiqirn pas sentir le rat, Qiqirn sentir le Qiqirn !
msgctxt "NpcYell:895:0:13"
msgid "Qiqirn smells no like rat. Qiqirn smells like Qiqirn!"
msgstr "Кикирн не пахнет крысой. Кикирн пахнет кикирном!"

#. ja: 入店させるっちゃ
#. de: Ihr Qiqirn reinlassen!
#. fr: Laisser entrer Qiqirn<nbsp>! (snif) (snif)...
msgctxt "NpcYell:896:0:13"
msgid "In! In! In!"
msgstr "Пустить! Пустить! Пустить!"

#. ja: お客、ぼこぼこ？
#. de: Qiqirn auch Gäste!
#. fr: Qiqirn pas vouloir coup sur la tête, juste coup dans le nez<nbsp>!
msgctxt "NpcYell:897:0:13"
msgid "Qiqirn hates blood. Qiqirn loves wine!"
msgstr "Кикирн не любит кровь. Кикирн любит вино!"

#. ja: よし、片付いたな！
#. de: So, den wären wir los!
#. fr: Ces rats y penseront à deux fois avant de revenir.
msgctxt "NpcYell:898:0:13"
msgid "Those rats'll think twice afore showin' their ugly mugs 'round here again soon."
msgstr "Теперь эти крысы ещё подумают, прежде чем снова сунуть сюда свои мерзкие морды."

#. ja: 心置きなく飲んでけよ
#. de: Trink einen drauf, du hast es dir verdient.
#. fr: Prenez un verre pour la peine<nbsp>!
msgctxt "NpcYell:899:0:13"
msgid "I'd offer you a drink on the house. But it ain't my house, so my thanks'll have to serve."
msgstr "Я бы угостил тебя выпивкой за наш счёт, да только заведение не моё. Так что придётся обойтись моей благодарностью."

#. ja: 俺も休憩すっかな
#. de: Ich werd mir auch mal 'ne Auszeit gönnen.
#. fr: La serveuse au joli minois va panser mes plaies, hé hé<nbsp>!
msgctxt "NpcYell:900:0:13"
msgid "Now I think I'll have that bonny wench see to me hurts. Heh heh heh."
msgstr "А теперь пусть та милая официантка перевяжет мне раны. Хе-хе-хе."

#. ja: 諦めたか……
#. de: Der ... hat wohl erst mal genug, was?
#. fr: C'est la fin...
msgctxt "NpcYell:901:0:13"
msgid "Had...\\<pant>...enough, eh?"
msgstr "Хватило... \\<тяжело дышит>... а?"

#. ja: くそ、なんてザマだよ
#. de: Verdammt, der hat mich ganz schön auseinandergenommen.
#. fr: Maudits rats...
msgctxt "NpcYell:902:0:13"
msgid "They don't pay me enough for this..."
msgstr "Мне за это платят недостаточно..."

#. ja: イテテ、手当てしねーと……
#. de: Jetzt brauch ich erst mal 'n kühles Bier.
#. fr: Aïe aïe aïe<nbsp>! Je vais devoir boire pour oublier que j'ai mal<nbsp>!
msgctxt "NpcYell:903:0:13"
msgid "I needs me a stiff drink."
msgstr "Мне бы чего-нибудь покрепче."

#. ja: 不滅隊、きたきた！？
#. de: Unsterbliche kommen, schnell weg!
#. fr: Les Immortels !? Qiqirn pas aimer coupe coupe<nbsp>!
msgctxt "NpcYell:904:0:13"
msgid "Blades? Qiqirn likes no blades."
msgstr "Клинки? Кикирн не любит клинки."

#. ja: 仕事のじかんっちゃ……
#. de: Arbeit wartet!
#. fr: Qiqirn retourner travailler<nbsp>?
msgctxt "NpcYell:905:0:13"
msgid "Qiqirn seeks more sparklies."
msgstr "Кикирн ищет ещё блестяшек."

#. ja: またくるっちゃ！
#. de: Qiqirn wiederkommen!
#. fr: Qiqirn revenir un autre jour<nbsp>!
msgctxt "NpcYell:906:0:13"
msgid "More sparklies for you, more ale for Qiqirn!"
msgstr "Ещё побрякушек тебе, ещё эля Кикирну!"

#. ja: 次は酒樽っちゃ！
#. de: Nächstes Mal ganzes Fass trinken!
#. fr: Qiqirn boire tout un fût et le mettre sur sa tête<nbsp>!
msgctxt "NpcYell:907:0:13"
msgid "Qiqirn drinks whole cask and wears on head!"
msgstr "Кикирн выпить целую бочку и на голову надеть!"

#. ja: この悪臭、やつが来たか……！
#. de: Dieser ekelerregende Gestank kann nur eines bedeuten ...
#. fr: Cette puanteur... C'est lui<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:908:0:13"
msgid "Seven hells... Not <i>him</i> again."
msgstr "Семь кругов ада... Опять <i>он</i>."

#. ja: ググルン～がぶがぶっちゃ～
#. de: Guguroon viel Bittersaft will!
#. fr: Guguroon a très soif<nbsp>! Glou glou jusqu'à plus soif<nbsp>!
msgctxt "NpcYell:909:0:13"
msgid "Ale for Guguroon! Ale for all!"
msgstr "Эль Гугурону! Эль всем!"

#. ja: ヴェ、ヴェッグファル様！？
#. de: M-Meister Weggfarr?!
#. fr: Maître Weggfarr<nbsp>!?
msgctxt "NpcYell:910:0:13"
msgid "M-Master Weggfarr!?"
msgstr "М-мастер Веггфарр?!"

#. ja: ひぃ！俺たちまで！！
#. de: A-Aber wir kämpfen doch für Euch!
#. fr: Pas nous, pas nous<nbsp>!
msgctxt "NpcYell:911:0:13"
msgid "B-But we're on your side!"
msgstr "Н-но мы же на твоей стороне!"

#. ja: こ、殺される！！
#. de: Ist das der Dank?!
#. fr: On va y laisser la peau<nbsp>!
msgctxt "NpcYell:912:0:13"
msgid "The man's gone mad!"
msgstr "Он совсем спятил!"

#. ja: 甘いぞ！
#. de: Ihr Waschlappen!
#. fr: C'est tout ce que tu sais faire<nbsp>?
msgctxt "NpcYell:913:0:13"
msgid "You're soft! Soft like a baby's arse!"
msgstr "Размякли! Прямо как младенцы!"

#. ja: もっと気合い入れんか！
#. de: Gebt euch mehr Mühe!
#. fr: Allez, on se remue un peu<nbsp>!
msgctxt "NpcYell:914:0:13"
msgid "Going to let some adventurer shame you like that, eh!?"
msgstr "И позволите какому-то искателю приключений вот так вас опозорить, а?!"

#. ja: 者ども、戦いだッ！　加勢しろッ！
#. de: Kämpft! Kämpft um euer Leben!
#. fr: Camarades Ventrerouge<nbsp>! À moi<nbsp>!
msgctxt "NpcYell:915:0:13"
msgid "Redbellies! To me!"
msgstr "Краснобрюхие! Ко мне!"

#. ja: クソッ！　ケアルができる奴、手を貸せッ！
#. de: Ahrg! Heute ist nicht unser Tag ...
#. fr: À moi, soigneurs<nbsp>!
msgctxt "NpcYell:916:0:13"
msgid "My wounds! Someone see to my wounds!"
msgstr "Раны! Кто-нибудь, займитесь моими ранами!"

#. ja: クソクソクソッ！　誰でもいい早く来いッ！
#. de: Verflucht, schnell! Irgendwer soll mir helfen!
#. fr: Argh<nbsp>! Où sont mes renforts<nbsp>!?
msgctxt "NpcYell:917:0:13"
msgid "Where are all my men!?"
msgstr "Где все мои люди?!"

#. ja: クワ～ッ！
#. de: Kraaar!
#. fr: Croâââ !
msgctxt "NpcYell:918:0:13"
msgid "Squawk!"
msgstr "Кря!"

#. ja: オカシラ、ツヨイ！
#. de: Käpt'n ist stark, Käpt'n ist stark! Kraaar!
#. fr: Le cap'taine est forrrt ! Le cap'taine est forrrt ! Croâ
msgctxt "NpcYell:919:0:13"
msgid "Cap'n is strong! Cap'n is strong! Squawk!"
msgstr "Капитан силён! Капитан силён! Кря!"

#. ja: オカシラ、ハンサム！
#. de: Räudiger Hund, räudiger Hund! Kraaar!
#. fr: Misérables chiens ! Misérables chiens ! Croâ croâ<nbsp>!
msgctxt "NpcYell:920:0:13"
msgid "Scurvy dog! Scurvy dog! Squawk!"
msgstr "Цинга! Цинга! Кря!"

#. ja: オカシラ、イヤラシイ！
#. de: Macht die Schotten dicht! Kraaar!
#. fr: Ferrrmez les écoutilles ! Ferrrmez les écoutilles ! Croâ<nbsp>!
msgctxt "NpcYell:921:0:13"
msgid "Batten down the hatches! Batten down the hatches! Squawk!"
msgstr "Задраить люки! Задраить люки! Кря!"

#. ja: オモイダシチマッタゼッ！
#. de: Rette sich, wer kann, rette sich, wer kann! Kraaar!
#. fr: Marrrins d'eau douce ! Marrrins d'eau douce ! Croâ<nbsp>!
msgctxt "NpcYell:922:0:13"
msgid "Two-legged lubber! Two-legged lubber! Squawk!"
msgstr "Двуногий сухопутный! Двуногий сухопутный! Кря!"

#. ja: シャレニナランゾ！
#. de: Land unter, Land unter! Kraaar!
#. fr: Qu'on les pende ! Qu'on les pende ! Croâ<nbsp>!
msgctxt "NpcYell:923:0:13"
msgid "Parley! Parley! Parley! Squaaawk!"
msgstr "Переговоры! Переговоры! Переговоры! Кря-а-а!"

#. ja: いや～すっきりしたな～！
#. de: Weit und breit keines der Biester mehr zu sehen. Ausgezeichnet!
#. fr: Le cauchemar est enfin terminé.
msgctxt "NpcYell:924:0:13"
msgid "The nightmare is finally over!"
msgstr "Кошмар наконец-то закончился!"

#. ja: 助かったよ、ありがとな♪
#. de: Das hat mir den Tag gerettet!
#. fr: Je vais pouvoir me mettre au travail<nbsp>!
msgctxt "NpcYell:925:0:13"
msgid "Maybe now I can finally get some work done."
msgstr "Может, теперь я наконец смогу заняться делом."

#. ja: これで畑に専念できる
#. de: Endlich kann ich mein Feld bestellen.
#. fr: On va faire de cet endroit un champ.
msgctxt "NpcYell:926:0:13"
msgid "What work is that, you ask?"
msgstr "Каким делом, спрашиваешь?"

#. ja: また、よろしく頼むよ！
#. de: Solch tatkräftige Hilfe kann ich bestimmt wieder mal gebrauchen!
#. fr: Mais avant, une petite sieste sous les arbres...
msgctxt "NpcYell:927:0:13"
msgid "Why, pullin' weeds, of course! Ones that don't bite back, mind you."
msgstr "Да сорняки полоть, конечно! Те, что не кусаются."

#. ja: やっぱ根絶やしは無理か……
#. de: Die Biester sind so leicht nicht auszurotten, was?
#. fr: Aussi résistants que de la mauvaise herbe<nbsp>!
msgctxt "NpcYell:928:0:13"
msgid "The damned things are like weeds."
msgstr "Проклятые твари — прямо как сорняки."

#. ja: 次こそ全部引っこ抜いてやる！
#. de: Beim nächsten Mal müssen sie hoffentlich dran glauben.
#. fr: La prochaine fois, on les arrache toutes<nbsp>!
msgctxt "NpcYell:929:0:13"
msgid "I suppose there's no escapin' them."
msgstr "Ну что ж, похоже, от них не избавиться."

#. ja: と、とにかく畑だ！
#. de: Mein Feld!
#. fr: Cet endroit doit devenir un champ<nbsp>!
msgctxt "NpcYell:930:0:13"
msgid "Best I return to the fields and assess the damage."
msgstr "Пора вернуться на поля и посмотреть, какой там ущерб."

#. ja: 畑だけは死守してやるー！
#. de: Ich muss unbedingt mein Feld verteidigen!
#. fr: Mes champs, c'est tout ce qui compte<nbsp>!
msgctxt "NpcYell:931:0:13"
msgid "I reckon I have a lot of replantin' to do."
msgstr "Похоже, придётся немало всего пересаживать."

#. ja: では、急ぎましょう
#. de: Wir haben keine Zeit zu verlieren!
#. fr: On prrrend la Route occidentale.
msgctxt "NpcYell:932:0:13"
msgid "We shall take the Westroad."
msgstr "Поедем Западной дорогой."

#. ja: さっそく出発しましょう
#. de: Auf geht's!
#. fr: Regardez bien où vous marchez<nbsp>!
msgctxt "NpcYell:933:0:13"
msgid "Watch your footing, lest the sand drag you under."
msgstr "Смотрите под ноги, а то песок затянет."

#. ja: …すまん、頼む
#. de: Danke dir!
#. fr: Je n'oublierai pas.
msgctxt "NpcYell:934:0:13"
msgid "I will not forget this."
msgstr "Не забуду этого."

#. ja: おまえら覚悟しろ！！
#. de: Macht euch auf was gefasst!
#. fr: Je ne voulais pas que ça se passe comme ça !
msgctxt "NpcYell:935:0:13"
msgid "I didn't want it to come to this!"
msgstr "Я не хотел, чтобы до этого дошло!"

#. ja: 邪魔しやがってッ！
#. de: Wer wagt es, zu stören?!
#. fr: Maudits aventuriers ! Notre argent si durement gagné<nbsp>!
msgctxt "NpcYell:936:0:13"
msgid "Damnable 'venturers!"
msgstr "Проклятые искатели приключений!"

#. ja: お、俺たちの金づるが！
#. de: U-Unsere Geldquelle!
#. fr: La tortue aux œufs d'or se fait la malle<nbsp>!
msgctxt "NpcYell:937:0:13"
msgid "Our hard-earned gil's escapin'!"
msgstr "Наш тяжким трудом заработанный гил удирает!"

#. ja: こうなったら、<br>殺るしかねえぞッ！
#. de: Das muss mit dem Tode bestraft werden!
#. fr: Ne restez pas là sans rien faire, imbéciles !
msgctxt "NpcYell:938:0:13"
msgid "Well, don't jus' stand there, ye dogs!"
msgstr "Эй, псы, вы чего встали столбом?!"

#. ja: クッ、押されている！？
#. de: Wir sind im Hintertreffen?
#. fr: Bougez-vous et soignez mes blessures !
msgctxt "NpcYell:939:0:13"
msgid "Get yer heads out of yer arses and heal me wounds!"
msgstr "Очнитесь уже и залечите мне раны!"

#. ja: 何…だと…？
#. de: Das kann ... nicht wahr sein!
#. fr: Vous pouvez garder la tortue !
msgctxt "NpcYell:940:0:13"
msgid "Ye can have the ruddy turtle!"
msgstr "Оставьте себе эту проклятую черепаху!"

#. ja: 畜生めぇ～ッ！
#. de: Bei den Sieben Höllen!
#. fr: Par Thal !
msgctxt "NpcYell:941:0:13"
msgid "Thal's bloody balls!"
msgstr "Яйца Тала!"

#. ja: 羽根ナシィィ！
#. de: Stirbst du jetzt, Flügelloser, kha!
#. fr: Vils sans-plumes<nbsp>!
msgctxt "NpcYell:942:0:13"
msgid "Unfeathered!"
msgstr "Беспёрый!"

#. ja: グウッ！　ナニヤツ……！？
#. de: Khaaa! Was bist du?!
#. fr: Kriiiiii<nbsp>!
msgctxt "NpcYell:943:0:13"
msgid "Squaaawk!"
msgstr "Кря-а-а!"

#. ja: …ウルズよ…いずこに…
#. de: Urth ... Wohin bist du entschwunden ...?
#. fr: Ô Urth... Où es-tu...<nbsp>?
msgctxt "NpcYell:944:0:13"
msgid "Urth... Whither hast thou gone...?"
msgstr "Урта... Куда же ты ушла?.."

#. ja: …ウルズよ…そなたの元へ…
#. de: Urth ... Eines Tages werde ich dich finden.
#. fr: Ô Urth... Un jour, je te rejoindrai...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:945:0:13"
msgid "Urth... One day, I <i>will</i> find thee..."
msgstr "Урта... Однажды я <i>найду</i> тебя..."

#. ja: …ウルズよ…今度こそ…
#. de: Bald, Urth ... schon bald.
#. fr: Bientôt, Urth, bientôt...
msgctxt "NpcYell:946:0:13"
msgid "Soon Urth... Soon..."
msgstr "Скоро, Урта... Скоро..."

#. ja: …我が道を阻むというのか…
#. de: Wer erdreistet sich ...?<br>Du wagst es, mir den Weg zu versperren?!
#. fr: Qui se dresse sur ma route<nbsp>?
msgctxt "NpcYell:947:0:13"
msgid "Who is it that would deny me passage?"
msgstr "Кто посмел преградить мне путь?"

#. ja: …愚かな…
#. de: Närrische Sterbliche!
#. fr: Stupides mortels...
msgctxt "NpcYell:948:0:13"
msgid "Foolish mortals..."
msgstr "Глупые смертные..."

#. ja: …魔剣の嘆きを聞け…
#. de: Höret das Wehklagen meiner Klinge ...
#. fr: Entendez-vous ces lamentations<nbsp>?
msgctxt "NpcYell:949:0:13"
msgid "Canst thou hear the lamentations?"
msgstr "Слышишь стенания?"

#. ja: …我は神にして神にあらず…
#. de: Seht mich an! Ein Gott vor den Sterblichen ... doch ein Sterblicher vor den Göttern.
#. fr: Dieu parmi les hommes, homme parmi les Dieux...
msgctxt "NpcYell:950:0:13"
msgid "Here I stand─a god amongst men. Yet here I remain─a mere man amongst gods."
msgstr "Вот я стою — бог среди людей. Но среди богов я всего лишь смертный."

#. ja: …我が魔剣よ…
#. de: Meine Klinge aus Obsidian soll deine Existenz zerschneiden ...
#. fr: Que ma lame d'obsidienne tranche les fils de votre destin...
msgctxt "NpcYell:951:0:13"
msgid "Mine obsidian blade shalt split atwain the threads of thy future..."
msgstr "Мой обсидиановый клинок разрубит нити твоего будущего..."

#. ja: …すべてを断て…
#. de: Den zarten Faden, der in deinem Sein das Kommende mit schon Vergangenem verbindet.
#. fr: ... et qu'elle fasse couler le sang de votre misérable existence<nbsp>!
msgctxt "NpcYell:952:0:13"
msgid "...whilst its crimson fuller shalt channel the lifeblood of thy past!"
msgstr "...а его багровый желоб наполнится кровью твоего прошлого!"

#. ja: …次はオマエが…我が身体に…
#. de: Du weißt nicht ... was du tust. Verloren ist deine arme Seele ...
#. fr: Votre folie vous perdra...
msgctxt "NpcYell:953:0:13"
msgid "Thou knowest not thy folly. Forfeit is thy waking soul..."
msgstr "Ты не ведаешь, что творишь. Душа твоя уже потеряна..."

#. ja: もう、海には戻れねえか…
#. de: Werd ich das Meer je wiederseh'n?
#. fr: La mer m'attendra, comme toujours...
msgctxt "NpcYell:954:0:13"
msgid "The sea'll wait. She always does."
msgstr "Море подождёт. Оно всегда ждёт."

#. ja: 復興、させねえとな…
#. de: Packen wir's an!
#. fr: Le moulin a besoin de réparations. C'est notre priorité.
msgctxt "NpcYell:955:0:13"
msgid "The mill needs mendin'. We need concern ourselves with naught more."
msgstr "Надо починить мельницу. Больше нас ничто не должно заботить."

#. ja: もうここしかねえんだ
#. de: Das ist unsere letzte Chance.
#. fr: Cet endroit, c'est tout c'qu'on a<nbsp>!
msgctxt "NpcYell:956:0:13"
msgid "It may take these legs a few more summers to get used to the land."
msgstr "Похоже, этой земле моим ногам ещё не одно лето понадобится, чтобы привыкнуть."

#. ja: 海…サイッコー…
#. de: Ich liebe das Meer ...
#. fr: C'est la mer qui prend l'homme<nbsp>!
msgctxt "NpcYell:957:0:13"
msgid "I miss me the Deep..."
msgstr "Скучаю по Глубинам..."

#. ja: あきらめきれねえんだ…
#. de: Wir dürfen nicht aufgeben.
#. fr: On en a gros<nbsp>!
msgctxt "NpcYell:958:0:13"
msgid "One day, I'll be back on the Blue. I swear it."
msgstr "Я ещё вернусь в море. Клянусь."

#. ja: ここは俺たちの土地だ！
#. de: Hier ist unser zu Hause!
#. fr: Cet endroit est à nous<nbsp>!
msgctxt "NpcYell:959:0:13"
msgid "But this place be ours!"
msgstr "Но эта земля наша!"

#. ja: 陸も結構、刺激的ね
#. de: Hm, an Land is' es auch gar nicht so schlecht.
#. fr: Y a pas que la mer dans la vie...
msgctxt "NpcYell:960:0:13"
msgid "As much to be had on land, as there be on the sea, I reckon."
msgstr "Думаю, и на суше есть чем поживиться, не меньше, чем в море."

#. ja: 次のお客さんは誰かしら…
#. de: Wer ist als nächstes an der Reihe?
#. fr: À qui le tour<nbsp>?
msgctxt "NpcYell:961:0:13"
msgid "Have ye aught to say?"
msgstr "Есть что сказать?"

#. ja: 陸、嫌いじゃないわ
#. de: Hier an Land gefällt's mir nicht schlecht.
#. fr: On est pas si mal, sur terre.
msgctxt "NpcYell:962:0:13"
msgid "'Tis time we learned to be lubbers."
msgstr "Пора и нам стать сухопутными."

#. ja: さっきの、なんだっちゃ？
#. de: Was das war?
#. fr: Danger dans les bois, pas bon pour clic clic.
msgctxt "NpcYell:963:0:13"
msgid "Danger in these woods. Lots of scaries scares the sparklies."
msgstr "В лесу опасно. Тут много страшилок, побрякушки пугаются."

#. ja: お店、ひらくっちゃ！
#. de: Geschäft is' Geschäft!
#. fr: Des affaires contre des clic clic<nbsp>!
msgctxt "NpcYell:964:0:13"
msgid "Open for trade! Trade for sparklies!"
msgstr "Торговля открыта! Меняем на побрякушки!"

#. ja: 今日も大儲けっちゃ！
#. de: Heute auch groß Geschäft, ja?
#. fr: Des clic clic partout<nbsp>!
msgctxt "NpcYell:965:0:13"
msgid "Many, many sparklies!"
msgstr "Много-много побрякушек!"

#. ja: くっ、幻術士様……支援を！
#. de: <if $gn4>Druidin<else>Druide</if>, bitte heilt mich!
#. fr: Élémentaliste<nbsp>! J'ai besoin de vous<nbsp>!
msgctxt "NpcYell:966:0:13"
msgid "Conjurer! I need you!"
msgstr "Маг иллюзии! Помоги мне!"

#. ja: くぅ……幻術士様、お力を！
#. de: Schlagt den Feind zurück,  <if $gn4>Druidin<else>Druide</if>!
#. fr: Urrh...<nbsp>! Je ne tiendrai plus très longtemps<nbsp>!
msgctxt "NpcYell:967:0:13"
msgid "Conjurer, I cannot stand much longer!"
msgstr "Маг иллюзии, я долго не продержусь!"

#. ja: ウルフどもを食い止めるぞ！
#. de: Zieht den Wölfen das Fell über die Ohren!
#. fr: Repoussez ces bêtes<nbsp>!
msgctxt "NpcYell:968:0:13"
msgid "Send the beasts running!"
msgstr "Гоните зверей прочь!"

#. ja: ここから先へは通さんっ！
#. de: Nur ein toter Wolf, ist ein guter Wolf!
#. fr: On ne les laissera pas passer<nbsp>!
msgctxt "NpcYell:969:0:13"
msgid "Not a single wolf shall pass on my watch!"
msgstr "Пока я здесь, ни один волк не пройдёт!"

#. ja: イクサル族を食い止めるのだ！
#. de: Ixal! Haltet sie auf!
#. fr: Arrêtez les Ixali<nbsp>!
msgctxt "NpcYell:970:0:13"
msgid "0"
msgstr "Не дайте иксалям пройти!"

#. ja: この勝利、デュランデルの名に！
#. de: Für die Ehre des Hauses Durendaire!
#. fr: Pour la gloire des Durendaire<nbsp>!
msgctxt "NpcYell:971:0:13"
msgid "0"
msgstr "За честь Дюрандера!"

#. ja: 一旦逃げんだよッォ！
#. de: Flieht nur, ihr feigen Vögel!
#. fr: Ceux-ci se retirent<nbsp>!
msgctxt "NpcYell:972:0:13"
msgid "0"
msgstr "Отступают!"

#. ja: 邪魔ッァ！！
#. de: Khaaa, khaaa! Gehst du aus dem Weg!
#. fr: Ouste<nbsp>! Crôa<nbsp>!
msgctxt "NpcYell:973:0:13"
msgid "0"
msgstr "Проваливай! Кря!"

#. ja: そこをどけってんだッァ！
#. de: Kannst du sofort verschwinden, verstehst du!
#. fr: Partez de là<nbsp>! Crôa<nbsp>!
msgctxt "NpcYell:974:0:13"
msgid "0"
msgstr "А ну, прочь с дороги! Кря!"

#. ja: らッァ、くらえええッェ！！
#. de: Picke ich deine Augen aus, kha!
#. fr: Prenez ça<nbsp>!
msgctxt "NpcYell:975:0:13"
msgid "0"
msgstr "Получай!"

#. ja: ドラゴンの眷属だわっ！
#. de: Verdammte Drachenbrut!
#. fr: Les fidèles des dragons<nbsp>!
msgctxt "NpcYell:976:0:13"
msgid "The Horde! The Horde!"
msgstr "Орда! Орда!"

#. ja: やった…我々の勝利よっ！
#. de: Jaaa! Der Sieg ist unser!
#. fr: La victoire, enfin<nbsp>!
msgctxt "NpcYell:977:0:13"
msgid "Victory at last!"
msgstr "Наконец-то победа!"

#. ja: フォルタンの名誉にかけて！
#. de: Für die Ehre der Familie Fortemps!
#. fr: Pour les Fortemps<nbsp>!
msgctxt "NpcYell:978:0:13"
msgid "Fortemps!"
msgstr "За Фортанов!"

#. ja: 戦神ハルオーネの祝福あれ！
#. de: Halone, steh uns bei!
#. fr: Ô Halone, guide ma lame<nbsp>!
msgctxt "NpcYell:979:0:13"
msgid "Fury guide my blade!"
msgstr "Ярость, направь мой клинок!"

#. ja: ここを死守するっ！
#. de: Ehre oder Tod!
#. fr: Nous ne céderons pas<nbsp>!
msgctxt "NpcYell:980:0:13"
msgid "You will not have our camp!"
msgstr "Лагерь вам не достанется!"

#. ja: 備えよ、ドラゴンの眷属だ！
#. de: Wir fürchten euch nicht, Drachenbrut!
#. fr: Sonnez l'alerte<nbsp>! L'ennemi approche<nbsp>!
msgctxt "NpcYell:981:0:13"
msgid "Sound the alarum! The enemy draws nigh!"
msgstr "Тревога! Враг приближается!"

#. ja: イシュガルドに栄光あれ！
#. de: Für Ishgard!
#. fr: Pour la gloire d'Ishgard<nbsp>!
msgctxt "NpcYell:982:0:13"
msgid "For Ishgard!"
msgstr "За Ишгард!"

#. ja: この地は死守する、必ずだ！
#. de: Diesen Boden tränken wir mit eurem Blut!
#. fr: Tenez bon<nbsp>!
msgctxt "NpcYell:983:0:13"
msgid "Hold the front!"
msgstr "Удерживайте передовую!"

#. ja: デュランデルの意地を見よ！
#. de: Spürt den Zorn der Durendaire!
#. fr: Les chevaliers des Durendaire ne fléchiront pas<nbsp>!
msgctxt "NpcYell:984:0:13"
msgid "The knights of House Durendaire will never break!"
msgstr "Рыцари Дома Дюрандер не сдадутся!"

#. ja: 饗宴の幕は上がった…<br>さあ、脳髄を差し出せ…
#. de: Ah, es ist angerichtet! An euren Hirnen will ich mich laben!
#. fr: Le festin va commencer... c'est vos âmes que nous allons dévorer<nbsp>!
msgctxt "NpcYell:985:0:13"
msgid "The feast is about to begin...and your minds are the main course!"
msgstr "Пир вот-вот начнётся... На десерт — ваши мозги!"

#. ja: 傀儡は踊る…無限の舞いを…
#. de: Wer mir dient ... dient für immer!
#. fr: Danse, esclave de pierre<nbsp>!
msgctxt "NpcYell:986:0:13"
msgid "Dance for me, slave of stone!"
msgstr "Танцуй для меня, каменный раб!"

#. ja: 愛しき傀儡よ…死を踊れ…
#. de: Tod dem Feind, mein treuer Diener!
#. fr: Fais une autre danse, celle de la mort<nbsp>!
msgctxt "NpcYell:987:0:13"
msgid "Another dance, my slave! The dance of death!"
msgstr "Ещё один танец, раб! Танец смерти!"

#. ja: すべては救世神の為に！
#. de: Gepriesen sei Dalamud!
#. fr: Dalamud régnera encore<nbsp>!
msgctxt "NpcYell:988:0:13"
msgid "Dalamud will rise once again!"
msgstr "Даламуд вновь восстанет!"

#. ja: クッ……こうなったらッ！
#. de: Ich habe noch ein Ass im Ärmel!
#. fr: Puisque vous m'y forcez...
msgctxt "NpcYell:989:0:13"
msgid "You have forced my hand..."
msgstr "Вы сами вынудили меня..."

#. ja: 常闇に眠る傀儡の王よ、<br>我が声に応えよ！
#. de: Beherrscher der immer währenden Dunkelheit, erhöre mich!
#. fr: Vous allez connaître la terreur des sept enfers<nbsp>!
msgctxt "NpcYell:990:0:13"
msgid "Now from the depths of the seven hells will terror rise!"
msgstr "Сейчас из глубин семи кругов ада вырвется ужас!"

#. ja: ヴォイドの深淵より来たれ！
#. de: Erhebe dich aus dem Nichts!
#. fr: Ouvrez les portes, ô seigneur, et envoyez vos serviteurs<nbsp>!
msgctxt "NpcYell:991:0:13"
msgid "Open the gates, my lord, and send your minions through!"
msgstr "Отворите врата, повелитель, и пошлите сюда своих слуг!"

#. ja: 我が呼び声に応えたまえ！
#. de: Höre meine Stimme, Dämon!
#. fr: Écoutez-moi, serviteurs<nbsp>! Votre place est ici<nbsp>!
msgctxt "NpcYell:992:0:13"
msgid "Heed me, servants of the Hound! Your place is in this realm!"
msgstr "Внемлите мне, слуги Гончей! Ваше место в этом мире!"

#. ja: 邪魔をさせる訳にはッ！
#. de: Niemand hält uns auf!
#. fr: Il est trop tard pour arrêter tout ça<nbsp>!
msgctxt "NpcYell:993:0:13"
msgid "You cannot stop what has already begun!"
msgstr "Вам уже не остановить начатое!"

#. ja: グリダニアの犬どもがッ！
#. de: Gridanische Hunde!
#. fr: Les Gridaniens n'ont aucune chance contre les ténèbres<nbsp>!
msgctxt "NpcYell:994:0:13"
msgid "The children of the wood are no match for the denizens of the dark!"
msgstr "Дети леса не ровня обитателям тьмы!"

#. ja: 背教者どもめ、死ねッ！
#. de: Tod den Ungläubigen!
#. fr: Dalamud boira votre sang, hérétiques<nbsp>!
msgctxt "NpcYell:995:0:13"
msgid "Dalamud will lap at your lifeblood and grow ever stronger!"
msgstr "Даламуд будет пить вашу кровь и становиться всё сильнее!"

#. ja: 想定以上に、ひどい淀みです
#. de: Hier ist weit mehr Schlamm als erwartet ...
#. fr: La corruption est plus grave que je ne le pensais.
msgctxt "NpcYell:996:0:13"
msgid "The corruption is worse than I expected..."
msgstr "Скверна хуже, чем я думал..."

#. ja: 土が得意なのに、防ぐだけで手一杯…
#. de: Ich kenn mich mit so etwas aus, aber Arbeit ist es trotzdem ...
#. fr: J'arrive à peine à me défendre... Moi, un spécialiste de l'élément terre...<nbsp>!
msgctxt "NpcYell:997:0:13"
msgid "I have time to do naught but defend..."
msgstr "Мне остаётся только защищаться..."

#. ja: 淀みを洗い流さねば……
#. de: Wenn man den Schlamm wegspülen könnte ...
#. fr: Nous devons la pacifier avant qu'elle ne déstabilise l'équilibre élémentaire<nbsp>!
msgctxt "NpcYell:998:0:13"
msgid "This corruption must be sluiced clean."
msgstr "Нужно смыть эту скверну дочиста."

#. ja: ギガース族だ、迎撃準備ーっ！
#. de: Die Gigas! Macht euch bereit!
#. fr: Sortez vos lames<nbsp>! Les gigas arrivent<nbsp>!
msgctxt "NpcYell:999:0:13"
msgid "Ready your blades! We meet the gigas on the field!"
msgstr "Обнажайте клинки! Встретим гигантов в поле!"
