#. de: Uwaah!
#. fr: Arf<nbsp>!
msgctxt "NpcYell:18288:0:13"
msgid "Ouch..."
msgstr ""

#. ja: 散開だ！
#. de: Auseinander!
#. fr: On se sépare<nbsp>!
msgctxt "NpcYell:18289:0:13"
msgid "Spread out!"
msgstr ""

#. ja: 集合だ！
#. de: Alle zusammen!
#. fr: On se regroupe<nbsp>!
msgctxt "NpcYell:18290:0:13"
msgid "Group up!"
msgstr ""

#. ja: 味方がいないところへ<br>誘導を！
#. de: Bring es weg von den anderen!
#. fr: Dirige-la à l'écart<nbsp>!
msgctxt "NpcYell:18291:0:13"
msgid "Direct it away from us!"
msgstr ""

#. ja: 攻撃から退避を！
#. de: Vorsicht vor dem Angriff!
#. fr: Il faut esquiver<nbsp>!
msgctxt "NpcYell:18292:0:13"
msgid "Look out!"
msgstr ""

#. ja: 誰もいないところへ<br>誘導を！
#. de: Bring es weg von uns!
#. fr: Là où il y a personne<nbsp>!
msgctxt "NpcYell:18293:0:13"
msgid "Take it away from the group!"
msgstr ""

#. ja: 攻撃に注意しつつ<br>散開だ！
#. de: Alle verteilen, aber seid vorsichtig!
#. fr: On se sépare, mais attention<nbsp>!
msgctxt "NpcYell:18294:0:13"
msgid "Spread out, but mind your step!"
msgstr ""

#. ja: こちらへ！
#. de: Hier drüben!
#. fr: Par ici<nbsp>!
msgctxt "NpcYell:18295:0:13"
msgid "Over here!"
msgstr ""

#. ja: 二手に分かれよう！
#. de: In zwei Gruppen aufteilen!
#. fr: On forme deux groupes<nbsp>!
msgctxt "NpcYell:18296:0:13"
msgid "Let's split into two groups!"
msgstr ""

#. ja: 散開したあと<br>時計回りに攻撃を誘導しよう！
#. de: Teilen wir uns auf, um die Angriffe voneinander ablenken! Alle im Uhrzeigersinn!
#. fr: On s'écarte puis on court dans le sens des aiguilles d'une montre<nbsp>!
msgctxt "NpcYell:18297:0:13"
msgid "I've got it! Let's all run clockwise!"
msgstr ""

#. ja: 命中地点に近づこう！
#. de: Alle zusammen beim Zentrum des Angriffs!
#. fr: On se rassemble au point d'impact<nbsp>!
msgctxt "NpcYell:18298:0:13"
msgid "Everyone gather at the point of impact!"
msgstr ""

#. ja: ギリギリまで<br>命中地点に近づこう！
#. de: So nah wie möglich ran ...
#. fr: Le plus près possible du bord<nbsp>!
msgctxt "NpcYell:18299:0:13"
msgid "Try to stand right at the edge..."
msgstr ""

#. ja: 攻撃から退避を！
#. de: Vorsicht vor dem Angriff!
#. fr: Attention, évitez<nbsp>!
msgctxt "NpcYell:18300:0:13"
msgid "Look out!"
msgstr ""

#. ja: 手分けして対応しよう！
#. de: Jeder in einen Turm!
#. fr: Une chacun<nbsp>!
msgctxt "NpcYell:18301:0:13"
msgid "Let's each take command of a tower!"
msgstr ""

#. ja: 各自で攻撃に対処しよう！
#. de: Schnell aufteilen!
#. fr: Chacun la sienne<nbsp>!
msgctxt "NpcYell:18302:0:13"
msgid "I've got this one!"
msgstr ""

#. ja: 吹き飛ぶ攻撃に注意だ！
#. de: Positioniert euch für den Rückstoß!
#. fr: Attention à la projection<nbsp>!
msgctxt "NpcYell:18303:0:13"
msgid "Position yourself carefully, now..."
msgstr ""

#. ja: 吹き飛ばされたらすぐ<br>次の攻撃に対処…！
#. de: Halltet euch bereit, nach dem Rückstoß sofort zu eurem Turm zu rennen!
