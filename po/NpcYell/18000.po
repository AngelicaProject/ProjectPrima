msgctxt "NpcYell:18304:0:13"
msgid "Once you've recovered, get to a tower, quick!"
msgstr ""

#. ja: 2つの攻撃から<br>退避を…！
#. de: Zwei Angriffe auf einmal ...
#. fr: Il faut éviter les deux attaques<nbsp>!
msgctxt "NpcYell:18305:0:13"
msgid "We'll need to dodge both of these..."
msgstr ""

#. ja: 攻撃を避けながら<br>魔力の球を受け止めよう！
#. de: Stellt euch in einen Turm, aber seid auf der Hut!
#. fr: Il faut éviter l'attaque, puis se faire toucher par le globe d'énergie<nbsp>!
msgctxt "NpcYell:18306:0:13"
msgid "Take a tower, but watch your step!"
msgstr ""

#. ja: 敵から離れよう！
#. de: Weg vom Gegner!
#. fr: Tout le monde s'écarte<nbsp>!
msgctxt "NpcYell:18307:0:13"
msgid "Everyone, retreat to safety!"
msgstr ""

#. ja: ボムと敵の間に<br>入るんだ！
#. de: Stell dich zwischen den Gegner und den Bomber! Zieh die Linie auf dich!
#. fr: Il faut se mettre en travers<nbsp>!
msgctxt "NpcYell:18308:0:13"
msgid "Grab that tether!"
msgstr ""

