msgid "Let's go and have a look."
msgstr ""

#. ja: んだぁ？　オマエだけかよ！
#. de: Was?! Ach, du bist's!
#. fr: Eh<nbsp>! Pourquoi pas nous<nbsp>?
msgctxt "NpcYell:18259:0:13"
msgid "What? Why only you!?"
msgstr ""

#. ja: ボォー！
#. de: Mbuuhhh!
#. fr: Mwoooh<nbsp>!
msgctxt "NpcYell:18260:0:13"
msgid "\\<grunt>"
msgstr ""

#. ja: ンボォ…
#. de: Mbuhhh ...
#. fr: Beuuuh...
msgctxt "NpcYell:18261:0:13"
msgid "\\<rumble>"
msgstr ""

#. ja: ボォオ！！
#. de: Mbuuuuhhh!?
#. fr: Mwooooooh<nbsp>!
msgctxt "NpcYell:18262:0:13"
msgid "\\<bellow>"
msgstr ""

#. ja: に、人間…！？
#. de: Uaaah! D-Das<nbsp>...! Das sind doch<nbsp>...!
#. fr: D-des humains<nbsp>!?
msgctxt "NpcYell:18263:0:13"
msgid "They're...they're moving!"
msgstr ""

#. ja: また出てきたよ！
#. de: Noch mehr!
#. fr: En voilà d'autres, ja<nbsp>!
msgctxt "NpcYell:18264:0:13"
msgid "More of them!"
msgstr ""

#. ja: ヘーイ、ビビッテルー！？
#. de: Heee, keine Angst! Keine Angst!
#. fr: Alooors, on s'éneeerve<nbsp>!?
msgctxt "NpcYell:18265:0:13"
msgid "Are you angry? Are you!?"
msgstr ""

#. ja: 死体が<br>こんなに…
#. de: Die sind alle tot ...
#. fr: Des corps... Quelle horreur<nbsp>!
msgctxt "NpcYell:18266:0:13"
msgid "They're all..."
msgstr ""

#. ja: もう一度<br>確認してみよう
#. de: 0
#. fr: 0
msgctxt "NpcYell:18267:0:13"
msgid "0"
msgstr ""

#. ja: さぁ、いきますよ！
#. de: Dann wollen wir mal beginnen!
#. fr: En garde, aventuriers<nbsp>!
msgctxt "NpcYell:18268:0:13"
msgid "Right then, let's begin!"
msgstr ""

#. ja: 続けていきます！
#. de: Wir sind noch nicht fertig!
#. fr: On continue<nbsp>!
msgctxt "NpcYell:18269:0:13"
msgid "I hope you're warmed up..."
msgstr ""

#. ja: これはどうです？
#. de: Wie sieht es <i>hiermit</i> aus?
#. fr: Que dites-vous de ça<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:18270:0:13"
msgid "What do you make of <i>this</i>?"
msgstr ""

#. ja: 気を抜かないでくださいね
#. de: Bleibt stets bei der Sache!
#. fr: Restez sur vos gardes.
msgctxt "NpcYell:18271:0:13"
msgid "Keep your wits about you..."
msgstr ""

#. ja: これで最後ですよ！
#. de: Beinahe geschafft!
#. fr: On touche au but<nbsp>!
msgctxt "NpcYell:18272:0:13"
msgid "One last push until the end!"
msgstr ""

#. ja: うむ、成功だ！
#. de: Fantastisch!
#. fr: Excellent<nbsp>!
