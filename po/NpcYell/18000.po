#. fr: Tournez le dos, mais attention à votre position<nbsp>!
msgctxt "NpcYell:18314:0:13"
msgid "Watch your step, but keep your back turned!"
msgstr ""

#. ja: 敵から離れつつ<br>攻撃を回避だ！
#. de: Wir müssen ausweichen, ohne dem Gegner zu nah zu kommen!
#. fr: Gardez vos distances tout en évitant<nbsp>!
msgctxt "NpcYell:18315:0:13"
msgid "Keep your distance while you dodge these attacks!"
msgstr ""

#. ja: 各自でボムへの攻撃を<br>引き受けよう！
#. de: Jeder fängt einen Angriff ab!
#. fr: Chacun son bombo<nbsp>!
msgctxt "NpcYell:18316:0:13"
msgid "Let's each handle one bomb apiece!"
msgstr ""

#. ja: 浄化してくよ…！
#. de: Keine Sorge, Heilung ist unterwegs!
#. fr: Patience, chacun son tour<nbsp>!
msgctxt "NpcYell:18317:0:13"
msgid "Worry not, I can cure you!"
msgstr ""

#. ja: 落ち着いて、<br>ひとりずつエスナを…！
#. de: Bleib ruhig und heile uns mit Medica!
#. fr: Garde ton calme et guéris-nous<nbsp>!
msgctxt "NpcYell:18318:0:13"
msgid "Stay calm and cast Esuna on each of us!"
msgstr ""

#. ja: ●む…
#. de: 0
#. fr: 0
