#. ja: ウイウイ～
#. de: Ja, ja!
#. fr: Hop hop !
msgctxt "NpcYell:18343:0:13"
msgid "Welcome to Kozama'uka!"
msgstr ""

#. ja: シュィーン
#. de: Wusch!
#. fr: Pshhhiii...
msgctxt "NpcYell:18344:0:13"
msgid "\\<whoosh>"
msgstr ""

#. ja: テケ、テケケ…
#. de: \<klapper> \<klapper>
#. fr: Gnéhé<nbsp>! Gnéhéhéhé...
msgctxt "NpcYell:18345:0:13"
msgid "\\<swish> \\<swish>"
msgstr ""

#. ja: 真ノ闇ニ溶ケルガイイ！
#. de: Das Nichts wird alles verschlingen!
#. fr: Plongez dans les Ténèbres<nbsp>!
msgctxt "NpcYell:18346:0:13"
msgid "Darkness take you all!"
msgstr ""

#. ja: 君ノ健闘ニ感謝ヲ
#. de: Ich habe nicht vergessen, wie viel wir dir schulden.
#. fr: Pas si vite<nbsp>!
msgctxt "NpcYell:18347:0:13"
msgid "I think not!"
msgstr ""

#. ja: シュポポ
#. de: Töff töff!
#. fr: Tchou-tchou-tchou<nbsp>!
msgctxt "NpcYell:18348:0:13"
msgid "Choo-choo!"
msgstr ""

#. ja: ありがとな<br>セートジャ！
#. de: Du bist eine Lebensretterin, Ceetol Ja!
#. fr: Merci, Ceetol Ja<nbsp>!
msgctxt "NpcYell:18349:0:13"
msgid "You're a lifesaver, Ceetol Ja!"
msgstr ""

#. ja: 4つの…石板…
#. de: 0
#. fr: 0
msgctxt "NpcYell:18350:0:13"
msgid "0"
msgstr ""

#. ja: くん…しょう…
#. de: 0
#. fr: 0
msgctxt "NpcYell:18351:0:13"
msgid "0"
msgstr ""

#. ja: こっちは<br>任せてください！
#. de: Überlasst das mir!
#. fr: Laissez-moi fairrre<nbsp>!
msgctxt "NpcYell:18352:0:13"
msgid "Leave this to me!"
msgstr ""

#. ja: すごい技…！
#. de: Welch ein Angriff!
#. fr: Quelle technique dévastatrrrice...<nbsp>!
msgctxt "NpcYell:18353:0:13"
msgid "What an attack!"
msgstr ""

#. ja: ハァ…ハァ…
#. de: \<keuch> \<keuch>
#. fr: Haaah... Haaah...
msgctxt "NpcYell:18354:0:13"
msgid " \\<pant> \\<pant>"
msgstr ""

#. ja: ゼェ…ゼェ…
#. de: \<schnauf> \<keuch>
#. fr: Hah... Hah...
msgctxt "NpcYell:18355:0:13"
msgid "\\<wheeze> \\<pant>"
msgstr ""

#. ja: テントーワちゃんが<br>ピンチなの…！
#. de: Tentoawa benötigt Hilfe!
#. fr: Attention, Tentoawa est en difficulté<nbsp>!
msgctxt "NpcYell:18356:0:13"
msgid "Tentoawa needs help!"
msgstr ""

#. ja: グルァァァァアアアア！
#. de: Graaaaah!
#. fr: GROAAAAHRRR<nbsp>!!!
msgctxt "NpcYell:18357:0:13"
msgid "Graaagggh!"
msgstr ""

#. ja: 観念しろ<br>アパーヒ！
#. de: Es ist vorbei, Apyaahi!
#. fr: C'est fini pour toi, Apyaahi<nbsp>!
msgctxt "NpcYell:18358:0:13"
msgid "It's over, Apyaahi!"
msgstr ""

#. ja: オレたちの絆<br>見たか！
#. de: Gemeinsam werden wir triumphieren!
#. fr: Rends-toi, tu peux rien contre nous<nbsp>!
msgctxt "NpcYell:18359:0:13"
msgid "Together we will triumph!"
msgstr ""

#. ja: 祭器が魔物を<br>強化してるの…？
#. de: Macht das Artefakt es stärker?
#. fr: Son totem... Il renforce les créatures<nbsp>!
msgctxt "NpcYell:18360:0:13"
msgid "Is the treasure making it stronger?"
msgstr ""

#. ja: 待たせたわね！
#. de: Wir sind hier!
#. fr: Désolée pour l'attente<nbsp>!
msgctxt "NpcYell:18361:0:13"
msgid "We are here!"
msgstr ""

#. ja: 今助けるよ<br><split " " 1><string $gs1></split>！
#. de: Lass uns das gemeinsam beenden, <split " " 1><string $gs1></split>!
#. fr: Je suis là, <split " " 1><string $gs1></split><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:18362:0:13"
msgid "Let's finish this together, <split \" \" 1><string $gs1></split>!"
msgstr ""

#. ja: コイツ…<br>なんて力なの…！
#. de: Es lässt sich nicht so leicht unterkriegen!
#. fr: Quelle forrrce...
msgctxt "NpcYell:18363:0:13"
msgid "This thing won't go down easily..."
msgstr ""

#. ja: 今度こそ…！
#. de: Jetzt!
#. fr: Cette fois, c'est la bonne...<nbsp>!
msgctxt "NpcYell:18364:0:13"
msgid "Now!"
msgstr ""

#. ja: 内なる「怯懦」が<br>おまえたちを押しつぶす…
#. de: Die Feigheit wird euch zu Fall bringen<nbsp>...
#. fr: La lâcheté étreint fermement votre volonté...
msgctxt "NpcYell:18365:0:13"
msgid "You shall be consumed by the cowardice that binds you..."
msgstr ""

#. ja: 内なる「怯懦」よ、潰せ
#. de: Feigheit, zermalme sie!
#. fr: Puisse votre lâcheté vous réduire en miettes<nbsp>!
msgctxt "NpcYell:18366:0:13"
msgid "Cowardice dismembers!"
msgstr ""

#. ja: 内なる「嫉妬」が<br>おまえたちをかじりとる…
#. de: Der Neid wird euch auffressen<nbsp>...
#. fr: L'envie grrrignote doucement votre âme...
msgctxt "NpcYell:18367:0:13"
msgid "You shall be twisted by the envy that drives you..."
msgstr ""

#. ja: 内なる「嫉妬」よ、断て
#. de: Neid, zerreiße sie!
#. fr: Puisse votre envie vous dévorrrer com<shy>plè<shy>te<shy>ment<nbsp>!
msgctxt "NpcYell:18368:0:13"
msgid "Envy engulfs!"
msgstr ""

#. ja: 内なる「憎悪」が<br>おまえたちを焼きこがす…
#. de: Der Hass wird euch verbrennen<nbsp>...
#. fr: La rage brûle toujours plus fort dans votre cœur... 
msgctxt "NpcYell:18369:0:13"
msgid "You shall be burned by the rage that controls you..."
msgstr ""

#. ja: 内なる「憎悪」よ、滅せよ
#. de: Hass, vernichte sie!
#. fr: Puisse votre rage vous consumer entièrement<nbsp>!
msgctxt "NpcYell:18370:0:13"
msgid "Rage cleaves!"
msgstr ""

#. ja: 内なる「無知」が<br>おまえたちをうつろにする…
#. de: Die Apathie wird euch lähmen<nbsp>...
#. fr: L'apathie provoque un vide en votre for intérieur...
msgctxt "NpcYell:18371:0:13"
msgid "You shall be defeated by the apathy that plagues you..."
msgstr ""

#. ja: 内なる「無知」よ、刈れ
#. de: Apathie, zermürbe sie!
#. fr: Puisse votre apathie vous plonger dans le néant<nbsp>!
msgctxt "NpcYell:18372:0:13"
msgid "Apathy strikes!"
msgstr ""

#. ja: 内なる「驕慢」が<br>おまえたちを腐らせる…
#. de: Der Hochmut wird euch verderben<nbsp>...
#. fr: L'arrogance ronge pernicieusement votre esprit...
msgctxt "NpcYell:18373:0:13"
msgid "You shall be smothered by the arrogance that consumes you..."
msgstr ""

#. ja: 内なる「驕慢」よ、圧せよ
#. de: Hochmut, entstelle sie!
#. fr: Puisse votre arrogance vous étouffer sans pitié<nbsp>!
msgctxt "NpcYell:18374:0:13"
msgid "Arrogance defiles!"
msgstr ""

#. ja: 手前側は任せた！
#. de: Übernimm du den dir nächsten Turm!
#. fr: On te laisse la plus proche<nbsp>!
msgctxt "NpcYell:18375:0:13"
msgid "The one on the left is all yours!"
msgstr ""

#. ja: ん…？
#. de: Was<nbsp>...?
#. fr: ... Hein<nbsp>?
msgctxt "NpcYell:18376:0:13"
msgid "Hm...?"
msgstr ""

#. ja: これは…
#. de: Ist das<nbsp>...?
#. fr: Qu'est-ce que...<nbsp>?
msgctxt "NpcYell:18377:0:13"
msgid "What in the...?"
msgstr ""

#. ja: 何をしてやがるんだ？
#. de: Was macht es da?!
#. fr: Qu'est-ce qu'il fait<nbsp>!?
msgctxt "NpcYell:18379:0:13"
msgid "What's it doing!?"
msgstr ""

#. ja: エーテルを<br>流し込んでいる…？
#. de: Es<nbsp>... lädt Äther auf?
#. fr: Il... amasse de l'éther, on dirait.
msgctxt "NpcYell:18380:0:13"
msgid "Is it...consuming the aether?"
msgstr ""

#. ja: 何の真似！？
#. de: Was denn jetzt?
#. fr: Il se passe quoi, là<nbsp>!?
msgctxt "NpcYell:18381:0:13"
msgid "What do we do?"
msgstr ""

#. ja: 柱に雷エーテルを<br>充填しているわ！
#. de: Es lädt das Gestein mit Äther!
#. fr: Il remplit la colonne avec de l'éther de foudre<nbsp>!
msgctxt "NpcYell:18382:0:13"
msgid "It's infusing the rocks with aether!"
msgstr ""

#. ja: 柱に牙を<br>突き刺したぞ！？
#. de: Es hat seine Hauer ins Gestein gerammt!
#. fr: Il a perrrcé la colonne avec ses défenses<nbsp>!
msgctxt "NpcYell:18383:0:13"
msgid "It's pierced the pillar with its tusks!"
msgstr ""

#. ja: へっ、それは<br>さっきも見たぜ！
#. de: Den Trick kenne ich schon!
#. fr: Hé hé, tu nous auras pas deux fois avec le même coup<nbsp>!
msgctxt "NpcYell:18384:0:13"
msgid "We've seen that trick before!"
msgstr ""

#. ja: 得意技のようだね
#. de: Ist das etwa dein Lieblingsangriff?
#. fr: C'est sûrement son attaque de prédilection.
msgctxt "NpcYell:18385:0:13"
msgid "It's fond of that tactic."
msgstr ""

#. ja: またそれ！？
#. de: Schon wieder?!
#. fr: Encore<nbsp>!?
msgctxt "NpcYell:18386:0:13"
msgid "Again!?"
msgstr ""

#. ja: みんな避けて！
#. de: Ausweichen!
#. fr: Vite, à l'abri<nbsp>!
msgctxt "NpcYell:18387:0:13"
msgid "We have to dodge!"
msgstr ""

#. ja: 同じ攻撃は<br>通じないぞ！
#. de: Das Gleiche noch mal? Nicht mit mir!
#. fr: La même attaque ne nous surprendrrra pas une seconde fois<nbsp>!
msgctxt "NpcYell:18388:0:13"
msgid "We won't fall prey to the same attack!"
msgstr ""

#. ja: さっきと違うぞ！？
#. de: Diesmal macht es was anderes!
#. fr: Tiens, il essaye autre chose<nbsp>!
msgctxt "NpcYell:18389:0:13"
msgid "It's trying something different!"
msgstr ""

#. ja: 今度は地面に…！？
#. de: In den Boden ...?!
#. fr: Regardez, le sol...
msgctxt "NpcYell:18390:0:13"
msgid "Look! The ground!"
msgstr ""

#. ja: どういうつもり！？
#. de: Was hat es vor?!
#. fr: Qu'est-ce qu'il mijote...<nbsp>?
msgctxt "NpcYell:18391:0:13"
msgid "What's it up to now?"
msgstr ""

#. ja: みんな<br>気をつけて！
#. de: Passt auf!
#. fr: Attention à vous<nbsp>!
msgctxt "NpcYell:18392:0:13"
msgid "Careful!"
msgstr ""

#. ja: 力を溜めて<br>いるのか！？
#. de: Bereitet es sich auf etwas vor?!
#. fr: Il accumule de l'énerrrgie<nbsp>!?
msgctxt "NpcYell:18393:0:13"
msgid "Is it gathering power?"
msgstr ""

#. ja: なんだ<br>こりゃあああ！？
#. de: Ach du liiieeebeee ...!
#. fr: C'est quoi ce truuuc<nbsp>!?
msgctxt "NpcYell:18394:0:13"
msgid "What now!?"
msgstr ""

#. ja: 良い気分では<br>ないね…
#. de: Mir wird ganz anders ...
#. fr: Cela ne me dit rien qui vaille...
msgctxt "NpcYell:18395:0:13"
msgid "This bodes ill..."
msgstr ""

#. ja: これって<br>死霊…？
#. de: Sind das<nbsp>... Seelen?
#. fr: Je rêve ou ce sont... des âmes<nbsp>!?
msgctxt "NpcYell:18396:0:13"
msgid "Are these...souls?"
msgstr ""

#. ja: なんて魂の量…
#. de: So viele auf einmal ...!
#. fr: Il y en a tellement...<nbsp>!
msgctxt "NpcYell:18397:0:13"
msgid "So many..."
msgstr ""

#. ja: 魂が集まっている…
#. de: Sie sammeln sich ...
#. fr: Les âmes se rrrassemblent<nbsp>!
msgctxt "NpcYell:18398:0:13"
msgid "They're gathering..."
msgstr ""

#. ja: いい加減にしやがれ！
#. de: Verdammt noch mal, hör auf damit!!
#. fr: Tu vas arrêter, oui<nbsp>!
msgctxt "NpcYell:18399:0:13"
msgid "Enough of that!"
msgstr ""

#. ja: 何度も悪趣味な…
#. de: Es wird nur schlimmer ...
#. fr: C'est de pire en pire...
msgctxt "NpcYell:18400:0:13"
msgid "Even worse than before..."
msgstr ""

#. ja: また悪寒が…！
#. de: Da ist wieder dieser kalte Schauder ...
#. fr: J'en ai la chair de poule<nbsp>!
msgctxt "NpcYell:18401:0:13"
msgid "There's that chill again..."
msgstr ""

#. ja: まだ来るの…？
#. de: Erneut?!
#. fr: Il revient à l'attaque<nbsp>?
msgctxt "NpcYell:18402:0:13"
msgid "More of them?"
msgstr ""

#. ja: また来るぞ！
#. de: Auf ein weiteres Mal!
#. fr: Attention, ça rrrecommence<nbsp>!
msgctxt "NpcYell:18403:0:13"
msgid "Here they come..."
msgstr ""

#. ja: 身体を自由に<br>動かせねぇ…！
#. de: Ich kann mich nicht bewegen<nbsp>...!
#. fr: J-je... J'arrive plus à bouger librement<nbsp>!
msgctxt "NpcYell:18404:0:13"
msgid "I...I can't move!"
msgstr ""

#. ja: こういう時は<br>まず落ち着こう
#. de: In solchen Momenten hilft nur ein klarer Kopf!
#. fr: Dans ce genre de situation, il faut savoir rester calme.
msgctxt "NpcYell:18405:0:13"
msgid "Keep your wits about you."
msgstr ""

#. ja: ちょっと…<br>何なのよ！？
#. de: Was ist denn jetzt schon wieder?!
#. fr: Hé oh<nbsp>! C'est pas du jeu<nbsp>!
msgctxt "NpcYell:18406:0:13"
msgid "What's he got up his sleeve this time?"
msgstr ""

#. ja: 頭が…<br>フラフラするわ…！
#. de: Mir dreht sich alles ...!
#. fr: J'ai... la tête qui tourne...
msgctxt "NpcYell:18407:0:13"
msgid "Ungh... My head is spinning..."
msgstr ""

#. ja: 落ち着いて<br>離れるんだ！
#. de: Ruhe bewahren! Da kommt etwas!
#. fr: Garrrdons notre calme, et éloignons-nous<nbsp>!
msgctxt "NpcYell:18408:0:13"
msgid "Stay calm and keep your distance!"
msgstr ""

#. ja: やべぇのが来そうだ！
#. de: Da kommt was Großes!
#. fr: Ouah<nbsp>! Il va envoyer la sauce<nbsp>!
msgctxt "NpcYell:18409:0:13"
msgid "That doesn't look good!"
msgstr ""

#. ja: 仕掛けてくる…<br>警戒を！
#. de: Er bereitet etwas vor<nbsp>... Vorsicht!
#. fr: Il prépare quelque chose... Restons vigilants<nbsp>!
msgctxt "NpcYell:18410:0:13"
msgid "It's up to something... On your guard!"
msgstr ""

#. ja: ただごとじゃ<br>なさそうね…！
#. de: Jetzt scheint es ernst zu werden<nbsp>...!
#. fr: Je crois qu'il veut en découdre<nbsp>!
msgctxt "NpcYell:18411:0:13"
msgid "I think we've made it angry."
msgstr ""

#. ja: みんな離れてッ！
#. de: Schnell weg da!!
#. fr: Éloignez-vous de là<nbsp>!
msgctxt "NpcYell:18412:0:13"
msgid "Spread out!"
msgstr ""

#. ja: 気をつけろ<br>大技が来るぞ！
#. de: Vorsicht allesamt! Da kommt ein Spezialangriff!
#. fr: Attention, il prépare une grrrosse attaque<nbsp>!
msgctxt "NpcYell:18413:0:13"
msgid "This next attack will be fierce. Stay alert!"
msgstr ""

#. ja: 穴の底が<br>見えねぇぞ！？
#. de: Ein Loch ohne Boden!
#. fr: Je vois même pas le fond de ce trou<nbsp>!
msgctxt "NpcYell:18414:0:13"
msgid "I can't even see the bottom!"
msgstr ""

#. ja: 地面に大穴が…！？
#. de: Ein gigantischer Riss im Grund<nbsp>...!
#. fr: Par les Douze... Il a ouvert un gouffre dans le sol<nbsp>!
msgctxt "NpcYell:18415:0:13"
msgid "It opened a hole in the ground!"
msgstr ""

#. ja: 落ちたら<br>助からないわね…！
#. de: Ein falscher Schritt und das war's<nbsp>...
#. fr: Si on tombe, c'est cuit<nbsp>!
msgctxt "NpcYell:18416:0:13"
msgid "Fall, and I won't be able to save you!"
msgstr ""

#. ja: 足元に気をつけて！
#. de: Passt auf, wo ihr hintretet!
#. fr: Attention où vous mettez les pieds<nbsp>!
msgctxt "NpcYell:18417:0:13"
msgid "Watch your step!"
msgstr ""

#. ja: なんて深い穴だ…！
#. de: Welch gigantisches Loch<nbsp>...!
#. fr: Quel trrrou béant...<nbsp>!
msgctxt "NpcYell:18418:0:13"
msgid "How deep does this hole go?"
msgstr ""

#. ja: すげぇ力だ…！
#. de: Was für eine Kraft<nbsp>...!
#. fr: Il est sacrément costaud<nbsp>!
msgctxt "NpcYell:18419:0:13"
msgid "Such strength!"
msgstr ""

#. ja: 周りの地面が…！？
#. de: Der Boden um uns<nbsp>...!?
#. fr: Le sol autour de nous...
msgctxt "NpcYell:18420:0:13"
msgid "Something moves beneath us!"
msgstr ""

#. ja: みんな注意しろ！
#. de: Achtung!
#. fr: Attention<nbsp>!
msgctxt "NpcYell:18421:0:13"
msgid "Careful!"
msgstr ""

#. ja: くそっ<br>鬱陶しい…！
#. de: Mist. Wie nervig kann man sein?!
#. fr: Rhaaa... Il m'énerve<nbsp>!
msgctxt "NpcYell:18422:0:13"
msgid "I'm getting tired of this..."
msgstr ""

#. ja: いつまで<br>続くのよ！？
#. de: Wie lange denn noch?!
#. fr: Ça va continuer encore longtemps<nbsp>!?
msgctxt "NpcYell:18423:0:13"
msgid "How is it still standing!?"
msgstr ""

#. ja: 落ち着いて<br>対処を！
#. de: Beruhigt euch! Taten statt Worte!
#. fr: Patience, nous allons y arriver<nbsp>!
msgctxt "NpcYell:18424:0:13"
msgid "Patience will lead us to victory!"
msgstr ""

#. ja: 次から次へと…！
#. de: Kein Moment Ruhe ...
#. fr: Il ne nous donne pas un instant de rrrépit<nbsp>!
msgctxt "NpcYell:18425:0:13"
msgid "Not a moment's peace..."
msgstr ""

#. ja: まるでデカい<br>ミミズだぜ！
#. de: Die Dinger sind ja wie riesige Würmer!
#. fr: C'est un ver de terre géant, ou quoi<nbsp>!?
msgctxt "NpcYell:18426:0:13"
msgid "They're like giant earthworms!"
msgstr ""

#. ja: もうっ<br>厄介ね！
#. de: Argh! Ganz schön gefährlich!
#. fr: Grrrr... J'en ai ma claque<nbsp>!
msgctxt "NpcYell:18427:0:13"
msgid "What disgusting creatures!"
msgstr ""

#. ja: 生き物のようだわ…！
#. de: Die leben!
#. fr: On dirait que le sol est vivant<nbsp>!
msgctxt "NpcYell:18428:0:13"
msgid "They almost look alive."
msgstr ""

#. ja: 巻き込まれるな！
#. de: Lasst euch nicht mitreißen!
#. fr: Garrrdez vos distances<nbsp>!
msgctxt "NpcYell:18429:0:13"
msgid "Keep your distance!"
msgstr ""

#. ja: 落ちろッ…！
#. de: Das war's für dich!
#. fr: À terre<nbsp>!
msgctxt "NpcYell:18430:0:13"
msgid "And stay down!"
msgstr ""

#. ja: いけッ！
#. de: Auf sie!
#. fr: Allez<nbsp>!
msgctxt "NpcYell:18431:0:13"
msgid "Fly true!"
msgstr ""

#. ja: 土の力で…！
#. de: Mit der Macht der Erde<nbsp>...!
#. fr: Parrr la puissance de la terre... 
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18432:0:13"
msgid "The earth is mine<br>to command!"
msgstr ""

#. ja: 風の力よ…！
#. de: O mächtiger Wind<nbsp>...!
#. fr: Parrr la puissance du vent...
msgctxt "NpcYell:18433:0:13"
msgid "The wind answers my call!"
msgstr ""

#. ja: これでどうだァ！
#. de: Ihr seid erledigt!
#. fr: Que dis-tu de ça<nbsp>?
msgctxt "NpcYell:18434:0:13"
msgid "Try this!"
msgstr ""

#. ja: 見破ってみろ
#. de: Niemand kann mir folgen!
#. fr: Essaye donc de m'esquiver<nbsp>!
msgctxt "NpcYell:18435:0:13"
msgid "A pack of wolves!"
msgstr ""

#. ja: そこだァ！
#. de: Erwischt!
#. fr: Voilà<nbsp>!
msgctxt "NpcYell:18436:0:13"
msgid "There!"
msgstr ""

#. ja: 斬る！
#. de: Falle entzwei!
#. fr: Je vais te découper<nbsp>!
msgctxt "NpcYell:18437:0:13"
msgid "Cleave!"
msgstr ""

#. ja: 喰らえ！
#. de: Nehmt das!
#. fr: Mange ça<nbsp>!
msgctxt "NpcYell:18438:0:13"
msgid "This will sting!"
msgstr ""

#. ja: もらったァ！
#. de: Hab ich euch!
#. fr: Je t'aurrrai<nbsp>!
msgctxt "NpcYell:18440:0:13"
msgid "You're mine!"
msgstr ""

#. ja: 逃げ場はないぞッ！
#. de: Kein Entkommen!
#. fr: Tu n'as nulle parrrt où fuir<nbsp>!
msgctxt "NpcYell:18441:0:13"
msgid "There's no escape!"
msgstr ""

#. ja: いくぞッ！
#. de: Huaaah!
#. fr: C'est parrrti<nbsp>!
msgctxt "NpcYell:18442:0:13"
msgid "Have at you!"
msgstr ""

#. ja: こいッ！
#. de: Zu mir!
#. fr: À moi<nbsp>!
msgctxt "NpcYell:18443:0:13"
msgid "Come!"
msgstr ""

#. ja: 御方のために…！
#. de: Ihm zu Ehren!
#. fr: Pour mon maître<nbsp>!
msgctxt "NpcYell:18444:0:13"
msgid "The tower must be protected!"
msgstr ""

#. ja: 力が、みなぎる！
#. de: Die Macht fließt durch meine Adern!
#. fr: La force emplit mes veines<nbsp>!
msgctxt "NpcYell:18445:0:13"
msgid "Power courses through my veins!"
msgstr ""

#. ja: 我が使命、果たす…！
#. de: Ich werde nicht scheitern!
#. fr: Je n'échouerai pas<nbsp>!
msgctxt "NpcYell:18446:0:13"
msgid "I shall not fail!"
msgstr ""

#. ja: 雷の激しさは<br>こっちも同じみてぇだ
#. de: Hier regnet es genau so viele Blitze.
#. fr: La foudre est déchaînée, ici aussi...
msgctxt "NpcYell:18447:0:13"
msgid "The lightning hasn't let up here either."
msgstr ""

#. ja: キープの向こう側に<br>こんな場所が…
#. de: Dass es derart entlegen solch einen Ort geben würde ... 
#. fr: Qui aurait cru qu'un endroit pareil se cachait si loin de la Gardienne<nbsp>?
msgctxt "NpcYell:18448:0:13"
msgid "To think we'd find a place like this so far from Everkeep."
msgstr ""

#. ja: 魔物まで<br>帯電してるなんて…
#. de: Selbst die Bestien hier sind geladen ...
#. fr: Les créatures des environs sont chargées en élément foudre.
msgctxt "NpcYell:18449:0:13"
msgid "Even the creatures here are electrified..."
msgstr ""

#. ja: テペケ<br>気をつけて！
#. de: Pass auf, Tepeke!
#. fr: Fais attention, Tepeke<nbsp>!
msgctxt "NpcYell:18450:0:13"
msgid "Watch out, Tepeke!"
msgstr ""

#. ja: 避雷塔は今も<br>機能してるようだね
#. de: Die Nadeln sind nach wie vor funktionstüchtig.
#. fr: Les tours paratonnerres ont l'air de fonctionner.
msgctxt "NpcYell:18451:0:13"
msgid "The lightning rods are still operational..."
msgstr ""

#. ja: ビックリした…！
#. de: Wuah!
#. fr: J'ai eu peur<nbsp>!
msgctxt "NpcYell:18452:0:13"
msgid "Oh my!"
msgstr ""

#. ja: 雷に気をつけて<br>進もう！
#. de: Bleiben wir besser auf der Hut. Man weiß nie, wo sie als Nächstes einschlagen!
#. fr: Ne rrrestons pas sur place... Et attention à la foudre<nbsp>!
msgctxt "NpcYell:18453:0:13"
msgid "Bolts can strike anywhere─step lightly!"
msgstr ""

#. ja: ナワバリに<br>入っちまったのか…！
#. de: Wir sind wohl in seinem Revier ...!
#. fr: Je crois qu'on est entrés dans son territoire.
msgctxt "NpcYell:18455:0:13"
msgid "I guess we've stepped into its territory."
msgstr ""

#. ja: どこからでも<br>かかってらっしゃい！
#. de: Na, dann komm mal her!
#. fr: Je suis prête à en découdre, s'il le faut<nbsp>!
msgctxt "NpcYell:18456:0:13"
msgid "I'm ready for you!"
msgstr ""

#. ja: すごい牙だ…<br>油断するなよ！
#. de: Was für Hauer<nbsp>... Wir lassen besser Vorsicht walten!
#. fr: Ces défenses sont im<shy>prrres<shy>sion<shy>nantes<nbsp>! Restons prudents<nbsp>!
msgctxt "NpcYell:18457:0:13"
msgid "Quite the mouthful of fangs. Don't get too close!"
msgstr ""

#. ja: 実力で突破するしか<br>なさそうね！
#. de: Zeit, zu zeigen, was wir draufhaben!
#. fr: Pas le choix, on fonce dans le tas<nbsp>!
msgctxt "NpcYell:18458:0:13"
msgid "We've no choice but to press on!"
msgstr ""

#. ja: よっしゃ<br>一丁あがり！
#. de: Leichte Beute!
#. fr: Ouais<nbsp>! Bien joué<nbsp>!
msgctxt "NpcYell:18459:0:13"
msgid "An easy win!"
msgstr ""

#. ja: よし、先へ進もう
#. de: Dann mal weiter, Freunde!
#. fr: Poursuivons notre route.
msgctxt "NpcYell:18460:0:13"
msgid "Let us proceed."
msgstr ""

#. ja: ふぅ…なんとか<br>なったわね！
#. de: Puh<nbsp>... Irgendwie ist es gut gegangen!
#. fr: Pfiou... Nous avons réussi<nbsp>!
msgctxt "NpcYell:18461:0:13"
msgid "Well, it all worked out."
msgstr ""

#. ja: さすがは武王…<br>といったところかな
#. de: Sie trägt die Krone des Mutes nicht ohne Grund, was?
#. fr: Notre Aurarque de la Force n'a pas usurpé son titre.
msgctxt "NpcYell:18462:0:13"
msgid "You are a credit to your title, Vow of Resolve."
msgstr ""

#. ja: 中に入ってみましょう！
#. de: Kommt! Rein mit uns!
#. fr: Allons voir à l'intérieur<nbsp>!
msgctxt "NpcYell:18463:0:13"
msgid "In we go!"
msgstr ""

#. ja: すごい大きさね…！
#. de: Ganz schön gewaltig ...
#. fr: C'est énorme...<nbsp>!
msgctxt "NpcYell:18464:0:13"
msgid "Quite imposing, isn't it?"
msgstr ""

#. ja: 秘密の研究施設<br>らしいが…
#. de: Eine geheime Station für geheime Forschung ...
#. fr: On dirait... un laboratoire secrrret.
msgctxt "NpcYell:18465:0:13"
msgid "A remote facility with a secret purpose..."
msgstr ""

#. ja: 集落の名残が<br>ほとんどないわね…！
#. de: Von der Siedlung ist so gut wie nichts übrig ...!
#. fr: Il ne reste plus rien du hameau dont on nous a parlé.
msgctxt "NpcYell:18466:0:13"
msgid "Hardly any signs there was ever a village here..."
msgstr ""

#. ja: 人間、だよな…？
#. de: Das sind doch ...!
#. fr: Ce sont... des humains, pas vrai<nbsp>?
msgctxt "NpcYell:18467:0:13"
msgid "These are people, right...?"
msgstr ""

#. ja: 人を使って研究を…？
#. de: Haben sie hier etwa mit dem Leben experimentiert ...?
#. fr: Ils menaient des expériences sur les habitants<nbsp>!?
msgctxt "NpcYell:18468:0:13"
msgid "They were experimenting on their own...?"
msgstr ""

#. ja: うそ…<br>これって…
#. de: Nein, das kann doch nicht ...!
#. fr: Quelle horreur...
msgctxt "NpcYell:18469:0:13"
msgid "How dreadful..."
msgstr ""

#. ja: ここの親玉か…？
#. de: Ist das der Chef des Ganzen ...?
#. fr: C'est le chef, non<nbsp>?
msgctxt "NpcYell:18470:0:13"
msgid "Is this the man in charge?"
msgstr ""

#. ja: とても禍々しい<br>エーテルを感じる…！
#. de: Der Äther fühlt sich so<nbsp>... unheilvoll an ...!
#. fr: Je ressens un éther par<shy>ti<shy>cu<shy>liè<shy>rement malsain.
msgctxt "NpcYell:18471:0:13"
msgid "There's something unsettling about the aether here."
msgstr ""

#. ja: 黙って通しては<br>くれそうにないな
#. de: Einfach durchlassen wird er uns wohl nicht ...
#. fr: On ne va pas pouvoirrr passer sans devoir se battre.
msgctxt "NpcYell:18472:0:13"
msgid "We won't be passing through without a fight."
msgstr ""

#. ja: 人が、なぜこんな姿に…？
#. de: Wie kann es nur so weit kommen ...?
#. fr: Que s'est-il passé ici...<nbsp>?
msgctxt "NpcYell:18473:0:13"
msgid "What happened to them?"
msgstr ""

#. ja: 凶獣の、封印…？
#. de: Hm? Bestie? Siegel? Was ...?
#. fr: La créature<nbsp>? Le sceau<nbsp>? Mais de quoi parlait-il<nbsp>?
msgctxt "NpcYell:18474:0:13"
msgid "The seal? The beast? What was he talking about?"
msgstr ""

#. ja: 奥も調べてみよう！
#. de: Lasst uns weiter erkunden!
#. fr: Continuons d'avancer<nbsp>!
msgctxt "NpcYell:18475:0:13"
msgid "Let us delve further."
msgstr ""

#. ja: これで死者の魂が<br>解放されただろうか…？
#. de: Ob ihre Seelen jetzt wohl erlöst sind ...?
#. fr: J'espèrrre que les âmes des défunts sont désormais libérées...
msgctxt "NpcYell:18476:0:13"
msgid "Let us pray these souls are now at peace."
msgstr ""

#. ja: 奥が気になる<br>調べてみよう
#. de: Da vorne geht es weiter! Kommt!
#. fr: Je suis curieux d'explorer le reste des lieux. Avançons<nbsp>!
msgctxt "NpcYell:18477:0:13"
msgid "It keeps going. So should we."
msgstr ""

#. ja: すっげえええ！<br>ありゃ、なんだ！？
#. de: Alpakarotz und -dreck!! <i>Was</i> ist das?!
#. fr: Woaaah<nbsp>! C'est quoi, ce truc<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:18478:0:13"
msgid "By the gods... What is <i>that</i>!?"
msgstr ""

#. ja: あれは、いったい…！？
#. de: Ich glaub, ich traue meinen Augen nicht ...!?
#. fr: Je n'en crois pas mes yeux...<nbsp>!
msgctxt "NpcYell:18479:0:13"
msgid "I can hardly believe my eyes..."
msgstr ""

#. ja: もっと近くまで<br>寄ってみましょう！
#. de: Lasst es uns aus der Nähe untersuchen!
#. fr: Allons voir d'un peu plus près<nbsp>!
msgctxt "NpcYell:18480:0:13"
msgid "Let's get a closer look!"
msgstr ""

#. ja: そうか、わかったぞ<br>あの中にいるのは…！
#. de: Verstehe! Dann ist da drin also<nbsp>...!
#. fr: Je vois... J'ai une idée de ce qui nous attend.
msgctxt "NpcYell:18481:0:13"
msgid "Ah... I think I know what awaits us."
msgstr ""

#. ja: 阻止する方法はないの！？
#. de: Kann man das nicht irgendwie stoppen?
#. fr: Il n'y a pas moyen de l'arrêter<nbsp>?
msgctxt "NpcYell:18482:0:13"
msgid "Is there any way to stop it?"
msgstr ""

#. ja: これまでの相手とは<br>桁違いの力だぞ…！
#. de: Im Vergleich zu diesem Biest war alles zuvor nur eine Aufwärmübung.
#. fr: Voilà un adversaire autrement plus corrriace<nbsp>!
msgctxt "NpcYell:18483:0:13"
msgid "We may soon face our fiercest foe yet."
msgstr ""

#. ja: だったら、なおさら<br>止めにいかなきゃ！
#. de: Dann ist es umso wichtiger es aufzuhalten!
#. fr: Alors pas question de le laisser semer le chaos<nbsp>!
msgctxt "NpcYell:18484:0:13"
msgid "All the more reason to deal with it here and now!"
msgstr ""

#. ja: あれは、間違いねぇ…<br>トラルヴィドラールだ！
#. de: Kein Zweifel<nbsp>... Wir haben es mit einem Tural Vidraal zu tun!
#. fr: Aucun doute possible... C'est un Tural vidraal<nbsp>!
msgctxt "NpcYell:18485:0:13"
msgid "A tural vidraal...no doubt about it."
msgstr ""

#. ja: 周辺に被害が出る前に<br>倒しましょう！
#. de: Besiegen wir ihn, bevor er Schlimmeres anrichten kann!
#. fr: Il faut l'arrêter avant qu'il ne dévaste la région<nbsp>!
msgctxt "NpcYell:18486:0:13"
msgid "We must slay it before it breaks free!"
msgstr ""

#. ja: あの獣から<br>強烈な意志を感じる…！
#. de: Ich vernehme seinen unbändigen Willen ...
#. fr: Cette créature... Je peux sentir sa rage implacable...
msgctxt "NpcYell:18487:0:13"
msgid "Its strength of will is overwhelming..."
msgstr ""

#. ja: 雷の力は<br>すごいものだね…
#. de: Die Kraft der Blitze hat es ganz schön in sich, was?
#. fr: La foudre se déchaîne...
msgctxt "NpcYell:18488:0:13"
msgid "The wrath of the heavens is frightening indeed."
msgstr ""

#. ja: もうっ！<br>またなの？
#. de: Ernsthaft?! <i>Schon</i> wieder?
#. fr: Oh non<nbsp>! Encore<nbsp>!?
msgctxt "NpcYell:18489:0:13"
msgid "Really? Again!?"
msgstr ""

#. ja: 気軽に来られる<br>場所じゃないな
#. de: Dieser Ort ist jedenfalls nichts für den Freizeitabenteurer.
#. fr: Ce n'est définitivement pas une prrromenade de santé... 
msgctxt "NpcYell:18490:0:13"
msgid "Not exactly a leisurely trek..."
msgstr ""

#. ja: ねぇねぇ<br>エリクサーちょうだい！
#. de: \<schnupper> Das riecht doch nach Elixier<nbsp>... Her damit!
#. fr: Je veux des élixirs<nbsp>!
msgctxt "NpcYell:18491:0:13"
msgid "I can smell an elixir on you. Give it here!"
msgstr ""

#. ja: ケチッ！<br>なにするのさ！
#. de: Hah?! Was soll das?
#. fr: Aïe<nbsp>! Radin, va<nbsp>!
msgctxt "NpcYell:18492:0:13"
msgid "How rude! You stingy thing, you!"
msgstr ""

#. ja: イタタ…<br>ヒールちょうだい！
#. de: Aua, verdammt noch eins! Heilung bitte!
#. fr: Ouille, ça pique... Soignez-moi<nbsp>!
msgctxt "NpcYell:18493:0:13"
msgid "Ouch! I need healing!"
msgstr ""

#. ja: うー痛い…<br>ヒールちょうだい！！
#. de: Hnggg<nbsp>... Gar nicht gut<nbsp>... Ich brauche dringend Heilung!
#. fr: Argh, j'ai mal... Soignez-moi<nbsp>!
msgctxt "NpcYell:18494:0:13"
msgid "It hurts... Someone, heal me..."
msgstr ""

#. ja: うぐぐ…エリクサー…
#. de: Her mit dem<nbsp>... Elixier<nbsp>...
#. fr: Ugh... Des élixirs, vite...
msgctxt "NpcYell:18495:0:13"
msgid "Give me...an elixir..."
msgstr ""

#. ja: グゥゥ…！
#. de: Guurgh<nbsp>...!
#. fr: Goo...<nbsp>!
msgctxt "NpcYell:18496:0:13"
msgid "Urrgh..."
msgstr ""

#. ja: ゴォォォ！
#. de: Graaah!
#. fr: Grouooh<nbsp>!
msgctxt "NpcYell:18497:0:13"
msgid "Graaah!"
msgstr ""

#. ja: グゴゴゴゴ…
#. de: Gegigigi<nbsp>...
#. fr: Brolom, brolom...
msgctxt "NpcYell:18498:0:13"
msgid "\\<rumble> \\<rumble>"
msgstr ""

#. ja: ねぇねぇ<br>エリクサーちょうだい！
#. de: Elixiere gehen an mich, oh ja!
#. fr: Je veux des élixirs<nbsp>!
msgctxt "NpcYell:18499:0:13"
msgid "Give me your elixirs, now!"
msgstr ""

#. ja: カチ…コチ…
#. de: Krick<nbsp>... Krack<nbsp>...
#. fr: Clok... Clok...
msgctxt "NpcYell:18500:0:13"
msgid "\\<click> \\<clack>"
msgstr ""

#. ja: イタタ…<br>ヒールちょうだい！
#. de: Aua, verdammt noch eins! Heilung bitte!
#. fr: Ouille, ça pique... Soignez-moi<nbsp>!
msgctxt "NpcYell:18501:0:13"
msgid "Ouch! I need healing!"
msgstr ""

#. ja: うー痛い…<br>ヒールちょうだい！！
#. de: Hnggg<nbsp>... Gar nicht gut<nbsp>... Ich brauche dringend Heilung!
#. fr: Argh, j'ai mal... Soignez-moi<nbsp>!
msgctxt "NpcYell:18502:0:13"
msgid "It hurts... Someone, heal me..."
msgstr ""

#. ja: うぐぐ…エリクサー…
#. de: Her mit dem<nbsp>... Elixier<nbsp>...
#. fr: Ugh... Des élixirs, vite...
msgctxt "NpcYell:18503:0:13"
msgid "Give me...an elixir..."
msgstr ""

#. ja: 騒音…解消…
#. de: Lärm<nbsp>... beseitigt<nbsp>...
#. fr: Supprimer... le bruit...
msgctxt "NpcYell:18504:0:13"
msgid "Stifle...the noise..."
msgstr ""

#. ja: 雑音…抹消…
#. de: Störgeräusche<nbsp>... erstickt<nbsp>...
#. fr: Réduire... au silence...
msgctxt "NpcYell:18505:0:13"
msgid "Return...the quiet..."
msgstr ""

#. ja: 煩音…滅殺…！
#. de: Unruhe<nbsp>... terminiert<nbsp>...!
#. fr: Faire taire... à jamais<nbsp>!
msgctxt "NpcYell:18506:0:13"
msgid "Must have...absolute silence!"
msgstr ""

#. ja: 熱っついぶい！
#. de: Heiß, heiß, heiß!
#. fr: Ça brûle, grouin<nbsp>!
msgctxt "NpcYell:18507:0:13"
msgid "Hot, hot, hot!"
msgstr ""

#. ja: な、なにするぶい！
#. de: Das ist doch eine Frechheit!
#. fr: Comment osez-vous, grouin<nbsp>!?
msgctxt "NpcYell:18508:0:13"
msgid "This is an outrage!"
msgstr ""

#. ja: さささ寒いぶい！
#. de: Kalt, kalt, kalt!
#. fr: Ç-ç-ça caille<nbsp>!
msgctxt "NpcYell:18509:0:13"
msgid "F-Freezing!"
msgstr ""

#. ja: ひえひえだぶい…
#. de: Ich spüre meine Zehen nicht mehr!
#. fr: On se les gèle, grouin...
msgctxt "NpcYell:18510:0:13"
msgid "I can't feel my toes!"
msgstr ""

#. ja: ごぼぼぼぼ
#. de: Garstig giftig!
#. fr: Glouglouglou...
msgctxt "NpcYell:18511:0:13"
msgid "Glub...glub..."
msgstr ""

#. ja: ごぼ…ぼ…
#. de: Das gibt's doch nicht!
#. fr: Glou... Glouglou...
msgctxt "NpcYell:18512:0:13"
msgid "Blub...glub..."
msgstr ""

#. ja: なかなか手ごわい<br>奴だったね～
#. de: Ein schwerer Gegner!
#. fr: Il était coriace, celui-là.
msgctxt "NpcYell:18513:0:13"
msgid "That was a formidable opponent."
msgstr ""

#. ja: さらに奥に進めそうね<br>行ってみましょう
#. de: Gehen wir weiter.
#. fr: La voie est libre, en avant<nbsp>!
msgctxt "NpcYell:18514:0:13"
msgid "Let us proceed onward."
msgstr ""

#. ja: あの胸に輝く心核…<br>なんか怪しいね～！
#. de: In seiner Brust! Zielt auf das Leuchten!
#. fr: Là, au milieu de sa poitrine, je crois que c'est son cœur<nbsp>!
msgctxt "NpcYell:18515:0:13"
msgid "That core... Target the glimmer within!"
msgstr ""

#. ja: ぶい…ぶい…
#. de: Oink oink<nbsp>...
#. fr: Grouin... Grouin...
msgctxt "NpcYell:18516:0:13"
msgid "Oink, oink..."
msgstr ""

#. ja: ぶ、ぶい…
#. de: O-Oink<nbsp>...
#. fr: Gr-grouin...
msgctxt "NpcYell:18517:0:13"
msgid "O-Oink..."
msgstr ""

#. ja: ぶいい…
#. de: Oooink<nbsp>...
#. fr: Grouiiin...
msgctxt "NpcYell:18518:0:13"
msgid "Oooink..."
msgstr ""

#. ja: 火祭り、楽しかったぶいっ！<br>お前らもたまには役立つぶいっ！
#. de: Ein brandheißes Feuerfest war das! Und ihr das beste Zündholz, oink!
#. fr: Un festival de flammes, grouin<nbsp>! Pour une fois, vous deux avez servi à quelque chose<nbsp>!
msgctxt "NpcYell:18519:0:13"
msgid "A scorching festival of flame! You two made for excellent kindling!"
msgstr ""

#. ja: 雪祭り、楽しかったぶいっ！<br>これぞ連携って感じだぶいっ！
#. de: Je mehr Schnee, desto mehr Spaß! Und zu Dritt ist sowieso alles gleich nochmal besser, oink!
#. fr: C'était la fête du flocon<nbsp>! Ensemble, on fait une super équipe, grouin<nbsp>!
msgctxt "NpcYell:18520:0:13"
msgid "With friends like you, there's snow end to the fun!"
msgstr ""

#. ja: 毒祭り、楽しかったぶいっ！<br>お似合いの姿だったぶいっ！
#. de: Schön schleimig wart ihr zwei, oink! So gut habt ihr noch nie ausgesehen!
#. fr: Une vraie teuf de la toxine<nbsp>! Vous auriez dû voir votre tête, grouin<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18521:0:13"
msgid "You poisoned princes<br>suited your slimy transformation!"
msgstr ""

#. ja: もう怒ったぶい…
#. de: Jetzt bin ich wütend!
#. fr: J'suis énervé, grouin<nbsp>!
msgctxt "NpcYell:18522:0:13"
msgid "Now I'm livid!"
msgstr ""

#. ja: 許さないぶい…
#. de: Was fällt dir ein?!
#. fr: Vous allez morfler<nbsp>!
msgctxt "NpcYell:18523:0:13"
msgid "Unforgivable..."
msgstr ""

#. ja: リベンジだぶい…
#. de: Rache ist süß, oink.
#. fr: Ça va s'payer, grouin<nbsp>!
msgctxt "NpcYell:18524:0:13"
msgid "Payback time..."
msgstr ""

#. ja: よーし、この調子で<br>遺跡を制覇するぞ！
#. de: Nur nicht nachlassen!
#. fr: Allez, on continue<nbsp>! Ces ruines n'auront bientôt plus de secrets pour nous<nbsp>!
msgctxt "NpcYell:18525:0:13"
msgid "Keep your spirits up! We're making good progress!"
msgstr ""

#. ja: 寺院の守りが<br>これだけとは思えないが…
#. de: Das Schlimmste liegt wohl noch vor uns<nbsp>...
#. fr: On risque de tomber sur encore plus fort...
msgctxt "NpcYell:18526:0:13"
msgid "I daresay greater foes await us..."
msgstr ""

#. ja: 図体ばかりデカくても<br>負けねぇぜ？
#. de: Ha, je größer der Feind, desto eiserner mein Wille!
#. fr: Hah<nbsp>! Il n'y a pas que la taille qui compte<nbsp>!
msgctxt "NpcYell:18527:0:13"
msgid "Heh. Size won't intimidate me!"
msgstr ""

#. ja: うわ～！<br>すごい大きいね～！
#. de: Uaaah, riesig ist das Ding!
#. fr: Ouah<nbsp>! Cette statue est immense<nbsp>!
msgctxt "NpcYell:18528:0:13"
msgid "It's enormous!"
msgstr ""

#. ja: 寺院の守護者ね…<br>排除しましょう！
#. de: Der Wächter dieses Ortes! Auf, auf!
#. fr: C'est le grand gardien du temple. Pulvérisons-le<nbsp>!
msgctxt "NpcYell:18529:0:13"
msgid "The guardian of this place... Let us make quick work of it!"
msgstr ""

#. ja: 額の円盤は太陽の印…<br>アーゼマの審判者か！
#. de: Auf seiner Stirn prangt das Symbol der Sonne<nbsp>- er steht im Dienste Azeymas!
#. fr: Je le reconnais à son symbole... C'est l'adjudicateur d'Azeyma<nbsp>!
msgctxt "NpcYell:18530:0:13"
msgid "Behold the mark of the sun─an arbiter of Azeyma!"
msgstr ""

#. ja: ぶぎゃああああ！
#. de: Graaargh!
#. fr: GROUAAAaaaaah<nbsp>!!!
msgctxt "NpcYell:18531:0:13"
msgid "Gyaaagh!"
msgstr ""

#. ja: ありがとっ！
#. de: Danke!
#. fr: Merci<nbsp>!
msgctxt "NpcYell:18532:0:13"
msgid "Thanks!"
msgstr ""

#. ja: 呪力くれないかニャ！
#. de: Miau, ich möchte etwas Äther!
#. fr: Donne-moi ta force, miaou<nbsp>!
msgctxt "NpcYell:18533:0:13"
msgid "Gimme aether, meow!"
msgstr ""

#. ja: ムキー！！
#. de: Gebt mir endlich Äther, Miau!
#. fr: Rhaaah<nbsp>!
msgctxt "NpcYell:18534:0:13"
msgid "Raaah!"
msgstr ""

#. ja: あったまきたニャー！
#. de: Miau, ich hab die Schnauze voll!
#. fr: Tu m'énerves, miaou<nbsp>!
msgctxt "NpcYell:18535:0:13"
msgid "Meow you've done it!"
msgstr ""

#. ja: アンヨガジョーズ！
#. de: Gut gelaufen! Gut gelaufen!
#. fr: Regaaardez comme il sait maaarcher<nbsp>!
msgctxt "NpcYell:18536:0:13"
msgid "Look how it walks!"
msgstr ""

#. ja: キョウモ、カワウィーネッ！
#. de: So hübsch heute! Sooo hübsch!
#. fr: Mais c'est qu'il est meuuugnon<nbsp>!
msgctxt "NpcYell:18537:0:13"
msgid "So pretty today! Pretty thing!"
msgstr ""

#. ja: ゲラゲラゲラゲラ！
#. de: Kakakakakak!
#. fr: Niark niark niark<nbsp>!
msgctxt "NpcYell:18538:0:13"
msgid "Heehahaha!"
msgstr ""

#. ja: ヘーイ、ビビッテルー！？
#. de: Heee, keine Angst! Keine Angst!
#. fr: Alooors, on s'éneeerve<nbsp>!?
msgctxt "NpcYell:18539:0:13"
msgid "Are you angry? Are you!?"
msgstr ""

#. ja: アンヨガジョーズ！
#. de: Gut gelaufen! Gut gelaufen!
#. fr: Regaaardez comme il sait maaarcher<nbsp>!
msgctxt "NpcYell:18540:0:13"
msgid "Look how it walks!"
msgstr ""

#. ja: キョウモ、カワウィーネッ！
#. de: So hübsch heute! Sooo hübsch!
#. fr: Mais c'est qu'il est meuuugnon<nbsp>!
msgctxt "NpcYell:18541:0:13"
msgid "So pretty today! Pretty thing!"
msgstr ""

#. ja: ゲラゲラゲラゲラ！
#. de: Kakakakakak!
#. fr: Niark niark niark<nbsp>!
msgctxt "NpcYell:18542:0:13"
msgid "Heehahaha!"
msgstr ""

#. ja: いいか、お前ら……<br>今はまだ想像できねえだろうが、ここにでっけえ基地を造るぞッ！
#. de: Es übersteigt bestimmt eure Vor<shy>stel<shy>lungs<shy>kraft, ihr Kosmowürmchen, aber schon bald wird hier 'ne gewaltige Station stehen!
#. fr: Bon, les gars, ouvrez bien vos petites oreilles ! Aussi incroyable que ça puisse paraître, on va construire une grande base ici !
msgctxt "NpcYell:18543:0:13"
msgid "I know it's hard to envisage, but there'll soon be a magnificent base right here!"
msgstr ""

#. ja: 邪魔なモンを除去して地ならししながら、<br>適時、施工作業も進めてくれッ！
#. de: Hindernisse wollen entfernt und Bauland geebnet werden. Gemeinsam!
#. fr: Débarrassez-vous de tout ce qui peut faire obstacle pour égaliser le terrain, et poursuivez sur vos ouvrages collectifs le moment venu !
msgctxt "NpcYell:18544:0:13"
msgid "The assignment is simple: clear the site of obstructions and tend to construction tasks!"
msgstr ""

#. ja: ふむ、土台に問題はなさそうだな……<br>いよいよ、移動設備「コスモライナー」の建設に入るぞッ！
#. de: Die Basis für Großes ist geschaffen<nbsp>... Dann kümmern wir uns jetzt um den Stationstransport: die Kosmozapper!
#. fr: Hmm, à priori le sol est bien égalisé... On va pouvoir commencer la con<shy>struc<shy>tion de la cosmo-navette !
msgctxt "NpcYell:18545:0:13"
msgid "Solid foundations, check. Eager contributors, check. Cosmoliner construction awaits!"
msgstr ""

#. ja: お前らにはミニローダーの面倒を見てもらいたい！<br>エネルギーを充填してやってくれッ！
#. de: Die Minimechas brauchen eine gehörige Ladung frischer Energie. Ich zähle auf euch!
#. fr: Vous, occupez-vous des ouvriers cosmiques ! Faites en sorte qu'ils soient toujours bien chargés en énergie !
msgctxt "NpcYell:18546:0:13"
msgid "Though we must first tend to the mini rovers. Go forth and recharge their depleted battery packs!"
msgstr ""

#. ja: さあ、お前ら準備はいいか？<br>これから「居住モジュール」の建設に入るぞッ！
#. de: Seid ihr bereit? Dann errichten wir als nächstes die Habitationsmodule!
#. fr: Allez les gars, tout le monde est prêt ? C'est parti pour la con<shy>struc<shy>tion des modules d'habitation !
msgctxt "NpcYell:18547:0:13"
msgid "Contributors, are you ready? Our goal: a homely, heartwarming habitation module!"
msgstr ""

#. ja: ミニローダーを投入するからな！<br>お前らはエネルギーの充填作業を頼むッ！
#. de: Wir brauchen dazu Minimechas. Und die brauchen 'ne gehörige Ladung Energie. Also ab mit euch!
#. fr: On va de nouveau faire appel aux ouvriers cosmiques ! Je compte sur vous pour les recharger ré<shy>gu<shy>liè<shy>re<shy>ment !
msgctxt "NpcYell:18548:0:13"
msgid "Of course, we'll need to make sure the mini rovers are fully charged before work begins in earnest!"
msgstr ""

#. ja: いいか、ここに建てるのは「コスモポート」……<br>宇宙船が離発着するための施設だ！
#. de: Alle hergehört! Hier kommt der sogenannte „Kosmoport“ hin. Ein Flug- und Landeplatz für unser Raumschiff!
#. fr: Cette fois, c'est du sérieux. On va construire un cosmoport, autrement dit une plateforme de décollage pour le vaisseau !
msgctxt "NpcYell:18549:0:13"
msgid "If our interstellar aspirations are to get off the ground, we'll need a place to launch them! Time to build a cosmoport!"
msgstr ""

#. ja: ミニローダーが元気に働けるよう、<br>エネルギーを充填してやってくれッ！
#. de: Seid so lieb und versorgt die Minimechas stetig mit frischer Energie, ja?
#. fr: Je veux pas voir un seul ouvrier cosmique déchargé, compris ? Allez, rechargez-moi tout ça !
msgctxt "NpcYell:18550:0:13"
msgid "Alas, our fleet of mini rovers grows listless! Recharge them so that work may commence!"
msgstr ""

#. ja: お前ら、これからコイツを、<br>コスモでグレートな感じに磨き上げていくぞッ！
#. de: Zeit für eine Überarbeitung galaktastischen Ausmaßes! 
#. fr: Allez les gars, on va refaire une beauté à ce petit bijou pour le rendre encore plus “cosmique” !
msgctxt "NpcYell:18551:0:13"
msgid "Time for an upgrade of galactic proportions!"
msgstr ""

#. ja: カーゴで部品を受け取り、一時作業場で組み立ててくれッ！<br>最高の仕上がりを目指してくれよな！
#. de: Besorgt die benötigten Teile und baut sie an der entsprechenden Stelle zusammen. Ich erwarte höchste Qualität, verstanden?
#. fr: Prenez des pièces dans les caisses et assemblez-les sur les établis ! Je veux vous voir donner le meilleur de vous-mêmes !
msgctxt "NpcYell:18552:0:13"
msgid "Retrieve the components you need and assemble them on-site. Remember, only the highest quality will suffice!"
msgstr ""

#. ja: 今から、ここにトンネルをブチ抜く！<br>キツイ仕事だってことはわかってるぜッ！
#. de: Dann wollen wir mal einen Tunnel in den Berg hier fräsen. Ich will kein Murren hören, klaro?
#. fr: On va percer un tunnel<nbsp>! Je sais, c'est plus facile à dire qu'à faire<nbsp>!
msgctxt "NpcYell:18553:0:13"
msgid "Right, we're digging a tunnel clear through this place!"
msgstr ""

#. ja: だが、職人にはやるしかない時がある。<br>気合を入れていくぞッ！
#. de: Manchmal bleibt uns praktisch Begabten eben nichts anderes übrig, als den Kopf auszuschalten und einfach zu machen!
#. fr: Mais c'est notre devoir en tant qu'honnêtes travailleurs<nbsp>! C'est parti, les amis<nbsp>!
msgctxt "NpcYell:18554:0:13"
msgid "It'll be a tough job, so get ready to roll up your sleeves and put your back into it!"
msgstr ""

#. ja: リフトを敷設するための地ならしを行う！<br>掘って、拾って、運ぶ、その繰り返しだッ！
#. de: Zur Errichtung des Lifts muss der Boden geebnet werden. Buddeln, aufladen, wegschleppen<nbsp>- das ist alles!
#. fr: On va construire un ascenseur, alors il faut niveler le terrain ! Ça veut dire creuser, ramasser, transporter, et on répète le tout encore et encore !
msgctxt "NpcYell:18555:0:13"
msgid "The ground here needs to be leveled in preparation for the lift. Your orders are to dig, collect, carry, and repeat!"
msgstr ""

#. ja: 途方もない作業だが力を合わせれば必ずできる！<br>気合を入れていくぞッ！
#. de: Lasst euch von der Eintönigkeit nicht einschüchtern. Gemeinsam schaffen wir das!
#. fr: C'est un travail de titan qui nous attend, mais ensemble, on peut y arriver ! Allez tout le monde, on reste motivés !
msgctxt "NpcYell:18556:0:13"
msgid "It's a colossal task, but the more hands we have, the lighter the work will be!"
msgstr ""

#. ja: さあ、エネルギー設備を拡充するぞ！<br>お前らにはミニローダーの面倒を見てもらいたい！
#. de: Die Energisierungswerke müssen erweitert werden. Ihr kümmert euch um die Minimechas, ja?
#. fr: Il est temps de développer nos ins<shy>tal<shy>la<shy>tions énergétiques<nbsp>! Je compte sur vous pour vous occuper des ouvriers cosmiques<nbsp>!
msgctxt "NpcYell:18557:0:13"
msgid "We need to expand our energy generation facilities! Your job will be to monitor the mini rovers."
msgstr ""

#. ja: 空になってるエネルギータンクを見つけたら、<br>充填してから戻してやってくれッ！
#. de: Leere Energievorräte gehören aufgefüllt und zurückgestellt. Haben wir uns verstanden?
#. fr: Si vous trouvez un réservoir vide, allez le remplir et remettez-le dans son emplacement<nbsp>!
msgctxt "NpcYell:18558:0:13"
msgid "Keep an eye out for drained battery packs─get them recharged and back into the rovers as quickly as possible!"
msgstr ""

#. ja: お次は給水設備の整備だ！<br>そのためにもミニローダーに活躍してもらわなくちゃな！
#. de: Als Nächstes steht die Erweiterung der Hydrofizierungswerke auf dem Plan. Ohne Minimechas geht da mal wieder nicht viel<nbsp>...
#. fr: C'est le tour des ins<shy>tal<shy>la<shy>tions de dis<shy>tri<shy>bu<shy>tion d'eau<nbsp>! On va voir ce que nos ouvriers cosmiques ont dans le ventre<nbsp>!
msgctxt "NpcYell:18559:0:13"
msgid "Next on the agenda is the expansion of our water supply systems! Our mini rovers are assembled and ready for this crucial task."
msgstr ""

#. ja: だが、エネルギーがなかったらローダーも無用の長物……<br>しっかり面倒を見てやってくれッ！
#. de: Aber ohne die nötige Energie sind die nur riesige Blechdosen und stehen im Weg herum. Kümmert euch also gut um sie!
#. fr: Mais sans énergie, c'est juste de grosses boîtes de conserve<nbsp>! Pensez à recharger ré<shy>gu<shy>liè<shy>re<shy>ment les batteries de nos machines<nbsp>!
msgctxt "NpcYell:18560:0:13"
msgid "But a rover without power might as well be a paperweight, so make sure to keep those battery packs charged!"
msgstr ""

#. ja: ここまでくれば、あとひと踏ん張りだッ！<br>作業を始めるぞッ！
#. de: Jetzt ist es nur noch ein winziges Stück! Wehe, ihr gebt auf!
#. fr: On y est presque, plus qu'un dernier coup de collier ! Alors au travail tout le monde !
msgctxt "NpcYell:18561:0:13"
msgid "This is it─the final project! Let's get building!"
msgstr ""

#. ja: どんどん施工作業も、完成を目指してくぞッ！
#. de: Dann wollen wir mal! Keine Pause bis zur Fertigstellung!
#. fr: Ne ménagez pas vos efforts ! Visez la perfection, même pour les tâches les plus in<shy>si<shy>gni<shy>fiantes !
msgctxt "NpcYell:18562:0:13"
msgid "Not far now. Keep up the pace!"
msgstr ""

#. ja: タウルス型の妖異だ～！
#. de: Ist das<nbsp>... eine Art Taurus?
#. fr: Une créature du néant de type taurus<nbsp>!
msgctxt "NpcYell:18563:0:13"
msgid "Some sort of taurus, eh?"
msgstr ""

#. ja: 倒さなければ<br>進めそうにないわね
#. de: Hier kommen wir wohl nicht ohne Kampf vorbei.
#. fr: Il va falloir vaincre ce monstre si on veut avancer.
msgctxt "NpcYell:18564:0:13"
msgid "We mustn't falter."
msgstr ""

#. ja: お前ら、これから基地の土台を<br>コスモでグレートな感じにしていくぞッ！
#. de: Machen wir die Station noch kosmischer ... Und vor allem größer!
#. fr: Grâce à votre aide, on va pouvoir construire la meilleure station de tout le cosmos<nbsp>!
msgctxt "NpcYell:18565:0:13"
msgid "When we're finished building on these foundations, we'll have the most cosmotastic hub you can imagine."
msgstr ""

#. ja: 邪魔なモンを除去して地ならししながら、<br>適時、施工作業も完成を目指してくれッ！
#. de: Hindernisse wollen entfernt und Bauland geebnet werden. Gemeinsam!
#. fr: Une fois qu'on aura déblayé et nivelé le terrain, les travaux pourront commencer<nbsp>!
msgctxt "NpcYell:18566:0:13"
msgid "The assignment is simple: clear the site of obstructions and tend to construction tasks!"
msgstr ""

#. ja: ススメ…
#. de: Weiter ...
#. fr: Avancez...
msgctxt "NpcYell:18567:0:13"
msgid "Forward!"
msgstr ""

#. ja: ススメ…ススメ…
#. de: Weiter ... Weiter ...
#. fr: Continuez d'avancer...
msgctxt "NpcYell:18568:0:13"
msgid "Forward! Forward!"
msgstr ""

#. ja: さあ行きましょう？<br>この路の彼方へ
#. de: Ich weise den Weg!
#. fr: Laisse-moi te guider<nbsp>!
msgctxt "NpcYell:18569:0:13"
msgid "I'll show you the way!"
msgstr ""

#. ja: 呼んでもらえて<br>嬉しいのだわ！
#. de: Dein Zweiglein ist hier, um zu helfen!
#. fr: Ta jolie branchette arrive à la rescousse<nbsp>!
msgctxt "NpcYell:18570:0:13"
msgid "Your branch is here to aid you!"
msgstr ""

#. ja: ググ…グォォ…！
#. de: Gryaaaah!
#. fr: Grrr... Grouoooh<nbsp>!
msgctxt "NpcYell:18574:0:13"
msgid "Grrr... Groooh!"
msgstr ""

#. ja: 財宝み～つけた♪
#. de: Gefunden! ♪
#. fr: Tu as trouvé mon trésor<nbsp>!♪
msgctxt "NpcYell:18575:0:13"
msgid "Here we are～♪"
msgstr ""

#. ja: エリクサー<br>すごくうれし～！！
#. de: Ein Elixier?! O Freude, o Jubel!
#. fr: Un élixir<nbsp>? Hourra<nbsp>!
msgctxt "NpcYell:18576:0:13"
msgid "An elixir!? Oh rapture! Oh joy!"
msgstr ""

#. ja: エリクサー<br>すごくうれし～！
#. de: Ein Elixier?! Ich singe, ich jauchze!
#. fr: Un élixir<nbsp>? Hourra<nbsp>!
msgctxt "NpcYell:18577:0:13"
msgid "Elixir, at long last!"
msgstr ""

#. ja: エリクサーうれし～！！
#. de: Ein Elixier, hurra!
#. fr: Trop bien, un élixir<nbsp>!
msgctxt "NpcYell:18578:0:13"
msgid "Sweet, sweet elixir!"
msgstr ""

#. ja: エリクサーうれし～！
#. de: Ein Elixier, perfekt!
#. fr: Trop bien, un élixir<nbsp>!
msgctxt "NpcYell:18579:0:13"
msgid "Elixir, my dear ambrosia!"
msgstr ""

#. ja: エリクサーちょうだい！
#. de: Gib mir ein Elixier, bitte bitte bitte!
#. fr: Je veux des élixirs<nbsp>!
msgctxt "NpcYell:18580:0:13"
msgid "I thirst for elixir!"
msgstr ""

#. ja: キュキュッ！<br>キャウゥ～♪
#. de: \<miepf> ♪
#. fr: Kiiikiii<nbsp>! Kihihihi<nbsp>!♪
msgctxt "NpcYell:18581:0:13"
msgid "\\<sniff> \\<squeal>"
msgstr ""

#. ja: グゥ、グゥゥ～♪
#. de: Gubu-gubuuu! ♪
#. fr: Goo... Gooo<nbsp>!♪
msgctxt "NpcYell:18582:0:13"
msgid "Grooo... Grooh ♪"
msgstr ""

#. ja: これ以上はやめろぶい…
#. de: Verkohlt, oink<nbsp>...
#. fr: Ça sent le brûlé, grouin...
msgctxt "NpcYell:18587:0:13"
msgid "Overcooked..."
msgstr ""

#. ja: 苦しいぶい…
#. de: Schluss jetzt<nbsp>...
#. fr: Hors-service, grouin...
msgctxt "NpcYell:18588:0:13"
msgid "I can't take much more!"
msgstr ""

#. ja: さぶぶ…い…
#. de: I-Ich b-b-bibbere<nbsp>...
#. fr: Glaglagla...
msgctxt "NpcYell:18589:0:13"
msgid "S-So cold..."
msgstr ""

#. ja: カチ…コチ…
#. de: E-Eiskalt<nbsp>...
#. fr: Complètement congelé, grouin...
msgctxt "NpcYell:18590:0:13"
msgid "F-Frozen solid..."
msgstr ""

#. ja: がぼぼ…べべべ…
#. de: Glibber<nbsp>... Globber<nbsp>...
#. fr: Glou... Glou... Gblbglblbg...
msgctxt "NpcYell:18591:0:13"
msgid "Glub...blub..."
msgstr ""

#. ja: ごぼっ！？<br>ぼぼぼ…！
#. de: Glorbl?!
#. fr: Glou<nbsp>? Gbglblgb...<nbsp>!
msgctxt "NpcYell:18592:0:13"
msgid "Glub!?"
msgstr ""

#. ja: ぶい～っ！
#. de: Oink!
#. fr: Grouiiin<nbsp>!
msgctxt "NpcYell:18593:0:13"
msgid "Oink!"
msgstr ""

#. ja: ぶいぶいぶいっ
#. de: Oink oink oink!
#. fr: Grouin, grouin, grouin<nbsp>!
msgctxt "NpcYell:18594:0:13"
msgid "Oink, oink, oink!"
msgstr ""

#. ja: ぶゃははは
#. de: Oooink!
#. fr: Grouahahaha<nbsp>!
msgctxt "NpcYell:18595:0:13"
msgid "Oink, oink!"
msgstr ""

#. ja: ヒッヒッ
#. de: Hihiii!
#. fr: Hiii hiii<nbsp>!
msgctxt "NpcYell:18596:0:13"
msgid "Hee-hee!"
msgstr ""

#. ja: サーッ！
#. de: \<surr>
#. fr: Sah<nbsp>!
msgctxt "NpcYell:18597:0:13"
msgid "\\<whirr>"
msgstr ""

#. ja: り～ふ～
#. de: \<raschel raschel>
#. fr: Saaangfeuuuiiille<nbsp>!
msgctxt "NpcYell:18598:0:13"
msgid "\\<rustle> \\<rustle>"
msgstr ""

#. ja: グハハハハハ！
#. de: Guhahahahaha!
#. fr: Hahahahaha<nbsp>!
msgctxt "NpcYell:18599:0:13"
msgid "Gwahahahahaha!"
msgstr ""

#. ja: うぃーん、ががー
#. de: Krrrrzzz ... Katsching!! Tuuttuuuut!
#. fr: Vuiiiii-bzzzt<nbsp>!
msgctxt "NpcYell:18600:0:13"
msgid "\\<whizz> \\<whirr>"
msgstr ""

#. ja: ジャラジャラジャラ…
#. de: \<klimper>
#. fr: Clic clic clic...
msgctxt "NpcYell:18601:0:13"
msgid "\\<clink> \\<clink>"
msgstr ""

#. ja: くぅ～ん
#. de: Wau!
#. fr: Woof<nbsp>!
msgctxt "NpcYell:18602:0:13"
msgid "Woof!"
msgstr ""

#. ja: ぴっぴぴ！
#. de: Zwitscher! ♪
#. fr: Piii pi piii<nbsp>!
msgctxt "NpcYell:18603:0:13"
msgid "Peep-peep!"
msgstr ""

#. ja: 排除しながら<br>進むしかないようだな
#. de: Wir müssen uns wohl einen Weg freikämpfen.
#. fr: On va devoirrr se frayer un chemin<nbsp>!
msgctxt "NpcYell:18608:0:13"
msgid "It seems we must clear a path through these creatures."
msgstr ""

#. ja: そうね…<br>気を引き締めましょう
#. de: Sieht so aus<nbsp>... Bitte seid vorsichtig!
#. fr: Oui... Avançons prudemment.
msgctxt "NpcYell:18609:0:13"
msgid "Indeed. Let us proceed with caution."
msgstr ""

#. ja: 砂浜で鍛えた脚力を<br>見せてやるぜ！
#. de: Endlich macht sich das ganze Training am Strand bezahlt!
#. fr: Heu<shy>reu<shy>se<shy>ment que j'ai l'habitude de courir sur la plage<nbsp>!
msgctxt "NpcYell:18610:0:13"
msgid "Now to put my time training on the beach to good use!"
msgstr ""

#. ja: 砂が堆積しているようね
#. de: Über die Jahre hat sich ziemlich viel Sand angesammelt<nbsp>...
#. fr: Le sable s'est accumulé.
msgctxt "NpcYell:18611:0:13"
msgid "The sand has built up over the long years..."
msgstr ""

#. ja: うおっ！<br>でけぇ虫だな！
#. de: Oho! Was für ein Riesenbrummer!
#. fr: Ouah<nbsp>! Ça, c'est une grosse bestiole<nbsp>!
msgctxt "NpcYell:18612:0:13"
msgid "Whoa! That's a big bug!"
msgstr ""

#. ja: この設備を<br>住処にしていたのか…
#. de: Dieser Ort hat offenbar als Versteck gedient<nbsp>...
#. fr: Ces infrastructures lui servent de repairrre...<nbsp>?
msgctxt "NpcYell:18613:0:13"
msgid "Has it been using this chamber as its lair...?"
msgstr ""

#. ja: ふう…<br>厄介な相手だったわね
#. de: Uff<nbsp>... Das war kein leichter Gegner<nbsp>...
#. fr: Fiou... Il nous a donné du fil à retordre.
msgctxt "NpcYell:18614:0:13"
msgid "Hmph. What a vexing creature that was."
msgstr ""

#. ja: 配管と流砂を<br>利用してくるとはな…
#. de: Er war klug genug, die Rohre und den Sand zu seinem Vorteil zu nutzen<nbsp>... Bemerkenswert.
#. fr: Ça m'a surrrpris qu'il utilise ainsi son environnement...
msgctxt "NpcYell:18615:0:13"
msgid "To think it was clever enough to use the pipes and sand to its advantage..."
msgstr ""

#. ja: おい、あれ…<br>アレクサンドリア城か！？
#. de: I-Ist das etwa<nbsp>... Burg Alexandria?!
#. fr: Le château d'Alexandrie<nbsp>!?
msgctxt "NpcYell:18616:0:13"
msgid "Wait, is that...the castle!?"
msgstr ""

#. ja: 奥に見えるのは<br>もしかして…
#. de: Dieses Gebäude da vorne<nbsp>... Das ist doch nicht<nbsp>...?
#. fr: Ce bâtiment au loin... Ne serait-ce pas...
msgctxt "NpcYell:18617:0:13"
msgid "Look. Could that be...?"
msgstr ""

#. ja: アレクサンドリア城か…！？
#. de: Burg Alexandria?!
#. fr: Le château d'Alexandrie<nbsp>!?
msgctxt "NpcYell:18618:0:13"
msgid "...It's the castle!?"
msgstr ""

#. ja: ここからが本番ってか…<br>警戒しつつ進むぞ！
#. de: Jetzt wird's ernst<nbsp>... Haltet Augen und Ohren offen!
#. fr: Il est temps de passer aux choses sérieuses<nbsp>! Restez sur vos gardes.
msgctxt "NpcYell:18619:0:13"
msgid "We knew it wouldn't be easy. Let's stay strong and keep going!"
msgstr ""

#. ja: シェールさんとの<br>通信が途切れた…！？
#. de: Die Verbindung zu Shale scheint abgebrochen zu sein<nbsp>...!
#. fr: La communication avec Shale a été coupée<nbsp>!?
msgctxt "NpcYell:18620:0:13"
msgid "Was Shale's transmission cut off!?"
msgstr ""

#. ja: もしかして<br>この声の主がカリュクス…！
#. de: Könnte das Calyx Stimme sein?!
#. fr: Cette voix... C'est Calyx<nbsp>!?
msgctxt "NpcYell:18621:0:13"
msgid "That voice... Calyx!?"
msgstr ""

#. ja: あの機械兵で<br>力試しをするつもりか…？
#. de: Willst du dich wirklich mit diesem Maschinensoldaten anlegen<nbsp>...?
#. fr: Manifestement, il cherrrche à nous tester avec cette sentinelle mécanique.
msgctxt "NpcYell:18622:0:13"
msgid "Is he testing us against that mechanical soldier?"
msgstr ""

#. ja: 上等だ…<br>全部ぶっ飛ばしてやるぜ！
#. de: Denen werden wir's zeigen!
#. fr: S'il veut nous voir à l'œuvre, on va lui en donner pour son argent<nbsp>!
msgctxt "NpcYell:18623:0:13"
msgid "Fine by me. If he wants a show, let's give him one!"
msgstr ""

#. ja: 「副団長」…<br>上位の機体か何かか
#. de: „Vizekommandatin“? Die Maschine hat Befehle ausgeführt<nbsp>... Da scheint noch etwas Gefährlicheres auf uns zu warten.
#. fr: Cette unité avancée s'adrrressait à sa... vice-capitaine<nbsp>?
msgctxt "NpcYell:18624:0:13"
msgid "It was following orders... Does an even fiercer machine await us?"
msgstr ""

#. ja: うわっ！<br>急に出てきやがった！
#. de: Ah! Sie sind aus dem Nichts aufgetaucht!
#. fr: Ah<nbsp>! Je m'y attendais pas<nbsp>!
msgctxt "NpcYell:18625:0:13"
msgid "Gah! They came out of nowhere!"
msgstr ""

#. ja: びっくりした…！
#. de: Was für ein Schreck!
#. fr: Quelle frayeur<nbsp>!
msgctxt "NpcYell:18626:0:13"
msgid "What a fright!"
msgstr ""

#. ja: 扉を護っている…？
#. de: Wird die Tür etwa bewacht?
#. fr: La porte est gardée<nbsp>?
msgctxt "NpcYell:18627:0:13"
msgid "Is it guarding the door?"
msgstr ""

#. ja: 扉を護ってる奴が<br>いるな…
#. de: Sieht so aus, als ob man uns nicht so einfach passieren lassen wird<nbsp>...
#. fr: Cette porte a l'airrr bien gardée...
msgctxt "NpcYell:18628:0:13"
msgid "I don't believe it intends to let us pass..."
msgstr ""

#. ja: 奥になにかが<br>あるってことか…
#. de: Im Inneren muss sich irgendetwas von Bedeutung befinden.
#. fr: Ça signifie qu'il y a quelque chose à l'intérieurrr<nbsp>!
msgctxt "NpcYell:18629:0:13"
msgid "All the more reason to see just what lies beyond."
msgstr ""

#. ja: なんだありゃ…<br>石碑が浮かんでるぞ
#. de: Was ist das? Ein schwebender Stein?
#. fr: C'est quoi ce machin<nbsp>? Un rocher volant<nbsp>?
msgctxt "NpcYell:18630:0:13"
msgid "What is that? A floating rock?"
msgstr ""

#. ja: 刻まれているのは<br>国章かしら…？
#. de: Da ist etwas eingraviert<nbsp>... vielleicht das Wappen von Alexandria?
#. fr: Les armoiries d'Alexandrie sont gravées dessus<nbsp>?
msgctxt "NpcYell:18631:0:13"
msgid "Something's carved into it... Alexandria's emblem, perhaps?"
msgstr ""

#. ja: 何だ…？<br>離れていったぞ
#. de: Er verzieht sich wieder! Aber wohin<nbsp>...?
#. fr: Voilà qu'il s'éclipse, maintenant...
msgctxt "NpcYell:18632:0:13"
msgid "Huh? Where's it going?"
msgstr ""

#. ja: 配管を<br>移動している…？
#. de: Bewegt er sich auf die Rohre zu?
#. fr: Il se déplace sur les canalisations<nbsp>?
msgctxt "NpcYell:18633:0:13"
msgid "Is it moving along the pipes?"
msgstr ""

#. ja: 逃げたわけでは<br>ないか…
#. de: Ich glaube nicht, dass er flieht<nbsp>...
#. fr: Je ne pense pas qu'il se soit enfui...
msgctxt "NpcYell:18634:0:13"
msgid "I don't think it's trying to flee..."
msgstr ""

#. ja: どこに隠れた！？
#. de: Wo versteckt er sich?!
#. fr: Où est-ce qu'il s'est caché<nbsp>!?
msgctxt "NpcYell:18635:0:13"
msgid "Where did it hide!?"
msgstr ""

#. ja: みんな、警戒を！
#. de: Bleibt wachsam!
#. fr: Restez sur vos gardes<nbsp>!
msgctxt "NpcYell:18636:0:13"
msgid "On your guard, everyone!"
msgstr ""

#. ja: 不意打ち狙いか！
#. de: Ein Über<shy>raschungs<shy>angriff!
#. fr: Une attaque-surrrprise<nbsp>!
msgctxt "NpcYell:18637:0:13"
msgid "It means to catch us by surprise!"
msgstr ""

#. ja: また来るぞ！
#. de: Da ist er wieder!
#. fr: Il n'a pas dit son dernier mot<nbsp>!
msgctxt "NpcYell:18638:0:13"
msgid "Here it comes again!"
msgstr ""

#. ja: 厄介な相手ね…
#. de: Ein hartnäckiger Gegner<nbsp>...
#. fr: C'est un ennemi redoutable...
msgctxt "NpcYell:18639:0:13"
msgid "What a tiresome foe..."
msgstr ""

#. ja: 今度はあそこかっ！
#. de: Er hat seine Taktik geändert!
#. fr: Attention, le rrrevoilà<nbsp>!
msgctxt "NpcYell:18640:0:13"
msgid "This time... From over there!"
msgstr ""

#. ja: なっ、分身か！？
#. de: Kann er sich vervielfältigen?!
#. fr: Voilà qu'elle se dédouble en plus<nbsp>!?
msgctxt "NpcYell:18641:0:13"
msgid "What!? Copies!?"
msgstr ""

#. ja: これは<br>どういうこと…！？
#. de: Womit haben wir es hier zu tun?!
#. fr: Mais que se passe-t-il<nbsp>!?
msgctxt "NpcYell:18642:0:13"
msgid "What are we up against now?"
msgstr ""

#. ja: 高速で<br>動いてるのか…？
#. de: Er bewegt sich unglaublich schnell<nbsp>...
#. fr: Elle se déplace à une vitesse phénoménale<nbsp>!
msgctxt "NpcYell:18643:0:13"
msgid "It moves so quickly..."
msgstr ""

#. ja: 今度は<br>惑わされねぇぞ！
#. de: Darauf fallen wir nicht noch mal herein!
#. fr: La même technique ne marche jamais deux fois sur moi<nbsp>!
msgctxt "NpcYell:18644:0:13"
msgid "We won't be tricked again!"
msgstr ""

#. ja: 落ち着いて見れば…！
#. de: Konzentriert euch auf seine Bewegungen!
#. fr: Soyons attentifs à ses mouvements<nbsp>!
msgctxt "NpcYell:18645:0:13"
msgid "Focus and follow the movements!"
msgstr ""

#. ja: 大丈夫<br>避けられるはずだ！
#. de: Wir können dem Angriff ausweichen!
#. fr: On devrait pouvoirrr esquiver ça<nbsp>!
msgctxt "NpcYell:18646:0:13"
msgid "Remain calm─we can evade its attacks!"
msgstr ""

#. ja: ぶ、分身が増えた！？
#. de: Noch mehr?!
#. fr: Hein<nbsp>!? Encore plus de clones<nbsp>!?
msgctxt "NpcYell:18647:0:13"
msgid "Even more of them!?"
msgstr ""

#. ja: ああもう<br>目が回りそう…
#. de: Mir wird schon ganz schwindelig<nbsp>...
#. fr: Je... J'ai la tête qui tourne...
msgctxt "NpcYell:18648:0:13"
msgid "Ungh... My head is spinning..."
msgstr ""

#. ja: 相手も本気ってことか
#. de: Offenbar ist er bereit, bis zum bitteren Ende zu kämpfen<nbsp>...
#. fr: Visiblement, elle est prrrête à tout pour nous éliminer.
msgctxt "NpcYell:18649:0:13"
msgid "No doubt it will fight to the last..."
msgstr ""

#. ja: 何か動き出したぞ！
#. de: Das Ding hat sich bewegt!
#. fr: J'ai vu un truc bouger<nbsp>!
msgctxt "NpcYell:18650:0:13"
msgid "Those things started moving!"
msgstr ""

#. ja: 警戒してくれ！
#. de: Passt auf!
#. fr: Ne baissez pas votre garrrde<nbsp>!
msgctxt "NpcYell:18651:0:13"
msgid "Stay alert!"
msgstr ""

#. ja: また来るわ！
#. de: Er greift wieder an!
#. fr: Il attaque de nouveau<nbsp>!
msgctxt "NpcYell:18652:0:13"
msgid "It comes again!"
msgstr ""

#. ja: 安全な場所は…！？
#. de: Gibt es hier irgendeinen sicheren Ort?!
#. fr: Euh... C'est où l'endroit sûr<nbsp>!?
msgctxt "NpcYell:18653:0:13"
msgid "Is anywhere safe!?"
msgstr ""

#. ja: 出力があがってる…？
#. de: Werden seine Angriffe stärker?
#. fr: Son niveau d'énergie a augmenté, non<nbsp>?
msgctxt "NpcYell:18654:0:13"
msgid "Is the lightning intensifying?"
msgstr ""

#. ja: なんだか様子が…
#. de: Irgendwas ist komisch<nbsp>...
#. fr: Quelque chose se trrrame...
msgctxt "NpcYell:18655:0:13"
msgid "Something's different..."
msgstr ""

#. ja: そっちも動くのは<br>ズルだろ！
#. de: Der andere bewegt sich auch?! Das ist ungerecht!
#. fr: C'est dégueulasse de la changer de position<nbsp>! Tricheur<nbsp>!
msgctxt "NpcYell:18656:0:13"
msgid "Those move too!? No fair!"
msgstr ""

#. ja: 赤い光の位置が<br>変わった！？
#. de: Hat sich die Position des roten Lichts geändert?
#. fr: La lumière rouge s'est déplacée<nbsp>!?
msgctxt "NpcYell:18657:0:13"
msgid "The red light changed positions!"
msgstr ""

#. ja: 落ち着いて避けるんだ！
#. de: Beruhig dich und weiche aus, schnell!
#. fr: Prenons le temps d'obserrrver ses attaques pour mieux les esquiver<nbsp>!
msgctxt "NpcYell:18658:0:13"
msgid "Steel your nerves and make ready to dodge!"
msgstr ""

#. ja: 「エコーズの残滓」か…！
#. de: Eine Gruppe Echos<nbsp>...!
#. fr: ... Des Échos<nbsp>?
msgctxt "NpcYell:18659:0:13"
msgid "More echoes!?"
msgstr ""

#. ja: 蹴散らすしかなさそうだ！
#. de: Da müssen wir wohl durch!
#. fr: L'af<shy>fron<shy>te<shy>ment semble inévitable<nbsp>!
msgctxt "NpcYell:18660:0:13"
msgid "We must fight our way through."
msgstr ""

#. ja: 麒麟がなぜここに…！？
#. de: Ist das<nbsp>... Kirin<nbsp>...?! Aber wieso<nbsp>...?
#. fr: Kirin<nbsp>!? Mais que fait-il ici<nbsp>?
msgctxt "NpcYell:18661:0:13"
msgid "By the gods, it's Kirin!"
msgstr ""

#. ja: 奴らは…<br>気を引き締めてかかるぞ！
#. de: Noch mehr Gegner<nbsp>... Bleibt fokussiert!
#. fr: Même au milieu du ciel, ils ne nous laisseront pas respirer<nbsp>!
msgctxt "NpcYell:18662:0:13"
msgid "Make ready!"
msgstr ""

#. ja: 被害が広がっている<br>早く止めなければ！
#. de: Sie richten immer mehr Schaden an! Wir müssen sie aufhalten, schnell!
#. fr: Nous devons arrêter les dégâts avant qu'ils ne causent notre perte<nbsp>!
msgctxt "NpcYell:18663:0:13"
msgid "The airships are taking heavy damage. We must do something!"
msgstr ""

#. ja: 無事でよかった<br>さあ、下の船へ向かおう！
#. de: Es geht euch gut, ja? Dann weiter, zum unteren Schiff!
#. fr: Bien joué<nbsp>! Direction l'aéronef en dessous<nbsp>!
msgctxt "NpcYell:18664:0:13"
msgid "I'm glad you're safe. Come, let's keep moving."
msgstr ""

#. ja: 受けてみろ！
#. de: Nimm dies!
#. fr: Voilà pour vous<nbsp>!
msgctxt "NpcYell:18665:0:13"
msgid "Have at you!"
msgstr ""

#. ja: はぁっ！
#. de: Huaah!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:18666:0:13"
msgid "Hyah!"
msgstr ""

#. ja: これなら！
#. de: Und noch einer!
#. fr: Ce coup-là va faire mal<nbsp>!
msgctxt "NpcYell:18667:0:13"
msgid "Try this!"
msgstr ""

#. ja: 逃がさない！
#. de: Hiergeblieben!
#. fr: Vous ne m'échapperez pas<nbsp>!
msgctxt "NpcYell:18668:0:13"
msgid "You're mine!"
msgstr ""

#. ja: 大丈夫か！？
#. de: Seid ihr verletzt?
#. fr: Ça va aller<nbsp>!?
msgctxt "NpcYell:18669:0:13"
msgid "You'll not best me!"
msgstr ""

#. ja: やらせはしない！
#. de: Nicht mit mir!
#. fr: Vous devrez me passer sur le corps<nbsp>!
msgctxt "NpcYell:18670:0:13"
msgid "Is that all you've got?"
msgstr ""

#. ja: 我が魔法で！
#. de: Spürt meine Magie!
#. fr: Ma magie aura raison de vous<nbsp>!
msgctxt "NpcYell:18671:0:13"
msgid "By my hand!"
msgstr ""

#. ja: とらえた！
#. de: Erwischt!
#. fr: Touché<nbsp>!
msgctxt "NpcYell:18672:0:13"
msgid "There!"
msgstr ""

#. ja: 気を引き締めて<br>進みましょう
#. de: Gehen wir weiter<nbsp>... Aber bitte seid vorsichtig!
#. fr: Hâtons-nous, mais ne relâchons pas notre vigilance.
msgctxt "NpcYell:18673:0:13"
msgid "Let us press on."
msgstr ""

#. ja: 侵入者を検知しました
#. de: Eindringlinge erfasst.
#. fr: Intrus détectés.
msgctxt "NpcYell:18674:0:13"
msgid "Intruders detected."
msgstr ""

#. ja: 警告を省略…<br>排除します
#. de: Umgehende Terminierung eingeleitet ...!
#. fr: Lancement d'alerte omis. Élimination immédiate.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18675:0:13"
msgid "Issue no warnings.<br>Proceed to elimination."
msgstr ""

#. ja: ぜぇ…ぜぇ…
#. de: \<röchel> \<hust>
#. fr: (respire péniblement)
msgctxt "NpcYell:18676:0:13"
msgid "\\<wheeze>"
msgstr ""

#. ja: 胸が苦しいの…
#. de: Meine Brust<nbsp>... Es tut so weh ...!
#. fr: Ma poitrine... J'ai mal...
msgctxt "NpcYell:18677:0:13"
msgid "My chest hurts..."
msgstr ""

#. ja: 手足の感覚が…
#. de: Ich fühle meine Beine nicht mehr ...!
#. fr: Je ne sens plus mes bras ni mes jambes...
msgctxt "NpcYell:18678:0:13"
msgid "I can barely feel my legs..."
msgstr ""

#. ja: 死にたくない…<br>死にたくない…
#. de: Nein<nbsp>... Ich will nicht sterben<nbsp>...!
#. fr: Je veux pas mourir...<br>Je veux pas mourir...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18679:0:13"
msgid "I don't want to die...<br>Don't let me die..."
msgstr ""

#. ja: 患者たちに<br>危害は加えさせんぞ！
#. de: Finger weg von den Patienten!
#. fr: Vous ne toucherez pas à nos malades<nbsp>!
msgctxt "NpcYell:18680:0:13"
msgid "We won't let you harm our charges!"
msgstr ""

#. ja: 私たちが守らねば…！
#. de: Ihre Gesundheit ist unsere Verantwortung!
#. fr: On doit les protéger<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:18681:0:13"
msgid "You'll have to go through <i>me</i>!"
msgstr ""

#. ja: 蛮兵どもめ…！
#. de: Verdammte Barbaren ...!
#. fr: Salauds de barbares<nbsp>!
msgctxt "NpcYell:18682:0:13"
msgid "Enemy soldiers!"
msgstr ""

#. ja: 戦闘行動を開始します
#. de: 0
#. fr: 0
msgctxt "NpcYell:18683:0:13"
msgid "0"
msgstr ""

#. ja: 排除、排除、排除
#. de: 0
#. fr: 0
msgctxt "NpcYell:18684:0:13"
msgid "0"
msgstr ""

#. ja: おう…<br>てめェ新入りか？
#. de: Oho<nbsp>... Frischfleisch, hehe<nbsp>...
#. fr: Salut, toi... Alors, on est <if $gn4>nouvelle<else>nouveau</if><nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18685:0:13"
msgid "Oho...<br>New cellmates, is it?"
msgstr ""

#. ja: ヒヒヒ…<br>何やらかしたんだ？
#. de: Sag schon! Weswegen sitzt du?!
#. fr: Vous avez fait quoi pour finir au trou<nbsp>? Gnihihi...
msgctxt "NpcYell:18686:0:13"
msgid "\\<snicker> What'd you get done for, then?"
msgstr ""

#. ja: 俺たちが<br>ここの流儀を教えてやるよ！
#. de: Wir zeigen dir, wie's hier läuft!
#. fr: Vous allez apprendre la dure loi du mitard<nbsp>!
msgctxt "NpcYell:18687:0:13"
msgid "We'll show you how it works around here!"
msgstr ""

#. ja: 道具使っても<br>文句ねぇよなぁ？
#. de: Hilfsmittel sind erlaubt, oder? Hehe<nbsp>...
#. fr: C'est encore plus drôle avec des armes<nbsp>!
msgctxt "NpcYell:18688:0:13"
msgid "We've got just the tools for the job."
msgstr ""

#. ja: いい見世物だ<br>やっちまえ！
#. de: Statuieren wir ein Exempel. Los, macht <if $gn4>sie<else>ihn</if> fertig!
#. fr: On veut du spectacle<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18689:0:13"
msgid "You'll make a fine example!<br>Get 'em!"
msgstr ""

#. ja: 日頃の憂さ晴らし<br>させてもらうぜぇ？
#. de: Nicht übel nehmen. Danach geht's mir einfach besser, hehe!
#. fr: Venez qu'on rigole un peu<nbsp>!
msgctxt "NpcYell:18690:0:13"
msgid "Ah, a little light exercise!"
msgstr ""

#. ja: イヒヒヒヒ！
#. de: Ahahaha!
#. fr: Gniiihihihihi<nbsp>!!!
msgctxt "NpcYell:18691:0:13"
msgid "Hee hee hee!"
msgstr ""

#. ja: うぅ…
#. de: Ungh ...
#. fr: Ourgh...
msgctxt "NpcYell:18692:0:13"
msgid "\\<groan>"
msgstr ""

#. ja: 王城へ行けばきっと…<br>頑張って…！
#. de: Die Burg<nbsp>... ist sicher<nbsp>...
#. fr: On peut encore atteindre le château<nbsp>! Courage<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18693:0:13"
msgid "Keep going!<br>If we can just make it to the keep..."
msgstr ""

#. ja: 死んで…<br>たまるかよ…
#. de: Das darf noch nicht mein Ende sein ...!
#. fr: Ça peut pas finir comme ça...
msgctxt "NpcYell:18694:0:13"
msgid "I'll not...die here..."
msgstr ""

#. ja: リンドブルムの連中が…
#. de: Lindblum, die Hunde<nbsp>...
#. fr: Lindblum nous attaque...<nbsp>!
msgctxt "NpcYell:18695:0:13"
msgid "Those Lindblum bastards..."
msgstr ""

#. ja: 敵兵かッ！
#. de: Der Feind!
#. fr: Des troupes ennemies<nbsp>!
msgctxt "NpcYell:18696:0:13"
msgid "Invaders!"
msgstr ""

#. ja: これ以上は進ません！
#. de: Bis hierhin und nicht weiter!
#. fr: Vous n'irez pas plus loin<nbsp>!
msgctxt "NpcYell:18697:0:13"
msgid "You'll go no further!"
msgstr ""

#. ja: どれだけ足が震えようと<br>俺たちは国民を守る…！
#. de: Unser Schwur überschattet jegliche Angst. Wir beschützen das Volk ...!
#. fr: Même si la peur nous tenaille, nous défendrons le peuple<nbsp>!
msgctxt "NpcYell:18698:0:13"
msgid "Their legs may tremble, but our hearts are steady!"
msgstr ""

#. ja: ご慈悲を…！
#. de: O Barmherzigkeit!
#. fr: Ayez pitié<nbsp>!
msgctxt "NpcYell:18699:0:13"
msgid "Please, keep me safe!"
msgstr ""

#. ja: ううっ…<br>僕がもっと強ければ…
#. de: \<schnief> Wäre ich doch nur größer und stärker ...
#. fr: Urgh... Si seulement je savais me battre...
msgctxt "NpcYell:18700:0:13"
msgid "If only I could fight better..."
msgstr ""

#. ja: 汝の罪を…数えよ…
#. de: Sünden vergehen nicht ...
#. fr: Confessez vos crimes...
msgctxt "NpcYell:18701:0:13"
msgid "Let us count your crimes..."
msgstr ""

#. ja: 悔いて刑を待つがいい…
#. de: Erwarte deine rechtmäßige Strafe ...
#. fr: Repentez-vous en attendant votre châtiment...
msgctxt "NpcYell:18702:0:13"
msgid "Your sentencing awaits..."
msgstr ""

#. ja: 咎人に<br>ふさわしい罰を…！
#. de: Strafe, wem Strafe gebührt ...!
#. fr: Justice sera faite<nbsp>!
msgctxt "NpcYell:18703:0:13"
msgid "For each accused, a fitting punishment!"
msgstr ""

#. ja: 断罪の時だ…
#. de: Die Zeit der Läuterung ist gekommen ...
#. fr: L'heure des comptes a sonné...
msgctxt "NpcYell:18704:0:13"
msgid "The hour of the condemned is nigh..."
msgstr ""

#. ja: 死にたくない…
#. de: I-Ich will nicht sterben ...!
#. fr: Je veux pas mourir...
msgctxt "NpcYell:18705:0:13"
msgid "I don't want to die..."
msgstr ""

#. ja: 助けて…
#. de: Hil...fe<nbsp>...
#. fr: À l'aide...
msgctxt "NpcYell:18706:0:13"
msgid "Save me..."
msgstr ""

#. ja: 嫌だ、嫌だ…<br>もうたくさんだ…！
#. de: Genug<nbsp>... Genug! Mach, dass es aufhört!
#. fr: Je n'en peux plus... Trop, c'est trop<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18707:0:13"
msgid "No more!<br>I can't take any more..."
msgstr ""

#. ja: ハァ、ハァ、ハァ…
#. de: Ha<nbsp>... Ha<nbsp>... \<keuch>
#. fr: Haa... Haa... Haa...
msgctxt "NpcYell:18708:0:13"
msgid "\\<gasp> \\<pant>"
msgstr ""

#. ja: に、逃げないと…
#. de: R-Rennt ...! Alle weg da!
#. fr: N-nous devons fuir...
msgctxt "NpcYell:18709:0:13"
msgid "I-I have to get away from here..."
msgstr ""

#. ja: ひぃッ…！
#. de: Ahhh ...!
#. fr: Hiiiih<nbsp>!
msgctxt "NpcYell:18710:0:13"
msgid "Ah!"
msgstr ""

#. ja: ど、どこに<br>逃げれば…！？
#. de: Wo<nbsp>... Wohin nur ...?!
#. fr: N'y a-t-il pas d'échappatoire<nbsp>!?
msgctxt "NpcYell:18711:0:13"
msgid "There's...there's nowhere to run!"
msgstr ""

#. ja: うわぁぁ…！
#. de: Hyaaargh ...!
#. fr: Guaaargh<nbsp>!
msgctxt "NpcYell:18712:0:13"
msgid "Gaaah!"
msgstr ""

#. ja: たす…け…
#. de: Rett...et<nbsp>...
#. fr: Au se... cours...
msgctxt "NpcYell:18713:0:13"
msgid "Help...me..."
msgstr ""

#. ja: どうして…
#. de: W-Warum nur ...?!
#. fr: Pourquoi...<nbsp>?
msgctxt "NpcYell:18714:0:13"
msgid "Why...?"
msgstr ""

#. ja: 死にたく…な…
#. de: Will<nbsp>... ni...cht<nbsp>... sterb... hng<nbsp>...
#. fr: Pas... mou... rir...
msgctxt "NpcYell:18715:0:13"
msgid "Not...like this..."
msgstr ""

#. ja: あぁ…ぁ…
#. de: Ha<nbsp>... hach<nbsp>...
#. fr: Argh...
msgctxt "NpcYell:18716:0:13"
msgid "Aaahhh..."
msgstr ""

#. ja: おまえらの注目<br>いただきニャー！
#. de: Eure Miaufmerksamkeit bitte!
#. fr: Regardez-moi, miaou<nbsp>!
msgctxt "NpcYell:18717:0:13"
msgid "Meow! Your attention, please!"
msgstr ""

#. ja: 捕まえてみろニャ<br>そしたらご褒美ニャー
#. de: Fangt mich doch, wenn ihr könnt! Dann gibt's eine Belohnung!
#. fr: On joue à chat<nbsp>? C'est miaou qui commence<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18718:0:13"
msgid "Catch me if you can!<br>I'll make it worth your while!"
msgstr ""

#. ja: どこ見てるニャ？<br>こっちニャ
#. de: Hierher! Hierher, miau!
#. fr: Besoin d'un indice<nbsp>? Par ici, miaou<nbsp>!
msgctxt "NpcYell:18719:0:13"
msgid "Over here! Over here, meow!"
msgstr ""

#. ja: 何してるニャ？<br>こっち見ろニャ
#. de: Was ist los? Hier bin ich, miau!
#. fr: Miaou... Par là<nbsp>! Vous êtes vraiment pas dégourdis...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18720:0:13"
msgid "What's the matter?<br>I'm over here, meow!"
msgstr ""

#. ja: 目を離すなんて愚かニャ<br>ウチ、帰るニャ
#. de: Ihr wagt es, mich zu ignorieren?! Tja. Miadee.
#. fr: Si vous me regardez pas, je m'en vais, miaou.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18721:0:13"
msgid "How dare you ignore me!<br>I'm leaving, meow."
msgstr ""

#. ja: やんのかニャ！？<br>望むところニャ！
#. de: Euch balgen wollt ihr? Also gut!
#. fr: Vous voulez vous chamailler, c'est ça<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18722:0:13"
msgid "Gonna take me on, huh!?<br>Then give me all you got, meow!"
msgstr ""

#. ja: やーい、こっちニャ！<br>追いついてみろニャ！
#. de: Hier, hier! Fangt mich doch!
#. fr: Miaou<nbsp>! Essayez donc de me rattraper<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18723:0:13"
msgid "Over here!<br>Just try and catch me!"
msgstr ""

#. ja: 捕まえないと<br>ご褒美はなしニャー！
#. de: Trödler bekommen gar nichts!
#. fr: Attrapez-miaou si vous voulez le trésor<nbsp>!
msgctxt "NpcYell:18724:0:13"
msgid "No rewards for slowpokes!"
msgstr ""

#. ja: おまえら<br>なかなかやるニャ…
#. de: Der Sieg<nbsp>... ist euer. Miau<nbsp>...
#. fr: Vous êtes plutôt doués pour des humains...
msgctxt "NpcYell:18725:0:13"
msgid "We have a...winner... Meow..."
msgstr ""

#. ja: やれやれだニャ…<br>ウチ、もう帰るのニャ
#. de: Mir reicht's. Miadee.
#. fr: Si c'est comme chat, je rentre à la maison<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18726:0:13"
msgid "That's enough...<br>I'm leaving, meow."
msgstr ""

#. ja: ヨウコソ、ヨウコソ<br>オ品物ノ引キ出シデスカ？
#. de: Ein herzliches Willkommen! Wer ist bereit für tolle Preise?
#. fr: C'est pour... un retrait<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18727:0:13"
msgid "Initiating guest protocol...<br>Welcome! Here for fabulous prizes?"
msgstr ""

#. ja: 御用ガアレバ<br>オ声ガケヲ…！
#. de: Zögert nicht, mich zu rufen, wenn ich assistieren kann!
#. fr: Je suis là pour... vous servir<nbsp>!
msgctxt "NpcYell:18728:0:13"
msgid "Should you require my services, do not hesitate to call!"
msgstr ""

#. ja: ハァ、イソガシイイソガシイ
#. de: Viel zu tun, so viel zu tun!
#. fr: Tant de requêtes... à satisfaire...
msgctxt "NpcYell:18729:0:13"
msgid "So much to do! Yes, so very much!"
msgstr ""

#. ja: ハテ、アレハドコニヤッタカ…
#. de: Wo sind meine Gäste geblieben?
#. fr: Recherche... en cours...
msgctxt "NpcYell:18730:0:13"
msgid "Now, where are those guests..."
msgstr ""

#. ja: 御用ハナサソウデスネ<br>デハ、私ハコレニテ…
#. de: Meine Dienste werden wohl nicht länger benötigt. Dann entschuldige ich mich höflichst.
#. fr: Temps écoulé... Merci pour votre visite...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18731:0:13"
msgid "It appears my services are unrequired.<br>If you'll excuse me..."
msgstr ""

#. ja: オヤ、御用ガオアリデ？<br>承リマショウ
#. de: Ihr benötigt meine Dienste? Aber gerne!
#. fr: Je m'occupe de vous... tout de suite<nbsp>!
msgctxt "NpcYell:18732:0:13"
msgid "You have business with me? Very well!"
msgstr ""

#. ja: 乱暴ニサレテハ困リマス…！
#. de: Flegelhaftes Verhalten wird hier nicht geduldet!
#. fr: Veuillez ne pas... abîmer... la marchandise<nbsp>!
msgctxt "NpcYell:18733:0:13"
msgid "Wanton violence shall not be tolerated!"
msgstr ""

#. ja: オ客様、落チ着イテ…
#. de: Werte Gäste, bitte unterlasst diesen Unsinn!
#. fr: Votre sa<shy>tis<shy>fac<shy>tion est notre... priorité<nbsp>!
msgctxt "NpcYell:18734:0:13"
msgid "Dear guests, you must stop this folly at once!"
msgstr ""

#. ja: マタノ、オ越シヲ…
#. de: Beehrt uns<nbsp>... bald wieder<nbsp>...
#. fr: Revenez nous voir... bientôt...
msgctxt "NpcYell:18735:0:13"
msgid "P-Please...come again..."
msgstr ""

#. ja: 跪け…！
#. de: Kniet nieder<nbsp>...!
#. fr: À genoux<nbsp>!
msgctxt "NpcYell:18736:0:13"
msgid "Kneel!"
msgstr ""

#. ja: 所詮は虫けらよ…
#. de: Erbärmlich<nbsp>...
#. fr: Vous n'êtes que des parasites...
msgctxt "NpcYell:18737:0:13"
msgid "You are all vermin."
msgstr ""

#. ja: 小賢しい…！
#. de: Abscheuliche Arroganz<nbsp>...!
#. fr: Quelle insolence...
msgctxt "NpcYell:18738:0:13"
msgid "Insolent fool."
msgstr ""

#. ja: 慄け…！
#. de: Zittert<nbsp>...!
#. fr: Tremblez devant mon pouvoir<nbsp>!
msgctxt "NpcYell:18739:0:13"
msgid "Tremble!"
msgstr ""

#. ja: 消えろ…！
#. de: Aus meinen Augen!
#. fr: Disparaissez<nbsp>!
msgctxt "NpcYell:18740:0:13"
msgid "Disappear."
msgstr ""

#. ja: 排除する…！
#. de: Ich lösche euch aus<nbsp>...!
#. fr: Hors de ma vue, misérables<nbsp>!
msgctxt "NpcYell:18741:0:13"
msgid "Begone!"
msgstr ""

#. ja: 愚者に裁きを…！
#. de: Narren! Euer Urteil naht<nbsp>...!
#. fr: La mort est votre unique destin<nbsp>!
msgctxt "NpcYell:18742:0:13"
msgid "Accept your fate!"
msgstr ""

#. ja: ぐぁッ！
#. de: Grah!
#. fr: Aaargh<nbsp>!
msgctxt "NpcYell:18743:0:13"
msgid "Gah!"
msgstr ""

#. ja: ケーキヲ守ル！
#. de: BeScHüTzT dIe ToRtE!
#. fr: Protégez les gâteaux !
msgctxt "NpcYell:18744:0:13"
msgid "PrOtEcT tHe CaKe! PrOtEcT!!!"
msgstr ""

#. ja: ツマミ食イヲ許スナ…
#. de: <if $gn4>NaScHeRiN<else>NaScHeR</if> eNtDeCkT! BeStRaFeN!
#. fr: Punissez les vilains gourmands !
msgctxt "NpcYell:18745:0:13"
msgid "NiBbLiNg WiLl Be PuNiShEd!"
msgstr ""

#. ja: ドロボウ捕獲ッ！
#. de: <if $gn4>ToRtEnDiEbIn<else>ToRtEnDiEb</if> GeScHnApPt!
#. fr: Sus aux voleurs !
msgctxt "NpcYell:18746:0:13"
msgid "CaKe ThIeF aPpReHeNdEd!"
msgstr ""

#. ja: 時間はまだあるクポ！<br>どんどん作るクポ～！
#. de: Wir haben noch Zeit, kupo! Stellen wir weiter diese Torten fertig!
#. fr: Il reste encore du temps, kupo ! Continuez à préparer d'autres gâteaux !
msgctxt "NpcYell:18747:0:13"
msgid "There's still time, kupo! The more cakes the merrier!"
msgstr ""

#. ja: 才能あるクポ！<br>次も作るクポよ！
#. de: Du bist ein Naturtalent, kupo! Auf zur nächsten!
#. fr: Quel talent, kupo ! Allez, au suivant !
msgctxt "NpcYell:18748:0:13"
msgid "You're a natural, kupo! On to the next!"
msgstr ""

#. ja: ラストスパートだクポ！
#. de: Gib noch mal alles, kupo!
#. fr: C'est la dernière ligne droite, kupo ! Courage !
msgctxt "NpcYell:18749:0:13"
msgid "One final push, kupo!"
msgstr ""

#. ja: 伝説級にすっごい<br>ラブのパティシエだクポ！
#. de: Die Geburt einer Legende<nbsp>- <if $gn4>eine Meisterin<else>ein Meister</if> der Dekoration und Zuneigung, kupo!
#. fr: Incroyable, kupo ! Vous faites partie de la crème de la crème des pâtissiers, kupo !
msgctxt "NpcYell:18750:0:13"
msgid "'Tis the birth of a legend─master of confection and affection alike, kupo!"
msgstr ""

#. ja: お見事クポ！<br>たくさん作れたクポね！
#. de: Sieh sich einer all diese Torten an! Ich komme kaum noch hinterher, kupo!
#. fr: Bravo, kupo ! On a maintenant plein de beaux gâteaux prêts pour la dégustation !
msgctxt "NpcYell:18751:0:13"
msgid "Just look at all these cakes! I can scarely keep pace, kupo!"
msgstr ""

#. ja: ケーキ作りの才能に<br>あふれてるクポ…！
#. de: Du hast echt den Dreh fürs Dekorieren raus, kupo!
#. fr: Vous avez du talent à revendre en pâtisserie, kupo !
msgctxt "NpcYell:18752:0:13"
msgid "You have a real knack for this cake decorating business, kupo!"
msgstr ""

#. ja: ひよっこパティシエは<br>卒業クポね！
#. de: Damit bist du <if $gn4>eine vollwertige Konditorin<else>ein vollwertiger Konditor</if>, kupo!
#. fr: C'est pas mal ! Je vous donne la mention honorable, kupo !
msgctxt "NpcYell:18753:0:13"
msgid "With this, you're a fully fledged pâtissier, kupo!"
msgstr ""

#. ja: ヴァレンティオンデーには<br>ハートが大事クポ！
#. de: Nun, du warst mit ganzem Herzen bei der Sache<nbsp>- und darum geht es beim Valentiontag schließlich, kupo!
#. fr: Pour la Valention, il faut y mettre du cœur, kupo !
msgctxt "NpcYell:18754:0:13"
msgid "The most important thing for Valentione's Day is to put your heart into it, kupo!"
msgstr ""

#. ja: ラブのお届けならずクポ…
#. de: Leider hat diese Liebe keine Früchte getragen<nbsp>...
#. fr: Vous n'y avez pas mis assez d'amour, kupo...
msgctxt "NpcYell:18755:0:13"
msgid "Alas, this love came not to fruition..."
msgstr ""

#. ja: 待テー！
#. de: SoFoRt StEhEn BlEiBeN!
#. fr: Rends-toi, gredin !
msgctxt "NpcYell:18756:0:13"
msgid "HaLt RiGhT tHeRe!"
msgstr ""

#. ja: あの森は…<br>ロンフォールなのか？
#. de: Dieser Wald<nbsp>... Ist das wirklich Ronfaure?
#. fr: Cette forêt... Est-ce vraiment le Ronfaure<nbsp>?
msgctxt "NpcYell:18757:0:13"
msgid "Is that forest...Ronfaure?"
msgstr ""

#. ja: ひとまず落ち着いたか…
#. de: Die Lage scheint sich vorerst beruhigt zu haben<nbsp>...
#. fr: La situation semble s'être apaisée...
msgctxt "NpcYell:18758:0:13"
msgid "That appears to be the last of them."
msgstr ""

#. ja: あの光は…？
#. de: Dieses Licht<nbsp>...!
#. fr: Cette lumière...<nbsp>!
msgctxt "NpcYell:18759:0:13"
msgid "What is that light...?"
msgstr ""

#. ja: これはいったい…！？<br>気をつけるんだ！
#. de: Was zum<nbsp>...?! Vorsicht!
#. fr: Attention danger<nbsp>!
msgctxt "NpcYell:18760:0:13"
msgid "Careful!"
msgstr ""

#. ja: くっ…！
#. de: Ugh<nbsp>...!
#. fr: Urgh...<nbsp>!
msgctxt "NpcYell:18761:0:13"
msgid "Ungh..."
msgstr ""

#. ja: 気流に乗って飛び移るぞ！
#. de: Ein beherzter Sprung in den Luftstrom<nbsp>... Und hepp!
#. fr: C'est l'heure du grand plongeon dans les courants aériens<nbsp>!
msgctxt "NpcYell:18762:0:13"
msgid "The currents will carry us. Come!"
msgstr ""

#. ja: 急ごう！
#. de: Beeilung!
#. fr: Dépêchons-nous<nbsp>!
msgctxt "NpcYell:18763:0:13"
msgid "Hurry!"
msgstr ""

#. ja: 我が全霊をもって…
#. de: Für Alexandria ...!
#. fr: Même si je dois y laisser mon âme...
msgctxt "NpcYell:18764:0:13"
msgid "With faith and steel..."
msgstr ""

#. ja: 家族を…<br>隣人を守るッ！
#. de: Unsere Familien<nbsp>... Unsere Nachbarn<nbsp>... Wir lassen das nicht zu!
#. fr: Pour ma famille et mes proches<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18765:0:13"
msgid "For my family!<br>For my people!"
msgstr ""

#. ja: 先へ進み<br>サレージャを探そう！
#. de: Los, weiter! Sareel Ja kann nicht mehr weit sein!
#. fr: Continuons, Sareel Ja ne devrait plus être très loin<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18766:0:13"
msgid "Let's keep moving!<br>Sareel Ja has to be here somewhere."
msgstr ""

#. ja: 何だこれ！？
#. de: W-Was zum?!
#. fr: Qu'est-ce qui m'arrive<nbsp>!?
msgctxt "NpcYell:18767:0:13"
msgid "What was that!?"
msgstr ""

#. ja: くっ…<br>薬物で感覚を！？
#. de: Vernebelt er unsere Sinne?!
#. fr: Ugh... Un produit qui trrrouble les sens<nbsp>!?
msgctxt "NpcYell:18768:0:13"
msgid "A toxin!?"
msgstr ""

#. ja: 感覚が…おかしい…？
#. de: Was ... Was ist das bloß ...?
#. fr: Je me sens bizarre...<nbsp>!
msgctxt "NpcYell:18769:0:13"
msgid "I feel...numb..."
msgstr ""

#. ja: 何をしたの！？
#. de: Ist das etwa eine Art Betäubung?!
#. fr: C'était quoi, cette purée de pois<nbsp>!?
msgctxt "NpcYell:18770:0:13"
msgid "What did he do to us!?"
msgstr ""

#. ja: 薬の効果なの…？
#. de: Medizin ...?
#. fr: C'est l'effet du produit chimique<nbsp>?
msgctxt "NpcYell:18771:0:13"
msgid "Some noxious spray..."
msgstr ""

#. ja: 厄介ね…
#. de: Das könnte übel enden ...
#. fr: Une arme redoutable...
msgctxt "NpcYell:18772:0:13"
msgid "This complicates things..."
msgstr ""

#. ja: 落ち着いて対処しよう
#. de: Nur die Ruhe bewahren!
#. fr: Du calme, on va s'en sortir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18773:0:13"
msgid "Stay calm.<br>We fight through it."
msgstr ""

#. ja: また、あの薬が来るぞ！
#. de: Schon wieder diese Medizin!
#. fr: 'tention, il va rebalancer la purée<nbsp>!
msgctxt "NpcYell:18774:0:13"
msgid "It's that toxic spray again!"
msgstr ""

#. ja: 薬物を使う気だ<br>注意してくれ！
#. de: Aufgepasst, er versucht es erneut!
#. fr: Il n'en a pas fini avec sa cochonnerie chimique<nbsp>! Prenez garrrde<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18775:0:13"
msgid "Careful!<br>He means to use that spray!"
msgstr ""

#. ja: みんな、薬に気を付けて！
#. de: Er nutzt wieder seine Medizin<nbsp>- Vorsicht!
#. fr: Attention à la substance qu'il envoie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18776:0:13"
msgid "The numbing spray!<br>Watch out, everyone!"
msgstr ""

#. ja: さっきの薬がくるわよ！
#. de: Ts<nbsp>... Der und seine Medizin immer<nbsp>...
#. fr: La dose de rappel arrive<nbsp>!
msgctxt "NpcYell:18777:0:13"
msgid "Here comes that spray again!"
msgstr ""

#. ja: また薬がまかれるわ！
#. de: Etwa noch einmal?!
#. fr: Il va nous asperger de nouveau<nbsp>!
msgctxt "NpcYell:18778:0:13"
msgid "Ware the toxic spray!"
msgstr ""

#. ja: 薬液を散布するつもりよ！
#. de: Er will uns wohl erneut betäuben!
#. fr: Il compte recouvrir le sol de produit<nbsp>!?
msgctxt "NpcYell:18779:0:13"
msgid "He's preparing another dose!"
msgstr ""

#. ja: 注意しよう！<br>さきほどの薬だ！
#. de: Vorsicht vor dem Medizinteppich!
#. fr: Faites attention<nbsp>! Il va réutiliser la même substance<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18780:0:13"
msgid "Brace yourselves!<br>He readies his toxic spray!"
msgstr ""

#. ja: うおっ！？<br>鎖が…！
#. de: Ketten?! Wo kommen die denn her?
#. fr: Ouah<nbsp>! C'est quoi, cette chaîne<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18781:0:13"
msgid "Wha─!?<br>We've been chained!"
msgstr ""

#. ja: ここからは<br>一対一ってことか
#. de: Ab hier geht es wohl im Duell weiter.
#. fr: On se retrrrouve chacun en un contre un...
msgctxt "NpcYell:18782:0:13"
msgid "'Tis to be a duel, then?"
msgstr ""

#. ja: いいよ…<br>私が受け止めてあげる
#. de: Nun gut<nbsp>... So soll es sein!
#. fr: Soit... J'accepte ce duel.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18783:0:13"
msgid "Very well.<br>I will fight you myself."
msgstr ""

#. ja: 上等じゃない！
#. de: Pah, dann eben so!
#. fr: Hé, c'est pas du jeu<nbsp>!
msgctxt "NpcYell:18784:0:13"
msgid "This is fine by me!"
msgstr ""

#. ja: 分断された！？
#. de: Wir wurden aufgeteilt!?
#. fr: Ils veulent nous diviser<nbsp>!?
msgctxt "NpcYell:18785:0:13"
msgid "They've split us up!"
msgstr ""

#. ja: ほかの3人は…<br>心配いらないわね
#. de: Um euch muss ich mir wohl keine Sorgen machen, hm?
#. fr: Ça ira... J'ai confiance en vous trois.
msgctxt "NpcYell:18786:0:13"
msgid "The others...can handle themselves, I'm sure."
msgstr ""

#. ja: おや…<br>引き離されてしまったね
#. de: So war das aber nicht geplant. Nun denn<nbsp>...
#. fr: Eh bien, nous voilà séparés de force...
msgctxt "NpcYell:18787:0:13"
msgid "Hm. Hoping to divide and conquer?"
msgstr ""

#. ja: 周りの風景が…！
#. de: Sieh sich das mal einer an<nbsp>... Die Umgebung!
#. fr: D'où elles sortent, toutes ces maisons<nbsp>!?
msgctxt "NpcYell:18788:0:13"
msgid "What's happening!?"
msgstr ""

#. ja: 風景が変わったな
#. de: Eine Vision des Kriegs ...?
#. fr: Le décorrr a changé, on dirait.
msgctxt "NpcYell:18789:0:13"
msgid "A new stage for us to fight on..."
msgstr ""

#. ja: これも記憶の再現なのか？
#. de: Um was für Erinnerungen handelt es sich diesmal?
#. fr: Une autre reconstitution mémorielle<nbsp>?
msgctxt "NpcYell:18790:0:13"
msgid "Another recreation?"
msgstr ""

#. ja: 永久人たちが…<br>許せない、カリュクス…！
#. de: Die Endlosen<nbsp>... Das geht zu weit, Calyx!
#. fr: Les Éternels... Calyx, comment oses-tu<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18791:0:13"
msgid "The Endless...<br>You go too far, Calyx!"
msgstr ""

#. ja: 嫌な予感がするぜ…！
#. de: Irgendwas kommt da ...!
#. fr: Je le sens mal...
msgctxt "NpcYell:18792:0:13"
msgid "I don't like the looks of this!"
msgstr ""

#. ja: 気を付けて！<br>何か来るわよ！
#. de: Da stimmt etwas nicht. Passt auf!
#. fr: Attention à ce qui arrive<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18793:0:13"
msgid "Keep sharp!<br>Something's happening!"
msgstr ""

#. ja: この様子…<br>ただ事じゃないわね
#. de: Es ist allerhöchste Vorsicht geboten!
#. fr: Cette configuration ne me dit rien qui vaille...
msgctxt "NpcYell:18794:0:13"
msgid "This is building to something..."
msgstr ""

#. ja: 何か来るわ！<br>警戒して！
#. de: Haltet die Augen offen, sonst erwischt es euch!
#. fr: Ça va barder<nbsp>! Restez sur vos gardes<nbsp>!
msgctxt "NpcYell:18795:0:13"
msgid "Be on your guard!"
msgstr ""

#. ja: ひでえ…<br>焼け野原だ…
#. de: Alles weggebrannt<nbsp>... Wie schrecklich<nbsp>...
#. fr: Affreux, ce décor de ville incendiée...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18796:0:13"
msgid "By the sunken gods...<br>Everything's burning..."
msgstr ""

#. ja: また風景が…<br>攻撃も変わりそうだ
#. de: Eine weitere Vision. Was erwartet uns diesmal?
#. fr: Un nouveau décorrr... et de nouvelles façons d'attaquer, je suppose...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18797:0:13"
msgid "Another change...<br>Along with new threats, I expect."
msgstr ""

#. ja: 時代が進んだみたいだね
#. de: Die Zeit scheint vorangeschritten zu sein.
#. fr: On croirait faire un saut dans le temps...
msgctxt "NpcYell:18798:0:13"
msgid "We've moved forward in time."
msgstr ""

#. ja: 仕掛けてくるよ…！
#. de: Da kommt etwas ...!
#. fr: Il passe à l'attaque<nbsp>!
msgctxt "NpcYell:18799:0:13"
msgid "Here it comes!"
msgstr ""

#. ja: 今度は何だ！？
#. de: Was jetzt?!
#. fr: Qu'est-ce qu'il nous prépare encore<nbsp>!?
msgctxt "NpcYell:18800:0:13"
msgid "Now what!?"
msgstr ""

#. ja: また何か来るわよ！
#. de: Da kommt etwas Neues!
#. fr: Ça sent à nouveau les ennuis<nbsp>!
msgctxt "NpcYell:18801:0:13"
msgid "We're in for another surprise!"
msgstr ""

#. ja: みんな<br>気を付けて！
#. de: Passt auf!
#. fr: Attention, tout le monde<nbsp>!
msgctxt "NpcYell:18802:0:13"
msgid "On your toes, everyone!"
msgstr ""

#. ja: 注意してちょうだい！
#. de: Wehe, ihr lasst euch treffen!
#. fr: Surtout, ouvrez l'œil<nbsp>!
msgctxt "NpcYell:18803:0:13"
msgid "Watch yourselves!"
msgstr ""

#. ja: まただ…！<br>雷が激しくなるぞ！
#. de: Das war's noch nicht. Schau sich einer diese Blitze an!
#. fr: Ça bouge encore<nbsp>! Maintenant, le ciel gronde<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18804:0:13"
msgid "And again!<br>The lightning's getting worse!"
msgstr ""

#. ja: 戦火が激しくなっていく…
#. de: Die Flammen des Krieges werden weiter entfacht<nbsp>...
#. fr: Il redouble d'agrrressivité<nbsp>!
msgctxt "NpcYell:18805:0:13"
msgid "The fighting grows in intensity..."
msgstr ""

#. ja: 永久人たちの<br>恐怖が募っていく…
#. de: Die Furcht der Endlosen nimmt weiter zu<nbsp>...
#. fr: La terreur des Éternels ne cesse de grandir...
msgctxt "NpcYell:18806:0:13"
msgid "The fear of these Endless is palpable..."
msgstr ""

#. ja: みんな…すぐに<br>終わらせてあげるから…！
#. de: Ich werde diesem Schrecken ein Ende bereiten! Ich verspreche es!
#. fr: Courage... Nous allons en finir, je vous le promets<nbsp>!
msgctxt "NpcYell:18807:0:13"
msgid "We will bring an end to this, I promise you!"
msgstr ""

#. ja: いい加減にしやがれ！
#. de: Jetzt reicht's aber!
#. fr: Dites-moi que c'est pas vrai...<nbsp>!
msgctxt "NpcYell:18808:0:13"
msgid "You go too far!"
msgstr ""

#. ja: 次から次へと…！
#. de: Pures Chaos<nbsp>...
#. fr: Ugh, ça s'arrête jamais...
msgctxt "NpcYell:18809:0:13"
msgid "This is relentless!"
msgstr ""

#. ja: 永久人たちの恐怖が…
#. de: Es wird immer schlimmer<nbsp>...
#. fr: Les Éternels sont terrorisés...
msgctxt "NpcYell:18810:0:13"
msgid "So much terror..."
msgstr ""

#. ja: 何度やっても同じよ！
#. de: Damit kriegst du mich nur beim ersten Mal, ha!
#. fr: Il aura beau se déchaîner, on tiendra bon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18811:0:13"
msgid "Test us again and again.<br>You will not find us wanting!"
msgstr ""

#. ja: みんな真ん中に集まれ！
#. de: Alle zusammen in die Mitte!
#. fr: Tout le monde avec moi<nbsp>!
msgctxt "NpcYell:18812:0:13"
msgid "Everyone, gather in the middle!"
msgstr ""

#. ja: 中央で受けるぞ！
#. de: Wir stehen zusammen!
#. fr: Regroupons-nous au centrrre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18813:0:13"
msgid "The center of the battlefield!<br>We bear it together!"
msgstr ""

#. ja: 急いで中央へ！
#. de: Schnell in die Mitte!
#. fr: Vite, tous au milieu<nbsp>!
msgctxt "NpcYell:18814:0:13"
msgid "Quickly! To the middle!"
msgstr ""

#. ja: 突き刺せ！
#. de: Durchbohre sie!
#. fr: Vous allez finir empalés<nbsp>!
msgctxt "NpcYell:18815:0:13"
msgid "My javelin pierces all!"
msgstr ""

#. ja: そら、魔法もいくよ
#. de: Auch die Magie ist mir nicht fremd.
#. fr: Je sais faire des sorts de magie aussi, qu'est-ce que vous croyez<nbsp>?
msgctxt "NpcYell:18816:0:13"
msgid "Perhaps some magic in the mix."
msgstr ""

#. ja: アハハッ、回れ回れ！
#. de: Ahaha, immer weiter im Kreis!
#. fr: Ha ha ha ha<nbsp>!! Tourne, tourne, mon manège<nbsp>!
msgctxt "NpcYell:18817:0:13"
msgid "Round and round they go!"
msgstr ""

#. ja: この技で遊んでみようか
#. de: Probieren wir einmal das hier aus.
#. fr: Et qu'est-ce que vous dites de ça<nbsp>? Amusant, non<nbsp>?
msgctxt "NpcYell:18818:0:13"
msgid "Let's try this."
msgstr ""

#. ja: 消えちゃいな
#. de: Auf Nimmer<shy>wieder<shy>sehen.
#. fr: Je commence à m'ennuyer un peu... Et si vous creviez<nbsp>?
msgctxt "NpcYell:18819:0:13"
msgid "Begone!"
msgstr ""

#. ja: 僕が、答えを与えてあげるよ
#. de: Ich werde euch mit euren Antworten segnen.
#. fr: Les questions que vous vous posez depuis toujours... Vous en obtiendrez les réponses à Tu'Lia.
msgctxt "NpcYell:18820:0:13"
msgid "Have you the strength to find the answers you seek?"
msgstr ""

#. ja: おうッ、来てくれたな！<br>この星でもばっちり活動できるよう、基地を立派にしていくぞッ！
#. de: Sehr schön, wir können jede Unterstützung gebrauchen! Sobald diese Basis fertig ist, steht der Erkundung auf Phaenna nichts mehr im Weg!
#. fr: Ah, vous voilà<nbsp>! Que le travaux commencent<nbsp>! Nouvelle planète, nouvelle base... donnez-vous à fond ici aussi<nbsp>!
msgctxt "NpcYell:18821:0:13"
msgid "Ah, we've got quite the crew gathered here! Together we shall build a base from which we will explore every corner of this star!"
msgstr ""

#. ja: ガラスの地面に施設をしかと据えられるよう、基礎工事をするんだ。<br>作業して出てきたガラス塵も、吸い込んでやってくれ！
#. de: Zuerst der Grundbau, damit sich unsere Ausstattung auch ordentlich auf diesem Glasboden verankern lässt. Den Glasstaub, der dabei entsteht, könnt ihr einfach einsaugen!
#. fr: Il faut installer des fondations solides dans la couche de verre au sol. Et n'oubliez pas d'aspirer les poussières qui se dégageront des travaux<nbsp>!
msgctxt "NpcYell:18822:0:13"
msgid "First we'll have to build the foundation so our facilities can be properly anchored to the glass surface. Make sure to vacuum up the glass dust before it piles up!"
msgstr ""

#. ja: 移動設備「コスモライナー」の建設を行ってくぞッ！<br>研究チームが移動しやすくなれば、うんと探索も進むってもんだ！
#. de: Diesmal kümmern wir uns um den Kosmozapper! Wenn sich die Forscher einfacher fortbewegen können, bringt das auch die Erkundung in Schwung!
#. fr: On va pouvoir installer un réseau de cosmo-navettes<nbsp>! Une fois que nos équipes pourront se déplacer sans encombre, le projet pourra progresser encore plus rapidement<nbsp>!
msgctxt "NpcYell:18823:0:13"
msgid "Our next step is to build the Cosmoliner! Once our research team can zip back and forth across Phaenna, we'll be able to ramp up our exploration!"
msgstr ""

#. ja: ミニローダーには、複雑な組み立てや溶接を任せてる。<br>コスモライナー用の資材に、最終工程を加えてくんだッ！
#. de: Die Minimechas über<shy>nehmen das komplizierte Zusammenbauen und Verschweißen! Wir geben den Bauteilen dann den letzten Schliff!
#. fr: Les ouvriers cosmiques vont se charger du montage et des soudures. C'est le dernier processus dans la con<shy>struc<shy>tion du réseau de cosmo-navettes<nbsp>!
msgctxt "NpcYell:18824:0:13"
msgid "Leave the complicated assembly and welding to the mini rovers. Your job is to put the finishing touches to the Cosmoliner's components!"
msgstr ""

#. ja: 「居住モジュール」の建設を行って、<br>計画参加者たちの受け入れ態勢を強化するぞッ！
#. de: Sobald die Habitationsmodule stehen, können sich hier noch mehr Helfer wie zu Hause fühlen! Auf geht's!
#. fr: De beaux modules d'habitation nous permettront d'attirer plus de par<shy>ti<shy>ci<shy>pants au projet d'exploration<nbsp>!
msgctxt "NpcYell:18825:0:13"
msgid "Homey, comfortable habitation modules will help us house more eager workers! Let's get started!"
msgstr ""

#. ja: 居住モジュールのフレームや床材を組み立ててくぜッ！<br>複雑な組み立てや溶接は、ミニローダーがやってくれるからよ！
#. de: So, wir basteln die Rahmen und Bodenplatten für die Module zusammen! Das komplizierte Zusammenbauen und Verschweißen könnt ihr den Minimechas überlassen!
#. fr: On va assembler les cadres et les planchers des modules d'habitation. Laissez les ouvriers cosmiques se charger des tâches complexes et des soudures<nbsp>!
msgctxt "NpcYell:18826:0:13"
msgid "Time to put together the frames and flooring for the habitation modules! Leave assembly and welding to the mini rovers!"
msgstr ""

#. ja: 今後の探索に必要な雷力を得るため、エネルギー設備を造るぞッ！<br>環境エーテルを変換して、雷気を貯められるようにすんだ！
#. de: Größere Projekte benötigen mehr Energie und damit auch Energisierungswerke. Mit denen können wir den Umgebungsäther in Strom umwandeln!
#. fr: Il nous faut de meilleures ins<shy>tal<shy>la<shy>tions énergétiques si on veut poursuivre notre exploration de la planète. En convertissant l'éther environnemental, on devrait pouvoir stocker l'énergie de foudre<nbsp>!
msgctxt "NpcYell:18827:0:13"
msgid "Further exploration will require even more energization! These facilities will allow us to convert ambient aether into usable electricity!"
msgstr ""

#. ja: お前らにはミニローダーの面倒を見てもらいたい！<br>設備の危ねえとこの作業は、こいつらに任せられるからよ！
#. de: Ihr kümmert euch um die Minimechas, die Minimechas kümmern sich um die gefährlichen Arbeiten. Der perfekte Plan, nicht wahr?
#. fr: Je veux que vous vous occupiez des ouvriers cosmiques<nbsp>! Ils sont parfaits pour gérer les tâches les plus dangereuses, mais il faut garder un œil sur eux.
msgctxt "NpcYell:18828:0:13"
msgid "Take care of the mini rovers, and they'll do the dangerous work for you! A perfect working relationship!"
msgstr ""

#. ja: ヒトが必要とする「水」のために、給水設備の整備を行うッ！<br>付近の水脈から汲み上げて、安全な水に浄水すんだ！
#. de: Auch in den Weiten des Alls ist Wasser eine Notwendigkeit. Deshalb stehen als Nächstes die Hydrofizierungswerke auf dem Plan. Die können unterirdisches Wasser fördern und aufbereiten!
#. fr: Les humains ne peuvent pas survivre sans eau, alors il faut développer nos  infrastructures de dis<shy>tri<shy>bu<shy>tion. En pompant une source proche, on devrait pouvoir la convertir en eau potable<nbsp>!
msgctxt "NpcYell:18829:0:13"
msgid "In the vastness of space, water is an invaluable resource! Building hydrofication stations will allow us to extract and purify underground water!"
msgstr ""

#. ja: 浄水機構には、エーテル伝導性の高い繊細な部品も多いんだ。<br>そのためにもミニローダーが役立つってワケよ！
#. de: Gerade die Säuberungsanlage besteht aus vielen sensiblen Teilen mit hoher Ätherleitfähigkeit. Das schreit geradezu nach einer Arbeit für die Minimechas, was?
#. fr: Les purificateurs d'eau comportent de nombreuses pièces sensibles et conductrices d'éther. C'est dans ce genre de situation que les ouvriers cosmiques se montrent utiles<nbsp>!
msgctxt "NpcYell:18830:0:13"
msgid "The purification system is full of highly conductive and intricate parts─a job for the mini rovers, methinks!"
msgstr ""

#. ja: お前ら、この基地の一帯を立派に舗装して、<br>より安全かつコスモでグレートな感じに仕上げるぞッ！
#. de: So, es wird Zeit, diesen Abschnitt zu festigen! Dadurch wir die Basis sicherer, kosmischer ... und vor allem größer!
#. fr: Grâce à votre aide, on va pouvoir paver le sol comme il faut, et construire la station la plus sûre de tout le cosmos<nbsp>!
msgctxt "NpcYell:18831:0:13"
msgid "All right, it's time to reinforce this area of the base! When we're done, it'll be safer and more cosmotastic than ever before!"
msgstr ""

#. ja: ガラス岩盤を丁寧に相手しながら、<br>適時、施工作業も進めてくれッ！
#. de: Habt ein Auge auf den Glasboden, aber vernachlässigt dabei nicht die restlichen Arbeiten, hört ihr?
#. fr: Continuez les travaux à ce rythme, tout en gardant un œil sur la couche de verre au sol.
msgctxt "NpcYell:18832:0:13"
msgid "Keep a careful eye on the glass foundation, but don't let our other work fall by the wayside!"
msgstr ""

#. ja: ここにクレーンを建設して通路を吊るし、<br>大穴への探索の道を作るんだッ！
#. de: Je schneller wir die Kräne hier aufgebaut und Wege herabgelassen haben, umso eher können wir den Abgrund erkunden!
#. fr: Voilà l'endroit parfait pour monter les grues<nbsp>! Avec leurs plateformes, elles nous permettront d'aller explorer le fond de ce cratère<nbsp>!
msgctxt "NpcYell:18833:0:13"
msgid "Once the crane network and walkways are installed, we'll be able to delve into the depths of the crater!"
msgstr ""

#. ja: ガラスの河が流れ込む底には、まったく異なる環境が広がってる……<br>探索活動も、ハチャメチャ充実するってもんなワケだッ！
#. de: Die Umgebung da unten, wo das ganze Wasser des Weichglasspiegels herunterstürzt, ist komplett anders als hier! Aber das lässt den Erkundungsdrang nur stärker werden, nicht wahr?
#. fr: Il existe un monde com<shy>plè<shy>te<shy>ment différent de la surface au fond de la rivière de verre... Y a pas à dire, l'exploration c'est ma passion<nbsp>!
msgctxt "NpcYell:18834:0:13"
msgid "You can see how far down the glass flows, eh? Down there an entirely new environment awaits intrepid explorers! Gets your heart pounding, doesn't it?"
msgstr ""

#. ja: 「コスモポート」を高性能に改良するぞッ！<br>より彼方へと、宇宙船が出発するための施設だ！
#. de: Dann wollen wir mal sehen, was sich aus dem Kosmoport noch rausholen lässt! Damit uns die <i>Galacticway</i> noch viel weiter tragen kann!
#. fr: Il est temps de rendre le cosmoport encore plus fonctionnel<nbsp>! Nos vaisseaux partiront d'ici pour explorer les recoins de l'univers<nbsp>!
msgctxt "NpcYell:18835:0:13"
msgid "The cosmoport is good, but we can make it great! Soon our ships will convey us to the furthest reaches of the firmament!"
msgstr ""

#. ja: 専用のエネルギー設備を増設してパワーアップ！<br>船の行ったり来たりがもっとスムーズになるはずだぜッ！
#. de: Zuerst bekommt das gute Stück jetzt eine eigene Energieversorgung! Das sollte künftige Raumschiffreisen deutlich vereinfachen!
#. fr: Il faut constuire une nouvelle station énergétique pour subvenir à nos besoins. Les allées et venues des vaisseaux seront ainsi plus fréquentes<nbsp>!
msgctxt "NpcYell:18836:0:13"
msgid "To start, we'll need to build a dedicated power supply! The first step towards a brighter future for space travel!"
msgstr ""

#. ja: お前ら、大事なメカたちをメンテナンスするためのハンガーを、<br>コスモでグレートな感じにしてやるぞッ！
#. de: Unsere Mechas arbeiten immer ohne Murren für uns, sie haben sich einen besseren Hangar redlich verdient! Also keine Müdigkeit vorschützen!
#. fr: Nos robots ont besoin d'être choyés, alors construisez-leur un hangar digne de ce nom<nbsp>!
msgctxt "NpcYell:18837:0:13"
msgid "If we want to give our mechs the care they deserve, then we'll need to give the hangar a cosmotastic upgrade!"
msgstr ""

#. ja: 待機中の機械類を、この星の天候から守ってやらなきゃなんねぇ！<br>メンテナンス環境も充実させて、ますます活躍させるんだッ！
#. de: Die Maschinen brauchen besseren Schutz vor dem rauen Wetter auf Phaenna! Dazu kann eine erneuerte Wartungsstation auch nicht schaden!
#. fr: Il faut protéger ces machines en transit contre les intempéries<nbsp>! En les maintenant cor<shy>rec<shy>te<shy>ment, elles pourront nous être pleinement utiles par la suite.
msgctxt "NpcYell:18838:0:13"
msgid "Idle machinery is at the mercy of Phaenna's harsh clime, but we can fortify it! Improved maintenance facilities certainly wouldn't hurt, either!"
msgstr ""

#. ja: おうッ！　来てくれたな！<br>ここに、惑星のエネルギーを集めるパネルを造っていくぞ！
#. de: Ich hoffe, ihr seid aufgewärmt? Mit diesen Platten werden wir die natürliche Energie von Phaenna sammeln und speichern können!
#. fr: Ah, vous voilà<nbsp>! C'est parti pour construire des panneaux collecteurs d'énergie<nbsp>!
msgctxt "NpcYell:18839:0:13"
msgid "Ready to work? Good! These panels will allow us to collect and store Phaenna's naturally occurring energy!"
msgstr ""

#. ja: 大気中を飛び交う光線を集めて、雷力に変換すんだッ！<br>パネルができれば基地のエネルギー事情がもっとよくなるはずだぜ！
#. de: Um genau zu sein, sammeln sie die Lichtstrahlen in der Atmosphäre und wandeln sie zu Strom um! Mit anderen Worten, sobald sie fertig sind, haben wir deutlich weniger Energieprobleme!
#. fr: Fabriquons des panneaux qui pourront convertir la lumière en énergie de foudre. C'est la solution idéale à nos pénuries<nbsp>!
msgctxt "NpcYell:18840:0:13"
msgid "Namely, they gather the rays of light in the atmosphere and convert them into electricity! Once the panels are in place, our energy problems will become a thing of the past!"
msgstr ""

#. ja: 巡回してる冷却ドローンが、お前らが歩けるように、<br>一帯の溶融ガラス全体を冷やしてくれてるぜッ！
#. de: Die Kühldrohnen werden einen Teil des Magmaglases kühlen und einen festen Boden für euch erzeugen!
#. fr: Grâce à nos drones refroidisseurs, vous allez pouvoir traverser certaines zones de verre en fusion<nbsp>!
msgctxt "NpcYell:18841:0:13"
msgid "The drones are freezing the molten glass to give you all a surface to walk upon!"
msgstr ""

#. ja: だが、いっちゃんアツアツのポイントを見極めて接近するのは、<br>お前らじゃなきゃできねえ作業だ！
#. de: Leider braucht es immer noch jemanden, der die heißesten Punkte direkt ausfindig macht. Da kommt ihr ins Spiel!
#. fr: Par contre, vous serez les seuls à pouvoir identifiez et vous approchez des points les plus chauds<nbsp>!
msgctxt "NpcYell:18842:0:13"
msgid "However, it's up to you lot to find the hottest points so we can move in!"
msgstr ""

#. ja: 惑星パエンナでの共同施工作業も、これで大詰めだ！<br>今回の大目標は……天体望遠鏡の建設だッ！
#. de: Unsere Arbeit auf Phaenna ist so gut wie abgeschlossen! Unser letztes Projekt diesmal<nbsp>... ist ein gigantisches Teleskop!
#. fr: Notre base de Phaenna a fière allure<nbsp>! L'objectif principal est de construire un grand télescope<nbsp>!
msgctxt "NpcYell:18843:0:13"
msgid "Our base here on Phaenna is as good as finished! All that's left is the finishing touch─the Stellascope!"
msgstr ""

#. ja: こいつが完成すれば、より遠くの星を目指せるようになるッ！<br>しっかり天体望遠鏡を支えるべく、基地の足元から手をいれるぜ！
#. de: Wenn das gute Stück einmal steht, kann das Universum nichts mehr vor uns geheim halten! Und dafür zu sorgen, dass das Teleskop auch hält, ist unsere Aufgabe!
#. fr: Une fois qu'il sera terminé, on pourra observer les étoiles encore plus lointaines<nbsp>! Il faut d'abord installer une base solide dans la station pour supporter tout ce poids<nbsp>!
msgctxt "NpcYell:18844:0:13"
msgid "This marvelous work of engineering will allow us to peer into space's darkest corners! And it'll be our job to keep it spick-and-span!"
msgstr ""

#. ja: キュルル！
#. de: Kululu ♪
#. fr: Kyuuuuuu<nbsp>!
msgctxt "NpcYell:18845:0:13"
msgid "Khrrr!"
msgstr ""

#. ja: ブンブン
#. de: \<summ>
#. fr: Bzz<nbsp>! Bzz<nbsp>!
msgctxt "NpcYell:18846:0:13"
msgid "\\<buzzzzzz>"
msgstr ""

#. ja: パワーッ
#. de: \<stampf>
#. fr: Pawaaah<nbsp>!
msgctxt "NpcYell:18847:0:13"
msgid "Pew-pew!"
msgstr ""

#. ja: ヨーカーフィー
#. de: Yoook Huyyy!
#. fr: Yoook-huyyyy<nbsp>!
msgctxt "NpcYell:18848:0:13"
msgid "Yoook Huyyy!"
msgstr ""

#. ja: ゴゴゴブ
#. de: \<rumpel> \<ratter>
#. fr: Go-go-go-gob<nbsp>!
msgctxt "NpcYell:18849:0:13"
msgid "\\<whizz> \\<clang>"
msgstr ""

#. ja: ゴブブブ
#. de: \<ratter> \<rumpel>
#. fr: Gob-ob-ob-ob<nbsp>!
msgctxt "NpcYell:18850:0:13"
msgid "\\<clang> \\<whizz>"
msgstr ""

#. ja: 与エテアゲヨウ…
#. de: Auf Nimmer<shy>wieder<shy>sehen.
#. fr: Je vais vous montrer la sapience des Zilarts<nbsp>!
msgctxt "NpcYell:18851:0:13"
msgid "Your time ends now!"
msgstr ""

#. ja: ぷお～ん
#. de: Mbuuuh!
#. fr: Mwoooh<nbsp>!
msgctxt "NpcYell:18852:0:13"
msgid "Barooom!"
msgstr ""

#. ja: ブリブリっ
#. de: \<husch> \<wusch>
#. fr: Skrrr skrrr<nbsp>!
msgctxt "NpcYell:18853:0:13"
msgid "\\<skitter> \\<flitter>"
msgstr ""

#. ja: カ～ッ
#. de: Krah! Krah!
#. fr: Croâââ<nbsp>!
msgctxt "NpcYell:18855:0:13"
msgid "Caw! Caw!"
msgstr ""

#. ja: ソバニイルノダワ！
#. de: Ich werd natürlich bei dir sein!
#. fr: Je ne t'abandonne pas, mon petit arbrisseau<nbsp>!
msgctxt "NpcYell:18856:0:13"
msgid "I shall remain at your side!"
msgstr ""

#. ja: イエ～イ
#. de: \<gleit> \<blubber>
#. fr: Ouaaaiiis<nbsp>!
msgctxt "NpcYell:18857:0:13"
msgid "\\<whoosh>"
msgstr ""

#. ja: ちょーだい♪
#. de: Bitte. ♪
#. fr: Donne<nbsp>! À moi<nbsp>!♪
msgctxt "NpcYell:18858:0:13"
msgid "Please.♪"
msgstr ""

#. ja: いただきニャっ！
#. de: Gib! Gieeeb!
#. fr: C'est pour miaouuu<nbsp>!
msgctxt "NpcYell:18859:0:13"
msgid "Gimme, meow!"
msgstr ""

#. ja: みんな、中央へ！
#. de: Versammeln wir uns in der Mitte!
#. fr: Venez au centre<nbsp>!
msgctxt "NpcYell:18860:0:13"
msgid "Into the center!"
msgstr ""

#. ja: 真ん中に集まって！
#. de: In der Mitte bleiben!
#. fr: Venez, on a besoin de tout le monde<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18861:0:13"
msgid "To the middle!<br>We close ranks!"
msgstr ""

#. ja: 集まりましょう！
#. de: Alle zusammen!
#. fr: Rassemblons-nous<nbsp>!
msgctxt "NpcYell:18862:0:13"
msgid "Huddle up, everyone!"
msgstr ""

#. ja: 中央へ集まるわよ！
#. de: Zusammen bewältigen wir das!
#. fr: C'est le moment de se regrouper<nbsp>!
msgctxt "NpcYell:18863:0:13"
msgid "Everyone to the middle!"
msgstr ""

#. ja: これがメインターミナルの中…
#. de: So sieht das also hier drin aus<nbsp>...
#. fr: Voilà à quoi ressemble l'intérieur du mésoterminal...
msgctxt "NpcYell:18864:0:13"
msgid "So this is what it looks like inside..."
msgstr ""

#. ja: カリュクスが何か<br>仕掛けてくるはずだ
#. de: Calyx erwartet uns ganz sicher schon<nbsp>...
#. fr: Je suis sûrrr que Calyx nous a réservé des surprises...
msgctxt "NpcYell:18865:0:13"
msgid "Calyx will have prepared us a warm welcome."
msgstr ""

#. ja: 私が眠っていた場所とは<br>違うフロアみたい…
#. de: Wir sind hier auf einer anderen Ebene als der meines Sarges<nbsp>...
#. fr: Je devais être maintenue en sommeil à un étage différent...
msgctxt "NpcYell:18866:0:13"
msgid "This is a different floor to where I was in stasis."
msgstr ""

#. ja: 一気に駆け上がるわよ！
#. de: Verschwenden wir keine Zeit. Los geht's!
#. fr: Allez, on va grimper ce bâtiment d'une traite<nbsp>!
msgctxt "NpcYell:18867:0:13"
msgid "We fight our way straight to the top!"
msgstr ""

#. ja: 彼は最上層に来いと<br>言っていたね
#. de: Er erwarte uns ganz oben. Das waren seine Worte<nbsp>...
#. fr: Calyx a dit qu'il se trouvait au sommet...
msgctxt "NpcYell:18868:0:13"
msgid "Calyx awaits us at the very top, then?"
msgstr ""

#. ja: なっ…<br>見た目が変わった！？
#. de: Was geschieht hier ...?
#. fr: Qu'est-ce que... Le couloirrr s'est métamorphosé<nbsp>!
msgctxt "NpcYell:18869:0:13"
msgid "What in the...? Everything has changed!"
msgstr ""

#. ja: これは…<br>昔のアレクサンドリア！？
#. de: Das<nbsp>... Das ist mein Alexandria!
#. fr: C'est... l'ancienne Alexandrie<nbsp>!?
msgctxt "NpcYell:18870:0:13"
msgid "This is the Alexandria of my time!"
msgstr ""

#. ja: 周りの風景が…！
#. de: Die ganze Umgebung<nbsp>...!
#. fr: Le décor a changé...<nbsp>!
msgctxt "NpcYell:18871:0:13"
msgid "He's changed the whole place!"
msgstr ""

#. ja: エレクトロープを<br>操っているのね
#. de: Calyx ist eben wirklich ein Meister im Umgang mit Elektrob<nbsp>...
#. fr: Il a transformé l'électrope en temps réel...
msgctxt "NpcYell:18872:0:13"
msgid "Ah. He's adjusted the electrope to project a new appearance."
msgstr ""

#. ja: 文字どおり<br>舞台装置ってことかしら
#. de: So ein Bühnenbild würde sich wohl jedes Theater wünschen.
#. fr: “Un décor de circonstance”, hein...
msgctxt "NpcYell:18873:0:13"
msgid "He's quite literally setting the scene."
msgstr ""

#. ja: 即席の永久人だって…！？
#. de: Endlose zu erschaffen ist ein Leichtes für ihn ...? Dieser Mistkerl!
#. fr: Il a créé des Éternels exprès pour nous barrer la route<nbsp>!?
msgctxt "NpcYell:18874:0:13"
msgid "Did he say “new Endless”!?"
msgstr ""

#. ja: ここでも死の恐怖を<br>利用するのか…！？
#. de: An seinen Methoden ändert sich nichts. Ihre Furcht ist eine Waffe in seinen Händen.
#. fr: Encore une manièrrre d'exploiter la peur des Alexandrins<nbsp>?
msgctxt "NpcYell:18875:0:13"
msgid "Even within his stronghold, he leverages the fear of death..."
msgstr ""

#. ja: ッ…なんてことを…！
#. de: Wie kann er es wagen<nbsp>...!
#. fr: Qu'est-ce que...<nbsp>!?
msgctxt "NpcYell:18876:0:13"
msgid "This is wrong..."
msgstr ""

#. ja: 記憶を改ざんして<br>けしかけているようね…
#. de: Mithilfe manipulierter Erinnerungen hetzt er sie uns auf<nbsp>...
#. fr: Il manipule les souvenirs pour les retourner contre nous...
msgctxt "NpcYell:18877:0:13"
msgid "He must be modifying their memories to set them against us."
msgstr ""

#. ja: 私たちを<br>敵と認識させているのか…
#. de: Er macht uns zu ihren Feinden<nbsp>...
#. fr: C'est nous les “ennemis”, je suppose...
msgctxt "NpcYell:18878:0:13"
msgid "He has them believing we are invading enemies..."
msgstr ""

#. ja: 医師になんてこと<br>させるんだよ…！
#. de: Das ist ja unerhört! Die Medizin derart zu missbrauchen!
#. fr: Envoyer un docteur au casse-pipe, fallait oser<nbsp>!
msgctxt "NpcYell:18879:0:13"
msgid "He would force a healer to fight us!?"
msgstr ""

#. ja: かつての医師の記憶か…
#. de: Ein ehemaliger Arzt, wie es scheint<nbsp>...
#. fr: L'incarrrnation des souvenirs d'un soignant...
msgctxt "NpcYell:18880:0:13"
msgid "A physician's memories..."
msgstr ""

#. ja: やるしかないのね…
#. de: Uns bleibt nur eins zu tun<nbsp>...
#. fr: On va devoir passer en force.
msgctxt "NpcYell:18881:0:13"
msgid "He leaves us little choice..."
msgstr ""

#. ja: 彼は患者を守るために<br>抗うつもりよ
#. de: Für seine Patienten ist er bereit, Grenzen zu überschreiten.
#. fr: Il croit lutter pour défendre ses patients...
msgctxt "NpcYell:18882:0:13"
msgid "He seems quite serious about barring our path."
msgstr ""

#. ja: 私たちが何者か<br>彼も誤認させられている
#. de: Er scheint wohl ebenfalls von Calyx manipuliert zu sein<nbsp>...
#. fr: On ne pourra malheureusement pas le raisonner...
msgctxt "NpcYell:18883:0:13"
msgid "Yet another Endless being made to see us as the foe."
msgstr ""

#. ja: 先へ進むためには<br>戦うしかないわ
#. de: Ein Kampf ist unvermeidlich.
#. fr: Alors il va falloir lui passer sur le corps.
msgctxt "NpcYell:18884:0:13"
msgid "We've no choice but to fight if we're to proceed."
msgstr ""

#. ja: くっ…<br>みんな…
#. de: Mein tapferes Volk<nbsp>... Was hat er getan?!
#. fr: Ugh... Mes anciens compatriotes...
msgctxt "NpcYell:18885:0:13"
msgid "My people..."
msgstr ""

#. ja: カリュクスの奴…！
#. de: Calyx, du Drecksbengel!
#. fr: Ce salaud de Calyx va le payer cher<nbsp>!
msgctxt "NpcYell:18886:0:13"
msgid "Damn you, Calyx..."
msgstr ""

#. ja: …進みましょう
#. de: Ziehen wir weiter.
#. fr: ... Continuons d'avancer.
msgctxt "NpcYell:18887:0:13"
msgid "Let us move on..."
msgstr ""

#. ja: このまま<br>突破していくしかないわ
#. de: Es bleibt nur der Weg nach vorne!
#. fr: Il n'y a pas une minute à perdre. Allons-y.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18888:0:13"
msgid "Steel your hearts.<br>We must forge onward."
msgstr ""

#. ja: 周りの風景が…
#. de: Und so zeigt das System sein wahres Gesicht<nbsp>...
#. fr: On dirait que le décor s'efface par endroits...
msgctxt "NpcYell:18889:0:13"
msgid "Look at what's happened..."
msgstr ""

#. ja: エレクトロープに<br>綻びが出ているわ
#. de: Das Elektrob ist zum Vorschein gekommen!
#. fr: C'est l'électrope qui est mise à nu.
msgctxt "NpcYell:18890:0:13"
msgid "There are cracks in the electrope."
msgstr ""

#. ja: さっきも似たような端末が<br>あったよな
#. de: Ein ähnliches Terminal gab es doch vorhin auch schon, oder?
#. fr: Il y avait un terminal identique à l'étage du bas.
msgctxt "NpcYell:18891:0:13"
msgid "Didn't we pass a terminal like that already?"
msgstr ""

#. ja: ここにも情報端末があるぞ
#. de: Ein weiteres Terminal!
#. fr: Tiens, un autre terminal d'in<shy>forrr<shy>ma<shy>tions.
msgctxt "NpcYell:18892:0:13"
msgid "Another one of those terminals."
msgstr ""

#. ja: あの端末<br>ちょっと見てみない？
#. de: Sollen wir einen Blick auf das Terminal wagen?
#. fr: On peut jeter un coup d'œil à ce terminal.
msgctxt "NpcYell:18893:0:13"
msgid "Should we take a look at that terminal?"
msgstr ""

#. ja: 情報収集を<br>試みてみるかい？
#. de: An dem Terminal gibt es sicherlich Interessantes zu erfahren.
#. fr: Ça vaut sûrement la peine de se renseigner sur cet endroit.
msgctxt "NpcYell:18894:0:13"
msgid "Should we stop and take a quick look?"
msgstr ""

#. ja: また風景が…！
#. de: Schon wieder ...?!
#. fr: Encore un nouveau décor<nbsp>!
msgctxt "NpcYell:18895:0:13"
msgid "He's changing things again!"
msgstr ""

#. ja: これは…<br>アレクサンドリアの…
#. de: Ein weiterer Rückblick auf Alexandria ...
#. fr: Un autre lieu emblématique de l'ancienne Alexandrie...
msgctxt "NpcYell:18896:0:13"
msgid "Another reminder of Alexandria..."
msgstr ""

#. ja: 不気味な雰囲気ね
#. de: So düster ...
#. fr: Flippant, comme endroit...
msgctxt "NpcYell:18897:0:13"
msgid "Well, this is dismal."
msgstr ""

#. ja: 彼らは囚人…？
#. de: Sind das ... Insassen ...?
#. fr: Ce sont... des prisonniers<nbsp>?
msgctxt "NpcYell:18898:0:13"
msgid "Are these people prisoners?"
msgstr ""

#. ja: 今度は監獄？<br>悪趣味だこと
#. de: Ein Kerker?! Der Bursche hat einen sonderlichen Geschmack, was?
#. fr: Une prison, maintenant<nbsp>? C'est joyeux...
msgctxt "NpcYell:18899:0:13"
msgid "A gaol, is it? Charming."
msgstr ""

#. ja: くそっ…！<br>4人もいるぜ
#. de: Vier auf einmal?!
#. fr: Un bourreau, ça va, mais quatre, bonjour les dégâts...
msgctxt "NpcYell:18900:0:13"
msgid "Big lads...and there are four of them."
msgstr ""

#. ja: 一筋縄では<br>いかなそうだな
#. de: Da ist doch bestimmt ein Haken an der Sache<nbsp>...
#. fr: Cet af<shy>fron<shy>te<shy>ment s'annonce... parrrticulier.
msgctxt "NpcYell:18901:0:13"
msgid "This will be no easy battle."
msgstr ""

#. ja: 私たちが罪人ってわけね
#. de: Dann sind wir wohl die „Sünder“ in seinem Szenario<nbsp>...
#. fr: On a le mauvais rôle, c'est ça<nbsp>?
msgctxt "NpcYell:18902:0:13"
msgid "And we're the “criminals,” I suppose."
msgstr ""

#. ja: 処刑人の永久人が…
#. de: Henker<nbsp>...
#. fr: Des bourreaux Éternels... ou d'éternels bourreaux...
msgctxt "NpcYell:18903:0:13"
msgid "Endless headsmen..."
msgstr ""

#. ja: ここは…処刑場か…
#. de: Es gilt wohl dem Henkersbeil zu entrinnen<nbsp>...
#. fr: C'est une sorte... de chambre d'exécution...
msgctxt "NpcYell:18904:0:13"
msgid "This is an execution chamber, then..."
msgstr ""

#. ja: まただ<br>周りの壁を見てみろよ…！
#. de: Schon wieder! All das entblößte Elektrob<nbsp>...
#. fr: Les murs déconnent comme tout à l'heure<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18905:0:13"
msgid "It happened again.<br>Look at the walls!"
msgstr ""

#. ja: 記憶はキミの道具じゃない…
#. de: Ich sage es ein weiteres Mal: Erinnerungen sind kein Spielzeug!
#. fr: Les souvenirs ne sont pas des jouets qu'on peut utiliser à sa guise<nbsp>!
msgctxt "NpcYell:18906:0:13"
msgid "Memories are not tools to be exploited..."
msgstr ""

#. ja: 進むわよ…！
#. de: Brechen wir auf<nbsp>...
#. fr: Allez, on continue<nbsp>!
msgctxt "NpcYell:18907:0:13"
msgid "On we go!"
msgstr ""

#. ja: こんなこと<br>終わらせなきゃ…
#. de: Wir müssen dem ein Ende setzen ...!
#. fr: Nous devons mettre un terme à cette folie.
msgctxt "NpcYell:18908:0:13"
msgid "We cannot allow this to continue."
msgstr ""

#. ja: エレクトロープに<br>負荷がかかっているのね
#. de: Die Aufrechterhaltung der Fassade scheint eine Menge Energie zu fordern<nbsp>...  
#. fr: L'électrope ne peut visiblement pas supporter une trop grande charge d'in<shy>for<shy>ma<shy>tions.
msgctxt "NpcYell:18909:0:13"
msgid "This is putting enormous stress on the electrope..."
msgstr ""

#. ja: 死を知る時代…？
#. de: „Der allgegenwärtige Tod“<nbsp>...?!
#. fr: “Une époque marquée par la mort”<nbsp>?
msgctxt "NpcYell:18910:0:13"
msgid "“An age rife with death”...?"
msgstr ""

#. ja: まだやるつもりか…
#. de: Das ist wohl noch nicht das Ende<nbsp>...
#. fr: On n'est visiblement pas au bout de nos surrrprises...
msgctxt "NpcYell:18911:0:13"
msgid "We are not done, it seems..."
msgstr ""

#. ja: 今度は何！？
#. de: Und was kommt jetzt?!
#. fr: Ça va être quoi, cette fois<nbsp>!?
msgctxt "NpcYell:18912:0:13"
msgid "Now what!?"
msgstr ""

#. ja: 警戒しましょう！
#. de: Bleiben wir auf der Hut!
#. fr: Restons sur nos gardes<nbsp>!
msgctxt "NpcYell:18913:0:13"
msgid "On your guard, everyone!"
msgstr ""

#. ja: まさか…
#. de: Nein<nbsp>... Das kann doch nicht<nbsp>...!
#. fr: L'époque dont il parle...
msgctxt "NpcYell:18914:0:13"
msgid "What has he done...?"
msgstr ""

#. ja: ふざけやがって…！
#. de: Verdammt noch mal!
#. fr: Sans déconner<nbsp>!?
msgctxt "NpcYell:18915:0:13"
msgid "Is this a game to him?"
msgstr ""

#. ja: 雷光大戦の再現か…！
#. de: Die Stromschlachten<nbsp>...
#. fr: On est en pleine Guerre des fulgurrrations<nbsp>!
msgctxt "NpcYell:18916:0:13"
msgid "He's recreated the Storm Surge!"
msgstr ""

#. ja: くっ…進まなきゃ…<br>みんなのためにも…！
#. de: Nein<nbsp>... Ich darf nicht aufgeben!
#. fr: C'est dur... mais je ne dois pas me décourager<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18917:0:13"
msgid "No...<br>I cannot stop here!"
msgstr ""

#. ja: 戦争の様子を<br>永久人に想起させている…
#. de: Er bindet den Endlosen weiter seine Lügengeschichten auf.
#. fr: Il force les Éternels à revivre leurs traumatismes de guerre...
msgctxt "NpcYell:18918:0:13"
msgid "He's forcing the Endless to relive their memories of war..."
msgstr ""

#. ja: だいぶ上まで来たぜ
#. de: Wir haben es weit gebracht ...!
#. fr: On a pas mal grimpé, là, non<nbsp>?
msgctxt "NpcYell:18919:0:13"
msgid "We've climbed pretty high."
msgstr ""

#. ja: 進まなきゃ…！
#. de: Schreiten wir unentwegt voran!
#. fr: Encore un effort<nbsp>!
msgctxt "NpcYell:18920:0:13"
msgid "We must keep going!"
msgstr ""

#. ja: あそこから<br>中に入れそうよ
#. de: Da durch scheint es weiterzugehen!
#. fr: Il y a une entrée tout au bout<nbsp>!
msgctxt "NpcYell:18921:0:13"
msgid "There looks to be a way inside."
msgstr ""

#. ja: 最上層まで<br>もう少しのはずよ！
#. de: Nicht mehr lange bis wir oben sind!
#. fr: On ne doit plus être très loin du sommet<nbsp>!
msgctxt "NpcYell:18922:0:13"
msgid "We must be nearing the top by now!"
msgstr ""

#. ja: この先の区画から<br>上に行けそうね
#. de: Es scheint hier durch weiterzugehen.
#. fr: Après cette passerelle, on devrait pouvoir monter encore plus haut.
msgctxt "NpcYell:18923:0:13"
msgid "This way if we want to continue upwards."
msgstr ""

#. ja: よっしゃ<br>いくぜ！
#. de: Dann los! Bringen wir es zu Ende!
#. fr: Parfait. En avant alors<nbsp>!
msgctxt "NpcYell:18924:0:13"
msgid "Then what are we waiting for!?"
msgstr ""

#. ja: みんなの想いを<br>踏みにじらないで！
#. de: Ihre Erinnerungen derart mit Füßen zu treten<nbsp>...!
#. fr: Je ne te laisserai pas bafouer la mémoire des Alexandrins<nbsp>!
msgctxt "NpcYell:18925:0:13"
msgid "You make a mockery of their suffering!"
msgstr ""

#. ja: なんて膨大な記憶なの…
#. de: Sind das ... Verschmolzene Erinnerungen ...?
#. fr: Ça, c'est un gros paquet de souvenirs...
msgctxt "NpcYell:18926:0:13"
msgid "So many memories in one place..."
msgstr ""

#. ja: 永久人たちの恐怖が<br>伝わってくる…
#. de: Die Furcht der Endlosen ist deutlich zu spüren<nbsp>...
#. fr: Je ressens d'ici la peur qu'il y a dans ces souvenirs...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18927:0:13"
msgid "The Endless...<br>I can feel their terror."
msgstr ""

#. ja: ここまでするなんて…
#. de: So weit zu gehen<nbsp>... Und für was?
#. fr: Calyx va loin dans ses ex<shy>pé<shy>ri<shy>men<shy>ta<shy>tions...
msgctxt "NpcYell:18928:0:13"
msgid "To go to such lengths..."
msgstr ""

#. ja: 記憶を集結させたのか…
#. de: Er hat sämtliche Erinnerungen zusammengeführt<nbsp>...
#. fr: Qui peut dire combien de souvenirs Calyx a fusionnnés pour créer ce monstre...
msgctxt "NpcYell:18929:0:13"
msgid "He's fused them into a single entity..."
msgstr ""

#. ja: これ以上<br>苦しめるのはやめて！
#. de: Es reicht! Sie haben genug gelitten! <i>Mein Volk</i> hat genug gelitten!
#. fr: Je ne le laisserai pas tourmenter mon peuple plus longtemps<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18930:0:13"
msgid "Stop this!<br>Haven't they suffered enough!?"
msgstr ""

#. ja: 足を砂に取られるなよ
#. de: Passt auf, wo ihr hintretet.
#. fr: Ne trébuchez pas dans le sable<nbsp>!
msgctxt "NpcYell:18931:0:13"
msgid "Watch your step."
msgstr ""

#. ja: 奥はどうなってるのかな～
#. de: Ich frage mich, wie es weiter drinnen aussieht<nbsp>...
#. fr: Je me demande ce qu'il y a par là...
msgctxt "NpcYell:18932:0:13"
msgid "What lies within, I wonder?"
msgstr ""

#. ja: 油断せずいきましょう
#. de: Lassen wir Vorsicht walten.
#. fr: Avançons prudemment<nbsp>!
msgctxt "NpcYell:18933:0:13"
msgid "Let us proceed with caution."
msgstr ""

#. ja: キマイラの鳴き声は<br>まだ聞こえないな…
#. de: Noch höre ich die Chimäre nicht<nbsp>...
#. fr: Pas de cris de la chimère... pour l'instant.
msgctxt "NpcYell:18934:0:13"
msgid "I cannot hear the chimera...yet."
msgstr ""

#. ja: 強そうな敵が見えるよ！
#. de: Das wird ein ordentlicher Kampf!
#. fr: Cette bestiole a l'air coriace<nbsp>!
msgctxt "NpcYell:18935:0:13"
msgid "This one looks like a challenge!"
msgstr ""

#. ja: 女王アリか…？
#. de: Eine Ameisenkönigin?
#. fr: C'est la reine des fourmis<nbsp>?
msgctxt "NpcYell:18936:0:13"
msgid "An antling queen...?"
msgstr ""

#. ja: 流砂に<br>飛び込んでみましょう
#. de: Der Treibsand wird uns weiterbringen.
#. fr: Essayons d'emprunter les sables mouvants<nbsp>!
msgctxt "NpcYell:18937:0:13"
msgid "The quicksand will lead us onwards."
msgstr ""

#. ja: 取り巻きの出現には<br>焦ったな
#. de: Soldaten hat sie ja zur Genüge.
#. fr: J'ai eu peur quand toutes les autres fourmis sont arrivées<nbsp>!
msgctxt "NpcYell:18938:0:13"
msgid "Her soldiers certainly arrived en masse."
msgstr ""

#. ja: ふん、蹴散らすぞ！
#. de: Noch ein Gegner!
#. fr: On va faire qu'une bouchée de cet asticot<nbsp>!
msgctxt "NpcYell:18939:0:13"
msgid "Another foe to crush!"
msgstr ""

#. ja: なんて巨大なワーム…！
#. de: So ein gigantischer Wurm<nbsp>...
#. fr: Ce ver est tout bonnement gigantesque<nbsp>!
msgctxt "NpcYell:18940:0:13"
msgid "What a gigantic worm..."
msgstr ""

#. ja: 砂に潜って<br>攻撃してくるとはな
#. de: Bah, ich hab Sand im Mund!
#. fr: Ses attaques souterraines étaient redoutables<nbsp>!
msgctxt "NpcYell:18941:0:13"
msgid "\\<cough> Got sand in my mouth..."
msgstr ""

#. ja: 百蟲綱の魔物ばかり…<br>キマイラはどこかしら
#. de: Ungeziefer und Ungeheuer<nbsp>... Aber wo ist die Chimäre?
#. fr: Assez de ces vermines, où est la chimère<nbsp>?
msgctxt "NpcYell:18942:0:13"
msgid "This place is rife with vilekin... Where hides the chimera?"
msgstr ""

#. ja: 奥に進んでみよう
#. de: Nur weiter, in die Tiefe.
#. fr: Continuons d'avancer.
msgctxt "NpcYell:18943:0:13"
msgid "Come. The depths await."
msgstr ""

#. ja: さあ、キマイラの討伐だ！
#. de: Da ist sie! Die Chimäre!
#. fr: On va enfin pouvoir exterminer cette chimère<nbsp>!
msgctxt "NpcYell:18944:0:13"
msgid "At last! The chimera!"
msgstr ""

#. ja: もう誰も襲わせないよ～！
#. de: Bald wird sie niemandem mehr etwas zuleide tun!
#. fr: Tu ne terroriseras plus jamais personne, sale bête<nbsp>!
msgctxt "NpcYell:18945:0:13"
msgid "Its reign of terror ends now!"
msgstr ""

#. ja: 3つの頭の動きに<br>気をつけましょう！
#. de: Jeder der drei Köpfe ist brandgefährlich! Nicht aus den Augen lassen!
#. fr: Observez bien chacune de ses trois têtes<nbsp>!
msgctxt "NpcYell:18946:0:13"
msgid "Each of its three heads is deadly─take care!"
msgstr ""

#. ja: どれだけの獲物を<br>喰らってきたんだ…！
#. de: Wie viele sind dieser Bestie zum Opfer gefallen<nbsp>...?
#. fr: Toutes ces carcasses... Son appétit est insatiable<nbsp>!
msgctxt "NpcYell:18947:0:13"
msgid "This beast has slain so many..."
msgstr ""

#. ja: そうだとしても…<br>退くわけにはいかない！
#. de: Selbst wenn<nbsp>... Wir weichen nicht zurück!
#. fr: Tu peux dire ce que tu veux... Je ne reculerai pas<nbsp>!
msgctxt "NpcYell:18948:0:13"
msgid "Limited though we may be, we defy you nonetheless!"
msgstr ""

#. ja: お前の計算どおりには<br>させねぇぜ！
#. de: Wir werden deine Pläne durchkreuzen!
#. fr: Tes beaux pronostics vont tomber à l'eau<nbsp>!
msgctxt "NpcYell:18949:0:13"
msgid "Your plans end here with you!"
msgstr ""

#. ja: 何よ、この手！？
#. de: Hände?! Was zum ...!
#. fr: C'est quoi, tous ces bras<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18950:0:13"
msgid "Eurgh!<br>Keep your hands off me!"
msgstr ""

#. ja: みんな、気を付けろ！
#. de: Aufgepasst!
#. fr: Faites gaffe à pas vous faire aplatirrr<nbsp>!
msgctxt "NpcYell:18951:0:13"
msgid "Stay alert!"
msgstr ""

#. ja: なんだ！？
#. de: Was zum ...!
#. fr: C'était quoi, ça<nbsp>!?
msgctxt "NpcYell:18952:0:13"
msgid "What was that!?"
msgstr ""

#. ja: 連続攻撃…！？
#. de: Die kommen in Folge!
#. fr: Un enchaînement d'attaques<nbsp>!
msgctxt "NpcYell:18953:0:13"
msgid "A barrage of attacks..."
msgstr ""

#. ja: 次はどっちが…
#. de: Was als Nächstes ...?
#. fr: Où va-t-il frapper ensuite<nbsp>?
msgctxt "NpcYell:18954:0:13"
msgid "Where will it strike next...?"
msgstr ""

#. ja: 腕をよく見て！<br>判別できるわ！
#. de: Seht genau hin! Man kann sie unterscheiden!
#. fr: Observez ses bras et anticipez ses attaques<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18955:0:13"
msgid "Watch the arms!<br>They betray the intent!"
msgstr ""

#. ja: もう惑わされないわよ！
#. de: Noch einmal gelingt dir das nicht!
#. fr: Je me ferai plus avoir<nbsp>!
msgctxt "NpcYell:18956:0:13"
msgid "You won't catch me again!"
msgstr ""

#. ja: まずい、離れねぇと…！
#. de: Schnell weg hier!
#. fr: Merde, faut que je m'éloigne des autres<nbsp>!
msgctxt "NpcYell:18957:0:13"
msgid "Not good! I need to move away!"
msgstr ""

#. ja: 離れたとこに誘導してくれ！
#. de: Lock es weg!
#. fr: Essaye d'éloigner son attention de nous<nbsp>!
msgctxt "NpcYell:18958:0:13"
msgid "Lead it away from the group!"
msgstr ""

#. ja: リングにエーテルが<br>集まっているわ！
#. de: Es sammelt sich Äther!
#. fr: L'éther s'accumule dans son anneau<nbsp>!
msgctxt "NpcYell:18959:0:13"
msgid "It's gathering aether!"
msgstr ""

#. ja: 強烈だな…！
#. de: Hng ...! Was für eine Wucht ...
#. fr: C'était chaud<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18960:0:13"
msgid "Ungh!<br>The sheer strength of it..."
msgstr ""

#. ja: またエーテルが…<br>先ほどとは異なる形状よ！
#. de: Schon wieder Äther! Aber diesmal ...
#. fr: L'éther forme un motif différent cette fois...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18961:0:13"
msgid "The aether gathers again...<br>A different shape this time!"
msgstr ""

#. ja: さっきの形状は<br>こういうことね！
#. de: Die Form von vorhin! Jetzt verstehe ich<nbsp>...
#. fr: Voilà à quoi correspondait le motif étheré<nbsp>!
msgctxt "NpcYell:18962:0:13"
msgid "So that's what that shape means!"
msgstr ""

#. ja: 時間差でも<br>実行してくるのか…
#. de: Die Aktivierung erfolgt versetzt ...!
#. fr: Une attaque à retardement...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18963:0:13"
msgid "The stored aether...<br>Its effects can be delayed."
msgstr ""

#. ja: 何か仕掛けてくるぞ！
#. de: Es bereitet einen Angriff vor!
#. fr: Il préparrre un sale coup<nbsp>!
msgctxt "NpcYell:18964:0:13"
msgid "It's bringing some new attack to bear!"
msgstr ""

#. ja: 周りの床が消えた！？
#. de: Der Boden um uns! Er ist verschwunden!
#. fr: Toute la bordure du terrain a disparu<nbsp>!
msgctxt "NpcYell:18965:0:13"
msgid "The ground... Where did it go!?"
msgstr ""

#. ja: くっ、どうなってんだ…！？
#. de: Was geschieht hier nur?!
#. fr: 'Tain, c'est quoi ce binz<nbsp>?
msgctxt "NpcYell:18966:0:13"
msgid "How do we deal with this!?"
msgstr ""

#. ja: 動きに惑わされないで
#. de: Lasst euch bloß nicht täuschen!
#. fr: Ne vous laissez pas perturber par ces sphères qui tournent.
msgctxt "NpcYell:18967:0:13"
msgid "Do not be fooled by the movements."
msgstr ""

#. ja: 慌てずに対処しましょう
#. de: Bleibt gefasst!
#. fr: Restons calmes et continuons de nous battre.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18968:0:13"
msgid "Keep a clear head.<br>We can handle this."
msgstr ""

#. ja: 端に離れて<br>耐え抜くんだ！
#. de: Achtet auf den Boden und haltet durch!
#. fr: Regroupons-nous des deux côtés et tâchons de tenir le coup<nbsp>!
msgctxt "NpcYell:18969:0:13"
msgid "Over to the edge and hunker down!"
msgstr ""

#. ja: 次から次へと…！
#. de: Kein Ende in Sicht!
#. fr: Il ne nous laisse aucun répit<nbsp>!
msgctxt "NpcYell:18970:0:13"
msgid "'Tis one thing after another!"
msgstr ""

#. ja: 床から手が…！
#. de: Hände<nbsp>... Aus dem Boden?!
#. fr: Attention, d'autres bras sortent du sol<nbsp>!
msgctxt "NpcYell:18971:0:13"
msgid "The ground has sprouted hands..."
msgstr ""

#. ja: 急いで蹴散らすわよ！
#. de: Beseitigen wir sie, bevor es zu spät ist!
#. fr: Il faut s'en débarrasser, et vite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18972:0:13"
msgid "Destroy them!<br>Quickly as you can!"
msgstr ""

#. ja: みんな固まって！
#. de: Alle zusammen!
#. fr: Faisons bloc ensemble<nbsp>!
msgctxt "NpcYell:18973:0:13"
msgid "Brace yourselves!"
msgstr ""

#. ja: 耐えきってみせるぜ！！
#. de: Wir halten durch! Gemeinsam!
#. fr: On va tenir bon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18974:0:13"
msgid "Be strong!<br>We can take it!"
msgstr ""

#. ja: くっ、引きずり込まれる…！
#. de: Argh! Wir werden hinein gezerrt!
#. fr: J-je suis aspiré<nbsp>!
msgctxt "NpcYell:18975:0:13"
msgid "We're being pulled down!"
msgstr ""

#. ja: 意識をしっかり保つんだ！
#. de: Nicht<nbsp>... aufgeben!
#. fr: Luttez pour ne pas perrrdre con<shy>nais<shy>san<shy>ce<nbsp>!
msgctxt "NpcYell:18976:0:13"
msgid "Hold fast to your reason!"
msgstr ""

#. ja: みんな、無事！？
#. de: Sind alle in Ordnung?
#. fr: Tout le monde va bien<nbsp>!?
msgctxt "NpcYell:18977:0:13"
msgid "Is everyone all right!?"
msgstr ""

#. ja: 上等じゃない…<br>さあ、ここからよ！
#. de: Pah! Jetzt geht es richtig los!
#. fr: Quel coup tordu... Bon, à nous de jouer maintenant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18978:0:13"
msgid "Well, that was exciting...<br>Back to it, then!"
msgstr ""

#. ja: 外周に巨大な腕が…！
#. de: Riesige Arme!
#. fr: Regardez sur les côtés<nbsp>! Des bras géants<nbsp>!
msgctxt "NpcYell:18979:0:13"
msgid "Giant hands...everywhere!"
msgstr ""

#. ja: 引きずり込もうってわけね
#. de: Du willst uns also mitnehmen, hm?
#. fr: Ils veulent nous emporter dans l'abîme...
msgctxt "NpcYell:18980:0:13"
msgid "It wants to drag us into the abyss."
msgstr ""

#. ja: 何だ！？<br>まだエーテルが…
#. de: Hm?! Mehr Äther?
#. fr: Hé<nbsp>! Il chope à nouveau de l'éther<nbsp>!
msgctxt "NpcYell:18981:0:13"
msgid "Look! It's storing aether again..."
msgstr ""

#. ja: 連続して<br>放つつもりか！
#. de: Das sieht nach Dauerbeschuss aus!
#. fr: Il va les enchaîner<nbsp>!?
msgctxt "NpcYell:18982:0:13"
msgid "It means to discharge in rapid succession!"
msgstr ""

#. ja: 4連続だ…<br>気を付けろ！
#. de: Eine vierfache Attacke. Bleibt wachsam!
#. fr: Quatre à la suite... Ça va être corrrsé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:18983:0:13"
msgid "I counted four...<br>Be ready!"
msgstr ""

#. ja: 来るわよ！
#. de: Da!
#. fr: Attention, ça arrive<nbsp>!
msgctxt "NpcYell:18984:0:13"
msgid "Here it comes!"
msgstr ""

#. ja: 次は…こっちね！
#. de: Und als Nächstes von hier!
#. fr: Ensuite... Par ici<nbsp>!
msgctxt "NpcYell:18985:0:13"
msgid "The next one is...this way!"
msgstr ""

#. ja: やはり連続で来るわね
#. de: Keine Pause zwischen den Angriffen<nbsp>...
#. fr: Trop prévisible.
msgctxt "NpcYell:18986:0:13"
msgid "A successive pattern, as we suspected."
msgstr ""

#. ja: これで最後…！
#. de: Ein letztes Mal!
#. fr: Et le dernier...<nbsp>!
msgctxt "NpcYell:18987:0:13"
msgid "And this is the last..."
msgstr ""

#. ja: 床に魔紋が！
#. de: Äthergramme!
#. fr: Des cercles arcaniques<nbsp>!
msgctxt "NpcYell:18988:0:13"
msgid "Arcane circles!"
msgstr ""

#. ja: 協力して解除するぞ！
#. de: Wir müssen das Siegel brechen!
#. fr: Mettons-nous à plusieurrrs pour les faire disparaître<nbsp>!
msgctxt "NpcYell:18989:0:13"
msgid "Together, we can undo its magicks!"
msgstr ""

#. ja: アタシに任せろ！
#. de: Überlasst das mir!
#. fr: Laissez-moi faire<nbsp>!
msgctxt "NpcYell:18990:0:13"
msgid "Leave this one to me!"
msgstr ""

#. ja: 巨大な腕にも気を付けて！
#. de: Passt auf die Arme auf!
#. fr: N'oubliez pas les bras géants<nbsp>!
msgctxt "NpcYell:18991:0:13"
msgid "Watch out for those giant hands!"
msgstr ""

#. ja: またこの攻撃…！？
#. de: Der gleiche Angriff noch mal<nbsp>...?
#. fr: Encore ça<nbsp>!?
msgctxt "NpcYell:18992:0:13"
msgid "Ugh, not this again..."
msgstr ""

#. ja: 落ち着いて対処するわよ
#. de: Nur die Ruhe bewahren.
#. fr: Gardez votre sang-froid comme tout à l'heure.
msgctxt "NpcYell:18993:0:13"
msgid "Breathe. We've dealt with worse."
msgstr ""

#. ja: いいぞッ、今回の施工作業も折り返しだッ！<br>お前ら、さらに気合入れていくぞッ！！
#. de: Gut so, das ist der Fortschritt, den ich sehen will! Jetzt nicht nachlassen, legt euch ins Zeug!
#. fr: Parfait<nbsp>! Le chantier avance à grands bonds<nbsp>! Continuez comme ça, vous tous<nbsp>!
msgctxt "NpcYell:18994:0:13"
msgid "Work is progressing better than I could've imagined! Keep up the pace!"
msgstr ""

#. ja: よぉし、ゴールはもうすぐだッ！！<br>ここ一番の踏ん張りどころ、お前らの工事場のヤケ力を見せてくれ！
#. de: Los, wir sind fast am Ziel! Ich will einen ordentlichen Endspurt sehen! Gebt noch einmal alles!
#. fr: Allez<nbsp>! La ligne d'arrivée est juste devant nous<nbsp>! C'est le moment de tout donner pour finir ces travaux en beauté<nbsp>!
msgctxt "NpcYell:18995:0:13"
msgid "We're only a hop, skip, and a jump away from our goal! One final push─for the initiative!"
msgstr ""

#. ja: 集まってくれてあんがとよッ！<br>ここに、この先の溶融ガラスを冷却するための施設を造ってくぞ！
#. de: Das nenne ich mal 'ne ordentliche Truppe! Also, wir bauen hier 'ne Anlage, mit der wir später das Magmaglas abkühlen können!
#. fr: Merci d'avoir répondu présent à l'appel<nbsp>! Nous allons construire des ins<shy>tal<shy>la<shy>tions qui nous permettront de refroidir le verre en fusion.
msgctxt "NpcYell:18996:0:13"
msgid "Our task is to build a housing unit for drones capable of cooling molten glass."
msgstr ""

#. ja: この拠点からドローンを飛ばして、冷却剤を散布させんだ！<br>火口地帯の探索がグッと進むはずだぜッ！
#. de: Wir werden von dieser Station Drohnen mit Kühlmittel aussenden, um das Magmaglas zu kühlen! Dann können wir auch den Vulkankrater ordentlich erkunden!
#. fr: Des drones seront envoyés depuis cette base avec pour mission de répandre du liquide de refroidissement au sol. Ainsi, on devrait pouvoir explorer le cratère en toute sécurité<nbsp>!
msgctxt "NpcYell:18997:0:13"
msgid "We hope to forge a safe path across Fusingway Vent in the name of exploration─but for that, we require a mobilization station!"
msgstr ""

#. ja: なんとか助かったが…
#. de: Puh, das war knapp<nbsp>...
#. fr: Ouf... Il s'en est fallu de peu...
msgctxt "NpcYell:18998:0:13"
msgid "That was close..."
msgstr ""

#. ja: 今回のクレーン建設で通路を延ばせば、<br>いよいよ大穴を探索することができるようになるぞッ！
#. de: Über die Plattformen, die von diesen Kränen getragen werden, können wir endlich sicher den Kapselgrund erforschen, also legt euch ins Zeug!
#. fr: Avec l'installation de nouvelles grues, on devrait enfin pouvoir atteindre le fond du mystérieux gouffre<nbsp>!
msgctxt "NpcYell:18999:0:13"
msgid "With this crane construction, we may finally pave a path to the chasm!"
msgstr ""
