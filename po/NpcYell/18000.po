# NpcYell
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: このまま一気に<br>進みましょう！
#. de: Dann wollen wir doch gleich weiter!
#. fr: On continue droit devant<nbsp>!
msgctxt "NpcYell:18000:0:13"
msgid "Just one last push to the top!"
msgstr ""

#. ja: さあ、上層を目指そう…！
#. de: Kommt! Die oberen Ebenen erwarten uns!
#. fr: Dirrrection le sommet<nbsp>!
msgctxt "NpcYell:18001:0:13"
msgid "Onwards to the upper level!"
msgstr ""

#. ja: へっ…<br>アタシたちの勝ちだ！
#. de: Ob zwei, vier oder zweiunddreißig Arme<nbsp>- meine Axt zerteilt alles!
#. fr: Ouais<nbsp>! On a gagné<nbsp>!
msgctxt "NpcYell:18002:0:13"
msgid "Victory is ours!"
msgstr ""

#. ja: ふう…<br>倒せたようね…
#. de: Puh ...! So viel dazu<nbsp>...
#. fr: Ouf... C'était pas facile...
msgctxt "NpcYell:18003:0:13"
msgid "Whew, we did it..."
msgstr ""

#. ja: 行きましょう！
#. de: Auf auf, Freunde!
#. fr: Ne perdons pas de temps<nbsp>! Venez<nbsp>!
msgctxt "NpcYell:18004:0:13"
msgid "Let's go!"
msgstr ""

#. ja: よし、乗り込むぞ！
#. de: Nur noch ein kleines Stück!
#. fr: Tout le monde à borrrd<nbsp>!
msgctxt "NpcYell:18005:0:13"
msgid "Right, in we go!"
msgstr ""

#. ja: みんな、準備はいいな？
#. de: Alle bereit?
#. fr: Vous êtes prêts<nbsp>? C'est parti<nbsp>!
msgctxt "NpcYell:18006:0:13"
msgid "Everyone ready?"
msgstr ""

#. ja: ここから上に<br>行けるのね…
#. de: Von hier aus geht es also nach oben<nbsp>...
#. fr: Le sommet de la tour nous attend...
msgctxt "NpcYell:18007:0:13"
msgid "So this will take us above..."
msgstr ""

#. ja: ああ、問題ない…！
#. de: Kein Problem ...!
#. fr: Plutôt deux fois qu'une<nbsp>!
msgctxt "NpcYell:18008:0:13"
msgid "Of course!"
msgstr ""

#. ja: とにかく前に<br>進みましょう…！
#. de: Aufgeben kommt nicht in Frage!
#. fr: Allez, pas le moment de bavarder<nbsp>!
msgctxt "NpcYell:18009:0:13"
msgid "Let's keep moving!"
msgstr ""

#. ja: さて、ここの区画は…
#. de: Und wo genau sind wir hier ...?
#. fr: Nous voilà dans une nouvelle zone...
msgctxt "NpcYell:18010:0:13"
msgid "What will we find here, I wonder."
msgstr ""

#. ja: ここが上層…<br>心なしか空気が冷たいわ
#. de: Die oberen Ebenen<nbsp>... Bin das nur ich, oder ist es auf einmal kälter geworden ...?
#. fr: L'air est de plus en plus froid... Le sommet n'est plus très loin.
msgctxt "NpcYell:18011:0:13"
msgid "The air somehow feels colder here..."
msgstr ""

#. ja: この魂の悪用は<br>なんとしても避けないと…
#. de: Das ist einfach falsch. Alles an dem, was sie hier tun, ist falsch!
#. fr: Cette ex<shy>ploi<shy>ta<shy>tion d'âmes doit cesser au plus vite<nbsp>!
msgctxt "NpcYell:18012:0:13"
msgid "We have to stop them from being misused."
msgstr ""

#. ja: 魂資源が<br>格納されているのか…？
#. de: Die Seelen werden eingelagert<nbsp>...
#. fr: Les réserrrves d'âmes sont donc entassées ici<nbsp>?
msgctxt "NpcYell:18013:0:13"
msgid "Being stored...like common goods."
msgstr ""

#. ja: これも全部が<br>命だったんだよな…
#. de: Jede von ihnen stellt ein vergangenes Leben dar<nbsp>...
#. fr: Auparavant, toutes ces âmes étaient emplies de vie...
msgctxt "NpcYell:18014:0:13"
msgid "These are all lives..."
msgstr ""

#. ja: 無機質すぎて<br>寒気がするわ…
#. de: Das ganze Konzept der Seele hier ist so<nbsp>... steril<nbsp>... so abscheulich steril!
#. fr: L'atmosphère est si froide et désolée...
msgctxt "NpcYell:18015:0:13"
msgid "It's chilling to see souls treated with such indifference."
msgstr ""

#. ja: 駆除人たちが<br>使っていたやつね…
#. de: Die Merzer nutzten das doch auch<nbsp>...
#. fr: C'est ce qu'utilisaient les exterminateurs...
msgctxt "NpcYell:18016:0:13"
msgid "That's what the hunters use..."
msgstr ""

#. ja: アラグ帝国にも通じる<br>異様さを感じるよ
#. de: Diese Befremdlichkeit erinnert mich ein wenig an die Allager<nbsp>...
#. fr: Toute cette étrangeté me rappelle l'empirrre d'Allag...
msgctxt "NpcYell:18017:0:13"
msgid "The aberrance is reminiscent of the Allagan Empire."
msgstr ""

#. ja: 魔物の魂を使えば<br>強くなれる、か…
#. de: Sich mit Bestienseelen verstärken<nbsp>...
#. fr: C'est grâce aux âmes des monstres qu'il pense devenir le plus fort...
msgctxt "NpcYell:18018:0:13"
msgid "Feral souls... I can't get used to the idea..."
msgstr ""

#. ja: 魂を扱う研究施設…
#. de: Ein Labor zur Seelenforschung<nbsp>...
#. fr: Un laboratoire d'âmes... Fascinant et terrifiant à la fois...
msgctxt "NpcYell:18019:0:13"
msgid "A facility for researching souls..."
msgstr ""

#. ja: 生き物をあんな姿に<br>改造するなんて…
#. de: Wie können sie nur! Lebewesen derart zu entstellen!
#. fr: C'est dingue de bidouiller un être vivant à ce point...
msgctxt "NpcYell:18020:0:13"
msgid "How could you twist a living creature like that?"
msgstr ""

#. ja: 生体の改造…<br>これもアラグに通じる技術だ…
#. de: Die künstliche Modifikation des Körpers<nbsp>... Noch etwas, mit dem sich die Allager bestens auskannten<nbsp>...
#. fr: Les êtres augmentés... Voilà encorrre une obsession allagoise.
msgctxt "NpcYell:18021:0:13"
msgid "Mechanical augmentation... This wouldn't have been amiss in Allag."
msgstr ""

#. ja: カメェェェッー？
#. de: Eine <i>Schildkröte</i>?!
#. fr: UNE TORTUUUUUUE<nbsp>!!!
msgctxt "NpcYell:18022:0:13"
msgid "A giant enemy tortoise!?"
msgstr ""

#. ja: エレクトロープで<br>強化されているの！？
#. de: Ist die Arme etwa mit Elektrob versehen worden ...?
#. fr: Elle a été fortifiée avec de l'électrope<nbsp>!?
msgctxt "NpcYell:18023:0:13"
msgid "It appears to be enhanced with electrope!"
msgstr ""

#. ja: 悪寒がするわ…<br>理由はわからないけど…
#. de: Ich weiß nicht warum, aber<nbsp>... ich hab plötzlich am ganzen Körper Gänsehaut ...!
#. fr: Je sais pas pourquoi, mais ça me donne des frissons...
msgctxt "NpcYell:18024:0:13"
msgid "I don't know why, but I suddenly feel a chill..."
msgstr ""

#. ja: 機械兵…<br>ではないようだな…
#. de: Ein Maschinensoldat ist das jedenfalls nicht<nbsp>...
#. fr: Ce n'est pas une sentinelle...
msgctxt "NpcYell:18025:0:13"
msgid "This is no mechanical soldier..."
msgstr ""

#. ja: なんだか<br>気味の悪い奴だな…！
#. de: Der sieht ja unheimlich aus<nbsp>...
#. fr: En voilà un qui veut nous faire la peau<nbsp>!
msgctxt "NpcYell:18026:0:13"
msgid "Something feels seriously off about this one..."
msgstr ""

#. ja: うぅっ…この気配…<br>この意思は…
#. de: Argh! Diese Aura<nbsp>... Dieser Wille ...!
#. fr: Cette aura... Sa volonté est purement destructrice<nbsp>!
msgctxt "NpcYell:18027:0:13"
msgid "Oh gods... His aura...it's so very wrong..."
msgstr ""

#. ja: しっかりしろ、クルル！<br>奴は戦うつもりだぞ！
#. de: Reiß dich zusammen! Der ist auf Blut aus!
#. fr: Sois forte, Krile<nbsp>! Il va pas nous faire de cadeau<nbsp>!
msgctxt "NpcYell:18028:0:13"
msgid "Focus, Krile! It's time to fight!"
msgstr ""

#. ja: 一気に最上層まで<br>行けたらいいのに…
#. de: Ich wünschte, es gäbe eine Abkürzung nach oben<nbsp>...
#. fr: Si seulement on pouvait claquer des doigts et se retrouver au sommet...
msgctxt "NpcYell:18029:0:13"
msgid "A shame this elevator doesn't go straight to the top."
msgstr ""

#. ja: 警戒は怠るなよ…
#. de: Bleibt wachsam allesamt!
#. fr: Ne baissez surrrtout pas votre garde...
msgctxt "NpcYell:18030:0:13"
msgid "Let us stay on our guard."
msgstr ""

#. ja: ここまでは順調ね…
#. de: Das läuft doch wie geschmiert!
#. fr: Jusqu'ici, tout va bien...
msgctxt "NpcYell:18031:0:13"
msgid "So far, so good..."
msgstr ""

#. ja: なっ…<br>剣を操っているのか！？
#. de: Er kontrolliert die Klingen!
#. fr: Il contrôle les épées<nbsp>!?
msgctxt "NpcYell:18032:0:13"
msgid "He controls the blades!"
msgstr ""

#. ja: 見切れるはずだ！
#. de: Nichts, dem wir nicht gewappnet sind!
#. fr: On peut les esquiver<nbsp>!
msgctxt "NpcYell:18033:0:13"
msgid "We can evade it, surely!"
msgstr ""

#. ja: 処理通りに<br>実行されるのなら…
#. de: Wenn es immer die gleichen Prozesse durchgeht, dann ...
#. fr: S'il exécute ce programme...
msgctxt "NpcYell:18034:0:13"
msgid "If it executes the process..."
msgstr ""

#. ja: また来るわ！<br>処理を見極めるのよ！
#. de: Da! Passt genau auf!
#. fr: Le revoilà<nbsp>! Soyez vifs<nbsp>!
msgctxt "NpcYell:18035:0:13"
msgid "Here it comes again!"
msgstr ""

#. ja: あー！<br>頭がこんがらかってきた！
#. de: Ah! Mein Kopf! Wieso ist immer alles so kompliziert?!
#. fr: Argh, ça va trop vite pour moi<nbsp>!
msgctxt "NpcYell:18036:0:13"
msgid "Gah, my head can't keep up!"
msgstr ""

#. ja: なんだ！？<br>バラバラになったぞ！
#. de: Wie? Was passiert da?
#. fr: Hein<nbsp>!? Il s'est séparé en petits morceaux<nbsp>!
msgctxt "NpcYell:18037:0:13"
msgid "It's split into pieces!"
msgstr ""

#. ja: 意図的に分離した…<br>仕掛けてくるぞ！
#. de: Er hat sich selbst aufgeteilt. Da ist etwas im Argen ...
#. fr: Ça cache quelque chose... Prrrudence<nbsp>!
msgctxt "NpcYell:18038:0:13"
msgid "It's definitely up to something!"
msgstr ""

#. ja: 外周に気をつけて！
#. de: Passt auf den äußeren Rand auf!
#. fr: Attention au périmètre extérieur<nbsp>!
msgctxt "NpcYell:18039:0:13"
msgid "Beware the spheres yonder!"
msgstr ""

#. ja: パーツの組み合わせで<br>戦術を変えるのか！
#. de: Je nach Anordnung der Teile verändert sich sein Angriff!
#. fr: Il change de tactique en se rrreconstruisant<nbsp>!
msgctxt "NpcYell:18040:0:13"
msgid "It changes tactics by rearranging itself!"
msgstr ""

#. ja: 見ろ！<br>武器を付け替えたぞ！
#. de: Da! Die Waffe hat die Seite gewechselt!
#. fr: Regardez<nbsp>! L'arme a changé de côté<nbsp>!
msgctxt "NpcYell:18041:0:13"
msgid "The sword's changed sides!"
msgstr ""

#. ja: 雷の力で<br>操っているようね…！
#. de: Es nutzt Blitzenergie um sie zu steuern ...!
#. fr: Il la contrôle grâce à la foudre<nbsp>!
msgctxt "NpcYell:18042:0:13"
msgid "It controls it with lightning!"
msgstr ""

#. ja: 装着した側に警戒を！
#. de: Passt auf seine neue Bewaffnung auf!
#. fr: Méfiez-vous du côté de l'arrrme<nbsp>!
msgctxt "NpcYell:18043:0:13"
msgid "Have care on the weapon side!"
msgstr ""

#. ja: 背中のパーツが<br>分離したわ！
#. de: Die Teile auf seinem Rücken haben sich abgekoppelt!
#. fr: La partie sur son dos s'est désassemblée<nbsp>!
msgctxt "NpcYell:18044:0:13"
msgid "The piece on its back has separated!"
msgstr ""

#. ja: 遠隔操作しているのか…！
#. de: Kontrolliert es sie per Fernsteuerung ...?
#. fr: Il contrrrôle ses éléments à distance<nbsp>!
msgctxt "NpcYell:18045:0:13"
msgid "It's controlling its parts remotely!"
msgstr ""

#. ja: 同時に<br>仕掛けるつもりだな？
#. de: Ein Angriff von allen Seiten, was?
#. fr: Tu veux tous nous avoir d'un coup, hein<nbsp>?
msgctxt "NpcYell:18046:0:13"
msgid "Want to get us from all directions, eh?"
msgstr ""

#. ja: 力が収束していく…！
#. de: Es ballt seine Kraft ...!
#. fr: Il rassemble son énergie<nbsp>!
msgctxt "NpcYell:18047:0:13"
msgid "It's harnessing power!"
msgstr ""

#. ja: あの装置で<br>集めているんだ…！
#. de: Diese Apparaturen helfen ihm beim Sammeln!
#. fr: En se serrrvant de ces pylônes<nbsp>!
msgctxt "NpcYell:18048:0:13"
msgid "Through those contraptions, it seems."
msgstr ""

#. ja: とりあえず<br>ブッ壊そうぜ！
#. de: Dann hauen wir sie um!
#. fr: On a qu'à tout défoncer<nbsp>!
msgctxt "NpcYell:18049:0:13"
msgid "Then we better destroy them!"
msgstr ""

#. ja: さらに力が収束…！
#. de: Es sammelt immer mehr ...!
#. fr: Il amasse encore plus d'énergie<nbsp>!
msgctxt "NpcYell:18050:0:13"
msgid "It's harnessing even more power!"
msgstr ""

#. ja: すげぇのが来るぞ！
#. de: Da kommt was Fieses!
#. fr: On dirait que ça va faire mal<nbsp>!
msgctxt "NpcYell:18051:0:13"
msgid "Here comes the big one!"
msgstr ""

#. ja: 集合して耐えるんだ！
#. de: Zusammen bleiben!
#. fr: Rassemblons-nous pour mieux rrrésister<nbsp>!
msgctxt "NpcYell:18052:0:13"
msgid "Quickly, stand together!"
msgstr ""

#. ja: ここが…<br>スフェーンの記憶領域…
#. de: Das ist<nbsp>... das Innere des Erinnerungsspeichers ...?
#. fr: On est dans les souvenirs de Sphene...
msgctxt "NpcYell:18053:0:13"
msgid "We're inside Sphene's memories..."
msgstr ""

#. ja: 彼女が生きた時代の<br>アレクサンドリアなの？
#. de: Alexandria zu einer Zeit, als Sphene noch lebte ...
#. fr: C'est Alexandrie de son vivant...<nbsp>?
msgctxt "NpcYell:18054:0:13"
msgid "Is this Alexandria as it was when she lived?"
msgstr ""

#. ja: 記憶に基づいた<br>幻想世界か…
#. de: Eine virtuelle Welt auf der Basis ihrer Erinnerungen ...
#. fr: Un monde virtuel qui prrrend sa source dans la mémoire de Sphene...
msgctxt "NpcYell:18055:0:13"
msgid "A virtual domain generated by her memories..."
msgstr ""

#. ja: 慕われてたんだな<br>国民から…
#. de: Das Volk liebt sie ...
#. fr: Son peuple l'adorait...
msgctxt "NpcYell:18056:0:13"
msgid "The people really did love her."
msgstr ""

#. ja: 人々もまた<br>再現されているのね…
#. de: Selbst die Bürger des Königreichs wurden nachgebildet ...
#. fr: Les Alexandrins ont été recréés, eux aussi.
msgctxt "NpcYell:18057:0:13"
msgid "Even the citizens have been recreated."
msgstr ""

#. ja: 皆に慕われる王女様か…
#. de: Ganz schön beliebt, unsere junge Prinzessin ...
#. fr: Elle était vrrraiment la princesse du peuple...
msgctxt "NpcYell:18058:0:13"
msgid "She truly was the people's princess..."
msgstr ""

#. ja: 彼女の本質は<br>善良そのものだからな
#. de: Sphenes aufrichtiger Güte ist wohl nicht zu widerstehen.
#. fr: La bonté incarrrnée.
msgctxt "NpcYell:18059:0:13"
msgid "She was goodness personified."
msgstr ""

#. ja: へっ…<br>逆に排除してやるぜ！
#. de: Ha! Wollen wir doch mal sehen, wer hier wen eliminiert!
#. fr: On va s'en débarrasser<nbsp>!
msgctxt "NpcYell:18060:0:13"
msgid "We'll remove them instead!"
msgstr ""

#. ja: 当然、こうなるわよね
#. de: Natürlich lässt man uns nicht einfach passieren ...
#. fr: Évidemment.
msgctxt "NpcYell:18061:0:13"
msgid "Naturally."
msgstr ""

#. ja: 侵入に気づかれたか…！
#. de: Wir wurden bemerkt!
#. fr: On est repérrrés<nbsp>!
msgctxt "NpcYell:18062:0:13"
msgid "It appears we've been discovered."
msgstr ""

#. ja: 民と触れ合うのは<br>昔からだったんだな
#. de: Ihre Volksnähe war scheinbar schon immer eine ihrer Stärken ...
#. fr: Même plus jeune, elle était proche de son peuple.
msgctxt "NpcYell:18063:0:13"
msgid "Even back then she was close to her people..."
msgstr ""

#. ja: 平和の象徴、か…
#. de: Ein Symbol des Friedens, hm?
#. fr: Un véritable symbole de paix...
msgctxt "NpcYell:18064:0:13"
msgid "All is right in the world..."
msgstr ""

#. ja: あの飛空艇に彼女が…
#. de: Sphenes Luftschiff ...
#. fr: Elle est juste là, dans cet aérrronef...
msgctxt "NpcYell:18065:0:13"
msgid "To think that she is right there..."
msgstr ""

#. ja: アタシらの<br>邪魔をするな！
#. de: Was auch immer das ist, machen wir es fertig!
#. fr: J'y pige que dalle, mais on va tout écraser<nbsp>!
msgctxt "NpcYell:18066:0:13"
msgid "Whatever this is, it's going down!"
msgstr ""

#. ja: 記憶の世界に<br>システムの防御介入が…
#. de: Das System greift in die Erinnerungen ein ...
#. fr: On doit gagner<nbsp>!
msgctxt "NpcYell:18067:0:13"
msgid "The system is intervening directly in the memories..."
msgstr ""

#. ja: 突破するだけだ！
#. de: Zeit durchzugreifen!
#. fr: On avance<nbsp>!
msgctxt "NpcYell:18068:0:13"
msgid "Let's clear the path!"
msgstr ""

#. ja: どうだ！<br>まいったか！
#. de: Wie schmeckt dir das?
#. fr: Alors<nbsp>? T'en veux encore<nbsp>?
msgctxt "NpcYell:18069:0:13"
msgid "How do you like that!?"
msgstr ""

#. ja: どうにか倒せたわね
#. de: Geschafft! 
#. fr: Victoire<nbsp>!
msgctxt "NpcYell:18070:0:13"
msgid "We did it!"
msgstr ""

#. ja: まだ妨害は続くはず<br>油断するなよ
#. de: Das Sicherheitssystem wird uns auch weiterhin drangsalieren. Bleibt wachsam!
#. fr: Rien n'est gagné, restons prrrudents.
msgctxt "NpcYell:18071:0:13"
msgid "There will be more interference. Let us remain vigilant."
msgstr ""

#. ja: 同じ場所…<br>なんだよな…？
#. de: Ist das immer noch ... Alexandria?
#. fr: C'est toujours Alexandrie<nbsp>?
msgctxt "NpcYell:18072:0:13"
msgid "Huh? Is this is still Alexandria?"
msgstr ""

#. ja: 周囲の光景が<br>一変した…！？
#. de: Was ist denn plötzlich mit der Stadt los?
#. fr: Le paysage a changé...
msgctxt "NpcYell:18073:0:13"
msgid "What in the world has happened...?"
msgstr ""

#. ja: どうやら時代が<br>進んだらしいな…
#. de: Scheint, als wären wir nun im nächsten Kapitel des Königreichs ...
#. fr: Je pense qu'il s'agit d'une autrrre époque.
msgctxt "NpcYell:18074:0:13"
msgid "I daresay we are come to a different time."
msgstr ""

#. ja: 城下町が<br>崩壊しちまってるぞ…
#. de: Alles ist so zerstört ...
#. fr: La ville est en ruines...
msgctxt "NpcYell:18075:0:13"
msgid "Everything is in ruins..."
msgstr ""

#. ja: 記憶だとわかっていても<br>辛い光景ね…
#. de: Ich weiß, es ist nur eine Erinnerung<nbsp>... aber trotzdem ...
#. fr: Même s'il ne s'agit que d'un souvenir, ça fait froid dans le dos...
msgctxt "NpcYell:18076:0:13"
msgid "I know this is only a memory, but still..."
msgstr ""

#. ja: 雷光大戦…<br>その影響か…
#. de: Die Folgen der Stromschlachten ...
#. fr: La Guerre des fulgurrrations...
msgctxt "NpcYell:18077:0:13"
msgid "This is the culmination of the Storm Surge..."
msgstr ""

#. ja: 助けてぇけど…<br>けどよ…
#. de: Ich würde ihnen so gerne helfen<nbsp>... aber ...
#. fr: Je veux les aider... mais c'est impossible...
msgctxt "NpcYell:18078:0:13"
msgid "This feels so real, it hurts not to help them..."
msgstr ""

#. ja: これは記憶…<br>過去の出来事なのよね
#. de: Eine Erinnerung<nbsp>... Das ist lediglich eine Erinnerung<nbsp>... richtig?
#. fr: Un autre souvenir du passé...
msgctxt "NpcYell:18079:0:13"
msgid "This is only a memory... It's all in the past now..."
msgstr ""

#. ja: 未来の記憶を<br>思い出すな…
#. de: Ob sie sich als nächstes wohl an die Zukunft erinnert ...?
#. fr: Ça me rappelle tellement le futurrr que j'ai vu...
msgctxt "NpcYell:18080:0:13"
msgid "I can't help but remember the future I lived..."
msgstr ""

#. ja: ええ、これは記憶<br>過去の出来事よ
#. de: Lediglich eine Erinnerung ...
#. fr: C'est dur... mais il ne faut pas oublier que c'est le passé<nbsp>!
msgctxt "NpcYell:18081:0:13"
msgid "I know... I need to remind myself it's only a memory..."
msgstr ""

#. ja: 見ろ！<br>スフェーンたちの飛空艇が！
#. de: Da! Sphenes Luftschiff!
#. fr: Regardez<nbsp>! C'est l'aéronef de Sphene<nbsp>!
msgctxt "NpcYell:18082:0:13"
msgid "The airships are in trouble!"
msgstr ""

#. ja: なんてことなの…！
#. de: Was geht hier vor sich ...?
#. fr: Que se passe-t-il<nbsp>?
msgctxt "NpcYell:18083:0:13"
msgid "Twelve have mercy..."
msgstr ""

#. ja: 盾になろうと<br>いうのか…！
#. de: Ein Schild für die Leute ...?
#. fr: Elle tente de prrrotéger les siens<nbsp>!
msgctxt "NpcYell:18084:0:13"
msgid "That airship is shielding the other!"
msgstr ""

#. ja: そこをどけぇ！
#. de: Aus dem Weg!
#. fr: Dégage<nbsp>!
msgctxt "NpcYell:18085:0:13"
msgid "Out of our way!"
msgstr ""

#. ja: 跳ね除けるのみよ！
#. de: Ein Klecks nach dem anderen!
#. fr: On écartera tout ce qui se mettra en travers de notre route<nbsp>!
msgctxt "NpcYell:18086:0:13"
msgid "Whatever bars our way, we'll brush aside!"
msgstr ""

#. ja: どんな妨害だろうと…！
#. de: Was sich uns auch ent<shy>gegen<shy>stellen mag ...!
#. fr: Rien ne nous arrêterrra<nbsp>!
msgctxt "NpcYell:18087:0:13"
msgid "It matters not what bars our way!"
msgstr ""

#. ja: 跳ね除けるのみね！
#. de: Wird Klecks für Klecks ausradiert!
#. fr: Hors de notre chemin<nbsp>!
msgctxt "NpcYell:18088:0:13"
msgid "We'll brush them all aside!"
msgstr ""

#. ja: これで終いか…！？
#. de: War's das?
#. fr: ... C'est tout<nbsp>?
msgctxt "NpcYell:18089:0:13"
msgid "And that's that!"
msgstr ""

#. ja: はぁ、はぁ…<br>息を整えましょう
#. de: Keuch ... Keuch ... Erst mal tief Luft holen!
#. fr: Reprenons notre souffle.
msgctxt "NpcYell:18090:0:13"
msgid "\\<pant> Need a moment to catch my breath..."
msgstr ""

#. ja: 障害は排除したが…
#. de: Endlich<nbsp>... geschafft!
#. fr: Un autre obstacle horrrs de notre chemin.
msgctxt "NpcYell:18091:0:13"
msgid "Another obstacle out of the way."
msgstr ""

#. ja: また時代が変わった…？
#. de: Sind wir etwa schon wieder in einer anderen Zeit ...?
#. fr: C'est encore une autre époque<nbsp>?
msgctxt "NpcYell:18092:0:13"
msgid "Are we in a different time again?"
msgstr ""

#. ja: 同じ城下町の<br>ようだけれど…
#. de: Die Stadt scheint noch die gleiche zu sein ...
#. fr: De toute évidence, il s'agit toujours d'Alexandrie.
msgctxt "NpcYell:18093:0:13"
msgid "It appears to be the same place..."
msgstr ""

#. ja: 戦争が終わり<br>復興が始まった時代か…
#. de: Der Krieg ist vorbei und der Wieder<shy>aufbau beginnt ...
#. fr: La guerre est terminée... et la rrrecon<shy>struc<shy>tion a commencé.
msgctxt "NpcYell:18094:0:13"
msgid "The war appears to have ended..."
msgstr ""

#. ja: なんだ、なんだ？<br>様子がおかしいぞ
#. de: Was ist denn jetzt auf einmal los?!
#. fr: Il y a quelque chose qui cloche...
msgctxt "NpcYell:18095:0:13"
msgid "Huh? Something seems off..."
msgstr ""

#. ja: 記憶領域が<br>不安定になっているみたい
#. de: Der Erinnerungsspeicher! Er beginnt sich zu destabilisieren!
#. fr: Je pense que certains blocs mémoire sont instables...
msgctxt "NpcYell:18096:0:13"
msgid "The memory banks have become unstable."
msgstr ""

#. ja: 記憶が<br>壊れかけているのか？
#. de: Die Erinnerung fängt an auseinanderzufallen?
#. fr: Les souvenirs commencent à se brrriser...
msgctxt "NpcYell:18097:0:13"
msgid "Are the memories breaking down?"
msgstr ""

#. ja: どうなってるんだ！？
#. de: Das wird ja immer schlimmer!
#. fr: Qu'est-ce qui se passe<nbsp>?
msgctxt "NpcYell:18098:0:13"
msgid "What's going on!?"
msgstr ""

#. ja: 急ぎましょう<br>嫌な予感がするわ…
#. de: Beeilen wir uns lieber! Ich ahne Schlimmes ...
#. fr: J'ai un mauvais pres<shy>sen<shy>ti<shy>ment... Dépêchons-nous<nbsp>!
msgctxt "NpcYell:18099:0:13"
msgid "I have a bad feeling about this... Let's hurry!"
msgstr ""

#. ja: システムまでもが<br>不安定になっている…？
#. de: Fällt etwa das gesamte System auseinander?!
#. fr: Le système lui-même ne fonctionne plus<nbsp>?
msgctxt "NpcYell:18100:0:13"
msgid "The system itself may have become unstable."
msgstr ""

#. ja: 暴れすぎた…<br>ってことはないよな？
#. de: Ist das vielleicht unsere Schuld? Waren wir zu gemein zu ihm?
#. fr: C'est pas de notre faute, au moins<nbsp>?
msgctxt "NpcYell:18101:0:13"
msgid "It's not because of us, is it?"
msgstr ""

#. ja: スフェーン、待ってろよ…！
#. de: Nur noch ein Stück, Sphene ... Nur noch ein kleines Stück ...
#. fr: Sphene, on arrive<nbsp>!
msgctxt "NpcYell:18102:0:13"
msgid "We're coming, Sphene!"
msgstr ""

#. ja: 最後の障害…<br>ってところかしら
#. de: Unsere letzte Hürde<nbsp>... 
#. fr: Le dernier obstacle à franchir...
msgctxt "NpcYell:18103:0:13"
msgid "The final obstacle..."
msgstr ""

#. ja: 巨大な剣に拳…<br>その動きに警戒しよう
#. de: Ein gigantisches Schwert gepaart mit einer gigantischen Faust<nbsp>... Passen wir lieber auf ...!
#. fr: Garrrdons l'œil sur ce poing et cette épée...
msgctxt "NpcYell:18104:0:13"
msgid "Let's keep a close eye on that sword and fist."
msgstr ""

#. ja: 突破して<br>会いにいきましょう！
#. de: Aufhalten kann es uns trotzdem nicht. Machen wir den Weg zu Sphene frei!
#. fr: Gagnons, pour nous rendre auprès de Sphene<nbsp>!
msgctxt "NpcYell:18105:0:13"
msgid "We'll find her as soon as we've dealt with this!"
msgstr ""

#. ja: こ、これは…
#. de: W-Was zur ...?
#. fr: Mais qu'est-ce que...
msgctxt "NpcYell:18106:0:13"
msgid "What happened here...?"
msgstr ""

#. ja: 見て、魔物たちが…
#. de: So viele ...!
#. fr: Regardez<nbsp>! Les créatures<nbsp>!
msgctxt "NpcYell:18107:0:13"
msgid "These creatures were killed..."
msgstr ""

#. ja: 縄張り争いでも<br>してたのか…？
#. de: Hat hier ein Revierkampf stattgefunden ...?
#. fr: Elles cherchent à défendre leur territoire, non<nbsp>?
msgctxt "NpcYell:18108:0:13"
msgid "Some territorial dispute?"
msgstr ""

#. ja: …気をつけましょう！
#. de: Lasst uns auf der Hut bleiben!
#. fr: Restons sur nos gardes<nbsp>!
msgctxt "NpcYell:18109:0:13"
msgid "Let's proceed with care!"
msgstr ""

#. ja: カフキワさんの<br>プログラムに対抗してきたか！
#. de: Das System wehrt sich gegen Cahciuas Programm!
#. fr: Le système réagit au prrrogramme de Cahciua<nbsp>!
msgctxt "NpcYell:18110:0:13"
msgid "It's employing countermeasures against Cahciua's program!"
msgstr ""

#. ja: ここが剣闘士たちの<br>修練所か…
#. de: Hier haben die Gladiatoren von früher also ihre Kunst studiert<nbsp>...
#. fr: Alors voici le camp d'en<shy>traî<shy>ne<shy>ment des gladiateurs...
msgctxt "NpcYell:18111:0:13"
msgid "So this is where gladiators once learned their craft..."
msgstr ""

#. ja: 涼しいね～<br>荒野とは思えないよ～
#. de: Kalt ist es hier drin<nbsp>... Was für ein Unterschied zur Wüstensonne, was?
#. fr: Qu'il fait froid ! À se demander si nous sommes encore dans le désert !
msgctxt "NpcYell:18112:0:13"
msgid "This chill in the air... 'Tis a far cry from the desert heat."
msgstr ""

#. ja: さて…<br>何が出てくるのかしら
#. de: Welche Kreaturen sich in diesen schwarzen Tiefen wohl herumtreiben?
#. fr: Quelles créatures nous attendent ici ?
msgctxt "NpcYell:18113:0:13"
msgid "What manner of creature lurks in these depths?"
msgstr ""

#. ja: 獣の匂い…<br>気を引き締めろよ
#. de: Ich rieche Bestien<nbsp>... Geben wir gut acht.
#. fr: Je sens l'odeur des bêtes... Restez sur vos gardes.
msgctxt "NpcYell:18114:0:13"
msgid "The stench of beasts... We must needs remain cautious."
msgstr ""

#. ja: 魔力の奔流…<br>飛び込んでみるか？
#. de: Dieser Ätherstrom sieht doch vertrauenswürdig aus. Nichts wie rein!
#. fr: Un flux éthéré... Peut-être devrions-nous plonger dedans ?
msgctxt "NpcYell:18115:0:13"
msgid "This flow of aether looks promising enough. Let's dive in!"
msgstr ""

#. ja: 見ろ、魔力の奔流だ<br>流れに乗ってみよう
#. de: Dieser Wirbel wird uns weiterbringen.
#. fr: Regardez, c'est un flux éthéré ! Il peut nous emporter ailleurs !
msgctxt "NpcYell:18116:0:13"
msgid "This confluence should bear us onward."
msgstr ""

#. ja: 鉄鎖のウインチだ～<br>引っ張ってみよ～
#. de: Sollen wir einmal daran ziehen?
#. fr: Un palan à chaîne ! Ça fait quoi si on tire dessus ?
msgctxt "NpcYell:18117:0:13"
msgid "What happens if we pull this?"
msgstr ""

#. ja: あのウインチを<br>調べてみない？
#. de: Dieses Gewinde sollte sich doch lösen lassen.
#. fr: Je pense qu'il serait judicieux d'examiner ce palan à chaîne.
msgctxt "NpcYell:18118:0:13"
msgid "Perhaps we ought to loosen that winch."
msgstr ""

#. ja: また魔力の奔流だ～
#. de: Kommt, rein in den Äther.
#. fr: Encore un flux éthéré !
msgctxt "NpcYell:18119:0:13"
msgid "The aether beckons. Let us make haste."
msgstr ""

#. ja: 魔力の奔流ね<br>利用しましょう
#. de: Lassen wir uns vom Äther weitertragen.
#. fr: Un autre flux éthéré qui ne demande qu'à être utilisé.
msgctxt "NpcYell:18120:0:13"
msgid "Let us ride the aetherial flow."
msgstr ""

#. ja: フン、力比べなら<br>負けないぜ！
#. de: Ha, das ist doch keine Heraus<shy>forde<shy>rung für mich!
#. fr: Ha ! Nul ne peut rivaliser avec moi question force brute !
msgctxt "NpcYell:18121:0:13"
msgid "Heh! Even that brawn's no match for me!"
msgstr ""

#. ja: 大型の妖異だね～<br>階位は第九位かな～
#. de: Ein Nichts<shy>gesand<shy>ter? Merkwürdig.
#. fr: Une grande créature du néant... De neuvième rang, peut-être ?
msgctxt "NpcYell:18122:0:13"
msgid "A demon of the ninth rung? Curious..."
msgstr ""

#. ja: オーガ型の妖異…<br>手ごわそうね
#. de: Dies ist nicht gerade ein kleiner Geselle.
#. fr: On dirait une sorte d'ogre... Il n'a pas l'air commode.
msgctxt "NpcYell:18123:0:13"
msgid "An ogre...and a formidable one at that."
msgstr ""

#. ja: 不浄な存在め<br>ここで浄化してくれよう
#. de: Hinfort mit dir, Wesen der Finsternis!
#. fr: Vile créature, nous allons te purifier !
msgctxt "NpcYell:18124:0:13"
msgid "Fell being of darkness begone!"
msgstr ""

#. ja: こんな遺跡が<br>砂に埋もれていたとはな…
#. de: Wer hätte gedacht, dass all das hier unter den Sanden schlummert?
#. fr: Un temple enfoui dans le sable...
msgctxt "NpcYell:18125:0:13"
msgid "I never thought such ruins lay buried beneath the sands..."
msgstr ""

#. ja: 話題の遺跡なんでしょ～<br>お宝、見つかるかな～
#. de: Ob wir wohl auf Schätze stoßen werden?
#. fr: Voilà donc ces fameuses ruines... Elles abritent des trésors, vous croyez<nbsp>?
msgctxt "NpcYell:18126:0:13"
msgid "Do you suppose we'll find treasure?"
msgstr ""

#. ja: 盗掘者除けの<br>仕掛けには要注意よ
#. de: Vorsicht. Ganz sicher wimmelt es hier vor Fallen.
#. fr: Attention, il peut y avoir des pièges.
msgctxt "NpcYell:18127:0:13"
msgid "Take care. There will be traps."
msgstr ""

#. ja: 嫌な気配を感じる…<br>勘違いだといいけど
#. de: Dieser Ort gefällt mir ganz und gar nicht<nbsp>...
#. fr: J'espère me tromper, mais j'ai un mauvais pres<shy>sen<shy>ti<shy>ment...
msgctxt "NpcYell:18128:0:13"
msgid "I have an ill feeling about this place..."
msgstr ""

#. ja: ま、負けねぇ…！
#. de: Nein, ich werde hier nicht fallen!
#. fr: Je ne... perdrai pas... !
msgctxt "NpcYell:18129:0:13"
msgid "I won't lose...!"
msgstr ""

#. ja: みんなを…<br>守ってみせるッ…！
#. de: Ich werde alle beschützen!
#. fr: Je protégerai... mon peuple !
msgctxt "NpcYell:18130:0:13"
msgid "I'll protect everyone!"
msgstr ""

#. ja: このあたりも<br>魔物が…！
#. de: Hier gibt's ja auch Bestien ...!
#. fr: Il y a des monstres ici aussi<nbsp>!
msgctxt "NpcYell:18131:0:13"
msgid "There are beasts here, too!?"
msgstr ""

#. ja: うわあ強そう…<br>気をつけて！
#. de: Vorsicht, der sieht fies aus!
#. fr: Ouh là... Il a l'air balèze, ja.
msgctxt "NpcYell:18132:0:13"
msgid "That one looks mean. Be careful!"
msgstr ""

#. ja: とても嫌な<br>感じがする…
#. de: Ich glaube, jetzt wird es ernst<nbsp>...
#. fr: J'aime pas cet endroit, ja...
msgctxt "NpcYell:18133:0:13"
msgid "I have a bad feeling about this..."
msgstr ""

#. ja: さすがだね！
#. de: Juchhu! Super!
#. fr: Vous êtes trop forts<nbsp>!
msgctxt "NpcYell:18134:0:13"
msgid "You did it!"
msgstr ""

#. ja: グルル…！
#. de: \<knurr>
#. fr: Grrr...<nbsp>!
msgctxt "NpcYell:18135:0:13"
msgid "Grrr...!"
msgstr ""

#. ja: ガゥッ…！
#. de: Wau!!
#. fr: Graouh...<nbsp>!
msgctxt "NpcYell:18136:0:13"
msgid "Graaagh!"
msgstr ""

#. ja: わぁ！<br>びっくりした…
#. de: H-Hilfe!
#. fr: Ouah<nbsp>! J'ai eu une de ces trouilles<nbsp>!
msgctxt "NpcYell:18137:0:13"
msgid "Ah! What are those!?"
msgstr ""

#. ja: ウゥオォ…
#. de: Wuoargh!!
#. fr: Haaaagh...
msgctxt "NpcYell:18138:0:13"
msgid "Rrraaargh!"
msgstr ""

#. ja: アウゥ…
#. de: Uwuuh!!
#. fr: Mweuugh...
msgctxt "NpcYell:18139:0:13"
msgid "Urrrgh!"
msgstr ""

#. ja: どうして<br>こんなことに…？
#. de: Was ist hier bloß ...?
#. fr: Qu'est-ce qui s'est passé ici, ja<nbsp>!?
msgctxt "NpcYell:18140:0:13"
msgid "What happened here?"
msgstr ""

#. ja: うわぁ！
#. de: Aaahh!?
#. fr: Aaah<nbsp>!
msgctxt "NpcYell:18141:0:13"
msgid "Aaah!"
msgstr ""

#. ja: グォォッ！
#. de: Goaargh!!
#. fr: Rhaaah<nbsp>!
msgctxt "NpcYell:18142:0:13"
msgid "Groaaar!"
msgstr ""

#. ja: ウゥ…
#. de: Uu...u ...
#. fr: Mmmoh...
msgctxt "NpcYell:18143:0:13"
msgid "Ugh..."
msgstr ""

#. ja: オォン…
#. de: Owaaargh ...
#. fr: Uuugh...
msgctxt "NpcYell:18144:0:13"
msgid "Unnngh..."
msgstr ""

#. ja: グシャァッ！
#. de: Gshak!!
#. fr: Groooh<nbsp>!
msgctxt "NpcYell:18145:0:13"
msgid "Grrruuugh!"
msgstr ""

#. ja: アァ…
#. de: Aa...a ...
#. fr: Aaagh<nbsp>!
msgctxt "NpcYell:18146:0:13"
msgid "Ahhhg..."
msgstr ""

#. ja: ガァッ！
#. de: Graaah!!
#. fr: Graaah<nbsp>!
msgctxt "NpcYell:18147:0:13"
msgid "Grah!"
msgstr ""

#. ja: 父さんは<br>ここで何を…？
#. de: Was hat mein Vater hier nur gemacht ...?
#. fr: Papa... Il faisait quoi ici<nbsp>?
msgctxt "NpcYell:18148:0:13"
msgid "What was Father doing here?"
msgstr ""

#. ja: あんな獣が<br>封印されてたの！？
#. de: So ein Ungeheuer war die ganze Zeit versiegelt?!
#. fr: Ce monstre... Il est resté enfermé tout ce temps, ja<nbsp>?
msgctxt "NpcYell:18149:0:13"
msgid "Has that thing been sealed away all this time!?"
msgstr ""

#. ja: ●正面を見て！！
#. de: 0
#. fr: 0
msgctxt "NpcYell:18150:0:13"
msgid "0"
msgstr ""

#. ja: こちらへ逃げていれば<br>いいんだが…
#. de: Hoffentlich rennen sie uns entgegen ...
#. fr: Si seulement ils pouvaient fuir dans la bonne direction...
msgctxt "NpcYell:18151:0:13"
msgid "It would be fortunate if they ran this way..."
msgstr ""

#. ja: みんな、無事かな…？
#. de: Ob wohl alle unversehrt sind<nbsp>...?
#. fr: J'espèrrre que tous les hhetso sont sains et saufs.
msgctxt "NpcYell:18152:0:13"
msgid "We must pray the hhetso are all right."
msgstr ""

#. ja: どこかで、怯えて<br>立ち止まってるかも…
#. de: Nur solange sich keines vor Angst nicht von der Stelle traut ...
#. fr: Certains sont peut-êtrrre tétanisés et incapables de bouger...
msgctxt "NpcYell:18153:0:13"
msgid "They may be too frightened to find us..."
msgstr ""

#. ja: 襲われていたら<br>マズいぞ…！
#. de: Wenn eines der Raubtiere sie erwischen sollte ...
#. fr: Pourvu que le dévoreurrr ne les attrape pas<nbsp>!
msgctxt "NpcYell:18154:0:13"
msgid "What if the tturuhhetso got to them!?"
msgstr ""

#. ja: あれは…！？
#. de: Sind das etwa ...
#. fr: Là-bas...<nbsp>!
msgctxt "NpcYell:18155:0:13"
msgid "I think I see..."
msgstr ""

#. ja: いたぞ！
#. de: Da vorne!
#. fr: Des rroneeks<nbsp>!
msgctxt "NpcYell:18156:0:13"
msgid "Yes!"
msgstr ""

#. ja: 無事だったんだな
#. de: Ihnen geht's gut.
#. fr: Ils n'ont pas l'air blessés.
msgctxt "NpcYell:18157:0:13"
msgid "No teeth marks..."
msgstr ""

#. ja: よかった…
#. de: Puh! Glück gehabt.
#. fr: Quel soulagement...
msgctxt "NpcYell:18158:0:13"
msgid "Thank goodness."
msgstr ""

#. ja: 怪我はないようだ
#. de: Sie scheinen unverletzt.
#. fr: Rien à signaler, tout va bien.
msgctxt "NpcYell:18159:0:13"
msgid "This one is unhurt."
msgstr ""

#. ja: よしよし…
#. de: Ja, fein! Ganz brav ...
#. fr: T'es un bon gros rroneeks, oh voui<nbsp>!
msgctxt "NpcYell:18160:0:13"
msgid "Who's a good rroneek?"
msgstr ""

#. ja: ほら<br>落ち着いて
#. de: Pshh<nbsp>... Ruhig, mein Großer ...
#. fr: Allez... Du calme, mon grand.
msgctxt "NpcYell:18161:0:13"
msgid "All is well..."
msgstr ""

#. ja: ボォー！
#. de: Mbuhh!
#. fr: Mwoooh<nbsp>!
msgctxt "NpcYell:18162:0:13"
msgid "\\<grunt>"
msgstr ""

#. ja: ボォォー！
#. de: Mbuuuhh!
#. fr: Mwooooooh<nbsp>!
msgctxt "NpcYell:18163:0:13"
msgid "\\<snuffle>"
msgstr ""

#. ja: 逃げるんだ！
#. de: Schnell weg mit euch!
#. fr: Vite<nbsp>! Parrrtons d'ici<nbsp>!
msgctxt "NpcYell:18164:0:13"
msgid "Run!"
msgstr ""

#. ja: 急げー！
#. de: Beeilung!
#. fr: Dépêchons<nbsp>!
msgctxt "NpcYell:18165:0:13"
msgid "Call the hunters!"
msgstr ""

#. ja: いましたよ！
#. de: Da sind noch welche!
#. fr: Des monstres<nbsp>!
msgctxt "NpcYell:18166:0:13"
msgid "There!"
msgstr ""

#. ja: 周囲の魔物まで凶暴に…！
#. de: Selbst die kleineren Bestien drehen durch ...!
#. fr: 0
msgctxt "NpcYell:18167:0:13"
msgid "0"
msgstr ""

#. ja: マジかよ！？
#. de: Ernsthaft?!
#. fr: Sérieux<nbsp>!?
msgctxt "NpcYell:18168:0:13"
msgid "Seriously!?"
msgstr ""

#. ja: ロネークを<br>護らなくては
#. de: Eilen wir ihnen zur Seite!
#. fr: Il faut protéger les rroneeks<nbsp>!
msgctxt "NpcYell:18169:0:13"
msgid "Aid the hhetso!"
msgstr ""

#. ja: ロネークが<br>ピンチだぞ！
#. de: Sie stecken in der Klemme!
#. fr: La pauvre bête, attention<nbsp>!
msgctxt "NpcYell:18170:0:13"
msgid "That rroneek is hurt!"
msgstr ""

#. ja: くっ…！
#. de: Mist ...!
#. fr: Urgh...<nbsp>!
msgctxt "NpcYell:18171:0:13"
msgid "Oof!"
msgstr ""

#. ja: まずいな…
#. de: Das sieht gar nicht gut aus ...
#. fr: Aïe, aïe...
msgctxt "NpcYell:18172:0:13"
msgid "Oh dear..."
msgstr ""

#. ja: 数が多すぎる…！
#. de: Es sind einfach zu viele ...!
#. fr: Y en a trop<nbsp>! D'où ils sortent<nbsp>!?
msgctxt "NpcYell:18173:0:13"
msgid "Where did they all come from!?"
msgstr ""

#. ja: これなら<br>どうです！？
#. de: In dem Fall<nbsp>... Nehmt das!!
#. fr: Goûtez donc à ma botte secrète<nbsp>!
msgctxt "NpcYell:18174:0:13"
msgid "How do you like that!? ...Ahem."
msgstr ""

#. ja: ボォー！
#. de: Mbuhh!
#. fr: Mwoh<nbsp>!
msgctxt "NpcYell:18175:0:13"
msgid "\\<bellow>"
msgstr ""

#. ja: ンボォ…
#. de: \<schnaub>
#. fr: Beuuuh...
msgctxt "NpcYell:18176:0:13"
msgid "\\<grunt>"
msgstr ""

#. ja: くそっ！<br>妨害する気か…！
#. de: Verdammt! Er lässt es nicht zu!
