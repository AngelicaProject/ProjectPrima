# NpcYell
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: とりゃー！
#. de: Nimm das!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:9000:0:13"
msgid "Hee hee!"
msgstr ""

#. ja: いけぇ！
#. de: Los!
#. fr: Vas-y<nbsp>!
msgctxt "NpcYell:9001:0:13"
msgid "Hmm..."
msgstr ""

#. ja: やれやれ～！
#. de: Oho!
#. fr: Déchiquette-le<nbsp>!
msgctxt "NpcYell:9002:0:13"
msgid "My, my..."
msgstr ""

#. ja: あっちいって！
#. de: Verschwindet!
#. fr: Pourquoi moi<nbsp>!?
msgctxt "NpcYell:9003:0:13"
msgid "Stop that!"
msgstr ""

#. ja: もう、何なのよ！
#. de: Was soll das?
#. fr: J'en ai ras le bol<nbsp>!
msgctxt "NpcYell:9004:0:13"
msgid "Honestly!"
msgstr ""

#. ja: ひぃ、お助け～！
#. de: Aaah! Zu Hilfe!
#. fr: À l'aide<nbsp>!
msgctxt "NpcYell:9005:0:13"
msgid "Save the herbs!"
msgstr ""

#. ja: やめてくれ～！
#. de: Bitte, verschont unsere krautigen Kräuter!
#. fr: M-mes herbes<nbsp>! Arrêtez<nbsp>!
msgctxt "NpcYell:9006:0:13"
msgid "Stop, stop!"
msgstr ""

#. ja: 不覚です…
#. de: Das könnte besser laufen.
#. fr: Nous ne sommes pas de taille...
msgctxt "NpcYell:9007:0:13"
msgid "Forgive me..."
msgstr ""

#. ja: はぁ…はぁ…
#. de: Ich bin ... außer Atem ...
#. fr: Haa... Haa...
msgctxt "NpcYell:9008:0:13"
msgid "\\<huff> \\<huff>"
msgstr ""

#. ja: やってくれるわね…！
#. de: Der wird uns Ärger machen.
#. fr: Il se défend...<nbsp>!
msgctxt "NpcYell:9009:0:13"
msgid "Damn you!"
msgstr ""

#. ja: くっ…
#. de: Verdammt ...
#. fr: Argh...
msgctxt "NpcYell:9010:0:13"
msgid "Ungh..."
msgstr ""

#. ja: これが、ランジート…
#. de: Das ist Ran'jit, der General von Eulmore.
#. fr: Voilà la force de leur grand général...
msgctxt "NpcYell:9011:0:13"
msgid "This is Ran'jit..."
msgstr ""

#. ja: グッ…！
#. de: Hng!
#. fr: Hgnn...
msgctxt "NpcYell:9012:0:13"
msgid "Argh!"
msgstr ""

#. ja: グォォォォン！
#. de: Ruaaaaar!
#. fr: Kshraaaaa<nbsp>!
msgctxt "NpcYell:9013:0:13"
msgid "Graaarghhh!"
msgstr ""

#. ja: シャァァッ！
#. de: Fsssssch!
#. fr: Ksssssss<nbsp>!
msgctxt "NpcYell:9014:0:13"
msgid "Hissssss!"
msgstr ""

#. ja: でいやっ！
#. de: Nimm das!
#. fr: Dans ta face<nbsp>!
msgctxt "NpcYell:9015:0:13"
msgid "Ha!"
msgstr ""

#. ja: 見たかっ！
#. de: Sieh her!
#. fr: Tu l'as sentie passer, hein<nbsp>!?
msgctxt "NpcYell:9016:0:13"
msgid "See that?"
msgstr ""

#. ja: がんばって！
#. de: Jaaa, meine Beschützerlein!
#. fr: Je suis de tout cœur avec vous<nbsp>!
msgctxt "NpcYell:9017:0:13"
msgid "Ouch! That looked painful!"
msgstr ""

#. ja: そのちょーし！
#. de: Baff! Bam! Haha!
#. fr: Je ne laisserai pas ces brigands gâcher ma journée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9018:0:13"
msgid "Those horrid bandits won't<br>spoil my day!"
msgstr ""

#. ja: ダーマル君！<br>頼りにしてるヨ！
#. de: Du schaffen das, Darmal!
#. fr: Darmal, je compte sur toi, oui<nbsp>!
msgctxt "NpcYell:9019:0:13"
msgid "You can do it, Darmal!"
msgstr ""

#. ja: ダーマル君！<br>もっと頑張るネ！
#. de: Ja, richtig so! Musst dich anstrengen!
#. fr: Darmal, tu peux mieux faire, tu le peux<nbsp>!
msgctxt "NpcYell:9020:0:13"
msgid "Yes, like that, but better!"
msgstr ""

#. ja: どりャ！
#. de: Der ist für dich!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:9021:0:13"
msgid "Take this!"
msgstr ""

#. ja: ぜやァ！
#. de: Und zack!
#. fr: Et ça aussi<nbsp>!
msgctxt "NpcYell:9022:0:13"
msgid "And this!"
msgstr ""

#. ja: よいしょォ！
#. de: Dich hack ich entzwei!
#. fr: Et voilà<nbsp>!
msgctxt "NpcYell:9023:0:13"
msgid "No match for me!"
msgstr ""

#. ja: まだまだァ！
#. de: Einen hab ich noch!
#. fr: J'ai pas encore fini<nbsp>!
msgctxt "NpcYell:9024:0:13"
msgid "I'm not done yet!"
msgstr ""

#. ja: ダーマル君、急ぐネ！<br>出発するヨ！
#. de: Komm, komm weiter, Darmal. Hier lang ...
#. fr: Viens, Darmal, viens<nbsp>! On y va, oui<nbsp>!
msgctxt "NpcYell:9025:0:13"
msgid "Come along, Darmal!"
msgstr ""

#. ja: ちょっと待ってくれ！
#. de: Warte, lauf doch nicht immer vor!
#. fr: Une minute<nbsp>! J'arrive<nbsp>!
msgctxt "NpcYell:9026:0:13"
msgid "Wait for me!"
msgstr ""

#. ja: まったく、忙しない<br>雇い主サマだぜ…！
#. de: Warum musst du es immer so eilig haben?
#. fr: Pourquoi on se presse comme ça<nbsp>?
msgctxt "NpcYell:9027:0:13"
msgid "What's the hurry, anyway?"
msgstr ""

#. ja: …で、今回は<br>どんな噂を追うつもりだ？
#. de: Und überhaupt. Wo gehen wir hin?
#. fr: Mais j'y pense... On va où, cette fois<nbsp>?
msgctxt "NpcYell:9028:0:13"
msgid "And come to think of it, where are we going?"
msgstr ""

#. ja: 「髭の塔」近くで<br>価値ある品、拾えるらしいネ！
#. de: Am Kratzbart gibt's Schatz, ja!
#. fr: À La Barbichette, oui<nbsp>! Il y a des choses de valeur là-bas, il y en a, il paraît<nbsp>!
msgctxt "NpcYell:9029:0:13"
msgid "There are shinies waiting for us near Twitch!"
msgstr ""

#. ja: なんでまた<br>あんな場所で…？
#. de: Warum schon wieder zum Kratzbart? Ich hasse den Turm!
#. fr: Vraiment<nbsp>!? Y a pas d'autres endroits<nbsp>?<nbsp>...
msgctxt "NpcYell:9030:0:13"
msgid "Bloody hells! Why there of all the places?"
msgstr ""

#. ja: 魔物、身を潜めるため<br>地面を掘ることあるネ！
#. de: Dort graben sich immer die Scherenmäuler ein!
#. fr: Les créatures creusent des trous pour se cacher, là-bas, oui<nbsp>!
msgctxt "NpcYell:9031:0:13"
msgid "Creatures burrow into the sand there!"
msgstr ""

#. ja: ふむ、掘り返された場所から<br>遺物でも出土したのか…？
#. de: Und die graben tolle Sachen aus. Ja, ich weiß!
#. fr: Hmm... Et donc elles déterrent des vieux objets par la même occasion<nbsp>?
msgctxt "NpcYell:9032:0:13"
msgid "Which would unearth buried treasure... Not a bad idea, I'll admit."
msgstr ""

#. ja: さあ、着いたネ！<br>価値ある品、探すヨ！
#. de: Hier, hier! Hier gibt's Schätze!
#. fr: On est arrivés, on y est<nbsp>!
msgctxt "NpcYell:9033:0:13"
msgid "This is the place!"
msgstr ""

#. ja: …ところで、その身を潜めた<br>魔物ってやつは、どうなった？
#. de: Du sagtest doch, hier seien Scherenmäuler. Ich sehe keine<nbsp>...
#. fr: Je vois aucune créature qui creuse des trous... Où sont-elles passées<nbsp>?
msgctxt "NpcYell:9034:0:13"
msgid "You mentioned burrowing creatures, but I don't see any..."
msgstr ""

#. ja: ま、まさか…<br>まだ地面の中に…？
#. de: Psssh! Nicht so laut! Du scheuchst noch die ...
#. fr: Attends un peu<nbsp>! Me dis pas qu'elles sont sous terre<nbsp>!
msgctxt "NpcYell:9035:0:13"
msgid "Hold on, do you think they're still under the sand?"
msgstr ""

#. ja: ヒエエェ！<br>お助けネ～！
#. de: Giaaaa! Mami!
#. fr: Hiii<nbsp>! Au secours, à l'aide<nbsp>!
msgctxt "NpcYell:9036:0:13"
msgid "Mummy! Save me!"
msgstr ""

#. ja: 言わんこっちゃない！
#. de: Ich WUSSTE es!
#. fr: J'avais un mauvais pres<shy>sen<shy>ti<shy>ment<nbsp>!
msgctxt "NpcYell:9037:0:13"
msgid "I bloody knew it!"
msgstr ""

#. ja: ラールラル、下がれ！<br>魔物の相手は俺がッ！
#. de: Rhal Ral, hinter mich, schnell!
#. fr: Rhal Ral, recule-toi<nbsp>! Je vais m'occuper de ces sales bêtes<nbsp>!
msgctxt "NpcYell:9038:0:13"
msgid "Get back, Rhal Ral! You'll only get in my way!"
msgstr ""

#. ja: クソッタレ！<br>こりゃ、手に負えんぞ！
#. de: Wir sind den verdammten Kakerlaken direkt in die Falle gelaufen!
#. fr: Merde<nbsp>! J'y arrive pas<nbsp>!
msgctxt "NpcYell:9039:0:13"
msgid "We've walked right into their trap!"
msgstr ""

#. ja: ダーマル君<br>頼りないネ～！
#. de: Darmal, das nichts bringen. Lass lieber verschwinden!
#. fr: Darmal sert à rien, non<nbsp>!
msgctxt "NpcYell:9040:0:13"
msgid "Darmal! It's no use!"
msgstr ""

#. ja: お前が迂闊すぎるんだよ！<br>ええい、退くぞ！
#. de: Alles deine Schuld, du kleiner Geier! Argh, es hat keinen Sinn, wir müssen weg!
#. fr: C'est de ta faute<nbsp>!<nbsp>... Bon, sauve qui peut<nbsp>!
msgctxt "NpcYell:9041:0:13"
msgid "This is all your fault! Grrr... No choice but to run!"
msgstr ""

#. ja: ふう…どうにか<br>あらかた片付いたようだな…
#. de: Hah, und habt ihr genug, ihr Sand fressenden Kakerlaken?!
#. fr: Ouf<nbsp>! Je crois qu'elles en ont eu assez<nbsp>!
msgctxt "NpcYell:9042:0:13"
msgid "Had enough, eh? You sand-swallowing bastards!"
msgstr ""

#. ja: よくやってくれたネ！<br>さっそく、価値ある品探すヨ！
#. de: Wir leben! Juhu! Aber wo ist Schatz?
#. fr: Bravo, Darmal<nbsp>! Maintenant, cherchons des trésors, cherchons-les<nbsp>!
msgctxt "NpcYell:9043:0:13"
msgid "We are alive! But more importantly, where is that treasure?"
msgstr ""

#. ja: うーん…<br>めぼしいもの無いネ…
#. de: Ah, ja. Hier suchen ...
#. fr: Voyons, voyons, oui...
msgctxt "NpcYell:9044:0:13"
msgid "Let me see..."
msgstr ""

#. ja: ムム…古い羊皮紙…！？<br>アンバーフィールドの地図ネ！
#. de: Uuuh! Schau her, Darmal. Das ist Karte mit Kreuz. Sieht aus wie Bernsteinfelder<nbsp>...
#. fr: Hmm... Un vieux parchemin<nbsp>?<nbsp>... C'est, c'est une carte, une carte de la plaine d'Ambre<nbsp>!
msgctxt "NpcYell:9045:0:13"
msgid "Hmm? A map! It looks like the Fields of Amber."
msgstr ""

#. ja: 見てみるネ！<br>南の方にサボテンの印！
#. de: Und Zeichnung von große Kaktor.
#. fr: Il y a un dessin de cactus au sud, oui<nbsp>!
msgctxt "NpcYell:9046:0:13"
msgid "There is a picture of a gigantender to the south..."
msgstr ""

#. ja: その隣には首飾りの絵か…<br>どういうことだ？
#. de: Hmm. Aber was ist das? Ein Amulett?
#. fr: Oui, et à côté, on dirait celui d'un collier... Qu'est-ce que ça veut dire<nbsp>?
msgctxt "NpcYell:9047:0:13"
msgid "...And what looks like a necklace nearby."
msgstr ""

#. ja: 決まってるネ！<br>お宝の在り処示す地図ヨ！
#. de: Ja, das ist es! Ein Schatz! Los, los. Müssen Schatz suchen!
#. fr: Qu'on doit aller vérifier ça, oui<nbsp>!
msgctxt "NpcYell:9048:0:13"
msgid "Then what are we waiting for?"
msgstr ""

#. ja: きっと大きなサボテンの近く<br>宝飾品が埋まってるはずネ！
#. de: Schatz ist bei großen Kaktor! Bestimmt!
#. fr: Il doit y avoir un trésor enterré près de là où il y a un grand cactus, il y a un trésor<nbsp>!
msgctxt "NpcYell:9049:0:13"
msgid "The treasure must be where gigantenders roam!"
msgstr ""

#. ja: さっそく探しに行くヨ！
#. de: Hier lang, Darmal. Beeilung!
#. fr: Allons-y vite, oui<nbsp>!
msgctxt "NpcYell:9050:0:13"
msgid "This way, Darmal!"
msgstr ""

#. ja: やれやれ<br>忙しい雇い主サマだぜ…
#. de: \<seufz> Kann ich mich nicht wenigstens EINEN MOMENT ausruhen?
#. fr: Et moi qui pensais avoir un peu de temps pour souffler...
msgctxt "NpcYell:9051:0:13"
msgid "What I wouldn't give for a moment's peace..."
msgstr ""

#. ja: そろそろ地図が示す<br>場所のはずネ…
#. de: Keine Zeit! Sind fast da!
#. fr: On y est presque, oui...
msgctxt "NpcYell:9052:0:13"
msgid "We are almost there."
msgstr ""

#. ja: チッ…リザードの群れか<br>探索の邪魔になるな…
#. de: Eidechsen. Genau das, was ich jetzt noch brauche ...
#. fr: Ouah<nbsp>! C'est plein de lézards, ici<nbsp>! Ils vont nous gêner...
msgctxt "NpcYell:9053:0:13"
msgid "Lizards. That's all we bloody need."
msgstr ""

#. ja: あの群れに突っ込むような<br>バカはしてくれるなよ？
#. de: Mit denen lege ich mich jetzt nicht an.
#. fr: Mieux vaut éviter de leur rentrer dans le tas, à mon avis.
msgctxt "NpcYell:9054:0:13"
msgid "We'd do well to steer clear of that lot."
msgstr ""

#. ja: わかってるネ！<br>ボク、慎重派で有名ヨ！
#. de: Ja, Rhal Ral geht kein Risiko ein. Nein, nein.
#. fr: Bien sûr, oui<nbsp>! J'aime pas prendre de risques, moi<nbsp>!
msgctxt "NpcYell:9055:0:13"
msgid "Of course! You know I am not one to take risks!"
msgstr ""

#. ja: …………
#. de: Stimmt, dafür bin ich ja immer zuständig ...
#. fr: Euh...
msgctxt "NpcYell:9056:0:13"
msgid "No, but I usually end up taking them in your place."
msgstr ""

#. ja: 困ったネ…<br>でも、諦めたくないヨ…
#. de: Darmal. Das nicht gut aussehen. Jetzt nicht aufgeben, ja?
#. fr: C'est embêtant, mais on va trouver une solution, on va en trouver une<nbsp>!
msgctxt "NpcYell:9057:0:13"
msgid "Oh, this is not good... But we must not give up!"
msgstr ""

#. ja: さすがに俺ひとりの<br>手には余るぞ…
#. de: Das sind einfach zu viele!
#. fr: Ouais, mais y en a trop... Je peux pas y arriver tout seul...
msgctxt "NpcYell:9058:0:13"
msgid "Ungh... There's too many!"
msgstr ""

#. ja: 助力があれば<br>リザードなんて…！
#. de: Rhal Ral! Wie wär's mit ein wenig Hilfe zur Abwechlung?!
#. fr: Rhal Ral, tu veux pas me donner un coup de main, hein<nbsp>?
msgctxt "NpcYell:9059:0:13"
msgid "Rhal Ral! Fancy lending a hand?"
msgstr ""

#. ja: みんな～！<br>頑張るネ！
#. de: Rhal Ral hilft, Rhal Ral betet!
#. fr: Oui, oui, j'arrive<nbsp>!
msgctxt "NpcYell:9060:0:13"
msgid "Help is here!"
msgstr ""

#. ja: や、やはり数が多すぎる…
#. de: Dein Beten hilft mir nicht. Es sind einfach zu viele!
#. fr: Non, mais y en a vraiment trop...
msgctxt "NpcYell:9061:0:13"
msgid "Too little, too late..."
msgstr ""

#. ja: ダーマル君！<br>不甲斐ないネ！
#. de: Darmal, machst du schon schlapp?
#. fr: Darmal, qu'est-ce que tu fabriques<nbsp>?
msgctxt "NpcYell:9062:0:13"
msgid "Darmal! What are you doing!?"
msgstr ""

#. ja: 命あっての物種ってね！
#. de: Vergiss den Schatz! Lieber lebendig statt reich!
#. fr: Ben, je préfère garder la vie sauve que de mourir riche<nbsp>!
msgctxt "NpcYell:9063:0:13"
msgid "Bugger the treasure! I'd rather be poor than dead!"
msgstr ""

#. ja: あ、待ってネ～！<br>ボクも逃げるヨ～！
#. de: Heee, warte! Lass Rhal Ral nicht allein!
#. fr: Attends<nbsp>! Me laisse pas seul, me laisse pas, non<nbsp>!
msgctxt "NpcYell:9064:0:13"
msgid "Do not leave me!"
msgstr ""

#. ja: 旅人よ、助力に感謝する！<br>おかげで安全を確保できた！
#. de: Deine Hilfe war von unschätzbarem Wert. Ohne dich wäre hier unser kleines Abenteuer zu Ende. Danke!
#. fr: Merci à toi<nbsp>! Tu nous as sacrément bien aidés<nbsp>!
msgctxt "NpcYell:9065:0:13"
msgid "Thanks, mate. We'd be lizard food if it weren't for you."
msgstr ""

#. ja: さっそく宝探しネ！<br>大きいサボテン、大きいサボテン！
#. de: Ja, ja! Schon gut! Keine Zeit. Müssen Amulett finden! Auf zu Kaktor!
#. fr: Bon, cherchons le trésor, cherchons-le<nbsp>! Le grand cactus... Hmm... Où il est<nbsp>?
msgctxt "NpcYell:9066:0:13"
msgid "Yes, yes! There will be time for that later! On with the treasure hunt!"
msgstr ""

#. ja: …見当たらんな
#. de: Ich sehe nichts ...
#. fr: Je le vois nulle part...
msgctxt "NpcYell:9067:0:13"
msgid "I don't see anything, though."
msgstr ""

#. ja: それは浅はかネ！<br>ダーマル君、見るがいいヨ！
#. de: Nicht hier, nein! Aber schaust du da drüben!
#. fr: Oh, regarde ça, oui<nbsp>!
msgctxt "NpcYell:9068:0:13"
msgid "Maybe not the shinies, but look over there!"
msgstr ""

#. ja: これは足跡か？<br>形状、歩幅からすると…
#. de: Fußspuren. Der Größe und dem Schrittabstand nach zu urteilen ein Riesenkaktor ...
#. fr: Des traces de pas<nbsp>? D'après leur forme et leur espacement...
msgctxt "NpcYell:9069:0:13"
msgid "Footprints... Judging by the shape and stride length..."
msgstr ""

#. ja: ギガテンダーの足跡ネ！<br>しかも、新しいヨ！
#. de: Genau! Unser Riesenkaktor. Und frisch!
#. fr: C'est un gigapampa, oui<nbsp>! Et il est pas loin, pas loin du tout<nbsp>!
msgctxt "NpcYell:9070:0:13"
msgid "A gigantender, yes? Fresh, too!"
msgstr ""

#. ja: この痕跡の大きさ…<br>樹齢200年超えだぞ？
#. de: Die Abdrücke sind gewaltig. Der muss mindestens 200 Jahre alt sein!
#. fr: Ouais, il doit être vieux aussi... d'au moins deux cents ans, je dirais.
msgctxt "NpcYell:9071:0:13"
msgid "It must be over two hundred years old!"
msgstr ""

#. ja: きっと地図が書かれた頃<br>休眠期だったのネ！
#. de: Als Karte gemacht wurde, hat Riesenkaktor noch geschlafen. Diente zur Orientierung!
#. fr: Il devait être endormi lorsque la carte a été dessinée, oui<nbsp>!
msgctxt "NpcYell:9072:0:13"
msgid "If it was dormant when this map was made, they could have used it as a landmark!"
msgstr ""

#. ja: 普通のサボテンだと思い<br>宝の隠し場所の目印にしたと？
#. de: Kaktoren verlassen nur selten ihr Territorium ...
#. fr: Les gigapampas s'éloignent rarement de leur territoire, en général.
msgctxt "NpcYell:9073:0:13"
msgid "They normally don't wander far from their territory..."
msgstr ""

#. ja: だとすればお宝も<br>巨大なギガテンダーが…
#. de: Diese Fußspuren führen uns wahrscheinlich direkt zum Amulett.
#. fr: Donc, si on suit ces traces de pas, on devrait pouvoir trouver l'emplacement du trésor.
msgctxt "NpcYell:9074:0:13"
msgid "...So these tracks will probably lead to that necklace."
msgstr ""

#. ja: …って、どう見ても<br>あいつだよな…
#. de: Und ... äh ... Ich glaube, wir haben ihn gefunden ...
#. fr: Ah, je crois qu'on a trouvé notre gigapampa...
msgctxt "NpcYell:9075:0:13"
msgid "Ah. I think we've found our gigantender."
msgstr ""

#. ja: あいつに間違いないネ！
#. de: Ja, ja! Das ist er!
#. fr: Oui, c'est bien lui<nbsp>!
msgctxt "NpcYell:9076:0:13"
msgid "No doubt about it!"
msgstr ""

#. ja: よし、あいつを倒して<br>お宝を手に入れるぞ！
#. de: Ich pack schon mal die Axt aus<nbsp>...
#. fr: Bon, ben, il reste plus qu'à lui régler son compte et à chercher notre trésor<nbsp>!
msgctxt "NpcYell:9077:0:13"
msgid "We'll have to cut that thing down to size before we can start the search."
msgstr ""

#. ja: ダーマル君！<br>気合入れるネ！
#. de: Ja, Darmal. Mach Riesenkaktor klein!
#. fr: Darmal, tu m'épates, oui<nbsp>!
msgctxt "NpcYell:9078:0:13"
msgid "Show it what you are made of, Darmal!"
msgstr ""

#. ja: お宝を目の前にして…！<br>だが、これ以上は危険か！
#. de: So nah am Ziel und doch so fern! Verdammt!
#. fr: Argh<nbsp>! Et dire que le trésor est à portée de main... Mais c'est trop dangereux<nbsp>!
msgctxt "NpcYell:9079:0:13"
msgid "Argh! I can't give up, not when we're so close!"
msgstr ""

#. ja: 悔しいネ…！
#. de: Uh, schnell weg!
#. fr: Mieux vaut s'enfuir et réessayer un autre jour, oui<nbsp>!
msgctxt "NpcYell:9080:0:13"
msgid "Better to run and scavenge another day!"
msgstr ""

#. ja: よし倒したぞ！
#. de: Haha! Jetzt sind wir gar nicht mehr so groß, was?!
#. fr: Et voilà<nbsp>! Un gigapampa en moins<nbsp>!
msgctxt "NpcYell:9081:0:13"
msgid "How do you like that, you overgrown cactus!"
msgstr ""

#. ja: 見るネ！<br>宝箱発見ヨ！
#. de: Wir haben es gefunden! Der Schatz ist unser!
#. fr: Regarde, Darmal, regarde<nbsp>! J'ai trouvé le trésor, oui<nbsp>!
msgctxt "NpcYell:9082:0:13"
msgid "We have found it! The treasure!"
msgstr ""

#. ja: 予想通りの展開だな！<br>よし…開けるぞ！
#. de: Schau, eine Kiste, Rhal Ral!
#. fr: Parfait<nbsp>! Voyons ce qu'il y a dedans<nbsp>!
msgctxt "NpcYell:9083:0:13"
msgid "What do we have here?"
msgstr ""

#. ja: おおおおっ！？<br>この輝き…凄いネ！
#. de: Sooo ... glänzig ...
#. fr: Ooooh<nbsp>! C'est si brillant, c'est étincelant<nbsp>!
msgctxt "NpcYell:9084:0:13"
msgid "So shiny!"
msgstr ""

#. ja: ムッ…この気配…！？
#. de: Dieser Schatten ...
#. fr: Hmm<nbsp>? J'ai comme un mauvais pres<shy>sen<shy>ti<shy>ment...
msgctxt "NpcYell:9085:0:13"
msgid "Wait... What's that!?"
msgstr ""

#. ja: うわわっ！？
#. de: Aaah!
#. fr: Ouaaaah<nbsp>!
msgctxt "NpcYell:9086:0:13"
msgid "Eeek!"
msgstr ""

#. ja: ぬおーん！<br>首飾り、盗られたネ！
#. de: Das Amulett! Gestohlen aus meinen Händen!
#. fr: Le collier<nbsp>! On nous l'a volé, oui<nbsp>!
msgctxt "NpcYell:9087:0:13"
msgid "The necklace! Snatched away from us!"
msgstr ""

#. ja: 光り物狙いの怪鳥<br>オフスカワーズマンか！
#. de: Der Wüstenschatten! Das Glitzern des Amuletts muss ihn angelockt haben!
#. fr: C'est cet oiseau de malheur qui chipe tout ce qui brille<nbsp>! Le Récureur<nbsp>!
msgctxt "NpcYell:9088:0:13"
msgid "That was Offscoursman! The sparkling must've caught its eye!"
msgstr ""

#. ja: 横取り、許せないネ！<br>追いかけるヨ！
#. de: Schnell! Große Vogel darf nicht entkommen!
#. fr: Vite<nbsp>! Il faut le rattraper, il le faut<nbsp>!
msgctxt "NpcYell:9089:0:13"
msgid "Quickly, before it escapes us!"
msgstr ""

#. ja: ここまで来て<br>諦められんからな…！
#. de: So kurz vom Ziel geb ich gewiss nicht auf!
#. fr: T'as raison<nbsp>! On va pas le laisser nous voler notre trésor<nbsp>!
msgctxt "NpcYell:9090:0:13"
msgid "For once, we're of the same mind, Rhal Ral!"
msgstr ""

#. ja: うーん、泥棒鳥…<br>この辺りにいるはずヨ…？
#. de: Große Vogel ist in die Richtung geflogen, ja?
#. fr: Il est parti dans cette direction, je crois...
msgctxt "NpcYell:9091:0:13"
msgid "It flew in this direction, yes?"
msgstr ""

#. ja: 見つけたネ！
#. de: Da ist er! Da!
#. fr: Je l'ai trouvé, oui<nbsp>!
msgctxt "NpcYell:9092:0:13"
msgid "Found it!"
msgstr ""

#. ja: あとは、上手いこと<br>ヤツを倒すだけか…
#. de: Heut gibt's Hühnerkeulen, Rhal Ral!
#. fr: Bon, il reste plus qu'à donner une bonne leçon à ce volatile voleur<nbsp>!
msgctxt "NpcYell:9093:0:13"
msgid "Now all we have to do is kill it... Easier said than done."
msgstr ""

#. ja: ここまで手強いとは…！<br>退いて立て直すぞ！
#. de: Der Gockel ist zäher als gedacht!
#. fr: Argh<nbsp>! Il est plus coriace que je le pensais<nbsp>!
msgctxt "NpcYell:9094:0:13"
msgid "It's no good! Fall back!"
msgstr ""

#. ja: 悔しいヨ…！<br>でも、命は惜しいネ…！
#. de: Vergiss Hühnerkeulen, Darmal. Weg hiiier!
#. fr: Grrr<nbsp>! Je déteste cet oiseau encore plus... mais je veux pas mourir ici, non<nbsp>!
msgctxt "NpcYell:9095:0:13"
msgid "It's too strong, Darmal!"
msgstr ""

#. ja: やった…お宝を…<br>首飾りを取り戻したぞ！
#. de: Haha! Das Amulett ist wieder da, wo es hingehört! In unseren Händen!
#. fr: Et voilà<nbsp>! Le collier est de nouveau à nous<nbsp>!
msgctxt "NpcYell:9096:0:13"
msgid "Ha ha! The necklace is ours!"
msgstr ""

#. ja: ダーマル君、旅人サン！<br>素晴らしいネ！
#. de: Gute Arbeit! Es nicht dein Schaden soll sein. Alles für die ... äh ... Archäologie!
#. fr: Bravo, oui<nbsp>! Vous vous êtes bien battus<nbsp>!
msgctxt "NpcYell:9097:0:13"
msgid "Excellent work!"
msgstr ""

#. ja: ちょっと見せるネ…！
#. de: Gut, gut. Rhal Ral schaut sich mal Amulett an.
#. fr: Montre-moi le collier, montre-le-moi<nbsp>!
msgctxt "NpcYell:9098:0:13"
msgid "Now, let us take a closer look..."
msgstr ""

#. ja: 5枚の金貨の意匠…<br>ナバース家の紋章ヨ！
#. de: Hm. Ja. Fünf Münzen von Nabaath. Siegel der königlichen Familie!
#. fr: Oh, ce symbole fait de cinq pièces, c'est celui des Nabaath<nbsp>!
msgctxt "NpcYell:9099:0:13"
msgid "Ah, yes. The mark of five coins. This was made for the Nabaath royal family!"
msgstr ""

#. ja: ナバスアレン王家秘蔵の<br>お宝ってことか！
#. de: Das klingt wertvoll!
#. fr: Tu veux dire que c'est un trésor de la famille royale de Nabaath Areng<nbsp>!?
msgctxt "NpcYell:9100:0:13"
msgid "So it must be worth a fair bit, then?"
msgstr ""

#. ja: いくらで売れるか…<br>楽しみで仕方ないネ！
#. de: Ja. Rhal Ral kennt jemand, der Wert schätzen wird!
#. fr: Oui, oui<nbsp>! J'ai hâte de savoir combien de gils on va en tirer<nbsp>!
msgctxt "NpcYell:9101:0:13"
msgid "Yes! I cannot wait to have it properly appraised!"
msgstr ""

#. ja: 一刻も早く<br>モルド・スークに帰るネ！
#. de: Wir müssen zurück nach Mordh Souq!
#. fr: Dépêchons-nous de rentrer à Mord Souq, dépêchons-nous<nbsp>!
msgctxt "NpcYell:9102:0:13"
msgid "Let us make our way to Mord Souq!"
msgstr ""

#. ja: よしきた！
#. de: Ich könnte eine Pause vertragen. Und ein kühles Bier in der Schenke ...
#. fr: Je suis tout à fait d'accord<nbsp>!
msgctxt "NpcYell:9103:0:13"
msgid "No arguments here!"
msgstr ""

#. ja: 今回の冒険は大成功ネ…！<br>次は…「丘」の方に…
#. de: Expedition war voller Erfolg! Jetzt müssen wir weiter zu Hügeln ...
#. fr: Notre excursion a été un grand succès, oui<nbsp>! Maintenant, on va aller du côté des collines<nbsp>!
msgctxt "NpcYell:9104:0:13"
msgid "Our venture was a great success. Now to head to the hills!"
msgstr ""

#. ja: 何してる！？<br>帰るんじゃないのか？
#. de: Was? Ich dachte, wir kehren nach Mordh Souq zurück?!
#. fr: Euh... Tu as pas parlé de rentrer<nbsp>?
msgctxt "NpcYell:9105:0:13"
msgid "What!? I thought we were going home!"
msgstr ""

#. ja: ちょっと待つネ～！
#. de: Ja, ja ... Bald schon. Bald! Aber erst kleiner Umweg.
#. fr: Si, mais on va faire un tout petit détour, oui<nbsp>!
msgctxt "NpcYell:9106:0:13"
msgid "And we will, after a quick detour!"
msgstr ""

#. ja: ついに来たネ…<br>アンバーヒル！
#. de: Wir sind da! Die Bernsteinhügel ...
#. fr: Nous y voilà, oui<nbsp>! Les collines d'Ambre<nbsp>!
msgctxt "NpcYell:9107:0:13"
msgid "Here we are! The Hills of Amber!"
msgstr ""

#. ja: で、雇い主サマよ…<br>今回の狙いは？
#. de: Und ... Was genau machen wir hier?
#. fr: Ouais, et qu'est-ce qu'on est venus faire ici, au juste<nbsp>?
msgctxt "NpcYell:9108:0:13"
msgid "Erm... And what are we doing here?"
msgstr ""

#. ja: いいネタ仕入れてるネ！<br>期待すると良いヨ！
#. de: Du wirst gleich sehen. Ja!
#. fr: Un peu de patience, oui<nbsp>! Je vais te le dire bientôt, très bientôt<nbsp>!
msgctxt "NpcYell:9109:0:13"
msgid "All will be revealed soon!"
msgstr ""

#. ja: さて、どうだかな…
#. de: Sag's mir doch einfach!
#. fr: Je raffole pas trop des surprises, tu sais...
msgctxt "NpcYell:9110:0:13"
msgid "I'd rather you just told me..."
msgstr ""

#. ja: だ、誰か、いないか…！<br>助けてくれ～！
#. de: Zu Hilfe!
#. fr: À l'aide<nbsp>! Au secours<nbsp>!
msgctxt "NpcYell:9111:0:13"
msgid "Somebody, help me!"
msgstr ""

#. ja: ゲハハハハ！<br>助けなんてくるものかよ！
#. de: Hahaha! Hier hört dich keiner!
#. fr: Hahaha<nbsp>! Tu peux toujours rêver<nbsp>!
msgctxt "NpcYell:9112:0:13"
msgid "Ha ha ha! Good luck with that!"
msgstr ""

#. ja: そう都合よく<br>誰か通り掛かるもんか！
#. de: Deine Schreie werden von der Wüste verschluckt, wie auch bald schon deine Knochen!
#. fr: Y a personne pour te sauver par ici<nbsp>!
msgctxt "NpcYell:9113:0:13"
msgid "In the desert, no one can hear you die!"
msgstr ""

#. ja: あ…
#. de: Müssen helfen!
#. fr: Ah<nbsp>!?
msgctxt "NpcYell:9114:0:13"
msgid "We have to save him!"
msgstr ""

#. ja: あ…
#. de: Nicht schon wieder ...
#. fr: Oh<nbsp>!?
msgctxt "NpcYell:9115:0:13"
msgid "Do we?"
msgstr ""

#. ja: あ…
#. de: Ihr habt euch einen schlechten Zeitpunkt ausgesucht.
#. fr: Hein<nbsp>!?
msgctxt "NpcYell:9116:0:13"
msgid "You're in the wrong place, at the wrong time."
msgstr ""

#. ja: あ…
#. de: Einen seeehr schlechten ...
#. fr: Merde<nbsp>!
msgctxt "NpcYell:9117:0:13"
msgid "Blame your own bad luck, mate."
msgstr ""

#. ja: た、助けてくれ～！<br>こいつら強盗なんだ～！
#. de: B-Bitte helft mir! Diese Banditen ...
#. fr: À l'aide<nbsp>! Ces hommes sont des brigands<nbsp>!
msgctxt "NpcYell:9118:0:13"
msgid "Help, I say! These men are bandits!"
msgstr ""

#. ja: 無視するワケにもいかんか…<br>ラールラル、下がってろ…
#. de: Keine Sorge, dem Abschaum rasier ich den Hals mit meiner Axt!
#. fr: Pas question d'ignorer cet appel à l'aide<nbsp>! Rhal Ral, recule-toi<nbsp>!
msgctxt "NpcYell:9119:0:13"
msgid "All right, don't get your breeches in a twist. You stay back, Rhal Ral."
msgstr ""

#. ja: 仕方ないネ…<br>ダーマル君、頑張るネ！
#. de: Sei vorsichtig, Darmal!
#. fr: Fais bien attention, Darmal<nbsp>!
msgctxt "NpcYell:9120:0:13"
msgid "Be careful, Darmal!"
msgstr ""

#. ja: なんだテメェは！？
#. de: Willst den Helden spielen, was?
#. fr: Tu te prends pour qui, toi<nbsp>!?
msgctxt "NpcYell:9121:0:13"
msgid "Think you're a hero, do you?"
msgstr ""

#. ja: 邪魔すんじゃねぇ！
#. de: Halt dich da raus!
#. fr: Tu ferais mieux de déguerpir avant qu'il soit trop tard<nbsp>!
msgctxt "NpcYell:9122:0:13"
msgid "Keep out of this, old man!"
msgstr ""

#. ja: ひ、ひぃ～！
#. de: \<wimmer>
#. fr: Hiiii<nbsp>!
msgctxt "NpcYell:9123:0:13"
msgid "Don't come any closer!"
msgstr ""

#. ja: よし、ズラかるぞ！
#. de: Das hätten wir. Zeit zu verschwinden, Mädels!
#. fr: Et voilà le travail<nbsp>! On a assez traîné ici<nbsp>!
msgctxt "NpcYell:9124:0:13"
msgid "Job's done. Time to scarper, lads!"
msgstr ""

#. ja: ザマぁ見やがれ！
#. de: Kein schlechter Fang!
#. fr: Bien fait pour eux<nbsp>!
msgctxt "NpcYell:9125:0:13"
msgid "Not a bad haul!"
msgstr ""

#. ja: ち、力及ばず…<br>すまん…
#. de: Tut mir leid ...
#. fr: Je suis désolé...
msgctxt "NpcYell:9126:0:13"
msgid "I'm sorry..."
msgstr ""

#. ja: 丘は怖いところネ…！<br>ボク、モルド・スークに帰るヨ！
#. de: Besser wir gehen zurück nach Mordh Souq ...
#. fr: Ces collines sont vraiment dangereuses, oui<nbsp>! Je ferais mieux de rentrer à Mord Souq<nbsp>!
msgctxt "NpcYell:9127:0:13"
msgid "On second thought, let us forget the detour! Back to Mord Souq it is!"
msgstr ""

#. ja: お、覚えてやがれー！
#. de: Dein Gesicht merken wir uns!
#. fr: On se reverra<nbsp>!
msgctxt "NpcYell:9128:0:13"
msgid "You haven't seen the last of us!"
msgstr ""

#. ja: に、逃げろ～！
#. de: Weg hier!
#. fr: Allez, on se tire<nbsp>!
msgctxt "NpcYell:9129:0:13"
msgid "Bugger this!"
msgstr ""

#. ja: オラオラ！
#. de: Stirb endlich!
#. fr: Tu vas voir ce que tu vas te prendre, toi<nbsp>!
msgctxt "NpcYell:9130:0:13"
msgid "Hold still and die!"
msgstr ""

#. ja: この野郎！
#. de: Du gehst mir langsam auf die Nerven!
#. fr: Tu veux mourir, c'est ça<nbsp>!?
msgctxt "NpcYell:9131:0:13"
msgid "Got some fight in you, eh?"
msgstr ""

#. ja: 食らえ！
#. de: Jetzt bist du dran!
#. fr: Je vais te saigner<nbsp>!
msgctxt "NpcYell:9132:0:13"
msgid "Let's see how you like this!"
msgstr ""

#. ja: 強盗どもめ…<br>ようやく諦めたか…
#. de: Fiese Halunken! Denen haben wir es gezeigt, ja!
#. fr: Bon débarras<nbsp>!
msgctxt "NpcYell:9133:0:13"
msgid "Good riddance!"
msgstr ""

#. ja: 助かったよ、ありがとう…<br>オイラは石掘りのインギだ
#. de: Ich danke euch Fremde! Mein Name ist Ingi. Ich bin Geologe auf der Suche nach Edelsteinen.
#. fr: Merci infiniment, étrangers<nbsp>! Je m'appelle Ingi et je suis venu ici en quête de gemmes.
msgctxt "NpcYell:9134:0:13"
msgid "Thank you, strangers. My name is Ingi, and I came here to find gemstones."
msgstr ""

#. ja: ボクはラールラル<br>こっちは護衛のダーマル、ヨ！
#. de: Ich Rhal Ral und Mann mit Axt ist mein Partner Darmal.
#. fr: Moi, c'est Rhal Ral, oui<nbsp>! Et lui, c'est mon garde du corps, Darmal, il me protège<nbsp>!
msgctxt "NpcYell:9135:0:13"
msgid "I am Rhal Ral, and this is my associate, Darmal."
msgstr ""

#. ja: ボクら宝探しに来たネ！
#. de: Wir sind Glücksritter auf Suche nach Schatz!
#. fr: On cherche un trésor, oui<nbsp>!
msgctxt "NpcYell:9136:0:13"
msgid "We are in search of treasure!"
msgstr ""

#. ja: 宝探しだって？<br>こんな場所に！？
#. de: Schätze? Hier?
#. fr: Un trésor<nbsp>? Dans un endroit comme celui-ci<nbsp>?
msgctxt "NpcYell:9137:0:13"
msgid "In a place like this?"
msgstr ""

#. ja: そうネ、古物商から<br>古いロンゾの巻物、買ったネ！
#. de: Ja! Habe alte Ronso-Schriftrolle erhandelt ...
#. fr: Oui<nbsp>! J'ai acheté un vieux parchemin ronso à un antiquaire, j'en ai acheté un<nbsp>!
msgctxt "NpcYell:9138:0:13"
msgid "Yes! I bought an old Ronso scroll..."
msgstr ""

#. ja: そこに記されてたお宝…<br>「大老の剣」見つけたいヨ！
#. de: Zeigt Klinge der Ahnen!
#. fr: Ça parle d'un trésor appelé l'épée de l'ancien<nbsp>! Je veux la trouver, oui<nbsp>!
msgctxt "NpcYell:9139:0:13"
msgid "...which revealed the location of the Elderblade!"
msgstr ""

#. ja: だから、ロンゾゆかりの<br>アンバーヒルに来たのか…
#. de: Das Schwert soll in den Bernsteinhügeln verborgen sein. Vielleicht hast du davon gehört?
#. fr: C'est donc pour ça qu'on est venus aux collines d'Ambre<nbsp>?<nbsp>...
msgctxt "NpcYell:9140:0:13"
msgid "It's in the Hills of Amber, the traditional home of the Ronso. Do you know anything about it?"
msgstr ""

#. ja: 剣の名は聞いたことないが<br>ふむ、「大老」か…
#. de: Nein, noch nie gehört. Aber das Wort „Ahnen“ ...
#. fr: J'ai jamais entendu parler de cette épée, mais “l'ancien”, ça me dit quelque chose...
msgctxt "NpcYell:9141:0:13"
msgid "I can't say I recognize the name, but the “Elder” part is familiar..."
msgstr ""

#. ja: 何か知ってるネ？
#. de: Wenn du etwas weißt, dann musst du sagen!
#. fr: Oh, tu sais quelque chose, tu le sais<nbsp>?
msgctxt "NpcYell:9142:0:13"
msgid "Please, if you know something, you must tell us!"
msgstr ""

#. ja: 少し心当たりがある<br>恩返しも兼ねて協力しよう
#. de: Nun, schätze, es ist das Geringste, was ich tun kann, nachdem ihr mein Leben gerettet habt.
#. fr: Si ça peut me permettre de payer ma dette envers vous, je veux bien vous aider.
msgctxt "NpcYell:9143:0:13"
msgid "Well, I am not sure it will be sufficient payment for saving my life, but I will do what I can."
msgstr ""

#. ja: だが、村に寄らせてくれ<br>身支度を整えたいのでな
#. de: Würdet ihr mir zu meinem Dorf folgen? Ich habe eine Vermutung, muss mich aber erst vergewissern ...
#. fr: Mais avant ça, il faudrait que je rentre à mon village pour mieux me préparer. Ça vous dérange pas<nbsp>?
msgctxt "NpcYell:9144:0:13"
msgid "But do you mind if I stop by my house first?"
msgstr ""

#. ja: 地元の…しかもロンゾの<br>協力者とはありがたい！
#. de: Aber sicher doch. Jede Hilfe ist willkommen.
#. fr: Bien sûr que non, l'ami<nbsp>!
msgctxt "NpcYell:9145:0:13"
msgid "Of course not!"
msgstr ""

#. ja: 命を救われたんだ<br>これくらいはせんとな…
#. de: Ich stehe in eurer Schuld.
#. fr: Vous inquiétez pas, je serai pas long.
msgctxt "NpcYell:9146:0:13"
msgid "I shan't keep you waiting long."
msgstr ""

#. ja: 嬉しいネ！<br>助かるネ！
#. de: Bitte, führe uns zu deinem Dorf, Freund ...
#. fr: Quelle chance d'être tombé sur toi, oui<nbsp>!
msgctxt "NpcYell:9147:0:13"
msgid "By all means, lead the way!"
msgstr ""

#. ja: ここがトゥワイン…<br>オイラが暮らす村さ
#. de: Es war nie besser, Zuhause zu sein ...
#. fr: Voici Queues-liées, mon village<nbsp>!
msgctxt "NpcYell:9148:0:13"
msgid "It is good to be home, safe and sound."
msgstr ""

#. ja: 身支度を整えてくる<br>少し待っていてくれ
#. de: Also gut, einen Moment. Ich bin gleich wieder da.
#. fr: Je vais me préparer. Donnez-moi juste un instant.
msgctxt "NpcYell:9149:0:13"
msgid "I will be with you in a few moments."
msgstr ""

#. ja: では、俺たちは<br>村の外で待つとしよう
#. de: Lass dir Zeit. Ich kann eine Pause vertragen. Habe das Gefühl, ich hetze schon seit Tagen durch die Wüste!
#. fr: Prends ton temps. On va t'attendre en dehors du village.
msgctxt "NpcYell:9150:0:13"
msgid "Take your time. We're in no rush."
msgstr ""

#. ja: いってらっしゃいネ！
#. de: Aber nicht zu lange warten lassen, ja?
#. fr: À tout à l'heure, oui<nbsp>!
msgctxt "NpcYell:9151:0:13"
msgid "But sooner is better than later!"
msgstr ""

#. ja: 見つけたぞ！<br>生意気な二人組だ！
#. de: Da sind sie! Das sind die beiden!
#. fr: Les voilà<nbsp>! Je les ai trouvés<nbsp>!
msgctxt "NpcYell:9152:0:13"
msgid "There they are!"
msgstr ""

#. ja: さっきはよくも<br>ナメたマネしてくれたな！
#. de: Jetzt werdet ihr bezahlen!
#. fr: Cette fois, croyez pas aussi bien vous en tirer<nbsp>!
msgctxt "NpcYell:9153:0:13"
msgid "This time, we won't go so easy on you!"
msgstr ""

#. ja: やれやれ…<br>チンピラ風情が…
#. de: Schon wieder? Kann ich mich nicht mal eine Minute<nbsp>... \<seufz>
#. fr: Et merde<nbsp>! Manquait plus qu'eux<nbsp>!
msgctxt "NpcYell:9154:0:13"
msgid "Back for a second helping, eh?"
msgstr ""

#. ja: ひぃ、ダーマル君！<br>頼んだヨ！
#. de: Aufpassen, Darmal. Vorsicht!
#. fr: Surtout, fais bien attention, Darmal, oui<nbsp>!
msgctxt "NpcYell:9155:0:13"
msgid "Watch out, Darmal!"
msgstr ""

#. ja: ゲハハハハ！<br>ザマぁ見やがれ！
#. de: Muahaha! Jetzt geht's euch an den Kragen!
#. fr: Mouahaha<nbsp>! Bien fait pour ta gueule<nbsp>!
msgctxt "NpcYell:9156:0:13"
msgid "Next time we see you, you're dead!"
msgstr ""

#. ja: スッキリしたぜ！
#. de: Rache ist süß!
#. fr: Ah, que ça fait du bien de se venger<nbsp>!
msgctxt "NpcYell:9157:0:13"
msgid "Revenge at last!"
msgstr ""

#. ja: ラールラル…<br>大丈夫か…？
#. de: Rhal Ral! Alles in Ordnung?
#. fr: Rhal Ral... Tu vas bien<nbsp>?<nbsp>...
msgctxt "NpcYell:9158:0:13"
msgid "Rhal Ral! Are you all right!?"
msgstr ""

#. ja: ダ、ダメダメ…ネ…
#. de: N-Nein, nix in Ordnung.
#. fr: Non, pas vraiment, non...
msgctxt "NpcYell:9159:0:13"
msgid "No, not really..."
msgstr ""

#. ja: 待たせたな！
#. de: Tut mir leid, dass es ...
#. fr: Désolé de vous avoir fait attendre<nbsp>!
msgctxt "NpcYell:9160:0:13"
msgid "Sorry to keep you wa─"
msgstr ""

#. ja: って、誰もいないじゃないか…？
#. de: Wo sind sie hin?
#. fr: Hmm<nbsp>? Mais où sont-ils partis<nbsp>?
msgctxt "NpcYell:9161:0:13"
msgid "Where did they go?"
msgstr ""

#. ja: まさか、強盗どもに…<br>なんてこった…！
#. de: Bei den Göttern! Die Banditen sind zurück!
#. fr: Oh, non<nbsp>! Les brigands sont revenus<nbsp>!<nbsp>...
msgctxt "NpcYell:9162:0:13"
msgid "Gods be good! Did those bandits come back!?"
msgstr ""

#. ja: クソッタレが…！<br>ラールラル、生きてるか？
#. de: Feiglinge! Ja, rennt ruhig zurück zu eurer Mama! Rhal Ral, lebst du noch?
#. fr: Allez, fuyez, bande de couards<nbsp>! Rhal Ral, tu es encore en vie<nbsp>?
msgctxt "NpcYell:9163:0:13"
msgid "Go on, run, you bunch of milksops! Rhal Ral, are you hurt?"
msgstr ""

#. ja: なんとかネ…
#. de: Ein bisschen ... Urks ...
#. fr: Je sais pas, mais peut-être, oui...
msgctxt "NpcYell:9164:0:13"
msgid "Only physically."
msgstr ""

#. ja: おう、待たせたな！<br>って、何かあったのか？
#. de: Tut mir leid, dass es so lange gedauert hat. Ist alles in Ordnung?
#. fr: Merci de m'avoir attendu<nbsp>! Vous allez bien<nbsp>?
msgctxt "NpcYell:9165:0:13"
msgid "Thank you for waiting. Is everything all right?"
msgstr ""

#. ja: ちょっとだけネ…<br>でも、問題ないヨ！
#. de: Jetzt, ja!
#. fr: Mieux maintenant, ça va mieux, oui<nbsp>!
msgctxt "NpcYell:9166:0:13"
msgid "It is now!"
msgstr ""

#. ja: ならいいんだが…<br>ま、出発するとしようか
#. de: Äh ... gut. Sehr gut. Also, wo waren wir? Ach, ja. Die Klinge der Ahnen ... Ich weiß, wo wir suchen müssen ...
#. fr: Voilà qui me rassure. Bien, allons chercher cette fameuse épée de l'ancien<nbsp>!
msgctxt "NpcYell:9167:0:13"
msgid "I am glad to hear it. Shall we go and find this blade, then?"
msgstr ""

#. ja: 了解だ
#. de: Wir folgen ...
#. fr: Plutôt deux fois qu'une<nbsp>!
msgctxt "NpcYell:9168:0:13"
msgid "I thought you'd never ask."
msgstr ""

#. ja: そうこなくっちゃネ
#. de: Wohin gehen wir, hm?
#. fr: Et on va où, alors, on va où<nbsp>?
msgctxt "NpcYell:9169:0:13"
msgid "Where are you taking us?"
msgstr ""

#. ja: さて、「大老の剣」と言ったか…
#. de: Nach Kelk.
#. fr: À Kelk<nbsp>!
msgctxt "NpcYell:9170:0:13"
msgid "To Kelk."
msgstr ""

#. ja: ロンゾの古い偉人に<br>ケルク大老という方がいてな
#. de: Unter den Ronso gab es mal einen weisen Krieger, der größtes Ansehen genoss.
#. fr: C'est une ancienne ville qui porte le nom d'un de nos plus célèbres ancêtres.
msgctxt "NpcYell:9171:0:13"
msgid "It was named after one of the greatest elders in the history of my people."
msgstr ""

#. ja: 大老と言えば<br>ケルクと考えて間違いない
#. de: Ein Ronso, der so mächtig war, dass man ihm in den Legenden nachsagte, er habe die „Kraft der Ahnen“.
#. fr: Il est encore connu de nos jours comme “l'ancien”.
msgctxt "NpcYell:9172:0:13"
msgid "He was known for his prowess in battle..."
msgstr ""

#. ja: そして、今向かっているのは<br>ケルク遺跡という場所だ
#. de: Ich glaube, es könnte ein Hinweis auf ein Schwert sein, das ihr sucht. Denn in der alten Ronso-Sprache sind Kraft und Schwert oft das Gleiche.
#. fr: Je pense donc que c'est là-bas que nous aurons le plus de chances de trouver cette épée.
msgctxt "NpcYell:9173:0:13"
msgid "...but I expect this Elderblade of which you speak also carried symbolic significance."
msgstr ""

#. ja: ほう、偉人の名を<br>冠した街というわけか！
#. de: Also das Schwert könnte tatsächlich existieren?!
#. fr: Voilà qui est passionnant<nbsp>!
msgctxt "NpcYell:9174:0:13"
msgid "So it's not just a fancy name?"
msgstr ""

#. ja: 確かに怪しいネ！
#. de: Die Klinge der Ahnen! Ja, ja. Jetzt versteht Rhal Ral!
#. fr: En effet<nbsp>! Je comprends mieux maintenant, oui<nbsp>!
msgctxt "NpcYell:9175:0:13"
msgid "The blade of the elder! It all makes sense now!"
msgstr ""

#. ja: 到着したぞ<br>ここがケルク遺跡だ…
#. de: Wir sind da. Das ist Kelk. Oder das, was davon noch übrig ist.
#. fr: Nous y voilà<nbsp>! Les ruines de Kelk sont ici.
msgctxt "NpcYell:9176:0:13"
msgid "This is Kelk, or what is left of it."
msgstr ""

#. ja: やれやれ、探索の前に<br>大掃除が必要そうだな
#. de: Achtung! Wir sind nicht allein!
#. fr: Eh bien, on dirait qu'il va falloir faire un peu de ménage...
msgctxt "NpcYell:9177:0:13"
msgid "Look sharp. We've got company!"
msgstr ""

#. ja: アルマジロ、やっかいネ<br>この数は大変ヨ！
#. de: Gürteltiere. Und so viele!
#. fr: Ouah<nbsp>! Il y a des tatous partout, il y en a partout, des tatous<nbsp>!
msgctxt "NpcYell:9178:0:13"
msgid "Armadillos! And so many of them!"
msgstr ""

#. ja: 旅人サン、魔物退治<br>手伝ってほしいヨ！
#. de: Du uns noch einmal helfen? Darmal mit denen nicht alleine fertig wird, ich fürchte ...
#. fr: Dis, tu veux bien nous aider à nous en débarrasser<nbsp>?
msgctxt "NpcYell:9179:0:13"
msgid "Traveler, will you help us get rid of them?"
msgstr ""

#. ja: 力を貸してくれるか！<br>助かるぜ！
#. de: Ich danke dir!
#. fr: Vraiment<nbsp>? Je t'en remercie<nbsp>!
msgctxt "NpcYell:9180:0:13"
msgid "Thanks. I appreciate it."
msgstr ""

#. ja: みんな、頑張るネ！
#. de: Lass dich nicht umzingeln!
#. fr: Bon courage, oui<nbsp>!
msgctxt "NpcYell:9181:0:13"
msgid "Do not let them corner you!"
msgstr ""

#. ja: ラールラルは<br>戦わないのか…？
#. de: Ähm, wirst du deinem Partner nicht helfen, Rhal Ral?
#. fr: Rhal Ral, tu te bats pas, toi<nbsp>?
msgctxt "NpcYell:9182:0:13"
msgid "Oh? Are you not going to fight as well, Rhal Ral?"
msgstr ""

#. ja: ウチの雇い主サマは<br>戦闘はからきしでなぁ…
#. de: Er bevorzugt es, schlaue Kommentare aus sicherer Entfernung zu machen!
#. fr: Non, il est plutôt du genre à se tenir à l'écart.
msgctxt "NpcYell:9183:0:13"
msgid "He's more the “sit back and watch” sort."
msgstr ""

#. ja: インギ、頑張るネ！
#. de: Nah. Ich bin Hirn. Darmal Muskel.
#. fr: Oui, mais je suis de tout cœur avec vous, je le suis<nbsp>!
msgctxt "NpcYell:9184:0:13"
msgid "I believe the correct term is “offer moral support”!"
msgstr ""

#. ja: フンッ！
#. de: Friss meine Faust!
#. fr: Sales bêtes<nbsp>!
msgctxt "NpcYell:9185:0:13"
msgid "Have at you!"
msgstr ""

#. ja: テイッ！
#. de: Nimm das, Unhold!
#. fr: Allez, fiche le camp<nbsp>!
msgctxt "NpcYell:9186:0:13"
msgid "Be gone, scoundrel!"
msgstr ""

#. ja: トヤッ！
#. de: Links, rechts, Haken!
#. fr: On arrête pas un Ronso énervé<nbsp>!
msgctxt "NpcYell:9187:0:13"
msgid "Once I am properly dressed, I am unstoppable!"
msgstr ""

#. ja: なんて数だ…<br>こりゃ、たまらんぞ…
#. de: Oha. Nicht gut. Ziehen wir uns lieber zurück ...
#. fr: Y en a trop<nbsp>! Je propose un retrait stratégique<nbsp>!
msgctxt "NpcYell:9188:0:13"
msgid "This is not going well! You must withdraw!"
msgstr ""

#. ja: ダメだ…押し切られる…
#. de: Wir werden überrannt!
#. fr: Ouaargh<nbsp>!<nbsp>... Ils sont trop nombreux...
msgctxt "NpcYell:9189:0:13"
msgid "We are being overwhelmed!"
msgstr ""

#. ja: アルマジロ…<br>もう見たくないネ！
#. de: Von Gürteltieren besiegt. Wie peinlich!
#. fr: J'ai assez vu de tatous pour le reste de ma vie, j'en ai assez vus<nbsp>!
msgctxt "NpcYell:9190:0:13"
msgid "Outdone by armadillos! I'll never live this down!"
msgstr ""

#. ja: ふぅ…これで<br>邪魔者は片付いたな…
#. de: Das war's. Jetzt gibt's neue Ledergürtel für alle!
#. fr: Ouf<nbsp>! On a enfin le champ libre<nbsp>!
msgctxt "NpcYell:9191:0:13"
msgid "That was the last of them."
msgstr ""

#. ja: そのようだ…
#. de: Puh. Das war ein hartes Stück Arbeit.
#. fr: Je te le fais pas dire...
msgctxt "NpcYell:9192:0:13"
msgid "Thank goodness..."
msgstr ""

#. ja: 「大老の剣」を求めて<br>さっそく、探索開始ネ！
#. de: Schnell. Wir sollten Klinge der Ahnen suchen. Bevor noch mehr Ärger gibt!
#. fr: Bon, on va chercher l'épée de l'ancien, oui<nbsp>!
msgctxt "NpcYell:9193:0:13"
msgid "Then let us uncover the Elderblade before any more turn up!"
msgstr ""

#. ja: ムッ…<br>こっちに宝箱があるぞ！
#. de: Sieh mal einer, schau! Die Truhe sieht viel<shy>ver<shy>sprechend aus!
#. fr: Ah, mais je crois qu'on tient déjà une piste<nbsp>! Regardez ce coffre<nbsp>!
msgctxt "NpcYell:9194:0:13"
msgid "Hello, hello. This coffer looks promising."
msgstr ""

#. ja: でかしたネ！
#. de: Mach auf! Mach auf!
#. fr: Oooh<nbsp>! Vite, il faut l'ouvrir, il le faut<nbsp>!
msgctxt "NpcYell:9195:0:13"
msgid "Open it! Open it!"
msgstr ""

#. ja: あっさり見つかったな…
#. de: Das ging schneller als gedacht<nbsp>...
#. fr: C'était plus facile que je le pensais...
msgctxt "NpcYell:9196:0:13"
msgid "That was...remarkably straightforward."
msgstr ""

#. ja: じゃあ、開けるぞ…
#. de: Mal sehen, was wir hier haben<nbsp>...
#. fr: Je vais l'ouvrir<nbsp>! Vous êtes prêts<nbsp>?<nbsp>...
msgctxt "NpcYell:9197:0:13"
msgid "What have we here, then?"
msgstr ""

#. ja: …からっぽヨ！<br>笑えるネ！
#. de: Leer! Nix sehen! Nix haben! Nix lachen!
#. fr: Il est vide, com<shy>plè<shy>te<shy>ment vide<nbsp>! Ha ha ha<nbsp>!
msgctxt "NpcYell:9198:0:13"
msgid "Empty!? What a surprise!"
msgstr ""

#. ja: 笑うなよ…
#. de: Das ist die Art des Schicksals zu sagen: Haha!
#. fr: Te moque pas, s'il te plaît<nbsp>!
msgctxt "NpcYell:9199:0:13"
msgid "And not a pleasant one, either."
msgstr ""

#. ja: そう簡単には<br>見つからんさ…
#. de: Tja, aus der Traum ...
#. fr: Je me disais bien que c'était trop facile...
msgctxt "NpcYell:9200:0:13"
msgid "I had a feeling it was too good to be true."
msgstr ""

#. ja: やれやれ…
#. de: \<seufz> Lassen wir es. Ich bin eh fix und fertig<nbsp>...
#. fr: J'en ai déjà marre...
msgctxt "NpcYell:9201:0:13"
msgid "Sod this. Let's go home."
msgstr ""

#. ja: 諦めるのは早いネ！<br>ボク、思い出したヨ！
#. de: Noch warten! Eine Idee habe ich noch!
#. fr: Il faut pas baisser les bras si vite, il le faut pas<nbsp>!
msgctxt "NpcYell:9202:0:13"
msgid "Not yet! There is one more thing I would like to try!"
msgstr ""

#. ja: ナバスアレンの魔法使い<br>使い魔作り、得意にしてたネ！
#. de: Nabaath-Magier oft ihre Waffen verzaubert.
#. fr: Les sorciers de Nabaath Areng savaient faire des familiers magiques, oui<nbsp>!
msgctxt "NpcYell:9203:0:13"
msgid "Nabaath mages enchanted swords to do their bidding..."
msgstr ""

#. ja: 武器に魔法を込めて<br>使い魔にするのヨ！
#. de: Klinge der Ahnen war wahrscheinlich auch voller Magie!
#. fr: Notamment en insufflant la vie dans des armes, oui<nbsp>!
msgctxt "NpcYell:9204:0:13"
msgid "...and the Elderblade was probably full of...errr...magic!"
msgstr ""

#. ja: 「大老の剣」が強い魔力<br>持っている剣なら…
#. de: Vielleicht auch eine lebende Waffe?
#. fr: Donc, si l'épée de l'ancien est magique...
msgctxt "NpcYell:9205:0:13"
msgid "So if they used it to create an evil weapon..."
msgstr ""

#. ja: 使い魔として<br>今も彷徨っているかも…
#. de: Mir schwant Böses ...
#. fr: Je sens que je vais pas aimer la suite de cette histoire.
msgctxt "NpcYell:9206:0:13"
msgid "Oh no... I'm not going to like this, am I?"
msgstr ""

#. ja: そういえば<br>最近、ナバースの断絶で…
#. de: Jetzt, wo du es erwähnst ...
#. fr: Ah, mais oui<nbsp>! Maintenant que tu le dis, ça me rappelle une rumeur<nbsp>!
msgctxt "NpcYell:9207:0:13"
msgid "Now that you mention it..."
msgstr ""

#. ja: 巨大なイビルウェポンを<br>見かけたという噂が…
#. de: In der Nähe der Kluft von Nabaath wurde kürzlich eine Kreatur gesichtet, die eine gewaltige magische Klinge führt.
#. fr: Apparemment, il y aurait une arme maligne géante du côté de l'Abîme des Nabaath<nbsp>!
msgctxt "NpcYell:9208:0:13"
msgid "...there have been sightings of an exceedingly large evil weapon not far from here."
msgstr ""

#. ja: それネ！
#. de: Das muss sie sein! Ja!
#. fr: C'est ça, ça l'est<nbsp>!
msgctxt "NpcYell:9209:0:13"
msgid "Yes! That must be it!"
msgstr ""

#. ja: それだ！
#. de: Ich wusste es ...
#. fr: J'ai de nouveau un mauvais pres<shy>sen<shy>ti<shy>ment...
msgctxt "NpcYell:9210:0:13"
msgid "What are the chances..."
msgstr ""

#. ja: 早く、その場所<br>案内するネッ！
#. de: Du musst uns führen. Los, los!
#. fr: Vite, montre-nous le chemin, Ingi, montre-le-nous<nbsp>!
msgctxt "NpcYell:9211:0:13"
msgid "Can you show us where it was last seen?"
msgstr ""

#. ja: よしきた！
#. de: Natürlich, folgt mir ...
#. fr: Bien sûr<nbsp>! Suivez-moi<nbsp>!
msgctxt "NpcYell:9212:0:13"
msgid "Of course! Follow me!"
msgstr ""

#. ja: 噂だと、この辺りに<br>いるはずなんだが…
#. de: Hier ist der Ort, an dem sie angeblich zuletzt gesichtet wurde.
#. fr: D'après ce que j'ai entendu, ça devrait être par ici...
msgctxt "NpcYell:9213:0:13"
msgid "It should be around here..."
msgstr ""

#. ja: どこだ…！？
#. de: Ah, keiner da! Dann können wir ja wieder gehen ...
#. fr: Où ça<nbsp>? Je vois...
msgctxt "NpcYell:9214:0:13"
msgid "Looks like it's not here. Oh well, never mind."
msgstr ""

#. ja: 怪しい気配…！<br>ビンビン感じるネ！
#. de: Meine Nackenhaare ... Stehen ganz hoch!
#. fr: Oh<nbsp>! Je sens un présence maléfique, oui<nbsp>!
msgctxt "NpcYell:9215:0:13"
msgid "Wait... Do you feel that?"
msgstr ""

#. ja: 「大老の剣」！<br>ボクによこすネ～！
#. de: Die Klinge der Ahnen!
#. fr: L'épée de l'ancien<nbsp>!
msgctxt "NpcYell:9216:0:13"
msgid "The Elderblade!"
msgstr ""

#. ja: おいおい、冗談だろう？
#. de: Es ist sogar noch schlimmer, als ich dachte!
#. fr: Ouah<nbsp>! C'est encore pire que je le craignais<nbsp>!
msgctxt "NpcYell:9217:0:13"
msgid "It's even worse than I thought..."
msgstr ""

#. ja: どうするんだ！<br>あれは、かなり手強いぞ！
#. de: Äh, seid ihr sicher ... Dieses Ungeheuer sieht gemeingefährlich aus.
#. fr: Euh... Vous êtes sûrs de vouloir vous mesurer à ça<nbsp>?<nbsp>...
msgctxt "NpcYell:9218:0:13"
msgid "Umm... Are you sure about this?"
msgstr ""

#. ja: 「大老の剣」…<br>ちょうだいヨ～！
#. de: Kein Angst! Nicht fürchten!
#. fr: Oui<nbsp>! Tout va bien se passer<nbsp>!
msgctxt "NpcYell:9219:0:13"
msgid "Do not be afraid!"
msgstr ""

#. ja: よこすネ～！
#. de: Los, los! Bring Rahl Ral den Schatz!
#. fr: Allez, toi, donne-moi l'épée, donne-la-moi<nbsp>!
msgctxt "NpcYell:9220:0:13"
msgid "Yes... Yes! Get me that blade!"
msgstr ""

#. ja: こ、こんなことになるとは…
#. de: Was sollen wir jetzt machen?
#. fr: Comment pouvions-nous savoir<nbsp>!?
msgctxt "NpcYell:9221:0:13"
msgid "Th-This was never meant to happen..."
msgstr ""

#. ja: 逃げろ！<br>この先は危険だぞ…！？
#. de: Flieh! Irgendwohin, nur weg von hier!
#. fr: Fuyez<nbsp>! Vous ne tenez donc pas à la vie<nbsp>!?
msgctxt "NpcYell:9222:0:13"
msgid "Flee the way you came! Even worse lies ahead..."
msgstr ""

#. ja: ダエン兄弟…<br>どこにいったのかしら？
#. de: Wo sind die Daen-Brüder nur hin?
#. fr: Où sont passés les frères Daen...<nbsp>?
msgctxt "NpcYell:9223:0:13"
msgid "Where are they?"
msgstr ""

#. ja: あのアマロに<br>聞いてみよう…！
#. de: Fragen wir den Amaro dort drüben ...
#. fr: Cet amaro saura peut-être.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9224:0:13"
msgid "Maybe someone<br>saw them pass..."
msgstr ""

#. ja: うおおおッ！？
#. de: Wuaaah!
#. fr: Argh<nbsp>! Qu'est-ce que...<nbsp>!
msgctxt "NpcYell:9225:0:13"
msgid "Haaagh!"
msgstr ""

#. ja: きゃああっ！
#. de: Hilfeee!
#. fr: Ah<nbsp>!!!
msgctxt "NpcYell:9226:0:13"
msgid "Ahhh!"
msgstr ""

#. ja: ムッ！？
#. de: Hm?
#. fr: Hmm<nbsp>!?
msgctxt "NpcYell:9227:0:13"
msgid "Pathetic!"
msgstr ""

#. ja: 最後の最後で<br>先走りやがって！
#. de: He! Wo willst du hin?!
#. fr: Eh bien, quelle aventure<nbsp>!<nbsp>...
msgctxt "NpcYell:9228:0:13"
msgid "Oi! Where are you going!?"
msgstr ""

#. ja: が、我慢できなかったネ…
#. de: Rhal Ral hat Angst. Dachte, erst macht es Darmal tot und dann mich!
#. fr: Désolé, j'ai pas pu m'empêcher...
msgctxt "NpcYell:9229:0:13"
msgid "I was scared! I thought it would kill you, then me!"
msgstr ""

#. ja: む、無念…
#. de: Wie bedauerlich ...
#. fr: Do-dommage...
msgctxt "NpcYell:9230:0:13"
msgid "This is most regrettable."
msgstr ""

#. ja: よっしゃー！<br>倒したぜッ！
#. de: Puh, ich dachte, die Kreatur gibt nie auf!
#. fr: Ouf<nbsp>! J'ai vraiment cru qu'on en viendrait jamais à bout<nbsp>!
msgctxt "NpcYell:9231:0:13"
msgid "Phew! I thought the damned thing would never give up!"
msgstr ""

#. ja: 念願の「大老の剣」…<br>手に入れたネ！
#. de: Die Klinge der Ahnen! Mein! Äh ... unser!
#. fr: Elle est enfin à moi, elle l'est<nbsp>! L'épée de l'ancien<nbsp>!
msgctxt "NpcYell:9232:0:13"
msgid "The Elderblade is mine! I mean, ours!"
msgstr ""

#. ja: はぁ、はぁ…<br>えらい目に遭った…
#. de: Ein Wunder, dass wir das überlebt haben!
#. fr: (souffle)... (souffle)... J'ai vraiment cru que j'allais y passer...
msgctxt "NpcYell:9233:0:13"
msgid "I can scarcely believe we survived..."
msgstr ""

#. ja: さすが秘宝…<br>すごい魔力ネ！
#. de: Der Schatz! Oho! Welch magische Kraft!
#. fr: Cette arme recèle vraiment un grand pouvoir, oui<nbsp>!
msgctxt "NpcYell:9234:0:13"
msgid "I never doubted you for a moment! You all fought very well!"
msgstr ""

#. ja: そういえばケルク大老は<br>凄腕の剣士だったそうだ
#. de: Das ist die Klinge der Ahnen, verzaubert mit Magie der Nabaath!
#. fr: Ah, maintenant que j'y pense, d'après nos légendes, Kelk était un grand bretteur.
msgctxt "NpcYell:9235:0:13"
msgid "The sword of the great Kelk, enchanted by Nabaath magicks..."
msgstr ""

#. ja: もしかしたら、その剣を手に<br>戦ったのかもしれないな…
#. de: Selbst nach so langer Zeit ist die Magie in ihr noch stark!
#. fr: Il est fort probable qu'il tirait un grand pouvoir de cette épée.
msgctxt "NpcYell:9236:0:13"
msgid "Even now that the spell has been broken, the power within is undeniable."
msgstr ""

#. ja: それはいい事、聞いたネ！<br>売値、跳ね上がるヨ！
#. de: Sehr gut! Sehr gut! Kann man gut verkaufen!
#. fr: Oh, oh<nbsp>! Cette histoire va me permettre de la vendre pour un très bon prix, oui<nbsp>!
msgctxt "NpcYell:9237:0:13"
msgid "Which should see that it fetches a high price!"
msgstr ""

#. ja: ぜひ、価値を知る者に<br>譲ってやってくれ
#. de: Rhal Ral, diese Klinge darf nicht in die falschen Hände geraten. Sein Träger muss ihr würdig sein.
#. fr: Rhal Ral, je te demande juste de faire attention à qui tu la vends. Cela reste un artefact très puissant.
msgctxt "NpcYell:9238:0:13"
msgid "Rhal Ral, this blade must never fall into the wrong hands. We must ensure that it finds a worthy owner."
msgstr ""

#. ja: 任せるネ！
#. de: Am besten ein Paar Hände mit viel Gil. Hihihi.
#. fr: Oui, tu peux me faire confiance, tu le peux<nbsp>!
msgctxt "NpcYell:9239:0:13"
msgid "Preferably one who does not mind parting with a few jinglies!"
msgstr ""

#. ja: 呪縛魔法か…！<br>だが、こんなもので…！
#. de: Ein Fesselzauber? Der wird mich nicht halten können.
#. fr: Un sort d'immobilisation<nbsp>!? Sale petite peste...
msgctxt "NpcYell:9240:0:13"
msgid "What in the─"
msgstr ""

#. ja: 弟をよくも！
#. de: Brüderchen!
#. fr: Mon petit frère<nbsp>! Bande de sauvages<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:9241:0:13"
msgid "That's <i>hardly</i> sporting..."
msgstr ""

#. ja: や、やるじゃないか…！
#. de: So hartnäckig!
#. fr: Pas... pas mal<nbsp>!
msgctxt "NpcYell:9242:0:13"
msgid "If you insist..."
msgstr ""

#. ja: アナタも手伝ってくれて<br>ありがとう！
#. de: Danke für deine Hilfe!
#. fr: Merci pour ton aide<nbsp>!
msgctxt "NpcYell:9243:0:13"
msgid "My thanks, mortal!"
msgstr ""

#. ja: そこまでだ！
#. de: Nichts als Abschaum!
#. fr: J'en ai assez de ce combat<nbsp>!
msgctxt "NpcYell:9244:0:13"
msgid "I tire of this farce!"
msgstr ""

#. ja: よくも、にーちゃんを！
#. de: Brüderchen!
#. fr: Vous allez me le payer<nbsp>!
msgctxt "NpcYell:9245:0:13"
msgid "Dear me!"
msgstr ""

#. ja: にーちゃん、大丈夫？
#. de: Alles in Ordnung?
#. fr: Frérot<nbsp>? Ça va<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9246:0:13"
msgid "Are you quite<br>all right, brother?"
msgstr ""

#. ja: みんなも遊んでくれて<br>本当にありがとね…！
#. de: Danke, dass ihr mit uns gespielt habt!
#. fr: J'espère que ça vous a plu aussi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9247:0:13"
msgid "You know, you're quite fun!<br>As mortals go."
msgstr ""

#. ja: コレガ…<br>オレタチノ…全力ダァ！！
#. de: Das ist die Macht der Zwillinge!
#. fr: LES FRÈRES DAEN, SURPUISSANTS<nbsp>!!!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:9248:0:13"
msgid "Ohoho... What<i>ever</i> shall you do?"
msgstr ""

#. ja: その様子だと<br>まったく反省していないようね？
#. de: Ihr habt wohl immer noch nicht genug, was?
#. fr: Vous vous avouez jamais vaincus<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9249:0:13"
msgid "Not the least bit<br>contrite, are you?"
msgstr ""

#. ja: そんなに謝らせたいなら…<br>オレたちと決闘だ！
#. de: Wenn wir aufhören sollen, müsst ihr uns schon besiegen!
#. fr: Pour ça, faudra d'abord nous battre à plate couture<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9250:0:13"
msgid "Why be contrite when<br>you're so keen to fight?"
msgstr ""

#. ja: やはりそうだ…<br>あの日の俺は…！
#. de: Ja, so war es, an jenem Tage ...
#. fr: Oui, ça me revient<nbsp>!
msgctxt "NpcYell:9251:0:13"
msgid "It's all starting to come back to me now."
msgstr ""

#. ja: あちらを探してみますね！
#. de: Ich such mal hier hinten!
#. fr: Je vais chercher par là<nbsp>!
msgctxt "NpcYell:9252:0:13"
msgid "Let us see what we can find."
msgstr ""

#. ja: 業火ヨ、唸リ周レ！
#. de: Umhüllt sie, meine Flammen!
#. fr: Rugissez, flammes de l'enfer<nbsp>!!
msgctxt "NpcYell:9253:0:13"
msgid "By fire's kiss be cleansed!"
msgstr ""

#. ja: 我ガ刃ノ風…<br>止メラレルカナ？
#. de: Schneidende Winde! Haltet sie auf!
#. fr: Voyons si vous allez pouvoir arrêter mes lames de vent<nbsp>!
msgctxt "NpcYell:9254:0:13"
msgid "By wind's blades be flayed!"
msgstr ""

#. ja: 言霊重ネテ、魔ヲ連ネン！<br>雷炎ヨ、駆ケ巡レ！
#. de: Geister, entfesselt die Dämonen! Bringt Blitz und Feuer!
#. fr: Esprits, déchaînez les démons, les flammes et la foudre<nbsp>!
msgctxt "NpcYell:9255:0:13"
msgid "My magicks are unending, my loyalty undying!"
msgstr ""

#. ja: さぁ、行くぞ！
#. de: Also los!
#. fr: En avant<nbsp>!
msgctxt "NpcYell:9256:0:13"
msgid "Let's go!"
msgstr ""

#. ja: 必ず見つける…！
#. de: Wir müssen es finden!
#. fr: Je dois la trouver<nbsp>!
msgctxt "NpcYell:9257:0:13"
msgid "We have to find it!"
msgstr ""

#. ja: この辺りに<br>ありそうか…？
#. de: Hier muss es irgendwo sein.
#. fr: Peut-être par ici<nbsp>?
msgctxt "NpcYell:9258:0:13"
msgid "Could it be over there?"
msgstr ""

#. ja: おい、待ってくれよ
#. de: He, warte auf mich!
#. fr: Hé, attendez<nbsp>!
msgctxt "NpcYell:9259:0:13"
msgid "Wait up!"
msgstr ""

#. ja: うわッ、魔物だ！
#. de: Ahh! Beschütze mich bitte!
#. fr: Ah<nbsp>! On nous attaque<nbsp>!
msgctxt "NpcYell:9260:0:13"
msgid "Oh no!"
msgstr ""

#. ja: すまない…
#. de: E-Entschuldige ...
#. fr: Désolé...
msgctxt "NpcYell:9261:0:13"
msgid "I'm sorry..."
msgstr ""

#. ja: こちらに構わず<br>魔物を倒してくれ！
#. de: Achte nicht auf mich, erledige diese Biester!
#. fr: Ne vous occupez pas de moi<nbsp>!
msgctxt "NpcYell:9262:0:13"
msgid "Don't worry about me."
msgstr ""

#. ja: 俺も戦えたら…！
#. de: Wäre ich bloß auch ein Kämpfer ...
#. fr: Si seulement je me battais mieux...
msgctxt "NpcYell:9263:0:13"
msgid "I believe in you!"
msgstr ""

#. ja: 我らに未来を…！
#. de: Die Zukunft ist nicht verloren!
#. fr: Pour l'avenir de notre civilisation<nbsp>!
msgctxt "NpcYell:9264:0:13"
msgid "To rekindle our future!"
msgstr ""

#. ja: 同胞のために…！
#. de: Tu es für deine Brüder!
#. fr: Pour nos frères et sœurs<nbsp>!
msgctxt "NpcYell:9265:0:13"
msgid "To restore our brethren!"
msgstr ""

#. ja: 希望を繋ぐのだ…！
#. de: Nimm die Macht unserer Sehnsüchte!
#. fr: Pour raviver la flamme de l'espoir<nbsp>!
msgctxt "NpcYell:9266:0:13"
msgid "To revive our hope!"
msgstr ""

#. ja: 我らに救済を…！
#. de: Erwecke sie aus tausendjährigem Schlaf!
#. fr: Pour notre salut<nbsp>!
msgctxt "NpcYell:9267:0:13"
msgid "To realize our salvation!"
msgstr ""

#. ja: 星をひとつに…！
#. de: Vereine die Welten!
#. fr: Pour réunifier notre planète<nbsp>!
msgctxt "NpcYell:9268:0:13"
msgid "To remake our star!"
msgstr ""

#. ja: 世界を取り戻す…！
#. de: Bring unser Zuhause zurück!
#. fr: Pour reconquérir notre monde<nbsp>!
msgctxt "NpcYell:9269:0:13"
msgid "To reclaim our world!"
msgstr ""

#. ja: 次元よ、胸に秘めたる<br>怒りに震えよ…
#. de: Erzittert vor dem Hass meines Herzens!
#. fr: Ressentez la colère qui gronde en moi...
msgctxt "NpcYell:9270:0:13"
msgid "I shall turn the very ground against you!"
msgstr ""

#. ja: クエイガ…！
#. de: Spürt das Beben des Planeten!
#. fr: Mon courroux ébranle la terre<nbsp>!
msgctxt "NpcYell:9271:0:13"
msgid "Let the earth tremble!"
msgstr ""

#. ja: 我が炎は<br>魂すら焼き尽くす…！
#. de: Mein Feuer wird eure Seelen verzehren!
#. fr: Tu vas brûler, corps et âme<nbsp>!
msgctxt "NpcYell:9272:0:13"
msgid "My flames shall raze your very soul!"
msgstr ""

#. ja: 我が氷は<br>魂すら凍てつかせる…！
#. de: Mein Eis wird eure Seelen erstarren lassen!
#. fr: Je vais glacer ton être<nbsp>!
msgctxt "NpcYell:9273:0:13"
msgid "My ice shall chill the very essence of your being!"
msgstr ""

#. ja: アナイアレイション…！
#. de: Erfahrt totale Zerstörung!
#. fr: Il ne restera plus rien<nbsp>!
msgctxt "NpcYell:9274:0:13"
msgid "Nothing shall remain!"
msgstr ""

#. ja: 明日は我らのもの…！
#. de: Die Zukunft gehört uns, uns allein!
#. fr: Demain nous appartient<nbsp>!
msgctxt "NpcYell:9275:0:13"
msgid "The future is ours, and ours alone!"
msgstr ""

#. ja: 何者にも奪わせはしない…！
#. de: Wir lassen sie uns von niemandem nehmen!
#. fr: Nul n'usurpera notre place<nbsp>!
msgctxt "NpcYell:9276:0:13"
msgid "We will relinquish it to no one. No one!"
msgstr ""

#. ja: 業物求めて、東へ、西へ……<br>噂の剣豪、ここに見参！！
#. de: Er durchstreift die Kontinente, immer auf der Suche nach der schärfsten Klinge<nbsp>...
#. fr: Mesdames et Messieurs, le bretteur légendaire en provenance des contrées orientales est enfin arrivé au Gold Saucer<nbsp>!
msgctxt "NpcYell:9277:0:13"
msgid "The most renowned swordsman of the Far East is about to descend upon the Gold Saucer!"
msgstr ""

#. ja: 斬魔の一閃、右へ、左へ……<br>閃く剣撃、逃げ切りたまえ！！
#. de: Er scheut kein Duell, denn gegen seine blitzschnellen Streiche ist kein Gras gewachsen<nbsp>...
#. fr: Gardez les yeux grands ouverts en permanence, ou vous risquez de louper ses attaques aussi rapides que la lumière<nbsp>!
msgctxt "NpcYell:9278:0:13"
msgid "His skills with a blade must be seen to be believed, but blink and you'll miss them, so keep those eyes peeled!"
msgstr ""

#. ja: さあさあ、それではヨウジンボウ先生……<br>いざ、ご出陣の刻にございます～！
#. de: Eben noch als wandernder Fechtmeister unterwegs, jetzt auf der Showbühne: der große Yojinbooo!
#. fr: En direct sur la scène du square des spectacles... voici Yooojiiiimbooo<nbsp>!!
msgctxt "NpcYell:9279:0:13"
msgid "Yojimbo, come on down!"
msgstr ""

#. ja: 出たァ～！
#. de: Da! Das ist er!
#. fr: Le voilà enfin<nbsp>!
msgctxt "NpcYell:9280:0:13"
msgid "Is that really him?"
msgstr ""

#. ja: いよっ、待ってました！
#. de: Endlich! Ich hab beinah einen vollen Glockenschlag gewartet.
#. fr: J'ai tellement attendu ce moment<nbsp>!
msgctxt "NpcYell:9281:0:13"
msgid "This is the moment I've been waiting for!"
msgstr ""

#. ja: あれが噂の剣豪か…！
#. de: Der wandernde Fechtmeister<nbsp>...
#. fr: Maître Yojimbo, montrez-nous vos fameuses attaques éclair<nbsp>!
msgctxt "NpcYell:9282:0:13"
msgid "I heard his blade is so sharp, he can split infinitives, whatever that means..."
msgstr ""

#. ja: すごい業物だ…！
#. de: Seht nur, wie prächtig das Schwert ist!
#. fr: Oh non<nbsp>! J'ai cligné des yeux<nbsp>!
msgctxt "NpcYell:9283:0:13"
msgid "I blinked! Did I miss anything?"
msgstr ""

#. ja: 東方に伝わりし古の至宝……<br>秘剣「斬魔刀」の斬れ味、とくと味わえ～ッ！
#. de: Legendärer Schatz des Ostens<nbsp>...<br>Mächtige Klinge Zanmato, schneide!
#. fr: Admirez le tranchant aveuglant de Zanmato, le trésor des lames d'Orient<nbsp>!
msgctxt "NpcYell:9284:0:13"
msgid "Behold, the sword art of legend─Zanmato!"
msgstr ""

#. ja: これが斬魔刀の力だぜ～！
#. de: Das kann nur Zanmato!
#. fr: Heu<shy>reu<shy>se<shy>ment qu'il n'est pas venu nous découper en rondelles<nbsp>!
msgctxt "NpcYell:9285:0:13"
msgid "Thank your lucky stars Zanmato thirsts not for your blood!"
msgstr ""

#. ja: ダイゴロウ！<br>銭を拾え～ッ！
#. de: Daigoro!<br>Hol das Geld!
#. fr: Ramène-moi tout cet or, Daigoro<nbsp>!
msgctxt "NpcYell:9286:0:13"
msgid "Go, Daigoro! Bring me those koban!"
msgstr ""

#. ja: さっすが先生！
#. de: Das kann nur der große Yojinbo!
#. fr: Les rumeurs disaient donc vrai<nbsp>!
msgctxt "NpcYell:9287:0:13"
msgid "The rumors were true!"
msgstr ""

#. ja: いよっ、名人芸！
#. de: Ein Hoch auf den Schwertmeister!
#. fr: Quelle virtuosité<nbsp>!
msgctxt "NpcYell:9288:0:13"
msgid "My eyes can barely keep up!"
msgstr ""

#. ja: これが噂の剣豪か…！
#. de: Das ist also der berühmte Yojinbo<nbsp>...
#. fr: Il est incroyable<nbsp>!
msgctxt "NpcYell:9289:0:13"
msgid "So that's the mighty Zanmato..."
msgstr ""

#. ja: すごい斬れ味だ…！
#. de: Was für ein Hieb!
#. fr: Une telle lame pourrait même mettre en pièces une armure magitek<nbsp>!
msgctxt "NpcYell:9290:0:13"
msgid "I've never seen anything like it!"
msgstr ""

#. ja: さてと、ここらでひと勝負、打ってもらおうじゃね～か！
#. de: Ein Streich<nbsp>- und nichts ist mehr, wie es war!
#. fr: On dit que la chance sourit aux audacieux. Voyons voir si tu es de cette trempe-là<nbsp>!
msgctxt "NpcYell:9291:0:13"
msgid "Fortune favors the bold, and if you are truly worthy, your luck will hold!"
msgstr ""

#. ja: 用意したるは、みっつのツボ……<br>ひとつにゃ、大判小判……もうひとつにゃダイゴロウ。
#. de: Drei Krüge ... In einem mein Hund Daigoro, in dem anderen: Geld. Und im letzten? Nichts!
#. fr: Voici trois jarres<nbsp>! Un tas de pièces d'or se trouve dans l'une d'entre elles. Une autre contient mon fidèle compagnon Daigoro. Quant à la dernière, elle est vide comme la boîte cranienne de mon impresario<nbsp>!
msgctxt "NpcYell:9292:0:13"
msgid "Three cups I present! One contains riches, another my faithful hound! And the last...well, nothing at all!"
msgstr ""

#. ja: ひっくり返したツボの中に、大判小判があれば、くれてやろう。<br>だが、ダイゴロウが出てきたら、即失格……！
#. de: Findest du Geld, kannst du es behalten. Doch mein Hund bedeutet, dass du verlierst.
#. fr: Si tu choisis celle qui contient l'or, il sera à toi, mais si tu tombes sur Daigoro, attention à ne pas te faire mordre le derrière<nbsp>!
msgctxt "NpcYell:9293:0:13"
msgid "Uncover the coin, and it is yours. Chance upon Daigoro, and you will be sent running with your tail between your legs!"
msgstr ""

#. ja: さあさあ、みっつ数えるうちに、<br>これぞと思うツボを選んで、側に立ちやがれ～！
#. de: Wähle einen Krug und stelle dich an seine Seite!
#. fr: Je vais compter jusqu'à trois. Fais ton choix avant que j'aie terminé<nbsp>!
msgctxt "NpcYell:9294:0:13"
msgid "Before I count to three, make your choice!"
msgstr ""

#. ja: ひとつ……
#. de: Eins ...
#. fr: Un...
msgctxt "NpcYell:9295:0:13"
msgid "One..."
msgstr ""

#. ja: ふたつ……
#. de: Zwei ...
#. fr: Deux...
msgctxt "NpcYell:9296:0:13"
msgid "Two..."
msgstr ""

#. ja: みっつ……いざ、勝負だッ！
#. de: Drei! Los geht's!
#. fr: Trois<nbsp>!
msgctxt "NpcYell:9297:0:13"
msgid "Three!"
msgstr ""

#. ja: ほう、この勝負に勝ってみせるとは、<br>なかなかやるじゃね～か！
#. de: Hohooo! Du hast gut gewählt! Kann es sein, dass du selbst die Instinkte eines Kämpfers hast?
#. fr: Bravo<nbsp>! Le kami de la fortune t'a à la bonne<nbsp>!
msgctxt "NpcYell:9298:0:13"
msgid "Well, well! The kami smile upon you, brave one!"
msgstr ""

#. ja: 銭が鳴れば、腕も鳴る！<br>斬魔刀の力、まだまだ披露してやるぜ～！
#. de: Das Geld liegt auf der Straße, man muss es nur aufheben!<br>Warte, Zanmato verlangt es nach einem weiteren Hieb!
#. fr: Veux-tu poursuivre le défi<nbsp>? Zanmato se fera un plaisir de t'éblouir à nouveau<nbsp>!
msgctxt "NpcYell:9299:0:13"
msgid "If you are still game, so am I!"
msgstr ""

#. ja: 決まった…
#. de: Das ist es!
#. fr: Le grand moment est arrivé...
msgctxt "NpcYell:9300:0:13"
msgid "This is as far as you go!"
msgstr ""

#. ja: 銭だ、銭だ、取り逃すな！
#. de: Geld! Geld! Lass es dir nicht wegnehmen!
#. fr: Hé hé hé, ça en fait des piécettes<nbsp>!
msgctxt "NpcYell:9301:0:13"
msgid "Good boy, Daigoro!"
msgstr ""

#. ja: そぉーれ、ぐーるぐる！
#. de: Hier? Oder da?
#. fr: Tournicoti, tournicoton<nbsp>!
msgctxt "NpcYell:9302:0:13"
msgid "The cup is quicker than the eye!"
msgstr ""

#. ja: アタリはどっちだ？
#. de: Wo wird das Schwert der Legenden zuschlagen?
#. fr: Alors, où se trouve le magot<nbsp>?
msgctxt "NpcYell:9303:0:13"
msgid "Now, choose!"
msgstr ""

#. ja: おーい、待ってくれー！
#. de: Mochi-Meister, warte!
#. fr: Hé, une minute<nbsp>!
msgctxt "NpcYell:9304:0:13"
msgid "Stop! Stop the pounding!"
msgstr ""

#. ja: 大天山の霊泉で作られた<br>動く餅が、紛れ込んじまった！
#. de: Ein zum Leben erwecktes Mochi hat sich wieder in den Mörser eingeschlichen!
#. fr: Je croyais qu'on s'était débarrassés de lui l'année dernière<nbsp>!
msgctxt "NpcYell:9305:0:13"
msgid "We believe mochi mixed with waters from the Daitenzan's soulspring has stolen its way into our stores!"
msgstr ""

#. ja: なんだと！？<br>餅つきを止めねぇと…！
#. de: Was sagst du da?! Das Stampfen muss sofort abgebrochen werden!
#. fr: Il faut à tout prix arrêter le gluant de riz<nbsp>!
msgctxt "NpcYell:9306:0:13"
msgid "From the soulspring...? Do you mean to tell me this mochi is alive!?"
msgstr ""

#. ja: しまった、ゴズの野郎が動く餅に驚いて、錯乱しちまった！<br>こうなったら、降神餅を急いで切り分けるしかねぇぞ！
#. de: Zu spät ... Der Gozu hat das Mochi bereits bemerkt und er ist außer sich vor Wut! Wir müssen den rasenden Reisteigklumpen zerteilen und außer Gefecht setzen!
#. fr: Argh, et maintenant le gozu est tout excité... Il faut vite découper le gluant en petits morceaux avant que ça tourne au vinaigre<nbsp>!
msgctxt "NpcYell:9307:0:13"
msgid "Damn it, Gozu has been spooked. Quickly, we must dispense with the mochi!"
msgstr ""

#. ja: 前回の動く降神餅に<br>生き残りがいたってか…
#. de: Es muss sich um einen zähen Überrest des wildgewordenen Mochi von letztes Jahr handeln ...
#. fr: Mon mortier était encore imprégné de l'eau mystique du Mont Daiten...
msgctxt "NpcYell:9308:0:13"
msgid "The living mochi must have come from last year's celebration. But how...?"
msgstr ""

#. ja: そろそろ、遊びも終わりの頃合い……<br>斬魔刀の真なる力、披露してやるぜ～！
#. de: Die Zeit der Spielchen ist vorbei. Jetzt entfessele ich die echte Kraft von Zanmato!
#. fr: Notre petit jeu touche à sa fin. Le temps est venu pour Zanmato d'étinceler une dernière fois<nbsp>!
msgctxt "NpcYell:9309:0:13"
msgid "I fear our little game must soon come to an end. One last chance for Zanmato to shine!"
msgstr ""

#. ja: やれやれ、生き残りがいやがったとは……<br>この勝負、お前の勝ちのようだな……さらばだぜ！
#. de: Diese Runde geht an dich. Aber ich fordere dich zur Revanche, bei der nächsten Vorstellung!
#. fr: Impossible de t'expulser de la scène, à ce que je vois<nbsp>! Je m'avoue vaincu pour cette fois, mais ce n'est que partie remise<nbsp>!
msgctxt "NpcYell:9310:0:13"
msgid "Fleet of foot, and fortunate to boot! A well-deserved victory!"
msgstr ""

#. ja: この勝負、俺の勝ちのようだな！<br>さて、給料でももらいに行くとするか……あばよ！
#. de: Diese Runde geht an mich! Ich werde jetzt meine Gage einstreichen<nbsp>- bis zum nächsten Mal!
#. fr: Zanmato a eu raison de toi, et tout le magot est pour moi, ha ha<nbsp>!
msgctxt "NpcYell:9311:0:13"
msgid "Alas, it was not your lucky day, my friend. Though I must say, you certainly made me work hard for my coin!"
msgstr ""

#. ja: 出番はまだか<br>サッサカサー
#. de: Sägespän' und Kleie ♪<br>Wann sind wir an der Reihe? ♪
#. fr: Qu'est-ce qu'on attend pour nettoyer tout ça<nbsp>? Fschuiii<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9312:0:13"
msgid "Krow ot emit ti si?<br>Swish-swish-aroo."
msgstr ""

#. ja: 順番待ちだ<br>サッサカサー
#. de: Dreck in Hof und Garten ♪<br>Wie lang soll'n wir noch warten? ♪
#. fr: C'est bientôt mon tour<nbsp>? Fschuiii<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9313:0:13"
msgid "Naps dna kcips.<br>Swish-swish-aroo!"
msgstr ""

#. ja: お掃除大好き<br>サッサカサー
#. de: Putzen, wischen, fegen ♪<br>Das ist unser Leben ♪
#. fr: Le ménage, il n'y a que ça de vrai<nbsp>! Fschuiii<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9314:0:13"
msgid "Naelc ot evil I!<br>Swish-swish-aroo!"
msgstr ""

#. ja: モォ～！！
#. de: Muuuh!
#. fr: Meuuuh<nbsp>!!!
msgctxt "NpcYell:9315:0:13"
msgid "Grrroooaaahhh!"
msgstr ""

#. ja: ンモォォォ！！！
#. de: Muuuh!
#. fr: Meumeumeuuuh<nbsp>!!!
msgctxt "NpcYell:9316:0:13"
msgid "Grrroooaaaaaarrr!!!"
msgstr ""

#. ja: ！？
#. de: Nanu?
#. fr: !?
msgctxt "NpcYell:9317:0:13"
msgid "!?"
msgstr ""

#. ja: 綺麗にお掃除！<br>サッサカサー！
#. de: Das ist des Besens Kern ♪<br>Ich feg für mein Leben gern ♪
#. fr: La propreté avant tout<nbsp>! Fschuiii<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9318:0:13"
msgid "Sniats luof enogeb!<br>Swish-swish-aroo!"
msgstr ""

#. ja: 只今、ヨウジンボウ先生とギャラ交渉中です……。<br>今しばらく、お待ちください。
#. de: Der große Yojinbo befindet sich noch in der Garderobe, um<nbsp>... ähem, die Gage zu verhandeln. Wir bitten das Publikum, sich etwas zu gedulden.
#. fr: Maître Yojimbo est en train de négocier son cachet. Veuillez patienter un instant, s'il vous plaît.
msgctxt "NpcYell:9319:0:13"
msgid "Yojimbo is currently discussing his fee, though I'm sure it won't take much longer."
msgstr ""

#. ja: 大変長らく、お待たせいたしました。<br>ギャラ交渉がまとまり、まもなく開演となります。
#. de: Wir bitten um Aufmerksamkeit! Das Warten hat ein Ende! Der große Yojinbo wird jeden Moment die Bühne betreten!
#. fr: Les négociations avec Maître Yojimbo sont terminées. Il ne devrait pas tarder à faire son entrée sur scène<nbsp>!
msgctxt "NpcYell:9320:0:13"
msgid "It seems that we have reached an agreement with Yojimbo, who is due to appear any moment now."
msgstr ""

#. ja: 必滅の炎で<br>燃やしてしまえ…！
#. de: Brennt in den ewigen Flammen!
#. fr: Que la flamme mortelle vous brûle les entrailles<nbsp>!
msgctxt "NpcYell:9321:0:13"
msgid "Sear the flesh from their bones!"
msgstr ""

#. ja: さすがは我が最高傑作…！
#. de: Der Lohengeneral ist mein meisterliches Meisterstück.
#. fr: Ha ha ha... Mon plus grand chef-d'œuvre<nbsp>!
msgctxt "NpcYell:9322:0:13"
msgid "None can withstand the flames of Lugus!"
msgstr ""

#. ja: 燃えろ、燃えろ…！
#. de: Brennt! Brennt!
#. fr: Brûlez, brûlez donc<nbsp>!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9323:0:13"
msgid "Burn them all!<br>Hahahahahaha!"
msgstr ""

#. ja: 灰にしてやるのだ…！
#. de: Ihr seid nichts als Asche!
#. fr: Soyez réduits en cendres<nbsp>!
msgctxt "NpcYell:9324:0:13"
msgid "To ashes with them!"
msgstr ""

#. ja: 囲メ！　囲メ！
#. de: Umzingeln! Umzingeln!
#. fr: Encercler l'ennemi<nbsp>! Encercler l'ennemi<nbsp>!
msgctxt "NpcYell:9325:0:13"
msgid "Aim. Aim."
msgstr ""

#. ja: 狙エ！　狙エ！
#. de: Feuern! Feuern!
#. fr: Viser l'ennemi<nbsp>! Viser l'ennemi<nbsp>!
msgctxt "NpcYell:9326:0:13"
msgid "Fire. Fire."
msgstr ""

#. ja: 落トセ！　落トセ！
#. de: Bombardieren! Bombardieren!
#. fr: Abattre l'ennemi<nbsp>! Abattre l'ennemi<nbsp>!
msgctxt "NpcYell:9327:0:13"
msgid "Bombs away."
msgstr ""

#. ja: コロス！　コロス！
#. de: Auslöschen! Auslöschen!
#. fr: Tuer<nbsp>! Tuer<nbsp>!
msgctxt "NpcYell:9328:0:13"
msgid "Kill. Kill."
msgstr ""

#. ja: コロス！　コロス！<br>コロス！　コロス！
#. de: Töten! Töten!<br>Töten! Töten!
#. fr: Tuer<nbsp>! Tuer<nbsp>! Tuer<nbsp>! Tuer<nbsp>!
msgctxt "NpcYell:9329:0:13"
msgid "Kill. Kill. Kill."
msgstr ""

#. ja: うわー！<br>すごい光景だ！
#. de: Waaahnsinn! Diese Aussicht!
#. fr: Jolie vue<nbsp>!
msgctxt "NpcYell:9330:0:13"
msgid "Would you look at that!"
msgstr ""

#. ja: ひえ～<br>なんて高さだ…！
#. de: Uah! So weit oben sind wir?!
#. fr: Ouah, c'est haut<nbsp>!
msgctxt "NpcYell:9331:0:13"
msgid "It's like it goes on forever..."
msgstr ""

#. ja: こっちだ…
#. de: Hier entlang.
#. fr: Par ici.
msgctxt "NpcYell:9332:0:13"
msgid "This way."
msgstr ""

#. ja: 侵入者ヲ発見！
#. de: Eindringlinge. Entdeckt.
#. fr: Intrus détectés<nbsp>!
msgctxt "NpcYell:9333:0:13"
msgid "Intruders detected."
msgstr ""

#. ja: 集マレ、集マレ！
#. de: Antreten! Antreten!
#. fr: Regroupement<nbsp>! Regroupement<nbsp>!
msgctxt "NpcYell:9334:0:13"
msgid "Over here."
msgstr ""

#. ja: シネ！　シネ！
#. de: Sterbt! Sterbt!
#. fr: Mourez<nbsp>! Mourez<nbsp>!
msgctxt "NpcYell:9335:0:13"
msgid "Die. Die."
msgstr ""

#. ja: コロセ！　コロセ！
#. de: Töten! Töten!
#. fr: Tuer<nbsp>! Tuer<nbsp>!
msgctxt "NpcYell:9336:0:13"
msgid "Kill. Kill."
msgstr ""

#. ja: ブッコロス！<br>ブッコロス！
#. de: Gemetzel! Töten!
#. fr: Massacrer<nbsp>! Massacrer<nbsp>!
msgctxt "NpcYell:9337:0:13"
msgid "Cut. Tear. Slaughter."
msgstr ""

#. ja: ウワァァァー！
#. de: Uaaa-a-a<nbsp>...
#. fr: Uwaaah<nbsp>!
msgctxt "NpcYell:9338:0:13"
msgid "\\<clank>"
msgstr ""

#. ja: ギャアァァー！
#. de: Aaaaah!
#. fr: Gyaaah<nbsp>!
msgctxt "NpcYell:9339:0:13"
msgid "\\<thunk>"
msgstr ""

#. ja: ウガガガ…！
#. de: Au. Au. Auauauau<nbsp>...
#. fr: Ugagaaah<nbsp>!
msgctxt "NpcYell:9340:0:13"
msgid "Ow. Ow."
msgstr ""

#. ja: 目標ヲ排除スル！
#. de: Ziel erfasst! Ziel vernichten!
#. fr: Éliminer les cibles<nbsp>!
msgctxt "NpcYell:9341:0:13"
msgid "Target. Kill target."
msgstr ""

#. ja: 敵ヲ発見！
#. de: Feinde! Töten!
#. fr: Ennemis repérés<nbsp>!
msgctxt "NpcYell:9342:0:13"
msgid "Intruders sighted."
msgstr ""

#. ja: 苦シイ…苦シイ…
#. de: Schmerz<nbsp>... Schmeeerz<nbsp>...
#. fr: J'ai mal... J'ai mal...
msgctxt "NpcYell:9343:0:13"
msgid "Stop. Stop."
msgstr ""

#. ja: コノママジャ、ダメ…
#. de: Das. Geht. So. Nicht. Weiter.
#. fr: Ce n'est pas bon... Ce n'est pas bon...
msgctxt "NpcYell:9344:0:13"
msgid "This is it..."
msgstr ""

#. ja: コロス…コロス…
#. de: Tö<nbsp>...ten! Tö<nbsp>...ten!
#. fr: Tuer... Tuer...
msgctxt "NpcYell:9345:0:13"
msgid "Kill... Kill..."
msgstr ""

#. ja: 生キテ、帰サナイ…
#. de: KeiN ENtkoMmEN<nbsp>...
#. fr: Rentrer à la maison...
msgctxt "NpcYell:9346:0:13"
msgid "You die here."
msgstr ""

#. ja: 行き止まりか？
#. de: Eine Sackgasse?
#. fr: Un cul-de-sac<nbsp>?
msgctxt "NpcYell:9347:0:13"
msgid "A dead end?"
msgstr ""

#. ja: うわ、こんなところを<br>通るのかよ！
#. de: Was, <i>hier</i> sollen wir rein?!
#. fr: Par là, vraiment<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9348:0:13"
msgid "I don't like the<br>looks of that."
msgstr ""

#. ja: なんだか<br>嫌な予感がする…
#. de: Ich hab ein ganz schlechtes Gefühl<nbsp>...
#. fr: Je le sens mal...
msgctxt "NpcYell:9349:0:13"
msgid "Hmm... Yes..."
msgstr ""

#. ja: さ、先に行ってくれ…
#. de: G-Geht vor, wir decken euch den Rücken<nbsp>...
#. fr: P-passez devant.
msgctxt "NpcYell:9350:0:13"
msgid "Ladies first!"
msgstr ""

#. ja: …妙だな<br>静かすぎる…
#. de: Es ist verdächtig still<nbsp>...
#. fr: C'est trop calme...
msgctxt "NpcYell:9351:0:13"
msgid "It's too quiet."
msgstr ""

#. ja: やれやれ…<br>どこまで続いているんだ？
#. de: Bei meinem Bart, wie gigantisch diese Ruinen sind!
#. fr: Ces galeries n'en finissent pas...
msgctxt "NpcYell:9352:0:13"
msgid "How deep does this go?"
msgstr ""

#. ja: 見たことがない物ばかりだ…
#. de: Als wären wir in einer anderen Welt<nbsp>...
#. fr: J'ai jamais rien vu de tel...
msgctxt "NpcYell:9353:0:13"
msgid "I've never seen the like..."
msgstr ""

#. ja: 侵入者、発見…<br>攻撃開始…！
#. de: Eindringlinge erfasst. Initiiere Gefecht.
#. fr: Ennemis repérés. Début de l'offensive.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9354:0:13"
msgid "Intruders.<br>Prepare yourselves."
msgstr ""

#. ja: 支援要請…支援要請！
#. de: Verstärkung! Verstärkung!
#. fr: Demande de renforts<nbsp>! Demande de renforts<nbsp>!
msgctxt "NpcYell:9355:0:13"
msgid "Help. Help. Someone..."
msgstr ""

#. ja: 緊急事態…<br>緊急事態…！
#. de: Notfall! Alarm! Notfall!
#. fr: Alerte<nbsp>! Alerte<nbsp>!
msgctxt "NpcYell:9356:0:13"
msgid "Emergency. Emergency."
msgstr ""

#. ja: 侵入者、排除…<br>失敗…
#. de: Eliminierung<nbsp>... fehlgeSChlAgeN<nbsp>...
#. fr: Échec de l'élimination de l'ennemi...
msgctxt "NpcYell:9357:0:13"
msgid "Mission...failed..."
msgstr ""

#. ja: ウアァァ…！
#. de: Aaaaah!
#. fr: Uwaaah<nbsp>!
msgctxt "NpcYell:9358:0:13"
msgid "\\<clank>"
msgstr ""

#. ja: グアアァァァ…！
#. de: Neeeeeeein!
#. fr: Guaaaah<nbsp>!
msgctxt "NpcYell:9359:0:13"
msgid "\\<thunk>"
msgstr ""

#. ja: シニタクナイ…<br>シニタクナイ…！
#. de: Will<nbsp>... nicht<nbsp>... sterben!
#. fr: Je ne veux pas mourir<nbsp>! Je ne veux pas mourir<nbsp>!
msgctxt "NpcYell:9360:0:13"
msgid "Don't kill me... Don't kill me..."
msgstr ""

#. ja: わかった…！<br>追いかけるぞ！
#. de: Los, hinterheeer!
#. fr: Vite, à ses trousses<nbsp>!
msgctxt "NpcYell:9361:0:13"
msgid "Come on!"
msgstr ""

#. ja: 急ぐぞ～！
#. de: Nichts wie los!
#. fr: Allons-y<nbsp>!
msgctxt "NpcYell:9362:0:13"
msgid "Hurry!"
msgstr ""

#. ja: この白い粉はなんだろう……。<br>空から降ってきている……？
#. de: Was ist dieses weiße Puderzeug? Fällt das etwa vom Himmel<nbsp>...?
#. fr: 0
msgctxt "NpcYell:9363:0:13"
msgid "0"
msgstr ""

#. ja: 何かの粉塵が、この階層全体に舞い上がっているようだな。
#. de: Die ganze Fabrik scheint komplett davon bedeckt zu sein!
#. fr: 0
msgctxt "NpcYell:9364:0:13"
msgid "0"
msgstr ""

#. ja: なんだ、あのデカブツ！
#. de: Woah, was ist <i>das</i> denn für ein riesen Brocken?
#. fr: C'est quoi ce gros tas de ferraille<nbsp>!?
msgctxt "NpcYell:9365:0:13"
msgid "It's enormous!"
msgstr ""

#. ja: あれも機械生命体…？
#. de: I-Ist das auch ein Maschinenwesen?
#. fr: C'est une forme de vie mécanique, ça aussi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9366:0:13"
msgid "Does that count<br>as a machine lifeform?"
msgstr ""

#. ja: ここから登れそうだ！
#. de: Guckt, hier kommt man hoch!
#. fr: On peut grimper dessus à partir d'ici.
msgctxt "NpcYell:9367:0:13"
msgid "Found the way up!"
msgstr ""

#. ja: さあ、遠慮なく<br>ポッドを使うがいい！
#. de: Jetzt gibt's kein Zurück! Schnappt euch einen Pod!
#. fr: C'est reparti pour un tour...
msgctxt "NpcYell:9368:0:13"
msgid "You can go first."
msgstr ""

#. ja: ガガッ…ガ…<br>自…爆ユニット…強制起…動。
#. de: SelBStZerSTö<nbsp>...rUNgsmoDuL akTi<nbsp>...VIert<nbsp>...
#. fr: Agagag... Activation forcée... de l'unité kamikaze<nbsp>!
msgctxt "NpcYell:9369:0:13"
msgid "Acti...vating...unit..."
msgstr ""

#. ja: マモル、マモル…
#. de: Beschützen. Beschützen.
#. fr: Protéger... Protéger...
msgctxt "NpcYell:9370:0:13"
msgid "Fight. Protect."
msgstr ""

#. ja: ハイジョ…ハイジョ…
#. de: Eliminieren. Eliminieren.
#. fr: Éliminer... Éliminer...
msgctxt "NpcYell:9371:0:13"
msgid "Fight. Destroy."
msgstr ""

#. ja: ケイカイ…ケイカイ…
#. de: Achtung. Achtung.
#. fr: Attention... Attention...
msgctxt "NpcYell:9372:0:13"
msgid "Be careful. Careful."
msgstr ""

#. ja: ブオォォォ！
#. de: Wuaaah!
#. fr: Mouoooooh<nbsp>!!
msgctxt "NpcYell:9373:0:13"
msgid "Grrroooaaaaaaaaahhh!!!"
msgstr ""

#. ja: 魔法で浮遊しているのか？
#. de: Der Magier scheint es ernst zu meinen.
#. fr: Il utilise un sort de lévitation<nbsp>?
msgctxt "NpcYell:9374:0:13"
msgid "Was...was that the mage we seek?"
msgstr ""

#. ja: 館の主は<br>ご機嫌ナナメのようね
#. de: Der Herr des Hauses scheint etwas verstimmt zu sein.
#. fr: Le locataire des lieux n'a pas l'air content de nous voir...
msgctxt "NpcYell:9375:0:13"
msgid "I have a bad feeling about this."
msgstr ""

#. ja: 歓迎の意志は<br>ないようね…
#. de: Gastfreundlich ist anders.
#. fr: J'aurais préféré un accueil un peu plus aimable...
msgctxt "NpcYell:9376:0:13"
msgid "A rather ominous welcome..."
msgstr ""

#. ja: 前回の訪問と<br>同じ展開になりそうだ…
#. de: Es ist genau wie bei meinem letzten Besuch.
#. fr: Tout se déroule comme lors de ma précédente visite.
msgctxt "NpcYell:9377:0:13"
msgid "Well, I'd say we're off to a fine start."
msgstr ""

#. ja: あのホウキ、マトーヤ様の<br>使い魔に似ているな…
#. de: Diese Besen sehen genau aus wie die in Matoyas Höhle.
#. fr: Ces balais ressemblent à s'y méprendre à ceux de Matoya...
msgctxt "NpcYell:9378:0:13"
msgid "Do those brooms not remind you of Master Matoya?"
msgstr ""

#. ja: 勝手に掃除してくれる<br>ホウキ、ちょっと欲しいかも…
#. de: Tataru hätte bestimmt gerne einen dieser Feger für den Sonnenstein.
#. fr: Des balais qui font le ménage tout seuls<nbsp>? Je veux les mêmes à la maison<nbsp>!
msgctxt "NpcYell:9379:0:13"
msgid "Magicked brooms? Now where have I seen these before?"
msgstr ""

#. ja: なんだか<br>デジャヴュを感じるわ…
#. de: Besen. Wo habe ich das nur schon mal gesehen? \<seufz>
#. fr: J'ai comme une impression de déjà-vu...
msgctxt "NpcYell:9380:0:13"
msgid "Magicked brooms... How nostalgic."
msgstr ""

#. ja: 館の主は<br>きれい好きのようだな
#. de: Sauberkeit scheint dem Nu Mou sehr wichtig zu sein.
#. fr: Notre Nu Mou est un vrai maniaque de la propreté<nbsp>!
msgctxt "NpcYell:9381:0:13"
msgid "An...unexpected respite from battle."
msgstr ""

#. ja: 見事な庭園だ…！
#. de: Was für ein prächtiger Garten!
#. fr: Ce jardin est absolument somptueux<nbsp>!
msgctxt "NpcYell:9382:0:13"
msgid "It's beautiful!"
msgstr ""

#. ja: どうせこの庭にも<br>罠があるんでしょ？
#. de: Jede Wette, hier sind wir genauso ungebetene Gäste wie in dem Schloss.
#. fr: Ce n'est pas parce que c'est beau que nous y sommes en sécurité...
msgctxt "NpcYell:9383:0:13"
msgid "It has to be a trap... It's always a trap."
msgstr ""

#. ja: 魔物や使い魔の<br>気配を感じるわ…
#. de: Seid auf der Hut. Ich spüre etwas.
#. fr: Je sens la présence de monstres et de familiers dans tous les coins...
msgctxt "NpcYell:9384:0:13"
msgid "I sense a malign magic in the air."
msgstr ""

#. ja: エルフ文化が誇る<br>迷宮庭園だ…
#. de: Die elfischen Gartenbauer hatten eine Vorliebe für gerade Linien und rechte Winkel.
#. fr: Voilà un jardin labyrinthique comme les Elfes les affectionnaient.
msgctxt "NpcYell:9385:0:13"
msgid "Her Grace's gardens. As beautiful as ever."
msgstr ""

#. ja: こ、これは…<br>まさか…いや、幻影か…！
#. de: Ist das eine Halluzination oder echt?
#. fr: Serait-ce... une hallucination<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9386:0:13"
msgid "\\<gasp> Gh-Gh-Ghosts!?<br>...No? Oh, thank the gods."
msgstr ""

#. ja: お食事中失礼します…<br>なんてね！
#. de: Wir stören ja ungern beim Essen, aber wir haben hier was zu erledigen.
#. fr: Désolée de vous déranger en plein repas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9387:0:13"
msgid "I almost feel bad interrupting their meal.<br>Even if they are only illusions."
msgstr ""

#. ja: 幻の同居人だなんて<br>寂しがり屋なのね？
#. de: Vielleicht fühlt der Einsiedler sich ja doch etwas einsam<nbsp>...
#. fr: Cet ermite doit se sentir bien seul, au fond...
msgctxt "NpcYell:9388:0:13"
msgid "I can but wonder how lonely they must be."
msgstr ""

#. ja: 実に高度な<br>幻体操作術だ…
#. de: Die Illusionszauber sind von sehr hoher Qualität.
#. fr: Ces illusions sont l'image parfaite de la réalité d'autrefois...
msgctxt "NpcYell:9389:0:13"
msgid "Their mastery of illusions is impressive."
msgstr ""

#. ja: あれは幻影…<br>そう、幻なんだッ…！
#. de: Das ist jetzt aber ganz sicher eine Illusion. Oder doch nicht?
#. fr: Ne vous laissez pas berner, ce ne sont que des illusions<nbsp>!
msgctxt "NpcYell:9390:0:13"
msgid "Keep it together, Alphinaud. They're only illusions..."
msgstr ""

#. ja: ダンスって苦手…<br>作法が多すぎるのよ
#. de: Eigentlich hübsch, so ein Ball. Ich würde gerne mal einen echten besuchen.
#. fr: La danse, c'est trop raffiné pour moi<nbsp>!
msgctxt "NpcYell:9391:0:13"
msgid "Wonderful, more illusions. And now they're dancing this time."
msgstr ""

#. ja: ところで、あなたは<br>ダンスは踊れて？
#. de: Sagt mal, könnt ihr eigentlich tanzen?
#. fr: Vous savez danser, vous autres<nbsp>? Peut-être que je devrais m'y mettre...
msgctxt "NpcYell:9392:0:13"
msgid "An eerie yet beautiful sight, is it not?"
msgstr ""

#. ja: まるで在りし日の宮廷を<br>切り取ったかのようだ…
#. de: Genau so kann man sich das Leben am königlichen Hofe vorstellen.
#. fr: C'est comme si nous avions fait un bond de cent ans dans le passé...
msgctxt "NpcYell:9393:0:13"
msgid "It's as if we're glimpsing into the past."
msgstr ""

#. ja: 隠者殿…！<br>どうか話を…！
#. de: Bitte, Magier! Wir haben etwas Wichtiges mit dir zu besprechen!
#. fr: Écoutez-nous<nbsp>! Nous ne sommes pas vos ennemis<nbsp>!
msgctxt "NpcYell:9394:0:13"
msgid "Please! We did not come to fight!"
msgstr ""

#. ja: 話を聞いてくれるって<br>感じじゃなさそうね…
#. de: Er verteidigt seine Ruhe wirklich mit allen Mitteln.
#. fr: Il n'a pas l'air d'être ouvert au dialogue...
msgctxt "NpcYell:9395:0:13"
msgid "Well, so much for the diplomatic approach."
msgstr ""

#. ja: 危険な魔力を感じる…<br>気を抜かないで…
#. de: Ich spüre einen gefährlichen Zauber. Macht euch bereit!
#. fr: Restez sur vos gardes<nbsp>! Je sens une énergie magique redoutable...
msgctxt "NpcYell:9396:0:13"
msgid "On your guard!"
msgstr ""

#. ja: やれやれ、荒っぽい<br>交渉が始まりそうだ…
#. de: Oje, die Sache entpuppt sich als noch schwieriger, als ich dachte.
#. fr: Ces négociations risquent d'être musclées...
msgctxt "NpcYell:9397:0:13"
msgid "Oh dear. They don't yet seem inclined to talk."
msgstr ""

#. ja: 待ってくれ…！<br>話をしたいだけなんだ！
#. de: Warte! Wir wollen nur mit dir reden!
#. fr: Arrêtez<nbsp>! Nous sommes simplement venus discuter<nbsp>!
msgctxt "NpcYell:9398:0:13"
msgid "Wait! We only wish to talk!"
msgstr ""

#. ja: もう！<br>ちょっと待ちなさいよ！
#. de: He! Geht das denn nicht freundlicher?
#. fr: Eh oh<nbsp>! Vous allez vous calmer, oui<nbsp>!?
msgctxt "NpcYell:9399:0:13"
msgid "I knew this was a bad idea."
msgstr ""

#. ja: 倒し切るわけには<br>いかないものね…
#. de: Ohne zu kämpfen scheint es nicht zu gehen.
#. fr: Ce combat était pour le moins... spécial<nbsp>!
msgctxt "NpcYell:9400:0:13"
msgid "Not exactly a good first impression, but it will have to suffice."
msgstr ""

#. ja: まだ先方には<br>手札があるらしい…
#. de: Unser Gastgeber hat sich gut verschanzt.
#. fr: Notre hôte a plus d'un tour dans son sac...
msgctxt "NpcYell:9401:0:13"
msgid "I doubt they will be quite so affable when next we meet."
msgstr ""

#. ja: 隠者殿を追うには<br>倒す必要がある、か…
#. de: Wenn wir mit dem Nu Mou sprechen wollen, haben wir wohl keine andere Wahl als zu kämpfen.
#. fr: Si nous voulons débusquer l'ermite, nous n'avons pas le choix.
msgctxt "NpcYell:9402:0:13"
msgid "Is there no end to these creatures?"
msgstr ""

#. ja: また邪魔者の登場…<br>ってことかしら？
#. de: Noch ein Hindernis? Meinetwegen!
#. fr: Encore un obstacle sur notre chemin<nbsp>? Pas grave<nbsp>!
msgctxt "NpcYell:9403:0:13"
msgid "Another chance to garner their interest."
msgstr ""

#. ja: 擬態型移動性植物を<br>使い魔にしているのね？
#. de: Was für ein Familiar ist denn das? Eine pflanzliche Chimäre? Sehr originell.
#. fr: Un hybride d'humaine et de plante en guise de familier<nbsp>? Pourquoi pas...
msgctxt "NpcYell:9404:0:13"
msgid "They certainly have a gift for creating familiars. If only there were not so many..."
msgstr ""

#. ja: 遠目にはトピアリーに<br>見えたが、あれは…
#. de: Von Weitem hab ich das für ein Stück Gartenkunst gehalten.
#. fr: De loin, on aurait dit de l'art topiaire...
msgctxt "NpcYell:9405:0:13"
msgid "I had hoped it was only a topiary. Alas..."
msgstr ""

#. ja: 薪運びは得意だが<br>種運びとはね…
#. de: Gartenarbeit ist mir zuwider.
#. fr: Je veux bien ramasser des branches à l'occasion, mais pas des graines aussi grosses...
msgctxt "NpcYell:9406:0:13"
msgid "Mayhap now we have sown the seeds of interest."
msgstr ""

#. ja: 面倒な敵だったわね…
#. de: Ziemlich aufdringlich, dieses liebestolle Grünzeug.
#. fr: Eh bien dites donc... Bon débarras<nbsp>!
msgctxt "NpcYell:9407:0:13"
msgid "Well, I'd rather not have to do that again..."
msgstr ""

#. ja: 庭師になった覚えは<br>なかったのだけれど…
#. de: Die Freiheit des Großen Waldes war mir lieber als dieser mit dem Lineal gezogene Garten.
#. fr: Je ne m'attendais pas à recevoir des leçons de jardinage...
msgctxt "NpcYell:9408:0:13"
msgid "I've had my fill of this garden. Let us move on."
msgstr ""

#. ja: このまま勝ち続ければ<br>隠者殿の態度も変わるだろう
#. de: Es würde mich wundern, wenn wir nicht schon seine Neugierde geweckt hätten.
#. fr: Continuons comme ça, et nous arriverons peut-être à faire changer d'avis l'ermite.
msgctxt "NpcYell:9409:0:13"
msgid "Perhaps now they see us as more than mere intruders."
msgstr ""

#. ja: なんという熱気だッ…！
#. de: Aua! Was für ein hitziges Gemüt!
#. fr: Ouah<nbsp>! Qu'est-ce qu'il fait chaud, tout à coup<nbsp>!
msgctxt "NpcYell:9410:0:13"
msgid "By the gods, they've given life to flame!"
msgstr ""

#. ja: くっ…上等じゃない！<br>負けてられないんだから！
#. de: Nicht schlecht, aber wir haben schon ganz andere besiegt.
#. fr: Pas mal, mais il en faut plus que ça pour nous impressionner<nbsp>!
msgctxt "NpcYell:9411:0:13"
msgid "Looks like they're finally taking us seriously."
msgstr ""

#. ja: このエーテルの輝き…<br>ただの炎ではなくてよ！
#. de: Das sind keine normalen Flammen. Ich sehe es am Leuchten des Äthers.
#. fr: La lumière de son éther... Ce n'est pas celle d'une simple flamme<nbsp>!
msgctxt "NpcYell:9412:0:13"
msgid "Have care. There's something peculiar about those flames."
msgstr ""

#. ja: 隠者殿の特製品か…<br>ならば、これを倒して…！
#. de: Er hat sich das stärkste Familiar fürs Ende aufgehoben. Ein Sieg noch, und dann<nbsp>...
#. fr: Voilà donc la botte secrète de l'ermite... À nous de la vaincre<nbsp>!
msgctxt "NpcYell:9413:0:13"
msgid "I do believe we now have not only their curiosity, but their attention as well."
msgstr ""

#. ja: いっくぞ～！
#. de: Los geht's!
#. fr: On y va<nbsp>! Grouik<nbsp>!
msgctxt "NpcYell:9414:0:13"
msgid "Here I go!"
msgstr ""

#. ja: ゼェ…ゼェ…<br>た、助かった…！
#. de: Puh, das war knapp. Danke!
#. fr: S-sauvé<nbsp>!
msgctxt "NpcYell:9415:0:13"
msgid "Whew... My thanks!"
msgstr ""

#. ja: ううっ…羽がびしょ濡れ…<br>出してくれてありがと！
#. de: Meine Flügel sind ganz nass!
#. fr: M-merci<nbsp>! Beurk... J'en ai plein sur les ailes<nbsp>!
msgctxt "NpcYell:9416:0:13"
msgid "Ugh, my wings are drenched!"
msgstr ""

#. ja: いや…いや…<br>もう力を使いたくない…
#. de: N-Nein, bitte! Ich will diese Macht nicht mehr! \<schluchz>
#. fr: J'en ai assez de ces pouvoirs... J'en veux plus...
msgctxt "NpcYell:9417:0:13"
msgid "\\<sob> Please... I don't want to use this power anymore..."
msgstr ""

#. ja: うう…私…私は…<br>独りぼっち…
#. de: Ich<nbsp>... ich bin so alleine<nbsp>... \<schnief>
#. fr: Y a aucune place pour moi dans ce monde...
msgctxt "NpcYell:9418:0:13"
msgid "\\<sob> I have no place in the world..."
msgstr ""

#. ja: こりゃ、とんでもねぇ<br>コトになりやがった…！
#. de: Es ist außer Rand und Band!
#. fr: On est dans le mochi jusqu'au cou...
msgctxt "NpcYell:9419:0:13"
msgid "By the kami!"
msgstr ""

#. ja: 落ち着いてくれ～！
#. de: Ruuuhig!
#. fr: Calme-toi<nbsp>!!!
msgctxt "NpcYell:9420:0:13"
msgid "Easy now, Gozu."
msgstr ""

#. ja: ンモォ～！
#. de: Muuuh!
#. fr: Meuuuh<nbsp>!!!
msgctxt "NpcYell:9421:0:13"
msgid "Groooaaar!"
msgstr ""

#. ja: よーしよし<br>落ち着いてくれよ～！
#. de: So beruhige dich doch!
#. fr: Tout doux, tout doux<nbsp>!
msgctxt "NpcYell:9422:0:13"
msgid "There, there. Everything is fine, now."
msgstr ""

#. ja: 正気を取り戻したみてぇだな…<br>さぁ、帰るとするぞ？
#. de: Er scheint wieder zur Vernunft gekommen zu sein. Puh ... Lasst uns zurückkehren!
#. fr: Bon on dirait qu'il s'est enfin calmé... On rentre<nbsp>?
msgctxt "NpcYell:9423:0:13"
msgid "I see no further signs of wayward mochi about. Let us return to Limsa Lominsa for now."
msgstr ""

#. ja: 手がつけられねぇ…<br>一旦退くぞ！
#. de: Die Sache gerät außer Kontrolle! Wir sollten uns zurückziehen!
#. fr: C'est inutile, il vaut mieux s'écarter<nbsp>!
msgctxt "NpcYell:9424:0:13"
msgid "I fear this is too much for us. Fall back!"
msgstr ""

#. ja: 動く餅さえ<br>切り分けられれば…
#. de: Wir müssen das Mochi zerteilen!
#. fr: Il faut couper le monstre de mochi en morceaux<nbsp>!
msgctxt "NpcYell:9425:0:13"
msgid "Is there no end to this blasted mochi?"
msgstr ""

#. ja: 後生だから<br>ゴズは傷つけねぇでくれ！
#. de: Bitte, tu dem Gozu nicht weh!
#. fr: Attention à ne pas blesser le gozu, il n'y est pour rien<nbsp>!
msgctxt "NpcYell:9426:0:13"
msgid "Careful! No harm must come to Gozu!"
msgstr ""

#. ja: 錯乱してるゴズの一撃にゃ<br>気をつけてくれよ！
#. de: Nimm dich vor den Hörnern des Gozu in Acht!
#. fr: Attention aux coups de marteau du gozu<nbsp>!
msgctxt "NpcYell:9427:0:13"
msgid "Be sure to stand clear of Gozu!"
msgstr ""

#. ja: そぉ～ら！<br>もういっちょ、暴れてみようぜ～！
#. de: Beeindruckt? Wir legen gleich noch einen drauf!
#. fr: Toute une forêt de bambou ne suffirait pas à stopper ma lame<nbsp>!
msgctxt "NpcYell:9428:0:13"
msgid "Foolish bamboo! You dare to face my blade!?"
msgstr ""

#. ja: そぉ～れ！<br>こいつを、見極められるかな？
#. de: Können die Herausforderer noch folgen? Es ist nicht leicht!
#. fr: Et que dis-tu de ça<nbsp>!
msgctxt "NpcYell:9429:0:13"
msgid "Let the bamboo fall where it may!"
msgstr ""

#. ja: ニャーン♪
#. de: Miau!
#. fr: Miaou<nbsp>!♪
msgctxt "NpcYell:9430:0:13"
msgid "Meow!♪"
msgstr ""

#. ja: ゴロニャーン♪
#. de: Miau ... \<schnurr>
#. fr: Rrrr... Miaou<nbsp>!♪
msgctxt "NpcYell:9431:0:13"
msgid "Meow! Purrrrrr...♪"
msgstr ""

#. ja: ゲホゲホ……身体に悪いものじゃないといいけど……。
#. de: 0
#. fr: 0
msgctxt "NpcYell:9432:0:13"
msgid "0"
msgstr ""

#. ja: 前回の訪問と<br>同じ展開になりそうだ…
#. de: Es ist genau wie bei meinem letzten Besuch.
#. fr: Tout se déroule comme lors de ma précédente visite.
msgctxt "NpcYell:9433:0:13"
msgid "Well, I'd say we're off to a fine start."
msgstr ""

#. ja: 障害は<br>排除するのみよ！
#. de: Hindernisse sind dafür da, aus dem Weg geräumt zu werden.
#. fr: Les obstacles sont faits pour être surmontés<nbsp>!
msgctxt "NpcYell:9434:0:13"
msgid "Perhaps. But how long our good fortune holds remains to be seen."
msgstr ""

#. ja: なんだか<br>デジャヴュを感じるわ…
#. de: Besen. Wo habe ich das nur schon mal gesehen? \<seufz>
#. fr: J'ai comme une impression de déjà-vu...
msgctxt "NpcYell:9435:0:13"
msgid "How quaint. They remind me of Master Matoya's brooms."
msgstr ""

#. ja: あのホウキ…<br>マトーヤ様の洞窟で…
#. de: Sind das nicht die Besen aus Matoyas Höhle?
#. fr: Ces balais... Ce ne serait pas les mêmes que dans la grotte de Matoya<nbsp>?
msgctxt "NpcYell:9436:0:13"
msgid "You and I remember those brooms─and their owner─quite differently."
msgstr ""

#. ja: やれやれ、荒っぽい<br>交渉が始まりそうだ…
#. de: Oje, die Sache entpuppt sich als noch schwieriger, als ich dachte.
#. fr: Ces négociations risquent d'être musclées...
msgctxt "NpcYell:9437:0:13"
msgid "Oh dear. They don't yet seem inclined to talk."
msgstr ""

#. ja: そういうの得意だから<br>任せてちょうだい
#. de: Mit dem werde ich fertig.
#. fr: Laissez-moi faire, je m'en occupe<nbsp>!
msgctxt "NpcYell:9438:0:13"
msgid "Well, it was your idea to brandish blades at the door."
msgstr ""

#. ja: まだ先方には<br>手札があるらしい…
#. de: Unser Gastgeber hat sich gut verschanzt.
#. fr: Notre hôte a plus d'un tour dans son sac...
msgctxt "NpcYell:9439:0:13"
msgid "I doubt they will be quite so affable when next we meet."
msgstr ""

#. ja: あっちがその気なら<br>やってやるだけよ…！
#. de: Wir werden den Einsiedler schon noch aufspüren.
#. fr: Puisque c'est comme ça, nous n'avons plus qu'à lui rendre la monnaie de sa pièce<nbsp>!
msgctxt "NpcYell:9440:0:13"
msgid "Another chance to pique their curiosity, then."
msgstr ""

#. ja: エルフ文化が誇る<br>迷宮庭園だ…
#. de: Die Elfen waren stolz auf ihre Gartenlabyrinthe.
#. fr: Voilà un jardin labyrinthique comme les Elfes les affectionnaient.
msgctxt "NpcYell:9441:0:13"
msgid "Her Grace's gardens. As beautiful as ever."
msgstr ""

#. ja: 通路が魔法学的な<br>配置になっているわね
#. de: Die Wege sind nach einem bestimmten, magischen Plan angelegt.
#. fr: Ce passage sent l'énergie magique à plein nez...
msgctxt "NpcYell:9442:0:13"
msgid "The path makes a curious pattern. Not unlike a magicked circle."
msgstr ""

#. ja: 隠者殿を追うには<br>倒す必要がある、か…
#. de: Wenn wir mit dem Nu Mou sprechen wollen, haben wir wohl keine andere Wahl als zu kämpfen.
#. fr: Si nous voulons débusquer l'ermite, nous n'avons pas le choix.
msgctxt "NpcYell:9443:0:13"
msgid "Is there no end to these creatures?"
msgstr ""

#. ja: 邪魔な草は<br>刈り倒すだけよ…！
#. de: Unkraut muss man jäten.
#. fr: Éliminez-moi ces mauvaises herbes<nbsp>!
msgctxt "NpcYell:9444:0:13"
msgid "If they think a few plants can slow us down, they're sorely mistaken."
msgstr ""

#. ja: 乾燥させれば<br>良い薪になりそうだ…
#. de: Ich mag meine Gartenpflanzen eher weniger beseelt.
#. fr: Une fois séchées, ces branches pourraient servir à nouveau...
msgctxt "NpcYell:9445:0:13"
msgid "If we dried these leaves... Perhaps we could use them for tea!"
msgstr ""

#. ja: ちょっとアルフィノ…<br>奥に進むわよ！
#. de: Alphinaud! Weiter!
#. fr: Eh, Alphinaud<nbsp>! C'est par ici que ça se passe<nbsp>!
msgctxt "NpcYell:9446:0:13"
msgid "...Why are you like this?"
msgstr ""

#. ja: こ、これは…<br>まさか…！？
#. de: Sind das etwa G-G-Gei...?
#. fr: Que... Qu'est-ce que c'est<nbsp>!?
msgctxt "NpcYell:9447:0:13"
msgid "\\<gasp> Gh-Gh-Ghosts!?"
msgstr ""

#. ja: 幽霊だとでも思ったわけ？
#. de: Guck mal, Alphinaud, <i>Geister</i>!
#. fr: Bah alors<nbsp>? T'as vu un fantôme ou quoi<nbsp>?
msgctxt "NpcYell:9448:0:13"
msgid "Oh come now, Alphinaud. Don't be silly."
msgstr ""

#. ja: きゃあ、幽霊よ～！
#. de: Huibuh!
#. fr: Kyaaah<nbsp>!! Des fantôôômes<nbsp>!!
msgctxt "NpcYell:9449:0:13"
msgid "Ahhh! Alphinaud, behind you!"
msgstr ""

#. ja: 冗談はよしてくれ…<br>あれは幻影…幻なんだッ…！
#. de: Lass die Witze. Ich hab's begriffen. Es sind nur Illusionen.
#. fr: Calme-toi, ce ne sont que des illusions...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9450:0:13"
msgid "Haha, very funny. I know they're not ghosts.<br>...At least I hope they're not."
msgstr ""

#. ja: 隠者殿の特製品か…<br>ならば、これを倒して…！
#. de: Er hat sich das stärkste Familiar fürs Ende aufgehoben. Ein Sieg noch, und dann<nbsp>...
#. fr: Voilà donc la botte secrète de l'ermite... À nous de la vaincre<nbsp>!
msgctxt "NpcYell:9451:0:13"
msgid "I do believe we now have not only their curiosity, but their attention as well."
msgstr ""

#. ja: ええ、是が非でも<br>話を聞いてもらいましょう
#. de: Du brauchst uns nur anzuhören, mehr wollen wir nicht.
#. fr: Espérons que l'ermite acceptera de nous écouter au final...
msgctxt "NpcYell:9452:0:13"
msgid "Then we had best not waste it."
msgstr ""

#. ja: 今こそ我らの真の力を<br>見せるときぞ！
#. de: Jetzt zeigen wir euch, wie die Helden der Elfen kämpfen!
#. fr: Éprouvez la puissance des chevaliers de Grand-Lac<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9453:0:13"
msgid "The chivalric spirit<br>shall prevail this day!"
msgstr ""

#. ja: ミンチにしてやる！
#. de: Ich mach euch zu Hackfleisch!
#. fr: Je vais vous découper en tranches<nbsp>!
msgctxt "NpcYell:9454:0:13"
msgid "Taste mine axe!"
msgstr ""

#. ja: 魔力よ降り注げ！
#. de: Mächte zwischen Himmel und Erde, ich rufe euch!
#. fr: Vous n'êtes pas de taille face à mes sorts<nbsp>!
msgctxt "NpcYell:9455:0:13"
msgid "Know your folly!"
msgstr ""

#. ja: この一矢を総長に捧ぐ！
#. de: Diesen Pfeil widme ich dem König der Elfen!
#. fr: Mes flèches vont vous transpercer le cœur<nbsp>!
msgctxt "NpcYell:9456:0:13"
msgid "We must drive them out!"
msgstr ""

#. ja: ブッ刺しちまうぞ？
#. de: Ich klatsch euch weg!
#. fr: Vous finirez empalés sur ma lance<nbsp>!
msgctxt "NpcYell:9457:0:13"
msgid "Have at thee!"
msgstr ""

#. ja: 突き殺してやる！
#. de: Tod! Tod allen Feinden!
#. fr: Vous allez sentir passer ma lame<nbsp>!
msgctxt "NpcYell:9458:0:13"
msgid "I have you!"
msgstr ""

#. ja: 震えるがいい！
#. de: Zittert und fürchtet euch!
#. fr: Tremblez, mauviettes<nbsp>!
msgctxt "NpcYell:9459:0:13"
msgid "Begone with you!"
msgstr ""

#. ja: 仕方あるまい…
#. de: Was für ein tragisches Ende<nbsp>...
#. fr: Quelle tragédie...
msgctxt "NpcYell:9460:0:13"
msgid "This cannot be..."
msgstr ""

#. ja: レイクランドよ<br>永遠に…！
#. de: Lang lebe das Seenland!
#. fr: Longue vie à Grand-Lac<nbsp>!
msgctxt "NpcYell:9461:0:13"
msgid "For Lakeland!"
msgstr ""

#. ja: すべてのエルフのために…！
#. de: Lang lebe das Geschlecht der Elfen!
#. fr: Longue vie aux Elfes<nbsp>!
msgctxt "NpcYell:9462:0:13"
msgid "The elves shall prevail!"
msgstr ""

#. ja: これで終わりだ…！
#. de: Das ist das Ende ...
#. fr: C'est terminé<nbsp>!
msgctxt "NpcYell:9463:0:13"
msgid "And now you fall!"
msgstr ""

#. ja: よおし、みんなの活躍で、そろそろ完成だ！<br>作業を終えた者から休んでくれ！
#. de: Hervorragend! Die Arbeiten sind so gut wie abgeschlossen.<br>Ihr habt euch alle eine Ruhepause verdient.
#. fr: C'est du bon boulot, on y est presque<nbsp>! Ceux qui en ont fini, reposez-vous bien<nbsp>!
msgctxt "NpcYell:9464:0:13"
msgid "Excellent, the work's just about done! You've all earned a good rest!"
msgstr ""

#. ja: あの武具…<br>手がかりになりませんか？
#. de: Diese Waffen da ... Vielleicht helfen sie ihm auf die Sprünge.
#. fr: Ces armes... Elles évoqueront peut-être un souvenir à maître Cid, qui sait<nbsp>?
msgctxt "NpcYell:9465:0:13"
msgid "Save for these weapons there's naught to be found here."
msgstr ""

#. ja: 見つけた手がかりを<br>シドさんに伝えましょう！
#. de: Komm, zurück zu Cid!
#. fr: <split " " 1><string $gs1></split><nbsp>! Parlez à Cid de ce que nous avons trouvé<nbsp>!
msgctxt "NpcYell:9466:0:13"
msgid "Perhaps these will serve to refresh his memory."
msgstr ""

#. ja: ウワァァァーッ！
#. de: Uaah!
#. fr: Uwaaaah<nbsp>!
msgctxt "NpcYell:9467:0:13"
msgid "Stop!"
msgstr ""

#. ja: ●私についてきてくれ！
#. de: Es verfolgt mich!
#. fr: 0
msgctxt "NpcYell:9468:0:13"
msgid "0"
msgstr ""

#. ja: 反対側から攻めてくるぞ！
#. de: Es kommt von der anderen Seite!
#. fr: Il arrive par l'autre côté<nbsp>!
msgctxt "NpcYell:9469:0:13"
msgid "Incoming! From the other side!"
msgstr ""

#. ja: よおし、必要な物資が集まってきたな！<br>そろそろ、復興共同作業をおっ始めるぞッ！！
#. de: Gut. Wir haben alle Materialien, die wir benötigen.<br>Jetzt müssen wir sie nur noch verarbeiten!
#. fr: Bon<nbsp>! Maintenant qu'on a suf<shy>fi<shy>sam<shy>ment de matériaux, c'est le moment d'en faire quelque chose<nbsp>!
msgctxt "NpcYell:9470:0:13"
msgid "Right, we've got enough supplies! It's time to put 'em to use!"
msgstr ""

#. ja: まずは、広場の東側に窓口を建てるぞ！<br>必要な物資を「物資集積場」から取ってくれ！
#. de: Unsere erste Aufgabe besteht darin, auf der Ostseite Arbeitsflächen für die Schreiberlinge zu schaffen. Schnappt euch Material vom Materialstapel und legt los!
#. fr: On va commencer par construire des guichets à l'est de l'Esplanade. Allez chercher des matériaux sur une des piles<nbsp>!
msgctxt "NpcYell:9471:0:13"
msgid "To start with, we're buildin' facilities on the east side. Grab yourselves some material and hop to!"
msgstr ""

#. ja: これが、蒼天街復興の第一歩になるんだ！<br>皆の職人技を見せてくれ！
#. de: Dies hier wird das Herzstück des Wieder<shy>aufbaus der Himmelsstadt! Gebt euer Bestes!
#. fr: C'est ici que commence la renaissance d'Azurée. Montrez à tous les Ishgardais de quoi vous êtes capables<nbsp>!
msgctxt "NpcYell:9472:0:13"
msgid "Here's where we lay the foundation for the new Firmament! Show me what you can do!"
msgstr ""

#. ja: さて、不足していた物資も調達できたようだな……。<br>そろそろ、復興共同作業を再開するぞ！
#. de: Sehr gut. Die Materialvorräte sind wieder aufgefüllt. Zurück ans Werk!
#. fr: Voilà<nbsp>! Avec ça, on a à nouveau de quoi faire. On se remet au boulot<nbsp>!
msgctxt "NpcYell:9473:0:13"
msgid "We're stocked up on supplies again. Let's get back to it!"
msgstr ""

#. ja: 引き続き、広場の東側で作業を行う！<br>必要な物資を「物資集積場」から取ってくれ！
#. de: Wir machen da weiter, wo wir an der Ostseite aufgehört haben. Nehmt euch von den Materialstapeln, was ihr benötigt und dann ran an die Arbeit!
#. fr: On continue à travailler à l'est de l'Esplanade, alors allez vite vous servir sur une des piles<nbsp>!
msgctxt "NpcYell:9474:0:13"
msgid "We're pickin' up where we left off on the east side. Take what material you need and set to work!"
msgstr ""

#. ja: 今回は、なんとしても窓口を完成させるぞ！<br>仕上げはしっかり、丁寧にな！
#. de: Lasst uns noch einmal alles geben und heute die Schreibstuben fertigstellen!<br>Disziplin und Fleiß ist der Arbeit Preis!
#. fr: Continuez comme ça et les guichets seront bientôt prêts<nbsp>! Et lésinez pas sur la finition<nbsp>!
msgctxt "NpcYell:9475:0:13"
msgid "If we keep our heads down, we'll finish it today. Neat and tidy does it!"
msgstr ""

#. ja: これだけ物資がそろえば、充分だな……。<br>よおし、復興共同作業を始めるぞ！
#. de: Die Materialien sollten vorerst ausreichen. Also gut, zurück an die Arbeit, Leute!
#. fr: Voyons... C'est bon, on a assez de matériaux<nbsp>! Allez, tout le monde au travail<nbsp>!
msgctxt "NpcYell:9476:0:13"
msgid "Aye, that's enough supplies, I reckon. Right, everyone, let's get to work!"
msgstr ""

#. ja: 今回は、広場の西側に施設を建てる計画だ！<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Als Nächstes bebauen wir die Westseite des Platzes. Schnappt euch euer Material und macht euch ans Werk!
#. fr: Cette fois, on construit des ins<shy>tal<shy>la<shy>tions à l'ouest de l'Esplanade. Allez vous servir sur une des piles<nbsp>!
msgctxt "NpcYell:9477:0:13"
msgid "This time we're buildin' facilities on the west side. Grab some material and put your backs into it!"
msgstr ""

#. ja: みんな、職人魂ってモンを、見せつけてくれ！
#. de: Heute will ich sehen, ob ihr euer Handwerk versteht!
#. fr: Et montrez-moi ce qui fait de vous les meilleurs artisans<nbsp>!
msgctxt "NpcYell:9478:0:13"
msgid "Show me what it means to have pride in your work!"
msgstr ""

#. ja: さて、消費したぶんだけ、<br>物資を補うことができたようだな……。
#. de: Wir haben das verbrauchte Material wieder aufgestockt.
#. fr: C'est bon, nos réserves de matériaux sont de nouveau remplies.
msgctxt "NpcYell:9479:0:13"
msgid "Right, we've replenished the supplies we used up last time."
msgstr ""

#. ja: 引き続き、広場の西側で作業を行う！<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Wir müssen unsere Arbeit an der Westseite fortsetzen. Holt euch das benötigte Material vom Stapel und klotzt ran!
#. fr: On continue sur les travaux à l'ouest. Allez chercher de quoi travailler, et on s'y met<nbsp>!
msgctxt "NpcYell:9480:0:13"
msgid "We're continuin' our work on the west side. You know what to do!"
msgstr ""

#. ja: 施設の完成まで、あともう少しだ。<br>みんな、最後まで抜かりなく作業してくれ！
#. de: Wir stehen kurz vor der Fertigstellung! Ziehen wir's durch!
#. fr: On en a presque fini avec cette tâche<nbsp>! Restez concentrés jusqu'au bout, compris<nbsp>?
msgctxt "NpcYell:9481:0:13"
msgid "We're almost through with this task. Let's stay focused to the last!"
msgstr ""

#. ja: よしきた、復興共同作業を開始するぞ！<br>この広場に、明かりを灯すんだ！
#. de: Hört her, Freunde! Heute lassen wir den Platz in einem neuen Licht erstrahlen!
#. fr: Allez, on se retrousse les manches pour éclairer l'Esplanade des démunis<nbsp>!
msgctxt "NpcYell:9482:0:13"
msgid "Look alive, everyone! Today, we're lightin' up the court!"
msgstr ""

#. ja: 「物資集積場」の物資を使って燃料を作り、<br>篝火に投入してくれればいい！
#. de: Verwendet das Material vom Materialstapel, um Feuerholz herzustellen und dann füllt damit die Feuerschalen!
#. fr: Prenez du bois dans la pile de matériaux, faites-en du combustible, puis allez le jeter dans le brasier<nbsp>!
msgctxt "NpcYell:9483:0:13"
msgid "Use the material to make firewood, then feed it to the braziers─it's simple as that."
msgstr ""

#. ja: 名も無き者たちの広場に、<br>職人魂の炎を、燃え上がらせてくれ！
#. de: Die Feuer sollen so heiß brennen, wie der Eifer unserer Handwerker!
#. fr: C'est le moment d'attiser la flamme de l'artisanat qui brûle en vous<nbsp>!
msgctxt "NpcYell:9484:0:13"
msgid "Let's stoke a roarin' fire to match our builders' spirit!"
msgstr ""

#. ja: 物資の備蓄が規定量に達したようだな……。<br>よおし、仕上げにかかるとするぞ！
#. de: Der Materialbestand sieht gut aus. Wir sind bereit, loszulegen.
#. fr: Le ra<shy>vi<shy>tail<shy>le<shy>ment de matériaux est arrivé<nbsp>! On se bouge les fesses, y a du travail à finir<nbsp>!
msgctxt "NpcYell:9485:0:13"
msgid "Right, our stores are lookin' good. It's time to add the finishin' touches!"
msgstr ""

#. ja: これらの物資を使って、<br>復興事業掲示板と炊き出し場を完成させてくれ！
#. de: Schnappt euch etwas Material und zimmert das Schwarze Brett zusammen und fertigt die Materialausgabe an!
#. fr: Ce coup-ci, un panneau d'in<shy>for<shy>ma<shy>tions et une cuisine au programme<nbsp>!
msgctxt "NpcYell:9486:0:13"
msgid "Grab some material─we're refurbishin' the skybuilders' board and makin' a kitchen to boot!"
msgstr ""

#. ja: この広場での復興共同作業も大詰めだ！<br>職人のみんな、気合を入れて作業してくれ！
#. de: Nicht mehr viel und dieser Platz wird vollendet sein! Legt euch ins Zeug, Leute!
#. fr: Allez allez, on faiblit pas<nbsp>! On commence à en voir le bout, alors tenez bon<nbsp>!
msgctxt "NpcYell:9487:0:13"
msgid "Keep your hearts in it, everyone! We're just about done with the court!"
msgstr ""

#. ja: おいおい、この程度の進捗じゃ話にならないぞ！？<br>一度、作業を中止して、計画を練り直すとするか……。
#. de: Ich fasse es nicht! Nach all der Zeit haben wir nicht mehr zustande gebracht?<br>Also gut, von vorne!
#. fr: Vous bossez moins vite que des limaces, ma parole<nbsp>! Il faut tout recommencer depuis le début...
msgctxt "NpcYell:9488:0:13"
msgid "What in the Fury's name? After all this time, this is all we've managed? \\<sigh> We're going to have to start over..."
msgstr ""

#. ja: 強い力を感じる…！
#. de: Ich spüre machtvolle Kräfte am Werk! \<grunz>
#. fr: Grouik<nbsp>! Mon ventre gargouille... Quelle puissante magie<nbsp>!
msgctxt "NpcYell:9489:0:13"
msgid "I sense a potent power!"
msgstr ""

#. ja: ボクに任せて！
#. de: Überlasst das mir! \<quieeek>
#. fr: Grouik<nbsp>! Je m'en charge<nbsp>!
msgctxt "NpcYell:9490:0:13"
msgid "Just leave it to me!"
msgstr ""

#. ja: オーケイ！
#. de: Also gut!
#. fr: Pas de problème<nbsp>!
msgctxt "NpcYell:9491:0:13"
msgid "All right!"
msgstr ""

#. ja: ム…ムチュムチュ…
#. de: \<schlurf> \<saug>
#. fr: Ouille ouille ouille...
msgctxt "NpcYell:9492:0:13"
msgid "Uhhh, how it churns..."
msgstr ""

#. ja: そーーっれ！
#. de: Bah!
#. fr: Et hop<nbsp>!
msgctxt "NpcYell:9493:0:13"
msgid "Yah!"
msgstr ""

#. ja: 具現化するよっ！
#. de: Achtung! Ich manifestiere nun den Alb!
#. fr: Je fais apparaître le cauchemar<nbsp>!
msgctxt "NpcYell:9494:0:13"
msgid "Here I go!"
msgstr ""

#. ja: 構えて！
#. de: Bereit?!
#. fr: Soyez prêt<nbsp>!
msgctxt "NpcYell:9495:0:13"
msgid "Get ready!"
msgstr ""

#. ja: 醜い姿を現しなさい！
#. de: Zeige dein hässliches Gesicht!
#. fr: Montre ta sale tête<nbsp>!
msgctxt "NpcYell:9496:0:13"
msgid "Show your ugly face!"
msgstr ""

#. ja: ううう…<br>力が…制御できない…
#. de: Ich<nbsp>... Ich bin so schwach<nbsp>...
#. fr: Je ne peux pas... me contrôler...
msgctxt "NpcYell:9497:0:13"
msgid "\\<sob> I can't control my power..."
msgstr ""

#. ja: 怖い…<br>こっちに来ないで…！
#. de: Nein, bleibt weg! Lasst mich in Ruhe!
#. fr: J'ai peur... L-laisse-moi tranquille<nbsp>!
msgctxt "NpcYell:9498:0:13"
msgid "Stay away from me! Stay away!"
msgstr ""

#. ja: はぁ…はぁ…<br>頭の中で…声が…
#. de: D-Diese Stimme in meinem Kopf<nbsp>...
#. fr: Aaah... U-une voix... dans ma tête...
msgctxt "NpcYell:9499:0:13"
msgid "Get out... Get out of my head..."
msgstr ""

#. ja: ううう…うあああ…
#. de: Uaaaah!
#. fr: (sanglote)...
msgctxt "NpcYell:9500:0:13"
msgid "\\<sob> \\<sniffle>"
msgstr ""

#. ja: 誰か…助けて…
#. de: H-Hilfeee!
#. fr: À... À l'aide... Quelqu'un...
msgctxt "NpcYell:9501:0:13"
msgid "Help me... Somebody..."
msgstr ""

#. ja: あちち！<br>陶器になっちゃう！
#. de: H-Heiß! Will keine Porzellanquiexie sein!
#. fr: Aïe<nbsp>! Je vais finir en terre cuite<nbsp>!
msgctxt "NpcYell:9502:0:13"
msgid "Yeowch! I-I don't want to become porxelain!"
msgstr ""

#. ja: きゃあっ！？
#. de: Iiiih!
#. fr: P-pas mes belles ailes<nbsp>!
msgctxt "NpcYell:9503:0:13"
msgid "Eeek!"
msgstr ""

#. ja: ぷぎぎ…身体が崩れるぅ！<br>ボクは粘土なんだ～！
#. de: \<quieeek> Hüüülfe! Gleich bin ich nur noch Matsch!
#. fr: Bloub...<nbsp>! M-mon corps d'argile va se désagréger dans l'eau<nbsp>!
msgctxt "NpcYell:9504:0:13"
msgid "Nooo! The water will warp my winsome curves!"
msgstr ""

#. ja: 水が！？<br>この泡、壊してぇ！
#. de: Wieder dieses Wasserwesen?
#. fr: Qu'est-ce que<nbsp>!? Hé<nbsp>! Éclatez-moi cette bulle<nbsp>!
msgctxt "NpcYell:9505:0:13"
msgid "Ack! Burst this bubble, will you!"
msgstr ""

#. ja: クッ…<br>身体が痺れて…！
#. de: \<stöhn> Ich spüre nichts mehr<nbsp>...
#. fr: Argh<nbsp>! Je ne sens plus mon corps...
msgctxt "NpcYell:9506:0:13"
msgid "He must...be stopped..."
msgstr ""

#. ja: おのれ…<br>逆賊どもめ…！
#. de: D-Diese Verräter!
#. fr: Espèce de... traître...
msgctxt "NpcYell:9507:0:13"
msgid "Damn you... Gaius..."
msgstr ""

#. ja: ●後継の者への言葉
#. de: 0
#. fr: 0
msgctxt "NpcYell:9510:0:13"
msgid "0"
msgstr ""

#. ja: ●後継の者への言葉
#. de: 0
#. fr: 0
msgctxt "NpcYell:9511:0:13"
msgid "0"
msgstr ""

#. ja: ●後継の者への言葉
#. de: 0
#. fr: 0
msgctxt "NpcYell:9512:0:13"
msgid "0"
msgstr ""

#. ja: わ…私は吸えないよぉ！<br>悪夢の霧めがけて指示してね！
#. de: Du sollst nicht mich aufsaugen, du Witzbold!<br>Die Albtraumwolke ist unser Ziel!
#. fr: Non, mais<nbsp>! C'est pas moi qu'il faut aspirer, c'est les brumes de cauchemar<nbsp>!
msgctxt "NpcYell:9513:0:13"
msgid "N-Not me, silly! The nightmare!"
msgstr ""

#. ja: あっ、ちょっと…<br>待ってよ！
#. de: H-He, warte!
#. fr: 0
msgctxt "NpcYell:9514:0:13"
msgid "0"
msgstr ""

#. ja: イイゾ…力ガ増幅シタ…！<br>憎メ…想起シロ…絶望ヲ…
#. de: Ja! Gib mir die Kraft deines Hasses, deiner Ver<shy>zweif<shy>lung!
#. fr: ToN dÉsEsPoIrE mE rEnD pLuS pUiSsAnT eNcOrE<nbsp>! LaIsSe-Le T'eNvAhIr<nbsp>!
msgctxt "NpcYell:9515:0:13"
msgid "Just so! Empower me with your hatred, your despair!"
msgstr ""

#. ja: 無能な父を…<br>絶対に許さない…！
#. de: Keine Vergebung für meinen nutzlosen Vater!
#. fr: Maudit sois-tu, Père<nbsp>! Tu l'as envoyé à sa mort...
msgctxt "NpcYell:9516:0:13"
msgid "Curse you, Father! You sent him to his death!"
msgstr ""

#. ja: 兄様を奪った<br>「けだもの」どもめ…！
#. de: Ihr Würmer<nbsp>... Meinen Bruder habt ihr auf dem Gewissen!
#. fr: Barbares<nbsp>! Vous m'avez volé mon frère<nbsp>!
msgctxt "NpcYell:9517:0:13"
msgid "Savages! You stole him from me!"
msgstr ""

#. ja: 愛しい兄様…<br>置いていかないで…
#. de: O liebster Bruder<nbsp>...  Lass mich nicht allein zurück<nbsp>... 
#. fr: Nael... Ne me laisse pas, je t'en prie...
msgctxt "NpcYell:9518:0:13"
msgid "Brother, do not leave me, I beg you!"
msgstr ""

#. ja: ブラダマンテ姉様…<br>なぜ逝ってしまったの？
#. de: Meine liebe Bradamante<nbsp>...  Warum musstest du nur sterben?
#. fr: Bradamante... Pourquoi t'en es-tu allée<nbsp>?
msgctxt "NpcYell:9519:0:13"
msgid "Bradamante... First Brother, then you..."
msgstr ""

#. ja: 死こそ、誉れ…！
#. de: Treu bis in den Tod!
#. fr: Mort aux sssans-branchies<nbsp>!
msgctxt "NpcYell:9520:0:13"
msgid "My life for vengeance!"
msgstr ""

#. ja: た、助けに来たのに…
#. de: Wollten nur<nbsp>... dienen<nbsp>...
#. fr: Ma Reine... Fssshhh...
msgctxt "NpcYell:9521:0:13"
msgid "It won't end like thisss!"
msgstr ""

#. ja: 人が呪札に…！？
#. de: Sind das etwa wir auf den Karten?
#. fr: Il les a transformées en talismans<nbsp>!?
msgctxt "NpcYell:9522:0:13"
msgid "What surprise is in store for us next, I wonder."
msgstr ""

#. ja: 落ち着いて選択するのよ…
#. de: Lass dir Zeit und denk nach!
#. fr: Concentre-toi bien...
msgctxt "NpcYell:9523:0:13"
msgid "I trust you'll make the right choice this time."
msgstr ""

#. ja: 同盟者の勘に任せる
#. de: Lass dich von deiner Intuition leiten<nbsp>...
#. fr: Je m'en remets à vous.
msgctxt "NpcYell:9524:0:13"
msgid "I will defer to your judgment."
msgstr ""

#. ja: 慎重に選んでくれ…
#. de: Wähle mit Bedacht!
#. fr: Choisissez en votre âme et conscience.
msgctxt "NpcYell:9525:0:13"
msgid "The choice is clear."
msgstr ""

#. ja: 何が出るかなー？
#. de: Was jetzt wohl passiert<nbsp>...
#. fr: Qu'est-ce qui nous attend...<nbsp>?
msgctxt "NpcYell:9526:0:13"
msgid "Whatever comes out, we can handle it."
msgstr ""

#. ja: しかし、ヘンテコな<br>神獣だね…
#. de: Das ist die verrückteste Schutzvorrichtung, die ich je gesehen habe.
#. fr: Je commence à me lasser de ces petits jeux...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:9527:0:13"
msgid "I tire of this guardian's <i>games</i>."
msgstr ""

#. ja: がんばってください～
#. de: Du schaffst das!
#. fr: Allez-y<nbsp>! Faites confiance à votre instinct<nbsp>!
msgctxt "NpcYell:9528:0:13"
msgid "Go on. Trust your instincts."
msgstr ""

#. ja: 早く解放してあげたいですぅ
#. de: Hol bitte auch die anderen schnell raus, ja?
#. fr: J'espère qu'on pourra vite libérer tout le monde...
msgctxt "NpcYell:9529:0:13"
msgid "Soon we can quit this place."
msgstr ""

#. ja: ありがとう、助かったわ
#. de: Danke! Mir war das ganze Rumstehen schon zuwider.
#. fr: Merci, <split " " 1><string $gs1></split><nbsp>!
msgctxt "NpcYell:9530:0:13"
msgid "Well done."
msgstr ""

#. ja: 感謝する、同盟者よ
#. de: Danke, <if $gn4>Verbündete<else>Verbündeter</if> von Ronka!
#. fr: Merci, <if $gn4>alliée<else>allié</if> de Ronka<nbsp>!
msgctxt "NpcYell:9531:0:13"
msgid "My thanks."
msgstr ""

#. ja: ふー、助かったよ！
#. de: Puh, dankeschön.
#. fr: Ouf, je me sens mieux<nbsp>!
msgctxt "NpcYell:9532:0:13"
msgid "Thank goodness..."
msgstr ""

#. ja: ありがとうございますぅ～
#. de: Vielen Dank!
#. fr: Je commençais à me sentir à l'étroit...
msgctxt "NpcYell:9533:0:13"
msgid "Wha...what happened?"
msgstr ""

#. ja: うちはあっちに行くよ！
#. de: 0
#. fr: 0
msgctxt "NpcYell:9534:0:13"
msgid "0"
msgstr ""

#. ja: 大変ですぅ～！
#. de: 0
#. fr: 0
msgctxt "NpcYell:9535:0:13"
msgid "0"
msgstr ""

#. ja: 助かったわ…
#. de: Genau zur rechten Zeit!
#. fr: Je t'en dois une<nbsp>!
msgctxt "NpcYell:9536:0:13"
msgid "Thank you."
msgstr ""

#. ja: わかった！
#. de: Verstanden!
#. fr: Merci<nbsp>!
msgctxt "NpcYell:9537:0:13"
msgid "Right!"
msgstr ""

#. ja: シャイメから狙いを離せ！
#. de: Halte das Ziel von Cymet fern!
#. fr: Détournez leur attention de Cymet<nbsp>!
msgctxt "NpcYell:9538:0:13"
msgid "Draw their attention from Cymet!"
msgstr ""

#. ja: うちらは大丈夫！
#. de: 0
#. fr: 0
msgctxt "NpcYell:9539:0:13"
msgid "0"
msgstr ""

#. ja: 安心しろ！
#. de: 0
#. fr: 0
msgctxt "NpcYell:9540:0:13"
msgid "0"
msgstr ""

#. ja: もう少しですぅ～
#. de: Gleich haben wir's geschafft!
#. fr: Il faut tenir<nbsp>!
msgctxt "NpcYell:9541:0:13"
msgid "We have to hold on!"
msgstr ""

#. ja: 気をつけるのよ！
#. de: Aufgepasst!
#. fr: Attention<nbsp>!
msgctxt "NpcYell:9542:0:13"
msgid "Stand back!"
msgstr ""

#. ja: みんな散らばって！
#. de: Verteilt euch!
#. fr: Écartons-nous<nbsp>!
msgctxt "NpcYell:9543:0:13"
msgid "Spread out!"
msgstr ""

#. ja: なんか、いっぱい出てきた！
#. de: Wo kommen die denn alle her?
#. fr: Il en arrive de partout<nbsp>!
msgctxt "NpcYell:9544:0:13"
msgid "There are so many!"
msgstr ""

#. ja: 毒が強まっている…<br>急ぐぞ！
#. de: 0
#. fr: 0
msgctxt "NpcYell:9545:0:13"
msgid "0"
msgstr ""

#. ja: フアガスを倒さないと…！
#. de: Wir müssen diese Huaca besiegen!
#. fr: Il ne faut pas les laisser nous submerger<nbsp>!
msgctxt "NpcYell:9546:0:13"
msgid "Quickly, before they can overwhelm us!"
msgstr ""

#. ja: もう罠はないだろう…
#. de: Die Fallen sind weg, wie's scheint!
#. fr: Il n'y a plus de pièges, j'espère...
msgctxt "NpcYell:9547:0:13"
msgid "That should be the last of the chamber's defenses."
msgstr ""

#. ja: ふー、おつかれー！
#. de: Puh, das war harte Arbeit!
#. fr: Youhouuu<nbsp>!
msgctxt "NpcYell:9548:0:13"
msgid "At last we can leave."
msgstr ""

#. ja: ひと安心ですぅ…
#. de: Jetzt sollten wir erst einmal sicher sein.
#. fr: Contente que ça soit fini...
msgctxt "NpcYell:9549:0:13"
msgid "I am glad that is over..."
msgstr ""

#. ja: うーん…わからん
#. de: Hoffentlich ...
#. fr: Hmmm...
msgctxt "NpcYell:9550:0:13"
msgid "Hmmm..."
msgstr ""

#. ja: え～と、何でしたっけ？
#. de: Also gut, wo waren wir stehen<shy>geblieben?
#. fr: Euh, c'était quoi, déjà<nbsp>?
msgctxt "NpcYell:9551:0:13"
msgid "Hmmm..."
msgstr ""

#. ja: あれが交信雷波塔…<br>蒸発事変の元凶ですか…
#. de: Das ist die Sendeanlage. Von hier ging die Zerstörung aus.
#. fr: L'épicentre du drame qui se produisit ici...
msgctxt "NpcYell:9552:0:13"
msgid "The site of the Bozja incident..."
msgstr ""

#. ja: あの施設が<br>プリンシピア…？
#. de: Ist das da hinten Principia?
#. fr: Cette base garlemaldaise qui vient d'apparaître<nbsp>? Je vois...
msgctxt "NpcYell:9553:0:13"
msgid "(Did it appear because he mentioned the Principia, I wonder?)"
msgstr ""

#. ja: た、助けて…
#. de: Hilfe!
#. fr: À-à l'aide<nbsp>!
msgctxt "NpcYell:9554:0:13"
msgid "Someone help!"
msgstr ""

#. ja: ヒィ…！
#. de: Aaah!
#. fr: O-on a rien fait nous<nbsp>!
msgctxt "NpcYell:9555:0:13"
msgid "Stay back!"
msgstr ""

#. ja: うおおお！
#. de: Wuaaah!
#. fr: Yaaaaaah<nbsp>!
msgctxt "NpcYell:9556:0:13"
msgid "Raaagh!"
msgstr ""

#. ja: 帝国を打倒せよ！
#. de: Nieder mit den Garlearn!
#. fr: Faites mordre la poussière à ces envahisseurs<nbsp>!
msgctxt "NpcYell:9557:0:13"
msgid "Down with the Empire!"
msgstr ""

#. ja: 祖国を取り戻すのだ！
#. de: Freiheit für Bozja!
#. fr: Bozja nous appartient<nbsp>!
msgctxt "NpcYell:9558:0:13"
msgid "For Bozja!"
msgstr ""

#. ja: 反乱分子どもめ！
#. de: Schweigt, ihr dreckigen Ratten!
#. fr: Sales chiens<nbsp>!
msgctxt "NpcYell:9559:0:13"
msgid "Damn you!"
msgstr ""

#. ja: 蛮族どもが…！
#. de: Wilde! Ihr seid nichts als Wilde!
#. fr: Sauvages<nbsp>!
msgctxt "NpcYell:9560:0:13"
msgid "Filthy savages!"
msgstr ""

#. ja: 散れッ！
#. de: Stirb!
#. fr: Crevez tous<nbsp>!
msgctxt "NpcYell:9561:0:13"
msgid "Down with you!"
msgstr ""

#. ja: これが魔導兵器の力だ！
#. de: Noch eine Ladung Magitek gefällig?
#. fr: On fait moins les malins face une armure magitek, hein<nbsp>!!?
msgctxt "NpcYell:9562:0:13"
msgid "Steady, men!"
msgstr ""

#. ja: 攻撃するッ！
#. de: Feuer frei!
#. fr: À l'assaut<nbsp>!
msgctxt "NpcYell:9563:0:13"
msgid "Open fire!"
msgstr ""

#. ja: こんな戦い方…<br>命を粗末にしすぎている…
#. de: 0
#. fr: 0
msgctxt "NpcYell:9564:0:13"
msgid "0"
msgstr ""

#. ja: 実験を中止させようと<br>必死だったんだ…
#. de: 0
#. fr: 0
msgctxt "NpcYell:9565:0:13"
msgid "0"
msgstr ""

#. ja: どこかに反乱分子が<br>潜んでいるはずだ！
#. de: Hier müssen sich noch ein paar von denen versteckt haben.
#. fr: Une cellule rebelle se cache forcément quelque part<nbsp>! Dénichez-les tous<nbsp>!
msgctxt "NpcYell:9566:0:13"
msgid "I want those savages found!"
msgstr ""

#. ja: 投降するなら<br>今のうちだぞ！
#. de: Ergebt euch oder tragt die Konsequenzen!
#. fr: Rendez-vous<nbsp>! Ou mourez<nbsp>!
msgctxt "NpcYell:9567:0:13"
msgid "Last chance to surrender!"
msgstr ""

#. ja: 蛮族どもが<br>集まってきているらしい
#. de: Die Wilden haben sich zusammengerottet.
#. fr: T'as entendu parler du groupe rebelle<nbsp>?
msgctxt "NpcYell:9568:0:13"
msgid "I say we strike before they can regroup."
msgstr ""

#. ja: チッ…こんなときに…<br>面倒事はゴメンだぜ
#. de: Ausgerechnet jetzt. Wie lästig!
#. fr: Ouais, c'est pourtant pas le moment... Je préférerais être ailleurs, moi.
msgctxt "NpcYell:9569:0:13"
msgid "Why bother? They're but ants beneath our boot."
msgstr ""

#. ja: 止まれ！<br>命令に従わないなら…！
#. de: Stehenbleiben! Bei Nichtbeachtung gibt's Todesstrafe!
#. fr: Stop<nbsp>! Arrêtez-vous, sinon vous allez le regretter<nbsp>!
msgctxt "NpcYell:9570:0:13"
msgid "You know the price for insurrection!"
msgstr ""

#. ja: ひ、ひぇぇ～
#. de: Ah, aaah!
#. fr: Ah ah...<nbsp>! Au secours<nbsp>! Quelqu'un<nbsp>!
msgctxt "NpcYell:9571:0:13"
msgid "No, please!"
msgstr ""

#. ja: 国家反逆罪の疑いで<br>収容所に送られたいのか！
#. de: 0
#. fr: 0
msgctxt "NpcYell:9572:0:13"
msgid "0"
msgstr ""

#. ja: わ、私は違う…！<br>ご、誤解ですぅ！
#. de: 0
#. fr: 0
msgctxt "NpcYell:9573:0:13"
msgid "0"
msgstr ""

#. ja: グアッ…頭が…<br>割れるように…！
#. de: 0
#. fr: 0
msgctxt "NpcYell:9574:0:13"
msgid "0"
msgstr ""

#. ja: キエロ…キエロ…
#. de: Löscht sie aus!
#. fr: Des corps étrangers...
msgctxt "NpcYell:9575:0:13"
msgid "Get..."
msgstr ""

#. ja: シネ…シネ…
#. de: Vernichtet sie!
#. fr: Purger... Purger...
msgctxt "NpcYell:9576:0:13"
msgid "...Out."
msgstr ""

#. ja: 俺の恐怖が作り出した<br>門番ってところか…
#. de: 0
#. fr: 0
msgctxt "NpcYell:9577:0:13"
msgid "0"
msgstr ""

#. ja: 雷波塔…ダラガブ…<br>ウ、ウアアッ…
#. de: 0
#. fr: 0
msgctxt "NpcYell:9578:0:13"
msgid "0"
msgstr ""

#. ja: あの時も…俺は…<br>この通路を…親父と…
#. de: Es ist genau wie damals<nbsp>... Hier stand ich und argumentierte mit meinem Vater.
#. fr: J'ai traversé ce même couloir pour confronter mon père ce jour-là...
msgctxt "NpcYell:9579:0:13"
msgid "Father was so angry that day..."
msgstr ""

#. ja: うおおおッ！
#. de: Huaaah!
#. fr: Ouoooooh<nbsp>!
msgctxt "NpcYell:9580:0:13"
msgid "Raaaaaargh!"
msgstr ""

#. ja: ま、まだだ…！
#. de: Nicht so schnell!
#. fr: Il en faudra... plus que ça<nbsp>!
msgctxt "NpcYell:9581:0:13"
msgid "Hurry...!"
msgstr ""

#. ja: これ以上は…<br>急いでくれ！
#. de: Macht schnell ...<br>Ich halt nicht mehr lang durch!
#. fr: J'tiens plus... Dépêchez-vous<nbsp>!
msgctxt "NpcYell:9582:0:13"
msgid "I can't...hold it...!"
msgstr ""

#. ja: 斬り刻む！
#. de: Ich schneid dich inzwei!
#. fr: Je vais vous écorcher<nbsp>!
msgctxt "NpcYell:9583:0:13"
msgid "On your knees!"
msgstr ""

#. ja: 受けてみよ！
#. de: Nimm das!
#. fr: Prenez ça<nbsp>!
msgctxt "NpcYell:9584:0:13"
msgid "Now I have you!"
msgstr ""

#. ja: 逃がすものか…！
#. de: Es gibt kein Entkommen!
#. fr: Vous n'en réchapperez pas<nbsp>!
msgctxt "NpcYell:9585:0:13"
msgid "There is no escape!"
msgstr ""

#. ja: いただいてくニャー！
#. de: Miau, leckerer Kampfgeist!
#. fr: C'est pour miaou<nbsp>!
msgctxt "NpcYell:9586:0:13"
msgid "Mine, meow! All mine!"
msgstr ""

#. ja: なぜ…攻撃を…！
#. de: Nimm meine Ssseele, oh große Flunder!
#. fr: Hein<nbsp>!? Pourquoi...<nbsp>?
msgctxt "NpcYell:9587:0:13"
msgid "What is the meaning of thisss?"
msgstr ""

#. ja: ひ、ひどぃ…
#. de: Aaaah!
#. fr: N-noooon<nbsp>!!!
msgctxt "NpcYell:9588:0:13"
msgid "Ow, that's my liver!"
msgstr ""

#. ja: 味方なのにッ…！
#. de: Mein Leben für die Königin!
#. fr: Ççça fait mal<nbsp>!
msgctxt "NpcYell:9589:0:13"
msgid "Betrayed!"
msgstr ""

#. ja: きたりたまえ…<br>きたりたまえ…
#. de: Oh großer Ozean, erhöre den Ruf meiner Ssseele!
#. fr: Viens à nous, créature oubliée...
msgctxt "NpcYell:9590:0:13"
msgid "Come unto flesh, O forgotten form..."
msgstr ""

#. ja: フシャァ～！
#. de: Fssshaaa!
#. fr: Fssshhh<nbsp>!!!
msgctxt "NpcYell:9591:0:13"
msgid "\\<hiss>"
msgstr ""

#. ja: ヒトは絶滅させるゥ！
#. de: Nieder mit den Flossenlosen!
#. fr: Sssus aux sssans-branchies<nbsp>!
msgctxt "NpcYell:9592:0:13"
msgid "Every last one of you will die!"
msgstr ""

#. ja: 魚のエサにしてやる！
#. de: Fissschfutter sollt ihr sein!
#. fr: Vos ressstes nourriront les poissons<nbsp>!
msgctxt "NpcYell:9593:0:13"
msgid "Die, and lie beneath the silt!"
msgstr ""

#. ja: ディーマのためにッ！
#. de: Für unsere Königin!
#. fr: Pour notre Reiiine<nbsp>!!!
msgctxt "NpcYell:9594:0:13"
msgid "The Dheema demands your head!"
msgstr ""

#. ja: お生憎だな！<br>高いところは大得意だ
#. de: Ich muss leider enttäuschen: Luftige Höhen sind meine Spezialität!
#. fr: Pas de chance<nbsp>! Je ne crrrains pas le vide<nbsp>!
msgctxt "NpcYell:9595:0:13"
msgid "I regret to disappoint, but I'm more than comfortable with heights!"
msgstr ""

#. ja: ぐっ…なんてニオイだ…
#. de: Urks, was für ein ... Duft.
#. fr: Argh... L'odeurrr<nbsp>!
msgctxt "NpcYell:9596:0:13"
msgid "Ugh, the stench is unbearable!"
msgstr ""

#. ja: チッ…しくじったぜ…
#. de: Verdammt ... Wie ist das passiert?
#. fr: Bordel, ça craint.
msgctxt "NpcYell:9597:0:13"
msgid "Well, that's a wash..."
msgstr ""

#. ja: アイタタタッ！
#. de: Aua, der hat gesessen!
#. fr: Ouille ouille ouille<nbsp>!
msgctxt "NpcYell:9598:0:13"
msgid "I say, that rather stings!"
msgstr ""

#. ja: むむっ、芳しい香りが…
#. de: Igitt, was für ein Gestank!
#. fr: Ce parfum suave me chatouille les narines...
msgctxt "NpcYell:9599:0:13"
msgid "My, what a robust fragrance..."
msgstr ""

#. ja: アアーーーーッ！
#. de: Uaaahaa!
#. fr: Youpi<nbsp>!
msgctxt "NpcYell:9600:0:13"
msgid "AaAaAagh!"
msgstr ""

#. ja: 運行表は<br>ワワラゴ親分と決めているんだ
#. de: Die Fahrtrouten bestimme ich zusammen mit Meister Wawalago.
#. fr: Pour toute plainte concernant l'itinéraire, adressez-vous à Wawalago.
msgctxt "NpcYell:9608:0:13"
msgid "If you have any complaints about the schedule, feel free to take them up with Master Wawalago."
msgstr ""

#. ja: さあ、釣りまくってくれ！
#. de: Also dann, viel Spaß beim Fischen!
#. fr: Les enfants, à vos cannes<nbsp>!
msgctxt "NpcYell:9609:0:13"
msgid "Fish, you landlubbers, fish!"
msgstr ""

#. ja: 俺も釣りたいが…<br>グッと我慢だ…！
#. de: Ich würde ja auch gerne angeln, aber ich muss auf meinem Posten bleiben.
#. fr: Ma canne me démange, mais je dois me retenir...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9610:0:13"
msgid "Would that I had brought my own rod... Perhaps if I...<br>Ah, what am I thinkin'? I've captainly duties to attend to!"
msgstr ""

#. ja: 強いアタリがきたら<br>大物を釣るチャンスだ！
#. de: Wenn deine Angel stark ausschlägt, hast du einen großen Fisch am Haken!
#. fr: Plus ça mord fort, plus ça pèse lourd<nbsp>!
msgctxt "NpcYell:9611:0:13"
msgid "The stronger the bite, the bigger the fish!"
msgstr ""

#. ja: 魚にも餌の好みがあるぞ
#. de: Fische sind durchaus wählerisch, wovon sie sich ködern lassen.
#. fr: Certains poissons sont très tatillons, donc choisissez bien vos appâts<nbsp>!
msgctxt "NpcYell:9612:0:13"
msgid "Fish might look simple, but some can be mighty particular when it comes to their bait."
msgstr ""

#. ja: 釣れ釣れ、釣れー！！
#. de: Angelt, was das Zeug hält!
#. fr: ♪ À la pêche aux moules, moules, moules<nbsp>!
msgctxt "NpcYell:9613:0:13"
msgid "Fish! Fish with every scantling of your being!"
msgstr ""

#. ja: どうだ、爆釣かい？
#. de: Na, wie ist die Ausbeute?
#. fr: Alors, ça mord<nbsp>?
msgctxt "NpcYell:9614:0:13"
msgid "Fish twice as hard, for my sake!"
msgstr ""

#. ja: ワハハ！<br>すげえ群れだ！
#. de: Haha, was für ein Schwarm!
#. fr: Voilà de quoi se remplir les filets et les poches<nbsp>!
msgctxt "NpcYell:9615:0:13"
msgid "Hah hah, the feast is here!"
msgstr ""

#. ja: 今なら<br>入れ食いまちがいなし！
#. de: Jetzt beißen sie bestimmt sofort an!
#. fr: Si vous attrapez rien maintenant, je peux plus rien pour vous<nbsp>!
msgctxt "NpcYell:9616:0:13"
msgid "If you can't land a catch now, I'll have to ask you to turn in your rod!"
msgstr ""

#. ja: よそ見は厳禁！<br>全神経を竿に集中させろ！
#. de: Ihr müsst eure ganze Aufmerksamkeit auf die Angel richten!
#. fr: On se concentre<nbsp>! La distraction est le plus grand ennemi du pêcheur.
msgctxt "NpcYell:9617:0:13"
msgid "Distraction's a fisher's worst enemy! Focus on your rod! Focus!"
msgstr ""

#. ja: 日が落ちると海中から<br>謎の光がよぎることが…
#. de: Wenn die Sonne untergangen ist, sieht man manchmal ein Leuchten im Wasser.
#. fr: Quand le soleil se couche, il y a parfois une mystérieuse lumière qui traverse la surface...
msgctxt "NpcYell:9620:0:13"
msgid "When the sun sets, the sea comes alive."
msgstr ""

#. ja: 発光物を海に落としたら…<br>応えるように海中が光ったんだ
#. de: Als ich eine Lampe ins Wasser geworfen habe, flimmerte und glitzerte es plötzlich überalll.
#. fr: Un jour, un de mes gars a laissé tomber une lanterne à l'eau et la mer s'est mise à briller, comme pour nous remercier<nbsp>!
msgctxt "NpcYell:9621:0:13"
msgid "Once, one of my crew dropped a lantern overboard. The waters started glittering as if to thank us!"
msgstr ""

#. ja: この悪天候なら<br>スペクトラルメガロドンが…
#. de: Bei solchem schlechten Wetter könnte ein Spektral-Megalodon auftauchen.
#. fr: On raconte que c'est par mauvais temps que le mégalodon spectral se met en chasse...
msgctxt "NpcYell:9622:0:13"
msgid "Rumor has it that during rough weather is when the spectral megalodon sets out on its hunt."
msgstr ""

#. ja: スペクトラルメガロドンという<br>巨大な魚が棲息してるんだ
#. de: Es würde mich nicht wundern, wenn hier ein Spektral-Megalodon lebt.
#. fr: Gare à celui qui met en colère le mégalodon spectral<nbsp>! Ce mastodonte pourrait avaler un équipage tout entier...
msgctxt "NpcYell:9623:0:13"
msgid "Pray you don't disturb the spectral megalodon. I've heard stories of it swallowin' whole crews in one gulp."
msgstr ""

#. ja: ここで真夜中に<br>動く珊瑚を見たんだ…
#. de: Ich habe hier mitten in der Nacht Korallen im Wasser gesehen.
#. fr: Une nuit, à cet endroit exact, j'aurais juré avoir vu un corail se déplacer...
msgctxt "NpcYell:9626:0:13"
msgid "In the dead of night, I swear I've seen the coral itself movin' about like some kind of worm."
msgstr ""

#. ja: ここではエビが釣れねぇんだ<br>何かに狩られてるのか…？
#. de: Garnelen können sie hier nicht fangen. Ob sie vor irgendetwas auf der Flucht waren?
#. fr: Il y a pas une seule crevette dans le coin. Qu'est-ce qui les mange, à votre avis<nbsp>?
msgctxt "NpcYell:9627:0:13"
msgid "There ain't a shrimp to be found in these waters. What's eatin' them, you think?"
msgstr ""

#. ja: スペクトラルディスカスは<br>警戒心が強いんだよなあ
#. de: Phantom-Diskusfische sind flink und aufmerksam.
#. fr: Le discus spectral vaut le coup d'œil, mais il s'enfuit au moindre petit bruit...
msgctxt "NpcYell:9628:0:13"
msgid "The spectral discus is a sight to see, but it'll startle at the smallest sound."
msgstr ""

#. ja: スペクトラルディスカスって<br>中型の魚がいるぞ！
#. de: Hier leben mittelgroße Phantom-Diskusfische.
#. fr: Regardez, un discus spectral<nbsp>! On en croise pas tous les jours<nbsp>!
msgctxt "NpcYell:9629:0:13"
msgid "Watch out for the spectral discus─it ain't tiny, so I reckon it'll be hard to miss!"
msgstr ""

#. ja: ネズミの死骸が浮いてるな<br>なんで、こんなところに…？
#. de: Warum treiben hier bloß so viele Rattenleichen im Wasser?
#. fr: Hein, des os de rongeur<nbsp>!? Qu'est-ce qui s'est passé, ici<nbsp>?
msgctxt "NpcYell:9632:0:13"
msgid "What? Are those...mouse bones? What in the seven hells happened here?"
msgstr ""

#. ja: この海域では夕暮れどき<br>謎の魚が現れるとか…
#. de: Vielleicht tauchen hier bei Sonnenuntergang seltsame Fische auf.
#. fr: Certains disent qu'un mystérieux poisson nage dans ces eaux, quand le soleil se couche...
msgctxt "NpcYell:9633:0:13"
msgid "If you're in the mood for a fright, try fishin' here in the dark. You won't regret it─or maybe you will!"
msgstr ""

#. ja: この暑さ…<br>ヤツが活発に動き出すな
#. de: Bei den Göttern, diese Hitze<nbsp>... Allerdings lockt sie auch so manchen Fisch an.
#. fr: Avec une chaleur pareille, aucun doute que les poissons vont être excités comme des puces<nbsp>!
msgctxt "NpcYell:9634:0:13"
msgid "This heat's rough, but if you can bear the sun beatin' down on you, you'll have your pick of the fish."
msgstr ""

#. ja: この海域には、デカくて<br>のろまな珍しい魚がいるぞ！
#. de: Hier lebt ein riesiger, etwas träger Fisch, der ziemlich selten ist.
#. fr: J'ai entendu parler d'un genre d'énorme poisson bien lourdaud par ici, mais il doit être très rare...
msgctxt "NpcYell:9635:0:13"
msgid "The fish here are huge, and slow as they come! Shouldn't be hard to land a catch."
msgstr ""

#. ja: 噂だが、朝日とともに<br>謎の生物が現れるとか…
#. de: Ich hab gehört, dass ein seltsames Wesen immer morgens zum Sonnenaufgang auftaucht.
#. fr: Vous connaissez la légende de cette créature marine qui sort chasser avec le soleil levant<nbsp>?
msgctxt "NpcYell:9638:0:13"
msgid "Last time we made land someone told me of a fish that swims with the risin' sun."
msgstr ""

#. ja: 遠投をしていた漁師が<br>超大物を釣り上げたらしい
#. de: Ein Fischer hat seine Angel ganz weit ausgeworfen und damit einen dicken Fang gemacht!
#. fr: Certains poissons ont tendance à se laisser avoir par les lancers longs...
msgctxt "NpcYell:9639:0:13"
msgid "I've seen some fishers have luck with a longer cast."
msgstr ""

#. ja: この海域には小型だが<br>気性の荒いヤツがいるぞ！
#. de: Hier leben Fische, die recht klein sind, aber ganz schön wild!
#. fr: Il y a pas mal de petits poissons au tempérament capricieux dans le coin<nbsp>!
msgctxt "NpcYell:9640:0:13"
msgid "The fish here might be small, but they're as fierce as any in the sea!"
msgstr ""

#. ja: 吹雪のときに<br>よく釣れる珍種がいるんだ
#. de: Bei diesem Schneesturm beißen einige seltene Arten ausgezeichnet!
#. fr: Avec un blizzard pareil, on verra peut-être des poissons très spéciaux.
msgctxt "NpcYell:9641:0:13"
msgid "When the wind howls and the thunder claps, the prize catches come out to swim."
msgstr ""

#. ja: 雷に共鳴するように<br>活発に泳ぐ魚がいるらしいぞ
#. de: Wenn Blitze zucken und Donner grollt, so mancher Fisch durchs Wasser tollt. Ist ein altes Sprichwort.
#. fr: Certains poissons montent à la surface seulement quand le ciel se brise. Laissez pas passer cette occasion<nbsp>!
msgctxt "NpcYell:9642:0:13"
msgid "They say when thunder rolls across the sky, it whips certain fish into a frenzy. So they say, anyway."
msgstr ""

#. ja: 幻海流に出会いたいなら<br>小型の魚を狙うといいかもな
#. de: Wenn du einen Fang in der Phantomströmung machen willst, solltest du die Angel nach kleinen Fischen auswerfen.
#. fr: À votre place, je ciblerais le menu fretin pour tomber plus facilement sur un courant éthéré.
msgctxt "NpcYell:9643:0:13"
msgid "If you're lookin' to bait the spectral current, you'll want to cast for the little fish, I reckon."
msgstr ""

#. ja: 夜のこの海域の伝承では<br>船が謎の怪物に襲われるとか…
#. de: Im Finstren der Nacht steigt ein Grauen aus dem Meer, das selbst die mächtigsten Schiffe mühelos in die Tiefen hinabreißt<nbsp>...
#. fr: Une légende raconte que quand la nuit tombe sur ces mers, un monstre surgit des abysses pour vous attaquer<nbsp>!
msgctxt "NpcYell:9644:0:13"
msgid "Local legend has it that when night falls, a horror rises from the depths to drag down unwary vessels..."
msgstr ""

#. ja: この辺りはイカが不漁なんだ<br>何に喰われているのやら…
#. de: Keinen einzigen Tintenfisch haben wir hier gefangen, dabei sollte es vor ihnen nur so wimmeln! Ich frage mich, was sich an ihnen zu schaffen macht<nbsp>...
#. fr: Notre équipage a pas remonté une seule seiche depuis notre arrivée<nbsp>! À se demander par qui elles se font dévorer...
msgctxt "NpcYell:9645:0:13"
msgid "What's been eatin' the squid, then? This spot used to be swarmin' with 'em."
msgstr ""

#. ja: クソッ、雨が激しいな<br>ヤツが活発に動き出すか…
#. de: Bah, das gießt ja wie aus Eimern! Na, zumindest die Fische dürften sich freuen.
#. fr: On est trempés jusqu'aux os, mais au moins y a de la poiscaille<nbsp>!
msgctxt "NpcYell:9646:0:13"
msgid "Bloody hells, it's comin' down in buckets. This'll rile up the schools..."
msgstr ""

#. ja: 中型向けの餌で<br>ヤツを狙ってみな
#. de: Nimm einen Köder für mittelgroße Fische. Vertrau mir, ich habe da so ein Gefühl.
#. fr: Vise ni trop gros ni trop petit, et choisis ton leurre en conséquence. Tu m'en diras des nouvelles<nbsp>!
msgctxt "NpcYell:9647:0:13"
msgid "Bait your hook for fish of middling size. You'll thank me later."
msgstr ""

#. ja: 朝方に、妙な生物を見たんだ<br>まさか海に棲むとは…
#. de: Stell dir vor, heute morgen ist mir eine ganz merkwürdige Kreatur untergekommen. Kann eigentlich kein Fisch sein, aber<nbsp>...
#. fr: J'ai aperçu un étrange animal, ce matin. J'aurais jamais cru voir un truc pareil en pleine mer. P't-être que je dormais encore, remarquez<nbsp>!
msgctxt "NpcYell:9648:0:13"
msgid "Saw an unlikely creature in the water earlier this morning─thought I might still be dreamin'."
msgstr ""

#. ja: 小さな虫を餌にすると<br>珍しい生き物がかかるかもな
#. de: Ein gut gemeinter Rat von einem alten Seebären<nbsp>... Versuch's mal mit kleinen Kriechtieren. 
#. fr: Un p'tit insecte, ça paie pas de mine, mais ça peut rapporter gros au bout d'une ligne<nbsp>!
msgctxt "NpcYell:9649:0:13"
msgid "Little insects are the ticket to some extraordinary catches. Trust me."
msgstr ""

#. ja: 激しい雷だな<br>ヤツの狩りが始まるか…
#. de: Was für ein Wolkenbruch! Ich weiß ganz genau, wer sich bei diesem Mistwetter auf die Jagd macht<nbsp>...
#. fr: Ha ha<nbsp>! Il en tombe comme qui la jette<nbsp>! Le temps va vous mâcher le travail<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:9650:0:13"
msgid "Ugh, it's like sailin' through a damn waterfall. Just the kind of weather <i>they</i> like to hunt in..."
msgstr ""

#. ja: この海域には気をつけろ<br>大型で気性の荒いヤツがいる！
#. de: Jetzt nicht übermütig werden. In diesen Gewässern tummeln sich ein paar garstige Kerle, die auch vor einem Boot nicht Halt machen.
#. fr: Faites gaffe. Dans le coin, y a des bestiaux si gros que c'est pas toujours ceux sur le bateau qui pêchent...
msgctxt "NpcYell:9651:0:13"
msgid "Careful, now. There's some big, mean buggers that swim in these parts, and they ain't shy about comin' up for a bite!"
msgstr ""

#. ja: 夕暮れ時に音が聞こえるんだ<br>何かを噛み砕くような…
#. de: Wenn die Sonne untergeht, dann kann man sie hören. Das Knacken und Krachen, das über die Wellen hallt.
#. fr: Si vous tendez l'oreille au coucher du soleil dans les environs, vous pouvez entendre mâchouiller...
msgctxt "NpcYell:9652:0:13"
msgid "Sometimes after dusk, you hear it echo across the water...a grindin', crackin', crunchin' kind of sound."
msgstr ""

#. ja: この近くの浜辺では<br>砕けた貝殻が散乱してるらしい
#. de: Die Strände dieser Region sind mit Muschelsplittern gesäumt, wie man hört.
#. fr: Un marin m'a dit un jour que les plages du coin étaient entièrement recouvertes de coquillages brisés. Pieds nus, ça doit être l'enfer<nbsp>!
msgctxt "NpcYell:9653:0:13"
msgid "I hear the beaches hereabouts are strewn with bits of shattered shells."
msgstr ""

#. ja: 雷雨の中を、<br>豪快に泳ぎ回る魚がいるらしいぞ。
#. de: Scheinbar gibt es einen bestimmten Fisch, der während Gewittern deutlich aktiver wird.
#. fr: On raconte qu'un certain poisson n'a été vu que par temps d'orage...
msgctxt "NpcYell:9654:0:13"
msgid "Some fish love swimmin' about in a thunderstorm. It's like they're just darin' a bolt to strike!"
msgstr ""

#. ja: 幻海流に出会いたいなら、<br>大型の魚を狙うといいかもな。
#. de: Man sagt, die dicksten Fische kennen den Weg zur Phantomströmung! Wenn du darauf aus bist, dann heißt es alles oder nichts!
#. fr: La seule façon de provoquer un courant spectral, c'est de ferrer de la grosse bête<nbsp>!
msgctxt "NpcYell:9655:0:13"
msgid "No one knows why, but big catches and spectral currents often go hand in hand. What's the ocean tellin' us, I wonder?"
msgstr ""

#. ja: この海域では朝日が昇ると、<br>呼応するように、巨大な魚影が現れるのさ……。
#. de: Es heißt, dass in diesen Gewässern zusammen mit der Morgensonne auch ein riesiger Schatten im Meer erscheint. Fast, als würde er die Sonne begrüßen<nbsp>...
#. fr: Dans ce coin, au lever du soleil, il paraît qu'on peut parfois voir un poisson capable de boucher l'entrée du port de Limsa Lominsa... C'est vrai j'vous dit<nbsp>!
msgctxt "NpcYell:9656:0:13"
msgid "Around here the risin' sun brings big fish, lookin' for a meal. Wouldn't want to miss breakfast."
msgstr ""

#. ja: ある釣り名人が言うには、大物を狙いたいなら、<br>新鮮なサバを活餌にするといいらしいぞ。
#. de: Ein Meisterfischer hat mir letztens verraten, dass frische Makrelen perfekt dafür sein sollen, große Beute anzulocken.
#. fr: L'autre jour, un maître pêcheur m'a dit qu'utiliser un maquereau frais comme appât attirait de plus grosses prises.
msgctxt "NpcYell:9657:0:13"
msgid "A master fisher once told me that he owed his success to the sack of fresh mackerel he always kept close at hand. "
msgstr ""

#. ja: クソッ、すげぇ雨だな！<br>小さな暴れん坊が動き始めそうだ……！
#. de: Verdammt, der Regen heute ist extrem! Da kenn ich einen gewissen kleinen Burschen, der sich dieses Wetter sicher nicht entgehen lassen wird<nbsp>...!
#. fr: Quelle drache<nbsp>! Si ça n'excite pas nos petits copains écailleux, qu'on me fasse marcher sur la planche<nbsp>!
msgctxt "NpcYell:9658:0:13"
msgid "I can barely tell the sea from the rain! Those little buggers love swimmin' in a downpour, though..."
msgstr ""

#. ja: 暴れん坊を狙いたいなら、<br>ヤツよりも小さな餌を使ってみな！
#. de: Wenn du es auf einen der wilderen abgesehen hast, sollte dein Köder kleiner sein als er. Sonst hat er kein Interesse.
#. fr: Les poissons agressifs ne s'attaquent toujours qu'à des plus petits qu'eux. Évitez les appâts trop gros<nbsp>!
msgctxt "NpcYell:9659:0:13"
msgid "Stands to reason that to catch a small fish, you need even smaller bait!"
msgstr ""

#. ja: 噂じゃ、伝説の紅龍の兄弟が、<br>夜になると姿を現すらしいが……。
#. de: Das ist nur ein Gerücht, aber angeblich taucht hier nachts der Bruder des Rubindrachen auf<nbsp>...
#. fr: Les légendes de la mer racontent que le frère du dragon iridescent ne se montre qu'à la tombée de la nuit...
msgctxt "NpcYell:9660:0:13"
msgid "I've heard whispers that a pair of Ruby Dragons prowl these waters at night. Always wanted to see 'em with my own eyes."
msgstr ""

#. ja: 龍ってのは、縄張り意識が強いらしくてな。<br>似た姿のエサを使えば、誘き出せるかもしれん。
#. de: Drachen dulden keine Rivalen in ihren Revieren. Mit Ködern, die ihnen ähnlich sehen, lassen sie sich also durchaus herauslocken.
#. fr: Rien de plus territorial qu'un dragon<nbsp>! Mettez-lui sous le museau un appât qui lui ressemble et vous verrez<nbsp>!
msgctxt "NpcYell:9661:0:13"
msgid "Glass dragons aren't known to suffer competition. If you want to draw one out, make it think a rival's encroachin' on their territory."
msgstr ""

#. ja: 激しい雷だな……。<br>ヤツの動きが活発になりそうだ……。
#. de: Mit den Donnerschlägen heute ist nicht zu spaßen. Da kenne ich einen Fisch, der sich bestimmt bald blicken lassen wird<nbsp>...
#. fr: Avec un tel orage, je serais prêt à parier ma ration de rhum qu'un certain poisson est de sortie...
msgctxt "NpcYell:9662:0:13"
msgid "Storm like this, I'd bet a sack o' gil that a certain fish is on the prowl..."
msgstr ""

#. ja: この海域には要注意だ。<br>中型だが気性の荒いヤツがいるぞ！
#. de: In diesen Gewässern ist Vorsicht geboten. Die Fische sind vielleicht nicht die größten, aber da sind ein paar ganz schön ungestüme Exemplare dabei.
#. fr: Éloignez les Lalafells du bastingage, les poissons sont fourbes dans ces eaux...
msgctxt "NpcYell:9663:0:13"
msgid "Keep your wits about you in these waters. The fish might not look it, but they can pull that rod right out of your hands!"
msgstr ""

#. ja: 船乗りたちの噂なんだが、<br>日が暮れると、海底を蠢く火山が現れるらしいぞ。
#. de: Unter Seeleuten wird scheinbar gemunkelt, dass es in dieser Gegend einen Unterwasservulkan gibt, der nach Sonnenuntergang unruhig wird<nbsp>...
#. fr: Des marins m'ont dit qu'à la tombée de la nuit, on peut voir des volcans sous-marins entrer en éruption...
msgctxt "NpcYell:9664:0:13"
msgid "Sailors say that when night falls, you can see a volcano come to life on the ocean floor, like a single red eye openin' in the darkness."
msgstr ""

#. ja: この海域ではイカがよく釣れるんだが……<br>もしかしたら、ヤツもそれが狙いなのかもな。
#. de: Nirgendwo sonst findet man mehr Tintenfische als hier! Aber sei auf der Hut, wir sind sicher nicht die einzigen, denen das bewusst ist<nbsp>...
#. fr: Si c'est des céphalopodes que vous voulez, vous êtes au bon endroit<nbsp>! Mais mon petit doigt me dit qu'on est pas les seuls à lorgner dessus...
msgctxt "NpcYell:9665:0:13"
msgid "Squid are a common sight around here, as are the things that come to hunt 'em."
msgstr ""

#. ja: 激しい雨だな……。<br>ヤツが浮上してくるかもしれんぞ？
#. de: Was für ein Wolkenbruch! Ich weiß ganz genau, wer sich bei diesem Mistwetter gerne zeigt<nbsp>...
#. fr: Il pleut des cordes... On risque d'avoir un invité surprise qui adore ce temps...
msgctxt "NpcYell:9666:0:13"
msgid "Sometimes you have to get soakin' wet to have a chance at catchin' the best fish."
msgstr ""

#. ja: この辺りには気をつけろ。<br>大型で獰猛なヤツが、船体に体当たりしてくるんだ。
#. de: Diese Gegend ist gefährlich. Hier treibt eine große, wilde Bestie ihr Unwesen, die gerne Mal mit voller Wucht gegen Schiffe rammt.
#. fr: J'espère que vous avez le pied marin, les gros balourds qui écument ces eaux adorent cogner la coque<nbsp>!
msgctxt "NpcYell:9667:0:13"
msgid "Brace yourselves against something sturdy. The big bastards in these waters like to give passin' boats a love tap from time to time."
msgstr ""

#. ja: この辺りじゃ、朝焼けとともに、<br>水中に満開の梅が咲くって言い伝えがあるんだぜ？
#. de: Man sagt, dass man hier nicht nur den Sonnenaufgang, sondern auch die Blüten der Pflaume in all ihrer Pracht erleben kann<nbsp>...
#. fr: L'autre matin, des mousses ayant forcé sur la bibine racontent avoir vu des pruniers fleurir au fond de l'eau...
msgctxt "NpcYell:9668:0:13"
msgid "Sailors passin' through these parts have told stories of an undersea flower bed in full bloom."
msgstr ""

#. ja: この辺りの梅の木には、<br>活きのいい昆虫が集まるらしいな。
#. de: Die ganzen Pflaumenbäume hier locken immer einen Haufen Insekten an.
#. fr: Il paraît que le menu fretin a tendance à se rassembler à l'ombre des pruniers.
msgctxt "NpcYell:9669:0:13"
msgid "The plum trees are a sight to behold─if you can ignore the bugs swarmin' around them, that is."
msgstr ""

#. ja: 激しい雨だな……。<br>星型のヤツの動きが、活発になりそうだ……。
#. de: War ja klar, dass es grad <i>jetzt</i> so schütten muss<nbsp>... Vielleicht bringt das zumindest 'nen paar Arten an Seesternen auf Trab. Die stehen auf so raues Wetter.
#. fr: Il pleut des cordes... Voilà qui risque de donner la bougeotte aux bestioles en forme d'étoile...
msgctxt "NpcYell:9670:0:13"
msgid "This rain ain't lettin' up... But some species of starfish love swimmin' 'round rough currents like these."
msgstr ""

#. ja: 小型向けの餌を使えば、<br>星型のヤツを誘い出せるかもな！
#. de: Die Seesterne in dieser Gegend bevorzugen kleinere Köder. Behalt das im Hinterkopf, falls du's auf einen abgesehen hast.
#. fr: Les bébêtes en forme d'étoile raffolent des appâts pour créatures de petite taille<nbsp>!
msgctxt "NpcYell:9671:0:13"
msgid "The starfish in these waters prefer snackin' on smaller bits of bait, if you're lookin' to haul up somethin' different."
msgstr ""

#. ja: 船乗りの間で噂になっているんだが、<br>黄昏時に、付近の島が動いて見えるらしいぞ……。
#. de: Ist bestimmt nur Seemannsgarn, aber es gibt echt Leute, die drauf schwören, die Inseln hier würden sich bei Sonnenuntergang bewegen<nbsp>...
#. fr: Parmi les marins, la rumeur court qu'au crépuscule, les îles environnantes se déplacent...
msgctxt "NpcYell:9672:0:13"
msgid "Some sailors say the islands 'round here start wanderin' across the tides at sunset..."
msgstr ""

#. ja: この辺りを漁場にする仲間から聞いたんだが、<br>魚群を追って狙うかのように、島影が動くらしいぞ……。
#. de: Ein paar alte Kumpels haben mir erzählt, dass hier die Inseln selbst auf Beutejagd gehen und Fischschwärme verfolgen. Schwer zu glauben, aber wär auch nich' das Verrückteste, was ich erlebt hätte.
#. fr: Un ami qui pêche par ici m'a dit que les ombres des îles du coin pouvaient se mouvoir, comme si elles partaient à la pêche...
msgctxt "NpcYell:9673:0:13"
msgid "Some ol' chums of mine claim they've seen entire bloody islands sneakin' after schools of fish here. Hard to believe, but...nothin's impossible."
msgstr ""

#. ja: クソッ、すげぇ雨だな！<br>嵐を好むという、ヤツが暴れまわりそうだ……！
#. de: Meine Fresse, der Regen will's heute echt wissen, was? Wobei ich da 'nen besonders lebhaften Kollegen kenne, der sich gerade bei solchen Stürmen am liebsten blicken lässt<nbsp>...
#. fr: La vache, quelle tempête<nbsp>! On risque fort de voir apparaître un invité de marque<nbsp>!
msgctxt "NpcYell:9674:0:13"
msgid "Seven hells, the rain's got it out for us today! Bet there's a wily wavekin in the depths, revelin' in these roilin' waves..."
msgstr ""

#. ja: 中型向けの餌を使ってみな！<br>ヤツが噛みついてくるはずだ……！
#. de: Ein kleiner Tipp von mir: Benutz am besten mittelgroße Köder. Dann werden die Viecher kaum widerstehen können.
#. fr: Les appâts de taille moyenne devraient faire l'affaire<nbsp>! Ils correspondent pile-poil à la taille des poissons d'ici<nbsp>!
msgctxt "NpcYell:9675:0:13"
msgid "Word of advice for you─bait your hook with the average-sized fish in mind. The bastards'll be bitin' in no time."
msgstr ""

#. ja: この辺りは夜になると、<br>蛇の威嚇のような音が聞こえるらしいぞ……。
#. de: Unter Seeleuten wird scheinbar gemunkelt, dass man nachts in dieser Gegend das unheimliche Zischen einer Schlange hören kann<nbsp>...
#. fr: À la tombée de la nuit, on entend des bruits bizarres, comme des sifflements de serpent...
msgctxt "NpcYell:9676:0:13"
msgid "They say when night falls upon these seas, you can hear the slitherin' of an ancient serpent, echoin' across the pitch-black surf..."
msgstr ""

#. ja: この近くを通過すると、船上の小動物が、<br>目を離した隙に消えてることがあるんだってよ。
#. de: Falls du irgendwelche kleinen Tierchen an Bord gebracht hast, lass sie lieber keinen Moment aus den Augen. In dieser Gegend sind sie sonst schneller verschwunden, als du dich umdrehen kannst<nbsp>...
#. fr: Apparemment, lorsqu'on traverse cette zone, les petits animaux présents sur le bateau dis<shy>pa<shy>rais<shy>sent comme par magie dès qu'on regarde ailleurs.
msgctxt "NpcYell:9677:0:13"
msgid "Keep a sharp eye on any small animals you may've brought, lest you want 'em stolen away─but by what manner of monster, no one quite knows..."
msgstr ""

#. ja: コケーッ！
#. de: Ga-Gack!
#. fr: Cot cot<nbsp>!
msgctxt "NpcYell:9701:0:13"
msgid "Cluck cluck!"
msgstr ""

#. ja: ココココ…<br>コケッー！
#. de: Gack ... Gack Gack!
#. fr: Cot cot codeeet<nbsp>!!!
msgctxt "NpcYell:9702:0:13"
msgid "Cluck... Cluck! Cluck!"
msgstr ""

#. ja: 待て、逃げるな！
#. de: H-He! Hiergeblieben!
#. fr: Revenez ici, vous<nbsp>!
msgctxt "NpcYell:9703:0:13"
msgid "W-Wait...get back here!"
msgstr ""

#. ja: はぁはぁ…
#. de: Puh ... Uff ...
#. fr: (halète) (halète)
msgctxt "NpcYell:9704:0:13"
msgid "\\<pant> \\<pant>"
msgstr ""

#. ja: 追いかけて<br>網で「捕獲」するんだ！
#. de: Hinterher! Fang sie mit dem Netz!
#. fr: Surtout, bien viser<nbsp>!
msgctxt "NpcYell:9705:0:13"
msgid "Chase down those birds and nab them in your nets!"
msgstr ""

#. ja: 「トリモチ」で<br>動きを鈍らせて！
#. de: Mit dem Vogelleim kannst du sie verlangsamen!
#. fr: Une boule de glu, ça devrait les ralentir<nbsp>!
msgctxt "NpcYell:9706:0:13"
msgid "Use birdlime to slow them down!"
msgstr ""

#. ja: ニワトリを<br>傷つけないようにね！
#. de: Aber sei zärtlich, ja?!
#. fr: Attention à ne pas blesser les poules<nbsp>!
msgctxt "NpcYell:9707:0:13"
msgid "Be gentle with the birds, okay!?"
msgstr ""

#. ja: 元気なニワトリだなぁ…
#. de: Wild, diese Hühner ...
#. fr: C'est pas des poules, c'est des autruches...
msgctxt "NpcYell:9708:0:13"
msgid "These are some feisty chickens..."
msgstr ""

#. ja: ありがとう<br>助かったよ！
#. de: Danke! Ich danke dir!
#. fr: Merci, t'as assuré<nbsp>!
msgctxt "NpcYell:9709:0:13"
msgid "Thank you, friend! You're a lifesaver!"
msgstr ""

#. ja: よかったら<br>また手伝ってくれよ！
#. de: Wir nehmen deine Hilfe gerne wieder in Anspruch!
#. fr: Joli coup de filet<nbsp>!
msgctxt "NpcYell:9710:0:13"
msgid "Please lend us your aid again!"
msgstr ""

#. ja: 逃げ出したニワトリは<br>あと何羽だっけ…？
#. de: Wie viele Hühner sind denn jetzt noch ausgebüxt?
#. fr: Le compte de poules y est<nbsp>?
msgctxt "NpcYell:9711:0:13"
msgid "How many more are still out there!?"
msgstr ""

#. ja: あっ<br>こら待て！
#. de: Halt! Nicht!!
#. fr: Reste un peu tranquille<nbsp>!
msgctxt "NpcYell:9712:0:13"
msgid "Wait... I said wait!"
msgstr ""

#. ja: みんなー！<br>早く戻ってこーい！
#. de: Kommt zurück, verflixt!
#. fr: R-repli stratégique<nbsp>!
msgctxt "NpcYell:9713:0:13"
msgid "Get back here already, will you!?"
msgstr ""

#. ja: はぁ…<br>もう無理…
#. de: Ach ... Ich gebe auf ...
#. fr: (halète) J'en peux plus, j'abandonne...
msgctxt "NpcYell:9714:0:13"
msgid "\\<pant> I've had enough..."
msgstr ""

#. ja: パレードの集合場所は<br>この辺りか…？
#. de: Bin ich hier richtig für die Hasenparade?
#. fr: C'est bien ici pour la parade<nbsp>?
msgctxt "NpcYell:9715:0:13"
msgid "Am I in the right place for the procession?"
msgstr ""

#. ja: 飾りタマゴも<br>準備完了よ！
#. de: Alle Eier sind verziert und gefüllt!
#. fr: J'ai fait le plein d'œufs avant de venir<nbsp>!
msgctxt "NpcYell:9716:0:13"
msgid "The eggs are ready. Let the festivities begin!"
msgstr ""

#. ja: フフッ…この投資も<br>新規顧客獲得のため…
#. de: Die Kinder von heute sind die Kunden von morgen ...
#. fr: Les enfants d'aujourd'hui sont les clients de demain, héhé...
msgctxt "NpcYell:9717:0:13"
msgid "Heh. Today's smilin' children are tomorrow's loyal customers."
msgstr ""

#. ja: この着ぐるみ…<br>蒸し暑すぎるンだよ…
#. de: Uff, in diesem Kostüm ist es heißer als in der Sagolii-Wüste!
#. fr: Bordel, cette tête de lapin de mes deux me donne chaud au crâne...
msgctxt "NpcYell:9718:0:13"
msgid "Can I take this godsdamned rabbit's pate off? It's godsdamned swelterin' in here!"
msgstr ""

#. ja: お、集まっているようだね！
#. de: Ich sehe, es haben sich schon einige versammelt!
#. fr: Ah, je vois qu'on a du monde<nbsp>!
msgctxt "NpcYell:9719:0:13"
msgid "It seems the gang's all here!"
msgstr ""

#. ja: 皆さん、準備はいいですか？<br>パレードを開始しますよ！
#. de: Darf ich um Aufmerksamkeit bitten? Die Parade fängt gleich an!
#. fr: Votre attention, s'il vous plaît<nbsp>! Je vais à présent donner le départ de la parade<nbsp>!
msgctxt "NpcYell:9720:0:13"
msgid "Are you ready, my friends? The parade is about to begin!"
msgstr ""

#. ja: 目指すは槍術士ギルド！<br>飛び入り参加も歓迎です！
#. de: Wir marschieren Richtung Gilde der Pikeniere. Es ist auch möglich, mittendrin einzusteigen.
#. fr: Nous marcherons d'ici jusqu'à la guilde des maîtres d'hast<nbsp>! Vous êtes libres de quitter le cortège ou de le rejoindre à tout moment.
msgctxt "NpcYell:9721:0:13"
msgid "We make for the Lancers' Guild! Come one, come all!"
msgstr ""

#. ja: それでは出発～！
#. de: Alle bereit? Ohren steif und los geht's!
#. fr: Tout le monde est prêt<nbsp>?<nbsp>... En avant, marche<nbsp>!
msgctxt "NpcYell:9722:0:13"
msgid "And we're off!"
msgstr ""

#. ja: わぁ！<br>スプリガンも集まってきた！
#. de: Oh nein! Spriggans!
#. fr: Oh<nbsp>! Les spriggans aussi veulent défiler, on dirait<nbsp>!
msgctxt "NpcYell:9723:0:13"
msgid "Spriggans!? Why does it always have to be spriggans..."
msgstr ""

#. ja: さあさあ、盛り上がろう！
#. de: Immer lächeln! Zeigt eure hübschen Hasenzähne!
#. fr: Motivés, motivés<nbsp>!
#. macro: <hyphen> — a hyphen that does not break the line (may be added or dropped)
msgctxt "NpcYell:9724:0:13"
msgid "Show some spirit! It's Hatching<hyphen>tide, after all!"
msgstr ""

#. ja: 販売促進！<br>商売繁盛！
#. de: ♪ Ich werde meine Eier los und mache Werbung kostenlos! ♪
#. fr: À moi, la publicité gratuite<nbsp>!♪
msgctxt "NpcYell:9725:0:13"
msgid "Anythin' to drum up business..."
msgstr ""

#. ja: 喉が渇いちまった…<br>酒はあるンだろうな？
#. de: Ich habe Durst ... Wo gibt's Wein für die Helfer?
#. fr: J'ai soif... Quelqu'un aurait de l'alcool de carotte à me filer<nbsp>?
msgctxt "NpcYell:9726:0:13"
msgid "What does a bloke have to do to get a bleedin' drink around here!?"
msgstr ""

#. ja: さあ、子どもたちに「プレゼント」してください！
#. de: Die ersten Kinder sind da! Keines soll mit leeren Händen nach Hause gehen!
#. fr: Les premiers enfants arrivent<nbsp>! À vous de jouer<nbsp>!
#. macro: <hyphen> — a hyphen that does not break the line (may be added or dropped)
msgctxt "NpcYell:9727:0:13"
msgid "Don't forget the children! Share the gift of Hatching<hyphen>tide with one and all!"
msgstr ""

#. ja: こちらにも森都の子どもたちがいますよ！
#. de: Hier sind auch noch ein paar Kinder!
#. fr: Il y a d'autres enfants par ici<nbsp>! Venez vite<nbsp>!
msgctxt "NpcYell:9728:0:13"
msgid "Over here! No child must go home empty-handed!"
msgstr ""

#. ja: では、次の場所に進みましょう！
#. de: Lasst uns weiterziehen zum nächsten Ort!
#. fr: La route est encore longue. Suivez-moi, mes lapins<nbsp>!
msgctxt "NpcYell:9729:0:13"
msgid "Our work here is done! Time to move on!"
msgstr ""

#. ja: 「プレゼント」の準備を！<br>子どもたちがいますよ！
#. de: Ich sehe Kinder! Zückt die Geschenke!
#. fr: Voilà encore des enfants<nbsp>! Tous à vos œufs<nbsp>!
msgctxt "NpcYell:9730:0:13"
msgid "Prepare the presents! The children await!"
msgstr ""

#. ja: オレは職人であって<br>子守じゃねぇンだよ…！
#. de: Ich bin Handwerker und kein Kindermädchen ...
#. fr: Eurgh, j'ai horreur des chiards... J'préfère cent fois les bouilloires...
msgctxt "NpcYell:9731:0:13"
msgid "I'm a weaponsmith, not a bleedin' wet nurse!"
msgstr ""

#. ja: コラ、サボルナ！<br>タマゴ、クバレ、クバレ！
#. de: Pfui, pfuii! Nicht auf faule Haut liegen! Ei verteilen, eiii!
#. fr: Pas rester bras croisés<nbsp>! Distribuer œufs<nbsp>!
msgctxt "NpcYell:9732:0:13"
msgid "Spriggy spriggy! Eggs so pretty!"
msgstr ""

#. ja: イギギ！<br>ハタラケ、ハタラケ！
#. de: Dalli, dalliii!
#. fr: Au boulot, au boulot<nbsp>! Sinon Riggy pas content<nbsp>!
msgctxt "NpcYell:9733:0:13"
msgid "Spriggy say less talky, more givy!"
msgstr ""

#. ja: なっ、何しやがる！？
#. de: W-Was willst du von mir?
#. fr: Qu-qu'est-ce que vous m'voulez, les boules de suie<nbsp>!?
msgctxt "NpcYell:9734:0:13"
msgid "Seven hells! What in the─!?"
msgstr ""

#. ja: わ、わかった、わかった！<br>だから、近寄るンじゃねぇ！
#. de: Ja, ja, schon verstanden! Aber komm mir bloß nicht zu nahe!
#. fr: OK, OK, jai compris<nbsp>! Pas la peine de s'énerver<nbsp>!
msgctxt "NpcYell:9735:0:13"
msgid "Alright, already! Just get your bloody paws off me!"
msgstr ""

#. ja: あの人…<br>もしかして…
#. de: Ist der halbnackte Hase dort womöglich ...?
#. fr: Ce type torse nu me rappelle quelqu'un...
msgctxt "NpcYell:9736:0:13"
msgid "I could swear I've heard that voice somewhere..."
msgstr ""

#. ja: まさか…ねぇ？
#. de: Nein, unmöglich ... Obwohl ...
#. fr: Non... Quand même pas...
msgctxt "NpcYell:9737:0:13"
msgid "No, it couldn't be..."
msgstr ""

#. ja: ねぇ、ねぇ！<br>タマゴくれないの～！
#. de: Wo ist denn jetzt mein Wunderei?
#. fr: Il est où, mon œuf<nbsp>?
msgctxt "NpcYell:9738:0:13"
msgid "Mister Rabbit! Missus Rabbit! Do you have an egg for me!?"
msgstr ""

#. ja: タマゴちょうだ～い？
#. de: Ich will ein Wunderei!
#. fr: J'peux avoir un œuf<nbsp>?
msgctxt "NpcYell:9739:0:13"
msgid "And me! I want an egg, too!"
msgstr ""

#. ja: 次の目的地に移動しますよ！
#. de: Hier sind alle Kinder versorgt. Lasst uns weitergehen!
#. fr: C'est bon pour cet endroit. Allez, on continue<nbsp>!
msgctxt "NpcYell:9740:0:13"
msgid "No dilly-dallying! We must move on!"
msgstr ""

#. ja: 終着点の槍術士ギルドは、もうすぐですよ！
#. de: Die Parade endet bei der Gilde der Pikeniere. Bald sind wir da!
#. fr: Encore un effort, on y est presque<nbsp>!
msgctxt "NpcYell:9741:0:13"
msgid "The Lancers' Guild is up ahead. Just a bit further now!"
msgstr ""

#. ja: そろそろパレードは終了！<br>「プレゼント」はできましたか？
#. de: Bald haben wir es geschafft. Hast du viele Kinder beschenken können?
#. fr: Et voilà, on est arrivés<nbsp>! Je vous laisse encore quelques secondes pour distribuer vos derniers œufs<nbsp>!
msgctxt "NpcYell:9742:0:13"
msgid "The procession is almost at an end. How many children smiled because of you today?"
msgstr ""

#. ja: 反乱分子を<br>見つけ出すんだ…！
#. de: Ich werd die Störenfriede alle umballern!
#. fr: Trouvez la faction rebelle<nbsp>!
msgctxt "NpcYell:9743:0:13"
msgid "We must drive them out!"
msgstr ""

#. ja: 蛮族どもに<br>情け容赦は無用だぞ！
#. de: Mit den Wilden braucht man kein Mitleid zu haben!
#. fr: Exécutez ces sauvages jusqu'au dernier<nbsp>!
msgctxt "NpcYell:9744:0:13"
msgid "There's only one thing these savages are good for..."
msgstr ""

#. ja: まだやれるっての！
#. de: Denk ja nicht, ich wäre besiegt!
#. fr: J-je peux le faire<nbsp>!
msgctxt "NpcYell:9745:0:13"
msgid "Just getting started!"
msgstr ""

#. ja: 嗚呼…負ケタノネ…<br>アノ時ト、イッショ…
#. de: Nein, unmöglich<nbsp>...  das kann nicht<nbsp>...  mein Schicksal sein<nbsp>... 
#. fr: Je suis défaite... comme la dernière fois...
msgctxt "NpcYell:9746:0:13"
msgid "That I should lose again..."
msgstr ""

#. ja: これにて<br>パレードはおしまい！
#. de: Ich verkünde hiermit das Ende der Parade!
#. fr: Et... top, c'est fini<nbsp>!
msgctxt "NpcYell:9747:0:13"
msgid "This marks the end of the procession!"
msgstr ""

#. ja: またのご参加を<br>お待ちしております！
#. de: Vielen Dank an alle, die teilgenommen haben!
#. fr: Merci à tous d'avoir participé<nbsp>!
msgctxt "NpcYell:9748:0:13"
msgid "Be proud, my friends, for you have made many a child happy this day!"
msgstr ""

#. ja: エッグハントの期間中なら<br>何度でも参加できるよ！
#. de: Es finden noch weitere Paraden während der Wundereiersuche statt.
#. fr: N'hésitez pas à revenir nous prêter main-forte durant toute la durée de la fête<nbsp>!
msgctxt "NpcYell:9749:0:13"
msgid "Should you be willing to join us again, we welcome your participation."
msgstr ""

#. ja: それでは次のパレードで<br>お会いしましょう！
#. de: Nochmals danke und hoffentlich bis zum nächsten Mal!
#. fr: J'espère vous revoir à la prochaine parade<nbsp>!
#. macro: <hyphen> — a hyphen that does not break the line (may be added or dropped)
msgctxt "NpcYell:9750:0:13"
msgid "Till next time, a happy Hatching<hyphen>tide to one and all!"
msgstr ""

#. ja: よおし、久方ぶりの復興共同作業だ！<br>皆、気張っていくぞッ！
#. de: Das letzte Projekt des Wieder<shy>aufbaus ist lange her! Keine Müdigkeit vorschützen!
#. fr: Allez, les travaux reprennent<nbsp>! Mettez du cœur à l'ouvrage<nbsp>!
msgctxt "NpcYell:9751:0:13"
msgid "All right, people, it's time for our first concerted works in a while!"
msgstr ""

#. ja: まずは十字鍬通りを整備する！<br>道をふさぐ「大きな瓦礫」を切り崩す作業を頼む！
#. de: Für das Kreuzkarst-Spalier muss erst mal der ganze Schutt weggeräumt werden!
#. fr: On va commencer par faire le ménage sur Le Hoyau<nbsp>!<br>Déblayez-moi tout ça<nbsp>!
msgctxt "NpcYell:9752:0:13"
msgid "We're buildin' the Mattock, and to begin with, we need to clear away the debris!"
msgstr ""

#. ja: ここはまさに復興作業の入り口……！<br>皆が、その一歩を切り開いていくんだッ！
#. de: Das ist der erste Schritt unseres Großprojektes! Legt euch also besonders ins Zeug!
#. fr: Tous ceux qui viennent à Azurée emprunteront ce pont, alors je veux du propre<nbsp>!
msgctxt "NpcYell:9753:0:13"
msgid "It's the first of many steps to come, so let's see this off to a good start!"
msgstr ""

#. ja: 職人方、物資の納品感謝する！<br>さあ、復興共同作業を始めようぜ！
#. de: Alle nötigen Materialien sind da! Setzen wir sie nun ordentlich um!
#. fr: Nos artisans de choc nous ont livré assez de matos<nbsp>!<br>On va pouvoir se remettre au boulot<nbsp>!
msgctxt "NpcYell:9754:0:13"
msgid "We've got the supplies we need. Now it's time to get to work!"
msgstr ""

#. ja: 引き続き、通りの整備を進めるぞ！<br>道をふさぐ「大きな瓦礫」を切り崩す作業を頼む！
#. de: Und wieder muss ordentlich Schutt beiseite geschafft werden!
#. fr: On continue le déblaiement du Hoyau.<br>Réduisez-moi tout ça en miettes<nbsp>!
msgctxt "NpcYell:9755:0:13"
msgid "It's the same task as before─clearing away debris in preparation for the road!"
msgstr ""

#. ja: 復興の障害を、<br>まさに皆で取り払っていくんだッ！
#. de: Alles, was uns im Weg steht, räumen wir einfach weg!
#. fr: Un chantier, c'est comme un établi<nbsp>!<br>Faut que ça reste propre pour faire du bon travail<nbsp>!
msgctxt "NpcYell:9756:0:13"
msgid "Let's see to it nothin' lies in the way of the reconstruction effort!"
msgstr ""

#. ja: 復興作業を開始するッ！<br>みんな、位置についてくれ！
#. de: Na los, auf eure Stationen! Wir fangen an!
#. fr: Il est grand temps de passer un bon coup de balai sur Le Hoyau<nbsp>!
msgctxt "NpcYell:9757:0:13"
msgid "To your places, everyone. It's time to get to work!"
msgstr ""

#. ja: 今回は十字鍬通りの「微細な瓦礫片」の清掃を行う！
#. de: Jetzt geht's an die letzten Schuttreste, die unser Kreuzkarst-Spalier blockieren!
#. fr: On vous en a déjà fourni un normalement, alors ramassez la pierraille qui reste<nbsp>!
msgctxt "NpcYell:9758:0:13"
msgid "Today, we're clearing away the last little bits of debris on the Mattock."
msgstr ""

#. ja: ここでの仕事の質が、次に影響する……。<br>焦らず丁寧に頼む！
#. de: Das hier ist die Grundlage für unseren nächsten Arbeitsschritt, also seid besonders aufmerksam!
#. fr: Plus ce sera propre, mieux vous pourrez œuvrer plus tard.<br>Alors appliquez-vous<nbsp>!
msgctxt "NpcYell:9759:0:13"
msgid "How good a job we do will tell on the next works, so let's make it squeaky clean!"
msgstr ""

#. ja: 物資が充分に供給されたんで、<br>復興共同作業を始めるぞ！
#. de: Unser Materiallager platzt aus allen Nähten. Lasst uns das gemeinsam ändern!
#. fr: On a réuni assez de matériaux pour s'attaquer aux travaux de réfection du Hoyau<nbsp>!
msgctxt "NpcYell:9760:0:13"
msgid "Our stores are in good order, which means it's time for more concerted works!"
msgstr ""

#. ja: 十字鍬通りの舗装のため、<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Schaffen wir dem Kreuzkarst-Spalier ein ordentliches Pflaster!
#. fr: Prenez ce qu'il vous faut dans les piles et mettez-vous au boulot<nbsp>!
msgctxt "NpcYell:9761:0:13"
msgid "Grab the supplies you need, and let's pave the way─literally and figuratively!"
msgstr ""

#. ja: 十字鍬通りの修復も完了目前だ！<br>職人としての技術を、見せつけてほしいッ！
#. de: Nur noch ein bisschen! Haltet durch!
#. fr: On y est presque, alors courage<nbsp>!<br>Montrez ce que vous avez dans le ventre<nbsp>!
msgctxt "NpcYell:9762:0:13"
msgid "The end's in sight, so give it everything you've got!"
msgstr ""

#. ja: よし、次の復興共同作業に取りかかるッ！<br>皆、準備はいいか！
#. de: Das nächste Aufbauprojekt möge beginnen!
#. fr: Rassemblez-vous<nbsp>! On va enfin faire plus dans l'artistique<nbsp>!
msgctxt "NpcYell:9763:0:13"
msgid "All right! It's time for the next round of concerted works! "
msgstr ""

#. ja: ここには噴水を建設する予定だ！<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Bauen wir einen hübschen Brunnen für die zukünftigen Bewohner der Himmelsstadt!
#. fr: Aujourd'hui, on va bosser sur les fontaines<nbsp>! Comme d'habitude tout est déjà prêt.<br>Servez-vous dans les piles, et mettez-y de l'huile de coude<nbsp>!
msgctxt "NpcYell:9764:0:13"
msgid "We're gettin' started on the fountain. Grab the supplies you need and put 'em to use!"
msgstr ""

#. ja: 住人の憩いの場になる広場だ。<br>皆の職人魂を見せてくれッ！
#. de: Spart keine Mühen, diesen Platz so ansehnlich wie möglich zu machen!
#. fr: C'est là que les habitants viendront se détendre.<br>Alors faites étalage de votre talent<nbsp>!
msgctxt "NpcYell:9765:0:13"
msgid "This will be a place of rest and relaxation for residents, so let's not spare any effort!"
msgstr ""

#. ja: 今回の復興共同作業で噴水を完成させるぞ！<br>皆、協力を頼む！
#. de: Heute schließen wir den Brunnen ab und lassen seine Wasser fließen!
#. fr: À vos marteaux<nbsp>! C'est le moment d'ajouter les dernières touches aux fontaines<nbsp>!
msgctxt "NpcYell:9766:0:13"
msgid "I hope you're all ready to work, because today we're makin' that fountain flow!"
msgstr ""

#. ja: 「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Holt euch das, was ihr braucht, einfach vom Materialstapel!
#. fr: Pareil que la dernière fois<nbsp>! Des piles de matériaux et des postes de travail ont été mis à disposition<nbsp>!
msgctxt "NpcYell:9767:0:13"
msgid "Everything you need, you can get from the supply pile!"
msgstr ""

#. ja: 皆の力で、美しい広場を造りあげてほしい！
#. de: Na los! Machen wir das hier zum schönsten Plätzchen in ganz Ishgard!
#. fr: Je veux que cette place rivalise avec Le Hoplon, alors au boulot<nbsp>!
msgctxt "NpcYell:9768:0:13"
msgid "Let's make it into a beautiful place the residents can be proud of!"
msgstr ""

#. ja: 復興共同作業の開始だ！<br>今回からは聖ロエル広場修復に取りかかる！
#. de: Ab heute beginnen wir die Arbeiten an der Estrade der Sankt Roelle!
#. fr: Aujourd'hui, on passe à l'estrade de Sainte Roelle, les enfants<nbsp>!
msgctxt "NpcYell:9769:0:13"
msgid "All right, everyone. From today, we're commencin' works on Saint Roelle's Dais!"
msgstr ""

#. ja: まずは足場を建設する！<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Als Allererstes brauchen wir stabile Gerüste. Schnappt euch Material und macht euch an die Arbeit!
#. fr: Commençons par dresser les échafaudages<nbsp>!
msgctxt "NpcYell:9770:0:13"
msgid "First things first: we need scaffolds. Grab yourselves some supplies and get to it!"
msgstr ""

#. ja: これからの作業の基礎となる部分だ！<br>安全第一で頼む！
#. de: Schludrigkeiten können wir uns dabei ganz besonders nicht erlauben!
#. fr: C'est la base, alors je veux pas voir de bobos, c'est compris<nbsp>!?
msgctxt "NpcYell:9771:0:13"
msgid "We're layin' the groundwork for what's to come, so let's make it as sturdy as can be!"
msgstr ""

#. ja: 聖ロエル広場の復興共同作業を開始するぞ！
#. de: Jetzt soll die Estrade ordentlich Gestalt annehmen!
#. fr: On va avancer sur l'estrade de Sainte Roelle<nbsp>!
msgctxt "NpcYell:9772:0:13"
msgid "Right then, it's time to get busy on Saint Roelle's Dais!"
msgstr ""

#. ja: この通路も荒れ放題だ……。<br>道をふさぐ「大きな瓦礫」を切り崩す作業を頼む！
#. de: Der Schutt liegt im Weg. Alles muss weg!
#. fr: Les échafaudages sont prêts, mais on va d'abord se débarrasser de la caillasse<nbsp>!
msgctxt "NpcYell:9773:0:13"
msgid "The area's a mess of debris, so that's what we're gonna work on today."
msgstr ""

#. ja: 文字通り、道を切り開いていくんだッ！
#. de: Heute bahnen wir uns ganz bildlich einen Weg in die Zukunft!
#. fr: Je veux un chantier propre, alors au boulot<nbsp>!
msgctxt "NpcYell:9774:0:13"
msgid "Let's put our backs into it and clear ourselves a path!"
msgstr ""

#. ja: 皆、準備はいいか！？<br>復興共同作業を始めるッ！！
#. de: Alle Vor<shy>bereitungen getroffen? Dann kann das Aufbauprojekt ja beginnen!
#. fr: J'espère que vous avez cassé la croûte, parce qu'on passe à la suite<nbsp>!
msgctxt "NpcYell:9775:0:13"
msgid "Get ready, everyone! It's time for another round of concerted works!"
msgstr ""

#. ja: 今回は聖ロエル広場の「微細な瓦礫片」の清掃を行う！
#. de: Befreien wir die Estrade vom allerletzten Schutt!
#. fr: Vous avez bien dégagé le chemin la dernière fois, mais il faut encore s'occuper des débris plus fins<nbsp>!
msgctxt "NpcYell:9776:0:13"
msgid "We're clearin' away the last bits of debris scattered across Saint Roelle's Dais."
msgstr ""

#. ja: 地道な作業だが、丁寧に頼むぞ！
#. de: Wenn euch die Hände schmerzen, dann denkt an diejenigen, für die wir uns hier ins Zeug legen!
#. fr: Attention, je veux voir personne tirer au flanc, c'est un travail aussi important que les autres<nbsp>!
msgctxt "NpcYell:9777:0:13"
msgid "Might be as it's a humble task, but let's do a tidy job of it!"
msgstr ""

#. ja: 物資が想定量に達した！<br>皆、復興共同作業に参加してほしい！
#. de: Die Materialsammlung ist fertig! Nichts wie ran an die Arbeit!
#. fr: Bonne nouvelle<nbsp>: on a assez de matériaux pour enchaîner<nbsp>!
msgctxt "NpcYell:9778:0:13"
msgid "We've reached our target for supplies. Time to get to work again!"
msgstr ""

#. ja: 聖ロエル広場の舗装のため、<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Die Estrade braucht eine ganze Menge fähiger Hände, bis sie wieder in voller Pracht erstrahlen kann!
#. fr: On va retaper le pavage de l'estrade de Sainte Roelle<nbsp>! Au travail<nbsp>!
msgctxt "NpcYell:9779:0:13"
msgid "Grab what you need from the supply pile, and we'll start fixin' up Saint Roelle's Dais!"
msgstr ""

#. ja: 左官作業は手早さが命だ！<br>よろしく頼む！
#. de: Nicht zu lange zaudern, sonst setzt sich der Sand nicht ordentlich!
#. fr: Oubliez pas<nbsp>! Le plus important en maçonnerie, c'est de bosser rapidement<nbsp>!
msgctxt "NpcYell:9780:0:13"
msgid "Speed's of the essence for this task, so let's keep those hands movin'!"
msgstr ""

#. ja: 聖ロエル広場の整備も大詰めだ！<br>さあ、復興共同作業を始めるぞ！
#. de: Jetzt geht es ans Eingemachte!
#. fr: On en a presque fini avec l'estrade de Sainte Roelle<nbsp>!
msgctxt "NpcYell:9781:0:13"
msgid "Right, it's time to make Saint Roelle's Dais true to its name!"
msgstr ""

#. ja: ここにはお立ち台を作る予定だ！<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Schnappt euch Material und baut den Platz wieder auf!
#. fr: On a tous les matériaux qu'il nous faut, alors commencez à bosser sur les piédestaux<nbsp>!
msgctxt "NpcYell:9782:0:13"
msgid "Help yourselves to the supplies, and let's see the stage finished!"
msgstr ""

#. ja: 皆の、職人の技巧を見せてほしいッ！
#. de: Zeigen wir, was in uns Handwerkern alles steckt!
#. fr: Et je veux du bel ouvrage, OK<nbsp>!?
msgctxt "NpcYell:9783:0:13"
msgid "Show me the best of your workmanship, now!"
msgstr ""

#. ja: 名も無き者たちの広場から近いところから、<br>今回の復興共同作業を始める！
#. de: Freunde, es geht endlich ans Genist!
#. fr: Avis à tous<nbsp>! Les prochains travaux ont lieu près de l'Esplanade des démunis<nbsp>!
msgctxt "NpcYell:9784:0:13"
msgid "All right, everyone, we're finally gettin' started on the New Nest proper!"
msgstr ""

#. ja: いよいよ居住区の整備だ！<br>道をふさぐ「大きな瓦礫」を切り崩す作業を頼む！
#. de: Als Erstes muss der Schutt gleich beim Platz der Habenichtse weg!
#. fr: On va enfin s'attaquer à la zone d'habitation. Mais comme d'habitude, déblayez d'abord les gros débris<nbsp>!
msgctxt "NpcYell:9785:0:13"
msgid "First order of business is clearin' the debris in the area by the Mendicant's Court!"
msgstr ""

#. ja: 皆で取りかかれば、あっという間だ！
#. de: Je mehr Leute mit anpacken, desto schneller sind wir fertig!
#. fr: Si tout le monde s'y met, ce sera fini en deux temps trois mouvements<nbsp>!
msgctxt "NpcYell:9786:0:13"
msgid "The more hands we have, the quicker we'll be done!"
msgstr ""

#. ja: 復興共同作業の開始だッ！<br>皆の衆、集まってくれ！
#. de: Auf, auf! Die Arbeiten beginnen!
#. fr: Rassemblement<nbsp>! On passe à la suite<nbsp>!
msgctxt "NpcYell:9787:0:13"
msgid "Roll up your sleeves, 'cause concerted works are startin'!"
msgstr ""

#. ja: 引き続き、居住区の整備を行う！<br>道をふさぐ「大きな瓦礫」を切り崩す作業を頼む！
#. de: Das Genist liegt immer noch voller Schutt. Das werden wir ändern!
#. fr: Il reste des débris énormes, alors il faut s'occuper de ça<nbsp>!
msgctxt "NpcYell:9788:0:13"
msgid "Today, we're clearin' away more debris ahead of construction on the New Nest!"
msgstr ""

#. ja: 職人たちあっての復興作業だ！<br>よろしくな！
#. de: Kommt schon, holt nochmal alles aus euch heraus!
#. fr: Faites-m'en des petits cailloux et on pourra commencer à planifier la suite<nbsp>!
msgctxt "NpcYell:9789:0:13"
msgid "Let's stay focused and get it done with the least fuss!"
msgstr ""

#. ja: 所定の時刻になった！<br>復興共同作業を開始するッ！
#. de: So, es wird Zeit! Fangen wir mit den Arbeiten an!
#. fr: Vous aimez déblayer<nbsp>? Eh bien, j'ai une bonne nouvelle<nbsp>!
msgctxt "NpcYell:9790:0:13"
msgid "Right, the appointed hour's here. Let's get to work!"
msgstr ""

#. ja: 再度、居住区の整備だ！<br>道をふさぐ「大きな瓦礫」を切り崩す作業を頼む！
#. de: Die letzten großen Trümmerstücke müssen weg!
#. fr: Il reste des débris dans Le Nichoir, alors je compte sur vous tous<nbsp>!
msgctxt "NpcYell:9791:0:13"
msgid "There's still debris in the New Nest that wants for clearin', so that's our task for today."
msgstr ""

#. ja: ニューネスト居住区の行く手を阻む、<br>大きな瓦礫はこれで最後だ！
#. de: Danach sind wir erst mal fertig mit dem Hacken.
#. fr: C'est les derniers, promis<nbsp>!
msgctxt "NpcYell:9792:0:13"
msgid "Once we're done, that'll be it for the large chunks!"
msgstr ""

#. ja: ようし、復興共同作業を開始するぞッ！
#. de: Na los, ran an die Arbeit!
#. fr: Bien, on va encore avancer un peu plus<nbsp>!
msgctxt "NpcYell:9793:0:13"
msgid "Right, let's get these works underway!"
msgstr ""

#. ja: 今回はニューネスト居住区の、<br>「微細な瓦礫片」の清掃を行う！
#. de: Fegen wir das Genist! Ich will kein Krümelchen mehr sehen!
#. fr: Avant de s'attaquer au gros du travail, on va nettoyer tous ces débris fins qui jonchent le sol<nbsp>!
msgctxt "NpcYell:9794:0:13"
msgid "This time we're clearin' away the fine debris still scattered about the New Nest."
msgstr ""

#. ja: 居住区の全域なもんで、かなり広い！<br>手分けして頼むぜ！
#. de: Teilt euch ordentlich auf, dann sind wir in Windeseile fertig!
#. fr: Le Nichoir est plus vaste que les autres parties d'Azurée, alors séparez-vous en deux groupes<nbsp>!
msgctxt "NpcYell:9795:0:13"
msgid "There's a lot of ground to cover, so we'll want to split into smaller crews!"
msgstr ""

#. ja: 復興共同作業の開始時刻だ！
#. de: Unser Aufbauprojekt fängt an! Auf, auf!
#. fr: Rassemblez-vous, je vais avoir besoin de l'aide de tout le monde<nbsp>!
msgctxt "NpcYell:9796:0:13"
msgid "All right, everyone, it's time for more concerted works!"
msgstr ""

#. ja: ニューネスト居住区の舗装のため、<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Schön sauber ist das Genist ja jetzt. Reparieren wir nun also das Pflaster!
#. fr: Les fondations du Nichoir sont à refaire. On a tous les matériaux nécessaires, alors je compte sur vous<nbsp>!
msgctxt "NpcYell:9797:0:13"
msgid "After all that clearin' we did for the New Nest, we're finally startin' on the actual buildin'."
msgstr ""

#. ja: 住人が暮らしやすいように整備するために、<br>どうか協力を頼む！
#. de: Ihr kennt das Prozedere ja.
#. fr: Il faut qu'il y fasse bon vivre<nbsp>! Gardez bien ça en tête à chaque coup de burin<nbsp>!
msgctxt "NpcYell:9798:0:13"
msgid "Grab the supplies you need, and we'll fix up all the streets and steps!"
msgstr ""

#. ja: 今回の復興共同作業から、<br>いよいよ住宅の建設を進めていくぞッ！
#. de: Unserem Genist fehlen nur noch die Häuser! Bauen wir ihm welche!
#. fr: On a rassemblé assez de matériaux pour enfin construire les habitations<nbsp>!
msgctxt "NpcYell:9799:0:13"
msgid "Startin' from today, we're gonna be buildin' houses!"
msgstr ""

#. ja: 「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Darauf haben wir alle gewartet, nicht wahr?
#. fr: Prenez de quoi faire sur une des piles et mettez-vous au travail<nbsp>!
msgctxt "NpcYell:9800:0:13"
msgid "This hardly needs sayin', but this is what we've been workin' towards!"
msgstr ""

#. ja: 皆の職人魂、見せてほしいッ！
#. de: Also, schnappt euch Material und ran an die Baustellen!
#. fr: Faites-moi sentir ce feu qui brûle dans votre cœur d'artisan<nbsp>!
msgctxt "NpcYell:9801:0:13"
msgid "So go and grab some supplies, and let's show our builders' spirit!"
msgstr ""

#. ja: さて、復興共同作業を開始する！<br>準備はいいか！？
#. de: Alle Vor<shy>bereitungen getroffen? Dann kann das Aufbauprojekt ja beginnen!
#. fr: Sortez vos outils<nbsp>! On va terminer de bâtir les premières maisons du Nichoir<nbsp>!
msgctxt "NpcYell:9802:0:13"
msgid "To your places, everyone! We're commencin' concerted works!"
msgstr ""

#. ja: 住居の建設を完成させよう！<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Heute machen wir die erste Runde Wohnhäuser fertig. Ihr wisst ja, was ihr zu tun habt!
#. fr: On a tous les matériaux qu'il nous faut. Il y a lit<shy>té<shy>ra<shy>le<shy>ment qu'à se baisser<nbsp>!
msgctxt "NpcYell:9803:0:13"
msgid "Today, we're completin' the first set of houses! You know where the supplies are!"
msgstr ""

#. ja: 皆の職人技が光る時だッ！
#. de: Und ich will keinen Schlendrian sehen, hört ihr?
#. fr: Inutile de vous préciser le côté symbolique de ces premières bâtisses<nbsp>!
msgctxt "NpcYell:9804:0:13"
msgid "The work we do here will set the tone for the rest, so let your skills shine!"
msgstr ""

#. ja: 職人のおかげで、充分な資材が揃った！<br>復興共同作業の時間だ！
#. de: Unser Materiallager platzt aus allen Nähten. Lasst uns das gemeinsam ändern!
#. fr: Merci à tous ceux qui nous ont aidés à rassembler des matériaux<nbsp>!<br>On va enchaîner dès maintenant grâce à eux<nbsp>!
msgctxt "NpcYell:9805:0:13"
msgid "Our stores are in good shape. It's time to get back to it!"
msgstr ""

#. ja: 新たな住居の建設のため、<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Das Genist ist noch furchtbar leer. Wir brauchen mehr Häuser!
#. fr: On est loin d'en avoir fini avec les habitations du Nichoir, alors mettons-nous au boulot<nbsp>!
msgctxt "NpcYell:9806:0:13"
msgid "We're startin' on more houses today, and we'll keep buildin' them till we've filled up the New Nest."
msgstr ""

#. ja: ニューエスト居住区の敷地は広大だ！<br>どんどん家を建てていこう！
#. de: Bedient euch an den Materialien und baut warme Bleiben!
#. fr: C'est qu'on devra en loger du monde<nbsp>!
msgctxt "NpcYell:9807:0:13"
msgid "Take what supplies you need and put 'em to good use!"
msgstr ""

#. ja: 資源が集まったようだな！<br>復興共同作業を始めるぜッ！
#. de: Endlich haben wir wieder genug Material für brandneue Häuser!
#. fr: Grande nouvelle<nbsp>! On a accumulé assez de matériaux<nbsp>!
msgctxt "NpcYell:9808:0:13"
msgid "We've replenished our supplies, so it's time for more works!"
msgstr ""

#. ja: 住居の建設を完成させよう！<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Das Genist ist noch furchtbar leer. Wir brauchen mehr Häuser!
#. fr: Avec ça, on va pouvoir terminer la deuxième série de logements du Nichoir<nbsp>!
msgctxt "NpcYell:9809:0:13"
msgid "The goal today's to complete another set of houses."
msgstr ""

#. ja: 皆の職人技で、立派な家を建ててほしい！
#. de: Wohnlich und stabil sollen sie sein, hört ihr?
#. fr: Ce sera peut-être pas vous qui y habiterez, mais je veux du solide<nbsp>! C'est bien compris<nbsp>!?
msgctxt "NpcYell:9810:0:13"
msgid "Let's build 'em as if you're buildin' your own home!"
msgstr ""

#. ja: 復興共同作業を始めよう！<br>さあ、いよいよ最後の予定地に取りかかるぞッ！
#. de: Das nächste Aufbauprojekt möge beginnen!
#. fr: Il nous reste une dernière série de maisons à bâtir, et Le Nichoir sera terminé<nbsp>!
msgctxt "NpcYell:9811:0:13"
msgid "Right, everyone, it's time to commence the next works!"
msgstr ""

#. ja: 新たな住居の建設のため、<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Heute machen wir den letzten Satz Häuser fertig.
#. fr: Les matériaux ont été rassemblés et mis à votre disposition, alors vous pouvez d'ores et déjà vous y mettre<nbsp>!
msgctxt "NpcYell:9812:0:13"
msgid "This time it's the final site for the New Nest, and the last set of houses!"
msgstr ""

#. ja: 家の建設には精密さが必要だ！<br>丁寧な仕事を頼む！
#. de: Nur weil das Ende in Sicht ist, dürfen wir nicht nachlässig werden!
#. fr: Et vous reposez pas sur vos lauriers<nbsp>! Je veux pas voir un seul mur branlant<nbsp>!
msgctxt "NpcYell:9813:0:13"
msgid "By now it goes without sayin', but the job calls for precision, so let's keep it nice and tidy!"
msgstr ""

#. ja: 復興共同作業を開始するッ！<br>さあ、いよいよ作業も大詰めだ！
#. de: Das hier ist das allerletzte Aufbauprojekt für unser schönes Genist!
#. fr: Écoutez-moi bien<nbsp>! Le Nichoir sera terminé après ce dernier chantier<nbsp>!
msgctxt "NpcYell:9814:0:13"
msgid "This is it, everyone! The very last works for the New Nest!"
msgstr ""

#. ja: 住居の建設を完成させよう！<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Wir stellen die letzten Häuser auf und geben dem Genist den allerletzten Schliff!
#. fr: Tout ça, c'est grâce aux efforts de tous ceux qui ont rassemblé les matériaux nécessaires. Hourra à eux<nbsp>!
msgctxt "NpcYell:9815:0:13"
msgid "Today, we're completin' not only the last of the houses, but the entire area as well!"
msgstr ""

#. ja: これが今期最後の大仕事になるぞ！<br>皆、気張って頼むぜ！
#. de: Na los, meine Lieben! Endspurt!
#. fr: Et hourra à vous<nbsp>! Le Nichoir vous aura fait suer des tonz de sueur, mais on en voit le bout<nbsp>!
msgctxt "NpcYell:9816:0:13"
msgid "Let's give it absolutely everything we've got and finish on a high note!"
msgstr ""

#. ja: その魂、己の研鑽を求め<br>国を高みへと押し上げん
#. de: <i>Mein Geist strebt immerzu nach Erkenntnis, in immer größere Höhen schwinge ich mich auf.</i>
#. fr: “Adroit de mes mains, mon âme sage et studieuse tire la nation vers le haut.”
msgctxt "NpcYell:9817:0:13"
msgid "Deft of paw, with kin do I vie."
msgstr ""

#. ja: この魂を持つ「手先の器用な」<br>神獣に触れよ
#. de: Wer zeichnet sich durch seine große Fingerfertigkeit aus? Wähle weise<nbsp>...
#. fr: Qui suis-je<nbsp>?
msgctxt "NpcYell:9818:0:13"
msgid "Betterment of the whole do our efforts descry."
msgstr ""

#. ja: その群れ、一体のように動き<br>国を平らかにせん
#. de: <i>Mein Rudel bewegt sich wie eins durch den Wald, immer weiter und weiter dehne ich die Grenzen des Landes aus.</i>
#. fr: “Lorsque ma meute aux crocs acérés est unie, l'égalité règne au sein de la nation.”
msgctxt "NpcYell:9819:0:13"
msgid "With fearsome fang, I travel with pack."
msgstr ""

#. ja: 群れをなす「大いなる神」である<br>神獣に触れよ
#. de: Wer formt aus den Vielen eine Einheit? Wähle weise<nbsp>...
#. fr: Qui suis-je<nbsp>?
msgctxt "NpcYell:9820:0:13"
msgid "For peace our land shall never lack."
msgstr ""

#. ja: その力、対立するも従え<br>国を興す礎とならん
#. de: <i>Meine Kraft ist der Grundstein des Reiches.</i>
#. fr: “Bien que dépourvu de membres, ma force fait plier les ennemis des fondements de la nation.”
msgctxt "NpcYell:9821:0:13"
msgid "On my belly do I crawl."
msgstr ""

#. ja: 礎となりし「手も足も出ず」<br>下された神獣に触れよ
#. de: Wer trägt das Land ohne Arme und ohne Beine? Wähle weise<nbsp>...
#. fr: Qui suis-je<nbsp>?
msgctxt "NpcYell:9822:0:13"
msgid "By my strength, prosperity reigns in our hall."
msgstr ""

#. ja: めくらねば、わからぬようだ…
#. de: Ich bin für Rätsel nicht geschaffen.
#. fr: Il faut bien réfléchir...
msgctxt "NpcYell:9823:0:13"
msgid "We must choose carefully."
msgstr ""

#. ja: ヒントでも書いてないかな…
#. de: Ob es hier irgendwo versteckte Hinweise gibt?
#. fr: Il y a peut-être un indice gravé quelque part...<nbsp>?
msgctxt "NpcYell:9824:0:13"
msgid "Perhaps a hint is carved in the stone..."
msgstr ""

#. ja: 何か手がかりがあれば…
#. de: Wenn ich doch irgendetwas tun könnte!
#. fr: Je sèche com<shy>plè<shy>te<shy>ment...
msgctxt "NpcYell:9825:0:13"
msgid "Hmmm..."
msgstr ""

#. ja: 何が描いてあるのかな？
#. de: Vielleicht steht hier irgendetwas geschrieben?
#. fr: Qu'est-ce qui est écrit ici...<nbsp>?
msgctxt "NpcYell:9826:0:13"
msgid "Would that I could read these talismans."
msgstr ""

#. ja: さっぱりわかりませんねぇ～
#. de: Ich habe wirklich keinen Schimmer \<seufz>...
#. fr: J'y comprends rien de rien<nbsp>!
msgctxt "NpcYell:9827:0:13"
msgid "\\<sigh> I can make no sense of this riddle."
msgstr ""

#. ja: 左右に分かれていることに<br>意味があるのかな？
#. de: Hat es irgendwas zu bedeuten, dass diese Karten in zwei Reihen stehen?
#. fr: Leur position a peut-être une si<shy>gni<shy>fi<shy>ca<shy>tion<nbsp>?
msgctxt "NpcYell:9828:0:13"
msgid "Is there perhaps some meaning to their arrangement?"
msgstr ""

#. ja: どうやら、めくった絵柄は<br>あなたにしか見えないようね…
#. de: Irgendwie scheinst nur du die Karten einsehen zu können.
#. fr: Je ne vois rien du tout. Tu dois être <if $gn4>la seule<else>le seul</if> à pouvoir les discerner...
msgctxt "NpcYell:9829:0:13"
msgid "Strange... All of these talismans appear blank to my eye."
msgstr ""

#. ja: 敵が出たぞ！
#. de: Achtung, ein Monster!
#. fr: Soyez sur vos gardes<nbsp>!
msgctxt "NpcYell:9830:0:13"
msgid "On your guard!"
msgstr ""

#. ja: 戦闘なら任せてよ！
#. de: Wenigstens wird's jetzt unterhaltsam<nbsp>...
#. fr: Enfiiiin<nbsp>!
msgctxt "NpcYell:9831:0:13"
msgid "Finally."
msgstr ""

#. ja: 何か出ましたぁ～！
#. de: Wo kommt das Biest denn her?
#. fr: C'est quoi, ça<nbsp>!?
msgctxt "NpcYell:9832:0:13"
msgid "Ah! What is that!?"
msgstr ""

#. ja: やっつけるわよ！
#. de: Aufgepasst!
#. fr: Faisons-ça proprement.
msgctxt "NpcYell:9833:0:13"
msgid "Let us be brief."
msgstr ""

#. ja: オオいなるカミ…？
#. de: Ein Tiergott, der sich im Rudel bewegt, hm<nbsp>...
#. fr: Qu'est-ce que ça peut être...<nbsp>?
msgctxt "NpcYell:9834:0:13"
msgid "What is this meant to be?"
msgstr ""

#. ja: 蛇と狼と猿…
#. de: Schlange, Wolf und Opo-Opo<nbsp>...
#. fr: Toujours les mêmes animaux...
msgctxt "NpcYell:9835:0:13"
msgid "Are these even animals?"
msgstr ""

#. ja: 手も足もない…？
#. de: Weder Beine noch Arme? Hm<nbsp>...
#. fr: Dépourvu de membres...<nbsp>?
msgctxt "NpcYell:9836:0:13"
msgid "Crawls on its belly...?"
msgstr ""

#. ja: クソッ！<br>シャイメの呪札が…
#. de: Seht, die Karte!
#. fr: Oh non, Cymet<nbsp>!
msgctxt "NpcYell:9837:0:13"
msgid "Cymet! No!"
msgstr ""

#. ja: 姉ちゃんが…<br>絶対に助けてやる…！
#. de: Schwesterchen<nbsp>... halt aus, wir helfen dir!
#. fr: On te sauvera, c'est promis<nbsp>!
msgctxt "NpcYell:9838:0:13"
msgid "We have to get them back... We have to!"
msgstr ""

#. ja: 姉さんはきっと無事！<br>機をうかがいましょう…
#. de: Wir müssen uns zusammereißen. Unsere Schwester wird schon wohlauf sein<nbsp>...
#. fr: Tout va s'arranger, tout va s'arranger...
msgctxt "NpcYell:9839:0:13"
msgid "Almet will be fine... She has to be..."
msgstr ""

#. ja: ハァ…やれやれだぜ…
#. de: Uff ...
#. fr: (halète) Eh ben, c'est pas trop tôt...
msgctxt "NpcYell:9840:0:13"
msgid "Bugger me... I'm bloody beat..."
msgstr ""

#. ja: ところで、ウサギさん<br>ヤカン職人は廃業かしら？
#. de: Sag mal, bist du jetzt Vollzeithase oder arbeitest du noch als Teekesselmacher?
#. fr: Bah alors, mon lapin, tu n'es pas en train de bichonner tes bouilloires<nbsp>?
msgctxt "NpcYell:9841:0:13"
msgid "Heh... Not as easy as hammerin' dents in kettles, ain't it?"
msgstr ""

#. ja: テ、テメェ…<br>まさか、ロ…
#. de: D-Diese Stimme! Sag bloß, du bist es, Ro...!
#. fr: Cette voix... Ne me dis pas que c'est toi, Ro...
msgctxt "NpcYell:9842:0:13"
msgid "R-Rowena!? What in the seventh hell─!?"
msgstr ""

#. ja: この姿で名乗るだなんて<br>野暮ってものよ？
#. de: Pst! Sprich es nicht aus! Ich will doch unerkannt bleiben!
#. fr: Chht<nbsp>! Ne t'avise pas de prononcer mon nom<nbsp>! Je suis ici incognito<nbsp>!
msgctxt "NpcYell:9843:0:13"
msgid "Shush now. I've got a reputation to uphold."
msgstr ""

#. ja: それにしても…<br>あなたが参加するとはねぇ…
#. de: Ich fass es nicht! Du, im Hasenkostüm!
#. fr: Pffrt... J'arrive pas à croire que c'est bien toi sous cette tête de lapin ridicule, hi hi hi...
msgctxt "NpcYell:9844:0:13"
msgid "Heh... Wouldn't have figured you the type for dressin' up like a rabbit."
msgstr ""

#. ja: うるせぇ！<br>どの口が言いやがる！
#. de: Klappe halten! Du siehst nicht weniger bescheuert aus!
#. fr: L-la ferme<nbsp>! Moi au moins, j'ai pas un gros pompon aux fesses<nbsp>!
msgctxt "NpcYell:9845:0:13"
msgid "Shut yer gob, Rowena! Ye look as bleedin' ridiculous as I do!"
msgstr ""

#. ja: これも立派な<br>営業活動よ？
#. de: Ich mache dies nicht zum Spaß. Das ist Teil meiner Werbestrategie.
#. fr: Peuh. Je ne me suis pas déguisée pour m'amuser, figure-toi.
msgctxt "NpcYell:9846:0:13"
msgid "Anythin' for business..."
msgstr ""

#. ja: ウチの商会をアピールする<br>好機を逃すつもりはないもの
#. de: Ein guter Geschäftsmann schluckt seinen Stolz auch mal runter!
#. fr: J'ai fait ça pour le bien de mon entreprise. Ne me compare pas à un rigolo comme toi, d'accord<nbsp>?
msgctxt "NpcYell:9847:0:13"
msgid "After all, today's children are tomorrow's customers, I always say..."
msgstr ""

#. ja: 金の亡者め…
#. de: Du würdest für Geld auch deine eigene Mutter verkaufen ...
#. fr: Vieille bique cupide...
msgctxt "NpcYell:9848:0:13"
msgid "Ye greedy-arsed wench..."
msgstr ""

#. ja: はーい！<br>「プレゼント」だよ～！
#. de: Hier, ein Geschenk für dich!
#. fr: Tiens, c'est cadeau<nbsp>!
#. macro: <hyphen> — a hyphen that does not break the line (may be added or dropped)
msgctxt "NpcYell:9849:0:13"
msgid "A happy Hatching<hyphen>tide to you, my young friend!"
msgstr ""

#. ja: このタマゴをどうぞっ！
#. de: Hier ist dein Wunderei!
#. fr: Et voilà pour toi<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:9850:0:13"
msgid "<i>You</i> get an egg! And <i>you</i> get an egg!"
msgstr ""

#. ja: ウチの商会特製の<br>プレゼント入りよ！
#. de: Gesponsert von unserem Handelshaus!
#. fr: Tiens, de la part de la maison des splendeurs<nbsp>!
msgctxt "NpcYell:9851:0:13"
msgid "Remember to shop at the House o' Splendors!"
msgstr ""

#. ja: 冒険者になったら<br>ウチの商会をよろしくね！
#. de: Wenn du mal Abenteurer werden willst, findest du bei uns die notwendige Ausstattung.
#. fr: Tu parleras de la maison des splendeurs à tes parents, d'accord<nbsp>?
msgctxt "NpcYell:9852:0:13"
msgid "We're always lookin' for good help!"
msgstr ""

#. ja: ほら、ガキども！<br>タマゴだぞ！
#. de: He, Rotznasen! Hier gibt's Eier zu holen!
#. fr: Tiens, gamin. Prends un œuf et rentre chez toi<nbsp>!
msgctxt "NpcYell:9853:0:13"
msgid "Here's yer bleedin' egg, ye whiny brat!"
msgstr ""

#. ja: さっさと持って行きやがれ！
#. de: Schnappt euch die Eier und macht, dass ihr wegkommt!
#. fr: Prenez ça et fichez-moi le camp<nbsp>!
msgctxt "NpcYell:9854:0:13"
msgid "Take yer present an' stop yer bloody cryin' already!"
msgstr ""

#. ja: すっご～い！<br>ウサギさんだ～！
#. de: Boah, ein Hase, der sprechen kann!
#. fr: Génial, des lapins<nbsp>!
msgctxt "NpcYell:9855:0:13"
msgid "Look! It's a talking rabbit!"
msgstr ""

#. ja: わぁ～♪<br>タマゴちょうだ～い！
#. de: Gib mir ein Ei!
#. fr: J'veux un œuf<nbsp>!
#. macro: <if $gn4>Missus<else>Mister</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:9856:0:13"
msgid "Do you have an egg for me, <if $gn4>Missus<else>Mister</if> Rabbit!?"
msgstr ""

#. ja: ありがと～！
#. de: Danke!
#. fr: Merci les lapins<nbsp>!
msgctxt "NpcYell:9857:0:13"
msgid "Oh, thank you!"
msgstr ""

#. ja: やったぁ～！
#. de: Juhu!
#. fr: Ils sont trop sympas<nbsp>!
#. macro: <hyphen> — a hyphen that does not break the line (may be added or dropped)
msgctxt "NpcYell:9858:0:13"
msgid "It's the best Hatching<hyphen>tide ever!"
msgstr ""

#. ja: エグエグエグル<br>エッグラホ♪
#. de: ♪ Ei, ei, ei ♪
#. fr: Œufs décorés, jolis tout plein<nbsp>!
msgctxt "NpcYell:9859:0:13"
msgid "Spriggy eggy! Eggy spriggy!"
msgstr ""

#. ja: プレゼント！<br>タマゴ、クバル！
#. de: Eier verteilen! Geschenke verteilen! Dalli, dalliii!
#. fr: Spriggans distribuer œufs-surprises<nbsp>!
msgctxt "NpcYell:9860:0:13"
msgid "Spriggy givy! Spriggy taky!"
msgstr ""

#. ja: やはりそうか…
#. de: Tatsächlich ...
#. fr: Pas de chance...
msgctxt "NpcYell:9861:0:13"
msgid "I see..."
msgstr ""

#. ja: 深海生物の襲撃に<br>備えておこう
#. de: Wir sollten uns auf Angriffe durch allerlei Meeresungeheuer gefasst machen.
#. fr: Préparons-nous à affronter les créatures des abysses...
msgctxt "NpcYell:9862:0:13"
msgid "I see we're not to have a peaceful journey."
msgstr ""

#. ja: さて、いよいよ<br>未知の海域だな…
#. de: Und einmal mehr dem unbekannten Land entgegen.
#. fr: On entre en terrain inexploré...
msgctxt "NpcYell:9863:0:13"
msgid "We're getting close."
msgstr ""

#. ja: 海中移動の術を<br>ビスマルクに習うべきでした…
#. de: Vielleicht sollte ich mir von Bismarck beibringen lassen, wie man das Meer bereist.
#. fr: J'aurais dû demander à Bismarck de m'apprendre à nager...
msgctxt "NpcYell:9864:0:13"
msgid "Mayhaps 'twas Bismarck with whom I ought have bargained..."
msgstr ""

#. ja: 海中移動の術を<br>ビスマルクに習うべきでした…
#. de: Vielleicht sollte ich mir von Bismarck beibringen lassen, wie man das Meer bereist.
#. fr: J'aurais dû demander à Bismarck de m'apprendre à nager...
msgctxt "NpcYell:9865:0:13"
msgid "Mayhaps 'twas Bismarck with whom I ought have bargained..."
msgstr ""

#. ja: あなた…<br>まだ諦めていなかったの？
#. de: Und ich dachte, die Flausen wären dir mit dem letzten „Reinfall“ ausgetrieben worden.
#. fr: Tu n'es pas fait pour les activités nautiques...
msgctxt "NpcYell:9866:0:13"
msgid "For heavens' sake..."
msgstr ""

#. ja: なにが飛び込んできたって<br>撃退してやるんだから！
#. de: Hatten wir die etwa eingeladen, an Bord zu kommen? Schmeißen wir sie wieder runter!
#. fr: Je vais en faire une salade de fruits de mer, moi<nbsp>!
msgctxt "NpcYell:9867:0:13"
msgid "This lot are nothing compared to the barnacles."
msgstr ""

#. ja: この大きさで<br>よく機敏に動けるわね…
#. de: Für seine Größe ist Bismarck erstaunlich wendig<nbsp>...
#. fr: Quelle agilité pour une taille aussi imposante...
msgctxt "NpcYell:9868:0:13"
msgid "Such ease of motion despite his size─it's truly a wonder."
msgstr ""

#. ja: すごい…！<br>海溝に入っていく…！
#. de: Seht, ein gewaltiger Tiefseegraben!
#. fr: Ouah, c'est incroyable<nbsp>!
msgctxt "NpcYell:9869:0:13"
msgid "Look! A trench!"
msgstr ""

#. ja: この大きさで<br>よく機敏に動けるわね…
#. de: Für seine Größe ist Bismarck erstaunlich wendig<nbsp>...
#. fr: Quelle agilité pour une taille aussi imposante...
msgctxt "NpcYell:9870:0:13"
msgid "Such ease of motion despite his size─it's truly a wonder."
msgstr ""

#. ja: 下ならしの甲斐が<br>あったようだな
#. de: Die Felsen scheinen dem Koloss nichts anzuhaben. Immer mit dem Kopf durch die Wand.
#. fr: Ça valait le coup de le laisser faire sa toilette<nbsp>!
msgctxt "NpcYell:9871:0:13"
msgid "I'm certainly glad for Bismarck's preparation now."
msgstr ""

#. ja: うわっ！
#. de: Uaaah!
#. fr: Oooh<nbsp>!
msgctxt "NpcYell:9872:0:13"
msgid "Oof!"
msgstr ""

#. ja: おおっと！<br>大胆な着底じゃないか！
#. de: Oha, das hätte beinahe Kopfschmerzen gegeben!
#. fr: Un atterissage tout en maîtrise<nbsp>!
msgctxt "NpcYell:9873:0:13"
msgid "What a landing!"
msgstr ""

#. ja: っ！？<br>あやうく転倒するかと…
#. de: Das ging ja nochmal gut.
#. fr: Ouf, j'ai cru qu'on allait se retourner...
msgctxt "NpcYell:9874:0:13"
msgid "The force of it...'twas nigh overwhelming."
msgstr ""

#. ja: っ！？<br>あやうく転倒するかと…
#. de: Das ging ja nochmal gut.
#. fr: Ouf, j'ai cru qu'on allait se retourner...
msgctxt "NpcYell:9875:0:13"
msgid "The force of it...'twas nigh overwhelming."
msgstr ""

#. ja: 海に落ちるのだけは<br>勘弁してくれよ？
#. de: Solange ich auf Bismarcks Rücken bleibe und nicht in der schwarzen See lande, ist alles gut<nbsp>...
#. fr: J'ai pas envie de tenter un record de plongée ici<nbsp>!
msgctxt "NpcYell:9876:0:13"
msgid "Just...stay on your feet this time, please."
msgstr ""

#. ja: ここが噂の遺構か…！
#. de: Das sind also die Ruinen des alten Volkes<nbsp>...
#. fr: Voilà ces fameuses ruines...
msgctxt "NpcYell:9877:0:13"
msgid "Incredible!"
msgstr ""

#. ja: さて、ここからは<br>徒歩での探索だな
#. de: Ab hier geht es wohl zu Fuß weiter<nbsp>...
#. fr: Bien, on va pouvoir continuer notre exploration à pied.
msgctxt "NpcYell:9878:0:13"
msgid "Come along. Disturbing secrets await, and all that."
msgstr ""

#. ja: ビスマルク…<br>あなたの協力に感謝を…
#. de: Bismarck, ich danke dir für deine Hilfe.
#. fr: <ui-color 579><ui-edge-color 580>Merci pour ton aide, ô grand Bismarck.</ui-edge-color></ui-color>
msgctxt "NpcYell:9879:0:13"
msgid "Our deepest gratitude, great one."
msgstr ""

#. ja: ビスマルク…<br>あなたの協力に感謝を…
#. de: Bismarck, ich danke dir für deine Hilfe.
#. fr: <ui-color 579><ui-edge-color 580>Merci pour ton aide, ô grand Bismarck.</ui-edge-color></ui-color>
msgctxt "NpcYell:9880:0:13"
msgid "Our deepest gratitude, great one."
msgstr ""

#. ja: ありがとう！<br>それでは行ってきます！
#. de: Vielen Dank, Bismarck. Bis zum nächsten Mal!
#. fr: Merci beaucoup<nbsp>! Maintenant, c'est à nous de jouer<nbsp>!
msgctxt "NpcYell:9881:0:13"
msgid "Thank you, Bismarck!"
msgstr ""

#. ja: ちょっと何あれ…<br>近づきたくないんだけど…
#. de: Urks, was bei den Göttern ist <i>das</i> denn für ein abscheuliches Ding?
#. fr: Qu'est-ce que c'est<nbsp>? J'ai pas envie de m'approcher...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:9882:0:13"
msgid "What <i>is</i> that?"
msgstr ""

#. ja: まったくもって<br>正体不明な生物ね…
#. de: Achtung, noch so eins dieser Abscheulichkeiten!
#. fr: Un inconnu<nbsp>!? J'ai un mauvais pres<shy>sen<shy>ti<shy>ment...
msgctxt "NpcYell:9883:0:13"
msgid "We are fated to happen upon strange abominations, apparently."
msgstr ""

#. ja: な、なんですか…<br>あれは…！？
#. de: W-Was ist <i>das</i>?!
#. fr: Berk, c'est dégoûtant...
msgctxt "NpcYell:9884:0:13"
msgid "What in the world...?"
msgstr ""

#. ja: まったくもって<br>正体不明な生物ね…
#. de: Seht dort vorne. Was ist denn das für ein abscheulicher<nbsp>... <i>Fleischberg</i>?
#. fr: Un inconnu<nbsp>!? J'ai un mauvais pres<shy>sen<shy>ti<shy>ment...
msgctxt "NpcYell:9885:0:13"
msgid "We are fated to happen upon strange abominations, apparently."
msgstr ""

#. ja: 私の知識にも<br>あのような存在は…
#. de: Ich habe schon viele Monstrositäten gesehen, aber dieses Wesen<nbsp>...
#. fr: Heu<shy>reu<shy>se<shy>ment, il n'y en a qu'un... Imaginez s'il y en avait trois<nbsp>!
msgctxt "NpcYell:9886:0:13"
msgid "Never have I seen the like."
msgstr ""

#. ja: ひどい悪臭…<br>なんなのよコレ…！
#. de: \<würg> Was für ein Gestank!
#. fr: Eurgh, ça pue...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:9887:0:13"
msgid "<i>And</i> it stinks. Lovely."
msgstr ""

#. ja: 原初世界の深海にも<br>同種の生物がいるのかしら？
#. de: Ob am Meeresgrund im Ursprung ebenfalls solche Wesen existieren?
#. fr: On trouve le même genre de créature, dans les profondeurs du monde primitif<nbsp>?
msgctxt "NpcYell:9888:0:13"
msgid "Might similar creatures dwell beneath the seas of the Source?"
msgstr ""

#. ja: か、勝てました…<br>けど、この生き物は一体？
#. de: Wir haben sie besiegt. Aber was waren das für<nbsp>... <i>Kreaturen</i>?
#. fr: Ouf, on a gagné... Cette créature était vraiment ignoble<nbsp>!
msgctxt "NpcYell:9889:0:13"
msgid "Do... Do you think there are more of them?"
msgstr ""

#. ja: 実に恐ろしく…<br>興味深い生物でした…
#. de: Ja, sie sind abstoßend, aber auch<nbsp>... Hochinteressant.
#. fr: Il avait plein d'yeux bleus. Ça me rappelle quelque chose...
msgctxt "NpcYell:9890:0:13"
msgid "Some manner of harrowing, perhaps...?"
msgstr ""

#. ja: 原初世界の深海にも<br>同種の生物がいるのかしら？
#. de: Ob am Meeresgrund im Ursprung ebenfalls solche Wesen existieren?
#. fr: On trouve le même genre de créature, dans les profondeurs du monde primitif<nbsp>?
msgctxt "NpcYell:9891:0:13"
msgid "Might similar creatures dwell beneath the seas of the Source?"
msgstr ""

#. ja: 見てくれ！<br>あの建物の様式を！
#. de: Seht, die Gebäude! Erinnert euch das nicht an etwas?
#. fr: Regardez<nbsp>! On dirait une sorte de rituel<nbsp>!
msgctxt "NpcYell:9892:0:13"
msgid "Look at this architecture..."
msgstr ""

#. ja: アーモロートの街並みと<br>よく似た建物だな…
#. de: Ich glaube, wir sind hier richtig: Das ähnelt den Bauwerken, die wir in Amaurot gesehen haben<nbsp>...
#. fr: La ressemblance avec Amaurote est frappante...
msgctxt "NpcYell:9893:0:13"
msgid "The similarities to Amaurot are undeniable."
msgstr ""

#. ja: まさしくこれは…<br>古代人の遺構でありましょう
#. de: Kein Zweifel: Dies ist die Architektur der Alten.
#. fr: Oui, ces ruines appartiennent à la même civilisation.
msgctxt "NpcYell:9894:0:13"
msgid "'Tis unmistakably of the ancients' design."
msgstr ""

#. ja: 見てくれ！<br>あの建物の様式を！
#. de: Seht, die Gebäude! Erinnert euch das nicht an etwas?
#. fr: Regardez<nbsp>! On dirait une sorte de rituel<nbsp>!
msgctxt "NpcYell:9895:0:13"
msgid "Look at this architecture..."
msgstr ""

#. ja: ええ、当たりのようね…<br>古代文明の産物だわ
#. de: Ja, sie entstammen offensichtlich der Kultur der Ascians.
#. fr: Oui, sûrement une cérémonie antique...
msgctxt "NpcYell:9896:0:13"
msgid "This is precisely what we were looking for."
msgstr ""

#. ja: 結晶にエーテルを…<br>何をしようというんだ？
#. de: Seht ihr all diese<nbsp>... Konstrukte? Sie sehen aus wie Kristalle<nbsp>...
#. fr: Ils insufflent de l'éther dans ce cristal<nbsp>!?
msgctxt "NpcYell:9897:0:13"
msgid "What are they doing with that crystal?"
msgstr ""

#. ja: あいつら…<br>何を企んでやがる！
#. de: Was machen diese Flundern dort? Oh<nbsp>...
#. fr: Grrr, qu'est-ce qu'il prépare encore...<nbsp>?
msgctxt "NpcYell:9898:0:13"
msgid "Whatever they're doing, I doubt it's good for us."
msgstr ""

#. ja: 魔力を流し込んでいる？<br>まさか…！
#. de: Ein Beschwörungsritual?
#. fr: On dirait qu'ils canalisent leur énergie... Dans quel but<nbsp>!?
msgctxt "NpcYell:9899:0:13"
msgid "In channeling aether through the crystal... Hmm."
msgstr ""

#. ja: 魔力を流し込んでいる？<br>まさか…！
#. de: Ein Beschwörungsritual?
#. fr: On dirait qu'ils canalisent leur énergie... Dans quel but<nbsp>!?
msgctxt "NpcYell:9900:0:13"
msgid "In channeling aether through the crystal... Hmm."
msgstr ""

#. ja: その「まさか」のようね…！
#. de: Sie kanalisieren ihre Magie<nbsp>...
#. fr: ... Je crois que tu as la réponse à ta question<nbsp>!
msgctxt "NpcYell:9901:0:13"
msgid "I think we have passed the point of theory!"
msgstr ""

#. ja: 結晶に封じられた<br>創造物の概念ということか…！
#. de: Sie wird von den Kristallen absorbiert. Vielleicht rufen sie so diese Bestien?
#. fr: Il s'agissait donc d'un concept qui était enfermé dans un de ces cristaux...
msgctxt "NpcYell:9902:0:13"
msgid "This is a reconstructed “concept” then?"
msgstr ""

#. ja: 古代人の置き土産を<br>利用してるってわけか…
#. de: Sie nutzen die Technologie der Alten für sich.
#. fr: Un petit souvenir des humains originels, sympa...
msgctxt "NpcYell:9903:0:13"
msgid "Looks like the benthos have learned to use this place."
msgstr ""

#. ja: このような代物が<br>遺っていようとは…
#. de: Seht, die Halle hinter dem Portal dort drüben<nbsp>...
#. fr: On n'est pas au bout de nos surprises...
msgctxt "NpcYell:9904:0:13"
msgid "An impressive concept, to be certain."
msgstr ""

#. ja: このような代物が<br>遺っていようとは…
#. de: Diese Konstrukte sind augenscheinlich noch funktionstüchtig.
#. fr: On n'est pas au bout de nos surprises...
msgctxt "NpcYell:9905:0:13"
msgid "An impressive concept, to be certain."
msgstr ""

#. ja: 期待以上の情報が<br>眠っていそうね…
#. de: Sie enthalten offenbar noch jede Menge Informationen.
#. fr: Je sens qu'on va faire de sacrées découvertes.
msgctxt "NpcYell:9906:0:13"
msgid "We might learn much, if more such crystals are to be found within."
msgstr ""

#. ja: す、すごい…！<br>これが全部…！？
#. de: Unglaublich, schaut euch die schiere Menge an!
#. fr: ... Il y en a tellement<nbsp>!
msgctxt "NpcYell:9907:0:13"
msgid "There are so many..."
msgstr ""

#. ja: 圧巻ね…<br>言葉を失いそうだわ…！
#. de: Das ist geradezu atemberaubend<nbsp>...
#. fr: C'est très im<shy>pres<shy>sion<shy>nant...
msgctxt "NpcYell:9908:0:13"
msgid "Why, this... This could take a lifetime to study..."
msgstr ""

#. ja: どこを見渡しても<br>クリスタルだらけです…！
#. de: Kristalle, wohin man sieht.
#. fr: Je n'ai jamais vu autant de cristaux d'un coup<nbsp>!
msgctxt "NpcYell:9909:0:13"
msgid "It's beautiful!"
msgstr ""

#. ja: 圧巻ね…<br>言葉を失いそうだわ…！
#. de: Das ist geradezu atemberaubend<nbsp>...
#. fr: C'est très im<shy>pres<shy>sion<shy>nant...
msgctxt "NpcYell:9910:0:13"
msgid "Why, this... This could take a lifetime to study..."
msgstr ""

#. ja: このクリスタルのすべてに<br>創造物の概念が…？
#. de: Ob all diese Konstrukte Ideen der Ascians in sich bergen?
#. fr: Chacun de ces cristaux renferme une création<nbsp>?
msgctxt "NpcYell:9911:0:13"
msgid "There may be still more out of sight."
msgstr ""

#. ja: 武力での解決は<br>望むところではないが…
#. de: Ich bin nicht gerade scharf darauf, alles Probleme mit dem Schwert zu lösen, aber<nbsp>...
#. fr: Je préférerais éviter de recourir à la violence...
msgctxt "NpcYell:9912:0:13"
msgid "Though I mislike this, we may as well have done with it."
msgstr ""

#. ja: どうやら王のようだな…<br>自ら出陣とは恐れ入る…！
#. de: Wenn das nicht die Königin ist, fress ich einen Besen.
#. fr: C'est leur reine<nbsp>!? Je l'aurais imaginée plus... charismatique<nbsp>!
msgctxt "NpcYell:9913:0:13"
msgid "She plans to fight us herself? How efficient."
msgstr ""

#. ja: ふむ、オンド族の雌個体…<br>女王のようですね…
#. de: Die Physiognomie dieser Kreatur passt zur Beschreibung der Flunder-Königin.
#. fr: Une Flet femelle<nbsp>? Pas de doute, c'est leur reine...
msgctxt "NpcYell:9914:0:13"
msgid "Yonder queen standeth as more than symbol to her soldiers. Have caution."
msgstr ""

#. ja: 武力での解決は<br>望むところではないが…
#. de: Ich bin nicht gerade scharf darauf, alle Probleme mit dem Schwert zu lösen, aber<nbsp>...
#. fr: Je préférerais éviter de recourir à la violence...
msgctxt "NpcYell:9915:0:13"
msgid "Though I mislike this, we may as well have done with it."
msgstr ""

#. ja: 向こうはやる気のようね…<br>油断すると大怪我するわよ！
#. de: Sie scheint uns schon zu erwarten. Wir sollten wachsam sein!
#. fr: Certes, mais elle ne nous laisse pas le choix<nbsp>!
msgctxt "NpcYell:9916:0:13"
msgid "If she wants a fight, I'm happy to oblige!"
msgstr ""

#. ja: フタリガケ！
#. de: Für das Gute ...
#. fr: Ensemble<nbsp>!
msgctxt "NpcYell:9923:0:13"
msgid "For the sake of our world!"
msgstr ""

#. ja: イクゾ…！
#. de: Für das Licht ...
#. fr: Allons-y<nbsp>!
msgctxt "NpcYell:9924:0:13"
msgid "In the name of the Light!"
msgstr ""

#. ja: 爆ゼロ…<br>ブリムストーンアース！
#. de: Brenne ... Schwefelerde!
#. fr: Brûlez<nbsp>! Et retournez à la terre<nbsp>!
msgctxt "NpcYell:9925:0:13"
msgid "To the ashes whence you came!"
msgstr ""

#. ja: 降リ注ゲ！
#. de: Tod, regne herab!
#. fr: Qu'une pluie mortelle s'abatte sur vous<nbsp>!
msgctxt "NpcYell:9926:0:13"
msgid "Death rain upon you!"
msgstr ""

#. ja: 俺ガ、蹴散ラス…！
#. de: Ich werde dich zerstören!
#. fr: Je vais vous faucher tel le blé<nbsp>!
msgctxt "NpcYell:9927:0:13"
msgid "I'll cut 'em down to size!"
msgstr ""

#. ja: 召喚獣ヨ…<br>チカラヲ貸シテ！
#. de: Ich rufe dich! Licht, erhöre mich!
#. fr: Compagnons, prêtez-moi votre force<nbsp>!
msgctxt "NpcYell:9928:0:13"
msgid "Lend me your strength, my servants!"
msgstr ""

#. ja: 水遁ノ術…参式…
#. de: Wo Licht ist ... ist auch Schatten<nbsp>...
#. fr: Suiton... San<nbsp>!
msgctxt "NpcYell:9929:0:13"
msgid "Cleansing water, wash away evil!"
msgstr ""

#. ja: ハアァッ！
#. de: Haaaa!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:9930:0:13"
msgid "Haaah!"
msgstr ""

#. ja: 砕いてみせる！
#. de: Ich werde dich vernichten!
#. fr: Je vais vous briser<nbsp>!
msgctxt "NpcYell:9931:0:13"
msgid "I will destroy you!"
msgstr ""

#. ja: その身で受けよ！
#. de: Spüre den Schmerz!
#. fr: Vous n'êtes pas de taille<nbsp>!
msgctxt "NpcYell:9932:0:13"
msgid "Feel the pain!"
msgstr ""

#. ja: 小休止中の<br>敵部隊を発見しました…！
#. de: Da! Der Feind macht Rast im Gelände!
#. fr: Les Impériaux sont là-bas<nbsp>! Ils ne se doutent de rien<nbsp>!
msgctxt "NpcYell:9933:0:13"
msgid "There they are! Resting right out in the open!"
msgstr ""

#. ja: よし、情報どおりだな…！<br>一気に蹴散らすぞ！
#. de: Genau wie berichtet. Nutzen wir die Gelegenheit!
#. fr: Nos ren<shy>sei<shy>gne<shy>ments étaient justes. Parfait, on va leur rentrer dans le lard<nbsp>!
msgctxt "NpcYell:9934:0:13"
msgid "Just as our scouts reported. We'll hit them hard and fast!"
msgstr ""

#. ja: 勝利の荒鷲に続けッ！
#. de: Auf sie! Für Bozja!
#. fr: L'aigle va encore frapper<nbsp>!
msgctxt "NpcYell:9935:0:13"
msgid "Like an eagle amongst the hares!"
msgstr ""

#. ja: うおぉぉぉ！
#. de: Angriiiiiiff!
#. fr: Pour Bozja<nbsp>!
msgctxt "NpcYell:9936:0:13"
msgid "For Bozja!"
msgstr ""

#. ja: なにッ！<br>奇襲だとッ！？
#. de: Was? Wo kommen die denn auf einmal her?
#. fr: Que... D'où ils sortent, ceux-là<nbsp>!?
msgctxt "NpcYell:9937:0:13"
msgid "Wh─ It's an ambush!"
msgstr ""

#. ja: レジスタンスどもが<br>調子に乗りおって！
#. de: Hast du den Hass in ihren Augen gesehen?
#. fr: Ces rebelles ne manquent pas de culot<nbsp>!
msgctxt "NpcYell:9938:0:13"
msgid "The bastards grow too bold by half..."
msgstr ""

#. ja: 返り討ちにしてやれ！
#. de: Schlagt den Angriff zurück und den Schwächlingen ihre Häupter ab!
#. fr: Repoussez-les<nbsp>!
msgctxt "NpcYell:9939:0:13"
msgid "Well? What are you waiting for? Crush them!"
msgstr ""

#. ja: まったく……レジスタンス風情に、<br>押し込まれるとは情けない……。
#. de: Das darf doch nicht wahr sein! Dieser Abschaum lässt nicht locker!
#. fr: Acculés par de pareils barbares... Quelle déchéance...
msgctxt "NpcYell:9940:0:13"
msgid "What's this I see? The pride of the Empire hard-pressed by Resistance rabble?"
msgstr ""

#. ja: 品のない乱痴気騒ぎも、そこまでにしていただきましょう……。
#. de: Keinen Schritt weiter! Sonst werdet ihr es bereuen!
#. fr: Cette farce grotesque a assez duré.
msgctxt "NpcYell:9941:0:13"
msgid "Bah, this brutish squabble has gone on long enough."
msgstr ""

#. ja: 戦場のなんたるか……<br>我が魔力の焔によって、身を以て理解するが良い……！
#. de: Wollt ihr nicht hören? Dann werde ich meine Flammen sprechen lassen.
#. fr: Je vais vous montrer à quoi doit ressembler un champ de bataille<nbsp>!
msgctxt "NpcYell:9942:0:13"
msgid "If you are so eager to feel the flames of war, then I shall be happy to oblige!"
msgstr ""

#. ja: ほう……ここまで抗い続けるとは……<br>少しばかり見くびっていたようですな……。
#. de: Sie kämpfen verbissen. Zugegeben, ich habe ihren Mut unterschätzt.
#. fr: Ça alors... À croire que je vous ai jugés trop vite.
msgctxt "NpcYell:9943:0:13"
msgid "Hmph, you are more stalwart than I gave you credit for."
msgstr ""

#. ja: 我が兵の不甲斐なさは、極めて残念ですが、<br>あなた方を十分に引きつけておくことができました。
#. de: Aber die Schuld an der Niederlage liegt allein in der Schwäche meiner Legionäre. Wartet nur, wenn wir wieder im Lager sind ...
#. fr: Excusez le peu de pugnacité de mes hommes. J'ose au moins espérer qu'ils auront su vous divertir.
msgctxt "NpcYell:9944:0:13"
msgid "A poor showing from my own troops, but nevertheless...they served well enough to keep you distracted."
msgstr ""

#. ja: またいずれ機会があれば、<br>あらためて、お相手願いましょう……！
#. de: Die IV. Legion ist noch nicht geschlagen. Wir kommen wieder!
#. fr: La prochaine fois, tout le plaisir sera pour moi<nbsp>!
msgctxt "NpcYell:9945:0:13"
msgid "We will meet again, I think. In fact, I shall make certain of it."
msgstr ""

#. ja: あと一歩のところで…<br>ええい、撤退だ！
#. de: Da! Sie fliehen!
#. fr: Rah, encore un peu et on les tenait... Tant pis, on se replie<nbsp>!
msgctxt "NpcYell:9946:0:13"
msgid "A few more staves and we'd have had them... Retreat!"
msgstr ""

#. ja: まさか負けるなんて…
#. de: Was für eine Niederlage! Ich dachte, wir machen nur kurz mal Rast!
#. fr: On a perdu<nbsp>? Impossible...
msgctxt "NpcYell:9947:0:13"
msgid "We'll never live this down..."
msgstr ""

#. ja: クソッ！
#. de: So ein Scheißtag!
#. fr: Fait chier<nbsp>!
msgctxt "NpcYell:9948:0:13"
msgid "Damn them!"
msgstr ""

#. ja: どうにか退けたが<br>追撃の余力はなしか…
#. de: Für eine Verfolgung fehlt es uns an Kämpfern ...
#. fr: C'est trop risqué de les prendre en chasse. Restons-en là pour cette fois.
msgctxt "NpcYell:9949:0:13"
msgid "Let the cowards flee. We need to lick our own wounds."
msgstr ""

#. ja: ともあれ勝ちは勝ちです！
#. de: Sie fliehen! Wir haben gewonnen.
#. fr: On a gagné, c'est l'essentiel<nbsp>!
msgctxt "NpcYell:9950:0:13"
msgid "Even so, I'll count this one a victory!"
msgstr ""

#. ja: 帝国軍に、あれほどの<br>魔道士がいるのか…
#. de: Die Garlear haben also auch mächtige Magier ...
#. fr: Ce pyromancien, c'était quelque chose...
msgctxt "NpcYell:9951:0:13"
msgid "That mage... What a nightmare."
msgstr ""

#. ja: 退いてくれて助かった…
#. de: Gut, dass die weg sind. Ich hätte nicht mehr lange durchgehalten ...
#. fr: Heu<shy>reu<shy>se<shy>ment qu'il n'a pas trop insisté...
msgctxt "NpcYell:9952:0:13"
msgid "We wouldn't have held out much longer."
msgstr ""

#. ja: 今は生き残ったことを<br>歓びましょう！
#. de: Feiern wir den Sieg - und dass wir noch leben.
#. fr: Il faut remercier le ciel d'être encore en vie<nbsp>!
msgctxt "NpcYell:9953:0:13"
msgid "Let's just be glad we survived..."
msgstr ""

#. ja: ふむ……少し火を付けてやれば、脆いものですな……。
#. de: Was? Vor dem bisschen Feuer lasst ihr euch Angst machen?
#. fr: Pff... Une petite flammèche de rien du tout, et les voilà qui courent comme des poulets sans tête.
msgctxt "NpcYell:9954:0:13"
msgid "Hmph. The briefest lick of fire, and they burn to cinders."
msgstr ""

#. ja: 所詮は、レジスタンスといったところですか……。
#. de: Tja, mehr hat der Widerstand wohl nicht drauf.
#. fr: À l'évidence, vous n'avez de résistants que le nom.
msgctxt "NpcYell:9955:0:13"
msgid "Why, this “Resistance” may as well be a stack of kindling!"
msgstr ""

#. ja: 総員、後方に下がりますよ……。<br>勝者らしく、整然と、優雅にね……。
#. de: Lassen wir die. Wir wissen ja jetzt, wer der Stärkere ist.
#. fr: Retirons-nous, mes chers. La tête haute et en ordre rangé, comme les vainqueurs que nous sommes.
msgctxt "NpcYell:9956:0:13"
msgid "Withdraw at your leisure, men. The enemy is beaten."
msgstr ""

#. ja: よし、もう十分だ！<br>凱旋するぞ！
#. de: So, das wär erledigt. Rasten wir weiter.
#. fr: Au pas, camarades<nbsp>! Aujourd'hui, nous rentrons victorieux<nbsp>!
msgctxt "NpcYell:9957:0:13"
msgid "Right, pack it up, lads! We return the victors this day!"
msgstr ""

#. ja: ハハハ！<br>第IV軍団万歳！
#. de: Haha! Ein Hoch auf die IV. Legion!
#. fr: Longue vie à la 4e légion<nbsp>!
msgctxt "NpcYell:9958:0:13"
msgid "Haha! Glory to the IVth!"
msgstr ""

#. ja: ガブラス様に栄光あれ！
#. de: Lang lebe Legatus Gabranth!
#. fr: Gloire au seigneur Gabranth<nbsp>!
msgctxt "NpcYell:9959:0:13"
msgid "In Gabranth's name!"
msgstr ""

#. ja: これが帝国軍の力…<br>撤退せよッ…！
#. de: Rückzug! Gegen die Garlear kommen wir nicht an!
#. fr: Ils sont trop forts<nbsp>! En arrière, tout le monde<nbsp>!
msgctxt "NpcYell:9960:0:13"
msgid "The imperials have us outmatched... Fall back!"
msgstr ""

#. ja: やっぱり勝てないのか…
#. de: Mein Onkel hat's gesagt, gegen die haben wir keine Chance!
#. fr: N'y a-t-il aucun moyen de les vaincre<nbsp>?
msgctxt "NpcYell:9961:0:13"
msgid "We'll never win like this..."
msgstr ""

#. ja: ひいっ…！
#. de: Ich will nach Hause!
#. fr: Misère...
msgctxt "NpcYell:9962:0:13"
msgid "But...we had the upper hand!"
msgstr ""

#. ja: 包囲されている？
#. de: Wir sind umzingelt!
#. fr: Ils nous encerclent<nbsp>!
msgctxt "NpcYell:9963:0:13"
msgid "They have us surrounded!"
msgstr ""

#. ja: もう、駄目だ…
#. de: Hier kommen wir nicht lebend raus ...
#. fr: On est faits comme des rats...
msgctxt "NpcYell:9964:0:13"
msgid "...We're done for."
msgstr ""

#. ja: なんてことだ…
#. de: Götter, steht uns bei ...
#. fr: Si j'avais su que ça finirait comme ça...
msgctxt "NpcYell:9965:0:13"
msgid "Walked right into it..."
msgstr ""

#. ja: 諦めるな！<br>この死地を抜けるぞ！
#. de: Durchhalten! Ich bring uns hier raus!
#. fr: Ne baissez pas les bras, on peut encore s'en sortir<nbsp>!
msgctxt "NpcYell:9966:0:13"
msgid "Weapons at the ready! We fight our way free!"
msgstr ""

#. ja: や、やってやる！<br>やってやるぞ！
#. de: W-Wir schaffen das ... bestimmt!
#. fr: L-le capitaine a raison<nbsp>! Aux armes, camarades<nbsp>!
msgctxt "NpcYell:9967:0:13"
msgid "R-Right! We'll show these bastards!"
msgstr ""

#. ja: 死なばもろともだ！
#. de: Wenn ich schon sterben muss, dann auf dem Schlachtfeld!
#. fr: Ensemble jusqu'à la mort<nbsp>!
msgctxt "NpcYell:9968:0:13"
msgid "Victory or death!"
msgstr ""

#. ja: そう簡単に<br>逃がすものか！
#. de: Die lassen wir nicht entkommen.
#. fr: Serrez l'étau<nbsp>! Ne leur laissez aucune échappatoire<nbsp>!
msgctxt "NpcYell:9969:0:13"
msgid "There will be no escape!"
msgstr ""

#. ja: 殲滅してくれる！
#. de: Bringt sie alle um!
#. fr: Vous allez tous mourir<nbsp>!
msgctxt "NpcYell:9970:0:13"
msgid "There will be no survivors!"
msgstr ""

#. ja: 総員突撃ィィ！
#. de: Alle Mann, Aaangriiiff!
#. fr: Chargez<nbsp>!!!
msgctxt "NpcYell:9971:0:13"
msgid "Show them no mercy!"
msgstr ""

#. ja: 突撃ィィ！
#. de: Angriiiiiiff!
#. fr: Pas de quartier<nbsp>!
msgctxt "NpcYell:9972:0:13"
msgid "Charge!"
msgstr ""

#. ja: やれやれ、またも我が軍が劣勢に陥ろうとは……。
#. de: Was denn? Mit den paar Leuten greifen sie an?
#. fr: Une énième débâcle pour nos soldats<nbsp>? Eh bien, eh bien...
msgctxt "NpcYell:9973:0:13"
msgid "\\<sigh> Once again I find our soldiers succumbing to an inferior force."
msgstr ""

#. ja: ……なるほど、噂の解放者がおられるようだ。
#. de: Ah, sie haben <if $gn4>diese Befreierin<else>diesen Befreier</if> dabei ... die angebliche Geheimwaffe.
#. fr: ... Ah, <if $gn4>la grande libératrice<else>le grand libérateur</if>. Ceci explique cela.
msgctxt "NpcYell:9974:0:13"
msgid "...Ah, but of course. I must stand before the vaunted “hero of the Resistance.”"
msgstr ""

#. ja: 千人隊長アルビレオに代わり、<br>このサルトヴォアール・クォ・ソラノスが、お相手致そう……。
#. de: Ich, Sartauvoir quo Soranus, werde Pilus Prior Albeleo würdig vertreten.
#. fr: Le commandant Albeleo étant occupé, permettez-moi de vous affronter à sa place.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:9975:0:13"
msgid "Fear not, Albeleo.<br>I, Sartauvoir quo Soranus, will reduce this nuisance to ash."
msgstr ""

#. ja: ふむ……やはり、戦とは良いものですな！<br>年甲斐もなく、魔力をたぎらせてしまった……！
#. de: Pah. Jetzt lege ich ein paar neue Kohlen ins Feuer.
#. fr: Ah, que c'est bon de guerroyer<nbsp>! Même à mon âge, j'ai grand plaisir à déployer mes artifices<nbsp>!
msgctxt "NpcYell:9976:0:13"
msgid "Hah! Though I grow old and grey, ever does the thrill of battle stoke the embers of my soul! "
msgstr ""

#. ja: では最後に、花火をご覧にいれましょう！<br>耐え抜けますかな……？
#. de: Zum Abschluss werde ich euch ein Feuerwerk bereiten, das man noch in der Kaiserstadt leuchten sieht!
#. fr: Oh, c'est déjà l'heure du bouquet final. Allez-vous en réchapper<nbsp>? Je me le demande.
msgctxt "NpcYell:9977:0:13"
msgid "Yes... The inferno builds to an all-consuming finale! Embrace the spectacle or perish!"
msgstr ""

#. ja: 愉快、愉快……！<br>年寄りの言葉には、よくよく耳を傾けませんとな！
#. de: Zugegeben, das verlief nicht ganz nach Plan.
#. fr: Bravo, bravo<nbsp>! De vous à moi, j'aimerais que ce combat dure plus longtemps.
msgctxt "NpcYell:9978:0:13"
msgid "Glorious! Simply glorious! You see how one must heed the words of one's elders?"
msgstr ""

#. ja: とはいえ、悲しいかな兵は将の命により動くもの。<br>再戦の機会を願いつつ、お別れとさせていただきましょう。
#. de: Aber man kann ja nicht immer gewinnen. Ich freue mich auf die Revanche.
#. fr: Hélas, les ordres sont les ordres. Je dois partir, néanmoins j'espère vous revoir bientôt.
msgctxt "NpcYell:9979:0:13"
msgid "...Even as a soldier must heed the commands of his general. I leave you now, but know that this contest will have its conclusion!"
msgstr ""

#. ja: ふむ……少しばかり期待しておりましたが……<br>いささか、拍子抜けでした。
#. de: Wie enttäuschend. Von diesem Kampf hatte ich mehr erwartet.
#. fr: Quel dommage... J'attendais beaucoup de vous, mais vous me laissez sur ma faim avec ce combat.
msgctxt "NpcYell:9980:0:13"
msgid "A pity. I had hoped for a more worthy contest."
msgstr ""

#. ja: とはいえ、悲しいかな兵は将の命により動くもの。<br>戦う相手は、選べぬのです……。
#. de: Aber man kann sich seine Gegner ja nicht immer aussuchen. Schließlich müssen auch die Schwachen besiegt werden.
#. fr: Sur ce, le devoir m'appelle... ailleurs. Si vous voulez bien m'excuser.
msgctxt "NpcYell:9981:0:13"
msgid "Still, a soldier must fight as his general commands. We have not the luxury of choosing our opponents..."
msgstr ""

#. ja: 追いかけよう！
#. de: Hinterher!
#. fr: Rattrapons-la<nbsp>!
msgctxt "NpcYell:9982:0:13"
msgid "We're following, obviously."
msgstr ""

#. ja: このポッドを使えば…<br>向こうまで行けるぞ！
#. de: Schaut mal, Pods!
#. fr: Ces pods nous tendent les bras<nbsp>!
msgctxt "NpcYell:9983:0:13"
msgid "More pods..."
msgstr ""

#. ja: ひえぇ…またこれか…
#. de: Uaaah! Nicht schon wieder!
#. fr: Oh non, pas ça...
msgctxt "NpcYell:9984:0:13"
msgid "My kingdom for a proper bridge."
msgstr ""

#. ja: なんだ！<br>あのデカブツは！？
#. de: Was ist denn dieses riesen Dingsda?!
#. fr: C'est quoi, ce gros machin tout noir<nbsp>?
msgctxt "NpcYell:9985:0:13"
msgid "Odds on not having to fight that giant thing...?"
msgstr ""

#. ja: アイツは村を襲った<br>白いアンドロイドだ…！
#. de: Eine weiße Androidin! Genau solche haben das Dorf angegriffen!
#. fr: Là-bas, je vois un androïde en blanc<nbsp>!
msgctxt "NpcYell:9986:0:13"
msgid "Considering that's one of the androids that attacked us, low."
msgstr ""

#. ja: さあ、先を急ぎましょう！
#. de: Los, beeilen wir uns!
#. fr: En avant toute<nbsp>!
msgctxt "NpcYell:9987:0:13"
msgid "Hurry!"
msgstr ""

#. ja: 気をつけて…！
#. de: Vorsicht<nbsp>...!
#. fr: Faites attention à vous<nbsp>!
msgctxt "NpcYell:9988:0:13"
msgid "Careful!"
msgstr ""

#. ja: それにしても…<br>ここは、いったい…？
#. de: <i>Das</i> haben sie gebaut? Was zum<nbsp>...
#. fr: Euh... On est où, là<nbsp>?
msgctxt "NpcYell:9989:0:13"
msgid "This is odd...er than usual."
msgstr ""

#. ja: すごい技術力だ…
#. de: D-Diese Technologie<nbsp>...!
#. fr: C'est gigantesque...
msgctxt "NpcYell:9990:0:13"
msgid "Did you see that blast radius!?"
msgstr ""

#. ja: 白いアンドロイドだ！<br>今度は３人いるぞ…！
#. de: Mehr von den weißen Androiden! Drei Stück diesmal!
#. fr: Mince, en voilà trois autres<nbsp>!
msgctxt "NpcYell:9991:0:13"
msgid "Three androids this time..."
msgstr ""

#. ja: ２Ｐの手下のようです…<br>倒しましょう…！
#. de: Sind das 2Ps Untergebene? Macht sie kaputt!
#. fr: Des copines de 2P sans doute...
msgctxt "NpcYell:9992:0:13"
msgid "But still no 2P."
msgstr ""

#. ja: よくぞご無事で！
#. de: Denen habt ihr's ordentlich gezeigt!
#. fr: Joli combat<nbsp>!
msgctxt "NpcYell:9993:0:13"
msgid "Excellent work on not dying!"
msgstr ""

#. ja: ここから先に<br>進むことができそうだ
#. de: Hier geht's weiter, glaube ich.
#. fr: On peut sauter en contrebas.
msgctxt "NpcYell:9994:0:13"
msgid "This must be the way."
msgstr ""

#. ja: ま、また…<br>飛び降りるのか…
#. de: S-Schon wieder springen<nbsp>...?
#. fr: Sauter, toujours sauter...
msgctxt "NpcYell:9995:0:13"
msgid "More falling!?"
msgstr ""

#. ja: いいぞ！<br>どんどん進め！
#. de: Hurra, es geht voran!
#. fr: C'est comme faire du toboggan<nbsp>! Allez<nbsp>!
msgctxt "NpcYell:9996:0:13"
msgid "Whee!"
msgstr ""

#. ja: ひぃぃ！<br>普通の道はないのか…！
#. de: Uah! D-Das ist aber kein normaler Korridor!
#. fr: J-je préférerais des escaliers<nbsp>!
msgctxt "NpcYell:9997:0:13"
msgid "Eurgh..."
msgstr ""

#. ja: おぉ、未知の技術の塊だ！
#. de: Oho! Aus welchem Stein ist das hier nur gebaut? Faszinierend!
#. fr: Ouah, vous avez vu toutes ces machines<nbsp>!?
msgctxt "NpcYell:9998:0:13"
msgid "Look at all of this technology!"
msgstr ""

#. ja: この施設は<br>いったい…？
#. de: Was soll das hier alles sein?
#. fr: Je me demande à quoi elles peuvent bien servir...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:9999:0:13"
msgid "What <i>is</i> this place?"
msgstr ""
