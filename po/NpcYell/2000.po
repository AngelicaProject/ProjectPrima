# NpcYell
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: おうさッ！
#. de: Auf geht's!
#. fr: Youpi<nbsp>!!
msgctxt "NpcYell:2000:0:13"
msgid "Aye, boss!"
msgstr "Так точно, босс!"

#. ja: ヤ、ヤられるぅ！
#. de: Ich bin gleich hinüber!
#. fr: J'ai un mauvais pres<shy>sen<shy>ti<shy>ment...
msgctxt "NpcYell:2001:0:13"
msgid "This ain't lookin' good..."
msgstr "Плохо дело..."

#. ja: ヤっちまいな！
#. de: Auf sie!
#. fr: Pas d'pitié, les gars<nbsp>!
msgctxt "NpcYell:2002:0:13"
msgid "Let's get 'em!"
msgstr "Ну-ка, зададим им!"

#. ja: ヤるじゃなーい！
#. de: Wir sind unschlagbar!
#. fr: Héhé. Voilà du bon boulot<nbsp>!
msgctxt "NpcYell:2003:0:13"
msgid "That's how it's done!"
msgstr "Вот это я понимаю!"

#. ja: た、助けてくれェ！
#. de: Helft mir!
#. fr: Ouah<nbsp>! J-je... pisse le sang<nbsp>!
msgctxt "NpcYell:2004:0:13"
msgid "I'm bleedin' bad!"
msgstr "Я истекаю кровью!"

#. ja: 頼りにしてるぞッ！
#. de: Jetzt nichts wie raus!
#. fr: On compte sur vous<nbsp>!
msgctxt "NpcYell:2005:0:13"
msgid "We're countin' on ye!"
msgstr "Мы на вас рассчитываем!"

#. ja: 生きて帰れるぞッ！
#. de: Hätte nicht gedacht, noch mal das Tageslicht zu erblicken!
#. fr: J'imagine qu'on a pas d'excuse pour sécher le boulot demain...
msgctxt "NpcYell:2006:0:13"
msgid "We live to mine another day!"
msgstr "Ещё день проживём — и снова за кирки!"

#. ja: も、もうムリでやんす～
#. de: Ich bin am Ende!
#. fr: Ils sont.. trop... forts...
msgctxt "NpcYell:2007:0:13"
msgid "They're too...strong..."
msgstr "Они... слишком сильны..."

#. ja: つ、疲れたでやんす～
#. de: Ich bin fix und alle.
#. fr: Je commence à en avoir marre de tout ça...
msgctxt "NpcYell:2008:0:13"
msgid "I can't take much more of this..."
msgstr "Долго я так не протяну..."

#. ja: た、助かったでやんすか？
#. de: Wir haben's geschafft? Unglaublich!
#. fr: Personne ne m'a dit qu'il y aurait des géants...
msgctxt "NpcYell:2009:0:13"
msgid "Nobody told me there would be giants..."
msgstr "Никто не говорил, что тут будут великаны..."

#. ja: ウルァー、モエぢまえ！
#. de: HERREN ALLE BRENNEN! GROARRR!
#. fr: GRAAAH<nbsp>!<br>BRÛLEZ TOUS<nbsp>!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:2010:0:13"
msgid "GRAAAHHH!<br>BURN, BURN ALL!"
msgstr "ГРА-А-А!<br>ГОРИТЕ ВСЕ!"

#. ja: なんだ、この巨大なゴーレムは！？
#. de: Ein Riesengolem! Rette sich, wer kann!
#. fr: Quel est ce golem géant<nbsp>?
msgctxt "NpcYell:2011:0:13"
msgid "A giant golem! Run for your lives!"
msgstr "Гигантский голем! Спасайся кто может!"

#. ja: オーホッホホホ！実験開始ですわ！
#. de: Ohohohohoho!
#. fr: Ohohoho<nbsp>! L'expérience va commencer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:2012:0:13"
msgid "Much to your chagrin, the experiment shall now begin!<br>O～hohohohoho!"
msgstr "К вашему огорчению, эксперимент начинается!<br>О-о-хо-хо-хо-хо!"

#. ja: やったぞ！
#. de: Der Sieg ist unser!
#. fr: Bien joué<nbsp>!
msgctxt "NpcYell:2013:0:13"
msgid "Begone, foul creature!"
msgstr "Прочь, мерзкое создание!"

#. ja: あらあら、あっけないですわ。<br>これでは物足りませんわね。
#. de: Was krabbelt da am Boden rum?<br>Wer kitzelt mich, wer ist so dumm?
#. fr: Oh, quel dommage. On dirait bien que je n'ai pas assez chargé ma création<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:2014:0:13"
msgid "My minion has fallen? Consider me floored.<br>Oh well, back to the drawing board."
msgstr "Моего прислужника побили? Вот это удар!<br>Что ж, придётся начать всё сначала."

#. ja: ……いいでしょう。<br>わたくしが、みなさんを見定めてさしあげますわ！
#. de: Ihr könnt euch noch so heftig wehren,<br>ich werd euch schnell das Fürchten lehren!
#. fr: Mais restons-en là. J'ai pu faire les observations que je souhaitais<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:2015:0:13"
msgid "I've collected valuable data from all this fighting.<br>Armed with this knowledge, I shall begin my smiting!"
msgstr "Я собрала немало ценных данных!<br>Теперь, вооружившись знаниями, я вас прикончу!"

#. ja: オーホッホッホホホホホ！
#. de: Ohohohohoho!
#. fr: Ooohohohohohoho<nbsp>!
msgctxt "NpcYell:2016:0:13"
msgid "O～hohoho!"
msgstr "О-о-хо-хо-хо!"

#. ja: あら、この世界の冒険者も、なかなかやりますわね。
#. de: Nanu, wär hätte das gedacht?<br>Ich hab euch wohl zu früh verlacht.
#. fr: À ce que je vois, les aventuriers ne sont pas com<shy>plè<shy>te<shy>ment in<shy>com<shy>pé<shy>tents dans ce monde.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:2017:0:13"
msgid "Well, what have we here?<br>You're not half as helpless as you appear."
msgstr "А вот и вы!<br>На вид вы куда беспомощнее, чем на деле."

#. ja: あなたがたへの興味も尽きませんけど……<br>わたくし、あまり暇ではございませんの。
#. de: Der Mut, den ihr hier demonstriert,<br>mich zweifelsohne interessiert.
#. fr: Vous avez éveillé ma curiosité, mais malheureusement, j'ai à faire.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:2018:0:13"
msgid "While I'd like nothing more than to stick around and play,<br>I fear I've more important matters to attend to today."
msgstr "Я бы с радостью осталась с вами поиграть,<br>но у меня сегодня дела поважнее."

#. ja: そろそろ次の実験に移らせていただきますわ。<br>それでは、ごきげんよう！
#. de: Doch Muße ist mir leider fremd.<br>Mich ruft das nächste Experiment!
#. fr: J'ai encore d'autres expériences à mener. Je vous salue donc<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:2019:0:13"
msgid "After all, I've experiments to conduct, and golems to build.<br>But we'll meet again...if you can avoid getting yourself killed."
msgstr "В конце концов, меня ждут опыты и новые големы.<br>Но мы ещё встретимся... если вы доживёте."

#. ja: オホホホホ！<br>オーッホッホホホホ！
#. de: Ohohohohoho!<br>O-hohohohoho!
#. fr: Ohohohoho<nbsp>! Oooohohohohoho<nbsp>!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:2020:0:13"
msgid "O～hohoho!<br>O～hohohohohoho!"
msgstr "О-о-хо-хо!<br>О-о-хо-хо-хо-хо!"

#. ja: おや、もうこんな時間。<br>わたくしは、そろそろ失礼させていただきますわ。
#. de: Wer hat an der Uhr gedreht?<br>Ist es wirklich schon so spät?
#. fr: Il se fait tard, je dois me retirer.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:2021:0:13"
msgid "Oh dear, is it already this time of day?<br>I really must be on my way."
msgstr "Ах, уже так поздно?<br>Пожалуй, мне пора."

#. ja: 次は、もう少し退屈させないでほしいですわね。<br>オーッホッホホホホ！
#. de: Beim nächsten Mal, das wünsch ich mir,<br>reicht man das Wasser bitte mir.
#. fr: Il va falloir y mettre un peu plus du vôtre, la prochaine fois. Ohohohohoho<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:2022:0:13"
msgid "Next time we find ourselves warring,<br>do try to be a little less...boring."
msgstr "В следующий раз постарайтесь<br>быть чуточку... повеселее."

#. ja: オロカですわ～！
#. de: Törichte Wichte, bald seid ihr Geschichte!
#. fr: Sot<if $gn4>te</if> <nbsp>! Croyez-vous m'impressionner<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:2023:0:13"
msgid "Death by stomping, or death by curse?<br>You decide which one is worse!"
msgstr "Затопчу или прокляну?<br>Решайте, что страшнее!"

#. ja: オーッホッホホホ！
#. de: O-hohohohoho!
#. fr: Ooohohoho<nbsp>!
msgctxt "NpcYell:2024:0:13"
msgid "O～hohoho!"
msgstr "О-о-хо-хо!"

#. ja: ナマイキですことよ
#. de: Wer sich zeigt frech, dem's Genick ich brech!
#. fr: Insolent<if $gn4>e</if> <nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:2025:0:13"
msgid "You can run,<br>I won't make fun!"
msgstr "Бегите,<br>я и не засмеюсь!"

#. ja: あくびが出ますわ
#. de: Ein Kampf soll das sein? Ich schlaf ja gleich ein!
#. fr: Je vais bâiller...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:2026:0:13"
msgid "\\<yawn> Could you put up more of a fight?<br>I'm about to call it a night..."
msgstr "\\<yawn> Ну хоть немного сопротивляйтесь!<br>А то я сейчас отправлюсь спать..."

#. ja: わたくし、ぶち切れましたわ。
#. de: Nehmt euch in Acht, habt mich wütend gemacht!
#. fr: Je vais vous crever<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:2027:0:13"
msgid "That wasn't wise...<br>Prepare for a quick demise!"
msgstr "Зря вы это...<br>Сейчас быстро с вами покончу!"

#. ja: せいやッ！
#. de: Nimm dies!
#. fr: Tiens, prends ça<nbsp>!
msgctxt "NpcYell:2028:0:13"
msgid "Have at you!"
msgstr "Получай!"

#. ja: うおぉッ！
#. de: Nicht mit mir!
#. fr: M-M-Maman<nbsp>!
msgctxt "NpcYell:2029:0:13"
msgid "The horror!"
msgstr "Ужас!"

#. ja: はぁ、はぁ…
#. de: \<keuch>
#. fr: Ouf... ouf...
msgctxt "NpcYell:2030:0:13"
msgid "\\<pant> \\<pant>"
msgstr "\\<pant> \\<pant>"

#. ja: う、うわぁぁぁッ！
#. de: Nophica ... stehe mir bei ...!
#. fr: Au nom de Nophica<nbsp>!
msgctxt "NpcYell:2031:0:13"
msgid "Matron, deliver me!"
msgstr "Матрона, спаси меня!"

#. ja: し、死にたく…ない…
#. de: Ich will ... noch nicht sterben ...
#. fr: Je... je... je ne veux pas mourir...
msgctxt "NpcYell:2032:0:13"
msgid "I...f-fear...no...shadows..."
msgstr "Я... б-боюсь... тьмы..."

#. ja: た、助かった…
#. de: Das war haarscharf, vielen Dank.
#. fr: J'ai bien cru que j'allais y passer...
msgctxt "NpcYell:2033:0:13"
msgid "I... I thought I was surely dead."
msgstr "Я... я уж думал, что мне конец."

#. ja: 恩に着る、冒険者よ…
#. de: Ich verdanke dir mein Leben, Abenteurer<if $gn4>in</if>.
#. fr: Je vous dois la vie, aventuriers<nbsp>!
msgctxt "NpcYell:2034:0:13"
msgid "I owe you my life, adventurer."
msgstr "Я у тебя в долгу, искатель приключений..."

#. ja: 助力に感謝する…
#. de: Ohne euch hätten wir es nicht geschafft.
#. fr: Que les Douze vous bénissent<nbsp>! Un peu plus tard et c'en était fini de moi<nbsp>!
msgctxt "NpcYell:2035:0:13"
msgid "Thank the Twelve that you arrived when you did."
msgstr "Слава Двенадцати, вы вовремя подоспели."

#. ja: すまん、退かせてもらう…
#. de: Ich bringe mich in Sicherheit. Vergebt mir!
#. fr: Je n'ai plus la force de me battre. Pardon...
msgctxt "NpcYell:2036:0:13"
msgid "I can fight no further. Forgive me..."
msgstr "Больше не могу сражаться. Простите..."

#. ja: 焔神の加護は無敵ぞ！
#. de: Niemand trotzt dem Herrn des Infernos!
#. fr: Surpuissante, la protection d'Ifrit est<nbsp>!
msgctxt "NpcYell:2037:0:13"
msgid "I am blessed by the almighty Ifrit!"
msgstr "Меня благословил сам Ифрит!"

#. ja: 貴様なぞ、鎧袖一触なり！
#. de: Dies wird ein leichter Sieg, meine Brüder!
#. fr: Faibles, vous êtes<nbsp>!
msgctxt "NpcYell:2038:0:13"
msgid "Your fall will be swift!"
msgstr "Вы падёте быстро!"

#. ja: 弱き者よ、燃えつきるがいい！
#. de: Die Schwachen müssen brennen!
#. fr: Brûler, les faibles doivent<nbsp>!
msgctxt "NpcYell:2039:0:13"
msgid "I hear the feeble sputtering of your spirit's flames!"
msgstr "Слышу, как гаснет пламя ваших жалких душ!"

#. ja: おっ、標的、はっけーん！
#. de: Ah, da sind ja ein paar Zielscheiben. Sehr schön.
#. fr: Cible en vue<nbsp>! Préparez les canons<nbsp>!
msgctxt "NpcYell:2040:0:13"
msgid "Target acquired! Ready cannons!"
msgstr "Цель обнаружена! Заряжай пушки!"

#. ja: この稼動音、たまらんねぇ～！
#. de: Zurück blieb nur Gemüseauflauf. Ha!
#. fr: Ah, cette machine ronronne comme un chat<nbsp>!
msgctxt "NpcYell:2041:0:13"
msgid "Ah, she purrs like a cat!"
msgstr "Ах, как же приятно она урчит!"

#. ja: フン、骨のねぇ野菜どもだぜ
#. de: Wer ist so töricht, sich mit unserem neuen Prototypen anzulegen?
#. fr: Pff, on va faire qu'une bouchée de ces légumes volants<nbsp>!
msgctxt "NpcYell:2042:0:13"
msgid "Hmph, just a bunch of floating cabbages!"
msgstr "Пф, всего-то летающая капуста!"

#. ja: ぐっ、このヤロウ…
#. de: Unmöglich!
#. fr: Argh, ces sauvages sont coriaces...
msgctxt "NpcYell:2043:0:13"
msgid "Eorzean savages!"
msgstr "Эорзейские дикари!"

#. ja: 生殺与奪、汝は滅すのみ！
#. de: Allmächtig ist der Herr des Infernos! Brenne, Ungläubiger!
#. fr: Votre intrusion, vous allez payer cher<nbsp>!
msgctxt "NpcYell:2044:0:13"
msgid "Thou shalt pay dearly for thine intrusion!"
msgstr "За вторжение вы заплатите сполна!"

#. ja: 雲散霧消、ヒトよ去ね！
#. de: Asche zu Asche, Staub zu Staub!
#. fr: Bienvenus ici, les peaux-lisses ne sont pas<nbsp>!
msgctxt "NpcYell:2045:0:13"
msgid "Thy kind are not welcome here!"
msgstr "Вашим здесь не рады!"

#. ja: 禍根を断つ！
#. de: Eure Art werde ich ausrotten! Mit Stumpf und Stil!
#. fr: Vous consumer, les flammes vont<nbsp>!
msgctxt "NpcYell:2046:0:13"
msgid "The flames shall consume thee!"
msgstr "Пламя поглотит вас!"

#. ja: 我は朽ちぬッゥ！
#. de: Bin ich unbesiegbar, kha!
#. fr: Les sans-plumes ne vaincront pas ceux-ci<nbsp>!
msgctxt "NpcYell:2047:0:13"
msgid "Hope to prevail, featherless ones cannot!"
msgstr "Бескрылым нас не одолеть!"

#. ja: 信徒にしてくれるわッァ！
#. de: Kah! Ich dich glauben mache!
#. fr: Ceux-là vont devenir les serviteurs de la Souffleuse de rafales<nbsp>!
msgctxt "NpcYell:2048:0:13"
msgid "Garuda's leal servant, you shall become!"
msgstr "Вы станете верными слугами Гаруды!"

#. ja: 諦めよ羽根ナシッィ！
#. de: Du aufgeben, Federloser!
#. fr: La résistance des sans-plumes est futile<nbsp>!
msgctxt "NpcYell:2049:0:13"
msgid "Futile, resistance is!"
msgstr "Сопротивляться бесполезно!"

#. ja: 邪魔はさせーぬ！
#. de: Niemand stört meine Zeremonie!
#. fr: Personne n'interrompt l'arrivée du Marteleur du sol, personne ne l'arrête<nbsp>!
msgctxt "NpcYell:2050:0:13"
msgid "No one interrupts the coming of the Lord of Crags!"
msgstr "Никто не помешает явлению Повелителя скал!"

#. ja: きかーぬ！きかーぬ！
#. de: Widerstand ist zwecklos! Zwecklos!
#. fr: Vos os orneront l'autel de Titan, ils le décoreront<nbsp>!
msgctxt "NpcYell:2051:0:13"
msgid "Your bones will adorn Titan's earthen domain!"
msgstr "Ваши кости украсят каменные владения Титана!"

#. ja: 暴虐なるヒトーめ！
#. de: Die Ungläubigen werden im Staube kriechen!
#. fr: Sales humains<nbsp>!
msgctxt "NpcYell:2052:0:13"
msgid "Filthy overdweller!"
msgstr "Грязные чужаки!"

#. ja: フスィーッ…排除する！
#. de: Ssschuppenlose, versssinkt in der Sssee!
#. fr: Fsshhh<nbsp>! Vous ne repartirez pas vivants<nbsp>!
msgctxt "NpcYell:2053:0:13"
msgid "Pshhh... Finleshhh ones will not leave this place alive!"
msgstr "Пш-ш-ш... без плавников отсюда живыми не уйдёте!"

#. ja: 泡沫と消えよ！
#. de: Ssstrudel desss Untergangsss!
#. fr: Vous allez disparaître dans l'écume des vagues<nbsp>! Fsshhh<nbsp>!
msgctxt "NpcYell:2054:0:13"
msgid "Begone as foam upon the waves!"
msgstr "Сгиньте, как пена на волнах!"

#. ja: ヒレナシに我は倒せぬ！
#. de: Tod den Flossssssenlosen!
#. fr: Vous allez nourrir le Déchaîneur des marées dans les abysses<nbsp>!
msgctxt "NpcYell:2055:0:13"
msgid "Your shhhouls shall be given to the abyshhh!"
msgstr "Ваши души достанутся бездне!"

#. ja: ヘイ、オヤビン！
#. de: Hiiier, Boss! Tataa! Töööten!
#. fr: M'avez appelé, Chef<nbsp>?
msgctxt "NpcYell:2056:0:13"
msgid "You called, boss?"
msgstr "Звали, босс?"

#. ja: 早く帰らなくちゃ…
#. de: Ich muss schnell zurückkehren.
#. fr: Il faut que je rrrentre<nbsp>!
msgctxt "NpcYell:2057:0:13"
msgid "I must be home soon."
msgstr "Мне надо поскорее домой..."

#. ja: みんな心配してるだろうな…
#. de: Die anderen machen sich bestimmt schon Sorgen.
#. fr: Ils doivent tous s'inquiéter pour moi<nbsp>!
msgctxt "NpcYell:2058:0:13"
msgid "My sisters will be sick with worry."
msgstr "Сёстры, наверное, места себе не находят..."

#. ja: オアシスまで…あと少し
#. de: Nur noch ein kleines Stück bis zur Oase.
#. fr: On est prrresque à l'Oasis...
msgctxt "NpcYell:2059:0:13"
msgid "The Springs are not far now..."
msgstr "До Источников уже недалеко..."

#. ja: お願い、ちょっとまって…
#. de: Bitte warte auf mich.
#. fr: Attendez un peu...
msgctxt "NpcYell:2060:0:13"
msgid "Pray wait a moment..."
msgstr "Прошу, подождите минутку..."

#. ja: ひ、ひいいぃぃ…
#. de: H-Hilfeee!
#. fr: Aaaah<nbsp>!
msgctxt "NpcYell:2061:0:13"
msgid "Aaah!"
msgstr "А-а-а!"

#. ja: た、助けて、冒険者さん…
#. de: Bitte halt mir diese Biester vom Leib, Abenteurer<if $gn4>in</if>!
#. fr: Aidez-moi<nbsp>!!
msgctxt "NpcYell:2062:0:13"
msgid "Aid me, adventurer!"
msgstr "Помоги мне, искатель приключений!"

#. ja: ふふ、見事な変装でしょ？
#. de: Das Kostüm ist der Hammer, oder?
#. fr: Mon costume est ex<shy>cep<shy>tion<shy>nel, n'est-ce pas<nbsp>?
msgctxt "NpcYell:2063:0:13"
msgid "Voco, prince of chocobos, at your service!"
msgstr "Воко, принц чокобо, к вашим услугам!"

#. ja: 行きますよ、クエーッ！
#. de: Auf geht's, kweh!
#. fr: En route, kwé<nbsp>!
msgctxt "NpcYell:2064:0:13"
msgid "Let us be off! Kweeeh!"
msgstr "В путь! Ку-э-э!"

#. ja: 御子ちゃま、待っててください！
#. de: Wir sind bald bei dir, heiliges Kind!
#. fr: Nous devons retrouver l'Inspiré<nbsp>!
msgctxt "NpcYell:2065:0:13"
msgid "We have a Chosen One to save!"
msgstr "Надо спасти Избранного!"

#. ja: ま、待ってくださいクエーッ！
#. de: Nicht so schnell, kweh!
#. fr: Kwééé<nbsp>! A-attendez-moi<nbsp>!
#. macro: <if $gn4>Mistress<else>Master</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:2066:0:13"
msgid "Not so fast, <if $gn4>Mistress<else>Master</if>! Voco's legs tire!"
msgstr "Не так быстро, <if $gn4>госпожа<else>господин</if>! Воко устал бежать!"

#. ja: クエッ、クエッ、クエーッ！
#. de: Kweh, kweh, kweh!
#. fr: Kwé<nbsp>! Kwé<nbsp>! Kwé<nbsp>!
msgctxt "NpcYell:2067:0:13"
msgid "Kweh! Kweh!"
msgstr "Куэ! Куэ!"

#. ja: 僕、悪いチョコボじゃないよぅ！
#. de: Ich bin ein ganz braves Vögelchen!
#. fr: J-je ne suis qu'un chocobo sans défense<nbsp>!
msgctxt "NpcYell:2068:0:13"
msgid "Voco is a brave bird, oh yes!"
msgstr "Воко хорошая птичка, да-да!"

#. ja: 痛いの飛んでいけクポ！
#. de: Schmerz verschwinde, kupo!
#. fr: Adieu les bobos, kupopo<nbsp>!
msgctxt "NpcYell:2069:0:13"
msgid "I'll save you, kupo!"
msgstr ""

#. ja: ぜ、善王様お助けクポ！！
#. de: Großer Mog, steht mir bei, kupo!
#. fr: Sauvez-moi, Votre Grâce<nbsp>!<br>Je vous en supplie, kupo<nbsp>!
msgctxt "NpcYell:2070:0:13"
msgid "Your Grace, we beseech you! Save us in our hour of need, kupo!"
msgstr "Ваше величество, молим! Спасите нас в час беды, купо!"

#. ja: 狙い撃つクポーッ！！
#. de: Jetzt wird scharf geschossen, kupo!
#. fr: Ne bouge pas, <if $gn4>ma<else>mon</if> petit<if $gn4>e</if><nbsp>! Kupoooo...
msgctxt "NpcYell:2071:0:13"
msgid "Just hold still, kupooo... "
msgstr "Только не двигайтесь, купо-о-о..."

#. ja: 力みなぎれクポーッ！
#. de: Kupo-Power, kupo!
#. fr: ♪ Pampulilu, pam, pum, pam<nbsp>!<br>Que la force soit en nous<nbsp>!
msgctxt "NpcYell:2072:0:13"
msgid "This'll put some spring into your step!"
msgstr "Сейчас ноги сами в пляс пустятся!"

#. ja: ぜ、善王様早く来てクポ！
#. de: I-Ich brauche Eure Hilfe, Eure Kupolichkeit!
#. fr: Aidez-moi, Votre Grâce<nbsp>!<br>Ne me laissez pas seul, kupo<nbsp>!
msgctxt "NpcYell:2073:0:13"
msgid "Your Grace, your Mogglesguard is nearly undone! Save us, kupo! Save us!"
msgstr "Ваше величество, страж Могла совсем пал! Спасите нас, купо! Спасите!"

#. ja: え、えい、当たれクポ！
#. de: Kupo-Ramme, kupo!
#. fr: Repentez-vous, mécréants<nbsp>!
msgctxt "NpcYell:2074:0:13"
msgid "You brought this on yourself, kupo!"
msgstr "Сами напросились, купо!"

#. ja: こ、このこのクポ～！
#. de: Das kupo ich dir heim!
#. fr: Vous n'auriez jamais dû venir ici, kupo<nbsp>!
msgctxt "NpcYell:2075:0:13"
msgid "You should never have come here, kupo!"
msgstr "Не надо было сюда приходить, купо!"

#. ja: 「灰の一党」の手のものか！？
#. de: <if $gn4>Eine Handlangerin<else>Ein Handlanger</if> der Bruderschaft der Asche?!
#. fr: De la Ligue des cendres, vous faites partie<nbsp>?
msgctxt "NpcYell:2076:0:13"
msgid "An ally of the Brotherhood!?"
msgstr "Вы из Братства пепла?!"

#. ja: 蹂躙してくれるわ！
#. de: Du hast hier nichts zu suchen!
#. fr: Mourir, vous allez<nbsp>!
msgctxt "NpcYell:2077:0:13"
msgid "Interfering gnat!"
msgstr "Мелкая назойливая букашка!"

#. ja: 「炎牙衆」は引かんのだっ！
#. de: Die Flammenfänge werden niemals weichen!
#. fr: Invincibles, les Crocs de Feu sont<nbsp>!
msgctxt "NpcYell:2078:0:13"
msgid "The Flamefangs rule this land!"
msgstr "Пламенные клыки никогда не отступят!"

#. ja: 小賢しいヒトめがっ！
#. de: Kühn aber zwecklos!
#. fr: Maudit<if $gn4>e</if> humain<if $gn4>e</if><nbsp>!
msgctxt "NpcYell:2079:0:13"
msgid "You will all be slaves!"
msgstr "Вы все станете рабами!"

#. ja: たてつく者は容赦せぬ！
#. de: Widerstand ist unverzeihlich!
#. fr: Les gêneurs, nous n'aimons pas<nbsp>!
msgctxt "NpcYell:2080:0:13"
msgid "Death to those who resist!"
msgstr "Смерть тем, кто сопротивляется!"

#. ja: 焔神の加護を思い知れ！
#. de: Erkenne die Herrlichkeit unseres Gottes!
#. fr: La puissance de notre Dieu, tu vas connaître<nbsp>!
msgctxt "NpcYell:2081:0:13"
msgid "Lord Ifrit is almighty!"
msgstr "Узнайте мощь нашего бога!"

#. ja: まとめて一槍に伏す！
#. de: Mein Speer schreit nach Blut!
#. fr: Mon coup de lance, craignez<nbsp>!
msgctxt "NpcYell:2082:0:13"
msgid "My spear craves your cries!"
msgstr "Моё копьё жаждет ваших криков!"

#. ja: 湧いたかゴミ虫どもめ！
#. de: Elendes Gewürm!
#. fr: Misérables vermines<nbsp>!
msgctxt "NpcYell:2083:0:13"
msgid "Do you bite, little desert fly?"
msgstr "Ну что, кусаетесь, пустынные мошки?"

#. ja: お前らまとめて捕らえてやる！
#. de: Ihr Sterblichen seid dem Untergang geweiht!
#. fr: Vous capturer, nous allons<nbsp>!
msgctxt "NpcYell:2084:0:13"
msgid "All will bow before us!"
msgstr "Все склонятся перед нами!"

#. ja: 加護を宿し拳を食らえ！
#. de: Meine Fäuste sind beseelt vom Geist der Flammen!
#. fr: La puissance de mon poing d'Ifrit, admire<nbsp>!
msgctxt "NpcYell:2085:0:13"
msgid "My fists are blessed by flame!"
msgstr "Мои кулаки благословлены пламенем!"

#. ja: ヒトの技など無力！
#. de: Ihr Sterblichen habt keine Chance gegen uns!
#. fr: Faibles, les humains sont<nbsp>!
msgctxt "NpcYell:2086:0:13"
msgid "Such feeble attacks!"
msgstr "Жалкие ваши атаки!"

#. ja: 常勝無敗！国士無双！
#. de: Ehre den Amalj'aa, Ehre dem Herrn des Infernos!
#. fr: Invaincus, nous serons encore<nbsp>!
msgctxt "NpcYell:2087:0:13"
msgid "We are the masters of Thanalan!"
msgstr ""

#. ja: ここからは通さないでふっち！
#. de: Die Meinige wird <if $gn4>die Deinige<else>den Deinigen</if> nicht durchlassen.
#. fr: Vous ne passerez pas<nbsp>!<br>On vous en empêchera<nbsp>!
msgctxt "NpcYell:2088:0:13"
msgid "No ones shall pass!"
msgstr "Никто не пройдёт!"

#. ja: 覚悟しろでふっち！
#. de: <if $gn4>Die Deinige<else>Der Deinige</if> siehe sich vor!
#. fr: Vous ne pouvez pas l'emporter,<br>vous feriez mieux d'abandonner<nbsp>!
msgctxt "NpcYell:2089:0:13"
msgid "The podling belongs to these ones!"
msgstr "Птенец принадлежит этим!"

#. ja: ふっ潰すでふっち！
#. de: Die Meinige wird <if $gn4>die Deinige<else>den Deinigen</if> zerquetschen.
#. fr: Vous allez mourir<nbsp>!<br>Je vais vous détruire<nbsp>!
msgctxt "NpcYell:2090:0:13"
msgid "Enemy of boss one is enemy of these ones."
msgstr "Враг босса — враг этих!"

#. ja: 森に埋めてやるでふっち！
#. de: Die Meinige macht Humus aus <if $gn4>der Deinigen<else>dem Deinigen</if>!
#. fr: Vous allez servir d'engrais,<br>ça fera du bien à la forêt<nbsp>!
msgctxt "NpcYell:2091:0:13"
msgid "Meddling ones' bones will litter the forest!"
msgstr "Кости тех, кто лезет не в своё дело, усеют лес!"

#. ja: バリバリお見舞いでふっち！
#. de: Ritsch, ratsch, <if $gn4>die Abenteurige<else>der Abenteurige</if> ist Matsch!
#. fr: Ce sont des coups que vous voulez<nbsp>?<br>On ne va pas vous décevoir, je vous le promets<nbsp>!
msgctxt "NpcYell:2092:0:13"
msgid "Tee hee! So much fun to kill walking ones!"
msgstr "Хи-хи! Как весело убивать ходячих!"

#. ja: 蹴散らすでふっち！
#. de: Die Meinige stampft <if $gn4>die Kämpfende<else>den Kämpfenden</if> in Grund und Boden.
#. fr: Débarrassons-nous d'eux,<br>tuons-les à petit feu<nbsp>!
msgctxt "NpcYell:2093:0:13"
msgid "Boss one! This one sees dead ones!"
msgstr "Босс один! Эти видят мёртвых!"

#. ja: オレちゃまは怖いでふっち～！
#. de: Die Meinige ist furchterregend!
#. fr: Vous allez regretter amèrement,<br>de vous être joués de Diluxio le grand<nbsp>!
msgctxt "NpcYell:2094:0:13"
msgid "Look upon this one, and fear!"
msgstr "Взгляните на этих и трепещите!"

#. ja: 御子ちゃまを渡すでふっち！
#. de: Her mit dem Kindiglichen!
#. fr: Rendez-nous l'Inspiré,<br>vous serez épargnés<nbsp>!
msgctxt "NpcYell:2095:0:13"
msgid "Chosen One belongs with this one!"
msgstr "Избранный должен быть с этим!"

#. ja: 生かして帰さないでふっち！！
#. de: Das wird <if $gn4>die Deinige<else>der Deinige</if> bereuen!
#. fr: Vous refusez de nous obéir<nbsp>?<br>Préparez-vous à périr<nbsp>!
msgctxt "NpcYell:2096:0:13"
msgid "Meddling ones will not leave this place alive!"
msgstr "Никто из этих не уйдёт отсюда живым!"

#. ja: ひっく…て、敵でふっち！
#. de: Die Farben!
#. fr: Un, hic<nbsp>! Non, deux ennemis<nbsp>!?<br>V'nez un peu par ici<nbsp>!
msgctxt "NpcYell:2097:0:13"
msgid "This one is─hic!─feeling gooooood!"
msgstr "Ик... враг... эти!"

#. ja: うぃ～っぷ、でふっち
#. de: Die Evolution besteht in der Veränderung des Bewusstseins.
#. fr: Hi hi, hic<nbsp>! Vous m'faites pas peur<nbsp>!<br>V'z'allez comprendre vot'douleur<nbsp>!
msgctxt "NpcYell:2098:0:13"
msgid "Tee hee! Tee hee hee hee hee...hic!"
msgstr "Хи-хи! Хи-хи-хи-хи-хи... ик!"

#. ja: ミルクルート……<br>足りないでふっち……
#. de: Warum hast du so einen großen Kopf, Metalliger?
#. fr: Lai-laissez-moi, hic, boire en paix<nbsp>!<br><if $gn4>Toutes<else>Tous</if> les deux, v'zêtes une vraie plaie<nbsp>!
msgctxt "NpcYell:2099:0:13"
msgid "Ooh, a walky one. Got milkroot, walky one?"
msgstr "О, ходячий! Есть молочный корень, ходячий?"

#. ja: ビィギー、ビキビキ、<br>オコッタゾー！
#. de: Biggy seeehr sauer sein!
#. fr: Mouihi... Vous avez fâché Biggy<nbsp>!
msgctxt "NpcYell:2100:0:13"
msgid "Uh-oh... You made Biggy angry!"
msgstr "Ой-ой... Вы разозлили Бигги!"

#. ja: ぬぬ、此は何の騒ぎだッ！？
#. de: Wer wagt es, uns anzugreifen?
#. fr: Quelque chose, il se passe ici<nbsp>!?
msgctxt "NpcYell:2102:0:13"
msgid "Who dares challenge our might!?"
msgstr "Кто посмел бросить вызов нашей мощи!?"

#. ja: ケアルちょうだい！
#. de: Gib mir Vita!
#. fr: Donne-moi Soin<nbsp>!
msgctxt "NpcYell:2103:0:13"
msgid "Gimme a cure!"
msgstr "Дай мне Лечение!"

#. ja: フスィーッ…<br>水神様のために！
#. de: Fssschhhhh ... Für den Herrn der Wogen!
#. fr: Fsssh... Notre Dieu va vous engloutir<nbsp>!
msgctxt "NpcYell:2104:0:13"
msgid "Pshhh! For Lord Leviathan!"
msgstr "Пшшш! За владыку Левиафана!"

#. ja: ヒレナシどもめ！
#. de: Elende Flossenlose!
#. fr: Maudits sssans-branchies<nbsp>!
msgctxt "NpcYell:2105:0:13"
msgid "Finleshhh wretches!"
msgstr "Проклятые безрёберные!"

#. ja: フスィーッ…<br>偉大なる海を畏れよ！
#. de: Erhebt euch, Gewalten der Sssee!
#. fr: Fsshh... Perforez-leur les poumons<nbsp>!
msgctxt "NpcYell:2106:0:13"
msgid "Pshhh! Cower before the raging sea!"
msgstr "Пшшш! Трепещите перед бушующим морем!"

#. ja: 同時攻撃クポ！
#. de: Alle zusammen, kupo!
#. fr: Attaque combinée, kupo<nbsp>!
msgctxt "NpcYell:2107:0:13"
msgid "On my mark, Kapa!"
msgstr "По моей команде, купо!"

#. ja: 今がチャンスクポ！
#. de: Jetzt oder nie, kupo!
#. fr: C'est le moment, kupo<nbsp>! En avant<nbsp>!
msgctxt "NpcYell:2108:0:13"
msgid "Kogi, Piko─ As one!"
msgstr "Коги, Пико — вместе!"

#. ja: わかったクポ！
#. de: Ich hab's, kupo!
#. fr: C'est parti mon kupo<nbsp>!
msgctxt "NpcYell:2109:0:13"
msgid "You got it, kupo!"
msgstr "Понял, купо!"

#. ja: ブン回すクポ！
#. de: Ringel, rangel, kupo!
#. fr: Un petit tour et puis s'en va, kupo<nbsp>!
msgctxt "NpcYell:2110:0:13"
msgid "Puki, Kipp, let 'em have it!"
msgstr "Пуки, Кипп, задайте им жару!"

#. ja: どんどこ落とすクポ！
#. de: Jetzt gibt's Saures, kupo!
#. fr: Par terre, kupo<nbsp>!
msgctxt "NpcYell:2111:0:13"
msgid "Here it comes, kupo!"
msgstr "Лови, купо!"

#. ja: モグも攻撃クポ！
#. de: Kupo-Zeit!
#. fr: Les Mogs attaquent, et ils sont pas contents, kupo<nbsp>!
msgctxt "NpcYell:2112:0:13"
msgid "There's no escape, kupo!"
msgstr "От нас не уйти, купо!"

#. ja: 合唱するクポーッ！
#. de: Kupokus-Fidibus!
#. fr: Tous en chœur, kupo<nbsp>!
msgctxt "NpcYell:2113:0:13"
msgid "For the king, kupo!"
msgstr "За короля, купо!"

#. ja: デルタアタッククポ！
#. de: Mein Kupo hat drei Ecken!
#. fr: Attaque delta, kupo<nbsp>!
msgctxt "NpcYell:2114:0:13"
msgid "Piko, Pako─ Delta!"
msgstr "Пико, Пако — Дельта!"

#. ja: 援護するクポ！
#. de: Kupo-Abwehr!
#. fr: Voilà un coup de main, kupo<nbsp>!
msgctxt "NpcYell:2115:0:13"
msgid "Aye aye!"
msgstr "Так точно!"

#. ja: 乱れ撃つクポーッ！！
#. de: Volles Kupo voraus!
#. fr: Tir en rafale, kupo<nbsp>!
msgctxt "NpcYell:2116:0:13"
msgid "Fer the fallen, kupo!"
msgstr "За павших, купо!"

#. ja: 落ちろ落ちろクポ！
#. de: Falle, kupo, falle!
#. fr: Et hop, K.O. en un kupo<nbsp>!
msgctxt "NpcYell:2117:0:13"
msgid "You brought this on yourself, kupo!"
msgstr "Сам напросился, купо!"

#. ja: 弱らせてやるクポ～！
#. de: Kupo-Schlappmach-Power!
#. fr: Je vais l'affaiblir, kupopo<nbsp>!
msgctxt "NpcYell:2118:0:13"
msgid "You're not getting away this time, kupo!"
msgstr "На этот раз тебе не уйти, купо!"

#. ja: 三角関係クポ！
#. de: Aller guten Dinge sind drei, kupo!
#. fr: En triangle, kupo<nbsp>!
msgctxt "NpcYell:2119:0:13"
msgid "Let's dance, kupo!"
msgstr "А ну, в пляс, купо!"

#. ja: 応援するクポーッ！
#. de: Kupo-Hilfe!
#. fr: À l'unisson, kupo<nbsp>!
msgctxt "NpcYell:2120:0:13"
msgid "For the guard, kupo!"
msgstr "За стражу, купо!"

#. ja: わ、わかったクポ！
#. de: G-Geht klar, kupo!
#. fr: C'est compris, kupo<nbsp>!
msgctxt "NpcYell:2121:0:13"
msgid "Y-Yes sir!"
msgstr "Т-так точно!"

#. ja: れ、練習どおりクポ！
#. de: W-Wie im Training, kupo!
#. fr: Comme à l'en<shy>traî<shy>ne<shy>ment, kupo<nbsp>!
msgctxt "NpcYell:2122:0:13"
msgid "Y-Yes sir!"
msgstr "Т-так точно!"

#. ja: いいですともクポ！
#. de: Weiter so, kupo!
#. fr: Mais bien sûr, kupo<nbsp>!
msgctxt "NpcYell:2123:0:13"
msgid "Hail to the king, kupo!"
msgstr "Да здравствует король, купо!"

#. ja: なんーだ　騒がしーい！<br>なにごーと？
#. de: Wie? Wo? Was geschieht? Ein Monster aus dem Fels?
#. fr: Qu'est-ce que c'est que tout ce tintamarre, ouais<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:2124:0:13"
msgid "Ey? What's the fuss─<br>the trouble, the matter, the fuss?"
msgstr "Эй? Что за шум такой?<br>Что стряслось? Что за переполох?"

#. ja: …やっかいなもーの<br>掘り出しやがーって！
#. de: Oje! Zu tief gebuddelt wir haben!
#. fr: Mais qui a déterré ça, ouais, qui a fait ça<nbsp>!? Bande d'imbéciles, ouais<nbsp>!
msgctxt "NpcYell:2125:0:13"
msgid "Zo Ga wants these tunnels clean, and what Zo Ga says, goes."
msgstr "Зо Га велел очистить эти туннели, а что Зо Га сказал, то и будет."

#. ja: 鉱山かーら　出てーけ！
#. de: Raus aus unseren Minen!
#. fr: On veut pas d'humains dans nos mines, non<nbsp>! Ouste<nbsp>!
msgctxt "NpcYell:2126:0:13"
msgid "Ye'll not leave these tunnels alive."
msgstr "Из этих туннелей живыми не уйдёте."

#. ja: 採掘のジャーマ<br>させなーい！
#. de: Verteidigt die Minen!
#. fr: Rien ne nous empêchera de creuser ici, non, rien ni personne<nbsp>!
msgctxt "NpcYell:2127:0:13"
msgid "The enemy of Zo Ga is my enemy."
msgstr "Враг Зо Га — мой враг."

#. ja: 穴あけてやーる！
#. de: Durchlöchern wir dich werden!
#. fr: J'aime creuser des trous dans des corps d'humains, ouais<nbsp>!
msgctxt "NpcYell:2128:0:13"
msgid "I'll bore a hole in yer bloody chest."
msgstr "Продырявлю тебе грудь к чертям."

#. ja: 石像のクセーに！
#. de: Husch, husch, Steinmonster! Zurück in den Fels!
#. fr: Va-t'en, vilaine statue moche, ouais<nbsp>!
msgctxt "NpcYell:2129:0:13"
msgid "Begone, ye bouldery buggers!"
msgstr "Проваливайте, каменные уроды!"

#. ja: 敗れるときも美しく…
#. de: Nie war verlieren ... schöner!
#. fr: La mort est aussi belle<nbsp>!
msgctxt "NpcYell:2130:0:13"
msgid "Beauteous...to the last!"
msgstr "Прекрасна... до самого конца!"

#. ja: ちょっと手加減してよ！
#. de: He, das tat weh!
#. fr: Grâce<nbsp>! Indulgence<nbsp>!
msgctxt "NpcYell:2131:0:13"
msgid "Owww! Go easy, will ya!?"
msgstr "Ай! Полегче нельзя, а?!"

#. ja: ク、クソが…
#. de: Die Lanze tausch ich um!
#. fr: Argh<nbsp>! P-pas moi...
msgctxt "NpcYell:2132:0:13"
msgid "What in the swivin' hells!?"
msgstr "Какого чёрта?!"

#. ja: うふふ…<br>また傷を癒やさなくっちゃ
#. de: Zeit für 'nen Heilzauber.
#. fr: Qui va me soigner<nbsp>!?
msgctxt "NpcYell:2133:0:13"
msgid "And so it goes..."
msgstr "Ну вот и всё..."

#. ja: 我が呪術が敗れるとは～
#. de: Meine Magie. Besiegt?!
#. fr: Mon pouvoir m'a abandonné<nbsp>!?
msgctxt "NpcYell:2134:0:13"
msgid "In-Inconceivable!"
msgstr "Н-Непостижимо!"

#. ja: 虚ろなる闇に呑まれるがいい！
#. de: Ertrinkt in Dunkelheit!
#. fr: Que les ténèbres t'engloutissent<nbsp>!
msgctxt "NpcYell:2135:0:13"
msgid "Drown in endless darkness!"
msgstr "Утоните в бескрайней тьме!"

#. ja: 床デモ、ナメテナ！
#. de: Für wen hältst du dich?
#. fr: Va te faire voir<nbsp>!
msgctxt "NpcYell:2136:0:13"
msgid "Go and bugger yourself!"
msgstr "Иди ты к чёрту!"

#. ja: バーカ、アーホ！
#. de: Idiot!
#. fr: Débile<nbsp>! Idiot<if $gn4>e</if><nbsp>!
msgctxt "NpcYell:2137:0:13"
msgid "Idiot! Half-wit!"
msgstr "Дурак! Болван!"

#. ja: これなるはエオルゼアいちの強者……<br>その名も、剣豪ギルガメッシュ！
#. de: Narren, ihr steht vor dem größten Schwertkämpfer Eorzeas! Ich bin Gilgamesch!
#. fr: Je suis le plus puissant guerrier d'Éorzéa<nbsp>!<br>Je suis le grand, l'inénarrable Gilgamesh<nbsp>!
msgctxt "NpcYell:2138:0:13"
msgid "dummy - report if visible"
msgstr "заглушка — сообщить, если видна"

#. ja: ファファファ！<br>どうだ、効いただろう！
#. de: Muwahaha! Das tat weh, was?
#. fr: Mouahaha<nbsp>! Alors, vous avez aimé<nbsp>?
msgctxt "NpcYell:2139:0:13"
msgid "Muahaha! How do you like that!?"
msgstr "Муа-ха-ха! Ну как вам это!?"

#. ja: ありゃ？
#. de: Was?!
#. fr: Quoi<nbsp>!?
msgctxt "NpcYell:2140:0:13"
msgid "Huh!?"
msgstr "А?"

#. ja: くそっ！
#. de: Verdammt!
#. fr: Malédiction<nbsp>!
msgctxt "NpcYell:2141:0:13"
msgid "Hm!?"
msgstr "М?"

#. ja: こんにゃろ！
#. de: Unmöglich!
#. fr: Impossible<nbsp>!
msgctxt "NpcYell:2142:0:13"
msgid "Wh-What?"
msgstr "Ч-что?"

#. ja: すばしっこいな！
#. de: He, Schummeln gilt nicht!
#. fr: Quelle rapidité<nbsp>!
msgctxt "NpcYell:2143:0:13"
msgid "Why, you rotten─ That's CHEATING!"
msgstr "Ах ты, мерзавец... Так нечестно!"

#. ja: あ、あたらん！
#. de: Daneben? Wie ist das möglich?
#. fr: Encore raté<nbsp>!
msgctxt "NpcYell:2144:0:13"
msgid "N-No!"
msgstr "Н-нет!"

#. ja: ここまでくれば、<br>逃げ切れただろう…
#. de: Ich muss sagen, dass ich diese Geplänkel wirklich genieße.
#. fr: Haah, haah.. Jusqu'ici, tout va bien...
msgctxt "NpcYell:2145:0:13"
msgid "Hold...hold that thought... "
msgstr "Постой... погоди..."

#. ja: ヘイスト…
#. de: Hast ...
#. fr: “Hâte”<nbsp>!
msgctxt "NpcYell:2146:0:13"
msgid "(That's it...)"
msgstr "(Вот так...)"

#. ja: プロテス…
#. de: Protes ...
#. fr: “Bouclier”<nbsp>!
msgctxt "NpcYell:2147:0:13"
msgid "(One more...)"
msgstr "(Ещё немного...)"

#. ja: シェル…
#. de: Vallum ...
#. fr: “Barrière”<nbsp>!
msgctxt "NpcYell:2148:0:13"
msgid "(Heh heh...)"
msgstr "(Хе-хе...)"

#. ja: ●槍さえあれば戦えるのに
#. de: 0
#. fr: 0
msgctxt "NpcYell:2150:0:13"
msgid "0"
msgstr "0"

#. ja: ●早く連れて行ってよ
#. de: 0
#. fr: 0
