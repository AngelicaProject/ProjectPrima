# NpcYell
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 不幸ガアッテモ<br>オ互イ様デネ…？
#. de: Feigling wagt sich nicht anzugreifen<nbsp>...
#. fr: Nous sommes tous deux en difficultés, non<nbsp>?
msgctxt "NpcYell:13000:0:13"
msgid "You must ask yourself: are you feeling lucky?"
msgstr "Стоит спросить себя: повезёт ли тебе сегодня?"

#. ja: アッ…ソウイウ…<br>扱イナンデスネ…
#. de: Will nicht kämpfen, will wohl keinen Schatz!
#. fr: Ah... C'est tout<nbsp>?
msgctxt "NpcYell:13001:0:13"
msgid "No challengers... Perhaps another time."
msgstr "Никто не бросает мне вызов... Может, в другой раз."

#. ja: オッシャー！<br>殺ス殺ス殺シテヤル～！
#. de: Grroooah! \<donner>
#. fr: Allez<nbsp>! C'est l'heure de tuer, de massacrer, de démolir<nbsp>!
msgctxt "NpcYell:13002:0:13"
msgid "Show me your rage, your rancor!"
msgstr "Покажи мне свою ярость, свою злобу!"

#. ja: オラオラ！<br>コッチ来イヤ～！
#. de: Keine Chance gegen Golem!
#. fr: Rhaaa<nbsp>! Viens-là que je te cogne<nbsp>!
msgctxt "NpcYell:13003:0:13"
msgid "You'll win no prizes at this rate!"
msgstr "Так ты ничего не добьёшься!"

#. ja: 全力デ殺ルゾ～！<br>ドリャアアァァァ！
#. de: Werd zu Staub, Winzling!
#. fr: Je vais t'aplatir de toutes mes forces<nbsp>! Groaaah<nbsp>!
msgctxt "NpcYell:13004:0:13"
msgid "Folly or fortune? Which will it be?"
msgstr "Безумие или удача? Что же выберешь?"

#. ja: 嗚呼…終ワリ…<br>ナンデスネ…サヨ…ナ、ラ…
#. de: Aah<nbsp>... Golem hat<nbsp>... verloren<nbsp>...
#. fr: Aaah... C'est fini... A-adieu...
msgctxt "NpcYell:13005:0:13"
msgid "So you have chosen...fortune?"
msgstr "Значит, ты выбрал... удачу?"

#. ja: システム起動…<br>迎撃行動ヲ開始シマス…
#. de: System wird gestartet >> Abwehrmodus einsatzbereit.
#. fr: Démarrage du système... Mode attaque, activé<nbsp>!
msgctxt "NpcYell:13006:0:13"
msgid "Come to play, have you? Then let's begin!"
msgstr "Пришёл поиграть? Тогда начнём!"

#. ja: グルグル反転…<br>回リマ～ス！
#. de: Achtung! Rotation!
#. fr: Tourne, tourne, tournicoton<nbsp>!
msgctxt "NpcYell:13007:0:13"
msgid "Round and round we go!"
msgstr "Кружимся, кружимся!"

#. ja: グルグルシスギテ<br>目ガ回ル～！
#. de: System meldet >> Kopfschmerzen<nbsp>...
#. fr: Trop trop tourné, j'ai le tournis<nbsp>!
msgctxt "NpcYell:13008:0:13"
msgid "Oh dear... I'm feeling dizzy."
msgstr "Ох... Голова кружится..."

#. ja: 我が言葉に真実あり<br>偽りに染まる者に裁きあれ
#. de: Gleisnerische Kreatur, beuge dich der Macht meines Wortes.
#. fr: Mes paroles détiennent l'unique vérité. Ceux qui s'y opposent seront annihilés par mon jugement.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13009:0:13"
msgid "By my words find riches or ruin.<br>The choice is yours."
msgstr "Моё слово сулит богатство или погибель.<br>Выбор за тобой."

#. ja: 歩み続ける者に<br>裁きあれ…
#. de: Der es wagt einen Schritt zu tun, er möge brennen!
#. fr: Que ceux qui marchent soient jugés...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13010:0:13"
msgid "What stumbles and flails?<br>The burned man."
msgstr "Что спотыкается и мечется?<br>Обожжённый."

#. ja: 立ち止まる者に<br>裁きあれ…
#. de: Der es wagt zu rasten, er möge zu Eis erstarren!
#. fr: Que ceux qui restent immobiles soient jugés...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13011:0:13"
msgid "What waits unmoving?<br>Brittle bones."
msgstr "Что ждёт неподвижно?<br>Хрупкие кости."

#. ja: 我に近づく者に<br>裁きあれ…
#. de: Der es wagt voranzuschreiten, möge meinen Zorn spüren!
#. fr: Que ceux qui s'approchent de moi soient jugés...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13012:0:13"
msgid "What comes unto me?<br>The trapped."
msgstr "Что идёт ко мне?<br>Пленник."

#. ja: 我より離れし者に<br>裁きあれ…
#. de: Der es wagt zurückzuweichen, möge sich vor Schmerz winden!
#. fr: Que ceux qui s'éloignent de moi soient jugés...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13013:0:13"
msgid "What flees my reach?<br>The doomed man."
msgstr "Кто ускользнёт от меня?<br>Обречённый."

#. ja: 見捨てし者に<br>裁きあれ…
#. de: Der es wagt nur sich selbst zu sehen, möge der Donner dahinraffen!
#. fr: Que ceux qui m'ignorent soient jugés...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13014:0:13"
msgid "What stands alone?<br>The dead oak."
msgstr "Что стоит в одиночестве?<br>Мёртвый дуб."

#. ja: 巻き込みし者に<br>裁きあれ…
#. de: Der es wagt da<shy>zwischen<shy>zu<shy>treten, möge zu Asche zerfallen!
#. fr: Que ceux qui se mèlent au combat soient jugés...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13015:0:13"
msgid "What stand together?<br>Walls turned to ash."
msgstr "Что стоит плечом к плечу?<br>Стены, обращённые в пепел."

#. ja: そうだ…<br>この感情だ…！
#. de: Endlich ... fühle ich wieder etwas.
#. fr: Cette exaltation... Je ne l'avais pas ressentie depuis si longtemps<nbsp>!
msgctxt "NpcYell:13016:0:13"
msgid "Yes... This is what I longed to feel once more..."
msgstr "Да... Вот это чувство... Я так хотел испытать его снова..."

#. ja: かつて我は戦った…<br>誇りを懸けて…！
#. de: In Erinnerung an vergangenem Ruhm!
#. fr: Autrefois, je mettais ainsi ma fierté à l'épreuve<nbsp>!
msgctxt "NpcYell:13017:0:13"
msgid "Long ago, I fought for honor...for glory..."
msgstr "Давным-давно я сражался за честь... за славу..."

#. ja: 見事だ、小さき者よ…<br>いや、新しき友よ…！
#. de: Beeindruckend, kleines Wesen. Ich danke dir!
#. fr: Bravo, petit être<nbsp>! Ou devrais-je dire, <if $gn4>ma rivale et amie<else>mon rival et ami</if><nbsp>!
msgctxt "NpcYell:13018:0:13"
msgid "Tiny warrior... I sense in thee a kindred spirit."
msgstr "Маленький воин... Чую в тебе родственную душу."

#. ja: 強者に挑む心を<br>少しばかり思い出せたぞ！
#. de: Du hast in mir das Feuer des Kampfes neu entfacht!
#. fr: Tu m'as rappelé cette glorieuse époque où je prouvais ma valeur à chaque défi<nbsp>!
msgctxt "NpcYell:13019:0:13"
msgid "Thou hath reawoken me to the thrill of battle!"
msgstr "Ты пробудил во мне былой азарт битвы!"

#. ja: な、なんだ…<br>結晶獣のあの姿は…！？
#. de: Oje, sie haben ihre Gestalt verändert<nbsp>...
#. fr: Ces créatures ont changé de forme<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13020:0:13"
msgid "Tigers...?<br>How is this possible?"
msgstr "Тигры...?<br>Как такое возможно?"

#. ja: 氷属性のエーテルを得て<br>変異を遂げたのか！
#. de: Sie haben Eis-Äther aufgesogen und sind mutiert!
#. fr: Est-ce l'énergie de glace qui a causé leur mutation<nbsp>!?
msgctxt "NpcYell:13021:0:13"
msgid "The aetheric ice! It's powered some kind of...evolution."
msgstr "Ледяной эфир! Он вызвал какую-то... эволюцию."

#. ja: み、みなさん！<br>至急、討伐をお願いします！
#. de: Hilfe, sie müssen schleunigst ausgeschaltet werden!
#. fr: Tous les glaneurs sont appelés à aider en urgence<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13022:0:13"
msgid "We have to break them.<br>Break them now!"
msgstr "Надо их одолеть.<br>Немедленно!"

#. ja: 討伐を確認しました！<br>ありがとうございます！
#. de: Die Gefahr ist gebannt. Vielen Dank!
#. fr: Menace éliminée<nbsp>! Excellent travail à tous<nbsp>!
msgctxt "NpcYell:13023:0:13"
msgid "Yes, the creatures appear thoroughly pulverized."
msgstr "Да, похоже, от этих тварей не осталось и следа."

#. ja: 属性増殖炉も無事ですね<br>本当に良かった…！
#. de: Zum Glück wurde der Elementarbrüter nicht beschädigt!
#. fr: Et en plus, le réacteur n'a subi aucun dégât majeur<nbsp>!
msgctxt "NpcYell:13024:0:13"
msgid "And the reactor seems none the worse for wear. Thank you!"
msgstr "И реактор цел. Спасибо!"

#. ja: こっちも片付いたようだな…！
#. de: Die Lage ist unter Kontrolle!
#. fr: Ravie de voir que tout est sous contrôle, ici<nbsp>!
msgctxt "NpcYell:13025:0:13"
msgid "Everything in order here?"
msgstr "Здесь всё в порядке?"

#. ja: ギリー先生…！<br>危ないところでした…
#. de: Professor Gilly, das war ganz schön gefährlich!
#. fr: Oui, mais nous avons frôlé le pire...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13026:0:13"
msgid "Professor Gilly!<br>It was a near thing..."
msgstr "Профессор Гилли!<br>Ещё бы немного..."

#. ja: 実験生物の管理体制を<br>イチから見直すぞ！
#. de: Wir müssen die Verwahrung der Testsubjekte von Grund auf überdenken!
#. fr: Revoyons le système de sur<shy>veil<shy>lan<shy>ce des créatures expérimentales<nbsp>!
msgctxt "NpcYell:13027:0:13"
msgid "We shall have to rethink our experiment protocol from the ground up."
msgstr "Надо заново пересмотреть весь протокол экспериментов."

#. ja: は、はい…！<br>急ぎ改善案をまとめます！
#. de: Ja! Ich werde sofort einen Plan ausarbeiten.
#. fr: À vos ordres, Professeur<nbsp>! Je vais préparer des suggestions<nbsp>!
msgctxt "NpcYell:13028:0:13"
msgid "Understood! I'll start drafting improvements at once!"
msgstr "Поняла! Сейчас же подготовлю предложения по улучшению!"

#. ja: この勢いは止められない！<br>退避しましょう…！
#. de: Wir halten nicht länger durch. Rückzug!
#. fr: La situation est hors de contrôle<nbsp>! Ordre d'évacuer<nbsp>!
msgctxt "NpcYell:13029:0:13"
msgid "They've grown too powerful. We withdraw for now..."
msgstr "Они стали слишком сильны. Пока отступим..."

#. ja: 駄目だ…<br>こんなものでは…
#. de: Das bringt doch alles nichts<nbsp>...
#. fr: Voilà qui ne m'arrachera pas à ma torpeur...
msgctxt "NpcYell:13030:0:13"
msgid "Nay, 'tis not enough..."
msgstr "Нет... Этого недостаточно..."

#. ja: やはり絶望に沈むしか<br>ないというのか…
#. de: Uns bleibt nichts als Ver<shy>zweif<shy>lung<nbsp>...
#. fr: Rien n'égalera l'excitation des jours d'antan... Seule la désolation de la monotonie reste, désormais...
msgctxt "NpcYell:13031:0:13"
msgid "Naught remaineth for me but to sink into oblivion..."
msgstr "Неужели мне остаётся лишь погрузиться в небытие..."

#. ja: 助かったよ<br>荒ぶるガジャは怖いな…
#. de: Gut, dass ich gewartet habe. Mit rasenden Gaja ist nicht zu spaßen!
#. fr: Ouf, ces gaja étaient effrayants<nbsp>! Merci beaucoup<nbsp>!
msgctxt "NpcYell:13032:0:13"
msgid "Many thanks, friend. If I'd gone myself, I'd have ended up as some gaja's supper."
msgstr "Спасибо, друг. Пошёл бы я сам — стал бы добычей какого-нибудь гажда."

#. ja: 配達があったのに…<br>仕方ない、出直すか…
#. de: Keiner hat behauptet, ich müsse mein Leben für den Job riskieren. Ich bin weg.
#. fr: Je ne vais pas risquer ma vie pour ce travail... Hop, demi-tour.
#, aeria-term-model-exception: job b3e546875adf
msgctxt "NpcYell:13033:0:13"
msgid "If I'm going to risk my life for this job, I want double the coin. Back to town it is, then!"
msgstr "Ради такой работы рисковать жизнью? За двойную плату, пожалуй. Возвращаюсь в город!"

#. ja: 破壊ハ創造デス…！
#. de: UM ZU ERSCHAFFEN ... MUSS ... ZERSTÖRT WERDEN.
#. fr: NOUS VOUS ASSISTONS... À TOUT DÉTRUIRE<nbsp>!
msgctxt "NpcYell:13034:0:13"
msgid "THERE IS NO CREATION...WITHOUT DESTRUCTION!"
msgstr "НЕТ ТВОРЕНИЯ... БЕЗ РАЗРУШЕНИЯ!"

#. ja: 破壊ニ笑顔ヲ…！
#. de: ZERSTÖRUNG ZAUBERT JEDEM ... EIN LÄCHELN INS GESICHT.
#. fr: TOUT DÉTRUIRE... AVEC LE SOURIRE<nbsp>!
msgctxt "NpcYell:13035:0:13"
msgid "BEHIND EVERY SMILE...IS DEATH AND ANNIHILATION!"
msgstr "ЗА КАЖДОЙ УЛЫБКОЙ... СТОЯТ СМЕРТЬ И ГИБЕЛЬ!"

#. ja: 双方とも<br>見事な戦いぶりであった…！
#. de: Das war ein glorreicher Kampf!
#. fr: Fé<shy>li<shy>ci<shy>ta<shy>tions<nbsp>! Quel magnifique combat<nbsp>!
msgctxt "NpcYell:13036:0:13"
msgid "A glorious battle indeed..."
msgstr "Вот это была славная битва..."

#. ja: 見ている我もまた<br>心震え、竜詩を紡ぎたくなるほど…！
#. de: Euer Kampf hat mich zu einem neuen Drachenlied inspiriert!
#. fr: Je pense en faire une chanson tant j'ai frémi au rythme de vos assauts<nbsp>!
msgctxt "NpcYell:13037:0:13"
msgid "So glorious as to inspire a new song, methinks."
msgstr "Так славно, что впору сложить новую песню."

#. ja: 小さき者よ…<br>此度の力添え、感謝するぞ
#. de: Ich danke dir für dieses Kräftemessen!
#. fr: Tu as mes plus sincères re<shy>mer<shy>cie<shy>ments, petit être.
msgctxt "NpcYell:13038:0:13"
msgid "I thank thee for thine aid, little one."
msgstr "Благодарю за помощь, маленький друг."

#. ja: 我が新しき友よ<br>さらばだ…！
#. de: Gehe in Freund<shy>schaft und lebe wohl!
#. fr: Adieu, <if $gn4>mon amie<else>mon ami</if><nbsp>!
msgctxt "NpcYell:13039:0:13"
msgid "Farewell to thee, friend."
msgstr "Прощай, друг."

#. ja: 我が友の勝利を<br>喜ぶべきであろうが…
#. de: Ich sollte mich für deinen Sieg freuen, aber<nbsp>...
#. fr: La victoire de mon ami devrait me réjouir, mais...
msgctxt "NpcYell:13040:0:13"
msgid "Victorious, as ever..."
msgstr "Мне бы радоваться победе друга... но..."

#. ja: この勝利に誇りはない…
#. de: Dieser Sieg ist ohne Stolz.
#. fr: Il n'a pu en tirer aucune gloire...
msgctxt "NpcYell:13041:0:13"
msgid "Yet to triumph with ease bringeth no glory."
msgstr "Лёгкая победа не приносит славы."

#. ja: さらばだ、小さき者よ…
#. de: Lebe wohl, <if $gn4>Sterbliche<else>Sterblicher</if>!
#. fr: Adieu... Petit être...
msgctxt "NpcYell:13042:0:13"
msgid "Farewell to thee, little one."
msgstr "Прощай, маленький друг..."

#. ja: 我と戦ってくれるのか<br>小さき者よ…！
#. de: Bist du bereit, gegen mich zu kämpfen?!
#. fr: Tu as le courage de me défier, petit être<nbsp>!? Fort bien<nbsp>!
msgctxt "NpcYell:13043:0:13"
msgid "How now? Wilt thou rise to my challenge?"
msgstr "Ну как? Примешь мой вызов?"

#. ja: 不完全ナ肉体…<br>イラナイ…
#. de: Ich brauche keinen fehlerhaften Körper aus Fleisch und Blut<nbsp>...
#. fr: Personne... n'a besoin... d-d'un corps... impar.. fait...
msgctxt "NpcYell:13044:0:13"
msgid "I'vE no nEed fOr an iMperFect ForM..."
msgstr "Мне не нуЖна неСоВершеннаЯ фоРма..."

#. ja: 痛イ痛イ痛イ…<br>肉体ヲ捨テタイ…
#. de: Dieser Schmerz<nbsp>... Wie werde ich diesen Körper los<nbsp>...?
#. fr: La douleur... Elle me parcourt... Cette enveloppe... est un supplice...
msgctxt "NpcYell:13045:0:13"
msgid "CurSe tHis wReTchEd boDy..."
msgstr "ПроклЯтое немоЩное тело..."

#. ja: アガガガガ…
#. de: Argh<nbsp>...
#. fr: (gémit)...
msgctxt "NpcYell:13046:0:13"
msgid "HrRrgrRr..."
msgstr "Хррргрр..."

#. ja: ガアッ！
#. de: Ahhh!
#. fr: Graaarrr...<nbsp>!
msgctxt "NpcYell:13047:0:13"
msgid "\\<growl>"
msgstr "<i>Гр-р!</i>"

#. ja: グオォォォ！
#. de: Groooh!
#. fr: Groah<nbsp>!
msgctxt "NpcYell:13048:0:13"
msgid "\\<rumble>"
msgstr "<i>Гр-р-р!</i>"

#. ja: ギャアァッ！
#. de: Gyaaa!
#. fr: Gyaaarrh<nbsp>!
msgctxt "NpcYell:13049:0:13"
msgid "\\<screech>"
msgstr "<i>И-а-а!</i>"

#. ja: フシュー！
#. de: Pfffsss!
#. fr: Pffffsssshhhh<nbsp>!
msgctxt "NpcYell:13050:0:13"
msgid "\\<hiss>"
msgstr "<i>Ш-ш-ш!</i>"

#. ja: ゴシャアァァッ！
#. de: Grontsch!
#. fr: Gsshhhaaaa<nbsp>!
msgctxt "NpcYell:13051:0:13"
msgid "\\<roar>"
msgstr "<i>Р-р-р-а-а!</i>"

#. ja: うん、イイ香り…！<br>みんな、ありがとうネ！
#. de: Hmmm! Was für ein herrlicher Duft. Dankeschön!
#. fr: Ah, qu'elles sentent bon... Merci beaucoup<nbsp>!
msgctxt "NpcYell:13052:0:13"
msgid "Oh, what a lovely scent! Thank you ever so much!"
msgstr "Ох, какой чудесный аромат! Спасибо вам огромное!"

#. ja: 帰って調合するのが<br>楽しみだヨ！
#. de: Ich werde sie umgehend zu Essenz verarbeiten!
#. fr: J'ai hâte de me mettre à la fabrication de mon parfum<nbsp>!
msgctxt "NpcYell:13053:0:13"
msgid "What a wondrous perfume I will be able to fashion now!"
msgstr "Какой дивный аромат я теперь смогу создать!"

#. ja: 残念だけど<br>諦めるしかないみたいネ…
#. de: Das ist wirklich schade. Dann muss ich wohl zusehen, dass ich woanders meine Blüten finde.
#. fr: C'est dommage, mais on n'a pas d'autre choix que d'abandonner...
msgctxt "NpcYell:13054:0:13"
msgid "'Tis a shame, but I'll simply have to acquire my blossoms through other means."
msgstr "Жаль, но придётся раздобыть цветы где-нибудь ещё."

#. ja: わわっ…！<br>怪鳥の群れネ！
#. de: Argh! Garstige Flugratten!
#. fr: Oh non<nbsp>! Les oiseaux<nbsp>!
msgctxt "NpcYell:13055:0:13"
msgid "Bah! Winged monstrosities! Begone from this place!"
msgstr "Тьфу! Крылатые чудовища! Прочь отсюда!"

#. ja: しまったネ…！<br>お花、落としちゃったヨ！
#. de: Oh, nein! Jetzt habe ich auch noch alle Blumen fallen lassen!
#. fr: Non... J'ai fait tomber mes fleurs<nbsp>!
msgctxt "NpcYell:13056:0:13"
msgid "Oh, no! I've gone and dropped all my blossoms!"
msgstr "Ой нет! Я уронила все цветы!"

#. ja: アワアワ…<br>どうしようネ…！
#. de: Beim großen Tiegel, was soll ich nun tun?!
#. fr: Que faire...<nbsp>!?
msgctxt "NpcYell:13057:0:13"
msgid "Oh dear, oh dear! Whatever shall I do!?"
msgstr "Ой-ой! Что же мне теперь делать?!"

#. ja: きっと花の香りに<br>誘われて来たのネ…！
#. de: Bestimmt wurden sie vom Duft der Blüten angelockt!
#. fr: Ils ont cer<shy>tai<shy>ne<shy>ment été attirés par l'odeur des fleurs<nbsp>!
msgctxt "NpcYell:13058:0:13"
msgid "It seems they've been drawn here by the flowers' most alluring aroma."
msgstr "Похоже, их приманил чудесный аромат цветов."

#. ja: ありがとうネ！<br>これでお花、拾えるヨ！
#. de: Danke! Lass mich schnell die Blumen auflesen.
#. fr: Merci<nbsp>! Grâce à toi, je vais pouvoir ramasser mes petites fleurs<nbsp>!
msgctxt "NpcYell:13059:0:13"
msgid "Oh, thank you! Now, to pick up all these blossoms..."
msgstr "Ой, спасибо! Теперь соберу все цветочки..."

#. ja: こっちのお花…<br>無事だったヨ！
#. de: Die hier sieht noch gut aus ...
#. fr: Les fleurs ici n'ont rien<nbsp>!
msgctxt "NpcYell:13060:0:13"
msgid "Phew! This flower appears undamaged..."
msgstr "Фух! Этот цветок, кажется, не пострадал..."

#. ja: こっちのお花も…<br>大丈夫ネ！
#. de: Welch ein Glück! Die ist auch noch heil!
#. fr: Celles-ci aussi<nbsp>! Elles sont en parfait état<nbsp>!
msgctxt "NpcYell:13061:0:13"
msgid "And...yes, this flower is safe as well!"
msgstr "А... да, и этот цветок цел!"

#. ja: 全部拾い集めたヨ！<br>帰ってお香、作るネ！
#. de: Damit wären sie wieder alle beisammen. Dann mach ich mich mal auf den Weg, bevor noch mehr von den Biestern kommen!
#. fr: Je les ai toutes ramassées<nbsp>! Je vais rentrer et me mettre à la création de mon parfum.
msgctxt "NpcYell:13062:0:13"
msgid "I have them all! Now to return and whip up the realm's most lovely perfume!"
msgstr "Все собраны! Пора домой и готовить самый чудесный парфюм в мире!"

#. ja: クスン…またお花<br>集めないとだヨ…
#. de: Oh, weh! Jetzt muss ich wieder ganz von vorne beginnen!
#. fr: Bon... Je dois continuer à cueillir des fleurs.
msgctxt "NpcYell:13063:0:13"
msgid "Oh, woe is me! Must I truly start all over again...?"
msgstr "Ох, горе мне! Неужели придётся начинать всё сначала?.."

#. ja: すべてを<br>終わらせるのだ…！
#. de: Ich bringe es zu Ende!
#. fr: Notre espèce ne mérite pas de survivre<nbsp>!
msgctxt "NpcYell:13064:0:13"
msgid "All shall end..."
msgstr "Всё должно закончиться..."

#. ja: 終わりを…！<br>永遠の終わりを…！
#. de: Das Ende<nbsp>...! Das Ende der Ewigkeit<nbsp>...!
#. fr: Les dragons doivent éter<shy>nel<shy>le<shy>ment être relégués au passé<nbsp>!
msgctxt "NpcYell:13065:0:13"
msgid "The end cometh..."
msgstr "Конец грядёт..."

#. ja: 助けて～！
#. de: Hilfe!
#. fr: Quelqu'un<nbsp>! Au secours<nbsp>!!!
msgctxt "NpcYell:13066:0:13"
msgid "Someone help!"
msgstr "На помощь!"

#. ja: 痛いよォ…！
#. de: Das schmerzt<nbsp>...
#. fr: Vous nous faites mal<nbsp>!
msgctxt "NpcYell:13067:0:13"
msgid "That hurteth..."
msgstr "Больно же..."

#. ja: イヤだ、よ…
#. de: Ich will nicht sterben<nbsp>...
#. fr: Laissez-nous tranquilles...
msgctxt "NpcYell:13068:0:13"
msgid "Stay back!"
msgstr "Не подходи!"

#. ja: た、助かった～！
#. de: Danke für die Rettung!
#. fr: Sauvés<nbsp>!
msgctxt "NpcYell:13069:0:13"
msgid "W-We are saved!"
msgstr "М-мы спасены!"

#. ja: ありがとう！
#. de: Vielen Dank!
#. fr: Merci<nbsp>!
msgctxt "NpcYell:13070:0:13"
msgid "Many thanks!"
msgstr "Огромное спасибо!"

#. ja: そ、そんな…<br>兄弟たちが…！
#. de: Das darf doch nicht wahr sein!
#. fr: Non<nbsp>! Mes frères et sœurs, ils...
msgctxt "NpcYell:13071:0:13"
msgid "Nay... Please..."
msgstr "Нет... Прошу..."

#. ja: いったいソクレス園長に<br>どう弁明すれば…
#. de: Wie soll ich das nur Sokles erklären?
#. fr: Qu'est-ce que je vais dire à Soclès<nbsp>?
msgctxt "NpcYell:13072:0:13"
msgid "How shall I ever face Overseer Sokles again?"
msgstr "Как же я теперь посмотрю в глаза смотрителю Соклесу?"

#. ja: ソクレス園長に<br>正面から弁明するしかない…！
#. de: Hoffentlich wird Sokles nicht böse.
#. fr: Je vais aller faire mes plus plates excuses à Soclès...
msgctxt "NpcYell:13073:0:13"
msgid "I've only t-to fall to my knees. Beg for forgiveness!"
msgstr "Остаётся только... упасть к нему в ноги и молить о прощении!"

#. ja: 助かりました！<br>さっそく園長に届けないと…！
#. de: Danke! Und jetzt schnell zu Sokles!
#. fr: Merci beaucoup<nbsp>! Je vais tout de suite les apporter à Soclès<nbsp>!
msgctxt "NpcYell:13074:0:13"
msgid "Oh, thank you─I am saved, truly! I shall bring these to Overseer Sokles at once."
msgstr "Ох, спасибо! Вы меня спасли, правда! Сейчас же отнесу всё смотрителю Соклесу."

#. ja: 観察記録があったら<br>持ってきてください！
#. de: Bitte bring mir meine Notizbücher zurück!
#. fr: Donne-moi les feuilles que tu récupères, s'il te plaît<nbsp>!
msgctxt "NpcYell:13075:0:13"
msgid "Should you happen upon any of those documents, do bring them to me."
msgstr "Если найдёте какие-нибудь документы, обязательно принесите их мне."

#. ja: やった～！<br>で、出口だぁ～！
#. de: Bei meinen Möhren, der Ausgang!
#. fr: Le chemin s'est ouvert<nbsp>! Je suis libre<nbsp>! Liiibre<nbsp>!
msgctxt "NpcYell:13076:0:13"
msgid "Please, oh please, let this way lead out!"
msgstr "Ой, пусть это будет выход!"

#. ja: た、助けておくれ～！
#. de: Hiiilfe! So heeelft mir doooch!
#. fr: Auuu seeecooours<nbsp>!
msgctxt "NpcYell:13077:0:13"
msgid "I just want to go home!"
msgstr "Я просто хочу домой!"

#. ja: また同じところに出た…<br>もう嫌だよぉ…
#. de: Verflixt und zugemöhrt, das war schon wieder die gleiche Tür! Ich mag nicht mehr!
#. fr: Encore le même escalier<nbsp>! J'en ai marre de tourner en rond<nbsp>!
msgctxt "NpcYell:13078:0:13"
msgid "This hallway again!? Ugh, I need to get out of here!"
msgstr "Опять этот коридор!? Ну сколько можно, мне надо отсюда выбраться!"

#. ja: なんだ、この構造は…<br>設計責任者はどこだ！？
#. de: Wer hat den Unsinn hier denn gebaut?! Dem zieh ich die Löffel lang!
#. fr: Ce n'est pas possible<nbsp>! Amenez-moi cet architecte<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:13079:0:13"
msgid "There's nothing <i>happy</i> about this place!"
msgstr "В этом месте нет ничего <i>радостного</i>!"

#. ja: つ、次こそ脱出してやる！
#. de: Die nächste Tür ist der Ausgang, ganz bestimmt<nbsp>...!
#. fr: Allez, encore un tour, et... et je me lance<nbsp>!
msgctxt "NpcYell:13080:0:13"
msgid "Does an exit even exist here?"
msgstr "А выход тут вообще есть?"

#. ja: ちとマズイな…
#. de: Das nimmt kein gutes Ende.
#. fr: Ça sent le roussi...
msgctxt "NpcYell:13081:0:13"
msgid "Concentrate!"
msgstr "Смущение!"

#. ja: 耐えてみせる！
#. de: Bloß ... ein Kratzer.
#. fr: Je tiendrai bon<nbsp>!
msgctxt "NpcYell:13082:0:13"
msgid "It is nothing."
msgstr "Я выдержу!"

#. ja: い、痛くも、かゆくもないわッ！
#. de: Das bringt mich nicht um.
#. fr: La douleur n'est rien !
msgctxt "NpcYell:13083:0:13"
msgid "'Tis but a scratch!"
msgstr "Подумаешь, царапина!"

#. ja: しまった…<br>皆とはぐれてしまった…！
#. de: Oh weh, die anderen sind mir weit voraus ...
#. fr: Oh non, où sont les autres<nbsp>?
msgctxt "NpcYell:13084:0:13"
msgid "Confound it, where did everyone go...?"
msgstr "Проклятье, куда все подевались?.."

#. ja: なっ、魔物！？<br>誰か助けてくれ～！
#. de: Mrga, steht mir bei! Zu Hilfe!
#. fr: Des monstres<nbsp>!? À l'aide<nbsp>!
msgctxt "NpcYell:13085:0:13"
msgid "Uwaaah, lizards! Help! Someone, help!"
msgstr "А-а-а, ящеры! Помогите! Кто-нибудь, помогите!"

#. ja: ひぃっ…<br>食べないでくれ！
#. de: Uaaah! Bitte<nbsp>... Fresst mich nicht. Ich bin ein mageres Mahl!
#. fr: Hiii, ne me mange pas<nbsp>!
msgctxt "NpcYell:13086:0:13"
msgid "Please don't eat me! I'm all skin and bones!"
msgstr "Пожалуйста, не ешьте меня! От меня одни кожа да кости!"

#. ja: ムリガの神よ！<br>救いたまえ…！
#. de: Wenn jetzt kein Wunder geschieht, bin ich des Todes!
#. fr: Dieux mrga... Sauvez-moi<nbsp>!
msgctxt "NpcYell:13087:0:13"
msgid "O merciful Mrga, deliver us from evil!"
msgstr "О милосердные боги мурга, избавьте нас от зла!"

#. ja: た、助かったよ…！<br>これも神々のお導きだね！
#. de: Die Rettung! Die Mrga waren mir gnädig und haben Hilfe gesendet!
#. fr: Je... je suis vivant<nbsp>! Loués soient les dieux mrga<nbsp>!
msgctxt "NpcYell:13088:0:13"
msgid "Oh, praise be to the Mrga for sending you to me!"
msgstr "Слава богам мурга, что послали тебя ко мне!"

#. ja: 神々に救いを求める<br>巡礼の道中だったんだ…
#. de: Ich war auf Pilgerreise, um die Hilfe der Mrga in diesen dunklen Tagen zu erbitten.
#. fr: J'étais en plein pèlerinage...
msgctxt "NpcYell:13089:0:13"
msgid "I'm on a pilgrimage to seek salvation from the gods."
msgstr "Я держу путь в паломничество, чтобы молить богов о спасении."

#. ja: 皆とはぐれてしまったが<br>目的地は同じだからね…
#. de: Aber ich war so in Gedanken verloren, dass ich von meiner Gruppe getrennt wurde.
#. fr: J'ai été séparé des autres pèlerins, mais je les retrouverai à l'arrivée.
msgctxt "NpcYell:13090:0:13"
msgid "But I became separated from my companions."
msgstr "Но я отстал от спутников."

#. ja: ムリガの神に祈りたい者は<br>一緒に巡礼しよう…！
#. de: Ich werde jetzt wieder mit der Gruppe aufschließen.
#. fr: Je vais me dépêcher de rattraper le groupe.
msgctxt "NpcYell:13091:0:13"
msgid "I will try and catch up to them now."
msgstr "Попробую сейчас их догнать."

#. ja: では、出発だ…！
#. de: Danke für deine Hilfe! Mögen die Mrga dich reich beschenken!
#. fr: Allez, je dois reprendre mon voyage<nbsp>!
msgctxt "NpcYell:13092:0:13"
msgid "Thank you, and may the Mrga bless and keep you!"
msgstr "Спасибо, и пусть боги мурга хранят тебя!"

#. ja: 巡礼の旅もここまでか…<br>に、逃げよう…！
#. de: Das ist wohl das Ende der Pilgerreise. Flieht!!
#. fr: Je ne pourrai donc pas finir mon pèlerinage... Fuyons<nbsp>!
msgctxt "NpcYell:13093:0:13"
msgid "So much for the pilgrimage... Best flee while I can!"
msgstr "Вот и конец паломничеству... Надо бежать, пока цел!"

#. ja: ひぃぃ…恐ろしい！<br>配達ができないじゃないか！
#. de: Uaaah! Der Gaja hat mich böse angeguckt! Bi-bi-bitte nicht niedertrampeln!
#. fr: Aaahhh<nbsp>! Mais comment je fais pour passer, moi<nbsp>?
msgctxt "NpcYell:13094:0:13"
msgid "Uwaaah! Did you see the way that gaja looked at me!? It wants me for supper!"
msgstr "А-а-а! Видели, как на меня посмотрел этот гажд?! Он хочет съесть меня!"

#. ja: 浜辺のヴァルラス<br>また増えたな…
#. de: In letzter Zeit machen sich schon wieder diese Vaalaras am Strand breit.
#. fr: Il y a encore plus de vaalaras qu'avant...
msgctxt "NpcYell:13095:0:13"
msgid "The beaches are overrun with those damn valras of late..."
msgstr "В последнее время пляжи опять кишат этими проклятыми валрасами..."

#. ja: 漁に出られない…<br>どうしよう…
#. de: Wenn diese Klöpse an den Strand gerollt kommen, ist ans Fischen nicht zu denken! Ein echtes Problem!
#. fr: Je ne peux même pas aller pêcher...
msgctxt "NpcYell:13096:0:13"
msgid "How am I supposed to go fishing with these blasted creatures about!? Am I doomed to starve to death?"
msgstr "Как тут рыбачить, когда вокруг эти твари!? Неужели я обречён умереть с голоду?"

#. ja: 追い払ってくれたのか<br>ありがとう！
#. de: Du hast die Ungetüme wieder ins Meer gejagt! Sauber!
#. fr: Merci de les avoir fait fuir<nbsp>!
msgctxt "NpcYell:13097:0:13"
msgid "Oh, thank you for dispatching those monsters! Finally I can fish again!"
msgstr "О, спасибо, что расправились с чудовищами! Наконец-то снова можно рыбачить!"

#. ja: 今日は<br>もう漁は無理だな…
#. de: Heute wird's wohl nichts mehr mit dem Fischen<nbsp>...
#. fr: Bon ben... Je n'ai plus qu'à rentrer chez moi...
msgctxt "NpcYell:13098:0:13"
msgid "I suppose I'll put away my fishing pole and hope for better luck tomorrow..."
msgstr "Пожалуй, уберу удочку и попробую счастья завтра..."

#. ja: 帰りましょうか…<br>売る物すら手に入らない…
#. de: Ich geh mal wieder nach Hause. Für den Markt fange ich hier eh nix mehr.
#. fr: Je n'arriverai pas à attraper quoi que ce soit aujourd'hui... Autant abandonner.
msgctxt "NpcYell:13099:0:13"
msgid "Empty-handed again... The buyers at the market will be oh so disappointed in me..."
msgstr "Опять с пустыми руками... Покупатели на рынке так разочаруются во мне..."

#. ja: やったね！<br>撃退成功だよ～！
#. de: Wir haben sie in die Flucht geschlagen!
#. fr: Victoire<nbsp>! La menace est neutralisée<nbsp>!
msgctxt "NpcYell:13100:0:13"
msgid "We did it! They were no match for us!"
msgstr "Мы справились! Им нас не одолеть!"

#. ja: あれれ？<br>あの子は…！？
#. de: Hast du was abbekommen?
#. fr: Oh non, aurions-nous un blessé<nbsp>!?
msgctxt "NpcYell:13101:0:13"
msgid "Oh, but what about you?"
msgstr "Ой, а ты как?"

#. ja: 大丈夫？<br>怪我してない？
#. de: Alles in Ordnung?
#. fr: Est-ce que tout va bien<nbsp>?
msgctxt "NpcYell:13102:0:13"
msgid "I hope you weren't injured..."
msgstr "Надеюсь, ты не пострадал..."

#. ja: イヒ、イヒヒヒ…！<br>この強さは利用できるぞ…！
#. de: Kihihi! Das nenn ich unbändige Maschinen-Kraft!
#. fr: Hé hé hé... Quelle force terrifiante<nbsp>!
msgctxt "NpcYell:13103:0:13"
msgid "Eheheh... This data is precisely what I needed!"
msgstr "Хе-хе-хе... Именно эти данные мне и нужны!"

#. ja: ついて来てくれ！<br>オマエラ向きの仕事がある！
#. de: He, du da! Komm mit, ich habe was für dich zu tun!
#. fr: Suivez-moi, j'ai du travail pour vous<nbsp>!
msgctxt "NpcYell:13104:0:13"
msgid "Come─quickly! There's much work to be done!"
msgstr "Сюда, скорее! Дел невпроворот!"

#. ja: な、なんのつもりなの？<br>ちょっと待ってよ～！
#. de: M-Moment mal! Was soll das werden?!
#. fr: Quoi<nbsp>? Mais... attends une seconde<nbsp>!
msgctxt "NpcYell:13105:0:13"
msgid "W-Wait! Where are you going!?"
msgstr "П-постойте! Куда вы?!"

#. ja: だれか！<br>力を貸しておくれ～！
#. de: Zu Hilfe! Ich brauche Verstärkung!
#. fr: Aux armes, lapins<nbsp>! Et même si vous n'en êtes pas un<nbsp>!
msgctxt "NpcYell:13106:0:13"
msgid "Pl-Please! Somebody help!"
msgstr "П-помогите! Кто-нибудь!"

#. ja: 急いでみんなを<br>退避させないと～！
#. de: Ach du grüne Rübe! Alle evakuieren, schnell!
#. fr: Ordre d'évacuer<nbsp>! Je répète<nbsp>: ordre d'évacuer<nbsp>!
msgctxt "NpcYell:13107:0:13"
msgid "We have to get everyone to safety!"
msgstr "Надо срочно увести всех в безопасное место!"

#. ja: 特別公演が<br>始まるぞ！
#. de: Leute, das Konzert geht los!
#. fr: Le concert va commencer<nbsp>!
msgctxt "NpcYell:13108:0:13"
msgid "The show's about to start!"
msgstr "Скоро начнётся представление!"

#. ja: お～い、そこの使い魔クン！<br>手伝ってくれないか？
#. de: Familiar! Hilf mir mal!
#. fr: Familier<nbsp>! Pourrais-tu me rendre un service<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:13109:0:13"
msgid "Oh, you there! Familiar! Yes, <i>you</i>. Come here and give me a hand with something, won't you?"
msgstr "Эй, фамильяр! Да, <i>ты</i>! Подойди-ка, поможешь мне с одним делом?"

#. ja: 新しい創造生物を考えるための参考として、<br>参考用の生物と戦ってくれる者はいないだろうか……？
#. de: Ich brauche jemand, der kämpfen kann. Als Beobachtungsreferenz.
#. fr: Je cherche des volontaires pour m'aider à trouver l'inspiration<nbsp>!
msgctxt "NpcYell:13110:0:13"
msgid "I'm looking for one who might do a bit of sparring against some creations to help spark my creativity. Are there truly none available for such a task?"
msgstr "Ищу кого-нибудь, кто сразился бы с парой моих созданий и помог мне разбудить воображение. Неужели желающих нет?"

#. ja: 誰でもいい、私が創造するエゴーケロスと戦って、<br>その戦いぶりを観察させてくれ……！
#. de: Jemand muss gegen die Aigokeros kämpfen. Sonst kann ich keine Bewertung vornehmen.
#. fr: Il suffit de combattre quelques aigokeros de ma création afin que je puisse les observer<nbsp>!
msgctxt "NpcYell:13111:0:13"
msgid "I just need someone─anyone, really─to engage my aigokeros in combat. I must see how it performs when faced with an attacker."
msgstr "Мне всего-то нужен кто-нибудь — да хоть кто — чтобы сразиться с моим эйгокеросом. Хочу посмотреть, как он покажет себя в бою."

#. ja: 協力に感謝するぞ、使い魔クン……！<br>あともう少しで、何かが閃きそうな気がしてきたぞ……！
#. de: Danke, Familiar. Ich müsste jetzt jeden Augenblick einen Geistesblitz haben ...
#. fr: Merci, familier<nbsp>! Je sens que l'inspiration commence à venir<nbsp>!
msgctxt "NpcYell:13112:0:13"
msgid "Very well done, familiar, and thank you. I can sense great thoughts about to form... Any moment now... "
msgstr "Отлично, фамильяр, спасибо! Кажется, вот-вот меня осенит... Ещё немного..."

#. ja: うーむ、駄目だ、なにひとつ、閃きが得られない……。<br>やり方を変えてみるか……。
#. de: Schade. Der Geistesblitz ist ausgeblieben.
#. fr: Rien à faire, l'inspiration ne vient toujours pas... Serait-ce une question de méthode<nbsp>?
msgctxt "NpcYell:13113:0:13"
msgid "Well, this isn't helping my creativity at all. Time to try a new tack."
msgstr "Нет, так дело не пойдёт. Пора попробовать иначе."

#. ja: 想像力が足りない<br>ということか…
#. de: Fehlt es mir etwas an Fantasie?
#. fr: Je dois manquer d'imagination...
msgctxt "NpcYell:13114:0:13"
msgid "It's as if I lack imagination enough to create anything at all."
msgstr "Неужели мне воображения не хватает создать хоть что-нибудь?"

#. ja: ふむ…<br>なるほど…
#. de: Aha. Das ist es.
#. fr: Hmm... Je vois...
msgctxt "NpcYell:13115:0:13"
msgid "Hmmm, this gives me much to consider."
msgstr "Хм... Есть над чем подумать."

#. ja: ほう、そういうことか…<br>だとしたら…
#. de: Jetzt wird mir einiges klar.
#. fr: Hmm... Intéressant...
msgctxt "NpcYell:13116:0:13"
msgid "Fascinating... Truly fascinating... "
msgstr "Любопытно... Очень любопытно..."

#. ja: ブルルゥ…
#. de: Brrr ...
#. fr: Meuaaarh...
msgctxt "NpcYell:13117:0:13"
msgid "\\<whinny>"
msgstr "<i>Фр-р...</i>"

#. ja: そんな…<br>身体が、動かない…！
#. de: Ich<nbsp>... kann mich nicht mehr bewegen!
#. fr: M-mon corps est comme... tétanisé<nbsp>!
msgctxt "NpcYell:13118:0:13"
msgid "No... I cannot move..."
msgstr "Нет... Не могу пошевелиться..."

#. ja: くそっ…<br>力が…
#. de: Gah<nbsp>... Meine Kräfte verlassen mich<nbsp>...!
#. fr: Misère... Mes forces me quittent...
msgctxt "NpcYell:13119:0:13"
msgid "Ugh... My lance grows heavy..."
msgstr "Тьфу... Копьё стало таким тяжёлым..."

#. ja: ここで倒れるわけには…！
#. de: Nein! Ich werde hier nicht fallen!
#. fr: Ce n'est pas fini<nbsp>!
msgctxt "NpcYell:13120:0:13"
msgid "No! I shall not fall before this beast!"
msgstr "Нет! Я не паду от лап этой твари!"

#. ja: おーい、皆！<br>どうしたんだ？
#. de: Was ist los, Freunde? Warum stoppen wir?
#. fr: Eh bien alors<nbsp>? Que se passe-t-il<nbsp>?
msgctxt "NpcYell:13121:0:13"
msgid "There you all are! ...Hm? What's the matter?"
msgstr "А вот и вы! ...Хм? Что случилось?"

#. ja: 魔物が多くて祈りの場に<br>近寄れないんだ…
#. de: Eine Horde wilder Kreaturen versperrt uns den Weg<nbsp>...
#. fr: Une horde de créatures sauvages nous barre la route...
msgctxt "NpcYell:13122:0:13"
msgid "The sacred site is just yonder, but there are too many fiends..."
msgstr "Святилище уже близко, но чудищ слишком много..."

#. ja: ムリガの神よ<br>道を開きたまえ…！
#. de: O Mrga! Entsendet euren gerechten Zorn, auf dass der Weg frei werde!
#. fr: Ô dieux mrga<nbsp>! Ouvrez-nous le chemin<nbsp>!
msgctxt "NpcYell:13123:0:13"
msgid "O benevolent Mrga, open the way for us!"
msgstr "О, милостивые боги мрга, укажите нам путь!"

#. ja: これも試練か…！
#. de: Eine weitere Prüfung der Mrga?
#. fr: Les dieux nous testent<nbsp>!
msgctxt "NpcYell:13124:0:13"
msgid "This must be a trial... Yes, our faith is being tested."
msgstr "Это испытание... Да, нашу веру проверяют."

#. ja: 我らの信心が<br>試されているな…
#. de: Ich glaube, dies ist ein Test unserer Bußfertigkeit.
#. fr: Notre foi est mise à l'épreuve.
msgctxt "NpcYell:13125:0:13"
msgid "We will persevere. We must!"
msgstr "Мы выстоим. Мы должны!"

#. ja: また助けられたね<br>ありがとう…！
#. de: Du hast uns erneut gerettet, <if $gn4>Wandererin<else>Wanderer</if>!
#. fr: Vous nous avez encore sauvés<nbsp>! Merci beaucoup<nbsp>!
msgctxt "NpcYell:13126:0:13"
msgid "Saved yet again! You have our gratitude!"
msgstr "Вы снова нас спасли! Благодарим вас!"

#. ja: さあ、祈りを捧げよう！<br>ムリガの神よ…！
#. de: Lasst uns nun unser Stoßgebet entsenden!<br>Oh, große Mrga<nbsp>...
#. fr: Allez, prions<nbsp>! Ô dieux mrga...<nbsp>!
msgctxt "NpcYell:13127:0:13"
msgid "Come, let us pray. O mighty Mrga...!"
msgstr "Ну же, помолимся. О могучие боги мрга...!"

#. ja: ふぅ…ここでの祈りは<br>無事に終わったね
#. de: Puh, geschafft. Endlich haben wir unsere heilige Pflicht erfüllt!
#. fr: Bien, notre prière ici est terminée.
msgctxt "NpcYell:13128:0:13"
msgid "There... This leaves just the sea shrine, I believe."
msgstr "Вот и всё... Осталось только морское святилище, верно?"

#. ja: 最後は洋上の祭殿だな…！
#. de: Letzte Station: das Heiligtum an der Küste!
#. fr: Dirigeons-nous maintenant vers le sanctuaire sur la côte<nbsp>!
msgctxt "NpcYell:13129:0:13"
msgid "Indeed. The end is in sight, my friends."
msgstr "Верно. Конец уже близок, друзья мои."

#. ja: いよいよ巡礼も最後だ！<br>心を引き締めよう！
#. de: Das Ende unserer Reise ist gekommen. Stärkt eure Herzen, Freunde!
#. fr: C'est là-bas que prendra fin notre pèlerinage...
msgctxt "NpcYell:13130:0:13"
msgid "Let us stay focused to the last."
msgstr "Надо собраться и пройти до конца."

#. ja: 嗚呼…ここまで来て<br>諦めるしかないのか…
#. de: Niederschmetternd. Jetzt sind wir so weit gereist, nur um kurz vorm Ende umkehren zu müssen<nbsp>...
#. fr: Ha... Nous devons donc nous arrêter ici...
msgctxt "NpcYell:13131:0:13"
msgid "No... We've come too far to fall short like this..."
msgstr "Нет... Мы зашли так далеко, неужели теперь придётся отступить?"

#. ja: イヒ、イヒヒヒ！<br>やるじゃな～い！
#. de: Du hast dich gar nicht schlecht geschlagen! Kihihihi!
#. fr: Hé hé hé, pile-poil ce qu'il me fallait...
msgctxt "NpcYell:13132:0:13"
msgid "Eheheh! Well done, adventurer!"
msgstr "Хе-хе-хе! Отлично, искатель приключений!"

#. ja: このデータで<br>最高傑作を完成させられるぜ
#. de: Mit diesen Daten wird mein nächstes Modell ein Meisterwerk!
#. fr: J'ai relevé assez de données de combat pour parachever mon chef-d'œuvre<nbsp>!
msgctxt "NpcYell:13133:0:13"
msgid "This data will help me truly complete my masterpiece."
msgstr "Эти данные помогут мне довести мой шедевр до совершенства."

#. ja: ま、また何か<br>変な事たくらんでるな！
#. de: Oh nein ... bitte nicht noch einer deiner genialen Pläne ...
#. fr: Oh-oh... Qu'est-ce que tu mijotes, encore<nbsp>!?
msgctxt "NpcYell:13135:0:13"
msgid "Oh, dear... What are you scheming now!?"
msgstr "Ой-ой... Что ты теперь задумал?!"

#. ja: イヒヒ、この暴走マシンを<br>派手にブッ壊してくれよな！
#. de: Kihi! Was ist? Gib den Maschinchen eins drauf!
#. fr: Hé hé hé, réduisez ces tas de ferrailles en pièces détachées<nbsp>!
msgctxt "NpcYell:13136:0:13"
msgid "Don't hold back now: give these robots your all! Eheheh..."
msgstr "Не сдерживайтесь, покажите этим роботам, на что способны! Хе-хе-хе..."

#. ja: イヒ、イヒヒヒ！<br>トンズラさせてもらうぜ～
#. de: Ich mach mich aus dem Staub, kihihi! Und Tschüss!
#. fr: Hé hé hé, c'est l'heure de prendre la poudre d'escampette<nbsp>!
msgctxt "NpcYell:13137:0:13"
msgid "If you'll excuse me, it's time to retreat...eheheh!"
msgstr "Ну, я, пожалуй, отступлю... Хе-хе-хе!"

#. ja: 暴走マシンどもを<br>ブッ壊してくれよな！
#. de: Hau sie weg! Immer drauf, bis die Schaltkreise schmoren!
#. fr: Déglingez-les, démantelez-les, envoyez-les à la casse<nbsp>!
msgctxt "NpcYell:13138:0:13"
msgid "Go on─send these rowdy robots to the scrap heap!"
msgstr "Ну же, отправьте этих буйных роботов на металлолом!"

#. ja: うむ、やはり戦いぶりを観察すると、思索がはかどるな。<br>今度は別の創造生物と戦ってもらいたい。
#. de: Nichts ist so aufschlussreich wie das Verhalten im Kampf.
#. fr: L'observation des créatures en situation de combat est vraiment stimulante<nbsp>! J'aimerais que tu en testes une autre, s'il te plaît.
msgctxt "NpcYell:13139:0:13"
msgid "Nothing ignites the imagination quite like a row. To that end, I shall pit you against an altogether different creature this time."
msgstr "Наблюдать за битвой — лучшее топливо для воображения. На этот раз я выставлю против тебя совсем другое создание."

#. ja: これは最近、創造生物管理局に申請があった種でね。<br>ぜひ戦いぶりを観察させてくれ……！
#. de: Kämpfe gegen dieses Konzept. Es ist gerade bewilligt worden.
#. fr: Il s'agit d'un prototype appelé “io” qui nous est arrivé récemment. Je vais en créer une copie. Montre-moi de quoi il est capable<nbsp>!
msgctxt "NpcYell:13140:0:13"
msgid "In fact, this is a variety I've only just recently registered with the bureau. Now then, show me what you can do!"
msgstr "Я только недавно зарегистрировал этот вид в бюро. Ну же, покажи, на что ты способен!"

#. ja: 閃いた、閃いた、閃いたぞぉぉぉ……！<br>さっそく、この閃きを生物の概念に落とし込まなくては……！
#. de: Eureka! Das ist die Idee, auf die ich gewartet habe!
#. fr: Ça y est<nbsp>! J'ai trouvé l'inspiration<nbsp>! Une idée formidable pour un nouveau concept<nbsp>!
msgctxt "NpcYell:13141:0:13"
msgid "Oh, I am flooded with inspiration. Visions of extraordinary concepts come upon me, the likes of which you would not believe!"
msgstr "О, меня переполняет вдохновение! Передо мной возникают невиданные идеи — тебе и не снилось!"

#. ja: 使い魔クン、協力に感謝する！<br>新しいイデアができたら、ぜひ披露させてくれたまえよ！
#. de: Danke, Familiar. Dir habe ich eine hervorragende Eingebung zu verdanken.
#. fr: Merci pour ton aide, familier<nbsp>! Si tu le veux bien, j'aimerais te montrer le résultat dès qu'il sera prêt<nbsp>!
msgctxt "NpcYell:13142:0:13"
msgid "Thank you, familiar. Your assistance proved most invaluable. How I look forward to the day I can share my new works with you!"
msgstr "Спасибо, фамильяр. Твоя помощь была бесценна. Как же я жду дня, когда смогу показать тебе свои новые творения!"

#. ja: 閃きを忘れない内に<br>イデアを形にしなければ…
#. de: Ich muss sie sofort notieren, bevor ich sie noch vergesse.
#. fr: Bon, il faut vite que j'aille travailler sur cette idée avant que je ne l'oublie...
msgctxt "NpcYell:13143:0:13"
msgid "I must put this to paper before I forget all that I have conjured."
msgstr "Надо скорее записать всё, пока не забыл, что напридумывал."

#. ja: この形が最良だということなのか……？<br>だとしたら、私はいったい何を創れば良いというんだ。
#. de: Ob diese Gestalt dem Planeten am besten dient? Ginge es auch besser?
#. fr: Est-ce à dire que ce concept est déjà des plus efficaces<nbsp>? Ce n'est pas par<shy>ti<shy>cu<shy>liè<shy>rement inspirant...
msgctxt "NpcYell:13144:0:13"
msgid "Is this truly the limits of my imagination? Is there no method for me to improve upon my methods?"
msgstr "Неужели это предел моего воображения? Неужели я не могу найти способ стать лучше?"

#. ja: ああ、閃きが…<br>必要だったのに…
#. de: Hm ... Mir fehlt die richtige Eingebung.
#. fr: Haaa... Et moi qui espérais trouver une idée novatrice...
msgctxt "NpcYell:13145:0:13"
msgid "Alack, I am in desperate need of some inspiration."
msgstr "Ах, мне так отчаянно не хватает вдохновения..."

#. ja: ほうほう…<br>なるほど…
#. de: Ah, ja ...
#. fr: Oh... Je vois, je vois...
msgctxt "NpcYell:13146:0:13"
msgid "Ah, yes. Why of course... "
msgstr "А, да. Конечно же..."

#. ja: そうか…<br>だとすれば…
#. de: Hmhm. Hmhm.
#. fr: D'accord, très intéressant...
msgctxt "NpcYell:13147:0:13"
msgid "Well, a thing like that... "
msgstr "Вот оно как..."

#. ja: グオォォ！
#. de: Groar!
#. fr: Greuaaarh<nbsp>!
msgctxt "NpcYell:13148:0:13"
msgid "Graaaaaah!"
msgstr "Гра-а-а-а!"

#. ja: ガォン！
#. de: Grrr ...
#. fr: Graaah<nbsp>!
msgctxt "NpcYell:13149:0:13"
msgid "Graaaghhh!"
msgstr "Гр-а-а-а!"

#. ja: そん…な…<br>お母さま…私は…
#. de: N-Nein<nbsp>... Mutter<nbsp>... Ich<nbsp>...!
#. fr: Maman... J-je...
msgctxt "NpcYell:13150:0:13"
msgid "M-Mother... I..."
msgstr "М-мама... Я..."

#. ja: ギル…ディヴァン…
#. de: Guil...di...vain<nbsp>...
#. fr: G-Guildivain... Salaud...
msgctxt "NpcYell:13151:0:13"
msgid "Hells take you...Guildivain..."
msgstr "Чтоб тебя... Гильдивен..."

#. ja: イヒヒ、最高傑作よ…！<br>起動するのだ～！
#. de: Endlich! Mein Meisterwerk ist vollkommen! Kehehehe!
#. fr: Vivant<nbsp>! Il est vivaaaant<nbsp>!
msgctxt "NpcYell:13152:0:13"
msgid "Eheheh... Arise, my creation!"
msgstr "Хе-хе-хе... Восстань, моё творение!"

#. ja: キャロット機関起動…<br>出力260％…
#. de: SUPERKAROTTE GESTARTET. ENERGIELEVEL 260 % ...
#. fr: ALLUMAGE DE SUPER-CAROTTE. TAUX DE PUISSANCE<nbsp>: 260 %.
msgctxt "NpcYell:13153:0:13"
msgid "SUPERCARROT ACTIVATED. OUTPUT EXCEEDING 260%..."
msgstr "СУПЕРМОРКОВЬ АКТИВИРОВАНА. МОЩНОСТЬ ПРЕВЫШАЕТ 260%..."

#. ja: パワー、ハ、正義…<br>ミ、ナ、ゴ、ロ、シ！
#. de: VERNICHTUNGSMODUS AKTIVIERT. BENÖTIGE MEHR ... ENERGIE!
#. fr: PUISSANCE... BESOIN DE PLUS DE PUISSAAANCE<nbsp>!
msgctxt "NpcYell:13154:0:13"
msgid "INITIATING EXTERMINATION MODE. WEAKLINGS MUST PERISH!"
msgstr "ЗАПУСК РЕЖИМА УНИЧТОЖЕНИЯ. СЛАБЫЕ ДОЛЖНЫ ПОГИБНУТЬ!"

#. ja: イヒヒヒヒヒヒ！<br>すごいパワーだぜ～！
#. de: Kiiihihi! Ist sie nicht wunderschön?! Mein Schatz! Meine größte Errungenschaft!
#. fr: Hé hé hé hé hé<nbsp>! C'est le bijou de ma carrière<nbsp>!
msgctxt "NpcYell:13155:0:13"
msgid "Eheheh... Such incredible power!"
msgstr "Хе-хе-хе... Вот это мощь!"

#. ja: ま、暴走しちまってるが<br>誰か処分は頼むぜ～！
#. de: Ups, sie reagiert nicht mehr auf Eingaben. Irgendjemand hier, der sie schnell aus<shy>ein<shy>an<shy>der<shy>nimmt?
#. fr: Bon, il ne m'écoute plus, mais quelqu'un d'autre n'a qu'à le démanteler.
msgctxt "NpcYell:13156:0:13"
msgid "And, er, if anyone can help me shut it down, that'd be swell!"
msgstr "И это... Если кто-нибудь поможет мне её выключить, буду очень признателен!"

#. ja: イヒ、イヒヒヒ！<br>誰か手をかしてくれや～！
#. de: Wer räumt hier für mich auf? Freiwillige vor, kihihihi!
#. fr: Hé hé hé<nbsp>! Quelqu'un peut se charger de ce robot à ma place<nbsp>?
msgctxt "NpcYell:13157:0:13"
msgid "Eheheh! Could someone lend me a hand?"
msgstr "Хе-хе-хе! Кто-нибудь мне поможет?"

#. ja: や、やったー！<br>みんな、ありがと～！
#. de: Wir haben sie besiegt! Diesmal endgültig ... hoffentlich.
#. fr: Victoire<nbsp>! La menace est neutralisée... pour de bon, cette fois<nbsp>!
msgctxt "NpcYell:13158:0:13"
msgid "Whew! That was far too close..."
msgstr "Фух! А ведь было близко..."

#. ja: イヒ、イヒヒヒ！<br>これで改善点がわかったぜ
#. de: Kehehe! Jetzt weiß ich, was ich an meinem nächsten Modell verbessern muss.
#. fr: Hé hé hé<nbsp>! J'ai compris où se situait le problème...
msgctxt "NpcYell:13159:0:13"
msgid "Eheheh! This has provided me with invaluable data. "
msgstr "Хе-хе-хе! Я получил бесценные данные."

#. ja: 次は出力300％に<br>挑戦するぜ～
#. de: Kann ja nicht allzu schwer sein, auf 300 % Leistung zu kommen!
#. fr: La prochaine fois, j'éleverai le seuil de puisance à 300 %<nbsp>!
msgctxt "NpcYell:13160:0:13"
msgid "My next order of business is cranking the output up to 300%!"
msgstr "Теперь надо выкрутить мощность на 300%!"

#. ja: コラ～、待て～！<br>少しは反省しろ～！
#. de: Wie meinen?! Du jagst mit deinen Experimenten irgendwann den ganzen Mond hoch!
#. fr: Mais quand retiendras-tu la leçon<nbsp>!?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:13161:0:13"
msgid "Wh-What? That robot nearly killed you and <i>that's</i> your takeaway!?"
msgstr "Ч-что? Этот робот чуть тебя не убил, а ты думаешь <i>об этом</i>?!"

#. ja: イヒ、イヒヒヒ！<br>トンズラさせてもらうぜ～
#. de: Kihihi! Ich bin dann mal weg! Tschüüüss!
#. fr: Hé hé hé, c'est l'heure de prendre la poudre d'escampette<nbsp>!
msgctxt "NpcYell:13162:0:13"
msgid "If you'll excuse me, it's time to retreat...eheheh!"
msgstr "Ну, я, пожалуй, отступлю... Хе-хе-хе!"

#. ja: 暴走マシンを<br>ブッ壊してくれよな！
#. de: Hau sie weg! Immer drauf, bis die Schaltkreise schmoren!
#. fr: Déglingez-le, démantelez-le, envoyez-le à la casse<nbsp>!
msgctxt "NpcYell:13163:0:13"
msgid "Don't be shy─turn my masterpiece into scrap metal!"
msgstr "Не стесняйтесь — превратите мой шедевр в груду металлолома!"

#. ja: パワー、ハ、正義…<br>ミ、ナ、ゴ、ロ、シ！
#. de: SUPERKAROTTE GESTARTET. MAXIMALES ENERGIELEVEL.
#. fr: PUISSANCE... BESOIN DE PLUS DE PUISSAAANCE<nbsp>!
msgctxt "NpcYell:13164:0:13"
msgid "EXTERMINATION MODE ACTIVATED. WEAKLINGS MUST PERISH!"
msgstr "РЕЖИМ УНИЧТОЖЕНИЯ АКТИВИРОВАН. СЛАБЫЕ ДОЛЖНЫ ПОГИБНУТ!"

#. ja: キャロット機関<br>出力最大…出力最大…！
#. de: VERNICHTUNGSMODUS AKTIVIERT. ALLES. ZERSTÖREN!
#. fr: SUPER-CAROTTE, PUISSANCE MAXIMALE... PUISSANCE MAXIMALE...
msgctxt "NpcYell:13165:0:13"
msgid "SUPERCARROT OUTPUT EXCEEDING LIMITS... WARNING!"
msgstr "МОЩНОСТЬ СУПЕРМОРКОВИ ПРЕВЫШАЕТ ПРЕДЕЛ. ВНИМАНИЕ!"

#. ja: 目標の停止を確認！<br>やりましたね…！
#. de: Unser Zielobjekt bewegt sich nicht mehr. Wir haben es geschafft.
#. fr: La cible a été mise hors service. Bien joué<nbsp>!
msgctxt "NpcYell:13166:0:13"
msgid "Looks like we're safe for the time being."
msgstr "Похоже, пока нам ничего не угрожает."

#. ja: ハァ、ハァ…<br>た、助かりました…
#. de: \<keuch> ... \<keuch> ... D-Danke ...
#. fr: M-merci beaucoup...
msgctxt "NpcYell:13167:0:13"
msgid "Phew... Too close for comfort..."
msgstr "Фух... Ещё бы немного..."

#. ja: ご協力に感謝しますよ<br>冒険者の皆さん…！
#. de: Danke für die Hilfe, Abenteurer<if $gn4>in</if>.
#. fr: Nous vous devons une fière chandelle<nbsp>!
msgctxt "NpcYell:13168:0:13"
msgid "Many thanks for your timely assistance!"
msgstr "Благодарю вас за помощь! Вы как раз вовремя!"

#. ja: エブレルノさん…<br>何か収穫は？
#. de: Hast du etwas gefunden, Ebrelnaux?
#. fr: Dites, Ebrelnaux, avez-vous trouvé quelque chose<nbsp>?
msgctxt "NpcYell:13169:0:13"
msgid "Did you find anything?"
msgstr "Тебе удалось что-нибудь найти?"

#. ja: やはり私が亡命前に<br>研究させられていた技術が…
#. de: Es handelt sich um die Technologie, die man mich vor meiner Flucht zwang, zu entwickeln.
#. fr: Disons que je viens de découvrir que la technologie qu'on m'a forcé à développer...
msgctxt "NpcYell:13170:0:13"
msgid "Aye. The methods I'd researched prior to my defection..."
msgstr "Да. Технологии, которые меня заставляли разрабатывать до моего побега..."

#. ja: この機体にも<br>実装されていたようです
#. de: Sie wurde auch in dieser Maschine verbaut.
#. fr: ... a été utilisée pour fabriquer des machines comme celle-ci...
msgctxt "NpcYell:13171:0:13"
msgid "...were used in this magitek."
msgstr "...использовали в этом магитехе."

#. ja: やはり…<br>次はどうしますか？
#. de: Tja. Was machen wir jetzt?
#. fr: Je vois. Et ensuite, que fait-on<nbsp>?
msgctxt "NpcYell:13172:0:13"
msgid "Then it's true... So, where to next?"
msgstr "Значит, это правда... И куда теперь?"

#. ja: かつて私が所属していた<br>研究所に行ってみましょう
#. de: Wir gehen in das Labor, in dem ich arbeiten musste.
#. fr: Nous devrions aller au laboratoire où je travaillais autrefois.
msgctxt "NpcYell:13173:0:13"
msgid "Let's search the facility at which I was stationed."
msgstr "Давайте обыщем лабораторию, где я служил."

#. ja: そこに研究資料が<br>残っているはずですから…
#. de: Dort sind bestimmt noch wichtige Dokumente zu finden.
#. fr: On devrait y trouver des documents d'époque.
msgctxt "NpcYell:13174:0:13"
msgid "We may be able to glean vital information there."
msgstr "Там могут найтись важные сведения."

#. ja: 了解であります！
#. de: Verstanden!
#. fr: Entendu<nbsp>!
msgctxt "NpcYell:13175:0:13"
msgid "Very well. I'll follow your lead."
msgstr "Понял! Буду за вами!"

#. ja: 黄金蝶…<br>消してくれるんだね…
#. de: Goldener Schmetterling. Lass alles vergehen ...
#. fr: Papillons d'or... Effacez cet individu de l'existence...
msgctxt "NpcYell:13176:0:13"
msgid "Beautiful creatures...the time has come."
msgstr "Прекрасные создания... Пора."

#. ja: その鱗粉で<br>終わりを飾ろう…
#. de: Lass deinen Flügelstaub niedergehen und das Ende vergolden ...
#. fr: Cette magnifique poussière d'écailles marquera la fin de l'Harmonie...
msgctxt "NpcYell:13177:0:13"
msgid "Death's sweet release."
msgstr "Сладкое избавление от смерти."

#. ja: おや、私は黄金蝶に<br>消されるのだね…
#. de: Sieh, der goldene Schmetterling bringt mein Ende ...
#. fr: Ce sont donc les papillons d'or qui sont venus chercher cet individu...
msgctxt "NpcYell:13178:0:13"
msgid "Death delivered on golden wings..."
msgstr "Значит, смерть придёт ко мне на золотых крыльях..."

#. ja: これで無意味な生を<br>捨てられるのか…
#. de: So endet endlich meine sinnlose Existenz.
#. fr: Cet individu va-t-il enfin pouvoir faire ses adieux à sa vie vide de sens<nbsp>?
msgctxt "NpcYell:13179:0:13"
msgid "Ah, finally we are free."
msgstr "Наконец-то мы свободны."

#. ja: まだ生き残りがいたか！
#. de: Dort lebt noch einer!
#. fr: Là<nbsp>! Il en reste<nbsp>!
msgctxt "NpcYell:13180:0:13"
msgid "How did they get here!?"
msgstr "Как они сюда пробрались?!"

#. ja: 命令はせん滅だ！<br>ひとりも生きて帰すな！
#. de: Alles Leben muss ausgelöscht werden! Keiner darf entkommen!
#. fr: On a nos ordres<nbsp>! Ils doivent tous y passer jusqu'au dernier<nbsp>!
msgctxt "NpcYell:13181:0:13"
msgid "Remember your orders! No survivors!"
msgstr "Не забывайте приказ! Никого не оставить в живых!"

#. ja: こんなところに<br>残党がいたとはな…！
#. de: Räuchert sie aus! Bombt sie nieder!
#. fr: Comment ils ont survécu aux bombardements<nbsp>!?
msgctxt "NpcYell:13182:0:13"
msgid "Global Community scum!"
msgstr "Грязь из Глобального сообщества!"

#. ja: 喰らえッ！
#. de: Feuer frei!
#. fr: Bouffez ça, salauds<nbsp>!
msgctxt "NpcYell:13183:0:13"
msgid "Fire! Fire!"
msgstr "Огонь! Огонь!"

#. ja: 死ね！
#. de: Stirb!
#. fr: Crève<nbsp>!
msgctxt "NpcYell:13184:0:13"
msgid "We have them now!"
msgstr "Ну всё, вам конец!"

#. ja: 攻撃するッ！
#. de: Aaangriff!
#. fr: J'attaque<nbsp>!
msgctxt "NpcYell:13185:0:13"
msgid "For freedom!"
msgstr "За свободу!"

#. ja: 行け、行け、行け！
#. de: Tötet sie alle!
#. fr: Allez, allez, allez<nbsp>!
msgctxt "NpcYell:13186:0:13"
msgid "Keep it up!"
msgstr "Так держать!"

#. ja: こんな、ところ…で…
#. de: Ich darf hier<nbsp>... nicht<nbsp>...
#. fr: Non... Pas... comme ça...
msgctxt "NpcYell:13187:0:13"
msgid "No... Not yet..."
msgstr "Нет... Ещё не..."

#. ja: 大丈夫かなぁ…
#. de: Ich hab kein gutes Gefühl bei der Sache ...
#. fr: J'ai un mauvais pres<shy>sen<shy>ti<shy>ment...
msgctxt "NpcYell:13188:0:13"
msgid "Oh, d-d-dear..."
msgstr "Ой-ой..."

#. ja: 負ける…わけには…
#. de: N-Nein<nbsp>... Niemals<nbsp>...
#. fr: On ne peut pas perdre... Pas... Encore...
msgctxt "NpcYell:13189:0:13"
msgid "We can't lose..."
msgstr "Мы не можем проиграть..."

#. ja: 了解！<br>覚悟しろ！
#. de: Verstanden! Und los!
#. fr: D'accord<nbsp>! Ça va barder<nbsp>!
msgctxt "NpcYell:13190:0:13"
msgid "Understood! Stand back!"
msgstr "Понял! Назад!"

#. ja: 魔物がいない…<br>これは…？
#. de: Hier sind gar keine Tiere<nbsp>... Hm?
#. fr: Pas de monstrrres ici... Mais ça... qu'est-ce donc<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13191:0:13"
msgid "No fiends here...<br>But what might this be?"
msgstr "Здесь нет чудищ...<br>Но что это может быть?"

#. ja: お～い！<br>使い魔クン、こっちだ！
#. de: He, Familiar! Komm mal her.
#. fr: Familier<nbsp>! Par ici<nbsp>!
msgctxt "NpcYell:13192:0:13"
msgid "Oh, familiar! Over here!"
msgstr "Фамильяр! Сюда!"

#. ja: それでは、私が考案した新作の創造生物を披露しよう！<br>ぜひ全力で戦ってみてくれたまえ！
#. de: Ich zeig dir mal meine neueste Schöpfung. Und du kämpfst dann mit ihr.
#. fr: Tu vas voir, c'est un véritable concentré d'idées innovantes<nbsp>! Tu as intérêt à donner le meilleur de toi-même<nbsp>!
msgctxt "NpcYell:13193:0:13"
msgid "Prepare to be awed by my masterpiece! But not too awed, mind you. You'll need your wits about you for this fight, I should think."
msgstr "Приготовься восхититься моим шедевром! Только не слишком — в бою тебе ещё пригодится ясная голова."

#. ja: これまで観察してきた生物たちの戦いぶりから、<br>導き出した、私の答えは……これだッ！
#. de: Ich habe darin alles verarbeitet, was ich durch meine Beobachtung von Kämpfen gelernt habe.
#. fr: Voici le fruit de mon imagination stimulée par l'observation des créatures que tu as combattues pour moi<nbsp>!
msgctxt "NpcYell:13194:0:13"
msgid "Long have I observed the creatures of this world, how they kill and maim, and at last, my studies bear fruit. Behold the product of my research!"
msgstr "Я давно наблюдаю за созданиями этого мира — за тем, как они убивают и калечат. И наконец мои исследования дали плоды. Взгляни на результат!"

#. ja: あ、あれ……私が考案したイデアでは、<br>もっと違う姿だったような……と、とにかく倒してくれ！
#. de: Nanu? Ich hatte das Konzept etwas anders in Erinnerung. Egal, besiege das Ding!
#. fr: Euh... Étrange, ce n'est pas ce que je pensais... Mais peu importe<nbsp>! Affronte-les<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:13195:0:13"
msgid "O-Oh... This is not <i>quite</i> how I envisioned my concept. It was a great deal different on paper... At any rate─ Attack!"
msgstr "О-ох... Это не <i>совсем</i> то, что я задумал. На бумаге всё выглядело совсем иначе... Ну, неважно — Атака!"

#. ja: す、少しばかり気合を入れすぎて、雑念が入ってしまったようだ。<br>もう一回、チャンスをくれたまえ……！
#. de: Ich werde noch einen weiteren Versuch brauchen.
#. fr: J'en ai assez vu. Pardon pour cette erreur, l'excitation a dû troubler mon esprit. La prochaine sera la bonne<nbsp>!
msgctxt "NpcYell:13196:0:13"
msgid "In my profession, that is what we call an abject failure. Perhaps I let my fancy carry me too far in the design phase... I will have to try, try again!"
msgstr "В нашей профессии это называется полным провалом. Кажется, на этапе разработки я слишком увлёкся фантазиями... Придётся пробовать снова и снова!"

#. ja: くぅ……私が考案したイデアは、もっと違う物だったはずなんだ。<br>なぜ、こんな正体不明な物が生まれてしまったんだ……！
#. de: Dieses Leben hat sich anders entwickelt, als ich es konzipiert hatte. Wie konnte das geschehen?
#. fr: Ce n'est pas du tout ce que j'avais en tête. Comment une créature aussi étrange a pu surgir de mon esprit<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:13197:0:13"
msgid "Well, this is all wrong. All wrong, indeed! How in goodness gracious did I come up with...<i>this</i>?"
msgstr "Нет, всё не так. Совсем не так! Как же я додумался до <i>этого</i>?"

#. ja: 違う…そうじゃない…<br>ブツブツブツ…
#. de: Nein! Doch nicht so!
#. fr: Hmm... Il faut que j'apprenne à mieux me concentrer...
msgctxt "NpcYell:13198:0:13"
msgid "No, no, no. This is bad, so very bad... "
msgstr "Нет, нет, нет. Всё плохо... Очень плохо..."

#. ja: な、なぜ…<br>こんな姿に…！？
#. de: Warum ist es nur so geworden?
#. fr: Qu'est-ce qui a bien pu se passer<nbsp>?
msgctxt "NpcYell:13199:0:13"
msgid "Wh-What is it? H-How did it end up like that?"
msgstr "Ч-что это? К-как оно стало таким?"

#. ja: なにが失敗だったんだ…<br>違うんだ…！
#. de: Ich muss einen Fehler gemacht haben.
#. fr: Je me demande comment j'ai fait pour créer ça<nbsp>!
msgctxt "NpcYell:13200:0:13"
msgid "Where could I have gone so horribly wrong?"
msgstr "Где же я так ужасно ошибся?"

#. ja: お前の思い通りにはさせない！
#. de: Denke nicht, du hättest leichtes Spiel mit uns!
#. fr: On ne te laissera pas faire<nbsp>!
msgctxt "NpcYell:13201:0:13"
msgid "We won't let you get away this time!"
msgstr "На этот раз мы тебе не дадим уйти!"

#. ja: ふざけやがって…！
#. de: Verdammt!
#. fr: Tu vas payer, sale monstre<nbsp>!
msgctxt "NpcYell:13202:0:13"
msgid "Damn you!"
msgstr "Будь ты проклят!"

#. ja: よし、最後の巡礼地だ<br>祈りを捧げよう…！
#. de: Wir sind an der letzten Station unserer Pilgerreise angelangt, Freunde. Beten wir!
#. fr: Voilà, nous y sommes<nbsp>! Prions, mes frères<nbsp>!
msgctxt "NpcYell:13203:0:13"
msgid "This is it─the last stop on our pilgrimage. Come, let us pray!"
msgstr "Вот и последняя остановка нашего паломничества. Давайте помолимся!"

#. ja: ふぅ…これで我らの願いは<br>ムリガの神に伝わったはず…！
#. de: Ich hoffe, die Mrga haben unsere Gebete erhört!
#. fr: J'espère que les dieux ont entendu nos prières<nbsp>!
msgctxt "NpcYell:13204:0:13"
msgid "Whew... As much devotion as we've shown, the Mrga have surely heard us."
msgstr "Фух... Мы молились так усердно, что боги мрига наверняка нас услышали."

#. ja: ナルネア島の方から<br>何かが来るぞ…！
#. de: Irgendetwas nähert sich uns von der Insel Narunnair ...
#. fr: Quelque chose approche de Narunnair...
msgctxt "NpcYell:13205:0:13"
msgid "Look! Something's coming from Narunnair!"
msgstr "Смотрите! Что-то идёт со стороны Наруннаира!"

#. ja: 化け物だ～！
#. de: Ein Ungeheuer!
#. fr: Un monstre<nbsp>!
msgctxt "NpcYell:13206:0:13"
msgid "Uwaaah! It's a monster!"
msgstr "А-а-а! Чудище!"

#. ja: ひぃ、こ、これは<br>ムリガの神じゃない！
#. de: Da-Das ist kein Mrga!
#. fr: Ce... ce ne sont pas nos dieux<nbsp>!
msgctxt "NpcYell:13207:0:13"
msgid "Th-This isn't our god!"
msgstr "Э-это не наш бог!"

#. ja: 逃げろぉぉぉ！
#. de: Flieht!
#. fr: Fuyooons<nbsp>!
msgctxt "NpcYell:13208:0:13"
msgid "Run for your lives!"
msgstr "Спасайся кто может!"

#. ja: あ、あの化け物を<br>退治してくれたのか？
#. de: Unglaublich, du hast den Dämon besiegt!
#. fr: Vous... vous avez réussi à tuer cette créature<nbsp>!?
msgctxt "NpcYell:13209:0:13"
msgid "Th-They vanquished that monster?"
msgstr "Н-неужели они одолели это чудовище?"

#. ja: まさに英雄…<br>人はかくも強くなれるのか！
#. de: Bei den Göttern, dass es Sterbliche gibt, die solche Stärke erlangen!
#. fr: Vous êtes un<if $gn4>e</if> véritable héro<if $gn4>ïne<else>s</if><nbsp>!
msgctxt "NpcYell:13210:0:13"
msgid "To think that mortals could be so strong..."
msgstr "Подумать только, смертные могут быть такими сильными..."

#. ja: そうか、これが経典に<br>記された自灯明か…！
#. de: Das muss die Erleuchtung sein, von der in unseren Schriften geschrieben steht!
#. fr: C'est sûrement vous la lumière dont parlent nos écrits<nbsp>!
msgctxt "NpcYell:13211:0:13"
msgid "Could this be what the scriptures mean about being one's own light?"
msgstr "Неужели именно об этом говорится в священных писаниях, когда нас учат быть светом самим себе?"

#. ja: 神を灯りとせず<br>己を灯りとして進む…！
#. de: Nicht die Götter sollten wir bemühen, nein es ist an uns selbst, voranzuschreiten!
#. fr: Nous ne devons pas uniquement compter sur les dieux, mais aussi sur nous-mêmes<nbsp>!
msgctxt "NpcYell:13212:0:13"
msgid "Relying not upon gods, but yourself to guide you..."
msgstr "Не полагаться на богов, а идти вперёд, освещая себе путь..."

#. ja: そうだな…<br>大切なのは己の意思…！
#. de: Ja, das ist eine wichtige Erkenntnis, mein Freund.
#. fr: Oui, notre propre volonté est importante aussi<nbsp>!
msgctxt "NpcYell:13213:0:13"
msgid "Yes... Yes, that's it. What's important is our own will and determination."
msgstr "Да... Именно. Главное — наша собственная воля и решимость."

#. ja: 神頼みではなく<br>人の力で苦境を打破しよう！
#. de: Anstatt uns auf den Schutz der Mrga zu verlassen, sollten wir uns selbst ertüchtigen, um der Not zu trotzen!
#. fr: Au lieu de compter sur la protection des dieux mrga, nous devons nous donner les moyens de défier l'adversité<nbsp>!
msgctxt "NpcYell:13214:0:13"
msgid "So in the face of hardship, we should look not to the divine, but the strength within..."
msgstr "Значит, перед лицом трудностей надо искать силы не у богов, а в себе..."

#. ja: そのとおりだ！<br>皆、己の灯りで歩むぞ！
#. de: So ist es! Freunde, beschreiten wir gemeinsam diesen neuen Pfad der Selbstertüchtigung!
#. fr: Tu as raison<nbsp>!
msgctxt "NpcYell:13215:0:13"
msgid "Precisely. If we are agreed, then let us walk this path together!"
msgstr "Именно! Раз мы все согласны, пойдём же этим путём вместе!"

#. ja: おぅ！
#. de: Hurra!
#. fr: C'est vrai<nbsp>!
msgctxt "NpcYell:13216:0:13"
msgid "Hear, hear!"
msgstr "Вот именно!"

#. ja: ありがとう、皆さん！<br>それではお達者で…！
#. de: Danke, Freunde. Dann lasst uns unser Werk tun!
#. fr: Merci, tout le monde<nbsp>!
msgctxt "NpcYell:13217:0:13"
msgid "It's been a pleasure, my friends. Till next time, may all continue to strive for enlightenment!  "
msgstr "Рад был провести с вами время, друзья. До новых встреч! И пусть каждый из нас продолжает стремиться к просветлению!"

#. ja: 無事に到着できたみたいだね！<br>みなさん、守ってくれてありがとう！
#. de: Wir haben es geschafft, Nano ist im Meer! Danke, dass du ihn beschützt hast!
#. fr: Il a réussi, génial<nbsp>! Merci beaucoup pour votre aide<nbsp>!
msgctxt "NpcYell:13218:0:13"
msgid "My wee little nanka has returned to the sea! Oh, it brings a tear to the eye! Thank you, my friends!"
msgstr "Мой крошка нанка вернулся в море! Аж слёзы наворачиваются! Спасибо вам, друзья!"

#. ja: だ、駄目か……。<br>ナンカ、ひとまず家に引き返そう……！
#. de: Oha, das war wohl nichts. Komm, Nano, wir gehen lieber schnell  nach Hause!
#. fr: Oh non, pauvre petit nanka... Tu as été bien courageux mais faisons demi-tour pour le moment...
msgctxt "NpcYell:13219:0:13"
msgid "Oh, dear...this isn't good. Come, my little one─we'd best head home."
msgstr "Ох... Дело плохо. Пойдём, малыш, лучше вернёмся домой."

#. ja: 大丈夫、大丈夫…
#. de: Keine Angst. Es wird alles gut!
#. fr: Tout va bien...
msgctxt "NpcYell:13220:0:13"
msgid "Don't worry, we'll get out of this."
msgstr "Не волнуйся, мы выберемся отсюда."

#. ja: おにいちゃん…<br>こわい…
#. de: Brüderchen, ich hab ja solche Angst!
#. fr: J'ai peur...
msgctxt "NpcYell:13221:0:13"
msgid "B-Brother, I'm scared!"
msgstr "Б-братик, мне страшно!"

#. ja: まさか毒蛇の巣だなんて…
#. de: Oh, Schreck! Ein Nest voller Giftschlangen!
#. fr: Un nid de serpents venimeux... Quelle guigne<nbsp>!
msgctxt "NpcYell:13222:0:13"
msgid "Bhujamga... Why did it have to be bhujamga?"
msgstr "Бхуджамга... Ну почему именно бхуджамга?"

#. ja: ありがとう…！
#. de: Danke für deine Hilfe!
#. fr: Merci beaucoup<nbsp>!
msgctxt "NpcYell:13223:0:13"
msgid "Thanks for saving us!"
msgstr "Спасибо, что спасли нас!"

#. ja: おうちにかえれる…！
#. de: Wir gehen jetzt besser wieder nach Hause.
#. fr: Je vais pouvoir rentrer à la maison<nbsp>!
msgctxt "NpcYell:13224:0:13"
msgid "Now we can go home!"
msgstr "Теперь мы можем вернуться домой!"

#. ja: 気づかれませんように…
#. de: Flink und leise wie kleine Mäuschen ...
#. fr: Soyons discrets...
msgctxt "NpcYell:13225:0:13"
msgid "Q-Quietly now..."
msgstr "Т-только потише..."

#. ja: こっちだ…<br>今のうちに…！
#. de: Hier lang. Das ist unsere Chance!
#. fr: Par ici<nbsp>! Maintenant<nbsp>!
msgctxt "NpcYell:13226:0:13"
msgid "N-Now's our chance! This way!"
msgstr "С-сейчас наш шанс! Сюда!"

#. ja: あの群れは<br>人食いだって噂の…！
#. de: Dieses Rudel soll schon die Bewohner eines anderen Dorfes gerissen haben!
#. fr: Oh non<nbsp>! Ce sont les tigres mangeurs d'hommes<nbsp>!
msgctxt "NpcYell:13227:0:13"
msgid "Manusya have mercy, it's the man-eaters!"
msgstr "Манушья, спаси нас! Это же людоеды!"

#. ja: 今にも襲ってきそうだわ…
#. de: Götter steht uns bei, sie fletschen hungrig ihre Reißzähne!
#. fr: Ils ont l'air affamés...
msgctxt "NpcYell:13228:0:13"
msgid "They could attack at any moment... What are we going to do!?"
msgstr "Они вот-вот нападут... Что же нам делать?!"

#. ja: やった人食いトラたちが<br>退散していくぞ！
#. de: Wir sind gerettet! Die Guhasaya sind vertrieben!
#. fr: Ils s'en vont<nbsp>! On a réussi<nbsp>!
msgctxt "NpcYell:13229:0:13"
msgid "They've turned tail! Huzzah!"
msgstr "Они дали дёру! Ура!"

#. ja: これで安心して眠れるわ<br>ありがとう！
#. de: Endlich kann ich wieder in Ruhe schlafen!
#. fr: Je vais pouvoir dormir tranquille ce soir<nbsp>! Merci<nbsp>!
msgctxt "NpcYell:13230:0:13"
msgid "Now we can rest easy! Thank you!"
msgstr "Теперь можно спать спокойно. Спасибо!"

#. ja: ひぃ…<br>誰か、助けを…！
#. de: Hi-Hilfe! Zu Hilfe!!
#. fr: Aaah<nbsp>! À l'aide<nbsp>!!!
msgctxt "NpcYell:13231:0:13"
msgid "Uwaaah! They're coming!"
msgstr "А-а-а! Они идут!"

#. ja: 里の連中に<br>警告しなければ！
#. de: Wir müssen die Leute im Dorf warnen!
#. fr: Il faut prévenir le village<nbsp>!
msgctxt "NpcYell:13232:0:13"
msgid "We must warn everyone!"
msgstr "Надо предупредить всех!"

#. ja: 魔猿たちを追い払ってくださり、本当にありがとうございます！<br>これで安全に薬草を探せます……！
#. de: Danke, dass du diese widerlichen Affen vertrieben hast, <if $gn4>große Heldin<else>großer Held</if>! Jetzt kann ich meinem Vater seine Medizin bringen.
#. fr: Merci beaucoup de m'avoir débarrassée de ces singes<nbsp>! Je vais pouvoir cueillir mes herbes médicinales tran<shy>quil<shy>le<shy>ment, grâce à vous<nbsp>!
msgctxt "NpcYell:13233:0:13"
msgid "Thank you for ridding me of those langurs! Now I can gather the herbs without fear."
msgstr "Спасибо, что прогнали лангуров! Теперь я смогу спокойно собрать травы."

#. ja: こ、これでは無理そうですね。<br>どこか他の場所で、薬草を探さないと……。
#. de: Diese schrecklichen Affen! Dann muss ich woanders Heilkräuter suchen!
#. fr: Je crois que je ferais mieux d'aller cueillir mes herbes ailleurs...
msgctxt "NpcYell:13234:0:13"
msgid "Oh dear... Perhaps I should look for the herbs elsewhere..."
msgstr "Ох... Пожалуй, поищу травы где-нибудь в другом месте..."

#. ja: また大技が来るか…！
#. de: Vorsicht, da bahnt sich was an!
#. fr: Encore un sale coup...<nbsp>!
msgctxt "NpcYell:13235:0:13"
msgid "Steel yourself!"
msgstr "Приготовься!"

#. ja: さぁ…<br>ここから反撃です！
#. de: Wir gehen zum Gegenangriff über!
#. fr: Allez... c'est le moment de renverser le combat<nbsp>!
msgctxt "NpcYell:13237:0:13"
msgid "Now we press the attack!"
msgstr "А теперь пора перейти в наступление!"

#. ja: ふぅ……気を落ち着けて、イメージするのだ……。<br>猛々しき角、彫像の如き肉体、魔力秘めたる眼を……！
#. de: Wilde Hörner, akzentuierte Muskeln, ein glühendes Auge ...
#. fr: Bon, concentrons-nous sur l'image mentale... Les cornes redoutables, les muscles saillants, l'œil empreint de magie...
msgctxt "NpcYell:13238:0:13"
msgid "Calm yourself. Focus, and picture it clearly in your mind's eye... Hellacious horns, rippling thew, a fearsome eye!"
msgstr "Фух... Успокойся, сосредоточься и представь всё как следует... Ужасные рога, могучее тело, глаз, полный магии!"

#. ja: これぞ私の真なる新作、オリジナル・クリュプスだ！<br>いかなる力を秘めているのか、存分に戦ってみてくれ！
#. de: Ja, das ist er, mein Ur-Kyklops! Teste seine Stärke und kämpfe gegen ihn!
#. fr: Voilà<nbsp>! C'est <i>ce concept</i> que j'avais en tête<nbsp>: Kyklops<nbsp>! Affronte ce prototype, que je voie son potentiel<nbsp>!
msgctxt "NpcYell:13239:0:13"
msgid "Behold, my greatest concept yet: the kyklops! Now, draw your weapon and succumb to a strength beyond measure!"
msgstr "Полюбуйтесь на моё величайшее творение — киклопа! А теперь хватайте оружие и сразитесь с ним, чтобы испытать его невероятную силу!"

#. ja: いやはや、私の新作を倒してしまうとは……<br>なかなかどうして、君も素晴らしい使い魔だな！
#. de: Du hast meine neue Schöpfung besiegt? Du bist wirklich außer<shy>ge<shy>wöhn<shy>lich!
#. fr: Pour être honnête, je ne pensais pas que tu le vaincrais<nbsp>! Quel familier remarquable<nbsp>!
msgctxt "NpcYell:13240:0:13"
msgid "Why...you defeated it! Goodness me, what an incredible familiar you are."
msgstr "Что... вы его победили! Вот это да, какой же вы необыкновенный фамильяр!"

#. ja: だが、おかげで改善点は見えてきたぞ！<br>アニドラス・アナムネーシスに戻って、最終調整をしよう……！
#. de: Ich werde sofort ins Anamnesis Anyder zurückkehren und meine Beobachtungen auswerten und verarbeiten.
#. fr: Merci<nbsp>! Grâce à toi, j'ai pu repérer ses points faibles. Je vais retourner à l'Anamnesis Anydre pour lui apporter quelques mo<shy>di<shy>fi<shy>ca<shy>tions<nbsp>!
msgctxt "NpcYell:13241:0:13"
msgid "But rest assured, I have witnessed all most carefully, and see clearly what must be done to fix my creation. I shall return to Anamnesis Anyder and perform the final touches."
msgstr "Но не сомневайтесь: я внимательно за всем наблюдал и теперь точно знаю, что нужно исправить. Вернусь в Анамнезис Анидера и завершу работу над творением."

#. ja: うむ、実に有意義な<br>思索であったな…
#. de: Hm, ich habe schon eine Idee ...
#. fr: Cette série de tests était vraiment très en<shy>ri<shy>chis<shy>san<shy>te...
msgctxt "NpcYell:13242:0:13"
msgid "A very enlightening show that was, I must say."
msgstr "Вот это было поучительное зрелище, должен сказать."

#. ja: ほう……私の新作が勝利してしまうとはな……！<br>つまり、これで完成と考えて、良いということだろうか？
#. de: Meine Schöpfung hat gesiegt! Sollte ich etwa am Ende meiner Suche sein?
#. fr: La victoire revient à mon nouveau concept<nbsp>! Dois-je en conclure qu'il n'y a plus rien à y ajouter<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:13243:0:13"
msgid "I cannot rightly believe it. My creation─ It's won! Then perhaps this truly is the latest <i>and</i> greatest creature."
msgstr "Не могу поверить. Моё творение... победило! Выходит, теперь это и впрямь самое <i>новое</i> и совершенное существо?"

#. ja: しかし、まだ改善点が<br>あると思ったのだが…
#. de: Nein, es gibt immer noch etwas zu verbessern.
#. fr: Non, je pense que je peux encore l'améliorer...
msgctxt "NpcYell:13244:0:13"
msgid "Though there is still much yet to be fine-tuned."
msgstr "Хотя ещё многое предстоит доработать."

#. ja: いけ、クリュプス！<br>そうだ、そうだ！
#. de: So ist es gut, Kyklops!
#. fr: Vas-y, Kyklops<nbsp>! Plus fort<nbsp>!
msgctxt "NpcYell:13245:0:13"
msgid "That's the spirit!"
msgstr "Вот так, киклоп! Именно!"

#. ja: がんばれ、クリュプス！<br>根性を見せろ！
#. de: Los, Kyklops! Zeig deine ganze Kraft!
#. fr: Allez, Kyklops<nbsp>! Fais voir ce que t'as dans le ventre<nbsp>!
msgctxt "NpcYell:13246:0:13"
msgid "I believe in you, kyklops! You can do this."
msgstr "Я верю в тебя, киклоп! Ты справишься!"

#. ja: しまった！<br>蜘蛛が入った箱が…！
#. de: Oh nein! Wie konnten die Spinnen entwischen?!
#. fr: Oh non<nbsp>! Qui a laissé les araignées s'échapper<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13247:0:13"
msgid "Oh no, the crates...<br>OH NO, THE SPIDERS!"
msgstr "О нет, ящики...<br>О НЕТ, ПАУКИ!"

#. ja: ひえぇぇ…！<br>誰か手伝ってくれ…！
#. de: Hiiilfe!
#. fr: À l'aiiiide<nbsp>! Je suis arachnophobe<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13248:0:13"
msgid "Do I have one in my hair!?<br>Please, someone help!"
msgstr "У меня что-то в волосах!?<br>Помогите кто-нибудь!"

#. ja: 助かったあ…！
#. de: Danke, du hast uns gerettet!
#. fr: Mille mercis<nbsp>! Vous valez tous les pesticides du monde<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13249:0:13"
msgid "The nightmare is over...<br>Thank you!"
msgstr "Кошмар закончился...<br>Спасибо!"

#. ja: ひ、人を呼んでくる…！
#. de: Ich hole Verstärkung!
#. fr: J-je file chercher des renforts<nbsp>!
msgctxt "NpcYell:13250:0:13"
msgid "M-Maybe we can round them up with lizards...or scorpions!"
msgstr "М-может, удастся загнать их в кучу ящерицами... или скорпионами!"

#. ja: なんて愛らしさだ！
#. de: Oh, was für eine schöne Pflanze!
#. fr: Oh, quelles plantes ravissantes<nbsp>!
msgctxt "NpcYell:13251:0:13"
msgid "My, how adorable!"
msgstr "Ой, какие прелестные!"

#. ja: 植物かと思ったら…
#. de: Huch, das ist ja gar keine Pflanze!
#. fr: Euh... Tu es sûr que ce sont des plantes<nbsp>?
msgctxt "NpcYell:13252:0:13"
msgid "I thought those plants looked unfamiliar..."
msgstr "Я-то думал, это незнакомые растения..."

#. ja: 見た目より怖かった…
#. de: Man sollte nie dem Anschein trauen.
#. fr: Voilà pourquoi il ne faut jamais se fier aux apparences...
msgctxt "NpcYell:13253:0:13"
msgid "And they looked so cuddly..."
msgstr "А на вид такие милые..."

#. ja: 観察どころじゃないわね
#. de: Das hätte dir früher einfallen sollen.
#. fr: C'est un peu tard pour dire ça<nbsp>!
msgctxt "NpcYell:13254:0:13"
msgid "Hm. No more botanical studies today."
msgstr "Хм. На сегодня с изучением растений хватит."

#. ja: まさかエーテルが結晶化して<br>こんな姿になるなんて…！
#. de: Ich wusste nicht, dass Äther auf diese Weise kristallisieren kann.
#. fr: J'ignorais que l'éther pouvait se cristalliser de cette façon-là...
msgctxt "NpcYell:13255:0:13"
msgid "I've never seen anything like this!"
msgstr "Никогда такого не видел!"

#. ja: はやく解体しないと<br>管理局にどやされるぞ…
#. de: Ein Jammer, dass wir den Äther wieder freisetzen müssen.
#. fr: Je dois vite trouver une solution avant de me faire remonter les bretelles<nbsp>!
msgctxt "NpcYell:13256:0:13"
msgid "And I'd rather my superiors not see it at all, if you catch my drift..."
msgstr "И начальству я бы предпочёл этого не показывать, если вы понимаете, о чём я..."

#. ja: やれやれ、無事に解体できたな<br>協力に感謝する！
#. de: Vielen Dank für deine Hilfe!
#. fr: Ouf, l'éther s'est enfin dispersé... Merci de votre aide<nbsp>!
msgctxt "NpcYell:13257:0:13"
msgid "Thank you! I'll just...sweep these chunks away."
msgstr "Спасибо! Я... просто подмету эти куски."

#. ja: こりゃあ、始末書じゃ<br>済まんかな…
#. de: Damit kann ich den Lagebericht abschließen<nbsp>...
#. fr: Je suis bon pour aller rédiger des lettres d'excuse...
msgctxt "NpcYell:13258:0:13"
msgid "\\<sigh> I'd better start writing the incident report..."
msgstr "<i>Эх...</i> Пора писать отчёт о происшествии..."

#. ja: では、私は研究に戻ろうと思う。<br>重ねて協力に感謝するぞ……それではまたな！
#. de: Ich werde mich nun wieder meiner Forschung widmen. Alles Gute!
#. fr: Mille mercis<nbsp>! Grâce à vous, les problèmes de peau sèche du monde entier ne seront bientôt plus qu'un lointain souvenir<nbsp>!
msgctxt "NpcYell:13259:0:13"
msgid "The laboratory calls! I shall be sure to make mention of you in my paper's footnotes!"
msgstr "Лаборатория зовёт! Обязательно упомяну вас в сносках к своей работе!"

#. ja: くっ……これでは新機軸の保湿液など開発できん……！<br>帰って研究計画の練り直しをしなければ……！
#. de: Mist ... So wird das nichts mit der neuen Hautsalbe. Ich muss mir etwas anderes einfallen lassen.
#. fr: La lotion hydratante de mes rêves n'est-elle qu'une vaine chimère<nbsp>? Je devrais peut-être revoir mes plans...
msgctxt "NpcYell:13260:0:13"
msgid "So much time for such a paltry number of samples... No, I must return to my desk and rethink this entire research proposal!"
msgstr "Столько времени — и так мало образцов... Нет, нужно вернуться к рабочему столу и пересмотреть весь план исследования!"

#. ja: おかげで、機密の書かれた部分はほぼ回収できたよ。<br>本当に助かった、ありがとう……！
#. de: Die Seiten mit den geheimsten Informationen befinden sich wieder in meinen Händen. Danke!
#. fr: Grâce à vous, j'ai pu récupérer tous les documents les plus sensibles de la liasse<nbsp>! Vous m'avez sauvé la vie... et je n'exagère même pas<nbsp>!
msgctxt "NpcYell:13261:0:13"
msgid "Thanks to you, the truth is no longer out there! The bulk of it is back in my hands, and that's where I intend to keep it!"
msgstr "Благодаря вам правда больше не гуляет на свободе! Большую часть документов я вернул и теперь собираюсь держать их при себе!"

#. ja: 嗚呼、終わりだ……。<br>あの「最重要機密書類」が流出してしまったら……<br>いったい、いくらの違約金が発生するんだ！？
#. de: Oje ... Was wird wohl aus mir, wenn die Geheimdokumente in die falschen Hände geraten<nbsp>...?!
#. fr: Je suis fini... Je n'ose même pas imaginer la somme astronomique que je vais devoir payer pour violation de ma clause de confidentialité<nbsp>!
msgctxt "NpcYell:13262:0:13"
msgid "This is it. This is the end. Once word gets out that I lost these documents, the contract violation fines alone will be the death of me..."
msgstr "Всё. Мне конец. Стоит только узнать, что я потерял документы, и одних лишь штрафов за нарушение договора хватит, чтобы меня доконать..."

#. ja: これで観察に戻れるわね
#. de: Dann kann ich ja jetzt meine Beobachtungen fortsetzen.
#. fr: Sur ce, nous allons pouvoir reprendre nos observations<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:13263:0:13"
msgid "Let's make sure the next specimen is <i>flora</i>..."
msgstr "Проследим, чтобы следующий образец был <i>растением</i>..."

#. ja: この戦いも終わらせる！
#. de: Nun ist Schluss!
#. fr: C'en est fini<nbsp>!
msgctxt "NpcYell:13264:0:13"
msgid "It ends here!"
msgstr "Здесь всё и закончится!"

#. ja: 見くびるなよッ！
#. de: Hochmut kommt vor dem Fall!
#. fr: Qu'est-ce que vous dites de ça<nbsp>!?
msgctxt "NpcYell:13265:0:13"
msgid "Do not underestimate me!"
msgstr "Не смейте меня недооценивать!"

#. ja: 緊急通信<br>至急、応援を請う！
#. de: Notsignal. Sende Unterstützungsanfrage.
#. fr: Transmission large bande.<br>À toutes les unités, je requiers votre aide<nbsp>!
msgctxt "NpcYell:13266:0:13"
msgid "Transmission: Timely assistance requested. Stand by for details."
msgstr "Передача: требуется срочная помощь. Ожидайте дальнейших указаний."

#. ja: 当機は、オミクロンN-6205。<br>状況通知：現在は通信機拡張を試みている。
#. de: Hier ist Omikron N-6205. Statusbericht: Aufrüstung des Kommunikators erforderlich.
#. fr: Ici l'unité Omicron N-6205.<br>Tentative de mise à niveau du communicateur en cours.
msgctxt "NpcYell:13267:0:13"
msgid "Unit designation: N-6205. Unit status: Attempting communications upgrade."
msgstr "Обозначение устройства: N-6205. Состояние: выполняется модернизация связи."

#. ja: 行動目的：指揮下から離れている侵略兵器「カイ」と、<br>交信を確立し、そのメモリーを回収することである。
#. de: Operationsziel: Außer Kontrolle geratene Angriffsmaschine Chi kontaktieren und Datenbank auslesen.
#. fr: Objectif<nbsp>: établir une communication avec l'arme d'invasion dénommée Khi, puis extraire les données qu'elle contient.
msgctxt "NpcYell:13268:0:13"
msgid "Unit directive: Establish contact with lost siege unit Chi and retrieve memory data."
msgstr "Приказ: установить связь с потерянной осадной машиной Ти и извлечь данные из памяти."

#. ja: 応援要請：通信機拡張に必要な「レアマテリアル」の収集である。<br>暴走機からの奪取、あるいは残骸から回収されたし、以上！
#. de: Sende Unterstützungsanfrage: Lieferung von Kommunikator-Bauteilen erbeten. Können von den Maschinen oder Wracks erbeutet werden.
#. fr: Aide requise afin de récupérer des composants rares sur des épaves ou sur des unités aux systèmes corrompus. Ils serviront à améliorer mon communicateur.
msgctxt "NpcYell:13269:0:13"
msgid "Transmission: This unit requests the collection of scrap from other units and surrounding area for use in current mission."
msgstr "Передача: требуется собрать лом с других устройств и из окрестностей для выполнения текущей задачи."

#. ja: 当機は、オミクロンN-6205。<br>状況通知：通信機拡張に必要な「レアマテリアル」の確保に成功。
#. de: Omikron N-6205. Statusbericht: Kommunikator-Bauteile in ausreichender Anzahl erlangt.
#. fr: Ici l'unité Omicron N-6205.<br>Composants nécessaires à la mise à niveau du communicateur rassemblés.
msgctxt "NpcYell:13270:0:13"
msgid "Transmission: Sufficient materials obtained. Unit status: Commencing communications upgrade..."
msgstr "Передача: необходимые материалы получены. Состояние устройства: начинается модернизация связи..."

#. ja: 応援要請：通信機拡張作業が完了次第、「カイ」との交信を試みる。<br>必要に応じて支援を求む、以上！
#. de: Unterstützungsanfrage: Erbitte Schutz während Kon<shy>takt<shy>auf<shy>nah<shy>me zu Chi.
#. fr: Objectif suivant<nbsp>: établir une communication avec l'arme d'invasion Khi.
msgctxt "NpcYell:13271:0:13"
msgid "...Upgrade complete. This unit requests you stand by in case further assistance is required."
msgstr "...Модернизация завершена. Устройство просит оставаться наготове на случай, если потребуется помощь."

#. ja: 作戦フェーズを<br>第二段階に移行…
#. de: Initiiere Kampfmodus Stufe 2<nbsp>...
#. fr: Début de la phase numéro deux du plan...
msgctxt "NpcYell:13272:0:13"
msgid "Initiating phase-two protocol..."
msgstr "Запуск протокола второй фазы..."

#. ja: こちらオミクロンN-6205。<br>必要な「レアマテリアル」の収集を断念……離脱する、以上！
#. de: Hier ist Omikron N-6205. Beschaffung der Kommunikator-Bauteile in ausreichender Anzahl ist gescheitert.
#. fr: Ici l'unité Omicron N-6205.<br>Échec de la récupération des composants rares. Battez en retraite<nbsp>!
msgctxt "NpcYell:13273:0:13"
msgid "Transmission: Insufficient materials obtained. Aborting current mission."
msgstr "Передача: материалов недостаточно. Текущая задача отменяется."

#. ja: 作戦フェーズを<br>準備段階に逆向…
#. de: Rückkehr zu Vorbereitung des Kampfmodus<nbsp>...
#. fr: Analyse en cours...<br>Établissement d'un nouveau plan...
msgctxt "NpcYell:13274:0:13"
msgid "Reinitiating preparatory protocol..."
msgstr "Повторный запуск подготовительного протокола..."

#. ja: ああっ、メリノたちが……！<br>これではせっかくのフワフワの羊毛が台無しです！
#. de: Hilfe, meine armen Merinos sind in Gefahr!
#. fr: Mes pauvres mérinos... Papa vous aime toujours, même si vous n'êtes plus soyeux<nbsp>!
msgctxt "NpcYell:13275:0:13"
msgid "Nooo! My precious merinos! All that luxurious wool...wasted!"
msgstr "Не-е-ет! Мои драгоценные мериносы! Столько роскошной шерсти... пропало зря!"

#. ja: ふぅ……無事に追い払えましたね！<br>これでメリノたちも、安心して草を食べるはずです！
#. de: Das ging nochmal gut! Jetzt können meine Merinos wieder in Ruhe grasen.
#. fr: Ouf<nbsp>! Les mérinos vont pouvoir continuer à brouter comme si de rien n'était<nbsp>!
msgctxt "NpcYell:13276:0:13"
msgid "You did it! You fought them off! Now my little merinos can safely return to chewing grass and growing wool!"
msgstr "Вы справились! Отбили их! Теперь мои маленькие мериносы спокойно вернутся щипать травку и отращивать шерсть!"

#. ja: 頑張って！<br>負けないでっ！
#. de: Alles Gute, Nano! Leb wohl. Vielleicht sehen wir uns wieder!
#. fr: Courage<nbsp>!
msgctxt "NpcYell:13277:0:13"
msgid "That's it, my little one! You can do this!"
msgstr "Вот так, малыш! Ты справишься!"

#. ja: あ～、違法改造されてる！<br>早く止めないと～！
#. de: Sie gehorchen überhaupt nicht mehr! Wir müssen sie aufhalten!
#. fr: Oh non, elles n'obéissent plus à leur protocole<nbsp>! Il faut les arrêter<nbsp>!
msgctxt "NpcYell:13278:0:13"
msgid "Th-These have been illegally modified... We must stop them!"
msgstr "Э-этих незаконно модифицировали... Надо их остановить!"

#. ja: 緊急通信<br>至急、応援を請う！
#. de: Notsignal: Sende Unterstützungsanfrage!
#. fr: Transmission large bande.<br>À toutes les unités, je requiers votre aide<nbsp>!
msgctxt "NpcYell:13281:0:13"
msgid "Transmission: Emergency assistance requested. Stand by for details."
msgstr "Передача: требуется экстренная помощь. Ожидайте дальнейших указаний."

#. ja: 当機は、オミクロンN-6205。<br>状況通知：これより侵略兵器「カイ」への通信を開始する。
#. de: Hier ist Omikron N-6205. Statusbericht: Beginne Kon<shy>takt<shy>auf<shy>nah<shy>me zu Angriffsmaschine Chi.
#. fr: Ici l'unité Omicron N-6205.<br>Tentative de communication avec l'unité d'invasion Khi en cours.
msgctxt "NpcYell:13282:0:13"
msgid "Unit designation: N-6205. Unit status: Attempting to establish communications with siege unit Chi."
msgstr "Обозначение устройства: N-6205. Состояние: устанавливается связь с осадной машиной Ти."

#. ja: 行動目的：指揮下から離れている侵略兵器「カイ」と、<br>交信を確立し、そのメモリーを回収することである。
#. de: Operationsziel: Außer Kontrolle geratene Angriffsmaschine Chi kontaktieren und Datenbank auslesen.
#. fr: Objectif<nbsp>: localiser Khi, puis extraire les données qu'elle contient.
msgctxt "NpcYell:13283:0:13"
msgid "Unit directive: Establish contact with lost siege unit Chi and retrieve memory data."
msgstr "Приказ: установить связь с потерянной осадной машиной Ти и извлечь данные из памяти."

#. ja: 応援要請：通信を傍受した暴走機が接近してきた場合、<br>迎撃を行い、通信完了まで当機を護衛されたし、以上！
#. de: Unterstützungsanfrage: Maschinen haben das Signal abgefangen und greifen an. Erbitte Schutz!
#. fr: Aide requise afin de me protéger des unités aux systèmes corrompus qui pourraient m'attaquer durant l'ouverture du canal.
msgctxt "NpcYell:13284:0:13"
msgid "Transmission: This unit is vulnerable while operating transceiver. Timely apprehension of hostiles requested."
msgstr "Передача: устройство уязвимо во время работы передатчика. Требуется своевременно задержать противника."

#. ja: 当機は、オミクロンN-6205。<br>状況通知：侵略兵器「カイ」との通信確立に成功……。
#. de: Hier ist Omikron N-6205. Statusbericht: Kon<shy>takt<shy>auf<shy>nah<shy>me zu Chi war erfolgreich.
#. fr: Ici l'unité Omicron N-6205.<br>Communication avec l'unité d'invasion Khi établie.
msgctxt "NpcYell:13285:0:13"
msgid "Unit status: Communications established with siege unit Chi..."
msgstr "Состояние устройства: связь с осадной машиной Ти установлена..."

#. ja: 現在地の位置情報を送信、カイの到着まで待機する。<br>必要に応じて支援を求む、以上！
#. de: Sende Po<shy>si<shy>tions<shy>da<shy>ten und erwarte Ankunft von Chi. Bitte für den Notfall bereithalten!
#. fr: Coordonnées de rendez-vous transmises.<br>Votre aide sera pro<shy>ba<shy>ble<shy>ment requise à nouveau une fois que Khi sera arrivée.
msgctxt "NpcYell:13286:0:13"
msgid "Transmission of current coordinates complete. Now awaiting siege unit's arrival. Stand by."
msgstr "Координаты переданы. Ожидается прибытие осадной машины. Оставайтесь наготове."

#. ja: 作戦フェーズを<br>第三段階に移行…
#. de: Initiiere Kampfmodus Stufe 3<nbsp>...
#. fr: Début de la phase numéro trois du plan...
msgctxt "NpcYell:13287:0:13"
msgid "Initiating phase-three protocol..."
msgstr "Запуск протокола третьей фазы..."

#. ja: 作戦フェーズを<br>準備段階に逆向…
#. de: Deaktiviere Kampfmodus<nbsp>...
#. fr: Analyse en cours...<br>Établissement d'un nouveau plan...
msgctxt "NpcYell:13288:0:13"
msgid "Reinitiating preparatory protocol..."
msgstr "Повторный запуск подготовительного протокола..."

#. ja: 通信開始…<br>ピポパポピポパポポ…
#. de: Sende Signal<nbsp>... Piiipoo<nbsp>...
#. fr: Ouverture du canal de communication...
msgctxt "NpcYell:13289:0:13"
msgid "Commencing transmission... \\<BrzZzRRrTtt>"
msgstr "Начинаю передачу... \\<Брррзззрт>"

#. ja: ピーピーピーピー<br>ヒョロロロロロ
#. de: Piiipooopaaaa<nbsp>...
#. fr: BIP BOUP BIP BOUP BIP<br>DRILILILI DRILILILI
msgctxt "NpcYell:13290:0:13"
msgid "\\<beep> \\<boop> \\<boop> \\<beep>...\\<BWAAAAAA>"
msgstr "<i>Пи-пи-пи-пи... Фью-ю-ю-ю!</i>"

#. ja: ピーブピブーピーガ…<br>ガーーーーーーッ！
#. de: Piiipuuukrong<nbsp>...
#. fr: PIIII PUUUUU CHDONG CHDONGPRSCHHHHHHHHHHHT
msgctxt "NpcYell:13291:0:13"
msgid "\\<brrrp> \\<brrrp>...\\<BRRRZZZT>"
msgstr "<i>Брр-рип! Брр-рип... БРРРЗЗЗТ!</i>"

#. ja: ガーッ、ブツン…<br>再接続開始…
#. de: Krrrrsssch<nbsp>... Verbindung wird neu aufgebaut<nbsp>...
#. fr: TRRRRRRRRRRSCH...<br>Canal ouvert.
msgctxt "NpcYell:13292:0:13"
msgid "Transmission interrupted. Reestablishing connection..."
msgstr "Передача прервана. Восстанавливаю связь..."

#. ja: レーダーに反応…<br>暴走機と断定！
#. de: Radarsignale empfangen<nbsp>... Feinde entdeckt<nbsp>...
#. fr: Écho radar...<br>Ennemis détectés<nbsp>!
msgctxt "NpcYell:13293:0:13"
msgid "Activity detected on radar... Hostility confirmed."
msgstr "Обнаружена активность на радаре... Подтверждена враждебность."

#. ja: 暴走機を排除し<br>当機を防衛されたし、以上！
#. de: Erbitte Feindesabwehr zum Schutz von N-6205!
#. fr: Élimination de la menace confirmée.<br>N-6205 toujours opérationnel.
msgctxt "NpcYell:13294:0:13"
msgid "This unit requests protection during transmission."
msgstr "Устройство запрашивает защиту на время передачи."

#. ja: 状況通知：<br>当機の損傷率50％に拡大…
#. de: Statusbericht: Beschädigung bei 50 %<nbsp>...
#. fr: Rapport d'avaries<nbsp>:<br>N-6205 endommagé à 50%...
msgctxt "NpcYell:13295:0:13"
msgid "Unit status: Frame integrity at 50%..."
msgstr "Состояние устройства: целостность каркаса — 50%..."

#. ja: 状況通知：<br>当機の損傷率90％に拡大…
#. de: Statusbericht: Beschädigung bei 90 %<nbsp>...
#. fr: Rapport d'avaries<nbsp>:<br>N-6205 endommagé à 90%...
msgctxt "NpcYell:13296:0:13"
msgid "Unit status: Frame integrity at 10%..."
msgstr "Состояние устройства: целостность каркаса — 10%..."

#. ja: 緊急通信<br>至急、応援を請う！
#. de: 0
#. fr: 0
msgctxt "NpcYell:13297:0:13"
msgid "0"
msgstr "0"

#. ja: レーダーに反応…<br>接近する機体をカイと断定！
#. de: 0
#. fr: 0
msgctxt "NpcYell:13298:0:13"
msgid "0"
msgstr "0"

#. ja: 当機は、オミクロンN-6205。<br>状況通知：侵略兵器「カイ」への接近を確認した。
#. de: Hier ist N-6205. Statusbericht: Angriffswaffe Chi ist im Anflug.
#. fr: Ici l'unité Omicron N-6205.<br>Unité d'invasion Khi en approche.
msgctxt "NpcYell:13299:0:13"
msgid "Unit designation: N-6205. Unit status: Anticipating imminent arrival of siege unit Chi."
msgstr "Обозначение устройства: N-6205. Состояние: ожидается скорое прибытие осадной машины Ти."

#. ja: 行動目的：侵略兵器「カイ」からのメモリー回収。<br>該当機は、貴重なデータを多数保有しているものと思われる。
#. de: Operationsziel: Auslesen der Datenbank der Angriffswaffe Chi. Die Datenbank enthält vermutlich sehr wertvolle Daten.
#. fr: Objectif<nbsp>: extraire les précieuses banques de données que Khi contient.
msgctxt "NpcYell:13300:0:13"
msgid "Unit directive: Establish contact with lost siege unit Chi and retrieve memory data. Retrieval assistance requested."
msgstr "Приказ: установить связь с потерянной осадной машиной Ти и извлечь данные из памяти. Требуется помощь."

#. ja: 要請通知：侵略兵器「カイ」、メモリーの回収を要求する。<br>そのデータは、我々の生存に必要である。
#. de: Unterstützungsanfrage: Erbitte Hilfe beim Auslesen der Datenbank von Chi. Die Daten sind wichtig für unsere Existenz.
#. fr: Khi, je requiers que tu me confies toutes tes banques de données. Elles contiennent des in<shy>for<shy>ma<shy>tions vitales pour la continuation de notre espèce.
msgctxt "NpcYell:13301:0:13"
msgid "...Update: This unit neglected to mention that said data is vital to our continued existence."
msgstr "...Обновление: устройство не упомянуло, что эти данные жизненно важны для нашего дальнейшего существования."

#. ja: 戦争戦略プロトコルからの最終指令は、知性体のせん滅、<br>未確認知性体を発見、これより攻撃を開始する……！
#. de: Kampfprotokolle geladen. Ausführung der letzten gespeicherten Operation: Auslöschung aller empfindungsfähigen Lebensformen!
#. fr: Protocoles de combat chargés. Exécution de la dernière directive placée dans l'accumulateur.<br>Anéantissement de toute forme de vie pensante. Formes de vie pensantes... détectées<nbsp>!
msgctxt "NpcYell:13302:0:13"
msgid "Reviewing siege protocol... Ah. Unit Chi's standing orders are to eliminate all unknown life-forms throughout the stars."
msgstr "Проверяю протокол осады... Так. Текущий приказ устройства Ти — уничтожить все неизвестные формы жизни в звёздных системах."

#. ja: 応援要請：侵略兵器「カイ」の破壊……！<br>我らの、そして異星文明の生存のため、応援を請う、以上！
#. de: Unterstützungsanfrage: Angriffswaffe Chi muss zerstört werden! Die Existenz der Omikrons hängt davon ab!
#. fr: Nouvel objectif<nbsp>: détruire Khi<nbsp>!<br>il en va de la survie des Omicrons<nbsp>!
msgctxt "NpcYell:13303:0:13"
msgid "Analysis indicates that this would be unfortunate. Requesting combat support."
msgstr "Согласно анализу, это было бы крайне нежелательно. Запрашиваю боевую поддержку."

#. ja: おお……ついに私を打ち負かす存在が……<br>これぞ求めた結末……この敗北のメモリーこそが我が存在意義！
#. de: Oh<nbsp>... endlich gibt es jemanden, der mich besiegen kann<nbsp>... Das ist das Ende, auf das ich gewartet habe<nbsp>...
#. fr: Enfin... Quelqu'un capable de me supplanter... Ma mission est accomplie. Cette défaite à elle seule justifie mon existence, et je la conserverai pré<shy>cieu<shy>se<shy>ment en mémoire<nbsp>!
msgctxt "NpcYell:13304:0:13"
msgid "Uploading memory of defeat... This unit has never felt so alive."
msgstr "Загружаю память о поражении... Эта модель ещё никогда не чувствовала себя такой живой."

#. ja: 状況通知：侵略兵器「カイ」の活動停止を確認……<br>該当機より、メモリー転送を確認……。
#. de: Statusbericht: Angriffswaffe Chi ist außer Gefecht gesetzt. Beginne Auslesen der Datenbank<nbsp>...
#. fr: Analyse en cours... Unité Khi inopérationnelle.<br>Récupération des banques de données...
msgctxt "NpcYell:13305:0:13"
msgid "Transmission: Chi systems confirmed non-operational. Downloading memory..."
msgstr "Передача: системы Ти отключены. Загружаю память..."

#. ja: これにより、我らは新たな進化の可能性を手に入れた。<br>献身的な協力に感謝する、以上！
#. de: Die Daten ermöglichen die Weiterentwicklung der Omikrons. N-6205 dankt für die Unterstützung!
#. fr: J'ai désormais en ma possession la clef qui nous permettra d'évoluer.<br>Merci pour votre coopération<nbsp>! Communication terminée<nbsp>!
msgctxt "NpcYell:13306:0:13"
msgid "This data will be invaluable to our civilization. Gratitude output exceeding maximum levels..."
msgstr "Эти данные бесценны для нашей цивилизации. Уровень благодарности превышает допустимый..."

#. ja: さあ、研究資料を<br>探しましょう…！
#. de: Wir müssen die Teile so schnell wie möglich einsammeln.
#. fr: Il faut qu'on trouve ces documents<nbsp>!
msgctxt "NpcYell:13308:0:13"
msgid "We must gather the necessary components as swiftly as possible."
msgstr "Нужно как можно скорее собрать необходимые компоненты."

#. ja: 了解であります！
#. de: Geh vor!
#. fr: Je vous suis<nbsp>!
msgctxt "NpcYell:13309:0:13"
msgid "Lead the way!"
msgstr "Ведите!"

#. ja: ああ、機体が暴走して…！<br>エブレルノさん…！
#. de: Die Maschine läuft Amok! Ebrelnaux!
#. fr: Oh non, la machine est devenue folle<nbsp>! Ebrelnaux<nbsp>!!
msgctxt "NpcYell:13310:0:13"
msgid "Oh gods, there's no stopping it now... Ebrelnaux!"
msgstr "О боги, её уже не остановить... Эбрено!"

#. ja: おい、クソ男！<br>油断するんじゃねえぞ！
#. de: He, Hornochse! Pass gefälligst auf!
#. fr: Hé Magnai<nbsp>! C'est pas le moment de se relâcher, imbécile<nbsp>!
msgctxt "NpcYell:13311:0:13"
msgid "Preening fool! Stay alert!"
msgstr "Расфуфыренный дурак! Не теряй бдительности!"

#. ja: 何だと？<br>女、誰に物を言っている！？
#. de: Sag das noch mal, du<nbsp>...!
#. fr: Quoi<nbsp>!? À qui crois-tu parler, femme<nbsp>!?
msgctxt "NpcYell:13312:0:13"
msgid "The Sun does not heed the barking of feral dogs!"
msgstr "Солнце не внемлет лаю одичавших псов!"

#. ja: なんだか嫌な空気…
#. de: Ich hab ein ungutes Gefühl<nbsp>...
#. fr: Quelque chose ne tourne pas rond ici... J'ai un mauvais pres<shy>sen<shy>ti<shy>ment.
msgctxt "NpcYell:13313:0:13"
msgid "The farther we go, the worse this place gets..."
msgstr "Чем дальше заходим, тем хуже здесь становится..."

#. ja: そうだな…<br>焦らず慎重に行こう
#. de: Ja. Wir sollten vorsichtig sein.
#. fr: Oui... Mieux vaut rester sur nos gardes.
msgctxt "NpcYell:13314:0:13"
msgid "Indeed. We'd best be prepared for any eventuality."
msgstr "Верно... Будем готовы ко всему."

#. ja: ケルトロナ少甲士…<br>何か見つかりましたか？
#. de: Hast du etwas gefunden, Keltlona?
#. fr: Keltlona, avez-vous trouvé quelque chose<nbsp>?
msgctxt "NpcYell:13315:0:13"
msgid "Were you able to find anything of note, Keltlona?"
msgstr "Келтрона, удалось найти что-нибудь примечательное?"

#. ja: いいえ…<br>研究資料はひとつも…
#. de: Nichts von Interesse.
#. fr: Rien qui ne s'apparente à des documents importants...
msgctxt "NpcYell:13316:0:13"
msgid "No such luck. It all looks like junk to me."
msgstr "Не повезло. Тут один хлам."

#. ja: こちらもです<br>痕跡すらありませんでした
#. de: Bei mir war es genauso.
#. fr: Rien non plus de mon côté...
msgctxt "NpcYell:13317:0:13"
msgid "Alas, my search proved equally unproductive."
msgstr "У меня тоже ничего полезного."

#. ja: 研究拠点が別の場所に<br>移転させられていたようです
#. de: Aber es gibt noch einen Ort, an dem wir uns umsehen sollten.
#. fr: Peut-être que le laboratoire a été transféré à un autre endroit... Et je crois savoir où.
msgctxt "NpcYell:13318:0:13"
msgid "However, there's another location that is worth a try."
msgstr "Но есть ещё одно место, где стоит поискать."

#. ja: 次は危険ですが<br>魔導工廠を捜索してみましょう！
#. de: Die Munitionsfabrik ist ganz in der Nähe.
#. fr: Nous approchons de l'usine de munitions. Restons vigilants<nbsp>!
msgctxt "NpcYell:13319:0:13"
msgid "We are now close to the munitions factory."
msgstr "Мы уже близко к заводу боеприпасов."

#. ja: この工廠で魔導兵器の<br>無人化が行われていたはず…
#. de: Hier wurden die älteren Einheiten zu autonom handelnden Maschinen gemacht.
#. fr: C'est dans cette usine que les armes magiteks sans pilotes ont dû être conçues.
msgctxt "NpcYell:13320:0:13"
msgid "That is where the automation process must've been carried out on older units."
msgstr "Здесь старые модели, должно быть, превращали в автономные машины."

#. ja: むっ…やはり迎撃に<br>現れたようですね…！
#. de: Und da ist ja auch schon das Begrüßungskomitee.
#. fr: Je vois que nous avons un comité d'accueil...
msgctxt "NpcYell:13321:0:13"
msgid "And there is our welcoming party, right on cue."
msgstr "А вот и встречающие, как по заказу."

#. ja: あらかた排除に<br>成功したようですね…
#. de: Das war die letzte der kleineren Einheiten.
#. fr: On a eu la dernière des armes de taille réduite.
msgctxt "NpcYell:13322:0:13"
msgid "It appears that was the last of the smaller units."
msgstr "Похоже, это была последняя из малых машин."

#. ja: いや、これまで倒したのは<br>子機に過ぎないはずです
#. de: Die Schlitzer und Drohnen gehören zu einer größeren Maschine.
#. fr: Mais ce n'était encore que du menu fretin...
msgctxt "NpcYell:13323:0:13"
msgid "But they were no more than sub-units, or underlings, one might say."
msgstr "Но это были лишь подчинённые машины, если можно так сказать."

#. ja: より大型の司令機がいるはず！<br>油断しないでください！
#. de: Die Kommandoeinheit kann nicht weit weg sein!
#. fr: Celle qui commande toutes les autres ne devrait pas être loin. Restons vigilants<nbsp>!
msgctxt "NpcYell:13324:0:13"
msgid "The commanding unit should be nearby!"
msgstr "Командная машина должна быть где-то рядом!"

#. ja: そ、その司令機って<br>もしかしてアレでは…？
#. de: Das da ist unser eigentliches Ziel?
#. fr: Alors c'est elle, notre véritable cible<nbsp>?
msgctxt "NpcYell:13325:0:13"
msgid "That's our true target, yes?"
msgstr "Это и есть наша настоящая цель?"

#. ja: 奴のコアユニットがあれば…<br>無人魔導兵器を止める方法も！
#. de: Richtig. Darin müssen die Teile sein, die ich brauche.
#. fr: Oui. Et il nous faut ses pièces<nbsp>!
msgctxt "NpcYell:13326:0:13"
msgid "Correct. I believe it contains the components I require."
msgstr "Верно. Думаю, внутри есть нужные мне детали."

#. ja: 目標の沈黙を確認！<br>やりましたね！
#. de: Hurra! Die Maschine ist außer Betrieb!
#. fr: Vous l'avez désactivée. Beau travail<nbsp>!
msgctxt "NpcYell:13327:0:13"
msgid "Excellent! You've succeeded in deactivating it!"
msgstr "Отлично! Вы её отключили!"

#. ja: 皆さん、協力に感謝します<br>これで希望が見えてきました！
#. de: Ich bin dir wirklich sehr dankbar.
#. fr: Je vous suis si re<shy>con<shy>nais<shy>sant<nbsp>!
msgctxt "NpcYell:13328:0:13"
msgid "Words cannot express my gratitude."
msgstr "Мне не хватит слов, чтобы вас отблагодарить."

#. ja: 残骸からコアユニットを<br>回収し解析してみましょう
#. de: Ich werde die neuen Teile demontieren und mit ins Lager nehmen.
#. fr: Une fois que j'aurai trouvé ce qui m'intéresse, je retournerai au camp.
msgctxt "NpcYell:13329:0:13"
msgid "Once I've retrieved the necessary parts, I'll make my way back to camp."
msgstr "Я заберу нужные детали и вернусь в лагерь."

#. ja: いつの日か帝都から<br>無人兵器を一掃するために…
#. de: Ich werde einen Weg finden, die Automatisierung unschädlich zu machen. Dann gehört diese Stadt wieder ihren Bürgern.
#. fr: Le jour viendra où on ne verra plus une seule de ces maudites armes sans pilotes dans les rues de la capitale<nbsp>!
msgctxt "NpcYell:13330:0:13"
msgid "Soon, Garlemald will be free of automated magitek, and the people may reclaim their city."
msgstr "Скоро в Гарлемальде не останется автономного магитека, и жители смогут вернуть себе город."

#. ja: これはいけませんね…<br>撤退しましょう
#. de: Ein hartnäckiger Gegner. Besser, wir ziehen uns zurück.
#. fr: L'ennemi est bien trop fort... Battons en retraite<nbsp>!
msgctxt "NpcYell:13331:0:13"
msgid "A far more stubborn foe than anticipated. Let us retreat for the time being."
msgstr "Противник оказался куда упорнее, чем мы думали. Пока отступим."

#. ja: り、了解であります！
#. de: Verstanden.
#. fr: Entendu.
msgctxt "NpcYell:13332:0:13"
msgid "Understood."
msgstr "Понял."

#. ja: 作戦終了…<br>作戦は成功裏に終了せり！
#. de: Operation erfolgreich abgeschlossen<nbsp>...
#. fr: Évaluation de la situation...<br>Mission achevée avec succès.
msgctxt "NpcYell:13333:0:13"
msgid "As this unit's directive has been fulfilled, this mission is complete."
msgstr "Раз задача этой модели выполнена, миссию можно считать завершённой."

#. ja: これより、メモリーの解析<br>進化可能性の算出を行う
#. de: Analysiere Daten auf Hinweise für Entwicklungspotenzial<nbsp>...
#. fr: Le calcul des probabilités d'évolution va pouvoir commencer.<br>Décompression des données...
msgctxt "NpcYell:13334:0:13"
msgid "Retrieved memory data will be analyzed for the further optimization of our protocols."
msgstr "Анализирую полученные данные, чтобы оптимизировать наши протоколы."

#. ja: さらば異星の友<br>さらば勇猛な同胞カイよ…
#. de: Lebe wohl, <if $gn4>Freundin<else>Freund</if> von einem anderen Planeten!
#. fr: Adieu, allié<if $gn4>e</if> d'une autre planète.<br>Adieu, Khi. L'étendue de ta puissance était im<shy>pres<shy>sion<shy>nante...
msgctxt "NpcYell:13335:0:13"
msgid "Sentimentality levels increasing... This unit bids farewell to you and its fallen comrade."
msgstr "Показатели сентиментальности растут... Эта модель прощается с вами и павшим товарищем."

#. ja: それでも生きたいと<br>願うのが命じゃないのか？
#. de: Der Wunsch, trotz allem leben zu wollen, ist, was das Leben ausmacht.
#. fr: Être vivant, c'est pas avancer en dépit de cela<nbsp>?
msgctxt "NpcYell:13336:0:13"
msgid "Apathy is no excuse to give up on living."
msgstr "Апатия — не повод отказываться от жизни."

#. ja: なんなのよ…！<br>その答えは！
#. de: Was soll man aus diesem Elend nur lernen?
#. fr: N'importe quoi<nbsp>! Ils avaient tout pour être heureux<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:13337:0:13"
msgid "They lost their passion for <i>everything</i>? Even life itself?"
msgstr "Они потеряли интерес ко <i>всему</i>? Даже к самой жизни?"

#. ja: 生存本能すら<br>捨て去る境地だなんて…
#. de: Wie kann man nur seinen Instinkt zu leben verlieren ...
#. fr: Ils ont même perdu leur instinct de survie...
msgctxt "NpcYell:13338:0:13"
msgid "That apathy could usurp their will to live is horrifying to say the least."
msgstr "Страшно даже подумать, что апатия могла заглушить волю к жизни."

#. ja: そんな未来に<br>オレたちは辿りつかない！
#. de: Dies ist nicht unsere Zukunft!
#. fr: Ce ne sera pas notrrre cas<nbsp>!
msgctxt "NpcYell:13339:0:13"
msgid "I pray such a future never comes to pass on Etheirys."
msgstr "Молю, пусть на Этерисе никогда не наступит такое будущее."

#. ja: 世界の自決、か…
#. de: Eine ganze Welt stürzt sich in den Abgrund<nbsp>...
#. fr: Un monde entier qui saute à pieds joints dans le néant...
msgctxt "NpcYell:13340:0:13"
msgid "And so the world died without so much as a whimper."
msgstr "И вот целый мир погиб, даже не издав ни звука."

#. ja: 人々が終わるために<br>創った存在だとでも…！？
#. de: Das wurde nur zu dem Zweck geschaffen, jeden Mann und jede Frau zu töten?
#. fr: Elle a été créée dans l'unique but de prendre la vie<nbsp>!
msgctxt "NpcYell:13341:0:13"
msgid "Was this what brought about their end?"
msgstr "Неужели это и привело их к гибели?"

#. ja: 生きたいと願った人のため<br>私はこれを否定する…！
#. de: Ich lasse das nicht zu! Ich will die ehren, die leben wollten!
#. fr: Je vaincrai<nbsp>! Pour tous ceux qui ne demandent qu'à vivre<nbsp>!
msgctxt "NpcYell:13342:0:13"
msgid "No... How could they?"
msgstr "Нет... Как они могли?"

#. ja: この世界を知ってなお<br>私の答えは変わらない！
#. de: Ich bleibe bei meiner Antwort, egal, was man mir zeigt!
#. fr: Désolée, Météion, mais même ce monde ne fera pas vaciller mon opinion<nbsp>!
msgctxt "NpcYell:13343:0:13"
msgid "Our world will never succumb to such a fate."
msgstr "Наш мир никогда не смирится с такой участью."

#. ja: 見せてやろう…<br>「暁」の希望を！
#. de: Die Morgenröte ist ein Symbol der Hoffnung!
#. fr: Les Héritiers apportent l'espoir parrrtout où ils vont<nbsp>!
msgctxt "NpcYell:13344:0:13"
msgid "Let us show Meteion what it means to have hope."
msgstr "Покажем Метеион, что такое надежда."

#. ja: これで心折るつもりとは<br>舐められたものだな
#. de: Wir lassen uns jetzt nicht mehr einschüchtern.
#. fr: Elle croyait pouvoir instiller le doute dans nos cœurs avec ça<nbsp>? Hmpf.
msgctxt "NpcYell:13345:0:13"
msgid "Was this meant to discourage us? Hmph."
msgstr "Она думала, что этим нас обескуражит? Хм."

#. ja: 継いできたものがあるんだ…<br>私たちは挫けないッ！
#. de: Dies ist nicht der erste Weltuntergang, den der Bund überwunden hat!
#. fr: Nous portons le flambeau et rien ne nous arrêtera<nbsp>!
msgctxt "NpcYell:13346:0:13"
msgid "They may have given up, but it's no reason for us to lose hope."
msgstr "Они сдались, но это не повод терять надежду и нам."

#. ja: 突撃せよ！
#. de: Sturmangriff!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:13347:0:13"
msgid "As one!"
msgstr "Вместе!"

#. ja: 底力を見せてみよ！
#. de: Zeigt eure Stärke!
#. fr: Pour notre gloire et notre salut<nbsp>!
msgctxt "NpcYell:13348:0:13"
msgid "Show them what we're made of!"
msgstr "Покажите, на что способны!"

#. ja: すまない、恩に着る！
#. de: Danke!
#. fr: Je te revaudrai ça<nbsp>!
msgctxt "NpcYell:13349:0:13"
msgid "I owe you for that!"
msgstr "Я у тебя в долгу!"

#. ja: 食らえ！
#. de: Friss das!
#. fr: Mange-toi ça<nbsp>!
msgctxt "NpcYell:13350:0:13"
msgid "Try this!"
msgstr "Получи!"

#. ja: もう<br>結局これじゃないか～！
#. de: Komisch. Woher wusste ich, dass so was passiert ...?
#. fr: J'ai comme une impression de déjà-vu<nbsp>!
msgctxt "NpcYell:13352:0:13"
msgid "Another experiment gone wrong... How am I not surprised!?"
msgstr "Опять эксперимент пошёл не так... Да кто бы сомневался!"

#. ja: メリノたちを<br>守ってください…！
#. de: Bitte beschütze meine Merinos!
#. fr: Je vous en prie, protégez les mérinos<nbsp>!
msgctxt "NpcYell:13354:0:13"
msgid "Please, keep my merinos safe!"
msgstr "Пожалуйста, не дайте в обиду моих мериносов!"

#. ja: この辺りに<br>薬草があるはず…
#. de: Die Heilkräuter sollten hier irgendwo wachsen ...
#. fr: Les herbes devraient se trouver par ici...
msgctxt "NpcYell:13355:0:13"
msgid "Now then, the herbs should grow here..."
msgstr "Так, травы должны расти где-то здесь..."

#. ja: 大切に育てた<br>メリノなんです…！
#. de: Die Merinos sind mein Ein und Alles!
#. fr: Je les ai élevés avec tout mon amour<nbsp>!
msgctxt "NpcYell:13356:0:13"
msgid "Don't let them spit on the sheep!"
msgstr "Я их холил и лелеял! Не дайте этим тварям над ними надругаться!"

#. ja: どこだ…<br>どこにあるんだ…
#. de: Eher findet man eine Nadel im Heuhaufen ...
#. fr: C'est comme chercher une allumette dans une botte de foin...
msgctxt "NpcYell:13357:0:13"
msgid "This is like finding a needle in a haystack..."
msgstr "Иголку в стоге сена найти проще..."

#. ja: それらしいものは<br>見当たりませんね…
#. de: Hier ist nichts, was so aussieht, wie Ebrelnaux es beschrieben hat.
#. fr: Je ne trouve rien qui s'apparente à ce que cherche Ebrelnaux...
msgctxt "NpcYell:13358:0:13"
msgid "I don't see anything even close to what Ebrelnaux described."
msgstr "Не вижу ничего похожего на то, что описывал Эбрено."

#. ja: 最新の研究資料があれば<br>無人兵器の暴走を止めることも…
#. de: Wir brauchen etwas, das uns Aufschluss über die Automatisierung dieser Maschinen gibt.
#. fr: Si l'on veut arrêter ces armes, il faut qu'on trouve les documents les plus récents.
msgctxt "NpcYell:13359:0:13"
msgid "There must be some hint as to the inner working of these automated weapons..."
msgstr "Должна же найтись хоть какая-то зацепка, как работают эти автономные машины..."

#. ja: 残っていてくれよ…
#. de: Es muss doch etwas geben!
#. fr: Pourvu qu'il reste quelque chose...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:13360:0:13"
msgid "Please... Let there be <i>something</i> left!"
msgstr "Пожалуйста... Пусть хоть <i>что-нибудь</i> уцелело!"

#. ja: まったく見当たらない…<br>ということは…
#. de: Nichts. Das kann nur eins heißen ...
#. fr: Non, je ne trouve rien. Ce qui doit vouloir dire que...
msgctxt "NpcYell:13361:0:13"
msgid "Nothing. That can only mean..."
msgstr "Пусто. Значит, это может означать только одно..."

#. ja: ぐあっ…だ、誰か…<br>助けてくださいっ！
#. de: Aaah! Hilfe!
#. fr: Aaah<nbsp>! Au secours<nbsp>!
msgctxt "NpcYell:13362:0:13"
msgid "Argh! Someone help!"
msgstr "А-а-а! Кто-нибудь, помогите!"

#. ja: うわぁ…！<br>支援を…支援を要請します！
#. de: Warte, ich hole Hilfe!
#. fr: J-je vais appeler de l'aide<nbsp>!
msgctxt "NpcYell:13363:0:13"
msgid "Hold on, I'll request support!"
msgstr "Держитесь, я позову подмогу!"

#. ja: これ以上は…<br>撤退して出直しましょう…！
#. de: Sinnlos. Wir müssen die Suche abbrechen.
#. fr: Il va falloir qu'on se replie<nbsp>!
msgctxt "NpcYell:13364:0:13"
msgid "It's no good. We'll have to abandon the search!"
msgstr "Бесполезно. Придётся бросить поиски!"

#. ja: 了解であります…！
#. de: Du hast recht. Ziehen wir uns zurück.
#. fr: Entendu<nbsp>!
msgctxt "NpcYell:13365:0:13"
msgid "You're right. Let's fall back!"
msgstr "Вы правы. Отступаем!"

#. ja: これはいけませんね…<br>撤退しましょう
#. de: An denen ist kein Vorbeikommen.
#. fr: On n'y arrivera pas... Replions-nous<nbsp>!
msgctxt "NpcYell:13366:0:13"
msgid "We'll never get past them at this rate."
msgstr "С такими темпами нам их не одолеть."

#. ja: り、了解であります！
#. de: Ja. Wir müssen uns etwas anderes überlegen.
#. fr: E-entendu<nbsp>!
msgctxt "NpcYell:13367:0:13"
msgid "Agreed. Let's regroup and think of another approach."
msgstr "Согласен. Отступим и придумаем другой план."

#. ja: でも魔猿たちが…<br>どうしたらいいの？
#. de: Was soll ich nur wegen dieser blöden Affen machen?!
#. fr: Mais, les singes... Que faire<nbsp>!?
msgctxt "NpcYell:13368:0:13"
msgid "But whatever will I do about those langurs...?"
msgstr "Но что же мне делать с этими лангурами?.."

#. ja: 逃げて～！
#. de: Flieh!
#. fr: Fuyez<nbsp>!
msgctxt "NpcYell:13369:0:13"
msgid "Go─fly!"
msgstr "Летите прочь!"

#. ja: あ、危ないっ！
#. de: Achtung!
#. fr: A-attention<nbsp>!
msgctxt "NpcYell:13370:0:13"
msgid "L-Look out!"
msgstr "О-осторожно!"

#. ja: くっ…
#. de: Ugh<nbsp>...
#. fr: Ugh...
msgctxt "NpcYell:13371:0:13"
msgid "Ugh..."
msgstr "Ух..."

#. ja: ぐぁっ！
#. de: Guah!
#. fr: Guah<nbsp>!
msgctxt "NpcYell:13372:0:13"
msgid "Gwah!"
msgstr "А-а!"

#. ja: 君たち…<br>協力に感謝する！
#. de: Danke für deine Hilfe!
#. fr: Merci beaucoup<nbsp>! Quel soulagement<nbsp>!
msgctxt "NpcYell:13373:0:13"
msgid "Marvelously done! Thank you."
msgstr "Отлично справились! Спасибо."

#. ja: なんてことだ…<br>モノセロスたちが…
#. de: Nanu! Die Monozerosse ...
#. fr: Oh non... Mes monocéros...
msgctxt "NpcYell:13374:0:13"
msgid "Oh, those poor monocerotes."
msgstr "Бедные мои моноцероты..."

#. ja: 頑張れ！<br>モノセロス…！
#. de: Ja, weiter so!
#. fr: Courage, monocéros<nbsp>!
msgctxt "NpcYell:13375:0:13"
msgid "Have courage, monocerotes!"
msgstr "Держитесь, моноцероты!"

#. ja: た、耐えてくれ…！
#. de: Halte durch!
#. fr: Tenez bon<nbsp>!
msgctxt "NpcYell:13376:0:13"
msgid "Do not give in!"
msgstr "Не сдавайтесь!"

#. ja: いかんッ！<br>吾輩の後ろへ！
#. de: Zurück! Hinter mir seid ihr sicher!
#. fr: Il prépare un effroyable assaut<nbsp>! Derrière moi, vite<nbsp>!
msgctxt "NpcYell:13377:0:13"
msgid "Get behind me!"
msgstr "За мной!"

#. ja: 貴様の一撃に賭ける！
#. de: Lege all deine Stärke in diesen Schlag!
#. fr: Nous comptons sur toi<nbsp>! Finis-le<nbsp>!
msgctxt "NpcYell:13378:0:13"
msgid "It's up to you, Fordola!"
msgstr "Всё зависит от твоего удара, Фордола!"

#. ja: くっ…思うように<br>身体が動かない…！
#. de: Argh! I-Ich kann mich nicht bewegen<nbsp>...!
#. fr: Argh... Mon corps ne m'obéit plus<nbsp>!
msgctxt "NpcYell:13379:0:13"
msgid "Gah... My limbs refuse to move!"
msgstr "Кх... Тело меня не слушается!"

#. ja: 英雄殿をお護りする……！
#. de: 0
#. fr: Je vais vous protéger<nbsp>!
msgctxt "NpcYell:13381:0:13"
msgid "0"
msgstr "Я буду защищать вас, досточтимый герой!"

#. ja: 祈りの力が満ちました……！
#. de: Erfüllt von der Kraft der Gebete!
#. fr: Mes prières ont fait effet<nbsp>! La puissance afflue<nbsp>!
msgctxt "NpcYell:13382:0:13"
msgid "My prayers have been heard!"
msgstr "Мои молитвы услышаны!"

#. ja: 六合貫く清らかな結界にて、
#. de: Die alles umfassende Reinheit des Hags!
#. fr: Par le pouvoir de la Lice cardinale...
msgctxt "NpcYell:13383:0:13"
msgid "May your embrace shield us..."
msgstr "Пусть объятия ваши защитят нас..."

#. ja: 森を侵す毒気を浄化せん！
#. de: Sie befreit den Wald vom Gift!
#. fr: De cette forêt, le poison, je purge<nbsp>!
msgctxt "NpcYell:13384:0:13"
msgid "...And cleanse the corruption from our home!"
msgstr "...И очистят наш дом от скверны!"

#. ja: 大精霊の祝福を！
#. de: O Gebieter, gib uns deinen Segen!
#. fr: Que les esprits vous bénissent<nbsp>!
msgctxt "NpcYell:13385:0:13"
msgid "By the grace of the elementals!"
msgstr "Благослови нас, о великие элементали!"

#. ja: ううっ……
#. de: Hrng<nbsp>...
#. fr: Huuugn...
msgctxt "NpcYell:13386:0:13"
msgid "Ugh..."
msgstr "Ух..."

#. ja: 効かぬ！
#. de: Ha!
#. fr: Oh que non<nbsp>!
msgctxt "NpcYell:13387:0:13"
msgid "It's no good!"
msgstr "Не выйдет!"

#. ja: 耐えてみせるッ！
#. de: Damit kriegst du mich nicht!
#. fr: Ça se passera pas comme ça<nbsp>!
msgctxt "NpcYell:13388:0:13"
msgid "We've got to weather the storm!"
msgstr "Мы должны выстоять!"

#. ja: そうはさせんぞッ！
#. de: So nicht!
#. fr: Tu ne feras de mal à personne, tu m'entends<nbsp>!?
msgctxt "NpcYell:13389:0:13"
msgid "We'll not fall so easily!"
msgstr "Мы так просто не падём!"

#. ja: いくぞ！
#. de: Los!
#. fr: C'est parti<nbsp>!
msgctxt "NpcYell:13390:0:13"
msgid "Watch yourselves!"
msgstr "Берегитесь!"

#. ja: ありがと～！<br>一緒に頑張ろうね！
#. de: Vielen Dank! Zusammen schaffen wir das!
#. fr: Sus à l'ennemi<nbsp>!
msgctxt "NpcYell:13391:0:13"
msgid "Much obliged! Now let's give those pesky blighters what for!"
msgstr "Благодарю! А теперь зададим этим мерзким тварям!"

#. ja: ピョンっといくぞ～！
#. de: Mach dich auf was gefasst, du Unding!
#. fr: Tu vas goûter au coup du lapin<nbsp>!
msgctxt "NpcYell:13392:0:13"
msgid "Hop to it now!"
msgstr "Ну-ка, подпрыгни!"

#. ja: フンフフーン！
#. de: Ha, ich mach dich eine Rübe kürzer!
#. fr: Et vlan, dans les dents<nbsp>!
msgctxt "NpcYell:13393:0:13"
msgid "Hrrrgrah!"
msgstr "Ррра!"

#. ja: イヒヒ…<br>これはなかなか…！
#. de: Kehehe ... faszinierend!
#. fr: Hé hé hé... Fascinant...
msgctxt "NpcYell:13394:0:13"
msgid "Ehehe... Splendid!"
msgstr "Хе-хе... Великолепно!"

#. ja: 違法改造を止めないと<br>大変なことになるよ！？
#. de: Ich sag's noch mal, lass die Finger von den Maschinen, bevor du uns alle in die Luft jagst!
#. fr: Comment ça, tu as reconfiguré des machines sans au<shy>to<shy>ri<shy>sa<shy>tion<nbsp>!?
msgctxt "NpcYell:13395:0:13"
msgid "How many malfunctions will it take for you to learn your lesson!?"
msgstr "Сколько ещё машин должно выйти из строя, чтобы ты усвоил урок?!"

#. ja: 持ちこたえるんだ！
#. de: Mit unerschütterlichem Willen.
#. fr: Nous devons tenir le coup<nbsp>!
msgctxt "NpcYell:13396:0:13"
msgid "We must stand our ground!"
msgstr "Нужно стоять на своём!"

#. ja: そこかッ！
#. de: Bei meiner Ehre!
#. fr: Approche un peu<nbsp>!
msgctxt "NpcYell:13397:0:13"
msgid "There!"
msgstr "Вот ты где!"

#. ja: さあ、たたみかけるぞ！
#. de: Das ist der Wille eines Ritters!
#. fr: Tu l'auras voulu<nbsp>!
msgctxt "NpcYell:13398:0:13"
msgid "This knight does not yield!"
msgstr "Этот рыцарь не отступит!"

#. ja: まさかエーテルが結晶化して<br>こんな姿になるなんて…！
#. de: Ich wusste nicht, dass Äther auf diese Weise kristallisieren kann.
#. fr: J'ignorais que l'éther pouvait se cristalliser de cette façon-là...
msgctxt "NpcYell:13399:0:13"
msgid "I've never seen anything like this!"
msgstr "Никогда такого не видел!"

#. ja: はやく解体しないと<br>管理局にどやされるぞ…
#. de: Ein Jammer, dass wir den Äther wieder freisetzen müssen.
#. fr: Je dois vite trouver une solution avant de me faire remonter les bretelles<nbsp>!
msgctxt "NpcYell:13400:0:13"
msgid "And I'd rather my superiors not see it at all, if you catch my drift..."
msgstr "И начальству лучше этого не показывать, если понимаете, о чём я..."

#. ja: ひぃぃ…恐ろしい！<br>配達ができないじゃないか！
#. de: Verdammte Dickhäuter! Wie soll ich da meine Lieferung überbringen?!
#. fr: Aaahhh<nbsp>! Mais comment je fais pour passer, moi<nbsp>?
msgctxt "NpcYell:13401:0:13"
msgid "Uwaaah! Did you see the way that gaja looked at me!? It wants me for supper!"
msgstr "У-уаа! Видели, как на меня глянул гая?! Он же хочет меня сожрать!"

#. ja: 浜辺のヴァルラス<br>また増えたな…
#. de: Es tauchen immer mehr dieser dicken Biester an der Küste auf ...
#. fr: Les vaalaras prolifèrent, ces derniers temps...
msgctxt "NpcYell:13402:0:13"
msgid "The beaches are overrun with those damn valras of late..."
msgstr "В последнее время пляжи кишат этими проклятыми вальрасами..."

#. ja: 漁に出られない…<br>どうしよう…
#. de: So fang ich keinen einzigen Fisch. Verdammt.
#. fr: Je ne peux même pas aller pêcher...
msgctxt "NpcYell:13403:0:13"
msgid "How am I supposed to go fishing with these blasted creatures about!? Am I doomed to starve to death?"
msgstr "Как тут вообще рыбачить с этими проклятыми тварями?! Неужто мне суждено умереть с голоду?"

#. ja: 大丈夫、大丈夫…
#. de: Alles wird gut ...
#. fr: Tout va bien...
msgctxt "NpcYell:13404:0:13"
msgid "Don't worry, we'll get out of this."
msgstr "Не волнуйтесь, мы выберемся."

#. ja: おにいちゃん…<br>こわい…
#. de: Ich habe solche Angst, Brüderchen ...
#. fr: J'ai peur<nbsp>!
msgctxt "NpcYell:13405:0:13"
msgid "B-Brother, I'm scared!"
msgstr "Б-братик, мне страшно!"

#. ja: まさか毒蛇の巣だなんて…
#. de: Au Backe! Ein Nest voller Giftschlangen!
#. fr: Un nid de serpents venimeux... Quelle guigne<nbsp>!
msgctxt "NpcYell:13406:0:13"
msgid "Bhujamga... Why did it have to be bhujamga?"
msgstr "Бхуджамги... Ну почему именно бхуджамги?"

#. ja: あの群れは<br>人食いだって噂の…！
#. de: Dieses Rudel frisst uns mit Haut und Haaren!
#. fr: Oh non<nbsp>! Les tigres mangeurs d'hommes<nbsp>!
msgctxt "NpcYell:13407:0:13"
msgid "Manusya have mercy, it's the man-eaters!"
msgstr "Манушья, помилуй, это же людоеды!"

#. ja: 今にも襲ってきそうだわ…
#. de: Sie sehen hungrig aus ...
#. fr: Ils ont l'air affamés...
msgctxt "NpcYell:13408:0:13"
msgid "They could attack at any moment... What are we going to do!?"
msgstr "Они вот-вот нападут... Что же нам делать?!"

#. ja: なんて愛らしさだ！
#. de: Oh, was für eine schöne Pflanze!
#. fr: Oh, quelles plantes ravissantes<nbsp>!
msgctxt "NpcYell:13409:0:13"
msgid "My, how adorable!"
msgstr "Ой, какие прелестные!"

#. ja: 植物かと思ったら…
#. de: Huch, das ist ja gar keine Pflanze!
#. fr: Euh... Tu es sûr que ce sont des plantes<nbsp>?
msgctxt "NpcYell:13410:0:13"
msgid "I thought those plants looked unfamiliar..."
msgstr "А я-то думал, это какие-то незнакомые растения..."

#. ja: ひえぇぇ…！<br>誰か手伝ってくれ…！
#. de: Hiiilfe!
#. fr: À l'aiiiide<nbsp>! Je suis arachnophobe<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13411:0:13"
msgid "Do I have one in my hair!?<br>Please, someone help!"
msgstr "У меня там паук в волосах!?<br>Кто-нибудь, помогите!"

#. ja: 必ず、耐えてみせるッ！
#. de: Ich werde keinen Schritt weichen!
#. fr: Je ne flancherai pas<nbsp>!
msgctxt "NpcYell:13412:0:13"
msgid "I will not falter!"
msgstr "Я не отступлю!"

#. ja: フォルタンの名にかけて！
#. de: Im Namen des Hauses Fortemps!
#. fr: Pour l'honneur des Fortemps<nbsp>!
msgctxt "NpcYell:13413:0:13"
msgid "For the honor of House Fortemps!"
msgstr "Во имя дома Форто!"

#. ja: ここならば…！
#. de: Jetzt ist die Gelegenheit!
#. fr: Maintenant<nbsp>!
msgctxt "NpcYell:13414:0:13"
msgid "Now!"
msgstr "Сейчас!"

#. ja: ぐっ…！
#. de: Ugh!
#. fr: Ugh...
msgctxt "NpcYell:13416:0:13"
msgid "Ugh!"
msgstr "Ух!"

#. ja: なんという威力…
#. de: Eine unglaubliche Kraft<nbsp>...
#. fr: Quelle puissance incommensurable...
msgctxt "NpcYell:13417:0:13"
msgid "Such power..."
msgstr "Вот это сила..."

#. ja: こちらはお任せを！
#. de: Hier übernehme ich!
#. fr: Laissez-moi faire<nbsp>!
msgctxt "NpcYell:13418:0:13"
msgid "Leave this to me!"
msgstr "Оставьте это мне!"

#. ja: ここで倒れるわけにはッ！
#. de: Wir werden siegreich bleiben!
#. fr: Nous résisterons jusqu'au bout<nbsp>!
msgctxt "NpcYell:13419:0:13"
msgid "We cannot fail!"
msgstr "Мы не можем проиграть!"

#. ja: お願い…<br>勝って…！
#. de: Ihr müsst ihn besiegen<nbsp>...
#. fr: Prrrenez garde<nbsp>!
msgctxt "NpcYell:13420:0:13"
msgid "He's quicker than he looks!"
msgstr "Он быстрее, чем кажется!"

#. ja: くっ…<br>なんて力なの…！
#. de: Ugh, welche Kraft!
#. fr: Il est tellement puissant<nbsp>!
msgctxt "NpcYell:13421:0:13"
msgid "What strength..."
msgstr "Какая сила..."

#. ja: フォルドラ…！<br>いけえぇぇぇぇ！
#. de: Los, Fordola!
#. fr: Vas-y, Forrrdola<nbsp>!
msgctxt "NpcYell:13422:0:13"
msgid "That's it, Fordola!"
msgstr "Вот так, Фордола!"

#. ja: 俺は信じてる…<br>あいつらは負けない！
#. de: Ich glaube an euch!
#. fr: Ils vaincront<nbsp>! Je crois en chacun d'eux<nbsp>!
msgctxt "NpcYell:13423:0:13"
msgid "They'll win, I know they will!"
msgstr "Они победят, я знаю!"

#. ja: 堪えてくれ…！
#. de: Haltet durch!
#. fr: Tenez bon<nbsp>!
msgctxt "NpcYell:13424:0:13"
msgid "You've got to hold on!"
msgstr "Держись!"

#. ja: カヌ・エ様…！<br>感謝いたします…！
#. de: Habt Dank, Älteste Saatseherin!
#. fr: Merci, Dame Kan-E-Senna<nbsp>!
msgctxt "NpcYell:13425:0:13"
msgid "Thank you, Elder Seedseer!"
msgstr "Благодарю вас, старшая провидица!"

#. ja: 覚悟なさい！
#. de: Mach dich bereit!
#. fr: Nous devons résister jusqu'au bout<nbsp>!
msgctxt "NpcYell:13426:0:13"
msgid "By the light of the Crystal!"
msgstr "Светом Кристалла!"

#. ja: 穢れを祓います！
#. de: Ich werde das Unreine säubern!
#. fr: Le mal doit être banni<nbsp>!
msgctxt "NpcYell:13427:0:13"
msgid "Begone with you!"
msgstr "Прочь отсюда!"

#. ja: 幻術皇の名のもとに！
#. de: Bei meiner Ehre als Saatseherin!
#. fr: Au nom des Oracles<nbsp>!
msgctxt "NpcYell:13428:0:13"
msgid "Wood's will be done!"
msgstr "Да свершится воля Леса!"

#. ja: うぐっ…<br>耐えてみせます…！
#. de: Hng<nbsp>... Ich lasse mich nicht unterkriegen!
#. fr: Ourgh... Il en faut plus pour me briser<nbsp>!
msgctxt "NpcYell:13429:0:13"
msgid "Ungh... I shall endure!"
msgstr "Ух... Я выдержу!"

#. ja: この程度の痛み…！
#. de: Diese Schmerzen halte ich schon noch aus!
#. fr: Je n'ai rien senti...<nbsp>!
msgctxt "NpcYell:13430:0:13"
msgid "I shall not kneel before your fury!"
msgstr "Не преклоню колен перед твоей яростью!"

#. ja: これしきのことで…！
#. de: War das schon alles?
#. fr: À peine une égratignure<nbsp>!
msgctxt "NpcYell:13431:0:13"
msgid "I have suffered much worse!"
msgstr "Я и не такое пережил!"

#. ja: くっ…そんな…！
#. de: Ah<nbsp>...! Das darf doch nicht<nbsp>...
#. fr: Ack<nbsp>! Impossible...<nbsp>!
msgctxt "NpcYell:13432:0:13"
msgid "No... This cannot be..."
msgstr "Нет... Не может быть..."

#. ja: くっ、身体が…<br>限界なのか…！
#. de: Aargh! Lange stehe ich das nicht mehr durch!
#. fr: Argh... Je suis à bout...<nbsp>!
msgctxt "NpcYell:13433:0:13"
msgid "Ugh... I cannot fight much longer..."
msgstr "Ух... Долго я не продержусь..."

#. ja: 早く逃げようよ…
#. de: Wir müssen hier weg!
#. fr: Dépêchons-nous de fuir<nbsp>!
msgctxt "NpcYell:13434:0:13"
msgid "We have to get away from here!"
msgstr "Надо убираться отсюда!"

#. ja: ど、どうしたの？
#. de: Was soll nur aus uns werden?
#. fr: Qu... qu'est-ce qui se passe<nbsp>?
msgctxt "NpcYell:13435:0:13"
msgid "What's wrong?"
msgstr "Что случилось?"

#. ja: お母さん…？
#. de: M-Mama?
#. fr: Maman...<nbsp>?
msgctxt "NpcYell:13436:0:13"
msgid "Mother?"
msgstr "Мама?"

#. ja: 無駄よ…何をしたって…<br>アアアアァァ！
#. de: Alles verloren<nbsp>... Es ist alles<nbsp>... Aaaaaah!
#. fr: Il n'y a plus rien à faire... Aaaahhhh<nbsp>!
msgctxt "NpcYell:13437:0:13"
msgid "It's hopeless! Hopeless!"
msgstr "Всё безнадёжно! Безнадёжно!"

#. ja: やだ、やだよぉ！<br>いやダアアアァァ！
#. de: Nein, ich will nicht! Ich<nbsp>... Aaaah!
#. fr: Non<nbsp>! Nooooooon<nbsp>!!!
msgctxt "NpcYell:13438:0:13"
msgid "No! No! Noooooo!"
msgstr "Нет! Нет! Не-е-ет!"

#. ja: 怖い、怖い、怖ィィィ！
#. de: Ich hab so schlimme Aaangst!
#. fr: J'ai peur<nbsp>!
msgctxt "NpcYell:13439:0:13"
msgid "Make it stop! Make it stop!"
msgstr "Хватит! Перестаньте!"

#. ja: お母さん、助けて…<br>カラダガァァァ…！
#. de: M-Mama?! N-Nein, du bist nicht meine Mama! Aaah<nbsp>... Aaaaah!
#. fr: Maman<nbsp>! Aide-moi<nbsp>! Mamaaaan<nbsp>!!!
msgctxt "NpcYell:13440:0:13"
msgid "Mother! I...I... Gaaahhhrrrgh! "
msgstr "Мама! Я... я... Гаааарррх!"

#. ja: まだ戦える…！
#. de: Ich bin noch nicht fertig<nbsp>...!
#. fr: J'en ai pas fini avec <if $gn4>elles<else>eux</if>...<nbsp>!
msgctxt "NpcYell:13441:0:13"
msgid "I'm just getting started!"
msgstr "Я только разогреваюсь!"

#. ja: 私にカルディアを！
#. de: Kardia, auf mich!
#. fr: Lancez Kardia surrr moi<nbsp>!
msgctxt "NpcYell:13442:0:13"
msgid "Grant me Kardion!"
msgstr "Дайте мне Кардион!"

#. ja: ぐっ、こんなときに<br>鎖死毒の激痛が…！
#. de: Argh! Dieses elende Gift!
#. fr: Guargh...<nbsp>! Maudit venin...<nbsp>!
msgctxt "NpcYell:13443:0:13"
msgid "Gah...! This bloody poison...!"
msgstr "Ах... Проклятый яд...!"

#. ja: アゥ…ウウウ…！
#. de: Uuuurgh<nbsp>...
#. fr: Aaah...<nbsp>!
msgctxt "NpcYell:13444:0:13"
msgid "Uhhh..."
msgstr "У-у-у..."

#. ja: ウ…ガァ…！
#. de: Argh<nbsp>...
#. fr: Nnnngh...<nbsp>!
msgctxt "NpcYell:13445:0:13"
msgid "Unnngh..."
msgstr "Н-нгх..."

#. ja: ア…アアアァ…！
#. de: Aaaah<nbsp>...
#. fr: Rhaaa...<nbsp>!
msgctxt "NpcYell:13446:0:13"
msgid "Aaargh..."
msgstr "А-а-а-а..."

#. ja: くっ…うう…！
#. de: Grnh<nbsp>...
#. fr: Oooh...
msgctxt "NpcYell:13447:0:13"
msgid "Ahhh!"
msgstr "А-а-а!"

#. ja: グッ…！
#. de: \<ächz>
#. fr: Argh<nbsp>!
msgctxt "NpcYell:13448:0:13"
msgid "\\<gasp>"
msgstr "<i>Гх!</i>"

#. ja: ハァ…ハァ…！
#. de: \<schnauf>
#. fr: Haaa... Haaa...
msgctxt "NpcYell:13449:0:13"
msgid "\\<pant> \\<pant>"
msgstr "<i>Ха... ха...</i>"

#. ja: 恩に着るぜ！
#. de: Besten Dank!
#. fr: On te doit une fière chandelle<nbsp>!
msgctxt "NpcYell:13450:0:13"
msgid "I owe you!"
msgstr "Я твой должник!"

#. ja: 助かった…！
#. de: Mein Kopf ist wieder frei!
#. fr: Enfin libre...<nbsp>!
msgctxt "NpcYell:13451:0:13"
msgid "My thanks!"
msgstr "Спасибо!"

#. ja: 恒久平和のため<br>消えてください…
#. de: Alles Leben muss für den wahren Frieden sterben.
#. fr: Disparaissez. Pour le plus grand bien.
msgctxt "NpcYell:13452:0:13"
msgid "Your compliance is not a factor."
msgstr "Ваше согласие нас не интересует."

#. ja: 有機知生体は<br>不要と判断されました…
#. de: Intelligentes Leben ist als unnötig kategorisiert. Exterminierung empfohlen.
#. fr: Votre existence a été jugée incompatible avec notre idéal de paix.
msgctxt "NpcYell:13453:0:13"
msgid "Executing peace protocol. Commencing extermination."
msgstr "Запуск протокола мира. Начинаем уничтожение."

#. ja: そこだ、いけっ！
#. de: Fliegt!
#. fr: Allez<nbsp>! En avant<nbsp>!
msgctxt "NpcYell:13454:0:13"
msgid "There!"
msgstr "Вот!"

#. ja: 邪魔はさせないっ！
#. de: Nicht mit mir!
#. fr: Je ne te laisserai pas faire<nbsp>!
msgctxt "NpcYell:13455:0:13"
msgid "You cannot stop us!"
msgstr "Не позволю вам мешать!"

#. ja: 私にも、見えるっ！
#. de: Ich seh es ganz deutlich!
#. fr: Je vois clair à travers tes défenses<nbsp>!
msgctxt "NpcYell:13456:0:13"
msgid "An opening!"
msgstr "Вот брешь!"

#. ja: 魔力を集中させる！
#. de: Magiefokussierung!
#. fr: Je vais concentrer toute mon énergie<nbsp>!
msgctxt "NpcYell:13457:0:13"
msgid "We mustn't hold back!"
msgstr "Не сдерживайтесь!"

#. ja: 賢学の叡智よ、ここにっ！
#. de: Weisheit, erfülle mich!
#. fr: À moi, le savoir ancestral des Sages<nbsp>!
msgctxt "NpcYell:13458:0:13"
msgid "You'll not escape this!"
msgstr "Отсюда вам не уйти!"

#. ja: 賢具（けんぐ）展開、今だっ！
#. de: Aktiviere die Noulithen!
#. fr: Noulithes<nbsp>! Déployez-vous<nbsp>!
msgctxt "NpcYell:13459:0:13"
msgid "Now!"
msgstr "Сейчас!"

#. ja: 大丈夫かい？
#. de: Alles in Ordnung?
#. fr: Tout va bien<nbsp>?
msgctxt "NpcYell:13460:0:13"
msgid "Are you all right?"
msgstr "Ты в порядке?"

#. ja: 治癒なら任せてくれ！
#. de: Das Heilen übernehme ich!
#. fr: Je m'occupe des soins<nbsp>!
msgctxt "NpcYell:13461:0:13"
msgid "I have you!"
msgstr "Я тебя вылечу!"

#. ja: さあ、立て直そう！
#. de: Los, auf ein Neues!
#. fr: Allez, debout<nbsp>! On ne peut pas abandonner.
msgctxt "NpcYell:13462:0:13"
msgid "We must stay strong!"
msgstr "Ну же, соберёмся!"

#. ja: 支えてみせる！
#. de: Ich stehe dir bei!
#. fr: Je suis là<nbsp>!
msgctxt "NpcYell:13463:0:13"
msgid "Keep it up!"
msgstr "Я тебя поддержу!"

#. ja: ともにいこう！
#. de: Gemeinsam sind wir stark!
#. fr: Toujours là pour aider<nbsp>!
msgctxt "NpcYell:13464:0:13"
msgid "We can do this!"
msgstr "Вместе справимся!"

#. ja: この力、信じてくれ！
#. de: Vertrau meiner Kraft!
#. fr: On peut toujours compter sur moi<nbsp>!
msgctxt "NpcYell:13465:0:13"
msgid "Just a little more!"
msgstr "Поверь в мою силу!"

#. ja: 受け継いだ、この賢具（けんぐ）があれば！生命（いのち）よ、湧き上がれ！
#. de: Kraft meiner Noulithen: Sprudelndes Leben!
#. fr: En avant, noulithes<nbsp>! Allez raviver l'énergie de tous<nbsp>!
msgctxt "NpcYell:13466:0:13"
msgid "We've come too far to fall short here!"
msgstr "Мы зашли слишком далеко, чтобы сейчас сдаться!"

#. ja: いきなさい！
#. de: Los!
#. fr: À toi, fidèle compagnon<nbsp>!
msgctxt "NpcYell:13467:0:13"
msgid "Go forth!"
msgstr "Вперёд!"

#. ja: 逃しません！
#. de: Es gibt kein Entkommen!
#. fr: N'espère pas fuir<nbsp>!
msgctxt "NpcYell:13468:0:13"
msgid "Begone!"
msgstr "Не уйдёте!"

#. ja: させません！
#. de: Das lass ich nicht zu!
#. fr: Hors de question<nbsp>!
msgctxt "NpcYell:13469:0:13"
msgid "Enough!"
msgstr "Не позволю!"

#. ja: 琥珀（こはく）の知恵を！
#. de: Weisheit des Bernsteins!
#. fr: La sagesse dans l'ambre<nbsp>!
msgctxt "NpcYell:13470:0:13"
msgid "Behold, amber brilliance!"
msgstr "Во имя мудрости янтаря!"

#. ja: 巴術（はじゅつ）の応用です！
#. de: Kraft der Hermetik!
#. fr: Des applications de l'arcanisme<nbsp>!
msgctxt "NpcYell:13471:0:13"
msgid "My magicks are without peer!"
msgstr "Вот что умеет арканистика!"

#. ja: 我が使い魔の力です
#. de: Dies ist die Kraft meines Familiars!
#. fr: Mon familier n'est pas en reste.
msgctxt "NpcYell:13472:0:13"
msgid "'Tis a most fearsome familiar."
msgstr "Такова сила моего фамильяра."

#. ja: 癒やしの力を、あなたに・・・
#. de: Mögest du Heilung erfahren!
#. fr: Que ces soins vous apaisent...
msgctxt "NpcYell:13473:0:13"
msgid "Art thou hurt?"
msgstr "Тебе больно?"

#. ja: いかがですか？
#. de: Ist es so besser?
#. fr: Comment vous sentez-vous<nbsp>?
msgctxt "NpcYell:13474:0:13"
msgid "Hold steady."
msgstr "Держись."

#. ja: どうぞご安心を・・・
#. de: Hab keine Angst ...
#. fr: Ne craignez rien, je suis là.
msgctxt "NpcYell:13475:0:13"
msgid "Be at ease, my friend."
msgstr "Не бойся, друг мой."

#. ja: 支援いたします
#. de: Lass mich dir helfen!
#. fr: Je suis avec vous.
msgctxt "NpcYell:13476:0:13"
msgid "I shall assist thee."
msgstr "Я помогу тебе."

#. ja: これも計略のうち・・・
#. de: Es läuft alles nach Plan!
#. fr: Voilà qui devrait être utile.
msgctxt "NpcYell:13477:0:13"
msgid "Let us not falter."
msgstr "Не будем отступать."

#. ja: 準備万端です
#. de: Ich bin bereit!
#. fr: Nous voilà prêts avec ça.
msgctxt "NpcYell:13478:0:13"
msgid "Have care, my friend."
msgstr "Осторожнее, друг мой."

#. ja: 石となりし命よ・・・琥珀色の星となりて、降り注げ！
#. de: Steingewordenes Leben! Regne als güldene Sterne herab!
#. fr: Ô gemme à l'éclat de vie... Transforme-toi en une pluie d'astres couleur ambre<nbsp>!
msgctxt "NpcYell:13479:0:13"
msgid "A shower of amber to lay low my foes!"
msgstr "Жизнь, обращённая в камень... Стань янтарными звёздами и обрушься на врагов!"

#. ja: 正念場だな・・・！
#. de: Jetzt kommt's drauf an!
#. fr: Le tout pour le tout<nbsp>!
msgctxt "NpcYell:13480:0:13"
msgid "This can't end here..."
msgstr "Это не может закончиться вот так..."

#. ja: 押されているのか！？
#. de: Ist das schon alles?
#. fr: Pas le moment de flancher...
msgctxt "NpcYell:13481:0:13"
msgid "Is that all you've got."
msgstr "И это всё, на что ты способен?"

#. ja: やってやるさ・・・！
#. de: Das ist längst nicht das Ende!
#. fr: Je suis encore debout<nbsp>!
msgctxt "NpcYell:13482:0:13"
msgid "You've not won yet!"
msgstr "Ты ещё не победил!"

#. ja: 悪い、助かった・・・
#. de: Danke. Das fühlt sich schon besser an.
#. fr: Merci pour le coup de pouce<nbsp>!
msgctxt "NpcYell:13483:0:13"
msgid "My thanks..."
msgstr "Спасибо..."

#. ja: 反撃開始だ・・・！
#. de: Oh, süße Rache!
#. fr: C'est l'heure de la contre-attaque<nbsp>!
msgctxt "NpcYell:13484:0:13"
msgid "They'll pay for that."
msgstr "Вы за это заплатите..."

#. ja: 覚悟しておけよ・・・！
#. de: Jetzt geht's dem Feind an den Kragen!
#. fr: Maintenant, vous allez souffrir<nbsp>!
msgctxt "NpcYell:13485:0:13"
msgid "Back to the fray!"
msgstr "Возвращаемся в бой!"

#. ja: 蹴散らすぞ！
#. de: Ein Trittchen in Ehren!
#. fr: Voilà ta raclée<nbsp>!
msgctxt "NpcYell:13486:0:13"
msgid "Fall!"
msgstr "Падай!"

#. ja: 串刺しだ！
#. de: Gegner am Spieß!
#. fr: Tu vas faire une belle brochette<nbsp>!
msgctxt "NpcYell:13487:0:13"
msgid "This will hurt!"
msgstr "Будет больно!"

#. ja: 見くびるなよ！
#. de: Unterschätz mich nicht!
#. fr: Prends ça dans les dents<nbsp>!
msgctxt "NpcYell:13488:0:13"
msgid "You underestimate me!"
msgstr "Не недооценивай меня!"

#. ja: これでも竜騎士なんでね！
#. de: Mit Drachenreitern ist nicht zu spaßen!
#. fr: Par la colère du Dragon céleste<nbsp>!
msgctxt "NpcYell:13489:0:13"
msgid "You're mine!"
msgstr "Ты мой!"

#. ja: 悪いが、始末するッ！
#. de: So langsam reicht es!
#. fr: Crève, charogne<nbsp>!
msgctxt "NpcYell:13490:0:13"
msgid "Time to end this!"
msgstr "Пора с этим покончить!"

#. ja: この身に受けた血に誓って・・・！
#. de: Bei meinem Drachenblut!
#. fr: Mon sang bout dans mes veines... Yaaah<nbsp>!!
msgctxt "NpcYell:13491:0:13"
msgid "All or nothing!"
msgstr "Всё или ничего!"

#. ja: そらよ・・・！
#. de: Hier!
#. fr: Et hop<nbsp>!
msgctxt "NpcYell:13492:0:13"
msgid "Up, up!"
msgstr "Держи!"

#. ja: 大丈夫か？
#. de: Geht's?
#. fr: Ça va<nbsp>?
msgctxt "NpcYell:13493:0:13"
msgid "Are you all right?"
msgstr "Ты в порядке?"

#. ja: しっかりしろ！
#. de: Nicht schlappmachen!
#. fr: Tiens bon<nbsp>!
msgctxt "NpcYell:13494:0:13"
msgid "We're not done here."
msgstr "Держись! Мы ещё не закончили."

#. ja: やってやろうぜ！
#. de: Wir schaffen das!
#. fr: Je vais vous montrer ma puissance<nbsp>!
msgctxt "NpcYell:13495:0:13"
msgid "Hang in there!"
msgstr "Ну, покажем им!"

#. ja: 任せておけ！
#. de: Verlass dich auf mich!
#. fr: Laissez-moi faire<nbsp>!
msgctxt "NpcYell:13496:0:13"
msgid "Courage!"
msgstr "Положись на меня!"

#. ja: 合わせてみせるさ・・・！
#. de: Mit vereinten Kräften!
#. fr: On va leur faire regretter d'être nés<nbsp>!
msgctxt "NpcYell:13497:0:13"
msgid "Stay strong!"
msgstr "Держитесь!"

#. ja: 咆えろ、魔槍（まそう）ニーズヘッグッ！
#. de: Nidhogg, schenk mir deine Kraft!
#. fr: Entendez rugir la lance de Nidhogg<nbsp>!
msgctxt "NpcYell:13498:0:13"
msgid "Roar, Nidhogg! Roar!"
msgstr "Реви, Нидхёгг! Реви!"

#. ja: やりましたね・・・！
#. de: Beeindruckend ...
#. fr: Pas mal...<nbsp>!
msgctxt "NpcYell:13499:0:13"
msgid "Quite..."
msgstr "Вот это да..."

#. ja: この程度・・・！
#. de: Das ist gar nichts.
#. fr: Je tiens encore...<nbsp>!
msgctxt "NpcYell:13500:0:13"
msgid "This is nothing."
msgstr "Ерунда!"

#. ja: なんてザマなの・・・
#. de: Was für ein klägliches Bild!
#. fr: Quelle débâcle...
msgctxt "NpcYell:13501:0:13"
msgid "A poor showing..."
msgstr "Ну и жалкое зрелище..."

#. ja: 失礼しました、挽回します
#. de: Ich mache das wieder gut!
#. fr: Merci, je vais reprendre mes forces<nbsp>!
msgctxt "NpcYell:13502:0:13"
msgid "I will do better."
msgstr "Прошу прощения. Я исправлюсь."

#. ja: まだ、負けではありません
#. de: Noch ist es nicht vorbei!
#. fr: Je n'ai pas dit mon dernier mot<nbsp>!
msgctxt "NpcYell:13503:0:13"
msgid "It isn't over yet."
msgstr "Это ещё не конец."

#. ja: お返ししないといけませんね
#. de: Ich stehe in deiner Schuld!
#. fr: C'est l'heure de la revanche<nbsp>!
msgctxt "NpcYell:13504:0:13"
msgid "I'm in your debt."
msgstr "Я у тебя в долгу."

#. ja: 突破します！
#. de: Zum Angriff!
#. fr: Je perce<nbsp>!
msgctxt "NpcYell:13505:0:13"
msgid "Have at you!"
msgstr "Прорываюсь!"

#. ja: これならどうです？
#. de: Wie ist es hiermit?
#. fr: Que dis-tu de ça<nbsp>?
msgctxt "NpcYell:13506:0:13"
msgid "Have a taste!"
msgstr "Ну как тебе это?"

#. ja: 行きますよ・・・！
#. de: Kraft der Magie!
#. fr: Et c'est parti<nbsp>!
msgctxt "NpcYell:13507:0:13"
msgid "Prepare yourself!"
msgstr "Приготовься!"

#. ja: 斬り分かつ！
#. de: Spaltendes Schwert!
#. fr: Je vais te pourfendre<nbsp>!
msgctxt "NpcYell:13508:0:13"
msgid "My blade sings!"
msgstr "Мой клинок поёт!"

#. ja: 容赦はしません！
#. de: Kein Erbarmen!
#. fr: Je serai implacable<nbsp>!
msgctxt "NpcYell:13509:0:13"
msgid "No quarter!"
msgstr "Пощады не будет!"

#. ja: だったら薙ぎ払うまで・・・！
#. de: Bis zum bitteren Ende!
#. fr: Aux grands maux, les grands remèdes<nbsp>!
msgctxt "NpcYell:13510:0:13"
msgid "Can you withstand this?"
msgstr "Ну-ка, выдержишь?"

#. ja: さあ、目を開けて・・・
#. de: Öffne deine Augen.
#. fr: Ouvre grand les yeux...
msgctxt "NpcYell:13511:0:13"
msgid "Open your eyes, now."
msgstr "Открой глаза. Сейчас же."

#. ja: 大丈夫・・・
#. de: Alles wird gut.
#. fr: Tout va bien...
msgctxt "NpcYell:13512:0:13"
msgid "I will tend your wounds."
msgstr "Я залечу твои раны."

#. ja: まだ降参じゃないでしょう？
#. de: Du wirst noch gebraucht.
#. fr: Il est trop tôt pour capituler.
msgctxt "NpcYell:13513:0:13"
msgid "Your journey isn't over yet."
msgstr "Твой путь ещё не окончен."

#. ja: 加護を・・・
#. de: Ich beschütze dich.
#. fr: Bénédiction...
msgctxt "NpcYell:13514:0:13"
msgid "Stand firm."
msgstr "Держись."

#. ja: 導きを・・・
#. de: Nicht aufgeben.
#. fr: Que s'ouvre la voie...
msgctxt "NpcYell:13515:0:13"
msgid "Stay the course."
msgstr "Не сворачивай с пути."

#. ja: 考えがあります
#. de: Vielleicht hilft das.
#. fr: Prenons l'avantage.
msgctxt "NpcYell:13516:0:13"
msgid "Mayhap this will help."
msgstr "Может, это поможет."

#. ja: 護れ、命満つる全ての子らを！
#. de: Der Tod soll noch niemanden holen!
#. fr: Que vos vies soient préservées<nbsp>!
msgctxt "NpcYell:13517:0:13"
msgid "Let Death's judgment be stayed!"
msgstr "Пусть Смерть не вершит свой суд!"

#. ja: キック？<br>いいえ、これで十分！
#. de: Das hier ist viel besser!
#. fr: Aller au corps-à-corps<nbsp>? Pour quoi faire<nbsp>?
msgctxt "NpcYell:13518:0:13"
msgid "Rend? Nay, this shall more than suffice."
msgstr "Растерзание? Да и этого хватит с лихвой."

#. ja: 死に裁かれし全ての子らよ・・・
#. de: Das Leben soll sprudeln!
#. fr: Échappez aux griffes de la mort...
msgctxt "NpcYell:13519:0:13"
msgid "Let Life flow ever abundant!"
msgstr "Пусть жизнь бьёт ключом!"

#. ja: だから厭なんだ・・・！
#. de: Wie ich so was hasse ...
#. fr: Je savais que ça finirait mal...
msgctxt "NpcYell:13520:0:13"
msgid "Another fine mess..."
msgstr "Ну вот, опять..."

#. ja: やってくれる・・・
#. de: Ganz schön zäh ...
#. fr: Quelle teigne...
msgctxt "NpcYell:13521:0:13"
msgid "This is going swimmingly..."
msgstr "Ну и живучий..."

#. ja: 回復をよこせ・・・！
#. de: Könnt 'ne Heilung vertragen! Schnell!
#. fr: J'ai besoin de soins<nbsp>!
msgctxt "NpcYell:13522:0:13"
msgid "Would someone hurry up and heal me!?"
msgstr "Да кто-нибудь, поторопитесь меня вылечить!"

#. ja: 私にも面目があるのでな
#. de: Ich? Bezwungen?!
#. fr: Il est temps de laver cet affront...
msgctxt "NpcYell:13523:0:13"
msgid "I do have an image to uphold."
msgstr "Мне ещё лицо терять нельзя."

#. ja: さて、借りを返そうか
#. de: Jetzt erst recht!
#. fr: Une dette de plus dont je vais devoir m'acquitter...
msgctxt "NpcYell:13524:0:13"
msgid "Time to repay the debt."
msgstr "Пора возвращать долги."

#. ja: 遅い、だが悪くない選択だ
#. de: Besser zu spät als nie, was?
#. fr: Excellente décision, quoique tardive...
msgctxt "NpcYell:13525:0:13"
msgid "Slow. A sound choice, but slow."
msgstr "Поздно. Но выбор верный."

#. ja: 邪魔だ、散れ！
#. de: Aus dem Weg, Gesindel.
#. fr: Hors de mon chemin<nbsp>!
msgctxt "NpcYell:13526:0:13"
msgid "Begone!"
msgstr "Прочь с дороги!"

#. ja: 呑み込め・・・！
#. de: Friss das! Der Äther ist mit mir!
#. fr: Voilà pour toi<nbsp>!
msgctxt "NpcYell:13527:0:13"
msgid "Mine is the aether!"
msgstr "Эфир мой!"

#. ja: 制圧しろ
#. de: In den Staub!
#. fr: Sus à l'ennemi<nbsp>!
msgctxt "NpcYell:13528:0:13"
msgid "Fall!"
msgstr "Падай!"

#. ja: 薙ぎ払う！
#. de: Zieht Leine!
#. fr: Je vais faucher ta vie<nbsp>!
msgctxt "NpcYell:13529:0:13"
msgid "Down with you!"
msgstr "Получай!"

#. ja: 吹き飛べ！
#. de: Und tschüs!
#. fr: Arrière, vermine<nbsp>!
msgctxt "NpcYell:13530:0:13"
msgid "Out of my way!"
msgstr "Прочь с пути!"

#. ja: 私を誰だと思っている
#. de: Mit mir ist nicht zu spaßen!
#. fr: À qui crois-tu avoir affaire<nbsp>?
msgctxt "NpcYell:13531:0:13"
msgid "Do not underestimate me."
msgstr "Не недооценивай меня."

#. ja: 着実にいくぞ
#. de: Was wär die Welt nur ohne mich?
#. fr: Pas de pré<shy>ci<shy>pi<shy>ta<shy>tion.
msgctxt "NpcYell:13532:0:13"
msgid "Steady, now."
msgstr "Спокойно. Без спешки."

#. ja: 世話の焼ける・・・
#. de: Pass besser auf!
#. fr: Toujours les mêmes qui ont besoin d'aide...
msgctxt "NpcYell:13533:0:13"
msgid "What a bother..."
msgstr "Ну и хлопотно же с тобой..."

#. ja: キリキリ働け
#. de: Stirb mir nicht weg.
#. fr: Allez, du nerf<nbsp>!
msgctxt "NpcYell:13534:0:13"
msgid "Look alive."
msgstr "Живее!"

#. ja: 厄介だな・・・だが・・・！
#. de: Na gut, wenn's sein muss ...
#. fr: Bon, soyons généreux...
msgctxt "NpcYell:13535:0:13"
msgid "Oh, very well..."
msgstr "Ладно уж..."

#. ja: 策を示す、わかったな？
#. de: Auf mein Zeichen, alles klar?
#. fr: On va dire que ça fait partie du plan...
msgctxt "NpcYell:13536:0:13"
msgid "Pay attention, now."
msgstr "Слушай внимательно."

#. ja: あとは好きにするがいい
#. de: Mach was draus.
#. fr: Tiens. Débrouille-toi pour la suite.
msgctxt "NpcYell:13537:0:13"
msgid "Don't waste this."
msgstr "Смотри не растрать впустую."

#. ja: 我が銘（な）に懸けて、一切を葬らん
#. de: Bei meinem wahren Namen - vollkommene Vernichtung!
#. fr: Goûte au courroux du Maître des Enfers<nbsp>!
msgctxt "NpcYell:13538:0:13"
msgid "By my true name, I shall consign all."
msgstr "Клянусь истинным именем: я предам всё забвению."

#. ja: 我が座に懸けて、一切を護らん
#. de: Bei meinem Amte - vollkommener Schutz!
#. fr: Moi, Emet-Selch, vous couvre de mon égide<nbsp>!
msgctxt "NpcYell:13539:0:13"
msgid "On my seat's honor, I shall protect all."
msgstr "Клянусь своим престолом: я защищу всех."

#. ja: これは・・・マズいかも・・・
#. de: Nicht ganz nach Plan ...
#. fr: Ça commence à sentir mauvais...
msgctxt "NpcYell:13540:0:13"
msgid "Not quite as planned..."
msgstr "Что-то пошло не по плану..."

#. ja: 厳しいなぁ・・・
#. de: Es ging mir schon besser ...
#. fr: Ça se présente mal...
msgctxt "NpcYell:13541:0:13"
msgid "I've had better days..."
msgstr "Бывало и получше..."

#. ja: あの・・・治して・・・？
#. de: Kann mich bitte jemand heilen?
#. fr: Des soins<nbsp>? Quelqu'un<nbsp>?
msgctxt "NpcYell:13542:0:13"
msgid "Some healing, if you would?"
msgstr "Не могли бы вы меня подлечить?"

#. ja: 無茶は見てるにかぎるんだけど・・・！
#. de: Das wär doch nicht nötig gewesen ...
#. fr: Je préfère quand ce sont les autres qui dégustent<nbsp>!
msgctxt "NpcYell:13543:0:13"
msgid "You shouldn't have─no, really."
msgstr "Не стоило... нет, правда."

#. ja: ええ・・・休憩おわり・・・？
#. de: Nanu? Die Pause ist schon vorbei?
#. fr: Hmm... La sieste est finie<nbsp>?
msgctxt "NpcYell:13544:0:13"
msgid "What? Already?"
msgstr "Что, уже всё?"

#. ja: ありがと、さてここからだ！
#. de: Danke! Wo waren wir stehen<shy>geblieben?
#. fr: Bien, repartons du bon pied<nbsp>!
msgctxt "NpcYell:13545:0:13"
msgid "Well, back to it, I suppose."
msgstr "Ну что ж, пора за дело."

#. ja: これはどうかな？
#. de: Na, wie ist das?
#. fr: Que dis-tu de ça<nbsp>?
msgctxt "NpcYell:13546:0:13"
msgid "What do you think of this?"
msgstr "Ну как тебе?"

#. ja: 弱点は視えてるよ！
#. de: Ich weiß um deine Schwächen!
#. fr: Je vois son point faible<nbsp>!
msgctxt "NpcYell:13547:0:13"
msgid "I see you, opening!"
msgstr "Вижу брешь!"

#. ja: 上手くいくかな・・・！
#. de: Hoffentlich klappt das!
#. fr: J'espère que ça va marcher...
msgctxt "NpcYell:13548:0:13"
msgid "Hope this works!"
msgstr "Надеюсь, сработает!"

#. ja: イデア展開、生まれいでよ
#. de: Schöpferische Kräfte!
#. fr: Place aux idées<nbsp>!
msgctxt "NpcYell:13549:0:13"
msgid "From concept to creation!"
msgstr "Из замысла — в явь!"

#. ja: ダメだよ、邪魔しちゃ
#. de: Ich kann das leider nicht zulassen.
#. fr: Ce n'est pas bien de nous enquiquiner<nbsp>!
msgctxt "NpcYell:13550:0:13"
msgid "Now, now, it's rude to interrupt."
msgstr "Ну-ну, перебивать невежливо."

#. ja: ワタシもこのくらいは、ね
#. de: Ein bisschen was kann ich auch!
#. fr: Moi aussi, je peux briller, parfois<nbsp>!
msgctxt "NpcYell:13551:0:13"
msgid "I'm not entirely useless."
msgstr "Я тоже кое-что умею."

#. ja: ほら、がんばって！
#. de: Hier, halt durch!
#. fr: Un peu de courage<nbsp>!
msgctxt "NpcYell:13552:0:13"
msgid "As you were."
msgstr "Давай, держись!"

#. ja: うわー、大丈夫？
#. de: Geht's noch?
#. fr: Ça va, tu tiens le coup<nbsp>?
msgctxt "NpcYell:13553:0:13"
msgid "Are you all right?"
msgstr "Ты в порядке?"

#. ja: 痛くない、痛くない・・・
#. de: Gleich geht's dir besser.
#. fr: C'est juste un petit bobo...
msgctxt "NpcYell:13554:0:13"
msgid "Pain, pain, go away."
msgstr "Боль-боль, уходи."

#. ja: おもしろそう！
#. de: Ja, das ist gut!
#. fr: C'est l'heure de s'amuser<nbsp>!
msgctxt "NpcYell:13555:0:13"
msgid "Ooh, interesting!"
msgstr "О, занятно!"

#. ja: 提案があるんだけど・・・
#. de: Ich hätte da einen Vorschlag ...
#. fr: Soyons fins stratèges...
msgctxt "NpcYell:13556:0:13"
msgid "I have a proposal."
msgstr "У меня есть предложение..."

#. ja: 創り出そうか
#. de: Bastelstunde!
#. fr: Et si je fabriquais quelque chose<nbsp>?
msgctxt "NpcYell:13557:0:13"
msgid "Let's make a little something."
msgstr "Давай кое-что смастерим."

#. ja: ああもう、そこでワタシに任せる！？
#. de: Einfach mal mir überlassen!
#. fr: Tout le monde compte sur moi<nbsp>!? Eh bien dans ce cas...<nbsp>!
msgctxt "NpcYell:13558:0:13"
msgid "Who? Me!? You can't be serious..."
msgstr "Кто? Я?! Вы серьёзно?.."

#. ja: 生き残りの住民か！？
#. de: Gibt es Überlebende?!
#. fr: Y a-t-il des survivants<nbsp>?
msgctxt "NpcYell:13559:0:13"
msgid "Survivors?"
msgstr "Выжившие?"

#. ja: いや、待て…！<br>様子がおかしい…！
#. de: Wartet! Irgendwas stimmt hier ganz und gar nicht<nbsp>...
#. fr: Attendez... C'est bizarre...
msgctxt "NpcYell:13560:0:13"
msgid "No, wait. Something's amiss."
msgstr "Нет, постойте. Тут что-то не так."

#. ja: なんてことだ…
#. de: Was zum<nbsp>...
#. fr: Quelle horreur...
msgctxt "NpcYell:13561:0:13"
msgid "Good gods..."
msgstr "Боги милостивые..."

#. ja: 生存者だ…！<br>助けよう！
#. de: Schnell, wir müssen helfen!
#. fr: Il faut les sauver<nbsp>!
msgctxt "NpcYell:13562:0:13"
msgid "Get them to safety!"
msgstr "Нужно увести их в безопасное место!"

#. ja: まってくれ！<br>落ち着いてくれ！！
#. de: So wartet doch!
#. fr: Du calme, du calme<nbsp>!
msgctxt "NpcYell:13563:0:13"
msgid "You must remain calm!"
msgstr "Прошу, сохраняйте спокойствие!"

#. ja: ああ…
#. de: Nein<nbsp>...!
#. fr: Oh non... C'est terrible...
msgctxt "NpcYell:13564:0:13"
msgid "No..."
msgstr "Нет..."

#. ja: 見て！<br>生存者よ！
#. de: Seht, da lebt noch jemand!
#. fr: Regardez, des rescapés<nbsp>!
msgctxt "NpcYell:13565:0:13"
msgid "Look, over there!"
msgstr "Смотрите, вон там!"

#. ja: ダメよ！<br>まって、ダメ！！
#. de: Nein, nicht! Haltet ein!
#. fr: Non, arrête<nbsp>! Ne fais pas ça<nbsp>!
msgctxt "NpcYell:13566:0:13"
msgid "Please, hold on!"
msgstr "Пожалуйста, держись!"

#. ja: こんなの…<br>こんなのって！！
#. de: Das darf doch nicht sein!
#. fr: Mais qu'est-ce qui se passe...<nbsp>!?
msgctxt "NpcYell:13567:0:13"
msgid "Is there nothing we can do!?"
msgstr "Неужели мы ничего не можем сделать?!"

#. ja: これは…エーテルの輝きが<br>失われてゆく！？
#. de: Ihr Ätherschein ... Weshalb ist er verglüht?
#. fr: Ils... Ils perdent la lumière de leur éther<nbsp>!
msgctxt "NpcYell:13568:0:13"
msgid "The aether is dissipating!"
msgstr "Эфир рассеивается!"

#. ja: 連鎖が始まるわ！<br>備えなさい！
#. de: Eine Kettenreaktion ist unausweichlich. Macht euch bereit!
#. fr: Tenez-vous prêts, ça risque de faire une réaction en chaîne<nbsp>!
msgctxt "NpcYell:13569:0:13"
msgid "The change is spreading!"
msgstr "Перемены распространяются!"

#. ja: これが、終末…
#. de: Die Letzten Tage ...
#. fr: C'est... l'apocalypse...
msgctxt "NpcYell:13570:0:13"
msgid "All is in disarray..."
msgstr "Всё вокруг рушится..."

#. ja: 子供たちが！
#. de: Kinder! Und unversehrt!
#. fr: Ils ont l'airrr sains et saufs<nbsp>!
msgctxt "NpcYell:13571:0:13"
msgid "We've got to protect them!"
msgstr "Надо защитить детей!"

#. ja: 正気をたもて！<br>助けにきたんだ！
#. de: Habt keine Angst, wir sind hier um euch zu retten!
#. fr: Rrrestez calmes, on vient vous sauver<nbsp>!
msgctxt "NpcYell:13572:0:13"
msgid "We're here to help!"
msgstr "Мы пришли помочь!"

#. ja: 親が…子を…<br>くそっ！！
#. de: Nein<nbsp>... Das eigene Fleisch und Blut!
#. fr: Il a... son propre enfant... Borrrdel<nbsp>!
msgctxt "NpcYell:13573:0:13"
msgid "I can't believe what I'm seeing..."
msgstr "Не могу поверить своим глазам..."

#. ja: …ッ！
#. de: Grnh<nbsp>...
#. fr: ...<nbsp>!
msgctxt "NpcYell:13574:0:13"
msgid "Look out!"
msgstr "Берегись!"

#. ja: 何かがおかしい…<br>警戒を怠るな！
#. de: Bleibt wachsam. Ich habe ein ungutes Gefühl.
#. fr: Ça sent pas bon... Restez sur vos gardes<nbsp>!
msgctxt "NpcYell:13575:0:13"
msgid "Be on your guard."
msgstr "Будьте начеку."

#. ja: ……
#. de: ... ...
#. fr: ...
msgctxt "NpcYell:13576:0:13"
msgid "..."
msgstr "..."

#. ja: …悪いが、やらせてもらうぞ！
#. de: Uns bleibt keine andere Wahl!
#. fr: Pardon, mais je n'ai pas le choix<nbsp>!
msgctxt "NpcYell:13577:0:13"
msgid "If this is what we must do..."
msgstr "Прости... но другого выхода нет!"

#. ja: 危ないッ！
#. de: Pass auf!
#. fr: Attention<nbsp>!!
msgctxt "NpcYell:13578:0:13"
msgid "Look out!"
msgstr "Берегись!"

#. ja: 喰らえッ！
#. de: Nieder mit dir!
#. fr: Prends ça<nbsp>!!
msgctxt "NpcYell:13579:0:13"
msgid "Fall!"
msgstr "Получай!"

#. ja: 無事…だったのだな…<br>よかった…本当に…
#. de: Du<nbsp>... bist wohlauf? Welch ein Glück<nbsp>...
#. fr: Tu n'as rien... Tant mieux...
msgctxt "NpcYell:13580:0:13"
msgid "You...you are unharmed? Thank goodness..."
msgstr "Ты... цел? Слава богам..."

#. ja: 来たれ！<br>我が騎士、我が竜よ！
#. de: Zu mir, meine treuen Krieger!
#. fr: À moi, mes loyaux serviteurs<nbsp>!
msgctxt "NpcYell:13581:0:13"
msgid "To me, my loyal servants!"
msgstr "Ко мне, верные слуги!"

#. ja: 王の栄光をここに！
#. de: Des Königs Macht ist mein!
#. fr: Le pouvoir absolu est mien<nbsp>!
msgctxt "NpcYell:13582:0:13"
msgid "The power is mine!"
msgstr "Сила принадлежит мне!"

#. ja: 我は人にして、神なり！
#. de: Kniet vor eurem Gott!
#. fr: Je suis le Dieu absolu<nbsp>!
msgctxt "NpcYell:13583:0:13"
msgid "The glory is mine!"
msgstr "Слава принадлежит мне!"

#. ja: 王の栄光をここに！
#. de: Des Königs Macht ist mein!
#. fr: Le pouvoir absolu est mien<nbsp>!
msgctxt "NpcYell:13584:0:13"
msgid "The power is mine!"
msgstr "Сила принадлежит мне!"

#. ja: 我は人にして、神なり！
#. de: Kniet vor eurem Gott!
#. fr: Je suis le Dieu absolu<nbsp>!
msgctxt "NpcYell:13585:0:13"
msgid "The glory is mine!"
msgstr "Слава принадлежит мне!"

#. ja: 負けを…認めよう…<br>ゆえに、命だけは…頼む…
#. de: Ich ergebe mich<nbsp>... Bitte, hab Gnade<nbsp>...
#. fr: Je me rends... Par pitié, épargne-moi...
msgctxt "NpcYell:13586:0:13"
msgid "I yield... Have mercy, I beg you..."
msgstr "Сдаюсь... Пощади меня, прошу..."

#. ja: …あれは、教皇トールダン！<br>まさか、すべての竜の眼を…！？
#. de: Das ist Thordan! Was um alles in der Welt hat er vor<nbsp>...?!
#. fr: ... Thordan<nbsp>!! Voilà donc le véritable pouvoir des Yeux du dragon...
msgctxt "NpcYell:13587:0:13"
msgid "Thordan!? Seven hells, he cannot mean to─!"
msgstr "Тордан!? Семь адов, неужели он собирается...!"

#. ja: 甘いな、光の使徒よ…<br>その甘さを後悔せぬことだ…
#. de: Ha! Dein Mitgefühl wird dein Untergang sein<nbsp>...
#. fr: Tu regretteras ta miséricorde, disciple de la Lumière...
msgctxt "NpcYell:13588:0:13"
msgid "Hmph, your compassion will be the end of you..."
msgstr "Хм. Твоё милосердие тебя погубит..."

#. ja: 殺す、殺す、殺す！
#. de: Alle, alle sollt ihr sterben! Einer nach dem anderen!
#. fr: Je les hais<nbsp>! Je dois tous les tuer<nbsp>! Jusqu'au dernier<nbsp>! Dans la souffrance qu'ils m'ont infligée<nbsp>! Maudits humains<nbsp>!
msgctxt "NpcYell:13589:0:13"
msgid "All will perish!"
msgstr "Все погибнут!"

#. ja: エスティニアン殿！
#. de: Estinien!
#. fr: Estinien<nbsp>!
msgctxt "NpcYell:13590:0:13"
msgid "Estinien!"
msgstr "Эстиниен!"

#. ja: これでは、人と竜<br>融和への道が…
#. de: Nun ist ein Ende des Krieges ferner denn je<nbsp>...
#. fr: N'y a-t-il aucun espoir de paix entre humains et dragons...<nbsp>?
msgctxt "NpcYell:13591:0:13"
msgid "Will there never be peace between man and dragon...?"
msgstr "Неужели людям и драконам никогда не обрести мир?.."

#. ja: グオオオォォォォッ！
#. de: Grrroooaaahhhr!
#. fr: Grrraaarrrgh<nbsp>!
msgctxt "NpcYell:13592:0:13"
msgid "Graaaaaarrrghhh!"
msgstr "Грааааарррх!"

#. ja: あ、相棒よ…<br>最期の頼みだ…！
#. de: Freunde<nbsp>... Ich bitte euch<nbsp>...
#. fr: Je vous en supplie...
msgctxt "NpcYell:13593:0:13"
msgid "I would ask one last favor of you, Warrior of Light..."
msgstr "Воин Света... У меня к тебе последняя просьба..."

#. ja: 俺が邪竜の意思を<br>押さえ込んでいる隙に…
#. de: Solange ich Nidhogg widerstehe<nbsp>...
#. fr: Donnez-moi le coup de grâce...
msgctxt "NpcYell:13594:0:13"
msgid "Finish me..."
msgstr "Добей меня..."

#. ja: トドメを…<br>トドメを刺してくれッ！
#. de: ...<nbsp>gebt mir den Gnadenstoß!
#. fr: Tant que je suis encore capable de le maîtriser<nbsp>!
msgctxt "NpcYell:13595:0:13"
msgid "Now, while I have the beast subdued!"
msgstr "Сейчас, пока я ещё сдерживаю зверя!"

#. ja: くっ…今は、エスティニアン殿を<br>安全な場所へ…！
#. de: Bringen wir Estinien in Sicherheit! Rasch!
#. fr: Ugh... Il faut mettre Estinien en sécurité im<shy>mé<shy>dia<shy>te<shy>ment<nbsp>!
msgctxt "NpcYell:13597:0:13"
msgid "We must see Estinien to safety!"
msgstr "Нужно срочно отвести Эстиниена в безопасное место!"

#. ja: 穢れし竜たちよ…<br>変革の礎となれ！
#. de: Dein Tod ebnet mir den Weg!
#. fr: Mon règne commencera sur vos cadavres<nbsp>!
msgctxt "NpcYell:13599:0:13"
msgid "Vile dragons! My reign begins with your end!"
msgstr "Проклятые драконы! На ваших трупах я воздвигну своё царство!"

#. ja: 我ガ主ヨ…
#. de: Ihr wünscht, mein König?
#. fr: Je suis à vos ordres, mon souverain...
msgctxt "NpcYell:13600:0:13"
msgid "What is thy bidding?"
msgstr "Чего изволит повелитель?"

#. ja: とーるだんノ<br>名ノ下ニ…
#. de: Möge König Thordan über allem stehen<nbsp>...
#. fr: Gloire à... Thordan...
msgctxt "NpcYell:13601:0:13"
msgid "In the name of King Thordan..."
msgstr "Во имя короля Тордана..."

#. ja: 戦神ニ栄光アレ…
#. de: Dem König zum Ruhme<nbsp>...
#. fr: Gloire à... la Conquérante...
msgctxt "NpcYell:13602:0:13"
msgid "Glory be to the Fury..."
msgstr "Слава Воительнице..."

#. ja: 道を開けよ！
#. de: Lasst uns durch!
#. fr: On perce à travers<nbsp>!
msgctxt "NpcYell:13603:0:13"
msgid "Out of our way!"
msgstr "Дорогу!"

#. ja: 蹴散らすぞ！
#. de: Auseinander!
#. fr: Débarrassons-nous d'eux rapidement<nbsp>!
msgctxt "NpcYell:13604:0:13"
msgid "Forward!"
msgstr "Вперёд!"

#. ja: くっ、増援か！
#. de: Mist, Verstärkung!
#. fr: Bon sang<nbsp>! D'autres renforts<nbsp>!?
msgctxt "NpcYell:13605:0:13"
msgid "Reinforcements!?"
msgstr "Подкрепление?!"

#. ja: 散るンだ！
#. de: Verzieht euch!
#. fr: Disparaissez<nbsp>!
msgctxt "NpcYell:13606:0:13"
msgid "Take cover!"
msgstr "В укрытие!"

#. ja: 覚悟なさい！
#. de: Aufgepasst!
#. fr: En garde<nbsp>!
msgctxt "NpcYell:13607:0:13"
msgid "Prepare yourselves!"
msgstr "Приготовьтесь!"

#. ja: ここは我らに任せてくれ！
#. de: Wir haben das im Griff!
#. fr: On s'en occupe<nbsp>! Foncez<nbsp>!
msgctxt "NpcYell:13608:0:13"
msgid "0"
msgstr "Оставьте это нам!"

#. ja: さあ猛ろ、呪剣ティソーナよッ！
#. de: Tizona, entfessle deinen Zorn!
#. fr: Embrase-toi, Tizona<nbsp>!
msgctxt "NpcYell:13609:0:13"
msgid "Roar, Tizona!"
msgstr "Реви, Тизона!"

#. ja: 父子相伝の必殺剣よ！
#. de: Aus dem Weeeeg!
#. fr: Hors de mon chemin<nbsp>!
msgctxt "NpcYell:13610:0:13"
msgid "Enough!"
msgstr "Довольно!"

#. ja: おら！
#. de: Nimm das!
#. fr: Mange ça<nbsp>!
msgctxt "NpcYell:13611:0:13"
msgid "There!"
msgstr "Вот!"

#. ja: はぁ！
#. de: Ha!
#. fr: Haaa<nbsp>!
msgctxt "NpcYell:13612:0:13"
msgid "Hyah!"
msgstr "Ха!"

#. ja: させません！
#. de: Niemals!
#. fr: Je ne vous laisserai pas faire<nbsp>!
msgctxt "NpcYell:13613:0:13"
msgid "I think not!"
msgstr "Не позволю!"

#. ja: 撃ち抜く！
#. de: Du erwischst mich nicht!
#. fr: Feu à volonté<nbsp>!
msgctxt "NpcYell:13614:0:13"
msgid "Have you now!"
msgstr "А вот и попался!"

#. ja: ハッ！
#. de: Haaa!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:13615:0:13"
msgid "Have at you!"
msgstr "Получай!"

#. ja: フンッ！
#. de: Uff!
#. fr: Hmpf<nbsp>!
msgctxt "NpcYell:13616:0:13"
msgid "Hmph!"
msgstr "Хм!"

#. ja: てやぁ！
#. de: Aaah!
#. fr: Han<nbsp>!
msgctxt "NpcYell:13617:0:13"
msgid "Hah!"
msgstr "Ха!"

#. ja: 先を急いでください！
#. de: Weiter, schnell!
#. fr: Partez devant<nbsp>!
msgctxt "NpcYell:13618:0:13"
msgid "Press onward, my friends!"
msgstr "Вперёд, друзья!"

#. ja: 今のうちに行くんだ！
#. de: Jetzt oder nie!
#. fr: Dépêchez-vous<nbsp>!
msgctxt "NpcYell:13619:0:13"
msgid "Go now! Before it's too late!"
msgstr "Скорее! Пока не поздно!"

#. ja: 早く偽神獣のもとへ！
#. de: Schnell, zur Blasphemität!
#. fr: Profitez-en<nbsp>!
msgctxt "NpcYell:13620:0:13"
msgid "You must hurry!"
msgstr "Надо спешить!"

#. ja: そこまでだ…<br>こいつは効くぜぇ？
#. de: Euch zerlege ich in Einzelteile!
#. fr: Bon, assez joué comme ça. Attention, ça va faire mal<nbsp>!
msgctxt "NpcYell:13627:0:13"
msgid "This will sting."
msgstr "Сейчас будет больно."

#. ja: アラワレヨ…
#. de: Zu mir!
#. fr: À mOi...
msgctxt "NpcYell:13628:0:13"
msgid "Rise! My legion!"
msgstr "Восстаньте! Мой легион!"

#. ja: ワガシモベヨ…
#. de: Meine treuen Diener ...
#. fr: MeS fIdÈlEs...
msgctxt "NpcYell:13629:0:13"
msgid "Rise! My faithful!"
msgstr "Восстаньте! Мои верные слуги!"

#. ja: ニガスモノカ…
#. de: Es gibt kein Entkommen!
#. fr: AuCuNe ÉcHaPpAtOiRe...
msgctxt "NpcYell:13630:0:13"
msgid "No escape!"
msgstr "Вам не уйти!"

#. ja: ヒレフセヨ…
#. de: Verbeugt euch!
#. fr: PrOsTeRnEz-VoUs...
msgctxt "NpcYell:13631:0:13"
msgid "Begone!"
msgstr "Прочь!"

#. ja: バンゾクドモメ…
#. de: Ihr Wilden!
#. fr: BaRbArEs RéCaLcItRaNts...
msgctxt "NpcYell:13632:0:13"
msgid "Savages!"
msgstr "Дикари!"

#. ja: デンカノタメニ…
#. de: Für Seine Majestät!
#. fr: PoUr Sa MaJeStÉ...
msgctxt "NpcYell:13633:0:13"
msgid "For glory!"
msgstr "Во славу!"

#. ja: オオセノママニ…
#. de: Ihr Wunsch ist uns Befehl!
#. fr: VoS dÉsIrS sOnT dEs OrDrEs...
msgctxt "NpcYell:13634:0:13"
msgid "For Garlemald!"
msgstr "За Гарлемальд!"

#. ja: センメツスル…
#. de: Sie werden sterben!
#. fr: IlS SeRoNt ÉlImInÉs...
msgctxt "NpcYell:13635:0:13"
msgid "Death take you!"
msgstr "Смерть вам!"

#. ja: 回復する！
#. de: Ich heile!
#. fr: Je concentre tous mes soins sur vous<nbsp>!
msgctxt "NpcYell:13636:0:13"
msgid "Stay strong!"
msgstr "Держитесь!"

#. ja: 皆を救うのだ！
#. de: Ich werde euch alle retten!
#. fr: Tenez bon<nbsp>! Je vais nous revigorer<nbsp>!
msgctxt "NpcYell:13637:0:13"
msgid "Take heart!"
msgstr "Не падайте духом!"

#. ja: ここは我らに任せてくれ！
#. de: Wir über<shy>nehmen das hier!
#. fr: On s'en occupe<nbsp>! Foncez<nbsp>!
msgctxt "NpcYell:13638:0:13"
msgid "Leave this to us!"
msgstr "Оставьте это нам!"

#. ja: そこまでだ…<br>こいつは効くぜぇ？
#. de: Euch zerlege ich in Einzelteile!
#. fr: Bon, assez joué comme ça. Attention, ça va faire mal<nbsp>!
msgctxt "NpcYell:13639:0:13"
msgid "This will sting."
msgstr "Сейчас будет больно."

#. ja: 吹っ飛ばしてやンよ！
#. de: Aus dem Weg!
#. fr: Je vais te pulvériser<nbsp>!
msgctxt "NpcYell:13640:0:13"
msgid "Out of my way!"
msgstr "С дороги!"

#. ja: 何てこった…
#. de: Hm, das kam unerwartet<nbsp>...
#. fr: C'est absurde...
msgctxt "NpcYell:13641:0:13"
msgid "Unexpected... Most unexpected..."
msgstr "Неожиданно... Очень неожиданно..."

#. ja: うおおおおおお！！
#. de: Grraaarrr!
#. fr: Yaaaaaargh<nbsp>!
msgctxt "NpcYell:13642:0:13"
msgid "Yaaaaaargh!"
msgstr "Ааааааргх!"

#. ja: 我が剣技を<br>喰らうがよいッ！
#. de: Mach Bekanntschaft mit meiner Klinge!
#. fr: Goûte à ma lame<nbsp>!
msgctxt "NpcYell:13643:0:13"
msgid "Taste my blade!"
msgstr "Отведай моего клинка!"

#. ja: 残影と言えど<br>斬れ味は変わらぬぞ！
#. de: Du tätest gut daran, die Schärfe dieser Klingen nicht zu unter<shy>schätzen!
#. fr: Ce sont des ombres, mais leurs lames sont bien réelles<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13644:0:13"
msgid "They may be shades,<br>but their blades are<br>just as deadly!"
msgstr "Пусть это лишь тени,<br>но клинки у них<br>не менее смертоносны!"

#. ja: 押し斬るッ！
#. de: Sei bereit zu bluten!
#. fr: Viens que je te taille en pièces<nbsp>!
msgctxt "NpcYell:13645:0:13"
msgid "On your guard!"
msgstr "Берегись!"

#. ja: グハッ…
#. de: Argh ...
#. fr: Gargh...
msgctxt "NpcYell:13646:0:13"
msgid "Ugh..."
msgstr "Ух..."

#. ja: ぐほっ…<br>ここまで、か…
#. de: Grr ... Verflucht ...
#. fr: Gurgh... C'est fini pour moi...
msgctxt "NpcYell:13647:0:13"
msgid "Ungh... Damn it..."
msgstr "Ух... Проклятье..."

#. ja: 隊長…力になれず…<br>すみま…せん…
#. de: Wir sind zu schwach. Vergebt uns ...
#. fr: Pardonnez-moi, Préfet...
msgctxt "NpcYell:13648:0:13"
msgid "Forgive me...my lord..."
msgstr "Простите меня... мой господин..."

#. ja: フンッ！
#. de: Hmpf!
#. fr: Hmph<nbsp>!
msgctxt "NpcYell:13649:0:13"
msgid "Hmph!"
msgstr "Хм!"

#. ja: 逃がすものか！
#. de: Flucht ist zwecklos!
#. fr: Si tu crois pouvoir m'échapper...
msgctxt "NpcYell:13650:0:13"
msgid "You cannot run!"
msgstr "Не уйдёшь!"

#. ja: お前たち…<br>馬鹿な真似はよせ…
#. de: Narren! Verschwindet endlich!
#. fr: Vous n'auriez pas dû... C'est de la folie...
msgctxt "NpcYell:13651:0:13"
msgid "Don't be fools! Get away from here!"
msgstr "Не дурачьтесь! Убирайтесь отсюда!"

#. ja: これが工神の力か…！
#. de: Das ist also die Kraft des Erbauers.
#. fr: Voilà donc le pouvoir de l'Artisan<nbsp>!
msgctxt "NpcYell:13653:0:13"
msgid "So this is the power of the Builder..."
msgstr "Так вот какова сила Строителя..."

#. ja: 俺はあくまで道案内だ<br>すまないが、戦力にはなれない
#. de: Ich kann euch in diesem Kampf leider nicht beistehen.
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment, je ne serai d'aucune aide au combat.
msgctxt "NpcYell:13654:0:13"
msgid "I'm sorry I cannot aid you in battle."
msgstr "Прости, но в бою я ничем не помогу."

#. ja: ん？　あれは…？
#. de: Hm? Was ist das?
#. fr: Tiens, que se passe-t-il<nbsp>?
msgctxt "NpcYell:13655:0:13"
msgid "Hm? Up ahead..."
msgstr "Хм? Там впереди..."

#. ja: この上にラールガーが…？
#. de: Rhalgr erwartet uns weiter oben.
#. fr: C'est Rhalgr, là-haut<nbsp>?
msgctxt "NpcYell:13656:0:13"
msgid "It seems Rhalgr awaits us above."
msgstr "Похоже, Ралгр ждёт нас наверху."

#. ja: 先に進もう<br>ひととおり案内はできる
#. de: Vorwärts!
#. fr: Continuons à avancer.
msgctxt "NpcYell:13657:0:13"
msgid "Come, let us keep moving."
msgstr "Ну же, продолжим путь."

#. ja: 新手の神使か…！
#. de: Noch mehr Diener der Götter?
#. fr: Encore d'autres familiers<nbsp>?
msgctxt "NpcYell:13658:0:13"
msgid "Yet more servants of the gods!?"
msgstr "И снова слуги богов!?"

#. ja: 日神アーゼマ…<br>太陽と審理を司る神だ…
#. de: Azeyma, die Sonnengöttin.
#. fr: Azeyma, la Gardienne...
msgctxt "NpcYell:13659:0:13"
msgid "Azeyma, goddess of the sun..."
msgstr "Азима, богиня солнца..."

#. ja: さあ、先に進んでくれ…！
#. de: Weiter!
#. fr: On ne peut pas reculer maintenant<nbsp>!
msgctxt "NpcYell:13662:0:13"
msgid "No way but forward."
msgstr "Только вперёд."

#. ja: この声は…！
#. de: Diese Stimme!
#. fr: Cette voix...
msgctxt "NpcYell:13664:0:13"
msgid "This voice..."
msgstr "Этот голос..."

#. ja: メーティオンの身体が<br>黒く…？
#. de: Der Körper von Meteion hat sich schwarz verfärbt<nbsp>...
#. fr: Le corps de Météion s'est noirci...
msgctxt "NpcYell:13666:0:13"
msgid "Is it me or has Meteion grown a shade darker?"
msgstr "Или мне кажется, или Метеион стала темнее?"

#. ja: 君は絶望を知るたび<br>それを内に溜め込んだのか…
#. de: Jeder Schmerz, den du miterleben musstest, ist in dein Herz gesickert<nbsp>...
#. fr: Chaque tragédie dont tu as été témoin a teinté ton cœur...
msgctxt "NpcYell:13667:0:13"
msgid "How many worlds have stained her soul with despair?"
msgstr "Сколько миров запятнали её душу отчаянием?"

#. ja: その身体の漆黒が<br>絶望の証…ですか？
#. de: Diese pechschwarze Haut<nbsp>... Ist das das Stigma der Ver<shy>zweif<shy>lung?
#. fr: Cette peau anthracite... Serait-ce là la marque qu'a laissé le désespoir sur elle<nbsp>?
msgctxt "NpcYell:13668:0:13"
msgid "Meteion hath taken a blackened hue. To reflect her heart, mayhap?"
msgstr "Метеион почернела. Может, это отражение её души?"

#. ja: ああ…絶対に同意できそうにないな
#. de: Nein<nbsp>... Ich kann und will das nicht glauben.
#. fr: Tout à fait. Sa conclusion ne me satisfait pas du tout non plus.
msgctxt "NpcYell:13669:0:13"
msgid "Apathy...? Hmph, madness is what it was."
msgstr "Апатия?.. Хм, да это же безумие."

#. ja: これが事実だとしても<br>私たちは挫けない！
#. de: Selbst wenn es wahr ist, werden wir niemals aufgeben!
#. fr: Que ces événements se soient réellement produits ou non, rien ne nous arrêtera<nbsp>!
msgctxt "NpcYell:13670:0:13"
msgid "You'll not dissuade us with these bleak visions of the past."
msgstr "Не сломить нас этими мрачными картинами прошлого."

#. ja: これが世界の全てではないと<br>証明いたしましょう
#. de: Die Welt besteht nicht nur aus Leid - und das werden wir beweisen!
#. fr: L'ané<shy>an<shy>tis<shy>se<shy>ment n'est pas la seule issue, et nous le prouverons.
msgctxt "NpcYell:13671:0:13"
msgid "Let us give the lie to her promise of ruin."
msgstr "Докажем, что не всё обречено на гибель."

#. ja: 今…楽にしてあげるわ
#. de: Diese Mäuler werden wir zu stopfen wissen!
#. fr: Je vais te libérer de tes souffrances...
msgctxt "NpcYell:13672:0:13"
msgid "We will grant you peace."
msgstr "Мы избавим тебя от страданий."

#. ja: 急いで…奥へ！
#. de: Schnell, weiter!
#. fr: Dépêchons-nous de continuer<nbsp>!
msgctxt "NpcYell:13673:0:13"
msgid "We can't afford to slow down!"
msgstr "Нельзя терять ни секунды!"

#. ja: 止まるな、行くぞ！
#. de: Keine Müdigkeit vorschützen!
#. fr: Allez, il faut avancer<nbsp>!
msgctxt "NpcYell:13674:0:13"
msgid "On to the next one!"
msgstr "Дальше! К следующему!"

#. ja: 向こうから人が…！
#. de: Da vorne sind Leute!
#. fr: Il y a quelqu'un là-bas...<nbsp>!
msgctxt "NpcYell:13675:0:13"
msgid "Civilians, up ahead!"
msgstr "Впереди люди!"

#. ja: ええ、こちらは任せて！
#. de: Dann nichts wie hin!
#. fr: En effet... On s'en charge<nbsp>!
msgctxt "NpcYell:13676:0:13"
msgid "I'll take care of this!"
msgstr "Я тут разберусь!"

#. ja: 行くしかないわ！<br>奥へ！
#. de: Wir müssen weiter, es hilft nichts!
#. fr: Pas le choix, allons-y<nbsp>!
msgctxt "NpcYell:13677:0:13"
msgid "The only way is forward!"
msgstr "Только вперёд!"

#. ja: 悲劇を…止めるんだ<br>オレたちの手で！
#. de: Diesem Unglück werden wir eigenhändig Einhalt gebieten!
#. fr: Nous devons absolument arrêter cette trrragédie<nbsp>!
msgctxt "NpcYell:13678:0:13"
msgid "It's up to us now!"
msgstr "Теперь всё зависит от нас!"

#. ja: オレの背後へ！
#. de: Hinter mich!
#. fr: Tous derrièrrre moi<nbsp>!
msgctxt "NpcYell:13679:0:13"
msgid "Get behind me!"
msgstr "За мной!"

#. ja: これは…<br>光の氾濫！？
#. de: Ist das ... die Lichtflut?!
#. fr: C'est un... déluge de Lumièrrre<nbsp>?
msgctxt "NpcYell:13680:0:13"
msgid "Could that be...a Flood of Light!?"
msgstr "Неужели это... Потоп Света!?"

#. ja: ……！！
#. de: Gah!
#. fr: ...<nbsp>!
msgctxt "NpcYell:13681:0:13"
msgid "Not good!"
msgstr "Плохо дело!"

#. ja: あと一息だ！<br>いくぞ！！
#. de: Noch stehen wir!
#. fr: Un dernier effort<nbsp>! Allez<nbsp>!
msgctxt "NpcYell:13682:0:13"
msgid "Just a little more!"
msgstr "Ещё немного!"

#. ja: 私たちは…<br>超えてみせる！
#. de: Alles, was du uns entgegenschmetterst, werden wir erdulden!
#. fr: Courage, mes amis<nbsp>!
msgctxt "NpcYell:13683:0:13"
msgid "We will...stand our ground!"
msgstr "Мы... выстоим!"

#. ja: 人の想いと<br>魂を継いで…
#. de: Wir tragen sie mit uns, schlummernder Seelen Wünsche.
#. fr: Pour ceux qui nous sont chers... et ceux qui nous ont quittés.
msgctxt "NpcYell:13684:0:13"
msgid "The world's fate doth rest on our shoulders..."
msgstr "Судьба мира на наших плечах..."

#. ja: …終末の…その先へ！
#. de: Bis zum Ende. Und weit darüber hinaus.
#. fr: Au-delà de l'apocalypse... la vie<nbsp>!
msgctxt "NpcYell:13685:0:13"
msgid "We cannot fail here!"
msgstr "Здесь мы не можем проиграть!"

#. ja: 決めるぞ、ニーズヘッグ！
#. de: Beenden wir es, Nidhogg!
#. fr: Regarde-nous, Nidhogg<nbsp>!
msgctxt "NpcYell:13686:0:13"
msgid "Roar, Nidhogg!"
msgstr "Рёв, Нидхёгг!"

#. ja: 私たちは…<br>未来へ！
#. de: Für die Zukunft!
#. fr: La terre aura son futur<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:13687:0:13"
msgid "We <i>will</i> succeed!"
msgstr "Мы <i>обязательно</i> победим!"

#. ja: いくぞ…英雄！！
#. de: Führe uns zum Sieg, <if $gn4>Heldin<else>Held</if>.
#. fr: Pour toi, <if $gn4>mon hérrroïne<else>mon hérrros</if><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:13688:0:13"
msgid "Now's our chance, <split \" \" 1><string $gs1></split>!"
msgstr "Теперь наш шанс, <split \" \" 1><string $gs1></split>!"

#. ja: 急いで救出を…<br>ですが、この気配は……
#. de: Eile ist geboten, doch<nbsp>... Das Schicksal scheint uns nicht geneigt.
#. fr: Il faut vite les sauver... Mais... Cette présence...
msgctxt "NpcYell:13689:0:13"
msgid "What frightful presence doth assault my senses?"
msgstr "Какая жуткая сила давит на меня..."

#. ja: ああ…<b>
#. de: Wie ich fürchtete.
#. fr: Ah...
msgctxt "NpcYell:13690:0:13"
msgid "By the Twelve..."
msgstr "Двенадцать..."

#. ja: …せめて<br>安らかなる眠りを…
#. de: Lasst uns ihnen helfen, Ruhe zu finden.
#. fr: Reposez en paix... C'est tout ce que je peux vous souhaiter...
msgctxt "NpcYell:13691:0:13"
msgid "May thine end be without pain..."
msgstr "Пусть конец их будет безболезненным..."

#. ja: その妄執と絶望<br>ここで砕かせてもらうぞ！
#. de: Dieser Wahn wird nun ein Ende nehmen!
#. fr: On te libérera de ton désespoirrr<nbsp>!
msgctxt "NpcYell:13692:0:13"
msgid "You have wallowed long enough!"
msgstr "Хватит упиваться своим отчаянием!"

#. ja: あの楔…なんだかヤバそう～！<br>先に壊そうよ～！
#. de: Diese Fessel könnte Ärger bedeuten. Helft mir, sie zu zerstören!
#. fr: Je le sens mal, ce pal<nbsp>! Détruisons-le vite<nbsp>!
msgctxt "NpcYell:13693:0:13"
msgid "That nail could be trouble. Come, help me destroy it!"
msgstr "Этот кол может принести беду. Помоги мне его уничтожить!"

#. ja: 森の空気が重い…
#. de: Der Wald kommt mir düsterer vor als sonst.
#. fr: L'atmosphère est trop pesante...
msgctxt "NpcYell:13701:0:13"
msgid "Something doesn't want us here..."
msgstr "Кажется, нам здесь не рады..."

#. ja: 周りから視線を感じるような…？
#. de: Beobachtet mich da jemand?
#. fr: J'ai l'impression qu'on nous observe...
msgctxt "NpcYell:13702:0:13"
msgid "Doesn't it feel like we're being watched?"
msgstr "Тебе не кажется, что за нами следят?"

#. ja: ま、待ってください…！
#. de: W-Warte!
#. fr: Attendez<nbsp>!
msgctxt "NpcYell:13703:0:13"
msgid "W-Wait! Not so fast!"
msgstr "П-постойте! Не так быстро!"

#. ja: うわぁ！
#. de: Uaaah!
#. fr: Ouaaah<nbsp>!
msgctxt "NpcYell:13704:0:13"
msgid "Uwaaah!"
msgstr "А-а-а!"

#. ja: ひいっ…！
#. de: Hiiilfe!
#. fr: Nooon<nbsp>!
msgctxt "NpcYell:13705:0:13"
msgid "Gwaaah!"
msgstr "А-а-а!"

#. ja: しっ、死にたくない…！
#. de: Ich will noch nicht sterben!
#. fr: Je veux pas mourir<nbsp>!
msgctxt "NpcYell:13706:0:13"
msgid "I don't... I don't want to die..."
msgstr "Я... я не хочу умирать..."

#. ja: わくわくするね…！
#. de: Das könnte spannend werden.
#. fr: C'est... stressant...
msgctxt "NpcYell:13707:0:13"
msgid "Ah, the anticipation!"
msgstr "Ах, как волнительно!"

#. ja: どんどん行こう！
#. de: Weiter!
#. fr: Continuons à avancer<nbsp>!
msgctxt "NpcYell:13708:0:13"
msgid "On we go!"
msgstr "Вперёд!"

#. ja: おおっと…？
#. de: Nanu?
#. fr: Euh...<nbsp>?
msgctxt "NpcYell:13709:0:13"
msgid "Oh? Oh dear."
msgstr "Ой... Что такое?"

#. ja: 護衛よろしく！
#. de: Beschütze mich!
#. fr: Je compte sur vous pour me protéger, hein<nbsp>!
msgctxt "NpcYell:13710:0:13"
msgid "Guard my person, if you would!"
msgstr "Защитите меня, будьте добры!"

#. ja: ちょっと待っておくれ！
#. de: Warte!
#. fr: Attendez-moi<nbsp>!!!
msgctxt "NpcYell:13711:0:13"
msgid "Not so hasty, if you please!"
msgstr "Постойте!"

#. ja: 我らが焼き払ってくれる！
#. de: Unsere Flammen werden euch verschlingen!
#. fr: Nos flammes vont vous consumer<nbsp>!
msgctxt "NpcYell:13713:0:13"
msgid "Our flames will consume you!"
msgstr "Наше пламя вас поглотит!"

#. ja: わたくしたちの前に<br>ひれ伏しなさい！
#. de: Kniet vor uns!
#. fr: Rampez devant nous<nbsp>! Roarrr<nbsp>!
msgctxt "NpcYell:13714:0:13"
msgid "Bow down before us!"
msgstr "Поклонитесь нам!"

#. ja: 我からいくぞ！<br>上手くやれよ！
#. de: Folg mir!
#. fr: À moi de jouer<nbsp>!
msgctxt "NpcYell:13715:0:13"
msgid "Follow my lead!"
msgstr "Я начну! Действуй как следует!"

#. ja: 我ひとりとなったか…<br>だがそれでも！
#. de: Ich schaffe euch auch alleine!
#. fr: Vous allez le payer<nbsp>! Roarrr<nbsp>!
msgctxt "NpcYell:13716:0:13"
msgid "Grrr, I am more than enough for your ilk!"
msgstr "Я осталась одна?.. Но всё равно!"

#. ja: わたくしに合わせて<br>舞いなさい！
#. de: Sei bei mir!
#. fr: C'est à moi que vous avez affaire<nbsp>!
msgctxt "NpcYell:13717:0:13"
msgid "With me!"
msgstr "Танцуйте в такт мне!"

#. ja: 番いがやられたとて<br>諦めはしません！
#. de: Das ist noch nicht vorüber!
#. fr: Roarrr<nbsp>! Rien n'est fini<nbsp>!
msgctxt "NpcYell:13718:0:13"
msgid "Grrr, it isn't over yet!"
msgstr "Даже если моя пара пала, я не сдамся!"

#. ja: 以心伝心…<br>双炎法！
#. de: Unser Atem ist eins!
#. fr: Soyez immolés<nbsp>! Roarrr<nbsp>!
msgctxt "NpcYell:13719:0:13"
msgid "We breathe as one!"
msgstr "Мы дышим как единое целое!"

#. ja: グギギギ…
#. de: Hrrrssssh<nbsp>...
#. fr: Gnihihihi...
msgctxt "NpcYell:13720:0:13"
msgid "Hish hish hish!"
msgstr "Гыгыгы..."

#. ja: シュー…<br>フシュー…
#. de: Mmmh<nbsp>...
#. fr: Fsssh... Fssshhh...
msgctxt "NpcYell:13721:0:13"
msgid "Mmm..."
msgstr "Ш-ш-ш... Ф-ш-ш..."

#. ja: グルルルルゥ…
#. de: Rrrrgh!
#. fr: Grrrrrr<nbsp>!
msgctxt "NpcYell:13722:0:13"
msgid "Grrrgh!"
msgstr "Р-р-р-р!"

#. ja: フシャーッ！
#. de: Ssssh!
#. fr: Pshah<nbsp>!
msgctxt "NpcYell:13723:0:13"
msgid "Shah shah!"
msgstr "Ша-а!"

#. ja: ギィッ！？
#. de: Krch?!
#. fr: Gnih<nbsp>!?
msgctxt "NpcYell:13724:0:13"
msgid "Hngh!?"
msgstr "Кх!?"

#. ja: アギャギャ…！
#. de: Argh!
#. fr: Arghah<nbsp>!
msgctxt "NpcYell:13725:0:13"
msgid "Argh!"
msgstr "А-а!"

#. ja: ウギッ！？
#. de: Ungh!
#. fr: Gnieh<nbsp>!?
msgctxt "NpcYell:13726:0:13"
msgid "Uh!?"
msgstr "Ух!?"

#. ja: キィーッ！
#. de: Grah!
#. fr: Gnihi<nbsp>!
msgctxt "NpcYell:13727:0:13"
msgid "Gah!"
msgstr "Ки-и!"

#. ja: 開門術式…<br>海洋生物ヲ転送スル…
#. de: Orte lokale Fauna. Öffne Portal.
#. fr: Ouverture du portail... Transport de la faune locale...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13728:0:13"
msgid "Locating denizens.<br>Opening portal..."
msgstr "Поиск обитателей.<br>Открытие портала..."

#. ja: 逃さないわよ…<br>一閃ッ！
#. de: Lauft, wenn ihr könnt!
#. fr: Vous êtes à moi<nbsp>!
msgctxt "NpcYell:13729:0:13"
msgid "You're mine!"
msgstr "Ты моя!"

#. ja: ハハハハッ！<br>踊れ、踊れッ！
#. de: Ha! Du kannst dich nicht verstecken!
#. fr: Ha ha ha<nbsp>! Danse à présent<nbsp>!
msgctxt "NpcYell:13730:0:13"
msgid "You've nowhere to hide!"
msgstr "Тебе негде спрятаться!"

#. ja: なぶり殺しにしてやるッ！
#. de: Sei so gut und <i>stirb</i>!!
#. fr: Tu vas mourir dans d'atroces souffrances<nbsp>!
msgctxt "NpcYell:13731:0:13"
msgid "I'll bludgeon you to death!"
msgstr "Забью тебя насмерть!"

#. ja: そらそらッ…！
#. de: Wie gefällt dir das?
#. fr: Prends ça<nbsp>! Et ça<nbsp>!
msgctxt "NpcYell:13732:0:13"
msgid "Try this!"
msgstr "Попробуй вот это!"

#. ja: トドメといくよッ！
#. de: Es ist aus, du Made!
#. fr: Le coup final<nbsp>!
msgctxt "NpcYell:13733:0:13"
msgid "It's over!"
msgstr "Тебе конец!"

#. ja: 床のシミになれッ！
#. de: In den Staub mit dir!
#. fr: Mords la poussière<nbsp>!
msgctxt "NpcYell:13734:0:13"
msgid "To dust with you!"
msgstr "Сотру тебя в порошок!"

#. ja: 消え失せろッ！
#. de: Hinfort!
#. fr: Disparais<nbsp>!
msgctxt "NpcYell:13735:0:13"
msgid "Begone!"
msgstr "Прочь!"

#. ja: ネズミどもがッ！
#. de: Dreckiges Ungeziefer!
#. fr: Tu vas voir ce que je fais aux rats de ton espèce<nbsp>!
msgctxt "NpcYell:13736:0:13"
msgid "Vermin!"
msgstr "Тварь!"

#. ja: キュッ～！
#. de: Qui-Quiep!
#. fr: Kiii<nbsp>!!!
msgctxt "NpcYell:13737:0:13"
msgid "\\<squeak>!"
msgstr "<i>Пи-и!</i>"

#. ja: キャウゥ～！
#. de: Quiiieeep!
#. fr: Kii<nbsp>! Kiiiii<nbsp>!
msgctxt "NpcYell:13738:0:13"
msgid "\\<squeak> \\<squeak>"
msgstr "<i>Пи-и! Пи-и!</i>"

#. ja: 消えろッ、消えろッ…！
#. de: Verflucht! Stirb endlich!
#. fr: Crève<nbsp>! Crève<nbsp>!
msgctxt "NpcYell:13739:0:13"
msgid "Die, damn you!"
msgstr "Сдохни, проклятье!"

#. ja: アタシの前から消えろォッ！
#. de: Wieso lebst du noch?! Ich sagte, <i>du sollst sterben</i>!
#. fr: Hors de ma vue<nbsp>!
msgctxt "NpcYell:13740:0:13"
msgid "Die, die, DIE!"
msgstr "Сдохни, сдохни, СДОХНИ!"

#. ja: キュッ、キュウ～！
#. de: Quiep! Quiiiep!
#. fr: Kiii Kiii<nbsp>!
msgctxt "NpcYell:13741:0:13"
msgid "\\<squeak>! \\<squeak>!"
msgstr "<i>Пик! Пи-и!</i>"

#. ja: キュワワ～ン♪
#. de: Quiep ♪
#. fr: Kiiiii<nbsp>!♪
msgctxt "NpcYell:13742:0:13"
msgid "\\<squeak>♪ "
msgstr "<i>Пи-и-и!♪</i>"

#. ja: キュキュッ！
#. de: Quiep, quiep!
#. fr: Kii<nbsp>!?
msgctxt "NpcYell:13743:0:13"
msgid "\\<sniff> \\<squeak>"
msgstr "<i>Шмыг! Пик!</i>"

#. ja: コケーッ！
#. de: Gack-Gack!
#. fr: Cot cooot<nbsp>!
msgctxt "NpcYell:13744:0:13"
msgid "Cluck cluck!"
msgstr "Ко-ко!"

#. ja: ココッ…コケーッ！
#. de: Gack-Gack<nbsp>... Gaaack!
#. fr: Cot codêêêêt<nbsp>!!!
msgctxt "NpcYell:13745:0:13"
msgid "Cluck... Cluck! Cluck!"
msgstr "Ко... ко-ко!"

#. ja: ち、近寄るでない！
#. de: B-Bleib zurück!
#. fr: Arrière<nbsp>! Arrière<nbsp>!
msgctxt "NpcYell:13746:0:13"
msgid "S-Stay back!"
msgstr "Н-не подходи!"

#. ja: あっちへ行け！
#. de: Hinfort mit dir!
#. fr: Ouste, nous avons dit<nbsp>!
msgctxt "NpcYell:13747:0:13"
msgid "Away with you!"
msgstr "А ну прочь!"

#. ja: 蛮族どもめ…！
#. de: Wildes Pack!
#. fr: À mort, les sauvages<nbsp>!
msgctxt "NpcYell:13748:0:13"
msgid "Savages!"
msgstr "Дикари!"

#. ja: ガイウス様のために！
#. de: Für den Legatus!
#. fr: Pour le seigneur Gaius<nbsp>!
msgctxt "NpcYell:13749:0:13"
msgid "For Lord Gaius!"
msgstr "За господина Гая!"

#. ja: 帝国に栄光あれ！
#. de: Ehre dem Kaiserreich!
#. fr: Gloire à l'Empire<nbsp>!
msgctxt "NpcYell:13750:0:13"
msgid "For the Empire!"
msgstr "Слава Империи!"

#. ja: ここで食い止める！
#. de: Weiter kommt ihr nicht!
#. fr: Tu n'iras pas plus loin<nbsp>!
msgctxt "NpcYell:13751:0:13"
msgid "That's as far as you go!"
msgstr "Дальше вам не пройти!"

#. ja: やらせるものか！
#. de: Ihr habt keine Chance!
#. fr: Je vais te calmer<nbsp>!
msgctxt "NpcYell:13752:0:13"
msgid "Oh no you don't!"
msgstr "Не бывать этому!"

#. ja: 喰らえッ！
#. de: Nehmt das!
#. fr: Avale ça<nbsp>!
msgctxt "NpcYell:13753:0:13"
msgid "Try this!"
msgstr "Получай!"

#. ja: そこだッ！
#. de: Hah!
#. fr: Là<nbsp>!
msgctxt "NpcYell:13754:0:13"
msgid "There!"
msgstr "Вот ты где!"

#. ja: いくぞッ！
#. de: Der ist für dich!
#. fr: C'est parti<nbsp>!
msgctxt "NpcYell:13755:0:13"
msgid "Have at you!"
msgstr "Ну, держись!"

#. ja: いななきなさい！<br>壊雷球！
#. de: Blitz der Zerstörung, komme!
#. fr: Que la foudre s'abatte<nbsp>!
msgctxt "NpcYell:13756:0:13"
msgid "Lightning, shriek!"
msgstr "Молния, визжи!"

#. ja: 迸りなさい…<br>壊雷球！
#. de: Blitz der Zerstörung, fahre herab!
#. fr: À moi, charges destructrices<nbsp>!
msgctxt "NpcYell:13757:0:13"
msgid "Lightning, burst!"
msgstr "Молния, разразись!"

#. ja: ひれ伏しなさい！
#. de: Nieder!
#. fr: À genoux<nbsp>!
msgctxt "NpcYell:13758:0:13"
msgid "Down with you!"
msgstr "На колени!"

#. ja: 駆逐します！
#. de: Macht euch bereit!
#. fr: Vous n'êtes pas de taille<nbsp>!
msgctxt "NpcYell:13759:0:13"
msgid "Prepare yourselves!"
msgstr "Готовьтесь!"

#. ja: 人に負けてなるものか！
#. de: Kein Sterblicher soll mich besiegen!
#. fr: Je ne perdrai pas face à de simples mortels<nbsp>!
msgctxt "NpcYell:13760:0:13"
msgid "I will not fall to mortals!"
msgstr "Не бывать тому, чтобы меня одолели смертные!"

#. ja: 財宝ヲ、守ル…
#. de: Sichert den Schatz.
#. fr: Protéger... Trésor...
msgctxt "NpcYell:13761:0:13"
msgid "Secure the treasure."
msgstr "Охранять сокровище."

#. ja: 侵入者ハ何処…
#. de: Treibt die Eindringlinge zurück.
#. fr: Arrêter les intrus...
msgctxt "NpcYell:13762:0:13"
msgid "Repel the intruders."
msgstr "Отбросить незваных гостей."

#. ja: 財宝ヲ狙ウ盗人メ…
#. de: Erschlagt die Diebe.
#. fr: Viles pillards...
msgctxt "NpcYell:13763:0:13"
msgid "Slay the looters."
msgstr "Убить мародёров."

#. ja: 立チ去ラネバ<br>滅スルノミ…！
#. de: Flieht oder vergeht.
#. fr: Quittez ces lieux, ou vous serez exterminés<nbsp>!
msgctxt "NpcYell:13764:0:13"
msgid "Flee, or be feed for the fish."
msgstr "Бегите, иначе пойдёте рыбам на корм!"

#. ja: ひぃ、はぁ…<br>なんて速いんだ！
#. de: Verflixt, sind die flink!
#. fr: Aaah<nbsp>! Mais... Ils sont beaucoup trop rapides<nbsp>!
msgctxt "NpcYell:13765:0:13"
msgid "Damn it! How do those little legs carry them so fast!?"
msgstr "Чёрт! Откуда у них такие быстрые лапки?!"

#. ja: このままだと<br>黒衣森から逃げてしまう…！
#. de: Wenn das so weitergeht, erwischen wir keinen Einzigen!
#. fr: Ils vont finir par réussir à quitter la forêt de Sombrelinceul à ce rythme<nbsp>!
msgctxt "NpcYell:13766:0:13"
msgid "If we don't do something, they're all going to get away!"
msgstr "Надо что-то делать, а то они все сбегут!"

#. ja: しあわせうさぎを捕まえれば<br>ニワトリも大人しくなるはず…！
#. de: So kommen die Hühner doch nie zum Eierlegen<nbsp>...
#. fr: Si on attrape les lapins, les poules se calmeront sûrement<nbsp>!
msgctxt "NpcYell:13767:0:13"
msgid "Catch the rabbits, and the chickens will calm down for sure!"
msgstr "Поймаем кроликов — и куры наверняка успокоятся!"

#. ja: ニワトリがうさぎを止めてる！<br>今がチャンスだ！
#. de: Sie hauen die Hasen bewusstlos! Das ist unsere Chance!
#. fr: Les poules ont réussi à arrêter les lapins<nbsp>! C'est notre chance<nbsp>!
msgctxt "NpcYell:13768:0:13"
msgid "The chickens hold the bunnies at bay! Now's our chance!"
msgstr "Куры сдерживают кроликов! Сейчас наш шанс!"

#. ja: しあわせが逃げちゃう…！
#. de: Da flitzt das Glück von dannen<nbsp>...
#. fr: Non<nbsp>! Le bonheur<nbsp>! Il s'enfuit<nbsp>!
msgctxt "NpcYell:13769:0:13"
msgid "Happiness is ever so fleeting..."
msgstr "Счастье так мимолётно..."

#. ja: これが荒ぶるニワトリの暴威か…！
#. de: Ich möchte nicht in der Haut dieser Glückshasen stecken<nbsp>...
#. fr: Les poulettes sont com<shy>plè<shy>te<shy>ment déchaînées<nbsp>!
msgctxt "NpcYell:13770:0:13"
msgid "Good gods! Never underestimate an angry chicken!"
msgstr "О боги! Никогда не недооценивайте разъярённую курицу!"

#. ja: だいぶ暴れたからかな<br>ニワトリが落ち着いたみたい
#. de: Sieh nur, die Hühner beruhigen sich langsam.
#. fr: Les poules se sont enfin calmées... Elles doivent être fatiguées après tout ça<nbsp>!
msgctxt "NpcYell:13771:0:13"
msgid "Look how calm the chickens are! They must be exhausted after all that."
msgstr "Смотрите, куры успокоились! Наверное, вымотались после такой суматохи."

#. ja: まだ逃げてるやつらがいるんだ…<br>追い込んだときは、頼むよ！
#. de: Ein paar Hasen sind noch übrig! Bitte lass keinen entwischen!
#. fr: Il y en a encore qui nous ont échappé<nbsp>! Je compte sur vous lorsqu'on les aura rattrapés<nbsp>!
msgctxt "NpcYell:13772:0:13"
msgid "There are still some stragglers. Let not a single bunny escape!"
msgstr "Ещё несколько кроликов убежали. Когда загоните их в угол, ни одного не упустите!"

#. ja: よしよし、農場に帰ろうな
#. de: Zeit nach Hause zu gehen, Mädels.
#. fr: Mais oui, mes jolies<nbsp>! Allez, rentrons à la ferme.
msgctxt "NpcYell:13773:0:13"
msgid "All right, my pretties. Back to the coop we go."
msgstr "Ну-ну, красавицы. Возвращаемся в курятник."

#. ja: ひぃぃ、待ってーッ！
#. de: Heee, bleibt gefälligst hier!
#. fr: Aaaah<nbsp>! Attendez<nbsp>!
msgctxt "NpcYell:13774:0:13"
msgid "W-Wait! Come back here!"
msgstr "П-постойте! Вернитесь!"

#. ja: どうやったら<br>捕まえられるんだ…
#. de: Kennt denn niemand eine bessere Fangmethode?
#. fr: Comment faire pour les rattraper...
msgctxt "NpcYell:13775:0:13"
msgid "How are we supposed to catch these things?"
msgstr "Да как их вообще поймать?"

#. ja: うぅ…とにかく<br>すぐに追わないと…
#. de: Egal wie, wir müssen dranbleiben!
#. fr: Bon... De toute façon il faut les suivre<nbsp>!
msgctxt "NpcYell:13776:0:13"
msgid "Just try to stay with them as best you can!"
msgstr "Просто старайтесь не отставать!"

#. ja: ヒュー！<br>敢闘賞はもらいだなッ！
#. de: Was für ein Glück, dass ich da bin!
#. fr: Pfiou<nbsp>! Heu<shy>reu<shy>se<shy>ment que je suis là<nbsp>!
msgctxt "NpcYell:13777:0:13"
msgid "You can thank me later."
msgstr "Поблагодаришь меня потом."

#. ja: さあ、急ごう！
#. de: Schnell weiter!
#. fr: Pressons le pas<nbsp>!
msgctxt "NpcYell:13778:0:13"
msgid "Onward!"
msgstr "Вперёд!"

#. ja: 英雄サンは任せたぜぇ！
#. de: Das überlasse ich <if $gn4>unserer Heldin<else>unserem Helden</if>!
#. fr: Je vous confie notre <if $gn4>grande héroïne<else>grand héros</if>, Votre Éminence<nbsp>!
msgctxt "NpcYell:13779:0:13"
msgid "Hurry, Leveilleur!"
msgstr "Быстрее, Левельёр!"

#. ja: お偉いサンを<br>信じてたぜッ！
#. de: Ich wusste, dass man auf dich zählen kann!
#. fr: Je savais qu'on pouvait compter sur vous, Votre Éminence<nbsp>!
msgctxt "NpcYell:13780:0:13"
msgid "Well played."
msgstr "Отлично сыграно."

#. ja: 身の程をわきまえるクポ！
#. de: Kennt eure Grenzen, kupo!
#. fr: Vous ne valez rien, kupo<nbsp>!
msgctxt "NpcYell:13781:0:13"
msgid "Know your place!"
msgstr "Знай своё место!"

#. ja: グルグルいくクポ！
#. de: Wir sind auf alles gefasst, kupo!
#. fr: On est plus prêts que jamais, kupo<nbsp>!
msgctxt "NpcYell:13782:0:13"
msgid "Have at thee, kupo!"
msgstr "Ну, держись, купо!"

#. ja: バラバラになるクポ！
#. de: Wir reißen euch in Stücke, kupo!
#. fr: On va vous réduire en miettes, kupo<nbsp>!
msgctxt "NpcYell:13783:0:13"
msgid "We'll tear you to pieces, kupo!"
msgstr "Разорвём вас на куски, купо!"

#. ja: 押しつぶされるがいいクポ！
#. de: Alle werden vor meiner Macht erzittern, kupo!
#. fr: On va vous écraser, kupo<nbsp>!
msgctxt "NpcYell:13784:0:13"
msgid "All will tremble before my might!"
msgstr "Все трепещите перед моей мощью!"

#. ja: 大地の力を<br>押し付けるクポー！
#. de: Nehmt das, kupo!
#. fr: Tremblez devant la grandeur terrestre, kupo<nbsp>!
msgctxt "NpcYell:13785:0:13"
msgid "Take this!"
msgstr "Получай!"

#. ja: 回復するクポー！
#. de: Hilfe ist unterwegs, kupo!
#. fr: Je vais vous soigner, kupo<nbsp>!
msgctxt "NpcYell:13786:0:13"
msgid "Help is on the way, kupo!"
msgstr "Помощь уже в пути, купо!"

#. ja: モグの歌を聴けクポ！
#. de: Hört unser Lied, kupo!
#. fr: Écoutez un peu notre chant, kupo<nbsp>!
msgctxt "NpcYell:13787:0:13"
msgid "Hearken to the song of my people!"
msgstr "Внемлите песне моего народа!"

#. ja: モ、モグの本気を<br>見せつけるクポ～！
#. de: Jetzt setzt es was, kupo!
#. fr: V-vous allez voir ce qu'on sait faire, kupo<nbsp>!
msgctxt "NpcYell:13788:0:13"
msgid "Y-You're in for it now, kupo!"
msgstr "Т-теперь вам не поздоровится, купо!"

#. ja: 魔力メラメラクポ！
#. de: Werdet Zeugen unserer Macht, kupo!
#. fr: Attention, ça va chauffer, kupo<nbsp>!
msgctxt "NpcYell:13789:0:13"
msgid "Bear witness to the power of kupo!"
msgstr "Узрите мощь купо!"

#. ja: ハハハ！<br>滾ってきたよのう！
#. de: Haha! Hier, das ist für den nächsten Tanz!
#. fr: Ha ha ha<nbsp>! Je sens la chaleur monter<nbsp>!
msgctxt "NpcYell:13790:0:13"
msgid "Hahaha! I've quite warmed to you!"
msgstr "Ха-ха-ха! Ну и разогрелся же я!"

#. ja: 燎原の炎よ…走れ…！
#. de: Das Feuer soll wüten!
#. fr: Tout feu, tout flammes<nbsp>!
msgctxt "NpcYell:13791:0:13"
msgid "Let the fires rage!"
msgstr "Пусть огонь бушует!"

#. ja: 吹き飛べッ！
#. de: Weg mit euch!
#. fr: Allumeeer le feuuu<nbsp>!
msgctxt "NpcYell:13792:0:13"
msgid "Brace yourselves!"
msgstr "Держитесь!"

#. ja: いくぞ！
#. de: Nehmt das!
#. fr: On y va<nbsp>!
msgctxt "NpcYell:13793:0:13"
msgid "To arms!"
msgstr "К оружию!"

#. ja: 迎撃する！
#. de: Zum Gegenangriff!
#. fr: Interceptons l'ennemi<nbsp>!
msgctxt "NpcYell:13794:0:13"
msgid "Attack!"
msgstr "В контратаку!"

#. ja: 押し込め！
#. de: Drängt sie in die Enge!
#. fr: Mettons-leur la pression<nbsp>!
msgctxt "NpcYell:13795:0:13"
msgid "Corner them!"
msgstr "Загоните их в угол!"

#. ja: 打ち払う！
#. de: Schaltet sie aus!
#. fr: Arrière, vermine<nbsp>!
msgctxt "NpcYell:13796:0:13"
msgid "Take them out!"
msgstr "Покончите с ними!"

#. ja: 全力でいくぞ！
#. de: Mit voller Kraft!
#. fr: Allez, du nerf<nbsp>!
msgctxt "NpcYell:13797:0:13"
msgid "Hold nothing back!"
msgstr "В полную силу!"

#. ja: やってやる！
#. de: Nieder mit euch!
#. fr: Saleté<nbsp>!
msgctxt "NpcYell:13798:0:13"
msgid "Down with you!"
msgstr "Сдохни!"

#. ja: 強壮剤を使うぞ！
#. de: Setzt euer Fortis ein!
#. fr: Je prends du fortis<nbsp>!
msgctxt "NpcYell:13799:0:13"
msgid "Using Fortis!"
msgstr "Использую Фортис!"

#. ja: クッ…<br>私が狙われている！？
#. de: Verflucht!
#. fr: Par Thaliak, il porte son attention sur moi<nbsp>!?
msgctxt "NpcYell:13800:0:13"
msgid "Dammit!"
msgstr "Проклятье!"

#. ja: 動力系に異常？<br>無理をさせすぎたか…
#. de: Na große Klasse! Das Antriebssystem ist überlastet<nbsp>...
#. fr: Aïe, ses moteurs sont grillés...
msgctxt "NpcYell:13801:0:13"
msgid "Damn it, looks like the core is gone..."
msgstr "Чёрт, похоже, ядро вышло из строя..."

#. ja: どうやら魔導アーマーは<br>ここまでのようだ
#. de: Das war es dann wohl mit der Kampfmaschine.
#. fr: Cette armure magitek est bonne pour la casse.
msgctxt "NpcYell:13802:0:13"
msgid "This armor won't be taking another step."
msgstr "Эта броня больше не сдвинется с места."

#. ja: ヤツは手強い相手だぞ<br>気をつけてくれ…！
#. de: Unterschätze den Feind nicht.<br>Ich will dich heil wiedersehen!
#. fr: Fais gaffe, c'est une coriace<nbsp>!
msgctxt "NpcYell:13803:0:13"
msgid "The rest is up to you, my friend. Take care!"
msgstr "Остальное за тобой, друг. Береги себя!"

#. ja: クッ…退け、退くのだ！<br>命を無駄にするな…！
#. de: Genug! Zieh dich zurück!
#. fr: Grr... Toi, ne te sacrifie pas bêtement<nbsp>! Sauve-toi<nbsp>!
msgctxt "NpcYell:13804:0:13"
msgid "Flee, damn you! Don't throw your lives away!"
msgstr "Отступай, проклятье! Не бросайте свои жизни на ветер!"

#. ja: すまない、ここは頼んだぞ！
#. de: Los, schalte ihn aus!
#. fr: Mince... À toi de jouer<nbsp>!
msgctxt "NpcYell:13805:0:13"
msgid "Be careful, now!"
msgstr "Будь осторожен!"

#. ja: 消しとべ！
#. de: Lasst mich dieses armselige Schauspiel beenden.
#. fr: Il suffit maintenant<nbsp>!!
msgctxt "NpcYell:13806:0:13"
msgid "Begone!"
msgstr "Прочь!"

#. ja: そこだ！
#. de: Hahahaha!
#. fr: Ha ha ha ha<nbsp>!
msgctxt "NpcYell:13807:0:13"
msgid "Hahahaha!"
msgstr "Ха-ха-ха-ха!"

#. ja: 闇の力に抗っただと！？
#. de: Unmöglich! Niemand trotzt der Dunkelheit!
#. fr: Tu as résisté au pouvoir des Ténèbres<nbsp>!?
msgctxt "NpcYell:13808:0:13"
msgid "You withstood the Darkness!? Impossible!"
msgstr "Ты устоял перед Тьмой!? Невозможно!"

#. ja: 貴様アアアッ！<br>よくも我が配下をォォォ！
#. de: Nein! Wie kannst du es wagen, meine Männer so zuzurichten!
#. fr: Mes hommes<nbsp>! Ordure, tu vas me le payer<nbsp>!!!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:13809:0:13"
msgid "Nooo! You...you <i>bastard</i>!"
msgstr "Нееет! Ты... ты <i>ублюдок</i>!"

#. ja: ウオォォォォッ！
#. de: Grrroooaaah!
#. fr: Wouooooooh<nbsp>!
msgctxt "NpcYell:13810:0:13"
msgid "Yaaaaaargggh!"
msgstr "Аааааррргх!"

#. ja: グアアアアッ…！
#. de: Aaarrrgh!
#. fr: Guaaaaah<nbsp>!
msgctxt "NpcYell:13811:0:13"
msgid "Aaarrrgh!"
msgstr "Ааааррргх!"

#. ja: ●焔扇よ…舞え…！
#. de: 0
#. fr: 0
msgctxt "NpcYell:13812:0:13"
msgid "●焔扇よ…舞え…！"
msgstr "●Огненный веер... пляши...!"

#. ja: 所詮は悪あがき…<br>この程度ということか…
#. de: Mehr hast du nicht zu bieten?<br>Hmpf. Ganz wie erwartet<nbsp>...
#. fr: Et voilà. Preuve est faite que ta lutte a toujours été vaine...
msgctxt "NpcYell:13813:0:13"
msgid "Hmph. Yours was always a vain struggle."
msgstr "Хм. Твоя борьба всегда была тщетной."

#. ja: すまない、助かった…
#. de: Danke für die Hilfe.
#. fr: Merci pour votre assistance.
msgctxt "NpcYell:13814:0:13"
msgid "My thanks."
msgstr "Благодарю."

#. ja: グッ…<br>まだ膝をつくわけには…
#. de: Argh. Ich gehe<nbsp>... wieder zu Boden<nbsp>...
#. fr: Argh... Je dois... encore tenir...
msgctxt "NpcYell:13815:0:13"
msgid "They've not won yet..."
msgstr "Они ещё не победили..."

#. ja: 道が開けました！
#. de: Uns öffnet sich ein Pfad!
#. fr: La voie est libre<nbsp>!
msgctxt "NpcYell:13816:0:13"
msgid "The path has been revealed!"
msgstr "Путь открыт!"

#. ja: 今が好機だ！
#. de: Jetzt oder nie!
#. fr: Maintenant<nbsp>!
msgctxt "NpcYell:13817:0:13"
msgid "The winds favor us!"
msgstr "Ветер за нас!"

#. ja: 打ち負かすッ！
#. de: Ich werde keinen Schritt weichen!
#. fr: Je ne flancherai pas<nbsp>!
msgctxt "NpcYell:13818:0:13"
msgid "Down with you!"
msgstr "Сгинь!"

#. ja: 必ず救ってみせる！<br>エピメイリス！
#. de: Ich hole dich da raus! Epimeleia!
#. fr: Je vais vous tirer de là<nbsp>!<br>Epimeleia<nbsp>!
msgctxt "NpcYell:13819:0:13"
msgid "I have you!"
msgstr "Я тебя спасу! Эпимелейя!"

#. ja: まだだ…！<br>この心、まだ折れてなどッ！
#. de: Meine Seele wehrt sich noch!
#. fr: Mon corps est meurtri... mais mon âme résiste toujours<nbsp>!
msgctxt "NpcYell:13820:0:13"
msgid "We mustn't yield. Not now!"
msgstr "Нельзя сдаваться. Не сейчас!"

#. ja: 終わる、の…か…
#. de: Ist das<nbsp>... mein Ende?
#. fr: Est-ce que c'est... la fin<nbsp>?
msgctxt "NpcYell:13821:0:13"
msgid "Is it...over?"
msgstr "Неужели... всё кончено?"

#. ja: む、無念…
#. de: Nein<nbsp>...
#. fr: Misère...
msgctxt "NpcYell:13822:0:13"
msgid "No..."
msgstr "Нет..."

#. ja: あまるじゃノ呪具ヨ<br>起動スルノダ！
#. de: Die Kanonen abfeuern!
#. fr: Activation des armes sacrées amalj'aa<nbsp>!
msgctxt "NpcYell:13823:0:13"
msgid "FiRe ThE cAnNoNs!"
msgstr "СТРЕЛЯЙТЕ ИЗ ПУШЕК!"

#. ja: ザルに転じようぞ！
#. de: Sie gehören dir, Thal.
#. fr: Ils sont à toi, Thal<nbsp>!
msgctxt "NpcYell:13824:0:13"
msgid "Thal, they are yours!"
msgstr "Тал, они твои!"

#. ja: ザルの力を受けてみよ！
#. de: Erfahrt die Macht von Thal!
#. fr: Vous allez goûter au pouvoir de Thal<nbsp>!
msgctxt "NpcYell:13825:0:13"
msgid "You will feel Thal's power!"
msgstr "Почувствуйте силу Тала!"

#. ja: さあ転換だ、ザルよ！
#. de: Zeit für einen Wechsel, Thal.
#. fr: À toi de jouer, Thal<nbsp>!
msgctxt "NpcYell:13826:0:13"
msgid "Thal, let us change!"
msgstr "Тал, теперь твоя очередь!"

#. ja: ナルに替わろうぞ…
#. de: Du bist dran, Nald.
#. fr: C'est ton tour... Nald...
msgctxt "NpcYell:13827:0:13"
msgid "Nald, it is your turn."
msgstr "Нальд, теперь ты."

#. ja: ナルの威光を受けよ…
#. de: Erfahrt die Glorie von Nald!
#. fr: Souffrez... Devant le pouvoir de Nald...
msgctxt "NpcYell:13828:0:13"
msgid "Bask in Nald's divinity."
msgstr "Узрите божественную силу Нальда."

#. ja: 任せたぞ、ナルよ…
#. de: Ich überlasse sie dir, Nald.
#. fr: Nald... Je m'en remets à toi...
msgctxt "NpcYell:13829:0:13"
msgid "Nald, I leave them to you."
msgstr "Нальд, они на тебе."

#. ja: 人の力量は<br>この程度か…？
#. de: Ist das das ganze Können der Sterblichen?
#. fr: Voilà les limites de l'humanité...<nbsp>?
msgctxt "NpcYell:13830:0:13"
msgid "Is this the limit of mankind?"
msgstr "Неужели это предел человеческих сил?"

#. ja: 判じようぞ…
#. de: Macht euch bereit.
#. fr: Soyez prêts...
msgctxt "NpcYell:13831:0:13"
msgid "Prepare yourselves."
msgstr "Приготовьтесь."

#. ja: 地底の国へと<br>誘ってやろう…
#. de: Ich weise euch den Weg in die Unterwelt.
#. fr: Accompagnez-moi dans l'au-delà...
msgctxt "NpcYell:13832:0:13"
msgid "I will show you to the Underworld."
msgstr "Я провожу вас в преисподнюю."

#. ja: 侵入者だ、迎撃するぞ！
#. de: Eindringlinge!
#. fr: Des intrus<nbsp>! À l'attaque<nbsp>!
msgctxt "NpcYell:13833:0:13"
msgid "We have hostiles! To arms!"
msgstr "Враг! К оружию!"

#. ja: 警報を鳴らせ！
#. de: Alarmiert alle Einheiten!
#. fr: Sonnez l'alarme<nbsp>!
msgctxt "NpcYell:13834:0:13"
msgid "Sound the alarm!"
msgstr "Поднимайте тревогу!"

#. ja: おい！<br>そこの者、止まれ！
#. de: Bis hierhin und nicht weiter!
#. fr: Toi, là-bas<nbsp>! Pas un geste<nbsp>!
msgctxt "NpcYell:13835:0:13"
msgid "Hold it right there!"
msgstr "Стоять! Ни с места!"

#. ja: 侵入者か！？
#. de: Zu den Waffen!
#. fr: Des intrus<nbsp>!?
msgctxt "NpcYell:13836:0:13"
msgid "Intruders!"
msgstr "Незваные гости!"

#. ja: いつの間に…！
#. de: Wie seid ihr hier reingekommen?!
#. fr: D'où sortent-ils<nbsp>!?
msgctxt "NpcYell:13837:0:13"
msgid "How did they get here!?"
msgstr "Как они сюда пробрались?!"

#. ja: 証文に反応し<br>明かりが灯ったようですね
#. de: Seht. Die Lampen entzünden sich im Angesicht der Glyphe.
#. fr: Regardez, les lanternes s'allument sur notre passage.
msgctxt "NpcYell:13838:0:13"
msgid "Behold. The lanterns ignite in the glyph's presence."
msgstr "Смотрите. При свете глифы загораются."

#. ja: 探求の旅の<br>第一歩としましょう
#. de: Und so wandeln wir wieder auf unbekannten Pfaden.
#. fr: Voici notre premier pas vers une nouvelle aventure.
msgctxt "NpcYell:13839:0:13"
msgid "And thus we take our first step into the unknown."
msgstr "Так мы и делаем первый шаг навстречу неизведанному."

#. ja: この島に<br>海底遺跡への入口が…？
#. de: Hier soll er also irgendwo sein, der Eingang zu Alzadaals Schatzkammer<nbsp>...
#. fr: L'entrrrée du palais se trouve vraiment sur cette île<nbsp>?
msgctxt "NpcYell:13840:0:13"
msgid "This isle is where we find the vault's entrance?"
msgstr "Значит, вход в сокровищницу — на этом острове?"

#. ja: さて、地図の真偽を<br>確かめるとしようか
#. de: Jetzt wird sich zeigen, wie <i>echt</i> diese Karte tatsächlich ist.
#. fr: Voyons voir si cette carte est authentique ou non.
msgctxt "NpcYell:13841:0:13"
msgid "Time to learn just how authentic our map truly is..."
msgstr "Пора выяснить, настоящая ли наша карта..."

#. ja: 冒険の始まりだな！
#. de: So beginnt unser Abenteuer!
#. fr: En avant pour l'aventurrre<nbsp>!
msgctxt "NpcYell:13842:0:13"
msgid "Our adventure begins!"
msgstr "Ну что, приключение начинается!"

#. ja: 巧妙な仕掛けですね…
#. de: Welch kurioser Zauber<nbsp>...
#. fr: Quel dispositif étonnant...
msgctxt "NpcYell:13843:0:13"
msgid "What a peculiar enchantment..."
msgstr "Какие занятные чары..."

#. ja: あら、何か反応が？
#. de: Abermals tut die Glyphe ihr Werk.
#. fr: Tiens, on dirait que le symbole réagit à nouveau.
msgctxt "NpcYell:13844:0:13"
msgid "The glyph works its magic once more..."
msgstr "Смотрите, глиф снова сработал..."

#. ja: 橋が現れた…<br>いや、隠されていたのか！
#. de: Eine spontan beschworene Brücke oder lediglich durch Magie verborgen?
#. fr: Le pont est apparrru d'un coup<nbsp>! Non, je pense qu'il était simplement dissimulé.
msgctxt "NpcYell:13845:0:13"
msgid "A bridge out of thin air...or cleverly hidden!"
msgstr "Мост возник из ниоткуда... Хотя нет, он был искусно спрятан!"

#. ja: 隠されていた橋が<br>現れたんだ
#. de: Mir scheint, hier war magische Unsichtbarkeit am Werk.
#. fr: Le sorrrt d'invisibilité a été levé.
msgctxt "NpcYell:13846:0:13"
msgid "An invisibility spell removed, mayhap?"
msgstr "Может, с моста просто сняли чары невидимости?"

#. ja: 珍しい種のクラゲですね<br>刺胞にはご注意を…
#. de: Eine höchst seltene Spezies. Und eine überaus giftige, wenn ich mir die Farben so ansehe.
#. fr: C'est une espèce très rare de méduse. Attention aux piqûres<nbsp>!
msgctxt "NpcYell:13847:0:13"
msgid "'Tis a rare breed of jellyfish─one with a sting, I imagine."
msgstr "Редкая порода медуз — и, похоже, жалит."

#. ja: 濃密なエーテルの<br>持ち主のようね
#. de: Diese Kreatur scheint vor Äther regelrecht zu strahlen.
#. fr: Cette créature dégage un éther très dense...
msgctxt "NpcYell:13848:0:13"
msgid "My, what dense aether this creature has."
msgstr "Ничего себе, сколько эфира в этой твари."

#. ja: 先に進むには<br>倒すしかなさそうだな…
#. de: Das schwabbelige Ding versperrt uns den Weg.
#. fr: Il va falloir se débarrasser de cette chose si on veut avancer.
msgctxt "NpcYell:13849:0:13"
msgid "This gelatinous eyesore bars our path."
msgstr "Эта слизкая гадость преграждает нам путь."

#. ja: 珍しい種のクラゲです<br>刺胞にはご注意を…
#. de: Eine höchst seltene Spezies. Und eine überaus giftige, wenn ich mir die Farben so ansehe.
#. fr: C'est une espèce très rare de méduse. Attention aux piqûres<nbsp>!
msgctxt "NpcYell:13850:0:13"
msgid "'Tis a rare breed of jellyfish─one with a sting, I imagine."
msgstr "Редкая порода медуз — и, похоже, жалит."

#. ja: さて、障害は<br>排除しましたが…
#. de: Damit wäre eine weitere Hürde überwunden. Wohin als nächstes?
#. fr: Un obstacle de plus hors de notre chemin... Par où aller désormais<nbsp>?
msgctxt "NpcYell:13851:0:13"
msgid "Might that device be our sought-after “entrance”?"
msgstr "Неужели это и есть искомый «вход»?"

#. ja: 先に進んでみましょう<br>転移装置がありそうよ
#. de: Nur weiter. Dort vorne scheint mir eine Art Teleporter zu sein.
#. fr: Avançons un peu. Il doit bien y avoir un téléporteur pour accéder aux fonds marins.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13852:0:13"
msgid "Shall we move on?<br>That looks to be a teleporter."
msgstr "Пойдёмте дальше.<br>Похоже, там телепортатор."

#. ja: チッ…イカなら<br>食えたんだがな…
#. de: Wäre es wenigstens ein Kalmar gewesen, hätten wir uns über Rationen freuen können.
#. fr: Tssk... Si seulement c'était un calmar, on aurait pu en faire un bon en-cas.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13853:0:13"
msgid "If only it had been a squid.<br>Imagine all the dried rations..."
msgstr "Вот был бы это кальмар...<br>Хватило бы на сушёную провизию."

#. ja: そんなことより<br>先に進むわよ
#. de: Danke, aber nein danke. Gehen wir weiter.
#. fr: Très peu pour moi. Allons-y.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13854:0:13"
msgid "I'd rather not.<br>Oh look, is that a teleporter?"
msgstr "Я бы не стала.<br>О, гляньте, там телепортатор?"

#. ja: これが名太守の宝物殿…<br>興味深い構造です
#. de: Dies muss sie sein, die Schatzkammer. Welch faszinierende Architektur!
#. fr: Voilà donc le palais caché du satrape... Quelle architecture fascinante<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13855:0:13"
msgid "This must be the satrap's vault.<br>Such fascinating design..."
msgstr "Должно быть, это сокровищница сатрапа.<br>Какая удивительная архитектура..."

#. ja: 随分深くまで<br>転移したようね…
#. de: Wir dürften mittlerweile reichlich tief sein.
#. fr: On a été transportés plus pro<shy>fon<shy>dé<shy>ment que je ne l'imaginais.
msgctxt "NpcYell:13856:0:13"
msgid "We've descended quite some distance..."
msgstr "Кажется, мы переместились довольно глубоко..."

#. ja: 見てくれ…！<br>正面に海底が見えるぞ！
#. de: Seht nur! Wir stehen tatsächlich am Grund des Myriadenmeers!
#. fr: Regardez, on peut voirrr la mer de l'Abondance<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13857:0:13"
msgid "Look!<br>We're deep under the Bounty!"
msgstr "Смотрите!<br>Мы глубоко под Морем Изобилия!"

#. ja: 海の底に沈む遺跡…<br>地図は本物だったらしいな
#. de: Der Meeresgrund<nbsp>... Hält die Karte also doch, was sie verspricht.
#. fr: On est vraiment sous la mer... La carte était vraie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13858:0:13"
msgid "The ocean floor...<br>The map was no fake after all."
msgstr "Дно океана...<br>Выходит, карта и правда настоящая."

#. ja: どうやら地図は<br>本物だったらしいな…
#. de: So war die Karte also wirklich echt.
#. fr: Au final, notre carte n'était pas une fausse...
msgctxt "NpcYell:13859:0:13"
msgid "Then our map was no fake after all."
msgstr "Значит, карта всё-таки настоящая."

#. ja: なるほど…防備の構成は<br>覚えておきましょう…
#. de: Diese Mechanismen muss ich mir ein<shy>prägen<nbsp>...
#. fr: Très intéressant... Je devrais prendre note des divers mécanismes de défense.
msgctxt "NpcYell:13860:0:13"
msgid "I must needs memorize these defenses..."
msgstr "Надо запомнить эти способы защиты..."

#. ja: この防備の厚さ…<br>本命は近そうだぞ！
#. de: Den endlosen Fallen zufolge muss der Schatz ganz in der Nähe sein!
#. fr: Vu les moyens employés pour nous arrêter, je crrrois que nous touchons au but.
msgctxt "NpcYell:13861:0:13"
msgid "Judging by these defenses, we must be nearing the treasure!"
msgstr "Судя по такой мощной защите, сокровище уже близко!"

#. ja: やれやれ、遺跡の守護者は<br>お怒りのようだな
#. de: Ich glaube, wir haben die Wächter wütend gemacht.
#. fr: Eh beh... Les gardiens du palais sont sacrément remontés.
msgctxt "NpcYell:13862:0:13"
msgid "We appear to have angered the vault guardians."
msgstr "Похоже, мы разозлили стражей сокровищницы."

#. ja: 月の相談役さんは<br>例によって真面目なのね
#. de: Es freut mich, dass du deine ratgebende Rolle so überaus ernst nimmst.
#. fr: Cette histoire de consultant n'était pas qu'un simple prétexte à ce que je vois<nbsp>!
msgctxt "NpcYell:13863:0:13"
msgid "You are really quite serious about this consulting role of yours."
msgstr "Ты и правда всерьёз относишься к своей роли советника."

#. ja: やはり防備の要は<br>機械式に限るようですね
#. de: Zumindest scheinen die Wächter allesamt mechanischer Natur.
#. fr: Comme je m'en doutais, les sentinelles sont majoritairement des créations mécaniques.
msgctxt "NpcYell:13864:0:13"
msgid "Hm. The key guardians appear mechanical in nature."
msgstr "Хм. Похоже, главные стражи — механические."

#. ja: この程度の仕掛けで<br>止められなくてよ？
#. de: Es wird schon mehr brauchen, um uns von dieser Expedition abzubringen.
#. fr: Ce genre d'artifices ne nous arrêtera pas.
msgctxt "NpcYell:13865:0:13"
msgid "It will take more than this to halt our expedition."
msgstr "Нас такими уловками не остановить."

#. ja: これまでの守護者とは<br>違う種類のようだな…！
#. de: Ein mehr als würdiger Gegner! Bleibt wachsam!
#. fr: Cette sentinelle a l'airrr plus coriace que les autres. Restez sur vos gardes.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13866:0:13"
msgid "A formidable-looking foe.<br>Be on your guard!"
msgstr "С виду грозный противник.<br>Будьте начеку!"

#. ja: 観察もいいけど<br>回復は抜かりなく頼むぞ！
#. de: Bitte vergiss über all deinen architektonischen Studien das Heilen nicht.
#. fr: Je comprrrends ton envie de prendre des notes, mais n'oublie pas que tu es notre soigneur avant tout<nbsp>!
msgctxt "NpcYell:13867:0:13"
msgid "Please remember to heal whilst you take notes!"
msgstr "Не забывай лечить нас, пока записываешь наблюдения!"

#. ja: 攻撃方法その他…<br>仔細に報告しておきましょう
#. de: Angriffsmuster, Verhaltensprotokoll<nbsp>... So viele Aspekte, die es zu berichten gilt.
#. fr: Entre le placement des gardes et leurs méthodes d'attaque... Il y a tant de choses à retenir.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13868:0:13"
msgid "Attack routines, behavioral patterns...<br>There is much to report."
msgstr "Приёмы атак, повадки...<br>О многом придётся доложить."

#. ja: さあ、進みましょう…
#. de: Nun weiter.
#. fr: Alors, on continue<nbsp>?
msgctxt "NpcYell:13869:0:13"
msgid "Shall we continue onwards?"
msgstr "Ну что, пойдём дальше?"

#. ja: よし、この試練も突破だ！<br>次に行こう！
#. de: Eine weitere Hürde ist überwunden! Die nächste wartet vermutlich gleich ums Eck.
#. fr: Encorrre une embûche de surmontée<nbsp>! En avant pour la suite<nbsp>!
msgctxt "NpcYell:13870:0:13"
msgid "Another obstacle overcome! Now on to the next!"
msgstr "Ещё одно препятствие позади! Теперь к следующему!"

#. ja: レポリットたちが<br>変に誤解しないといいが…
#. de: Bleibt nur zu hoffen, dass die Loporrit deine Daten nicht<nbsp>... fehlinterpretieren.
#. fr: J'espèrrre que les Loporrites ne se feront pas de fausses idées sur les goûts des aventuriers...
msgctxt "NpcYell:13871:0:13"
msgid "I only hope the Loporrits do not “misinterpret” the data."
msgstr "Надеюсь, Лопорриты не станут «неверно истолковывать» данные."

#. ja: 眩い黄金こそが<br>期待感を高める、と…
#. de: Berge von Gold, um Geist wie Auge zu blenden. Vermerkt.
#. fr: Des montagnes de pièces d'or pour motiver les explorateurs... C'est noté<nbsp>!
msgctxt "NpcYell:13872:0:13"
msgid "Mountains of gold to dazzle the eye. Noted."
msgstr "Горы золота ослепят любого. Записано."

#. ja: 最深層に入った<br>ということかしら？
#. de: Dies ist dann wohl der Kern der Schatzkammer, hm?
#. fr: Je pense qu'on a atteint les profondeurs du palais. Que reste-t-il à découvrir...<nbsp>?
msgctxt "NpcYell:13873:0:13"
msgid "I assume we've reached the vault's inner chambers, then?"
msgstr "Полагаю, мы добрались до внутренних покоев сокровищницы?"

#. ja: こいつは…<br>地図代に釣りが出そうだ
#. de: Dieses Vermögen macht den Preis der Karte mehr als wett.
#. fr: Ouf... Voilà qui devrait recouvrir le coût de la carte<nbsp>!
msgctxt "NpcYell:13874:0:13"
msgid "Aye...this should more than cover the price of the map."
msgstr "Да уж... Этого с лихвой хватит, чтобы окупить карту."

#. ja: ところで貴方<br>いくら支払ったの？
#. de: Sag ... Wie viel hast du letztlich dafür ausgegeben?
#. fr: Attends une seconde, tu l'as payée combien<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:13875:0:13"
msgid "How much <i>did</i> you pay for it, anyway?"
msgstr "А сколько <i>ты заплатил</i> за неё, кстати?"

#. ja: 予想外の進路の解放…<br>驚きの演出ですね
#. de: Geheime Türen und versteckte Pfade. Ja, das darf wahrlich nicht fehlen.
#. fr: Une pièce secrète qui ne se révèle qu'après un combat... C'est noté<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13876:0:13"
msgid "Secret doors, hidden paths.<br>More elements to consider."
msgstr "Тайные двери, скрытые проходы.<br>Надо учесть и это."

#. ja: まだ奥があるのか…！
#. de: Die Kammern nehmen kein Ende!
#. fr: Il reste encorrre des salles à explorer<nbsp>!?
msgctxt "NpcYell:13877:0:13"
msgid "There are yet more rooms beyond!?"
msgstr "Там ещё есть комнаты?!"

#. ja: この先に<br>どんな宝があるのやら…
#. de: Was für Reichtümer wohl noch auf uns warten?
#. fr: Je me demande quel genre de trésor est caché là...
msgctxt "NpcYell:13878:0:13"
msgid "What other riches might this one vault hold?"
msgstr "Сколько же ещё сокровищ хранит эта сокровищница?"

#. ja: すっかり<br>宝物殿評論家だな…
#. de: Du wirst uns noch zu einer wahren Schatzkammern-Koryphäe.
#. fr: Tu vas devenirrr un véritable expert en caches au trésor<nbsp>!
msgctxt "NpcYell:13879:0:13"
msgid "Ere long, you shall be a veritable vault expert!"
msgstr "Ещё немного — и станешь настоящим знатоком сокровищниц!"

#. ja: 魔法人形のようですが…
#. de: Das ist zweifelsohne ein arkanes Konstrukt<nbsp>...
#. fr: On dirait une sorte d'automate magique...
msgctxt "NpcYell:13880:0:13"
msgid "'Tis some manner of arcane automaton..."
msgstr "Похоже на какого-то магического автоматона..."

#. ja: エーテルを帯びた<br>シルクを巻いているようね…
#. de: Seine Seidenbänder sind mit Äther angereichert.
#. fr: Il est enroulé dans des tissus imprégnés d'éther...
msgctxt "NpcYell:13881:0:13"
msgid "'Tis wrapped in aether-imbued silks..."
msgstr "Он обмотан шёлком, пропитанным эфиром..."

#. ja: 宝の番人とは<br>いかにもだな！
#. de: Was ist das denn für eine überdimensionierte Marionette?
#. fr: Voilà donc le gardien principal de ce palais<nbsp>!
msgctxt "NpcYell:13882:0:13"
msgid "What is this oversized mammet?"
msgstr "И что это за здоровенный маммет?"

#. ja: ただの飾りではない<br>ということでしょうか…
#. de: Das sind also nicht bloß hübsche Verzierungen.
#. fr: Ce ne sont pas de simples co<shy>quet<shy>te<shy>ries alors... À quoi peuvent-ils servir<nbsp>?
msgctxt "NpcYell:13883:0:13"
msgid "No mere adornments, then."
msgstr "Значит, это не просто украшения."

#. ja: くっ…<br>皆、大丈夫かい？
#. de: Urgh, mein Kopf<nbsp>... Sind alle in Ordnung?
#. fr: Oh, ma tête... Tout le monde va bien<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13884:0:13"
msgid "My head...<br>Is everyone all right?"
msgstr "Голова...<br>Все целы?"

#. ja: お、覚えてなさい…！
#. de: Das wirst du - urgh - bereuen!
#. fr: Ah... Tu vas me le... urgh... payer<nbsp>!
msgctxt "NpcYell:13885:0:13"
msgid "You'll...ulp...pay for that!"
msgstr "Ты... ещё... за это ответишь!"

#. ja: 妙な手を使ってくれる…
#. de: Das war ... eine einzigartige Erfahrung.
#. fr: C'était une expérience... inattendue<nbsp>!
msgctxt "NpcYell:13886:0:13"
msgid "Well...that was an experience."
msgstr "Ну и... приключение."

#. ja: あのシルク…<br>錬金術の産物のようです
#. de: Faszinierende Fä<shy>hig<shy>kei<shy>ten. Synthetisiert mit alchemistischen Künsten, nehme ich an.
#. fr: Ces étoffes... Elles doivent être renforcées par un procédé alchimique.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13887:0:13"
msgid "Those silks...<br>Fashioned by alchemy, I suspect."
msgstr "Этот шёлк...<br>Похоже, его изготовили с помощью алхимии."

#. ja: 醜態だわ…
#. de: Das war unnötig ...
#. fr: Quelle attaque déplorable...
msgctxt "NpcYell:13888:0:13"
msgid "How undignified..."
msgstr "Какое унижение..."

#. ja: 息を整えて…<br>反撃に移るぞ！
#. de: Sammeln und gleich wieder in die Offensive!
#. fr: Reprenons-nous... pour mieux lancer la contrrre attaque<nbsp>!
msgctxt "NpcYell:13889:0:13"
msgid "We regroup...and counterattack!"
msgstr "Переведём дух... и контратакуем!"

#. ja: チッ…<br>面倒なことを…
#. de: Was soll der Unsinn?
#. fr: Tssk<nbsp>! Il est bien coriace<nbsp>!
msgctxt "NpcYell:13890:0:13"
msgid "What foolishness is this...?"
msgstr "Что ещё за глупости..."

#. ja: 落ち着いて…対処すれば…
#. de: Behaltet einen kühlen Kopf und es ist halb so wild.
#. fr: Restez calmes... On en arrivera à bout.
msgctxt "NpcYell:13891:0:13"
msgid "Keep your wits, and it's not so bad..."
msgstr "Главное — сохранять спокойствие, и всё будет не так страшно..."

#. ja: もう！<br>二度も同じ手に！
#. de: Schon wieder?! Ich kann wirklich drauf verzichten!
#. fr: Encore<nbsp>! Ça commence à bien faire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13892:0:13"
msgid "Again!?<br>Grrr, this is getting old!"
msgstr "Опять?!<br>Да сколько можно!"

#. ja: なんてザマだ…
#. de: Urgh ... Mir ist schlecht ...
#. fr: Ourf... Je me sens pas très bien...
msgctxt "NpcYell:13893:0:13"
msgid "Ulp... I think I might be sick..."
msgstr "Ух... Кажется, меня сейчас стошнит..."

#. ja: 錬金術の応用で<br>力を奪っているようですね
#. de: Dieser magische Stoff zehrt an unseren Kräften.
#. fr: Ce tissu altéré semble saper toute notre force.
msgctxt "NpcYell:13894:0:13"
msgid "The enchanted fabric saps our very strength."
msgstr "Зачарованная ткань высасывает из нас все силы."

#. ja: …燃やしましょう
#. de: Oh ... Jetzt wirst du mein Feuer spüren, Weber.
#. fr: Je vais le réduire en cendres...
msgctxt "NpcYell:13895:0:13"
msgid "Oh, you burn now, weaver."
msgstr "Ну что, ткач, сейчас я тебя подожгу."

#. ja: はぁはぁ…<br>負けるものか…！
#. de: Nur eben ... zu Atem kommen ...
#. fr: Hah... hah... Je n'ai pas dit mon derrrnier mot<nbsp>!
msgctxt "NpcYell:13896:0:13"
msgid "Just let...me catch...my breath!"
msgstr "Дайте... отдышаться..."

#. ja: 腕がなまったか…？<br>そう思いたくはないが…
#. de: Warum will mir kein Sprung gelingen?! Oh nein, das Curry<nbsp>...
#. fr: Pourquoi est-ce que je n'arrive pas à m'en extirper<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:13897:0:13"
msgid "Why can I not jump free?<br>Too much rich food of late..."
msgstr "Почему я никак не могу выпрыгнуть?<br>В последнее время слишком много жирного ел..."

#. ja: また妖異を<br>復活させるつもりか…！
#. de: Er will sie abermals auferstehen lassen!
#. fr: Il approvisionne ses créatures en éther...
msgctxt "NpcYell:13898:0:13"
msgid "He means to resurrect them again!"
msgstr "Он опять собирается воскресить их!"

#. ja: デカいのが来るぞ！
#. de: In Deckung, da ist was im Anmarsch!
#. fr: Attention, c'est du lourd<nbsp>!
msgctxt "NpcYell:13899:0:13"
msgid "Get clear!"
msgstr "Берегитесь!"

#. ja: ゼノスを倒した<br>だけのことはある
#. de: Es wundert mich nicht, dass du Zenos besiegt hast!
#. fr: En tout cas, tu n'as pas volé ta victoire contre Zenos...
msgctxt "NpcYell:13900:0:13"
msgid "The least I expected from the one who defeated Zenos."
msgstr "От победителя Зеноса я иного и не ожидал."

#. ja: このままでは…
#. de: Es nimmt kein Ende ...
#. fr: On ne tiendra pas longtemps à ce rythme...
msgctxt "NpcYell:13901:0:13"
msgid "This bodes ill..."
msgstr "Дело плохо..."

#. ja: 集まれ！<br>ひとりでは耐えられん！
#. de: Alle hierher! Das überstehen wir nur zusammen!
#. fr: Rassemblons-nous<nbsp>! Chacun de son côté, on y arrivera pas<nbsp>!
msgctxt "NpcYell:13902:0:13"
msgid "Quickly, stand together!"
msgstr "Скорее, держитесь вместе!"

#. ja: 妖異を結晶化するなんて…
#. de: Sie sind zu Kristall erstarrt?
#. fr: Incroyable... Les monstres se sont transformés en cristaux...
msgctxt "NpcYell:13903:0:13"
msgid "She can turn voidsent into crystal..."
msgstr "Она может превращать чудовищ из преисподней в кристаллы..."

#. ja: また妖異が湧いてきたか
#. de: Ugh, weitere Nichts<shy>gesand<shy>te.
#. fr: En voilà encore d'autres<nbsp>!
msgctxt "NpcYell:13904:0:13"
msgid "Reinforcements..."
msgstr "Подкрепление..."

#. ja: 好きにやらせてもらう
#. de: Ich mach das auf meine Weise.
#. fr: Tu ne m'impressiones pas.
msgctxt "NpcYell:13905:0:13"
msgid "I'll do this my way."
msgstr "Будет по-моему."

#. ja: フッ、やるな
#. de: Hmpf, du schlägst dich besser als gedacht.
#. fr: Eh ben, quel talent<nbsp>!
msgctxt "NpcYell:13906:0:13"
msgid "Hm, impressive."
msgstr "Хм, недурно."

#. ja: チッ…！
#. de: Ugh ...!
#. fr: Argh<nbsp>!
msgctxt "NpcYell:13907:0:13"
msgid "Ugh!"
msgstr "Уф!"

#. ja: ゼロを助けるぞ、相棒！
#. de: Wir müssen Zero da rausholen!
#. fr: Il faut sauver Zero, camarade<nbsp>!
msgctxt "NpcYell:13908:0:13"
msgid "Zero needs our help!"
msgstr "Зеро нужна наша помощь!"

#. ja: 借りができたな
#. de: Eine weitere Schuld, die ich begleichen muss<nbsp>...
#. fr: Décidément, je suis de plus en plus endettée...
msgctxt "NpcYell:13909:0:13"
msgid "Another debt to repay..."
msgstr "Ещё один долг, который придётся вернуть..."

#. ja: 皆、私のもとに<br>集まってくれ！
#. de: Zu mir, Freunde!
#. fr: Venez tous près de moi, vite<nbsp>!
msgctxt "NpcYell:13910:0:13"
msgid "Everyone, to me!"
msgstr "Все ко мне!"

#. ja: 押しきるぞ！
#. de: Jetzt oder nie, Freunde!
#. fr: C'est maintenant ou jamais<nbsp>!
msgctxt "NpcYell:13911:0:13"
msgid "Give it everything you've got!"
msgstr "Выложитесь на полную!"

#. ja: さぁ、もっとだ！<br>ガスを喰らえ！
#. de: Der Äther wird euch nähren!
#. fr: Vous reprendrez bien un peu de gaz<nbsp>!
msgctxt "NpcYell:13912:0:13"
msgid "Come, fill your lungs!"
msgstr "Ну же, дышите глубже!"

#. ja: 生かしてはおけぬ…！
#. de: Nichtsss wird von euch übrig sein!
#. fr: À mort<nbsp>! À moooort<nbsp>!!
msgctxt "NpcYell:13913:0:13"
msgid "You must die!"
msgstr "Вы должны умереть!"

#. ja: 我が剣技の餌食となれ！
#. de: Macht Bekanntschaft mit meiner Klinge!
#. fr: Je vais vous saigner à blanc<nbsp>!
msgctxt "NpcYell:13914:0:13"
msgid "My blade thirstsss for blood!"
msgstr "Мой клинок жаждет крови!"

#. ja: やれい！我がしもべたちよ！
#. de: In die Schlacht, meine Diener!
#. fr: En avant toute, mes mignons<nbsp>!
msgctxt "NpcYell:13915:0:13"
msgid "Deal with them, my minions!"
msgstr "Разберитесь с ними, мои слуги!"

#. ja: グギュウウ…<br>オナカ、スイタ…！
#. de: Guuuah ... Ich habe Hunger.
#. fr: Ugnuuuh... J'ai faim<nbsp>!!!
msgctxt "NpcYell:13917:0:13"
msgid "Unnngh... Hungry..."
msgstr "У-у-у... Есть..."

#. ja: タベモノ…ホシ、イ！
#. de: Essen ...
#. fr: Mangeeer...
msgctxt "NpcYell:13918:0:13"
msgid "Must feed..."
msgstr "Надо... пожрать..."

#. ja: タベモ、ノ、タベモノ…<br>ヨコセェエ…！
#. de: Ich will essen!
#. fr: Moi vouloir... à bouffer<nbsp>!
msgctxt "NpcYell:13919:0:13"
msgid "So hungry... Must feed—must feast!"
msgstr "Так голодно... Есть... Жрать хочу!"

#. ja: ググ、ギュグァアアアア！
#. de: Grrr ... Guuuah!
#. fr: Guhuuuh... Gruaaaaah<nbsp>!
msgctxt "NpcYell:13920:0:13"
msgid "Grrruuugh... Graaahhh!"
msgstr "Гр-р-р... А-а-а-а!"

#. ja: この力で排除する！
#. de: Du bist mir nicht gewachsen!
#. fr: Disparaissez<nbsp>!
msgctxt "NpcYell:13921:0:13"
msgid "Begone."
msgstr "Прочь!"

#. ja: ここで消えてもらう
#. de: In die Vergessenheit!
#. fr: Hors de mon chemin<nbsp>!
msgctxt "NpcYell:13922:0:13"
msgid "That's far enough."
msgstr "Дальше не пройдёшь."

#. ja: くらえ！
#. de: Nieder mit dir!
#. fr: Finissons-en<nbsp>!
msgctxt "NpcYell:13923:0:13"
msgid "Got you!"
msgstr "Получай!"

#. ja: 受けてみろ！
#. de: Erwischt!
#. fr: Voilà pour vous<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:13924:0:13"
msgid "This <i>will</i> hurt."
msgstr "Это <i>будет</i> больно."

#. ja: 私に服従し<br>奴らを倒すのだ…！
#. de: Reißt sssie in Stücke, meine Diener!
#. fr: À moi, mes serviteurs<nbsp>! Détruisez nos ennemis<nbsp>!
msgctxt "NpcYell:13925:0:13"
msgid "Go forth and smite my foes!"
msgstr "Вперёд, покарайте моих врагов!"

#. ja: もっと数を増やすか…
#. de: Mehr, ich brauche mehr ...
#. fr: Et si j'en ressuscitais d'autres...
msgctxt "NpcYell:13926:0:13"
msgid "More... I need more servants..."
msgstr "Ещё... Мне нужно больше слуг..."

#. ja: 忠誠を示すがよい！
#. de: Beweissst mir eure Loyalität!
#. fr: Montrez-moi votre loyauté<nbsp>!
msgctxt "NpcYell:13927:0:13"
msgid "Prove your loyalty to me!"
msgstr "Докажите мне свою верность!"

#. ja: この城には<br>ロクな奴がおらん…！
#. de: Ist diese Burg denn voller Taugenichtssse?!
#. fr: Ce château est-il uniquement rempli de bons à rien<nbsp>!?
msgctxt "NpcYell:13928:0:13"
msgid "Isn't there a soul worth a damn in this castle!?"
msgstr "В этом замке вообще есть хоть кто-нибудь, кто чего-то стоит?!"

#. ja: こっちよ！
#. de: Hierher!
#. fr: Par ici<nbsp>!
msgctxt "NpcYell:13929:0:13"
msgid "Over here!"
msgstr "Сюда!"

#. ja: いくらでもかかってこい
#. de: Nur weiter!
#. fr: Qu'ils y viennent<nbsp>!
msgctxt "NpcYell:13930:0:13"
msgid "Hmph, let them come."
msgstr "Хм, пусть подходят."

#. ja: 厄介な相手ね…！
#. de: Ein zähes Bürschchen ...
#. fr: Quel adversaire redoutable...
msgctxt "NpcYell:13931:0:13"
msgid "A troublesome foe..."
msgstr "Непростый противник..."

#. ja: あ、ありえぬ…<br>この私が、敗れるなどッ！
#. de: U-Unmöglich! Ich soll unterlegen sein?!
#. fr: Quoi<nbsp>!? Je vais perdre<nbsp>!? Impossible<nbsp>!
msgctxt "NpcYell:13932:0:13"
msgid "No... I cannot─will not─lose!"
msgstr "Нет... Не могу... не проиграю!"

#. ja: 不覚だ…
#. de: Verdammt ...
#. fr: Je te quitte enfin... monde cruel...
msgctxt "NpcYell:13933:0:13"
msgid "Damn it..."
msgstr "Проклятье..."

#. ja: 光を闇に還そうぞ！
#. de: Dunkelheit wird das Licht verschlingen!
#. fr: Les Ténèbres consumeront la Lumière<nbsp>!
msgctxt "NpcYell:13935:0:13"
msgid "Darkness shall consume Light!"
msgstr "Тьма поглотит Свет!"

#. ja: 爆ぜよ、混沌の力…！
#. de: Chaos regiert die Welt!
#. fr: Le chaos régnera pour l'éternité<nbsp>!
msgctxt "NpcYell:13937:0:13"
msgid "Chaos shall reign forevermore!"
msgstr "Хаос будет править вечно!"

#. ja: 思い知るがいい…！
#. de: Jetzt lernt ihr Respekt!
#. fr: Restez à votre place<nbsp>!
msgctxt "NpcYell:13938:0:13"
msgid "Know your place!"
msgstr "Знай своё место!"

#. ja: 消え失せろ！
#. de: Das Licht soll erlöschen!
#. fr: Que la Lumière disparaisse<nbsp>!
msgctxt "NpcYell:13941:0:13"
msgid "Your Light shall burn no more!"
msgstr "Твой Свет погаснет навеки!"

#. ja: アナイアレイション…！
#. de: Alles soll vergehen!
#. fr: Il ne restera plus rien<nbsp>!
msgctxt "NpcYell:13942:0:13"
msgid "Nothing shall remain!"
msgstr "Ничего не останется!"

#. ja: 消え失せろっ！
#. de: Dein Licht muss erlöschen!
#. fr: Que la Lumière disparaisse<nbsp>!
msgctxt "NpcYell:13943:0:13"
msgid "Your Light shall burn no more!"
msgstr "Твой Свет погаснет навеки!"

#. ja: 受け取れ、ラハブレア！
#. de: Mein Leben ist dein, Lahabrea!
#. fr: Voilà pour toi, Lahabrea<nbsp>!
msgctxt "NpcYell:13944:0:13"
msgid "Partake of my life, Lahabrea!"
msgstr "Прими мою жизнь, Лахабрея!"

#. ja: 消滅など許さぬ、イゲオルム！
#. de: Eine Niederlage ist inakzeptabel, Igeyorhm!
#. fr: L'échec n'est pas une option, Igeyorhm<nbsp>!
msgctxt "NpcYell:13945:0:13"
msgid "Defeat is unacceptable, Igeyorhm!"
msgstr "Поражение недопустимо, Игейорм!"

#. ja: オラッ、行くぜ！
#. de: Nimm das!
#. fr: Attention, j'arrive<nbsp>!
msgctxt "NpcYell:13951:0:13"
msgid "Here I go!"
msgstr "Ну, держись!"

#. ja: 俺の技をくらえ！
#. de: Koste meinen Stahl!
#. fr: Goûte à ma technique<nbsp>!
msgctxt "NpcYell:13952:0:13"
msgid "Taste my axe!"
msgstr "Отведай моего топора!"

#. ja: うおおおおおッ！
#. de: Gaaaaaaah!
#. fr: Wouoooooh<nbsp>!
msgctxt "NpcYell:13953:0:13"
msgid "Yaaaaaargh!"
msgstr "О-о-о-о-о!"

#. ja: この距離ならッ！
#. de: In Reichweite!
#. fr: Aucun problème à cette distance<nbsp>!
msgctxt "NpcYell:13954:0:13"
msgid "I'm going in!"
msgstr "В самый раз!"

#. ja: 敵の目を引きつける！
#. de: Ich spiele den Lockvogel!
#. fr: J'attire l'ennemi<nbsp>!
msgctxt "NpcYell:13955:0:13"
msgid "I'll draw the enemy!"
msgstr "Я отвлеку врага!"

#. ja: これが俺の力だッ！
#. de: Spüre meine Wut!
#. fr: Tu vas voir ce que j'ai dans le ventre<nbsp>!
msgctxt "NpcYell:13956:0:13"
msgid "Feel my fury!"
msgstr "Почувствуй мою ярость!"

#. ja: 行かせてもらうぜッ！
#. de: Mein Auftritt!
#. fr: Je m'en charge<nbsp>!
msgctxt "NpcYell:13957:0:13"
msgid "Chaaaaaarge!"
msgstr "Вперёд!"

#. ja: 皆の方には行かせねえ！
#. de: Hier spielt die Musik!
#. fr: Tu ne toucheras pas à mes camarades<nbsp>!
msgctxt "NpcYell:13958:0:13"
msgid "You won't touch my comrades!"
msgstr "К моим товарищам не подберёшься!"

#. ja: 昂ぶれ、冒険者魂ッ！
#. de: Der Zorn brennt in mir!
#. fr: Mon âme d'aventurier s'embrase<nbsp>!
msgctxt "NpcYell:13959:0:13"
msgid "My adventurer's soul burns!"
msgstr "Душа авантюриста пылает!"

#. ja: 冒険者部隊の意地を<br>見せてやるぜッ！
#. de: Abenteurer geben nicht auf!
#. fr: Pour mes compagnons<nbsp>!
msgctxt "NpcYell:13960:0:13"
msgid "Adventurers never give up!"
msgstr "Авантюристы не сдаются!"

#. ja: もう一度前に出るぞッ！
#. de: Nicht nachlassen!
#. fr: J'y retourne<nbsp>!
msgctxt "NpcYell:13961:0:13"
msgid "Back to it!"
msgstr "Я снова в строю!"

#. ja: く、訓練したとおりに…
#. de: G-Genau wie im Training<nbsp>...
#. fr: Allez hop, comme à l'en<shy>traî<shy>ne<shy>ment...
msgctxt "NpcYell:13962:0:13"
msgid "Right, just like in training..."
msgstr "Так, как учили на тренировках..."

#. ja: 教わったこの技なら…！
#. de: Damit klappt es!
#. fr: On va voir si ce que j'ai appris est utile<nbsp>!
msgctxt "NpcYell:13964:0:13"
msgid "Time to put this technique to use!"
msgstr "Пора опробовать этот приём!"

#. ja: 今ならこの技も…！
#. de: Wie wäre es hiermit?!
#. fr: Cette technique devrait faire l'affaire<nbsp>!
msgctxt "NpcYell:13965:0:13"
msgid "This ought to do the trick!"
msgstr "Вот это должно сработать!"

#. ja: 覚えたての技だけど…！
#. de: Mein neuestes Kunststück!
#. fr: Essayons d'innover<nbsp>!
msgctxt "NpcYell:13966:0:13"
msgid "Something new I learned!"
msgstr "Новый приём, который я выучил!"

#. ja: 限界を超えてみせる！
#. de: Mit voller Kraft!
#. fr: Je me surpasserai s'il le faut<nbsp>!
msgctxt "NpcYell:13967:0:13"
msgid "No holding back!"
msgstr "Не сдерживаться!"

#. ja: この技で貫く！
#. de: Einer meiner besten Angriffe!
#. fr: À mon tour de briller<nbsp>!
msgctxt "NpcYell:13968:0:13"
msgid "I'll pierce the way!"
msgstr "Проложу путь этим приёмом!"

#. ja: これが冒険で鍛えた技よ！
#. de: Das Ergebnis harten Trainings!
#. fr: Je l'ai travaillée, celle-là<nbsp>!
msgctxt "NpcYell:13969:0:13"
msgid "A technique I honed on my adventures!"
msgstr "Приём, отточенный в приключениях!"

#. ja: 限界の先を見せるわ！
#. de: Grenzen sind zum Überwinden da!
#. fr: Cette fois, je me lâche<nbsp>!
msgctxt "NpcYell:13970:0:13"
msgid "The mind is the only limit!"
msgstr "Предел — лишь в голове!"

#. ja: 何度だって<br>立ち上がってみせるわ…
#. de: Nur wer hinfällt, lernt, wieder aufzustehen!
#. fr: L'important, c'est de se relever<nbsp>!
msgctxt "NpcYell:13971:0:13"
msgid "I'll get up as often as it takes!"
msgstr "Буду подниматься снова и снова..."

#. ja: えっと～雷よ～
#. de: E-Es regne, ähm<nbsp>... Blitze!
#. fr: Que la foudre te, euh... foudroie<nbsp>!
msgctxt "NpcYell:13972:0:13"
msgid "L-Lightning...er, strike!"
msgstr "М-молния... то есть, ударь!"

#. ja: う～んと～炎よ～
#. de: E-Es brenne das<nbsp>... Feuer!
#. fr: Que les flammes te, hum... brûlent<nbsp>!
msgctxt "NpcYell:13973:0:13"
msgid "F-Fire...er, scorch!"
msgstr "О-огонь... то есть, пылай!"

#. ja: 星さん、降り注げ～
#. de: Sterne, ich, ähm<nbsp>... bitte um eure Kraft!
#. fr: Ahem. Q-que choient les étoiles<nbsp>!
msgctxt "NpcYell:13974:0:13"
msgid "S-Stars above...er, descend!"
msgstr "З-звёзды... падайте с небес!"

#. ja: 激しき雷よ～！
#. de: Es hagle Blitze!
#. fr: Que la foudre s'abatte sur toi<nbsp>!
msgctxt "NpcYell:13975:0:13"
msgid "Lightning scour you!"
msgstr "Жестокая молния, порази их!"

#. ja: 猛き炎よ～！
#. de: Es lodere das Feuer!
#. fr: Que les flammes t'emportent<nbsp>!
msgctxt "NpcYell:13976:0:13"
msgid "Flames consume you!"
msgstr "Пламя, поглоти их!"

#. ja: 星よ、降り注げ～！
#. de: Sterne, schenkt mir eure Kraft!
#. fr: Que choient les étoiles<nbsp>!
msgctxt "NpcYell:13977:0:13"
msgid "Stars rain death upon you!"
msgstr "Звёзды, обрушьте на них смерть!"

#. ja: その力解き放て～！
#. de: Grollender Donner, gehorche!
#. fr: Déchaîne-toi, ô puissance fulgurante<nbsp>!
msgctxt "NpcYell:13978:0:13"
msgid "Puissant lightning, unleash your power!"
msgstr "Молния, высвободи свою силу!"

#. ja: 裁きの手をかざせ～！
#. de: Lodernde Flammen, gehorchet!
#. fr: Dansez, ô flammes du jugement<nbsp>!
msgctxt "NpcYell:13979:0:13"
msgid "Flames of judgment, blaze and burn!"
msgstr "Пламя суда, пылай и жги!"

#. ja: これが奥の手だ～！
#. de: Zeit für unsere Trumpfkarte!
#. fr: Bien, il est temps de jouer mon va-tout<nbsp>!
msgctxt "NpcYell:13980:0:13"
msgid "Time to use my trump card!"
msgstr "Пора сыграть моим козырем!"

#. ja: もう一度、がんばります～！
#. de: Gleich noch einmal!
#. fr: Allez, on se ressaisit<nbsp>!
msgctxt "NpcYell:13981:0:13"
msgid "Right, let's try this again!"
msgstr "Так, попробуем ещё раз!"

#. ja: あわわ…回復しないと！
#. de: M-Moment! Ich heile dich!
#. fr: Oh là là, il faut soigner ça tout de suite<nbsp>!
msgctxt "NpcYell:13982:0:13"
msgid "H-Hold on, I'll heal you!"
msgstr "Ой-ой... надо тебя вылечить!"

#. ja: し、しまった…起きてくれ！
#. de: Oh nein! Bitte nicht aufgeben!
#. fr: O-oh non<nbsp>! R-réveille-toi, par pitié<nbsp>!
msgctxt "NpcYell:13983:0:13"
msgid "O-Oh no! Get up, please!"
msgstr "О-ой нет... Встань, прошу!"

#. ja: こ、攻撃…よし！
#. de: I-Ich ... greife an!
#. fr: J-je passe à l'attaque<nbsp>!
msgctxt "NpcYell:13984:0:13"
msgid "A-A chance to attack!"
msgstr "Ш-шанс атаковать!"

#. ja: ここで皆を回復…！
#. de: Heilung für alle!
#. fr: Des soins pour tout le monde<nbsp>!
msgctxt "NpcYell:13985:0:13"
msgid "Healing for all!"
msgstr "Исцелю всех!"

#. ja: もう一度、立ち上がれ！
#. de: Hoch mit dir!
#. fr: Debout<nbsp>!
msgctxt "NpcYell:13986:0:13"
msgid "On your feet!"
msgstr "Поднимайся!"

#. ja: 今なら、攻撃できる…！
#. de: Jetzt kann ich angreifen!
#. fr: C'est le moment d'attaquer<nbsp>!
msgctxt "NpcYell:13987:0:13"
msgid "My chance to strike!"
msgstr "Сейчас я могу атаковать!"

#. ja: まとめて回復する！
#. de: Ich kümmere mich um euch!
#. fr: Quelqu'un a demandé des soins<nbsp>?
msgctxt "NpcYell:13988:0:13"
msgid "I'll tend your hurts!"
msgstr "Сейчас всех подлечу!"

#. ja: さあ、立ち上がって！<br>反撃といこう！
#. de: Und weiter! Es ist noch nicht vorbei!
#. fr: Allez, on se relève<nbsp>!
msgctxt "NpcYell:13989:0:13"
msgid "You're not finished yet!"
msgstr "Ты ещё не закончила!"

#. ja: こちらも攻撃に回る！
#. de: Zum Angriff! Jetzt!
#. fr: Je passe à l'attaque moi aussi<nbsp>!
msgctxt "NpcYell:13990:0:13"
msgid "I'm going on the attack!"
msgstr "Я тоже перехожу в наступление!"

#. ja: すまん…復帰する！
#. de: Vergebt mir! Ich werde besser achtgeben!
#. fr: Navré, ça n'arrivera plus<nbsp>!
msgctxt "NpcYell:13991:0:13"
msgid "Forgive me..."
msgstr "Прости..."

#. ja: ギギッ…！
#. de: Grrrrh!
#. fr: Grrgghh...
msgctxt "NpcYell:13994:0:13"
msgid "Graaagggh... "
msgstr "Гр-р-р-а-а-а... "

#. ja: ギョロロ…！
#. de: Raaargh ...
#. fr: Grrooohh...
msgctxt "NpcYell:13995:0:13"
msgid "Arrrgggh..."
msgstr "А-а-р-р-р..."

#. ja: ギチギチ…！
#. de: Krch ...
#. fr: Ghiighii...
msgctxt "NpcYell:13996:0:13"
msgid "Hurrrghhh..."
msgstr "Хр-р-р..."

#. ja: ニンゲン…<br>御馳走だァ！
#. de: Sterbliche! Köstliche Sterbliche!
#. fr: Des humains... On va se régaler...<nbsp>!
msgctxt "NpcYell:13997:0:13"
msgid "Mortals! Delicious mortals!"
msgstr "Смертные! Вкусные смертные!"

#. ja: 美味そう…<br>喰わせろ！
#. de: Her mit eurem Äther!
#. fr: Donnez-moi votre éther...<nbsp>!
msgctxt "NpcYell:13998:0:13"
msgid "Give me your aether!"
msgstr "Отдай мне свой эфир!"

#. ja: 侵入者だと！？
#. de: Eindringlinge?!
#. fr: Des intrus...<nbsp>!?
msgctxt "NpcYell:13999:0:13"
msgid "Intruders!"
msgstr "Незваные гости!"
