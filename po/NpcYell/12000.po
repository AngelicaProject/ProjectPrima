msgstr "0"

#. ja: 索敵中…索敵中…
#. de: Suchvorgang läuft<nbsp>...
#. fr: Recherche en cours... Recherche...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12218:0:13"
msgid "Scanning for targets...<br>Scanning for targets..."
msgstr "Сканирую цели...<br>Сканирую цели..."

#. ja: 次はこっちだ！
#. de: Jetzt hier!
#. fr: Par ici<nbsp>!
msgctxt "NpcYell:12219:0:13"
msgid "This way!"
msgstr "Сюда!"

#. ja: 軍人さんか！<br>いいところに来てくれた！
#. de: Ein Soldat! Du kommst genau richtig.
#. fr: Un soldat<nbsp>! Vous tombez bien<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12220:0:13"
msgid "You're one of us, right?<br>We need your help!"
msgstr "Ты же наш? Помоги нам!"

#. ja: いま応援に行くからな…！
#. de: Ich eile zur Verstärkung!
#. fr: Je vais aller chercher des renforts<nbsp>!
msgctxt "NpcYell:12221:0:13"
msgid "We'll make it out of this─together!"
msgstr "Выберемся отсюда... вместе!"

#. ja: 恩に着る…！
#. de: Hab Dank ...
#. fr: On vous en doit une<nbsp>!
msgctxt "NpcYell:12222:0:13"
msgid "We owe you one!"
msgstr "Мы у тебя в долгу!"

#. ja: だ、大丈夫か！
#. de: Geht's?
#. fr: T-tout le monde va bien<nbsp>?
msgctxt "NpcYell:12223:0:13"
msgid "Is everyone all right!?"
msgstr "Все целы?!"

#. ja: あ、ありがてぇ…！
#. de: Danke ...
#. fr: M-merci...
msgctxt "NpcYell:12224:0:13"
msgid "Thanks, stranger!"
msgstr "Спасибо, незнакомец!"

#. ja: みんな…！<br>避難所に生きて戻るぞ！
#. de: Bringt euch in Sicherheit!
#. fr: Allez tout le monde<nbsp>! Au refuge, vite<nbsp>!
msgctxt "NpcYell:12225:0:13"
msgid "We have to get back to the shelter!"
msgstr "Нам нужно вернуться в убежище!"

#. ja: ち、ちくしょう…
#. de: Verdammt!
#. fr: D-damnation<nbsp>!
msgctxt "NpcYell:12226:0:13"
msgid "Damn it..."
msgstr "Проклятье..."

#. ja: こんな…ところで…
#. de: Ausgerechnet hier<nbsp>...
#. fr: Pas... Comme ça...
msgctxt "NpcYell:12227:0:13"
msgid "What a way to go..."
msgstr "Вот так и погибнуть..."

#. ja: すまない…<br>青燐水を持ち、帰れ…
#. de: Nimm den Tank und bring ihn ins Lager!
#. fr: Je vous en prie... Prenez... le carburant...
msgctxt "NpcYell:12228:0:13"
msgid "Take...the fuel..."
msgstr "Возьми... топливо..."

#. ja: グホッ…
#. de: \<keuch>
#. fr: Kof<nbsp>! Ouargh...
msgctxt "NpcYell:12229:0:13"
msgid "Ack!"
msgstr "Ах!"

#. ja: ウゴ、ウゴゴゴゴ…！
#. de: Uoooh ...
#. fr: Gnnnn... Groaaaah<nbsp>!
msgctxt "NpcYell:12230:0:13"
msgid "Hnnngh... Hraaaghhh!"
msgstr "Нннх... Рааааргх!"

#. ja: く、くそ…！<br>機体が保たない…！
#. de: Verdammt! Es reicht nicht!
#. fr: Et merde<nbsp>! L'armure ne tiendra plus longtemps<nbsp>!
msgctxt "NpcYell:12231:0:13"
msgid "Agh! The machina's done for!"
msgstr "Ах! Меха больше не выдержит!"

#. ja: 帝国、ばん…ざい…
#. de: Lang lebe das Kaiserreich!
#. fr: G-gloire... À... Ga-Garlemald<nbsp>!
msgctxt "NpcYell:12232:0:13"
msgid "Glory...be..."
msgstr "Слава... Гарлемальду..."

#. ja: 栄光あれ…<br>栄光あれ…
#. de: Für Ruhm und Ehre ...
#. fr: Gloire... Gloire...
msgctxt "NpcYell:12233:0:13"
msgid "Glory be...to Garlemald..."
msgstr "Слава... Гарлемальду..."

#. ja: 複製開始！
#. de: Duplizierung gestartet.
#. fr: *Bip* Reproduction en cours<nbsp>! *Bip*
msgctxt "NpcYell:12234:0:13"
msgid "Synthesizing replicant..."
msgstr "Синтез репликанта..."

#. ja: 陣形変更…！
#. de: Formationswechsel bestätigt.
#. fr: *Bip* Recalibrage positionnel<nbsp>! *Bip*
msgctxt "NpcYell:12235:0:13"
msgid "Recalibrating..."
msgstr "Перенастройка..."

#. ja: アハハッ！
#. de: Hahaha!
#. fr: Ha ha ha ha<nbsp>!!!
msgctxt "NpcYell:12236:0:13"
msgid "Hahaha!"
msgstr "Ха-ха-ха!"

#. ja: ウフフ…
#. de: Hihihi ...
#. fr: Hé hé hé...
msgctxt "NpcYell:12237:0:13"
msgid "Tee hee hee..."
msgstr "Хи-хи-хи..."

#. ja: フンッ！
#. de: Hmpf!
#. fr: Hmpf<nbsp>!
msgctxt "NpcYell:12238:0:13"
msgid "Hmph!"
msgstr "Хм!"

#. ja: 手を貸そうぞ！
#. de: Lass mich helfen ...
#. fr: J'arrive à la rescousse<nbsp>!
msgctxt "NpcYell:12239:0:13"
msgid "I am with you, Sister!"
msgstr "Я с тобой, сестра!"

#. ja: 三姉妹の力を束ねれば…！
#. de: Drei Schwestern, eine Macht!
#. fr: Toutes unies pour terrasser<nbsp>!
msgctxt "NpcYell:12240:0:13"
msgid "The three stand as one!"
msgstr "Вместе мы — сила!"

#. ja: 斬るッ！
#. de: Mit dem Schwerte!
#. fr: Tranche<nbsp>!
msgctxt "NpcYell:12241:0:13"
msgid "By blade!"
msgstr "Клинком!"

#. ja: 光をッ！
#. de: Unbeugsames Licht!
#. fr: Ô, Lumière<nbsp>!
msgctxt "NpcYell:12242:0:13"
msgid "Light unyielding!"
msgstr "Светом непреклонным!"

#. ja: 周れッ！
#. de: Umschließe!
#. fr: Déploie-toi<nbsp>!
msgctxt "NpcYell:12243:0:13"
msgid "Whe'er near or far!"
msgstr "Будь близко ли, далеко!"

#. ja: 穿つッ！
#. de: Unbeugsame Kraft!
#. fr: Perce<nbsp>!
msgctxt "NpcYell:12244:0:13"
msgid "By force unrelenting!"
msgstr "Сокрушительной силой!"

#. ja: 幻の光よ！
#. de: Ewiger Glanz!
#. fr: Luminescence<nbsp>!
msgctxt "NpcYell:12245:0:13"
msgid "Refulgence eternal!"
msgstr "Вечное сияние!"

#. ja: 輝き放て！
#. de: Erstrahle!
#. fr: Par l'éclat infini<nbsp>!
msgctxt "NpcYell:12246:0:13"
msgid "Whe'er high or low!"
msgstr "Сияй во всю мощь!"

#. ja: オーレオール！
#. de: Aureole!
#. fr: Auréole<nbsp>!
msgctxt "NpcYell:12247:0:13"
msgid "Divine radiance!"
msgstr "Божественное сияние!"

#. ja: 集まって軽減するぞ！
#. de: Kommt zusammen, schnell!
#. fr: Tous avec moi<nbsp>!
msgctxt "NpcYell:12249:0:13"
msgid "Stay together!"
msgstr "Держимся вместе!"

#. ja: 分散して<br>攻撃を受け止めるのだ！
#. de: Verteilt euch!
#. fr: Séparons-nous pour le contrer<nbsp>!
msgctxt "NpcYell:12250:0:13"
msgid "Spread out!"
msgstr "Разойтись! Примите удар на себя!"

#. ja: 任せておきな！
#. de: Ich kümmere mich darum!
#. fr: Laissez-moi faire<nbsp>!
msgctxt "NpcYell:12251:0:13"
msgid "Leave it to me!"
msgstr "Предоставь это мне!"

#. ja: ここを撃ち抜いてやれば…！
#. de: Hier einmal reinballern ...
#. fr: Un coup bien senti ici...
msgctxt "NpcYell:12252:0:13"
msgid "Just one shot here, and..."
msgstr "Стоит попасть вот сюда..."

#. ja: とまぁ<br>こんな具合さ
#. de: Na, sieht doch schon besser aus!
#. fr: Parfait, juste comme ça<nbsp>!
msgctxt "NpcYell:12253:0:13"
msgid "Aye, there we go."
msgstr "Ну вот, готово."

#. ja: 偽神獣を牽制する！
#. de: Stoppt die Bestie!
#. fr: Il faut le retenir<nbsp>!
msgctxt "NpcYell:12254:0:13"
msgid "Keep the beast in check!"
msgstr "Сдержите чудовище!"

#. ja: 障壁に守られて<br>攻撃が通らないようだ！
#. de: Die Angriffe prallen am Schutzwall ab!
#. fr: Grrr... Nos attaques ne servent à rien<nbsp>!
msgctxt "NpcYell:12255:0:13"
msgid "That wall─our attacks cannot penetrate it!"
msgstr "Эта стена не пропускает наши атаки!"

#. ja: 障壁が破れたぞ！
#. de: Der Schutzwall ist zerstört!
#. fr: La barrière est tombée<nbsp>!
msgctxt "NpcYell:12256:0:13"
msgid "The wall has fallen!"
msgstr "Стена пала!"

#. ja: こっちだぜ！
#. de: Hier bin ich!
#. fr: Par ici<nbsp>!
msgctxt "NpcYell:12257:0:13"
msgid "Over here!"
msgstr "Я здесь!"

#. ja: 散開だ！
#. de: Ausschwärmen!
#. fr: On se disperse<nbsp>!
msgctxt "NpcYell:12258:0:13"
msgid "Spread out, all of ye!"
msgstr "Рассыпаться!"

#. ja: こうか…！
#. de: Schnell!
#. fr: Hop là<nbsp>!
msgctxt "NpcYell:12259:0:13"
msgid "Quickly!"
msgstr "Живо!"

#. ja: 新手か！
#. de: Noch mehr Gegner ...
#. fr: Des gêneurs<nbsp>!
msgctxt "NpcYell:12260:0:13"
msgid "They come in waves!"
msgstr "Они идут волнами!"

#. ja: お前の相手は<br>この俺だ！
#. de: Kuckuck, hier bin ich!
#. fr: C'est <i>moi</i> ton adversaire<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:12261:0:13"
msgid "<i>I'm</i> the one you want!"
msgstr "<i>Я</i> тебе нужен!"

#. ja: おっと<br>本命のお出ましだ！
#. de: Wird Zeit, mal ein bisschen aufzuräumen!
#. fr: Le moment de vérité<nbsp>!
msgctxt "NpcYell:12262:0:13"
msgid "The moment of truth!"
msgstr "Ну вот и решающий момент!"

#. ja: グオォォォ…
#. de: Uaaaaargh!
#. fr: Uuuooorrrghhh<nbsp>!
msgctxt "NpcYell:12263:0:13"
msgid "Gwoaaargggh!"
msgstr "Гвоааарргх!"

#. ja: 漏らすんじゃねえぞ<br>ウ・オド！
#. de: Mach jetzt bloß nicht in die Hose, U'odh!
#. fr: Fais pas tout foirer, U'odh<nbsp>!
msgctxt "NpcYell:12264:0:13"
msgid "Don't wet yourself, U'odh!"
msgstr "Смотри не обмочись, У'од!"

#. ja: バカには<br>付き合ってられんな
#. de: Natürlich nicht. Im Gegensatz zu dir trag ich keine Windeln!
#. fr: T'as pas intérrrêt à me gêner, Landenel<nbsp>!
msgctxt "NpcYell:12265:0:13"
msgid "Not to worry─unlike you, I'm not a baby."
msgstr "Не волнуйся, я-то не младенец."

#. ja: ブレイフロクス<br>参上～！
#. de: Pshkhooo!!!
#. fr: Psh<nbsp>! Brayflox, à l'attaaaque<nbsp>!
msgctxt "NpcYell:12266:0:13"
msgid "Pshhh... Brayflox make boom!"
msgstr "Пшш... Брейфлокс бах-бах!"

#. ja: あいつら…<br>待たせやがって
#. de: Das wurde aber auch Zeit!
#. fr: On a failli attendre<nbsp>!
msgctxt "NpcYell:12267:0:13"
msgid "It's about bloody time, ye bastards!"
msgstr "Дождались наконец, мерзавцы!"

#. ja: 視えたぜ！
#. de: Ha! Mich kriegst du nicht!
#. fr: Là<nbsp>!
msgctxt "NpcYell:12268:0:13"
msgid "All too easy."
msgstr "Проще простого."

#. ja: 来るぞ！
#. de: Aufgepasst!
#. fr: Attention<nbsp>!
msgctxt "NpcYell:12269:0:13"
msgid "It comes!"
msgstr "Осторожно!"

#. ja: うおおおお！<br>なんのこれしき！
#. de: Uoooh! Langsam macht mir die Sache Spaß!
#. fr: Yaaah<nbsp>! C'est pas ça qui nous aura<nbsp>!
msgctxt "NpcYell:12270:0:13"
msgid "Gahaha! I'm starting to enjoy this!"
msgstr "Ха-ха! Да мне это начинает нравиться!"

#. ja: くらいやがれェ！
#. de: Nimm das!
#. fr: Prends ça, sale bête<nbsp>!
msgctxt "NpcYell:12271:0:13"
msgid "Take this!"
msgstr "Получай!"

#. ja: 終わりにするぜ！
#. de: Ich sorg dafür, dass es bald zu Ende ist!
#. fr: Tu nous fais pas peurrr<nbsp>!
msgctxt "NpcYell:12272:0:13"
msgid "We finish it here."
msgstr "Покончим с этим здесь."

#. ja: 刈り取る…！
#. de: Erntezeit!
#. fr: Je vais t'écharper<nbsp>!
msgctxt "NpcYell:12273:0:13"
msgid "Mine for the taking!"
msgstr "Лёгкая добыча!"

#. ja: 見切れるか
#. de: Entkommst du dem?
#. fr: Ouvre bien les yeux.
msgctxt "NpcYell:12274:0:13"
msgid "A test of your reflexes!"
msgstr "Проверка на реакцию!"

#. ja: 仕留める…！
#. de: Feuer frei!
#. fr: Tu ne te relèveras pas<nbsp>!
msgctxt "NpcYell:12275:0:13"
msgid "I have you!"
msgstr "Ты попался!"

#. ja: くらうがいい！
#. de: Nimm das!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:12276:0:13"
msgid "Now fall!"
msgstr "Ну, падай!"

#. ja: はぁぁッ！
#. de: Haaa!
#. fr: Yaaaah<nbsp>!
msgctxt "NpcYell:12277:0:13"
msgid "Hyaaah!"
msgstr "Хья-а!"

#. ja: アヅイ…<br>アヅイヨォ…
#. de: Heiß ... so unerträglich heiß!
#. fr: MaMaN<nbsp>! Ça BrÛlE<nbsp>!
msgctxt "NpcYell:12278:0:13"
msgid "It burns... BuRnS!"
msgstr "Жжётся... ЖЖЁТСЯ!"

#. ja: イタイ、イタイ、イタイ…
#. de: Ah, der Schmerz. Argh ...
#. fr: J'aI mAl<nbsp>! J'aI mAl<nbsp>!!!
msgctxt "NpcYell:12279:0:13"
msgid "The pain..."
msgstr "Больно..."

#. ja: ビチャッ…<br>ジュルルルル…
#. de: \<zisch> Grrroar!
#. fr: PSCHAAAHHH... GRRRL...
msgctxt "NpcYell:12280:0:13"
msgid "\\<gurgle>"
msgstr ""

#. ja: イヤダ…<br>モ、ウ、イヤ、ダ…
#. de: \<blubber> W-Will ... nicht ... mehr ...
#. fr: FaItEs QuE çA s'ArRêTe... S'iL vOuS pLaÎt...<nbsp>!
msgctxt "NpcYell:12281:0:13"
msgid "It hurtsss!"
msgstr "Больнооо!"

#. ja: ニ、タイ…<br>コロ…シ、テ…
#. de: Bitte, töte ... mich.
#. fr: TuEz... TuEz... NoUs...
msgctxt "NpcYell:12282:0:13"
msgid "Kill...me..."
msgstr "Убей... меня..."

#. ja: お前の群れが<br>逃げ込んでこなければ…
#. de: Du und deine Herde seid hier nicht willkommen ...
#. fr: On n'en serait pas là si votre tribu était restée chez elle<nbsp>!
msgctxt "NpcYell:12283:0:13"
msgid "Your lot brought the pestilence! You!"
msgstr "Это твоя стая притащила заразу! Ты!"

#. ja: 出ていけ！<br>ここから出ていけ！
#. de: Verschwinde von hier! Verschwinde!
#. fr: Fiche le camp d'ici<nbsp>! On veut pas de toi<nbsp>!
msgctxt "NpcYell:12284:0:13"
msgid "Begone with you!"
msgstr "Убирайся!"

#. ja: 浄化だ！<br>今すぐ浄化するぞ！
#. de: Verschwinde, Unreiner!
#. fr: Faut le brûler avant qu'il nous contamine<nbsp>!
msgctxt "NpcYell:12285:0:13"
msgid "Purify them with fire, I say!"
msgstr "Очистите их огнём, говорю вам!"

#. ja: こんな事になるなんて<br>思わなかったんだ…
#. de: Es hätte nie soweit kommen dürfen ...
#. fr: C'est un cauchemar... Comment en est-on arrivé là...<nbsp>?
msgctxt "NpcYell:12286:0:13"
msgid "How did it come to this?"
msgstr "Как же до такого дошло?"

#. ja: 腐敗者が来たぞ！
#. de: Rennt! Die Verdorbenen sind hier!
#. fr: Les putréfiés sont là<nbsp>! Sauve qui peut<nbsp>!
msgctxt "NpcYell:12287:0:13"
msgid "The blighted! Run!"
msgstr "Заражённые! Бегите!"

#. ja: こっちに来ないで！
#. de: Bleib fern von mir!
#. fr: N'approchez pas<nbsp>!
msgctxt "NpcYell:12288:0:13"
msgid "Stay away!"
msgstr "Не подходи!"

#. ja: 逃げろ！<br>みんな逃げるんだ！
#. de: Flieht, lauft um euer Leben!
#. fr: Fuyez<nbsp>! Fuyez, bon sang<nbsp>!
msgctxt "NpcYell:12289:0:13"
msgid "Don't let them touch you!"
msgstr "Не дайте им до вас добраться!"

#. ja: 敵も味方も<br>皆、死んじまう…
#. de: Bis in den Tod, für die Föderation!
#. fr: On va tous y passer... Eux comme nous...
msgctxt "NpcYell:12290:0:13"
msgid "It means to kill us all!"
msgstr "Они всех нас перебьют!"

#. ja: この戦争を止めるんだ…
#. de: Wir werden diesen Krieg beenden!
#. fr: Faut que quelqu'un mette fin à cette guerre...
msgctxt "NpcYell:12291:0:13"
msgid "I have to end this!"
msgstr "Я должен положить этому конец!"

#. ja: 生き残るために<br>戦いを終わらせるんだ！
#. de: Wir müssen kämpfen, um zu überleben.
#. fr: Faut en finir<nbsp>! Sinon personne n'en sortira vivant<nbsp>!
msgctxt "NpcYell:12292:0:13"
msgid "If I can reach the terminal..."
msgstr "Если я доберусь до терминала..."

#. ja: に、逃げろーッ！
#. de: W-Weg hier! Flieht!
#. fr: F-fuyez<nbsp>!!!
msgctxt "NpcYell:12293:0:13"
msgid "Retreat! Retreat!"
msgstr "Отступаем! Отступаем!"

#. ja: 奴らを皆殺しにすれば<br>戦争は…終わるんだ…！
#. de: Wenn wir sie vernichten, werden wir endlich Frieden haben!
#. fr: La guerre prendra fin seulement quand on les aura tous abattus<nbsp>!
msgctxt "NpcYell:12294:0:13"
msgid "I did it! I killed them all!"
msgstr "Я сделал это! Всех перебил!"

#. ja: なんで…こんな力を<br>得ちまったんだ…ハハハ…
#. de: Mögen uns die Götter gnädig sein ...
#. fr: Ha ha... Pourquoi...<nbsp>? Pourquoi on a un jour cru avoir besoin de toutes ces armes...<nbsp>? Ha ha ha ha...
msgctxt "NpcYell:12295:0:13"
msgid "I...killed them all..."
msgstr "Я... перебил их всех..."

#. ja: うががががが…
#. de: Uooooh!
#. fr: Hnnngh...
msgctxt "NpcYell:12296:0:13"
msgid "Grrrnnnh..."
msgstr "Грррннх..."

#. ja: 駆逐、くち、く…<br>ぐぢぐぅぅぅ…
#. de: Weg mit dir, kusch!
#. fr: Chasser... Les survivants... Dehooors...
msgctxt "NpcYell:12297:0:13"
msgid "Must kill... Kill them all..."
msgstr "Убить... Убить их всех..."

#. ja: や、やっと出られた！<br>助かったよぉ～！
#. de: Der Ausgang, der Ausgaaang! Bei meinen Möhren, ich bin geretteeet!
#. fr: Je reconnais le chemin<nbsp>! Enfin bientôt la sortie<nbsp>!
msgctxt "NpcYell:12298:0:13"
msgid "Finally, I'm free! I...I think. I hope..."
msgstr "Наконец-то я свободен! Кажется... Надеюсь..."

#. ja: わわっ、顔のおばけだ！
#. de: Vorsicht! Der lächelt überhaupt gar nicht!
#. fr: Haaaaaaa<nbsp>! Des visages qui volent<nbsp>! Et y en a qui sont pas contents<nbsp>!
msgctxt "NpcYell:12299:0:13"
msgid "That face... That horrible face!"
msgstr "Это лицо... Ужасное лицо!"

#. ja: わーい、わーい！
#. de: Juhuuu!
#. fr: Ouiiiii<nbsp>!
msgctxt "NpcYell:12300:0:13"
msgid "Yaaay!"
msgstr "Ура-а-а!"

#. ja: ガンバレー！
#. de: Weiter so!
#. fr: Continue<nbsp>!
msgctxt "NpcYell:12301:0:13"
msgid "Keep going!"
msgstr "Давай, не останавливайся!"

#. ja: 走れ走れ～！
#. de: Los, schneller!
#. fr: Allez, plus vite<nbsp>!!!
msgctxt "NpcYell:12302:0:13"
msgid "Run! Faster!"
msgstr "Беги! Быстрее!"

#. ja: クッ<br>情けない…
#. de: Ssssh! Missst!
#. fr: Fsshhh... Désolé...
msgctxt "NpcYell:12303:0:13"
msgid "Pshhh... Forgive me..."
msgstr "Пшш... Прости меня..."

#. ja: いったん<br>退かせてもらう！
#. de: Rückzug! Fürsss Erste ...
#. fr: Je ne me sssens pas bien... Fsshhh...
msgctxt "NpcYell:12304:0:13"
msgid "Pshhh! Retreat!"
msgstr "Пшш! Отступаем!"

#. ja: ここまでか…
#. de: Dasss war's für uns ...
#. fr: Fsshhh... Ccc'est la fin...<nbsp>?
msgctxt "NpcYell:12305:0:13"
msgid "Is this the end for usss?"
msgstr "Это конец для нассс?"

#. ja: ヒトに続けぇ！
#. de: Folgt den Flosssenlosen!
#. fr: Fsshhh<nbsp>! Avec les sssans-branchies<nbsp>!
msgctxt "NpcYell:12306:0:13"
msgid "Follow the shhhorewalkers!"
msgstr "За береговыми!"

#. ja: この海を守るのだ！
#. de: Wir müsssen das Meer schützen!
#. fr: Tousss pour l'Indigo<nbsp>! Fsshhh<nbsp>!
msgctxt "NpcYell:12307:0:13"
msgid "We protect our sssea!"
msgstr "Защитим наше море!"

#. ja: 加勢するッ！
#. de: Wir sssind hier, um euch zu helfen!
#. fr: Fsshhh<nbsp>!
msgctxt "NpcYell:12308:0:13"
msgid "Pshhh! Let usss join you!"
msgstr "Пшшш! Дайте и нам с вами сразиться!"

#. ja: さあさあ、急いでください？
#. de: Schneller!
#. fr: Allez, allez, plus vite<nbsp>!
msgctxt "NpcYell:12309:0:13"
msgid "Quickly now!"
msgstr "Живее!"

#. ja: こちらですよ…！
#. de: Hier entlang!
#. fr: C'est par là<nbsp>!
msgctxt "NpcYell:12310:0:13"
msgid "Come along!"
msgstr "Сюда, за мной!"

#. ja: 扉がおかしなことに<br>なってるぞ！
#. de: Ich glaube, mit der Tür stimmt irgendwas nicht<nbsp>...
#. fr: L-les portes vont plus au bon endroit<nbsp>! C'est un vrai labyrinthe<nbsp>!
msgctxt "NpcYell:12311:0:13"
msgid "What in blazes is wrong with these doors!?"
msgstr "Какого чёрта творится с этими дверями?!"

#. ja: むむむ…あの道がこっちに…<br>なら、そっちはどっちに？
#. de: Wir müssen nach da hinten, und<nbsp>... Wartet, war da nicht gerade noch ein Weg? Verflixt und zugemümmelt<nbsp>...
#. fr: Ça me donne le tournis... Où est la sortie<nbsp>!?
msgctxt "NpcYell:12312:0:13"
msgid "Haven't I been here before...?"
msgstr "Да я здесь уже был..."

#. ja: はひぃ～！<br>出口はどこだよぉ～！
#. de: Wo ist der Ausgang?! Ich spring gleich im Dreieck!
#. fr: La sortie, la sortie<nbsp>! Où est la sortie<nbsp>!?
msgctxt "NpcYell:12313:0:13"
msgid "I'm never getting out of here, am I?"
msgstr "Я отсюда никогда не выберусь, да?"

#. ja: こっちだろ！
#. de: Hier lang, ganz sicher!
#. fr: C'est par là<nbsp>!
msgctxt "NpcYell:12314:0:13"
msgid "You've led us in circles again, you fat-tailed idiot!"
msgstr "Опять нас водишь кругами, жирнохвостый идиот!"

#. ja: あっちだろ！
#. de: Da drüben, ich weiß es genau!
#. fr: Mais pas du tout, faut faire demi-tour<nbsp>!
msgctxt "NpcYell:12315:0:13"
msgid "Oh yeah? Well...your mother smells like cabbage!"
msgstr "А вот у твоей мамаши изо рта капустой несёт!"

#. ja: あわわわ…<br>喧嘩しないでよ…！
#. de: ... Zwischen euren Löffeln ist nicht sonderlich viel Schmalz, was?
#. fr: Mais, mais... Vous battez pas...
msgctxt "NpcYell:12316:0:13"
msgid "\\<gasp> Why would you say that!?"
msgstr ""

#. ja: うわぁっ…！
#. de: Uaaaah!
#. fr: Aaaah<nbsp>!
msgctxt "NpcYell:12317:0:13"
msgid "By the gods..."
msgstr "Боги..."

#. ja: 痛えよぉ…
#. de: Es<nbsp>... tut so weh<nbsp>...
#. fr: J'ai maaal...
msgctxt "NpcYell:12318:0:13"
msgid "I'm done for..."
msgstr "Мне конец..."

#. ja: 嗚呼…<br>もう終わりなのか？
#. de: I-Ist das das Ende?
#. fr: Aaah... c'est... la fin<nbsp>?
msgctxt "NpcYell:12319:0:13"
msgid "The end has come!"
msgstr "Это конец!"

#. ja: 死にたくない…！
#. de: Ich will nicht! Ich will nicht sterben!
#. fr: Je veux pas mourir<nbsp>!
msgctxt "NpcYell:12320:0:13"
msgid "I can't die here!"
msgstr "Я не могу здесь умереть!"

#. ja: ●不要になりました
#. de: 0
#. fr: 0
msgctxt "NpcYell:12321:0:13"
msgid "0"
msgstr "0"

#. ja: ●不要になりました
#. de: 0
#. fr: 0
msgctxt "NpcYell:12322:0:13"
msgid "0"
msgstr "0"

#. ja: 終わりだ…<br>もう終わりなんだよぉ！
#. de: Es ist aus<nbsp>... Es ist alles aus!
#. fr: Aaaah<nbsp>! C'en est fini de nouuus<nbsp>!
msgctxt "NpcYell:12323:0:13"
msgid "It's all over! We're doomed!"
msgstr "Всё кончено! Нам крышка!"

#. ja: 嫌だ嫌だ嫌だぁぁぁ！
#. de: Neeein! Bitte nicht!
#. fr: Nooon<nbsp>! Par pitiééé<nbsp>!
msgctxt "NpcYell:12324:0:13"
msgid "No more! No more!"
msgstr "Хватит! Хватит!"

#. ja: 誰か…誰でもいい！<br>助けてくれ！
#. de: Hilfe! So helft mir doch!
#. fr: À l'aiiide<nbsp>! S'il vous plaîîît<nbsp>!
msgctxt "NpcYell:12325:0:13"
msgid "Please, somebody! Help us!"
msgstr "Кто-нибудь! Помогите нам!"

#. ja: 神獣様…神獣様…！
#. de: O ihr Götter, steht uns bei!
#. fr: On a pas mérité ça<nbsp>!
msgctxt "NpcYell:12326:0:13"
msgid "Divinities protect us!"
msgstr "Боги, защитите нас!"

#. ja: ●不要になりました
#. de: 0
#. fr: 0
msgctxt "NpcYell:12327:0:13"
msgid "0"
msgstr "0"

#. ja: もう大丈夫…
#. de: Euch wird nichts passieren.
#. fr: Vous êtes en sécurité, maintenant<nbsp>!
msgctxt "NpcYell:12328:0:13"
msgid "You're safe now."
msgstr "Теперь вы в безопасности."

#. ja: 深呼吸を…！
#. de: Tief einatmen.
#. fr: Respirez pro<shy>fon<shy>dé<shy>ment<nbsp>!
msgctxt "NpcYell:12329:0:13"
msgid "Easy now. Deep breaths."
msgstr "Тише. Дышите глубже."

#. ja: ダメだ…<br>もうダメだぁぁ…！
#. de: Ich kann nicht mehr!
#. fr: Aaaaaarrrggghhh<nbsp>!!!
msgctxt "NpcYell:12330:0:13"
msgid "There's no hope... No hope!"
msgstr "Надежды нет... Никакой надежды!"

#. ja: ひゃあっ…<br>ゴキ、ベキ、グギギ…
#. de: Grrr<nbsp>... Bih<nbsp>... Blaaargh!
#. fr: Aaaah<nbsp>!!! Rrr... Ggg... Grrr...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12331:0:13"
msgid "Ack!<br>Hrrrngh... Hhhngh!"
msgstr "А-а!<br>Хррр... Ххрр!"

#. ja: ぴちゃぴちゃぴちゃ…
#. de: \<schnatter>
#. fr: Grrrraaaaaarrrr<nbsp>!
msgctxt "NpcYell:12332:0:13"
msgid "Hhhschoooaaak!"
msgstr "Ххшшххх!"

#. ja: アハ、アハハハ…<br>ア、バ、バァァァッ！
#. de: Graaah! \<fauch>
#. fr: Arrra ararrra... AAARRR<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12333:0:13"
msgid "Ahh... Arrrgh!<br>Arghhhahahaha!"
msgstr "А-а... А-а-а!<br>А-а-а-а-ха-ха-ха!"

#. ja: そ、そんな…！
#. de: Nein, das darf doch nicht wahr sein!
#. fr: Oh non<nbsp>!
msgctxt "NpcYell:12334:0:13"
msgid "No..."
msgstr "Нет..."

#. ja: ヒィッ…！
#. de: Aaah!
#. fr: Quelle horreur<nbsp>!
msgctxt "NpcYell:12335:0:13"
msgid "Ah!"
msgstr "А!"

#. ja: チッ…新手か！
#. de: Noch einer?!
#. fr: Merde, un autre gêneur<nbsp>!
msgctxt "NpcYell:12336:0:13"
msgid "Just what we need..."
msgstr "Ну вот, только тебя нам не хватало..."

#. ja: ギィィィィィィィィッ！
#. de: Kieeeeeeh!
#. fr: Rrrrrhhhhhh<nbsp>!
msgctxt "NpcYell:12337:0:13"
msgid "Kheeeeee!"
msgstr "Кхеееее!"

#. ja: た、助けて…！
#. de: H-Hilfe! Bitte!
#. fr: À l'aiiide<nbsp>!
msgctxt "NpcYell:12338:0:13"
msgid "S-Save me!"
msgstr "П-помогите!"

#. ja: はぁ、はぁ、はぁ…！
#. de: \<keuch>
#. fr: Aaah... aaah... aaah...
msgctxt "NpcYell:12339:0:13"
msgid "\\<pant>"
msgstr ""

#. ja: そうか、この攻撃…！<br>見切ったぞ！
#. de: Nein, dieses Manöver kenne ich schon!
#. fr: Cette attaque ne m'aurrra plus<nbsp>!
msgctxt "NpcYell:12340:0:13"
msgid "How predictable!"
msgstr "Как предсказуемо!"

#. ja: ●不要になりました
#. de: 0
#. fr: 0
msgctxt "NpcYell:12341:0:13"
msgid "0"
msgstr "0"

#. ja: アリゼーは反対側を！
#. de: Nimm die andere Seite, Alisaie!
#. fr: Alisaie, prends l'autrrre côté<nbsp>!
msgctxt "NpcYell:12342:0:13"
msgid "Alisaie! To the other side!"
msgstr "Ализе! На другую сторону!"

#. ja: また来るぞ…！
#. de: Noch mehr<nbsp>...
#. fr: Ça rrrecommence<nbsp>!
msgctxt "NpcYell:12343:0:13"
msgid "Here it comes again!"
msgstr "Опять идут!"

#. ja: 次はこっちだ！
#. de: Hier ist es sicher!
#. fr: Parrr ici<nbsp>!
msgctxt "NpcYell:12344:0:13"
msgid "Now, over here!"
msgstr "Сюда, живо!"

#. ja: これで最後だな！
#. de: Das dürften die letzten sein!
#. fr: C'est la derrrnière<nbsp>!
msgctxt "NpcYell:12345:0:13"
msgid "This is the last one!"
msgstr "Это последний!"

#. ja: くっ…<br>また新手が…！？
#. de: Verdammt, noch mehr?!
#. fr: Bon sang, il sort d'où<nbsp>!?
msgctxt "NpcYell:12346:0:13"
msgid "How many are there!?"
msgstr "Сколько же их ещё?!"

#. ja: 落ち着いて回避するんだ！
#. de: Nicht verzagen! Auch dem ist auszuweichen!
#. fr: On se concentrrre pour éviter<nbsp>!
msgctxt "NpcYell:12347:0:13"
msgid "Keep calm and watch your step!"
msgstr "Спокойно, уворачивайтесь!"

#. ja: これくらい…<br>なんてことないわ！
#. de: Damit zwingt man uns nicht in die Knie!
#. fr: On se fera pas avoir par ça<nbsp>!
msgctxt "NpcYell:12348:0:13"
msgid "Ha! They'll have to do better than that!"
msgstr "Ха! Слабо стараются!"

#. ja: 相棒…！<br>俺たちでアルフィノを護るぞ！
#. de: Komm schon! Sehen wir zu, dass Alphinaud nichts passiert!
#. fr: Camarade<nbsp>! Ensemble, on protège Alphinaud<nbsp>!
msgctxt "NpcYell:12349:0:13"
msgid "We've got to protect Alphinaud!"
msgstr "Нужно защитить Альфино!"

#. ja: ご武運を…！
#. de: Viel Glück!
#. fr: Bonne chance<nbsp>!
msgctxt "NpcYell:12350:0:13"
msgid "Keep your wits about you!"
msgstr "Будьте начеку!"

#. ja: くっ、見つかったか…
#. de: Mist, entdeckt!
#. fr: Tssk<nbsp>! Ils m'ont repéré...
msgctxt "NpcYell:12351:0:13"
msgid "Seven hells..."
msgstr "Вот чёрт..."

#. ja: しくじった…！
#. de: Ich Trottel!
#. fr: Mince<nbsp>!
msgctxt "NpcYell:12352:0:13"
msgid "Damn, spotted!"
msgstr "Проклятье, меня заметили!"

#. ja: 焦りすぎたな…
#. de: Anfängerfehler ...
#. fr: J'ai été trop hâtif...
msgctxt "NpcYell:12353:0:13"
msgid "Must be losing my touch..."
msgstr "Старею, что ли..."

#. ja: こんなところで…
#. de: Wie konnte mir das nur<br>... passieren?
#. fr: Non... Pas comme ça...
msgctxt "NpcYell:12354:0:13"
msgid "No... Not like this..."
msgstr "Нет... Только не так..."

#. ja: バウワウ！
#. de: \<wuff, wuff>
#. fr: Wouaf<nbsp>! Wouaf<nbsp>!
msgctxt "NpcYell:12355:0:13"
msgid "Woof! Woof!"
msgstr "Гав! Гав!"

#. ja: フゴフゴッ
#. de: Grrr ...
#. fr: Grrr...
msgctxt "NpcYell:12356:0:13"
msgid "Grrr..."
msgstr "Гррр..."

#. ja: クゥーン…
#. de: \<winsel>
#. fr: Mwif...
msgctxt "NpcYell:12357:0:13"
msgid "\\<whimper>"
msgstr ""

#. ja: 警戒…警戒…
#. de: Aaachtung<nbsp>... Aaachtung<nbsp>...
#. fr: En garde... En garde...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12358:0:13"
msgid "Stay alert...<br>Stay alert..."
msgstr "Будь начеку...<br>Будь начеку..."

#. ja: 帝都…守れ…
#. de: Muuuss<nbsp>... Gaaarlemald schützen<nbsp>...
#. fr: Protéger... Capitale...
msgctxt "NpcYell:12359:0:13"
msgid "Protect...the capital..."
msgstr "Защищать... столицу..."

#. ja: 敵を探せ…
#. de: Fiiindet<nbsp>... den Feiiind<nbsp>...
#. fr: Trouver... Ennemi...
msgctxt "NpcYell:12360:0:13"
msgid "Could be lurking anywhere..."
msgstr "Искать врага..."

#. ja: 侵入者…
#. de: Ein Eiiindringling<nbsp>...
#. fr: Un intrus...
msgctxt "NpcYell:12361:0:13"
msgid "An intruder..."
msgstr "Нарушитель..."

#. ja: 排除せねば…
#. de: Niiieder mit iiihm<nbsp>...
#. fr: Doit tuer...
msgctxt "NpcYell:12362:0:13"
msgid "Must kill..."
msgstr "Убить..."

#. ja: 陛下の敵…
#. de: Ein Feiiind<nbsp>... des Kaiiisers<nbsp>...
#. fr: Ennemi de l'Empereur...
msgctxt "NpcYell:12363:0:13"
msgid "Our hated foe..."
msgstr "Наш ненавистный враг..."

#. ja: サンクレッド！<br>こちらだ…！
#. de: Thancred! Hier rüber!
#. fr: Thancred<nbsp>! Par ici<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12364:0:13"
msgid "Thancred!<br>Over here!"
msgstr "Танкрет!<br>Сюда!"

#. ja: 皆で守りましょう！
#. de: An uns kommen die nicht vorbei!
#. fr: Nous protégerons les convois tous ensemble<nbsp>!
msgctxt "NpcYell:12365:0:13"
msgid "They won't get past us!"
msgstr "Они нас не пройдут!"

#. ja: 粋にいこうや！
#. de: Denen zeigen wir, was wir können!
#. fr: Battons-nous... avec classe<nbsp>!
msgctxt "NpcYell:12366:0:13"
msgid "Let's put on a good show, eh?"
msgstr "Ну что, покажем им класс?"

#. ja: キャリッジは任せろ！
#. de: Wir werden die Wagen beschützen!
#. fr: On s'occupe des caravanes<nbsp>!
msgctxt "NpcYell:12367:0:13"
msgid "The carriages are in safe hands!"
msgstr "Повозки под защитой!"

#. ja: 気合入れて行くぞッ！
#. de: Der Sieg wird unser sein!
#. fr: Allez, il est temps de se dégourdir un peu<nbsp>!
msgctxt "NpcYell:12368:0:13"
msgid "To victory─come hells or high water!"
msgstr "К победе — чего бы нам это ни стоило!"

#. ja: 岩をも砕く！
#. de: So einfach wie Felsen spalten!
#. fr: Ils vont goûter à mon brise-roc<nbsp>!
msgctxt "NpcYell:12369:0:13"
msgid "Easy as splittin' rocks!"
msgstr "Проще простого!"

#. ja: この槍にかけて！
#. de: Bei meiner Lanze!
#. fr: Je jure sur ma lance de protéger mes compagnons<nbsp>!
msgctxt "NpcYell:12370:0:13"
msgid "By my lance!"
msgstr "Клянусь копьём!"

#. ja: 負けないんだから！
#. de: Wir dürfen nicht verlieren!
#. fr: Je n'ai pas l'intention de perdre<nbsp>!
msgctxt "NpcYell:12371:0:13"
msgid "Losing's not an option!"
msgstr "Мы не имеем права проиграть!"

#. ja: 破壊の力で屠ります…！
#. de: Der Herr der Zerstörung ist unter euch!
#. fr: Admirez mon pouvoir de destruction<nbsp>!
msgctxt "NpcYell:12372:0:13"
msgid "The Duke of Destruction has descended!"
msgstr "Склонись перед владыкой Разрушения!"

#. ja: 加勢する！
#. de: Ich stehe euch bei!
#. fr: Le concasseur à la rescousse<nbsp>!
msgctxt "NpcYell:12373:0:13"
msgid "Gangway!"
msgstr "Трап!"

#. ja: ブチかましてやらぁ！
#. de: Darauf hab ich gewartet!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:12374:0:13"
msgid "I've been itchin' for a good scrap!"
msgstr "Я давно ждал хорошей драки!"

#. ja: 余輩の威光、<br>不敬者にしらしめる！
#. de: Kniet nieder vor der Sonne!
#. fr: Vous allez vous agenouiller devant la suprématie de notre tribu<nbsp>!
msgctxt "NpcYell:12378:0:13"
msgid "All must bow before the Sun!"
msgstr "Все склонятся перед Солнцем!"

#. ja: 今度こそ…<br>負けません！
#. de: Wir werden nicht unterliegen!
#. fr: On ne peut pas perdre<nbsp>!
msgctxt "NpcYell:12379:0:13"
msgid "We will not succumb!"
msgstr "На этот раз мы не проиграем!"

#. ja: 魔導弾…装填…
#. de: Munition<nbsp>... laden<nbsp>...
#. fr: Préparez... Munitions...
msgctxt "NpcYell:12380:0:13"
msgid "Ready ammunition..."
msgstr "Боеприпасы... готовы..."

#. ja: 陣形…展開…
#. de: Einheiten<nbsp>... entsenden<nbsp>...
#. fr: Formez... Rangs...
msgctxt "NpcYell:12381:0:13"
msgid "Deploy all units..."
msgstr "Развернуть... все отряды..."

#. ja: 総員…配置につけ…
#. de: Positionen<nbsp>... einnehmen<nbsp>...
#. fr: En position...
msgctxt "NpcYell:12382:0:13"
msgid "Take position..."
msgstr "Занять... позиции..."

#. ja: 砲撃準備…
#. de: Abfeuern<nbsp>... vorbereiten<nbsp>...
#. fr: Parés à tirer...
msgctxt "NpcYell:12383:0:13"
msgid "Prepare salvo..."
msgstr "Приготовить... залп..."

#. ja: テメェら離れろ！
#. de: Fallt zurück!
#. fr: Éloignez-vous<nbsp>!
msgctxt "NpcYell:12384:0:13"
msgid "Fall back!"
msgstr "Отступаем!"

#. ja: フン、この程度…
#. de: Pah! Ist das alles?
#. fr: Hmpf<nbsp>! C'est tout<nbsp>?
msgctxt "NpcYell:12385:0:13"
msgid "Ha! Naught but child's play!"
msgstr "Пф! Детская забава!"

#. ja: 私だってこれくらい…！
#. de: Kinderspiel!
#. fr: Un jeu d'enfant<nbsp>!
msgctxt "NpcYell:12386:0:13"
msgid "Easily evaded!"
msgstr "Легко увернулась!"

#. ja: みなさん、大丈夫ですか？
#. de: Wie geht's euch? Ist jemand verletzt?
#. fr: Tout le monde va bien<nbsp>?
msgctxt "NpcYell:12387:0:13"
msgid "Is everyone all right?"
msgstr "Все целы?"

#. ja: 殺れるものなら<br>殺ってみやがれ！
#. de: Ihr glaubt, ihr könnt <i>mich</i> töten? Ha, viel Glück!
#. fr: Vous croyez m'avoir<nbsp>? Essayez donc, bande de rats<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:12388:0:13"
msgid "Think you can kill <i>me</i>!?I would like to see you try!"
msgstr "Думаете, сможете убить <i>меня</i>!? Ну-ну, попробуйте!"

#. ja: 栄光あれ…
#. de: Eeehre dem<nbsp>...
#. fr: G-gloire...
msgctxt "NpcYell:12389:0:13"
msgid "Glory be..."
msgstr "Слава..."

#. ja: 進軍…妨害…
#. de: Niiicht<nbsp>... weiiiter<nbsp>...
#. fr: Arrêter... Ennemis...
msgctxt "NpcYell:12390:0:13"
msgid "No...farther..."
msgstr "Не... дальше..."

#. ja: 止めなければ…
#. de: Muss siiie<nbsp>... auuufhalten<nbsp>...
#. fr: Il faut... Empêcher...
msgctxt "NpcYell:12391:0:13"
msgid "Must...bar the way..."
msgstr "Надо... преградить путь..."

#. ja: 眠らせる！
#. de: Gute Nacht!
#. fr: Fais un petit somme<nbsp>!
msgctxt "NpcYell:12392:0:13"
msgid "Lights out!"
msgstr "Спокойной ночи!"

#. ja: もうやめろ！
#. de: Gebt euch geschlagen!
#. fr: Assez<nbsp>!
msgctxt "NpcYell:12393:0:13"
msgid "Know when you're beaten!"
msgstr "Сдавайтесь уже!"

#. ja: やらせない！
#. de: Keine Chance!
#. fr: Dans tes rêves<nbsp>!
msgctxt "NpcYell:12394:0:13"
msgid "Not a chance!"
msgstr "И не надейся!"

#. ja: 護ってみせる！
#. de: Wir werden siegen!
#. fr: Je ne te laisserai pas faire<nbsp>!
msgctxt "NpcYell:12395:0:13"
msgid "We shan't fail!"
msgstr "Мы защитим их!"

#. ja: 我々は外征により<br>強く、より強くなるのだ！
#. de: Eure Eroberungen führen zu nichts! Dieser Stern wird zum stärksten von allen werden!
#. fr: L'invasion d'autres planètes rendra les Omicrons encore plus forts<nbsp>!
msgctxt "NpcYell:12396:0:13"
msgid "We will grow strong through conquest!"
msgstr "Мы станем сильнее благодаря завоеваниям!"

#. ja: 星を再生しなければ<br>未来はありません！
#. de: Dieser Stern hat keine Zukunft! Restauriert oder nicht!
#. fr: Si notre planète mère se meurt, les Omicrons sont perdus<nbsp>!
msgctxt "NpcYell:12397:0:13"
msgid "There is no future without our star!"
msgstr "Без нашей звезды нет будущего!"

#. ja: いつまで<br>戦いを続けるつもりだ…
#. de: Wie lange wollt ihr noch kämpfen!
#. fr: Jusqu'où iront-ils<nbsp>?
msgctxt "NpcYell:12398:0:13"
msgid "We cannot fight forever!"
msgstr "Мы не можем сражаться вечно!"

#. ja: もう駄目なのか…
#. de: Es hilft alles nichts ...
#. fr: Sommes-nous perdus...<nbsp>?
msgctxt "NpcYell:12399:0:13"
msgid "You must see reason..."
msgstr "Вы должны одуматься..."

#. ja: 再生派の増援か？
#. de: Wer ist das? Verstärkung für die Restaurierer?
#. fr: Des renforts des régénérationnistes<nbsp>?
msgctxt "NpcYell:12400:0:13"
msgid "Regenerator reinforcements?"
msgstr "Подкрепление регенерационистов?"

#. ja: 我ら以外は<br>すべて敵だ…！
#. de: Wer nicht zu uns gehört, ist unser Feind!
#. fr: Tous ceux qui ne sont pas avec nous sont contre nous<nbsp>!
msgctxt "NpcYell:12401:0:13"
msgid "Those not with us are against us!"
msgstr "Кто не с нами, тот против нас!"

#. ja: 識別不能…<br>不明存在を排除せよ
#. de: Unfähige Existenzen müssen ausgelöscht werden!
#. fr: Échec de l'identification. Éradication des intrus.
msgctxt "NpcYell:12402:0:13"
msgid "Unidentified presence detected... Eliminate unknown life-forms!"
msgstr "Обнаружено неизвестное присутствие... Уничтожить неизвестные формы жизни!"

#. ja: 戦いと勝利<br>学習と改善を…！
#. de: Wir müssen lernen und uns verbessern! Dann werden wir siegen!
#. fr: Une nouvelle victoire<nbsp>! Une nouvelle mise à jour<nbsp>!
msgctxt "NpcYell:12403:0:13"
msgid "Victory begets progress!"
msgstr "Победы ведут к прогрессу!"

#. ja: 侵入者を検知…<br>アターック！
#. de: Eindringlinge! Angreifen!
#. fr: Intrus repérés<nbsp>! Démarrage des protocoles de combat<nbsp>!
msgctxt "NpcYell:12404:0:13"
msgid "Intruder! Initiate offensive protocols!"
msgstr "Обнаружен нарушитель! Запустить протокол атаки!"

#. ja: 敗北は許されない！<br>異星文明を排除せよ！
#. de: Eine Niederlage ist inakzeptabel! Vernichtet die fremde Zivilisation!
#. fr: L'échec n'est pas une option<nbsp>! Éliminez-les tous<nbsp>!
msgctxt "NpcYell:12405:0:13"
msgid "Failure is not an acceptable pathway. Commencing annihilation."
msgstr "Поражение недопустимо. Начинаю уничтожение."

#. ja: ファイアコントロール<br>システム起動…
#. de: Feuerkontrollsystem ist bereit ...
#. fr: Activation des systèmes anti-incendie.
msgctxt "NpcYell:12406:0:13"
msgid "Weapon systems online..."
msgstr "Системы вооружения готовы..."

#. ja: 全機能停止…<br>ガーディアン29、アウト…
#. de: Alle Systeme versagen ...<br>Wächter 29 ist ausgeschaltet.
#. fr: Gardien 29, ultime transmission... Panne intégrale des systèmes...
msgctxt "NpcYell:12407:0:13"
msgid "All functions halted. Guardian 029, over..."
msgstr "Все функции остановлены. Хранитель 029, конец связи..."

#. ja: あれもゴードナの<br>兵力なのか！？
#. de: Gehört ihr zur Armee von Gordana?
#. fr: D'autres unités gordhoniennes<nbsp>? Non, de l'infanterie<nbsp>!?
msgctxt "NpcYell:12408:0:13"
msgid "More Gordhonite arms?"
msgstr "Это ещё войска Горданы?!"

#. ja: 我らの前進を<br>阻ませるものか…！
#. de: Nichts steht unserem Fortschritt im Wege!
#. fr: Chair ou tôle, nul ne nous arrêtera<nbsp>!
msgctxt "NpcYell:12409:0:13"
msgid "Nothing can halt our forward march!"
msgstr "Ничто не остановит наше наступление!"

#. ja: 制御不能…<br>ガーディアン32、ロスト
#. de: Kontrollverlust ...<br>Wächter 32 ist ausgeschaltet.
#. fr: Gardien 32, ultime transmission... Commande inopérante...
msgctxt "NpcYell:12410:0:13"
msgid "Controls unresponsive. Guardian 032, offline..."
msgstr "Управление не отвечает. Хранитель 032 отключён..."

#. ja: 制圧せよ！<br>すべてを制圧せよ！
#. de: Erobern! Unterdrücken! Auslöschen!
#. fr: Ces ressources sont à nous<nbsp>! Notre domination sera totale<nbsp>!
msgctxt "NpcYell:12411:0:13"
msgid "Crush the enemy! Turn them to scrap!"
msgstr "Сокрушите врага! Разнесите их в щепки!"

#. ja: 迎撃する！<br>敵を近づけるな！
#. de: Gegenangriff! Lasst den Feind nicht näher ran!
#. fr: Ne les laissez pas s'approcher de notre base<nbsp>!
msgctxt "NpcYell:12412:0:13"
msgid "Incoming! Halt their advance!"
msgstr "Враги наступают! Не дайте им пройти!"

#. ja: 今こそ星を出て<br>戦い、学び、強くなるのだ！
#. de: Wir müssen den Planeten verlassen! Wir müssen kämpfen, lernen, stärker werden!
#. fr: Notre avenir est dans les étoiles<nbsp>! L'invasion de l'univers nous rendra plus forts<nbsp>!
msgctxt "NpcYell:12413:0:13"
msgid "War with other stars ensures advancement!"
msgstr "Война с другими звёздами ведёт к развитию!"

#. ja: 今こそ星を蘇らせ<br>恒久平和を実現するのだ！
#. de: Wir müssen den Planeten heilen! Dann werden wir in Frieden leben können!
#. fr: Pour Alphatron<nbsp>! Pour une paix durable<nbsp>!
msgctxt "NpcYell:12414:0:13"
msgid "We must revitalize our star to secure stability!"
msgstr "Нужно возродить нашу звезду и обеспечить стабильность!"

#. ja: カルディアを<br>私に付与してください！
#. de: Wirke Kardia auf mich, bitte!
#. fr: Utilisez Kardia surrr moi<nbsp>!
msgctxt "NpcYell:12415:0:13"
msgid "Please cast Kardia on me!"
msgstr "Примените на мне «Кардию», пожалуйста!"

#. ja: 私にエウクラシア・<br>ディアグノシスを！
#. de: Und jetzt schütze mich mit Eukratischer Diagnose!
#. fr: Et maintenant, lancez Diagnosis eucrrrasique<nbsp>!
msgctxt "NpcYell:12417:0:13"
msgid "Eukrasian Diagnosis, if you'd be so kind!"
msgstr "Будьте добры, примените «Эвкразический диагнозис»!"

#. ja: 魔物です！<br>援護をお願いします！
#. de: Ein Biest! Decke mir den Rücken!
#. fr: Des monstres<nbsp>! Je compte sur vous pourrr les soins<nbsp>!
msgctxt "NpcYell:12419:0:13"
msgid "Fiends ahead! Please watch my back!"
msgstr "Впереди чудовища! Прикройте меня, пожалуйста!"

#. ja: これが自己強化の力…！
#. de: 0
#. fr: 0
msgctxt "NpcYell:12420:0:13"
msgid "0"
msgstr "0"

#. ja: そうはさせません！
#. de: Jetzt ist Schluss!
#. fr: Pas question<nbsp>!
msgctxt "NpcYell:12421:0:13"
msgid "No you don't!"
msgstr "Не выйдет!"

#. ja: ロイファを狙いましょう！
#. de: 0
#. fr: 0
msgctxt "NpcYell:12422:0:13"
msgid "0"
msgstr "0"

#. ja: こちらにも…
#. de: Hier auch ...
#. fr: Ici aussi...
msgctxt "NpcYell:12424:0:13"
msgid "Here too..."
msgstr "И здесь..."

#. ja: え…？
#. de: Hm?
#. fr: Hmm...<nbsp>?
msgctxt "NpcYell:12425:0:13"
msgid "Hm?"
msgstr "А?"

#. ja: 任せたぞ、アンセル！
#. de: Ancel, wenn ich bitten darf?
#. fr: Ancel, je compte sur toi<nbsp>!
msgctxt "NpcYell:12427:0:13"
msgid "Very well."
msgstr "Хорошо."

#. ja: ちっ…ここまでだな
#. de: 0
#. fr: 0
msgctxt "NpcYell:12428:0:13"
msgid "0"
msgstr "0"

#. ja: あいつ、賢者…！
#. de: 0
#. fr: 0
msgctxt "NpcYell:12429:0:13"
msgid "0"
msgstr "0"

#. ja: 了解
#. de: 0
#. fr: 0
msgctxt "NpcYell:12430:0:13"
msgid "0"
msgstr "0"

#. ja: アンセル！<br>どいて！
#. de: 0
#. fr: 0
msgctxt "NpcYell:12431:0:13"
msgid "0"
msgstr "0"

#. ja: ありがとう、ロイファ
#. de: Dank dir, Loifa!
#. fr: Merci Loifa<nbsp>!
msgctxt "NpcYell:12432:0:13"
msgid "My thanks."
msgstr "Благодарю."

#. ja: 応！
#. de: 0
#. fr: 0
msgctxt "NpcYell:12433:0:13"
msgid "0"
msgstr "0"

#. ja: ラーラー…<br>ようやく私の番なのね
#. de: Das Lied! Mein letzter Tag ist gekommen!
#. fr: Ô Ra-la... Alors, le tour de cet individu est enfin venu...
msgctxt "NpcYell:12435:0:13"
msgid "Release at last."
msgstr "Наконец-то я свободен."

#. ja: 在らずとも良い<br>それが答えなのだ
#. de: Das Ende des Seins ist die Antwort.
#. fr: L'Harmonie doit disparaître. La voilà la solution...
msgctxt "NpcYell:12436:0:13"
msgid "I choose death!"
msgstr "Я выбираю смерть!"

#. ja: ああ、待っていたよ…<br>終わりの瞬間を
#. de: Ja, endlich ist meine Zeit gekommen ...
#. fr: Enfin... L'instant tant attendu... Cet individu disparaît...
msgctxt "NpcYell:12437:0:13"
msgid "Oh, how I have waited for this moment."
msgstr "Ох, как долго я ждал этого мгновения."

#. ja: さあ、どうぞ…
#. de: Komm, nimm mich mit ins Nichts!
#. fr: Cet individu est prêt...
msgctxt "NpcYell:12438:0:13"
msgid "Thank you..."
msgstr "Спасибо..."

#. ja: くらいなッ！
#. de: Mit besten Empfehlungen!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:12439:0:13"
msgid "Fall!"
msgstr "Падай!"

#. ja: オレにやらせろ！
#. de: Das erledige ich!
#. fr: Je m'en occupe<nbsp>!
msgctxt "NpcYell:12440:0:13"
msgid "Stand back!"
msgstr "Назад!"

#. ja: そぉらよッ！
#. de: Nimm das!
#. fr: Hiyaaah<nbsp>!
msgctxt "NpcYell:12441:0:13"
msgid "Pitiful!"
msgstr "Жалкий слабак!"

#. ja: みんな、どこなの～？
#. de: W-Wo seid ihr denn alle hin?
#. fr: Les autres étaient pourtant juste derrière nous...
msgctxt "NpcYell:12442:0:13"
msgid "Where is everyone?"
msgstr "Где все?"

#. ja: なんで、俺たちまで<br>侵入者扱いするんだよ！
#. de: Aber wieso sehen sie denn gerade <i>uns</i> als Unbefugte?!
#. fr: Mais pourquoi<nbsp>!? On n'est pas des intrus, nous<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:12443:0:13"
msgid "Oh no! It thinks <i>we're</i> the intruders!"
msgstr "О нет! Он считает <i>нас</i> захватчиками!"

#. ja: ど、どうしよぉ…
#. de: Es ist zum Möhrenmelken! Was sollen wir denn jetzt machen?
#. fr: Comment on va faire pour rentrer...<nbsp>?
msgctxt "NpcYell:12444:0:13"
msgid "Wh-What do we do!?"
msgstr "Ч-Что же делать?!"

#. ja: とにかく<br>退避しようって！
#. de: Fliehen, du Narr!
#. fr: Commençons par ficher le camp d'ici<nbsp>!
msgctxt "NpcYell:12445:0:13"
msgid "I say we get out of here!"
msgstr "Предлагаю убираться отсюда!"

#. ja: 警備システムが<br>暴走してるぞ～！
#. de: Das Sicherheitssystem spielt ganz und gar verrüüückt!
#. fr: Le système de sécurité a pété un plomb<nbsp>!
msgctxt "NpcYell:12446:0:13"
msgid "The security system is out of control!"
msgstr "Система безопасности вышла из-под контроля!"

#. ja: ひぃ、逃げろ～！
#. de: Hopst! Hopst, so schnell euch eure Beinchen tragen!
#. fr: Courez<nbsp>! Vous retournez pas<nbsp>!
msgctxt "NpcYell:12447:0:13"
msgid "Ruuun!"
msgstr "Бе-е-гите!"

#. ja: トンズラだ～！
#. de: Aaaah, Viecher!
#. fr: Sauve qui peut<nbsp>!
msgctxt "NpcYell:12448:0:13"
msgid "Don't let it catch you!"
msgstr "Не дайте ему вас поймать!"

#. ja: やむを得ません…<br>攻撃して動きを封じましょう！
#. de: 0
#. fr: 0
msgctxt "NpcYell:12449:0:13"
msgid "0"
msgstr "0"

#. ja: あと少しです！<br>一気に畳みかけましょう！
#. de: 0
#. fr: 0
msgctxt "NpcYell:12450:0:13"
msgid "0"
msgstr "0"

#. ja: 僕はこっちを！
#. de: Ich übernehme hier!
#. fr: Je m'en occupe<nbsp>!
msgctxt "NpcYell:12451:0:13"
msgid "I've got this one!"
msgstr "Я этого возьму!"

#. ja: 集まれ！<br>ララーを守るんだ！
#. de: Lalah bedarf Unterstützung!
#. fr: Regroupez-vous<nbsp>! Il faut protéger Lalah<nbsp>!
msgctxt "NpcYell:12452:0:13"
msgid "Quickly, gather to Lalah!"
msgstr "Скорее, к Лале! Надо её защитить!"

#. ja: 散開しよう！
#. de: Auseinander!
#. fr: Dispersez-vous<nbsp>!
msgctxt "NpcYell:12453:0:13"
msgid "Spread out!"
msgstr "Разойдитесь!"

#. ja: ア…アァァ…
#. de: Aaargh ... Aaah ...
#. fr: Argh... Aaah...
msgctxt "NpcYell:12454:0:13"
msgid "Unnngh..."
msgstr "Уннх..."

#. ja: アンセル、こっち！
#. de: Ancel, hier!
#. fr: Ancel, ici<nbsp>!
msgctxt "NpcYell:12455:0:13"
msgid "Ancel, over here!"
msgstr "Ансель, сюда!"

#. ja: グッ…グアァ…
#. de: Urgh ... Hrng ...
#. fr: Urgh...<nbsp>!
msgctxt "NpcYell:12456:0:13"
msgid "Arrrghhh..."
msgstr "А-а-аргх..."

#. ja: お前たちを<br>再起動してやる！
#. de: Wir werden euch neustarten!
#. fr: Une seule solution pour vous, le formatage<nbsp>!
msgctxt "NpcYell:12457:0:13"
msgid "You shall be rebooted!"
msgstr "Вас перезагрузят!"

#. ja: あなたたちを<br>再起動させてもらいます！
#. de: WIR werden EUCH neustarten!
#. fr: Un redémarrage forcé assainira vos systèmes<nbsp>!
msgctxt "NpcYell:12458:0:13"
msgid "Your pitiful threat does not compute!"
msgstr "Твоя жалкая угроза не поддаётся обработке!"

#. ja: ガラクタめ！<br>無駄な抵抗を！
#. de: Schrotthaufen! Widerstand ist zwecklos!
#. fr: Tas de ferraille<nbsp>! Tu ne peux rien face aux Omicrons<nbsp>!
msgctxt "NpcYell:12459:0:13"
msgid "Why, you worthless piece of scrap...!"
msgstr "Ах ты, кусок бесполезного хлама!.."

#. ja: 戦闘プログラム<br>作動…！
#. de: Kampf-Unterroutine starten!
#. fr: Relancement des systèmes de combat<nbsp>!
msgctxt "NpcYell:12460:0:13"
msgid "Initiating combat protocol..."
msgstr "Запускаю боевой протокол..."

#. ja: 機械仕掛けども…！
#. de: Elende Metallmonster!
#. fr: Infernales machines<nbsp>!
msgctxt "NpcYell:12461:0:13"
msgid "Wretched automata...!"
msgstr "Проклятые автоматы!.."

#. ja: 星を汚す者どもめ！
#. de: Planetenbeschmutzer!
#. fr: Vous polluez notre belle planète<nbsp>!
msgctxt "NpcYell:12462:0:13"
msgid "You're a scourge upon our star!"
msgstr "Вы — настоящая чума нашей звезды!"

#. ja: くっ…！
#. de: Argh!
#. fr: Argh...
msgctxt "NpcYell:12463:0:13"
msgid "Gah!"
msgstr "Ах!"

#. ja: ぬおっ！？
#. de: Ha!
#. fr: Urgh...<nbsp>!
msgctxt "NpcYell:12464:0:13"
msgid "Urgh...!"
msgstr "Ургх!.."

#. ja: クソがッ！
#. de: Grrr!
#. fr: Bon sang<nbsp>!
msgctxt "NpcYell:12465:0:13"
msgid "Damn it!"
msgstr "Проклятье!"

#. ja: チッ…！
#. de: Mist!
#. fr: Merrrde...
msgctxt "NpcYell:12466:0:13"
msgid "Grrrrrr...!"
msgstr "Гр-р-р!.."

#. ja: ノォル殿に海嘯派まで！<br>ありがたいッ…！
#. de: Sturzsee-Sahagin? Das nenne ich unerwartete Hilfe ...
#. fr: Humains et Sahuagins, unis pour la paix<nbsp>!
msgctxt "NpcYell:12467:0:13"
msgid "My friends! We fight as one!"
msgstr "Друзья! Сражаемся вместе!"

#. ja: てやぁ！
#. de: Hiiijaaa!
#. fr: Han<nbsp>!
msgctxt "NpcYell:12468:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: 父子相伝の、必殺剣よ！
#. de: Für dich, Vater!
#. fr: Pour vous, Père<nbsp>!
msgctxt "NpcYell:12469:0:13"
msgid "For you, Father!"
msgstr "За тебя, отец!"

#. ja: はぁっ！
#. de: Da!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:12470:0:13"
msgid "There!"
msgstr "Вот!"

#. ja: 印を結びて神秘と成す！
#. de: Kraft der Mudras!
#. fr: Par le pouvoir des shinobi<nbsp>!
msgctxt "NpcYell:12471:0:13"
msgid "The weave of a shinobi's power!"
msgstr "Сила шиноби сплетает знаки!"

#. ja: お助けいたす！
#. de: Bleibt stark!
#. fr: Je suis là pour vous aider<nbsp>!
msgctxt "NpcYell:12472:0:13"
msgid "Stay strong!"
msgstr "Держитесь!"

#. ja: 修験の法にて<br>癒やすでござる！
#. de: Wir dürfen uns nicht entmutigen lassen!
#. fr: Mon Shugendo va vous sauver<nbsp>!
msgctxt "NpcYell:12473:0:13"
msgid "We mustn't lose heart!"
msgstr "Не падайте духом!"

#. ja: 跪け！
#. de: In den Staub!
#. fr: À genoux, misérables<nbsp>!
msgctxt "NpcYell:12474:0:13"
msgid "Kneel!"
msgstr "На колени!"

#. ja: 頭を垂れよ！
#. de: Zeig Demut!
#. fr: Prosternez-vous devant ma puissance<nbsp>!
msgctxt "NpcYell:12475:0:13"
msgid "Bow before the Sun!"
msgstr "Склоните головы пред Солнцем!"

#. ja: 滅せよ！
#. de: Stirb!
#. fr: Disparaissez<nbsp>!
msgctxt "NpcYell:12476:0:13"
msgid "Fall!"
msgstr "Падите!"

#. ja: セイッ！
#. de: Ha!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:12477:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: タァーッ！
#. de: Huah!
#. fr: Ataah<nbsp>!
msgctxt "NpcYell:12478:0:13"
msgid "Yah!"
msgstr "Я-а!"

#. ja: いくよ！
#. de: Attacke!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:12479:0:13"
msgid "Here I come!"
msgstr "Иду!"

#. ja: そこだ！
#. de: Nimm das!
#. fr: Par là<nbsp>!
msgctxt "NpcYell:12480:0:13"
msgid "An opening!"
msgstr "Вот брешь!"

#. ja: 集中攻撃だ！
#. de: Konzentrierter Angriff!
#. fr: Tous à l'attaque<nbsp>!
msgctxt "NpcYell:12481:0:13"
msgid "As one!"
msgstr "Всем вместе!"

#. ja: 一気に攻める！
#. de: Volle Kraft nach vorn!
#. fr: Vous ne pourrez pas nous arrêter<nbsp>!
msgctxt "NpcYell:12482:0:13"
msgid "Charge!"
msgstr "Вперёд!"

#. ja: 身の程知らずめ…！
#. de: Törichte Narren!
#. fr: Vous n'êtes que de la vermine<nbsp>!
msgctxt "NpcYell:12483:0:13"
msgid "Unworthy curs!"
msgstr "Жалкие псы!"

#. ja: もう大丈夫です！<br>ご安心を…
#. de: Habt keine Angst mehr. Jetzt seid ihr sicher!
#. fr: Tout va bien désormais, soyez rassurés.
msgctxt "NpcYell:12484:0:13"
msgid "We're here to help!"
msgstr "Мы пришли помочь!"

#. ja: みんな、おまたせ！
#. de: Entschuldigt die Verspätung!
#. fr: Désolés pour le retard<nbsp>!
msgctxt "NpcYell:12485:0:13"
msgid "Thanks for waiting!"
msgstr "Спасибо, что дождались!"

#. ja: 無事だったか！
#. de: Ein Glück, ihr seid wohlauf!
#. fr: Ouf, vous n'avez rien...
msgctxt "NpcYell:12486:0:13"
msgid "I trust all was well?"
msgstr "Надеюсь, с вами всё в порядке?"

#. ja: 皇帝陛下…<br>万歳…
#. de: Lang lebe<nbsp>... der Kaiser<nbsp>...
#. fr: G-gloire... à l-l'Empereur<nbsp>!
msgctxt "NpcYell:12487:0:13"
msgid "All hail...the Emperor..."
msgstr "Да здравствует... Император..."

#. ja: 母さん…ごめん、ね…
#. de: Lang lebe der Kaiser!
#. fr: Mère... Pardon...
msgctxt "NpcYell:12488:0:13"
msgid "Mother...forgive me..."
msgstr "Мама... прости меня..."

#. ja: 死にたく、ない…
#. de: Ich will nicht sterben!
#. fr: Je... veux pas mourir ici...
msgctxt "NpcYell:12489:0:13"
msgid "I can't die here..."
msgstr "Я не могу здесь умереть..."

#. ja: お願い、助けて…
#. de: Hilfe!
#. fr: Aidez-moi... Je vous en prie...
msgctxt "NpcYell:12490:0:13"
msgid "Please...help me..."
msgstr "Прошу... помогите мне..."

#. ja: ここから出して…
#. de: Lass mich hier raus!
#. fr: À... à l'aide...
msgctxt "NpcYell:12491:0:13"
msgid "Free me from this place..."
msgstr "Выпустите меня отсюда..."

#. ja: もう嫌だ…
#. de: Warum ich?
#. fr: Sortez-moi d'ici...
msgctxt "NpcYell:12492:0:13"
msgid "Why me...?"
msgstr "За что мне это?.."

#. ja: 怖いよぉ…
#. de: Ich habe Angst!
#. fr: J'ai si peur...
msgctxt "NpcYell:12493:0:13"
msgid "It's so scary here..."
msgstr "Мне так страшно..."

#. ja: 帰りたい…
#. de: Ich will nach Hause<nbsp>...
#. fr: Je veux rentrer chez moi...
msgctxt "NpcYell:12494:0:13"
msgid "I want to go home..."
msgstr "Хочу домой..."

#. ja: まとめてお相手いたしますわ！
#. de: 0
#. fr: 0
msgctxt "NpcYell:12495:0:13"
msgid "0"
msgstr "0"

#. ja: ぐあっ！
#. de: Uah!
#. fr: Rhaaa<nbsp>!
msgctxt "NpcYell:12496:0:13"
msgid "Gah!"
msgstr "Ах!"

#. ja: ひぃっ…
#. de: Iiiih!
#. fr: Hiii<nbsp>!
msgctxt "NpcYell:12497:0:13"
msgid "Aieee!"
msgstr "А-а-а!.."

#. ja: ぎゃっ…！
#. de: \<kreisch>
#. fr: Argh...
msgctxt "NpcYell:12498:0:13"
msgid "Ungggh!"
msgstr "У-у-у!.."

#. ja: グハッ！
#. de: Guah!
#. fr: Ouergh<nbsp>!
msgctxt "NpcYell:12499:0:13"
msgid "Aaagh!"
msgstr "А-а-ах!"

#. ja: チッ…まずは様子見か…
#. de: Prägt euch ihre Manöver ein!
#. fr: Tsk... Commençons par observer<nbsp>!
msgctxt "NpcYell:12500:0:13"
msgid "Watch closely!"
msgstr "Смотрите внимательно!"

#. ja: エーテルの流れを…<br>読む！
#. de: Der Boden pulsiert vor Äther!
#. fr: Les courants éthérés sont la clef<nbsp>!
msgctxt "NpcYell:12501:0:13"
msgid "The aethers's flow...I see it!"
msgstr "Поток эфира... Я вижу его!"

#. ja: 最初は外…<br>しかれば次は…
#. de: Erst ein Schritt hinein, nun wohl einer zurück?
#. fr: D'abord l'extérieur... Puis...
msgctxt "NpcYell:12502:0:13"
msgid "Maintain distance, and then..."
msgstr "Сначала держимся снаружи, а потом..."

#. ja: もう…まだるっこしい！！
#. de: Hrng, was denn nun schon wieder?!
#. fr: Grrr... J'aime pas ça<nbsp>!
msgctxt "NpcYell:12503:0:13"
msgid "We must be patient!"
msgstr "Да сколько можно тянуть?!"

#. ja: 頭は悪そうだが<br>パワーはありそうだな…
#. de: Sieht nicht besonders helle aus<nbsp>... aber dafür ziemlich stark.
#. fr: Il n'a pas l'air très futé celui-là... Mais j'imagine qu'il cogne bien fort.
msgctxt "NpcYell:12504:0:13"
msgid "The brute's far from bright..."
msgstr "Силач не блещет умом..."

#. ja: …人の命を<br>なんだと思っているんだ！
#. de: Wie kann man so mit Leben spielen?!
#. fr: Des vies sont jeu<nbsp>! Cessez ces pitreries<nbsp>!
msgctxt "NpcYell:12505:0:13"
msgid "Does he even know friend from foe?"
msgstr "Он хоть отличает своих от чужих?"

#. ja: …ふざけないで
#. de: Wir lassen uns doch nicht für dumm verkaufen!
#. fr: On a pas le temps pour ces enfantillages...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:12506:0:13"
msgid "If we <i>must</i> fight, can we get on with it?"
msgstr "Если уж <i>надо</i> драться, давайте покончим с этим!"

#. ja: 精神支配技術が<br>未熟なようですね…
#. de: Das Ganze wirkt etwas<nbsp>... unausgegoren.
#. fr: Sa maîtrise du contrôle mental... laisse plutôt à désirer.
msgctxt "NpcYell:12507:0:13"
msgid "Slow of wit yet heavy of hand..."
msgstr "Туг на ум, зато бьёт сильно..."

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "NpcYell:12508:0:13"
msgid "..."
msgstr "..."

#. ja: 付き合っていられるか！
#. de: Starker Tobak<nbsp>...
#. fr: Désolé mon grrrand, mais je refuse de jouer avec toi<nbsp>!
msgctxt "NpcYell:12509:0:13"
msgid "Can we not just walk past it?"
msgstr "Может, просто пройдём мимо?"

#. ja: なんだ…<br>この茶番は…
#. de: Lächerlich<nbsp>...
#. fr: C'est qui ce guignol<nbsp>!?
msgctxt "NpcYell:12510:0:13"
msgid "What am I watching?"
msgstr "На что я вообще смотрю?"

#. ja: 蛮神の類か…！
#. de: Ist das ein ... <i>Primae?!</i>
#. fr: C'est une Primordiale, ça<nbsp>!?
msgctxt "NpcYell:12511:0:13"
msgid "It's...some manner of primal."
msgstr "Это... какой-то праймал."

#. ja: 人々の信仰を<br>歪めて利用するとは！
#. de: Den Glauben der guten Leute Thavnairs derart zu besudeln<nbsp>...
#. fr: Détourner la foi humaine pour ses propres ambitions... Quelle honte<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12512:0:13"
msgid "This is an abomination.<br>A perversion of people's faith!"
msgstr "Какое кощунство!<br>Извращать веру людей!"

#. ja: 誰が相手だって<br>蹴散らすのみよ！
#. de: Wenn es ein Primae ist, wissen wir ja, wie wir damit zu verfahren haben!
#. fr: Chaud devant, ça va barder<nbsp>!
msgctxt "NpcYell:12513:0:13"
msgid "Whatever this being is, we can't let it stand in our way!"
msgstr "Кто бы это ни был, нельзя дать ему преградить нам путь!"

#. ja: 邪魔をするなら<br>貫くだけだ…！
#. de: Nichts, womit meine Lanze nicht fertig wird.
#. fr: En voilà une qui veut tâter de ma lance, on dirait...
msgctxt "NpcYell:12514:0:13"
msgid "Just another foe to vanquish."
msgstr "Ещё один враг, которого нужно одолеть."

#. ja: 気が合うじゃないか<br>俺も同感だ
#. de: Ganz deiner Meinung.
#. fr: J'aurais pas dit mieux. On est peut-être faits pour s'entendre<nbsp>!
msgctxt "NpcYell:12515:0:13"
msgid "My sentiments exactly."
msgstr "Вот и я о том же."

#. ja: 倒してはみたが<br>手応えがなさすぎる…
#. de: Der letzte Schlag hat gefehlt. Besiegt ist sie noch nicht.
#. fr: J'ai l'impression qu'on l'a à peine chatouillée...
msgctxt "NpcYell:12516:0:13"
msgid "Well, that victory felt...insubstantial."
msgstr "Что-то победа какая-то... ненастоящая."

#. ja: さあ、上層を<br>目指そう！
#. de: Los, weiter nach oben!
#. fr: On continue de monter<nbsp>!
msgctxt "NpcYell:12517:0:13"
msgid "Onwards to the upper floors!"
msgstr "Вперёд, на верхние этажи!"

#. ja: こんなところで<br>止まっていられないわ
#. de: Ich will hier keine Sekunde länger bleiben, als nötig.
#. fr: Pas le temps de bayer aux corneilles<nbsp>!
msgctxt "NpcYell:12518:0:13"
msgid "We can't very well stay here, can we?"
msgstr "Нельзя же тут оставаться, правда?"

#. ja: つまらん相手だ
#. de: Das war aber keine große Heraus<shy>forde<shy>rung<nbsp>...
#. fr: Recherche ennemi balèze dé<shy>ses<shy>pé<shy>ré<shy>ment<nbsp>!
msgctxt "NpcYell:12519:0:13"
msgid "That was tiresome."
msgstr "Утомительно."

#. ja: やるじゃないか<br>アリゼー
#. de: Schau dich an, Alisaie! Ich bin beeindruckt!
#. fr: Bien joué, Alphi... Alisaie<nbsp>!
msgctxt "NpcYell:12520:0:13"
msgid "You fought well, Alisaie."
msgstr "Отлично сражалась, Ализе."

#. ja: あなたもね<br>エスティニアン
#. de: Du piekst aber auch nicht schlecht, Estinien!
#. fr: Je vais faire semblant d'avoir rien entendu...
msgctxt "NpcYell:12521:0:13"
msgid "I was in good company."
msgstr "С хорошими товарищами иначе и быть не могло."

#. ja: まるで生物の<br>腹の中だな…
#. de: Als stünde man im Schlund einer Bestie<nbsp>...
#. fr: On se croirait dans le ventre d'une bête...
msgctxt "NpcYell:12522:0:13"
msgid "It's like being in the belly of a beast..."
msgstr "Словно мы в брюхе у чудовища..."

#. ja: この塔は<br>何で作られているのだろう？
#. de: Aus was ist dieser Turm nur gebaut?
#. fr: Ce décor me donne la chair de poule... De quoi cette tour est-elle constituée<nbsp>?
msgctxt "NpcYell:12523:0:13"
msgid "What is it made of, I wonder?"
msgstr "Интересно, из чего он сделан?"

#. ja: みんなを救うには<br>どうしたら…
#. de: Ich hoffe inständig, dass wir allen helfen können<nbsp>...
#. fr: Faut qu'on s'accroche pour sauver les Arkasodaras<nbsp>!
msgctxt "NpcYell:12524:0:13"
msgid "How are we to rescue everyone?"
msgstr "Как же нам всех спасти?"

#. ja: 悪趣味な塔だ
#. de: Bah, widerlich<nbsp>...
#. fr: Je passerai pas mes vacances ici, en tout cas...
msgctxt "NpcYell:12525:0:13"
msgid "This place sets my teeth on edge."
msgstr "Место — жуть."

#. ja: 考えるのは後にしろ<br>アルフィノ
#. de: Denk lieber gar nicht weiter darüber nach, Alphinaud.
#. fr: Tu auras le temps d'y réfléchir plus tard, Alphinaud.
msgctxt "NpcYell:12526:0:13"
msgid "Best not to think on it for now."
msgstr "Не время об этом думать, Альфино."

#. ja: かなりの数の住民が<br>囚われているな…
#. de: Das sind mehr Gefangene, als ich erwartet habe.
#. fr: Ça en fait du monde emprisonné ici...
msgctxt "NpcYell:12527:0:13"
msgid "They've been awfully busy taking prisoners..."
msgstr "Уж очень много пленников они набрали..."

#. ja: この塔を制御している<br>場所を捜すんだ！
#. de: Wir müssen den Kontrollraum finden<nbsp>... und diesem Spuk ein Ende setzen.
#. fr: Il faut qu'on trouve ce noyau au plus vite<nbsp>!
msgctxt "NpcYell:12528:0:13"
msgid "We must find the heart of this tower...and shut it down."
msgstr "Надо найти сердце башни... и отключить его."

#. ja: ラハたちは<br>上手くやってるかしら？
#. de: Hoffentlich geht es Y'shtola und den anderen gut.
#. fr: Pourvu que Raha et les autres aillent bien...
msgctxt "NpcYell:12529:0:13"
msgid "I wonder how Y'shtola and the others fare."
msgstr "Интересно, как там Я'штола и остальные."

#. ja: この得体の知れない<br>生き物はなんだ…
#. de: Was sind das für grausige Biester?
#. fr: Ces créatures semblent tout droit sorties des enfers<nbsp>!
msgctxt "NpcYell:12530:0:13"
msgid "What manner of creature are these things?"
msgstr "Что это за твари такие?"

#. ja: ああ…<br>なんとしても救い出そう！
#. de: Ja. Was auch immer dazu nötig ist.
#. fr: Courage, on va y arriver<nbsp>!
msgctxt "NpcYell:12531:0:13"
msgid "Aye, whatever it takes."
msgstr "Да, любой ценой."

#. ja: 見せてもらった絵と同じ…<br>やはりメーガス三姉妹か！
#. de: Ganz wie auf dem Bild<nbsp>... Es sind also wirklich die Magus-Schwestern!
#. fr: Les sœurs Magus<nbsp>! Comme sur le rouleau de Matsya<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12532:0:13"
msgid "Just like in the picture...<br>We're facing the Magus Sisters!"
msgstr "Точно как на картине...<br>Нам противостоят сёстры Магус!"

#. ja: サベネアの神を<br>模した存在！
#. de: Abbilder des Glaubens von Thavnair<nbsp>...
#. fr: Quel affront aux Thavnairois et à leurs divinités<nbsp>!
msgctxt "NpcYell:12533:0:13"
msgid "A mockery of the Thavnairian gods!"
msgstr "Насмешка над богами Тавнаира!"

#. ja: 行く手をさえぎるなら<br>打ち倒すだけよ！
#. de: Sie steht uns im Weg. Das ist das Einzige, was gerade zählt.
#. fr: Elle va regretter de s'être mise en travers de notre route, celle-là<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12534:0:13"
msgid "She bars our path.<br>That's all we need to know."
msgstr "Она преграждает нам путь.<br>Этого достаточно."

#. ja: ほう、同じ槍使いとはな…
#. de: Entschuldigung, gute Frau, aber in diesem Turm ist nur Platz für <i>einen</i> Lanzenträger.
#. fr: Ooh<nbsp>! Nous avons le goût de la lance en commun<nbsp>!
msgctxt "NpcYell:12535:0:13"
msgid "So it's to be lance against lance, is it?"
msgstr "Так, значит, копьё против копья?"

#. ja: 象もどきの漁師が<br>教えてくれた神だな？
#. de: Ah, der elefantige Fischer hat davon erzählt, nicht wahr?
#. fr: On dirait qu'elle manie une canne à pêche...
msgctxt "NpcYell:12536:0:13"
msgid "The same sisters the fisher lad told us about, yes?"
msgstr "Это те самые сёстры, о которых рассказывал рыбак-мальчишка?"

#. ja: 姿は似ていても<br>所詮はまがい物か…
#. de: Sie mögen aussehen wie die Göttinnen, aber sie sind nichts weiter als falsche Götzen.
#. fr: Une chose est sûre, elle ne nous voulait pas du bien...
msgctxt "NpcYell:12537:0:13"
msgid "Just a pale imitation of divinity, in the end."
msgstr "В конце концов, это всего лишь жалкая подделка богинь..."

#. ja: よし、これで<br>上層に進めるね
#. de: Das dürfte uns den Weg nach oben sichern.
#. fr: Dépêchons-nous d'avancer<nbsp>!
msgctxt "NpcYell:12538:0:13"
msgid "Shall we push on?"
msgstr "Ну что, двинем дальше?"

#. ja: 次はどんなのが<br>出てくるのやら…
#. de: Mal sehen, was sich uns als nächstes in den Weg wirft.
#. fr: Hâte de voir ce qui nous attend encore...
msgctxt "NpcYell:12539:0:13"
msgid "What else can this tower throw at us?"
msgstr "Интересно, что ещё эта башня нам подкинет?"

#. ja: あの程度の槍さばきでは<br>得るものがないな
#. de: Ich hätte meine Lanze nochmal schärfen sollen.
#. fr: La lance, ça nécessite de l'en<shy>traî<shy>ne<shy>ment, ma grande<nbsp>!
msgctxt "NpcYell:12540:0:13"
msgid "Someone needed more training with the spear..."
msgstr "Кому-то стоило бы получше потренироваться с копьём..."

#. ja: 塔の守りに<br>いやに執着していたな
#. de: Sie schien ganz besessen davon, den Turm zu schützen<nbsp>...
#. fr: Ces gardiennes sont très zélées...
msgctxt "NpcYell:12541:0:13"
msgid "Protective of the tower, aren't they?"
msgstr "Ишь как башню защищает."

#. ja: テロフォロイの術で<br>歪められた結果だろう
#. de: Das muss der Einfluss der Telophoroi sein, kein Zweifel.
#. fr: C'est à cause de la magie néfaste des Télophores<nbsp>!
msgctxt "NpcYell:12542:0:13"
msgid "Compelled by Telophoroi magicks, I imagine."
msgstr "Похоже, это всё чары телофоров."

#. ja: どうやらここが<br>最上層らしいな
#. de: Dies sieht mir wie das oberste Geschoss aus.
#. fr: Nous voilà arrivés au sommet, a priori...
msgctxt "NpcYell:12543:0:13"
msgid "I believe we've reached the summit."
msgstr "Думаю, мы добрались до вершины."

#. ja: 精神干渉が強まった<br>気がするね…
#. de: Es fällt auch immer schwerer, sich der Besessenheit zu widersetzen.
#. fr: L'atmosphère est vraiment pesante...
msgctxt "NpcYell:12544:0:13"
msgid "The corruption...it feels stronger here."
msgstr "Здесь порча ощущается сильнее..."

#. ja: すごく濃密な<br>エーテルを感じるわ
#. de: Der Äther kommt mir hier unglaublich dicht vor.
#. fr: L'éther est d'une densité folle par ici<nbsp>!
msgctxt "NpcYell:12545:0:13"
msgid "The aether here is thick as syrup..."
msgstr "Эфир здесь густой, как сироп..."

#. ja: ヴリトラの霊鱗が<br>震えていやがる
#. de: Der Talisman<nbsp>... Er zittert.
#. fr: Je sens l'écaille de Vrtra vibrer de plus en plus fort...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12546:0:13"
msgid "The talisman...<br>I feel it trembling."
msgstr "Талисман...<br>Чувствую, как он дрожит."

#. ja: ああ、ヴリトラの霊鱗が<br>震えていやがる
#. de: Der Talisman ist auch ordentlich am Rütteln.
#. fr: C'est pour ça que les écailles vibrent autant.
msgctxt "NpcYell:12547:0:13"
msgid "Aye, the talisman trembles to resist it."
msgstr "Да, талисман дрожит, сопротивляясь ей."

#. ja: また魔導兵器か…<br>強行突破するぞ！
#. de: Noch mehr Magitek<nbsp>... Aber das wird uns nicht aufhalten.
#. fr: Encore une arme magitek... Pas grave, on passe en force<nbsp>!
msgctxt "NpcYell:12548:0:13"
msgid "More warmachina to dismantle..."
msgstr "Опять магитеки на разбор..."

#. ja: 塔の先端部まで<br>あと少しだ…！
#. de: Nur noch ein kleines Stück!
#. fr: Plus que quelques pas de course<nbsp>!
msgctxt "NpcYell:12549:0:13"
msgid "Just a little further!"
msgstr "Уже совсем близко!"

#. ja: もう少しなのに…<br>なんてしつこい！
#. de: Nur noch ein kleines Stück, aber das ist gespickt mit Feinden!
#. fr: Ils pouvaient pas s'empêcher de nous barrer la route, ceux-là<nbsp>!
msgctxt "NpcYell:12550:0:13"
msgid "Ugh, we're so close, and now this!"
msgstr "Тьфу, почти добрались — и опять помеха!"

#. ja: うるさいガラクタどもめ
#. de: Nervige Blecheimer.
#. fr: C'est qu'ils sont bruyants, ces tas de ferraille<nbsp>!
msgctxt "NpcYell:12551:0:13"
msgid "Rattling, clunking nuisances..."
msgstr "Грохочущие железяки..."

#. ja: 落ち着こう<br>こういう時こそね
#. de: Gerade jetzt gilt es, einen kühlen Kopf zu bewahren.
#. fr: Surtout, gardons notre sang-froid...
msgctxt "NpcYell:12552:0:13"
msgid "Stay focused! Now is not the time for mistakes!"
msgstr "Соберитесь! Сейчас нельзя ошибаться!"

#. ja: これで最後と<br>願いたいが、さて…
#. de: Das waren dann hoffentlich auch alle.
#. fr: Serait-on enfin arrivés au bout<nbsp>?
msgctxt "NpcYell:12553:0:13"
msgid "The third and final sister, I hope?"
msgstr "Надеюсь, это последняя, третья сестра?"

#. ja: 三柱目の女神か…<br>予想はしていたが…
#. de: Die dritte Göttin. Nun, das war zu erwarten.
#. fr: La troisième sœur... Il fallait s'y attendre...
msgctxt "NpcYell:12554:0:13"
msgid "I suppose we should have expected a third sister..."
msgstr "Третья богиня... Впрочем, стоило ожидать."

#. ja: さっさと倒して<br>みんなを助けるわよ！
#. de: Vertreiben wir diese falschen Gottheiten ein für allemal!
#. fr: On lui fait sa fête à son tour et on sauve tout le monde, allez<nbsp>!
msgctxt "NpcYell:12555:0:13"
msgid "Cast down this false goddess and let us be done with it!"
msgstr "Свергнем эту лжебогиню и покончим с этим!"

#. ja: 3人揃って出てくれば<br>早いものを…
#. de: Wenn sie sich alle drei auf einmal blicken lassen, sind wir umso schneller fertig!
#. fr: Et encore une<nbsp>! Elles auraient pu nous attaquer ensemble...
msgctxt "NpcYell:12556:0:13"
msgid "Would have been quicker to fight all three at once..."
msgstr "Могли бы все трое сразу выйти — управились бы быстрее..."

#. ja: アルフィノ、大きく避けろ！
#. de: Alphinaud, weg da!
#. fr: Alphinaud, esquive<nbsp>!
msgctxt "NpcYell:12557:0:13"
msgid "Alphinaud, get back!"
msgstr "Альфино, прочь!"

#. ja: ちょっと…<br>変な事言わないでよ
#. de: He! Verschrei es nicht, hörst du?!
#. fr: Mais ça va pas de dire des trucs pareils<nbsp>!?
msgctxt "NpcYell:12558:0:13"
msgid "Please don't tempt fate like that."
msgstr "Да не сглазь ты!"

#. ja: やれやれ…<br>さて、どいつが本物だ？
#. de: Ein Ratespielchen? Das hat mir ja gerade noch gefehlt.
#. fr: Super, j'adore jouer aux devinettes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12559:0:13"
msgid "Wonderful.<br>I do so love guessing games."
msgstr "Ну конечно.<br>Обожаю загадки."

#. ja: こ、これは…<br>幻惑の術？
#. de: Was<nbsp>... Illusionsmagie?!
#. fr: Qu'est-ce que c'est<nbsp>? Une illusion<nbsp>?
msgctxt "NpcYell:12560:0:13"
msgid "Illusory magicks?"
msgstr "Иллюзии?"

#. ja: えっ、なに？<br>んもう…面倒！
#. de: W-Was? Was soll das denn jetzt?!
#. fr: Hein<nbsp>!? J'ai la berlue ou quoi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12561:0:13"
msgid "What─!?<br>Ugh, spare me..."
msgstr "Что—!?<br>Да ну, избавьте..."

#. ja: 妖精たちの<br>悪戯に比べれば…
#. de: Die Pixies haben weitaus schlimmere Späße mit mir getrieben.
#. fr: Une hallucination digne des Pixies...
msgctxt "NpcYell:12562:0:13"
msgid "The pixies subjected me to far worse..."
msgstr "Пикси и похуже со мной вытворяли..."

#. ja: 私の眼は<br>誤魔化せなくてよ
#. de: Meine Augen sehen klar!
#. fr: Malgré l'état de mes yeux, j'y vois toujours aussi clair<nbsp>!
msgctxt "NpcYell:12563:0:13"
msgid "My eyes are not so easily deceived."
msgstr "Меня так просто не обмануть."

#. ja: 子供だましと言いたいが…！
#. de: Kindische Spielereien sind das!
#. fr: On se crrroirait au jardin d'enfants...
msgctxt "NpcYell:12564:0:13"
msgid "A childish trick...but undeniably effective."
msgstr "Детская уловка... но действует, зараза."

#. ja: フン…<br>くだらない技だな
#. de: Das muss doch wohl ein Scherz sein<nbsp>...
#. fr: Non mais c'est une farce<nbsp>!
msgctxt "NpcYell:12565:0:13"
msgid "What nonsense is this?"
msgstr "Что за чушь?"

#. ja: 最上層に立てこもる<br>つもりのようですね
#. de: Ich vermute, er will sich auf der obersten Ebene verschanzen.
#. fr: Hermès doit s'être réfugié au sommet du complexe.
msgctxt "NpcYell:12566:0:13"
msgid "It seems he is determined to protect Meteion."
msgstr "Похоже, он решил защищать Метеион."

#. ja: ああ、そのようだな<br>手間をかけさせてくれる…
#. de: Ja. Und uns so das Leben unnötig schwer machen.
#. fr: Pff, quelle perte de temps...
msgctxt "NpcYell:12567:0:13"
msgid "Aye. A right bother this is going to be..."
msgstr "Да уж, хлопот с ним не оберёшься..."

#. ja: 寒冷創造環境を<br>抜けていきましょう
#. de: Schlag den Kragen hoch, der Weg führt uns durch die Kaltzone.
#. fr: Il va falloir passer par cette zone enneigée.
msgctxt "NpcYell:12568:0:13"
msgid "Let us make our way through the Frozen Sphere."
msgstr "Пойдём через Замороженную сферу."

#. ja: 環境試験、か…
#. de: Wo man Experimente unter eisigen Bedingungen durchführt.
#. fr: Voilà un tout autre terrain de jeu...
msgctxt "NpcYell:12569:0:13"
msgid "Ugh, of course there's a cold zone, and of course we're going through it..."
msgstr "Тьфу, конечно же, здесь холодная зона. И конечно же, нам через неё идти..."

#. ja: 創造生物たちを<br>無駄に殺したくはないけれど…
#. de: Ich will diesen Kreaturen nichts antun, aber sie lassen uns keine Wahl.
#. fr: Il serait préférable d'abattre le moins de créatures possible...
msgctxt "NpcYell:12570:0:13"
msgid "Would that we didn't have to put down the creations..."
msgstr "Жаль, что приходится убивать этих созданий..."

#. ja: おやまぁ…<br>すっかり戦う気のようだ
#. de: Hier kommen wir nicht ohne Blutvergießen vorbei.
#. fr: Ouh là. En voilà un qui n'a pas l'air commode...
msgctxt "NpcYell:12571:0:13"
msgid "Oh dear, this fellow seems disinclined to let us pass..."
msgstr "Ох, этот парень, похоже, нас просто так не пропустит..."

#. ja: 可哀相だけれど<br>倒して進みましょう
#. de: Ich tue es nicht gerne, aber wir müssen weiter.
#. fr: Je regrette, mais il va falloir lui passer sur le corps.
msgctxt "NpcYell:12572:0:13"
msgid "Then we have no choice but to force our way."
msgstr "Тогда придётся пробиваться силой."

#. ja: 魂よ、星の海に還り<br>また巡らんことを…
#. de: Mögest du deinen Frieden im Sternengrund finden ...
#. fr: Repose en paix dans la mer des étoiles. En attendant ta réincarnation...
msgctxt "NpcYell:12573:0:13"
msgid "May you find peace in the aetherial sea..."
msgstr "Пусть душа обретёт покой в эфирном море..."

#. ja: さあ、いくぞ…<br>止まってはいられない
#. de: Jetzt aber weiter. Mir frieren die Zehenspitzen.
#. fr: Allez, on a assez perdu de temps comme ça. Continuons.
msgctxt "NpcYell:12574:0:13"
msgid "Come, we mustn't tarry."
msgstr "Ну, идём. Нельзя задерживаться."

#. ja: 押し通りましょう
#. de: Durchkämpfen!
#. fr: S'il faut passer en force...
msgctxt "NpcYell:12575:0:13"
msgid "I'm afraid we can't do that."
msgstr "Боюсь, не получится."

#. ja: 面倒なことをしてくれる…
#. de: Warum muss man es uns so schwer machen?
#. fr: Ça commence à bien faire...
msgctxt "NpcYell:12576:0:13"
msgid "Warn us all you like. We're coming regardless."
msgstr "Предупреждай сколько хочешь. Мы всё равно идём."

#. ja: ご親切に警告どうも…
#. de: Macht den Weg frei, sonst müssen wir ...
#. fr: Il a au moins la politesse de nous avertir...
msgctxt "NpcYell:12577:0:13"
msgid "At least he has the courtesy to warn us."
msgstr "Хотя бы предупредить он вежливо соизволил."

#. ja: 彼、施設の管理能力は高いよね
#. de: Diese Anlage zu verwalten erfordert höchstes Geschick und Intelligenz.
#. fr: Il faut reconnaître qu'Hermès dirige Elpis de main de maître.
msgctxt "NpcYell:12578:0:13"
msgid "He may have his flaws, but you can't fault his managerial prowess."
msgstr "У него, может, и есть недостатки, но управленец он что надо."

#. ja: 何を呑気な…<br>座の話は後回しだ
#. de: Lob den Mann nicht zu viel.
#. fr: Euh... On lui jettera des fleurs plus tard, si tu veux bien.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:12579:0:13"
msgid "Seriously? You want to discuss his candidacy <i>now</i>?"
msgstr "Серьёзно? Ты хочешь обсуждать его кандидатуру <i>сейчас</i>?"

#. ja: これまた奇妙な生物を<br>創る人もいたものだね
#. de: Was für ein Geschöpf! Sein Macher muss besonders begabt sein.
#. fr: Tiens, encore le fruit d'une imagination débridée...
msgctxt "NpcYell:12580:0:13"
msgid "Goodness me... What manner of thinking is behind this?"
msgstr "Надо же... Что за мысли у создателя такого существа?"

#. ja: あまり美しいイデアでは<br>ありませんね…
#. de: Ich kann diesem Konzept nicht viel abgewinnen.
#. fr: J'ai connu des créatures plus élégantes...
msgctxt "NpcYell:12581:0:13"
msgid "There truly is no accounting for taste..."
msgstr "Ну и вкусы у некоторых..."

#. ja: 生命力は合格点…<br>でも、知能は低すぎたようですね
#. de: Seine Lebenskraft hat alle Spezifikationen erfüllt. Aber vielleicht war es nicht klug genug.
#. fr: Je lui donne la note maximale en vitalité... mais un zéro pointé en in<shy>tel<shy>li<shy>gence.
msgctxt "NpcYell:12582:0:13"
msgid "A pass for constitution, but a fail for intelligence."
msgstr "С телосложением всё в порядке, а вот с умом провал."

#. ja: ウチにイデア登録申請がきても<br>却下しておきますよ
#. de: Dieser Test übertraf alles, was wir normalerweise erfordern. Trotzdem muss ich das Konzept wohl ablehnen, falls es mich unverändert erreicht.
#. fr: C'est clair. Voilà un concept que je n'aurais jamais homologué<nbsp>!
msgctxt "NpcYell:12583:0:13"
msgid "If its concept is submitted, I will be certain to reject it."
msgstr "Если подадут заявку на регистрацию его идеи, я её точно отклоню."

#. ja: 声に焦りが滲んでいる…<br>近いようですね
#. de: Die Stimme wird unruhiger ... Wir müssen ganz in der Nähe sein.
#. fr: Je sens de l'agitation dans sa voix... C'est signe qu'on approche.
msgctxt "NpcYell:12584:0:13"
msgid "We're close. I can hear it in his voice."
msgstr "В его голосе слышна тревога... Значит, мы близко."

#. ja: メーティオンは回収する<br>必ずだ…！
#. de: Holen wir uns dieses Meteion, damit wir schnell wieder heimkehren können.
#. fr: Oh que si, qu'on va l'emporter<nbsp>!
msgctxt "NpcYell:12585:0:13"
msgid "We're taking Meteion! Whether you like it or not!"
msgstr "Мы заберём Метеион! Нравится тебе это или нет!"

#. ja: そろそろ諦めては…<br>くれないよね、やっぱり…
#. de: Du gibst also nicht auf ...
#. fr: Ce serait trop beau qu'il se rende gentiment...
msgctxt "NpcYell:12586:0:13"
msgid "He's not going to give up, is he?"
msgstr "Он ведь не сдастся, да?"

#. ja: いい加減にしろ、ヘルメス！<br>聞こえているんだろう？
#. de: Mach es uns nicht so schwer, Hermes! Du hörst uns doch, oder?
#. fr: Hermès, je sais que tu m'entends<nbsp>! Rends-toi avant que je m'énerve<nbsp>!
msgctxt "NpcYell:12587:0:13"
msgid "Enough is enough, Hermes!"
msgstr "Хватит, Гермес! Я знаю, ты меня слышишь!"

#. ja: ここまで頑なな人も<br>珍しいね…
#. de: So hartnäckige Seelen trifft man selten.
#. fr: N'empêche, les gens tenaces comme lui se font rares...
msgctxt "NpcYell:12588:0:13"
msgid "Stubbornness can be a virtue, but this is a little excessive."
msgstr "Таких упёртых редко встретишь..."

#. ja: 転身してまで<br>守りたいというのね…？
#. de: Sogar die Gestalt zu opfern ...
#. fr: Il va jusqu'à se transformer pour défendre Météion...
msgctxt "NpcYell:12589:0:13"
msgid "To protect Meteion, he would go so far as to transform..."
msgstr "Чтобы защитить Метеион, он готов даже обратиться..."

#. ja: 反逆者となってまでか…
#. de: Das ist ein Aufstand gegen die Ordnung.
#. fr: Ça lui est donc égal de salir sa réputation...
msgctxt "NpcYell:12590:0:13"
msgid "So far as to make himself a villain..."
msgstr "Вот даже готов стать предателем..."

#. ja: …杖！？
#. de: Ein Stab?
#. fr: ... Un bâton<nbsp>!?
msgctxt "NpcYell:12591:0:13"
msgid "A staff..."
msgstr "Посох..."

#. ja: これは…<br>足跡か…？
#. de: Sind das Fußspuren?
#. fr: Des traces de pas...<nbsp>?
msgctxt "NpcYell:12592:0:13"
msgid "Footprints?"
msgstr "Следы?"

#. ja: 逃げた…！？
#. de: Unser Gegner ist uns entwischt!
#. fr: Il a disparu<nbsp>!?
msgctxt "NpcYell:12593:0:13"
msgid "Did it flee?"
msgstr "Сбежал!?"

#. ja: いえ、まだ気配が…！
#. de: Obwohl ... ich spüre noch etwas!
#. fr: Non, je sens encore sa présence<nbsp>!
msgctxt "NpcYell:12594:0:13"
msgid "No, it's still near!"
msgstr "Нет, он всё ещё рядом!"

#. ja: こっちね！
#. de: Hier entlang!
#. fr: Par là<nbsp>!
msgctxt "NpcYell:12595:0:13"
msgid "There!"
msgstr "Вон там!"

#. ja: 子ども騙しだな…
#. de: Da will uns einer an der Nase herumführen.
#. fr: Ha<nbsp>! Sa ruse ne tromperait qu'un amateur.
msgctxt "NpcYell:12596:0:13"
msgid "This wouldn't fool a child."
msgstr "Ребячья уловка."

#. ja: ふむ…姿を隠したなら<br>占ってみましょう…
#. de: Hm. Vielleicht hilft ein Blick in die Sterne.
#. fr: Il s'est dérobé à notre regard... mais l'astromancie nous le révélera.
msgctxt "NpcYell:12597:0:13"
msgid "Hide shouldst thou wish..."
msgstr "Хм... Раз он скрылся, попробую погадать..."

#. ja: 星の導きによれば<br>こちらですね…
#. de: Ja. Sie deuten mir den Weg.
#. fr: Les étoiles me disent qu'il est ici...
msgctxt "NpcYell:12598:0:13"
msgid "But 'neath the light of the stars, all is laid bare!"
msgstr "Звёзды указывают туда..."

#. ja: エーテルが視えれば<br>容易いことよ
#. de: Im Äther lässt sich die Spur leicht verfolgen.
#. fr: Avec ma vue, c'est un jeu d'enfant de le suivre.
msgctxt "NpcYell:12599:0:13"
msgid "Nice try, but your aether is still showing."
msgstr "Если видишь эфир, выследить его проще простого."

#. ja: バニシュ…？
#. de: Hat er sich weggezaubert?
#. fr: Il a lancé Bannissement<nbsp>?
msgctxt "NpcYell:12600:0:13"
msgid "Is this...Vanish?"
msgstr "Это... Исчезновение?"

#. ja: …ってことはないか
#. de: Hm, unwahrscheinlich.
#. fr: Au temps pourrr moi, ce n'est pas de la magie.
msgctxt "NpcYell:12601:0:13"
msgid "...No, it couldn't be."
msgstr "...Нет, вряд ли."

#. ja: くだらん技だ…！
#. de: Was für ein billiger Trick!
#. fr: Ton tour de passe-passe n'impressionne personne<nbsp>!
msgctxt "NpcYell:12602:0:13"
msgid "A pathetic trick."
msgstr "Жалкий трюк!"

#. ja: ハッ！
#. de: Ha!
#. fr: Ha<nbsp>!
msgctxt "NpcYell:12603:0:13"
msgid "Yah!"
msgstr "Ха!"

#. ja: 目隠しは<br>なかなかですが…
#. de: Ich mag keine Versteckspiele.
#. fr: Sa technique de disparition est remarquable...
msgctxt "NpcYell:12604:0:13"
msgid "An impressive concealment ability."
msgstr "Неплохой способ спрятаться."

#. ja: 足跡が残っていては<br>台無しですね
#. de: Aber die Spur ist leicht zu sehen.
#. fr: Dommage que ses empreintes le trahissent.
msgctxt "NpcYell:12605:0:13"
msgid "Shame about the telltale footprints."
msgstr "Вот только следы всё портят."

#. ja: はぁ…<br>これで隠れたつもりなのか？
#. de: Was für ein alberner Schabernack.
#. fr: Il croit vraiment m'échapper avec ça<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:12606:0:13"
msgid "Is it seriously trying to hide? From <i>us</i>?"
msgstr "Он серьёзно думает, что спрятался? От <i>нас</i>?"

#. ja: 舐められたものだ
#. de: Man will uns wohl für dumm verkaufen.
#. fr: C'est bien mal me connaître.
msgctxt "NpcYell:12607:0:13"
msgid "Oh, please..."
msgstr "Ну и ну..."

#. ja: おや？
#. de: Aha!
#. fr: Tiens<nbsp>?
msgctxt "NpcYell:12608:0:13"
msgid "Oh?"
msgstr "О?"

#. ja: 氷属性の力を<br>こんな風に使うのか…
#. de: So kann man die Kraft des Eises also auch verwenden ...
#. fr: Voilà une façon originale d'utiliser l'éther de glace.
msgctxt "NpcYell:12609:0:13"
msgid "That the power of ice could be used this way..."
msgstr "Вот как можно использовать силу льда..."

#. ja: まあ、視えて<br>いるんだけれどね
#. de: Eine allzu große Heraus<shy>forde<shy>rung war das aber nicht.
#. fr: Pas de quoi tromper mon regard, cela dit.
msgctxt "NpcYell:12610:0:13"
msgid "Alas, it's no use on us."
msgstr "Но нас это не обманет."

#. ja: またか！<br>だが足跡を見れば！
#. de: Schon wieder! Aber ich sehe Spuren!
#. fr: Encore<nbsp>!? Vite, guettons ses empreintes<nbsp>!
msgctxt "NpcYell:12611:0:13"
msgid "Vanished again... But again, it's left footprints."
msgstr "Опять исчез!<br>Но снова оставил следы!"

#. ja: どこに隠れたって<br>全部潰してやれば…！
#. de: Wenn wir alles kleinschlagen, gibt es keine Verstecke mehr.
#. fr: Si ses traces partent dans tous les sens, alors il faut attaquer partout à la fois<nbsp>!
msgctxt "NpcYell:12612:0:13"
msgid "If we smash everything, we're bound to hit something!"
msgstr "Если всё разнести в щепки, мы наверняка во что-нибудь попадём!"

#. ja: あーもう！<br>なんで当たらないのよ！
#. de: Hach, Mann! Ich hab einfach kein Glück!
#. fr: Rah, il faut toujours que j'aie la poisse<nbsp>!
msgctxt "NpcYell:12613:0:13"
msgid "Gah! Where the hells are you!?"
msgstr "Да что ж такое! Где ты, к чертям?!"

#. ja: 先程よりは<br>上手く隠れたようだが…
#. de: Unser Freund hat sich besser versteckt als eben.
#. fr: Hmm, il est moins évident à suivre cette fois...
msgctxt "NpcYell:12614:0:13"
msgid "It's hidden itself better than before, I'll give it that."
msgstr "Ладно, в этот раз спряталось получше, признаю."

#. ja: 浅知恵ってやつだな
#. de: Aber nicht gut genug.
#. fr: Ça reste trop léger comme tactique<nbsp>!
msgctxt "NpcYell:12615:0:13"
msgid "But it's still not good enough."
msgstr "Но этого всё равно мало."

#. ja: 同じ手を使うのなら…
#. de: Ich werde den gleichen Weg gehen wie zuvor.
#. fr: S'il réitère la même stratégie...
msgctxt "NpcYell:12616:0:13"
msgid "If thou wouldst repeat thy trick..."
msgstr "Если ты снова пустишь в ход тот же приём..."

#. ja: こちらも同じように<br>占ってみましょう・・・
#. de: Ich werde einen Blick in die Sterne werfen.
#. fr: Je n'ai pas de raison de changer la mienne.
msgctxt "NpcYell:12617:0:13"
msgid "Then thou wilt not object were I to do likewise."
msgstr "Тогда ты не станешь возражать, если я поступлю так же."

#. ja: これがシャーレアン式<br>占星術です
#. de: Ein Hoch auf die Astrologie, Sharlayans vornehmlichste Kunst!
#. fr: Rien ne vaut l'astromancie tra<shy>di<shy>tion<shy>nel<shy>le sharlayanaise.
msgctxt "NpcYell:12618:0:13"
msgid "Behold the puissance of Sharlayan astrology!"
msgstr "Вот на что способна астрология Шарлая!"

#. ja: 何度やっても<br>結果は同じよ…
#. de: Das Ergebnis ist ja doch das gleiche ...
#. fr: Il peut essayer cent fois, le résultat sera le même.
msgctxt "NpcYell:12619:0:13"
msgid "Hmph, haven't you learned anything?"
msgstr "Хм, ты так ничему и не научился?"

#. ja: 足跡を消す術も…
#. de: Ein Zauber, um die Spuren zu verwischen.
#. fr: Je sais ce qu'il lui manque...
msgctxt "NpcYell:12620:0:13"
msgid "If you would conceal yourself..."
msgstr "Если хочешь скрыться..."

#. ja: 覚えるべきだったな
#. de: Der wäre jetzt nützlich, was?
#. fr: Un sorrrt pour effacer les traces de pas.
msgctxt "NpcYell:12621:0:13"
msgid "You really must learn to cover your tracks."
msgstr "Стоило бы научиться заметать следы."

#. ja: さて、直接<br>あぶり出してみるか…！
#. de: Also dann, bringen wir den Unhold zum Vorschein.
#. fr: Est-ce qu'il réapparaît à la chaleur comme l'encre invisible<nbsp>?
msgctxt "NpcYell:12622:0:13"
msgid "Let's flush it out!"
msgstr "Выманим его!"

#. ja: ほう…出てこないなら<br>待つだけさ
#. de: Und wenn er nicht will, trage ich ihn eben!
#. fr: Il veut se faire désirer<nbsp>? Pas de problème, j'ai tout mon temps.
msgctxt "NpcYell:12623:0:13"
msgid "A little shy, are we? Fine by me. I can wait."
msgstr "Стесняешься? Ну и ладно. Я подожду."

#. ja: 面白い！<br>偽装を増やしたのですね！
#. de: Das nenne ich mal eine originelle Tarnung!
#. fr: Il brouille les pistes<nbsp>! Intéressant<nbsp>!
msgctxt "NpcYell:12624:0:13"
msgid "Well, well, it's trying to confuse us."
msgstr "Ну и ну, пытается нас запутать."

#. ja: ただし、その程度では<br>隠しきれませんよ
#. de: Aber geholfen hat es ihm auch nicht.
#. fr: Intéressant... mais pas plus efficace pour autant<nbsp>!
msgctxt "NpcYell:12625:0:13"
msgid "But we won't be so easily confounded."
msgstr "Но нас так просто не проведёшь."

#. ja: いい加減、うんざりだ
#. de: So langsam reicht es.
#. fr: Ça devient franchement pénible...
msgctxt "NpcYell:12626:0:13"
msgid "I've had enough of this mummer's farce."
msgstr "С меня хватит этого фарса."

#. ja: おっと、工夫してきたね
#. de: Unser Widersacher ist trickreich.
#. fr: Tiens, on dirait qu'il a revu sa copie.
msgctxt "NpcYell:12627:0:13"
msgid "Oho, how very creative."
msgstr "Ого, вот это выдумка."

#. ja: うん、発想は悪くない
#. de: Das gefällt mir.
#. fr: Hé, il y a de l'idée<nbsp>!
msgctxt "NpcYell:12628:0:13"
msgid "I must say, this is a promising concept."
msgstr "Должен признать, идея многообещающая."

#. ja: 誰のイデアか気になるね
#. de: Ob er sich das alles ausgedacht hat?
#. fr: Je me demande qui l'a doté d'une telle in<shy>tel<shy>li<shy>gence.
msgctxt "NpcYell:12629:0:13"
msgid "I wonder whose it is..."
msgstr "Интересно, чья это идея..."

#. ja: 俺たちの歩むべき道は<br>決まっている…！
#. de: Das Schicksal macht uns keine Angst! Wir wissen längst, wohin wir wollen!
#. fr: Notre route est toute tracée<nbsp>!
msgctxt "NpcYell:12630:0:13"
msgid "The way forward is clear."
msgstr "Мы знаем, куда идти."

#. ja: ああ、そうだね<br>証明してみせよう！
#. de: Weise Worte, Thancred. Und das werden wir nun auch beweisen!
#. fr: Oui, et nous allons le prouver<nbsp>!
msgctxt "NpcYell:12631:0:13"
msgid "If this is the test we must overcome, so be it. "
msgstr "Раз нам предстоит пройти это испытание, так тому и быть. "

#. ja: 何を仕掛けてくるつもりだ！？
#. de: Was hat sie vor?!
#. fr: Qu'est-ce qu'elle nous mijote...<nbsp>?
msgctxt "NpcYell:12632:0:13"
msgid "What is She planning?"
msgstr "Что Она задумала?"

#. ja: このエーテル密度は…！
#. de: Nie sah ich Äther mit solcher Dichte<nbsp>...
#. fr: Je n'ai jamais vu d'éther aussi intense<nbsp>!
msgctxt "NpcYell:12633:0:13"
msgid "Such a high concentration of aether!"
msgstr "Какая высокая концентрация эфира!"

#. ja: 全属性の巡り…<br>大規模な魔法陣のようです
#. de: Äther jeden Aspektes<nbsp>... Gleich einem gewaltigen Äthergramm.
#. fr: La somme des six éléments... Préparons-nous au pire.
msgctxt "NpcYell:12634:0:13"
msgid "The elements in perfect alignment..."
msgstr "Все стихии в идеальном равновесии..."

#. ja: これが魔法陣なら…
#. de: Und was machen wir mit Äthergrammen?
#. fr: Je suis prêt à tout encaisser<nbsp>!
msgctxt "NpcYell:12635:0:13"
msgid "Whatever this is, we've but one choice."
msgstr "Что бы это ни было, выбор у нас один."

#. ja: 打ち崩すまで…！
#. de: Kaputtschlagen, natürlich!
#. fr: Et moi donc<nbsp>!
msgctxt "NpcYell:12636:0:13"
msgid "To break the circle!"
msgstr "Разрушить круг!"

#. ja: そういうことだ！
#. de: Deswegen mag ich dich, Alisaie!
#. fr: C'est le bon état d'esprit<nbsp>!
msgctxt "NpcYell:12637:0:13"
msgid "Exactly!"
msgstr "Именно!"

#. ja: 絶望を見たからこそ<br>進んできたんだ！
#. de: Nur zu gut kennen wir sie, die Ver<shy>zweif<shy>lung! Ihretwegen stehen wir heute vor dir!
#. fr: Voir le désespoir nous a donné la forrrce d'arriver jusqu'ici<nbsp>!
msgctxt "NpcYell:12638:0:13"
msgid "The suffering we've witnessed only strengthens our resolve!"
msgstr "Мы видели, на что способно отчаяние, и это лишь укрепило нашу решимость!"

#. ja: 見つけてみせるさ！<br>必ず…！
#. de: Wir werden <i>nicht</i> fallen! Das gelobe ich!
#. fr: Pour notre planète, nous nous battrons jusqu'au bout<nbsp>!
msgctxt "NpcYell:12639:0:13"
msgid "By the Light, we shall!"
msgstr "Светом клянусь, мы справимся!"

#. ja: 来るぞ…！<br>構えろ！
#. de: Macht euch bereit!
#. fr: Attention, tenez-vous prêts<nbsp>!
msgctxt "NpcYell:12640:0:13"
msgid "Brace yourselves!"
msgstr "Приготовьтесь!"

#. ja: グッ…！
#. de: Hrng!
#. fr: Argh...<nbsp>!
msgctxt "NpcYell:12641:0:13"
msgid "Ungh!"
msgstr "Ух!"

#. ja: うおぉ！
#. de: Grah!
#. fr: Uoooh<nbsp>!
msgctxt "NpcYell:12642:0:13"
msgid "Aghhh!"
msgstr "А-а-а!"

#. ja: チィッ！
#. de: \<knurr>
#. fr: Grrr...<nbsp>!
msgctxt "NpcYell:12643:0:13"
msgid "Hmph!"
msgstr "Тц!"

#. ja: うあぁっ！
#. de: Aaah!
#. fr: Ouaaah<nbsp>!
msgctxt "NpcYell:12644:0:13"
msgid "Aaah!"
msgstr "А-а-а!"

#. ja: 逃げる…<br>もんですか！
#. de: Geflohen<nbsp>... wird hier nicht!
#. fr: On ne fuira pas<nbsp>!
msgctxt "NpcYell:12645:0:13"
msgid "It'll take...more than that!"
msgstr "Этого мало, чтобы нас остановить!"

#. ja: これは…！
#. de: Das<nbsp>...!
#. fr: Mais qu'est-ce que...
msgctxt "NpcYell:12646:0:13"
msgid "This bodes ill!"
msgstr "Это дурной знак!"

#. ja: これが…<br>世界を分かった技…！
#. de: Das ist also die Macht, die einst den Planeten spaltete<nbsp>...
#. fr: ... C'est la technique qui a fragmenté notre monde<nbsp>!
msgctxt "NpcYell:12647:0:13"
msgid "Hers is the power to sunder worlds..."
msgstr "Вот она, сила, способная расколоть миры..."

#. ja: 言ったろう…<br>耐えてみせるってな
#. de: Wie Alphinaud sagte<nbsp>... Wir werden <i>nicht</i> fallen!
#. fr: Il en faudra plus pour nous faire abandonner<nbsp>!
msgctxt "NpcYell:12648:0:13"
msgid "Oof... I'll feel that one tomorrow."
msgstr "Ох... Завтра всё тело будет болеть."

#. ja: みんな…<br>無事かい？
#. de: Geht es allen gut?!
#. fr: Tout le monde va bien<nbsp>?
msgctxt "NpcYell:12649:0:13"
msgid "We're all standing, yes?"
msgstr "Все на ногах, да?"

#. ja: 無論です…
#. de: Selbstredend.
#. fr: Oui...
msgctxt "NpcYell:12650:0:13"
msgid "We are indeed."
msgstr "Разумеется..."

#. ja: 愚問ね
#. de: Aber bitte.
#. fr: Quelle question<nbsp>!
msgctxt "NpcYell:12651:0:13"
msgid "For better or worse..."
msgstr "Глупый вопрос."

#. ja: 超えてみせるわよ！
#. de: Jetzt sind wir dran!
#. fr: On surmontera toutes les épreuves<nbsp>!
msgctxt "NpcYell:12652:0:13"
msgid "I've got plenty of fight left in me!"
msgstr "Во мне ещё полно сил!"

#. ja: 応ッ！
#. de: Und los!
#. fr: Ouais<nbsp>!
msgctxt "NpcYell:12653:0:13"
msgid "Aye."
msgstr "Так точно!"

#. ja: ああ！
#. de: Ganz recht!
#. fr: Oh que oui<nbsp>!
msgctxt "NpcYell:12654:0:13"
msgid "All accounted for!"
msgstr "Все на месте!"

#. ja: さすがは光の神…！<br>それでも！
#. de: Das Licht ist mächtig. Wir allerdings auch.
#. fr: La puissance de la déesse de la Lumière... Mais il faut gagner<nbsp>!
msgctxt "NpcYell:12655:0:13"
msgid "This was never like to be easy!"
msgstr "Легко не будет!"

#. ja: ラハよりも<br>素早い切り替えね！
#. de: Raha, so schnell kriegst du deine Waffen nicht gewechselt!
#. fr: Elle change avec une telle aisance...<nbsp>!
msgctxt "NpcYell:12656:0:13"
msgid "She's got more tricks up her sleeve than G'raha!"
msgstr "У неё приёмов побольше, чем у Г'рахи!"

#. ja: それを今<br>言うのかよ…
#. de: N-Nicht der beste Zeitpunkt für derlei Diskussionen!
#. fr: Je passe pour un petit joueur à côté<nbsp>!
msgctxt "NpcYell:12657:0:13"
msgid "Well, pardon me for not measuring up to the God of Light!"
msgstr "Ну прости, что я не ровня самому богу Света!"

#. ja: よく動く！<br>だがな…！
#. de: Nur weiter! Aber ...
#. fr: Des mouvements im<shy>pres<shy>sion<shy>nants...
msgctxt "NpcYell:12658:0:13"
msgid "She's quick...but not quick enough!"
msgstr "Шустрая... но недостаточно!"

#. ja: 速いッ！<br>来るぞ！
#. de: Sie ist schnell! Gebt acht!
#. fr: Quelle vitesse<nbsp>! Elle arrive<nbsp>!
msgctxt "NpcYell:12659:0:13"
msgid "Oh, here She comes!"
msgstr "Быстро! Она идёт!"

#. ja: 作戦開始だ！<br>突っ込むぞ！
#. de: Na, dann mal los!
#. fr: Allez, c'est parti<nbsp>!
msgctxt "NpcYell:12660:0:13"
msgid "This is it! Forward!"
msgstr "Начинаем! Вперёд!"

#. ja: 一気に行くわよ！
#. de: Der Spaß kann beginnen!
#. fr: Dépêchons-nous<nbsp>!
msgctxt "NpcYell:12661:0:13"
msgid "Let me at them!"
msgstr "Дайте мне их!"

#. ja: 迅速に…<br>それでいて冷静にね…
#. de: Lasst uns schnell, doch bedachtsam handeln!
#. fr: Il faut se dépêcher, certes, mais restons prudents.
msgctxt "NpcYell:12662:0:13"
msgid "Quickly, but calmly..."
msgstr "Быстро, но без суеты..."

#. ja: 人々を苦しませる…<br>そんな塔など…！
#. de: Das Leid in diesem Turm muss ein Ende haben!
#. fr: Cette tour construite pour amasser la souffrance... ne mérrrite pas de rester debout<nbsp>!
msgctxt "NpcYell:12663:0:13"
msgid "The Telophoroi's reign ends this day!"
msgstr "Сегодня власть телофориев падёт!"

#. ja: こんな大所帯で<br>戻ってくることになるとはな
#. de: Ein paar Leute mehr als beim letzten Mal!
#. fr: Je ne pensais pas revenir ici de sitôt<nbsp>!
msgctxt "NpcYell:12664:0:13"
msgid "Never thought I'd come back..."
msgstr "Не думал, что снова сюда вернусь..."

#. ja: 後方支援は<br>お任せください
#. de: Ich gebe euch Rückendeckung!
#. fr: Comptez sur moi pour protéger nos arrières.
msgctxt "NpcYell:12665:0:13"
msgid "I shall bring up the rear."
msgstr "Я прикрою тылы."

#. ja: 捕虜を確認…<br>まずは安全を確保するぞ！
#. de: Da sind Gefangene! Sichert den Bereich!
#. fr: Voilà les prisonniers... Mettons-les en sécurité avant tout<nbsp>!
msgctxt "NpcYell:12666:0:13"
msgid "Prisoners! Let's get them out of there!"
msgstr "Пленники! Вытащим их оттуда!"

#. ja: 囚われている人々が！
#. de: Gefangene!
#. fr: Tant de gens dans ces cages...<nbsp>!
msgctxt "NpcYell:12667:0:13"
msgid "Captives!"
msgstr "Пленники!"

#. ja: 解放と治癒は<br>派遣団に任せましょう
#. de: Um die Versorgung der Gefangenen kann das Korps sich kümmern!
#. fr: Nos camarades de la délégation se chargeront de les libérer et de les soigner.
msgctxt "NpcYell:12668:0:13"
msgid "Let us entrust them to our comrades."
msgstr "Поручим товарищам освободить их и оказать помощь."

#. ja: なんてことを…！
#. de: Wie schrecklich!
#. fr: Quelle horreurrr...
msgctxt "NpcYell:12669:0:13"
msgid "This is barbaric!"
msgstr "Какое варварство!"

#. ja: テンパードにするつもりね！<br>させるもんですか！
#. de: Die will man zu Besessenen machen! Das lasse ich nicht zu!
#. fr: Les Télophores comptaient sûrement les subjuguer<nbsp>! Pas question de les laisser faire<nbsp>!
msgctxt "NpcYell:12670:0:13"
msgid "Here to be tempered, no doubt!"
msgstr "Наверняка их собираются поработить! Не бывать этому!"

#. ja: 強化兵と…<br>やつは何者だ？
#. de: Ein Magitek-Soldat und<nbsp>... ja, was?
#. fr: Un soldat renforcé, et... C'est qui l'autre<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12671:0:13"
msgid "A hypertuned soldier, perhaps?<br>As for the other chap, who knows?"
msgstr "Усиленный солдат, что ли?<br>А второй тип — кто его знает."

#. ja: あれは…？
#. de: Was ist das?
#. fr: Mais c'est...<nbsp>?
msgctxt "NpcYell:12672:0:13"
msgid "What's that supposed to be?"
msgstr "И что это такое?"

#. ja: ダブルハーケン…<br>ムーンブリダの…
#. de: Eine Barbarenaxt<nbsp>... Das ist doch Moenbrydas<nbsp>...!
#. fr: Hache double... Comme celle de Moenbryda...
msgctxt "NpcYell:12673:0:13"
msgid "Moenbryda's dual haken..."
msgstr "Двойной топор... Тот самый, что был у Мёнбриды..."

#. ja: 魔導技師と…<br>強化兵の類か！？
#. de: Ein Magitek-Ingenieur und -Soldat?
#. fr: Un ingénieurrr magitek et... un soldat augmenté<nbsp>?
msgctxt "NpcYell:12674:0:13"
msgid "An engineer and his creation, I presume."
msgstr "Инженер и его творение, полагаю."

#. ja: なんだ…<br>あのアホ面は…
#. de: Was für eine dämliche Visage<nbsp>...
#. fr: C'est qui ce type avec sa tronche de benêt<nbsp>?
msgctxt "NpcYell:12675:0:13"
msgid "A face only a mother could love..."
msgstr "Такую рожу только мать и полюбит..."

#. ja: 視たところ精神汚染は<br>されていないようね…
#. de: Sie wirken nicht wie Besessene.
#. fr: Je n'ai pas l'impression qu'il soit subjugué...
msgctxt "NpcYell:12676:0:13"
msgid "He doth not appear to have been tempered."
msgstr "Похоже, он не порабощён."

#. ja: 魔導技師の方は<br>逃げたようだな…
#. de: Der Ingenieur scheint sich aus dem Staub gemacht zu haben.
#. fr: L'ingénieur magitek s'est enfui...
msgctxt "NpcYell:12677:0:13"
msgid "Damn! The engineer got away!"
msgstr "Чёрт! Инженер сбежал!"

#. ja: …先を急ぎましょ！
#. de: Weiter! Wir dürfen keine Zeit verlieren!
#. fr: Dépêchons-nous, en avant<nbsp>!
msgctxt "NpcYell:12678:0:13"
msgid "After him!"
msgstr "За ним!"

#. ja: なまじ頭のいい馬鹿者は<br>始末に負えないわね…
#. de: Ein Narr bleibt ein Narr, selbst mit brillantem Verstand<nbsp>...
#. fr: Le problème avec les idiots... C'est qu'ils ne savent jamais s'avouer vaincus.
msgctxt "NpcYell:12679:0:13"
msgid "Hardly seems worth chasing..."
msgstr "Гнаться за ним, похоже, не стоит..."

#. ja: 帝国も…地に落ちたな
#. de: Das Kaiserreich ist auch nicht mehr, was es mal war.
#. fr: Le déclin de Garlemald... Ce n'est vraiment pas beau à voir.
msgctxt "NpcYell:12680:0:13"
msgid "Is this the best they can muster?"
msgstr "Неужели это всё, на что способна империя?"

#. ja: なんだったんだ…<br>あいつら…
#. de: Was für ein seltsames Duo.
#. fr: Qu'est-ce qu'il voulait fairrre au juste, ce type<nbsp>?
msgctxt "NpcYell:12681:0:13"
msgid "He ran away?"
msgstr "Он сбежал?"

#. ja: …ここから上へ？
#. de: Von hier geht es also hoch?
#. fr: Il faut grimper à partir d'ici<nbsp>?
msgctxt "NpcYell:12682:0:13"
msgid "Going up?"
msgstr "Наверх?"

#. ja: 風が上へと<br>抜けている…
#. de: Es weht ein Luftzug nach oben.
#. fr: Le vent s'engouffre vers le haut...
msgctxt "NpcYell:12683:0:13"
msgid "I feel the air rushing upwards..."
msgstr "Чувствую, как воздух устремляется вверх..."

#. ja: ここまでは順調か…<br>上層に向かおう
#. de: Bislang lief alles glatt. Von mir aus kann's so weitergehen.
#. fr: Tout s'est passé comme prrrévu jusqu'ici... Dirigeons-nous vers les étages supérieurs.
msgctxt "NpcYell:12684:0:13"
msgid "So far, so good. Let's continue."
msgstr "Пока всё идёт как надо. Продолжим."

#. ja: 以前に魔導城に来たときと<br>内部がまるで違ってやがる
#. de: Beim letzten Mal sah es hier völlig anders aus.
#. fr: L'agencement des lieux a drastiquement changé depuis l'époque où j'ai infiltré le palais impérial<nbsp>!
msgctxt "NpcYell:12685:0:13"
msgid "Even on the inside, this place has changed completely."
msgstr "Даже внутри здесь всё совсем изменилось."

#. ja: それだけ多くの人を…<br>許せない
#. de: So viele Opfer! Das ist unverzeihlich!
#. fr: Tant de prisonniers ici... Je ne leur pardonnerai jamais ce qu'ils ont fait<nbsp>!
msgctxt "NpcYell:12686:0:13"
msgid "Just think what it took to build this ghastly place..."
msgstr "Подумать только, сколько всего пришлось сделать, чтобы возвести это жуткое место..."

#. ja: 待ち伏せには<br>絶好の通路だな…
#. de: Dieser Gang ist wie geschaffen für einen Hinterhalt<nbsp>...
#. fr: Ce corridor sent l'embuscade à plein nez...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:12687:0:13"
msgid "The perfect route...if one <i>enjoys</i> being ambushed..."
msgstr "Идеальный путь... если <i>любишь</i> попадать в засаду..."

#. ja: さらに上へ登るための<br>ルートを探そう
#. de: Lasst uns einen Weg weiter rauf suchen.
#. fr: Trouvons un autre chemin pour atteindre le haut de la tour.
msgctxt "NpcYell:12688:0:13"
msgid "There must be a way to reach the upper levels..."
msgstr "Должен быть путь на верхние уровни..."

#. ja: この気配は…？
#. de: Ich spüre eine Bedrohung.
#. fr: Quelle est donc cette aura malveillante qui pèse sur ces lieux<nbsp>?
msgctxt "NpcYell:12689:0:13"
msgid "I sense danger afoot..."
msgstr "Чую, опасность близко..."

#. ja: この感覚…<br>ゾットの塔でも感じたもの…
#. de: Etwas wie hier habe ich auch im Turm von Zot gefühlt.
#. fr: C'est la même atmosphère que dans la tour de Zott...
msgctxt "NpcYell:12690:0:13"
msgid "I know that feeling... The same as the Tower of Zot."
msgstr "Знакомое чувство... Такое же было в Башне Зот."

#. ja: あなたも感じるのね…<br>いるわ、間違いなく
#. de: Kein Zweifel<nbsp>... Wir werden erwartet!
#. fr: Toi aussi tu sens leur présence<nbsp>? Je m'en doutais.
msgctxt "NpcYell:12691:0:13"
msgid "You sense it, too, yes?"
msgstr "Ты тоже это чувствуешь?"

#. ja: ねぇ、あれって魔導兵器？<br>それとも…
#. de: Bitte sagt mir, dass das eine Magitek-Waffe ist<nbsp>...
#. fr: C'est une arme magitek ça... Ou alors<nbsp>?
msgctxt "NpcYell:12692:0:13"
msgid "Magitek... No, wait... That's something far worse."
msgstr "Магитех... Нет, постойте... Это куда хуже."

#. ja: このエーテル…<br>肉体をいじったのね…？
#. de: Dieser Äther<nbsp>... Das war ein lebendes Wesen, nicht wahr?
#. fr: Cet éther... il a modifié son corps.
msgctxt "NpcYell:12693:0:13"
msgid "I sense living aether... That is no mere machine."
msgstr "Чувствую эфир живого существа... Это не просто машина."

#. ja: アラグにも勝る<br>悪趣味さだな
#. de: Ein Grauen, das sich selbst mit dem der Allager messen lassen könnte.
#. fr: Il dépasse même les Allagois dans le mauvais goût...
msgctxt "NpcYell:12694:0:13"
msgid "Even the Allagans would balk at such devilry."
msgstr "Даже аллагане содрогнулись бы от такого злодейства."

#. ja: 気色の悪い奴だな…
#. de: Dieses Ding gefällt mir ganz und gar nicht.
#. fr: Ce type est vraiment ignoble...
msgctxt "NpcYell:12695:0:13"
msgid "Pathetic creature."
msgstr "Жалкое создание."

#. ja: このエーテル…<br>肉体をいじったようね…
#. de: Dieser Äther<nbsp>... Das war ein lebendes Wesen.
#. fr: Son éther... Il a cer<shy>tai<shy>ne<shy>ment modifié son propre corps...
msgctxt "NpcYell:12696:0:13"
msgid "Indeed. The aether of a living being."
msgstr "Верно. Эфир живого существа."

#. ja: …テンパードだった？<br>それとも…
#. de: War das ein Besessener? Oder etwas anderes?
#. fr: Il est subjugué<nbsp>? Ou alors assez fou pour être de mèche avec Fandaniel...
msgctxt "NpcYell:12697:0:13"
msgid "Was he tempered?"
msgstr "Он был порабощён?"

#. ja: 命をもてあそぶ者に<br>未来はないわ…
#. de: Wer so mit dem Leben spielt, verdient sein eigenes nicht.
#. fr: Ceux qui se jouent de la vie des autres ne font que raccourcir leur propre existence...
msgctxt "NpcYell:12698:0:13"
msgid "A fitting end for one so depraved."
msgstr "Такой конец вполне заслужен для столь низкого существа."

#. ja: 撃破を確認…<br>よし、先を急ごう！
#. de: Das wäre geschafft<nbsp>... Los, weiter!
#. fr: L'ennemi a été détrrruit<nbsp>! Excellent<nbsp>! Nous pouvons avancer.
msgctxt "NpcYell:12699:0:13"
msgid "Let us not dwell on this grim episode. Onward."
msgstr "Не будем задерживаться на этом мрачном эпизоде. Вперёд."

#. ja: どうというものではない…<br>進むぞ…！
#. de: Ein weiterer Kampf, ein weiterer Sieg. Vorwärts!
#. fr: On a assez perdu de temps... Avançons<nbsp>!
msgctxt "NpcYell:12700:0:13"
msgid "He never stood a chance."
msgstr "Ему всё равно не победить нас."

#. ja: ああ…同感だ<br>先を急ごう！
#. de: Ja. Jede Sekunde ist kostbar!
#. fr: Oui, je suis d'accorrrd. Allons-y<nbsp>!
msgctxt "NpcYell:12701:0:13"
msgid "I'm inclined to agree."
msgstr "Пожалуй, я согласен."

#. ja: こいつは…<br>酷い匂いがしやがる…
#. de: Hier riecht's nach Ärger<nbsp>... und zwar verdammt.
#. fr: Quelle puanteur<nbsp>!
msgctxt "NpcYell:12702:0:13"
msgid "What is this foul stench?"
msgstr "Что за мерзкая вонь?"

#. ja: こ、この禍々しさは…！
#. de: Unheil liegt in der Luft<nbsp>...
#. fr: Quelle sensation étrange et pesante à la fois... D'où vient-elle<nbsp>?
msgctxt "NpcYell:12703:0:13"
msgid "I sense great evil...all around us."
msgstr "Чую зло... оно повсюду."

#. ja: …悪意を感じます<br>狂気にも似た…
#. de: Ich spüre Bosheit. Und auch<nbsp>... Wahn.
#. fr: Je ressens une présence maléfique... Comme un nuage de folie pure...
msgctxt "NpcYell:12704:0:13"
msgid "Have care, my friends!"
msgstr "Осторожнее, друзья!"

#. ja: この先に…いる！
#. de: Wir sind jetzt ganz nah dran<nbsp>...
#. fr: Ça vient d'au-dessus de nous...
msgctxt "NpcYell:12705:0:13"
msgid "We're heading in the right direction."
msgstr "Мы идём в верном направлении."

#. ja: この雰囲気…<br>ただ事じゃないぞ
#. de: Dürfte ein wilder Tanz werden<nbsp>...
#. fr: L'ambiance est bien différente ici...
msgctxt "NpcYell:12706:0:13"
msgid "I must say, I'm not a fan of the décor."
msgstr "Не могу сказать, что мне нравится здешний интерьер."

#. ja: 濁ったエーテル…<br>最悪の気分だわ
#. de: Der Äther ist so verdorben, dass sich mir der Magen umdreht<nbsp>...
#. fr: L'éther est si trouble... J'en ai la nausée.
msgctxt "NpcYell:12707:0:13"
msgid "And the aether here is positively vile."
msgstr "А эфир здесь просто отвратительный."

#. ja: あ、あれが…！<br>ヴァリス帝の…！？
#. de: Das<nbsp>... war mal der Kaiser?!
#. fr: Cette chose... c'est vraiment l'empereur Varis<nbsp>?
msgctxt "NpcYell:12708:0:13"
msgid "Is that... Varis?"
msgstr "Это... Варис?"

#. ja: ガレマールの蛮神…？
#. de: Ein garleischer Primae<nbsp>...?
#. fr: Le Primordial des Garlemaldais<nbsp>?
msgctxt "NpcYell:12709:0:13"
msgid "A primal...summoned by the Garleans themselves."
msgstr "Праймал... призванный самими гарлеанцами."

#. ja: 皇帝の無念が<br>人々をテンパードに…
#. de: Varis' Groll ist die Wurzel der Besessenheit.
#. fr: Subjugués par leur propre empereur... Quelle infamie...
msgctxt "NpcYell:12710:0:13"
msgid "Tempered by their own Emperor..."
msgstr "Их обратил в одержимых собственный император..."

#. ja: やはり、それぞれの塔に<br>肉体の一部分を…
#. de: Jeder der Türme beherbergt also einen sterblichen Überrest<nbsp>...
#. fr: Je m'en doutais... Chacune des tours de l'apocalypse renferme un morceau de sa chair...
msgctxt "NpcYell:12711:0:13"
msgid "As I suspected, each tower contained a piece of his corpse!"
msgstr "Как я и думал, в каждой башне была часть его тела!"

#. ja: 気軽に<br>神降ろしをしやがる…
#. de: Möchtegerngötter, die mit Göttern spielen<nbsp>... Pah!
#. fr: Comment ont-il pu invoquer un Primordial ici<nbsp>?
msgctxt "NpcYell:12712:0:13"
msgid "The cause of so much misery..."
msgstr "Из-за этого столько людей страдает..."

#. ja: 必ず消滅させよう<br>未来のために！
#. de: Lasst es uns beenden. Um der Zukunft willen!
#. fr: Peu importe, il nous faut le vaincrrre<nbsp>!
msgctxt "NpcYell:12713:0:13"
msgid "This fiend shall plague the world no longer!"
msgstr "Пусть этот демон больше не терзает мир!"

#. ja: 気を引き締めろ、正念場だ
#. de: Jetzt kommt es drauf an! Lasst euch nicht unterkriegen!
#. fr: Allez, ce n'est pas le moment de bayer aux corneilles<nbsp>! On passe à l'attaque<nbsp>!
msgctxt "NpcYell:12714:0:13"
msgid "Steady now. We can't afford any mistakes."
msgstr "Спокойно. Сейчас решается всё, ошибаться нельзя."

#. ja: …なんて…姿なの
#. de: Was für ein Monstrum<nbsp>...
#. fr: Quelle horreur... Je n'ose pas la regarder...
msgctxt "NpcYell:12715:0:13"
msgid "I can barely look at it..."
msgstr "Даже смотреть на это не могу..."

#. ja: この不快感…<br>吐き気がするほどよ…
#. de: Diese Verderbnis<nbsp>... Kaum auszuhalten<nbsp>...
#. fr: L'atmosphère est si nébuleuse, j'en ai l'estomac retourné...
msgctxt "NpcYell:12716:0:13"
msgid "Every fiber of my being is in revulsion..."
msgstr "Всё внутри меня переворачивается от отвращения..."

#. ja: なんて禍々しさだ<br>アラグ末期でもここまでは…
#. de: Selbst die späten Allager sind nicht so weit gegangen.
#. fr: Cette crrréature est encore plus horrible que tous les monstres crées par Allag...
msgctxt "NpcYell:12717:0:13"
msgid "All the horrors of Allag cannot compare..."
msgstr "Ужасы Аллаганской империи и то не сравнятся..."

#. ja: もはや語ることもなし<br>カタを付けるぞ！
#. de: Hier helfen Worte nicht mehr weiter<nbsp>- einzig Waffen.
#. fr: Trêve de palabres, on le réduit en poussière<nbsp>!
msgctxt "NpcYell:12718:0:13"
msgid "No more games. This ends here."
msgstr "Хватит игр. Здесь мы и покончим с этим."

#. ja: …ええ、これは<br>在ってはならないものよ！
#. de: Ja. So etwas darf nicht existieren!
#. fr: Il n'y a plus qu'à s'occuper de ce monstre...
msgctxt "NpcYell:12719:0:13"
msgid "Indeed. Let us expunge this blight once and for all!"
msgstr "Именно. Эту скверну нужно искоренить раз и навсегда!"

#. ja: 見ろ！<br>追われているぞ！
#. de: Seht nur! Sie werden verfolgt!
#. fr: Regardez<nbsp>! Ils sont poursuivis<nbsp>!
msgctxt "NpcYell:12720:0:13"
msgid "Eyes forward!"
msgstr "Смотрите вперёд!"

#. ja: まって…！<br>落ち着いて！
#. de: Wartet! Beruhigt euch, bitte!
#. fr: Attendez<nbsp>! Calmez-vous<nbsp>!
msgctxt "NpcYell:12721:0:13"
msgid "Please, try to stay calm!"
msgstr "Пожалуйста, успокойтесь!"

#. ja: なんてこと…！<br>人のエーテルが…！？
#. de: Was?! Ihr Äther<nbsp>... Er<nbsp>...
#. fr: Mais... leur éther...<nbsp>!
msgctxt "NpcYell:12722:0:13"
msgid "What is happening to their aether!?"
msgstr "Что происходит с их эфиром!?"

#. ja: 助けに来たぞ！<br>落ち着くんだ！
#. de: Wir sind hier, um zu helfen! So beruhigt euch doch!
#. fr: On est venus vous aider<nbsp>! Rrreprenez votre calme<nbsp>!
msgctxt "NpcYell:12723:0:13"
msgid "We're here to aid you!"
msgstr "Мы пришли вам помочь!"

#. ja: チッ…<br>間に合うか…？
#. de: Verdammt<nbsp>... Ich hoffe, wir kommen nicht zu spät.
#. fr: Zut... Est-ce qu'on va arriver à temps<nbsp>?
msgctxt "NpcYell:12724:0:13"
msgid "No time to waste!"
msgstr "Нельзя терять ни минуты!"

#. ja: 辛いでしょうけど…<br>立ち止まれないものね
#. de: So ungerecht und schmerzhaft es auch ist<nbsp>... Wir müssen sie stoppen.
#. fr: Je sais que c'est dur... Mais nous devons continuer.
msgctxt "NpcYell:12725:0:13"
msgid "I can't imagine what he must be going through..."
msgstr "И представить страшно, что ему пришлось пережить..."

#. ja: わかったわ<br>地上は任せて
#. de: Auf dass nicht noch mehr Schaden angerichtet wird. Der Himmel für Vrtra, der Erdboden für uns.
#. fr: Compris<nbsp>! On s'occupe du sol<nbsp>!
msgctxt "NpcYell:12726:0:13"
msgid "Leave the jungle to us."
msgstr "Джунгли оставьте нам."

#. ja: 了解だ…！<br>みんな、行こう！
#. de: Verstanden. Reißen wir uns zusammen.
#. fr: Entendu<nbsp>! Allons-y<nbsp>!
msgctxt "NpcYell:12727:0:13"
msgid "Understood. This way, everyone!"
msgstr "Понял... За мной, все!"

#. ja: そうだ…<br>それでいい…
#. de: Ganz recht. Es hilft ja doch nichts.
#. fr: Bien, on s'occupe du reste<nbsp>!
msgctxt "NpcYell:12728:0:13"
msgid "A sound plan."
msgstr "Верный план."

#. ja: よし、我々は<br>北に向かおう！
#. de: Also gut, gen Norden!
#. fr: Très bien. Dirigeons-nous vers le nord<nbsp>!
msgctxt "NpcYell:12729:0:13"
msgid "Agreed. We head north!"
msgstr "Согласен. На север!"

#. ja: 間に合わなかったか…
#. de: Wir waren zu langsam<nbsp>...
#. fr: Nous sommes arrivés trop tard...
msgctxt "NpcYell:12730:0:13"
msgid "Damn it! Too late..."
msgstr "Чёрт! Опоздали..."

#. ja: どうすれば…<br>止められるんだ…
#. de: Was sollen wir nur machen? Wie ist das denn aufzuhalten?!
#. fr: Que pouvons-nous faire...<nbsp>?
msgctxt "NpcYell:12731:0:13"
msgid "There's no other way."
msgstr "Другого выхода нет."

#. ja: 恐ろしかったろう…<br>せめて、オレたちの手で！
#. de: So viel Furcht<nbsp>... Und so viel Grauen. Wir müssen helfen!
#. fr: Il a dû avoir si peurrr... Nous devons soulager ses souffrances<nbsp>!
msgctxt "NpcYell:12732:0:13"
msgid "All we can offer is a swift death."
msgstr "Останется лишь избавить его от страданий быстрой смертью."

#. ja: 今は目の前の相手に<br>集中するんだ…！
#. de: So schwer es fällt, aber wir müssen weitermachen. Wir sollten uns auf den nächsten Schritt konzentrieren.
#. fr: Nous n'avons pas d'autre choix, il va falloir s'occuper de celui-là...
msgctxt "NpcYell:12733:0:13"
msgid "Let's get this over with..."
msgstr "Давайте покончим с этим..."

#. ja: このまま北上するぞ<br>集落があるはずだ…！
#. de: Weiter nach Norden! Dort sollte ein Dorf kommen.
#. fr: Dirigeons-nous vers le nord, il devrait y avoir un village pas loin<nbsp>!
msgctxt "NpcYell:12734:0:13"
msgid "There should be a village just ahead."
msgstr "Впереди, должно быть, деревня."

#. ja: せめて安らかに<br>眠ってくれ…
#. de: Ruhe nun sanft<nbsp>...
#. fr: Repose en paix...
msgctxt "NpcYell:12735:0:13"
msgid "You shall suffer no more..."
msgstr "Больше ты не будешь страдать..."

#. ja: 葬ってやることもできず<br>すまない…
#. de: Nicht einmal die letzten Riten können wir ihnen gewähren. Verdammt<nbsp>...
#. fr: Je suis désolé de ne pas pouvoir t'offrir de sépulturrre correcte...
msgctxt "NpcYell:12736:0:13"
msgid "Forgive us..."
msgstr "Простите нас..."

#. ja: 了解だ…<br>先に進もう…
#. de: Verstanden. Also weiter.
#. fr: Très bien... Continuons.
msgctxt "NpcYell:12737:0:13"
msgid "Then let us hurry!"
msgstr "Тогда поспешим!"

#. ja: 了解した…！<br>空は任せたぞ！
#. de: Alles klar! Den Himmel überlassen wir euch!
#. fr: Merci pour l'info, reste prudent là-haut<nbsp>!
msgctxt "NpcYell:12738:0:13"
msgid "You do your part, and we shall do ours!"
msgstr "Вы займитесь своим делом, а мы — своим!"

#. ja: 奥に…<br>人影がある…！
#. de: Dort hinten ist jemand!
#. fr: Au fond<nbsp>! Il y a une silhouette humaine<nbsp>!
msgctxt "NpcYell:12739:0:13"
msgid "I see someone!"
msgstr "Вижу кого-то!"

#. ja: ああ、わかった！<br>そちらも気をつけて！
#. de: In Ordnung! Bleibt wachsam!
#. fr: Comprrris<nbsp>! Sois prudent<nbsp>!
msgctxt "NpcYell:12740:0:13"
msgid "Pray take care!"
msgstr "Берегите себя!"

#. ja: チッ…追われてるぞ！！
#. de: Sie werden verfolgt!
#. fr: Ils sont poursuivis<nbsp>!
msgctxt "NpcYell:12741:0:13"
msgid "Beasts in pursuit!"
msgstr "За ними гонятся твари!"

#. ja: 生存者は…いないのか？
#. de: Gibt es denn gar keine Überlebenden<nbsp>...?
#. fr: Il n'y a... pas un seul survivant<nbsp>?
msgctxt "NpcYell:12742:0:13"
msgid "Did none survive?"
msgstr "Неужели никто не выжил?"

#. ja: ひとりでも…<br>ひとりでも助けるんだ！
#. de: Und selbst wenn wir nur eine einzige Seele retten<nbsp>...!
#. fr: On doit bien pouvoir aider quelqu'un<nbsp>!
msgctxt "NpcYell:12743:0:13"
msgid "If any yet live, we must save them!"
msgstr "Если там ещё кто-то жив, мы должны его спасти!"

#. ja: くっ…火の勢いが…
#. de: Gah<nbsp>... Diese Flammen<nbsp>...
#. fr: Le feu est trrrop puissant, nous ne pourrons pas l'éteindre<nbsp>!
msgctxt "NpcYell:12744:0:13"
msgid "The flames roar ever fiercer!"
msgstr "Пламя разгорается всё сильнее!"

#. ja: 生存者がいることを<br>祈りましょう…
#. de: Ich bete, dass es auch nur eine Seele heil aus diesem Inferno geschafft hat<nbsp>...
#. fr: Prions pour qu'il y ait des survivants...
msgctxt "NpcYell:12745:0:13"
msgid "I can only pray some made it out alive..."
msgstr "Остаётся только молиться, чтобы хоть кто-нибудь спасся..."

#. ja: 人がこうも<br>変わり果てるというのか…
#. de: Wie kann eine solche Ver<shy>wand<shy>lung überhaupt vonstattengehen?
#. fr: Difficile de croire que quelqu'un puisse devenir...
msgctxt "NpcYell:12746:0:13"
msgid "Each beast more terrible than the last..."
msgstr "Каждый следующий зверь страшнее прежнего..."

#. ja: これも人が<br>変異した獣…！？
#. de: Diese Biester waren auch ganz normale Leute?
#. fr: Ça aussi, c'est quelqu'un qui s'est transformé<nbsp>!?
msgctxt "NpcYell:12747:0:13"
msgid "That fiend was once one of us..."
msgstr "Этот демон когда-то был одним из нас..."

#. ja: 人のエーテルが…<br>視えない！？
#. de: Wieso kann ich ihren Äther nicht sehen?
#. fr: Je ne peux pas voir son éther<nbsp>!
msgctxt "NpcYell:12748:0:13"
msgid "I don't sense any aether!"
msgstr "Не чувствую никакого эфира!"

#. ja: どいてもらおうか<br>急ぎなんでね…
#. de: Weiter. Wir dürfen keine Zeit verlieren.
#. fr: On est pressés, alors libère le passage.
msgctxt "NpcYell:12749:0:13"
msgid "No choice but to go through it."
msgstr "Придётся пробиваться силой."

#. ja: これが…<br>終末なのか…？
#. de: Sind es wahrlich die Letzten Tage?
#. fr: C'est vraiment l'apocalypse...
msgctxt "NpcYell:12750:0:13"
msgid "Whoever they were, their suffering ends here."
msgstr "Кем бы они ни были, их страданиям пришёл конец."

#. ja: あとは…この先の神殿へ！
#. de: Und nun zum Tempel!
#. fr: Nous arrivons au temple<nbsp>!
msgctxt "NpcYell:12751:0:13"
msgid "Forward!"
msgstr "Вперёд!"

#. ja: ハァ…ハァ…<br>この一帯はこれで…
#. de: \<keuch> Hier sind wir richtig, oder?
#. fr: Hah... Hah... Le village est sauvé, hein<nbsp>?
msgctxt "NpcYell:12752:0:13"
msgid "There are likely more ahead..."
msgstr "Впереди, скорее всего, ещё кто-то есть..."

#. ja: …………
#. de: ... ...
#. fr: ...
msgctxt "NpcYell:12753:0:13"
msgid "..."
msgstr "..."

#. ja: 嫌な手ごたえだぜ…
#. de: Jeder Sieg schmeckt schrecklich bitter<nbsp>...
#. fr: J'ai du mal à me réjouir...
msgctxt "NpcYell:12754:0:13"
msgid "Unlike anything I've ever fought..."
msgstr "Никогда прежде мне не доводилось сражаться с чем-то подобным..."

#. ja: くそっ、これじゃあまるで<br>罪喰いじゃないか…！
#. de: Verdammt, es ist wie mit den Sünden<shy>ver<shy>tilgern!
#. fr: Bordel<nbsp>! C'est la même chose qu'avec les purrrgateurs<nbsp>!
msgctxt "NpcYell:12755:0:13"
msgid "All too reminiscent of the sin eaters..."
msgstr "До боли напоминает пожирателей греха..."

#. ja: ああ、大丈夫だろう<br>さらに北へ進むぞ
#. de: ... Ist sicherlich in Ordnung. Kommt, weiter gen Norden.
#. fr: Oui... Continuons vers le nord.
msgctxt "NpcYell:12756:0:13"
msgid "Keep heading north!"
msgstr "Продолжаем путь на север!"

#. ja: 空が…<br>なんて光景だ…
#. de: Der Himmel<nbsp>... Was für ein Anblick.
#. fr: Le ciel... Quelle horreur...
msgctxt "NpcYell:12757:0:13"
msgid "Gods be good... The sky..."
msgstr "Боги... Это небо..."

#. ja: 空を…獣の大群が…！
#. de: Da fliegt ein ganzer Schwarm!
#. fr: Une horde de bêtes volantes a envahi le ciel<nbsp>!
msgctxt "NpcYell:12758:0:13"
msgid "The air above is thick with fiends!"
msgstr "Всё небо кишит тварями!"

#. ja: 流星と獣の群れ…！
#. de: Sternschauer und Bestien<nbsp>...
#. fr: Le ciel est rrrempli de bêtes et d'étoiles filantes...<nbsp>!
msgctxt "NpcYell:12759:0:13"
msgid "A starshower..."
msgstr "Звездопад..."

#. ja: ヴリトラを信じろ<br>行くぞ！
#. de: Ich glaube an Vrtra! Weiter!
#. fr: Faisons confiance à Vrtra<nbsp>! Allons-y<nbsp>!
msgctxt "NpcYell:12760:0:13"
msgid "Let Vrtra worry about the skies!"
msgstr "Пусть Врйтра разбирается с небом!"

#. ja: この姿…！<br>この威容は…！
#. de: Diese Gestalt<nbsp>... Dieser Anblick<nbsp>...
#. fr: Il n'y a aucun doute... C'est bien lui...
msgctxt "NpcYell:12761:0:13"
msgid "An all-too-familiar face..."
msgstr "Лицо до боли знакомое..."

#. ja: アーモロートで見た<br>最初の獣と…
#. de: Dieselbe Bestie wie in Amaurot. Kein Zweifel.
#. fr: On dirait la première Bête qu'on avait vue à Amaurote...
msgctxt "NpcYell:12762:0:13"
msgid "The horror of Amaurot..."
msgstr "Ужас Амаврота..."

#. ja: 嘘でしょ…<br>あの姿は…
#. de: Nein<nbsp>... Das kann doch nicht sein.
#. fr: Oh non... Mais c'est...<nbsp>!
msgctxt "NpcYell:12763:0:13"
msgid "It can't be..."
msgstr "Не может быть..."

#. ja: あぁ…<br>そこに「いる」のね…
#. de: Da sitzt sie, die Bestie. Dieselbe Bestie.
#. fr: Ah... Le voilà...
msgctxt "NpcYell:12764:0:13"
msgid "Over there, yes?"
msgstr "Вон там, да?"

#. ja: 終末のアーモロートで見た…
#. de: Und sie sieht genauso aus wie die aus Amaurot!
#. fr: Il ressemble fortement à la Bête d'Amaurote<nbsp>!
msgctxt "NpcYell:12765:0:13"
msgid "Aye. The beast of Amaurot...or something worse still."
msgstr "Ага. Зверь из Амаврота... или что-то ещё хуже."

#. ja: …！！
#. de: Ah!
#. fr: ...<nbsp>!
msgctxt "NpcYell:12766:0:13"
msgid "What!?"
msgstr "Что?!"

#. ja: ズルい！
#. de: Wie hinterhältig!
#. fr: C'est pas du jeu<nbsp>!
msgctxt "NpcYell:12767:0:13"
msgid "I could learn a thing or two from Her!"
msgstr "Вот же хитрюга!"

#. ja: よし、見切れてきたな！
#. de: Nun sehen wir weitaus klarer!
#. fr: Trrrop facile<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:12768:0:13"
msgid "So <i>that's</i> how it's done!"
msgstr "Так <i>вот</i> как это делается!"

#. ja: 畳みかけるぞ！
#. de: Jetzt nur nicht nachlassen!
#. fr: On lâche tout ce qu'on a<nbsp>!
msgctxt "NpcYell:12769:0:13"
msgid "She's relentless!"
msgstr "Она не даёт нам передышки!"

#. ja: 何かあっても…<br>私たちが支えてみせる！
#. de: Was auch immer geschieht, wir halten zusammen!
#. fr: Quoi qu'il arrive, on vous soutiendra<nbsp>!
msgctxt "NpcYell:12770:0:13"
msgid "Together, we'll overcome this!"
msgstr "Вместе мы справимся!"

#. ja: ええ…我が力を<br>お役立てください
#. de: Ganz recht. Meine bescheidenen Künste sind stets zu Diensten.
#. fr: Mes techniques sont à votre service.
msgctxt "NpcYell:12771:0:13"
msgid "Pray leave this to me!"
msgstr "Позвольте, я сама этим займусь!"

#. ja: トゥプシマティ…！？
#. de: Tupsimati<nbsp>...?
#. fr: Tupsimati...<nbsp>!?
msgctxt "NpcYell:12772:0:13"
msgid "Tupsimati!?"
msgstr "Тупсимати!?"

#. ja: まさか…！<br>この折れた杖は！
#. de: Keine Frage ... Der zerbrochene Stab!
#. fr: Ce bâton, c'est...<nbsp>!?
msgctxt "NpcYell:12773:0:13"
msgid "There's no mistaking that staff."
msgstr "Нет сомнений — этот посох..."

#. ja: この気配…パパリモ！<br>あなたなのですか！？
#. de: Dieses Gefühl, das ... Papalymo? Bist das wirklich du?!
#. fr: Cette présence... Papalymo, c'est vous<nbsp>?
msgctxt "NpcYell:12774:0:13"
msgid "Art thou with us still, Papalymo?"
msgstr "Эта энергия... Папалимо! Неужели это правда ты?"

#. ja: こ、このエーテルは…<br>パパリモ…！？
#. de: Dieser Äther<nbsp>... Papalymo?
#. fr: Cet éther... C'est Papalymo<nbsp>?
msgctxt "NpcYell:12775:0:13"
msgid "This aether... Papalymo..."
msgstr "Этот эфир... Папалимо..."

#. ja: 仲間を想う思念…<br>これが、魂の還る場所…
#. de: Dies ist der Ort, an den alle Seelen zurückkehren ... So auch die unserer Kameraden.
#. fr: Des pensées pour ses compagnons, qui se matérrrialisent...
msgctxt "NpcYell:12776:0:13"
msgid "A soul's abiding care for companions held dear..."
msgstr "Любовь к товарищам, что живёт в душе..."

#. ja: 間違いない…！<br>その想いが形を成したんだ！
#. de: Kein Zweifel! Nimmt er einfach Gestalt an, direkt vor unseren Augen!
#. fr: Aucun doute<nbsp>! Ce sont ses sentiments qui prennent forme<nbsp>!
msgctxt "NpcYell:12777:0:13"
msgid "His will, given form."
msgstr "Его воля обрела форму."

#. ja: さようならだ…<br>パパリモ…
#. de: Mach's gut, alter Freund<nbsp>...
#. fr: Adieu, Papalymo...
msgctxt "NpcYell:12778:0:13"
msgid "Farewell again, my friend."
msgstr "Прощай, друг мой. Снова..."

#. ja: ありがとう…<br>そして、どうか安らかに…
#. de: Wir danken dir<nbsp>... für alles. Auf dass du Frieden findest, Papalymo.
#. fr: Puissiez-vous reposer en paix...
msgctxt "NpcYell:12779:0:13"
msgid "Thank you. Always."
msgstr "Спасибо. За всё."

#. ja: 言えなかった別れ…<br>そして、感謝をあなたに…
#. de: Ein wahrer Abschied, der uns nie vergönnt war. Papalymo, du weilst auf immer in unseren Herzen.
#. fr: Adieu, et merci...
msgctxt "NpcYell:12780:0:13"
msgid "Ne'er doth words suffice..."
msgstr "Словами не выразить..."

#. ja: 皮肉屋だけど心配性…<br>本当にあなたらしいわ…
#. de: Die Sorge hinter dem Zynismus zu verbergen<nbsp>... Das sieht dir ähnlich.
#. fr: Sarcastique, mais toujours inquiet... C'était tout lui...
msgctxt "NpcYell:12781:0:13"
msgid "Try as you might to conceal it, you've always worried overmuch."
msgstr "Как ни пытался ты это скрыть, ты всегда слишком за нас переживал."

#. ja: あんたの想い<br>受け取ったぞ
#. de: Wir werden dein Streben in Ehren halten, das gelobe ich.
#. fr: Ces pensées feront notre forrrce<nbsp>!
msgctxt "NpcYell:12782:0:13"
msgid "We understand. Rest well..."
msgstr "Мы поняли. Отдыхай с миром..."

#. ja: 安心しろ<br>リセは前に進んだぞ…
#. de: Lyse, sie<nbsp>... Sie kämpft als tapfere, stolze Frau. Sei dir dessen gewiss.
#. fr: Sois tranquille, Lyse a su aller de l'avant...
msgctxt "NpcYell:12783:0:13"
msgid "Don't fret about Lyse, either─she's just fine."
msgstr "И за Лисе не переживай — с ней всё хорошо."

#. ja: 面構えでわかった<br>奴は帝国軍の…！
#. de: Egal, wo sie mir auch unterkommt. Dieses Gesicht erkenne ich überall wieder<nbsp>...
#. fr: Un retour inattendu de l'armée impériale...
msgctxt "NpcYell:12784:0:13"
msgid "And here I thought we'd moved past this."
msgstr "А я-то думал, что мы уже покончили с этим."

#. ja: …執着が強ければ<br>魂までこうなるのか
#. de: So sieht es also aus, wenn man von altem Groll nicht ablassen kann.
#. fr: Sa haine pour nous est immense...
msgctxt "NpcYell:12785:0:13"
msgid "Her resentment is bigger than she was..."
msgstr "Её злоба оказалась больше неё самой..."

#. ja: 砂の家の悲劇…<br>こちらとて忘れてはいません…
#. de: Die grausame Szenerie des Sonnenwinds ist mir ins Gedächtnis gebrannt<nbsp>...
#. fr: Je n'oublierai jamais ce qui s'est passé au Refuge des sables.
msgctxt "NpcYell:12786:0:13"
msgid "Stained by the blood of our comrades..."
msgstr "Трагедия в Живых песках... Мы тоже её не забыли..."

#. ja: 魂に染みついた未練か…
#. de: Ein Gefühl, das die Seele nicht loszulassen vermag?
#. fr: Une âme en proie à d'infinis regrrrets...
msgctxt "NpcYell:12787:0:13"
msgid "To think this is what remains of a life..."
msgstr "Вот что осталось от чьей-то жизни..."

#. ja: 砂の家の悲劇…<br>その張本人のようですね…
#. de: Vielleicht kann ich jene bitteren Erinnerungen nun ebenfalls zu Grabe tragen<nbsp>...
#. fr: Elle doit payer pour le mal fait à nos compagnons...
msgctxt "NpcYell:12788:0:13"
msgid "'Tis the very depravity she showed at the Waking Sands."
msgstr "Это та самая жестокость, что она проявила в Живых песках."

#. ja: いつか浄化されるといいな<br>お前の想いも…
#. de: Auf dass auch du irgendwann Ruhe finden mögest.
#. fr: Je te souhaite que ton âme soit lavée...
msgctxt "NpcYell:12789:0:13"
msgid "May you be cleansed by the tide."
msgstr "Пусть волны очистят тебя."

#. ja: 怨念とは<br>魂に宿る無念なのか…
#. de: Ist Hass ein Groll von solcher Schwärze, dass er selbst die Seele zu trüben vermag?
#. fr: Une rancune si forte qu'elle habite l'âme après la mort...
msgctxt "NpcYell:12790:0:13"
msgid "Cling to any feeling so long and it's bound to turn dark..."
msgstr "Если слишком долго цепляться за чувства, они непременно омрачаются..."

#. ja: お眠りなさい…<br>その愛執を手放して…
#. de: Und nun ruhe, still und tief. Gleite aus den schweren Ketten des Verlangens, die dein Herz allzu eisern umklammert hielten.
#. fr: Oubliez cet amour et reposez en paix...
msgctxt "NpcYell:12791:0:13"
msgid "Release thy passions. For thine own sake."
msgstr "Отпусти свою страсть. Ради себя самой."

#. ja: どうにか祓えたか？
#. de: Sie scheint bezwungen.
#. fr: La voilà purrrifiée...<nbsp>?
msgctxt "NpcYell:12792:0:13"
msgid "Well! That was harrowing."
msgstr "Ну и жуть... Хорошо, что всё закончилось."

#. ja: いい加減に…してよね！
#. de: Jetzt lass es doch endlich gut sein!
#. fr: Ça va pas se passer comme ça<nbsp>!
msgctxt "NpcYell:12793:0:13"
msgid "That is quite enough!"
msgstr "С меня хватит!"

#. ja: そうか、お前も<br>手伝ってくれるのか…
#. de: Ah! Ich hatte mich schon gefragt, wann du wohl auftauchen würdest.
#. fr: Toi aussi, tu es venue nous aider...
msgctxt "NpcYell:12794:0:13"
msgid "Saving our hides once again?"
msgstr "Опять выручаешь нас?"

#. ja: これはムーンブリダの…
#. de: Moenbryda<nbsp>...
#. fr: Moenbryda, c'est toi<nbsp>?
msgctxt "NpcYell:12795:0:13"
msgid "That's Moenbryda's!"
msgstr "Это же топор Мёнбриды!"

#. ja: あなたはいつも<br>私の背を押すのですね…
#. de: Du bist gekommen<nbsp>... Du bist wahrlich gekommen.
#. fr: Tu as toujours été là, pour m'encourager...
msgctxt "NpcYell:12796:0:13"
msgid "Thou ever grantest me the strength to move forward..."
msgstr "Ты всегда придаёшь мне сил идти вперёд..."

#. ja: この斧は…<br>ダブルハーケン！？
#. de: I-Ist das eine Barbarenaxt?!
#. fr: Cette hache, c'est celle de Moenbryda...<nbsp>?
msgctxt "NpcYell:12797:0:13"
msgid "A dual haken?"
msgstr "Двойная алебарда?"

#. ja: フッ、お前がいて<br>彼女が来ないわけがないさ！
#. de: Natürlich kommt sie uns zur Hilfe, das war doch gar keine Frage!
#. fr: On peut toujours compter sur elle<nbsp>!
msgctxt "NpcYell:12798:0:13"
msgid "She'll always be here for you."
msgstr "Она всегда будет рядом."

#. ja: 来るぞ、ラインを見極めろ！<br>アリゼー！
#. de: Sie bildet ein Kreuz! Aus dem Weg, Alisaie!
#. fr: Alisaie, lis bien la trajectoire<nbsp>!
msgctxt "NpcYell:12799:0:13"
msgid "Watch where it splits. Alisaie!"
msgstr "Смотри, куда направлен удар! Ализе!"

#. ja: 了解っ！
#. de: Verstanden!
#. fr: Compris<nbsp>!
msgctxt "NpcYell:12800:0:13"
msgid "Way ahead of you!"
msgstr "Уже поняла!"

#. ja: よし…いける！
#. de: Und ... Jetzt!
#. fr: On peut y arriver<nbsp>!
msgctxt "NpcYell:12801:0:13"
msgid "Let's go!"
msgstr "Вперёд!"

#. ja: あの光は…？
#. de: Was ist das für ein Leuchten?
#. fr: Cette Lumière...<nbsp>?
msgctxt "NpcYell:12802:0:13"
msgid "Do you see that light?"
msgstr "Видите этот свет?"

#. ja: それが進むべき道なのね
#. de: Der Weg voran, wie mir scheint.
#. fr: Voilà donc la route qu'on doit emprunter.
msgctxt "NpcYell:12803:0:13"
msgid "This is our way forward."
msgstr "Вот наш путь."

#. ja: ああ…<br>オルシュファン卿の…！
#. de: Haurchefant!
#. fr: Sire Haurchefant aussi...<nbsp>?
msgctxt "NpcYell:12804:0:13"
msgid "Lord Haurchefant!"
msgstr "Лорд Оршефан!"

#. ja: ねぇ、もしかして<br>あの盾って…
#. de: Ist er nicht <i>derjenige</i>, der<nbsp>...
#. fr: Ce bouclier, aucun doute...
msgctxt "NpcYell:12805:0:13"
msgid "That shield!"
msgstr "Этот щит!"

#. ja: あの紋章は<br>フォルタン家の…
#. de: Das Wappen auf seinem Schild<nbsp>... Das rote Einhorn der Fortemps?
#. fr: L'emblème de la maison Fortemps...
msgctxt "NpcYell:12806:0:13"
msgid "The heraldry of House Fortemps..."
msgstr "Герб дома Фортанов..."

#. ja: 英雄を救いし<br>真なる騎士の魂…
#. de: Ein wahrer Ritter. Ein wahrer Held.
#. fr: L'âme d'un chevalier sacrrrifié pour ceux qu'il aimait...
msgctxt "NpcYell:12807:0:13"
msgid "A true knight, to thus aid a hero."
msgstr "Настоящий рыцарь — он спасает героя."

#. ja: その想い背負ってやるさ<br>イシュガルドの民としてな…
#. de: Finde Frieden. Für Ishgard wird gesorgt. Das schwöre ich auf unser beider Eid.
#. fr: Un héros, pour toujours dans le cœur des Ishgardais.
msgctxt "NpcYell:12808:0:13"
msgid "The people of Ishgard won't forget you."
msgstr "Народ Ишгарда тебя не забудет."

#. ja: あいつの想いも連れていくぞ！
#. de: Sein Streben wird nie vergessen werden.
#. fr: Haurchefant, tes sentiments nous rendront plus forts.
msgctxt "NpcYell:12809:0:13"
msgid "Now keep his hope alive!"
msgstr "Так сохраним же его надежду!"

#. ja: あの光は…！
#. de: Dieses Licht<nbsp>...!
#. fr: Cette Lumière, c'est...<nbsp>?
msgctxt "NpcYell:12810:0:13"
msgid "The light, it's..."
msgstr "Свет... это..."

#. ja: これから貴方を<br>夢の世界へと誘いましょう
#. de: Möge unser Lied Euch in das Land süßester Träume entführen!
#. fr: Nous allons vous transporter dans un monde onirique<nbsp>!
msgctxt "NpcYell:12811:0:13"
msgid "May our song guide you to the sweetest dreams you've ever known..."
msgstr "Пусть наша песня унесёт вас в самые сладкие сны..."

#. ja: どうか私に、「紫」の声援をいただけますか？
#. de: Verehrte Zuschauer. Wäret Ihr so gut, mich in violetten Schein zu hüllen?
#. fr: Auriez-vous l'obligeance de me montrer du violet<nbsp>?
msgctxt "NpcYell:12812:0:13"
msgid "Now, my dear audience, would you be so kind as to shine your violet lights my way?"
msgstr "Ну что, дорогие зрители, не подарите ли вы мне сияние фиолетовых огней?"

#. ja: ピコット～！
#. de: Prinz Schnuckiputz!
#. fr: Picooooot<nbsp>!
msgctxt "NpcYell:12813:0:13"
msgid "Over here, Picot!"
msgstr "Пико-о-от!"

#. ja: 大好きー！
#. de: Keiner ist so galant wie du, Picot!
#. fr: C'est toi le plus beau<nbsp>!
msgctxt "NpcYell:12814:0:13"
msgid "Let's hear it for Picot!"
msgstr "Давайте поприветствуем Пико!"

#. ja: これからも貴方に<br>醒めない夢を…
#. de: Dieser Moment mag verflogen sein, doch unser Traum währt weiter!
#. fr: Puisse ce rêve ne jamais s'arrêter...
msgctxt "NpcYell:12815:0:13"
msgid "Our moment has gone, but we shall dream on!"
msgstr "Наш миг прошёл, но мечта наша живёт!"

#. ja: ああもう、幸せ…！
#. de: Das war sooo schön!
#. fr: C'est le paradis<nbsp>!
msgctxt "NpcYell:12816:0:13"
msgid "This is the best day of my life...!"
msgstr "Лучшего дня в моей жизни не было...!"

#. ja: 忠誠心も我執となれば<br>怨念も同然か…
#. de: Wenn die Treue der einzige Antrieb ist, fängt sie irgendwann zu faulen an.
#. fr: Après la rancune, la fidélité aveugle...
msgctxt "NpcYell:12817:0:13"
msgid "Still holding to his principles in a way, I suppose."
msgstr "Похоже, он и после смерти не отступился от своих принципов."

#. ja: ガイウスの腹心…<br>もう争う必要はないのに！
#. de: Gaius' frühere rechte Hand! Dabei ist dieser Konflikt doch längst beendet!
#. fr: Tout ça pour Gaius... À quoi bon se battre<nbsp>?
msgctxt "NpcYell:12818:0:13"
msgid "Gaius no longer wishes this of you, Praefectus!"
msgstr "Гай больше не требует от тебя этого, префект!"

#. ja: 果たせなかった誓いが<br>未練になったと…？
#. de: Ein unerfüllter Schwur<nbsp>...?
#. fr: Les regrets d'une mission jamais accomplie...
msgctxt "NpcYell:12819:0:13"
msgid "Regret for a duty unfulfilled..."
msgstr "Сожаление о невыполненном долге..."

#. ja: その忠義より生まれた執念…<br>ここで浄化する！
#. de: Von dieser giftigen Obsession werden wir ihn nunmehr reinwaschen!
#. fr: Une autre âme qu'il ne tient qu'à nous de purrrifier<nbsp>!
msgctxt "NpcYell:12820:0:13"
msgid "Clinging to his orders even beyond death?"
msgstr "Даже после смерти он цепляется за приказы?"

#. ja: 忠誠心も我執となれば<br>怨念も同然ということだろう
#. de: Kein Zweifel. Treue, verzerrt von selbstsüchtigen Motiven.
#. fr: Fidélité aveugle... Devenue rancune à notre égard<nbsp>?
msgctxt "NpcYell:12821:0:13"
msgid "Maybe another sound thumping will convince him to let go."
msgstr "Может, ещё разок приложить его как следует — и он наконец отпустит прошлое."

#. ja: もう戦わずともいい…<br>ゆっくり眠ってくれ…
#. de: Nun musst du nicht mehr kämpfen. Gönn dir wohlverdiente Ruhe.
#. fr: Repose en paix, maintenant...
msgctxt "NpcYell:12822:0:13"
msgid "Rest. Your fight is over."
msgstr "Отдыхай. Твоя битва окончена."

#. ja: このような戦い…<br>ガイウスが望むはずが…
#. de: Gaius wäre beeindruckt von diesem Gefecht, das kann ich versichern.
#. fr: Gaius n'aurait jamais souhaité une fin pareille...
msgctxt "NpcYell:12823:0:13"
msgid "You didn't fail him..."
msgstr "Ты не подвёл его..."

#. ja: 忠義の将の魂よ…<br>星に還りたまえ…
#. de: Möge die Seele des treuen Kriegers zurück zum Planeten finden.
#. fr: Qu'il trouve sa place parmi les étoiles...
msgctxt "NpcYell:12824:0:13"
msgid "Return now to the star, that thy loyalty might serve better ends..."
msgstr "Возвращайся же к звезде, дабы верность твоя послужила благому делу..."

#. ja: 戦いは終いだ…<br>安らかに眠れ…
#. de: Der Krieg ist aus. Ruhe sanft, edelmütiger Soldat.
#. fr: La lutte est finie. Tu peux te reposer, désorrrmais.
msgctxt "NpcYell:12825:0:13"
msgid "Lay down your arms..."
msgstr "Сложи оружие..."

#. ja: これは未練の影だ<br>本人も望んじゃないさ…
#. de: Nur ein Schemen, nicht der echte<nbsp>... Stimmt doch, oder?
#. fr: Des sentiments exacerbés et déformés... Pauvre Rhitahtyn...
msgctxt "NpcYell:12826:0:13"
msgid "That was but a shade. I'm sure the true Rhitahtyn has moved on."
msgstr "Это была лишь тень. Настоящий Ритацин, уверен, уже обрёл покой."

#. ja: あの光は…！<br>まさか…！？
#. de: Dieses Licht<nbsp>...
#. fr: Cette Lumière... C'est toi<nbsp>!?
msgctxt "NpcYell:12827:0:13"
msgid "This Light! Is it truly─"
msgstr "Этот Свет! Неужели это..."

#. ja: 光が…<br>クリスタルの道を！
#. de: Schaut, das Licht formt uns einen Weg!
#. fr: La Lumière nous montre la voie<nbsp>!
msgctxt "NpcYell:12828:0:13"
msgid "Look, the Crystal!"
msgstr "Смотрите, Кристалл!"

#. ja: 前方の輝きは…<br>やはり…
#. de: Dieses Strahlen<nbsp>... Kann es denn wirklich sein?
#. fr: Cette lueur qui nous guide...
msgctxt "NpcYell:12829:0:13"
msgid "It has to be..."
msgstr "Это должно быть..."

#. ja: そう、やはり来てくれたのね…
#. de: Ich wusste, dass du kommen würdest.
#. fr: Tu es venue, hein<nbsp>?
msgctxt "NpcYell:12830:0:13"
msgid "We knew you'd come."
msgstr "Мы знали, что ты придёшь."

#. ja: この温かな光は…？
#. de: Was für ein warmes, sanftes Leuchten.
#. fr: Quelle aurrra douce et apaisante...
msgctxt "NpcYell:12831:0:13"
msgid "Such a warm glow..."
msgstr "Какое тёплое сияние..."

#. ja: ええ、そうよ…<br>彼女だわ…
#. de: Ja. Das ist sie.
#. fr: Aucun doute, c'est bien elle.
msgctxt "NpcYell:12832:0:13"
msgid "Indeed. It's her."
msgstr "Да. Это она."

#. ja: 俺たちを<br>導いてくれるのか…！
#. de: Immer dann, wenn ich nicht weiß, wie es weitergehen soll<nbsp>...
#. fr: Elle est venue nous montrer la voie<nbsp>!
msgctxt "NpcYell:12833:0:13"
msgid "Showing us the way...once more."
msgstr "И снова указывает нам путь..."

#. ja: 私たちの進むべき道を…
#. de: Und wieder weist du uns den Weg.
#. fr: Comme autrefois, c'est elle qui nous guide...
msgctxt "NpcYell:12834:0:13"
msgid "Our Antecedent."
msgstr "Наш Предшественник."

#. ja: この先に真実はある、と
#. de: Keiner Weisung würde ich mehr vertrauen. Ein Weg gen Zukunft.
#. fr: La vérité est de l'autre côté...
msgctxt "NpcYell:12835:0:13"
msgid "The truth lieth ahead."
msgstr "Истина впереди."

#. ja: また会えるという予感は<br>確かにあったわ…
#. de: Ich wusste, dass wir uns wiedersehen würden.
#. fr: Je savais bien qu'on se retrouverait un jour...
msgctxt "NpcYell:12836:0:13"
msgid "I knew we would meet here."
msgstr "Я знала, что мы ещё встретимся."

#. ja: そうか、あの光が…
#. de: Ah, jetzt begreife ich ...
#. fr: Bien sûrrr<nbsp>! Cette Lumière, ça ne pouvait être qu'elle<nbsp>!
msgctxt "NpcYell:12837:0:13"
msgid "I am truly honored."
msgstr "Для меня это великая честь."

#. ja: 彼女こそが俺たちの<br>導き手だったものな…
#. de: Bis zuletzt führst du uns auf den richtigen Pfad.
#. fr: Avec toi, on est entre de bonnes mains<nbsp>!
msgctxt "NpcYell:12838:0:13"
msgid "She always was our lodestar."
msgstr "Она всегда была нашей путеводной звездой."

#. ja: ミンフィリア…！<br>俺は…！
#. de: Minfilia!
#. fr: Minfilia, je...
msgctxt "NpcYell:12839:0:13"
msgid "Minfilia! I..."
msgstr "Минфилия! Я..."

#. ja: ありがとう…<br>私たちは前に進むよ
#. de: Wir danken dir, von Herzen. Und werden voranschreiten.
#. fr: Qui d'autre pour montrer la voie aux Héritiers<nbsp>?
msgctxt "NpcYell:12840:0:13"
msgid "We'll make you proud."
msgstr "Мы тебя не подведём."

#. ja: あなたの願いは<br>果たされましたか？
#. de: Hat sich dein Wunsch erfüllt?
#. fr: Votre vœu est-il exaucé, Minfilia<nbsp>?
msgctxt "NpcYell:12841:0:13"
msgid "Art thou content?"
msgstr "Ты довольна?"

#. ja: ミンフィリア、優しい子…<br>導いてくれて、ありがとう
#. de: Minfilia, du sanfte Seele. Danke, dass du uns abermals geleitet hast.
#. fr: Minfilia, on ne te remerciera jamais assez...
msgctxt "NpcYell:12842:0:13"
msgid "Our thanks, Minfilia, for being our guide."
msgstr "Спасибо, Минфилия, что вновь указала нам путь."

#. ja: 世界を救ってくれて<br>ありがとう…
#. de: Ich danke dir, dass du sie gerettet hast. Jene Welt.
#. fr: Merrrci, au nom de tous les humains.
msgctxt "NpcYell:12843:0:13"
msgid "I've always wanted to thank you. For saving our star."
msgstr "Я давно хотел поблагодарить тебя. За спасение нашей звезды."

#. ja: 想いは伝わっているわ<br>そういうものでしょう？
#. de: Wir verstehen, Minfilia. Ich hoffe, du verstehst uns auch.
#. fr: Par la pensée aussi, on ne fait qu'un<nbsp>!
msgctxt "NpcYell:12844:0:13"
msgid "I'm certain she knows."
msgstr "Уверен, она всё знает."

#. ja: こいつは<br>執念の極めつけか…！
#. de: Und das wäre wohl der ultimative Groll.
#. fr: En parlant d'obsession, voilà le champion<nbsp>!
msgctxt "NpcYell:12845:0:13"
msgid "We might have expected this, in retrospect."
msgstr "Вот уж кто зациклился на своём до последнего..."

#. ja: これが、ファダニエルの…
#. de: Diese Gestalt<nbsp>...!
#. fr: Je n'ai pas les mots...
msgctxt "NpcYell:12846:0:13"
msgid "Fandaniel's...soul?"
msgstr "Душа Фанданиля?.."

#. ja: 計り知れぬ失望と<br>底知れぬ絶望の権化…
#. de: Die Ver<shy>zweif<shy>lung und Enttäuschung sind so erdrückend, ich wage kaum zu atmen.
#. fr: Le résultat d'une spirale de déception et de désespoir...
msgctxt "NpcYell:12847:0:13"
msgid "Loss and grief beyond measure..."
msgstr "Безмерная скорбь и горечь утраты..."

#. ja: その姿…<br>アラグの大魔科学者…！
#. de: Allags brillantester Wissenschaftler<nbsp>...
#. fr: Le génie de la magismologie...<nbsp>!?
msgctxt "NpcYell:12848:0:13"
msgid "That mask... That of Allag's greatest mind."
msgstr "Эта маска... Так выглядел величайший учёный Аллагана."

#. ja: どんな姿だって<br>私たちは負けないわ！
#. de: Mir egal, wie du aussiehst. Bezwingen werden wir dich in jeder Form!
#. fr: C'est pas ça qui va nous impressionner<nbsp>!
msgctxt "NpcYell:12849:0:13"
msgid "It will take more than a bit of theater to frighten me."
msgstr "Меня не испугает дешёвый спектакль."

#. ja: あれは…<br>この星の住人なのか？
#. de: Sind das die Bewohner dieses Planeten?
#. fr: Les habitants de cette planète, j'imagine<nbsp>?
msgctxt "NpcYell:12850:0:13"
msgid "Are those...denizens of this star?"
msgstr "Это... жители этой звезды?"

#. ja: これが…メーティオンたちが見た<br>絶望の姿…？
#. de: Das haben also die Meteions gesehen. Schrecklich.
#. fr: Météion nous montre une des tragédies dont elle a été témoin<nbsp>?
msgctxt "NpcYell:12851:0:13"
msgid "Is this truly what Meteion and her sisters saw?"
msgstr "Неужели именно это видели Метеион и её сёстры?"

#. ja: 星が病に侵された…？
#. de: Ist der Planet selbst erkrankt?
#. fr: Une maladie aurait dévasté leur planète...<nbsp>?
msgctxt "NpcYell:12852:0:13"
msgid "A most grievous malady hath stricken this star."
msgstr "Эту звезду поразила страшная болезнь."

#. ja: 酷い臭いだ…<br>何かが腐敗したような…
#. de: Dieser Gestank ... Das ist Verwesung.
#. fr: Quelle odeurrr nauséabonde. Comme si tout avait pourri...
msgctxt "NpcYell:12853:0:13"
msgid "Ugh, that smell..."
msgstr "Фу, да что за вонь..."

#. ja: 生きながらに<br>腐りゆく星…
#. de: Diese Katastrophe hat den Stern in einen Kadaver verwandelt.
#. fr: Ils restent vivants alors que leur corps se putréfie petit à petit...
msgctxt "NpcYell:12854:0:13"
msgid "Aye, a most horrid calamity hath made a corpse of the star."
msgstr "Да, страшная беда превратила звезду в труп."

#. ja: なんてことなの…
#. de: Das ist ja schrecklich.
#. fr: C'est horrible...
msgctxt "NpcYell:12855:0:13"
msgid "Gods, this is awful..."
msgstr "Боги, какой ужас..."

#. ja: 哀しいわね…<br>ただただ哀しい…
#. de: Es ist traurig, einfach nur traurig.
#. fr: Un bien triste sort...
msgctxt "NpcYell:12856:0:13"
msgid "Such devastation... It defies belief."
msgstr "Такое разрушение... Не верится, что это правда."

#. ja: メーティオンたちが見た<br>光景の再現か…
#. de: Es ist eine Projektion dessen, was die Meteions sahen.
#. fr: Météion et ses sœurrrs ont assisté à tout ça...
msgctxt "NpcYell:12857:0:13"
msgid "Were all the stars she visited like this, I wonder?"
msgstr "Неужели все звёзды, на которых она побывала, были такими?"

#. ja: 生きるために、<br>憎むべき相手を創る、か…
#. de: Verarbeiten sie so den Schmerz?
#. fr: Rien de tel que de s'inventer un ennemi commun pour survivre...
msgctxt "NpcYell:12858:0:13"
msgid "To be fueled by hatred is no way to live."
msgstr "Ненависть — плохое топливо для жизни."

#. ja: 彼らとて常ならば<br>善き人々だったろうに…
#. de: Sie waren bestimmt mal ganz normale Leute ...
#. fr: Et dire que ce devait tous être d'honnêtes gens en temps normal...
msgctxt "NpcYell:12859:0:13"
msgid "They turned on each other, just like that?"
msgstr "А ведь когда-то они, должно быть, были обычными людьми..."

#. ja: 生きながらに<br>病の源になると…？
#. de: Sie leben, und doch werden sie zu einem Krankheitsherd für alle ...
#. fr: Il continue de vivre et de répandre la maladie<nbsp>!?
msgctxt "NpcYell:12860:0:13"
msgid "To live only meant spreading this plague to others."
msgstr "Они жили лишь затем, чтобы разносить эту чуму."

#. ja: 見ていられない…！
#. de: Ich kann mir das nicht ansehen!
#. fr: Faut faire quelque chose<nbsp>!
msgctxt "NpcYell:12861:0:13"
msgid "I'm not sure how much more I can stand to see."
msgstr "Не знаю, сколько ещё я выдержу..."

#. ja: 身の内に膨大な毒気を<br>保持しているようです…
#. de: In ihren Körpern wächst ein Gift.
#. fr: Son corps semble déborder de cette fameuse toxine.
msgctxt "NpcYell:12862:0:13"
msgid "'Twould seem this beast drinketh deep of pestilence..."
msgstr "Похоже, эта тварь насквозь пропитана заразой..."

#. ja: 感染者は内側から<br>別の何かに変わりゆく…
#. de: Wer sich ansteckt, verwandelt sich, von innen nach außen.
#. fr: Alors ils se transforment de l'intérieur une fois infectés...
msgctxt "NpcYell:12863:0:13"
msgid "It's as if the affliction warps their very bones."
msgstr "Выходит, болезнь меняет их до самых костей."

#. ja: 哀れだな…
#. de: Fürchterlich.
#. fr: Le malheureux...
msgctxt "NpcYell:12864:0:13"
msgid "I pity them."
msgstr "Бедняги..."

#. ja: 酷いものね…<br>本当に…
#. de: Das ist alles nur schwer zu ertragen.
#. fr: Quel sort atroce...
msgctxt "NpcYell:12865:0:13"
msgid "Perhaps death would have been kinder..."
msgstr "Может, смерть была бы милосерднее..."

#. ja: これは過去の記憶…<br>そう解ってはいても…
#. de: Dies ist eine Erinnerung an die Ver<shy>gangen<shy>heit.
#. fr: Je sais que ce n'était qu'un souvenir, mais...
msgctxt "NpcYell:12866:0:13"
msgid "Would that this were not merely a memory."
msgstr "Знаю, это лишь воспоминание, но..."

#. ja: …何を見せられたって<br>私は…！
#. de: Was musste ich mir da ansehen?
#. fr: C'est pas en me montrant ça qu'elle me fera reculer<nbsp>!
msgctxt "NpcYell:12867:0:13"
msgid "I think I've had my fill of this nightmare."
msgstr "С меня хватит этого кошмара."

#. ja: これが、この星の絶望…
#. de: Dies ist die Hoffnungs<shy>losig<shy>keit des Planeten.
#. fr: Un triste destin pour cette civilisation...
msgctxt "NpcYell:12868:0:13"
msgid "That any star should suffer such a fate..."
msgstr "И звезда может пасть так ужасно..."

#. ja: この苦しみを…<br>メーティオンは知ったのね…
#. de: Die Meteions haben das ganze Leid mitangesehen.
#. fr: Météion a ressenti toute la peine dont nous n'avons été que les témoins...
msgctxt "NpcYell:12869:0:13"
msgid "Telling that Meteion recalls their suffering in such detail."
msgstr "Метеион помнит их страдания в мельчайших подробностях. Вот что поразительно."

#. ja: 倒したとて<br>虚しさしか覚えん…
#. de: Hier ist nichts außer endloser Trauer.
#. fr: Une victoire, mais sur quoi exactement<nbsp>?
msgctxt "NpcYell:12870:0:13"
msgid "A hollow victory."
msgstr "Пустая победа."

#. ja: ええ、どうか安らかにと<br>願わずにはいられないわ
#. de: Ja, man wünscht sich nur, dass es endlich aufhört.
#. fr: Espérons au moins qu'il repose en paix.
msgctxt "NpcYell:12871:0:13"
msgid "I know. We can but pray it found peace in the hereafter."
msgstr "Да. Остаётся лишь молиться, чтобы там, за гранью, оно обрело покой."

#. ja: こいつは…<br>戦場の真っ只中か！？
#. de: Mitten auf dem Schlachtfeld?
#. fr: On tombe au beau milieu d'une guerre, maintenant<nbsp>!?
msgctxt "NpcYell:12872:0:13"
msgid "Has she thrown us into the middle of a war!?"
msgstr "Она забросила нас прямо в разгар войны?!"

#. ja: この星は…<br>戦争によって…？
#. de: Krieg hat diesen Planeten ...
#. fr: Ce monde aurait été anéanti par la guerre<nbsp>?
msgctxt "NpcYell:12873:0:13"
msgid "This star was sundered by war, then?"
msgstr "Выходит, эта звезда погибла из-за войны?"

#. ja: 高度な文明も<br>滅びを止められない…と？
#. de: Das alles trotz dieser hohen Kulturstufe ...
#. fr: Cette civilisation semble si avancée, et pourtant...
msgctxt "NpcYell:12874:0:13"
msgid "Yet they saw not what they had wrought ere it consumed them..."
msgstr "Неужели они не замечали, что натворили, пока их же творение не погубило их?"

#. ja: この光景…くそっ！
#. de: Dieser Anblick ...
#. fr: Voilà qui fait ressurgir des souvenirs que j'aurais préférrré oublier...
msgctxt "NpcYell:12875:0:13"
msgid "Such wanton destruction..."
msgstr "Столько бессмысленных разрушений..."

#. ja: …そう、似ているのね？
#. de: Ja. Das haben wir schon einmal gesehen.
#. fr: Passés ou futurs<nbsp>?
msgctxt "NpcYell:12876:0:13"
msgid "A fate I pray never comes to pass on Etheirys."
msgstr "Молюсь, чтобы Этерис никогда не постигла такая участь."

#. ja: これが、避けられない<br>人の未来だって言いたいの！？
#. de: Soll das die unumgängliche Zukunft sein?
#. fr: Ça aussi, ce serait un futur auquel on ne peut pas échapper<nbsp>!?
msgctxt "NpcYell:12877:0:13"
msgid "Does she truly believe this is the fate of all peoples?"
msgstr "Неужели она и вправду считает, что все народы обречены на такую участь?"

#. ja: 争いを止めようとした者も<br>いたはずよ…
#. de: Irgendjemand muss doch versucht haben, den Krieg aufzuhalten?
#. fr: Certains ont forcément tenté d'enrayer le conflit...
msgctxt "NpcYell:12878:0:13"
msgid "Surely, there were those who sought to end the bloodshed?"
msgstr "Наверняка ведь были те, кто пытался остановить кровопролитие?"

#. ja: 希望を捨てなかった人もいる！<br>…オレはこの目でそれを見た！
#. de: Nicht jeder gab die Hoffnung auf. Ich weiß es!
#. fr: Même ainsi, il y a toujours des gens pour garrrder espoir<nbsp>! Je l'ai vu de mes propres yeux<nbsp>!
msgctxt "NpcYell:12879:0:13"
msgid "Not everyone would have abandoned hope. I know it..."
msgstr "Не все могли потерять надежду. Я знаю..."

#. ja: その理由なら…<br>嫌というほど知っている
#. de: Ich kenne die Gründe nur allzu gut ...
#. fr: Je ne connais que trop bien la raison.
msgctxt "NpcYell:12880:0:13"
msgid "Whatever freedom they found, I'm sure it was short-lived."
msgstr "Какая бы свобода им ни досталась, долго она не продержалась."

#. ja: 一方の自由は<br>もう一方の不自由と…
#. de: Die Freiheit des Einen ist die Fessel des Anderen.
#. fr: La liberté des uns s'arrête là où commence celle des autres.
msgctxt "NpcYell:12881:0:13"
msgid "Or mayhap it was not freedom at all."
msgstr "А может, никакой свободы и не было."

#. ja: 殺戮兵器の親玉か…
#. de: Ist das der Chef der Mördermaschinen?
#. fr: Voilà le tas de ferraille qui commande à ces machines tueuses.
msgctxt "NpcYell:12882:0:13"
msgid "That's a big one."
msgstr "Вот это громадина."

#. ja: 何を見せられたって…<br>退くもんですか…！
#. de: Wir werden nicht aufgeben!
#. fr: Elle peut nous montrer ce qu'elle veut, on ne reculera pas<nbsp>!
msgctxt "NpcYell:12883:0:13"
msgid "We've come too far to back down now."
msgstr "Мы зашли слишком далеко, чтобы теперь отступать."

#. ja: 戦争を終わらせるはずの機械が…
#. de: Die Maschinen sollten den Krieg doch beenden.
#. fr: Il devait mettre fin à la guerre, et au lieu de ça...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:12884:0:13"
msgid "Was <i>this</i> meant to bring an end to the war?"
msgstr "Неужели именно <i>это</i> должно было положить конец войне?"

#. ja: これだけの技術力が<br>ありながら…
#. de: Und das alles trotz dieses technologischen Fortschritts ...
#. fr: Ils en sont arrivés là malgré tout ce savoirrr...
msgctxt "NpcYell:12885:0:13"
msgid "They could have accomplished so much good with their knowledge..."
msgstr "С такими знаниями они могли бы принести столько добра..."

#. ja: フン…何がこようと<br>突き進むだけだ
#. de: Was auch kommt, man muss es überwinden.
#. fr: Hmpf... On perce au travers et on avance. C'est aussi simple que ça.
msgctxt "NpcYell:12886:0:13"
msgid "Hmph. I've seen bigger."
msgstr "Хм. Видал я и покрупнее."

#. ja: だからお前は<br>塔の扉を閉ざしたんだろ？
#. de: Hast du deswegen die Tür zum Turm versperrt?
#. fr: C'est aussi pour ça que tu as gardé closes les portes de la Tour de Cristal, non<nbsp>?
msgctxt "NpcYell:12887:0:13"
msgid "I can see why you chose to lock the Crystal Tower."
msgstr "Теперь понятно, почему ты запер Кристальную башню."

#. ja: …虚しい戦いの記憶、か
#. de: Es erinnert mich an schreckliche Kämpfe.
#. fr: Les souvenirs d'un combat acharné mené en vain...
msgctxt "NpcYell:12888:0:13"
msgid "That brings back memories I'd much rather forget."
msgstr "Вспомнил то сражение... Лучше бы не вспоминал."

#. ja: 前へ…<br>もっと前へ進むわよ！
#. de: Weiter! Wir müssen weiter!
#. fr: Vers l'avant... toujours vers l'avant<nbsp>!
msgctxt "NpcYell:12889:0:13"
msgid "Come on, we have to keep going!"
msgstr "Давай, надо идти дальше!"

#. ja: 人が不要なものと判断された…<br>皮肉なものね…
#. de: Welch Ironie. Maschinen, die das Leben für überflüssig erklären.
#. fr: Leur Pacificateur avait finalement déclaré la vie superflue. Quelle ironie...
msgctxt "NpcYell:12890:0:13"
msgid "Peace through exterminating its creators... “Peacekeeper,” indeed."
msgstr "Мир ценой истребления создателей... Ну и имя же у тебя, Миротворец."

#. ja: 技術は…<br>自由のためにあるんだよ！
#. de: Dabei soll die Technik doch ihrem Erschaffer dienen!
#. fr: Liberrrté grâce à la technologie<nbsp>!
msgctxt "NpcYell:12891:0:13"
msgid "This is not at all what technology was meant for!"
msgstr "Технологии ведь должны служить людям!"

#. ja: 俺たちは運が良かった<br>戦争を止められたんだからな
#. de: Ishgard hatte noch Glück. Unser Krieg fand ein versöhnliches Ende.
#. fr: Heu<shy>reu<shy>se<shy>ment que nous ne sommes jamais arrivés à de telles extrémités.
msgctxt "NpcYell:12892:0:13"
msgid "This could have been us, had we been unable to stop the war..."
msgstr "Это могли быть и мы, не сумей мы остановить войну..."

#. ja: ああ…その言葉のおかげで<br>俺たちはここにいる
#. de: Schwere Worte, wohl gesprochen.
#. fr: On ne serait pas là aujourd'hui sans cette maxime.
msgctxt "NpcYell:12893:0:13"
msgid "“Freedom through technology.” If not for that, we wouldn't be here."
msgstr "«Свобода благодаря технологиям». Не будь этого убеждения, нас бы здесь не было."

#. ja: なんて穏やかな世界…<br>それなのに…？
#. de: Diese Welt war einmal wunderschön. Doch dann ...
#. fr: Ce monde semble pourtant si paisible...
msgctxt "NpcYell:12894:0:13"
msgid "This place is...beautiful."
msgstr "Какое здесь... прекрасное место."

#. ja: 満ち足りた先に待つ<br>結末というわけ…？
#. de: Ob es die Erfülltheit des Lebens war, was dieses Ende heraufbeschwor?
#. fr: Ce serait ce qui attend les civilisations qui comblent tous leurs désirs<nbsp>?
msgctxt "NpcYell:12895:0:13"
msgid "Their end came not for want, but for the lack of it..."
msgstr "Неужели их погубило изобилие? Когда им уже ничего не было нужно..."

#. ja: この美しい世界が…<br>絶望だっていうのか？
#. de: Ein Auge weint ob der Schönheit, das andere aus Trauer über diese Welt.
#. fr: Où le désespoir a-t-il pu gerrrmer dans ce monde magnifique<nbsp>?
msgctxt "NpcYell:12896:0:13"
msgid "How could anyone despair in a world such as this?"
msgstr "Как можно отчаяться в таком прекрасном мире?"

#. ja: なんだここは…<br>生きた心地がしないぞ
#. de: Der Wind, er bläst so lau ...
#. fr: Je ne vois rien de vraiment vivant, ici...
msgctxt "NpcYell:12897:0:13"
msgid "This place feels strangely devoid of life..."
msgstr "Здесь как-то... совсем нет жизни."

#. ja: ……
#. de: Die Schönheit täuscht nicht über den Schrecken hinweg.
#. fr: ...
msgctxt "NpcYell:12898:0:13"
msgid "..."
msgstr "..."

#. ja: でも…なんだろう<br>寂しさで満ちている…
#. de: Ja. Man möchte weinen.
#. fr: Magnifique, oui. Mais ces paysages me semblent aussi empreints d'une profonde mélancolie...
msgctxt "NpcYell:12899:0:13"
msgid "Looks can deceive. This place is beautiful...but cold."
msgstr "Красиво, да... Только холодно здесь. И одиноко."

#. ja: さて今日の評価対象は<br>たしか、この辺りに…
#. de: Wo ist denn mein Beobachtungsobjekt?
#. fr: Si je ne me trompe pas, elles devraient être par ici...
msgctxt "NpcYell:12900:0:13"
msgid "They should be here somewhere... "
msgstr "Они должны быть где-то здесь..."

#. ja: うわっ…！<br>こちらを襲う気なのか！？
#. de: Hilfe!
#. fr: Mais<nbsp>!? Qu'est-ce qui se passe<nbsp>!?
msgctxt "NpcYell:12901:0:13"
msgid "O-Oh my! They appear to be coming this way!"
msgstr "Ой-ой! Кажется, они идут на нас!"

#. ja: に、逃げなければ…！
#. de: Was tun!?
#. fr: Au secours<nbsp>!
msgctxt "NpcYell:12902:0:13"
msgid "Run for the hills!"
msgstr "Бежим!"

#. ja: オォォン…<br>ガサガサガサ…！
#. de: Uaaaa!
#. fr: Groooaaarh<nbsp>!
msgctxt "NpcYell:12903:0:13"
msgid "\\<rustle> \\<rustle> \\<rustle>"
msgstr ""

#. ja: グォッ…<br>ガサガサガサ…！
#. de: Uaaaah!
#. fr: Frrr... Groaaarh<nbsp>!
msgctxt "NpcYell:12904:0:13"
msgid "\\<rustle> \\<rustle> \\<rustle>"
msgstr ""

#. ja: 自由なる風を<br>奪わせるものか！
#. de: Niemals lassen wir uns den Wind der Freiheit aus den Schwingen nehmen!
#. fr: Le vent nous rend libres<nbsp>! Jamais vous ne nous le volerez<nbsp>!
msgctxt "NpcYell:12905:0:13"
msgid "You shall not take the wind from our wings!"
msgstr "Не отнимайте у нас ветер свободы!"

#. ja: これしきの毒で…！
#. de: Dieses vermaledeite Gift<nbsp>...
#. fr: J'ai sous-estimé son venin...<nbsp>!
msgctxt "NpcYell:12906:0:13"
msgid "This poison...is too strong..."
msgstr "Этот яд... Слишком силён..."

#. ja: ああっ！<br>エーテルが…！
#. de: Aah! Mein Äther<nbsp>...
#. fr: Urgh, mon éther est en berne...
msgctxt "NpcYell:12907:0:13"
msgid "Ah! My aether wanes...!"
msgstr "Ах! Мой эфир иссякает...!"

#. ja: 術式展開を<br>止めるわけには…！
#. de: Das Ritual muss fortgesetzt werden!
#. fr: Non... La Lice cardinale n'est pas encore...<nbsp>!
msgctxt "NpcYell:12908:0:13"
msgid "The summoning must needs be completed!"
msgstr "Надо завершить призыв, чего бы это ни стоило!"

#. ja: あと少し、なのに…！
#. de: Es fehlt doch nicht mehr viel<nbsp>...
#. fr: Allez...<nbsp>! J'y suis presque...<nbsp>!
msgctxt "NpcYell:12909:0:13"
msgid "We...have failed..."
msgstr "Мы... не справились..."

#. ja: 部品は見つかったが<br>俺ひとりでは…
#. de: Ich habe ein Bauteil gefunden. Aber allein finde ich nie genug!
#. fr: Ce sont les pièces qu'il me faut. Mais je n'arriverai pas à les récupérer seul<nbsp>!
msgctxt "NpcYell:12910:0:13"
msgid "The parts I seek... So near, yet so far!"
msgstr "Вот нужные детали... Так близко — и так далеко!"

#. ja: これじゃあ<br>修理はできないな…
#. de: Hm. Damit lässt sich nichts reparieren.
#. fr: Ce n'est pas comme ça que je vais pouvoir réparer quoi que ce soit...
msgctxt "NpcYell:12911:0:13"
msgid "I'll have to search elsewhere."
msgstr "Придётся поискать в другом месте."

#. ja: せっかく食料を<br>掻き集めたのに…
#. de: Die guten Lebensmittel!
#. fr: On s'était donné tant de mal à trouver ces vivres...
msgctxt "NpcYell:12912:0:13"
msgid "We hunted high and low for these provisions."
msgstr "Мы столько сил потратили, чтобы добыть эти припасы..."

#. ja: ヨトゥンどもが<br>来るぞッ！
#. de: Die Jötnar kommen!
#. fr: Les jötunn arrivent<nbsp>!
msgctxt "NpcYell:12913:0:13"
msgid "Jotnar! They're closing in!"
msgstr "Йотуны! Они приближаются!"

#. ja: な、なんてこった…
#. de: Was soll das!?
#. fr: C-c'est pas possible...
msgctxt "NpcYell:12914:0:13"
msgid "What a terrible waste..."
msgstr "Вот же напрасная трата..."

#. ja: ええい！<br>あっちにいけ！
#. de: Verschwinde!
#. fr: Allez vous-en<nbsp>!
msgctxt "NpcYell:12915:0:13"
msgid "Get back! Back, I say!"
msgstr "Назад! Сказал же, назад!"

#. ja: 助かったよ…<br>ありがとう！
#. de: Wir sind gerettet! Danke!
#. fr: Vous avez sauvé nos vivres<nbsp>!
msgctxt "NpcYell:12916:0:13"
msgid "The provisions are safe! Thank you!"
msgstr "Запасы целы! Спасибо!"

#. ja: ブォォォーン！
#. de: Buaaaah!
#. fr: Bouaaaah<nbsp>!
msgctxt "NpcYell:12917:0:13"
msgid "Bwaaaaaagh!"
msgstr "Буаа-а-а!"

#. ja: グオンッ！
#. de: Groaaah!
#. fr: Grouaaaah<nbsp>!
msgctxt "NpcYell:12918:0:13"
msgid "Graaah!"
msgstr "Гра-а-а!"

#. ja: 帝都壊滅ヲ確認…<br>自動迎撃モード起動中…
#. de: Zerstörung an Kaiserstadt festgestellt.<br>Initiiere Auto-Angriffsmodus.
#. fr: Confirmation d'importants dégâts infligés à la capitale. Passage au mode d'attaque automatique.
msgctxt "NpcYell:12919:0:13"
msgid "Significant damage to imperial capital detected. Initiating automated combat protocol."
msgstr "Обнаружены серьёзные повреждения столицы империи. Запускаю протокол автоматического боя."

#. ja: 登録外ノ戦力ヲ確認…<br>自動迎撃行動、開始シマス！
#. de: Unerwarteter Widerstand festgestellt.<br>Initiiere Auto-Angriffsmodus.
#. fr: Menace non identifiée détectée. Passage à l'attaque imminent.
msgctxt "NpcYell:12920:0:13"
msgid "Unidentified combatant detected. Commencing attack."
msgstr "Обнаружен неизвестный боец. Начинаю атаку."

#. ja: 帝国ニ…<br>栄光、ア、レ…
#. de: Ehre<nbsp>... dem Kaiser... reich<nbsp>...
#. fr: G-g-gloire... à... l'Empire...
msgctxt "NpcYell:12921:0:13"
msgid "Glory...be..."
msgstr "Сла... ва..."

#. ja: ウウ…<br>帝国ノ為ニ…
#. de: Uuuh<nbsp>... Für<nbsp>... Garlemald<nbsp>...
#. fr: Urgh... P-pour... l'Empire...
msgctxt "NpcYell:12922:0:13"
msgid "For the Empire..."
msgstr "За империю..."

#. ja: どこに逃げれば<br>助かるんだ…
#. de: Wohin sollen wir nur fliehen?
#. fr: Où peut-on encore fuir...<nbsp>?
msgctxt "NpcYell:12923:0:13"
msgid "Is nowhere safe!?"
msgstr "И что, нигде не укрыться?!"

#. ja: 子どもたちまで化物に…
#. de: Flieht, lauft um euer Leben!
#. fr: Même les enfants... Les pauvres...
msgctxt "NpcYell:12924:0:13"
msgid "...How!? How did it come to this!?"
msgstr "...Как?! Как до такого дошло?!"

#. ja: タ、タス、ケ…
#. de: Helft uns. Bitte ...
#. fr: Au... Se...CoUrS...
msgctxt "NpcYell:12925:0:13"
msgid "HeLp... PlEaSe..."
msgstr "По... мо... ги..."

#. ja: まだなのか…<br>はやく終わりをおくれ
#. de: Wann werde ich endlich erlöst?
#. fr: Ra-la... Quand viendras-tu me cueillir<nbsp>?
msgctxt "NpcYell:12926:0:13"
msgid "Is my time not yet come?"
msgstr "Мне ещё не пора?.."

#. ja: いかないで、ラーラー<br>無に還らせて…
#. de: Ra-la, geh nicht! Bitte erlöse mich!
#. fr: Ne t'en va pas Ra-la. Offre le repos éternel à cet individu aussi...
msgctxt "NpcYell:12927:0:13"
msgid "Please, Ra-la, come back! I long for release!"
msgstr "Ра-Ла, не уходи! Прошу, избавь меня от мучений!"

#. ja: そろそろ私の番かな…
#. de: Bald ist es an mir zu vergehen ...
#. fr: Quand viendra donc mon tour...<nbsp>?
msgctxt "NpcYell:12928:0:13"
msgid "Has my time come at last?"
msgstr "Неужели теперь моя очередь?.."

#. ja: 消してくれ…<br>私を消してくれ…
#. de: Ich flehe dich an<nbsp>... Beende mein Leiden<nbsp>...
#. fr: Réduisez cet individu à néant... C'est tout ce qu'il souhaite...
msgctxt "NpcYell:12929:0:13"
msgid "Please, I beg of you─end my suffering."
msgstr "Прошу, умоляю... прекрати мои мучения."

#. ja: ガ…<br>ガレマ、ル…
#. de: Gar... le... mald...
#. fr: G-g-gloire...
msgctxt "NpcYell:12930:0:13"
msgid "G-Guh-Garlemaaald..."
msgstr "Г-Гарлемальд..."

#. ja: テ、テイ…コク…<br>エイ…コォ…
#. de: E-Ehre<nbsp>... d-dem<nbsp>... K-Kaiserreich<nbsp>...
#. fr: À... G-G-Gar... Garlemald...
msgctxt "NpcYell:12931:0:13"
msgid "F-F-For the...Empire..."
msgstr "З-За... империю..."

#. ja: フーッ、フーッ…<br>ヌルヌルしたい…
#. de: So viel schöner saurer Glibberschleim! Ich will mich drin wälzen!
#. fr: ♪ La la lala lala<nbsp>! Le gluant, c'est trop marrant<nbsp>!
msgctxt "NpcYell:12932:0:13"
msgid "Mwahaha... Oh, how I long for that sticky sensation!"
msgstr "Муа-ха-ха... Ах, как же мне не хватает этого липкого ощущения!"

#. ja: 嗚呼…ヌルヌルが<br>足りないよぉ…
#. de: Wie soll ich an den Schleim kommen, solange die Mousses da rumkriechen? Schluchz ...
#. fr: Snif... Tout ce que je voulais, c'était me faire un bain maxi acidité...
msgctxt "NpcYell:12933:0:13"
msgid "Oh, I must needs get more of that marvelous goo..."
msgstr "Ах, мне бы ещё этой чудесной слизи..."

#. ja: エーテルをよこせッ！
#. de: Ah, köstlicher Äther!
#. fr: Votre doux éther sera mien<nbsp>!
msgctxt "NpcYell:12934:0:13"
msgid "Relinquish your aether!"
msgstr "Отдай мне свой эфир!"

#. ja: 改変した地形を<br>利用させてもらうッ！
#. de: Zeit für ein neues Bühnenbild!
#. fr: Observez un peu le génie de cette architecture<nbsp>!
msgctxt "NpcYell:12935:0:13"
msgid "Behold the genius of my design!"
msgstr "Полюбуйтесь на гениальность моего замысла!"

#. ja: 我が腐呪を、浴びよ
#. de: Mögen Fluches Worte euer Fleisch verzehren!
#. fr: Soyez maudites, viles créatures<nbsp>!
msgctxt "NpcYell:12936:0:13"
msgid "Slough off your accursed flesh!"
msgstr "Сбросьте проклятую плоть!"

#. ja: 己がエーテルに食い殺されよ！
#. de: Jeden Tropfen Leben will ich aus euch herauspressen<nbsp>...
#. fr: Que votre éther vous consume<nbsp>!
msgctxt "NpcYell:12937:0:13"
msgid "My aether consume you!"
msgstr "Пусть ваш эфир пожрёт вас самих!"

#. ja: 逃さぬ…！
#. de: Nur nicht blinzeln!
#. fr: Inutile de fuir<nbsp>!
msgctxt "NpcYell:12938:0:13"
msgid "There will be no quarter!"
msgstr "Никому не будет пощады!"

#. ja: ゆらめけ、クラミュス！
#. de: Walle, meine Chlamys!
#. fr: Ma belle chlamyde aura raison de vous<nbsp>!
msgctxt "NpcYell:12939:0:13"
msgid "Blind them with your brilliance!"
msgstr "Ослепи их своим сиянием!"

#. ja: 腐呪にはこういう<br>使い方もある…！
#. de: Je tiefer der Hass, desto potenter der Fluch!
#. fr: Il y a bien des façons de maudire...
msgctxt "NpcYell:12940:0:13"
msgid "You will play your part..."
msgstr "Вы сыграете свою роль..."

#. ja: のたうち回れッ！
#. de: Rieche ich Furcht?
#. fr: Comme j'aime vous voir souffrir<nbsp>!
msgctxt "NpcYell:12941:0:13"
msgid "Flee in terror!"
msgstr "Бегите в ужасе!"

#. ja: そらそらそらッ！
#. de: Weiter! Nur weiter!
#. fr: Ha ha ha haaa<nbsp>!!
msgctxt "NpcYell:12942:0:13"
msgid "Submit!"
msgstr "Сдавайтесь!"

#. ja: 吹き飛べッ！
#. de: Windet euch nur!
#. fr: Hors de ma vue<nbsp>!
msgctxt "NpcYell:12943:0:13"
msgid "Begone!"
msgstr "Прочь!"

#. ja: 食らうがよいッ！
#. de: Mich hungert ...
#. fr: Encaissez donc ça<nbsp>!
msgctxt "NpcYell:12944:0:13"
msgid "Your end is nigh..."
msgstr "Твой конец близок..."

#. ja: 迸れ、魔力よ！
#. de: Alles beugt sich meinem Willen!
#. fr: Ma puissance est sans limites<nbsp>!
msgctxt "NpcYell:12945:0:13"
msgid "A keyward is to be obeyed!"
msgstr "Повинуйтесь приказу ключевого слова!"

#. ja: 我が最大の一撃だ…！
#. de: Meine Macht kennt keine Grenzen!
#. fr: La mort frappe une dernière fois à votre porte<nbsp>!
msgctxt "NpcYell:12946:0:13"
msgid "I have been granted power untold!"
msgstr "Мне дарована неведомая сила!"

#. ja: ありがとう…
#. de: Danke ...
#. fr: Merci...
msgctxt "NpcYell:12947:0:13"
msgid "Oh, thank you..."
msgstr "Ах, спасибо..."

#. ja: 助かった…！
#. de: Ich bin frei!
#. fr: Je suis libre<nbsp>!
msgctxt "NpcYell:12948:0:13"
msgid "Free at last!"
msgstr "Наконец-то я свободен!"

#. ja: 帰れるの…？
#. de: Kann ich jetzt wirklich nach Hause gehen?
#. fr: Je peux vraiment rentrer chez moi<nbsp>?
msgctxt "NpcYell:12949:0:13"
msgid "Can I finally go home?"
msgstr "Неужели я наконец могу вернуться домой?"

#. ja: ああ…！
#. de: Ah ...!
#. fr: Ah...<nbsp>!
msgctxt "NpcYell:12950:0:13"
msgid "Ah...!"
msgstr "Ах...!"

#. ja: 確かこっちに逃げて…<br>いたな…！
#. de: Da sind sie ja!
#. fr: Je crois qu'elles ont filé par ici... Les voilà<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12951:0:13"
msgid "They must be around here some─<br>There!"
msgstr "Наверное, они где-то здесь...<br>Вот они!"

#. ja: しかし、この数を<br>駆除するとなると…
#. de: Es wird nicht leicht, sie alle zu beseitigen!
#. fr: Fichtre, j'avais sous-estimé leur nombre...
msgctxt "NpcYell:12952:0:13"
msgid "Oh my, there are quite a lot of them..."
msgstr "Ух ты, да их тут целая куча..."

#. ja: 誰か！<br>駆除を手伝ってくれないか？
#. de: Wer hilft mir dabei?
#. fr: Si quelqu'un m'entend, un peu d'aide ne serait pas de refus<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12953:0:13"
msgid "...Er, a little help?<br>These seedlings must be exterminated!"
msgstr "Э-э, мне бы помощь...<br>Нужно истребить эти ростки!"

#. ja: よし、こっちは片付いたな<br>協力に感謝する！
#. de: Die sind erledigt. Vielen Dank für die Hilfe!
#. fr: Je vois que vous avez fait le grand ménage. Merci du coup de main<nbsp>!
msgctxt "NpcYell:12954:0:13"
msgid "That takes care of that particular mess!"
msgstr "С этой бедой покончено!"

#. ja: よかったら<br>もう少し付き合ってくれ！
#. de: Das war bestimmt nicht der letzte Notfall. Halte dich bereit!
#. fr: Mais mon instinct me dit que les ennuis ne sont pas terminés...
msgctxt "NpcYell:12955:0:13"
msgid "I don't suppose you're free to clean up another...?"
msgstr "Не поможете разобраться ещё с одной проблемой?.."

#. ja: 一度、戻って<br>管理局と相談するか…
#. de: Ich werde erst einmal Bericht erstatten ...
#. fr: Je vais devoir en parler avec le bureau de la direction...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12956:0:13"
msgid "Bother.<br>I was hoping we could contain the situation..."
msgstr "Вот досада.<br>Я надеялся, что мы сумеем взять ситуацию под контроль..."

#. ja: ガハッ…！
#. de: Aargh!
#. fr: Gahargh<nbsp>!
msgctxt "NpcYell:12957:0:13"
msgid "Argh!"
msgstr "А-а-а!"

#. ja: ハァッ…ハァッ…！
#. de: Haaa<nbsp>... Haaa<nbsp>...
#. fr: Han... Han...<nbsp>!
msgctxt "NpcYell:12958:0:13"
msgid "\\<cough> ...Ugh... \\<wheeze>"
msgstr ""

#. ja: やっぱり<br>荒ぶってるな…
#. de: Ha, da ist sie ja!
#. fr: Qu'est-ce que je disais<nbsp>? J'avais parié qu'elle se fâcherait<nbsp>!
msgctxt "NpcYell:12959:0:13"
msgid "This is unacceptable..."
msgstr "Это никуда не годится..."

#. ja: 大人しく繁殖区に<br>戻ってくれるとは思えん
#. de: Freiwillig kehrt sie bestimmt nicht in die Grotte der Troglophilen zurück.
#. fr: Je doute qu'elle accepte de retourner bien sagement au labo...
msgctxt "NpcYell:12960:0:13"
msgid "We'll never get her back to the cave without incident."
msgstr "Без происшествий в пещеру мы её не вернём."

#. ja: グリーナー諸君…<br>駆除を頼めるだろうか？
#. de: Können sich die Klauber darum kümmern?
#. fr: Puis-je compter sur les glaneurs pour la neutraliser<nbsp>?
msgctxt "NpcYell:12961:0:13"
msgid "I'm afraid this specimen requires termination. If you please...?"
msgstr "Боюсь, этот экземпляр придётся ликвидировать. Не поможете?"

#. ja: せ、先生！<br>ギリー先生ッ！
#. de: Professor Gilly!
#. fr: Professeur Gilly<nbsp>! C'est terrible<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12962:0:13"
msgid "Professor!<br>Professor Gilly!"
msgstr "Профессор!<br>Профессор Гилли!"

#. ja: セントラルサーキットで<br>問題が発生したとの報告が！
#. de: Am Zentralzirkel gab es einen Zwischenfall!
#. fr: Un autre incident vient de survenir dans le Circuit central<nbsp>!
msgctxt "NpcYell:12963:0:13"
msgid "We've had reports of a situation evolving in the Central Circuit!"
msgstr "Поступили сообщения о происшествии в Центральном круге!"

#. ja: 至急、状況の確認を<br>お願いします！
#. de: Bitte finde heraus, was genau vorgefallen ist!
#. fr: Vous êtes appelée sur les lieux de toute urgence<nbsp>!
msgctxt "NpcYell:12964:0:13"
msgid "Your presence is required immediately!"
msgstr "Срочно явитесь на место!"

#. ja: 駆除を確認した！<br>諸君…協力に感謝する！
#. de: Vielen Dank bei der Beseitigung des Problems!
#. fr: Menace éliminée<nbsp>! Vous avez fait du bon travail<nbsp>!
msgctxt "NpcYell:12965:0:13"
msgid "The specimen is no longer a threat. Excellent work!"
msgstr "Объект больше не представляет угрозы. Отличная работа!"

#. ja: なんだと！？<br>処分担当は何をやっていた！
#. de: Wie bitte?! Wie konnte das geschehen?!
#. fr: Comment<nbsp>!? Mais que fait le responsable du secteur<nbsp>!?
msgctxt "NpcYell:12966:0:13"
msgid "What? What now!? I thought we had things under control!"
msgstr "Что?! Что теперь?! Я думал, мы всё держим под контролем!"

#. ja: サスザント…！<br>急ぐぞ！
#. de: Sathzant, Beeilung!
#. fr: Dépêchons-nous, Sathzant<nbsp>!
msgctxt "NpcYell:12967:0:13"
msgid "Come along, then, Sathzant!"
msgstr "Ну же, Сатзант!"

#. ja: チッ…被害状況を<br>確認しなければ…！
#. de: Wir müssen das Ausmaß der Zerstörung überprüfen!
#. fr: Aïe aïe aïe... Je vais devoir dresser un compte rendu des dommages...
msgctxt "NpcYell:12968:0:13"
msgid "This is not going to look good on my review..."
msgstr "Вот это мне в отчёте аукнется..."

#. ja: 属性増殖炉は<br>まだ無事のようだな…
#. de: Der Elementarbrüter wurde noch nicht beschädigt ...
#. fr: Au moins, le réacteur tient encore debout...
msgctxt "NpcYell:12969:0:13"
msgid "The reactor remains intact, thank the Scholar."
msgstr "Реактор цел, слава Учёному."

#. ja: 属性エーテルに<br>誘引されたということか…
#. de: Sie wurden wohl von der Ätherenergie angelockt ...
#. fr: Est-ce l'éther élémentaire qui les attire...<nbsp>?
msgctxt "NpcYell:12970:0:13"
msgid "They seem drawn by the aetheric energy..."
msgstr "Похоже, их привлекает энергия эфира..."

#. ja: グリーナー諸君…！<br>対象の駆除に協力してくれ！
#. de: Klauber, wir brauchen eure Hilfe!
#. fr: Appel à tous les glaneurs<nbsp>! Exterminez les cibles au plus vite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12971:0:13"
msgid "This experiment is over!<br>Shatter those crystal beasts!"
msgstr "Эксперимент окончен!<br>Расколите этих кристальных чудовищ!"

#. ja: これだけ減らせば<br>属性増殖炉も安全だな…
#. de: Jawoll, dem Elementarbrüter können sie nicht mehr gefährlich werden!
#. fr: Ils ne devraient plus être assez nombreux pour poser de danger.
msgctxt "NpcYell:12972:0:13"
msgid "That should do it."
msgstr "Этого должно хватить."

#. ja: 私は一度、属性増殖炉を<br>確認してくる…！
#. de: Ich werde bei dem Elementarbrüter nach dem Rechten sehen.
#. fr: Mais mieux vaut vérifier tous les réacteurs...
msgctxt "NpcYell:12973:0:13"
msgid "But I should like to check on the other reactors."
msgstr "Но я всё же проверю остальные реакторы."

#. ja: 協力を頼める者は<br>一緒に来てくれ！
#. de: Wer mir helfen möchte, kann mich gerne begleiten.
#. fr: Que ceux qui n'ont rien de plus urgent à faire me suivent<nbsp>!
msgctxt "NpcYell:12974:0:13"
msgid "Anyone willing to assist, come with me!"
msgstr "Кто готов помочь — за мной!"

#. ja: 最悪の状況だ…<br>管理局に通報しよう…
#. de: Oje, das muss ich sofort berichten.
#. fr: Quelle catastrophe<nbsp>! Et ça va encore être à moi de rédiger un rapport...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:12975:0:13"
msgid "What a disaster...<br>I'll have to file a report."
msgstr "Какая катастрофа...<br>Придётся составить отчёт."

#. ja: 諦めぬぞ…
#. de: So nicht!
#. fr: Pas question d'abandonner...
msgctxt "NpcYell:12976:0:13"
msgid "I will not yield!"
msgstr "Я не сдамся!"

#. ja: 逆風に負けるな！
#. de: Wir trotzdem jedem Sturm!
#. fr: Aucun vent contraire ne nous fera plier<nbsp>!
msgctxt "NpcYell:12977:0:13"
msgid "We will weather any storm!"
msgstr "Нас не сломит ни встречный ветер!"

#. ja: 今が好機だ！
#. de: Jetzt oder nie!
#. fr: Maintenant<nbsp>!
msgctxt "NpcYell:12978:0:13"
msgid "The winds favor us!"
msgstr "Ветер на нашей стороне!"

#. ja: 撃ち抜く！
#. de: Und Feuer!
#. fr: Feu à volonté<nbsp>!
msgctxt "NpcYell:12979:0:13"
msgid "You're in my sights!"
msgstr "Ты у меня на мушке!"

#. ja: リムレーンの一矢のごとく！
#. de: Llymlaen möge uns beistehen!
#. fr: Telle une flèche de Llymlaen<nbsp>!
msgctxt "NpcYell:12980:0:13"
msgid "Like an arrow from Llymlaen!"
msgstr "Как стрела Ллимлейн!"

#. ja: とてとて<br>痛いゴブ…
#. de: Brüllvolx hat Aua am Ganzekörper<nbsp>...
#. fr: Psh<nbsp>! Ouille, Brayflox a bobo<nbsp>!
msgctxt "NpcYell:12981:0:13"
msgid "Pshhh! Brayflox feels ouchy..."
msgstr "Пшш! Брайфлокс больно..."

#. ja: ありがとう！<br>この恩は忘れないぞ！
#. de: Danke! Das vergessen wir nicht.
#. fr: Merci<nbsp>! Je te dois une fière chandelle<nbsp>!
msgctxt "NpcYell:12982:0:13"
msgid "You have my eternal gratitude!"
msgstr "Я в вечном долгу перед вами!"

#. ja: さあ、仲間のところに<br>急いで帰ろう！
#. de: Jetzt schnell zurück zu den Anderen!
#. fr: Il faut que je rentre vite pour rassurer les miens<nbsp>!
msgctxt "NpcYell:12983:0:13"
msgid "My friends will be thrilled and relieved in equal measure!"
msgstr "Друзья будут и рады, и счастливы меня видеть!"

#. ja: 青燐機関の部品があったら<br>俺に渡してくれ！
#. de: Wer ein Erdseim-Maschinenbauteil findet, bringt es zu mir!
#. fr: Si tu trouves des pièces de moteur à céruleum, je suis preneur<nbsp>!
msgctxt "NpcYell:12984:0:13"
msgid "I'll accept anything you can find!"
msgstr "Принесу всё, что найдёте!"

#. ja: よぉ～し、さっそく帰って<br>ヌルヌルするぞぉ～！
#. de: Jippiiie! Jetzt kann ich mich von oben bis unten einglibbern! Das soll gut für die Haut sein, sagt man.
#. fr: Youpiii<nbsp>! Les maxi frissons m'attendent<nbsp>!
msgctxt "NpcYell:12985:0:13"
msgid "Hooray! Now, to return home and bathe in gooey bliss!"
msgstr "Ура! Скорей бы домой — нежиться в слизи!"

#. ja: フーッ、フーッ！<br>ムースの粘液をボクに！
#. de: Hihi! Mein eigener flutschiger Mousse-Glibber!
#. fr: ♪ La la lala lala<nbsp>! Le mucus de mousse, moi, j'aime ça<nbsp>!
msgctxt "NpcYell:12986:0:13"
msgid "Mwahaha! That sticky slime must be mine!"
msgstr "Муа-ха-ха! Эта липкая слизь должна быть моей!"

#. ja: ハァーイ！<br>エキサイトタ～イム！
#. de: JUBEL<nbsp>... TRUBEL<nbsp>... DESTRUKTION!
#. fr: Coucouuu<nbsp>! C'est l'heure d-d-de jouer<nbsp>!
msgctxt "NpcYell:12987:0:13"
msgid "Come one, come all! Step right up and punch me in the face!"
msgstr "Все сюда! Подходи, кто смелый, и врежь мне по лицу!"

#. ja: アタシヲ壊スト<br>美味シイデスヨ！
#. de: JETZT ZERSTÖREN<nbsp>... UND ABRÄUMEN!
#. fr: Détruis-moi, si tu le peux<nbsp>!
msgctxt "NpcYell:12988:0:13"
msgid "Perpetrate violence to win fabulous prizes!"
msgstr "Применяйте насилие и получайте чудесные призы!"

#. ja: ハヤク壊シテ～！<br>ドキドキシチャウ～！
#. de: WER WILL NOCH MAL, WER HAT NOCH NICHT ZERSTÖRT?
#. fr: Allez, vite<nbsp>! Mets-moi en pièces<nbsp>!
msgctxt "NpcYell:12989:0:13"
msgid "My suffering for your satisfaction!"
msgstr "Мучьте меня сколько душе угодно!"

#. ja: ホラホラ、遠慮ナク！<br>コ、ワ、シ、テ～！
#. de: SUPPORT AN <if $gn4>ABENTEURERIN<else>ABENTEURER</if>. HIER SPIELT DIE MUSIK.
#. fr: Ne sois pas timide<nbsp>! Ex-plose-moi<nbsp>!
msgctxt "NpcYell:12990:0:13"
msgid "Do not be shy! You cannot kill that which has no life!"
msgstr "Не стесняйтесь! Меня не убить — я и так неживой!"

#. ja: エ…無視デスカ…<br>興ザメデス…
#. de: CHANCE<nbsp>... VERSPIELT!
#. fr: Hein<nbsp>? Tu m'ignores...
msgctxt "NpcYell:12991:0:13"
msgid "No...? How disappointing."
msgstr "Нет?.. Какое разочарование."

#. ja: ホワァ～！<br>素敵、壊シテ～！
#. de: GARANTIERT GEWINNEN BEI<nbsp>... ZERSTÖRUNG.
#. fr: Ouah<nbsp>! Magnifique<nbsp>! Démolis-moi encore plus<nbsp>!
msgctxt "NpcYell:12992:0:13"
msgid "Challengers? How wonderful!"
msgstr "Смельчаки? Вот это здорово!"

#. ja: イイ攻撃デス～！<br>壊シテ～！
#. de: FAST<nbsp>... GESCHAFFT. NOCH EINMAL.
#. fr: Belle attaque<nbsp>! Allez, pulvérise-moi<nbsp>!
msgctxt "NpcYell:12993:0:13"
msgid "Yes, yes! More blood and oil!"
msgstr "Да, да! Побольше крови и масла!"

#. ja: モット攻撃ヲ～！<br>モット、モット～！
#. de: DAS GLÜCK IST ZUM GREIFEN NAH.
#. fr: Atomise-moi encore<nbsp>! Plus fort<nbsp>! Plus vite<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:12994:0:13"
msgid "Harder! <i>Harder</i>! You want your prize, don't you?"
msgstr "Сильнее! <i>Сильнее</i>! Приз ведь хочешь получить?"

#. ja: 存在意義ヲ果タセマシタ！<br>アリガト～ウ！
#. de: EXISTENZZWECK ERFÜLLT. DANKE FÜR DIE KOOPERATION.
#. fr: J'ai atteint mon objecif, ma raison d'être. Merci<nbsp>!
msgctxt "NpcYell:12995:0:13"
msgid "Winner, winner, carrot dinner!"
msgstr "Победитель, победитель — морковный ужин!"

#. ja: 残念デシタ～！<br>サヨウナ～ラ！
#. de: SCHADE. DAS WAR<nbsp>... EINE NIETE.
#. fr: Comme c'est dommage<nbsp>! À bientôt<nbsp>!
msgctxt "NpcYell:12996:0:13"
msgid "Better luck next time!"
msgstr "Не повезло! В следующий раз получится!"

#. ja: ウィ～ン…！<br>出撃シマ～ス！
#. de: Graaah! Golem will kämpfen!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:12997:0:13"
msgid "Test your strength for a chance at wondrous prizes!"
msgstr "Испытай свою силу и выиграй чудесные призы!"

#. ja: ドウモ、ドウモ…！<br>楽シク戦イマショウ！
#. de: Golem besiegt, Gegner wird belohnt.
#. fr: Salutations<nbsp>! Battons-nous avec le sourire<nbsp>!
msgctxt "NpcYell:12998:0:13"
msgid "Sate your thirst for blood and reap rich rewards!"
msgstr "Приветствую! Сразимся с улыбкой!"

#. ja: ワタシモ、全力デ…<br>殺ス気デヤリマスカラ！
#. de: Wartet auf starken Gegner, aber niemand kommt.
#. fr: À mon tour de t'attaquer avec tout ce que j'ai<nbsp>!
msgctxt "NpcYell:12999:0:13"
msgid "I will hold nothing back, so give it your all!"
msgstr "Я буду сражаться изо всех сил — и ты не сдерживайся!"
