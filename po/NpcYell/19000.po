msgstr ""

#. ja: 集まってくれ！
#. de: Zusammen, schnell!
#. fr: Rassemblons-nous<nbsp>!
msgctxt "NpcYell:19633:0:13"
msgid "Everyone, to me!"
msgstr ""

#. ja: 耐えろよ！
#. de: Zähne zusammenbeißen!
#. fr: Résistez<nbsp>!
msgctxt "NpcYell:19634:0:13"
msgid "We can weather this!"
msgstr ""

#. ja: 厄介な技だが…！
#. de: Dieser Angriff hat es in sich<nbsp>...
#. fr: Une technique bien embêtante<nbsp>!
msgctxt "NpcYell:19635:0:13"
