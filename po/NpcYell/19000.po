msgstr ""

#. ja: 危ない！
#. de: Vorsicht!
#. fr: Attention<nbsp>!
msgctxt "NpcYell:19631:0:13"
msgid "Watch out!"
msgstr ""

#. ja: こっちだ！
#. de: Hier!
#. fr: Par ici<nbsp>!
msgctxt "NpcYell:19632:0:13"
