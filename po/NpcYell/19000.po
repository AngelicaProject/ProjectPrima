msgid "MoTiVaTiOn LeVeLs RiSiNg!"
msgstr ""

#. ja: メンドクサ…<br>クナイデスガンバリマス
#. de: KeInE lUsT<nbsp>... nIcHtS zU tUn, MeInE iCh!
#. fr: La flemme... Euh, j'ai rien dit<nbsp>!
