msgstr ""

#. ja: 見切った…！
#. de: Durchschaut!
#. fr: J'ai tout vu<nbsp>!
msgctxt "NpcYell:19636:0:13"
msgid "Predictable."
msgstr ""

#. ja: 散開を！
#. de: Auseinander!
#. fr: Dispersons-nous<nbsp>!
msgctxt "NpcYell:19637:0:13"
msgid "Spread out!"
msgstr ""

#. ja: 距離をとれ！
#. de: Wegbleiben!
#. fr: Éloignez vous<nbsp>!
msgctxt "NpcYell:19638:0:13"
msgid "Keep your distance!"
msgstr ""

#. ja: 水で結界を！？
#. de: Eine Barriere aus Wasser!
#. fr: Une barrière d'eau<nbsp>!?
msgctxt "NpcYell:19639:0:13"
msgid "It's forming a barrier with water!"
msgstr ""

#. ja: 味な真似を…
#. de: Nicht schlecht<nbsp>...
#. fr: Il se croit malin...
msgctxt "NpcYell:19640:0:13"
msgid "A clever trick..."
msgstr ""

#. ja: いい腕だ
#. de: Sehr geschickt!
#. fr: Pas mal.
msgctxt "NpcYell:19641:0:13"
msgid "Impressive!"
msgstr ""

#. ja: 任せたよ！
#. de: Ich verlasse mich auf euch!
#. fr: Nous comptons sur toi<nbsp>!
msgctxt "NpcYell:19642:0:13"
msgid "It's in your hands!"
msgstr ""

#. ja: 聖槍よ、天高く翔べ！
#. de: O heiliger Speer, teile selbst die Himmel!
#. fr: Ô lance sacrée, perce les cieux<nbsp>!
msgctxt "NpcYell:19643:0:13"
msgid "Speeding spear, pierce the high heavens!"
msgstr ""

#. ja: 我が予言に誤断なし…！
#. de: Meine Prophezeiungen sind unfehlbar<nbsp>...
#. fr: Mes prédictions sont infaillibles<nbsp>!
msgctxt "NpcYell:19644:0:13"
msgid "My foresight is infallible!"
msgstr ""

#. ja: 契約の獣よ、来たれ
#. de: Zu mir, Vertraute des Wissens!
#. fr: Remplis ta part de notre pacte, créature<nbsp>!
msgctxt "NpcYell:19645:0:13"
msgid "Come forth and do my bidding..."
msgstr ""

#. ja: 全知の魔力<br>その身で知るがいい…
#. de: Spürt die Macht des Allwissens!
#. fr: Goûtez au pouvoir de l'omniscience...
msgctxt "NpcYell:19646:0:13"
msgid "Taste wisdom's true power."
msgstr ""

#. ja: 休む間など与えぬ！
#. de: Das Wissen kennt keine Rast!
#. fr: Vous n'aurez pas de répit<nbsp>!
msgctxt "NpcYell:19647:0:13"
msgid "You shall know no respite!"
msgstr ""

#. ja: 石化の魔力よ<br>我が剣に宿れ…
#. de: O petrifizierender Äther, werde eins mit meiner Klinge<nbsp>...
#. fr: Le pouvoir de pétrification habite ma lame...
msgctxt "NpcYell:19648:0:13"
msgid "Petrifying aether, infuse my blade..."
msgstr ""

#. ja: 全知なれば<br>武技とてこのとおり…！
#. de: Nur Allwissen offenbart wahre Kampfkunst!
#. fr: De l'omniscience naît la toute-puissance<nbsp>!
msgctxt "NpcYell:19649:0:13"
msgid "Through omniscience, strength unparalleled!"
msgstr ""

#. ja: ピピピッ！
#. de: \<zwitscher> \<pieps> 
#. fr: Pipipipi<nbsp>!
msgctxt "NpcYell:19650:0:13"
msgid "Tweeeh!"
msgstr ""

#. ja: ピッ！
#. de: \<zwitscher>
#. fr: Piii pi<nbsp>!
msgctxt "NpcYell:19651:0:13"
msgid "Graaawk!"
msgstr ""

#. ja: キャルルル！
#. de: Gruu, gruu!
#. fr: Kuuu kuuu<nbsp>!
msgctxt "NpcYell:19652:0:13"
msgid "Coo, coo!"
msgstr ""

#. ja: カルルル！
#. de: \<triller> \<gurr>
#. fr: Kuuu ku ku ku<nbsp>!
msgctxt "NpcYell:19653:0:13"
msgid "Squawk!"
msgstr ""

#. ja: ウィッ！<br>ウィッ！
#. de: \<quietsch> \<quietsch>
#. fr: Keeeee<nbsp>!
msgctxt "NpcYell:19654:0:13"
msgid "Squaaawk!"
msgstr ""

#. ja: ウィッ！
#. de: \<quietsch>
#. fr: Piiiippippi<nbsp>!
msgctxt "NpcYell:19655:0:13"
msgid "Cheeep!"
msgstr ""

#. ja: ギャルルル！
#. de: Pruu, pruu!
#. fr: Kaaaa<nbsp>!
msgctxt "NpcYell:19656:0:13"
msgid "Twoooh!"
msgstr ""

#. ja: ゲゲッ！
#. de: Kiwitt!
#. fr: Kraaa kraaa<nbsp>!
msgctxt "NpcYell:19657:0:13"
msgid "Krrrawk!"
msgstr ""

#. ja: おうッ、来てくれたな！<br>この星でも安全に活動できるよう、基地を立派にしていくぞッ！
#. de: Da biste ja endlich! Auch hier auf Auxesia werden wir 'ne richtig hoppeltastische Station in den Wald setzen!
#. fr: Content de vous voir<nbsp>! Améliorons notre station afin de pouvoir explorer les moindres recoins de cette nouvelle planète<nbsp>!
msgctxt "NpcYell:19658:0:13"
msgid "There's nothing better than the sight of so many eager workers! With your help, we'll build a base on this star every bit as cosmotastic as the others!"
msgstr ""

#. ja: 「居住モジュール」の建設を行って、<br>計画参加者たちの受け入れ態勢を強化するぞッ！
#. de: Fangen wir wie immer mit den Habitationsmodulen an. Wo es sich friedlich schlafen und vor allem duschen lässt, arbeitet man auch gern!
#. fr: Comme d'habitude, construire des modules d'habitation renforcera notre capacité d'accueil<nbsp>!
msgctxt "NpcYell:19659:0:13"
msgid "Habitation modules will ensure that every new recruit can live upon this star in comfort!"
msgstr ""

#. ja: カーゴから資材を取り出し、一時作業場で加工してくれッ！<br>最高の仕上がりを目指してくれよな！
#. de: Besorgt die benötigten Teile und baut sie an der entsprechenden Stelle zusammen. Ich erwarte höchste Qualität, verstanden?
#. fr: Prenez des matériaux dans les caisses et façonnez-les<nbsp>! On compte sur vous pour vous appliquer<nbsp>!
msgctxt "NpcYell:19660:0:13"
msgid "Take what components you need and assemble them on-site. It goes without saying that we expect your best work!"
msgstr ""

#. ja: よぉし、ヒトのみんなの満足顔が目に浮かぶなッ！<br>「居住モジュール」ができあがったら、見に行ってみな！
#. de: Unter uns: Sobald die Module stehen, würde ich mich zu gerne mal nachts in eins reinschleichen<nbsp>... Natürlich nur, um die zufriedenen Gesichter meiner ratzenden Kollegen zu sehen!
#. fr: Excellent travail, amis humains<nbsp>! Les modules d'habitation seront bientôt prêts à vous accueillir<nbsp>!
msgctxt "NpcYell:19661:0:13"
msgid "I can see them now: the smiling faces of workers assured they have a place to rest their weary bones. I promise the habitation modules will impress! "
msgstr ""

#. ja: 上質な寝床があってこそ、リフレッシュできるってもんなんだろ！<br>さぁ、作業を終えた者からゆーっくり休んでくれッ！
#. de: Mir reicht ja 'ne Hängematte und 'n Eimer saftige Rüben, um mich wohlzufühlen. Aber ich seh's in euren müden Augen: Ihr freut euch auf 'n richtiges Bettchen, was? Harharhar!
#. fr: Vous apprécierez notamment le confort ex<shy>cep<shy>tion<shy>nel du couchage. De quoi vous remettre d'aplomb après une dure journée de labeur<nbsp>!
msgctxt "NpcYell:19662:0:13"
msgid "Proper beds enable proper rest, and that makes for a happy worker! If your tasks for the day are done, feel free to take a break!"
msgstr ""

#. ja: エネルギー設備・給水設備を<br>2回連続した共同施工作業で造りあげるぞッ！
#. de: Unserer Infrastruktur fehlt's noch an Energisierung und Hydrofizierung. Kümmern wir uns drum!
#. fr: Nous allons construire coup sur coup deux structures d'approvisionnement, l'une pour l'électricité et l'autre pour l'eau. Je vous préviens, ça va être costaud<nbsp>!
msgctxt "NpcYell:19663:0:13"
msgid "This joint project shall give us shiny new energization and hydrofication stations!"
msgstr ""

#. ja: まずは必要な雷力を得るため、エネルギー設備を造るぞッ！<br>環境エーテルを変換して、雷気を貯められるようにすんだ！
#. de: Wir beginnen mit der Umwandlung des Umgebungsäthers in knisternd-knasternden Strom bester Güteklasse!
#. fr: D'abord, la station énergétique<nbsp>! Elle va nous permettre de transformer l'éther environnant en électricité pour alimenter nos machines.
msgctxt "NpcYell:19664:0:13"
msgid "We can't achieve our lofty goals without energy, and that's where energization stations come in! They'll convert the star's aether into a limitless supply of power. "
msgstr ""

#. ja: カーゴから資材を取り出し、一時作業場で加工してくれッ！<br>正確な作業を期待しているぞッ！
#. de: Besorgt die benötigten Teile und baut sie an der entsprechenden Stelle zusammen. Ich erwarte höchste Qualität, verstanden?
#. fr: Piochez des matériaux dans les caisses de provisions, puis façonnez-les aux établis éphémères. Soyez rapides et efficaces<nbsp>!
msgctxt "NpcYell:19665:0:13"
msgid "Take what components you need and assemble them on-site. It goes without saying that we expect your best work!"
msgstr ""

#. ja: よし、2連続1回目の共同施工作業は、<br>順調に終わりそうだな！
#. de: Nebenan geht's mit den Hydrofizierungswerken direkt weiter. 'ne kurze Lümmelpause gönn ich euch, dann wird aber wieder geklotzt, klaro?
#. fr: Bonne nouvelle, chers collaborateurs<nbsp>: nous sommes bien partis pour achever notre station énergétique<nbsp>!
msgctxt "NpcYell:19666:0:13"
msgid "The first of our two joint projects is set to finish without issue! Excellent work!"
msgstr ""

#. ja: 次はすぐ隣へ、給水設備を建てる計画をしてるぞ！<br>すぐに開始するから、続けて参加をよろしく頼むッ！
#. de: Geht gleich direkt weiter. Habt mal was Geduld, ja!
#. fr: Prochain objectif<nbsp>: construire une station hydropurificatrice sur l'emplacement voisin<nbsp>! Le chantier va s'ouvrir sous peu, alors ne vous relâchez pas<nbsp>!
msgctxt "NpcYell:19667:0:13"
msgid "Next on the docket is a hydrofication station! We'll be starting right away, so keep your tools handy!"
msgstr ""

#. ja: 連続共同施工作業の、2回目を始めるぞッ！
#. de: Weiter geht's mit den Hydrofizierungswerken!
#. fr: Place à présent à notre second ouvrage collectif<nbsp>: la con<shy>struc<shy>tion d'une station hydropurificatrice<nbsp>!
msgctxt "NpcYell:19668:0:13"
msgid "The second of our joint projects is now underway!"
msgstr ""

#. ja: ヒトが必要とする「水」のために、給水設備の建設を行うッ！<br>付近の水脈から汲み上げて、安全な水に浄水すんだ！
#. de: <switch $gn71><case>Rundohren<case>Spitzohren<case>Spitzohren<case>Flauschohren<case>Rundohren<case>Spitzhörner<case>Flauschohren<case>Langohren</switch> wie du und andere Nicht-Löffelohren brauchen ja immer so viel von dem kalten Nass zum Überleben. Besorgen wir uns was aus der nächsten Ader und reinigen es!
#. fr: Grâce à elle, nous pourrons puiser dans les nappes phréatiques et fournir de l'eau potable à tous nos collaborateurs humains, histoire d'assurer leur survie<nbsp>!
msgctxt "NpcYell:19669:0:13"
msgid "No project can succeed without a steady supply of water for our thirsty workers! Building a hydrofication station will ensure that no throat goes parched for long!"
msgstr ""

#. ja: カーゴから資材を取り出し、一時作業場で加工してくれッ！<br>エーテル伝導性の高い繊細な部品も多いから、慎重になッ！
#. de: Besorgt die benötigten Teile und baut sie an der entsprechenden Stelle zusammen. Passt aber bloß auf die empfindlichen Ätherleitteile auf. Die sind nämlich äh<nbsp>... empfindlich!
#. fr: Comme précédemment, servez-vous dans les caisses de provisions puis façonnez des pièces aux établis. Certains matériaux éthéroconducteurs sont fragiles, alors faites attention<nbsp>!
msgctxt "NpcYell:19670:0:13"
msgid "Take the components you need and assemble them on-site!  They're delicate and have high aetheric conductivity, so handle the parts with the utmost care!"
msgstr ""

#. ja: よぉし、予定どおり施工作業が完了しそうだッ！<br>これで安全な水が、たっぷり確保できるようになるだろう！
#. de: Hervorragend, so wünsche ich mir, dass alle Projekte vonstattengehen! Wir werden mehr als genug sauberes Trinkwasser produzieren können!
#. fr: Beau boulot, les amis<nbsp>! Ce second ouvrage collectif devrait lui aussi s'achever sans encombre. À vous la bonne eau potable<nbsp>!
msgctxt "NpcYell:19671:0:13"
msgid "The project is heading towards completion on schedule! We'll soon be swimming in potable water!"
msgstr ""

#. ja: この基地も設備が揃ってきたぜ！<br>作業を終えた者から、たっぷり休んでくれッ！
#. de: So langsam nimmt die gute Station Form an. Hoppeltastisch! Wer fertig ist, gönnt sich 'ne Pause, verstanden?
#. fr: Avec ça, notre station spatiale sera dotée de toutes les ins<shy>tal<shy>la<shy>tions vitales. Le moment est bien choisi pour souffler un bon coup<nbsp>!
msgctxt "NpcYell:19672:0:13"
msgid "It's almost looking like an entirely new base! Everyone deserves a luxurious rest once your work is done!"
msgstr ""

#. ja: 調査によると、翠枝の円森に建つタワー、<br>通称「子葉の塔」は都市機能にとって重要な施設らしい。
#. de: Dieser Turm im Netzwurzel-Perimeter soll ja mächtig wichtig sein. Und angeblich lebt der Gute sogar!
#. fr: D'après nos équipes d'exploration, cette tour qu'on appelle la “Pousse épanouie” est un bâtiment essentiel au bon fonc<shy>tion<shy>ne<shy>ment des infrastructures de la ville.
msgctxt "NpcYell:19673:0:13"
msgid "Our investigation has discovered that the tall structure in the Netroot Radius, called the Sprouting Towerling, was essential to the city's systems."
msgstr ""

#. ja: だが、塔から生えてる根っこが弱ったことで、<br>地脈との接続が断たれちまっているみてえだ。
#. de: Nur ist er gerade derart am Schwächeln, dass er seine Wurzelverbindung zu den Ätheradern des Planeten verloren hat.
#. fr: Néanmoins, les racines censées la relier au réseau éthéré sont toutes rabougries...
msgctxt "NpcYell:19674:0:13"
msgid "However, it seems the withered roots of the plant prevent energy from reaching the surrounding area."
msgstr ""

#. ja: さあ、錬金剤を散布して、根っこに活力を与えてくれ！<br>そうすりゃ、塔と地脈も再接続されるだろうよ！
#. de: Da hilft nur Wachstumsmittel! Behandeln wir den Armen mit dem Zeugs und päppeln ihn auf!
#. fr: Il va donc falloir les revitaliser avec une bonne dose de formule de croissance<nbsp>! Ça devrait suffire à réactiver l'ensemble des systèmes de la tour<nbsp>!
msgctxt "NpcYell:19675:0:13"
msgid "Good thing we have a formula that perks plant life right up! Spray it all over and get that energy flowing!"
msgstr ""

#. ja: よぉし、錬金剤の散布が十分できたようだな！<br>あとは効果が出るのを待つだけだ！
#. de: Das sollte genug Wachstumsmittel für 'nen ganzen Wald gewesen sein. Mal schaun', wie's dem Turmling gleich geht!
#. fr: Parfait<nbsp>! Nous avons suf<shy>fi<shy>sam<shy>ment arrosé les racines<nbsp>! Il ne nous reste plus qu'à attendre que la formule fasse son effet.
msgctxt "NpcYell:19676:0:13"
msgid "I see every ilm of the roots has been covered! Now we need only wait to see the fruits of our labor!"
msgstr ""

#. ja: 子葉の塔が元気になれば、都市機能の復旧も一歩進むはずだ！<br>どんな様子になるか、楽しみにしていてくれよな！
#. de: Vom genesenen Keimturmling erhoffen wir uns jede Menge hoppeltastische Daten. Haltet die Löffel steif!
#. fr: La réactivation de la Pousse épanouie est une étape importante pour donner une seconde jeunesse à l'ensemble de cette ville<nbsp>! J'ai hâte de la voir reprendre vie<nbsp>!
msgctxt "NpcYell:19677:0:13"
msgid "Bringing the Sprouting Towerling back to life will bring us one step closer to restoring the city to its former glory! What will it look like? I can't wait to find out!"
msgstr ""

#. ja: 復旧した子葉の塔の解析効率を高めるため、<br>ティンバーロッジ基地の整備を行うことになった！
#. de: Wir woll'n die Baumesruh renovieren, um den Keimturmling noch besser analysieren zu können.
#. fr: Afin d'accélérer l'analyse des données de la Pousse épanouie, nous avons décidé de procéder à la remise en état de la station du Havre forestier.
msgctxt "NpcYell:19678:0:13"
msgid "To speed up analysis of the Sprouting Towerling, we're going to outfit the Timberlodge with even more cosmotastic facilities!"
msgstr ""

#. ja: エーテル変換器の設置と、発雷設備の出力向上を図り、<br>回線網を増強すれば、それだけ解析も早く進むってもんだ！
#. de: Neben 'nem Ätherkonverter brauchen wir vor allem stärkere Stromleitungen, um in kürzerer Zeit größere Mengen Energie zu transportieren.
#. fr: Il suffit d'installer un convertisseur d'éther, d'augmenter la puissance des ins<shy>tal<shy>la<shy>tions électriques et de consolider le réseau<nbsp>! L'analyse progressera beaucoup plus rapidement, comme ça<nbsp>!
msgctxt "NpcYell:19679:0:13"
msgid "All we need to do is install an aether converter, bump up the output from the energization stations, and expand the base's network! Then analysis will speed along like a jackrabbit! "
msgstr ""

#. ja: ついでに基地周辺の舗装も広げて、<br>利便性も向上させちまおうって腹積もりよ！
#. de: Selbstverständlich nutzen wir die Gelegenheit und verschönern unsere gute Basis gleich mit. Dann hab'n alle was davon!
#. fr: Tant qu'on y est, profitons-en pour embellir la base et créer de nouveaux chemins<nbsp>! Ce sera bien plus pratique<nbsp>!
msgctxt "NpcYell:19680:0:13"
msgid "While we're at it, we'll build more paths so everyone can get around more easily. An excellent plan, yes?"
msgstr ""

#. ja: よぉし、これで子葉の塔の解析も素早く進むだろう！<br>お前らの協力に、心から感謝するッ！
#. de: Gut geklotzt, Freunde. Die Tastentipper vom Forschungsteam wird's bestimmt freuen, dass ihre Analysen nun noch analytischer von der Pfote gehen.
#. fr: Parfait<nbsp>! L'analyse des données de la Pousse épanouie touche bientôt à son terme<nbsp>! Merci à tous pour votre aide<nbsp>!
msgctxt "NpcYell:19681:0:13"
msgid "And with this, our analysis is just a stone's throw away from completion! Everyone who helped deserves a hearty round of applause!"
msgstr ""

#. ja: 作業を終えた者から休んで、今後の調査に待機してくれよな！
#. de: Wer fertig ist, macht bitte schon mal Pause! Es geht bestimmt bald weiter!
#. fr: Ceux qui ont terminé peuvent se reposer en attendant la prochaine mission<nbsp>!
msgctxt "NpcYell:19682:0:13"
msgid "I encourage anyone whose tasks are finished to take a well-earned rest and await the results of our analysis!"
msgstr ""

#. ja: この先に2基目のタワーが見えているが、<br>植物が異常繁茂しているせいで、経路が確保できない状況だ！
#. de: Der neue Turmling macht es uns nicht so einfach. Ist umzingelt von genügend Unkraut, wir bräuchten wohl ein <i>Heer</i> an Gärtnern, um dem <i>Herr</i> zu werden, hehe!
#. fr: On peut voir la deuxième tour, mais la route est impraticable tant la végétation a tout envahi...
msgctxt "NpcYell:19683:0:13"
msgid "The second tower is within sight, but our way is blocked by a veritable jungle of overgrowth!"
msgstr ""

#. ja: そんなときに役立つのが新設計の重機、<br>名付けて、コスモ・ハーベスタ……！
#. de: Aber wir von der Kosmo-Erkundung haben zum Glück ja Mechas. „Kosmo-Vollernter“, um genau zu sein!
#. fr: Et c'est là qu'entrent en jeu les abatteurs cosmiques, nos nouvelles machines qui peuvent tout déblayer<nbsp>!
msgctxt "NpcYell:19684:0:13"
msgid "That's why we've developed a brand-new machine to cut through the thickest foliage! We've dubbed it the “Cosmic Harvester”!"
msgstr ""

#. ja: カーゴから資材を取り出し、一時作業場で加工してくれッ！<br>コスモ・ハーベスタを組み立てるぞ！
#. de: Die wollen aber erstmal gebaut werden! Besorgt die benötigten Teile und baut sie an den entsprechenden Stellen zusammen. Los, los!
#. fr: Prenez des matériaux dans les caisses et façonnez-les<nbsp>! On compte sur vous pour fabriquer de fantastiques abatteurs cosmiques<nbsp>!
msgctxt "NpcYell:19685:0:13"
msgid "Take the required parts and assemble them into a cosmic, plant-cutting contraption!"
msgstr ""

#. ja: コスモ・ハーベスタの組み立ては、順調に進んでるみてえだな！<br>完成すれば、経路を塞ぐ植物をたちまち除去できるッ！
#. de: Die Kosmo-Vollernter nehmen Form an. Nicht mehr lang und dann schreddern sie uns einen Weg zum Turmling durchs Gebüsch<nbsp>- harharhar!
#. fr: L'assemblage des abatteurs cosmiques progresse à grands pas<nbsp>! Une fois terminés, ils ne feront qu'une bouchée de toute cette végétation qui nous bloque le passage<nbsp>!
msgctxt "NpcYell:19686:0:13"
msgid "The Cosmic Harvester is coming along nicely! If they could, those plants around the tower would surely be cowering in fear!"
msgstr ""

#. ja: 今回の常葉の塔は、どんな機構なのか……！<br>これから調査も順調に進んでくことだろうよ！
#. de: Ihr seid bestimmt auch schon so gespannt wie ich, was der Blütenturmling so für uns bereithalten wird.
#. fr: J'ai hâte de voir à quoi peut bien servir la Pousse fleurie<nbsp>! Vivement que les recherches nous le révèlent<nbsp>!
msgctxt "NpcYell:19687:0:13"
msgid "Just what was the function of the Sunning Towerling? It's our job to find out!"
msgstr ""

#. ja: どうやら、この常葉の塔は、<br>周囲の鉱石をエネルギー源にしてたようだ。
#. de: Die Datenlecker vom Forschungsteam meinten jedenfalls, dass die Mineralien um den Turm als seine Energiequellen fungieren.
#. fr: Apparemment, la Pousse fleurie tirait son énergie des gisements de cristaux qui l'entourent.
msgctxt "NpcYell:19688:0:13"
msgid "It appears the structure draws power from nearby mineral deposits."
msgstr ""

#. ja: だが、今や供給機構は朽ちて動かず、<br>このままじゃ、復旧を進めることすらできないだろう。
#. de: So schwach, wie der Turmling wirkt, isses aber wohl schon 'ne ganze Weile her, seit er 'ne Portion schlemmen durfte.
#. fr: Mais nous n'allons pas pouvoir la restaurer tant que son dispositif d'approvisionnement est hors service...
msgctxt "NpcYell:19689:0:13"
msgid "Yet now the power conduits are completely unresponsive─we can't hope to make any progress like this."
msgstr ""

#. ja: 鉱石を適当な大きさに削り出して、<br>エネルギー受容体まで運んでやってくれ！
#. de: Baut doch bitte was von dem Zeugs ab und tragt es dem Turmling zu seinen Energiekonvertern!
#. fr: Taillez les cristaux à la bonne taille et transportez-les jusqu'aux récepteurs d'énergie<nbsp>!
msgctxt "NpcYell:19690:0:13"
msgid "Drill off chunks of a manageable size and channel their energy into the power conduits!"
msgstr ""

#. ja: よし、鉱石の供給作業は順調そうだなッ！<br>このままいけば、推測どおり常葉の塔は動き出すはずだぜ！
#. de: So langsam scheint der Hunger des Turmlings gestillt zu sein. Jetzt noch etwas Nachtisch und dann is' gut!
#. fr: Très bien, nous commençons à avoir absorbé pas mal de cristaux<nbsp>! Continuons comme ça, et la Pousse fleurie se remettra bientôt en route<nbsp>!
msgctxt "NpcYell:19691:0:13"
msgid "I think we almost have enough indicolite! I can almost feel the power flowing into the Sunning Towerling─yes, soon its former glory shall be restored!"
msgstr ""

#. ja: 作業を終えた者から手を休めて、<br>この機構の復旧を見届けてやろうじゃねえか！
#. de: Wer fertig ist, macht Pause, klaro? Genießen wir die Revitalisierung des Turmlings bei 'ner leckeren Feierabendkarotte!
#. fr: Ceux qui ont terminé peuvent se reposer un peu et observer le spectacle de la Pousse fleurie qui revient à la vie<nbsp>!
msgctxt "NpcYell:19692:0:13"
msgid "Rest your weary paws if your work is done, and watch this ancient structure come alive!"
msgstr ""

#. ja: 「コスモポート」を改良するぞッ！<br>宇宙船でより彼方へと飛び立てるようになあ！
#. de: Als Nächstes ist der gute, alte Kosmoport dran! Mehr Potenzial für die Reisen durchs All!
#. fr: C'est l'heure d'aménager le cosmoport<nbsp>! Bientôt, le reste de l'univers nous ouvrira ses bras<nbsp>!
msgctxt "NpcYell:19693:0:13"
msgid "The cosmoport will soon be even better! Every corner of the firmament will be ours to explore!"
msgstr ""

#. ja: これが済めば、アーテリスとの行き来も、<br>うんと楽になるはずだぜッ！
#. de: Unsere Export- und Importfrequenz nach und von Ætheris wird besser denn je sein! 
#. fr: Une fois ce projet terminé, le trajet entre Auxesia et Ætherys sera une promenade de santé<nbsp>!
msgctxt "NpcYell:19694:0:13"
msgid "Once the upgrades are complete, Etheirys will be only a quick hop away!"
msgstr ""

#. ja: カーゴから資材を取り出し、一時作業場で加工してくれッ！<br>最高の仕上がりを目指してくれよな！
#. de: Besorgt die benötigten Teile und baut sie an der entsprechenden Stelle zusammen. Ich erwarte höchste Qualität, verstanden?
#. fr: Prenez des matériaux dans les caisses et façonnez-les<nbsp>! On compte sur vous pour vous appliquer<nbsp>!
msgctxt "NpcYell:19695:0:13"
msgid "Take what components you need and assemble them on-site. It goes without saying that we expect your best work!"
msgstr ""

#. ja: よぉし、これで予定していた作業は終了……<br>作業を終えた者は手を休めて、完成を見届けてくれッ！
#. de: Okidoki, damit sind wir hier fürs Erste fertig. Kümmert euch bitte gut um die Blasen an euren Pfoten, verstanden?
#. fr: Voilà, je crois que nos travaux sont terminés... pour cette fois. Prenez un peu de bon temps, vous l'avez mérité<nbsp>!
msgctxt "NpcYell:19696:0:13"
msgid "And that brings another planned project to an end. If your work is finished, take a well-earned rest and drink in the fruits of your labor!"
msgstr ""

#. ja: 宇宙船の発着がしやすくなって、<br>物資や人員の行き来も楽になるはずだぜ！
#. de: Mit so 'nem tollen Kosmoport sind das Abheben und Landen bestimmt nicht mehr die Zitterpartien, die sie vorher waren. Die Kapitänin lässt grüßen!
#. fr: Les navettes pourront aller et venir sans difficulté, ce qui améliorera le transport de mar<shy>chan<shy>di<shy>ses et de personnel<nbsp>!
msgctxt "NpcYell:19697:0:13"
msgid "Ships will be able to land with ease, and that means even more supplies and personnel!"
msgstr ""

#. ja: この先の石蒼き林班の内部には、第三の機構、<br>末葉の塔があるらしいが、経路の確保が問題となっている！
#. de: Wieder mal wurde ein Turmling entdeckt. Und wieder mal müssen wir uns selbst einen Weg zu ihm bahnen.
#. fr: Les derniers rapports indiquent qu'une troisième tour, la Pousse vivace, a été découverte dans la Parcelle verdoyante. C'est bien beau, mais sécuriser la voie d'accès idéale est une autre paire de manches !
msgctxt "NpcYell:19698:0:13"
msgid "We've discovered yet another structure within the depths of the Stratostone Stand─the Rooting Towerling. However, we as of yet lack a clear path to it!"
msgstr ""

#. ja: そこで、放棄されていた先駆者文明のドローンに、<br>特殊パーツをつけて復旧してやるんだ。
#. de: Diesmal braucht es eine Brücke. Gut, dass wir diese alten Drohnen der Gegangenen gefunden haben.
#. fr: Pour y parvenir, nous avons décidé de remettre en état les drones abandonnés par les pionniers en remplaçant leurs composants endommagés.
msgctxt "NpcYell:19699:0:13"
msgid "So our plan is to attach specialized parts to the Voyagers' abandoned drones and thus give them purpose anew!"
msgstr ""

#. ja: そうすりゃ、ドローンが植物を適切な形に成長させて、<br>人が通れる経路を作ってくれるはずだッ！
#. de: Die guten Stücke können nämlich das Wachstum der Vegetation manipulieren und uns so einen Übergang schaffen. Wir müssen sie nur zum Laufen bekommen!
#. fr: Ainsi, ils pourront faire pousser les plantes dans la direction idéale pour permettre le passage<nbsp>!
msgctxt "NpcYell:19700:0:13"
msgid "Then we'll send them off to cultivate the vegetation and shape it into walkable paths!"
msgstr ""

#. ja: よしよし、ドローンへの特殊パーツの装着は順調だな。<br>あとは、エネルギー充填を待てば動作するはずだぜッ！
#. de: Die Drohnen sind wieder so gut wie einsatzfähig. Jetzt braucht es nur noch 'nen Fünkchen Strom und dann sirren sie durch die Lüfte!
#. fr: Le rem<shy>pla<shy>ce<shy>ment des composants endommagés sur les drones se déroule sans problème. Il ne reste plus qu'à attendre qu'ils soient chargés à bloc et ils seront enfin opérationnels<nbsp>!
msgctxt "NpcYell:19701:0:13"
msgid "Good, good! The drones are almost ready to go. We only need to power them up!"
msgstr ""

#. ja: 作業を終えた者から、休んでってくれよな。<br>植物を伸ばしてやって道が作れたら、石蒼き林班内部へ進むぞッ！
#. de: Wer fertig ist, macht bitte Pause und genießt das Spektakel, ja? Die Brücke sollte sich schon bald bilden und dann geht's in die Stratofels-Stellung!
#. fr: Ceux qui ont terminé leur part du travail peuvent souffler un peu. Une fois que les plantes auront suf<shy>fi<shy>sam<shy>ment poussé et tracé le chemin, nous nous engouffrerons au cœur de la Parcelle verdoyante<nbsp>!
msgctxt "NpcYell:19702:0:13"
msgid "If you've finished your work, take a well-earned rest. It's only a matter of time until the plants guide us deeper into the Stratostone Stand!"
msgstr ""

#. ja: さぁ、特別チューンしたパワードスーツを用意したから、<br>全員着替えて参加してもらうぞッ！
#. de: Mit den Kosmokinese-Anzügen sollte jeder von euch so viel heben können wie ich auf Karottenentzug. Und das müsst ihr auch, wenn ihr die Steinchen wegpumpen wollt!
#. fr: Pour cette mission, nous avons préparé des com<shy>bi<shy>nai<shy>sons spé<shy>cia<shy>le<shy>ment optimisées pour l'occasion. Il ne vous reste plus qu'à les enfiler<nbsp>!
msgctxt "NpcYell:19703:0:13"
msgid "We've tuned the powersuits especially for this task, so get them on and get to work!"
msgstr ""

#. ja: 末葉の塔の復旧は、常葉の塔と同じようにできるって話だが、<br>さらに多くの鉱石の供給が必要みてえだ。
#. de: Der Wurzelturmling kann wohl genau wie der Blütenturmling revitalisiert werden. Nur braucht's 'nen echten Jahresvorrat von dem Mineral.
#. fr: La restauration de la Pousse vivace semble être parvenue au même point que celle de la Pousse fleurie, mais il nous manque toujours une grande quantité de cristaux pour achever le travail.
msgctxt "NpcYell:19704:0:13"
msgid "We should be able to restore this new structure in the same way we restored the Sunning Towerling, but we'll need a lot more energy this time!"
msgstr ""

#. ja: インディコライト鉱石をできるだけ大きく削り出して、<br>スーツの力で塔のエネルギー受容体まで運んでやってくれ！
#. de: Also: Jetzt wird in die Pfoten gespuckt und gebohrt! Gebt dem Turmling 'ne Portion Indigoriten, dass es ihm gleich wieder hochkommt!
#. fr: Extrayez autant de cristaux d'indicolite que possible et exploitez la résistance de vos com<shy>bi<shy>nai<shy>sons pour les transporter jusqu'aux récepteurs d'énergie<nbsp>!
msgctxt "NpcYell:19705:0:13"
msgid "Carve the indicolite into the largest pieces you can manage and haul them over to the tower's power conduits!"
msgstr ""

#. ja: よし、鉱石エネルギーの供給作業は順調そうだなッ！<br>このままいけば、十分以上のエネルギーを注げているだろう！
#. de: Selbst die Hungrigsten haben irgendwann genug, wie es scheint. Der Wurzelturmling ist pickepackevoll, wenn ihr mich fragt.
#. fr: Parfait, l'approvisionnement en cristaux se déroule sans accroc<nbsp>! Continuons comme ça et on aura de l'énergie à ne plus savoir qu'en faire<nbsp>!
msgctxt "NpcYell:19706:0:13"
msgid "Wonderful! The indicolite is flowing! Keep going and we'll have a comfy surplus of energy to keep the tower going!"
msgstr ""

#. ja: パワードスーツもあったとはいえ、お前ら頑張ってくれたぜ！<br>作業を終えた者から、休んでってくれよな！
#. de: Die Kosmokinese-Anzüge sind schon hoppeltastisch, was? Damit kann sich jeder so fühlen, als hätte man so tolle Muckis wie ich.
#. fr: Combinaisons ou pas, vous avez tous fait de l'excellent boulot<nbsp>! Reposez-vous bien avant la prochaine étape<nbsp>!
msgctxt "NpcYell:19707:0:13"
msgid "Even with the aid of the powersuits, you went above and beyond our expectations! Everyone whose work is done deserves some rest and recuperation!"
msgstr ""

#. ja: 今後の計画に備えて、すんごいローダーを投入予定だ！<br>だからローダーハンガーにすんごいアップグレードをしておくぞ！
#. de: Wir brauchen bessere Mechas. Und darum bauen wir einen besseren Sternenhangar!
#. fr: Nous avons l'intention de déployer des mécanos cosmiques de haute qualité en prévision de nos futurs projets<nbsp>! Nous allons donc moderniser en profondeur les hangars des machines !
msgctxt "NpcYell:19708:0:13"
msgid "Our future projects require even better mechs, so an upgrade of cosmic magnitude is in order!"
msgstr ""

#. ja: 今はメカオペレーション用の整備で手一杯だけどよ……！<br>これが成功すれば、ローダーの可能性を広げられるはずだぜッ！
#. de: Laut unseren Mecha-Ingenieuren reicht es momentan gerade mal zur Inspektion nachm Einsatz. An wirkliche Verbesserungen sei gerade nicht zu denken!
#. fr: Actuellement, nous sommes débordés par la maintenance des opérations mécaniques, mais si ce projet est un succès, il devrait améliorer les capacités des mécanos cosmiques<nbsp>!
msgctxt "NpcYell:19709:0:13"
msgid "Our current maintenance demands are almost overwhelming, but the completion of this project should make everyone's lives easier!"
msgstr ""

#. ja: カーゴから資材を取り出し、一時作業場で加工してくれッ！<br>最高の仕上がりを目指してくれよな！
#. de: Bis jetzt! Besorgt die benötigten Teile und baut sie an der entsprechenden Stelle zusammen. Ich erwarte höchste Qualität, verstanden?
#. fr: Prenez les matériaux dans les caisses et façonnez-les dans un établi éphémère<nbsp>! On compte sur vous pour obtenir une finition irréprochable !
msgctxt "NpcYell:19710:0:13"
msgid "Take what components you need and assemble them on-site. It goes without saying that we expect your best work!"
msgstr ""

#. ja: よぉし……ローダーハンガーへの新しい部品の取り付けは、<br>こんなところで十分だろう！
#. de: Das sieht doch gut aus. Vielleicht legen uns die Mechas ja so einen Robotertanz oder so hin, wenn sie den neuen Hangar sehen, hehe! Wir sind jedenfalls fertig!
#. fr: Et voilà, les nouvelles pièces de support des hangars sont bien fixées comme il faut !
msgctxt "NpcYell:19711:0:13"
msgid "Now that's a mech hangar to be proud of! Excellent work, everyone!"
msgstr ""

#. ja: これで、ますますローダーにすんごい仕事を任せられるはずだッ！<br>作業を終えた者から、休んでってくれよな！
#. de: Wollen wir doch mal sehen, was unsere Mecha-Ingenieure mit der verbesserten Einrichtung so anstellen. Jetzt aber ab in den Feierabend!
#. fr: On peut maintenant confier des tâches encore plus complexes aux mécanos cosmiques<nbsp>! Reposez-vous bien avant la prochaine étape<nbsp>!
msgctxt "NpcYell:19712:0:13"
msgid "Just imagine the projects we can undertake now! If your work is finished, take a break until your next exciting task!"
msgstr ""

#. ja: ローダーハンガーのアップグレードによって、<br>パワーローダーに大容量の錬金剤コンテナが装着できたぞ！
#. de: Im renovierten Sternenhangar wurde 'ne neue Sternenläufer-Version entwickelt, die 'ne ganze Tankladung Wachstumsmittel mit sich schleppen kann!
#. fr: L'amélioration des hangars nous permet désormais d'équiper les mécanos cosmiques avec des conteneurs alchimiques de grande capacité !
msgctxt "NpcYell:19713:0:13"
msgid "Upgrading the mech hangar has enabled the vacuum suits to haul massive containers of alchemical supplies!"
msgstr ""

#. ja: こいつに乗り込んで最上層まで上昇し、<br>長いこと活力不足だった植物たちへ、錬金剤を噴射しまくってくれ！
#. de: Also ab in die Cockpits mit euch. Weit oben im Kernmantelwald gibt's 'ne Menge Vegetation, der's nach dem Zeug dürstet!
#. fr: Montez à bord et rendez-vous au niveau supérieur pour arroser de solution alchimique les plantes qui ont besoin d'être traitées<nbsp>!
msgctxt "NpcYell:19714:0:13"
msgid "Into the suits! Up on high, there's plenty of vegetation practically crying out for our growth formula!"
msgstr ""

#. ja: そうすりゃ、都市全体にエーテルが巡るように、<br>植物を正常に活性化させることができるだろう！
#. de: Versprüht ihr genug davon, sollte es dem Grün gleich besser gehen und sich der Weg nach drinnen öffnen!
#. fr: En les revitalisant ainsi, l'éther pourra à nouveau circuler dans toute la ville et nourrir la végétation<nbsp>!
msgctxt "NpcYell:19715:0:13"
msgid "That should let us revitalize every plant in the area, and make it just like when the land was suffuse with aether!"
msgstr ""

#. ja: よぉし、無事に想定量の錬金剤が散布できたぞッ！
#. de: Jetzt triefen die Pflanzen geradezu von dem Mittel. Saubere Arbeit!
#. fr: Parfait, nous avons répandu suf<shy>fi<shy>sam<shy>ment de produit alchimique<nbsp>!
msgctxt "NpcYell:19716:0:13"
msgid "There we go! Every ilm is covered in the growth formula!"
msgstr ""

#. ja: 作業を終えた者から、<br>パワーローダーから降機して、休んでってくれよな！
#. de: Wer fertig ist, macht bitte Pause. Aber nicht im Cockpit, klaro? Sonst versaut ihr noch die schönen Armaturen<nbsp>...
#. fr: Descendez donc du mécano cosmique et prenez un moment pour souffler, vous l'avez bien mérité<nbsp>!
msgctxt "NpcYell:19717:0:13"
msgid "If your work is done, feel free to get out of your vacuum suit and take a breather!"
msgstr ""

#. ja: コアシステム「グランマ・ローレル」は、<br>文字どおり、この都市の頭脳みてぇなもんだ。
#. de: Das gute Großmütterchen hier hat das Sagen auf Auxesia. Das wahre Familienoberhaupt, wenn man so will<nbsp>...!
#. fr: Comme son nom l'indique, Le Laurier-Mère est le centre névralgique de cette ville.
msgctxt "NpcYell:19718:0:13"
msgid "Grandma Laurel was the city's core system─its brain, if you will!"
msgstr ""

#. ja: こいつを復旧させて周辺施設との間を、<br>エーテルの流れで結ぶことが、今回の目標になる！
#. de: Jedenfalls bleibt uns nur noch, sie zu reaktivieren und mit den anderen Einrichtungen zu vernetzen.
#. fr: Notre objectif présent est de contribuer à sa réactivation en le connectant aux ins<shy>tal<shy>la<shy>tions environnantes grâce à un flux d'éther !
msgctxt "NpcYell:19719:0:13"
msgid "Our objective from this point on is to restore the system and its connections to the surrounding facilities by making the aether flow!"
msgstr ""

#. ja: ドーム内部と外周タワーの根っこに、<br>たっぷり丁寧に錬金剤を散布して、回路を復旧させるんだ！
#. de: Also heißt es wieder: Wachstumsmittel, Wachstumsmittel, Wachstumsmittel! Und zwar nicht nur drinnen, sondern auch draußen, klaro?
#. fr: Pour ce faire, nous devons répandre soigneusement l'agent alchimique à l'intérieur du dôme et à la racine des tours extérieures afin de remettre les circuits en état de fonc<shy>tion<shy>ne<shy>ment<nbsp>!
msgctxt "NpcYell:19720:0:13"
msgid "Let's start by covering the dome's interior and the base of the towers with growth formula. That should get everything connected and fired up!"
msgstr ""

#. ja: よぉし、これだけ錬金剤を浸透させてやれば、<br>植物がエーテルの流れを、うまく形成してくれるはずだ。
#. de: Haben wir dem Großmütterchen etwa mehr von dem Zeug verpasst, als verschrieben war<nbsp>...? Ach Quatsch, das wird schon! Bald ist sie wieder fit!
#. fr: Voici une bonne chose de faite<nbsp>! Maintenant que nous les avons suf<shy>fi<shy>sam<shy>ment imprégnées de produit alchimique, les plantes devraient pouvoir générer un flux d'éther adéquat.
msgctxt "NpcYell:19721:0:13"
msgid "That should do it! With growth formula covering every corner and crevice, the plants should naturally enhance the flow of aether!"
msgstr ""

#. ja: この惑星での共同施工作業も……これが最後になるはずッ！<br>グランマ・ローレルの完全復旧を、みんなで見届けようぜ！
#. de: Und das war's dann auch wieder, was? Schnappt euch 'ne Feierabendkarotte und dann warten wir gemeinsam, bis das Großmütterchen wieder aufwacht, hm?
#. fr: Et voilà qui signe la fin des ouvrages collectifs sur cette planète<nbsp>! Il ne nous reste plus qu'à attendre la restauration définitive du Laurier-Mère<nbsp>!
msgctxt "NpcYell:19722:0:13"
msgid "This project will put a capstone on our work here on Auxesia! Watch as Grandma Laurel returns!"
msgstr ""

#. ja: 今、炎が見えたような…
#. de: Ich dachte, ich hätte gerade Flammen gesehen<nbsp>...
#. fr: J'ai crrru apercevoir une flamme...
msgctxt "NpcYell:19723:0:13"
msgid "Hm? I thought I saw flames..."
msgstr ""

#. ja: 噂の人魚でしょうか…？
#. de: Ist das die berüchtigte Meerjungfrau?
#. fr: C'est la fameuse sirrrène<nbsp>?
msgctxt "NpcYell:19724:0:13"
msgid "Is that a sea-maid?"
msgstr ""

#. ja: こんなところに<br>ガラス瓶…？
#. de: Eine Flasche? An so einem Ort?
#. fr: Une bouteille de verre<nbsp>? Dans un tel endrrroit<nbsp>?
msgctxt "NpcYell:19725:0:13"
msgid "A bottle, here?"
msgstr ""

#. ja: オホホホ！
#. de: Ohohoho!
#. fr: Ohohoho<nbsp>!
msgctxt "NpcYell:19728:0:13"
msgid "Ohohohoho!"
msgstr ""

#. ja: オーッホホホホホ！
#. de: 0
#. fr: Oooohohohohoho<nbsp>!
msgctxt "NpcYell:19729:0:13"
msgid "Ohohohohohoho!"
msgstr ""

#. ja: あら、なんて他愛ないんでしょう！
#. de: 0
#. fr: Votre effronterie m'insupporte<nbsp>!
msgctxt "NpcYell:19730:0:13"
msgid "My word, this futile resistance is simply absurd!"
msgstr ""

#. ja: オイタが過ぎますわね。
#. de: Ein paar Streiche kann ich verzeihen, doch bald werdet ihr schreien<nbsp>...
#. fr: Ça suffit les enfantillages<nbsp>!
msgctxt "NpcYell:19731:0:13"
msgid "Your offenses demand consequences!"
msgstr ""

#. ja: 手加減できませんの。
#. de: Rücksicht? Nachsicht? Diese Worte kenne ich nicht.
#. fr: Ne comptez pas sur mon indulgence<nbsp>!
msgctxt "NpcYell:19732:0:13"
msgid "I'm no saint, so don't expect restraint!"
msgstr ""

#. ja: ……少しナマイキじゃなくて？
#. de: 0
#. fr: Petits impertinents...
msgctxt "NpcYell:19733:0:13"
msgid "So very brave─digging your own grave!"
msgstr ""

#. ja: よござんす！
#. de: Und hepp!
#. fr: Attention, ça va faire bobo<nbsp>!
msgctxt "NpcYell:19734:0:13"
msgid "Very well..."
msgstr ""

#. ja: 何をするつもりだ、博士！
#. de: 0
#. fr: Mais qu'est-ce qu'elle manigance encore...<nbsp>?
msgctxt "NpcYell:19735:0:13"
msgid "What are you plotting, witch!?"
msgstr ""

#. ja: なに…！？
#. de: Verdammt<nbsp>...!
#. fr: Qu'est-ce qui se passe<nbsp>!?
msgctxt "NpcYell:19736:0:13"
msgid "Urgh!"
msgstr ""

#. ja: 私の心の闇が増幅していく…！？
#. de: Meine innere Dunkelheit<nbsp>... wird verstärkt<nbsp>...!
#. fr: Les ténèbres s'emparent de mon âme...
msgctxt "NpcYell:19737:0:13"
msgid "The darkness... It's growing..."
msgstr ""

#. ja: だが…負ける…ものか…！
#. de: Ich werde trotzdem<nbsp>... nicht verlieren<nbsp>...!
#. fr: Je ne peux pas abandonner... Pas maintenant<nbsp>!
msgctxt "NpcYell:19738:0:13"
msgid "No... I won't...give in!"
msgstr ""

#. ja: くっ…及ばなかったか！
#. de: Es ist zu spät<nbsp>...
#. fr: Argh... Je suis à bout<nbsp>!
msgctxt "NpcYell:19739:0:13"
msgid "It's too late..."
msgstr ""

#. ja: ひどく朽ちてるな…
#. de: Dieser Ort hat eindeutig schon bessere Zeiten gesehen<nbsp>...
#. fr: Cet endroit est dans un sale état...
msgctxt "NpcYell:19740:0:13"
msgid "This place has seen better days..."
msgstr ""

#. ja: うぅ～<br>ブルブル
#. de: Brrr<nbsp>... Hier erstarrt man ja zu Eis!
#. fr: Brrr, on se gèle<nbsp>!
msgctxt "NpcYell:19741:0:13"
msgid "Brrr... It's freezing..."
msgstr ""

#. ja: 相当の魔物が<br>入り込んでいますね
#. de: Scheinbar haben sich auch ein paar Bestien hierher verirrt.
#. fr: Les monstres semblent prendre leurs aises, ici.
msgctxt "NpcYell:19742:0:13"
msgid "Quite a few beasts running amok here."
msgstr ""

#. ja: 要塞を目指そう
#. de: Auf zur Festung!
#. fr: Essayons d'atteindre le fort.
msgctxt "NpcYell:19743:0:13"
msgid "Let us make for the fortress."
msgstr ""

#. ja: 大っきい魔物～！
#. de: W-Woah, das Vieh ist riesig!
#. fr: Ce monstre est énorme<nbsp>!
msgctxt "NpcYell:19744:0:13"
msgid "It's enormous!"
msgstr ""

#. ja: あれは、グリフィン…？
#. de: War das etwa ein Greif<nbsp>...?
#. fr: Quoi<nbsp>!? Un griffon<nbsp>?
msgctxt "NpcYell:19745:0:13"
msgid "Was that a griffin...?"
msgstr ""

#. ja: 倒さなければ<br>進めないか…
#. de: Wenn wir weiter wollen, bleibt uns wohl keine Wahl, als dieses Biest zu erlegen<nbsp>...
#. fr: Pas le choix, il faut l'abattre pour avancer.
msgctxt "NpcYell:19746:0:13"
msgid "Seems we must fell the beast if we wish to pass."
msgstr ""

#. ja: まるで門番ですね…！
#. de: Es scheint fast, als würde es den Eingang bewachen!
#. fr: Un vrai chien de garde<nbsp>!
msgctxt "NpcYell:19747:0:13"
msgid "It's almost as if it's guarding the entrance..."
msgstr ""

#. ja: すごい咆哮でした
#. de: Was für ein lautes Gebrüll.
#. fr: Quel souffle incroyable...
msgctxt "NpcYell:19748:0:13"
msgid "Such powerful bellows."
msgstr ""

#. ja: 耳がビリビリする…
#. de: In meinen Ohren klingelt es immer noch<nbsp>...
#. fr: J'en ai les oreilles qui sifflent...
msgctxt "NpcYell:19749:0:13"
msgid "My ears are still ringing..."
msgstr ""

#. ja: 兵たちの<br>成れの果てか…
#. de: Dies ist also mit den Soldaten der Festung geschehen<nbsp>...
#. fr: Voilà donc ce qu'il reste des soldats...
msgctxt "NpcYell:19750:0:13"
msgid "So this is what became of the soldiers..."
msgstr ""

#. ja: 死体が<br>起きあがった～！？
#. de: Die Leichname bewegen sich?!
#. fr: Les cadavres reprennent vie<nbsp>!?
msgctxt "NpcYell:19751:0:13"
msgid "The corpses are springing to life!?"
msgstr ""

#. ja: …眠らせてやろう
#. de: Lasst uns seinem Leid ein Ende bereiten<nbsp>...
#. fr: À nous de lui offrir un repos éternel.
msgctxt "NpcYell:19752:0:13"
msgid "Let us put him to rest."
msgstr ""

#. ja: 砦の指揮官のようだが…
#. de: Wir haben wohl den Kommandanten der Festung vor uns<nbsp>...
#. fr: C'est le commandant du fort<nbsp>?
msgctxt "NpcYell:19753:0:13"
msgid "The commander of the fortress, it would seem."
msgstr ""

#. ja: あ～怖かった…
#. de: Uuh, mir läuft es immer noch kalt den Rücken runter<nbsp>...!
#. fr: J'ai eu une de ces frousses<nbsp>!
msgctxt "NpcYell:19754:0:13"
msgid "Gods, that was unsettling."
msgstr ""

#. ja: 死してなお<br>兵を率いるとは
#. de: Ein Kommandant führt sein Heer selbst im Tode, wie es scheint<nbsp>...
#. fr: Même mort, quelle main de fer sur ses troupes...
msgctxt "NpcYell:19755:0:13"
msgid "Even in death, he continued his command..."
msgstr ""

#. ja: 急いで通り抜けましょう！
#. de: Wir sollten diesen Abschnitt schnellst<shy>möglich passieren!
#. fr: Ne perdons pas de temps<nbsp>!
msgctxt "NpcYell:19756:0:13"
msgid "We'd best pass through here swiftly!"
msgstr ""

#. ja: 凍傷に気を付けて…！
#. de: Nehmt euch vor den eisigen Winden in Acht!
#. fr: Attention aux gelures<nbsp>!
msgctxt "NpcYell:19757:0:13"
msgid "Ware the biting winds!"
msgstr ""

#. ja: ほかの場所ほど<br>寒くはないな…
#. de: Hier ist es zumindest ein kleines bisschen wärmer<nbsp>...
#. fr: Il ne fait pas aussi froid, ici...
msgctxt "NpcYell:19758:0:13"
msgid "It's not as cold here..."
msgstr ""

#. ja: よそ者は出ていけ～！
#. de: Du hast hier nichts zu suchen!
#. fr: Tu n'es pas le bienvenu ici<nbsp>!
msgctxt "NpcYell:19759:0:13"
msgid "You have no place here!"
msgstr ""

#. ja: ヤツの爪に注意しましょう！
#. de: Behaltet seine Krallen im Auge!
#. fr: Attention à ses griffes<nbsp>!
msgctxt "NpcYell:19760:0:13"
msgid "It may unleash powerful gales. Be on your guard."
msgstr ""

#. ja: あの像はハルオーネか…
#. de: Eine Statue von Halone<nbsp>...
#. fr: C'était une statue de Halone<nbsp>?
msgctxt "NpcYell:19761:0:13"
msgid "A statue of Halone..."
msgstr ""

#. ja: 妖異どもを<br>ぶっ倒すぞ！
#. de: Lasst uns diesen Geisterwesen zeigen, mit wem sie sich angelegt haben!
#. fr: Renvoyons ces entités dans le néant<nbsp>!
msgctxt "NpcYell:19762:0:13"
msgid "Let's give the voidsent what for."
msgstr ""

#. ja: 珊瑚やお魚が<br>いっぱいだ～
#. de: Seht nur, all die Korallen<nbsp>...! Und so viele Fische!
#. fr: Tout ce corail... et ces poissons<nbsp>!
msgctxt "NpcYell:19763:0:13"
msgid "So much coral! So many fish!"
msgstr ""

#. ja: 絵巻物のような<br>美しさですね
#. de: Als wären wir direkt in ein Bilderbuch getaucht.
#. fr: Comme un tableau coloré qui s'anime...
msgctxt "NpcYell:19764:0:13"
msgid "It's like a picture scroll brought to life."
msgstr ""

#. ja: 幻想的な光景だな
#. de: Wörter können diesem Anblick kaum gerecht werden.
#. fr: Quel spectacle saisissant<nbsp>!
msgctxt "NpcYell:19765:0:13"
msgid "A wondrous sight."
msgstr ""

#. ja: なんとも雅な宮殿だな
#. de: Dieser Palast strahlt geradezu vor Eleganz.
#. fr: Ce palais est d'une telle élégance...
msgctxt "NpcYell:19766:0:13"
msgid "An elegant palace indeed."
msgstr ""

#. ja: まだ妖異の姿は<br>見えないね～
#. de: Bisher sind mir keine Geisterwesen aufgefallen<nbsp>...
#. fr: Toujours aucune trace de créature du néant.
msgctxt "NpcYell:19767:0:13"
msgid "Still no sign of any voidsent."
msgstr ""

#. ja: 脚のトゲトゲ痛そ～
#. de: Diese Beine könnten uns problemlos durchbohren<nbsp>...
#. fr: Attention, ça va piquer<nbsp>!
msgctxt "NpcYell:19768:0:13"
msgid "Those legs look sharp..."
msgstr ""

#. ja: 海中に棲む魔物か！
#. de: Unser Freund hier ist wohl in diesen Tiefen heimisch.
#. fr: Une créature des fonds marins<nbsp>!
msgctxt "NpcYell:19769:0:13"
msgid "A sea-dwelling monster!"
msgstr ""

#. ja: う…<br>粘液の匂いが…
#. de: Urgh<nbsp>...! Was für ein schrecklicher Gestank!
#. fr: Cette odeur de mucus... Beuargh<nbsp>!
msgctxt "NpcYell:19770:0:13"
msgid "Ugh... What an ungodly smell."
msgstr ""

#. ja: いよいよ宮中だな
#. de: Endlich ist der Weg in den Palast frei!
#. fr: À nous l'intérieur du palais<nbsp>!
msgctxt "NpcYell:19771:0:13"
msgid "At last, the way to the palace is open."
msgstr ""

#. ja: 操られているんだ…！
#. de: Sie wurden von den Geistern besessen!
#. fr: Ils sont possédés<nbsp>!?
msgctxt "NpcYell:19772:0:13"
msgid "They've been possessed!"
msgstr ""

#. ja: そんな…<br>宮中の武官たちが！？
#. de: Oh nein<nbsp>...! Selbst die Palastwachen sind ihnen zum Opfer gefallen?
#. fr: Pourquoi les gardes nous attaquent<nbsp>?
msgctxt "NpcYell:19773:0:13"
msgid "What!? Even the guards!?"
msgstr ""

#. ja: まわりの箱も<br>気になるところだが…
#. de: Was es wohl mit diesen Truhen auf sich hat<nbsp>...?
#. fr: Les coffres autour de nous m'intriguent...
msgctxt "NpcYell:19774:0:13"
msgid "These coffers... How curious."
msgstr ""

#. ja: あの姫君…<br>妖異に魅入られているな
#. de: Die Prinzessin wird scheinbar auch kontrolliert.
#. fr: Elle aussi est possédée par une entité.
msgctxt "NpcYell:19775:0:13"
msgid "She too has been bewitched."
msgstr ""

#. ja: シワシワ残ってない～？
#. de: S-Sind die Falten alle wieder weg?
#. fr: Pitié, dites-moi que ces rides ont disparu<nbsp>!
msgctxt "NpcYell:19776:0:13"
msgid "Please tell me all the wrinkles are gone!"
msgstr ""

#. ja: しばらく<br>眠っていてもらおう
#. de: Am besten lassen wir sie sich hier etwas ausruhen.
#. fr: Elle va avoir droit à une bonne sieste.
msgctxt "NpcYell:19777:0:13"
msgid "Let her rest here for now."
msgstr ""

#. ja: 宮中の平穏を<br>取り戻しましょう…！
#. de: Zeit, wieder Ruhe und Frieden in den Palast zu bringen!
#. fr: Rendons à ce palais sa tranquilité<nbsp>!
msgctxt "NpcYell:19778:0:13"
msgid "Let us return peace to the palace."
msgstr ""

#. ja: 本当に美しいところだな
#. de: Diese Schönheit ist wirklich un<shy>beschreib<shy>lich.
#. fr: C'est tellement beau...
msgctxt "NpcYell:19779:0:13"
msgid "It's truly beautiful here."
msgstr ""

#. ja: 宮殿の主のつもりか…！
#. de: Hält es sich etwa für den Meister des Palasts?
#. fr: On se prend pour le maître du palais, hein<nbsp>?
msgctxt "NpcYell:19780:0:13"
msgid "Does it think itself the master of this place?"
msgstr ""

#. ja: タコを依代にしたのかな～
#. de: Hat dieses Wesen vielleicht einen Oktopus besessen?
#. fr: Posséder une pieuvre... Intéressant...
msgctxt "NpcYell:19781:0:13"
msgid "Perhaps it possessed an octopus."
msgstr ""

#. ja: あの触手は…？
#. de: Tentakel<nbsp>...?
#. fr: Des tentacules<nbsp>?
msgctxt "NpcYell:19782:0:13"
msgid "Tentacles...?"
msgstr ""

#. ja: 醜悪な妖異だな
#. de: Wahrlich abstoßend.
#. fr: Quelle chose immonde...
msgctxt "NpcYell:19783:0:13"
msgid "An unsightly thing."
msgstr ""

#. ja: これでどうだッ！
#. de: Nimm das!
#. fr: Prends ça !
msgctxt "NpcYell:19784:0:13"
msgid "Take that!"
msgstr ""

#. ja: サッサッサ！
#. de: \<feg> \<wisch>
#. fr: Fschuiii<nbsp>!
msgctxt "NpcYell:19785:0:13"
msgid "Swish-swish-swish!"
msgstr ""

#. ja: サッサカサ！
#. de: \<wisch> \<wusch>
#. fr: Fwit, fwit<nbsp>!
msgctxt "NpcYell:19786:0:13"
msgid "Swish-swish-aroo!"
msgstr ""

#. ja: 次から次へと…！
#. de: Das werden immer mehr!
#. fr: Mais combien sont-ils !?
msgctxt "NpcYell:19787:0:13"
msgid "More of them!?"
msgstr ""

#. ja: この静けさは、いったい…？
#. de: Es ist ungewöhnlich ruhig. Was geht hier vor sich<nbsp>...?
#. fr: Ce calme ne me dit rien qui vaille...
msgctxt "NpcYell:19788:0:13"
msgid "I mislike this quiet..."
msgstr ""

#. ja: 警戒警報…？<br>まさか…！
#. de: Ein Angriff<nbsp>...?!
#. fr: Une alerte générale<nbsp>!? Oh non<nbsp>!
msgctxt "NpcYell:19789:0:13"
msgid "Under attack!?"
msgstr ""

#. ja: 風蛇将殿に<br>いいとこ見せるッ…！
#. de: Die Sturmschlangen-Generalin zählt auf uns!
#. fr: Puisse le Général du Serpent du Vent se réjouir de ma performance<nbsp>!
msgctxt "NpcYell:19790:0:13"
msgid "The Galeserpent General's counting on us!"
msgstr ""

#. ja: 蛮族どもめ<br>ブン殴ってやるぜッ！
#. de: Zieht euch warm an!
#. fr: Votre heure a sonné, hommes-bêtes de malheur<nbsp>!
msgctxt "NpcYell:19791:0:13"
msgid "Damned beastmen!"
msgstr ""

#. ja: 護りは引き受けた！
#. de: Wir müssen standhaft bleiben!
#. fr: Je défendrai les miens coûte que coûte<nbsp>!
msgctxt "NpcYell:19792:0:13"
msgid "We must hold the line!"
msgstr ""

#. ja: 魔物に<br>目をつけられませんように…
#. de: Nur nicht zu viel Aufmerksamkeit erregen<nbsp>...
#. fr: Surtout, ne pas attirer l'attention des monstres...
msgctxt "NpcYell:19793:0:13"
msgid "Time for a little subtle sorcery."
msgstr ""

#. ja: あなたにケアル♪<br>回復は任せて！
#. de: Überlasst das Heilen mir!
#. fr: Et un sort de soin pour toi<nbsp>!♪
msgctxt "NpcYell:19794:0:13"
msgid "Leave the healing to me!"
msgstr ""

#. ja: エースの意地<br>見せてやる！
#. de: Ihr werdet meine Kraft gleich zu spüren bekommen!
#. fr: Vous allez goûter à ma force toute puissante<nbsp>!
msgctxt "NpcYell:19795:0:13"
msgid "Time to get to work!"
msgstr ""

#. ja: 華麗な蝉回しで<br>翻弄してやる！
#. de: Na, bin ich zu schnell für dich?!
#. fr: Insaisissable comme la cigale<nbsp>!
msgctxt "NpcYell:19796:0:13"
msgid "Let's see them hit me now!"
msgstr ""

#. ja: 俺が<br>回避盾をするしかないな……
#. de: Ich werde wohl wieder als Schutzschild herhalten müssen<nbsp>...
#. fr: Je vais devoir servir de bouclier...
msgctxt "NpcYell:19797:0:13"
msgid "I guess I'm blink tanking again..."
msgstr ""

#. ja: オラオラオラァ！
#. de: Nimm das! Und das!
#. fr: Et bim et bam et boum<nbsp>!
msgctxt "NpcYell:19798:0:13"
msgid "Take that! And that!"
msgstr ""

#. ja: 連携なら<br>いつでもいけるぜッ！？
#. de: Gemeinsam sind wir stark, oder etwa nicht?!
#. fr: L'union fait la force, pas vrai<nbsp>!?
msgctxt "NpcYell:19799:0:13"
msgid "If you need to chain skills, just say the word!"
msgstr ""

#. ja: ハァッ！
#. de: Haaa!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:19800:0:13"
msgid "Hyah!"
msgstr ""

#. ja: 受けよ！<br>高貴なる剣！
#. de: Meine edle Klinge wird dich zerlegen!
#. fr: Ma noble lame va vous tailler en pièces<nbsp>!
msgctxt "NpcYell:19801:0:13"
msgid "Taste my steel!"
msgstr ""

#. ja: はぁ、はぁ<br>早く倒れてくれ…
#. de: Jetzt stirb schon<nbsp>...!
#. fr: Haa, haa... Vous allez crever, oui<nbsp>!?
msgctxt "NpcYell:19802:0:13"
msgid "Just die already!"
msgstr ""

#. ja: ハーハハハハ！<br>撃ちまくるぞー！
#. de: Feuer frei!
#. fr: Ha ha ha ha ha<nbsp>! Feu à volonté<nbsp>!
msgctxt "NpcYell:19804:0:13"
msgid "Give it everything you've got!"
msgstr ""

#. ja: トルネド！　バースト！<br>フ・レ・アー！
#. de: Tornado! Einschlag! Flaaareee!
#. fr: Tornade<nbsp>! Éclair<nbsp>! Braaasieeer<nbsp>!!
msgctxt "NpcYell:19805:0:13"
msgid "I need to time this flare just right!"
msgstr ""

#. ja: ケアル♪　ケアル♪<br>ホーリー♪
#. de: Keine Sorge, ich mach das schon!
#. fr: Soin♪ Soin♪ Miracle♪
msgctxt "NpcYell:19806:0:13"
msgid "Don't worry─I've got your back!"
msgstr ""

#. ja: はぁ、疲れた…<br>ちょっと座りたい…
#. de: Langsam geht mir die Puste aus<nbsp>...
#. fr: Oh, j'ai un coup de barre... Vite, un siège...
msgctxt "NpcYell:19807:0:13"
msgid "Starting to get a little tired..."
msgstr ""

#. ja: 魔力はまだ足りる…<br>あとは気合だ…ッ！
#. de: Ich hab noch genug magische Energie. Nicht nachlassen!
#. fr: Il me reste assez d'énergie magique... Manque plus que la détermination<nbsp>!
msgctxt "NpcYell:19808:0:13"
msgid "I've still got mana. Let's keep pushing!"
msgstr ""

#. ja: てめぇら、アタシより先に<br>ヘバッてんじゃねえぞ！
#. de: Stirb jetzt bloß nicht, hörst du?!
#. fr: Ne crevez pas avant moi, vous m'entendez<nbsp>!?
msgctxt "NpcYell:19809:0:13"
msgid "Don't you go dying on me!"
msgstr ""

#. ja: ミリ将軍に<br>手出しはさせん！
#. de: Lass die Generalin aus dem Spiel!
#. fr: Vous ne poserez pas vos sales pattes sur Mihli Aliapoh<nbsp>!
msgctxt "NpcYell:19810:0:13"
msgid "The Springserpent needn't get involved!"
msgstr ""

#. ja: 両手武器の重み<br>とくと味わうがいい！
#. de: Nieder mit dir!
#. fr: Vous allez sentir le poids d'une arme à deux mains<nbsp>!
msgctxt "NpcYell:19811:0:13"
msgid "Down with you!"
msgstr ""

#. ja: 将軍は健在<br>なによりだ
#. de: Zum Glück ist den Generälen nichts passiert!
#. fr: Le général est toujours parmi nous<nbsp>!
msgctxt "NpcYell:19812:0:13"
msgid "Thank goodness the generals are unharmed!"
msgstr ""

#. ja: もう終いか？<br>まだまだ殴り足りねえぜ！
#. de: Schon vorbei? Wie enttäuschend<nbsp>...
#. fr: C'est déjà terminé<nbsp>? Il me reste encore quelques baffes à distribuer, pourtant<nbsp>!
msgctxt "NpcYell:19813:0:13"
msgid "Over already? Dammit..."
msgstr ""

#. ja: みな軽傷か<br>よかった、本当に
#. de: Sind alle wohlauf?
#. fr: Aucun blessé grave<nbsp>? Tant mieux...
msgctxt "NpcYell:19814:0:13"
msgid "Is everyone all right?"
msgstr ""

#. ja: ギリギリの戦いだったな…<br>この先も、気をつけろよ
#. de: Das war wirklich knapp<nbsp>... Bleibt wachsam!
#. fr: C'était plus que serré... Attention à vous<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:19815:0:13"
msgid "That was a little <i>too</i> close..."
msgstr ""

#. ja: ふぅ…<br>味方が強くてよかった！
#. de: Zum Glück hatten wir tatkräftige Unterstützung!
#. fr: Heu<shy>reu<shy>se<shy>ment que nos alliés étaient aussi fortiches<nbsp>!
msgctxt "NpcYell:19816:0:13"
msgid "Phew! Glad that's over!"
msgstr ""

#. ja: 戦いの報酬<br>受け取りに行きましょ♪
#. de: Zeit für eine wohlverdiente Belohnung!
#. fr: À nous le butin des vainqueurs<nbsp>!♪
msgctxt "NpcYell:19817:0:13"
msgid "Time to get our reward!"
msgstr ""

#. ja: お前ら無事だな？<br>よっし、帰って飯にしようぜ！
#. de: Geht's euch allen gut? Dann lasst uns was essen gehen!
#. fr: Tout le monde va bien<nbsp>? Dans ce cas, il est temps d'aller manger<nbsp>!
msgctxt "NpcYell:19818:0:13"
msgid "Everyone all right? Then let's go eat!"
msgstr ""

#. ja: 今日も生き延びた<br>エースとしてな…
#. de: Wieder eine Heraus<shy>forde<shy>rung, die wir mit Bravour gemeistert haben!
#. fr: Encore une épreuve surmontée avec brio<nbsp>!
msgctxt "NpcYell:19819:0:13"
msgid "We live to fight another day..."
msgstr ""

#. ja: バ～イバイキングッ！
#. de: iN DeN sTaUb!
#. fr: Grut<nbsp>!
msgctxt "NpcYell:19820:0:13"
msgid "DoWn WiTh YoU!"
msgstr ""

#. ja: バイバ～イキングッ！
#. de: HiEr EnDet DeIn wEg!
#. fr: Sigr<nbsp>!
msgctxt "NpcYell:19821:0:13"
msgid "EnD oF tHe RoAd!"
msgstr ""

#. ja: ベェ～？
#. de: Blub, blub ...
#. fr: Doo, doo, doo doo...
msgctxt "NpcYell:19822:0:13"
msgid "Glub...glub..."
msgstr ""

#. ja: ホイットナ
#. de: Brrrumm!
#. fr: Pouet pouet<nbsp>!
msgctxt "NpcYell:19823:0:13"
msgid "\\<whirr>"
msgstr ""

#. ja: メェ～
#. de: Määäh!
#. fr: Bêêêh<nbsp>!
msgctxt "NpcYell:19824:0:13"
msgid "Meeeeeeh!"
msgstr ""

#. ja: ココカラジャヨ…
#. de: Hier geht es weiter<nbsp>...
#. fr: Ici, tout commence...
msgctxt "NpcYell:19825:0:13"
msgid "Witness wisdom's true potential!"
msgstr ""

#. ja: ぴゅいん！
#. de: AlL mEinE kRaFt In MeTeO!
#. fr: Abracad'bra<nbsp>!
msgctxt "NpcYell:19826:0:13"
msgid "PeW-pEw!"
msgstr ""

#. ja: アンタヲ超エテミセル！
#. de: Bald übertreffe ich dich!
#. fr: Je te surpasserai<nbsp>!
msgctxt "NpcYell:19827:0:13"
msgid "I'll surpass you one day!"
msgstr ""

#. ja: ゴ主人様…！
#. de: Herr ...
#. fr: Votre Primauté<nbsp>!
msgctxt "NpcYell:19828:0:13"
msgid "Master..."
msgstr ""

#. ja: ハラペコダゼ！
#. de: Mann, hab ich Kohldampf!
#. fr: J'ai la daaalle<nbsp>!!!
msgctxt "NpcYell:19829:0:13"
msgid "Time to break out the grub!"
msgstr ""

#. ja: ニャハハ！
#. de: Miahaha!
#. fr: Miahaha<nbsp>!
msgctxt "NpcYell:19830:0:13"
msgid "Mjahaha!"
msgstr ""

#. ja: 樹幹ネットワークに接続中…
#. de: Verbinde zum Wurzelnetz<nbsp>...
#. fr: Connexion au réseau-tronc...
msgctxt "NpcYell:19831:0:13"
msgid "Connecting to trunk network..."
msgstr ""

#. ja: オレハイクゼ！
#. de: Los, los, looos!
#. fr: Je pars, je pars, je suis parti<nbsp>!
msgctxt "NpcYell:19832:0:13"
msgid "Bringin' the heat!"
msgstr ""

#. ja: キャルルル！
#. de: Gruu, gruu!
#. fr: Piou-piou<nbsp>!
msgctxt "NpcYell:19833:0:13"
msgid "Chirrup!"
msgstr ""

#. ja: 上から瓦礫が…！
#. de: Achtung, da fällt etwas!
#. fr: Attention aux débrrris qui tombent !
msgctxt "NpcYell:19834:0:13"
msgid "Watch out for falling debris!"
msgstr ""

#. ja: 魔導兵器が<br>戦ってるんだ…！
#. de: Die Magitek-Einheiten sind noch in Betrieb.
#. fr: Ils ont déployé les armures magitek !
msgctxt "NpcYell:19835:0:13"
msgid "A magitek bombardment!?"
msgstr ""

#. ja: さぁ、反撃開始よ！
#. de: Angreifen!
#. fr: C'est l'heure de la contre-attaque !
msgctxt "NpcYell:19836:0:13"
msgid "Onward!"
msgstr ""

#. ja: 向こうから来るとは<br>好都合だ！
#. de: So gefällt mir das.
#. fr: En voilà d'autres... Tant mieux, j'avais besoin de me défouler !
msgctxt "NpcYell:19837:0:13"
msgid "They don't stand a chance!"
msgstr ""

#. ja: 排除しながら進もう！
#. de: Immer weiter vorrücken!
#. fr: Allez, on fait le ménage, et on avance !
msgctxt "NpcYell:19838:0:13"
msgid "We must hurry!"
msgstr ""

#. ja: 我らのエーテルが<br>狙いですか…
#. de: Sie haben es auf unseren Äther abgesehen.
#. fr: Ces créatures ont soif d'éther...
msgctxt "NpcYell:19839:0:13"
msgid "Their hunger for aether is insatiable..."
msgstr ""

#. ja: 持ち堪えてくれてたか…！
#. de: Die haben wohl auf uns gewartet!
#. fr: Ouf, ils ont tenu jusqu'à notre arrivée !
msgctxt "NpcYell:19840:0:13"
msgid "There you are!"
msgstr ""

#. ja: ユルスたちは<br>態勢の立て直しを！
#. de: Jullus! Schließt die Reihen!
#. fr: Jullus ! Profites-en pour reformer tes troupes !
msgctxt "NpcYell:19841:0:13"
msgid "Jullus! Stand fast!"
msgstr ""

#. ja: 待たせたわね！
#. de: Keine Angst, jetzt sind wir hier.
#. fr: Désolée d'avoir mis si longtemps !
msgctxt "NpcYell:19842:0:13"
msgid "We're here now!"
msgstr ""

#. ja: また後で会おう！
#. de: Wir treffen uns später!
#. fr: Retrouvons-nous plus tard !
msgctxt "NpcYell:19843:0:13"
msgid "We can speak later!"
msgstr ""

#. ja: 委細承知しました…
#. de: Verstanden.
#. fr: C'est entendu.
msgctxt "NpcYell:19844:0:13"
msgid "Understood."
msgstr ""

#. ja: 了解、行ってくるわ！
#. de: Gut, bis später!
#. fr: D'accord, on y va !
msgctxt "NpcYell:19845:0:13"
msgid "Hang in there!"
msgstr ""

#. ja: 妖異が魔導兵器と<br>融合しているのか？
#. de: Die können miteinander verschmelzen?
#. fr: Une créature du néant qui a fusionné avec une machine magitek... ?
msgctxt "NpcYell:19846:0:13"
msgid "An amalgamation of beast and machine?"
msgstr ""

#. ja: あの眼…<br>嫌な予感がするぞ
#. de: Dieses Auge kann nichts Gutes verheißen.
#. fr: Je n'aime pas du tout son regarrrd...
msgctxt "NpcYell:19847:0:13"
msgid "That baleful eye... Be on your guard!"
msgstr ""

#. ja: これはまた<br>面妖な…
#. de: Eigenartig. Wirklich eigenartig.
#. fr: Voilà qui est pour le moins étonnant...
msgctxt "NpcYell:19848:0:13"
msgid "An intriguing specimen..."
msgstr ""

#. ja: やれやれ…<br>奇妙な相手だったな
#. de: Das war mal wieder ein Gegner der besonderen Sorte!
#. fr: Eh bien... C'était un drôle d'adversaire.
msgctxt "NpcYell:19849:0:13"
msgid "That was a strange encounter..."
msgstr ""

#. ja: 魔導工廠へ<br>急ごう！
#. de: Weiter, zum Klyteum!
#. fr: Dépêchons-nous d'atteindre le Clyteum !
msgctxt "NpcYell:19850:0:13"
msgid "To the Clyteum!"
msgstr ""

#. ja: 先を急ぐわよ！
#. de: Beeilung!
#. fr: Vite ! Ne traînons pas !
msgctxt "NpcYell:19851:0:13"
msgid "Time to push forward!"
msgstr ""

#. ja: さあ、先を<br>急ぎましょう！
#. de: Weiter, aber schnell!
#. fr: Allez, dépêchons-nous d'avancer !
msgctxt "NpcYell:19852:0:13"
msgid "We must keep going!"
msgstr ""

#. ja: まったく<br>次から次へと…！
#. de: Hört das denn nie auf?
#. fr: Grr... Quand y en a plus, y en a encore !
msgctxt "NpcYell:19853:0:13"
msgid "Awfully persistent..."
msgstr ""

#. ja: ここで食い止める！
#. de: Haltet sie auf!
#. fr: Il faut les empêcher d'aller plus loin !
msgctxt "NpcYell:19854:0:13"
msgid "Halt their advance!"
msgstr ""

#. ja: これほどの数が<br>侵入しているとは…
#. de: Das sind verdächtig viele ...
#. fr: L'invasion a atteint une telle ampleur...
msgctxt "NpcYell:19855:0:13"
msgid "Their numbers are legion..."
msgstr ""

#. ja: ここにも妖異が…！
#. de: Sind hier etwa auch Nichts<shy>gesand<shy>te?
#. fr: Il y en a même ici !?
msgctxt "NpcYell:19856:0:13"
msgid "They're everywhere!"
msgstr ""

#. ja: 通してもらうよ！
#. de: Platz da!
#. fr: Nous passerons, que vous le vouliez ou non !
msgctxt "NpcYell:19857:0:13"
msgid "Let none bar our path!"
msgstr ""

#. ja: 全部やっつけましょ！
#. de: Wir lassen nichts stehen!
#. fr: On fait le ménage !
msgctxt "NpcYell:19858:0:13"
msgid "Leave none standing!"
msgstr ""

#. ja: ああ、もう…！<br>全部やっつけましょ！
#. de: Tja, die müssen wir alle besiegen!
#. fr: Raaah, y en a trop ! Allez, on fait le ménage !
msgctxt "NpcYell:19859:0:13"
msgid "Let's make short work of them!"
msgstr ""

#. ja: 鈍重そうだが<br>油断するなよ！
#. de: Harte Arbeit erfordert harte Krieger!
#. fr: On avance bien, mais ne baissez pas votre garde !
msgctxt "NpcYell:19860:0:13"
msgid "Doesn't seem like the brightest of foes..."
msgstr ""

#. ja: 図体の割に<br>身軽そうだ…！
#. de: Für seine Statur wirkt er überraschend behende.
#. fr: Il est plutôt agile pour son gabarrrit !
msgctxt "NpcYell:19861:0:13"
msgid "Surprisingly agile for one so rotund!"
msgstr ""

#. ja: これほど<br>大型の妖異も…！
#. de: Das ist ein ganz schöner Brocken!
#. fr: Il y en a même d'aussi gros !? Quelle catastrophe !
msgctxt "NpcYell:19862:0:13"
msgid "A veritable giant!"
msgstr ""

#. ja: ああ、相当に<br>素早そうだ…！
#. de: Ja, der ist schnell!
#. fr: Et rrrapide, avec ça !
msgctxt "NpcYell:19863:0:13"
msgid "Such blistering speed!"
msgstr ""

#. ja: なんとか倒せたな
#. de: Wir haben ihn irgendwie besiegt!
#. fr: Ouf, on a fini par l'avoirrr.
msgctxt "NpcYell:19864:0:13"
msgid "That was quite the challenge..."
msgstr ""

#. ja: さぁ、工廠内部に<br>突入しよう
#. de: Jetzt weiter!
#. fr: Allez, entrons dans le bâtiment.
msgctxt "NpcYell:19865:0:13"
msgid "Not far to the Clyteum now!"
msgstr ""

#. ja: 目が回るかと<br>思ったわ…！
#. de: Mir geht langsam die Puste aus.
#. fr: J'en ai la tête qui tourne...
msgctxt "NpcYell:19866:0:13"
msgid "I was starting to feel dizzy..."
msgstr ""

#. ja: 残骸が動き出した！？
#. de: Der Schrott ... lebt?
#. fr: Des carcasses de métal qui prennent vie !?
msgctxt "NpcYell:19867:0:13"
msgid "These creatures are made of scrap?"
msgstr ""

#. ja: 残骸がまるで<br>傀儡のようだ
#. de: Sie erinnern mich an Marionetten.
#. fr: Ces débris bougent comme des marrrionnettes !
msgctxt "NpcYell:19868:0:13"
msgid "Twisted constructs like puppets..."
msgstr ""

#. ja: 何者かに<br>操られている…？
#. de: Steuert das jemand?
#. fr: On dirait qu'une main invisible est à l'œuvre...
msgctxt "NpcYell:19869:0:13"
msgid "An unseen hand doth guide them..."
msgstr ""

#. ja: こいつは楽でいいな
#. de: Besser als laufen.
#. fr: Plus simple que de prendre les escaliers.
msgctxt "NpcYell:19870:0:13"
msgid "Better than taking the stairs...."
msgstr ""

#. ja: すごい移動装置だな…！
#. de: Ein wahrlich interessanter Transporter!
#. fr: In<shy>té<shy>rrres<shy>sant comme moyen de transport !
msgctxt "NpcYell:19871:0:13"
msgid "How exhilarating!"
msgstr ""

#. ja: びっくりした…！
#. de: Hoppla!
#. fr: C'est... surprenant !
msgctxt "NpcYell:19872:0:13"
msgid "My word!"
msgstr ""

#. ja: 本来は資材運搬用だ<br>ほかで見たことがある
#. de: Ich habe so was schon mal gesehen.<br>Eigentlich ist das für Material.
#. fr: À l'origine, ça devait plutôt être utilisé pour le transport des ressources...
msgctxt "NpcYell:19873:0:13"
msgid "Something tells me that wasn't designed for people..."
msgstr ""

#. ja: これまでより<br>格上の相手のようだ…
#. de: Der sieht stärker aus als die anderen.
#. fr: Celui-ci ne joue pas dans la même catégorie que les autres...
msgctxt "NpcYell:19874:0:13"
msgid "This one seems more formidable than the others..."
msgstr ""

#. ja: 残骸を操っていたのは<br>この妖異ですか…
#. de: Der hat den Schrott gerade eben gesteuert!
#. fr: Voilà donc celui qui manipulait les épaves de métal...
msgctxt "NpcYell:19875:0:13"
msgid "Mayhap this is the puppeteer..."
msgstr ""

#. ja: さっさと倒して<br>混乱を収めるわよ！
#. de: Los! Räumen wir ihn aus dem Weg!
#. fr: Débarrassons-nous de lui pour mettre fin à la panique générale !
msgctxt "NpcYell:19876:0:13"
msgid "Let's put an end to this!"
msgstr ""

#. ja: 仕掛けてくるぞ！
#. de: Pass bloß auf, du!
#. fr: Il prépare quelque chose !
msgctxt "NpcYell:19877:0:13"
msgid "Watch out!"
msgstr ""

#. ja: アイツの眼に<br>注意しろ！
#. de: Achtung! Sein Auge!
#. fr: Faites bien attention à son regarrrd !
msgctxt "NpcYell:19878:0:13"
msgid "Ware that eye!"
msgstr ""

#. ja: どこを見ている！？
#. de: Wohin blickt es?
#. fr: Qu'est-ce qu'il cherche !?
msgctxt "NpcYell:19879:0:13"
msgid "What does it seek!?"
msgstr ""

#. ja: 眼球に魔力が<br>集中しています…
#. de: Das Auge sammelt Kraft ...
#. fr: Il concentre de l'énergie magique dans son œil...
msgctxt "NpcYell:19880:0:13"
msgid "The eye draweth aether unto itself..."
msgstr ""

#. ja: キョロキョロして…<br>どういうつもり？
#. de: Was hat er vor?
#. fr: Qu'est-ce qu'il a, à regarder partout ?
msgctxt "NpcYell:19881:0:13"
msgid "What's it doing?"
msgstr ""

#. ja: 油断するなよ…！
#. de: Wachsam bleiben!
#. fr: Restez sur vos gardes !
msgctxt "NpcYell:19882:0:13"
msgid "Stay alert!"
msgstr ""

#. ja: 機を窺っているのか？
#. de: Wartet er auf den richtigen Moment?
#. fr: Peut-êtrrre qu'il attend le bon moment ?
msgctxt "NpcYell:19883:0:13"
msgid "Perhaps it waits for an opportune moment?"
msgstr ""

#. ja: どこから来る…？
#. de: Von wo kommt der Angriff?
#. fr: D'où va venir la prochaine attaque... ?
msgctxt "NpcYell:19884:0:13"
msgid "Its movements are unpredictable..."
msgstr ""

#. ja: 回避を…！
#. de: Ausweichen!
#. fr: Prenez garde... !
msgctxt "NpcYell:19885:0:13"
msgid "Have care!"
msgstr ""

#. ja: もうっ<br>何なのよ…！？
#. de: He, was soll das!?
#. fr: C'est quoi son problème, à la fin !?
msgctxt "NpcYell:19886:0:13"
msgid "What in the hells!?"
msgstr ""

#. ja: 一ヶ所に固まれ！
#. de: Alle auf einen Fleck!
#. fr: Vite, on se regroupe !
msgctxt "NpcYell:19887:0:13"
msgid "Everyone, gather close!"
msgstr ""

#. ja: 力を合わせれば…！
#. de: Kräfte sammeln!
#. fr: Si on unit nos forrrces...
msgctxt "NpcYell:19888:0:13"
msgid "Quickly, we must stay together!"
msgstr ""

#. ja: 皆で耐え抜くんだ！
#. de: Zusammen stehen wir das durch!
#. fr: Nous devons rester ensemble pour tenir le coup !
msgctxt "NpcYell:19889:0:13"
msgid "We'll make it through this together!"
msgstr ""

#. ja: 独りで受けるのは<br>あまりに危険…
#. de: Allein hält das keiner aus!
#. fr: Il serait imprudent de tenter de résister à une telle attaque seul...
msgctxt "NpcYell:19890:0:13"
msgid "One cannot weather such power alone..."
msgstr ""

#. ja: ここはみんなで<br>対処しましょう！
#. de: Wir schaffen das nur zusammen!
#. fr: Ensemble, nous avons une chance de nous en sortir !
msgctxt "NpcYell:19891:0:13"
msgid "Stand together, everyone!"
msgstr ""

#. ja: 何をするつもりだ…？
#. de: Was hat er vor?
#. fr: Que compte-il faire... ?
msgctxt "NpcYell:19892:0:13"
msgid "What are they doing?"
msgstr ""

#. ja: 妖糸を巻きつけて<br>いるのか…？
#. de: Spinnt er Fäden?
#. fr: Il les a attaché à des fils...<nbsp>?
msgctxt "NpcYell:19893:0:13"
msgid "Those tendrils..."
msgstr ""

#. ja: 周囲に警戒を！
#. de: Aufpassen!
#. fr: Faites attention autour de vous !
msgctxt "NpcYell:19894:0:13"
msgid "Be careful!"
msgstr ""

#. ja: 残骸を傀儡に…？
#. de: Er nutzt den Schrott als Marionetten<nbsp>...
#. fr: Il a changé les débris en marionnettes !
msgctxt "NpcYell:19895:0:13"
msgid "Born of scrap before our very eyes..."
msgstr ""

#. ja: 傀儡の動きに<br>注意するんだ！
#. de: Passt auf, was das Ding macht!
#. fr: Obserrrvez bien les mouvements des marionnettes !
msgctxt "NpcYell:19896:0:13"
msgid "Be wary of the puppets!"
msgstr ""

#. ja: 離れて対処すれば！
#. de: Auseinander!
#. fr: Séparons-nous !
msgctxt "NpcYell:19897:0:13"
msgid "We ought to split up!"
msgstr ""

#. ja: さすがに魔力の糸は<br>断ち切れんか…
#. de: Wir müssen die Fäden durchtrennen!
#. fr: Si seulement nous pouvions couper ces fils magiques...
msgctxt "NpcYell:19898:0:13"
msgid "If only we could sever those strands..."
msgstr ""

#. ja: 傀儡を一斉に<br>操りだしたぞ…？
#. de: Ohne ihn ist das nur Schrott!
#. fr: Il manipule toutes ces marrrionnettes en même temps ?
msgctxt "NpcYell:19899:0:13"
msgid "They command the puppets as one!"
msgstr ""

#. ja: 何をしてこようとも…！
#. de: Was soll denn das!?
#. fr: Nous gagnerons, quoi qu'il en coûte... !
msgctxt "NpcYell:19900:0:13"
msgid "By the Twelve! This is madness!"
msgstr ""

#. ja: ふむ、数で押そうと…？
#. de: Eine überwältigende Zahl.
#. fr: Ainsi, il espère l'emporter par le nombre ?
msgctxt "NpcYell:19901:0:13"
msgid "A battle of attrition..."
msgstr ""

#. ja: 憎たらしいほど<br>器用ね！
#. de: Das fängt an zu nerven!
#. fr: Il est vraiment habile, c'en est  agaçant !
msgctxt "NpcYell:19902:0:13"
msgid "They're beginning to try my patience!"
msgstr ""

#. ja: 傀儡だけ<br>見ていればいい
#. de: Achtet nur auf die Marionetten!
#. fr: Restez concentrés sur les marionnettes !
msgctxt "NpcYell:19903:0:13"
msgid "Keep an eye on the minions."
msgstr ""

#. ja: 回転する先を読めば…！
#. de: Versucht, den Angriff vorherzusehen!
#. fr: Essayez de deviner où elles vont frrrapper !
msgctxt "NpcYell:19904:0:13"
msgid "Try to predict their attacks!"
msgstr ""

#. ja: 傀儡の動きを<br>見極めるんだ！
#. de: Man kann ahnen, was er tut!
#. fr: Nous devons bien observer les mouvements des marionettes !
msgctxt "NpcYell:19905:0:13"
msgid "Watch the puppets' movements!"
msgstr ""

#. ja: まるで人形使いですね…
#. de: Wie ein echter Puppenspieler<nbsp>...
#. fr: Nous avons affaire à un marionnettiste de talent...
msgctxt "NpcYell:19906:0:13"
msgid "They are a puppeteer of surpassing skill..."
msgstr ""

#. ja: 同じ手は何度も<br>食わないわよ！
#. de: Zweimal lass ich mich nicht reinlegen!
#. fr: Tu ne m'auras pas deux fois avec ça !
msgctxt "NpcYell:19907:0:13"
msgid "I won't fall for that again!"
msgstr ""

#. ja: 私も負けてられないね
#. de: Da muss ich mich wohl ebenfalls mehr anstrengen.
#. fr: Je n'ai pas dit mon dernier mot.
msgctxt "NpcYell:19908:0:13"
msgid "I will do my part too."
msgstr ""

#. ja: もう後れは取らない
#. de: Das passiert mir nicht noch einmal.
#. fr: Je ne me ferai plus avoir.
msgctxt "NpcYell:19909:0:13"
msgid "I will be more careful."
msgstr ""

#. ja: まだまだいける！
#. de: Ich bin noch lange nicht fertig!
#. fr: Hors de question d'abandonner<nbsp>!
msgctxt "NpcYell:19910:0:13"
msgid "Only getting started!"
msgstr ""

#. ja: 癒やしの力よ！
#. de: Das haben wir gleich!
#. fr: Voilà de quoi vous requinquer<nbsp>!
msgctxt "NpcYell:19911:0:13"
msgid "I shall tend your wounds!"
msgstr ""

#. ja: 私が支えてみせる！
#. de: Überlass das mir!
#. fr: Je suis là pour vous protéger<nbsp>!
msgctxt "NpcYell:19912:0:13"
msgid "Fight freely, my friends!"
msgstr ""

#. ja: そこだッ！
#. de: So nicht!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:19913:0:13"
msgid "There!"
msgstr ""

#. ja: まとめてかかってこい！
#. de: Na kommt, ist genug für alle da!
#. fr: Venez tous autant que vous êtes<nbsp>!
msgctxt "NpcYell:19914:0:13"
msgid "Come, then!"
msgstr ""

#. ja: 借りは返させてもらうぞ！
#. de: Jetzt bin ich dran.
#. fr: Un prêté pour un rendu<nbsp>!
msgctxt "NpcYell:19915:0:13"
msgid "Allow me to return the favor!"
msgstr ""

#. ja: いくぞ！
#. de: Hrah!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:19916:0:13"
msgid "No mercy!"
msgstr ""

#. ja: どうだ！
#. de: Nimm das!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:19917:0:13"
msgid "Try this!"
msgstr ""

#. ja: トドメだ！
#. de: Und der Gnadenstoß!
#. fr: Le coup de grâce<nbsp>!
msgctxt "NpcYell:19918:0:13"
msgid "You're finished!"
msgstr ""

#. ja: 受けてみろ！
#. de: Aus und vorbei!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:19919:0:13"
msgid "Can you withstand this?"
msgstr ""

#. ja: 仕事熱心なお前らには、感心させられっぱなしだったぜ。<br>またどこかの現場で力を合わせるときにゃ、よろしく頼むぞッ！
#. de: Ihr Jungs und Mädels seid die Allerhoppeligsten! Ich hoff' wirklich, der nächste gemeinsame Bau ist nicht allzu fern!
#. fr: Votre motivation était im<shy>pres<shy>sion<shy>nante du début à la fin<nbsp>! Je compte sur vous pour venir travailler sur un autre chantier bientôt, d'accord<nbsp>?
msgctxt "NpcYell:19920:0:13"
msgid "Truly, we could not have asked for better workers than you lot. I hope our next project together is sooner rather than later!"
msgstr ""

#. ja: 貸しにしといてあげる！
#. de: Los geht's!
#. fr: Faudra pas oublier de rendre la pareille<nbsp>!
msgctxt "NpcYell:19921:0:13"
msgid "Pay me back later!"
msgstr ""

#. ja: ぷっぷぅ♪
#. de: Blöp ♪
#. fr: Rrrik... thfffu<nbsp>!♪
msgctxt "NpcYell:19922:0:13"
msgid "Ptui～♪"
msgstr ""

#. ja: ナァ～ン
#. de: Miaaah ...
#. fr: Miaouam<nbsp>!
msgctxt "NpcYell:19923:0:13"
msgid "Meo～w."
msgstr ""

#. ja: 覚悟ッ…！
#. de: Obacht!
#. fr: En garde<nbsp>!
msgctxt "NpcYell:19924:0:13"
msgid "On your guard!"
msgstr ""

#. ja: 吹き飛んでください！
#. de: Flieg, Vögelchen. Flieg!
#. fr: Hors de ma vue<nbsp>!
msgctxt "NpcYell:19925:0:13"
msgid "Away with thee!"
msgstr ""

#. ja: 真っ二つです！
#. de: Exakt in zwei Hälften!
#. fr: Je vais vous couper en deux<nbsp>!
msgctxt "NpcYell:19926:0:13"
msgid "Cross us at your peril!"
msgstr ""

#. ja: 雑魚は引き受ける<br>好きに暴れてくれ！
#. de: Die überlasse ich dir. Tob dich ruhig an ihnen aus!
#. fr: On fera le ménage derrière toi. Déchaîne-toi comme tu veux !
msgctxt "NpcYell:19927:0:13"
msgid "Leave the fodder to us. Don't hold back!"
msgstr ""

#. ja: 皆様との共闘は<br>久しぶりですね…
#. de: Es ist schon eine Weile her, dass wir gemeinsam gekämpft haben.
#. fr: Il y a bien longtemps que nous n'avons pas combattu ensemble.
msgctxt "NpcYell:19928:0:13"
msgid "Long hath it been since last we fought together."
msgstr ""

#. ja: 図体の割に<br>身軽じゃないか
#. de: Für deine Größe bist du ziemlich flink.
#. fr: Plutôt agile, malgré sa taille !
msgctxt "NpcYell:19929:0:13"
msgid "How in the hells is it moving so fast?"
msgstr ""

#. ja: 今の身のこなし…<br>十分に気をつけるんだ！
#. de: Der hat was vor. Aufgepasst!
#. fr: Celui-là à l'air corrriace... Faites attention<nbsp>!
msgctxt "NpcYell:19930:0:13"
msgid "They're up to something... Be on your guard!"
msgstr ""

#. ja: 見た目ほど鈍重では<br>ないみたいだね…
#. de: Der ist schneller, als er aussieht!
#. fr: Il n'est peut-être pas aussi idiot qu'il en a l'air...
msgctxt "NpcYell:19931:0:13"
msgid "Not quite the lumbering lump I'd expected..."
msgstr ""

#. ja: こいつはまた<br>デカいのが現れたな
#. de: Da ist schon wieder so ein Großer!
#. fr: Et voilà encore un gros plein de soupe...
msgctxt "NpcYell:19932:0:13"
msgid "I don't like the looks of this fellow."
msgstr ""
