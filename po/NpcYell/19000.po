msgid "VeRy WeLl!"
msgstr ""

#. ja: ウワーン！<br>ナンテコトスルンダヨー！
#. de: UwAh! WaS tUt IhR dEnN dA?!
#. fr: Hééé<nbsp>! C'est pas du jeu<nbsp>!
msgctxt "NpcYell:19535:0:13"
msgid "WaAaH! hOw CoUlD yOu!?"
msgstr ""

#. ja: 対象選定…<br>ナレッジ…5…デス…
#. de: Wissensstufe<nbsp>... 5<nbsp>... Tod<nbsp>...
#. fr: Sélection de la cible...<br>Mort... niveau de savoir... 5.
#. macro: <br> — a line break (may be added or dropped)
