#. ja: みんな、死ぬなよ！
#. de: Ich will niemanden verlieren.
#. fr: Vous n'avez pas intérêt à mourir, camarades !
msgctxt "NpcYell:19545:0:13"
msgid "We'll not lose anyone else!"
msgstr ""

#. ja: ここで食い止める！
#. de: Haltet sie auf!
#. fr: Nous ne les laisserons pas passer !
msgctxt "NpcYell:19546:0:13"
msgid "Hold them off!"
msgstr ""

#. ja: 市民のところへは…！
#. de: Wir müssen die Zivilisten retten!
#. fr: Ils ne doivent pas atteindre les civils !
msgctxt "NpcYell:19547:0:13"
msgid "We must protect the people!"
msgstr ""

#. ja: 倒れろッ！
#. de: Stirb!
#. fr: Meurs, vile créature !
msgctxt "NpcYell:19548:0:13"
msgid "Die!"
msgstr ""

#. ja: くっ…！
#. de: Ugh ...
#. fr: Ugh... !
msgctxt "NpcYell:19549:0:13"
msgid "Grrrgh!"
msgstr ""

#. ja: なんなんだ<br>こいつらッ！
#. de: W-Was sind das für Wesen?
#. fr: Il en arrive sans cesse... !
msgctxt "NpcYell:19550:0:13"
msgid "Curse these voidsent!"
msgstr ""

#. ja: 死んでたまるか！
#. de: Ich werde nicht sterben!
#. fr: Pas question de mourir maintenant !
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:19551:0:13"
msgid "I am <i>not</i> dying today!"
msgstr ""

#. ja: オラァッ！
#. de: Haaa!
#. fr: Raaaah !
msgctxt "NpcYell:19552:0:13"
msgid "Wretched creature!"
msgstr ""

#. ja: どうして妖異が…！
#. de: Nichtswesen, hier?
#. fr: Mais d'où sortent toutes ces créatures... ?
msgctxt "NpcYell:19553:0:13"
msgid "They just keep coming!"
msgstr ""

#. ja: うおぉぉ！
#. de: Huaaa!
#. fr: Hmmmpf !
msgctxt "NpcYell:19554:0:13"
msgid "Have at you!"
msgstr ""

#. ja: シャントット博士！？
#. de: D-Doktor Shantotto?!
#. fr: Le... Le professeur Shantotto<nbsp>!?
msgctxt "NpcYell:19555:0:13"
msgid "Shantotto!?"
msgstr ""

#. ja: 魔法人形だと…？
#. de: Es war nur eine Puppe<nbsp>...?
#. fr: Une... poupée magique<nbsp>?
msgctxt "NpcYell:19556:0:13"
msgid "She was...a doll?"
msgstr ""

#. ja: 来たか、迎撃するぞ！
#. de: Da kommen sie! Angriff!
#. fr: À nous de leur donner une bonne leçon<nbsp>!
msgctxt "NpcYell:19557:0:13"
msgid "Here they come!"
msgstr ""

#. ja: 後詰めの部隊だ！
#. de: Vorsicht, die Nachhut steht schon bereit!
#. fr: Voilà les renforts, tenez-vous prêts<nbsp>!
msgctxt "NpcYell:19558:0:13"
msgid "Reinforcements!"
msgstr ""

#. ja: くそっ、キリがない！
#. de: Wie viele denn noch?!
#. fr: Merde<nbsp>! On n'en voit pas le bout<nbsp>!
msgctxt "NpcYell:19559:0:13"
msgid "Ugh, is there no end to them!?"
msgstr ""

#. ja: ここが正念場だ！
#. de: Gebt alles, wir haben es fast geschafft!
#. fr: C'est la dernière ligne droite<nbsp>!
msgctxt "NpcYell:19560:0:13"
msgid "And now the fight begins in earnest!"
msgstr ""

#. ja: 首領がいるということは<br>これが本隊か！
#. de: Das muss der Haupttrupp sein!
#. fr: Voilà leur chef<nbsp>! Montrez-leur que vous en avez dans le ventre<nbsp>!
msgctxt "NpcYell:19561:0:13"
msgid "Their leader has finally shown themself."
msgstr ""

#. ja: 防衛できたようだな…
#. de: Sehr gut, wir haben den Bastionskampf überstanden.
#. fr: Haaa... On a tenu bon...
msgctxt "NpcYell:19562:0:13"
msgid "It would appear the siege has ended."
msgstr ""

#. ja: サレージャは<br>いったいどこに…
#. de: Wo ist Sareel Ja nur hin<nbsp>...?
