# NpcYell
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: グハッ…
#. de: Urgh!
#. fr: Goueurgh<nbsp>!
msgctxt "NpcYell:5000:0:13"
msgid "Ugh!"
msgstr "Уф!"

#. ja: 門が突破されたのか？<br>どうやって！？
#. de: Das Tor ist offen?! Wie?!
#. fr: Comment sont-ils entrés<nbsp>!?
msgctxt "NpcYell:5001:0:13"
msgid "What in the hells!? How'd they get past the gates!?"
msgstr "Да что за чертовщина!? Как они миновали ворота!?"

#. ja: て、敵襲だッ！
#. de: Ein Überfall!
#. fr: On... on nous attaque<nbsp>!
msgctxt "NpcYell:5002:0:13"
msgid "We're under attack!"
msgstr "На нас напали!"

#. ja: ゆくぞ！<br>自由のために！
#. de: Weiter! Für die Freiheit!
#. fr: La liberté ou la mort<nbsp>!
msgctxt "NpcYell:5003:0:13"
msgid "Liberty or death!"
msgstr "Свобода или смерть!"

#. ja: ここは我らに<br>お任せを！
#. de: Überlasst diesen Abschnitt uns!
#. fr: Laissez-nous nous occuper d'eux<nbsp>!
msgctxt "NpcYell:5004:0:13"
msgid "We'll deal with this lot!"
msgstr "С этой шайкой мы сами разберёмся!"

#. ja: さあ、先に<br>進んでください！
#. de: Lauft weiter!
#. fr: En avant toute<nbsp>!
msgctxt "NpcYell:5005:0:13"
msgid "Forward! Forward!"
msgstr "Вперёд! Вперёд!"

#. ja: うおおおッ！
#. de: Uooh!
#. fr: Groooh<nbsp>!
msgctxt "NpcYell:5006:0:13"
msgid "Graaagh!"
msgstr "А-а-а!"

#. ja: な、なぜ敵軍が…<br>こんなところに！
#. de: Huch! Eindringlinge!
#. fr: Les résistants<nbsp>!? Ici<nbsp>!?
msgctxt "NpcYell:5007:0:13"
msgid "The Resistance!? Here!?"
msgstr "Сопротивление!? Здесь!?"

#. ja: げ、迎撃だ！<br>とにかく迎撃だァ！
#. de: Haltet sie auf! Haltet sie auf!
#. fr: Sortez vos armes<nbsp>! Repoussez-les<nbsp>!
msgctxt "NpcYell:5008:0:13"
msgid "Weapons! Drive them back!"
msgstr "К оружию! Отбросьте их!"

#. ja: 壊神の守護あれ！
#. de: Rhalgr ist mit uns!
#. fr: Ô Rhalgr, protège-moi<nbsp>!
msgctxt "NpcYell:5009:0:13"
msgid "Rhalgr grant me strength!"
msgstr "Ралгр, дай мне сил!"

#. ja: 積年の恨みを<br>晴らしてやるッ！
#. de: Nun werdet ihr büßen!
#. fr: Vous allez payer pour tous vos crimes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5010:0:13"
msgid "Remember the towers!<br>Remember the Reach!"
msgstr "Вспомните башни!<br>Вспомните Предел!"

#. ja: 突破させるわけには！
#. de: Pah! Euch Wilden zeigen wir's!
#. fr: Ne les laissez pas passer<nbsp>!
msgctxt "NpcYell:5011:0:13"
msgid "Let none escape!"
msgstr "Никого не выпускать!"

#. ja: 守り切るぞ！
#. de: Verteidigt die Stadt!
#. fr: Tenez vos positions<nbsp>!
msgctxt "NpcYell:5012:0:13"
msgid "Stand your ground!"
msgstr "Стоять насмерть!"

#. ja: 私が…<br>私が勝者となるッ！
#. de: Euch werd ich's zeigen!
#. fr: Je vaincrai<nbsp>!
msgctxt "NpcYell:5013:0:13"
msgid "You'll pay for this!"
msgstr "Вы за это заплатите!"

#. ja: 斬り刻むッ！
#. de: Ich schlitz euch auf!
#. fr: Je vais vous mettre en pièces<nbsp>!
msgctxt "NpcYell:5014:0:13"
msgid "I'll cut you to pieces!"
msgstr "Я вас на куски изрублю!"

#. ja: ま、負けるわけには…
#. de: Verrecken sollt ihr!
#. fr: Je ne peux pas tomber ainsi...
msgctxt "NpcYell:5015:0:13"
msgid "How...? How could I lose...?"
msgstr "Как?.. Как я мог проиграть?.."

#. ja: 蛮族どもを<br>根絶やしにしろッ！
#. de: Geben wir es diesen Wilden!
#. fr: Saloperies de sauvages<nbsp>!
msgctxt "NpcYell:5016:0:13"
msgid "Bloody savages!"
msgstr "Проклятые дикари!"

#. ja: フォルドラ様！
#. de: Kommandantin Fordola!
#. fr: Protégez la commandante<nbsp>!
msgctxt "NpcYell:5017:0:13"
msgid "Defend the commander!"
msgstr "Защитите командующую!"

#. ja: ぐあッ…！
#. de: Ahrg!
#. fr: Aaarrgh<nbsp>!
msgctxt "NpcYell:5019:0:13"
msgid "Urrrgh!"
msgstr "А-а-ах!"

#. ja: ぐっ…汚い…マネを…
#. de: Gnh ... Was ist das für ein schmutziger ... Trick?!
#. fr: Bande de lâches<nbsp>!
msgctxt "NpcYell:5020:0:13"
msgid "Damn you and your tricks!"
msgstr "Чтоб вас! Ваши грязные уловки!"

#. ja: 紫水宮ヲ<br>守ルノダ！
#. de: Verteidigt den Palast!
#. fr: Défendez le palais<nbsp>!
msgctxt "NpcYell:5021:0:13"
msgid "Defend the palace!"
msgstr "Защитите дворец!"

#. ja: ウガガガガ…<br>斬ル斬ル斬ル
#. de: Töten ... töten ... töten!
#. fr: Tuer... Tuer... Tuer...
msgctxt "NpcYell:5022:0:13"
msgid "Kill...kill...kill..."
msgstr "Убить... убить... убить..."

#. ja: 嫌アアァァァ…<br>頭ノ中ニ入ラナイデ！
#. de: Nein! Raus aus meinem Kopf!
#. fr: Nooon<nbsp>!<nbsp>... Sortez de ma tête<nbsp>! Laissez-moi<nbsp>!
msgctxt "NpcYell:5023:0:13"
msgid "Nooo! Begone! Leave my mind be!"
msgstr "Не-е-ет! Прочь! Оставьте мой разум в покое!"

#. ja: アアア…<br>紫水妖妃ノ為…
#. de: Aaah! Das ist für Shisui Yohi!
#. fr: Aaah<nbsp>! C'est Shisui Yohi<nbsp>!
msgctxt "NpcYell:5024:0:13"
msgid "Aaah! For the Shisui Yohi!"
msgstr "А-а-а! За Сисуй Ёхи!"

#. ja: モウ俺ハ…<br>アガガガガガ…
#. de: Bin ich ...? Argh ...
#. fr: Je... Je suis...<nbsp>? Aaargh...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5025:0:13"
msgid "I... Have I been...defeat─?<br>Argh..."
msgstr "Я... Неужто меня... одолели?<br>А-а-рг..."

#. ja: 誰ダ誰ダ誰ダ誰ダ！？
#. de: Eindringlinge ... Eindringlinge<nbsp>... Eindringlinge<nbsp>...
#. fr: Des intrus... Des intrus...
msgctxt "NpcYell:5026:0:13"
msgid "Intruders...intruders...intruders..."
msgstr "Незваные гости... незваные гости... незваные гости..."

#. ja: 怪力の合成生物です！<br>気をつけて…
#. de: Eine Chimäre! Und eine ziemlich große dazu!
#. fr: Une créature chimérique<nbsp>! Attention<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5027:0:13"
msgid "Gods, a chimera!<br>A very <i>large</i> chimera!"
msgstr "Боги, химера!<br>Да ещё какая <i>огромная</i>!"

#. ja: あと、ひと息です！<br>ご武運を…
#. de: Bald ist es geschafft!
#. fr: On y est presque<nbsp>! Encore un peu...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5028:0:13"
msgid "This fight is yours!<br>You've all but won!"
msgstr "Эта битва у вас в руках!<br>Победа почти ваша!"

#. ja: 道をあけぃ！
#. de: Aus dem Weeeeg!
#. fr: Hors de mon chemin<nbsp>!
msgctxt "NpcYell:5029:0:13"
msgid "Out of my way!"
msgstr "С дороги!"

#. ja: 燃える、最高だ！
#. de: Ah, wie meine Seele brennt!
#. fr: Quelle excitation<nbsp>!
msgctxt "NpcYell:5030:0:13"
msgid "How it burns!"
msgstr "Как же жжёт!"

#. ja: すみやかに散れ…！
#. de: Flieh oder stirb!
#. fr: Disparaissez<nbsp>!
msgctxt "NpcYell:5031:0:13"
msgid "Let us be about it!"
msgstr "Пора с этим покончить!"

#. ja: 甲羅ナシども！<br>出てこいやァー！
#. de: So, ihr Weichhäute, heute geht's euch an den Kragen!
#. fr: Vous allez souffrir, humains<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <if ($gn11 < 12)><if ($gn11 < 4)>Tonight<else>Today</if><else><if ($gn11 < 17)>Today<else>Tonight</if></if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 12 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gn11 < 4)>Tonight<else>Today</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 4 (condition: may be reworded, restructured, added, or dropped)
#. macro: <if ($gn11 < 17)>Today<else>Tonight</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 11 < 17 (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:5032:0:13"
msgid "Out of your beds, soft ones!<br><if ($gn11 < 12)><if ($gn11 < 4)>Tonight<else>Today</if><else><if ($gn11 < 17)>Today<else>Tonight</if></if>, you perish by my blade!"
msgstr "Вылезайте из постелей, неженки!<br><if ($gn11 < 12)><if ($gn11 < 4)>Сегодня ночью<else>Сегодня</if><else><if ($gn11 < 17)>Сегодня<else>Сегодня ночью</if></if> вы падёте от моего клинка!"

#. ja: なんだ！？<br>亀女め、何用だ！
#. de: Was ist das? Ein weiblicher Rotpanzer?!
#. fr: Qu'est-ce que tu veux, Kojin<nbsp>?
msgctxt "NpcYell:5033:0:13"
msgid "You 'ear somefin, lads?"
msgstr "Слыхали чего, ребята?"

#. ja: 貴様らの宝<br>もらい受けにきたァー！
#. de: Gebt uns all eure Schätze, dann verschonen wir euch!
#. fr: Vos trésors, évidemment<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5034:0:13"
msgid "Hand over your treasures now<br>and I'll make certain the cut<br>is clean and your deaths quick."
msgstr "Отдайте сокровища!<br>И я позабочусь, чтобы всё прошло чисто,<br>а смерть была быстрой."

#. ja: 亀の分際で<br>ふざけたことを！
#. de: Pah, vor euch Kröten haben wir keine Angst!
#. fr: C'est ce qu'on va voir...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5035:0:13"
msgid "There it was again. Like me<br>da on the privy after a<br>plate o' dragon peppers!"
msgstr "И опять! Прямо как меня<br>после острого драконьего перца<br>в клозет несёт!"

#. ja: いけ、お前たちィー！<br>奪いつくせェー！
#. de: Zum Angriff! Tötet sie alle!
#. fr: Raaah<nbsp>! Vous allez tous mourir<nbsp>!
msgctxt "NpcYell:5036:0:13"
msgid "Graaah! Die! All of you!"
msgstr "А-а-а! Сдохните! Все до единого!"

#. ja: ヌラァー！
#. de: Uaaarrr!
#. fr: Hmph<nbsp>!
msgctxt "NpcYell:5037:0:13"
msgid "Hmph!"
msgstr "Хм!"

#. ja: 宝をよこしなァー！
#. de: Her mit euren Schätzen!
#. fr: Vos trésors sont à moi, ha ha ha<nbsp>!
msgctxt "NpcYell:5038:0:13"
msgid "Your treasures are mine!"
msgstr "Ваши сокровища теперь мои!"

#. ja: クソッタレ！<br>数が多い！
#. de: Verdammt, sind das viele.
#. fr: Combien sont-ils, bon sang<nbsp>!
msgctxt "NpcYell:5039:0:13"
msgid "There be no end to 'em!"
msgstr "Им конца-краю нет!"

#. ja: 海賊衆の<br>意地を見ろ！
#. de: Haltet stand, Genossen!
#. fr: C'est pas le moment de fléchir, camarades<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5040:0:13"
msgid "Never look back!<br>Never surrender!"
msgstr "Не оглядываться!<br>Не сдаваться!"

#. ja: 第二陣前ェー！<br>攻め時だァー！
#. de: Zweite Reihe, zum Angriff!
#. fr: Deuxième ligne, en avant<nbsp>!
msgctxt "NpcYell:5041:0:13"
msgid "Second line! Advance!"
msgstr "Вторая линия! Вперёд!"

#. ja: 第三陣進めェー！<br>背後を突けェー！
#. de: Dritte Reihe, nehmt sie in die Zange!
#. fr: Troisième ligne, prenez les à revers<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5042:0:13"
msgid "Third line! Take them<br>from the rear!"
msgstr "Третья линия!<br>Зайдите им в тыл!"

#. ja: どうにか押し返せたな…<br>助力に感謝するぜ！
#. de: Die legen sich so schnell nicht mehr mit der Konföderation an!
#. fr: Ça leur apprendra à défier la Confédération<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5043:0:13"
msgid "That'll learn 'em to<br>cross the Confederacy!"
msgstr "Вот и научатся не связываться<br>с Конфедерацией!"

#. ja: クソッタレ！<br>退け、退けっ！
#. de: Heute geben wir uns geschlagen, aber wir kommen zurück.
#. fr: Grrr... Vous vous en sortez pour cette fois, mais je reviendrai<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5044:0:13"
msgid "The day is yours...but<br>mark my word, we <i>will</i> return."
msgstr "Сегодня победа за вами... но<br>запомните мои слова: мы <i>вернёмся</i>."

#. ja: 宝は奪ったァー！<br>引き上げるよォー！
#. de: Wir haben die Schätze. Los, ab nach Hause!
#. fr: Et voilà, vos trésors sont à moi désormais<nbsp>!
msgctxt "NpcYell:5045:0:13"
msgid "Mine! It's all mine!"
msgstr "Моё! Всё моё!"

#. ja: ようやく実った作物<br>渡すものか！
#. de: Pfoten von meiner Ernte!
#. fr: Vous n'aurez pas mes navets<nbsp>!
msgctxt "NpcYell:5046:0:13"
msgid "You'll not have my turnips!"
msgstr "Мои репки вам не достанутся!"

#. ja: 帰れ、ネズミども！
#. de: Verschwindet, ihr elenden Ratten!
#. fr: Retournez du trou d'où vous venez, sales pilleurs<nbsp>!
msgctxt "NpcYell:5047:0:13"
msgid "Away! Away with you!"
msgstr "Прочь! Убирайтесь!"

#. ja: 腹ぺこっちゃ！
#. de: Leckerli schnappen!
#. fr: Qiqirn avoir faim<nbsp>! Qiqirn aider à récolter<nbsp>!
msgctxt "NpcYell:5048:0:13"
msgid "Grab the tasties!"
msgstr "Хватайте вкусненькое!"

#. ja: お野菜<br>モグモグっちゃ！
#. de: Toffeln und Rüben, wir sie lieben!
#. fr: Miam miam<nbsp>! Par ici<nbsp>! Qiqirn sentir légumes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5049:0:13"
msgid "Turnips and beets,<br>oh, so sweet!"
msgstr "Репа и свёкла,<br>вот это сладость!"

#. ja: お肉も<br>モグモグっちゃ！
#. de: Herzen und Lebern, auch gern knabbern!
#. fr: Miam miam<nbsp>! Par ici<nbsp>! Qiqirn sentir viande fraîche<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5050:0:13"
msgid "Hearts and livers,<br>send me shivers!"
msgstr "Сердца и печёнки,<br>аж мурашки по коже!"

#. ja: 食べてやるっちゃ！
#. de: Essen! Essen!
#. fr: Qiqirns faire miam miam ici<nbsp>!
msgctxt "NpcYell:5053:0:13"
msgid "Eat! Eat!"
msgstr "Ешь! Ешь!"

#. ja: 全部食べるっちゃ！
#. de: Alles essen!
#. fr: Qiqirns croquer toutes les pousses<nbsp>!
msgctxt "NpcYell:5054:0:13"
msgid "Eat! Eat!"
msgstr "Всё съесть!"

#. ja: 帰るっちゃ…
#. de: Essen? Essen?
#. fr: Qiqirns rentrer sans miam miam...<nbsp>?
msgctxt "NpcYell:5056:0:13"
msgid "Eat? Eat...?"
msgstr "Есть? Есть?.."

#. ja: 逃げるっちゃ…
#. de: Fleisch? Fleisch?
#. fr: Qiqirns fuir<nbsp>?
msgctxt "NpcYell:5057:0:13"
msgid "Meat? Meat...?"
msgstr "Мясо? Мясо?.."

#. ja: 腹ぺこっちゃ…
#. de: Hunger! Hunger!
#. fr: Qiqirn avoir encore faim...
msgctxt "NpcYell:5058:0:13"
msgid "Retreat! Retreat!"
msgstr "Отступление! Отступление!"

#. ja: 忌まわしい季節が<br>やってきたな…
#. de: \<schnief> ... \<schnief> ...<br>Es ist ... wieder so weit ... \<hust>
#. fr: (renifle) Cette saison atroce est de retour... (tousse) (tousse)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5060:0:13"
msgid "\\<sniff> \\<sniff><br>The season... It is upon us... \\<cough>"
msgstr "\\<sniff> \\<sniff><br>Опять этот... мерзкий сезон... \\<cough>"

#. ja: いやはや、お見事！<br>実戦経験豊富な下士官たちでも相手にならないとは！
#. de: Was für ein Spektakel! Selbst meine Offiziere waren chancenlos!
#. fr: Bravo, quelle dé<shy>mon<shy>stra<shy>tion<nbsp>! Même nos sous-officiers n'étaient vraiment pas de taille.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5062:0:13"
msgid "Hah hah hah!<br>You've shown those officers why we still call them <i>petty</i>!"
msgstr "Ха-ха-ха!<br>Вот и показали вы офицерам, почему их зовут <i>младшими</i>!"

#. ja: ですが、模擬戦を見ていたら、血が騒ぎましてな……。<br>ここはひとつ、我々のお相手もお願いできますかな？
#. de: Da hab ich richtig Lust bekommen, selbst zur Waffe zu greifen. Gewährst du mir die Ehre eines weiteren Kampfes?
#. fr: Que diriez-vous de vous exercer avec nous maintenant<nbsp>? Ça ne sera pas aussi facile.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5063:0:13"
msgid "But they are <i>my</i> officers, and I wouldn't be their commander if I didn't defend their honor to the last."
msgstr "Но ведь это <i>мои</i> офицеры! Не будь я их командиром, если не защищу их честь до последнего."

#. ja: さあ、いきますぞ！<br>総員抜刀……模擬戦開始ぃぃぃぃっ！！！
#. de: Zu den Säbeln! Die Übung beginnt!
#. fr: Tout le monde est prêt<nbsp>? En garde<nbsp>!
msgctxt "NpcYell:5064:0:13"
msgid "To arms, men! Let us show them what for!"
msgstr "К оружию, бойцы! Покажем им, на что мы способны!"

#. ja: よっこらぺ♪<br>今日も大漁っぺよ♪
#. de: ♪ Die Körbe voller Fffische, da biegen sich die Tische ♪
#. fr: Le poissoooon, c'est si boooon<nbsp>!♪ Je rentre à la maisoooon, avec du poisson à foisoooon<nbsp>!♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5065:0:13"
msgid "A basket full!<br>A full basket!"
msgstr "Полная корзина!<br>Корзина полнёхонька!"

#. ja: ぺぺぺぺぺっ！<br>またコジャが来たっぺよ！
#. de: \<spotz>! Schon wieder diese Störenfffriede!
#. fr: Aaah<nbsp>! Ils sont là pour mon poisson<nbsp>!
msgctxt "NpcYell:5066:0:13"
msgid "The k-k-k-koja!"
msgstr "К-к-к-коя!"

#. ja: 懲らしめてやって<br>ほしいっぺな！
#. de: Denen gehört das Fffell über die Ohren gezogen!
#. fr: Mets-leur une bonne raclée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5067:0:13"
msgid "Take them away!<br>Take them far, far away!"
msgstr "Прогоните их!<br>Подальше, подальше прогоните!"

#. ja: 目からナマズ汁が…<br>うっ、うっ、うっ…
#. de: Buäh ... Ich armer, armer Tropfff ...
#. fr: NooOOoon<nbsp>! Mon poissooooon<nbsp>! Tout est à refaire... Je n'ai plus qu'à aller en repêcher...
msgctxt "NpcYell:5068:0:13"
msgid "My fish... My tasty, tasty fish..."
msgstr "Моя рыбка... Моя вкусная-вкусная рыбка..."

#. ja: うっぺっぺっ♪<br>コジャが逃げてくっぺよ！
#. de: Hehe, die fffrechen Fratzen sind weg.
#. fr: Les koja ont jeté l'éponge<nbsp>! Youpi<nbsp>!♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5069:0:13"
msgid "Gone, gone, gone!<br>The koja have all gone!♪"
msgstr "Ушли, ушли, ушли!<br>Все коя ушли!♪"

#. ja: これで今日こそ、がんばって獲ったお魚を、<br>みんなのところに、持って帰れそうっぺな！
#. de: Jetzt kann ich meinen Fang nach Hause bringen.
#. fr: Pour la première fois depuis longtemps, je vais rentrer avec la totalité de ma pêche<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5070:0:13"
msgid "They tried to harry me<br>But now I'm going home♪"
msgstr "Меня хотели прогнать,<br>но теперь я домой иду♪"

#. ja: 助けてくれて、ありがとっぺよ♪<br>さあさあ、思う存分、褒め褒めするっぺ…………
#. de: Danke für deine Hilfffe ... \<spotz>!
#. fr: Merci beaucoup, <if $gn4>voyageuse<else>voyageur</if><nbsp>! Tu es prêt<if $gn4>e</if> à être noyé<if $gn4>e</if> sous mes louanges<nbsp>? C'est part...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5071:0:13"
msgid "With fish in my basket and<br>a heart filled with song!♪"
msgstr "Корзина с рыбой, а в сердце песня!♪"

#. ja: おーい<br>手伝っておくれよ！
#. de: He, du! Ja, du, komm mal her!
#. fr: Hé<nbsp>! Toi, là<nbsp>! File-moi un coup de main<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5072:0:13"
msgid "You there! Yeah you,<br>the ugly one!"
msgstr "Эй, ты! Да, ты!<br>Уродина, помоги-ка!"

#. ja: 珊瑚を集めて<br>一儲けしたいのさ
#. de: Ich hab hier 'nen Gilbeutel mit deinem Namen drauf.
#. fr: Je cherche des morceaux de corail intacts pour me remplir les poches.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5073:0:13"
msgid "I've a sack o' coin here<br>with yer name on it!"
msgstr "Тут целый мешок гилов,<br>и твоё имя на нём!"

#. ja: 綺麗な珊瑚を<br>どんどん集めておくれ！
#. de: Nur die schönen, hast du gehört? Die hässlichen kann ich nicht gebrauchen!
#. fr: À moi les beaux morceaux de corail, hé hé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5074:0:13"
msgid "None o' them unsightly knobs,<br>now. Only the beauteous ones."
msgstr "Только красивый коралл, слышишь?<br>Никаких уродливых наростов!"

#. ja: これで一儲けできそうだ<br>嬉しいね～
#. de: Für heute habe ich genug. Besten Dank!
#. fr: Super, avec ça je vais me faire un max de gils<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5075:0:13"
msgid "I's thinkin' I have<br>more'n enough...thanks to ye."
msgstr "Думаю, с меня хватит...<br>Спасибо тебе."

#. ja: これじゃあ、儲けも<br>期待できないね…
#. de: So ein Mist! Traue keinem Abenteurer, hat schon meine Mutter immer gesagt!
#. fr: Tu aurais pu faire un effort, j'en ai à peine assez pour me payer à manger ce soir...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5076:0:13"
msgid "Bleedin' blighted bollocks!<br>That'll learn me to trust a<br>'venturer."
msgstr "Чтоб всё провалилось!<br>Вот и доверяй после этого<br>авантюристам..."

#. ja: ほう、なかなか<br>熱い模擬戦だ
#. de: Geht ganz schön heiß her für 'ne Übung!
#. fr: Ah, voilà un en<shy>traî<shy>ne<shy>ment acharné comme je les aime.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <if $gn4>she's<else>he's</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:5078:0:13"
msgid "Impressive. You say<br><if $gn4>she's<else>he's</if> an adventurer?"
msgstr "Впечатляет. Так он, говоришь,<br>авантюрист?"

#. ja: ひっく…ひっく…
#. de: \<schnief> ... \<schnüf>
#. fr: (snif)... (snif)...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5087:0:13"
msgid "\\<sob> \\<sob><br>\\<sniffle> \\<sniffle>"
msgstr "\\<sob> \\<sob><br>\\<sniffle> \\<sniffle>"

#. ja: 怖いよぉ…
#. de: W-Wie schrecklich ...
#. fr: J-j'ai peur...
msgctxt "NpcYell:5088:0:13"
msgid "I want my da!"
msgstr "Хочу к папе!"

#. ja: そろそろ帰ると<br>しようかね～
#. de: Für heute reicht es mir.
#. fr: Bon, il commence à se faire tard...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5089:0:13"
msgid "High time I headed back,<br>I reckon."
msgstr "Пора бы мне уже домой,<br>пожалуй."

#. ja: ありがと、冒険者さん<br>もう家に帰るよ…
#. de: Vielen Dank! Jetzt aber schnell nach Hause!
#. fr: Merci, <if $gn4>Madame l'aventurière<else>Monsieur l'aventurier</if>. Je vais rentrer chez moi maintenant, promis...
#. macro: <if $gn4>milady<else>milord</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5098:0:13"
msgid "Thank you kindly, <if $gn4>milady<else>milord</if>.<br>I'll learn the plow, just like<br>my da wanted. Promise!"
msgstr "Спасибо, <if $gn4>госпожа<else>господин</if>.<br>Научусь пахать, как отец и хотел.<br>Обещаю!"

#. ja: Zzz…
#. de: \<schnarch>
#. fr: Zzzzz...
msgctxt "NpcYell:5099:0:13"
msgid "\\<snore>"
msgstr "\\<snore>"

#. ja: 赤誠組か！？<br>違うだと！
#. de: Halt! Nennt eure Namen!
#. fr: Qui va là<nbsp>!?
msgctxt "NpcYell:5100:0:13"
msgid "Who goes there!?"
msgstr "Кто идёт!?"

#. ja: 討ち入りか！<br>排除するまでだ！
#. de: Eindringlinge!
#. fr: Des intrus<nbsp>! Comment sont-ils entrés<nbsp>!?
msgctxt "NpcYell:5101:0:13"
msgid "Intruders!? How did they get in!?"
msgstr "Налётчики!? Как они сюда проникли!?"

#. ja: 何者かは知らぬが<br>斬り捨てる！
#. de: Haltet sie auf!
#. fr: Arrêtez-les<nbsp>!
msgctxt "NpcYell:5102:0:13"
msgid "Stop them!"
msgstr "Остановите их!"

#. ja: 異人めが！
#. de: Ihr verfluchten Fremden!
#. fr: Maudits <i>ijin</i><nbsp>!
msgctxt "NpcYell:5103:0:13"
msgid "Ijin scum!"
msgstr "Проклятые иджины!"

#. ja: 斬り捨てる！
#. de: Ihr seid des Todes!
#. fr: Vous avez signé votre arrêt de mort<nbsp>!
msgctxt "NpcYell:5104:0:13"
msgid "Your lives are forfeit!"
msgstr "Вам не уйти живыми!"

#. ja: ここは通さんぞ！
#. de: Hier kommt ihr nicht weiter!
#. fr: Vous ne passerez pas<nbsp>!
msgctxt "NpcYell:5105:0:13"
msgid "We cannot let them pass!"
msgstr "Дальше не пройдёте!"

#. ja: かかったな！
#. de: 0
#. fr: 0
msgctxt "NpcYell:5106:0:13"
msgid "0"
msgstr "0"

#. ja: 袋のネズミよ…
#. de: 0
#. fr: 0
msgctxt "NpcYell:5107:0:13"
msgid "0"
msgstr "0"

#. ja: 殺るぞッ！
#. de: 0
#. fr: 0
msgctxt "NpcYell:5108:0:13"
msgid "0"
msgstr "0"

#. ja: うむ…<br>異常なし…
#. de: Es ist mir zu still hier ...
#. fr: Tout est calme... Un peu <i>trop</i> calme.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5109:0:13"
msgid "It's quiet... <i>Too</i> quiet..."
msgstr "Тихо... <i>Слишком</i> тихо..."

#. ja: 警戒を怠るな！
#. de: Bleibt wachsam!
#. fr: Restez vigilants<nbsp>!
msgctxt "NpcYell:5110:0:13"
msgid "Stay sharp!"
msgstr "Будьте начеку!"

#. ja: なに？<br>カゲヤマ様が…？
#. de: Hm? Kam das eben von Herrn Kageyama?
#. fr: Quel était ce bruit<nbsp>!?
msgctxt "NpcYell:5111:0:13"
msgid "Did you hear that...?"
msgstr "Слышали?.."

#. ja: ここで止める！
#. de: Keinen Schritt weiter!
#. fr: Vous n'irez pas plus loin<nbsp>!
msgctxt "NpcYell:5112:0:13"
msgid "Your meddling ends here!"
msgstr "Здесь вам не пройти!"

#. ja: 口寄せの術！
#. de: \<flüster>
#. fr: Kuchiyose-no-jutsu<nbsp>!
msgctxt "NpcYell:5113:0:13"
msgid "Kuchiyose no jutsu!"
msgstr "Кутиёсе-но дзюцу!"

#. ja: ゆくぞ！
#. de: Auf sie!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:5114:0:13"
msgid "This will stop them!"
msgstr "Это их остановит!"

#. ja: 出合え、出合え！
#. de: Eindringlinge! Lasst sie nicht durch!
#. fr: Des intrus<nbsp>! Des intrus<nbsp>!
msgctxt "NpcYell:5115:0:13"
msgid "Intruders! Intruders!"
msgstr "Незваные гости! Незваные гости!"

#. ja: 海向こうの者め！
#. de: Zurück übers Meer mit euch!
#. fr: Maudits soient les <i>ijin</i><nbsp>!
msgctxt "NpcYell:5116:0:13"
msgid "Ijin! Ijin!"
msgstr "Иджины! Иджины!"

#. ja: カカカカカカッ！
#. de: Harharhar!
#. fr: Hahaha<nbsp>!
msgctxt "NpcYell:5117:0:13"
msgid "Caw! Caw! Caw!"
msgstr "Кар-кар-кар!"

#. ja: 袋だたきだ！
#. de: Befreit Kugane von den Fremden!
#. fr: Pas de pitié<nbsp>!
msgctxt "NpcYell:5118:0:13"
msgid "Kill the ijin!"
msgstr "Убить иджинов!"

#. ja: 滅殺！
#. de: Bringt sie um!
#. fr: À mort<nbsp>! À mort<nbsp>!
msgctxt "NpcYell:5119:0:13"
msgid "Die! Die! Die!"
msgstr "Умрите! Умрите! Умрите!"

#. ja: 潰す！
#. de: Ihr seid des Todes!
#. fr: Je vais vous tuer<nbsp>!
msgctxt "NpcYell:5120:0:13"
msgid "Kill! Kill! Kill!"
msgstr "Убить! Убить! Убить!"

#. ja: ハラキリハラキリ…
#. de: Be-reit zum Ha-ra-ki-ri \<klack>
#. fr: Hara-kiri... Harakiri...
msgctxt "NpcYell:5121:0:13"
msgid "Self-destruct sequence initiated..."
msgstr "Запущена последовательность самоуничтожения..."

#. ja: なんだ！？
#. de: Was war das?
#. fr: C'était quoi ce bruit<nbsp>!?
msgctxt "NpcYell:5122:0:13"
msgid "What was that!?"
msgstr "Что это было!?"

#. ja: て、帝国軍の<br>魔導兵器か？
#. de: Ist das ... von den Garlearn?
#. fr: C'est une arme magitek<nbsp>?
msgctxt "NpcYell:5128:0:13"
msgid "Is this...Garlean?"
msgstr "Это... гарлеанское?"

#. ja: うーむ…
#. de: Keine Ahnung ...
#. fr: Je pense bien.
msgctxt "NpcYell:5129:0:13"
msgid "What else could it be?"
msgstr "А что ещё это может быть?"

#. ja: 見たところ…<br>壊れているようだが…
#. de: Was auch immer, es scheint kaputt zu sein.
#. fr: On dirait qu'elle a vu de meilleurs jours.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5130:0:13"
msgid "Whatever it is, it appears<br>to be in ill repair."
msgstr "Что бы это ни было, оно, похоже,<br>исправно лишь на вид."

#. ja: 確認しておくか？
#. de: Sollen wir das mal unter die Lupe nehmen?
#. fr: On jette un œil, au cas où<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5131:0:13"
msgid "Do you think it safe<br>to approach?"
msgstr "Как думаешь, безопасно<br>подойти поближе?"

#. ja: おい！<br>不用意に触るな！
#. de: Bist du verrückt? Das Ding könnte mit Fallen gespickt sein!
#. fr: Hé<nbsp>! Touche pas à n'importe quoi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5132:0:13"
msgid "Absolutely not! Gods know<br>what manner of traps the<br>enemy planted upon it!"
msgstr "Ни в коем случае! Кто знает,<br>какие ловушки враг тут устроил!"

#. ja: どうなってるんだ？
#. de: Aber vielleicht kann man noch was davon gebrauchen.
#. fr: On doit pouvoir trouver deux ou trois morceaux en état de marche. Ça pourrait servir.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5133:0:13"
msgid "But perhaps there are<br>parts worth salvaging."
msgstr "Но, может, удастся спасти<br>какие-нибудь детали."

#. ja: いったん戻って<br>上に報告を…
#. de: Wir sollten das erst mal im Lager melden.
#. fr: On... devrait peut-être d'abord rentrer à la base faire un rapport, non<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5134:0:13"
msgid "That can wait. We must<br>first report this to camp."
msgstr "Потом разберёмся. Сначала<br>надо доложить об этом в лагере."

#. ja: 帰還するぞ！
#. de: Los, lasst uns zurückkehren!
#. fr: Il a raison. Viens<nbsp>! On part d'ici<nbsp>!
msgctxt "NpcYell:5135:0:13"
msgid "Come on. We march."
msgstr "Ну же, идём."

#. ja: 了解…
#. de: Na gut ...
#. fr: OK, OK...
msgctxt "NpcYell:5136:0:13"
msgid "Aye aye..."
msgstr "Так точно..."

#. ja: ん？<br>これはなんだ？
#. de: He, guckt euch das mal an!
#. fr: Tiens<nbsp>? C'est quoi ce bitoniau<nbsp>?
msgctxt "NpcYell:5137:0:13"
msgid "Wait! Look at this!"
msgstr "Погодите! Гляньте-ка!"

#. ja: えっ？<br>…なになに！？
#. de: Ist das ein Schalter?
#. fr: Ah bah<nbsp>!? V'là qu'il brille maintenant<nbsp>!
msgctxt "NpcYell:5138:0:13"
msgid "I told you. We mar─"
msgstr "Я же говорил. Мы идё─"

#. ja: う、動き出したぞ！
#. de: E-Es lebt!
#. fr: I-il a bougé<nbsp>!
msgctxt "NpcYell:5139:0:13"
msgid "It's... It's alive!"
msgstr "Оно... Оно живое!"

#. ja: クソッ…<br>嫌な予感がしたんだ！
#. de: Rhalgr steh uns bei! Was hast du bloß getan?
#. fr: Bordel<nbsp>! Je savais bien qu'on aurait dû laisser ce machin tranquille<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5140:0:13"
msgid "Rhalgr take us all! What in<br>the seven hells did you do!?"
msgstr "Ралгр, спаси нас! Да что, во имя<br>семи преисподних, ты натворил?!"

#. ja: 無人機だとでも！？
#. de: N-Nichts. Ich hab nur ...
#. fr: C'est un genre de drone magitek<nbsp>!?
msgctxt "NpcYell:5141:0:13"
msgid "N-Nothing! I just... I just..."
msgstr "Н-ничего! Я просто... просто..."

#. ja: ヒィ！
#. de: H-Hilfe!
#. fr: Aaaah<nbsp>! À l'aide<nbsp>!
msgctxt "NpcYell:5142:0:13"
msgid "Ulp!"
msgstr "А-а-а!"

#. ja: 逃げろ！<br>撤退するんだ！
#. de: Du hast nur nicht nachgedacht! I-In Deckung!
#. fr: Fuyez<nbsp>! Il faut pas faire de vieux os ici<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5143:0:13"
msgid "You just got us killed!<br>Come on! We have to<br>find cover!"
msgstr "Ты нас всех погубил!<br>Бежим! Надо найти<br>укрытие!"

#. ja: あ、あの岩場に…！
#. de: Da vorne, die Felsen!
#. fr: L-les rochers, là<nbsp>! Nous sommes sauvés<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5144:0:13"
msgid "M-M-Might I humbly suggest<br>those boulders yonder?"
msgstr "П-предлагаю спрятаться<br>за теми валунами!"

#. ja: キョクホウの話は<br>真実だったのか…！
#. de: Kyokuho hatte Recht!
#. fr: Kyokuho disait donc la vérité depuis le départ...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5145:0:13"
msgid "It was true...<br>It was all true!"
msgstr "Это правда...<br>Всё оказалось правдой!"

#. ja: お助けをー！
#. de: Zu Hilfe!
#. fr: Au secouuuurs<nbsp>!!
msgctxt "NpcYell:5146:0:13"
msgid "Kyaaaaaa! Ugyaaaaaa!"
msgstr "А-а-а-а! У-у-у-у!"

#. ja: 貴様ラヲ…<br>信ジテミヨウ…
#. de: Ich will euch glauben.
#. fr: J'ai envie de vous faire... confiance...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5147:0:13"
msgid "Trust... Forgiveness...<br>They are truly what bind us."
msgstr "Доверие... Прощение...<br>Вот что по-настоящему нас связывает."

#. ja: 私としたことが…
#. de: Uh ... Ich ... bin ...
#. fr: Je ne suis plus digne... de mon art...
msgctxt "NpcYell:5148:0:13"
msgid "What have I done...?"
msgstr "Что же я наделал?.."

#. ja: 無念…
#. de: Urks ...
#. fr: Je suis trop faible...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5149:0:13"
msgid "I should have<br>been a carpenter!"
msgstr "Надо было<br>стать плотником!"

#. ja: もうダメ…
#. de: Mich hat's erwischt ...
#. fr: C'est la fin...
msgctxt "NpcYell:5150:0:13"
msgid "Curse you, Udoku! Curse you!"
msgstr "Будь ты проклят, Удоку! Проклят!"

#. ja: コシャクナ…
#. de: Unverschämte Eindringlinge!
#. fr: Votre insolence est sans limites...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5151:0:13"
msgid "For too long have I<br>suffered the likes of man!"
msgstr "Слишком долго я<br>терпел таких, как вы, люди!"

#. ja: 滅ビ果テヨ！
#. de: Jetzt werdet ihr büßen!
#. fr: Vous allez tous périr<nbsp>!
msgctxt "NpcYell:5152:0:13"
msgid "You will pay! All of you!"
msgstr "Вы все заплатите!"

#. ja: 大丈夫か？
#. de: Haltet durch!
#. fr: Vous en faites pas, on est là<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5153:0:13"
msgid "I heard shouting.<br>Am I too late?"
msgstr "Я услышал крики.<br>Неужели опоздал?"

#. ja: 援護に感謝する！
#. de: Deine Hilfe sei dir gedankt!
#. fr: Heu<shy>reu<shy>se<shy>ment que vous étiez là<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5154:0:13"
msgid "The day would not have<br>been won without your aid."
msgstr "Без твоей помощи<br>нам бы не одержать победу."

#. ja: 熟練の冒険者の技<br>見事でした！
#. de: Du hast hervorragend gekämpft!
#. fr: Vous ne leur avez laissé aucune chance<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5155:0:13"
msgid "Never before have I<br>seen such a display!"
msgstr "Такого боя мне<br>ещё не доводилось видеть!"

#. ja: 何とか退けたな…
#. de: Es ist überstanden ...
#. fr: On est tranquilles, maintenant.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5156:0:13"
msgid "Are you certain<br>they are all dead?"
msgstr "Ты уверен, что<br>они все мертвы?"

#. ja: ！？
#. de: ...?!
#. fr: ...!?
msgctxt "NpcYell:5157:0:13"
msgid "!?"
msgstr "!?"

#. ja: ……！
#. de: ...!
#. fr: ...!
msgctxt "NpcYell:5158:0:13"
msgid "......!"
msgstr "......!"

#. ja: ！！
#. de: ...!!!
#. fr: ...!!!
msgctxt "NpcYell:5159:0:13"
msgid "!!!"
msgstr "!!!"

#. ja: ……
#. de: ...
#. fr: ...
msgctxt "NpcYell:5160:0:13"
msgid "........."
msgstr "........."

#. ja: ッ！
#. de: ...!
#. fr: ...!
msgctxt "NpcYell:5161:0:13"
msgid "\\<gasp>"
msgstr "\\<вздох>"

#. ja: ……
#. de: ...
#. fr: ...
msgctxt "NpcYell:5162:0:13"
msgid "........."
msgstr "........."

#. ja: ！！
#. de: ...!!!
#. fr: ...!!!
msgctxt "NpcYell:5163:0:13"
msgid "!!!"
msgstr "!!!"

#. ja: ……
#. de: ...
#. fr: ...
msgctxt "NpcYell:5166:0:13"
msgid "........."
msgstr "........."

#. ja: ッ……
#. de: ...
#. fr: ...
msgctxt "NpcYell:5167:0:13"
msgid "\\<sigh>"
msgstr "\\<вздох>"

#. ja: さてと<br>グリフィンの羽根は…
#. de: Der Greif hat mich böse angeblickt, garantiert!
#. fr: Ahh... Nan, y a décidément pas le compte...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5168:0:13"
msgid "Not sure I likes me<br>the look of that griffin."
msgstr "Что-то мне этот грифон<br>не нравится."

#. ja: 誰か手伝って<br>くれればいいんだが…
#. de: In Momenten wie diesen wünschte ich, ich wär auch 'n Abenteurer ...
#. fr: Si j'pouvais juste mettre la main sur quelqu'un...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5169:0:13"
msgid "Times like this, I wish I'd<br>turned adventurer..."
msgstr "Вот бы и мне стать<br>искателем приключений..."

#. ja: 羽根が集まったら<br>持って来てくれ！
#. de: Hau bloß nicht ab mit den Federn!
#. fr: Dès que t'as quelques plumes, viens me les donner<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5170:0:13"
msgid "Don't you wander too far with<br>them feathers."
msgstr "Только смотри не уходи далеко<br>с этими перьями."

#. ja: まだ羽根があるなら<br>受け取るよ！
#. de: Falls du noch Federn hast, kauf ich sie dir ab!
#. fr: Si t'as encore des plumes, j'suis preneur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5171:0:13"
msgid "I've still coin, if you've<br>still feathers!"
msgstr "Если у тебя ещё остались перья,<br>у меня монеты найдутся!"

#. ja: 危険はないか…？
#. de: Sieht sauber aus.
#. fr: Tout a l'air calme...
msgctxt "NpcYell:5172:0:13"
msgid "Something feels off..."
msgstr "Что-то тут неладно..."

#. ja: しっかりと<br>見回らないと…
#. de: Der Feind kann überall lauern.
#. fr: Restons sur nos gardes.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5173:0:13"
msgid "Look behind every bush,<br>every rock, every stable."
msgstr "Загляните за каждый куст,<br>каждый камень, каждый хлев."

#. ja: しっかり確認しよう
#. de: Wir müssen jeden Stein umdrehen.
#. fr: Bien vérifier le moindre recoin...
msgctxt "NpcYell:5174:0:13"
msgid "Did you hear something?"
msgstr "Ты что-нибудь слышал?"

#. ja: 巡回も<br>気が抜けない…
#. de: Keine Müdigkeit vorschützen!
#. fr: Patrouiller, c'est tout un art<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5175:0:13"
msgid "Even the slightest rustle of<br>the leaves could be an enemy<br>in waiting."
msgstr "Даже малейший шелест листвы<br>может означать, что враг<br>поджидает за углом."

#. ja: この辺りは<br>大丈夫か？
#. de: Weitersuchen.
#. fr: Rien à signaler par ici<nbsp>?
msgctxt "NpcYell:5176:0:13"
msgid "Did you check over there?"
msgstr "Ты там проверил?"

#. ja: そこだ！
#. de: Nimm dies!
#. fr: Là<nbsp>!
msgctxt "NpcYell:5177:0:13"
msgid "I have you now!"
msgstr "Попался!"

#. ja: 手強い…！
#. de: Ziemlich stark ...
#. fr: Mange ça<nbsp>!
msgctxt "NpcYell:5178:0:13"
msgid "Ungh...!"
msgstr "Ух...!"

#. ja: うりゃ！
#. de: Ha!
#. fr: Raaah<nbsp>!
msgctxt "NpcYell:5179:0:13"
msgid "\\<grunt>"
msgstr "\\<хмык>"

#. ja: 何用かな？<br>旅の者よ…
#. de: Was willst du von uns?
#. fr: Que viens-tu faire ici, voyageur<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5180:0:13"
msgid "Peace walk with you, traveler.<br>What brings your tribe down<br>from yon peaks?"
msgstr "Мир тебе, путник.<br>Что привело твоё племя<br>с тех дальних гор?"

#. ja: チッ…貧乏くさい<br>連中だねぇ…
#. de: Von euch erbärmlichen Schluckern? Nichts!
#. fr: Pfff... J'viens pas vous voler, ça, c'est sûr. Bande de misérables.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5181:0:13"
msgid "Peace? We left peace lying<br>in a ditch two days back."
msgstr "Мир? Мы с ним распрощались<br>ещё два дня назад."

#. ja: 我らウヤギル族は<br>欲を捨てたのだ
#. de: Wir Uyagir haben jeglichem Verlangen abgeschworen.
#. fr: Les Uyagir ont abandonné la cupidité. C'est aussi simple que cela.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5182:0:13"
msgid "If it is warmth you seek, our<br>fires are yours. If it is shelter,<br>our caves are yours."
msgstr "Если тебе нужно согреться,<br>наш огонь в твоём распоряжении. Если укрыться —<br>можешь переночевать в наших пещерах."

#. ja: 山での獣狩りに<br>飽きたもんで…
#. de: In den Bergen gibt es kaum noch Beute.
#. fr: Et moi j'ai abandonné mes montagnes parce que j'en avais assez de chasser la chèvre.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5183:0:13"
msgid "And what of your food!?<br>Your gold!? Your furs!?"
msgstr "А как же еда!?<br>Золото!? Меха!?"

#. ja: 狩りに来たのさ…<br>人をな！
#. de: Also jagen wir hier. Aus dem Weg!
#. fr: Maintenant, je chasse l'homme<nbsp>!
msgctxt "NpcYell:5184:0:13"
msgid "Are they ours, as well!?"
msgstr "А люди тоже ваша добыча!?"

#. ja: 盗人の類いか…<br>これが欲の行き着く先…
#. de: Verdammte Räuber!
#. fr: Un pillard<nbsp>? Voilà exactement où mène la cupidité...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5185:0:13"
msgid "We have naught but that<br>which we carry on our backs."
msgstr "У нас есть лишь то,<br>что мы несём на своих спинах."

#. ja: ほざけよ！<br>殺して奪ってやる！
#. de: Wir werden euch töten und ausrauben!
#. fr: La ferme<nbsp>! Moi et les miens, on va vous massacrer<nbsp>! Et ensuite, on pillera vos cadavres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5186:0:13"
msgid "Then we shall<br>take your backs!"
msgstr "Тогда мы заберём<br>ваши спины!"

#. ja: くっ…<br>応戦するぞ！
#. de: Ihr kämpft nicht allein.
#. fr: Il n'est pas seul<nbsp>! Préparez-vous à combattre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5187:0:13"
msgid "You will not find<br>them easily given."
msgstr "Просто так вы<br>их не получите."

#. ja: 活きのいい獲物だねぇ！
#. de: Was für eine lebhafte Beute!
#. fr: Oh oh<nbsp>! C'est que nos proies se débattent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5188:0:13"
msgid "This one will<br>make a fine slave!"
msgstr "Вот это будет<br>отличный раб!"

#. ja: ハハハハッ！
#. de: Hahaha!
#. fr: Ha ha ha<nbsp>!
msgctxt "NpcYell:5189:0:13"
msgid "Hah hah hah hah!"
msgstr "Ха-ха-ха-ха!"

#. ja: てやっ！
#. de: Da!
#. fr: Yaaah<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5190:0:13"
msgid "I am one with the steppe,<br>the steppe is one with me."
msgstr "Я един со степью,<br>степь едина со мной."

#. ja: お前たち！<br>手を貸しな！
#. de: Bitte, helft uns!
#. fr: Nous avons besoin de renforts<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5191:0:13"
msgid "Come, boys! There are<br>slaves enough for all of us!"
msgstr "Сюда, парни! Рабов<br>на всех хватит!"

#. ja: 数で押すよ！<br>奪い尽くせ！
#. de: Wir sind ihnen zahlenmäßig überlegen!
#. fr: Nous sommes plus nombreux<nbsp>! Ne les laissez pas faire à leur guise<nbsp>!
msgctxt "NpcYell:5192:0:13"
msgid "They are weak! We are strong!"
msgstr "Они слабы! А мы сильны!"

#. ja: これが<br>欲深き者の末路か…
#. de: Das habt ihr nun von eurer Habsucht!
#. fr: La voie de la cupidité n'a qu'une issue...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5193:0:13"
msgid "We still have our backs.<br>The same cannot be said<br>of you and yours."
msgstr "У нас хотя бы спины целы.<br>Вам такого не сказать."

#. ja: 人相手の狩りは<br>愉しいねぇ！
#. de: Die Jagd gefällt mir!
#. fr: Ha ha ha<nbsp>! C'était plus amusant que de chasser la chèvre, pas vrai les gars<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5195:0:13"
msgid "Gather the survivors! Tonight<br>we are the kings of the steppe!"
msgstr "Соберите выживших! Сегодня<br>мы — короли степи!"

#. ja: さ～ぁ、分身するヨォ～
#. de: Drei Karasu sind besser als einer!
#. fr: Vous allez <i>adorer</i> mes clones<nbsp>!
msgctxt "NpcYell:5196:0:13"
msgid "Because one of me is never enough!"
msgstr "Потому что меня одного всегда мало!"

#. ja: ゲゲ、ボクたちオトモダチだよネ？
#. de: Doppelt hält besser!
#. fr: Hé, je croyais qu'on était amis<nbsp>!
msgctxt "NpcYell:5197:0:13"
msgid "Whoa, there! I thought we were friends!?"
msgstr "Эй, погоди! Я думал, мы друзья!"

#. ja: ウププ、こっちこないでネ！
#. de: Komm mir nicht zu nahe!
#. fr: Arrêtez de me coller comme ça, c'est gênant<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5198:0:13"
msgid "You stay over <i>there</i>, okay?"
msgstr "А ты оставайся <i>там</i>, ладно?"

#. ja: くっ…見破るとはな…
#. de: Niemand durchschaut meine Technik!
#. fr: Pfff, c'est juste un coup de bol<nbsp>!
msgctxt "NpcYell:5199:0:13"
msgid "Gah! A lucky guess!"
msgstr "Чёрт! Угадал случайно!"

#. ja: 見ない方がいいよぉ～ん！
#. de: Guck besser weg, wenn du es nicht erträgst.
#. fr: Je vous déconseille de regarder, hi hi hi<nbsp>!
msgctxt "NpcYell:5200:0:13"
msgid "I wouldn't look too close if I were you!"
msgstr "Я бы на твоём месте не стал<br>приглядываться!"

#. ja: 敵から視線をそらすんだヨォ！
#. de: Man soll den Feind immer im Auge behalten.
#. fr: Je vous avais bien dit de regarder ailleurs, ha ha<nbsp>!
msgctxt "NpcYell:5201:0:13"
msgid "Look away, I say!"
msgstr "Отведи взгляд, говорю!"

#. ja: 獲物がいるが…<br>ここはオロニル族の猟場か？
#. de: Hier gibt es genug Jagdbeute für uns.
#. fr: Le gibier que nous traquions est ici, mais... nous sommes sur le terrain de chasse des Oronir...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5202:0:13"
msgid "It is as I said. The prey here<br>is plentiful. But do not forget<br>we walk on Oroniri soil."
msgstr "Как я и говорил, добычи здесь<br>предостаточно. Только не забывайте:<br>мы на земле оронориев."

#. ja: 知ったことか！<br>狩っちまえ！
#. de: Ihr habt hier nichts zu suchen!
#. fr: Qu'est-ce qu'on en a à foutre<nbsp>!? Faites le plein<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5203:0:13"
msgid "The steppe belongs to<br>no man! We hunt where<br>we please!"
msgstr "Степь никому не принадлежит!<br>Охотимся где захотим!"

#. ja: 貴様ら！<br>ここは我らの猟場ぞ！
#. de: Das ist unser Gebiet! Verschwindet!
#. fr: Vous allez payer pour oser chasser sur le territoire des fils d'Azim<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5204:0:13"
msgid "Then you die where <i>we</i> please!"
msgstr "Тогда и умрёте там, где <i>мы</i> захотим!"

#. ja: フンッ！
#. de: Pah!
#. fr: Pffeuh<nbsp>!
msgctxt "NpcYell:5205:0:13"
msgid "Never!"
msgstr "Ни за что!"

#. ja: なめるな！
#. de: Komm schon!
#. fr: Ne vous croyez pas chez vous<nbsp>!
msgctxt "NpcYell:5206:0:13"
msgid "The wolves will feast tonight!"
msgstr "Сегодня волки будут пировать!"

#. ja: 思い知ったか！<br>密猟者どもめ！
#. de: Lasst euch hier nie wieder blicken, Wilderer!
#. fr: Vous en avez eu assez, braconniers à la manque<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5207:0:13"
msgid "You will stay off our lands<br>or your children will meet<br>the same grim fate!"
msgstr "Не суйтесь больше на нашу землю,<br>а не то ваших детей ждёт<br>та же участь!"

#. ja: チッ…<br>逃がしたか！
#. de: Mist ... entwischt.
#. fr: Merde, je les ai laissés s'enfuir...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5208:0:13"
msgid "We will find you! And leave<br>your bones for the beetles!"
msgstr "Мы вас найдём! И оставим<br>ваши кости на съедение жукам!"

#. ja: 急ぐっちゃ！
#. de: Mimiroon zeigt Weg! Mimiroon führt dich!
#. fr: Mimiroon guider <if $gn4>aventuuurière<else>aventuuurier</if><nbsp>! Par là<nbsp>! Par là<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5209:0:13"
msgid "Mimiroon will show!<br>Mimiroon will lead!"
msgstr "Мимирун покажет!<br>Мимирун поведёт!"

#. ja: ごちそうさまっちゃ！
#. de: Bäuche voll mit lecker Gemüse!
#. fr: Merci pour repas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5211:0:13"
msgid "Bellies abursting with<br>beets and broccoli!"
msgstr "Животы набиты<br>свёклой и брокколи!"

#. ja: また食べにくるっちゃ！
#. de: Bis zum nächsten Mal!
#. fr: Qiqirns revenir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5212:0:13"
msgid "Tummies atumbling with<br>turnips and tomatoes!"
msgstr "Пузики полны<br>репой и помидорами!"

#. ja: げぷっ！
#. de: \<rülps>
#. fr: Beuharp<nbsp>! Oh<nbsp>! Qiqirn demander pardon...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5213:0:13"
msgid "Guts agrumbling with<br>garlic and \\<BURP>!"
msgstr "Живот урчит от чеснока и \\<ОТРЫЖКА>!"

#. ja: 父子相伝の必殺剣よ！
#. de: Für dich, Vater!
#. fr: Pour vous, Père<nbsp>!
msgctxt "NpcYell:5214:0:13"
msgid "For you, Father!"
msgstr "Это тебе, отец!"

#. ja: ハァ…ハァ…
#. de: \<keuch> ... \<schnauf>
#. fr: Haa haa... (souffle)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5215:0:13"
msgid "I cannot...keep this<br>up...much longer..."
msgstr "Я больше... не могу<br>так... долго..."

#. ja: 振り切れないか？
#. de: Ich muss die irgendwie loswerden.
#. fr: On ne va pas y arriver comme ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5216:0:13"
msgid "If I am to survive this day<br>I will need a boon from the<br>heavens..."
msgstr "Чтобы пережить этот день,<br>мне понадобится помощь<br>самих небес..."

#. ja: 終わらせる！
#. de: Lasst mich in Ruhe!
#. fr: Sale bête<nbsp>!
msgctxt "NpcYell:5217:0:13"
msgid "It ends here!"
msgstr "Здесь всё и закончится!"

#. ja: 邪魔だ！
#. de: Weg mit euch!
#. fr: Dégage<nbsp>!
msgctxt "NpcYell:5218:0:13"
msgid "Back to the dark with you!"
msgstr "Прочь во тьму!"

#. ja: 獲物っちゃ！
#. de: Erntezeit, Essenszeit!
#. fr: Heure du dîner avoir sonné<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5219:0:13"
msgid "He looks of breakfast,<br>lunch, brunch, and dinner!"
msgstr "Он сгодится на завтрак,<br>обед, полдник и ужин!"

#. ja: 囲め囲めっちゃ！
#. de: Alles abgrasen!
#. fr: Qiqirns former un cercle<nbsp>! Proie pas pouuuvoir fuuuir<nbsp>!
msgctxt "NpcYell:5220:0:13"
msgid "'Round and around we go!"
msgstr "Хороводом ходим!"

#. ja: 腹ぺこっちゃ！
#. de: Hinter Kauleiste kippen!
#. fr: À manger<nbsp>! À manger<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5221:0:13"
msgid "Empty bellies send<br>blood aboiling!"
msgstr "Пустые животы<br>кровь кипятят!"

#. ja: だ、誰かが見ているような？
#. de: Ich kann ihre knurrenden Mägen hören!
#. fr: J-je peux sentir leur regard sur moi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5223:0:13"
msgid "I can feel their<br>beady little eyes!"
msgstr "Чувствую на себе<br>их глазки-бусинки!"

#. ja: ウププ、お・バ・カ・さ・ん！
#. de: Muhaha, reingelegt!
#. fr: Quel gros nigaud, ha ha ha<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5224:0:13"
msgid "Now <i>that</i> wasn't very smart, was it?"
msgstr "Ну разве это было <i>умно</i>?"

#. ja: 撤退だー！
#. de: Rückzug!
#. fr: Retraite<nbsp>! Retraite<nbsp>!
msgctxt "NpcYell:5225:0:13"
msgid "Fall back! They are too many!"
msgstr "Отступаем! Их слишком много!"

#. ja: 悔しいが命が大事だ…
#. de: Tote Helden nützen nichts!
#. fr: Désolé mais je tiens à ma vie<nbsp>!
msgctxt "NpcYell:5226:0:13"
msgid "You heard him! Fall back!"
msgstr "Слышали? Отступаем!"

#. ja: なんという手強さ…
#. de: Die sind zu stark für uns!
#. fr: Ils sont bien trop forts...
msgctxt "NpcYell:5227:0:13"
msgid "By the gods..."
msgstr "Боги..."

#. ja: 後方に下がりましょう！
#. de: Bringt euch in Sicherheit!
#. fr: On est mal barrés...
msgctxt "NpcYell:5228:0:13"
msgid "Run! Ruuuuuun!"
msgstr "Бегите! Бе-е-егом!"

#. ja: で、出直すぞ！
#. de: N-Neu formieren!
#. fr: On reviendra<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5229:0:13"
msgid "They have not seen<br>the last of us!"
msgstr "Вы ещё о нас<br>услышите!"

#. ja: だ、誰か…
#. de: H-Hilfe ... Will mir denn niemand helfen?
#. fr: À l'aide<nbsp>!
msgctxt "NpcYell:5230:0:13"
msgid "H-Help... Is there...anyone..."
msgstr "П-помогите... Есть... кто-нибудь?.."

#. ja: 助けてくれ…
#. de: Sie wollen mir an den Kragen!
#. fr: Les Rouges arrivent<nbsp>!
msgctxt "NpcYell:5231:0:13"
msgid "The Reds...are coming..."
msgstr "Красные... идут..."

#. ja: ダメだ…<br>手に負えん！
#. de: Verdammt ... wir sind zu schwach.
#. fr: Im-impossible de le calmer<nbsp>!
msgctxt "NpcYell:5232:0:13"
msgid "What cannot be tamed..."
msgstr "То, что нельзя приручить..."

#. ja: 皆で囲い込み<br>打ち殺せ！
#. de: Wir müssen gleichzeitig von allen Seiten aus angreifen!
#. fr: Encerclez-le et tuez-le<nbsp>!
msgctxt "NpcYell:5233:0:13"
msgid "Must be slain!"
msgstr "Прикончить его!"

#. ja: 肉にしてやる！
#. de: Aus dir mach ich Hackfleisch!
#. fr: Je vais te réduire en côtelettes<nbsp>!
msgctxt "NpcYell:5234:0:13"
msgid "I'll eat your heart first!"
msgstr "Сначала вырву тебе сердце!"

#. ja: 暴れ牛め！
#. de: Brutaler Ochse!
#. fr: Sale bête<nbsp>!
msgctxt "NpcYell:5235:0:13"
msgid "Closer! Closer!"
msgstr "Ближе! Ещё ближе!"

#. ja: 旅人よ…<br>協力に礼を言おう！
#. de: Danke für deine Hilfe, Fremde<if $gn4><else>r</if>.
#. fr: Merci pour ton aide, <if $gn4>étrangère<else>étranger</if><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5236:0:13"
msgid "My thanks! You are welcome<br>to as much meat as you can<br>carry!"
msgstr "Благодарю! Мяса бери сколько унесёшь!"

#. ja: なんということだ…！
#. de: Wir haben versagt ...
#. fr: Argh... Il est trop fort...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5237:0:13"
msgid "The legend lives<br>to see another sun..."
msgstr "Легенда доживёт<br>до нового рассвета..."

#. ja: チャプリの群れが<br>やってくるぞ！
#. de: Da! Ein weiterer Schwarm nähert sich!
#. fr: La nuée<nbsp>! Elle approche<nbsp>!
msgctxt "NpcYell:5238:0:13"
msgid "There! Another flock approaches!"
msgstr "Вон они! Ещё одна стая летит!"

#. ja: ヤツらを<br>追い払うぞ！
#. de: Treibt sie zurück!
#. fr: Allez<nbsp>! On nettoie tout ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5239:0:13"
msgid "Send them back<br>over the Chain!"
msgstr "Гоним их<br>за цепное звено!"

#. ja: 応ッ！
#. de: Jaaaa!
#. fr: Bien compris<nbsp>!
msgctxt "NpcYell:5240:0:13"
msgid "Over the Chain!"
msgstr "За цепное звено!"

#. ja: うおおおおお！
#. de: Ohhhh!
#. fr: Yaaaaaaaaah<nbsp>!
msgctxt "NpcYell:5241:0:13"
msgid "Over the Chain!"
msgstr "За цепное звено!"

#. ja: 消え失せろ！
#. de: Löscht sie aus!
#. fr: Hors de ma vue<nbsp>!
msgctxt "NpcYell:5242:0:13"
msgid "Over the Chain!"
msgstr "За цепное звено!"

#. ja: 命司る精霊よ…
#. de: Oh Geister des Waldes<nbsp>...
#. fr: Ô esprits, sources de toutes vies...
msgctxt "NpcYell:5243:0:13"
msgid "Spirits of the forest..."
msgstr "Духи леса..."

#. ja: 大気に満ち…<br>木々揺らす波動…
#. de: Schenkt uns Wind und Regen!
#. fr: Que la même énergie qui parcourt la Sylve nous inonde...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5244:0:13"
msgid "I call on your winds...<br>The rains which nourish..."
msgstr "Взываю к вашим ветрам...<br>К дождям, что питают землю..."

#. ja: 生命の鼓動を刻め！
#. de: Lasst uns den Puls des Lebens spüren!
#. fr: Pulsation vitale<nbsp>!
msgctxt "NpcYell:5245:0:13"
msgid "Quicken the pulse of life!"
msgstr "Ускорьте биение жизни!"

#. ja: さあ、こちらに…
#. de: Nur die Ruhe, alles wird gut.
#. fr: Laissez-moi faire...
msgctxt "NpcYell:5246:0:13"
msgid "Please, this way..."
msgstr "Прошу, сюда..."

#. ja: 負傷しているなら治療しよう
#. de: Das haben wir gleich geheilt.
#. fr: Je vais guérir vos blessures.
msgctxt "NpcYell:5247:0:13"
msgid "I shall tend to your wounds."
msgstr "Позвольте перевязать ваши раны."

#. ja: 心を落ち着けて…
#. de: Seht nur, schon schließen sich Eure Wunden.
#. fr: Faites-moi confiance, tout ira bien.
msgctxt "NpcYell:5248:0:13"
msgid "All will be well..."
msgstr "Всё будет хорошо..."

#. ja: 誰か助けてっちゃ！
#. de: Bitte helfen jemand!
#. fr: À l'aide<nbsp>! À l'aide<nbsp>!
msgctxt "NpcYell:5258:0:13"
msgid "Oh woest of woes!"
msgstr "О горе мне!"

#. ja: シドゥルグ！
#. de: Sidurgu!
#. fr: Sidurgu<nbsp>!
msgctxt "NpcYell:5259:0:13"
msgid "Sid, no!"
msgstr "Сид, нет!"

#. ja: 私に任せろッ！
#. de: Überlass das mir!
#. fr: Je m'en occupe<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5260:0:13"
msgid "I told you not to<br>start without me!"
msgstr "Я же велел не<br>начинать без меня!"

#. ja: 地脈よ…<br>我に力を…
#. de: Ätherstrom ... leih mir deine Kraft!
#. fr: Ô éther tellurique... Offre-moi ta puissance...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5261:0:13"
msgid "Ancient rock awaken!<br>Grant thy strength unto me!"
msgstr "Пробудись, древняя скала!<br>Поделись своей силой!"

#. ja: 目覚めよ…<br>命宿せ、我が僕…！
#. de: Erwachet und folgt meinem Ruf!
#. fr: Shikigami, miroirs de mon être<nbsp>! Éveillez-vous et prenez forme<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5262:0:13"
msgid "And into this vessel<br>I bind thee for eternity!"
msgstr "И в этот сосуд<br>я заключаю тебя навеки!"

#. ja: 嗚呼…<br>いったいどうすれば…
#. de: Oje, was soll ich jetzt bloß tun?!
#. fr: Comment faire... Je ne peux la sauver toute seule...
msgctxt "NpcYell:5263:0:13"
msgid "Someone save my daughter!"
msgstr "Кто-нибудь, спасите мою дочь!"

#. ja: だ、誰か…<br>誰か娘を…！
#. de: Bitte, rette meine Tochter!
#. fr: À l'aide<nbsp>! Ma fille est en danger<nbsp>!
msgctxt "NpcYell:5264:0:13"
msgid "She's all I have!"
msgstr "Она у меня одна!"

#. ja: お母さ～ん！<br>お母さ～ん！
#. de: Mutter! Mutter!
#. fr: Mamaaaan<nbsp>! Mamaaaan<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5265:0:13"
msgid "They're trying to <i>eat</i> me!"
msgstr "Они хотят меня <i>съесть</i>!"

#. ja: どうしよう…<br>どうしよう…！
#. de: Mein Dzo ist in Gefahr!
#. fr: Oh là là, je crains le pire...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5268:0:13"
msgid "O, giver of life and bringer<br>of the morn! What am I to do?"
msgstr "О, дарующий жизнь и несущий<br>рассвет! Что же мне делать?"

#. ja: 可愛いウチの子が<br>食べられちゃうわ！
#. de: Mein armes Tier wird gefressen!
#. fr: Je ne veux pas que mon hainag chéri serve de repas aux gedans<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5269:0:13"
msgid "The dark seeks to claim<br>my only light─my dzo!"
msgstr "Тьма хочет отнять<br>мой единственный свет — дзо!"

#. ja: 旅人さん<br>がんばってっ！
#. de: Weiter so, <if $gn4>Fremde<else>Fremder</if>!
#. fr: Courage, <if $gn4>étrangère<else>étranger</if><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5270:0:13"
msgid "Mighty Azim, grant this<br>traveler strength!"
msgstr "Могучий Азим, даруй<br>Путешественнику силу!"

#. ja: きゃあっ！
#. de: Hilfe!
#. fr: Hiii<nbsp>!!!
msgctxt "NpcYell:5271:0:13"
msgid "\\<gasp>"
msgstr "\\<вскрик>"

#. ja: 助かりました…！<br>無事でよかったわ！
#. de: Ein Glück, du lebst!
#. fr: Mon hainag chéri va bien... Merci beaucoup, <if $gn4>étrangère<else>étranger</if><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5272:0:13"
msgid "Praise the sun!<br>My charge is safe!"
msgstr "Слава солнцу!<br>Моё дитя цело!"

#. ja: あぁ、ウチの子が…
#. de: Oje, mein Dzo!
#. fr: Nooon, rendez-moi mon hainag chéri<nbsp>! (pleure)
msgctxt "NpcYell:5273:0:13"
msgid "My light..."
msgstr "Мой свет..."

#. ja: 誰でもいい！<br>共に戦ってくれ！
#. de: Ist irgendjemand bereit, für mich zu kämpfen?
#. fr: On n'y arrivera pas tout seuls<nbsp>!
msgctxt "NpcYell:5274:0:13"
msgid "The stench! It must be stifled!"
msgstr "Запах! Надо его перебить!"

#. ja: 居留地に<br>近づかせるか！
#. de: Ihr kommt hier nicht durch!
#. fr: Ne laissez pas cette horreur s'approcher du Trône de l'Aube<nbsp>!
msgctxt "NpcYell:5275:0:13"
msgid "Keep it back from the village!"
msgstr "Не подпускайте эту тварь к деревне!"

#. ja: テヤッ！
#. de: Ha!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:5276:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: 感謝するぞ、友よ！<br>居留地は守られた！
#. de: Vielen Dank für deine Hilfe!
#. fr: C'était moins une... Merci l'<if $gn4>amie<else>ami</if><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5277:0:13"
msgid "\\<inhale><br>The air is clean once again!"
msgstr "\\<вдох><br>Воздух снова чист!"

#. ja: はやく仲間に<br>報せなければ！
#. de: Ich muss meinen Stamm warnen.
#. fr: C'est notre grand frère qui va être content<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5278:0:13"
msgid "My people are in danger!<br>I must warn them!"
msgstr "Мой народ в опасности!<br>Надо их предупредить!"

#. ja: 急ぐっちゃ！<br>仲間が危ないっちゃ！
#. de: Wir müssen uns schnell beeilen, ja?
#. fr: Pluuus vite<nbsp>! Méchants Qiqirns bientôt croc croc ami de Mimiroon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5279:0:13"
msgid "Most hastily we must<br>make our haste! "
msgstr "Надо срочно<br>поспешить!"

#. ja: こっちに<br>捕まってるっちゃ！
#. de: Hier lang! Hier lang!
#. fr: Par là<nbsp>! Par là<nbsp>!
msgctxt "NpcYell:5280:0:13"
msgid "This way! This way!"
msgstr "Сюда! Сюда!"

#. ja: ぶるぶる…<br>助けてっちゃ！
#. de: Mimiroon ist friedlicher Qiqrin! Mimiroon Angst vor Kämpfen hat!
#. fr: Mimiroon être gentil Qiqirn<nbsp>! Pas taper Mimiroon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5281:0:13"
msgid "Mimiroon is man of peace!<br>Mimiroon cannot bear<br>these bluntest of thumpings!"
msgstr "Мимирун — мирный человек!<br>Мимирун не вынести<br>такой жестокой трёпки!"

#. ja: ミミルン…<br>戦い怖いっちゃ…
#. de: Mimiroon hat viele Angst! Was, wenn Mimiroon was passiert?
#. fr: Mimiroon pas aimer paf paf... Pas aimer duuu touuut<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5282:0:13"
msgid "So afraid is poor Mimiroon.<br>What will befall poor Mimiroon?"
msgstr "Бедный Мимирун так боится.<br>Что же с ним будет?"

#. ja: ありがとっちゃ！
#. de: Viele, viele Dank!
#. fr: Merci, <if $gn4>gentille aventuuurière<else>gentil aventuuurier</if><nbsp>!
msgctxt "NpcYell:5283:0:13"
msgid "Many, many thanks and more!"
msgstr "Тысяча благодарностей и ещё тысяча!"

#. ja: わざわざ自分から<br>来てくれて嬉しいっちゃ！
#. de: Mimiroon hätte nicht gedacht, dass Plan funktioniert.
#. fr: Mimiroon pas penser que plan fonctionner<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5284:0:13"
msgid "Mimiroon did not think<br>such plan would work!"
msgstr "Мимирун не думал,<br>что план сработает!"

#. ja: みんな、出てこいっちゃ！<br>新鮮な食材っちゃ！
#. de: Kommt, hungrige Freunde! Das Essen da ist!
#. fr: Amis<nbsp>! Venez<nbsp>! <if $gn4>Gentille aventuuurière<else>Gentil aventuuurier</if> être venuuu<if $gn4>e</if> pour relever le miam miam<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5285:0:13"
msgid "Come, hungriest of hungries!<br>Our banquet is here!"
msgstr "Идите сюда, проголодавшиеся!<br>Пир уже ждёт!"

#. ja: さすがは噂の英雄！<br>兵卒たちよ、己の未熟さを知ったことだろう！
#. de: Du stehst deinem Ruf in nichts nach! Du bist meinen Männern ein leuchtendes Beispiel!
#. fr: Ha ha ha, vous vous souviendrez longtemps de cette séance d'en<shy>traî<shy>ne<shy>ment<nbsp>!
msgctxt "NpcYell:5286:0:13"
msgid "I see you made quick work of these green recruits."
msgstr "Смотрю, ты мигом управился с этими зелёными новобранцами."

#. ja: 怖いよう…
#. de: Die machen mir Angst ...
#. fr: Ça fait peur... (snif)
msgctxt "NpcYell:5287:0:13"
msgid "Help!"
msgstr "На помощь!"

#. ja: 嗚呼、よくぞ無事で！
#. de: Ein Glück ist dir nichts passiert!
#. fr: Tu n'as rien<nbsp>! Les kami soient loués<nbsp>!
msgctxt "NpcYell:5288:0:13"
msgid "Oh, my poor buttercup!"
msgstr "Бедное моё солнышко!"

#. ja: 勝手に村から出るなって<br>あれほど…！
#. de: Wieso musstest du das Dorf auch alleine verlassen?!
#. fr: Combien de fois t'ai-je dit de ne pas t'éloigner du village<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5289:0:13"
msgid "Now do you understand why<br>I tell you to never leave the<br>village on your own?"
msgstr "Ну вот, теперь понимаешь,<br>почему я запрещаю тебе<br>уходить из деревни одному?"

#. ja: ！？
#. de: ?!
#. fr: Papa...<nbsp>!?
msgctxt "NpcYell:5290:0:13"
msgid "You..."
msgstr "Ты..."

#. ja: お父さんのお墓に<br>供えようと？
#. de: Du wolltest sein Grab besuchen?
#. fr: Tu voulais te rendre sur sa tombe après...<nbsp>?
msgctxt "NpcYell:5291:0:13"
msgid "You went to his grave...?"
msgstr "Ты ходил к его могиле...?"

#. ja: そうだったのね…<br>さあ、村に帰るわよ
#. de: Das ist lieb von dir, aber alleine viel zu gefährlich. Lass uns zurückkehren.
#. fr: Je comprends mieux pourquoi tu as voulu faire ça, maintenant... Allez, viens. On rentre à la maison.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5292:0:13"
msgid "Alright... But next time,<br>let's go together."
msgstr "Ладно... Но в следующий раз<br>пойдём вместе."

#. ja: お母さん！<br>怖かったよう…
#. de: Ich hatte ja solche Angst, Mama!
#. fr: Maman, les monstres<nbsp>! Ils m'ont fait trop peur...<nbsp>!
msgctxt "NpcYell:5293:0:13"
msgid "I was so scared..."
msgstr "Мне было так страшно..."

#. ja: だって…綺麗なお花を…<br>お父さんに…
#. de: Um Papa frische Blumen zu bringen!
#. fr: Mais... Mais... Il y avait une jolie fleur... Je voulais la cueillir pour papa...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5294:0:13"
msgid "I just wanted to take<br>Papa some flowers."
msgstr "Я просто хотел<br>отнести папе цветы."

#. ja: うん…
#. de: Ja ...
#. fr: Moui...
msgctxt "NpcYell:5295:0:13"
msgid "Yes, Mama."
msgstr "Да, мама..."

#. ja: うん…
#. de: Ja ...
#. fr: D'accord...
msgctxt "NpcYell:5296:0:13"
msgid "Yes, Mama!"
msgstr "Да, мама!"

#. ja: あ、お母さん！<br>待ってよお～！
#. de: Mama! Warte auf mich!
#. fr: Maman<nbsp>! Marche pas si vite<nbsp>! Attends-moi<nbsp>!
msgctxt "NpcYell:5297:0:13"
msgid "Wait for me!"
msgstr "Подожди меня!"

#. ja: 腹ぺこっちゃ！
#. de: Süßes Fleisch, frisches Fleisch!
#. fr: Viande<nbsp>! Chair<nbsp>! Boyaux<nbsp>!
msgctxt "NpcYell:5298:0:13"
msgid "Sweet meat! Fresh meat!"
msgstr "Сладкое мясо! Свежее мясо!"

#. ja: 今夜は<br>腹いっぱいっちゃ！
#. de: Heute Abend wir uns Bäuche vollschlagen!
#. fr: Bon gros dîner pour être rassasié<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5300:0:13"
msgid "Tonight we eat<br>and eat and eat!"
msgstr "Сегодня будем есть,<br>есть и ещё раз есть!"

#. ja: 大人しくするっちゃ！
#. de: <if $gn4>Ihre<else>Seine</if> Zunge wir zuerst kochen!
#. fr: Toi te laisser faire<nbsp>!
#. macro: <if $gn4>Her<else>His</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:5301:0:13"
msgid "<if $gn4>Her<else>His</if> tongue we cook first!"
msgstr "<if $gn4>Её<else>Его</if> язык сварим первым!"

#. ja: 美味しそうっちゃ！
#. de: So fett! So saftig!
#. fr: Chair doduuue<nbsp>! Chair juuuteuse<nbsp>! Miam<nbsp>! Miam<nbsp>!
msgctxt "NpcYell:5302:0:13"
msgid "So plump! So juicy!"
msgstr "Такое пухленькое! Такое сочное!"

#. ja: 兵卒たちが逃げるのも<br>無理はないニャ
#. de: Kein Wunder, dass manche die Flucht ergreifen!
#. fr: Je ne suis pas étonnée que les soldats aient prrris leurs jambes à leur cou, hé hé.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:5303:0:13"
msgid "Not <i>an</i> adventurer,<br><i>the</i> adventurer!<br><string $gs1>!"
msgstr "Не просто <i>искатель приключений</i>,<br>а <i>тот самый</i> искатель приключений!<br><string $gs1>!"

#. ja: 台所に行くっちゃ！
#. de: Ab zu Lagerfeuer!
#. fr: À la broche<nbsp>! À la broche<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5304:0:13"
msgid "To the bonfire!<br>To the bonfire!"
msgstr "К костру!<br>К костру!"

#. ja: だ、誰か…<br>助けてっちゃ…
#. de: Ganz mager bin! Nicht gut schmecken!
#. fr: À l'aide<nbsp>! Pas croc croc gentil Qiqirn<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5306:0:13"
msgid "No meat is there<br>on these here bones!"
msgstr "На этих костях<br>мяса-то и нет!"

#. ja: 食べないでっちゃ…
#. de: Bitte nicht essen!
#. fr: Non... Pas la broche...
msgctxt "NpcYell:5307:0:13"
msgid "All gristle and grime, I am!"
msgstr "Одни хрящи да грязь, я!"

#. ja: 帰って<br>料理するっちゃ！
#. de: Essenszeit!
#. fr: Dîner être prêt<nbsp>!
msgctxt "NpcYell:5308:0:13"
msgid "Time to dine!"
msgstr "Пора ужинать!"

#. ja: 逃がさないっちゃ！
#. de: Du nicht entkommst!
#. fr: Vous pas fuir<nbsp>! Vous remplir estomacs<nbsp>!
msgctxt "NpcYell:5309:0:13"
msgid "The bonfire is only escape!"
msgstr "Убежать можно только к костру!"

#. ja: さあ、次は下士官諸君の出番だ！<br>兵卒たちの手本となるよう、各員奮戦するように！
#. de: Also gut, jetzt sind die Unteroffiziere dran. Seid den Rekruten ein leuchtendes Vorbild!
#. fr: Au tour des sous-officiers, maintenant. Je compte sur vous pour servir d'exemple aux soldats<nbsp>!
msgctxt "NpcYell:5310:0:13"
msgid "Though I'd be disappointed with aught less from the bloody hero of the realm!"
msgstr "Не ожидал бы от кого другого, но от самого героя королевства — ни за что!"

#. ja: では、準備はいいな？<br>総員抜刀……模擬戦開始ぃぃぃぃっ！！！
#. de: Alle bereit? Dann zu den Waffen! Die Übung beginnt!
#. fr: Tout le monde est prêt<nbsp>? Dégainez vos armes, en garde... Début de l'entraînemeeeeent<nbsp>!!!
msgctxt "NpcYell:5311:0:13"
msgid "But what say we toss you a bone with a deal more meat on her? Officers! Form ranks!"
msgstr "Но как насчёт кое-чего посочнее? Офицеры! В строй!"

#. ja: 旅人よ<br>俺の話を聞いてくれ！
#. de: Höre dir an, was ich zu sagen habe!
#. fr: <if $gn4>Voyageuse<else>Voyageur</if>, écoute-moi<nbsp>!
msgctxt "NpcYell:5312:0:13"
msgid "Traveler. Please, I beg of you!"
msgstr "Путешественник, прошу, умоляю тебя!"

#. ja: 誰だ！？<br>後を付けているのは！
#. de: Wen haben wir denn da?
#. fr: C'est encore ce minus<nbsp>! Il a amené du renfort<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5313:0:13"
msgid "I don't like being followed.<br>Name yourself!"
msgstr "Не люблю, когда за мной следят.<br>Назовись!"

#. ja: この盗人どもめ！
#. de: Elender Dieb!
#. fr: Bande de sales voleurs<nbsp>!
msgctxt "NpcYell:5314:0:13"
msgid "You thief!"
msgstr "Ах вы воры!"

#. ja: よくもだましたな！
#. de: Ihr habt mich betrogen!
#. fr: Vous n'avez pas honte de tromper les honnêtes gens<nbsp>?
msgctxt "NpcYell:5315:0:13"
msgid "You swine!"
msgstr "Свиньи!"

#. ja: うるさい！
#. de: Halt's Maul!
#. fr: Arrête ton char<nbsp>!
msgctxt "NpcYell:5316:0:13"
msgid "Oink! Oink!"
msgstr "Хрю! Хрю!"

#. ja: 黙れ！
#. de: Schweig!
#. fr: La ferme<nbsp>!
msgctxt "NpcYell:5317:0:13"
msgid "Is that all!?"
msgstr "И это всё?!"

#. ja: これで俺の名誉は<br>どうにか保たれた！
#. de: Meine Ehre ist gerettet!
#. fr: Ouf... Mon honneur est sauf<nbsp>!
msgctxt "NpcYell:5318:0:13"
msgid "And just try it again!"
msgstr "И попробуй только повтори!"

#. ja: なんてことだ…<br>俺の名誉は地に堕ちた！
#. de: Oje, meine Ehre ist verloren!
#. fr: Argh... Quel déshonneur<nbsp>!
msgctxt "NpcYell:5319:0:13"
msgid "My tribe will not forgive this..."
msgstr "Племя мне этого не простит..."

#. ja: おいおい<br>何を手こずっている！
#. de: Eigentlich hatte ich ja genug!
#. fr: Qu'est-ce que vous attendez pour les tuer<nbsp>!?
msgctxt "NpcYell:5320:0:13"
msgid "Finish them! Now!"
msgstr "Добейте их! Живо!"

#. ja: こいつらだ！<br>毛皮を奪ったのは！
#. de: Das sind die Diebe!
#. fr: C'est eux, les escrocs qui m'ont pris mes peaux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5321:0:13"
msgid "These are the men who<br>worked their treachery on me!"
msgstr "Вот они!<br>Это они меня обокрали!"

#. ja: まさか…
#. de: Da!
#. fr: Hein...<nbsp>? Je rêve...<nbsp>?
msgctxt "NpcYell:5322:0:13"
msgid "Look!"
msgstr "Смотрите!"

#. ja: 我々を追跡している？
#. de: Das verdammte Ding verfolgt uns! Es weiß, wo wir sind!
#. fr: Elle nous a suivi jusqu'ici cette satanée machine<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5323:0:13"
msgid "The damned this is tracking<br>us... It knows we are here!"
msgstr "Проклятая штуковина следит<br>за нами... Она знает, где мы!"

#. ja: そ、そんな！
#. de: Wie ist das ...?
#. fr: Par les Douze<nbsp>! Dites-moi que c'est un cauchemar<nbsp>!
msgctxt "NpcYell:5324:0:13"
msgid "But that's not─"
msgstr "Но ведь..."

#. ja: 走れ！
#. de: Weg hier!
#. fr: Cours<nbsp>! Sinon t'es pas près de te réveiller, moi j'te le dis<nbsp>!
msgctxt "NpcYell:5325:0:13"
msgid "Run!"
msgstr "Бежим!"

#. ja: なんだって<br>こんなことに！
#. de: Meine Rede!
#. fr: J'voulais juste faire un peu de récup, moi<nbsp>!
msgctxt "NpcYell:5326:0:13"
msgid "Right!"
msgstr "Точно!"

#. ja: 我々が狙われているなら<br>集落に戻るわけには！
#. de: Moment! Wenn das Ding uns verfolgen kann, dann dürfen wir ...
#. fr: Attendez<nbsp>! Si c'est nous qu'elle poursuit, on ne peut pas rentrer à la base<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5332:0:13"
msgid "Wait. If this machine can track<br>us, then fleeing back to camp..."
msgstr "Постойте. Если эта машина нас выслеживает,<br>то возвращаться в лагерь..."

#. ja: アラギリに近づけるな！
#. de: ... es nicht zu unserem Lager führen!
#. fr: Ça la mènerait droit à Ala Ghiri<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5333:0:13"
msgid "Would lead the enemy<br>right where it wants to go! "
msgstr "Значит привести врага<br>прямо туда, куда он хочет!"

#. ja: クソッ！
#. de: Verdammter Mist!
#. fr: Bordel de merde<nbsp>!
msgctxt "NpcYell:5334:0:13"
msgid "Thal's bleeding balls!"
msgstr "Таловы яйца!"

#. ja: このまま逃げても<br>解決には…！
#. de: Also, wenn wir nicht zurück können ...
#. fr: Fuir ne résoudra pas le problème...
msgctxt "NpcYell:5335:0:13"
msgid "But if we can't go back..."
msgstr "Но если назад нельзя..."

#. ja: やるしかないのか！？
#. de: Vergiss es!
#. fr: On a pas le choix, alors<nbsp>!? Va falloir qu'on déglingue ce monstre<nbsp>!?
msgctxt "NpcYell:5336:0:13"
msgid "Aw, hells no!"
msgstr "Да чтоб вас!"

#. ja: はぁ…はぁ…
#. de: Das war knapp.
#. fr: (souffle) (souffle)
msgctxt "NpcYell:5337:0:13"
msgid "That was close..."
msgstr "Фух... Чуть не попались..."

#. ja: 怪我はないか？
#. de: Bist du verletzt?
#. fr: Vous êtes pas blessés<nbsp>?
msgctxt "NpcYell:5338:0:13"
msgid "Are you injured?"
msgstr "Ты не ранен?"

#. ja: ど、どうする？
#. de: Jedenfalls nicht tot, oder?
#. fr: Qu'est-ce qu'on fait maintenant<nbsp>?
msgctxt "NpcYell:5339:0:13"
msgid "I'm not dead, am I?"
msgstr "Я ведь жив, да?"

#. ja: まさか…<br>こんなことに…
#. de: Und was jetzt?
#. fr: C'est pas comme ça que j'imaginais que ma patrouille allait se passer...
msgctxt "NpcYell:5340:0:13"
msgid "So, what is the plan?"
msgstr "И что теперь делать?"

#. ja: いつまでも<br>隠れては…
#. de: Hier verstecken und auf Hilfe warten?
#. fr: Il faudra bien qu'on sorte de notre trou au bout d'un moment.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5341:0:13"
msgid "I've a feeling “hide here<br>until help arrives” is out<br>of the question."
msgstr "Чую, идея «сидеть тут<br>и ждать подмоги»<br>не сработает."

#. ja: これからどうする？
#. de: Was anderes bleibt uns wohl nicht übrig ...
#. fr: Qu'est-ce qu'on va faire maintenant<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5342:0:13"
msgid "As of the moment, that's<br>about all I had..."
msgstr "Пока это всё, что у меня есть..."

#. ja: 対策を…<br>考えねば…
#. de: Oh Zwölf, steht uns bei ...
#. fr: Il nous faut un plan, sinon c'en est fini de nous...
msgctxt "NpcYell:5343:0:13"
msgid "Twelve save us..."
msgstr "Спаси нас, Двенадцать..."

#. ja: これで終わり…<br>なのか？
#. de: Ich glaub, uns sind die Felsen ausgegangen.
#. fr: C'est la fin... On est foutus...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5344:0:13"
msgid "Looks as if we're<br>out of boulders."
msgstr "Похоже,<br>камни у нас кончились."

#. ja: だ、誰か<br>援護をッ…！
#. de: Sieht so aus ... <i>Hilfe</i>!
#. fr: Par pitié<nbsp>! Sauvez-moi<nbsp>!
msgctxt "NpcYell:5345:0:13"
msgid "That we are... HELP!!!"
msgstr "Так и есть... НА ПОМОЩЬ!!!"

#. ja: 助かったぜ…！
#. de: Ich schulde dir was!
#. fr: Merci bien<nbsp>!
msgctxt "NpcYell:5347:0:13"
msgid "I owe you one!"
msgstr "Я у тебя в долгу!"

#. ja: そぉら、行くぞ！
#. de: Vorwääärts!
#. fr: En avant<nbsp>!
msgctxt "NpcYell:5348:0:13"
msgid "Forward, forward!"
msgstr "Вперёд, вперёд!"

#. ja: やっちゃるよ！
#. de: Denen geb ich's!
#. fr: Venez prendre votre raclée<nbsp>!
msgctxt "NpcYell:5349:0:13"
msgid "Let's do this!"
msgstr "Ну, давайте!"

#. ja: きっと勝つ…<br>任されたんだから！
#. de: Wir werden sieg... <i>Sie</i> werden für uns siegen!
#. fr: Restez concentrés... Nous devons gagner<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5350:0:13"
msgid "We will prevail...<br>We will prevail..."
msgstr "Мы победим...<br>Мы победим..."

#. ja: うおおおおッ！
#. de: Uaaaaaah!
#. fr: Hiyaaah<nbsp>!
msgctxt "NpcYell:5351:0:13"
msgid "Bwahahaha!"
msgstr "Бвахахаха!"

#. ja: さすがは英雄…
#. de: Etwas zu heldenhaft für meinen Geschmack!
#. fr: C'est bien <if $gn4>la Guerrière<else>le Guerrier</if> de la Lumière...
msgctxt "NpcYell:5356:0:13"
msgid "We didn't have a chance..."
msgstr "Нам с ними не тягаться..."

#. ja: 見事な腕前です！
#. de: Welch vortreffliches Können!
#. fr: Quelle habileté<nbsp>!
msgctxt "NpcYell:5360:0:13"
msgid "A near flawless victory!"
msgstr "Победа почти безупречна!"

#. ja: 反省点も多かろう
#. de: Wir müssen noch einiges lernen.
#. fr: Incroyable...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5361:0:13"
msgid "There is much we can<br>learn from today's defeat."
msgstr "Из сегодняшнего поражения<br>есть чему поучиться."

#. ja: 実力差が<br>ありすぎる…
#. de: Ein himmelweiter Unterschied!
#. fr: L'écart est tellement immense...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5362:0:13"
msgid "It will be moons before these<br>men and women are ready."
msgstr "Пройдёт ещё немало лун, прежде чем<br>эти бойцы будут готовы."

#. ja: さすがだな…
#. de: Unglaublich ...
#. fr: Pfiou, rien à faire...
msgctxt "NpcYell:5363:0:13"
msgid "By the Fury's spear..."
msgstr "Вот это мощь Ярости..."

#. ja: 怪我人は<br>申告するように！
#. de: Verletzte bitte melden!
#. fr: Qui est blessé<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5364:0:13"
msgid "Carry the wounded<br>to the barbers' tents!"
msgstr "Раненых — в палатки лекарей!"

#. ja: 素晴らしい！
#. de: Beeindruckend!
#. fr: Magnifique<nbsp>!
msgctxt "NpcYell:5365:0:13"
msgid "The stories were true!"
msgstr "Легенды не врали!"

#. ja: システム起動…<br>兵装ロック解除…
#. de: System aktiv ... Schloss entriegelt.
#. fr: Ennemis repérés... Sécurité désenclenchée...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5369:0:13"
msgid "Enemy sighted... Safety<br>locks disengaged..."
msgstr "Враг замечен... Предохранители<br>отключены..."

#. ja: 目標ロックオン…
#. de: Ziel im Visier.
#. fr: Cible verrouillée...
msgctxt "NpcYell:5370:0:13"
msgid "Target acquired..."
msgstr "Цель захвачена..."

#. ja: いくぞ…！
#. de: Und los!
#. fr: Que la chasse commence<nbsp>!
msgctxt "NpcYell:5371:0:13"
msgid "Let us begin."
msgstr "Начнём."

#. ja: 斬る…
#. de: Ein sauberer Schnitt ...
#. fr: Ça va saigner...
msgctxt "NpcYell:5372:0:13"
msgid "Kill..."
msgstr "Убить..."

#. ja: いいぞ、もっとだ…！
#. de: Los, bring es zu Ende!
#. fr: Oui, c'est exactement ça<nbsp>!
msgctxt "NpcYell:5373:0:13"
msgid "Yes, yes, just so!"
msgstr "Да, да, вот так!"

#. ja: 次だ…
#. de: Auf ein Neues!
#. fr: Au suivant...
msgctxt "NpcYell:5374:0:13"
msgid "More..."
msgstr "Ещё..."

#. ja: クククククク…
#. de: Hahah ... khkh ... hhh ...
#. fr: Ha ha ha ha ha...
msgctxt "NpcYell:5375:0:13"
msgid "Ahahahahahaha!"
msgstr "Аха-ха-ха-ха!"

#. ja: 滅す…
#. de: Und ein Leben verlischt!
#. fr: Un vrai carnage...
msgctxt "NpcYell:5376:0:13"
msgid "Rend..."
msgstr "Растерзать..."

#. ja: 終わりだ…
#. de: Euer Ende naht!
#. fr: C'est la fin...
msgctxt "NpcYell:5377:0:13"
msgid "This is the end..."
msgstr "Это конец..."

#. ja: うわあああ、もう終わりだ！
#. de: Ugetsu hat verloren! Wir sind am Ende!
#. fr: Ugetsu a perdu<nbsp>! Faut se barrer d'ici<nbsp>!
msgctxt "NpcYell:5378:0:13"
msgid "L-Lord Ugetsu has fallen!"
msgstr "Л-лорд Угэцу пал!"

#. ja: バカな！<br>こんなことがあるのか！
#. de: Nein! Das kann nicht sein!
#. fr: Non<nbsp>! Impossible<nbsp>!
msgctxt "NpcYell:5379:0:13"
msgid "No! Th-This cannot be!"
msgstr "Нет! Э-этого не может быть!"

#. ja: もうお終いだああああ！
#. de: Uaaahhh! Die machen uns fertig!
#. fr: On est foutus<nbsp>!
msgctxt "NpcYell:5380:0:13"
msgid "It's over! We're finished!"
msgstr "Всё кончено! Нам конец!"

#. ja: 腹ぺこっちゃ！
#. de: Fleisch! Fleisch! Fleisch!
#. fr: Viande<nbsp>! Viande<nbsp>! Viande<nbsp>!
msgctxt "NpcYell:5381:0:13"
msgid "Meat! Meat! Meat!"
msgstr "Мясо! Мясо! Мясо!"

#. ja: 大人しくするっちゃ！
#. de: Mimiroon dich roh essen!
#. fr: Mimiroon te manger touuut<if $gn4>e</if> cruuu<if $gn4>e</if><nbsp>!
msgctxt "NpcYell:5383:0:13"
msgid "Mimiroon eat you raw!"
msgstr "Мимируун съесть тебя сырым!"

#. ja: 逃げるっちゃ！
#. de: Mimiroooooon!
#. fr: Déguerpir<nbsp>! Vite<nbsp>! Vite<nbsp>!
msgctxt "NpcYell:5384:0:13"
msgid "Mimiroooooon!"
msgstr "Мимируууун!"

#. ja: 痛い痛いっちゃ…
#. de: Der Schmerz! Der schmerzvolle Schmerz!
#. fr: Ouuuille<nbsp>!
msgctxt "NpcYell:5386:0:13"
msgid "The pain! The painful pain!"
msgstr "Больно! Как же больно!"

#. ja: ミミルン守るっちゃ！<br>集まれ集まれっちゃ！
#. de: Zu Mimiroon! Zu Mimiroon!
#. fr: Mimiroon avoir besoin d'être protégé<nbsp>! Qiqirns devoir se rassembler<nbsp>!
msgctxt "NpcYell:5387:0:13"
msgid "To Mimiroon! To Mimiroon!"
msgstr "К Мимирууну! К Мимирууну!"

#. ja: ミミルン助けるっちゃ！<br>みんな手を貸すっちゃ！
#. de: Zu Mimiroon! Zu Mimiroon!
#. fr: Mimiroon faiblir<nbsp>! Qiqirns devoir aider<nbsp>!
msgctxt "NpcYell:5388:0:13"
msgid "To Mimiroon! To Mimiroon!"
msgstr "К Мимирууну! К Мимирууну!"

#. ja: ミミルン負けそうっちゃ！<br>どんどん出てこいっちゃ！
#. de: Zu Mimiroon! Zu Mimiroon!
#. fr: Mimiroon tituber<nbsp>! Qiqirns devoir partir<nbsp>!
msgctxt "NpcYell:5389:0:13"
msgid "To Mimiroon! To Mimiroon!"
msgstr "К Мимирууну! К Мимирууну!"

#. ja: 数で押せ押せっちゃ！
#. de: Fleischliebende Freunde! Fressen!
#. fr: <if $gn4>Aventurière<else>Aventurier</if> rien pouvoir faire face aux nombreux Qiqirns de Mimiroon<nbsp>!
msgctxt "NpcYell:5390:0:13"
msgid "Meat-loving minions! Mangle!"
msgstr "Мясолюбивые прислужники! Раздирать!"

#. ja: 反撃っちゃ！
#. de: Fleischliebende Freunde! Mampfen!
#. fr: Mimiroon contre-attaquer<nbsp>!
msgctxt "NpcYell:5391:0:13"
msgid "Meat-loving minions! Maim!"
msgstr "Мясолюбивые прислужники! Увечить!"

#. ja: ボッコボコっちゃ！
#. de: Fleischliebende Freunde! Knabbern!
#. fr: Mimiroo...<nbsp>! (touuuusse) (touuuusse)
msgctxt "NpcYell:5392:0:13"
msgid "Meat-loving minions! Maul!"
msgstr "Мясолюбивые прислужники! Грызть!"

#. ja: こうなったら<br>ミミルンの出番っちゃ！
#. de: Fleischliebende Freund! Fleischliebende Freun...? Keine Freunde mehr, ja?
#. fr: Mouuutarde monter au nez à Mimiroon<nbsp>! Mimiroon montrer comment chasser<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5393:0:13"
msgid "Meat-loving minions!<br>Meat-loving minions...?<br>No more minions, eh?"
msgstr "Мясолюбивые прислужники!<br>Мясолюбивые прислужники?.. <br>А, прислужников-то больше нет?"

#. ja: 今まででいちばん<br>豪勢な夕食にするっちゃ！
#. de: Dann Mimiroon selber nagen wird!
#. fr: Mimiroon attendrir viande<nbsp>! Qiqirns ripailler<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5394:0:13"
msgid "Then Mimiroon shall meet<br>the meat we beat to eat!"
msgstr "Тогда Мимируун устроит<br>пир из мяса, что мы побили!"

#. ja: 失敗っちゃ…<br>悲しいっちゃ…
#. de: Mimiroon seeehr traurig sein!
#. fr: Mimiroon touuut triste... (snif)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5396:0:13"
msgid "Mimiroon is saddened with<br>much sadness! Sad!"
msgstr "Мимируун очень грустно<br>из-за неудачи! Грустно!"

#. ja: 絶望っちゃ…
#. de: \<schnief>
#. fr: Non... (snif) (snif)
msgctxt "NpcYell:5397:0:13"
msgid "Ulp!"
msgstr "Упс!"

#. ja: ひいい…<br>助けてぇ～！
#. de: Vater!
#. fr: Aaah<nbsp>! Nan<nbsp>! À l'aide<nbsp>! Papaaa<nbsp>!!!
msgctxt "NpcYell:5398:0:13"
msgid "Father!!!"
msgstr "Папа!!!"

#. ja: お、おい！<br>いったい何事だ！？
#. de: Ihr seht aus, als wärt ihr in den Sieben Höllen gewesen! Berichtet!
#. fr: Hé hé ho<nbsp>! Qu'est-ce qui vous arrive, vous trois<nbsp>? Au rapport<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5399:0:13"
msgid "You lot look like you've<br>been to the seventh hell and<br>back. Report!"
msgstr "Вы трое будто побывали<br>в седьмом аду и вернулись.<br>Докладывайте!"

#. ja: 放棄された魔導兵器を<br>発見したんだ！
#. de: Wir sind auf etwas gestoßen, das wir für die Überreste einer garleischen Kampfmaschine hielten.
#. fr: Nous avons découvert une arme magitek abandonnée. Elle nous a pris en chasse<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5400:0:13"
msgid "We discovered what we<br>thought were the remains<br>of imperial warmachina."
msgstr "Мы нашли то, что приняли<br>за останки имперской<br>боевой машины."

#. ja: なんだと！？
#. de: Hielten?
#. fr: Q-quoi<nbsp>!?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5402:0:13"
msgid "<i>Were</i> the remains?"
msgstr "<i>Были</i> останки?"

#. ja: アラギリに近づけるわけには！
#. de: Ja! Sie erwachte vor unseren Augen und hat die Verfolgung aufgenommen. Wir können nicht nach Ala Ghiri zurückkehren, ohne das Camp zu gefährden!
#. fr: Elle se rapproche en ce moment même, on ne peut pas la laisser atteindre Ala Ghiri<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5403:0:13"
msgid "It came to life and started<br>tracking us. We cannot<br>return to Ala Ghiri without<br>putting the camp in danger!"
msgstr "Она ожила и пустилась<br>за нами. Нельзя возвращаться<br>в Ала Гири, подвергая лагерь<br>опасности!"

#. ja: ならばやることは<br>ひとつだけ！
#. de: Dann gibt es nur eine Möglichkeit.
#. fr: À ce compte-là, la solution est toute trouvée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5404:0:13"
msgid "Then that leaves us<br>but one option."
msgstr "Тогда у нас остаётся<br>только один выход."

#. ja: ヤツを破壊するぞ！
#. de: Wir zerstören sie.
#. fr: On la met en pièces<nbsp>!
msgctxt "NpcYell:5405:0:13"
msgid "We destroy it..."
msgstr "Уничтожим её..."

#. ja: 選択肢はない…<br>か…
#. de: Oder sterben bei dem Versuch<nbsp>...
#. fr: C'est... C'est vraiment notre seul choix...
msgctxt "NpcYell:5407:0:13"
msgid "Or die trying."
msgstr "Или погибнем, пытаясь."

#. ja: こ、この戦力で！？
#. de: Das sind aber zwei Möglichkeiten ...
#. fr: M-mais nous et quelle armée<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5408:0:13"
msgid "That's technically<br>two options..."
msgstr "С такими-то силами?<br>Это вообще-то два варианта..."

#. ja: こ、こっちに…<br>来るなッ！
#. de: Wir haben keine Zeit!
#. fr: Non<nbsp>! Pas moi<nbsp>! Je veux pas mourir<nbsp>!
msgctxt "NpcYell:5409:0:13"
msgid "We're running out of time!"
msgstr "Мы теряем время!"

#. ja: あれか！？
#. de: Allmächtiger Rhalgr ...
#. fr: Par Rhalgr...
msgctxt "NpcYell:5410:0:13"
msgid "Rhalgr almighty..."
msgstr "О всемогущий Ралгр..."

#. ja: 破壊するぞ！
#. de: Zielt auf die Triebwerke!
#. fr: Allez<nbsp>! On se la fait<nbsp>!
msgctxt "NpcYell:5411:0:13"
msgid "Aim for its engines!"
msgstr "Цельтесь по двигателям!"

#. ja: 発見した！
#. de: Da ist sie!
#. fr: La voilà<nbsp>!
msgctxt "NpcYell:5412:0:13"
msgid "There it is!"
msgstr "Вон она!"

#. ja: これ以上、進めるものか！
#. de: Wir müssen sie stoppen. Oder zumindest aufhalten, bis Verstärkung kommt!
#. fr: Tu iras pas plus loin<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5413:0:13"
msgid "We must stop it, or at least<br>slow it down till reinforce-<br>ments arrive!"
msgstr "Нужно остановить её или хотя бы<br>задержать до прибытия подкрепления!"

#. ja: オラッ！
#. de: Grah!
#. fr: Pour Ala Ghiri<nbsp>!
msgctxt "NpcYell:5414:0:13"
msgid "Grah!"
msgstr "Грах!"

#. ja: くらえっ！
#. de: Hnng!
#. fr: Prends ça, tas de ferraille<nbsp>!
msgctxt "NpcYell:5415:0:13"
msgid "Hnnng!"
msgstr "Хнннг!"

#. ja: でやっ！
#. de: Für Ala Mhigo!
#. fr: Hiiyaaa<nbsp>!
msgctxt "NpcYell:5416:0:13"
msgid "For Ala Mhigo!"
msgstr "За Ала Миго!"

#. ja: うおぉぉ！
#. de: Sie ... gibt ... kein Stück nach!
#. fr: Yaaahh<nbsp>!
msgctxt "NpcYell:5417:0:13"
msgid "It...won't...budge!"
msgstr "Она... не... поддаётся!"

#. ja: も、もうお終いだ…
#. de: Was haben wir getan?!
#. fr: Les Douze aient pitié de nous...
msgctxt "NpcYell:5418:0:13"
msgid "What have we done...?"
msgstr "Что же мы наделали?.."

#. ja: ガガガガ…<br>敵反応、検知…
#. de: Scanne ... Scanne ... Zielbewegung erfasst.
#. fr: CHKLONK CHKLONK CHKLONK... Présence ennemie détectée... Protocole d'acquisition engagé...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5419:0:13"
msgid "Scanning... Scanning...<br>Target movement detected."
msgstr "Сканирование... Сканирование...<br>Обнаружено движение цели."

#. ja: 目ヒョウ…移ドウ…<br>追セキ…開始…
#. de: Verfolgungsmodus initiiert ... Ziel gefunden.
#. fr: Cible perdue... Protocole de poursuite engagée...
msgctxt "NpcYell:5420:0:13"
msgid "Initiating tracking protocol...Target located."
msgstr "Запуск протокола слежения... Цель обнаружена."

#. ja: 索テキ…開始…
#. de: Systeme hochgefahren ... Scanne ... Scanne ...
#. fr: ReSTaUrAtiOn SyStèmE... Complète... Activation...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5422:0:13"
msgid "Systems online...<br>Scanning... Scanning..."
msgstr "Системы активны...<br>Сканирование... Сканирование..."

#. ja: 目ヒョウ…補ソク…
#. de: Ziel identifiziert ... Speichervorgang ...
#. fr: Cible verrouillée...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5423:0:13"
msgid "Target identified.<br>Writing to memory........."
msgstr "Цель обнаружена.<br>Запись в память........."

#. ja: ガガガ…<br>戦闘……開始……
#. de: Bzzzzzzzt ... Kampfmodus initiiert ...
#. fr: CHKLONK CHKLONK CHKLONK... Initialisation des protocoles de combat...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5424:0:13"
msgid "Bzzzzzzt...<br>Initiating battle protocol..."
msgstr "Бззззз...<br>Запуск боевого протокола..."

#. ja: ビット…射シュツ…
#. de: Warte auf Erlaubnis zur Drohnenentsendung ... Erlaubnis erteilt ...
#. fr: Activation... Drone... Déploiement...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5425:0:13"
msgid "Awaiting bit deployment authorization......<br>Authorization granted."
msgstr "Ожидание разрешения на запуск битов......<br>Разрешение получено."

#. ja: スラッシャー…起ドウ…
#. de: Warte auf Erlaubnis zur Schlitzerentsendung ... Erlaubnis erteilt ...
#. fr: Activation... Lacératrice... Déploiement...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5426:0:13"
msgid "Awaiting slasher deployment authorization......<br>Authorization granted."
msgstr "Ожидание разрешения на запуск резаков......<br>Разрешение получено."

#. ja: 目標…到タツ…<br>無差ベツ…攻撃開シ…
#. de: Ziel erfasst ... Auslöschung eingeleitet ...
#. fr: Objectif atteint... Arsenal déverrouillé... Protocole d'éradication totale enclenché...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5427:0:13"
msgid "Target locked on.<br>Initiating eradication protocol..."
msgstr "Цель захвачена.<br>Запуск протокола уничтожения..."

#. ja: くっ…コイツは痛いな！
#. de: Argh! Das tut weh!
#. fr: Aïe... Ça fait mal<nbsp>!
msgctxt "NpcYell:5429:0:13"
msgid "Ouch. That hurt..."
msgstr "Ай... Больно..."

#. ja: クルルルル！
#. de: Springt, kleine Fröschlein ♪
#. fr: Coâââ<nbsp>!
msgctxt "NpcYell:5430:0:13"
msgid "Croak for me!"
msgstr "Квакай для меня!"

#. ja: カルルルル！
#. de: Zeit zu watscheln ♪
#. fr: Abracadabra<nbsp>!
msgctxt "NpcYell:5431:0:13"
msgid "Squelch for me!"
msgstr "Булькай для меня!"

#. ja: ポルルルル！
#. de: Quiekt für mich ♪
#. fr: Abracadabri<nbsp>!
msgctxt "NpcYell:5432:0:13"
msgid "Oink for me!"
msgstr "Хрюкай для меня!"

#. ja: 剣の舞い！
#. de: Tanz der Schwerter!
#. fr: Admirez ma danse du sabre<nbsp>!
msgctxt "NpcYell:5433:0:13"
msgid "Dance of swords!"
msgstr "Танец мечей!"

#. ja: 茨の舞い！
#. de: Tanz der Dornen!
#. fr: Attention ça va piquer<nbsp>!
msgctxt "NpcYell:5434:0:13"
msgid "Dance of thorns!"
msgstr "Танец шипов!"

#. ja: 大地の舞い！
#. de: Tanz der Erde!
#. fr: La terre va danser<nbsp>!
msgctxt "NpcYell:5435:0:13"
msgid "Dance of the earth!"
msgstr "Танец земли!"

#. ja: 読書の舞い！
#. de: Tanz der Schriften!
#. fr: J'appelle cette danse la danse de la lecture<nbsp>!
msgctxt "NpcYell:5436:0:13"
msgid "Dance of letters!"
msgstr "Танец букв!"

#. ja: トークン配置…<br>ソウルリーパー！
#. de: Seelen soll'n in Stücke fallen!
#. fr: Faucheurs d'âmes, offrez-moi la victoire<nbsp>!
msgctxt "NpcYell:5437:0:13"
msgid "Soul reapers, claim your prize!"
msgstr "Жнецы душ, принесите мне победу!"

#. ja: トークン配置…<br>ホワイトフレイム！
#. de: Weiße Flammen, brennet grell!
#. fr: Flammes blanches, je vous invoque<nbsp>!
msgctxt "NpcYell:5438:0:13"
msgid "White flame, reduce all to ash!"
msgstr "Белое пламя, обрати всё в пепел!"

#. ja: トークン配置…<br>ドラゴングレイト！
#. de: Schwingen, die die Sonn' verdecken!
#. fr: Ô, dragon suprême, viens à moi<nbsp>!
msgctxt "NpcYell:5439:0:13"
msgid "Great dragon, feed on flesh!"
msgstr "Великий дракон, насыться плотью!"

#. ja: トークン配置…<br>アパンダ！
#. de: Hörner spitz wie Speere!
#. fr: Apandas, prêtez-moi votre force<nbsp>!
msgctxt "NpcYell:5440:0:13"
msgid "Apanda, smite mine enemy!"
msgstr "Апанда, срази врага моего!"

#. ja: トークン配置…<br>あれも、これもだ！
#. de: Meine Diener, kämpft vereint!
#. fr: J'ai encore des pions en réserve<nbsp>!
msgctxt "NpcYell:5441:0:13"
msgid "All tokens, gather to me!"
msgstr "Все жетоны, ко мне!"

#. ja: 連続魔法剣！
#. de: Sturm der Zauberklinge!
#. fr: Un sort, c'est bien, deux, c'est mieux<nbsp>!
msgctxt "NpcYell:5442:0:13"
msgid "A storm of swords and spells!"
msgstr "Буря мечей и заклинаний!"

#. ja: シュー…今の戦い<br>見させてもらった
#. de: Was für eine Ssschlacht!
#. fr: Tu m'as vraiment im<shy>pres<shy>sion<shy>née, à l'instant. Ssss...
msgctxt "NpcYell:5443:0:13"
msgid "Ssstrider of peak and valley."
msgstr "Свист... Путник гор и долин."

#. ja: その腕前…<br>ヒトの子の英雄と見た！
#. de: So kämpft nur <if $gn4>eine wahre Heldin<else>ein wahrer Held</if>!
#. fr: Tu es bien <if $gn4>l'héroïne<else>le héros</if> des humains<nbsp>! Ssss...
msgctxt "NpcYell:5444:0:13"
msgid "Before you ssstood a monssster..."
msgstr "Перед тобой стоял монстр..."

#. ja: 最大の敬意として<br>手合わせを願いたい！
#. de: Es wäre mir eine Ehre ...
#. fr: Il y a longtemps que j'attendais de rencontrer quelqu'un d'aussi fort... Ssss...
msgctxt "NpcYell:5445:0:13"
msgid "Yet not once did you show any sssign of fear."
msgstr "Но ты ни разу не дрогнул от страха."

#. ja: ヒトの子の英雄よ！<br>勝負といこうぞ！
#. de: ... gegen dich zu kämpfen!
#. fr: Je te défie<nbsp>! Un duel, juste entre toi et moi<nbsp>! Ssss...
msgctxt "NpcYell:5446:0:13"
msgid "Long have I desired to face one sssuch as you."
msgstr "Я давно мечтал сразиться с таким, как ты."

#. ja: シュー…<br>本気で来い！
#. de: Keine Zurückhaltung!
#. fr: Ne retiens pas tes coups<nbsp>! Ssss...
msgctxt "NpcYell:5447:0:13"
msgid "Come! Ssstrike me down!"
msgstr "Иди! Срази меня!"

#. ja: シュー…<br>もっとだ！
#. de: Ist das allesss?
#. fr: Allez, plus vite<nbsp>! Ssss...
msgctxt "NpcYell:5448:0:13"
msgid "Harder!"
msgstr "Сильнее!"

#. ja: シュー…<br>いい腕だ！
#. de: So issst's recht!
#. fr: Pas mal du tout<nbsp>! Ssss...
msgctxt "NpcYell:5449:0:13"
msgid "Yesss!"
msgstr "Да-а!"

#. ja: シュー…<br>美しいな！
#. de: Sssehr schön!
#. fr: Bien joué<nbsp>! Ssss...
msgctxt "NpcYell:5450:0:13"
msgid "Dance!"
msgstr "Танцуй!"

#. ja: シュー…<br>私が押されている？
#. de: Du bist keck!
#. fr: Cette force...<nbsp>!? Ssss...
msgctxt "NpcYell:5451:0:13"
msgid "Enough play!"
msgstr "Хватит играть!"

#. ja: シュー…<br>意地を見せよう！
#. de: Ich bin längst nicht gessschlagen!
#. fr: Passons aux choses sérieuses<nbsp>! Ssss...
msgctxt "NpcYell:5452:0:13"
msgid "The sssun rises!"
msgstr "Солнце ещё не зашло!"

#. ja: シュー…ま、まいった！<br>英雄よ、そなたの勝利だ！
#. de: Ich gebe mich gessschlagen!
#. fr: C'est bon <if $gn4>humaine<else>humain</if>, tu as gagné<nbsp>! Ssss...
msgctxt "NpcYell:5453:0:13"
msgid "Hero of the wessst, I yield!"
msgstr "Герой запада, сдаюсь!"

#. ja: シュー…ここまでとしよう！<br>良き手合わせであった！
#. de: Lassen wir es hierbei bewenden. Danke für den Kampf!
#. fr: Tu dois reconnaître ta défaite, <if $gn4>humaine<else>humain</if>. Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5454:0:13"
msgid "I have ssseen enough.<br>My thanksss, traveler."
msgstr "Я увидел достаточно.<br>Благодарю за бой, путник."

#. ja: あら…野良試合？
#. de: Nanu? Ein Trainingskampf?
#. fr: Tiens, un duel<nbsp>?
msgctxt "NpcYell:5455:0:13"
msgid "What do we have here?"
msgstr "Что тут у нас?"

#. ja: シュー…ヒトの子との<br>手合わせか？
#. de: Ein Wettkampf mit <if $gn4>einer Zweibeinerin<else>einem Zweibeiner</if>?
#. fr: Intéressant... Ssss...
msgctxt "NpcYell:5456:0:13"
msgid "A tessst of mettle!"
msgstr "Проверка на прочность!"

#. ja: ふう、いい戦いぶり！<br>両者を称えるわ！
#. de: Ein guter Kampf! Auf beiden Seiten!
#. fr: Quel combat<nbsp>! Bravo aux deux adversairrres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5461:0:13"
msgid "What a finish! My sisters<br>will want to hear of this!"
msgstr "Вот это бой! Сёстры захотят<br>услышать о таком!"

#. ja: シュー…ヒトの子にも<br>このような勇者がいるとは！
#. de: So viel Ssschneid hätte ich <if $gn4>einer Zweibeinerin<else>einem Zweibeiner</if> nicht zugetraut!
#. fr: Je ne savais pas qu'il y avait des humains aussi forts... Ssss...
msgctxt "NpcYell:5462:0:13"
msgid "As will mine."
msgstr "Мои — тоже."

#. ja: 今度は負けないでね！
#. de: Beim nächsten Mal klappt's bestimmt!
#. fr: Ne vous en faites pas, vous ferrrez mieux la prochaine fois<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5463:0:13"
msgid "Do not feel bad. She <i>is</i><br>their champion and all."
msgstr "Не расстраивайся. Она <i>всё-таки</i><br>их чемпионка."

#. ja: シュー…またの機会を<br>楽しみにしよう
#. de: Heute war nicht dein Tag ...
#. fr: J'ai hâte de voir la revanche. Ssss...
msgctxt "NpcYell:5464:0:13"
msgid "Never will her sssun ssset!"
msgstr "Её солнцу не суждено зайти!"

#. ja: ミミルンを<br>守るっちゃ！
#. de: Zu Mimiroon! Zu Mimiroon!
#. fr: Protéger Mimiroon<nbsp>!
msgctxt "NpcYell:5465:0:13"
msgid "To Mimiroon! To Mimiroon!"
msgstr "Защитить Мимирууна!"

#. ja: 強すぎっちゃ！
#. de: Fleisch viel zu zäh!
#. fr: <if $gn4>Aventuuurière<else>Aventuuurier</if> trop robuuuste<nbsp>!
msgctxt "NpcYell:5468:0:13"
msgid "Tough meat too tough!"
msgstr "Слишком жёсткое мясо!"

#. ja: とんずらっちゃ！
#. de: Mimiroooooon!
#. fr: Mimiroon tomber<nbsp>! Temps de filer<nbsp>!
msgctxt "NpcYell:5470:0:13"
msgid "Mimiroooooon!"
msgstr "Мимируууун!"

#. ja: 竜詩戦争の英雄…<br>やはり本物だ
#. de: Nicht umsonst also besingt man <if $gn4>sie<else>ihn</if> als <if $gn4>Heldin<else>Helden</if> der Drachenkriege!
#. fr: On parle quand même <if $gn4>de l'héroïne<else>du héros</if> de la Guerre du chant des dragons<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:5471:0:13"
msgid "There is not a knight in all<br>the See who hasn't heard of<br><split \" \" 1><string $gs1></split>'s heroism..."
msgstr "Во всём Морском пределе<br>нет рыцаря, который не слышал<br>о подвигах <split \" \" 1><string $gs1></split>..."

#. ja: 私も手合わせ<br>願いたいものだが…
#. de: <if $gn4>Die<else>Der</if> könnte auch uns behilflich sein.
#. fr: Je lui demanderais bien de m'entraîner, tiens...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:5472:0:13"
msgid "Or who does not dream of<br>testing his mettle against<br><if $gn4>her<else>him</if>."
msgstr "Или кто не мечтает<br>помериться силами с<br><if $gn4>ней<else>ним</if>."

#. ja: 確かに、この好機<br>逃す手はないニャ
#. de: Das wäre wahrlich grandios!
#. fr: Tu en aurrrais bien besoin<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5473:0:13"
msgid "Are you suggesting what I<br>think you're suggesting?"
msgstr "Ты намекаешь на то, о чём я думаю?"

#. ja: …おい
#. de: He.
#. fr: Hé, j'te permets pas<nbsp>!
msgctxt "NpcYell:5474:0:13"
msgid "Ahem!"
msgstr "Кхм!"

#. ja: 観念しろっちゃ！
#. de: Kleinhacken!
#. fr: Toi garnir table de Mimiroon<nbsp>!
msgctxt "NpcYell:5475:0:13"
msgid "Filet!"
msgstr "Филе!"

#. ja: くらえっちゃ！
#. de: Weichklopfen!
#. fr: Toi prendre ça<nbsp>!
msgctxt "NpcYell:5477:0:13"
msgid "Tenderize!"
msgstr "Получай!"

#. ja: こいつらは<br>くれてやるっちゃ！
#. de: Hunger weggegangen ...
#. fr: Qiqirn libérer Qiqirns<nbsp>!
msgctxt "NpcYell:5478:0:13"
msgid "Lost my appetite, I have..."
msgstr "Что-то аппетит пропал..."

#. ja: 助かったっちゃ！<br>命の恩人っちゃ！
#. de: Heute ist guter Tag!
#. fr: <if $gn4>Aventuuurière<else>Aventuuurier</if> avoir sauvé Qiqirns<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5479:0:13"
msgid "Oh most glorious of<br>glorious days!"
msgstr "О, славнейший из славных дней!"

#. ja: ありがとっちゃ！<br>恩に着るっちゃ！
#. de: Freiheit! Frei!
#. fr: Qiqirns être enfin libres<nbsp>! Qiqirns jamais oublier <if $gn4>gentille aventuuurière<else>gentil aventuuurier</if><nbsp>!
msgctxt "NpcYell:5480:0:13"
msgid "Freedom! Freedom!"
msgstr "Свобода! Свобода!"

#. ja: さあ、水を汲まないと…
#. de: Die Krüge füllen sich nicht von alleine.
#. fr: Et maintenant, l'eau. C'est parrrti.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5481:0:13"
msgid "These jars won't<br>fill themselves."
msgstr "Кувшины сами себя не наполнят."

#. ja: あら？
#. de: Hm? Ist da jemand?
#. fr: Qu'est-ce que c'était que ce brrruit<nbsp>?
msgctxt "NpcYell:5482:0:13"
msgid "Hm? Is anyone there?"
msgstr "А? Кто там?"

#. ja: きゃあ！<br>助けてっ！
#. de: Najaq! Hilfe!
#. fr: Hiiiyaaah<nbsp>! À l'aide<nbsp>!
msgctxt "NpcYell:5483:0:13"
msgid "Najaq! Help!"
msgstr "Наджак! Помогите!"

#. ja: 大丈夫か！<br>今、助けるぞ！
#. de: Versteck dich! Ich erledige das!
#. fr: Cours te mettre à l'abrrris<nbsp>! Je vais te sauver<nbsp>!
msgctxt "NpcYell:5484:0:13"
msgid "Hide! I shall deal with these."
msgstr "Скройся! Я с ними разберусь."

#. ja: こんなハズでは…
#. de: So darf es nicht enden ... Ich muss meine Pflicht erfüllen ...
#. fr: Non... Je dois... prrotéger... les m...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5485:0:13"
msgid "It cannot end here...<br>I must protect my charge..."
msgstr "Неужели всё кончено... Я должен защитить свою подопечную..."

#. ja: な、なんだ！？<br>コイツは…
#. de: Wie ist der denn drauf?
#. fr: J-jai jamais vu un Namazu pareil...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5487:0:13"
msgid "What do you think's<br>wrong with the fry?"
msgstr "Что это с мальком?"

#. ja: ウグッ…
#. de: Urgh<nbsp>...
#. fr: Urgh...
msgctxt "NpcYell:5488:0:13"
msgid "Hnnnh..."
msgstr "Хннн..."

#. ja: アゥ…ァ…
#. de: Aaargh<nbsp>...
#. fr: Argh... Aaah...
msgctxt "NpcYell:5489:0:13"
msgid "Ahhh..."
msgstr "А-а-а..."

#. ja: どこかに行け！
#. de: Hinfort mit euch!
#. fr: Fichez le camp, sales monstrrres<nbsp>!
msgctxt "NpcYell:5490:0:13"
msgid "Begone, foul beasts!"
msgstr "Прочь, мерзкие твари!"

#. ja: ワン…ワン…？
#. de: \<wuff><nbsp>...?
#. fr: Ahrgl... Rhaa....
msgctxt "NpcYell:5491:0:13"
msgid "Woof?"
msgstr "Гав?"

#. ja: 負けるわけには！
#. de: J'najaq Sonnengleißen wird diese Welt nicht als Feigling verlassen!
#. fr: Vous ne m'aurrrez pas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5492:0:13"
msgid "J'najaq Sunflare will not<br>leave this realm a coward!"
msgstr "Дж'наджак Солнечный Всполох не покинет этот мир трусом!"

#. ja: あっ…オジちゃん<br>今日も来てる！
#. de: Hallo, Herr Samurai! Heute auch hier?
#. fr: Oh, c'est le vieux vagabond<nbsp>!
msgctxt "NpcYell:5493:0:13"
msgid "The Hingan's back!"
msgstr "Хинганец опять пришёл!"

#. ja: 勝負の相手…<br>まだ探してるの？
#. de: Suchst du jemanden, mit dem du dich messen kannst?
#. fr: Tu recherches toujours un partenaire d'en<shy>traî<shy>ne<shy>ment, papy<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5494:0:13"
msgid "Still looking to<br>“test your medals?”"
msgstr "Всё ещё ищешь, с кем бы «проверить свои медали»?"

#. ja: 左様だ…<br>誰ぞ、挑戦者はおらんか！
#. de: Sehr richtig, kleines Mädchen. Aber leider hat niemand den Mut, es mit mir aufzunehmen.
#. fr: Oui, mon enfant... N'y a-t-il donc personne qui ose défier le vieux Senban, ici<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5495:0:13"
msgid "Aye, young one. Would that<br>there were a single brave<br>soul on this whole isle..."
msgstr "Именно, дитя. Да найдётся ли на всём острове хоть одна храбрая душа..."

#. ja: ねぇねぇ<br>アタシと遊ぼうよ～
#. de: Du könntest dich ja mit mir im Muscheln sammeln messen!
#. fr: C'est pas grave, je peux te montrer un bon coin à coquillages, si tu veux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5496:0:13"
msgid "You could always look for<br>shells with me."
msgstr "Можешь поискать ракушки со мной."

#. ja: 我は修行中の身<br>童の相手などできるか！
#. de: Das könnte ich, aber ich bezweifle, dass mich das zum größten Schwertkämpfer von Hingashi macht.
#. fr: C'est très aimable à toi ma petite, mais je suis venu ici pour tester ma maîtrise du katana.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5497:0:13"
msgid "I could, but shells will not<br>see me the greatest<br>bladesman in Hingashi."
msgstr "Могу, но от ракушек я не стану величайшим мечником Хингаси."

#. ja: 我の名はセンバン！<br>いざ尋常に勝負ッ！
#. de: Vor euch steht Senban Einklinge!
#. fr: Combattants, la lame vagabonde vous attend<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5498:0:13"
msgid "I am Senban Oneblade.<br>You will find honor in<br>defeat at mine hands!"
msgstr "Я — Сэнбан Однолезвийный! Выстоишь ли ты против меня?"

#. ja: がんばって～！
#. de: Gib ihm eine Breitseite!
#. fr: Attention à ta garde<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5499:0:13"
msgid "THERE!<br>THE GAP AT HIS FLANK!"
msgstr "ВОН ТАМ! У НЕГО БОК ОТКРЫТ!"

#. ja: 怪我しないでねっ！
#. de: Oben antäuschen, unten zustechen!
#. fr: Feinte-le<nbsp>!
msgctxt "NpcYell:5500:0:13"
msgid "FEINT HIGH! STAB LOW!"
msgstr "ФИНТИ СВЕРХУ! КОЛИ СНИЗУ!"

#. ja: フンッ！
#. de: Hmpf!
#. fr: Hmph<nbsp>!
msgctxt "NpcYell:5501:0:13"
msgid "Hmph!"
msgstr "Хм!"

#. ja: そんなものか！
#. de: Lächerlich!
#. fr: Pathétique<nbsp>!
msgctxt "NpcYell:5502:0:13"
msgid "Pathetic!"
msgstr "Жалко!"

#. ja: やるな、お主…
#. de: Ah, ein guter Versuch!
#. fr: Intéressant...
msgctxt "NpcYell:5503:0:13"
msgid "Well played!"
msgstr "Неплохо!"

#. ja: だが、まだまだ！
#. de: Wir sind noch lange nicht fertig.
#. fr: On commence juste l'échauf<shy>fe<shy>ment<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5504:0:13"
msgid "But I am not<br>finished with you yet!"
msgstr "Но я ещё не закончил с тобой!"

#. ja: セイヤァァァ！
#. de: Uaaah!
#. fr: Yaah<nbsp>!
msgctxt "NpcYell:5505:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: トリャァァァ！
#. de: Hiiijaaa!
#. fr: Grrr<nbsp>!
msgctxt "NpcYell:5506:0:13"
msgid "Nnngaaah!"
msgstr "Нннга-а-а!"

#. ja: ま、ま、参った！<br>我の負けだ！
#. de: Ich geb auf! Du hast gewonnen.
#. fr: J'abandonne, tu as gagné<nbsp>!
msgctxt "NpcYell:5507:0:13"
msgid "I yield! I yield!"
msgstr "Сдаюсь! Сдаюсь!"

#. ja: 見事な腕前、感服いたした<br>あっぱれ、あっぱれ！
#. de: Das war sehr beeindruckend, Ijin. Du kämpfst mit der Seele <if $gn4>einer Hinganerin<else>eines Hinganers</if>.
#. fr: C'était très im<shy>pres<shy>sion<shy>nant<nbsp>! Je suis honoré d'avoir pu combattre un adversaire aussi fort que toi.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5508:0:13"
msgid "Well done, ijin.<br>I daresay you fight with<br>the heart of a Hingan."
msgstr "Отлично, иджин. Бьюсь об заклад, ты сражаешься с сердцем хинганца."

#. ja: 我の勝ちのようだな…<br>出直してまいれ！
#. de: Ich hatte Gerüchte über die Stärke der Eorzäer gehört ... Jetzt weiß ich, es waren nur Gerüchte.
#. fr: Arrêtons-nous ici, j'en ai assez vu. Entraîne-toi davantage si tu veux me vaincre un jour<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5509:0:13"
msgid "Hmph. Perhaps the rumors I<br>heard of Eorzean mettle<br>were exaggerated."
msgstr "Хм. Похоже, слухи о боевом мастерстве эорзейцев были преувеличены."

#. ja: オジちゃん<br>強いんだねっ！
#. de: Aber spannend war's.
#. fr: Ouah, t'es vachement fort, papy<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5510:0:13"
msgid "That <i>was</i> more fun than<br>collecting shells!"
msgstr "А ведь это было куда <i>веселее</i>, чем собирать ракушки!"

#. ja: どこだァー？<br>あの侍はどこだァー！？
#. de: Wo ist er? Wo ist Senban Einklinge?
#. fr: Où est-il<nbsp>? Où est Senban la lame vagabonde<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5511:0:13"
msgid "Where is he!?<br>Where is Senban Oneblade!?"
msgstr "Где он!? Где Сэнбан Однолезвийный!?"

#. ja: ヤツが持つ<br>銘刀カメワリ…
#. de: Ich bin hier, um mir sein Schwert zu holen.
#. fr: Kamewari, son épée...
msgctxt "NpcYell:5512:0:13"
msgid "I've come for his blade."
msgstr "Я пришёл за его клинком."

#. ja: 今日こそ奪おうと<br>来たってのにィー！
#. de: Und ich werde nicht ohne es gehen!
#. fr: ... elle sera bientôt mienne<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5513:0:13"
msgid "And I shall not<br>leave without it!"
msgstr "И без него я не уйду!"

#. ja: な、なによ！<br>アンタたち！
#. de: Wer bist du, Rotpanzer?
#. fr: Hé, attention<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5514:0:13"
msgid "Who in the seven hells<br>are you, Redback?"
msgstr "Вы ещё кто такие, во имя семи адов, Красноспин?"

#. ja: なんだ小娘ェー…<br>俺は気が立ってるんだァー！
#. de: Ich stell hier die Fragen, Göre!
#. fr: Qu'est-ce que tu veux, sale gosse<nbsp>!?
msgctxt "NpcYell:5515:0:13"
msgid "Out the mouth of babes, eh?"
msgstr "Вот как заговорила кроха!"

#. ja: きゃっ！<br>や、やめてっ！
#. de: Hilfe!
#. fr: Aïe, vous me faites mal<nbsp>!
msgctxt "NpcYell:5516:0:13"
msgid "Get away!"
msgstr "Отстань!"

#. ja: 貴様らぁっ！<br>その娘に触れるなぁっ！
#. de: He da! Schwimmhäute weg von dem Mädchen!
#. fr: Vous<nbsp>! Laissez cette enfant tranquille<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5517:0:13"
msgid "What manner of craven dares<br>threaten a mere child!?"
msgstr "Кто посмел угрожать беззащитному ребёнку!?"

#. ja: おおおっ！？<br>刀が歩いてきたぞォー！
#. de: Da bist du ja!
#. fr: Regardez qui voilà<nbsp>!
msgctxt "NpcYell:5518:0:13"
msgid "And here he is, friends!"
msgstr "А вот и он, друзья!"

#. ja: 袋だたきにして<br>奪い取ってやるぜェー！
#. de: Ich könnte dich ja zu einem Duell herausfordern ... Tu ich aber nicht. Auf ihn, Männer!
#. fr: Fais tes prières, vieil homme...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5519:0:13"
msgid "An honorable man would<br>allow you to tend to your<br>wounds, but I am no man, and<br>I care little for honor. Attack!"
msgstr "Честный человек дал бы тебе залечить раны, но мне плевать на честь. В атаку!"

#. ja: オジちゃんは<br>試合の時の怪我が…！
#. de: Der edle Samurai ist noch verletzt, von seinem letzten Kampf!
#. fr: Papy, tu t'es blessé pendant l'en<shy>traî<shy>ne<shy>ment<nbsp>?
msgctxt "NpcYell:5520:0:13"
msgid "The Hingan is still bleeding..."
msgstr "Хинганец всё ещё истекает кровью..."

#. ja: お願い！<br>助太刀してあげてっ！
#. de: Du musst ihm helfen!
#. fr: <if $gn4>Aventurière<else>Aventurier</if>, tu dois l'aider<nbsp>!
msgctxt "NpcYell:5521:0:13"
msgid "You must help him!"
msgstr "Помогите ему!"

#. ja: フンッ！
#. de: Hmpf!
#. fr: Hmph<nbsp>!
msgctxt "NpcYell:5522:0:13"
msgid "Hmph!"
msgstr "Хм!"

#. ja: セイヤァァァ！
#. de: Hiiijaaa!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:5523:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: 此度の助力…<br>感謝するぞ！
#. de: Ich danke dir, <if $gn4>Abenteurerin<else>Abenteurer</if>. Du bist <if $gn4>eine ehrenhafte Frau<else>ein Mann der Ehre</if>.
#. fr: Merci, <if $gn4>aventurière<else>aventurier</if>. J'ai une dette envers vous, désormais.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5524:0:13"
msgid "My thanks. You have shown<br>me honor is no stranger<br>to your people."
msgstr "Благодарю. Ты показал, что честь знакома и твоему народу."

#. ja: またいずれ勝負しようぞ！<br>では、ご免！
#. de: Ich hoffe, dass sich unsere Pfade wieder kreuzen. Leb wohl.
#. fr: J'espère que nous aurons l'occasion de nous exercer ensemble à nouveau<nbsp>! Adieu...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5525:0:13"
msgid "I shall remember this always.<br>Farewell. The mountains of<br>my homeland await."
msgstr "Я этого никогда не забуду. Прощай. Меня ждут горы родины."

#. ja: そのような約束<br>しておらんわ！
#. de: Ich habe nichts dergleichen versprochen. Aber vielleicht ist später noch Zeit, bevor mein Schiff ablegt.
#. fr: Je n'ai jamais dit ça<nbsp>! Mais il me reste encore un peu de temps avant d'embarquer...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5526:0:13"
msgid "I made no such promise!<br>But...I may have some time<br>before my ship sails."
msgstr "Я такого не обещал! Но... до отплытия корабля, пожалуй, ещё есть время."

#. ja: え～っ！<br>遊んでくれる約束は？
#. de: Aber du hast doch gesagt, dass wir noch Muscheln suchen gehen!
#. fr: Hé, papy<nbsp>! Tu avais promis qu'on irait chercher des coquillages ensemble<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5527:0:13"
msgid "Hey! You said we'd look<br>for shells when you finished!"
msgstr "Эй! Ты же обещал поискать ракушки, когда закончишь!"

#. ja: くううう！<br>銘刀を奪えないとはァー！
#. de: Ich komm wieder, Einklinge! Ich komm wieder!
#. fr: Grrr... Tu ne perds rien pour attendre, vieillard<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5528:0:13"
msgid "I will return, Oneblade!<br>I. Will. Return!"
msgstr "Я вернусь, Однолезвийный! Ещё как вернусь!"

#. ja: 銘刀カメワリ！<br>頂いていくぜェー！
#. de: Ich habe gewonnen! Ich habe Senban Einklinge besiegt! Kamewari ist mein!
#. fr: Victoire<nbsp>! Kamewari est à moi, enfin<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5529:0:13"
msgid "Victory is mine!<br>Inform the bards that Senban<br>is now the <i>None</i>blade!"
msgstr "Победа за мной! Скажите бардам: Сэнбан теперь — <i>Первый</i> клинок!"

#. ja: 嗚呼…オジちゃん！<br>オジちゃんが！
#. de: Wach auf! Wach doch auf!
#. fr: Papy, réveille-toi<nbsp>! Réveille toiii<nbsp>!
msgctxt "NpcYell:5530:0:13"
msgid "Wake up! Wake uuup!!!"
msgstr "Проснись! Ну проснииись!!!"

#. ja: 同胞に怪我がなくて<br>よかった
#. de: Danke für deine Hilfe.
#. fr: Je suis heurrreuse que ma sœur soit indemne.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5531:0:13"
msgid "Once again, you have<br>my thanks for seeing<br>my sister safe."
msgstr "И снова благодарю тебя за то, что спас мою сестру."

#. ja: それにしても<br>君は強いな
#. de: Du bist versiert im Kampf, wie es scheint.
#. fr: J'ai rarement vu <if $gn4>une aven<shy>tu<shy>rrrière aussi puissante<else>un aven<shy>tu<shy>rrrier aussi puissant</if> que toi.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5532:0:13"
msgid "You are well versed in<br>the art of war, it appears."
msgstr "Похоже, ты хорошо владеешь воинским искусством."

#. ja: 伝説のモルバ様にも<br>ひけをとらない！
#. de: Wir könnten dich brauchen, um eine schreckliche Bedrohung loszuwerden.
#. fr: Peut-être même plus que la grrrande J'moldva<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5533:0:13"
msgid "As it happens, my tribe<br>seeks a warrior of your<br>prowess to rid the land<br>of a terrible blight."
msgstr "Моему племени нужен воин твоего уровня, чтобы избавить край от страшной напасти."

#. ja: そんな君に力を借りたい<br>倒したい魔物がいるのだ
#. de: Sie hört auf den Namen Hunbaba und nicht einmal die mächtige J'moldva war ihr gewachsen.
#. fr: Si tu es capable de telles prouesses, tu pourras peut-être m'aider à vaincrrre un monstre qui menace notre hameau.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5534:0:13"
msgid "Its name is Humbaba, and<br>even the mighty J'moldva<br>could not stand against it."
msgstr "Зовут её Хумбаба. Даже могучей Дж'Молдва она оказалась не по зубам."

#. ja: 助太刀してくれるなら<br>ついてきてくれ！
#. de: Wenn du gewillt bist, führe ich dich zu ihrem Nest ... und ewigem Ruhm!
#. fr: Suis-moi, si penses être à la hauteurrr<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5535:0:13"
msgid "If you are willing, I shall lead<br>you to its lair...and to glory<br>everlasting!"
msgstr "Если согласен помочь, я отведу тебя к её логову... и к вечной славе!"

#. ja: 集落を狙う魔物め！<br>今日こそ倒す！
#. de: Der Schrecken wird heute enden! Und wir werden endlich frei sein!
#. fr: Sale verrrmine<nbsp>! Tu ne verras pas le soleil se lever demain<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5536:0:13"
msgid "Today the blight shall end!<br>Today my sisters will be free!"
msgstr "Сегодня конец этой напасти! Сегодня мои сёстры обретут свободу!"

#. ja: 君の尽力<br>決して忘れないぞ！
#. de: Mein Stamm wird für immer von deinen Taten singen!
#. fr: Ma tribu n'oubliera jamais la dette qu'elle a enverrrs toi.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5537:0:13"
msgid "The tribe will ever sing of<br>your deeds Your name will<br>echo in our hearts."
msgstr "Племя будет вечно воспевать твои подвиги. Имя твоё останется в наших сердцах."

#. ja: に、逃げよう…<br>これは勝てないっ！
#. de: Weg hier! Es ist nicht unehrenhaft zu fliehen, um es ein weiteres Mal zu versuchen!
#. fr: Ça ne se passe pas bien, pas bien du tout<nbsp>! Fuyons<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5538:0:13"
msgid "Come! There is no dishonor<br>in fleeing to fight again<br>another day."
msgstr "Бежим! Не стыдно отступить, чтобы сразиться в другой день."

#. ja: はぁっ！
#. de: Ha!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:5539:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: 激励の戦歌を<br>響かせてやらぁ！
#. de: Diese Weise wird euch Kraft spenden!
#. fr: Rien de tel qu'un hymne épique pour motiver les troupes<nbsp>!
msgctxt "NpcYell:5540:0:13"
msgid "Time for a song, I reckon!"
msgstr "Пора спеть боевую песню!"

#. ja: 負けるなぁ！
#. de: Komm doch her, Kröte!
#. fr: Ne te laisse pas faire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5541:0:13"
msgid "STAB HIM IN THE<br>SOFT OF THE BELLY!"
msgstr "КОЛИ ЕГО В МЯГКОЕ БРЮХО!"

#. ja: がんばれっ！
#. de: Blockieren! Parade! Stich!
#. fr: Allez, courage<nbsp>!
msgctxt "NpcYell:5542:0:13"
msgid "Parry! Dodge! Spin!"
msgstr "Парируй! Уклоняйся! Крутись!"

#. ja: ああもう！<br>待ってよ～！
#. de: Waaarte!
#. fr: Papyyyy<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5543:0:13"
msgid "Heheh. You're not such a<br>tough guy after all."
msgstr "Хе-хе. Не такой уж ты и грозный."

#. ja: その力…<br>本物のようだな！
#. de: Beeindruckend. Sehr beeindruckend.
#. fr: Tu te débrouilles bien<nbsp>!
msgctxt "NpcYell:5544:0:13"
msgid "An impressive display!"
msgstr "Вот это мощь!"

#. ja: これこそ我が求めた<br>真剣勝負よッ！
#. de: Ich habe dich unterschätzt, <if $gn4>Abenteurerin<else>Abenteurer</if>.
#. fr: Je t'avais sous-estimé<if $gn4>e</if><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5545:0:13"
msgid "I have done you a great<br>dishonor in underestimating<br>your ability, stranger. I shall<br>do so no longer!"
msgstr "Я жестоко оскорбил тебя, незнакомец, недооценив твоё мастерство. Больше этого не повторится!"

#. ja: がんばってねっ！
#. de: Mach ihn fertig!
#. fr: Allez<nbsp>! Allez<nbsp>!
msgctxt "NpcYell:5546:0:13"
msgid "TAKE HIS HEAD OFF!"
msgstr "ОТОРВИ ЕМУ ГОЛОВУ!"

#. ja: 今は誰でも構わない<br>気分なんだァー！
#. de: Ich bring dir Manieren bei, Göre!
#. fr: Je vais t'apprendre les manières, moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5547:0:13"
msgid "Perhaps that mouth needs a<br>proper washing...with blood!"
msgstr "Похоже, этому рту не помешает хорошенько промыться... кровью!"

#. ja: 仕留めきれんとは…
#. de: Ich habe versagt.
#. fr: Je n'ai pas pu en venir à bout...
msgctxt "NpcYell:5548:0:13"
msgid "I have failed my tribe..."
msgstr "Я подвёл своё племя..."

#. ja: ぺぺぺぺぺぺ！？<br>ま、ま、まさか、またまた、お魚泥棒っぺか！！
#. de: \<spotz>! Schon wieder Fffischdiebe?
#. fr: Qu'est-ce que c'est que ça<nbsp>!? Au voleur<nbsp>! Mon poisson<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5549:0:13"
msgid "First koja, now<br>my own brothers!?"
msgstr "Сначала Кодзя, теперь ещё и свои братья!?"

#. ja: グハッ…
#. de: Die alte Kriegsverletzung!
#. fr: Uuurgh...
msgctxt "NpcYell:5550:0:13"
msgid "That'll hurt come sunrise..."
msgstr "Вот это к утру заболит..."

#. ja: ま、参りました…
#. de: I-Ich tu nur so!
#. fr: J'abandonne...
msgctxt "NpcYell:5551:0:13"
msgid "Enough! Enough! I'm dead!"
msgstr "Хватит! Хватит! Я труп!"

#. ja: さすがに手強い！
#. de: Er weicht nicht zurück!
#. fr: Il est plus rrrésistant que je ne l'imaginais<nbsp>!
msgctxt "NpcYell:5552:0:13"
msgid "It yields no ground!"
msgstr "Его не сдвинуть с места!"

#. ja: いくぞ！
#. de: Auf ihn!
#. fr: En avant<nbsp>!
msgctxt "NpcYell:5553:0:13"
msgid "With me!"
msgstr "За мной!"

#. ja: 娘を怯えさせたこと<br>後悔させてくれる！
#. de: Du wirst es noch bereuen, dass du dein Schwert gegen ein Mädchen erhoben hast.
#. fr: Je vais te faire regretter d'avoir porté la main sur une enfant, lâche<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5554:0:13"
msgid "You will rue the day that<br>you raised your blade to<br>an innocent maid."
msgstr "Ты ещё пожалеешь, что поднял клинок на невинную девушку."

#. ja: 悪しきは斬るのみ！
#. de: Ich habe schon stärkere Gegner als dich besiegt, aber nur wenige waren abscheulicher!
#. fr: Tu vas mourir, couard<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5555:0:13"
msgid "I've slain bigger creatures<br>than you, but none as foul!"
msgstr "Я и тварей покрупнее тебя убивал, но такой мерзости ещё не встречал!"

#. ja: なんで、なんで……<br>いつもオイラばかり、こんなヒドい目に遭うっぺか？
#. de: Wieso passiert sowas immer mir?
#. fr: (snif) Pourquoi ça tombe toujours sur moi<nbsp>? Ce ne sont rien que des voleurs...
msgctxt "NpcYell:5556:0:13"
msgid "Why...? Why...?"
msgstr "Почему...? Почему...?"

#. ja: いつも、いつも、いつも、いつも、いつも、いつも、<br>いつも、いつも、いつも、いつも、いつもおおおおおおお！
#. de: Fffies, fffies, fffies! Wieso sind alle so gemein zu mir?!
#. fr: Ils n'auront jamais mon poisson... Jamais... Vous entendez<nbsp>!? Vous n'aurez jamais mon poisson<nbsp>! Jamais<nbsp>! Jamais<nbsp>! Jamais<nbsp>! Jamais<nbsp>! Jamais<nbsp>! Jamaiiiis<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5557:0:13"
msgid "Why does this always...always...<br>always always always<br>ALWAYS HAPPEN TO ME!!!?"
msgstr "Почему это всегда... всегда... всегда-всегда-всегда СО МНОЙ СЛУЧАЕТСЯ!!!?"

#. ja: オイラだって……オイラだって……<br>怒るときは、怒るっぺよおおおお！
#. de: Langsam hab ich die Kiemen voll!
#. fr: Moi aussi, je peux être méchant comme vous<nbsp>! Quand je me mets en colère, je ne rigole pas<nbsp>! Vous allez voir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5558:0:13"
msgid "YOU WANT SOME FISH!?<br>I'LL GIVE YOU SOME FISH!"
msgstr "ХОЧЕШЬ РЫБЫ!?<br>Я ТЕБЕ ЕЁ ДАМ!"

#. ja: ギョギョギョギョギョ！　ギョエエエエー！
#. de: \<spotz> ... \<spotz>!
#. fr: VOUS N'AUREZ JAMAIS MON POISSON<nbsp>!!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5559:0:13"
msgid "I'LL RAM THIS FISH SO FAR<br>UP YOURGRSBRGYRGAAAH!"
msgstr "Я ЗАПИХНУ ЭТУ РЫБУ ТЕБЕ В... ААААА!"

#. ja: 一気に決める！
#. de: Nicht zurückdrängen lassen!
#. fr: Maintenons la prrression<nbsp>!
msgctxt "NpcYell:5561:0:13"
msgid "Press the attack!"
msgstr "Атакуй!"

#. ja: おお～い！<br>ちょいと来てくれ！
#. de: He, du da! Bitte hilf mir!
#. fr: Hé, par ici<nbsp>!
msgctxt "NpcYell:5562:0:13"
msgid "Oi! Oi oi! Over here!"
msgstr "Эй! Эй, сюда!"

#. ja: いけっ！<br>やっちまえ！
#. de: Los, mach das Riesenvieh fertig!
#. fr: Vas-y, mets-lui la pâtée<nbsp>!
msgctxt "NpcYell:5563:0:13"
msgid "Slit him ear to ear!"
msgstr "Разрежь ему горло от уха до уха!"

#. ja: やれっ！<br>そこだっ！
#. de: Ja, genau so! Immer feste drauf!
#. fr: Regarde ce gros lourdaud, ha ha<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5564:0:13"
msgid "Feed the bull<br>his bleedin' bollocks!"
msgstr "Скорми быку его же чёртовы яйца!"

#. ja: あちゃ～<br>やられちまったか！
#. de: Oje, jetzt bin ich dran.
#. fr: Et merde, ils sont où les Douze, quand on a besoin d'eux<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5565:0:13"
msgid "Piss on the Twelve<br>and their bloody blessings!"
msgstr "К чёрту Двенадцать и их проклятое благословение!"

#. ja: よっしゃ～<br>略奪品は無事みたいだ！
#. de: Ho ho! Die Beute jagt uns keiner mehr ab.
#. fr: Ha ha, on a ramené un beau butin, aujourd'hui<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5566:0:13"
msgid "Heh heh! The plunder's<br>right as rain!"
msgstr "Хе-хе! Добыча цела и невредима!"

#. ja: ちょっと待ったァー！
#. de: Nichts da! Diese Beute haben die Rotpanzer sich erbeutet!
#. fr: Hé là, pas si vite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5567:0:13"
msgid "Good! Then you can give<br>back to me and we'll all<br>stay friends!"
msgstr "Отлично! Тогда отдай мне её, и разойдёмся по-хорошему!"

#. ja: あぁん！？
#. de: Verd... Wie habt ihr mich gefunden?
#. fr: ... Hein<nbsp>!?
msgctxt "NpcYell:5568:0:13"
msgid "Godsdammit! How did you─"
msgstr "Чтоб вас! Как вы меня нашли..."

#. ja: そのお宝<br>我らに差し出せェー！
#. de: Unsere Beute riechen wir auf 100 Seemalmen - gegen den Wind.
#. fr: Tu ne vas pas garder tout ça pour toi, quand même<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5569:0:13"
msgid "Find you? It was your stink.<br>It carries across the entire<br>Ruby Sea."
msgstr "Нашли? Да от тебя воняет так, что на всё Рубиновое море несёт."

#. ja: 馬鹿が！<br>奪われてたまるかよ！
#. de: Was heißt hier <i>unsere</i> Beute? Das ist <i>unsere</i> Beute!
#. fr: Et puis quoi encore, comme si j'allais tout vous donner<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5570:0:13"
msgid "And here I just had dip in<br>the springs last new moon!"
msgstr "Вот только в новолуние я мылся в горячих источниках!"

#. ja: ならば斬り刻み<br>魚の餌にするまでだァー！
#. de: Schweig. Gib uns, was uns gehört ...
#. fr: Assez parlé. Laisse-nous passer, ou sinon...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5571:0:13"
msgid "Enough of this. Stand aside,<br>and we'll take back what's<br>rightfully ours. Or..."
msgstr "Хватит болтать. Отойди, и мы заберём то, что по праву наше. Или..."

#. ja: いっせいに<br>かかれェー！
#. de: ... oder wir nehmen es uns. Los, Rotpanzer!
#. fr: ... Tu vas le regretter<nbsp>! Camarades, à l'attaque<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5572:0:13"
msgid "...we can kill you and take<br>it anyway. Forward, march!"
msgstr "...мы убьём тебя и заберём добычу силой. Вперёд, марш!"

#. ja: ぎゃああああ！
#. de: Gyaooooh!
#. fr: Grraaahh<nbsp>!
msgctxt "NpcYell:5573:0:13"
msgid "Aaaaaarrrgh!"
msgstr "А-а-а-а-а!"

#. ja: く、くそぉ！<br>助太刀してくれっ！
#. de: Das schaff ich nicht alleine. Du hilfst mir doch wieder, oder?
#. fr: Aaaah<nbsp>!!! Toi, là-bas, aide-moi, viiite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5574:0:13"
msgid "Well, bollocks. Looks like me<br>charm wore off. Ye wouldn't<br>be mindin' another brawl now,<br>would ye?"
msgstr "Чёрт! Похоже, моё обаяние больше не действует. Не поможешь мне ещё разок в драке, а?"

#. ja: ……あ、あれ？<br>オイラ、何してたっぺ？
#. de: Nanu? Was ist denn hier passiert?
#. fr: Hein<nbsp>? Quoi<nbsp>? Comment<nbsp>? Qu'est-ce qu'il s'est passé<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5575:0:13"
msgid "Wh-What happened?<br>Where are we? Who are you?"
msgstr "Ч-что случилось? Где мы? Кто вы?"

#. ja: ぺぺぺっ！？<br>お魚が黒コゲに…！
#. de: Wieso ist der Fffisch verkohlt?
#. fr: Mon poisson<nbsp>! Il est tout carbonisé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5576:0:13"
msgid "My fish... My beautiful<br>fish... They're all...all...<br>all burnt to a crisp!"
msgstr "Моя рыбка... Моя прекрасная рыбка... Она вся... вся... сгорела дотла!"

#. ja: いったい誰が<br>こんなヒドいこと…
#. de: Wer macht denn so was?
#. fr: Qui serait assez méchant pour faire une chose pareille...<nbsp>? (snif)...
msgctxt "NpcYell:5577:0:13"
msgid "I... I..."
msgstr "Я... Я..."

#. ja: 仕方ないっぺな…<br>またお魚獲りにいくっぺな
#. de: Bleibt mir wohl nur, neue zu fffangen.
#. fr: Enfin, je n'ai plus qu'à aller en repêcher... Ça ne sert à rien de s'apitoyer.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5578:0:13"
msgid "I can't eat them like <i>this</i>!"
msgstr "Я не могу есть их <i>такими</i>!"

#. ja: ぺぺぺ♪<br>がんばるっぺよ♪
#. de: ♪ Die Körbe voller Fffische, da biegen sich die Tische ♪
#. fr: Pour la peine, je vais en pêcher deux fois plus<nbsp>! Parce que... Le poissoooon, c'est si boooon<nbsp>!♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5579:0:13"
msgid "I guess I'll just have to<br>head back down to the<br>river and catch some more!"
msgstr "Похоже, придётся<br>вернуться к реке<br>и наловить ещё рыбки!"

#. ja: 蛮族の英雄か！？
#. de: <if $gn4>Die Heldin<else>Der Held</if> der Wilden?!
#. fr: C-c-'est <if $gn4>l'héroïne<else>le héros</if> des sauvages<nbsp>!!
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:5580:0:13"
msgid "It's <if $gn4>her<else>him</if>! The eikon-slayer!"
msgstr "Это же <if $gn4>она<else>он</if>! Убийца эйконов!"

#. ja: これより迎撃する！
#. de: Macht euch auf was gefasst!
#. fr: Chargez<nbsp>! Tuez-l<if $gn4>a<else>e</if><nbsp>!
msgctxt "NpcYell:5581:0:13"
msgid "Charge! Charge!"
msgstr "В атаку! В атаку!"

#. ja: よし、手はず通りいくぞ！
#. de: Jawohl! Jetzt nur weiter so.
#. fr: Ha ha<nbsp>! Pris comme des rats<nbsp>!
msgctxt "NpcYell:5582:0:13"
msgid "We've got them now!"
msgstr "Теперь они у нас в руках!"

#. ja: デスペナルティー！
#. de: Ihr seid des Todes!
#. fr: Jusqu'à ce que la mer nous engloutisse tous<nbsp>!
msgctxt "NpcYell:5585:0:13"
msgid "Till sea swallows all!"
msgstr "Пока море не поглотит нас всех!"

#. ja: 大精霊の祝福あれ！
#. de: Mögen die Gebieter uns helfen.
#. fr: Que les esprits nous guident<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5586:0:13"
msgid "May the Matron show<br>us favor this day..."
msgstr "Пусть Матрона<br>сегодня будет к нам милостива..."

#. ja: いいところを<br>見せなくちゃな！
#. de: Pass gut auf!
#. fr: La journée s'annonce longue<nbsp>!
msgctxt "NpcYell:5587:0:13"
msgid "It's going to be a long day..."
msgstr "День будет долгим..."

#. ja: 自由か死かッ！<br>うおおおおおッ！
#. de: Freiheit oder Tod! Ohhhh!
#. fr: La liberté ou la mort<nbsp>!
msgctxt "NpcYell:5588:0:13"
msgid "Liberty or death!"
msgstr "Свобода или смерть!"

#. ja: ブチやぶるよ！<br>どっせーい！
#. de: Dich zerquetsch ich!
#. fr: Attention, ça va péter<nbsp>!
msgctxt "NpcYell:5589:0:13"
msgid "Stand back! Tossing a bomb!"
msgstr "Назад! Бросаю бомбу!"

#. ja: ここは、あたしたちに<br>任せて、先にッ！
#. de: Überlass die hier uns und geh vor!
#. fr: La voie est dégagée<nbsp>! En avant<nbsp>!
msgctxt "NpcYell:5590:0:13"
msgid "Way's clear! Keep moving!"
msgstr "Путь свободен! Не останавливайтесь!"

#. ja: 王宮はこちらです！
#. de: Der Thronsaal ist hier entlang!
#. fr: Attention au scorpion devant le palais<nbsp>!
msgctxt "NpcYell:5591:0:13"
msgid "Scorpion 'round the bend! Remember to attack while it's tail's up!"
msgstr "За поворотом скорпион! Не забудьте атаковать, когда он поднимет хвост!"

#. ja: 我らが道を斬り拓く！
#. de: Wir schlagen eine Schneise!
#. fr: Que la Conquérante nous donne sa force<nbsp>!
msgctxt "NpcYell:5592:0:13"
msgid "We are the spear of the Fury and the shield of our brothers! Who are we!?"
msgstr "Мы — копьё Богини войны и щит наших братьев! Кто мы?!"

#. ja: アイメリク様に続け！
#. de: Folgt Großmeister Aymeric!
#. fr: Tous avec le capitaine général<nbsp>!
msgctxt "NpcYell:5593:0:13"
msgid "Ishgard!"
msgstr "Ишгард!"

#. ja: ハッ！
#. de: Ha!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:5594:0:13"
msgid "Ishgard!"
msgstr "Ишгард!"

#. ja: ガードスコーピオンが<br>撃破されたのか！？
#. de: Sie haben den Wachskorpion ausgeschaltet?
#. fr: Le scorpion a été détruit<nbsp>!?
msgctxt "NpcYell:5595:0:13"
msgid "They destroyed the scorpion!?"
msgstr "Они уничтожили скорпиона?!"

#. ja: ここで食い止めるぞ！
#. de: Hier ist Schluss!
#. fr: Il faut les arrêter coûte que coûte<nbsp>!
msgctxt "NpcYell:5596:0:13"
msgid "We have to hold them here!"
msgstr "Мы должны удержать их здесь!"

#. ja: 征竜戦の恩を<br>返すのだ！
#. de: Nun begleicht Ishgard seine Schuld!
#. fr: Ishgard n'oubliera jamais sa dette<nbsp>!
msgctxt "NpcYell:5597:0:13"
msgid "Ishgard remembers, Warrior of Light!"
msgstr "Ишгард помнит, Воин Света!"

#. ja: させるものかッ！
#. de: So nicht!
#. fr: Pas de pitié<nbsp>!
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:5598:0:13"
msgid "Kill <if $gn4>her<else>him</if>! Kill the bastard!"
msgstr "Убей <if $gn4>её<else>его</if>! Убей ублюдка!"

#. ja: この火砲は<br>利用できるぞ！
#. de: Die Kanonen sind funktionstüchtig!
#. fr: Je vais détruire la grille avec le canon<nbsp>!
msgctxt "NpcYell:5599:0:13"
msgid "Allow me to clear the way!"
msgstr "Позвольте мне расчистить путь!"

#. ja: さあ、英雄殿<br>先にお進みを！
#. de: Lauf schon voraus, <if $gn4>Abenteurerin<else>Abenteurer</if>!
#. fr: Bon courage<nbsp>! Et que Halone vous protège<nbsp>!
msgctxt "NpcYell:5600:0:13"
msgid "Go, honored hero, go!"
msgstr "Идите, достопочтенный герой! Вперёд!"

#. ja: 戦神よ、ご照覧あれ！
#. de: Halone, sei mit mir!
#. fr: Ô Halone<nbsp>! Guide mon épée<nbsp>!
msgctxt "NpcYell:5601:0:13"
msgid "Halone, guide my sword!"
msgstr "Халонэ, направь мою руку!"

#. ja: うおおッ！
#. de: Uoooh!
#. fr: Raaah<nbsp>!
msgctxt "NpcYell:5602:0:13"
msgid "Raaargh!"
msgstr "Рааааргх!"

#. ja: アウルス様が…<br>まさかッ！？
#. de: Aulus ...? Das kann nicht sein?!
#. fr: Qu'est-il arrivé au professeur Aulus<nbsp>!?
msgctxt "NpcYell:5603:0:13"
msgid "What of Lord Aulus!?"
msgstr "Что с лордом Аулусом?!"

#. ja: 魔導レーザーフィールド<br>起動しろ！
#. de: Magitek-Laserfeld aktivieren!
#. fr: Activez les champs de force magitek<nbsp>!
msgctxt "NpcYell:5604:0:13"
msgid "Activate the magitek fields!"
msgstr "Активировать магитех-поля!"

#. ja: 生きて帰れると<br>思うなよ！
#. de: Du wirst diesen Tag nicht überleben!
#. fr: Vous n'irez pas plus loin<nbsp>!
msgctxt "NpcYell:5605:0:13"
msgid "You will go no further!"
msgstr "Дальше вы не пройдёте!"

#. ja: ここまで敵が！？
#. de: Hier sind auch Feinde?!
#. fr: Des ennemis ici<nbsp>!? C'est pas possible<nbsp>!
msgctxt "NpcYell:5608:0:13"
msgid "Enemies here!? Impossible!"
msgstr "Враги и здесь?! Не может быть!"

#. ja: 怯むな！<br>押し返せーッ！
#. de: Macht euch nicht in die Hosen! Schlagt sie zurück!
#. fr: Courage<nbsp>! Nous vaincrons<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5609:0:13"
msgid "Courage and strength!<br>We will prevail!"
msgstr "Смелее!<br>Мы победим!"

#. ja: 斬るッ！
#. de: Stirb!
#. fr: Je vais t'éliminer<nbsp>!
msgctxt "NpcYell:5611:0:13"
msgid "Down with you!"
msgstr "Получай!"

#. ja: 道をあけぃ！
#. de: Auseinander!
#. fr: Hors de mon chemin<nbsp>!
msgctxt "NpcYell:5612:0:13"
msgid "Out of my way!"
msgstr "С дороги!"

#. ja: これが猛牛流よ！
#. de: Der Bulle von Ala Mhigo!
#. fr: La charge du taureau<nbsp>!
msgctxt "NpcYell:5613:0:13"
msgid "As a raging bull!"
msgstr "Как разъярённый бык!"

#. ja: ハァ、ハァ…<br>まだまだいくぞ！
#. de: In mir steckt noch Kraft!
#. fr: (souffle)... (souffle)... Ça devrait aller...
msgctxt "NpcYell:5614:0:13"
msgid "\\<pant> \\<pant>"
msgstr "\\<тяжёлое дыхание> \\<тяжёлое дыхание>"

#. ja: 一気に攻める！
#. de: Alle zusammen!
#. fr: À l'assaut<nbsp>!
msgctxt "NpcYell:5615:0:13"
msgid "I shan't hold back!"
msgstr "Я не стану сдерживаться!"

#. ja: おりゃ！
#. de: Heja!
#. fr: Graaah<nbsp>!
msgctxt "NpcYell:5616:0:13"
msgid "Graaah!"
msgstr "Грааах!"

#. ja: うおおッ！
#. de: Ohhh!
#. fr: Mouôôôh<nbsp>!
msgctxt "NpcYell:5617:0:13"
msgid "Ngaaah!"
msgstr "Нгааах!"

#. ja: 負けるかよ！
#. de: Weicht nicht zurück!
#. fr: Chiens<nbsp>!
msgctxt "NpcYell:5618:0:13"
msgid "Whoresons!"
msgstr "Ублюдки!"

#. ja: 壊神よ、我に力を！
#. de: Rhalgr, gib mir Kraft!
#. fr: Ô Rhalgr donne-nous ta force<nbsp>!
msgctxt "NpcYell:5619:0:13"
msgid "Remember the towers!"
msgstr "Помните о башнях!"

#. ja: 帝国の犬め！
#. de: Garleischer Hund!
#. fr: Saloperies d'Impériaux<nbsp>!
msgctxt "NpcYell:5620:0:13"
msgid "Imperial scum!"
msgstr "Имперские отребья!"

#. ja: 倒すッ！
#. de: Nieder mit ihnen!
#. fr: Pour Ala Mhigo<nbsp>!
msgctxt "NpcYell:5621:0:13"
msgid "Ala Mhigo! Ala Mhigo!"
msgstr "Ала Миго! Ала Миго!"

#. ja: てやッ！
#. de: Jawohl!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:5622:0:13"
msgid "Hyaaah!"
msgstr "Хьяаах!"

#. ja: いくぞ！
#. de: Vorwärts!
#. fr: Ça va faire mal<nbsp>!
msgctxt "NpcYell:5623:0:13"
msgid "Yaaargh!"
msgstr "Яаааргх!"

#. ja: させるか！
#. de: So nicht!
#. fr: Salauds<nbsp>!
msgctxt "NpcYell:5624:0:13"
msgid "Bastards!"
msgstr "Ублюдки!"

#. ja: 殲滅する！
#. de: Macht sie nieder!
#. fr: À mort<nbsp>! À mort<nbsp>!
msgctxt "NpcYell:5625:0:13"
msgid "Hyaaa!"
msgstr "Хьяа!"

#. ja: イシュガルドの力<br>見せる時ぞ！
#. de: Zeigt ihnen die Kampfkraft Ishgards!
#. fr: Pour Ishgard<nbsp>! Pour Ala Mhigo<nbsp>!
msgctxt "NpcYell:5626:0:13"
msgid "Ishgard! Ishgard!"
msgstr "Ишгард! Ишгард!"

#. ja: いけえッ！
#. de: Vorwärts!
#. fr: Mourez<nbsp>!
msgctxt "NpcYell:5627:0:13"
msgid "Now fall!"
msgstr "А ну, падите!"

#. ja: ザル神の御許に<br>送ってやるよ！
#. de: Ab mit dir in Thals Reich!
#. fr: Envoyez-les au royaume de Thal<nbsp>!
msgctxt "NpcYell:5628:0:13"
msgid "Send 'em to the Seventh Gate!"
msgstr "Отправлю вас к Седьмым вратам!"

#. ja: うりゃ！
#. de: Heee!
#. fr: Graaaah<nbsp>!
msgctxt "NpcYell:5629:0:13"
msgid "Hraaah!"
msgstr "Храаах!"

#. ja: オラオラ！
#. de: Haaa!
#. fr: Immortels<nbsp>! En avant<nbsp>!
msgctxt "NpcYell:5630:0:13"
msgid "Ul'dah! Ul'dah!"
msgstr "Ульда! Ульда!"

#. ja: 斬り捨てご免！
#. de: Dich hau ich um!
#. fr: Doma n'oubliera jamais<nbsp>!
msgctxt "NpcYell:5631:0:13"
msgid "Doma is come!"
msgstr "Домой пришла!"

#. ja: さらば！
#. de: Auf Wieder<shy>sehen!
#. fr: Adieu<nbsp>!
msgctxt "NpcYell:5632:0:13"
msgid "Begone!"
msgstr "Прочь!"

#. ja: 死ねッ！
#. de: Stirb!
#. fr: Pour le seigneur Hien<nbsp>!
msgctxt "NpcYell:5633:0:13"
msgid "For Lord Hien!"
msgstr "За лорда Хиэна!"

#. ja: やれやれ…<br>どうにかなったな…
#. de: So weit, so gut ...
#. fr: Pfiou... C'est fini, on dirait...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5634:0:13"
msgid "I don't ever want to have<br>to do that again..."
msgstr "Никогда больше не хочу<br>через такое проходить..."

#. ja: 私は貴様を葬り…<br>過去を…
#. de: Du Missgeburt! Der Tod wird eine Erlösung sein!
#. fr: Tu n'aurais jamais dû sortir de ta cellule, monstre...
msgctxt "NpcYell:5635:0:13"
msgid "O Halone, see us to victory! Grant me the strength to strike down this foul creature!"
msgstr "О Халонэ, приведи нас к победе! Дай мне сил сразить это мерзкое чудовище!"

#. ja: お母さん…
#. de: Mutter!
#. fr: Mère...
msgctxt "NpcYell:5637:0:13"
msgid "Mother..."
msgstr "Мама..."

#. ja: 彼にソウルイーターを！
#. de: Friss seine Seele!
#. fr: Dévoreur d'âme, maintenant<nbsp>!
msgctxt "NpcYell:5638:0:13"
msgid "Make us whole!"
msgstr "Сделай нас целыми!"

#. ja: ぐすん…<br>もう…帰るっぺよ…
#. de: \<schniefff> ... Ich geh heim ...
#. fr: (snif) Je rentre bredouille... (snif) (snif)
msgctxt "NpcYell:5639:0:13"
msgid "Gone... They're all gone..."
msgstr "Пропали... Все пропали..."

#. ja: 目からナマズ汁が…<br>うっ、うっ、うっ…
#. de: Meine Glubschaugen fffüllen sich mit Tränen!
#. fr: Mes larmes sont la seule chose que j'aurai à dîner...
msgctxt "NpcYell:5640:0:13"
msgid "A sad, sad day, this is. Sad!"
msgstr "День сегодня печальный. Очень печальный!"

#. ja: ギョエエエエー！<br>ギョエエエエエエー！
#. de: Buwääääh! Buwäääh!
#. fr: PWAAAACHOOONNN<nbsp>!!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5642:0:13"
msgid "FISHFISHFISHFISHFISH<br>FISHFISHFISHFISHFISH..."
msgstr "РЫБАРЫБАРЫБАРЫБА<br>РЫБАРЫБАРЫБАРЫБА..."

#. ja: ぺぺぺぺぺっ！<br>お魚食べられたっぺよ！
#. de: \<spotz>! Die haben meinen Fffisch gemampffft!
#. fr: Ah<nbsp>! Je les ai vus en prendre<nbsp>!
msgctxt "NpcYell:5643:0:13"
msgid "That's not yours!"
msgstr "Это не твоё!"

#. ja: オイラが何したって<br>言うっぺよぉぉぉ！
#. de: Womit hab ich das verdient?
#. fr: Qu'est-ce que je peux faire<nbsp>? Mon poisson est à leur merci...
msgctxt "NpcYell:5644:0:13"
msgid "Give that back!"
msgstr "Отдай обратно!"

#. ja: ぺぺぺぺぺっ！<br>また食べられたっぺよ！
#. de: Da! Schon wieder einen!
#. fr: Stop, stop, stop<nbsp>! Pas un autre panier<nbsp>!
msgctxt "NpcYell:5645:0:13"
msgid "That one is mine, too!"
msgstr "И эта тоже моя!"

#. ja: お願いだから<br>やめてくれっぺよぉぉぉ！
#. de: Ich ffflehe euch an! Hört aufff!
#. fr: Laissez mon poisson tranquille<nbsp>!
msgctxt "NpcYell:5646:0:13"
msgid "Stop eating my fish!"
msgstr "Перестань есть мою рыбу, умоляю!"

#. ja: ぺぺぺぺぺっ！<br>なんてことするっぺな！
#. de: He! Was macht ihr da?
#. fr: Pas touche à mes paniers<nbsp>!
msgctxt "NpcYell:5647:0:13"
msgid "You! Get your own fish!"
msgstr "Эй! Лови свою рыбу!"

#. ja: なんでオイラから<br>お魚盗むっぺよ！
#. de: Wieso klaut ihr mir meine Fffische?
#. fr: Allez pêcher votre poisson vous-même<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5648:0:13"
msgid "Don't think you can get<br>away with this!"
msgstr "Думаешь, тебе это<br>сойдёт с рук?!"

#. ja: ぺぺぺぺぺっ！<br>また盗まれたっぺよ！
#. de: Und noch einen geklaut!
#. fr: Ils m'ont volé presque tout mon poisson<nbsp>!
msgctxt "NpcYell:5649:0:13"
msgid "I saw that! I saw that!"
msgstr "Видел! Видел!"

#. ja: ナマズオの川上にも<br>おけないっぺな！
#. de: Bin ich nicht mal hier sicher?
#. fr: Vous êtes la honte des Namazu<nbsp>! Bande de voleurs<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5650:0:13"
msgid "I'm going to tell<br>your mothers!"
msgstr "Я вашим мамам<br>пожалуюсь!"

#. ja: 魚…魚…
#. de: Ffffische! Fffische!
#. fr: Du poisson<nbsp>! Du poisson<nbsp>!
msgctxt "NpcYell:5651:0:13"
msgid "My fish! My fish!"
msgstr "Моя рыба! Моя рыба!"

#. ja: ギョギョギョ！
#. de: \<spotz>! \<spotz>!
#. fr: Le poissoooon, c'est si boooon<nbsp>!♪
msgctxt "NpcYell:5653:0:13"
msgid "Hee hee hee hee!"
msgstr "Хи-хи-хи-хи!"

#. ja: オラの可愛い<br>ケナガウシをよくも！
#. de: Meine armen Dzo!
#. fr: Mon beau hainag... Il va payer pour ça, je te le jure<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5654:0:13"
msgid "The filthy duck ate<br>my favorite dzo!"
msgstr "Грязная утка съела<br>мою любимую дзо!"

#. ja: 頼む！<br>オラに力を貸してけろ！
#. de: Bitte, hilf uns!
#. fr: Je t'en prie, aide-moi<nbsp>! Je dois la venger<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5655:0:13"
msgid "And I fear <i>I'll</i> be next!"
msgstr "Боюсь, следующей буду <i>я</i>!"

#. ja: このこのぉ～！
#. de: Dieser verdammte ...!
#. fr: Tu vas voir, vile créature<nbsp>!
msgctxt "NpcYell:5656:0:13"
msgid "Choke on this!"
msgstr "На, подавись!"

#. ja: ケナガウシの<br>恨みだっ！
#. de: Er hat es auf unsere Tiere abgesehen.
#. fr: Pour mon hainag<nbsp>!
msgctxt "NpcYell:5657:0:13"
msgid "For Lucy!"
msgstr "За Люси!"

#. ja: うぅ…オラの力じゃ<br>倒せないのか…
#. de: Ich bin zu schwach, um ihn zu erlegen!
#. fr: Nous... Nous ne sommes pas assez fort pour le vaincre<nbsp>? Non...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5658:0:13"
msgid "Bested...by a giant...duck...<br>I shall never live this down..."
msgstr "Проиграла... гигантской... утке...<br>Мне этого вовек не простят..."

#. ja: オラの家畜たち…<br>また襲われるのか…
#. de: Arme Dzos, mein Ein und Alles<nbsp>...
#. fr: Nous sommes impuissants... Nos hainags sont destinés à tous être emportés...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5659:0:13"
msgid "The skies will never be<br>safe as long as that duck<br>lives..."
msgstr "Небо не будет<br>в безопасности, пока<br>эта утка жива..."

#. ja: やったぞぉ！<br>倒したぞぉ！
#. de: Wir haben ihn aus der Luft geholt!
#. fr: On l'a vaincu<nbsp>! Nos hainags sont protégés<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5660:0:13"
msgid "<i>That</i> was for Lucy!"
msgstr "<i>Это</i> было за Люси!"

#. ja: バルダム覇道から<br>現れたという獣はあれか？
#. de: Die sind aus Bardams Probe gekommen?
#. fr: C'est elle, la créature venue de la Force de Bardam<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5661:0:13"
msgid "Something's emerged from<br>Bardam's Mettle...and it looks<br>hungry!"
msgstr "Из Доблести Бардама<br>что-то выбралось... Похоже,<br>оно проголодалось!"

#. ja: 家畜が殺される前に<br>始末せねばなるまい…
#. de: Sie müssen erledigt werden, bevor sie unser Vieh fressen.
#. fr: Abattons-la avant qu'elle ne s'en prenne à nos bêtes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5662:0:13"
msgid "There's no time to move the<br>herd. We'll need to slow the<br>beast somehow!"
msgstr "Стадо не успеть увести. Надо как-то задержать зверя!"

#. ja: そこの旅人よ！<br>逃げるなら今のうちだ！
#. de: Falls du fliehen willst, dann jetzt!
#. fr: <if $gn4>Étrangère<else>Étranger</if>, si tu comptes fuir, c'est maintenant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5663:0:13"
msgid "If you haven't the will to<br>fight, you'd best run now!"
msgstr "Если не решитесь драться,<br>лучше бегите сейчас!"

#. ja: セイッ！
#. de: Und los!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:5664:0:13"
msgid "Hnyah!"
msgstr "Хнья!"

#. ja: まさか…<br>後れを取るとは…
#. de: Oje, sie brechen durch.
#. fr: Ourgh... On ne va pas y arriver...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5665:0:13"
msgid "There was no<br>way to stop it..."
msgstr "Не было<br>способа его остановить..."

#. ja: しまった！<br>向こうには家畜たちが！
#. de: Oh nein, gleich sind sie bei meiner Herde.
#. fr: Qu-quel monstre...<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5666:0:13"
msgid "Ah! And now it's<br>heading for the pens!"
msgstr "О нет! Оно направляется<br>к загонам!"

#. ja: これでもう安全だ…<br>助かったぞ！
#. de: Danke! Du hast die Gefahr abgewendet.
#. fr: Bon débarras<nbsp>! Beau travail, <if $gn4>étrangère<else>étranger</if><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5667:0:13"
msgid "You've saved us, traveler.<br>May the sun bless you."
msgstr "Ты спас нас, путник.<br>Пусть солнце благословит тебя."

#. ja: ハァ…ハァ…<br>同胞を襲うとは…
#. de: \<keuch> ... \<schnauf> ... Wir sollten nicht unseresgleichen bekämpfen!
#. fr: (souffle)... (souffle)... Ils osent s'en prendre à l'un des leurs... (souffle)...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5668:0:13"
msgid "How dare they...attack...<br>one of theirs... \\<pant> \\<pant>"
msgstr "Как они посмели... напасть...<br>на своих же... \\<тяжёлое дыхание> \\<тяжёлое дыхание>"

#. ja: 手間かけさせやがって！
#. de: Jetzt zier dich nicht so!
#. fr: Il me fatigue à courir<nbsp>! Il peut pas se laisser faire<nbsp>!?
msgctxt "NpcYell:5669:0:13"
msgid "You can't run forever, Gaei!"
msgstr "Не убежишь, Гаэи!"

#. ja: ブチ殺すぞ！
#. de: Wir machen's auch kurz und schmerzlos!
#. fr: On va te réduire en charpie<nbsp>!
msgctxt "NpcYell:5670:0:13"
msgid "Your head is ours!"
msgstr "Твоя голова наша!"

#. ja: ハァ…ハァ…<br>やるしかないか…
#. de: \<keuch> ... \<schnauf> ... Bleibt mir denn keine Wahl?
#. fr: (souffle)... (souffle)... J'ai plus le choix...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5671:0:13"
msgid "Very well then. If I must spill<br>the blood of mine own kin..."
msgstr "Что ж. Раз придётся пролить<br>кровь родичей..."

#. ja: 村に野武士を<br>連れて帰るわけにはいかん
#. de: Solange sie mich verfolgen, kann ich nicht zu den anderen zurückkehren.
#. fr: Je peux pas les laisser me suivre jusqu'au village. Je vais devoir leur faire face.
msgctxt "NpcYell:5672:0:13"
msgid "Then spill it I shall!"
msgstr "Тогда пусть кровь прольётся!"

#. ja: 銭を出せば<br>許してやるぞ！
#. de: Du kannst dich gerne freikaufen!
#. fr: Allez<nbsp>! Si tu nous donnes gentiment ton argent, tu t'en tireras peut-être même avec la vie sauve, tu sais<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5673:0:13"
msgid "We can be civil<br>about this, Gaei!"
msgstr "Давай решим всё миром,<br>Гаэи!"

#. ja: 隠れておらんで<br>出てこい！
#. de: Komm raus, kleines Wölfchen!
#. fr: Sors de ta cachette<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5674:0:13"
msgid "Just give us back the<br>coin we stole...plus, say,<br>another sack and we'll<br>call things even!"
msgstr "Хватит прятаться! Верни<br>украденные деньги... и ещё<br>мешок сверху — и мы в расчёте!"

#. ja: スンスンスン…<br>臭いがするぞ…
#. de: Ich kann dich riechen!
#. fr: (renifle) (renifle) Je le sens, il est pas loin...
msgctxt "NpcYell:5675:0:13"
msgid "He's here. I smell him!"
msgstr "Он здесь. Чую его!"

#. ja: 敵はまだ来ないのか…
#. de: Noch ist keiner zu sehen.
#. fr: Restez sur vos gardes...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5676:0:13"
msgid "Keep your eyes peeled.<br>They may come at any moment."
msgstr "Глаза держите открытыми.<br>Они могут напасть в любой миг."

#. ja: 返り討ちにしてやる
#. de: Die sollen nur kommen!
#. fr: Vous allez payer<nbsp>!
msgctxt "NpcYell:5677:0:13"
msgid "We will avenge Zakuro's dishonor."
msgstr "Мы отомстим за позор Закуро."

#. ja: 怖気づいて逃げたか…
#. de: Die haben es wohl mit der Angst zu tun bekommen.
#. fr: Ces poltrons se sont enfuis.
msgctxt "NpcYell:5678:0:13"
msgid "Turned tail and ran like the dogs they are, I wager."
msgstr "Поджали хвост и дали дёру, как последние псы, держу пари."

#. ja: ありがとう…<br>ああ…おなかすいた
#. de: Danke! ... Habt ihr was zu essen dabei?
#. fr: Merrrci<nbsp>! J'ai une de ces faims...
msgctxt "NpcYell:5679:0:13"
msgid "Thanks! Ye didn't bring a bite to yaffle on, did ye?"
msgstr "Спасибо! Не захватил чего перекусить?"

#. ja: お、お前らいつの間に！？
#. de: Wo kommt ihr denn her?
#. fr: Vous sortez d'où<nbsp>!?
msgctxt "NpcYell:5680:0:13"
msgid "Y-You! Where did you come from!?"
msgstr "В-вы! Откуда вы взялись?!"

#. ja: ウププ、おバカなオボロくん
#. de: Oboro, du Dummkopf!
#. fr: Toujours aussi futé, Oboro<nbsp>!
msgctxt "NpcYell:5681:0:13"
msgid "Ahaha! Oboro the Dim strikes again!"
msgstr "Ха-ха-ха! Оборо-тугодум опять отличился!"

#. ja: みんな集れェ～！
#. de: Alle zu mir!
#. fr: Par iciii <nbsp>!♪
msgctxt "NpcYell:5682:0:13"
msgid "To me! To me!"
msgstr "Сюда! Сюда!"

#. ja: ヴァ・ケビ、怪我はないか？
#. de: Streunerin, bist du unverletzt?
#. fr: V'kebbe<nbsp>! Tout va bien<nbsp>?
msgctxt "NpcYell:5683:0:13"
msgid "V'kebbe! Are ye hurt!?"
msgstr "В'кеббе! Ты не ранена?!"

#. ja: 逃がすかよ…
#. de: Flucht ist zwecklos!
#. fr: Pfff, il a fui...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5684:0:13"
msgid "You're a dead man, Gaei!<br>A dead man hiding!"
msgstr "Тебе конец, Гаэи!<br>Не спрячешься!"

#. ja: ぐっ、やりおる…<br>ここは退くぞォー！
#. de: Wir kommen wieder! Und dann holen wir uns <i>unsere</i> Beute, Pirat!
#. fr: On vous aura la prochaine fois, sales pirates...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5685:0:13"
msgid "Do not think this is the end,<br>Confederate! The Red will see<br>our treasures back in our halls<br>and your heads on the walls!"
msgstr "Не думай, что это конец,<br>Конфедерат! Красный вернёт<br>свои сокровища в наши залы,<br>а ваши головы — на стены!"

#. ja: 助勢に感謝する！<br>ゆくぞ！
#. de: Ich danke dir! Möge uns Glück beschieden sein!
#. fr: Je te remercie<nbsp>! Viens<nbsp>! On y va<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5687:0:13"
msgid "I am in your debt, traveler!<br>Now pray keep me alive<br>so I can pay it!"
msgstr "Я у тебя в долгу, путник!<br>Помоги мне выжить,<br>чтобы я смог его вернуть!"

#. ja: 同胞を襲うまでに<br>堕ちるとは…恥を知れ！
#. de: Die Hand an euresgleichen zu legen! Wie tief kann man fallen?!
#. fr: Vous n'avez aucune honte<nbsp>! Qui attaque l'un des siens<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5688:0:13"
msgid "Aye, I am here, my brothers!<br>And no, there will be no<br>compromise!"
msgstr "Да, я здесь, братья!<br>И никакого перемирия не будет!"

#. ja: ここで討つ！<br>うおおおおおおっ！
#. de: Erfahrt eure gerechte Strafe! Hrrraaarrr!
#. fr: Vous allez payer pour votre déshonneur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5689:0:13"
msgid "You will pay for what you<br>have done...with your lives!"
msgstr "Вы заплатите за свои<br>поступки... жизнями!"

#. ja: へっへっへっ…<br>そこにいたか…！
#. de: Da ist ja der feige Hund!
#. fr: Héhéhé<nbsp>! Regardez<nbsp>! Il était là<nbsp>!
msgctxt "NpcYell:5690:0:13"
msgid "Look boys, there he is!"
msgstr "Смотрите, ребята, вот он!"

#. ja: 生意気なことを！
#. de: Zeit für deine Züchtigung!
#. fr: Tu crois que t'as la moindre chance<nbsp>!?
msgctxt "NpcYell:5691:0:13"
msgid "I was hoping you'd say that."
msgstr "А я надеялся, что ты это скажешь."

#. ja: いやがったな…！
#. de: Na endlich!
#. fr: Enfin<nbsp>! Il est sorti de son trou<nbsp>!
msgctxt "NpcYell:5692:0:13"
msgid "Gaei!"
msgstr "Гаэй!"

#. ja: ナメるなよ<br>子犬風情が！
#. de: Jetzt kriegst du, was du verdienst!
#. fr: Tu fais pas le poids, avorton<nbsp>!
msgctxt "NpcYell:5693:0:13"
msgid "Get him!"
msgstr "Хватай его!"

#. ja: よし、隙が出来た！<br>今のうちに移動するぞ！
#. de: Mir nach, wenn du leben willst!
#. fr: C'est maintenant ou jamais<nbsp>! Suis-moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5694:0:13"
msgid "Now's our chance! Follow<br>me if ye be keen on livin'!"
msgstr "Наш шанс! За мной, если<br>жить охота!"

#. ja: 考えがあるんだ<br>ついてきてくれ！
#. de: Vertrau mir, ich habe einen Plan!
#. fr: Fais-moi confiance, j'ai un plan<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5695:0:13"
msgid "Ye see, I've meself<br>a bonny of a plan!"
msgstr "Есть у меня планчик,<br>так что идём за мной!"

#. ja: 追え追えェー！<br>逃がすなァー！
#. de: Hinterher! Lasst sie nicht ...... entkommen!
#. fr: Ne les laissez pas s'enfuir<nbsp>!
msgctxt "NpcYell:5696:0:13"
msgid "After them!"
msgstr "За ними!"

#. ja: どん詰まりに<br>逃げ込むなんてなァー！
#. de: Jetzt haben wir euch!
#. fr: Vous êtes à nous, ha ha<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5697:0:13"
msgid "It appears you've run<br>yourselves aground!"
msgstr "Похоже, вы сами себя<br>загнали в тупик!"

#. ja: 愚か者めェー！
#. de: Jetzt gibt es kein ...... Entkommen!
#. fr: Pauvres fous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5698:0:13"
msgid "I expect as much from a<br>rum-soaked Confederate<br>but I'd heard you Westerners<br>were of a more clever stock."
msgstr "От пропахших ромом конфедератов я и не ждал ума, но думал, что вы, западники, поразумнее."

#. ja: ハァ、ハァ…<br>誰が愚か者だって？
#. de: Richtig, kein Entkommen.
#. fr: C'est ce que tu crois, ha ha<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5699:0:13"
msgid "Who ye calling rum-soaked?<br>I haven't had a drop in six<br>bells, no thanks to you!"
msgstr "Кого это ты назвал пропахшим ромом? Я уже шесть часов ни капли не пил — и всё из-за тебя!"

#. ja: ハメられたのは<br>お前たちの方だ！
#. de: Und zwar für euch, Krötenmänner!
#. fr: Ce soir au menu, c'est soupe de tortue<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5700:0:13"
msgid "We'll be sippin' grog out this<br>Red bastard's skull come<br>supper, like!"
msgstr "К ужину будем хлебать грог из черепа этого краснопанцирного ублюдка!"

#. ja: なんだとォー！<br>いつの間にィー！？
#. de: Eine ...... Falle!
#. fr: C'est un piège<nbsp>!
msgctxt "NpcYell:5701:0:13"
msgid "A trap!"
msgstr "Ловушка!"

#. ja: 海賊衆をナメたこと<br>後悔させてやるぜ！
#. de: Hättest dich besser nicht mit der Konföderation angelegt!
#. fr: Tu vas regretter d'avoir cherché des noises à la Confédération<nbsp>!
msgctxt "NpcYell:5702:0:13"
msgid "Quick, this one."
msgstr "Быстрее, вот этого."

#. ja: ええい、小癪なァー！<br>者ども、かかれェー！
#. de: Pah! Wir zerquetschen euch. Zum Angriff!
#. fr: C'est ce qu'on verra<nbsp>! En avant, mes amis<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5703:0:13"
msgid "No matter. We will have what<br>is ours, and paint our shells<br>in your blood!"
msgstr "Неважно. Мы заберём своё и окрасим панцири вашей кровью!"

#. ja: 叩きのめせ！
#. de: Vorwärts!
#. fr: Chargeeez<nbsp>!
msgctxt "NpcYell:5704:0:13"
msgid "Charge!"
msgstr "Натиск!"

#. ja: ヌラァー！
#. de: Hrrraaah!
#. fr: Ooooorh<nbsp>!
msgctxt "NpcYell:5705:0:13"
msgid "Hrrraaah!"
msgstr "Р-р-ра-а-а!"

#. ja: つぶせェー！
#. de: Lasst keinen stehen!
#. fr: Écrasez-les tous<nbsp>!
msgctxt "NpcYell:5706:0:13"
msgid "Crush them all!"
msgstr "Раздавите их всех!"

#. ja: 援軍はどうした！？<br>かかれェー！
#. de: Wo ist die zweite Reihe? Vorwärts! Vorwärts!
#. fr: Où est la deuxième ligne<nbsp>!? En avant, vite<nbsp>!
msgctxt "NpcYell:5707:0:13"
msgid "Where's the second line!?Advance! Advance!"
msgstr "Где вторая линия!? Вперёд! Вперёд!"

#. ja: ウジャウジャと<br>沸いてきやがって！
#. de: Wo kommen die alle her?
#. fr: D'où sortent-ils tous<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5708:0:13"
msgid "There be too godsdamned<br>many of them!"
msgstr "Да их тут чёртова уйма!"

#. ja: もうひと押し！<br>いけいけぇ！
#. de: Nicht nachlassen!
#. fr: Courage, on y est presque<nbsp>!
msgctxt "NpcYell:5709:0:13"
msgid "We're almost through!"
msgstr "Мы почти прорвались!"

#. ja: しぶとい奴らめェー！
#. de: Die Reihe halten!
#. fr: Tenez bon<nbsp>!
msgctxt "NpcYell:5710:0:13"
msgid "Hold the line! Hold!"
msgstr "Держать строй! Не сдаваться!"

#. ja: ヌラァァー！
#. de: Guuuraaah!
#. fr: Oooorrrh<nbsp>!!!
msgctxt "NpcYell:5711:0:13"
msgid "Hrah! Hraaah!"
msgstr "Р-р-ра-а-а!"

#. ja: 叩きのめせェー！
#. de: Brecht ihnen alle Knochen!
#. fr: Ils ne peuvent rien contre nous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5712:0:13"
msgid "Break their spirits<br>and their backs!"
msgstr "Сломайте им дух<br>и переломайте кости!"

#. ja: ざまぁねぇな！<br>俺たちの勝ちだ！
#. de: So schnell hat man noch keine Kröten laufen gesehen!
#. fr: Retournez d'où vous venez, sales bêtes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5713:0:13"
msgid "Hah hah hah! Naught better<br>than a turtle on his back!"
msgstr "Ха-ха-ха! Вот умора — черепаха на спине!"

#. ja: 戦ってくれた皆<br>ありがとうよ！
#. de: Ich danke dir im Namen der Konföderation.
#. fr: Au nom de la Confédération, je vous remercie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5714:0:13"
msgid "Me thanks, matey. Ye'd make<br>a fine Confederate, ye would!"
msgstr "Спасибо, дружище. Из тебя вышел бы отличный конфедерат!"

#. ja: ぐ…逃がしたか！
#. de: Und kommt ja nicht wieder!
#. fr: Grrr... Ils nous ont filé entre les doigts<nbsp>!
msgctxt "NpcYell:5715:0:13"
msgid "Hah! And don't come back!"
msgstr "Ха! И чтоб больше не возвращались!"

#. ja: 危ないところ…<br>覚えておれよォー！
#. de: Pah! Wir kriegen euch. Irgendwann!
#. fr: Tu as de la chance d'être encore en vie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5716:0:13"
msgid "Just wait! You will soon wish<br>you had died here today!"
msgstr "Вот погодите! Скоро сами пожалеете, что сегодня не погибли!"

#. ja: ええい！<br>これではキリがない！
#. de: Es werden einfach nicht weniger!
#. fr: Bon sang<nbsp>! Leur meute est trop nombreuse<nbsp>!
msgctxt "NpcYell:5717:0:13"
msgid "There are simply too many..."
msgstr "Их просто слишком много..."

#. ja: 大丈夫か！
#. de: Alles in Ordnung?
#. fr: Gaei<nbsp>! Tu vas bien<nbsp>!?
msgctxt "NpcYell:5718:0:13"
msgid "Gaei! Are you alright!?"
msgstr "Гаэй! Ты в порядке?!"

#. ja: ガエイ！<br>探していたぞ！
#. de: Gaei! Wir haben dich gesucht!
#. fr: Nous t'avons cherché partout<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5719:0:13"
msgid "What have you gotten<br>yourself into this time!?"
msgstr "Во что ты на этот раз<br>вляпался?!"

#. ja: 来てくれたか！<br>この方のおかげで無事だ！
#. de: Ich lebe! Dank <if $gn4>dieser Abenteurerin<else>dieses Abenteurers</if>.
#. fr: Je vais bien, en grande partie grâce à cette personne.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5720:0:13"
msgid "The thieves found me, and<br>would have killed me, had it<br>not been for this stranger."
msgstr "На меня напали воры, и они бы меня убили, если бы не этот незнакомец."

#. ja: どうする？<br>同胞の不始末はここで…
#. de: Erteilen wir diesen Dreckskerlen eine Lektion!
#. fr: Que veux-tu qu'on fasse<nbsp>? On doit vraiment affronter les nôtres<nbsp>?
msgctxt "NpcYell:5721:0:13"
msgid "And they still might!"
msgstr "Да они ещё могут вернуться!"

#. ja: ああ、やるしかない…<br>堕ちた野武士を斬ろう！
#. de: Ja! Nichts anderes haben sie verdient!
#. fr: Oui, on a pas le choix.
msgctxt "NpcYell:5722:0:13"
msgid "I'd like to see them try!"
msgstr "Вот и посмотрим!"

#. ja: やりやがったな！
#. de: Pah, ihr hattet bloß Glück!
#. fr: Alors là, c'est la guerre<nbsp>!
msgctxt "NpcYell:5723:0:13"
msgid "So that's how it is, eh!?"
msgstr "Так вот как, а?!"

#. ja: 生かして帰すと<br>思うなよ！
#. de: Glaubt nicht, dass ihr lebend davonkommt!
#. fr: Vous vous en sortirez pas vivants<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5724:0:13"
msgid "I'll tear each and every one<br>of you from crotch to chin!"
msgstr "Я каждого из вас от промежности до подбородка располосую!"

#. ja: 皆殺しだ！
#. de: Ihr werdet allesamt sterben!
#. fr: Faites vos prières<nbsp>!
msgctxt "NpcYell:5725:0:13"
msgid "Attack!"
msgstr "Атака!"

#. ja: ブチ殺すぞ！
#. de: Wir zerfleischen euch!
#. fr: On va vous exterminer<nbsp>!
msgctxt "NpcYell:5726:0:13"
msgid "'Tis a good day to die!"
msgstr "Хороший день, чтобы умереть!"

#. ja: 何見てんだ！？
#. de: Was guckst du?!
#. fr: C'est moi que tu regardes<nbsp>!?
msgctxt "NpcYell:5727:0:13"
msgid "I'll eat you alive!"
msgstr "Сейчас я тебя живьём сожру!"

#. ja: 刃向かうヤツは<br>皆殺しだ！
#. de: Meine Klinge freut sich auf eure Bekanntschaft.
#. fr: Si vous résistez, vous êtes morts<nbsp>!
msgctxt "NpcYell:5729:0:13"
msgid "See these claws!?"
msgstr "Видишь мои когти?!"

#. ja: 首つっこむ気か？
#. de: Wird 'n kurzes Vergnügen.
#. fr: Ils veulent jouer leur vie, eux aussi<nbsp>!?
msgctxt "NpcYell:5730:0:13"
msgid "Should've stayed in your den!"
msgstr "Надо было сидеть в своей норе!"

#. ja: アァン！？
#. de: Aber spaßig, haha!
#. fr: Ramenez-vous pour voir<nbsp>!
msgctxt "NpcYell:5731:0:13"
msgid "Grrrrrr!"
msgstr "Гр-р-р-р!"

#. ja: ヒトになど<br>屈服するものか！
#. de: Niemand verrät uns ungestraft!
#. fr: <if $gn4>Une humaine<else>Un humain</if><nbsp>!? Ah ah ah<nbsp>! Jamais on perdra contre <if $gn4>une des siennes<else>un des siens</if><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5733:0:13"
msgid "Go back to your own lands,<br>Eorzean. This is not your fight!"
msgstr "Убирайся в свои края, эорзейец. Это не твоя битва!"

#. ja: 悪しきは<br>ここで断ち斬る！
#. de: Eure Machenschaften enden hier und jetzt!
#. fr: Débarrassons-nous de ces traîtres, ici et maintenant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5734:0:13"
msgid "I will not quit until<br>justice is had!"
msgstr "Не остановлюсь, пока не свершится правосудие!"

#. ja: ゆくぞっ！
#. de: In den Kampf!
#. fr: Chargez<nbsp>!
msgctxt "NpcYell:5735:0:13"
msgid "Brothers! To arms!"
msgstr "Братья! К оружию!"

#. ja: せっかく育てた<br>農作物が…
#. de: Wie sollen wir jetzt den Winter überstehen?
#. fr: Non... non... non... Regarde ce qu'ils ont fait à mes navets...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5736:0:13"
msgid "How ever will we<br>survive the winter now...?"
msgstr "Как же мы теперь<br>зиму переживём?.."

#. ja: くそ…<br>ケガさえしてなきゃ…
#. de: Grrr ... Lass mir einen übrig!
#. fr: Grrr... Si seulement je n'étais pas blessé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5737:0:13"
msgid "I'd tear their shells off...<br>...iffin' I had a leg to stand on."
msgstr "Содрал бы с них панцири...<br>...да только на ногах не стою."

#. ja: いけっ！
#. de: Immer in die Weichteile piksen!
#. fr: Exterminez-les<nbsp>!
msgctxt "NpcYell:5738:0:13"
msgid "Beat 'em bloody!"
msgstr "Избейте их до кровавых соплей!"

#. ja: 気を付けろ！<br>新手が来るぞ！
#. de: Achtung! Da kommen noch mehr!
#. fr: Attention, en voilà d'autres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5739:0:13"
msgid "More Redbacks comin'<br>o'er the ridge!"
msgstr "Ещё краснопанцирные идут<br>из-за холма!"

#. ja: 勝てるぞぉ！
#. de: Mach weiter so!
#. fr: On va les avoir<nbsp>!
msgctxt "NpcYell:5740:0:13"
msgid "Ye've got 'em!"
msgstr "Вы их дожмёте!"

#. ja: 押せ押せ！
#. de: Jetzt Druck machen!
#. fr: Encore un effort<nbsp>!
msgctxt "NpcYell:5741:0:13"
msgid "Through the breach!"
msgstr "Через пролом!"

#. ja: 勝ち切れなかったか…<br>無念だ…
#. de: Verdammte Kojin. Haben immer ein Ass im Panzer.
#. fr: Maudits Kojin...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5742:0:13"
msgid "And I was lookin' forward<br>to drinkin' from that one's skull."
msgstr "А я-то уже мечтал выпить из черепа одного из них."

#. ja: くっ…！
#. de: Aaaah!
#. fr: Euurgh<nbsp>!
msgctxt "NpcYell:5748:0:13"
msgid "Ugh!"
msgstr "Уф!"

#. ja: きゃあ！
#. de: Uff!
#. fr: Aaargh<nbsp>!
msgctxt "NpcYell:5749:0:13"
msgid "Gah!"
msgstr "А-а!"

#. ja: 損傷確認！<br>急げ…！
#. de: Auf Wassereinbruch prüfen! Schnell!
#. fr: Une avarie<nbsp>! Grouillez<nbsp>!
msgctxt "NpcYell:5750:0:13"
msgid "Check the hull for damage!"
msgstr "Проверьте, не повреждён ли корпус!"

#. ja: ガンブレード！
#. de: Kanonenklinge!
#. fr: Rien ne résiste à mon arme<nbsp>!
msgctxt "NpcYell:5752:0:13"
msgid "Meet my new friend!"
msgstr "Познакомьтесь с моим новым другом!"

#. ja: 斬り刻む！
#. de: Ich schlitz euch auf!
#. fr: Je vais vous mettre en pièces<nbsp>!
msgctxt "NpcYell:5753:0:13"
msgid "I'll cut you to pieces!"
msgstr "Я вас на куски порежу!"

#. ja: 応援に来たが…<br>少し遅かったか
#. de: Hab ich das Beste verpasst?
#. fr: Les renforts sont là<nbsp>! Nous arrivons après la bataille, il semblerait...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5754:0:13"
msgid "The sounds of battle have<br>faded. Have I come too late?"
msgstr "Звуки битвы стихли. Неужели я опоздал?"

#. ja: ふう…<br>押し返せたか…
#. de: Ich glaube, die haben genug ...
#. fr: Ouf... Nous avons enfin réussi à les repousser...
msgctxt "NpcYell:5755:0:13"
msgid "That was the last of them."
msgstr "Это был последний."

#. ja: 喰らえッ！
#. de: Nimm das!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:5756:0:13"
msgid "Take this!"
msgstr "Получай!"

#. ja: はぁ、はぁ…
#. de: Wenigstens kann ich ohne mein Schwert schneller laufen<nbsp>...
#. fr: (souffle) (souffle) Ils sont passés où<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5757:0:13"
msgid "At least without my sword<br>I'm lighter on my feet..."
msgstr "Без меча хотя бы бегать легче..."

#. ja: ぐはっ…
#. de: \<schnauf>
#. fr: Aaargh...
msgctxt "NpcYell:5758:0:13"
msgid "\\<wince>"
msgstr "\\<морщится>"

#. ja: お、おのれ…<br>外道め…
#. de: Verräter!
#. fr: Traîtres à votre race...
msgctxt "NpcYell:5759:0:13"
msgid "Had I...but one more life..."
msgstr "Если бы... у меня была ещё одна жизнь..."

#. ja: いや、来てくれて<br>嬉しく思うぞ！
#. de: Es scheint so, mein Freund!
#. fr: Peu importe<nbsp>! Je suis heureux que vous soyez là<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5760:0:13"
msgid "What is important<br>is that you came."
msgstr "Главное, что ты пришёл."

#. ja: ムッ！？<br>なんだヤツらは…
#. de: Hm? Und die?
#. fr: Hum<nbsp>? Que font-ils encore ici, ces deux-là<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5761:0:13"
msgid "I thought you said<br>that was the last of them!"
msgstr "А я думал, это был последний!"

#. ja: 懲らしめてやったんだ<br>もう思い知っただろう
#. de: Denen haben wir das Fell versohlt. Die beißen nicht mehr.
#. fr: Laisse. Après la déroute qu'ils ont subie, je pense qu'ils ont retenu la leçon.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5762:0:13"
msgid "Our fallen brothers will<br>bother us no longer."
msgstr "Наши павшие братья больше нам не помешают."

#. ja: 人狼族ではない<br>何者かを連れている？
#. de: Wer ist der da? Sieht nicht wie ein Wolfsmann aus.
#. fr: Qu'est-ce que c'est...<nbsp>? Ils sont accompagnés de quelqu'un, mais ce n'est pas un Lupin<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5763:0:13"
msgid "Then what is <i>that</i>!?"
msgstr "Тогда что это за <i>штука</i>?!"

#. ja: 用心棒を<br>雇っていたのか！
#. de: Die haben 'nen Söldner engagiert!
#. fr: Ils ont engagé un mercenaire pour les soutenir<nbsp>!
msgctxt "NpcYell:5764:0:13"
msgid "A hired blade?"
msgstr "Наёмный клинок?"

#. ja: あくまで<br>戦い続けると！？
#. de: Hat das denn nie ein Ende?
#. fr: Ce combat n'en finira donc jamais<nbsp>!?
msgctxt "NpcYell:5765:0:13"
msgid "When will they learn!?"
msgstr "Когда же они наконец поймут?!"

#. ja: ま、負けたままで<br>いられるか…
#. de: Das können wir nicht auf uns sitzen lassen!
#. fr: On... On ne s'avouera jamais vaincu<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5766:0:13"
msgid "Let them think<br>they have won..."
msgstr "Пусть думают,<br>что победили..."

#. ja: オイ！<br>先生はまだか！？
#. de: Wo bleibt der Jäger?
#. fr: Que fait le maître<nbsp>!?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5767:0:13"
msgid "<i>He</i> will soon be here."
msgstr "<i>Он</i> скоро будет здесь."

#. ja: 向かってくれている<br>ハズだが…
#. de: Sollte unterwegs sein.
#. fr: Il devait arriver d'une seconde à l'autre...
msgctxt "NpcYell:5768:0:13"
msgid "Yes, but when!?"
msgstr "Да, но когда?!"

#. ja: 早く来てくれ…
#. de: Das hoff ich doch schwer.
#. fr: Vite... On a besoin de vous...
msgctxt "NpcYell:5769:0:13"
msgid "Soon! He'll be here s─"
msgstr "Скоро! Он будет здесь…"

#. ja: き、来ました！
#. de: Da ist er!
#. fr: Maître<nbsp>! Enfin<nbsp>! Vous êtes là<nbsp>!
msgctxt "NpcYell:5770:0:13"
msgid "Look! Beyond the rise!"
msgstr "Смотрите! За холмом!"

#. ja: おお…先生…<br>お願いします！
#. de: Jäger! Wir brauchen Hilfe!
#. fr: Maître, ce sont eux... Nous comptons sur vous<nbsp>!
msgctxt "NpcYell:5771:0:13"
msgid "I told you!"
msgstr "Я же говорил!"

#. ja: 待たせたなァー？<br>報酬の刀、忘れるなよォー？
#. de: Kratzt schon mal eure Gil zusammen!
#. fr: Me serais-je fait atteeendre<nbsp>? Hmm... Gardez à l'esprit que vous me devez toujours la lame dont nous avons discutééé.
msgctxt "NpcYell:5772:0:13"
msgid "Is this the one needs killing?"
msgstr "Это того надо убить?"

#. ja: 拙者に任せて<br>先へゆくでござる！
#. de: Überlasst sie mir! Geht ihr weiter!
#. fr: Ne vous retournez pas<nbsp>! Bonne chance<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5773:0:13"
msgid "Guard well the<br>young master!"
msgstr "Защищайте юного господина!"

#. ja: 行って！<br>契約は任せたよ！
#. de: Geh! Berühre den Unschuldsfleck!
#. fr: Ça ira<nbsp>! Fonce à la terre immaculée<nbsp>!
msgctxt "NpcYell:5774:0:13"
msgid "Go on! I'll not be long!"
msgstr "Иди! Я скоро догоню!"

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "NpcYell:5775:0:13"
msgid "........."
msgstr "........."

#. ja: なんだテメェ！<br>文句あんのか？
#. de: Was willst du? Hast du ein Problem?
#. fr: Qu'est-ce tu m'veux<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5776:0:13"
msgid "You've got something<br>to say to me, say it!"
msgstr "Есть что сказать —<br>говори!"

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "NpcYell:5777:0:13"
msgid "........."
msgstr "........."

#. ja: 騙される方が悪いんだ！<br>金は返さねぇぞ！
#. de: Selbst schuld, wenn du dich bescheißen lässt!
#. fr: Cours toujours, j'rendrai pas l'argent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5779:0:13"
msgid "That's what I thought!<br>Now out of my way!"
msgstr "Я так и думал!<br>А теперь прочь с дороги!"

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "NpcYell:5780:0:13"
msgid "........."
msgstr "........."

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "NpcYell:5781:0:13"
msgid "\\<nod>"
msgstr "\\<кивает>"

#. ja: 刃向かうヤツは<br>ブチのめしてやる！
#. de: Wer die Waffe gegen uns erhebt, stirbt!
#. fr: Si c'est la bagarre que tu veux, tu vas l'avoir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5782:0:13"
msgid "I've no quarrel with you,<br>outlander. But interfere<br>and I will take you down, too."
msgstr "С тобой у меня счётов нет, чужеземец. Но вмешаешься — и тебе достанется."

#. ja: オラオラ！
#. de: Jaaa!
#. fr: Allez, amène-toi<nbsp>!
msgctxt "NpcYell:5783:0:13"
msgid "Grah!"
msgstr "Гр-а-а!"

#. ja: なめんなよ！
#. de: Was fällt dir ein?!
#. fr: Me sous-estime pas<nbsp>!
msgctxt "NpcYell:5784:0:13"
msgid "Didn't feel a thing!"
msgstr "Да я ничего не почувствовал!"

#. ja: くそがッ！
#. de: Verdammt!
#. fr: Et merde...<nbsp>!
msgctxt "NpcYell:5785:0:13"
msgid "Cat got your tongue!?"
msgstr "Чего язык проглотил?!"

#. ja: こいつ…！
#. de: Dieser ...!
#. fr: Enflure...<nbsp>!
msgctxt "NpcYell:5786:0:13"
msgid "Hmph!"
msgstr "Хм!"

#. ja: ふざけやがって！
#. de: Das wird dir noch leidtun!
#. fr: Je suis un incompris<nbsp>!
msgctxt "NpcYell:5787:0:13"
msgid "Now I'm mad!"
msgstr "Ну всё, я разозлился!"

#. ja: わ、わかった…！<br>オレが悪かった！
#. de: S-Schon gut ... Ich seh's ja ein.
#. fr: C-c'est bon, c'est bon, j'ai compris<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5788:0:13"
msgid "Alright! Alright!<br>You win!"
msgstr "Ладно! Ладно!<br>Ты победил!"

#. ja: 金なら返す…<br>だから許してくれっ！
#. de: Ich geb das Geld zurück ... also lasst mich leben.
#. fr: Je vais rendre l'argent... alors arrête de me taper dessus.
msgctxt "NpcYell:5789:0:13"
msgid "I'll...return the coin."
msgstr "Я... верну деньги."

#. ja: じ、じゃあなっ！
#. de: Wir werden uns wiedersehen<nbsp>...
#. fr: Au plaisir de plus te revoir<nbsp>!
msgctxt "NpcYell:5790:0:13"
msgid "Just leave me be!"
msgstr "Просто оставь меня в покое!"

#. ja: へっへっへっ…<br>ザコは黙ってな！
#. de: Hehe, jetzt bist du schön kleinlaut!
#. fr: Ha ha ha, voilà ce qui arrive quand on cherche des noises à plus fort que soi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5791:0:13"
msgid "You should stick<br>to the gambling tents."
msgstr "Лучше бы тебе держаться подальше от игорных шатров."

#. ja: 草原では力ある者が<br>正義なんだよっ！
#. de: In der Steppe herrscht das Recht des Stärkeren!
#. fr: La loi de la steppe, c'est la loi du plus fort<nbsp>!
msgctxt "NpcYell:5792:0:13"
msgid "You fared better in there!"
msgstr "Там-то ты справился лучше!"

#. ja: ゲハハハハハッ！
#. de: Hahaha!
#. fr: Mouah ha ha ha<nbsp>!
msgctxt "NpcYell:5793:0:13"
msgid "Gah hah hah hah hah!"
msgstr "Га-ха-ха-ха-ха!"

#. ja: おぉ～い！<br>そこのヒトぉ～！
#. de: Gibt es niemanden, der für Gerechtigkeit ...... sorgt?
#. fr: <if $gn4>Humaine<else>Humain</if>, je t'en priiiie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5794:0:13"
msgid "Are there none here who<br>might serve to right a wrong?"
msgstr "Неужели здесь некому<br>восстановить справедливость?"

#. ja: これだけ取り戻せたら<br>満足だぁ～！
#. de: Du hast den Blaupanzern einen großen Dienst ...... erwiesen.
#. fr: Tu viens de rendre un grand service aux Verts, et je t'en remerciiiie.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5795:0:13"
msgid "You have done the Blues a<br>great service. May you be<br>blessed."
msgstr "Ты оказал синепанцирным<br>огромную услугу. Благословляю тебя."

#. ja: うぅ…<br>もう諦めるよぉ～
#. de: Uhhh ... unsere Altäre werden ...... leer bleiben.
#. fr: Oh non, notre précieux butin...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5796:0:13"
msgid "Our altars will remain empty...<br>But not as empty as our hearts."
msgstr "Наши алтари так и останутся пустыми...<br>Но сердца — ещё пустее."

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "NpcYell:5797:0:13"
msgid "........."
msgstr "........."

#. ja: 頑張ってねぇ～
#. de: Viel Glück!
#. fr: Je vois un coffre, là-bas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5798:0:13"
msgid "I believe I saw one over<br>near those rocks!"
msgstr "Кажется, я видел его вон там,<br>за теми скалами!"

#. ja: そろそろ帰る<br>準備をするよぉ～
#. de: Ich muss nach Hause, um die Altäre zu schmücken.
#. fr: Je vais bientôt devoir y aller...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5799:0:13"
msgid "I must return home soon<br>to prepare the altars."
msgstr "Мне пора домой,<br>нужно подготовить алтари."

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "NpcYell:5800:0:13"
msgid "........."
msgstr "........."

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "NpcYell:5801:0:13"
msgid "........."
msgstr "........."

#. ja: ！？
#. de: ...?!
#. fr: !?
msgctxt "NpcYell:5802:0:13"
msgid "!?"
msgstr "!?"

#. ja: ……！！
#. de: ...!
#. fr: ...<nbsp>!!
msgctxt "NpcYell:5803:0:13"
msgid "......!"
msgstr "......!"

#. ja: ！！
#. de: !!!
#. fr: !!
msgctxt "NpcYell:5805:0:13"
msgid "!!!"
msgstr "!!!"

#. ja: ……！？
#. de: ...?!
#. fr: ...<nbsp>!?
msgctxt "NpcYell:5806:0:13"
msgid "......!?"
msgstr "......!?"

#. ja: ！！
#. de: !!!
#. fr: !!
msgctxt "NpcYell:5807:0:13"
msgid "!!!"
msgstr "!!!"

#. ja: ！？
#. de: ?!
#. fr: !?
msgctxt "NpcYell:5808:0:13"
msgid "!?"
msgstr "!?"

#. ja: オイオイ、ダラしないな！
#. de: Was für erbärmliche Gestalten ihr doch seid!
#. fr: Reste pas planté là<nbsp>!
msgctxt "NpcYell:5809:0:13"
msgid "What have we here?"
msgstr "И что тут у нас?"

#. ja: ……！？
#. de: ...?!
#. fr: ...<nbsp>!?
msgctxt "NpcYell:5810:0:13"
msgid "......!?"
msgstr "......!?"

#. ja: こんな状況でも無口かよ！<br>とにかく倒すぞ！
#. de: Na, wollt ihr immer noch nichts sagen?
#. fr: ... Tu veux pas causer, pour une fois<nbsp>!? Allez, on a du mammouth à abattre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5811:0:13"
msgid "Still nothing to say, eh?<br>Let our fists do the<br>talking then!"
msgstr "И всё молчишь, да?<br>Ну что ж, пусть кулаки<br>за нас поговорят!"

#. ja: ！！
#. de: !!
#. fr: !!
msgctxt "NpcYell:5812:0:13"
msgid "!!!"
msgstr "!!!"

#. ja: オラオラ！
#. de: Haha!
#. fr: Je le sens pas<nbsp>!
msgctxt "NpcYell:5813:0:13"
msgid "Hrah!"
msgstr "Ха!"

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "NpcYell:5814:0:13"
msgid "........."
msgstr "........."

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "NpcYell:5815:0:13"
msgid "........."
msgstr "........."

#. ja: なんだよ<br>感謝してるのか？
#. de: Was für ein Glück.
#. fr: Quoi, tu veux me dire merci<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5816:0:13"
msgid "That supposed to<br>be a thank you?"
msgstr "Это ты так спасибо говоришь?"

#. ja: へへへ…<br>じゃあな、あばよ！
#. de: Also dann, bis bald!
#. fr: Bah, c'est rien... Allez, à plus<nbsp>!
msgctxt "NpcYell:5817:0:13"
msgid "Right. I'll take that as a yes."
msgstr "Ладно. Буду считать, что да."

#. ja: クッ…助けるつもりが<br>やられるなんてよ…
#. de: Ich würde dir ja gerne helfen, aber ich bin kein Kämpfer.
#. fr: Et merde, pour une fois que je fais une bonne action...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5818:0:13"
msgid "That'll learn me to<br>help a damn mute."
msgstr "Вот и помогай после этого<br>какому-то молчуну!"

#. ja: すまない…<br>後は頼むぜ…
#. de: Ich zähl auf dich.
#. fr: J-j'abandonne<nbsp>! À vous de jouer<nbsp>!
msgctxt "NpcYell:5819:0:13"
msgid "Please, outlander..."
msgstr "Пожалуйста, чужеземец..."

#. ja: 助けてやってくれ！
#. de: Bitte, rette mich!
#. fr: Au secours<nbsp>!
msgctxt "NpcYell:5820:0:13"
msgid "Don't let that one die..."
msgstr "Не дай ему умереть..."

#. ja: た、助けてっ！
#. de: H-Hilfe!
#. fr: À l'aide<nbsp>!
msgctxt "NpcYell:5821:0:13"
msgid "Help me!"
msgstr "Помогите!"

#. ja: 奴らが<br>戻ってくる前に！
#. de: Sie kommen, um mich zu holen!
#. fr: Ils vont revenir, je le sens...
msgctxt "NpcYell:5822:0:13"
msgid "Hurry! Before they come back!"
msgstr "Скорее! Пока они не вернулись!"

#. ja: ブドゥガ族には<br>なりたくないよ…
#. de: Ich will kein Buduga werden ...
#. fr: Je veux pas devenir un Buduga<nbsp>! Tout mais pas ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5823:0:13"
msgid "I don't want<br>to be a Budugan!"
msgstr "Не хочу<br>становиться будуга!"

#. ja: 男ばっかりの<br>部族なんて…！
#. de: Ein reiner Männerstamm ist nichts für mich!
#. fr: Ils n'ont même pas de femmes dans leur tribu...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5824:0:13"
msgid "I wasn't born to fight!<br>I was born to herd!"
msgstr "Я не создан для битвы!<br>Я пастухом родился!"

#. ja: これでボクも…<br>ブドゥガ族か…
#. de: Muss ich jetzt ein Buduga werden?!
#. fr: J'aurais au moins aimé pouvoir dire adieu aux Mol... (soupire)
msgctxt "NpcYell:5825:0:13"
msgid "They'll kill me for certain..."
msgstr "Меня ведь теперь убьют..."

#. ja: 何をしている！<br>そやつは我らのものぞ！
#. de: Verschwinde! Der Mann gehört uns!
#. fr: Celui-là est à nous<nbsp>! Reste à l'écart, <if $gn4>étrangère<else>étranger</if><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5826:0:13"
msgid "You! Take your hands<br>off our new brother or<br>we'll cut them off!"
msgstr "Эй, руки прочь<br>от нашего нового брата,<br>не то отрубим!"

#. ja: 一族のため！
#. de: Für unseren Stamm!
#. fr: Pour la tribu<nbsp>!
msgctxt "NpcYell:5827:0:13"
msgid "The boy is ours!"
msgstr "Этот парень наш!"

#. ja: 退けっ！
#. de: Vertreibt sie!
#. fr: Hors de mon chemin<nbsp>!
msgctxt "NpcYell:5828:0:13"
msgid "You cannot have him!"
msgstr "Не позволим тебе забрать его!"

#. ja: ハァ、ハァ…
#. de: \<keuch>
#. fr: Grrr...
msgctxt "NpcYell:5829:0:13"
msgid "Curses!"
msgstr "Проклятье!"

#. ja: おのれ化け狐め<br>どこへ消えおった！
#. de: Zeig dich, Ungeheuer!
#. fr: Où est passé ce renard de malheur<nbsp>?
msgctxt "NpcYell:5830:0:13"
msgid "Where is that foul vixen!"
msgstr "Где же эта проклятая лиса!"

#. ja: 小癪な奴め！
#. de: Frevlerin!
#. fr: Montre-toi, vaurien<nbsp>!
msgctxt "NpcYell:5831:0:13"
msgid "Show yourself, woman!"
msgstr "Покажись, женщина!"

#. ja: 者共、妖狐の手先を探せ！
#. de: Sucht die verfluchte Fuchsfee!
#. fr: Personne n'a vu passer un renard<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5832:0:13"
msgid "Find her or it's your blood<br>I use in the next ritual!"
msgstr "Найдите её, иначе вашей кровью<br>я проведу следующий обряд!"

#. ja: そう遠くへは<br>行ってないはずだ！
#. de: Weit kann sie nicht gekommen sein.
#. fr: Cette sale bête n'a pas pu s'enfuir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5833:0:13"
msgid "She's a fox, not an eagle!<br>She could not have gone far!"
msgstr "Она же лиса, не орёл!<br>Далеко уйти не могла!"

#. ja: 何奴だ！
#. de: He, du da!
#. fr: Qui va là<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5834:0:13"
msgid "You know not what<br>you do, stranger!"
msgstr "Ты хоть понимаешь,<br>что творишь, чужеземец?"

#. ja: おのれ…<br>邪魔立てをするか！
#. de: Wir brauchen keine Störenfriede!
#. fr: Hors de mon chemin<nbsp>!
msgctxt "NpcYell:5835:0:13"
msgid "You side with death itself!"
msgstr "Ты встал на сторону самой смерти!"

#. ja: 小癪な！
#. de: Häresie!
#. fr: Disparais<nbsp>!
msgctxt "NpcYell:5836:0:13"
msgid "Hyah! Hyah! Hyah!"
msgstr "Хья! Хья! Хья!"

#. ja: ええい、どけい！
#. de: Aus meinen Augen!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:5837:0:13"
msgid "You will not stand in our way!"
msgstr "Не встанешь у нас на пути!"

#. ja: 容赦はせぬぞ！
#. de: Erwarte keine Gnade!
#. fr: Tu vas le regretter<nbsp>!
msgctxt "NpcYell:5838:0:13"
msgid "Mercy is for the weak!"
msgstr "Пощады не жди!"

#. ja: 今のうちに…<br>玉藻御前のところへ
#. de: Ich muss zu Tamamo no Gozen ...
#. fr: (Profitons-en pour rejoindre Tamamo-no-Gozen...)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5839:0:13"
msgid "I must away...<br>Tamamo Gozen awaits..."
msgstr "Мне пора...<br>Тамамо Годзэн ждёт..."

#. ja: しまった！<br>奴はどこへ消えた！
#. de: Verflucht! Wo ist sie hin?
#. fr: Cette sale bête a encore disparu<nbsp>!
msgctxt "NpcYell:5840:0:13"
msgid "Where did she go!?"
msgstr "Куда она подевалась!?"

#. ja: ここは退いて、<br>テンドウ様に報告だ！
#. de: Wir müssen Tendo Bericht erstatten!
#. fr: Grrr... Il faut que je prévienne le grand prêtre Tendo<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5841:0:13"
msgid "We must inform<br>Master Tendo!"
msgstr "Нужно доложить<br>господину Тэндо!"

#. ja: ここは…
#. de: Wo bin ich?
#. fr: Où suis-je...<nbsp>?
msgctxt "NpcYell:5842:0:13"
msgid "What is...this place...?"
msgstr "Что это... за место?.."

#. ja: 妾は…いったい…
#. de: Was ... geht hier vor?
#. fr: Qu'est-ce qui m'arrive...<nbsp>?
msgctxt "NpcYell:5843:0:13"
msgid "Who...am I...?"
msgstr "Кто... я?.."

#. ja: 頭が…<br>割れるようじゃ…
#. de: Dieses Pochen hinter meiner Stirn ...
#. fr: Ma tête me fait si mal...
msgctxt "NpcYell:5844:0:13"
msgid "The pain... It is unbearable...!"
msgstr "Боль... Не вынести..."

#. ja: 何も…思い出せない…
#. de: Ich kann mich ... an nichts erinnern ...
#. fr: Je ne me rappelle de rien...
msgctxt "NpcYell:5845:0:13"
msgid "Why can I not...remember...?"
msgstr "Почему я... ничего не помню?.."

#. ja: ううう～、なんじゃあいつは！
#. de: Wer bist du?
#. fr: Qu'est-ce qu'il me veut, celui-là<nbsp>?
msgctxt "NpcYell:5846:0:13"
msgid "No... Why must they do this!?"
msgstr "Нет... Почему они так поступают!?"

#. ja: 協力、かたじけない！
#. de: Deine Hilfe sei dir gedankt.
#. fr: Merci pour votre aide<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5847:0:13"
msgid "This kindness will<br>not be forgotten."
msgstr "Я не забуду вашей доброты."

#. ja: さあ、この供物を<br>玉藻御前に届けねば…
#. de: Tamamo no Gozen muss ihr Opfer erhalten.
#. fr: (Il ne me reste plus qu'à apporter les offrandes à Tamamo-no-Gozen...)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5848:0:13"
msgid "I must go now to my mistress.<br>Farewell, kind traveler."
msgstr "Мне пора к госпоже.<br>Прощай, добрый путник."

#. ja: うう…
#. de: Uhhh ...
#. fr: J'ai si mal...
msgctxt "NpcYell:5849:0:13"
msgid "Make it stop..."
msgstr "Хватит..."

#. ja: 妾は…何故ここに…
#. de: Warum bin ich hier?
#. fr: Qu'est-ce que je fais ici...<nbsp>?
msgctxt "NpcYell:5850:0:13"
msgid "I know not this place..."
msgstr "Не знаю этого места..."

#. ja: 氏子たちを…<br>護らねば…
#. de: Ich muss die anderen ... beschützen.
#. fr: Je dois... protéger mes fidèles...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5851:0:13"
msgid "The people... I must...<br>protect...the people..."
msgstr "Людей... нужно...<br>защитить..."

#. ja: はて…<br>いったい妾は何を…？
#. de: Irgendetwas stimmt nicht mit mir.
#. fr: Qui... qui suis-je<nbsp>?
msgctxt "NpcYell:5852:0:13"
msgid "The people...? What people...?"
msgstr "Людей?.. Каких людей?.."

#. ja: ここは、いったいどこじゃ……？<br>妾は、なぜこのような場所を彷徨うておるのか……。
#. de: Was ist dies für ein Ort? Wie bin ich hierher gekommen?
#. fr: Quel est cet endroit...<nbsp>? Et qu'est-ce que je fais ici...<nbsp>?
msgctxt "NpcYell:5853:0:13"
msgid "What is this place? What binds me here?"
msgstr "Что это за место? Что удерживает меня здесь?"

#. ja: うううぅぅぅ……またじゃ……<br>また頭が、割れるように痛む……！
#. de: Uuuhhh ... Mein Kopf ... Es ist, als würde er platzen!
#. fr: Uuuuh, ma tête... Voilà que ça recommence...
msgctxt "NpcYell:5854:0:13"
msgid "Aaah! It feels as if my head were about to burst!"
msgstr "А-а-а! Будто голова сейчас расколется!"

#. ja: そこな女人、どうなされた？<br>気分が優れぬのかね。
#. de: Sprich! Ist dir nicht gut?
#. fr: On dirait que cette jeune fille ne se sent pas bien.
msgctxt "NpcYell:5855:0:13"
msgid "What is it that ails you, milady? Perhaps my associates and I can offer you succor."
msgstr "Что с вами, госпожа? Может, мы с товарищами вам поможем."

#. ja: うぅ……や、やめろ……妾に近づくでない……！
#. de: Ich ... Lass mich ... in Ruhe! Bleib ... weg!
#. fr: Uuuh... Non... NE T'APPROCHE PAS<nbsp>!!!
msgctxt "NpcYell:5856:0:13"
msgid "So much dark... So much pain..."
msgstr "Столько тьмы... Столько боли..."

#. ja: なッ！？　この只ならぬ妖気！<br>さては、お前……九尾の妖狐だな！
#. de: Diese Aura ... Du bist ... von der Fuchsfee besessen!
#. fr: Cette présence maléfique... C'est un renard à neuf queues<nbsp>!!!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5857:0:13"
msgid "Did you feel that!? It was <i>her</i>! She is in there!"
msgstr "Вы это почувствовали!? Это была <i>она</i>! Она внутри неё!"

#. ja: 陰陽師たる我が目はごまかせぬぞ！<br>さあ、大人しく縄についてもらおう……我らの力となるためにな！
#. de: Du kannst mich nicht täuschen - und wirst mir deine Kräfte schenken!
#. fr: Je ne suis pas dupe, <i>Tamamo-no-Gozen</i><nbsp>! Tu vas me suivre bien gentiment, maintenant...
msgctxt "NpcYell:5858:0:13"
msgid "Kyubi of the Nine Tails! If you will not come out willingly, the girl's life is forfeit. Do you want that!?"
msgstr "Кюби, девятихвостая! Не выйдешь добровольно — девчонка умрёт. Неужели тебе этого хочется?!"

#. ja: 大人しく縄につけ！
#. de: Widerstand ist zwecklos!
#. fr: Ça ne sert à rien de résister<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5859:0:13"
msgid "You're coming with us, <i>girl</i>!"
msgstr "Ты пойдёшь с нами, <i>девушка</i>!"

#. ja: い、嫌じゃ！
#. de: Nein!
#. fr: Nooon, lâchez-moi<nbsp>!!!
msgctxt "NpcYell:5860:0:13"
msgid "Keep your hands off me!"
msgstr "Руки прочь!"

#. ja: 来るな…<br>傷つけてしまうぞ…！
#. de: Hör auf! Ich will dich nicht verletzen!
#. fr: L-laissez-moi... Vous... TU VAS LE REGRETTER<nbsp>!!!
msgctxt "NpcYell:5861:0:13"
msgid "Away! All of you. Only death awaits you here..."
msgstr "Прочь! Все прочь. Здесь вас ждёт лишь смерть..."

#. ja: おのれ、邪悪なる妖狐め！<br>我が力となることを拒むというのか！
#. de: Du widersetzt dich meinem Befehl, Füchsin?
#. fr: Laisse-toi faire, vile renarde<nbsp>! Ton pouvoir sera nôtre, que ça te plaise ou non<nbsp>!
msgctxt "NpcYell:5862:0:13"
msgid "Your death, yes. And then your power will be ours!"
msgstr "Да, смерть. А потом ваша сила станет нашей!"

#. ja: こうなったら、力尽くで縄にかけるまでよ！<br>皆の者、奴を捕縛し、ひんがしの国に連れ帰るぞ！
#. de: Dann zapple, bis deine Kräfte schwinden! Männer, wir nehmen sie mit nach Hingashi!
#. fr: Si tu refuses de me suivre bien gentiment jusqu'en Hingashi... Je t'y emmènerai de force<nbsp>!
msgctxt "NpcYell:5863:0:13"
msgid "Tie her up!"
msgstr "Связать её!"

#. ja: うう……頭が割れる……<br>身体が裂けそうじゃ……！
#. de: Argh, mein Kopf ... Mein Körper ... Sie bricht hervor!
#. fr: Ma tête... J'ai l'impression que tout mon corps va exploser...
msgctxt "NpcYell:5864:0:13"
msgid "The pain... Make it stop!"
msgstr "Боль... Хватит!"

#. ja: 生け捕りにするつもりだったが、<br>手懐けられぬというのなら始末するまで！
#. de: Ich hätte sie gern lebend gefangen, aber sie lässt uns wohl keine Wahl.
#. fr: Arrête de résister, tu seras à nous quoi qu'il arrive<nbsp>!
msgctxt "NpcYell:5865:0:13"
msgid "Forget the ropes. We complete the ritual here!"
msgstr "Хватит с нас верёвок. Завершим обряд здесь!"

#. ja: 来たれ、我が式神！<br>妖狐を殺し、その妖気を奪い取るのだ！
#. de: Herbei, mein Geist! Töte die Füchsin und sauge ihre Essenz auf!
#. fr: Ô mon shikigami, occupe-toi de ce démon<nbsp>!
msgctxt "NpcYell:5866:0:13"
msgid "Rise, my pet! It is time to feed!"
msgstr "Восстань, мой питомец! Пора подкрепиться!"

#. ja: 旅の者たち……これ以上、妾に関わるな……！<br>今すぐ逃げねば……逃げねば……
#. de: Ihr alle ... flieht ... wenn ihr leben wollt!
#. fr: Éloignez-vous de moi, tous... Fuyez, avant qu'il ne soit trop tard...
msgctxt "NpcYell:5867:0:13"
msgid "Please... Run now... While I am still...myself..."
msgstr "Пожалуйста... Бегите... Пока я ещё... владею собой..."

#. ja: もう抑えられぬ……<br>ウガアアアアアアアアアアアアアアア！！！
#. de: Ich kann es nicht länger unterdrücken! Grrruuuaaarrrhhh!
#. fr: Je n'en peux plus, je... Argh... Grrr... GRRRAAAOOOH<nbsp>!!!
msgctxt "NpcYell:5868:0:13"
msgid "I cannot hold on much lon─AAAAAAHHHHHH!!!"
msgstr "Я больше не могу сдерживаться─А-А-А-А-А!!!"

#. ja: オオオオオオ……我ガ地ヲ荒ラス、不埒ナ者ドモ！<br>片端カラ食ラッテヤル！！
#. de: Wer wagt es, in meinem Reich zu wüten?! Ich werde euch die Knochen abnagen!
#. fr: Insolents humains... Comment osez-vous fouler mon territoire et faire souffrir mes fidèles<nbsp>?
msgctxt "NpcYell:5869:0:13"
msgid "\\<growl> Who!? Who dares defile the land with their impure magicks!?"
msgstr "\\<рычание> Кто!? Кто смеет осквернять эту землю своей нечестивой магией!?"

#. ja: これがヤンサの地を護り、帝国に抗ったという妖狐の姿！！<br>だが、我が打ち破り、その力を奪ってくれようぞ！
#. de: Da ist die Füchsin, die selbst den Garlearn trotzte! Doch nicht mir!
#. fr: Voilà donc le légendaire démon-renard qui a résisté aux Impériaux pour protéger Yanxia<nbsp>! Ton pouvoir est à nous, ha ha<nbsp>!
msgctxt "NpcYell:5870:0:13"
msgid "Brothers, behold! Protectress of Doma, Kyubi of the Nine Tails!"
msgstr "Братья, взгляните! Защитница Домы, Кюби, девятихвостая!"

#. ja: こ、これが九尾…！
#. de: D-Der neunschwänzige Fuchs!
#. fr: Un renard à neuf queues...<nbsp>!
msgctxt "NpcYell:5871:0:13"
msgid "Should we...?"
msgstr "А нам... что делать?"

#. ja: ひ、ひるむな！
#. de: Zeigt keine Angst!
#. fr: Mes mains tremblent...
msgctxt "NpcYell:5872:0:13"
msgid "Hold! Hold!"
msgstr "Стоять! Не дрогнуть!"

#. ja: 我が力及ばぬとは…<br>九尾の妖狐、恐るべし…
#. de: Welch Dämon, mich zu bezwingen ...
#. fr: Quel pouvoir immense... Je n'étais pas de taille...
msgctxt "NpcYell:5873:0:13"
msgid "I was...a fool..."
msgstr "Я был... глупцом..."

#. ja: グホッ…
#. de: Urghh ...
#. fr: Argh...
msgctxt "NpcYell:5874:0:13"
msgid "And thus...shall die one..."
msgstr "И вот... один из нас падёт..."

#. ja: うぅ…妾はいったい…<br>力が…もう…
#. de: Was ... ist mit mir geschehen? Ich fühle mich so ... kraftlos.
#. fr: Qu'est-ce qui m'est arrivé<nbsp>? Cette force...
msgctxt "NpcYell:5875:0:13"
msgid "What...have I..."
msgstr "Что... со мной..."

#. ja: 玉藻御前の気配…<br>確かに感じたのに！
#. de: Ich war mir sicher, Tamamo no Gozen gespürt zu haben!
#. fr: Où est-elle<nbsp>? J'ai pourtant senti sa présence...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5876:0:13"
msgid "There! My mistress!<br>She is still here with us!"
msgstr "Там! Госпожа!<br>Она всё ещё здесь!"

#. ja: 手遅れになる前に<br>見つけなければ！
#. de: Wir müssen sie finden, bevor es zu spät ist!
#. fr: Il faut la retrouver avant qu'il ne soit trop tard<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5877:0:13"
msgid "We must find her<br>before it is too late!"
msgstr "Нужно найти её,<br>пока не стало слишком поздно!"

#. ja: はぁ、はぁ、はぁ……我には調伏できぬというのか！<br>テンドウ様に報告せねば……。
#. de: \<keuch> ... Wir sind diesem Wesen nicht gewachsen. Tendo muss davon erfahren!
#. fr: Ha ha ha<nbsp>! Tu as compris, maintenant<nbsp>? Il faut que je previenne le grand prêtre Tendo...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5878:0:13"
msgid "She is beyond my power. I must summon <i>him</i>."
msgstr "Она мне не по силам. Пора призвать <i>его</i>."

#. ja: 逃スト思ウカ！<br>延夏ノ地ヲ荒ラス不埒者メ！
#. de: Glaubt nicht, dass ich euch entkommen lasse, Ungläubige!
#. fr: Misérable humain, je vais t'écraser<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:5879:0:13"
msgid "Run, wicked defilers! I have eyes <i>everywhere</i>!"
msgstr "Бегите, нечестивцы! За вами <i>везде</i> следят мои глаза!"

#. ja: う、うぎゃあああぁぁぁ！！
#. de: Urrrkkk ...
#. fr: Aaah<nbsp>! Nooon... AAAAAH<nbsp>!!!
msgctxt "NpcYell:5880:0:13"
msgid "Master Tendo!!!"
msgstr "Господин Тэндо!!!"

#. ja: ここは……懐かしい風を感じる……。<br>妾の氏子らは、元気にしておるじゃろうか……？
#. de: Mir ist, als wäre ich schon einmal hiergewesen. Ob es meinen Kindern wohl gutgeht?
#. fr: Ce doux vent éveille en moi un sentiment de nostalgie...
msgctxt "NpcYell:5881:0:13"
msgid "The wind here seems...somehow familiar."
msgstr "Ветер здесь... будто знакомый."

#. ja: 駄目じゃ……記憶が霞む……<br>力が戻っておらぬからか、土地が穢されたからか……。
#. de: Es ist zwecklos, die Erinnerungen bleiben blass. Dieser Ort muss unrein sein.
#. fr: Non, ça ne me revient pas... Est-ce parce que cette terre a été souillée<nbsp>?
msgctxt "NpcYell:5882:0:13"
msgid "But my past... It remains veiled in shadow..."
msgstr "Но прошлое... всё ещё скрыто во тьме..."

#. ja: ここにいたか、九尾の妖狐め……！
#. de: Da bist du ja, falsche Füchsin!
#. fr: Enfin je te trouve, vile renarde<nbsp>!
msgctxt "NpcYell:5883:0:13"
msgid "Kyubi of the Nine Tails! For twenty and five long summers have you wandered the land─"
msgstr "Вот ты где, девятихвостая лиса... Двадцать пять долгих лет ты скиталась по земле─"

#. ja: 25年前の大戦にて傷つき、地脈との繋がりを断たれ、<br>彷徨っていたようだが、それも今日で終いよ！
#. de: Du kannst die Stimmen des Äthers also immer noch nicht hören? Dabei liegt jener Kampf schon 25 Jahre zurück!
#. fr: Tu erres depuis ta blessure lors de la grande bataille d'il y a vingt-cinq ans, qui t'empêche de retrouver les courants éthérés...
msgctxt "NpcYell:5884:0:13"
msgid "The wounds suffered in defense of your mortal charges deep as the abyss!"
msgstr "Раны, полученные при защите своих смертных подопечных, глубоки, как бездна!"

#. ja: 我が名はテンドウ、ひんがしの国より来る陰陽師である！<br>千年の時を生きた妖狐よ、その力をもらい受ける！
#. de: Ich bin Tendo der Gespiegelte, Onmyoshi aus Hingashi! Ich bin gekommen, um mir deine Kräfte einzuverleiben!
#. fr: Mon nom est Tendo, premier prêtre onmyo du Grand miroir, et je suis venu pour m'emparer de ton pouvoir.
msgctxt "NpcYell:5885:0:13"
msgid "But today, that journey ends! By mine hand, I shall free you!"
msgstr "Но сегодня твои скитания окончатся! Я освобожу тебя своей рукой!"

#. ja: さあ、我が力で調伏してくれようぞ！
#. de: Füge dich oder ende in Qualen!
#. fr: Que l'exorcisme commence<nbsp>!
msgctxt "NpcYell:5886:0:13"
msgid "I shall free all of you!"
msgstr "Я освобожу вас всех!"

#. ja: 下がれ、下郎！<br>お主の如き悪党に、妾の魂を縛らせはせんぞ！
#. de: Hinfort, Elender! Du wirst niemals über mich gebieten!
#. fr: Arrière, mortel<nbsp>! Tes rituels malfaisants n'ont aucun effet sur moi<nbsp>!
msgctxt "NpcYell:5887:0:13"
msgid "Son of man! You are nothing!"
msgstr "Сын человеческий! Ты ничто!"

#. ja: 妾が尽くすは、あの御方だけ…………<br>大切な……あの御方……うぅぅ……頭が……！！
#. de: Dies vermag nur einer. Nur ... Argh, mein Kopf!
#. fr: Eux seuls comptent pour moi... Eux seuls... Uuh, ma tête...
msgctxt "NpcYell:5888:0:13"
msgid "No man may command me... No man but─"
msgstr "Никто не смеет мной повелевать... Никто, кроме─"

#. ja: ウガアアアアァァァァァ！！！
#. de: Grrraaarrrhhh!
#. fr: GRRRAAAOOOH<nbsp>!!!
msgctxt "NpcYell:5889:0:13"
msgid "GRAAAHHH!"
msgstr "ГРА-А-А-А-А-А!!!"

#. ja: 玉藻御前！<br>いけませぬ！
#. de: Tamamo no Gozen! O weh!
#. fr: Tamamo-no-Gozen<nbsp>!
msgctxt "NpcYell:5890:0:13"
msgid "Mistress! No!"
msgstr "Госпожа! Нет!"

#. ja: 我が呪縛を打ち破っただと！？<br>ええい、皆の者！　一斉にかかれい！
#. de: Sie hat meine Fesseln gelöst?!
#. fr: C-comment<nbsp>? Elle a réussi à briser mon sceau... Tous<nbsp>! Arrêtez-la<nbsp>!
msgctxt "NpcYell:5891:0:13"
msgid "The spell of binding... Hurry! We must kill her! Now!"
msgstr "Заклятие сковало её... Скорее! Надо убить её! Сейчас же!"

#. ja: バ、馬鹿な……！？<br>九尾の力……ここまで……とは……！！
#. de: Unmöglich! Selbst der neunschwänzige Fuchs sollte dazu nicht ...!
#. fr: D'où est-ce qu'elle tire un tel pouvoir...<nbsp>!?
msgctxt "NpcYell:5892:0:13"
msgid "Gah! I...cannot...brea─ Ack!"
msgstr "Не может быть! Я... не могу... вздохну─Ах!"

#. ja: お鎮まりください！
#. de: Beruhige dich!
#. fr: Calmez-vous<nbsp>!
msgctxt "NpcYell:5893:0:13"
msgid "Be calmed!"
msgstr "Успокойтесь!"

#. ja: 我を失っておられる！
#. de: Du bist nicht du selbst!
#. fr: Vous n'êtes pas vous-même<nbsp>!
msgctxt "NpcYell:5894:0:13"
msgid "She is lost in her own mind!"
msgstr "Она не владеет собой!"

#. ja: このままでは<br>穢れ神になられてしまう！
#. de: So wirst du zu einem Rachegott!
#. fr: Il faut faire quelque chose<nbsp>! Elle va devenir un dieu-démon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5895:0:13"
msgid "We must lure her back,<br>or she'll be lost forever!"
msgstr "Нужно вернуть её,<br>иначе она потеряется навсегда!"

#. ja: 正気にお戻りください！
#. de: Komm wieder zu dir!
#. fr: Tamamo-no-Gozen, reprenez-vous<nbsp>!
msgctxt "NpcYell:5896:0:13"
msgid "Mistress, please!"
msgstr "Госпожа, прошу!"

#. ja: 誰か、玉藻御前を<br>お鎮めくだされ！
#. de: Jemand muss sie aufhalten!
#. fr: À l'aide<nbsp>! Il faut que quelqu'un la contrôle<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5897:0:13"
msgid "She must be saved, or<br>the land will be ever cursed!"
msgstr "Её нужно спасти, иначе<br>земля навеки проклянёт нас!"

#. ja: ウガアアアアァァァァァ！！！<br>苦シイ……悲シイ……寂シイ……憎イイイイイイ！！！！
#. de: Uaaarrrghhh! Schmerz ... Leid ... Hass ... Einsamkeit ...!
#. fr: GRRRAAAOOOH<nbsp>!!! Douleur, souffrance... HIIIIII<nbsp>!!!
msgctxt "NpcYell:5898:0:13"
msgid "FREE ME! FREE ME FROM THIS PAIN!"
msgstr "Освободите меня! Избавьте меня от этой боли!"

#. ja: 玉藻御前<br>いずこへ…
#. de: Wir müssen schnell zu ihr!
#. fr: Où est-elle partie...? Tamamo-no-Gozen...
msgctxt "NpcYell:5899:0:13"
msgid "She... She's gone..."
msgstr "Она... исчезла..."

#. ja: 早く追わねば<br>穢れ神に！
#. de: Der Schmerz frisst sie auf!
#. fr: Il faut la retrouver avant qu'il ne soit trop tard<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5900:0:13"
msgid "Come, we mustn't<br>abandon hope!"
msgstr "Пойдёмте, нельзя терять надежду!"

#. ja: 玉藻御前！
#. de: Tamamo no Gozen!
#. fr: Tamamo-no-Gozen<nbsp>!
msgctxt "NpcYell:5901:0:13"
msgid "Mistress!"
msgstr "Госпожа!"

#. ja: 嗚呼、おいたわしや
#. de: Es ist noch nicht zu spät!
#. fr: La pauvre...
msgctxt "NpcYell:5902:0:13"
msgid "Is she─!?"
msgstr "Неужели она?.."

#. ja: 微かに力は<br>残っておられる
#. de: Noch hat sie etwas Kraft ...
#. fr: On dirait qu'il lui reste encore des forces.
msgctxt "NpcYell:5903:0:13"
msgid "No. Her heart. It still beats!"
msgstr "Нет. Сердце ещё бьётся!"

#. ja: 早くお連れせねば…！
#. de: Wir müssen sie fortbringen!
#. fr: Il faut qu'on s'occupe d'elle, vite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5904:0:13"
msgid "Come then! We must<br>see her back to health!"
msgstr "Ну же! Надо скорее её вылечить!"

#. ja: オラッ！<br>はやく来い！
#. de: Los, komm schon!
#. fr: On a gagné, suis-nous sans broncher<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5905:0:13"
msgid "Move your feet. You are<br>a Budugan now, boy!"
msgstr "Шевелись! Ты теперь будуг, парень!"

#. ja: く、くそったれ…
#. de: Verdammter Mist ...
#. fr: ...
msgctxt "NpcYell:5906:0:13"
msgid "\\<sigh>"
msgstr "\\<вздох>"

#. ja: 手がかり…<br>手がかりっと…
#. de: Hinweise ... Mal sehen ...
#. fr: Des indices... Voyons, voyons...
msgctxt "NpcYell:5907:0:13"
msgid "Nothing..."
msgstr "Ничего..."

#. ja: 戦闘を怖れて<br>どこかに避難したのか？
#. de: Sie müssen sich irgendwo versteckt haben ...
#. fr: Les habitants ont dû se cacher, mais où<nbsp>?<nbsp>...
msgctxt "NpcYell:5908:0:13"
msgid "They must have gone to ground, but where..."
msgstr "Наверное, они где-то спрятались. Но где?.."

#. ja: 祖父さん…<br>無事でいてくれよ…
#. de: Hoffentlich ist Opa nichts passiert.
#. fr: Grand-père... Pourvu que tu n'aies rien...
msgctxt "NpcYell:5909:0:13"
msgid "Please be all right..."
msgstr "Дедушка... Прошу, будь жив..."

#. ja: 何か見つかれば<br>いいのだが…
#. de: Ich sehe nichts Aufschlussreiches ...
#. fr: Espérons qu'il y ait un indice quelque part...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5910:0:13"
msgid "There has to be a clue<br>somewhere around here..."
msgstr "Здесь где-нибудь должна быть зацепка..."

#. ja: うわっ…<br>ま、負けるかよぉ…！
#. de: Uhh ... Jetzt wird's brenzlig ...
#. fr: Ouah<nbsp>! Je ne vais pas me laisser faire<nbsp>!
msgctxt "NpcYell:5911:0:13"
msgid "Gah! It's just a scratch..."
msgstr "Ай! Пустяковая царапина..."

#. ja: 魅入るがよい…！
#. de: Das werdet ihr bereuen!
#. fr: Laissez-moi tranquille<nbsp>!
msgctxt "NpcYell:5912:0:13"
msgid "You shall bow to ME!"
msgstr "Вы все падёте ниц передо мной!"

#. ja: 人騒がせな…
#. de: Na endlich ...
#. fr: Qu'est-ce qu'il faut pas faire...
msgctxt "NpcYell:5913:0:13"
msgid "Another day another brawl."
msgstr "Ну вот, опять драка."

#. ja: くっ…<br>デカすぎる！
#. de: Der ist ja riesig ...
#. fr: C'est lui<nbsp>!? Mais il est bien trop gros<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5914:0:13"
msgid "“Giant” my arse...<br>That thing is enormous!"
msgstr "«Великан», говоришь? Да он же огромный!"

#. ja: オラたちだけじゃ<br>とてもじゃないが…
#. de: Alleine schaffen wir das nie!
#. fr: On ne pourra jamais en venir à bout à deux...
msgctxt "NpcYell:5915:0:13"
msgid "Our spears will only anger it!"
msgstr "Нашими копьями его только разозлим!"

#. ja: あ、ありがとうございます！
#. de: Vielen Dank!
#. fr: M-merci beaucoup...<nbsp>!
msgctxt "NpcYell:5916:0:13"
msgid "A thousand thanks."
msgstr "Тысячу раз благодарю!"

#. ja: 冒険者部隊の英雄殿が、敵役を務めてくださることになった！
#. de: <if $gn4>Die Kriegerin des Lichts<else>Der Krieger des Lichts</if> beteiligt sich als <if $gn4>Angreiferin<else>Angreifer</if> an der Übung!
#. fr: Aujourd'hui, c'est <if $gn4>l'héroïne<else>le héros</if> de la légion des aventuriers qui va vous servir d'adversaire<nbsp>!
msgctxt "NpcYell:5917:0:13"
msgid "Men! We have something special for you today!"
msgstr "Воины! Сегодня у вас особый противник!"

#. ja: このような機会は、滅多にあることではない！<br>噂の英雄を相手に、自分たちの実力を示してみせろ！
#. de: Eine einmalige Gelegenheit, uns zu beweisen!
#. fr: Vous n'aurez pas souvent la chance de vous entraîner avec <if $gn4>une telle combattante<else>un tel combattant</if>, donc je compte sur vous pour prouver votre valeur<nbsp>!
msgctxt "NpcYell:5918:0:13"
msgid "And some of you might just come out of it alive!"
msgstr "Такой случай выпадает нечасто! Посмотрим, на что вы способны в бою с легендарным героем!"

#. ja: 協力に感謝します！<br>では、行きますよ！
#. de: Vielen Dank! Dann mal ran ans Filetieren!
#. fr: Merci à vous<nbsp>!
msgctxt "NpcYell:5919:0:13"
msgid "Remember... KILL THEM ALL!"
msgstr "Помните... Убейте их всех!"

#. ja: 覚悟しなよ！
#. de: Mach dich bereit!
#. fr: Prépare-toi<nbsp>!
msgctxt "NpcYell:5920:0:13"
msgid "Ready!?"
msgstr "Готовы!?"

#. ja: フン！
#. de: He!
#. fr: Han<nbsp>!
msgctxt "NpcYell:5921:0:13"
msgid "Hah!"
msgstr "Ха!"

#. ja: ハッ！
#. de: Ha!
#. fr: Haaa<nbsp>!
msgctxt "NpcYell:5922:0:13"
msgid "\\<grunt>"
msgstr "\\<крик>"

#. ja: こっちだ！
#. de: Hierher!
#. fr: Par ici<nbsp>!
msgctxt "NpcYell:5923:0:13"
msgid "Over here!"
msgstr "Сюда!"

#. ja: まだまだ！
#. de: Los, weiter!
#. fr: C'est pas fini<nbsp>!
msgctxt "NpcYell:5924:0:13"
msgid "I'm not finished with you yet!"
msgstr "Я с тобой ещё не закончил!"

#. ja: どうだ！
#. de: Noch nicht genug?!
#. fr: Tu aimes ça<nbsp>?
msgctxt "NpcYell:5925:0:13"
msgid "Argh!"
msgstr "Аргх!"

#. ja: ヤッ！
#. de: Haaa!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:5926:0:13"
msgid "Hmph!"
msgstr "Хм!"

#. ja: そこよ！
#. de: Genau da!
#. fr: Je suis là<nbsp>!
msgctxt "NpcYell:5927:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: テイッ！
#. de: Los!
#. fr: Hiyaaah<nbsp>!
msgctxt "NpcYell:5928:0:13"
msgid "No you don't!"
msgstr "Не уйдёшь!"

#. ja: いけッ！
#. de: Lasst nicht locker!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:5929:0:13"
msgid "Not this day! Not ever!"
msgstr "Не сегодня! И никогда!"

#. ja: 倒れろ！
#. de: Stirb!!!
#. fr: Crève<nbsp>!
msgctxt "NpcYell:5930:0:13"
msgid "Stay down!"
msgstr "Лежать!"

#. ja: む、無念…
#. de: Es ist zwecklos ...
#. fr: Non... Argh...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5931:0:13"
msgid "Azim! Why have<br>you forsaken us!"
msgstr "Азим! За что ты нас оставил?!"

#. ja: みんな生きている？
#. de: Haben alle überlebt?
#. fr: Les amis... D-dites-moi que vous êtes toujours en vie<nbsp>!?
msgctxt "NpcYell:5932:0:13"
msgid "Is everyone alright?"
msgstr "Все целы?"

#. ja: 痛てててて…
#. de: Autsch, tut das weh ...
#. fr: Aïe aïe aïe...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5933:0:13"
msgid "This wound will have to<br>be cleaned and dressed..."
msgstr "Рану надо промыть и перевязать..."

#. ja: うぅ…<br>お兄ちゃん…
#. de: Anarba, verzeih mir ...
#. fr: Urgh... Anarba...
msgctxt "NpcYell:5934:0:13"
msgid "Father! Mother! Where are you!?"
msgstr "Папа! Мама! Где вы!?"

#. ja: 嗚呼…<br>バヤン…！
#. de: Bayan ...! Ich habe versagt ...
#. fr: Non... Bayan<nbsp>!!!
msgctxt "NpcYell:5935:0:13"
msgid "Bayan..."
msgstr "Баян..."

#. ja: ブオオオオオオン！！
#. de: Uuuoooaaarrr!
#. fr: Braaahahahaha<nbsp>!
msgctxt "NpcYell:5937:0:13"
msgid "\\<trumpet>"
msgstr "\\<трубный звук>"

#. ja: うーん、いい風だ！
#. de: Heute weht ein herrlicher Wind!
#. fr: Le vent est bien agréable aujourd'hui<nbsp>!
msgctxt "NpcYell:5939:0:13"
msgid "The wind is calm. The air clear."
msgstr "Ветер стих. Воздух чист."

#. ja: うむ、アジム神が<br>我らの旅を祝福しているようだ
#. de: Ja, Azim meint es gut mit uns.
#. fr: Azim lui-même nous souhaite bon voyage<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5940:0:13"
msgid "Aye, the sun sends<br>us his blessing."
msgstr "Да, солнце благословляет наш путь."

#. ja: 次はどこに向かうの？
#. de: Wohin ziehen wir als nächstes?
#. fr: Où allons-nous dresser le camp<nbsp>?
msgctxt "NpcYell:5941:0:13"
msgid "Where are we bound?"
msgstr "Куда теперь направляемся?"

#. ja: 明けの玉座の近くを<br>抜けて北に向かうぞ…
#. de: Am Morgenthron vorbei gen Norden ...
#. fr: Notre destination se trouve au nord, par-delà le Trône de l'Aube.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5942:0:13"
msgid "North. Past the Dawn Throne<br>and across Tao Khaal."
msgstr "На север. Мимо Трона рассвета, через Тао-Хаал."

#. ja: よしっ！<br>俺が先導するぜ！
#. de: Gut, ich geh voraus!
#. fr: Allez, on y va<nbsp>! Le dernier arrivé est un hainag mouillé<nbsp>!
msgctxt "NpcYell:5943:0:13"
msgid "I shall ride at the van."
msgstr "Я поеду впереди."

#. ja: 待たんか、アナーバ！<br>まだ話は…
#. de: Warte, Anarba! Nicht so eilig ...
#. fr: Attends, Anarba<nbsp>! J'ai encore des consignes à...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5944:0:13"
msgid "Anarba! That is not<br>for you to decide! Anarba!"
msgstr "Анарба! Не тебе решать! Анарба!"

#. ja: バズフライだ！
#. de: Brummfliegen!
#. fr: Ouah, des vombrellules<nbsp>!
msgctxt "NpcYell:5947:0:13"
msgid "Buzzflies!"
msgstr "Жужжальницы!"

#. ja: 荷にたかられては面倒だ…<br>片付けるぞ！
#. de: Lasst sie nicht an unsere Vorräte!
#. fr: ... Les ennuis commencent... Tuez-les<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5948:0:13"
msgid "They've our scent.<br>There'll be no outrunning<br>them now. Blades out!"
msgstr "Они взяли наш след. Теперь не уйти. За оружие!"

#. ja: ふむ、これくらいで<br>よかろうな…
#. de: Das ist zum Glück gut ausgegangen.
#. fr: Bon... Ça s'est calmé.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5949:0:13"
msgid "Let us hope<br>that is all of them."
msgstr "Будем надеяться, что это все."

#. ja: これほど苦戦するとは…
#. de: Wir haben unser Bestes gegeben ...
#. fr: Grrr... Ridiculisés par de vulgaires vombrelulles...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5953:0:13"
msgid "Our fortunes will turn...<br>We must will them so."
msgstr "Удача ещё повернётся к нам... Нужно лишь верить."

#. ja: さあ、移動を続けるぞ…
#. de: Los, weiter geht's!
#. fr: Il est temps de nous remettre en route.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5957:0:13"
msgid "Rise, my people!<br>Our journey continues!"
msgstr "Поднимайтесь, народ! Путь продолжается!"

#. ja: ねぇ！<br>あれを見て！
#. de: Achtung, da!
#. fr: Euh... Vous voyez ce que je vois<nbsp>?
msgctxt "NpcYell:5958:0:13"
msgid "Khan! Gedan block our path!"
msgstr "Хан! Геданы преградили нам путь!"

#. ja: むっ…ガーダンの群れか<br>追い払うぞ！
#. de: Gedane! Schlagt die Viecher zurück!
#. fr: Par Azim... des gedans<nbsp>! Aux armes<nbsp>!
msgctxt "NpcYell:5959:0:13"
msgid "Protect the animals!"
msgstr "Защитите скот!"

#. ja: 無事に<br>追い払えたようだな…
#. de: Denen dürfte der Appetit vergangen sein.
#. fr: Ouf... Il s'en est fallu de peu...
msgctxt "NpcYell:5960:0:13"
msgid "See! Our path is blessed!"
msgstr "Видите? Путь наш благословен!"

#. ja: よし、この場を<br>今回の居留地とするぞ！
#. de: Gut, hier schlagen wir unser Lager auf!
#. fr: En tout cas, nous y voilà<nbsp>! Cet endroit sera notre nouveau chez-nous<nbsp>!
msgctxt "NpcYell:5964:0:13"
msgid "It is here we shall make camp!"
msgstr "Вот здесь и разобьём лагерь!"

#. ja: アルタニ<br>はぐれ馬の世話を頼む！
#. de: Altani, kümmer dich um das Pferd!
#. fr: Altani, je compte sur toi pour prendre soin du cheval.
msgctxt "NpcYell:5965:0:13"
msgid "Altani! See to the stallion!"
msgstr "Алтани! Позаботься о жеребце!"

#. ja: はい…！
#. de: Klar, mach ich!
#. fr: Pas de problème<nbsp>!
msgctxt "NpcYell:5966:0:13"
msgid "Yes, Khan."
msgstr "Да, хан."

#. ja: さあ、お馬さん<br>こっちよ…
#. de: Los, komm zu mir!
#. fr: Suis-moi, mon beau.
msgctxt "NpcYell:5967:0:13"
msgid "This way. Quietly now."
msgstr "Идём сюда. Тише..."

#. ja: どうにか…<br>追い払えたか…
#. de: Das war knapp ...
#. fr: C'était rude, mais on s'en est sortis...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5968:0:13"
msgid "The losses do not<br>seem too great... Still..."
msgstr "Потерь вроде немного... Но всё же..."

#. ja: ひとまず<br>ここを居留地としよう…
#. de: Vorerst können wir hier lagern.
#. fr: Ne reste plus qu'à planter nos yourtes.
msgctxt "NpcYell:5972:0:13"
msgid "We make our camp here."
msgstr "Разобьём лагерь здесь."

#. ja: さてとメェメェちゃん！<br>乳搾りの時間だよ！
#. de: Es ist an der Zeit, die Schäfchen zu melken!
#. fr: Allez ma petite bêê-bêê, c'est l'heure de donner ton lait<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5976:0:13"
msgid "Gather, little ones!<br>It is time for milking!"
msgstr "Собирайтесь, ягнятки! Пора доить!"

#. ja: 旅人さんも<br>乳搾りやってみる？
#. de: Fremde<if $gn4><else>r</if>, willst du es auch versuchen?
#. fr: <if $gn4>Étrangère<else>Étranger</if>, ça te dirait de traire mes brebis<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5977:0:13"
msgid "Would the traveler<br>like to join me?"
msgstr "Путник, не хочешь попробовать?"

#. ja: もっとあれば<br>チーズが作れそうね…
#. de: Wir könnten noch mehr Milch für Käse gebrauchen.
#. fr: J'aurai bientôt assez de lait pour faire du fromage<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5978:0:13"
msgid "Rarely do we collect enough<br>to make cheese, but today..."
msgstr "Редко молока хватает на сыр, но сегодня..."

#. ja: いっぱい搾れたわ！<br>これでお酒が作れるわ！
#. de: Mit so viel Milch hatte ich nicht gerechnet!
#. fr: Tout ce lait, c'est formidable<nbsp>! Je vais pouvoir fabriquer de l'aïrag en veux-tu en voilà<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5979:0:13"
msgid "So many jugs!<br>This calls for celebration!"
msgstr "Целые кувшины! Это надо отпраздновать!"

#. ja: ちょっと足りないけど…<br>仕方ないわね…
#. de: Oje, nur so wenig Milch ...?
#. fr: Ah, c'est un peu juste comme quantité de lait... Tant pis...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5980:0:13"
msgid "Barely enough to boil a goat's<br>head. But it will have to do."
msgstr "Едва хватит, чтобы сварить козью голову. Ну да ладно."

#. ja: いたいた！
#. de: Da sind sie!
#. fr: Les voilà<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5981:0:13"
msgid "There! You can see the<br>dust rise from the steppe!"
msgstr "Вон! Видите, как степная пыль поднимается!"

#. ja: 野生のケナガウシだ！
#. de: Die wilden Dzos!
#. fr: Des hainags sauvages bien dodus<nbsp>! J'en salive déjà<nbsp>!
msgctxt "NpcYell:5982:0:13"
msgid "A herd of wild dzos!"
msgstr "Целое стадо диких дзо!"

#. ja: よし、肉も残り少ないし<br>狩りにいくとするか！
#. de: Dann wollen wir mal unseren Fleischvorrat auffüllen!
#. fr: Ça fait longtemps que je n'ai pas mangé de viande... Par ici, mes petits<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5983:0:13"
msgid "Even a few of their number<br>will fill our tribe's bellies<br>and see our tents warm."
msgstr "Даже несколько голов накормят наш народ и согреют наши шатры."

#. ja: これだけ肉が獲れれば<br>ホルホグも食べ放題だ！
#. de: Aus dem Fleisch können wir Khorkhog zubereiten!
#. fr: Y a assez de viande pour un bon gros khorkhog<nbsp>! Si ça se trouve, je pourrai même me resservir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5984:0:13"
msgid "A bowl of hot khorkhog<br>is reward enough for<br>the day's hunt!"
msgstr "Миска горячего хорхога — достойная награда за охоту!"

#. ja: くっそぉ…<br>ホルホグが食べたかった…
#. de: Mist, ich wollte doch so gern Khorkhog essen ...
#. fr: Adieu, mon khorkhog...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5985:0:13"
msgid "The khorkhog will be thin<br>tonight, I'm afraid..."
msgstr "Боюсь, сегодня хорхога будет маловато..."

#. ja: む…<br>家畜たちが騒がしいな…
#. de: Hm? Unsere Schafe sind so unruhig.
#. fr: Hmm, les brebis sont bien agitées...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5986:0:13"
msgid "Something has the<br>animals frightened."
msgstr "Что-то напугало скотину."

#. ja: あれはガーダンの群れ！
#. de: Eine Gedan-Meute!
#. fr: Qu'est-ce que... Oh non, des gedans<nbsp>!
msgctxt "NpcYell:5987:0:13"
msgid "Listen! The howls of gedan!"
msgstr "Слышите? Это воют геданы!"

#. ja: アルタニ！<br>家畜たちをお願い！
#. de: Altani! Beschütze unsere Tiere!
#. fr: Altani<nbsp>! Protège le bétail<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5988:0:13"
msgid "Quick, Altani!<br>See to the sheep!"
msgstr "Живее, Алтани! Позаботься об овцах!"

#. ja: 追い払われた連中が<br>戻ってきたんだ！
#. de: Die vertriebenen Gedane sind wieder da!
#. fr: C'est ceux qui nous ont attaqués la dernière fois<nbsp>! Ils veulent leur revanche<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5989:0:13"
msgid "It is the same pack that<br>hounded us earlier. They<br>will follow until they are<br>sated...or dead."
msgstr "Это та же стая, что гнала нас раньше. Они не отстанут, пока не насытятся... или не сдохнут."

#. ja: はいっ！
#. de: Ja!
#. fr: À tes ordres<nbsp>!
msgctxt "NpcYell:5990:0:13"
msgid "Yes, mother!"
msgstr "Да, мама!"

#. ja: 北からも来るぞ！
#. de: Aus dem Norden kommen auch welche!
#. fr: Ils arrivent par le nord<nbsp>!
msgctxt "NpcYell:5991:0:13"
msgid "More come from the north!"
msgstr "Ещё и с севера идут!"

#. ja: やってやる！
#. de: Die schnapp ich mir!
#. fr: Venez, j'ai pas peur de vous<nbsp>!
msgctxt "NpcYell:5992:0:13"
msgid "Let them!"
msgstr "Пусть только сунутся!"

#. ja: ふぅ…<br>追い払えたか…
#. de: Puh, ich glaube, das war's.
#. fr: Pfiou... C'était le dernier<nbsp>?
msgctxt "NpcYell:5993:0:13"
msgid "They will disturb us no longer."
msgstr "Больше они нас не побеспокоят."

#. ja: 羊たち！<br>早く、早く！
#. de: Unsere armen Schafe!
#. fr: Allez, mes petites, on se dépêche<nbsp>!
msgctxt "NpcYell:5994:0:13"
msgid "This way, little ones!"
msgstr "Сюда, ягнятки! Живее!"

#. ja: どうやらここは<br>奴らの縄張りのようだ
#. de: Hier ist wohl ihr Jagdgebiet.
#. fr: Je crois qu'on s'est installés sur leur territoire...
msgctxt "NpcYell:5997:0:13"
msgid "The pack has our scent."
msgstr "Стая взяла наш след."

#. ja: 予定を早めて<br>出発するとしよう
#. de: Wir sollten schneller als geplant weiterziehen.
#. fr: On ne va pas pouvoir s'éterniser ici...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:5998:0:13"
msgid "Their noses are bloodied,<br>but if we do not leave now,<br>they will soon grow bold again."
msgstr "Они уже получили по носу, но если сейчас не уйдём, скоро опять осмелеют."

#. ja: 天幕をたたみ<br>旅支度を！
#. de: Baut die Zelte ab und packt alles zusammen!
#. fr: Pliez les yourtes<nbsp>! Nous allons repartir<nbsp>!
msgctxt "NpcYell:5999:0:13"
msgid "My people! We break camp!"
msgstr "Народ! Сворачиваем лагерь!"
