# NpcYell
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: ヒエン様は<br>ご無事であろうか…
#. de: Ich kann nicht aufhören, an Hien zu denken<nbsp>...
#. fr: Pourvu qu'il ne soit rien arrivé au seigneur Hien...
msgctxt "NpcYell:16000:0:13"
msgid "I pray Lord Hien is safe..."
msgstr ""

#. ja: 忍術の猿真似など…<br>許せぬ！
#. de: Sie wagen es, unsere Techniken nachzuahmen<nbsp>...! Das werdet ihr bereuen!
#. fr: Se moquer des shinobi de la sorte... Voilà le genre d'affront que je ne pardonne pas<nbsp>!
msgctxt "NpcYell:16001:0:13"
msgid "Pretenders! I will not suffer this mockery of ninjutsu!"
msgstr ""

#. ja: なんと驚いた！<br>忍びでござるか！？
#. de: Warum sind diese Shinobi hier?
#. fr: Des shinobi<nbsp>? Mais pourquoi<nbsp>?
msgctxt "NpcYell:16002:0:13"
msgid "What? Are they shinobi!?"
msgstr ""

#. ja: 所詮は猿真似…！<br>奥義を会得できるものか！
#. de: Reine Imitationen<nbsp>... Als ob sie die Tiefe unserer Kampfkunst begreifen könnten!
#. fr: Ce ne sont que de pâles imitateurs, et je vais vous le prouver sur-le-champ<nbsp>!
msgctxt "NpcYell:16003:0:13"
msgid "Naught but pretenders! Our techniques are beyond their ilk!"
msgstr ""

#. ja: 城内にまで<br>魔導兵器を配備したか…！
#. de: Sie haben selbst in der Burg Magitek-Waffen platziert<nbsp>...!
#. fr: Oh non... Pas des armes magitek dans ce lieu sacré...
msgctxt "NpcYell:16004:0:13"
msgid "They deploy machina even inside the castle!"
msgstr ""

#. ja: 美しき城に<br>なんと無粋な兵器を…！
#. de: Solch groteske Waffen in diesen wunderschönen Hallen<nbsp>...!
#. fr: Des armes aussi grotesques dans un château somptueux comme celui-ci, quelle tragédie<nbsp>!
msgctxt "NpcYell:16005:0:13"
msgid "That such a barbaric weapon should defile our beautiful castle..."
msgstr ""

#. ja: 打ち払うのみ！
#. de: Diesen Anblick werden wir nicht mehr lange ertragen müssen!
#. fr: Ils ne vont pas s'en servir bien longtemps<nbsp>!
msgctxt "NpcYell:16006:0:13"
msgid "It will not do so for much longer!"
msgstr ""

#. ja: なんだ…この異様な気配は？<br>まるで獣のようだが…
#. de: Diese Aura<nbsp>... Etwas stimmt mit ihm nicht. Er ist fast wie eine wilde Bestie<nbsp>...
#. fr: Quelle atmosphère étrange... comme si une bête féroce allait se jeter sur nous...
msgctxt "NpcYell:16007:0:13"
msgid "This aura... 'Tis as if he were a beast."
msgstr ""

#. ja: なんだ…この異様な気配は？<br>まるで獣のようだが…
#. de: Diese Aura<nbsp>... Etwas stimmt mit ihm nicht. Er ist fast wie eine wilde Bestie<nbsp>...
#. fr: Quelle atmosphère étrange... comme si une bête féroce allait se jeter sur nous...
msgctxt "NpcYell:16008:0:13"
msgid "This aura... 'Tis as if he were a beast."
msgstr ""

#. ja: 破れかぶれの<br>死兵でござるか？
#. de: Am gefährlichsten sind jene Soldaten, welche nichts mehr zu verlieren haben<nbsp>...
#. fr: Il n'y a pas de désespoir plus grand que celui aux portes de la mort...
msgctxt "NpcYell:16009:0:13"
msgid "And one with nothing to lose."
msgstr ""

#. ja: さあ、暴れてやりましょう！
#. de: Dann wollen wir mal loslegen!
#. fr: Chaud devant<nbsp>!
msgctxt "NpcYell:16010:0:13"
msgid "All right, let's raise hells!"
msgstr ""

#. ja: 敵をこちらに<br>引き付けるんだ！
#. de: Bringt sie alle hier zusammen!
#. fr: Attirons l'attention de nos ennemis<nbsp>!
msgctxt "NpcYell:16011:0:13"
msgid "Aye! The more enemies we can draw, the better!"
msgstr ""

#. ja: 魔導兵器の<br>輸送用コンテナか…？
#. de: Sind das etwa Transportcontainer für Magitek-Waffen<nbsp>...?
#. fr: Serait-ce... des conteneurs d'armes magitek<nbsp>?
msgctxt "NpcYell:16012:0:13"
msgid "They're weapon transport containers."
msgstr ""

#. ja: なら、ここで破壊しないと！
#. de: Die zerstören wir besser gleich mit!
#. fr: Quoi qu'il en soit, autant les détruire tout de suite<nbsp>!
msgctxt "NpcYell:16013:0:13"
msgid "Best destroy them here and now!"
msgstr ""

#. ja: 兵器の開発施設のようだね
#. de: Hier entwickeln sie wohl ihre ganzen Waffen.
#. fr: On dirait un centre de développement d'armes de combat...
msgctxt "NpcYell:16014:0:13"
msgid "This appears to be a testing facility."
msgstr ""

#. ja: なら、私たちが性能を<br>テストしてやりましょう！
#. de: Dann wollen wir ihren Entwicklungsprozess mal auf die Probe stellen!
#. fr: Faisons passer un petit examen de routine à celle-ci<nbsp>!
msgctxt "NpcYell:16015:0:13"
msgid "Well then, let's put this thing through its paces!"
msgstr ""

#. ja: 残念、テストは不合格よ
#. de: Pech gehabt, Prüfung nicht bestanden!
#. fr: Désolée mais elle mérite même pas la moyenne<nbsp>!
msgctxt "NpcYell:16016:0:13"
msgid "I'm afraid that's a fail."
msgstr ""

#. ja: あの突進速度は<br>脅威だったけれどね
#. de: Bonuspunkte für den Hochgeschwindigkeitsangriff bekommen sie von mir trotzdem.
#. fr: Parle pour toi, j'ai cru que j'allais me faire écrabouiller...
msgctxt "NpcYell:16017:0:13"
msgid "A notable mention for its acceleration, however."
msgstr ""

#. ja: ポッドの中に何かいる…！
#. de: Ist da etwas in diesen Kapseln drin<nbsp>...?
#. fr: C'est moi ou il y a quelque chose dans ces caissons<nbsp>?
msgctxt "NpcYell:16018:0:13"
msgid "Something in those pods..."
msgstr ""

#. ja: まさか人か…？
#. de: Sind das etwa Personen<nbsp>...?!
#. fr: Cette forme... Serait-ce pour des êtres humains<nbsp>?
msgctxt "NpcYell:16019:0:13"
msgid "It couldn't be...people?"
msgstr ""

#. ja: 人を強化しようなどと…！
#. de: Sie versuchen, sich über ihre Grenzen zu verstärken<nbsp>...!
#. fr: Ils cherchent à créer des humains augmentés<nbsp>!
msgctxt "NpcYell:16020:0:13"
msgid "That they should so enhance men..."
msgstr ""

#. ja: ポッドの動作を止めましょう！
#. de: Schnell, lasst uns die Kapseln außer Gefecht setzen!
#. fr: Mettons-les hors service, ça leur apprendra<nbsp>!
msgctxt "NpcYell:16021:0:13"
msgid "We must shut the pods down!"
msgstr ""

#. ja: 額に第三の目…<br>ガレアン族なの…！？
#. de: Ein drittes Auge auf der Stirn<nbsp>... Ist das ein Garlear<nbsp>...!?
#. fr: S'il a un troisième œil sur le front, c'est un Garlemaldais de souche, pas vrai<nbsp>?
msgctxt "NpcYell:16022:0:13"
msgid "A third eye... That man is Garlean!"
msgstr ""

#. ja: 相当な強化を<br>施されているようだね…
#. de: Er muss sich einer ordentlichen Verstärkung unterzogen haben<nbsp>...
#. fr: Un Garlemaldais de souche légèrement augmenté, alors...
msgctxt "NpcYell:16023:0:13"
msgid "And he's undergone extensive enhancements."
msgstr ""

#. ja: 魔法を使う<br>ガレアン族だなんて…
#. de: Ein Garlear, der Magie verwenden kann<nbsp>...
#. fr: En tout cas, il savait utiliser la magie...
msgctxt "NpcYell:16024:0:13"
msgid "A Garlean who can use magic..."
msgstr ""

#. ja: 種族的な弱点を補うため<br>研究をしていたのか？
#. de: Haben sie hier Forschung betrieben, um ihren angeborenen Schwachpunkt auszugleichen?
#. fr: Il cherchait sans doute à combler la lacune principale de ses semblables...
msgctxt "NpcYell:16025:0:13"
msgid "It seems they seek to augment their people's weakness."
msgstr ""

#. ja: 向こうにも<br>別の施設があるようだ
#. de: Auf der anderen Seite scheint noch eine Einrichtung zu sein.
#. fr: On dirait qu'il y a une autre usine en face...
msgctxt "NpcYell:16026:0:13"
msgid "Another facility up ahead."
msgstr ""

#. ja: 隔離してるあたり<br>何かありそうね
#. de: Bei der isolierten Lage muss da ja was Besonderes sein.
#. fr: S'ils l'ont séparée de celle-ci, c'est forcément pour une bonne raison<nbsp>!
msgctxt "NpcYell:16027:0:13"
msgid "By the way it's set apart, I'd wager it's important."
msgstr ""

#. ja: これほどの兵力を投じて<br>妨害するということは…
#. de: Die Wachen hier nehmen ja gar kein Ende<nbsp>...!
#. fr: Cette zone est encore plus protégée que les précédentes<nbsp>!
msgctxt "NpcYell:16028:0:13"
msgid "They certainly do not want us here."
msgstr ""

#. ja: 重要な施設と見たわ！
#. de: Ihnen ist diese Einrichtung definitiv wichtig!
#. fr: À mon avis, c'est pas pour rien<nbsp>!
msgctxt "NpcYell:16029:0:13"
msgid "And that only makes it more inviting!"
msgstr ""

#. ja: ねえ、あれって機械なの？<br>それとも生き物？
#. de: Ist das eine Maschine? Oder eine lebendige Kreatur?
#. fr: C'est quoi, ce truc<nbsp>!? Une machine... ou un être vivant<nbsp>?
msgctxt "NpcYell:16030:0:13"
msgid "What is that thing? A machina or a beast?"
msgstr ""

#. ja: わからない…<br>だが、危険を感じるよ…！
#. de: Ich bin mir nicht sicher<nbsp>... Aber es wirkt auf jeden Fall gefährlich<nbsp>...!
#. fr: J'en sais rien, mais ça n'a pas l'air commode...
msgctxt "NpcYell:16031:0:13"
msgid "Whatever it is, it's dangerous! Have care!"
msgstr ""

#. ja: 王宮まで突き進もう！
#. de: Unser Ziel ist der Königspalast!
#. fr: Objectif<nbsp>: le palais royal<nbsp>!
msgctxt "NpcYell:16032:0:13"
msgid "To the Royal Palace!"
msgstr ""

#. ja: アタシは止まらねぇ！
#. de: Niemand wird mich aufhalten!
#. fr: Tu vas voir de quel bois j'me chauffe<nbsp>!
msgctxt "NpcYell:16033:0:13"
msgid "I've got you now!"
msgstr ""

#. ja: 猛牛流でいかせてもらう！
#. de: Der Bulle von Ala Mhigo ist hier!
#. fr: Le taureau d'Ala Mhigo va vous montrer comment on charge l'ennemi<nbsp>!
msgctxt "NpcYell:16034:0:13"
msgid "We strike hard and fast like a raging bull!"
msgstr ""

#. ja: そうだね！<br>王宮まで突き進もう！
#. de: Perfekt! Unser Ziel ist der Königspalast!
#. fr: Parfait<nbsp>! Objectif<nbsp>: le palais royal<nbsp>!
msgctxt "NpcYell:16035:0:13"
msgid "Sounds good to me! To the Royal Palace!"
msgstr ""

#. ja: 黒渦団か！<br>すごい威力だな…
#. de: Beeindruckend! Scheinbar ist auf den Mahlstrom doch Verlass!
#. fr: Eh bien, on dirait qu'il n'y a pas que des lavettes au Maelstrom<nbsp>!
msgctxt "NpcYell:16036:0:13"
msgid "They've got some firepower, the Maelstrom!"
msgstr ""

#. ja: 間に合うか…！？
#. de: Hoffentlich schaffen wir es noch rechtzeitig!
#. fr: On y est presque<nbsp>!
msgctxt "NpcYell:16037:0:13"
msgid "Keep running, we're almost there!"
msgstr ""

#. ja: ル・アシャ大甲佐か！？
#. de: Sturmkapitänleutnant R'ashaht!?
#. fr: C'est la colonelle Rhiki<nbsp>!
msgctxt "NpcYell:16038:0:13"
msgid "Commander Rhiki has cleared the way for us!"
msgstr ""

#. ja: ありがとう！<br>援護に感謝するよ！
#. de: Die Unterstützung kam gerade recht!
#. fr: Elle ne pouvait pas mieux tomber<nbsp>! Merci pour les renforts<nbsp>!
msgctxt "NpcYell:16039:0:13"
msgid "Much obliged for the help!"
msgstr ""

#. ja: さすが門前の護りは堅いな…！
#. de: Wie erwartet, das Haupttor ist gut bewacht<nbsp>...!
#. fr: L'entrée principale est solidement protégée, en tout cas<nbsp>!
msgctxt "NpcYell:16040:0:13"
msgid "The front gate's well defended as you'd expect."
msgstr ""

#. ja: 見たことのない魔導兵器だ<br>新型か…！？
#. de: So eine Magitek-Maschine habe ich noch nie gesehen. Etwa ein neues Modell<nbsp>...!?
#. fr: Voilà une toute nouvelle arme magitek ou je ne m'y connais pas...
msgctxt "NpcYell:16041:0:13"
msgid "A new type of weapon!?"
msgstr ""

#. ja: 見たことのない魔導兵器だ<br>新型か…！？
#. de: So eine Magitek-Maschine habe ich noch nie gesehen. Etwa ein neues Modell<nbsp>...!?
#. fr: Voilà une toute nouvelle arme magitek ou je ne m'y connais pas...
msgctxt "NpcYell:16042:0:13"
msgid "A new type of weapon!?"
msgstr ""

#. ja: ティソーナの炎で焼き尽くす！<br>突貫するぞ！
#. de: Gegen Tizona's Flammen wird es nicht ankommen! Machen wir kurzen Prozess damit!
#. fr: Elle va bientôt sentir les flammes de Tizona crépiter dans ses entrailles<nbsp>!
msgctxt "NpcYell:16043:0:13"
msgid "New or old, Tizona will carve a path through it."
msgstr ""

#. ja: よし、これで王宮に進めるぞ！
#. de: Damit ist der Weg zum Palast frei!
#. fr: La route est libre, continuons<nbsp>!
msgctxt "NpcYell:16044:0:13"
msgid "The way to the palace is clear!"
msgstr ""

#. ja: ここまでは順調だ…<br>ほかの部隊は…
#. de: So weit, so gut<nbsp>... Hoffentlich läuft es bei den anderen ähnlich<nbsp>...
#. fr: Pour l'instant, tout se déroule comme prévu... Pour les autres aussi, j'espère...
msgctxt "NpcYell:16045:0:13"
msgid "No problems so far. I hope it's the same for the others."
msgstr ""

#. ja: ここまでは順調だ…<br>ほかの部隊は…
#. de: So weit, so gut<nbsp>... Hoffentlich läuft es bei den anderen ähnlich<nbsp>...
#. fr: Pour l'instant, tout se déroule comme prévu... Pour les autres aussi, j'espère...
msgctxt "NpcYell:16046:0:13"
msgid "No problems so far. I hope it's the same for the others."
msgstr ""

#. ja: 今は信じて進むのみ！<br>王宮を攻めるぞ！
#. de: Hab Vertrauen und fokussier dich auf unsere Aufgabe! Auf, zum Palast!
#. fr: Garde la foi et concentre-toi sur ton objectif, garçon<nbsp>!
msgctxt "NpcYell:16047:0:13"
msgid "We can but have faith and do our part. Come, the palace awaits!"
msgstr ""

#. ja: ほかの部隊も<br>侵入に成功してるみたい！
#. de: Seht, die anderen Trupps konnten auch in den Palast vordringen!
#. fr: Nos alliés semblent tous avoir pénétré dans le palais<nbsp>!
msgctxt "NpcYell:16048:0:13"
msgid "Look! The others have made it in as well!"
msgstr ""

#. ja: ここからが正念場だ<br>気を引き締めろ！
#. de: Ab jetzt heißt es alles oder nichts! Volle Konzentration!
#. fr: L'heure de vérité a sonné<nbsp>! Ne vous relâchez pas<nbsp>!
msgctxt "NpcYell:16049:0:13"
msgid "This is the moment of truth. Don't get complacent!"
msgstr ""

#. ja: すごい！<br>優勢なんじゃないか！？
#. de: Haben wir etwa die Oberhand!?
#. fr: Ouah, quel talent<nbsp>!
msgctxt "NpcYell:16050:0:13"
msgid "Well, I'll be! We might even have the upper hand!"
msgstr ""

#. ja: ここからが正念場だ<br>気を引き締めろ！
#. de: Ab jetzt heißt es alles oder nichts! Volle Konzentration!
#. fr: L'heure de vérité a sonné<nbsp>! Ne vous relâchez pas<nbsp>!
msgctxt "NpcYell:16051:0:13"
msgid "This is the moment of truth. Don't get complacent!"
msgstr ""

#. ja: オヤジに習ったこの技で！
#. de: Mit Gruß von meinem Alterchen!
#. fr: Mange donc cette technique du paternel<nbsp>!
msgctxt "NpcYell:16052:0:13"
msgid "This is for you, Papa!"
msgstr ""

#. ja: 立ち止まれば<br>いい的だ…！
#. de: Nicht stehenbleiben, das macht ihnen das Zielen leichter!
#. fr: Le meilleur moyen de les éviter, c'est de continuer à avancer<nbsp>!
msgctxt "NpcYell:16053:0:13"
msgid "Keep moving or you'll be an easy target!"
msgstr ""

#. ja: 砲撃がくるぞ！
#. de: Achtung, Kanonenfeuer!
#. fr: Attention aux tirs d'artillerie<nbsp>!
msgctxt "NpcYell:16054:0:13"
msgid "Watch out! Artillery!"
msgstr ""

#. ja: 足を止めずに進もう！
#. de: Weiter, nicht schlappmachen!
#. fr: Pas le moment de ralentir, les amis<nbsp>!
msgctxt "NpcYell:16055:0:13"
msgid "Move it, move it!"
msgstr ""

#. ja: あのヘンテコな椅子は何…？
#. de: Was ist das für ein komischer Stuhl<nbsp>...?
#. fr: Mais d'où sort cette... chaise bizarroïde<nbsp>!?
msgctxt "NpcYell:16056:0:13"
msgid "What in the world is that floating chair?"
msgstr ""

#. ja: 研究者が何故ここに…？
#. de: Was macht einer ihrer Wissenschaftler hier<nbsp>...?
#. fr: Que font des chercheurs ici<nbsp>!?
msgctxt "NpcYell:16057:0:13"
msgid "What's a scientist doing here...?"
msgstr ""

#. ja: 研究者が何故ここに…？
#. de: Was macht einer ihrer Wissenschaftler hier<nbsp>...?
#. fr: Que font des chercheurs ici<nbsp>!?
msgctxt "NpcYell:16058:0:13"
msgid "What's a scientist doing here...?"
msgstr ""

#. ja: 策があるのかもしれません！<br>警戒を…！
#. de: Bleibt auf der Hut! Der hat irgendwas vor<nbsp>...
#. fr: Restez vigilants, il y a forcément un moyen d'en venir à bout<nbsp>!
msgctxt "NpcYell:16059:0:13"
msgid "I mislike the look of this... Have care!"
msgstr ""

#. ja: な、なんだったの…<br>あの妙な攻撃は…
#. de: W-Was genau ist da passiert<nbsp>...?!
#. fr: J'ai jamais vu des attaques pareilles...
msgctxt "NpcYell:16060:0:13"
msgid "Wh-What just happened...?"
msgstr ""

#. ja: 自分を見下ろすなど<br>ゾっとしない体験だ…
#. de: Auf meinen eigenen Leib zu blicken<nbsp>... Davon werde ich noch Albträume haben<nbsp>...
#. fr: Je ne referais pas cette expérience tous les jours...
msgctxt "NpcYell:16061:0:13"
msgid "To so gaze down on myself... A chilling experience..."
msgstr ""

#. ja: 自分を見下ろすなど<br>ゾっとしない体験だ…
#. de: Auf meinen eigenen Leib zu blicken<nbsp>... Davon werde ich noch Albträume haben<nbsp>...
#. fr: Je ne referais pas cette expérience tous les jours...
msgctxt "NpcYell:16062:0:13"
msgid "To so gaze down on myself... A chilling experience..."
msgstr ""

#. ja: あやうく肉体を<br>見失うところでした
#. de: Ich hätte meinen Körper um ein Haar nicht wiedergefunden.
#. fr: Cette impression de ne plus sentir son corps... Quel malaise<nbsp>!
msgctxt "NpcYell:16063:0:13"
msgid "Never imagined I'd miss my body so much..."
msgstr ""

#. ja: こんなフィールドで<br>アタシたちは止められないよ！
#. de: Als ob uns so eine mickrige Barriere aufhalten würde!
#. fr: Personne ne peut nous arrêter sur ce genre de terrain<nbsp>!
msgctxt "NpcYell:16064:0:13"
msgid "As if a little barrier like this can stop us!"
msgstr ""

#. ja: 突破口を開く！<br>全力で攻撃するのだ！
#. de: Gebt alles, was ihr habt! Wir brechen durch!
#. fr: C'est le moment de faire une percée<nbsp>! Tous à l'attaque<nbsp>!
msgctxt "NpcYell:16065:0:13"
msgid "We're breaking through! Onward!"
msgstr ""

#. ja: 遠距離からの攻撃ぐらいで<br>俺たちは止められない！
#. de: Sie wollen uns also aus sicherer Entfernung ausschalten? Als ob euch das helfen würde!
#. fr: Ils restent à distance pour nous empêcher de les atteindre<nbsp>!
msgctxt "NpcYell:16066:0:13"
msgid "A few spells from a distance won't stop us!"
msgstr ""

#. ja: 突破口を開く！<br>全力で攻撃するのだ！
#. de: Gebt alles, was ihr habt! Wir brechen durch!
#. fr: C'est le moment de faire une percée<nbsp>! Tous à l'attaque<nbsp>!
msgctxt "NpcYell:16067:0:13"
msgid "We're breaking through! Onward!"
msgstr ""

#. ja: やけに厳重な護りだな…
#. de: Eine Menge Wachen haben sie, das muss man ihnen lassen<nbsp>...
#. fr: Quelle défense de fer...
msgctxt "NpcYell:16068:0:13"
msgid "Stiff defense they've got here..."
msgstr ""

#. ja: この先に玉座があるはず！<br>ゼノスは、そこか…！？
#. de: Der Thronsaal ist gleich hier vorne! Und mit ihm auch Zenos<nbsp>...!
#. fr: La salle du trône est droit devant<nbsp>! Et à l'intérieur... Zenos<nbsp>!
msgctxt "NpcYell:16069:0:13"
msgid "The throne room is just ahead. And inside..."
msgstr ""

#. ja: やけに厳重な護りだな…
#. de: Eine Menge Wachen haben sie, das muss man ihnen lassen<nbsp>...
#. fr: Quelle défense de fer...
msgctxt "NpcYell:16070:0:13"
msgid "Stiff defense they've got here..."
msgstr ""

#. ja: 奥にあるのは鷲獅子の間…<br>王の謁見室だ
#. de: Die Halle des Greifen, der Audienzsaal des Königs, befindet sich hier<nbsp>...
#. fr: La salle du Griffon n'est plus très loin<nbsp>!
msgctxt "NpcYell:16071:0:13"
msgid "Not surprising─the throne room is just ahead."
msgstr ""

#. ja: 皇太子ゼノス！<br>今こそ決着をつけるんだ！
#. de: Prinz Zenos! Mach dich bereit auf dein Ende!
#. fr: Zenos<nbsp>! Prépare-toi à vivre tes derniers instants<nbsp>! Ala Mhigo sera bientôt libre<nbsp>!
msgctxt "NpcYell:16072:0:13"
msgid "Zenos! This time we settle this!"
msgstr ""

#. ja: いっくぜぇ！
#. de: Mit ganzer Kraft!
#. fr: C'est parti<nbsp>!
msgctxt "NpcYell:16073:0:13"
msgid "You're going down!"
msgstr ""

#. ja: そこにいたか、ゼノス…！
#. de: Endlich haben wir dich, Zenos<nbsp>...!
#. fr: Te voilà enfin, Zenos<nbsp>!
msgctxt "NpcYell:16074:0:13"
msgid "We have you at last, Zenos!"
msgstr ""

#. ja: 今こそ決着をつけるよ！<br>アラミゴを解放するんだ！
#. de: Der letzte Kampf beginnt hier! Wir werden Ala Mhigo befreien!
#. fr: Prépare-toi à vivre tes derniers instants<nbsp>! Ala Mhigo sera bientôt libre<nbsp>!
msgctxt "NpcYell:16075:0:13"
msgid "This time we settle this!"
msgstr ""

#. ja: パフィ～
#. de: Pwaaarrr!
#. fr: Piou<nbsp>!
msgctxt "NpcYell:16076:0:13"
msgid "Quaaawk!"
msgstr ""

#. ja: もさもさ…
#. de: \<schmatz><nbsp>...
#. fr: Groumph...
msgctxt "NpcYell:16077:0:13"
msgid "\\<smack> \\<slurp>"
msgstr ""

#. ja: べろべろ～り
#. de: \<schleck!>
#. fr: Bleeeh<nbsp>!
msgctxt "NpcYell:16078:0:13"
msgid "\\<slurp> \\<slurp>"
msgstr ""

#. ja: スチーム！
#. de: Puff!
#. fr: Tchouuu<nbsp>!
msgctxt "NpcYell:16079:0:13"
msgid "Pfff-hssssss!"
msgstr ""

#. ja: ゴゥン…
#. de: Gwuuun<nbsp>...
#. fr: Clonk...
msgctxt "NpcYell:16080:0:13"
msgid "\\<clank> \\<whirr>"
msgstr ""

#. ja: ウッキ～！
#. de: Uga uga!
#. fr: Ouh ouh<nbsp>!
msgctxt "NpcYell:16081:0:13"
msgid "Ook-ook!"
msgstr ""

#. ja: ３・２・１…
#. de: 3, 2, 1, <i>Bumm!</i>
#. fr: 3... 2... 1...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:16082:0:13"
msgid "Three, two, one...<i>kaboom</i>!"
msgstr ""

#. ja: ターッ！
#. de: Hyaaa!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:16083:0:13"
msgid "Hyaaah!"
msgstr ""

#. ja: ワッフワッフ
#. de: Wuff!
#. fr: Wouf<nbsp>! Wouf<nbsp>!
msgctxt "NpcYell:16084:0:13"
msgid "Woof, woof!"
msgstr ""

#. ja: モットヨク見セテ…！
#. de: Zeigt es mir!
#. fr: Montrez-moi l'éclat de votre âme<nbsp>!
msgctxt "NpcYell:16085:0:13"
msgid "Shine brilliant for me!"
msgstr ""

#. ja: ホラホラホラァッ！
#. de: Hrrraaaah!
#. fr: Vous m'échapperez pas, pauvres larves<nbsp>!
msgctxt "NpcYell:16086:0:13"
msgid "You can't escape the storm!"
msgstr ""

#. ja: ドグ～
#. de: Dguuu<nbsp>...
#. fr: Dogûûû...
msgctxt "NpcYell:16087:0:13"
msgid "\\<squint> \\<squint>"
msgstr ""

#. ja: クゥ～ン♪
#. de: Rrruff! ♪
#. fr: Wouuuf<nbsp>!♪
msgctxt "NpcYell:16088:0:13"
msgid "Arruff.♪"
msgstr ""

#. ja: オラが選ぶなら…
#. de: Welchen Pfad <i>ich</i> wählen würde? Hm<nbsp>...
#. fr: Si je devais choisir...
msgctxt "NpcYell:16090:0:13"
msgid "If it were up to me..."
msgstr ""

#. ja: この道だす！
#. de: Diesen hier vielleicht?
#. fr: Je prendrais ce chemin<nbsp>!
msgctxt "NpcYell:16091:0:13"
msgid "I'd take this path!"
msgstr ""

#. ja: 燃えてるやつがいるだす…
#. de: Sag mal<nbsp>... Ist das Feuer?
#. fr: Ouah<nbsp>! Un monstre qui brûle<nbsp>!
msgctxt "NpcYell:16092:0:13"
msgid "They're on fire!"
msgstr ""

#. ja: 凶暴そうな魚だす！
#. de: Das sind aber fiese Fische!
#. fr: Voilà des poissons qui m'ont l'air pas commodes<nbsp>!
msgctxt "NpcYell:16093:0:13"
msgid "I don't think my fishing hook will be of use here!"
msgstr ""

#. ja: さっきの魚<br>怖かっただす…
#. de: Die Fische von eben haben mir gar nicht gefallen<nbsp>...
#. fr: Cette poiscaille aux dents longues va hanter mes cauchemars...
msgctxt "NpcYell:16094:0:13"
msgid "I'd rather not do that again..."
msgstr ""

#. ja: ビリビリしそうなやつが<br>いるだす…
#. de: Oje, die sind<nbsp>... blitzig?
#. fr: Gardons nos distances, on risque de se prendre une décharge<nbsp>!
msgctxt "NpcYell:16095:0:13"
msgid "Get too close and you'll be in for a shock!"
msgstr ""

#. ja: 魔物にも天気の好みが<br>あったりするのかも…？
#. de: Ich frage mich, ob das am Wetter liegt.
#. fr: Je me demande... Tu crois que les monstres préfèrent le soleil ou la pluie<nbsp>?
msgctxt "NpcYell:16096:0:13"
msgid "Do you think some monsters prefer rainy days over sunny days?"
msgstr ""

#. ja: あわわ！<br>お、大きなハサミだす…！
#. de: Uah, d-das sind aber große Scheren!
#. fr: Ouh là... Ces grosses pinces ne sont pas rassurantes<nbsp>!
msgctxt "NpcYell:16097:0:13"
msgid "Those claws will cut us in two!"
msgstr ""

#. ja: あれだけ大きいカニなら<br>食べごたえがありそう…
#. de: Die Krabbe war gruselig, aber<nbsp>... Stell dir vor, wie viel Fleisch an ihr dran ist!
#. fr: Ce crabe était si énorme qu'il pourrait nourrir une famille entière<nbsp>!
msgctxt "NpcYell:16098:0:13"
msgid "A crab that big could feed a whole village..."
msgstr ""

#. ja: どうにかなって<br>よかっただす
#. de: Puh, das ging ja noch mal gut<nbsp>...
#. fr: Content qu'on s'en soit sortis indemnes...
msgctxt "NpcYell:16099:0:13"
msgid "I was a bit worried there...but that's behind us now."
msgstr ""

#. ja: また危ないのが<br>現れただす！
#. de: N-Noch mehr Beißer!
#. fr: Et encore une créature cauchemardesque<nbsp>!
msgctxt "NpcYell:16100:0:13"
msgid "More ill-tempered beasts!"
msgstr ""

#. ja: もう大丈夫そうだす…
#. de: Ist es vorbei?
#. fr: Ça va aller... Pas de panique...
msgctxt "NpcYell:16101:0:13"
msgid "We're alive... We're still alive."
msgstr ""

#. ja: また、やっかいそうなのが<br>飛んでるだす…！
#. de: <split " " 1><string $gs1></split>, wieso schweben diese Kalmare <i>an Land</i>?!
#. fr: Et encore des monstres...
msgctxt "NpcYell:16102:0:13"
msgid "It's always worse when they fly..."
msgstr ""

#. ja: しっしっ！<br>こっちくんな！
#. de: Weg! Bleibt weg!
#. fr: Bzzz<nbsp>! Bzzz<nbsp>! Allez, ouste<nbsp>!
msgctxt "NpcYell:16103:0:13"
msgid "Go away! Go away!"
msgstr ""

#. ja: 近づくなっての！
#. de: Ihr sollt wegbleiben, hab ich gesagt!
#. fr: Laissez-moi tranquille, bon sang<nbsp>!
msgctxt "NpcYell:16104:0:13"
msgid "I said GO AWAY!"
msgstr ""

#. ja: うわぁーっ！
#. de: Waaargh!
#. fr: Ouaaargh<nbsp>!
msgctxt "NpcYell:16105:0:13"
msgid "Gaaah!"
msgstr ""

#. ja: お前ら助けろよっ！<br>人の心ってもんがねぇのか！？
#. de: Los, helft mir! Habt ihr Herzen aus Stein?!
#. fr: Aidez-moi, triples buses<nbsp>! Vous allez pas me laisser en plan, non<nbsp>?
msgctxt "NpcYell:16106:0:13"
msgid "You just going to stand there!? Cold-blooded bastards!"
msgstr ""

#. ja: いきなり襲ってきたり<br>理不尽なヒトだす…
#. de: Der komische Kerl, der uns einfach angegriffen hat<nbsp>...
#. fr: Quel voyou ! Il n'a pas honte de nous avoir attaqués en traître<nbsp>?
msgctxt "NpcYell:16107:0:13"
msgid "Maybe he shouldn't have set that beast upon us..."
msgstr ""

#. ja: ここにも危ないのが<br>いるだすよ！
#. de: Du liebe Zeit, ist der riesig!
#. fr: En revoilà d'autres, attention<nbsp>!
msgctxt "NpcYell:16108:0:13"
msgid "There's danger around every bend!"
msgstr ""

#. ja: そんじゃ<br>あばよーっ！
#. de: Also dann - tata!
#. fr: Sur ce, j'me tire<nbsp>!
msgctxt "NpcYell:16109:0:13"
msgid "I'll be seeing you!"
msgstr ""

#. ja: なんだか<br>調子がいいヒトだす…
#. de: Na, der Schreck ist aber schnell verflogen.
#. fr: Il manque pas de toupet, lui<nbsp>!
msgctxt "NpcYell:16110:0:13"
msgid "Not even a word of thanks."
msgstr ""

#. ja: ここにも危ないのが<br>いるだすよ！
#. de: Du liebe Zeit, ist der riesig!
#. fr: Et allez... Ça sent encore le danger ici<nbsp>!
msgctxt "NpcYell:16111:0:13"
msgid "They don't look very friendly!"
msgstr ""

#. ja: 魚がいそうな<br>気配がするだす…！
#. de: Dieses Rüsselkribbeln<nbsp>...
#. fr: Oh<nbsp>! Il y a des poissons dans les parages, mon intuition ne me trompe jamais.
msgctxt "NpcYell:16112:0:13"
msgid "Fish are close, I know it!"
msgstr ""

#. ja: 釣りは根気だす！
#. de: Geduld ist die oberste Tugend eines Fischers!
#. fr: La pêche c'est avant tout une question de patience<nbsp>!
msgctxt "NpcYell:16113:0:13"
msgid "To the patient go the fish!"
msgstr ""

#. ja: お、おおっ！？<br>大物がかかっただす！
#. de: D-Du liebe Güte, der ist <i>gewaltig</i>!
#. fr: Oh<nbsp>? Ho ho<nbsp>! En voilà une sacrée prise<nbsp>!
msgctxt "NpcYell:16114:0:13"
msgid "Oh, what's this? Such a strong bite!"
msgstr ""

#. ja: 釣りは根気だす！
#. de: Geduld ist die oberste Tugend eines Fischers!
#. fr: La pêche c'est avant tout une question de patience<nbsp>!
msgctxt "NpcYell:16115:0:13"
msgid "To the patient go the fish!"
msgstr ""

#. ja: お、おおっ！？<br>大物がかかっただす！
#. de: D-Du liebe Güte, der ist <i>gewaltig</i>!
#. fr: Oh<nbsp>? Ho ho<nbsp>! En voilà une sacrée prise<nbsp>!
msgctxt "NpcYell:16116:0:13"
msgid "Oh, what's this? Such a strong bite!"
msgstr ""

#. ja: 迷惑をかけただす…
#. de: Entschuldige, damit hab ich nicht gerechnet<nbsp>...
#. fr: Désolé de t'embêter avec ça...
msgctxt "NpcYell:16117:0:13"
msgid "Sorry for wasting your time..."
msgstr ""

#. ja: あぁ…<br>びっくりしただす
#. de: Uah, bei den Mrga!
#. fr: Ouah<nbsp>! J'ai eu une de ces trouilles<nbsp>!
msgctxt "NpcYell:16118:0:13"
msgid "More of them..."
msgstr ""

#. ja: あっ！<br>魚がかかっただす！
#. de: Ha, da hat einer angebissen!
#. fr: Oh<nbsp>! Ça mord<nbsp>!
msgctxt "NpcYell:16119:0:13"
msgid "Yes! I've hooked something!"
msgstr ""

#. ja: 引きは弱いけど<br>かかっただす！
#. de: Stark zieht er ja nicht, aber besser als nichts!
#. fr: Ce n'est sûrement pas une grosse prise, mais c'est déjà ça de gagné<nbsp>!
msgctxt "NpcYell:16120:0:13"
msgid "It's weak, but a bite is a bite!"
msgstr ""

#. ja: おおっ！<br>この強い引きは…！
#. de: Puh, der kämpft ordentlich gegen mich an!
#. fr: Oooh<nbsp>! Ça tire fort à l'autre bout<nbsp>!
msgctxt "NpcYell:16121:0:13"
msgid "Oh my! This one's quite strong!"
msgstr ""

#. ja: す、すごい引き…！<br>負けないだす…！
#. de: Ah, ich kann die Angel kaum halten!
#. fr: Argh... Ma ligne risque de lâcher. Quel sacré bestiau<nbsp>!
msgctxt "NpcYell:16122:0:13"
msgid "Someone's a fighter! But I won't let you get away!"
msgstr ""

#. ja: ああ<br>不気味だっただす…！
#. de: Ich bibbere immer noch<nbsp>...
#. fr: Brrr... J'en ai la chair de poule.
msgctxt "NpcYell:16123:0:13"
msgid "Those things sent a chill down my spine."
msgstr ""

#. ja: 大きなカエル…！<br>丸呑みにされたら大変だす！
#. de: Uah, die Kröte frisst uns zum Frühstück, wenn wir nicht aufpassen!
#. fr: Un crapaud géant... Pas question de finir dans son estomac<nbsp>!
msgctxt "NpcYell:16124:0:13"
msgid "A toad that big could swallow us whole!"
msgstr ""

#. ja: 呑み込まれなくて<br>よかっただす…
#. de: Niemand wurde gefressen. Gut.
#. fr: Pas mécontent de lui avoir échappé<nbsp>!
msgctxt "NpcYell:16125:0:13"
msgid "I'm glad we didn't end up as its dinner..."
msgstr ""

#. ja: あれはもしかして<br>ヒト喰い植物だすか！？
#. de: Oje oje, bestimmt sind hier überall fleischfressende Pflanzen!
#. fr: Cette chose, c'est... une plante carnivore<nbsp>?
msgctxt "NpcYell:16126:0:13"
msgid "Is that...a plant!? It's enormous!"
msgstr ""

#. ja: あんたが喰われなくて<br>ホッとしただす…
#. de: Bitte lass dich nicht fressen, ja?
#. fr: Quel soulagement<nbsp>! J'ai eu peur que tu finisses digéré<if $gn4>e</if> par cette créature<nbsp>!
msgctxt "NpcYell:16127:0:13"
msgid "I was afraid you'd be eaten alive!"
msgstr ""

#. ja: うぅっ…<br>肌がピリピリするだす…
#. de: Auauau! Das piekst und brennt!
#. fr: Urgh... J'ai les poils qui se hérissent le long de mes bras...
msgctxt "NpcYell:16128:0:13"
msgid "Ugh... The hairs on my skin are standing on end."
msgstr ""

#. ja: またイモムシが<br>たくさんいるだす！
#. de: Wieso gibt es denn so viele Raupen hier?
#. fr: Des chenilles<nbsp>! Tout partout<nbsp>!
msgctxt "NpcYell:16129:0:13"
msgid "Are those...caterpillars!?"
msgstr ""

#. ja: あれ…？<br>岩の塊が動いてる…？
#. de: Hm? Hat sich der Stein gerade bewegt?
#. fr: Euh...<nbsp>? C'est moi ou je viens de voir des rochers qui marchent<nbsp>?
msgctxt "NpcYell:16130:0:13"
msgid "Those rocks...they're moving!"
msgstr ""

#. ja: 岩の塊が動くなんて<br>不思議な島だす
#. de: Diese Insel wird mit jedem Schritt seltsamer, ehrlich<nbsp>...
#. fr: Cette île regorge vraiment de mystères...
msgctxt "NpcYell:16131:0:13"
msgid "What other surprises does this island have in store?"
msgstr ""

#. ja: あの立派な鳥<br>ものすごく獰猛そうだす！
#. de: Dieser riesen Flatterer sieht unangenehm hungrig aus!
#. fr: Quel magnifique oiseau... Dommage qu'il ait l'air si peu commode<nbsp>!
msgctxt "NpcYell:16132:0:13"
msgid "What a majestic bird...but that beak looks sharp as a sword!"
msgstr ""

#. ja: わっ！<br>樹の枝が伸びただす！
#. de: Schau nur, die Äste!
#. fr: Ouah<nbsp>! La branche vient de s'allonger<nbsp>!
msgctxt "NpcYell:16133:0:13"
msgid "The branches grew!"
msgstr ""

#. ja: こんな大きなコウモリ<br>見たことないだす！
#. de: Ah, Fledermäuse! Wieso sind denn auch die so groß?!
#. fr: Je n'ai jamais vu de chauve-souris aussi grande<nbsp>!
msgctxt "NpcYell:16134:0:13"
msgid "I've never seen a bat so large!"
msgstr ""

#. ja: サベネア島のコウモリは<br>もっと小さいのに…
#. de: In Thavnair sind die Kollegen deutlich kleiner.
#. fr: Celles de Thavnair sont bien plus petites...
msgctxt "NpcYell:16135:0:13"
msgid "The bats in Thavnair are not nearly as big...or ferocious."
msgstr ""

#. ja: あの木像は何だす…？
#. de: Holzstatuen<nbsp>...
#. fr: Qu'est-ce donc<nbsp>? Des statues en bois...<nbsp>?
msgctxt "NpcYell:16136:0:13"
msgid "What are these?"
msgstr ""

#. ja: わっ、見つかっちゃった！<br>降参、降参～！
#. de: Aah, ich gebe auf! Ich gebe auf!
#. fr: Ouah<nbsp>! On est repérés<nbsp>! On se rend<nbsp>! Promis<nbsp>!
msgctxt "NpcYell:16137:0:13"
msgid "Uwah! How did you─ Leave me alone!"
msgstr ""

#. ja: あの木像<br>急に動いたりしなくてよかった…
#. de: Ich bin froh, dass diese Holzstatuen stillgehalten haben<nbsp>...
#. fr: Pfiou... Heu<shy>reu<shy>se<shy>ment que ces statues-là ne se sont pas mises à bouger...
msgctxt "NpcYell:16138:0:13"
msgid "Finally, statues that stay where they are."
msgstr ""

#. ja: 怖いけど<br>ニッダーナさんのために…！
#. de: Los, Matsya<nbsp>... Denk an Nidhana!
#. fr: Cet endroit me file la chair de poule. Mais si c'est pour Nidhana, alors...
msgctxt "NpcYell:16139:0:13"
msgid "May thoughts of Nidhana give me courage!"
msgstr ""

#. ja: あ、足が<br>じーんってしてるだす…
#. de: Autsch, ich hab mir den Zeh gestoßen!
#. fr: Aïe<nbsp>! Je me suis cogné le pied<nbsp>!
msgctxt "NpcYell:16140:0:13"
msgid "Ow! I stubbed my toe!"
msgstr ""

#. ja: あっ！<br>何かかかっただす！
#. de: Ah, etwas hat angebissen!
#. fr: Oh<nbsp>! Ça mord<nbsp>!
msgctxt "NpcYell:16141:0:13"
msgid "Oh! I got a bite!"
msgstr ""

#. ja: かかった…！<br>大きい当たりだす！
#. de: Oho, das ist ein Großer!
#. fr: Oh oui, ça mord bien<nbsp>! Une sacrée prise, même<nbsp>!
msgctxt "NpcYell:16142:0:13"
msgid "Huzzah! A catch worth celebrating!"
msgstr ""

#. ja: 迷惑なヒトだす…
#. de: Musste das sein?
#. fr: Qu'ils sont pénibles...
msgctxt "NpcYell:16143:0:13"
msgid "How annoying..."
msgstr ""

#. ja: 怖いけど<br>ニッダーナさんのために…！
#. de: Los, Matsya<nbsp>... Denk an Nidhana!
#. fr: Cet endroit me file la chair de poule. Mais si c'est pour Nidhana, alors...
msgctxt "NpcYell:16144:0:13"
msgid "May thoughts of Nidhana give me courage!"
msgstr ""

#. ja: ハァハァ…<br>寿命が縮んだだす…
#. de: Puh<nbsp>... Ich sah schon das Licht am Ende des Tunnels.
#. fr: Hah... Hah... J'ai l'impression d'avoir pris dix ans d'un coup<nbsp>!
msgctxt "NpcYell:16145:0:13"
msgid "\\<heavy breathing> I think that shaved a few summers off my life."
msgstr ""

#. ja: おっとと！<br>すごい引きだす！
#. de: Oha, das ist ein Kaventsmann!
#. fr: Oh là<nbsp>! On ne se laisse pas pêcher facilement, dis donc<nbsp>!
msgctxt "NpcYell:16146:0:13"
msgid "Oh ho! I've hooked something big!"
msgstr ""

#. ja: うわ、大物だす！<br>お、重い…
#. de: Verrückt, wie schwer er ist!
#. fr: Ouah<nbsp>! Comme c'est lourd<nbsp>! J'ai touché le gros lot<nbsp>!
msgctxt "NpcYell:16147:0:13"
msgid "It's large, and it's heavy!"
msgstr ""

#. ja: この島にも<br>ハンサがいるだす！
#. de: Hier gibt es also auch Hamsas!
#. fr: Tiens<nbsp>! On trouve des hamsa ici aussi<nbsp>?
msgctxt "NpcYell:16148:0:13"
msgid "Hamsa! They really are everywhere."
msgstr ""

#. ja: 野生のハンサは<br>凶暴だす…
#. de: Ganz schön bissig, die Kollegen.
#. fr: Attention, ces bêtes n'avaient pas l'air commodes...
msgctxt "NpcYell:16149:0:13"
msgid "I've had my fill of wild animals already..."
msgstr ""

#. ja: コ、ココヤシの木が<br>動いてるだす…！
#. de: D-Diese Kokospalme ist ja gigantisch!
#. fr: Le cocotier... Il bouge<nbsp>!
msgctxt "NpcYell:16150:0:13"
msgid "The tree moves!"
msgstr ""

#. ja: 実ってたココナッツ<br>かなり大きかっただす
#. de: So große Kokosnüsse habe ich selten gesehen.
#. fr: J'espère que tous les fruits du coin ne sont pas aussi terrifiants<nbsp>!
msgctxt "NpcYell:16151:0:13"
msgid "I didn't know coconuts could grow to such sizes."
msgstr ""

#. ja: アシュヴァッタもいるなんて<br>サベネア島みたいだす！
#. de: Ein Asvattha! Ganz wie auf Thavnair!
#. fr: Oh<nbsp>! Un asvattha<nbsp>! On se croirait vraiment à Thavnair.
msgctxt "NpcYell:16152:0:13"
msgid "Look, an asvattha! Just as horrifying here as they are in Thavnair."
msgstr ""

#. ja: あのアシュヴァッタ<br>酷い悪臭だっただす…
#. de: Bah, an den Geruch gewöhnt man sich nie<nbsp>...
#. fr: Enfin... les asvattha d'ici sentent bien plus mauvais<nbsp>!
msgctxt "NpcYell:16153:0:13"
msgid "No, even more horrifying...the asvattha here smell much worse."
msgstr ""

#. ja: うーん<br>いい漁場はないかな…
#. de: Hier muss es doch irgendwo einen guten Angelplatz geben.
#. fr: Voyons... Y a-t-il un bon endroit pour pêcher ici<nbsp>?
msgctxt "NpcYell:16154:0:13"
msgid "Let's see. Any fishing spots to be found?"
msgstr ""

#. ja: ここで<br>行き止まりだす…
#. de: Hier ist wohl Schluss.
#. fr: C'est un cul-de-sac<nbsp>!
msgctxt "NpcYell:16155:0:13"
msgid "It's a dead end."
msgstr ""

#. ja: 誰だすか！？<br>ええと、どうしたら…
#. de: Wer ist da?! Oje, was sollen wir nur machen?
#. fr: Qui va là<nbsp>? Euh... Que faire<nbsp>?
msgctxt "NpcYell:16156:0:13"
msgid "Who's that!? Or...what's that?"
msgstr ""

#. ja: ちょっと不安だけど<br>進んでみるだす
#. de: Ganz wohl ist mir nicht, aber wir sollten weiter.
#. fr: J'suis pas rassuré, mais il faut bien avancer...
msgctxt "NpcYell:16157:0:13"
msgid "My legs don't want to move forward, but I must."
msgstr ""

#. ja: わっ！<br>トカゲの群れだす！
#. de: Ah! Eidechsen!
#. fr: Ouah<nbsp>! Une meute de raptors<nbsp>!
msgctxt "NpcYell:16158:0:13"
msgid "We've walked into a lizard den!"
msgstr ""

#. ja: ここから<br>奥へ進めそうだす
#. de: Von hier scheint es weiterzugehen.
#. fr: On peut accéder au fond d'ici.
msgctxt "NpcYell:16159:0:13"
msgid "We can go further in from here."
msgstr ""

#. ja: ひどい…！<br>騙されただす！
#. de: Wie gemein, sie hat uns reingelegt!
#. fr: Oh non<nbsp>! Elle nous a piégés<nbsp>!
msgctxt "NpcYell:16160:0:13"
msgid "I knew it─a trick!"
msgstr ""

#. ja: 急に怒り出して<br>どうしちゃっただす…？
#. de: Wieso ist sie plötzlich so zornig?
#. fr: Pourquoi tant de haine<nbsp>? C'est de ma faute<nbsp>?
msgctxt "NpcYell:16161:0:13"
msgid "Why did she get so angry? Was it something I said?"
msgstr ""

#. ja: あの妖精さん<br>いじわるだす…！
#. de: Diese Fee führt uns am Rüssel herum!
#. fr: Cette fée est trop espiègle pour son bien<nbsp>!
msgctxt "NpcYell:16162:0:13"
msgid "This is no way to treat visitors!"
msgstr ""

#. ja: あわわわわ…！<br>ダイルの群れだす！
#. de: Aaaah, ein Gatorschwarm!
#. fr: Ouh là là là<nbsp>! Attention aux crocos<nbsp>!
msgctxt "NpcYell:16163:0:13"
msgid "Crocs! Keep your distance!"
msgstr ""

#. ja: あの妖精さん<br>どこいっただすか…？
#. de: Wo ist diese Fee nur hin?
#. fr: Où est passée la fée<nbsp>?
msgctxt "NpcYell:16164:0:13"
msgid "Where did that faerie fly off to?"
msgstr ""

#. ja: 灰色のおっきいのが<br>いるだす！
#. de: Pass auf den großen Grauen auf!
#. fr: C'est quoi cet énorme machin gris<nbsp>?
msgctxt "NpcYell:16165:0:13"
msgid "Look at the size of that thing!"
msgstr ""

#. ja: どこか<br>進めそうな道は…
#. de: Irgendwo muss doch ein Weg sein<nbsp>...
#. fr: Il doit bien y avoir un chemin quelque part...
msgctxt "NpcYell:16166:0:13"
msgid "There has to be a path somewhere..."
msgstr ""

#. ja: うわっ！<br>ボアがいっぱいだす！
#. de: So viele Wildschweine!
#. fr: Ouah<nbsp>! Des sangliers tout partout<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:16167:0:13"
msgid "<split \" \" 1><string $gs1></split>, boars! A lot of them!"
msgstr ""

#. ja: 道はまだ<br>続いてるみたいだす…
#. de: Da, es geht noch weiter.
#. fr: On en voit pas le bout<nbsp>!
msgctxt "NpcYell:16168:0:13"
msgid "How deep does this path go?"
msgstr ""

#. ja: こんなところに<br>宝箱…？
#. de: Schatzkisten? <i>Hier?</i>
#. fr: Des coffres au trésor... dans un endroit pareil<nbsp>?
msgctxt "NpcYell:16169:0:13"
msgid "Treasure chests? In a place like this?"
msgstr ""

#. ja: なんだか<br>不思議な雰囲気だす…
#. de: Hier ist es so<nbsp>... erhaben.
#. fr: Hmmm... C'est trop louche.
msgctxt "NpcYell:16170:0:13"
msgid "Something's not right..."
msgstr ""

#. ja: 行き止まりだす<br>何か進む方法は…
#. de: Eine Sackgasse ...
#. fr: On ne peut pas aller plus loin. Il va falloir trouver un autre chemin.
msgctxt "NpcYell:16171:0:13"
msgid "We can't go any further. We'll have to find another way."
msgstr ""

#. ja: 宝箱が生きてる…！？
#. de: D-Die sind ja lebendig!
#. fr: Les coffres se sont mis à bouger<nbsp>!?
msgctxt "NpcYell:16172:0:13"
msgid "They're alive!"
msgstr ""

#. ja: はぁ…<br>このお宝を回収して戻ろう…
#. de: Ach ... Holen wir diesen Schatz und gehen nach Hause.
#. fr: Hah... Vite, embarquons le coffre et mettons les voiles<nbsp>!
msgctxt "NpcYell:16173:0:13"
msgid "That was too close for comfort... Grab the treasure so we can get out of here."
msgstr ""

#. ja: …って、ミミック！？<br>どど、どうしよう！
#. de: Mi-Mimiks?! Was jetzt?!
#. fr: C-c-catastrophe<nbsp>! Un mimic<nbsp>! Qu'est-ce qu'on fait<nbsp>?
msgctxt "NpcYell:16174:0:13"
msgid "Th-These aren't treasure chests! What do we do!?"
msgstr ""

#. ja: また危なそうなのが！<br>あんたが頼りだす…！
#. de: Oje, noch mehr Gefahr! <split " " 1><string $gs1></split>, Hilfe!
#. fr: Tout ça m'a l'air bien dangereux. Je compte sur toi, <split " " 1><string $gs1></split><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:16175:0:13"
msgid "This doesn't look good... I'll leave it to you, <split \" \" 1><string $gs1></split>!"
msgstr ""

#. ja: また危なそうなのが！<br>あんたが頼りだす…！
#. de: Oje, noch mehr Gefahr! <split " " 1><string $gs1></split>, Hilfe!
#. fr: Tout ça m'a l'air bien dangereux. Je compte sur toi, <split " " 1><string $gs1></split><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:16176:0:13"
msgid "This doesn't look good... I'll leave it to you, <split \" \" 1><string $gs1></split>!"
msgstr ""

#. ja: 霧が濃くて<br>先が見えないだす…
#. de: Der Nebel ist so dicht, ich kann nichts sehen.
#. fr: Le brouillard est tellement épais que je ne vois même plus ma trompe<nbsp>!
msgctxt "NpcYell:16177:0:13"
msgid "The mist is so thick I can barely see my own trunk..."
msgstr ""

#. ja: 霧が濃くて<br>先が見えないだす…
#. de: Der Nebel ist so dicht, ich kann nichts sehen.
#. fr: Le brouillard est tellement épais que je ne vois même plus ma trompe<nbsp>!
msgctxt "NpcYell:16178:0:13"
msgid "The mist is so thick I can barely see my own trunk..."
msgstr ""

#. ja: オラたち<br>ちゃんと進めてるだすか…？
#. de: Kommen wir überhaupt voran?
#. fr: Tu crois qu'on avance vraiment<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:16179:0:13"
msgid "We <i>are</i> going forward, right?"
msgstr ""

#. ja: 手ごたえありだす！<br>何が釣れるかな…
#. de: Langsam gefällt es mir hier! Was ich wohl fangen werde?
#. fr: Voilà une prise qui a du mordant<nbsp>! Je me demande ce que c'est...
msgctxt "NpcYell:16180:0:13"
msgid "A bite, and a strong one at that! I wonder what it is..."
msgstr ""

#. ja: むむ…<br>妙な引きだす！
#. de: Hm? Ein merkwürdiger Fang.
#. fr: Hmmm... Étrange...
msgctxt "NpcYell:16181:0:13"
msgid "Hmm... That's quite the pull."
msgstr ""

#. ja: おお…！？<br>これはアタリの予感…！
#. de: Oho, da beißt etwas!
#. fr: Oh<nbsp>? J'ai l'impression de tenir le bon bout<nbsp>!
msgctxt "NpcYell:16182:0:13"
msgid "Oh!? This might be the big one!"
msgstr ""

#. ja: 反応はあるけど<br>なかなか食いつかないだす…
#. de: Ich glaube, da knabbert jemand<nbsp>...
#. fr: Je sens que ça mordille, mais ils se méfient de l'appât...
msgctxt "NpcYell:16183:0:13"
msgid "They want the bait, but not enough to bite down hard..."
msgstr ""

#. ja: わっ、うわっ！<br>す、すごい強烈な引き…！
#. de: Uah! Ah! Wie heftig zieht <i>der</i> denn?!
#. fr: Oooh<nbsp>! Quelle force<nbsp>! De quoi mettre mes biscotos à l'épreuve<nbsp>!
msgctxt "NpcYell:16184:0:13"
msgid "Oh, this is it! Sisters give me strength!"
msgstr ""

#. ja: 戦闘は任せた
#. de: Das Kämpfen überlasse ich euch.
#. fr: Je vous laisse gérer les combats.
msgctxt "NpcYell:16185:0:13"
msgid "I'll leave the fighting to you."
msgstr ""

#. ja: 見事なもんだ
#. de: Fürwahr, äußerst beeindruckend.
#. fr: Belle performance.
msgctxt "NpcYell:16186:0:13"
msgid "Well struck!"
msgstr ""

#. ja: よし、先へ進もう
#. de: Dann wollen wir mal weiter.
#. fr: Allez, on continue.
msgctxt "NpcYell:16187:0:13"
msgid "All right. Let's keep moving."
msgstr ""

#. ja: さあ、はやく行こうぜ！
#. de: Na los, gleich weiter!
#. fr: Pas le temps de niaiser ! En avant !
msgctxt "NpcYell:16188:0:13"
msgid "Let's go!"
msgstr ""

#. ja: た、助けて…！
#. de: H-Hilfe<nbsp>...!
#. fr: A-au secours... !
msgctxt "NpcYell:16189:0:13"
msgid "Someone help!"
msgstr ""

#. ja: ひえぇぇ…！
#. de: Uwaaah!
#. fr: Oh non non non...
msgctxt "NpcYell:16190:0:13"
msgid "Aaahhh!"
msgstr ""

#. ja: この島で<br>何が起きている…？
#. de: Was geht auf dieser Insel nur vor sich<nbsp>...?
#. fr: Mais qu'est-ce qu'il se passe sur cette île... ?
msgctxt "NpcYell:16191:0:13"
msgid "What has happened to this island?"
msgstr ""

#. ja: やむを得ない<br>撃退してくれ
#. de: Wir haben keine andere Wahl. Kümmert euch bitte um sie.
#. fr: Tss... Pas le choix. Occupez-vous d'eux.
msgctxt "NpcYell:16192:0:13"
msgid "They leave us no choice..."
msgstr ""

#. ja: 大丈夫か？
#. de: Hast du dich verletzt?
#. fr: Rien de cassé ?
msgctxt "NpcYell:16193:0:13"
msgid "Are you all right?"
msgstr ""

#. ja: ありがとう<br>平気だよ
#. de: Keine Sorge, mir geht's bestens!
#. fr: Non, ça va, merci.
msgctxt "NpcYell:16194:0:13"
msgid "Yes, thanks to you."
msgstr ""

#. ja: よし、直った！<br>これで向こうに渡れるぞ
#. de: Und fertig! Jetzt können wir wieder auf die andere Seite.
#. fr: C'est bon ! Vous pouvez traverser, maintenant.
msgctxt "NpcYell:16195:0:13"
msgid "There. It should be safe to cross now."
msgstr ""

#. ja: ぶっとばしてやる！
#. de: Und weg mit dir!
#. fr: J'vais t'écrabouiller<nbsp>!
msgctxt "NpcYell:16196:0:13"
msgid "Hold still!"
msgstr ""

#. ja: ひとりで突っ走るなよ
#. de: Stürm nicht einfach alleine los!
#. fr: Ne fonce pas devant toute seule.
msgctxt "NpcYell:16197:0:13"
msgid "No running off!"
msgstr ""

#. ja: 気をつけろ
#. de: Passt auf.
#. fr: Restez sur vos gardes.
msgctxt "NpcYell:16198:0:13"
msgid "Careful!"
msgstr ""

#. ja: おおりゃああああ！
#. de: Uraaaah!
#. fr: Raaaaah<nbsp>!
msgctxt "NpcYell:16199:0:13"
msgid "Yaaaaaargh!"
msgstr ""

#. ja: 間一髪だ…！
#. de: Das war mehr als knapp!
#. fr: C'était moins une...<nbsp>!
msgctxt "NpcYell:16200:0:13"
msgid "That was too close..."
msgstr ""

#. ja: おいおい頼むぜ！
#. de: Komm schon, streng dich an!
#. fr: Hé, c'est pas le moment de flancher<nbsp>!
msgctxt "NpcYell:16201:0:13"
msgid "Steady now."
msgstr ""

#. ja: イテッ！？
#. de: Autsch!
#. fr: Aïeuh<nbsp>!
msgctxt "NpcYell:16202:0:13"
msgid "Dammit!"
msgstr ""

#. ja: やりやがったな！
#. de: Jetzt bist du fällig!
#. fr: Ça, tu vas me le payer<nbsp>!
msgctxt "NpcYell:16203:0:13"
msgid "You'll pay for that!"
msgstr ""

#. ja: 助かったぜ…！
#. de: Ich schulde dir was<nbsp>...
#. fr: Merci du coup de main<nbsp>!
msgctxt "NpcYell:16204:0:13"
msgid "Thank you."
msgstr ""

#. ja: 走れ！
#. de: Lauft!
#. fr: Courrrez<nbsp>!
msgctxt "NpcYell:16205:0:13"
msgid "Look out!"
msgstr ""

#. ja: くらいやがれッ！
#. de: Wie gefällt dir das?!
#. fr: Bouffe un peu ça<nbsp>!
msgctxt "NpcYell:16206:0:13"
msgid "Try this!"
msgstr ""

#. ja: これぐらい<br>朝飯前だ！
#. de: Ha! Kinderspiel!
#. fr: Des comme ça, j'en mange tous les jours au p'tit-déj'<nbsp>!
msgctxt "NpcYell:16207:0:13"
msgid "Nothing to it."
msgstr ""

#. ja: 一気に畳みかけるぞ！
#. de: Bringen wir die Sache zu Ende!
#. fr: Finissons-en une bonne fois pourrr toutes<nbsp>!
msgctxt "NpcYell:16208:0:13"
msgid "Throw everything you have at it!"
msgstr ""

#. ja: すごい威力だったな！
#. de: Was für eine Wucht!
#. fr: Quelle forrrce !
msgctxt "NpcYell:16209:0:13"
msgid "Impressive."
msgstr ""

#. ja: これって…
#. de: Was ist das<nbsp>...?
#. fr: Mais c'est...
msgctxt "NpcYell:16210:0:13"
msgid "What have we here?"
msgstr ""

#. ja: どういう魔物なんだろうか
#. de: Was für ein Wesen könnte das nur sein?
#. fr: Quel genrrre de monstre ça peut être ?
msgctxt "NpcYell:16211:0:13"
msgid "What manner of beast could it be?"
msgstr ""

#. ja: 相手はかなり大きそうだ
#. de: Unser Freund scheint auf jeden Fall recht groß zu sein.
#. fr: Son agresseur devait être bien grrros...
msgctxt "NpcYell:16212:0:13"
msgid "How large do you suppose it is?"
msgstr ""

#. ja: なにか見つけたか？
#. de: Hast du etwas gefunden?
#. fr: 0
msgctxt "NpcYell:16213:0:13"
msgid "0"
msgstr ""

#. ja: 一度相談してみよう
#. de: Lass uns das kurz besprechen.
#. fr: Il vaut mieux s'arrêter un moment pour fairrre le point.
msgctxt "NpcYell:16214:0:13"
msgid "Even so, we should speak with the researchers first."
msgstr ""

#. ja: おーい、痕跡～<br>どこだー？
#. de: Hallo～, Spu～ren! Wo seit～ ihr?
#. fr: 0
msgctxt "NpcYell:16215:0:13"
msgid "0"
msgstr ""

#. ja: 相手にとって不足なし<br>…ってところだな
#. de: Es ist für ihn also kein Nachteil<nbsp>...
#. fr: 0
msgctxt "NpcYell:16216:0:13"
msgid "0"
msgstr ""

#. ja: 爪なんて<br>珍しくねぇしなぁ…
#. de: Krallen sieht man auf der Jagd immerhin nicht selten.
#. fr: Des animaux à griffes, il y en a un paquet... On n'est pas très avancés.
msgctxt "NpcYell:16217:0:13"
msgid "Such marks would be too common in any case."
msgstr ""

#. ja: 羽があるってことは…
#. de: Wenn es also Federn besitzt, dann<nbsp>...
#. fr: S'il y a des plumes, ça ne veut dire qu'une chose...
msgctxt "NpcYell:16218:0:13"
msgid "The beast has feathers, eh?"
msgstr ""

#. ja: 見たことない植物ばっかりだ
#. de: So viele unbekannte Pflanzen an einem Ort<nbsp>...
#. fr: Je n'ai jamais vu ce genre de plantes.
msgctxt "NpcYell:16219:0:13"
msgid "So many strange plants you have here."
msgstr ""

#. ja: この匂い、もしかしてよ…
#. de: Dieser Geruch<nbsp>... Ist das vielleicht<nbsp>...
#. fr: Pouah, ça fouette ! Me dites pas que...
msgctxt "NpcYell:16220:0:13"
msgid "Ugh, that smell..."
msgstr ""

#. ja: 魔物はこの近くに…？
#. de: Ist es etwa noch in der Nähe<nbsp>...?
#. fr: La créature se trouve encore dans le coin... ?
msgctxt "NpcYell:16221:0:13"
msgid "You said the beast is close?"
msgstr ""

#. ja: 縄張り争いだろうか
#. de: Hier hat wohl ein Revierkampf stattgefunden.
#. fr: Peut-être qu'ils se battent pour leur territoire ?
msgctxt "NpcYell:16222:0:13"
msgid "Struck down defending its territory, most like."
msgstr ""

#. ja: 被害が広がる前に<br>見つけないとな
#. de: Wir müssen es schnell finden, bevor es noch mehr Unheil anrichtet.
#. fr: Dépêchons-nous de le retrouver avant qu'il ne cause plus de dégâts.
msgctxt "NpcYell:16223:0:13"
msgid "We mustn't let any more creatures come to harm."
msgstr ""

#. ja: それらしい足跡はないな…
#. de: Keinerlei passende Spuren<nbsp>...
#. fr: Aucune trace de pas qui lui corresponde...
msgctxt "NpcYell:16224:0:13"
msgid "I see no tracks that match those claw marks..."
msgstr ""

#. ja: これは…？
#. de: Was haben wir denn hier<nbsp>...?
#. fr: Et ça, c'est quoi... ?
msgctxt "NpcYell:16225:0:13"
msgid "What's this?"
msgstr ""

#. ja: ほかに痕跡は…
#. de: Irgendwelche anderen Spuren<nbsp>...
#. fr: Il devrait y avoir d'autres indices par ici...
msgctxt "NpcYell:16226:0:13"
msgid "There has to be a clue here somewhere..."
msgstr ""

#. ja: さすがに、依頼なしで<br>採集するわけにもいかないか
#. de: Sie ohne Genehmigung zu pflücken würde wohl zu weit gehen, was?
#. fr: Sans requête officielle, je ne peux pas vraiment me permettre de les récolter... Dommage.
msgctxt "NpcYell:16227:0:13"
msgid "Focus. We've no time for picking flowers."
msgstr ""

#. ja: 誰もいないはずの島に<br>ルガディン族のヒトが…
#. de: Ein Roegadyn, obwohl hier niemand leben sollte<nbsp>...
#. fr: Tiens, un Roegadyn<nbsp>!? Je croyais que l'île était abandonnée...
msgctxt "NpcYell:16228:0:13"
msgid "A Roegadyn? I thought this island was deserted?"
msgstr ""

#. ja: わあっ！<br>凶暴な宝箱だす！
#. de: Was für bissige Truhen!
#. fr: Argh<nbsp>! Des coffres au trésor sauvages<nbsp>!
msgctxt "NpcYell:16229:0:13"
msgid "Uwah! Stay away from me!"
msgstr ""

#. ja: も、もう一息だす…
#. de: Puh, ich bin furchtbar außer Atem<nbsp>...
#. fr: Haaah... Pouce... Laisse-moi respirer<nbsp>!
msgctxt "NpcYell:16230:0:13"
msgid "I need...I need a moment to catch my breath."
msgstr ""

#. ja: ニッダーナさんに<br>喜んでもらいたいだす…！
#. de: Damit sich Nidhana freut!
#. fr: J'espère que ça plaira à Nidhana...
msgctxt "NpcYell:16231:0:13"
msgid "For Nidhana!"
msgstr ""

#. ja: うーん<br>なかなか釣れないだす…
#. de: Hmm ... Hier will nichts beißen.
#. fr: Hmmm... Je vais faire chou blanc, on dirait.
msgctxt "NpcYell:16232:0:13"
msgid "Hmm... Nothing wants to bite."
msgstr ""

#. ja: ここにはきっと<br>珍しい魚がいるだす！
#. de: Ich glaube, hier könnte es seltene Fische geben!
#. fr: Oh<nbsp>! Un poisson rare se cache dans le coin, je le sens<nbsp>!
msgctxt "NpcYell:16233:0:13"
msgid "A rare catch awaits. I can feel it!"
msgstr ""

#. ja: 何をするつもりだ！？
#. de: Was hat er vor!?
#. fr: Mais qu'est-ce qu'il prépare<nbsp>!?
msgctxt "NpcYell:16234:0:13"
msgid "What is he up to!?"
msgstr ""

#. ja: くっ！
#. de: Mist!
#. fr: Urgh<nbsp>!
msgctxt "NpcYell:16235:0:13"
msgid "Ugh!"
msgstr ""

#. ja: 速い…！
#. de: So schnell<nbsp>...
#. fr: Quelle rapidité...
msgctxt "NpcYell:16236:0:13"
msgid "Damn, he's fast..."
msgstr ""

#. ja: ぐあっ！
#. de: Argh!
#. fr: Argh<nbsp>!
msgctxt "NpcYell:16237:0:13"
msgid "Hngh!"
msgstr ""

#. ja: よし、いける！
#. de: Zeit zum Gegenangriff!
#. fr: Tenez bon, on va l'avoir<nbsp>!
msgctxt "NpcYell:16238:0:13"
msgid "My turn!"
msgstr ""

#. ja: くらえ！
#. de: Stirb!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:16239:0:13"
msgid "Bleed!"
msgstr ""

#. ja: こいつをぶち当てる！
#. de: Noch einmal!
#. fr: Ça va faire mal<nbsp>!
msgctxt "NpcYell:16240:0:13"
msgid "Come on!"
msgstr ""

#. ja: こいつで！
#. de: Nimm das!
#. fr: Tiens<nbsp>!
msgctxt "NpcYell:16241:0:13"
msgid "Hyah!"
msgstr ""

#. ja: しぶとい奴め！
#. de: Stirb endlich!
#. fr: Bon sang, il est coriace<nbsp>!
msgctxt "NpcYell:16242:0:13"
msgid "Fall already!"
msgstr ""

#. ja: ハッ！
#. de: Ha!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:16243:0:13"
msgid "Hah!"
msgstr ""

#. ja: 見えた…！
#. de: Zu langsam!
#. fr: Tu ne m'auras pas<nbsp>!
msgctxt "NpcYell:16244:0:13"
msgid "Saw that coming."
msgstr ""

#. ja: いまだ…！
#. de: Jetzt!
#. fr: Maintenant<nbsp>!
msgctxt "NpcYell:16245:0:13"
msgid "Now!"
msgstr ""

#. ja: 今なら！
#. de: Das ist die Gelegenheit!
#. fr: C'est le moment<nbsp>!
msgctxt "NpcYell:16246:0:13"
msgid "Not this time!"
msgstr ""

#. ja: キィィ…！
#. de: \<miepf>
#. fr: Kiiiiiih<nbsp>!
msgctxt "NpcYell:16247:0:13"
msgid "\\<squeak>"
msgstr ""

#. ja: キィッ、キィッ！
#. de: \<fmep>! \<fmep>!
#. fr: Kiiih kiiih<nbsp>!
msgctxt "NpcYell:16248:0:13"
msgid "Squeeeaaak!"
msgstr ""

#. ja: キキキッ…！
#. de: \<fmieeep>!
#. fr: Kih<nbsp>! Kih<nbsp>! Kih<nbsp>!
msgctxt "NpcYell:16249:0:13"
msgid "Wreeeeee!"
msgstr ""

#. ja: まずはこいつらだ！
#. de: Direkt die erste Beute in Sicht!
#. fr: On commence par ceux-là !
msgctxt "NpcYell:16250:0:13"
msgid "Let's get started!"
msgstr ""

#. ja: メ・テ・オ！<br>メ・テ・オ！
#. de: Me-te-or!<br>Me-te-ooor!
#. fr: Météore<nbsp>! Météore<nbsp>!
msgctxt "NpcYell:16251:0:13"
msgid "Hope you brought an umbrella!"
msgstr ""

#. ja: あたしの美技に<br>見惚れちゃえ！
#. de: Bin ich nicht <i>unglaublich</i> talentiert?
#. fr: Admirez mes splendides techniques<nbsp>!
msgctxt "NpcYell:16252:0:13"
msgid "Have you ever beheld such grace as mine!?"
msgstr ""

#. ja: 弾を生成するのも<br>ひと苦労なのよね…
#. de: Wenn es nur nicht so anstrengend wäre, diese Kugeln zu machen<nbsp>...
#. fr: Quelle plaie... C'est usant de fabriquer des balles<nbsp>!
msgctxt "NpcYell:16253:0:13"
msgid "Phew...I'm going through a lot of bullets."
msgstr ""

#. ja: やばっ！<br>手が滑っちゃった！？
#. de: Huch, ist mir die Hand ausgerutscht?
#. fr: Oh non<nbsp>! Mon doigt a glissé<nbsp>!
msgctxt "NpcYell:16254:0:13"
msgid "Oh no! My finger slipped!"
msgstr ""

#. ja: それそれそれ～！
#. de: Los los los!
#. fr: Prenez ça<nbsp>! Et ça<nbsp>!
msgctxt "NpcYell:16255:0:13"
msgid "Here. We. GO!"
msgstr ""

#. ja: 逃げ惑え～！
#. de: Na los, lauft!
#. fr: Courez<nbsp>! Fuyez<nbsp>!
msgctxt "NpcYell:16256:0:13"
msgid "Run, run, run!"
msgstr ""

#. ja: あっはははは！
#. de: Aaahahaha!
#. fr: Ah ha ha ha ha ha<nbsp>!
msgctxt "NpcYell:16257:0:13"
msgid "Hahaha!"
msgstr ""

#. ja: バレないように…っと
#. de: Und eines hierhin ...
#. fr: Vous ne devinerez jamais ce que je prépare...
msgctxt "NpcYell:16258:0:13"
msgid "You'll never guess what I've got in store..."
msgstr ""

#. ja: あ～おかしい！<br>すっごい音！
#. de: Ahahaha! Der war aber ordentlich laut!
#. fr: Ha ha<nbsp>! Trop drôle<nbsp>! C'était quoi, ce bruit<nbsp>?
msgctxt "NpcYell:16259:0:13"
msgid "Hehehe! Who made that sound? Rude! "
msgstr ""

#. ja: このぉ～！<br>踏みなさいよ！
#. de: Looos, es soll jemand drauftreten!
#. fr: Espèce de... Là<nbsp>! Marche dessus<nbsp>!
msgctxt "NpcYell:16260:0:13"
msgid "Just step on a cushion! Pretty please?"
msgstr ""

#. ja: リロード！
#. de: Und einmal nachladen!
#. fr: Il est temps de recharger<nbsp>!
msgctxt "NpcYell:16261:0:13"
msgid "Time to reload!"
msgstr ""

#. ja: サベネア島でも<br>馴染みのある景色だす！
#. de: Das erinnert mich sehr an Thavnair.
#. fr: Ce paysage me rappelle fortement Thavnair.
msgctxt "NpcYell:16262:0:13"
msgid "This scenery reminds me of home..."
msgstr ""

#. ja: あわわわ…！<br>怖くない、怖くない…！
#. de: Oje oje! Ich hab keine Angst, ich hab keine Angst<nbsp>...
#. fr: Ouaaaah<nbsp>! Non, j'ai pas peur... j'ai pas peur...
msgctxt "NpcYell:16263:0:13"
msgid "Gaaah! I'm not afraid, I'm not afraid..."
msgstr ""

#. ja: ひえ…！<br>お、お前を、強き剣と…！
#. de: D-Du liebe Zeit, bist du stark<nbsp>...
#. fr: Hiii<nbsp>! Vas-y, toi...
msgctxt "NpcYell:16264:0:13"
msgid "Remember... Hardships make us strong!"
msgstr ""

#. ja: このあたりは<br>良い釣り場かも…！
#. de: Hier lässt es sich gut angeln!
#. fr: L'endroit n'est pas trop mal pour pêcher<nbsp>!
msgctxt "NpcYell:16265:0:13"
msgid "This looks like a great spot to cast my rod."
msgstr ""

#. ja: うう…見慣れた魚しか<br>釣れないだす…
#. de: Hm, es beißen nur bekannte Freunde<nbsp>...
#. fr: Argh... Pourquoi je n'arrive pas à ferrer autre chose que du menu fretin...
msgctxt "NpcYell:16266:0:13"
msgid "Hmm... Not a single fish I haven't seen before."
msgstr ""

#. ja: オラも探してみるだす！
#. de: Ich sehe mich natürlich auch um!
#. fr: Je vais fouiner dans le sable de mon côté<nbsp>!
msgctxt "NpcYell:16267:0:13"
msgid "I'll have a look!"
msgstr ""

#. ja: ハズレ～！
#. de: Eine Nieeete!
#. fr: R-a-t-é<nbsp>!
msgctxt "NpcYell:16268:0:13"
msgid "Too bad!"
msgstr ""

#. ja: ふ～ん<br>やるじゃない…
#. de: Ha, nicht schlecht.
#. fr: Hmpf... Pas mal...
msgctxt "NpcYell:16269:0:13"
msgid "Heh, lucky you."
msgstr ""

#. ja: あの宝箱の中身<br>何だったんだろう…
#. de: Was ist da nur drin?
#. fr: Je me demande ce que renferment ces coffres...
msgctxt "NpcYell:16270:0:13"
msgid "What was in the chests, I wonder?"
msgstr ""

#. ja: よし、釣り開始だす！
#. de: Einmal die Angel ausgeworfen!
#. fr: Allez, il est grand temps de se mettre à la pêche<nbsp>!
msgctxt "NpcYell:16271:0:13"
msgid "See how an expert fisher does it!"
msgstr ""

#. ja: わっ…！<br>この場所なら…！
#. de: Ah! Hier ist es gut!
#. fr: Ouah<nbsp>! La vue est magnifique...
msgctxt "NpcYell:16272:0:13"
msgid "It's beautiful..."
msgstr ""

#. ja: 無事に合流できたね
#. de: Gut, du hast es auch ohne Probleme hierher geschafft.
#. fr: Nous voilà tous réunis<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:16273:0:13"
msgid "Good to see you found a way in too, <split \" \" 1><string $gs1></split>."
msgstr ""

#. ja: さあ、冒険の始まりだ！
#. de: Dann erkläre ich unser Abenteuer mal für eröffnet!
#. fr: En route pour l'aventure<nbsp>!
msgctxt "NpcYell:16274:0:13"
msgid "Right, then! Let's go and get our treasure!"
msgstr ""

#. ja: 大漁だな、モルバ！<br>頼りにしてるぜ
#. de: Sowohl unvorstellbare Schätze als auch übermächtige Gegner warten auf uns! Wir zählen auf dich, J'moldva.
#. fr: Ça, c'est pas du menu fretin<nbsp>! On compte sur toi, J'moldva<nbsp>!
msgctxt "NpcYell:16275:0:13"
msgid "Up for some spearfishing, J'moldva?"
msgstr ""

#. ja: あいわかった
#. de: Keine große Sache.
#. fr: Pas de prrroblème, faites-moi confiance<nbsp>!
msgctxt "NpcYell:16276:0:13"
msgid "Always."
msgstr ""

#. ja: あいつは…<br>馬、なのか？
#. de: Ist das<nbsp>... ein Pferd?
#. fr: Une sorte de... cheval, je suppose<nbsp>?
msgctxt "NpcYell:16277:0:13"
msgid "What is that? Some kind of horse?"
msgstr ""

#. ja: 水馬…<br>伝承に聞くケルピーか！
#. de: Ein buchstäbliches See-Pferd<nbsp>... Könnte es etwa das legendäre Kelpie sein?!
#. fr: C'est Kelpie, le légendaire cheval aquatique<nbsp>!
msgctxt "NpcYell:16278:0:13"
msgid "It's the Kelpie! I've heard legends of it!"
msgstr ""

#. ja: 全身ずぶ濡れだ…
#. de: Mein ganzer Körper ist klatschnass<nbsp>...
#. fr: Me voilà trempé jusqu'aux os...
msgctxt "NpcYell:16279:0:13"
msgid "I'm drenched from head to toe..."
msgstr ""

#. ja: 冒険ってのは<br>そういうもんだろう？
#. de: Tja, sowas fällt unter Berufsrisiko für Abenteurer.
#. fr: C'est le prix d'une belle aventure<nbsp>!
msgctxt "NpcYell:16280:0:13"
msgid "No more than you'd expect on an adventure, eh?"
msgstr ""

#. ja: なにかありそうな<br>気配がしてきたじゃないか！
#. de: So langsam werde ich mir immer sicherer, dass sich hier etwas Besonderes versteckt!
#. fr: Ouah... Voilà ce que j'appelle du spectacle<nbsp>!
msgctxt "NpcYell:16281:0:13"
msgid "And I have a feeling it's crawling with “worshipers”..."
msgstr ""

#. ja: スカラ時代の…<br>聖堂のようだね
#. de: Dies scheint eine Art Tempel aus der Skalla-Zeit zu sein<nbsp>...
#. fr: Hmm, pro<shy>ba<shy>ble<shy>ment une cathédrale de l'époque de Skalla...
msgctxt "NpcYell:16282:0:13"
msgid "I daresay this was a place of worship."
msgstr ""

#. ja: 厳重に守られた扉…
#. de: Ein schwer bewachtes Tor<nbsp>...
#. fr: La porte est farouchement gardée...
msgctxt "NpcYell:16283:0:13"
msgid "Quite well guarded, that door."
msgstr ""

#. ja: ついに、お宝か！？
#. de: Haben wir den Schatz gefunden?!
#. fr: Ça y est<nbsp>? On a déniché un trésor<nbsp>?
msgctxt "NpcYell:16284:0:13"
msgid "Does that mean we've already reached the treasure!?"
msgstr ""

#. ja: あれが宝…<br>ってわけじゃなさそうだな
#. de: Ich weiß nicht, ob ich <i>das</i> als Schatz bezeichnen würde<nbsp>...
#. fr: Oups... Pas tout à fait un trésor, on dirait<nbsp>!
msgctxt "NpcYell:16285:0:13"
msgid "If that's the treasure, then consider me disappointed."
msgstr ""

#. ja: 陶器製のゴーレムだ！<br>皆、警戒を！
#. de: Ein aus Keramik geformter Golem! Alle bereit zum Kampf!
#. fr: Attention, c'est un golem d'argile<nbsp>!
msgctxt "NpcYell:16286:0:13"
msgid "Fortunately for you, it's another guardian. Be on your guard!"
msgstr ""

#. ja: ふう、片付いたぜ…
#. de: Puh, und erledigt<nbsp>...
#. fr: Ouf, c'était pas du gâteau...
msgctxt "NpcYell:16287:0:13"
msgid "Hmph, troublesome piece of clay..."
msgstr ""

#. ja: 強力な呪法を<br>用いていたようだね
#. de: Solch mächtige Magie sieht man nicht alle Tage.
#. fr: Ses incantations étaient ex<shy>trê<shy>me<shy>ment puissantes...
msgctxt "NpcYell:16288:0:13"
msgid "Indeed. Its magicks were not to be underestimated."
msgstr ""

#. ja: 牢獄、それに…
#. de: Wirkt wie ein Kerker<nbsp>...
#. fr: ... Une prrrison<nbsp>?
msgctxt "NpcYell:16289:0:13"
msgid "Prison cells..."
msgstr ""

#. ja: そして廃王の遺物か…
#. de: Die letzten Hin<shy>ter<shy>lass<shy>en<shy>schaf<shy>ten Theoderics<nbsp>...
#. fr: Serait-ce... le restant des possessions de Theodoric<nbsp>?
msgctxt "NpcYell:16290:0:13"
msgid "Relics of the mad king's reign."
msgstr ""

#. ja: なあ…いま、人が…
#. de: H-He<nbsp>... Waren das etwa<nbsp>...
#. fr: Cette créature n'avait plus grand-chose d'humain...
msgctxt "NpcYell:16291:0:13"
msgid "That was a person? Seven hells..."
msgstr ""

#. ja: 呪いによる変異という噂は<br>真実だったのか…
#. de: Die Gerüchte, dass Leute durch Flüche in Ungeheuer verwandelt wurden, waren also wahr<nbsp>...
#. fr: La malédiction était donc bien réelle...
msgctxt "NpcYell:16292:0:13"
msgid "So the dark rumors of this place were true..."
msgstr ""

#. ja: そう簡単に宝を<br>譲る気はなさそうだね
#. de: Scheint, als wird er uns seinen Schatz nicht so einfach überreichen, hm?
#. fr: Mettre la main sur ce trésor, ça se mérite, on dirait<nbsp>!
msgctxt "NpcYell:16293:0:13"
msgid "It seems that fellow won't let us have the treasure without a fight."
msgstr ""

#. ja: 最後の難関か…<br>冒険はこうでなくちゃな！
#. de: Ein letztes Hindernis, was? Anders darf ein gutes Abenteuer auch nicht enden!
#. fr: Nous voici au point d'orgue de notre aventure<nbsp>!
msgctxt "NpcYell:16294:0:13"
msgid "Wouldn't be much of an adventure if it didn't end on a climax, eh?"
msgstr ""

#. ja: クッ…身動きが…！
#. de: Ugh<nbsp>... Kann mich nicht bewegen<nbsp>...!
#. fr: Merrrde... Je peux plus bouger !
msgctxt "NpcYell:16295:0:13"
msgid "I...can't move..."
msgstr ""

#. ja: これより先は<br>徒歩で進むぞ
#. de: Von hier ab gehen wir zu Fuß weiter.
#. fr: À partir d'ici, on continue à pied<nbsp>!
msgctxt "NpcYell:16296:0:13"
msgid "From here we must proceed on foot."
msgstr ""

#. ja: なんて砂塵…
#. de: Der Sandsturm erschwert das Vorankommen<nbsp>...
#. fr: Quelle poussière aveuglante...
msgctxt "NpcYell:16297:0:13"
msgid "That was quite a sandstorm..."
msgstr ""

#. ja: よし、皆そろっているな
#. de: Alle sind hier, ja? Dann auf!
#. fr: Restons groupés<nbsp>!
msgctxt "NpcYell:16298:0:13"
msgid "All present and accounted for?"
msgstr ""

#. ja: これより先は<br>徒歩で進みましょう
#. de: Von hier ab gehen wir zu Fuß weiter.
#. fr: À partir d'ici, on continue à pied<nbsp>!
msgctxt "NpcYell:16299:0:13"
msgid "I believe so. Let us continue on foot."
msgstr ""

#. ja: 頭上にも注意しなくちゃね
#. de: Scheint, als müssten wir hier besonders aufmerksam sein.
#. fr: Attention au-dessus de vos têtes<nbsp>!
msgctxt "NpcYell:16300:0:13"
msgid "Watch your heads, everyone!"
msgstr ""

#. ja: 砂で岩が滑り落ちて…
#. de: Der Sand gibt den Felsen keinen Halt<nbsp>...
#. fr: Le sable ne peut pas retenir d'aussi gros rochers<nbsp>!
msgctxt "NpcYell:16301:0:13"
msgid "The sand above gives way. Have care."
msgstr ""

#. ja: む、落石か！？
#. de: Steinschlag, hm?
#. fr: Un éboulement<nbsp>!?
msgctxt "NpcYell:16302:0:13"
msgid "Falling rocks!"
msgstr ""

#. ja: ずいぶん落ちたみたい
#. de: Da sind schon eine ganze Menge an Stalaktiten runtergefallen.
#. fr: Ça en fait, de la pierre...
msgctxt "NpcYell:16303:0:13"
msgid "We've fallen quite a ways..."
msgstr ""

#. ja: 甲虫らしき姿が見えるわね
#. de: Dieses Ungeheuer hat etwas von einem Skorpion.
#. fr: J'ai l'impression d'apercevoir un scorpion...
msgctxt "NpcYell:16304:0:13"
msgid "A scorpion clad in crystal. How curious."
msgstr ""

#. ja: 砂中の楼閣<br>とでも言うべきか
#. de: Eine buchstäbliche Sandburg<nbsp>...
#. fr: Une tour de sable, im<shy>pres<shy>sion<shy>nant<nbsp>!
msgctxt "NpcYell:16305:0:13"
msgid "I daresay we're in that creature's home."
msgstr ""

#. ja: 何を食らっているのやら
#. de: Friss Staub!
#. fr: Un peu trop glouton à mon goût<nbsp>!
msgctxt "NpcYell:16306:0:13"
msgid "What did it have to feed upon here?"
msgstr ""

#. ja: この環境に適応するなんて<br>驚きだわ…
#. de: Beeindruckend, wie es sich an diese Umgebung anpassen konnte<nbsp>...
#. fr: Qui aurait cru qu'on tomberait sur un monstre pareil ici<nbsp>?
msgctxt "NpcYell:16307:0:13"
msgid "Amazing that life could adapt to such a harsh environment."
msgstr ""

#. ja: 生への執念と<br>言ったところか…
#. de: Was lebt, will auch überleben, koste es, was es wolle<nbsp>...
#. fr: Il s'est accroché à la vie jusqu'à son dernier souffle...
msgctxt "NpcYell:16308:0:13"
msgid "One cannot underestimate the will to survive."
msgstr ""

#. ja: これは、アラグ帝国の…？
#. de: Ist das etwa eine allagische Ruine<nbsp>...?
#. fr: ... De la technologie allagoise<nbsp>?
msgctxt "NpcYell:16309:0:13"
msgid "Is this Allagan...?"
msgstr ""

#. ja: 急に雰囲気が変わったな
#. de: Als hätten wir plötzlich eine andere Welt betreten.
#. fr: L'ambiance a changé en un éclair...
msgctxt "NpcYell:16310:0:13"
msgid "Quite an abrupt change in surrounds..."
msgstr ""

#. ja: そう…私が視ている<br>エーテルは…
#. de: Dieser Äther<nbsp>... Verstehe, so ist das also<nbsp>...
#. fr: Cet éther... Oui, aucun doute possible...
msgctxt "NpcYell:16311:0:13"
msgid "Aye. The aether here is unmistakable."
msgstr ""

#. ja: わらわらと気色悪い…
#. de: Mir wird schlecht hier drin<nbsp>...
#. fr: Urgh... J'ai la nausée...
msgctxt "NpcYell:16312:0:13"
msgid "Ugh, repulsive creatures..."
msgstr ""

#. ja: コブランの棲家かしら
#. de: Sind wir etwa auf ein Kobalos-Nest gestoßen?
#. fr: C'est un repaire de coblyns<nbsp>!
msgctxt "NpcYell:16313:0:13"
msgid "It seems we've trespassed upon their lair."
msgstr ""

#. ja: 退屈せぬ洞窟だな！
#. de: Diese Höhle gibt einem wirklich keine Ruhe!
#. fr: Pas le temps de s'ennuyer dans cette grotte<nbsp>!
msgctxt "NpcYell:16314:0:13"
msgid "Never a dull moment in this cavern!"
msgstr ""

#. ja: アラグの機械だろうと<br>蹴散らすだけよ！
#. de: Allagische Maschinen oder nicht, was uns im Weg steht wird zerstört!
#. fr: Technologie allagoise ou pas, on lui met la pâtée<nbsp>!
msgctxt "NpcYell:16315:0:13"
msgid "Native fauna or Allagan machina, we'll clear them all out!"
msgstr ""

#. ja: かなり巨大な<br>施設のようだ…
#. de: Diese Einrichtung ist überraschend großflächig<nbsp>...
#. fr: Cette installation est absolument gigantesque...
msgctxt "NpcYell:16316:0:13"
msgid "Such an immense facility..."
msgstr ""

#. ja: アラグの機構は<br>まだ生きているようね
#. de: Scheint, als wären einige dieser Maschinen noch funktionstüchtig.
#. fr: La machinerie allagoise tient encore joliment debout...
msgctxt "NpcYell:16317:0:13"
msgid "Both machina and facility are still operational."
msgstr ""

#. ja: 蹴散らすのに変わりないわ！
#. de: Aber nicht mehr lange!
#. fr: Plus pour longtemps<nbsp>!
msgctxt "NpcYell:16318:0:13"
msgid "Not for much longer, they won't be!"
msgstr ""

#. ja: 輪切りにされちゃ<br>たまらないわ
#. de: Als ob ich mich in Stücke schneiden lasse!
#. fr: Pas question de me faire découper en rondelles<nbsp>!
msgctxt "NpcYell:16319:0:13"
msgid "Those blades could do some serious damage."
msgstr ""

#. ja: 造作もない…
#. de: Kein Problem<nbsp>...
#. fr: Et voilà le travail...
msgctxt "NpcYell:16320:0:13"
msgid "Nothing to it."
msgstr ""

#. ja: 時間があれば<br>よく見てまわりたいけれど…
#. de: Ich wünschte, wir hätten die Zeit, all dies in Ruhe zu erforschen<nbsp>...
#. fr: Dommage que nous n'ayons pas le temps de visiter...
msgctxt "NpcYell:16321:0:13"
msgid "As much as I would like to examine this place, we should press on."
msgstr ""

#. ja: うむ、今は先へ…！
#. de: Ein anderes Mal. Für jetzt müssen wir weiter!
#. fr: En parlant de temps, n'en perdons pas davantage<nbsp>!
msgctxt "NpcYell:16322:0:13"
msgid "Indeed. Perhaps there will be time later."
msgstr ""

#. ja: 永久焦土とは<br>よくいったものよな
#. de: Das Kargland macht seinem Namen wirklich alle Ehre.
#. fr: C'est bien calciné par ici<nbsp>!
msgctxt "NpcYell:16323:0:13"
msgid "'Tis easy to see why they say this place was “bled dry.”"
msgstr ""

#. ja: どのような地にも<br>命は生まれるのね…
#. de: Und dennoch findet sich selbst hier noch Leben<nbsp>...
#. fr: La vie est vraiment capable de germer partout...
msgctxt "NpcYell:16324:0:13"
msgid "No matter the odds, life always finds a way..."
msgstr ""

#. ja: このように巨大な白骨が<br>この世にあろうとは…
#. de: Dass Wesen mit solch enormen Knochen wahrlich in dieser Welt existieren<nbsp>...
#. fr: Comment un squelette peut-il être aussi énorme<nbsp>?
msgctxt "NpcYell:16325:0:13"
msgid "The sand here is as pale as those enormous bones."
msgstr ""

#. ja: 生きていたら<br>強敵だったでしょうね
#. de: Lasst uns froh sein, uns zumindest nicht mit diesem Koloss messen zu müssen.
#. fr: Vous imaginez le tas de viande qui l'enveloppait<nbsp>?
msgctxt "NpcYell:16326:0:13"
msgid "I'm glad we don't have to face it alive."
msgstr ""

#. ja: サンドワームの祖かしら
#. de: Vorfahren des Sandwurms, nehme ich an<nbsp>...
#. fr: Un ver des sables ancestral, a priori...
msgctxt "NpcYell:16327:0:13"
msgid "Are sandworms descended from this creature, I wonder."
msgstr ""

#. ja: これは…砂虫の骨格か
#. de: Ein Skelett aus Sand<nbsp>...?
#. fr: Je ne veux même pas tenter de visualiser cette chose...
msgctxt "NpcYell:16328:0:13"
msgid "That a sandworm could have grown to such proportions..."
msgstr ""

#. ja: 白き大地にて<br>白き竜とまみえるか！
#. de: Ein weißer Drache inmitten einer weißen Wüste, wie treffend.
#. fr: Un dragon blanc dans un désert blanc, c'est logique<nbsp>!
msgctxt "NpcYell:16329:0:13"
msgid "A dragon as white as these wastes... How very fitting."
msgstr ""

#. ja: 霧の中から竜だなんて<br>どうなってるの！？
#. de: Ist der Drache gerade plötzlich aus dem Nebel erschienen!?
#. fr: Comment parvient-il à se fondre dans la brume ainsi<nbsp>!?
msgctxt "NpcYell:16330:0:13"
msgid "That dragon formed from the mist!"
msgstr ""

#. ja: アラグが操っていた<br>哀れな傀儡でしょうね…
#. de: Vermutlich wurde der Ärmste von den Allagern kontrolliert<nbsp>...
#. fr: Certainement un pantin que les Allagois manipulaient à leur guise...
msgctxt "NpcYell:16331:0:13"
msgid "Another of Allag's pitiable slaves, I'd wager."
msgstr ""

#. ja: 皆の者！<br>ここが正念場ぞ！
#. de: Freunde, dies ist unsere letzte, alles entscheidende Schlacht!
#. fr: L'heure de vérité a sonné, mes amis<nbsp>!
msgctxt "NpcYell:16332:0:13"
msgid "This is the moment of truth, my friends! Hold nothing back!"
msgstr ""

#. ja: ええ！<br>やってやりましょう！
#. de: Fürwahr, lasst uns alles geben!
#. fr: Ouais<nbsp>! À nous la victoire<nbsp>!
msgctxt "NpcYell:16333:0:13"
msgid "Aye, let's give them hells!"
msgstr ""

#. ja: 意表を突いたつもりか！
#. de: Sollte das etwa ein Hinterhalt sein?
#. fr: Attention, c'est un guet-apens<nbsp>!
msgctxt "NpcYell:16334:0:13"
msgid "They must do better than that to catch us off guard!"
msgstr ""

#. ja: うっとうしい連中ね！
#. de: Welch lästige Gesellen!
#. fr: Oh là là, mais comment peut-on être aussi collant<nbsp>!?
msgctxt "NpcYell:16335:0:13"
msgid "Out of our way!"
msgstr ""

#. ja: 上空から敵兵が！
#. de: Gegnerische Truppen von oben!
#. fr: Ils arrivent par la voie des airs<nbsp>!
msgctxt "NpcYell:16336:0:13"
msgid "Enemies from above!"
msgstr ""

#. ja: 金の装甲とは<br>また珍妙な…
#. de: Eine goldene Rüstung? Was die sich nicht alles einfallen lassen<nbsp>...
#. fr: Quelle drôle d'armure, tout de même...
msgctxt "NpcYell:16337:0:13"
msgid "Golden armor... Safe to assume it's dangerous."
msgstr ""

#. ja: 偉そうに<br>ふんぞり返ってるわね
#. de: Der denkt wohl, er wäre was Besseres!
#. fr: On va lui rabattre son caquet à ce grand dadais<nbsp>!
msgctxt "NpcYell:16338:0:13"
msgid "Special, are you? Well, you're about to lose your luster!"
msgstr ""

#. ja: ヒエン様、油断なきよう…
#. de: König Hien, bleibt wachsam!
#. fr: Seigneur Hien, par pitié, restez sur vos gardes<nbsp>!
msgctxt "NpcYell:16339:0:13"
msgid "Indeed. Let all have care."
msgstr ""

#. ja: グルグル…目が回りそう
#. de: Mir dreht sich alles im Kopf nach dem ganzen Gekreise<nbsp>...
#. fr: Oooh... J'ai la tête qui tourne...
msgctxt "NpcYell:16340:0:13"
msgid "Ungh, my head is spinning..."
msgstr ""

#. ja: 大剣の威力は本物であったな
#. de: Wucht hatte das Schwert aber allemal.
#. fr: Une chose est sûre, sa grosse épée n'était pas en plastique...
msgctxt "NpcYell:16341:0:13"
msgid "That was some truly savage swordplay."
msgstr ""

#. ja: 肝が冷えたな…
#. de: Es liegt was in der Luft<nbsp>...!
#. fr: La tension augmente...
msgctxt "NpcYell:16342:0:13"
msgid "Too close for comfort..."
msgstr ""

#. ja: 激しい戦闘があったようね
#. de: Der Kampf hier muss besonders heftig gewesen sein.
#. fr: Une bataille a déjà fait rage par ici...
msgctxt "NpcYell:16343:0:13"
msgid "How fierce must the fighting have been here..."
msgstr ""

#. ja: 魔導兵器の破片が…！
#. de: Vorsicht, die Überreste der Magitek-Waffe fallen ab<nbsp>...!
#. fr: Un morceau d'arme magitek...<nbsp>!
msgctxt "NpcYell:16344:0:13"
msgid "Machina wreckage!?"
msgstr ""

#. ja: 友軍を支援するぞ！
#. de: Lasst uns unseren Kameraden helfen!
#. fr: Il faut soutenir nos alliés<nbsp>!
msgctxt "NpcYell:16345:0:13"
msgid "Our friends need us! With me!"
msgstr ""

#. ja: リセ！<br>今行くわ！
#. de: Lyse! Wir sind sofort bei dir!
#. fr: Lyse<nbsp>! On arrive<nbsp>!
msgctxt "NpcYell:16346:0:13"
msgid "Hang in there, Lyse!"
msgstr ""

#. ja: 承知ッ！
#. de: Verstanden!
#. fr: À vos ordres<nbsp>!
msgctxt "NpcYell:16347:0:13"
msgid "My lord!"
msgstr ""

#. ja: ヤツを倒し<br>突破口を開くぞ…！
#. de: Wenn wir den hier erledigen, ist der Durchgang frei!
#. fr: Puisqu'il faut lui passer sur le corps, ainsi soit-il<nbsp>!
msgctxt "NpcYell:16348:0:13"
msgid "An unusual foe...but we will find a way through it!"
msgstr ""

#. ja: こんな場所で<br>止まってられないわ！
#. de: Wir werden uns nicht hier aufhalten lassen!
#. fr: Lui, il a pas intérêt à se mettre en travers de notre chemin<nbsp>!
msgctxt "NpcYell:16349:0:13"
msgid "Whatever it is, we can't afford to be stopped here!"
msgstr ""

#. ja: 塹壕を掘るための<br>絡繰りか？
#. de: Ist das eine Vorrichtung, um Schützengräben auszuheben?
#. fr: Un mécanisme pour... creuser des tranchées<nbsp>?
msgctxt "NpcYell:16350:0:13"
msgid "Some manner of trench-digging weapon?"
msgstr ""

#. ja: 帝国は妙なものばかり<br>作りおる…
#. de: Eine ungewöhnliche Erfindung nach der anderen<nbsp>...
#. fr: On aura tout vu de la part des Impériaux...
msgctxt "NpcYell:16351:0:13"
msgid "Such bizarre machina the Garleans are wont to make..."
msgstr ""

#. ja: まるで火を吹くモグラね！
#. de: Wie ein feuerspeiender Maulwurf!
#. fr: C'était une sorte de taupe, mais avec des gènes de dragon<nbsp>!
msgctxt "NpcYell:16352:0:13"
msgid "That one was like a fire-breathing mole, I thought."
msgstr ""

#. ja: カヌ・エ様、アイメリク総長も！
#. de: Seht, da sind Kan-E-Senna und Großmeister Aymeric!
#. fr: Dame Kan-E-Senna<nbsp>! Sire Aymeric<nbsp>!
msgctxt "NpcYell:16353:0:13"
msgid "Elder Seedseer! Ser Aymeric!"
msgstr ""

#. ja: 我らも突貫するぞ！
#. de: Auf, dass wir nicht zurückfallen!
#. fr: On rentre dans le tas<nbsp>! YAAAH<nbsp>!!
msgctxt "NpcYell:16354:0:13"
msgid "Let us press on together!"
msgstr ""

#. ja: 友軍の猛者が揃い踏みか！
#. de: All unsere Verbündeten haben es hergeschafft!
#. fr: Nos valeureux alliés<nbsp>! Ils sont tous là<nbsp>!
msgctxt "NpcYell:16355:0:13"
msgid "How heartening to have the Alliance's finest at our side!"
msgstr ""

#. ja: みんな、無事だったのね！
#. de: Ihr seid wohlauf, dem Himmel sei Dank!
#. fr: Tout le monde va bien, quel soulagement<nbsp>!
msgctxt "NpcYell:16356:0:13"
msgid "You're all safe, thank goodness!"
msgstr ""

#. ja: まこと、頼もしい……！
#. de: Meine Zuversicht wächst mit jedem Moment<nbsp>...!
#. fr: La victoire ne peut plus nous échapper<nbsp>!
msgctxt "NpcYell:16357:0:13"
msgid "Aye, there is naught we need fear!"
msgstr ""

#. ja: あの攻撃を防ぐとは！
#. de: Sie hat einen solch gewaltigen Angriff abgewehrt!
#. fr: Quelle défense de folie<nbsp>!
msgctxt "NpcYell:16358:0:13"
msgid "To ward off such a powerful attack..."
msgstr ""

#. ja: さすがはカヌ・エ様ね！
#. de: Kan-E-Senna ist wahrlich nicht zu unter<shy>schätzen.
#. fr: Bravo, Dame Kan-E-Senna<nbsp>!
msgctxt "NpcYell:16359:0:13"
msgid "No less than I'd expect of the Elder Seedseer!"
msgstr ""

#. ja: 見事な障壁…！
#. de: Eine beeindruckende Barriere<nbsp>...!
#. fr: Cette barrière tombe à pic<nbsp>!
msgctxt "NpcYell:16360:0:13"
msgid "A sturdier barrier I have seldom seen!"
msgstr ""

#. ja: 拳で鉄を穿つか…！
#. de: Metall mit der bloßen Faust zu durchbohren<nbsp>...!
#. fr: Broyer du métal à mains nues... C'est de la folie<nbsp>!
msgctxt "NpcYell:16361:0:13"
msgid "Leave it to Lyse to pierce warmachina armor with her fist!"
msgstr ""

#. ja: 私も…<br>負けてられないわ！
#. de: So einfach<nbsp>... gebe ich mich aber auch nicht geschlagen!
#. fr: Après tout ça... j'ai vraiment plus le droit de perdre<nbsp>!
msgctxt "NpcYell:16362:0:13"
msgid "I won't be outdone!"
msgstr ""

#. ja: 只者じゃなさそうね…
#. de: Die zwei scheinen stärker als die vorherigen Soldaten zu sein.
#. fr: En voilà deux qui n'ont pas l'air commodes...
msgctxt "NpcYell:16363:0:13"
msgid "These are no ordinary soldiers..."
msgstr ""

#. ja: ついに士官のお出ましか！
#. de: Die Offiziere geben sich zu guter Letzt selbst die Ehre, hm?
#. fr: Le temps est venu pour les hauts gradés de faire leur entrée en scène<nbsp>!
msgctxt "NpcYell:16364:0:13"
msgid "So, their commanders deign to appear at last!"
msgstr ""

#. ja: だっはっは！<br>俺、参上ーっ！
#. de: Gahaha!
#. fr: Bwahaha<nbsp>! Le grand Zozone entre en scène<nbsp>!
msgctxt "NpcYell:16365:0:13"
msgid "Make way for Zozone!"
msgstr ""

#. ja: でてこいやぁ！
#. de: Raus mit dir!
#. fr: À moi, esprit du vent<nbsp>!
msgctxt "NpcYell:16366:0:13"
msgid "Ride the wind!"
msgstr ""

#. ja: 風を起こしちまえ！
#. de: Weht, ihr Winde!
#. fr: Déclenche-moi une tempête<nbsp>!
msgctxt "NpcYell:16367:0:13"
msgid "Serve up a storm!"
msgstr ""

#. ja: そんじゃーな！
#. de: Fresst Staub!
#. fr: Repli stratégique<nbsp>!
msgctxt "NpcYell:16368:0:13"
msgid "Time to make myself scarce!"
msgstr ""

#. ja: こんにゃろー！<br>後悔させてやらぁ！
#. de: Gah, das werdet ihr bereuen!
#. fr: Bande de salauds<nbsp>! Vous allez m'le payer<nbsp>!
msgctxt "NpcYell:16369:0:13"
msgid "Heartless bastards! I'll have my revenge!"
msgstr ""

#. ja: あばよーっ！
#. de: Tschö mit Ö!
#. fr: Adieu, les nazes<nbsp>!
msgctxt "NpcYell:16370:0:13"
msgid "Shame I won't get to watch you die here!"
msgstr ""

#. ja: また獰猛なのがいるだす！
#. de: Ruhig ist es hier nier!
#. fr: La créature a perdu la boule<nbsp>!
msgctxt "NpcYell:16371:0:13"
msgid "It's gone berserk!"
msgstr ""

#. ja: あの鳥といい<br>ここは危ない生物が多いだす…
#. de: Kalika hatte Recht. Überall Tiere.
#. fr: Il n'y a que des monstres sur cette île ou quoi<nbsp>!?
msgctxt "NpcYell:16372:0:13"
msgid "Does every beast on this island want to kill us?"
msgstr ""

#. ja: やっぱり…<br>ちょっと怖かっただす…
#. de: Augen zu und durch<nbsp>...
#. fr: J'avoue... J'ai les genoux qui jouent encore des castagnettes tellement j'ai eu peur.
msgctxt "NpcYell:16373:0:13"
msgid "I admit...that was scary, but exciting."
msgstr ""

#. ja: いくぞッ！
#. de: Dann los!
#. fr: Tu vas souffrir<nbsp>!
msgctxt "NpcYell:16374:0:13"
msgid "Have at you!"
msgstr ""

#. ja: くらえッ！
#. de: Wie wär's damit!
#. fr: Mange ça<nbsp>!
msgctxt "NpcYell:16375:0:13"
msgid "Enough!"
msgstr ""

#. ja: 我が剣技を受けよ！
#. de: Wie schmeckt dir mein Stahl?!
#. fr: Goûte donc un peu à mon épée<nbsp>!
msgctxt "NpcYell:16376:0:13"
msgid "Fear my wrath!"
msgstr ""

#. ja: 邪魔はさせん！
#. de: Niemand steht mir im Weg!
#. fr: Tu ne nous arrêteras pas<nbsp>!
msgctxt "NpcYell:16377:0:13"
msgid "I think not."
msgstr ""

#. ja: 行くぞ、ゴルベーザ。
#. de: Und weiter!
#. fr: Allez, Golbez. On y va.
msgctxt "NpcYell:16378:0:13"
msgid "With me, Golbez!"
msgstr ""

#. ja: 大丈夫か！？
#. de: Bist du verletzt!?
#. fr: Hé, ça va<nbsp>!?
msgctxt "NpcYell:16379:0:13"
msgid "Are you all right?"
msgstr ""

#. ja: 我らの祖国を護るのだ！
#. de: Wir werden unsere Heimat beschützen!
#. fr: Nous protégerons notre pays, de notre vie s'il le faut<nbsp>!
msgctxt "NpcYell:16380:0:13"
msgid "For king and country!"
msgstr ""

#. ja: この命が尽きようとも…！
#. de: Selbst, wenn ich hier mein Leben lasse!
#. fr: Je dois y arriver, même si je dois y rester...<nbsp>!
msgctxt "NpcYell:16381:0:13"
msgid "I cannot─will not─fall here!"
msgstr ""

#. ja: ゴルベーザ様！
#. de: Meister Golbez!
#. fr: Seigneur Golbez<nbsp>!
msgctxt "NpcYell:16382:0:13"
msgid "It's Lord Golbez!"
msgstr ""

#. ja: ゴルベーザ様、<br>お待ちしておりました…！
#. de: Meister Golbez, wir haben auf Euch gewartet!
#. fr: Nous attendions votre retour<nbsp>!
msgctxt "NpcYell:16383:0:13"
msgid "Lord Golbez is come!"
msgstr ""

#. ja: おお、ドゥランテ様も！
#. de: Oh, Meister Durante ist auch bei Euch!
#. fr: Et le seigneur Durante est avec vous<nbsp>!
msgctxt "NpcYell:16384:0:13"
msgid "And Lord Durante too!"
msgstr ""

#. ja: お二人とも、よくぞ戻られた！
#. de: Den Himmeln sei Dank, Ihr seid zurückgekehrt!
#. fr: Nous sommes heureux de vous voir sains et saufs<nbsp>!
msgctxt "NpcYell:16385:0:13"
msgid "Thank heavens you've returned!"
msgstr ""

#. ja: ぐあぁぁ！
#. de: Ghaaaaa!
#. fr: Aaargh<nbsp>!
msgctxt "NpcYell:16386:0:13"
msgid "Arrrggghhh!"
msgstr ""

#. ja: ヒッ…たすケ…！
#. de: Uah<nbsp>... H-Hilfe!
#. fr: P-Pitié... Sauvez-moi...<nbsp>!
msgctxt "NpcYell:16387:0:13"
msgid "Help...me..."
msgstr ""

#. ja: ゴルベーザ様と<br>ドゥランテ様だ！
#. de: Meister Golbez! Und Meister Durante ist auch da!
#. fr: C'est le seigneur Golbez et le seigneur Durante<nbsp>!
msgctxt "NpcYell:16388:0:13"
msgid "Lord Golbez! Lord Durante!"
msgstr ""

#. ja: 王城へお急ぎください！
#. de: Bitte beeilt Euch zum Schloss!
#. fr: Ils ont besoin de votre aide au château<nbsp>!
msgctxt "NpcYell:16389:0:13"
msgid "Quickly, to the castle!"
msgstr ""

#. ja: 英雄が帰って来たぞ！
#. de: Unser Held ist wieder da!
#. fr: Notre héros est de retour<nbsp>!
msgctxt "NpcYell:16390:0:13"
msgid "They've returned! Thank heavens!"
msgstr ""

#. ja: ゴルベーザ様だ！<br>これで勝てる…！
#. de: Das ist doch Golbez!<br> Der Sieg wird unser sein!
#. fr: Avec seigneur Golbez à nos côtés, la victoire est assurée<nbsp>!
msgctxt "NpcYell:16391:0:13"
msgid "Lord Golbez! Hope is not lost, then!"
msgstr ""

#. ja: そんな、嫌よ…！
#. de: N-Neeein! B-Bitte niiicht!
#. fr: Noooon<nbsp>!
msgctxt "NpcYell:16392:0:13"
msgid "Please, no!"
msgstr ""

#. ja: 私の身体が…！？
#. de: W-Was geschieht mit mir<nbsp>...?
#. fr: Qu-qu'est-ce qui m'arrive<nbsp>!?
msgctxt "NpcYell:16393:0:13"
msgid "What's happening to me!?"
msgstr ""

#. ja: 逃げろぉぉ！
#. de: Weg hiiier!
#. fr: Fuyez<nbsp>!
msgctxt "NpcYell:16394:0:13"
msgid "Run for your lives!"
msgstr ""

#. ja: うわぁぁ！
#. de: Uaaah!
#. fr: Aaaah<nbsp>!
msgctxt "NpcYell:16395:0:13"
msgid "Ahhh!"
msgstr ""

#. ja: た、助けてくれぇ！
#. de: B-Bitte lasst mich nicht zurück!
#. fr: Sauvez-moi<nbsp>!
msgctxt "NpcYell:16396:0:13"
msgid "Someone help us!"
msgstr ""

#. ja: ぴぴぴ！
#. de: Zwitscher! ♪
#. fr: Pipipi<nbsp>!
msgctxt "NpcYell:16397:0:13"
msgid "Peep-peep!"
msgstr ""

#. ja: モチィっ？
#. de: Glupsch.
#. fr: Ssssiii<nbsp>!
msgctxt "NpcYell:16398:0:13"
msgid "Sssquidge?"
msgstr ""

#. ja: グォン…
#. de: \<ominöses Grollen>
#. fr: Gwon...
msgctxt "NpcYell:16399:0:13"
msgid "\\<rumble> \\<rumble>"
msgstr ""

#. ja: 追イ風ヲ…
#. de: Ich habe euch im Visier!
#. fr: Le vent nous appelle...
msgctxt "NpcYell:16400:0:13"
msgid "Wind guide my arrow!"
msgstr ""

#. ja: …………。
#. de: ... ...
#. fr: ...
msgctxt "NpcYell:16401:0:13"
msgid "..."
msgstr ""

#. ja: りぞーと！
#. de: Die Sonnencreme nicht vergessen!
#. fr: Enfin, les vacances<nbsp>!
msgctxt "NpcYell:16402:0:13"
msgid "Work hard, play harder!"
msgstr ""

#. ja: コノ世界ヲ救ウノダ！
#. de: Ich werde diese Welt retten!
#. fr: Pour l'ultime salut<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:16403:0:13"
msgid "I shall deliver the<br>world its salvation!"
msgstr ""

#. ja: クン！
#. de: Wuff!
#. fr: Ouaf<nbsp>!
msgctxt "NpcYell:16404:0:13"
msgid "Ruff!"
msgstr ""

#. ja: ホーホー！
#. de: Wuu Wuu!
#. fr: Wou hou<nbsp>!
msgctxt "NpcYell:16405:0:13"
msgid "Woo-hoo-hoo!"
msgstr ""

#. ja: ペグ～
#. de: Pegwiii!
#. fr: Peg, peg<nbsp>!
msgctxt "NpcYell:16406:0:13"
msgid "Peg, peg!"
msgstr ""

#. ja: パァァァ
#. de: Hwaah!
#. fr: Pah<nbsp>!
msgctxt "NpcYell:16407:0:13"
msgid "Hyaaah!"
msgstr ""

#. ja: まっくら
#. de: Dunkelheit<nbsp>...
#. fr: Ténèbres...
msgctxt "NpcYell:16408:0:13"
msgid "Darkness..."
msgstr ""

#. ja: 覚悟ハアルノカ？
#. de: Seid ihr euch dieser immensen Verantwortung bewusst?
#. fr: C'est une lourde res<shy>pon<shy>sa<shy>bi<shy>li<shy>té...
msgctxt "NpcYell:16409:0:13"
msgid "Are you prepared?"
msgstr ""

#. ja: 理由ガイルカイ？
#. de: Braucht es wirklich einen Grund?
#. fr: Il faut une raison<nbsp>?
msgctxt "NpcYell:16410:0:13"
msgid "You don't need a reason."
msgstr ""

#. ja: 必ズ帰ッテキテ…
#. de: Bitte, komm zurück!
#. fr: Promets-moi de revenir...
msgctxt "NpcYell:16411:0:13"
msgid "Please come back."
msgstr ""

#. ja: しゅぱーっ
#. de: Mlem!
#. fr: Slurp<nbsp>!
msgctxt "NpcYell:16412:0:13"
msgid "\\<slurp>"
msgstr ""

#. ja: ●ひどい有様だ……
#. de: 0
#. fr: 0
msgctxt "NpcYell:16413:0:13"
msgid "0"
msgstr ""

#. ja: 1～！
#. de: Eins!
#. fr: Un<nbsp>!
msgctxt "NpcYell:16414:0:13"
msgid "One!"
msgstr ""

#. ja: 2～！
#. de: Zwei!
#. fr: Deux<nbsp>!
msgctxt "NpcYell:16415:0:13"
msgid "Two!"
msgstr ""

#. ja: 3～！
#. de: Drei!
#. fr: Trois<nbsp>!
msgctxt "NpcYell:16416:0:13"
msgid "Three!"
msgstr ""

#. ja: 4～！
#. de: Vier!
#. fr: Quatre<nbsp>!
msgctxt "NpcYell:16417:0:13"
msgid "Four!"
msgstr ""

#. ja: 5～！
#. de: Fünf!
#. fr: Cinq<nbsp>!
msgctxt "NpcYell:16418:0:13"
msgid "Five!"
msgstr ""

#. ja: 6～！
#. de: Und sechs!
#. fr: Six<nbsp>!
msgctxt "NpcYell:16419:0:13"
msgid "Six!"
msgstr ""

#. ja: ここは我々にお任せを！
#. de: Überlasst uns das Gebiet hier!
#. fr: Nous couvrons vos arrières<nbsp>!
msgctxt "NpcYell:16420:0:13"
msgid "We will deal with this fiend!"
msgstr ""

#. ja: 先をお急ぎください！
#. de: Ihr werdet weiter hinten gebraucht! Beeilt Euch!
#. fr: Partez devant<nbsp>!
msgctxt "NpcYell:16421:0:13"
msgid "Forward! Forward!"
msgstr ""

#. ja: 英雄のために！
#. de: Für den Helden!
#. fr: Pour notre héros<nbsp>!
msgctxt "NpcYell:16422:0:13"
msgid "For Baron!"
msgstr ""

#. ja: 我々が引きつけます！
#. de: Wir lenken sie ab!
#. fr: Nous les retenons<nbsp>!
msgctxt "NpcYell:16423:0:13"
msgid "Leave this one to us!"
msgstr ""

#. ja: お供いたします！
#. de: Seite an Seite!
#. fr: Je vous accompagne<nbsp>!
msgctxt "NpcYell:16424:0:13"
msgid "Allow me to assist you!"
msgstr ""

#. ja: ともに行きましょう！
#. de: Lasst uns gemeinsam kämpfen!
#. fr: Je vous suis<nbsp>!
msgctxt "NpcYell:16425:0:13"
msgid "Let us press onward!"
msgstr ""

#. ja: 城へ急がねば！
#. de: Schnell! Auf zum Schloss!
#. fr: Vite, au château<nbsp>!
msgctxt "NpcYell:16426:0:13"
msgid "We must hurry to the castle!"
msgstr ""

#. ja: 美しかった街並みが…
#. de: Was haben sie nur mit unserer schönen Stadt gemacht<nbsp>...
#. fr: Notre ville... détruite...
msgctxt "NpcYell:16427:0:13"
msgid "The city is in ruins..."
msgstr ""

#. ja: 我らは先へ進むぞ！
#. de: Wir müssen weiter!
#. fr: Nous partons devant<nbsp>!
msgctxt "NpcYell:16428:0:13"
msgid "Onward!"
msgstr ""

#. ja: これほどの猛獣を<br>使役する相手か…
#. de: Dass sie solch Bestien befehligen würden<nbsp>...
#. fr: Ce sont des ennemis redoutables, capables de contrôler une telle créature...
msgctxt "NpcYell:16429:0:13"
msgid "I shudder to think what other horrors yet await us."
msgstr ""

#. ja: あとは頼んだぞ！
#. de: Der Rest sei euch überlassen!
#. fr: Tu as la situation en main ici<nbsp>!
msgctxt "NpcYell:16430:0:13"
msgid "I leave the rest to you."
msgstr ""

#. ja: 急ぐぞ、ゴルベーザ！
#. de: Schnell, Golbez! Beeilung!
#. fr: Dépêchons-nous, Golbez<nbsp>!
msgctxt "NpcYell:16431:0:13"
msgid "Hurry, Golbez!"
msgstr ""

#. ja: おいおい、どういうことだ？
#. de: W-Was passiert denn jetzt?!
#. fr: Eh<nbsp>! Qu'est-ce qui se passe<nbsp>!?
msgctxt "NpcYell:16432:0:13"
msgid "What in the seven hells!?"
msgstr ""

#. ja: あっしの身体に何が…！
#. de: Mein Körper<nbsp>... Fühlt sich seltsam an<nbsp>...!
#. fr: Je me suis... trrransformée<nbsp>!?
msgctxt "NpcYell:16433:0:13"
msgid "Wh-What's happened to my body?"
msgstr ""

#. ja: 姿が変わった！？<br>新手の魔法攻撃か！
#. de: Wir wurden verwandelt!? Solche Magie ist mir gänzlich unbekannt!
#. fr: Attention, on dirait qu'il prépare un nouveau type d'attaque magique<nbsp>!
msgctxt "NpcYell:16434:0:13"
msgid "Ye gods, what magick is this!?"
msgstr ""

#. ja: 術が解けたら反撃だ！
#. de: Wartet auf eure Rückverwandlung! Dann direkter Gegenangriff!
#. fr: On contre-attaque à la première occasion<nbsp>!
msgctxt "NpcYell:16435:0:13"
msgid "Grrr, just you wait!"
msgstr ""

#. ja: なんとも面妖な術を…！
#. de: Was für ein seltsamer Zauber<nbsp>...
#. fr: Quelle étrrrange technique...
msgctxt "NpcYell:16436:0:13"
msgid "A truly vexing spell..."
msgstr ""

#. ja: またか！<br>冗談じゃない！
#. de: Schon wieder? Langsam reicht es mir!
#. fr: Encore<nbsp>!? C'est une blague<nbsp>!?
msgctxt "NpcYell:16437:0:13"
msgid "Ugh, not again!"
msgstr ""

#. ja: 両者の動きから<br>目を離すな！
#. de: Behaltet beide genau im Auge!
#. fr: Ne les quittez pas des yeux<nbsp>!
msgctxt "NpcYell:16438:0:13"
msgid "Don't take your eyes off them!"
msgstr ""

#. ja: 嫌な予感がするわ<br>気をつけて！
#. de: Ich habe ein ganz schlechtes Gefühl. Bleibt auf der Hut!
#. fr: J'ai un mauvais pres<shy>sen<shy>ti<shy>ment... Restez vigilants<nbsp>!
msgctxt "NpcYell:16439:0:13"
msgid "This can't be good... Stay on guard!"
msgstr ""

#. ja: 見切ってみせる！
#. de: Wir werden hier nicht aufgeben!
#. fr: Tous mes sens sont en alerte<nbsp>!
msgctxt "NpcYell:16440:0:13"
msgid "You'll not find me an easy target!"
msgstr ""

#. ja: この気迫…<br>並みの攻撃ではないぞ！
#. de: Diese Aura<nbsp>... Vorsicht, der nächste scheint kein gewöhnlicher Angriff zu sein!
#. fr: Attention, la prochaine attaque risque d'être dévastatrice<nbsp>!
msgctxt "NpcYell:16441:0:13"
msgid "So they mean to play their trump card!"
msgstr ""

#. ja: やらせはしない…<br>畳み掛けましょう！
#. de: Damit kommt ihr nicht durch! Auf sie mit ganzer Kraft!
#. fr: On a pas le droit d'abandonner<nbsp>! Donnez tout ce que vous avez<nbsp>!
msgctxt "NpcYell:16442:0:13"
msgid "Throw everything you've got at them!"
msgstr ""

#. ja: 奥の手を仕掛けてくるか！
#. de: Haben sie etwa noch ein Ass im Ärmel?
#. fr: Préparez-vous à encaisser leur botte secrète<nbsp>!
msgctxt "NpcYell:16443:0:13"
msgid "We must finish this before they can!"
msgstr ""

#. ja: こちらは任せろ！
#. de: 0
#. fr: 0
msgctxt "NpcYell:16444:0:13"
msgid "0"
msgstr ""

#. ja: こいつ…<br>急に暴れやがって！
#. de: Verdammt<nbsp>... Er rastet völlig aus!
#. fr: Fichu piaf... Il s'est énervé d'un coup !
msgctxt "NpcYell:16445:0:13"
msgid "What's gotten into this thing!?"
msgstr ""

#. ja: 翼を狙って<br>おとなしくさせるんだ！
#. de: Wir müssen dafür sorgen, dass er sich beruhigt! Zielt auf seine Flügel!
#. fr: Visez ses ailes, ça le calmerrra un moment !
msgctxt "NpcYell:16446:0:13"
msgid "Try aiming for its wings!"
msgstr ""

#. ja: 油断ならないだす…
#. de: Immer schön achtsam bleiben!
#. fr: Il faut rester sur nos gardes<nbsp>!
msgctxt "NpcYell:16447:0:13"
msgid "One step at a time..."
msgstr ""

#. ja: せっかく宝箱のなかに<br>いろいろ詰め込んでおいたのに！
#. de: Ich hab so viele schöne Dinge hineingepackt!
#. fr: Dommage... Dire que j'avais rempli ces coffres avec un tas de surprises...<nbsp>!
msgctxt "NpcYell:16448:0:13"
msgid "Oh, you ruined it! I'd packed the chests full of goodies, too!"
msgstr ""

#. ja: ま、まさか…<br>飛び降りるだすか？
#. de: M-Müssen wir springen?
#. fr: T-tu... ne comptes pas sauter<nbsp>? Si<nbsp>?
msgctxt "NpcYell:16449:0:13"
msgid "You aren't going to jump...are you?"
msgstr ""

#. ja: こ、こわ…<br>怖くないだすーっ！
#. de: Ich hab keine Angst, ich hab keine Angst!
#. fr: Allez, mon vieux... Ne regarde pas en bas<nbsp>!
msgctxt "NpcYell:16450:0:13"
msgid "I can do this! I can!"
msgstr ""

#. ja: ここは<br>恐ろしい島だす…
#. de: Diese Insel ist gruselig<nbsp>...
#. fr: Cette île n'est vraiment pas de tout repos...
msgctxt "NpcYell:16451:0:13"
msgid "Every twist and turn brings us face-to-face with a new threat..."
msgstr ""

#. ja: よーし<br>釣ってみるだす！
#. de: Also dann, ran ans Angeln!
#. fr: Bien<nbsp>! Une petite pause pêche ne serait pas de refus<nbsp>!
msgctxt "NpcYell:16452:0:13"
msgid "Finally, a chance to fish!"
msgstr ""

#. ja: 本当に<br>大丈夫だすか…？
#. de: Oje oje<nbsp>...
#. fr: Tout va bien, <split " " 1><string $gs1></split><nbsp>?
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:16453:0:13"
msgid "Do you think she's telling the truth, <split \" \" 1><string $gs1></split>?"
msgstr ""

#. ja: これを見てほしいだす！
#. de: Schau nur!
#. fr: Ohé<nbsp>! Regarde-moi ça<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:16454:0:13"
msgid "Look at this, <split \" \" 1><string $gs1></split>!"
msgstr ""

#. ja: わっ…！？<br>この魚は…！
#. de: D-Dieser Fisch<nbsp>...!
#. fr: Hein<nbsp>? C'est quoi, ce poisson<nbsp>?
msgctxt "NpcYell:16455:0:13"
msgid "Huh!? What is this fish?"
msgstr ""

#. ja: このくらいの流木なら<br>触れば崩れるかも…？
#. de: Das Meer hat diesem Treibholz ordentlich zugesetzt.
#. fr: Le bois m'a l'air en triste état. Un simple coup et il risque de tomber en morceaux.
msgctxt "NpcYell:16456:0:13"
msgid "The slightest touch should be enough to clear it..."
msgstr ""

#. ja: 風化して脆くなってたみたい…<br>これで進めそうだす！
#. de: Glück gehabt, es war wohl schon morsch!
#. fr: Le vent n'arrange rien... mais on devrait pouvoir passer<nbsp>!
msgctxt "NpcYell:16457:0:13"
msgid "The wind made it brittle for us. Now we can pass through!"
msgstr ""

#. ja: 中庭で落ち合おう<br>俺は裏門の方から！
#. de: Wir treffen uns im Schlossgarten! Ich gehe hinten rum!
#. fr: On se retrouve dans la cour, je prends un chemin détourné<nbsp>!
msgctxt "NpcYell:16458:0:13"
msgid "Let us reconvene at the castle garden."
msgstr ""

#. ja: 危ないところへ<br>出ませんように…！
#. de: Hoffentlich führt uns das nicht an einen garstigen Ort.
#. fr: J'espère qu'on évitera le pire en passant par là...
msgctxt "NpcYell:16459:0:13"
msgid "Let's hope the divinities of Aloalo guide us true."
msgstr ""

#. ja: このくらいなら<br>もう大丈夫だす！
#. de: Alles gut. Alles ist gut.
#. fr: Si ce n'est que ça, je peux m'en tirer<nbsp>!
msgctxt "NpcYell:16460:0:13"
msgid "Nothing for it but to keep going!"
msgstr ""

#. ja: わっ…！<br>霧を抜けられただす！
#. de: Der Nebel hat sich endlich gelichtet!
#. fr: Ah<nbsp>! Le brouillard s'est enfin dissipé<nbsp>!
msgctxt "NpcYell:16461:0:13"
msgid "We made it through the mist!"
msgstr ""

#. ja: あわわっ！<br>う、動き出したぁ～！
#. de: E-Es hat sich bewegt!
#. fr: Q-q-q-quoiii<nbsp>!? Il bouge<nbsp>!
msgctxt "NpcYell:16462:0:13"
msgid "What!? It moved!"
msgstr ""

#. ja: これは嫌な予感…<br>とんずらしちゃお～っと！
#. de: Ich habe gar kein gutes Gefühl dabei!
#. fr: Je la sens mal... Mieux vaut filer en douce<nbsp>!
msgctxt "NpcYell:16463:0:13"
msgid "Didn't expect that. Well, no point in sticking around!"
msgstr ""

#. ja: うわぁぁーーっ！
#. de: Uaaaah!
#. fr: Ouaaargh<nbsp>!
msgctxt "NpcYell:16464:0:13"
msgid "Yaaaaaahhh!"
msgstr ""

#. ja: どこまで続くのか<br>ヒヤヒヤしただす…
#. de: Wie weit das wohl führt?
#. fr: C'est pas encore fini<nbsp>!?
msgctxt "NpcYell:16465:0:13"
msgid "I almost fainted... Where are we?"
msgstr ""

#. ja: こんな場所にも<br>魔物が…！
#. de: Selbst hier gibt es Biester!
#. fr: Évidemment... Encore des monstres<nbsp>!
msgctxt "NpcYell:16466:0:13"
msgid "Everywhere we go, beasts are waiting for us!"
msgstr ""

#. ja: この島のイモムシは<br>とにかく不気味だす…
#. de: Auf dieser Insel sind alle Raupen schaurig, oder?
#. fr: Les bestioles rampantes de cette île me filent la chair de poule<nbsp>!
msgctxt "NpcYell:16467:0:13"
msgid "These caterpillars are blood-curdling..."
msgstr ""

#. ja: 木像が急に動き出すから<br>びっくりしただす
#. de: Ich habe nicht erwartet, dass uns diese Statuen plötzlich anspringen.
#. fr: Les statues se sont mises à bouger<nbsp>! J'ai cru que mon cœur allait s'arrêter<nbsp>!
msgctxt "NpcYell:16468:0:13"
msgid "It's quicker than it looks!"
msgstr ""

#. ja: むむ～ん<br>コレ、なんだろぉ～？
#. de: Hm? Was ist das?
#. fr: Hé hé... Tiens, qu'est-ce que c'est<nbsp>?
msgctxt "NpcYell:16469:0:13"
msgid "Hehe. Now this could be interesting."
msgstr ""

#. ja: お宝のことも気になるけど<br>オラは魚一筋だす！
#. de: Wir sind wegen Fischen hier, nicht wegen irgendwelchen Schätzen.
#. fr: Les coffres au trésor m'intéressent, évidemment. Mais je suis là pour la pêche avant tout<nbsp>!
msgctxt "NpcYell:16470:0:13"
msgid "I won't say no to treasure, but what I'm really here for is the fish!"
msgstr ""

#. ja: ゴルベーザの領域…<br>突破してみせる！
#. de: Dies ist also Golbez' Domäne<nbsp>... Auch sie werden wir bewältigen!
#. fr: Ce n'est pas le domaine de Golbez qui va nous arrêter<nbsp>!
msgctxt "NpcYell:16471:0:13"
msgid "Golbez's domain, at long last..."
msgstr ""

#. ja: やはり妖異がいたか<br>油断するな
#. de: Nichtswesen! Gebt Acht!!
#. fr: Attention, des créatures du néant nous attendent de pied ferme.
msgctxt "NpcYell:16472:0:13"
msgid "So there are voidsent after all. Have care."
msgstr ""

#. ja: 以前とは<br>まるで様子が違うわね
#. de: Es sieht völlig anders aus als zuvor<nbsp>...
#. fr: Tout a changé depuis notre dernière visite...
msgctxt "NpcYell:16473:0:13"
msgid "This place is not at all as I remember it..."
msgstr ""

#. ja: 領域を作り変えたか…！
#. de: Hat er seine Domäne etwa verändert<nbsp>...?
#. fr: Il a modifié son domaine pour nous barrer la route<nbsp>!
msgctxt "NpcYell:16474:0:13"
msgid "He's altered his domain, then?"
msgstr ""

#. ja: ゼロムスの気配は<br>もっと奥底の方だ
#. de: Ich spüre ihn weiter hinten<nbsp>... Zeromus<nbsp>...!
#. fr: La présence de Zeromus est encore loin devant nous.
msgctxt "NpcYell:16475:0:13"
msgid "I can sense its presence deep within... Zeromus is here."
msgstr ""

#. ja: 雑魚が復活する前に<br>先へ進むぞ
#. de: Dann los! Bevor die Biester richtig munter werden!
#. fr: Continuons avant que le menu fretin se régénère<nbsp>!
msgctxt "NpcYell:16476:0:13"
msgid "Let's move on, before they have time to regroup."
msgstr ""

#. ja: 転移魔法ね
#. de: Teleportationsmagie<nbsp>...
#. fr: Un sort de déplacement ru<shy>di<shy>men<shy>taire.
msgctxt "NpcYell:16477:0:13"
msgid "Teleportation magick. Interesting..."
msgstr ""

#. ja: たったひとり相手に<br>負けはしない！
#. de: Vier gegen einen! Wir dürfen nicht verlieren!
#. fr: Nous avons l'avantage du nombre<nbsp>!
msgctxt "NpcYell:16478:0:13"
msgid "Is this all Golbez can muster to bar our path?"
msgstr ""

#. ja: まだこんなヤツが<br>残っていたとはな
#. de: Da ist noch immer ein Viech übrig<nbsp>...
#. fr: Golbez avait gardé un atout majeur dans sa manche...
msgctxt "NpcYell:16479:0:13"
msgid "I didn't expect such a beast to yet remain."
msgstr ""

#. ja: まだこんなヤツがいたか
#. de: Da ist noch ein Viech übrig<nbsp>...
#. fr: Golbez avait gardé un atout majeur dans sa manche...
msgctxt "NpcYell:16480:0:13"
msgid "A formidable foe..."
msgstr ""

#. ja: 四天王には及ぶまい<br>蹴散らそう
#. de: Kein Vergleich mit den Fürsten! Machen wir kurzen Prozess mit ihm!
#. fr: Ce n'est rien comparé aux quatre généraux<nbsp>!
msgctxt "NpcYell:16481:0:13"
msgid "Even so, it pales before the archfiends."
msgstr ""

#. ja: 杖を消すとは…<br>厄介なことを
#. de: Die Stäbe einfach verschwinden zu lassen<nbsp>... Nicht schlecht.
#. fr: Quand les cannes ont disparu, je ne savais plus où aller...
msgctxt "NpcYell:16482:0:13"
msgid "The vanishing scepters were quite the nuisance."
msgstr ""

#. ja: 口ほどにも<br>なかったな
#. de: Da hatte einer aber eine ganz schön große Klappe.
#. fr: C'était pas si compliqué<nbsp>!
msgctxt "NpcYell:16483:0:13"
msgid "That was easy enough."
msgstr ""

#. ja: 小細工に頼る前に<br>もっと腕を磨くことね
#. de: Anstatt sich auf nutzlose Tricks und Spielereien zu verlassen, hätte er besser mal an seinen Zauberkünsten gefeilt.
#. fr: La ruse ne saurait remplacer la maîtrise...
msgctxt "NpcYell:16484:0:13"
msgid "As if cheap parlor tricks would suffice to stop us."
msgstr ""

#. ja: あら、私の目には<br>ずっと視えていたわ
#. de: Meinst du? Ich konnte sie die ganze Zeit über glasklar sehen<nbsp>...
#. fr: Ah bon<nbsp>? Pour moi c'était un jeu d'enfant<nbsp>!
msgctxt "NpcYell:16485:0:13"
msgid "Vanished, you say? I thought they were merely bluffing."
msgstr ""

#. ja: 地表で見つけた<br>メモリアか！
#. de: Diese Memoria<nbsp>...
#. fr: J'ai déjà vu ce mémoria quelque part<nbsp>!
msgctxt "NpcYell:16486:0:13"
msgid "A memoria crystal!?"
msgstr ""

#. ja: このメモリアは<br>例の二人組の…！？
#. de: Diese Memoria<nbsp>... Nein, das kann nicht sein<nbsp>...
#. fr: Si je ne m'abuse, ce mémoria appartenait à un duo de manieurs...
msgctxt "NpcYell:16487:0:13"
msgid "This memoria crystal is... No, it can't be..."
msgstr ""

#. ja: 何が起きている…！？
#. de: Was passiert denn nun schon wieder?
#. fr: Qu'est-ce qu'il se passe<nbsp>!?
msgctxt "NpcYell:16488:0:13"
msgid "What's happening!?"
msgstr ""

#. ja: この男…君のことを<br>ゴルベーザと呼んだな
#. de: Dieser Recke<nbsp>... Er hat dich gerade klar und deutlich „Golbez“ genannt!
#. fr: Ne vient-il pas de t'appeler “Golbez”<nbsp>!?
msgctxt "NpcYell:16489:0:13"
msgid "Did that man just call you...Golbez?"
msgstr ""

#. ja: この男は、私が<br>あのとき出会った…
#. de: Ich kenne ihn<nbsp>... Er war es, der mich<nbsp>...
#. fr: Je connais cet homme, nous nous sommes rencontrés autrefois...
msgctxt "NpcYell:16490:0:13"
msgid "I've met this man somewhere before..."
msgstr ""

#. ja: 相棒のことを<br>ゴルベーザと呼んだ…？
#. de: Hat er dich gerade wirklich „Golbez“ genannt!?
#. fr: Hé, camarade, tu t'appelles “Golbez” maintenant<nbsp>?
msgctxt "NpcYell:16491:0:13"
msgid "This man seems to think you're Golbez."
msgstr ""

#. ja: メモリアの記憶を<br>追体験しているようね
#. de: Die Erinnerungen des Memoria-Kristalls<nbsp>... Wir durchleben sie.
#. fr: Nous revivons les souvenirs contenus dans le mémoria.
msgctxt "NpcYell:16492:0:13"
msgid "'Twould seem we've become part of the memory."
msgstr ""

#. ja: 彼らには、あなたが<br>ゴルベーザに視えている…？
#. de: Die Leute hier scheinen dich als Golbez wahrzunehmen<nbsp>...
#. fr: Il semblerait qu'ils te voient sous les traits de Golbez...
msgctxt "NpcYell:16493:0:13"
msgid "Whoever this man is, he seems convinced you're Golbez."
msgstr ""

#. ja: 英雄の帰還が<br>遅れたばかりに…
#. de: Wenn die Helden sich doch bloß nicht verspätet hätten<nbsp>...
#. fr: Le retard du héros a eu de graves con<shy>sé<shy>quen<shy>ces...
msgctxt "NpcYell:16494:0:13"
msgid "They were too late to save their home, then..."
msgstr ""

#. ja: ここは彼らの故郷<br>バロン王国らしい
#. de: Dies ist ihre Heimat<nbsp>... Baron!
#. fr: C'est le royaume de Baron, leur patrie.
msgctxt "NpcYell:16495:0:13"
msgid "So this is the kingdom of Baron."
msgstr ""

#. ja: 過去の記憶とはいえ<br>見ていられんな
#. de: Selbst als bloße Erinnerung sind diese Szenen nur schwer zu ertragen.
#. fr: Souvenirs ou pas, c'est pas beau à voir...
msgctxt "NpcYell:16496:0:13"
msgid "Even if this is only a memory, it is no less easy to bear and watch."
msgstr ""

#. ja: 記憶から抜け出すには<br>戦うしかなさそうだ
#. de: Uns bleibt wohl nicht anderes übrig, als uns durch die Erinnerung zu kämpfen!
#. fr: Pour l'instant, nous n'avons d'autre choix que de combattre...
msgctxt "NpcYell:16497:0:13"
msgid "If we're to escape, it seems we've no choice but to fight."
msgstr ""

#. ja: 厄介そうな牙だ<br>いや、角か…？
#. de: Das Viech hat ganz schön kräftige Hauer<nbsp>- oder sind es Hörner?
#. fr: À ton avis, c'est des griffes ou des cornes<nbsp>?
msgctxt "NpcYell:16498:0:13"
msgid "Are those fangs...or horns?"
msgstr ""

#. ja: 第十三世界の<br>アントリオンね
#. de: Im dreizehnten Splitter gibt es also auch Ameisenlöwen!
#. fr: Un spécimen de fourmilion du treizième reflet.
msgctxt "NpcYell:16499:0:13"
msgid "So this is an antlion of the Thirteenth."
msgstr ""

#. ja: 彼の後を<br>追うとしよう
#. de: Am besten, wir folgen ihm!
#. fr: Suivons-le.
msgctxt "NpcYell:16500:0:13"
msgid "We should follow after him."
msgstr ""

#. ja: この記憶…<br>どこまで続くんだ？
#. de: Wie lange geht diese Erinnerung wohl noch<nbsp>...?
#. fr: Combien de temps allons-nous encore rester prisonniers de ces souvenirs<nbsp>?
msgctxt "NpcYell:16501:0:13"
msgid "Is there no end to this memory?"
msgstr ""

#. ja: 直線的な動きは<br>読みやすい…
#. de: Die Angriffe waren ein bisschen zu einfach zu lesen für meinen Geschmack<nbsp>...
#. fr: Il ne faisait qu'avancer en ligne droite, c'était pas sorcier<nbsp>!
msgctxt "NpcYell:16502:0:13"
msgid "For a mercy, its movements were easy to read."
msgstr ""

#. ja: 美しい城で<br>あったろうに…
#. de: Welch eine Schande, ein so prachtvolles Schloss in solch einem Zustand sehen zu müssen!
#. fr: Un si beau château, quel gâchis...
msgctxt "NpcYell:16503:0:13"
msgid "I'm sure this was a beautiful castle once..."
msgstr ""

#. ja: 当時、こうした惨状は<br>珍しいものじゃなかった
#. de: Damals waren Tragödien wie diese keine Seltenheit<nbsp>...
#. fr: En ces temps troublés, de tels ravages étaient monnaie courante...
msgctxt "NpcYell:16504:0:13"
msgid "Such tragedy was commonplace during the Contramemoria..."
msgstr ""

#. ja: 襲撃の首謀者を<br>叩かなくては…！
#. de: Wir müssen den Drahtzieher hinter dieser Invasion finden und zur Rechenschaft ziehen!
#. fr: Nous devons arrêter l'instigateur de cette attaque malveillante<nbsp>!
msgctxt "NpcYell:16505:0:13"
msgid "Who could be behind all this?"
msgstr ""

#. ja: ヒト同士が<br>こんな陰惨な争いを…
#. de: Dass Sterbliche es vermögen, sich auf solch schreckliche Weise zu bekämpfen<nbsp>...
#. fr: Pourquoi les humains s'entretuent-ils toujours de la sorte...<nbsp>?
msgctxt "NpcYell:16506:0:13"
msgid "Such carnage. Such cruelty. This is..."
msgstr ""

#. ja: これがメモリア戦争だ
#. de: Das ist die grausame Realität des Memoriakrieges.
#. fr: Vous savez maintenant à quoi ressemblait la guerre des mémorias...
msgctxt "NpcYell:16507:0:13"
msgid "The Contramemoria..."
msgstr ""

#. ja: 我々は<br>反対側を進もう！
#. de: Wir nehmen die andere Seite.
#. fr: Partons donc de ce côté<nbsp>!
msgctxt "NpcYell:16508:0:13"
msgid "We must find a way across."
msgstr ""

#. ja: 彼らは互いを<br>信頼していたんだな…
#. de: Die beiden haben sich gegenseitig zutiefst vertraut<nbsp>...
#. fr: Ils se vouaient une confiance mutuelle...
msgctxt "NpcYell:16509:0:13"
msgid "That he should place such faith in Golbez..."
msgstr ""

#. ja: 向こうは<br>彼に任せましょう！
#. de: Überlassen wir die Seite ihm!
#. fr: Laissons-le se charger de cette aile du château<nbsp>!
msgctxt "NpcYell:16510:0:13"
msgid "Let us leave the other side to him."
msgstr ""

#. ja: なら、その信頼に<br>応えなくては
#. de: Dann lasst uns mit der gleichen Menge an Vertrauen antworten!
#. fr: Conformément aux souvenirs, jouons le jeu.
msgctxt "NpcYell:16511:0:13"
msgid "In any case, it would be rude of us not to respond in kind."
msgstr ""

#. ja: 終末の如き悪夢を<br>人為的に引き起こすとは…！
#. de: Das ist wie in den letzten Tagen<nbsp>... Wie können sie nur?!
#. fr: J'ai l'impression de revivre l'apocalypse, mais orchestrée par des humains cette fois<nbsp>!
msgctxt "NpcYell:16512:0:13"
msgid "They've all but brought the Final Days upon themselves."
msgstr ""

#. ja: 人を妖異に<br>変えたのか…！
#. de: Eine Ver<shy>wand<shy>lung in ein Nichtswesen?!
#. fr: Quelle ordure... Il les a transformés en créatures<nbsp>!
msgctxt "NpcYell:16513:0:13"
msgid "They've been turned into monsters!"
msgstr ""

#. ja: こうなってしまっては<br>もう元には…
#. de: Es ist zu spät<nbsp>... Wir haben keine andere Wahl, als<nbsp>...
#. fr: Impossible de leur rendre leur forme originelle...
msgctxt "NpcYell:16514:0:13"
msgid "An irreversible transformation..."
msgstr ""

#. ja: なんという気迫だ…！
#. de: Welch eine Präsenz!
#. fr: Quelle détermination farouche<nbsp>!
msgctxt "NpcYell:16515:0:13"
msgid "Such terrible strength..."
msgstr ""

#. ja: 友を止めるため<br>自ら闇に堕ちたのか
#. de: Um seinen Freund zu stoppen, hat er sich also freiwillig der Dunkelheit hingegeben<nbsp>...
#. fr: Pour arrêter son compagnon, il s'est lui aussi offert aux Ténèbres...
msgctxt "NpcYell:16516:0:13"
msgid "He gave himself to the Dark to stop Golbez..."
msgstr ""

#. ja: 構えろ！<br>向かってくるぞ！
#. de: Mach dich bereit! Da kommt schon der nächste Angriff!
#. fr: En garde<nbsp>! Il va attaquer<nbsp>!
msgctxt "NpcYell:16517:0:13"
msgid "On your guard!"
msgstr ""

#. ja: やるしか<br>なさそうね…！
#. de: Da müssen wir wohl durch!
#. fr: Nous n'avons pas d'autre choix que de combattre...
msgctxt "NpcYell:16518:0:13"
msgid "It seems we've no choice but to fight..."
msgstr ""

#. ja: こちらもゴルベーザを…<br>いや、君を失うわけには！
#. de: Auch wir können es uns nicht leisten, Golb<nbsp>... ich meine <i>Dich</i><nbsp>... zu verlieren!
#. fr: Même sous les traits de Golbez, tu ne dois pas tomber ici<nbsp>!
msgctxt "NpcYell:16519:0:13"
msgid "And yet it falls to us to keep him─or rather, you─from harm."
msgstr ""

#. ja: 泡の玉をいっぱい出せ！
#. de: Eine Blase nach der anderen!
#. fr: Des bulles<nbsp>! Encore des bulles<nbsp>!
msgctxt "NpcYell:16520:0:13"
msgid "Fill their lungs with water!"
msgstr ""

#. ja: やっちまえーっ！
#. de: Auf geht's!
#. fr: Immobilise-les<nbsp>!
msgctxt "NpcYell:16521:0:13"
msgid "Drown them and be done with it!"
msgstr ""

#. ja: もう嫌がらせは<br>やめてほしいだす…
#. de: Ah, ich mag nicht mehr<nbsp>...
#. fr: J'en ai assez de toutes ces provocations<nbsp>!
msgctxt "NpcYell:16522:0:13"
msgid "I can't take any more of his pestering."
msgstr ""

#. ja: 巨大な像が<br>飛び出してきただす！
#. de: D-Die Statue<nbsp>...! Kommt sie einfach auf uns zu!
#. fr: La statue<nbsp>! Elle a sauté depuis le tronc, tu as vu ça<nbsp>?
msgctxt "NpcYell:16523:0:13"
msgid "How could something so large move so quickly!?"
msgstr ""

#. ja: 像が元に戻っただす…
#. de: Jetzt hat sie sich beruhigt.
#. fr: 0
msgctxt "NpcYell:16524:0:13"
msgid "0"
msgstr ""

#. ja: うおぉぉぉぉ！
#. de: Ouuuaaarrrgh!
#. fr: UOOOOOH<nbsp>!!!
msgctxt "NpcYell:16525:0:13"
msgid "Enough!"
msgstr ""

#. ja: 困ったヒトだす…
#. de: Was für ein Schlamassel<nbsp>...
#. fr: Qu'ils sont pénibles...
msgctxt "NpcYell:16526:0:13"
msgid "I try to only speak kindly of others, but they test me..."
msgstr ""

#. ja: 困ったヒトだす…
#. de: Was für ein Schlamassel<nbsp>...
#. fr: Qu'ils sont pénibles...
msgctxt "NpcYell:16527:0:13"
msgid "I try to only speak kindly of others, but they test me..."
msgstr ""

#. ja: レギュレーターがこんなに…<br>それだけ犠牲者が…
#. de: So viele Regulatoren<nbsp>... Und jeder von ihnen gehörte mal jemandem<nbsp>...
#. fr: Tous ces régulateurs, et presque encore davantage de victimes...
msgctxt "NpcYell:16528:0:13"
msgid "So many regulators... They all used to belong to someone..."
msgstr ""

#. ja: なんとも雑な<br>カモフラージュだね…
#. de: Glauben die etwa ernsthaft, das bisschen Tarnung würde uns aufhalten?
#. fr: Ce camouflage n'est pas tout à fait au point...
msgctxt "NpcYell:16529:0:13"
msgid "Not the best camouflage, now is it?"
msgstr ""

#. ja: アハハ、正面突破は<br>侵入者の特権ってわけかい！
#. de: Wahaha! So schnell kriegen die uns nicht!
#. fr: Hé hé, seuls les intrus peuvent se permettre d'entrer sans permission<nbsp>!
msgctxt "NpcYell:16530:0:13"
msgid "Ahaha, so only intruders can bust in through the front!"
msgstr ""

#. ja: 浮行装置が起動した<br>これで上に行けるよ
#. de: Die Schwebeplattform ist angesprungen! Damit kommen wir nach oben!
#. fr: La plateforme s'est activée<nbsp>! Allez, on monte<nbsp>!
msgctxt "NpcYell:16531:0:13"
msgid "The conveyor's been activated. We can continue up."
msgstr ""

#. ja: まんまと誘い込まれた…？<br>やるしかないようだね！
#. de: Da haben sie uns wohl in die Falle gelockt<nbsp>... 
#. fr: On est tombés dans un piège<nbsp>? Pas pour longtemps<nbsp>!
msgctxt "NpcYell:16532:0:13"
msgid "Looks like they knew we were coming..."
msgstr ""

#. ja: 乗り心地は悪そうだが…<br>贅沢は言えないね
#. de: Gemütlich ist anders<nbsp>... Aber was bleibt uns schon übrig, hm?
#. fr: Ça n'a pas l'air très confortable...
msgctxt "NpcYell:16533:0:13"
msgid "This won't be comfortable, but intruders can't be choosers."
msgstr ""

#. ja: これ以上は辿れそうにないね…<br>とりあえず奥へ進んでみよう
#. de: Weiter geht's wohl nicht. Vielleicht ja weiter hinten?
#. fr: On ne pourra pas aller plus haut... En avant toute<nbsp>!
msgctxt "NpcYell:16534:0:13"
msgid "They're headed up...but where do we go from here?"
msgstr ""

#. ja: なんだ、ここは…<br>研究施設にも見えるが…
#. de: Ist das etwa<nbsp>... ein Labor?!
#. fr: Mais où est-ce qu'on est...<nbsp>? Un laboratoire de recherche<nbsp>?
msgctxt "NpcYell:16535:0:13"
msgid "This has the look of a research laboratory..."
msgstr ""

#. ja: 静かすぎる…<br>嫌な予感がするね
#. de: Es ist so ruhig<nbsp>... <i>Zu</i> ruhig!
#. fr: C'est beaucoup trop calme... Je n'aime pas ça du tout...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:16536:0:13"
msgid "It's quiet. <i>Too</i> quiet..."
msgstr ""

#. ja: スフェーン様～！
#. de: Prinzessin Sphene!
#. fr: Princesse Sphene<nbsp>!
msgctxt "NpcYell:16538:0:13"
msgid "Princess Sphene!"
msgstr ""

#. ja: 僕もいつか<br>王女様を護る騎士になる！
#. de: Irgendwann werde ich auch ein königlicher Ritter werden!
#. fr: Je deviendrai chevalier pour protéger la princesse<nbsp>!
msgctxt "NpcYell:16539:0:13"
msgid "I'm going to become a knight and protect the princess!"
msgstr ""

#. ja: 「永遠の務め」…<br>彼女のモットーは素晴らしいわ
#. de: „Für das Volk, in Ewigkeit“ ist ihre Devise. Wie wundervoll!
#. fr: “Éternel devoir”... Elle prend sa devise très à cœur.
msgctxt "NpcYell:16540:0:13"
msgid "“Service Eternal”... She truly lives by her words."
msgstr ""

#. ja: 私たちも<br>殿下の力にならないと…
#. de: Auch wir müssen dem Königshaus unsere volle Unterstützung zu<shy>teil<shy>werden lassen!
#. fr: Nous ferons tout pour notre royaume.
msgctxt "NpcYell:16541:0:13"
msgid "We all of us must do our part for the kingdom."
msgstr ""

#. ja: スフェーン様<br>どうかご自愛を…
#. de: Bitte bleibt gesund, Eure Hoheit ...
#. fr: Sa Majesté Sphene, puissiez-vous trouver le bonheur...
msgctxt "NpcYell:16542:0:13"
msgid "Blessings be upon you, Your Highness!"
msgstr ""

#. ja: 民のため励む御姿に<br>勇気づけられるな…
#. de: Ihre Nähe zum Volk ist schon etwas ganz Besonderes.
#. fr: La présence de Sa Majesté nous donne tant de courage...
msgctxt "NpcYell:16543:0:13"
msgid "It's so uplifting just to see and hear Her Highness."
msgstr ""

#. ja: 王女殿下に祝福あれ！
#. de: Gesegnet sei Ihre Königliche Hoheit!
#. fr: Longue vie à la princesse Sphene<nbsp>!
msgctxt "NpcYell:16544:0:13"
msgid "Long live Princess Sphene!"
msgstr ""

#. ja: 公務も忙しいだろうに<br>ありがたいことだ…
#. de: Dabei müssen ihre Pflichten sie doch sicherlich auf Trab halten ... Ihre Fürsorge kennt keine Grenzen!
#. fr: Malgré ses devoirs royaux, elle est si proche de nous...
msgctxt "NpcYell:16545:0:13"
msgid "Even with all her duties, she makes time for us."
msgstr ""

#. ja: 受けてみろ！
#. de: Nimm dies!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:16546:0:13"
msgid "I'm going to enjoy this!"
msgstr ""

#. ja: う、動けない…！
#. de: I-Ich kann mich nicht bewegen<nbsp>...!
#. fr: Je suis prise au piège<nbsp>!
msgctxt "NpcYell:16547:0:13"
msgid "Ugh! I can't move!"
msgstr ""

#. ja: 助かったよ！
#. de: Danke!
#. fr: Ouf<nbsp>! Tu m'as sauvée<nbsp>!
msgctxt "NpcYell:16548:0:13"
msgid "You're a lifesaver!"
msgstr ""

#. ja: な、なんて威力なんだ…
#. de: Welch eine Macht ...
#. fr: Quelle puissance...
msgctxt "NpcYell:16549:0:13"
msgid "Such power..."
msgstr ""

#. ja: 炎の刃よ<br>降り注ぎなさい
#. de: Feurige Klinge, stürze hernieder.
#. fr: Ô flammes, imprégnez nos épées.
msgctxt "NpcYell:16550:0:13"
msgid "Blades of fire rain."
msgstr ""

#. ja: さあ行きなさい
#. de: Dann auf, nach vorn!
#. fr: Maintenant, tranchez et brûlez !
msgctxt "NpcYell:16551:0:13"
msgid "Go forth!"
msgstr ""

#. ja: 指図するんじゃねぇよ
#. de: Kommandier mich nicht rum!
#. fr: Ne me dis pas ce que je dois faire, ja !
msgctxt "NpcYell:16552:0:13"
msgid "Heh. Overbearing bastard."
msgstr ""

#. ja: ヴァリガルマンダの鱗すら<br>切り裂いた剣技だ！！
#. de: Spürt die Klinge, die selbst Valigarmandas Schuppen durchbohrte!
#. fr: Nos lames ont déjà percé les écailles de Valigarmanda !
msgctxt "NpcYell:16553:0:13"
msgid "These blades sundered Valigarmanda's scales!"
msgstr ""

#. ja: コーナ王子<br>これを！
#. de: Prinz Koana, lass mich helfen!
#. fr: Je vais vous protéger, Prince !
msgctxt "NpcYell:16554:0:13"
msgid "Promise!"
msgstr ""

#. ja: みんな<br>これで耐えて！
#. de: Hier, das sollte helfen!
#. fr: Tenez bon, les amis !
msgctxt "NpcYell:16555:0:13"
msgid "We'll get through this!"
msgstr ""

#. ja: な、なんだ！？<br>炎で身動きが…！
#. de: Gah, ich kann mich nicht bewegen!
#. fr: Q-quoi !? Les flammes m'empêchent de bouger... !
msgctxt "NpcYell:16559:0:13"
msgid "Huh!? I-I can't move!"
msgstr ""

#. ja: くっ…！<br>理の父上の魔法か！
#. de: Verdammt, diese Flammen<nbsp>...
#. fr: Argh... C'est l'œuvre de l'Aurarque de la Raison !
msgctxt "NpcYell:16560:0:13"
msgid "These flames..."
msgstr ""

#. ja: ありがとな！<br>頼りになるぜ…！
#. de: Danke, das hat geholfen!
#. fr: Merci, je te revaudrai ça !
msgctxt "NpcYell:16561:0:13"
msgid "Thanks! I owe you one."
msgstr ""

#. ja: 縛めが解けた…！<br>感謝しますよ
#. de: Ich danke dir,
#. fr: L'entrave s'est dissipée ! Tu as toute ma gratitude.
msgctxt "NpcYell:16562:0:13"
msgid "You have my thanks."
msgstr ""

#. ja: ぐうっ…！
#. de: Gah!
#. fr: Ugh...
msgctxt "NpcYell:16563:0:13"
msgid "Ugh!"
msgstr ""

#. ja: ぐはっ…！
#. de: Argh!
#. fr: Ourgh... !
msgctxt "NpcYell:16564:0:13"
msgid "Argh!"
msgstr ""

#. ja: そらそら！
#. de: Kommt schon!
#. fr: Raah !
msgctxt "NpcYell:16565:0:13"
msgid "Take that!"
msgstr ""

#. ja: グハハハハハ！
#. de: Guahahaha!
#. fr: Guhahahaha !
msgctxt "NpcYell:16566:0:13"
msgid "Gahahahaha!"
msgstr ""

#. ja: やれやれ…
#. de: Nun gut.
#. fr: Décidément...
msgctxt "NpcYell:16567:0:13"
msgid "What a chore..."
msgstr ""

#. ja: 支えてみせるさ…！
#. de: Schön durchhalten!
#. fr: Je suis là<nbsp>!
msgctxt "NpcYell:16571:0:13"
msgid "I have your back."
msgstr ""

#. ja: 策を講じます
#. de: Zeit für Plan B.
#. fr: Établissons un plan.
msgctxt "NpcYell:16572:0:13"
msgid "Perhaps this will help."
msgstr ""

#. ja: 援護する！
#. de: Schutzmagie!
#. fr: Besoin d'un coup de main<nbsp>?
msgctxt "NpcYell:16573:0:13"
msgid "You're not alone!"
msgstr ""

#. ja: 支援いたします
#. de: Lass mich dir helfen!
#. fr: Je suis avec vous.
msgctxt "NpcYell:16574:0:13"
msgid "I shall assist thee."
msgstr ""

#. ja: ぐっ
#. de: Hrng!
#. fr: Ugh... !
msgctxt "NpcYell:16579:0:13"
msgid "Tch!"
msgstr ""

#. ja: そんなっ
#. de: Nein!
#. fr: Gouaaah !
msgctxt "NpcYell:16580:0:13"
msgid "No!"
msgstr ""

#. ja: ぐうぅッ！
#. de: Hrah!
#. fr: Aaah !
msgctxt "NpcYell:16581:0:13"
msgid "Gah!"
msgstr ""

#. ja: よくも！
#. de: Ah!
#. fr: Tu vas payer !
msgctxt "NpcYell:16582:0:13"
msgid "Ugh!"
msgstr ""

#. ja: きゃぁっ！
#. de: Uff!
#. fr: Aaah !
msgctxt "NpcYell:16583:0:13"
msgid "Aaah!"
msgstr ""

#. ja: うっ！
#. de: Uah!
#. fr: Ouh !
msgctxt "NpcYell:16584:0:13"
msgid "Argh!"
msgstr ""

#. ja: ぐあっ
#. de: Hrn<nbsp>...
#. fr: Agh !
msgctxt "NpcYell:16585:0:13"
msgid "\\<gasp>"
msgstr ""

#. ja: うえぇ～まっずい！
#. de: Oje, gar nicht gut!
#. fr: Beurk... Ça a pas bon goût...
msgctxt "NpcYell:16586:0:13"
msgid "Gods, that's bitter!"
msgstr ""

#. ja: あっは<br>そのまま死んじゃえ！
#. de: 0
#. fr: 0
msgctxt "NpcYell:16587:0:13"
msgid "0"
msgstr ""

#. ja: 助かったわ、ありがとう！
#. de: Danke!
#. fr: 0
msgctxt "NpcYell:16588:0:13"
msgid "0"
msgstr ""

#. ja: くっ…目が回る…
#. de: Ungh, alles dreht sich<nbsp>...
#. fr: Houlà... J'ai le tournis...
msgctxt "NpcYell:16589:0:13"
msgid "E-Everything's spinning..."
msgstr ""

#. ja: うぅ…気持ち悪ぅ…
#. de: Urgh, mir wird schlecht<nbsp>...
#. fr: Je crois que la concoction passe mal...
msgctxt "NpcYell:16590:0:13"
msgid "\\<sob> I don't feel so good..."
msgstr ""

#. ja: クラクラするよぉ…
#. de: Mir ist auf einmal so schwindelig<nbsp>...
#. fr: Ouuuh, ma tête...
msgctxt "NpcYell:16591:0:13"
msgid "So very...woozy..."
msgstr ""

#. ja: はぁ…はぁ…
#. de: \<keuch><nbsp>... \<schnauf><nbsp>...
#. fr: Harf... Harf...
msgctxt "NpcYell:16592:0:13"
msgid "\\<pant> \\<pant>"
msgstr ""

#. ja: わぁっ！？
#. de: Hm?!
#. fr: Wouah<nbsp>!?
msgctxt "NpcYell:16593:0:13"
msgid "Wha─!?"
msgstr ""

#. ja: ちょぉ！！
#. de: Oooh!
#. fr: Mais aïe-euh<nbsp>!
msgctxt "NpcYell:16594:0:13"
msgid "Aaah!"
msgstr ""

#. ja: ぷはぁ…げふ…
#. de: Bah<nbsp>... \<rülps><nbsp>...
#. fr: Bweurgh...
msgctxt "NpcYell:16595:0:13"
msgid "\\<retch> Urgh..."
msgstr ""

#. ja: うわぁっ！
#. de: Ups!
#. fr: Mais que faites-vous<nbsp>!?
msgctxt "NpcYell:16596:0:13"
msgid "No! N-Not me!"
msgstr ""

#. ja: ひえぇーーっ！！
#. de: Hiiieh!
#. fr: Au secouuuuurs<nbsp>!!!
msgctxt "NpcYell:16597:0:13"
msgid "Faulty little shites!"
msgstr ""

#. ja: ひぃ…はぁ…
#. de: Nein!
#. fr: Haa... Haa...
msgctxt "NpcYell:16598:0:13"
msgid "Phew... That was close."
msgstr ""

#. ja: これ以上<br>邪魔はさせないんだからぁ！
#. de: 0
#. fr: 0
msgctxt "NpcYell:16599:0:13"
msgid "0"
msgstr ""

#. ja: あれ…？<br>れ、錬金薬の効果が…
#. de: 0
#. fr: 0
msgctxt "NpcYell:16600:0:13"
msgid "0"
msgstr ""

#. ja: ぐへぇ…<br>動けなぁ～い…
#. de: Argh, ich kann<nbsp>... mich nicht bewegen!
#. fr: Gah... Je peux même plus bouger le petit doigt...
