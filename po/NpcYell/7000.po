# NpcYell
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: やばっ！
#. de: Hab mich schon besser gefühlt!
#. fr: Je le sens pas...
msgctxt "NpcYell:7000:0:13"
msgid "Not good..."
msgstr "Нехорошо..."

#. ja: マジかよ、こいつもか！？<br>しんど……。
#. de: Noch mehr Blecheimer. Muss das sein?
#. fr: I-il sort d'où, lui<nbsp>!? Dis-moi que je rêve<nbsp>!
msgctxt "NpcYell:7001:0:13"
msgid "They brought the big guns too!? Gimme a break..."
msgstr "И эти с тяжёлой артиллерией!? Ну сколько можно..."

#. ja: ってぇっ…
#. de: Argh<nbsp>...
#. fr: Je suis claqué...
msgctxt "NpcYell:7002:0:13"
msgid "Ungh..."
msgstr "Ух..."

#. ja: へへへ…やばっ…
#. de: Gar nicht gut<nbsp>...
#. fr: Je vais pas faire long feu à ce rythme...
msgctxt "NpcYell:7003:0:13"
msgid "Ugh, I messed up..."
msgstr "Ох, я всё испортил..."

#. ja: うっし、完璧……こんなもんって感じか？
#. de: So, die haben genug!
#. fr: Pfiou... Et voilà le travail.
msgctxt "NpcYell:7004:0:13"
msgid "That's all she wrote."
msgstr "Ну вот и всё."

#. ja: 手がかりは……なさそうだな。<br>ほかにもいねーか、ちょっと見てくるわ。
#. de: Also ich seh hier sonst nichts<nbsp>... Lass mich mal noch da hinten nachsehen.
#. fr: Ces tas de ferraille n'avaient rien d'intéressant sur eux... Je vais refaire un tour, au cas où il y en aurait d'autres.
msgctxt "NpcYell:7005:0:13"
msgid "Hmmm, no clues here... Guess I'll keep looking."
msgstr "Хм, тут никаких зацепок... Пойду ещё поищу."

#. ja: 何やってんだ、俺…
#. de: Das geht besser<nbsp>...
#. fr: Mais qu'est-ce que je glande, sérieux...
msgctxt "NpcYell:7006:0:13"
msgid "What was I thinking...?"
msgstr "О чём я только думал?.."

#. ja: シュコォ、シュコォ……<br>ま、まいった降参、撤退ゴブ～！
#. de: Brrr ... Zu brenzlig, zu gefährlich! Rückziehen!
#. fr: Pshhh... L-le mercenaire renonce... Il bat en retraite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:7007:0:13"
msgid "Gobbie knows when<br>gobbie is outwhacked...<br>All gob, backfall!"
msgstr "Гоблин знает, когда<br>ему не по зубам...<br>Гоблин отступает!"

#. ja: シュコォ、シュコォ……<br>契約満了、撤退するゴブ～！
#. de: Kriegsverbünden ist vorbei. Wir rückziehen.
#. fr: Pshhh... Le contrat du gobelin est terminé... Il bat en retraite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:7008:0:13"
msgid "Time of wordbond is over.<br>All gob, backfall!"
msgstr "Срок договора вышел.<br>Гоблин отступает!"

#. ja: 道をあけぃ！
#. de: Aus dem Weeeeg!
#. fr: Hors de mon chemin<nbsp>!
msgctxt "NpcYell:7009:0:13"
msgid "Out of my way!"
msgstr "С дороги!"

#. ja: そぉら、行くぞ！
#. de: Vorwääärts!
#. fr: En avant<nbsp>!
msgctxt "NpcYell:7010:0:13"
msgid "Drive them back!"
msgstr "Гоните их!"

#. ja: せいやッ！
#. de: Dieser Dolch ist für dich!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:7011:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: 始末するッ！
#. de: Das ist dein Ende!
#. fr: Laissez-moi faire<nbsp>!
msgctxt "NpcYell:7012:0:13"
msgid "This one is mine!"
msgstr "Этот мой!"

#. ja: やっちゃるよ！
#. de: Jetzt bist du dran!
#. fr: Venez prendre votre raclée<nbsp>!
msgctxt "NpcYell:7013:0:13"
msgid "Take this!"
msgstr "Получи!"

#. ja: 覚悟しなよ！
#. de: Mach dich auf was gefasst!
#. fr: Prépare-toi à souffrir<nbsp>!
msgctxt "NpcYell:7014:0:13"
msgid "Kyaaa!"
msgstr "Кья-а!"

#. ja: 叩き斬る！
#. de: Ich schlitz dich auf!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:7015:0:13"
msgid "I have you now!"
msgstr "Попался!"

#. ja: 我が呪剣にかけてッ！
#. de: Tizona, treue Klinge, tu dein Werk!
#. fr: Mon épée sera la dernière chose que vous verrez<nbsp>!
msgctxt "NpcYell:7016:0:13"
msgid "Give them no quarter!"
msgstr "Пощады не будет!"

#. ja: 甘く見るなよッ！
#. de: Du entkommst mir nicht!
#. fr: Vous ne pouvez rien contre moi<nbsp>!
msgctxt "NpcYell:7017:0:13"
msgid "Down with you!"
msgstr "Сдохни!"

#. ja: 斬り拓くのみ！
#. de: Du bist dem Tode geweiht!
#. fr: Nous les terrasserons, les uns après les autres<nbsp>!
msgctxt "NpcYell:7018:0:13"
msgid "Taste my steel!"
msgstr "На вкус — моя сталь!"

#. ja: そこです！
#. de: Hier und jetzt!
#. fr: Attention<nbsp>!
msgctxt "NpcYell:7019:0:13"
msgid "You shall not pass!"
msgstr "Не пройдёте!"

#. ja: 精霊の導きあれ…！
#. de: Gebieter, führet mich!
#. fr: Que les esprits nous guident<nbsp>!
msgctxt "NpcYell:7020:0:13"
msgid "By the will of the elementals!"
msgstr "Воля стихий с нами!"

#. ja: 出陣する！<br>ここが正念場と心得よッ！
#. de: Vorwärts! Wir haben das Recht auf unserer Seite!
#. fr: C'est ici que tout se joue<nbsp>! En avant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:7021:0:13"
msgid "And so it begins.<br>Are you ready?"
msgstr "Ну что, началось.<br>Готовы?"

#. ja: 承知ッ！
#. de: Jawohl, mein König!
#. fr: À vos ordres<nbsp>!
msgctxt "NpcYell:7022:0:13"
msgid "My lord!"
msgstr "Мой господин!"

#. ja: ここまで<br>押し込まれていたとは…！
#. de: Mit ihren Fallschirmen können sie uns überall angreifen<nbsp>...
#. fr: Ils ont enfoncé nos lignes jusqu'ici<nbsp>!?
msgctxt "NpcYell:7023:0:13"
msgid "They've grown bold to push this far."
msgstr "Они уже так далеко нас потеснили..."

#. ja: 爆撃が激しい…！<br>密集していてはやられます！
#. de: Weiter vorpreschen! Schnell!
#. fr: Ils nous bombardent en permanence<nbsp>! Dispersez-vous<nbsp>!
msgctxt "NpcYell:7024:0:13"
msgid "Spread out, and be wary of artillery fire."
msgstr "Рассредоточьтесь, берегитесь артиллерии!"

#. ja: よし、これより散開するぞ！<br>我らは南へ、そなたは北へ！
#. de: Wir teilen uns auf. Yugiri und ich halten uns südlich. Euch gehört der Norden.
#. fr: OK, on se sépare<nbsp>! Yugiri et moi, on va au sud<nbsp>! Toi, passe par le nord, <split " " 1><string $gs1></split><nbsp>!
msgctxt "NpcYell:7025:0:13"
msgid "Keep to the north. We will head off their troops to the south."
msgstr "Держитесь на севере. Мы перехватим их войска на юге."

#. ja: クッ……増援かッ！？
#. de: Noch mehr von der Sorte?
#. fr: Des renforts ennemis<nbsp>!?
msgctxt "NpcYell:7026:0:13"
msgid "Brace yourself. They've called for reinforcements!"
msgstr "Приготовьтесь! Подтянулись подкрепления!"

#. ja: 来てくれて助かったよ！
#. de: Danke! Das war Rettung in letzter Sekunde!
#. fr: Tu nous as sauvé la mise<nbsp>!
msgctxt "NpcYell:7027:0:13"
msgid "Thanks, but we're not done yet."
msgstr "Спасибо, но ещё рано расслабляться."

#. ja: <split " " 1><string $gs1></split>は先へ！<br>呪剣の名誉にかけて、ここは支えてみせるッ！
#. de: Stürm voran, <split " " 1><string $gs1></split>! Das Fluchschwert und ich halten dir den Rücken frei!
#. fr: Partez devant, <split " " 1><string $gs1></split><nbsp>! Cette ligne tiendra, je le jure sur mon épée<nbsp>!
msgctxt "NpcYell:7032:0:13"
msgid "Keep moving. We will hold them here!"
msgstr "Не останавливайся. Мы их здесь задержим!"

#. ja: シュコォ、シュコォ……<br>ファルコンと契約ゴブ！
#. de: Muahaaa! Wir kriegsbünden mit Falken!
#. fr: Pshhh... Le gobelin se bat pour les Faucons<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:7033:0:13"
msgid "Pshhh... Gobbies whack<br>for Falcons muchly!"
msgstr "Пшшш... Гоблины бьют<br>за Соколов!"

#. ja: シュコォ、シュコォ……<br>レイヴンと契約ゴブ！
#. de: Muahaaa! Wir kriegsbünden mit Raben!
#. fr: Pshhh... Le gobelin se bat pour les Corbeaux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:7034:0:13"
msgid "Pshhh... Gobbies whack<br>for Ravens muchly!"
msgstr "Пшшш... Гоблины бьют<br>за Воронов!"

#. ja: ナイス！
#. de: Sauber!
#. fr: Joli<nbsp>!
msgctxt "NpcYell:7035:0:13"
msgid "Nice!"
msgstr "Хорошо!"

#. ja: へー、やるじゃん！
#. de: Gut gemacht!
#. fr: Ça le fait<nbsp>!
msgctxt "NpcYell:7036:0:13"
msgid "Nailed it!"
msgstr "Ну ты даёшь!"

#. ja: どーよ！？
#. de: Na?
#. fr: Pas mal, hein<nbsp>?
msgctxt "NpcYell:7037:0:13"
msgid "How's that!?"
msgstr "Ну как тебе!?"

#. ja: 呼ばれて参上！
#. de: Wie gerufen, so erscheinen wir!
#. fr: Que la colère des cieux s'abatte sur vous<nbsp>!
msgctxt "NpcYell:7038:0:13"
msgid "We come!"
msgstr "Мы пришли!"

#. ja: 我ら、天の式鬼なり！
#. de: Wir sind die Shiki des Himmels!
#. fr: Nous sommes les shiki célestes<nbsp>!
msgctxt "NpcYell:7039:0:13"
msgid "From on high!"
msgstr "Мы — небесные сики!"

#. ja: セイヤッ！
#. de: \<kreisch>
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:7040:0:13"
msgid "What ho!"
msgstr "Эй-я!"

#. ja: ソイヤッ！
#. de: \<blubber>
#. fr: Yahaah<nbsp>!
msgctxt "NpcYell:7041:0:13"
msgid "Hahaha!"
msgstr "Ха-ха-ха!"

#. ja: オイサッ！
#. de: \<groll>
#. fr: Hiyaah<nbsp>!
msgctxt "NpcYell:7042:0:13"
msgid "Miss me!?"
msgstr "Мимо!"

#. ja: 風の力よ！
#. de: Wir entfesseln Wind und Sturm!
#. fr: Rafales, tornades, bourrasques<nbsp>!
msgctxt "NpcYell:7043:0:13"
msgid "Feel that wind!"
msgstr "Почувствуй ветер!"

#. ja: 扇に集えよ！
#. de: Wer den Wind sät ...
#. fr: Unissez-vous dans mon éventail<nbsp>!
msgctxt "NpcYell:7044:0:13"
msgid "I'm feeling it!"
msgstr "Соберись в моём веере!"

#. ja: ソラソラ、喰らえよ！
#. de: Vom Winde verweht!
#. fr: Tanguez, tanguez<nbsp>!
msgctxt "NpcYell:7045:0:13"
msgid "Needs more feeling!"
msgstr "Ну-ка, ну-ка, получай!"

#. ja: オラオラ、舞えよ！
#. de: Sehet unseren tödlichen Reigen!
#. fr: Dansez, dansez<nbsp>!
msgctxt "NpcYell:7046:0:13"
msgid "What fun!"
msgstr "А ну, пляши!"

#. ja: ウラウラ、飛べよ！
#. de: Fliegt, erhebt euch in die Lüfte!
#. fr: Volez, volez<nbsp>!
msgctxt "NpcYell:7047:0:13"
msgid "Dance for me!"
msgstr "Ну-ка, взлетай!"

#. ja: おおっと、ぬかった！
#. de: Zurück in den Äther ...
#. fr: Comment est-ce possible<nbsp>?
msgctxt "NpcYell:7048:0:13"
msgid "Another time!"
msgstr "Ох, промахнулся!"

#. ja: ええい、ここまでか！
#. de: Unsere Pflicht ist getan ...
#. fr: Nous n'en resterons pas là<nbsp>!
msgctxt "NpcYell:7049:0:13"
msgid "'Twas a pleasure!"
msgstr "Что ж, пока хватит!"

#. ja: なかなか、やりおる！
#. de: Der Wind kommt und geht ...
#. fr: Ils sont in<shy>é<shy>bran<shy>la<shy>bles<nbsp>!
msgctxt "NpcYell:7050:0:13"
msgid "Well done!"
msgstr "Неплохо дерётесь!"

#. ja: 仕留め損ねたか！
#. de: Der Todesstoß ...
#. fr: Que la honte s'abatte sur nous...
msgctxt "NpcYell:7051:0:13"
msgid "Still there, huh?"
msgstr "Не добил, значит?"

#. ja: これにて、ご免！
#. de: Mit Verlaub ...
#. fr: Les cieux nous attendent<nbsp>!
msgctxt "NpcYell:7052:0:13"
msgid "We take our leave!"
msgstr "Ну, мы пошли!"

#. ja: 泥ヨリ生マルル…<br>沼ノ式鬼…！
#. de: Aus Schlamm und Erde geboren ... Numa no Shiki!
#. fr: Nous sommes les shiki fangeux... nés de la boue...
msgctxt "NpcYell:7053:0:13"
msgid "Ohoho... We come!"
msgstr "О-хо-хо... Мы пришли!"

#. ja: 泥ハ刻経テ…<br>岩トナル…！
#. de: Schlamm gebiert Erde, Erde gebiert Stein!
#. fr: Avec le temps, la fange devient roche<nbsp>!
msgctxt "NpcYell:7054:0:13"
msgid "Mud to stone!"
msgstr "Грязь со временем...<br>станет камнем!"

#. ja: ウッウッウッ…<br>バ、ク、ハ、ツ、ス、ルーー！
#. de: Huhuuu! Ich EX-PLO-DIE-RE!
#. fr: Je suis tellement gros que je vais exploser<nbsp>!
msgctxt "NpcYell:7055:0:13"
msgid "Boom boom goes me!"
msgstr "У-у-у...<br>ВЗОР-ВУСЬ!!!"

#. ja: バグオォォン！
#. de: \<groll>
#. fr: Et boum<nbsp>!
msgctxt "NpcYell:7056:0:13"
msgid "Boom boom!"
msgstr "Бабах!"

#. ja: ウヘハァァン！
#. de: \<wuuusch>
#. fr: Boum boum<nbsp>!
msgctxt "NpcYell:7057:0:13"
msgid "Boom?"
msgstr "Бум?"

#. ja: ドベガァァン！
#. de: \<zonk>
#. fr: Badaboum<nbsp>!
msgctxt "NpcYell:7058:0:13"
msgid "To boom or not to boom?"
msgstr "Бабахнуть или не бабахнуть?"

#. ja: 巡り巡りて…！
#. de: Das Rad der Zeit mahlt ...
#. fr: Où que j'aille...
msgctxt "NpcYell:7059:0:13"
msgid "Rolling, rolling, rolling..."
msgstr "Катится, катится, катится..."

#. ja: 回り回りて…！
#. de: Macht euch bereit gerädert zu werden!
#. fr: Quoi qu'il advienne...
msgctxt "NpcYell:7060:0:13"
msgid "Spinny spinny!"
msgstr "Крутись, крутись!"

#. ja: 行き着く先は、<br>地獄なりや！
#. de: Macht euch bereit. Die Hölle naht!
#. fr: Une seule destination, l'enfer<nbsp>!
msgctxt "NpcYell:7061:0:13"
msgid "Welcome to die!"
msgstr "Добро пожаловать в смерть!"

#. ja: 巡り巡りて、もうひとたび！
#. de: Das Rad der Zeit ist unerbittlich ...
#. fr: Et ça va encore...
msgctxt "NpcYell:7062:0:13"
msgid "They see me rolling..."
msgstr "Опять катимся..."

#. ja: 回り回りて、もうひとたび！
#. de: Jetzt kommt ihr unter die Räder!
#. fr: Et ça vient encore...
msgctxt "NpcYell:7063:0:13"
msgid "They hating..."
msgstr "Опять вертимся!"

#. ja: 次こそ逝こうぞ、<br>地獄の底へ！
#. de: Willkommen zu eurem Untergang!
#. fr: Jusqu'au tréfonds de l'enfer<nbsp>!
msgctxt "NpcYell:7064:0:13"
msgid "Welcome back to die!"
msgstr "На этот раз — прямиком<br>в ад!"

#. ja: カラカラカラ…<br>逝けや逝け！
#. de: <nbsp>... sterbt!
#. fr: La mort vous attend<nbsp>!
msgctxt "NpcYell:7065:0:13"
msgid "Bye-bye!"
msgstr "Кхе-кхе-кхе...<br>Умрите!"

#. ja: カラカラカラ…<br>疾く疾く！
#. de: Karkarkar<nbsp>... schnell<nbsp>... und schneller!
#. fr: Plus vite que ça<nbsp>!
msgctxt "NpcYell:7066:0:13"
msgid "So long!"
msgstr "Кхе-кхе-кхе...<br>Быстрее!"

#. ja: カラカラカラ…<br>走れや走れ！
#. de: Karkarkar<nbsp>... lauft<nbsp>... lauft nur!
#. fr: Au pas de course<nbsp>!
msgctxt "NpcYell:7067:0:13"
msgid "You die now!"
msgstr "Кхе-кхе-кхе...<br>Бегите, бегите!"

#. ja: カラカラカラ……<br>すぐに逝こう！
#. de: Karkarkar<nbsp>... sterbt schnell, sterbt schreiend!
#. fr: Trépassez im<shy>mé<shy>dia<shy>te<shy>ment<nbsp>!
msgctxt "NpcYell:7068:0:13"
msgid "Roll out!"
msgstr "Кхе-кхе-кхе...<br>Скоро умрёте!"

#. ja: カラカラカラ……<br>もっと疾く！
#. de: Karkarkar<nbsp>... noch schneller!
#. fr: Encore plus vite<nbsp>!
msgctxt "NpcYell:7069:0:13"
msgid "You ready?"
msgstr "Кхе-кхе-кхе...<br>Ещё быстрее!"

#. ja: カラカラカラ……<br>死へ走れ！
#. de: Karkarkar<nbsp>... lauft in euren Untergang!
#. fr: Dépêchez-vous de mourir<nbsp>!
msgctxt "NpcYell:7070:0:13"
msgid "Run to die!"
msgstr "Кхе-кхе-кхе...<br>Бегите к смерти!"

#. ja: 我ラ、岩ノ式鬼…
#. de: Iwa no Shiki - Gestein ist hart, Gestein ist kalt<nbsp>...<br>wie der Tod!
#. fr: Nous sommes les shiki rocailleux...
msgctxt "NpcYell:7071:0:13"
msgid "I am rock!"
msgstr "Мы — каменные сики..."

#. ja: ソノ絆…<br>岩ノ如シ！
#. de: Stein<br>Stein bindet<br>Stein geißelt<nbsp>...
#. fr: Solides comme la pierre<nbsp>!
msgctxt "NpcYell:7072:0:13"
msgid "I am also rock!"
msgstr "Узы наши...<br>крепки, как камень!"

#. ja: 我ラノ、出番ゾ…
#. de: Dein Ruf wurde erhört und so erscheinen wir<nbsp>...
#. fr: À nous de jouer...
msgctxt "NpcYell:7073:0:13"
msgid "I still rock!"
msgstr "Наш выход..."

#. ja: 砕カレヨウトモ、<br>立チ上ガル！
#. de: Shiki, erhebt euch!
#. fr: Essayer de nous détruire ne fera que nous rendre plus résistants<nbsp>!
msgctxt "NpcYell:7074:0:13"
msgid "I still also rock!"
msgstr "Пусть нас разобьют,<br>мы всё равно встанем!"

#. ja: グラグラグラ！
#. de: Wir werden euch steinigen.
#. fr: Graah graah<nbsp>!
msgctxt "NpcYell:7075:0:13"
msgid "We rock you!"
msgstr "Мы зададим вам жару!"

#. ja: ガラガラガラ！
#. de: Wir werden euch steinigen.
#. fr: Grooh grooh<nbsp>!
msgctxt "NpcYell:7076:0:13"
msgid "We rock you!"
msgstr "Мы зададим вам жару!"

#. ja: グララァー！
#. de: Sturmwind der Berge!
#. fr: Graaaaaaah<nbsp>!
msgctxt "NpcYell:7077:0:13"
msgid "Rock you like typhoon!"
msgstr "Сокрушим вас, как тайфун!"

#. ja: ガララァー！
#. de: Sturmwind der Berge!
#. fr: Groooooooh<nbsp>!
msgctxt "NpcYell:7078:0:13"
msgid "Rock you like typhoon!"
msgstr "Сокрушим вас, как тайфун!"

#. ja: ツブス、ツブス！
#. de: \<zisch>
#. fr: Je vais vous écraser<nbsp>!
msgctxt "NpcYell:7079:0:13"
msgid "Can't stop!"
msgstr "Крушить, крушить!"

#. ja: コワス、コワス！
#. de: \<zoff>
#. fr: Je vais vous broyer<nbsp>!
msgctxt "NpcYell:7080:0:13"
msgid "Won't stop!"
msgstr "Ломать, ломать!"

#. ja: ツブス、ツブス、ツブス！
#. de: \<zisch>, \<zisch>
#. fr: Vous allez finir en miettes<nbsp>!
msgctxt "NpcYell:7081:0:13"
msgid "Achy break!"
msgstr "Крошить, крошить, крошить!"

#. ja: コワス、コワス、コワス！
#. de: \<zoff>, \<zoff>
#. fr: Transformez-vous en poussière<nbsp>!
msgctxt "NpcYell:7082:0:13"
msgid "Breaky ache!"
msgstr "Крушить, крушить, крушить!"

#. ja: 耐エ抜コウトハ…<br>見事ナリ…
#. de: Eure Beharrlichkeit ist beeindruckend<nbsp>...
#. fr: Ils sont encore plus durs que des rocs...
msgctxt "NpcYell:7083:0:13"
msgid "You good..."
msgstr "Вы крепки..."

#. ja: 次コソ仕留メテ<br>見セヨウゾ…
#. de: Das Spiel ist aus. Jetzt werdet ihr vernichtet!
#. fr: La prochaine fois, vous finirez en miettes<nbsp>!
msgctxt "NpcYell:7084:0:13"
msgid "Real good..."
msgstr "В следующий раз уж точно..."

#. ja: ヤハリ、見事ナ武勇ナリ…
#. de: Ein Kampf, wie er eines Helden würdig ist<nbsp>...
#. fr: Quelle vaillance...
msgctxt "NpcYell:7085:0:13"
msgid "You still good..."
msgstr "Вот это доблесть..."

#. ja: 流石ナリ…！
#. de: Ich habe nichts anderes erwartet!
#. fr: Bande de cœurs de pierre<nbsp>!
msgctxt "NpcYell:7086:0:13"
msgid "Still real good..."
msgstr "Как и ожидалось...!"

#. ja: 甘く見るなよッ！
#. de: Seht euch vor!
#. fr: Tu me sous-estimes<nbsp>!
msgctxt "NpcYell:7087:0:13"
msgid "You underestimate me!"
msgstr "Не недооценивай меня!"

#. ja: 援護に感謝いたします…
#. de: Danke für die Hilfe ...
#. fr: Merci pour votre aide...
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:7088:0:13"
msgid "My thanks, <split \" \" 1><string $gs1></split>."
msgstr "Благодарю, <split \" \" 1><string $gs1></split>."

#. ja: おうおう、やっておるな！<br>どれ、わしも混ぜてくれんか？
#. de: Was dagegen, wenn ich mitmische?
#. fr: Oh oh, ça barde ici<nbsp>! On peut se joindre à vous<nbsp>!?
msgctxt "NpcYell:7089:0:13"
msgid "You seem troubled, friends. Not getting tired, are you?"
msgstr "Что-то вы тут совсем застряли, друзья. Не устали ещё?"

#. ja: 新手の魔導兵器か！？
#. de: Was ist das? Eine neue Magitek-Waffe?
#. fr: Une nouvelle arme magitek<nbsp>!?
msgctxt "NpcYell:7090:0:13"
msgid "By the Fury! What is that?"
msgstr "Клянусь Яростью! Что это такое?"

#. ja: しまった！
#. de: Achtung, König Hien!
#. fr: Ils nous ont eus<nbsp>!
msgctxt "NpcYell:7091:0:13"
msgid "It comes!"
msgstr "Оно идёт!"

#. ja: 助力に来たぞ！
#. de: Ich helfe euch!
#. fr: Prenez garde<nbsp>! Ils ont appelé de l'aide<nbsp>!
msgctxt "NpcYell:7092:0:13"
msgid "Fear not! Help is on the way!"
msgstr "Не бойтесь! Помощь уже в пути!"

#. ja: みなさん、集まってください！
#. de: Versammelt euch!
#. fr: Mes amis<nbsp>! Regroupez-vous<nbsp>!
msgctxt "NpcYell:7093:0:13"
msgid "Quickly! To me!"
msgstr "Живо! Ко мне!"

#. ja: ゴウセツ直伝の秘剣……<br>見せてくれるッ！
#. de: Gosetsu hat mir ein paar Tricks beigebracht ...
#. fr: Gosetsu, je t'emprunte ta technique secrète<nbsp>!
msgctxt "NpcYell:7094:0:13"
msgid "This is for you, old friend."
msgstr "Это тебе, старый друг."

#. ja: パパリモ、力を貸して……<br>この拳に、すべてを込めるッ！
#. de: Papalymo, hörst du mich? Gib mir Kraft!
#. fr: Papalymo, donne-moi la force de vaincre<nbsp>!
msgctxt "NpcYell:7095:0:13"
msgid "This one's for you, Papalymo."
msgstr "Это за тебя, Папалимо."

#. ja: ドマの忍びを甘く見るな！
#. de: Unterschätze nicht die Stärke der Shinobi!
#. fr: Vous sous-estimez les shinobi de Doma<nbsp>!
msgctxt "NpcYell:7096:0:13"
msgid "Behold the art of the shinobi!"
msgstr "Узри искусство синоби!"

#. ja: あなたは先に進んで指揮官を！<br>ここは、アタシたちが！
#. de: Wir halten hier die Stellung. Kämpf dich weiter vor und stöbere die Befehlshaber auf!
#. fr: Fonce vers leur poste de commandement, <split " " 1><string $gs1></split><nbsp>! On s'occupe d'eux<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:7097:0:13"
msgid "Go on, <split \" \" 1><string $gs1></split>. Leave these soldiers to us."
msgstr "Вперёд, <split \" \" 1><string $gs1></split>. С этими солдатами мы разберёмся."

#. ja: シュコォ、シュコォ……<br>傭兵見参……雇い主、募集ゴブ！
#. de: Kaufkämpfer ist bereit! Bereit für Tötenkampf!
#. fr: Pshhh... Personne n'a encore engagé le gobelin...
msgctxt "NpcYell:7098:0:13"
msgid "Sellgob whack-ready! Whack and thwack for uplander!"
msgstr "Наёмный гоблин готов бить! Бить и колотить за чужеземца!"

#. ja: シュコォ、シュコォ……<br>出撃、突進、大活躍ゴブ～！
#. de: Loslauf, loskämpf, immersiegen!
#. fr: Pshhh... Déploiement, charge, combat... Le gobelin est prêt à tout<nbsp>!
msgctxt "NpcYell:7099:0:13"
msgid "For jinglyshine, gobbies frontcharge! Gobbies smashstrike!"
msgstr "За звонкую монету гоблины ринутся в атаку! Гоблины всех разнесут!"

#. ja: 自爆なぞ<br>ワシが止めてみせる！
#. de: Will der sich in die Luft sprengen? Nicht mit mir!
#. fr: Oh que non, mon grand. Tu ne te feras pas sauter comme ça<nbsp>!
msgctxt "NpcYell:7100:0:13"
msgid "It looks ready to explode. Stand back!"
msgstr "Сейчас рванёт. Назад!"

#. ja: この気配…<br>自爆する気か！？
#. de: Er meint es ernst. Er will sich sprengen!
#. fr: Il a activé sa séquence d'autodestruction<nbsp>!?
msgctxt "NpcYell:7101:0:13"
msgid "An explosive!? It must be stopped."
msgstr "Взрывчатка!? Её нужно обезвредить."

#. ja: 爆発する前にッ！
#. de: Bevor hier alles in die Luft fliegt, werde ich ...
#. fr: Vite<nbsp>! Finissez-le<nbsp>!
msgctxt "NpcYell:7102:0:13"
msgid "It's going to blow!"
msgstr "Скорее, пока не рвануло!"

#. ja: シシシシシ…<br>痺れますゾゾゾゾゾ！！
#. de: Ah, das rüttelt einen wach!
#. fr: Ça pi-pi-pi-pi-pi-picotte un peu<nbsp>!
msgctxt "NpcYell:7103:0:13"
msgid "My b-b-bones are t-t-tingling!"
msgstr "К-к-кости щекочет!"

#. ja: スンスン……嗚呼、甘美なる血の香り……<br>もっともっと、新鮮な血を下さいな？
#. de: Uuuh, ich rieche Blut ...<br>Süßes Blut! Gib es mir!
#. fr: (renifle)... Aaah, la douce odeur du sang frais. J'en prendrais bien une lampée<nbsp>!
msgctxt "NpcYell:7105:0:13"
msgid "Such sweet blood, so very fresh. But...oh! Yours is fresher still..."
msgstr "Какая сладкая кровь, и такая свежая... Но твоя... о, твоя ещё свежее..."

#. ja: お逃げにならず、ワタクシの愛を受け止めて？<br>気持ちよくして、差し上げますから……。
#. de: Flüchte nicht, bleib hier. Ich werde dich von deinem fleischlichen Leiden befreien!
#. fr: Pourquoi fuir, et refuser l'amour que je vous offre<nbsp>? Vous seriez enfin <if $gn4>heureuse<else>heureux</if>...
msgctxt "NpcYell:7106:0:13"
msgid "I shall sup gently on your veins. So very gently..."
msgstr "Я буду нежно пить из твоих вен. Очень нежно..."

#. ja: ワタクシ、新鮮な血は好きですけれど……<br>自分が血を流すのは、許せませんのよぉぉぉぉぉぉぉぉ！
#. de: Ich liebe den Duft von frischem Blut,<br>Aber wenn es das meine ist, verfalle ich in rasende Wut!
#. fr: J'aime le sang, mais seulement quand c'est celui des autres... Vous allez me le payer<nbsp>!
msgctxt "NpcYell:7107:0:13"
msgid "Now see what you've done! Mine own blood is spilled! Mine...mine...MINE... "
msgstr "Ну и что ты наделал! Моя кровь пролита! Моя... моя... МОЯ..."

#. ja: 社長サン！　コチラノ商品ハ、イカガデスカ？<br>ゼヒ、近クデ御覧クダサイ、破壊力バツグンデスヨ！
#. de: Wie wär's mit diesen vorzüglichen Waren, hmm? Wirf einen Blick drauf. Komm, komm! Mehr Zer<shy>störungs<shy>kraft gibt's nicht!
#. fr: Regardez-moi un peu ce produit<nbsp>! Venez voir de près sa capacité destructrice<nbsp>!
msgctxt "NpcYell:7108:0:13"
msgid "Friends! Partners! Come closer... See my wares! I bring only the finest."
msgstr "Друзья! Партнёры! Подходите поближе... Глядите на мой товар! Только лучшее!"

#. ja: 社長サン！　コノ商品ノ魅力ハ、<br>チョット離レタ時ニ、ヨク解ルノデゴザイマスヨ！
#. de: <if $gn4>Meine Liebe<else>Mein Lieber</if>, ich sage dir, die Ware hat Charme! Komm, schau sie dir gut an, dann wirst du es sehen!
#. fr: Vous avez vu ce produit-là<nbsp>? Il marche encore mieux quand on prend du recul<nbsp>!
msgctxt "NpcYell:7109:0:13"
msgid "Friends! Partners! A humble invitation─learn how this blade cuts!"
msgstr "Друзья! Партнёры! Скромно приглашаю вас взглянуть на клинок. Узнайте, как он режет!"

#. ja: 社長サン！　オ支払イハ、ゴ一括デ？<br>支払エナイナラ、命デ払ッテイタダキマスヨ！
#. de: Zahlst du alles auf einmal oder in Raten? Wenn du nicht bezahlen kannst, muss ich's dir aus dem Fleisch schneiden!
#. fr: Vous payez en une fois, hein<nbsp>? Si vous n'avez pas les fonds, ça vous coûtera la vie<nbsp>!
msgctxt "NpcYell:7110:0:13"
msgid "Now, my partners! What do you offer in trade? One life, or more?"
msgstr "Ну что, партнёры, чем расплатитесь? Одной жизнью или несколькими?"

#. ja: 社長サン！　在庫一掃セール、始メマスヨ！<br>出血大サービス、デス……血ヲ流シテクダサイネ？
#. de: Die Rabattaktion hat begonnen! Alles muss raus aus der Schmiede! Ein großer Aderlass inklusive! Wollen wir beginnen?
#. fr: Attention, c'est les soldes et c'est une véritable tuerie<nbsp>! Vous ne pourrez rien faire pour stopper l'hémorragie<nbsp>!
msgctxt "NpcYell:7111:0:13"
msgid "Miserly mortals! I ask for so little─only your lifeblood!"
msgstr "Скупые смертные! Я прошу так мало — всего лишь вашу кровь!"

#. ja: シュウウウウウゥゥゥゥ……
#. de: \<zisch> ...
#. fr: Wouuuh...
msgctxt "NpcYell:7112:0:13"
msgid "\\<hiss>"
msgstr "\\<шипение>"

#. ja: グルルルルゥゥゥゥゥ……
#. de: \<groll> ...
#. fr: Grrr...
msgctxt "NpcYell:7113:0:13"
msgid "\\<growl>"
msgstr "\\<рычание>"

#. ja: 禍々しいエーテルを<br>ビンビンに感じるクポ！
#. de: Der Äther fühlt sich nicht richtig an, kupo<nbsp>...
#. fr: L'éther est lourd par ici, kupo<nbsp>!
msgctxt "NpcYell:7114:0:13"
msgid "The aether here feels...corrupted, kupo..."
msgstr "Здесь эфир... испорченный, купо..."

#. ja: 突撃はあまりに危険クポ！<br>応援を呼ぶクポ！！
#. de: Wir sollten da nicht alleine vorpreschen, kupo. Lass uns auf Verstärkung warten!
#. fr: Prudence est mère de sûreté, kupopo<nbsp>!
msgctxt "NpcYell:7115:0:13"
msgid "We probably shouldn't go barging in there alone, kupo!"
msgstr "Одним туда лучше не соваться, купо!"

#. ja: このエーテルの感じ……<br>リドルアナと同じクポ？
#. de: Das alles kommt mir bekannt vor. Wie in Ridorana<nbsp>...
#. fr: On dirait le même éther qu'à Ridorana, kupo...
msgctxt "NpcYell:7116:0:13"
msgid "This all feels familiar...like back in Ridorana..."
msgstr "Всё это кажется знакомым... Как тогда, в Ридоране..."

#. ja: すっかりジャングルに<br>飲み込まれているクポ～！
#. de: So muss es sich anfühlen, wenn man von einem Morbol mit Haut und Bommel verschlungen wird, kupo!
#. fr: Cette jungle va nous manger tout crus, kupo<nbsp>!
msgctxt "NpcYell:7117:0:13"
msgid "I imagine this is what it is like to be swallowed by a morbol, kupo!"
msgstr "Вот каково это — оказаться проглоченным морболом, купо!"

#. ja: 聖石のエーテルを……<br>わずかだけど感じるクポ！
#. de: Ich spüre Rückstände von Äther hier. Wahrscheinlich von Auraciten, kupo.
#. fr: Cet éther... C'est celui des auralithes, kupo<nbsp>!
msgctxt "NpcYell:7118:0:13"
msgid "There are traces of aetherial residue here. Most likely from auracite, kupo."
msgstr "Здесь остались следы эфира. Скорее всего, от священного камня, купо."

#. ja: リドルアナと違って<br>優しさを感じたクポ……！
#. de: Der Äther hier ist anders, kupo. Ist das<nbsp>... Freude, die ich empfinde, kupo?
#. fr: Cet éther est différent de celui de Ridorana. Il est moins maléfique, kupo...
msgctxt "NpcYell:7119:0:13"
msgid "The aether here is different. Is this...joy I feel, kupo?"
msgstr "Здесь эфир совсем другой. Неужели я чувствую... радость, купо?"

#. ja: このワイン……<br>飲めそうだクポ！？
#. de: Der Wein hier sieht aus, als ob man ihn trinken könnte!<br>Meinst du, wir könnten<nbsp>...? Nein? Schon gut, kupo<nbsp>...
#. fr: Ce vin a l'air délicieux, kupopo<nbsp>! Et si on y goûtait<nbsp>?
msgctxt "NpcYell:7120:0:13"
msgid "This wine looks good enough to drink! Do you think we should─? No? Alright, kupo..."
msgstr "Вино на вид вполне приличное! Может, попробуем?.. Нет? Ладно, купо..."

#. ja: 哀しみを帯びたエーテルを<br>いや、感情を感じるクポ…
#. de: Der Äther strahlt Schmerz aus, kupo. Großen Schmerz<nbsp>...
#. fr: Je sens un éther plein de tristesse, kupo...
msgctxt "NpcYell:7121:0:13"
msgid "There is much pain in the aether here. A great loss, kupo..."
msgstr "Здесь в эфире столько боли. Такая невосполнимая утрата, купо..."

#. ja: デュライ白書に登場した<br>伝説の聖騎士クポ……？
#. de: Lass mich raten: Jemand aus den Durai-Chroniken, kupo?
#. fr: Mon pompon me dit que ces gardiens figurent dans le Livre blanc de Durai, kupo<nbsp>!
msgctxt "NpcYell:7122:0:13"
msgid "Let me guess, someone from the Durai Papers, kupo?"
msgstr "Дай угадаю: кто-то из «Записок Дюрая», купо?"

#. ja: この建築様式は<br>とっても×２古いクポ！
#. de: Ich lehn mich mal ganz weit aus dem Fenster und rate:<br>Der Ort hier ist richtig alt, kupo!
#. fr: Voilà une architecture bien par<shy>ti<shy>cu<shy>liè<shy>re, kupo<nbsp>!
msgctxt "NpcYell:7123:0:13"
msgid "I'm going to go out on a limb and guess this place is fairly old, kupo."
msgstr "Рискну предположить, что это место довольно древнее, купо."

#. ja: 禍々しいエーテルが<br>強くなっているクポ……！
#. de: Erinnerst du dich, wie ich vorhin meinte, der Äther fühle sich nicht <i>richtig</i> an?<br>Nun, jetzt ist's <i>richtig</i> unheimlich, kupo!
#. fr: Attention, l'éther est plus maléfique que jamais, kupopo<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:7124:0:13"
msgid "Might you recall earlier when I said the aether felt corrupted? Well, it's <i>really</i> corrupted now, kupo!"
msgstr "Помнишь, я говорил, что эфир здесь будто испорчен? Так вот, теперь он <i>действительно</i> испорчен, купо!"

#. ja: ミュロンド……？<br>聞いたことあるクポ！
#. de: Mullonde<nbsp>...? Irgendwo habe ich den Namen schon mal gehört. Aber wo, kupo?
#. fr: Mullonde<nbsp>? J'ai déjà entendu ce nom quelque part, kupo...
msgctxt "NpcYell:7125:0:13"
msgid "Mullonde? Now where have I heard that name before, kupo?"
msgstr "Муллонд? Где же я раньше слышал это имя, купо?"

#. ja: ……シドさん？<br>シドさんに似ているクポ！
#. de: Was macht Cid denn hier unten, kupo?!
#. fr: Cid<nbsp>!? Mais qu'est-ce qu'il fait ici, kupo<nbsp>?
msgctxt "NpcYell:7126:0:13"
msgid "Wait... What is Cid doing down here, kupo?"
msgstr "Постой... Что Сид здесь делает, купо?"

#. ja: 苦艱と恍惚を<br>同時に感じるクポ！
#. de: Irgendwas stimmt hier nicht!<br>Ich spüre nun sowohl Schmerz als auch Verzückung, kupo!
#. fr: Je sens un mélange de réprobation et d'extase... C'est très bizarre, kupo<nbsp>!
msgctxt "NpcYell:7127:0:13"
msgid "Something is wrong... I sense both anguish and rapture, kupo!"
msgstr "Что-то не так... Я чувствую и муку, и восторг, купо!"

#. ja: 恐れては駄目……クポ！<br>意識を保つ……クポッ！！
#. de: Jetzt bloß nicht vor Angst in die Hosen machen!<br>Das überlass mir, kupo!
#. fr: N'ayez pas peur<nbsp>! Je vous soutiens par la pensée, kupo<nbsp>!
msgctxt "NpcYell:7128:0:13"
msgid "You mustn't fear her! Leave that to me, kupo!"
msgstr "Не бойся её! Это уж оставь мне, купо!"

#. ja: ぬわっ…！
#. de: Ahhh!
#. fr: Gnah<nbsp>!
msgctxt "NpcYell:7129:0:13"
msgid "Gah!"
msgstr "Ай!"

#. ja: グハッ…！
#. de: Urrrgh!
#. fr: Goueurgh<nbsp>!
msgctxt "NpcYell:7130:0:13"
msgid "Ugh!"
msgstr "Уф!"

#. ja: ガハッ…
#. de: Arrr!
#. fr: Gouah<nbsp>!
msgctxt "NpcYell:7131:0:13"
msgid "Ahhh!"
msgstr "А-а-а!"

#. ja: ぐあっ！
#. de: Argh!
#. fr: Argh...<nbsp>!
msgctxt "NpcYell:7132:0:13"
msgid "Urgh!"
msgstr "У-ух!"

#. ja: み、皆…無事か！？
#. de: Seid ihr verletzt?
#. fr: T-tout le monde va bien<nbsp>!?
msgctxt "NpcYell:7133:0:13"
msgid "0"
msgstr "0"

#. ja: しまった！<br>身体が動かん…！
#. de: Mist, ich kann mich nicht bewegen.
#. fr: Non<nbsp>! Je ne peux plus bouger...<nbsp>!
msgctxt "NpcYell:7134:0:13"
msgid "0"
msgstr "0"

#. ja: 仕掛けてくるぞ！
#. de: Achtung!
#. fr: Attention<nbsp>!
msgctxt "NpcYell:7135:0:13"
msgid "Brace yourselves!"
msgstr "Готовьтесь!"

#. ja: 散開せよ！<br>被害を最小限に留める！
#. de: Verteilt euch! Dadurch minimieren wir den Schaden.
#. fr: Dispersez-vous<nbsp>! Qu'on soit le moins touchés possible<nbsp>!
msgctxt "NpcYell:7136:0:13"
msgid "Quickly! We must spread out!"
msgstr "Скорее! Надо рассредоточиться!"

#. ja: ここが正念場ぞ！
#. de: Alles oder nichts!
#. fr: C'est maintenant que tout se joue<nbsp>!
msgctxt "NpcYell:7137:0:13"
msgid "0"
msgstr "0"

#. ja: ゆくぞ、皆の者ッ！
#. de: Gemeinsam sind wir stark!
#. fr: Tout le monde<nbsp>! À l'assaut<nbsp>!
msgctxt "NpcYell:7138:0:13"
msgid "With me!"
msgstr "За мной!"

#. ja: ッ…！！
#. de: Ah!
#. fr: Ah<nbsp>!
msgctxt "NpcYell:7139:0:13"
msgid "Ngh!"
msgstr "Нгх!"

#. ja: カハッ…
#. de: Ahhh!
#. fr: Gouah<nbsp>!
msgctxt "NpcYell:7140:0:13"
msgid "Ahhh!"
msgstr "А-а-а!"

#. ja: なんと！？
#. de: Was ...?!
#. fr: Quoi<nbsp>!?
msgctxt "NpcYell:7141:0:13"
msgid "Such power!"
msgstr "Вот это мощь!"

#. ja: 承知ッ！
#. de: Zu Befehl!
#. fr: À vos ordres<nbsp>!
msgctxt "NpcYell:7142:0:13"
msgid "My lord!"
msgstr "Господин!"

#. ja: ヒ、ヒエン様ッ…！
#. de: K-König Hien!
#. fr: Seigneur Hien<nbsp>!
msgctxt "NpcYell:7143:0:13"
msgid "Lord Hien!"
msgstr "Господин Хиэн!"

#. ja: 私はこちらに…！
#. de: Und schon bin ich hier!
#. fr: Je vais par là<nbsp>!
msgctxt "NpcYell:7144:0:13"
msgid "Understood!"
msgstr "Понял!"

#. ja: ハッ！
#. de: Ha!
#. fr: Compris<nbsp>!
msgctxt "NpcYell:7145:0:13"
msgid "0"
msgstr "0"

#. ja: 承知ッ！
#. de: Zu Befehl!
#. fr: À vos ordres<nbsp>!
msgctxt "NpcYell:7146:0:13"
msgid "My lord!"
msgstr "Господин!"

#. ja: か、身体が…<br>シビレて…
#. de: I-Ich bin gelähmt!
#. fr: Je... Je suis paralysée<nbsp>!
msgctxt "NpcYell:7147:0:13"
msgid "I... I can't move..."
msgstr "Я... не могу пошевелиться..."

#. ja: グッ…
#. de: Argh<nbsp>...
#. fr: Argh...
msgctxt "NpcYell:7148:0:13"
msgid "Argh!"
msgstr "Аргх!"

#. ja: う、うぅ…！
#. de: Urgh ...
#. fr: Urgh...
msgctxt "NpcYell:7149:0:13"
msgid "Urgh..."
msgstr "У-у..."

#. ja: 耐えてみせる…！
#. de: Ich geb nicht auf!
#. fr: Je tiendrai<nbsp>!
msgctxt "NpcYell:7150:0:13"
msgid "Is that all you've got?"
msgstr "Это всё, на что ты способен?"

#. ja: 負けない…<br>絶対に！
#. de: Ich werde nicht verlieren! Niemals!
#. fr: Je ne perdrai pas<nbsp>! Jamais<nbsp>!
msgctxt "NpcYell:7151:0:13"
msgid "0"
msgstr "0"

#. ja: くぅ…！
#. de: Arrr!
#. fr: Argh<nbsp>!
msgctxt "NpcYell:7152:0:13"
msgid "0"
msgstr "0"

#. ja: 了解ッ！
#. de: Verstanden!
#. fr: Ça marche<nbsp>!
msgctxt "NpcYell:7153:0:13"
msgid "Right!"
msgstr "Есть!"

#. ja: 覚悟しなよ！
#. de: Jetzt gibt's Saures!
#. fr: Prépare-toi<nbsp>!
msgctxt "NpcYell:7154:0:13"
msgid "Ready!?"
msgstr "Ну что, готов?"

#. ja: 回復するよ！
#. de: Ich heile dich!
#. fr: Je m'occupe des soins<nbsp>!
msgctxt "NpcYell:7155:0:13"
msgid "I've got you!"
msgstr "Я тебя прикрою!"

