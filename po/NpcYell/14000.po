# NpcYell
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: よぉし、かかれッ！
#. de: Zu den Waffen!
#. fr: À l'attaque...<nbsp>!
msgctxt "NpcYell:14000:0:13"
msgid "To arms! To arms!"
msgstr "К оружию! К оружию!"

#. ja: 一匹も、逃がすなァ！
#. de: Lasst sie nicht entkommen!
#. fr: Ne les laissez pas s'enfuir...<nbsp>!
msgctxt "NpcYell:14001:0:13"
msgid "Let none escape!"
msgstr "Никого не выпускать!"

#. ja: たたみかけろォ！
#. de: Nieder mit ihnen!
#. fr: Clouez-les au sol...<nbsp>!
msgctxt "NpcYell:14002:0:13"
msgid "Strike them down!"
msgstr "Добейте их!"

#. ja: 喰われたくなきゃ<br>働けェ！
#. de: Kämpft! Kämpft oder ihr werdet gefressen!
#. fr: Activez-vous... ou vous serez dévorés aussi...<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14003:0:13"
msgid "Make yourselves useful<br>or you'll be food too!"
msgstr "Докажите, что от вас есть толк,<br>а то сами станете кормом!"

#. ja: 極上のエーテル…<br>城主様が喜ぶ！
#. de: Welch üppiges Mahl ... Dies wird der Herrin gefallen!
#. fr: Maîtresse... tout cet éther devrait être à votre goût...<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14004:0:13"
msgid "Such a sumptuous feast...<br>Mistress will be pleased!"
msgstr "Какой пир...<br>Госпожа будет довольна!"

#. ja: 行け、行けェ！
#. de: Zum Angriff!
#. fr: Pas de quartier...<nbsp>!
msgctxt "NpcYell:14005:0:13"
msgid "Have at them!"
msgstr "Вперёд, на них!"

#. ja: コイツら、喰えば<br>俺が、最強…！
#. de: Ihr Äther wird mich stärken!
#. fr: Votre éther va me rendre invincible...<nbsp>!
msgctxt "NpcYell:14006:0:13"
msgid "Their aether will make me strong!"
msgstr "Их эфир сделает меня сильнее!"

#. ja: オオセノママニ…
#. de: Wie Ihr wünscht ...
#. fr: Il en sera fait selon vos désirs...
msgctxt "NpcYell:14007:0:13"
msgid "As you wish..."
msgstr "Как пожелаете..."

#. ja: カシコマリマシタ！
#. de: Euer Wille geschehe!
#. fr: À vos ordres... Maîtresse...<nbsp>!
msgctxt "NpcYell:14008:0:13"
msgid "Your will be done!"
msgstr "Ваша воля будет исполнена!"

#. ja: オイシクチョウリ！
#. de: Ich bin sofort zur Stelle!
#. fr: Vous serez bientôt servie...
msgctxt "NpcYell:14010:0:13"
msgid "We will serve you up!"
msgstr "Мы подадим вас к столу!"

#. ja: スノーゲイムさんは<br>私から離れないで！
#. de: Bleib nahe bei mir, Snoegeim!
#. fr: Snoegeim, reste près de moi<nbsp>!
msgctxt "NpcYell:14011:0:13"
msgid "Stay close to me, Snoegeim!"
msgstr "Не отходи от меня, Снёгейм!"

#. ja: 油断は禁物よ…！
#. de: Seid auf der Hut!
#. fr: Restez sur vos gardes<nbsp>!
msgctxt "NpcYell:14012:0:13"
msgid "Be on your guard!"
msgstr "Будьте начеку!"

#. ja: い、いったい何が<br>起こってるんです！？
#. de: W-Was passiert hier!?
#. fr: Que se passe-t-il<nbsp>!?
msgctxt "NpcYell:14013:0:13"
msgid "Wh-What's happening!?"
msgstr "Ч-что здесь происходит?!"

#. ja: ふおおお…！<br>こんな仕掛けがあったなんて！
#. de: Welch ein erstaunlicher Mechanismus!
#. fr: Ouah<nbsp>! Je ne m'y attendais pas<nbsp>!
msgctxt "NpcYell:14014:0:13"
msgid "What an amazing mechanism!"
msgstr "Вот это механизм!"

#. ja: うふ…みんな元気に<br>かけっこしましょ…！
#. de: Mwaha! Lieber um die Wette laufen als in einem Teich ersaufen!
#. fr: Hin hin... Et si on jouait aux petits chevaux<nbsp>?
msgctxt "NpcYell:14015:0:13"
msgid "A-merrily we shall go!"
msgstr "А ну-ка, весело зашагаем!"

#. ja: さあ、出ておいで<br>お友達と遊びましょ…！
#. de: Fütterungszeit für unsere wilde Hoheit!
#. fr: Petits, petits<nbsp>! Venez jouer avec vos nouveaux amis<nbsp>!
msgctxt "NpcYell:14016:0:13"
msgid "Come out, come out, my animal friends!"
msgstr "Выходите, выходите, мои зверушки!"

#. ja: ほうら倒れろ<br>ガラガラ、ド～ン！
#. de: Dreh dich, dreh dich und dann fall um! Dadumm!
#. fr: C'est le moment de partir en roue libre<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:14017:0:13"
msgid "Oh, how the skywheel rises! But I wish to see it <i>fall</i>!"
msgstr "Ох, как высоко взлетает колесо! А теперь бы увидеть, как оно <i>рухнет</i>!"

#. ja: 人形たちも<br>お友達と遊ぶのよ…！
#. de: Bei Puppen fallen einem von den Augen die Schuppen!
#. fr: Mes poupées<nbsp>! Devinez qui est venu jouer avec vous<nbsp>?
msgctxt "NpcYell:14018:0:13"
msgid "We mustn't let the dolls miss out on the fun!"
msgstr "Нельзя же лишать кукол удовольствия!"

#. ja: お次は素敵なプレゼント…！
#. de: Hier, ein Geschenk! Ganz ohne Hüftgelenk!
#. fr: Vous voulez un cadeau en souvenir<nbsp>?
msgctxt "NpcYell:14019:0:13"
msgid "We've plenty of presents for you..."
msgstr "У нас для вас полно подарков..."

#. ja: 家具でつぶれて<br>ぺっちゃんこ…！
#. de: Unterm Tisch, wen seh ich da? Bist du das etwa, kleiner Narr?
#. fr: On va vous montrer comment on meuble la con<shy>ver<shy>sa<shy>tion<nbsp>!
msgctxt "NpcYell:14020:0:13"
msgid "Begone, trespassers!"
msgstr "Прочь, незваные гости!"

#. ja: ケヒャ、ヒャ、ヒャ…
#. de: Kihihaha<nbsp>...
#. fr: Mouahahahaha<nbsp>!
msgctxt "NpcYell:14021:0:13"
msgid "Something must be done!"
msgstr "Надо же что-то делать!"

#. ja: ナイスヘッド！
#. de: Schönkopf!
#. fr: Vive Boubouille<nbsp>!
msgctxt "NpcYell:14022:0:13"
msgid "For His Royal Headness!"
msgstr "За его королевское величество!"

#. ja: アタマ、アタマ…<br>ステキなアタマ！
#. de: Kopf, Kopf, Kopf! Pack ihn beim Schopf!
#. fr: Des bonnes bouilles, des bonnes bouilles, toujours des bonnes bouilles<nbsp>!
msgctxt "NpcYell:14023:0:13"
msgid "Bow down!"
msgstr "Кланяйтесь!"

#. ja: アナタもナカマ！<br>ステキなナカマ！
#. de: Auch ein Kopf kann entzücken und darum muss man ihn pflücken!
#. fr: Vous êtes nos amis, maintenant<nbsp>! Pour toute la mort<nbsp>!
msgctxt "NpcYell:14024:0:13"
msgid "Join us..."
msgstr "Присоединяйтесь к нам..."

#. ja: 楽しく怖い…<br>怖くて楽しい…
#. de: Schaurig, spaßig, gruselig, gut, der Spuk liegt mir halt im Blut!
#. fr: Avoir peur, c'est rigolo<nbsp>! Faire peur, encore plus<nbsp>!
msgctxt "NpcYell:14025:0:13"
msgid "How thrilling! How chilling!"
msgstr "Как захватывает дух! Как пробирает до костей!"

#. ja: 遊ぼう、遊ぼう<br>消えるまで…！
#. de: Spielen, spielen bis zum Schluss, auch wenn ich dich in Ketten legen muss!
#. fr: Jouons, jouons<nbsp>! Jusqu'à ce qu'on disparaisse tous<nbsp>!
msgctxt "NpcYell:14026:0:13"
msgid "We'll frolic and play, until our dying day!♪"
msgstr "Будем веселиться и играть, пока не настанет наш последний час!♪"

#. ja: アハハハハハハ…<br>楽しいねぇ…！
#. de: Hahaha, so lach' ich drein. Steck all mein Können in diesen Reim!
#. fr: Ah ha ha ha ha ha ha<nbsp>! Qu'est-ce qu'on s'amuse<nbsp>!
msgctxt "NpcYell:14027:0:13"
msgid "Ahaha! Oh, what fun!"
msgstr "А-ха-ха! Вот это веселье!"

#. ja: さっき見かけた人影<br>まさかとは思うが…
#. de: War das etwa<nbsp>...?
#. fr: Je viens de voir passer une ombre... Ne me dites pas que...
msgctxt "NpcYell:14028:0:13"
msgid "Could that have been─?"
msgstr "Неужели это был..."

#. ja: ああ、やっぱりそうだ<br>手配書のあいつだ…！
#. de: Nein, das kann nicht sein<nbsp>... Oder etwa doch?
#. fr: Ah<nbsp>! J'avais vu juste<nbsp>! C'est bien lui<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:14029:0:13"
msgid "No, it couldn't have... Or <i>could</i> it?"
msgstr "Нет, не может быть... А <i>может</i>?"

#. ja: 賞金首ダーテカ！<br>生きていたのか！
#. de: Ich dachte, der Scheißkerl sei längst tot!
#. fr: Zawtekwa... Tout le monde le croyait mort<nbsp>!
msgctxt "NpcYell:14030:0:13"
msgid "They said the bastard was dead... Unless..."
msgstr "Говорили, этот ублюдок давно мёртв... Или..."

#. ja: 誰か…<br>ヤツを倒せる人は…
#. de: Ganz offensichtlich ja nicht!
#. fr: Vite... Que quelqu'un l'arrête<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:14031:0:13"
msgid "They were <i>wrong</i>!"
msgstr "Они <i>ошибались</i>!"

#. ja: 逃げ出さねぇとは<br>いい度胸だぜ
#. de: Keine Angst vor Geistern, was? Ha, aber nicht mehr lange!
#. fr: Ben alors, on fuit pas<nbsp>? Hah<nbsp>! Ça, c'est du courage<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:14032:0:13"
msgid "Not afraid of ghosts, eh? Well you <i>should</i> be!"
msgstr "Призраков не боишься, а? А зря <i>стоило бы</i>!"

#. ja: 賞金首の討伐<br>頼んだぞ…！
#. de: Viel Glück!
#. fr: Je te confie le combat<nbsp>! Bonne chance<nbsp>!
msgctxt "NpcYell:14033:0:13"
msgid "Good luck! And don't forget the head!"
msgstr "Удачи! И не забудь голову!"

#. ja: 久しぶりに<br>暴れてやるか…！
#. de: Ah, das wird ein Spaß.
#. fr: J'me suis pas lâché depuis un bail<nbsp>!
msgctxt "NpcYell:14034:0:13"
msgid "I'm going to enjoy this."
msgstr "Ну, сейчас я оторвусь."

#. ja: オラァ！
#. de: War das schon alles?!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:14035:0:13"
msgid "Is that all?"
msgstr "И это всё?"

#. ja: 食らいやがれ！
#. de: Ich will Schreie hören!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:14036:0:13"
msgid "I want to hear you squeal!"
msgstr "Хочу услышать, как ты взвоёшь!"

#. ja: いいぞ！<br>その調子だ！
#. de: Nur weiter!
#. fr: Bien<nbsp>! Continue<nbsp>!
msgctxt "NpcYell:14037:0:13"
msgid "Go on! That's the spirit!"
msgstr "Давай! Вот так!"

#. ja: 頑張れ！<br>倒せるぞ！
#. de: Macht ihn fertig!
#. fr: Courage<nbsp>! Tu vas l'avoir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14038:0:13"
msgid "What are you waiting for?<br>Finish the bastard!"
msgstr "Чего ждёте?<br>Прикончите ублюдка!"

#. ja: クソッ…<br>なんて強さだ…
#. de: Grh, verdammt<nbsp>...
#. fr: Argh... Quelle force<nbsp>!
msgctxt "NpcYell:14039:0:13"
msgid "You think...this is the end...?"
msgstr "Думаешь... это конец...?"

#. ja: 雑魚が…<br>こんなもんかよ
#. de: Wer ist als Nächstes dran?
#. fr: Hmpf... Un sbire, rien de plus<nbsp>!
msgctxt "NpcYell:14040:0:13"
msgid "Alright. Who's next?"
msgstr "Так. Кто следующий?"

#. ja: すげえ！<br>賞金首を倒しちまった！
#. de: E-Er ist gefallen! Er ist wirklich gefallen!
#. fr: Incroyable<nbsp>! Tu l'as eu<nbsp>!
msgctxt "NpcYell:14041:0:13"
msgid "You did it? I mean, you did it!"
msgstr "Получилось? То есть, ты и правда его одолел!"

#. ja: ありがとう<br>本当に助かった
#. de: Die Stadt ist gerettet! Zawtekwa ist tot!
#. fr: Merci<nbsp>! C'était incroyable<nbsp>!
msgctxt "NpcYell:14042:0:13"
msgid "The town is saved! Zawtekwa the Undertaken is─"
msgstr "Город спасён! Завтеква Невыполненный..."

#. ja: これで荒野の平和が<br>保たれたってものさ！
#. de: Jetzt kann Shaaloani wieder aufatmen!
#. fr: On a réussi à préserver la paix dans les plaines<nbsp>!
msgctxt "NpcYell:14043:0:13"
msgid "Hm? Where's the body...!?"
msgstr "Хм? А где тело...?!"

#. ja: に、逃げろ…！<br>自警団に通報を…！
#. de: Neeein, nicht mich!
#. fr: F-fuyez tous<nbsp>! Je m'en vais prévenir la milice<nbsp>!
msgctxt "NpcYell:14044:0:13"
msgid "Not me!!!"
msgstr "Только не я!!!"

#. ja: やらせねぇ！
#. de: Bis hierhin und nicht weiter!
#. fr: On se laissera pas faire<nbsp>!
msgctxt "NpcYell:14045:0:13"
msgid "Not so fast!"
msgstr "Не так быстро!"

#. ja: 負けないぞ！
#. de: Nicht mit mir!
#. fr: Tous unis pour Tréno<nbsp>!
msgctxt "NpcYell:14046:0:13"
msgid "For Treno!"
msgstr "За Трено!"

#. ja: はぁはぁ…！
#. de: Hrng ...
#. fr: Haa... Haa...<nbsp>!
msgctxt "NpcYell:14047:0:13"
msgid "I'm beat...\\<wheeze>"
msgstr "Я выдохся...\\<wheeze>"

#. ja: 手助けありがとよ！
#. de: Danke für die Hilfe!
#. fr: Merci pour votre aide<nbsp>!
msgctxt "NpcYell:14048:0:13"
msgid "Thanks for the help!"
msgstr "Спасибо, что помогли!"

#. ja: 大丈夫か？
#. de: Alles in Ordnung?
#. fr: Ça va<nbsp>!?
msgctxt "NpcYell:14049:0:13"
msgid "You alright?"
msgstr "Ты в порядке?"

#. ja: なんとかな…
#. de: Halbwegs, ja ...
#. fr: C'était moins une...
msgctxt "NpcYell:14050:0:13"
msgid "Still got all my limbs..."
msgstr "Вроде все конечности на месте..."

#. ja: まだ、終われるものかよ…！
#. de: Nein ... Ich darf hier nicht fallen.
#. fr: Ç-ça ne peut pas finir comme ça<nbsp>!
msgctxt "NpcYell:14051:0:13"
msgid "No... I cannot fall here."
msgstr "Нет... Я не могу здесь пасть."

#. ja: はああっ！
#. de: Haaah!
#. fr: Haaaah<nbsp>!
msgctxt "NpcYell:14052:0:13"
msgid "Haaah!"
msgstr "Ха-а-а!"

#. ja: 逃しはしないっ！
#. de: Du wirst nicht entkommen!
#. fr: Personne ne peut m'échapper<nbsp>!
msgctxt "NpcYell:14053:0:13"
msgid "You'll not escape!"
msgstr "Не уйдёшь!"

#. ja: 凍えるがいいっ！
#. de: Dein Blut soll gefrieren!
#. fr: Que ton corps devienne glace<nbsp>!
msgctxt "NpcYell:14054:0:13"
msgid "Your blood shall freeze!"
msgstr "Замёрзни же!"

#. ja: シヴァよ、力を貸して！
#. de: Helft mir, Shiva!
#. fr: Shiva, aide-moi<nbsp>!
msgctxt "NpcYell:14055:0:13"
msgid "Shiva, aid me!"
msgstr "Шива, помоги мне!"

#. ja: すべてを凍て付かせよっ！
#. de: 0
#. fr: 0
msgctxt "NpcYell:14056:0:13"
msgid "0"
msgstr "0"

#. ja: 氷結の静寂をっ！
#. de: Eis wird dein Grab sein!
#. fr: La glace sera ton tombeau<nbsp>!
msgctxt "NpcYell:14057:0:13"
msgid "Ice shall be your tomb!"
msgstr "Лёд станет твоей могилой!"

#. ja: 反撃開始だ…！
#. de: Dafür werden sie bezahlen!
#. fr: C'est l'heure de la riposte<nbsp>!
msgctxt "NpcYell:14058:0:13"
msgid "They will pay for that!"
msgstr "За это они заплатят!"

#. ja: 退くことなどできん！
#. de: Ich weiche nicht!
#. fr: Je ne plierai pas<nbsp>!
msgctxt "NpcYell:14059:0:13"
msgid "I will not yield!"
msgstr "Я не отступлю!"

#. ja: なめるなぁぁっ！
#. de: Ha! Wie unvorsichtig.
#. fr: En plein dans le mille<nbsp>!
msgctxt "NpcYell:14060:0:13"
msgid "Your guard is down!"
msgstr "Не недооценивай меня!"

#. ja: 思い知れっ！
#. de: Ich bin dein Meister!
#. fr: Ta folie te perdra<nbsp>!
msgctxt "NpcYell:14061:0:13"
msgid "Know your folly!"
msgstr "Познай свою ошибку!"

#. ja: 誓いの槍よっ！
#. de: Bei meiner Lanze!
#. fr: Lance, pourfends mon ennemi<nbsp>!
msgctxt "NpcYell:14062:0:13"
msgid "Taste my lance!"
msgstr "Отведай моего копья!"

#. ja: 今、楽にしてやろうっ！
#. de: Ich erlöse dich!
#. fr: C'en est fini de toi<nbsp>!
msgctxt "NpcYell:14063:0:13"
msgid "I will end your struggles!"
msgstr "Я избавлю тебя от страданий!"

#. ja: 竜の眼の力よ！
#. de: 0
#. fr: 0
msgctxt "NpcYell:14064:0:13"
msgid "0"
msgstr "0"

#. ja: この力、御してみせる！
#. de: 0
#. fr: 0
msgctxt "NpcYell:14065:0:13"
msgid "0"
msgstr "Я укрощу эту силу!"

#. ja: 反撃といくか…
#. de: 0
#. fr: 0
msgctxt "NpcYell:14066:0:13"
msgid "0"
msgstr "Пора контратаковать..."

#. ja: これ程とはっ！
#. de: Ich muss mich zusammenreißen!
#. fr: Je dois me ressaisir<nbsp>!
msgctxt "NpcYell:14067:0:13"
msgid "Pull yourself together!"
msgstr "Возьми себя в руки!"

#. ja: 魔力よ、奔れっ！
#. de: Zauber, vernichte!
#. fr: À moi, magie des anciens<nbsp>!
msgctxt "NpcYell:14068:0:13"
msgid "Focus...release!"
msgstr "Сосредоточение... высвободить!"

#. ja: 邪魔をするなっ！
#. de: Aus dem Weg!
#. fr: Hors de ma vue<nbsp>!
msgctxt "NpcYell:14069:0:13"
msgid "Away with you!"
msgstr "Прочь с дороги!"

#. ja: 私にだって、これくらいは！
#. de: Meine leichteste Übung!
#. fr: Voilà pour vous<nbsp>!
msgctxt "NpcYell:14070:0:13"
msgid "I have my pride..."
msgstr "И я кое-что умею!"

#. ja: ルヴェユールの名にかけて！
#. de: Aus dem Weg!
#. fr: Pour l'honneur des Leveilleur<nbsp>!
msgctxt "NpcYell:14071:0:13"
msgid "For the house of Leveilleur!"
msgstr "Во имя дома Левейер!"

#. ja: サリャクの英知よ、ここにっ！
#. de: Thaliak, steh mir bei!
#. fr: Thaliak, protège-moi<nbsp>!
msgctxt "NpcYell:14072:0:13"
msgid "Thaliak protect me!"
msgstr "Талиак, защити меня!"

#. ja: 切り札を使わせてもらう！
#. de: 0
#. fr: 0
msgctxt "NpcYell:14073:0:13"
msgid "0"
msgstr "0"

#. ja: 助かったよ…
#. de: 0
#. fr: 0
msgctxt "NpcYell:14074:0:13"
msgid "0"
msgstr "0"

#. ja: 耐えてみせるぞっ！
#. de: Ich falle nicht!
#. fr: Je ne flancherai pas<nbsp>!
msgctxt "NpcYell:14075:0:13"
msgid "Hold fast!"
msgstr "Я выдержу!"

#. ja: フハハハハッ！
#. de: Komm doch!
#. fr: Viens par ici<nbsp>!
msgctxt "NpcYell:14076:0:13"
msgid "Come!"
msgstr "Иди сюда!"

#. ja: セイッ、セイッ、セイィィッ！
#. de: Nimm dies!
#. fr: Yahaaaaah<nbsp>!
msgctxt "NpcYell:14077:0:13"
msgid "Have at thee!"
msgstr "Получай!"

#. ja: 見ていろ、我が友よ！
#. de: Sieh her!
#. fr: Regardez ça, vous autres<nbsp>!
msgctxt "NpcYell:14078:0:13"
msgid "Bear witness!"
msgstr "Смотри, друг мой!"

#. ja: 輝け、我が剣！
#. de: Führe mein Schwert, Halone!
#. fr: Halone, guide mon épée<nbsp>!
msgctxt "NpcYell:14079:0:13"
msgid "Halone, guide my sword!"
msgstr "Халонэ, направь мой меч!"

#. ja: 少しはイイところを見せんとな！
#. de: Einer meiner Lieblingstricks!
#. fr: Tu ne t'en remettras pas<nbsp>!
msgctxt "NpcYell:14080:0:13"
msgid "I shall show you something special!"
msgstr "Сейчас я покажу тебе кое-что особенное!"

#. ja: 受けよ、我が妙技！
#. de: Ehre den Fortemps!
#. fr: Pour la gloire des Fortemps<nbsp>!
msgctxt "NpcYell:14081:0:13"
msgid "For the honor of House Fortemps!"
msgstr "Во славу дома Фор-Тэмп!"

#. ja: 助かった、もう一度ゆくぞ！
#. de: Vielen Dank!
#. fr: J'y retourne<nbsp>!
msgctxt "NpcYell:14082:0:13"
msgid "Thank you, my friend."
msgstr "Спасибо, друг мой."

#. ja: 渾身の一撃をくらえ！
#. de: Schmecke meinen Stahl!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:14083:0:13"
msgid "Taste my steel!"
msgstr "Отведай моей стали!"

#. ja: 我が槍さばきを見よ！
#. de: Bewundere meine Technik!
#. fr: Admire ma technique<nbsp>!
msgctxt "NpcYell:14084:0:13"
msgid "I'll run you through!"
msgstr "Сейчас я тебя пронжу!"

#. ja: 見切れるものか！
#. de: Jetzt habe ich dich!
#. fr: Je ne te louperai pas<nbsp>!
msgctxt "NpcYell:14085:0:13"
msgid "I have you now!"
msgstr "Теперь ты мой!"

#. ja: いまこそ限界を超える！
#. de: Dies endet hier!
#. fr: Je vais tout donner<nbsp>!
msgctxt "NpcYell:14086:0:13"
msgid "This ends here!"
msgstr "Здесь всё и закончится!"

#. ja: 負けてなるものか…
#. de: Ich muss ... durchhalten<nbsp>...
#. fr: Je dois tenir le coup...
msgctxt "NpcYell:14087:0:13"
msgid "I must...hold on..."
msgstr "Я должен... продержаться..."

#. ja: 反撃開始だ！
#. de: Bereit zum Konter!
#. fr: Prêt à contre-attaquer<nbsp>!
msgctxt "NpcYell:14088:0:13"
msgid "Back to the fray!"
msgstr "В бой!"

#. ja: 戦神の怒りを受けよ！
#. de: Halone, verleihe mir Stärke!
#. fr: Goûte à la fureur de Halone<nbsp>!
msgctxt "NpcYell:14089:0:13"
msgid "Halone, grant me strength!"
msgstr "Халонэ, даруй мне силу!"

#. ja: 神殿騎士の名にかけて！
#. de: Ich schlage dich in Halones Namen!
#. fr: Je vaincrai au nom des templiers<nbsp>!
msgctxt "NpcYell:14090:0:13"
msgid "In Halone's name, I strike thee!"
msgstr "Во имя Халонэ я поражу тебя!"

#. ja: この一撃ならば！
#. de: Du wirst dem nicht entkommen!
#. fr: Fais tes prières<nbsp>!
msgctxt "NpcYell:14091:0:13"
msgid "You'll not escape this!"
msgstr "От этого тебе не уйти!"

#. ja: 戦神よ、ご照覧あれ！
#. de: Halone, führe meine Hand!
#. fr: Ô Halone<nbsp>! Guide mon épée<nbsp>!
msgctxt "NpcYell:14092:0:13"
msgid "Halone, guide my hand!"
msgstr "Халонэ, направь мою руку!"

#. ja: 戦神の大盾の如く！
#. de: Beschütze mich, Halone!
#. fr: Ô Halone<nbsp>! Accorde-moi ta protection<nbsp>!
msgctxt "NpcYell:14093:0:13"
msgid "Halone, protect me!"
msgstr "Халонэ, защити меня!"

#. ja: これが戦神の御心か…！
#. de: Halone ist mir wohlgesinnt.
#. fr: Halone m'a donné sa bénédiction...
msgctxt "NpcYell:14094:0:13"
msgid "The Fury smiles upon me."
msgstr "Ярость благоволит мне."

#. ja: 攻撃、いきますよ！
#. de: Unnachgiebige Erde!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:14095:0:13"
msgid "Unyielding earth!"
msgstr "Несокрушимая земля!"

#. ja: 旋風、受けてください！
#. de: Ich rufe den Wind an!
#. fr: Le vent est avec moi<nbsp>!
msgctxt "NpcYell:14096:0:13"
msgid "I call upon the wind!"
msgstr "Призываю ветер!"

#. ja: 皆さんに癒しの力を！
#. de: Nur Mut, wir werden siegen!
#. fr: Que vos maux guérissent<nbsp>!
msgctxt "NpcYell:14097:0:13"
msgid "Take heart─we will prevail!"
msgstr "Не падайте духом — мы победим!"

#. ja: さあ、戦いはこれからです！
#. de: Komm schon! Wir haben grad erst angefangen.
#. fr: Le combat ne fait que commencer<nbsp>!
msgctxt "NpcYell:14098:0:13"
msgid "Come! We've only just begun."
msgstr "Вперёд! Всё только начинается."

#. ja: ま、まだまだ…戦えます…
#. de: Ich ... Ich kann noch immer kämpfen ...
#. fr: Je peux encore... me battre...
msgctxt "NpcYell:14099:0:13"
msgid "I... I can still fight..."
msgstr "Я... я ещё могу сражаться..."

#. ja: 気を取りなおして、いきます！
#. de: Ich werde diese zweite Chance nicht vergeuden.
#. fr: Cette fois, je vaincrai<nbsp>!
msgctxt "NpcYell:14100:0:13"
msgid "I will not waste this second chance."
msgstr "Я не упущу этот второй шанс."

#. ja: 受けてみろ！
#. de: Erwischt!
#. fr: Voilà pour vous<nbsp>!
msgctxt "NpcYell:14101:0:13"
msgid "This will hurt."
msgstr "Больно будет."

#. ja: くらえ！
#. de: Nieder mit dir!
#. fr: Finissons-en<nbsp>!
msgctxt "NpcYell:14102:0:13"
msgid "Got you!"
msgstr "Попался!"

#. ja: ここで消えてもらう！
#. de: In die Vergessenheit!
#. fr: Hors de mon chemin<nbsp>!
msgctxt "NpcYell:14103:0:13"
msgid "That's far enough!"
msgstr "Дальше не пройдёшь!"

#. ja: この力で排除する！
#. de: Du bist mir nicht gewachsen!
#. fr: Disparaissez<nbsp>!
msgctxt "NpcYell:14104:0:13"
msgid "Begone!"
msgstr "Прочь!"

#. ja: 闇の力を見せてやろう…
#. de: Ich zeige dir wahre Dunkelheit!
#. fr: Admirez le pouvoir des Ténèbres<nbsp>!
msgctxt "NpcYell:14105:0:13"
msgid "Darkness take you."
msgstr "Да поглотит тебя Тьма."

#. ja: 私が「終わり」を<br>与えてやる…！
#. de: Dein Äther ist mein!
#. fr: Il est grand temps d'en finir<nbsp>!
msgctxt "NpcYell:14106:0:13"
msgid "I am your end."
msgstr "Я положу этому конец!"

#. ja: びしゃーケロ！
#. de: Quaaak!
#. fr: Coâââ<nbsp>!
msgctxt "NpcYell:14107:0:13"
msgid "Yah, ribbit!"
msgstr "На, квак!"

#. ja: ぶしゃーケロ！
#. de: Quaak, quaak!
#. fr: Coâ coâââ<nbsp>!!
msgctxt "NpcYell:14108:0:13"
msgid "Hyah, ribbit!"
msgstr "На-ка, квак!"

#. ja: ぶわっしゃーケロ！
#. de: Qua-quak! Quaak!
#. fr: Coâ coâ coâââ<nbsp>!!!
msgctxt "NpcYell:14109:0:13"
msgid "Hyaaagh, ribbit!"
msgstr "Получай, квак!"

#. ja: し、しんどいケロ…
#. de: S-So anstregend, quaaak!
#. fr: Ça devient dur, coâââ...
msgctxt "NpcYell:14110:0:13"
msgid "I feel faint, ribbit..."
msgstr "Сил нет, квак..."

#. ja: 消えずにすんだケロ…！
#. de: D-Das war knapp, quaak!
#. fr: Je l'ai échappé belle, coâââ<nbsp>!
msgctxt "NpcYell:14111:0:13"
msgid "That was a close call, ribbit!"
msgstr "Чуть не пропал, квак!"

#. ja: はぁぁぁぁ…！
#. de: Haaah!
#. fr: Haaaah<nbsp>!
msgctxt "NpcYell:14112:0:13"
msgid "Haaah!"
msgstr "А-а-а!.."

#. ja: やぁぁぁぁ…！
#. de: Yaaah!
#. fr: Yaaaah<nbsp>!
msgctxt "NpcYell:14113:0:13"
msgid "Yaaah!"
msgstr "Я-а-а!.."

#. ja: やっつけるわよ！
#. de: Ich mach's kurz!
#. fr: Ça fait mal, hein<nbsp>?
msgctxt "NpcYell:14114:0:13"
msgid "I shall make it quick!"
msgstr "Я быстро с тобой разделаюсь!"

#. ja: 解き放たん！
#. de: Mächte, seid entfesselt!
#. fr: Je n'aban<shy>don<shy>ne<shy>rai pas<nbsp>!
msgctxt "NpcYell:14115:0:13"
msgid "Have at you!"
msgstr "Получай!"

#. ja: エーテルよ…集え！
#. de: Zu mir, Äther!
#. fr: Éther, prête-moi ta force<nbsp>!
msgctxt "NpcYell:14116:0:13"
msgid "Aether, to me!"
msgstr "Эфир, ко мне!"

#. ja: ギッタギタにしてやる…！
#. de: Ich mach dich fertig!
#. fr: Je vais vous découper en rondelles<nbsp>!
msgctxt "NpcYell:14117:0:13"
msgid "I'll cut you down to size!"
msgstr "Я тебя в порошок сотру!"

#. ja: ぶん回す…！
#. de: Bereit, zu fliegen<nbsp>...?
#. fr: Fini de jouer<nbsp>!
msgctxt "NpcYell:14118:0:13"
msgid "Ready or not!"
msgstr "Готовься, сейчас полетишь!"

#. ja: 俺の力を見ろっ！
#. de: Ich bin der Stärkste!
#. fr: Je suis le plus fort<nbsp>!
msgctxt "NpcYell:14119:0:13"
msgid "Feel my power!"
msgstr "Почувствуй мою силу!"

#. ja: おらぁぁぁっ！
#. de: Graaaah!
#. fr: Graaaah<nbsp>!!
msgctxt "NpcYell:14120:0:13"
msgid "Graaaaaagh!"
msgstr "Гр-р-р-а-а-а!"

#. ja: 耐えきってみせる…！
#. de: Ich werde nicht aufgeben<nbsp>...!
#. fr: Je peux pas abandonner maintenant...
msgctxt "NpcYell:14121:0:13"
msgid "It's not over yet!"
msgstr "Это ещё не конец!"

#. ja: さあ、仕切り直しだ…
#. de: Also dann, auf ein Neues<nbsp>...
#. fr: Allez, c'est reparti<nbsp>!
msgctxt "NpcYell:14122:0:13"
msgid "Again from the top!"
msgstr "Ну что, начнём сначала..."

#. ja: あったれ～
#. de: Nicht verfehlen!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:14123:0:13"
msgid "Strike true!"
msgstr "Попади-ка!"

#. ja: 燃やし尽くすぞ～！
#. de: Ausbrennen sollt ihr!
#. fr: Je vais vous calciner<nbsp>!
msgctxt "NpcYell:14124:0:13"
msgid "To cinders with you!"
msgstr "Сожгу вас дотла!"

#. ja: くらえ、炎熱～
#. de: Spürt die flammende Hitze!
#. fr: Attention, ça va chauffer<nbsp>!
msgctxt "NpcYell:14125:0:13"
msgid "I hope you like it scorching!"
msgstr "Ну-ка, обожгись!"

#. ja: 全力でいくよ～！
#. de: Mit voller Kraft voraus!
#. fr: Je ne faiblirai pas<nbsp>!
msgctxt "NpcYell:14126:0:13"
msgid "Pulling out all the stops!"
msgstr ""

#. ja: 魔力を放出するぞ～…！
#. de: Entfessle dich, mein Zauber<nbsp>...!
#. fr: Mes sorts auront raison de vous<nbsp>!
msgctxt "NpcYell:14127:0:13"
msgid "Wreak havoc, my magicks!"
msgstr "Разгуляйтесь, мои чары!"

#. ja: 負けてたまるか～
#. de: Als ob ich hier verlieren würde!
#. fr: Non... Je ne peux pas perdre<nbsp>!
msgctxt "NpcYell:14128:0:13"
msgid "I won't fall here!"
msgstr "Я здесь не паду!"

#. ja: ここから挽回だ～！
#. de: Jetzt wird der Spieß umgedreht!
#. fr: Vous croyiez m'avoir<nbsp>? Dommage<nbsp>!
msgctxt "NpcYell:14129:0:13"
msgid "Time to turn the tide!"
msgstr "Пора переломить ход боя!"

#. ja: 足手まといにはならない…！
#. de: Ihr könnt euch auf mich verlassen!
#. fr: Vous pouvez compter sur moi<nbsp>!
msgctxt "NpcYell:14130:0:13"
msgid "I will pull my weight!"
msgstr "Я не стану обузой!"

#. ja: その身に、喰らいなさい！
#. de: Das war's für dich!
#. fr: En plein dans le mille<nbsp>!
msgctxt "NpcYell:14131:0:13"
msgid "Prepare yourself!"
msgstr "Приготовься!"

#. ja: 私なら…できる！
#. de: Ich schaff das!
#. fr: Je peux le faire<nbsp>!
msgctxt "NpcYell:14132:0:13"
msgid "I can do it!"
msgstr "Я смогу!"

#. ja: この槍を、自分を、信じて…！
#. de: Gib mir Kraft, mein Speer<nbsp>...!
#. fr: Ma lance, prête-moi ta force<nbsp>!
msgctxt "NpcYell:14133:0:13"
msgid "Trust yourself, and trust your spear!"
msgstr "Копьё, верю в тебя... и в себя!"

#. ja: 私の力を結集させる！
#. de: Bring all deine Kräfte zusammen!
#. fr: Vous n'en réchapperez pas<nbsp>!
msgctxt "NpcYell:14134:0:13"
msgid "My all, I bring to bear!"
msgstr "Вложу все силы!"

#. ja: ちょっと、まずいかも…
#. de: Das könnte brenzlig werden<nbsp>...
#. fr: Ça sent le roussi...
msgctxt "NpcYell:14135:0:13"
msgid "Not good..."
msgstr "Плохо дело..."

#. ja: ここから立て直さないと
#. de: Ich muss wieder die Oberhand gewinnen<nbsp>...!
#. fr: Je tiendrai le coup cette fois<nbsp>!
msgctxt "NpcYell:14136:0:13"
msgid "We must regroup."
msgstr "Надо перегруппироваться."

#. ja: 攻撃だって、やってみせるさ
#. de: Dir zeig ich, was ich alles drauf hab!
#. fr: Vous allez voir de quoi je suis capable<nbsp>!
msgctxt "NpcYell:14137:0:13"
msgid "I can dish it out too if needs be!"
msgstr "Я тоже могу атаковать, если надо!"

#. ja: スキは逃さない！
#. de: Ha, erwischt!
#. fr: C'est le moment<nbsp>!
msgctxt "NpcYell:14138:0:13"
msgid "I never miss an opening!"
msgstr "Я не упущу шанс!"

#. ja: 広がれ、癒やしよ！
#. de: Heilende Winde, erhebt euch!
#. fr: Laissez-moi soigner vos blessures<nbsp>!
msgctxt "NpcYell:14139:0:13"
msgid "Healing winds, bring succor to all!"
msgstr "Целительный ветер, помоги всем!"

#. ja: まだ、やれるだろう…？
#. de: Du kannst noch kämpfen, oder<nbsp>...?
#. fr: C'est pas terminé<nbsp>!
msgctxt "NpcYell:14140:0:13"
msgid "There's still fight left in you!"
msgstr "Ты ведь ещё можешь сражаться?"

#. ja: ギリギリまで、戦う…！
#. de: Ich kämpfe bis zum letzten Atemzug<nbsp>...!
#. fr: Il faut que je tienne bon...
msgctxt "NpcYell:14141:0:13"
msgid "I must hold on!"
msgstr "Надо продержаться!"

#. ja: 不甲斐ないな…
#. de: Ha, als ob das klappen würde!
#. fr: Je ne me ferai plus avoir<nbsp>!
msgctxt "NpcYell:14142:0:13"
msgid "Not my best showing..."
msgstr "Плохо я справляюсь..."

#. ja: 押されているのか…！？
#. de: Langsam wird es eng<nbsp>...
#. fr: Ça se présente mal...
msgctxt "NpcYell:14143:0:13"
msgid "More than I bargained for..."
msgstr "Неужто мы проигрываем?.."

#. ja: そこだ！
#. de: Und los!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:14144:0:13"
msgid "There!"
msgstr "Вот!"

#. ja: こいつでどうだ？
#. de: Wie wär's hiermit?
#. fr: Qu'est-ce que tu dis de ça<nbsp>?
msgctxt "NpcYell:14145:0:13"
msgid "Try this!"
msgstr "А ну-ка, попробуй это!"

#. ja: 確実に決める！
#. de: Schluss mit lustig!
#. fr: Je ne louperai pas mon coup<nbsp>!
msgctxt "NpcYell:14146:0:13"
msgid "No mistakes!"
msgstr "Ошибки недопустимы!"

#. ja: 荒っぽくいくぞ！
#. de: Mach dich auf was gefasst!
#. fr: Je vais me lâcher<nbsp>!
msgctxt "NpcYell:14147:0:13"
msgid "I won't be gentle!"
msgstr "Церемониться не буду!"

#. ja: いくぞ！
#. de: Mein Auftritt!
#. fr: Maintenant<nbsp>!
msgctxt "NpcYell:14148:0:13"
msgid "Not so fast!"
msgstr "Не так быстро!"

#. ja: 甘く見るなよ！
#. de: Unterschätz mich nicht!
#. fr: Il ne faut pas me sous-estimer<nbsp>!
msgctxt "NpcYell:14149:0:13"
msgid "Don't underestimate me!"
msgstr "Не недооценивай меня!"

#. ja: 手を貸すよ！
#. de: Bin schon zur Stelle!
#. fr: Laissez-moi vous aider<nbsp>!
msgctxt "NpcYell:14150:0:13"
msgid "Allow me to aid you!"
msgstr "Позволь помочь!"

#. ja: あれは…！
#. de: Oh nein ... Halt aus!
#. fr: Vite, là-bas<nbsp>!
msgctxt "NpcYell:14151:0:13"
msgid "Thunderous heavens..."
msgstr "Грозовые небеса..."

#. ja: おお！？どちら様だ！？<br>だが助かったぜ！
#. de: Unbekannte Retter?! Da sag ich nicht nein!
#. fr: J'ignore qui vous êtes, mais merci pour votre aide<nbsp>!
msgctxt "NpcYell:14152:0:13"
msgid "Who in the world are y─ I mean, thanks!"
msgstr "Ты кто такой был?.. То есть, спасибо, что помог!"

#. ja: トドメだっ！
#. de: Und der Gnadenstoß!
#. fr: Et voilà le coup de grâce<nbsp>!
msgctxt "NpcYell:14154:0:13"
msgid "Got you!"
msgstr "Добивающий удар!"

#. ja: さあ<br>冒険の始まりじゃ！
#. de: Lass uns mit der Expedition beginnen!
#. fr: En route pour l'aventure<nbsp>!
msgctxt "NpcYell:14162:0:13"
msgid "Let the expedition begin!"
msgstr "Пусть начнётся экспедиция!"

#. ja: かなり臭うな…<br>服に染み込みそうじゃ
#. de: Welch ein Gestank ...<br>Ich werde diese Klamotten verbrennen müssen.
#. fr: Quelle odeur immonde... Vivement notre prochain bain<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14163:0:13"
msgid "What a stench...<br>I shall have to burn these clothes."
msgstr "Фу, какая вонь...<br>Придётся одежду сжечь."

#. ja: むむっ！<br>ここにも魔物が！
#. de: Vorsicht!<br>Die Große sieht gefährlich aus!
#. fr: Oh là là, encore des monstres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14164:0:13"
msgid "Careful!<br>That big one looks nasty!"
msgstr "Осторожно!<br>Вон тот здоровяк выглядит опасно!"

#. ja: ●削除：うう…<br>すまぬ、先行してくれ…
#. de: 0
#. fr: 0
msgctxt "NpcYell:14165:0:13"
msgid "0"
msgstr "0"

#. ja: いったいどれだけ<br>棲みついておるのか…
#. de: Nimmt diese Menagerie denn gar kein Ende?
#. fr: C'est bien plus peuplé que nous ne le croyions<nbsp>!
msgctxt "NpcYell:14166:0:13"
msgid "Is there no end to this foul menagerie!?"
msgstr "Да им конца-края нет!"

#. ja: 滑らぬよう<br>避けて進もう…
#. de: Mach am besten einen großen Bogen darum<nbsp>...
#. fr: Attention à ne pas glisser...
msgctxt "NpcYell:14167:0:13"
msgid "Best give that a wide berth..."
msgstr "Лучше обойти подальше..."

#. ja: まったく…<br>ここは整備が必要そうじゃ
#. de: Es ist alles in einem so erbärmlichen Zustand des Verfalls.
#. fr: Nous allons vite devoir remédier au manque d'entretien des lieux...
msgctxt "NpcYell:14168:0:13"
msgid "'Tis all in such a sorry state of disrepair."
msgstr "Ну и запустение... Тут всё надо приводить в порядок."

#. ja: なんじゃ！？<br>何かが転がってきたぞ！
#. de: Sind diesen rollenden Felsen gerade Beine gewachsen?!
#. fr: Qu'est-ce donc que ce bruit de roulement<nbsp>!?
msgctxt "NpcYell:14169:0:13"
msgid "Did those rolling boulders just sprout legs!?"
msgstr "Что это?!<br>У этих валунов ноги выросли?!"

#. ja: すまぬが<br>あやつらの対処を頼む！
#. de: Nach dir. Ich habe eine Abneigung gegen Nadeln.
#. fr: À toi de jouer, garde du corps<nbsp>!
msgctxt "NpcYell:14170:0:13"
msgid "After you. I've an aversion to needles."
msgstr "Прошу, разберись с ними. Я иголок боюсь."

#. ja: あれは…棺か？
#. de: Ist das ... ein Grab?
#. fr: Hmm, une sorte de... sarcophage<nbsp>?
msgctxt "NpcYell:14171:0:13"
msgid "Is this...a tomb?"
msgstr "Это... гробница?"

#. ja: ●削除：やれやれ…<br>大掃除が必要じゃな…
#. de: 0
#. fr: 0
msgctxt "NpcYell:14172:0:13"
msgid "0"
msgstr "0"

#. ja: このあたりは<br>こやつらの棲みかなのか？
#. de: Haben diese Kreaturen sich hier eingenistet?
#. fr: Serions-nous dans le repaire de ces créatures<nbsp>?
msgctxt "NpcYell:14173:0:13"
msgid "Is this a lair or a holding pen?"
msgstr "Это логово или загон?"

#. ja: こんなところまで<br>入り込んでおるとは！
#. de: Gespenster und Wiedergänger, oh mein Gott!
#. fr: Par les Douze, des fantômes<nbsp>!
msgctxt "NpcYell:14174:0:13"
msgid "Wraiths and revenants, oh my!"
msgstr "Призраки и ожившие мертвецы, вот так дела!"

#. ja: 何が見つかるか<br>楽しみじゃな！
#. de: Wer weiß, was wir hier finden werden!
#. fr: Notre curiosité est à son comble<nbsp>!
msgctxt "NpcYell:14175:0:13"
msgid "Who knows what we shall find!"
msgstr "Кто знает, что мы здесь найдём!"

#. ja: む、行き止まりか…？
#. de: Sind wir in eine Sackgasse geraten?
#. fr: Tiens... Une impasse<nbsp>?
msgctxt "NpcYell:14176:0:13"
msgid "Have we reached a dead end?"
msgstr "Мы что, зашли в тупик?"

#. ja: ゆ、揺らすでない…！
#. de: G-Ganz ruhig jetzt<nbsp>...
#. fr: Ce n'est pas le moment de trembler...
msgctxt "NpcYell:14177:0:13"
msgid "S-Steady now..."
msgstr "С-спокойно..."

#. ja: 絶対に<br>揺らすでないぞ…！
#. de: Ja nicht zittern!
#. fr: Ce n'est <i>vraiment</i> pas le moment de trembler<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:14178:0:13"
msgid "Do not bounce <i>or</i> jounce!"
msgstr "Только не тряси, <i>и</i> не подбрасывай!"

#. ja: わああっ！
#. de: Waaah!
#. fr: Ouaaaah<nbsp>!!
msgctxt "NpcYell:14179:0:13"
msgid "Waaah!"
msgstr "А-а-а!"

#. ja: むむ…！<br>また何か現れたか！
#. de: Noch mehr Schädlinge!
#. fr: Oh non<nbsp>! En voilà encore<nbsp>!
msgctxt "NpcYell:14180:0:13"
msgid "More pests to deal with!"
msgstr "Опять с этой мелочью разбираться!"

#. ja: ええい<br>一気に渡るぞ！
#. de: Sei mutig, Nanamo!<nbsp>Schnelle Schritte!
#. fr: Chaud devant<nbsp>! Faites place<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14181:0:13"
msgid "Courage, Nanamo!<br>Quick steps!"
msgstr "Не робей, Нанамо!<br>Быстрее, шагай!"

#. ja: ずいぶんと<br>奥まで来たようだが…
#. de: Wir müssen tief im Zentrum der Aquädukte sein<nbsp>...
#. fr: Nous voilà au cœur des canalisations...
msgctxt "NpcYell:14183:0:13"
msgid "We must be deep in the heart of the aqueducts..."
msgstr "Похоже, мы забрались глубоко в акведуки..."

#. ja: 瓦礫で道が<br>塞がっておるな…
#. de: Nicht hier entlang.<nbsp>An dem Schutt kommen wir nicht vorbei.
#. fr: Nous ne nous ferons pas barrer la route<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14184:0:13"
msgid "Not that way.<br>The debris is impassable."
msgstr "Не туда.<br>Завал не обойти."

#. ja: なんじゃ！？<br>防衛機構の類か…！？
#. de: Was habe ich getan?!<br>Haben wir die Verteidigung ausgelöst?!
#. fr: Qu'est-ce que c'est<nbsp>!? Des mécanismes de défense<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14185:0:13"
msgid "What did I do!?<br>Did we trip the defenses!?"
msgstr "Что я натворил?!<br>Мы запустили защиту?!"

#. ja: ここにも<br>ガーディアンが…！
#. de: Die Wachen sind noch immer auf ihren Posten<nbsp>...
#. fr: Les gardiens sont toujours fidèles au poste...
msgctxt "NpcYell:14186:0:13"
msgid "The sentinels still guard their post..."
msgstr "Стражи всё ещё на посту..."

#. ja: 状態も良いし<br>貴重な文化遺産じゃな…
#. de: Bemerkenswert.<br>Er ist immer noch in einem tadellosen Zustand<nbsp>...
#. fr: Quelle splendeur... et toujours en excellent état...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14187:0:13"
msgid "Remarkable.<br>'Tis still in pristine condition..."
msgstr "Поразительно.<br>Всё в превосходном состоянии..."

#. ja: わぁっ！<br>間違えてしまったか！？
#. de: Aaah!<br>W-War das nicht die richtige Antwort?!
#. fr: Aah<nbsp>! Ce n'était donc pas la bonne combinaison<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14188:0:13"
msgid "Aaah!<br>W-Was that not the right answer!?"
msgstr "А-а-а!<br>Н-не тот ответ?!"

#. ja: …ほう、凌いだか
#. de: Ganz schön zäh!
#. fr: Quelle insolente résistance...
msgctxt "NpcYell:14189:0:13"
msgid "Very good..."
msgstr "Недурно..."

#. ja: 何が来ようとも…！
#. de: Wir werden siegen, komme was wolle!
#. fr: Nous vaincrons coûte que coûte<nbsp>!
msgctxt "NpcYell:14190:0:13"
msgid "We'll not be bested here!"
msgstr "Здесь мы не проиграем!"

#. ja: え、ええい…ままよ！
#. de: Für Münze und Vaterlaaaand!
#. fr: Advienne que pourraaaaa<nbsp>!!
msgctxt "NpcYell:14191:0:13"
msgid "For coin and countr─eeeeee!"
msgstr "За деньги и род-и-и-ину!"

#. ja: そなた…<br>面白がっておらぬか…？
#. de: Du scheinst dich zu amüsieren<nbsp>...
#. fr: On dirait que ça t'amuse...
msgctxt "NpcYell:14192:0:13"
msgid "You seem...amused."
msgstr "Тебе... весело, что ли?"

#. ja: この岩<br>落ちたりせぬよな…？
#. de: Dieser Fels steckt fest, oder?
#. fr: Ce rocher... Il ne va pas s'effondrer, n'est-ce pas<nbsp>?
msgctxt "NpcYell:14193:0:13"
msgid "This boulder is wedged in tightly...yes?"
msgstr "Этот валун крепко застрял... ведь так?"

#. ja: 削除：ここは…<br>何のための場所なのか…
#. de: 0
#. fr: 0
msgctxt "NpcYell:14194:0:13"
msgid "REPORT IF DISPLAYED"
msgstr "REPORT IF DISPLAYED"

#. ja: ずいぶんと<br>奥まで来たようだが…
#. de: Wir müssen tief im Zentrum der Aquädukte sein<nbsp>...
#. fr: Nous avons atteint le bout, on dirait...
msgctxt "NpcYell:14195:0:13"
msgid "We must be deep in the heart of the aqueducts..."
msgstr "Похоже, мы забрались глубоко в акведуки..."

#. ja: 瓦礫で道が<br>塞がっておるな…
#. de: Nicht hier entlang.<nbsp>An dem Schutt kommen wir nicht vorbei.
#. fr: Nous ne nous ferons pas barrer la route<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14196:0:13"
msgid "Not that way.<br>The debris is impassable."
msgstr "Не туда.<br>Завал не обойти."

#. ja: ヘビの群れが<br>現れおったぞ！
#. de: Schlangen?!<br>Warum müssen es ausgerechnet Schlangen sein<nbsp>...?
#. fr: Des serpents<nbsp>!? Nous aurons tout vu<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14197:0:13"
msgid "Snakes!?<br>Why must it be snakes...?"
msgstr "Змеи?!<br>Ну почему именно змеи?.."

#. ja: よし<br>扉が開いたな！
#. de: Nun, richtig oder falsch, die Tür steht offen!
#. fr: Parfait<nbsp>! La porte ne demande plus qu'à être franchie<nbsp>!
msgctxt "NpcYell:14198:0:13"
msgid "Well, right or wrong, the door lies open!"
msgstr "Что ж, правильный ответ или нет, дверь открыта!"

#. ja: かなり広いな…<br>上の階もあるぞ
#. de: Ziemlich weitläufig.<br>Sollen wir es oben versuchen?
#. fr: Comme c'est grand... et il reste encore à voir l'étage...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14199:0:13"
msgid "Quite an expansive abode.<br>Shall we try upstairs?"
msgstr "Ничего себе хоромы.<br>Может, заглянем наверх?"

#. ja: 削除：よし！<br>さっそく進もうぞ！
#. de: 0
#. fr: 0
msgctxt "NpcYell:14200:0:13"
msgid "REPORT IF DISPLAYED"
msgstr "REPORT IF DISPLAYED"

#. ja: ガーディアンか…<br>宝を守っておるのか！？
#. de: Ah, also gibt es <i>doch</i> Wachen<nbsp>...
#. fr: Un trésor digne de ce nom est toujours jalousement gardé<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:14201:0:13"
msgid "Ah, so there <i>are</i> guards..."
msgstr "А, значит, стража всё-таки <i>есть</i>..."

#. ja: さて…<br>何が待ち受けておるのか…
#. de: Was wir wohl als Nächstes finden werden?
#. fr: Les Douze seuls savent ce qui nous attend...
msgctxt "NpcYell:14202:0:13"
msgid "Whatever shall we find next?"
msgstr "Интересно, что ждёт нас дальше?"

#. ja: ここは…<br>何に使われた場所なのか…
#. de: Das sieht nach einer Bühne oder Arena aus<nbsp>...
#. fr: Serait-ce une sorte de scène<nbsp>? Ou d'arène<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14203:0:13"
msgid "This has the look of<br>a stage or arena..."
msgstr "Похоже на<br>сцену или арену..."

#. ja: さて…<br>何が待ち受けておるのか…
#. de: Was wir wohl als Nächstes finden werden?
#. fr: Les Douze seuls savent ce qui nous attend...
msgctxt "NpcYell:14204:0:13"
msgid "Whatever shall we find next?"
msgstr "Интересно, что ждёт нас дальше?"

#. ja: ここは…<br>何に使われた場所なのか…
#. de: Das sieht nach einer Bühne oder Arena aus<nbsp>...
#. fr: Serait-ce une sorte de scène<nbsp>? Ou d'arène<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14205:0:13"
msgid "This has the look of<br>a stage or arena..."
msgstr "Похоже на<br>сцену или арену..."

#. ja: 奥へ進んでみよう
#. de: Sehen wir uns mal um, oder?
#. fr: Et si nous allions y jeter un œil<nbsp>?
msgctxt "NpcYell:14206:0:13"
msgid "Let us take a peek, shall we?"
msgstr "Давай заглянем, а?"

#. ja: しかし<br>この先に何が…
#. de: Dann wollen wir doch mal sehen, was es bewacht hat<nbsp>...
#. fr: Nous nous demandons bien ce qu'il y a là-bas...
msgctxt "NpcYell:14207:0:13"
msgid "Now to see what it was guarding..."
msgstr "Теперь посмотрим, что же оно охраняло..."

#. ja: ●削除：すまぬが<br>もう少し付き合ってくれ！
#. de: 0
#. fr: 0
msgctxt "NpcYell:14208:0:13"
msgid "0"
msgstr "0"

#. ja: この扉が<br>気になるのう…
#. de: Ich fühle mich zu diesem hier hingezogen<nbsp>...
#. fr: Cette porte a par<shy>ti<shy>cu<shy>liè<shy>rement attiré notre attention...
msgctxt "NpcYell:14209:0:13"
msgid "I find myself drawn to this one..."
msgstr "Меня так и тянет к этой двери..."

#. ja: よし、出発するぞ！
#. de: Weiter geht's!
#. fr: Bien, en route<nbsp>!
msgctxt "NpcYell:14210:0:13"
msgid "Onward we go!"
msgstr "Вперёд!"

#. ja: この土管は<br>中を通れそうじゃ
#. de: Wir können durch dieses Rohr gehen, denke ich.
#. fr: Nous pouvons passer à travers ce tuyau<nbsp>!
msgctxt "NpcYell:14211:0:13"
msgid "We can walk through this pipe, I think."
msgstr "Кажется, по этой трубе можно пройти."

#. ja: ふう…<br>油断は禁物じゃな
#. de: Bei den Gebietern. Mein armes Herz.
#. fr: Il nous faut rester prudente... Très prudente, même<nbsp>!
msgctxt "NpcYell:14212:0:13"
msgid "Gods. My poor heart."
msgstr "Боги... Сердце чуть не выпрыгнуло."

#. ja: ここは<br>任せたぞ！
#. de: Ich überlasse dir den Vortritt, <split " " 1><string $gs1></split>!
#. fr: Les aventuri<if $gn4>ères<else>ers</if> d'abord<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:14213:0:13"
msgid "All yours, <split \" \" 1><string $gs1></split>!"
msgstr "Теперь ты, <split \" \" 1><string $gs1></split>!"

#. ja: 試練を与える…
#. de: Stellt euch meiner Prüfung.
#. fr: Cette épreuve sera votre dernière...
msgctxt "NpcYell:14214:0:13"
msgid "Will you overcome my trial?"
msgstr "Сумеешь ли ты пройти моё испытание?"

#. ja: 頭を垂れよ
#. de: Verneigt euch vor mir.
#. fr: Prosternez-vous devant moi<nbsp>!
msgctxt "NpcYell:14215:0:13"
msgid "Know your place."
msgstr "Знай своё место."

#. ja: まだまだ<br>奥へと続いておるな…
#. de: Der Pfad führt zu<nbsp>...
#. fr: Le chemin ne s'arrête pas là...
msgctxt "NpcYell:14216:0:13"
msgid "The path leads on..."
msgstr "Путь ведёт дальше..."

#. ja: 次から次へと！<br>慎重に対処せねば…
#. de: Hinter jeder Ecke lauert eine Heraus<shy>forde<shy>rung!
#. fr: Attention à toi, et conserve de l'énergie pour les suivants<nbsp>!
msgctxt "NpcYell:14217:0:13"
msgid "A challenge around every corner!"
msgstr "На каждом шагу новое испытание!"

#. ja: 「2つの瞳を揃えよ」か…
#. de: „Zwei Augen.“<br>Ist das ... metaphorisch gemeint?
#. fr: “Deux prunelles ouvriront la voie”... Hmm...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14218:0:13"
msgid "“Two eyes.”<br>Is it...metaphorical?"
msgstr "«Два глаза»... Это... метафора?"

#. ja: ここは…？
#. de: Wo sind wir hier<nbsp>...?
#. fr: ... Où sommes-nous<nbsp>?
msgctxt "NpcYell:14219:0:13"
msgid "Where have we come to...?"
msgstr "Куда это мы попали?.."

#. ja: 先へ進むには<br>戦うしかないのう…
#. de: Sie werden uns nicht kampflos passieren lassen<nbsp>...
#. fr: Heu<shy>reu<shy>se<shy>ment que tu es là pour croiser le fer quand il faut...
msgctxt "NpcYell:14220:0:13"
msgid "They'll not let us pass without a fight..."
msgstr "Без боя нас не пропустят..."

#. ja: いったい<br>どういうことなのじゃ…？
#. de: Was könnte das nur heißen<nbsp>...?
#. fr: Mais... qu'est-ce que cela signifie<nbsp>?
msgctxt "NpcYell:14221:0:13"
msgid "What could it possibly mean...?"
msgstr "Что бы это могло значить?.."

#. ja: この先に何が…
#. de: Wo geraten wir da rein<nbsp>...?
#. fr: Vers quoi nous mènent nos pas<nbsp>?
msgctxt "NpcYell:14222:0:13"
msgid "What are we walking into...?"
msgstr "Что нас ждёт впереди?.."

#. ja: まだまだ<br>奥へと続いておるな…
#. de: Der Pfad führt zu<nbsp>...
#. fr: Le chemin ne s'arrête pas là...
msgctxt "NpcYell:14223:0:13"
msgid "The path leads on..."
msgstr "Путь ведёт дальше..."

#. ja: 油断せぬように頼むぞ！
#. de: Unsere Atempause war offensichtlich nur von kurzer Dauer.
#. fr: C'était couru d'avance... Prends garde<nbsp>!
msgctxt "NpcYell:14224:0:13"
msgid "Our respite was short-lived, I see."
msgstr "Передышка, гляжу, была недолгой."

#. ja: 果実につられて<br>集まってきたのか…？
#. de: Die Früchte müssen sie angelockt haben<nbsp>...
#. fr: Les fruits ont dû les attirer ici...
msgctxt "NpcYell:14225:0:13"
msgid "The fruit must have drawn them here..."
msgstr "Наверное, их приманили сюда плоды..."

#. ja: もしや<br>この先にあるのは…
#. de: Ich frage mich, ob das wohl<nbsp>...
#. fr: Là... Je me demande si...
msgctxt "NpcYell:14226:0:13"
msgid "I wonder, could this be...?"
msgstr "Неужели впереди..."

#. ja: どうして<br>母上の使い魔が…
#. de: Warum sollte Mutters Familiar hier sein<nbsp>...?
#. fr: L-le familier de Mère<nbsp>!? Ça alors<nbsp>!
msgctxt "NpcYell:14227:0:13"
msgid "Why would Mother's familiar be here...?"
msgstr "Почему здесь фамильяр матери?.."

#. ja: ここにも<br>入り込んでおったか！
#. de: Noch mehr?<br>Jeder Ilm dieses Ortes ist befallen!
#. fr: Encore<nbsp>!? Mais ça n'en finira donc jamais<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:14228:0:13"
msgid "Still more?<br>Every ilm of this place is infested!"
msgstr "И ещё? Тут заражён каждый илм!"

#. ja: お兄様！<br>私の力で回復を！
#. de: Werde durch meine Kraft geheilt, Bruder!
#. fr: Grand frère<nbsp>! Soigne-toi avec mon énergie<nbsp>!
msgctxt "NpcYell:14229:0:13"
msgid "By my strength be healed, Brother!"
msgstr "Силой моей исцелись, брат!"

#. ja: 妹よ…<br>我の力を分け与えよう
#. de: Meine Stärke ist dein, Schwester.
#. fr: Que mon énergie sois tienne, petite sœur.
msgctxt "NpcYell:14230:0:13"
msgid "Partake of my strength, Sister."
msgstr "Сестра, прими мою силу."

#. ja: 薔薇よ、咲き乱れて！
#. de: Mögen tausend Rosen blühen!
#. fr: Que fleurissent les roses de la vie<nbsp>!
msgctxt "NpcYell:14231:0:13"
msgid "Let a thousand roses bloom!"
msgstr "Пусть расцветут тысячи роз!"

#. ja: さあ、華やぎの時間よ！
#. de: Zeit zum Feiern!
#. fr: Voyez la vie en rose, mes enfants<nbsp>!
msgctxt "NpcYell:14232:0:13"
msgid "'Tis time for revelry!"
msgstr "Ну что, пора веселиться!"

#. ja: 花々とともに<br>舞い踊って？
#. de: Tanzt mit den Blumen!
#. fr: Que diriez-vous d'une petite danse fleurie<nbsp>?
msgctxt "NpcYell:14233:0:13"
msgid "I bid you dance with the flowers!"
msgstr "Танцуйте с цветами!"

#. ja: 緑よ、茂りなさい！
#. de: Möge der Wald üppig sein!
#. fr: Pousse, luxuriante forêt<nbsp>!
msgctxt "NpcYell:14234:0:13"
msgid "Let the forest be lush!"
msgstr "Пусть лес пышно разрастётся!"

#. ja: さあ、安らぎの時間よ…
#. de: Zeit für eine Ver<shy>schnauf<shy>pause!
#. fr: L'heure du repos est arrivée...
msgctxt "NpcYell:14235:0:13"
msgid "'Tis time for respite."
msgstr "Пора передохнуть."

#. ja: 木々とともに<br>憩いましょう？
#. de: Ruht euch unter den Bäumen aus.
#. fr: Laissez ces arbres vous apaiser, mes enfants.
msgctxt "NpcYell:14236:0:13"
msgid "Take your ease among the trees."
msgstr "Отдохнём среди деревьев."

#. ja: 数多の槍よ<br>降りそそげ！
#. de: O unzählige Speere, regnet auf meinen Feind herab!
#. fr: Abattez-vous sur mes adversaires, innombrables lances<nbsp>!
msgctxt "NpcYell:14237:0:13"
msgid "O spears innumerable, rain down upon mine enemy!"
msgstr "О бесчисленные копья, обрушьтесь на врага!"

#. ja: まだまだッ！
#. de: Dies ist lediglich der Beginn!
#. fr: Point de répit<nbsp>!
msgctxt "NpcYell:14238:0:13"
msgid "No quarter!"
msgstr "Не щадить!"

#. ja: 数多の槍よ<br>千々に貫け！
#. de: O unzählige Speere, lasst nichts undurchstochen!
#. fr: Que mes lances célestes vous transpercent<nbsp>!
msgctxt "NpcYell:14239:0:13"
msgid "O spears innumerable, leave naught unpierced!"
msgstr "О бесчисленные копья, пронзите всё вокруг!"

#. ja: あぁ…心躍る戦いだ…！
#. de: Ahhh, welch ein spannender Kampf!
#. fr: Ah, l'ivresse du combat<nbsp>!
msgctxt "NpcYell:14240:0:13"
msgid "Ahhh, such thrilling battle!"
msgstr "Ах, какой захватывающий бой!"

#. ja: 妹よ、休むがいい<br>そなたに安らぎの時を…
#. de: Du hast genug getan, Schwester. Ruh dich nun aus.
#. fr: Repose-toi, petite sœur. Tu l'as bien mérité.
msgctxt "NpcYell:14241:0:13"
msgid "Rest easy, Sister. You have done enough."
msgstr "Отдыхай, сестра. Ты и так уже достаточно сделала."

#. ja: あとは私の運命に任せて<br>お兄様！
#. de: Vertraue den Rest meinem Schicksal an, Bruder!
#. fr: Tu peux me confier ton destin, grand frère<nbsp>!
msgctxt "NpcYell:14242:0:13"
msgid "Entrust your fate to mine now, Brother!"
msgstr "Теперь доверь свою судьбу мне, брат!"

#. ja: なんのこれしき！<br>見切ったり！
#. de: Ha, überhaupt kein Problem!
#. fr: Et voilà le travail<nbsp>! Il en faudra plus pour nous barrer la route<nbsp>!
msgctxt "NpcYell:14243:0:13"
msgid "Nothing to it!"
msgstr "Пустяки!"

#. ja: 愉快、愉快！<br>矢継ぎ早とはこのことよな！
#. de: Ja, immer weiter! Nur so macht es erst Spaß!
#. fr: Bravo, bravo<nbsp>! C'est la spirale du succès, dites-moi<nbsp>!
msgctxt "NpcYell:14244:0:13"
msgid "It certainly kept us on our toes!"
msgstr "Вот это веселье! Едва успеваешь перевести дух!"

#. ja: どう、だ…<br>耐えきったぞ…！
#. de: Was sagt ihr jetzt<nbsp>... Wir stehen nach wie vor!
#. fr: Vous ne m'aurez pas... Je résisterai jusqu'au bout<nbsp>!
msgctxt "NpcYell:14245:0:13"
msgid "Whew... Still standing..."
msgstr "Фух... Я ещё стою..."

#. ja: もう二度と<br>お前に屈服しない！
#. de: Kein weiteres Mal werden wir fallen!
#. fr: Les Mhigois ne se soumettront plus jamais<nbsp>!
msgctxt "NpcYell:14246:0:13"
msgid "I'm not losing to you again!"
msgstr "Я больше никогда тебе не проиграю!"

#. ja: この痛みと憤怒を、力に…！
#. de: Dieser Schmerz und Zorn gibt mir Kraft<nbsp>...!
#. fr: Que ma douleur et ma rage vous consument<nbsp>!
msgctxt "NpcYell:14247:0:13"
msgid "This suffering is my strength!"
msgstr "Эта боль придаёт мне сил!"

#. ja: 治癒を行う！<br>さあ、反撃だ！
#. de: Auf zum Gegenangriff! Überlasst das Heilen mir!
#. fr: Voilà pour les soins<nbsp>! Maintenant, on contre-attaque<nbsp>!
msgctxt "NpcYell:14248:0:13"
msgid "Leave the healing to me!"
msgstr "Исцеление оставьте мне!"

#. ja: ここは私が！
#. de: Überlasst das mir!
#. fr: Ça, c'est pour moi<nbsp>!
msgctxt "NpcYell:14250:0:13"
msgid "I will hold here!"
msgstr "Я прикрою!"

#. ja: せいっ！
#. de: Nimm das!
#. fr: Shah<nbsp>!
msgctxt "NpcYell:14251:0:13"
msgid "There!"
msgstr "На!"

#. ja: てやぁ！
#. de: Hiiijaaa!
#. fr: Yah<nbsp>!
msgctxt "NpcYell:14252:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: ハッ！
#. de: Hah!
#. fr: Hah<nbsp>!
msgctxt "NpcYell:14253:0:13"
msgid "Hah!"
msgstr "Ха!"

#. ja: そこだ！
#. de: Nimm das!
#. fr: Je t'ai<nbsp>!
msgctxt "NpcYell:14254:0:13"
msgid "Have at you!"
msgstr "Получай!"

#. ja: 竜騎士の誇りを見よ！
#. de: Seht die Macht des Dragoon!
#. fr: Vous allez voir ce qu'on sait faire<nbsp>!
msgctxt "NpcYell:14255:0:13"
msgid "Behold the power of the dragoon!"
msgstr "Узрите мощь драгуна!"

#. ja: 戦神よ、ご照覧あれ！
#. de: Halone, führe meine Klinge!
#. fr: Que Halone nous protège<nbsp>!
msgctxt "NpcYell:14256:0:13"
msgid "Halone, guide my blade!"
msgstr "Халонэ, направь мой клинок!"

#. ja: なめるなよ…！<br>イシュガルドの意地を！
#. de: Für Ishgard!
#. fr: Notre détermination ne faiblira pas<nbsp>!
msgctxt "NpcYell:14257:0:13"
msgid "For Ishgard!"
msgstr "За Ишгард!"

#. ja: やらせるものかよ…！
#. de: Vergiss es!
#. fr: On ne vous laissera pas faire<nbsp>!
msgctxt "NpcYell:14258:0:13"
msgid "I think not!"
msgstr "Не бывать этому!"

#. ja: 仕留めてみせる！
#. de: Jetzt habe ich dich!
#. fr: Je vaincrai<nbsp>!
msgctxt "NpcYell:14259:0:13"
msgid "I have you now!"
msgstr "Теперь ты мой!"

#. ja: 任せておけ！
#. de: Überlasst das mir!
#. fr: Laissez-moi faire<nbsp>!
msgctxt "NpcYell:14260:0:13"
msgid "Leave this to me!"
msgstr "Предоставьте это мне!"

#. ja: 逃しはしないッ！
#. de: Du wirst nicht entkommen!
#. fr: Personne ne peut m'échapper<nbsp>!
msgctxt "NpcYell:14261:0:13"
msgid "You won't escape!"
msgstr "Не уйдёшь!"

#. ja: 竜は皆殺しだ！
#. de: Zu den Sieben Höllen mit diesen Drachen!
#. fr: On doit tous les tuer<nbsp>!
msgctxt "NpcYell:14262:0:13"
msgid "To hells with these dragons!"
msgstr "К чёрту этих драконов!"

#. ja: なん…だと…
#. de: Aber wie ...
#. fr: Non...
msgctxt "NpcYell:14263:0:13"
msgid "But how..."
msgstr "Но как же..."

#. ja: ここで…<br>終わり…なのか…
#. de: Es darf nicht ... so enden<nbsp>...
#. fr: Ça ne peut pas... finir ainsi...
msgctxt "NpcYell:14264:0:13"
msgid "It can't end...like this..."
msgstr "Неужели... всё кончится вот так?.."

#. ja: あぁ…母さん…
#. de: Mama ...
#. fr: Aah... Maman...
msgctxt "NpcYell:14265:0:13"
msgid "Mother..."
msgstr "Мама..."

#. ja: 死にたく…な、い…
#. de: Ich ... Ich will nicht<nbsp>...
#. fr: Je ne veux pas mourir...
msgctxt "NpcYell:14266:0:13"
msgid "I... I don't want to..."
msgstr "Я... не хочу умирать..."

#. ja: そん…な…
#. de: Nein ...
#. fr: Non...
msgctxt "NpcYell:14267:0:13"
msgid "No..."
msgstr "Нет..."

#. ja: チクショウ…
#. de: Verdammt ...
#. fr: Bon sang...
msgctxt "NpcYell:14268:0:13"
msgid "Dammit..."
msgstr "Чёрт..."

#. ja: ぐはっ…
#. de: Gah ...
#. fr: Argh...<nbsp>!
msgctxt "NpcYell:14269:0:13"
msgid "Gah!"
msgstr "Кха!"

#. ja: なんて最期だ…
#. de: Ist dies ... das Ende<nbsp>...?
#. fr: Quelle fin pitoyable...
msgctxt "NpcYell:14270:0:13"
msgid "Is this...the end...?"
msgstr "Неужели... это конец?.."

#. ja: エーテルよ、集え！
#. de: Zu mir, Äther!
#. fr: Éther, prête-moi ta force<nbsp>!
msgctxt "NpcYell:14271:0:13"
msgid "Aether, to me!"
msgstr "Эфир, ко мне!"

#. ja: 覚悟はいい？
#. de: Jetzt gibt's Prügel!
#. fr: Attention, ça va faire mal<nbsp>!
msgctxt "NpcYell:14272:0:13"
msgid "This one'll sting!"
msgstr "Сейчас будет больно!"

#. ja: 巨竜が動くぞ！<br>総員、迎撃準備！
#. de: Seid auf der Hut!
#. fr: Il se prépare à attaquer, attention<nbsp>!
msgctxt "NpcYell:14273:0:13"
msgid "Brace yourselves!"
msgstr "Приготовьтесь!"

#. ja: 皆、覚悟を決めよ！
#. de: Da kommt ein Großer! Macht euch bereit!
#. fr: Le tout pour le tout<nbsp>!
msgctxt "NpcYell:14274:0:13"
msgid "Their champion approaches! Make ready!"
msgstr "Их предводитель приближается! Приготовиться!"

#. ja: ここで終わるつもりはない<br>邪竜に復讐するまではな…
#. de: Ich lasse ihn gerne erneut meine Lanze schmecken.
#. fr: Je tiendrai bon jusqu'à ma vengeance...
msgctxt "NpcYell:14275:0:13"
msgid "If he would taste my lance again, so be it."
msgstr "Пусть он снова вкусит моего копья."

#. ja: 下がるぞ！
#. de: Zurückfallen!
#. fr: Reculons<nbsp>!
msgctxt "NpcYell:14276:0:13"
msgid "Fall back!"
msgstr "Отступаем!"

#. ja: 油断するなよ、イダ！
#. de: Pass auf, Yda!
#. fr: Fais attention, Yda<nbsp>!
msgctxt "NpcYell:14277:0:13"
msgid "On your guard, Yda!"
msgstr "Осторожно, Ида!"

#. ja: わかってるって！
#. de: Ich weiß, ich weiß!
#. fr: C'est bon, je sais<nbsp>!
msgctxt "NpcYell:14278:0:13"
msgid "I know, I know!"
msgstr "Знаю, знаю!"

#. ja: やっつけるわよ！
#. de: Ich mach's kurz!
#. fr: Ça fait mal, hein<nbsp>!?
msgctxt "NpcYell:14279:0:13"
msgid "I shall make it quick!"
msgstr "Я быстро с тобой разделаюсь!"

#. ja: 肌がひりつくような殺気…
#. de: Zurück, sonst bleibt nur noch Asche von uns über!
#. fr: Son aura meurtrière me donne des frissons...
msgctxt "NpcYell:14280:0:13"
msgid "Back, ere we burn to ashes!"
msgstr "Назад, а то сгорим дотла!"

#. ja: さすがの圧力ね…！
#. de: Unser Gegner ist gefährlich. Seid vorsichtig.
#. fr: Il est im<shy>pres<shy>sion<shy>nant...
msgctxt "NpcYell:14281:0:13"
msgid "Our foe is formidable. Have care."
msgstr "Мощный противник... Будьте осторожны."

#. ja: 手加減しないよ！
#. de: Nicht drängeln!
#. fr: Je vais pas y aller de main morte<nbsp>!
msgctxt "NpcYell:14282:0:13"
msgid "No holding back!"
msgstr "Я сдерживаться не стану!"

#. ja: 増援が来やがった！
#. de: Verstärkungen!
#. fr: Il a appelé des renforts<nbsp>!
msgctxt "NpcYell:14283:0:13"
msgid "Reinforcements!"
msgstr "Подкрепление!"

#. ja: 押し負けるものか！
#. de: Wir werden nicht so leicht weichen!
#. fr: Je ne perdrai pas<nbsp>!
msgctxt "NpcYell:14284:0:13"
msgid "We will not yield quite so easily!"
msgstr "Мы так просто не отступим!"

#. ja: なんて衝撃だ…！
#. de: Das wird Spuren hinterlassen.
#. fr: Sa puissance est sans mesure...
msgctxt "NpcYell:14285:0:13"
msgid "That'll leave a mark."
msgstr "Вот это удар..."

#. ja: ここで食い止めるぞ！
#. de: Lasst uns dies hier und jetzt beenden!
#. fr: Arrêtons-le<nbsp>!
msgctxt "NpcYell:14286:0:13"
msgid "Let us end this here and now!"
msgstr "Покончим с этим здесь и сейчас!"

#. ja: 負けないよー！
#. de: Wir dürfen nicht aufgeben!
#. fr: On va gagner<nbsp>!
msgctxt "NpcYell:14287:0:13"
msgid "We can't give up!"
msgstr "Мы не сдадимся!"

#. ja: 覚悟を決めるか…
#. de: Jetzt beginnt der Kampf erst richtig.
#. fr: Quand faut s'y mettre...
msgctxt "NpcYell:14288:0:13"
msgid "Now the battle begins in earnest."
msgstr "Ну что, теперь начнётся настоящая битва."

#. ja: 回避するッ！
#. de: In Deckung!
#. fr: Esquivez<nbsp>!
msgctxt "NpcYell:14289:0:13"
msgid "Take cover!"
msgstr "В укрытие!"

#. ja: 思い知れッ！
#. de: Ich bin dein Meister!
#. fr: Ta folie te perdra<nbsp>!
msgctxt "NpcYell:14290:0:13"
msgid "Know your folly!"
msgstr "Узри, к чему приводит твоё безумие!"

#. ja: フン…この程度！
#. de: Hmpf. Das ist gar nichts.
#. fr: Humpf, ridicule<nbsp>!
msgctxt "NpcYell:14291:0:13"
msgid "Hmph. This is nothing."
msgstr "Хм. Это пустяки."

#. ja: まだまだ負けません！
#. de: Ich kümmere mich um deine Wunden.
#. fr: Ce n'est pas terminé<nbsp>!
msgctxt "NpcYell:14292:0:13"
msgid "We've come too far to lose now!"
msgstr "Мы слишком далеко зашли, чтобы теперь проиграть!"

#. ja: 仕掛けてくるぞ！
#. de: Er bereitet einen Angriff vor!
#. fr: Il va attaquer<nbsp>!
msgctxt "NpcYell:14293:0:13"
msgid "It readies to strike!"
msgstr "Оно готовится к атаке!"

#. ja: 冒険の始まりだぜ！
#. de: Jetzt gilt es.
#. fr: Que l'aventure commence<nbsp>!
msgctxt "NpcYell:14294:0:13"
msgid "This is it."
msgstr "Вот и всё."

#. ja: さあて、がんばるか～
#. de: Geben wir alles!
#. fr: Allez, au boulot.
msgctxt "NpcYell:14295:0:13"
msgid "Let's give it our all!"
msgstr "Ну что, покажем, на что способны!"

#. ja: 訓練どおりにいくわよ！
#. de: Erinnert euch an unser Training.
#. fr: On fait comme à l'en<shy>traî<shy>ne<shy>ment<nbsp>!
msgctxt "NpcYell:14296:0:13"
msgid "Remember─just as we practiced."
msgstr "Делаем, как на тренировке."

#. ja: 幻想的な景色だな…
#. de: Diese Höhle ist wunderschön.
#. fr: On se croirait dans un rêve...
msgctxt "NpcYell:14297:0:13"
msgid "This cavern is strangely beautiful."
msgstr "Какая удивительная красота..."

#. ja: どこから現れやがった！？
#. de: Ein Hinterhalt!?
#. fr: D'où sort-il<nbsp>!?
msgctxt "NpcYell:14298:0:13"
msgid "An ambush!?"
msgstr "Засада?!"

#. ja: ここの門番か！<br>よし、癒やしは任せろ！
#. de: Zweifelsohne der Torwächter.
#. fr: C'est le gardien<nbsp>! Je m'occupe des blessés<nbsp>!
msgctxt "NpcYell:14299:0:13"
msgid "The door's guardian, no doubt."
msgstr "Наверняка страж у ворот."

#. ja: くっ、逃げられたわ！<br>やっかいな奴ね…
#. de: Hmpf. Der Feigling ist abgehauen.
#. fr: Il s'est enfui<nbsp>! Sale bête...
msgctxt "NpcYell:14300:0:13"
msgid "Hmph. The coward ran off."
msgstr "Хм. Трус сбежал."

#. ja: 逃げ足が早いな！<br>警戒しながら追跡しよう！
#. de: Wo ist er hin ...? Wir sollten auf der Hut sein.
#. fr: Rapide... On le suit, mais restons prudents<nbsp>!
msgctxt "NpcYell:14301:0:13"
msgid "Where has he run off to...? Best we keep on our guard."
msgstr "Куда он умчался?.. Будем начеку."

#. ja: また逃げた～<br>次は絶対、捕まえるよ～
#. de: Nächstes Mal wird er nicht entkommen!
#. fr: Il s'est encore enfui<nbsp>! La prochaine sera la bonne<nbsp>!
msgctxt "NpcYell:14302:0:13"
msgid "He won't escape next time!"
msgstr "Опять сбежал! В следующий раз уж точно поймаем!"

#. ja: サハギン族か…<br>相手に不足はねえ！
#. de: Er kann es gewiss nicht mit uns aufnehmen.
#. fr: Un Sahuagin... Bel adversaire<nbsp>!
msgctxt "NpcYell:14303:0:13"
msgid "Surely, he's no match for us."
msgstr "Сахагин... Ну наконец достойный противник!"

#. ja: 親玉はサハギン族だったか<br>これは負けられないぞ！
#. de: Ihr Anführer war ein Sahagin? Dann war es ein leichter Sieg.
#. fr: On doit à tout prix gagner<nbsp>!
msgctxt "NpcYell:14304:0:13"
msgid "So, their leader was a Sahagin? An easy victory, then."
msgstr "Так их предводителем был сахагин? Тогда победа у нас в кармане."

#. ja: なんか、背筋が寒いような…
#. de: Dieser Ort hat etwas Beunruhigendes an sich<nbsp>...
#. fr: J'ai des frissons dans le dos...
msgctxt "NpcYell:14305:0:13"
msgid "There's something unsettling about this place..."
msgstr "Здесь что-то не так..."

#. ja: う～ん、嫌な予感がする～
#. de: Ich habe ein schlechtes Gefühl bei der Sache.
#. fr: Je le sens mal...
msgctxt "NpcYell:14306:0:13"
msgid "I have a bad feeling about this."
msgstr "У меня плохое предчувствие..."

#. ja: だ、大丈夫…怖くないわ！
#. de: Wir haben nichts zu befürchten<nbsp>... oder?
#. fr: T-tout ira bien.
msgctxt "NpcYell:14307:0:13"
msgid "We've nothing to be afraid of...right?"
msgstr "В-всё будет хорошо... Правда?"

#. ja: ま、迷える魂が<br>出てきませんように…
#. de: Wir sollten die Toten nicht stören.
#. fr: Faites qu'une âme errante n'apparaisse pas...
msgctxt "NpcYell:14308:0:13"
msgid "We would do well not to disturb the dead."
msgstr "Лучше не тревожить мёртвых."

#. ja: 妖異召喚！？<br>なら、まとめて倒すわ！
#. de: Vorsicht! Ein weiterer Nichts<shy>gesand<shy>ter!
#. fr: Une invocation<nbsp>?! Battons-la rapidement<nbsp>!
msgctxt "NpcYell:14309:0:13"
msgid "Careful─another voidsent!"
msgstr "Осторожно, ещё один посланец Пустоты!"

#. ja: 癒やしは任せてくれ！<br>みんなは妖異に攻撃を！
#. de: Ich werde euch nicht sterben lassen. Konzentriert euch auf den Nichts<shy>gesand<shy>ten.
#. fr: Attaquez sans crainte, je suis là pour vous soigner<nbsp>!
msgctxt "NpcYell:14310:0:13"
msgid "I'll not let you fall. Just focus on the voidsent."
msgstr "Я не дам вам погибнуть. Займитесь посланцем Пустоты!"

#. ja: ふう、これでよし～<br>それじゃ、調べてみよ～
#. de: Puh. Der Altar wäre gesäubert.
#. fr: Et voilà le travail<nbsp>! Fouinons un peu...
msgctxt "NpcYell:14311:0:13"
msgid "Phew. The altar is clear."
msgstr "Фух, алтарь чист."

#. ja: どんな化け物が相手でも<br>俺たちは負けないぜ！
#. de: Solange wir als Einheit kämpfen, können wir jeden Gegner besiegen.
#. fr: Aucun monstre ne fait le poids face à nous<nbsp>!
msgctxt "NpcYell:14312:0:13"
msgid "No matter our foe, so long as we fight as one, we will prevail."
msgstr "Какой бы ни был враг, если мы едины — победа за нами."

#. ja: 絶対王の亡骸をあんな姿に…<br>許せない！
#. de: Eine Leiche so zu entstellen<nbsp>... Das ist unverzeihlich!
#. fr: Utiliser le cadavre du roi ainsi... C'est im<shy>par<shy>don<shy>na<shy>ble<nbsp>!
msgctxt "NpcYell:14313:0:13"
msgid "That a body could be so defiled... It's unforgivable!"
msgstr "Так осквернить тело... Непростительно!"

#. ja: ひんやりとした湿った空気…<br>ザナラーンとは思えないぜ
#. de: Es ist so kalt und feucht. Kaum zu glauben, dass wir hier in Thanalan sind.
#. fr: L'air est frais et humide... On est vraiment dans le Thanalan<nbsp>?
msgctxt "NpcYell:14314:0:13"
msgid "It's so cool and damp. You would never guess this mine is in Thanalan."
msgstr ""

#. ja: 崩落、しないよね～？
#. de: Macht sich sonst noch jemand Sorgen, dass die Mine einstürzen könnte?
#. fr: Ça ne va pas s'écrouler, hein<nbsp>?
msgctxt "NpcYell:14315:0:13"
msgid "I can't be the only one worried about the mine collapsing...right?"
msgstr "Неужели меня одного тревожит, что шахта может обрушиться?.."

#. ja: 鉱石、拾えるかしら？
#. de: Ob es hier wohl noch unangetastete Vorkommen gibt?
#. fr: On peut prendre des minerais<nbsp>?
msgctxt "NpcYell:14316:0:13"
msgid "Do you suppose there are any deposits left untapped?"
msgstr "Интересно, тут ещё остались нетронутые залежи?"

#. ja: 空気が淀んでいる…<br>鉱山だからか？
#. de: Die Luft ist so still. Sind wir sicher, dass hier jemand ist?
#. fr: Il fait lourd... C'est parce qu'on est dans des mines<nbsp>?
msgctxt "NpcYell:14317:0:13"
msgid "The air is so still. Are we certain there's anyone in here?"
msgstr "Воздух стоит. Вы уверены, что здесь вообще кто-то есть?"

#. ja: あの巨人族…<br>なかなか手強そうだな！
#. de: Macht euch bereit.
#. fr: Ce géant a l'air assez fort<nbsp>!
msgctxt "NpcYell:14318:0:13"
msgid "Make ready, everyone."
msgstr "Всем приготовиться."

#. ja: 敵の首魁…ではなさそう～<br>でも、強そうだね～
#. de: Ein furchterregender Gegner, aber sicherlich nicht der Anführer.
#. fr: Ce n'est sûrement pas le chef.
msgctxt "NpcYell:14319:0:13"
msgid "A fearsome foe, to be sure, but I don't think it's their leader."
msgstr "Враг грозный, спору нет, но на предводителя не похож."

#. ja: あら、爆薬がないわね…<br>隣の部屋にあるかしら？
#. de: Sieht aus, als bräuchten wir mehr Sprengstoff.
#. fr: Il n'y a aucun explosif... Ils sont peut-être ailleurs<nbsp>?
msgctxt "NpcYell:14320:0:13"
msgid "Looks like we'll need more firesand."
msgstr "Похоже, понадобится ещё огнепеска."

#. ja: あれ、爆薬がないぞ？<br>隣の部屋を調べてみるか？
#. de: Hm, kein Sprengstoff. Vielleicht gibt es in dem anderen Raum mehr.
#. fr: Pas d'explosif... On va voir à côté<nbsp>?
msgctxt "NpcYell:14321:0:13"
msgid "Hm, no firesand. Perhaps there's more in the other room."
msgstr "Хм, огнепеска нет. Может, в соседней комнате найдётся?"

#. ja: …えっと、なにあれ～？<br>すっごく大きいね～
#. de: Bei den Zwölf, was ist das?!
#. fr: C'est quoi ce truc énorme<nbsp>?
msgctxt "NpcYell:14322:0:13"
msgid "By the Twelve, what is that!?"
msgstr "Боги, да что это такое?!"

#. ja: 巨人族の親玉か！<br>うし、やってやるぜ！
#. de: Endlich zeigt sich ihr Anführer!
#. fr: C'est le chef des géants<nbsp>! On va s'occuper de son cas<nbsp>!
msgctxt "NpcYell:14323:0:13"
msgid "At last, their leader shows himself!"
msgstr "Наконец-то показался их предводитель!"

#. ja: ヘカトンケイレスの長ね！<br>気をつけて戦うわよ！
#. de: Seid vorsichtig!
#. fr: Voilà le chef des hécatonchires... Combattons avec prudence<nbsp>!
msgctxt "NpcYell:14324:0:13"
msgid "Have care, everyone."
msgstr "Осторожнее, всем."

#. ja: くっ、熱気が…！<br>負けるものかよ！
#. de: Wir werden den Flammen nicht weichen!
#. fr: Argh, l'air est brûlant...<nbsp>! Hors de question de perdre<nbsp>!
msgctxt "NpcYell:14325:0:13"
msgid "We will not yield to the flames!"
msgstr "Не отступим перед пламенем!"

#. ja: 焼けるほど熱いね～<br>だけど、勝ってみせるよ～
#. de: Solch eine brütende Hitze<nbsp>...
#. fr: Je crève de chaud... Mais ça ne suffira pas à m'arrêter<nbsp>!
msgctxt "NpcYell:14326:0:13"
msgid "Such sweltering heat..."
msgstr "Жара просто невыносимая..."

#. ja: 対蛮神の訓練なんて<br>したことないけど…やるわ！
#. de: Dafür haben wir nicht trainiert, doch wir sind bereit. Das weiß ich einfach!
#. fr: Je connais mal cette arme, mais je vais me battre comme je peux<nbsp>!
msgctxt "NpcYell:14327:0:13"
msgid "We've not trained for this, but we're ready. I know it!"
msgstr "Мы к такому не готовились, но справимся. Я уверена!"

#. ja: どんな火傷でも<br>俺が必ず癒やしてやる！
#. de: Beachtet die Flammen nicht weiter. Ich werde mich um eure Wunden kümmern.
#. fr: Je soignerai toute brûlure<nbsp>!
msgctxt "NpcYell:14328:0:13"
msgid "Pay no heed to the flames─I will tend to your wounds."
msgstr "Не обращайте внимания на пламя — я позабочусь о ваших ранах."

#. ja: あの楔…なんだかヤバい！<br>先に壊すぞ！
#. de: Der Nagel gefällt mir nicht. Lasst ihn uns schleunigst zerstören!
#. fr: Je le sens mal, ce pal<nbsp>! Détruisons-le vite<nbsp>!
msgctxt "NpcYell:14329:0:13"
msgid "I like not the looks of that nail. Quickly, we must destroy it!"
msgstr "Мне не нравится этот гвоздь. Надо поскорее его уничтожить!"

#. ja: 楔から強い力を感じる！<br>危険だ、優先して壊そう！
#. de: Ich spüre eine gewaltige Macht in diesem Nagel.
#. fr: Une grande puissance émane du pal<nbsp>! Détruisons-le en priorité<nbsp>!
msgctxt "NpcYell:14330:0:13"
msgid "I sense a terrible power in that nail."
msgstr "От этого гвоздя исходит страшная сила."

#. ja: ずいぶんとジメジメして<br>嫌な場所だぜ…
#. de: Etwas fühlt sich hier nicht richtig an<nbsp>...
#. fr: Il fait humide ici, je déteste ça...
msgctxt "NpcYell:14331:0:13"
msgid "Something feels wrong about this place..."
msgstr "Здесь что-то не так..."

#. ja: ここは空気が淀んでるね～<br>目的を果たして早く帰ろ～
#. de: Noch ein dunkles und trostloses Loch<nbsp>... Na toll.
#. fr: Ce qu'il fait lourd... Terminons vite ce pour quoi on est là.
msgctxt "NpcYell:14332:0:13"
msgid "Another dark and dreary dungeon... Wonderful."
msgstr "Ещё одно тёмное и унылое подземелье... Красота."

#. ja: 意外と天井が高いのね…
#. de: Bei den Gebietern, wie groß dieser Ort ist.
#. fr: Le plafond est vraiment haut...
msgctxt "NpcYell:14333:0:13"
msgid "Gods, would you look at the size of this place."
msgstr "Боги, да вы только посмотрите, какое тут всё огромное."

#. ja: 嫌な風だな…<br>早く目的を果たそう
#. de: Hier weht ein übler Wind. Wir sollten uns beeilen.
#. fr: Ce vent ne me dit rien qui vaille... Finissons-en vite.
msgctxt "NpcYell:14334:0:13"
msgid "An ill wind blows through here. Let us hurry and be about our business."
msgstr "Здесь веет чем-то дурным. Давайте поторопимся и займёмся делом."

#. ja: あれは…<br>皆、毒に気をつけて
#. de: Vorsicht, das ist Gift!
#. fr: Faites attention au poison<nbsp>!
msgctxt "NpcYell:14335:0:13"
msgid "Careful, everyone. It bears poison!"
msgstr "Осторожно, оно ядовитое!"

#. ja: あの植物は…毒に注意だな<br>大丈夫、俺が癒やすさ
#. de: Keine Sorge, ich kümmere mich um das Gift.
#. fr: Ces plantes sont vénéneuses, mais je suis là pour vous soigner.
msgctxt "NpcYell:14336:0:13"
msgid "Fear not─I will deal with its poison."
msgstr "Не бойтесь — с ядом я разберусь."

#. ja: 奴の大きな尻尾…<br>注意した方がよさそうだぜ
#. de: Passt auf den Schwanz auf!
#. fr: Méfions-nous de sa queue.
msgctxt "NpcYell:14337:0:13"
msgid "Be mindful of its tail!"
msgstr "Берегитесь его хвоста!"

#. ja: あの大きな尻尾、怖いね～<br>警戒しとかないと～
#. de: Dieser Schwanz macht bestimmt Ärger.
#. fr: Sa queue est effrayante... Soyons prudents.
msgctxt "NpcYell:14338:0:13"
msgid "That tail looks like trouble."
msgstr "От этого хвоста одни неприятности."

#. ja: この屋敷…<br>背筋がゾクッとするぜ
#. de: Seid auf der Hut!
#. fr: Ce manoir me fait froid dans le dos...
msgctxt "NpcYell:14339:0:13"
msgid "On your guard, everyone."
msgstr "Всем быть начеку."

#. ja: とっても広いお屋敷だね～<br>何部屋あるのかな～？
#. de: Dieses Herrenhaus ist riesig<nbsp>...
#. fr: Il est gigantesque. Combien de pièces peut-il bien y avoir<nbsp>?
msgctxt "NpcYell:14340:0:13"
msgid "This mansion is massive..."
msgstr "Вот это особняк..."

#. ja: こんな広いと迷子になりそう<br>気をつけて進みましょ
#. de: Hier möchte ich mich nicht verlaufen.
#. fr: Y a de quoi se perdre... Restons vigilants.
msgctxt "NpcYell:14341:0:13"
msgid "I would hate to get lost in here."
msgstr "Не хотелось бы здесь заблудиться."

#. ja: この空気…尋常じゃないな<br>いったい何がいるのやら…
#. de: Hier sind dunkle Kräfte am Werk.
#. fr: J'ai une drôle de sensation...
msgctxt "NpcYell:14342:0:13"
msgid "Dark forces are at work here."
msgstr "Здесь творятся тёмные дела."

#. ja: 扉が開いた部屋で<br>光る物が見えた気が…
#. de: Vielleicht gibt es hier ja etwas Nützliches.
#. fr: J'ai l'impression d'avoir vu quelque chose briller dans l'autre pièce...
msgctxt "NpcYell:14343:0:13"
msgid "Perhaps there's something useful in that room."
msgstr "Может, в той комнате найдётся что-нибудь полезное."

#. ja: あれ、東側の部屋…<br>光る物が見えなかったか？
#. de: Glaubt ihr, hier finden wir etwas, das wir gebrauchen können?
#. fr: Tiens<nbsp>? J'ai cru voir une lumière dans la pièce de gauche...
msgctxt "NpcYell:14344:0:13"
msgid "Do you suppose there's anything useful in that room?"
msgstr "Как думаете, в той комнате есть что-нибудь полезное?"

#. ja: 大物…だが、首領じゃねえ<br>さっさと倒そうぜ
#. de: Lasst uns keine Zeit hier verschwenden.
#. fr: Cette créature semble plus forte que les autres, mais ce n'est pas dame Amandine. Débarrassons-nous d'elle.
msgctxt "NpcYell:14345:0:13"
msgid "Let's not waste any time with this one."
msgstr "Не будем тратить на него время."

#. ja: 下っ端が妖異なんだから<br>幹部も当然、妖異だよね～
#. de: Dieser Nichts<shy>gesand<shy>te muss hier irgendwo sein.
#. fr: Pas étonnant que les plus forts soient aussi des fantômes.
msgctxt "NpcYell:14346:0:13"
msgid "Their voidsent master has to be here somewhere."
msgstr "Их повелитель из Бездны где-то здесь."

#. ja: あの魔力の奔流を使えば<br>エントランスに戻れるかも～
#. de: Ich denke, wir können diesen Magiewirbel nutzen, um zum Eingang zurückzukehren.
#. fr: Ce flux éthéré nous ramènera peut-être à l'entrée<nbsp>?
msgctxt "NpcYell:14347:0:13"
msgid "I think we can use this flow of magic to return to the manor entrance."
msgstr "Думаю, этот поток магии вернёт нас ко входу в особняк."

#. ja: 出たな、妖異どもの首魁！<br>俺がぶっ倒してやるぜ！
#. de: Endlich zeigt sich die Dame des Herrenhauses.
#. fr: Voilà la maîtresse des lieux<nbsp>! Je vais lui faire sa fête<nbsp>!
msgctxt "NpcYell:14348:0:13"
msgid "So the lady of the manor reveals herself at last."
msgstr "Вот и хозяйка особняка наконец показалась."

#. ja: すでに妖異と化していたか…<br>いま安らかに眠らせてやるからな！
#. de: Lasst uns diese rastlose Seele zur Ruhe bringen.
#. fr: Il est déjà trop tard... On va abréger vos souffrances<nbsp>!
msgctxt "NpcYell:14349:0:13"
msgid "Let us put this wayward soul to rest."
msgstr "Давайте упокоим эту заблудшую душу."

#. ja: 待ってろッ、ゴブリン族！<br>いま助けるぜ！
#. de: Wir müssen uns beeilen und die Goblins retten.
#. fr: Vous en faites pas, les Gobelins, on va vous sauver<nbsp>!
msgctxt "NpcYell:14350:0:13"
msgid "We must hurry and save the goblins."
msgstr "Надо поспешить и спасти гоблинов."

#. ja: 急いで～助けに行こ～
#. de: Los geht's. Wir müssen ihnen helfen!
#. fr: Allons vite les aider<nbsp>!
msgctxt "NpcYell:14351:0:13"
msgid "Let's get going. We have to help them!"
msgstr "Ну же, скорее! Им надо помочь!"

#. ja: この森の奥に<br>ゴブリン族の集落が…
#. de: Gibt es hier draußen wirklich eine Goblinsiedlung?
#. fr: Les Gobelins vivent dans les profondeurs de cette forêt...
msgctxt "NpcYell:14352:0:13"
msgid "Is there really a goblin settlement out here?"
msgstr "Неужели где-то тут есть поселение гоблинов?"

#. ja: ここからじゃ<br>被害は見えないか…
#. de: Nichts Ungewöhnliches hier. Und dennoch<nbsp>...
#. fr: On ne voit pas les dégâts d'ici...
msgctxt "NpcYell:14353:0:13"
msgid "Nothing appears out of the ordinary. And yet..."
msgstr "Вроде ничего необычного. И всё же..."

#. ja: ゴブリン族はこの先か！<br>待ってろよ！
#. de: Ich hoffe, wir sind nicht zu spät.
#. fr: Tenez bon, on arrive<nbsp>!
msgctxt "NpcYell:14354:0:13"
msgid "I pray we're not too late."
msgstr "Надеюсь, мы не опоздали."

#. ja: この先にも獣の気配…<br>ゴブリン族は無事かしら？
#. de: Bei all den Bestien, die hier lauern, hoffe ich, dass es den Goblins gut geht.
#. fr: Je sens la présence d'une créature... J'espère que les Gobelins n'ont rien.
msgctxt "NpcYell:14355:0:13"
msgid "With all these beasts lurking about, I hope the goblins are all right."
msgstr "Тут повсюду прячутся звери. Надеюсь, с гоблинами всё в порядке."

#. ja: はあ～…無駄に疲れたよ～
#. de: Puh, das war anstrengend.
#. fr: Haa... Je n'en peux plus...
msgctxt "NpcYell:14356:0:13"
msgid "Well, that was exhausting."
msgstr "Ну и вымотались же мы."

#. ja: ブレイフロクス…<br>邪魔…だったな…
#. de: Brüllvolx war nicht sehr hilfreich<nbsp>...
#. fr: Brayflox n'a pas été très utile...
msgctxt "NpcYell:14357:0:13"
msgid "I was expecting Brayflox to be more...helpful."
msgstr "Я-то надеялся, что Брейфлокс окажется полезнее..."

#. ja: ちぃ、仕留めそこなった…<br>次は必ず倒してやる！
#. de: Hmpf. Einfach weggeflogen<nbsp>...
#. fr: Tss, il nous a échappé... On l'aura la prochaine fois<nbsp>!
msgctxt "NpcYell:14358:0:13"
msgid "Hmph. It flew off..."
msgstr "Хм. Улетел..."

#. ja: 逃げられた、か…<br>だが、いまは先へ進むぞ！
#. de: Nun, immerhin kommen wir jetzt weiter voran.
#. fr: Il s'est enfui... Bon, tant pis, continuons notre route.
msgctxt "NpcYell:14359:0:13"
msgid "Well, at least now the way forward is open."
msgstr "Ну, хотя бы теперь путь открыт."

#. ja: さっき逃げたドラゴン族～<br>決着をつけちゃお～
#. de: Der Drache! Diesmal entkommt er uns nicht!
#. fr: Il ne nous échappera pas cette fois<nbsp>!
msgctxt "NpcYell:14360:0:13"
msgid "The dragon! It won't escape this time!"
msgstr "Дракон! В этот раз ему не уйти!"

#. ja: 蛮神タイタン…<br>いいぜ、ぶっ倒してやる！
#. de: Zeit, den Berg in die Knie zu zwingen.
#. fr: Titan, hein... On va lui mettre une bonne raclée<nbsp>!
msgctxt "NpcYell:14361:0:13"
msgid "Time to bring low the mountain."
msgstr "Пора повергнуть эту гору."

#. ja: コボルト族の神、岩神か～<br>硬そうで、嫌になるね～
#. de: Der Herr der Felsen<nbsp>... Aus der Nähe ist er noch unheilvoller.
#. fr: Il a l'air dur comme pierre, ce Titan...
msgctxt "NpcYell:14362:0:13"
msgid "The Lord of Crags... He's much more foreboding in person."
msgstr "Повелитель скал... Вблизи он куда страшнее."

#. ja: いままでの訓練を信じれば<br>蛮神だって怖くないわ！
#. de: Lasst euch nicht aus der Ruhe bringen. Ruft euch euer Training in Erinnerung!
#. fr: Grâce à mon en<shy>traî<shy>ne<shy>ment, même un Primordial ne me fait pas peur<nbsp>!
msgctxt "NpcYell:14363:0:13"
msgid "Don't let him unnerve you. Remember your training!"
msgstr "Не давайте ему сбить вас с толку. Вспомните тренировку!"

#. ja: 癒やしの準備はバッチリだ<br>蛮神タイタンに勝つぞ！
#. de: Es wird euch nicht an Beistand mangeln, versprochen.
#. fr: Je peux soigner quand vous voulez<nbsp>!
msgctxt "NpcYell:14364:0:13"
msgid "You'll not want for succor. I promise you that."
msgstr "Без помощи не останетесь, обещаю."

#. ja: よし、壊したわ！<br>これで少しは…！
#. de: Das Herz ist zerstört, doch ich fürchte, es fängt gerade erst an.
#. fr: Voilà qui devrait faciliter les choses<nbsp>!
msgctxt "NpcYell:14365:0:13"
msgid "The heart is destroyed, but I fear we've only just begun."
msgstr "Сердце уничтожено, но боюсь, всё только начинается."

#. ja: ……ッ！<br>気をつけろ、大技が来るぞ！
#. de: Vorsicht, es ist noch nicht vorbei!
#. fr: Attention, il prépare une grosse attaque<nbsp>!
msgctxt "NpcYell:14366:0:13"
msgid "Careful─this isn't over yet!"
msgstr "Осторожно! Это ещё не конец!"

#. ja: 相手はドラゴン族か…<br>ハッ、負けねえぞ！
#. de: Es braucht mehr als ein paar Drachen, um uns aufzuhalten.
#. fr: Un dragon<nbsp>? Peuh, même pas peur<nbsp>!
msgctxt "NpcYell:14367:0:13"
msgid "It will take more than a few dragons to stop us."
msgstr "Чтобы нас остановить, понадобится не пара драконов."

#. ja: 見事にボロボロですね～<br>ドラゴン族も酷いことを～
#. de: Sie haben aus diesem Ort eine Ruine gemacht.
#. fr: Quel état déplorable... Les dragons n'ont aucune pitié.
msgctxt "NpcYell:14368:0:13"
msgid "They really have made a ruin of this place."
msgstr "Они и правда превратили это место в руины."

#. ja: どこもかしこも瓦礫だらけね<br>足元に注意して進みましょ
#. de: Passt auf, wo ihr hintretet.
#. fr: Faites attention à tous ces débris.
msgctxt "NpcYell:14369:0:13"
msgid "Watch your step."
msgstr "Смотрите под ноги."

#. ja: ドラゴン族は強敵だ<br>負けないよう癒やすぞ！
#. de: Bleibt wachsam. Diese Drachen sollen mächtig sein.
#. fr: Les dragons sont puissants, mais je suis là pour vous soigner<nbsp>!
msgctxt "NpcYell:14370:0:13"
msgid "Stay vigilant. These dragons are said to be formidable."
msgstr "Будьте начеку. Говорят, драконы очень сильны."

#. ja: あの一撃、強烈だったぜ…
#. de: Hoffentlich begegnen wir nicht noch einer dieser Bestien.
#. fr: Quelle attaque de dingue...
msgctxt "NpcYell:14371:0:13"
msgid "Seven hells. I pray we don't face another of those beasts."
msgstr "Семь адов! Надеюсь, больше нам таких чудовищ не встретится."

#. ja: いや～危なかったね～<br>あの一撃、強力すぎだよ～
#. de: Ich dachte, wir wären erledigt.
#. fr: Fiou, c'était chaud bouillant<nbsp>!
msgctxt "NpcYell:14372:0:13"
msgid "I was certain we were done for after that."
msgstr "Я уж думал, нам конец."

#. ja: あのドラゴン族…<br>散々炎を吐いてきた奴よ！
#. de: Das ist der Wyvern, der hier überall Feuer gespuckt hat.
#. fr: Ce dragon... C'est celui qui crachait du feu<nbsp>!
msgctxt "NpcYell:14373:0:13"
msgid "That's the wyvern that's been spouting fire all about the place."
msgstr "Это тот самый виверн, что тут всё огнём поливал."

#. ja: 道中で炎をあびせてきたヤツか<br>勝負を決めるつもりだな！
#. de: Das ist also der Drache, der alles in Flammen gesetzt hat.
#. fr: Il veut en finir, il faut croire<nbsp>!
msgctxt "NpcYell:14374:0:13"
msgid "So it was this dragon who set the halls ablaze."
msgstr "Так вот кто поджёг все коридоры."

#. ja: これでもう炎に悩まず～<br>先へ進めるね～
#. de: Hoffentlich müssen wir uns keine Sorgen um weitere Feuer machen.
#. fr: Et voilà, plus besoin de craindre les flammes.
msgctxt "NpcYell:14375:0:13"
msgid "Hopefully we've no more fires to worry about."
msgstr "Надеюсь, больше с огнём проблем не будет."

#. ja: あのドラゴン族、強いぞ！<br>気を引き締めていくぜ！
#. de: Bei dem hier müssen wir vorsichtig sein.
#. fr: Il est fort, soyez prudents<nbsp>!
msgctxt "NpcYell:14376:0:13"
msgid "We'll need to be careful with this one."
msgstr "С этим придётся быть осторожнее."

#. ja: より寒くなったような…<br>冷気を操るのかしら？
#. de: Was ist das für eine Kälte, die in der Luft liegt?
#. fr: C'est moi ou il gèle...<nbsp>? Il contrôle le froid<nbsp>?
msgctxt "NpcYell:14377:0:13"
msgid "What is this chill in the air?"
msgstr "Что за холод вокруг?"

#. ja: ガルーダ、覚悟しやがれ！
#. de: Mach dich bereit, Garuda!
#. fr: Tu vas en baver, Garuda<nbsp>!
msgctxt "NpcYell:14378:0:13"
msgid "Prepare yourself, Garuda!"
msgstr "Готовься, Гаруда!"

#. ja: 吹き飛ばされないように～<br>気をつけないとね～
#. de: Lasst euch nicht von ihren Windböen treffen!
#. fr: Attention à ne pas vous faire emporter par le vent<nbsp>!
msgctxt "NpcYell:14379:0:13"
msgid "Try not to get swept up in her gales!"
msgstr "Смотрите не попадите под её порывы ветра!"

#. ja: 風が強い…さすが嵐神ね
#. de: Eine steife Brise, die der Herrin der Winde gerecht wird.
#. fr: Quelle rafale... Cette Primordiale mérite bien son surnom...
msgctxt "NpcYell:14380:0:13"
msgid "Fierce winds befitting the Lady of the Vortex."
msgstr "Ветер под стать Повелительнице Вихря."

#. ja: 暴風注意、だな！<br>気合い入れて癒やすぞ！
#. de: Zusammen können wir diesen Sturm überstehen!
#. fr: Je suis là pour vous soigner, mais attention aux bourrasques<nbsp>!
msgctxt "NpcYell:14381:0:13"
msgid "Together, we can weather this storm!"
msgstr "Вместе мы выдержим этот шторм!"

#. ja: 大技がきそうだよ～<br>岩陰に隠れろ～
#. de: In Deckung, schnell!
#. fr: Cachons-nous derrière les rochers pour éviter son attaque<nbsp>!
msgctxt "NpcYell:14382:0:13"
msgid "Quickly─take cover!"
msgstr "Скорее, в укрытие!"

#. ja: 帝国基地の攻略か…<br>気合い入れねえとな！
#. de: Wir dürfen uns keine Fehltritte gegen die Garlear erlauben.
#. fr: Montrons à l'Empire ce qu'on sait faire<nbsp>!
msgctxt "NpcYell:14383:0:13"
msgid "We can afford no missteps against the Garleans."
msgstr "Против гарлеанцев нельзя допустить ни единой ошибки."

#. ja: 帝国基地に攻め込むとは～<br>緊張しますね～
#. de: Ich fürchte, meine Nerven könnten überfordert sein.
#. fr: Je dois avouer qu'il y a de quoi être nerveux.
msgctxt "NpcYell:14384:0:13"
msgid "I fear my nerves may get the best of me."
msgstr "Боюсь, нервы могут меня подвести."

#. ja: 帝国兵だけじゃなく<br>魔導兵器にも注意が必要ね
#. de: Wir müssen nicht nur auf Soldaten, sondern auch auf Magitek aufpassen.
#. fr: Gare aux armes magitek<nbsp>!
msgctxt "NpcYell:14385:0:13"
msgid "We must watch out not only for soldiers, but magitek as well."
msgstr "Нужно остерегаться не только солдат, но и магитеков."

#. ja: 帝国基地で倒れるなんて無様<br>俺が絶対にさせない！
#. de: Solange ich hier bin, werdet ihr nicht sterben. Nicht hier!
#. fr: Hors de question de perdre sur le territoire ennemi<nbsp>!
msgctxt "NpcYell:14386:0:13"
msgid "You'll not fall on my watch. Not here."
msgstr "Пока я здесь, вы не погибнете. Не здесь!"

#. ja: 魔導アーマーを出そうと<br>俺たちは止められねえぞ！
#. de: Sie werden mehr als Magitek benötigen, um uns aufzuhalten.
#. fr: Vos armures magitek ne suffiront pas à nous arrêter<nbsp>!
msgctxt "NpcYell:14387:0:13"
msgid "They will need more than magitek to stop us."
msgstr "Одним магитеком нас не остановить."

#. ja: 魔導アーマーね…<br>取り巻きもいるし厄介だわ
#. de: Noch mehr Soldaten. Als hätte die Magitek-Kampfmaschine nicht gereicht.
#. fr: Des armures magitek... Je sens que ça va être pénible.
msgctxt "NpcYell:14388:0:13"
msgid "More soldiers. As if the magitek armor wasn't enough."
msgstr "Опять солдаты. Будто нам одной магитековой брони было мало."

#. ja: う～ん、あの両腕～<br>とがってて痛そうだね～
#. de: Bleibt von den Armen weg.
#. fr: Ses bras pointus doivent être plus que douloureux...
msgctxt "NpcYell:14389:0:13"
msgid "Stand clear of its arms."
msgstr "Держитесь подальше от его рук."

#. ja: ダルマスカの魔女が相手…<br>よし、訓練どおりやるわよ！
#. de: Der Tribunus! Bleibt konzentriert.
#. fr: On fait comme à l'en<shy>traî<shy>ne<shy>ment<nbsp>!
msgctxt "NpcYell:14390:0:13"
msgid "The tribunus! Stay focused, everyone."
msgstr "Трибун! Всем сосредоточиться."

#. ja: 皆の傷は俺が絶対に癒やす！<br>だから、敵将に勝つぞ！
#. de: Ich kümmere mich um eure Wunden. Konzentriert euch auf den Tribunus!
#. fr: Je vous promets de soigner toutes vos blessures<nbsp>!
msgctxt "NpcYell:14391:0:13"
msgid "I'll see to your wounds. Just focus on the tribunus!"
msgstr "Я позабочусь о ваших ранах. А вы займитесь трибуном!"

#. ja: おっしゃ、待ってろよ！<br>アルテマウェポン！
#. de: Jetzt müssen wir die Ultima-Waffe finden und sie ausschalten.
#. fr: On va réduire l'Ultima Arma en miettes<nbsp>!
msgctxt "NpcYell:14392:0:13"
msgid "Now to find the Ultima Weapon, and shut it down."
msgstr "Теперь найдём оружие «Ультима» и отключим его."

#. ja: 作戦も大詰めだし～<br>頑張っていこ～
#. de: Wenn wir uns einfach nur an den Plan halten, wird alles gut.
#. fr: Notre plan est prêt, à l'attaque<nbsp>!
msgctxt "NpcYell:14393:0:13"
msgid "We need but stick to the plan, and all will be well."
msgstr "Стоит нам придерживаться плана — и всё будет хорошо."

#. ja: こういうときこそ<br>訓練どおりに、ね
#. de: Für diesen Moment haben wir trainiert.
#. fr: Le mieux, c'est de suivre notre en<shy>traî<shy>ne<shy>ment.
msgctxt "NpcYell:14394:0:13"
msgid "Our training has prepared us for this moment."
msgstr "Мы готовились именно к этому моменту."

#. ja: 大一番に緊張してるけど…<br>問題ない、ちゃんと癒やすさ
#. de: Ich werde jetzt nicht die Nerven verlieren.
#. fr: Je tremble comme une feuille mais je vous soignerai.
msgctxt "NpcYell:14395:0:13"
msgid "I'll not let my nerves get the better of me."
msgstr "Я не позволю нервам взять надо мной верх."

#. ja: でかい魔導兵器だが…<br>止められると思うなよ！
#. de: Macht euch bereit. Noch mehr Magitek im Anmarsch!
#. fr: Elle est énorme... Mais ça ne nous arrêtera pas<nbsp>!
msgctxt "NpcYell:14396:0:13"
msgid "Brace yourselves─more magitek!"
msgstr "Приготовьтесь — ещё магитек!"

#. ja: 強力な魔導兵器みたいだが…<br>安心しろ、俺が傷を癒やす！
#. de: Ihr seid in guten Händen, meine Freunde.
#. fr: Elle doit être puissante, mais je suis là pour guérir vos blessures.
msgctxt "NpcYell:14397:0:13"
msgid "You're in good hands, my friends."
msgstr "Вы в надёжных руках, друзья."

#. ja: 魔導アーマーで～<br>ひと泡ふかせちゃえ～
#. de: Diese Magitek-Kampfmaschine sollte die Sache regeln.
#. fr: On va les pulvériser avec l'armure magitek<nbsp>!
msgctxt "NpcYell:14398:0:13"
msgid "This magitek armor should do the job."
msgstr "Эта магитековая броня должна помочь."

#. ja: あの赤い鎧…<br>悪くないじゃないか…
#. de: Blutrot ... Eine passende Farbe.
#. fr: Cette armure rouge... Elle est plutôt pas mal<nbsp>!
msgctxt "NpcYell:14399:0:13"
msgid "Blood crimson... A fitting color."
msgstr "Кроваво-красный... Цвет ему к лицу."

#. ja: あの大きなハンマー…<br>どうやって使うつもり…？
#. de: Sein Hammer scheint unhandlich zu sein, um es gelinde auszudrücken.
#. fr: Qu'est-ce qu'il va faire avec ce gros marteau...<nbsp>?
msgctxt "NpcYell:14400:0:13"
msgid "His hammer seems cumbersome, to say the least."
msgstr "Молот у него, мягко говоря, неудобный."

#. ja: 私の訓練の成果…<br>ガイウスに全部ぶつけるわ！
#. de: Wir haben zu hart gearbeitet, um hier zu scheitern!
#. fr: Nos efforts nous mèneront à la victoire<nbsp>!
msgctxt "NpcYell:14401:0:13"
msgid "We've worked too hard to fail here!"
msgstr "Мы слишком много трудились, чтобы сейчас проиграть!"

#. ja: 漆黒の王狼！<br>お前はここで止める！
#. de: Dies endet hier, Garleischer Wolf!
#. fr: Loup noir, c'en est fini de toi<nbsp>!
msgctxt "NpcYell:14402:0:13"
msgid "This ends here, Black Wolf!"
msgstr "Здесь всё и закончится, Чёрный Волк!"

#. ja: これでこの戦いも決着だ！<br>行くぞォ！
#. de: Kämpft an meiner Seite! Für Eorzea!
#. fr: Il est temps de mettre fin à ce combat<nbsp>!
msgctxt "NpcYell:14403:0:13"
msgid "With me! For Eorzea!"
msgstr "За мной! За Эорзею!"

#. ja: ここが頑張りどきだね～<br>限界ギリギリまでやるよ～
#. de: Dieser Kampf wird uns alles abverlangen!
#. fr: Allez, on tient le coup jusqu'au bout<nbsp>!
msgctxt "NpcYell:14404:0:13"
msgid "This battle demands nothing less than our all!"
msgstr "Этот бой потребует от нас всех сил!"

#. ja: 訓練はこのときのため…<br>さあ、いまこそ！
#. de: Dies ist der Tag, für den wir trainiert haben.
#. fr: On s'est entraînés pour ce moment<nbsp>!
msgctxt "NpcYell:14405:0:13"
msgid "This is the day we've been training for."
msgstr "Мы тренировались ради этого дня."

#. ja: この戦いを終わらせるため…<br>完璧に癒やしてやるぞ！
#. de: Ich kümmere mich um eure Wunden. Jetzt geht und beendet dies!
#. fr: Je vous soignerai à la perfection<nbsp>! À nous la victoire<nbsp>!
msgctxt "NpcYell:14406:0:13"
msgid "I will tend to your wounds. Now, go─finish this!"
msgstr "Я позабочусь о ваших ранах. А теперь идите и покончите с этим!"

#. ja: 暖かな光…この力は！？
#. de: Was ist das für ein Licht<nbsp>...?
#. fr: Cette lumière chaleureuse, c'est...
msgctxt "NpcYell:14407:0:13"
msgid "What is this light...?"
msgstr "Что это за свет?.."

#. ja: 光が導いてくれる…<br>よし、やってやるぞ！
#. de: Das Licht des Kristalls leitet uns!
#. fr: La Lumière nous guide<nbsp>!
msgctxt "NpcYell:14408:0:13"
msgid "The Crystal's Light guides us!"
msgstr "Свет Кристалла ведёт нас!"

#. ja: 体から力があふれる…！<br>いけるぜ、これなら！
#. de: Ich spüre, wie meine Stärke zurückkehrt!
#. fr: Je me sens reprendre des forces...<nbsp>!
msgctxt "NpcYell:14409:0:13"
msgid "I can feel my strength returning!"
msgstr "Чувствую, силы возвращаются!"

#. ja: うお～元気いっぱい～<br>これで決めるよ～！
#. de: Wir dürfen diese Chance nicht vergeuden!
#. fr: Ouah, je pète la forme<nbsp>! Au boulot, maintenant<nbsp>!
msgctxt "NpcYell:14410:0:13"
msgid "We mustn't waste this chance!"
msgstr "Нельзя упустить этот шанс!"

#. ja: 喰らえッ！
#. de: Verliert nicht den Mut!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:14411:0:13"
msgid "Down with you!"
msgstr "Падите!"

#. ja: 翔べるのが<br>竜だけと思うなよ！
#. de: Überlasst die Lüfte uns!
#. fr: Il n'y a pas que les dragons qui peuvent voler<nbsp>!
msgctxt "NpcYell:14412:0:13"
msgid "Leave the skies to us!"
msgstr "Не одним драконам дано летать!"

#. ja: 助太刀する！
#. de: Nieder mit dir!
#. fr: Je viens prêter main-forte<nbsp>!
msgctxt "NpcYell:14413:0:13"
msgid "Do not lose heart!"
msgstr "Не падайте духом!"

#. ja: 上空の竜を叩く！<br>雲廊は任せたぞ！
#. de: Auch wir können auf dem Wind reiten!
#. fr: Je m'occupe de ceux dans les airs<nbsp>!
msgctxt "NpcYell:14414:0:13"
msgid "We too can ride the wind!"
msgstr "И мы умеем летать!"

#. ja: 立て…立つんだ！
#. de: Zurück auf die Beine!
#. fr: Allez... Debout...<nbsp>!
msgctxt "NpcYell:14417:0:13"
msgid "On your feet!"
msgstr "На ноги!"

#. ja: ハシレ、疾風…！
#. de: Wind, weh' geschwind!
#. fr: Le vent se lève<nbsp>!
msgctxt "NpcYell:14418:0:13"
msgid "Winds cut through you!"
msgstr "Ветер, мчи!"

#. ja: 仇ナセ、閃光…！
#. de: Licht, leuchte hell!
#. fr: Que la Lumière soit<nbsp>!
msgctxt "NpcYell:14419:0:13"
msgid "The light shall blind!"
msgstr "Свет ослепит!"

#. ja: 風、よ…光、ヨ…！
#. de: O Wind! O Licht!
#. fr: Le vent... La Lumière...<nbsp>!
msgctxt "NpcYell:14420:0:13"
msgid "Elements to bind you!"
msgstr "Стихии, свяжите его!"

#. ja: ワタシの、魔法、を…
#. de: Erfahrt die Macht meiner Magie!
#. fr: Goûtez... ma magie...
msgctxt "NpcYell:14421:0:13"
msgid "I am without peer!"
msgstr "Мне нет равных!"

#. ja: 魔力よ、ツドエ…！
#. de: Magie, steh mir bei!
#. fr: Il me faut... plus d'éther<nbsp>!
msgctxt "NpcYell:14422:0:13"
msgid "Aether bends to my will!"
msgstr "Эфир, повинуйся мне!"

#. ja: 気を引き締めて<br>いきましょう
#. de: Haltet eure Positionen!
#. fr: Combattons avec prudence.
msgctxt "NpcYell:14423:0:13"
msgid "Steady now!"
msgstr "Спокойно!"

#. ja: 故郷は必ず守ってみせる！
#. de: Wir kämpfen, um unsere Heimat zu beschützen!
#. fr: Je protégerai ma patrie<nbsp>!
msgctxt "NpcYell:14424:0:13"
msgid "We fight to protect our home! To protect Ishgard!"
msgstr "Мы сражаемся, чтобы защитить дом! Защитить Ишгард!"

#. ja: さっさと終わりに<br>しようじゃないか
#. de: Wollen wir es hinter uns bringen?
#. fr: Faisons vite, d'accord<nbsp>?
msgctxt "NpcYell:14425:0:13"
msgid "Let's finish this quickly, shall we?"
msgstr "Давайте покончим с этим поскорее, а?"

#. ja: ぐあっ！
#. de: Uff!
#. fr: Argh<nbsp>!
msgctxt "NpcYell:14426:0:13"
msgid "Urgh!"
msgstr "Уф!"

#. ja: くっ…！
#. de: Argh!
#. fr: Kh...<nbsp>!
msgctxt "NpcYell:14427:0:13"
msgid "Argh!"
msgstr "Ах!"

#. ja: 手強いわね…！
#. de: Welch gewaltige Stärke<nbsp>...
#. fr: Quelle force...
msgctxt "NpcYell:14428:0:13"
msgid "Such terrible strength..."
msgstr "Вот это сила..."

#. ja: 奴はなにを…！？
#. de: Was zum<nbsp>...
#. fr: Il prépare quelque chose<nbsp>!?
msgctxt "NpcYell:14429:0:13"
msgid "What in the...?"
msgstr "Что это он...!?"

#. ja: なんて火力だ…！
#. de: Bei Halone!
#. fr: Quelle puissance...
msgctxt "NpcYell:14430:0:13"
msgid "By the Fury!"
msgstr "Ярость!"

#. ja: 魔法障壁が！？
#. de: Die Barriere!
#. fr: Non, la barrière<nbsp>!
msgctxt "NpcYell:14431:0:13"
msgid "The warding!"
msgstr "Защита!?"

#. ja: これでは<br>また魔法障壁が…
#. de: Verdammt! Die zweite Barriere!
#. fr: Il risque de briser à nouveau la barrière...
msgctxt "NpcYell:14432:0:13"
msgid "Dammit! The second ward!"
msgstr "Чёрт! Вторая защита!"

#. ja: まずいな…
#. de: Das sieht nicht gut aus<nbsp>...
#. fr: Je le sens mal...
msgctxt "NpcYell:14433:0:13"
msgid "This bodes ill..."
msgstr "Плохо дело..."

#. ja: すっごい攻撃がくるよ！
#. de: Macht euch auf einen Angriff gefasst!
#. fr: Il va lancer une grosse attaque<nbsp>!
msgctxt "NpcYell:14434:0:13"
msgid "Brace yourselves!"
msgstr "Приготовьтесь!"

#. ja: ナメてくれるなよ！
#. de: Ich gebe nicht auf!
#. fr: Je peux encore me battre<nbsp>!
msgctxt "NpcYell:14435:0:13"
msgid "Fall!"
msgstr "Падите!"

#. ja: この槍に誓って！<br>戦い抜くのみ！
#. de: Ich werde das bis zum Ende durchziehen. Das schwöre ich bei meiner Lanze!
#. fr: Je jure sur ma lance d'aller jusqu'au bout<nbsp>!
msgctxt "NpcYell:14436:0:13"
msgid "I will see this through to the end. Upon my lance, I swear it!"
msgstr "Я доведу это дело до конца. Клянусь своим копьём!"

#. ja: 正念場ね…！
#. de: Die wahre Schlacht beginnt jetzt!
#. fr: C'est maintenant que tout se joue...
msgctxt "NpcYell:14437:0:13"
msgid "The true battle begins here!"
msgstr "Вот теперь начнётся настоящая битва!"

#. ja: 本気だしていこう！
#. de: Schlagt sie zu Brei!
#. fr: Pas de quartier<nbsp>!
msgctxt "NpcYell:14438:0:13"
msgid "We must bring our all to bear!"
msgstr "Выложимся на полную!"

#. ja: ルキア様…！
#. de: Seneschall Lucia!
#. fr: Dame Lucia...<nbsp>!
msgctxt "NpcYell:14439:0:13"
msgid "Commander!"
msgstr "Командир!"

#. ja: 我々も共に！
#. de: Wir stehen vereint!
#. fr: Vous pouvez compter sur nous<nbsp>!
msgctxt "NpcYell:14440:0:13"
msgid "We stand as one!"
msgstr "Мы с вами!"

#. ja: うおおおッ！
#. de: Graaaaaah!
#. fr: Haaah<nbsp>!
msgctxt "NpcYell:14444:0:13"
msgid "Graaaaaah!"
msgstr "А-а-а-а!"

#. ja: ぐっ！
#. de: Argh!
#. fr: Argh<nbsp>!
msgctxt "NpcYell:14445:0:13"
msgid "Urgh!"
msgstr "Уф!"

#. ja: ここで斃れるわけには…！
#. de: Wir ... dürfen nicht<nbsp>... weichen<nbsp>...!
#. fr: On doit... tenir bon...
msgctxt "NpcYell:14446:0:13"
msgid "We...must not...falter...!"
msgstr "Нам... нельзя... падать...!"

#. ja: ま、まだか…！？
#. de: Verdammt sei dieses endlose Inferno!
#. fr: Il tient encore...<nbsp>?
msgctxt "NpcYell:14447:0:13"
msgid "Damn this ceaseless inferno!"
msgstr "Проклятое бесконечное пекло!"

#. ja: ハルオーネの大盾よ…<br>守り給え！
#. de: Halone, ich flehe dich an, verleihe uns Stärke!
#. fr: Ô Halone, prête-nous ta force<nbsp>!
msgctxt "NpcYell:14448:0:13"
msgid "Halone, I beg you─grant us strength!"
msgstr "Халонэ, молю тебя — даруй нам силу!"

#. ja: 皇都を守るのだ…<br>なんとしても！
#. de: Wir müssen durchhalten! Das müssen wir einfach!
#. fr: Protégeons la cité coûte que coûte<nbsp>!
msgctxt "NpcYell:14449:0:13"
msgid "We must hold on! We must!"
msgstr "Мы должны держаться! Должны!"

#. ja: ぐおおおおッ！
#. de: Arrrggghhh!
#. fr: Aaargh<nbsp>!
msgctxt "NpcYell:14450:0:13"
msgid "Arrrggghhh!"
msgstr "А-а-а-а!"

#. ja: 魔法障壁が保たない…<br>かくなる上は！
#. de: Die Barriere wird solch einem Angriff nicht standhalten<nbsp>...
#. fr: La barrière risque de ne pas tenir... Advienne que pourra<nbsp>!
msgctxt "NpcYell:14451:0:13"
msgid "The barrier cannot suffer such an attack..."
msgstr "Защита не выдержит такой атаки..."

#. ja: この力を受け取るんだ！<br>勇なる力…ブレイブ！
#. de: Kopf hoch, <split " " 1><string $gs1></split>. Wir stehen das durch!
#. fr: Ne fléchissez pas face à l'adversité... Courage<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:14452:0:13"
msgid "Take heart, <split \" \" 1><string $gs1></split>. We will prevail!"
msgstr "Не падай духом, <split \" \" 1><string $gs1></split>. Мы победим!"

#. ja: 竜騎士団よ、底力を見せよ！
#. de: Zeigen wir ihnen die Stärke der Streiter Ishgards!
#. fr: Montrons un peu ce qu'on vaut<nbsp>!
msgctxt "NpcYell:14453:0:13"
msgid "Let us show them the strength of Ishgard's finest!"
msgstr "Покажем им, на что способны лучшие в Ишгарде!"

#. ja: 貫いてみせる！
#. de: Jetzt oder nie!
#. fr: Je vais le transpercer<nbsp>!
msgctxt "NpcYell:14454:0:13"
msgid "It's now or nothing!"
msgstr "Сейчас или никогда!"

#. ja: 守り抜く…！<br>必ず…！
#. de: Komme, was wolle, wir müssen durchhalten!
#. fr: Je protégerai la cité jusqu'au bout<nbsp>!
msgctxt "NpcYell:14455:0:13"
msgid "Come what may, we must hold on!"
msgstr "Что бы ни случилось, мы должны держаться!"

#. ja: チッ…！<br>やってくれる…！
#. de: Passt auf!
#. fr: Tss, il se débrouille bien...
msgctxt "NpcYell:14456:0:13"
msgid "Look out!"
msgstr "Берегись!"

#. ja: 来るぞ！<br>退避しろ！
#. de: Ausweichen!
#. fr: Il attaque<nbsp>! Esquivez<nbsp>!
msgctxt "NpcYell:14457:0:13"
msgid "Stand clear!"
msgstr "Отойдите!"

#. ja: ギギ…ギギギ…
#. de: \<knister>
#. fr: Tchik tchik tchik...
msgctxt "NpcYell:14458:0:13"
msgid "\\<sizzle>"
msgstr "\\<шшш>"

#. ja: ピカピカ☆
#. de: GRüßE!
#. fr: Dzi-zz... Dz-zz-zi<nbsp>! Tout neuf, tout beau<nbsp>!
msgctxt "NpcYell:14459:0:13"
msgid "GrEeTiNgS!"
msgstr "ПрИвЕтСтВуЮ!"

#. ja: クエーッ！
#. de: Kwieh!
#. fr: Kwéééé<nbsp>!
msgctxt "NpcYell:14460:0:13"
msgid "Kwee!"
msgstr "Кви-и!"

#. ja: ニャ…
#. de: Ein Schal? Für mich<nbsp>...?
#. fr: Miaou...
msgctxt "NpcYell:14461:0:13"
msgid "Nyah!"
msgstr "Мяу!"

#. ja: ブ、ブヒッ！？
#. de: \<quiek>!
#. fr: Gruic gruiiic<nbsp>!
msgctxt "NpcYell:14462:0:13"
msgid "Oink!?"
msgstr "Хрю!?"

#. ja: 敬礼☆
#. de: BiS diCh das MeEr verSChliNgt!
#. fr: Longue vie à l'Amirale<nbsp>! Dzz<nbsp>!
msgctxt "NpcYell:14463:0:13"
msgid "TiLl SeA sWaLlOwS aLl!"
msgstr "ПоКа мОрЕ нЕ пОгЛоТиТ вСеХ!"

#. ja: 敬礼☆
#. de: FolGE deM WilLeN des WaLdEs!
#. fr: Longue vie à notre Oracle<nbsp>! Dzz<nbsp>!
