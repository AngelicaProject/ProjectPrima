msgid "0"
msgstr ""

#. ja: あなたを必ず護るので<br>我らのそばを離れないでくれ
#. de: Wir stehen zwischen Euch und allen, die Euch Böses wollen.
#. fr: Je vous en prie, restez près de nous.
msgctxt "NpcYell:8573:0:13"
msgid "I must ask that you refrain from wandering..."
msgstr ""

#. ja: …よろしく頼むよ
#. de: Weicht uns nicht von der Seite, bitte.
#. fr: Si vous vous écartez trop, nous ne pourrons pas vous protéger...
msgctxt "NpcYell:8574:0:13"
msgid "...and avoid any needless frolicking."
msgstr ""

#. ja: お散歩、ルンルン♪
#. de: Spazieeeren! ♪
#. fr: Ah<nbsp>! Les rayons du soleil sur ma peau<nbsp>! Tralalala<nbsp>!♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8575:0:13"
msgid "Oh, I wouldn't dream of it!<br>La la la♪"
msgstr ""

#. ja: 例のブツの開発…<br>遅れは許されないぞい？
#. de: Wir dürfen auf keinen Fall zu spät kommen!
#. fr: On ne peut pas prendre du retard pour ce que tu sais...
msgctxt "NpcYell:8576:0:13"
msgid "So, is it finished?"
msgstr ""

#. ja: わかっておる…<br>ワシらの切り札じゃからの！
#. de: Ich weiß, ja! Unser Trumpf ...
#. fr: Oui... On parle quand même de notre arme secrète<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8577:0:13"
msgid "It'll be finished when I say<br>it's finished, and I say it's<br>not finished! At least not yet."
msgstr ""

#. ja: 完成すればトルーの連中を<br>一気に叩くことだって…
#. de: Wenn wir rechtzeitig fertig werden, macht dieser Tholl-Zottelbart ein dummes Gesicht! Ha!
#. fr: Quand il sera prêt, on pourra balayer tous les Tholl d'un coup<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8578:0:13"
msgid "Well, let me know when it is!<br>I don't want to miss when we<br>crush the Tholls!"
msgstr ""

#. ja: ボガッ！<br>ボガガッ！
#. de: BoAAaH! BOaAAahN!
#. fr: Boum<nbsp>! Boum boum<nbsp>!
msgctxt "NpcYell:8579:0:13"
msgid "TO SHREDS! TO SHREDS!"
msgstr ""

#. ja: ブシューッ！
#. de: Frssssha!
#. fr: Ssshhh<nbsp>!
msgctxt "NpcYell:8580:0:13"
msgid "Fraaagh!"
msgstr ""

#. ja: キィィィィッ！
#. de: Kshiiiiiie!
#. fr: Crriiiiiiii<nbsp>!
msgctxt "NpcYell:8581:0:13"
msgid "Hiiiiish!"
msgstr ""

#. ja: シャシャシャッ！
#. de: Sssssssha!
#. fr: Rhaaaa<nbsp>!
msgctxt "NpcYell:8582:0:13"
msgid "Braaaaaagh!"
msgstr ""

#. ja: まて…そこに誰かおるな？<br>トルーのネズミ野郎め！
#. de: He, wer ist denn das? Ist das etwa einer dieser Tholl-Handlanger?
#. fr: Attends, j'ai l'impression que... quelqu'un nous écoute<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8583:0:13"
msgid "Who goes there!?<br>A Tholl spy!?"
msgstr ""

#. ja: 侵入者発見…<br>侵入者発見…！
#. de: Eindringlinge! Eindringlinge!
#. fr: Intrus détecté... Intrus détecté<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8584:0:13"
msgid "Intruder detected...<br>Intruder detected..."
msgstr ""

#. ja: 行け、オートマトン！<br>ヤツをボコボコするんじゃ！
#. de: Jetzt ziehen dir unsere Marionetten den Bart lang, haha!
#. fr: Automates, à l'attaque<nbsp>! Mettez-lui une bonne raclée<nbsp>!
msgctxt "NpcYell:8585:0:13"
msgid "Don't let him escape!"
msgstr ""

#. ja: しまったラリ！？<br>尾行がバレたラリ！！
#. de: Was? Bin ich aufgeflogen? Oh nein! Eine Falle!
#. fr: Mince, je suis découvert<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8586:0:13"
msgid "Gulg's belly!<br>They found me!"
msgstr ""

#. ja: 警報発令…<br>警報発令…！
#. de: Alarm ausgelöst<nbsp>...
#. fr: Alerte... Alerte<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8587:0:13"
msgid "Warning!<br>Warning!"
msgstr ""

#. ja: あわわわわ…<br>誰か助けてくれラリ～！
#. de: Aaah! Zu Hilfe!
#. fr: À l'aide<nbsp>! Quelqu'un<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8588:0:13"
msgid "Help! Someone! Anyone!<br>I'm too short to die!"
msgstr ""

#. ja: やっちまえ～！
#. de: Eisenharke aktiviert!
#. fr: Pas de quartier<nbsp>!
msgctxt "NpcYell:8589:0:13"
msgid "Crush him!"
msgstr ""

#. ja: そこじゃ～！
#. de: Ja! Los! Haut ihm eine Beule in den Blechhut!
#. fr: Qu'il souffre<nbsp>!
msgctxt "NpcYell:8590:0:13"
msgid "Go for the beard!"
msgstr ""

#. ja: ボコボコじゃ～！
#. de: Schrott und schrotter!
#. fr: Pourriture de Tholl<nbsp>!
msgctxt "NpcYell:8591:0:13"
msgid "Left! Right! Left!"
msgstr ""

#. ja: あわわわわ…！
#. de: Aaah!
#. fr: Aïeuuuh<nbsp>!
msgctxt "NpcYell:8592:0:13"
msgid "Not the beard! Not the beard!"
msgstr ""

#. ja: どっかいけっ！
#. de: Lasst mich in Ruh!
#. fr: T'approche pas<nbsp>!
msgctxt "NpcYell:8593:0:13"
msgid "How is this fair!?"
msgstr ""

#. ja: この、このっ！
#. de: Dir schlag ich die Nieten raus, Blecheimer!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:8594:0:13"
msgid "You'll regret that!"
msgstr ""

#. ja: 旗色がわるいぞい！<br>逃げるんじゃ～！
#. de: Das Schlachtenglück hat sich gewendet! Flieht, Leute!
#. fr: Ça commence à sentir le roussi... On se fait la malle<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8595:0:13"
msgid "They've got us by the beard!<br>To the hills!"
msgstr ""

#. ja: あっ、こら待て！
#. de: Bleibt hier, ihr feigen Milchbärte!
#. fr: Hé là<nbsp>! Pas si vite<nbsp>!
msgctxt "NpcYell:8596:0:13"
msgid "Wait, you two!"
msgstr ""

#. ja: 参ったか！<br>二度と嗅ぎ回るんじゃないぞい！
#. de: Noch einmal kommst du uns nicht in die Quere!
#. fr: T'as compris la leçon<nbsp>? Et t'avise pas de revenir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8597:0:13"
msgid "That will teach you to<br>stick your beard in Gogg<br>business!"
msgstr ""

#. ja: ひぃ…<br>逃げろ～！
#. de: Uaaah, schnell weg hier!
#. fr: Il faut savoir abandonner<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8598:0:13"
msgid "You won't see me again!<br>I swear it!"
msgstr ""

#. ja: くっ…逃げ切れんぞい！<br>このままでは計画が…
#. de: Ohje, was nun? Unser schöner Plan ...
#. fr: Mince, je suis bloqué<nbsp>! Notre plan va tomber à l'eau...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8599:0:13"
msgid "These legs can only carry us<br>so far. We must fight!"
msgstr ""

#. ja: ジャアアアッ！
#. de: Fraaaaaaaaah! Sssssh!
#. fr: Aaaargh<nbsp>! Ssshhh...
msgctxt "NpcYell:8600:0:13"
msgid "Graaaaaaagh! Hraaaagh!"
msgstr ""

#. ja: 負けたっていうのか？<br>そ、総員退避だーッ！
#. de: V-Verloren?! Nichts wie weg! Rette sich, wer kann!
#. fr: Impossible... Nous avons perdu<nbsp>! Vite, mettez-vous à l'abri<nbsp>!
msgctxt "NpcYell:8601:0:13"
msgid "The battle is lost! Fall back, fall back!"
msgstr ""

#. ja: 助けにきたぞ！
#. de: Hilfe ist daaa! 
#. fr: Lali-ho ho hoooo<nbsp>! On arrive à la rescousse<nbsp>!
msgctxt "NpcYell:8602:0:13"
msgid "You rang, cousins?"
msgstr ""

#. ja: お前たち…<br>やっちまいな～！
#. de: Jetzt bist du dran, du aufgeblasener Stollenknilch!
#. fr: Lali-ho<nbsp>! Mettez une bonne taule à ce Tholl<nbsp>!
msgctxt "NpcYell:8603:0:13"
msgid "Crush them all!"
msgstr ""

#. ja: やっぱり悪巧みを…<br>何を企んでいるラリ～！
#. de: Diese hinterlistigen Goggs planen doch was!
#. fr: Je savais qu'ils tramaient quelque chose... Mais quoi<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8604:0:13"
msgid "I knew it! The Goggs are<br>up to no good!"
msgstr ""

#. ja: やるじゃねぇか！
#. de: Ha, nicht schlecht!
#. fr: 0
msgctxt "NpcYell:8605:0:13"
msgid "0"
msgstr ""

#. ja: 援軍…！？<br>それなら戦うまでラリ！
#. de: Was? Noch mehr Gogg-Bärte!
#. fr: Des renforts<nbsp>? Pas le choix, il faut se battre<nbsp>!
msgctxt "NpcYell:8606:0:13"
msgid "Where did they come from!?"
msgstr ""

#. ja: どりゃ～！
#. de: Muahaha!
#. fr: Ga haaa<nbsp>!
msgctxt "NpcYell:8607:0:13"
msgid "Ngah!"
msgstr ""

#. ja: 計画は邪魔させん！
#. de: Du wirst unseren Plan nicht durchkreuzen!
#. fr: Vous pourrez pas stopper notre plan secret<nbsp>!
msgctxt "NpcYell:8608:0:13"
msgid "Leave us alone!"
msgstr ""

#. ja: トルーに味方するヤツは<br>許さんのじゃ！
#. de: Misch dich nicht ein, Tholl-Abschaum!
#. fr: Les amis des Tholl sont nos ennemis<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8609:0:13"
msgid "Any friend of the Tholls<br>is an enemy of ours!"
msgstr ""

#. ja: ブチかまーす！
#. de: Stampft ihn in den Boden!
#. fr: Prends ça dans ton pif<nbsp>!
msgctxt "NpcYell:8610:0:13"
msgid "Right in the stones!"
msgstr ""

#. ja: おんどりゃ～！
#. de: Los, reißt ihm die Barthaare einzeln aus!
#. fr: Bim, en plein dans la figure<nbsp>!
msgctxt "NpcYell:8611:0:13"
msgid "For the Goggs!"
msgstr ""

#. ja: ハァ…ハァ…参った！<br>降参じゃ、全部話すぞい！
#. de: Urks, also gut, ich bin geschlagen. Ich gebe auf!
#. fr: Haa... Haa... C'est bon, c'est bon, j'avoue tout<nbsp>!
msgctxt "NpcYell:8612:0:13"
msgid "Alright! Alright! I'll talk!"
msgstr ""

#. ja: 消し飛べッ！
#. de: Aus meinen Augen!
#. fr: Hors de ma vue<nbsp>!
msgctxt "NpcYell:8613:0:13"
msgid "Out of my sight!"
msgstr ""

#. ja: 絶望とともに眠れ！
#. de: Erstickt an eurer Ver<shy>zweif<shy>lung!
#. fr: Tombez dans l'abîme du désespoir<nbsp>!
msgctxt "NpcYell:8614:0:13"
msgid "Let seep sorrow into your heart."
msgstr ""

#. ja: ワシらの最終兵器が<br>もうすぐ完成するのじゃ！
#. de: Wir haben da eine Überraschung für euch Thollpel gebaut. Du wirst Augen machen. Hehe.
#. fr: Notre arme secrète est sur le point d'être terminée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8615:0:13"
msgid "Our secret weapon is<br>almost complete!"
msgstr ""

#. ja: 今日は負けたが…<br>最後はワシらが勝～つ！
#. de: Kennst du den Spruch „die Schlacht mag verloren ein, aber der Krieg ist noch nicht entschieden“?
#. fr: On a perdu cette bataille, mais on gagnera la guerre à coup sûr<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8616:0:13"
msgid "You may have defeated us<br>today, but tomorrow shall be ours!"
msgstr ""

#. ja: さあ、何を企んでたラリ！<br>素直に説明するラリ！
#. de: Dann raus mit der Sprache, du Halunke! Gestehe!
#. fr: De quel genre d'arme secrète il s'agit<nbsp>? Parle<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8617:0:13"
msgid "Tell me your plan or I'll<br>have your helm!"
msgstr ""

#. ja: 思い知るがいい！
#. de: Bis hierhin und nicht weiter!
#. fr: Vous allez regretter de m'avoir affronté<nbsp>!
msgctxt "NpcYell:8618:0:13"
msgid "A fitting death!"
msgstr ""

#. ja: 聞き捨てならないラリ！<br>村でじっくり聞くラリ～！
#. de: Klappe zu! Du wirst jetzt mit mir zurück ins Dorf gehen und Informationsgulasch auftischen!
#. fr: Tu vas me suivre au village et cracher tout ce que tu sais<nbsp>!
msgctxt "NpcYell:8619:0:13"
msgid "Not if you're rotting in our gaol!"
msgstr ""

#. ja: あいたたた…<br>降参じゃ！
#. de: Diese Schande! Der Spott! Die Scham!
#. fr: Aïe aïe aïe<nbsp>! Doucement<nbsp>!
msgctxt "NpcYell:8620:0:13"
msgid "We yield!"
msgstr ""

#. ja: 戦略的撤退じゃ～！
#. de: Taktischer Rückzug, Leute!
#. fr: Changement de plan, repli immédiat<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8621:0:13"
msgid "You wouldn't stab a dwarf<br>in the back now, would you?"
msgstr ""

#. ja: まずいぞい…！<br>ここは逃げの一手じゃ！
#. de: Uh, das ist gar nicht gut! Weg hier!
#. fr: Ouille, mes fesses<nbsp>! C'est bon, j'abandonne<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8622:0:13"
msgid "Run today, live to<br>fight another day!"
msgstr ""

#. ja: 地殻を掴みて手甲となす！
#. de: In meinen Fäusten liegt der Zorn Gaias!
#. fr: Mes poings sont aussi durs que le roc<nbsp>!
msgctxt "NpcYell:8623:0:13"
msgid "Perish at my hands!"
msgstr ""

#. ja: 地殻を履きて車輪となす！
#. de: Gaias Gram rollt über euch hinweg!
#. fr: De la terre, je fais ma monture ainsi que ma route<nbsp>!
msgctxt "NpcYell:8624:0:13"
msgid "You are no obstacle!"
msgstr ""

#. ja: 逃れられると思うなよ…！
#. de: Gaia hungert<nbsp>...
#. fr: Inutile de fuir... Aucune terre n'est assez lointaine<nbsp>!
msgctxt "NpcYell:8625:0:13"
msgid "There is nowhere to hide."
msgstr ""

#. ja: 轢き潰してくれようぞ…！
#. de: Hinfort! Dieser Gewalt seid ihr nicht gewachsen!
#. fr: Mes roues vous broieront<nbsp>!
msgctxt "NpcYell:8626:0:13"
msgid "You are out of your element!"
msgstr ""

#. ja: 大地の怒りに砕け散れ！
#. de: 0
#. fr: Que la fureur de cette terre vous pulvérise<nbsp>!
msgctxt "NpcYell:8627:0:13"
msgid "My rage knows no bounds!"
msgstr ""

#. ja: ずー…
#. de: Zzz ...
#. fr: Zzz...
msgctxt "NpcYell:8628:0:13"
msgid "Zzz..."
msgstr ""

#. ja: むにゃむにゃ…
#. de: \<schnarch>
#. fr: (ronfle)...
msgctxt "NpcYell:8629:0:13"
msgid "\\<slurp> \\<snort>"
msgstr ""

#. ja: すー…すー…
#. de: \<murmel> Moel ... Mehr... Moeeel ... 
#. fr: Zzz... Les Cristariens... Ils... Ils... Zzz...
msgctxt "NpcYell:8630:0:13"
msgid "Mmmmmm...  Sacrilicious..."
msgstr ""

#. ja: おい、起きろ！
#. de: Wach auf, Dummkopf!
#. fr: Mais merde, vous allez vous lever<nbsp>!?
msgctxt "NpcYell:8631:0:13"
msgid "Wake up! Wake up, damn you!"
msgstr ""

#. ja: どうしたんだよ！
#. de: Was ist mit dir los? Steh auf!
#. fr: C'est quoi ce foutoir<nbsp>!?
msgctxt "NpcYell:8632:0:13"
msgid "What's the matter!?"
msgstr ""

#. ja: この粉のせいか！？
#. de: Ein Schlafpulver?
#. fr: Cette poudre qui flotte dans l'air... Ce serait pas à cause de ça<nbsp>!?
msgctxt "NpcYell:8633:0:13"
msgid "Some kind of sleeping powder?"
msgstr ""

#. ja: 侵入者め！
#. de: Jetzt geht's euch an den Kragen!
#. fr: On va tous vous mettre aux fers<nbsp>!
msgctxt "NpcYell:8634:0:13"
msgid "Why you!"
msgstr ""

#. ja: やらせるか！
#. de: Nimm das!
#. fr: Vous croyez avoir une chance<nbsp>!?
msgctxt "NpcYell:8635:0:13"
msgid "Try this!"
msgstr ""

#. ja: 覚悟しろ！
#. de: Das wirst du bereuen!
#. fr: Faites vos prières<nbsp>!
msgctxt "NpcYell:8636:0:13"
msgid "Don't get ahead of yourself!"
msgstr ""

#. ja: ハァッ！
#. de: Hah!
#. fr: Yaaa<nbsp>!
msgctxt "NpcYell:8637:0:13"
msgid "Hah!"
msgstr ""

#. ja: 負けるか！
#. de: Arrr ...
#. fr: Retournez sur votre île<nbsp>!
msgctxt "NpcYell:8638:0:13"
msgid "Yah!"
msgstr ""

#. ja: セイッ！
#. de: Hier!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:8639:0:13"
msgid "There!"
msgstr ""

#. ja: 行くぞッ！
#. de: Der ist für dich!
#. fr: Ça va faire mal<nbsp>!
msgctxt "NpcYell:8640:0:13"
msgid "Have at them!"
msgstr ""

#. ja: 進め進めッ！
#. de: Vorwärts!
#. fr: Poussez l'attaque<nbsp>!
msgctxt "NpcYell:8641:0:13"
msgid "Forward!"
msgstr ""

#. ja: うぉぉぉぉ！
#. de: Aaah!
#. fr: Iiiaaarrrr<nbsp>!
msgctxt "NpcYell:8642:0:13"
msgid "Yaaargh!"
msgstr ""

#. ja: お任せください！
#. de: Überlasst die uns!
#. fr: On se charge d'eux<nbsp>!
msgctxt "NpcYell:8643:0:13"
msgid "Leave them to us!"
msgstr ""

#. ja: きゃあっ
#. de: Euch zahl ich's jetzt heim!
#. fr: Non<nbsp>!
msgctxt "NpcYell:8644:0:13"
msgid "No!"
msgstr ""

#. ja: うぅ…
#. de: Mich kriegt ihr nie!
#. fr: Ah<nbsp>!
msgctxt "NpcYell:8645:0:13"
msgid "Ungh..."
msgstr ""

#. ja: っ……
#. de: ...
#. fr: Aïe...
msgctxt "NpcYell:8646:0:13"
msgid "Ah!"
msgstr ""

#. ja: くうっ…
#. de: Urks.
#. fr: Hngh...
msgctxt "NpcYell:8647:0:13"
msgid "Hmph..."
msgstr ""

#. ja: うっ…！
#. de: Ah!
#. fr: Aah<nbsp>!
msgctxt "NpcYell:8648:0:13"
msgid "Ah!"
msgstr ""

#. ja: ぐあっ！
#. de: Argh.
#. fr: Argh<nbsp>!
msgctxt "NpcYell:8649:0:13"
msgid "Ugh..."
msgstr ""

#. ja: うあッ…
#. de: Verfl...
#. fr: Uarg...
msgctxt "NpcYell:8650:0:13"
msgid "Unnngh..."
msgstr ""

#. ja: きゃぁっ！
#. de: Mist!
#. fr: Han<nbsp>!
msgctxt "NpcYell:8651:0:13"
msgid "Oh!"
msgstr ""

#. ja: しまった…！
#. de: Grrr.
#. fr: Ah<nbsp>! Je l'ai sentie passer...
msgctxt "NpcYell:8652:0:13"
msgid "Confound it!"
msgstr ""

#. ja: それにしても<br>自然が豊かな美しい街だな…
#. de: Trotz aller Unruhen ist diese Stadt atemberaubend. Eine unglaubliche Harmonie mit der Natur!
#. fr: Cette ville est vraiment splendide et si paisible...
msgctxt "NpcYell:8653:0:13"
msgid "I don't think I've ever seen anywhere so peaceful and serene."
msgstr ""

#. ja: ハハハ、考えておこう…
#. de: Hah! Wir werden es uns überlegen.
#. fr: Ha ha ha<nbsp>! Peut-être... Je vais y réfléchir.
msgctxt "NpcYell:8654:0:13"
msgid "Ha ha! I will give it some thought."
msgstr ""

#. ja: こらッ、勝手な行動は…
#. de: W-Was tut sie denn?
#. fr: Attendez<nbsp>! N'allez pas n'importe où<nbsp>!
msgctxt "NpcYell:8655:0:13"
msgid "Wait! Don't run on ahead!"
msgstr ""

#. ja: まったく…困ったもんだ…
#. de: Das ... ist überhaupt nicht hilfreich.
#. fr: Il ne manquait plus que ça<nbsp>!
msgctxt "NpcYell:8656:0:13"
msgid "This is all we need..."
msgstr ""

#. ja: 私も大好きな街なの<br>あなたたちも住んでみたら？
#. de: Ich lieeebe diese Stadt auch! He, warum zieht ihr nicht einfach bei mir ein?
#. fr: Gridania est ma cité préférée. Je pense que vous devriez vous y installer, vous aussi.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8657:0:13"
msgid "Oh, Gridania is a wonderful<br>place indeed! You should<br>stay a while."
msgstr ""

#. ja: 大丈夫だった…?
#. de: Ist alles in Ordnung?
#. fr: Tout va bien<nbsp>?
msgctxt "NpcYell:8658:0:13"
msgid "What was that all about?"
msgstr ""

#. ja: エディシアが心配だわ…
#. de: Ich sorge mich um die arme Editha<nbsp>...
#. fr: J'espère que ma<shy>de<shy>moi<shy>sel<shy>le Editha n'a rien...
msgctxt "NpcYell:8659:0:13"
msgid "I hope Editha is all right!"
msgstr ""

#. ja: 護衛さん、彼女をお願い！
#. de: Gebt gut auf sie Acht, bitte!
#. fr: Je vous en prrrie. Prenez bien soin d'elle<nbsp>!
msgctxt "NpcYell:8660:0:13"
msgid "Please, take good care of her."
msgstr ""

#. ja: わしが護ろうかの？
#. de: Braucht ihr noch eine helfende Hand?
#. fr: Si je peux vous aider, n'hésitez pas à me le dire.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8661:0:13"
msgid "If you require my assistance,<br>do not hesitate to ask!"
msgstr ""

#. ja: 音楽堂に着くまで<br>勝手な行動は慎んでくれ
#. de: Editha, bitte haltet Euch mit Grüßen und dergleichen zurück, bis wir am Amphitheater sind.
#. fr: Je vous en prie, restez près de nous jusqu'à l'amphithéâtre.
msgctxt "NpcYell:8662:0:13"
msgid "Editha, you mustn't run off like that again!"
msgstr ""

#. ja: はーい、りょーかい！
#. de: Ist gut, lieber Leibwächtermann!
#. fr: D'accoooord<nbsp>! J'ai compriiiis<nbsp>!
msgctxt "NpcYell:8663:0:13"
msgid "Oh! You're no fun!"
msgstr ""

#. ja: ところで、君には<br>狙われる心当たりはないか？
#. de: Habt Ihr eigentlich eine Idee, warum man es auf Euch abgesehen hat?
#. fr: Mais dites, vous n'avez pas une idée de qui peut vous en vouloir comme ça<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8664:0:13"
msgid "Do you know who could<br>be behind these attacks?"
msgstr ""

#. ja: う～ん…わかんない
#. de: Hmm ... Nein! Keine Idee!
#. fr: Absolument paaaas<nbsp>!
msgctxt "NpcYell:8665:0:13"
msgid "No idea."
msgstr ""

#. ja: ヒトって難しいから
#. de: Ich weiß nicht viel über Laufe... äh, Leute.
#. fr: J'ai du mal à comprendre les gens, mooooi.
msgctxt "NpcYell:8666:0:13"
msgid "Crazy people?"
msgstr ""

#. ja: そうだな<br>人の心は難しいものだ…
#. de: Nachvollziehbar. Mir geht es da ähnlich. Leute sind schwierig.
#. fr: Oui, je ne vous le fais pas dire...
msgctxt "NpcYell:8667:0:13"
msgid "Yes, I think we've gathered that much..."
msgstr ""

#. ja: わ～い！<br>おひさまてんてん！
#. de: Aaah, hurra! Du liebe Sonne, was habe ich dich vermisst!
#. fr: Ah, qu'est-ce qu'il fait beau, aujourd'huuuui<nbsp>!
msgctxt "NpcYell:8668:0:13"
msgid "What a beautiful day!"
msgstr ""

#. ja: …ああ、いい天気だな
#. de: Hm, zumindest das Wetter ist heute gut.
#. fr: Vous avez raison.
msgctxt "NpcYell:8669:0:13"
msgid "Glad to see the threat of assassination has done little to dampen your mood."
msgstr ""

#. ja: 大丈夫ですか？<br>顔色が悪いようですが…
#. de: Seid Ihr verletzt? Euer Gesicht hat jegliche Farbe verloren.
#. fr: Ça va<nbsp>? Vous n'avez pas bonne mine...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8670:0:13"
msgid "Are you alright?<br>You've gone pale..."
msgstr ""

#. ja: そうか…<br>その顔色で察したよ…
#. de: Verstehe. Deine Augen sprechen Bände<nbsp>...
#. fr: Je lis une grande tristesse dans tes yeux...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8671:0:13"
msgid "Ah...<br>Your eyes tell the tale."
msgstr ""

#. ja: アリゼー、どうしたんだい？<br>顔色が悪いようだが…
#. de: Was ist, Alisaie? Du siehst furchtbar aus.
#. fr: Que se passe-t-il, petite sœur<nbsp>? Tu es toute pâle...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8672:0:13"
msgid "Alisaie?<br>You've gone pale..."
msgstr ""

#. ja: …問題ないわ<br>さあ、先に進みましょう…
#. de: Es ist ... nichts. Ich werde retten, wer zu retten ist!
#. fr: Ne t'en fais pas, ce n'est rien. Continuons...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8673:0:13"
msgid "...I'm fine.<br>We should keep moving."
msgstr ""

#. ja: グッ…また倒すしか…<br>倒すしかないのか！？
#. de: Gibt es denn keine Heilung außer den Tod?
#. fr: La mort est-elle la seule solution<nbsp>!?
msgctxt "NpcYell:8674:0:13"
msgid "Is death the only answer!?"
msgstr ""

#. ja: また救えなかった…<br>またッ！
#. de: Wir kommen zu spät. <i>Ich</i> komme zu spät.
#. fr: Eux non plus, on n'a pas pu les sauver...
msgctxt "NpcYell:8675:0:13"
msgid "We were too slow to save them!"
msgstr ""

#. ja: 悪夢のような光景だ…
#. de: Es ist wie in einem Albtraum!
#. fr: C'est un cauchemar...
msgctxt "NpcYell:8676:0:13"
msgid "A waking nightmare, indeed..."
msgstr ""

#. ja: ああなっては倒して<br>魂を解放することしか…！
#. de: Wir können nichts mehr für sie tun. Außer ihre Seelen zu befreien.
#. fr: On libère leurs âmes, c'est tout ce qu'on peut faire.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8677:0:13"
msgid "We free their souls.<br>That is all we can do..."
msgstr ""

#. ja: 肌がピリつく…<br>この魔力…いったい何が？
#. de: Ich spüre es in jeder Pore. Der Äther spielt verrückt.
#. fr: Ma peau picote... D'où vient cette énergie éthérée<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8678:0:13"
msgid "I feel my skin prickling.<br>What is this boiling aether...?"
msgstr ""

#. ja: この先に領主の館が<br>あるはずです…！
#. de: Das Herrenhaus ist nicht mehr weit.
#. fr: Le manoir n'est plus très loin<nbsp>!
msgctxt "NpcYell:8679:0:13"
msgid "The manor house is just up ahead!"
msgstr ""

#. ja: 嫌な気配だ…<br>みな、警戒を！
#. de: Wir haben ihn gleich. Seid wachsam!
#. fr: On y est presque... Restez sur vos gardes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8680:0:13"
msgid "We are close...<br>Be on your guard!"
msgstr ""

#. ja: 禍々しい魔力を感じる<br>なにが待ち受けているんだ…
#. de: Ich kann es schon spüren. Das Ungleichgewicht des Äthers ist ganz eindeutig.
#. fr: La source de l'énergie éthérée est proche...
msgctxt "NpcYell:8681:0:13"
msgid "As is the source of this suffocating aether..."
msgstr ""

#. ja: この魔力…<br>只者ではないぞ！
#. de: Er muss über unglaubliche Kräfte verfügen.
#. fr: Je ressens une immense puissance...<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8682:0:13"
msgid "The sheer power...<br>I can sense its strength from here!"
msgstr ""

#. ja: なんて威圧感…<br>並の罪喰いじゃない！？
#. de: Bei den Göttern! Das muss der Licht<shy>bringer sein!
#. fr: Rien à voir avec ce que nous avons combattu jusqu'ici...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8683:0:13"
msgid "Gods...<br>This must be the Warden!"
msgstr ""

#. ja: 間違いない…<br>あれは大罪喰いだ！
#. de: Es gibt keinen Zweifel. Das ist der Licht<shy>bringer.
#. fr: ... Nous sommes en présence d'un grand purgateur.
msgctxt "NpcYell:8684:0:13"
msgid "...We stand in the presence of a Lightwarden."
msgstr ""

#. ja: レイクランドを脅かす<br>罪喰いの主ッ！！
#. de: Die Geißel des Seenlands steht vor uns!
#. fr: C'est la créature qui tyrannise Grand-Lac<nbsp>!
msgctxt "NpcYell:8685:0:13"
msgid "Aye, this is the true scourge of Lakeland!"
msgstr ""

#. ja: ●集まって！
#. de: 0
#. fr: 0
msgctxt "NpcYell:8686:0:13"
msgid "0"
msgstr ""

#. ja: 見事な術だ…<br>これならば発見されまい
#. de: Ein guter Trick. So bleiben wir verborgen.
#. fr: Ici, on devrait être tranquilles.
msgctxt "NpcYell:8687:0:13"
msgid "Impressive."
msgstr ""

#. ja: あれは…紫葉団！？
#. de: Nachtschatten!
#. fr: Les Fanes pourpres<nbsp>?
msgctxt "NpcYell:8688:0:13"
msgid "Nightshade..."
msgstr ""

#. ja: 業を煮やして<br>反撃に出るつもりか！
#. de: Bereiten die etwa einen Überfall vor?
#. fr: Ils sont furieux... Ils veulent se venger<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8689:0:13"
msgid "Are they preparing<br>for an assault?"
msgstr ""

#. ja: 総員、戦闘配置！<br>無法者どもを迎撃するぞ！
#. de: Macht euch bereit. Wir schlagen zuerst zu!
#. fr: Tous en position de combat<nbsp>! On va à la rencontre de ces scélérats<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8690:0:13"
msgid "Everyone at the ready!<br>We strike first!"
msgstr ""

#. ja: 来たな！<br>クリスタリウムの犬め！
#. de: Oh, wie nett von euch, freiwillig zu uns zu kommen!
#. fr: Chiens de Cristariens<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8691:0:13"
msgid "How <i>noble</i> of you<br>to come to us!"
msgstr ""

#. ja: レイクランドから<br>叩き出してやる！
#. de: Dann können wir euch ja ein für alle Mal aus dem Seenland vertreiben.
#. fr: On va vous bouter hors de Grand-Lac<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8692:0:13"
msgid "We'll put you<br>out of your misery!"
msgstr ""

#. ja: 我らエルフの勝利だ！
#. de: Euer Gutleutetum hat keinen Wert!
#. fr: La victoire sera aux Elfes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8693:0:13"
msgid "Now you see<br>the futility of<br>the <i>good</i>."
msgstr ""

#. ja: 栄光をふたたび！
#. de: Alles, was zählt, ist die Sünde!
#. fr: C'est l'heure de bouter<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8694:0:13"
msgid "The only glory<br>is in sin!"
msgstr ""

#. ja: レイクランドを<br>奪還するぞ！
#. de: Das Seenland gehört den wahren Sündigen.
#. fr: On va reprendre Grand-Lac<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8695:0:13"
msgid "Only the wicked<br>will walk these lands!"
msgstr ""

#. ja: グッ…数が多すぎる…！
#. de: Es sind zeimlich viele!
#. fr: Arg... Ils sont trop nombreux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8696:0:13"
msgid "There are too<br>many of them!"
msgstr ""

#. ja: 湖畔地帯の治安が…！
#. de: Sollen wir ihnen das Seenland nicht einfach überlassen?
#. fr: Il faut protéger les zones lacustres<nbsp>!
msgctxt "NpcYell:8697:0:13"
msgid "Maybe they were right..."
msgstr ""

#. ja: ムッ…なんだ？<br>敵の増援だと！？
#. de: Da kommen noch mehr! Oh nein!
#. fr: Quoi<nbsp>? Des renforts<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8698:0:13"
msgid "More of them!?<br>Or...<i>no</i>..."
msgstr ""

#. ja: ワーグだ！<br>ワーグが来たぞ！
#. de: Warge!
#. fr: Des wargs<nbsp>! Ce sont des wargs<nbsp>!
msgctxt "NpcYell:8699:0:13"
msgid "Wargs!"
msgstr ""

#. ja: ガルルル！
#. de: \<knurr>
#. fr: Grrrr<nbsp>!!
msgctxt "NpcYell:8700:0:13"
msgid "\\<growl>"
msgstr ""

#. ja: ウガァァァ！
#. de: Graaah!
#. fr: Graouuuh<nbsp>!
msgctxt "NpcYell:8701:0:13"
msgid "Graaah!"
msgstr ""

#. ja: おおッ！<br>あの術式が成功したか！
#. de: Haha! Der Zauber wirkt!
#. fr: Oh<nbsp>! L'incantation a fonctionné<nbsp>!
msgctxt "NpcYell:8702:0:13"
msgid "Ha! The binding worked!"
msgstr ""

#. ja: 影の王に従いしワーグよ！<br>異敵を討て！
#. de: Beißt ihnen die Kehlen durch!
#. fr: Ô wargs fidèles au roi de l'Ombre<nbsp>!<br>Éliminez nos ennemis<nbsp>!
msgctxt "NpcYell:8703:0:13"
msgid "Tear their throats out!"
msgstr ""

#. ja: 我らエルフの勝利だ！
#. de: Das Seenland ist unser!
#. fr: La victoire sera aux Elfes<nbsp>!
msgctxt "NpcYell:8704:0:13"
msgid "Lakeland is ours!"
msgstr ""

#. ja: 栄光をふたたび！
#. de: Die Elfen sind die wahren Herrscher!
#. fr: Qu'on retrouve notre gloire passée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8705:0:13"
msgid "Only the elves<br>truly know this world<br>we have created."
msgstr ""

#. ja: レイクランドを<br>奪還するぞ！
#. de: Jetzt holen wir uns, was uns zusteht!
#. fr: On va reprendre Grand-Lac<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8706:0:13"
msgid "You were never<br>going to succeed."
msgstr ""

#. ja: グッ…数が多すぎる…！
#. de: Sie überrennen uns!
#. fr: Arg... Ils sont trop nombreux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8707:0:13"
msgid "We just don't<br>have the numbers..."
msgstr ""

#. ja: 湖畔地帯の治安が…！
#. de: Was wird denn nur aus dem Seenland werden?
#. fr: Il faut protéger les zones lacustres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8708:0:13"
msgid "What will become<br>of Lakeland now?"
msgstr ""

#. ja: もはや、ここまでか…
#. de: Bis hier und nicht weiter.
#. fr: C'est la fin...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8709:0:13"
msgid "So be it.<br>You win."
msgstr ""

#. ja: 我らの敗北だというのか…
#. de: Verloren? Wie kann das sein?
#. fr: On a perdu...<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8710:0:13"
msgid "You'll get your<br>deserts someday."
msgstr ""

#. ja: キュウゥゥゥ…
#. de: \<wimmer>
#. fr: Wouuuh...
msgctxt "NpcYell:8711:0:13"
msgid "\\<whimper>"
msgstr ""

#. ja: 敵が退き始めた…？<br>追撃したいが…
#. de: Verfolgen wir sie?
#. fr: L'ennemi bat en retraite<nbsp>? Poursuivons-le<nbsp>!
msgctxt "NpcYell:8712:0:13"
msgid "Should we give chase?"
msgstr ""

#. ja: まずは負傷者の救護と<br>立て直しが先だ…
#. de: Nein. Wir haben Verwundete zu pflegen.
#. fr: Non<nbsp>! Il faut aider les blessés et se regrouper<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8713:0:13"
msgid "No, the wounded<br>come first."
msgstr ""

#. ja: それにしても<br>ワーグを従えるとはな…
#. de: Ich hasse diese Warge.
#. fr: Dire qu'ils ont réussi à dominer ces wargs<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8714:0:13"
msgid "I can't believe<br>they had <i>wargs</i>..."
msgstr ""

#. ja: ミャルナ様…！<br>ご覧くださいッ！
#. de: Myalna, sieh nur!
#. fr: Myalna<nbsp>! Regardez ça<nbsp>!
msgctxt "NpcYell:8715:0:13"
msgid "Myalna, what are they?"
msgstr ""

#. ja: あれは…エコー？<br>だが、動きがおかしい…
#. de: Das sind Echos. Aber irgendwas stimmt nicht mit ihnen ...
#. fr: C'est un écho<nbsp>? Mais, il a l'air bizarre<nbsp>!
msgctxt "NpcYell:8716:0:13"
msgid "Echoes, I think. But there is something strange about them."
msgstr ""

#. ja: 狩人よ、弓を取れ！<br>様子を見に行くぞ！
#. de: Spannt die Bögen und folgt mir. Die Pflicht ruft!
#. fr: Chasseuses<nbsp>! Sortez vos arcs<nbsp>! On va voir ça de plus près<nbsp>!
msgctxt "NpcYell:8717:0:13"
msgid "Bows, with me! We have work to do!"
msgstr ""

#. ja: ハッ！
#. de: Jawohl, Myalna!
#. fr: Ha<nbsp>!
msgctxt "NpcYell:8718:0:13"
msgid "Understood!"
msgstr ""

#. ja: これは…<br>病に冒されています！
#. de: Sie scheinen von einer mysteriösen Krankheit befallen ...
#. fr: Ils se comportent bizarrement... On dirait qu'ils sont malades<nbsp>!
msgctxt "NpcYell:8719:0:13"
msgid "It seems that they are diseased."
msgstr ""

#. ja: 感染が広がる前に<br>対処するぞ！
#. de: Wir müssen sie erlegen, bevor sie die Krankheit verbreiten können!
#. fr: Il faut s'en occuper avant que la contamination ne se propage<nbsp>!
msgctxt "NpcYell:8720:0:13"
msgid "We must cull them before the sickness can spread."
msgstr ""

#. ja: どうにか感染拡大を<br>防げたようだな…
#. de: Das sollte seinen Zweck erfüllen.
#. fr: On dirait qu'on a réussi à enrayer la diffusion du virus...
msgctxt "NpcYell:8721:0:13"
msgid "That will suffice."
msgstr ""

#. ja: さあ、巡回を続けるぞ！
#. de: Vorwärts, Schwestern!
#. fr: Allez hop, on retourne à nos patrouilles<nbsp>!
msgctxt "NpcYell:8722:0:13"
msgid "Onward, sisters!"
msgstr ""

#. ja: かなりの数を<br>討ち漏らしてしまったか…
#. de: Einige dieser Kreaturen konnten entkommen ...
#. fr: On n'en a pas abattu assez...
msgctxt "NpcYell:8723:0:13"
msgid "We have allowed too many of them to escape..."
msgstr ""

#. ja: だが、巡回は続行せねば…<br>行くぞ！
#. de: Möglicherweise finden wir sie auf unserer Patrouille.
#. fr: Il faut quand même retourner à notre patrouille... En route<nbsp>!
msgctxt "NpcYell:8724:0:13"
msgid "Perhaps we will find some of them on our patrol."
msgstr ""

#. ja: 総員！<br>ヤクルスに騎乗せよ！
#. de: Ziehen wir weiter! Die Wacht ist noch nicht zu Ende!
#. fr: À vos griffons<nbsp>!
msgctxt "NpcYell:8725:0:13"
msgid "Bows! It is time to leave!"
msgstr ""

#. ja: ムッ…！？<br>クロウラーか…！
#. de: Dieser Gestank ... Kriecher!
#. fr: Qu'est-ce que c'est que ces chenilles<nbsp>!?
msgctxt "NpcYell:8726:0:13"
msgid "I recognize that stench."
msgstr ""

#. ja: もしや、あのクロウラーが<br>病の感染源では？
#. de: Das muss das Ungeziefer sein, dass die Krankheit eingeschleppt hat!
#. fr: Ce serait elles qui auraient contaminé les échos<nbsp>?
msgctxt "NpcYell:8727:0:13"
msgid "Those crawlers must be what is spreading the disease!"
msgstr ""

#. ja: 私も同意見だ<br>一気に排除するぞ！
#. de: Exakt mein Gedanke. Schwestern, ihr wisst, was zu tun ist!
#. fr: Ça ne fait aucun doute<nbsp>! Éliminez-moi tout ça<nbsp>!
msgctxt "NpcYell:8728:0:13"
msgid "My thoughts exactly. Sisters, you know what to do."
msgstr ""

#. ja: ふむ、病の感染源を<br>根絶できたようだな！
#. de: Das sollte die Krankheit erst einmal eindämmen.
#. fr: Ouf<nbsp>! On dirait qu'on a réussi<nbsp>!
msgctxt "NpcYell:8729:0:13"
msgid "That should put a stop to the disease."
msgstr ""

#. ja: 本当に良かったですね！
#. de: Hoffen wir es.
#. fr: Quel soulagement<nbsp>!
msgctxt "NpcYell:8730:0:13"
msgid "I certainly hope so!"
msgstr ""

#. ja: しかし、矢を<br>消耗し過ぎたようだ
#. de: Mein Köcher ist fast leer ...
#. fr: Par contre on a utilisé trop de flèches<nbsp>!
msgctxt "NpcYell:8731:0:13"
msgid "We are running dangerously low on arrows, though."
msgstr ""

#. ja: 矢の材料を<br>集めに向かうぞ！
#. de: Wir sollten uns Federn besorgen, bevor wir beim nächsten Kampf ins Leere greifen ...
#. fr: Allons vite chercher des ressources pour en fabriquer d'autres<nbsp>!
msgctxt "NpcYell:8732:0:13"
msgid "I suggest that we go and gather feathers for flights."
msgstr ""

#. ja: 少しは数を減らせたが…<br>根絶とまではいかんか…
#. de: Zu viele sind entkommen ...
#. fr: On a réussi à en abattre quelques-unes, mais j'ai bien peur que ça ne suffise pas pour éradiquer la maladie...
msgctxt "NpcYell:8733:0:13"
msgid "We let too many of them get away."
msgstr ""

#. ja: うっ…<br>近づかないで！
#. de: Halt Abstand, Bestie!
#. fr: Me touche pas<nbsp>!
msgctxt "NpcYell:8734:0:13"
msgid "Get back, you repulsive creature!"
msgstr ""

#. ja: このッ！
#. de: Noch einen Pfeil gefällig?
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:8735:0:13"
msgid "Here, have another one!"
msgstr ""

#. ja: うぅ…クロウラー…<br>苦手です…
#. de: Bah! Ich hasse Kriecher!
#. fr: Berk... Je déteste les chenilles...
msgctxt "NpcYell:8736:0:13"
msgid "Ugh! I hate crawlers!"
msgstr ""

#. ja: さて、タリチャックの<br>縄張りは…
#. de: Die Tarichuks sollten nicht weit sein ...
#. fr: Allons trouver les tarichuks<nbsp>!
msgctxt "NpcYell:8737:0:13"
msgid "The tarichuks should be nearby."
msgstr ""

#. ja: よし、見つけたぞ！
#. de: Seht, Schwestern! Dort drüben!
#. fr: Ils sont là<nbsp>!
msgctxt "NpcYell:8738:0:13"
msgid "There they are!"
msgstr ""

#. ja: あの羽根があれば<br>矢を作れるだろう
#. de: Mit diesen Federn werden wir vorzügliche Pfeile herstellen!
#. fr: Ces plumes seront parfaites pour fabriquer nos flèches<nbsp>!
msgctxt "NpcYell:8739:0:13"
msgid "Such fine plumage."
msgstr ""

#. ja: 羽根は不足しているが…<br>そろそろ狩りを切り上げよう
#. de: Diese Tarichuks sind zähe Biester!
#. fr: Nous n'avons pas assez de plumes... Tant pis, il est temps de rentrer...
msgctxt "NpcYell:8740:0:13"
msgid "These tarichuks are tougher than they look..."
msgstr ""

#. ja: さて、少しばかり<br>ここで休息するか…
#. de: Wir sollten hier für eine Weile rasten. Es war ein langer Tag.
#. fr: Bon, faisons une pause<nbsp>!
msgctxt "NpcYell:8741:0:13"
msgid "I had best stop there. No point dying for a bunch of feathers."
msgstr ""

#. ja: よし、羽根は十分集まった<br>協力に感謝しよう
#. de: Das sollte ausreichen. Danke für deine Hilfe.
#. fr: C'est bon, on a assez de plumes<nbsp>! Merci<nbsp>!
msgctxt "NpcYell:8742:0:13"
msgid "This should suffice. Your assistance is much appreciated."
msgstr ""

#. ja: うむ、十分だな<br>そろそろ引き返すとしよう
#. de: Wir haben genug. Zeit, uns zurückzuziehen.
#. fr: Hum, ça suffit<nbsp>! On va pouvoir rentrer<nbsp>!
msgctxt "NpcYell:8743:0:13"
msgid "That is enough for the time being."
msgstr ""

#. ja: まだ羽根を持っているなら<br>私の元へ！
#. de: Du hast noch mehr Federn gesammelt?
#. fr: Si tu as encore des plumes, je les récupère<nbsp>!
msgctxt "NpcYell:8744:0:13"
msgid "Have you any more feathers?"
msgstr ""

#. ja: 羽根を集めたら<br>私の元へ！
#. de: Ich nehme dir die Federn gerne ab<nbsp>...
#. fr: Ramène-moi les plumes une fois que tu les auras<nbsp>!
msgctxt "NpcYell:8745:0:13"
msgid "I will take those feathers off of your hands!"
msgstr ""

#. ja: 拾い集めるも良し！<br>狩るも良しだ！
#. de: Bring mir so viele Federn, wie du nur auftreiben kannst.
#. fr: Tu peux soit les ramasser, soit les récupérer directement sur les tarichuks en les chassant<nbsp>!
msgctxt "NpcYell:8746:0:13"
msgid "Bring me as many feathers as you can. It matters not how you get them."
msgstr ""

#. ja: よし、巡回を再開するぞ！
#. de: Wir setzen unsere Patrouille fort. Bleibt wachsam!
#. fr: Allez, on reprend les patrouilles<nbsp>!
msgctxt "NpcYell:8747:0:13"
msgid "Keep your eyes peeled for trouble."
msgstr ""

#. ja: 見てください！<br>ミャルナ様！
#. de: Myalna! Dort drüben!
#. fr: Myalna, regardez-moi ça<nbsp>!
msgctxt "NpcYell:8748:0:13"
msgid "Myalna, look!"
msgstr ""

#. ja: 古き護人が襲われている？<br>救援に向かうぞ！
#. de: Sie greifen den uralten Wächter an!
#. fr: Le gardien ancien se fait attaquer<nbsp>? Allons vite lui porter secours<nbsp>!
msgctxt "NpcYell:8749:0:13"
msgid "They are attacking the ancient guardian!"
msgstr ""

#. ja: 嗚呼…古き護人が…
#. de: Wie konnte das bloß passieren?
#. fr: Non<nbsp>!!!
msgctxt "NpcYell:8750:0:13"
msgid "How can this be!?"
msgstr ""

#. ja: なんということだ…
#. de: Ich hätte nicht gedacht, dass ein Wächter besiegt werden kann.
#. fr: Quelle horreur...
msgctxt "NpcYell:8751:0:13"
msgid "To think that the ancient guardian could be defeated..."
msgstr ""

#. ja: 残念だが仕方がない<br>里に帰還するとしよう…
#. de: Wir können hier nichts mehr tun. Kehren wir zurück.
#. fr: On n'a pas le choix, il faut retourner au village...
msgctxt "NpcYell:8752:0:13"
msgid "There is little more we can do here. Let us return."
msgstr ""

#. ja: 安全を確保できたようだな
#. de: Die Gefahr ist gebannt.
#. fr: On dirait qu'on a réussi à le sauver<nbsp>!
msgctxt "NpcYell:8753:0:13"
msgid "It seems the danger has passed."
msgstr ""

#. ja: やれやれ…<br>里に帰還するぞ！
#. de: Kommt, kehren wir ins Dorf zurück.
#. fr: Oh là là... Bon, on rentre au village<nbsp>!
msgctxt "NpcYell:8754:0:13"
msgid "Come. We must report this to the others."
msgstr ""

#. ja: ごめん…なさい…
#. de: Ich habe versagt ...
#. fr: Par...don...
msgctxt "NpcYell:8755:0:13"
msgid "I have failed my sisters..."
msgstr ""

#. ja: 弓を取れ！<br>ヤツを仕留めるぞ！
#. de: Spannt die Bögen! Haltet ihn auf!
#. fr: À vos flèches<nbsp>!
msgctxt "NpcYell:8756:0:13"
msgid "Arrows at the ready!"
msgstr ""

#. ja: ムッ…！？<br>この唸り声は……
#. de: Habt ihr das gehört? Klang wie das Gebrüll einer Bestie ...
#. fr: Hum<nbsp>? Qu'est-ce que c'est que ce grognement<nbsp>?
msgctxt "NpcYell:8757:0:13"
msgid "Did you hear that? It sounded like a roar..."
msgstr ""

#. ja: 総員、ヤクルスに騎乗せよ！<br>声の正体を確認するぞ！
#. de: Wenn es das ist was ich denke, müssen wir uns beeilen!
#. fr: Tout le monde à dos de griffons<nbsp>! Allons vérifier qui est l'auteur de ces grognements<nbsp>!
msgctxt "NpcYell:8758:0:13"
msgid "If that is what I think it is, we must hurry!"
msgstr ""

#. ja: 見つけました！<br>あれは…トヒルです！
#. de: Dort! Ist das etwa ... Tojil?!
#. fr: Ça vient d'ici<nbsp>! Mais... C'est un Tojil<nbsp>!?
msgctxt "NpcYell:8759:0:13"
msgid "There it is! Is that...Tojil!?"
msgstr ""

#. ja: 多くのヴィースを殺した<br>悪名高き古代獣ッ！
#. de: Viele unserer Schwestern sind durch diese Bestie gefallen!
#. fr: Il est tristement célèbre pour avoir tué un nombre incalculable de Viis<nbsp>!
msgctxt "NpcYell:8760:0:13"
msgid "Many a sister has died fighting that beast."
msgstr ""

#. ja: 逃したか…<br>追跡せねば…！
#. de: Lasst ihn nicht entkommen!
#. fr: Il s'est enfui... Partons à sa poursuite<nbsp>!
msgctxt "NpcYell:8761:0:13"
msgid "Do not let it escape!"
msgstr ""

#. ja: そっちには里が…<br>大変ですッ！
#. de: Die Bestie läuft direkt Richtung Dorf!
#. fr: Oh non<nbsp>! Il est parti en direction du village<nbsp>!
msgctxt "NpcYell:8762:0:13"
msgid "It is heading towards the village!"
msgstr ""

#. ja: これ以上、トヒルを<br>里に近づけるな！
#. de: Schnell! Wir haben keine Zeit zu verlieren!
#. fr: Il faut l'empêcher d'atteindre le village<nbsp>!
msgctxt "NpcYell:8763:0:13"
msgid "Quickly, there is no time to lose!"
msgstr ""

#. ja: ヤツもかなり<br>弱ってきているな…！
#. de: Es rennt um sein Leben! Das ist unsere Gelegenheit!
#. fr: On dirait qu'il est fatigué<nbsp>!
msgctxt "NpcYell:8764:0:13"
msgid "We have it running for its life. Now is our chance!"
msgstr ""

#. ja: このまま仕留めるぞ！
#. de: Zielt auf die Augen!
#. fr: Allez<nbsp>! Le coup de grâce<nbsp>!
msgctxt "NpcYell:8765:0:13"
msgid "Aim for the eyes!"
msgstr ""

#. ja: 総員、覚悟を決めろ！<br>死ぬ気でかかるぞ！
#. de: Schwestern, kämpft bis zum Ende!
#. fr: Soyez prêtes à donner votre vie s'il le faut<nbsp>!
msgctxt "NpcYell:8766:0:13"
msgid "Sisters, we shall fight to the last!"
msgstr ""

#. ja: 手負いの獣だ！<br>油断するなよ！
#. de: Sieht so aus, als ob wir ihn wütend gemacht haben!
#. fr: Il est blessé<nbsp>!
msgctxt "NpcYell:8767:0:13"
msgid "The beast is angered!"
msgstr ""

#. ja: なんとッ！？
#. de: Was?
#. fr: Incroyable<nbsp>!
msgctxt "NpcYell:8768:0:13"
msgid "What is it doing!?"
msgstr ""

#. ja: ひゃっ！？
#. de: Diese Hitze!
#. fr: Mais...<nbsp>!
msgctxt "NpcYell:8769:0:13"
msgid "I can feel the heat..."
msgstr ""

#. ja: トヒルの身体が…<br>発熱している？
#. de: Das ist der letzte Trumpf der Bestie ...
#. fr: Il est en train de prendre feu<nbsp>!?
msgctxt "NpcYell:8770:0:13"
msgid "This must be one of its defenses."
msgstr ""

#. ja: いよいよ本気…<br>ということか…！
#. de: Kommt ihm nicht zu nahe, Schwestern!
#. fr: Il a enfin décidé de se battre à fond...
msgctxt "NpcYell:8771:0:13"
msgid "Do not get too close, sisters!"
msgstr ""

#. ja: トヒル…<br>なんという化け物なのだ…
#. de: Wir haben keine Chance ...
#. fr: Quel horrible monstre...
msgctxt "NpcYell:8772:0:13"
msgid "We are outmatched..."
msgstr ""

#. ja: よし！<br>手応えがあった！
#. de: Das Schlachtenglück wendet sich zu unseren Gunsten!
#. fr: Oui<nbsp>!!
msgctxt "NpcYell:8773:0:13"
msgid "The tide has turned!"
msgstr ""

#. ja: このまま押し切るぞ！<br>総員、続け！
#. de: Hinterher!
#. fr: C'est le moment<nbsp>! On donne tout<nbsp>!
msgctxt "NpcYell:8774:0:13"
msgid "After it!"
msgstr ""

#. ja: さて…<br>トヒルを追い詰めたぞ…
#. de: Wir haben ihn in die Enge getrieben!
#. fr: Ça y est, on l'a rattrapé<nbsp>!
msgctxt "NpcYell:8775:0:13"
msgid "Now we have it cornered..."
msgstr ""

#. ja: いよいよ<br>決着を付ける時だ！
#. de: Deine Schreckensherrschaft geht nun zu Ende!
#. fr: C'est maintenant ou jamais<nbsp>!
msgctxt "NpcYell:8776:0:13"
msgid "Your reign of terror has lasted long enough."
msgstr ""

#. ja: 森に静寂を取り戻すため…<br>奴を仕留める…！
#. de: Jetzt wirst du sterben! Für den Frieden des Waldes! 
#. fr: Ramenons la paix dans la forêt<nbsp>! Abattons-le<nbsp>!
msgctxt "NpcYell:8777:0:13"
msgid "It ends here, fiend!"
msgstr ""

#. ja: 総員！<br>かかれッ！
#. de: Angriff!
#. fr: Allez<nbsp>!!
msgctxt "NpcYell:8778:0:13"
msgid "Charge!"
msgstr ""

#. ja: そんな…<br>あと一歩で…
#. de: Wir waren so nah dran ...
#. fr: Non<nbsp>! On y était presque...
msgctxt "NpcYell:8779:0:13"
msgid "So close..."
msgstr ""

#. ja: ついに…<br>トヒルを仕留めたぞ！
#. de: Die Bestie ist bezwungen!
#. fr: On a réussi<nbsp>!
msgctxt "NpcYell:8780:0:13"
msgid "Finally, the beast is dead."
msgstr ""

#. ja: ありがとう…<br>すべての者に感謝しよう
#. de: Danke. Ich danke euch, meinen Kameradinnen und allen, die uns auf unserer Wacht beigestanden haben.
#. fr: Merci... C'est grâce à vous...
msgctxt "NpcYell:8781:0:13"
msgid "May the fallen rest in peace."
msgstr ""

#. ja: ミャルナ様…
#. de: Werden wir nun endlich Frieden haben?
#. fr: Myalna...
msgctxt "NpcYell:8782:0:13"
msgid "Is it really over?"
msgstr ""

#. ja: だが、森の脅威は<br>トヒルだけではない
#. de: Tojil ist bezwungen, doch die Gefahren für die Sicherheit des Großen Waldes sind zahlreich.
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment, le Tojil n'était pas la seule créature menaçant cette forêt... 
msgctxt "NpcYell:8783:0:13"
msgid "For now. Though Tojil is slain, our work is never done."
msgstr ""

#. ja: これからも使命は続くのだ<br>さあ、里に帰ろう！
#. de: Diese Schlacht ist geschlagen, doch die Wacht geht weiter.
#. fr: Notre mission de protection de la forêt n'est pas terminée, mes sœurs<nbsp>! En attendant, retournons au village.
msgctxt "NpcYell:8784:0:13"
msgid "Let us return to the village."
msgstr ""

#. ja: 嗚呼、ミャルナ様が…！
#. de: Myalna! Dort drüben!
#. fr: Non<nbsp>!!! Myalna<nbsp>!
msgctxt "NpcYell:8785:0:13"
msgid "Myalna!"
msgstr ""

#. ja: ミャルナ様…！<br>無理は禁物です！
#. de: Myalna, sei vorsichtig!
#. fr: Myalna<nbsp>! Vous devez faire plus attention à vous<nbsp>!
msgctxt "NpcYell:8786:0:13"
msgid "Please, you must fall back!"
msgstr ""

#. ja: 逃がすか！
#. de: Für Fanow! Für den Großen Wald!
#. fr: Rattrapez-le<nbsp>!
msgctxt "NpcYell:8787:0:13"
msgid "I have you now!"
msgstr ""

#. ja: 感染拡大を防ぐのだ！
#. de: Wir dürfen nicht zulassen, dass die Krankheit sich weiter ausbreitet!
#. fr: Il faut éradiquer le virus<nbsp>!
msgctxt "NpcYell:8788:0:13"
msgid "We cannot allow the disease to spread!"
msgstr ""

#. ja: 仕留める！
#. de: Jägerinnen! Lasst die Sehnen surren!
#. fr: Finissons-le<nbsp>!
msgctxt "NpcYell:8789:0:13"
msgid "Time to end this."
msgstr ""

#. ja: 古き護人から<br>離れろッ！
#. de: Haltet das Gestrüpp vom Wächter fern!
#. fr: Éloignez-vous du gardien<nbsp>!
msgctxt "NpcYell:8790:0:13"
msgid "Get them away from the ancient guardian!"
msgstr ""

#. ja: 脅威は排除する！
#. de: Wer den Wald bedroht, ist des Todes!
#. fr: Il faut éliminer la menace<nbsp>!
msgctxt "NpcYell:8791:0:13"
msgid "Those that threaten the forest must perish!"
msgstr ""

#. ja: しぶといヤツめ！
#. de: Ich werd dich durchbohren!
#. fr: Il est tenace<nbsp>!
msgctxt "NpcYell:8792:0:13"
msgid "Why will you not die!?"
msgstr ""

#. ja: そこだッ！
#. de: Genug!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:8793:0:13"
msgid "Enough of this!"
msgstr ""

#. ja: 沈めッ！
#. de: Stirb!
#. fr: Tiens<nbsp>!
msgctxt "NpcYell:8794:0:13"
msgid "Fall!"
msgstr ""

#. ja: 負けるわけには…！
#. de: Wir siegen oder wir sterben!
#. fr: Tu ne m'auras pas<nbsp>!
msgctxt "NpcYell:8795:0:13"
msgid "We win or we die!"
msgstr ""

#. ja: 化け物めッ！
#. de: Stirb, Bestie!
#. fr: Sale monstre<nbsp>!
msgctxt "NpcYell:8796:0:13"
msgid "Die, fiend!"
msgstr ""

#. ja: ここで決着を付ける！
#. de: Das ist dein Ende!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:8797:0:13"
msgid "Your end is nigh!"
msgstr ""

#. ja: しまった…<br>侮ったか…！
#. de: Schwestern, meine Wacht endet ...
#. fr: Impossible...
msgctxt "NpcYell:8798:0:13"
msgid "My sisters... I am sorry..."
msgstr ""

#. ja: ハァ、ハァ…
#. de: Argh ...
#. fr: Ha... Ha...
msgctxt "NpcYell:8799:0:13"
msgid "Ungh..."
msgstr ""

#. ja: グッ…こんな傷で…<br>倒れて…たまるか…
#. de: Nur eine leichte Verwundung<nbsp>...
#. fr: Je suis blessée...
msgctxt "NpcYell:8800:0:13"
msgid "'Tis but a flesh wound..."
msgstr ""

#. ja: 大丈夫か！？<br>一度、後退するのだ！
#. de: Zieh dich zurück, Schwester!
#. fr: Ça va<nbsp>!? On se replie<nbsp>!
msgctxt "NpcYell:8801:0:13"
msgid "Fall back for now, sister."
msgstr ""

#. ja: 無理をするな！
#. de: Bleibt wachsam!
#. fr: Sois prudente<nbsp>!
msgctxt "NpcYell:8802:0:13"
msgid "Keep your guard up!"
msgstr ""

#. ja: 今更、後戻りなど<br>したくはないからな…
#. de: Ich hab keine Lust, den gleichen Weg zurückzulaufen.
#. fr: De toute façon, je n'avais aucune envie de rebrousser chemin.
msgctxt "NpcYell:8803:0:13"
msgid "There is no turning back."
msgstr ""

#. ja: こんなに蜂がいたら<br>花蜜が集められないよ！
#. de: Mit so vielen Bienen können wir unseren Nektar nicht sammeln!
#. fr: Je pourrai jamais récolter plus de nectar avec toutes ces abeilles<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8804:0:13"
msgid "Careful, mortal!<br>The bees are<br>everywhere..."
msgstr ""

#. ja: 蜂のせいで花蜜が<br>あまり集まらなかったね…
#. de: Wegen all der gemeinen Bienen sind wir nicht mal in die Nähe der Blüten gekommen. Schade.
#. fr: Bon c'est pas grande-chose, mais j'ai pas envie de rester plus longtemps...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8805:0:13"
msgid "It's not much,<br>but I'm <i>not</i><br>going over there..."
msgstr ""

#. ja: でも手伝ってくれて<br>ありがとう！
#. de: Aber trotzdem danke für deine Mühe!
#. fr: Merci quand même pour le coup de main<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8806:0:13"
msgid "In fact, let's leave.<br>Quickly. Yes."
msgstr ""

#. ja: たくさん集めてくれて<br>ありがとう！
#. de: Oh, wunderbar! Du hast ganz viel Nektar gesammelt!
#. fr: Youpi<nbsp>! J'ai réussi à faire le plein<nbsp>!
msgctxt "NpcYell:8807:0:13"
msgid "That's a relief!"
msgstr ""

#. ja: もう十分集まったから<br>そろそろ帰ろうかしら
#. de: Jetzt habe ich genug Nektar und kann wieder zurück nach Hause!
#. fr: J'ai largement ce qu'il me faut, alors je vais pas tarder à rentrer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8808:0:13"
msgid "This seems like<br>enough, surely?"
msgstr ""

#. ja: まだ花蜜を持っていたら<br>私に渡してね！
#. de: Falls du noch etwas vom leckeren Blütennektar hast, reich es mir! Ich wäre dir sehr dankbar!
#. fr: Mais si quelqu'un a encore du nectar, je prends<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8809:0:13"
msgid "I'll just start<br>backing away slowly..."
msgstr ""

#. ja: 蜂さえいなければ…
#. de: Wenn doch nur die doofen Bienen nicht wären!
#. fr: Si seulement il y  avait pas toutes ces abeilles...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8810:0:13"
msgid "Augh! It<br>looked at me!"
msgstr ""

#. ja: 花蜜が集まったら<br>私にちょうだいね！
#. de: Hast du noch mehr vom köstlichen Nektar? Dann reich ihn mir!
#. fr: Par ici le nectar<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8811:0:13"
msgid "Is that one...<br>getting closer?"
msgstr ""

#. ja: 邪魔するヤツは<br>みーんな草人だぁ！
#. de: Haha, Eindringlinge! Noch mehr Grasgrummel zum spielen!
#. fr: Les envahisseurs vont rejoindre notre armée d'enfeuillés<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8812:0:13"
msgid "The pixies haven't<br>spotted us."
msgstr ""

#. ja: よし…妖精どもには<br>気づかれていないな
#. de: Gut, die Pixies haben uns nicht entdeckt ...
#. fr: Zéro Pixie en vue...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8813:0:13"
msgid "The pixies haven't<br>spotted us."
msgstr ""

#. ja: 大丈夫そうよ
#. de: Die Luft ist rein ...
#. fr: C'est notre jour de chance...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8814:0:13"
msgid "You <i>hope</i>."
msgstr ""

#. ja: 何としても薬草を<br>手に入れるぞ！
#. de: Seht nur! Hier gibt es mehr als genug Heilkräuter!
#. fr: Récoltons les herbes et fichons le camp<nbsp>! Les malades nous attendent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8815:0:13"
msgid "Let's get the<br>herbs and go."
msgstr ""

#. ja: クスクス…
#. de: Hihihi ...
#. fr: Hi hi hi...
msgctxt "NpcYell:8816:0:13"
msgid "What have we here?"
msgstr ""

#. ja: おバカなヒトが<br>やって来たわ…！
#. de: Haha, seht nur, noch mehr Irrlichter in unserem Reich!
#. fr: Les andouilles, ils croient qu'on les a pas vus venir<nbsp>!
msgctxt "NpcYell:8817:0:13"
msgid "Foolish, foolish mortals!"
msgstr ""

#. ja: くっ！<br>見つかったか！
#. de: Oh nein! Wir wurden entdeckt!
#. fr: O-on est repérés<nbsp>!
msgctxt "NpcYell:8818:0:13"
msgid "Ack!"
msgstr ""

#. ja: ど、どうしよう…？
#. de: W-Was machen wir jetzt?!
#. fr: Qu'est-ce qu'on fait<nbsp>!?
msgctxt "NpcYell:8819:0:13"
msgid "Told you so."
msgstr ""

#. ja: 病気の友人のため<br>薬草が欲しいだけなんだ！
#. de: Wir wollen doch nur Medizin für unsere Freunde!
#. fr: S'il vous plaît<nbsp>! C'est pour soigner nos malades<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8820:0:13"
msgid "Please...<br>My friend─he'll die<br>without these!"
msgstr ""

#. ja: キヒヒヒヒ！<br>遊ぼう、遊ぼう！
#. de: Hohoho! Lasst uns spielen!
#. fr: Restez jouer<nbsp>! Restez jouer avec nous<nbsp>!
msgctxt "NpcYell:8821:0:13"
msgid "Oh, what a pity!"
msgstr ""

#. ja: 草人になって永遠に！<br>遊ぼう、遊ぼう！
#. de: Grasgrummel sollt ihr sein und mit uns spielen, fein!
#. fr: Vous ferez de beaux enfeuillés, et on sera aux petits soins avec vous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8822:0:13"
msgid "But you'll have<br>so much more<br>fun with us!"
msgstr ""

#. ja: こんなところに旅人！？<br>頼む、助けてくれ！
#. de: H-He, du da! Du musst uns helfen. Bitte!!
#. fr: Y a quelqu'un d'autre... Hé, oh<nbsp>! Aidez-nous, j'vous en prie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8823:0:13"
msgid "You there!<br>Help us, please!"
msgstr ""

#. ja: 草人になーれ！
#. de: Gießen, trimmen, in der Sonne bummeln, jetzt machen wir euch zu Grasgrummeln!
#. fr: Et hop<nbsp>!
msgctxt "NpcYell:8824:0:13"
msgid "And...there!"
msgstr ""

#. ja: うあっ！？
#. de: Uaaah!
#. fr: Ha<nbsp>!
msgctxt "NpcYell:8825:0:13"
msgid "Waugh!"
msgstr ""

#. ja: ぎゃっ！？
#. de: H-Hilfeeee!
#. fr: Que...<nbsp>! Hmgnff<nbsp>!
msgctxt "NpcYell:8826:0:13"
msgid "\\<sigh>..."
msgstr ""

#. ja: キャハハハ！
#. de: Hahaha!
#. fr: Ils sont trop mignons<nbsp>!!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8827:0:13"
msgid "Now don't you<br>look lovely?"
msgstr ""

#. ja: キヒヒヒヒ！
#. de: Hihihi!
#. fr: Hi hi hi<nbsp>!
msgctxt "NpcYell:8828:0:13"
msgid "Hee hee... Ahahaha!"
msgstr ""

#. ja: た、助けてくれ…
#. de: Mama ...
#. fr: Au... Au secours<nbsp>!
msgctxt "NpcYell:8829:0:13"
msgid "Somebody! Save meee!"
msgstr ""

#. ja: 誰か…！
#. de: R-Rette sich, wer kann!
#. fr: À l'aide<nbsp>!
msgctxt "NpcYell:8830:0:13"
msgid "A shrub? Really?"
msgstr ""

#. ja: ひゃあ！<br>逃げろー！
#. de: Ah! Schnell weg, schnell weg!
#. fr: Pfff<nbsp>! Même pas drôle<nbsp>!
msgctxt "NpcYell:8831:0:13"
msgid "Spoilsports..."
msgstr ""

#. ja: た、助かった…<br>本当に、ありがとう！
#. de: D-Du hast unser Leben gerettet! Danke, danke!!
#. fr: On est sauvés...<nbsp>? Merci<nbsp>! Merci à vous pour votre aide<nbsp>!
msgctxt "NpcYell:8832:0:13"
msgid "Oh, thank you!"
msgstr ""

#. ja: 薬草を見つけたら<br>すぐに帰るとするよ
#. de: Los, lasst uns die Heilkräuter schnappen und hier verschwinden!
#. fr: On ramasse les plantes qu'il nous fallait, et on décampe, compris<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8833:0:13"
msgid "Now we can get<br>what we came for."
msgstr ""

#. ja: さあ、急ぎましょう…！
#. de: Los, schnell. Wir müssen weg hier!
#. fr: Faudra pas me le dire deux fois<nbsp>!
msgctxt "NpcYell:8834:0:13"
msgid "Be quick about it."
msgstr ""

#. ja: キヒヒヒヒ！
#. de: Hihihi!
#. fr: Hi hi hi<nbsp>!
msgctxt "NpcYell:8835:0:13"
msgid "Tee hee!"
msgstr ""

#. ja: 遊ぼう、遊ぼう！
#. de: Kommt schon, wir wollen doch nur spielen!
#. fr: Je veux jouer<nbsp>! Je veux jouer<nbsp>!!!
msgctxt "NpcYell:8836:0:13"
msgid "Time to play..."
msgstr ""

#. ja: これじゃ帰れないわ…
#. de: Mit so wenig Nektar kann ich unmöglich zurück ins Dorf!
#. fr: Jamais je passerai sans me faire remarquer...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8837:0:13"
msgid "I can't go back<br>without the nectar..."
msgstr ""

#. ja: 花蜜もたっぷり集まったし<br>さあ、帰りましょう！
#. de: Endlich, mein Fläschchen ist voll mit Nektar! Zeit, zurück...
#. fr: Allez, il est temps de rentrer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8838:0:13"
msgid "At last, I can<br>go home and─"
msgstr ""

#. ja: あら？<br>この音は…
#. de: Hu? Dieses Geräusch ...
#. fr: Hmm<nbsp>? Qu'est-ce que c'est que ce bruit<nbsp>?
msgctxt "NpcYell:8839:0:13"
msgid "Hm?"
msgstr ""

#. ja: わわっ！？<br>あの怪鳥は…ルフ！？
#. de: Oh weh! Herrjemine! Eine Luphe!
#. fr: Rukh<nbsp>!? Mais qu'est-ce qu'il fiche ici<nbsp>!?
msgctxt "NpcYell:8840:0:13"
msgid "Eek, giant bird!"
msgstr ""

#. ja: 大変、どうしよう！
#. de: Oh, schreck! Ich muss hier weg!
#. fr: Oh, non non non non<nbsp>! Qu'est-ce que je vais faire<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8841:0:13"
msgid "Oh no, <i>Rukh</i><br>the giant bird!"
msgstr ""

#. ja: きゃー！<br>助けて…！
#. de: Aaah! Hilfe!
#. fr: Ahhh<nbsp>!
msgctxt "NpcYell:8842:0:13"
msgid "AAAAAAH!"
msgstr ""

#. ja: すごい！<br>ルフを倒すなんて！
#. de: Juhu! Die Luphe ist dahin!
#. fr: Bravo<nbsp>! Rukh y a laissé des plumes<nbsp>!
msgctxt "NpcYell:8843:0:13"
msgid "You did it!"
msgstr ""

#. ja: さあ、これで安心して<br>帰れるわ！
#. de: Was ein Graus! Ich kehr lieber schnell zurück nach Haus!
#. fr: Je vais pouvoir rentrer tran<shy>quil<shy>le<shy>ment chez moi, maintenant<nbsp>!
msgctxt "NpcYell:8844:0:13"
msgid "I owe you my life!"
msgstr ""

#. ja: 何度も助けてくれて<br>ありがとう！
#. de: Ich sage Dankeschön und auf Wieder<shy>sehen!
#. fr: Merci, encore<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8845:0:13"
msgid "I am <i>never</i> doing<br>nectar duty again..."
msgstr ""

#. ja: ありがとう！<br>でも、気をつけてね！
#. de: Vielen Dank für deine Hilfe! Pass dabei aber auf dich auf!
#. fr: Merci, et fais attention à toi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8846:0:13"
msgid "Get them<br>away from me!"
msgstr ""

#. ja: あっち行って！
#. de: Aaah! Verschwindet!
#. fr: Fichez le camp, sale bêtes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8847:0:13"
msgid "If I didn't need that<br>nectar, I swear..."
msgstr ""

#. ja: きゃあっ！？
#. de: Hilfeee!
#. fr: I-ils m'en veulent<nbsp>!
msgctxt "NpcYell:8848:0:13"
msgid "Eep!"
msgstr ""

#. ja: 逃げないとっ！
#. de: Nein, nein, nein. Ich muss hier weg! 
#. fr: Faut filer<nbsp>!
msgctxt "NpcYell:8849:0:13"
msgid "No no no no no..."
msgstr ""

#. ja: わぁ～！<br>すごい、すごい！
#. de: Ah! Seht nur! Die Anemonen werden vertrieben!
#. fr: Wouah<nbsp>!!! Génial<nbsp>!!!
msgctxt "NpcYell:8850:0:13"
msgid "Phew!"
msgstr ""

#. ja: キミって強いんだね！
#. de: Du bist wirklich stark!
#. fr: T'es super fort<if $gn4>e</if>, toi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8851:0:13"
msgid "Now I can get to the<br>Bookman's Shelves."
msgstr ""

#. ja: さあ、篤学者の荘園で<br>花蜜を探さなくっちゃ！
#. de: Lasst uns beim Lehnsgut des Gelehrten nach Nektar suchen!
#. fr: Allez, je te laisse. Du bon nectar m'attend à la villégiature<nbsp>!
msgctxt "NpcYell:8852:0:13"
msgid "Nectar, here I come!"
msgstr ""

#. ja: あっちに行って！
#. de: Verprügel sie ordentlich!
#. fr: Restez loin de moi, j'ai rien fait<nbsp>!
msgctxt "NpcYell:8853:0:13"
msgid "Eek, stay back!"
msgstr ""

#. ja: もう、やんなっちゃう！
#. de: Achtung!
#. fr: Attention<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8854:0:13"
msgid "Oh, this is <i>awful</i>."
msgstr ""

#. ja: 喜べ！<br>お前たちで遊んでやる！
#. de: Möge der Spaß beginnen!
#. fr: Allez, réjouissez-vous<nbsp>! Je vais jouer avec vous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8855:0:13"
msgid "Hello, pixies!<br>It's time to <i>play.</i>"
msgstr ""

#. ja: きゃあっ！？
#. de: Aaah! Hilfe!
#. fr: Quoi<nbsp>!? Oh, non...
msgctxt "NpcYell:8856:0:13"
msgid "Who─ Oh. Oh no."
msgstr ""

#. ja: にーちゃん！<br>今日は何して遊ぶの？
#. de: Brüderchen, was für einen Streich wollen wir heute spielen?
#. fr: À quoi on va jouer aujourd'hui<nbsp>!?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8857:0:13"
msgid "What <i>ever</i> shall<br>we do today?"
msgstr ""

#. ja: うーん…<br>そうだな…
#. de: Gute Frage, Brüderchen ...
#. fr: Voyons voir... Hmm...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8858:0:13"
msgid "Well, I cannot<br>but notice..."
msgstr ""

#. ja: にーちゃん、見て！<br>あそこにピクシーがいるよ！
#. de: Oh, Brüderchen, schau nur! Pixies!
#. fr: Regarde, frérot<nbsp>! Là-bas, des Pixies<nbsp>!
msgctxt "NpcYell:8859:0:13"
msgid "...those darling pixies, yes?"
msgstr ""

#. ja: ふむ、ピクシーか……
#. de: Und eine ganze Bande noch dazu! Hm ...
#. fr: Tiens, tiens... Mais tu as raison...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8860:0:13"
msgid "They do look<br>ever so peaceful..."
msgstr ""

#. ja: よし、今日はアイツに<br>イタズラしてやろう！
#. de: Die sind viel zu friedlich! Da müssen wir was unternehmen, hah!
#. fr: Vendu<nbsp>! Ces Pixies seront nos partenaires de jeu<nbsp>! Qu'elles le veuillent ou non<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8861:0:13"
msgid "...and that won't do,<br>will it now?"
msgstr ""

#. ja: まぁ、フーアが<br>私たちに何の用？
#. de: Fuath? Was wollt ihr von uns?
#. fr: Qu'est-ce qu'ils nous veulent ces affreux<nbsp>?
msgctxt "NpcYell:8862:0:13"
msgid "This can't be good."
msgstr ""

#. ja: ウシシシ！<br>あー、おもしろかった！
#. de: Muahahah! Das hat Spaß gemacht!
#. fr: Hi hi hiii<nbsp>! Comme c'était amusant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8863:0:13"
msgid "Hmm, I believe<br>it is time we<br>took our leave."
msgstr ""

#. ja: でも、もう飽きちゃった…<br>ほかの場所に行こうよ！
#. de: Zeit, weiterzuziehen, Brüderchen!
#. fr: J'commençais à m'ennuyer, quand même... Viens, Daen, on va autre part<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8864:0:13"
msgid "We would thank<br>you for the fun..."
msgstr ""

#. ja: そうだな…<br>それじゃ、アバよ～！
#. de: Du hast recht, Brüderchen! Tschüüüs!
#. fr: Bonne idée<nbsp>! À plus, les minus<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8865:0:13"
msgid "...if only you<br>weren't quite<br>so dull!"
msgstr ""

#. ja: な、何なのよ…もう！
#. de: Was für ungehobelte Kerle die beiden doch sind!
#. fr: Oh hé<nbsp>! C'est qui que tu traites de minus<nbsp>!?
msgctxt "NpcYell:8866:0:13"
msgid "Why, I never!"
msgstr ""

#. ja: 追いかけて<br>黙らせてやるんだから！
#. de: Ich folge ihnen besser. Ich hab zwar nichts gegen Streiche, aber die beiden gehen zu weit!
#. fr: Ils s'en tireront pas comme ça<nbsp>! On les suit<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8867:0:13"
msgid "Come on!<br>We give chase!"
msgstr ""

#. ja: くっそー！<br>お前らよくも邪魔しやがって！
#. de: Verd ... Ihr stört unsere Streiche!
#. fr: C'est quoi votre problème<nbsp>!? On voulait juste s'amuser<nbsp>!
msgctxt "NpcYell:8868:0:13"
msgid "Such ill-humored folk, here!"
msgstr ""

#. ja: にーちゃん！<br>もう、あっちにいこう！
#. de: Brüderchen, komm, wir gehen woanders hin!
#. fr: Viens, frérot. C'est nul ici, on va voir autre part<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8869:0:13"
msgid "I daresay we<br>shall find better<br>sport elsewhere."
msgstr ""

#. ja: お前ら…顔を覚えたからな！<br>次は容赦しないぞ！
#. de: Eure Gesichter merk ich mir! Euch werden wir's noch zeigen, hah!
#. fr: Grrr, d'accord... Vous autres, vous perdez rien pour attendre<nbsp>!
msgctxt "NpcYell:8870:0:13"
msgid "Right you are, Brother!"
msgstr ""

#. ja: あのフーアたち、ほかの場所で<br>悪さをするつもりね？
#. de: Sieht so aus, als ob diese beiden Lausbuben noch weitere Gemeinheiten im Sinn haben!
#. fr: C'est moi, ou ils sont partis jouer un mauvais tour à quelqu'un d'autre<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8871:0:13"
msgid "They're doubtless off<br>to trouble some<br>other poor soul."
msgstr ""

#. ja: 私、ちょっと見てくる…！
#. de: Besser, wenn ich ein Auge auf sie werfe, bevor jemand zu Schaden kommt!
#. fr: Je vais garder ces canailles à l'œil<nbsp>!
msgctxt "NpcYell:8872:0:13"
msgid "I'll keep an eye on them."
msgstr ""

#. ja: ウル＝アン！<br>やめておきなよ！
#. de: Ul An, gib den Strolchen Saures!
#. fr: Non, Ul An<nbsp>! Reste avec nous<nbsp>!
msgctxt "NpcYell:8873:0:13"
msgid "Ul An, wait!"
msgstr ""

#. ja: 大変！<br>あのアマロを助けなきゃ！
#. de: Oh nein, der Amaro ist in großer Gefahr!
#. fr: Je le savais<nbsp>! Ils s'en prennent à un amaro<nbsp>!
msgctxt "NpcYell:8874:0:13"
msgid "I knew it!"
msgstr ""

#. ja: 見ろ、アマロがいるぞ！
#. de: Oh, schau mal. Brüderchen. Ein ahnungsloser Amaro!
#. fr: Mate-moi ça<nbsp>! Un amaro<nbsp>!
msgctxt "NpcYell:8875:0:13"
msgid "My, my, look at that..."
msgstr ""

#. ja: ねーねー<br>にーちゃん！
#. de: Sag mal, Brüderchen.
#. fr: Dis<nbsp>! Dis<nbsp>! Dis<nbsp>!
msgctxt "NpcYell:8876:0:13"
msgid "If it isn't an amaro!"
msgstr ""

#. ja: アマロとグライダーって<br>どっちが強いのかな？
#. de: Wer ist eigentlich stärker? Ein Amaro oder ein Gleiter?
#. fr: Tu penses que c'est qui le plus fort<nbsp>? L'amaro ou le planeur<nbsp>?
msgctxt "NpcYell:8877:0:13"
msgid "Remind me, Brother..."
msgstr ""

#. ja: うーん、そうだな…
#. de: Hm, gute Frage, Brüderchen!
#. fr: Bonne question, ça... C'est qu'ils se ressemblent...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8878:0:13"
msgid "...how amaro fare<br>against gliders?"
msgstr ""

#. ja: よし、わからないなら<br>調べてみようぜ！
#. de: Das sollten wir unbedingt herausfinden! Hehe ...
#. fr: On devrait tenter l'expérience<nbsp>! Comme ça on sera fixés<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8879:0:13"
msgid "We shall have<br>to find out!"
msgstr ""

#. ja: やった！<br>でも、どうやって…？
#. de: Juhu! Aber wie stellen wir das an?
#. fr: Ouaiiis<nbsp>! Ah, mais... Comment on va faire, au juste<nbsp>?
msgctxt "NpcYell:8880:0:13"
msgid "Indeed we shall!"
msgstr ""

#. ja: 幻惑の術で…<br>ちょいちょい、ちょちょい！
#. de: Ganz einfach, Brüderchen: Illusionsmagie! Zipp, zapp, zong!
#. fr: Fastoche<nbsp>! Un p'tit charme d'illusion par-ci, un p'tit charme d'illusion par-là, et le tour est joué<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8881:0:13"
msgid "A wee bit of<br>this, and...yes!"
msgstr ""

#. ja: うわぁ…<br>なんで怒ってるの～？
#. de: Wer tut mir das an? Womit habe ich das verdient?
#. fr: Planeur, mais pourquoi es-tu si en colère contre moi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8882:0:13"
msgid "Oh dear. Are<br>you quite alright?"
msgstr ""

#. ja: いたたたた…
#. de: Argh ... Das war wirklich schmerzhaft!
#. fr: Ouille ouille ouille, tu me fais mal<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8883:0:13"
msgid "I say! That's<br>rather painful, sir!"
msgstr ""

#. ja: 嗚呼、アマロさんが！
#. de: Oh nein! Der arme Amaro!
#. fr: Non<nbsp>! L'amaro<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8884:0:13"
msgid "That amaro...<br>definitely needs help."
msgstr ""

#. ja: ウシシシ、アマロよりも<br>グライダーが強かったな！
#. de: Hihihi. Ich glaube, der Gleiter frisst den Amaro mit Haut und Federn ...
#. fr: Nous avons notre réponse<nbsp>! Le planeur est le plus fort<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8885:0:13"
msgid "I suppose we<br>have our answer."
msgstr ""

#. ja: そーだね、にーちゃん！
#. de: Da hast du recht, Brüderchen. Hehe!
#. fr: Carrément, ouais<nbsp>! J'ai même pas eu le temps d'apprécier le combat<nbsp>!
msgctxt "NpcYell:8886:0:13"
msgid "Too quickly, alas..."
msgstr ""

#. ja: 次は、何して遊ぶかなー！
#. de: Sag, was machen wir als nächstes?
#. fr: On va devoir remédier à ça<nbsp>! Cherchons notre prochain souffre-douleur<nbsp>!
msgctxt "NpcYell:8887:0:13"
msgid "So on to the next!"
msgstr ""

#. ja: もぉ、あの兄弟！<br>絶対に止めてやるんだから！
#. de: Diese Zwillinge sind eine Gefahr für die Bewohner von Feenland! Wir müssen sie stoppen!
#. fr: Grrr<nbsp>!!! Je vais en prendre un pour taper sur l'autre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8888:0:13"
msgid "It wasn't even a<br>funny prank! Unacceptable!"
msgstr ""

#. ja: お前らァ！<br>また邪魔しやがったな！
#. de: Ihr nervt! Hört auf, euch einzumischen!
#. fr: Vous venez encore jouer les trouble-fêtes<nbsp>!?
msgctxt "NpcYell:8889:0:13"
msgid "You again?"
msgstr ""

#. ja: にーちゃん！<br>もう、あっちにいこう！
#. de: Brüderchen! Komm, wir gehen woanders hin zum spielen!
#. fr: Laisse tomber, frérot. Viens, on s'en va<nbsp>!
msgctxt "NpcYell:8890:0:13"
msgid "We are not amused..."
msgstr ""

#. ja: クソッ…<br>しらけちまったな…
#. de: So ein Mist. Diese Spielverderber machen alles kaputt!
#. fr: Pfff... J'vous conseille de faire gaffe<nbsp>!
msgctxt "NpcYell:8891:0:13"
msgid "...or are we?"
msgstr ""

#. ja: 次も邪魔したら<br>今度こそ許さないからな！
#. de: Wenn ihr euch nochmal einmischt, werdet ihr was erleben! Pah!
#. fr: La prochaine fois que vous nous gênez, vous nous le paierez<nbsp>!
msgctxt "NpcYell:8892:0:13"
msgid "Perhaps you'll never know..."
msgstr ""

#. ja: ありがと～<br>助かったよぉ～
#. de: Habt Dank! Ihr habt mich vor großem Unheil bewahrt!
#. fr: Merci, beaucoup de m'avoir aidé.
msgctxt "NpcYell:8893:0:13"
msgid "Thank you kindly."
msgstr ""

#. ja: 無事でよかったわ！
#. de: Ich bin einfach nur froh, dass nichts Schlimmeres passiert ist, Freund!
#. fr: Tu vas bien<nbsp>? C'est déjà ça.
msgctxt "NpcYell:8894:0:13"
msgid "Are you alright?"
msgstr ""

#. ja: でも、あの兄弟…<br>また悪さをしそうね…
#. de: Aber diese beiden Zwillinge ... Ich habe das Gefühl, dass sie immer rücksichtsloser werden!
#. fr: Mais je parie que les frères Daen sont partis embêter quelqu'un d'autre...
msgctxt "NpcYell:8895:0:13"
msgid "Honestly, those Daens!"
msgstr ""

#. ja: 追いかけなくっちゃ！
#. de: Wir müssen ihnen folgen, bevor es ein Unglück gibt!
#. fr: Faut pas les lâcher<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8896:0:13"
msgid "They're not amused?<br><i>I'm</i> not amused..."
msgstr ""

#. ja: 見つけた！
#. de: Da sind sie!
#. fr: Les voilà<nbsp>!
msgctxt "NpcYell:8897:0:13"
msgid "There!"
msgstr ""

#. ja: ピクシーとアマロで<br>遊んだから…
#. de: Den kindischen Pixies und den arroganten Amaros haben wir schon den Tag verdorben. Bleiben noch die trotteligen Nu Mou!
#. fr: Oh oh<nbsp>! Parfait... Après Pixie et amaro...
msgctxt "NpcYell:8898:0:13"
msgid "Our usual games grow tiresome..."
msgstr ""

#. ja: 次はン・モゥだ！
#. de: Ja, Brüderchen! Suchen wir uns ein paar Nu Mou!
#. fr: Un Nu Mou<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8899:0:13"
msgid "Perhaps this fellow<br>can be of assistance."
msgstr ""

#. ja: わわ！<br>フーアのダエン兄弟！？
#. de: Au weia! Die furchtbar-fürchterlichen Daen-Brüder!
#. fr: L-l-les Da-Da...<nbsp>! Les Da-Da-Da...<nbsp>! Les Daen<nbsp>!
msgctxt "NpcYell:8900:0:13"
msgid "You... You're the Daens..."
msgstr ""

#. ja: 見て、にーちゃん！<br>あいつ荷物持ってる！
#. de: Guck mal Wyd! Der hat so viel Gepäck!
#. fr: Frérot<nbsp>! Jette un œil à toutes les caisses qu'il trimballe<nbsp>!
msgctxt "NpcYell:8901:0:13"
msgid "My, my..."
msgstr ""

#. ja: ウシシシシ！<br>荷物を壊してやれ！
#. de: Hahah! Das machen wir ihm jetzt schön kaputt!
#. fr: Hi hi hiii<nbsp>! On va en faire du petit bois<nbsp>!
msgctxt "NpcYell:8902:0:13"
msgid "...what nice boxes you have!"
msgstr ""

#. ja: ひー！<br>カンベンしてくれぇ～！
#. de: Bitte, nicht! Lasst unsere Kisten in Ruhe!
#. fr: Non<nbsp>! Non<nbsp>! Non<nbsp>! Pas mes caisses d'herbes<nbsp>!
msgctxt "NpcYell:8903:0:13"
msgid "Not the boxes!"
msgstr ""

#. ja: せっかく集めた薬草が<br>めちゃくちゃだ～
#. de: Nicht doch! Unsere krautigen Kräuter!
#. fr: Nooon<nbsp>! Ma récolte<nbsp>! Bouhouhouuuu<nbsp>!
msgctxt "NpcYell:8904:0:13"
msgid "Nooo! My herbs!"
msgstr ""

#. ja: 楽し～い！<br>さいこ～う！
#. de: Das hat Spaß gemacht, alles in Stücke zu hauen! Hahaha!
#. fr: Ouah ahhh<nbsp>! Quel carnage<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8905:0:13"
msgid "Oh, dear, would<br>you look at that..."
msgstr ""

#. ja: ウシシシシ！<br>また集めてくるんだな！
#. de: Jetzt müssen sie von vorne anfangen. Hohoho!
#. fr: Hi hi hiii<nbsp>! Le meilleur, c'est qu'il va devoir en récolter d'autres<nbsp>!
msgctxt "NpcYell:8906:0:13"
msgid "Such a mess!"
msgstr ""

#. ja: そしたら、もう一度<br>ツブしてやるからさ～！
#. de: Und dann machen wir wieder alles kaputt! Hihihi!
#. fr: Autrement dit, on pourra recommencer<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8907:0:13"
msgid "It will take <i>ages</i><br>to collect more..."
msgstr ""

#. ja: よし、次行ってみよう！
#. de: Hach, das war lustig. Komm, wir ziehen weiter, Brüderchen!
#. fr: Allons voir ailleurs, en attendant<nbsp>!
msgctxt "NpcYell:8908:0:13"
msgid "What a shame!"
msgstr ""

#. ja: あっ！<br>早く追いかけなくちゃ！
#. de: Schnell, hinterher!
#. fr: Vous vous en tirerez pas comme ça<nbsp>!
msgctxt "NpcYell:8909:0:13"
msgid "Oooh... Enough is enough!"
msgstr ""

#. ja: ありがとう～<br>助かったよぉ～！
#. de: Vielen Dank für eure Hilfe! Wir stehen in eurer schuldigsten Schuld!
#. fr: Ohhh<nbsp>! Merci<nbsp>! Mes herbes sont saines et sauves<nbsp>!
msgctxt "NpcYell:8910:0:13"
msgid "Thank goodness!"
msgstr ""

#. ja: また、お前らか…！<br>邪魔しやがって！
#. de: Schon wieder ihr! Könnt ihr uns nicht einfach in Ruhe lassen?!
#. fr: Encore toi<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8911:0:13"
msgid "Our persistent pixie.<br>What a lovely surprise!"
msgstr ""

#. ja: さあ、悪ふざけを<br>謝ってもらうわよ！
#. de: Dann hört auf mit euren gemeingefährlichen Streichen! Die sind gar nicht lustig!
#. fr: Ouaip<nbsp>! Alors arrêtez vos bêtises avant que je me fâche pour de vrai<nbsp>!
msgctxt "NpcYell:8912:0:13"
msgid "You stop this nonsense at once!"
msgstr ""

#. ja: 誰が謝るもんか！<br>バ～カ、バ～カ！
#. de: Aufhören? Niemals! Schon gar nicht für solche Dummköpfe! Hah!
#. fr: Peuh<nbsp>! Tu t'es prise pour qui, la mouche<nbsp>!?
msgctxt "NpcYell:8913:0:13"
msgid "Hmm. We might consider it..."
msgstr ""

#. ja: いこーぜ！
#. de: Los, Brüderchen Suchen wir uns ein neues Opfer!
#. fr: C'est vrai qu'elle en a le collant<nbsp>! Fichons le camp<nbsp>!
msgctxt "NpcYell:8914:0:13"
msgid "...if you can catch us!"
msgstr ""

#. ja: あっ！<br>また逃げた…！
#. de: Sie laufen schon wieder weg!
#. fr: L-la mouche<nbsp>!? Revenez par-là que je vous étripe<nbsp>!
msgctxt "NpcYell:8915:0:13"
msgid "Get back here!"
msgstr ""

#. ja: ウシシシシ！<br>やっちまえー！
#. de: Muahaha!
#. fr: Hi hi hiii<nbsp>! Vas-y, vieille branche<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8916:0:13"
msgid "Oho, they seem<br>to be keeping up."
msgstr ""

#. ja: あのピクシーと<br>ヒトの奴、しつこいな…
#. de: Diese Pixie und ihr Gefolge gehen mir langsam auf den Geist!
#. fr: On sera jamais tranquille...
msgctxt "NpcYell:8917:0:13"
msgid "This could be quite fun..."
msgstr ""

#. ja: どうにかして<br>追い払えないかな…
#. de: Irgendwie müssen wir sie abschütteln ...
#. fr: Il serait peut-être temps de leur donner une leçon. T'en dis quoi<nbsp>?
msgctxt "NpcYell:8918:0:13"
msgid "Shall we give them a chance?"
msgstr ""

#. ja: 逃がさないわよ！
#. de: Ich lass euch nicht aus den Augen, ihr Fieslinge!
#. fr: Cette fois, je vous tiens<nbsp>!
msgctxt "NpcYell:8919:0:13"
msgid "Stop right there!"
msgstr ""

#. ja: にーちゃん！<br>またこいつら追ってきたよ！
#. de: Brüderchen! Sie folgen uns immer noch!
#. fr: Frérot<nbsp>! Revoilà la Pixie<nbsp>!
msgctxt "NpcYell:8920:0:13"
msgid "Perhaps a test, first?"
msgstr ""

#. ja: こうなったら…<br>幻惑の術で…！
#. de: Dann müssen wir ihnen wohl ein ganz fieses Trugbild zaubern, ha!
#. fr: Sortons le grand jeu, alors<nbsp>!
msgctxt "NpcYell:8921:0:13"
msgid "Yes, a test!"
msgstr ""

#. ja: 木の魔物なんかに<br>負けないんだから！
#. de: Sie haben die Bäume verzaubert!
#. fr: Votre arbuste me fait pas peur, d'abord<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8922:0:13"
msgid "A magicked tree?<br>What do you take me for?"
msgstr ""

#. ja: きゃあっ！？
#. de: Ah, Hilfe. Ich seh nichts mehr! All die Äste peitschen mich ...
#. fr: Aïe<nbsp>! Ça fait mal<nbsp>!
msgctxt "NpcYell:8923:0:13"
msgid "Ack!"
msgstr ""

#. ja: ウシシシシ！<br>ざまを見ろ！
#. de: Haha! Schau, Brüderchen, jetzt werden sie windelweich geprügelt!
#. fr: Hi hi hiii<nbsp>! Bien fait<nbsp>! Ça t'apprendra<nbsp>!
msgctxt "NpcYell:8924:0:13"
msgid "If we were to be honest..."
msgstr ""

#. ja: これで邪魔者も消えて<br>遊び放題だ～！
#. de: Damit sind wir die Nervensägen los und können endlich ungestört spielen!
#. fr: Et maintenant... plus personne pour nous embêter<nbsp>!
msgctxt "NpcYell:8925:0:13"
msgid "...that was a disappointment."
msgstr ""

#. ja: さあ、次の遊び場に<br>行くぞ～！
#. de: Los, Brüderchen, suchen wir uns jemand anderes zum Streiche spielen!
#. fr: Tout à fait<nbsp>! Viens, on va se trouver une cible sympa<nbsp>!
msgctxt "NpcYell:8926:0:13"
msgid "But there is time for sport yet!"
msgstr ""

#. ja: くっそー<br>こいつら、やるね…！
#. de: Verflucht! Die sind echt hartnäckig!
#. fr: Rohhh<nbsp>! Mais y en a marre<nbsp>!
msgctxt "NpcYell:8927:0:13"
msgid "That wasn't half bad."
msgstr ""

#. ja: ああ、久しぶりに<br>骨のある連中だ…
#. de: Wir müssen uns was einfallen lassen, Brüderchen!
#. fr: Ouaip... Ça faisait un bail qu'on nous avait pas autant tenu tête...
msgctxt "NpcYell:8928:0:13"
msgid "You are an entertaining lot indeed."
msgstr ""

#. ja: どう？<br>謝る気になった？
#. de: Und, ist euch die Lust am Schabernack vergangen?!
#. fr: Ha<nbsp>! Ça y est<nbsp>!? Vous avez votre compte<nbsp>!?
msgctxt "NpcYell:8929:0:13"
msgid "And now we'll have words!"
msgstr ""

#. ja: まだまだ…と言いたいが<br>今日はここまでだな…
#. de: Wenn sie nicht locker lassen, müssen wir sie wohl vernichten!
#. fr: Dans tes rêves<nbsp>! Bon, par contre... on va en rester là pour aujourd'hui...
msgctxt "NpcYell:8930:0:13"
msgid "Oh, no. Not yet, I think!"
msgstr ""

#. ja: いつか必ずお前たちに<br>やり返してやるからな！
#. de: Das zahlen wir euch noch heim!
#. fr: Mais dis-toi bien que c'est que partie remise<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8931:0:13"
msgid "But perhaps if you<br>follow us south..."
msgstr ""

#. ja: 覚えとけ！
#. de: Genau! Merkt euch das!
#. fr: Ouais<nbsp>! Partie remise<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8932:0:13"
msgid "...we'll exchange <i>something</i>."
msgstr ""

#. ja: あ、ちょっと…！
#. de: Das werden wir ja sehen!
#. fr: Ils en ont pas eu assez<nbsp>!?
msgctxt "NpcYell:8933:0:13"
msgid "Hmph. I suppose I will."
msgstr ""

#. ja: まぁ、これだけやれば<br>しばらく悪さは控えるでしょ
#. de: Wenn dir die Lust noch nicht vergangen ist, dann begleite mich!
#. fr: (soupire)... Enfin, j'espère qu'ils vont se tenir à carreau un moment.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8934:0:13"
msgid "But I do hope<br>they'll do better<br>than a <i>tree</i>."
msgstr ""

#. ja: ウシシシシ！<br>勝負だぁ～！
#. de: Hahaha! Da sind die Trottel! Jetzt bekommt ihr euer Fett weg!
#. fr: Hi hi hiii<nbsp>! Que les meilleurs gagnent<nbsp>!
msgctxt "NpcYell:8935:0:13"
msgid "Welcome!"
msgstr ""

#. ja: 見つけたぞ！<br>生意気なあいつらだッ！
#. de: Wenn wir fertig mit euch sind, werdet ihr uns nicht mehr im Weg stehen!
#. fr: Salut, la casse-pied<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8936:0:13"
msgid "We are <i>so</i> pleased<br>to have you here..."
msgstr ""

#. ja: ふぇっ？<br>ダエン兄弟！？
#. de: Ha, träumt ruhig weiter! Mit euren Streichen werden wir fertig! Und dann geht es euch an den Kragen!
#. fr: Les frères Daen<nbsp>!?
msgctxt "NpcYell:8937:0:13"
msgid "Who wouldn't be?"
msgstr ""

#. ja: この前は<br>よくもやってくれたな！
#. de: Jetzt haben wir sie da, wo wir wollen, Brüderchen!
#. fr: On est venu te rendre la monnaie de ta pièce<nbsp>!
msgctxt "NpcYell:8938:0:13"
msgid "Oh, you're a funny one."
msgstr ""

#. ja: やってくれたな！
#. de: Ganz genau! Die werden sich wundern! Hihihi!
#. fr: Et... Et prendre notre revanche<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8939:0:13"
msgid "Much more entertaining<br>than we expected."
msgstr ""

#. ja: 何をするつもり…？
#. de: Was haben sie vor?
#. fr: Ça veut dire la même chose...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8940:0:13"
msgid "If only I could say<br>the same for you."
msgstr ""

#. ja: いくぞ！<br>幻惑巨大化の術！
#. de: Los geht's! Groß und größer werden wir!
#. fr: Chut<nbsp>! Tu vas voir ce que tu vas voir<nbsp>!
msgctxt "NpcYell:8941:0:13"
msgid "Now, wait just a moment..."
msgstr ""

#. ja: 巨大化の術！
#. de: Jetzt fressen wir euch mit Haut und Haaren! Muahaha!
#. fr: Place à la grande illusion<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8942:0:13"
msgid "You haven't seen<br>the half of us yet!"
msgstr ""

#. ja: お、大きくなったって<br>怖くないんだから！
#. de: N-Nur weil ihr Angeber euch aufplustert, habe ich noch lange keine Angst! Hah!
#. fr: Tu parles<nbsp>! Vous êtes à peine plus grands qu'avant<nbsp>!
msgctxt "NpcYell:8943:0:13"
msgid "Ha! Fuath tricks don't scare me!"
msgstr ""

#. ja: グアッ！？
#. de: Urks!
#. fr: P-pouce<nbsp>! Pouce<nbsp>!
msgctxt "NpcYell:8944:0:13"
msgid "Marvelous!"
msgstr ""

#. ja: 観念しなさい！
#. de: Hört endlich auf mit dem Unsinn!
#. fr: On fait moins les malins, hein<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8945:0:13"
msgid "Now I teach you<br>a thing or two!"
msgstr ""

#. ja: まだまだ！<br>篤学者の荘園まで競争だ！
#. de: So leicht geben wir nicht auf! Hah! Folgt uns doch, wenn ihr euch traut!
#. fr: L-le dernier arrivé à la villégiature du Lettré est une mycose moisie<nbsp>! Na<nbsp>!
msgctxt "NpcYell:8946:0:13"
msgid "But wouldn't the Bookman's Shelves be a more appropriate venue?"
msgstr ""

#. ja: あっ、待て！<br>逃がすものですか！
#. de: He, wartet! Haut nicht schon wieder ab!
#. fr: Revenez par là<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8947:0:13"
msgid "I thought you<br>might say that!"
msgstr ""

#. ja: 来たか…<br>さっきは油断したが…
#. de: Da seid ihr ja! Das eben war nur Spaß! Jetzt machen wir ernst!
#. fr: Tu nous as pris par surprise la dernière fois<nbsp>!
msgctxt "NpcYell:8948:0:13"
msgid "So, we've had a chat..."
msgstr ""

#. ja: 今度は絶対に<br>勝ってやる～！
#. de: Diesmal werden wir gewinnen! Hah!
#. fr: Mais pas de triche ce coup-ci<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8949:0:13"
msgid "...and it turns out we're not <i>quite</i> done..."
msgstr ""

#. ja: 望むところよ！
#. de: Jetzt lasst doch endlich den Unfug sein!
#. fr: Hein<nbsp>!? C'est vous qui m'étiez tombés dessus<nbsp>!
msgctxt "NpcYell:8950:0:13"
msgid "Naturally."
msgstr ""

#. ja: こ、これも耐えるとは…！
#. de: So ein Ärger! Das hat sie auch nicht beeindruckt!
#. fr: Même ça, ça n'a pas suffi<nbsp>!?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8951:0:13"
msgid "Now <i>that</i> is impressive!"
msgstr ""

#. ja: にーちゃん！<br>すごいね！
#. de: Brüderchen! Was machen wir jetzt?
#. fr: C'est dingue<nbsp>! Hein, frérot<nbsp>!?
msgctxt "NpcYell:8952:0:13"
msgid "Absolutely delightful!"
msgstr ""

#. ja: ああ、そうだな！<br>次はこっちだ…！
#. de: Los, wir ziehen uns zurück! Noch haben wir nicht alle Trümpfe gespielt!
#. fr: Le vent finira par tourner<nbsp>!
msgctxt "NpcYell:8953:0:13"
msgid "Now, if you'll just come this way..."
msgstr ""

#. ja: 待ちなさいっ！
#. de: Warum müsst ihr immer abhauen?! Bleibt hier!
#. fr: Revenez, poules mouillées<nbsp>!
msgctxt "NpcYell:8954:0:13"
msgid "Haha! The chase is on!"
msgstr ""

#. ja: にーちゃん！<br>こうなったら、アレを…
#. de: Brüderchen! Ich habs! Wie wär's, wenn wir ...
#. fr: Frérot... On n'a plus le choix<nbsp>!
msgctxt "NpcYell:8955:0:13"
msgid "At this point, it seems only fair to mention..."
msgstr ""

#. ja: そうだな…<br>アレをやるか！
#. de: Genau! Zwei Brüder, ein Gedanke!
#. fr: On dirait bien que non...
msgctxt "NpcYell:8956:0:13"
msgid "...that you may not survive this."
msgstr ""

#. ja: な、なにをするつもり？
#. de: Was kommt jetzt?
#. fr: Vous pouvez toujours jeter l'éponge, vous savez...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8957:0:13"
msgid "And what might<br>“this” be, hmm?"
msgstr ""

#. ja: 幻惑合体の術！
#. de: Aus zwei macht eins!
#. fr: FUSION DAEN<nbsp>!
msgctxt "NpcYell:8958:0:13"
msgid "Just a bit of magic..."
msgstr ""

#. ja: 幻惑合体の術！
#. de: Aus zwei macht eins!
#. fr: FUSION DAEN<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8959:0:13"
msgid "...that we save for<br><i>very</i> special occasions."
msgstr ""

#. ja: ドウダ…<br>怖イカ…！？
#. de: Jetzt fressen wir euch mit Haut und Haaren! Muahaha!
#. fr: AH AH AH<nbsp>!!! Alors, on a les pétoches<nbsp>!?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8960:0:13"
msgid "<i>We'll</i> have great fun either way, of course."
msgstr ""

#. ja: こ、怖くなんて<br>ないんだからっ！
#. de: W-Was ist das?! Was für eine schreckliche Bestie!
#. fr: M-même pas peur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8961:0:13"
msgid "I don't doubt that.<br>You have terrible taste."
msgstr ""

#. ja: グオオ…<br>マサカ押サレテ…！？
#. de: Schau mir in den Rachen, Kleines. Hahaha!
#. fr: ARGH<nbsp>! Nous sommes... acculés<nbsp>!?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8962:0:13"
msgid "Oho! <i>That</i> is a first."
msgstr ""

#. ja: どう？<br>いい加減、観念なさい！
#. de: Und, was sagt ihr jetzt, ihr Angeber?
#. fr: Vous vous attendiez pas à ça, les affreux, hein<nbsp>!?
msgctxt "NpcYell:8963:0:13"
msgid "Ready to admit defeat yet?"
msgstr ""

#. ja: マ、マダダ…<br>マダ終ワラナイ…！
#. de: Wenn du glaubst, dass das alles war, dann hast du dich geschnitten! Hah!
#. fr: C'est... C'est pas fini<nbsp>!!!
msgctxt "NpcYell:8964:0:13"
msgid "While there's still fun to be had?"
msgstr ""

#. ja: 次コソ…最後ノ勝負…<br>待ッテイルゾ！
#. de: Folgt uns nur, wenn ihr euch traut. Aber ihr habt bestimmt die Hosen voll! Hahaha!
#. fr: Un dernier défi pour déterminer le vainqueur<nbsp>!
msgctxt "NpcYell:8965:0:13"
msgid "Perish the thought!"
msgstr ""

#. ja: 本当に最後でしょうね…！？
#. de: Hoffentlich ist das ihr letzter Trumpf.
#. fr: Ça a intérêt à être le dernier<nbsp>!
msgctxt "NpcYell:8966:0:13"
msgid "One more round, then!"
msgstr ""

#. ja: ヨクゾ怖気ヅカズ<br>現レタナ！
#. de: Jetzt werden wir euch das Fürchten lehren!
#. fr: Tu n'as pas froid aux yeux, Pixie<nbsp>!!!
msgctxt "NpcYell:8967:0:13"
msgid "And now for the moment..."
msgstr ""

#. ja: 最後ノ勝負…<br>イザ尋常に…！
#. de: Erzittern werdet ihr! Schreien und flehen! Muahaha!
#. fr: Voici l'ultime jeu des frères Daen<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8968:0:13"
msgid "...that <i>we've</i> been waiting for!"
msgstr ""

#. ja: 勝負よ！
#. de: Gebt ruhig euer Bestes, ihr aufgeblasenen Angeber!
#. fr: En garde, fripouilles<nbsp>!
msgctxt "NpcYell:8969:0:13"
msgid "Ahaha! Do your worst!"
msgstr ""

#. ja: ウガアアアア！
#. de: Groaaar!
#. fr: Blaarrrghh<nbsp>!
msgctxt "NpcYell:8970:0:13"
msgid "Well!"
msgstr ""

#. ja: にーちゃん…<br>すごかったね…
#. de: Brüderchen, wie kann das sein?
#. fr: Im<shy>pres<shy>sionnant<nbsp>! Hein, frérot<nbsp>!?
msgctxt "NpcYell:8971:0:13"
msgid "It's been quite some time..."
msgstr ""

#. ja: ああ、全力を尽くして…<br>それで負けた…
#. de: Alles gegeben haben wir und doch verloren?!
#. fr: On a tout donné... et on a quand même perdu...
msgctxt "NpcYell:8972:0:13"
msgid "...since we've had such good sport!"
msgstr ""

#. ja: ようやく負けを<br>認めたわね！
#. de: Ich hoffe, ihr seht jetzt ein, dass ihr nicht tun und lassen könnt, was ihr wollt!
#. fr: Ah<nbsp>! T'as dit que vous aviez perdu<nbsp>! Je t'ai entendu<nbsp>!
msgctxt "NpcYell:8973:0:13"
msgid "So...you're done?"
msgstr ""

#. ja: 認めるよ…<br>もうヘトヘトだしな…
#. de: Ja, wir geben es zu! Wir haben es vielleicht etwas zu weit getrieben ...
#. fr: C'est bon, c'est bon. T'as gagné. J'en peux plus de toute façon.
msgctxt "NpcYell:8974:0:13"
msgid "Yes, that will do."
msgstr ""

#. ja: 私も…クタクタよ…<br>でも、楽しかったわ！
#. de: Wenigstens habt ihr jetzt eure Lektion gelernt. Aber ich muss gestehen, es hat auch Spaß gemacht ... Hihihi.
#. fr: Moi non plus, en fait... Mais au final... on a bien rigolé<nbsp>!
msgctxt "NpcYell:8975:0:13"
msgid "You'll notice that you lost."
msgstr ""

#. ja: ウシシシシ！<br>オレも…
#. de: Haha. Ja, uns auch! Nicht wahr, Brüderchen?
#. fr: Hi hi hiii<nbsp>! C'est pas faux<nbsp>!
msgctxt "NpcYell:8976:0:13"
msgid "We did, at that."
msgstr ""

#. ja: ボクも、ボクも！
#. de: Und ob! Großartig war es!
#. fr: Je suis bien d'accord, frérot<nbsp>!
msgctxt "NpcYell:8977:0:13"
msgid "But what a loss it was!"
msgstr ""

#. ja: よかったら…<br>また遊んでくれよな！
#. de: Irgendwann sollten wir wieder zusammen spielen!
#. fr: Faudra qu'on se refasse ça<nbsp>! Qu'est-ce tu en dis, Pixie<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8978:0:13"
msgid "We really must do<br>this again sometime!"
msgstr ""

#. ja: くれよな！
#. de: Ja, bitte! Lasst uns bald wieder spielen!
#. fr: Dis oui, dis oui<nbsp>!
msgctxt "NpcYell:8979:0:13"
msgid "I concur!"
msgstr ""

#. ja: 悪さもほどほどに<br>するなら遊んでもいいわ！
#. de: Aber nur, wenn ihr es nicht zu weit treibt! Niemand vom Feenvolk darf zu Schaden kommen!
#. fr: Hé hé<nbsp>! Pourquoi pas, si vous y allez mollo sur les méchantes plai<shy>san<shy>te<shy>ries<nbsp>!
msgctxt "NpcYell:8980:0:13"
msgid "Oh, if you insist."
msgstr ""

#. ja: じゃあ、またね！
#. de: Nun gut. Ich bin müde von der wilden Jagd. Zeit, nach Hause zurückzukehren!
#. fr: À plus, les minus<nbsp>!
msgctxt "NpcYell:8981:0:13"
msgid "It's been fun!"
msgstr ""

#. ja: ウシシシシ！<br>オレたちの勝ちだな！
#. de: Haha, der Sieg ist unser!
#. fr: Hi hi hiii<nbsp>! Les frères Daen, inarrêtables<nbsp>!
msgctxt "NpcYell:8982:0:13"
msgid "Well, well!"
msgstr ""

#. ja: にーちゃん！<br>楽勝だったね！
#. de: Brüderchen! Ein großartiger Sieg! Hahaha!
#. fr: On lui a fait manger la terre, frérot<nbsp>!
msgctxt "NpcYell:8983:0:13"
msgid "It seems we are the victors!"
msgstr ""

#. ja: う、うぅ…<br>悔しいよぅ…
#. de: Argh ... Das ist frustrierend!
#. fr: Grrr... Ils sont mauvais joueurs ET mauvais gagnants<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8984:0:13"
msgid "The <i>cheaters</i>, more like!"
msgstr ""

#. ja: ウシシシシ！<br>今度は邪魔するなよ！
#. de: Aber das nächste Mal kommt ihr uns nicht in die Quere!
#. fr: Hi hi hiii<nbsp>! Ça t'apprendra à nous mettre des bâtons dans les roues<nbsp>!
msgctxt "NpcYell:8985:0:13"
msgid "We thank you for the diversion..."
msgstr ""

#. ja: また遊ぼうね～！
#. de: Lasst uns bald wieder spielen!
#. fr: Mais on s'est amusés quand même, au final. Alors, reviens quand tu veux<nbsp>!
msgctxt "NpcYell:8986:0:13"
msgid "...however brief it was!"
msgstr ""

#. ja: おいおい、アマロ～<br>根性みせろよ～！
#. de: Jetzt werden wir sehen, ob Amaros auch Krallen haben, hehe!
#. fr: Hé, l'amaro<nbsp>! C'est quand que tu nous sors le grand jeu<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8987:0:13"
msgid "You could at least<br><i>try</i> to fight back."
msgstr ""

#. ja: 弟をよくも！
#. de: Brüderchen, zeig's ihnen!
#. fr: Laissez mon frère tranquille<nbsp>!
msgctxt "NpcYell:8988:0:13"
msgid "Oh, dear."
msgstr ""

#. ja: や、やるじゃないか…！
#. de: Ihr seid ganz schön gut!
#. fr: Vous vous débrouillez plutôt pas mal<nbsp>!
msgctxt "NpcYell:8989:0:13"
msgid "Oooh, that smarts."
msgstr ""

#. ja: もっと熱くなれよ～！
#. de: Jetzt geht es heiß her!
#. fr: Ohé, le planeur<nbsp>! Il serait temps de déchaîner la force ancestrale<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8990:0:13"
msgid "A bit more savagery,<br>if you please."
msgstr ""

#. ja: ウラウラ！
#. de: Pahahaha!
#. fr: Beuha ah ah ah<nbsp>!
msgctxt "NpcYell:8991:0:13"
msgid "Ohoho!"
msgstr ""

#. ja: ウシシシ！
#. de: Muahaha!
#. fr: Hi hi hiiii<nbsp>!
msgctxt "NpcYell:8992:0:13"
msgid "Ahaha!"
msgstr ""

#. ja: いけ、グライダー！
#. de: Rupf den Amaros die Federn, Gleiter!
#. fr: Go, planeur ancestral<nbsp>!
msgctxt "NpcYell:8993:0:13"
msgid "You'll do."
msgstr ""

#. ja: お前に決めた！
#. de: Wusst ich's doch!
#. fr: Planeur ancestral<nbsp>! Je te choisis<nbsp>!
msgctxt "NpcYell:8994:0:13"
msgid "Go on, then!"
msgstr ""

#. ja: グライダーも<br>負けるな～！
#. de: Gleiter, zeig ihm, was eine Harke ist!
#. fr: Courage petit planeur<nbsp>! Tu y es presque<nbsp>!
msgctxt "NpcYell:8995:0:13"
msgid "Chin up!"
msgstr ""

#. ja: アマロ負けちゃうかな<br>おもしろ～い！
#. de: Ob die Amaros sich rupfen lassen? So spannend!
#. fr: Hé<nbsp>! C'est serré, en fait<nbsp>!
msgctxt "NpcYell:8996:0:13"
msgid "Has one taken the lead?"
msgstr ""

#. ja: よくも、にーちゃんを！
#. de: Pass auf, Brüderchen!
#. fr: Fréroooooooot<nbsp>!
msgctxt "NpcYell:8997:0:13"
msgid "Brother!"
msgstr ""

#. ja: にーちゃん、大丈夫？
#. de: Brüderchen! Alles in Ordnung?
#. fr: Frérot<nbsp>! Accroche-toi<nbsp>!
msgctxt "NpcYell:8998:0:13"
msgid "Are you quite alright?"
msgstr ""

#. ja: えいやー！
#. de: Haha!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:8999:0:13"
msgid "Haha!"
msgstr ""
