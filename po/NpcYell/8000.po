# NpcYell
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: やったな！<br>奴らが逃げていくぞ！
#. de: Lauft nur, ihr garstigen Eidechsen!
#. fr: On a réussi<nbsp>! Ils battent en retraite<nbsp>!
msgctxt "NpcYell:8000:0:13"
msgid "They are fleeing!"
msgstr ""

#. ja: スリザーバウが<br>守れてよかったわ！
#. de: Keine Klaue setzt ihr heute nach Schlangenzweig!
#. fr: Je suis tellement contente d'avoir réussi à protéger Serpentige<nbsp>!
msgctxt "NpcYell:8001:0:13"
msgid "Slitherbough is safe. For now."
msgstr ""

#. ja: ええい、こうなったら<br>全力で抵抗してやる！
#. de: So einfach bekommt ihr uns nicht!
#. fr: Préparez-vous<nbsp>! Je vais tout donner<nbsp>!
msgctxt "NpcYell:8002:0:13"
msgid "Everyone, to arms!"
msgstr ""

#. ja: 獲物も十分に採れた<br>今回の狩猟は成功だな！
#. de: Das sollte für heute genügen, nicht wahr? Zeit zum Rückzug.
#. fr: On a abattu un bon nombre de créatures, la chasse d'aujourd'hui est un succès<nbsp>!
msgctxt "NpcYell:8003:0:13"
msgid "That should be enough for now."
msgstr ""

#. ja: みなの喜ぶ顔がみたい<br>さあ、拠点に帰ろう！
#. de: In der Tat. Diese Jagd war überaus erfolgreich.
#. fr: J'ai hâte de voir les sourires de tout le monde quand on leur apprendra la nouvelle<nbsp>! Retournons-vite à la base<nbsp>!
msgctxt "NpcYell:8004:0:13"
msgid "Yes, 'tis a bounteous harvest indeed."
msgstr ""

#. ja: ムッ…！？<br>貴様たち何者だ…！
#. de: Wartet, was ist<nbsp>... Ein Hinterhalt?!
#. fr: Quoi<nbsp>!? Qu'est-ce que c'est que ces trucs<nbsp>!?
msgctxt "NpcYell:8005:0:13"
msgid "Who goes there!?"
msgstr ""

#. ja: 死こそが真の闇に至る門…<br>我らが救いをもたらそう
#. de: Auf euch wartet die nimmerendende Nacht! Gebt euch der Schwärze hin!
#. fr: La mort est l'obscurité suprême... Nous apportons le vrai salut.
msgctxt "NpcYell:8006:0:13"
msgid "We are come to deliver you unto darkness eternal..."
msgstr ""

#. ja: ああ、死が近い…<br>死が近いわぁ！
#. de: Ah, der dunkle Kuss des Todes wartet!
#. fr: Ah... Je sens la mort...
msgctxt "NpcYell:8007:0:13"
msgid "There is no escape from death!"
msgstr ""

#. ja: 「常闇の愛し子」か…！<br>まずい、囲まれたぞ！
#. de: Kinder der Ewigen Dunkelheit? Verflucht, wir sind umzingelt!
#. fr: Oh non<nbsp>! Les enfants des Ténèbres éternelles nous encerclent<nbsp>!
msgctxt "NpcYell:8008:0:13"
msgid "Children of the Everlasting Dark..."
msgstr ""

#. ja: 死こそが至高の闇…<br>我らは真の救いをもたらさん
#. de: Nur der Tod bringt die Erlösung!
#. fr: La mort est l'obscurité suprême... Nous n'apportons pas le vrai salut<nbsp>!
msgctxt "NpcYell:8009:0:13"
msgid "In death, you will find salvation!"
msgstr ""

#. ja: ハ、ハハハ…<br>どうにか生き延びたぞ…
#. de: \<ächz> Es scheint überstanden<nbsp>...
#. fr: Ha... Ha ha ha... On l'a échappé belle...
msgctxt "NpcYell:8010:0:13"
msgid "We...made it."
msgstr ""

#. ja: さあ、拠点に戻ろう…<br>今度こそ、な…
#. de: Wir sollten uns sputen und nicht länger hier verweilen.
#. fr: Retournons à la base... Pour de bon, cette fois<nbsp>!
msgctxt "NpcYell:8011:0:13"
msgid "Let us return, before we are waylaid any further."
msgstr ""

#. ja: まて…<br>奴には手を出すな…
#. de: Nimm dich vor ihr in Acht<nbsp>...
#. fr: Je t'interdis de poser la main sur <if $gn4>elle<else>lui</if><nbsp>!
msgctxt "NpcYell:8012:0:13"
msgid "If you value your life, flee while you still can!"
msgstr ""

#. ja: たやすく狩れる<br>相手ではないんだ…
#. de: Ihrem grausamen Schnabel und fetzenden Klauen ist niemand gewachsen!
#. fr: C'est pas une proie facile...
msgctxt "NpcYell:8013:0:13"
msgid "A moment's hesitation and she will tear you apart!"
msgstr ""

#. ja: ハァ…ハァ…<br>最悪だ…
#. de: Es<nbsp>... Es hat keinen Zweck.
#. fr: Ha... Ha... On est dans de beaux draps<nbsp>!
msgctxt "NpcYell:8014:0:13"
msgid "It is no use..."
msgstr ""

#. ja: ど、どうにか<br>やり過ごせないか…
#. de: Mir bleibt nur harren und hoffen.
#. fr: Comment on va faire...<nbsp>?
msgctxt "NpcYell:8015:0:13"
msgid "I can only pray she forgets about me..."
msgstr ""

#. ja: キィィィィ！
#. de: Kyieeeeee!
#. fr: Kiiiiiiii<nbsp>!
msgctxt "NpcYell:8016:0:13"
msgid "KHREEEEEE!"
msgstr ""

#. ja: すまない…<br>姉妹たち…私は…
#. de: Urgh<nbsp>... V-Vergebt mir<nbsp>...
#. fr: Mes sœurs... Pardon...
msgctxt "NpcYell:8017:0:13"
msgid "Forgive me..."
msgstr ""

#. ja: まさか、奴を狩るとはな…<br>助かった、礼を言うよ
#. de: Sie ist gefallen! Wie ist das möglich?
#. fr: Je ne pensais honnêtement pas te revoir vivant<if $gn4>e</if>... Merci de m'avoir sauvée<nbsp>!
msgctxt "NpcYell:8018:0:13"
msgid "The beast is slain!"
msgstr ""

#. ja: さて、痛み止めも効いてきた…<br>私は里に戻るとするよ
#. de: Ich schulde dir mein Leben. Bis ins Dorf sollte ich es alleine schaffen, du hast schon genug getan.
#. fr: Les médicaments ont enfin fait effet, je n'ai plus mal. Je rentre au village de ce pas<nbsp>!
msgctxt "NpcYell:8019:0:13"
msgid "I think I can make it back by myself. Thank you."
msgstr ""

#. ja: さあ、一気に<br>追い散らすわよ！
#. de: Los, verscheuchen wir die geflügelten Biester!
#. fr: Allez, on se dépêche de repousser tout ça<nbsp>!
msgctxt "NpcYell:8020:0:13"
msgid "Put down as many as you can!"
msgstr ""

#. ja: 見て！<br>ギザマルークの群れよ！
#. de: Sieh nur, ein ganzer Schwarm Gizamaluks!
#. fr: Regardez<nbsp>! C'est un groupe de gisamarks<nbsp>!
msgctxt "NpcYell:8021:0:13"
msgid "Gizamaluks! A whole horde of them!"
msgstr ""

#. ja: 遺跡の方に向かった…<br>営巣するつもりね！
#. de: Was wollen sie bei den Ruinen? Doch nicht etwa nisten?!
#. fr: Ils se dirigent vers les ruines... Probablement pour y faire leurs nids<nbsp>!
msgctxt "NpcYell:8022:0:13"
msgid "They must be looking for a place to nest."
msgstr ""

#. ja: 追跡して<br>追い払いましょう！
#. de: Das dürfen wir nicht zulassen! Ihnen nach!
#. fr: Partons sur leurs traces et repoussons-les<nbsp>!
msgctxt "NpcYell:8023:0:13"
msgid "We must keep them away from the ruins!"
msgstr ""

#. ja: ヤクルス！<br>急いでちょうだい！
#. de: Jaculus, spute dich!
#. fr: Allez, petit griffon, plus vite<nbsp>!
msgctxt "NpcYell:8024:0:13"
msgid "Fly like the wind!"
msgstr ""

#. ja: やっぱり…<br>遺跡に巣を作るつもりね！
#. de: Tatsache, sie sind wegen des Nestbaus hier.
#. fr: C'est bien ce que je disais, ils commencent à faire leurs nids<nbsp>!
msgctxt "NpcYell:8025:0:13"
msgid "They only gather like this when preparing to nest."
msgstr ""

#. ja: 大切な遺跡が…<br>かなり傷ついて…
#. de: N-Nein<nbsp>... Ich muss die Ruinen schützen!
#. fr: Les ruines ont subi des dégâts importants...
msgctxt "NpcYell:8026:0:13"
msgid "Now there is nothing to stop them from defiling the ruins."
msgstr ""

#. ja: 力不足が<br>悔やまれるわね…
#. de: Der Schaden ist beträchtlich. Ich habe versagt.
#. fr: Je suis trop faible...
msgctxt "NpcYell:8027:0:13"
msgid "This is all our fault..."
msgstr ""

#. ja: でも、気を取り直して<br>巡回に戻りましょう…
#. de: Doch Klagen hilft nichts. Wir müssen die Patrouille fortsetzen.
#. fr: Il faut que je me reprenne<nbsp>!
msgctxt "NpcYell:8028:0:13"
msgid "Let us withdraw for now and try to find another way."
msgstr ""

#. ja: 諦めてくれたようね…<br>助かったわ…
#. de: Sie scheinen es sich anders überlegt zu haben. Ausgezeichnet.
#. fr: Ouf, on est sauvé<if $gn4>es<else>s</if><nbsp>!
msgctxt "NpcYell:8029:0:13"
msgid "Do you think we have seen the last of them?"
msgstr ""

#. ja: これに懲りたら<br>もう来るんじゃないよ！
#. de: Fort mit euch, ihr geflügelte Plage!
#. fr: J'espère qu'ils retiendront la leçon<nbsp>!
msgctxt "NpcYell:8030:0:13"
msgid "Begone, foul beasts!"
msgstr ""

#. ja: それじゃ、巡回任務に<br>戻りましょうか…
#. de: Komm, setzen wir die Patrouille fort.
#. fr: Bon, retournons à notre patrouille...
msgctxt "NpcYell:8031:0:13"
msgid "Come. Let us continue our patrol."
msgstr ""

#. ja: こんな時に限って<br>仲間がいないなんて…
#. de: Gah, warum passiert mir so etwas, wenn ich alleine unterwegs bin?!
#. fr: J'arriverai pas à faire quoi que ce soit toute seule...
msgctxt "NpcYell:8032:0:13"
msgid "Where are my sisters when I need them?"
msgstr ""

#. ja: かなり遺物を<br>持ち去られました…
#. de: Nehmt die Pfoten von den Relikten!
#. fr: Beaucoup de reliques ont disparu...
msgctxt "NpcYell:8033:0:13"
msgid "Why must they take so many!?"
msgstr ""

#. ja: もっと見回りを<br>強化しなくては…
#. de: Wir müssen wohl unsere Patrouillen stärken, damit solche Überfälle nicht mehr vorkommen.
#. fr: Il va falloir renforcer le système des patrouilles...
msgctxt "NpcYell:8034:0:13"
msgid "We shall need to guard this entrance more carefully from now on."
msgstr ""

#. ja: 遺物を護ってくださり<br>ありがとうございました
#. de: Ich danke dir. Alleine wäre ich dieser Situation nicht Herrin geworden.
#. fr: Merci d'avoir protégé les précieuses reliques<nbsp>!
msgctxt "NpcYell:8035:0:13"
msgid "Thank you, for all you have done."
msgstr ""

#. ja: どうにか無事に<br>遺物を回収できたようです
#. de: Ich glaube, das waren alle. Und die Relikte sind sogar noch unbeschadet.
#. fr: Au moins nous avons réussi à récupérer les reliques...
msgctxt "NpcYell:8036:0:13"
msgid "Is that all of them, I wonder?"
msgstr ""

#. ja: まだ遺物を所持しているなら<br>どうか私に…！
#. de: Hast du weitere Relikte bergen können?
#. fr: Si vous avez encore des reliques sur vous, je les récupère<nbsp>!
msgctxt "NpcYell:8037:0:13"
msgid "Do you have any more of the artifacts?"
msgstr ""

#. ja: 回収した遺物は<br>どうか私に…！
#. de: Bring alle Funde zu mir, bitte.
#. fr: Pouvez-vous me confier les dernières reliques qu'il vous reste<nbsp>?
msgctxt "NpcYell:8038:0:13"
msgid "If you find any more, please give them to me!"
msgstr ""

#. ja: 遺物はマンドリルたちも<br>持っているようです！
#. de: Ich sehe noch ein paar Mandrills mit Relikten in ihren Pfoten!
#. fr: Il semblerait ques les mandrills aient réussi à garder quelques reliques<nbsp>!
msgctxt "NpcYell:8039:0:13"
msgid "The wood raiders still have some of the relics!"
msgstr ""

#. ja: 手頃な獲物だろう<br>さあ、狩ってみせろ
#. de: Unterschätze niemals deine Beute. Sonst endest du selbst als die Gejagte.
#. fr: Ce sont des proies faciles pour toi<nbsp>!
msgctxt "NpcYell:8040:0:13"
msgid "They may only be deer, but do not underestimate them!"
msgstr ""

#. ja: ハ、ハイッ！<br>サルメ、頑張りますッ！
#. de: Verstanden, Quilmet! Ich werde dich nicht enttäuschen!
#. fr: Oui<nbsp>! Je vais faire de mon mieux<nbsp>!
msgctxt "NpcYell:8041:0:13"
msgid "I wish you would stop worrying!"
msgstr ""

#. ja: 狩りに出るが<br>サルメよ、共に来るか？
#. de: Salmet, begleite mich doch auf die nächste Jagd.
#. fr: Je pars chasser<nbsp>! Salmet, tu viens<nbsp>?
msgctxt "NpcYell:8042:0:13"
msgid "Would you care to join me on a hunt?"
msgstr ""

#. ja: キルメ姉様といっしょに！？<br>う、嬉しいですっ！
#. de: Liebend gern!
#. fr: Une chasse avec vous, Quilmet<nbsp>? J'en serais honorée<nbsp>!
msgctxt "NpcYell:8043:0:13"
msgid "I would love to!"
msgstr ""

#. ja: でも、あたしの腕じゃ<br>足手まといに…
#. de: Das heißt, wenn du mich akzeptierst.
#. fr: Mais je ne suis pas sûre d'être à la hauteur...
msgctxt "NpcYell:8044:0:13"
msgid "If you will have me..."
msgstr ""

#. ja: 実力不足を感じるなら<br>なおのこと練習すべきだ
#. de: Du hast für diesen Moment geübt, nicht wahr?
#. fr: Si tu penses que tu n'as pas les capacités, c'est justement l'occasion de t'entraîner.
msgctxt "NpcYell:8045:0:13"
msgid "You have been practicing for this moment, have you not?"
msgstr ""

#. ja: そ、そうですよね…
#. de: Nun, ja.
#. fr: V-vous avez raison<nbsp>!
msgctxt "NpcYell:8046:0:13"
msgid "Well, yes..."
msgstr ""

#. ja: わかりました…<br>サルメ、頑張りますッ！
#. de: Ich werde mein Bestes geben, dich nicht zu enttäuschen.
#. fr: C'est compris<nbsp>! Je vais faire de mon mieux<nbsp>!
msgctxt "NpcYell:8047:0:13"
msgid "I will try not to disappoint you."
msgstr ""

#. ja: その心意気だ<br>ならば、私は指導に徹しよう
#. de: Du sorgst dich zu viel. Denke nur an dein Training.
#. fr: Parfait<nbsp>! Dans ce cas, suis bien mes ordres<nbsp>!
msgctxt "NpcYell:8048:0:13"
msgid "You worry overmuch. Just remember your training."
msgstr ""

#. ja: ハイッ！<br>よろしくお願いしますっ！
#. de: Ja, das werde ich.
#. fr: Bien sûr<nbsp>!!
msgctxt "NpcYell:8049:0:13"
msgid "Understood!"
msgstr ""

#. ja: 見ろ、サルメ…<br>若いディアーだ
#. de: Schau. Siehst du sie?
#. fr: Regarde Salmet<nbsp>! C'est un jeune daim<nbsp>!
msgctxt "NpcYell:8050:0:13"
msgid "Look... Do you see them?"
msgstr ""

#. ja: わわっ…<br>やっぱり、あたしの腕じゃ…
#. de: Das war wohl nichts.
#. fr: Oh non, je vais pas y arriver...
msgctxt "NpcYell:8051:0:13"
msgid "Yes..."
msgstr ""

#. ja: もっと獲物のことを<br>理解せねばな…
#. de: Vielleicht war es noch zu früh für dich.
#. fr: Il faut comprendre comment les proies réfléchissent<nbsp>!
msgctxt "NpcYell:8052:0:13"
msgid "Perhaps it was too soon for you."
msgstr ""

#. ja: サルメよ、ここまでだ<br>引き上げるぞ
#. de: Salmet, komm!
#. fr: On s'arrête là, Salmet<nbsp>! On rentre au village<nbsp>!
msgctxt "NpcYell:8053:0:13"
msgid "Salmet, to me!"
msgstr ""

#. ja: は、はぁ～い…
#. de: Ungh.
#. fr: D-d'accord...
msgctxt "NpcYell:8054:0:13"
msgid "Ungh..."
msgstr ""

#. ja: キ、キルメ姉様！<br>やりましたよっ！
#. de: Ich habe es geschafft!
#. fr: Quilmet<nbsp>! J'ai réussi<nbsp>!
msgctxt "NpcYell:8055:0:13"
msgid "I did it!"
msgstr ""

#. ja: サルメよ、今回は<br>援護に助けられたな
#. de: Dank der Hilfe <if $gn4>unserer Freundin<else>unseres Freundes</if> hier.
#. fr: Tu n'as pas fait ça toute seule, Salmet...
msgctxt "NpcYell:8056:0:13"
msgid "With a little help from our friend here."
msgstr ""

#. ja: うぅ…悔しいけど…<br>言い返せません…
#. de: Ja, ich bin dir auch sehr dankbar.
#. fr: Argh... C'est vrai...
msgctxt "NpcYell:8057:0:13"
msgid "Yes, and I am very thankful."
msgstr ""

#. ja: その想いがあれば<br>上達するさ…帰るぞ！
#. de: Das nächste Mal, wenn wir uns auf die Jagd begeben, wirst du das Wild alleine stellen.
#. fr: Sers-toi de cette frustration pour t'améliorer. Allez, on rentre<nbsp>!
msgctxt "NpcYell:8058:0:13"
msgid "When next we hunt, you shall face your prey alone."
msgstr ""

#. ja: ふむ、矢筋は悪くない…
#. de: Sehr gut ...
#. fr: Hum, pas mal<nbsp>!
msgctxt "NpcYell:8059:0:13"
msgid "Very good..."
msgstr ""

#. ja: 獲物の半歩先を<br>狙ってみせろ
#. de: Ziele ein wenig vor das Ziel.
#. fr: Essaie d'avoir une longueur d'avance sur les proies<nbsp>!
msgctxt "NpcYell:8060:0:13"
msgid "Aim ahead of your target!"
msgstr ""

#. ja: 獣の動きを<br>よく見るんだ…
#. de: Du musst ihre Bewegungen vorausahnen.
#. fr: Observe bien les créatures<nbsp>!
msgctxt "NpcYell:8061:0:13"
msgid "Watch their movements!"
msgstr ""

#. ja: 火神の眼とまで呼ばれる<br>奴を、どうやれば…！
#. de: Das Auge von Ox'Gatorl ...
#. fr: Comment on va faire pour l'arrêter<nbsp>!?
msgctxt "NpcYell:8062:0:13"
msgid "The Eye of Gatorl..."
msgstr ""

#. ja: なんてことだ！
#. de: Aber was macht es hier?
#. fr: Oh non, ce n'est pas vrai<nbsp>!
msgctxt "NpcYell:8063:0:13"
msgid "But what is it doing here?"
msgstr ""

#. ja: ロンカの守護像が<br>暴走している！
#. de: Ist es besessen?
#. fr: La statue ronka est en train de déguerpir<nbsp>!
msgctxt "NpcYell:8064:0:13"
msgid "Is it possessed!?"
msgstr ""

#. ja: う、うう…守護者が<br>破壊者に堕ちるなんて…
#. de: Es muss uns für Eindringlinge halten.
#. fr: Je... J'arrive pas à y croire...
msgctxt "NpcYell:8065:0:13"
msgid "It must have mistaken us for intruders..."
msgstr ""

#. ja: 里の仲間たちに<br>知らせないと…
#. de: Wir sollten den anderen Bescheid sagen.
#. fr: Il faut aller prévenir les autres<nbsp>!
msgctxt "NpcYell:8066:0:13"
msgid "We had best inform the others."
msgstr ""

#. ja: と、止まってくれた…
#. de: Ist es vorbei?
#. fr: Elle s'est arrêtée<nbsp>!
msgctxt "NpcYell:8067:0:13"
msgid "Is it over?"
msgstr ""

#. ja: あとでもう一度<br>命石を入れてやろう…
#. de: Wir müssen den Kern womöglich ersetzen.
#. fr: Il va falloir faire quelque chose...
msgctxt "NpcYell:8068:0:13"
msgid "Perhaps we need to replace the core."
msgstr ""

#. ja: 止まってくれ！
#. de: Was hat es vor?
#. fr: Arrêtez-vous<nbsp>!
msgctxt "NpcYell:8069:0:13"
msgid "What is it doing!?"
msgstr ""

#. ja: ガトル神よ<br>静まりたまえ！
#. de: Ox'Gatorl, erhöre unsere Gebete!
#. fr: Ox'Gatorl<nbsp>! Calmez-vous<nbsp>!
msgctxt "NpcYell:8070:0:13"
msgid "Ox'Gatorl, hear our prayer! Stop this madness!"
msgstr ""

#. ja: ハッ！
#. de: Nimm das!
#. fr: Ha<nbsp>!
msgctxt "NpcYell:8071:0:13"
msgid "Have at you!"
msgstr ""

#. ja: いけっ！
#. de: Jetzt bist du dran!
#. fr: Vas-y<nbsp>!
msgctxt "NpcYell:8072:0:13"
msgid "This ends now!"
msgstr ""

#. ja: ハァ…ハァ…
#. de: Wir müssen doch etwas tun können ...
#. fr: Ha... Ha...
msgctxt "NpcYell:8073:0:13"
msgid "No, not yet..."
msgstr ""

#. ja: ここまでなのか…
#. de: Ich habe versagt ...
#. fr: C'est la fin...
msgctxt "NpcYell:8074:0:13"
msgid "I have failed..."
msgstr ""

#. ja: やあっ！
#. de: Ha!
#. fr: Yaah<nbsp>!
msgctxt "NpcYell:8075:0:13"
msgid "Hyaaah!"
msgstr ""

#. ja: これでどう？
#. de: Dies wird kein Tag der Niederlage!
#. fr: Tiens<nbsp>!
msgctxt "NpcYell:8076:0:13"
msgid "We shall not succumb to the likes of you!"
msgstr ""

#. ja: なんてことなの…
#. de: Wie konnte ich nur so naiv sein?
#. fr: Non...
msgctxt "NpcYell:8077:0:13"
msgid "How could I have been so foolish!?"
msgstr ""

#. ja: うぅ、血がこんなに…
#. de: Nein, nicht so!
#. fr: Tout ce sang...
msgctxt "NpcYell:8078:0:13"
msgid "Not like this..."
msgstr ""

#. ja: 死こそが至高の闇…
#. de: Der Tod ist die Erlösung!
#. fr: La mort est l'obscurité suprême<nbsp>!
msgctxt "NpcYell:8079:0:13"
msgid "In death is salvation!"
msgstr ""

#. ja: そこよ！
#. de: In das Auge der Bestie!
#. fr: Han<nbsp>!
msgctxt "NpcYell:8080:0:13"
msgid "Allow me!"
msgstr ""

#. ja: 外さないッ！
#. de: Möge mein Pfeil sein Ziel treffen.
#. fr: Je t'ai<nbsp>!
msgctxt "NpcYell:8081:0:13"
msgid "May my aim be straight and true!"
msgstr ""

#. ja: ゆ、油断したとでも…？
#. de: Ich war zu unvorsichtig.
#. fr: Je... Je me suis fait avoir...
msgctxt "NpcYell:8082:0:13"
msgid "I have been careless..."
msgstr ""

#. ja: ち、力が…<br>入らない…
#. de: Ich bin ... verwundet ...
#. fr: J'ai plus de force...
msgctxt "NpcYell:8083:0:13"
msgid "I have not the strength..."
msgstr ""

#. ja: 諦めなさい！
#. de: Gegen uns Jägerinnen habt ihr keine Chance!
#. fr: Abandonnez<nbsp>!
msgctxt "NpcYell:8084:0:13"
msgid "You cannot hope to defeat us!"
msgstr ""

#. ja: もう、しつこいッ！
#. de: Du bist ganz schön widerspenstig, was?
#. fr: Argh<nbsp>! Ils sont tenaces<nbsp>! 
msgctxt "NpcYell:8085:0:13"
msgid "My, my! Stubborn, aren't you?"
msgstr ""

#. ja: しまった…！？
#. de: Die Wunde sieht übel aus ...
#. fr: Non<nbsp>!!
msgctxt "NpcYell:8086:0:13"
msgid "Is this the end?"
msgstr ""

#. ja: ハァ、ハァ…<br>もう、ダメみたい…
#. de: Ich kann nicht mehr<nbsp>...
#. fr: Ha... Ha... C'est fini...
msgctxt "NpcYell:8087:0:13"
msgid "I have nothing left to give..."
msgstr ""

#. ja: 死によって救いを…
#. de: Akzeptiert euer Schicksal!
#. fr: Je vais vous offrir le cadeau de la mort<nbsp>!
msgctxt "NpcYell:8088:0:13"
msgid "Accept your fate!"
msgstr ""

#. ja: ぐぉっ…<br>なぜ正しき我が…
#. de: Warum verneint ihr eure Bestimmung?
#. fr: Impossible...
msgctxt "NpcYell:8089:0:13"
msgid "Why deny your fate!?"
msgstr ""

#. ja: 死に近づき<br>至高の闇が見えるぞ…
#. de: Die Dunkelheit ruft mich ...
#. fr: Je sens la mort approcher... Je peux voir l'obscurité suprême...
msgctxt "NpcYell:8090:0:13"
msgid "The darkness calls to me..."
msgstr ""

#. ja: ああ、素敵！<br>素敵よっ！
#. de: Deine Zeit ist gekommen!
#. fr: Oh, magnifique<nbsp>! Magnifique<nbsp>!
msgctxt "NpcYell:8091:0:13"
msgid "Your time is close at hand..."
msgstr ""

#. ja: いいわ！<br>もっとちょうだい！
#. de: Niemand wird euch retten!
#. fr: Oui... Encore<nbsp>!
msgctxt "NpcYell:8092:0:13"
msgid "None shall save you!"
msgstr ""

#. ja: もっと、もっと！<br>私に死を…！
#. de: Dunkelheit, nimm mich in deine Arme!
#. fr: Oui<nbsp>!! Apporte-moi la mort<nbsp>!
msgctxt "NpcYell:8093:0:13"
msgid "Darkness, take me!"
msgstr ""

#. ja: ああ、死が近くに…！
#. de: Das ist der Moment, auf den ich gewartet habe!
#. fr: Je sens la mort<nbsp>! Elle est toute proche<nbsp>!
msgctxt "NpcYell:8094:0:13"
msgid "The moment I have been waiting for..."
msgstr ""

#. ja: アガガガ…
#. de: Ich brenne!
#. fr: Aïe aïe AÏÏÏEEUUH<nbsp>!!!
msgctxt "NpcYell:8095:0:13"
msgid "Ah! Aaargh!"
msgstr ""

#. ja: 熱イィ～！
#. de: Diese Hitze!
#. fr: C'est chaud, c'est chaud... ÇA BRÛÛÛLE<nbsp>!!!
msgctxt "NpcYell:8096:0:13"
msgid "It burns!"
msgstr ""

#. ja: ハァ、ハァ…
#. de: \<keuch> ... \<keuch> ...
#. fr: Haa, haa, haa...
msgctxt "NpcYell:8097:0:13"
msgid "\\<pant> \\<pant>"
msgstr ""

#. ja: ほらほら、こっちだ！
#. de: He! Hier drüben!
#. fr: Par ici<nbsp>!
msgctxt "NpcYell:8098:0:13"
msgid "Over here!"
msgstr ""

#. ja: 魔獣を引き付けてくれ！
#. de: Nimm dir die Bestie vor!
#. fr: Tenez cette bête à l'écart de ma<shy>de<shy>moi<shy>sel<shy>le Editha<nbsp>!
msgctxt "NpcYell:8099:0:13"
msgid "Draw it away from Editha!"
msgstr ""

#. ja: しっかりするんだ！
#. de: Halte durch!
#. fr: Accrochez-vous<nbsp>!
msgctxt "NpcYell:8100:0:13"
msgid "Keep fighting!"
msgstr ""

#. ja: 負傷者は退避を！
#. de: Rettet die Verwundeten!
#. fr: Évacuez les blessés<nbsp>!
msgctxt "NpcYell:8101:0:13"
msgid "Get the wounded to safety!"
msgstr ""

#. ja: もう大丈夫だ…！
#. de: Jetzt seid ihr in Sicherheit.
#. fr: Ça va aller<nbsp>!
msgctxt "NpcYell:8102:0:13"
msgid "You'll be alright!"
msgstr ""

#. ja: 仲間を…護れなかった…
#. de: Sie starben vor meinen Augen!
#. fr: Ils sont... invincibles...
msgctxt "NpcYell:8103:0:13"
msgid "I couldn't...save them..."
msgstr ""

#. ja: 地殻をまといて鎧となす！
#. de: Mich armiert der Mantel der Erde selbst!
#. fr: L'écorce terrestre est mon armure<nbsp>!
msgctxt "NpcYell:8104:0:13"
msgid "When all else is dust, I shall remain."
msgstr ""

#. ja: 喰らうがいいッ！
#. de: Fels und Geklüft soll euch verschlingen!
#. fr: La terre vous emportera<nbsp>!
msgctxt "NpcYell:8105:0:13"
msgid "The earth opens up to claim you, mortal."
msgstr ""

#. ja: 震えろッ！
#. de: Mein Groll lässt die Welt erzittern!
#. fr: Tremblez<nbsp>!
msgctxt "NpcYell:8106:0:13"
msgid "The world shall tremble!"
msgstr ""

#. ja: そらそらッ！
#. de: Hinab in euer steinernes Grab!
#. fr: Hors de mon chemin<nbsp>!
msgctxt "NpcYell:8107:0:13"
msgid "Pitiful!"
msgstr ""

#. ja: グアアァァァ…
#. de: Uaaaargh!
#. fr: Graaaah<nbsp>!!
msgctxt "NpcYell:8108:0:13"
msgid "Gaaaaaah!"
msgstr ""

#. ja: 海の水ない<br>漁も難しい…
#. de: Ohne Wasser keine Fisssche ...
#. fr: Pas évident de pêcher ccces derniers temps...
msgctxt "NpcYell:8109:0:13"
msgid "I must sssay, it has been much harder to fish of late."
msgstr ""

#. ja: テンペストパール、集め<br>助けてくれるか？
#. de: Fsssh. Wirst du uns helfen, die Tempest-Perlen zu sammeln?
#. fr: Vous aimez les perles très ssscintillantes<nbsp>?
msgctxt "NpcYell:8110:0:13"
msgid "Can I interessst you in some work?"
msgstr ""

#. ja: テンペストパール<br>もっといっぱい、必要…
#. de: Ich brauche noch mehr von den Perlen ...
#. fr: Nous avons besoin de plusss de perles...
msgctxt "NpcYell:8111:0:13"
msgid "We ssstill need more pearls."
msgstr ""

#. ja: これで卵の子ら健康に育つ<br>ありがとう、ありがとう！
#. de: Mit diesen Perlen können wir nun die Eier der Königin ehren. Psssh.
#. fr: Merccci<nbsp>! La reine maternelle vous le rendra<nbsp>!
msgctxt "NpcYell:8112:0:13"
msgid "When the clutchmother is happy, all of us are happy."
msgstr ""

#. ja: テンペストパール、足りない<br>母王、悲しむ…悲しむ…
#. de: Nicht genug Perlen. Wie schade.
#. fr: Nous manquons de jolies perles ssscintillantes...
msgctxt "NpcYell:8113:0:13"
msgid "What a paltry ssselection of pearls!"
msgstr ""

#. ja: 十分集まった<br>そろそろ帰らなければ…
#. de: Das reicht. Genug Perlen für die Zeremonie. Ich kehre nun zurück ...
#. fr: Merccci<nbsp>! Ççça devrait sssuffire<nbsp>!
msgctxt "NpcYell:8114:0:13"
msgid "Yesss, this should sssuffice."
msgstr ""

#. ja: 導きのヒト…<br>手を貸してくれるか？
#. de: <if $gn4>Flossenlose<else>Flossenloser</if>, ich brauche deine Hilfe ...
#. fr: Veux-tu bien m'aider, sssans-branchies<nbsp>?
msgctxt "NpcYell:8115:0:13"
msgid "Ssso, will you help me?"
msgstr ""

#. ja: 紅血珊瑚、必要、<br>とてもいっぱい必要…
#. de: Ich muss Blutkorallen sssammeln. Viele Blutkorallen.
#. fr: Il me faut des coraux sssanguins, et en grande quantité<nbsp>!
msgctxt "NpcYell:8116:0:13"
msgid "I need as much coral as I can carry!"
msgstr ""

#. ja: アルケオタニア、大食い…<br>だから珊瑚、いっぱい必要…！
#. de: Das Ungeheuer frisst bevorzugt Blutkorallen. Sie werden einen hervorragenden Köder abgeben.
#. fr: Il faut beaucoup de coraux sssanguins. L'appétit d'Archaeotania est aussi légendaire qu'elle.
msgctxt "NpcYell:8117:0:13"
msgid "No sssuch thing as too much!"
msgstr ""

#. ja: テウスィー、力貸してくれたヒト、とても感謝する！<br>そろそろ、罠作るため、潮溜まり戻る、ありがとう……！
#. de: Danke für deine Hilfe, <if $gn4>Flossenlose<else>Flossenloser</if>. Ich kehre nun in die Ondo-Becken zurück, um den Köder herzustellen.
#. fr: Je retourne à Baïne préparer mon appât<nbsp>! Merccci, sssans-branchies<nbsp>!
msgctxt "NpcYell:8118:0:13"
msgid "Thank you! Now for the next part of the plan."
msgstr ""

#. ja: おお、残念だ……紅血珊瑚、数足りない……！<br>これでは、罠、作ること不可能……！
#. de: Bedauerlich. Nicht genug Blutkorallen, um den Köder herzustellen. Psssh ...
#. fr: Je n'aurai pas assez de coraux sssanguins avec ççça pour fabriquer un bon appât...
msgctxt "NpcYell:8119:0:13"
msgid "Oh dear...thisss will never do."
msgstr ""

#. ja: 紅血珊瑚、いっぱい…！<br>テウスィー、そろそろ戻る…！
#. de: Ja, sssehr gut! Das sollten genug Blutkorallen sein! Ich kehre nun zurück zum Schwarm.
#. fr: J'ai une montagne de coraux sssanguins dans ma besaccce, largement assez<nbsp>!
msgctxt "NpcYell:8120:0:13"
msgid "Lots of coral!"
msgstr ""

#. ja: グガァ！
#. de: \<fauch>
#. fr: Graaah<nbsp>!
msgctxt "NpcYell:8121:0:13"
msgid "\\<snarl>"
msgstr ""

#. ja: オオオン！
#. de: \<knurr>
#. fr: Wouuuh<nbsp>!
msgctxt "NpcYell:8122:0:13"
msgid "\\<growl>"
msgstr ""

#. ja: ウォーン！
#. de: A-uuuuuuh!
#. fr: Wou-ou-ouh<nbsp>!
msgctxt "NpcYell:8123:0:13"
msgid "Awooo!"
msgstr ""

#. ja: ガルルルゥ…
#. de: Gehehe ...
#. fr: Grrrr...
msgctxt "NpcYell:8124:0:13"
msgid "Gehehe..."
msgstr ""

#. ja: キュウゥゥ…
#. de: \<winsel>
#. fr: Awouuuuh...
msgctxt "NpcYell:8125:0:13"
msgid "\\<whimper>"
msgstr ""

#. ja: ハァ…ハァ…
#. de: \<japs> \<japs>
#. fr: Hah... Hah...
msgctxt "NpcYell:8126:0:13"
msgid "\\<pant> \\<pant>"
msgstr ""

#. ja: ウガアアァ！
#. de: Groooaaar!
#. fr: Ughaaaah<nbsp>!
msgctxt "NpcYell:8127:0:13"
msgid "\\<roar>"
msgstr ""

#. ja: グルルルル…
#. de: Grrr ...
#. fr: Ghrrrr...
msgctxt "NpcYell:8128:0:13"
msgid "Grrrrrr..."
msgstr ""

#. ja: 迎撃するぞ！
#. de: Warge! Zu den Waffen!
#. fr: On les intercepte<nbsp>!
msgctxt "NpcYell:8129:0:13"
msgid "Wargs! To arms!"
msgstr ""

#. ja: 物見塔を守れッ！
#. de: Haltet die Reihen! Verteidigt den Rundturm!
#. fr: Protégez la Garde<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8130:0:13"
msgid "Do not waver!<br>Defend the Round!"
msgstr ""

#. ja: 床デモ、ナメテナ！
#. de: Du sollst leiden!
#. fr: Crève la bouche ouverte<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8131:0:13"
msgid "Your fashion sense<br>is bad, and you<br>should feel bad!"
msgstr ""

#. ja: ケケケ…<br>コノ世ハ、終ワリダ！
#. de: Haha! Diese Welt ist verloren!
#. fr: Hi hi hi<nbsp>! Ce monde est fini<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8132:0:13"
msgid "All that lives<br>will someday die!"
msgstr ""

#. ja: ノ、ノ、ノ
#. de: Einladen bitte!<br>Einladen bitte!<br>Einladen bitte!
#. fr: Inv<nbsp>! J'veux profiter<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8133:0:13"
msgid "Your face! It's<br>breaking my immersion!"
msgstr ""

#. ja: あわわわ…
#. de: Ah! Autschilein!
#. fr: J'ai peur<nbsp>!
msgctxt "NpcYell:8134:0:13"
msgid "Oh! I don't like this!"
msgstr ""

#. ja: 何をしているッ！
#. de: Was soll das werden?!
#. fr: Je ne vais pas vous laisser faire<nbsp>!
msgctxt "NpcYell:8135:0:13"
msgid "Not on my watch!"
msgstr ""

#. ja: さあ、もう観念しろ
#. de: Das Spiel ist aus, du Schurke!
#. fr: Ça suffit<nbsp>!
msgctxt "NpcYell:8136:0:13"
msgid "Enough of this!"
msgstr ""

#. ja: 屯所まで来てもらう
#. de: Hinter Schloss und Riegel mit dir.
#. fr: Vous allez avoir pas mal de réponses à me donner<nbsp>!
msgctxt "NpcYell:8137:0:13"
msgid "I'm taking you in for questioning."
msgstr ""

#. ja: ×未使用
#. de: 0
#. fr: 0
msgctxt "NpcYell:8138:0:13"
msgid "0"
msgstr ""

#. ja: 休憩ってわけにも<br>いかないようね
#. de: Sie lassen uns keine Zeit, mal Luft zu holen.
#. fr: Pas le temps de se reposer, on dirait<nbsp>!
msgctxt "NpcYell:8139:0:13"
msgid "No time to catch our breath..."
msgstr ""

#. ja: また来たわ！<br>みんな構えて！
#. de: Da kommen noch mehr!
#. fr: En voilà d'autres<nbsp>! Tenez-vous prêts<nbsp>!
msgctxt "NpcYell:8140:0:13"
msgid "Hold fast."
msgstr ""

#. ja: テウスィー、出発する！
#. de: Gehen wir los ...
#. fr: En route<nbsp>!
msgctxt "NpcYell:8141:0:13"
msgid "Thisss way!"
msgstr ""

#. ja: 紅血珊瑚、洞窟の奥ある…！
#. de: Die Blutkorallen wachsen tief im Innern dieser Grotte.
#. fr: Les coraux sssont au fond de la caverne.
msgctxt "NpcYell:8142:0:13"
msgid "There shhhould be plenty in this cave!"
msgstr ""

#. ja: でも、洞窟、魔物多い<br>がんばって戦う…！
#. de: Doch in der Grotte hausen gefährliche Tiere. Wir müssen wahrscheinlich kämpfen<nbsp>...
#. fr: Mais elle est infessstée de monssstres, alors nous devrons nous battre<nbsp>!
msgctxt "NpcYell:8143:0:13"
msgid "I hope we do not encounter any...trouble."
msgstr ""

#. ja: むむっ！？<br>魔物出た…！
#. de: Sieh! Ungeheuer!
#. fr: Attention<nbsp>!
msgctxt "NpcYell:8144:0:13"
msgid "Trouble! And so sssoon!"
msgstr ""

#. ja: むむっ！<br>また魔物…倒さないと…！
#. de: Wir müssen sie alle bezwingen!
#. fr: Il en vient encore d'autres<nbsp>!
msgctxt "NpcYell:8145:0:13"
msgid "We mean you no harm!"
msgstr ""

#. ja: 確かこの辺り…<br>どこだ？
#. de: Hier irgendwo müssen sie sein ...
#. fr: Ccc'était par là, je crois...
msgctxt "NpcYell:8146:0:13"
msgid "Shhhould be around here..."
msgstr ""

#. ja: なんと、お前たち…<br>フラウンダー！
#. de: Was? Flundern? Hier?
#. fr: Des Flets<nbsp>!? Iccci<nbsp>!?
msgctxt "NpcYell:8147:0:13"
msgid "Benthos! What are you doing here!?"
msgstr ""

#. ja: フシュ、フシュ、フシュ……<br>な、なんとか、勝てた……助太刀、本当に感謝する……！
#. de: \<japs><nbsp>... \<japs><nbsp>... Wir haben sie zurückgeschlagen. Deine Kräfte sind wirklich beeindruckend<nbsp>...
#. fr: Fssshhh... Fssshhh... Fssshhh... Nous touchons enfin au but...
msgctxt "NpcYell:8148:0:13"
msgid "What could they be after?"
msgstr ""

#. ja: おおっ！
#. de: \<fauch>
#. fr: Fsssohh<nbsp>!
msgctxt "NpcYell:8149:0:13"
msgid "Ah!"
msgstr ""

#. ja: がんばって戦う…！
#. de: Im Rausch des Kampfes!
#. fr: Rien ne m'arrêtera<nbsp>!
msgctxt "NpcYell:8150:0:13"
msgid "I will not die so easily!"
msgstr ""

#. ja: ぬおっ！
#. de: Ha!
#. fr: Fssarggg...<nbsp>!
msgctxt "NpcYell:8151:0:13"
msgid "Shhhaaagh!"
msgstr ""

#. ja: 倒れて、頼む！
#. de: Verende an der Spitze meines Speeres!
#. fr: Disssparaissez<nbsp>!
msgctxt "NpcYell:8152:0:13"
msgid "Mussst not give up..."
msgstr ""

#. ja: いけない！<br>シリナたちはアタシが！
#. de: Gar nicht gut!<br>Wartet, ich komme!
#. fr: Oh non<nbsp>! Je m'occupe de Cirina et des autres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8153:0:13"
msgid "Not good!<br>Hold on, I'm coming!"
msgstr ""

#. ja: すべてを…殲滅する…
#. de: Auf euch<nbsp>... wartet einzig Vernichtung<nbsp>...
#. fr: Tout sera... annihilé...
msgctxt "NpcYell:8154:0:13"
msgid "Only death awaits..."
msgstr ""

#. ja: 目当ての貝、たくさんいる<br>プルプラ洞の奥！
#. de: Die Muscheln befinden sich tief in der Höhle, fsssh!
#. fr: La grotte purpurine est bourrée de coquillages<nbsp>!
msgctxt "NpcYell:8155:0:13"
msgid "I can sssmell those shhhells from here!"
msgstr ""

#. ja: こっちだよ、陸人！<br>いっしょに行こう！
#. de: Dort drüben! Folge mir!
#. fr: Par iccci, sssans-branchies<nbsp>!
msgctxt "NpcYell:8156:0:13"
msgid "Thisss way, finless one!"
msgstr ""

#. ja: ブレイク！
#. de: So nicht!
#. fr: Brèche<nbsp>!
msgctxt "NpcYell:8157:0:13"
msgid "Break!"
msgstr ""

#. ja: むおっ！
#. de: Arrr<nbsp>...
#. fr: Fsssyaaa<nbsp>!
msgctxt "NpcYell:8158:0:13"
msgid "Oof!"
msgstr ""

#. ja: 邪魔、しないで！
#. de: Aus dem Weg!
#. fr: Laissez-nous tranquilles<nbsp>!
msgctxt "NpcYell:8159:0:13"
msgid "Please, we come in peace!"
msgstr ""

#. ja: 足元つるつる<br>とても、注意するいい！
#. de: Der Boden ist glitschig! Pass auf deine Flossen auf!
#. fr: Fssshhh... Attention. Le sssol est glissant...
msgctxt "NpcYell:8160:0:13"
msgid "Watch your footing, finlesss one!"
msgstr ""

#. ja: わわっ！<br>魔物が出た！
#. de: Ah! Ein Ungeheuer!
#. fr: Nous sssommes repérés<nbsp>!
msgctxt "NpcYell:8161:0:13"
msgid "Ssso much for sssneaking in!"
msgstr ""

#. ja: わわわっ！<br>またまた魔物！
#. de: Uaaah! Noch mehr Ungeheuer!
#. fr: En voilà d'autres<nbsp>!
msgctxt "NpcYell:8162:0:13"
msgid "More of them?"
msgstr ""

#. ja: ひええっ！<br>こんなに魔物が…！
#. de: Es werden immer mehr!
#. fr: Fssshhh<nbsp>!! Ils sssont trop nombreux<nbsp>!
msgctxt "NpcYell:8163:0:13"
msgid "Perhaps thisss was a bad idea?"
msgstr ""

#. ja: ありがとう、到着できた！<br>さあ、いっぱい集めるぞ！
#. de: Endlich sind wir angekommen. Zeit, mit dem Sammeln zu beginnen<nbsp>...
#. fr: Nous y sssommes enfin<nbsp>! Que la récolte commence<nbsp>!
msgctxt "NpcYell:8164:0:13"
msgid "Hopefully, that was the lassst of them. Many thanksss!"
msgstr ""

#. ja: うるさい奴らめ！
#. de: Ihr Widerlinge!
#. fr: Taisez-vous<nbsp>!
msgctxt "NpcYell:8165:0:13"
msgid "\\<gasp> Why, I never!"
msgstr ""

#. ja: あ、諦めるものか…
#. de: Vielleicht sollte ich mich verziehen<nbsp>...
#. fr: Pas question de renoncer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8166:0:13"
msgid "Well, I suppose<br>you're not <i>wrong</i>..."
msgstr ""

#. ja: まったく<br>人騒がせな奴らめ……
#. de: Was für eine Zeit<shy>verschwen<shy>dung<nbsp>...
#. fr: Pfff, quelle histoire...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8167:0:13"
msgid "What a waste<br>of my time..."
msgstr ""

#. ja: 忌々しい奴らだ…
#. de: Ein ganz peinlicher Auftritt war das.
#. fr: Quels insolents<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8168:0:13"
msgid "I don't even<br>know why I care!"
msgstr ""

#. ja: あ、あれは…<br>ルガルーじゃないか！？
#. de: Ist das etwa ... Lugarhoo? Verdammt!
#. fr: Mais... c'est Lugarhoo<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8169:0:13"
msgid "Is that...Lugarhoo? <i>Shite.</i>"
msgstr ""

#. ja: 民間人に被害が及ぶ前に<br>なんとしても倒すぞ！
#. de: Ist das Ding etwa immer noch am Leben?
#. fr: Il faut l'abattre avant qu'il<br>ne s'en prenne aux civils<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8170:0:13"
msgid "That <i>thing</i><br>is still alive!?"
msgstr ""

#. ja: ど、どうにか倒せたな…
#. de: Das war ungemütlich!
#. fr: On a réussi à l'emporter...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8171:0:13"
msgid "I-I've never been<br>so scared in<br>all my life..."
msgstr ""

#. ja: 生きた心地が<br>しなかったぞ…
#. de: Und der soll mal wie wir gewesen sein?
#. fr: J'ai cru que j'allais y rester...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8172:0:13"
msgid "To think that<br>was once a man..."
msgstr ""

#. ja: て、撤退する…
#. de: ... Rennt um euer Leben!
#. fr: Je... Je me replie...
msgctxt "NpcYell:8173:0:13"
msgid "...RUN!"
msgstr ""

#. ja: 今日は豊漁だな！<br>そろそろ帰るとしよう！
#. de: Ein guter Fang. Ab nach Hause!
#. fr: Quelle bonne pêche<nbsp>!<br>Il est temps de rentrer.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8174:0:13"
msgid "Today's catch<br>smells a bit...riper<br>than usual."
msgstr ""

#. ja: んっ！？<br>なんだ、この臭いは…？
#. de: Moment, so riecht doch kein Fisch?
#. fr: Hum<nbsp>!? Quelle est<br>cette odeur infâme<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8175:0:13"
msgid "Wait, that's not<br>the stink of fish!"
msgstr ""

#. ja: う、うわぁ！<br>アネモネの群れが！
#. de: Aaah! Aaah! Aaanemonen!
#. fr: Ouah<nbsp>! Une horde<br>d'anémones<nbsp>!
msgctxt "NpcYell:8176:0:13"
msgid "Aaaugh! Anemones!"
msgstr ""

#. ja: 悲鳴…！？<br>大丈夫ですか！
#. de: Schreie? Und was ist das für ein Gestank?
#. fr: Des cris<nbsp>? Tout va bien<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8177:0:13"
msgid "I heard screams!<br>Are you─<br>what's that smell?"
msgstr ""

#. ja: 衛兵さん！<br>激臭のアネモネが…！
#. de: Anemonen! Stinkende Anemonen!
#. fr: Garde<nbsp>! Ces anémones<br>empestent...
msgctxt "NpcYell:8178:0:13"
msgid "Save...the fish..."
msgstr ""

#. ja: 我々にお任せを！<br>総員、魔物退治だ！
#. de: Zieh die Waffe und halt die Luft an!
#. fr: Nous nous en occupons<nbsp>!<br>Tous à l'assaut<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8179:0:13"
msgid "Draw your weapons!<br>And try not to breathe!"
msgstr ""

#. ja: ぐっ…<br>申し訳ない…
#. de: Ich halt den Mief nicht aus!
#. fr: D... désolé...
msgctxt "NpcYell:8180:0:13"
msgid "I can't take it..."
msgstr ""

#. ja: 我々の力不足で<br>せっかくの釣果が…
#. de: Mir kommt's hoch<nbsp>...
#. fr: Pardon<nbsp>! On n'a rien pu faire<br>pour sauver les poissons...
msgctxt "NpcYell:8181:0:13"
msgid "I'm going to be sick..."
msgstr ""

#. ja: そ、そんなぁ…<br>苦労して採った魚なのに…
#. de: Meine armen Fische<nbsp>...
#. fr: Non<nbsp>! Mes poissons<nbsp>!<br>Ils étaient si frais<nbsp>!
msgctxt "NpcYell:8182:0:13"
msgid "My poor fish..."
msgstr ""

#. ja: 助かりました！<br>ありがとうございます！
#. de: Der Gestank ist fort! Oder meine Nase hat aufgegeben.
#. fr: Merci beaucoup<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8183:0:13"
msgid "The smell is gone!<br>Or my nose has<br>stopped working!"
msgstr ""

#. ja: むっ…<br>この気配は…？
#. de: Moment, was ist das?
#. fr: Mais quelle est cette<br>présence hostile<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8184:0:13"
msgid "I'll take either,<br>at this point.<br>...Wait, what's that?"
msgstr ""

#. ja: うわあぁぁ！<br>森のヌシが…！
#. de: Uaaah! Was für eine Bestie!
#. fr: Aaaah<nbsp>! C'est lui...<br>Le maître de la forêt<nbsp>!
msgctxt "NpcYell:8185:0:13"
msgid "Aaaugh, giant lizard!"
msgstr ""

#. ja: アネモネの激臭で<br>怒っているのか！？
#. de: Der hat die Anemonen wohl auch gerochen.
#. fr: Il semble furieux<nbsp>!<br>C'est à cause de l'odeur...<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8186:0:13"
msgid "I guess <i>its</i><br>nose still works..."
msgstr ""

#. ja: いずれにせよ<br>倒すしかないぞ！
#. de: Und glücklich guckt er nicht drein!
#. fr: Il va falloir le vaincre,<br>pas le choix.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8187:0:13"
msgid "It certainly seems<br>angry enough!"
msgstr ""

#. ja: はぁ、はぁ…<br>撃退できたようだな…
#. de: \<keuch> Schnell weg, bevor hier noch was aufkreuzt.
#. fr: Ouf... On a réussi à le maîtriser<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8188:0:13"
msgid "\\<pant> Let's leave<br>before anything<br>else shows up."
msgstr ""

#. ja: だ、だめだ…！<br>遺憾ながら撤退する…！
#. de: Es reicht nicht! Schnapp den Fisch und lauf!
#. fr: Argh<nbsp>! Il faut se replier, hélas...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8189:0:13"
msgid "It's too strong!<br>Grab the fish<br>and run!"
msgstr ""

#. ja: やらせはせんぞ！
#. de: Ich schenk dir nichts.
#. fr: Minfilia est à moi<nbsp>!
msgctxt "NpcYell:8190:0:13"
msgid "Face me!"
msgstr ""

#. ja: そこかッ！
#. de: Da!
#. fr: Approche un peu<nbsp>!
msgctxt "NpcYell:8191:0:13"
msgid "There!"
msgstr ""

#. ja: 来るがいい！
#. de: Komm doch ...
#. fr: Petit petit petit...
msgctxt "NpcYell:8192:0:13"
msgid "Come!"
msgstr ""

#. ja: こ、こんなところで…
#. de: Ausgerechnet hier und jetzt?
#. fr: Argh, pas maintenant...
msgctxt "NpcYell:8193:0:13"
msgid "Of all the bloody..."
msgstr ""

#. ja: 力及ばず…か…
#. de: M-Meine Kraft<nbsp>... schwindet<nbsp>...
#. fr: Je suis... trop faible...
msgctxt "NpcYell:8194:0:13"
msgid "That the best you can..."
msgstr ""

#. ja: そんな…いや…
#. de: Das kann doch ...
#. fr: Non...
msgctxt "NpcYell:8195:0:13"
msgid "No... I can't..."
msgstr ""

#. ja: こんなはずでは…
#. de: Das darf nicht ...
#. fr: Pourquoi...<nbsp>!?
msgctxt "NpcYell:8196:0:13"
msgid "You fool..."
msgstr ""

#. ja: そ、そんな…
#. de: I-Ich ...
#. fr: Je me sens mal...
msgctxt "NpcYell:8197:0:13"
msgid "No, not yet..."
msgstr ""

#. ja: みんな…ごめん…
#. de: E-Es tut mir leid, ich ...
#. fr: Parrrdonnez-moi...
msgctxt "NpcYell:8198:0:13"
msgid "I'm so sorry..."
msgstr ""

#. ja:  強烈ナ銃撃デ<br>ヒトリズツ仕留メテヤル！
#. de: Die Urgewalt sei entfesselt! Schwarm aus Meteoriten!
#. fr: Un par un... Tous à mort...
msgctxt "NpcYell:8199:0:13"
msgid "One shot...is all I need!"
msgstr ""

#. ja: コノ金貨ガ欲シイカ？<br>見ロ、見ロ、見ロォ～！
#. de: 0
#. fr: 0
msgctxt "NpcYell:8200:0:13"
msgid "0"
msgstr ""

#. ja: 邪魔ナ奴ラメ…<br>俺ニ、近ヅクナァ！
#. de: Parasiten! Haltet euch fern!
#. fr: Des gêneurs... À mort...
msgctxt "NpcYell:8201:0:13"
msgid "The treasure is mine! All mine!"
msgstr ""

#. ja: ●ふははは・・・！力がみなぎる
#. de: 0
#. fr: 0
msgctxt "NpcYell:8202:0:13"
msgid "0"
msgstr ""

#. ja: 俺ハ…宝ヲ…<br>手ニ入レタ…
#. de: Der Schatz ist mein ...
#. fr: Le trésor... est à moi...
msgctxt "NpcYell:8203:0:13"
msgid "It was mine...mine..."
msgstr ""

#. ja: 嗚呼、船ハ…<br>仲間ハ、何処ダ…？
#. de: Wo sind nur meine Freunde geblieben ...
#. fr: Mon bateau... Mon équipage...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8204:0:13"
msgid "Must find...the ship...<br>Forget the crew..."
msgstr ""

#. ja: うわーッ！
#. de: Uaaah!
#. fr: Ouaaah<nbsp>!
msgctxt "NpcYell:8205:0:13"
msgid "Huh!?"
msgstr ""

#. ja: ギャー！
#. de: Hilfe!
#. fr: Aaaarrrgh...<nbsp>!
msgctxt "NpcYell:8206:0:13"
msgid "What!?"
msgstr ""

#. ja: そんなに俺が好きか？
#. de: Du hast es wirklich auf mich abgesehen, was?
#. fr: Tu peux pas te passer de moi, hein<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8207:0:13"
msgid "What did I do to<br>deserve such attention?"
msgstr ""

#. ja: しつこいぞ、ランビルド！
#. de: Bleib mir vom Leib, Lanbyrd!
#. fr: Lâche-moi, Lanbyrrrd<nbsp>!
msgctxt "NpcYell:8208:0:13"
msgid "Leave me alone, Lanbyrd!"
msgstr ""

#. ja: 成仏してくれ！
#. de: Stirb schon!
#. fr: Tu vas clamser, oui<nbsp>!?
msgctxt "NpcYell:8209:0:13"
msgid "Just die already!"
msgstr ""

#. ja: 俺が相手だ、アンドレイア！
#. de: Ich bin es, Andreia!
#. fr: C'est moi ton adversairrre, Andreia<nbsp>!
msgctxt "NpcYell:8210:0:13"
msgid "Your fight is with me, Andreia!"
msgstr ""

#. ja: こいつでトドメじゃ！
#. de: Mach ihn fertig!
#. fr: Et voilà pour toi<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8211:0:13"
msgid "Stay <i>right</i> there!"
msgstr ""

#. ja: いっちょ、やっちゃるよ！
#. de: Darf ich vorstellen: Meine Faust!
#. fr: Je vais vous en mettre plein la vue<nbsp>!
msgctxt "NpcYell:8212:0:13"
msgid "Right, let them have it!"
msgstr ""

#. ja: このあたりも異常はなし…
#. de: Keine besonderen Vorkommnisse.
#. fr: Rien à signaler par ici...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8213:0:13"
msgid "Nothing out of<br>the ordinary..."
msgstr ""

#. ja: いや…<br>あれは…ドラコ？
#. de: Bis auf das da!
#. fr: Tiens<nbsp>? Un draco<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8214:0:13"
msgid "...Aaand I spoke<br>too soon."
msgstr ""

#. ja: なんて大きさだ…！<br>もし民間人が襲われたら…
#. de: Ein riesiger Draco! Auf ihn mit Gebrüll!
#. fr: Il est énorme<nbsp>!<br>S'il attaquait quelqu'un...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8215:0:13"
msgid "Massive draco. Right.<br>Here we go, then!"
msgstr ""

#. ja: くっ…
#. de: Argh ...
#. fr: Uuh...
msgctxt "NpcYell:8216:0:13"
msgid "Ungh..."
msgstr ""

#. ja: ひいっ！
#. de: Uaaah!
#. fr: Fssshhh<nbsp>!!
msgctxt "NpcYell:8217:0:13"
msgid "I am ssscared!"
msgstr ""

#. ja: こっちくるな！
#. de: Weg! Weg von mir!
#. fr: Oh non<nbsp>! Fssshhh<nbsp>!!
msgctxt "NpcYell:8218:0:13"
msgid "Get away, fiend!"
msgstr ""

#. ja: 陸人、頑張れ！
#. de: <if $gn4>Flossenlose<else>Flossenloser</if>, hilf mir!
#. fr: Courage, sssans-branchies<nbsp>!
msgctxt "NpcYell:8219:0:13"
msgid "You can do it, finlesss one!"
msgstr ""

#. ja: すごいぞ！<br>強いぞ！
#. de: Ssso stark! Ssso gefährlich!
#. fr: Im<shy>pres<shy>sionnant<nbsp>!
msgctxt "NpcYell:8220:0:13"
msgid "Impresssive!"
msgstr ""

#. ja: 何匹いるんだ？
#. de: Wie viele dieser Kreaturen kommen noch?
#. fr: Il y en a combien<nbsp>?
msgctxt "NpcYell:8221:0:13"
msgid "How many can there be!?"
msgstr ""

#. ja: 来るんじゃ<br>なかった…かな？
#. de: Psssh. Warum folgst du mir nicht?
#. fr: Fssshhh<nbsp>!! Pas par ici, non<nbsp>!
msgctxt "NpcYell:8222:0:13"
msgid "Perhapsss this was a bad idea!"
msgstr ""

#. ja: がんばれ！
#. de: Sei tapfer ...
#. fr: Allez, allez<nbsp>!
msgctxt "NpcYell:8223:0:13"
msgid "Yesss, like that!"
msgstr ""

#. ja: 陸人、ふんばれ！
#. de: Sei tapfer, <if $gn4>Flossenlose<else>Flossenloser</if>!
#. fr: Encore un effort<nbsp>!
msgctxt "NpcYell:8224:0:13"
msgid "Watch out!"
msgstr ""

#. ja: 先に進む…<br>暗がり、気をつける！
#. de: Wir müssen weiter vordringen. Es ist dunkel. Sei vorsichtig.
#. fr: Plus nous avançççons plus il fait sssombre. Gare à ne pas trébucher.
msgctxt "NpcYell:8225:0:13"
msgid "They may be lurking in the shhhadows!"
msgstr ""

#. ja: ふう、戦い苦手…<br>とても緊張する…
#. de: Ich bin kein guter Jäger, aber ich werde mein Bestes geben, fsssh.
#. fr: J'essspère ne pas trop avoir à me battre. Ccce n'est pas ccce que je fais le mieux...
msgctxt "NpcYell:8226:0:13"
msgid "I am not well-sssuited to all of this violence!"
msgstr ""

#. ja: 陸人を頼るなど…<br>汚らわしい！
#. de: Die Flossenlosen sind Frevler! Sie sind unrein! Sie sind ein schlechtes Omen!
#. fr: Il fraye avec les sssans-branchies<nbsp>! Quelle honte pour les Ondos<nbsp>!
msgctxt "NpcYell:8227:0:13"
msgid "Relying on finlesss ones... Dessspicable!"
msgstr ""

#. ja: ぐあっ…！？<br>このままでは…撤退する…！
#. de: Wir müssen uns zurückziehen!
#. fr: FssshHHARRR<nbsp>! Battez en retraite<nbsp>!
msgctxt "NpcYell:8228:0:13"
msgid "We had bessst retreat!"
msgstr ""

#. ja: …………
#. de: ...
#. fr: ...
msgctxt "NpcYell:8229:0:13"
msgid "..."
msgstr ""

#. ja: 吹き飛べい！
#. de: Hier kommt das Vögelchen!
#. fr: J'vais te faire valdinguer<nbsp>!
msgctxt "NpcYell:8230:0:13"
msgid "Hammers away!"
msgstr ""

#. ja: しつこいヤツじゃ！
#. de: Ganz schön hartnäckig.
#. fr: Il démord pas<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8231:0:13"
msgid "<i>Annoying</i>, I tell you."
msgstr ""

#. ja: そいやぁっ！
#. de: Los jetzt!
#. fr: Allez<nbsp>!!!
msgctxt "NpcYell:8232:0:13"
msgid "Ha!"
msgstr ""

#. ja: ラミット！<br>回復を頼みます！
#. de: Lamitt! Brauche Heilung!
#. fr: Lamitt<nbsp>! À moi<nbsp>!
msgctxt "NpcYell:8233:0:13"
msgid "I could use some help..."
msgstr ""

#. ja: うおおおッ！
#. de: Raaaaaah!
#. fr: YAAHHH<nbsp>!
msgctxt "NpcYell:8234:0:13"
msgid "Yaaah!"
msgstr ""

#. ja: とっておきの一撃！<br>いっけーっ！
#. de: Das Beste kommt am Schluss!
#. fr: J'ai garrrdé le meilleur pour la fin<nbsp>!
msgctxt "NpcYell:8235:0:13"
msgid "And...now!"
msgstr ""

#. ja: か、身体が…<br>痺れて…動けない…
#. de: Ich ... kann mich nicht bewegen ...
#. fr: Tout mon corrrps est... engourdi...
msgctxt "NpcYell:8236:0:13"
msgid "Can't...move..."
msgstr ""

#. ja: やはり現れたか！<br>軟弱者め…！
#. de: Da ist der Schwächling!
#. fr: Voilà le faiblard<nbsp>! Comme Zumshs l'avait prédit<nbsp>!
msgctxt "NpcYell:8237:0:13"
msgid "Weakling! You dare shhhow your face!?"
msgstr ""

#. ja: 紅血珊瑚は我らのもの！
#. de: Die Blutkorallen sind unser! Fsssh!
#. fr: Les coraux sssanguins sont à nous<nbsp>!
msgctxt "NpcYell:8238:0:13"
msgid "The coral is ours!"
msgstr ""

#. ja: ヌオオン！
#. de: \<zisch> 
#. fr: Fssshhhoooo<nbsp>!
msgctxt "NpcYell:8239:0:13"
msgid "Shhhluuurgh!"
msgstr ""

#. ja: カカカカカ…<br>我、強い！
#. de: Gagagarrr! Stark! So ssstark!
#. fr: Fssshhha ha ha<nbsp>!!! Nous sssommes imbattables<nbsp>!
msgctxt "NpcYell:8240:0:13"
msgid "You are a fool to challenge usss!"
msgstr ""

#. ja: 陸人、軟弱者…<br>まとめて始末する！
#. de: Wir werden alle Flossenlosen vernichten! Psssh!
#. fr: Avortons<nbsp>! Vous ne repartirez pas vivants d'iccci<nbsp>!
msgctxt "NpcYell:8241:0:13"
msgid "Finlesss coward! You are next!"
msgstr ""

#. ja: でやあっ！
#. de: Raaar!
#. fr: Fsssyaaah<nbsp>!
msgctxt "NpcYell:8242:0:13"
msgid "Shhhah!"
msgstr ""

#. ja: 倒す、倒す！
#. de: Nieder mit ihnen!
#. fr: Mourez<nbsp>! Mourez<nbsp>!
msgctxt "NpcYell:8243:0:13"
msgid "Die, die!"
msgstr ""

#. ja: 邪魔する、な！
#. de: Das ist dein Tod!
#. fr: Retournez dans vos nids, sssales faibles<nbsp>!
msgctxt "NpcYell:8244:0:13"
msgid "Ssscream for me!"
msgstr ""

#. ja: クッ、奴は危険だ…
#. de: Das mit dem Gebrüll war doch nicht so eine gute Idee<nbsp>...
#. fr: Argh, il est dangereux...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8245:0:13"
msgid "Maybe charging the<br>huge draco was<br>a <i>bad</i> idea..."
msgstr ""

#. ja: 奴を野放しには<br>出来ない…
#. de: Aber wir können ihn nicht so wüten lassen!
#. fr: Il faut le neutraliser<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8246:0:13"
msgid "But I can't<br>\\<huff> just let it<br>run amok..."
msgstr ""

#. ja: 助かりました！<br>支援に感謝します！
#. de: Wir haben ihn! Ich danke dir für die Hilfe!
#. fr: Merci pour votre aide<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8247:0:13"
msgid "We did it!<br>I can't thank<br>you enough!"
msgstr ""

#. ja: は、はやく民間人に<br>避難を呼びかけなくては…
#. de: Ich muss die Zivilisten schnell warnen!
#. fr: Il faut vite ordonner<br>aux civils d'évacuer<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8248:0:13"
msgid "New idea─<i>run</i>!"
msgstr ""

#. ja: 少し崩れているが…<br>まだ使えそうだな
#. de: Sieht nicht mehr aus wie neu, aber es wird einen schönen Unterschlupf abgeben.
#. fr: Les murs sont délabrés, mais on doit pouvoir s'en servir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8249:0:13"
msgid "Hardly palatial,<br>but could be worse."
msgstr ""

#. ja: ああ…新しいアジトに<br>ぴったりだろう
#. de: Und schön nah an Crystarium, hehe.
#. fr: Oui... Cet endroit est parfait<br>pour notre nouvelle base<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8250:0:13"
msgid "In spittin' distance<br>of the Crystarium, too."
msgstr ""

#. ja: あとは手頃な獲物が<br>見つかればいいんだが…
#. de: Vielleicht kommt die Beute ja zu uns!
#. fr: Reste à trouver une bonne proie...
msgctxt "NpcYell:8251:0:13"
msgid "Maybe our prey'll come to us!"
msgstr ""

#. ja: チッ…見つかったか！
#. de: Wer sagt's denn ...
#. fr: Zut<nbsp>! On est découverts<nbsp>!
msgctxt "NpcYell:8252:0:13"
msgid "That was fast."
msgstr ""

#. ja: クリスタリウムの<br>衛兵団か！
#. de: Die erbärmliche Stadtwache.
#. fr: Les gardes de Cristarium<nbsp>!?
msgctxt "NpcYell:8253:0:13"
msgid "Crystarium dogs, eh?"
msgstr ""

#. ja: 返り討ちにしてやる！
#. de: Kommen genau richtig.
#. fr: On va leur donner une leçon<nbsp>!
msgctxt "NpcYell:8254:0:13"
msgid "Suits me just fine!"
msgstr ""

#. ja: ひ、ひぃ…<br>逃げろーっ！
#. de: Nichts wie weg hier!
#. fr: Aaaah<nbsp>! Fuyons<nbsp>!
msgctxt "NpcYell:8255:0:13"
msgid "Time to cut and run!"
msgstr ""

#. ja: この借りは必ず返すからな！
#. de: Den Heldenmut werden wir euch austreiben!
#. fr: On se vengera<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8256:0:13"
msgid "But don't think<br>your petty <i>heroism</i><br>will save you."
msgstr ""

#. ja: ハハハハ！<br>オレたちの勝ちだな！
#. de: Euer schönes Geschwätz wird euch jetzt nichts mehr nutzen.
#. fr: Ha ha ha<nbsp>! On les a eus<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8257:0:13"
msgid "You thralls to morality<br>are pathetic."
msgstr ""

#. ja: レイクランドは<br>我ら紫葉団の土地だ！
#. de: Seenland gehört den wahren Sündern.
#. fr: Grand-Lac est à nous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8258:0:13"
msgid "Leave Lakeland to<br>the true sinners."
msgstr ""

#. ja: ムッ…<br>何か聞こえたような？
#. de: Habt ihr das gehört?
#. fr: Tiens... Vous n'avez pas entendu quelque chose<nbsp>?
msgctxt "NpcYell:8259:0:13"
msgid "Did you hear that?"
msgstr ""

#. ja: 立て直すわよ！
#. de: War das alles?
#. fr: On s'laisse pas abattre<nbsp>!
msgctxt "NpcYell:8260:0:13"
msgid "Damn you!"
msgstr ""

#. ja: どうした？<br>何か見つけたのか？
#. de: Was gefunden?
#. fr: Quoi<nbsp>? Vous avez trouvé quelque chose<nbsp>?
msgctxt "NpcYell:8261:0:13"
msgid "Did you find something?"
msgstr ""

#. ja: 物音が聞こえたのだが…<br>あ、あれは…！
#. de: Ich glaub, es war<nbsp>...<br>Da! Da sind sie!
#. fr: J'ai entendu du bruit... Hé<nbsp>! Mais...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8262:0:13"
msgid "I think I heard─<br>There! It's them!"
msgstr ""

#. ja: 手配中の紫葉団だ！<br>検挙しなくては！
#. de: Nachtschatten! Und so nah an Crystarium!
#. fr: Des membres des Fanes pourpres<nbsp>!<br>Il faut les intercepter<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8263:0:13"
msgid "Nightshade!? And so<br>close to the Crystarium..."
msgstr ""

#. ja: 武器を捨てて<br>投降しろ！
#. de: Lasst die Waffen fallen!
#. fr: Jetez vos armes et rendez-vous<nbsp>!
msgctxt "NpcYell:8264:0:13"
msgid "Drop your weapons!"
msgstr ""

#. ja: 止まれ！
#. de: Dieses Land gehört euch nicht!
#. fr: Arrêtez-vous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8265:0:13"
msgid "These lands are not<br>yours to claim!"
msgstr ""

#. ja: 数名取りこぼしたが<br>制圧できたようだな
#. de: Die sehen wir so schnell nicht wieder.
#. fr: On en a perdu quelques-uns,<br>mais on a réussi à les maîtriser.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8266:0:13"
msgid "Seems we're rid of<br>them for the time being."
msgstr ""

#. ja: 巡回に戻ろう…
#. de: Hoffentlich stoßen wir nicht auf mehr.
#. fr: Retournons à notre ronde.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8267:0:13"
msgid "Pray we don't happen<br>upon any more."
msgstr ""

#. ja: 被害が大きすぎる…<br>撤退だ…！
#. de: Die Verluste sind zu groß. Rückzug!
#. fr: Nous sommes trop mal en point... Il faut se replier<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8268:0:13"
msgid "We're taking too<br>many losses! Retreat!"
msgstr ""

#. ja: 邪魔だ！
#. de: Ihr seid sowieso verloren, begreift es doch!
#. fr: Dégagez de là<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8269:0:13"
msgid "You're already damned,<br>understand!?"
msgstr ""

#. ja: オラッ！
#. de: Stirb!
#. fr: Filez<nbsp>!
msgctxt "NpcYell:8270:0:13"
msgid "So...die!"
msgstr ""

#. ja: でやっ！
#. de: Ha!
#. fr: Hors de ma vue<nbsp>!
msgctxt "NpcYell:8271:0:13"
msgid "Yah!"
msgstr ""

#. ja: どけっ！
#. de: Weg da!
#. fr: Dé<shy>guer<shy>pis<shy>sez<nbsp>!
msgctxt "NpcYell:8272:0:13"
msgid "Piss off!"
msgstr ""

#. ja: どうしました？
#. de: Was ist hier los?
#. fr: Qu'y a-t-il<nbsp>?
msgctxt "NpcYell:8273:0:13"
msgid "What's going on here?"
msgstr ""

#. ja: 嗚呼、衛兵さん！<br>どうか力を貸してください！
#. de: Die Stadtwache! Hilfe!
#. fr: Monsieur le garde, aidez-moi<nbsp>!
msgctxt "NpcYell:8274:0:13"
msgid "Ah, the guard! Help!"
msgstr ""

#. ja: 洞窟ひんやり、<br>テウスィー、好き…
#. de: Diese Grotte ist herrlich kühl. So frisssch<nbsp>...
#. fr: J'aime la fraîcheur de ccces cavernes.
msgctxt "NpcYell:8275:0:13"
msgid "What a lovely cave!"
msgstr ""

#. ja: 全員、武器を取れ！<br>お客さんの登場だぞ！
#. de: Zieht die Waffen. Wir haben Ge<shy>sell<shy>schaft.
#. fr: Dégainez vos armes, on a de la visite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8276:0:13"
msgid "Draw your weapons!<br>We've got company!"
msgstr ""

#. ja: クリスタリウムの<br>衛兵団か？
#. de: Wollen wohl die Helden spielen. Irgendwo in Crystarium muss es da ein Nest geben.
#. fr: Les gardes de Cristarium<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8277:0:13"
msgid "Crystarium's got plenty<br>of fools to playact<br>the hero, I see."
msgstr ""

#. ja: 歓迎してやるよッ！！
#. de: Das werd ich denen schon austreiben.
#. fr: On va les recevoir comme y faut<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8278:0:13"
msgid "Always did love<br>a good farce!"
msgstr ""

#. ja: 血祭りにあげてやる！
#. de: Jetzt wird's blutig!
#. fr: On va repeindre le sol avec leur sang<nbsp>!
msgctxt "NpcYell:8279:0:13"
msgid "The bloodier, the better!"
msgstr ""

#. ja: お、覚えてろッ！
#. de: So leicht kommt ihr nicht davon!
#. fr: On se vengera<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8280:0:13"
msgid "Just know that<br>you will never<br>have won."
msgstr ""

#. ja: ひぃ…逃げろっ！
#. de: Rückzug!
#. fr: Vite, on se tire<nbsp>!
msgctxt "NpcYell:8281:0:13"
msgid "Retreat!"
msgstr ""

#. ja: これぞ真のエルフ…<br>紫葉団の力だ！
#. de: Wir sind die Nachtschatten und wir werden siegen!
#. fr: Voilà la vraie puissance des Elfes et des Fanes pourpres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8282:0:13"
msgid "We are Nightshade<br>and we will <i>not</i><br>be forgotten!"
msgstr ""

#. ja: 我らの土地を渡すものかよ！
#. de: Diese Welt gehört uns!
#. fr: On ne vous donnera jamais nos terres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8283:0:13"
msgid "This blighted world is<br><i>our</i> inheritance."
msgstr ""

#. ja: 通報があったのは<br>あの辺りか…
#. de: Laut Einsatzbericht ist das der Ort ...
#. fr: C'est l'endroit dont parlaient nos in<shy>for<shy>ma<shy>tions...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8284:0:13"
msgid "The report mentioned<br>this area..."
msgstr ""

#. ja: 見つけたぞ！<br>無法者の紫葉団だ！
#. de: Da! Nachtschatten!
#. fr: Ils sont là<nbsp>! Ces scélérats de Fanes pourpres<nbsp>!
msgctxt "NpcYell:8285:0:13"
msgid "There! Nightshade!"
msgstr ""

#. ja: 伏兵だと？<br>謀られたのか！？
#. de: Haben die uns etwa aufgelauert?
#. fr: Une embuscade<nbsp>? On nous a tendu un piège<nbsp>?
msgctxt "NpcYell:8286:0:13"
msgid "Were they waiting for us?"
msgstr ""

#. ja: 迎え撃つぞ！
#. de: Spielt doch keine Rolle!
#. fr: On attaque frontalement<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8287:0:13"
msgid "No time to worry<br>about it now!"
msgstr ""

#. ja: なんとか撤退に<br>追い込めたが…
#. de: Wir haben sie vertrieben.
#. fr: On a réussi à les chasser...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8288:0:13"
msgid "We managed to<br>drive them off."
msgstr ""

#. ja: グッ…一時後退…<br>作戦を練り直すぞ…！
#. de: Zurückziehen und neu formieren!
#. fr: Argh... Sonnons la retraite<br>et revoyons notre plan<nbsp>!
msgctxt "NpcYell:8289:0:13"
msgid "Retreat and regroup!"
msgstr ""

#. ja: せいっ！
#. de: Ha!
#. fr: Shaaah<nbsp>!
msgctxt "NpcYell:8290:0:13"
msgid "Hyaaa!"
msgstr ""

#. ja: やるではないか…
#. de: Wunderschön! Zeig mir mehr!
#. fr: Pas mal pour ton âge...
msgctxt "NpcYell:8291:0:13"
msgid "Not bad for an antique..."
msgstr ""

#. ja: クッ…強い…！
#. de: Oh, du bist stark ...
#. fr: Urrrgh... Quelle force<nbsp>!
msgctxt "NpcYell:8292:0:13"
msgid "Ungh... I felt that one."
msgstr ""

#. ja: 回復するわ！
#. de: Heilung, kommt sofort!
#. fr: Je vais te soigner<nbsp>!
msgctxt "NpcYell:8293:0:13"
msgid "Let me take care of that!"
msgstr ""

#. ja: ハァ、ハァ…
#. de: \<keuchf>
#. fr: (souffle)... (souffle)...
msgctxt "NpcYell:8294:0:13"
msgid "Hells' bells..."
msgstr ""

#. ja: う、うう…
#. de: Ack ...
#. fr: Uuugh...
msgctxt "NpcYell:8295:0:13"
msgid "We mustn't give up!"
msgstr ""

#. ja: この技で決めてくれる！
#. de: Was sagst du <i>dazu?!</i> 
#. fr: Il est temps d'en finir<nbsp>!
msgctxt "NpcYell:8296:0:13"
msgid "You are testing my patience."
msgstr ""

#. ja: 砲火をとくと味わえ
#. de: Wie gefällt dir mein Beschuss?
#. fr: Goûte à la puissance de feu de Garlemald<nbsp>!
msgctxt "NpcYell:8297:0:13"
msgid "This calls for Garlean firepower!"
msgstr ""

#. ja: 死ね蛮族めがッ！
#. de: Von Wilden werde ich mich <i>nicht</i> besiegen lassen!
#. fr: Crevez, sales barbares<nbsp>!
msgctxt "NpcYell:8298:0:13"
msgid "Die, savages!"
msgstr ""

#. ja: グハッ…ばか…な…
#. de: Wie kann das ...
#. fr: Hein<nbsp>!?<nbsp>... Mais comm...<nbsp>!?
msgctxt "NpcYell:8299:0:13"
msgid "How dare you!"
msgstr ""

#. ja: ×未使用
#. de: 0
#. fr: 0
msgctxt "NpcYell:8300:0:13"
msgid "0"
msgstr ""

#. ja: 砕け散るがいいッ！
#. de: Ungeziefer wird zerquetscht!
#. fr: Je vais vous réduire en poussière<nbsp>!
msgctxt "NpcYell:8301:0:13"
msgid "There'll be nothing left to bury!"
msgstr ""

#. ja: 私の魔力をオッサンに…！
#. de: Sophie-Magie für dich, mein Alterchen!
#. fr: Radovan, je te donne mon éther<nbsp>!
msgctxt "NpcYell:8302:0:13"
msgid "Radovan, take my aether!"
msgstr ""

#. ja: 我が一族の奥義「女王の盾」！
#. de: Ich bin der Schild der Königin!
#. fr: Je n'ai pas d'autre choix que d'utiliser cette technique ancestrale<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8303:0:13"
msgid "So it's come to this...<br>No choice but to use Final Bastion!"
msgstr ""

#. ja: グフッ…しのげた…か？
#. de: Urgh ... U-Unmöglich ...
#. fr: Ça... ça a marché<nbsp>!
msgctxt "NpcYell:8304:0:13"
msgid "It...held strong."
msgstr ""

#. ja: 仲間が捕まった今<br>起動を急ぐしかないぞい！
#. de: Wir müssen uns beeilen. Das ist unsere Chance, den Tholls eins auszuwischen!
#. fr: C'est le moment ou jamais de l'activer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8305:0:13"
msgid "They have our cousin!<br>Release the TERROR!"
msgstr ""

#. ja: 確認よし！
#. de: Positronenmatrix - Check!
#. fr: Tout est prêt<nbsp>!
msgctxt "NpcYell:8306:0:13"
msgid "Gears oiled!"
msgstr ""

#. ja: チェック完了じゃ～！
#. de: Kreiselstabilisatoren - Einsatzbereit!
#. fr: Vérifications terminées<nbsp>!
msgctxt "NpcYell:8307:0:13"
msgid "Screws tightened!"
msgstr ""

#. ja: 格好いいラリ～！
#. de: Boah, ist DER cool!
#. fr: Lali-ho, quelle classe<nbsp>!
msgctxt "NpcYell:8308:0:13"
msgid "She's beautiful!"
msgstr ""

#. ja: 我々も負けたくないのでのう…
#. de: Mit dem werden wir nie wieder einen Wettbewerb verlieren!
#. fr: Les Tholl n'ont aucune chance<nbsp>!
msgctxt "NpcYell:8309:0:13"
msgid "Witness the dawn of a new era!"
msgstr ""

#. ja: ドワーフの精神が<br>形になったようじゃ！
#. de: Ein in Metall gegossener Zwergengott!
#. fr: C'est le fruit de tant d'années d'efforts...
msgctxt "NpcYell:8310:0:13"
msgid "A marvel of dwarven ingenuity!"
msgstr ""

#. ja: フォーミダブル<br>量産の暁には…
#. de: Den müssen wir in Massenproduktion herstellen, Leute!
#. fr: Bientôt, on les produira en série<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8311:0:13"
msgid "Fire the forges! Tonight we<br>build an army!"
msgstr ""

#. ja: 性能テストには良い機会じゃ<br>やってみせよ～！
#. de: Meinen Berechnungen zufolge wird er die Eisenbärte der Tholls auf einen Yalm zusammenstauchen, haha!
#. fr: Voilà l'occasion rêvée de tester son armement, hé hé...
msgctxt "NpcYell:8312:0:13"
msgid "Turn all dials to 11!"
msgstr ""

#. ja: シャアアアアッ！
#. de: Frah! Fshah!
#. fr: RRRHHAAAA<nbsp>!!!
msgctxt "NpcYell:8313:0:13"
msgid "GRRRRRR!"
msgstr ""

#. ja: シャアッ！
#. de: Shah!
#. fr: Rhaaa<nbsp>!
msgctxt "NpcYell:8314:0:13"
msgid "Graaah!"
msgstr ""

#. ja: 冒険者の諸君は、「フレイムダンス」を踊って、<br>人工ボンバードを支援してくれッ！
#. de: Feuermond-Tänzer, unterstützen wir unseren Knallomaten mit dem Flammentanz!
#. fr: Ô braves aventuriers<nbsp>! Dansez de tout votre soûl<nbsp>! Le bombardo a besoin de plus de puissance<nbsp>!
msgctxt "NpcYell:8315:0:13"
msgid "Brave adventurers, enkindle the flames of the Bombard with your dance!"
msgstr ""

#. ja: くぅ…苦労して作った<br>オートマトンが…
#. de: U-Unser Kunstwerk! \<schnief>
#. fr: Oh non, comment c'est possible<nbsp>!? Pauvre Formidable...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8316:0:13"
msgid "All that work!<br>Reduced to rubble!"
msgstr ""

#. ja: またイチから<br>出直しじゃのう…
#. de: Mist! Alles umsonst ...
#. fr: Des années de travail réduites à néant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8317:0:13"
msgid "Did anyone bother<br>to draft blueprints?"
msgstr ""

#. ja: 今度こそトルーの連中を<br>ギャフンと言わせたいのう…
#. de: Aaah! Die Tholls werden uns mit Häme überschütten!
#. fr: Grrr, maudits Tholl<nbsp>! On reviendra<nbsp>!
msgctxt "NpcYell:8318:0:13"
msgid "We'll be back! Just you wait!"
msgstr ""

#. ja: おお、ダゴンの群れ、<br>いっぱい！
#. de: Eine Dagon-Herde. So viele, fsssh!
#. fr: Un banc de dagons<nbsp>!?
msgctxt "NpcYell:8319:0:13"
msgid "Of all the times for them to appear!"
msgstr ""

#. ja: テウスィー、困った！<br>痕跡、調べられない！
#. de: Ich komme an ihnen nicht vorbei. Sie blockieren den Weg.
#. fr: Il faut toujours qu'ils ssse mettent en travers de notre chemin...
msgctxt "NpcYell:8320:0:13"
msgid "Right on top of the tracks, too..."
msgstr ""

#. ja: ダゴン、どかさないと…！
#. de: Die Dagon sind im Weg ...
#. fr: Je vais devoir trouver un moyen de m'en débarrasser.
msgctxt "NpcYell:8321:0:13"
msgid "No choice but to kill them all. Or have sssomeone else do it..."
msgstr ""

#. ja: 倒す、手伝ってほしい！
#. de: Hilf mir, sie zu beseitigen, <if $gn4>Flossenlose<else>Flossenloser</if>!
#. fr: Pourrais-tu m'aider<nbsp>?
msgctxt "NpcYell:8322:0:13"
msgid "Could you help me?"
msgstr ""

#. ja: ダゴン、気持ち悪い！
#. de: Ich verabscheue Dagon! Psssh!
#. fr: Je détessste les dagons<nbsp>!
msgctxt "NpcYell:8323:0:13"
msgid "I cannot ssstand dagons!"
msgstr ""

#. ja: ニチャニチャ…
#. de: \<zisch>
#. fr: Ssscriiich...
msgctxt "NpcYell:8324:0:13"
msgid "Ssscruuuh..."
msgstr ""

#. ja: チュルチュル…
#. de: \<fauch>
#. fr: Ssschlurrrr...
msgctxt "NpcYell:8325:0:13"
msgid "Sluuurshhh..."
msgstr ""

#. ja: おお、ありがとう！<br>テウスィー、これで痕跡、調べられる！
#. de: Ich danke dir! Die Dagon sind beseitigt. Ich kann meine Jagd nun fortsetzen!
#. fr: Merccci, sssans-branchies<nbsp>! Voyons voir ccce qu'a laissé la bête...
msgctxt "NpcYell:8326:0:13"
msgid "Thank you! Now to investigate those tracks."
msgstr ""

#. ja: ムムム……食い荒らされた跡……？<br>とても、とても、大きな口……やはり、間違いない……。
#. de: Hmmm. Das sind die Überreste von Blutkorallen. Eine ganze Kolonie. Und Spuren ... Sie führen in diese Richtung ...
#. fr: Ccces traccces de dents sssont gigantesssques... L'animal qui les a laissées devait l'être tout autant...
msgctxt "NpcYell:8327:0:13"
msgid "These marks were left by some sort of mouth... A very large one."
msgstr ""

#. ja: 採取した、食べ残し……<br>潮溜まり、持ち帰って、もっともっと、詳しく調べよう……。
#. de: Ich muss den Spuren weiter folgen ...
#. fr: Je vais ramener ccce bout de chair à Baïne afin de l'étudier plus en détail.
msgctxt "NpcYell:8328:0:13"
msgid "These are the remains of itsss prey. This warrants a closer look..."
msgstr ""

#. ja: おお、なんてこと…<br>出直さなければ！
#. de: Ein Fehlschlag. Alles umsonst. Fsssh ...
#. fr: Ccc'est sssans fin<nbsp>! Mieux vaut revenir lorsqu'ils ssse ssseront dissspersssés<nbsp>!
msgctxt "NpcYell:8329:0:13"
msgid "Is there no end to them!?"
msgstr ""

#. ja: おーい！<br>誰かいないか！
#. de: He! Das Nutzholz wehrt sich!
#. fr: Hé, oh<nbsp>! Il y a quelqu'un<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8330:0:13"
msgid "Alack, the timber<br>is fighting back!"
msgstr ""

#. ja: なんてことだ…
#. de: Die Bäume sind verflucht!
#. fr: Ouin... Pourquoi moi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8331:0:13"
msgid "Fie upon these<br>accursed trees!"
msgstr ""

#. ja: うわわっ、大きいの出た！<br>陸人、勝てるよね！？
#. de: Etwas Großes ist aufgetaucht! <if $gn4>Flossenlose<else>Flossenloser</if>, stehst du mir bei?
#. fr: Ouah, il est tout sssimplement énorme<nbsp>!
msgctxt "NpcYell:8332:0:13"
msgid "That is the biggest one I have ever ssseen!"
msgstr ""

#. ja: あれは…<br>フラウンダー！
#. de: Das<nbsp>... Das sind die Flundern!
#. fr: Des Flets<nbsp>!
msgctxt "NpcYell:8333:0:13"
msgid "Benthos!"
msgstr ""

#. ja: しかも、乱暴者、<br>有名なズムスィーいる！
#. de: Und sie sind nicht allein. Der Anführer, Zumshs Aath ist auch dabei!
#. fr: Et lui... C'est Zumshs Aath, la terreur des abysses<nbsp>!
msgctxt "NpcYell:8334:0:13"
msgid "And that is Zumshs Aath Deepdread, the worst of them all!"
msgstr ""

#. ja: テウスィー、戦っても負ける…<br>どうすれば、どうすれば…？
#. de: Ich bin nicht stark genug für diesen Kampf. Was soll ich nur tun?
#. fr: Ssseul, je n'ai aucune chanccce contre lui et ssses sbires...
msgctxt "NpcYell:8335:0:13"
msgid "I do not fancy our chances..."
msgstr ""

#. ja: 導きのヒト…<br>頼ってばかり、申し訳ない…
#. de: <if $gn4>Flossenlose<else>Flossenloser</if>, ein ums andere Mal bitte ich dich um deine Hilfe<nbsp>...
#. fr: Merccci encore, sssans-branchies<nbsp>!
msgctxt "NpcYell:8336:0:13"
msgid "We do not know unlesss we try!"
msgstr ""

#. ja: どうか無事で…<br>海の祝福を…
#. de: Psssh. Mögen dir die Wogen gesonnen sein.
#. fr: Que nos ancccêtres nous protègent<nbsp>!
msgctxt "NpcYell:8337:0:13"
msgid "Spirits of my ancessstors, watch over me!"
msgstr ""

#. ja: 食い荒らした痕跡…
#. de: Eine Ssspur ... Rote Korallenreste ...
#. fr: Regardez, des ressstes...
msgctxt "NpcYell:8338:0:13"
msgid "Red flakes, eh?"
msgstr ""

#. ja: 赤い物質…<br>持ち帰り、調べます…
#. de: Spuren der Bestie. Sie wird die Fremden vertreiben!
#. fr: Et ccces choses rouges... Ramenons-en. Nous devons sssavoir de quoi il sss'agit.
msgctxt "NpcYell:8339:0:13"
msgid "What could they be?"
msgstr ""

#. ja: おお、あの乱暴者、ズムスィー倒すとは……！<br>さすが、導きのヒト……！
#. de: Du hast Zumshs Aath und seine Jäger bezwungen. Du bist wahrlich <if $gn4>eine mächtige Jägerin<else>ein mächtiger Jäger</if>!
#. fr: Incroyable, nous avons mis Zumshs Aath en fuite<nbsp>!
msgctxt "NpcYell:8340:0:13"
msgid "To think that we could triumph over Zumshs Aath Deepdread!"
msgstr ""

#. ja: よし、今回も痕跡、調べてみよう……！
#. de: Ich muss dieser Ssspur weiter folgen<nbsp>...
#. fr: Inssspectons ccce qu'a laissé la bête à notre tour.
msgctxt "NpcYell:8341:0:13"
msgid "Now to examine these marks..."
msgstr ""

#. ja: ムム……この赤い物質、いったい……！？<br>もっともっと、調べる、必要そうだ……。
#. de: Dieses Rot kenne ich irgendwoher. Ich muss herausfinden, um was es sich handelt<nbsp>...
#. fr: Des fragments rouges<nbsp>? Je vais devoir étudier ççça de plus près.
msgctxt "NpcYell:8342:0:13"
msgid "Red fragments of sssome sort... Perhaps the ssstories were true?"
msgstr ""

#. ja: おお、困った…<br>テウスィー、どうすれば…？
#. de: Es ist zum Verzweifeln. Was soll ich nur tun?
#. fr: Fsshhh<nbsp>!!! Fuyez<nbsp>!
msgctxt "NpcYell:8343:0:13"
msgid "I was a fool to even attempt thisss!"
msgstr ""

#. ja: カカカ…痕跡、見つけた！<br>「大口の巨大獣」！
#. de: Ich habe Spuren entdeckt! Spuren von der großen Bestie!
#. fr: Fschaaa<nbsp>! Aucun doute possible<nbsp>!
msgctxt "NpcYell:8344:0:13"
msgid "Yesss! Another ssstep closer to finding that beassst!"
msgstr ""

#. ja: 伝説のアルケオタニア<br>その力、我のモノに…！
#. de: Die sagenumwobene Arachaeotania. Der Schrecken der Tiefsee.
#. fr: Archaeotania est revenue<nbsp>! Et je ssserai ssson maître<nbsp>!
msgctxt "NpcYell:8345:0:13"
msgid "Archaeotania shhhall be mine to command!"
msgstr ""

#. ja: 必ずや支配下治め<br>陸人、根絶やしする！
#. de: <if $gn4>Flossenlose<else>Flossenloser</if>, beende ihre Schreckensherrschaft!
#. fr: Les sssans-branchies ssse prosssterneront devant nous<nbsp>!
msgctxt "NpcYell:8346:0:13"
msgid "Those finless ones shhhall pay!"
msgstr ""

#. ja: グググ…<br>撤退だ、引き上げだ！
#. de: Rückzug!
#. fr: Fschaaa<nbsp>! Incapables<nbsp>! Fuyez<nbsp>!
msgctxt "NpcYell:8347:0:13"
msgid "Ssspineless weaklings, the lot of you! Retreat!"
msgstr ""

#. ja: カカカ…<br>小賢しい！
#. de: \<fauch> Du wagst es!
#. fr: Fschaaa ah ah<nbsp>!
msgctxt "NpcYell:8348:0:13"
msgid "Pathetic!"
msgstr ""

#. ja: 生意気なやつ、め！
#. de: Ihr Flossenlosen seid eine Pest!
#. fr: Je sssuis la terreur des abysses<nbsp>!
msgctxt "NpcYell:8349:0:13"
msgid "You dare challenge me!?"
msgstr ""

#. ja: 出遅れるなよ！
#. de: Nicht unterkriegen lassen!
#. fr: Allez, on se magne<nbsp>!
msgctxt "NpcYell:8350:0:13"
msgid "Do not fall behind!"
msgstr ""

#. ja: うう…カブスの縄張り…<br>いつ、襲われる？
#. de: Wir sind im Revier der Tiefsee-Lunten. Gefährliche Wesen<nbsp>...
#. fr: Le territoire des oléofurors...
msgctxt "NpcYell:8351:0:13"
msgid "Oh, I remember now. Thisss is cubus territory..."
msgstr ""

#. ja: 大丈夫か…？
#. de: Alles in Ordnung?
#. fr: Profitons de leur absssence...
msgctxt "NpcYell:8352:0:13"
msgid "Hmm... The coast ssseems clear."
msgstr ""

#. ja: 急いで、痕跡調べる…！
#. de: Wir müssen weiter der Ssspur folgen.
#. fr: Je vais faire le plus vite possible<nbsp>!
msgctxt "NpcYell:8353:0:13"
msgid "I shhhall make this quick!"
msgstr ""

#. ja: テウスィー、感謝する！<br>導きのヒト、力添えおかげ、調査進んだ！
#. de: Ich danke dir. Die Lunten sind bezwungen und ich kann der Spur weiter folgen. Fsssh.
#. fr: Merccci de m'avoir aidé, sssans-branchies<nbsp>! 
msgctxt "NpcYell:8354:0:13"
msgid "Thanksss to you, I was able to gather some ussseful clues."
msgstr ""

#. ja: 「アルケオタニア」生態……解明できた……！<br>追跡、次の段階、進むことできる！
#. de: Ich habe etwas über Archaeotania gelernt. Eine wichtige Erkenntnis<nbsp>... Ein Jäger muss seinen Feind kennen.
#. fr: Je débusssquerai très bientôt Archaeotania<nbsp>!
msgctxt "NpcYell:8355:0:13"
msgid "It is a matter of time before I find Archaeotania!"
msgstr ""

#. ja: 目的地、もうすぐ…
#. de: Wir sind gleich da<nbsp>...
#. fr: Nous sssommes bientôt arrivés...
msgctxt "NpcYell:8356:0:13"
msgid "Thisss way, I think..."
msgstr ""

#. ja: むおっ！？
#. de: Halte mir die Lunten vom Leib!
#. fr: Fsssarghh<nbsp>!
msgctxt "NpcYell:8357:0:13"
msgid "Ack!"
msgstr ""

#. ja: おおっ！
#. de: Aaah! Ich brauche noch etwas Zeit!
#. fr: Ssssaletés<nbsp>!
msgctxt "NpcYell:8358:0:13"
msgid "Get away from me!"
msgstr ""

#. ja: ムッ…あの者たちは<br>まさか紫葉団！？
#. de: Da! Das sind doch ...!
#. fr: Attendez, c'est les Fanes pourpres<nbsp>?
msgctxt "NpcYell:8359:0:13"
msgid "Look there!"
msgstr ""

#. ja: ひぃっ…！？<br>お助けを…！
#. de: Hm, was, wer, wo? Ah, Hilfe!
#. fr: Aaah<nbsp>! À l'aide<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8360:0:13"
msgid "Hm? What breaks<br>through yonder─ AUGH!"
msgstr ""

#. ja: レイクランドの恵みは<br>我らの物だ！
#. de: Überrascht? Wisse! Das Seenland gehört uns!
#. fr: Donne-nous ta récolte<nbsp>!
msgctxt "NpcYell:8361:0:13"
msgid "You seem awfully surprised."
msgstr ""

#. ja: 紫葉団に<br>差し出すがいい！
#. de: Wird Zeit, dass ihr das begreift.
#. fr: On va te délester un peu<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8362:0:13"
msgid "Did you think we'd<br>just let you go<br>on your merry way?"
msgstr ""

#. ja: これは…なるほど…
#. de: Hm<nbsp>... Interessant<nbsp>...
#. fr: Hmm... Intéressant...
msgctxt "NpcYell:8364:0:13"
msgid "Interesssting..."
msgstr ""

#. ja: 伐採作業中に<br>魔物に囲まれてしまって…
#. de: Ich wurde beim Holzsammeln angegriffen!
#. fr: Je me suis retrouvé encerclé par ces monstres...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8365:0:13"
msgid "Ahem. As I harvested,<br>lonely as a cloud─"
msgstr ""

#. ja: なるほど…<br>この近辺は危険ですからね…
#. de: Ich folgere: Hier ist's gefährlich.
#. fr: Il faut dire que l'endroit est dangereux...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8366:0:13"
msgid "No, let me guess.<br>You were attacked. Again."
msgstr ""

#. ja: 良ければ、このまま<br>護衛させてください
#. de: Soll ich Euch zurück in die schützenden Mauern von Crystarium begleiten?
#. fr: Si vous le souhaitez, je peux aussi vous escorter...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8367:0:13"
msgid "Will you require<br>an escort back<br>to the Crystarium?"
msgstr ""

#. ja: おお、それは助かります！<br>では出発しましょう！
#. de: Ein weiterer Akt der Ritterlichkeit! Das es so etwas noch gibt. Ja, ich bitte darum.
#. fr: Ah, merci<nbsp>! En route<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8368:0:13"
msgid "Ah, chivalry!<br>The truest art.<br>Please do."
msgstr ""

#. ja: やめてくれ～！
#. de: Halt, du Schurkenbold!
#. fr: Arrêtez<nbsp>!!
msgctxt "NpcYell:8369:0:13"
msgid "Stop, villain!"
msgstr ""

#. ja: い、痛いッ！
#. de: Aua, das schmerzt!
#. fr: J'ai mal<nbsp>!
msgctxt "NpcYell:8370:0:13"
msgid "Ow, I say!"
msgstr ""

#. ja: 油断したか…
#. de: Ich hätte besser aufpassen sollen.
#. fr: J'ai été imprudent...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8371:0:13"
msgid "That's what I get<br>for being distracted..."
msgstr ""

#. ja: すまない…<br>撤退する…
#. de: Mehr kann ich nicht tun. Wir sollten fliehen.
#. fr: Pardon... Je me replie...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8372:0:13"
msgid "I can do no more.<br>We must flee!"
msgstr ""

#. ja: い、生きて…いる？<br>助かったのか？
#. de: Atme ich? Lebe ich? Mein Retter sei gepriesen!
#. fr: Je suis en vie<nbsp>? Je suis sauvé<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8373:0:13"
msgid "I have not yet<br>shuffled off this<br>mortal coil? Huzzah!"
msgstr ""

#. ja: 退けることが<br>できたようだな
#. de: Im Moment scheint es sicher.
#. fr: On a réussi à les refouler...
msgctxt "NpcYell:8374:0:13"
msgid "For now, at least."
msgstr ""

#. ja: だが、早く移動した方がいい<br>さあ、こちらへ！
#. de: Doch wir sollten uns sputen. Es könnten mehr auf uns lauern.
#. fr: Mais ne restez pas là. Par ici<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8375:0:13"
msgid "We should make<br>haste lest any<br>more are about."
msgstr ""

#. ja: はいッ！<br>それではまた…！
#. de: Na dann los!
#. fr: Compris<nbsp>! Merci encore<nbsp>!
msgctxt "NpcYell:8376:0:13"
msgid "As you like it!"
msgstr ""

#. ja: よーし！<br>ずらかるぞ！
#. de: Pah! Verzieht euch doch in eure jämmerliche Stadt.
#. fr: Allez, on se tire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8377:0:13"
msgid "Ha! That's right,<br>run back to your<br>precious refuge."
msgstr ""

#. ja: お、覚えてやがれ～！
#. de: Aber merkt euch eins. Ihr seid nirgendwo sicher.
#. fr: Je te revaudrai ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8378:0:13"
msgid "Take your “victory.”<br>Just remember, you'll<br>never be <i>safe.</i>"
msgstr ""

#. ja: いつか…必ず…<br>復讐してやる…
#. de: Und noch etwas: Das Seenland gehört uns! Eines Tages!
#. fr: Un jour... Je me vengerai...<nbsp>!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8379:0:13"
msgid "There's nowhere<br>in this world<br>you can run."
msgstr ""

#. ja: ヒッ、ヒッ！<br>ワシを狩りに来たのか！？
#. de: Hihihi! Wollt ihr mich etwa jagen?
#. fr: Tu pense pouvoir m'avoir<nbsp>? Tu peux toujours rêver, gni hi hi<nbsp>!
msgctxt "NpcYell:8380:0:13"
msgid "Please don't eat me!"
msgstr ""

#. ja: ヒッ、ヒッ、ヒッ！
#. de: Hihihi!
#. fr: Gni hi hi<nbsp>!
msgctxt "NpcYell:8381:0:13"
msgid "This is how I die..."
msgstr ""

#. ja: ヒッ、ヒッ！<br>やってくれたな！
#. de: Hihi! Gar nicht übel!
#. fr: 0
msgctxt "NpcYell:8382:0:13"
msgid "0"
msgstr ""

#. ja: よーし、里に戻って<br>製作作業開始じゃ！
#. de: Hervorragend! Ich muss sofort in die Werkstatt und mit der Konstruktion beginnen!
#. fr: Très bien, j'ai de quoi retourner au village pour travailler<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8383:0:13"
msgid "Lali-ho, lali-ho,♪<br>It's off to work, I go.♪"
msgstr ""

#. ja: 材料がなければ<br>製作できないぞい…
#. de: Ohne Material, kein Eisenbart ... \<schnüff>
#. fr: Je ne peux rien faire, sans matériaux...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8384:0:13"
msgid "Maybe I'll stumble across<br>some ore on the way home..."
msgstr ""

#. ja: 畏れよ、太陽神を！
#. de: Erzittert vor Azim!
#. fr: Tremblez, devant le Dieu-soleil<nbsp>!
msgctxt "NpcYell:8385:0:13"
msgid "Tremble before the Sun!"
msgstr ""

#. ja: ぐ、ぐむむ……血流れて、力抜けて……<br>テウスィー、悔しい……もう、戦えない…………。
#. de: Blut vergossen. Geschwächt. Am Ende. Kann nicht weiter kämpfen<nbsp>... Fsssh<nbsp>...
#. fr: M-mes forccces... m'abandonnent...
msgctxt "NpcYell:8386:0:13"
msgid "It is no good... The Cupsss are doomed..."
msgstr ""

#. ja: 災いを呼ぶ獣、「アルケオタニア」……<br>テウスィー、今日こそ決着、つけるつもり……！
#. de: Heute wird sich das Ssschicksal Arachaeotanias, dem Schrecken der Tiefsee, entscheiden.
#. fr: L'annonccciatriccce du chaos tombera aujourd'hui<nbsp>! Moi, Teushs Ooan, j'en fais le ssserment<nbsp>!
msgctxt "NpcYell:8387:0:13"
msgid "Archaeotania, where are you!?"
msgstr ""

#. ja: 好物の紅血珊瑚、たっぷり使って罠、こしらえた……！<br>あとは、やつが現れる……じっくり待つだけ……！
#. de: Aus den Blutkorallen habe ich einen Köder gefertigt. Jetzt müssen wir nur noch warten, bis sich die Bestie zeigt<nbsp>...
#. fr: Mon appât à base coraux sssanguins est prêt. Nous n'avons plus qu'à l'attendre<nbsp>!
msgctxt "NpcYell:8388:0:13"
msgid "Look! I brought your favorite coral!"
msgstr ""

#. ja: テウスィー、負けない！　絶対、負けない！
#. de: Psssh. Das ist meine Stunde! Ich werde nicht aufgeben!
#. fr: Ccc'est l'heure de vérité<nbsp>! Je ne faillirai pas<nbsp>!
msgctxt "NpcYell:8389:0:13"
msgid "Not when I am ssso close!"
msgstr ""

#. ja: むむっ……！？<br>海獣、けしかけてきた、導きのヒト、気をつけて……！
#. de: Diese Kreatur ist erzürnt! Sei wachsam, <if $gn4>Flossenlose<else>Flossenloser</if>!
#. fr: Des créatures des abysses<nbsp>! Attention, sssans-branchies<nbsp>!
msgctxt "NpcYell:8390:0:13"
msgid "Be careful, finlesss one!"
msgstr ""

#. ja: 早く落ち着かせなければ…！
#. de: Ihr müsst Euch beruhigen, egal, wie schwer Euch das gerade erscheint!
#. fr: Il faut que vous gardiez votre calme<nbsp>!
msgctxt "NpcYell:8391:0:13"
msgid "I must provide what succor I can..."
msgstr ""

#. ja: カカカカカ……誘引の役目、ご苦労だったな……！<br>アルケオタニアは、我らフラウンダーが、従える！
#. de: Sssehr gut! Ihr Verräter wart nützlich. Aber Arachaeotania ist unser! Kehehehe!
#. fr: Fssshhhah ah ah<nbsp>! Bravo<nbsp>! Vous avez amené Archaeotania à moi.
msgctxt "NpcYell:8392:0:13"
msgid "Ha ha! Thanksss for doing our job for usss!"
msgstr ""

#. ja: カカカカカ……やるではないか！<br>だが、まだまだ……深きに潜る我が力を見よ……！
#. de: Ihr seid widerspenstig. Dann sollt ihr nun meine ganze Macht zu spüren bekommen! Kehehe!
#. fr: Fssshhhah ah... Bien joué... Mais je vais te montrer d'où je tiens mon nom<nbsp>!
msgctxt "NpcYell:8393:0:13"
msgid "You think you have me beaten!?"
msgstr ""

#. ja: ぐむっ……しつこい奴らめ……！<br>ヒドロゾア、解き放て……邪魔者どもを倒すのだ……！
#. de: Ihr macht mich rasend! Dann werde ich eben die Hydrozoen auf euch hetzen!
#. fr: Fssshhh<nbsp>!!! Finissons-en<nbsp>! Lâchez l'hydrozoaire<nbsp>!
msgctxt "NpcYell:8394:0:13"
msgid "Release the hydrozoans!"
msgstr ""

#. ja: さあ、あちらに走って…！
#. de: Bringt Euch in Sicherheit, schnell!
#. fr: Fuyez là-bas<nbsp>!
msgctxt "NpcYell:8395:0:13"
msgid "Now go, as fast as you can!"
msgstr ""

#. ja: 軟弱者め…！
#. de: Verräter!
#. fr: Pauvres faibles<nbsp>!
msgctxt "NpcYell:8396:0:13"
msgid "Weak!"
msgstr ""

#. ja: 向こうへ避難を！
#. de: Lasst Euch von dem Mann dort helfen!
#. fr: Réfugiez-vous à l'écart<nbsp>!
msgctxt "NpcYell:8397:0:13"
msgid "Our allies will see you to safety!"
msgstr ""

#. ja: ここは我らの海…！
#. de: Das ist unser Meer!
#. fr: Cccette mer nous appartient<nbsp>!
msgctxt "NpcYell:8398:0:13"
msgid "The Tempessst is ours!"
msgstr ""

#. ja: さ、せる、かぁぁぁッ！
#. de: Nicht ... mit ... mir!
#. fr: Arrière<nbsp>!!!
msgctxt "NpcYell:8399:0:13"
msgid "I think not!"
msgstr ""

#. ja: ヒッ、ヒッ！<br>ひっかかりおったな！
#. de: Hihi! Hab ich dich!
#. fr: 0
msgctxt "NpcYell:8400:0:13"
msgid "0"
msgstr ""

#. ja: むむっ……やはり現れたな、ズムスィー……！
#. de: Zumshs Aath. Dass diese Flunder auftaucht, überrascht mich nicht. Fsssh.
#. fr: Fssshhh<nbsp>! Ccc'est bien ce que je pensssais, il n'était pas loin<nbsp>!
msgctxt "NpcYell:8401:0:13"
msgid "Back for more, Zumshs?"
msgstr ""

#. ja: また来たぁ！？
#. de: Was? Noch mehr?
#. fr: Encore<nbsp>!?
msgctxt "NpcYell:8402:0:13"
msgid "More of them!?"
msgstr ""

#. ja: あわわわ…
#. de: Rettet mich!
#. fr: Ah là là là là...
msgctxt "NpcYell:8403:0:13"
msgid "Oh dear, oh dear..."
msgstr ""

#. ja: これだけあれば<br>バッチリだぞい！
#. de: Das ist genau das, was wir brauchen, tehehe!
#. fr: Lali-hohoho<nbsp>! C'est plus qu'il m'en faut<nbsp>!
msgctxt "NpcYell:8404:0:13"
msgid "That was easier than I thought!"
msgstr ""

#. ja: だが、その前に……<br>さんざん邪魔してくれた、お前、イケニエしてくれよう！
#. de: Aber vorher<nbsp>... Vorher werde ich euch vernichten!
#. fr: Je vais t'offrir en sssacrificcce à elle, faiblard<nbsp>!
msgctxt "NpcYell:8405:0:13"
msgid "We shhhall feed you to Archaeotania!"
msgstr ""

#. ja: 獣を好きにさせるわけ、いかない……！<br>オンドと人、大切な海、テウスィー、守って見せる！
#. de: Sie versuchen, die Bestie zu bändigen und für sich zu gewinnen! Das werde ich nicht zulassen!
#. fr: Je ne laisserai pas la bête vivre plus longtemps<nbsp>! Je protégerai les Ondos, et toute la mer<nbsp>!
msgctxt "NpcYell:8406:0:13"
msgid "You ssseek to control Archaeotania!?"
msgstr ""

#. ja: 支援要請…<br>支援要請…！
#. de: Verstärkung! Verstärkung!
#. fr: Demande de renforts... Demande... renforts<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8407:0:13"
msgid "Requesting reinforcements...<br>Requesting reinforcements..."
msgstr ""

#. ja: とりゃっ！
#. de: Hah! Nimm das!
#. fr: Fssshhhaaa<nbsp>!
msgctxt "NpcYell:8408:0:13"
msgid "Shhhaaagh!"
msgstr ""

#. ja: でやあっ！
#. de: \<zisch>!
#. fr: Fssshhh<nbsp>!!!
msgctxt "NpcYell:8409:0:13"
msgid "Ssserves you right!"
msgstr ""

#. ja: 倒す、倒す！
#. de: Für die Ondo!
#. fr: Meurs<nbsp>!
msgctxt "NpcYell:8410:0:13"
msgid "I will not bow to the likes of you!"
msgstr ""

#. ja: 邪魔する、な！
#. de: Aus dem Weg!
#. fr: Disssparaissez<nbsp>!
msgctxt "NpcYell:8411:0:13"
msgid "Bleed!"
msgstr ""

#. ja: ヌオオン！
#. de: \<kreisch>
#. fr: Fssshhhoooo<nbsp>!
msgctxt "NpcYell:8412:0:13"
msgid "Shhhlaaargh!"
msgstr ""

#. ja: 死ねいっ！
#. de: Stirb!
#. fr: Meurs, faiblard<nbsp>!
msgctxt "NpcYell:8413:0:13"
msgid "Die!"
msgstr ""

#. ja: ま、まいったか……！<br>テウスィーたちの勝ち、だ……！
#. de: Wir haben gesiegt! Die Flundern sssind geschlagen! Psssh.
#. fr: Nous avons réussi<nbsp>!?
msgctxt "NpcYell:8414:0:13"
msgid "Had enough!?"
msgstr ""

#. ja: す、すまない…
#. de: T-Tut mir leid<nbsp>...
#. fr: J-je vous demande pardon...
msgctxt "NpcYell:8415:0:13"
msgid "Th-Thank you..."
msgstr ""

#. ja: ほうほう！
#. de: Hohooo!
#. fr: Lali-ho ho ho<nbsp>!
msgctxt "NpcYell:8416:0:13"
msgid "Impressive!"
msgstr ""

#. ja: ふむ、なるほど…<br>可動部に問題が…
#. de: Hmm. Das sieht aus, wie ein Problem mit dem linken Beinaktuator ...
#. fr: Hmm, petit défaut au niveau des ar<shy>ti<shy>cu<shy>la<shy>tions...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8417:0:13"
msgid "Hm... I may need<br>some bigger cogs..."
msgstr ""

#. ja: 動力の経路を<br>見直すべきじゃろうか？
#. de: Ich muss die Bewegungsroutinen wohl noch einmal neu justieren ...
#. fr: Tout ça manque de motricité<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8418:0:13"
msgid "And the actuator will<br>require additional tuning..."
msgstr ""

#. ja: ラリホー！<br>あの試作機は良いのう！
#. de: Das sieht gut aus! Die vorprogrammierten Angriffsmuster werden korrekt abgerufen!
#. fr: Rien ne vaut un essai en conditions réelles<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8419:0:13"
msgid "Overall, I'd say this test<br>was a rousing success!"
msgstr ""

#. ja: うぅ、いたたたた…
#. de: Ich blute! Und nicht zu knapp!
#. fr: Ouh, aïe aïe aïe...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8420:0:13"
msgid "Ah, I'm bleeding again.<br>Rather heavily!"
msgstr ""

#. ja: どうか気を確かに…<br>止血していますから！
#. de: \<seufz> Warte. Ich drück was drauf.
#. fr: Du calme<nbsp>! Nous avons<br>arrêté l'hémorragie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8421:0:13"
msgid "\\<sigh> Hang on─<br>I'll staunch the wound."
msgstr ""

#. ja: 見ろ、ドラコの群れだ！<br>血の匂いに誘われてきたか！
#. de: Und da sind auch schon die Dracos. Angelockt vom Blut, vielen Dank.
#. fr: Regardez, une horde de dracos<nbsp>!<br>L'odeur du sang les a attirés<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8422:0:13"
msgid "And here come<br>the dracones. Naturally."
msgstr ""

#. ja: ひぃっ！<br>お助けを…！
#. de: Zu Hilfe!
#. fr: Aaah<nbsp>! À l'aide<nbsp>!
msgctxt "NpcYell:8423:0:13"
msgid "Oh dear!"
msgstr ""

#. ja: ぐぬぬ…<br>救援はまだか！
#. de: Kümmere dich nicht weiter um mich. Ich blute hier nur so rum.
#. fr: Argh... Où sont les renforts<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8424:0:13"
msgid "Don't mind me.<br>Just being savaged<br>by dracones here."
msgstr ""

#. ja: なんだと…<br>救えなかったというのか…！
#. de: Dass das immer <i>mir</i> passieren muss!
#. fr: On n'a pas pu le sauver<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8425:0:13"
msgid "Why does this<br><i>always</i> happen to me?"
msgstr ""

#. ja: もう安全ですよ！
#. de: Das war der letzte von ihnen.
#. fr: Vous êtes en sécurité<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8426:0:13"
msgid "That's the<br>last of them!"
msgstr ""

#. ja: どうか、ご安心ください…！
#. de: Keine Sorge. Die Wunde wird heilen.
#. fr: Ne craignez rien<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8427:0:13"
msgid "Don't worry─<br>you'll be fine."
msgstr ""

#. ja: た、助かった…<br>ありがとう、みなさん！
#. de: Wir ziehen dann mal weiter. Wo ist noch mal der Korkenzieher?
#. fr: Je... suis sauvé... Merci<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8428:0:13"
msgid "We'll be on<br>our way! Now<br>where's that knife..."
msgstr ""

#. ja: さあ、拠点に引き上げよう！
#. de: Nein, keine spitzen Gegenstände mehr!
#. fr: Rentrons à la base<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8429:0:13"
msgid "No, no more<br>touching sharp objects!"
msgstr ""

#. ja: ●くっ・・・！
#. de: 0
#. fr: 0
msgctxt "NpcYell:8430:0:13"
msgid "0"
msgstr ""

#. ja: ぐっ！？
#. de: Ha?
#. fr: Urgh<nbsp>!
msgctxt "NpcYell:8431:0:13"
msgid "Damn..."
msgstr ""

#. ja: がはっ…
#. de: Uargh ...
#. fr: (tousse)
msgctxt "NpcYell:8432:0:13"
msgid "Bah!"
msgstr ""

#. ja: 高台で観察しておるぞい！<br>思う存分、やってくれい！
#. de: Ich schaue mir das Ganze besser von einer erhöhten Position an.
#. fr: Je me mets plus en hauteur pour avoir une meilleure vue<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:8433:0:13"
msgid "I shall...ah...observe from<br>someplace...ah...<i>safer</i>. Ta!"
msgstr ""

#. ja: 良いデータが取れたぞい！<br>開発に活かすのじゃ！
#. de: Ich habe tonnenweise Telemetreidaten gewonnen. Sehr gut!
#. fr: Grâce à vous, j'ai toutes les données que je voulais<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8434:0:13"
msgid "Yes, yes! These readings<br>will prove invaluable!"
msgstr ""

#. ja: まだまだ、イケるぜ！
#. de: Es ist noch nicht vorbei!
#. fr: C'est pas encore terminé<nbsp>!
msgctxt "NpcYell:8435:0:13"
msgid "We're not finished yet!"
msgstr ""

#. ja: 魔法を、ぶっ放せ！
#. de: Gebt alles, was ihr habt!
#. fr: Donnez tout ce que vous avez<nbsp>!
msgctxt "NpcYell:8436:0:13"
msgid "Let your magicks fly!"
msgstr ""

#. ja: ●集えエーテル
#. de: 0
#. fr: 0
msgctxt "NpcYell:8437:0:13"
msgid "0"
msgstr ""

#. ja: ●写し映し投影して
#. de: 0
#. fr: 0
msgctxt "NpcYell:8438:0:13"
msgid "0"
msgstr ""

#. ja: ●現れたるは我が虚像
#. de: 0
#. fr: 0
msgctxt "NpcYell:8439:0:13"
msgid "0"
msgstr ""

#. ja: ●やったわね！
#. de: 0
#. fr: 0
msgctxt "NpcYell:8440:0:13"
msgid "0"
msgstr ""

#. ja: まったく…！
#. de: Verdammt!
#. fr: Et zut...
msgctxt "NpcYell:8441:0:13"
msgid "Seven hells!"
msgstr ""

#. ja: ハァ…ハァ…
#. de: Ha ... ha ...
#. fr: Haa... Haa...
msgctxt "NpcYell:8442:0:13"
msgid "\\<pant> \\<pant>"
msgstr ""

#. ja: 駆け続けろ！
#. de: Weiterrennen!
#. fr: Continuez de courir<nbsp>!
msgctxt "NpcYell:8443:0:13"
msgid "Keep going!"
msgstr ""

#. ja: 行け、行け、行け！
#. de: Los, los, los!
#. fr: Courez aussi vite que possible<nbsp>!
msgctxt "NpcYell:8444:0:13"
msgid "Faster!"
msgstr ""

#. ja: さあ、コグーの偏屈者め！<br>ワシの最高傑作と勝負じゃ！
#. de: He, ihr aufgeblasenen Goggs! Wie wäre es mit einem kleinen Wettkampf? Meine Super-Marionette gegen einen eurer Schrotthaufen!
#. fr: Lali-ho, minables Gogg<nbsp>! Vous n'avez aucune chance contre ma merveille<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8445:0:13"
msgid "I am here, foul Goggs!<br>Tremble before my masterpiece!"
msgstr ""

#. ja: な、なんじゃと！？<br>1対1の約束ではないか！
#. de: Na, was sagt ihr? Ein Duell, Eisenbart gegen Eisenbart. Eins gegen eins!
#. fr: Hé, c'est de la triche<nbsp>! On avait dit un contre un<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8446:0:13"
msgid "Wait... One, two, three, four─<br>Dastards! Have you no honor!?"
msgstr ""

#. ja: ゲハハハハ！<br>戦いは数だぞ、愚か者め！
#. de: Willst 'ne dicke Lippe riskieren, was? Aber wenigstens bis zwei zählen kannst du, du Barackenbastler! Ist ja schon mal 'ne Leistung. Haha!
#. fr: Ga ha ha ha<nbsp>! Ton tas de ferraille va se faire écraser<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8447:0:13"
msgid "Bwahahaha! Says the dwarf<br>who brought only one doll!"
msgstr ""

#. ja: 約束など知るか！<br>勝てばよかろうなのだ！
#. de: Also gut! Die Wette gilt! Wenn du verlierst, lachen dich alle Goggs eine Woche lang aus!
#. fr: On avait rien dit du tout<nbsp>! T'es foutu<nbsp>!
msgctxt "NpcYell:8448:0:13"
msgid "All's fair in war...and, well...war!"
msgstr ""

#. ja: 我らのアメイジングな<br>軍団を見るがいい！
#. de: Unsere Donnerfäuste werden deinen Rumpelkasten in einen Schrotthaufen verwandeln!
#. fr: Admire notre armée d'automates destructeurs<nbsp>!
msgctxt "NpcYell:8449:0:13"
msgid "Meet our ARMY!"
msgstr ""

#. ja: そこだ、いけい！
#. de: Hau sie zu Klump, Dampfhammer!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:8450:0:13"
msgid "There's one behind you!"
msgstr ""

#. ja: まだまだやれるぞい！
#. de: Verbieg ihnen die Eisenbärte!
#. fr: Courage, rien n'est perdu<nbsp>!
msgctxt "NpcYell:8451:0:13"
msgid "Watch out!"
msgstr ""

#. ja: 行け、ストライク！
#. de: Dampfhammer! Attacke!
#. fr: Fais honneur aux Tholl<nbsp>!
msgctxt "NpcYell:8452:0:13"
msgid "Duck! Weave! Bob! Shimmy!"
msgstr ""

#. ja: ブッ潰せ！
#. de: Zerlegt den Blecheimer! Donnerfäuste vor!
#. fr: Défoncez cet automate raté<nbsp>!
msgctxt "NpcYell:8453:0:13"
msgid "Between the bolts!"
msgstr ""

#. ja: 叩き壊せ！
#. de: Immer feste drauf!
#. fr: Écrasez-le<nbsp>!
msgctxt "NpcYell:8454:0:13"
msgid "Fire those pistons! Double time!"
msgstr ""

#. ja: ガラクタにしちまえ！
#. de: Reißt ihm die Schrauben einzeln raus!
#. fr: Envoyez-le à la casse<nbsp>!
msgctxt "NpcYell:8455:0:13"
msgid "We'll melt her down to scrap!"
msgstr ""

#. ja: 押せ押せ！<br>数で押し切れー！
#. de: Vorsprung durch Algebra!
#. fr: En formation<nbsp>!
msgctxt "NpcYell:8456:0:13"
msgid "What is one against many!?"
msgstr ""

#. ja: ゲハハハハ！
#. de: Muahahaha!
#. fr: Ga ha ha ha<nbsp>!
msgctxt "NpcYell:8457:0:13"
msgid "Bwahahaha!"
msgstr ""

#. ja: ま、まずいぞ…
#. de: Oh, oh. Das sieht nicht gut aus<nbsp>...
#. fr: Oups, on avait pas prévu ça...
msgctxt "NpcYell:8458:0:13"
msgid "That's not fair! You had help!"
msgstr ""

#. ja: に、逃げろー！<br>撤退だー！
#. de: Wie konnte das bloß passieren? Los, hauen wir ab!
#. fr: Laissez tout tomber, on se fait la malle<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8459:0:13"
msgid "Have you no honor,<br>cheating Tholl!"
msgstr ""

#. ja: き、今日はこのくらいに<br>しておいてやる！
#. de: Schnell weg hier, Jungs, bevor man uns verspottet!
#. fr: Tu t'en tireras pas comme ça, sale Tholl<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8460:0:13"
msgid "You'll pay, interloper!<br>Don't think you won't pay!"
msgstr ""

#. ja: 卑怯者どもめ！<br>恥を知れい！
#. de: Elende Feiglinge! Schämt euch!
#. fr: Bouuuh, bande de tricheurs<nbsp>! Honte sur les Gogg à tout jamais<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:8461:0:13"
msgid "Run, cowards! And next time<br>bring a bigger army!"
msgstr ""

#. ja: ウシシシシ…<br>オイラ登場！
#. de: Ahaa! Unser Verlies hat Besuch! Ausgezeichnet, ausgezeichnet!
#. fr: Hi hi hi hi hi... Me voilà<nbsp>!
msgctxt "NpcYell:8462:0:13"
msgid "Oh, a visitor? Splendid, splendid!"
msgstr ""

#. ja: 誰にもお宝は<br>渡さないぞ～！
#. de: Dann lasst uns doch ein Spiel spielen!
#. fr: Je ne laisserai personne avoir mon trésor<nbsp>!
msgctxt "NpcYell:8463:0:13"
msgid "Perhaps you would be game for a game, yes?"
msgstr ""

#. ja: どっちに<br>行こうかな？
#. de: Es heißt: Töten oder getötet werden!
#. fr: Voyons voir... où aller<nbsp>?
msgctxt "NpcYell:8464:0:13"
msgid "I call it “Kill or Be Killed!”"
msgstr ""

#. ja: 邪魔するヤツは<br>容赦しな～い！
#. de: Die Regeln sind ziemlich einfach: Das Haus gewinnt. Jedes Mal!
#. fr: Pas de pitié pour les gêneurs<nbsp>!
msgctxt "NpcYell:8465:0:13"
msgid "The rules are, as you can imagine, rather simple..."
msgstr ""

#. ja: ツマんな～い！<br>帰ってやる～！
#. de: Keine Lust? Feeeigling! Laaangeweiler!
#. fr: C'est d'un ennui... Bon, je rentre<nbsp>!
msgctxt "NpcYell:8466:0:13"
msgid "Not interested? I can't say I blame you!"
msgstr ""

#. ja: ウシシシシ…<br>遊んでやるぞ～！
#. de: Ahahaa! Was für ein Mordsspaß!
#. fr: Hi hi hi... Amusons-nous un peu<nbsp>!
msgctxt "NpcYell:8467:0:13"
msgid "I have to say, I'm rather good at this game!"
msgstr ""

#. ja: ウヒャヒャ！
#. de: So ist's richtig, so ist's gut!
#. fr: Hi hi ha ha<nbsp>!
msgctxt "NpcYell:8468:0:13"
msgid "Yes, that's the way!"
msgstr ""

#. ja: たのし～い！
#. de: Was für eine Riesengaudi!
#. fr: On s'éclate<nbsp>!
msgctxt "NpcYell:8469:0:13"
msgid "Jolly good show!"
msgstr ""

#. ja: アイタタタ…
#. de: Aua! Das hat weh getan!
#. fr: Aïe, pas si fort<nbsp>!
msgctxt "NpcYell:8470:0:13"
msgid "I say, have you played this before?"
msgstr ""

#. ja: ウシシシシ…<br>逃げるが勝ち～！
#. de: Man soll aufhören, wenn's am schönsten ist. Auf Wiedermorden!
#. fr: Hi hi hi... Essayez un peu de m'attraper<nbsp>!
msgctxt "NpcYell:8471:0:13"
msgid "Well, I think that's enough for one day! Ta-ta for now!"
msgstr ""

#. ja: ンゴアァァァ！
#. de: Grahahooo!
#. fr: Grooooooooh<nbsp>!
msgctxt "NpcYell:8472:0:13"
msgid "Groooooogh!"
msgstr ""

#. ja: グググググ…
#. de: G-Glglglgl!
#. fr: Gugugugugu...
msgctxt "NpcYell:8473:0:13"
msgid "Gagaga-gagagaga-gah!"
msgstr ""

#. ja: ンニャンニャ…
#. de: Grummel, mummel ...
#. fr: Gnagna...
msgctxt "NpcYell:8474:0:13"
msgid "Gruuugh?"
msgstr ""

#. ja: ンガ…<br>ンガンガ…！
#. de: Mrrr ... Mrrrahahooo!
#. fr: Nga... Nga nga<nbsp>!
msgctxt "NpcYell:8475:0:13"
msgid "Grrr... Greeelgh-grooowaaa!?"
msgstr ""

#. ja: ンググググ…
#. de: Gruuuhuhooo ...
#. fr: Ngugugugu...
msgctxt "NpcYell:8476:0:13"
msgid "Nnngggroooh..."
msgstr ""

#. ja: ヴァアアアア！！
#. de: Wuaaaaahhahooo!
#. fr: Wooooooh<nbsp>!
msgctxt "NpcYell:8477:0:13"
msgid "Baaa-bababa-baaargh!"
msgstr ""

#. ja: ヴォオオオオ！！
#. de: Mrrruhuhooo!
#. fr: Graooooh<nbsp>!
msgctxt "NpcYell:8478:0:13"
msgid "Gwoooaaah!"
msgstr ""

#. ja: ンゴッ、ンゴッ！
#. de: Grrrohuhooo!
#. fr: Ngo, ngo<nbsp>!
msgctxt "NpcYell:8479:0:13"
msgid "Hrngh!"
msgstr ""

#. ja: ヴゥゥゥ…
#. de: Urrruruuu ...
#. fr: Wuuuh...
msgctxt "NpcYell:8480:0:13"
msgid "Uuuwhuuu..."
msgstr ""

#. ja: 助かったよ
#. de: Genau zur rechten Zeit!
#. fr: On a eu chaud<nbsp>!
msgctxt "NpcYell:8481:0:13"
msgid "I owe you one."
msgstr ""

#. ja: 皆、大丈夫か？
#. de: Alles in Ordnung bei euch?
#. fr: Tout le monde va bien<nbsp>?
msgctxt "NpcYell:8482:0:13"
msgid "Anyone hurt!?"
msgstr ""

#. ja: こっちよ！
#. de: Kommt hierher!
#. fr: Par ici<nbsp>!
msgctxt "NpcYell:8483:0:13"
msgid "Come to me!"
msgstr ""

#. ja: 必ず仕留めるぞ！
#. de: Ich werd dich erlegen, komme, was wolle!
#. fr: Il faut l'arrêter<nbsp>!
msgctxt "NpcYell:8484:0:13"
msgid "Victory will be ours!"
msgstr ""

#. ja: させるものか！
#. de: Netter Versuch!
#. fr: Ne la laissons pas faire<nbsp>!
msgctxt "NpcYell:8485:0:13"
msgid "No more games!"
msgstr ""

#. ja: うおぉぉぉ！
#. de: Uaaarrr!
#. fr: Uooooh<nbsp>!
msgctxt "NpcYell:8486:0:13"
msgid "Damn you!"
msgstr ""

#. ja: あと少し！
#. de: Gleich haben wir's geschafft!
#. fr: Encore un peu<nbsp>!
msgctxt "NpcYell:8487:0:13"
msgid "We've almost got him!"
msgstr ""

#. ja: みんな、がんばって！
#. de: Gebt alles!
#. fr: On doit tenir bon<nbsp>!
msgctxt "NpcYell:8488:0:13"
msgid "Give it your all!"
msgstr ""

#. ja: おんどりゃ！
#. de: Fahr ins Nichts!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:8489:0:13"
