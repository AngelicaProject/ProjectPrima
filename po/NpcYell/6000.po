#. de: ××◎!
#. fr: ＠Щ■～♪<nbsp>!
msgctxt "NpcYell:6559:0:13"
msgid "××◎～!"
msgstr ""

#. ja: ○□◇！
#. de: ○□◇!
#. fr: ＃Ж⇒★<nbsp>!!!
msgctxt "NpcYell:6560:0:13"
