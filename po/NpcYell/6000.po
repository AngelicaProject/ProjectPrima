msgid "The brave do not fear the grave."
msgstr ""

#. ja: 力を授けるワン！
#. de: Möge das Gemetzel niemals enden.
#. fr: Le carnage ne fait que commencer.
msgctxt "NpcYell:6835:0:13"
msgid "May the carnage never end."
msgstr ""

#. ja: 神通力の加護だニャ！
#. de: Kannst du noch?
#. fr: On est déjà à bout de forces<nbsp>?
msgctxt "NpcYell:6836:0:13"
msgid "You're looking a bit worse for wear!"
msgstr ""

#. ja: ル…ルル…<br>雪ヨ…舞エ…
#. de: ♪ Lalalaleee, tanzender Schnee ♪
#. fr: ♪ Laaa la la... Danse avec moi, douce neige...
msgctxt "NpcYell:6837:0:13"
msgid "Harsh in its silence♪"
msgstr ""

#. ja: ルル…ル…ルル…<br>真白キ、雪…
#. de: ♪ Lalalaleee, schneeweiße See ♪
#. fr: ♪ La laaa la la laaa... Fais choir ton manteau blanc...
msgctxt "NpcYell:6838:0:13"
msgid "It is blizzard and tempest♪"
msgstr ""

#. ja: ルルル…ルル…<br>静寂ノ白…
#. de: ♪ Lalalalill, eiskalt und still ♪
#. fr: ♪ La la laaa la laaa... Enveloppe-moi dans ton silence...
msgctxt "NpcYell:6839:0:13"
msgid "Yet makes not a sound...♪"
msgstr ""

#. ja: やるではないか…
#. de: Seht her, seht her! Gar nicht übel!
#. fr: Bel effort...
msgctxt "NpcYell:6840:0:13"
msgid "Hm. You have some measure of strength, at least."
msgstr ""

#. ja: 我が氷刃の霜となれ！
#. de: Doch alles zerspringt durch meine Klingen!
#. fr: Mes lames vous glaceront le sang<nbsp>!
msgctxt "NpcYell:6841:0:13"
msgid "A pity you will soon be but rime on my blades!"
msgstr ""

#. ja: 来たれ、我が軍団！
#. de: Kommt her, meine Diener!
#. fr: À moi, mes soldats<nbsp>!
msgctxt "NpcYell:6842:0:13"
msgid "To me, my timeless legion!"
msgstr ""

#. ja: ズズズズズ…
#. de: ZZZZZR<nbsp>...
#. fr: MRRRMMMH...
msgctxt "NpcYell:6843:0:13"
msgid "\\<rumble>"
msgstr ""

#. ja: ズズ…ズズズズ…
#. de: ZZZZZR<nbsp>... ZZZR<nbsp>...
#. fr: MRRMH... MRRRMMMH...
msgctxt "NpcYell:6844:0:13"
msgid "\\<rumble> \\<rumble>"
msgstr ""

#. ja: ズズズ…
#. de: ZZZR<nbsp>...
#. fr: MRRMH...
msgctxt "NpcYell:6845:0:13"
msgid "\\<rumble>"
msgstr ""

#. ja: ゴゴゴゴゴゴゴゴゴゴゴゴ……！！
#. de: GRRROOORRRH!
#. fr: GRRRMMMMMM...<nbsp>!!!
msgctxt "NpcYell:6846:0:13"
msgid "GRAAARRRGGGH!"
msgstr ""

#. ja: 人形遊びの時間だぜ！
#. de: Zeit für ein kleines Puppenspiel!
#. fr: C'est l'heure de jouer à la poupée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6863:0:13"
msgid "This should cut you<br>down to size!"
msgstr ""

#. ja: いでよ！<br>雲蒸竜変！
#. de: Hört ihr die Drachen brüllen?
#. fr: Prenez ça... Fléau du dragon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6864:0:13"
msgid "Uh-oh! Someone just<br>woke the dragon..."
msgstr ""

#. ja: くらえ！<br>マサムネ！
#. de: Spürt Masamunes Zorn!
#. fr: Goûtez au tranchant de Masamune<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6865:0:13"
msgid "Not the <i>strongest</i> of swords,<br>but it should suffice."
msgstr ""

#. ja: これが斬魔刀の真の力だぜ！
#. de: Dies ist die wahre Macht von Zanmato!
#. fr: Inclinez-vous devant la toute-puissance de Zanmato<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6866:0:13"
msgid "Behold, the sword art<br>of legend─Zanmato!"
msgstr ""

#. ja: ブチ割るぜ！<br>我流海嵐斬！！
#. de: Erfahrt euer Ende! Fließende Welt!
#. fr: Les mers se fendent pour Gilgamesh<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6867:0:13"
msgid "The seas part for<br>Gilgamesh alone!"
msgstr ""

#. ja: 秘技…我流雪月花！
#. de: Jetzt kommt meine Geheimtechnik!
#. fr: Admirez la beauté mortelle de Neige, Lune et Fleurs<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6868:0:13"
msgid "Divide and conquer,<br>Gilgamesh style!"
msgstr ""

#. ja: うりゃっ、電撃！
#. de: Gleich stehen euch die Haare zu Berge!
#. fr: On dirait bien que vous avez le coup de foudre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:6869:0:13"
msgid "And now for something<br>truly <i>shocking</i>!"
msgstr ""

#. ja: 対象ロスト……<br>自爆装置起動……！
#. de: Ziel verloren<nbsp>...<br>Initiiere Selbstzerstörung<nbsp>...
#. fr: Cible perdue... Autodestruction<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6870:0:13"
msgid "Target lost.<br>Initiating self-destruct mechanism..."
msgstr ""

#. ja: 攻撃の有効性を再評価<br>自爆装置起動……！
#. de: Kampfeffizienz erfordert Neuberechnung<nbsp>...<br>Initiiere Selbstzerstörung<nbsp>...
#. fr: Réévaluation de l'efficacité de l'attaque... Autodestruction<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6871:0:13"
msgid "Reevaluating combat efficacy.<br>Initiating self-destruct mechanism..."
msgstr ""

#. ja: まもなく、新生祭軍事演習を開始する。<br>ほかの参加者が集うまで、いましばらく待機してくれ！
#. de: Die Gedenkschlacht beginnt in Kürze. Habe noch etwas Geduld, bis sich die anderen Teilnehmer versammelt haben.
#. fr: Les manœuvres commenceront lorsque tous les par<shy>ti<shy>ci<shy>pants seront réunis. Veuillez patienter encore un peu, je vous prie<nbsp>!
msgctxt "NpcYell:6872:0:13"
msgid "The training will soon commence. Stand by until all participants are present."
msgstr ""

#. ja: これより、新生祭軍事演習を開始する！
#. de: Hiermit rufe ich den Start der Gedenkschlacht aus!
#. fr: Que les grandes manœuvres commémoratives commencent<nbsp>!
msgctxt "NpcYell:6873:0:13"
msgid "Steel yourselves! The Calamity is upon us!"
msgstr ""

#. ja: まずは、ナル大門へと向かえ！<br>帝国兵の侵攻を阻むのだ！
#. de: Eilt zum Tor des Nald! Schlagt die Eindringlinge in die Flucht!
#. fr: En avant toute, direction la porte de Nald<nbsp>! Nous devons empêcher les Garlemaldais d'avancer<nbsp>!
msgctxt "NpcYell:6875:0:13"
msgid "First, make haste for the Gate of Nald! The Garleans have broken through!"
msgstr ""

#. ja: 力を合わせて迎撃せよ！
#. de: Eint eure Kräfte, um die Gefahr zu bannen!
#. fr: Tous unis contre l'adversité<nbsp>!
msgctxt "NpcYell:6879:0:13"
msgid "Join your strength and meet the enemy as one!"
msgstr ""

#. ja: どうした！<br>冒険者の力はそんなものか！？
#. de: Was ist los? Ist das alles, was ihr zu bieten habt?
#. fr: Eh bien<nbsp>? C'est tout ce dont vous êtes capables<nbsp>?
msgctxt "NpcYell:6880:0:13"
msgid "What's the matter? Is that the best you can do?"
msgstr ""

#. ja: 第七霊災の脅威を、<br>思い起こすのだ！
#. de: Was ist aus den Helden der Siebten Katastrophe geworden?
#. fr: Que le souvenir de ces moments terribles vous donne l'envie de vous battre<nbsp>!
msgctxt "NpcYell:6881:0:13"
msgid "Remember what it is you are fighting to protect!"
msgstr ""

#. ja: エーテライトプラザ方面へ急行せよ！<br>怪力自慢の相手が現れたようだ、油断するなよ！
#. de: Zum Ätherytenplatz! Und seid auf der Hut! Ein besonders gefährlicher Gegner erwartet euch!
#. fr: En avant toute, direction la place de l'Éthérite<nbsp>! Préparez-vous à affronter un ennemi titanesque<nbsp>!
msgctxt "NpcYell:6884:0:13"
msgid "Hurry to the aetheryte plaza, and keep your wits about you! A colossal fiend has appeared!"
msgstr ""

#. ja: なかなかの戦いぶりだったぞ、諸君！<br>これにて新生祭軍事演習を終了とする！
#. de: Ein glorreicher Kampf! Die Gedenkschlacht ist hiermit vorüber.
#. fr: C'étaient de bien belles manœuvres<nbsp>! Toutes mes félicitations<nbsp>!
msgctxt "NpcYell:6885:0:13"
msgid "That concludes the training! Well fought, one and all!"
msgstr ""

#. ja: いよいよ、最後の敵のようだぞ！<br>大型妖異を倒すのだ！
#. de: Es ist fast geschafft, nur noch ein Gegner! Doch der hat es in sich! Kämpft mit allem, was ihr habt!
#. fr: L'ultime ennemi a fait son apparition<nbsp>! Préparez-vous à affronter un être du néant ex<shy>trê<shy>me<shy>ment dangereux<nbsp>!
msgctxt "NpcYell:6886:0:13"
msgid "The final foe comes! Vanquish the enormous voidsent and see Ul'dah saved!"
msgstr ""

#. ja: 正義の心で貫く！
#. de: Die Recht<shy>schaffen<shy>heit wird siegen!
#. fr: La justice vaincra<nbsp>!
msgctxt "NpcYell:6888:0:13"
msgid "This is for your own good!"
msgstr ""

#. ja: モグも演習に参加するクポ～♪<br>誰かひとりに、とっておきの「おまじない」かけちゃうクポ～♪
#. de: Ich mach auch mit, kupo ♪ Ein bisschen Mogry-Magie schadet nie!
#. fr: Laissez-moi vous aider<nbsp>! Une petite incantation ne peut pas vous faire de mal, kupo<nbsp>!
msgctxt "NpcYell:6889:0:13"
msgid "Let me help, kupo! A little moogle magic for one!"
msgstr ""

#. ja: 「おまじない」に選ばれたヒトは、<br>モーグリの力で、みんなを助けるクポ～！
#. de: <if $gn4>Auserwählte<else>Auserwählter</if>! Hilf den anderen mit meiner Magie, kupo!
#. fr: Utilisez le pouvoir des Mogs pour aider vos camarades, kupopo<nbsp>!
msgctxt "NpcYell:6890:0:13"
msgid "Whoever the lucky person is─make it count, kupo!"
msgstr ""

#. ja: <sound 1 51>「限定イベント」の受付を終了いたしました。<br>またのご参加を、お待ちしております！
#. de: <sound 1 51>Die Registrierung für das GATE ist beendet. Wir bedanken uns herzlich für das ent<shy>gegen<shy>ge<shy>brachte Interesse!
#. fr: <sound 1 51>Les ins<shy>crip<shy>tions pour l'attraction spéciale à durée limitée sont terminées. Merci à tous pour votre par<shy>ti<shy>ci<shy>pa<shy>tion, et nous espérons que vous serez encore plus nombreux la prochaine fois<nbsp>!
#. macro: <sound 1 51> — plays a sound effect; kind = 1, sound = 51 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6891:0:13"
msgid "<sound 1 51>Entries for the special limited-time event are now closed.<br>We look forward to your participation in events to come!"
msgstr ""

#. ja: 今こそ、好機！
#. de: Das ist unsere Chance!
#. fr: C'est le moment ou jamais<nbsp>!
msgctxt "NpcYell:6892:0:13"
msgid "I have you now!"
msgstr ""

#. ja: ヒエン…お前が…
#. de: Argh ... Wir sind noch nicht fertig, Hien.
#. fr: On se reverra, Hien...
msgctxt "NpcYell:6893:0:13"
msgid "Ungh... This isn't over, Hien..."
msgstr ""

#. ja: すみやかに散れ…！
#. de: Flieh oder stirb!
#. fr: Disparaissez<nbsp>!
msgctxt "NpcYell:6894:0:13"
msgid "Let us be about it!"
msgstr ""

#. ja: モシカシテ…<br>召喚サレチャッタ！？
#. de: Wer ruft mich da ...?
#. fr: Mais... qu'est-ce que je fais là, moi<nbsp>!?
msgctxt "NpcYell:6895:0:13"
msgid "What!? Oh, a summoning! Ahem..."
msgstr ""

#. ja: 大当タリ♪<br>宝物ヲ、プレゼント♪
#. de: Heute ist euer Glückstag!
#. fr: Bravo<nbsp>! En récompense, voici un beau cadeau<nbsp>!
msgctxt "NpcYell:6896:0:13"
msgid "You've come for treasure, yes? Then treasure you shall have!"
msgstr ""

#. ja: サヨナラ<br>パオ～ン♪
#. de: Und nun ... Hinfort!
#. fr: Au revoir<nbsp>! BRRROA<nbsp>!
msgctxt "NpcYell:6897:0:13"
msgid "0"
msgstr ""

#. ja: 次は、ナナモ新門へと向かえ！<br>魔物や妖異どもを倒すのだ！
#. de: Verteidigt das neue Sultana-Tor gegen die Bestien und Nichts<shy>gesand<shy>ten!
#. fr: À présent, en route pour la porte de Nanamo<nbsp>! Des créatures du néant et des monstres ont envahi la cité<nbsp>!
msgctxt "NpcYell:6907:0:13"
msgid "To the Gate of the Sultana! Dread fiends and voidsent have appeared!"
msgstr ""

#. ja: エーテライトプラザ方面へ急行せよ！<br>都市民の脅威となる大型モルボルを倒すのだ！
#. de: Schnell zum Ätherytenplatz! Ein riesiger Morbol treibt dort sein Unwesen!
#. fr: En avant toute, direction la place de l'Éthérite<nbsp>! Un morbol géant doit être mis hors d'état de nuire im<shy>mé<shy>dia<shy>te<shy>ment<nbsp>!
msgctxt "NpcYell:6909:0:13"
msgid "Make for the aetheryte plaza! A massive morbol is on a rampage!"
msgstr ""

#. ja: さらなる戦いを希望する者は、私の近くで待機するように！<br>次の演習は、約1分後に開始されるぞ！
#. de: Kampfwillige, versammelt euch! Die nächste Gedenkschlacht beginnt in wenigen Augenblicken!
#. fr: Que ceux qui veulent participer aux prochaines manœuvres restent près d'ici<nbsp>! Elles commenceront dans environ une minute<nbsp>!
msgctxt "NpcYell:6911:0:13"
msgid "Those who wish to continue fighting, gather to me. The next session will soon commence."
msgstr ""

#. ja: 己が命を賭して、我が前に立つ者はいるか！？
#. de: Wer will sein Leben verwetten? Wer wagt es, sich mir in den Weg zu stellen?!
#. fr: Qui est prêt à risquer sa vie pour me défier<nbsp>!?
msgctxt "NpcYell:6912:0:13"
msgid "Are there no heroes here to bare their blades against me?"
msgstr ""

#. ja: 剣を取り、魔力を編め！
#. de: Zieht die Waffen blank! Entfacht eure Zauber!
#. fr: Aiguisez vos armes, concentrez votre magie<nbsp>!
msgctxt "NpcYell:6913:0:13"
msgid "Do you all cling to your little lives so?"
msgstr ""

#. ja: 殺意を束ね、その力のすべてを示して見せよ！
#. de: Zeigt keine Gnade! Lasst eure Waffen sprechen!
#. fr: Déchaînez votre instinct meurtrier et montrez-moi de quoi vous êtes capable<nbsp>!
msgctxt "NpcYell:6914:0:13"
msgid "I will help you find freedom in a fight to the death!"
msgstr ""

#. ja: まだ、燃え尽きぬとは……嬉しい驚きと言えような。
#. de: Noch sind die Flammen nicht vollständig erloschen. Überraschend ...
#. fr: J'aurai cru avoir déjà dispersé vos cendres. Quelle heureuse surprise...
msgctxt "NpcYell:6915:0:13"
msgid "You are not yet ash? Impressive."
msgstr ""

#. ja: 認めよう、お前たちが勇士であると！
#. de: Lasst nicht nach, tapfere Krieger!
#. fr: Vous méritez le titre de héros<nbsp>!
msgctxt "NpcYell:6916:0:13"
msgid "Worthy warriors all, I see. No doubt you have dealt many a glorious death."
msgstr ""

#. ja: その健闘を称え、相応しき戦場を用意せん！
#. de: Der Tisch ist angerichtet. Das nenne ich einen köstlichen Kampf! 
#. fr: Notre arène sera à la hauteur de votre vaillance<nbsp>!
msgctxt "NpcYell:6917:0:13"
msgid "I honor you with this battlefield─here shall our souls burn bright!"
msgstr ""

#. ja: ル…ルル…<br>炎ヨ…輝ケ…
#. de: ♪ Lululug, lohendes Inferno und Funkenflug ♪
#. fr: ♪ La la laaa... Ô flammes, brillez, brillez...
msgctxt "NpcYell:6918:0:13"
msgid "Our land lives, its laughter a fiery red.♪"
msgstr ""

#. ja: ルル…ル…ルル…<br>生命ノ、炎…
#. de: ♪ Lululut, flammendes Feuer, lebendige Glut ♪
#. fr: ♪ La la laaa la laaa... Le feu souffle de vie...
msgctxt "NpcYell:6919:0:13"
msgid "A burning being, a blaze at its heart.♪"
msgstr ""

#. ja: ルルル…ルル…<br>躍動ノ赤…
#. de: ♪ Lalalacht, rote Flammen und sengende Pracht ♪
#. fr: ♪ La la laaa la laaa... Le souffle rouge de la vie...
msgctxt "NpcYell:6920:0:13"
msgid "Fan its flames to find us there alight.♪"
msgstr ""

#. ja: キュキュッ！？
#. de: \<miiieeepf>
#. fr: Kiiikiii<nbsp>!?
msgctxt "NpcYell:6923:0:13"
msgid "\\<squeal>"
msgstr ""

#. ja: キュゥゥ…
#. de: \<miepf>
#. fr: Kiii...
msgctxt "NpcYell:6924:0:13"
msgid "\\<whimper>"
msgstr ""

#. ja: キャウゥ～
#. de: \<miepf> \<miepf>
#. fr: Kiihiihii...
msgctxt "NpcYell:6925:0:13"
msgid "\\<squeak>"
msgstr ""

#. ja: カタカタカタ…
#. de: \<blubber> \<zisch>
#. fr: Clac<nbsp>! Clac<nbsp>!
msgctxt "NpcYell:6926:0:13"
msgid "\\<click> \\<click>"
msgstr ""

#. ja: カッチカッチ！
#. de: \<klick> \<klack>
#. fr: Couic<nbsp>! Couic<nbsp>!
msgctxt "NpcYell:6927:0:13"
msgid "\\<click> \\<clack>"
msgstr ""

#. ja: カサカサカサ…
#. de: \<schleif> \<kratz>
#. fr: Chac<nbsp>! Chac<nbsp>!
msgctxt "NpcYell:6928:0:13"
msgid "\\<click> \\<click> \\<click>"
msgstr ""

#. ja: カチカチ…カチッ！
#. de: \<klick> \<klack>
#. fr: Couic<nbsp>! Couic<nbsp>!<nbsp>... Couic<nbsp>!
msgctxt "NpcYell:6929:0:13"
msgid "\\<rumble> \\<clack>"
msgstr ""

#. ja: キュ…キュゥゥ…
#. de: \<miepf> \<miiiepf>
#. fr: Kii... Kiiiii...
msgctxt "NpcYell:6930:0:13"
msgid "\\<squeal> \\<whimper>"
msgstr ""

#. ja: シュウゥゥゥゥ…！
#. de: \<zisssch>
#. fr: Psshhhhhh<nbsp>!
msgctxt "NpcYell:6931:0:13"
msgid "\\<hiss>"
msgstr ""

#. ja: 男性形態…<br>システム正常…
#. de: Maskuline Form<nbsp>...<br>System stabil<nbsp>...
#. fr: Forme masculine...<br>État du système normal...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6932:0:13"
msgid "Omega-M configuration.<br>Systems nominal."
msgstr ""

#. ja: 女性形態…<br>システム正常…
#. de: Feminine Form<nbsp>...<br>System stabil<nbsp>...
#. fr: Forme féminine...<br>État du système normal...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6933:0:13"
msgid "Omega-F configuration.<br>Systems nominal."
msgstr ""

#. ja: シールドオプション…<br>ロードします…
#. de: Lade Schildoption<nbsp>...
#. fr: Bouclier optionnel...<br>Chargement en cours...
msgctxt "NpcYell:6934:0:13"
msgid "Shield fabrication initiated..."
msgstr ""

#. ja: ブレードオプション…<br>ロードします…
#. de: Lade Klingenoption<nbsp>...
#. fr: Lame optionnelle...<br>Chargement en cours...
msgctxt "NpcYell:6935:0:13"
msgid "Blade fabrication initiated..."
msgstr ""

#. ja: 判定…<br>脅威度を再計算…
#. de: Neuberechnung des Gefahrenpotenzials<nbsp>...
#. fr: Réévaluation du niveau de menace...
msgctxt "NpcYell:6936:0:13"
msgid "Recalculating threat level..."
msgstr ""

#. ja: 標的…<br>攻撃を実行します
#. de: Angriffsmodus<nbsp>...
#. fr: Cible verrouillée, attaque enclenchée...
msgctxt "NpcYell:6937:0:13"
msgid "Neutralizing target..."
msgstr ""

#. ja: 戦術プログラム…<br>再調整…
#. de: Rekalibriere Angriffsprogramm<nbsp>...
#. fr: Révision du programme de combat...
msgctxt "NpcYell:6938:0:13"
msgid "Recalibrating combat logic..."
msgstr ""

#. ja: 修正…<br>姿勢制御プログラム…
#. de: Rekalibriere Positionskontrolle<nbsp>...
#. fr: Lancement du programme de contrôle d'apparence...
msgctxt "NpcYell:6939:0:13"
msgid "Adjusting equilibrium..."
msgstr ""

#. ja: 実行…<br>さらなる攻撃…
#. de: Erweiterter Angriffsmodus<nbsp>...
#. fr: Nouvelle attaque...
msgctxt "NpcYell:6940:0:13"
msgid "Launching attack sequence..."
msgstr ""

#. ja: 確認…不可解な行動…<br>非効率的な戦い方です
#. de: Registriere uneffektive Kampfweise<nbsp>...
#. fr: Action incom<shy>pré<shy>hen<shy>si<shy>ble, méthode de combat inefficace...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6941:0:13"
msgid "Irrational behavior observed.<br>Inefficient energy expenditure."
msgstr ""

#. ja: 推奨…<br>連携攻撃…
#. de: Initialisiere Kettenangriff<nbsp>...
#. fr: Attaque coordonnée recommandée...
msgctxt "NpcYell:6942:0:13"
