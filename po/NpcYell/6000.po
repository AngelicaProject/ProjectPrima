msgid "Grrrrrr..."
msgstr ""

#. ja: 受けるがいい！
#. de: Nieder mit dir!
#. fr: Évite celle-là<nbsp>!
msgctxt "NpcYell:6831:0:13"
msgid "Down with you!"
msgstr ""

