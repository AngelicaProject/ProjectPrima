#. ja: がんばるっぺよ！
#. de: Nichts kann uns aufffhalten!
#. fr: Rien ne nous arrêtera<nbsp>!
msgctxt "NpcYell:6388:0:13"
msgid "The vase will be ours!"
msgstr ""

#. ja: どんどん進むっぺよ！
#. de: Los, weiter!
#. fr: On continue<nbsp>!
msgctxt "NpcYell:6389:0:13"
msgid "Come, let us keep moving."
msgstr ""

#. ja: 行くっぺな！
#. de: Aufff geht's!
#. fr: On avance<nbsp>!
msgctxt "NpcYell:6390:0:13"
msgid "Eyes on the prize!"
msgstr ""

#. ja: ま、待つっぺよ～！
#. de: Wart aufff mich!
#. fr: A-attendez-moi<nbsp>!
msgctxt "NpcYell:6391:0:13"
msgid "I-I'll just wait over here."
msgstr ""

#. ja: 敵っぺな！？
#. de: Man greiffft uns an!?
#. fr: On nous attaque<nbsp>!?
msgctxt "NpcYell:6392:0:13"
msgid "Look out!"
msgstr ""

#. ja: 足が震えるっぺよ…
#. de: M-Meine Ffflossen zittern!
#. fr: Brr<nbsp>! J'ai peur<nbsp>!
msgctxt "NpcYell:6393:0:13"
msgid "My legs are about to give out."
msgstr ""

#. ja: 早く倒してほしいっぺよ…
#. de: Mach sie fffertig!
#. fr: Tuez-les vite<nbsp>!
msgctxt "NpcYell:6394:0:13"
msgid "Hurry up and win!"
msgstr ""

#. ja: た、助けてほしいっぺよ…
#. de: Hilfffe!
#. fr: Au secours<nbsp>! Aidez-moi<nbsp>!
msgctxt "NpcYell:6395:0:13"
msgid "Help me! I'm dying!"
msgstr ""

#. ja: がんばるっちゃ！
#. de: Qiqirn anstrengen!
#. fr: Qiqirn pas avoir peur<nbsp>!
msgctxt "NpcYell:6396:0:13"
msgid "Time to go!"
msgstr ""

#. ja: 気合入れるっちゃ！
#. de: Schöne Wanderung!
#. fr: Qiqirn montrer aux méchants<nbsp>!
msgctxt "NpcYell:6397:0:13"
msgid "No give up!"
msgstr ""

#. ja: 急ぐっちゃ！
#. de: Los, schnell!
#. fr: Vite vite<nbsp>!
msgctxt "NpcYell:6398:0:13"
msgid "Hurry!"
msgstr ""

#. ja: 待ってっちゃ！
#. de: He, warten!
#. fr: Attendre, attendre<nbsp>!
msgctxt "NpcYell:6399:0:13"
msgid "Slow down!"
msgstr ""

#. ja: 敵がいるっちゃ！
#. de: Qiqirn Angst haben!
#. fr: Méchants très méchants<nbsp>!
msgctxt "NpcYell:6400:0:13"
msgid "No no no!"
msgstr ""

#. ja: ぶるぶるっちゃ…
#. de: O weh ...
#. fr: Qiqirn pas sentir bien...
msgctxt "NpcYell:6401:0:13"
msgid "Oh, so scary..."
msgstr ""

#. ja: やっつけてっちゃ…
#. de: Böse Angreifer fertigmachen!
#. fr: Qiqirn taper fort<nbsp>!
msgctxt "NpcYell:6402:0:13"
msgid "Slay bad ones!"
msgstr ""

#. ja: 助けてっちゃ…
#. de: Hilfe!
#. fr: Aider Qiqirn...
msgctxt "NpcYell:6403:0:13"
msgid "Help!"
msgstr ""

#. ja: その申し出に感謝する！<br>よし、打って出るぞ！
#. de: Danke! Zeigen wir's den Biestern!
#. fr: On va leur mettre une bonne raclée<nbsp>!
msgctxt "NpcYell:6404:0:13"
msgid "After you, then!"
msgstr ""

#. ja: そうか、力を貸してくれるか！
#. de: Du hilfst mir?
#. fr: Votre aide est la bienvenue<nbsp>!
msgctxt "NpcYell:6405:0:13"
msgid "Then you are with us!"
msgstr ""

#. ja: この出会いを、壊神ラールガーに感謝しよう！
#. de: Dank sei Rhalgr, dass er dich zu mir führte!
#. fr: C'est Rhalgr qui vous a <if $gn4>amenée<else>amené</if> à moi.
msgctxt "NpcYell:6406:0:13"
msgid "May Rhalgr grant us strength!"
msgstr ""

#. ja: そうか、力を貸してくれるか！
#. de: Du hilfst mir?
#. fr: Votre aide est la bienvenue<nbsp>!
msgctxt "NpcYell:6407:0:13"
msgid "Then you are with us!"
msgstr ""

#. ja: この出会いを、壊神ラールガーに感謝しよう！
#. de: Dank sei Rhalgr, dass er dich zu mir führte!
#. fr: C'est Rhalgr qui vous a <if $gn4>amenée<else>amené</if> à moi.
msgctxt "NpcYell:6408:0:13"
msgid "May Rhalgr grant us strength!"
msgstr ""

#. ja: 先へ進もうか
#. de: Können wir los?
#. fr: On y va<nbsp>?
msgctxt "NpcYell:6409:0:13"
msgid "Shall we get going?"
msgstr ""

#. ja: 剣がないと落ち着かないな
#. de: Ohne Schwert fühle ich mich irgendwie nackt.
#. fr: Hm, j'aurais peut-être dû prendre mon sabre en fait...
msgctxt "NpcYell:6410:0:13"
msgid "Maybe I should have brought my sword..."
msgstr ""

#. ja: 疲れてないか？
#. de: Brauchst du eine Pause?
#. fr: Ça va, tu tiens le coup<nbsp>?
msgctxt "NpcYell:6411:0:13"
msgid "Do you need to rest?"
msgstr ""

#. ja: おっ、おい！<br>待ってくれ！
#. de: Halt, nicht so schnell!
#. fr: Hé, attends-moi<nbsp>!
msgctxt "NpcYell:6412:0:13"
msgid "Wait, not so fast!"
msgstr ""

#. ja: くそっ、敵だ！
#. de: Der hat es auf uns abgesehen!
#. fr: J'ai besoin d'aide<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:6413:0:13"
msgid "<split \" \" 1><string $gs1></split>, your help!"
msgstr ""

#. ja: 俺が不甲斐ないばかりに…
#. de: Könnte ich doch bloß besser kämpfen ...
#. fr: J'en ai ras le bol d'être toujours impuissant...
msgctxt "NpcYell:6414:0:13"
msgid "If only I were stronger..."
msgstr ""

#. ja: 申し訳ないが<br>追っ払ってくれ…！
#. de: <split " " 1><string $gs1></split>, dein Einsatz!
#. fr: Mince... <split " " 1><string $gs1></split>, occupe-t-en<nbsp>!
msgctxt "NpcYell:6415:0:13"
msgid "Another beast blocks our path."
msgstr ""

#. ja: ううっ、このままじゃ…
#. de: Viel mehr halte ich nicht aus ...
#. fr: Je ne vais pas tenir longtemps à ce rythme...
msgctxt "NpcYell:6416:0:13"
msgid "I cannot carry on much longer..."
msgstr ""

#. ja: ん～<br>いい景色♪
#. de: Klasse Strand! Genau wie im Prospekt beschrieben!
#. fr: Ah... La merrr à perte de vue. Comme c'est beau<nbsp>!
msgctxt "NpcYell:6417:0:13"
msgid "What an amazing place!"
msgstr ""

#. ja: ここが常夏の島…
#. de: Und das Wasser so klar!
#. fr: Il fait si chaud ici... Et dirrre que c'est comme ça toute l'année<nbsp>!
msgctxt "NpcYell:6418:0:13"
msgid "So this is the Isle of Endless Summer. Beautiful."
msgstr ""

#. ja: 今日は泳ぐぞ～！
#. de: Lass uns 'ne Runde schwimmen gehen!
#. fr: On se jette à l'eau<nbsp>?
msgctxt "NpcYell:6419:0:13"
msgid "Today, we swim!"
msgstr ""

#. ja: ちょっと待ってよ～
#. de: Prima Idee!
#. fr: La premièrrre à la bouée...<nbsp>!
msgctxt "NpcYell:6420:0:13"
msgid "Wait for me!"
msgstr ""

#. ja: ふっしっしっしっ……<br>かわいい女の子がいっぱい、わいのこのみや……ポッ。
#. de: Hohohohoho. Eine hübscher als die andere!
#. fr: Hi hi hi... Les femmes ici sont toutes plus jolies les unes que les autres<nbsp>!
msgctxt "NpcYell:6421:0:13"
msgid "Oh me, oh my, look at all these lovely little things out today. And they're all just my type."
msgstr ""

#. ja: ん？<br>何か聞こえたような…
#. de: Hm? Hast du das auch gehört?
#. fr: Hein<nbsp>? J'ai entendu quelque chose, pas toi<nbsp>?
msgctxt "NpcYell:6422:0:13"
msgid "What was that? I could have sworn I heard something."
msgstr ""

#. ja: 気のせいじゃない？
#. de: Was denn?
#. fr: C'est sans doute la chaleurrr qui te monte à la tête...
msgctxt "NpcYell:6423:0:13"
msgid "You're imagining things."
msgstr ""

#. ja: うひょひょ！<br>女の子たち、わいと遊ぼうや～！
#. de: He, Mädels! Hier ist euer Bademeister!
#. fr: Ho ho ho<nbsp>! Allez les filles, venez jouer avec votre nouveau meilleur ami<nbsp>!
msgctxt "NpcYell:6424:0:13"
msgid "Hey, ladies! Care to come have a romp with me?"
msgstr ""

#. ja: きゃ～！
#. de: Igitt!
#. fr: Haaa<nbsp>!
msgctxt "NpcYell:6425:0:13"
msgid "Eeeeeek!"
msgstr ""

#. ja: ここは、逃がさないよ～！<br>イジワル、イジワル？
#. de: Kommt in meine starken Fangarme<nbsp>♪
#. fr: Pourquoi vous partez<nbsp>? Revenez, mes belles<nbsp>!
msgctxt "NpcYell:6426:0:13"
msgid "Don't be shy, now. There's no use running away!"
msgstr ""

#. ja: しゃべるタコ！？<br>新手の妖異か…？
#. de: Aus dir mach ich Tintenfischringe!
#. fr: Une pieuvre qui parle<nbsp>!? Qu'est-ce que c'est que cette histoire<nbsp>?
msgctxt "NpcYell:6427:0:13"
msgid "A talking octopus!? Is this some new voidsent!?"
msgstr ""

#. ja: きんにくモリモリ……嫌いだ～！
#. de: Du halbe Portion?
#. fr: Va-t'en, vilain musclé<nbsp>! Tu fais peur aux filles<nbsp>!!
msgctxt "NpcYell:6428:0:13"
msgid "Ugh, all those muscles. You're not my type!"
msgstr ""

#. ja: われとてタコのはしくれ！<br>お前なんかに負けはしないぞ！　しょーぶだ！！
#. de: Du wirst dir ein paar Fangarme fangen, das wirst du!
#. fr: Pourquoi vous vous en prenez à une petite pieuvre inoffensive<nbsp>!? Si vous me cherchez, vous allez me trouver<nbsp>!
msgctxt "NpcYell:6429:0:13"
msgid "I may be just an octopus, but I'll not lose to the likes of you!"
msgstr ""

#. ja: う、また負けちゃうかも……<br>テュポーン大先生、そろそろ来て～！
#. de: Uiui, das sieht nicht gut aus ... Meister Typhon, ich brauch Eure Hilfe!
#. fr: Aaah<nbsp>! J'ai mal... Je souffre...<nbsp>! Venez m'aider, Maître Typhon<nbsp>!
msgctxt "NpcYell:6430:0:13"
msgid "This is not looking good... Oh no, I forgot to call Master Typhon."
msgstr ""

#. ja: って、しまった～！<br>大先生を誘うの、忘れてた～！！
#. de: Ach, Mist! Den hab ich ja zuhause vergessen!
#. fr: ... Ho<nbsp>! Je crois que j'ai oublié de l'inviter. Oups<nbsp>!
msgctxt "NpcYell:6431:0:13"
msgid "Master Typhon! Heeelp meee!"
msgstr ""

#. ja: フンッ！
#. de: Calamaaari!
#. fr: Sale chose visqueuse<nbsp>!
msgctxt "NpcYell:6432:0:13"
msgid "Hyah!"
msgstr ""

#. ja: 迷惑行為は<br>止めるんだ！
#. de: Lass deine Saugnäpfe von diesen Schönheiten!
#. fr: Tu vas voir quel sort on réserve à ceux qui viennent gâcher la fête<nbsp>!
msgctxt "NpcYell:6433:0:13"
msgid "You'll not ruin our faire!"
msgstr ""

#. ja: グッ…！
#. de: In die Weichteile!
#. fr: Rah<nbsp>!
msgctxt "NpcYell:6434:0:13"
msgid "Argh!"
msgstr ""

#. ja: グェグェ……ガボガボガボ……<br>まいった、まいった！
#. de: \<schnief> ... \<schnüff><br>Das ... ist nicht fair!
#. fr: A-arrêtez... P-pitié... Je m'avoue vaincu<nbsp>!
msgctxt "NpcYell:6435:0:13"
msgid "Ow, ow, ow! Enough, enough!"
msgstr ""

#. ja: もうかんにんして～！<br>わいも紅蓮祭……楽しみたかっただけなんや……。
#. de: Ich wollte doch nur das Fest genießen.
#. fr: Pardonnez-moi... Je voulais juste profiter des Feux de la Mort avec vous...
msgctxt "NpcYell:6436:0:13"
msgid "I yield, I yield! I just wanted...to enjoy the faire...like everyone else."
msgstr ""

#. ja: そうは言ってもな…
#. de: Alles Ansichtssache.
#. fr: Que tu dis...
msgctxt "NpcYell:6437:0:13"
msgid "I find that hard to believe."
msgstr ""

#. ja: 大人しくするって、約束するから……<br>見逃したって～な！
#. de: Bitte, tu mir nichts! Ich bin auch jetzt ganz artig!
#. fr: Je vous promets de bien me tenir si vous acceptez de passer l'éponge<nbsp>!
msgctxt "NpcYell:6438:0:13"
msgid "I promise I'll be good. I swear!"
msgstr ""

#. ja: 本当だな！？<br>今度、暴れたら許さんぞ
#. de: Also gut, einmal lass ich dich noch gewähren. Aber beim nächsten Mal landest du in der Fritteuse!
#. fr: Bon... d'accord. Mais gare à toi si tu recommences<nbsp>!
msgctxt "NpcYell:6439:0:13"
msgid "Do you? Step out of line again, and you won't get off so easy."
msgstr ""

#. ja: うひょひょ！<br>やくそく、やくそく……だってタコだもん！
#. de: Alles, nur das nicht! Ich hab eh schon so fettige Haut!
#. fr: Promis juré<nbsp>! Une pieuvre comme moi ne mentirait jamais...<nbsp>!
msgctxt "NpcYell:6440:0:13"
msgid "Gwee-hee-hee. I promise, I promise. An octopus always keeps his word."
msgstr ""

#. ja: うひょひょ！<br>かわいい女の子…
#. de: Mann, sind die süß<nbsp>...
#. fr: Oh là là... Que les femmes sont belles ici.
msgctxt "NpcYell:6441:0:13"
msgid "Gwee-hee-hee! Such pretty little things!"
msgstr ""

#. ja: ふっしっしっ…<br>わいのこのみや…
#. de: So hab ich's gerne.
#. fr: Je les trouve toutes à mon goût...
msgctxt "NpcYell:6442:0:13"
msgid "Mwa ha ha! Just my type!"
msgstr ""

#. ja: ほな…<br>さよなら、さよなら！
#. de: Bis bald, meine Hübschen<nbsp>♪
#. fr: ... mais je dois vous laisser<nbsp>!
msgctxt "NpcYell:6443:0:13"
msgid "Farewell, farewell!"
msgstr ""

#. ja: 気にくわんから<br>邪魔してやるけんね
#. de: Lasst euch das eine Lehre sein!
#. fr: J'en ai assez. Je vais voir ailleurs si j'y suis<nbsp>!
msgctxt "NpcYell:6444:0:13"
msgid "I can't be bothered with this anymore!"
msgstr ""

#. ja: うひょひょ！<br>女の子ど～こだっ！
#. de: \<glubsch> ...?! W-Wo sind die Mädels hin?!
#. fr: Où sont les femmes<nbsp>? Avec leurs gestes pleins de charme<nbsp>?
msgctxt "NpcYell:6445:0:13"
msgid "Gwee-hee-hee! Where are all the laaadies!?"
msgstr ""

#. ja: 大漁間違いなし！<br>釣り餌はいらんかね～！
#. de: Garantierte Jahrhundertfänge mit meinen Ködern!
#. fr: Il y a de quoi faire de belles prises ici. Vous avez assez d'appâts<nbsp>?
msgctxt "NpcYell:6446:0:13"
msgid "The big ones are biting! Need any bait?"
msgstr ""

#. ja: ひとつもらえるかね？
#. de: Ich hätte gern einen.
#. fr: Non... Je vous en prendrais bien une boîte si vous en vendez.
msgctxt "NpcYell:6447:0:13"
msgid "Could you stand to part with one of those?"
msgstr ""

#. ja: 毎度あり！<br>100万ギルになります♪
#. de: Mit Vergnügen! Das macht dann 1.000.000 Gil.
#. fr: Ça fera 1 000 000 de gils, merci<nbsp>!
msgctxt "NpcYell:6448:0:13"
msgid "That'll be 1,000,000 gil!"
msgstr ""

#. ja: ふ、ふざけるな！<br>そんなに高額なわけは…
#. de: Soll das 'n Witz sein?!
#. fr: C-combien<nbsp>? Qui serait prêt à payer ce prix-là<nbsp>!?
msgctxt "NpcYell:6449:0:13"
msgid "You're out of your mind!"
msgstr ""

#. ja: 難癖つけようってのか！？<br>アァン！？
#. de: Seh ich aus, als mache ich Witze? Hm?
#. fr: Vous passez commande et vous faites des histoires pour payer<nbsp>!? Ça ne va pas se passer comme ça<nbsp>!
msgctxt "NpcYell:6450:0:13"
msgid "You blaming me? Huh!?"
msgstr ""

#. ja: か、帰らせてもらう！
#. de: Äh, ich glaub, ich geh mal.
#. fr: Laissez-moi tranquille, Monsieur<nbsp>!
msgctxt "NpcYell:6451:0:13"
msgid "I'll take my business elsewhere."
msgstr ""

#. ja: 支払い拒否か？<br>おい、野郎ども！
#. de: Aha, vorm Bezahlen drücken, was? Jungs! Hier ist ein säumiger Kunde!
#. fr: Vous croyez que je vais vous laisser vous en tirer comme ça<nbsp>!? Hé les gars, écoutez un peu<nbsp>!
msgctxt "NpcYell:6452:0:13"
msgid "Trying to make off without paying? Get back here, you bastard!"
msgstr ""

#. ja: おうおう、痛い目みてぇのか？
#. de: Der wird die Kohle schon rausrücken!
#. fr: On cherche la bagarre, j'ai l'impression<nbsp>!
msgctxt "NpcYell:6453:0:13"
msgid "You looking to get yourself hurt?"
msgstr ""

#. ja: や、やめてくれ！
#. de: He, lasst das!
#. fr: Vous allez me laisser tranquille, oui<nbsp>!?
msgctxt "NpcYell:6454:0:13"
msgid "S-Stop it!"
msgstr ""

#. ja: そこの男たち！<br>何をしている！？
#. de: Was soll dieser Lärm?!
#. fr: On peut savoir où est le problème<nbsp>?
msgctxt "NpcYell:6455:0:13"
msgid "You two! What's going on!?"
msgstr ""

#. ja: チッ…うるさい奴らめ…<br>やっちまうぞ！
#. de: Auf die hätt ich verzichten können.
#. fr: Pfff... De quoi il se mêle, lui. Ça va chauffer<nbsp>!
msgctxt "NpcYell:6456:0:13"
msgid "Bah, damned faire chaperones. Come on!"
msgstr ""

#. ja: 任せたぞ、お前たち…！
#. de: Jungs, ich zähl auf euch!
#. fr: Allez les gars, amusez-vous bien. Moi, j'ai à faire<nbsp>!
msgctxt "NpcYell:6457:0:13"
msgid "I'm leaving this fight to you!"
msgstr ""

#. ja: ひええっ～
#. de: Ihr kommt sicher ohne mich klar!
#. fr: Ahhh<nbsp>!
msgctxt "NpcYell:6458:0:13"
msgid "Run awaaay!"
msgstr ""

#. ja: オラオラ！
#. de: Kommt zu Papa!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:6459:0:13"
msgid "Hyah!"
msgstr ""

#. ja: なめるなよ！
#. de: Jetzt setzt's Schläge!
#. fr: Tu vas voir<nbsp>!
msgctxt "NpcYell:6460:0:13"
msgid "Take that!"
msgstr ""

#. ja: 邪魔すんな！
#. de: Sag hallo zu meiner Axt!
#. fr: Ouste<nbsp>!
msgctxt "NpcYell:6461:0:13"
msgid "Go back to your damn faire!"
msgstr ""

#. ja: フンッ！
#. de: En garde!
#. fr: Humpf<nbsp>!
msgctxt "NpcYell:6462:0:13"
msgid "Arrrgh!"
msgstr ""

#. ja: 大人しくしろ！
#. de: Nicht an meinem Strand!
#. fr: Vous n'avez pas honte de votre com<shy>por<shy>te<shy>ment<nbsp>!?
msgctxt "NpcYell:6463:0:13"
msgid "Stop this at once!"
msgstr ""

#. ja: いい加減にするんだ！
#. de: Das werdet ihr büßen!
#. fr: Arrêtez ça tout de suite<nbsp>!
msgctxt "NpcYell:6464:0:13"
msgid "Stand down!"
msgstr ""

#. ja: つ、強いぞ…<br>退け、退け～！
#. de: Die müssen gedopt sein! Nichts wie weg!
#. fr: I-ils sont trop forts... On s'en va<nbsp>!
msgctxt "NpcYell:6465:0:13"
msgid "These bastards are strong... Retreat! Retreat!"
msgstr ""

#. ja: 邪魔しやがって<br>あの客を追うぞ！
#. de: Und jetzt knöpfen wir uns diesen Geizhals vor!
#. fr: Tout ça, c'est la faute de l'autre pêcheur. Retrouvons-le<nbsp>!
msgctxt "NpcYell:6466:0:13"
msgid "Serves you right for not minding your business. Come on, after that fisherman!"
msgstr ""

#. ja: 二度と来るなよ！
#. de: Lasst euch hier nie wieder blicken!
#. fr: Et ne revenez pas ici<nbsp>!
msgctxt "NpcYell:6467:0:13"
msgid "And don't come back!"
msgstr ""

#. ja: クッ…<br>一時撤退だ…
#. de: Verdammt ... Vorläufiger Rückzug!
#. fr: C-c'est ce qu'on verra...
msgctxt "NpcYell:6468:0:13"
msgid "Ugh... It's no use. We have to fall back."
msgstr ""

#. ja: さてと…<br>あとはコレを運べば…
#. de: Jetzt müssen die Kisten nur noch zum Grill rüb...!
#. fr: Y a plus que ces quelques caisses à déplacer<nbsp>!
msgctxt "NpcYell:6469:0:13"
msgid "All that's left is to deliver these fish."
msgstr ""

#. ja: うわっ…！<br>スニッパーが…！
#. de: Schnippler-Alaaarm!
#. fr: Aaah<nbsp>! Des cisailleuuurs<nbsp>!
msgctxt "NpcYell:6470:0:13"
msgid "Snippers! Why did it have to be snippers!?"
msgstr ""

#. ja: いけいけ！
#. de: Gib ihnen was auf die Scheren!
#. fr: Du vent, sales bêtes<nbsp>!
msgctxt "NpcYell:6471:0:13"
msgid "Shoo! Shoo!"
msgstr ""

#. ja: がんばれ！
#. de: Schnippelt euch fort!
#. fr: Chassez-les d'ici<nbsp>!
msgctxt "NpcYell:6472:0:13"
msgid "Keep it up!"
msgstr ""

#. ja: ありがとう！<br>助かったよ！
#. de: Danke, die Grillparty ist gerettet!
#. fr: Merci<nbsp>! J'ai cru que mes poissons et moi, on allait y passer<nbsp>!
msgctxt "NpcYell:6473:0:13"
msgid "Thanks. You saved me, and my fish."
msgstr ""

#. ja: そ、そんな…<br>アタシの魚が…
#. de: Und was wird jetzt aus der Grillparty?
#. fr: Oh non... Ils ont mangé tous mes poissons...
msgctxt "NpcYell:6474:0:13"
msgid "No! My fish... My beautiful fish..."
msgstr ""

#. ja: やれやれ…<br>ひどい有様だな…
#. de: Was für ein Saustall! Diese Touristen<nbsp>...
#. fr: La plage est dans un état lamentable. Fichus touristes...
msgctxt "NpcYell:6475:0:13"
msgid "Gods be good... Look at all this rubbish!"
msgstr ""

#. ja: ありがとう！<br>美しさが戻ってきた！
#. de: Danke! Jetzt können wir endlich die Katalogfotos schießen!
#. fr: Merci<nbsp>! La plage est presque plus belle qu'à notre arrivée<nbsp>!
msgctxt "NpcYell:6476:0:13"
msgid "Thank you! You've made the beach beautiful again!"
msgstr ""

#. ja: まだまだゴミが残っているな<br>協力者を募って来るか…
#. de: Hier liegt immer noch ordentlich Dreck rum. Ich werd Hilfe holen gehen.
#. fr: Il reste encore tant de déchets... Il va falloir que je trouve des âmes charitables pour ramasser toutes ces immondices<nbsp>!
msgctxt "NpcYell:6477:0:13"
msgid "It's no good. There's still too much rubbish. We may need more hands."
msgstr ""

#. ja: 散乱したゴミを<br>集めて来てくれ！
#. de: Unser Strand muss sauber bleiben!
#. fr: Si tu vois des détritus, ramasse-les. Ça nous rendra un fier service.
msgctxt "NpcYell:6478:0:13"
msgid "Bring me your rubbish! Every last bit you can find!"
msgstr ""

#. ja: 集めたゴミは<br>私が回収しよう！
#. de: Bring den Müll zu mir!
#. fr: Oublie pas de m'apporter les ordures que tu auras ramassées, hein<nbsp>!
msgctxt "NpcYell:6479:0:13"
msgid "Gather your rubbish! I'll collect it!"
msgstr ""

#. ja: 協力ありがとう！<br>そろそろ撤収する！
#. de: Danke für deine Hilfe! Ich muss bald los.
#. fr: Merci pour tout<nbsp>! L'heure tourne, il va falloir que j'y aille.
msgctxt "NpcYell:6480:0:13"
msgid "Thanks for the help. I think our work here is done."
msgstr ""

#. ja: まだゴミがあるなら<br>私が回収しよう！
#. de: Falls du noch Müll hast, bring ihn mir!
#. fr: Si tu trouves d'autres déchets, hésite pas à les ramasser. T'auras qu'à me les remettre plus tard<nbsp>!
msgctxt "NpcYell:6481:0:13"
msgid "If you still have rubbish, I'll take it off your hands!"
msgstr ""

#. ja: <sheet BNpcName $n2 0>が、<if ($n1 == 1)>豪華な<else>質素な</if><sheet Treasure $n3 0>を落とした！
#. de: <capitalize><noun-de BNpcName 2 $n2 1 1 1></capitalize> hat <noun-de Treasure 1 $n3 1 4 1> <if ($n1 == 1)>der Extraklasse </if>fallen gelassen!
#. fr: <capitalize><noun-fr BNpcName 2 $n2 1 1></capitalize> a laissé un <sheet Treasure $n3 0> <if ($n1 == 1)>luxueux<else>modeste</if><nbsp>!
#. macro: <if ($n1 == 1)>promising<else>plain</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 1 == 1 (condition: may be reworded, restructured, added, or dropped)
#. macro: <sheet Treasure $n3 0> — a value from a game data sheet, such as a name; sheet = Treasure, row = number parameter 3, column = 0 (game data: keep it; it may move or repeat)
#. macro: <noun-en BNpcName 2 $n2 1 1> — an English noun from a game data sheet, with article and number; sheet = BNpcName, form = 2, row = number parameter 2, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "NpcYell:6482:0:13"
msgid "A <if ($n1 == 1)>promising<else>plain</if> <sheet Treasure $n3 0> is discovered upon defeating <noun-en BNpcName 2 $n2 1 1>!"
msgstr ""

#. ja: “朕の剣を受けてみよ！”
#. de: Mein Schwert wird euch richten!
#. fr: “Mon épée va mettre un terme à vos existences<nbsp>!”
msgctxt "NpcYell:6483:0:13"
msgid "You still wish to fight? My sword is only too happy to oblige!"
msgstr ""

#. ja: “家畜は所詮家畜ぞ！”
#. de: Vieh bleibt Vieh!
#. fr: “Vous n'êtes que du vulgaire bétail<nbsp>!”
msgctxt "NpcYell:6484:0:13"
msgid "The world has no place for such wretches."
msgstr ""

#. ja: “身の程を知れいッ！”
#. de: Kennt euren Platz!
#. fr: “Vos vies ne valent rien<nbsp>!”
msgctxt "NpcYell:6485:0:13"
msgid "Your claim to life is forfeit!"
msgstr ""

#. ja: “ク…クソッ…”
#. de: Uargh!
#. fr: “Non... Non<nbsp>!”
msgctxt "NpcYell:6486:0:13"
msgid "Damn you... Damn you all!"
msgstr ""

#. ja: “軟弱な者どもに…”
#. de: Gegen diese Schwächlinge ...!
#. fr: “Ces misérables... ont eu raison de moi...<nbsp>?”
msgctxt "NpcYell:6487:0:13"
msgid "Common rabble..."
msgstr ""

#. ja: “た、助け…て…”
#. de: Z-Zu Hilfe ...
#. fr: “Au... secours...”
msgctxt "NpcYell:6488:0:13"
msgid "Save me!"
msgstr ""

#. ja: “ハハハハハハ！”
#. de: Hahahaha!
#. fr: “Ha<nbsp>! Ha<nbsp>! Ha<nbsp>!”
msgctxt "NpcYell:6489:0:13"
msgid "Ah hah hah hah hah!"
msgstr ""

#. ja: “ひとり残らず死ねッ！”
#. de: Sterbt! Alle!
#. fr: “Mourez jusqu'au dernier<nbsp>!”
msgctxt "NpcYell:6490:0:13"
msgid "Death is too light a punishment for your ilk!"
msgstr ""

#. ja: “死をもって償うのだッ！”
#. de: Sühnt mit dem Tod!
#. fr: “Repentez-vous dans la mort<nbsp>!”
msgctxt "NpcYell:6491:0:13"
msgid "Repent, maggots!"
msgstr ""

#. ja: 月よ！<br>鉄の覇道を照らせ！
#. de: O roter Mond! Führe mich zur Herrschaft! 
#. fr: Ô lune<nbsp>! Éclaire la voie de la domination<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6492:0:13"
msgid "O hallowed moon,<br>shine you the iron path!"
msgstr ""

#. ja: 月よ！<br>赤熱し、神敵を焼け！
#. de: O roter Mond! Umlodere meinen Pfad!
#. fr: Que l'incandescence de la lune brûle mes ennemis<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6493:0:13"
msgid "O hallowed moon,<br>take fire and scorch my foes!"
msgstr ""

#. ja: 赤熱し、焼かれし道を<br>鉄の覇道と成す！
#. de: Umloderter Pfad, führe mich zur Herrschaft!
#. fr: La voie marquée par l'incandescence mène à la domination<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6494:0:13"
msgid "Blazing path,<br>lead me to iron rule!"
msgstr ""

#. ja: 赤熱せし<br>月の祝福を！
#. de: Flammender Pfad, geschaffen vom roten Mond!
#. fr: Baignez dans la bénédiction de la lune incandescente<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6495:0:13"
msgid "Take fire,<br>O hallowed moon!"
msgstr ""

#. ja: 我、舞い降りて<br>鉄の覇道を征く！
#. de: Seht, ich steige herab, um euch zu beherrschen!
#. fr: Du haut des cieux, je vais descendre pour conquérir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6496:0:13"
msgid "From on high I descend,<br>the iron path to walk!"
msgstr ""

#. ja: 我、舞い降りて<br>月を仰がん！
#. de: Seht, ich steige herab, vom rotglühenden Monde!
#. fr: Des cieux je vais descendre et révérer la lune<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6497:0:13"
msgid "From on high I descend,<br>the hallowed moon to call!"
msgstr ""

#. ja: 超新星よ、輝きを増せ！<br>星降りの夜に、紅月を称えよ！
#. de: Neues Gestirn! Überstrahle jede Sternschnuppe!
#. fr: Supernova, brille de tout ton feu et glorifie la lune rouge<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6500:0:13"
msgid "Fleeting light!<br>Amid a rain of stars,<br>exalt you the red moon!"
msgstr ""

#. ja: 超新星よ、輝きを増せ！<br>紅月下の赤熱せし地を照らせ！
#. de: Neues Gestirn! Glühe herab und umlodere meinen Pfad!
#. fr: Supernova, brille de tout ton feu et irradie la terre rougie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6501:0:13"
msgid "Fleeting light!<br>'Neath the red moon,<br>scorch you the earth!"
msgstr ""

#. ja: 我、舞い降りて月を仰ぎ<br>星降りの夜を招かん！
#. de: Ich steige herab zu Ehre des roten Mondes! Einer Sternschnuppe gleich!
#. fr: Du haut des cieux, j'appelle une pluie d'étoiles<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6502:0:13"
msgid "From on high I descend,<br>the moon and stars to bring!"
msgstr ""

#. ja: 我、月より舞い降りて<br>星降りの夜を招かん！
#. de: O roter Mond, sieh mich herabsteigen! Einer Sternschnuppe gleich!
#. fr: Depuis la lune, j'invoque une pluie d'étoiles<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6503:0:13"
msgid "From hallowed moon I descend,<br>a rain of stars to bring!"
msgstr ""

#. ja: 鉄よ、赤熱せよ！<br>舞い降りし我が刃となれ！
#. de: Zur Herrschaft führt mein umloderter Pfad! Auf diesen steige ich herab!
#. fr: Ô noble acier<nbsp>! Rougis ardemment et deviens ma lame transperçante<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6504:0:13"
msgid "Unbending iron,<br>take fire and descend!"
msgstr ""

#. ja: 鉄よ、舞い降りし<br>我の刃となり赤熱せよ！
#. de: Zur Herrschaft steige ich herab, auf umlodertem Pfad!
#. fr: Fier acier<nbsp>! Sois ma lame plongeante et deviens incandescent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6505:0:13"
msgid "Unbending iron,<br>descend with fiery edge!"
msgstr ""

#. ja: 我、月より舞い降りて<br>赤熱せし地を歩まん！
#. de: O roter Mond! Ich stieg herab, um deine Herrschaft zu bringen!
#. fr: De la lune, je descends et marche sur la terre ardente<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6506:0:13"
msgid "From hallowed moon I descend,<br>upon burning earth to tread!"
msgstr ""

#. ja: 我、月より鉄を備え<br>舞い降りん！
#. de: O roter Mond, als Künder deiner Herrschaft stieg ich herab!
#. fr: De la lune je m'arme d'acier et descends<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6507:0:13"
msgid "From hallowed moon I bare iron,<br>in my descent to wield!"
msgstr ""

#. ja: “ア、アア…アァァ…”
#. de: Aaahhh!
#. fr: “Ahhh. Ahahah<nbsp>!”
msgctxt "NpcYell:6508:0:13"
msgid "Aaaaaah!"
msgstr ""

#. ja: “ギギギギギギ…”
#. de: Grr!
#. fr: “Gnn<nbsp>! Aahhh<nbsp>!”
msgctxt "NpcYell:6509:0:13"
msgid "\\<crackle>"
msgstr ""

#. ja: 煙の臭い…<br>戦いがあったのね
#. de: Pulvergeruch ... Gab es hier Kämpfe?
#. fr: L'odeurrr de la fumée me pique les narines... Maître Cid n'a pas exagéré, c'est un vrai champ de ruines.
msgctxt "NpcYell:6510:0:13"
msgid "I smell woodsmoke. There was a battle here."
msgstr ""

#. ja: きゃっ！
#. de: Ah!
#. fr: Ah<nbsp>!
msgctxt "NpcYell:6511:0:13"
msgid "Chocob─!"
msgstr ""

#. ja: 火事場泥棒なの！？
#. de: Sind das Plünderer?
#. fr: Ce sont des pillarrrds<nbsp>!?
msgctxt "NpcYell:6512:0:13"
msgid "They're robbing the homes!"
msgstr ""

#. ja: ひどい…<br>住民たちはどこへ…？
#. de: Wo sind all die Bürger hin?
#. fr: Des rrruines à perte de vue. Je me demande où ont bien pu passer ceux qui habitaient ici...
msgctxt "NpcYell:6513:0:13"
msgid "Where is everyone?"
msgstr ""

#. ja: またシーク族が…！
#. de: Noch mehr Seek ...
#. fr: Regardez<nbsp>! D'autrrres Seeqs<nbsp>!
msgctxt "NpcYell:6514:0:13"
msgid "Not them again!"
msgstr ""

#. ja: 砂漠の都の地下に<br>こんな水路があったなんて
#. de: Dass unter dem Wüstenboden so viel Wasser ist!
#. fr: De gi<shy>gan<shy>tesques égouts sous une ville en plein désert<nbsp>! Le Corbeau aurait publié une histoire pareille, je ne l'aurais pas crrrue<nbsp>!
msgctxt "NpcYell:6515:0:13"
msgid "No wonder there's a desert above. All the water's down here!"
msgstr ""

#. ja: 幻の王都ルザリア…<br>まさか本当に…！
#. de: Das legendäre Lesalia gibt es wirklich ...
#. fr: Lesalia, la cité légendaire<nbsp>! Elle existait vrrraiment<nbsp>!
msgctxt "NpcYell:6516:0:13"
msgid "Lesalia!? Impossible!"
msgstr ""

#. ja: さ、寒気が…
#. de: Puh, hier ist es plötzlich so kalt.
#. fr: J-j'ai la trrremblote tout d'un coup, moi...
msgctxt "NpcYell:6517:0:13"
msgid "Anyone else feel a chill?"
msgstr ""

#. ja: 何か言っていたようだけど<br>あれがイヴァリース語？
#. de: Was sollte das bedeuten ...? Ist das also Hoch-Ivalisisch?
#. fr: Je n'ai rrrien compris de ce qu'il a dit. C'était de l'ivalicien<nbsp>?
msgctxt "NpcYell:6518:0:13"
msgid "That's not Dalmascan he's speaking. Could it be High Ivalician?"
msgstr ""

#. ja: 理解できていた？<br>噂の“超える力”ですか？
#. de: Du hast ihn verstanden? Deine Kraft des Transzendierens ist wirklich ein Geschenk.
#. fr: Tu as saisi le sens de ses paroles, <split " " 1><string $gs1></split><nbsp>? C'est grâce à ce fameux pouvoir, j'imagine, l'Écho.
msgctxt "NpcYell:6519:0:13"
msgid "You understood him...? Right! The Echo!"
msgstr ""

#. ja: 横取りさせるかよ！
#. de: He! Wegschnappen gilt nicht!
#. fr: Y sont à nous ces coffres<nbsp>! Personne nous les piquera<nbsp>!
msgctxt "NpcYell:6520:0:13"
msgid "Finders keepers!"
msgstr ""

#. ja: 邪魔すんじゃねぇ！
#. de: Verschwindet!
#. fr: Foutez le camp<nbsp>!
msgctxt "NpcYell:6521:0:13"
msgid "You ain't supposed to be here!"
msgstr ""

#. ja: 取り戻しに<br>来たってのか？
#. de: Zurückholen? Hah! Stehlen nenne ich das!
#. fr: Voler, c'est voler<nbsp>! Et reprendre, c'est voler aussi<nbsp>!
msgctxt "NpcYell:6522:0:13"
msgid "Should we kill 'em?"
msgstr ""

#. ja: 帝国軍の姿もない…<br>これなら…
#. de: Keine Garlear zu sehen. Na dann ...
#. fr: Pas l'ombre d'un soldat... On est refaits<nbsp>!
msgctxt "NpcYell:6523:0:13"
msgid "Not an imperial in sight."
msgstr ""

#. ja: ここらのお宝は<br>全部いただくぞ！
#. de: Har har! Wie schwer die Truhe ist! Das gehört alles uns!
#. fr: Tous les coffres du coin sont sans protection<nbsp>! Y a qu'à se baisser<nbsp>!
msgctxt "NpcYell:6524:0:13"
msgid "Grab all you can carry, brothers!"
msgstr ""

#. ja: 大金持ちになってやる！
#. de: Wir sind reich!
#. fr: J'ai attendu ça toute ma vie<nbsp>! À moi la fortune<nbsp>!
msgctxt "NpcYell:6525:0:13"
msgid "We'll be rich!"
msgstr ""

#. ja: あの赤いのは…？
#. de: Was ist mit diesem roten Chocobo ...?
#. fr: Heu... On avait un chocobo rouge<nbsp>?
msgctxt "NpcYell:6526:0:13"
msgid "You seein' red?"
msgstr ""

#. ja: ま、マズいぞ！
#. de: Roter Cho...? Verflucht, passt auf!
#. fr: Un cho... Rouge<nbsp>! Rouge<nbsp>! Tous aux abris<nbsp>! Planquez-vous<nbsp>!
msgctxt "NpcYell:6527:0:13"
msgid "Hells alive!"
msgstr ""

#. ja: あんなの見たことが…？
#. de: So was hab ich ja noch nie gesehen ...
#. fr: Tiens, première fois que j'en vois un comme ça...
msgctxt "NpcYell:6528:0:13"
msgid "We're doomed!"
msgstr ""

#. ja: ひ、ひぃ…<br>命だけは…！
#. de: Nein! Gnade!
#. fr: Ah<nbsp>! J-je recommencerai plus, promis<nbsp>!
msgctxt "NpcYell:6529:0:13"
msgid "Spare us, kind sires!"
msgstr ""

#. ja: 痛たたたたた…
#. de: Autsch! Auauau!
#. fr: Ouille-ouille-ouille...
