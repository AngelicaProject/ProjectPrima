#. de: ×□☆◇○!
#. fr: ＠Ж, ♪▼＃☆＠Ψ<nbsp>!
msgctxt "NpcYell:6562:0:13"
msgid "×□☆◇○!"
msgstr ""

#. ja: クソッ…<br>限界だ…！
#. de: Ich kann nicht mehr<nbsp>...
#. fr: Je suis à bout de force...
msgctxt "NpcYell:6563:0:13"
msgid "I'm done for..."
msgstr ""

#. ja: フォルドラが<br>耐えている間に…！
#. de: Jetzt! Solange Fordola sie noch in Schach hält!
#. fr: Vite<nbsp>! Tant que Fordola tient le coup<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6564:0:13"
msgid "Now! While Fordola's<br>taking the brunt of it..."
msgstr ""

#. ja: うおおお！
#. de: Huaaah!
#. fr: Mouoooh<nbsp>!
msgctxt "NpcYell:6565:0:13"
msgid "Hyah!"
msgstr ""

#. ja: はぁ…はぁ…
#. de: \<keuch> ... \<keuch>
#. fr: (souffle)... (souffle)...
msgctxt "NpcYell:6566:0:13"
msgid "\\<gasp> \\<pant>"
msgstr ""

#. ja: 負けてたまるか…
#. de: Ich werde mich keinem Primae geschlagen geben!
#. fr: Hors de question que je me laisse vaincre...
msgctxt "NpcYell:6567:0:13"
msgid "I'll not lose to the likes of this..."
msgstr ""

#. ja: ラクシュミ様…！
#. de: Die Göttin der Schönheit!
#. fr: Ô Lakshmi<nbsp>!
msgctxt "NpcYell:6568:0:13"
msgid "The Lady of Bliss!"
msgstr ""

#. ja: ひいっ！
#. de: Aaah!
#. fr: Hiii<nbsp>!
msgctxt "NpcYell:6569:0:13"
msgid "Ah!"
msgstr ""

#. ja: 壊神よ、救い給え…
#. de: Rhalgr, stehe uns bei!
#. fr: Rhalgr, sauve-nous<nbsp>!
msgctxt "NpcYell:6570:0:13"
msgid "Rhalgr, save us all..."
msgstr ""

#. ja: 助けてっちゃ…
#. de: Hiiilfe!
#. fr: Aïe<nbsp>! Aïe<nbsp>! Au secouuurs<nbsp>!
msgctxt "NpcYell:6571:0:13"
msgid "Help the helpless!"
msgstr ""

#. ja: な、なんてことだ…
#. de: Was ist geschehen?
#. fr: Comment cela a pu arriver<nbsp>?<nbsp>...
msgctxt "NpcYell:6572:0:13"
msgid "How did this happen...?"
msgstr ""

#. ja: バウトッ…
#. de: Baut ...!
#. fr: Baut...
msgctxt "NpcYell:6573:0:13"
msgid "Baut..."
msgstr ""

#. ja: そんな…
#. de: Bitte, nicht<nbsp>...
#. fr: Pitié... Pas ça...
msgctxt "NpcYell:6574:0:13"
msgid "No...please..."
msgstr ""

#. ja: 逃げられない…のか？
#. de: Wir sind in eine Falle getappt!
#. fr: Nous sommes faits comme des rats<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6575:0:13"
msgid "Walked into a trap,<br>have we?"
msgstr ""

#. ja: こんなところでッ！
#. de: Verdammt! Wie konnte das geschehen?
#. fr: Grrr<nbsp>! Pas comme ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6576:0:13"
msgid "Gah!<br>After all that's happened!"
msgstr ""

#. ja: イヤあぁっ！
#. de: So ein Mist!
#. fr: Nooon<nbsp>!
msgctxt "NpcYell:6577:0:13"
msgid "Blast!"
msgstr ""

#. ja: シュー…<br>今のうちに脱出を！
#. de: Wir müsssen fliehen!
#. fr: Nous devons fuir<nbsp>! Ssss...
msgctxt "NpcYell:6578:0:13"
msgid "We mussst flee!"
msgstr ""

#. ja: 逃げるっちゃ！
#. de: Nichts wie weg!
#. fr: Fuuuir<nbsp>!
msgctxt "NpcYell:6579:0:13"
msgid "Escape!"
msgstr ""

#. ja: どうかご無事で…
#. de: Bringt euch in Sicherheit!
#. fr: Bon courrrage...
msgctxt "NpcYell:6580:0:13"
msgid "Gods be with you..."
msgstr ""

#. ja: 逃亡を許したと…！？
#. de: Ihr verweigert euch meiner Zuneigung?
#. fr: Comment osent-ils fuir ma bénédiction<nbsp>?
msgctxt "NpcYell:6581:0:13"
msgid "They forsssake eternal bliss!?"
msgstr ""

#. ja: グッ…身体が…
#. de: Meine Beine!
#. fr: Argh... Mon corps...
msgctxt "NpcYell:6582:0:13"
msgid "My legs, I can't..."
msgstr ""

#. ja: ぬおおおおおッ！
#. de: Uaaargh!
#. fr: MOUUUOH<nbsp>!
msgctxt "NpcYell:6583:0:13"
msgid "Uaaargh!"
msgstr ""

#. ja: こんなものッ！
#. de: Ist das alles, was du hast?
#. fr: Alors<nbsp>? C'est tout<nbsp>!?
msgctxt "NpcYell:6584:0:13"
msgid "Is that all you've got!"
msgstr ""

#. ja: しまった！
#. de: Verdammt!
#. fr: Fichtre<nbsp>!
msgctxt "NpcYell:6585:0:13"
msgid "Dammit!"
msgstr ""

#. ja: 見つけたぞ！<br>お宝だ！
#. de: Wir haben sie gefunden! Riesige Schätze!
#. fr: Regardez tous ces trésors<nbsp>!
msgctxt "NpcYell:6586:0:13"
msgid "It's like a gold mine...without the mine!"
msgstr ""

#. ja: ウヘヘ…<br>こいつはすげぇ！
#. de: Har har! Wir sind gemachte Leute, Leute!
#. fr: Bwaaaahahah<nbsp>! On a touché le gros lot<nbsp>!
msgctxt "NpcYell:6587:0:13"
msgid "I's never before seen so much riches."
msgstr ""

#. ja: 山分けだぞ？<br>約束だからな！
#. de: Das wird gerecht geteilt, wie abgemacht!
#. fr: On avait dit chacun sa part, hein<nbsp>! L'oubliez pas<nbsp>!
msgctxt "NpcYell:6588:0:13"
msgid "Three ways, brothers. Just as we agreed upon."
msgstr ""

#. ja: て、手強い！
#. de: Verdammt, die wehren sich!
#. fr: Rahhh<nbsp>! Y-y se dé<shy>brouil<shy>lent<nbsp>!
msgctxt "NpcYell:6589:0:13"
msgid "These bastards mean business!"
msgstr ""

#. ja: 来いよ！
#. de: Na los, komm her!
#. fr: Allez, ramenez-vous pour voir<nbsp>!
msgctxt "NpcYell:6590:0:13"
msgid "Over here!"
msgstr ""

#. ja: 鳥どもを放て！
#. de: Lasst die Vögel los!
#. fr: Vite<nbsp>! Lâchez les piafs<nbsp>!
msgctxt "NpcYell:6591:0:13"
msgid "Release the birds!"
msgstr ""

#. ja: いつまで耐えられるかな？
#. de: Wie viel können die denn einstecken?!
#. fr: Ahah<nbsp>! On fait moins les malins<nbsp>!
msgctxt "NpcYell:6592:0:13"
msgid "Run! While ye still 'ave yer 'eads!"
msgstr ""

#. ja: もっとだ！<br>まだまだいるぞ！
#. de: Da sind noch mehr! Viel mehr!
#. fr: Ils prenaient trop de place ces sacs à plumes de toute façon<nbsp>!
msgctxt "NpcYell:6593:0:13"
msgid "More! More!"
msgstr ""

#. ja: いけ、いけ！<br>やっちまえ！
#. de: Los, los, los! Nicht so lahm!
#. fr: Picorez-les jusqu'au dernier<nbsp>! Gwaahahaha<nbsp>!
msgctxt "NpcYell:6594:0:13"
msgid "Trample 'em all!"
msgstr ""

#. ja: 餅つき会場はここだぜ！
#. de: Das Mochi-Stampfen findet dort drüben statt.
#. fr: C'est ici qu'on écrase le mochi<nbsp>!
msgctxt "NpcYell:6595:0:13"
msgid "The pounding takes place just over yonder."
msgstr ""

#. ja: 降神餅の回収を<br>手伝ってくれねぇか！？
#. de: <split " " 1><string $gs1></split>, ich bitte dich! Ohne diese Mochi sind wir aufgeschmissen!
#. fr: Tu voudrais pas nous donner un petit coup de main<nbsp>?
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:6596:0:13"
msgid "Please, <split \" \" 1><string $gs1></split>, we must have that mochi!"
msgstr ""

#. ja: サイクロプスの動きを見て餅を取ってくれ！
#. de: Pass auf, dass dich der Hammer des Zyklopen nicht trifft.
#. fr: Prends garde aux mouvements du cyclope en t'approchant, et fourres-en le plus possible dans ta besace<nbsp>!
msgctxt "NpcYell:6597:0:13"
msgid "Take care to avoid the cyclops's mallet."
msgstr ""

#. ja: 飛猫どもの妨害には<br>気を付けろよ！
#. de: Achtung, fliegende Katzen!
#. fr: Fais gaffe aux matous qui rôdent, ils sont rusés comme pas deux<nbsp>!
msgctxt "NpcYell:6598:0:13"
msgid "Ware the gaelicats!"
msgstr ""

#. ja: 餅の回収、任せたぜ！
#. de: Ohne Mochi keine Himmelswende.
#. fr: On compte sur toi pour ramener plein de mochi<nbsp>!
msgctxt "NpcYell:6599:0:13"
msgid "There can be no celebration without that mochi."
msgstr ""

#. ja: 見事な回収だったな！<br>手伝ってくれてありがとよ！
#. de: Das sollte reichen. Hervorragende Arbeit!
#. fr: Tu as fait des miracles<nbsp>! Un grand merci à toi<nbsp>!
msgctxt "NpcYell:6600:0:13"
msgid "Yes, that should more than suffice. Well done, my friend!"
msgstr ""

#. ja: あぁ、縁起物の餅が…
#. de: Unser schönes Mochi! Was wird jetzt nur aus unserem Fest?
#. fr: Oh non... Qu'est-ce qu'on va faire, sans mochi...
msgctxt "NpcYell:6601:0:13"
msgid "Our mochi... What will become of the festival now?"
msgstr ""

#. ja: オラオラ！
#. de: Gleich fliegen hier die Federn!
#. fr: Vous allez y laisser des plumes<nbsp>!
msgctxt "NpcYell:6602:0:13"
msgid "Come on, then!"
msgstr ""

#. ja: どっかいっちまいな！
#. de: Hiergeblieben!
#. fr: Dé<shy>guer<shy>pis<shy>sez tant que vous respirez encore<nbsp>!
msgctxt "NpcYell:6603:0:13"
msgid "What say ye just let us be, eh?"
msgstr ""

#. ja: 痛い目見たいか！？
#. de: Jetzt seid ihr dran!
#. fr: Vous voulez être transformés en julienne<nbsp>!?
msgctxt "NpcYell:6604:0:13"
msgid "You ain't seein' tomorrow!"
msgstr ""

#. ja: ガルルルル！
#. de: Graaarrr!
#. fr: Groooaaaarrr<nbsp>!!!
msgctxt "NpcYell:6605:0:13"
msgid "Graaah!"
msgstr ""

#. ja: グオォーン！
#. de: Grooorrr!
#. fr: Grooooh<nbsp>!
msgctxt "NpcYell:6606:0:13"
msgid "Raaargh!"
msgstr ""

#. ja: フゥーッ！
#. de: Fuuuaaar!
#. fr: Ssshhh<nbsp>!
msgctxt "NpcYell:6607:0:13"
msgid "Grrr!"
msgstr ""

#. ja: アガガ…ガガッ…ガッ…！
#. de: Agaga<nbsp>... Graaarrr!
#. fr: GrrrRRRRAAAAHH...<nbsp>!
msgctxt "NpcYell:6608:0:13"
msgid "Gahaha...haha...hah!"
msgstr ""

#. ja: ウオオオ、オ宝、渡サン！<br>ミナ殺シ！　ミナ殺シ！
#. de: Groaaahr! Schatz, nicht geben.<br>Töten! Alle töten!
#. fr: LAISSER PERSONNE TOUCHER AU TRÉSOR<nbsp>!<br>MASSACRER<nbsp>! MASSACRER<nbsp>!!!
msgctxt "NpcYell:6609:0:13"
msgid "Only death will you find here! Only death!"
msgstr ""

#. ja: お前らなんかに<br>負けないぞぉ～！
#. de: Nur ein toter Rotpanzer ist ein guter<nbsp>...... Rotpanzer.
#. fr: Les Rouges n'auront pas raison de nouuuus<nbsp>!
msgctxt "NpcYell:6610:0:13"
msgid "Red-shelled bastards!"
msgstr ""

#. ja: なんのこれしき～！
#. de: Jetzt bekommt ihr<nbsp>...... Probleme.
#. fr: Ridicuuuule<nbsp>!
msgctxt "NpcYell:6611:0:13"
msgid "For the Blue!"
msgstr ""

#. ja: ぬるい、ぬるい～！<br>紅甲羅はこの程度かぁ～！？
#. de: Mehr haben die Roten wohl nicht<nbsp>...... drauf.
#. fr: C'est tout ce que les Rouges ont dans le veeeentre<nbsp>!?
msgctxt "NpcYell:6612:0:13"
msgid "That all you've got?"
msgstr ""

#. ja: こわくない～<br>こわくない～！
#. de: Vor Rochen habe ich keine<nbsp>...... Angst! 
#. fr: Vous ne nous faites pas peuuuur<nbsp>!
msgctxt "NpcYell:6613:0:13"
msgid "We're not afraid of you!"
msgstr ""

#. ja: 助太刀いたす～！
#. de: Meine Klinge dürstet nach rotem Blut!
#. fr: Tenez bon, on arriiiive<nbsp>!
msgctxt "NpcYell:6614:0:13"
msgid "The Red will rue this day!"
msgstr ""

#. ja: ぐおぉ…
#. de: Grrr ...
#. fr: Argh...
msgctxt "NpcYell:6615:0:13"
msgid "Argh!"
msgstr ""

#. ja: うぉぉぉぉ…！
#. de: Uaaah!
#. fr: Hmmnnn...<nbsp>!
msgctxt "NpcYell:6616:0:13"
msgid "Prepare to taste my steel!"
msgstr ""

#. ja: この宝物に「交感」されよぉ～
#. de: Harmonisiere dich mit dem<nbsp>...... Schatz.
#. fr: Entrez en osmose spirituelle avec ce trésoooor<nbsp>!
msgctxt "NpcYell:6617:0:13"
msgid "May the blessings of the kami grant you strength."
msgstr ""

#. ja: 動けまいー！<br>いまこそ好機ー！
#. de: Du wirst keinen Schritt weiter<nbsp>...... tun, Blauer!
#. fr: Il est sans défeeeense<nbsp>! Achevez-leeee<nbsp>!
msgctxt "NpcYell:6618:0:13"
msgid "I have him! Attack!"
msgstr ""

#. ja: ここが貴様らの墓場だァー！
#. de: Blaupanzern ist hier Zutritt<nbsp>...... verboten.
#. fr: Cette île sera votre tombeauuuu<nbsp>!
msgctxt "NpcYell:6619:0:13"
msgid "This will be your grave."
msgstr ""

#. ja: ひゃっはァー！<br>切り刻んでやるー！
#. de: Eure Knochen werden den Palast der Schätze<nbsp>...... schmücken.
#. fr: Ha ha haaaa<nbsp>! Déchiquetez-leeees<nbsp>!
msgctxt "NpcYell:6620:0:13"
msgid "I will rend you limb from limb!"
msgstr ""

#. ja: 消えただと！<br>どこへいった！？
#. de: Sie ist verschwunden, aber bleibt wachsam!
#. fr: Où est-elle passée<nbsp>? Restons vigilants<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6621:0:13"
msgid "Where did she─?<br>Stay on your guard!"
msgstr ""

#. ja: クッ…<br>身体が縛られて…
#. de: E-Etwas hält mich!
#. fr: Urgh<nbsp>! Je ne peux plus bouger...
msgctxt "NpcYell:6622:0:13"
msgid "Ugh, I'm trapped!"
msgstr ""

#. ja: な、なんという威圧感…<br>これが蛮神！
#. de: Ihre Präsenz<nbsp>... ist überwältigend!
#. fr: Quel pouvoir<nbsp>!<nbsp>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6623:0:13"
msgid "Her presence...<br>It's overwhelming!"
msgstr ""

#. ja: ここは任せろぉ～！
#. de: Den Rest müsst ihr<nbsp>...... erledigen.
#. fr: Allez-yyyy<nbsp>! Nous gardons vos arrièèèères<nbsp>!
msgctxt "NpcYell:6624:0:13"
msgid "Leave this place to us."
msgstr ""

#. ja: 武運を祈ってるよぉ～！
#. de: Meine Gebete sind<nbsp>...... bei euch.
#. fr: Que les kami vous protèèèègent<nbsp>!
msgctxt "NpcYell:6625:0:13"
msgid "May the kami keep you safe."
msgstr ""

#. ja: まだまだ暴れて<br>紅甲羅をかき回すぞぉ～！
#. de: Wir halten euch den Rückenpanzer<nbsp>...... frei.
#. fr: On va en faire voir aux Rouges de toutes les couleuuuurs<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6626:0:13"
msgid "The Red will think twice<br>before challenging us again."
msgstr ""

#. ja: お宝に「交感」して<br>神気を浴びてぇ～！！
#. de: Empfange den Segen der<nbsp>...... Kami.
#. fr: Absorbez le pouvoir de ce trésor et les kami veilleront sur voooous<nbsp>!
msgctxt "NpcYell:6627:0:13"
msgid "The kami's blessing will protect you."
msgstr ""

#. ja: 助かったぁ…！
#. de: Geschafft!
#. fr: Bien jouéééé<nbsp>!
msgctxt "NpcYell:6628:0:13"
msgid "My thanks."
msgstr ""

#. ja: 水よ舞いて<br>千切るのじゃ！
#. de: Wasser, tanze deinen tosenden Reigen!
#. fr: Que danse et tranche l'eau<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6629:0:13"
msgid "Waters to strip<br>flesh from bone!"
msgstr ""

#. ja: 水よ踊りて<br>爆ぜるのじゃ！
#. de: Wasser, tanze deinen stürmischen Tanz!
#. fr: Que jaillisse et éclate l'eau<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6630:0:13"
msgid "Waters to burst<br>and drag below!"
msgstr ""

#. ja: 大丈夫、大丈夫だから…！
#. de: Keine Angst, es wird alles gut werden.
#. fr: T'en fais pas Azami, on... on va s'en sortir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6631:0:13"
msgid "Don't worry Azami.<br>I won't let them hurt you."
msgstr ""

#. ja: こわいよ…イッセにい…
#. de: Isse ... Isse!
#. fr: Isse, j'ai peur...<nbsp>!
msgctxt "NpcYell:6632:0:13"
msgid "I'm scared."
msgstr ""

#. ja: あくまで我に、抗おうというのか……<br>ならば、その血を風に溶かし、雨に流そうぞ！
#. de: Wer sich mir widersetzt, dessen Blut wird die Erde tränken!
#. fr: Comment osez-vous vous dresser devant moi, impertinents humains<nbsp>!? Que les vents emportent vos carcasses, et que la pluie lave le sol de votre vile présence<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6633:0:13"
msgid "You refuse?<br>Then slake the land's thirst with a storm of blood!"
msgstr ""

#. ja: ここまで抵抗し得る者が残っていたとは……<br>おもしろい、我が力を見せてやろう！
#. de: Noch immer nicht genug? Also gut, machen wir Ernst!
#. fr: Votre ténacité est louable... mais vous ne pouvez rien contre mon incommensurable puissance<nbsp>!
msgctxt "NpcYell:6634:0:13"
msgid "Yes, hold your heads high... My gales will sever them before long."
msgstr ""

#. ja: 小癪な者どもめ……遊びは終いだ！<br>暴風の魔王たる所以、見せつけてくれるわ！
#. de: Sterbliche, das Spiel ist aus! Niemand trotzt meinen Stürmen.
#. fr: C'en est fini de vous, impudents humains<nbsp>! Mes bourrasques vont vous réduire en charpie<nbsp>!
msgctxt "NpcYell:6635:0:13"
msgid "Defy me not, for I am your lord! I am your god! I am Pazuzu! "
msgstr ""

#. ja: 我が名はパズズ……
#. de: Ich bin Pazuzu!
#. fr: Mon nom est Pazuzu...
msgctxt "NpcYell:6636:0:13"
msgid "I witness this windswept land, and claim it my own."
msgstr ""

#. ja: 風巡るこの地は、我が支配下に置かれた……！
#. de: Wo der Wind weht, herrsche ich!
#. fr: ... et cette terre est à moi<nbsp>!
msgctxt "NpcYell:6637:0:13"
msgid "This land, and the rabble who walk upon it!"
msgstr ""

#. ja: 不快なる人どもめ、我にひれ伏せ！
#. de: Kniet vor mir nieder!
#. fr: Qu'elle soit purifiée de toute présence humaine<nbsp>!
msgctxt "NpcYell:6638:0:13"
msgid "Lay down your arms and rejoice before your lord!"
msgstr ""

#. ja: しゅ～…<br>負傷者は下がっておれ！
#. de: Die Verwundeten sollen sich zurückziehen!
#. fr: Que les blessées se replient<nbsp>! Ssss...
msgctxt "NpcYell:6639:0:13"
msgid "Get the wounded to safety!"
msgstr ""

#. ja: さあ、暴れるよ！
#. de: Du gehörst mir!
#. fr: Prrrends ça<nbsp>!
msgctxt "NpcYell:6640:0:13"
msgid "You're mine!"
msgstr ""

#. ja: こらこら！<br>無茶しないどくれ！
#. de: Hauptmann Alpa! Überlass das Kämpfen uns!
#. fr: Ne prrrends pas trop de risques, Alpa<nbsp>!
msgctxt "NpcYell:6641:0:13"
msgid "Alpa! Don't get carried away!"
msgstr ""

#. ja: ●さすが光の戦士
#. de: 0
#. fr: 0
msgctxt "NpcYell:6642:0:13"
msgid "0"
msgstr ""

#. ja: よそ見してんじゃないよ！
#. de: Lass sie in Frieden, du Mörderin!
#. fr: C'est parrr ici que ça se passe<nbsp>!
msgctxt "NpcYell:6643:0:13"
msgid "Get away from her, you bitch!"
msgstr ""

#. ja: 助かったのじゃ！
#. de: Danke, J'ohlmyn.
#. fr: Merci<nbsp>! Ssss...
msgctxt "NpcYell:6644:0:13"
msgid "I owe you one, J'olhmyn!"
msgstr ""

#. ja: さあ、糧は糧らしく、皿の上に乗りなさい！
#. de: Komm, liebes Fresschen! Komm auf mein Tellerchen!
#. fr: Hiii hi hi hi<nbsp>! Je sens que je vais me régaler<nbsp>!
msgctxt "NpcYell:6645:0:13"
msgid "Now, now. Be a good meal and lie still."
msgstr ""

#. ja: こ、このワタクシの顔に、傷を……<br>許せない、許せない、許せないいいいぃぃぃぃ！
#. de: Mein hübsches Antlitz entstellt?! Welch ungeheurer Frevel!
#. fr: Une égratignure... sur mon beau visage<nbsp>!? Je ne vous le pardonnerai jamais<nbsp>! Vous allez souffrir pour l'éternité<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6646:0:13"
msgid "Is this...<i>my</i> blood? Why is it not <i>your</i> blood!<br>Your blood, your bloodyourbloodyourBLOOOOOOD!"
msgstr ""

#. ja: おやおや、美味しそうな命の輝きを見つけたわ……。
#. de: Ich sehe schmackhaftes Lebenslicht!
#. fr: Mmmm... Voilà des proies fort ap<shy>pé<shy>tis<shy>san<shy>tes...
msgctxt "NpcYell:6647:0:13"
msgid "My, what a tantalizingly pure soul you have!"
msgstr ""

#. ja: 魔の王妃たるワタクシに、命を捧げにきたのかしら？
#. de: Ist es gekommen, um sich mir zu opfern?
#. fr: Vous immoler sur mon autel sera le plus grand des plaisirs...
msgctxt "NpcYell:6648:0:13"
msgid "And you've come all this way to offer it to me."
msgstr ""

#. ja: ならば、血の饗宴の幕を開けましょう！
#. de: Dann möge das blutige Bankett beginnen!
#. fr: ... et voir votre sang couler à flots, la plus immense des jouissances<nbsp>!
msgctxt "NpcYell:6649:0:13"
msgid "I can hardly wait...so I shan't. Let the feast begin!"
msgstr ""

#. ja: シュー…いったん退くぞ！
#. de: Wir können hier nicht mehr helfen ...
#. fr: Nous comptons sur vous<nbsp>! Ssss...
msgctxt "NpcYell:6650:0:13"
msgid "We should withdraw for now."
msgstr ""

#. ja: シュー…すまない…
#. de: Diese Heldentat werden wir euch nicht vergessen.
#. fr: Bonne chance... Ssss...
msgctxt "NpcYell:6651:0:13"
msgid "Your bravery will not be forgotten."
msgstr ""

#. ja: 戦闘プログラム<br>コピー開始…
#. de: Kopiere Kampfprogramm<nbsp>...
#. fr: Copie du programme de combat...
msgctxt "NpcYell:6652:0:13"
msgid "COPYING PROGRAM..."
msgstr ""

#. ja: 戦闘プログラム<br>ペースト完了…
#. de: Kampfprogramm übernommen.
#. fr: Programme de combat appliqué.
msgctxt "NpcYell:6653:0:13"
msgid "PASTING PROGRAM..."
msgstr ""

#. ja: 戦闘プログラム<br>スキップ・ローディング…
#. de: Überspringe Kampfprogramm<nbsp>...
#. fr: Saut du prochain programme...
msgctxt "NpcYell:6654:0:13"
msgid "SKIPPING PROGRAM..."
msgstr ""

#. ja: 戦闘プログラム<br>リバース・ローディング…
#. de: Empfange Kampfprogramm<nbsp>...
#. fr: Retour au programme précédent...
msgctxt "NpcYell:6655:0:13"
msgid "RETRIEVING PROGRAM..."
msgstr ""

#. ja: ワシはマジメな人間じゃ…<br>すんなりここを通してやろう
#. de: Der Klügere gibt nach!
#. fr: Je suis plutôt faible et je déteste me battre, alors je crois que je vais vous laisser passer...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6656:0:13"
msgid "I hate fighting so I<br>better let you pass!"
msgstr ""

#. ja: また出ちゃった、しつこい？<br>だって、タコだもん
#. de: Ich habe mehr Leben als Arme!
#. fr: Vous pensiez ne plus me revoir<nbsp>? Mais c'est dans ma nature d'être collant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6657:0:13"
msgid "I have more lives<br>than I do arms!"
msgstr ""

#. ja: 動体センサー起動…<br>目標の座標移動を検索…
#. de: Bewegungssensoren aktiviert<nbsp>...<br>Berechne Pfade des Ziels<nbsp>...
#. fr: Détecteur de mouvements activé.<br>Calcul des déplacements de la cible...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6658:0:13"
msgid "MOTION TRACKING ACTIVATED...<br>CALCULATING TRAJECTORIES..."
msgstr ""

#. ja: 頑丈さがオレのウリだ！
#. de: Habt keine Angst! Die Macht der Liebe ist auf unserer Seite!
#. fr: Me voilà à la rrrescousse, Maître<nbsp>!
msgctxt "NpcYell:6659:0:13"
msgid "Have no fear! The power of love is on our side!"
msgstr ""

#. ja: 妙なところに<br>迷い込んじまったッァ…
#. de: Bin ich aber an ganz schön komische Ort gelandet, kha!
#. fr: Nom d'un oisillon déplumé, cet endroit est vraiment bizarre...
msgctxt "NpcYell:6660:0:13"
msgid "Squawk? This place..."
msgstr ""

#. ja: だけどなんだか<br>懐かしい気もするぜッェ…
#. de: Aber irgendwie kommt auch bekannt vor<nbsp>...
#. fr: Mais celui-ci a l'impression de le connaître depuis longtemps...
msgctxt "NpcYell:6661:0:13"
msgid "Strangely familiar, it is."
msgstr ""

#. ja: こ、この化け物…<br>なぜオレを襲わないッィ！？
#. de: Komische Viecher! Warum mich nicht angreifen, kha?
#. fr: Hein<nbsp>? Pourquoi ce monstre n'attaque pas celui-ci<nbsp>?
msgctxt "NpcYell:6662:0:13"
msgid "Ignore me, these creatures do. But why...?"
msgstr ""

#. ja: ま、まさか、こいつは…<br>ご先祖サマかッァ！？
#. de: Der Kollege da etwa<nbsp>... Vorfahre von Ixal sein?
#. fr: Non, ce n'est pas possible... Voilà donc l'ancêtre des Ixali<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6663:0:13"
msgid "Squawk! Squawk! How is this possible!?<br>Strongly resembles the Ixal, this feathered one does."
msgstr ""

#. ja: 化け物ども…<br>オレをこいつと間違えて…
#. de: Ob Wächter hier mich mit dem verwechseln, kha?
#. fr: Les monstres... Ils confondent celui-ci avec... cette créature...
msgctxt "NpcYell:6664:0:13"
msgid "Those creatures... Mistake me for this, I fear."
msgstr ""

#. ja: ●やるな光の戦士たち
#. de: 0
#. fr: 0
msgctxt "NpcYell:6665:0:13"
msgid "0"
msgstr ""

#. ja: ●いい戦いだった
#. de: 0
#. fr: 0
msgctxt "NpcYell:6666:0:13"
msgid "0"
msgstr ""

#. ja: エーテル異常の原因究明<br>頼みましたよ！
#. de: Finde die Ursache der Ätheranomalie!
#. fr: Je compte sur vous pour trouver la source de cette mystérieuse énergie<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6667:0:13"
msgid "You go on ahead, <split \" \" 1><string $gs1></split>.<br>I'll, uh...wait here."
msgstr ""

#. ja: お疲れ様でした…<br>ご無事で何よりです！
#. de: Ein Glück ist dir nichts passiert. Ausgezeichnete Arbeit!
#. fr: Merci infiniment, <if $gn4>Dame<else>Messire</if> <split " " 2><string $gs1></split><nbsp>! Les Douze vous le revaudront<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6668:0:13"
msgid "<split \" \" 1><string $gs1></split>! Thank the Twelve you're okay.<br>What say we get out of here, eh?"
msgstr ""

#. ja: シュー…屈するわけには！
#. de: Wir werden nicht weichen!
#. fr: Nous ne faiblirons pas<nbsp>! Ssss...
msgctxt "NpcYell:6669:0:13"
msgid "We shall not yield!"
msgstr ""

#. ja: シュー…目を覚ますのだ！
#. de: Schwessstern! Wacht auf!
#. fr: Ouvrez les yeux, chères sœurs<nbsp>! Ssss...
msgctxt "NpcYell:6670:0:13"
msgid "Why mussst you be ssso blind?"
msgstr ""

#. ja: シュー…やられるわけには！
#. de: Das ist nicht Lakshmisss Wille!
#. fr: La véritable Déesse nous protège<nbsp>! Ssss...
msgctxt "NpcYell:6671:0:13"
msgid "Sssisters! Do not sssuccumb!"
msgstr ""

#. ja: しゅ～…やらせはせん！
#. de: Ich dulde keinen Schwesssternmord!
#. fr: Vous ne l'emporterez pas au paradis<nbsp>! Ssss...
msgctxt "NpcYell:6672:0:13"
msgid "I won't ssstand for this!"
msgstr ""

#. ja: しゅ～…<br>もうやめるのじゃ！
#. de: Dieser Wahnsinn hat nun ein Ende!
#. fr: Ça suffit<nbsp>! Ssss...
msgctxt "NpcYell:6673:0:13"
msgid "It ends now!"
msgstr ""

#. ja: しゅ～…<br>いい加減にするのじゃ！
#. de: So wollt ihr der Göttin der Schönheit huldigen?
#. fr: Vous l'aurez voulu<nbsp>! Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6674:0:13"
msgid "You're not Ananta─<br>You're animals!"
msgstr ""

#. ja: しゅ～…ここが正念場じゃ！
#. de: Jetzt ist die Zeit gekommen, dasss Schwert in die Hand zu nehmen!
#. fr: Le moment de vérité est arrivé<nbsp>! Ssss...
msgctxt "NpcYell:6675:0:13"
msgid "Time for me to prove myssself!"
msgstr ""

#. ja: 命は大事にしな！
#. de: Hauptmann, riskier nicht zu viel!
#. fr: Attention, ça va fairrre des étincelles<nbsp>!
msgctxt "NpcYell:6676:0:13"
msgid "It'll all be for nothing if you get yourself killed!"
msgstr ""

#. ja: 怪我しても知らないよ？
#. de: Ich kann dich in dem Getümmel nicht beschützen.
#. fr: Alorrrs, on a mal<nbsp>?
msgctxt "NpcYell:6677:0:13"
msgid "Don't blame me if you wind up dead!"
msgstr ""

#. ja: まだやる気かい？
#. de: Habt ihr noch nicht genug?
#. fr: Vous en voulez encorrre<nbsp>?
msgctxt "NpcYell:6678:0:13"
msgid "Haven't you had enough yet?"
msgstr ""

#. ja: もう観念しな！
#. de: Die Grenzwache duldet keine Mörder!
#. fr: Vous ferrriez mieux d'abandonner<nbsp>!
msgctxt "NpcYell:6679:0:13"
msgid "You've bitten off more than you can chew!"
msgstr ""

#. ja: 高まれ、オレのヌン力！
#. de: Ich bin der Stärkste aller M!
#. fr: Que la forrrce des Nunh soit avec moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6680:0:13"
msgid "Behold the strength of a nunh!<br>Future nunh, anyway..."
msgstr ""

#. ja: 効かねぇな！
#. de: Mit dir werde ich doch spielend fertig.
#. fr: Il vous en faudra plus pour m'avoirrr<nbsp>!
msgctxt "NpcYell:6681:0:13"
msgid "It'll take more than that to stop me!"
msgstr ""

#. ja: 帰って読書したいです…
#. de: Ich lese ja lieber über Schlachten als sie selber zu kämpfen.
#. fr: Je prrréférerais avoir un bon livre entre les mains...
msgctxt "NpcYell:6682:0:13"
msgid "I'd rather be reading a book..."
msgstr ""

#. ja: 少し休んでもいいですか！
#. de: Die Viper sehnt sich nach einer kleinen Ver<shy>schnauf<shy>pause<nbsp>...
#. fr: Désolée, j'ai besoin de fairrre une pause<nbsp>!
msgctxt "NpcYell:6683:0:13"
msgid "Does anyone fancy taking a break?"
msgstr ""

#. ja: さあ、我が姿を<br>目に焼き付けるのです！
#. de: Möge sich mein Anblick in eure Augen brennen!
#. fr: Admirez les courbes de mon corps, et n'oubliez jamais<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6684:0:13"
msgid "Look upon me!<br>Behold the divine!"
msgstr ""

#. ja: これは甘くも切ない<br>死の契約……！
#. de: Oh, bittersüßer Abschied<nbsp>...
#. fr: La mort... Si douce, et si douloureuse à la fois... 
msgctxt "NpcYell:6685:0:13"
msgid "Bittersweet the parting..."
msgstr ""

#. ja: 恐怖ニ背ヲ向ケルカ？
#. de: Kehrt ihr dem Schrecken den Rücken zu?
#. fr: Vas-tu fuir devant tes peurs<nbsp>?
msgctxt "NpcYell:6686:0:13"
msgid "You turn your back on terror?"
msgstr ""

#. ja: 恐怖ニ向キ合ウカ？
#. de: Schaut ihr der Angst ins Gesicht?
#. fr: Sauras-tu affronter tes peurs<nbsp>?
msgctxt "NpcYell:6687:0:13"
msgid "You dare lock eyes with fear?"
msgstr ""

#. ja: 「火の絵画」よ！<br>燃やし尽くせ！
#. de: Gemälde des Feuers! Die Welt steht in Flammen!
#. fr: Ô, peinture du feu<nbsp>! Attise les flammes de la colère et brûle jusqu'à tout réduire en cendres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6688:0:13"
msgid "A portrayal of fire!<br>Your world in flames!"
msgstr ""

#. ja: 「風の絵画」よ！<br>吹き荒れるがいい！
#. de: Gemälde des Windes! Sein Heulen erklingt!
#. fr: Ô, peinture du vent<nbsp>! Fais se lever ta plus terrible tempête pour tout déchirer et arracher<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6689:0:13"
msgid "A portrayal of wind!<br>A shrieking gale!"
msgstr ""

#. ja: 「水の絵画」よ！<br>すべてを呑み込め！
#. de: Gemälde des Wassers! Alles ertrinke!
#. fr: Ô, peinture de l'eau<nbsp>! Emporte et détruit de tes flots furieux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6690:0:13"
msgid "A portrayal of water!<br>All is drowned!"
msgstr ""

#. ja: 「土の絵画」よ！<br>大地を揺るがせ！
#. de: Gemälde der Erde! Der Boden erzittert!
#. fr: Ô, peinture de la terre<nbsp>! Fais trembler le sol jusqu'au plus profond de ses entrailles<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6691:0:13"
msgid "A portrayal of earth!<br>The ground shall shudder!"
msgstr ""

#. ja: ラ…ララ…<br>風ヨ…踊レ…
#. de: Lalala<nbsp>... Tanze, oh Wind!
#. fr: ♪ Laaa la la... Le vent danse, danse, danse...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6692:0:13"
msgid "Whither goes the wind,<br>Her dance unseen by thee?♪"
msgstr ""

#. ja: ララ…ラ…ララ…<br>生命ノ風…
#. de: Lalalalalaaa<nbsp>... Wind des Lebens!
#. fr: ♪ La laaa la la laaa... Vent de la vie, vent de l'énergie...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6693:0:13"
msgid "Bearing seeds afar,<br>Breeze knows no boundary.♪"
msgstr ""

#. ja: ラララ…ララ…<br>綺麗ナ命…
#. de: La-lalalala<nbsp>... Schmackhaftes Leben!
#. fr: ♪ La la laaa la laaa... Beauté de la vie, beauté de l'énergie...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6694:0:13"
msgid "To those blessed with life,<br>Her boon is but to be.♪"
msgstr ""

#. ja: すごいクポ♪
#. de: Ihr gebt ein hübsches Paar ab, kupo!<nbsp>♪
#. fr: Quel couple adorable, kupo<nbsp>!♪
msgctxt "NpcYell:6695:0:13"
msgid "You look beautiful together, kupo!"
msgstr ""

#. ja: ヒューヒュークポ♪
#. de: Sie sehen traumhaft zusammen aus, kupo<nbsp>...<nbsp>♪
#. fr: Votre rencontre devait être écrite, kupo<nbsp>!♪
msgctxt "NpcYell:6696:0:13"
msgid "They're so dreamy, kupo..."
msgstr ""

#. ja: 奇跡のふたりクポ♪
#. de: Das Schicksal hat sie füreinander bestimmt, kupo!<nbsp>♪
#. fr: C'est l'image de l'union parfaite, kupo<nbsp>!♪
msgctxt "NpcYell:6697:0:13"
msgid "It's destiny, kupo!"
msgstr ""

#. ja: ちょいと待ちな！オレさまは、<br>世界一の剣士ジークフリード
#. de: Ich bin Siegfried, der beste Schwertkämpfer der Welt!
#. fr: Je suis Siegfried, le meilleur bretteur du monde entier<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6698:0:13"
msgid "I am Siegfried, the greatest<br>swordsman in all the world!"
msgstr ""

#. ja: いくぞ！こわっぱ！！<br>うりゃりゃりゃーー！！
#. de: Ihr hättet fliehen sollen! Spürt meinen Zorn!
#. fr: <if $gn4>Prête<else>Prêt</if><nbsp>? En garde<nbsp>!<br>Hiyaaaaaa<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6699:0:13"
msgid "You should have fled!<br>Now feel my wrath!"
msgstr ""

#. ja: またこいつか
#. de: Den kennen wir doch!
#. fr: Encore un de ces écrans brimbalants...
msgctxt "NpcYell:6700:0:13"
msgid "This again...?"
msgstr ""

#. ja: 三歌姫の公演が<br>始まるぞ！
#. de: Das Konzert fängt gleich an!
#. fr: Ça va bientôt commencer<nbsp>!
msgctxt "NpcYell:6701:0:13"
msgid "The show's about to begin!"
msgstr ""

#. ja: さあ、はやく、はやく！
#. de: Na, dann nichts wie hin!
#. fr: Allez, faut se dépêcher<nbsp>!
msgctxt "NpcYell:6702:0:13"
msgid "Hurry, hurry!"
msgstr ""

#. ja: みんな～、今日はめいっぱい、楽しんじゃおう♪
#. de: Los geht's, Leute ♪
#. fr: Vous êtes si nombreux, ça fait plaisir<nbsp>!♪
msgctxt "NpcYell:6703:0:13"
msgid "Alright, everyone. Are you ready for some fun?"
msgstr ""

#. ja: ウララには、「赤」の声援だからね♪
#. de: Ich will rote Lichter sehen, ist das klar?
#. fr: Les fans d'Ulala<nbsp>! Sortez vos bâtons rouges<nbsp>!♪
msgctxt "NpcYell:6704:0:13"
msgid "I hope you have your red lights ready. Tee hee hee."
msgstr ""

#. ja: 来場してくださって、ありがとうございます！
#. de: Vielen Dank, dass ihr gekommen seid!
#. fr: Merci d'être venus nous encourager<nbsp>!
msgctxt "NpcYell:6705:0:13"
msgid "Thank you all so much for coming."
msgstr ""

#. ja: 頑張りますので、「黄」の声援をお願いします！
#. de: Zeigt mir ein gelbes Lichtermeer! Ich streng mich auch an!
#. fr: Ma couleur fétiche, c'est le jaune<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:6706:0:13"
msgid "Let's make this a Little Ladies' Day to remember, with plenty of <i>yellow</i> lights, if you please."
msgstr ""

#. ja: さあ、準備はいい？　はりきっていくわよ！
#. de: Haltet euch fest, wir legen jetzt los!
#. fr: Nous allons tout donner pour vous<nbsp>!
msgctxt "NpcYell:6707:0:13"
msgid "Quite a large crowd today, isn't it girls?"
msgstr ""

#. ja: アタシには、「青」の声援をよろしく！
#. de: Zeigt mir eure blauen Kleider!
#. fr: Je veux voir du bleu<nbsp>!
msgctxt "NpcYell:6708:0:13"
msgid "Should make for quite the sight with all of their blue lights, am I right?"
msgstr ""

#. ja: ウララちゃ～ん♪
#. de: Ulalaaa ♪
#. fr: Ulala<nbsp>! Ulala<nbsp>! Ulala<nbsp>!
msgctxt "NpcYell:6709:0:13"
msgid "Ooh la la, Ulala!"
msgstr ""

#. ja: ナルミ～！
#. de: Narumiii!
#. fr: On est avec toi, Narumi<nbsp>!
msgctxt "NpcYell:6710:0:13"
msgid "We love you, Narumi!"
msgstr ""

#. ja: マシャ～！
#. de: Maaasha!
#. fr: Masha, on t'aime<nbsp>!
msgctxt "NpcYell:6711:0:13"
msgid "You're the best, Masha!"
msgstr ""

#. ja: うおおおお！
#. de: Irre!
#. fr: Ouaaaaiiiis<nbsp>!
msgctxt "NpcYell:6712:0:13"
msgid "Wooo!"
msgstr ""

#. ja: キャ～！
#. de: Drosseln!
#. fr: Allez, les Églantines<nbsp>!
msgctxt "NpcYell:6713:0:13"
msgid "I love this song!"
msgstr ""

#. ja: こっち向いて～！
#. de: Hier bin ich!
#. fr: Un clin d'œil par ici, s'il vous plaît<nbsp>!
msgctxt "NpcYell:6714:0:13"
msgid "Look over here!"
msgstr ""

#. ja: 応援ありがと～♪
#. de: Danke fürs Anfeuern!
#. fr: Merci, les amis<nbsp>!♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6715:0:13"
msgid "That's all for now.<br>But we'll be back!"
msgstr ""

#. ja: みなさん！<br>ありがとうございます！
#. de: Danke Leute, ihr wart echt spitze!
#. fr: Vous avez été géniaux<nbsp>!
msgctxt "NpcYell:6716:0:13"
msgid "Thank you again for coming."
msgstr ""

#. ja: みんなのおかげで<br>公演は大成功よ♪
#. de: Ihr seid unglaublich! Vielen Dank!
#. fr: Quelle émotion... Mon cœur bat la chamade<nbsp>! Merci à vous tous<nbsp>!
msgctxt "NpcYell:6717:0:13"
msgid "You were all fantastic. Thank you!"
msgstr ""

#. ja: 最高だったぞ～！
#. de: Tolles Konzert!
#. fr: C'était le plus beau concert de toute ma vie<nbsp>!
msgctxt "NpcYell:6718:0:13"
msgid "They were amazing."
msgstr ""

#. ja: 楽しかった～！
#. de: Hat riesig Spaß gemacht!
#. fr: Les Églantines étaient incroyables, j'en reviens toujours pas<nbsp>!
msgctxt "NpcYell:6719:0:13"
msgid "That was so much fun."
msgstr ""

#. ja: うおおお！<br>もう一度、見たいぞ！
#. de: Wahnsinn! Ich freu mich schon auf den nächsten Auftritt!
#. fr: Je vais me faire porter pâle et aller à tous les concerts suivants, ah ah ah<nbsp>!
msgctxt "NpcYell:6720:0:13"
msgid "I can hardly wait for the next show."
msgstr ""

#. ja: きんにくモリモリ…嫌いだ～！
#. de: Wie ich Muskelprotze hasse.
#. fr: Je déteste la gonflette<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6721:0:13"
msgid "Ugh, all those muscles.<br>You're not my type!"
msgstr ""

#. ja: おまえのかお…こわーい！
#. de: Jetzt lach doch mal ein bisschen!
#. fr: Tu es moche comme un pou<nbsp>!
msgctxt "NpcYell:6722:0:13"
msgid "Lighten up, will ya?"
msgstr ""

#. ja: こんな相手に…！
#. de: Von einem unwürdigen Gegner bedrängt!
#. fr: Pas si facilement...
msgctxt "NpcYell:6723:0:13"
msgid "You have not won yet."
msgstr ""

#. ja: いきます！
#. de: Nimm das!
#. fr: Prenez ça<nbsp>!
msgctxt "NpcYell:6724:0:13"
msgid "Try this!"
msgstr ""

#. ja: これなら！
#. de: Also gut!
#. fr: Ce coup-là va faire mal<nbsp>!
msgctxt "NpcYell:6725:0:13"
msgid "I have you!"
msgstr ""

#. ja: そこをどけッ！
#. de: Weg da!
#. fr: Hors de ma vue<nbsp>!
msgctxt "NpcYell:6726:0:13"
msgid "Away with you!"
msgstr ""

#. ja: 甘く見ないでください！
#. de: Hochmut kommt vor dem Fall!
#. fr: Ne me sous-estimez pas<nbsp>!
msgctxt "NpcYell:6727:0:13"
msgid "Taste my steel!"
msgstr ""

#. ja: 隙ありです！
#. de: Mir darf man keine Lücke bieten!
#. fr: Touché<nbsp>!
msgctxt "NpcYell:6728:0:13"
msgid "No quarter!"
msgstr ""

#. ja: さあ、勝負ですッ！
#. de: Machen wir ernst!
#. fr: Le moment de vérité<nbsp>!
msgctxt "NpcYell:6729:0:13"
msgid "Prepare yourself!"
msgstr ""

#. ja: クエッ！
#. de: Kweh!
#. fr: Kwé<nbsp>!
msgctxt "NpcYell:6730:0:13"
msgid "Kweh!"
msgstr ""

#. ja: そこまでだ…<br>こいつは効くぜぇ？
#. de: Euch zerleg ich in Einzelteile!
#. fr: Bon, assez joué comme ça. Attention, ça va faire mal<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6731:0:13"
msgid "One last test...<br>This should help<br>wrap things up."
msgstr ""

#. ja: シュー…<br>まとめて燃やし尽くす！
#. de: Brennt! Brennt im heilenden Feuer Lakshmis!
#. fr: Je vais vous faire rôtir<nbsp>! Ssss...
msgctxt "NpcYell:6732:0:13"
msgid "I will cassst your ashes to the wind!"
msgstr ""

#. ja: ゲホッ、ゴホッ…！
#. de: \<hust> \<hust>
#. fr: (tousse) (tousse)
msgctxt "NpcYell:6733:0:13"
msgid "\\<cough> \\<sputter>"
msgstr ""

#. ja: こんな行き止まりに<br>何の用だ？
#. de: Hier geht's nicht weiter<nbsp>...
#. fr: Vous n'irez pas plus loin<nbsp>!
msgctxt "NpcYell:6734:0:13"
msgid "Good day, fine sirs, how may I be of service?"
msgstr ""

#. ja: この上だ、急ぎな！
#. de: Schnell, die Stufen hoch!
#. fr: Grimpez là-haut, vite<nbsp>!
msgctxt "NpcYell:6735:0:13"
msgid "Hurry, up these stairs!"
msgstr ""

#. ja: 下はあらかた片付いた<br>こいつらを叩くぞ！
#. de: Unten sind alle erledigt. Knöpfen wir uns jetzt den Rest vor!
#. fr: La plage est à nous<nbsp>! Plus qu'à en finir ici<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6736:0:13"
msgid "The beach is clear.<br>Just the ones here now!"
msgstr ""

#. ja: 伸びろ、金箍棒！
#. de: Wachse, Jingu Bang!
#. fr: Allonge-toi, Jingu Bang<nbsp>!
msgctxt "NpcYell:6737:0:13"
msgid "Comply! O Golden-hooped Rod!"
msgstr ""

#. ja: すごいニャ！<br>狩猟成功だニャ！
#. de: Wir haben ihn erjagt! \<miau>
#. fr: 0
msgctxt "NpcYell:6738:0:13"
msgid "0"
msgstr ""

#. ja: 忘れずに<br>素材を剥ぎ取るニャ！
#. de: Vergiss nicht, dir den Kadaver anzusehen!
#. fr: 0
msgctxt "NpcYell:6739:0:13"
msgid "0"
msgstr ""

#. ja: そおら！
#. de: Verlogenes Doma! Es soll in ewiger Nacht versinken!
#. fr: Vous allez apprécier ces deux bouffées<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6740:0:13"
msgid "Just a puff or two<br>before we go on!"
msgstr ""

#. ja: お座敷遊びといこうか！
#. de: Wie die Freier geiferten und glotzten, wenn ich meinen Fächer senkte<nbsp>...
#. fr: Jouons au lancer d'éventail<nbsp>! Mes clients en raffolaient<nbsp>!
msgctxt "NpcYell:6741:0:13"
msgid "A courtesan has her tricks!"
msgstr ""

#. ja: 鳴いておくれよ？
#. de: Winseln sollt ihr!
#. fr: Implorez ma merci<nbsp>!
msgctxt "NpcYell:6742:0:13"
msgid "Beg for mercy!"
msgstr ""

#. ja: いつまで保つかねぇ？
#. de: Wie lang wollt ihr euch noch quälen?
#. fr: Vous vous obstinez pour rien<nbsp>!
msgctxt "NpcYell:6743:0:13"
msgid "Your end is near!"
msgstr ""

#. ja: ひねり潰してくれる！
#. de: Ich werde euch zerquetschen!
#. fr: Je vais tous vous écraser<nbsp>!
msgctxt "NpcYell:6744:0:13"
msgid "I'll grind you under my heel!"
msgstr ""

#. ja: 忌々しい！
#. de: Ihr widert mich an!
#. fr: Créatures infectes<nbsp>!
msgctxt "NpcYell:6745:0:13"
msgid "Worm!"
msgstr ""

#. ja: ツ…よ…<br>…きる…だ…！
#. de: Verlässt du mich heute für immer?
#. fr: Résis... à... l'ap... de la hai... Tsu...<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6746:0:13"
msgid "Tsuyu...<br>Must...survive..."
msgstr ""

#. ja: ナエウリの忌み子め…
#. de: Womit haben die armen Naeuri dieses Unglückskind verdient?
#. fr: Naeuri la martyre... Tu mérites tout ce qu'il t'arrive<nbsp>!
msgctxt "NpcYell:6747:0:13"
msgid "Naeuri's cursed orphan!"
msgstr ""

#. ja: サシハイの寡婦がッ！
#. de: <i>Sie</i> hat den armen Sashihai ins Grab gebracht! Soll sie ihm dahin folgen!
#. fr: Sashihai la veuve noire... Sale peste<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6748:0:13"
msgid "Widow of Sashihai...<br>Witch of Doma!"
msgstr ""

#. ja: 成り上がりの女蛮族が！
#. de: Emporgekommende Wilde!
#. fr: Parvenue<nbsp>! Tu resteras qu'une sauvage à nos yeux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6749:0:13"
msgid "Your fall from grace is<br>long overdue, savage!"
msgstr ""

#. ja: 上手く取り入ったもんだ！
#. de: Die domanische Hure hat ihre Karriere doch nur im Bett gemacht!
#. fr: On sait tous comment t'es arrivée là où t'es<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6750:0:13"
msgid "Artful wiles won't<br>save you now!"
msgstr ""

#. ja: 役に立たぬなら<br>死ねばいい！
#. de: Wir hätten die Göre schon längst ermorden sollen!
#. fr: Crève, puisque t'es incapable de faire quoi que ce soit<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6751:0:13"
msgid "Worthless, I say.<br>Might as well be dead!"
msgstr ""

#. ja: その顔を<br>二度と見せないでおくれ！
#. de: Ich will dein aufmüpfiges Gesicht nie wieder sehen müssen!
#. fr: Ne nous inflige plus jamais ta vue<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6752:0:13"
msgid "Just the sight of<br>your face sickens me!"
msgstr ""

#. ja: お前がいなければ<br>俺がゼノス様にッ！
#. de: Nur <i>mir</i> steht es zu, Prinz Zenos zu dienen!
#. fr: Sans toi, c'est moi qui aurais été le bras droit du seigneur Zenos<nbsp>!
msgctxt "NpcYell:6753:0:13"
msgid "I should have been the one!"
msgstr ""

#. ja: アサヒ…<br>お前は…お前だけは…
#. de: Asahi ... Elender Asahi!
#. fr: Asahi... Tu... Tu ne t'en...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6754:0:13"
msgid "Asahi...<br>You, more than any other..."
msgstr ""

#. ja: 嗚呼…<br>なぜ…なぜなの？
#. de: Du hast mir <i>Kraft</i> versprochen<nbsp>...
#. fr: Que... (souffle)... (souffle)... Que fais-tu...<nbsp>?
msgctxt "NpcYell:6755:0:13"
msgid "How did it come to this?"
msgstr ""

#. ja: 邪魔だ…
#. de: Ich spiele dein Spiel nicht mehr mit!
#. fr: Tu ne m'arrêteras pas...
msgctxt "NpcYell:6756:0:13"
msgid "Tedious..."
msgstr ""

#. ja: ぬおおおっ！
#. de: Uaaaaah!
#. fr: MOUUUOH<nbsp>!
msgctxt "NpcYell:6757:0:13"
msgid "Hrrrgh!"
msgstr ""

#. ja: どりゃあ！
#. de: Huaaarh!
#. fr: La castagne, ça me connaît<nbsp>!
msgctxt "NpcYell:6758:0:13"
msgid "Yargh!"
msgstr ""

#. ja: 哀れだな…
#. de: Erbärmlich ...
#. fr: Hmpf, pitoyable...
msgctxt "NpcYell:6759:0:13"
msgid "Savor your hollow victory..."
msgstr ""

#. ja: 護れなかったと<br>いうことか…！
#. de: Ich will dich nicht verlieren<nbsp>... Nicht noch einmal<nbsp>...
#. fr: Non<nbsp>! Je... Je n'ai pas été capable de la protéger...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6760:0:13"
msgid "I cannot...<br>I've failed you..."
msgstr ""

#. ja: う、うぅ…
#. de: Argh ...
#. fr: Argh... Ah<nbsp>!
msgctxt "NpcYell:6761:0:13"
msgid "Ugh..."
msgstr ""

#. ja: しっかりするのです！
#. de: Jetzt nicht bewegen!
#. fr: Accrochez-vous, soldats<nbsp>!
msgctxt "NpcYell:6762:0:13"
msgid "Keep as still as you can!"
msgstr ""

#. ja: あ、足が…<br>残骸に挟まれて…
#. de: Mein Bein<nbsp>... Es klemmt fest.
#. fr: Ma... Ma jambe... Elle est coincée...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6763:0:13"
msgid "My leg...<br>It...it's caught..."
msgstr ""

#. ja: 小賢しいマネを！
#. de: Lächerliche Kinderspielchen!
#. fr: Ah<nbsp>! Sales pleutres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6764:0:13"
msgid "Bah!<br>A child's trick!"
msgstr ""

#. ja: ウオオオオッ！
#. de: Uaaargh!
#. fr: Hiyaaah<nbsp>!
msgctxt "NpcYell:6765:0:13"
msgid "Gaaarrrggghhh!"
msgstr ""

#. ja: 助力に感謝するぞ！<br>少年！
#. de: Ich danke dir, Junge.
#. fr: Merci pour le coup de main, jeune homme<nbsp>!
msgctxt "NpcYell:6766:0:13"
msgid "My thanks, boy!"
msgstr ""

#. ja: 行け、我が下僕<br>カーバンクルちゃん！
#. de: Auf ihn mit Gebrüll, Karfunkel!
#. fr: À l'attaque, mon fidèle Carbuncle<nbsp>!<nbsp>...
msgctxt "NpcYell:6767:0:13"
msgid "Go, Carbuncle, go!♪"
msgstr ""

#. ja: …………
#. de: ...
#. fr: Hein<nbsp>!?<nbsp>...
msgctxt "NpcYell:6768:0:13"
msgid "..."
msgstr ""

#. ja: 敵前逃亡は処刑でっす！<br>戻ってくるでっす～！
#. de: He, weglaufen gilt nicht! Komm sofort zurück!
#. fr: Mais tu n'as pas honte de t'enfuir comme ça<nbsp>!? Reviens<nbsp>! Reviens tout de suite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
