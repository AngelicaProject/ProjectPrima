# NpcYell
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 皆、準備はいいな？<br>出発するぞ！
#. de: Seid ihr alle bereit zum Aufbruch?
#. fr: C'est bon, vous n'avez rien oublié<nbsp>? Alors en route<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6000:0:13"
msgid "It is time.<br>To the north and east!"
msgstr ""

#. ja: 待て…<br>様子がおかしい…
#. de: Halt, wer ist das?
#. fr: Attendez... Il y a quelque chose qui cloche...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6001:0:13"
msgid "Halt! It is too quiet...<br>Even the crickets do not sing..."
msgstr ""

#. ja: おい、止まれ！<br>家財と家畜を置いていけ！
#. de: He, ihr Vögel! Lasst eure Sachen liegen und verpisst euch!
#. fr: Plus un geste<nbsp>! Donnez-nous vos bêtes, et tout le reste tant qu'à faire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6002:0:13"
msgid "Drop your weapons and we'll<br>let your women live...with us!"
msgstr ""

#. ja: 略奪者に出会うとは…<br>応戦するぞ！
#. de: Wir lassen uns nicht so leicht ausrauben!
#. fr: (soupire) Quand sera-t-on enfin tranquilles<nbsp>? Aux armes<nbsp>!
msgctxt "NpcYell:6003:0:13"
msgid "Bandits!"
msgstr ""

#. ja: 危なかったが<br>切り抜けられたな…
#. de: Das ging gerade noch einmal gut ...
#. fr: On a eu chaud...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6007:0:13"
msgid "'Tis fortunate they were<br>drunk. Alcohol will gift a man<br>bravery...but always for a price."
msgstr ""

#. ja: に、逃げろっ！
#. de: Schnell weg!
#. fr: On-on s'tire<nbsp>!
msgctxt "NpcYell:6011:0:13"
msgid "Run!"
msgstr ""

#. ja: ひぃ！
#. de: Hilfe!
#. fr: Mamaaan<nbsp>!
msgctxt "NpcYell:6012:0:13"
msgid "Not without me you don't!"
msgstr ""

#. ja: 財産は頂いてく！
#. de: Euer Hab und Gut gehört jetzt uns!
#. fr: Tout ce qui est à vous est à nous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6013:0:13"
msgid "We'll be taking these...<br>and these...and also these."
msgstr ""

#. ja: グハハハハハ！<br>今夜は宴だ！
#. de: Hahahaha! Heute wird gefeiert!
#. fr: Mouahahaha<nbsp>! Aujourd'hui c'est jour de fête<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6014:0:13"
msgid "Hahaha! Tonight we dine<br>as champions of the steppe!"
msgstr ""

#. ja: この草原に<br>弱者の居場所はない！
#. de: In der Steppe überleben nur die Starken!
#. fr: Il n'y a pas de place pour les faibles dans la steppe<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6015:0:13"
msgid "The steppe is no<br>place for the weak!"
msgstr ""

#. ja: 追っ手が来る前に<br>移動するぞ！
#. de: Weg hier, bevor sie uns einholen!
#. fr: Partons avant que d'autres ennuis ne nous tombent dessus<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6016:0:13"
msgid "The bandits will tell others<br>of this battle, and they will<br>be drawn to the promise of<br>blood and plunder. We move!"
msgstr ""

#. ja: むっ！？
#. de: Hm?!
#. fr: ... Attendez... Je rêve ou...<nbsp>?
msgctxt "NpcYell:6017:0:13"
msgid "Sounds of fighting!"
msgstr ""

#. ja: おい！<br>誰かが襲われているぞ！
#. de: Wir werden angegriffen!
#. fr: Par Azim<nbsp>! Cette femme est en danger<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6018:0:13"
msgid "There! A lone warrior...and<br>a mammoth!"
msgstr ""

#. ja: このままでは危険よ！
#. de: Das sieht nicht gut aus!
#. fr: Elle ne va pas s'en sortir toute seule<nbsp>!
msgctxt "NpcYell:6019:0:13"
msgid "She will not survive."
msgstr ""

#. ja: 襲われた後は<br>人助けか…！
#. de: Sie ist verwundet!
#. fr: On vient de se faire attaquer, et maintenant on va sauver quelqu'un<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6020:0:13"
msgid "Then she will not survive.<br>That is the way of the steppe."
msgstr ""

#. ja: すぐに助けよう！
#. de: Los, helfen wir ihr!
#. fr: Nous devons la secourir<nbsp>!
msgctxt "NpcYell:6021:0:13"
msgid "No! We cannot just leave her!"
msgstr ""

#. ja: どうにか間に合ったようだ…
#. de: Das war gerade noch rechtzeitig.
#. fr: Heu<shy>reu<shy>se<shy>ment qu'on est arrivés à temps.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6022:0:13"
msgid "The steppe is full of enemies.<br>This is why we must embrace<br>newfound friends."
msgstr ""

#. ja: 大丈夫！？
#. de: Bist du verletzt?!
#. fr: Est-ce que ça va<nbsp>!?
msgctxt "NpcYell:6023:0:13"
msgid "There is little life left in her."
msgstr ""

#. ja: ひとりで出歩くなんて<br>無謀だぞ！
#. de: Allein ist es hier viel zu gefährlich.
#. fr: Faut pas se promener toute seule dans la steppe, c'est dangereux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6024:0:13"
msgid "She was a fool to<br>walk the steppe alone."
msgstr ""

#. ja: 気を失っているみたい…
#. de: Sie hat das Bewusstsein verloren.
#. fr: Elle a perdu con<shy>nais<shy>san<shy>ce...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6025:0:13"
msgid "That's no reason to leave<br>her to die, Anarba!"
msgstr ""

#. ja: このまま見捨てて<br>放置することはできん
#. de: So können wir sie hier nicht zurücklassen.
#. fr: On ne peut pas la laisser comme ça.
msgctxt "NpcYell:6026:0:13"
msgid "Altani speaks true."
msgstr ""

#. ja: 目的地とは違うが<br>ここに居留地を作ろう
#. de: Dann schlagen wir hier unser Lager auf.
#. fr: Installons-nous ici temporairement.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6027:0:13"
msgid "We shall make camp here<br>and decide as a tribe how<br>we are to proceed."
msgstr ""

#. ja: わかったわ<br>手当は私が…
#. de: Gut, ich kümmere mich um die Verletzte.
#. fr: Compris. Je m'occuperai d'elle en attendant qu'elle se rétablisse.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6028:0:13"
msgid "I will see to the<br>stranger's wounds."
msgstr ""

#. ja: アルタニ<br>何か気がかりでも？
#. de: Altani, hast du etwas entdeckt?
#. fr: Altani, il y a un problème<nbsp>?
msgctxt "NpcYell:6029:0:13"
msgid "Altani, you look uneasy."
msgstr ""

#. ja: 羊たちが怯えている…<br>不安そうにしているの…
#. de: Die Schafe sind unruhig. Sie haben Angst.
#. fr: Eh bien, mes brebis sont apeurées depuis qu'on s'est installés ici...
msgctxt "NpcYell:6030:0:13"
msgid "The sheep... They won't eat."
msgstr ""

#. ja: 近くに獣でも<br>潜んでいるのやもしれん
#. de: Vielleicht lauern Raubtiere in der Nähe?
#. fr: Hm... Il doit y avoir des prédateurs dans les environs.
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:6031:0:13"
msgid "Won't eat, you say?<br>That <i>is</i> odd..."
msgstr ""

#. ja: アルタニ、お前は<br>羊たちの側にいてやれ
#. de: Altani, bleib du bei den Schafen.
#. fr: Reste auprès de tes bêtes, Altani.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6032:0:13"
msgid "It might be they<br>sense something amiss."
msgstr ""

#. ja: 私は少しばかり<br>周囲を見回ってくる
#. de: Ich seh mich in der Gegend um.
#. fr: Je vais faire une ronde autour du camp.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6033:0:13"
msgid "You stay here while I see<br>if I cannot discover the<br>reason for their disquiet."
msgstr ""

#. ja: は、はいっ！<br>族長、お気を付けて…
#. de: Gut, Häuptling. Sei vorsichtig!
#. fr: D-d'accord. Fais attention à toi.
msgctxt "NpcYell:6034:0:13"
msgid "Yes, Khan! And...be careful."
msgstr ""

#. ja: やはりいたか…<br>グログロだな！？
#. de: Gulo Gulo?! Ich hatte es befürchtet.
#. fr: Je m'en doutais... Des gulo gulo.
msgctxt "NpcYell:6035:0:13"
msgid "Altani was right."
msgstr ""

#. ja: 羊たちから<br>怯えが消えたみたい…
#. de: Jetzt haben die Schafe keine Angst mehr.
#. fr: Mes brebis se sont enfin calmées.
msgctxt "NpcYell:6036:0:13"
msgid "The sheep will calm now."
msgstr ""

#. ja: む？<br>あの馬は…はぐれたのか？
#. de: Hm? Das Pferd ist davongelaufen?
#. fr: Tiens<nbsp>? D'où sort ce cheval<nbsp>? Il a perdu son maître<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6038:0:13"
msgid "That horse... It doesn't<br>appear to be one of ours."
msgstr ""

#. ja: ここにいては<br>獣に襲われるのがオチだ
#. de: Da wird es von Raubtieren gefressen.
#. fr: S'il reste ici, il ne va pas faire long feu...
msgctxt "NpcYell:6039:0:13"
msgid "Where is your rider, boy?"
msgstr ""

#. ja: 仕方あるまい<br>連れ帰るとするか…
#. de: Ich muss es zurückbringen.
#. fr: Bon, ramenons-le au camp.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6040:0:13"
msgid "You look hungry. Come with<br>me. Altani will see you fed<br>and watered."
msgstr ""

#. ja: な、なんとか…<br>諦めてくれたらしい…
#. de: Na, das ging gerade noch gut aus.
#. fr: Pfiou... On dirait qu'ils se sont lassés de nous...
msgctxt "NpcYell:6041:0:13"
msgid "They're finally leaving..."
msgstr ""

#. ja: 具合はどう？
#. de: Wie geht es dir?
#. fr: Comment tu te sens<nbsp>?
msgctxt "NpcYell:6042:0:13"
msgid "You're awake."
msgstr ""

#. ja: おかげさまで<br>どうにか…
#. de: Es wird schon wieder ...
#. fr: ... Mieux, grâce à vous.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6043:0:13"
msgid "I have you and your tribe<br>to thank for that."
msgstr ""

#. ja: ねぇねぇ<br>この馬ってもしかして…
#. de: Ich weiß, wem das Pferd gehören könnte.
#. fr: À propos, on a trouvé ce cheval. Est-ce que c'est le tien<nbsp>?
msgctxt "NpcYell:6044:0:13"
msgid "That's not all."
msgstr ""

#. ja: 嗚呼、貴方…<br>無事だったのね！
#. de: Oh, du lebst!
#. fr: Ah<nbsp>! Oui, c'est lui<nbsp>! Il n'a rien, Azim soit loué<nbsp>!
msgctxt "NpcYell:6045:0:13"
msgid "Bayan! You're... You're...!"
msgstr ""

#. ja: 申し遅れました…<br>私はゴロ族のグルベス…
#. de: Ich bin Gurbesu vom Stamm der Goro.
#. fr: Au fait, je ne me suis pas présentée. Je suis Gurbesu, des Goro.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6046:0:13"
msgid "My apologies. I was just so─<br>I am Gurbesu of the Goro."
msgstr ""

#. ja: こちらの馬は<br>夫のバヤンです…
#. de: Das ist mein Ehegatte, Bayan.
#. fr: Et lui, c'est Bayan, mon partenaire.
msgctxt "NpcYell:6047:0:13"
msgid "This is my promised, Bayan."
msgstr ""

#. ja: 狩りの最中に<br>マタンガ族に襲われて…
#. de: Auf der Jagd wurden wir von Matanga angegriffen.
#. fr: On chassait avec la tribu quand des Matangas nous ont attaqués.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6048:0:13"
msgid "My tribe's food tents were<br>destroyed in a Matanga raid."
msgstr ""

#. ja: 必死に逃げるうちに<br>マンモスの群れに…
#. de: Auf der Flucht gerieten wir mitten in eine Mammutherde.
#. fr: On est parvenus à s'enfuir de justesse. Mais juste après, un troupeau de mammouths nous a pris en chasse...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6049:0:13"
msgid "I went hunting to replenish<br>our supplies and in my<br>desperation─"
msgstr ""

#. ja: そこを俺たちが<br>見つけたってわけか…
#. de: Dort haben wir dich<br>entdeckt ...
#. fr: Et c'est là qu'on t'a trouvée.
msgctxt "NpcYell:6050:0:13"
msgid "Attacked a mammoth."
msgstr ""

#. ja: はい…
#. de: Ja, genau.
#. fr: Oui...
msgctxt "NpcYell:6051:0:13"
msgid "Attacked a mammoth."
msgstr ""

#. ja: この恩は<br>一生、忘れません
#. de: Euch verdanke ich mein Leben.
#. fr: Je vous dois la vie. Merci encore de m'avoir sauvée.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6052:0:13"
msgid "If you had not intervened...<br>My life, I owe to your<br>people."
msgstr ""

#. ja: ほかのゴロ族の方は<br>どうなったの？
#. de: Was ist aus den anderen Goro geworden?
#. fr: Qu'en est-il du reste de ta tribu<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6053:0:13"
msgid "What of the rest<br>of your tribe?"
msgstr ""

#. ja: わかりません…<br>無事だといいのですが…
#. de: Ich kann nur hoffen, dass es ihnen gut geht.
#. fr: Je ne sais pas ce qu'ils sont devenus. J'espère qu'ils vont bien...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6054:0:13"
msgid "I do not know. We lost many<br>in the raid, and if the Matanga<br>attacked again while I was<br>hunting..."
msgstr ""

#. ja: ん、なんだ？<br>この地響き…
#. de: Was ist das? Der Boden bebt ...
#. fr: Hé oh<nbsp>! C'était quoi cette vibration<nbsp>!?
msgctxt "NpcYell:6055:0:13"
msgid "The steppe... It moves!"
msgstr ""

#. ja: ねぇ、あれを見て！
#. de: Da!
#. fr: R-regardez là-bas<nbsp>!
msgctxt "NpcYell:6056:0:13"
msgid "Look! Over there!"
msgstr ""

#. ja: ブオオオ…！
#. de: Uuuoooaaarrr!
#. fr: Braaah<nbsp>!
msgctxt "NpcYell:6057:0:13"
msgid "\\<trumpet>"
msgstr ""

#. ja: 見ツケタ！<br>アウラ、馬、イッパイ！
#. de: Ahhh, haben wir euch! Au Ra, Pferde, lecker!
#. fr: Moi trouver Ao Ra<nbsp>!  Chevaux<nbsp>! Plein, plein<nbsp>!
msgctxt "NpcYell:6058:0:13"
msgid "Au Ra!"
msgstr ""

#. ja: 捧ゲル、血ヲ大地ニ…<br>捧ゲル、捧ゲル！
#. de: Blut von Au Ra soll Boden tränken!
#. fr: Moi taper<nbsp>! Sang couler<nbsp>! Plein, plein<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6059:0:13"
msgid "Blood to earth!<br>Blood to earth!"
msgstr ""

#. ja: 野蛮なマタンガ族ども！<br>応戦するぞ！
#. de: Elende Matanga, wir fürchten euch nicht!
#. fr: Des Matangas<nbsp>! Défendez le camp<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6060:0:13"
msgid "We are discovered!<br>Spears out!"
msgstr ""

#. ja: ブオオオ…！<br>手強イ、逃ゲロ、逃ゲロ！
#. de: Oooaaahhh, zu stark. Wir müssen weg.
#. fr: Braaah<nbsp>! Ao Ra résistants, nous partir<nbsp>!
msgctxt "NpcYell:6061:0:13"
msgid "Back! Back! Baaack!"
msgstr ""

#. ja: あっ！<br>逃げ出した！
#. de: Ha, sie hauen ab!
#. fr: Ah, ils s'enfuient<nbsp>!
msgctxt "NpcYell:6062:0:13"
msgid "They're running away!"
msgstr ""

#. ja: 見たか！<br>ダタク族の力を！
#. de: Legt euch nicht noch einmal mit den Dataq an!
#. fr: C'est ça, déguerpissez<nbsp>! Et revenez pas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6063:0:13"
msgid "They were no match<br>for our courage."
msgstr ""

#. ja: こんなところまで<br>追ってくるなんて…！
#. de: Erschreckend, wie weit sie uns gefolgt sind.
#. fr: Les Matangas m'ont pourchassée jusqu'ici...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6064:0:13"
msgid "The Matanga...<br>They were here for me."
msgstr ""

#. ja: 私のせいで<br>皆さんを巻き込んで…
#. de: Ich habe euch alle in Gefahr gebracht.
#. fr: Vous avez risqué vos vies par ma faute...
msgctxt "NpcYell:6065:0:13"
msgid "I cannot stay here."
msgstr ""

#. ja: またご迷惑がかかる前に<br>すぐに出て行きます！
#. de: Ich werde euch sofort verlassen.
#. fr: Je ne peux pas rester ici. Sinon, vous serez de nouveau en danger.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6066:0:13"
msgid "I am the cause<br>of this destruction."
msgstr ""

#. ja: そんな無茶よ！<br>迷惑だなんて…！
#. de: Das kommt überhaupt nicht in Frage!
#. fr: Ne dis pas n'importe quoi<nbsp>! Bien sûr que tu peux rester<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6067:0:13"
msgid "Nonsense! You shared our<br>water, our fire. You stood<br>at our side in battle."
msgstr ""

#. ja: これから<br>どうするつもりだ？
#. de: Was hast du jetzt überhaupt vor?
#. fr: Et où comptes-tu aller comme ça<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6068:0:13"
msgid "What will you do now,<br>Gurbesu of the Goro?"
msgstr ""

#. ja: いざという時の<br>合流地点に向かうつもりです
#. de: Ich will zu einem Notfalltreffpunkt meines Stammes.
#. fr: Notre chef a prévu un point de ralliement en cas de détresse.
msgctxt "NpcYell:6069:0:13"
msgid "The only thing I can─search for my tribe."
msgstr ""

#. ja: ならば我らも<br>共に行こう…
#. de: Dann werden wir dich dorthin begleiten.
#. fr: Parfait. Dans ce cas, on va t'accompagner là-bas.
msgctxt "NpcYell:6070:0:13"
msgid "Then we will search with you."
msgstr ""

#. ja: せっかく助かった命<br>無駄に散らせてはいかん
#. de: Wir haben dich schließlich nicht umsonst gerettet.
#. fr: On s'est donné la peine de te sauver, ce n'est pas pour te jeter en pâture aux Matangas.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6071:0:13"
msgid "You are one of us now, and<br>we would not allow a sister<br>to walk the steppe alone."
msgstr ""

#. ja: なんとお礼を言ったら…<br>ありがとうございます
#. de: Vielen Dank! Ich stehe tief in eurer Schuld.
#. fr: Je ne sais comment vous remercier...
msgctxt "NpcYell:6072:0:13"
msgid "I... I don't know what to say..."
msgstr ""

#. ja: 気にする必要はない<br>同じ草原に生きる者なのだ
#. de: Keine Ursache! Als Steppen<shy>bewohner müssen wir zusammenhalten!
#. fr: Ne t'en fais pas. Il faut être solidaires entre habitants de la steppe.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6073:0:13"
msgid "Then say nothing.<br>It is already decided."
msgstr ""

#. ja: それじゃあ、馬…<br>旦那さんの準備もお願い
#. de: Bitte kümmert euch auch um mein Pferd.
#. fr: Va chercher ton cheval. Nous allons partir tout de suite.
msgctxt "NpcYell:6074:0:13"
msgid "I've fed and watered Bayan."
msgstr ""

#. ja: はいっ！
#. de: Selbstverständlich!
#. fr: À vos ordres<nbsp>!
msgctxt "NpcYell:6075:0:13"
msgid "Thank you... Thank you all!"
msgstr ""

#. ja: さあ、旅を再開するぞ！
#. de: Wir sollten weiterziehen.
#. fr: On lève le camp<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6076:0:13"
msgid "We ride, my people!<br>But keep your weapons<br>at the ready! All eyes ahead!"
msgstr ""

#. ja: 見て！<br>あそこに！
#. de: Seht nur!
#. fr: Ah<nbsp>! Là-bas<nbsp>!
msgctxt "NpcYell:6077:0:13"
msgid "Father sun, almighty..."
msgstr ""

#. ja: マタンガ族め…<br>諦めていなかったか…！
#. de: Die Matanga greifen wieder an!
#. fr: Encore des Matangas... On peut dire qu'ils ont la tête dure.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6078:0:13"
msgid "The Matanga have returned...<br>and this time in numbers."
msgstr ""

#. ja: ブオオオ…！<br>手強イ、逃ゲロ、逃ゲロ！
#. de: Ohhh, sie sind zu stark. Flieht!
#. fr: Braaah, Ao Ra coriaces, nous plus vouloir nous battre<nbsp>!
msgctxt "NpcYell:6082:0:13"
msgid "To caves! To caves!"
msgstr ""

#. ja: どうにか<br>退けたか…
#. de: Wir haben sie zurückgeschlagen.
#. fr: Ouf... On a réussi à les tenir en respect.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6083:0:13"
msgid "Something is wrong. That was<br>too organized for a retreat..."
msgstr ""

#. ja: 仲間も無事なら<br>いいのですが…
#. de: Hoffentlich haben wir keine Verluste zu beklagen.
#. fr: J-j'espère que personne n'est blessé...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6087:0:13"
msgid "Then let us rest<br>while we can."
msgstr ""

#. ja: さあ、ゆくぞ！<br>気を取り直して出発だ！
#. de: Also dann, auf zu neuen Weiden!
#. fr: Ne vous relâchez pas<nbsp>! Le lieu de ralliement des Goro n'est plus très loin<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6088:0:13"
msgid "Gurbesu. You say that<br>beyond lies the location<br>of your tribe's last camp?"
msgstr ""

#. ja: もう少しで仲間との<br>合流地点です…！
#. de: Bald sind wir am Treffpunkt.
#. fr: Je vais bientôt retrouver les miens...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6089:0:13"
msgid "Yes, Khan. While I expect it<br>to be abandoned, perhaps<br>we will find some clue as<br>to which direction they fled."
msgstr ""

#. ja: みんな…<br>無事でいてちょうだい…
#. de: Hoffentlich sind sie unversehrt.
#. fr: J'espère qu'ils sont tous sains et saufs...
msgctxt "NpcYell:6090:0:13"
msgid "We should be nearing it now."
msgstr ""

#. ja: い、いました！
#. de: Da sind sie!
#. fr: Ah, je les reconnais, c'est eux<nbsp>!
msgctxt "NpcYell:6091:0:13"
msgid "Wait... I see smoke..."
msgstr ""

#. ja: むっ、マタンガ族に<br>襲われているのか！？
#. de: Sie werden von Matanga angegriffen!
#. fr: Nom de... Ils sont aux prises avec les Matangas<nbsp>! Nous devons les aider<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6092:0:13"
msgid "It appears your tribe did not<br>leave...nor did the Matanga!"
msgstr ""

#. ja: 見ツケタ！<br>アウラ、マタ来タ！
#. de: Jahaha, Au Ra sind da!
#. fr: Chétifs Ao Ra ont appelé renforts<nbsp>!
msgctxt "NpcYell:6094:0:13"
msgid "Au Ra! Many and more!"
msgstr ""

#. ja: 血ヲイッパイ！<br>大地ニ捧ゲル、捧ゲル！
#. de: So viel Blut! Nahrhaftes Blut!
#. fr: Nous faire couler plus de sang<nbsp>! Plein, plein<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6095:0:13"
msgid "Blood to earth!<br>Blood to earth!"
msgstr ""

#. ja: ブオオオ…！<br>手強イ、逃ゲロ、逃ゲロ！
#. de: Ohhh, zu stark! Wir müssen fliehen.
#. fr: Braaah<nbsp>! Ao Ra pas mourir<nbsp>! Pas drôle<nbsp>!
msgctxt "NpcYell:6096:0:13"
msgid "Back to caves!"
msgstr ""

#. ja: 憎イ、憎イ、憎イ！
#. de: Hass, Hass, Hass!
#. fr: Ao Ra vilains, vilains Ao Ra<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6097:0:13"
msgid "Death come, Au Ra!<br>Death come!"
msgstr ""

#. ja: みんなっ！<br>生きていてくれたのね！
#. de: Ein Glück, ihr lebt!
#. fr: Azim soit loué<nbsp>! Je craignais qu'il ne vous soit arrivé malheur.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6098:0:13"
msgid "My brothers! My sisters!<br>You are safe!"
msgstr ""

#. ja: グルベスこそ！<br>夫のバヤンも無事か！
#. de: Gurbesu, Bayan, wie schön, euch zu sehen.
#. fr: Gurbesu, quel soulagement de te revoir<nbsp>! Et Bayan aussi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6099:0:13"
msgid "As are you and Bayan.<br>This is good."
msgstr ""

#. ja: ダタク族の方々と<br>お見受けする…
#. de: Ist der ganze Stamm der Dataq hier?
#. fr: Vous êtes la tribu des Dataq, n'est-ce pas<nbsp>?
msgctxt "NpcYell:6100:0:13"
msgid "But you do not come alone."
msgstr ""

#. ja: 我らを救ってくれたこと<br>感謝致します…
#. de: Danke, dass ihr uns gerettet habt.
#. fr: Merci, nous n'y serions pas arrivés sans votre aide.
msgctxt "NpcYell:6101:0:13"
msgid "Tell me, Gurbesu..."
msgstr ""

#. ja: しかし、我らの多くが<br>傷ついてしまった…
#. de: Leider sind viele von uns verletzt.
#. fr: Cependant, nous déplorons de nombreux blessés...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6102:0:13"
msgid "Why would the Dataq lift<br>their spears for the Goro?"
msgstr ""

#. ja: 治療が済むまで<br>我らが護衛しよう
#. de: Wir beschützen euch, bis eure Wunden verheilt sind.
#. fr: Ne vous inquiétez pas. Nous vous protègerons jusqu'à ce que vos blessés soient guéris.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6103:0:13"
msgid "We would lift them for<br>Gurbesu, so we would<br>lift them for you."
msgstr ""

#. ja: なんと、真ですか！？<br>かたじけない…
#. de: Wirklich? Ihr seid zu gut zu uns.
#. fr: Vraiment<nbsp>? Oh, je ne sais comment vous remercier...
msgctxt "NpcYell:6104:0:13"
msgid "Khan..."
msgstr ""

#. ja: ブオオオ…！
#. de: Oooaaarrr!
#. fr: Braaaaaaah<nbsp>!
msgctxt "NpcYell:6105:0:13"
msgid "\\<trumpet>"
msgstr ""

#. ja: 殺ス、殺ス…
#. de: Töten, töten!
#. fr: Tuer, tuer, tuer<nbsp>!
msgctxt "NpcYell:6106:0:13"
msgid "Kill all! Kill all!"
msgstr ""

#. ja: アウラ、馬、皆殺シ！
#. de: Au Ra, Pferde, alle töten!
#. fr: Tuer Ao Ra, tuer chevaux, tuer tout le monde<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6107:0:13"
msgid "Death to Au Ra!<br>Death to trunkless!"
msgstr ""

#. ja: アウラ、殺シテ<br>血ヲ大地ニ、捧ゲル！
#. de: Au Ra töten, Blut trinken!
#. fr: Sang des Ao Ra couler<nbsp>! Recouvrir steppe<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6108:0:13"
msgid "Blood to earth!<br>Blood to earth!"
msgstr ""

#. ja: 【省略】
#. de: Uarrr!
#. fr: Ouuurgh<nbsp>!
msgctxt "NpcYell:6109:0:13"
msgid "0"
msgstr ""

#. ja: 来たな…<br>全員、武器を取れ！
#. de: Sie kommen! Macht euch bereit!
#. fr: Ils remettent ça... Défendez-vous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6110:0:13"
msgid "There is no Dataq and no<br>Goro. Only sisters and<br>brothers of the steppe!"
msgstr ""

#. ja: ブオオオオオオオオ！<br>皆殺シ！
#. de: Uuuaaarrr! Töööten!
#. fr: Braaaaaaah<nbsp>! Tueeer<nbsp>!!!
msgctxt "NpcYell:6111:0:13"
msgid "Kiiiiiiiiilll!"
msgstr ""

#. ja: オノレ…オノレ…！<br>大王ヲ…呼ブ！
#. de: Großer Anjana, steh uns bei!
#. fr: Grrr... Grand roi pas content... Lui venir pulvériser Ao Ra<nbsp>!
msgctxt "NpcYell:6114:0:13"
msgid "King come! Au Ra kill!"
msgstr ""

#. ja: 強イ、強イ、強イ！<br>アンジャナ大王…！！
#. de: Großkönig Anjana wird Feinde zerquetschen!
#. fr: Roi Anjana gros, fort, invincible<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6115:0:13"
msgid "Anjana come!<br>Give blood to earth!"
msgstr ""

#. ja: な、何を言っているんだ？
#. de: Wovon reden die?
#. fr: D-de quoi parlent-ils...<nbsp>!?
msgctxt "NpcYell:6116:0:13"
msgid "Why do they not attack?"
msgstr ""

#. ja: おいおい、嘘だろ…<br>ありゃ、化け物だ…！
#. de: Oje, was ist das? Eine riesige Bestie?!
#. fr: J-je rêve... C'est quoi ce truc<nbsp>!? Il est monstrueux<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:6117:0:13"
msgid "<i>That</i> is why!"
msgstr ""

#. ja: バオオオオオオン！！
#. de: Oooaaarrr!
#. fr: Brrraaabraaar<nbsp>!
msgctxt "NpcYell:6118:0:13"
msgid "WHERE ARE MY CHILDREN!?"
msgstr ""

#. ja: あ、諦めないで！<br>戦うのよ、力を合わせて！
#. de: F-Fürchtet euch nicht! Gemeinsam sind wir stark!
#. fr: Ne vous laissez pas impressionner<nbsp>! Restez groupés<nbsp>!
msgctxt "NpcYell:6120:0:13"
msgid "Together! Stand together!"
msgstr ""

#. ja: ウルサイ、ウルサイ<br>アウラ、潰ス…！
#. de: Schweigt, elende Au Ra!
#. fr: Silence<nbsp>! Ao Ra bruyants<nbsp>! Anjana écraser Ao Ra<nbsp>!
msgctxt "NpcYell:6123:0:13"
msgid "CEASE THIS CLAMOR!"
msgstr ""

#. ja: バオオオオオオン！！
#. de: Oooaaarrr!
#. fr: Braaah Braaabaaar<nbsp>!
msgctxt "NpcYell:6124:0:13"
msgid "ENOUGH!"
msgstr ""

#. ja: アウラ、強イ！<br>大王ヨリ、強イ！
#. de: Au Ra sind stark, stärker als Anjana.
#. fr: Ao Ra plus forts que grand roi<nbsp>!
msgctxt "NpcYell:6128:0:13"
msgid "Anjana dead! Matanga lost!"
msgstr ""

#. ja: 逃ゲロ、逃ゲロ！
#. de: Wir müssen fliehen!
#. fr: Nous perdu, nous partir<nbsp>! Braaah<nbsp>!
msgctxt "NpcYell:6129:0:13"
msgid "Away! Away!"
msgstr ""

#. ja: み、みたかっ！<br>俺たちの底力！
#. de: Jaaa, wir haben sie in die Flucht geschlagen!
#. fr: J'espère que vous avez retenu la leçon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6130:0:13"
msgid "They break! Now the<br>slaughter begins!"
msgstr ""

#. ja: 深追いはするな…<br>こちらも限界なのだ…
#. de: Lasst sie laufen. Wir müssen unsere Kräfte sammeln.
#. fr: Laissez-les. Mieux vaut économiser le peu de force qu'il nous reste.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6132:0:13"
msgid "Anarba! Is it not enough<br>that the day is ours?"
msgstr ""

#. ja: そうね…<br>荷物をまとめましょう
#. de: Du hast recht. Packen wir unsere Sachen.
#. fr: Oui, nous devons encore plier bagage...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6133:0:13"
msgid "Khan is right, Anarba. No<br>more blood need be spilled<br>this day."
msgstr ""

#. ja: 出発準備だ！
#. de: Macht euch bereit zum Aufbruch!
#. fr: ... Et reprendre notre périple<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6134:0:13"
msgid "Let us see to the wounded<br>then leave this cursed place."
msgstr ""

#. ja: ダタク族の皆様…<br>ありがとうございました
#. de: Wir danken dem Stamm der Dataq.
#. fr: Mes amis... Je vous remercie du fond du cœur.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6135:0:13"
msgid "Brothers and sisters of the<br>Dataq, we are forever in<br>your debt."
msgstr ""

#. ja: このご恩は<br>決して忘れません…
#. de: Wir sind euch auf ewig in Freund<shy>schaft verbunden.
#. fr: Nous vous sommes redevables à jamais.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6136:0:13"
msgid "The song of your tribe's<br>bravery will be sung at<br>our fires for generations<br>to come."
msgstr ""

#. ja: またいつか草原の<br>どこかで会おう、友よ
#. de: Mögen sich unsere Wege bald wieder kreuzen.
#. fr: Si Azim le veut, nos destins se croiseront à nouveau.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6137:0:13"
msgid "As they will at ours,<br>brave Goro. Until we<br>meet again."
msgstr ""

#. ja: では、出発だ…<br>また旅が始まるぞ！
#. de: Also dann, eine neue Reise beginnt!
#. fr: Un voyage s'achève, un autre commence<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6138:0:13"
msgid "Dataq! To your mounts.<br>We ride!"
msgstr ""

#. ja: 元気でね、グルベス！
#. de: Leb wohl, Gurbesu!
#. fr: Porte-toi bien, Gurbesu<nbsp>!
msgctxt "NpcYell:6139:0:13"
msgid "Farewell, Gurbesu. Bayan."
msgstr ""

#. ja: みなさんも<br>どうかお元気で！
#. de: Lebt wohl!
#. fr: Vous aussi, prenez soin de vous<nbsp>!
msgctxt "NpcYell:6140:0:13"
msgid "Farewell!"
msgstr ""

#. ja: さあ、準備はいいな！？<br>総員抜刀……模擬戦開始ぃぃぃぃっ！！！
#. de: Also gut, dann wollen wir mal! Zieht eure Waffen, die Übung geht los!
#. fr: Tout le monde est prêt<nbsp>? Dégainez vos armes, en garde... Début de l'entraînemeeeeent<nbsp>!!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6141:0:13"
msgid "The more mercy you show, the less you'll receive from me!<br>Now, BEGIN!"
msgstr ""

#. ja: これで終わりだ、アドリ！
#. de: Jetzt ist Schluss, Adri!
#. fr: Fini de jouer, Adri<nbsp>!
msgctxt "NpcYell:6142:0:13"
msgid "It ends here, Adri!"
msgstr ""

#. ja: さて敵役は<br>どの部隊とするか…
#. de: Wen mach ich am besten zum Feind?
#. fr: Qui va servir d'ennemi, aujourd'hui...<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6143:0:13"
msgid "Guerrilla tactics, shield<br>walls─neither'll save my<br>men from the cannons of<br>an imperial reaper."
msgstr ""

#. ja: うーむ<br>考え物だ…
#. de: Hm, gar nicht so einfach ...
#. fr: Hmm, le choix est difficile...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6144:0:13"
msgid "No... What they need is<br>something unpredictable.<br>Something volatile..."
msgstr ""

#. ja: 前衛としての<br>心構えはだな…
#. de: Bei der Vorhut kommt es darauf an, dass ...!
#. fr: L'important quand on est aux premières lignes...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6147:0:13"
msgid "There is only one rule on<br>the front lines: don't break.<br>Break and you're dea─"
msgstr ""

#. ja: おい、集中しろ！<br>聞き逃すなよ！
#. de: He, hört ihr mir überhaupt zu?!
#. fr: Hé, tu m'écoutes<nbsp>!?
msgctxt "NpcYell:6148:0:13"
msgid "You there! Are you listening!?"
msgstr ""

#. ja: ハッ！　フン！　セイ！
#. de: Eins, zwo, drei!
#. fr: Yah<nbsp>! Deux, trois... Yah<nbsp>!
msgctxt "NpcYell:6149:0:13"
msgid "One! Two! Three!"
msgstr ""

#. ja: もう一度！
#. de: Und nochmal!
#. fr: Encore une fois<nbsp>!
msgctxt "NpcYell:6150:0:13"
msgid "Again!"
msgstr ""

#. ja: 動きが鈍い！
#. de: Viel zu langsam!
#. fr: Trop lent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6151:0:13"
msgid "A parry that slow<br>will be your last!"
msgstr ""

#. ja: そんなことでは<br>生き残れんぞ！
#. de: So gehst du im Nu drauf!
#. fr: C'est pas comme ça que tu vas survivre<nbsp>!
msgctxt "NpcYell:6152:0:13"
msgid "Faster! Faster!"
msgstr ""

#. ja: ハ…ハイ…
#. de: Jaja ...
#. fr: O-oui...
msgctxt "NpcYell:6155:0:13"
msgid "\\<doze>"
msgstr ""

#. ja: 了解でありまーす！
#. de: Jawohl!
#. fr: Compris, chef<nbsp>!
msgctxt "NpcYell:6156:0:13"
msgid "S-Sir! Dead, sir! Yes, sir!"
msgstr ""

#. ja: ハッ！
#. de: Eins!
#. fr: Yah<nbsp>!
msgctxt "NpcYell:6157:0:13"
msgid "One!"
msgstr ""

#. ja: フンッ！
#. de: Zwo!
#. fr: Hmph<nbsp>!
msgctxt "NpcYell:6158:0:13"
msgid "Two!"
msgstr ""

#. ja: セイッ！
#. de: Drei!
#. fr: Ha<nbsp>!
msgctxt "NpcYell:6159:0:13"
msgid "Three!"
msgstr ""

#. ja: 演習はまだか？
#. de: Wann geht's endlich los?
#. fr: On commence toujours pas<nbsp>?
msgctxt "NpcYell:6160:0:13"
msgid "How long do we have to wait?"
msgstr ""

#. ja: 準備は万全なのに…
#. de: Ich bin längst fertig.
#. fr: Je suis prêt, moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6161:0:13"
msgid "They promise us a mock<br>battle, but give us lectures."
msgstr ""

#. ja: 竜詩戦争の英雄<br>伊達ではないか…
#. de: So kämpfen Helden!
#. fr: Sa réputation n'était pas usurpée...
msgctxt "NpcYell:6162:0:13"
msgid "Kissed by the Fury, indeed!"
msgstr ""

#. ja: すっごい<br>強さだニャ…
#. de: Wie mächtig <if $gn4>sie<else>er</if> ist!
#. fr: <if $gn4>Elle<else>Il</if> est... trrrop <if $gn4>forte<else>fort</if>...
msgctxt "NpcYell:6163:0:13"
msgid "Such strength! Such speed!"
msgstr ""

#. ja: な、なんと、隊長であるこの私が、<br>最初に膝を突くことになろうとは……！
#. de: Der Kommandant streicht als Erstes die Segel? Schande über mich!
#. fr: Argh<nbsp>! Quelle honte d'être vaincu le premier...
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:6164:0:13"
msgid "Hahaha! I haven't been so<br>frightened for my life since<br><i>I</i> was a recruit!"
msgstr ""

#. ja: 見物ですね…
#. de: Sehr lehrreich!
#. fr: Quel spectacle...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6165:0:13"
msgid "Do you think they've<br>had enough?"
msgstr ""

#. ja: 手も足も<br>出んだろうがな…
#. de: Wir werden kaum eine Chance haben.
#. fr: Les pauvres, ils n'ont aucune chance...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6166:0:13"
msgid "Enough? When I was their<br>age I broke my fast on<br>heroes of the realm!"
msgstr ""

#. ja: それでも<br>いい経験になれば
#. de: Wird sicher 'ne gute Erfahrung.
#. fr: Bah, ça leur servira d'expérience.
msgctxt "NpcYell:6167:0:13"
msgid "........."
msgstr ""

#. ja: 戦闘の厳しさを<br>学べるといいのだが…
#. de: Ja, und schmerzhaft sicher auch.
#. fr: Espérons...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6168:0:13"
msgid "Alright, maybe<br>they've had enough."
msgstr ""

#. ja: ひとつ<br>活を入れてやるか！
#. de: Soll ich mal tricksen?
#. fr: Tiens, et si on participait, nous aussi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6169:0:13"
msgid "But that doesn't mean I'm<br>letting them off easy!"
msgstr ""

#. ja: まったくもう…
#. de: Ich bitte darum.
#. fr: Hein<nbsp>!? Alors là, sans moi<nbsp>!
msgctxt "NpcYell:6170:0:13"
msgid "Twelve help us all..."
msgstr ""

#. ja: まだまだッ！
#. de: Wir sind noch nicht fertig!
#. fr: J'en ai pas fini avec vous<nbsp>!
msgctxt "NpcYell:6171:0:13"
msgid "We're not finished yet!"
msgstr ""

#. ja: 次はこっちだ！
#. de: Na, wie sieht's jetzt aus?!
#. fr: Vous ne vaincrez pas<nbsp>!
msgctxt "NpcYell:6172:0:13"
msgid "You cannot defeat us all!"
msgstr ""

#. ja: ここからが<br>本番というものよ！
#. de: Jetzt mache ich Ernst.
#. fr: Passons aux choses sérieuses<nbsp>!
msgctxt "NpcYell:6173:0:13"
msgid "Your time has come!"
msgstr ""

#. ja: だらしない<br>ヤツらっちゃ！
#. de: Idioten! Von eigenem Essen besiegt!
#. fr: Bande de bouuuriques<nbsp>! Battuuus par votre miam miam<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6174:0:13"
msgid "Fools! Beaten by your<br>own meaten!"
msgstr ""

#. ja: そんなことだから<br>腹ぺこのままっちゃ！
#. de: Deshalb ihr immer Hunger habt!
#. fr: Comment Qiqirns pouvoir croc croc comme ça<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6175:0:13"
msgid "That is why always you<br>are hungering!"
msgstr ""

#. ja: 威光に黙せ！
#. de: Schweigt im Angesicht der Macht!
#. fr: Craignez les enfants d'Azim<nbsp>!
msgctxt "NpcYell:6176:0:13"
msgid "Bow down before me!"
msgstr ""

#. ja: オレにやらせろ！
#. de: Überlasst sie mir!
#. fr: Ça va chauffer<nbsp>!
msgctxt "NpcYell:6177:0:13"
msgid "Leave this one to me!"
msgstr ""

#. ja: お願いがあるんだ！<br>聞いてくれ！
#. de: Bitte lass mich nicht allein!
#. fr: <if $gn4>Étrangère<else>Étranger</if>, j'ai besoin de toi<nbsp>!
msgctxt "NpcYell:6178:0:13"
msgid "Please... Just one more word."
msgstr ""

#. ja: ありがとう…！<br>さあ、出発しよう！
#. de: Danke! Dann lass uns gehen.
#. fr: Merci, c'est gentil<nbsp>! En route<nbsp>!
msgctxt "NpcYell:6179:0:13"
msgid "I'm saved! (I hope!)"
msgstr ""

#. ja: や、やっぱりきたぁ！
#. de: D-Da sind sie!
#. fr: Argh, je savais qu'ils reviendraient<nbsp>!
msgctxt "NpcYell:6180:0:13"
msgid "It is as I said!"
msgstr ""

#. ja: ブドゥガ族だぁ！
#. de: Die Buduga!
#. fr: Des Buduga<nbsp>!
msgctxt "NpcYell:6181:0:13"
msgid "The Buduga!"
msgstr ""

#. ja: ひぃ、後ろからも！
#. de: Sie haben uns umzingelt!
#. fr: Aaah, ils arrivent par derrière<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6184:0:13"
msgid "How did they<br>get behind us!?"
msgstr ""

#. ja: はぁ、はぁ…<br>帰りたいよぉ…
#. de: Ich will doch nur nach Hause.
#. fr: J'en peux plus, je veux rentrer chez moi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6185:0:13"
msgid "The village is<br>not much further!"
msgstr ""

#. ja: もう大丈夫だよ！<br>本当にありがとう！
#. de: Hier bin ich sicher. Vielen Dank!
#. fr: Ah, enfin en sécurité<nbsp>! Merci mille fois, <if $gn4>étrangère<else>étranger</if><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6187:0:13"
msgid "Thank you, traveler. My<br>tribe will see me safe now."
msgstr ""

#. ja: ブドゥガ族は<br>絶対に嫌だぁ！
#. de: Ich hasse die Buduga!
#. fr: Moi, devenir un Buduga<nbsp>? Plutôt mourir<nbsp>!
msgctxt "NpcYell:6188:0:13"
msgid "I am a Mol!"
msgstr ""

#. ja: ボクに<br>構わないでっ！
#. de: Lasst eure Finger von mir!
#. fr: Fichez-moi la paix<nbsp>!
msgctxt "NpcYell:6189:0:13"
msgid "Leave me alone!"
msgstr ""

#. ja: 逃がすものか！
#. de: Du entkommst uns nicht!
#. fr: Si tu crois pouvoir t'échapper...
msgctxt "NpcYell:6193:0:13"
msgid "There is nowhere to run, boy!"
msgstr ""

#. ja: なぜ逃げ出す！<br>ブドゥガ族はいいぞ！
#. de: Komm zu uns! Als Buduga wirst du ein schönes Leben haben.
#. fr: Allez, viens<nbsp>! On est bien chez les Buduga<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6194:0:13"
msgid "Your tribe will not have<br>you back now!"
msgstr ""

#. ja: ブドゥガ族に<br>加わるがいい！
#. de: Aus dir wird ein feiner Buduga!
#. fr: C'est un honneur de rejoindre les Buduga<nbsp>!
msgctxt "NpcYell:6195:0:13"
msgid "We are your tribe now!"
msgstr ""

#. ja: 絶対に連れ帰る！
#. de: Du gehörst uns!
#. fr: Tu viens avec nous, un point c'est tout<nbsp>!
msgctxt "NpcYell:6196:0:13"
msgid "One of us! One of us!"
msgstr ""

#. ja: 何です？
#. de: Was ist?
#. fr: Qu'est-ce qu'il y a<nbsp>?
msgctxt "NpcYell:6200:0:13"
msgid "You ahem-ed?"
msgstr ""

#. ja: 増援の準備を…
#. de: Die, ähm, Verstärkung ...?
#. fr: On devrait envoyer des renforts...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6201:0:13"
msgid "Were you going to call<br>in reinforcements?"
msgstr ""

#. ja: 予定にありませんが？
#. de: War nicht eingeplant ...
#. fr: Ce n'est pas ce qui était prévu.
msgctxt "NpcYell:6202:0:13"
msgid "I hadn't planned on it."
msgstr ""

#. ja: 少しはいいところを<br>見せんとな…
#. de: Dann, äh, müssen wir wohl 'ne Schippe drauflegen.
#. fr: Peut-être, mais avec la déculottée qu'on est en train de se prendre...
msgctxt "NpcYell:6203:0:13"
msgid "Perhaps you should?"
msgstr ""

#. ja: …了解
#. de: Aye ...
#. fr: Tu as raison.
msgctxt "NpcYell:6204:0:13"
msgid "Perhaps."
msgstr ""

#. ja: 襲撃するっちゃ！
#. de: Los! Waffen sammeln!
#. fr: Qiqirns s'armer et attaquer maintenant<nbsp>!
msgctxt "NpcYell:6205:0:13"
msgid "Go! Gather weapons now!"
msgstr ""

#. ja: お肉探すっちゃ！
#. de: Nach Ala Gannha!
#. fr: Qiqirns rafler viande<nbsp>!
msgctxt "NpcYell:6207:0:13"
msgid "To Ala Gannha!"
msgstr ""

#. ja: 出発っちゃ！
#. de: Nach Fleischstadt!
#. fr: À Ala Gannha<nbsp>!
msgctxt "NpcYell:6208:0:13"
msgid "To town of meat!"
msgstr ""

#. ja: うわ～ん！<br>助けてぇ～！
#. de: Papi! Papi!
#. fr: (pleure) Mamaaan<nbsp>! Papaaa<nbsp>! (snif)
msgctxt "NpcYell:6209:0:13"
msgid "Father! Father!"
msgstr ""

#. ja: 困ったな…<br>どうにかしないと…
#. de: \<seufz> ... Riecht nach 'ner weiteren Nacht im Stall.
#. fr: L'armée de libération va me passer un savon...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6210:0:13"
msgid "\\<sigh> Another night in<br>the stables, I reckon."
msgstr ""

#. ja: ぐっ……まず癒し手を倒すとは……<br>常道の戦い方……お見事です……。
#. de: Den Heiler zuerst. Clever.
#. fr: Évidemment, <if $gn4>elle<else>il</if> s'est <if $gn4>débarrassée<else>débarrassé</if> de la soigneuse en premier...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6211:0:13"
msgid "Neutralize the enemy's capacity to heal its wounded.<br>Standard battle tactics."
msgstr ""

#. ja: こちらの戦力が半減しただと！？<br>ええい、だがここから盛り返して見せるッ！
#. de: Die Hälfte ist weg! Aber jetzt dreh ich richtig auf!
#. fr: On n'est déjà plus que deux<nbsp>!? Allez allez, on se reprend<nbsp>!
msgctxt "NpcYell:6212:0:13"
msgid "And then there were two!"
msgstr ""

#. ja: ついに、ひとりだけになったか……<br>だが、まだ勝負は決まっていないッ！
#. de: Da war's nur noch einer ... Der hat's in sich, aber die Heraus<shy>forde<shy>rung nehm ich an!
#. fr: C'est notre dernière chance... Mais l'issue du combat est encore incertaine<nbsp>!
msgctxt "NpcYell:6213:0:13"
msgid "And then there was one─one with the strength of ten!"
msgstr ""

#. ja: む、無念…
#. de: Erbärmlich ...
#. fr: Argh... Stop, j'arrête là.
msgctxt "NpcYell:6214:0:13"
msgid "I wasn't in best form today..."
msgstr ""

#. ja: やられたニャ…
#. de: I-Ich bin raus ...
#. fr: On a perrrdu...
msgctxt "NpcYell:6215:0:13"
msgid "Well this is embarrassing..."
msgstr ""

#. ja: さすがは英雄殿、あえて負けることで、<br>我々に自信を付けさせようというのだな？
#. de: Gib's zu, das hast du extra gemacht, um uns Mut zu machen!
#. fr: Vous avez fait exprès de perdre pour donner du courage à nos troupes, c'est ça<nbsp>? C'est trop gentil<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:6216:0:13"
msgid "You needn't have pulled your punches...but this act of <i>clemence</i> is certain to cheer the men's spirits. \\<wink>"
msgstr ""

#. ja: どうでしたかな？<br>エオルゼア同盟軍の力も捨てたものではないでしょう？
#. de: Na ja, ganz unbrauchbar sind wir anscheinend nicht, was?
#. fr: Alors, qu'en dites-vous<nbsp>? Les sous-officiers de l'Alliance savent se défendre, hein<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6217:0:13"
msgid "Not all our men are as green<br>as the recruits!"
msgstr ""

#. ja: いやはや、こちら側としてもいい経験になりました。<br>ご協力、感謝しますぞ！
#. de: War jedenfalls eine bereichernde Erfahrung. Vielen Dank für deine Mitarbeit!
#. fr: Finalement, on dirait bien que c'est à vous que cet en<shy>traî<shy>ne<shy>ment aura servi de leçon.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6218:0:13"
msgid "If <i>you</i> underestimated us,<br>perhaps the Empire will, too!"
msgstr ""

#. ja: ガハハハハハハハ！
#. de: Muwahahahaha!
#. fr: Ha ha ha ha ha<nbsp>!!!
msgctxt "NpcYell:6219:0:13"
msgid "Gah hah hah hah hah!"
msgstr ""

#. ja: そ、そこまで……！<br>ハァ、ハァ、ハァ……こちらの負けを認めましょう……。
#. de: Das ... \<keuch> ... reicht ... Wir geben uns geschlagen!
#. fr: (souffle)... C'est bon, vous avez gagné.
msgctxt "NpcYell:6220:0:13"
msgid "Stay your blades! We yield!"
msgstr ""

#. ja: しかし、いい経験になりました。<br>この模擬戦で学んだことを、しっかり活かさねば……。
#. de: Eine lehrreiche Niederlage! Wir sollten sie direkt in ein paar Übungen verarbeiten!
#. fr: Je dois dire que ce petit exercice était très intéressant. J'ai beaucoup appris...
msgctxt "NpcYell:6221:0:13"
msgid "Much was to be had from the day's exercises."
msgstr ""

#. ja: さあ、お前たち、訓練に戻るぞ！<br>英雄殿を目指して、ただ訓練あるのみだッ！
#. de: Los, ihr Schlapp<shy>schwänze! Zurück an die Arbeit! Irgendwann mach ich auch mal solche Helden aus euch!
#. fr: Tout le monde, on arrête de lambiner et on retourne s'entraîner<nbsp>! Prenez exemple sur <if $gn4>la Guerrière<else>le Guerrier</if> de la Lumière<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:6222:0:13"
msgid "May they see us─may they see <i>Eorzea</i> to victory!"
msgstr ""

#. ja: 俺の計測器が<br>ビビッときてるぜ！
#. de: Mein Detektor kriegt sich gar nicht mehr ein!
#. fr: Mon pifomètre me dit que ça va barder<nbsp>!
msgctxt "NpcYell:6223:0:13"
msgid "My instruments are picking something up!"
msgstr ""

#. ja: そ、そこまで……！<br>ハァ、ハァ、ハァ……この辺りで模擬戦は終了としましょう！
#. de: Genug! \<keuch> ... \<schnauf> ... Ich erkläre den Übungskampf für beendet!
#. fr: (souffle)... On va s'arrêter là pour aujourd'hui.
msgctxt "NpcYell:6224:0:13"
msgid "Blades down! That is enough!"
msgstr ""

#. ja: ぜひ、機会がありましたら、またお相手願いますぞ！
#. de: Vielleicht kannst du uns ja mal wieder Ge<shy>sell<shy>schaft leisten.
#. fr: C'est un plaisir de s'exercer avec vous. On remettra ça, d'accord<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6225:0:13"
msgid "It was an honor to exchange<br>blows with you this day."
msgstr ""

#. ja: もっとも、次も我々の勝利かもしれませんがね！<br>ガハハハハハハ！
#. de: Wenn du mal wieder versohlt werden möchtest ... Muwahahaha!
#. fr: Qui sait, vous arriverez peut-être à nous mettre en danger la prochaine fois, ha ha ha ha<nbsp>!!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6226:0:13"
msgid "Of course, emerging victorious<br>didn't hurt, either. Gah hah hah!"
msgstr ""

#. ja: さてと、今日も<br>大漁といきたいもんだ
#. de: So, dann will ich mal 'ne Runde die Angel auswerfen.
#. fr: Je sens que je vais battre mon record de pêche aujourd'hui<nbsp>! Peut-être même que je vais dépasser les cent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6227:0:13"
msgid "Time to check the nets<br>I laid last night."
msgstr ""

#. ja: うわっ！？<br>紅玉海のトビザメだ！
#. de: Mist! Fliegende Haie!
#. fr: Aaah<nbsp>! Un requin volant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6228:0:13"
msgid "Flying sharks!? This far<br>from the Tide!?"
msgstr ""

#. ja: トビザメのせいで<br>漁ができんぞ…
#. de: Nicht gerade die besten Angelbedingungen heute.
#. fr: Impossible de taquiner le goujon avec ces requins volants...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6229:0:13"
msgid "My nets torn and my catch<br>devoured! What am I to do!?"
msgstr ""

#. ja: 漁は諦めた方が<br>よさそうだな…
#. de: Ich glaub, das wird nichts mehr heute.
#. fr: Zéro poisson... Tu parles d'un record...
msgctxt "NpcYell:6230:0:13"
msgid "Damnable sharks!"
msgstr ""

#. ja: 残念だが<br>出直すとするか…
#. de: Dann mal nach Hause zu den hungrigen Kindern ...
#. fr: C'est dommage... On réessaiera demain...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6231:0:13"
msgid "Now I'll have to find a new<br>place farther up river!"
msgstr ""

#. ja: お見事！<br>助かったよ！
#. de: Ich bin dir unendlich dankbar!
#. fr: Bien joué<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6232:0:13"
msgid "The waters no longer boil.<br>The sharks have returned<br>to the Tide."
msgstr ""

#. ja: これで漁ができ…<br>うわっ！？
#. de: Jetzt kann ich endlich fisch...!
#. fr: Je peux enfin aller pêcher et... Par tous les kami<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6233:0:13"
msgid "Now to see if there is aught<br>remaining of my ne─"
msgstr ""

#. ja: イカんぞ！<br>ありゃ、フチカリだ！
#. de: Verdammt! Fuchikari!
#. fr: Attention<nbsp>! C'est le Fuchikari<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:6234:0:13"
msgid "Hells take me! It's a...a...<br>giant <i>weasel</i>!"
msgstr ""

#. ja: なんて日なんだ…
#. de: Heut ist nicht mein Tag.
#. fr: Il y a des jours où il vaudrait mieux rester chez soi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6235:0:13"
msgid "What have I done<br>to deserve this!?"
msgstr ""

#. ja: いやはや、あっぱれ！<br>フチカリを倒すとは！
#. de: Fuchikari ist besiegt? Unglaublich!
#. fr: Incroyable<nbsp>! Tu as vaincu le Fuchikari<nbsp>!
msgctxt "NpcYell:6236:0:13"
msgid "Is it...dead?"
msgstr ""

#. ja: 村の皆にも<br>話してやらにゃ！
#. de: Wenn das die anderen hören!
#. fr: Il faut que je raconte ça à tout le village<nbsp>!
msgctxt "NpcYell:6237:0:13"
msgid "It is! The weasel is dead!"
msgstr ""

#. ja: ともかくこれで<br>漁が始められるぞ
#. de: Aber erst mal etwas angeln.
#. fr: Mais avant... J'ai cent poissons à pêcher<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6238:0:13"
msgid "Wait... Flying sharks and giant<br>weasels? My wife is never<br>going to believe me!"
msgstr ""

#. ja: それじゃ、行ってくるよ<br>ありがとな！
#. de: Danke! Wir sind dir was schuldig!
#. fr: Je vais m'y mettre<nbsp>! Merci, l'ami<if $gn4>e</if><nbsp>!
msgctxt "NpcYell:6239:0:13"
msgid "I need to catch some fish...now!"
msgstr ""

#. ja: 残念だが<br>出直すとするか…
#. de: Das Angeln kann ich mir heute wohl abschminken.
#. fr: C'est dommage... On réessaiera demain...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6240:0:13"
msgid "How am I going to explain<br>this to my wife? I'm doomed..."
msgstr ""

#. ja: 旅人さん、旅人さん<br>話を聞いておくれ！
#. de: Ich brauche deine Hilfe, <if $gn4>Reisende<else>Reisender</if>!
#. fr: À l'aide<nbsp>! À l'aide<nbsp>! Viens<nbsp>! S'il te plaît<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6241:0:13"
msgid "Traveler! Over here!<br>OVER HERE!"
msgstr ""

#. ja: 苗が戻れば<br>いいんだけど…
#. de: Ohne die Setzlinge sind wir verloren!
#. fr: Si je perds mon riz...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6242:0:13"
msgid "What are we going to do?<br>What are we going to do!?"
msgstr ""

#. ja: よし、これだけあれば<br>田植えができそう！
#. de: Das sollte für die Bestellung der Felder reichen.
#. fr: Avec ça, je ne mourrai pas de faim<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:6243:0:13"
msgid "Is this enough? I suppose it's<br>enough... But what if it's not<br>enough? What if old nan dies<br>because we didn't have that<br><i>one last seedling</i>!"
msgstr ""

#. ja: ありがたや…<br>ありがたや…
#. de: Hab vielen Dank.
#. fr: Merci pour les graines, <if $gn4>voyageuse<else>voyageur</if>.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6244:0:13"
msgid "Thank the stars<br>we will not starve!"
msgstr ""

#. ja: うう…<br>絶望だよ…未来がない…
#. de: Wehe uns, wir werden schrecklich hungern!
#. fr: Avec si peu de graines... Je n'ai aucun espoir...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6245:0:13"
msgid "We're doomed... The Empire<br>will take what little we have<br>and leave us to starve!"
msgstr ""

#. ja: ギョギョギョ！
#. de: \<blubber>
#. fr: Le riiiiz, c'est exquiiiis<nbsp>!♪
msgctxt "NpcYell:6246:0:13"
msgid "Heh heh heh!"
msgstr ""

#. ja: ぺぺぺぺぺっ！
#. de: \<spotz>
#. fr: À nous le riz<nbsp>!
msgctxt "NpcYell:6247:0:13"
msgid "Catch me if you can!"
msgstr ""

#. ja: い、いつの間に<br>あれだけの卵が…
#. de: W-Wann haben die all diese Eier gelegt?
#. fr: M-mais ils sortent d'où tous ces œufs...<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6250:0:13"
msgid "Four here... Six there...<br>They're everywhere!"
msgstr ""

#. ja: すごい数の卵だ…<br>全部孵化したら…
#. de: Mag gar nicht dran denken, wenn die alle schlüpfen ...
#. fr: C'est fou... Si chacun de ces œufs donne naissance à un bucorve, on est dans la mouise...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6251:0:13"
msgid "If all these eggs<br>were to hatch..."
msgstr ""

#. ja: 手助けしてくれて<br>ありがとう！
#. de: Danke für deine Hilfe!
#. fr: Merci de ton aide<nbsp>! Continue comme ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6252:0:13"
msgid "You have already brought<br>me so many, I couldn't think<br>of asking you to bring more...<br>unless you wanted to, that is."
msgstr ""

#. ja: ベニツノたちの増殖<br>これで防げそうだ！
#. de: Das sollte die Bestände etwas eindämmen.
#. fr: Parfait<nbsp>! Les bucorves devraient pas trop proliférer comme ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6253:0:13"
msgid "The village thanks you...<br>as does my belly!"
msgstr ""

#. ja: 村に戻って<br>仲間と相談しないと…
#. de: O weh, ich muss sofort den Rat zusammenrufen.
#. fr: Mince... Va falloir que je rentre au village et que je voie avec les autres ce qu'on peut faire...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6254:0:13"
msgid "I must warn<br>the other villagers..."
msgstr ""

#. ja: な、なんだ！？<br>あの光は、まさか！
#. de: Dieses Licht! Das wird doch nicht ...!
#. fr: C'est quoi ça...<nbsp>? C'est pas des minobi... Hé mais... Non, ça peut pas être ce que je pense<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6255:0:13"
msgid "It can't be...!<br>It was just a story!"
msgstr ""

#. ja: 村人が語っていたのは<br>あの廟か…？
#. de: Ist dies der Ort, von dem die Dörfler sprachen?
#. fr: Ce doit être ce temple dont parlaient les villageois...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6256:0:13"
msgid "This is the place<br>the villagers spoke of."
msgstr ""

#. ja: 田畑を荒らす<br>化け物が潜むというが…
#. de: Dann steckt hier der Geist, der die Felder verwüstet.
#. fr: “Une créature monstrueuse saccage nos champs<nbsp>! Aide-nous, aventurier<nbsp>!”
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6257:0:13"
msgid "From here emerges the evil<br>spirit that haunts their fields."
msgstr ""

#. ja: 一刀両断<br>斬り捨ててくれるわ！
#. de: Na warte, gleich wirst du meine Klinge spüren!
#. fr: Comptez sur moi... Senban la lame vagabonde ne laissera pas vos cris de détresse sans réponse<nbsp>! Elle exterminera cette créature abjecte<nbsp>!
msgctxt "NpcYell:6258:0:13"
msgid "It is here I will find my quarry!"
msgstr ""

#. ja: さて…<br>どう仕掛けるか…
#. de: Also, wie lock ich ihn hervor?
#. fr: Quel enchaînement vais-je utiliser contre elle...<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6259:0:13"
msgid "Shall I wait,<br>or shall I attack?"
msgstr ""

#. ja: む…この気配！
#. de: Hm? Dieses Kribbeln!
#. fr: Hmm<nbsp>!? J'ai ressenti quelque chose<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6260:0:13"
msgid "Can you feel it?<br>The creature approaches!"
msgstr ""

#. ja: 出たな！
#. de: Da ist sie!
#. fr: Voilà la créature<nbsp>!
msgctxt "NpcYell:6261:0:13"
msgid "There! With me!"
msgstr ""

#. ja: なんと！<br>まだおったのか！
#. de: Was? Es gibt mehr davon?
#. fr: Comment<nbsp>!? Ce n'était pas le seul<nbsp>!?
msgctxt "NpcYell:6262:0:13"
msgid "There are others!?"
msgstr ""

#. ja: ええい！<br>ゾロゾロと！
#. de: He! Langsam reicht's!
#. fr: Tss<nbsp>! Ils affluent vers ici les uns après les autres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6263:0:13"
msgid "What foul plot requires<br>this many servants!?"
msgstr ""

#. ja: 押されている？<br>だが、まだまだ！
#. de: Komme, wer will! Ich bin längst nicht geschlagen!
#. fr: Je perds le dessus<nbsp>? Non... Je ne suis pas encore vaincu<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6264:0:13"
msgid "I will not be<br>defeated so easily!"
msgstr ""

#. ja: グッ…<br>このままでは…！
#. de: Uffz ... Lange halt ich das nicht mehr aus ...
#. fr: Argh... Mes forces s'épuisent... Je...
msgctxt "NpcYell:6265:0:13"
msgid "Come! I do not fear death!"
msgstr ""

#. ja: む、無念…
#. de: Erbärmlich ...
#. fr: J'ai échoué... Quelle honte...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6266:0:13"
msgid "I may have<br>failed the village..."
msgstr ""

#. ja: だが、いつか必ず…<br>倒してくれる！
#. de: Doch eines Tages werde ich siegen!
#. fr: Mais je reviendrai plus fort que jamais<nbsp>! Et cette fois, je vaincrai<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6267:0:13"
msgid "But this land has not seen<br>the last of Senban Oneblade!"
msgstr ""

#. ja: 我らの勝利なり！
#. de: Der Sieg ist mein!
#. fr: La victoire est mienne<nbsp>!
msgctxt "NpcYell:6268:0:13"
msgid "Victory is ours!"
msgstr ""

#. ja: 案山子の化け物は<br>討ち果たされた！
#. de: Die Geister sind vertrieben!
#. fr: L'épouvantail possédé n'est plus<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6269:0:13"
msgid "The onmyoji's henchmen will<br>trouble the villagers no longer."
msgstr ""

#. ja: これにて村人たちも<br>安心して暮らせよう！
#. de: Jetzt können die Dörfler wieder in Frieden leben.
#. fr: Les villageois pourront désormais dormir sur leurs deux oreilles<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6270:0:13"
msgid "Yet I fear his work<br>is far from complete."
msgstr ""

#. ja: 助太刀に感謝するぞ！<br>またいずれ、どこかで！
#. de: Ich danke dir! Mögen wir uns eines Tages wiedersehen.
#. fr: <if $gn4>Guerrière<else>Guerrier</if>, je te remercie pour ton assistance<nbsp>! Nous nous reverrons peut-être un jour, si le destin le veut<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6271:0:13"
msgid "He plots something most<br>treacherous, and I will not<br>rest until he has been silenced!"
msgstr ""

#. ja: 道行くヒト<br>襲うっぺ！
#. de: Jetzt gibt's was auf die Ffflossen!
#. fr: On va détrousser les voyageurs qui passent par là<nbsp>! Ils ont toujours à manger sur eux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6272:0:13"
msgid "A plump pack you have<br>there traveler! Oh, so plump!"
msgstr ""

#. ja: うぺぺっ！
#. de: \<spotz>
#. fr: Gniéhéhéhéhé<nbsp>!
msgctxt "NpcYell:6273:0:13"
msgid "A right plump pack, yes!"
msgstr ""

#. ja: うぺぺぺぺ！
#. de: \<spotz>
#. fr: Miam miam miam<nbsp>!
msgctxt "NpcYell:6274:0:13"
msgid "Open that pack!"
msgstr ""

#. ja: 食い物よこせっぺ！
#. de: Rück Fffutter raus!
#. fr: Faites une croix sur vos casse-croûtes<nbsp>! Ils sont à nous<nbsp>!
msgctxt "NpcYell:6276:0:13"
msgid "Pack! Pack! Pack!"
msgstr ""

#. ja: 斬るッ！
#. de: Blute!
#. fr: On va te découper<nbsp>!
msgctxt "NpcYell:6277:0:13"
msgid "More blood!"
msgstr ""

#. ja: せいやッ！
#. de: Hghh!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:6278:0:13"
msgid "Ooooooooow!"
msgstr ""

#. ja: 死ねぃ！
#. de: Stirb!
#. fr: Crève<nbsp>!
msgctxt "NpcYell:6279:0:13"
msgid "I'll make this quick!"
msgstr ""

#. ja: ぺぺぺぺぺ！<br>虎がいるっぺよ！
#. de: Guck mal, 'ne fffiese Katze!
#. fr: Aaahhh<nbsp>! U-u-u-un tigre<nbsp>!!!
msgctxt "NpcYell:6280:0:13"
msgid "Tigers! And they look hungry!"
msgstr ""

#. ja: 逃げるっぺ！
#. de: Nimm die Ffflossen in die Ffflossen!
#. fr: Sauve qui peut<nbsp>!
msgctxt "NpcYell:6281:0:13"
msgid "I...think my bath can wait!"
msgstr ""

#. ja: ん？<br>みんな、どうしたっぺ？
#. de: Was ist denn?
#. fr: Hmm<nbsp>? Mais qu'est-ce qu'il vous prend<nbsp>? Je ne vois pas de... 
msgctxt "NpcYell:6282:0:13"
msgid "Where is everyone going?"
msgstr ""

#. ja: うぺぺぺぺぺ！
#. de: \<spotz>!
#. fr: Aaahhh<nbsp>! U-u-u-un tigre<nbsp>!!!
msgctxt "NpcYell:6283:0:13"
msgid "T-T-T-T-T-TIGERS!!!"
msgstr ""

#. ja: にぎゃ～！
#. de: Fffische und Namazuo zuerst!
#. fr: Prends ça, sale matou<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6284:0:13"
msgid "Don't eat me! I'm fugu!<br>Aaaaaack!"
msgstr ""

#. ja: おっとう…おっかあ…<br>うぺぺ…ぺ…ぺ…
#. de: He, das zwick...! Argh!
#. fr: Ça pique<nbsp>! Aïe... Aïe aïe aïe...
msgctxt "NpcYell:6285:0:13"
msgid "Farewell...cruel world..."
msgstr ""

#. ja: ぺぺぺぺ！
#. de: \<spotz>!
#. fr: Hé hé hé<nbsp>!
msgctxt "NpcYell:6286:0:13"
msgid "Poke it again!"
msgstr ""

#. ja: おもしろいっぺよ！
#. de: Hehe!
#. fr: Il est rigolo ce grand machin<nbsp>!
msgctxt "NpcYell:6287:0:13"
msgid "Poke poke poke poke!"
msgstr ""

#. ja: 全部こわせっぺよ！
#. de: Haut alles klein!
#. fr: Bim Boum Badabim<nbsp>!
msgctxt "NpcYell:6288:0:13"
msgid "Now you poke it!"
msgstr ""

#. ja: ギョギョギョ！
#. de: \<blubber>
#. fr: Oyoyo<nbsp>!
msgctxt "NpcYell:6289:0:13"
msgid "Poke it harder! Harder!"
msgstr ""

#. ja: 死ね！
#. de: Stirb!
#. fr: Meurs<nbsp>!
#. macro: <if $gn4>her<else>his</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6290:0:13"
msgid "Gouge <if $gn4>her<else>his</if> eyes!<br>Cut out <if $gn4>her<else>his</if> tongue!"
msgstr ""

#. ja: 目撃者は殺す！
#. de: Es darf keine Zeugen geben!
#. fr: <if $gn4>Elle<else>Il</if> nous a vus<nbsp>! Tuez-<if $gn4>la<else>le</if><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6291:0:13"
msgid "None who bear witness<br>shall be suffered to live!"
msgstr ""

#. ja: クッ…撤退する！
#. de: Verdammt! Nichts wie weg!
#. fr: Grrr... Partons d'ici<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6293:0:13"
msgid "You have not seen<br>the last of us, meddler!"
msgstr ""

#. ja: ぺぺぺ？<br>なにしてるっぺよ？
#. de: Was machst du da?
#. fr: Oyoyo<nbsp>!? Mais que fait-il, celui-là<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6294:0:13"
msgid "What funny hats...<br>Maybe they'll let me have one."
msgstr ""

#. ja: うぺぺぺぺ！
#. de: \<spotz>!
#. fr: Aaaah<nbsp>! Un m-m-mo-mo-mo...<nbsp>!
msgctxt "NpcYell:6295:0:13"
msgid "Aaah! Aaah! Aaaaaahhh!"
msgstr ""

#. ja: バ、化け物っぺよぉぉ！
#. de: Ein Monster!
#. fr: Un monstre horrible<nbsp>!
msgctxt "NpcYell:6296:0:13"
msgid "You can keep your hats!"
msgstr ""

#. ja: 騒がしいな…
#. de: Was soll dieser Lärm?
#. fr: C'est quoi tout ce raffut<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6297:0:13"
msgid "Gaei out battling<br>injustice again, eh?"
msgstr ""

#. ja: ほう、人狼族同士が？
#. de: Die Wölfe bekriegen sich?
#. fr: Oh<nbsp>! Des Lupins<nbsp>! Ils se battent entre eux<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6298:0:13"
msgid "Looks as if both<br>sides are Lupin."
msgstr ""

#. ja: 止めに入るか？
#. de: Sollen wir eingreifen?
#. fr: On ne devrait pas faire quelque chose<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6299:0:13"
msgid "You know how Gaei gets<br>about trading blows with<br>his brothers."
msgstr ""

#. ja: やめておけ…<br>縄張り争いだろう？
#. de: Nee, nee, das regeln die mal besser unter sich.
#. fr: Tu rigoles<nbsp>? Ça doit être une guerre de territoire, mieux ne vaut pas s'en mêler.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6300:0:13"
msgid "You're free to do what you<br>please, my friend. I'll stay here."
msgstr ""

#. ja: こいつの仲間も<br>皆殺しだ！
#. de: Wer will der Nächste sein?
#. fr: Massacrez tous les autres<nbsp>!
msgctxt "NpcYell:6301:0:13"
msgid "When will you learn, Gaei?"
msgstr ""

#. ja: 刃向かうヤツは<br>見ての通りさ！
#. de: Mir hält keiner Stand!
#. fr: Voilà ce qui arrive quand on se met en travers de notre chemin<nbsp>!
msgctxt "NpcYell:6302:0:13"
msgid "Your pack is weak!"
msgstr ""

#. ja: 射手から<br>潰すぜェー！
#. de: Die Bogenschützen als Erste!
#. fr: Je t'écraserai, même si tu te tiens à l'écaaart<nbsp>!
msgctxt "NpcYell:6303:0:13"
msgid "Argh! That smarts...! What are these... Arrows?"
msgstr ""

#. ja: さっきから<br>痛ぇじゃねぇかァー！
#. de: Das pikst nämlich!
#. fr: Aïe<nbsp>! Ces tirs de flèches vont-ils cesseeer<nbsp>!?
msgctxt "NpcYell:6304:0:13"
msgid "The archer! Kill him first!"
msgstr ""

#. ja: て、手強い！
#. de: Diese Stärke!
#. fr: C-c'est un coriace<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6305:0:13"
msgid "Uh... We can still discuss<br>this like civil wolves!"
msgstr ""

#. ja: コウジン族を<br>雇ったのか？
#. de: Die haben 'nen Kojin angeheuert?
#. fr: Les Lupins ont engagé un Kojin<nbsp>? Sérieusement<nbsp>?
msgctxt "NpcYell:6306:0:13"
msgid "A Kojin? Here in Yanxia?"
msgstr ""

#. ja: 紅甲羅と手を組むとは<br>見逃せんぞ…
#. de: Das können wir nicht länger ignorieren.
#. fr: Ils se sont alliés avec un Rouge... Ça, je ne peux pas le laisser passer.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6307:0:13"
msgid "We've enough to worry about<br>here without those shellbacks."
msgstr ""

#. ja: 仕方ない…<br>我らも助勢するぞ！
#. de: Fürchte auch ... Zu den Waffen!
#. fr: Viens<nbsp>! Nous allons aider la meute de ce Gaei<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6308:0:13"
msgid "Let this one live, and another<br>hundred will be on the shores<br>by new moon."
msgstr ""

#. ja: 応ッ！
#. de: Jau!
#. fr: Compris<nbsp>!
msgctxt "NpcYell:6309:0:13"
msgid "Then let's see him dead!"
msgstr ""

#. ja: 義によって<br>助太刀致す！
#. de: Wir helfen euch!
#. fr: Nous arrivons pour vous aider<nbsp>!
msgctxt "NpcYell:6310:0:13"
msgid "Move!"
msgstr ""

#. ja: せ、先生が！？
#. de: Der Jäger ist besiegt?
#. fr: M-Maître<nbsp>!? Non<nbsp>!
msgctxt "NpcYell:6311:0:13"
msgid "Did he just─?"
msgstr ""

#. ja: に、逃げろ！
#. de: A-Ab nach Hause!
#. fr: Fu... Fuyez<nbsp>!
msgctxt "NpcYell:6312:0:13"
msgid "Ruuuuuun!"
msgstr ""

#. ja: 我らの勝利だ！<br>勝ちどきをあげろ！
#. de: Ihr seid besiegt! Gebt auf!
#. fr: Victoire<nbsp>! Hurlez avec moi, mes frères<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6313:0:13"
msgid "Victory is sweetest when<br>won with a straight heart!"
msgstr ""

#. ja: ウオオオォォォン！
#. de: \<knurr>
#. fr: Grraaaoooooou<nbsp>!!!
msgctxt "NpcYell:6314:0:13"
msgid "Ooooooooow!"
msgstr ""

#. ja: 1枚…2枚…
#. de: \<seufz> Also gut, lass mich sehen ...
#. fr: (soupire) Voyons... 1... 2...
msgctxt "NpcYell:6315:0:13"
msgid "\\<sigh> Let's see now..."
msgstr ""

#. ja: 99枚…100枚…
#. de: 99 ... 100 ...
#. fr: 99... 100...
msgctxt "NpcYell:6316:0:13"
msgid "125,001... 125,002..."
msgstr ""

#. ja: 999枚…1000枚…
#. de: 999 ... 1000!
#. fr: 999... 1000... Ça devrait suffire.
msgctxt "NpcYell:6317:0:13"
msgid "...250,000. That should suffice."
msgstr ""

#. ja: いよっ！<br>天下一の用心棒っ！
#. de: Niemand kann gegen Yojinbo bestehen! Har har har!
#. fr: Personne ne peut résister au terrible Yojimbo<nbsp>! Ha ha ha<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6318:0:13"
msgid "None can withstand the<br>might of Yojimbo! Hahahah!"
msgstr ""

#. ja: さてさて<br>高みの見物といくか！
#. de: Das wird ein Spektakel!
#. fr: Oui, oui, apporte-moi leurs têtes<nbsp>!
msgctxt "NpcYell:6319:0:13"
msgid "Yes, bring me their heads!"
msgstr ""

#. ja: ほう、やってみせろ…
#. de: Komm, zeig, was du kannst!
#. fr: Vas-y, viens<nbsp>!
msgctxt "NpcYell:6320:0:13"
msgid "Let us see..."
msgstr ""

#. ja: ホレ…ホレ！<br>はやく倒さんかい！
#. de: Los, sterbt schon!
#. fr: Cette fois-ci, c'en est fini de vous<nbsp>! Ha ha ha<nbsp>!
msgctxt "NpcYell:6321:0:13"
msgid "This time you're finished! Hahahah!"
msgstr ""

#. ja: 異常なしッ！
#. de: Keine Auffälligkeiten!
#. fr: Rien à signaler<nbsp>!
msgctxt "NpcYell:6322:0:13"
msgid "All's well!"
msgstr ""

#. ja: ！？
#. de: ?!
#. fr: Hein<nbsp>!?
msgctxt "NpcYell:6323:0:13"
msgid "Gah!"
msgstr ""

#. ja: ほう…
#. de: Oh ...
#. fr: Oh oh...
msgctxt "NpcYell:6324:0:13"
msgid "Oho..."
msgstr ""

#. ja: ふむ…
#. de: Hmm ...
#. fr: Hmm hmm...
msgctxt "NpcYell:6325:0:13"
msgid "Hm hmmm..."
msgstr ""

#. ja: いい動きだ
#. de: Du bewegst dich sehr gut.
#. fr: Il y a de l'assurance dans tes mouvements.
msgctxt "NpcYell:6326:0:13"
msgid "Good, precise movements."
msgstr ""

#. ja: なかなかの太刀さばき
#. de: Deine Fechtkunst ist beeindruckend.
#. fr: Tes frappes sont vigoureuses. C'est bien.
msgctxt "NpcYell:6327:0:13"
msgid "You have a feel for the blade."
msgstr ""

#. ja: 喝っ！！
#. de: Hiyaaa!
#. fr: Hiyaaa<nbsp>!
msgctxt "NpcYell:6328:0:13"
msgid "Hah!"
msgstr ""

#. ja: ブドゥガ族には<br>なりたくないよ…
#. de: Ich will kein Buduga werden.
#. fr: Je veux bien devenir n'importe quoi, sauf un Buduga...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6329:0:13"
msgid "They won't make<br>me one of them!"
msgstr ""

#. ja: もう嫌だよぉ…
#. de: Ich habe Angst ...
#. fr: Pourquoi moi<nbsp>?
msgctxt "NpcYell:6330:0:13"
msgid "I want to go home!"
msgstr ""

#. ja: イ……イツマデ……
#. de: Für ... immer ...
#. fr: Pour toujours...
msgctxt "NpcYell:6331:0:13"
msgid "For...ever..."
msgstr ""

#. ja: イツマデモ……
#. de: Und ... immer ...
#. fr: À jamais...
msgctxt "NpcYell:6332:0:13"
msgid "And...ever..."
msgstr ""

#. ja: これでボクも…<br>ブドゥガ族か…
#. de: Muss ich jetzt ein Buduga werden?
#. fr: J'aurais au moins aimé pouvoir dire adieu aux Mol... (soupire)
msgctxt "NpcYell:6333:0:13"
msgid "Farewell, Mother... Father..."
msgstr ""

#. ja: うおおぉぉぉぉ！
#. de: Uoooarrr!
#. fr: Rhaaaaa<nbsp>!
msgctxt "NpcYell:6334:0:13"
msgid "Woooaaagh!"
msgstr ""

#. ja: どりゃあ！
#. de: Yaaah!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:6335:0:13"
msgid "Yaaargh!"
msgstr ""

#. ja: 食らえ！
#. de: Nimm das!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:6336:0:13"
msgid "Eat this!"
msgstr ""

#. ja: 死ね！
#. de: Stirb!
#. fr: Crève<nbsp>!
msgctxt "NpcYell:6337:0:13"
msgid "Die!"
msgstr ""

#. ja: うぺぺぺぺ…<br>お宝どこっぺか？
#. de: Heheheee! Wo sind denn nun die Schätze?
#. fr: Héhéhé... Mes moustaches me disent qu'il y a un trésor dans les environs...
msgctxt "NpcYell:6338:0:13"
msgid "We came for the treasure! Yes, yes! Where is it?"
msgstr ""

#. ja: 誰にもお宝は<br>渡さないっぺよ…
#. de: Ich geb keinem was ab - vvversprochen!
#. fr: Hors de question de donner ce trésor à qui que ce soit<nbsp>!
msgctxt "NpcYell:6339:0:13"
msgid "It is mine! Everything here─it is all mine!"
msgstr ""

#. ja: どっちに<br>行くっぺかな？
#. de: Hier lang? Oder doch da entlang?
#. fr: Bien, voyons... Où est-ce qu'il faut aller<nbsp>?
msgctxt "NpcYell:6340:0:13"
msgid "To go left or to go right? That is the question..."
msgstr ""

#. ja: 邪魔するヤツは<br>ブスリっぺよ！
#. de: Wer mir in die Quere kommt, bekommt was mit dem Dreizack!
#. fr: Pas de pitié pour ceux qui se mettent en travers de mon chemin<nbsp>!
msgctxt "NpcYell:6341:0:13"
msgid "Show no mercy to any who stand in our way!"
msgstr ""

#. ja: ここらが引き際…<br>帰るっぺよ！
#. de: Genug gewatschelt. Ich verabschiede mich!
#. fr: Il est temps... que je m'en aille<nbsp>!
msgctxt "NpcYell:6342:0:13"
msgid "Retreat! Retreat!"
msgstr ""

#. ja: ギョギョギョ！？<br>ヤる気っぺか！
#. de: Heheheee! Ihr wollt was auf die Ffflossen?
#. fr: Hein<nbsp>!? Vous voulez vous battre<nbsp>!?
msgctxt "NpcYell:6343:0:13"
msgid "You want to fight? Yes, yes! Well, it is a fight you will get!"
msgstr ""

#. ja: 邪魔するヤツは<br>ブスブスブスっぺよ！
#. de: Das wirst du büßen, Fffreundchen!
#. fr: Je vais vous mettre une bonne raclée<nbsp>!
msgctxt "NpcYell:6344:0:13"
msgid "I will cut you down!"
msgstr ""

#. ja: ギョギョギョギョ！
#. de: Aua!
#. fr: Bloueurgh<nbsp>!
msgctxt "NpcYell:6345:0:13"
msgid "Graaah!"
msgstr ""

#. ja: うぺぺ…ぺ…<br>やられたっぺよ…
#. de: Hehe-heee ...? \<röchel>
#. fr: Je... je me suis fait <i>eu</i>...
#. macro: <if $gn4>She<else>He</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:6346:0:13"
msgid "Aaargh! <if $gn4>She<else>He</if> got me─right in the gut!"
msgstr ""

#. ja: うぺぺ！？<br>逃げるが勝ちっぺよ！
#. de: Wer ffflieht, vvverliert nicht!
#. fr: La victoire appartient à celui qui... sait fuir au bon moment<nbsp>!
msgctxt "NpcYell:6347:0:13"
msgid "The best fighters know when to stay and when to flee! Ghahaha! You shan't catch me!"
msgstr ""

#. ja: や、やっぱり<br>婆さんの言うとおりだ…
#. de: Die Legenden sind also wahr!
#. fr: Grand-mère avait raison<nbsp>!
msgctxt "NpcYell:6348:0:13"
msgid "It was all true!"
msgstr ""

#. ja: しばらくは<br>家に隠れているか…
#. de: Ich sitz das lieber zuhause aus.
#. fr: Mieux vaut rentrer à la maison et attendre qu'ils s'en aillent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6349:0:13"
msgid "I'm never leaving<br>my bed again!"
msgstr ""

#. ja: 倒したのか！？<br>アンタ強いんだな！！
#. de: Die Biester sind besiegt? Unglaublich!
#. fr: T-tu les as vaincus<nbsp>!? Incroyable, quelle force<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6350:0:13"
msgid "Was it truly Tsurubebi...<br>or something else...?"
msgstr ""

#. ja: さあ、仕事を再開しよう
#. de: Dann mal zurück an die Arbeit!
#. fr: Je vais pouvoir me remettre au travail<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6351:0:13"
msgid "No. Don't tell me.<br>I don't want to know."
msgstr ""

#. ja: 退治してくれて<br>ありがとうよ！
#. de: Oh, und vielen Dank, <if $gn4>mein Mädchen<else>mein Junge</if>!
#. fr: Merci de m'en avoir débarrassé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6352:0:13"
msgid "I'm never leaving<br>my bed again!"
msgstr ""

#. ja: クッ…<br>囲まれたか！？
#. de: Ich bin umzingelt ...
#. fr: Tss... Je me suis fait encerrrcler...
msgctxt "NpcYell:6353:0:13"
msgid "They've surrounded us..."
msgstr ""

#. ja: なんとか切り抜けなければ…
#. de: Es muss einen Weg geben ...
#. fr: Il doit bien y avoir un moyen de me sorrrtir de là...
msgctxt "NpcYell:6354:0:13"
msgid "There must be some way..."
msgstr ""

#. ja: 感謝する…<br>では、ゆくぞッ！
#. de: Danke! Folge mir!
#. fr: Merrrci<nbsp>! Suis-moi<nbsp>!
msgctxt "NpcYell:6355:0:13"
msgid "Right then. Follow my lead."
msgstr ""

#. ja: やめてくれっぺよ！
#. de: Hört aufff damit!
#. fr: Arrêteeez<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6356:0:13"
msgid "Those are mine!<br>Mine! Mine! Mine!"
msgstr ""

#. ja: 旅のお方<br>がんばるっぺな！
#. de: Streng dich an, Abenteurer<if $gn4>in</if>!
#. fr: Courage, <if $gn4>voyageuse<else>voyageur</if><nbsp>! Je suis avec toi<nbsp>!
msgctxt "NpcYell:6357:0:13"
msgid "Hit him in the head! The head!"
msgstr ""

#. ja: やめてくれっぺよ！
#. de: Aufffhören!
#. fr: Arrêteeez<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6358:0:13"
msgid "Those are mine!<br>Mine! Mine! Mine!"
msgstr ""

#. ja: 旅のお方<br>がんばるっぺな！
#. de: Schlag sie zurück, Abenteurer<if $gn4>in</if>!
#. fr: Courage, <if $gn4>voyageuse<else>voyageur</if><nbsp>! Je suis avec toi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6359:0:13"
msgid "Right to the whiskers!<br>The whiskers!"
msgstr ""

#. ja: ギョエエエエエー！
#. de: Blubb?
#. fr: PWACHON<nbsp>! PWACHON<nbsp>!
msgctxt "NpcYell:6360:0:13"
msgid "GRAYHYGRAGRRRYAH!"
msgstr ""

#. ja: 食い物もらうっぺよ！
#. de: Danke für die Fffische!
#. fr: En avant<nbsp>! À l'assaut du goûter<nbsp>!
msgctxt "NpcYell:6361:0:13"
msgid "Pick the pack! Pick the pack!"
msgstr ""

#. ja: うぺぺぺぺ！<br>逃げるっぺよ～！
#. de: Ffflucht!
#. fr: Chacun pour sa peau<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6362:0:13"
msgid "Keep your plump pack!<br>Keep it! Keep it!"
msgstr ""

#. ja: 我らに逆らうからだ！
#. de: Niemand widersetzt sich uns!
#. fr: C'est ce qui arrive quand on s'oppose à nous<nbsp>!
msgctxt "NpcYell:6363:0:13"
msgid "You will always be weak!"
msgstr ""

#. ja: ひ、ひぃ～！
#. de: \<winsel>
#. fr: Aaah<nbsp>! F-fuyez<nbsp>!
msgctxt "NpcYell:6364:0:13"
msgid "\\<whimper> \\<whimper>"
msgstr ""

#. ja: クッ…<br>一旦退くぞ！
#. de: Mist! Einstweiliger Rückzug!
#. fr: Bordel... On décampe<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6365:0:13"
msgid "Might I suggest a strategic,<br>yet not at all shameful retreat?"
msgstr ""

#. ja: 何とか追い払えたか…
#. de: Wir haben sie fortgejagt!
#. fr: Ça a pas été du gâteau...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6366:0:13"
msgid "They'll think twice before<br>coming back...won't they?"
msgstr ""

#. ja: ありがとっちゃ！<br>助けに行くっちゃ！
#. de: <if $gn4>Freundlichste von freundlichsten Aben<shy>teu<shy>re<shy>rin<shy>nen<else>Freundlichster von freundlichsten Abenteurern</if>, Mimiroon sehr dankbar für Freundlichkeit sein!
#. fr: Merci, <if $gn4>gentille aventuuurière<else>gentil aventuuurier</if><nbsp>! Vite<nbsp>! Vite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6367:0:13"
msgid "Kindest of kindly strangers!<br>Mimiroon is most grateful<br>for such kind kindness!"
msgstr ""

#. ja: そうか！<br>見て来てくれるか！
#. de: Du gibst mir Geleitschutz? Dann lass uns aufbrechen!
#. fr: Tu veux bien m'escorter<nbsp>!? Génial<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6368:0:13"
msgid "You will protect me, then?<br>Twelve be praised!"
msgstr ""

#. ja: あれは山賊か？<br>お、追い払ってくれ！
#. de: Verflucht! Sie haben uns entdeckt!
#. fr: L-les voilà<nbsp>! Les Qiqirns<nbsp>! Aide-moi<nbsp>!
msgctxt "NpcYell:6369:0:13"
msgid "Aaah! We're discovered!"
msgstr ""

#. ja: 恩に着るぜ…<br>よし、迎え撃つぞ！
#. de: Diese Ratten verdienen keine Gnade! Keinen Hauch!
#. fr: Je te revaudrai ça<nbsp>! Ne leur fais pas de cadeau<nbsp>! Ces nuisibles n'en méritent aucun<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6370:0:13"
msgid "Rats as those deserve<br>no mercy! Not a damn whit!"
msgstr ""

#. ja: 鱗粉には<br>注意してください！
#. de: Bitte ... \<hust> ... \<keuch> <br>\<winsel> Schnell ...! \<hust>
#. fr: (tousse) F-faites attention<nbsp>! (tousse) (tousse) Abattez-les<nbsp>! Vite<nbsp>! (tousse)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6371:0:13"
msgid "Please...\\<cough> \\<hack> <br>\\<wheeze> Hurry...! \\<choke>"
msgstr ""

#. ja: ありがとう…<br>や、奴らが来るぞ…！
#. de: So spricht <if $gn4>eine wahre Kriegerin<else>ein wahrer Krieger</if>!
#. fr: Han, merci<nbsp>! Attention<nbsp>! Ils refont un passage<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6373:0:13"
msgid "Spoken like a<br>true fellow warrior!"
msgstr ""

#. ja: 援護してくれるのか！
#. de: Mein Leben liegt in deinen Händen.
#. fr: Tu es <if $gn4>ma sauveuse<else>mon sauveur</if><nbsp>!
msgctxt "NpcYell:6374:0:13"
msgid "My life is in your hands!"
msgstr ""

#. ja: チャプリどもを<br>蹴散らしてくれ！
#. de: Vorsicht! Sie kommen!
#. fr: Mets-les en pièces<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:6375:0:13"
msgid "Look!<br>The chapulis draw near!"
msgstr ""

#. ja: とりゃ！
#. de: Hrnnng!
#. fr: Yaah<nbsp>!
msgctxt "NpcYell:6376:0:13"
msgid "Hrnnng!"
msgstr ""

#. ja: このッ！
#. de: Du ...!
#. fr: Tiens<nbsp>!
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:6377:0:13"
msgid "I have <if $gn4>her<else>him</if>! I have <if $gn4>her<else>him</if>!"
msgstr ""

#. ja: 倒れろッ！
#. de: Dich mäh ich um!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:6378:0:13"
msgid "One! Two! Three!"
msgstr ""

#. ja: くらえッ！
#. de: Nimm dies!
#. fr: Raaah<nbsp>!
msgctxt "NpcYell:6379:0:13"
msgid "Diamond Dust!"
msgstr ""

#. ja: いっけー！
#. de: Hier!
#. fr: Allez<nbsp>!
msgctxt "NpcYell:6380:0:13"
msgid "Is this right?"
msgstr ""

#. ja: これくらいッ！
#. de: Schluss mit Lustig!
#. fr: Et ça<nbsp>!
msgctxt "NpcYell:6381:0:13"
msgid "Hero? Hah!"
msgstr ""

#. ja: ●くそッ…限界だ…
#. de: 0
#. fr: 0
msgctxt "NpcYell:6382:0:13"
msgid "0"
msgstr ""

#. ja: ●フォルドラが<br>耐えてくれている間に…！
#. de: 0
#. fr: 0
msgctxt "NpcYell:6383:0:13"
msgid "0"
msgstr ""

#. ja: ●無事かフォルドラ？！<br>この…倒れろッ！！
#. de: 0
#. fr: 0
msgctxt "NpcYell:6384:0:13"
msgid "0"
msgstr ""

#. ja: ●はぁ…はぁ…
#. de: 0
#. fr: 0
msgctxt "NpcYell:6385:0:13"
msgid "0"
msgstr ""

#. ja: ●負けるわけには…
#. de: 0
#. fr: 0
