#. ja: 見エル、見エルゾ……貴様タチノ死ガ……！
#. de: Ich kann ihn sehen! Euren Tod!
#. fr: Hi hi hi... Je vois tout... Même votre avenir funeste<nbsp>!
msgctxt "NpcYell:6801:0:13"
msgid "I see you, and the darkness that awaits..."
msgstr ""

#. ja: 我ガ未来ニ陰リガ……馬鹿ナ……！
#. de: Ein Schatten auf meiner Zukunft? Unmöglich!
#. fr: N-non...<nbsp>! Quelle est cette ombre qui m'empêche de voir mon futur<nbsp>!?
msgctxt "NpcYell:6802:0:13"
msgid "Mine future...grows clouded!? Absurd! "
msgstr ""

#. ja: ンモオオオォォォ…！
#. de: \<muuuhhh>
#. fr: MEUUUHHH<nbsp>!!!
msgctxt "NpcYell:6803:0:13"
msgid "Ahem. Moooooo!"
msgstr ""

#. ja: 偽装解除……守護者ノ使命、執行スル……！
#. de: Schluss mit dem Versteckspiel! Lang genug mussten meine Schutzbefohlenen leiden!
#. fr: DÉSACTIVATION DU MODE CAMOUFLAGE... MOBILISATION DES FIDÈLES...
msgctxt "NpcYell:6804:0:13"
msgid "Very well. Enough of this guise. I shall suffer thee no longer!"
msgstr ""

#. ja: 罪ヲ告白セヨ……懺悔セヨ、懺悔セヨ……！
#. de: Sühnt eure Sünden, Sterbliche! Tut Buße!
#. fr: AVOUEZ VOS PÉCHÉS... FAITES PÉNITENCE... FAITES PÉNITENCE<nbsp>!
msgctxt "NpcYell:6805:0:13"
msgid "Confess thy sins, trespassers!"
msgstr ""

#. ja: 懺悔セヨ、懺悔セヨ……我ガ前ニ跪ケ……！！
#. de: Tut Buße! Fallt vor uns nieder!
#. fr: À GENOUX DEVANT VOTRE BOVINE DÉESSE<nbsp>!
msgctxt "NpcYell:6806:0:13"
msgid "Thou shalt repent, and kneel before me!"
msgstr ""

#. ja: 荒れ狂うエーテルの吹雪……ここが新たな戦場か……。
#. de: Der Äther knistert vor Kälte! Dies ist also der Schauplatz meines nächsten Kampfes!
#. fr: L'éther qui se déchaîne... Le blizzard éternel... Voilà donc à quoi ressemble mon nouveau champ de bataille.
msgctxt "NpcYell:6807:0:13"
msgid "A blizzard of aether? What a peculiar land."
msgstr ""

#. ja: なるほど、この地にも戦うに値する敵がいたか……。
#. de: Und seht, wer hätte das gedacht? Ein würdiger Gegner!
#. fr: Je vois... Cette terre abritait donc <if $gn4>une<else>un</if> adversaire digne de ce nom<nbsp>!
msgctxt "NpcYell:6808:0:13"
msgid "Or should I say battlefield? For that I am here can only mean..."
msgstr ""

#. ja: おもしろい、異郷にて、これほどの敵に出会えるとは……。
#. de: Diese Welt beginnt, mir zu gefallen!
#. fr: Intéressant... Jamais je n'aurais pensé livrer un aussi splendide combat dans un tel endroit.
msgctxt "NpcYell:6809:0:13"
msgid "...you are a foe worthy of testing!"
msgstr ""

#. ja: グオォォォォォン！
#. de: Grrroahr!
#. fr: GroOOaaAhr<nbsp>!
msgctxt "NpcYell:6810:0:13"
msgid "Grrraaaaaarrrghhh!"
msgstr ""

#. ja: 冒険者たち<br>モグに続くクポ～♪
#. de: Folgt mir, kupo!
#. fr: Allez les aventuriers<nbsp>! Qui m'aime me suive, kupo<nbsp>!
msgctxt "NpcYell:6811:0:13"
msgid "Follow me, kupo!"
msgstr ""

#. ja: こ、怖いクポ…
#. de: Irgendwie unheimlich, kupo!
#. fr: Je... J'ai quand même un t-tout petit peu peur, k-kupo...
msgctxt "NpcYell:6812:0:13"
msgid "Wh-Wh-What was that, kupo!?"
msgstr ""

#. ja: 余裕の勝利クポ！
#. de: Sieg auf ganzer Linie, kupo!
#. fr: Vous l'avez vaincu avec une telle facilité, kupo<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:6813:0:13"
msgid "I─er, <i>we</i> did it, kupo!"
msgstr ""

#. ja: 広いクポ！<br>大きいクポ！
#. de: Ganz schön geräumig, kupo!
#. fr: L'intérieur est si vaste<nbsp>! Et on n'en voit même pas le sommet, kupo<nbsp>!
msgctxt "NpcYell:6814:0:13"
msgid "This place is enormous, kupo!"
msgstr ""

#. ja: や、やっぱり恐いクポ…<br>でも、どんどん進むクポ！
#. de: Ich hab immer noch Angst<nbsp>... Aber es hilft ja nichts, kupo!
#. fr: M'enfoncer davantage ne me rassure pas... m-mais je n'ai qu'une parole, kupo<nbsp>!
msgctxt "NpcYell:6815:0:13"
msgid "No going b-b-back now, I suppose?"
msgstr ""

#. ja: こ、ここを通せクポ！
#. de: H-Hier lang, kupo!
#. fr: Laissez-nous passer, kupo<nbsp>!
msgctxt "NpcYell:6816:0:13"
msgid "Let us through, kupo!"
msgstr ""

#. ja: あ、熱いクポ…！
#. de: Autsch, mein Bommel verglüht, kupo!
#. fr: M-mon beau pelage<nbsp>! Je le sens roussir, kupo<nbsp>!
msgctxt "NpcYell:6817:0:13"
msgid "Owowowowow!"
msgstr ""

#. ja: どんどん登るクポ！
#. de: Immer weiter rauf, kupo!
#. fr: Toujours plus haut, kupo<nbsp>!
msgctxt "NpcYell:6818:0:13"
msgid "You think we're high enough yet?"
msgstr ""

#. ja: 高度5000ヤルムに<br>飛んできちゃったクポ？
#. de: Flughöhe von 5000 Yalmen<nbsp>... erreicht, kupo?
#. fr: J'ai mesuré notre altitude actuelle à plus de cinq mille yalms<nbsp>! C'est incroyable, kupo<nbsp>!
msgctxt "NpcYell:6819:0:13"
msgid "And I would climb 5000 yalms.♪"
msgstr ""

#. ja: お見事クポ～♪
#. de: Kupotastisch!
#. fr: Bien vu, kupo<nbsp>!
msgctxt "NpcYell:6820:0:13"
msgid "Well done, kupo!"
msgstr ""

#. ja: 気味の悪い<br>連中クポ～！
#. de: Die sind mir nicht geheuer, kupo.
#. fr: Houla, ceux-là n'ont pas l'air commodes non plus, kupo...
msgctxt "NpcYell:6821:0:13"
msgid "Well, aren't those simply appalling, kupo!"
msgstr ""

#. ja: バッガモナンは<br>どこクポ？
#. de: Wo steckt Ba'Gamnan bloß, kupo?
#. fr: Mais où est allé se cacher Ba'Gamnan, kupo<nbsp>?
msgctxt "NpcYell:6822:0:13"
msgid "Where is the Bangaa, kupo?"
msgstr ""

#. ja: よくわからないけど<br>驚いたクポ！
#. de: Das war<nbsp>... ziemlich verblüffend, kupo!
