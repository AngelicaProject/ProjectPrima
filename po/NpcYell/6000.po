msgid "Crack... Crumble... DIE!"
msgstr ""

#. ja: 消えろ…
#. de: Verschwinde aus meinem Blick!
#. fr: Disparais maintenant...
msgctxt "NpcYell:6785:0:13"
msgid "Begone..."
msgstr ""

#. ja: う～ん…
#. de: Ungh ...
#. fr: Hmmouah...
msgctxt "NpcYell:6786:0:13"
msgid "Ugh..."
msgstr ""

#. ja: うぅ～…
#. de: Aghaaa ...
#. fr: MOUooOHhh...
msgctxt "NpcYell:6787:0:13"
msgid "Hrrrgh..."
