# NpcYell
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 罠の可能性も…
#. de: Passt auf Fallen auf<nbsp>...
#. fr: Ça sent le traquenard à plein nez...
msgctxt "NpcYell:10000:0:13"
msgid "Now this definitely seems like a trap."
msgstr "А теперь это точно похоже на ловушку."

#. ja: 地下に下りているのか？
#. de: Es geht nach unten weiter!
#. fr: On descend...
msgctxt "NpcYell:10001:0:13"
msgid "Down we go..."
msgstr "Ну что, спускаемся..."

#. ja: どこまで降りるんだ…？
#. de: Aber bis wohin?
#. fr: Jusqu'où, là est la question...
msgctxt "NpcYell:10002:0:13"
msgid "But how far down?"
msgstr "Интересно, как глубоко..."

#. ja: 雰囲気が変わってきたような…
#. de: Hm? Hier sieht es aber anders aus<nbsp>...
#. fr: Tiens<nbsp>? L'architecture a changé.
msgctxt "NpcYell:10003:0:13"
msgid "Is it just me...or does this seem...different?"
msgstr "Мне одному кажется... или тут... всё как-то иначе?"

#. ja: 見るからに<br>危険な空気が…
#. de: Mir gefällt das überhaupt nicht<nbsp>...
#. fr: Ça fiche les jetons...
msgctxt "NpcYell:10004:0:13"
msgid "Dangerous, certainly."
msgstr "Да уж, местечко опасное."

#. ja: 見ろ！<br>敵がいるぞ！
#. de: Vorsicht! Feinde!
#. fr: Argh... Ennuis en vue<nbsp>!
msgctxt "NpcYell:10005:0:13"
msgid "Aaand there are more."
msgstr "А вот и ещё враги!"

#. ja: 避けることは<br>できそうにないですね…
#. de: Schleichen scheint keine Option<nbsp>...
#. fr: Il va falloir leur passer sur le châssis.
msgctxt "NpcYell:10006:0:13"
msgid "If you could clear the path...?"
msgstr "Тут без боя не пройти... Поможете расчистить путь?"

#. ja: 機械生命体の残骸…<br>あの黒いアンドロイドが？
#. de: Reste von Maschinenwesen<nbsp>... War das die schwarze Androidin?
#. fr: Des carcasses de formes de vie mécaniques...
msgctxt "NpcYell:10007:0:13"
msgid "Broken machines..."
msgstr "Обломки машин..."

#. ja: 一足先に２Ｂが<br>ここを通ったのか…？
#. de: 2B ist hier bestimmt vorbeigekommen!
#. fr: Vous pensez que 2B est passée par là<nbsp>?
msgctxt "NpcYell:10008:0:13"
msgid "2B must have gotten here first."
msgstr "Неужели 2B уже успела сюда добраться?"

#. ja: た、助かった…
#. de: Gerettet!
#. fr: O-on a réussi...
msgctxt "NpcYell:10009:0:13"
msgid "We made it..."
msgstr "Фух, пронесло..."

#. ja: 生きた心地がしない…
#. de: Ich dachte nicht, dass wir das überleben ...
#. fr: Je n'en reviens pas d'être encore en vie...
msgctxt "NpcYell:10010:0:13"
msgid "Am I dead? I don't feel dead."
msgstr "Я что, умер? Нет, вроде живой."

#. ja: はぁ、はぁ…
#. de: \<keuch> \<keuch>
#. fr: (halète) (halète)
msgctxt "NpcYell:10011:0:13"
msgid "\\<huff> \\<pant>"
msgstr "\\<пыхтит> \\<тяжело дышит>"

#. ja: 救援に感謝する！<br>総員、急ぎ帰還するぞ…！
#. de: Ein Hoch auf <if $gn4>die Befreierin<else>den Befreier</if>. <if $gn4>Ihr<else>Ihm</if> verdanken wir unsere Leben. Und jetzt, alle Mann zurückziehen!
#. fr: Merci, on vous doit la vie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10012:0:13"
msgid "My thanks, you saved our skins out there.<br>We're headed home, lads─quick march!"
msgstr "Спасибо! Вы нас спасли!<br>Мы возвращаемся домой. Живее, ребята! Шагом марш!"

#. ja: 見ぃつけた！<br>帝国軍の偵察機よ！
#. de: Da ist der feindliche Aufklärer!
#. fr: Les voilà<nbsp>! Les armes de recon<shy>nais<shy>san<shy>ce de l'Empire<nbsp>!
msgctxt "NpcYell:10013:0:13"
msgid "Haha! Found them! Their scouting days are well and truly over!"
msgstr "Ха-ха! Нашёл! С их разведкой покончено!"

#. ja: ブラズ、ヴェリボル！<br>気合い入れていくよッ！
#. de: Blaz! Velibor! Auf sie mit Gebrüll!
#. fr: À nous de jouer<nbsp>! Blaz, Velibor, avec moi<nbsp>!
msgctxt "NpcYell:10014:0:13"
msgid "Blaz! Velibor! It's our time to shine!"
msgstr "Блаз! Велибор! Наш выход!"

#. ja: 応ッ！
#. de: Jawohl!
#. fr: J'arrive<nbsp>!
msgctxt "NpcYell:10015:0:13"
msgid "Indeed."
msgstr "Точно."

#. ja: さて、次はどこを探す？
#. de: Wo wollen wir uns als Nächstes umsehen?
#. fr: 0
msgctxt "NpcYell:10016:0:13"
msgid "0"
msgstr "Куда теперь пойдём?"

#. ja: 逃がさんッ！
#. de: Lasst keinen entkommen!
#. fr: Tu es à moi<nbsp>!
msgctxt "NpcYell:10017:0:13"
msgid "None shall escape my blade."
msgstr "От моего клинка никто не уйдёт!"

#. ja: 息子よ、力を合わせるネ！<br>スークの仲間、助けるヨ！
#. de: Komm, Ghun Gun! Freunde brauchen Hilfe!
#. fr: Aide-moi, mon fils<nbsp>! Nous allons donner un coup de main à notre ami<if $gn4>e</if>, oui oui<nbsp>!
msgctxt "NpcYell:10018:0:13"
msgid "Come, Ghun Gun! Our friends need help!"
msgstr "Пойдём, Гун Гун! Нашим друзьям нужна помощь!"

#. ja: 気をつけるネ！
#. de: Vorsicht, ja?
#. fr: Fais attention à toi, <split " " 1><string $gs1></split>, bien attention<nbsp>!
msgctxt "NpcYell:10019:0:13"
msgid "Be careful, yes?"
msgstr "Осторожнее, ладно?"

#. ja: 絶対にまた会うネ！<br>待ってるヨ！
#. de: Besuch uns mal wieder!
#. fr: Reviens nous voir quand tu veux voyageu<if $gn4>se<else>r</if>, quand tu veux<nbsp>!
msgctxt "NpcYell:10020:0:13"
msgid "Come and visit us again!"
msgstr "Заходите к нам ещё!"

#. ja: なんだか知らんが<br>行っちまえ！
#. de: Ich weiß zwar nicht, was hier los ist, aber wir sollten hier besser keine Wurzeln schlagen.
#. fr: Pfiou<nbsp>! La situation me dépasse... En tout cas, la voie est libre<nbsp>!
msgctxt "NpcYell:10021:0:13"
msgid "I haven't the faintest what's going on, but you'd best keep moving!"
msgstr "Что тут вообще творится, не знаю, но вам лучше не задерживаться!"

#. ja: 木っ端微塵だ！
#. de: Tausend Stücke, hab ich gesagt!
#. fr: Je vais te réduire en poussière<nbsp>!
msgctxt "NpcYell:10022:0:13"
msgid "There is nowhere to run!"
msgstr "Вам некуда бежать!"

#. ja: 騒ぎを聞いて<br>駆けつけてみれば…！
#. de: Als ich das Getöse hörte, hab ich gleich nachgesehen, was los ist, aber ...
#. fr: Ha<nbsp>! Voyez qui on retrouve au milieu de tout ce raffut<nbsp>!
msgctxt "NpcYell:10023:0:13"
msgid "Just when I think there's a commotion..."
msgstr "Услышал шум, прибежал посмотреть, а тут..."

#. ja: タロースの試運転中で<br>ちょうどよかったな！
#. de: Gut, dass wir gerade dabei waren, unsere Taloi zu testen.
#. fr: Eh ben heureusement qu'on testait nos talos dans le coin<nbsp>!
msgctxt "NpcYell:10024:0:13"
msgid "Lucky we chanced to be testing some Talos!"
msgstr "Хорошо, что мы как раз испытывали талосов!"

#. ja: 気をつけてなー！
#. de: Passt auf euch auf, ja?
#. fr: Faites gaffe, d'accord<nbsp>!?
msgctxt "NpcYell:10025:0:13"
msgid "Take care, you hear?"
msgstr "Берегите себя, слышите?"

#. ja: ああ…やっぱり<br>止まっちゃったかぁ…
#. de: So ein Mist. Er hat den Geist aufgegeben.
#. fr: Arg, je savais qu'il allait nous lâcher après ça...
msgctxt "NpcYell:10026:0:13"
msgid "Well, it's back to the workshop with this lot..."
msgstr "Ну всё, придётся тащить эту шайку обратно в мастерскую..."

#. ja: なによ！<br>ピカピカしちゃって！
#. de: Warum leuchten sie so? Haben sie in Feenstaub gebadet?
#. fr: Han<nbsp>! Pour qui ils se prennent à briller comme ça<nbsp>!?
msgctxt "NpcYell:10027:0:13"
msgid "Why do they glow like that? Weird, I tell you!"
msgstr "Да что с ними такое? Светятся, прямо как новогодние ёлки!"

#. ja: こいつらと<br>遊べばいいのね？
#. de: Ach, das sind die, mit denen wir lustig spielen sollen, ja?
#. fr: Eux, on a le droit de jouer avec, hein<nbsp>?
msgctxt "NpcYell:10028:0:13"
msgid "These are the ones we should play with, right?"
msgstr "С ними-то нам и надо поиграть, да?"

#. ja: こっちだ！
#. de: Hier drüben!
#. fr: 0
msgctxt "NpcYell:10029:0:13"
msgid "0"
msgstr "Сюда!"

#. ja: ン・モゥとて戦うときは<br>わきまえておりますぅ！
#. de: Wir Nu Mou sind keine kriegerischen Krieger, aber wir wissen uns zu wehren!
#. fr: Un Nu Mou sait lorsqu'il doit laisser son amabilité de côté pour le plus grand bien<nbsp>!
msgctxt "NpcYell:10030:0:13"
msgid "We Nu Mou are not wont to fight, but we know when we must!"
msgstr "Мы, Ну Мо, не любим драться, но знаем, когда без этого не обойтись!"

#. ja: 何やら必死のようじゃな！<br>どうしたんじゃ？
#. de: Was auch immer hier los ist, auf meinen Hammer kannst du zählen!
#. fr: Je comprends rien à c'foutoir, mais vous pouvez compter sur moi et ma hache<nbsp>!
msgctxt "NpcYell:10031:0:13"
msgid "Whatever's going on, you've got my hammer!"
msgstr "Что бы тут ни творилось, мой молот к вашим услугам!"

#. ja: これも賞金稼ぎの<br>仕事の内ってね…！
#. de: Nur ein weiterer Auftrag für einen Kopfgeldjäger.
#. fr: Bof, un jour comme un autre pour un chasseur de primes<nbsp>!
msgctxt "NpcYell:10032:0:13"
msgid "Just another job for a bounty hunter."
msgstr "Ещё один обычный день охотника за головами."

#. ja: クッ、近寄れないぞ……！
#. de: Mist, ich komme nicht näher!
#. fr: 0
msgctxt "NpcYell:10033:0:13"
msgid "0"
msgstr "Чёрт, не подступиться..."

#. ja: こ、こんな奴ら<br>目じゃないっての！
#. de: Ich hab schon Schlimmeres gesehen.
#. fr: De... de la rrrigolade<nbsp>! Ils vont devoir faire mieux que ça<nbsp>! Ha ha<nbsp>!
msgctxt "NpcYell:10034:0:13"
msgid "I've had far worse than this lot."
msgstr "Да я и не с таким справлялся!"

#. ja: はぐれ罪喰い…<br>ではなさそうだな…
#. de: Das sind keine Sünden<shy>ver<shy>tilger, so viel ist klar.
#. fr: Hmm... Ils ressemblent pas à des purgateurs errants.
msgctxt "NpcYell:10035:0:13"
msgid "Not sin eaters by the look of them."
msgstr "На пожирателей греха они, вроде, не похожи."

#. ja: こいつら…<br>かなり腕が立つぞ？
#. de: Wer auch immer sie sind, wir sollten sie nicht unter<shy>schätzen!
#. fr: Purgateurs errants ou pas, ils se dé<shy>brouil<shy>lent<nbsp>!
msgctxt "NpcYell:10036:0:13"
msgid "Whatever they are, they're not to be trifled with."
msgstr "Кто бы они ни были, шутить с ними не стоит."

#. ja: 何じゃ、猫もどきの小僧…<br>怖じ気付いておるのか？
#. de: Sag bloß, du hast die Hosen voll, Katzenjunge? Pass bloß auf, wo du hinschießt!
#. fr: Oh, regardez. Le Mystel préférerait être bien au chaud dans sa couche en train de faire des ronrons.
msgctxt "NpcYell:10037:0:13"
msgid "Keep it steady, eh, catboy? Don't want no arrow in my arse by accident."
msgstr "Держи лук ровнее, котик. А то ещё в задницу мне стрельнешь."

#. ja: だ、黙れ…！<br>そんなワケあるか！
#. de: W-Was?! Nennst du mich etwa einen Feigling?
#. fr: M-même pas vrrrai<nbsp>!
msgctxt "NpcYell:10038:0:13"
msgid "Wha─!? Do you take me for a craven!?"
msgstr "Ч-что!? Да ты меня трусом считаешь!?"

#. ja: 嗚呼、酒が…<br>酒が足りんのう！
#. de: Wenn ich doch jetzt nur ein Schlückchen Zwergenbräu hätte.
#. fr: Ahhh... Je tuerai pour un p'tit verre, là...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:10039:0:13"
msgid "Ugh, I would <i>kill</i> for a drink right now..."
msgstr "Эх, сейчас бы выпить... Я бы <i>убил</i> за кружку..."

#. ja: この戦いが終わったら<br>いくらでも奢ってやるよ！
#. de: Wenn das vorbei ist, kannst du meinetwegen meine Vorräte leersaufen, Zwerg!
#. fr: Je t'en paierai autant que tu veux, si on s'en sorrrt vivants<nbsp>!
msgctxt "NpcYell:10040:0:13"
msgid "When this is over, I'll buy you as many as you want!"
msgstr "Когда всё закончится, куплю тебе хоть целую бочку!"

#. ja: ハハハ…そりゃいいや！<br>俺も頼むぜ？
#. de: Das ist doch mal ein Wort! Ich bin dabei, ha!
#. fr: Oh oh<nbsp>! Et y aurait-il moyen de bénéficier de la même offre<nbsp>?
msgctxt "NpcYell:10041:0:13"
msgid "Oho, does that offer extend to me as well?"
msgstr "Ого, а мне тоже перепадёт?"

#. ja: おい、無駄口はそこまでだ！<br>まだまだ来るぞッ…！
#. de: Spart euch das Geschwätz für die Schenke. Das ist noch nicht vorbei.
#. fr: Vous pourrez en discuter à la taverne<nbsp>! Regardez<nbsp>! Il en arrive d'autres<nbsp>!
msgctxt "NpcYell:10042:0:13"
msgid "Save the talk for the tavern! We're not out of the woods yet!"
msgstr "Болтать будете в таверне! Мы ещё не выбрались!"

#. ja: 次から次へと<br>よくもまぁ…！
#. de: Argh, wie viele von denen gibt es denn noch?
#. fr: Tss... En effet, on n'est pas rendus...
msgctxt "NpcYell:10043:0:13"
msgid "Ack, no bloody end in sight..."
msgstr "Да чтоб их... Конца им не видно!"

#. ja: アンタらは先に行けッ！
#. de: Los, weiter! Wir halten hier die Stellung!
#. fr: Partez devant<nbsp>! On va les retenir<nbsp>!
msgctxt "NpcYell:10044:0:13"
msgid "Press on! We'll hold them here!"
msgstr "Идите вперёд! Мы их задержим!"

#. ja: いぇーいー！どんなもんよ！
#. de: Hurra! Wir sind die Besten!
#. fr: Haha<nbsp>! C'était trop facile<nbsp>!
msgctxt "NpcYell:10045:0:13"
msgid "Victory is ours!"
msgstr "Й-е-е! Вот это мы их!"

#. ja: 他愛もない…<br>鎧袖一触とはこのことか…
#. de: Der Sieg ist uns quasi in den Schoß gefallen.
#. fr: Ces tas de ferraille cassent trop facilement.
msgctxt "NpcYell:10046:0:13"
msgid "Empty metal shells. Barely worth my time."
msgstr "Жалкие пустые оболочки. Даже возиться с ними не стоило."

#. ja: 準備運動にも<br>なりゃしねぇ…
#. de: Schon Schluss? Ich bin gerade warm geworden.
#. fr: C'est à peine si j'ai versé une goutte de sueur.
msgctxt "NpcYell:10047:0:13"
msgid "I find little satisfaction in such feeble prey."
msgstr "Даже вспотеть не успел. Что за добыча..."

#. ja: 無念だが<br>ここは退かねば…
#. de: Es ist eine Schande, aber uns bleibt nur der Rückzug.
#. fr: Je regrette mais... Je n'ai pas d'autre choix que de fuir<nbsp>!
msgctxt "NpcYell:10048:0:13"
msgid "My blade is blunted, withdrawal the only available course of action."
msgstr "Как ни прискорбно, придётся отступить..."

#. ja: ブラズ、ヴェリボル…<br>ごめんなさい…
#. de: Blaz, Velibor. Bitte verzeiht.
#. fr: Blaz, Velibor... Pardonnez-moi...
msgctxt "NpcYell:10049:0:13"
msgid "It's no good, boys. We'd best call it a day."
msgstr "Блаз, Велибор... Простите..."

#. ja: 畜生ッ…<br>しくじったか…
#. de: Bei den Göttern, welch Schmach.
#. fr: Enfer... Quel déshonneur...
msgctxt "NpcYell:10050:0:13"
msgid "What a disgrace!"
msgstr "Проклятье... Позор-то какой!"

#. ja: ◎▼×□△…！
#. de: ◎▼□△ ...!
#. fr: ◎▼×□△...！
msgctxt "NpcYell:10051:0:13"
msgid "◎▼×□△..."
msgstr "◎▼×□△..."

#. ja: ＄◎×■△！
#. de: △◎■△!
#. fr: ＄◎×■△！
msgctxt "NpcYell:10052:0:13"
msgid "＄◎×■△!"
msgstr "＄◎×■△!"

#. ja: ♥￥▽▲○♥
#. de: ♥▽▲◎♥
#. fr: ♥￥▽▲○♥
msgctxt "NpcYell:10053:0:13"
msgid "♥￥▽▲○♥"
msgstr "♥￥▽▲○♥"

#. ja: △▲♪<br>◎◎×△□！
#. de: △▲♪<br>◎◎△□!
#. fr: △▲♪<br>◎◎×△□！
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10054:0:13"
msgid "△▲♪<br>◎◎×△□!"
msgstr "△▲♪<br>◎◎×△□!"

#. ja: 受けてみろ！
#. de: Mit ganzer Kraft!
#. fr: Ne bouge plus, ja<nbsp>!
msgctxt "NpcYell:10055:0:13"
msgid "Stay alert!"
msgstr "Ну-ка, попробуй увернись!"

#. ja: そこダッ…！
#. de: Da ... sind ... sie ...
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:10056:0:13"
msgid "Now I have you!"
msgstr "Вот ты где!"

#. ja: 逃さんゾ！
#. de: Lasst ... keinen ... entkommen ...
#. fr: Tu ne m'échapperas pas<nbsp>!
msgctxt "NpcYell:10057:0:13"
msgid "You won't escape me this time!"
msgstr "Теперь тебе от меня не уйти!"

#. ja: ギィィィッ！
#. de: Wuahaaa!
#. fr: Croooooaaa<nbsp>!
msgctxt "NpcYell:10058:0:13"
msgid "Aaahhhk!"
msgstr "Гииии!"

#. ja: キュイッ！
#. de: Wiiiiieher!
#. fr: Huuhuuu<nbsp>!
msgctxt "NpcYell:10059:0:13"
msgid "Neigh!"
msgstr "И-го-го!"

#. ja: ブルルルッ！
#. de: \<schnauf>
#. fr: Brrrr<nbsp>!
msgctxt "NpcYell:10060:0:13"
msgid "\\<whinny>"
msgstr "\\<ржание>"

#. ja: この子を<br>戦争の道具には…！
#. de: Mein armes Ding ... Wie können sie dir das antun!
#. fr: Je ne les laisserai pas te fairrre du mal<nbsp>!
msgctxt "NpcYell:10061:0:13"
msgid "No! I won't let you have him!"
msgstr "Нет! Не дам превратить тебя в орудие войны!"

#. ja: 支援しますッ！
#. de: Ich steh dir bei, meine Süße!
#. fr: Je suis avec toi, courrrage<nbsp>!
msgctxt "NpcYell:10062:0:13"
msgid "I'll do everything in my power to keep him safe!"
msgstr "Я сделаю всё, чтобы тебя защитить!"

#. ja: クゥイーン！
#. de: Wiiiiieher!
#. fr: Huuuuu<nbsp>!
msgctxt "NpcYell:10063:0:13"
msgid "Neeeigh!"
msgstr "И-го-го-о!"

#. ja: オオォォォン…！
#. de: Uaaaah!
#. fr: Rhhooooo<nbsp>!
msgctxt "NpcYell:10064:0:13"
msgid "Kshaaaaaah!"
msgstr "Кша-а-а!"

#. ja: 何度だって<br>浄化してみせるッ！
#. de: Ich werde die Flecken der Schande aus euren Herzen schneiden!
#. fr: Le monocéros purifiera autant de fois qu'il le faudrrra<nbsp>!
msgctxt "NpcYell:10065:0:13"
msgid "There is plenty more where that came from!"
msgstr "Сколько понадобится, столько раз и очищу!"

#. ja: クエエェッ！
#. de: Kweeeh!
#. fr: Kwéééé<nbsp>!
msgctxt "NpcYell:10066:0:13"
msgid "Kweeeh!"
msgstr "Кве-е-э!"

#. ja: クエッ、クエッ！
#. de: Kweh, kweh!
#. fr: Kwé, kwé<nbsp>!
msgctxt "NpcYell:10067:0:13"
msgid "Kweh, kweh!"
msgstr "Кве, кве!"

#. ja: いいぞ、いいぞ！
#. de: So ist brav ...
#. fr: C'est bien<nbsp>! Allez<nbsp>!
msgctxt "NpcYell:10068:0:13"
msgid "That's the spirit!"
msgstr "Вот так! Молодец!"

#. ja: やっちまえ～！
#. de: Mach <if $gn4>sie<else>ihn</if> fertig!
#. fr: Flanquez-lui une raclée<nbsp>!
msgctxt "NpcYell:10069:0:13"
msgid "Tear them apart!"
msgstr "Разорвите их на части!"

#. ja: そこだ！
#. de: Guter Junge!
#. fr: Parfait<nbsp>!
msgctxt "NpcYell:10070:0:13"
msgid "This fight's as good as won!"
msgstr "Отлично! Победа у нас в кармане!"

#. ja: ヒューッ！
#. de: Hossa!
#. fr: Hourrah<nbsp>!
msgctxt "NpcYell:10071:0:13"
msgid "Now strike!"
msgstr "Ну же! Бей!"

#. ja: 蹴散らしてやる！
#. de: Treibt sie auseinander!
#. fr: Je vais t'écraser, vermine<nbsp>!
msgctxt "NpcYell:10072:0:13"
msgid "Go back to whatever hole you crawled out from!"
msgstr "Убирайся обратно в ту дыру, из которой выполз!"

#. ja: まだまだ<br>こんなものではないぞ！
#. de: Es ist noch nicht vorbei.
#. fr: C'est pas le moment de flancher<nbsp>! Ce n'est pas fini<nbsp>!
msgctxt "NpcYell:10073:0:13"
msgid "You haven't beaten us yet!"
msgstr "Мы ещё не проиграли!"

#. ja: 燃やし尽くしてやる！
#. de: Favilludo Funkentanz!
#. fr: Je vais te réduire en cendres<nbsp>!
msgctxt "NpcYell:10074:0:13"
msgid "I will watch you burn!"
msgstr "Я сожгу тебя дотла!"

#. ja: メラメラメラメラ～！
#. de: Flim Flam Funkel!
#. fr: Brûle<nbsp>! Brûûûle<nbsp>!
msgctxt "NpcYell:10075:0:13"
msgid "Glllgh... Burn, burn, burn!"
msgstr "Гхх... Горите, горите, горите!"

#. ja: すべての魔力を<br>注ぎ込む！
#. de: Ignisphaero Feuerball!
#. fr: Tu vas tâter de ma pleine puissance<nbsp>!
msgctxt "NpcYell:10076:0:13"
msgid "My magick is infallible!"
msgstr "Моя магия не знает промаха!"

#. ja: うおおおッ～！
#. de: Mächte der Finsternis!!!
#. fr: Rhhoooaaaa<nbsp>!
msgctxt "NpcYell:10077:0:13"
msgid "More power! More power!"
msgstr "Ещё силы! Ещё!"

#. ja: 火炎魔法のなんたるか…<br>ご覧に入れましょう！
#. de: Jetzt lernt ihr die Macht des Feuers kennen.
#. fr: Admire la puissance de mes flammes<nbsp>!
msgctxt "NpcYell:10078:0:13"
msgid "Bear witness to my might!"
msgstr "Узрите мою мощь!"

#. ja: 我が魔法…<br>見切れますかな？
#. de: Das interessiert euch bestimmt <i>brennend</i>.
#. fr: Alors, tu n'en as pas eu assez<nbsp>?
msgctxt "NpcYell:10079:0:13"
msgid "Time to end this."
msgstr "Пора с этим покончить."

#. ja: 焔よ…<br>羽ばたきなさい！
#. de: Schlagt empor, Flügel des Feuers!
#. fr: Que les ailes ardentes t'emportent<nbsp>!
msgctxt "NpcYell:10080:0:13"
msgid "Flame, take flight!"
msgstr "Пламя, взмывай ввысь!"

#. ja: まだです…<br>焔よ、舞いなさい！
#. de: Das war noch nicht alles ... Tanzt, Flammen, tanzt!
#. fr: Tu tiens encore debout<nbsp>!? Prends ça<nbsp>!
msgctxt "NpcYell:10081:0:13"
msgid "You shan't be so lucky a second time!"
msgstr "Не думайте, что вам так повезёт во второй раз!"

#. ja: 融解なさい！
#. de: Alles soll brennen, glühen, schmelzen!
#. fr: La chaleur de mes flammes va te liquéfier<nbsp>!
msgctxt "NpcYell:10082:0:13"
msgid "Will you burn, or will you melt?"
msgstr "Ну что, сгорите или расплавитесь?"

#. ja: ハハハハッ…！<br>これが我が魔力です…！
#. de: Hahahaaa! Niemand beherrscht das Feuer so wie ich!
#. fr: Hahahaha<nbsp>! Vois donc l'étendue de mon pouvoir<nbsp>!
msgctxt "NpcYell:10083:0:13"
msgid "Hahahaha! Now do you see?"
msgstr "Ха-ха-ха! Теперь видите?"

#. ja: 遊びすぎましたか…<br>そろそろ、本気を出しましょう
#. de: Ist der Funke schon übergesprungen? Jetzt leg ich richtig los!
#. fr: Ce petit jeu m'amuse, mais il est grand temps de passer aux choses sérieuses<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10084:0:13"
msgid "I have enjoyed our time together,<br>but all things must come to an end."
msgstr "Я прекрасно провёл с вами время,<br>но всему приходит конец."

#. ja: 我が魔力を燃やして…！
#. de: Feuer frei! Muahahaha!
#. fr: Brûlez, ô flammes<nbsp>!
msgctxt "NpcYell:10085:0:13"
msgid "I am just getting started!"
msgstr "Я только начинаю!"

#. ja: 邪道ですが致し方なし…<br>毒を使うとしましょう…
#. de: Zur Abwechslung mal eine Prise Gift? Für das richtige <i>Brennen</i> in der Kehle.
#. fr: Je hais avoir recours au poison, mais tu ne me laisses pas le choix...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10086:0:13"
msgid "Though it galls me to use such underhanded tactics,<br>for you, poison will suffice."
msgstr "Ненавижу такие грязные приёмы,<br>но для вас сойдёт и яд."

#. ja: おぉぉ、魔力よ…<br>さらに燃え盛りなさい！
#. de: Wer außer mir ist noch <i>Feuer und Flamme</i> für die Pyromantie?
#. fr: Ressens-tu donc cette chaleur<nbsp>?
msgctxt "NpcYell:10087:0:13"
msgid "I am the inferno!"
msgstr "Я само пламя!"

#. ja: 燃えよ、爆ぜよ、火に焚べよ！
#. de: Ich will das Fett in euren Leibern kochen hören!
#. fr: Brûle<nbsp>! Explose<nbsp>! Retourne à l'état de poussière<nbsp>!
msgctxt "NpcYell:10088:0:13"
msgid "Ashes to ashes!"
msgstr "Прах к праху!"

#. ja: クッ…<br>衰えたなどと言わせるものか…
#. de: Das Feuer erlischt ...
#. fr: Urgh... Mes flammes... Elles s'estompent...
msgctxt "NpcYell:10089:0:13"
msgid "The light of my flame grows dim..."
msgstr "Свет моего пламени меркнет..."

#. ja: ゼェッ…ハァ…<br>ゼェッ…ハァ…
#. de: \<hust> \<hust>
#. fr: Haaa... Haaa... Argh...
msgctxt "NpcYell:10090:0:13"
msgid "Ha...ha... No, not yet..."
msgstr "Ха... ха... Нет, ещё рано..."

#. ja: ズズズズズ…
#. de: U-Uaaah ...
#. fr: Urrrghh...
msgctxt "NpcYell:10091:0:13"
msgid "Grrruuunnnh..."
msgstr "Гр-р-р-унх..."

#. ja: グオォォーン！
#. de: Kräääh!
#. fr: Crôaaarrr<nbsp>!
msgctxt "NpcYell:10092:0:13"
msgid "Raaawrrrh!"
msgstr "Р-р-р-а-а-у-у!"

#. ja: 気味の悪い奴だったな…
#. de: Was für ein abscheuliches Biest!
#. fr: Quelles sinistres créatures...
msgctxt "NpcYell:10093:0:13"
msgid "As if we don't have enough to contend with..."
msgstr "Вот уж и без этих мерзких тварей хлопот хватало..."

#. ja: 死せる魂よ<br>安らかなれ…
#. de: Hoffentlich bleibt der jetzt tot ... und ruht in Frieden.
#. fr: Puissent les morts reposer en paix.
msgctxt "NpcYell:10094:0:13"
msgid "May the fallen find peace."
msgstr "Пусть павшие обретут покой."

#. ja: ブラズ、ヴェリボル！<br>お疲れ様ッ！
#. de: Blaz, Velibor. Tapfer gekämpft!
#. fr: Blaz, Velibor, vous êtes les meilleurs<nbsp>!
msgctxt "NpcYell:10095:0:13"
msgid "Well, it made for a change of pace, if nothing else!"
msgstr "Ну что, хоть немного размялись, Блаз, Велибор!"

#. ja: では、はじめよう
#. de: Möge die wahre Prüfung beginnen!
#. fr: Bienvenue.
msgctxt "NpcYell:10096:0:13"
msgid "Let us begin."
msgstr "Начнём."

#. ja: この程度か…
#. de: Ist das alles, was du kannst?
#. fr: C'est tout...<nbsp>?
msgctxt "NpcYell:10097:0:13"
msgid "Is that all?"
msgstr "И это всё?"

#. ja: 叩き切るッ！
#. de: Ich hack dich in Stücke!
#. fr: Je vais te mettre en pièces<nbsp>!
msgctxt "NpcYell:10098:0:13"
msgid "I'll rend you to pieces!"
msgstr "Порублю тебя на куски!"

#. ja: 足元に気をつけな！
#. de: Nicht den Boden aus den Augen verlieren!
#. fr: Attention où tu mets les pieds<nbsp>!
msgctxt "NpcYell:10099:0:13"
msgid "Might want to watch your step!"
msgstr "Смотри под ноги!"

#. ja: 吹き飛べッ！
#. de: Guten Flug!
#. fr: Tu ne résisteras pas à ça<nbsp>!
msgctxt "NpcYell:10100:0:13"
msgid "Can you withstand this!?"
msgstr "Ну-ка, выдержишь такое?!"

#. ja: ボズヤのために！
#. de: Für Bozja!
#. fr: Pour Bozja<nbsp>!
msgctxt "NpcYell:10101:0:13"
msgid "For the future of Bozja!"
msgstr "За будущее Бозьи!"

#. ja: 故郷を奪還する！
#. de: Wir holen uns unsere Heimat zurück!
#. fr: Nous allons reconquérir notre patrie<nbsp>!
msgctxt "NpcYell:10102:0:13"
msgid "Today, we take back our homeland!"
msgstr "Сегодня мы вернём себе родину!"

#. ja: 自由を我が手に！
#. de: Freiheit für alle Bozianer!
#. fr: Pour la liberté<nbsp>!
msgctxt "NpcYell:10103:0:13"
msgid "For freedom!"
msgstr "За свободу!"

#. ja: 圧政者どもめ！
#. de: Tod den Unterdrückern!
#. fr: Sus à l'ennemi<nbsp>!
msgctxt "NpcYell:10104:0:13"
msgid "Death to the oppressors!"
msgstr "Смерть угнетателям!"

#. ja: 押せ、押せ！
#. de: Vorwärts, vorwääärts!
#. fr: En avant<nbsp>! Allez<nbsp>!
msgctxt "NpcYell:10105:0:13"
msgid "Keep going!"
msgstr "Вперёд! Не сбавлять ход!"

#. ja: グンヒルドの剣に続け！
#. de: Kein Vergeben, kein Vergessen!
#. fr: Suivez les lames de Gunnhildr<nbsp>!
msgctxt "NpcYell:10106:0:13"
msgid "Follow the Blade!"
msgstr "За Клинком!"

#. ja: これがボズヤの民の力だ！
#. de: Bozja wird niemals aufgeben!
#. fr: C'est ça, la force du peuple de Bozja<nbsp>!
msgctxt "NpcYell:10107:0:13"
msgid "You can't keep a good Bozjan down!"
msgstr "Нас, бозийцев, так просто не сломить!"

#. ja: この勝利が自由に通じる！
#. de: Für die Königin!
#. fr: Pour la victoire<nbsp>! Pour la liberté<nbsp>!
msgctxt "NpcYell:10108:0:13"
msgid "One step closer to freedom!"
msgstr "Ещё шаг — и свобода будет ближе!"

#. ja: 見たか！<br>我らの底力を！
#. de: Seht ihr das? Das ist die Stärke Bozjas!
#. fr: Vous avez vu ça<nbsp>! Admirez ma force<nbsp>!
msgctxt "NpcYell:10109:0:13"
msgid "We'll never surrender!"
msgstr "Мы никогда не сдадимся!"

#. ja: 帝国軍になど<br>負けるものか！
#. de: Wir zwingen das Kaiserreich in die Knie!
#. fr: Les Impériaux ne peuvent rien contre nous<nbsp>!
msgctxt "NpcYell:10110:0:13"
msgid "You imperials'll have to try harder than that!"
msgstr "Имперцам нас так просто не одолеть!"

#. ja: 逃げろ、逃げるんだ…！
#. de: Flieht! Rette sich, wer kann!
#. fr: Retraite<nbsp>! Il faut battre en retraite<nbsp>!
msgctxt "NpcYell:10111:0:13"
msgid "This isn't getting us anywhere. Retreat!"
msgstr "Толку от этого не будет. Отступаем!"

#. ja: 帝国の力…<br>侮れないな…
#. de: Gegen die Garlear haben wir keine Chance ...
#. fr: Ils sont plus forts qu'on ne l'imaginait...
msgctxt "NpcYell:10112:0:13"
msgid "We've been outmatched..."
msgstr "Нам не сравниться с ними..."

#. ja: 悔しいが…<br>ここは退くしか…！
#. de: Verdammt. Aber der Rückzug ist unausweichlich.
#. fr: C'est rageant mais... il faut se replier<nbsp>!
msgctxt "NpcYell:10113:0:13"
msgid "No choice left but to withdraw!"
msgstr "Как ни горько... придётся отступить!"

#. ja: ダ、ダメだ…<br>支えきれない…！
#. de: Es reicht nicht. Wir kommen nicht durch.
#. fr: A-argh<nbsp>! On ne tiendra plus longtemps comme ça...
msgctxt "NpcYell:10114:0:13"
msgid "They've gotten the better of us!"
msgstr "Они нас одолели!"

#. ja: ふ、不覚ッ…！
#. de: Ich ... bin am Ende ...
#. fr: M-malédiction<nbsp>!
msgctxt "NpcYell:10115:0:13"
msgid "Am I no better than a novice?"
msgstr "Неужели я хуже новичка?"

#. ja: 拙僧の太刀筋が<br>見切られたとでも…
#. de: Ich hätte ... mehr üben sollen ...
#. fr: Ma lame... n'aura pas suffi...
msgctxt "NpcYell:10116:0:13"
msgid "Even with this blade, I have been found wanting."
msgstr "Даже мой клинок оказался бесполезен..."

#. ja: ナメてたのは<br>俺の方ということか…
#. de: Das hatte ich mir ... anders vorgestellt ...
#. fr: J'ai sous-estimé notre adversaire...
msgctxt "NpcYell:10117:0:13"
msgid "Looks like I've gotten carried away."
msgstr "Похоже, это я тут зазнался..."

#. ja: 畜生ッ！<br>こんなところで…
#. de: Neiiiin! Nein! Nein ... \<röchel>
#. fr: Rhaaa<nbsp>! Je ne peux pas mourir ici<nbsp>!
msgctxt "NpcYell:10118:0:13"
msgid "No! I'll not die in a place like this!"
msgstr "Нет! Я не умру в таком месте!"

#. ja: 負けたっていうの…<br>認められないッ！
#. de: Das darf nicht wahr sein ...
#. fr: Je... Je ne m'avouerai pas vaincue<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10119:0:13"
msgid "I've still got some fight left in me...<br>Not much, though."
msgstr "Я ещё не сдалась...<br>Но сил почти не осталось."

#. ja: ブラズ、ヴェリボル…<br>悔しいよッ…
#. de: Blaz ... Velibor ... Wo seid ihr?
#. fr: Blaz, Velibor... Je suis désolée...
msgctxt "NpcYell:10120:0:13"
msgid "You'll have to fight the good fight without me..."
msgstr "Придётся вам продолжать борьбу без меня..."

#. ja: グハハハハ！来たな、レジスタンスども！
#. de: Muahaha! Da sind sie ja, die Schwächlinge!
#. fr: Bouahaha<nbsp>! Les voilà, ces mauviettes de rebelles<nbsp>!
msgctxt "NpcYell:10121:0:13"
msgid "Ha! Fat lot of good those fancy weapons did you!"
msgstr "Ха! И что вам дали ваши навороченные пушки?!"

#. ja: オレたち栄えある栄光の…えーと、なんだっけ…
#. de: Auf, meine Seek, für die Ehre der kaiserlichen ... Ehre ... äh ...
#. fr: Préparez-vous à affronter la gloireuse... la glaireuse... Euh mince, comment qu'on dit déjà<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10122:0:13"
msgid "For the glory of...uh...<br>How does it go, again?"
msgstr "За славу... э-э...<br>Как там дальше?"

#. ja: とにかく…逆らうヤツは皆殺しだァーッ！
#. de: Was soll's! Bringt sie alle um!
#. fr: Bon, on s'en fiche. Crevez, tous autant que vous êtes<nbsp>!
msgctxt "NpcYell:10123:0:13"
msgid "Anyway, I'll kill you to death!"
msgstr "Да плевать! Всех перебью!"

#. ja: ウギィィィィ！
#. de: Uhiii!
#. fr: Gyuiiiiiih<nbsp>!
msgctxt "NpcYell:10124:0:13"
msgid "Fresh meat!"
msgstr "Свежатинка!"

#. ja: 戦だ、戦だ、戦だーッ！
#. de: Töten, töten, töten!
#. fr: Taper, taper, taper<nbsp>!
msgctxt "NpcYell:10125:0:13"
msgid "I will grind your bones!"
msgstr "Я перемелю вас в порошок!"

#. ja: ブッ潰してやるぜェ！
#. de: Alle plattmachen!
#. fr: Prends ça, vermine<nbsp>!
msgctxt "NpcYell:10126:0:13"
msgid "Time to spill some Bozjan blood!"
msgstr "Пора пролить бозийскую кровь!"

#. ja: な、なんだァ～！？
#. de: Was denn?
#. fr: H-hé<nbsp>!
msgctxt "NpcYell:10127:0:13"
msgid "Stay still and let me kill you!"
msgstr "А ну стой, пока я тебя не прикончил!"

#. ja: ガルラがやられちまったゾ？
#. de: Garula ist gefallen?
#. fr: Ils ont eu le garula<nbsp>!
msgctxt "NpcYell:10128:0:13"
msgid "No! Not the garula!"
msgstr "Нет! Только не гарула!"

#. ja: ま、負けるもんかよォ！
#. de: Aber dann verlieren wir ja!
#. fr: C-c'est pas fini<nbsp>!
msgctxt "NpcYell:10129:0:13"
msgid "You're no match for the mighty Daguza!"
msgstr "Да не проиграю я!"

#. ja: グギギギギ…お、覚えてやがれェッ…！
#. de: Das merk ich mir!
#. fr: Gueurgh<nbsp>! Je reviendrai<nbsp>!
msgctxt "NpcYell:10130:0:13"
msgid "Ow! That hurts, you know!"
msgstr "Ай! Больно же!"

#. ja: ウギィィィィ！
#. de: Uhiii!
#. fr: Gyuiiiiiih<nbsp>!
msgctxt "NpcYell:10131:0:13"
msgid "Must flee!"
msgstr "Надо бежать!"

#. ja: 退け、退け、退けーッ！
#. de: Rennen, rennen!
#. fr: Fuir, fuir, fuir<nbsp>!
msgctxt "NpcYell:10132:0:13"
msgid "Run away! Run away!"
msgstr "Бегите! Спасайтесь!"

#. ja: ヒィ、痛ェ…痛ェヨォ…
#. de: Aua ... Aua!
#. fr: Hiiih... J'ai mal<nbsp>! J'ai mal partout<nbsp>!
msgctxt "NpcYell:10133:0:13"
msgid "Ungh... My limbs..."
msgstr "Ай... Ноги... руки..."

#. ja: グハハハ！オレたちの勝ちだッ！
#. de: Muahaha! Gewonnen!
#. fr: Bouahaha<nbsp>! Et une victoire, une<nbsp>!
msgctxt "NpcYell:10134:0:13"
msgid "Bwahaha! Is that the best you can muster?"
msgstr "Бвахаха! И это всё, на что вы способны?"

#. ja: ウギィィィィ！！！
#. de: Uhiiiiiii!!!
#. fr: Gyuiiiiiih<nbsp>!
msgctxt "NpcYell:10135:0:13"
msgid "Too weak!"
msgstr "Слабаки!"

#. ja: 勝ち、勝ち、勝ちーッ！
#. de: Siegen, siegen, siegen!
#. fr: Gagné, gagné, gagné<nbsp>!
msgctxt "NpcYell:10136:0:13"
msgid "Finished so soon?"
msgstr "Так быстро закончились?"

#. ja: おい、金目のモン置いてけよォ！？
#. de: Lasst euer Gold liegen und rennt!
#. fr: Hé, pas touche au butin<nbsp>!
msgctxt "NpcYell:10137:0:13"
msgid "They got anything worth pinching?"
msgstr "У них есть что-нибудь ценное?"

#. ja: ボズヤの地に集いし<br>勇士たちよ～ッ！
#. de: Versammelt euch, Helden von Bozja!
#. fr: Vous qui vous battez pour notre bien-aimée Bozja<nbsp>!
msgctxt "NpcYell:10138:0:13"
msgid "For Bozja!"
msgstr "За Бозью!"

#. ja: 我らが故郷を踏み荒らす<br>獣どもを討ち払うのだ～ッ！
#. de: Heute ist der Tag, an dem wir die Beschmutzer unserer Heimat davonjagen!
#. fr: J'en appelle à vous pour châtier des créatures féroces et san<shy>gui<shy>nai<shy>res<nbsp>!
msgctxt "NpcYell:10139:0:13"
msgid "Battlefield or no, this is our land and we must defend it!"
msgstr "Пусть эти твари убираются с нашей земли! Неважно, где идёт бой, — мы должны её защитить!"

#. ja: 俺サマに続け～ッ！
#. de: Auf! Mir nach!
#. fr: Suivez-moi<nbsp>!
msgctxt "NpcYell:10140:0:13"
msgid "With me!"
msgstr "За мной!"

#. ja: ハハハッ！<br>見たか、俺サマの剣を～ッ！
#. de: Haha! Habt ihr mein Schwert tanzen sehen?
#. fr: Ha ha ha<nbsp>!!! J'espère que vous avez apprécié ma dé<shy>mon<shy>stra<shy>tion d'escrime<nbsp>!
#. macro: <split " " 2><string $gs1></split> — the last name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:10141:0:13"
msgid "Excellent work, Blade <split \" \" 2><string $gs1></split>!"
msgstr "Вот это работа, Клинок <split \" \" 2><string $gs1></split>!"

#. ja: 俺サマの剣が効かない…！？<br>て、撤退だ～ッ！
#. de: Mein Schwert hat versagt ... Rückzug!
#. fr: Quoi<nbsp>!? Ma lame ne leur fait rien... Sonnez la retraite<nbsp>!
msgctxt "NpcYell:10142:0:13"
msgid "They're more resilient than they look. Fall back!"
msgstr "Они крепче, чем кажутся. Отступаем!"

#. ja: ちっきしょ～！<br>覚えてやがれッ～！
#. de: Nein ... Bitte, vergesst mich nicht ...
#. fr: Grrr... Je n'oublierai pas cet affront<nbsp>!
msgctxt "NpcYell:10143:0:13"
msgid "It seems I've lost the upper hand..."
msgstr "Похоже, удача от меня отвернулась..."

#. ja: 怨念ヨ…<br>再ビ、我ガ手トナレ…！
#. de: Hass, gib mir deine Kraft!
#. fr: Haine... Rancœur... Elles sont ma force<nbsp>!
msgctxt "NpcYell:10144:0:13"
msgid "All my hate...I bring to bear!"
msgstr "Вся моя ненависть... Вся моя сила!"

#. ja: ◎￥▲×□％♪
#. de: ◎▲□♪
#. fr: ◎￥▲×□％♪
msgctxt "NpcYell:10145:0:13"
msgid "◎￥▲×□％♪"
msgstr "◎￥▲×□％♪"

#. ja: アラアラ、所詮は烏合の衆ね……！<br>この程度で反抗しようだなんて、興ざめですわ……。
#. de: Ach herrje, da kommt der Pöbel. Und wie dreckig sie aussehen!
#. fr: Ah là là... En fin de compte, vous n'êtes qu'un ramassis de minables. Et ça ose se prétendre soldats<nbsp>? Quelle blague...
msgctxt "NpcYell:10146:0:13"
msgid "My, my. What a pathetic display!"
msgstr "Боже мой, ну и жалкое зрелище!"

#. ja: いいわ、この雑兵たちは、アナタたちにくれてア・ゲ・ル！<br>好きになさいッ！
#. de: Macht, dass sie verschwinden. Sie beleidigen meine Augen!
#. fr: Mes petits, je vous laisse vous charger d'eux. Amusez-vous bien<nbsp>!
msgctxt "NpcYell:10147:0:13"
msgid "I'll leave these sorry wretches to you. Have fun!"
msgstr "С этими жалкими людишками разбирайтесь сами. Повеселитесь!"

#. ja: さて、帰って<br>新しいペットちゃんを…♪
#. de: Ich geh derweil nach Hause und kümmere mich um meinen neuen Liebling ...
#. fr: Quant à moi, je vais rentrer bichonner mon nouvel ami à plumes.♪
msgctxt "NpcYell:10148:0:13"
msgid "I, in the meantime, shall be spending time with my newest pet."
msgstr "А я пока пойду проведаю своего нового питомца."

#. ja: クッ、なんだ…<br>この化け物は…！
#. de: W-Was ist das für ein Ungetüm!
#. fr: Eurgh... Qu'est-ce que c'est que ces monstres<nbsp>!?
msgctxt "NpcYell:10149:0:13"
msgid "I...I've never seen anything like this before!"
msgstr "Я... такого чудовища ещё не видел!"

#. ja: とにかくコイツらを倒さねばッ！
#. de: Egal, was es ist ... Das knöpfen wir uns vor!
#. fr: Bah... Tant qu'on peut les occire<nbsp>!
msgctxt "NpcYell:10150:0:13"
msgid "Nevertheless, they'll fall like all the rest!"
msgstr "Неважно, кто они! Мы и с ними справимся!"

#. ja: 撃退できた…！？<br>負傷者は私のところに…！
#. de: Gewonnen! Schnell, die Verletzten zu mir!
#. fr: C'est fini... Il y a des blessés<nbsp>? Venez, je vais vous soigner<nbsp>!
msgctxt "NpcYell:10151:0:13"
msgid "It looks like we've cowed them for now."
msgstr "Похоже, мы их пока отогнали."

#. ja: 負傷者は逃せた…！<br>これ以上の戦いは無用だ…！
#. de: Es hat keinen Zweck. Bringt euch in Sicherheit und helft den Verletzten!
#. fr: Les blessés sont à l'abri. Arrêtons les frais et retirons-nous<nbsp>!
msgctxt "NpcYell:10152:0:13"
msgid "The injured have made their escape, and I suggest we do likewise."
msgstr "Раненые спаслись. Предлагаю и нам отступить."

#. ja: ここが正念場ぞ！
#. de: Das ist der Moment der Entscheidung!
#. fr: La bataille décisive commence<nbsp>!
msgctxt "NpcYell:10153:0:13"
msgid "How I have waited for this moment!"
msgstr "Вот он, решающий миг!"

#. ja: 見よ！<br>門は開かれたッ！
#. de: Seht! Das Tor ist geöffnet!
#. fr: La porte est grande ouverte<nbsp>! À nous le castrum<nbsp>!
msgctxt "NpcYell:10154:0:13"
msgid "The castrum is all but ours!"
msgstr "Взгляните! Ворота открыты!"

#. ja: 先陣こそ武人の誉れ！
#. de: Den Letzten beißen die garleischen Hunde!
#. fr: Un véritable guerrier ne trouve la gloire qu'en première ligne<nbsp>!
msgctxt "NpcYell:10155:0:13"
msgid "We shall lead the way to victory!"
msgstr "Честь воина — идти в первых рядах!"

#. ja: ぬおおおッ！
#. de: Uaaaah!
#. fr: Yaaaaaah<nbsp>!
msgctxt "NpcYell:10156:0:13"
msgid "Attack!"
msgstr "А-а-а! В атаку!"

#. ja: がんばりましょう～！
#. de: Zusammen schaffen wir es!
#. fr: Allons-y<nbsp>!
msgctxt "NpcYell:10157:0:13"
msgid "The end is in sight!"
msgstr "Финиш уже близко!"

#. ja: やりました～！
#. de: Geschafft!
#. fr: On a réussi<nbsp>!
msgctxt "NpcYell:10158:0:13"
msgid "I knew we could do it!"
msgstr "У нас получилось!"

#. ja: いきますよ～！
#. de: Ich komme! ♪
#. fr: Hé hé<nbsp>! C'est parti<nbsp>!
msgctxt "NpcYell:10159:0:13"
msgid "Let's press on!"
msgstr "Вперёд!"

#. ja: 抵抗しないでくださ～い！
#. de: Bitte keine Gegenwehr, ja?
#. fr: Soyez gentils et rendez-vous sans faire d'histoires<nbsp>!
msgctxt "NpcYell:10160:0:13"
msgid "Surrender now and no one gets hurt!"
msgstr "Сдавайтесь, и никто не пострадает!"

#. ja: 俺サマの勇姿！<br>見ておけよ～ッ！
#. de: Jetzt erlebt ihr Stanik den Schlächter bei der Arbeit!
#. fr: La gloire n'attend pas<nbsp>!
msgctxt "NpcYell:10161:0:13"
msgid "Follow my lead!"
msgstr "Смотрите и учитесь!"

#. ja: ハハハッ！<br>ざまぁみやがれ～ッ！
#. de: Hahaha! Rollen sollen sie, eure Köpfe!
#. fr: Ha ha haaa<nbsp>! Voilà où vous mène votre veulerie<nbsp>!
msgctxt "NpcYell:10162:0:13"
msgid "See what your villainy has wrought!"
msgstr "Вот к чему привела ваша злодейская натура!"

#. ja: 俺サマに続け～ッ！
#. de: Mir nach!
#. fr: Ralliez-vous à moi<nbsp>! Sus à l'ennemi<nbsp>!
msgctxt "NpcYell:10163:0:13"
msgid "Behind me!"
msgstr "За мной!"

#. ja: おらおら、どきやがれ～ッ！
#. de: Aus dem Weg, ihr Hunde!
#. fr: Arrière, misérables<nbsp>! Ou vous allez tâter de mon épée<nbsp>!
msgctxt "NpcYell:10164:0:13"
msgid "Stand aside! I have no interest in the likes of you!"
msgstr "Прочь с дороги! Вы мне неинтересны!"

#. ja: 吼えよ、我が剣ッ！
#. de: Schmeck das Blut unserer Feinde, Klinge!
#. fr: Ma lame va rugir, aujourd'hui.
msgctxt "NpcYell:10165:0:13"
msgid "Sing, my blade!"
msgstr "Пой, мой клинок!"

#. ja: まだ戦いは序盤…<br>気を緩めるなッ！
#. de: Durchhalten, es ist noch nicht vorbei.
#. fr: Ne vous relâchez pas. Cette bataille ne fait que débuter.
msgctxt "NpcYell:10166:0:13"
msgid "Our work is far from over."
msgstr "Бой только начинается. Не расслабляться!"

#. ja: 敵将はいずこ…！？
#. de: Wo ist ihr Anführer?
#. fr: Bon sang...<nbsp>! Où se cachent leurs commandants<nbsp>!?
msgctxt "NpcYell:10167:0:13"
msgid "Their leaders yet elude us."
msgstr "Где же их командиры?.."

#. ja: 見切ったッ！
#. de: Da ist er!
#. fr: Je te tiens<nbsp>!
msgctxt "NpcYell:10168:0:13"
msgid "Your movements betray you."
msgstr "Твои движения тебя выдали!"

#. ja: 粉々に叩き潰すッ！
#. de: Aus dem Blut unserer Feinde wird Bozja auferstehen!
#. fr: On va les réduire en poussière<nbsp>!
msgctxt "NpcYell:10169:0:13"
msgid "We'll smash right through them!"
msgstr "Мы сметём их одним ударом!"

#. ja: 見たか！<br>グンヒルドの剣の力を！
#. de: Wir sind die Königinnenwache!
#. fr: Vous ne pouvez rien contre les lames de Gunnhildr<nbsp>!
msgctxt "NpcYell:10170:0:13"
msgid "I've had training dummies that put up more of a fight!"
msgstr "Даже чучела для тренировок сопротивлялись сильнее!"

#. ja: このまま突っ走るぞッ！
#. de: Weiter! Weiter vor!
#. fr: On s'arrête pas<nbsp>!
msgctxt "NpcYell:10171:0:13"
msgid "Haha! Who's next?"
msgstr "Ха-ха! Кто следующий?"

#. ja: 壁のシミになりやがれッ！
#. de: Nichts wird an euch erinnern, nichts!
#. fr: Et reste à terre<nbsp>!
msgctxt "NpcYell:10172:0:13"
msgid "Just another notch on my hilt!"
msgstr "Будешь пятном на стене!"

#. ja: ブラズ、ヴェリボル！<br>やってやろう！
#. de: Blaz, Velibor. Wir packen das!
#. fr: Venez, Blaz, Velibor<nbsp>! On va se les faire<nbsp>!
msgctxt "NpcYell:10173:0:13"
msgid "Now's our chance at glory!"
msgstr "Блаз, Велибор! Наш час настал!"

#. ja: ヒューッ！<br>いい調子ッ～！
#. de: Gut so! Weiter!
#. fr: Hé hé<nbsp>! Du gâteau<nbsp>!
msgctxt "NpcYell:10174:0:13"
msgid "This is easier than I thought!"
msgstr "Ха! Легче лёгкого!"

#. ja: ブラズ、ヴェリボル！<br>ガンガンいくよッ！
#. de: Blaz, Velibor. Wir sind fast am Ziel!
#. fr: On continue sur notre lancée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10175:0:13"
msgid "Blaz, Velibor!<br>We've got them on the run!"
msgstr "Блаз, Велибор!<br>Они уже бегут!"

#. ja: オンドリャー！
#. de: Uuuund ... ha!
#. fr: Prends ça, pour voir<nbsp>!
msgctxt "NpcYell:10176:0:13"
msgid "Take...this!"
msgstr "Получай!"

#. ja: うおおッ！
#. de: Bei den Göttern!
#. fr: Mouôôôh<nbsp>!
msgctxt "NpcYell:10177:0:13"
msgid "Hah!"
msgstr "Ха!"

#. ja: てやッ！
#. de: Ach du ...
#. fr: Tssaah<nbsp>!
msgctxt "NpcYell:10178:0:13"
msgid "Yah!"
msgstr "Я-а!"

#. ja: レジスタンスどもめ！
#. de: Gebt auf, widerspenstige Wilde!
#. fr: Maudits rebelles<nbsp>!
msgctxt "NpcYell:10179:0:13"
msgid "Damn you, rebels!"
msgstr "Проклятые повстанцы!"

#. ja: 抜かせるものか！
#. de: Hier kommt keiner durch!
#. fr: Vous ne passerez pas<nbsp>!
msgctxt "NpcYell:10180:0:13"
msgid "That's far enough!"
msgstr "Дальше не пройдёте!"

#. ja: いけッ！
#. de: Los!
#. fr: En avant<nbsp>!
msgctxt "NpcYell:10181:0:13"
msgid "Press the advantage!"
msgstr "Дожмите их!"

#. ja: そこだッ！
#. de: Wir schaffen das!
#. fr: Chiens d'impériaux<nbsp>!
msgctxt "NpcYell:10182:0:13"
msgid "Imperial dog!"
msgstr "Имперская шавка!"

#. ja: ここで食い止めるッ！
#. de: Keinen Schritt weiter!
#. fr: On va les retenir ici<nbsp>!
msgctxt "NpcYell:10183:0:13"
msgid "Give them no quarter!"
msgstr "Здесь мы их и остановим!"

#. ja: 負けるものか！
#. de: Ihr habt keine Chance!
#. fr: N'espérez pas vous en sortir vivants<nbsp>!
msgctxt "NpcYell:10184:0:13"
msgid "You think you can beat us on our own turf!?"
msgstr "Думаете, одолеете нас на нашей земле?!"

#. ja: 悪名高き魔狼よ！<br>疾走れ！
#. de: Gefürchteter Wolf der Finsternis, komm und schlag fette Beute!
#. fr: Pour vous, une tempête de crocs et de griffes<nbsp>!
msgctxt "NpcYell:10185:0:13"
msgid "By fang and claw shall they be rent!"
msgstr "Когти и клыки разорвут вас на части!"

#. ja: 濁りし眼の魔牛よ！<br>来たれ！
#. de: Lass deine donnernden Hufe ertönen, gehörntes Biest der Dunkelheit!
#. fr: Croisez le regard torve de mes bêtes, et mourrez<nbsp>!
msgctxt "NpcYell:10186:0:13"
msgid "May my foe be trampled underfoot!"
msgstr "Пусть враги падут под копытами!"

#. ja: クッ…<br>傲慢が綻びを生んだと…
#. de: Uff ... Da habe ich nicht aufgepasst.
#. fr: Aurais-je péché par arrogance<nbsp>?
msgctxt "NpcYell:10187:0:13"
msgid "My hubris has become my undoing..."
msgstr "Моя гордыня меня погубила..."

#. ja: いけいけッ！
#. de: Schnell, helft dem Hexer!
#. fr: Abattez-les tous<nbsp>!
msgctxt "NpcYell:10188:0:13"
msgid "Cut them down!"
msgstr "Рубите их!"

#. ja: 捻り潰せッ！
#. de: Schlagt die Eindringlinge zurück!
#. fr: Faites-en de la charpie<nbsp>!
msgctxt "NpcYell:10189:0:13"
msgid "I want that one's head on a pike!"
msgstr "Хочу видеть его голову на пике!"

#. ja: 守り抜くぞッ！
#. de: Die werden was erleben!
#. fr: Ils doivent pas passer<nbsp>!
msgctxt "NpcYell:10190:0:13"
msgid "Hold the line!"
msgstr "Держать строй!"

#. ja: やだ、あの鉄球……<br>もしかして、帝国軍の新兵器なんですか～？
#. de: Was ist das für ein Eisending? Eine neue Waffe der Garlear?
#. fr: Ce truc ne me dit rien qui vaille...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10191:0:13"
msgid "I don't like the look of that.<br>I get the feeling it's not the usual imperial magitek..."
msgstr "Мне это не нравится.<br>Чую, это не обычная имперская магитехника..."

#. ja: “ピピピ……戦術チップ　読ミ込ミ……開始！<br>読ミ込ミ中……読ミ込ミ中……”
#. de: Biep, biep ...<br>Kampfmodul wird eingelesen ...<br>Bitte warten ...
#. fr: PI PI PI... “LECTURE DE LA PUCE DE COMBAT...” *FRZZZZZT T T T*...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10192:0:13"
msgid "MUST SWEEP...MUST CLEAN...<br>...BZZZT...<br>MUST...MUST...KILL..."
msgstr "НАДО МЕСТИ... НАДО УБИРАТЬ...<br>...БЗЗЗТ...<br>НАДО... НАДО... УБИВАТЬ..."

#. ja: みなさん！<br>新兵器の破壊に、力を貸してください～！
#. de: Alle Mann! Konzentriert euch auf die Eisenkugel!
#. fr: Une arme impériale<nbsp>! Vite les amis, nous devons la détruire<nbsp>!
msgctxt "NpcYell:10193:0:13"
msgid "Keep your wits about you, everyone!"
msgstr "Будьте начеку, все!"

#. ja: 覚悟しろ！<br>レジスタンスのクズども！
#. de: Macht euch auf was gefasst, ihr Widerspenstler!
#. fr: Faites vos prières, pourritures rebelles<nbsp>!
msgctxt "NpcYell:10194:0:13"
msgid "Prepare yourselves!"
msgstr "Приготовьтесь!"

#. ja: 帝国軍だー！<br>応戦しろッー！
#. de: Garlear! Greift sie an!
#. fr: Des Impériaux<nbsp>! Ils ne doivent pas passer<nbsp>!
msgctxt "NpcYell:10195:0:13"
msgid "Imperials! How did they get so close!?"
msgstr "Имперцы! Как они подобрались так близко?!"

#. ja: 我らの勝利だッ！
#. de: Der Sieg gehört uns!
#. fr: Victoire<nbsp>!
msgctxt "NpcYell:10196:0:13"
msgid "Let that be a lesson to you!"
msgstr "Пусть это послужит вам уроком!"

#. ja: うおおぉぉ！
#. de: Hurra!
#. fr: Hourra<nbsp>!
msgctxt "NpcYell:10197:0:13"
msgid "The day is ours!"
msgstr "Сегодня победа за нами!"

#. ja: 貴様らが、帝国軍の術士大隊とやらか……<br>我が魔力と、ひと勝負願うとしようッ！
#. de: Glaubt ihr wirklich, ihr könnt es mit dem Spezialbataillon aufnehmen?
#. fr: Alors c'est vous, la fameuse cohorte des incantateurs. On va voir ce que vaut votre magie comparée à la mienne<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10198:0:13"
msgid "So they would weave their magicks in service of the Empire?<br>Conscripts or no, they must be dealt with."
msgstr "Значит, это вы — магический батальон Империи?<br>Призывные вы или нет, но с вами придётся разобраться."

#. ja: おおおおッ！
#. de: Auf sie mit Gebrüll!
#. fr: Ouais<nbsp>!
msgctxt "NpcYell:10199:0:13"
msgid "Forward!"
msgstr "Вперёд!"

#. ja: これは自由を巡る戦い……<br>それを遊びのように語るだなんて……！
#. de: Wir sind hier nicht zum Spaß. Es geht um unsere Freiheit.
#. fr: C'est la liberrrté de chacun qui est en jeu, et vous osez prendre ça à la rigolade<nbsp>!?
msgctxt "NpcYell:10200:0:13"
msgid "If we're to earn our freedom, we can't let the Bozjans get the better of us!"
msgstr "Если хотим обрести свободу, нельзя дать бозийцам взять над нами верх!"

#. ja: 私たちの任務は、あくまで威力偵察……<br>皆、命は粗末にしないように！
#. de: Unsere Mission ist es, die feindliche Kampfkraft auszuspionieren. Riskiert nicht zu viel.
#. fr: Rappelez-vous<nbsp>: nous sommes ici pour jauger nos adversairrres. N'allez pas vous jeter bêtement sur leurs lames<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10201:0:13"
msgid "Remember, we're only here for reconnaissance.<br>If things take a turn for the worse, you are to retreat immediately."
msgstr "Помните, наша задача — разведка.<br>Если дело примет дурной оборот, немедленно отступайте."

#. ja: 了解であります！<br>ユンブ様ッ！
#. de: Alles erledigt, Dyunbu pyr Potitus!
#. fr: Bien compris<nbsp>!
msgctxt "NpcYell:10202:0:13"
msgid "Understood, Dyunbu!"
msgstr "Понял, Дюнбу!"

#. ja: 負傷した者は、下がりなさい……！<br>無理をしてはなりません！
#. de: Bringt die Verletzten in Sicherheit. Wir lassen keinen zurück.
#. fr: Les blessés, rrrepliez-vous<nbsp>! Vous en avez assez fait comme ça<nbsp>!
msgctxt "NpcYell:10203:0:13"
msgid "Those still bearing injuries must fall back."
msgstr "Раненые, отступайте."

#. ja: まだまだやれます！
#. de: Ich kann noch!
#. fr: Je peux encore me battre<nbsp>!
msgctxt "NpcYell:10204:0:13"
msgid "But I can still fight!"
msgstr "Но я ещё могу сражаться!"

#. ja: ユンブ様を置いて<br>退けませんよ！
#. de: Wir lassen Dyunbu pyr Potitus nicht im Stich!
#. fr: On ne va pas laisser Dyunbu lutter toute seule<nbsp>!
msgctxt "NpcYell:10205:0:13"
msgid "We won't abandon you, Dyunbu!"
msgstr "Мы не бросим вас, Дюнбу!"

#. ja: ユンブ様…！<br>退いてください！
#. de: Dyunbu pyr Potitus! Zieht Euch zurück!
#. fr: Dyunbu, vous n'êtes plus en état de vous battre<nbsp>!
msgctxt "NpcYell:10206:0:13"
msgid "Please, you must retreat!"
msgstr "Прошу, отступайте!"

#. ja: ここはオレたちが！
#. de: Wir über<shy>nehmen jetzt.
#. fr: Reculez, on s'occupe d'eux<nbsp>!
msgctxt "NpcYell:10207:0:13"
msgid "Leave this lot to us!"
msgstr "Оставьте их нам!"

#. ja: 皆も、どうか…<br>退却を…！
#. de: Rückzug, alle!
#. fr: D-d'accord, mais... vous devriez en fairrre de même<nbsp>!
msgctxt "NpcYell:10208:0:13"
msgid "You're in no fit state to continue. Fall back, I say!"
msgstr "Вы не в том состоянии, чтобы продолжать. Отступайте, говорю вам!"

#. ja: クッ……それほどの力がありながら……なぜ……<br>ガブラス様の下で、自由を得られるというのに……！
#. de: Narren. Warum kämpfen sie nicht für uns? Legatus Gabranth würde sie fürstlich belohnen.
#. fr: Grr... Avec une telle force, vous pourriez convaincre le seigneur Gabranth de vous accorrrder la liberté... Alors pourquoi<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10209:0:13"
msgid "How can we hope to build Gabranth's new nation...<br>if this is all we're capable of?"
msgstr "Как нам построить новую державу Габранта,<br>если мы ни на что не годны?"

#. ja: ユンブ様…<br>撤退を…！
#. de: Dyunbu pyr Potitus! Bringt Euch in Sicherheit!
#. fr: Nous devons battre en retraite<nbsp>!
msgctxt "NpcYell:10210:0:13"
msgid "We can't withstand this attack any longer!"
msgstr "Мы больше не выдержим этой атаки!"

#. ja: 見よッ！<br>これがグンヒルドの剣の力ぞッ！
#. de: Niemand bezwingt die legendäre Königinnenwache!
#. fr: Voilà ce qui arrive quand on se frotte aux lames de Gunnhildr<nbsp>!
msgctxt "NpcYell:10211:0:13"
msgid "You never stood a chance against Gunnhildr's Blades!"
msgstr "Вы не могли тягаться с Клинками Гуннхильд!"

#. ja: うおおおッ！
#. de: Ein Hoch auf Bozja!
#. fr: Hourra<nbsp>!!!
msgctxt "NpcYell:10212:0:13"
msgid "Haha! And don't come back!"
msgstr "Ха! И не возвращайтесь!"

#. ja: なんと……我が魔力が通用せぬと……！？<br>ええい、一旦、出直すぞッ……！
#. de: Was ist das? Wirkt meine Magie nicht mehr? Ich werde mich für einen Moment zurückziehen.
#. fr: Comment<nbsp>? Ma magie est surclassée<nbsp>!?<nbsp>... Tant pis, il y aura d'autres batailles. Retirons-nous, mes braves<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10213:0:13"
msgid "How can they counteract my magicks so easily?<br>I must retreat, find another way!"
msgstr "Как они так легко отражают мои чары?<br>Нужно отступить и найти другой способ!"

#. ja: ゼヴェン殿が<br>敗れたのか…？
#. de: General Xeven unterliegt? Ein schwarzer Tag ...
#. fr: Xeven a été vaincu<nbsp>?
msgctxt "NpcYell:10214:0:13"
msgid "But Xeven is invincible!"
msgstr "Но Зевен непобедим!"

#. ja: なんてことだ…！
#. de: Was für ein schreckliches Ende!
#. fr: Je n'arrive pas à y croire...
msgctxt "NpcYell:10215:0:13"
msgid "It's no good!"
msgstr "Ничего не выходит!"

#. ja: 抵抗しなければ、命までは奪いません！<br>ガブラス様の下で生きることを考えなさい……！
#. de: Warum werft ihr eure Leben weg? Gewöhnt euch lieber an den Gedanken, als Untertanen von Legatus Gabranth zu dienen.
#. fr: Je vous en prrrie, implorez la clémence du seigneur Gabranth tant qu'il est encore temps<nbsp>! Rendez-vous et vous aurez la vie sauve<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10216:0:13"
msgid "Why will you Bozjans not listen to reason?<br>Place your faith in Gabranth, as we have!"
msgstr "Почему вы, бозийцы, не хотите прислушаться к доводам разума?<br>Поверьте Габранту — как поверили мы!"

#. ja: レジスタンスがッ！
#. de: Widerliche Widerständler!
#. fr: À bas les rebelles<nbsp>!
msgctxt "NpcYell:10217:0:13"
msgid "Death to the Resistance!"
msgstr "Смерть Сопротивлению!"

#. ja: 忌々しい連中め！
#. de: Jämmerliche Jammerlappen!
#. fr: Bande d'ingrats<nbsp>!
msgctxt "NpcYell:10218:0:13"
msgid "I'm gonna make you bleed!"
msgstr "Я заставлю вас истекать кровью!"

#. ja: 降伏しろッ！
#. de: Keine Gnade mit den Wilden!
#. fr: Rendez-vous, sales chiens<nbsp>!
msgctxt "NpcYell:10219:0:13"
msgid "Surrender or die!"
msgstr "Сдавайтесь или умрите!"

#. ja: 無駄な抵抗を…！
#. de: Begreift doch, Widerstand ist zwecklos.
#. fr: Toute résistance est futile<nbsp>!
msgctxt "NpcYell:10220:0:13"
msgid "Resistance is futile! Haha, get it? Because they're the... Never mind."
msgstr "Сопротивление бесполезно! Ха, поняли? Потому что они... Ладно, неважно."

#. ja: 愚か者どもが！
#. de: Sterbt, Schwächlinge!
#. fr: Bande d'imbéciles<nbsp>!
msgctxt "NpcYell:10221:0:13"
msgid "Know the depths of your folly!"
msgstr "Познайте всю глубину своего безумия!"

#. ja: 第IV軍団に栄光あれ！
#. de: Ehre der IV. Legion!
#. fr: Pour la gloire de la 4e légion<nbsp>!
msgctxt "NpcYell:10222:0:13"
msgid "For the IVth Legion!"
msgstr "За IV легион!"

#. ja: 見たか！<br>レジスタンスども！
#. de: Habt ihr das gesehen, ihr Wilden?
#. fr: Prenez ça, sales rebelles<nbsp>!
msgctxt "NpcYell:10223:0:13"
msgid "You'll give up for good if you've got any sense!"
msgstr "Если у вас есть хоть капля здравого смысла, вы больше не сунетесь!"

#. ja: 勝鬨をあげよ！
#. de: Ehre dem Kaiserreich!
#. fr: Pour la gloire de Garlemald<nbsp>!
msgctxt "NpcYell:10224:0:13"
msgid "For great justice."
msgstr "За справедливость!"

#. ja: これが第IV軍団の力だ！
#. de: Mit der IV. nimmt es keiner auf!
#. fr: Voilà<nbsp>! C'est ça, la puissance de la 4e légion<nbsp>!
msgctxt "NpcYell:10225:0:13"
msgid "When you arrive in the seven hells, tell 'em the IVth Legion sent you!"
msgstr "Когда попадёте в семь преисподних, скажите, что вас отправил IV легион!"

#. ja: 我ら勝利せり！<br>司令部に通信せよ！
#. de: Informiert das Hauptquartier: Der Sieg ist unser.
#. fr: La victoire est à nous<nbsp>! Prévenez le commandant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10226:0:13"
msgid "Another fine victory!<br>Let's head back and celebrate."
msgstr "Ещё одна славная победа!<br>Вернёмся и отпразднуем."

#. ja: グッ…おのれェ…！
#. de: Diese verdammten ...
#. fr: Urgh... Sales traîtres...
msgctxt "NpcYell:10227:0:13"
msgid "Why won't they just die!?"
msgstr "Почему вы просто не сдохнете?!"

#. ja: て、撤退だ…！
#. de: R-Rückzug! Rennt um euer Leben!
#. fr: R-repliez-vous<nbsp>!
msgctxt "NpcYell:10228:0:13"
msgid "Fall back!"
msgstr "Отступаем!"

#. ja: 敗北などと…！
#. de: Wir haben verloren. Nichts wie weg hier!
#. fr: Comment l'Empire peut-il perdre...
msgctxt "NpcYell:10229:0:13"
msgid "How could we lose to this filth?"
msgstr "Как мы могли проиграть этому сброду?"

#. ja: 我らが敗北だと！？
#. de: Verloren? Wir? Wie ist das möglich?
#. fr: Nous, perdre<nbsp>!? C'est impossible<nbsp>!
msgctxt "NpcYell:10230:0:13"
msgid "Better to run than to die!"
msgstr "Лучше бежать, чем погибнуть!"

#. ja: 攻撃目標を確認…
#. de: Ziel erfasst.
#. fr: Cible confirmée.
msgctxt "NpcYell:10231:0:13"
msgid "Target confirmed."
msgstr "Цель подтверждена."

#. ja: 残弾確認…<br>継戦可能でス…
#. de: Waffenstatus normal. Kampffähigkeit bestätigt.
#. fr: Munitions suffisantes. Reprise du combat.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10232:0:13"
msgid "Sufficient armaments remaining.<br>Continuing with attack."
msgstr "Боеприпасов достаточно.<br>Продолжаю атаку."

#. ja: 青燐機関の燃焼率…<br>許容の範囲内でス…
#. de: Effizienz des Erdseim-Antriebs im grünen Bereich.
#. fr: Consommation de céruleum dans les limites acceptables...
msgctxt "NpcYell:10233:0:13"
msgid "Ceruleum consumption within acceptable limits."
msgstr "Расход церулея в допустимых пределах."

#. ja: 目標を中央に入れて<br>スイッチ…
#. de: Ziel im Visier ... Zündung ...
#. fr: Cible alignée... Feu<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10234:0:13"
msgid "Target within line of sight.<br>Opening fire."
msgstr "Цель в поле зрения.<br>Открываю огонь."

#. ja: 炎霊蛇…来い！
#. de: Schlund des Phoinix, erscheine!
#. fr: Viens à moi, serpent en flammes<nbsp>!
msgctxt "NpcYell:10235:0:13"
msgid "Arise, and devour!"
msgstr "Восстань и пожри!"

#. ja: いでよ、炎霊鳥！
#. de: Komm, Frucht des Phoinix!
#. fr: Montre-toi, oiselet en flammes<nbsp>!
msgctxt "NpcYell:10236:0:13"
msgid "Cast thy shadow!"
msgstr "Узри мою тень!"

#. ja: 喰らえ！
#. de: Nimm das!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:10237:0:13"
msgid "Hah!"
msgstr "Ха!"

#. ja: 拙僧の必殺剣を喰らえッ！
#. de: Jetzt bekommt ihr meinen Stahl zu spüren!
#. fr: Tu vas goûter de ma lame<nbsp>!
msgctxt "NpcYell:10238:0:13"
msgid "Before my blade, you are nothing."
msgstr "Перед моим клинком вы ничто."

#. ja: 見えたッ！<br>断ち切るッ！
#. de: Seht ihr das? Meine Klinge schneidet euch wie Butter!
#. fr: Rien ne peut résister à son tranchant<nbsp>!
msgctxt "NpcYell:10239:0:13"
msgid "A futile endeavor."
msgstr "Напрасная попытка."

#. ja: グンヒルドの剣をナメるなッ！
#. de: Unterschätzt niemals die Königinnenwache!
#. fr: Ne sous-estimez pas les lames de Gunnhildr<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:10240:0:13"
msgid "You've never seen a blade like <i>this</i>!"
msgstr "Вы ещё не видели <i>такого</i> клинка!"

#. ja: 跡形もなく叩き潰すッ！
#. de: Ich zermalm euch zu Feinstaub!
#. fr: Je vais t'écraser<nbsp>!
msgctxt "NpcYell:10241:0:13"
msgid "It's too late for you!"
msgstr "Тебе уже не спастись!"

#. ja: オンドリャー！
#. de: Uuuund ... ha!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:10242:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: ブラズ、ヴェリボル！<br>仕掛けるよッ！
#. de: Blaz, Velibor. Passt jetzt gut auf!
#. fr: Blaz, Velibor<nbsp>! En position<nbsp>!
msgctxt "NpcYell:10243:0:13"
msgid "This one's mine!"
msgstr "Это мой противник!"

#. ja: ライアン様ぁ！<br>見ていて下さいぃぃ！
#. de: König der Bestien! Bitte, seht doch nur kurz hierher!
#. fr: Seigneur Lyooooon<nbsp>! Regardez-moi<nbsp>!
msgctxt "NpcYell:10244:0:13"
msgid "My beasts will be the death of you!"
msgstr "Мои звери вас прикончат!"

#. ja: ライアン様ぁ！<br>奮戦しておりますよぉぉ！
#. de: König der Bestien! Mein Leben gehört Euch!
#. fr: Seigneur, c'est un honneur de me battre pour vouuuuus<nbsp>!
msgctxt "NpcYell:10245:0:13"
msgid "Time to repay Lyon's trust!"
msgstr "Пора оправдать доверие Лиона!"

#. ja: ライアン様ぁ！<br>勝利を持ち帰りますぅぅ！
#. de: König der Bestien! Wir werden für Euch siegen!
#. fr: Seigneur Lyon<nbsp>! Je vous dédie cette victoire<nbsp>!
msgctxt "NpcYell:10246:0:13"
msgid "Lyon has taught me well!"
msgstr "Лион научил меня всему!"

#. ja: なんて見すぼらしい<br>蛮族なのかしら…
#. de: Ts, die sind ja wie besessen von ihm ...
#. fr: Quelles créatures fascinantes<nbsp>! C'est donc cela, les tribus barbares<nbsp>?
msgctxt "NpcYell:10247:0:13"
msgid "Away with you!"
msgstr "Убирайтесь!"

#. ja: ワタクシのペットの方が<br>百倍洗練されていますわ…
#. de: Dabei sind meine Tierchen doch hundertmal prächtiger als seine.
#. fr: Comme c'est pathétique... Mes petites bêtes sont bien mieux dressées que les vôtres<nbsp>!
msgctxt "NpcYell:10248:0:13"
msgid "I've no time to deal with you vermin!"
msgstr "Мне некогда возиться с вами, паразиты!"

#. ja: 薄汚くて<br>虫唾が走りますわね…
#. de: Wie schmutzig sie aussehen. Und sie stinken nach Schweiß.
#. fr: Regardez-les fuir comme des rats<nbsp>!
msgctxt "NpcYell:10249:0:13"
msgid "See how they run!"
msgstr "Глядите, как они бегут!"

#. ja: グチャグチャにしてやるッ！
#. de: Macht sie alle alle!
#. fr: Je vais te réduire en charpie<nbsp>!
msgctxt "NpcYell:10250:0:13"
msgid "We'll beat some sense into you!"
msgstr "Мы выбьем из вас дурь!"

#. ja: 泣いて侘びても<br>許さないッ！
#. de: Zeigt keine Gnade! Auch nicht, wenn sie weinen.
#. fr: Tu peux toujours supplier, je ne t'épargnerai pas<nbsp>!
msgctxt "NpcYell:10251:0:13"
msgid "Don't blame me if you end up dead!"
msgstr "Не вините меня, если отправитесь на тот свет!"

#. ja: オレたち第IV軍団に<br>逆らうヤツは皆殺しッ！
#. de: Alle kaltmachen, die nicht zur IV. gehören!
#. fr: Mort à ceux qui osent se rebeller contre la 4e légion<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10252:0:13"
msgid "The IVth Legion don't take no prisoners!<br>Well, except when we do..."
msgstr "IV легион никого не берёт в плен!<br>Ну, если только иногда..."

#. ja: お下がりなさい！
#. de: Zurück mit euch!
#. fr: Disparrrais, vermine<nbsp>!
msgctxt "NpcYell:10253:0:13"
msgid "You'll run if you know what's good for you!"
msgstr "Бегите, если знаете, что для вас лучше!"

#. ja: 抵抗しなければ<br>命までは奪いません！
#. de: Wenn ihr euch ergebt, verschonen wir euch.
#. fr: Si tu ne rrrésistes pas, je te laisserai peut-être en vie...
msgctxt "NpcYell:10254:0:13"
msgid "Better to flee while you still can!"
msgstr "Лучше бегите, пока ещё можете!"

#. ja: 命を捨てるような真似は<br>お辞めなさい…！
#. de: Werft eure Leben nicht einfach so weg!
#. fr: Pourrrquoi tenez-vous tant à vous sacrifier sans raison<nbsp>?
msgctxt "NpcYell:10255:0:13"
msgid "Hasn't there been enough bloodshed?"
msgstr "Разве пролито недостаточно крови?"

#. ja: 何がレジスタンスだ…<br>自由を拒む者どもめ…！
#. de: Warum hängen sie nur so an ihrer Freiheit?
#. fr: Abrrrutis de rebelles... L'Empire est le seul garant de la liberté<nbsp>!
msgctxt "NpcYell:10256:0:13"
msgid "Can't you see? Our ideals are the same!"
msgstr "Да поймите же, у нас одни идеалы!"

#. ja: 戦うだけしか頭にない<br>蛮族風情がッ…！
#. de: Ihr Wilden denkt nur ans Töten!
#. fr: Vous ne pensez donc qu'à vous battrrre<nbsp>? Espèces de barbares...
msgctxt "NpcYell:10257:0:13"
msgid "If you won't listen to reason, you leave me with no choice!"
msgstr "Не хотите слушать доводы разума — выбора вы мне не оставляете!"

#. ja: 私の仲間を…<br>よくも…よくもッ…！
#. de: Meine Kameraden ... meine lieben Kameraden!
#. fr: Comment avez-vous osé... vous en prendre à mes camarrrades<nbsp>!
msgctxt "NpcYell:10258:0:13"
msgid "Now you've gone too far!"
msgstr "За моих товарищей... Как вы посмели?!"

#. ja: 勝利の荒鷲に続けッ！
#. de: Der Adler greift nach dem nächsten Sieg!
#. fr: La victoire appartient aux plus fulgurants<nbsp>!
msgctxt "NpcYell:10259:0:13"
msgid "Strike hard and swift, as the eagle!"
msgstr "Бейте быстро и метко, как орёл!"

#. ja: グンヒルドの剣が<br>我らの御旗ッ！
#. de: Wir tragen die Standarte der Königinnenwache!
#. fr: Les lames de Gunnhildr sont là pour défendre notre drapeau<nbsp>!
msgctxt "NpcYell:10260:0:13"
msgid "By Gunnhildr's Blades, we shall be victorious!"
msgstr "Клинки Гуннхильд приведут нас к победе!"

#. ja: ボズヤに伝わる秘薬の力…<br>お受け取りを！
#. de: Empfangt die geheimen heilenden Kräfte unserer Ahnen!
#. fr: Vous allez tâter du savoir ancestral de Bozja<nbsp>!
msgctxt "NpcYell:10261:0:13"
msgid "This is how we Bozjans do battle!"
msgstr "Вот как сражаются бозийцы!"

#. ja: 大義のために…！
#. de: Es ist für die Gerechtigkeit.
#. fr: Pour la justice<nbsp>!
msgctxt "NpcYell:10262:0:13"
msgid "For a better tomorrow!"
msgstr "За лучшее будущее!"

#. ja: 同胞の未来…<br>守ってみせる！
#. de: Ich halte meine Hände schützend über die Zukunft meiner Landsleute.
#. fr: Je défendrai l'avenir de mon peuple... Coûte que coûte<nbsp>!
msgctxt "NpcYell:10263:0:13"
msgid "Freedom for Bozja! Freedom for all!"
msgstr "Свободу Бозье! Свободу всем!"

#. ja: 盾になりますッ！<br>私から離れないで…！
#. de: Bleibt bei mir. Ich werde euer Schild sein.
#. fr: Je vais servir de bouclier<nbsp>! Vite, derrière moi<nbsp>!
msgctxt "NpcYell:10264:0:13"
msgid "Stick with me! I'll keep you from harm."
msgstr "Держитесь рядом! Я вас защищу."

#. ja: 鍛え方が足りんッ！
#. de: Sollten meine Kräfte etwa nicht ausreichen?
#. fr: Vous ne m'arrivez pas à la cheville<nbsp>!
msgctxt "NpcYell:10265:0:13"
msgid "Pathetic!"
msgstr "Жалкое зрелище!"

#. ja: この程度かッ！？
#. de: All die langen Tage und Nächte des Trainings ...
#. fr: C'est donc tout ce dont vous êtes capables<nbsp>!?
msgctxt "NpcYell:10266:0:13"
msgid "Not worth my time!"
msgstr "Не стоите моего времени!"

#. ja: 沸き立つ魔力…<br>練りて放たんッ！
#. de: Ich spüre, wie die Macht mich durchströmt!
#. fr: Je sens la puissance des flammes en moi<nbsp>!
msgctxt "NpcYell:10267:0:13"
msgid "Your life is mine for the taking!"
msgstr "Я заберу твою жизнь!"

#. ja: 見よッ！<br>これが我が魔力ッ！
#. de: Seht her! Erkennt meine Macht!
#. fr: Admirez l'étendue de mon pouvoir<nbsp>!
msgctxt "NpcYell:10268:0:13"
msgid "Fear not. Your death will be swift!"
msgstr "Не бойтесь. Смерть будет быстрой!"

#. ja: 落ち着いていきましょう～！
#. de: Schön vorsichtig weitergehen.
#. fr: Allez, on respire et en avant<nbsp>!
msgctxt "NpcYell:10269:0:13"
msgid "Let's take it one imperial at a time."
msgstr "Будем расправляться с имперцами по одному."

#. ja: 援護を<br>お願いします～！
#. de: Passt gut auf mich auf, ja?
#. fr: Surveille mes arrières, d'accord<nbsp>?
msgctxt "NpcYell:10270:0:13"
msgid "Watch my back, would you?"
msgstr "Прикройте меня, ладно?"

#. ja: 力を合わせて<br>がんばりましょう～！
#. de: Wenn wir gut zusammen arbeiten, schaffen wir es auch lebend wieder heraus.
#. fr: Unissons nos forces pour vaincre l'ennemi<nbsp>!
msgctxt "NpcYell:10271:0:13"
msgid "By our powers combined!"
msgstr "Объединим силы!"

#. ja: 捉えました～！<br>逃しませんよ～？
#. de: Haben wir dich! Du entkommst uns nicht mehr!
#. fr: C'est l'occasion rêvée, allez ce n'est pas le moment de flancher<nbsp>!
msgctxt "NpcYell:10272:0:13"
msgid "Now for something special!"
msgstr "Вот ты и попался! Не уйдёшь!"

#. ja: ハハハッ！<br>俺サマに続け～ッ！
#. de: Haha! Immer schön mir nach.
#. fr: Hahaha<nbsp>! Suivez-moi<nbsp>!
msgctxt "NpcYell:10273:0:13"
msgid "Today is a good day to die! For you, that is!"
msgstr "Сегодня отличный день, чтобы умереть! Тебе, конечно!"

#. ja: おらおら、ウジ虫めッ！
#. de: Immer schön sachte, ihr Maden.
#. fr: Prenez donc ça<nbsp>! Misérables insectes<nbsp>!
msgctxt "NpcYell:10274:0:13"
msgid "Out of the way!"
msgstr "С дороги!"

#. ja: みなぎるッ！<br>みなぎってきたゾ～ッ！
#. de: So macht das erst richtig Spaß.
#. fr: Ah, c'est ça<nbsp>! L'exaltation suprême du combat<nbsp>!
msgctxt "NpcYell:10275:0:13"
msgid "Enough of these lackeys! I want their leader!"
msgstr "Хватит с меня этих прихвостней! Где их главарь?!"

#. ja: 俺サマの剣で<br>のたうちまわれ～ッ！
#. de: Windet euch unter den Hieben meines Schwertes!
#. fr: Goûtez donc à la pointe de mon épée<nbsp>!
msgctxt "NpcYell:10276:0:13"
msgid "Take a good look, imperials. You'll only get to see this once!"
msgstr "Смотрите в оба, имперцы. Второго такого случая не будет!"

#. ja: 悔しいが…<br>ここは退くしか…！
#. de: Verdammt. Weiter kommen wir nicht!
#. fr: Ça craint, mais il faut battre en retraite<nbsp>!
msgctxt "NpcYell:10277:0:13"
msgid "Much as it galls me, we've no choice but to retreat!"
msgstr "Как ни противно это признавать, нам остаётся только отступить!"

#. ja: ぐはッ…
#. de: Nichts wie weg!
#. fr: Guargh...
msgctxt "NpcYell:10278:0:13"
msgid "Oh, the ignominy!"
msgstr "Ох, какой позор!"

#. ja: “ピピピ……支援要請……支援要請……”
#. de: Biep, Biep.<br>Bitte um Verstärkung.<br>Wiederhole: Bitte um Verstärkung.
#. fr: PI PI PI... “DEMANDE DE RENFORTS.”
msgctxt "NpcYell:10279:0:13"
msgid "REQUESTING REINFORCEMENTS."
msgstr "ЗАПРАШИВАЮ ПОДКРЕПЛЕНИЕ."

#. ja: やだ、増援です～！<br>がんばりましょう～！
#. de: Da kommen noch mehr. Knöpfen wir sie uns vor!
#. fr: Manquait plus que ça... Tenez bon, les amis<nbsp>!
msgctxt "NpcYell:10280:0:13"
msgid "Just when I thought things couldn't get any worse!"
msgstr "А я-то думала, хуже уже некуда!"

#. ja: “損傷率95パーセントヲ突破……<br>戦闘続行……不可能……”
#. de: Schaden bei 95 %.<br>Kampfunfähigkeit.<br>Rotalarm: Kampfunfähigkeit.
#. fr: “SYSTÈMES ENDOMMAGÉS À PLUS DE 95%<nbsp>! POURSUITE DU COMBAT IMpO... SsIbLe.” *pziou*
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10281:0:13"
msgid "SYSTEM DAMAGE: 95%.<br>ENTERING SAFE MODE...<br>SYSTEMS OFFLINE..."
msgstr "ПОВРЕЖДЕНИЯ СИСТЕМЫ: 95%.<br>ПЕРЕХОД В БЕЗОПАСНЫЙ РЕЖИМ...<br>СИСТЕМА ОТКЛЮЧЕНА..."

#. ja: やはり、修復が不完全であったか……。<br>しかし、今回のデータがあれば、次は…………。
#. de: Es fehlte noch an ein paar Ecken und Enden. Aber mit den neuen Daten wird das nächste Modell bestimmt ein Erfolg.
#. fr: Hmm, je n'aurais peut-être pas dû le déployer aussi tôt... Cela dit, ses données de combat devraient s'avérer utiles, hé hé...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10282:0:13"
msgid "I should have spent more time on its restoration.<br>No matter. The data I have gleaned will prove most useful."
msgstr "Надо было потратить больше времени на его восстановление.<br>Неважно. Собранные данные ещё пригодятся."

#. ja: あれ～、誰かの声が聞こえたような～？<br>影からこそこそ、いやらしいです～。
#. de: Hab ich da eine Stimme aus den Schatten gehört? Wer war das?
#. fr: Tiens<nbsp>? J'ai cru entendre quelqu'un jubiler de façon perverse...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10283:0:13"
msgid "I just heard a voice!<br>And not a particularly pleasant one..."
msgstr "Я только что услышала чей-то голос!<br>И звучал он не слишком приятно..."

#. ja: 不完全な状態で勝利するとは……。<br>これがゴーグの遺物のポテンシャルか…………。
#. de: Ein Sieg, obwohl die Stärke des Originalmodells noch nicht erreicht ist. Das Wissen der Uhrwerksstadt Gog ist wirklich beeindruckend.
#. fr: Victoire<nbsp>! Et je n'ai même pas pris le temps de l'améliorer<nbsp>! Ces reliques de la cité de Goug ont décidément du potentiel.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10284:0:13"
msgid "Even in its incomplete state, it was extremely effective.<br>I look forward to unearthing more of its kind in the clockwork city..."
msgstr "Он оказался на удивление эффективен, даже не будучи полностью восстановлен.<br>Жду не дождусь, когда отыщу ему подобных в часовом городе..."

#. ja: み、みなさん<br>ごめんなさい～！
#. de: Ich hätte so gerne mehr für euch getan ...
#. fr: D-désolée, les amis, c'est ma faute<nbsp>!
msgctxt "NpcYell:10285:0:13"
msgid "I take full responsibility for this abject failure!"
msgstr "Всю вину за этот позорный провал беру на себя!"

#. ja: くっ、マズいな…
#. de: Argh, nicht gut ...
#. fr: Ça se prrrésente mal...
msgctxt "NpcYell:10286:0:13"
msgid "Oh, dear..."
msgstr "Ох, нехорошо..."

#. ja: やられてたまるか…！
#. de: Ich werde nie aufgeben!
#. fr: Tu m'aurrras pas<nbsp>!
msgctxt "NpcYell:10287:0:13"
msgid "Not today!"
msgstr "Не дождётесь!"

#. ja: まだいける…ッ！
#. de: Jetzt komm ich!
#. fr: Je tiens toujourrrs<nbsp>!
msgctxt "NpcYell:10288:0:13"
msgid "Naught to worry about."
msgstr "Всё ещё держусь!"

#. ja: 眠ってられるか…！
#. de: Nur eine kleine Ver<shy>schnauf<shy>pause.
#. fr: Allez<nbsp>! On se rrréveille<nbsp>!
msgctxt "NpcYell:10289:0:13"
msgid "I have slept long enough!"
msgstr "Хватит уже валяться!"

#. ja: 悪い、次こそは…！
#. de: Tut mir leid, ich gebe mein Bestes!
#. fr: Désolé<nbsp>! J'vais assurrrer cette fois<nbsp>!
msgctxt "NpcYell:10290:0:13"
msgid "I'm in your debt."
msgstr "Я ваш должник."

#. ja: もう一度だ…！
#. de: Auf ein Neues!
#. fr: C'est rrreparti<nbsp>!
msgctxt "NpcYell:10291:0:13"
msgid "Once more, then!"
msgstr "Ещё разок!"

#. ja: オレがやる！
#. de: Jetzt komm ich!
#. fr: Je m'en occupe<nbsp>!
msgctxt "NpcYell:10292:0:13"
msgid "Allow me!"
msgstr "Позвольте мне!"

#. ja: 任された！
#. de: Überlass das mir!
#. fr: J'en fais mon affairrre<nbsp>!
msgctxt "NpcYell:10293:0:13"
msgid "If I may!"
msgstr "Поручите это мне!"

#. ja: 捉えた！
#. de: Hab ich dich!
#. fr: Je te tiens<nbsp>!
msgctxt "NpcYell:10294:0:13"
msgid "There!"
msgstr "Вот ты и попался!"

#. ja: すり抜けてくれるなよ！
#. de: Mir entkommst du nicht!
#. fr: Tu m'échapperrras pas<nbsp>!
msgctxt "NpcYell:10295:0:13"
msgid "Hold still!"
msgstr "Не вздумай ускользнуть!"

#. ja: 切り札を見せてやる！
#. de: Hier kommt mein Trumpf!
#. fr: Voilà mon atout caché<nbsp>!
msgctxt "NpcYell:10296:0:13"
msgid "Something special for you!"
msgstr "Вот мой козырь!"

#. ja: 諦めが悪いんだ！
#. de: Das wird jetzt wehtun!
#. fr: Tu sais pas quand abandonner<nbsp>!
msgctxt "NpcYell:10297:0:13"
msgid "Stubborn!"
msgstr "Ну и упёртый же ты!"

#. ja: 大丈夫か！？
#. de: Alles in Ordnung?
#. fr: Ça va aller<nbsp>!?
msgctxt "NpcYell:10298:0:13"
msgid "Are you all right?"
msgstr "Ты в порядке?!"

#. ja: すぐに治す！
#. de: Ich heile deine Wunden!
#. fr: Je soigne ça tout de suite<nbsp>!
msgctxt "NpcYell:10299:0:13"
msgid "I'll tend your wounds."
msgstr "Сейчас перевяжу раны."

#. ja: もう痛くないぞ
#. de: Der Schmerz wird gleich vergehen.
#. fr: Je vais calmer la douleurrr<nbsp>!
msgctxt "NpcYell:10300:0:13"
msgid "Hold on!"
msgstr "Держись!"

#. ja: さぁて…
#. de: Also gut ...
#. fr: Ça, ça devrrrait aider<nbsp>!
msgctxt "NpcYell:10301:0:13"
msgid "Right, then..."
msgstr "Ну что ж..."

#. ja: 活躍を見せてくれ
#. de: Zeig, was du kannst!
#. fr: Montrrrons ce qu'on sait faire<nbsp>!
msgctxt "NpcYell:10302:0:13"
msgid "Show me what you can do!"
msgstr "Покажи, на что способен!"

#. ja: ここからだ！
#. de: Jetzt geht's erst richtig los!
#. fr: Faut maintenir la prrression<nbsp>!
msgctxt "NpcYell:10303:0:13"
msgid "Just the beginning!"
msgstr "Это только начало!"

#. ja: 来い…ッ！<br>何が何でも護ってみせる！
#. de: Mein Schild dir zum Schutze!
#. fr: Jamais on ne recule<nbsp>! Ma garrrde nous protégera<nbsp>!
msgctxt "NpcYell:10304:0:13"
msgid "My shield will not buckle!"
msgstr "Мой щит не дрогнет!"

#. ja: 全開だ…<br>まるごといただくぞ！
#. de: Jetzt heißt es: Alles oder nichts!
#. fr: C'est le moment... Je vais donner tout ce que j'ai<nbsp>!
msgctxt "NpcYell:10305:0:13"
msgid "In one fell swoop!"
msgstr "Одним махом!"

#. ja: 終わりになんか<br>させるものか！
#. de: Diese Sage ist noch nicht zu Ende!
#. fr: Nos aventurrres ne prendront pas fin aujourd'hui<nbsp>!
msgctxt "NpcYell:10306:0:13"
msgid "Our tale will not end here!"
msgstr "Наша история здесь не закончится!"

#. ja: 帝国軍の魔導兵器…！<br>機械化歩兵大隊ですね…！
#. de: Das ist die mobile Infanterie der IV. Legion.
#. fr: Des armes magitek<nbsp>! Elles viennent vers nous<nbsp>!
msgctxt "NpcYell:10307:0:13"
msgid "Remember, these are not unthinking machines, they are soldiers, which makes them all the more dangerous."
msgstr "Помните: это не бездушные машины, а солдаты. Оттого они куда опаснее."

#. ja: まだ、いけるよなあ？
#. de: Du hast noch Kraft, ja?
#. fr: T'en veux encore, ja<nbsp>?
msgctxt "NpcYell:10308:0:13"
msgid "Still holding up?"
msgstr "Ещё держишься?"

#. ja: 応戦ッ！<br>応戦だーッ！
#. de: Formation halten!
#. fr: La meilleure défense, c'est l'attaque<nbsp>!
msgctxt "NpcYell:10309:0:13"
msgid "Forward!"
msgstr "Вперёд!"

#. ja: 来るなら来いッ！
#. de: Sollen die Blechbüchsen doch kommen!
#. fr: Si vous nous cherchez, vous allez nous trouver<nbsp>!
msgctxt "NpcYell:10310:0:13"
msgid "This is as far as you go!"
msgstr "Дальше не пройдёте!"

#. ja: やってやる！
#. de: Die knacken wir!
#. fr: On n'a pas peur de vous<nbsp>!
msgctxt "NpcYell:10311:0:13"
msgid "Not another step closer!"
msgstr "Ни шагу ближе!"

#. ja: 喰らえぇぇっ！
#. de: Stirb!
#. fr: Prends çaaa<nbsp>!!
msgctxt "NpcYell:10312:0:13"
msgid "I have you now!"
msgstr "Попался!"

#. ja: つらぬく！
#. de: Lanze voran!
#. fr: Ça va piquer<nbsp>!
msgctxt "NpcYell:10313:0:13"
msgid "You're finished!"
msgstr "Тебе конец!"

#. ja: こいつはどうだ！
#. de: Wie schmeckt dir das?
#. fr: Que dis-tu de ça<nbsp>?
msgctxt "NpcYell:10314:0:13"
msgid "Take this!"
msgstr "А ну-ка, попробуй это!"

#. ja: 咆えろ、魔槍ニーズヘッグッ！
#. de: Nidhogg, schenk mir deine Kraft!
#. fr: Entendez rugir la lance de Nidhogg<nbsp>!
msgctxt "NpcYell:10315:0:13"
msgid "Roar, Nidhogg! Roar!"
msgstr "Реви, Нидхёгг! Реви!"

#. ja: 装甲損傷率…限界突破…<br>次の作戦に移行しまス…
#. de: Panzerung hat Grenzwert erreicht.<br>Strategiewechsel.
#. fr: Niveau de dommages critique. Changement immédiat de stratégie.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10316:0:13"
msgid "Significant damage sustained.<br>Adjusting battle parameters."
msgstr "Получены серьёзные повреждения.<br>Пересчёт боевых параметров."

#. ja: おら、おらおら！
#. de: Und noch einer!
#. fr: Jaa, jaaa, jaaaa<nbsp>!!
msgctxt "NpcYell:10317:0:13"
msgid "Hyaaah!"
msgstr "А-а-а!"

#. ja: 魔導兵器の撤退を確認！<br>皆、よく戦い抜きました！
#. de: Die Blechbüchsen ziehen sich zurück. Gut gekämpft, Leute!
#. fr: Ils se retirent<nbsp>! Bravo les amis, ça, c'était du combat<nbsp>!
msgctxt "NpcYell:10318:0:13"
msgid "That's it! Well fought, everyone!"
msgstr "Вот и всё! Отлично сражались, все!"

#. ja: うわあああ、誰か…！
#. de: Zu Hiiilfeee!
#. fr: Au secouuurs<nbsp>!! À l'aiiiide<nbsp>!!
msgctxt "NpcYell:10319:0:13"
msgid "Uwaaah!"
msgstr "Уаааа!"

#. ja: なんという圧力…！<br>総員、撤退してくださいッ…！
#. de: Sie machen zu viel Druck, da können wir nicht gegenhalten. Rückzug!
#. fr: Quelle puissance de feu... Ne tentez pas le diable, les amis, fuyez<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10320:0:13"
msgid "All of you, fall back!<br>We'll have to rethink our strategy."
msgstr "Всем отступить!<br>Нужно пересмотреть стратегию."

#. ja: 焔よ…<br>疾走りなさい！
#. de: Wütet, meine Flammen!
#. fr: Flammes, répandez-vous<nbsp>!
msgctxt "NpcYell:10321:0:13"
msgid "Chase and char!"
msgstr "Пламя...<br>Вперёд, жги!"

#. ja: 焔よ…<br>踊りなさい！
#. de: Tanzt, meine Flammen!
#. fr: Flammes, virevoltez<nbsp>!
msgctxt "NpcYell:10322:0:13"
msgid "Dance and wither!"
msgstr "Пламя...<br>Танцуй и иссушай!"

#. ja: 焔よ…<br>爆ぜなさい！
#. de: Berstet, meine Flammen!
#. fr: Flammes, grondez<nbsp>!
msgctxt "NpcYell:10323:0:13"
msgid "Burst and burn!"
msgstr "Пламя...<br>Взрывайся и жги!"

#. ja: 焔よ…<br>討ちなさい！
#. de: Schießt voraus, meine Flammen!
#. fr: Flammes, calcinez tout<nbsp>!
msgctxt "NpcYell:10324:0:13"
msgid "Hunt and scorch!"
msgstr "Пламя...<br>Охоться и испепеляй!"

#. ja: 焔よ…<br>叩きなさい！
#. de: Schlagt empor, meine Flammen!
#. fr: Flammes, tourbillonnez<nbsp>!
msgctxt "NpcYell:10325:0:13"
msgid "Strike and sear!"
msgstr "Пламя...<br>Бей и опаляй!"

#. ja: 自由のために！
#. de: Für unsere Heimat! Für unsere Freiheit!
#. fr: Pour la liberté<nbsp>!
msgctxt "NpcYell:10326:0:13"
msgid "Our freedom awaits!"
msgstr "За нашу свободу!"

#. ja: 負けはしないッ！
#. de: Wir dürfen nicht verlieren!
#. fr: Jamais je ne m'avouerai vaincu<nbsp>!
msgctxt "NpcYell:10327:0:13"
msgid "We've come too far to lose it all now!"
msgstr "Мы не можем проиграть!"

#. ja: 守リヲ…固メル…
#. de: Mein Schild<nbsp>... ist meine Festung<nbsp>...
#. fr: Je suis le bouclier... infrangible...
msgctxt "NpcYell:10328:0:13"
msgid "My shield...is impregnable..."
msgstr "Мой щит... непоколебим..."

#. ja: こいつ…！<br>守勢を崩すんだッ！
#. de: Mist, wir müssen einen Weg finden, die Verteidigung zu durchdringen!
#. fr: Bordel<nbsp>! On doit trouver un moyen de briser sa garde<nbsp>!
msgctxt "NpcYell:10329:0:13"
msgid "Damn! We must find a way past his defense!"
msgstr "Проклятье! Надо найти способ пробить его защиту!"

#. ja: なんて硬さだ…！
#. de: Meine Pfeile sind wirkungslos!
#. fr: Mes flèches lui font carrément rrrien<nbsp>!
msgctxt "NpcYell:10330:0:13"
msgid "My arrows don't do a thing!"
msgstr "Мои стрелы ему нипочём!"

#. ja: オォォ…
#. de: \<zisch>
#. fr: Mwarrr... grr...
msgctxt "NpcYell:10331:0:13"
msgid "Uhhh..."
msgstr "У-у-у..."

#. ja: アァァ…
#. de: \<fauch>
#. fr: Bwaaa.. Ahhh...
msgctxt "NpcYell:10332:0:13"
msgid "Graaargh..."
msgstr "Гра-а-арх..."

#. ja: ウゥゥ…
#. de: \<stöhn>
#. fr: Huuu...
msgctxt "NpcYell:10333:0:13"
msgid "Unnnghhh..."
msgstr "Н-н-нгх..."

#. ja: アッ…アッ…
#. de: \<gurgel>
#. fr: Ahh... Ahh...
msgctxt "NpcYell:10334:0:13"
msgid "Ahhh..."
msgstr "А-а-а..."

#. ja: エルネイス隊長！<br>レジスタンス部隊です！
#. de: Kommandant! Der Widerstand ist da!
#. fr: Rebelles en vue<nbsp>!
msgctxt "NpcYell:10335:0:13"
msgid "Resistance troops approaching!"
msgstr "Приближаются бойцы Сопротивления!"

#. ja: フフフ、私たちの実力…<br>ライアン様に見せるときですねぇぇ！
#. de: Endlich. Endlich eine Gelegenheit, um dem König der Bestien zu beweisen, was wir draufhaben.
#. fr: Ah, enfin l'épreuve du feu. Le moment est venu de prouver notre valeur au seigneur Lyon<nbsp>!
msgctxt "NpcYell:10336:0:13"
msgid "And not a moment too soon. The time has come to prove my worth to Lyon!"
msgstr "Ну наконец-то. Пора доказать Лиону, чего я стою!"

#. ja: グルルル…
#. de: \<knurr>
#. fr: Grrrrrr...
msgctxt "NpcYell:10337:0:13"
msgid "Grrrrrr..."
msgstr "Гр-р-р..."

#. ja: 職人方、物資の納品に感謝する！<br>復興共同作業の開始だ！
#. de: Vielen Dank für die gelieferten Materialien! Wenn weiter alle mit anpacken, haben wir das Projekt im Nu erledigt!
#. fr: Merci à tous pour vos dons<nbsp>! Maintenant, c'est l'heure de l'ouvrage collectif<nbsp>!
msgctxt "NpcYell:10338:0:13"
msgid "Many thanks for the materials! With this, the construction can begin in earnest!"
msgstr "Большое спасибо за материалы! Теперь можно всерьёз приниматься за стройку!"

#. ja: 皆、力を合わせて、<br>道をふさぐ「大きな瓦礫」を切り崩す作業を頼む！
#. de: Bitte helft uns, die großen Trümmerteile zu zerlegen!
#. fr: Allez, on se retrousse les manches et on déblaye tout ça<nbsp>!
msgctxt "NpcYell:10339:0:13"
msgid "First things first, we'll need to clear our path of debris before we can get to buildin'."
msgstr "Сперва надо расчистить завалы, а уж потом строить."

#. ja: 今期も気張っていこうな！！
#. de: Neues Projekt, neues Glück!
#. fr: Courage tout le monde, on unit nos efforts<nbsp>!
msgctxt "NpcYell:10340:0:13"
msgid "For the future of Ishgard, let's give it our all!"
msgstr "Ради будущего Ишгарда — покажем, на что способны!"

#. ja: 皆、よく集まってくれた！<br>さあ、復興共同作業をおっ始めようぜ！
#. de: Vielen Dank, dass ihr gekommen seid, um uns bei dem Projekt zu helfen. Packen wir's an!
#. fr: Vous avez tous été très généreux en dons. Je compte sur vous pour l'être en efforts<nbsp>!
msgctxt "NpcYell:10341:0:13"
msgid "Your efforts on our behalf are most appreciated. We need all the hands we can get!"
msgstr "Спасибо, что пришли помочь! Нам нужны все свободные руки!"

#. ja: フェザーフォール商業区の、<br>道をふさぐ「大きな瓦礫」を切り崩す作業を頼む！
#. de: Helft uns, das Federfall-Quartier von Trümmern zu befreien!
#. fr: C'est pas avec tous ces débris qu'on pourra construire Tombeplume... Allez, au travail<nbsp>!
msgctxt "NpcYell:10342:0:13"
msgid "Featherfall's a mess of debris at the moment, and it's our job to do somethin' about that."
msgstr "В Перьепаде полно завалов, так что давайте разберёмся с ними."

#. ja: 道を切り開いていくぞッ！
#. de: Los, räumen wir den Weg frei!
#. fr: Mes amis, c'est le moment de déblayer<nbsp>! Courage<nbsp>!
msgctxt "NpcYell:10343:0:13"
msgid "Remember, we're not just pushing rocks around. We're forgin' a path to a new day in Ishgard!"
msgstr "Помните, мы не просто таскаем камни. Мы прокладываем путь к новому Ишгарду!"

#. ja: 物資の供給は充分だ！<br>復興共同作業を開始する！
#. de: Sehr gut, wir haben alles, was wir brauchen. Jetzt können wir mit den Arbeiten loslegen!
#. fr: Bon, on a assez de ressources. Place au prochain ouvrage collectif<nbsp>!
msgctxt "NpcYell:10344:0:13"
msgid "We're all stocked up on materials! Time to commence concerted works!"
msgstr "Материалов у нас вдоволь! Пора начинать работы сообща!"

#. ja: 引き続きフェザーフォール商業区の、<br>道をふさぐ「大きな瓦礫」を切り崩す作業を頼む！
#. de: Die großen Trümmer im Federfall-Quartier müssen zerteilt werden!
#. fr: Vous savez comment ça marche, il faut déblayer avant de bâtir... Au boulot<nbsp>!
msgctxt "NpcYell:10345:0:13"
msgid "There's still debris in Featherfall that wants for clearin', and that's where you come in."
msgstr "В Перьепаде ещё полно завалов. Вот ими и займёмся."

#. ja: 日々の職人たちの助力あっての物種だ！<br>感謝する！
#. de: Vielen Dank für eure tatkräftige Hilfe!
#. fr: Quel plaisir de voir tout le monde travailler main dans la main<nbsp>! Allez, on s'arrête pas en si bon chemin<nbsp>!
msgctxt "NpcYell:10346:0:13"
msgid "Many thanks! We'd be lost without artisans like you."
msgstr "Спасибо! Без таких мастеров, как вы, нам не справиться."

#. ja: 復興共同作業を開始するッ！<br>みんな、位置についてくれ！
#. de: Das Projekt beginnt. Auf, auf, ans Werk!
#. fr: Tous en position pour le prochain ouvrage collectif<nbsp>!
msgctxt "NpcYell:10347:0:13"
msgid "To your places, everyone! It's time to get to work!"
msgstr "Все по местам! Пора за работу!"

#. ja: 今回はフェザーフォール商業区の清掃を行う！
#. de: Das Federfall-Quartier soll sauber werden!
#. fr: C'est l'heure de faire le grand ménage à Tombeplume<nbsp>!
msgctxt "NpcYell:10348:0:13"
msgid "Today, we're goin' to make the streets of Featherfall positively shine!"
msgstr "Сегодня наведём блеск на улицах Перьепада!"

#. ja: 「微細な瓦礫片」を、取っ払ってくれ！
#. de: Bitte räumt die letzten Trümmerreste weg!
#. fr: Bon, il reste encore quelques menus débris... Nettoyez-moi tout ça<nbsp>!
msgctxt "NpcYell:10349:0:13"
msgid "Any last specks of debris are to be cleared away!"
msgstr "Уберите последние мелкие обломки!"

#. ja: 次の復興共同作業に取りかかるぞッ！<br>準備はいいか！？
#. de: Das nächste Projekt steht in den Startlöchern. Seid ihr bereit?
#. fr: Je crois qu'il est temps de passer au prochain ouvrage collectif. Tout le monde est prêt<nbsp>?
msgctxt "NpcYell:10350:0:13"
msgid "Look alive, everyone! We're movin' on to the next phase of concerted works!"
msgstr "Всем приготовиться! Переходим к следующему этапу работ!"

#. ja: フェザーフォール商業区の舗装のため、<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Als Nächstes wird das Federfall-Quartier gepflastert. Bitte holt die benötigten Materialien.
#. fr: Bon, les gars, c'est l'heure d'aller compter fleurette aux piles de matériaux<nbsp>! Dites-leur combien vous les aimez<nbsp>!
msgctxt "NpcYell:10351:0:13"
msgid "Grab the supplies you need, and let's pave the way forward in Featherfall!"
msgstr "Берите всё необходимое и прокладывайте путь вперёд — в Перьепаде!"

#. ja: 整備した土地は、今後の建築の基盤になるぞ！<br>丁寧に仕上げていこう！
#. de: Beim Bauen kommt es auf ein stabiles Fundament an, also gebt euch bitte Mühe!
#. fr: Le prochain ouvrage collectif concerne les fondations de nos futures bâtisses. Je compte sur vous<nbsp>!
msgctxt "NpcYell:10352:0:13"
msgid "These streets will be home to the Firmament's new center of commerce! I don't want to see a single stone out of place!"
msgstr "Эти улицы станут новым торговым центром Твёрди! Чтобы ни один камень не лежал криво!"

#. ja: 今回の復興共同作業から、<br>建築作業を行う！
#. de: Wunderbar, jetzt können wir mit dem Bau der Gebäude beginnen!
#. fr: Je sais que vous attendiez tous ce moment<nbsp>: on se met à construire<nbsp>!
msgctxt "NpcYell:10353:0:13"
msgid "Startin' from today, we're gonna be puttin' up buildings!"
msgstr "С сегодняшнего дня начинаем строить здания!"

#. ja: 「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Bitte holt das Material und beginnt mit der Arbeit!
#. fr: Les gars, je crois que vous avez rendez-vous avec les piles de matériaux. Soyez doux<nbsp>!
msgctxt "NpcYell:10354:0:13"
msgid "You'll find everythin' you need in the supply piles. Now let's get to work!"
msgstr "Всё необходимое найдёте на складе. Ну, за работу!"

#. ja: ゆくゆくは、機工房分館や住居になる予定だ！<br>皆も楽しみにしていてくれ！
#. de: Hier werden neue Wohnungen und eine Zweigstelle der Himmelsstahl-Werkstätte entstehen. Ich kann es kaum erwarten!
#. fr: L'annexe de la manufacture de Cielacier et des habitations se dresseront bientôt à cet endroit. En attendant, à vous de jouer<nbsp>!
msgctxt "NpcYell:10355:0:13"
msgid "One day, this place will house a branch of the Skysteel Manufactory, and a residence hall to boot!"
msgstr "Когда-нибудь здесь откроется филиал Небесной мануфактуры и появится жилой дом!"

#. ja: 今回の復興共同作業で、<br>機工房分館と住居を完成させるぞ！
#. de: Bei diesem Projekt bauen wir eine Zweigstelle der Himmelsstahl-Werkstätte und ein imposantes Wohnquartier!
#. fr: Vous avez envie de voir l'annexe de la manufacture de Cielacier et de belles habitations, hein<nbsp>? Alors au boulot<nbsp>!
msgctxt "NpcYell:10356:0:13"
msgid "Today, we'll be finishin' work on the manufactory branch and residence hall!"
msgstr "Сегодня мы закончим филиал мануфактуры и жилой дом!"

#. ja: 「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Bitte holt euch Material von den Materialstapeln und macht euch ans Werk!
#. fr: Les piles de matériaux, ça vous dit quelque chose<nbsp>? Allez, c'est le moment de transpirer<nbsp>!
msgctxt "NpcYell:10357:0:13"
msgid "This is what we've been buildin' up towards, so let's give it all we've got!"
msgstr "Мы так долго к этому шли, так что выложимся по полной!"

#. ja: 職人たちが誇りを持てるような建築物を、<br>立派に建ててみせようじゃないか！
#. de: Die Gebäude werden Denkmäler eurer Handwerkskunst sein!
#. fr: Votre réputation d'artisan est en jeu, alors allez me construire les plus beaux bâtiments d'Azurée<nbsp>!
msgctxt "NpcYell:10358:0:13"
msgid "Let's build something that will stand as a monument to our craftsmanship!"
msgstr "Построим такое, чем любой мастер будет гордиться!"

#. ja: 復興共同作業の開始だ！
#. de: Los geht's mit dem nächsten Projekt!
#. fr: Co-lle-ctif<nbsp>! Co-lle-ctif<nbsp>! C'est l'ouvrage CO-LLE-CTIF<nbsp>!!!♪
msgctxt "NpcYell:10359:0:13"
msgid "Look sharp, all of you! It's time to begin concerted works!"
msgstr "Всем приготовиться! Пора начинать работы сообща!"

#. ja: 新たな住居の建設のため、<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Los, packt kräftig an und zieht die Wohngebäude in die Höhe!
#. fr: Pensez à toutes ces futures habitations... Charmantes, hein<nbsp>? Alors direction les piles de matériaux<nbsp>!
msgctxt "NpcYell:10360:0:13"
msgid "House-buildin' is the order of the day, so grab some materials and get to work!"
msgstr "Сегодня строим жильё, так что берите материалы и за работу!"

#. ja: さあ、この地区にも、<br>どんどん住居を建設していくぞッ！
#. de: Mit eurer Hilfe werden hier prächtige Wohngebäude entstehen!
#. fr: Vous ne trouvez pas que ça manque de bâtiments, par ici<nbsp>? Allez, c'est le moment de transpirer un bon coup<nbsp>!
msgctxt "NpcYell:10361:0:13"
msgid "No rest until the streets of Featherfall are lined with stately residences!"
msgstr "Не успокоимся, пока на улицах Перьепада не вырастут красивые дома!"

#. ja: 資源が集まったようなんで、<br>復興共同作業を始めるぜッ！
#. de: So, alles ist bereit. Wir können mit dem Gemeinschaftsprojekt beginnen!
#. fr: Des matériaux comme s'il en pleuvait, et c'est grâce à vous<nbsp>! Fé<shy>li<shy>ci<shy>ta<shy>tions, vous avez gagné le droit de vous retrousser les manches<nbsp>!
msgctxt "NpcYell:10362:0:13"
msgid "Thanks to you, we've all the materials we need, and then some! Time to commence concerted works!"
msgstr "Благодаря вам у нас материалов с избытком! Пора начинать работы сообща!"

#. ja: 作業中の住居の建設を完成させよう！<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Auf dem Materialstapel liegt alles bereit, was ihr für die Arbeit benötigt.
#. fr: Vous savez comment on construit, par ici<nbsp>? En allant se servir sur des piles de matériaux, pardi<nbsp>! Allez, au boulot<nbsp>!
msgctxt "NpcYell:10363:0:13"
msgid "Today we're puttin' the finishing touches on these houses. You know where to find the supplies you need!"
msgstr "Сегодня закончим эти дома. Материалы найдёте на складе!"

#. ja: 皆の職人技を結集し、<br>立派な住居を建ててほしい！
#. de: Los, zeigt, was ihr könnt und errichtet prächtige Wohngebäude!
#. fr: Ces nouvelles con<shy>struc<shy>tions seront la matérialisation de vos techniques d'artisanat<nbsp>! C'est à vous de jouer<nbsp>!
msgctxt "NpcYell:10364:0:13"
msgid "Show us your skill, and build houses any adventurer'd be happy to call home!"
msgstr "Покажите своё мастерство и постройте дома, в которых любой искатель приключений будет рад жить!"

#. ja: 復興共同作業の時間だ！
#. de: Zeit für das nächste Gemeinschaftsprojekt!
#. fr: Monsieur et madame Collectif ont un fils... Oui, <i>Ouvrage</i><nbsp>! Bravo, elle était pas facile<nbsp>!
msgctxt "NpcYell:10365:0:13"
msgid "It's that time again─time to begin concerted works!"
msgstr "Опять пора за работу сообща!"

#. ja: 新たな住居の建設のため、<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Holt euch Material vom Materialstapel und macht euch ans Werk!
#. fr: Vous n'allez pas me croire... On a plein de piles de matériaux rien que pour vous<nbsp>! Si si, allez voir<nbsp>!
msgctxt "NpcYell:10366:0:13"
msgid "Today we'll be workin' on still more houses! You know where to find the supplies you need!"
msgstr "Сегодня займёмся ещё несколькими домами! Материалы найдёте на складе!"

#. ja: フェザーフォール商業区の住居は、<br>この家で最後になるぞ！
#. de: Das wird das letzte Wohngebäude im Federfall-Quartier!
#. fr: Pour le prochain ouvrage collectif, on va construire quelques habitations. Courage, les gars<nbsp>!
msgctxt "NpcYell:10367:0:13"
msgid "This'll be Featherfall's last set of houses, so let's make 'em our finest yet!"
msgstr "Это последние дома в Перьепаде, так что постараемся на славу!"

#. ja: フェザーフォール商業区の建設は、<br>今回の復興共同作業で完成する予定だ！
#. de: Mit dem aktuellen Projekt werden wir die Bauarbeiten im Federfall-Quartier abschließen!
#. fr: Allez, une dernière petite séance de con<shy>struc<shy>tion pour Tombeplume<nbsp>! Encore un petit effort<nbsp>!
msgctxt "NpcYell:10368:0:13"
msgid "This is it, everyone─the final stage of construction here in Featherfall! No restin' till the job is done!"
msgstr "Вот и всё, друзья! Последний этап строительства в Перьепаде! Не отдыхаем, пока не закончим!"

#. ja: 作業中の住居の建設を完成させよう！<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Bedient euch an den Materialstapeln und vollendet die Wohngebäude!
#. fr: Et quelques habitations pour la route... Mes amis, à vous les piles de matériaux<nbsp>!
msgctxt "NpcYell:10369:0:13"
msgid "Just a bit more work and these houses will be ready for livin' in. You know what needs to be done!"
msgstr "Ещё немного — и в этих домах можно будет жить. Вы знаете, что делать!"

#. ja: 今期最後の住居建築、<br>皆の底力を見せてほしい！
#. de: Los, gebt im Endspurt bei den Wohngebäuden noch einmal alles!
#. fr: On a des volontaires pour aller construire quelques habitations<nbsp>? Direction les piles de matériaux<nbsp>!
msgctxt "NpcYell:10370:0:13"
msgid "This is the last set of houses. I want to see your best work yet!"
msgstr "Это последние дома. Хочу увидеть вашу лучшую работу!"

#. ja: 今回の復興共同作業から、<br>アバカス通りの整備だ！
#. de: Lasst uns die Allee des Abakus von Trümmern befreien!
#. fr: Nouvel ouvrage collectif, et nouveau chantier<nbsp>! Cette fois-ci, on s'attaque à L'Abaque<nbsp>!
msgctxt "NpcYell:10371:0:13"
msgid "In today's concerted works, we'll be cleanin' up the Abacus!"
msgstr "Сегодня наводим порядок на улице Счётов!"

#. ja: 道をふさぐ「大きな瓦礫」を切り崩す作業を頼む！
#. de: Bitte zerkleinert die großen Trümmerteile!
#. fr: Les débris volumineux vous avaient manqué<nbsp>? Ça tombe bien, il y en a des tas qui vous attendent à L'Abaque<nbsp>!
msgctxt "NpcYell:10372:0:13"
msgid "That means clearin' away any debris that's blockin' our way!"
msgstr "Разберите крупные завалы, что преграждают нам путь!"

#. ja: 皆の力で美しい通りを造り上げる、<br>最初の一歩だ！
#. de: Das ist der erste Schritt hin zu einer frisch gepflasterten Straße!
#. fr: Imaginez un peu l'avenue splendide que sera L'Abaque quand vous aurez terminé<nbsp>! Allez, au boulot<nbsp>!
msgctxt "NpcYell:10373:0:13"
msgid "It's not a pretty job, but just think of the magnificent market that'll be standin' here someday!"
msgstr "Работа грязная, зато представьте, какой прекрасный рынок здесь однажды появится!"

#. ja: 皆、復興共同作業に参加してほしい！
#. de: Kommt, packt alle kräftig mit an!
#. fr: Mes amis, vous savez ce qui me ferait plaisir<nbsp>? Que vous donniez tout au prochain ouvrage collectif<nbsp>!
msgctxt "NpcYell:10374:0:13"
msgid "Time to get to work again! We need all the hands we can get!"
msgstr "Снова за работу! Нам нужны все свободные руки!"

#. ja: 今回はアバカス通りの、<br>「微細な瓦礫片」の清掃を行う！
#. de: Als Nächstes müssen wir die Allee des Abakus von den letzten Trümmerresten befreien!
#. fr: Bon, L'Abaque commence à ressembler à quelque chose... Maintenant, on s'attaque aux tas de fins débris qui restent<nbsp>!
msgctxt "NpcYell:10375:0:13"
msgid "Today, we're clearin' away the last little bits of debris that still clutter the Abacus!"
msgstr "Сегодня убираем последние мелкие обломки, что ещё захламляют улицу Счётов!"

#. ja: この仕事を丁寧に仕上げることで、<br>次の作業へも順調に移行できるはずだ！
#. de: Die gründliche Vorarbeit ist wichtig, um die Straße im nächsten Schritt gut pflastern zu können.
#. fr: Si vous travaillez sé<shy>rieu<shy>se<shy>ment pendant le prochain ouvrage collectif, la suite n'en sera que plus facile<nbsp>!
msgctxt "NpcYell:10376:0:13"
msgid "The more thorough we are today, the more work we'll save ourselves in the next stage─so no slackin'!"
msgstr "Чем тщательнее мы поработаем сегодня, тем меньше хлопот будет потом. Так что не ленимся!"

#. ja: 職人のおかげで、充分な資材が揃った！<br>さあ、復興共同作業を開始するぞ！
#. de: Dank euch haben wir genug Materialien auf Lager. Das nächste Gemeinschaftsprojekt kann beginnen!
#. fr: Une fois encore, on a reçu une tonz de dons<nbsp>! Je compte sur vous pour ne pas les gâcher, au boulot<nbsp>!
msgctxt "NpcYell:10377:0:13"
msgid "Thanks to our artisans, we're fully stocked with supplies. Now let's get to work!"
msgstr "Благодаря нашим мастерам у нас полно материалов. Ну что, за работу!"

#. ja: アバカス通りの舗装のため、<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Holt euch das Material, das ihr braucht, und macht euch ans Werk!
#. fr: Pour le prochain ouvrage collectif, on va refaire une petite beauté à L'Abaque. Mes amis, à vos outils<nbsp>!
msgctxt "NpcYell:10378:0:13"
msgid "It's time to pave the Abacus! Grab yourselves some supplies and get to it!"
msgstr "Пора мостить улицу Счётов! Берите материалы и принимайтесь за дело!"

#. ja: 階段が多い分、<br>歩きやすいように舗装してほしいッ！
#. de: Die vielen Treppen sind eine Heraus<shy>forde<shy>rung, aber ihr schafft das!
#. fr: Bon les gars, y a pas mal de dénivelé dans le coin, donc soyez prudents pendant le prochain ouvrage collectif<nbsp>!
msgctxt "NpcYell:10379:0:13"
msgid "With all these stairwells, it's not going to be easy─so watch your step!"
msgstr "Лестниц тут полно, работа будет непростая. Смотрите под ноги!"

#. ja: アバカス通りの復興共同作業は、<br>今回で大詰めだ！
#. de: Nun können wir die Arbeiten auf der Allee des Abakus abschließen!
#. fr: Encore un petit effort, on entre dans la dernière ligne droite pour L'Abaque<nbsp>!
msgctxt "NpcYell:10380:0:13"
msgid "This is it, everyone! With just a bit more effort, we'll at long last be finishin' our work on the Abacus!"
msgstr "Ну вот, друзья! Ещё немного усилий — и наконец-то закончим работы на улице Счётов!"

#. ja: 通路に装飾を施すため、<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Schnappt euch das Material von den Stapeln und macht euch an die Verzierungen!
#. fr: Allez, on va décorer tout ça vite fait, bien fait<nbsp>! À vos piles de matériaux<nbsp>!
msgctxt "NpcYell:10381:0:13"
msgid "Help yourself to any materials, and let the pavin' begin!"
msgstr "Берите материалы и начинайте укладывать покрытие!"

#. ja: 職人たちの技術を、<br>遺憾なく発揮してほしいッ！
#. de: Zeigt, was ihr könnt!
#. fr: Avis à tous les artisans d'Azurée<nbsp>! Au prochain ouvrage collectif, montrez-moi ce que vous avez dans le ventre<nbsp>!
msgctxt "NpcYell:10382:0:13"
msgid "Artisans of Ishgard, I want to see everythin' you've got!"
msgstr "Мастера Ишгарда, покажите всё, на что способны!"

#. ja: 今回の復興共同作業から、<br>ホアフロスト官舎の整備だ！
#. de: Als Nächstes bringen wir das Raureif-Refugium auf Vordermann!
#. fr: Chers collaborateurs artisans, à partir de maintenant, on commence à travailler sur la Retraite de Givreglacé<nbsp>!
msgctxt "NpcYell:10383:0:13"
msgid "Today's task is fixin' up the residence hall we call the Hoarfrost. All together, now!"
msgstr "Сегодня займёмся обустройством жилого дома «Иней». Все вместе!"

#. ja: 「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Die Materialstapel stehen bereit. An die Arbeit!
#. fr: Je sais que je radote, mais c'est l'heure de l'ouvrage collectif. Et qui dit ouvrage collectif dit... piles de matériaux<nbsp>!
msgctxt "NpcYell:10384:0:13"
msgid "You know where to find the supplies, and you know what to do with 'em! Now look alive!"
msgstr "Вы знаете, где взять материалы, и знаете, что с ними делать. Ну, живее!"

#. ja: ホアフロスト官舎は大がかりな建物だ！<br>足場を組むぞ！
#. de: Das Raureif-Refugium wird ein riesiges Gebäude. Dafür brauchen wir ein stabiles Gerüst!
#. fr: La Retraite de Givreglacé, c'est pas la maisonnette du coin. On va avoir besoin d'échafaudages, et des grands<nbsp>!
msgctxt "NpcYell:10385:0:13"
msgid "The Hoarfrost is no humble little hovel. We're going to need a steady scaffold to do the job!"
msgstr "«Иней» — не какая-нибудь лачуга. Чтобы справиться с работой, нам нужны надёжные леса!"

#. ja: 前回に引き続き、<br>足場を組む復興共同作業を行うぞ！
#. de: Das Gerüst muss noch höher werden!
#. fr: Tout le monde travaille bien, c'est parfait<nbsp>! Allez, on continue avec des échafaudages pour la Retraite de Givreglacé<nbsp>!
msgctxt "NpcYell:10386:0:13"
msgid "Today we're goin' to continue work on the scaffold for the Hoarfrost!"
msgstr "Сегодня продолжим возводить леса для «Инея»!"

#. ja: 「物資集積場」から物資を取って、作業を始めてほしい！
#. de: Das Material liegt bereit. Frohes Schaffen, Leute!
#. fr: Il y a beaucoup à faire à la Retraite de Givreglacé, donc c'est pas le moment de lambiner. À vos piles de matériaux<nbsp>!
msgctxt "NpcYell:10387:0:13"
msgid "Take all the materials you need, and let's get to work!"
msgstr "Берите все необходимые материалы и принимайтесь за дело!"

#. ja: ホアフロスト官舎建設のため、<br>高いところまで足場を組んでくれ！
#. de: Um das Raureif-Refugium zu bauen, muss das Gerüst bis ganz nach oben reichen.
#. fr: Je veux des échafaudages si hauts qu'ils dis<shy>pa<shy>rais<shy>sent dans le ciel<nbsp>! À vous de jouer, les gars<nbsp>!
msgctxt "NpcYell:10388:0:13"
msgid "To scale the heights of the Hoarfrost, our scaffold must reach to the sky!"
msgstr "Чтобы возвести «Иней», нам нужны леса до самого неба!"

#. ja: ホアフロスト官舎の周囲から、整備を行う！<br>皆、復興共同作業に参加してくれ！
#. de: Wir beginnen mit den Arbeiten um das Raureif-Refugium herum. Packt alle mit an!
#. fr: Je vous promets que vous serez fiers de vous quand la Retraite de Givreglacé sera terminée. Encore quelques efforts<nbsp>!
msgctxt "NpcYell:10389:0:13"
msgid "I promise you're going to be damned proud of yourself when the Hoarfrost stands in full glory!"
msgstr "Обещаю, вы будете гордиться собой, когда «Иней» предстанет во всём великолепии!"

#. ja: 「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Auf die Plätze, fertig, los!
#. fr: Courage, mes amis, la fin est proche<nbsp>! Allez donc régler leur compte à ces nouvelles piles de matériaux<nbsp>!
msgctxt "NpcYell:10390:0:13"
msgid "Help yourself to all the materials you need, and don't let up until the work is done!"
msgstr "Берите все нужные материалы и работайте, пока не закончите!"

#. ja: 職人たちの憩いの場は、<br>俺たち自身で造りあげるんだッ！
#. de: Wir kümmern uns um den Rastplatz für die Handwerker.
#. fr: Chers artisans, dites-vous que vous travaillez pour votre futur foyer<nbsp>! Courage, on y est presque<nbsp>!
msgctxt "NpcYell:10391:0:13"
msgid "Remember, the building you're workin' on just may be your future home!"
msgstr "Помните, в здании, над которым вы работаете, однажды, может, будете жить вы сами!"

#. ja: 今期の復興共同作業は最後になる！<br>立派な官舎をおっ建てるぞッ！
#. de: Das letzte Gemeinschaftsprojekt steht an. Legt euch ins Zeug!
#. fr: Allez allez, encore quelques coups de marteaux<nbsp>! La Retraite de Givreglacé est presque achevée<nbsp>!
msgctxt "NpcYell:10392:0:13"
msgid "This marks the culmination of all our efforts! Now let's build a residence that'll be the envy of the realm!"
msgstr "Это венец всех наших трудов! Построим жилой дом, которому позавидует весь мир!"

#. ja: ホアフロスト官舎を完成させよう！<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Bald ist es vollbracht! Material für das Raureif-Refugium liegt genug bereit.
#. fr: Tout le monde, écoutez-moi<nbsp>! La Retraite de Givreglacé est quasiment terminée, alors c'est le moment de donner tout ce que vous avez<nbsp>!
msgctxt "NpcYell:10393:0:13"
msgid "We're this close to finishin' work on the Hoarfrost! This is no time to slack off!"
msgstr "До завершения работ в «Инее» рукой подать! Сейчас не время бездельничать!"

#. ja: 職人たちの力、見せつけてやろうぜ！
#. de: Zeigt, zu was Handwerker von eurem Schlag imstande sind!
#. fr: Artisanes, artisans, c'est le grand final<nbsp>! Un dernier effort pour la Retraite de Givreglacé<nbsp>!
msgctxt "NpcYell:10394:0:13"
msgid "Hear me, artisans? It's time to put the final touches on your masterwork!"
msgstr "Слушайте, мастера! Пора довести ваше творение до совершенства!"

#. ja: くっ…！
#. de: Argh ...
#. fr: Urgh...
msgctxt "NpcYell:10395:0:13"
msgid "Ugh!"
msgstr "Ух!"

#. ja: 解放者殿…<br>どうか力を…！
#. de: Steh uns bei, <if $gn4>Befreierin<else>Befreier</if>!
#. fr: Vous<nbsp>! J'ai besoin de votre aide<nbsp>!
msgctxt "NpcYell:10396:0:13"
msgid "Got a moment?"
msgstr "Есть минутка?"

#. ja: 今度こそ、デッかい戦果を挙げてやるッ！<br>ダルマスカから連れてきた、コイツでなッ！
#. de: Wollt ihr mal sehen, was ich aus Dalmasca mitgebracht habe?
#. fr: Bouahaha<nbsp>!!! Visez-moi ces magnifiques chocobos importés de Dalmasca<nbsp>! Je compte sur eux pour m'offrir une éclatante victoire<nbsp>!
msgctxt "NpcYell:10397:0:13"
msgid "Don't underestimate chocobos! Especially these red ones all the way from Dalmasca!"
msgstr "Не стоит недооценивать чокобо! Особенно этих красных, привезённых из Далмаски!"

#. ja: クエッ、クエッ、クエーッ！
#. de: Kweh, kweh, kweh!
#. fr: Kwé, kwé, kwééé<nbsp>!
msgctxt "NpcYell:10398:0:13"
msgid "Kweh! Kweh! Kweh!"
msgstr "Куэ! Куэ! Куэ!"

#. ja: なかなか、しぶとい戦いぶりじゃないかッ！<br>いいぜ、気に入ったッ！
#. de: Die geben nicht nach. Gut, dann machen wir ernst!
#. fr: Dis donc, toi... c'est que t'as des tripes<nbsp>!
msgctxt "NpcYell:10399:0:13"
msgid "Ha! I'd thought you'd be dead by now! You're stronger than you look!"
msgstr "Ха! Я уж думал, ты давно помер! А ты крепче, чем кажешься!"

#. ja: オレの部隊に来ないかッ！？<br>旨い肉も、たーんと食わせてやるぜッ？
#. de: Komm zu uns! Wir geben dir auch was Feines zu fressen!
#. fr: Ça te dirait de rejoindre mon unité<nbsp>? Tu pourrais déguster de la viande juteuse à tous les repas<nbsp>!
msgctxt "NpcYell:10400:0:13"
msgid "Why not leave the Resistance and join me instead? Pays well and the grub ain't bad either!"
msgstr "Бросай Сопротивление и переходи ко мне! Плачу хорошо, да и кормят неплохо!"

#. ja: 解放者殿に言っているのか……？<br>戦闘中に勧誘とは、フザけた奴め……！
#. de: Wen meint er, <if $gn4>die Befreierin<else>den Befreier</if>? Das soll wohl ein Witz sein.
#. fr: Je rêve, il essaye de corrompre <if $gn4>la grande libératrice<else>le grand libérateur</if><nbsp>! En plein af<shy>fron<shy>te<shy>ment<nbsp>!
msgctxt "NpcYell:10401:0:13"
msgid "You'd try recruiting your enemy in the middle of a battle!? Unbelievable!"
msgstr "Ты что, врага посреди боя вербовать вздумал!? Да ты совсем спятил!"

#. ja: クエェーーーーッ！！
#. de: KWEEEH!!! KWEEEH!!!
#. fr: Kwéééééé<nbsp>!!
msgctxt "NpcYell:10402:0:13"
msgid "Kweeeh!"
msgstr "Кви-и-и-и!"

#. ja: どおどお！　ええい、この暴れん坊めッ……！<br>だからこそ、可愛いんだけどなッ！
#. de: So ist's gut, mein Lieber. Immer schön aggro.
#. fr: De vraies terreurs, ces chocobos rouges<nbsp>! C'est ce qui les rend si attachants<nbsp>!
msgctxt "NpcYell:10403:0:13"
msgid "And why not? No use in me recruiting you after you're dead!"
msgstr "А почему бы и нет? Мёртвого тебя мне всё равно не завербовать!"

#. ja: グエエエッーーーーーー！！
#. de: KWEEEEEH!!!
#. fr: Kwéééééééé<nbsp>!
msgctxt "NpcYell:10404:0:13"
msgid "Kweeeeeeh!"
msgstr "Кви-и-и-и-и-и!"

#. ja: ン……なんだ……<br>こんなデカい赤チョコボ、誰か連れてきたか……？
#. de: Wer hat denn diesen Riesenchocobo mitgebracht?
#. fr: Euh... D'où il sort, cet énorme chocobo<nbsp>?
msgctxt "NpcYell:10405:0:13"
msgid "Where did that massive chocobo come from!?"
msgstr "Откуда тут взялся такой громадный чокобо?!"

#. ja: な、なんじゃこりゃー！？<br>ヤバイ、ヤバイ、逃げろ、逃げろ、撤退だッー！
#. de: Was für ein Ungeheuer! Dieser Schnabel! Diese Krallen! Rennt!
#. fr: J-j'aime pas ça, moi<nbsp>! Sauve qui peut<nbsp>!
msgctxt "NpcYell:10406:0:13"
msgid "Erk! Better run to fight another day!"
msgstr "Ой! Лучше унесём ноги, пока целы!"

#. ja: まるで、紅い彗……に、逃げろ……！
#. de: Der ist ja wirklich so ungestüm wie ein feuerroter Komet! Nichts wie weg!
#. fr: Choco-météore en approche<nbsp>! Tous aux abris<nbsp>!
msgctxt "NpcYell:10407:0:13"
msgid "It's like the fall of Dalamud all over again! Run for it!"
msgstr "Прямо как при падении Даламуда! Спасайтесь!"

#. ja: ダメだ、これ以上は持ちこたえられない……！<br>総員、撤退を……！
#. de: Das schaffen wir nicht. Alle Mann, Rückzug!
#. fr: On ne tiendra pas longtemps à ce rythme... Replions-nous<nbsp>!
msgctxt "NpcYell:10408:0:13"
msgid "To think it would come to this... Withdraw!"
msgstr "Ну и дела... Отступаем!"

#. ja: グハハハハ！<br>どうだ、見たか、オレたちの実力をッ！
#. de: Muahaha! Seht nur, wie sie rennen! Uns kann keiner was!
#. fr: Bouahahaha<nbsp>!!! Mes chocobos vous ont bien picoré la face<nbsp>!
msgctxt "NpcYell:10409:0:13"
msgid "Hmph! Not so tough after all!"
msgstr "Хм! Не такие уж вы и крутые!"

#. ja: クエッ、クエッ、クエーッ！
#. de: Kweeeh! KWEEEH! KWEEEH!!!
#. fr: Kwé, kwé, kwééé<nbsp>!
msgctxt "NpcYell:10410:0:13"
msgid "Kweh! Kweh! Kweeeh!"
msgstr "Кве! Кве! Кви-и-и!"

#. ja: ふむ、自律歩行機能は問題ないようだ……。<br>次は、装甲防御力の検証に入れ。
#. de: Das autonome Gehen funktioniert tadellos. Testen wir mal die Panzerung.
#. fr: Aucun problème à déplorer du côté des fonctions motrices autonomes. Passons au test de résistance à présent...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10411:0:13"
msgid "Basic motor function checks complete.<br>Now for the defensive mechanisms."
msgstr "Проверка основных двигательных функций завершена.<br>Теперь проверим защитные механизмы."

#. ja: ふん……レジスタンスどもが嗅ぎつけたか……<br>丁度いい、実戦テストに協力してもらうとしよう。
#. de: Die paar Widerstandskämpfer kommen gerade richtig. Sie werden mir bei dem Test behilflich sein.
#. fr: Ah, les rats sont de sortie, on dirait. Très bien, j'avais justement besoin de cobayes.
msgctxt "NpcYell:10412:0:13"
msgid "I knew those Bozjan churls would arrive sooner or later."
msgstr "Я знал, что эти боцжанские отребья рано или поздно объявятся."

#. ja: チッ……この程度の戦闘で、継戦不能になるとは……<br>だが、貴重なデータの供出に感謝するぞ、さらばだ……！
#. de: Unter diesen Bedingungen lässt die Kampffähigkeit noch zu wünschen übrig. Aber ich habe wertvolle Erkenntnisse gesammelt.
#. fr: Tch... Voilà qui est décevant. Enfin, ce n'est pas grave... Merci pour votre coopération, amis rebelles, et à la prochaine fois<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10413:0:13"
msgid "My creation has performed below expectations.<br>Your assistance was most welcome, Bozjans. Until next time!"
msgstr "Моё творение показало себя хуже, чем я ожидал.<br>Боцжанцы, благодарю за помощь. До встречи!"

#. ja: チッ……逃したか……。<br>だが、実戦テストの結果は良好……生産ラインを整えなければな！
#. de: Wo rennen meine Testhelfer denn hin? Egal, der Test war ein Erfolg. Zeit, zur Massenproduktion überzugehen.
#. fr: Tsk, ils s'enfuient comme les rats qu'ils sont... Enfin, les tests sont concluants. Prochaine étape<nbsp>: produire ces modèles à la chaîne<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10414:0:13"
msgid "They hardly seem worth killing.<br>Perhaps next time, they will put up more of a fight."
msgstr "Убивать их — пустая трата времени.<br>Может, в следующий раз они окажут сопротивление."

#. ja: 任務完了だ！<br>協力に感謝する！
#. de: Mission erfüllt. Danke für die Unterstützung.
#. fr: Mission accomplie<nbsp>! Merci du coup de main<nbsp>!
msgctxt "NpcYell:10415:0:13"
msgid "Haha! Excellent work, my friend!"
msgstr "Ха-ха! Отлично сработано, друг!"

#. ja: これ以上は無理か…<br>撤退するッ！
#. de: Wir schaffen es nicht. Zurück zur Gemarkung!
#. fr: Cette mission est un échec... Sauvons-nous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10416:0:13"
msgid "Nope, bugger this.<br>Time to run!"
msgstr "Хватит с меня.<br>Пора уносить ноги!"

#. ja: 敵部隊を発見！<br>魔獣大隊と思われますッ！
#. de: Feindliche Einheit gesichtet! \<schluck> ... Wahrscheinlich ist es der Bestientrupp.
#. fr: Des troupes impériales<nbsp>! C'est la cohorte bestiale<nbsp>!
msgctxt "NpcYell:10417:0:13"
msgid "The enemy is here, and they've brought their pets!"
msgstr "Враг здесь, и они привели своих зверушек!"

#. ja: ほう、魔獣使いか…<br>我が相手をしてやろう！
#. de: Bestienbändiger? Gut, sollen nur kommen.
#. fr: Des dresseurs, hein... Qu'ils viennent, je les attends de pied ferme<nbsp>!
msgctxt "NpcYell:10418:0:13"
msgid "Let them come. My flames will consume them all!"
msgstr "Пусть идут. Мои языки пламени поглотят их всех!"

#. ja: ライアン様ぁ！<br>勝利を捧げますぅぅ！
#. de: König der Bestien! Wir geben unsere Leben für den Sieg!
#. fr: Seigneur Lyon, c'est pour vous que je me bats<nbsp>!
msgctxt "NpcYell:10419:0:13"
msgid "My beasts will sup on your flesh!"
msgstr "Мои звери пожрут вашу плоть!"

#. ja: 先に魔獣使いの男を<br>狙い討つぞッ！
#. de: Knöpft euch zuerst den Bestienbändiger vor!
#. fr: Tuez les maîtres en priorité<nbsp>!
msgctxt "NpcYell:10420:0:13"
msgid "Without their master, they will fall into disarray!"
msgstr "Сначала прикончим укротителя!"

#. ja: ハッ！
#. de: Jawohl!
#. fr: Hah<nbsp>!
msgctxt "NpcYell:10421:0:13"
msgid "Take this!"
msgstr "Получай!"

#. ja: ライアン様ぁ～！<br>申し訳ございませぬぅぅ！
#. de: König der Bestien, bitte verzeiht ...
#. fr: Pardon, Seigneur Lyon<nbsp>! Je n'ai pas été à la hauteur...
msgctxt "NpcYell:10422:0:13"
msgid "Lyon will never forgive me!"
msgstr "Лион меня не простит!"

#. ja: 我らの勝利ぞッ！
#. de: Ha! Wir haben gewonnen!
#. fr: La victoire est à nous<nbsp>!
msgctxt "NpcYell:10423:0:13"
msgid "And let that be a lesson, you curs!"
msgstr "Вот вам урок, мерзавцы!"

#. ja: ライアン様ぁ！<br>この勝利を捧げますぅぅ！
#. de: König der Bestien! Dieser Sieg gehört Euch!
#. fr: Seigneur Lyon, je vous dédie cette victoire<nbsp>!
msgctxt "NpcYell:10424:0:13"
msgid "Like lambs to the slaughter!"
msgstr "Как ягнята на убой!"

#. ja: 侮りすぎたか…<br>撤退するッ…！
#. de: Es ist bitter, aber ... wir müssen uns neu formieren.
#. fr: L'ennemi est plus puissant que prévu, replions-nous<nbsp>!
msgctxt "NpcYell:10425:0:13"
msgid "We must regroup!"
msgstr "Надо перегруппироваться!"

#. ja: 歯ごたえのないこと…
#. de: Ich bin umgeben von Pöbel ...
#. fr: C'est vraiment trop facile.
msgctxt "NpcYell:10426:0:13"
msgid "I doubt they'll offer much sport."
msgstr "Сомневаюсь, что с ними будет весело."

#. ja: この近辺にあるはずだ！探せ…！
#. de: Sucht! Sie müssen hier irgendwo sein.
#. fr: C'est forcément par ici<nbsp>! Continuez de chercher<nbsp>!
msgctxt "NpcYell:10427:0:13"
msgid "It must be here. Keep looking!"
msgstr "Он должен быть где-то здесь. Продолжайте искать!"

#. ja: 周囲の警戒を怠るなよ…！
#. de: Haltet Augen und Ohren offen!
#. fr: Je garde un œil sur les environs<nbsp>!
msgctxt "NpcYell:10428:0:13"
msgid "Watch out for Bozjans. We can't let them interfere!"
msgstr "Смотрите в оба, боцжанцы могут помешать!"

#. ja: 了解…
#. de: Habe verstanden.
#. fr: Ordre reçu.
msgctxt "NpcYell:10429:0:13"
msgid "Understood..."
msgstr "Понял..."

#. ja: 指令確認…
#. de: Befehl erhalten.
#. fr: En attente d'in<shy>struc<shy>tions.
msgctxt "NpcYell:10430:0:13"
msgid "Executing orders..."
msgstr "Приступаю к выполнению приказа..."

#. ja: 実験項目を確認…
#. de: Versuchsanordnung bestätigt.
#. fr: Sujet de test confirmé.
msgctxt "NpcYell:10431:0:13"
msgid "Test subject confirmed..."
msgstr "Подопытный подтверждён..."

#. ja: なんだガラクタ集めか！<br>俺サマも加勢するぜ～ッ！
#. de: Was ist denn hier los? Da will ich ja gleich mal mitmischen.
#. fr: Une mission de pillage<nbsp>? J'en suis<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10432:0:13"
msgid "That's our opponent!?<br>Doesn't look like much of a threat to me!"
msgstr "Это и есть наш противник!?<br>Да он и угрозы-то не представляет!"

#. ja: ハハハ！<br>これが俺サマの実力だッ～！
#. de: Haha! So macht das Spaß!
#. fr: Ha ha ha<nbsp>!!! J'adore nous faire gagner<nbsp>!
msgctxt "NpcYell:10433:0:13"
msgid "What did I say? We had them beaten from the outset!"
msgstr "Что я говорил? Мы с самого начала были сильнее!"

#. ja: 魔導兵器の破壊を確認！皆、よくやった！
#. de: Die Maschine ist zerstört. Gut gemacht, Leute!
#. fr: C'était le dernier. Beau travail, les gars<nbsp>!
msgctxt "NpcYell:10434:0:13"
msgid "So much for the power of magitek, eh?"
msgstr "Ну и где теперь ваша магитехника?"

#. ja: 踏み潰す！
#. de: In den Dreck mit dir!
#. fr: On va t'aplatir, ja !
msgctxt "NpcYell:10435:0:13"
msgid "I'll grind you beneath my heel!"
msgstr "Я втопчу тебя в грязь!"

#. ja: このままでは…！総員、撤退を…！
#. de: Das wird heute nichts mehr. Alle Mann, zurück!
#. fr: Ça se présente mal<nbsp>! On se replie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10436:0:13"
msgid "This isn't my idea of a fair fight.<br>Time to call it a day!"
msgstr "Не по мне такая нечестная схватка.<br>Пора закругляться!"

#. ja: 新兵器部材を集めて<br>持ってきてくれ！
#. de: Sammelt so viel ein, wie ihr finden könnt!
#. fr: Ramenez-moi le plus de pièces possible<nbsp>!
msgctxt "NpcYell:10437:0:13"
msgid "Bring me as many parts as you can!"
msgstr "Принесите мне как можно больше деталей!"

#. ja: ここは私に任せ皆は撤退をッ！
#. de: Das hier übernehme ich. Bringt ihr euch in Sicherheit.
#. fr: On prend le relais, repliez-vous<nbsp>!
msgctxt "NpcYell:10438:0:13"
msgid "Troops, fall back! We'll handle this."
msgstr "Отступайте! Мы тут сами разберёмся."

#. ja: 敵戦力を粉砕した！
#. de: Der Feind ist zerschmettert!
#. fr: On les a écrasés<nbsp>!
msgctxt "NpcYell:10439:0:13"
msgid "You'll have to do better than that, Bozjans!"
msgstr "С боцжанцами покончено!"

#. ja: よし、引き上げるぞ！
#. de: Sammelt die Überreste ein.
#. fr: Allons en informer le haut commandement<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10440:0:13"
msgid "That should put them in their place.<br>All right, everyone. Return to the castrum."
msgstr "Вот так-то!<br>Ладно, всем возвращаться в каструм."

#. ja: 闇の戦士殿…！？<br>いったい、どこから？
#. de: <if $gn4>Die Kriegerin der Dunkelheit<else>Der Krieger der Dunkelheit</if>! Ihr kommt zur rechten Zeit!
#. fr: <if $gn4>La Guerrière des Ténèbres<else>Le Guerrier des Ténèbres</if><nbsp>!? Mais d'où <if $gn4>elle<else>il</if> sort<nbsp>!?
msgctxt "NpcYell:10441:0:13"
msgid "Warrior of Darkness! Thank goodness you're here!"
msgstr "Воин Тьмы! Слава богам, вы здесь!"

#. ja: 謎の勢力と<br>交戦中なのであります！
#. de: Überall diese Geisterwesen! Kämpft, Kameraden! Kämpft für Norvrandt!
#. fr: Nous sommes aux prises avec ces espèces de fantômes. Ils sont apparus de nulle part<nbsp>!
msgctxt "NpcYell:10442:0:13"
msgid "These phantoms have been appearing out of thin air!"
msgstr "Эти призраки появляются из ниоткуда!"

#. ja: ここらでひとつ<br>強化させてもらうぜェ？
#. de: Hier, das muss verstärkt werden. Aber plötzlich!
#. fr: Alors, tu vas te battre sé<shy>rieu<shy>se<shy>ment<nbsp>?
msgctxt "NpcYell:10443:0:13"
msgid "Time to get serious."
msgstr "Пора показать, на что я способен."

#. ja: オラオラ、逃げ惑えッ！
#. de: He, willst du dich etwa verpissen?
#. fr: Non, non... Tu n'as nulle part où fuir<nbsp>!
msgctxt "NpcYell:10444:0:13"
msgid "Nowhere to hide!"
msgstr "Бежать некуда!"

#. ja: そォら！<br>足元注意ってなァ！
#. de: Pass doch auf, wo du hintrittst!
#. fr: Hé<nbsp>! Attention où tu mets les pieds<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10445:0:13"
msgid "If there's one thing being a beastmaster has taught me,<br>it's to watch where you step."
msgstr "Если я чему и научился у укротителей, так это смотреть под ноги."

#. ja: この一撃…<br>耐えてみせろやァ！
#. de: Jetzt seht ihr gleich euer Blut spritzen!
#. fr: Essaye donc de résister à ça<nbsp>!
msgctxt "NpcYell:10446:0:13"
msgid "Let's see how resilient you really are!"
msgstr "Ну-ка посмотрим, насколько ты крепок!"

#. ja: いいですとも！
#. de: Da wären wir.
#. fr: Compris<nbsp>!
msgctxt "NpcYell:10447:0:13"
msgid "Understood!"
msgstr "Понял!"

#. ja: いよぉ、レジスタンスども！<br>ふたつの選択肢をくれてやろうじゃないかッ！
#. de: Widerständler! Ihr habt die Wahl.
#. fr: Hé les rebelles<nbsp>! Vous avez deux options.
msgctxt "NpcYell:10448:0:13"
msgid "All right, Bozjans. You've got two options."
msgstr "Ну что, боцжанцы. У вас есть два варианта."

#. ja: ここで無駄死にするか、おとなしく降伏するか……<br>とっとと選びやがれッ！
#. de: Entweder ihr ergebt euch oder sterbt einen unnützen Tod. Entscheidet euch!
#. fr: Soit vous vous rendez bien gentiment, soit vous repartez les pieds devant. À vous de voir<nbsp>!
msgctxt "NpcYell:10449:0:13"
msgid "Die facedown in the dirt, or surrender!"
msgstr "Либо сдохнуть здесь, либо сдаться! Выбирайте!"

#. ja: 降伏しろッ！
#. de: Ergebt euch!
#. fr: Vous feriez mieux de rendre les armes<nbsp>!
msgctxt "NpcYell:10450:0:13"
msgid "I say we kill 'em!"
msgstr "Предлагаю их перебить!"

#. ja: グハハハハ！　解放者よ！<br>なかなかの暴れぶりのようじゃないかッ！
#. de: Muahaha! Spielt ihr immer noch Krieg?
#. fr: Hé, mon <if $gn4>amie<else>ami</if><nbsp>! Comme on se retrouve<nbsp>! Toujours aussi balèze à ce que je vois<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:10451:0:13"
msgid "You make this look easy, <split \" \" 1><string $gs1></split>!"
msgstr "Ловко у тебя это выходит, <split \" \" 1><string $gs1></split>!"

#. ja: だからなぁ、あらためて聞いてやるッ！<br>オレのところで働く気はないかッ？
#. de: Hört mal her, ich mache euch ein Angebot. Wollt ihr nicht für mich arbeiten?
#. fr: Tu ne veux toujours pas servir sous mes ordres<nbsp>? Ma proposition tient toujours, tu sais.
msgctxt "NpcYell:10452:0:13"
msgid "I could use someone like you! Why not join me?"
msgstr "Мне бы такой человек пригодился! Переходи ко мне!"

#. ja: 解放者殿の勧誘…<br>本気なのか！？
#. de: Das kann nicht sein Ernst sein.
#. fr: <if $gn4>La grande libératrice<else>Le grand libérateur</if> est bien là où <if $gn4>elle<else>il</if> est<nbsp>!
#. macro: <if $gn4>She<else>He</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $gn4>her<else>his</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:10453:0:13"
msgid "<if $gn4>She<else>He</if> would never throw in <if $gn4>her<else>his</if> lot with the likes of you!"
msgstr "<if $gn4>Она<else>Он</if> ни за что не станет с тобой связываться!"

#. ja: オウ、オウ、ウチの力自慢を倒すとは、<br>ますます気に入ったぞッ！
#. de: Kommt! Ihr müsst nur euren Stolz überwinden!
#. fr: Waouh<nbsp>! C'était mon plus puissant bestiau... Décidément, tu me plais de plus en plus<nbsp>!
msgctxt "NpcYell:10454:0:13"
msgid "Impressive! That was no mean feat!"
msgstr "Впечатляет! Это было непросто!"

#. ja: 仲間になれッ！
#. de: Verbündet euch mit uns!
#. fr: Rejoignez-nous<nbsp>!
msgctxt "NpcYell:10455:0:13"
msgid "Join us!"
msgstr "Присоединяйся к нам!"

#. ja: 肉もらえるぞッ！
#. de: Bei uns gibt's immer lecker zu essen!
#. fr: On a de la bonne viande pour vous<nbsp>!
msgctxt "NpcYell:10456:0:13"
msgid "I'll even give you the choicest cuts of meat!"
msgstr "Буду кормить тебя отборным мясом!"

#. ja: どはッ……なんてキツい一撃だッ……！<br>やっぱり、オレの目に狂いはなかったぜッ……！
#. de: Autsch, das hat weh getan. Wusste ich's doch, dass du was drauf hast.
#. fr: Ugh<nbsp>! H-hé hé, joli coup... Je savais bien que tu avais de la poigne<nbsp>!
msgctxt "NpcYell:10457:0:13"
msgid "Oof! Seems I was right about you!"
msgstr "Уф! Я знал, что в тебе есть сила!"

#. ja: ええい、ここまでかッ！<br>だけどな、オレはまだ諦めてないぞ、解放者ッ！
#. de: Also gut, das war's für heute. Aber ich bin noch nicht am Ende.
#. fr: Bon, ce sera pas pour cette fois apparemment... mais je finirai bien par te convaincre<nbsp>!
msgctxt "NpcYell:10458:0:13"
msgid "I'll win you over, just you see!"
msgstr "Я всё равно тебя переманю, вот увидишь!"

#. ja: 厄介な奴に<br>惚れられたものですな…
#. de: Es ist eine Wohltat, gegen diesen Typen zu gewinnen.
#. fr: Vous lui avez tapé dans l'œil, on dirait...
msgctxt "NpcYell:10459:0:13"
msgid "A brute he may be, but he knows talent when he sees it!"
msgstr "Грубый он, конечно, но талант сразу разглядел!"

#. ja: これ以上は危険です……！<br>みなさん、撤退を……！
#. de: Es wird zu gefährlich. Bringen wir uns in Sicherheit.
#. fr: Ça devient critique<nbsp>! On ferait mieux de se replier<nbsp>!
msgctxt "NpcYell:10460:0:13"
msgid "We can't afford to be waylaid here any longer. Withdraw!"
msgstr "Здесь оставаться опасно... Отступаем!"

#. ja: グハハハハ！　どうだオレたちの強さッ！<br>解放者、いつでも席を用意して待ってるからなッ！
#. de: Muahaha! Habt ihr noch nicht genug? Mein Angebot gilt übrigens immer noch.
#. fr: Bouhahaha<nbsp>! Allez, <if $gn4>mon amie<else>mon ami</if>, rejoins le camp des vainqueurs<nbsp>!
msgctxt "NpcYell:10461:0:13"
msgid "Ha! We'll let you go for now, but one of these days, you'll fight under my banner!"
msgstr "Ха! На этот раз отпущу вас, но однажды ты будешь сражаться под моим знаменем!"

#. ja: 歓迎するぞッ！
#. de: Kommt zu uns!
#. fr: Allez viens, on est bien<nbsp>!
msgctxt "NpcYell:10462:0:13"
msgid "I'll be waiting!"
msgstr "Буду ждать!"

#. ja: 肉もらえるぞッ！
#. de: Bei uns gibt's jeden Tag Braten mit Soße!
#. fr: Viande à tous les repas<nbsp>!
msgctxt "NpcYell:10463:0:13"
msgid "You won't regret it!"
msgstr "Не пожалеешь!"

#. ja: 協力に感謝する！<br>護衛を頼んだぞ！
#. de: Danke. Viel Erfolg bei der Eskorte.
#. fr: Parfait, je vous la confie, ainsi que le cheval. Bon courage<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10464:0:13"
msgid "You're too kind!<br>I'll leave her and the...horse thing...in your care!"
msgstr "Какая доброта! Поручаю её и эту... лошадь... тебе!"

#. ja: クッ……もう追いつかれたの……！？<br>わ、私も戦います……この子を守ってみせるんだから！
#. de: Was läufst du mir hinterher? Ich kann alleine auf mich aufpassen. Auf mich und meinen Liebling.
#. fr: Oh non, ils m'ont retrouvée<nbsp>! S-si c'est le monocéros qu'ils veulent, ils devront me passer sur le corrrps<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10465:0:13"
msgid "They have found us, it seems.<br>I shall do my part to protect the monoceros!"
msgstr "Кажется, они нас нашли.<br>Я тоже буду защищать монокероса!"

#. ja: モノセロスと脱走兵を発見した！<br>奴らを渡すな、処分の許可は下りているッ！
#. de: Da ist die Fahnenflüchtige und ihr Monozeros! Lasst sie nicht entkommen.
#. fr: Là voilà, la déserteuse qui a enlevé l'un de nos sujets d'étude<nbsp>! Ne retenez pas vos coups, nous avons permission de l'exécuter<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10466:0:13"
msgid "There's the unicorn, and the traitor to boot!<br>We need the beast alive, which is more than can be said for the girl!"
msgstr "Вон единорог, и предательница с ним!<br>Зверь нужен нам живым. А вот девчонку можно убить!"

#. ja: 裏切り者がッ！
#. de: Dreckige Verräterin!
#. fr: La sale traîtresse<nbsp>!
msgctxt "NpcYell:10467:0:13"
msgid "We'll show you what happens to deserters!"
msgstr "Покажем тебе, чем кончается дезертирство!"

#. ja: 逃がすものか！
#. de: Wolltest dich wohl davonmachen!
#. fr: Elle croyait nous échapper<nbsp>!
msgctxt "NpcYell:10468:0:13"
msgid "You thought you could get away, did you?"
msgstr "Думала, что сбежишь?"

#. ja: 了解！<br>攻撃を開始する！
#. de: Zu Befehl! Wir greifen an!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:10469:0:13"
msgid "Commencing attack!"
msgstr "Начинаю атаку!"

#. ja: ヒィーン！
#. de: Wieher!
#. fr: Hiiiiih<nbsp>!
msgctxt "NpcYell:10470:0:13"
msgid "Neigh!"
msgstr "И-го-го!"

#. ja: 嗚呼、よかった、まだ馬肉にはなっていないわよね？<br>ブリリアントな仔馬ちゃん、いただきにきたわよ！
#. de: Ich bin so froh, dass es dir gut geht! Hast du mich vermisst?
#. fr: Ouf, le spécimen est en un seul morceau... Ne crains rien, mon petit poulain bigarré, ta nouvelle maîtresse est venue te chercher<nbsp>!
msgctxt "NpcYell:10471:0:13"
msgid "Oh, what's this? A beautiful specimen, fit for inclusion in my menagerie!"
msgstr "Ох, что это у нас? Прекрасный экземпляр для моей коллекции!"

#. ja: クラリシー！<br>あなたには渡さないッ！
#. de: Nein, Clarricie, lass die Hände von ihr!
#. fr: Clarricie... Ne t'avise pas de poser tes sales pattes surrr lui<nbsp>!
msgctxt "NpcYell:10472:0:13"
msgid "No! You keep your hands off of him, Clarricie!"
msgstr "Нет! Не смей трогать его, Кларрисия!"

#. ja: 追えッ！
#. de: Hinterher!
#. fr: Il nous faut le spécimen<nbsp>!
msgctxt "NpcYell:10473:0:13"
msgid "Don't let them escape!"
msgstr "Не дайте им уйти!"

#. ja: 囚えろ！
#. de: Ergreift sie!
#. fr: Capturez-le<nbsp>!
msgctxt "NpcYell:10474:0:13"
msgid "Seize them!"
msgstr "Хватайте их!"

#. ja: 多少は傷つけても<br>大丈夫だ！
#. de: Die Anwendung von Gewalt bei der Ergreifung wurde ausdrücklich erlaubt.
#. fr: Amochez-le s'il le faut<nbsp>!
msgctxt "NpcYell:10475:0:13"
msgid "We need it alive, but don't be afraid to smack some sense into it!"
msgstr "Нам нужен он живым, но можете хорошенько его встряхнуть!"

#. ja: キュィーン！
#. de: Wiiieher!
#. fr: Huiiiiiih<nbsp>!
msgctxt "NpcYell:10476:0:13"
msgid "Neighhh!"
msgstr "И-го-го-о!"

#. ja: 薄汚い裏切り者が…！
#. de: Ich, eine dreckige Verräterin?
#. fr: Tsk... Cette félonne est bien entourée...
msgctxt "NpcYell:10477:0:13"
msgid "You lowly wretch! How dare you!"
msgstr "Ах ты жалкая дрянь! Как ты смеешь!"

#. ja: この屈辱…<br>忘れるものですか…！
#. de: Wer ist hier dreckig, frage ich.
#. fr: Vous me paierez cet affront<nbsp>!
msgctxt "NpcYell:10478:0:13"
msgid "I'll take this out of your hide!"
msgstr "Я заставлю тебя за это заплатить!"

#. ja: 追っ手は……振り払えたようですね……。<br>でも、なんだか嫌な気配がするような……！？
#. de: Die Verfolger hätten wir abgeschüttelt. Aber irgendwie habe ich ein ungutes Gefühl.
#. fr: On a réussi à les repousser. Mais j'ai comme un mauvais prrressentiment...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10479:0:13"
msgid "I think that's the last of them.<br>And yet... No, it must be my mind playing tricks on me."
msgstr "Кажется, мы оторвались от преследователей.<br>Но... Нет, наверное, мне просто мерещится."

#. ja: ともかく、モノセロスを守ることができました。<br>本当に、ありがとうございます……！
#. de: Hauptsache, meinem Liebling geht es gut. Danke!
#. fr: Au moins, le monocéros va bien. Merrrci infiniment, je ne m'en serais jamais sortie toute seule.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10480:0:13"
msgid "Above all, the monoceros is safe.<br>You have my sincerest thanks."
msgstr "Главное, что монокерос цел.<br>От всего сердца благодарю вас."

#. ja: ブル、ブルルルル…
#. de: \<schnaub>
#. fr: Hiiih<nbsp>! Hiiih<nbsp>!
msgctxt "NpcYell:10481:0:13"
msgid "\\<whinny>"
msgstr "\\<ржание>"

#. ja: も、もう……限界……あなただけでも……<br>逃げて、モノセロス……。
#. de: Ich kann nicht mehr ... Renn, mein Liebling, renn!
#. fr: C'est la fin... Je t'en prrrie... Fuis, monocéros...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10482:0:13"
msgid "It seems I'm done for...<br>Run, my dear monoceros! Save yourself!"
msgstr "Я больше не могу...<br>Беги, мой дорогой монокерос! Спасайся!"

#. ja: キュイイィィン！
#. de: Wieher!
#. fr: Hyuiiiiih<nbsp>!
msgctxt "NpcYell:10483:0:13"
msgid "Neighhh!"
msgstr "И-го-го-о!"

#. ja: 喰らえ！
#. de: Nimm das!
#. fr: Tiens<nbsp>!
msgctxt "NpcYell:10484:0:13"
msgid "Let's see how you like this!"
msgstr "Ну-ка, попробуй это!"

#. ja: 容赦しないッ！
#. de: Erwarte keine Gnade!
#. fr: Pas de pitié<nbsp>!
msgctxt "NpcYell:10485:0:13"
msgid "Your time is up!"
msgstr "Тебе конец!"

#. ja: ウラッ！
#. de: Hier, mit schönem Gruß von der IV.!
#. fr: Woooh<nbsp>!
msgctxt "NpcYell:10486:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: やっておしまい！
#. de: Bald ist aber Schluss!
#. fr: C'est fini pour toi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10487:0:13"
msgid "I want that unicorn!<br>Slaughter the rest!"
msgstr "Мне нужен единорог!<br>Остальных перебейте!"

#. ja: 目障りね！
#. de: Eine Beleidigung für meine Augen sind die.
#. fr: Pathétique<nbsp>!
msgctxt "NpcYell:10488:0:13"
msgid "Insolent cur!"
msgstr "Наглый пёс!"

#. ja: 守るって<br>約束したんだから！
#. de: Ich habe einen Schwur geleistet: Meine Kameraden zu beschützen!
#. fr: Je tiendrai ma prrromesse de te protéger<nbsp>!
msgctxt "NpcYell:10489:0:13"
msgid "I have made my choice!"
msgstr "Я сделала свой выбор!"

#. ja: ヒィーン！
#. de: Wiiieher!
#. fr: Hiiiiih<nbsp>!
msgctxt "NpcYell:10490:0:13"
msgid "Neigh!"
msgstr "И-го-го!"

#. ja: 肉もらえるぞッ！
#. de: Ich sag doch: Bei uns gibt's Braten!
#. fr: Y a bon miam miam<nbsp>!
msgctxt "NpcYell:10491:0:13"
msgid "Plenty of meat to go around!"
msgstr "Мяса на всех хватит!"

#. ja: ひ、人喰いザメだ！
#. de: Der allesfressende Haaaaaaai! \<kreisch>
#. fr: Un re-re... REQUIIIIIN<nbsp>!
msgctxt "NpcYell:10492:0:13"
msgid "It comes!"
msgstr "Оно идёт!"

#. ja: キャーッ！
#. de: Aaaaaaah!
#. fr: Aaaaah<nbsp>!
msgctxt "NpcYell:10493:0:13"
msgid "Aaah!"
msgstr "А-а-а!"

#. ja: 逃げろー！
#. de: Rennt! Reeennt!
#. fr: Au secours<nbsp>!
msgctxt "NpcYell:10494:0:13"
msgid "Run! Faster!"
msgstr "Бегите! Живее!"

#. ja: こっちに来ないで！
#. de: Nein, er kommt direkt auf uns zu!
#. fr: Va t'en, sale monstre<nbsp>!
msgctxt "NpcYell:10495:0:13"
msgid "Stay away! Away I say!"
msgstr "Не подходи! Не подходи, говорю!"

#. ja: 誰か、助けてー！
#. de: Zu Hilfeee!
#. fr: Aidez-moi, je vous en prie<nbsp>!
msgctxt "NpcYell:10496:0:13"
msgid "Someone, help!"
msgstr "Кто-нибудь, помогите!"

#. ja: ムッ……あれは、まさか噂の人喰いザメか！？<br>皆、逃げるんだ、はやく逃げろッ！
#. de: Ist das wirklich der gefürchtete Hai?! Bringt euch in Sicherheit!
#. fr: Hmm... Alors c'est ça, le fameux requin géant dont tout le monde parle<nbsp>? Allez, mettez-vous tous à l'abri<nbsp>!
msgctxt "NpcYell:10497:0:13"
msgid "Is that...? The shark is here! Everyone, to safety!"
msgstr "Это?.. Акула здесь! Всем в безопасное место!"

#. ja: よし、こうなったらアレの出番だ……！<br>人工ボンバード、培養開始！
#. de: Aber wir haben ein besonderes Ass im Ärmel. Knallomat, du bist dran!
#. fr: Bien, c'est le moment de mettre notre plan en marche<nbsp>! Au tour du bombardo d'entrer en scène<nbsp>!
msgctxt "NpcYell:10498:0:13"
msgid "Our moment has come! Summon the Bombard!"
msgstr "Наш час настал! Призываю бомбардо!"

#. ja: 任せたぞ、大炎獣の底力を見せてやれッ！
#. de: Zeig uns deine explosive Kraft!
#. fr: Tu vas goûter aux flammes, maudit squale<nbsp>!
msgctxt "NpcYell:10499:0:13"
msgid "A raging inferno is at our beck and call!"
msgstr "Разъярённый огненный зверь у нас на посылках!"

#. ja: がんばれッ！
#. de: Los, los!
#. fr: Allez, courage<nbsp>!
msgctxt "NpcYell:10500:0:13"
msgid "Dance, dance!"
msgstr "Танцуй, танцуй!"

#. ja: いけいけーッ！
#. de: Du schaffst das, Knallomat!
#. fr: Danse<nbsp>! Danse<nbsp>!
msgctxt "NpcYell:10501:0:13"
msgid "Keep going!"
msgstr "Давай, не сдавайся!"

#. ja: そこだッ！
#. de: Genau so!
#. fr: C'est ça, continue<nbsp>!
msgctxt "NpcYell:10502:0:13"
msgid "Don't stop!"
msgstr "Не останавливайся!"

#. ja: ありがとう…！
#. de: Uff, vielen Dank!
#. fr: Tu as réussi<nbsp>!
msgctxt "NpcYell:10503:0:13"
msgid "We owe you everything!"
msgstr "Мы перед тобой в неоплатном долгу!"

#. ja: 助かったわ…！
#. de: Gerettet!
#. fr: Tu nous as sauvés<nbsp>!
msgctxt "NpcYell:10504:0:13"
msgid "How can we repay you?"
msgstr "Как нам тебя отблагодарить?"

#. ja: す、すごい爆発だ…！
#. de: Was für eine Feuerkraft!
#. fr: Quelle explosion<nbsp>! Ouah...
msgctxt "NpcYell:10505:0:13"
msgid "That beat any fireworks I've seen!"
msgstr "Вот это фейерверк! Такого я ещё не видел!"

#. ja: よし、いい調子だ……！<br>人食いザメが弱ってきたようだぞ……！
#. de: Sehr gut! Der Hai ist geschwächt!
#. fr: Vas-y, continue comme ça<nbsp>! Le requin montre des signes de faiblesse<nbsp>!
msgctxt "NpcYell:10506:0:13"
msgid "Don't let up! That monster's not long for this fight!"
msgstr "Не сбавляй темп! Этому чудовищу уже недолго осталось!"

#. ja: ムッ……まさか、あの技を使おうっていうのか……！<br>それを使えば、お前は……！
#. de: Dass ich einen Knallomaten tatsächlich auf unserer Seite kämpfen sehe<nbsp>...
#. fr: Argh... C'est qu'il a plus d'un tour dans son sac ce monstre... Montre-lui ce dont tu es capable<nbsp>!
msgctxt "NpcYell:10507:0:13"
msgid "A former menace turned savior... This truly has been a day for surprises."
msgstr "Из грозного врага — в спасители... Вот уж день сюрпризов."

#. ja: た、助かった…！
#. de: Gerettet!
#. fr: Je vous revaudrai ça toute ma vie<nbsp>!
msgctxt "NpcYell:10508:0:13"
msgid "You're a lifesaver!"
msgstr "Ты спас мне жизнь!"

#. ja: 命拾いしたよ…<br>ありがとう！
#. de: Dir habe ich mein Leben zu verdanken!
#. fr: M-merci... J'étais sur le point d'y passer...
msgctxt "NpcYell:10509:0:13"
msgid "I'd be a goner if you hadn't shown up!"
msgstr "Если бы не ты, мне бы конец!"

#. ja: ポッドを射出する！
#. de: Pods, zu mir!
#. fr: Tuez-les tous<nbsp>!
msgctxt "NpcYell:10510:0:13"
msgid "Requesting pod support."
msgstr "Прошу поддержки капсулой."

#. ja: ああ…光が…見える…
#. de: Ich sehe<nbsp>... das Licht<nbsp>...
#. fr: Ah, je vois... la lumière...
msgctxt "NpcYell:10511:0:13"
msgid "I see...light..."
msgstr "Я вижу... свет..."

#. ja: 逃さない！！
#. de: Es gibt kein Entkommen!
#. fr: Vous ne m'échapperez pas<nbsp>!
msgctxt "NpcYell:10512:0:13"
msgid "You won't escape!"
msgstr "Не уйдёшь!"

#. ja: ターゲット固定…<br>終わりにする！！
#. de: Ziele erfasst. Schluss mit den Spielchen.
#. fr: Cible verrouillée. Je vous tiens<nbsp>!
msgctxt "NpcYell:10513:0:13"
msgid "Target acquired."
msgstr "Цель захвачена."

#. ja: クソッ…<br>こうなったら！
#. de: Verdammt<nbsp>... Ihr lasst mir keine Wahl!
#. fr: Urgh... Vous ne me laissez pas le choix<nbsp>!
msgctxt "NpcYell:10514:0:13"
msgid "Fine... If you insist..."
msgstr "Ладно... Сами напросились..."

#. ja: 斬リ刻ム…！
#. de: Schnitzeln<nbsp>... Schnetzeln!
#. fr: Découper... en rondelles<nbsp>!
msgctxt "NpcYell:10515:0:13"
msgid "Gri...nd..."
msgstr "Крошу..."

#. ja: 叩キ潰ス…！
#. de: Zerschmettern!
#. fr: Broyer<nbsp>!
msgctxt "NpcYell:10516:0:13"
msgid "Cr...ush..."
msgstr "Сокрушаю..."

#. ja: 薙ギ払ウ…！
#. de: Zerstückeln!
#. fr: Trancher... dans le vif<nbsp>!
msgctxt "NpcYell:10517:0:13"
msgid "Brea...k..."
msgstr "Рублю..."

#. ja: 強制転移…！
#. de: Und weg!
#. fr: Téléportation<nbsp>!
msgctxt "NpcYell:10518:0:13"
msgid "Trans...fer..."
msgstr "Перемещаюсь..."

#. ja: 最期まで勇敢であった兵士たちに、<br>安らかな眠りあらんことを……。
#. de: In Frieden ruhen sollen die, die ihr Leben für die richtige Sache gegeben haben.
#. fr: Jusqu'au bout, nos soldats se seront brrravement battus... Puissent leurs âmes reposer en paix.
msgctxt "NpcYell:10519:0:13"
msgid "May these brave soldiers finally find freedom...in the hereafter."
msgstr "Пусть храбрые солдаты наконец обретут покой... в мире ином."

#. ja: ユンブ様ッ……！<br>ボズヤ・レジスタンスが現れました！
#. de: Dyunbu pyr Potitus! Der Widerstand ist da!
#. fr: Dyunbu, les rebelles arrivent<nbsp>!
msgctxt "NpcYell:10520:0:13"
msgid "Dyunbu! The Bozjans are here!"
msgstr "Дюнбу! Боузийцы здесь!"

#. ja: これ以上、部下たちの命を奪わせはしません……！<br>自由のため、ここで朽ち果てなさいッ！
#. de: Nie wieder werde ich die Leben meiner Untergebenen wegwerfen. Ich kämpfe für die Freiheit.
#. fr: Je ne vous laisserai pas faire davantage de victimes<nbsp>! Apprrrochez, qu'on en finisse<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10521:0:13"
msgid "Then we've no choice but to fight.<br>For Gabranth!"
msgstr "Тогда нам остаётся только сражаться.<br>За Габранта!"

#. ja: 行くぞ！<br>弔い合戦だ！
#. de: Auf zur Ver<shy>geltungs<shy>schlacht!
#. fr: Pour nos frères d'armes<nbsp>!
msgctxt "NpcYell:10522:0:13"
msgid "Charge!"
msgstr "Вперёд!"

#. ja: ユンブ様に続け！
#. de: Folgt der Freundlichen!
#. fr: Protégez Dyunbu<nbsp>!
msgctxt "NpcYell:10523:0:13"
msgid "Keep them away from Dyunbu!"
msgstr "Не подпускайте их к Дюнбу!"

#. ja: なぜ、ガブラス様の理想を理解しようとしないのです！<br>そんなに私たちが憎いのですか……！
#. de: Warum hören sie sich nicht an, was Gabranth zu sagen hat? Warum hassen sie uns bloß so?
#. fr: Pourquoi refusez-vous d'ouvrirrr les yeux<nbsp>? Est-ce la haine qui vous aveugle<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10524:0:13"
msgid "When will they open their eyes?<br>Our cause is just!"
msgstr "Когда же они наконец прозреют?<br>Наше дело правое!"

#. ja: ん～、わたしたちは、<br>祖国を取り戻したいだけなんですよ～？
#. de: Wir wollen unser Land zurück!
#. fr: Pas du tout<nbsp>! On veut récupérer notre patrie, rien de plus<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10525:0:13"
msgid "We're the ones fighting in the name of freedom!<br>You're just dogs serving the Garlean oppressors!"
msgstr "Это мы сражаемся за свободу!<br>А вы всего лишь псы гарлеанских угнетателей!"

#. ja: あなた……ガレアン族じゃないですよね～？<br>属州からの徴用兵ってところですか～？
#. de: Ihr seid keine Garlear. Ihr seid Rekruten aus den Provinzen!
#. fr: Tu n'es pas une Garlemaldaise de souche... L'Empire t'a forcée à t'enrôler, je me trompe<nbsp>?
msgctxt "NpcYell:10526:0:13"
msgid "How can you betray your people and give your lives for those tyrants!?"
msgstr "Как вы можете предавать свой народ и отдавать жизнь за этих тиранов?!"

#. ja: それが何だというのです……！<br>ガブラス様の下では、種族も性別も関係ありませんッ！
#. de: Wir stehen vereint unter dem Banner von Gabranth! Er bringt Frieden und Wohlstand!
#. fr: Oui, et alors<nbsp>? Le seigneur Gabranth traite tout le monde équi<shy>ta<shy>ble<shy>ment, peu imporrrtent la race ou l'origine<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10527:0:13"
msgid "We serve Gabranth, a man of honor!<br>He would bring peace and equality for all!"
msgstr "Мы служим Габранту, человеку чести!<br>Он принесёт всем мир и равенство!"

#. ja: でも、こうやって独立したいっていうボズヤの民を、<br>踏みにじるのはやめないんですよね～？
#. de: Seht ihr denn nicht? Er bringt nichts als Tod und Verderben!
#. fr: Et alors, ça ne te dérange pas de persécuter les Bozjiens qui préfèrent l'indépendance<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10528:0:13"
msgid "Then what of we Bozjans!?<br>He would have us all killed to the last man!"
msgstr "А что будет с нами, боузийцами?!<br>Он перебьёт нас всех до последнего!"

#. ja: ボズヤは、ボズヤ人だけのものではなく、<br>すべての人を受け入れる「王国楽土」となるべきなのですッ！
#. de: Jeder Frieden hat seinen Preis.
#. fr: Ce pays gagnerait à devenir le paradis sur terre envisagé par le seigneur Gabranth. Un paradis ouverrrt à tous, et pas juste aux Bozjiens<nbsp>!
msgctxt "NpcYell:10529:0:13"
msgid "You're wrong! He seeks unity, not division!"
msgstr "Ты ошибаешься! Он стремится объединить нас, а не разделить!"

#. ja: お、俺は…<br>ここで死ぬの…か…？
#. de: Ist das der Ort, an dem ich sterbe?
#. fr: Est-ce que... c'est la fin<nbsp>?
msgctxt "NpcYell:10530:0:13"
msgid "So...this is the end..."
msgstr "Так... вот и конец..."

#. ja: ユンブ様…<br>私は…貴女を…
#. de: Dyunbu pyr Potitus ... Ich hege starke Gefühle für sie.
#. fr: Dyunbu, je...
msgctxt "NpcYell:10531:0:13"
msgid "For Dyunbu...I'd die a thousand deaths..."
msgstr "За Дюнбу... я готов умереть тысячу раз..."

#. ja: 嗚呼……そんな……私の仲間たちが……！
#. de: Meine Untergebenen! Ich muss ihnen helfen!
#. fr: Non... Mes camarrrades... Ils sont tous...<nbsp>!
msgctxt "NpcYell:10532:0:13"
msgid "No! We were supposed to see this through...together!"
msgstr "Нет! Мы ведь должны были пройти через всё это... вместе!"

#. ja: 解放を謳う、血に飢えた蛮族ども……！<br>私は、貴様たちの顔を忘れない……絶対に、絶対にッ！
#. de: Das werde ich euch nie vergessen! Ihr Wilden kennt nur Gewalt und Zerstörung!
#. fr: Derrière vos beaux discours, vous n'êtes que des barbarrres assoiffés de sang<nbsp>! J-je ne vous le pardonnerai jamais<nbsp>! Jamais<nbsp>!!!
msgctxt "NpcYell:10533:0:13"
msgid "You monsters! I'll never forgive you! Never!"
msgstr "Чудовища! Я вам никогда этого не прощу! Никогда!"

#. ja: よいのですか…<br>見逃して…
#. de: Kein Vergeben, kein Vergessen, heißt es bei uns ...
#. fr: Hum... On ne la poursuit pas<nbsp>?
msgctxt "NpcYell:10534:0:13"
msgid "You're just gonna let them get away?"
msgstr "И вы просто позволите им уйти?"

#. ja: 彼女だって<br>自由を求めていた…
#. de: Eigentlich kämpft sie ja auch für die Freiheit.
#. fr: Elle se berce d'illusions...
msgctxt "NpcYell:10535:0:13"
msgid "They have their reasons to fight, the same as us."
msgstr "У них тоже есть причины сражаться. Как и у нас."

#. ja: 甘いっていうのは<br>わかってるけど…
#. de: Oder bin ich zu nachsichtig?
#. fr: Je sais que je ne devrais pas me soucier de l'ennemi, mais...
msgctxt "NpcYell:10536:0:13"
msgid "Perhaps there's still a chance for us to see eye to eye."
msgstr "Может, ещё не поздно найти общий язык."

#. ja: こ、このままじゃ、ジリ貧です～！<br>後方で体制を立て直しましょう～！
#. de: Formieren wir uns neu. Noch ist nicht aller Tage Abend.
#. fr: Ça se présente mal<nbsp>! Reculons et reformons nos rangs<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10537:0:13"
msgid "Not bad for a bunch of wand-wavers!<br>Let's fall back for now!"
msgstr "Неплохо для кучки колдунов!<br>А теперь отступим!"

#. ja: はぁ…はぁ…<br>絶対に…負けない…！
#. de: Ich werde nicht aufgeben!
#. fr: (halète) Je ne vous laisserai pas... (halète) avoirrr le dernier mot<nbsp>!
msgctxt "NpcYell:10538:0:13"
msgid "I won't...let you win!"
msgstr "Я не... дам вам победить!"

#. ja: いよいよ、カストルム・ラクスリトレも目前だなッ！<br>一気に攻め寄せるぞッ！
#. de: Jetzt nicht nachlassen! Das Castrum ist zum Greifen nahe!
#. fr: Castrum Lacus Litore n'est plus qu'à quelques pas<nbsp>! C'est le moment de foncer<nbsp>!
msgctxt "NpcYell:10539:0:13"
msgid "At this rate, the castrum will be ours before long."
msgstr "С такими темпами скоро крепость будет наша."

#. ja: レジスタンスが、もうこんなところまで……！<br>ええい、これ以上、調子に乗らせてたまるものかッ！
#. de: Jetzt ist der Widerstand schon hier! Gut, sie sollen nur kommen.
#. fr: Vermines rebelles... Votre seule présence ici est un affront, que je vais réparer de ce pas<nbsp>!
msgctxt "NpcYell:10540:0:13"
msgid "Damned Resistance! This is as far as you go!"
msgstr "Проклятое Сопротивление! Дальше вам не пройти!"

#. ja: 魔獣大隊の連中みたいね……！<br>ブラズ、ヴェリボル、気合い入れていくよッ！
#. de: Das ist der Bestientrupp. Blaz, Velibor, seid auf der Hut!
#. fr: C'est la cohorte bestiale... Montrons-leur qui rugit le plus fort<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10541:0:13"
msgid "So, they've bolstered their ranks with beasts, have they?<br>No matter, we'll crush them all the same!"
msgstr "Значит, они пополнили ряды зверями?<br>Неважно, мы всё равно их разгромим!"

#. ja: さあ、皆の者……征くぞ！<br>我らグンヒルドの剣に続け……！
#. de: Folgt uns! Für die Königin!
#. fr: Aucun adversaire n'est trop puissant pour les lames de Gunnhildr<nbsp>! À l'attaque<nbsp>!
msgctxt "NpcYell:10542:0:13"
msgid "Beasts they may be, but they too shall learn to fear Gunnhildr's Blades."
msgstr "Пусть они и звери, но и им предстоит узнать, что такое страх перед Клинками Гуннхильд."

#. ja: 来たな、血に飢えた蛮族ども……！<br>死んでいった仲間たちの下へ、送ってやるッ……！
#. de: Da sind sie wieder, die Mörder meiner Untergebenen. Doch bald werden sie ihren Opfern ins Angesicht blicken.
#. fr: Vous revoilà, assassins... Au nom de mes regrettés camarades, je vais vous expédier en enferrr<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10543:0:13"
msgid "Not you again...<br>Haven't you already spilled enough blood!?"
msgstr "Опять вы...<br>Разве вы ещё не пролили достаточно крови?!"

#. ja: おい、術士大隊の……ユンブと言ったか？<br>前に出すぎだ、下がれ！
#. de: Dyunbu! Bleib zurück!
#. fr: D-Dyunbu<nbsp>! Reculez, vous allez vous faire tuer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10544:0:13"
msgid "Stand back, lass.<br>You'll only get in the way."
msgstr "Отойди, девочка.<br>Только мешаться будешь."

#. ja: 黙れ……！<br>復讐の好機、誰であろうと奪わせはしないッ……！
#. de: Schweig! Ich will Rache!
#. fr: Horrrs de question<nbsp>! Vous ne m'empêcherez pas d'assouvir ma vengeance<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10545:0:13"
msgid "I'll not take orders from you, churl!<br>Who are you to deny me my vengeance!?"
msgstr "Не смей мне указывать, хам!<br>Кто ты такой, чтобы лишать меня мести?!"

#. ja: よくも、私の仲間たちを……！<br>皆、自由を信じて戦っていたんだッ……それをッ……！
#. de: Meine Untergebenen haben für die Freiheit gekämpft. Sie haben an mich geglaubt!
#. fr: Comment avez-vous pu<nbsp>? Mes camarades se battaient simplement pour leur liberrrté... Et vous, vous les avez tous...
msgctxt "NpcYell:10546:0:13"
msgid "You'll pay for what you've done, for the friends you've slain!"
msgstr "Вы заплатите за всё, что натворили, за каждого убитого товарища!"

#. ja: 死した仲間が、復讐を望んでいるのか……？<br>信念のためにこそ武器をとっていたのではないのか？
#. de: Lass deine Untergebenen in Frieden ruhen! Sie sind nicht länger deine Werkzeuge.
#. fr: Auraient-ils voulu être vengés<nbsp>? N'étaient-ils pas prêts à mourir pour défendre leurs convictions<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10547:0:13"
msgid "Revenge will not bring them back.<br>It will only lead to more suffering."
msgstr "Месть их не вернёт.<br>Она принесёт лишь новые страдания."

#. ja: 黙れ、黙れ、黙れッ……！<br>蛮族が軽々しく、私の仲間の想いを口にするなッ……！
#. de: Schweig, Wilder! Du hast nicht das Recht, über uns zu richten!
#. fr: Taisez-vous<nbsp>! Je vous interrrdis de parler en leur nom, barbares sanguinairrres que vous êtes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10548:0:13"
msgid "What do you know of suffering!?<br>I'll teach you the meaning of pain!"
msgstr "Что ты знаешь о страданиях?!<br>Я научу тебя, что такое боль!"

#. ja: 嗚呼…やっと…<br>皆に逢える…
#. de: Endlich ... Ich komme, meine Freunde ...
#. fr: Ah... Enfin, nous allons nous revoirrr, mes amis...
msgctxt "NpcYell:10549:0:13"
msgid "It seems we will soon be reunited..."
msgstr "Похоже, скоро мы встретимся вновь..."

#. ja: 畜生ッ……そう簡単に突き崩せないか……！<br>総崩れになる前に、引き上げるぞッ！
#. de: Verflucht, da kommt man nicht so leicht durch.
#. fr: Eh merde, impossible de percer leurs défenses<nbsp>! Retirons-nous avant que ça n'empire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10550:0:13"
msgid "Ungh! The direct approach isn't working!<br>We need to fall back and think this through!"
msgstr "Чёрт! Напором их не взять!<br>Надо отступить и всё обдумать!"

#. ja: 復讐心が<br>戦意を高めたか…
#. de: Die einst Freundliche kennt nur noch Rache und Vergeltung ...
#. fr: Voilà donc la force de sa rancune...
msgctxt "NpcYell:10551:0:13"
msgid "The desire for revenge is strong indeed..."
msgstr "Как же сильна жажда мести..."

#. ja: ブラズ、ヴェリボル！<br>拠点で合流しよう…！
#. de: Blaz, Velibor! Wir treffen uns im Lager!
#. fr: On se retrouve au camp<nbsp>!
msgctxt "NpcYell:10552:0:13"
msgid "Time to cut our losses!"
msgstr "Блаз, Велибор! Встретимся в лагере..."

#. ja: そこまでだ、ボズヤ・レジスタンスの諸君……<br>我が魔導兵器の威力、しかと味わうがいい！
#. de: Lasst die Aufständischen die Macht unserer Maschinen spüren!
#. fr: Pas si vite, chers rebelles<nbsp>! Ne partez pas avant d'avoir goûté à la puissance de mon tout dernier chef-d'œuvre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10553:0:13"
msgid "Ah, the Resistance, and not a moment too soon.<br>Now, you shall face the might of my magitek!"
msgstr "А, Сопротивление! Как раз вовремя.<br>Ну что ж, испытайте мощь моей магитехники!"

#. ja: 新手か……！<br>だが、ブリキ人形など我が刃で断ち斬ってくれるッ……！
#. de: Egal, was kommt, mein Schwert wird es in Stücke schlagen.
#. fr: Voilà qu'on nous envoie un géant de fer... Par chance, mon épée coupe aussi à travers le métal<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10554:0:13"
msgid "More worthless toys.<br>My blade will make short work of them."
msgstr "Жалкие игрушки.<br>Мой клинок быстро с ними разделается."

#. ja: やれやれ、ここまで押し込まれようなど……<br>嘆かわしい限りだ。
#. de: Bis hier sind sie schon gekommen? Es ist unerträglich.
#. fr: Diantre... Nous voici dos au mur. Quelle honte pour notre glorieuse légion.
msgctxt "NpcYell:10555:0:13"
msgid "You may have gained the upper hand, but my flames yet long to feast on your living flesh!"
msgstr "Вы, может, и взяли верх, но мои языки пламени всё ещё жаждут полакомиться вашей плотью!"

#. ja: しかし、そう簡単にここは抜かせはしませんよ……？
#. de: Aber jetzt hat das Spiel ein Ende. An mir kommen sie nicht so leicht vorbei.
#. fr: Bien... Et si nous remettions les pendules à l'heure<nbsp>?
msgctxt "NpcYell:10556:0:13"
msgid "I shall scatter your ash on the wind!"
msgstr "Я развею ваш пепел по ветру!"

#. ja: あの魔力……あの炎……！<br>間違いないよ、あいつは「鉄火」のッ……！
#. de: Diese Feuerzauber sind ja brutal! Das muss Eisenfeuer sein!
#. fr: Ces flammes... C'est Sartauvoir le fer rouge<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10557:0:13"
msgid "Keep your wits about you, lads.<br>Old he may be, but this one is not to be underestimated."
msgstr "Берегитесь, ребята.<br>Он уже стар, но недооценивать его нельзя."

#. ja: 怯むなッ！
#. de: Nicht den Mut verlieren!
#. fr: Pas de panique, nous sommes là<nbsp>!
msgctxt "NpcYell:10558:0:13"
msgid "Hold your ground!"
msgstr "Держать строй!"

#. ja: この程度の魔力……<br>我が魔力で掻き消してくれようぞッ！
#. de: Nichts als Asche wird von euch übrigbleiben!
#. fr: Un pyromancien, hein... Enfin un adversaire à ma taille<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10559:0:13"
msgid "There is only one thing for it.<br>Fight fire with fire!"
msgstr "Выход один.<br>Огонь надо встречать огнём!"

#. ja: おまたせしました～！<br>わたしたちも加勢しますよ～！
#. de: Da sind wir! Wir helfen euch!
#. fr: Désolée du retard, on a eu quelques imprévus<nbsp>!
msgctxt "NpcYell:10560:0:13"
msgid "I hope you've saved a few for me!"
msgstr "Надеюсь, вы оставили мне парочку!"

#. ja: ハハハッ！<br>俺サマが来たからには、勝利は確実だぜーッ！
#. de: Hahaha! Jetzt fliegen die Köpfe!
#. fr: Ha ha ha<nbsp>!!! Maintenant que je suis là, ça va être du gâteau<nbsp>!
msgctxt "NpcYell:10561:0:13"
msgid "Never fear! These paltry foes shall be dashed against my shield!"
msgstr "Не бойтесь! Жалкие враги разобьются о мой щит!"

#. ja: 五月蝿い蝿が、数匹増えたところで……！
#. de: Da kommen ja immer mehr von diesen Schmeißfliegen.
#. fr: Ce ne sont pas quelques mouches en plus qui vont changer la donne<nbsp>!
msgctxt "NpcYell:10562:0:13"
msgid "My, my. More and more of them are crawling out of the woodwork."
msgstr "Надо же. Откуда только лезут эти мухи."

#. ja: 戦うに値する相手であることを、期待しましょう……。
#. de: Hoffentlich ist auch ein Gegner dabei, der sich anständig wehrt.
#. fr: Voyons voir de quoi vous êtes capables.
msgctxt "NpcYell:10563:0:13"
msgid "Strength in numbers will not spare them from the inferno!"
msgstr "Численный перевес их от пламени не спасёт!"

#. ja: 老いたくはないものですな…<br>失礼しますよ…？
#. de: Ich bin zu alt für sowas ...
#. fr: Ma foi... Je crois que je ne vais pas faire long feu ici...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10564:0:13"
msgid "To die a warrior's death...<br>Better that than be claimed by old age."
msgstr "Умереть в бою...<br>Это лучше, чем сгнить от старости."

#. ja: 数に頼んだ攻め方とはいえ……<br>なかなかどうして、やってくれるではありませんか……！
#. de: Wir sind mehr und wir sind besser ... Wir <i>müssen</i> einfach gewinnen.
#. fr: Même si vous avez l'avantage du nombre, je dois avouer que vous m'avez plutôt im<shy>pres<shy>sion<shy>né.
msgctxt "NpcYell:10565:0:13"
msgid "I had judged them to be no better than the rank and file, but I was mistaken."
msgstr "Я считал их обычными солдатами, но ошибался."

#. ja: サルトヴォアール……！<br>アルビレオ殿から伝達だ、次の段階に移行すると！
#. de: Sartauvoir! Befehl von Albeleo: Wir sollen zur nächsten Stufe übergehen!
#. fr: Sartauvoir<nbsp>! Un message du commandant Albeleo<nbsp>: on passe à l'étape suivante du plan<nbsp>!
msgctxt "NpcYell:10566:0:13"
msgid "Sartauvoir, Albeleo has ordered that we proceed to the next phase!"
msgstr "Сартувуар, Албелео приказал переходить к следующему этапу!"

#. ja: ふむ……野戦はここまでですか……。<br>レジスタンスの諸君、また後ほどお会いしましょう……！
#. de: Die Feldschlacht ist zu Ende. Aber gewonnen hat der Widerstand damit noch nicht.
#. fr: Finies, les escarmouches en plein air<nbsp>? Soit... Dans ce cas, chers rebelles, je vous dis à plus tard<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10567:0:13"
msgid "Then our excursion is at an end.<br>Until we next meet, Bozjans."
msgstr "Что ж, наша вылазка окончена.<br>До новой встречи, боузийцы."

#. ja: 逃げた……？<br>まだ余力を残してたはずなのに……。
#. de: Sie fliehen? Es ist, als würden sie ihre Kräfte für etwas aufsparen.
#. fr: Il est parti... C'est à peine si on a réussi à l'essouffler...
msgctxt "NpcYell:10568:0:13"
msgid "Hmm... I fear we haven't seen the last of them."
msgstr "Хм... Боюсь, мы ещё не раз с ними столкнёмся."

#. ja: 次の段階と言っていたな……。<br>どうやら、まだまだ気を抜けないようだ……。
#. de: Sie haben von einer nächsten Stufe gesprochen. Da kommt noch was auf uns zu.
#. fr: L'étape suivante de leur plan, hein... Ça ne me dit rien qui vaille.
msgctxt "NpcYell:10569:0:13"
msgid "Next phase, eh? I don't like the sound of that."
msgstr "Следующий этап, значит? Мне это не нравится."

#. ja: ハハハッ！　今は勝利を喜ぼうじゃないかーッ！<br>敵の本陣は目前なのだからなーッ！
#. de: Hahaha! Spürt ihr das? Wir stehen kurz vor dem endgültigen Sieg!
#. fr: Hé, les gars, on a gagné, il faut se réjouir<nbsp>! Prochain objectif<nbsp>: prendre d'assaut le castrum<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10570:0:13"
msgid "Hah! Do not be fooled, my friends. 'Tis merely cowardice!<br>And now, the path to the castrum lies before us."
msgstr "Ха! Не обманывайтесь, друзья. Это всего лишь трусость!<br>А теперь перед нами открыт путь к крепости."

#. ja: お、俺サマの剣が……通用しないだとーッ！？
#. de: Mein Schwert hat schon bessere Tage gehabt.
#. fr: Urgh... Ma lame se serait-elle émoussée<nbsp>!?
msgctxt "NpcYell:10571:0:13"
msgid "My blade... Has it failed me?"
msgstr "Мой клинок... Подвёл меня?"

#. ja: 現実を……敗北を認めたまえ……。<br>その程度の剣では、我が炎を斬れはしないとね。
#. de: Ist es das Schwert oder dein Arm?
#. fr: Vos armes sont impuissantes face à mes flammes. Acceptez la réalité. Admettez votre défaite.
msgctxt "NpcYell:10572:0:13"
msgid "Simpleton! Your steel is no match for all-consuming flame!"
msgstr "Глупец! Твоя сталь не сравнится с всепоглощающим пламенем!"

#. ja: て、撤退しましょう～！<br>生きていれば、また戦う機会だってあります～！
#. de: Hört auf. Wir sollten glücklich sein, dass wir noch leben.
#. fr: O-on a perdu une bataille, mais pas la guerre<nbsp>! On reviendra<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10573:0:13"
msgid "Let's fall back for the time being.<br>It seems we were ill prepared."
msgstr "Пора отступить.<br>Похоже, мы оказались не готовы."

#. ja: その時はまた、歓迎してさしあげよう。<br>次もまた生き残れるかまでは、保証しかねるがね……？
#. de: Wir leben und wir werden weiterkämpfen. Doch für wie lange noch?
#. fr: Au plaisir, dans ce cas. Quoique je risque de ne pas être aussi gentil la prochaine fois...
msgctxt "NpcYell:10574:0:13"
msgid "Prepare all you like, it will avail you naught."
msgstr "Готовьтесь сколько угодно, вам это не поможет."

#. ja: あら、その顔……<br>どこかで見かけた気がしますわね……？
#. de: Dieses Gesicht habe ich doch schon mal irgendwo gesehen!
#. fr: Tiens, tiens... Vos visages me disent quelque chose...
msgctxt "NpcYell:10575:0:13"
msgid "You there! I recognize you."
msgstr "Эй, вы! Я вас узнаю."

#. ja: ええと……ワタクシのペットちゃんの、<br>糞掃除に雇った下郎だったかしら……？
#. de: Ist das etwa der Lümmel, der meinen Liebling beschmutzt hat?
#. fr: Je sais<nbsp>! Vous êtes les domestiques que j'ai engagés pour essuyer le guano de mon oiseau arc-en-ciel<nbsp>!
msgctxt "NpcYell:10576:0:13"
msgid "Were you not hired as a dung-sweeper for my menagerie?"
msgstr "Разве вас не нанимали убирать навоз в моём зверинце?"

#. ja: えっ、違う……？<br>ごめんあそばせ、ワタクシ品性下劣な顔を見慣れてませんの！
#. de: Vielleicht vertu ich mich auch. Die sehen doch alle gleich aus.
#. fr: ... Non<nbsp>? Au temps pour moi. Je n'ai pas une bonne mémoire des faciès ingrats...
msgctxt "NpcYell:10577:0:13"
msgid "On second thought, I could never employ such an unsightly creature."
msgstr "Хотя постойте... Я бы не стала нанимать такое уродливое создание."

#. ja: さぁ、優雅なワタクシのペットちゃん！<br>あのゴミクズたちの頭、片端から噛み砕いてあげなさい！
#. de: Also los, mein Liebling! Reiß den Lümmeln ihre hässlichen Gesichter ab!
#. fr: Allez, va mon bel oiseau. Croque ces manants que je ne saurais voir<nbsp>!
msgctxt "NpcYell:10578:0:13"
msgid "Perhaps you can provide my pets with suitable sport."
msgstr "Может, вы позабавите моих питомцев?"

#. ja: ブラズ、ヴェリボル！<br>手強そうな相手だよ！
#. de: Blaz, Velibor! Uns erwartet ein starker Gegner.
#. fr: Blaz, Velibor, faites gaffe<nbsp>! Ce gros piaf a l'air dangereux<nbsp>!
msgctxt "NpcYell:10579:0:13"
msgid "Blaz, Velibor! Looks like we've got our work cut out for us."
msgstr "Блаз, Велибор! Похоже, работы у нас будет невпроворот."

#. ja: 油断するな<br>ふたりとも！
#. de: Gebt alles, beide!
#. fr: Restez sur vos gardes<nbsp>!
msgctxt "NpcYell:10580:0:13"
msgid "Do not allow your concentration to lapse even for a moment!"
msgstr "Не теряйте бдительности ни на миг!"

#. ja: わかってるさ！<br>さっさと倒すぞッ！
#. de: Meine Klinge zuckt schon.
#. fr: Ne discutez pas, battez-vous<nbsp>!
msgctxt "NpcYell:10581:0:13"
msgid "Hmph! A moment is all it'll take to finish this."
msgstr "Хм! Мне хватит одного мгновения, чтобы с ними покончить."

#. ja: ええい、いつまで遊んでいるの……！？<br>そろそろ本気を見せてやりなさぁーいッ！
#. de: Genug gespielt. Jetzt machen wir ernst.
#. fr: Non, non, non. Ce n'est pas bien de jouer avec la nourriture. Dépêche-toi de les achever<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10582:0:13"
msgid "Not much of a challenge, are you?<br>Allow me to put you out of your misery."
msgstr "И долго вы ещё будете с ними возиться?!<br>Пора показать им, на что вы способны!"

#. ja: 魔獣の殺気が増した！？
#. de: Die Bestien werden immer wilder!
#. fr: L'oiseau est plus féroce que tout à l'heure<nbsp>!
msgctxt "NpcYell:10583:0:13"
msgid "Such ferocity!"
msgstr "Вот это свирепость!"

#. ja: 上等だッ！
#. de: Ich geb alles!
#. fr: Ça tombe bien, moi aussi<nbsp>!
msgctxt "NpcYell:10584:0:13"
msgid "Ha! I'll show them who's fierce!"
msgstr "Отлично! Сейчас покажу, кто здесь свирепый!"

#. ja: ブラズ、ヴェリボル！<br>ここは正念場だねッ！
#. de: Blaz, Velibor! Das ist der Moment der Entscheidung!
#. fr: C'est nous ou eux<nbsp>!
msgctxt "NpcYell:10585:0:13"
msgid "So far, so good. But it's not over yet!"
msgstr "Пока всё идёт как надо. Но битва ещё не окончена!"

#. ja: 嗚呼、ワタクシの<br>ペットちゃんが…！
#. de: Nein! Mein Liebling!
#. fr: Nooon, mon bel oiseau<nbsp>!
msgctxt "NpcYell:10586:0:13"
msgid "You swine! I'll tear you limb from limb!"
msgstr "Вы мерзавцы! Я разорву вас на части!"

#. ja: ブチ殺すわよ！<br>このゴミクズども！
#. de: Das werdet ihr büßen! Pöbeliger Abschaum!
#. fr: Vous n'auriez pas dû... Je vais vous MASSACRER<nbsp>!
msgctxt "NpcYell:10587:0:13"
msgid "My beasts will dine on your flesh!"
msgstr "Мои звери сожрут вашу плоть!"

#. ja: こ、この……ワタクシが……<br>膝を……膝をつかされた……というの……！？
#. de: Wie ... Wie können sie besser sein ... als ich?
#. fr: J-je rêve... Moi, l'élégance incarnée, contrainte de mettre genou à terre<nbsp>!?
msgctxt "NpcYell:10588:0:13"
msgid "I'm not done yet!"
msgstr "Не может быть... Я... на коленях?.."

#. ja: アンタたち……覚えていなさい！<br>必ず、新しいペットちゃんの餌にしてやるんだから……！
#. de: Wir werden euch an unsere Hunde und Schweine verfüttern!
#. fr: V-vous me le paierez, bande de rustres<nbsp>! Mon prochain animal fétiche vous réduira en charpie<nbsp>!
msgctxt "NpcYell:10589:0:13"
msgid "When next we meet, you won't be so lucky!"
msgstr "Ещё встретимся — и вам уже не повезёт!"

#. ja: ブラズ、ヴェリボル！<br>大勝利だねッ！
#. de: Blaz, Velibor! Der Sieg ist unser!
#. fr: On a gagné<nbsp>!
msgctxt "NpcYell:10590:0:13"
msgid "Ha! That showed her!"
msgstr "Ха! Вот вам и урок!"

#. ja: 手強い魔獣であった…
#. de: Das war ein ganz schön fieses Ungeheuer.
#. fr: Ces bêtes nous ont donné du fil à retordre.
msgctxt "NpcYell:10591:0:13"
msgid "Indeed, though her beasts almost got the better of us."
msgstr "И правда, её звери чуть нас не одолели."

#. ja: あのケバいババァを<br>取り逃しちまったがな…
#. de: Meinst du diese eingebildete Pomeranze oder ihr Haustier?
#. fr: Et cette horrible mégère s'est enfuie...
msgctxt "NpcYell:10592:0:13"
msgid "What's more, she got away!"
msgstr "К тому же ей удалось уйти!"

#. ja: 無理は禁物…<br>退くも勇気ぞ！
#. de: Manchmal muss man Mut beweisen, indem man sich zurückzieht.
#. fr: Il faut savoir s'avouer vaincu... En arrière, mes frères<nbsp>!
msgctxt "NpcYell:10593:0:13"
msgid "Today is not a good day to die. We withdraw, for now."
msgstr "Сегодня умирать не время. Пока отступим."

#. ja: ブラズ、ヴェリボル！<br>撤退しようッ！
#. de: Blaz, Velibor! Rückzug!
#. fr: Blaz, Velibor, on s'en va<nbsp>!
msgctxt "NpcYell:10594:0:13"
msgid "This isn't going so well. Let's regroup!"
msgstr "Дела идут неважно. Давай перегруппируемся!"

#. ja: 畜生ッ！<br>歯がゆいぜッ！
#. de: Verflucht! Das schmeckt mir gar nicht.
#. fr: Rah, j'ai horreur de perdre<nbsp>!
msgctxt "NpcYell:10595:0:13"
msgid "Damn it all!"
msgstr "Проклятье!"

#. ja: …………聞く耳もたないってかッ！<br>なら、力づくで聞いてもらうだけだからなッ！
#. de: Sie wollen nicht hören! Dann müssen sie fühlen!
#. fr: Je prends ça pour un non... mais peut-être que quelques coups dans la caboche te feront changer d'avis<nbsp>!
msgctxt "NpcYell:10596:0:13"
msgid "If you won't listen to sense, I'll have to beat some into you!"
msgstr "Раз по-хорошему не понимаете, придётся выбить это из вас!"

#. ja: オラオラ、逃げ惑えッ！
#. de: Jetzt rennt besser, ihr Feiglinge!
#. fr: Allez<nbsp>! Je veux vous voir danser<nbsp>!
msgctxt "NpcYell:10597:0:13"
msgid "Nowhere to hide!"
msgstr "Бежать некуда!"

#. ja: この一撃…<br>耐えてみせろやァ！
#. de: Jetzt macht euch auf was gefasst!
#. fr: Goûte un peu à ça. Tu m'en diras des nouvelles<nbsp>!
msgctxt "NpcYell:10598:0:13"
msgid "Let's see how resilient you really are!"
msgstr "Посмотрим, насколько ты крепок!"

#. ja: 了解…<br>機動プログラム、セット…
#. de: Schon gut, verstanden. Manövrierprogramme geladen.
#. fr: Bien reçu. J'active le programme requis.
msgctxt "NpcYell:10599:0:13"
msgid "Understood. Loading program..."
msgstr "Принято. Загружаю программу..."

#. ja: 私達ノ攻撃を、<br>回避可能カ検証開始。
#. de: Beginne Evaluierung der Ausweichmanöver unserer Ziele.
#. fr: Calcul des probabilités d'esquive ennemie.
msgctxt "NpcYell:10600:0:13"
msgid "Evaluating evasive capacity..."
msgstr "Оцениваю способность уклоняться..."

#. ja: アあ…ココロが…<br>稼働シテいる事が判る。
#. de: Das Herz<nbsp>... Es scheint intakt.
#. fr: Ah... mon cœur s'emballe, je peux le sentir.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10601:0:13"
msgid "My heart, i-i-it─<br>...Functionality confirmed."
msgstr "Сердце... я-я...<br>...Работоспособность подтверждена."

#. ja: 私達の存在理由ガ…
#. de: Der Sinn unserer Existenz<nbsp>... ist<nbsp>...
#. fr: Cette excitation, c'est notre raison d'être.
msgctxt "NpcYell:10602:0:13"
msgid "Why...are we here?"
msgstr "Зачем... мы здесь?"

#. ja: 斬り…キリ…きリ…
#. de: Schnitzeln<nbsp>... Schnetzeln<nbsp>...
#. fr: Couper... Découper... Recouper...
msgctxt "NpcYell:10603:0:13"
msgid "Cut...enemy..."
msgstr "Резать... врага..."

#. ja: 了キリ…ヒッ…<br>ヒひひヒッ…
#. de: Ssschni-i-i-i<nbsp>...
#. fr: Ça va être une boucherie, hi hi.
msgctxt "NpcYell:10604:0:13"
msgid "Haha...ha..."
msgstr "Ха-ха... ха..."

#. ja: 帝国軍め、こんな場所に拠点を築こうとはな……！<br>我が魔力で粉砕してくれるッ！
#. de: Hier wollen sie also ihr Lager errichten. Ich werde es mit meiner Magie zermalmen!
#. fr: Installer un dépôt de provisions en plein champ de bataille... Ils sont fous ces Impériaux<nbsp>!
msgctxt "NpcYell:10605:0:13"
msgid "They'd seek to establish a supply point in the middle of a battlefield?"
msgstr "Они решили устроить склад прямо посреди поля боя?"

#. ja: 敵部隊の相手は、我に任せよッ！<br>お前たちは「帝国軍の整備物資」の破壊を頼むッ！
#. de: Zerstört das Wartungsgerät! Ich halte euch die Legionäre vom Hals.
#. fr: Je m'occupe des soldats<nbsp>! Vous, allez détruire ces caisses<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10606:0:13"
msgid "Not if I have any say in the matter!<br>Quickly, destroy those crates!"
msgstr "Не бывать этому!<br>Живо, уничтожьте ящики!"

#. ja: レ、レジスタンスだと！？<br>総員、迎撃せよ！
#. de: Was ist das, der Widerstand? Kämpft, Legionäre!
#. fr: Qu'est-ce que... Des rebelles<nbsp>! Vite, aux armes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10607:0:13"
msgid "The Resistance is here already!?<br>I knew this was a bad idea..."
msgstr "Сопротивление уже здесь!?<br>Я же говорил, что затея плохая..."

#. ja: ハッ……所詮は機械に頼る軟弱者……！<br>我が魔力の前では、紙クズも同然よッ！
#. de: Ohne ihre Maschinen sind sie nichts! Nichts als Opfer meiner Magie!
#. fr: Ha, je le savais<nbsp>! Sans leurs machines, ces Impériaux ne valent pas tripette<nbsp>!
msgctxt "NpcYell:10608:0:13"
msgid "Cowards! You would depend on machines to fight your battles!?"
msgstr "Трусы! Решили доверить свою битву машинам!?"

#. ja: むっ……時間をかけすぎたか……<br>致し方あるまい、一度、引き上げるぞッ！
#. de: Das dauert zu lang. Besser, wir ziehen uns zurück.
#. fr: Hmm, ce combat s'enlise... Mieux vaut se retirer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10609:0:13"
msgid "They have us beaten.<br>We must regroup!"
msgstr "Нас одолели.<br>Надо перегруппироваться!"

#. ja: 応ッ！
#. de: Zu Befehl!
#. fr: À vos ordres<nbsp>!
msgctxt "NpcYell:10610:0:13"
msgid "Aye, sir!"
msgstr "Есть, сэр!"

#. ja: ご武運をッ！
#. de: Haut alles kurz und klein!
#. fr: Force à vous<nbsp>!
msgctxt "NpcYell:10611:0:13"
msgid "They'll regret this!"
msgstr "Они ещё пожалеют!"

#. ja: お任せください！
#. de: Das übernehme ich.
#. fr: C'est comme si c'était fait<nbsp>!
msgctxt "NpcYell:10612:0:13"
msgid "This'll be over before it's even begun!"
msgstr "С этим быстро покончим!"

#. ja: 反逆者どもめ！
#. de: Verdammte Wilde!
#. fr: Pourritures rebelles<nbsp>!
msgctxt "NpcYell:10613:0:13"
msgid "You rebel scum."
msgstr "Мятежное отребье."

#. ja: させるものか！
#. de: Finger weg, das ist unser Gerät!
#. fr: On ne va pas se laisser faire<nbsp>!
msgctxt "NpcYell:10614:0:13"
msgid "You shall not interfere with our plans!"
msgstr "Не позволю вам сорвать наши планы!"

#. ja: 物資を死守するぞ！
#. de: Ich werde diese Kisten mit meinem Leben verteidigen!
#. fr: Défendez le matériel<nbsp>!
msgctxt "NpcYell:10615:0:13"
msgid "Defend those crates!"
msgstr "Защитите ящики!"

#. ja: 破壊しきれなかった…
#. de: Das habe ich mir leichter vorgestellt.
#. fr: On ne va pas y arriver...
msgctxt "NpcYell:10616:0:13"
msgid "I'd no idea they'd be so...stubborn."
msgstr "Не думал, что они такие... крепкие."

#. ja: 帝国軍め…
#. de: Sollen sie doch ihr blödes Lager aufbauen.
#. fr: Maudits Impériaux...
msgctxt "NpcYell:10617:0:13"
msgid "Gods damn them!"
msgstr "Проклятье!"

#. ja: 無念…
#. de: Nichts wie weg hier.
#. fr: Quel fiasco...
msgctxt "NpcYell:10618:0:13"
msgid "Our best wasn't good enough..."
msgstr "Как ни старались... всё зря..."

#. ja: そこまでだ！<br>外道め！
#. de: Wir schenken euch keinen Ilm mehr!
#. fr: Laissez nos camarades tranquilles<nbsp>!
msgctxt "NpcYell:10619:0:13"
msgid "Your villainy ends here!"
msgstr "Твоим злодеяниям конец!"

#. ja: なんだぁ…<br>またコイツらかよ！
#. de: Jetzt wird abgerechnet.
#. fr: Encore elle<nbsp>!?
msgctxt "NpcYell:10620:0:13"
msgid "I've a score to settle!"
msgstr "Я с тобой ещё не расквитался!"

#. ja: みんな、大丈夫！？<br>助けに来たよ！
#. de: Durchhalten, Rettung ist auf dem Weg!
#. fr: Tenez bon, on est là<nbsp>!
msgctxt "NpcYell:10621:0:13"
msgid "Hold on, everyone! Help is on the way!"
msgstr "Держитесь! Мы уже идём на помощь!"

#. ja: フシャー！
#. de: Fshaaaaaah!
#. fr: Rhhaaaa<nbsp>!
msgctxt "NpcYell:10622:0:13"
msgid "Fwaaagh!"
msgstr "Фва-а-ах!"

#. ja: ボアァァ～ン！
#. de: BoaAAn<nbsp>...
#. fr: Booombe<nbsp>!
msgctxt "NpcYell:10623:0:13"
msgid "BURN! BURN!"
msgstr "ГОРИ! ГОРИ!"

#. ja: フシャ！
#. de: Ksssh!
#. fr: Rhaa<nbsp>!
msgctxt "NpcYell:10624:0:13"
msgid "Gaaagh!"
msgstr "Га-а-ах!"

#. ja: ボガガッ！
#. de: Ba! BoAN!
#. fr: Bo-boooombe<nbsp>!
msgctxt "NpcYell:10625:0:13"
msgid "TO ASHES!"
msgstr "В ПЕПЕЛ!"

#. ja: 他愛ないわねぇ…
#. de: Weder Stolz noch Anstand hat dieser Pöbel.
#. fr: Ces impudents n'apprendront jamais.
msgctxt "NpcYell:10626:0:13"
msgid "We are not amused..."
msgstr "Ну и скука..."

#. ja: フレイムダンスで<br>鼓舞するんだ！
#. de: Inspirieren wir unseren Helfer mit dem Flammentanz!
#. fr: Motive le bombardo avec ta danse des flammes<nbsp>!
msgctxt "NpcYell:10627:0:13"
msgid "This dance will light a flame in your heart!"
msgstr "Танец пламени зажжёт огонь в твоём сердце!"

#. ja: 攻撃にまきこまれるなよ！
#. de: Geratet bloß nicht zwischen die Fronten!
#. fr: Attention aux attaques<nbsp>!
msgctxt "NpcYell:10628:0:13"
msgid "No attacking, just dancing!"
msgstr "Не деритесь, танцуйте!"

#. ja: 支援がなければ<br>勝利はできないッ！
#. de: Ohne unsere Hilfe wird der Knallomat verlieren!
#. fr: Le bombardo ne pourra pas vaincre sans encouragement<nbsp>!
msgctxt "NpcYell:10629:0:13"
msgid "We need help or we're done for!"
msgstr "Без поддержки нам конец!"

#. ja: フシュウウウ！
#. de: Fshuuuuuu!
#. fr: Frrshhh... Rhaaaaa<nbsp>!
msgctxt "NpcYell:10630:0:13"
msgid "Graaaaaah!"
msgstr "Гра-а-а-а!"

#. ja: ボグルァアアア！
#. de: BoNGraaAAAAh!
#. fr: Bo-bo-booooombe<nbsp>!
msgctxt "NpcYell:10631:0:13"
msgid "Hraaaaaagh... AAAAAARGH!"
msgstr "Хра-а-а... А-А-А-А!"

#. ja: ん…？<br>なんだ、あいつは…！
#. de: Was bei den Höllen ist das?
#. fr: La vache... C'est quoi, ce monstre<nbsp>!?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:10632:0:13"
msgid "What is <i>that</i>!?"
msgstr "Что это <i>такое</i>!?"

#. ja: 見たことのない魔獣を<br>連れているぞ！？
#. de: So ein Ungeheuer habe ich noch nie gesehen!
#. fr: Une nouvelle trouvaille des Impériaux, sans doute. Il a pas l'air commode...
msgctxt "NpcYell:10633:0:13"
msgid "I've never seen such a beast before..."
msgstr "Такого чудовища я ещё не видел..."

#. ja: バイシャーエン様に<br>急ぎ報告だ！
#. de: Das sollten wir sofort Bajsaljen melden.
#. fr: Vite, nous devons prévenir Bajsaljen<nbsp>!
msgctxt "NpcYell:10634:0:13"
msgid "We'd best report this to Bajsaljen!"
msgstr "Надо срочно доложить об этом Байсальену!"

#. ja: ミナギル、ムゥ～！
#. de: ICh wAChsE!
#. fr: Grossir<nbsp>! Grossir<nbsp>! Hmmm...
msgctxt "NpcYell:10635:0:13"
msgid "URGE TO BLOW...RISING!"
msgstr "ХОЧУ ВЗОРВАТЬСЯ... ВСЁ СИЛЬНЕЕ!"

#. ja: サイダイ、ムゥ～！
#. de: VolLE GRößE!
#. fr: Ma... xi... mum<nbsp>!!!
msgctxt "NpcYell:10636:0:13"
msgid "YOUR DOOM IS NIGH!"
msgstr "ВАШ КОНЕЦ БЛИЗОК!"

#. ja: 貴方が、獣王ライアンの忠実なるしもべですか……。
#. de: Du folgst also diesem Lyon? Bestienkönig! Das ich nicht lache!
#. fr: Laissez-moi deviner, vous êtes des fidèles de Lyon le Roi bestial, je me trompe<nbsp>?
msgctxt "NpcYell:10637:0:13"
msgid "So you're one of Lyon's underlings?"
msgstr "Так вы служите Лиону, Царю зверей?"

#. ja: レジスタンス風情が、ライアン様の名を呼ぶなぁぁ！<br>汚らわしいぃぃ！
#. de: Besudele nicht seinen Namen, Unwürdiger!
#. fr: Vermines rebelles, comment osez-vous prononcer le nom de notre seigneur<nbsp>!?
msgctxt "NpcYell:10638:0:13"
msgid "How dare you speak his name!"
msgstr "Как вы смеете произносить его имя!"

#. ja: グオオオォォォォ！
#. de: Grrraaah!
#. fr: Grooooaaah<nbsp>!
msgctxt "NpcYell:10639:0:13"
msgid "Grrraaah!"
msgstr "Гр-р-р-а-а-а!"

#. ja: 待ちなさい！<br>さあ、調教の始まりよ！
#. de: Lasst die Züchtigung beginnen.
#. fr: Reviens ici que je te dresse<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10640:0:13"
msgid "Where do you think you're going?<br>I'll teach you some obediance!"
msgstr "Куда это ты собралась?<br>Сейчас я тебя выдрессирую!"

#. ja: ライアン様ぁ～！<br>申し訳……申し訳ございませぬぅぅ……！
#. de: Vergebt mir, König der Bestien ...
#. fr: Seigneur Lyon... pardonnez... ma faiblesse...
msgctxt "NpcYell:10641:0:13"
msgid "Is this all I am capable of!?"
msgstr "И это всё, на что я способен!?"

#. ja: くっ…<br>エルネイス隊長…！
#. de: Hernais! Ich habe versagt ...
#. fr: Non<nbsp>! Commandant Hernais<nbsp>!
msgctxt "NpcYell:10642:0:13"
msgid "Hernais! Your sacrifice will not be forgotten!"
msgstr "Херне! Твоя жертва не будет забыта!"

#. ja: 忠犬のエルネイス……<br>恐ろしい執念の男でした……。
#. de: Das war also Hernais der Hund? Ein würdiger Gegner.
#. fr: Alors c'était lui, le fameux “chien fidèle”<nbsp>? Ma foi, il porte bien son nom<nbsp>; je n'avais jamais affronté d'adversaire aussi tenace.
msgctxt "NpcYell:10643:0:13"
msgid "So that was Hernais? A worthy foe."
msgstr "Так это и есть Херне, верный пёс? Достойный противник."

#. ja: な、なんという魔獣……<br>手がつけられない……！
#. de: Gegen diese Meute kommen wir nicht an!
#. fr: Ugh... Impossible de mater ces créatures<nbsp>!
msgctxt "NpcYell:10644:0:13"
msgid "It's no use! We're no match for these fiends!"
msgstr "Бесполезно! Нам не одолеть этих тварей!"

#. ja: バイシャーエン様！<br>一時撤退をッ！
#. de: Bajsaljen, befiehl den Rückzug!
#. fr: J-je propose un repli stratégique<nbsp>!
msgctxt "NpcYell:10645:0:13"
msgid "I'm sorry sir, but I've no choice but to withdraw!"
msgstr "Простите, сэр, но нам придётся отступить!"

#. ja: ライアン様ぁ！<br>この勝利を捧げますぅぅ！
#. de: Ein Hoch auf Lyon sas Helsos, den Bestienkönig!
#. fr: Seigneur Lyon, cette victoire est la vôtre<nbsp>!
msgctxt "NpcYell:10646:0:13"
msgid "In the name of Lyon!"
msgstr "Во имя Лиона!"

#. ja: グシャァァァァ！
#. de: Graaar!
#. fr: Graaaouaaarh<nbsp>!
msgctxt "NpcYell:10647:0:13"
msgid "Graaagggh!"
msgstr "Гра-а-а-ах!"

#. ja: いけッ！
#. de: Weiter!
#. fr: Allez<nbsp>!
msgctxt "NpcYell:10648:0:13"
msgid "Go!"
msgstr "Вперёд!"

#. ja: 倒せッ！
#. de: Gut so!
#. fr: En avant la danse<nbsp>!
msgctxt "NpcYell:10649:0:13"
msgid "That's it!"
msgstr "Вот так!"

#. ja: その調子ッ！
#. de: Halt durch!
#. fr: Continue, c'est bien<nbsp>!
msgctxt "NpcYell:10650:0:13"
msgid "Just a little more!"
msgstr "Ещё немного!"

#. ja: アハハ♪<br>待てよ～♪
#. de: Ahahaha! Warteee!
#. fr: Ha ha ha<nbsp>! Attends<nbsp>!♪
msgctxt "NpcYell:10651:0:13"
msgid "Hah hah! Wait up!"
msgstr "Ха-ха-ха! Подожди меня!"

#. ja: それっ！
#. de: Ha!
#. fr: Et voilà<nbsp>!
msgctxt "NpcYell:10652:0:13"
msgid "Hah!"
msgstr "Ха!"

#. ja: やったわね！
#. de: Sehr gut!
#. fr: Youpi<nbsp>!
msgctxt "NpcYell:10653:0:13"
msgid "It's done!"
msgstr "Готово!"

#. ja: いぇーい！
#. de: Hurra!
#. fr: Ouaaais<nbsp>!
msgctxt "NpcYell:10654:0:13"
msgid "Summer is saved!"
msgstr "Лето спасено!"

#. ja: 紅蓮祭を楽しもう！
#. de: Ich <i>liebe</i> den Feuermond-Reigen!
#. fr: Vive les Feux de la Mort<nbsp>!
msgctxt "NpcYell:10655:0:13"
msgid "Back to the faire!"
msgstr "Пора обратно на праздник!"

#. ja: つかまえてごらんよ！
#. de: Los, fang!
#. fr: Tiens, attrape<nbsp>!
msgctxt "NpcYell:10656:0:13"
msgid "After you!"
msgstr "А ну-ка, поймай!"

#. ja: さあ、遊ぶわよ！
#. de: Lasst uns spielen!
#. fr: Allons jouer<nbsp>!
msgctxt "NpcYell:10657:0:13"
msgid "Time to party!"
msgstr "Пора веселиться!"

#. ja: シュルルル…
#. de: Ssshhh<nbsp>...
#. fr: Grrrrr...
msgctxt "NpcYell:10658:0:13"
msgid "Grrrrrr..."
msgstr "Гр-р-р-р..."

#. ja: ミンナマモル…<br>バ、ク、ハ、ツ、ス、ル～！
#. de: STraNd bEsCHüTzt. JeTZt ExPLosIOn!
#. fr: Pro... téger... plage... Super EX-PLO-SION<nbsp>!!!
msgctxt "NpcYell:10659:0:13"
msgid "GET BACK. EXPLOSION IMMINENT!"
msgstr "НАЗАД. СКОРО ВЗРЫВ!"

#. ja: ありがとう、人工ボンバード……！<br>お前の爆発力、決して忘れないからな……！
#. de: Vielen Dank, lieber Knallomat! Deine explosive Hilfe halten wir immer in Ehren!
#. fr: Merci gentil bombardo... On n'oubliera pas ce que tu as fait pour nous<nbsp>!
msgctxt "NpcYell:10660:0:13"
msgid "We'll never see the likes of that Bombard again... Your explosive sacrifice won't soon be forgotten."
msgstr "Мы больше не встретим такого бомбардо... Твою взрывную жертву мы не забудем."

#. ja: ライアン様ぁ！<br>この獣、使いこなして見せますぅぅ！
#. de: Jetzt werde ich Euch zeigen, was ich gelernt habe, Bestienkönig!
#. fr: L'heure est venue de relâcher la bête que m'a confiée le seigneur Lyon<nbsp>!
msgctxt "NpcYell:10661:0:13"
msgid "Lyon! It's time to put the skills you taught me to good use!"
msgstr "Лион! Пора пустить в ход всё, чему ты меня научил!"

#. ja: ゴシャアァァァァッ！
#. de: Graaar!
#. fr: Grooooouoooh<nbsp>!
msgctxt "NpcYell:10662:0:13"
msgid "Graaaaaagh!"
msgstr "Гра-а-а-ах!"

#. ja: くるぞっ！
#. de: Los!
#. fr: Je vous attends<nbsp>!
msgctxt "NpcYell:10663:0:13"
msgid "Here they come."
msgstr "Они идут."

#. ja: 帝国の…敵…<br>倒ス…
#. de: >>Feind zerstören ...
#. fr: Éliminer... les ennemis de Garlemald...
msgctxt "NpcYell:10664:0:13"
msgid "Murder...death...kill..."
msgstr "Убивать... смерть... убивать..."

#. ja: 倒して家に…<br>家に戻ル…！
#. de: >>Zerstören und zurückkehren ...
#. fr: C'est seulement ainsi... que je retrouverai mon foyer<nbsp>!
msgctxt "NpcYell:10665:0:13"
msgid "If I kill just a few more...I can finally go home!"
msgstr "Убью ещё немного... и наконец вернусь домой!"

#. ja: 起動…！
#. de: >>Startsequenz einleiten ...
#. fr: Activation<nbsp>!
msgctxt "NpcYell:10666:0:13"
msgid "Activate!"
msgstr "Активация!"

#. ja: 戦闘開始…！
#. de: 0
#. fr: 0
msgctxt "NpcYell:10667:0:13"
msgid "Commencing battle!"
msgstr "Начинаю бой!"

#. ja: こちら、被検体VIII号、ダボグ……<br>火器管制システム起動……敵の排除を実行しまス……！
#. de: Hier spricht Dabog, Versuchsmodell 8.<br>>>Feuerleitsystem hochfahren ...<br>>>Feindzerstörung einleiten ...
#. fr: Ici Dabog, sujet numéro 8. Système d'armement opérationnel. J'attaque l'ennemi.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10668:0:13"
msgid "This is test subject VIII, Dabog.<br>Armaments primed. Initiating extermination."
msgstr "Говорит подопытный VIII, Дабог.<br>Оружие готово. Начинаю уничтожение."

#. ja: う……ううう……頭が……<br>なんで……オレは……こんなところに……。
#. de: Ah, mein Kopf ... Wo, wo bin ich?
#. fr: Uuugh... Ma tête... Qu-qu'est-ce que je fais là<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10669:0:13"
msgid "Wh-What am I doing here?<br>What have I done!?"
msgstr "Ч-что я здесь делаю?<br>Что я натворил!?"

#. ja: こちら、被験体VIII号、ダボグ……<br>エネルギーゲインが低下……戦闘継続不可能と判断……。
#. de: Hier spricht Dabog, Versuchsmodell 8.<br>>>Energieniveau rot ...<br>>>Kampfunfähigkeit festgestellt ...
#. fr: Ici Dabog, sujet numéro 8. Niveaux d'énergie en berne. Je dois abandonner le combat.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10670:0:13"
msgid "This is...test subject VIII, Dabog. Energy levels below minimum.<br>Combat capabilities severely compromised. Returning to base."
msgstr "Говорит... подопытный VIII, Дабог. Уровень энергии ниже минимума.<br>Боеспособность резко снижена. Возвращаюсь на базу."

#. ja: 作戦行動を中断……これより帰投しまス……。
#. de: >>Kampfhandlung einstellen ...<br>>>Rückkehrsequenz einleiten ...
#. fr: Mission interrompue. Je retourne à la base.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10671:0:13"
msgid "Enemy targets suppressed.<br>Returning to base."
msgstr "Цели подавлены.<br>Возвращаюсь на базу."

#. ja: 魔導レイバー、起動……基本性能を検証する！
#. de: Arbeitsmaschine gestartet. Überprüfe jetzt die Basisfunktionen.
#. fr: Ouvrier magitek, en avant<nbsp>! Voyons voir si mes ajustements ont porté leur fruit...
msgctxt "NpcYell:10672:0:13"
msgid "Now to test the efficacy of my alterations..."
msgstr "Проверим, насколько удачными оказались мои усовершенствования..."

#. ja:  “ピピピ……支援兵装……制御接続！”
#. de: <i>Waffensystem ...<br>Verbunden.</i>
#. fr: PI PI PI... “PARAMÈTRES DE COMBAT MIS À JOUR. POUVOIR DE DESTRUCTION RENFORCÉ.” *FRZZZZZT T T T*...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10673:0:13"
msgid "COMBAT PARAMETERS UPDATED.<br>DESTRUCTIVE CAPABILITIES INCREASED."
msgstr "БОЕВЫЕ ПАРАМЕТРЫ ОБНОВЛЕНЫ.<br>ПОТЕНЦИАЛ РАЗРУШЕНИЯ ПОВЫШЕН."

#. ja: “損傷率95パーセントヲ突破……<br>戦闘続行……緊急　離脱……”
#. de: <i>Schaden bei 95 % ...<br>Abbruchsequenz ...</i>
#. fr: “SYSTÈMES ENDOMMAGÉS À PLUS DE 95%<nbsp>! RETRAIT DE LA ZoNe De CoM... BaT.” *pziou*
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10674:0:13"
msgid "SYSTEM DAMAGE: 95%.<br>INITIATING COMBAT ZONE EXTRACTION SEQUENCE..."
msgstr "ПОВРЕЖДЕНИЯ СИСТЕМЫ: 95%.<br>ЗАПУСК ПОСЛЕДОВАТЕЛЬНОСТИ ЭКСТРЕННОГО ВЫВОДА ИЗ БОЕВОЙ ЗОНЫ..."

#. ja: ふむ……やはり、まだ改善の余地はあるか……。
#. de: Also gut. Zurück ans Reißbrett.
#. fr: Hmm... Il y a encore matière à l'améliorer, dirons-nous...
msgctxt "NpcYell:10675:0:13"
msgid "I shall have to make further improvements."
msgstr "Похоже, его ещё нужно доработать."

#. ja: レジスタンスども、献身的な協力に感謝するぞ？<br>では、またの機会にな……！
#. de: Danke für die Hilfe beim Feldtest, Widerspenstler. Freut euch aufs nächste Mal, hehe!
#. fr: Merci en tout cas de m'aider à faire avancer la science<nbsp>! Je vous dis à très bientôt<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10676:0:13"
msgid "Members of the Resistance, I must thank you for your part in my experiments.<br>Until next time, my test subjects."
msgstr "Сопротивленцы, благодарю за участие в моих экспериментах.<br>До скорой встречи, подопытные."

#. ja: ダメだ……この程度の相手では、限界は測れん！<br>負荷テストは中止……帰投するぞ……！
#. de: Der Gegner ist zu schwach. Ich breche den Belastungstest ab. Die Stressparameter waren noch nicht einmal im gelben Bereich.
#. fr: Non, non, non<nbsp>! Ce test ne rime à rien si l'adversaire est aussi faible<nbsp>! Ça suffit, j'annule tout<nbsp>!
msgctxt "NpcYell:10677:0:13"
msgid "Data gleaned from such underwhelming test subjects is of no use to me."
msgstr "От подопытных, которые и сопротивления-то не оказали, мне никакого толку."

#. ja: “ピピピ……戦術チップ　読ミ込ミ完了！<br>サア　殺戮ノ　時間デスヨー！”
#. de: <i>Kampfmodul eingelesen ...<br>Tötungssequenz ...</i>
#. fr: PI PI PI... “LECTURE DE LA PUCE DE COMBAT... MODE MASSACRE ACTIVÉ<nbsp>!” *FRZZZZZT T T T*...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10678:0:13"
msgid "CLOSE QUARTERS COMBAT DATA LOADED.<br>INITIATING MASSACRE MODE."
msgstr "ДАННЫЕ БЛИЖНЕГО БОЯ ЗАГРУЖЕНЫ.<br>ЗАПУСК РЕЖИМА УНИЧТОЖЕНИЯ."

#. ja: これより、最終テストを開始する……。<br>さあ、我が研究の糧となれ、レジスタンスども！
#. de: Das ist der letzte Test. Kämpft tapfer, Widerspenstler, und sterbt für die Wissenschaft!
#. fr: C'est l'heure du grand test<nbsp>! En piste, <if $gn4>chère cobaye<else>cher cobaye</if><nbsp>!
msgctxt "NpcYell:10679:0:13"
msgid "Now to gauge the resilience of these test subjects."
msgstr "Проверим, насколько крепки эти подопытные."

#. ja:  “ピピピ……追加兵装……制御接続！”
#. de: <i>Zusatzwaffensystem ...<br>Verbunden.</i>
#. fr: PI PI PI... “PARAMÈTRES DE COMBAT MIS À JOUR. POUVOIR DE DESTRUCTION RENFORCÉ.” *FRZZZZZT T T T*...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10680:0:13"
msgid "COMBAT PARAMETERS UPDATED.<br>DESTRUCTIVE CAPABILITIES INCREASED."
msgstr "БОЕВЫЕ ПАРАМЕТРЫ ОБНОВЛЕНЫ.<br>ПОТЕНЦИАЛ РАЗРУШЕНИЯ ПОВЫШЕН."

#. ja: “損傷率95パーセントヲ突破……<br>戦闘続行……緊急　離脱……”
#. de: <i>Schaden bei 95 % ...<br>Abbruchsequenz ...</i>
#. fr: “SYSTÈMES ENDOMMAGÉS À PLUS DE 95%<nbsp>! RETRAIT DE LA ZoNe De CoM... BaT.” *pziou*
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10681:0:13"
msgid "SYSTEM DAMAGE: 95%.<br>INITIATING COMBAT ZONE EXTRACTION SEQUENCE..."
msgstr "ПОВРЕЖДЕНИЯ СИСТЕМЫ: 95%.<br>ЗАПУСК ПОСЛЕДОВАТЕЛЬНОСТИ ЭКСТРЕННОГО ВЫВОДА ИЗ БОЕВОЙ ЗОНЫ..."

#. ja: このデータさえあれば、真の完成は目前……<br>協力に感謝するぞ……！
#. de: Mit diesen Daten habe ich alles, was ich brauche. Vielen Dank für den Test, ihr Narren!
#. fr: Ce n'est pas encore ça... mais je sens qu'on touche au but. Promis, la prochaine fois sera la bonne<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10682:0:13"
msgid "With a few more modifications, my warmachina will be unstoppable.<br>Your assistance in the trial was most appreciated, Bozjans."
msgstr "Ещё немного доработок — и мою боевую машину будет не остановить.<br>Благодарю за помощь в испытании, бозийцы."

#. ja: ダメだ……魔導レイバーの限界は、<br>この程度の戦闘では測れないというのに……！
#. de: Schon wieder keine guten Stresswerte. Können die sich nicht mal anstrengen?
#. fr: Ça ne va pas... L'ouvrier magitek ne pourra jamais livrer son plein potentiel avec une opposition aussi faible<nbsp>!
msgctxt "NpcYell:10683:0:13"
msgid "Such worthless specimens. This has barely scratched the surface of my warmachina's capabilities."
msgstr "Ничтожные образцы! Мы и толком-то не проверили, на что способна моя боевая машина."

#. ja: レジスタンスども、せいぜい粘ってくれよ……？
#. de: 0
#. fr: 0
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:10684:0:13"
msgid "Do <i>try</i> to stay alive long enough to provide useful data."
msgstr "<i>Постарайтесь</i> продержаться подольше, чтобы принести мне полезные данные."

#. ja: 消シ飛バス…！
#. de: Auslöschen<nbsp>...!
#. fr: Pulvériser<nbsp>!
msgctxt "NpcYell:10685:0:13"
msgid "Anni...hi...late..."
msgstr "У-у-уничтожить..."

#. ja: 魔獣を見つけたぞ！
#. de: Achtung! Bestie voraus!
#. fr: Là<nbsp>! Ces bêtes appartenaient à l'Empire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10686:0:13"
msgid "Those beasts aren't from around here.<br>They must belong to the Empire!"
msgstr "Вон те звери — не местные.<br>Должно быть, имперские!"

#. ja: 俺サマがいれば<br>勝利は確実だぜ～ッ！
#. de: Keine Sorge, Stanik ist bei euch.
#. fr: Ce ne sont pas quelques animaux qui vont me faire peur<nbsp>!
msgctxt "NpcYell:10687:0:13"
msgid "Whatever they are, they're in my way!"
msgstr "Неважно, кто они — всё равно встанут у меня на пути!"

#. ja: ハハハッ！<br>いくぞ、野郎ども～ッ！
#. de: Hahaha, komm zur Schlachtbank, mein Süßer!
#. fr: Allez tout le monde, au travail<nbsp>!
msgctxt "NpcYell:10688:0:13"
msgid "With me!"
msgstr "За мной!"

#. ja: うおおおっ！
#. de: Auf sie mit Gebrüll!
#. fr: Hayaaah<nbsp>!
msgctxt "NpcYell:10689:0:13"
msgid "You heard him!"
msgstr "Вы слышали!"

#. ja: グンヒルドの剣に続け！
#. de: Folgt der Königinnenwache!
#. fr: Épaulez la lame de Gunnhildr<nbsp>!
msgctxt "NpcYell:10690:0:13"
msgid "With a Blade on our side, we can't lose!"
msgstr "С Клинком Гуннхильд на нашей стороне нам не проиграть!"

#. ja: ゴアアァッ！
#. de: Goarrr!
#. fr: Groaaar<nbsp>!
msgctxt "NpcYell:10691:0:13"
msgid "Graaagh!"
msgstr "Гра-а-ах!"

#. ja: ハハハッ！<br>見たか、俺サマの実力～ッ！
#. de: Haha, jetzt seht ihr den Schlächter in Aktion!
#. fr: Ha ha ha<nbsp>! Qu'est-ce que vous dites de ça<nbsp>?
msgctxt "NpcYell:10692:0:13"
msgid "Such slovenly beasts are no match for me!"
msgstr "Такие неуклюжие твари мне не ровня!"

#. ja: さっすがグンヒルドの剣！<br>お見事でした！
#. de: Dieser Mann ist eine lebende Legende!
#. fr: Im<shy>pres<shy>sionnant<nbsp>! Les lames de Gunnhildr ne déçoivent pas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10693:0:13"
msgid "So that's the power of Gunnhildr's Blades...<br>Just like in the legends!"
msgstr "Вот она, сила Клинков Гуннхильд...<br>Прямо как в легендах!"

#. ja: こりゃ、旗色が悪いぜ～ッ！<br>撤退だ、撤退～ッ！
#. de: Ich muss mit dem linken Fuß aufgestanden sein. Ziehen wir uns zurück!
#. fr: Ça tourne au vinaigre... Retraite, retraite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10694:0:13"
msgid "Ungh... What drives these fiends!?<br>The day is lost. Retreat!"
msgstr "Уф... Да что за чудовища!?<br>Нам не победить. Отступаем!"

#. ja: グンヒルドの剣がいてくれたのに……！
#. de: Von einer Königinnenwache hatte ich mir mehr erwartet.
#. fr: Aïe. Même avec une lame de Gunnhildr, on n'y arrive pas...
msgctxt "NpcYell:10695:0:13"
msgid "Even with a Blade in our ranks, we still lost?"
msgstr "И всё равно проиграли, хотя с нами был Клинок?"

#. ja: ゴアアアアッ！！
#. de: Goooaaarrr!
#. fr: Groaaar<nbsp>!
msgctxt "NpcYell:10696:0:13"
msgid "Grrragh!"
msgstr "Отступаем...<br>Покидаем поле боя!"

#. ja: 撤退…<br>戦線離脱…！
#. de: Rückzug! Alle Mann zurück!
#. fr: La mission est un échec. Retraite stratégique en cours.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10697:0:13"
msgid "Mission failed.<br>Commencing strategic retreat."
msgstr "Задание провалено.<br>Начинаем плановое отступление."

#. ja: ブラズ、ヴェリボル！<br>敵部隊を発見したよッ！
#. de: Blaz, Velibor! Feind voraus!
#. fr: Patrouille ennemie en vue<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10698:0:13"
msgid "I see imperials!<br>Let's give them what for!"
msgstr "Вижу имперцев!<br>Покажем им, где раки зимуют!"

#. ja: よし！<br>ブッ潰してやるかッ！
#. de: Die knöpfen wir uns vor.
#. fr: Ça va saigner<nbsp>!
msgctxt "NpcYell:10699:0:13"
msgid "I'll lead the charge!"
msgstr "Я поведу атаку!"

#. ja: ……
#. de: ...
#. fr: ...<nbsp>...<nbsp>...
msgctxt "NpcYell:10700:0:13"
msgid "..."
msgstr "…"

#. ja: どうしたの？　ブラズ？
#. de: Was ist, Blaz?
#. fr: Ça ne va pas, Blaz<nbsp>?
msgctxt "NpcYell:10701:0:13"
msgid "Problem, Blaz?"
msgstr "Что такое, Блаз?"

#. ja: 嫌な気配だ…<br>警戒せよ…
#. de: Ich habe ein ungutes Gefühl. Seid wachsam.
#. fr: J'ai le poil hérissé... Ça ne présage rien de bon.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10702:0:13"
msgid "I sense a disturbance of some sort.<br>We should proceed with caution."
msgstr "Чую неладное…<br>Надо быть осторожнее."

#. ja: う、うわぁっ…！
#. de: Uaaah!
#. fr: Par l'enfer<nbsp>!
msgctxt "NpcYell:10703:0:13"
msgid "Ack!"
msgstr "А-а!"

#. ja: 魔物だと…？
#. de: Was ist das für ein Biest?
#. fr: Des dé... Des d-dé... Des démons<nbsp>!
msgctxt "NpcYell:10704:0:13"
msgid "D-D-Demons!"
msgstr "Д-д-демоны!"

#. ja: 友軍の魔獣ではない？<br>襲ってくるぞ！
#. de: Es greift an! Aber das gehört doch zu uns!
#. fr: Ils nous attaquent<nbsp>! Ce n'est pas la cohorte bestiale<nbsp>!
msgctxt "NpcYell:10705:0:13"
msgid "What's worse, I don't think these ones are on our side!"
msgstr "И что хуже всего, эти твари явно не на нашей стороне!"

#. ja: な、なんだコイツら！
#. de: Was passiert?
#. fr: D'où ils sortent, ceux-là<nbsp>!?
msgctxt "NpcYell:10706:0:13"
msgid "This is all we need!"
msgstr "Только этого нам не хватало!"

#. ja: 先程の気配の正体は<br>やはりッ…！
#. de: Ich sag doch, ich hab ein ungutes Gefühl.
#. fr: Mon mauvais pres<shy>sen<shy>ti<shy>ment tout à l'heure, c'était ça<nbsp>!
msgctxt "NpcYell:10707:0:13"
msgid "This is the source of the disturbance."
msgstr "Вот источник этого возмущения."

#. ja: ブラズ、ヴェリボル！<br>やるよッ！
#. de: Blaz, Velibor! Angreifen!
#. fr: Allez, on se les fait, eux aussi<nbsp>!
msgctxt "NpcYell:10708:0:13"
msgid "Only one thing for it!"
msgstr "Выход один!"

#. ja: よっしゃー！<br>大勝利ッ～！
#. de: Gewonnen, auf ganzer Linie.
#. fr: Et ne revenez pas<nbsp>!
msgctxt "NpcYell:10709:0:13"
msgid "Ha! I barely even broke a sweat!"
msgstr "Ха! Да я даже не вспотел!"

#. ja: しかし、あの魔物は<br>いったい…？
#. de: Aber was war das für ein Ding?
#. fr: Ces monstres... qu'est-ce qu'ils faisaient là<nbsp>?
msgctxt "NpcYell:10710:0:13"
msgid "This troubles me deeply."
msgstr "Мне это совсем не нравится."

#. ja: 帝国軍の増援じゃあ<br>なかったようだがな…
#. de: Die Garlear haben keine Unterstützung geschickt.
#. fr: Apparemment, ce n'était pas un coup des Impériaux...
msgctxt "NpcYell:10711:0:13"
msgid "The imperials were as surprised by those things as we were."
msgstr "Имперцы и сами не меньше нас удивились этим тварям."

#. ja: 危地を脱する…！<br>退けッ！
#. de: Es ist zu gefährlich. Nichts wie weg hier.
#. fr: C'est trop dangereux, fuyons<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10712:0:13"
msgid "Discretion is the better part of valor.<br>Withdraw!"
msgstr "Бережёного боги берегут.<br>Отступаем!"

#. ja: ブラズ、ヴェリボル！<br>後方で合流しよう！
#. de: Blaz, Velibor. Wir treffen uns später.
#. fr: Rendez-vous au camp<nbsp>!
msgctxt "NpcYell:10713:0:13"
msgid "Let's rendezvous back at base!"
msgstr "Встретимся на базе!"

#. ja: しくじったか…！
#. de: Verdammt!
#. fr: Damnation<nbsp>!
msgctxt "NpcYell:10714:0:13"
msgid "Curses!"
msgstr "Проклятье!"

#. ja: カサードに<br>スークのみんなも…！
#. de: Cassard?! Und du hast Verstärkung aus Mordh Souq mitgebracht!
#. fr: Cassard<nbsp>!? Tous les gens de Mord Souq sont là<nbsp>!
msgctxt "NpcYell:10715:0:13"
msgid "It's Cassard! And he's brought help from Mord Souq!"
msgstr "Это Кассард! И он привёл подмогу из Морд-Сука!"

#. ja: 人力であの大岩を…<br>ありがたい！
#. de: Meinen besten Dank! Diese Felsbrocken sind alles andere als leicht!
#. fr: Merci, les gars<nbsp>! On aurait eu bien du mal à déblayer ça à la main<nbsp>!
msgctxt "NpcYell:10716:0:13"
msgid "No small coup to roll that boulder over!"
msgstr "Вот это да, такую глыбу сдвинуть! Спасибо!"

#. ja: 見てください！<br>モルドスークの方たちが！
#. de: Seht! Unsere Freunde aus Mordh Souq!
#. fr: Regardez<nbsp>! Ce sont nos amis de Mord Souq<nbsp>!
msgctxt "NpcYell:10717:0:13"
msgid "Look! It's our friends from Mord Souq!"
msgstr "Смотрите! Это же наши друзья из Морд-Сука!"

#. ja: カサードに<br>スークのみんなも…！
#. de: Cassard?! Und du hast Verstärkung aus Mordh Souq mitgebracht!
#. fr: Cassard<nbsp>!? Tous les gens de Mord Souq sont là<nbsp>!
msgctxt "NpcYell:10718:0:13"
msgid "It's Cassard! And he's brought help from Mord Souq!"
msgstr "Это Кассард! И он привёл подмогу из Морд-Сука!"

#. ja: 人力であの大岩を…<br>ありがたい！
#. de: Meinen besten Dank! Diese Felsbrocken sind alles andere als leicht!
#. fr: Merci, les gars<nbsp>! On aurait eu bien du mal à déblayer ça à la main<nbsp>!
msgctxt "NpcYell:10719:0:13"
msgid "No small coup to roll that boulder over!"
msgstr "Вот это да, такую глыбу сдвинуть! Спасибо!"

#. ja: 援護してくれると<br>言うのか！
#. de: Schön, dass man sich auf seine Freunde verlassen kann!
#. fr: Ils ont l'air d'être là pour nous aider<nbsp>!
msgctxt "NpcYell:10720:0:13"
msgid "Our friends have come to our aid!"
msgstr "Друзья пришли нам на помощь!"

#. ja: マグヌスか…！<br>助かる！
#. de: Magnus? Du kommst genau zur rechten Zeit!
#. fr: Des Talos<nbsp>? Ça doit être Magnus<nbsp>!
msgctxt "NpcYell:10721:0:13"
msgid "Magnus! We're in your debt!"
msgstr "Магнус! Мы у тебя в долгу!"

#. ja: さらに多くのタロースを<br>修復したようですね…
#. de: Sie haben es geschafft, weitere Taloi zu reaktivieren, wie es aussieht!
#. fr: La réparation des talos semble bien avancer.
msgctxt "NpcYell:10722:0:13"
msgid "Pleased am I to see that more Talos have been restored."
msgstr "Рад видеть, что удалось починить ещё талосов."

#. ja: あのタロース…<br>マグヌスか！
#. de: Ein Talos? Das ist Magnus!
#. fr: Des Talos<nbsp>? Ça doit être Magnus<nbsp>!
msgctxt "NpcYell:10723:0:13"
msgid "A Talos? It could only be Magnus!"
msgstr "Талос? Да это же Магнус!"

#. ja: これが終わったら<br>お礼に行きましょう…！
#. de: Wenn wir hier durch sind, müssen wir ihnen danken.
#. fr: On devra les remercier une fois qu'on s'en sera sorti<nbsp>!
msgctxt "NpcYell:10724:0:13"
msgid "We must go and thank them afterwards!"
msgstr "Когда всё закончится, надо будет их поблагодарить!"

#. ja: これで前に進める！<br>助かったわ！
#. de: Damit wäre der Weg frei! Danke, Freunde!
#. fr: Génial<nbsp>! On va pouvoir avancer<nbsp>!
msgctxt "NpcYell:10725:0:13"
msgid "Thanks for clearing the way!"
msgstr "Спасибо, что расчистили дорогу!"

#. ja: あいつら…<br>やるじゃないか！
#. de: Ihr beiden habt es wirklich drauf!
#. fr: Ha<nbsp>! Ils assurent ces deux-là<nbsp>!
msgctxt "NpcYell:10726:0:13"
msgid "Much obliged, you two!"
msgstr "Ну и молодцы вы, ребята!"

#. ja: サーフさん！<br>ジェリックさんも…！
#. de: Seht! Das sind Thaffe und Jeryk!
#. fr: Thaffe<nbsp>! Jeryk<nbsp>!
msgctxt "NpcYell:10727:0:13"
msgid "Thaffe and Jeryk are here too!"
msgstr "Тафф и Джерик тоже здесь!"

#. ja: サーフさん！<br>ジェリックさんも…！
#. de: Seht! Das sind Thaffe und Jeryk!
#. fr: Thaffe<nbsp>! Jeryk<nbsp>!
msgctxt "NpcYell:10728:0:13"
msgid "Thaffe and Jeryk are here too!"
msgstr "Тафф и Джерик тоже здесь!"

#. ja: あいつら…<br>やるじゃないか！
#. de: Ihr beiden habt es wirklich drauf!
#. fr: Ha<nbsp>! Ils assurent ces deux-là<nbsp>!
msgctxt "NpcYell:10729:0:13"
msgid "Much obliged, you two!"
msgstr "Ну и молодцы вы, ребята!"

#. ja: 誰であろうと<br>止めさせはしない！
#. de: Egal, wer ihr seid, ihr werdet uns nicht aufhalten!
#. fr: Peu importe qui il est ou qui il était, on lui passera sur le corps<nbsp>!
msgctxt "NpcYell:10730:0:13"
msgid "Whoever you are, you're not stopping us!"
msgstr "Кто бы вы ни были, нас вам не остановить!"

#. ja: 眩い光のエーテル…<br>なかなかの使い手ね
#. de: Dieses Phantom hat eine starke Äther-Aura. Das wird kein leichter Kampf.
#. fr: Tout cet éther de Lumière... Notre prochain adversaire va nous donner du fil à retordre.
msgctxt "NpcYell:10731:0:13"
msgid "This one's aether shines bright. A foe to be reckoned with."
msgstr "Эфир у этого ярко сияет. С ним шутки плохи."

#. ja: 絶対に負けません！<br>絶対に…！
#. de: Eine Niederlage ist keine Option!
#. fr: Il est seul...<nbsp>? Peu importe, il ne nous arrêtera pas<nbsp>!
msgctxt "NpcYell:10732:0:13"
msgid "We can't lose! We won't!"
msgstr "Мы не можем проиграть! Не проиграем!"

#. ja: 眩い光のエーテル…<br>なかなかの使い手ね
#. de: Dieses Phantom hat eine starke Äther-Aura. Das wird kein leichter Kampf.
#. fr: Tout cet éther de Lumière... Il va nous donner du fil à retordre.
msgctxt "NpcYell:10733:0:13"
msgid "This one's aether shines bright. A foe to be reckoned with."
msgstr "Эфир у этого ярко сияет. С ним шутки плохи."

#. ja: 元の世界では<br>一廉の英雄だったのでしょう
#. de: Gewiss kein einfach zu bezwingender Held, aus welcher Welt er auch stammen mag!
#. fr: Dans le reflet d'où il vient, lui aussi a dû être érigé en héros.
msgctxt "NpcYell:10734:0:13"
msgid "Doubtless no ordinary hero whence he doth hail."
msgstr "Несомненно, в своём мире он был настоящим героем."

#. ja: 助かるよ！<br>フェオ＝ウル！
#. de: Danke dir, Feo Ul!
#. fr: Merci, Feo Ul<nbsp>!
msgctxt "NpcYell:10735:0:13"
msgid "Our thanks, Feo Ul!"
msgstr "Благодарим тебя, Фео Ул!"

#. ja: フェオ！<br>助けに来てくれたのね！
#. de: Feo Ul, du bist gekommen, um uns zu helfen!
#. fr: Feo<nbsp>! Heu<shy>reu<shy>se<shy>ment que tu es là<nbsp>!
msgctxt "NpcYell:10736:0:13"
msgid "Feo Ul! You came!"
msgstr "Фео Ул! Ты пришла!"

#. ja: これ以上ないほど<br>心強い援軍ね
#. de: Wir können uns keine stärkeren Verbündeten erhoffen!
#. fr: On ne pouvait pas rêver meilleur renfort<nbsp>!
msgctxt "NpcYell:10737:0:13"
msgid "We would be hard-pressed to find stouter aid."
msgstr "Подмоги лучше и не сыскать."

#. ja: 妖精王の降臨とは<br>恐れ入ります…
#. de: Der Feenkönig höchstselbst steht uns bei!
#. fr: Un portail<nbsp>? Vous nous gâtez, Votre Majesté.
msgctxt "NpcYell:10738:0:13"
msgid "That the king themself should attend..."
msgstr "Сам король фей соизволил явиться…"

#. ja: 妖精王の降臨とは<br>恐れ入ります…
#. de: Der Feenkönig höchstselbst steht uns bei!
#. fr: Un portail<nbsp>? Vous nous gâtez, Votre Majesté.
msgctxt "NpcYell:10739:0:13"
msgid "That the king themself should attend..."
msgstr "Сам король фей соизволил явиться…"

#. ja: 転送魔法ね…<br>利用させてもらいましょう
#. de: Dort! Ein Portal. Nutzen wir es!
#. fr: Un portail de téléportation... Qu'est-ce qu'on attend pour se jeter dedans<nbsp>?
msgctxt "NpcYell:10740:0:13"
msgid "A portal. Let us see where it leads."
msgstr "Портал. Посмотрим, куда он ведёт."

#. ja: フーア族か…！<br>味方となれば心強い！
#. de: Seht, das sind Fuath! Ich hoffe, sie sind diesmal auf unserer Seite ...
#. fr: Des Fuaths<nbsp>! Pour une fois, je suis bien content de les voir<nbsp>!
msgctxt "NpcYell:10741:0:13"
msgid "The Fuath! For once I'm glad to see them!"
msgstr "Фуаты! Хоть раз рад их видеть!"

#. ja: あの妖精侯が協力を…<br>夢でも見てるのか？
#. de: Träume ich, oder helfen die Fuath uns?
#. fr: Ces petits malins sont là pour nous aider<nbsp>? Je dois halluciner...
msgctxt "NpcYell:10742:0:13"
msgid "Is this just a dream, or are the Fuath really helping us?"
msgstr "Это сон, или фуаты и правда нам помогают?"

#. ja: 取引なくして<br>水妖侯が力を貸そうとは…
#. de: Und das ohne jegliche Gegenleistung. Wahrlich absonderliche Zeiten!
#. fr: Comment<nbsp>? Les esprits lacustres n'apportent pourtant jamais leur soutien sans contrepartie.
msgctxt "NpcYell:10743:0:13"
msgid "'Tis a strange time indeed when the Fuath lend their aid unconditionally."
msgstr "Дивные времена настали: фуаты помогают нам просто так."

#. ja: 取引なくして<br>水妖侯が力を貸そうとは…
#. de: Und das ohne jegliche Gegenleistung. Wahrlich absonderliche Zeiten!
#. fr: Comment<nbsp>? Les esprits lacustres n'apportent pourtant jamais leur soutien sans contrepartie.
msgctxt "NpcYell:10744:0:13"
msgid "'Tis a strange time indeed when the Fuath lend their aid unconditionally."
msgstr "Дивные времена настали: фуаты помогают нам просто так."

#. ja: お前の水上歩行術…<br>まさかな…
#. de: Sag, Urianger, wo hast du noch gleich die Technik zum Laufen über Wasser gelernt?
#. fr: Je viens de penser à un truc, Urianger... Ta technique pour marcher sur l'eau, tu la tiens d'où déjà<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:10745:0:13"
msgid "Tell me, Urianger... Where <i>did</i> you learn that water-walking charm?"
msgstr "Скажи, Урианже… Где <i>же</i> ты научился ходить по воде?"

#. ja: 聡きアマロたちも<br>共闘してくれるのか！
#. de: Auch die Amaros stehen uns bei!
#. fr: Les amaros de Wolekdorf vont se battre à nos côtés aussi<nbsp>!
msgctxt "NpcYell:10746:0:13"
msgid "The amaro, too, fight with us!"
msgstr "Амaро тоже сражаются на нашей стороне!"

#. ja: ヴォレクドルフの<br>アマロたちまで…！
#. de: Selbst die Amaros von Wolekdorf sind gekommen, um uns beizustehen!
#. fr: Même les amaros de Wolekdorf sont au rendez-vous<nbsp>!
msgctxt "NpcYell:10747:0:13"
msgid "Even the amaro have joined the fray!"
msgstr "Даже амаро вступили в бой!"

#. ja: ありがとう！<br>みんな！
#. de: Wir stehen in eurer Schuld!
#. fr: Merci pour votre aide à tous<nbsp>!
msgctxt "NpcYell:10748:0:13"
msgid "Thank you, everyone!"
msgstr "Спасибо вам всем!"

#. ja: 信じられません…<br>すべての妖精が私たちに…
#. de: Ich kann es kaum fassen. Das sind alle Feenvölker vereint!
#. fr: Le peuple féérique uni pour une même cause<nbsp>? Incroyable...
msgctxt "NpcYell:10749:0:13"
msgid "All of the fae folk, rallying to us... This doth verge upon a miracle."
msgstr "Все народы фей объединились ради нас… Это почти что чудо."

#. ja: 信じられません…<br>すべての妖精が私たちに…
#. de: Ich kann es kaum fassen. Das sind alle Feenvölker vereint!
#. fr: Le peuple féérique uni pour une même cause<nbsp>? Incroyable...
msgctxt "NpcYell:10750:0:13"
msgid "All of the fae folk, rallying to us... This doth verge upon a miracle."
msgstr "Все народы фей объединились ради нас… Это почти что чудо."

#. ja: これが歩んできた旅の結果…<br>絶対に負けられませんね！
#. de: Wir sind so weit gekommen. Jetzt müssen wir es zu Ende bringen!
#. fr: Nous sommes forts des liens que nous avons tissés durant notre voyage<nbsp>!
msgctxt "NpcYell:10751:0:13"
msgid "We owe it to them to see this through!"
msgstr "Мы обязаны довести дело до конца ради них!"

#. ja: 悪いけど…<br>押し通るわよ！
#. de: Tut mir leid, aber ihr seid im Weg!
#. fr: Désolée ma belle, mais t'es sur notre chemin<nbsp>!
msgctxt "NpcYell:10752:0:13"
msgid "We're getting past you one way or another!"
msgstr "Извини, но мы всё равно пройдём!"

#. ja: 昏いエーテルの中に<br>輝く魂の影…
#. de: Ihr Äther ist finster wie die Nacht, aber in seinem Inneren erstrahlt ein Licht.
#. fr: Son éther est sombre, mais l'ombre d'une âme brille encore en son cœur...
msgctxt "NpcYell:10753:0:13"
msgid "Her aether is dark, but within I see a glimmer of radiance."
msgstr "Эфир у неё мрачный, но внутри мерцает свет."

#. ja: 魂が軋むような…<br>悲しい輝き…
#. de: Das Licht ihrer Seele ist in Finsternis gehüllt.
#. fr: Son âme brille d'une Lumière triste...
msgctxt "NpcYell:10754:0:13"
msgid "Her light... It has a sad tinge to it..."
msgstr "Её свет… Такой печальный…"

#. ja: 昏いエーテルの中に<br>輝く魂の影…
#. de: Ihr Äther ist finster wie die Nacht, aber in seinem Inneren erstrahlt ein Licht.
#. fr: Son éther est sombre, mais l'ombre d'une âme brille encore en son cœur...
msgctxt "NpcYell:10755:0:13"
msgid "Her aether is dark, but within I see a glimmer of radiance."
msgstr "Эфир у неё мрачный, но внутри мерцает свет."

#. ja: 世界を救わんとする<br>心を利用するなんて…！
#. de: Was für eine Schande. Ihre guten Absichten missbraucht für finstere Machenschaften!
#. fr: Ces héros ne souhaitaient que sauver le monde... Et lui, il...<nbsp>!
msgctxt "NpcYell:10756:0:13"
msgid "Another noble soul reduced to a means to an end..."
msgstr "Ещё одна благородная душа стала всего лишь средством для достижения цели…"

#. ja: フェオ、ありがとう！<br>妖精たちにもよろしくね！
#. de: Feo Ul, du hast uns gerettet. Richte dem Volk der Feen unseren Dank aus!
#. fr: T'es la meilleure, Feo<nbsp>! Remercie tout le monde de notre part<nbsp>!
msgctxt "NpcYell:10757:0:13"
msgid "You're a godssend, Feo Ul! Thank everyone for us!"
msgstr "Ты нас просто спасла, Фео Ул! Передай всем нашу благодарность!"

#. ja: 森の木々を従わせる…<br>これが妖精王の力なのね
#. de: Der Ruf des Königs erklingt und die Bäume des Waldes gehorchen.
#. fr: Les arbres se sont écartés pour nous ouvrir le chemin... Un des nombreux pouvoirs du Monarque féérique de toute évidence.
msgctxt "NpcYell:10758:0:13"
msgid "When the king commands, even the forest must obey..."
msgstr "Когда король приказывает, даже лес покоряется…"

#. ja: 森の中に道が！<br>行きましょう！
#. de: Seht, ein Pfad hat sich geöffnet!
#. fr: Un passage à travers la forêt<nbsp>! Allons-y<nbsp>!
msgctxt "NpcYell:10759:0:13"
msgid "Look, a path has opened up!"
msgstr "Смотрите, дорога открылась!"

#. ja: フェオ・ウル！<br>助けに感謝するよ！
#. de: Feo Ul, wir werden dir für immer dankbar sein!
#. fr: Merci pour ton aide, Feo Ul<nbsp>!
msgctxt "NpcYell:10760:0:13"
msgid "You have our gratitude, Feo Ul!"
msgstr "Спасибо тебе за помощь, Фео Ул!"

#. ja: 行きましょう…<br>レイクランドへ！
#. de: Auf nach Seenland, Freunde!
#. fr: Allons-y<nbsp>! Nous sommes à deux pas de Grand-Lac<nbsp>!
msgctxt "NpcYell:10761:0:13"
msgid "On to Lakeland, then!"
msgstr "Тогда вперёд, в Лейкленд!"

#. ja: 見えた！<br>クリスタルタワーだ！
#. de: Seht, der Kristallturm!
#. fr: Droit devant<nbsp>! La Tour de Cristal<nbsp>!
msgctxt "NpcYell:10762:0:13"
msgid "I see it! The Crystal Tower!"
msgstr "Вижу! Кристальная башня!"

#. ja: クリスタリウムまで<br>もう一息だな…！
#. de: Es ist nun nicht mehr weit bis nach Crystarium!
#. fr: Cristarium n'est plus très loin<nbsp>!
msgctxt "NpcYell:10763:0:13"
msgid "Another stretch and we're home free."
msgstr "Ещё немного — и мы будем дома."

#. ja: このような抜け道が<br>存在したとは…
#. de: Verblüffend, diese geheime Passage ...
#. fr: J'aurais bien aimé connaître ce raccourci plus tôt...
msgctxt "NpcYell:10764:0:13"
msgid "That such a passage should exist..."
msgstr "Подумать только, здесь есть такой проход…"

#. ja: このような抜け道が<br>存在したとは…
#. de: Verblüffend, diese geheime Passage ...
#. fr: J'aurais bien aimé connaître ce raccourci plus tôt...
msgctxt "NpcYell:10765:0:13"
msgid "That such a passage should exist..."
msgstr "Подумать только, здесь есть такой проход…"

#. ja: 一気に駆け抜けるわよ！
#. de: Das ist unsere Chance, los!
#. fr: Allez<nbsp>! À la foulée<nbsp>!
msgctxt "NpcYell:10766:0:13"
msgid "Let's keep moving right along!"
msgstr "Не сбавляем темп!"

#. ja: 荒削りだけど<br>強い意志を感じるわ…
#. de: Sie sind etwas grob, aber im Grunde genommen haben sie das Herz am rechten Fleck.
#. fr: Ces mercenaires ne font pas dans la dentelle... Mais je sens une grande détermination chez eux, et c'est ce qui compte<nbsp>!
msgctxt "NpcYell:10767:0:13"
msgid "They're a little rough-hewn, but their hearts are in the right place."
msgstr "Они грубоваты, но намерения у них самые что ни на есть правильные."

#. ja: なかなかの<br>腕前じゃないか！
#. de: Nicht schlecht!
#. fr: Ahhh, en voilà qui assurent<nbsp>!
msgctxt "NpcYell:10768:0:13"
msgid "Not bad, you lot!"
msgstr "Недурно, ребята!"

#. ja: お知り合い…<br>なんですか？
#. de: Sind das deine Freunde, <split " " 1><string $gs1></split>?
#. fr: Vous connaissez ces gens, <split " " 1><string $gs1></split><nbsp>?
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:10769:0:13"
msgid "Are they your friends, <split \" \" 1><string $gs1></split>?"
msgstr "Это ваши друзья, <split \" \" 1><string $gs1></split>?"

#. ja: なかなかの<br>腕前じゃないか！
#. de: Nicht schlecht!
#. fr: Ahhh, en voilà qui assurent<nbsp>!
msgctxt "NpcYell:10770:0:13"
msgid "Not bad, you lot!"
msgstr "Недурно, ребята!"

#. ja: こっちも<br>負けてられないわね！
#. de: Mich kriegt keiner unter!
#. fr: On sera pas en reste<nbsp>!
msgctxt "NpcYell:10771:0:13"
msgid "I won't be outdone!"
msgstr "Не уступлю им!"

#. ja: なんなの…<br>あの滅茶苦茶なパンチ…
#. de: Was zur ...! Wer verteilt denn solche Schläge?
#. fr: V-vous avez vu la puissance de ce coup de poing<nbsp>!?
msgctxt "NpcYell:10772:0:13"
msgid "Good gods, who in the world punches like that?"
msgstr "О боги, кто вообще так бьёт кулаком?"

#. ja: ここは彼らに任せて<br>先に進むぞ！
#. de: Überlassen wir ihnen das und ziehen weiter!
#. fr: Ils ont l'air de gérer<nbsp>! On fonce<nbsp>!
msgctxt "NpcYell:10773:0:13"
msgid "Let's leave them to it and press on!"
msgstr "Оставим их разбираться и пойдём дальше!"

#. ja: 賞金稼ぎの皆さん<br>どうかご無事で！
#. de: Bleibt unversehrt, Kopfgeldjäger!
#. fr: Merci à vous quatre<nbsp>! Prenez garde<nbsp>!
msgctxt "NpcYell:10774:0:13"
msgid "Please be safe, all of you!"
msgstr "Берегите себя, пожалуйста!"

#. ja: なんなの…<br>あの滅茶苦茶なパンチ…
#. de: Was zur ...! Wer verteilt denn solche Schläge?
#. fr: V-vous avez vu la puissance de ce coup de poing<nbsp>!?
msgctxt "NpcYell:10775:0:13"
msgid "Good gods, who in the world punches like that?"
msgstr "О боги, кто вообще так бьёт кулаком?"

#. ja: 怒ったときの君も…<br>いや、何でもないよ…
#. de: Wenn du sauer bist, Schwester, dann ... Ach, schon gut.
#. fr: Hmm... Dans la forme, on aurait dit toi quand tu t'éner... N-non, oublie, en fait...
msgctxt "NpcYell:10776:0:13"
msgid "Actually, Sister, when you're angry... Ahem. Never mind."
msgstr "Вообще-то, сестра, когда ты злишься… Кхм. Забудь."

#. ja: じ、上等じゃない！<br>やってやるわよ！
#. de: Woah! Die legen noch eine Schippe drauf, was!
#. fr: Wouah... O-on en viendra à bout, comme les autres<nbsp>!
msgctxt "NpcYell:10777:0:13"
msgid "Hmph, the bigger they are...!"
msgstr "Ха! Чем они больше…!"

#. ja: エーテルの密度が<br>段違いよ、気をつけて！
#. de: Seid vorsichtig, sein Äther ist extrem stark!
#. fr: Son éther est plus concentré que celui des autres<nbsp>! Prenez garde<nbsp>!
msgctxt "NpcYell:10778:0:13"
msgid "Have care─his aether is far denser than the rest!"
msgstr "Берегитесь, его эфир куда плотнее, чем у остальных!"

#. ja: おいおい…あれも<br>元はヒトだってのか？
#. de: Du meinst, den gibt es irgendwo in echt?
#. fr: Sérieux<nbsp>? Celui-là a même pas l'air humain...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:10779:0:13"
msgid "Seriously? This is a <i>real</i> person somewhere?"
msgstr "Серьёзно? Где-то существует <i>настоящий</i> человек, который выглядит вот так?"

#. ja: エーテルの密度が<br>段違いよ、気をつけて！
#. de: Seid vorsichtig, sein Äther ist extrem stark!
#. fr: Son éther est plus concentré que celui des autres<nbsp>! Prenez garde<nbsp>!
msgctxt "NpcYell:10780:0:13"
msgid "Have care─his aether is far denser than the rest!"
msgstr "Берегитесь, его эфир куда плотнее, чем у остальных!"

#. ja: 了解だ…<br>護りは任せてくれ！
#. de: Keine Sorge, der Kerl muss erstmal an mir vorbei.
#. fr: Bien compris... Vous en faites pas, je vous protège.
msgctxt "NpcYell:10781:0:13"
msgid "Whatever the brute's got, I'll bear the brunt of it!"
msgstr "Какой бы он ни был громила, я приму удар на себя!"

#. ja: やっとレジスタンスを<br>見つけたぞ…！
#. de: Da sind sie ja.
#. fr: Les voilà, ces pourritures de rebelles<nbsp>!
msgctxt "NpcYell:10782:0:13"
msgid "They're here, right on cue!"
msgstr "Ну вот и они! Как раз вовремя!"

#. ja: エルネイス様の無念…<br>ここで晴らす！
#. de: Für Hernais den Hund!
#. fr: Hernais sera vengé<nbsp>!
msgctxt "NpcYell:10783:0:13"
msgid "For Hernais!"
msgstr "За Херне!"

#. ja: 皆殺しだッ！<br>戦争の犬を解き放てッ！
#. de: Fass!
#. fr: Pas de quartier<nbsp>! Lâchez les molosses<nbsp>!
msgctxt "NpcYell:10784:0:13"
msgid "Havoc! ...Did I do that right?"
msgstr "Разгром! …Правильно сказал?"

#. ja: グオォォォン！
#. de: Grrrr!
#. fr: Grroouuaaaf<nbsp>!!!
msgctxt "NpcYell:10785:0:13"
msgid "Grrrrrr!"
msgstr "Гр-р-р-р!"

#. ja: 帝国軍ですね～！<br>迎え撃ちましょう～！
#. de: Die Garlear! Nehmt keine Gefangenen.
#. fr: Ouah<nbsp>! Tout doux, le chien<nbsp>! Tout doux<nbsp>!
msgctxt "NpcYell:10786:0:13"
msgid "What ugly creatures! And their hounds are even worse!"
msgstr "Какие уродливые твари! А их гончие ещё хуже!"

#. ja: やりました～！<br>快勝です～！
#. de: Wer sagt's denn. Wir haben gewonnen.
#. fr: Wouhou<nbsp>! On a gagné<nbsp>!
msgctxt "NpcYell:10787:0:13"
msgid "That did the trick!"
msgstr "Вот и готово!"

#. ja: うおおおおっ！
#. de: Hurra!
#. fr: Allez japper ailleurs<nbsp>!
msgctxt "NpcYell:10788:0:13"
msgid "Take that, imperial scum!"
msgstr "Получай, имперская мразь!"

#. ja: エルネイス様…<br>申し訳ありません…
#. de: Das wird dem Hund gar nicht gefallen.
#. fr: Pardon, Hernais...
msgctxt "NpcYell:10789:0:13"
msgid "Hernais, we have failed you!"
msgstr "Херне, мы подвели тебя!"

#. ja: に、逃げろーッ！
#. de: Ich zieh Leine ...
#. fr: Retraite, retraite<nbsp>!
msgctxt "NpcYell:10790:0:13"
msgid "Retreat!"
msgstr "Отступаем!"

#. ja: 保ちません～！<br>撤退しましょう～！
#. de: Wir kommen nicht durch. Zurückziehen!
#. fr: Ils sont trop nombreux, fuyons<nbsp>!
msgctxt "NpcYell:10791:0:13"
msgid "This isn't working! We'll have to withdraw!"
msgstr "Ничего не выходит! Придётся отступить!"

#. ja: 魔獣大隊の力…<br>思い知ったか！
#. de: Feiglinge! Kommt zurück!
#. fr: Voilà ce qu'il en coûte de défier la cohorte bestiale<nbsp>!
msgctxt "NpcYell:10792:0:13"
msgid "Cowards! Come back and let our dogs finish the job!"
msgstr "Трусы! Вернитесь, пусть наши псы с вами разберутся!"

#. ja: やりましたよ！<br>エルネイス様ッ！
#. de: Hernais der Hund hat gewonnen!
#. fr: Hernais serait fier de nous<nbsp>!
msgctxt "NpcYell:10793:0:13"
msgid "Hernais will be proud!"
msgstr "Херне будет нами гордиться!"

#. ja: 敵補給路の寸断に<br>どうか協力を！
#. de: Wir müssen die Versorgung des Feindes stören!
#. fr: Venez, on a besoin de vous pour une opération<nbsp>!
#. macro: <split " " 2><string $gs1></split> — the last name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:10794:0:13"
msgid "Greetings, Blade <split \" \" 2><string $gs1></split>! Can you spare a moment?"
msgstr "Приветствую, Клинок <split \" \" 2><string $gs1></split>! Не уделите минутку?"

#. ja: そろそろ帰還します！<br>ご協力に感謝しますよ！
#. de: Danke für die Hilfe. Besser, wir kehren jetzt heim.
#. fr: Allez, on lève l'ancre<nbsp>! Merci encore, <if $gn4>grande libératrice<else>grand libérateur</if><nbsp>!
msgctxt "NpcYell:10795:0:13"
msgid "I'd best get going. Thanks for all your help!"
msgstr "Пожалуй, мне пора. Спасибо за помощь!"

#. ja: 叩ききれなかったか…<br>仕方ない、撤退します！
#. de: Es hat keinen Zweck. Rückzug!
#. fr: Ils se défendent mieux que prévu... Tant pis, ce sera pour une autre fois<nbsp>!
msgctxt "NpcYell:10796:0:13"
msgid "Not to worry. There'll be other chances, I'm sure!"
msgstr "Ничего, ещё будет шанс, я уверен!"

#. ja: 追えッ！
#. de: Hinterher!
#. fr: Ne le perdez pas de vue<nbsp>!
msgctxt "NpcYell:10797:0:13"
msgid "You're mine!"
msgstr "За ним!"

#. ja: 囚えろ！
#. de: Umzingelt sie!
#. fr: Il n'ira pas loin<nbsp>!
msgctxt "NpcYell:10798:0:13"
msgid "I have you now!"
msgstr "Теперь ты у меня в руках!"

#. ja: ほう……レジスタンスの増援か……。
#. de: Was ist das? Verstärkung?
#. fr: Tiens donc, voilà la cavalerie rebelle.
msgctxt "NpcYell:10799:0:13"
msgid "Come to dash yourselves against my magitek, have you?"
msgstr "Решили броситься на мои магитеки? Ну-ну…"

#. ja: だが、丁度いい……。<br>もう少しばかり、実戦データを取得したかったのでね。
#. de: Kommt genau richtig. Ich brauche noch mehr Testdaten.
#. fr: Ça tombe bien, j'ai justement une batterie de tests à mener sur divers prototypes.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10800:0:13"
msgid "Your sacrifice is most welcome.<br>The data I retrieve will be employed to wreak untold destruction on your pathetic friends!"
msgstr "Твоя жертва как нельзя кстати.<br>Собранные данные помогут мне обрушить на твоих ничтожных друзей невиданное разрушение!"

#. ja: 戦闘制御システム、Dモードに変更……<br>増援部隊を攻撃せよ！
#. de: Taktiksystem in Z-Modus. Verstärkung angreifen und zerstören!
#. fr: C'est parti... Activation du mode D<nbsp>! Sus aux renforts ennemis<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10801:0:13"
msgid "Initiate attack formation D.<br>Now to measure the enemy's resilience to my weaponry."
msgstr "Переход в боевой строй «Д».<br>Пора проверить, насколько враг устойчив к моему оружию."

#. ja: ふむ……想定以上の抵抗だな。<br>次なる魔導兵器を投入し、テストを続行しよう……。
#. de: Der Widerstand ist heftiger als erwartet. Eine gute Gelegenheit für einen weiteren Test.
#. fr: Belle ténacité. Voyons voir, qu'est-ce que je vais vous envoyer ensuite...<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:10802:0:13"
msgid "Most unexpected.<br>I wonder how they will fare against <i>this</i>?"
msgstr "Такого я не ожидал.<br>Посмотрим, как они справятся <i>с этим</i>."

#. ja: やってくれる……。<br>これにてテストは中断、全機出撃、殲滅戦に移行する！
#. de: Ausgezeichnet. Der Test ist beendet. Räumen wir hier auf.
#. fr: Bon, j'ai recueilli assez de données comme ça. Il est temps de liquider les cobayes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10803:0:13"
msgid "How intriguing...<br>Time to conclude the test and dispose of these specimens."
msgstr "Вот это любопытно...<br>Пора завершить испытание и избавиться от подопытных."

#. ja: な、なんだと……我が魔導兵器群が……<br>壊滅したというのか……！？
#. de: Alle zerstört? Wie ist das möglich!
#. fr: I-impossible<nbsp>! Tous mes beaux prototypes... réduits à l'état de ferraille<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10804:0:13"
msgid "Impossible!<br>Could I have made a miscalculation?"
msgstr "Невозможно!<br>Неужели я просчитался?"

#. ja: この程度…<br>造作もないッ！
#. de: So wird das nichts mit der Produktion ...
#. fr: Un jeu d'enfants<nbsp>!
msgctxt "NpcYell:10805:0:13"
msgid "Ha! Is that all you can muster!?"
msgstr "Ха! И это всё, на что вы способны?!"

#. ja: よし……レジスタンス相手の戦闘では、<br>この程度の無人機で問題がないと実証されたわけだ……。
#. de: Ausgezeichnet. Jetzt habe ich die Bestätigung, dass meine unbemannten Drohnen mit dem Widerstand fertig werden.
#. fr: Splendide<nbsp>! Une nouvelle preuve de la supériorité de la machine sur l'homme... enfin, sur le rebelle<nbsp>!
msgctxt "NpcYell:10806:0:13"
msgid "It seems these Resistance troops are capable of performing above their estimated combat parameters."
msgstr "Похоже, солдаты Сопротивления сражаются куда лучше, чем я рассчитывал."

#. ja: この屈辱…<br>忘れぬぞ…！
#. de: Diese Schande werde ich nie vergessen.
#. fr: Grr... J'aurai ma revanche<nbsp>!
msgctxt "NpcYell:10807:0:13"
msgid "When next we meet, I shall dispose of you once and for all!"
msgstr "В следующий раз я с тобой покончу раз и навсегда!"

#. ja: オォォォ…
#. de: Uaaah!
#. fr: Aaaaaaah<nbsp>!
msgctxt "NpcYell:10808:0:13"
msgid "Yaaarrrgh!"
msgstr "А-а-а-а!"

#. ja: 噴き上げろッ！
#. de: Ab in den Fleischwolf mit dir!
#. fr: Terre<nbsp>! Jaillis<nbsp>!
msgctxt "NpcYell:10809:0:13"
msgid "Earth writhe and rage!"
msgstr "Земля, вздыбись и разверзнись!"

#. ja: 荒鷲の巣を奪還せり！<br>我らの勝利ぞ！
#. de: Operation Nesträuber war ein voller Erfolg! Wir haben unsere Festung zurück.
#. fr: La victoire est nôtre<nbsp>! L'opération “Aire des aigles” est un succès<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10810:0:13"
msgid "Alermuc is ours!<br>We've won!"
msgstr "Альмук наш!<br>Победа за нами!"

#. ja: 獣王ライアン…<br>恐るべき男でした…
#. de: Ein ziemlich unsympathischer Geselle, dieser Lyon.
#. fr: Nous avons eu raison de ne pas sous-estimer le Roi bestial...
msgctxt "NpcYell:10811:0:13"
msgid "That Lyon fellow is not one to be trifled with..."
msgstr "С этим Лионом шутки плохи..."

#. ja: いけ、いけ～！
#. de: Los, los!
#. fr: Allez-y<nbsp>!
msgctxt "NpcYell:10814:0:13"
msgid "That's the way!"
msgstr "Вот так!"

#. ja: やっちまえ～！
#. de: Lyon wird dich in Stücke reißen!
#. fr: Pas de quartier<nbsp>!
msgctxt "NpcYell:10815:0:13"
msgid "You have them now!"
msgstr "Теперь они у тебя в руках!"

#. ja: 気合ですぜッ！
#. de: Was für ein Spaß!
#. fr: On est à bloc<nbsp>!
msgctxt "NpcYell:10816:0:13"
msgid "Finish them!"
msgstr "Добейте их!"

#. ja: ヒューッ！
#. de: Huuua!
#. fr: Hourra<nbsp>!
msgctxt "NpcYell:10817:0:13"
msgid "Just a little more!"
msgstr "Ещё немного!"

#. ja: みなぎっていこうやァ！
#. de: Ich nehm dich auseinander!
#. fr: Allez, on va se la donner<nbsp>!
msgctxt "NpcYell:10818:0:13"
msgid "This might sting a little."
msgstr "Сейчас будет больно."

#. ja: ちょっくら遊んでやるぜェ！
#. de: Wir spielen jetzt. Mit deinen Knochen!
#. fr: Tu m'en veux pas<nbsp>? Faut que je m'amuse un peu aussi<nbsp>!
msgctxt "NpcYell:10819:0:13"
msgid "Oh, we're just getting started!"
msgstr "Да мы только начали!"

#. ja: 避けちまうだけで<br>いいのかねェ？
#. de: Glaubst du, dass Flucht dich retten kann?
#. fr: Esquiver ça va finir par plus suffire<nbsp>!
msgctxt "NpcYell:10820:0:13"
msgid "Keep dancing around if you want, but it won't save you."
msgstr "Хоть выплясывай вокруг меня — не спасёт."

#. ja: そォら！<br>歯ァ、食いしばれェ！
#. de: Tja, so ein Biss kann wehtun!
#. fr: Serre les dents<nbsp>!
msgctxt "NpcYell:10821:0:13"
msgid "Think you're tough, eh?"
msgstr "Думаешь, ты крепкий, а?"

#. ja: オラオラ、逃げ惑えッ！
#. de: Willst du etwa fliehen?
#. fr: Ha ha<nbsp>! T'as nulle part où fuir<nbsp>!
msgctxt "NpcYell:10822:0:13"
msgid "Not thinking of running, are you?"
msgstr "Ну что, не собираешься бежать?"

#. ja: ブッ飛んじまいな！
#. de: Da gehst du aber fliegen!
#. fr: Va voir là-bas si j'y suis<nbsp>!
msgctxt "NpcYell:10823:0:13"
msgid "Now I've got you!"
msgstr "Попался!"

#. ja: 地雷設置…！
#. de: Minen!
#. fr: Largage de mines<nbsp>!
msgctxt "NpcYell:10824:0:13"
msgid "There is no escape!"
msgstr "Вам не уйти!"

#. ja: ようこそ、我が秘密の祭殿へ……！<br>財宝を巡る終わりなき祭りを愉しもうではありませんか……！
#. de: Willkommen in meinem geheimen Refugium! Freut euch auf ein unvergessliches Schatzfest.
#. fr: Bienvenue dans mon jardin secret<nbsp>! Nous nous récréerons au milieu de mes trésors à tout jamais<nbsp>!
msgctxt "NpcYell:10825:0:13"
msgid "Welcome to my secret sanctuary! Make yourself at home, for this time of treasures and tribulations will not soon come to an end!"
msgstr "Добро пожаловать в моё тайное святилище! Устраивайтесь поудобнее: это пиршество сокровищ и злоключений ещё нескоро закончится!"

#. ja: それでは、さっそく……<br>少しばかりの幻惑で、この出会いを彩りましょう！
#. de: Wohlan, es wird Zeit zu beginnen. Darf ich euch den Aufenthalt mit einer kleinen Verzauberung versüßen?
#. fr: En tant qu'hôte des plus serviables, je ferai de mon mieux pour rendre cette rencontre inoubliable<nbsp>!
msgctxt "NpcYell:10826:0:13"
msgid "Yes, yes, it is time to begin! Shall we have a trifling glamour to liven up this fortuitous meeting?"
msgstr "Ну что ж, пора начинать! Может, немного колдовства оживит нашу столь удачную встречу?"

#. ja: ウフフ…<br>避けられるかしら？
#. de: Hihihi! Du willst spielen? Sehr gut!
#. fr: Hi hi hi<nbsp>! Vous ne saurez plus où donner de la tête<nbsp>!
msgctxt "NpcYell:10827:0:13"
msgid "Tee hee hee! I'm glad you came to play with me!"
msgstr "Хи-хи-хи! Как я рада, что вы пришли со мной поиграть!"

#. ja: ホコリガ、散ッタヨ<br>サッサカサー
#. de: Mach rein die Schuuutuuube! Wusch, wusch, wuuuusch!
#. fr: Le cochon a mis de la poussière partout<nbsp>! Fschuiii<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10828:0:13"
msgid "Edam ev'uoy ssem a hcus.<br>Swish-swish-aroo!"
msgstr "Пыль разлетелась.<br>Шух-шух-шурух!"

#. ja: 仕事ガ、増エタヨ<br>サッサカサー
#. de: Arbeit fein, macht besenrein! Wusch, wusch, wuuuusch!
#. fr: Plus de travail pour nous<nbsp>! Fschuiii<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10829:0:13"
msgid "Enod reven si krow ym.<br>Swish-swish-aroo!"
msgstr "Работы всё прибавляется.<br>Шух-шух-шурух!"

#. ja: ササット、サクサク<br>サッサカサー
#. de: Einmal hier und einmal dort. Schmutz ist fort! Wusch, wusch, wuuuusch!
#. fr: Notre sol doit être propre, allez zou<nbsp>! Fschuiii<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:10830:0:13"
msgid "Redro ni si peews tfiws a.<br>Swish-swish-aroo!"
msgstr "Шустро подметём — и порядок.<br>Шух-шух-шурух!"

#. ja: ガウガウ、ガウ～！
#. de: \<kreisch> \<quiek>
#. fr: Graouuu<nbsp>! graouuu<nbsp>!♪
msgctxt "NpcYell:10831:0:13"
msgid "\\<squeal> \\<squeal>"
msgstr "\\<визг> \\<визг>"

#. ja: ガウガウ、ガウガウガウガウ！！
#. de: \<quiek> \<quiek> \<quiek>
#. fr: Graou...<nbsp>? Graou graou graou<nbsp>!!!
msgctxt "NpcYell:10832:0:13"
msgid "\\<squeal> \\<squeal> \\<squeal>"
msgstr "\\<визг> \\<визг> \\<визг>"

#. ja: おやおや？<br>まさか、この僕が喚ばれるなんてね……！
#. de: Das Karussell dreht sich weiter, immer weiter! Bonusrunde!
#. fr: Et là, je lui dis...<nbsp>! Tiens<nbsp>? Bah ça alors<nbsp>! C'est vous qui m'avez invoqué ici<nbsp>?
msgctxt "NpcYell:10833:0:13"
msgid "Well, well! It seems I've been called into the fray!"
msgstr "Ну надо же! Похоже, меня призвали в самую гущу сражения!"

#. ja: ブラボーッ！<br>どうやら君たちは、素晴らしい幸運の持ち主らしい！
#. de: Bravo! Das Glück ist euch hold. Aber nicht mehr lange! Hihihi!
#. fr: Je vous tire mon chapeau<nbsp>! M'en voulez pas, mais je dois vous laisser. Bonne continuation, en tout cas<nbsp>!
msgctxt "NpcYell:10834:0:13"
msgid "Bravo, bravo! I see that luck is on your side...for now!"
msgstr "Браво, браво! Вижу, удача пока на вашей стороне!"

#. ja: 通路が崩れている<br>ようですね…
#. de: Eingestürzt ... Da kommen wir nicht weiter.
#. fr: Cet escalier s'est effondré. Comment allons-nous faire pour traverser...<nbsp>?
msgctxt "NpcYell:10835:0:13"
msgid "Hmmm... How are we to pass?"
msgstr "Хм... Как же нам пройти?"

#. ja: えっ…！？
#. de: Hoppla!
#. fr: Hein<nbsp>!?
msgctxt "NpcYell:10836:0:13"
msgid "\\<gasp>"
msgstr "\\<ах>"

#. ja: この禍々しい気配は…？
#. de: Was für eine Aura! Spürst du das auch, <split " " 1><string $gs1></split>?
#. fr: Quelle aura maléfique... Elle vient de là-bas<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:10837:0:13"
msgid "Do you feel that, <split \" \" 1><string $gs1></split>?"
msgstr "Чувствуете это, <split \" \" 1><string $gs1></split>?"

#. ja: せめて安らかに<br>眠ってください…
#. de: Entschuldigt die Störung.
#. fr: Puissiez-vous reposer en paix, maintenant...
msgctxt "NpcYell:10838:0:13"
msgid "I pray your spirit may at last find rest."
msgstr "Пусть твой дух наконец обретёт покой."

#. ja: また不穏なエーテルが…<br>足元に注意を！
#. de: Fallen. Passt auf, wo ihr hintretet.
#. fr: D'autres pièges<nbsp>! Attention où vous mettez les pieds<nbsp>!
msgctxt "NpcYell:10839:0:13"
msgid "Watch your step. I sense something amiss here..."
msgstr "Смотрите под ноги. Здесь что-то не так..."

#. ja: どうやら危険地帯は<br>抜けたようですね…！
#. de: Jetzt sollte der Boden wieder sicher sein. Weiter!
#. fr: Je ne détecte plus d'éther dans le sol... Allons-y<nbsp>!
msgctxt "NpcYell:10840:0:13"
msgid "I think we are safe. For the moment, at least."
msgstr "Похоже, теперь мы в безопасности. По крайней мере, пока."

#. ja: 片付きましたね…<br>流石です！
#. de: Das habt ihr gut hinbekommen. Bravo!
#. fr: Vous l'avez eu<nbsp>! Bravo<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:10841:0:13"
msgid "Well fought, <split \" \" 1><string $gs1></split>."
msgstr "Отлично сражались, <split \" \" 1><string $gs1></split>."

#. ja: この転移装置を<br>利用してみましょう！
#. de: Ein Transportzirkel. Den benutzen wir.
#. fr: Un autre de ces cercles magiques<nbsp>! Servons-nous-en<nbsp>!
msgctxt "NpcYell:10842:0:13"
msgid "Let us see where this portal leads."
msgstr "Посмотрим, куда ведёт этот портал."

#. ja: さあ、先に進みましょう！
#. de: Vorwärts!
#. fr: Continuons<nbsp>!
msgctxt "NpcYell:10843:0:13"
msgid "This way."
msgstr "Сюда."

#. ja: 撤退していった…？
#. de: Wo sind sie hin?
#. fr: Une retraite<nbsp>?
msgctxt "NpcYell:10844:0:13"
msgid "They've...retreated...?"
msgstr "Они... отступили?.."

#. ja: その魂が星海に<br>たどり着きますように…
#. de: Hoffentlich findet diese Seele ihren Frieden im Himmelsmeer.
#. fr: Que ton âme rejoigne la mer des étoiles, qui que tu sois...
msgctxt "NpcYell:10845:0:13"
msgid "May they find peace in the aetherial sea."
msgstr "Пусть их души обретут покой в эфирном море."

#. ja: この階段は<br>安全のようですね…
#. de: Die Treppen sehen sicher aus.
#. fr: Aucun piège dans cet escalier en revanche... Empruntons-le.
msgctxt "NpcYell:10846:0:13"
msgid "These stairs appear to be safe."
msgstr "Похоже, по этой лестнице можно пройти."

#. ja: ふぅ…危険地帯は<br>突破できたみたいです
#. de: Uff ... Wir sind raus aus der Gefahrenzone.
#. fr: Enfin, plus besoin de léviter<nbsp>! Je ne détecte plus aucun piège<nbsp>!
msgctxt "NpcYell:10847:0:13"
msgid "I believe the worst is past. Though there is still no sign of Misija."
msgstr "Кажется, самое опасное позади. Но Мисии нигде не видно."

#. ja: あの光は…！？
#. de: Seht ihr dieses blaue Leuchten?
#. fr: Regardez, au fond<nbsp>! Quelle est cette étrange lueur bleue<nbsp>?
msgctxt "NpcYell:10848:0:13"
msgid "What is that light...?"
msgstr "Что это за свет?.."

#. ja: コケーッ！
#. de: Bok-bok BOKAAAWK!
#. fr: Cot cot<nbsp>! Codêêêêt<nbsp>!
msgctxt "NpcYell:10851:0:13"
msgid "Bok-bok BAKAWK!"
msgstr "Ко-ко-ко-ко! Кудах-тах-тах!"

#. ja: ココッ！
#. de: \<kluck> \<kluck>
#. fr: Codêêêt<nbsp>!
msgctxt "NpcYell:10852:0:13"
msgid "Cluck cluck!"
msgstr "Ко-ко! Ко-ко!"

#. ja: ぐわぁ　なにをすーる！？
#. de: Gah! Was soll das werden?!
#. fr: Quoiiiii<nbsp>!? Qu'est-ce que c'est que ça<nbsp>?
msgctxt "NpcYell:10854:0:13"
msgid "Argh! Wh-What sorcery is this!?"
msgstr "А-а! Ч-что это за колдовство?!"

#. ja: ああ、わかった！
#. de: Verstanden!
#. fr: Tu peux compter sur moi<nbsp>!
msgctxt "NpcYell:10855:0:13"
msgid "Understood!"
msgstr "Понял!"

#. ja: そうはさせん！
#. de: Ganz sicher nicht!
#. fr: Bas les pattes<nbsp>!
msgctxt "NpcYell:10856:0:13"
msgid "No you don't!"
msgstr "Не выйдет!"

#. ja: はぁ…はぁ…
#. de: \<keuch> \<schnauf>
#. fr: Haaa... Haaa...
msgctxt "NpcYell:10857:0:13"
msgid "\\<huff> \\<huff>"
msgstr "\\<пых> \\<пых>"

#. ja: くっ…
#. de: Uff<nbsp>...
#. fr: Argh...
msgctxt "NpcYell:10858:0:13"
msgid "Ungh..."
msgstr "Ух..."

#. ja: ダメ…なのか…
#. de: Noch nicht genug<nbsp>...?
#. fr: Aah... Ça n'a pas marché<nbsp>?
msgctxt "NpcYell:10859:0:13"
msgid "Is it still not enough...?"
msgstr "И этого всё ещё мало?.."

#. ja: さっそく詠唱を始めるわ！
#. de: Ich beginne mit dem Heilritual!
#. fr: Je prépare le sort, couvrez-moi<nbsp>!
msgctxt "NpcYell:10860:0:13"
msgid "I'm beginning the incantation!"
msgstr "Начинаю читать заклинание!"

#. ja: コボルド族を拘束する！
#. de: Und jetzt die Fesseln!
#. fr: Je m'occupe d'immobiliser les Kobolds<nbsp>!
msgctxt "NpcYell:10861:0:13"
msgid "Time for the chain!"
msgstr "Пора сковать их цепями!"

#. ja: 女王陛下ノ為ニ…！
#. de: Für die Königin!
#. fr: Pour Gunnhildr<nbsp>!
msgctxt "NpcYell:10862:0:13"
msgid "In the name of the queen!"
msgstr "За королеву!"

#. ja: 侵略者ヲ迎エ討テ！
#. de: Werft die Eindringlinge zurück!
#. fr: Repoussez les envahisseurs<nbsp>!
msgctxt "NpcYell:10863:0:13"
msgid "Those who play are already lost."
msgstr "Сражающиеся уже обречены."

#. ja: 死ヲ恐レルナ…！
#. de: Wir fürchten den Tod nicht!
#. fr: Nous ne craignons pas la mort<nbsp>!
msgctxt "NpcYell:10864:0:13"
msgid "Your demise is ordained."
msgstr "Ваша гибель предрешена."

#. ja: 装填完了…<br>攻撃準備ヨシ！
#. de: Aufladen beendet. Angriff erfolgt.
#. fr: Chargement terminé<nbsp>! Prêt à tirer<nbsp>!
msgctxt "NpcYell:10865:0:13"
msgid "Weapons armed."
msgstr "Оружие заряжено."

#. ja: 剣ノ型…！
#. de: Das Schwert!
#. fr: Posture de l'épée<nbsp>!
msgctxt "NpcYell:10866:0:13"
msgid "By this sword!"
msgstr "Мечом клянусь!"

#. ja: 盾ノ型…！
#. de: Der Schild!
#. fr: Posture du bouclier<nbsp>!
msgctxt "NpcYell:10867:0:13"
msgid "By this shield!"
msgstr "Щитом клянусь!"

#. ja: 我ガ剣デ…<br>斬リ裂イテヤル…！
#. de: Mein Schwert wird eure Ränge durchschneiden!
#. fr: L'assaut de ma lame déchirera vos rangs<nbsp>!
msgctxt "NpcYell:10868:0:13"
msgid "I shall cleave you asunder!"
msgstr "Я разрублю вас на части!"

#. ja: 我ガ盾デ…<br>突キ崩シテミセル…！
#. de: Mein Schild wird euch zurückwerfen!
#. fr: La charge de mon bouclier enfoncera vos défenses<nbsp>!
msgctxt "NpcYell:10869:0:13"
msgid "Dash yourselves against me!"
msgstr "Ну-ка, попробуйте меня одолеть!"

#. ja: 重ミヲ統ベル力ヨ…！
#. de: Könnt ihr der Last widerstehen?
#. fr: Un poids à toute chose<nbsp>!
msgctxt "NpcYell:10870:0:13"
msgid "Know the weight of this burden..."
msgstr "Узнайте, что такое тяжесть этого бремени..."

#. ja: 重キハ軽ク…<br>軽キハ重ク…
#. de: Schwer wie eine Feder, leicht wie Blei<nbsp>...
#. fr: Aussi lourd qu'une plume, aussi léger que le plomb...
msgctxt "NpcYell:10871:0:13"
msgid "Heavy as a feather, yet light as stone."
msgstr "Тяжёлый, как перо, и лёгкий, как камень."

#. ja: 幻体ヲ紡グ…！
#. de: Aus Äther gewebte Illusionen<nbsp>...
#. fr: Illusions tissées d'éther...
msgctxt "NpcYell:10872:0:13"
msgid "I am all and I am none... Who am I?"
msgstr "Я — всё и ничто... Кто я?"

#. ja: 実体ヲ与エル…！
#. de: Nehmt Gestalt an!
#. fr: Prenez forme<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:10873:0:13"
msgid "Do you <i>see</i>?"
msgstr "Ты <i>видишь</i>?"

#. ja: 我ガ射撃ニ死角ナシ！
#. de: Vor meinem Angriff gibt es kein Entkommen!
#. fr: Vous aurez beau chercher, vous ne trouverez chez moi aucun angle mort<nbsp>!
msgctxt "NpcYell:10874:0:13"
msgid "Be still, that your death be clean."
msgstr "Смирись, и смерть твоя будет быстрой."

#. ja: 連携攻撃ダ…！
#. de: Koordinierter Angriff!
#. fr: Attaque coordonnée<nbsp>!
msgctxt "NpcYell:10875:0:13"
msgid "We stand aligned!"
msgstr "Мы действуем сообща!"

#. ja: 連携攻撃、開始スル！
#. de: Beginnt den Angriff!
#. fr: Finissons-en<nbsp>!
msgctxt "NpcYell:10876:0:13"
msgid "We see your end!"
msgstr "Твой конец близок!"

#. ja: 連携攻撃…<br>避ケラレルカ…！
#. de: Erwartet keine Gnade!
#. fr: Vous ne pourrez l'esquiver<nbsp>!
msgctxt "NpcYell:10877:0:13"
msgid "We know your moves!"
msgstr "Мы знаем каждый твой шаг!"

#. ja: 連携攻撃、準備ヨシ！
#. de: Bereit zum Angriff!
#. fr: Paré pour mouvement à deux<nbsp>!
msgctxt "NpcYell:10878:0:13"
msgid "We strike as one!"
msgstr "Ударим разом!"

#. ja: ココガ…正念場ゾ…
#. de: Das ist der<nbsp>... Moment der Entscheidung<nbsp>...
#. fr: La BaTaIlLe DéCiSiVe... CoMmEnCe...
msgctxt "NpcYell:10879:0:13"
msgid "Lives...shall be forfeit..."
msgstr "Жизни... оборвутся..."

#. ja: ミナギル…<br>ミナギッ…テ…キタゾッ…
#. de: So macht das<nbsp>... erst richtig<nbsp>... Spaß<nbsp>...
#. fr: La GlOiRe... N'aTtEnD pAs...
msgctxt "NpcYell:10880:0:13"
msgid "You shall...not...pass..."
msgstr "Вам... не... пройти..."

#. ja: イキ…マス…ヨ…
#. de: Ich ... komme!
#. fr: Hé Hé... C'eSt PaRtI..
msgctxt "NpcYell:10881:0:13"
msgid "The end...is nigh..."
msgstr "Конец... близок..."

#. ja: 忠義の精兵たちよ…！<br>我が命に従え！
#. de: Befolgt meine Befehle, treue Soldaten!
#. fr: Suivez mes ordres, fidèles soldats<nbsp>!
msgctxt "NpcYell:10882:0:13"
msgid "Come, my blades. Defend your queen!"
msgstr "Вперёд, мои верные воины! Защитите королеву!"

#. ja: 断ち斬るッ…！
#. de: Schmeckt die Klinge des heiligen Schwertes!
#. fr: Goûtez au tranchant de l'épée sacrée<nbsp>!
msgctxt "NpcYell:10883:0:13"
msgid "Begone with you!"
msgstr "Прочь с дороги!"

#. ja: 五月蝿いッ…！
#. de: Lästige Bande!
#. fr: Bande d'entêtés<nbsp>!
msgctxt "NpcYell:10884:0:13"
msgid "Kneel!"
msgstr "На колени!"

#. ja: 喰らえッ…！
#. de: Nehmt das!
#. fr: Évitez ça pour voir<nbsp>!
msgctxt "NpcYell:10885:0:13"
msgid "You dare defy me!?"
msgstr "Вы смеете мне перечить?!"

#. ja: 斬り刻むッ…！
#. de: Ich schneide euch in Stücke!
#. fr: Je vais vous tailler en pièces<nbsp>!
msgctxt "NpcYell:10886:0:13"
msgid "Enough!"
msgstr "Хватит!"

#. ja: 女王陛下ノ為ニ…！
#. de: Für Gunnhildr!
#. fr: Pour Gunnhildr<nbsp>!
msgctxt "NpcYell:10887:0:13"
msgid "In the name of the queen!"
msgstr "За королеву!"

#. ja: 女王陛下、バンザイ…！
#. de: Lang lebe die Königin!
#. fr: Longue vie à notre Reine<nbsp>!
msgctxt "NpcYell:10888:0:13"
msgid "Long live the queen!"
msgstr "Да здравствует королева!"

#. ja: チッ…<br>押されているか…！
#. de: Sie drängen uns zurück.
#. fr: Hmpf<nbsp>! Ils parviennent à nous repousser<nbsp>!
msgctxt "NpcYell:10889:0:13"
msgid "Hmph. An admirable effort, Bajsaljen, I'll give you that."
msgstr "Хмф... Байсальен, должен признать, вы неплохо сопротивляетесь."

#. ja: 邪魔をするな！
#. de: Aus dem Weg!
#. fr: Hors de mon chemin<nbsp>!
msgctxt "NpcYell:10890:0:13"
msgid "I will end you!"
msgstr "С дороги!"

#. ja: 食らえッ！
#. de: Nimm das!
#. fr: Bouffe ça<nbsp>!
msgctxt "NpcYell:10891:0:13"
msgid "You won't find mercy here!"
msgstr "Пощады не будет!"

#. ja: 思い知れッ！
#. de: Ihr habt es so gewollt!
#. fr: Vous l'aurez voulu<nbsp>!
msgctxt "NpcYell:10892:0:13"
msgid "You brought this on yourselves!"
msgstr "Сами напросились!"

#. ja: させない！
#. de: Niemals!
#. fr: Ça ne se passera pas comme ça<nbsp>!
msgctxt "NpcYell:10893:0:13"
msgid "No you don't!"
msgstr "Не позволю!"

#. ja: 私にできることを…！
#. de: Ich gebe alles!
#. fr: Je vais faire ce que je peux<nbsp>!
msgctxt "NpcYell:10894:0:13"
msgid "We mustn't give up!"
msgstr "Мы не должны сдаваться!"

#. ja: ここは私が…！
#. de: Ich übernehm das hier.
#. fr: Laissez-moi faire<nbsp>!
msgctxt "NpcYell:10895:0:13"
msgid "We must stop them here!"
msgstr "Нужно остановить их здесь!"

#. ja: 好きにはさせん！
#. de: Diese Schande lasse ich nicht zu!
#. fr: Vous devrez me passer sur le corps<nbsp>!
msgctxt "NpcYell:10896:0:13"
msgid "Yield and we may yet show mercy!"
msgstr "Сдавайтесь — и, может быть, я вас пощажу!"

#. ja: 同胞は傷つけさせません！
#. de: Ich gebe mein Leben für meine Kameraden!
#. fr: Je ne vous laisserai pas faire de mal aux miens<nbsp>!
msgctxt "NpcYell:10897:0:13"
msgid "My brothers and sisters have suffered enough!"
msgstr "Моим соратникам и так досталось!"

#. ja: ボズヤのために…！
#. de: Für Bozja!
#. fr: Ma vie pour Bozja<nbsp>!
msgctxt "NpcYell:10898:0:13"
msgid "For Bozja!"
msgstr "За Бозью!"

#. ja: 我々でアリゼーを護ろう！
#. de: Schützen wir Alisaie!
#. fr: Il faut protéger Alisaie<nbsp>!
msgctxt "NpcYell:10899:0:13"
msgid "We must protect Alisaie!"
msgstr "Нужно защитить Ализе!"

#. ja: よし、魔力をアリゼーに……！
#. de: Gut, nun alle Magie an Alisaie.
#. fr: Et maintenant, on envoie ça à Alisaie<nbsp>!
msgctxt "NpcYell:10900:0:13"
msgid "Here you are, Alisaie!"
msgstr "Вот, Ализе!"

#. ja: アリゼー、送るよ！
#. de: Bitte sehr!
#. fr: Alisaie, je t'envoie mon énergie<nbsp>!
msgctxt "NpcYell:10901:0:13"
msgid "Here it comes, Alisaie!"
msgstr "Лови, Ализе!"

#. ja: 私に魔力を送って！
#. de: Spendet mir euren Äther!
#. fr: Donnez-moi votre énergie<nbsp>!
msgctxt "NpcYell:10902:0:13"
msgid "Lend me your aether!"
msgstr "Поделитесь со мной эфиром!"

#. ja: まだ足りない…もっと魔力を！
#. de: Mehr, das reicht nicht!
#. fr: C'est pas assez, il m'en faut plus<nbsp>!
msgctxt "NpcYell:10903:0:13"
msgid "More! I need more aether!"
msgstr "Ещё! Мне нужно больше эфира!"

#. ja: もう少し…お願い…ッ！
#. de: Noch ein kleines bisschen!
#. fr: Allez, encore un peu<nbsp>! On y est presque<nbsp>!
msgctxt "NpcYell:10904:0:13"
msgid "Just a little more!"
msgstr "Ещё чуть-чуть!"

#. ja: 何をモタモタしていーる！？
#. de: Strengt euch mehr an! Los, tötet sie!
#. fr: Rhaa ça traîne tout ça<nbsp>! Qu'est-ce vous faites<nbsp>?
msgctxt "NpcYell:10905:0:13"
msgid "What's the matter with you!? Fight harder!"
msgstr "Да что с вами!? Деритесь лучше!"

#. ja: これで終いーだ！
#. de: In den Staub mit ihnen!
#. fr: C'en est fini pour toi, oui oui<nbsp>!
msgctxt "NpcYell:10906:0:13"
msgid "Crush them! Defeat, destroy, crush!"
msgstr "Раздавите их! Победить, уничтожить, раздавить!"

#. ja: 早く片付けてしまーえ！
#. de: Vernichtet sie! Zerschmettert sie!
#. fr: Allez<nbsp>! Débarassez-moi d'eux, oui oui<nbsp>!
msgctxt "NpcYell:10907:0:13"
msgid "Finish them fast! Swiftly, quickly, fast!"
msgstr "Покончи с ними поскорее! Быстро, живо, скорее!"

#. ja: 例のものを投入するのーだ！
#. de: Zeit für unseren speziellen Freund! Kekekeke!
#. fr: Préparez notre arme secrète, oui<nbsp>!
msgctxt "NpcYell:10908:0:13"
msgid "Release the special unit! Unchain, unleash, release!"
msgstr "Выпустить особый отряд! Освободить, спустить с цепи, выпустить!"

#. ja: 職人方の協力で、物資も十分に集まってきた！<br>復興共同作業を始めよう！
#. de: Wir haben jetzt ausreichend Material, um loszulegen.<br>Die vierte Aufbauphase möge beginnen!
#. fr: On a rassemblé les matériaux nécessaires grâce à nos fiers collègues<nbsp>! On va pouvoir se remettre au boulot<nbsp>!
msgctxt "NpcYell:10909:0:13"
msgid "We're set with supplies─now it's up to us to put them to good use!"
msgstr "Припасы собраны — теперь дело за нами! Пора пустить их в ход!"

#. ja: まずはリズンソング文化区西の整備だ！<br>瓦礫を切り崩し、破片の運搬を頼む！
#. de: Wir beginnen im westlichen Himmelsang.<br>Schutt und Geröll müssen beseitigt werden!
#. fr: On commence par la partie ouest du Nouveau Refrain<nbsp>! Comme d'habitude, on va d'abord déblayer les débris<nbsp>!
msgctxt "NpcYell:10910:0:13"
msgid "Our work begins in the western Risensong Quarter! Let's clear the rubble so the city can rise again!"
msgstr "Начнём с западной части квартала Восходящей песни! Разберём завалы, чтобы город снова поднялся!"

#. ja: 久々だからな、<br>安全にはとくに気をつけるんだぞ！
#. de: Eins nach dem anderen. Sicherheit geht vor!
#. fr: Allez-y doucement le temps de reprendre vos marques, par contre. Je veux pas voir d'accidents<nbsp>!
msgctxt "NpcYell:10911:0:13"
msgid "I know it's been a while for some of you. Remember: safety always comes first!"
msgstr "Знаю, многие давно не работали. Помните: безопасность прежде всего!"

#. ja: よし、復興共同作業開始だッ！<br>準備はいいかあ！？
#. de: Endlich geht es weiter. Hoffe, alles ist sauber vorbereitet.
#. fr: J'espère que vous êtes prêts, mes loulous, parce qu'on passe à l'étape suivante<nbsp>!
msgctxt "NpcYell:10912:0:13"
msgid "All right! It's time to begin concerted works. Everyone together, now!"
msgstr "Ну что, за дело! Пора приниматься за общую работу. Все вместе!"

#. ja: 今回はリズンソング文化区西の清掃を行う！
#. de: Legen wir los. Das westliche Himmelsang muss blitzblank werden!
#. fr: Maintenant qu'on a retiré les plus gros gravats de la partie ouest du Nouveau Refrain, on va passer un bon coup de balai<nbsp>!
msgctxt "NpcYell:10913:0:13"
msgid "Our next task is to tidy up the western Risensong Quarter. I want it lookin' spotless!"
msgstr "Следующая задача — привести в порядок западную часть квартала Восходящей песни. Хочу, чтобы там всё блестело!"

#. ja: 「微細な瓦礫片」を片付けて、<br>人が行き来できるようにしてくれ！
#. de: Der feine Schutt muss weg, damit man gefahrlos die Baustellen erreichen kann!
#. fr: Allez, faites en sorte qu'on puisse y marcher pieds nus sans se blesser, je veux sentir la caresse de la pierre à chaque pas<nbsp>!
msgctxt "NpcYell:10914:0:13"
msgid "Clean up the fine debris and clear a path to the construction sites!"
msgstr "Уберите мелкие обломки и расчистите путь к стройкам!"

#. ja: 物資は十分だな！<br>さあ、復興共同作業に取り掛かろう！
#. de: Das ist genug Material! Beginnen wir mit den Fundamentarbeiten!
#. fr: Un stock de matériaux plein à ras bord, c'est ça que j'aime<nbsp>!
msgctxt "NpcYell:10915:0:13"
msgid "We've an ample supply of materials. Let's get the concerted works underway!"
msgstr "Материалов у нас в достатке. Пора приниматься за общую работу!"

#. ja: リズンソング文化区西を舗装する！<br>「物資集積場」から物資を取ったら、作業を始めてくれ！
#. de: Auf zu den Materialstapeln für das westliche Himmelsang. Ohne Baustoffe, keine Gebäude!
#. fr: On va commencer les travaux du Nouveau Refrain à proprement parler, enfin, la moitié ouest déjà<nbsp>!
msgctxt "NpcYell:10916:0:13"
msgid "It's time to pave the western Risensong Quarter! Help yourselves to supplies from the piles, and let's get to work!"
msgstr "Пора мостить западную часть квартала Восходящей песни! Берите припасы со складских куч и за работу!"

#. ja: 一帯の整備も大詰めだ！<br>気合入れるぞッ！
#. de: Wir haben es fast geschafft. Legen wir uns ins Zeug, Leute!
#. fr: Servez-vous dans les piles<nbsp>! Et courage<nbsp>! On en voit le bout<nbsp>!
msgctxt "NpcYell:10917:0:13"
msgid "Look at these streets! The task is almost done─don't lose focus till the end!"
msgstr "Гляньте, какие улицы! Почти закончили — не сбавляйте темп до самого конца!"

#. ja: 今回の復興共同作業から、<br>リズンソング文化区西に住居を建築していく！
#. de: Ausgezeichnet, jetzt können wir mit dem Bau der Gebäude beginnen!
#. fr: Il est temps de construire les habitations de l'ouest du Nouveau Refrain<nbsp>!
msgctxt "NpcYell:10918:0:13"
msgid "In this round of concerted works, we'll be buildin' residences in the western Risensong Quarter."
msgstr "В этот раз на западной части квартала Восходящей песни будем строить жилые дома."

#. ja: 新たな住居の建設のため、<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Besorgt euch das Material vom Materialstapel und beginnt mit der Konstruktion der Bauteile für die Häuser!
#. fr: Les piles de matériaux sont déjà prêtes<nbsp>! Vous avez qu'à vous servir<nbsp>!
msgctxt "NpcYell:10919:0:13"
msgid "You'll find all the materials you need in the supply piles. Now let's get building!"
msgstr "Все нужные материалы найдёте в складских кучах. А теперь за строительство!"

#. ja: 家は人の心の拠り所。<br>その基底部だ、丁寧に作っていこう！
#. de: Ishgard ist ein kaltes Pflaster. Saubere Maßarbeit ist angesagt, sonst zieht es durch alle Ritzen!
#. fr: Et appliquez-vous<nbsp>! Je veux que ceux qui y logeront sentent que ça a été bâti avec amour<nbsp>!
msgctxt "NpcYell:10920:0:13"
msgid "I don't want to see a single brick out of place! Can't have a cold draft sneakin' in on a cold winter's night."
msgstr "Ни одного кирпича криво! Не хватало ещё, чтобы в зимнюю ночь сквозило из щелей."

#. ja: 今回の復興共同作業は、<br>引き続き住居の建築だ！
#. de: Es geht weiter mit den Wohngebäuden. An die Arbeit!
#. fr: Allez, on se relâche pas<nbsp>! Il nous reste encore un peu de travail<nbsp>!
msgctxt "NpcYell:10921:0:13"
msgid "For this round of concerted works, we'll be buildin' still more residences."
msgstr "В этот раз продолжим строить жилые дома."

#. ja: 作業中の住居を完成させよう！<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Beenden wir die Arbeiten an den Wohnhäusern!<br>Greift euch Material vom Materialstapel und legt euch ins Zeug!
#. fr: Vous avez déjà vu des maisons sans toit<nbsp>? Moi non plus<nbsp>!
msgctxt "NpcYell:10922:0:13"
msgid "Time to put the finishin' touches on these houses! All the materials you need are in the supply piles─let's keep it moving!"
msgstr "Пора доделать эти дома! Все нужные материалы — в складских кучах. Не стоим на месте!"

#. ja: 文化区の名に恥じない住宅を、<br>俺たちの手で作ってやろうじゃないか！
#. de: Das Kulturviertel soll Häuser bekommen, die schön anzuschauen und kunstvoll errichtet sind!
#. fr: On parle du centre culturel d'Azurée là<nbsp>! Alors au travail<nbsp>!
msgctxt "NpcYell:10923:0:13"
msgid "Let's give them houses befittin' a district of class and culture!"
msgstr "Давайте построим дома, достойные культурного квартала!"

#. ja: よし、物資は問題なしだ！<br>復興共同作業を始めるぞ！
#. de: Das Material ist geprüft und steht bereit. Die Wieder<shy>aufbauarbeiten können weitergehen!
#. fr: Les amis, c'est l'heure d'ouvrager collectivement, si j'ose dire<nbsp>!
msgctxt "NpcYell:10924:0:13"
msgid "Supplies, check! All right, everyone─let's get the concerted works off the ground!"
msgstr "Припасы на месте! Ну что, все вместе — начинаем общую работу!"

#. ja: 新たな住居の建設のため、<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Wieder heißt es Gebäude errichten. Das Material bekommt ihr von den entsprechenden Materialstapeln!
#. fr: On passe à une autre série d'habitations, aujourd'hui. C'est qu'il faut de la place pour tout le monde<nbsp>!
msgctxt "NpcYell:10925:0:13"
msgid "We've got more houses what need buildin'! Help yourself to the supplies, and let's show them what we can do!"
msgstr "Нужно построить ещё дома! Берите припасы и покажем, на что мы способны!"

#. ja: さあ、この区画にも、<br>イイ住居を建設していこうッ！
#. de: Dieses Viertel soll eine Augenweide werden!
#. fr: Allez, je vais pas vous tenir par la main non plus. Sachez juste que les piles de matériaux sont là<nbsp>!
msgctxt "NpcYell:10926:0:13"
msgid "As they say, home is where the heart is. Let's give our residents abodes they'll be happy to return to on a cold Ishgardian night!"
msgstr "Как говорится, дом — там, где сердце. Давайте построим жильё, куда жителям будет приятно возвращаться холодными ишгардскими ночами!"

#. ja: 復興共同作業を開始するッ！
#. de: Die Wieder<shy>aufbauarbeiten können weitergehen!
#. fr: Bon, on va pas laisser ces baraques en plan comme ça<nbsp>!
msgctxt "NpcYell:10927:0:13"
msgid "All as one, now, everyone! Commence the concerted works!"
msgstr "Все вместе, за работу! Начинаем общую работу!"

#. ja: 作業中の住居を完成させよう！<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Bringen wir diese Phase zu Ende. Dachgiebel errichten und Fenster einsetzen. Die Häuser machen wir noch heute fertig!
#. fr: Finissons-en avec cette série, et on pourra passer à la suite<nbsp>!
msgctxt "NpcYell:10928:0:13"
msgid "These houses are lookin' more livable by the moment! Grab the last batch of supplies and let's finish the job!"
msgstr "С каждым мигом эти дома всё уютнее! Берите последнюю партию припасов и заканчиваем!"

#. ja: 職人技術の見せ所だ！<br>皆、がんばってくれ！
#. de: Das ist eure Chance, euer Können unter Beweis zu stellen! Legt euch ins Zeug!
#. fr: C'est pas pour autant que je veux du travail de sagouins, hein<nbsp>? Montrez-moi l'étendue de votre savoir-faire<nbsp>!
msgctxt "NpcYell:10929:0:13"
msgid "This is your time to shine, artisans! Don't slack off until the job is done!"
msgstr "Мастера, сейчас ваш звёздный час! Не расслабляйтесь, пока не закончите!"

#. ja: 準備はいいか！？<br>復興共同作業を始めるぞッ！
#. de: Die Vor<shy>bereitungen sind abgeschlossen? Gut. Dann an die Arbeit!
#. fr: Rassemblement<nbsp>! On passe aux dernières maisons de la partie ouest du Nouveau Refrain<nbsp>!
msgctxt "NpcYell:10930:0:13"
msgid "Ready, skybuilders? It's time to show what you're made of!"
msgstr "Все готовы, строители Твёрди? Пора показать, чего вы стоите!"

#. ja: 新たな住居の建設のため、<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Weitere Gebäude stehen auf dem Bauplan. Das Material steht bereit. Packen wir es an!
#. fr: Vous connaissez le refrain, hé hé hé<nbsp>! Y a des piles, et y a qu'à se servir dedans<nbsp>!
msgctxt "NpcYell:10931:0:13"
msgid "More houses is the order of the day! Now grab some supplies an' start buildin'!"
msgstr "Сегодня строим новые дома! Берите припасы и за дело!"

#. ja: 多くの人が住めるよう、<br>どんどん家を建てていこう！
#. de: Das Interesse am neuen Viertel ist gewaltig. Wir brauchen zahlreiche Behausungen, um der Nachfrage gerecht zu werden!
#. fr: Plus on bâtira de maisons, mieux ce sera<nbsp>!
msgctxt "NpcYell:10932:0:13"
msgid "This residence quarter's goin' to be in high demand. Let's build houses people will be proud to call home!"
msgstr "В этом жилом квартале будет не протолкнуться. Давайте построим дома, которыми жильцы будут гордиться!"

#. ja: 物資よーし！<br>皆、復興共同作業を始めるぞ！
#. de: Das Material liegt bereit zur Verarbeitung! Worauf wartet ihr noch?<br>Greift die Werkzeuge und tut, was ihr am besten könnt!
#. fr: Et voilà, on a les matériaux qu'il nous faut<nbsp>!
msgctxt "NpcYell:10933:0:13"
msgid "The materials have been assembled, so let's get the concerted works underway!"
msgstr "Материалы собраны, пора приниматься за общую работу!"

#. ja: 作業中の住居を完成させよう！<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Die neuen Behausungen sind so gut wie fertig.<br>Greift euch Material und macht euch ans Werk!
#. fr: On va terminer les maisons qu'on avait commencé à bâtir ici<nbsp>!
msgctxt "NpcYell:10934:0:13"
msgid "Just a bit more work, and these houses will be fit for livin'. Keep it up, skybuilders!"
msgstr "Ещё немного — и в этих домах можно будет жить. Так держать, строители Твёрди!"

#. ja: このあたりの住居は、今回で一区切りだ！<br>気張っていこうッ！
#. de: Wenn wir diese hübschen Häuschen fertig haben, ist der Westteil von Himmelsang fertig!<br>Legt euch in die Riemen!
#. fr: Je vous rassure, c'est les dernières pour cette partie du Nouveau Refrain<nbsp>! Mais appliquez-vous quand même, OK<nbsp>!?
msgctxt "NpcYell:10935:0:13"
msgid "Once these houses go up, our work in the western Risensong Quarter will be complete! This is no time to slacken off!"
msgstr "Когда дома будут готовы, западную часть квартала Восходящей песни можно будет считать завершённой! Сейчас не время расслабляться!"

#. ja: 今回の復興共同作業から、<br>ここに「詩伯門」を建築していくぞ！
#. de: Der erste große Schritt ist getan!<br>Nun machen wir uns an die Balladenpassage, ein prächtiges Tor, das Himmelsang mit dem Rest Ishgards verbindet!
#. fr: Cette fois-ci, on va construire la porte des Industrieux<nbsp>!
msgctxt "NpcYell:10936:0:13"
msgid "For today's round of concerted efforts, we'll be gettin' to work on Bright Ballad's Passage."
msgstr "Сегодня в ходе общей работы начнём строить Проход Светлой баллады."

#. ja: 「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Zunächst heißt es wieder Material sammeln und wichtige Baustoffe herstellen, Freunde des Handwerks!
#. fr: Les matériaux sont prêts, y a qu'à se servir<nbsp>!
msgctxt "NpcYell:10937:0:13"
msgid "Help yourself to the materials you need, and let's get to buildin'!"
msgstr "Берите нужные материалы и за строительство!"

#. ja: この先へと繋がる上層のため、<br>立派な門にしようじゃないか！
#. de: Die Balladenpassage verbindet die Himmelstadt mit dem Strebewerk! Entsprechend prächtig wird es werden!
#. fr: Ah, et elle reliera Azurée aux Contreforts, alors je veux que ça en impose, compris<nbsp>!?
msgctxt "NpcYell:10938:0:13"
msgid "Let's put up a portal worthy of bein' the gateway between the Firmament and the Pillars!"
msgstr "Давайте построим врата, достойные быть входом в Твёрдь со Столпов!"

#. ja: 皆、復興共同作業だ！<br>今回で、「詩伯門」を完成させるぞ！
#. de: Wir kommen mit großen Schritten voran, Leute!<br>Nun kommt der zweite und letzte Teil der neuen Passage!
#. fr: Il est temps de mettre les dernières touches à la porte des Industrieux<nbsp>!
msgctxt "NpcYell:10939:0:13"
msgid "It's that time again─time for the next round of concerted works! Let's polish up Bright Ballad's Passage to a fine sheen!"
msgstr "Снова пора за общую работу! Отполируем Проход Светлой баллады до блеска!"

#. ja: 「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Das Material liegt bereit, um von euren fähigen Händen verarbeitet zu werden.<br>Jetzt keine Müdigkeit vorschützen!
#. fr: Allez, allez, on se motive, là<nbsp>! Vous avez tout ce qu'il vous faut<nbsp>!
msgctxt "NpcYell:10940:0:13"
msgid "You know where to find the supplies, so let's get to it!"
msgstr "Припасы вы знаете где найти — за работу!"

#. ja: ここが開通すれば、<br>市民の交通の便がよくなるぞ！
#. de: Es ist fast vollbracht, die Balladenpassage ist beinahe vollendet!<br>Hurra!
#. fr: Dites-vous que ce sera la seconde entrée d'Azurée, adieu les bouchons<nbsp>!
msgctxt "NpcYell:10941:0:13"
msgid "With another major portal of entry, the Firmament's sure to be livelier than ever!"
msgstr "С появлением ещё одного главного входа в Твёрди станет оживлённее, чем когда-либо!"

#. ja: 復興共同作業を始めよう！<br>今回から、リズンソング文化区東に着手する！
#. de: Jetzt beginnen die Arbeiten am zweiten Wohnquartier von Himmelsang.<br>Der Ostteil erwartet fleißige Hände und starke Rücken!
#. fr: On s'attaque à la partie est du Nouveau Refrain<nbsp>!
msgctxt "NpcYell:10942:0:13"
msgid "We commence concerted works in the eastern Risensong Quarter! Let's see those legs and arms moving!"
msgstr "Начинаем общую работу в восточной части квартала Восходящей песни! Живее, шевелитесь!"

#. ja: まずは一帯の整備だ！<br>「大きな瓦礫」を切り崩す作業を頼む！
#. de: Als Erstes müssen wir das östliche Himmelsang wieder von Schutt befreien.<br>Dafür müssen die größten Brocken zerteilt werden!
#. fr: Comme tout bon refrain qui se respecte, quand il n'y en a plus, y en a encore<nbsp>! On commence par déblayer les plus gros gravats<nbsp>!
msgctxt "NpcYell:10943:0:13"
msgid "First order of the day is clearin' out all this debris! Let's get to smashin'!"
msgstr "Для начала разберём завалы! Налегайте на лом!"

#. ja: 力を合わせて、この区画も綺麗にしていこう！
#. de: Es geht voran! Die grobe Arbeit ist getan.
#. fr: Bref, c'est reparti pour le ménage<nbsp>!
msgctxt "NpcYell:10944:0:13"
msgid "Combine your efforts an' we'll have this place fit for buildin' in no time!"
msgstr "Если взяться всем вместе, быстро подготовим это место к строительству!"

#. ja: よおしッ！　次の復興共同作業に取り掛かるぞ！
#. de: Weiter geht es mit den Wieder<shy>aufbauarbeiten!
#. fr: Rassemblez-vous<nbsp>! Nouvel ouvrage collectif<nbsp>!
msgctxt "NpcYell:10945:0:13"
msgid "That'll do! It's time to proceed to the next round of concerted works!"
msgstr "Вот и славно! Пора переходить к следующему этапу общей работы!"

#. ja: 今回はリズンソング文化区東の清掃を行う！
#. de: Das östliche Himmelsang wartet darauf, begehbar gemacht zu werden. Ans Werk!
#. fr: On peut de nouveau circuler dans l'est du Nouveau Refrain, mais ça pourrait être plus propre encore<nbsp>!
msgctxt "NpcYell:10946:0:13"
msgid "Our next task is to clean up any leftover specks of fine debris."
msgstr "Следующая задача — убрать остатки мелких обломков."

#. ja: 「微細な瓦礫片」を片付けてくれ！
#. de: Jetzt geht's an die letzten Schuttreste, die unser neues Quartier blockieren!
#. fr: Nettoyez-moi ces tas de débris fins, histoire qu'on puisse vraiment se mettre au travail<nbsp>!
msgctxt "NpcYell:10947:0:13"
msgid "I want this place lookin' spotless!"
msgstr "Хочу, чтобы здесь всё блестело!"

#. ja: よおしッ！　次の復興共同作業に取り掛かるぞ！
#. de: Weiter geht es mit den Wieder<shy>aufbauarbeiten!
#. fr: Nouvel ouvrage collectif<nbsp>! Tout le monde va devoir mettre la main à la pâte<nbsp>!
msgctxt "NpcYell:10948:0:13"
msgid "Good work, skybuilders! We move to the next phase of concerted works!"
msgstr "Отличная работа, строители Твёрди! Переходим к следующему этапу общей работы!"

#. ja: 道の舗装のため、<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Als Nächstes müssen die Straßen gepflastert werden. Greift euch das Material und legt los!
#. fr: Ces rues sont dans un état déplorable. Servez-vous dans les piles de matériaux et retapez-moi tout ça<nbsp>!
msgctxt "NpcYell:10949:0:13"
msgid "Next we'll be paving the main thoroughfare of this part of the district. Help yourself to the supplies and let's get to work!"
msgstr "Теперь вымостим главную улицу этого квартала. Берите припасы и за работу!"

#. ja: 建築の基盤となる土地だ！<br>美しく仕上げよう！
#. de: Die nächste Aufgabe ist immens wichtig. Wir legen die Fundamente für die Gebäude. Ein schiefes Haus will keiner sehen!
#. fr: On pourra rien construire tant que tout sera pas à niveau, alors je compte sur vous tous<nbsp>!
msgctxt "NpcYell:10950:0:13"
msgid "A house's only as good as its foundation! I don't want to see a single stone out of place!"
msgstr "Фундамент — основа любого дома! Ни одного камня криво!"

#. ja: さあ、復興共同作業だ！<br>今回から、建築作業に入るぞ！
#. de: Nun beginnen die Arbeiten am Gemäuer der neuen Gebäude.
#. fr: Lâchez vos godets et saisissez-vous de vos outils<nbsp>! C'est l'heure de l'ouvrage collectif<nbsp>!
msgctxt "NpcYell:10951:0:13"
msgid "It's time to raise the walls for a new block of residences. I want to see you working in perfect concert!"
msgstr "Пора возводить стены нового жилого квартала. Хочу, чтобы все работали слаженно!"

#. ja: 新たな住居の建設のため、<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Ergreift das gelieferte Material und beginnt mit den Arbeiten!
#. fr: On a tout ce qu'il nous faut, alors on va commencer la con<shy>struc<shy>tion d'habitations<nbsp>!
msgctxt "NpcYell:10952:0:13"
msgid "Now grab yourself some materials from the supply piles, and let's get buildin'!"
msgstr "Берите материалы из складских куч — и за строительство!"

#. ja: 凍えず過ごせる家を、どんどん増やしていこう！
#. de: Lassen wir all unsere Präzision und unser Können in die Arbeiten fließen! Die Häuser sollen prächtig sein und ihre Bewohner wärmen!
#. fr: Et lésinez pas sur l'isolation<nbsp>! Le froid du Coerthas peut geler les âtres<nbsp>!
msgctxt "NpcYell:10953:0:13"
msgid "This is where you put your skills to work! Let's build residences that will keep the residents of Risensong warm on the coldest of nights!"
msgstr "Вот где пригодится ваше мастерство! Построим дома, в которых жители квартала Восходящей песни не замёрзнут даже в самую холодную ночь!"

#. ja: 職人方、物資の納入に感謝する！<br>さあ、復興共同作業を始めよう！
#. de: Unseren Dank an die fleißigen Sammler, die uns diese hochwertigen Materialien beschafft haben! Damit können wir die Wieder<shy>aufbauarbeiten fortsetzen!
#. fr: On a accumulé assez de dons pour terminer les premières maisons de ce coin<nbsp>!
msgctxt "NpcYell:10954:0:13"
msgid "Our collectors worked hard to bring us these materials, so let's do our damndest to make sure they don't go to waste!"
msgstr "Сборщики потрудились, чтобы добыть эти материалы. Давайте же постараемся не пустить их труд насмарку!"

#. ja: 作業中の住居を完成させよう！<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Wir haben es fast geschafft! Die Arbeiten an den neuen Behausungen sind fast abgeschlossen. Gebt noch einmal alles. Das Material liegt bereit!
#. fr: Vous savez ce que ça veut dire<nbsp>! On se sert dans les piles<nbsp>!
msgctxt "NpcYell:10955:0:13"
msgid "The completion of our task is almost nigh! This is no time to ease up!"
msgstr "Мы почти закончили! Сейчас не время расслабляться!"

#. ja: 皆の職人技を、<br>存分に振るってほしい！
#. de: Sammler und Handwerker, zeigt der Welt euer Können!
#. fr: Faites-moi tinter ces marteaux<nbsp>! Leur son résonnera pour l'éternité dans ces montagnes<nbsp>!
msgctxt "NpcYell:10956:0:13"
msgid "It's time to show Ishgard─nay, the entire realm─your pride and skill as crafters!"
msgstr "Покажите Ишгарду — нет, всему миру — свою гордость и мастерство ремесленников!"

#. ja: 物資は十分！<br>皆、復興共同作業の時間だ！
#. de: Damit haben wir ausreichend Material für die nächste Phase gesammelt. Nun ist es Zeit, sie zu verarbeiten!
#. fr: Parfait<nbsp>! On a de quoi bosser, les enfants<nbsp>! Mettez-vous au travail<nbsp>!
msgctxt "NpcYell:10957:0:13"
msgid "We've a full inventory of supplies! Time to commence concerted works!"
msgstr "Припасов у нас вдоволь! Пора приступать к общей работе!"

#. ja: 新たな住居の建設のため、<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Es stehen weitere Gebäude auf dem Bauplan. Das Material ist bereitgestellt. Ergreift es und tut euer ehrenwertes Handwerk!
#. fr: Aujourd'hui, on va s'attaquer aux dernières habitations du Nouveau Refrain<nbsp>!
msgctxt "NpcYell:10958:0:13"
msgid "Next, we've more residences to build! Help yourself to the supplies you need and commence construction!"
msgstr "Впереди — строительство новых домов! Берите нужные припасы и начинайте!"

#. ja: これが蒼天街で建てる最後の家だ！<br>悔いのないよう、きっちりやろう！
#. de: Dies werden die letzten Behausungen der Himmelsstadt! Macht eurer Zunft alle Ehre und arbeitet mit Sorgfalt!
#. fr: Si vous voulez briller, c'est le moment ou jamais, alors mettez du cœur à l'ouvrage<nbsp>! Collectif<nbsp>! Ha ha ha<nbsp>!
msgctxt "NpcYell:10959:0:13"
msgid "This will be the last block of residences to grace the Firmament! I want to see your most masterful work yet!"
msgstr "Это будут последние жилые дома в Твёрди! Хочу увидеть вашу лучшую работу!"

#. ja: リズンソング文化区の家は、<br>今回の復興共同作業ですべて完成する予定だ！
#. de: Es ist fast geschafft! Mit dem Abschluss der kommenden Bauphase wird das östliche Himmelsang vollständig errichtet sein!
#. fr: Il est temps de terminer la con<shy>struc<shy>tion des maisons du Nouveau Refrain<nbsp>!
msgctxt "NpcYell:10960:0:13"
msgid "The end is in sight, skybuilders! With the completion of this task, our works in the eastern Risensong Quarter will be complete!"
msgstr "Конец уже близок, строители Твёрди! Когда закончим, восточная часть квартала Восходящей песни будет готова!"

#. ja: 作業中の住居を完成させよう！<br>「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Es fehlen noch die Dach- und Fassadenarbeiten sowie der Innenausbau. Worauf wartet ihr noch? Das Material liegt bereit!
#. fr: Servez-vous dans les piles<nbsp>! On a tout ce qu'il faut<nbsp>!
msgctxt "NpcYell:10961:0:13"
msgid "These residences are still just a shell of what they need to be! We've no shortage of supplies, so let's start buildin'!"
msgstr "Пока эти дома — лишь голые стены! Материалов хватает, так что пора за строительство!"

#. ja: 協力して、満足いく家をおっ建てようぜ！
#. de: Errichtet diese prächtigen Bauwerke und der ewige Dank der Bürger wird euch sicher sein!
#. fr: Bossez main dans la main, et con<shy>strui<shy>sons les plus chaleureuses maisonnées d'Ishgard<nbsp>!
msgctxt "NpcYell:10962:0:13"
msgid "It's up to us to raise houses that any Ishgardian would be proud to live in!"
msgstr "Нам под силу построить дома, в которых любой ишгардец будет горд жить!"

#. ja: さあ、復興共同作業の時間だ！<br>今回から、スノーソーク浴場を造っていくぞ！
#. de: Und die Arbeiten gehen weiter! Nun errichten wir das Thermalbad Winterwonne! Ein Paradies der Erholung!
#. fr: Fini la pause<nbsp>! Croyez-le, croyez-le pas, mais on va construire des bains “floconneux”<nbsp>!
msgctxt "NpcYell:10963:0:13"
msgid "All right, everyone! It's time to begin work on Snowsoak Springs, a bathhouse where all Ishgardians can wash their worries away!"
msgstr "Ну что, все за работу! Пора строить Источники Снежной купели — купальни, где жители Ишгарда смогут смыть все тревоги!"

#. ja: 「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Wir haben die Materialien bereits zur Baustelle geschafft. Ihr könnt umgehend mit der Arbeit beginnen!
#. fr: Ayez pas peur<nbsp>! Suffit de vous servir dans les piles de matériaux et de faire ce qu'on vous dit<nbsp>!
msgctxt "NpcYell:10964:0:13"
msgid "What are you waitin' for? You see the supplies, so let's get to workin'!"
msgstr "Чего ждёте? Припасы перед вами — за работу!"

#. ja: ゆっくり湯に浸かれる憩いの場を、<br>俺たちの手で造ってやろうぜ！
#. de: Die Therme wird das Prunkstück von Himmelsang. Da werde ich persönlich mit Hand anlegen!
#. fr: Gardez juste à l'esprit que ce sera un endroit de détente<nbsp>!
msgctxt "NpcYell:10965:0:13"
msgid "Just think: a soothin' soak awaits you, too─but not until you're done with your task!"
msgstr "Только представьте: и вас ждёт расслабляющая тёплая купель. Но сначала закончите работу!"

#. ja: 待たせたな！<br>復興共同作業の開始だッ！
#. de: Und los geht es. Mögen die Wieder<shy>aufbauarbeiten beginnen!
#. fr: Ah, il était temps<nbsp>! On va pouvoir terminer ces bains<nbsp>!
msgctxt "NpcYell:10966:0:13"
msgid "And we're set to go. Let the concerted works begin!"
msgstr "Ну вот, всё готово. Начинаем общую работу!"

#. ja: 「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Wir haben die Materialien bereits zur Baustelle verbracht. Ihr könnt jederzeit loslegen!
#. fr: Tous les matériaux nécessaires sont à votre disposition, y a qu'à se servir<nbsp>!
msgctxt "NpcYell:10967:0:13"
msgid "Those supplies aren't going to carry themselves. Let's get to work!"
msgstr "Припасы сами себя не перенесут. За работу!"

#. ja: スノーソーク浴場は、今回で完成だ！<br>皆、作業が終わったら存分に湯浴みできるぞォッ！
#. de: Mit der nächsten Phase wird die Therme fertiggestellt!<br>Bald könnt ihr eure müden Knochen im heißen Wasser wärmen!
#. fr: Au boulot<nbsp>! Plus vite on aura fini, plus vite on pourra y faire trempette pour reposer nos corps éreintés<nbsp>!
msgctxt "NpcYell:10968:0:13"
msgid "Works on Snowsoak Springs have entered the final phase! Ahh, I can just feel the soothin' waters washin' over me!"
msgstr "Работы в Источниках Снежной купели вступили в завершающий этап! Ах, уже чувствую, как тёплая вода смывает усталость!"

#. ja: 蒼天街の復興共同作業もいよいよ大詰め……。<br>最後に、俺たちの手で記念碑を造ろうじゃないか！
#. de: Die Arbeiten sind vollendet, Himmelsang steht!<br>Nun fehlt nur noch das Sahnehäubchen: Das Monument der Arbeit!
#. fr: La recon<shy>struc<shy>tion d'Azurée est presque achevée<nbsp>! Il manque juste la cerise sur le gâteau<nbsp>!
msgctxt "NpcYell:10969:0:13"
msgid "We've done it, skybuilders! The restoration effort is all but complete! All that remains is to raise a monument to our efforts!"
msgstr "У нас получилось, строители Твёрди! Восстановление почти завершено! Осталось лишь воздвигнуть памятник нашим трудам!"

#. ja: 「物資集積場」から物資を取って、作業を始めてくれ！
#. de: Holt euch das Material vom Materialstapel und beginnt mit der Konstruktion!
#. fr: Un monument en notre honneur<nbsp>! Qu'est-ce que vous en dites<nbsp>!?
msgctxt "NpcYell:10970:0:13"
msgid "See those piles of supplies? I reckon you know what to do with 'em!"
msgstr "Видите эти груды припасов? Сами знаете, что делать!"

#. ja: 皆と復興共同作業を行うのもこれで最後か……。<br>ばっ、馬鹿野郎、泣いてねえよッ！
#. de: Unglaublich! Es ist vollbracht! Hurra! Hurra!<br>Die Himmelsstadt ist auferstanden! Ein Tag, der in die Annalen Ishgards eingehen wird!
#. fr: Et... Et ça marquera la fin de nos ouvrages collectifs... (snif)... Raaah<nbsp>! Un... Un flocon m'est rentré dans le coin de l'œil<nbsp>! Saleté de neige... (snif)...
msgctxt "NpcYell:10971:0:13"
msgid "Huzzah! Huzzah! The Firmament has risen to its full glory! You've done Ishgard proud, skybuilders─this is a day that will be sung of for ages to come!"
msgstr "Ура! Ура! Твёрдь наконец обрела былое величие! Вы прославили Ишгард, строители Твёрди! Этот день будут воспевать веками!"

#. ja: グオオオォ…！<br>チカラ、ミナギルゥゥ！
#. de: Wraaaaar!<br>Ich spüre die Kraaaft!
#. fr: Grraaah<nbsp>! Plus de force<nbsp>! Oui, plus<nbsp>!
msgctxt "NpcYell:10972:0:13"
msgid "Grrraaah! Flesh! Give me flesh!"
msgstr "Грррра-а-а! Плоть! Дайте мне плоть!"

#. ja: 邪魔ダ！<br>邪魔ダァァ！
#. de: Weg mit euch, weg!
#. fr: Tu vas reculer<nbsp>!
msgctxt "NpcYell:10973:0:13"
msgid "Stomp intruders!"
msgstr "Топчи чужаков!"

#. ja: 足元ニ<br>気ヲツケナァァ！
#. de: Vorsicht, Falleee!
#. fr: Bwa ha ha<nbsp>! Attention où tu mets les pieds<nbsp>!
msgctxt "NpcYell:10974:0:13"
msgid "Fickle floor! Hehehe!"
msgstr "Пол ненадёжен! Хе-хе-хе!"

#. ja: ブオオオォ…！<br>全力ダァァ…！
#. de: Graaaaar!<br>Volle Suppeee!
#. fr: Je vais te trancher en deux<nbsp>!
msgctxt "NpcYell:10975:0:13"
msgid "Heads roll! Grrroooaaarrr!!!"
msgstr "Головы полетят! Грррра-а-а!!!"

#. ja: 避ケテミヤガレェェ！
#. de: Nichts wie weeeg!
#. fr: Avec le sol pour ennemi, nulle part où te cacher<nbsp>!
msgctxt "NpcYell:10976:0:13"
msgid "No escape!"
msgstr "Не уйти!"

#. ja: 叩キ潰スゥゥ！
#. de: Ich hau euch zu Breiii!
#. fr: Ma hache te broiera<nbsp>!
msgctxt "NpcYell:10977:0:13"
msgid "Smash intruders!"
msgstr "Сокруши чужаков!"

#. ja: コレナラ、ドウダァァ！
#. de: Jetzt spritzt Bluuut!
#. fr: Plus de pièges<nbsp>! Plus de pièges<nbsp>!
msgctxt "NpcYell:10978:0:13"
msgid "Intruders stumble! Intruders die!"
msgstr "Чужаки спотыкаются! Чужаки умирают!"

#. ja: オ前ラ縮メテ<br>丸呑ミダァァ！
#. de: Ich schluck euch mit einem Happs!
#. fr: Un avorton, voilà ce que tu es<nbsp>!
msgctxt "NpcYell:10979:0:13"
msgid "Intruders small! Intruders weak!"
msgstr "Чужаки мелкие! Чужаки слабые!"

#. ja: イタダキマスゥゥ！
#. de: Guten Appetiiit!
#. fr: Miam, miam<nbsp>! Délicieuse chair<nbsp>!
msgctxt "NpcYell:10980:0:13"
msgid "Get in my belly! Grrroooaaarrr!!!"
msgstr "Сейчас я вас сожру! Грррра-а-а!!!"

#. ja: 丸焼ケダァァ！
#. de: Zeit für ein kleines Feuerchen!
#. fr: Tu feras un beau tas de cendres<nbsp>!
msgctxt "NpcYell:10981:0:13"
msgid "Burn intruders!"
msgstr "Сожги чужаков!"

#. ja: グオオオォ…！<br>本気ダゾォォ！
#. de: Wraaaaar!<br>Jetzt geht's richtig looos!
#. fr: Je vais m'énerver<nbsp>!
msgctxt "NpcYell:10982:0:13"
msgid "Bring all to bear!!!"
msgstr "Бей изо всех сил!!!"

#. ja: グラグラダァァ！
#. de: Spürt ihr's wackeln?
#. fr: Tremble<nbsp>!
msgctxt "NpcYell:10983:0:13"
msgid "No way out!"
msgstr "Никуда не деться!"

#. ja: ブッ飛バスゥゥ！
#. de: Ich mach alles platt!
#. fr: Dégage<nbsp>!
msgctxt "NpcYell:10984:0:13"
msgid "Away! Away!!!"
msgstr "Прочь! Прочь!!!"

#. ja: マダマダ、イクゾォォ！
#. de: Gleich wackelt's wieder!
#. fr: C'est reparti<nbsp>! Une pluie de pièges<nbsp>!
msgctxt "NpcYell:10985:0:13"
msgid "Intruders tumble! Intruders die!"
msgstr "Чужаки падают! Чужаки умирают!"

#. ja: 溺レ死ネェェ！
#. de: Tod den Schwachen ... und den Starken!
#. fr: Les courants t'emporteront<nbsp>!
msgctxt "NpcYell:10986:0:13"
msgid "Drown intruders!"
msgstr "Утопи чужаков!"

#. ja: ビリビリダァァ！
#. de: Achtung, das kitzeeelt!
#. fr: Voilà qui va te faire un choc<nbsp>! Ha ha ha<nbsp>!
msgctxt "NpcYell:10987:0:13"
msgid "Grrroooaaaaaahhh!!!"
msgstr "Грррра-а-а!!!"

#. ja: モットモットダァァ！
#. de: Mehr davooon!
#. fr: Encore<nbsp>! Encooore<nbsp>!
msgctxt "NpcYell:10988:0:13"
msgid "Mooore! Mooorrreee!!!"
msgstr "Ещё! Ещё-ё-ё!!!"

#. ja: グルットイクゾォォ！
#. de: Immer schön im Kreis herum!
#. fr: Encore un tour<nbsp>!
msgctxt "NpcYell:10989:0:13"
msgid "Off with their heads!"
msgstr "Снести им головы!"

#. ja: グオオオォ…<br>イライラスルゥゥ！
#. de: Wraaaaar!<br>So langsam werd ich saueeer!
#. fr: Tu vas mourir, oui<nbsp>!!?
msgctxt "NpcYell:10990:0:13"
msgid "Why won't you diiieee!!!"
msgstr "Почему вы никак не умрё-ё-ёте!!!"

#. ja: 丸焦ゲダァァ！
#. de: Brutzel, brutzel!
#. fr: Tes cendres tapisseront mon domaine<nbsp>!
msgctxt "NpcYell:10991:0:13"
msgid "All to ashes!"
msgstr "Всех в пепел!"

#. ja: ズズズ…<br>混沌ヨ、満チヨ…
#. de: Hohohooo ...<br>Möge das Chaos herrscheeen!
#. fr: Schaaaa... Sombrez dans le chaos...
msgctxt "NpcYell:10992:0:13"
msgid "Despair shall subsume those who disturb our rest!"
msgstr "Отчаяние поглотит тех, кто нарушит наш покой!"

#. ja: 爆ゼロ、混沌…！
#. de: Chaos, greif um dich!
#. fr: Le chaos est inévitable... Il vous consumera<nbsp>!
msgctxt "NpcYell:10993:0:13"
msgid "Yes, let the dark consume you!"
msgstr "Да, тьма поглотит вас!"

#. ja: 混沌ヨ、満チヨ…
#. de: Möge das Chaos herrscheeen!
#. fr: Le chaos est partout...
msgctxt "NpcYell:10994:0:13"
msgid "There is no leaving this place, mortals!"
msgstr "Смертные, отсюда не уйти!"

#. ja: 集エ…<br>亡者タチ…
#. de: Kommt, ihr Toten!
#. fr: Âmes défuntes... Rejoignez-moi...
msgctxt "NpcYell:10995:0:13"
msgid "Wayward souls of old, I bid you rise!"
msgstr "Заблудшие души прошлого, встаньте по моему зову!"

#. ja: 我ラガ恨ミヲ知レ…！
#. de: Das ist unser Hass!
#. fr: Goûtez à ma souffrance, à ma rancœur<nbsp>!
msgctxt "NpcYell:10996:0:13"
msgid "You know nothing of pain!"
msgstr "Вы не знаете, что такое боль!"

#. ja: 混沌ヨ、満チヨ…
#. de: Möge das Chaos herrscheeen!
#. fr: Le chaos est partout...
msgctxt "NpcYell:10997:0:13"
msgid "There is no leaving this place, mortals!"
msgstr "Смертные, отсюда не уйти!"

#. ja: 立チ上ガレ…<br>亡者タチ…
#. de: Erhebt euch, meine toten Freunde!
#. fr: Esprits des temps anciens... Joignez-vous à moi...
msgctxt "NpcYell:10998:0:13"
msgid "Rise, my brothers, rise! Let us add these wayward souls to our number!"
msgstr "Восстаньте, братья мои, восстаньте! Прибавим эти заблудшие души к нашим рядам!"

#. ja: 今再ビ…<br>混沌ヨ、満チヨ…
#. de: Noch einmal ...<br>Möge das Chaos herrscheeen!
#. fr: Vous ne ferez plus qu'un avec le chaos...
msgctxt "NpcYell:10999:0:13"
msgid "The dark shall consume all!"
msgstr "Тьма поглотит всех!"
