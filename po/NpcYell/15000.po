# NpcYell
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: すごいな、絶景じゃないか！
#. de: Es ist atemberaubend.
#. fr: Le paysage est splendide, ici<nbsp>!
msgctxt "NpcYell:15000:0:13"
msgid "It's breathtaking."
msgstr ""

#. ja: 滑り落ちないよう注意ね
#. de: Vorsicht, sonst rutscht du noch aus.
#. fr: Attention, il ne faudrait pas glisser.
msgctxt "NpcYell:15001:0:13"
msgid "Careful, or you might slip and fall."
msgstr ""

#. ja: 景色に見とれて落ちるなよ
#. de: Jetzt ist nicht die Zeit für Besichtigungen.
#. fr: Regardez où vous mettez les pieds.
msgctxt "NpcYell:15002:0:13"
msgid "This is no time for sightseeing, my friend."
msgstr ""

#. ja: 異端者が遺したものか…
#. de: Haben die Häretiker hier ihr Lager aufgeschlagen?
#. fr: Ça doit appartenir aux hérétiques...
msgctxt "NpcYell:15003:0:13"
msgid "Did the heretics make camp here?"
msgstr ""

#. ja: 異端者はどこいった～？
#. de: Ein verlassenes Lager?
#. fr: On dirait que les lieux ont été abandonnés...
msgctxt "NpcYell:15004:0:13"
msgid "An abandoned camp?"
msgstr ""

#. ja: でも、人の気配はないわね…
#. de: Wenn ja, sind sie schon vor langem geflohen.
#. fr: Je ne sens aucune présence humaine...
msgctxt "NpcYell:15005:0:13"
msgid "If they did, they have long since fled."
msgstr ""

#. ja: くぅ、寒い…<br>凍えそうだ…
#. de: Es ist eiskalt hier drin.
#. fr: Il fait un de ces froids<nbsp>!
msgctxt "NpcYell:15006:0:13"
msgid "It's freezing in here."
msgstr ""

#. ja: 氷のゴーレム…かしら？
#. de: Ist das ... ein Eisgolem?
#. fr: C'est un golem de glace...<nbsp>?
msgctxt "NpcYell:15007:0:13"
msgid "Is that...an ice golem?"
msgstr ""

#. ja: ファイガで溶かしてやる～
#. de: Diese Bestie hält meinem Feuer gewiss nicht stand.
#. fr: On pourrait le faire fondre avec Méga Feu<nbsp>!
msgctxt "NpcYell:15008:0:13"
msgid "Surely, the beast is no match for my fire."
msgstr ""

#. ja: さ、寒かったね～
#. de: Bei Thal, all dieses Eis<nbsp>...
#. fr: Ça se réchauffe enfin...
msgctxt "NpcYell:15009:0:13"
msgid "Thal's bloody balls, all that ice..."
msgstr ""

#. ja: 凍りつくかと思ったよ…
#. de: Ich hatte Angst, auszurutschen und mir das Genick zu brechen.
#. fr: J'ai bien cru que j'allais geler sur place...
msgctxt "NpcYell:15010:0:13"
msgid "I feared I'd slip and break my neck."
msgstr ""

#. ja: なっ、雪玉から敵が！
#. de: Ist diese Goobbue grad aus einem Schneeball gekommen?
#. fr: Un monstre se cachait dans la neige<nbsp>!
msgctxt "NpcYell:15011:0:13"
msgid "Did that goobbue just jump out of a snowball?"
msgstr ""

#. ja: どっから降ってきたのよ！？
#. de: Wo ist <i>das</i> denn hergekommen?!
#. fr: Ouah, d'où il sort<nbsp>!?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:15012:0:13"
msgid "Where did <i>this</i> come from!?"
msgstr ""

#. ja: びっくりしたな～も～
#. de: Das hat mir einen ordentlichen Schreck eingejagt!
#. fr: J'ai eu une de ces frousses<nbsp>!
msgctxt "NpcYell:15013:0:13"
msgid "Where did it even come from?"
msgstr ""

#. ja: とっても寒そうだよ～？
#. de: Warum müssen die Häretiker in solch einem rauen Klima hausen?
#. fr: Il fait un froid de canard...
msgctxt "NpcYell:15014:0:13"
msgid "Why must the heretics reside in such bitter climes?"
msgstr ""

#. ja: 寒中訓練だと思って我慢よ！
#. de: Kopf hoch. Sieh es einfach als Training an<nbsp>... <i>Extremes</i> Training.
#. fr: On doit tenir le coup<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:15015:0:13"
msgid "Chin up, friend. Try to think of this as field training... <i>Extreme</i> field training."
msgstr ""

#. ja: あの牙、いや腕に注意だな…
#. de: Passt auf seine Arme auf.
#. fr: Attention à ses bras...
msgctxt "NpcYell:15016:0:13"
msgid "Be mindful of its arms."
msgstr ""

#. ja: 分厚そうな毛皮ね<br>だけど貫く！
#. de: Es wird nicht einfach sein, sich durch all das Fell zu hacken.
#. fr: Sa fourrure a l'air épaisse, mais je couperai à travers<nbsp>!
msgctxt "NpcYell:15017:0:13"
msgid "Hacking through all that fur won't be easy."
msgstr ""

#. ja: ああ、お前ならきっとやれる！
#. de: Wenn jemand dieses dicke Fell durchdringen kann, dann du.
#. fr: Je te fais confiance.
msgctxt "NpcYell:15018:0:13"
msgid "If anyone can pierce that thick hide, it's you."
msgstr ""

#. ja: 雪玉を利用するなんて<br>なかなかの強敵だったな
#. de: Mit einer Schneeballschlacht hatte ich nicht gerechnet<nbsp>...
#. fr: Il était assez intelligent pour se servir de la neige...
msgctxt "NpcYell:15019:0:13"
msgid "A snowball fight is not what I was expecting..."
msgstr ""

#. ja: 強敵だったね、イエティ～
#. de: Ich muss mir merken, Yetis in Zukunft nicht zu unter<shy>schätzen.
#. fr: Il était fort<nbsp>!
msgctxt "NpcYell:15020:0:13"
msgid "I'll have to remember not to underestimate yetis in future."
msgstr ""

#. ja: 教皇「トールダン7世」を<br>抑えるぞ！
#. de: Wir müssen den Papst aufhalten!
#. fr: Nous devons retenir l'Archevêque<nbsp>!
msgctxt "NpcYell:15021:0:13"
msgid "We must stop the archbishop before it's too late!"
msgstr ""

#. ja: それでも勝ったのは俺たちだ！
#. de: Aber wir haben dennoch gesiegt.
#. fr: C'est pas un peu de neige qui nous arrêtera<nbsp>!
msgctxt "NpcYell:15022:0:13"
msgid "Aye. But nevertheless, we were victorious."
msgstr ""

#. ja: なんだ？<br>行き止まり…？
#. de: Hm? Eine Sackgasse?
#. fr: Tiens<nbsp>? Une impasse<nbsp>?
msgctxt "NpcYell:15023:0:13"
msgid "Hm? A dead end?"
msgstr ""

#. ja: 隠し通路でもあるのか？
#. de: Vielleicht gibt es hier irgendwo einen geheimen Durchgang.
#. fr: Il doit y avoir un chemin caché.
msgctxt "NpcYell:15024:0:13"
msgid "Perhaps there's a secret passage here somewhere."
msgstr ""

#. ja: どこかに進めるところが<br>あるはずよ！
#. de: Hier muss es doch irgendwo eine Passage geben.
#. fr: Il y a forcément une autre voie.
msgctxt "NpcYell:15025:0:13"
msgid "Surely, there's a passage through somewhere."
msgstr ""

#. ja: いたか、異端者め！
#. de: Da sind sie!
#. fr: Voilà les hérétiques<nbsp>!
msgctxt "NpcYell:15026:0:13"
msgid "There they are!"
msgstr ""

#. ja: 貫き通るのみ！
#. de: Dann müssen wir uns doch durchkämpfen?
#. fr: On fonce<nbsp>!
msgctxt "NpcYell:15027:0:13"
msgid "We need but fight our way through, then?"
msgstr ""

#. ja: 妙なエーテルを感じるよ～！<br>気をつけて～！
#. de: Wir müssen vorsichtig sein. Ich spüre einen verdorbenen Äther in der Luft.
#. fr: Attention, l'éther est anormal, ici<nbsp>!
msgctxt "NpcYell:15028:0:13"
msgid "We must be careful. I sense a foul aether in the air."
msgstr ""

#. ja: ひえ～、すごい牙～！
#. de: Oje, welch schreckliche Fangzähne!
#. fr: Ouah, regardez un peu ses crocs...
msgctxt "NpcYell:15029:0:13"
msgid "My, what terrible fangs!"
msgstr ""

#. ja: なんて大きな獣…<br>でも、訓練どおりにやれば！
#. de: Sieh sich einer die Größe dieses Wolfes an!
#. fr: Il est énorme... Mais on s'est suf<shy>fi<shy>sam<shy>ment entraînés<nbsp>!
msgctxt "NpcYell:15030:0:13"
msgid "Would you look at the size of that wolf!"
msgstr ""

#. ja: 古代種の氷狼だ…<br>噛みつかれるなよ！
#. de: Der legendäre Höllenhund<nbsp>... Mit diesem Gegner ist nicht zu spaßen.
#. fr: Attention à ne pas vous faire mordre<nbsp>!
msgctxt "NpcYell:15031:0:13"
msgid "The legendary hoarhound... This is not a foe to be trifled with."
msgstr ""

#. ja: 足場はしっかりしてるな
#. de: Hmm. Dieses Gerüst sieht stabil genug aus.
#. fr: Attention où vous mettez les pieds.
msgctxt "NpcYell:15032:0:13"
msgid "Hmmm. This scaffolding seems sturdy enough."
msgstr ""

#. ja: 鉄のガレキとクリスタル…<br>奇妙な光景だな
#. de: Interessant, wie der Kristall um die Trümmer gewachsen ist.
#. fr: Ce paysage mélangeant débris et cristaux est assez étrange...
msgctxt "NpcYell:15033:0:13"
msgid "Curious how the crystal has grown around the debris."
msgstr ""

#. ja: 塔まで道が続いていると<br>いいのだけど…
#. de: Hoffen wir, dass es einen freien Weg zur Spitze des Wracks gibt.
#. fr: J'espère que le chemin nous conduira jusqu'à la tour.
msgctxt "NpcYell:15034:0:13"
msgid "Let's hope there's a clear path up to the top of the wreckage."
msgstr ""

#. ja: 塔の中を～<br>進んでいこ～
#. de: Ich frage mich, was wir dort finden werden.
#. fr: Allez, on explore<nbsp>!
msgctxt "NpcYell:15035:0:13"
msgid "What will we find in here, I wonder?"
msgstr ""

#. ja: なんだか気が抜けるな…<br>でも、それくらいでいいのか？
#. de: Sicherlich nichts, mit dem wir nicht fertigwerden.
#. fr: Ce paysage me calme un peu... Mais c'est peut-être une bonne chose<nbsp>?
msgctxt "NpcYell:15036:0:13"
msgid "Nothing we cannot handle, surely."
msgstr ""

#. ja: 一本足の怪鳥…<br>何をしてくるのかしら？
#. de: Sind das<nbsp>... Vögel? Sie haben nur ein Bein.
#. fr: Que prépare cet oiseau à une patte<nbsp>?
msgctxt "NpcYell:15037:0:13"
msgid "Is that...a bird? It only has one leg."
msgstr ""

#. ja: 気配を複数感じる…<br>仲間がいるのか？
#. de: Ich habe das Gefühl, davon sind noch mehr in der Nähe<nbsp>...
#. fr: Je sens plusieurs présences, il n'est pas seul.
msgctxt "NpcYell:15038:0:13"
msgid "Something tells me there are more nearby..."
msgstr ""

#. ja: なにか持ってくるとか～？<br>帝国製の武器が色々あるし～
#. de: Ich fürchte, wir müssen uns um mehr als ihr ein Bein Sorgen machen.
#. fr: Ce sont des armes de l'Empire<nbsp>?
msgctxt "NpcYell:15039:0:13"
msgid "I fear we've more than its one leg to worry about."
msgstr ""

#. ja: 爆風でコロコロ<br>転がっちゃいそうだったよ～
#. de: Einen Moment lang dachte ich, sie könnten uns von dem Rumpf fegen.
#. fr: Ouf, je ne me suis pas fait emporter par le souffle des explosions.
msgctxt "NpcYell:15040:0:13"
msgid "For a moment there, I thought they might blow us from the hull."
msgstr ""

#. ja: 青燐水タンクを利用するとは<br>鳥のくせによくやるよ…
#. de: Ich wage nicht zu fragen, wie sie den Umgang mit Sprengstoffen gelernt haben.
#. fr: Il en avait dans le crâne ce piaf, pour se servir des réservoirs...
msgctxt "NpcYell:15041:0:13"
msgid "I dare not ask how they learned to use explosives like that."
msgstr ""

#. ja: まっ、それでも俺たちには<br>勝てなかったけどな！
#. de: Zum Glück zielen sie nicht besonders gut.
#. fr: Mais pas assez pour nous vaincre<nbsp>!
msgctxt "NpcYell:15042:0:13"
msgid "Thankfully, their aim was poor."
msgstr ""

#. ja: 出会いたくはなかったけど…<br>訓練どおり突破するわよ！
#. de: Garlear. Ich hatte gehofft, wir könnten ihnen aus dem Weg gehen.
#. fr: J'aurais préféré éviter ce combat...
msgctxt "NpcYell:15043:0:13"
msgid "Imperials. I had hoped we could avoid them, alas."
msgstr ""

#. ja: かち合ったからには<br>戦うしかないか…！
#. de: Jetzt gibt es kein Zurück mehr.
#. fr: On ne peut pas reculer<nbsp>!
msgctxt "NpcYell:15044:0:13"
msgid "There's no turning back now."
msgstr ""

#. ja: おし！<br>帝国兵は一網打尽だ！
#. de: Heizen wir ihnen ordentlich ein!
#. fr: Occupons-nous d'eux<nbsp>!
msgctxt "NpcYell:15045:0:13"
msgid "Let's give them what for!"
msgstr ""

#. ja: あの変圧器、何かしら…<br>障壁と関係している？
#. de: Seht mal. Ich denke, dieser Induktor hält die Barriere aufrecht.
#. fr: Ce convertisseur est lié au champ de force...<nbsp>?
msgctxt "NpcYell:15046:0:13"
msgid "Look there. I think that inductor is powering the barrier."
msgstr ""

#. ja: 魔導フィールド変圧器…<br>怪しいな、破壊するぞ！
#. de: Dieser Induktor gefällt mir nicht. Beseitigen wir ihn.
#. fr: Ce convertisseur est louche... Détruisons-le<nbsp>!
msgctxt "NpcYell:15047:0:13"
msgid "I like not the looks of that inductor. Best we get rid of it."
msgstr ""

#. ja: 任せて～<br>呪術で壊してあげる～
#. de: Überlasst das mir!
#. fr: Je vais lancer un sort dessus<nbsp>!
msgctxt "NpcYell:15048:0:13"
msgid "Leave it to me!"
msgstr ""

#. ja: 飛空艇が相手とは面白え！
#. de: Nun, mit einem Kanonenschiff habe ich ganz sicher nicht gerechnet.
#. fr: On se bat contre un aéronef maintenant<nbsp>? Intéressant<nbsp>!
msgctxt "NpcYell:15049:0:13"
msgid "Well, I certainly wasn't expecting a gunship."
msgstr ""

#. ja: 空飛ぶ敵が多いな～
#. de: So langsam bin ich es leid, aus der Luft getroffen zu werden<nbsp>...
#. fr: J'en ai assez, des ennemis volants<nbsp>!
msgctxt "NpcYell:15050:0:13"
msgid "I'm beginning to grow tired of being struck from the sky..."
msgstr ""

#. ja: その意気で頼むぜ！<br>癒やしは任せろ！
#. de: Komme was wolle, es wird euch nicht an Beistand mangeln.
#. fr: On se motive<nbsp>! Je suis là pour vous soigner<nbsp>!
msgctxt "NpcYell:15051:0:13"
msgid "Come what may, you'll not want for succor."
msgstr ""

#. ja: 案外あっけないな！
#. de: Ich dachte, es würde sich als eine größere Heraus<shy>forde<shy>rung erweisen.
#. fr: C'était plus facile que je pensais.
msgctxt "NpcYell:15052:0:13"
msgid "I thought it would prove more of a challenge than that."
msgstr ""

#. ja: 帝国軍の陣は抜けたようだな<br>あとは頂上を目指すのみ！
#. de: Ich bete, dass dies der letzte Garlear war.
#. fr: On a passé les défenses de l'Empire, plus qu'à aller au sommet<nbsp>!
msgctxt "NpcYell:15053:0:13"
msgid "I pray that was the last of the imperials."
msgstr ""

#. ja: フフ～ン、呪術のおかげだね～
#. de: War ich zu schnell für euren Geschmack?
#. fr: C'est grâce à mes sorts, tout ça<nbsp>!
msgctxt "NpcYell:15054:0:13"
msgid "Did I burn it down too quickly for your liking?"
msgstr ""

#. ja: も～、飛空艇しつこい～！
#. de: Pah, schon wieder ein Angriff aus der Luft?
#. fr: Encore un aéronef qui nous tire dessus<nbsp>!
msgctxt "NpcYell:15055:0:13"
msgid "Bah, another aerial assault?"
msgstr ""

#. ja: 愚痴はあと！<br>いまは砲撃に注意よ！
#. de: Keine Zeit zum Meckern<nbsp>- Konzentration!
#. fr: Tu te plaindras plus tard, évite les tirs<nbsp>!
msgctxt "NpcYell:15056:0:13"
msgid "No time for grumbling─focus!"
msgstr ""

#. ja: 見えてきたな、頂上！<br>あと少しだ、行くぞ！
#. de: Haltet durch. Wir sind fast da.
#. fr: Le sommet est en vue, on y est presque<nbsp>!
msgctxt "NpcYell:15057:0:13"
msgid "Hold on, everyone. We're nearly there."
msgstr ""

#. ja: もうそろそろ頂上か<br>思ったよりキツかったな…
#. de: Sind wir bald da? Meine Beine machen so langsam schlapp.
#. fr: Il était temps... C'était épuisant...
msgctxt "NpcYell:15058:0:13"
msgid "Are we almost there? I fear my legs may give out soon."
msgstr ""

#. ja: この程度でキツイだなんて<br>訓練が足りてないわよ！
#. de: Klingt, als würdest du ein härteres Trainingsprogramm benötigen.
#. fr: Un rien te fatigue<nbsp>! Tu devrais t'entraîner un peu plus<nbsp>!
msgctxt "NpcYell:15059:0:13"
msgid "Sounds to me like you need a tougher training regimen."
msgstr ""

#. ja: 幻龍が相手だろうが<br>勝つのはこっちだ！
#. de: Selbst wenn unser Feind ein großer Drache sein sollte, dürfen wir nicht ins Wanken geraten!
#. fr: C'est qu'une apparition, il peut rien contre nous<nbsp>!
msgctxt "NpcYell:15060:0:13"
msgid "Even should our enemy be a great wyrm, we mustn't falter!"
msgstr ""

#. ja: 幻龍と戦えるなんて光栄ね！
#. de: Dass wir mal mit einem großen Drachen kämpfen würden<nbsp>...
#. fr: C'est un honneur de combattre ce grand dragon.
msgctxt "NpcYell:15061:0:13"
msgid "That we should do battle with a great wyrm..."
msgstr ""

#. ja: 人の力を<br>見せてやらないとな！
#. de: Zeigen wir ihm die Stärke des Willens der Sterblichen!
#. fr: Il va voir de quoi sont faits les humains<nbsp>!
msgctxt "NpcYell:15062:0:13"
msgid "Let us show him the strength of mortal will!"
msgstr ""

#. ja: あの植物は何だったか…<br>博物誌で見たような
#. de: Ich meine, diese Pflanze schon mal gesehen zu haben, aber wo<nbsp>...?
#. fr: Je crois avoir déjà vu cette plante dans une encyclopédie...
msgctxt "NpcYell:15063:0:13"
msgid "I feel I've seen this plant's like before, but where...?"
msgstr ""

#. ja: 民と友のため戦うのみ！
#. de: Für unsere Freunde und Landsleute!
#. fr: Je combattrai pour mon peuple et mon <if $gn4>amie<else>ami</if><nbsp>!
msgctxt "NpcYell:15064:0:13"
msgid "For friends and countrymen!"
msgstr ""

#. ja: 竜毒草だ！<br>花粉に気をつけろ！
#. de: Diese Blume ist giftig, achtet auf ihre Pollen!
#. fr: Cette fleur est toxique, attention à son pollen<nbsp>!
msgctxt "NpcYell:15065:0:13"
msgid "Drakespur! Beware its pollen!"
msgstr ""

#. ja: チッ…次から次へと…！
#. de: Argh, es nimmt kein Ende.
#. fr: Argh, ça n'arrête pas<nbsp>!
msgctxt "NpcYell:15066:0:13"
msgid "Bah, more drakespur."
msgstr ""

#. ja: 足止めをするつもりか…！
#. de: Nichts wird uns aufhalten!
#. fr: Rien ne nous arrêtera<nbsp>!
msgctxt "NpcYell:15067:0:13"
msgid "Here to delay us, no doubt."
msgstr ""

#. ja: 治癒は任せて<br>攻撃に集中を！
#. de: Konzentriert euch darauf, diese Pflanzen zu vernichten. Ich unterstütze euch.
#. fr: Je vous soignerai, attaquez sans crainte.
msgctxt "NpcYell:15068:0:13"
msgid "Focus on cutting down the plants. I'll provide support."
msgstr ""

#. ja: 迂回する暇はない！<br>強行突破を！
#. de: Uns bleibt keine Zeit. Wir müssen uns hier durchschlagen!
#. fr: Le temps presse, nous devons forcer le passage<nbsp>!
msgctxt "NpcYell:15069:0:13"
msgid "There's no time. We must force our way through them!"
msgstr ""

#. ja: 草刈りに来たつもりじゃ<br>なかったんだがな…
#. de: Ich habe doch nicht den weiten Weg auf mich genommen, um Unkraut zu jäten<nbsp>...
#. fr: Je ne suis pas venu tondre le gazon, moi...
msgctxt "NpcYell:15070:0:13"
msgid "I didn't come all this way to cut down overgrown weeds..."
msgstr ""

#. ja: その槍が飾りじゃないと<br>証明してもらおうか
#. de: Trotzdem würde ich gerne sehen, ob deine Lanze der Aufgabe gewachsen ist.
#. fr: Prouve-moi que cette lance ne te sert pas de décoration.
msgctxt "NpcYell:15071:0:13"
msgid "Nevertheless, I would see if your lance is suited to the task."
msgstr ""

#. ja: 石像が動き出した！？
#. de: Die Statuen<nbsp>- sie sind lebendig!
#. fr: La statue s'est mise à bouger<nbsp>!?
msgctxt "NpcYell:15072:0:13"
msgid "The statues─they're alive!"
msgstr ""

#. ja: このような守護像など<br>我らの敵ではないぞ！
#. de: Sie wenden die Erzbasilika selbst gegen uns?
#. fr: Ce n'est pas un tas de pierres qui va nous barrer la route<nbsp>!
msgctxt "NpcYell:15073:0:13"
msgid "They would turn the Vault itself against us?"
msgstr ""

#. ja: 行くぞ…<br>まだ先は長い
#. de: Wir haben noch einen weiten Weg vor uns.
#. fr: Continuons, la route est encore longue.
msgctxt "NpcYell:15074:0:13"
msgid "We've still a long way to go."
msgstr ""

#. ja: 氷女に言われるまでもない
#. de: Dann lasst uns weitergehen.
#. fr: Je n'ai pas besoin de toi pour le savoir.
msgctxt "NpcYell:15075:0:13"
msgid "Then let's keep moving."
msgstr ""

#. ja: 教皇は、いったいどこに！？
#. de: Noch immer keine Spur von dem Papst.
#. fr: Où se cache l'Archevêque<nbsp>!?
msgctxt "NpcYell:15076:0:13"
msgid "Still no sign of the archbishop."
msgstr ""

#. ja: 待ってくれ！<br>戦いに来たわけじゃない！
#. de: Halt! Wir sind nicht hierher<shy>ge<shy>kommen, um zu kämpfen.
#. fr: Attends<nbsp>! Nous ne sommes pas là pour nous battre<nbsp>!
msgctxt "NpcYell:15077:0:13"
msgid "Stop! We did not come here to do battle."
msgstr ""

#. ja: 相手は猛り狂っている！<br>戦って鎮めるしかないんだ！
#. de: Verzeih mir, aber wir müssen uns verteidigen.
#. fr: Notre adversaire est consumé par la rage<nbsp>! Nous n'avons pas d'autre choix que d'en venir aux mains<nbsp>!
msgctxt "NpcYell:15078:0:13"
msgid "Forgive me, but we have to defend ourselves."
msgstr ""

#. ja: ここ氷天宮は袋小路…<br>必ず近くにいるはずだ！
#. de: Er muss hier in der Nähe sein.
#. fr: Le sanctuaire de l'Azur se termine sur une impasse, il est forcément là<nbsp>!
msgctxt "NpcYell:15079:0:13"
msgid "He cannot be much farther."
msgstr ""

#. ja: 戦いたいわけではないのに…
#. de: Müssen wir denn immer zu Gewalt greifen?
#. fr: Ce n'est pas ce que je voulais...
msgctxt "NpcYell:15080:0:13"
msgid "Must we always resort to violence?"
msgstr ""

#. ja: 覚悟を決めろ、氷女…！
#. de: Wir müssen töten oder getötet werden. Trefft eure Wahl.
#. fr: Fais-toi une raison<nbsp>!
msgctxt "NpcYell:15081:0:13"
msgid "We must slay or be slain. Make your choice."
msgstr ""

#. ja: 甲鱗綱の魔物のようだね…
#. de: Seine Schuppen sind wie eine Rüstung.
#. fr: Nous voilà face à un reptile bipède...
msgctxt "NpcYell:15082:0:13"
msgid "Its scales are like unto armor."
msgstr ""

#. ja: なんと、このような仕掛けが！？
#. de: Gargoyles!?
#. fr: Je ne m'attendais pas à ce genre de piège<nbsp>!
msgctxt "NpcYell:15083:0:13"
msgid "Gargoyles!?"
msgstr ""

#. ja: 何が相手だろうと<br>貫くだけだ
#. de: Eine dicke Haut wird ihn nicht vor meiner Lanze schützen.
#. fr: Aucun adversaire ne me barrera la route.
msgctxt "NpcYell:15084:0:13"
msgid "A thick hide will not spare it from my lance."
msgstr ""

#. ja: さすがは教皇庁…<br>気が抜けないな…
#. de: Nichts anderes erwarte ich von der Verteidigung der Erzbasilika.
#. fr: L'Archevêque a pris ses précautions...
msgctxt "NpcYell:15085:0:13"
msgid "I'd expect nothing less from the Vault's defenses."
msgstr ""

#. ja: 面白い戦い方をする<br>ヤツだったな
#. de: Hmpf, das war ein würdiger Gegner.
#. fr: Sa façon de se battre était plutôt intéressante.
msgctxt "NpcYell:15086:0:13"
msgid "Hmph, it was a worthy adversary."
msgstr ""

#. ja: 遊びじゃないんだぞ？<br>いけ好かない男だ…
#. de: Wir sind nicht zu deinem Vergnügen hier, Dragoon.
#. fr: Dois-je te rappeler que nous ne sommes pas là pour jouer<nbsp>?
msgctxt "NpcYell:15087:0:13"
msgid "We are not here for you to enjoy sport, dragoon."
msgstr ""

#. ja: 蒼天騎士か！
#. de: Ein Ritter der Azurgarde!?
#. fr: Un chevalier de l'Azur<nbsp>!
msgctxt "NpcYell:15088:0:13"
msgid "A knight of the Heavens' Ward!?"
msgstr ""

#. ja: お願いだ…<br>私たちを通してくれ…
#. de: Bitte, ich flehe dich an<nbsp>- lass uns passieren!
#. fr: S'il te plaît... Laisse-nous passer<nbsp>!
msgctxt "NpcYell:15089:0:13"
msgid "Please, I beg you─let us pass!"
msgstr ""

#. ja: 怒りに飲まれた竜に<br>言葉なぞ無意味だ！
#. de: Deine Worte fallen auf taube Ohren.
#. fr: Un dragon enragé n'a que faire de tes paroles<nbsp>!
msgctxt "NpcYell:15090:0:13"
msgid "Your words fall on deaf ears."
msgstr ""

#. ja: アデルフェル卿…<br>美剣と称される使い手だ！
#. de: Adelphel!
#. fr: Sire Adelphel est connu pour son talent à l'épée<nbsp>!
msgctxt "NpcYell:15091:0:13"
msgid "Ser Adelphel Brightblade!"
msgstr ""

#. ja: 逃げるなら今のうちだぞ<br>氷女…
#. de: Wenn ihr fliehen wollt, wäre jetzt ein guter Zeitpunkt.
#. fr: Cœur-de-glace. Si tu veux t'enfuir, c'est le moment où jamais...
msgctxt "NpcYell:15092:0:13"
msgid "If you would flee, now is the time."
msgstr ""

#. ja: 黙れ…<br>私は進むと決めたのだ…
#. de: Und unsere Mission aufgeben? Mach dich nicht lächerlich.
#. fr: Silence<nbsp>! J'ai décidé d'aller jusqu'au bout...
msgctxt "NpcYell:15093:0:13"
msgid "And abandon our mission? Don't be absurd."
msgstr ""

#. ja: 鬱陶しい雷だ…
#. de: Der Klang dieses Donners gefällt mir nicht.
#. fr: Ce brouillard est plus qu'agaçant...
msgctxt "NpcYell:15094:0:13"
msgid "I like not the sound of that thunder."
msgstr ""

#. ja: この落雷…<br>邪竜の攻撃か！
#. de: Diese Blitzschläge<nbsp>... Sind sie das Werk der Drachen?
#. fr: Cette foudre doit être l'œuvre de Nidhogg<nbsp>!
msgctxt "NpcYell:15095:0:13"
msgid "These lightning strikes... Are they the work of dragons?"
msgstr ""

#. ja: いくぞ！<br>遅れをとるなよ！
#. de: Vergesst das. Wir müssen uns beeilen.
#. fr: En avant<nbsp>! Ne traînez pas<nbsp>!
msgctxt "NpcYell:15096:0:13"
msgid "Never mind that. We have to hurry."
msgstr ""

#. ja: チッ…また雷か！
#. de: Hmpf. Noch mehr Blitze.
#. fr: Encore cette foudre...<nbsp>!
msgctxt "NpcYell:15097:0:13"
msgid "Hmph. More lightning."
msgstr ""

#. ja: 注意しつつ進みましょう
#. de: Wir müssen vorsichtig vorgehen.
#. fr: Avançons avec prudence<nbsp>!
msgctxt "NpcYell:15098:0:13"
msgid "We must tread carefully."
msgstr ""

#. ja: 雷の礼はさせてもらうぞ…
#. de: Deine Blitze werden dich jetzt nicht retten.
#. fr: Je vais lui rendre la pareille...
msgctxt "NpcYell:15099:0:13"
msgid "Your lightning won't save you now."
msgstr ""

#. ja: では、道中の雷撃は<br>この竜が…！？
#. de: Dieser Drache war vernünftig?
#. fr: La foudre était vraiment un coup du dragon<nbsp>?
msgctxt "NpcYell:15100:0:13"
msgid "This dragon was responsible?"
msgstr ""

#. ja: フン…先を急ぐぞ
#. de: Lasst uns weitergehen.
#. fr: Humpf... Continuons.
msgctxt "NpcYell:15101:0:13"
msgid "Let's keep moving."
msgstr ""

#. ja: や、やりました…！
#. de: Bei den Gebietern, wir haben es geschafft!
#. fr: O-on a réussi...<nbsp>!
msgctxt "NpcYell:15102:0:13"
msgid "By the gods, we did it!"
msgstr ""

#. ja: この程度の勝利で喜ぶな…<br>先を急ぐぞ
#. de: Keine Zeit zum Feiern<nbsp>- wir müssen weiter.
#. fr: Il est trop tôt pour se réjouir, ce n'est pas terminé.
msgctxt "NpcYell:15103:0:13"
msgid "This is no time to celebrate─we must keep moving."
msgstr ""

#. ja: チッ…<br>面倒な位置にいるな
#. de: Sie sind hier im Vorteil.
#. fr: Ce n'est pas pratique...
msgctxt "NpcYell:15104:0:13"
msgid "They have the advantage here."
msgstr ""

#. ja: 冷静にやり過ごしましょう
#. de: Wir müssen dennoch Ruhe bewahren.
#. fr: Gardons notre calme.
msgctxt "NpcYell:15105:0:13"
msgid "Even so, we must remain calm."
msgstr ""

#. ja: 数は多いが…<br>止められるものかよ！
#. de: Sie werden uns nicht durch zahlenmäßige Überlegenheit besiegen.
#. fr: Ils sont nombreux, mais pas assez pour nous arrêter<nbsp>!
msgctxt "NpcYell:15106:0:13"
msgid "They'll not defeat us through sheer numbers."
msgstr ""

#. ja: まったくそのとおり！<br>ここは打ちくだく！
#. de: Jawohl, zeigen wir ihnen die Sinnlosigkeit roher Gewalt!
#. fr: Exactement<nbsp>! Allez, on s'en occupe<nbsp>!
msgctxt "NpcYell:15107:0:13"
msgid "Aye, let us show them the futility of brute force!"
msgstr ""

#. ja: 雑魚とは威圧感が違うな<br>だが、押しとおる！
#. de: Dieser scheint stärker als die anderen zu sein, doch das spielt keine Rolle.
#. fr: Il a l'air bien plus fort que les autres, mais nous le vaincrons<nbsp>!
msgctxt "NpcYell:15108:0:13"
msgid "This one appears stronger than the others, but it matters little."
msgstr ""

#. ja: 雑魚とは威圧感が違うな<br>押し通るぞ！
#. de: Dieser scheint stärker als die anderen zu sein, doch das spielt keine Rolle.
#. fr: Allez, on s'en débarrasse et on continue<nbsp>!
msgctxt "NpcYell:15109:0:13"
msgid "This one appears stronger than the others, but it matters little."
msgstr ""

#. ja: 前衛はお任せを！
#. de: Ich überlasse dir die Vorhut.
#. fr: Je vous laisse combattre en première ligne<nbsp>!
msgctxt "NpcYell:15110:0:13"
msgid "I leave the vanguard to you."
msgstr ""

#. ja: 感じる…<br>ニーズヘッグは近い…
#. de: Nidhogg ist nah. Ich spüre ihn.
#. fr: Nidhogg est proche, je sens sa présence...
msgctxt "NpcYell:15111:0:13"
msgid "Nidhogg is close. I sense him."
msgstr ""

#. ja: ハァハァ…<br>仕留めたか！
#. de: \<keuch> \<keuch> ... Ist es vorbei?
#. fr: Haa... Haa... On l'a eu<nbsp>!
msgctxt "NpcYell:15112:0:13"
msgid "\\<pant> \\<pant> ...Is it over?"
msgstr ""

#. ja: 崩れるぞッ！
#. de: Passt auf!
#. fr: Ça va s'effrondrer<nbsp>!
msgctxt "NpcYell:15113:0:13"
msgid "Watch out!"
msgstr ""

#. ja: お、驚きました…
#. de: Bei den Sieben Höllen!
#. fr: J'ai eu peur...
msgctxt "NpcYell:15114:0:13"
msgid "Seven hells!"
msgstr ""

#. ja: この先に奴がいる…<br>蹴散らして進むぞ！
#. de: Wir müssen sie schnell erledigen, bevor sie uns überwältigen.
#. fr: Il n'est plus très loin, continuons.
msgctxt "NpcYell:15115:0:13"
msgid "We must rout them quickly, ere they overwhelm us."
msgstr ""

#. ja: 蒼の竜騎士に続け！
#. de: Wir folgen dir einfach.
#. fr: Suivons le Dragon céleste<nbsp>!
msgctxt "NpcYell:15116:0:13"
msgid "We shall follow your lead."
msgstr ""

#. ja: 決着をつけるぞ！<br>ニーズヘッグッ！
#. de: Dies endet hier, Nidhogg!
#. fr: Il est temps d'en finir, Nidhogg<nbsp>!
msgctxt "NpcYell:15117:0:13"
msgid "This ends here, Nidhogg!"
msgstr ""

#. ja: 戦神ハルオーネよ<br>ご照覧あれ！
#. de: Halone, leih uns deine Stärke!
#. fr: Ô Halone, accorde-nous ta bénédiction<nbsp>!
msgctxt "NpcYell:15118:0:13"
msgid "Halone grant us strength!"
msgstr ""

#. ja: 姿を変じたのはいったい…
#. de: Wie hat er sich in solch ein Monstrum verwandelt?
#. fr: Comment a-t-il pu changer d'apparence...<nbsp>?
msgctxt "NpcYell:15119:0:13"
msgid "How did he transform into that monstrosity?"
msgstr ""

#. ja: 面妖ではあるが…<br>いまは考えるより、先へ！
#. de: Ich fürchte, wir haben keine Zeit zum Grübeln. Kommt, meine Freunde!
#. fr: C'est certes étrange, mais concentrons-nous plutôt sur notre route.
msgctxt "NpcYell:15120:0:13"
msgid "I fear we have little time to ruminate. Come, my friends!"
msgstr ""

#. ja: グリノー卿！<br>やはり立ちふさがるか！
#. de: Grinnaux. Ich hätte wissen müssen, dass du hier bist.
#. fr: Sire Grinnaux！Vous aussi, vous nous barrez la route<nbsp>?
msgctxt "NpcYell:15121:0:13"
msgid "Ser Grinnaux. I should have known you would be here."
msgstr ""

#. ja: 決闘裁判の続きですな…！
#. de: Du hast ihn schon einmal besiegt. Gemeinsam werden wir es wieder tun.
#. fr: Considérons cela comme une suite au jugement par combat<nbsp>!
msgctxt "NpcYell:15122:0:13"
msgid "You bested him once before. Together, we shall do so again."
msgstr ""

#. ja: ハァハァ…<br>さすがは蒼天騎士…
#. de: Sein Titel als Ritter der Azurgarde ist wohlverdient.
#. fr: Haa... Haa... Les chevaliers de l'Azur méritent leur réputation...
msgctxt "NpcYell:15123:0:13"
msgid "His title as a knight of the Heavens' Ward is well earned."
msgstr ""

#. ja: だとしても突き進むのみ！<br>上層の氷天宮へ！
#. de: Du hast gut gekämpft, mein Freund, aber unsere Mission ist noch lange nicht vorbei.
#. fr: Mais nous devons tout de même les vaincre<nbsp>!
msgctxt "NpcYell:15124:0:13"
msgid "You fought well, my friend, but our mission is far from over."
msgstr ""

#. ja: まさか飛空艇で<br>脱出するつもりか！
#. de: Er will mit einem Luftschiff fliehen?
#. fr: Ils comptent s'échapper en aéronef<nbsp>!
msgctxt "NpcYell:15125:0:13"
msgid "He means to escape by airship?"
msgstr ""

#. ja: そうはさせない！<br>一気に勝負を付けよう！
#. de: Wir müssen uns beeilen!
#. fr: Ne les laissons pas faire<nbsp>! Terminons vite ce combat<nbsp>!
msgctxt "NpcYell:15126:0:13"
msgid "We have to hurry!"
msgstr ""

#. ja: なっ…！<br>姿を変えただと！？
#. de: Was ist das für eine Zauberei?
#. fr: Il a changé d'apparence<nbsp>!?
msgctxt "NpcYell:15127:0:13"
msgid "What sorcery is this?"
msgstr ""

#. ja: どんな仕掛けがあろうと<br>全力で戦うのみ！
#. de: Lasst euch nicht entmutigen, meine Freunde. Wir müssen alles geben!
#. fr: Combattons de toutes nos forces<nbsp>!
msgctxt "NpcYell:15128:0:13"
msgid "Do not be disheartened, my friends. We must give it our all!"
msgstr ""

#. ja: これしきのことで･･･！
#. de: Noch stehe ich ...!
#. fr: Ça se présente mal...
msgctxt "NpcYell:15129:0:13"
msgid "This is nothing..."
msgstr ""

#. ja: 倒れるわけには･･･！
#. de: Ich halte stand!
#. fr: Pas le moment de flancher...
msgctxt "NpcYell:15130:0:13"
msgid "I can't afford to fall..."
msgstr ""

#. ja: まだやれるぞ･･･！
#. de: Tief durchatmen ...
#. fr: Je suis encore debout<nbsp>!
msgctxt "NpcYell:15131:0:13"
msgid "It's not over yet!"
msgstr ""

#. ja: ありがとう、助かった
#. de: Vielen Dank!
#. fr: Merci. Me voilà à nouveau sur pied<nbsp>!
msgctxt "NpcYell:15132:0:13"
msgid "I'm in your debt."
msgstr ""

#. ja: まだ進める･･････！
#. de: Das dürfte gehen ...
#. fr: Je n'ai pas dit mon dernier mot<nbsp>!
msgctxt "NpcYell:15133:0:13"
msgid "We've much to do!"
msgstr ""

#. ja: 何度でも羽ばたいてみせる･･･！
#. de: Ich stehe wieder!
#. fr: Je déploierai mes ailes autant de fois qu'il le faut<nbsp>!
msgctxt "NpcYell:15134:0:13"
msgid "You cannot keep me down!"
msgstr ""

#. ja: 邪魔をするなら！
#. de: Wie du wünschst!
#. fr: Si vous tenez tant que ça à nous gêner...
msgctxt "NpcYell:15135:0:13"
msgid "You've forced my hand!"
msgstr ""

#. ja: 容赦はしない！
#. de: Keine Gnade!
#. fr: Je serai implacable<nbsp>!
msgctxt "NpcYell:15136:0:13"
msgid "No mercy!"
msgstr ""

#. ja: 散れッ！
#. de: Nimm dies!
#. fr: Disparaissez<nbsp>!
msgctxt "NpcYell:15137:0:13"
msgid "Out of my way!"
msgstr ""

#. ja: この身体なら、全力でやれる！
#. de: Mit scharfer Klaue!
#. fr: Grâce à ce nouveau corps, je peux déployer toute ma force<nbsp>!
msgctxt "NpcYell:15138:0:13"
msgid "I will hold nothing back!"
msgstr ""

#. ja: 進むべき道を、切り拓くッ！
#. de: Aus dem Weg!
#. fr: Je tracerai notre chemin à travers les hordes ennemies<nbsp>!
msgctxt "NpcYell:15139:0:13"
msgid "I shall carve a path forward!"
msgstr ""

#. ja: 私も天竜の一翼なのだ！
#. de: Zahn um Zahn!
#. fr: Goûtez à la puissance des dragons anciens<nbsp>!
msgctxt "NpcYell:15140:0:13"
msgid "I am of the first brood!"
msgstr ""

#. ja: 大丈夫か？
#. de: Alles in Ordnung?
#. fr: Tout va bien<nbsp>?
msgctxt "NpcYell:15141:0:13"
msgid "Are you all right?"
msgstr ""

#. ja: 受け取れ！
#. de: Auf die Beine!
#. fr: Tiens, c'est pour toi<nbsp>!
msgctxt "NpcYell:15142:0:13"
msgid "Here!"
msgstr ""

#. ja: 私が癒やそう
#. de: Sei unbesorgt!
#. fr: Je m'occupe des soins<nbsp>!
msgctxt "NpcYell:15143:0:13"
msgid "I'll tend your wounds."
msgstr ""

#. ja: 皆の想いに応える！
#. de: Mit vereinter Kraft!
#. fr: Je suis à vos côtés<nbsp>!
msgctxt "NpcYell:15144:0:13"
msgid "Let me to do my part."
msgstr ""

#. ja: 任せてくれ！
#. de: Bleib standhaft!
#. fr: Laissez-moi faire<nbsp>!
msgctxt "NpcYell:15145:0:13"
msgid "Allow me!"
msgstr ""

#. ja: 私も続く！
#. de: Und weiter!
#. fr: J'ai encore de l'énergie à revendre<nbsp>!
msgctxt "NpcYell:15146:0:13"
msgid "This should help!"
msgstr ""

#. ja: 護り抜くと誓った･･････！
#. de: Ich habe geschworen, sie zu schützen! 
#. fr: J'ai juré de protéger tous mes camarades<nbsp>!
msgctxt "NpcYell:15147:0:13"
msgid "I will protect you!"
msgstr ""

#. ja: 星竜の牙を受けよ！
#. de: Spürt die Wut eines Hohen Drachen!
#. fr: Que les crocs aiguisés du dragon vous emportent<nbsp>!
msgctxt "NpcYell:15148:0:13"
msgid "My fangs rend all!"
msgstr ""

#. ja: 怒りが貴様だけのものと<br>思うなよ…！
#. de: Auch mein Zorn schwelt heiß!
#. fr: Vous n'êtes pas les seuls consumés par la rage...<nbsp>!
msgctxt "NpcYell:15149:0:13"
msgid "We shall see whose rage is the greater!"
msgstr ""

#. ja: 異界ってのは<br>ずいぶん歪らしいな…
#. de: Ein wortwörtlich verquerer Ort, das Nichts.
#. fr: Dites donc, ça part un peu dans tous les sens, le néant...
msgctxt "NpcYell:15150:0:13"
msgid "Quite literally a twisted place, the void."
msgstr ""

#. ja: 気を抜くな<br>すぐに妖異が現れるぞ！
#. de: Bleibt wachsam. Die Nichts<shy>gesand<shy>ten könnten überall lauern.
#. fr: Attention, des créatures peuvent nous attaquer à tout moment<nbsp>!
msgctxt "NpcYell:15151:0:13"
msgid "Stay focused. Voidsent could be anywhere."
msgstr ""

#. ja: あの妖異たち…<br>見張り役かしら
#. de: Diese hier scheinen Wachen zu sein.
#. fr: Voici quelques habitués des lieux, on dirait...
msgctxt "NpcYell:15152:0:13"
msgid "Those ones appear to be sentries."
msgstr ""

#. ja: いくつもの牢からすると<br>監獄か何かのようだが…
#. de: Zweifelsohne um diesen Kerker zu bewachen, was?
#. fr: Toutes ces cellules peuvent contenir bien des prisonniers...
msgctxt "NpcYell:15153:0:13"
msgid "Guarding the dungeon, I shouldn't doubt."
msgstr ""

#. ja: 奴が城の主か！？
#. de: Ist das die Herrin dieser Burg?!
#. fr: Est-ce la maîtresse de ce château<nbsp>?
msgctxt "NpcYell:15154:0:13"
msgid "Is she the mistress of the castle!?"
msgstr ""

#. ja: 邪魔するなら<br>蹴散らすまでだ
#. de: Fallen wird sie trotzdem, wie all die anderen.
#. fr: Pas le temps de discuter, on fonce dans le tas<nbsp>!
msgctxt "NpcYell:15155:0:13"
msgid "Whoever she is, we'll tend to her like the rest."
msgstr ""

#. ja: ようやく打ち止めか…<br>さあ、先へと進もう！
#. de: Gut gekämpft, Freunde. Rücken wir vor.
#. fr: Ouf, on n'en voyait pas le bout... Poursuivons notre route, vite<nbsp>!
msgctxt "NpcYell:15156:0:13"
msgid "Well fought, my friends. Let us press on."
msgstr ""

#. ja: こちらは随分と<br>整然としているようだが…
#. de: Ein durchaus prachtvolles Gemäuer.
#. fr: Le décor a radicalement changé...
msgctxt "NpcYell:15157:0:13"
msgid "As grand a castle as any I've seen."
msgstr ""

#. ja: 城主がいるなら先程の<br>礼をしてやらないとな
#. de: Wenn die Herrin hier ist, müssen wir ihr angemessen danken.
#. fr: La pro<shy>prié<shy>taire a beau avoir du goût, elle évitera pas la raclée qui l'attend<nbsp>!
msgctxt "NpcYell:15158:0:13"
msgid "If the mistress is here, we must repay her earlier kindness."
msgstr ""

#. ja: 女の絵…？<br>どういうことだ…
#. de: Die Frau auf dem Gemälde<nbsp>... Ist sie etwa<nbsp>...
#. fr: Un portrait de femme<nbsp>? Hmm...
msgctxt "NpcYell:15159:0:13"
msgid "The woman in the painting─do you suppose...?"
msgstr ""

#. ja: 妖異に変じる前の城主…<br>かもしれないわね
#. de: Ja. Vermutlich eben jene Burgherrin, zu helleren Zeiten.
#. fr: Probablement la maîtresse avant sa transformation...
msgctxt "NpcYell:15160:0:13"
msgid "Aye, I suspect it's the mistress in bygone days."
msgstr ""

#. ja: やはりいたか…！
#. de: Na also.
#. fr: La voilà<nbsp>!
msgctxt "NpcYell:15161:0:13"
msgid "Surprise, surprise."
msgstr ""

#. ja: あの妖異…<br>危険な魔力を感じるわ
#. de: Der Äther ist stark in ihr. Gebt acht.
#. fr: Quelle énergie menaçante...
msgctxt "NpcYell:15162:0:13"
msgid "I sense potent magicks from her. Have care."
msgstr ""

#. ja: チッ…<br>逃げ足だけは一流だな
#. de: Ts ... Ganz schön schwer zu fassen, die Gute.
#. fr: Merde<nbsp>! Elle est rapide comme l'éclair<nbsp>!
msgctxt "NpcYell:15163:0:13"
msgid "Hmph, she's quick on her feet if nothing else."
msgstr ""

#. ja: 安全を確保するためにも<br>追いましょう
#. de: Wir sollten ihr keine Zeit zum Rasten lassen.
#. fr: Il faut l'achever<nbsp>! Rattrapons-la<nbsp>!
msgctxt "NpcYell:15164:0:13"
msgid "She may still be a threat. After her."
msgstr ""

#. ja: ここは庭園か？
#. de: Ein schwebender Garten ...
#. fr: Où sommes-nous<nbsp>? Dans une sorte de parc<nbsp>?
msgctxt "NpcYell:15165:0:13"
msgid "Terraces in the sky..."
msgstr ""

#. ja: 妖異にも花を愛でる<br>文化があるのかしら…
#. de: Finden Nichtswesen nach wie vor Gefallen an so etwas wie Blumen?
#. fr: Dans le treizième reflet aussi, on s'offrait des fleurs<nbsp>!
msgctxt "NpcYell:15166:0:13"
msgid "Do voidsent appreciate flowers too, I wonder..."
msgstr ""

#. ja: このまま追いつめるぞ！
#. de: Diesmal kommt sie uns nicht davon!
#. fr: C'est le moment de la coincer<nbsp>!
msgctxt "NpcYell:15167:0:13"
msgid "We have her now!"
msgstr ""

#. ja: なにかしら…<br>嫌な気配がするわ
#. de: Ich habe ein äußerst schlechtes Gefühl.
#. fr: Attendez, il y a quelque chose de louche dans l'atmosphère...
msgctxt "NpcYell:15168:0:13"
msgid "I sense something sinister in the air..."
msgstr ""

#. ja: 俺たちも喰らうつもりらしい
#. de: Ha, auch er scheint ein Mahl aus uns machen zu wollen.
#. fr: Une chose est sûre, il veut tous nous dévorer<nbsp>!
msgctxt "NpcYell:15169:0:13"
msgid "It seems he wants to devour us too."
msgstr ""

#. ja: そうはさせない<br>応戦しよう！
#. de: Er wird feststellen müssen, dass wir keine bekömmliche Kost sind.
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment pour lui, il va s'y casser les dents<nbsp>!
msgctxt "NpcYell:15170:0:13"
msgid "He will find us unappetizing!"
msgstr ""

#. ja: とてつもない魔力ね…！
#. de: Solche Macht!
#. fr: Son énergie est surpuissante<nbsp>!
msgctxt "NpcYell:15171:0:13"
msgid "Such overwhelming power!"
msgstr ""

#. ja: 攻撃に備えろ！
#. de: Macht euch bereit!
#. fr: Préparez-vous à l'impact<nbsp>!
msgctxt "NpcYell:15172:0:13"
msgid "Brace yourselves!"
msgstr ""

#. ja: あれは…！
#. de: Nicht zu fassen ...
#. fr: Ça alors...
msgctxt "NpcYell:15173:0:13"
msgid "By the Sisters..."
msgstr ""

#. ja: フン、橋の先に見えるのが<br>本城といったところか…
#. de: Da haben wir also die richtige Burg.
#. fr: Voilà donc le château proprement dit...
msgctxt "NpcYell:15174:0:13"
msgid "That must be the castle proper. Not too shabby."
msgstr ""

#. ja: すべてを呑み込む！
#. de: Da bleibt euch die Luft weg, was?
#. fr: Je vais tous vous engloutir<nbsp>!
msgctxt "NpcYell:15175:0:13"
msgid "Be swallowed by the tide!"
msgstr ""

#. ja: ほぉら、いくぜェ！
#. de: Ihr wollt es nicht anders!
#. fr: C'est parti mon kiki<nbsp>!
msgctxt "NpcYell:15176:0:13"
msgid "Brace yourselves!"
msgstr ""

#. ja: こんなのはどうだァ？
#. de: Wie gefällt euch das?
#. fr: Que dites-vous de ça<nbsp>?
msgctxt "NpcYell:15177:0:13"
msgid "How do you like this?"
msgstr ""

#. ja: 喰っちまうぞォ！？
#. de: Ich werde euch verschlingen!
#. fr: Voilà pour vous<nbsp>!
msgctxt "NpcYell:15178:0:13"
msgid "I wonder how you'll taste."
msgstr ""

#. ja: ええぃ、クソがぁッ…！
#. de: Ihr wagt es ...!
#. fr: Grmph, chiotte alors<nbsp>!
msgctxt "NpcYell:15179:0:13"
msgid "Grrr, why are you still alive!?"
msgstr ""

#. ja: 凄まじいエーテル量だ…！
#. de: Welch überwältigender Äther!
#. fr: Tu sens cette immense quantité d'étherrr<nbsp>?
msgctxt "NpcYell:15180:0:13"
msgid "Such overwhelming aether!"
msgstr ""

#. ja: さすがだな！
#. de: Wie immer beeindruckende Arbeit!
#. fr: Bien joué, comme toujourrrs<nbsp>!
msgctxt "NpcYell:15181:0:13"
msgid "Impressive as always, my friend!"
msgstr ""

#. ja: なっ、地面が…！？
#. de: W-Was passiert da!?
#. fr: L-le sol, qu'est-ce qui se passe<nbsp>?
msgctxt "NpcYell:15182:0:13"
msgid "Wh-What's happening!?"
msgstr ""

#. ja: 神使が待ち受けているようだ<br>頼んだぞ！
#. de: Anscheinend erwarten uns Diener. Das überlasse ich dir!
#. fr: Les serrrviteurs des Dieux... À toi de jouer<nbsp>!
msgctxt "NpcYell:15183:0:13"
msgid "Servants of the gods... I leave them in your hands!"
msgstr ""

#. ja: エーテルの記録は順調だ<br>重さにも慣れてきたよ
#. de: Meine Datensammlung geht bisher zügig voran. Ich habe mich an das Gewicht gewöhnt.
#. fr: Le prrrélèvement de données va bon trrrain.
msgctxt "NpcYell:15184:0:13"
msgid "The data collection proceeds apace."
msgstr ""

#. ja: まさか星神ニメーヤまで<br>現れるとは…
#. de: Dass Nymeia auch hinabsteigen würde<nbsp>...
#. fr: Quelle surrrprise d'avoir aussi eu affaire à Nymeia...
msgctxt "NpcYell:15185:0:13"
msgid "That Nymeia should also descend..."
msgstr ""

#. ja: 動く氷の彫像…！？
#. de: Diese Eisskulpturen bewegen sich!
#. fr: Des sculpturrres...<nbsp>? Non, d'autres familiers divins<nbsp>! Attention<nbsp>!
msgctxt "NpcYell:15186:0:13"
msgid "Ice sculptures? Nay, they're more servants!"
msgstr ""

#. ja: 怪我はないか？
#. de: Ich hoffe, es geht dir gut?
#. fr: Ça va, pas de grrros bobo<nbsp>?
msgctxt "NpcYell:15187:0:13"
msgid "None the worse for the wear, I hope?"
msgstr ""

#. ja: この声は、さっきの…！
#. de: Die gleiche Stimme wie zuvor<nbsp>...
#. fr: Quelle voix frrranche et autoritaire<nbsp>!
msgctxt "NpcYell:15188:0:13"
msgid "The same voice from before..."
msgstr ""

#. ja: どうか無事に<br>試練を乗り越えてくれ！
#. de: Pass auf dich auf, <if $gn4>meine Freundin<else>mein Freund</if>!
#. fr: Surrrtout, fais bien attention à toi<nbsp>!
msgctxt "NpcYell:15189:0:13"
msgid "Be safe, my friend!"
msgstr ""

#. ja: 荒々しい<br>手合わせだったな…
#. de: Das war eine zermürbende Prüfung.
#. fr: Ce combat fut vérrritablement titanesque...
msgctxt "NpcYell:15190:0:13"
msgid "Such a grueling trial that was."
msgstr ""

#. ja: 氷天におわす<br>もう一柱の神ってつまり…
#. de: Es gibt nur eine andere Göttin, die im Himmel aus Eis weilt<nbsp>...
#. fr: Notre second adverrrsaire de la voûte de la glace ne peut être que...
msgctxt "NpcYell:15191:0:13"
msgid "Only one other divinity would abide in the Heaven of Ice..."
msgstr ""

#. ja: キィーーッ！
#. de: Kiii!
#. fr: Kiiiiiih<nbsp>!
msgctxt "NpcYell:15192:0:13"
msgid "Caw!"
msgstr ""

#. ja: グァアアアッ！
#. de: Guaaah!
#. fr: Grouooooh<nbsp>!
msgctxt "NpcYell:15193:0:13"
msgid "Grooogh!"
msgstr ""

#. ja: エーテル、寄越セ！
#. de: Dein Äther ist mein!
#. fr: Votre éther est à moi<nbsp>!
msgctxt "NpcYell:15194:0:13"
msgid "Your aether will be mine!"
msgstr ""

#. ja: 喰ワセロ、喰ワセロ！
#. de: Fresst sie! Fresst sie alle!
#. fr: À table<nbsp>!
msgctxt "NpcYell:15195:0:13"
msgid "I must feed!"
msgstr ""

#. ja: カタカタカタ…<br>本日ハ、訓練デス、カ？
#. de: \<klick> Möchtest du trainieren?
#. fr: (cliquette) Vous voulez vous entraîner<nbsp>?
msgctxt "NpcYell:15196:0:13"
msgid "\\<crick-crack> Come for training, are you?"
msgstr ""

#. ja: カタ、カタカタ…<br>鎌ヲ構エテ、遊ビマショ！
#. de: \<ratter> Mach dich bereit.
#. fr: (cliquette) Sortez votre faux, il est temps de s'amuser<nbsp>!
msgctxt "NpcYell:15197:0:13"
msgid "\\<creeeak> Ready your scythe!"
msgstr ""

#. ja: カタカタカタ…<br>マズハ、準備運動カラ！
#. de: \<klick> Zuerst eine Aufwärmübung.
#. fr: (cliquette) Commençons par l'échauf<shy>fe<shy>ment<nbsp>!
msgctxt "NpcYell:15198:0:13"
msgid "This will \\<snap> warm you up."
msgstr ""

#. ja: エーテル、イッパイ<br>グヘヘヘヘ…
#. de: Äther ... Mehr Äther!
#. fr: De l'éther... à foison... Slurp.
msgctxt "NpcYell:15199:0:13"
msgid "Such rich aether!"
msgstr ""

#. ja: キィーッ！
#. de: Kiii!
#. fr: Kiiiiih<nbsp>!
msgctxt "NpcYell:15200:0:13"
msgid "Trespassers!"
msgstr ""

#. ja: ギッ…
#. de: Guuuh ...
#. fr: Guh...
msgctxt "NpcYell:15201:0:13"
msgid "Stop them!"
msgstr ""

#. ja: 目が…回ります…ぞ…
#. de: Der Raum ... dreht sich<nbsp>...
#. fr: Ouuuh, j'ai la tête qui tournicote...
msgctxt "NpcYell:15202:0:13"
msgid "The room...is spinning..."
msgstr ""

#. ja: 華麗にかわしましょう！
#. de: Aktiviere galantes Ausweichen!
#. fr: Esquive de gentilhomme<nbsp>!
msgctxt "NpcYell:15203:0:13"
msgid "Engage gentlemanly evasion!"
msgstr ""

#. ja: ここは誰？<br>私はどこですかな？
#. de: Wo bin ich<nbsp>...?<br>Was ist das für ein Ort<nbsp>...?
#. fr: Qui...<nbsp>? Quoi...<nbsp>? Où...<nbsp>? Comment...<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15204:0:13"
msgid "Where is I...?<br>Who am this place...?"
msgstr ""

#. ja: アガ、アガガガガ！
#. de: Meeiine Zääähne!
#. fr: AGAGAGAGAAAA<nbsp>!!
msgctxt "NpcYell:15205:0:13"
msgid "My-y-y tee-ee-eeth!"
msgstr ""

#. ja: ◎▲◎##！
#. de: ◎▲◎##!
#. fr: ◎▲◎##!
msgctxt "NpcYell:15206:0:13"
msgid "◎▲◎##!"
msgstr ""

#. ja: ■♭×▲！
#. de: ■♭×▲!
#. fr: ■♭×▲!
msgctxt "NpcYell:15207:0:13"
msgid "■♭×▲!"
msgstr ""

#. ja: ♪○××□！
#. de: ♪○××□!
#. fr: ♪○××□!
msgctxt "NpcYell:15208:0:13"
msgid "♪○××□!"
msgstr ""

#. ja: □◎＄◎×△！
#. de: □◎$◎×△!
#. fr: □◎＄◎×△!
msgctxt "NpcYell:15209:0:13"
msgid "□◎＄◎×△!"
msgstr ""

#. ja: 始末します
#. de: Ich werde meine Pflicht erfüllen.
#. fr: Laissez-moi m'en charger.
msgctxt "NpcYell:15210:0:13"
msgid "I shall fulfill my duty."
msgstr ""

#. ja: 消え失せなさい
#. de: In den Staub.
#. fr: Hors de ma vue.
msgctxt "NpcYell:15211:0:13"
msgid "You shall die here."
msgstr ""

#. ja: アラグ帝国万歳
#. de: Zum Ruhme des Allagischen Reiches.
#. fr: Gloire à l'empire d'Allag<nbsp>!
msgctxt "NpcYell:15212:0:13"
msgid "For the glory of Allag."
msgstr ""

#. ja: ザンデ陛下に栄光あれ
#. de: Lang lebe Kaiser Xande.
#. fr: Longue vie à Sa Majesté Xande<nbsp>!
msgctxt "NpcYell:15213:0:13"
msgid "May Emperor Xande reign eternal."
msgstr ""

#. ja: 損傷拡大…
#. de: 0
#. fr: 0
msgctxt "NpcYell:15214:0:13"
msgid "0"
msgstr ""

#. ja: かかってきな！
#. de: Du bist am Zug, Opa!
#. fr: Amène-toi, vieux schnock<nbsp>!
msgctxt "NpcYell:15215:0:13"
msgid "Make your move, grandpapa!"
msgstr ""

#. ja: やってやるぜ！
#. de: Deine Tage sind gezählt!
#. fr: On va te faire la peau, hihi<nbsp>!
msgctxt "NpcYell:15216:0:13"
msgid "Your days are numbered!"
msgstr ""

#. ja: 不覚…ですぞ…
#. de: 0
#. fr: 0
msgctxt "NpcYell:15217:0:13"
msgid "0"
msgstr ""

#. ja: 迂闊でしたな…
#. de: Wie nachlässig von mir<nbsp>...
#. fr: Quel imprudent je fais...
msgctxt "NpcYell:15218:0:13"
msgid "Careless of me..."
msgstr ""

#. ja: ナワバリ ナワバリ<br>シンニュウスルナー！
#. de: Ziggy hält sie auf!<br>Ziggy sein groooßer Held!
#. fr: Hors de notre territoire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15219:0:13"
msgid "Ziggy save everyone!<br>Ziggy heeeeeero!"
msgstr ""

#. ja: デッカイ マセキ<br>デテコイヤー！
#. de: Ziggy hat große Sternensteine!<br>Ziggy ist der Grööößte!
#. fr: Que les grandes pierres magiques ap<shy>pa<shy>rais<shy>sent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15220:0:13"
msgid "Ziggy biggie pretties time!<br>Ziggy Ziggy hey!"
msgstr ""

#. ja: ムカツクヤーツ<br>ブチタオース！
#. de: Schaut genau ins Licht! Genauuu ins Licht!
#. fr: Je vais tous vous exterminer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15221:0:13"
msgid "Ziggy super beam time!<br>Ziggy Ziggy hey!"
msgstr ""

#. ja: フキトベー！
#. de: Verschwindet von hier!
#. fr: Allez voir ailleurs si j'y suis<nbsp>!
msgctxt "NpcYell:15222:0:13"
msgid "Ziggy pshoooooom!"
msgstr ""

#. ja: イックゾー！
#. de: Vorwärts, zermalmt sie!
#. fr: En avant<nbsp>!
msgctxt "NpcYell:15223:0:13"
msgid "Ziggy boooooom!"
msgstr ""

#. ja: カクゴシロー！
#. de: Zermalmt die Eindringlinge zu Staub!
#. fr: Préparez-vous à mourir<nbsp>!
msgctxt "NpcYell:15224:0:13"
msgid "Ziggy doooooom!"
msgstr ""

#. ja: コンチキショー！
#. de: Nichts soll übrigbleiben von den Eindringlingen!
#. fr: Sales petits mollusques<nbsp>!
msgctxt "NpcYell:15225:0:13"
msgid "Ziggy shoooooom!"
msgstr ""

#. ja: アーラヨット！
#. de: Ja-haa!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:15226:0:13"
msgid "Ziggy zoooooom!"
msgstr ""

#. ja: 増援か…
#. de: Da ist auch schon die Verstärkung!
#. fr: Des renforts...
msgctxt "NpcYell:15227:0:13"
msgid "More of them..."
msgstr ""

#. ja: おれの…エモノォ！
#. de: Das ist meine Beute!
#. fr: C'est ma proie<nbsp>!
msgctxt "NpcYell:15228:0:13"
msgid "I hunger..."
msgstr ""

#. ja: まだ現れるか…
#. de: Es werden einfach nicht weniger<nbsp>...
#. fr: En voilà encore d'autres...
msgctxt "NpcYell:15229:0:13"
msgid "Still more..."
msgstr ""

#. ja: 邪魔スルナ！
#. de: Weg mit dir!
#. fr: Dégage, microbe<nbsp>!
msgctxt "NpcYell:15230:0:13"
msgid "Traitor!"
msgstr ""

#. ja: 私ガ先ダッ！
#. de: Ich zuerst !
#. fr: Moi d'abord<nbsp>!
msgctxt "NpcYell:15231:0:13"
msgid "She's mine!"
msgstr ""

#. ja: やってシマエ！
#. de: Dir gebe ich was!
#. fr: Faites-lui la peau<nbsp>!
msgctxt "NpcYell:15232:0:13"
msgid "Get her!"
msgstr ""

#. ja: エエイ！<br>立て続けニ攻撃ダ！
#. de: Angreifen! Immer weiter angreifen!
#. fr: Attaquez-la sans répit<nbsp>!
msgctxt "NpcYell:15233:0:13"
msgid "Give her no quarter!"
msgstr ""

#. ja: チッ…！
#. de: Ugh ...!
#. fr: Raaah<nbsp>!
msgctxt "NpcYell:15234:0:13"
msgid "Ugh!"
msgstr ""

#. ja: さあ行こう！
#. de: Los, zurück in die Schlacht!
#. fr: Allez, on y retourne<nbsp>!
msgctxt "NpcYell:15235:0:13"
msgid "Press the attack!"
msgstr ""

#. ja: 宴の時間ダァ…！
#. de: Zeit für ein Festmahl!
#. fr: C'est l'heure du festin<nbsp>!
msgctxt "NpcYell:15236:0:13"
msgid "It is time to feast!"
msgstr ""

#. ja: まだこれからよ！
#. de: Ugh, schon wieder?!
#. fr: C'est pas fini<nbsp>!
msgctxt "NpcYell:15237:0:13"
msgid "Just warming up!"
msgstr ""

#. ja: 大丈夫かい？
#. de: Sind alle noch auf den Beinen?
#. fr: Est-ce que ça va<nbsp>?
msgctxt "NpcYell:15238:0:13"
msgid "Everyone all right?"
msgstr ""

#. ja: この借りは必ず返す
#. de: Danke, ich schulde dir etwas.
#. fr: J'ai une nouvelle dette envers toi.
msgctxt "NpcYell:15239:0:13"
msgid "I will repay this debt."
msgstr ""

#. ja: やれやれヤレェッ！
#. de: Nicht schlecht!
#. fr: Saignez-les<nbsp>! Saignez-les à blanc<nbsp>!!!
msgctxt "NpcYell:15240:0:13"
msgid "There is no escape!"
msgstr ""

#. ja: やるじゃない！
#. de: Ja, weiter so!
#. fr: C'était pas mal<nbsp>!
msgctxt "NpcYell:15241:0:13"
msgid "Well done!"
msgstr ""

#. ja: 妖異の相手を頼む
#. de: Übernimm du die Horde.
#. fr: Je vous laisse gérer la horde...<nbsp>!
msgctxt "NpcYell:15242:0:13"
msgid "Cover me."
msgstr ""

#. ja: こりゃあ<br>ひどい状況だな
#. de: Es ist noch viel schlimmer, als ich dachte<nbsp>...
#. fr: C'est pire que je ne le pensais...
msgctxt "NpcYell:15243:0:13"
msgid "Oh my... \\<snort>"
msgstr ""

#. ja: この卵は<br>いただいたでふっち！
#. de: Diese Eier gehören jetzt den Unsrigen!
#. fr: Ces œufs sont à nous<nbsp>!
msgctxt "NpcYell:15244:0:13"
msgid "These eggs belong to these ones now!"
msgstr ""

#. ja: 悔しかったら<br>取り返してみるでふっち！
#. de: Versucht doch, sie euch zurückzuholen!
#. fr: Essayez donc de les récupérer<nbsp>!
msgctxt "NpcYell:15245:0:13"
msgid "Now walking ones know how these ones feel!"
msgstr ""

#. ja: いいぞいいぞ<br>トンベリちゃん！
#. de: Los, meine lieben Tomberrys! Zeigt es ihnen!
#. fr: Allez, mes petits tomberrys<nbsp>! Montrez-leur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15246:0:13"
msgid "Yes, tonberry! \\<snort><br>Show me more!"
msgstr ""

#. ja: 回収できたアルコンエッグは<br>オレが預かるぞ！
#. de: Bring mir die Saliah-Eier, die du in Sicherheit bringen konntest!
#. fr: Apporte-moi les œufs que tu récupères.
msgctxt "NpcYell:15247:0:13"
msgid "Bring me the eggs!"
msgstr ""

#. ja: 撤退するでふっち～！
#. de: Weg hier! Schnell weg!
#. fr: Partons d'ici<nbsp>!
msgctxt "NpcYell:15248:0:13"
msgid "Flee! Flee!"
msgstr ""

#. ja: 不気味ふっち～！
#. de: Aaah! Ein Ungeheuriges!
#. fr: Quelle horreur<nbsp>!
msgctxt "NpcYell:15249:0:13"
msgid "Uwaaah, slimy ones are too slimy!"
msgstr ""

#. ja: 怖いの嫌でふっち…
#. de: Die Meinige hat Angst!
#. fr: Ils me font peur<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:15250:0:13"
msgid "This one <i>hates</i> scary ones!"
msgstr ""

#. ja: もう、つかれたでふっち！<br>今回はこのくらいで勘弁してやるでふっち～！
#. de: Das war's! Die Meinige ist erschöpft! Gibt auf!
#. fr: Je suis épuisé<nbsp>!<br>C'est terminé, j'arrête de vous agacer.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:15251:0:13"
msgid "This one is <i>tired</i>! Walking ones are not forgiven...but these ones are going home!"
msgstr ""

#. ja: おつかれさまだ！<br>キミのトンベリっぷり、最高だったぜ……！
#. de: Das war unglaublich! Ich habe noch nie einen so beeindruckenden Tomberry gesehen!
#. fr: Bravo<nbsp>! Je n'ai jamais vu de tomberry aussi im<shy>pres<shy>sion<shy>nant<nbsp>!
msgctxt "NpcYell:15252:0:13"
msgid "Th-That was amazing! I've never felt so exhilarated in my life! \\<wheeze>"
msgstr ""

#. ja: 回収したアルコンエッグは、オレが責任をもって運んでおく！<br>それじゃ、また会おうっ！
#. de: Ich werde die Eier sicher nach Gridania zurückbringen. Wir treffen uns dort!
#. fr: Je vais rapporter les œufs à Gridania, rejoignons-nous sur place.
msgctxt "NpcYell:15253:0:13"
msgid "I shall see these eggs safely to Gridania. Let us meet anon!"
msgstr ""

#. ja: いたずらも飽きてきちゃったし、<br>そろそろ帰るでふっち！
#. de: Die Meinige hat sich genug amüsiert! Zeit, nach Hause zu gehen!
#. fr: Je me suis assez amusé<nbsp>!<br>Il est temps de rentrer<nbsp>!
msgctxt "NpcYell:15254:0:13"
msgid "This one is tired of pilfering pranks─too easy!"
msgstr ""

#. ja: ふっちっち～！<br>この卵は、いただいていくでふっち～！
#. de: Hihi, was für ein schönes Ei! Her damit!
#. fr: Cet œuf est à moi<nbsp>!
msgctxt "NpcYell:15255:0:13"
msgid "Tee hee! These eggs are so shiny and nice!"
msgstr ""

#. ja: こいつはダメそうだ…<br>一旦退こうぜ！
#. de: Verdammt, ich habe unseren Gegner unterschätzt! Rückzug, Tomberrys! Rückzug!
#. fr: Mince, j'ai sous-estimé l'ennemi... On se replie<nbsp>!
msgctxt "NpcYell:15256:0:13"
msgid "I underestimated our foe. Retreat, tonberry! Retreat!"
msgstr ""

#. ja: ふっちっち～！
#. de: Hihihiii!
#. fr: Hihi<nbsp>!
msgctxt "NpcYell:15257:0:13"
msgid "Teeeeee hee hee!"
msgstr ""

#. ja: わたぴたちの<br>勝ちでふっち！
#. de: Die Unsrigen haben gewonnen! Hihiii!
#. fr: On a gagné, youpi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15258:0:13"
msgid "Serves walking ones right!<br>Victory for these ones!"
msgstr ""

#. ja: 故障、チュー…<br>敵、味方、ワカラナ…イ…
#. de: \<biep> Fehler. Freund kann nicht von Feind unterschieden werden.
#. fr: Bzz... Erreur... Impossible de différencier les ennemis des alliés.
msgctxt "NpcYell:15259:0:13"
msgid "ErRoR. uNaBlE tO dIfFeReNtIaTe FrIeNd FrOm FoE."
msgstr ""

#. ja: ぱわー低下…<br>モウ、動ケナーイ…
#. de: \<biep> Energie unzureichend. Wird heruntergefahren<nbsp>...
#. fr: Bzz... Énergie insuffisante... Passage en mode veille...
msgctxt "NpcYell:15260:0:13"
msgid "EnErGy LeVeLs InSuFfIcIeNt. PoWeRiNg DoWn..."
msgstr ""

#. ja: 卵…盗ムヤツ…<br>オマエ、ダナー…！
#. de: \<biep> Eier-Diebe werden nicht geduldet!
#. fr: Bzz... Voleurs d'œufs... Impardonnable<nbsp>! 
msgctxt "NpcYell:15261:0:13"
msgid "EgG-tHiEvEs WiLl NoT bE tOlErAtEd!"
msgstr ""

#. ja: 攻撃、準備…<br>えーてる、充填中…！
#. de: \<biep> Äther wird nachgeladen<nbsp>... Angriff wird initiiert<nbsp>...
#. fr: Bzz... Recharge d'éther en cours... Prêt à attaquer...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15262:0:13"
msgid "RePlEnIsHiNg AeThErIc StOrEs...<br>PrEpArInG fOr CoMbAt..."
msgstr ""

#. ja: こっちだふっち～！
#. de: 0
#. fr: Par ici<nbsp>!
msgctxt "NpcYell:15263:0:13"
msgid "Over here, stumbling one!"
msgstr ""

#. ja: 仕返しだふっち！
#. de: 0
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:15264:0:13"
msgid "Take that!"
msgstr ""

#. ja: 返さないでふっち！
#. de: 0
#. fr: C'est à moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15265:0:13"
msgid "Nooo! Nooo!<br>This egg belongs to this one!"
msgstr ""

#. ja: ひぇ～っ！<br>怖いでふっち～！
#. de: Aaaaahhh! Gruselig, gruselig! Hilfe!
#. fr: J'ai peuuur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15266:0:13"
msgid "Eiyaaaaaa!<br>Scary one!"
msgstr ""

#. ja: あばばっ！？<br>不気味なヤツだふっち～！
#. de: 0
#. fr: Aaah<nbsp>! N'approche pas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15267:0:13"
msgid "Aaaaaaaaa!<br>Creepy one, get away!"
msgstr ""

#. ja: うぎゃ～っ！<br>びっくりしたでふっち！
#. de: 0
#. fr: Quelle frayeur<nbsp>!<br>Je crains pour mon pauvre cœur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15268:0:13"
msgid "Waaaaaah! \\<sob><br>This one wants mother one!"
msgstr ""

#. ja: おばけ！？<br>おばけは嫌でふっち！
#. de: 0
#. fr: Sauve-qui-peut<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15269:0:13"
msgid "Monstrous one!<br>Flee, flee!"
msgstr ""

#. ja: 許してほしいでふっち～！
#. de: 0
#. fr: Pardonnez-moi<nbsp>!
msgctxt "NpcYell:15270:0:13"
msgid "P-Please forgive this one!"
msgstr ""

#. ja: 卵泥棒、イタ…！<br>攻撃、シチャウ、ゾ…！
#. de: \<biep>  Eier-Dieb gesichtet! Angriff wird eingeleitet<nbsp>...
#. fr: Bzz... Voleur en vue... Début de l'attaque...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15271:0:13"
msgid "EgG-tHiEf DeTeCtEd!<br>CoMmEnCiNg AnNiHiLaTiOn!"
msgstr ""

#. ja: この卵は<br>渡さないでふっち！
#. de: 0
#. fr: Ces œufs sont à nous<nbsp>!
msgctxt "NpcYell:15272:0:13"
msgid "Walking ones will never have these eggs!"
msgstr ""

#. ja: 取り返してみろでふっち！
#. de: 0
#. fr: Vous ne les aurez pas<nbsp>!
msgctxt "NpcYell:15273:0:13"
msgid "Hee hee! Try to take them, clumsy one!"
msgstr ""

#. ja: ビリビリさせるでふっち！
#. de: Das könnte gleich kribbeln!
#. fr: Ça va piquer<nbsp>!
msgctxt "NpcYell:15274:0:13"
msgid "Prepare to be tingly one!"
msgstr ""

#. ja: 痺れろでふっち～！
#. de: Bitzel, bitzel! Hihihi!
#. fr: C'est terminé<nbsp>!
msgctxt "NpcYell:15275:0:13"
msgid "Fizzle, shuffling ones!"
msgstr ""

#. ja: これでも<br>食らうでふっち～！
#. de: Nimm das!
#. fr: Prenez ça<nbsp>!
msgctxt "NpcYell:15276:0:13"
msgid "This will teach meddling ones not to meddle!"
msgstr ""

#. ja: 相手は隙だらけですぞ…！
#. de: Er ist abgelenkt!
#. fr: Monsieur Gélule semble perdre ses moyens<nbsp>!
msgctxt "NpcYell:15277:0:13"
msgid "The doctor is distracted!"
msgstr ""

#. ja: 十分な量のアルコンエッグが集まったし、ボチボチ撤収か？<br>まだ手元にあるなら、早いとこオレに預けてくれ！
#. de: Ich denke, das reicht jetzt, wir sollten den Heimweg antreten. Alle Eier zu mir!
#. fr: On a récupéré pas mal de Prœufs, il est temps de rentrer. Fais vite si tu en as d'autres à me remettre<nbsp>!
msgctxt "NpcYell:15278:0:13"
msgid "I daresay we've collected a tonberry's dozen! \\<snort> Shall we make our way back, or have you gathered more?"
msgstr ""

#. ja: イタタタ…こ、腰が…
#. de: Autsch! Mein Rücken<nbsp>...
#. fr: Ouillouillouille... Mes vieux os...
msgctxt "NpcYell:15279:0:13"
msgid "Ow-ow-ow...my back..."
msgstr ""

#. ja: 行こう、次の神域へ！
#. de: Auf zur nächsten Domäne!
#. fr: À nous le domaine suivant<nbsp>!
msgctxt "NpcYell:15280:0:13"
msgid "On to the next sanctum!"
msgstr ""

#. ja: ハッハッハ！<br>私はこちらですぞ～！
#. de: Du musst schon schneller sein!
#. fr: Ha ha ha<nbsp>! Mais non, je suis là, voyons<nbsp>!
msgctxt "NpcYell:15281:0:13"
msgid "You need to be quicker than that!"
msgstr ""

#. ja: しつこいですぞ～！
#. de: Lass mich in Ruhe!
#. fr: Vous ne seriez pas un peu du genre... collant<nbsp>?
msgctxt "NpcYell:15282:0:13"
msgid "Leave me alone!"
msgstr ""

#. ja: 父上に任せましたぞ！
#. de: Sie gehören ganz dir, Vater!
#. fr: Je m'en remets à ta bienveillance, Papounet<nbsp>!
msgctxt "NpcYell:15283:0:13"
msgid "'Tis all yours, Father!"
msgstr ""

#. ja: ギエェ～
#. de: \<piep>!
#. fr: Hi haaaan<nbsp>!
msgctxt "NpcYell:15284:0:13"
msgid "\\<bleat> "
msgstr ""

#. ja: キュイッ、キュイッ！
#. de: \<piep>! \<piep>!
#. fr: Iiik<nbsp>! Iiik<nbsp>!
msgctxt "NpcYell:15285:0:13"
msgid "\\<squeak>"
msgstr ""

#. ja: ビビってんのか？
#. de: Worauf wartest du?
#. fr: Alors, on fait pipi dans son boxer<nbsp>?
msgctxt "NpcYell:15286:0:13"
msgid "What're you waitin' for?"
msgstr ""

#. ja: さっさときやがれ！
#. de: Wir machen es schnell!
#. fr: Viens ici qu'on en finisse<nbsp>!
msgctxt "NpcYell:15287:0:13"
msgid "We'll make this quick!"
msgstr ""

#. ja: 暴力反対ですぞ！
#. de: Gewalt ist keine Lösung!
#. fr: La violence n'est jamais une solution, foi de gentilhomme<nbsp>!
msgctxt "NpcYell:15288:0:13"
msgid "Violence is not the answer!"
msgstr ""

#. ja: あなたの想い<br>キャーッチしましたぞ！
#. de: Ich spüre eine Feindseligkeit!
#. fr: Je ressens une certaine hostilité en vous, voire une hostilité certaine<nbsp>!
msgctxt "NpcYell:15289:0:13"
msgid "I am sensing some hostility!"
msgstr ""

#. ja: ギャーーー！<br>何でまたワシに当たる！？
#. de: 0
#. fr: 0
msgctxt "NpcYell:15290:0:13"
msgid "0"
msgstr ""

#. ja: イヤな予感がしますぞ…
#. de: Was ist das für ein drohendes Grauen<nbsp>...?
#. fr: Ça sent le roussi, Papounet...
msgctxt "NpcYell:15291:0:13"
msgid "What is this impending dread...?"
msgstr ""

#. ja: ごきげんよう、私はこの施設の管理者だ。<br>一言、挨拶しようと思い、幻体を送り込んでみたのさ。
#. de: Seid willkommen! Ich bin ein Abbild des Leiters dieser Hallen und wollte Euch persönlich empfangen.
#. fr: <if ($gn11 < 12)><if ($gn11 < 4)>Bonsoir<else>Bonjour</if><else><if ($gn11 < 17)>Bonjour<else>Bonsoir</if></if>, je suis le gérant de cet éta<shy>blis<shy>se<shy>ment, enfin, son avatar. Je tenais à te saluer.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:15292:0:13"
msgid "Ah, <i>visitors</i>! How refreshing! I am the caretaker of this facility, and it is my pleasure to receive you─albeit in an incorporeal form."
msgstr ""

#. ja: そうだ、優秀な使い魔であるキミには、褒美の品も渡しておこう。<br>ぜひ持ち帰ってくれたまえ。
#. de: Nehmt dies als Zeichen meiner Anerkennung. Einem so tüchtigen Familiar wie Euch wird es von Nutzen sein.
#. fr: Tu es un excellent familier, et tu mérites un beau cadeau. Prends, c'est pour toi.
msgctxt "NpcYell:15293:0:13"
msgid "You are extraordinary familiars indeed to have endured the trials thus far. This calls for a reward. I do hope you'll like it."
msgstr ""

#. ja: 変わった使い魔ネ！<br>なかなかやるじゃなイ！
#. de: Was für ein komischer Familiar. Und er wehrt sich auch noch!
#. fr: Quel drôle de familier<nbsp>! Et il se défend, en plus<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15294:0:13"
msgid "My, what curious<br>familiars you are!"
msgstr ""

#. ja: アタシを倒せたら<br>ご褒美あげよっかナ～？
#. de: Wenn du mich besiegst, gebe ich dir vielleicht etwas.
#. fr: Si tu me bats, je veux bien t'offrir une récompense<nbsp>!
msgctxt "NpcYell:15295:0:13"
msgid "Let's play a game! Defeat me, and I'll give you a reward!"
msgstr ""

#. ja: ほらぁ、どうしタ～？<br>はやく倒してみなヨ～！
#. de: Du lässt dir ziemlich viel Zeit<nbsp>...
#. fr: Eh bien alors<nbsp>? Dépêche-toi de me vaincre<nbsp>!
msgctxt "NpcYell:15296:0:13"
msgid "What's wrong? You're running out of time!"
msgstr ""

#. ja: 早くしないと<br>逃げちゃうゾ～？
#. de: Ich hab nicht den ganzen Tag Zeit, weißt du?
#. fr: Si tu traînes trop, je m'en vais<nbsp>!
msgctxt "NpcYell:15297:0:13"
msgid "You'd better hurry or I'll get away!"
msgstr ""

#. ja: ムシとかひどぉイ～！<br>もぉいい、帰ル！
#. de: Scheinbar werde ich nicht gebraucht. Und Tschüss!
#. fr: C-c'est pas sympa de m'ignorer<nbsp>! J'me tire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15298:0:13"
msgid "It's as if I'm not even here...<br>I've had enough, I'm leaving!"
msgstr ""

#. ja: きゃ～こわ～イ！<br>倒されちゃ～ウ！
#. de: Auaaa! Nicht so doll!
#. fr: Ouille, ouille, ouille, je sens que je vais prendre cher<nbsp>!
msgctxt "NpcYell:15299:0:13"
msgid "Tee hee, that tickles!"
msgstr ""

#. ja: キャハハハッ！<br>にっげロ～！
#. de: Kehehe! Weg bin ich!
#. fr: Kyaaahaha<nbsp>! Fuyooons<nbsp>!
msgctxt "NpcYell:15300:0:13"
msgid "That's the spirit! But can you keep it up?"
msgstr ""

#. ja: ほらほら、がんばらないと<br>ご褒美あげないヨ～？
#. de: Etwas mehr Elan, oder du bekommst gar nichts!
#. fr: Allez, on s'active<nbsp>! Tu veux ta récompense, oui ou non<nbsp>?
msgctxt "NpcYell:15301:0:13"
msgid "You'll need to do better if you want your prize!"
msgstr ""

#. ja: キャハハハッ！<br>よくできましタ～！
#. de: Kehehe! Gut gemacht!
#. fr: Ayaaa<nbsp>! Bien joué<nbsp>!
msgctxt "NpcYell:15302:0:13"
msgid "Ahaha! Well done!"
msgstr ""

#. ja: ざんねんでしタ～！<br>キャハハッ、バイバ～イ！
#. de: Das wahr wohl nichts! Auf Nimmer<shy>wieder<shy>sehen!
#. fr: Dommage, c'est raté<nbsp>! Ciao<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15303:0:13"
msgid "Oh, what a shame!<br>Better luck next time!"
msgstr ""

#. ja: アオォォォン！
#. de: Aruuuuuu!
#. fr: Ahooouuuu<nbsp>!
msgctxt "NpcYell:15304:0:13"
msgid "Awoooooo!"
msgstr ""

#. ja: グルルルル…
#. de: Grrrr! \<winsel>
#. fr: Rrr... Rrrr...
msgctxt "NpcYell:15305:0:13"
msgid "Grrrrrr..."
msgstr ""

#. ja: ガウガウ！
#. de: Rrrarf! Rrrrarf!
#. fr: Warf<nbsp>! Warf<nbsp>!
msgctxt "NpcYell:15306:0:13"
msgid "Grrraaawrrr!"
msgstr ""

#. ja: グル、グルゥゥゥ…
#. de: Uwuwu ... 
#. fr: Grrrooouuu...
msgctxt "NpcYell:15307:0:13"
msgid "Grrr...grrroooargh!"
msgstr ""

#. ja: アオオォォン！
#. de: Mrrru! \<schnauf>
#. fr: Hooooouuu<nbsp>!
msgctxt "NpcYell:15308:0:13"
msgid "Awoooooo!"
msgstr ""

#. ja: グガァァァッ！
#. de: Rrrrrargh!
#. fr: Groaaar<nbsp>!
msgctxt "NpcYell:15309:0:13"
msgid "Graaarrrgh!"
msgstr ""

#. ja: ガウッ！
#. de: \<knurr>
#. fr: Groah<nbsp>!
msgctxt "NpcYell:15310:0:13"
msgid "Rawrrr!"
msgstr ""

#. ja: ガオォォォォッン！
#. de: Graoooh!
#. fr: Gaoooouuh<nbsp>!
msgctxt "NpcYell:15311:0:13"
msgid "Groooaaar!"
msgstr ""

#. ja: キュゥゥゥゥン…
#. de: Huuurgh<nbsp>...
#. fr: Kaaaï....
msgctxt "NpcYell:15312:0:13"
msgid "\\<whimper>"
msgstr ""

#. ja: 砕け散るがいい！
#. de: Ich schlag dich zu Brei!
#. fr: Je vais vous transformer en charpie<nbsp>!
msgctxt "NpcYell:15313:0:13"
msgid "I'll pound you into pulp!"
msgstr ""

#. ja: ハッ…<br>魔導兵器まで私のファン？
#. de: Selbst die Kriegsmaschinen scheinen mich zu lieben.
#. fr: J'ai des fans même parmi les armes magitek<nbsp>!
msgctxt "NpcYell:15314:0:13"
msgid "Even warmachina seem to love me."
msgstr ""

#. ja: お茶目な兵器ですな！
#. de: Welch kuriose Tötungsmaschinen!
#. fr: Ces machines de mort ont un charme fou<nbsp>!
msgctxt "NpcYell:15315:0:13"
msgid "Such quaint killing machines!"
msgstr ""

#. ja: ミサイルの数が足りませんな…
#. de: Dabei wollte ich gerade erst loslegen<nbsp>...
#. fr: Ça manque un peu de missiles à mon goût...
msgctxt "NpcYell:15316:0:13"
msgid "And I was just getting started..."
msgstr ""

#. ja: お見事です！
#. de: Bravo, Vater!
#. fr: Tu es le plus fort, Papounet<nbsp>!
msgctxt "NpcYell:15317:0:13"
msgid "Bravo, Father!"
msgstr ""

#. ja: そんなんじゃ、びくともしねぇぜ？
#. de: Soll mich das etwa beeindrucken?!
#. fr: Va falloir faire mieux que ça<nbsp>!
msgctxt "NpcYell:15318:0:13"
msgid "You really must try harder!"
msgstr ""

#. ja: 寄る年波には…<br>勝てませんな…
#. de: Ich wird wohl langsam alt<nbsp>...
#. fr: La valeur n'attend pas le nombre des années...
msgctxt "NpcYell:15319:0:13"
msgid "I must be getting old..."
msgstr ""

#. ja: ズンズンズンズン♪
#. de: Immer schön im Kreis! ♪
#. fr: Zouu zouu zouu<nbsp>!♪
msgctxt "NpcYell:15320:0:13"
msgid "Round and round we go!♪"
msgstr ""

#. ja: し・ん・し！<br>それ、し・ん・し！！
#. de: Immer ein Gentleman!
#. fr: Gentilhomme avant tout<nbsp>!
msgctxt "NpcYell:15321:0:13"
msgid "Gentle is as gentle does!"
msgstr ""

#. ja: ヒルディィィィィブランドゥ！
#. de: Ich bin ein Manderville!
#. fr: Pourvu que les Manderville gagnent<nbsp>!
msgctxt "NpcYell:15322:0:13"
msgid "I'm a Manderville man!"
msgstr ""

#. ja: 父上、お助けをー！
#. de: Vater! Hilf mir!
#. fr: Papounet, à l'aide<nbsp>!
msgctxt "NpcYell:15323:0:13"
msgid "Father! A little help!"
msgstr ""

#. ja: ワァーーー！
#. de: Waaaaah!
#. fr: OuaAAaaHHh<nbsp>!!
msgctxt "NpcYell:15324:0:13"
msgid "Waaaaaah!"
msgstr ""

#. ja: フッフッフ…<br>私についてこられますかな？
#. de: Weiter so, immer weiter!
#. fr: Ha haaa<nbsp>! Voyons si vous arrivez à me suivre<nbsp>!
msgctxt "NpcYell:15325:0:13"
msgid "Keep up, now, keep up!"
msgstr ""

#. ja: フレ、フレ、父上！
#. de: Zeig's ihnen, Vater!
#. fr: Mon papounet va vous faire voir trente-six chandelles<nbsp>!
msgctxt "NpcYell:15326:0:13"
msgid "Show them what for, Father!"
msgstr ""

#. ja: 事件の匂い、キャッチし♪
#. de: Ich bin an dem Fall dran! ♪
#. fr: Je continue de mener l'enquête<nbsp>!♪
msgctxt "NpcYell:15327:0:13"
msgid "I am on the case!♪"
msgstr ""

#. ja: 父もまた、紳士的♪
#. de: Was sind wir doch für ein Gentleman-Duo! ♪
#. fr: Quel gentilhomme tu es, Papounet<nbsp>!♪
msgctxt "NpcYell:15328:0:13"
msgid "What a gentlemanly duo we are!♪"
msgstr ""

#. ja: 父上なら大丈夫でしょう！
#. de: Keine Sorge, Vater!
#. fr: Tu vas y arriver Papounet, j'en suis sûr<nbsp>!
msgctxt "NpcYell:15329:0:13"
msgid "Naught to worry you, Father!"
msgstr ""

#. ja: 私も本気を出しますぞ！
#. de: Jetzt mache ich auch ernst!
#. fr: Attention, le gentilhomme détective entre en scène<nbsp>!
msgctxt "NpcYell:15330:0:13"
msgid "No more Mister Nice Inspector!"
msgstr ""

#. ja: 今こそチャンスです！
#. de: Jetzt, Vater!
#. fr: Maintenant, Papounet<nbsp>!
msgctxt "NpcYell:15331:0:13"
msgid "Now, Father!"
msgstr ""

#. ja: さあ、一緒に大技を…！
#. de: Zeit, dies zu beenden!
#. fr: C'en est fini de vous, Monsieur Gélule<nbsp>!
msgctxt "NpcYell:15332:0:13"
msgid "Time to end this!"
msgstr ""

#. ja: もう、お終いですぞ…
#. de: Wir haben deine Spielzeuge kaputt gemacht.
#. fr: En mille morceaux, ha ha<nbsp>!
msgctxt "NpcYell:15333:0:13"
msgid "We've broken your toys."
msgstr ""

#. ja: おとなしく投降しなさい！
#. de: Es ist vorbei! Ergib dich!
#. fr: Rendez-vous im<shy>mé<shy>dia<shy>te<shy>ment<nbsp>!
msgctxt "NpcYell:15334:0:13"
msgid "This is over! Surrender!"
msgstr ""

#. ja: た、助かりましたぞ…
#. de: Das war knapp<nbsp>...
#. fr: Ouf, heureusement qu'on a gagné...
msgctxt "NpcYell:15335:0:13"
msgid "That was too close..."
msgstr ""

#. ja: 大量大量！<br>たくさん釣れたな！
#. de: Und noch einer! Das Glück scheint mir heute wirklich aus dem Arsch!
#. fr: Incroyable<nbsp>! C'est une pêche mirrraculeuse<nbsp>!
msgctxt "NpcYell:15336:0:13"
msgid "And another! In all my years, I've never had so much luck!"
msgstr ""

#. ja: むむっ…あれは…？
#. de: Moment<nbsp>... Was ist das?
#. fr: Hmm... Qu'est-ce donc<nbsp>?
msgctxt "NpcYell:15337:0:13"
msgid "Wait... What's that?"
msgstr ""

#. ja: 面倒な奴らが…<br>魚を狙ってるのか？
#. de: Da ist wohl jemand hinter meinem Fang her!
#. fr: Oh non, ils en ont aprrrès mes poissons<nbsp>!
msgctxt "NpcYell:15338:0:13"
msgid "Is something out there looking to snatch my catch!?"
msgstr ""

#. ja: せっかくの釣果を<br>奪われてたまるか！
#. de: Über meine Leiche!
#. fr: J'vais pas les laisser se tirrrer avec mon butin<nbsp>!
msgctxt "NpcYell:15339:0:13"
msgid "Why, the nerve!"
msgstr ""

#. ja: 頼むよ！<br>魚籠を守ってくれ！
#. de: Für diesen vollen Korb hab ich hart gearbeitet! Nichts will ich davon hergeben!
#. fr: Je compte sur toi<nbsp>! Aide-moi à prrrotéger mes paniers<nbsp>!
msgctxt "NpcYell:15340:0:13"
msgid "I fished long and hard to fill that basket. See that it stays full!"
msgstr ""

#. ja: 本当に助かった<br>心より感謝するよ
#. de: Ah, ich danke dir. Mein Fang ist sicher!
#. fr: Pfiou<nbsp>! On a réussi. Merrrci à toi, l'ami<if $gn4>e</if>.
msgctxt "NpcYell:15341:0:13"
msgid "My thanks, friend! My catch is safe!"
msgstr ""

#. ja: さあ、釣果を持って<br>集落に帰るぞ！
#. de: Und heute Abend wird geschlemmt, das sag ich dir!
#. fr: Allez, il est temps de rrrentrer au bercail<nbsp>!
msgctxt "NpcYell:15342:0:13"
msgid "Tonight, I dine like a king!"
msgstr ""

#. ja: ああ～…<br>僕の魚がぁ…
#. de: Nein<nbsp>... Die ganze harte Arbeit<nbsp>...
#. fr: Bon sang... Mes poissons... mes prrrécieux poissons...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15343:0:13"
msgid "My catch...<br>My precious catch..."
msgstr ""

#. ja: 仕方ない<br>今日は諦めよう…
#. de: Niemand wird mir glauben<nbsp>...
#. fr: J'abandonne... Je rrretenterai ma chance une autre fois<nbsp>!
msgctxt "NpcYell:15344:0:13"
msgid "Now no one will ever believe me..."
msgstr ""

#. ja: 飛空艇の魔法障壁では…！
#. de: Die Schutzbarriere des Luftschiffes ...!
#. fr: La barrière de l'aéronef ne va pas tenir<nbsp>!
msgctxt "NpcYell:15346:0:13"
msgid "The airship barrier won't be enough!"
msgstr ""

#. ja: うそっ…<br>そんな…！
#. de: W-Was?! Nein<nbsp>...
#. fr: Oh non...
msgctxt "NpcYell:15347:0:13"
msgid "Oh no..."
msgstr ""

#. ja: この雷気は…！<br>逃げろッ…！！
#. de: Was ist das bloß?! Flieht!
#. fr: Attention à la foudre<nbsp>!
msgctxt "NpcYell:15348:0:13"
msgid "\\<gasp> L-Lightning!"
msgstr ""

#. ja: ス、スフェーン様が…<br>私たちのために…？
#. de: Ihre Hoheit ... Seid Ihr allein unseretwegen gelandet?!
#. fr: Sa Majesté Sphene<nbsp>? Ici<nbsp>?
msgctxt "NpcYell:15349:0:13"
msgid "Th-The princess herself came for us?"
msgstr ""

#. ja: 王女様が来てくださるわ<br>皆、助かるわよ…！
#. de: Königin Sphene wird uns alle retten ...!
#. fr: La princesse arrive<nbsp>! On va s'en sortir<nbsp>!
msgctxt "NpcYell:15350:0:13"
msgid "Her Highness is here! We're going to be fine!"
msgstr ""

#. ja: ハルオーネの名の下に！
#. de: Im Namen von Halone!
#. fr: Pour la grande gloire de Halone<nbsp>!
msgctxt "NpcYell:15351:0:13"
msgid "In the name of the Fury!"
msgstr ""

#. ja: 日々の訓練の成果を！
#. de: Mein Training hat sich ausgezahlt!
#. fr: Mon en<shy>traî<shy>ne<shy>ment va enfin porter ses fruits<nbsp>!
msgctxt "NpcYell:15352:0:13"
msgid "The fruits of my training!"
msgstr ""

#. ja: 唸れ、銀剣の如く！
#. de: Kühn wie die Silberklinge!
#. fr: Affûté comme la lame de mon épée<nbsp>!
msgctxt "NpcYell:15353:0:13"
msgid "Bold like the Silver Fuller!"
msgstr ""

#. ja: 突貫します…！
#. de: Mit voller Kraft voraus<nbsp>...!
#. fr: En avant toute<nbsp>!
msgctxt "NpcYell:15354:0:13"
msgid "Forward!"
msgstr ""

#. ja: 私が、守ります！
#. de: Ich werde euch beschützen!
#. fr: Je vous protégerai<nbsp>!
msgctxt "NpcYell:15355:0:13"
msgid "As long as I can hold a shield!"
msgstr ""

#. ja: この生命を賭して…！
#. de: Mein Leben für Ishgard!
#. fr: Cette victoire ne me coûtera pas la vie<nbsp>!
msgctxt "NpcYell:15356:0:13"
msgid "My life for Ishgard!"
msgstr ""

#. ja: 貫いてみせる！
#. de: Mein Stich wird wehtun!
#. fr: Ça va piquer<nbsp>!
msgctxt "NpcYell:15357:0:13"
msgid "This will sting!"
msgstr ""

#. ja: 血の花を咲かせろ！
#. de: Dein Blut wird den Boden zieren!
#. fr: Ma lance va vous saigner<nbsp>!
msgctxt "NpcYell:15358:0:13"
msgid "I'll make you bleed!"
msgstr ""

#. ja: ドラゴンヘッドの騎兵を<br>侮るな！
#. de: Unterschätze die Ritter des Drachenkopfes nicht!
#. fr: Ne sous-estimez jamais le camp de la Tête du dragon<nbsp>!
msgctxt "NpcYell:15359:0:13"
msgid "Don't underestimate us!"
msgstr ""

#. ja: 敬愛する卿のように！
#. de: Für Lord Haurchefant!
#. fr: Pour notre comte bien-aimé<nbsp>!
msgctxt "NpcYell:15360:0:13"
msgid "For Lord Haurchefant!"
msgstr ""

#. ja: 竜すら討つ力を！
#. de: Selbst Drachen fürchten diese Macht!
#. fr: Halone, prête-moi ta force<nbsp>!
msgctxt "NpcYell:15361:0:13"
msgid "Halone grant me strength!"
msgstr ""

#. ja: くっ、ここで落ちるわけには…
#. de: Urgh, ich darf hier nicht fallen<nbsp>...
#. fr: Argh... Il faut que je me reprenne<nbsp>!
msgctxt "NpcYell:15362:0:13"
msgid "Ugh, I can't fall here..."
msgstr ""

#. ja: 手間をかけました…！
#. de: Ich danke euch zutiefst.
#. fr: Merci pour le coup de main<nbsp>!
msgctxt "NpcYell:15363:0:13"
msgid "I'm in your debt."
msgstr ""

#. ja: 油断はしません
#. de: Volle Konzentration.
#. fr: Comptez sur moi<nbsp>!
msgctxt "NpcYell:15364:0:13"
msgid "No mistakes."
msgstr ""

#. ja: しっかり狙って…！
#. de: Ziel genau im Blick<nbsp>...!
#. fr: Dans la ligne de mire<nbsp>!
msgctxt "NpcYell:15365:0:13"
msgid "Halone guide my hand!"
msgstr ""

#. ja: 障害は排除します！
#. de: Ich mache den Weg frei!
#. fr: Élimination immédiate des obstacles<nbsp>!
msgctxt "NpcYell:15366:0:13"
msgid "I will clear the way!"
msgstr ""

#. ja: この弓が敵を穿つ…！
#. de: Dieser Bogen wird dich durchlöchern<nbsp>...!
#. fr: Touché<nbsp>!
msgctxt "NpcYell:15367:0:13"
msgid "You won't survive this unscathed!"
msgstr ""

#. ja: 渾身の一撃です！
#. de: Meine gesamte Kraft in einem Schuss!
#. fr: Attention, ça va faire mal partout<nbsp>!
msgctxt "NpcYell:15368:0:13"
msgid "With everything I have!"
msgstr ""

#. ja: 皆を、救うんです…
#. de: Alle zählen auf uns<nbsp>...
#. fr: Je n'ai pas le droit d'abandonner...
msgctxt "NpcYell:15369:0:13"
msgid "Everyone is depending on us..."
msgstr ""

#. ja: すみません…！
#. de: Habt Dank!
#. fr: Pardon... Je ferai attention<nbsp>!
msgctxt "NpcYell:15370:0:13"
msgid "My thanks!"
msgstr ""

#. ja: 押されている！？
#. de: Langsam wird es eng<nbsp>...
#. fr: Nous perdons du terrain<nbsp>!
msgctxt "NpcYell:15371:0:13"
msgid "We must stand together!"
msgstr ""

#. ja: 仕留めるッ！
#. de: Nun ist Schluss!
#. fr: Venez vous battre, pleutres<nbsp>!
msgctxt "NpcYell:15372:0:13"
msgid "Down with you!"
msgstr ""

#. ja: 甘く見るなよッ！
#. de: Seht euch vor!
#. fr: Tu me sous-estimes<nbsp>!
msgctxt "NpcYell:15373:0:13"
msgid "You underestimate me!"
msgstr ""

#. ja: 隙ありッ！
#. de: Hinfort aus Ishgard!
#. fr: Encaisse donc ça<nbsp>!
msgctxt "NpcYell:15374:0:13"
msgid "There!"
msgstr ""

#. ja: 受けてもらおうッ！
#. de: Noch nicht genug?
#. fr: C'en est fini<nbsp>!
msgctxt "NpcYell:15375:0:13"
msgid "It ends here!"
msgstr ""

#. ja: これが騎士の意地だッ！
#. de: Nun ist Schluss!
#. fr: Tu l'auras voulu<nbsp>!
msgctxt "NpcYell:15376:0:13"
msgid "This knight does not yield!"
msgstr ""

#. ja: 我が友のためにッ！
#. de: Für einen wahren Freund!
#. fr: Pour Ishgard<nbsp>!
msgctxt "NpcYell:15377:0:13"
msgid "For Ishgard!"
msgstr ""

#. ja: まだ、終わりにはさせない…！
#. de: Ich werde es nicht hier enden lassen<nbsp>...
#. fr: Je ne tomberai pas aussi facilement<nbsp>!
msgctxt "NpcYell:15378:0:13"
msgid "It isn't over yet!"
msgstr ""

#. ja: これが私の描く未来ッ！
#. de: Meine Farben malen eine strahlende Zukunft!
#. fr: L'avenir est au bout de mon pinceau<nbsp>!
msgctxt "NpcYell:15379:0:13"
msgid "I draw upon the canvas of creation!"
msgstr ""

#. ja: 観念なさい！
#. de: Macht euch auf was gefasst!
#. fr: Inutile de résister<nbsp>!
msgctxt "NpcYell:15380:0:13"
msgid "Behold!"
msgstr ""

#. ja: さぁ、いくわよ！
#. de: Jetzt komme ich!
#. fr: C'est parti<nbsp>!
msgctxt "NpcYell:15381:0:13"
msgid "Here goes!"
msgstr ""

#. ja: そーれっ！
#. de: Und<nbsp>... hier!
#. fr: Et hop-là<nbsp>!
msgctxt "NpcYell:15382:0:13"
msgid "Take that!"
msgstr ""

#. ja: こんなのはどう？
#. de: Wie gefällt dir das?!
#. fr: Voyons ce que ça donne<nbsp>!
msgctxt "NpcYell:15383:0:13"
msgid "Try this!"
msgstr ""

#. ja: 私だって、やれるんだから！
#. de: Unterschätzt nicht meine Kunst!
#. fr: Moi aussi, je sais me battre<nbsp>!
msgctxt "NpcYell:15384:0:13"
msgid "This should do it!"
msgstr ""

#. ja: 邪魔だ
#. de: Aus dem Weg.
#. fr: Hors de ma vue<nbsp>!
msgctxt "NpcYell:15385:0:13"
msgid "Out of my way!"
msgstr ""

#. ja: 苦痛を与えよう
#. de: Spüre wahren Schmerz.
#. fr: Vous allez souffrir<nbsp>!
msgctxt "NpcYell:15386:0:13"
msgid "You will suffer!"
msgstr ""

#. ja: 我が前にひれ伏せ
#. de: Auf die Knie mit dir!
#. fr: Prosternez-vous devant moi<nbsp>!
msgctxt "NpcYell:15387:0:13"
msgid "On your knees!"
msgstr ""

#. ja: 今だ、そこですッ！
#. de: Das ist meine Chance!
#. fr: Maintenant<nbsp>!
msgctxt "NpcYell:15388:0:13"
msgid "That's far enough!"
msgstr ""

#. ja: 無駄な抵抗をッ！
#. de: Gib lieber auf!
#. fr: Nul ne sert de résister<nbsp>!
msgctxt "NpcYell:15389:0:13"
msgid "Think you're tough, do you?"
msgstr ""

#. ja: 頭を使えば、こんなものです
#. de: Der wahre Kampf findet im Kopf statt.
#. fr: Voilà ce qu'on peut faire quand on se serrrt de sa tête.
msgctxt "NpcYell:15390:0:13"
msgid "Innovation is the key to victory!"
msgstr ""

#. ja: 計算どおりなら、これで！
#. de: Ich habe alles berechnet!
#. fr: Si mes calculs sont bons, ce sera ton coup de grâce<nbsp>!
msgctxt "NpcYell:15391:0:13"
msgid "Just as I planned!"
msgstr ""

#. ja: ラマチを護ってみせるッ！
#. de: Ich werde Lamaty'i beschützen!
#. fr: Je ferai tout pour protéger Lamaty'i<nbsp>!
msgctxt "NpcYell:15392:0:13"
msgid "You'll not lay a hand on my sister!"
msgstr ""

#. ja: いくよっ！
#. de: Jetzt komme ich!
#. fr: C'est parti<nbsp>!
msgctxt "NpcYell:15393:0:13"
msgid "Take this!"
msgstr ""

#. ja: 覚悟して！
#. de: Mach dich bereit!
#. fr: Préparons-nous<nbsp>!
msgctxt "NpcYell:15394:0:13"
msgid "Brace yourself!"
msgstr ""

#. ja: 加減なんてしない！
#. de: Ich halte nichts zurück!
#. fr: Je ne reculerai devant rien<nbsp>!
msgctxt "NpcYell:15395:0:13"
msgid "No holding back!"
msgstr ""

#. ja: 全身全霊をかけて！
#. de: Mit Körper und Geist vereint!
#. fr: Je vais y mettre tout mon cœur<nbsp>!
msgctxt "NpcYell:15396:0:13"
msgid "With every mote of my being!"
msgstr ""

#. ja: 護りたいものを、護るために！
#. de: Hiermit werde ich alle beschützen!
#. fr: Je dois trouver la force de protéger tout ce qui compte à mes yeux<nbsp>!
msgctxt "NpcYell:15397:0:13"
msgid "For all that I hold dear!"
msgstr ""

#. ja: キミに力を！
#. de: Hier, halt noch etwas durch!
#. fr: Voilà<nbsp>! Vigueur renouvelée<nbsp>!
msgctxt "NpcYell:15398:0:13"
msgid "May this give you strength!"
msgstr ""

#. ja: もう大丈夫だよ！
#. de: Das haben wir gleich!
#. fr: Ne vous inquiétez pas, tout va bien se passer<nbsp>!
msgctxt "NpcYell:15399:0:13"
msgid "You'll be alright!"
msgstr ""

#. ja: 回復するね！
#. de: Heilung kommt sofort!
#. fr: Vite<nbsp>! Des soins<nbsp>!
msgctxt "NpcYell:15400:0:13"
msgid "I'll heal you!"
msgstr ""

#. ja: ワフン♪
#. de: Rrrrruff!
#. fr: Ouaouf<nbsp>!
msgctxt "NpcYell:15401:0:13"
msgid "Ruff-ruff!"
msgstr ""

#. ja: パカパカ！
#. de: Gagaaack!
#. fr: Pakapaka<nbsp>!
msgctxt "NpcYell:15402:0:13"
msgid "Cluck-cluck!"
msgstr ""

#. ja: キュ～っ
#. de: Mrrruuu!
#. fr: Kyuuu<nbsp>!
msgctxt "NpcYell:15403:0:13"
msgid "\\<squeak>"
msgstr ""

#. ja: ダイジョウブ！
#. de: Schlaf, Kindlein, schlaf<nbsp>...
#. fr: Tout va bien se passer<nbsp>!
msgctxt "NpcYell:15404:0:13"
msgid "You okay?"
msgstr ""

#. ja: グヘヘヘヘ！
#. de: Gahahahaha!
#. fr: Mouahaha<nbsp>!
msgctxt "NpcYell:15405:0:13"
msgid "Gahahahaha!"
msgstr ""

#. ja: み～つけた！
#. de: Hab dich! Du bist!
#. fr: Je t'ai trouvé<nbsp>!
msgctxt "NpcYell:15406:0:13"
msgid "Found you!"
msgstr ""

#. ja: ◎＃♭▲♪♪
#. de: ◎＃♭▲♪♪
#. fr: ◎＃♭▲♪♪
msgctxt "NpcYell:15407:0:13"
msgid "◎＃♭▲♪"
msgstr ""

#. ja: 手ヌルイ！
#. de: Nimm das, du Schurke!
#. fr: Bande de chiffes molles<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15408:0:13"
msgid "You must do better<br>than that against me!"
msgstr ""

#. ja: シュシュポッポ
#. de: Tut-Tuuut!
#. fr: Tchou-tchou<nbsp>!
msgctxt "NpcYell:15409:0:13"
msgid "Choo-choo!"
msgstr ""

#. ja: ホーーーウ！
#. de: Hohoho<nbsp>...!
#. fr: Ho ho ho<nbsp>!
msgctxt "NpcYell:15410:0:13"
msgid "Manderville maaaaaan!"
msgstr ""

#. ja: ハァ…
#. de: \<seufz>
#. fr: Pfff...
msgctxt "NpcYell:15411:0:13"
msgid "\\<sigh>"
msgstr ""

#. ja: 道案内は任せたわよ
#. de: Also dann, zeig uns, wo wir lang müssen.
#. fr: Pars devant, on te suit<nbsp>!
msgctxt "NpcYell:15412:0:13"
msgid "Pray lead the way."
msgstr ""

#. ja: 承知しましたケロ！
#. de: Nichts leichter als das, quaak!
#. fr: Faites-moâ confiance<nbsp>!
msgctxt "NpcYell:15413:0:13"
msgid "With pleasure, ribbit!"
msgstr ""

#. ja: 興味深い書物も<br>残されているようね
#. de: Scheint, als gäbe es hier noch immer eine Menge interessanter Schriftstücke.
#. fr: Comme j'aimerais avoir le temps de feuilleter tous ces gros livres<nbsp>!
msgctxt "NpcYell:15414:0:13"
msgid "Even at a glance, I see many interesting tomes."
msgstr ""

#. ja: 大撤収時に<br>放棄されたということか…
#. de: Zwang sie die Flucht dazu, all dies zurückzulassen<nbsp>...?
#. fr: Trop gros pour être emportés lors de l'exode...
msgctxt "NpcYell:15415:0:13"
msgid "'Tis a pity they had to be abandoned."
msgstr ""

#. ja: 巨大な魔道書…<br>なのか！？
#. de: Ist das<nbsp>... ein riesiges Grimoire!?
#. fr: Un... Un grimoire géant<nbsp>!
msgctxt "NpcYell:15416:0:13"
msgid "Is that supposed to be a grimoire!?"
msgstr ""

#. ja: さあ、勇敢に挑むケロ！
#. de: Los, stellt euch unerschrocken dem Kampf, quaak!
#. fr: Haut les cœuârs<nbsp>!
msgctxt "NpcYell:15417:0:13"
msgid "Yes, but not the kind you want to read, ribbit."
msgstr ""

#. ja: 皆さん、ご無事ケロ？
#. de: Sind alle unverletzt, quaak?
#. fr: Tout le monde va bien, coâ<nbsp>?
msgctxt "NpcYell:15418:0:13"
msgid "Everyone hale and whole, ribbit?"
msgstr ""

#. ja: 圧殺されなくて<br>ホッとしたよ…
#. de: Ich sah mich schon zerquetscht am Boden liegen<nbsp>...
#. fr: On a failli se faire aplatir comme des crêpes...
msgctxt "NpcYell:15419:0:13"
msgid "Thank goodness we weren't crushed..."
msgstr ""

#. ja: おっと警戒でケロケーロ！
#. de: Oh, hier ist Vorsicht geboten, quaak!
#. fr: Restez vigilants, coâ<nbsp>!
msgctxt "NpcYell:15420:0:13"
msgid "Watch out, ribbit!"
msgstr ""

#. ja: 奇妙な使い魔だ…
#. de: Was für ein ungewöhnliches Familiar<nbsp>...
#. fr: Quel étrange familier...
msgctxt "NpcYell:15421:0:13"
msgid "What a curious familiar..."
msgstr ""

#. ja: 新大陸についての書物…？
#. de: Hm, dies scheint eine Abhandlung über die Neue Welt zu sein.
#. fr: Hmm... Des ouvrages sur le nouveau continent<nbsp>?
msgctxt "NpcYell:15422:0:13"
msgid "Is that a treatise on the New World I spy?"
msgstr ""

#. ja: これなら以前に<br>読んだことがあるよ
#. de: Ah, die habe ich mal gelesen. Kann ich wärmstens empfehlen.
#. fr: Je me rappelle en avoir lu quelques extraits...
msgctxt "NpcYell:15423:0:13"
msgid "Ah yes, I've read that one. I can recommend it."
msgstr ""

#. ja: 禁書庫への扉は<br>この先ケロ…！
#. de: Um zur Abteilung für verbotene Schriften zu kommen, müssen wir hier durch, quaak!
#. fr: Les rayons interdits sont par ici, coâ<nbsp>!
msgctxt "NpcYell:15424:0:13"
msgid "The entrance to the forbidden section is just ahead, ribbit."
msgstr ""

#. ja: さしずめ門番…<br>といったところかしら
#. de: Dann ist dieses Tierchen hier wohl der Wächter.
#. fr: Voilà un gardien des plus appropriés...
msgctxt "NpcYell:15425:0:13"
msgid "Which makes this fellow here the gatekeeper."
msgstr ""

#. ja: まさか炎が弱点とは…
#. de: Ich gestehe, ich hätte nicht auf Feuer als Schwachpunkt getippt<nbsp>...
#. fr: Son point faible était donc le feu...
msgctxt "NpcYell:15426:0:13"
msgid "I wouldn't have guessed it weak to fire."
msgstr ""

#. ja: 書に刻まれた術式に<br>縛られていたのでしょう
#. de: Das liegt wahrscheinlich daran, dass es an ein Grimoire gebunden war.
#. fr: Il avait cer<shy>tai<shy>ne<shy>ment été créé via un rituel magique...
msgctxt "NpcYell:15427:0:13"
msgid "On account of being bound to a tome, I would assume."
msgstr ""

#. ja: 魔法生物が使い魔召喚を？
#. de: Eine magische Kreatur, die Familiare beschwören kann!?
#. fr: Des créatures magiques qui invoquent des familiers<nbsp>!?
msgctxt "NpcYell:15428:0:13"
msgid "An arcane entity that can summon familiars!"
msgstr ""

#. ja: さすがは禁書庫…<br>警備が厳重ね
#. de: Es scheint, als seien die Wächter der verbotenen Abteilung aus einem anderen Holz geschnitzt.
#. fr: Pas de doute, nous sommes bien dans les rayons interdits...
msgctxt "NpcYell:15429:0:13"
msgid "The guardians of the forbidden section are a class apart."
msgstr ""

#. ja: 禁書といっても<br>内容は千差万別のようね
#. de: Verbotene Schriften kommen wirklich in allen möglichen Formen<nbsp>...
#. fr: Oh là là... Une telle variété de livres, c'est rare<nbsp>!
msgctxt "NpcYell:15430:0:13"
msgid "Forbidden tomes can certainly assume many forms..."
msgstr ""

#. ja: 目的の論文は<br>最奥部にあるケロ！
#. de: Die Auf<shy>zeich<shy>nun<shy>gen von Meisterin Matoya sind ganz am Ende dieses Gangs, quaak!
#. fr: L'ouvrage de madame Matoya n'est plus très loin, coâ<nbsp>!
msgctxt "NpcYell:15431:0:13"
msgid "Master Matoya's tome is at the far end, ribbit."
msgstr ""

#. ja: マトーヤ様の論文は…！？
#. de: Wo sind Matoyas Schriftstücke<nbsp>...?
#. fr: Le livre de maître Matoya<nbsp>! Il est...
msgctxt "NpcYell:15432:0:13"
msgid "Yet another guardian..."
msgstr ""

#. ja: それを探すためにも<br>守護像を退けるわよ！
#. de: Vor dem Suchen müssen wir uns erst um den letzten Wächter kümmern!
#. fr: Bah<nbsp>! Aucun gardien ne nous empêchera de mettre la main dessus<nbsp>!
msgctxt "NpcYell:15433:0:13"
msgid "Did you ever doubt it? Come, let's finish this."
msgstr ""

#. ja: 落石にも要注意だね
#. de: Seid auf der Hut vor fallenden Felsen.
#. fr: Attention aux éboulements<nbsp>!
msgctxt "NpcYell:15434:0:13"
msgid "Falling rocks to add to the danger..."
msgstr ""

#. ja: 落石にも要注意だね
#. de: Seid auf der Hut vor fallenden Felsen.
#. fr: Attention aux éboulements<nbsp>!
msgctxt "NpcYell:15435:0:13"
msgid "Falling rocks to add to the danger..."
msgstr ""

#. ja: ハッ！<br>警戒しつつ進みます！
#. de: Verstanden! Wir werden mit Vorsicht voranschreiten!
#. fr: Compris<nbsp>! Je garderai les yeux grands ouverts<nbsp>!
msgctxt "NpcYell:15436:0:13"
msgid "Let us proceed with caution."
msgstr ""

#. ja: 潰されたら<br>ひとたまりもないな
#. de: Wenn uns einer von denen zerquetscht, ist alles aus.
#. fr: Si ça s'effondre, nous sommes fichus<nbsp>!
msgctxt "NpcYell:15437:0:13"
msgid "It's over if we're crushed."
msgstr ""

#. ja: 潰されたら<br>ひとたまりもないな
#. de: Wenn uns einer von denen zerquetscht, ist alles aus.
#. fr: Si ça s'effondre, nous sommes fichus<nbsp>!
msgctxt "NpcYell:15438:0:13"
msgid "It's over if we're crushed."
msgstr ""

#. ja: 戦闘中も気が抜けませんね
#. de: Wir müssen stets aufmerksam bleiben, auch während des Kampfs.
#. fr: Restons vigilants, même en plein combat<nbsp>!
msgctxt "NpcYell:15439:0:13"
msgid "We can't lower our guard even in battle."
msgstr ""

#. ja: 小型気球を<br>背負っているのか！？
#. de: Er hat einen Ballon an seinem Rücken!?
#. fr: C'est un petit ballon que je vois sur son dos<nbsp>!?
msgctxt "NpcYell:15440:0:13"
msgid "Is that a balloon on his back!?"
msgstr ""

#. ja: 小型気球を<br>背負っているのか！？
#. de: Er hat einen Ballon an seinem Rücken!?
#. fr: C'est un petit ballon que je vois sur son dos<nbsp>!?
msgctxt "NpcYell:15441:0:13"
msgid "Is that a balloon on his back!?"
msgstr ""

#. ja: 上空からの銃撃に<br>注意しましょう…！
#. de: Seid vorbereitet auf Angriffe aus der Luft!
#. fr: Prenez garde aux attaques aériennes<nbsp>!
msgctxt "NpcYell:15442:0:13"
msgid "Be on guard for attacks from above!"
msgstr ""

#. ja: 独特の戦法に<br>驚かされたよ…
#. de: Eine durchaus einzigartige Strategie, mit der ich nie gerechnet hätte<nbsp>...
#. fr: Sa stratégie était pour le moins surprenante...
msgctxt "NpcYell:15443:0:13"
msgid "His tactics were unique to say the least..."
msgstr ""

#. ja: 独特の戦法に<br>驚かされたよ…
#. de: Eine durchaus einzigartige Strategie, mit der ich nie gerechnet hätte<nbsp>...
#. fr: Sa stratégie était pour le moins surprenante...
msgctxt "NpcYell:15444:0:13"
msgid "His tactics were unique to say the least..."
msgstr ""

#. ja: 風を操る技術は<br>見事でした
#. de: Fürwahr, ihre Kontrolle über den Wind ist beeindruckend.
#. fr: Sa maîtrise des vents était parfaite...
msgctxt "NpcYell:15445:0:13"
msgid "Their mastery of the wind isn't to be scoffed at."
msgstr ""

#. ja: 洞窟内を<br>要塞化しているのか
#. de: Oh, sie haben sogar die Höhlenwände verstärkt.
#. fr: Une grotte fortifiée, intéressant...
msgctxt "NpcYell:15446:0:13"
msgid "They've fortified the very cave."
msgstr ""

#. ja: 洞窟内を<br>要塞化しているのか
#. de: Oh, sie haben sogar die Höhlenwände verstärkt.
#. fr: Une grotte fortifiée, intéressant...
msgctxt "NpcYell:15447:0:13"
msgid "They've fortified the very cave."
msgstr ""

#. ja: 見事なものですね…
#. de: Wahrlich ein Anblick, der Respekt verlangt.
#. fr: Quelle technologie de pointe<nbsp>!
msgctxt "NpcYell:15448:0:13"
msgid "An impressive feat, I must allow."
msgstr ""

#. ja: 機械仕掛けの昇降機も<br>導入しているのか…
#. de: Selbst mechanische Fahrstühle haben sie eingebaut<nbsp>...
#. fr: Ils ont même des ascenseurs mécaniques<nbsp>!
msgctxt "NpcYell:15449:0:13"
msgid "They even have mechanized lifts."
msgstr ""

#. ja: 機械仕掛けの昇降機も<br>導入しているのか…
#. de: Selbst mechanische Fahrstühle haben sie eingebaut<nbsp>...
#. fr: Ils ont même des ascenseurs mécaniques<nbsp>!
msgctxt "NpcYell:15450:0:13"
msgid "They even have mechanized lifts."
msgstr ""

#. ja: この技術を<br>どこから学んだのでしょう？
#. de: Wie sind diese Technologien in ihre Hände gelangt?
#. fr: Ça alors<nbsp>! Comment les ont-ils construits<nbsp>?
msgctxt "NpcYell:15451:0:13"
msgid "How did they acquire the technology?"
msgstr ""

#. ja: あの扇で<br>風を起こすつもりか！？
#. de: Will sie mit diesem Fächer etwa Wind beschwören?!
#. fr: Elle compte faire souffler le vent avec cet éventail<nbsp>!?
msgctxt "NpcYell:15452:0:13"
msgid "Does she mean to rouse the wind with that fan!?"
msgstr ""

#. ja: あの扇で<br>風を起こすつもりか！？
#. de: Will sie mit diesem Fächer etwa Wind beschwören?!
#. fr: Elle compte faire souffler le vent avec cet éventail<nbsp>!?
msgctxt "NpcYell:15453:0:13"
msgid "Does she mean to rouse the wind with that fan!?"
msgstr ""

#. ja: ドラゴンヘッド流の技で<br>私が攻撃を防ぎます！
#. de: Mit den Techniken der Drachenkopf-Ritter werde ich euch schützen!
#. fr: Je vous protégerai grâce aux techniques de mon camp<nbsp>!
msgctxt "NpcYell:15454:0:13"
msgid "The knights of our camp have just the defense!"
msgstr ""

#. ja: 騎士階級のイクサル族<br>だったのかもしれないね
#. de: Ich gehe stark davon aus, dass sie eine Sturmreiterin war.
#. fr: C'était pro<shy>ba<shy>ble<shy>ment une sorte de guerrière ixale...
msgctxt "NpcYell:15455:0:13"
msgid "I daresay she was one of the Galeborne."
msgstr ""

#. ja: ハァハァ…<br>嵐のような攻撃でした
#. de: \<keuch> ... Ihre Angriffe waren wahrlich stürmisch.
#. fr: Ses attaques décoiffaient<nbsp>!
msgctxt "NpcYell:15456:0:13"
msgid "\\<pant> Her attacks were a veritable storm..."
msgstr ""

#. ja: 騎士階級のイクサル族<br>だったのかもしれないね
#. de: Ich gehe stark davon aus, dass sie eine Sturmreiterin war.
#. fr: C'était pro<shy>ba<shy>ble<shy>ment une sorte de guerrière ixale...
msgctxt "NpcYell:15457:0:13"
msgid "I daresay she was one of the Galeborne."
msgstr ""

#. ja: 兵員輸送用の<br>装甲気球だ！
#. de: Sie transportieren Soldaten in dem Ballon!
#. fr: C'est un ballon de transport de soldats<nbsp>!
msgctxt "NpcYell:15458:0:13"
msgid "An armored troop transport!"
msgstr ""

#. ja: 兵員輸送用の<br>装甲気球だ！
#. de: Sie transportieren Soldaten in dem Ballon!
#. fr: C'est un ballon de transport de soldats<nbsp>!
msgctxt "NpcYell:15459:0:13"
msgid "An armored troop transport!"
msgstr ""

#. ja: 射落とせれば<br>よかったのですが…
#. de: Wenn meine Pfeile sie nur zerschießen könnten<nbsp>...
#. fr: Si seulement nous pouvions le crever...
msgctxt "NpcYell:15460:0:13"
msgid "A pity my arrows can't pierce them..."
msgstr ""

#. ja: まさか空を進むことに<br>なるなんてね…
#. de: Ich hätte nicht gedacht, bis in den Himmel steigen zu müssen<nbsp>...
#. fr: Nous voilà dans les cieux maintenant...
msgctxt "NpcYell:15461:0:13"
msgid "We're well and truly in the sky now."
msgstr ""

#. ja: まさか空を進むことに<br>なるなんてね…
#. de: Ich hätte nicht gedacht, bis in den Himmel steigen zu müssen<nbsp>...
#. fr: Nous voilà dans les cieux maintenant...
msgctxt "NpcYell:15462:0:13"
msgid "We're well and truly in the sky now."
msgstr ""

#. ja: まだ足が震えていますよ…
#. de: Meine Beine sind weich wie Pudding.
#. fr: J'en ai les genoux qui tremblent...
msgctxt "NpcYell:15463:0:13"
msgid "I can't be back on solid ground soon enough..."
msgstr ""

#. ja: 神降ろしを<br>許すわけにはッ！
#. de: Wir werden nicht zulassen, dass diese Beschwörung stattfindet!
#. fr: Vous n'invoquerez pas votre Primordiale<nbsp>!
msgctxt "NpcYell:15464:0:13"
msgid "We can't allow this summoning!"
msgstr ""

#. ja: この試練…<br>突破してみせよう！
#. de: Diese Prüfung<nbsp>... Wir werden sie mit Bravour meistern!
#. fr: Nous sortirons victorieux de cette épreuve, je le sais<nbsp>!
msgctxt "NpcYell:15465:0:13"
msgid "Let us prove our worth, my friends!"
msgstr ""

#. ja: ええ、必ず！
#. de: Ich hätte es nicht besser sagen können!
#. fr: Ça ne fait aucun doute, Sire Aymeric<nbsp>!
msgctxt "NpcYell:15466:0:13"
msgid "Aye, beyond a shadow of doubt!"
msgstr ""

#. ja: あれは、モグリン様！？
#. de: Ist das nicht Moglin?!
#. fr: Quoi<nbsp>!? Sire Moglin, ici<nbsp>?
msgctxt "NpcYell:15467:0:13"
msgid "By the Twelve, it's Chieftain Moglin!"
msgstr ""

#. ja: こ、これも試練ということか…？
#. de: I-Ist er etwa auch Teil der Prüfung<nbsp>...?
#. fr: Il doit faire partie de l'épreuve...
msgctxt "NpcYell:15468:0:13"
msgid "That he should be part of the trial..."
msgstr ""

#. ja: 雲海のモーグリ族まで<br>待ち構えているとは
#. de: Ich hätte nicht erwartet, hier gegen Mogrys kämpfen zu müssen<nbsp>...
#. fr: Les Mogs célestes ne nous arrêteront pas<nbsp>!
msgctxt "NpcYell:15469:0:13"
msgid "I didn't expect to face the moogles..."
msgstr ""

#. ja: つい全力で<br>応戦してしまったが…
#. de: Hoffentlich haben wir ihnen nicht zu sehr zugesetzt<nbsp>...
#. fr: Il a donné tout ce qu'il avait...
msgctxt "NpcYell:15470:0:13"
msgid "I pray they aren't too badly hurt."
msgstr ""

#. ja: ハァハァ…<br>さすがに空気が薄いな…
#. de: \<schnauf> Ich muss sagen, die Luft wird langsam unangenehm dünn.
#. fr: Plus nous montons, plus l'air se fait rare...
msgctxt "NpcYell:15471:0:13"
msgid "\\<pant> The air is rather thin this high up..."
msgstr ""

#. ja: 呼吸を整えつつ<br>進みましょう
#. de: Atmet kontrolliert, wir haben noch einiges an Weg vor uns.
#. fr: Ménagez-vous, c'est loin d'être terminé<nbsp>!
msgctxt "NpcYell:15472:0:13"
msgid "It isn't a race, so let us pace ourselves."
msgstr ""

#. ja: あの紋様は…
#. de: Dieses Symbol<nbsp>...
#. fr: Ce symbole...
msgctxt "NpcYell:15473:0:13"
msgid "The wyrm depicted on yonder crest..."
msgstr ""

#. ja: 聖竜でも邪竜でもない…<br>詩竜ラタトスクか？
#. de: Es ist weder Hraesvelgr noch Nidhogg<nbsp>... Könnte es Ratatoskr sein?
#. fr: Ce n'est ni Hraesvelgr, ni Nidhogg... Serait-ce Ratatosk<nbsp>?
msgctxt "NpcYell:15474:0:13"
msgid "Neither Hraesvelgr nor Nidhogg. It could only be Ratatoskr."
msgstr ""

#. ja: 黒き有翼馬…！？
#. de: Ein geflügeltes Pferd?!
#. fr: Un... cheval ailé<nbsp>!?
msgctxt "NpcYell:15475:0:13"
msgid "A winged horse...and an enormous one at that!"
msgstr ""

#. ja: 周囲は狭い…<br>立ち位置に注意するのだ！
#. de: Dieser Gang ist ziemlich schmal. Passt gut auf, wo ihr steht.
#. fr: Attention où vous mettez les pieds, c'est très étroit<nbsp>!
msgctxt "NpcYell:15476:0:13"
msgid "There isn't much room to maneuver. Have care!"
msgstr ""

#. ja: あの突進力…<br>肝を冷やしたよ…
#. de: Diese blitzschnellen Angriffe<nbsp>... Ich sah mein Ende schon gekommen.
#. fr: Quelle agressivité... J'en ai des frissons<nbsp>!
msgctxt "NpcYell:15477:0:13"
msgid "That creature was truly fearsome in motion..."
msgstr ""

#. ja: ともかく進路は開けた<br>進むとしよう
#. de: Glücklicherweise war dem nicht so. Der Weg ist frei, lasst uns voranschreiten.
#. fr: La voie est libre<nbsp>! On continue<nbsp>!
msgctxt "NpcYell:15478:0:13"
msgid "Thankfully we managed to rein it in."
msgstr ""

#. ja: なんと荘厳な…
#. de: Was für ein erhabener Ort<nbsp>...
#. fr: Ouah... C'est sublime...
msgctxt "NpcYell:15479:0:13"
msgid "Good heavens, what a majestic place..."
msgstr ""

#. ja: ここは…<br>ラタトスクの宮殿、なのか…？
#. de: Wenn mich nicht alles täuscht, dürfte dies Ratatoskrs Tempel sein.
#. fr: ... Serions-nous arrivés au palais de Ratatosk<nbsp>?
msgctxt "NpcYell:15480:0:13"
msgid "I daresay we are come to Ratatoskr's sanctuary."
msgstr ""

#. ja: 聖竜よ<br>きっとあなたのもとへ
#. de: Höre meine Worte, Hraesvelgr. Wir werden dich treffen, komme was wolle.
#. fr: Ô grand Hraesvelgr, regarde-nous bien...
msgctxt "NpcYell:15481:0:13"
msgid "We will win you over, Hraesvelgr. Mark my words."
msgstr ""

#. ja: さて…<br>何が待ち受けているのか…
#. de: Was wird uns wohl erwarten<nbsp>...?
#. fr: Nous ne sommes pas au bout de nos surprises...
msgctxt "NpcYell:15482:0:13"
msgid "What awaits, I wonder..."
msgstr ""

#. ja: イゼル、どうか私に<br>試練を超える力を…！
#. de: Ysayle, gib uns deine Kraft<nbsp>...
#. fr: Ysayle, donne-moi la force de surmonter cette épreuve<nbsp>!
msgctxt "NpcYell:15483:0:13"
msgid "Pray watch over us, Ysayle!"
msgstr ""

#. ja: 我が決意のすべて<br>ここに示そう！
#. de: Die Zeit ist gekommen, meine Ent<shy>schlos<shy>sen<shy>heit unter Beweis zu stellen!
#. fr: Ma détermination est sans faille, et je vais le prouver<nbsp>!
msgctxt "NpcYell:15484:0:13"
msgid "All that I have, I shall bring to bear!"
msgstr ""

#. ja: よし、気張っていくぞ！
#. de: Los, mit voller Kraft vorwärts!
#. fr: Rien ne peut m'arrêter<nbsp>!
msgctxt "NpcYell:15485:0:13"
msgid "Stay sharp, everyone!"
msgstr ""

#. ja: 帝国軍が相手か…
#. de: Garlear, so weit das Auge reicht<nbsp>...
#. fr: Encore des Impériaux...
msgctxt "NpcYell:15486:0:13"
msgid "Not foes to be trifled with, Garleans..."
msgstr ""

#. ja: よし、気張っていくぞ！
#. de: Los, mit voller Kraft vorwärts!
#. fr: Rien ne peut m'arrêter<nbsp>!
msgctxt "NpcYell:15487:0:13"
msgid "Stay sharp, everyone!"
msgstr ""

#. ja: 負ける訳にはいかないものね！
#. de: Diesen Kampf dürfen wir unter keinen Umständen verlieren!
#. fr: La victoire sera à nous<nbsp>!
msgctxt "NpcYell:15488:0:13"
msgid "Aye, this is one battle we can't afford to lose!"
msgstr ""

#. ja: こちらは比較的、手薄のようだ
#. de: Hier drüben sind weniger Soldaten.
#. fr: Mieux vaut passer par là<nbsp>!
msgctxt "NpcYell:15489:0:13"
msgid "Fewer guards this way."
msgstr ""

#. ja: 城壁がどこまでも<br>続いている気がするわ…
#. de: Es scheint mir, als hätte diese Mauer gar kein Ende<nbsp>...
#. fr: Ce rempart semble se prolonger à l'infini...
msgctxt "NpcYell:15490:0:13"
msgid "The wall seems to go on forever..."
msgstr ""

#. ja: こちらは比較的、手薄のようだ
#. de: Hier drüben sind weniger Soldaten.
#. fr: Mieux vaut passer par là<nbsp>!
msgctxt "NpcYell:15491:0:13"
msgid "Seems there's fewer of them this way."
msgstr ""

#. ja: このまま蹴散らすぞ！
#. de: Dann wollen wir da mal aufräumen!
#. fr: On les explose tous<nbsp>!
msgctxt "NpcYell:15492:0:13"
msgid "Let's clear them out!"
msgstr ""

#. ja: 一気に突破するぞ！
#. de: Angriff, wir brechen durch!
#. fr: Chaaaargeeeez<nbsp>!!
msgctxt "NpcYell:15493:0:13"
msgid "You're scrap metal!"
msgstr ""

#. ja: 見たことのない魔導兵器ね
#. de: So eine Magitek-Maschine habe ich noch nie gesehen<nbsp>...!
#. fr: Pas banale, cette arme magitek<nbsp>!
msgctxt "NpcYell:15494:0:13"
msgid "That's no armor I've seen before..."
msgstr ""

#. ja: 見たことのない魔導兵器ね
#. de: So eine Magitek-Maschine habe ich noch nie gesehen<nbsp>...!
#. fr: Pas banale, cette arme magitek<nbsp>!
msgctxt "NpcYell:15495:0:13"
msgid "That's no armor I've seen before..."
msgstr ""

#. ja: よ、要注意だ～！
#. de: Seid auf der Hut!
#. fr: Faites gaffe<nbsp>!!
msgctxt "NpcYell:15496:0:13"
msgid "Take care around it!"
msgstr ""

#. ja: この先は、長城内部か…
#. de: Wir sind beinahe am äußeren Wall.
#. fr: La strate extérieure est droit devant...
msgctxt "NpcYell:15497:0:13"
msgid "Right, the outer reaches are just ahead."
msgstr ""

#. ja: 慎重に進みましょう
#. de: Bleibt trotzdem vorsichtig.
#. fr: Restons prudents<nbsp>!
msgctxt "NpcYell:15498:0:13"
msgid "We must stay on our toes."
msgstr ""

#. ja: ぶっとい鉤爪だったね～
#. de: Diese Krallen hätten leicht unser Ende sein können.
#. fr: Ses grosses griffes étaient vachement pointues<nbsp>!
msgctxt "NpcYell:15499:0:13"
msgid "Those claws were no joke."
msgstr ""

#. ja: この先は、長城内部か…
#. de: Wir sind beinahe am äußeren Wall.
#. fr: La strate extérieure est droit devant...
msgctxt "NpcYell:15500:0:13"
msgid "Right, the outer reaches are just ahead."
msgstr ""

#. ja: あれは…<br>リフトの起動スイッチか？
#. de: Lässt sich mit diesem Knopf der Fahrstuhl betätigen?
#. fr: C'est le bouton pour activer l'ascenseur<nbsp>?
msgctxt "NpcYell:15501:0:13"
msgid "Is that the switch for the platform?"
msgstr ""

#. ja: これに乗れば<br>進めるようね…
#. de: Damit müssten wir vorankommen.
#. fr: J'ai beau regarder, je ne vois pas d'autre chemin...
msgctxt "NpcYell:15502:0:13"
msgid "It seems we must ride this platform."
msgstr ""

#. ja: あれは…<br>リフトの起動スイッチか？
#. de: Lässt sich mit diesem Knopf der Fahrstuhl betätigen?
#. fr: C'est le bouton pour activer l'ascenseur<nbsp>?
msgctxt "NpcYell:15503:0:13"
msgid "Is that the switch for the platform?"
msgstr ""

#. ja: よし、押してみよう～
#. de: Keine Zeit, lang zu grübeln! Drück einfach!
#. fr: Pas de temps à perdre, on appuie<nbsp>!
msgctxt "NpcYell:15504:0:13"
msgid "Only one way to find out."
msgstr ""

#. ja: これで終わりか？
#. de: Ha<nbsp>... Haben wir's geschafft?
#. fr: Ça y est<nbsp>? C'est fini<nbsp>?
msgctxt "NpcYell:15505:0:13"
msgid "Is it finally over?"
msgstr ""

#. ja: 魔導兵器の相手はもう沢山…！
#. de: Ich hab so langsam die Nase voll von all den Magitek-Maschinen!
#. fr: Trop d'armes magitek tue l'arme magitek<nbsp>!
msgctxt "NpcYell:15506:0:13"
msgid "Ugh, if I never see another magitek weapon..."
msgstr ""

#. ja: 魔導兵器の相手はもう沢山…！
#. de: Ich hab so langsam die Nase voll von all den Magitek-Maschinen!
#. fr: Trop d'armes magitek tue l'arme magitek<nbsp>!
msgctxt "NpcYell:15507:0:13"
msgid "Ugh, if I never see another magitek weapon..."
msgstr ""

#. ja: 残念、まだきそうだよ～！
#. de: Tut mir leid, dich enttäuschen zu müssen, aber da kommen noch mehr!
#. fr: Mal<shy>heu<shy>reu<shy>se<shy>ment, en voilà d'autres encore<nbsp>!
msgctxt "NpcYell:15508:0:13"
msgid "Sorry to disappoint, but I think there's more."
msgstr ""

#. ja: 手強そうな魔導兵器、発見～！
#. de: Diese hier sieht mächtig gefährlich aus.
#. fr: Arme magitek surpuissante droit devant<nbsp>!
msgctxt "NpcYell:15509:0:13"
msgid "Oh, this one's definitely dangerous."
msgstr ""

#. ja: まるで蜘蛛ね…
#. de: Sie erinnert stark an eine Spinne<nbsp>...
#. fr: On dirait une araignée...
msgctxt "NpcYell:15510:0:13"
msgid "It looks like a spider..."
msgstr ""

#. ja: 手強そうな魔導兵器、発見～！
#. de: Diese hier sieht mächtig gefährlich aus.
#. fr: Arme magitek surpuissante droit devant<nbsp>!
msgctxt "NpcYell:15511:0:13"
msgid "Oh, this one's definitely dangerous."
msgstr ""

#. ja: 攻撃を頼む！<br>癒やしは任せろ！
#. de: Kümmert ihr euch um den Angriff, ich werde eure Wunden heilen.
#. fr: Attaquez sans relâche, je me charge de vous soigner<nbsp>!
msgctxt "NpcYell:15512:0:13"
msgid "Worry not, I'll tend your wounds!"
msgstr ""

#. ja: 小さいのがワラワラ出てきたね～
#. de: Die ganzen kleinen Viecher hätte es wirklich nicht gebraucht.
#. fr: Les petits modèles étaient vraiment de trop...
msgctxt "NpcYell:15513:0:13"
msgid "I could've done without the swarm of little ones."
msgstr ""

#. ja: どうにか凌げたようね…
#. de: Gut, einer weniger<nbsp>...
#. fr: C'était moins une...
msgctxt "NpcYell:15514:0:13"
msgid "Whew, we did it..."
msgstr ""

#. ja: 小さいのがワラワラ出てきたね～
#. de: Die ganzen kleinen Viecher hätte es wirklich nicht gebraucht.
#. fr: Les petits modèles étaient vraiment de trop...
msgctxt "NpcYell:15515:0:13"
msgid "I could've done without the swarm of little ones."
msgstr ""

#. ja: 激しい攻勢だったな…
#. de: Definitiv nicht der entspannendste Kampf<nbsp>...
#. fr: Ils n'y vont pas de main morte...
msgctxt "NpcYell:15516:0:13"
msgid "Those things are relentless..."
msgstr ""

#. ja: テッペンまで<br>登ってきたのか…？
#. de: Wir sind fast ganz oben angekommen.
#. fr: On est arrivés au sommet<nbsp>?
msgctxt "NpcYell:15517:0:13"
msgid "We're almost to the top."
msgstr ""

#. ja: ずいぶんと登ってきたわね
#. de: Wir sind schon ziemlich weit oben.
#. fr: J'ai cru que l'ascenseur ne s'arrêterait jamais<nbsp>!
msgctxt "NpcYell:15518:0:13"
msgid "We've climbed a fair way."
msgstr ""

#. ja: ずいぶんと登ってきたわね
#. de: Wir sind schon ziemlich weit oben.
#. fr: J'ai cru que l'ascenseur ne s'arrêterait jamais<nbsp>!
msgctxt "NpcYell:15519:0:13"
msgid "We've climbed a fair way."
msgstr ""

#. ja: 向こう側でも戦闘が起きているな…
#. de: Auf der anderen Seite wird ebenfalls gekämpft.
#. fr: Les combats font rage de l'autre côté aussi...
msgctxt "NpcYell:15520:0:13"
msgid "There's fighting over on the other side as well."
msgstr ""

#. ja: お前ら、同盟軍ではないな！
#. de: Ihr seid nicht Teil der Allianz, oder?!
#. fr: Vous êtes pas de l'Alliance éorzéenne, vous<nbsp>!
msgctxt "NpcYell:15521:0:13"
msgid "It's the Griffin's soldiers!"
msgstr ""

#. ja: その格好で、帝国軍を騙したのか！
#. de: So haben sie also die Garlear provoziert!
#. fr: Vous avez berné les Impériaux avec ces tenues<nbsp>?
msgctxt "NpcYell:15522:0:13"
msgid "You can't fool us with those uniforms!"
msgstr ""

#. ja: お前ら、同盟軍ではないな！
#. de: Ihr seid nicht Teil der Allianz, oder?!
#. fr: Vous êtes pas de l'Alliance éorzéenne, vous<nbsp>!
msgctxt "NpcYell:15523:0:13"
msgid "It's the Griffin's soldiers!"
msgstr ""

#. ja: 鉄仮面の部隊がいるということは…
#. de: Wenn Anhänger des Greifs hier sind, dann heißt das<nbsp>...
#. fr: Les troupes du Griffon... Ça veut dire que...
msgctxt "NpcYell:15524:0:13"
msgid "If they're here, then that means..."
msgstr ""

#. ja: 鉄仮面…<br>それが、お前の素顔か！
#. de: So sieht der Greif also hinter seiner Maske aus!
#. fr: Voilà donc ton vrai visage, Griffon<nbsp>!
msgctxt "NpcYell:15525:0:13"
msgid "The Griffin finally shows his face!"
msgstr ""

#. ja: 首領であるこいつを倒せば～！
#. de: Wenn wir ihren Anführer besiegen können<nbsp>...!
#. fr: Concentrez vos attaques sur leur chef<nbsp>!
msgctxt "NpcYell:15526:0:13"
msgid "We won't let you cause any more harm!"
msgstr ""

#. ja: 鉄仮面…<br>それが、お前の素顔か！
#. de: So sieht der Greif also hinter seiner Maske aus!
#. fr: Voilà donc ton vrai visage, Griffon<nbsp>!
msgctxt "NpcYell:15527:0:13"
msgid "The Griffin finally shows his face!"
msgstr ""

#. ja: お前たちの計画は<br>ここで終わらせる！
#. de: Eure Intrigen werden hier und jetzt ihr Ende finden!
#. fr: C'en est fini de vos conspirations<nbsp>!
msgctxt "NpcYell:15528:0:13"
msgid "Your scheming ends here, you bastard!"
msgstr ""

#. ja: 魔力の道…<br>緻密な術式のようね
#. de: Wege aus reiner Magie<nbsp>... fürwahr ein beeindruckender Zauber.
#. fr: Un chemin d'énergie magique... Comme c'est beau<nbsp>!
msgctxt "NpcYell:15529:0:13"
msgid "An aetherial path... No simple thing to create."
msgstr ""

#. ja: …よし、行くぞ
#. de: Also dann, auf geht's.
#. fr: En route<nbsp>!
msgctxt "NpcYell:15530:0:13"
msgid "...Let's keep moving."
msgstr ""

#. ja: 地底に向けて、塔が…！
#. de: Seht nur, der Turm<nbsp>...! Er steht Kopf!
#. fr: Cette tour inversée... Quel spectacle<nbsp>!
msgctxt "NpcYell:15531:0:13"
msgid "By the Twelve, it's literally upside down!"
msgstr ""

#. ja: なんて濃いエーテル…<br>輝いて見えるわ
#. de: Der Äther is so hoch konzentriert, ich sehe fast nur Licht<nbsp>...
#. fr: L'éther est tellement épais qu'il en devient aveuglant...
msgctxt "NpcYell:15532:0:13"
msgid "The aether is so dense as to be blinding."
msgstr ""

#. ja: 巨大なポロッゴ…<br>なのか？
#. de: Ist das<nbsp>... ein riesiger Poroggo?
#. fr: Un poroggo géant<nbsp>!
msgctxt "NpcYell:15533:0:13"
msgid "Good gods, what an enormous poroggo!"
msgstr ""

#. ja: 大食いなのか<br>不摂生の結果なのか…
#. de: Was viel Essen und wenig Bewegung alles anrichten können, hm?
#. fr: Il devrait faire plus attention à ce qu'il mange...
msgctxt "NpcYell:15534:0:13"
msgid "They must provide excellent board here."
msgstr ""

#. ja: やれやれ…<br>あの歌は二度と聞きたくないよ
#. de: Ich hoffe zutiefst, nie mehr diese Melodie vernehmen zu müssen<nbsp>...
#. fr: J'espère ne plus jamais avoir à écouter un tel chant<nbsp>!
msgctxt "NpcYell:15535:0:13"
msgid "I pray I never hear that song again..."
msgstr ""

#. ja: さあ、エーテルの渦に<br>飛び込むぞ！
#. de: Zeit, in den Äther zu springen!
#. fr: Tous ensemble dans le tourbillon d'éther<nbsp>!
msgctxt "NpcYell:15536:0:13"
msgid "Right, into the aether we go."
msgstr ""

#. ja: ここが、星の海か？
#. de: Das hier ist also der Sternengrund?
#. fr: La mer... des étoiles<nbsp>?
msgctxt "NpcYell:15537:0:13"
msgid "Is this it, then? The aetherial sea?"
msgstr ""

#. ja: その浅瀬といったところかしら
#. de: Die Küste des Sternengrunds, um genau zu sein.
#. fr: Et ce n'est qu'un échantillon...
msgctxt "NpcYell:15538:0:13"
msgid "This is the shore, you might say."
msgstr ""

#. ja: また、扉からホムンクルスを！
#. de: Noch mehr Homunkuli!
#. fr: Encore des homoncules<nbsp>!
msgctxt "NpcYell:15539:0:13"
msgid "More homunculi!"
msgstr ""

#. ja: すべて切り裂く…！
#. de: Die werden uns auch nicht länger aufhalten als ihre Vorgänger.
#. fr: Ils vont subir le même sort que les précédents<nbsp>!
msgctxt "NpcYell:15540:0:13"
msgid "We'll deal with them like the rest."
msgstr ""

#. ja: 何故、スプリガンが…
#. de: Wieso in aller Welt sind hier Spriggans<nbsp>...?
#. fr: Mais qu'est-ce qu'un spriggan fait ici<nbsp>!?
msgctxt "NpcYell:15541:0:13"
msgid "All these spriggans here..."
msgstr ""

#. ja: 魔石に惹かれて<br>入り込んだのかしら
#. de: Vermutlich wurden sie von dem Zauberstein angelockt<nbsp>...
#. fr: Il a pro<shy>ba<shy>ble<shy>ment été attiré par les magilithes...
msgctxt "NpcYell:15542:0:13"
msgid "I imagine they were drawn to the crystals."
msgstr ""

#. ja: 見かけ以上の<br>強敵だったね…
#. de: Ich gestehe, einen derart anstregenden Kampf hatte ich nicht erwartet<nbsp>...
#. fr: Je ne l'aurais pas cru aussi coriace...
msgctxt "NpcYell:15543:0:13"
msgid "That was tougher than I expected..."
msgstr ""

#. ja: さあ、最下層に降りましょう
#. de: Kommt, wir sind beinahe im tiefsten Bereich.
#. fr: Le niveau inférieur ne devrait plus être loin<nbsp>!
msgctxt "NpcYell:15544:0:13"
msgid "Come, the lowest level awaits."
msgstr ""

#. ja: ロウソクの火すら逆さに…
#. de: Selbst die Kerzen brennen kopfüber<nbsp>...
#. fr: Même le feu des bougies brûle à l'envers...
msgctxt "NpcYell:15545:0:13"
msgid "Even the candles burn upside down..."
msgstr ""

#. ja: 無駄に細部にこだわるのは<br>シャーレアン人の悪癖ね
#. de: Sich über unbedeutsame Kleinigkeiten Gedanken zu machen<nbsp>... Du bist eindeutig aus Sharlayan.
#. fr: C'est bien une réflexion pointilleuse de Sharlayanais, ça<nbsp>!
msgctxt "NpcYell:15546:0:13"
msgid "How very Sharlayan to obsess over useless details."
msgstr ""

#. ja: 最奥部を守る仕掛けか
#. de: Schutzmechanismen für die tiefsten Bereiche, hm?
#. fr: Dernier obstacle avant la ligne d'arrivée, on dirait...
msgctxt "NpcYell:15547:0:13"
msgid "Defenses for the innermost sector, eh?"
msgstr ""

#. ja: まったく油断ならないね…！
#. de: Man kann sich hier wirklich keinen Moment ausruhen<nbsp>...
#. fr: Surtout, ne pas jouer les têtes brûlées...
msgctxt "NpcYell:15548:0:13"
msgid "Can't lower our guard even for a moment!"
msgstr ""

#. ja: あの魔法人形が<br>この展望室の守護者…？
#. de: Sind diese Puppen etwa die Wächter dieses Orts<nbsp>...?
#. fr: Ces pantins... Ce sont les gardiens de l'Antitour<nbsp>!
msgctxt "NpcYell:15549:0:13"
msgid "Those dolls are the guardians of the viewing chamber?"
msgstr ""

#. ja: 注意して…<br>かなりの魔力量よ！
#. de: Bleibt auf der Hut! Die Menge an magischer Kraft in ihnen ist gewaltig!
#. fr: Restez sur vos gardes, leur énergie magique est immense<nbsp>!
msgctxt "NpcYell:15550:0:13"
msgid "Have care─I sense tremendous power from them!"
msgstr ""

#. ja: はあ…はあっ…
#. de: Haa, haa<nbsp>... 
#. fr: (halète)
msgctxt "NpcYell:15551:0:13"
msgid "\\<pant> \\<pant>"
msgstr ""

#. ja: 火照ってきましたぞ！
#. de: Diese alten Gliedmaßen werden gerade erst warm!
#. fr: Ho hooo, mes muscles sont en feu<nbsp>!
msgctxt "NpcYell:15552:0:13"
msgid "These old limbs are limbered up!"
msgstr ""

#. ja: ハッハッハ！<br>追いかけっこですな！
#. de: Ohoho!<br>Lauf weiter, Sohn!
#. fr: Ha ha ha<nbsp>! Quel pas de course, mon Hildoudou<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15553:0:13"
msgid "Ohoho!<br>Keep running, son!"
msgstr ""

#. ja: 盛り上がってきましたぞ！
#. de: Das ist schon besser!
#. fr: Passons aux choses sérieuses<nbsp>!
msgctxt "NpcYell:15554:0:13"
msgid "This is more like it!"
msgstr ""

#. ja: お次は何ですかな？
#. de: Und dein nächster Trick?
#. fr: J'attends la suite, Gélule<nbsp>!
msgctxt "NpcYell:15555:0:13"
msgid "And for your next trick?"
msgstr ""

#. ja: こんな奇妙な場所…<br>見たことがない
#. de: Dieser Ort wird mit jedem Schritt seltsamer.
#. fr: J'ai jamais vu un endroit pareil...
msgctxt "NpcYell:15556:0:13"
msgid "This place just keeps getting weirder..."
msgstr ""

#. ja: ヤケにあちこち光ってるな
#. de: Alles leuchtet!
#. fr: Ça scintille de partout<nbsp>!
msgctxt "NpcYell:15557:0:13"
msgid "Just about everything is lit up in here."
msgstr ""

#. ja: こんな奇妙な場所…<br>見たことがない
#. de: Dieser Ort wird mit jedem Schritt seltsamer.
#. fr: J'ai jamais vu un endroit pareil...
msgctxt "NpcYell:15558:0:13"
msgid "This place just keeps getting weirder..."
msgstr ""

#. ja: 異様な雰囲気だね～
#. de: Ordentlich schaurig, wenn du mich fragst.
#. fr: Tu m'enlèves les mots de la bouche...
msgctxt "NpcYell:15559:0:13"
msgid "Aye, it's downright uncanny here."
msgstr ""

#. ja: 急に敵が出てきたよ～！
#. de: Vorsicht!
#. fr: Attention, on nous attaque<nbsp>!
msgctxt "NpcYell:15560:0:13"
msgid "Watch out!"
msgstr ""

#. ja: 守護者の類か！？
#. de: Wächter?!
#. fr: Des sentinelles<nbsp>!?
msgctxt "NpcYell:15561:0:13"
msgid "Sentinels!?"
msgstr ""

#. ja: 守護者の類か！？
#. de: Wächter?!
#. fr: Des sentinelles<nbsp>!?
msgctxt "NpcYell:15562:0:13"
msgid "Sentinels!?"
msgstr ""

#. ja: なんて高度な技術なの…
#. de: Unglaubliche Technologie<nbsp>...
#. fr: Quelle technologie incroyable...
msgctxt "NpcYell:15563:0:13"
msgid "Such incredible technology..."
msgstr ""

#. ja: 帝国の軍団長が相手か！
#. de: Ein Legatus des Kaiserreiches!
#. fr: Un général de l'Empire<nbsp>!!
msgctxt "NpcYell:15564:0:13"
msgid "If it isn't an imperial legatus!"
msgstr ""

#. ja: もう、しつこ～い～！
#. de: Nicht schon wieder!
#. fr: Oh non, encore<nbsp>!?
msgctxt "NpcYell:15565:0:13"
msgid "Hmph, not again!"
msgstr ""

#. ja: 帝国の軍団長が相手か！
#. de: Ein Legatus des Kaiserreiches!
#. fr: Un général de l'Empire<nbsp>!!
msgctxt "NpcYell:15566:0:13"
msgid "If it isn't an imperial legatus!"
msgstr ""

#. ja: 相手はひとり…<br>突破するまでよ！
#. de: Damit werden wir schon fertig.
#. fr: Il va regretter de nous avoir affrontés seul<nbsp>!
msgctxt "NpcYell:15567:0:13"
msgid "Nothing we can't handle!"
msgstr ""

#. ja: あっさり退いたわね
#. de: War das alles?
#. fr: C'était presque trop facile...
msgctxt "NpcYell:15568:0:13"
msgid "Is that all?"
msgstr ""

#. ja: 見事な引き際だな…
#. de: Zumindest weiß er, wann Schluss ist.
#. fr: Il a vite compris qu'il n'était pas de taille<nbsp>!
msgctxt "NpcYell:15569:0:13"
msgid "At least he knows when to quit."
msgstr ""

#. ja: あっさり退いたわね
#. de: War das alles?
#. fr: C'était presque trop facile...
msgctxt "NpcYell:15570:0:13"
msgid "Is that all?"
msgstr ""

#. ja: 僕らを倒すことが<br>目的じゃないんだろうね～
#. de: Scheinbar war er nicht auf uns aus.
#. fr: Son but n'était peut-être pas de nous éliminer...
msgctxt "NpcYell:15571:0:13"
msgid "It seems he wasn't here for us."
msgstr ""

#. ja: 中央の球体はなんだ？
#. de: Was ist denn das für eine Sphäre?
#. fr: C'est quoi, cette sphère<nbsp>?
msgctxt "NpcYell:15572:0:13"
msgid "What the hells is that sphere?"
msgstr ""

#. ja: 周囲の筒は水槽…<br>いや、檻なのか？
#. de: Diese Behältnisse gefallen mir gar nicht.
#. fr: Je me demande ce qu'il y a dans ces réservoirs...
msgctxt "NpcYell:15573:0:13"
msgid "I don't like the looks of those tanks..."
msgstr ""

#. ja: 周囲の筒は水槽…<br>いや、檻なのか？
#. de: Was wohl in diesen Behältnissen ist?
#. fr: Je me demande ce qu'il y a dans ces réservoirs...
msgctxt "NpcYell:15574:0:13"
msgid "What do you suppose are in those tanks?"
msgstr ""

#. ja: 中は見えないね～
#. de: Ungeheuer. Ganz sicher Ungeheuer.
#. fr: Je préfère ne pas savoir<nbsp>!
msgctxt "NpcYell:15575:0:13"
msgid "Monstrosities─definitely monstrosities."
msgstr ""

#. ja: また中から化け物が！
#. de: Auf ein Neues.
#. fr: Et c'est reparti<nbsp>!
msgctxt "NpcYell:15576:0:13"
msgid "Here we go again."
msgstr ""

#. ja: 敵は無尽蔵とでもいうのか…！
#. de: Bitte nicht noch mehr <nbsp>...
#. fr: Leurs effectifs sont infinis ou quoi<nbsp>!?
msgctxt "NpcYell:15577:0:13"
msgid "Ugh, not more abominations..."
msgstr ""

#. ja: また中から化け物が！
#. de: Auf ein Neues.
#. fr: Et c'est reparti<nbsp>!
msgctxt "NpcYell:15578:0:13"
msgid "Here we go again."
msgstr ""

#. ja: 全方位、注意だ～！
#. de: Gebt aufeinander Acht!
#. fr: On se couvre mu<shy>tuel<shy>le<shy>ment<nbsp>!
msgctxt "NpcYell:15579:0:13"
msgid "Watch each other's backs!"
msgstr ""

#. ja: 妙な見た目の敵だね～
#. de: Was für ein seltsames Ding<nbsp>...
#. fr: Quelle... chose étrange...
msgctxt "NpcYell:15580:0:13"
msgid "What a strange-looking...I'm going to go with “thing.”"
msgstr ""

#. ja: 生体兵器の試験場…
#. de: Eine Art Testgelände<nbsp>...
#. fr: Je crois bien qu'on nous prend pour des cobayes...
msgctxt "NpcYell:15581:0:13"
msgid "Some manner of testing ground..."
msgstr ""

#. ja: 生体兵器の試験場…
#. de: Eine Art Testgelände<nbsp>...
#. fr: Je crois bien qu'on nous prend pour des cobayes...
msgctxt "NpcYell:15582:0:13"
msgid "Some manner of testing ground..."
msgstr ""

#. ja: 外見どおりの敵じゃ<br>なさそうだな！
#. de: Was auch immer es ist, der Schein mag trügen!
#. fr: Peu importe ce que c'est, faites attention à vous<nbsp>!
msgctxt "NpcYell:15583:0:13"
msgid "Whatever that thing is, it isn't what it seems!"
msgstr ""

#. ja: 得体の知れない敵だったな
#. de: So etwas ist mir ja noch nie untergekommen.
#. fr: Bon, oublions vite ce... truc...
msgctxt "NpcYell:15584:0:13"
msgid "Never fought anything like that before."
msgstr ""

#. ja: 変身してくるなんてね～
#. de: Ganz schön gewitzt, diese Ver<shy>wand<shy>lung.
#. fr: Il était doué pour se transformer, en tout cas...
msgctxt "NpcYell:15585:0:13"
msgid "Clever how it transforms."
msgstr ""

#. ja: 変身してくるなんてね～
#. de: Ganz schön gewitzt, diese Ver<shy>wand<shy>lung.
#. fr: Il était doué pour se transformer, en tout cas...
msgctxt "NpcYell:15586:0:13"
msgid "Clever how it transforms."
msgstr ""

#. ja: 様々な試験を行うためか
#. de: Zumindest eine effiziente Testmethode.
#. fr: Probablement afin de mener toutes sortes de tests...
msgctxt "NpcYell:15587:0:13"
msgid "Certainly an efficient way to test creations..."
msgstr ""

#. ja: あの機械で操作するのか
#. de: Es geht abwärts.
#. fr: Il devrait y avoir un bouton quelque part...
msgctxt "NpcYell:15588:0:13"
msgid "Looks like we're heading down."
msgstr ""

#. ja: どこに続いてるんだろ～…
#. de: Ich frage mich, wo wir herauskommen werden.
#. fr: Où est-ce qu'on va se retrouver, maintenant<nbsp>?
msgctxt "NpcYell:15589:0:13"
msgid "Wonder where this will take us."
msgstr ""

#. ja: あの機械で操作するのか
#. de: Es geht abwärts.
#. fr: Il devrait y avoir un bouton quelque part...
msgctxt "NpcYell:15590:0:13"
msgid "Looks like we're heading down."
msgstr ""

#. ja: 階下にも研究施設があるのね
#. de: Wie groß kann diese Einrichtung denn sein?
#. fr: Il y a autre chose que des laboratoires ici<nbsp>?
msgctxt "NpcYell:15591:0:13"
msgid "How vast could this facility possibly be?"
msgstr ""

#. ja: 侵入者ってバレたみたい～！
#. de: Jedes Mal, wenn man Aufzug fährt<nbsp>...
#. fr: Oups<nbsp>! Je crois qu'on est repérés<nbsp>!
msgctxt "NpcYell:15592:0:13"
msgid "I swear, every time you ride a lift..."
msgstr ""

#. ja: 迎撃して、また動かすわよ！
#. de: Man hat uns entdeckt!
#. fr: On s'en débarrasse et on continue, comme d'habitude<nbsp>!
msgctxt "NpcYell:15593:0:13"
msgid "We've been found!"
msgstr ""

#. ja: 侵入者ってバレたみたい～！
#. de: Jedes Mal, wenn man Aufzug fährt<nbsp>...
#. fr: Oups<nbsp>! Je crois qu'on est repérés<nbsp>!
msgctxt "NpcYell:15594:0:13"
msgid "I swear, every time you ride a lift..."
msgstr ""

#. ja: ったく、優秀なカラクリだぜ！
#. de: Oder?! Meine Güte.
#. fr: Elle commence à me gonfler, cette technologie avancée<nbsp>!
msgctxt "NpcYell:15595:0:13"
msgid "I know, right!?"
msgstr ""

#. ja: 大きな玉っころが見える～
#. de: Diese riesige Sphäre schreit ja geradezu „Ich bin böse“.
#. fr: En voilà une sphère qu'elle est grosse<nbsp>!
msgctxt "NpcYell:15596:0:13"
msgid "Oh, that enormous sphere just screams “evil.”"
msgstr ""

#. ja: あの光ってる場所はなんだ？
#. de: Und was ist dieser leuchtende Ort?
#. fr: Je me demande d'où provient toute cette lumière...
msgctxt "NpcYell:15597:0:13"
msgid "What could that illuminated place be?"
msgstr ""

#. ja: あの光ってる場所はなんだ？
#. de: Und was ist dieser leuchtende Ort?
#. fr: Je me demande d'où provient toute cette lumière...
msgctxt "NpcYell:15598:0:13"
msgid "What could that illuminated place be?"
msgstr ""

#. ja: 魔科学の真髄が<br>眠る場所かしらね…
#. de: Das schlagende Herz der Ätherochemie, vermutlich?
#. fr: De la source de la magismologie, sans doute...
msgctxt "NpcYell:15599:0:13"
msgid "The beating heart of aetherochemistry, perhaps..."
msgstr ""

#. ja: ここが決戦の舞台ね
#. de: Und hier endet unser Weg.
#. fr: Notre route s'arrête ici, on dirait...
msgctxt "NpcYell:15600:0:13"
msgid "Here is where the path ends, it seems."
msgstr ""

#. ja: さあ、いよいよ最奥部だ…
#. de: Tiefer geht es wohl nicht mehr hinab.
#. fr: Difficile d'aller plus loin...
msgctxt "NpcYell:15601:0:13"
msgid "Looks like this is as deep as it goes."
msgstr ""

#. ja: さあ、いよいよ最奥部だ…
#. de: Tiefer geht es wohl nicht mehr hinab.
#. fr: Difficile d'aller plus loin...
msgctxt "NpcYell:15602:0:13"
msgid "Looks like this is as deep as it goes."
msgstr ""

#. ja: 教皇もいるのか…？
#. de: Der Papst wird nicht weit sein.
#. fr: L'Archevêque ne devrait pas tarder à se montrer<nbsp>!
msgctxt "NpcYell:15603:0:13"
msgid "The archbishop must be close."
msgstr ""

#. ja: ここまでだ、アシエン！
#. de: Es ist aus, Ascians!
#. fr: Vous feriez mieux d'abandonner, Asciens<nbsp>!
msgctxt "NpcYell:15604:0:13"
msgid "It's over, Ascians!"
msgstr ""

#. ja: この世界を、好きにはさせない！
#. de: Wir werden euch nicht gewähren lassen!
#. fr: Nous ne vous laisserons pas nous contrôler<nbsp>!
msgctxt "NpcYell:15605:0:13"
msgid "We won't let you do as you please!"
msgstr ""

#. ja: ここまでだ、アシエン！
#. de: Es ist aus, Ascians!
#. fr: Vous feriez mieux d'abandonner, Asciens<nbsp>!
msgctxt "NpcYell:15606:0:13"
msgid "It's over, Ascians!"
msgstr ""

#. ja: 人の意地を見せてやる！
#. de: Unterschätzt uns nur! Wir werden es euch zeigen!
#. fr: Vous nous avez sous-estimés... Erreur fatale<nbsp>!
msgctxt "NpcYell:15607:0:13"
msgid "We'll teach you to underestimate us!"
msgstr ""

#. ja: 煩わしい…
#. de: Wie lästig<nbsp>...
#. fr: Quelle plaie...
msgctxt "NpcYell:15608:0:13"
msgid "How bothersome..."
msgstr ""

#. ja: 甲板で待ち構えて<br>正解だったな
#. de: Gut, dass wir auf dem Deck Ausschau gehalten haben.
#. fr: On a bien fait de rester sur le toit.
msgctxt "NpcYell:15609:0:13"
msgid "It seems we were right to ride atop the snowcraft."
msgstr ""

#. ja: さっそく現れたわね…
#. de: Das war plötzlich.
#. fr: Ça n'aura pas tardé.
msgctxt "NpcYell:15610:0:13"
msgid "To arms!"
msgstr ""

#. ja: こんなに大きな雪上車を<br>襲ってくるなんて…
#. de: Dass sie so ein großes Schneemobil angreifen<nbsp>...
#. fr: Je pensais que l'autoneige les effraierait...
msgctxt "NpcYell:15611:0:13"
msgid "The wildlife here is certainly bold."
msgstr ""

#. ja: 甲板で待ち構えて<br>正解だったな
#. de: Gut, dass wir auf dem Deck Ausschau gehalten haben.
#. fr: On a bien fait de rester sur le toit.
msgctxt "NpcYell:15612:0:13"
msgid "It seems we were right to ride atop the snowcraft."
msgstr ""

#. ja: 仕掛けてくるなら<br>手加減はしなくてよ
#. de: Kommt nur her, wenn ihr eine Abreibung wollt.
#. fr: Les pauvres, ils vont y laisser des plumes.
msgctxt "NpcYell:15613:0:13"
msgid "Indeed. Let us hold nothing back."
msgstr ""

#. ja: どこまでも白い…<br>見慣れぬ景色だ
#. de: Weiß, so weit das Auge reicht.<br>Wirklich eine bizarre Landschaft.
#. fr: Je n'avais jamais vu un paysage aussi blanc de ma vie.
msgctxt "NpcYell:15614:0:13"
msgid "White as far as the eye can see..."
msgstr ""

#. ja: ずいぶん登ってきたな
#. de: Wir haben gut an Höhe gewonnen.
#. fr: Ça grimpe sec.
msgctxt "NpcYell:15615:0:13"
msgid "A welcome change of scenery."
msgstr ""

#. ja: よく見渡せるわね
#. de: Gute Aussicht, was?
#. fr: On a une belle vue d'ici.
msgctxt "NpcYell:15616:0:13"
msgid "I imagine the view from here must be breathtaking."
msgstr ""

#. ja: バブイルの塔が見えるわ！
#. de: Ich kann den Turm von Babil sehen!
#. fr: Oh, je vois la tour de Babil<nbsp>!
msgctxt "NpcYell:15617:0:13"
msgid "You can see the Tower of Babil from here!"
msgstr ""

#. ja: バブイルの塔が見えるわ！
#. de: Ich kann den Turm von Babil sehen!
#. fr: Oh, je vois la tour de Babil<nbsp>!
msgctxt "NpcYell:15618:0:13"
msgid "You can see the Tower of Babil from here!"
msgstr ""

#. ja: 遠くからでも<br>存在感があるね…
#. de: Man spürt seine Präsenz auch aus dieser Entfernung.
#. fr: Elle en impose, même de loin...
msgctxt "NpcYell:15619:0:13"
msgid "And it's no less imposing, even from this great distance."
msgstr ""

#. ja: 行く手を阻むというなら<br>倒させてもらう！
#. de: Wer sich mir in den Weg stellt, wird beseitigt!
#. fr: Ce n'est pas une bête qui nous empêchera de passer<nbsp>!
msgctxt "NpcYell:15620:0:13"
msgid "If this beast would bar our path..."
msgstr ""

#. ja: この地の<br>原生生物かしら？
#. de: Lebt diese Kreatur hier?
#. fr: C'est une sorte d'animal primitif<nbsp>?
msgctxt "NpcYell:15621:0:13"
msgid "Is this beast native to the mountain?"
msgstr ""

#. ja: 山のヌシのようだね
#. de: Was für ein Riese<nbsp>... Zweifelsohne der Wächter dieses Berges.
#. fr: C'est le gardien de cette montagne, je crois.
msgctxt "NpcYell:15622:0:13"
msgid "A veritable giant among the wildlife here to be sure."
msgstr ""

#. ja: 行く手を阻むというなら<br>倒させてもらう！
#. de: Wer sich mir in den Weg stellt, wird beseitigt!
#. fr: Ce n'est pas une bête qui nous empêchera de passer<nbsp>!
msgctxt "NpcYell:15623:0:13"
msgid "If this beast would bar our path..."
msgstr ""

#. ja: フン、容易いことだ
#. de: Hm, das wird einfach.
#. fr: Ce sera vite réglé.
msgctxt "NpcYell:15624:0:13"
msgid "A simple enough task."
msgstr ""

#. ja: さあ、先へ進もう！
#. de: Weiter!
#. fr: Allez, continuons de grimper<nbsp>!
msgctxt "NpcYell:15625:0:13"
msgid "Come. Let us press onward."
msgstr ""

#. ja: 他愛もないわね
#. de: Das war nichts Besonderes.
#. fr: C'était un jeu d'enfant.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:15626:0:13"
msgid "Well, that wasn't <i>too</i> difficult."
msgstr ""

#. ja: 野生生物の力は<br>凄まじいものがあるね
#. de: Erstaunlich, welche Kräfte die Tierwelt hervorbringt.
#. fr: La nature ne cessera jamais de m'étonner...
msgctxt "NpcYell:15627:0:13"
msgid "There is something to be said for the fortitude of nature."
msgstr ""

#. ja: さあ、先へ進もう！
#. de: Weiter!
#. fr: Allez, continuons de grimper<nbsp>!
msgctxt "NpcYell:15628:0:13"
msgid "Come. Let us press onward."
msgstr ""

#. ja: いよいよ洞窟ね…！
#. de: Endlich, die Höhle.
#. fr: Là-bas<nbsp>! C'est la grotte qu'on cherche<nbsp>!
msgctxt "NpcYell:15629:0:13"
msgid "To the cavern!"
msgstr ""

#. ja: だいぶ奥まで<br>続いていそうだな
#. de: Es sieht so aus, als würde der Weg weiter ins Innere führen.
#. fr: La grotte s'étend en profondeur...
msgctxt "NpcYell:15630:0:13"
msgid "How vast is this cavern, I wonder?"
msgstr ""

#. ja: この気配は…
#. de: Ich habe ein ungutes Gefühl.
#. fr: Cette aura...
msgctxt "NpcYell:15631:0:13"
msgid "What is this presence...?"
msgstr ""

#. ja: 風が凌げるぶん<br>少し暖かく感じるわ
#. de: Der Wind lässt nach. Mir wird schon wärmer.
#. fr: Au moins, il fait un peu plus chaud ici que dehors.
msgctxt "NpcYell:15632:0:13"
msgid "Is it just me, or is the wind blowing warm air?"
msgstr ""

#. ja: この洞窟が<br>ラピス・マナリス…
#. de: Diese Höhle ist also Lapis Manalis<nbsp>...
#. fr: Voilà donc à quoi ressemble Lapis Manalis.
msgctxt "NpcYell:15633:0:13"
msgid "So this is Lapis Manalis..."
msgstr ""

#. ja: この洞窟が<br>ラピス・マナリス…
#. de: Diese Höhle ist also Lapis Manalis<nbsp>...
#. fr: Voilà donc à quoi ressemble Lapis Manalis.
msgctxt "NpcYell:15634:0:13"
msgid "So this is Lapis Manalis..."
msgstr ""

#. ja: 足場が悪い<br>転ぶなよ、アルフィノ
#. de: Pass auf, dass du nicht fällst, Alphinaud.
#. fr: Regarde où tu mets les pieds, Alphinaud.
msgctxt "NpcYell:15635:0:13"
msgid "This is no time for gawping. Watch your step."
msgstr ""

#. ja: 妖異の気配が<br>染みついているな
#. de: Ich spüre den Einfluss der Nichts<shy>gesand<shy>ten.
#. fr: Je sens la présence de créatures du néant.
msgctxt "NpcYell:15636:0:13"
msgid "The presence of voidsent permeates this place..."
msgstr ""

#. ja: 廃村のようだが…
#. de: Wie erwartet, ein verlassenes Dorf.
#. fr: Des maisons en ruine...
msgctxt "NpcYell:15637:0:13"
msgid "The reaper village. Or what remains of it..."
msgstr ""

#. ja: なかなか異様な場所ね
#. de: Das ist ein sehr seltsamer Ort.
#. fr: Drôle de lieu.
msgctxt "NpcYell:15638:0:13"
msgid "A most curious place indeed."
msgstr ""

#. ja: ここがユルスの言っていた<br>放棄された里ね？
#. de: Das ist das verlassene Dorf, von dem Jullus gesprochen hat, richtig?
#. fr: C'est le village dont Jullus nous a parlé<nbsp>?
msgctxt "NpcYell:15639:0:13"
msgid "Is this the village Jullus told us about?"
msgstr ""

#. ja: 妖異の気配が<br>染みついているな
#. de: Ich spüre den Einfluss der Nichts<shy>gesand<shy>ten.
#. fr: Je sens la présence de créatures du néant.
msgctxt "NpcYell:15640:0:13"
msgid "The presence of voidsent permeates this place..."
msgstr ""

#. ja: かつてあなたを縛った術も<br>ここで培われたもの…
#. de: Hier wurde also deine Technik entwickelt<nbsp>...
#. fr: Ceux qui pactisaient avec les tiens vivaient ici.
msgctxt "NpcYell:15641:0:13"
msgid "I would expect no less from the birthplace of the reaper's art."
msgstr ""

#. ja: こんなところに<br>魔法人形が…！？
#. de: Eine Marionette? Hier?
#. fr: Une marionnette magique, ici<nbsp>?
msgctxt "NpcYell:15642:0:13"
msgid "Magicked puppets? Here?"
msgstr ""

#. ja: 人形が出迎えとはな
#. de: So eine Begrüßung habe ich nicht erwartet.
#. fr: Si on m'avait dit que je me battrais contre un pantin...
msgctxt "NpcYell:15643:0:13"
msgid "Voidsent, I expected. But puppets...?"
msgstr ""

#. ja: あら、可愛いじゃない
#. de: Sind die Püppchen nicht niedlich?
#. fr: Oh. Elle est jolie, la mignonnette.
msgctxt "NpcYell:15644:0:13"
msgid "Despite their menacing demeanor, they're quite charming."
msgstr ""

#. ja: なんとも言えない<br>雰囲気の人形だ…
#. de: Diese Marionette hat eine un<shy>beschreib<shy>liche Ausstrahlung.
#. fr: Dans le genre sinistre, on peut dif<shy>fi<shy>ci<shy>le<shy>ment trouver mieux.
msgctxt "NpcYell:15645:0:13"
msgid "What possessed them to create such automata?"
msgstr ""

#. ja: こんなところに<br>魔法人形が…！？
#. de: Eine Marionette? Hier?
#. fr: Une marionnette magique, ici<nbsp>?
msgctxt "NpcYell:15646:0:13"
msgid "Magicked puppets? Here?"
msgstr ""

#. ja: 戦闘訓練用…<br>といったところかしら？
#. de: Dient sie vielleicht für Übungskämpfe?
#. fr: C'est une sorte de mannequin d'en<shy>traî<shy>ne<shy>ment<nbsp>?
msgctxt "NpcYell:15647:0:13"
msgid "And equipped for combat training. How delightful..."
msgstr ""

#. ja: すまないが<br>先を急ぐんだ
#. de: Wir müssen weiter.
#. fr: Assez perdu de temps comme ça, allons-y.
msgctxt "NpcYell:15648:0:13"
msgid "Come, let us make haste."
msgstr ""

#. ja: どこか<br>妖異じみた人形だったな
#. de: Die Marionette stellt einen Nichts<shy>gesand<shy>ten dar, kein Zweifel.
#. fr: On aurait presque dit une créature du néant.
msgctxt "NpcYell:15649:0:13"
msgid "That doll was not unlike a voidsent..."
msgstr ""

#. ja: 鍛錬にちょうどいい
#. de: Genau richtig für einen Übungskampf.
#. fr: Un peu d'en<shy>traî<shy>ne<shy>ment, ça ne fait jamais de mal.
msgctxt "NpcYell:15650:0:13"
msgid "At the very least, it made for good sport."
msgstr ""

#. ja: 良い出来の魔法人形<br>だったわね
#. de: Die Marionette war gut gemacht.
#. fr: Cette finesse dans sa confection... C'est du grand art.
msgctxt "NpcYell:15651:0:13"
msgid "A masterfully crafted doll."
msgstr ""

#. ja: なかなかに<br>手強かったわね…
#. de: Ein starker Gegner.
#. fr: Eh bien, elle nous a donné du fil à retordre.
msgctxt "NpcYell:15652:0:13"
msgid "That certainly was a challenge."
msgstr ""

#. ja: どこか<br>妖異じみた人形だったな
#. de: Die Marionette stellt einen Nichts<shy>gesand<shy>ten dar, kein Zweifel.
#. fr: On aurait presque dit une créature du néant.
msgctxt "NpcYell:15653:0:13"
msgid "That doll was not unlike a voidsent..."
msgstr ""

#. ja: さっさと奥に進みましょう
#. de: Gehen wir weiter ins Innere.
#. fr: Allons voir ce qu'il y a au fond.
msgctxt "NpcYell:15654:0:13"
msgid "We can muse about that later. Let's get going."
msgstr ""

#. ja: チッ…
#. de: Pah ...
#. fr: Ugh.
msgctxt "NpcYell:15655:0:13"
msgid "Ugh..."
msgstr ""

#. ja: まさか崩落するとはな
#. de: Wer hätte einen so plötzlichen Einsturz erwartet?
#. fr: C'est ce qui s'appelle prendre un gadin.
msgctxt "NpcYell:15656:0:13"
msgid "That was quite a fall."
msgstr ""

#. ja: この先は<br>慎重に進みましょう
#. de: Seien wir vorsichtig.
#. fr: Avançons prudemment.
msgctxt "NpcYell:15657:0:13"
msgid "Let us proceed with caution."
msgstr ""

#. ja: お、驚いたわ…
#. de: Puh, das war ein Schreck.
#. fr: J'ai cru que mon cœur allait lâcher<nbsp>!
msgctxt "NpcYell:15658:0:13"
msgid "Gods, that startled me."
msgstr ""

#. ja: 怪我はなかったかい？
#. de: Bist du auch nicht verletzt?
#. fr: Personne n'est blessé<nbsp>?
msgctxt "NpcYell:15659:0:13"
msgid "Is everyone all right?"
msgstr ""

#. ja: まさか崩落するとはな
#. de: Wer hätte einen so plötzlichen Einsturz erwartet?
#. fr: C'est ce qui s'appelle prendre un gadin.
msgctxt "NpcYell:15660:0:13"
msgid "That was quite a fall."
msgstr ""

#. ja: ひどい目にあったわね
#. de: Das war knapp.
#. fr: On a eu chaud...
msgctxt "NpcYell:15661:0:13"
msgid "Thankfully we emerged unscathed."
msgstr ""

#. ja: 姉さん！<br>近くにいるのか！？
#. de: Schwester! Bist du in der Nähe?
#. fr: Azdaja<nbsp>! Tu es là<nbsp>!?
msgctxt "NpcYell:15662:0:13"
msgid "Azdaja! I sense she is close!"
msgstr ""

#. ja: ほう…
#. de: Puh ...
#. fr: Oh oh...
msgctxt "NpcYell:15663:0:13"
msgid "There it is."
msgstr ""

#. ja: 周囲に気を配れ！
#. de: Passen wir gut auf die Umgebung auf!
#. fr: Surveillez les alentours<nbsp>!
msgctxt "NpcYell:15664:0:13"
msgid "On your guard, everyone!"
msgstr ""

#. ja: あれは…<br>ヴォイドゲート！？
#. de: Ist das das Nichtsportal?
#. fr: C'est... la porte du néant<nbsp>!?
msgctxt "NpcYell:15665:0:13"
msgid "There─the voidgate!"
msgstr ""

#. ja: まさか<br>こんなところに…！
#. de: Was? Hier?
#. fr: La porte du néant... Elle était bien cachée.
msgctxt "NpcYell:15666:0:13"
msgid "So the gate really was here."
msgstr ""

#. ja: あれは…<br>ヴォイドゲート！？
#. de: Ist das das Nichtsportal?
#. fr: C'est... la porte du néant<nbsp>!?
msgctxt "NpcYell:15667:0:13"
msgid "There─the voidgate!"
msgstr ""

#. ja: 妖異出現の源に<br>辿り着いたようだな…！
#. de: Hier kommen die Nichts<shy>gesand<shy>ten her!
#. fr: On l'a enfin trouvée... La source de tous nos maux...
msgctxt "NpcYell:15668:0:13"
msgid "At last, we've found it."
msgstr ""

#. ja: いったい何が<br>目的なんだ…！
#. de: Welchem Zweck soll das dienen?
#. fr: Qu'est-ce que ce monstre manigance<nbsp>!?
msgctxt "NpcYell:15669:0:13"
msgid "What is it they seek?"
msgstr ""

#. ja: そこらの雑魚とは<br>違いそうだな…
#. de: Der hier sieht aber ordentlich anders aus.
#. fr: Celui-là, c'est pas du menu fretin.
msgctxt "NpcYell:15670:0:13"
msgid "This one's not at all like the others."
msgstr ""

#. ja: ゴルベーザ四天王…<br>やはり関与していたのね
#. de: Das ist das Werk von Golbez' Elementarfürsten.
#. fr: Un général de Golbez, exactement comme on le craignait...
msgctxt "NpcYell:15671:0:13"
msgid "An archfiend... So this is Golbez's doing."
msgstr ""

#. ja: コウジン族みたいな妖異ね…
#. de: Dieser Nichts<shy>gesand<shy>te erinnert mich an einen Kojin.
#. fr: Il ressemble à un Kojin en beaucoup plus maous<nbsp>!
msgctxt "NpcYell:15672:0:13"
msgid "It looks a lot like the Kojin."
msgstr ""

#. ja: まるでゲートを<br>守っているかのような…
#. de: Er bewacht das Portal.
#. fr: Il cherche à défendre la porte du néant.
msgctxt "NpcYell:15673:0:13"
msgid "No doubt it is here to guard the gate."
msgstr ""

#. ja: そこらの雑魚とは<br>違いそうだな…
#. de: Das sind andere Nichts<shy>gesand<shy>te als die, die wir gesehen haben.
#. fr: Celui-là, c'est pas du menu fretin.
msgctxt "NpcYell:15674:0:13"
msgid "This one seems formidable."
msgstr ""

#. ja: まさかゴルベーザ四天王が<br>渡ってきていたとはね
#. de: Sind die Elementarfürsten also durch das Portal gekommen?
#. fr: Je ne m'attendais pas à voir débarquer un général de Golbez.
msgctxt "NpcYell:15675:0:13"
msgid "To be appointed as an archfiend, I should certainly think so."
msgstr ""

#. ja: 皆、無事か！？
#. de: Alle unverletzt?
#. fr: Est-ce que tout le monde va bien<nbsp>?
msgctxt "NpcYell:15676:0:13"
msgid "Is everyone all right?"
msgstr ""

#. ja: こんなもの…<br>どうということはないわ！
#. de: Es sieht schlimmer aus, als es ist.
#. fr: Il faut plus qu'un peu d'eau pour m'arrêter<nbsp>!
msgctxt "NpcYell:15677:0:13"
msgid "It will take more than that to stop us."
msgstr ""

#. ja: 立て直そう！
#. de: Das kriegen wir wieder hin!
#. fr: Ça va aller, ressaisissons-nous<nbsp>!
msgctxt "NpcYell:15678:0:13"
msgid "Hold fast, everyone!"
msgstr ""

#. ja: 皆、無事か！？
#. de: Alle unverletzt?
#. fr: Est-ce que tout le monde va bien<nbsp>?
msgctxt "NpcYell:15679:0:13"
msgid "Is everyone all right?"
msgstr ""

#. ja: 問題ない
#. de: Das ist nicht so wild.
#. fr: Oui, enfin je crois.
msgctxt "NpcYell:15680:0:13"
msgid "Still in one piece."
msgstr ""

#. ja: 爆ぜよ！
#. de: Zerberstet!
#. fr: Consumez-vous<nbsp>!
msgctxt "NpcYell:15681:0:13"
msgid "Flames take you!"
msgstr ""

#. ja: 凍てつけ！
#. de: Erstarrt zu Eis!
#. fr: Soyez transis de froid<nbsp>!
msgctxt "NpcYell:15682:0:13"
msgid "Ice bind you!"
msgstr ""

#. ja: 轟け！
#. de: Blitz und Donner!
#. fr: Tressaillez<nbsp>!
msgctxt "NpcYell:15683:0:13"
msgid "Now fall!"
msgstr ""

#. ja: 爆ぜよ！
#. de: Zerberstet!
#. fr: Consumez-vous<nbsp>!
msgctxt "NpcYell:15684:0:13"
msgid "Flames take you!"
msgstr ""

#. ja: 凍てつけ！
#. de: Erstarrt zu Eis!
#. fr: Soyez transis de froid<nbsp>!
msgctxt "NpcYell:15685:0:13"
msgid "Ice bind you!"
msgstr ""

#. ja: 轟け！
#. de: Blitz und Donner!
#. fr: Tressaillez<nbsp>!
msgctxt "NpcYell:15686:0:13"
msgid "Now fall!"
msgstr ""

#. ja: フウゥゥゥ…！
#. de: Rrrrrh ...!
#. fr: Wooouuuh...<nbsp>!
msgctxt "NpcYell:15687:0:13"
msgid "Graaagggh!"
msgstr ""

#. ja: ウウ…ウガァァァッ！
#. de: Rrrh ... Rghaaa!
#. fr: Rrr... ugaaah<nbsp>!
msgctxt "NpcYell:15688:0:13"
msgid "Uraaagh!"
msgstr ""

#. ja: グルルルゥゥゥッ！
#. de: Grrrruuuuh!
#. fr: Grrrrruuuuuuh<nbsp>!
msgctxt "NpcYell:15689:0:13"
msgid "GrrrGGGHHH!"
msgstr ""

#. ja: キキィッ…！
#. de: Quiep!
#. fr: Khiiih<nbsp>! Khiiiiih<nbsp>!
msgctxt "NpcYell:15690:0:13"
msgid "Kiiih!"
msgstr ""

#. ja: グルルル…
#. de: Grrrh<nbsp>...
#. fr: Grrrrr...
msgctxt "NpcYell:15691:0:13"
msgid "Grrr..."
msgstr ""

#. ja: グォォォン…！
#. de: Groaaah!
#. fr: Graaaaaah<nbsp>!
msgctxt "NpcYell:15692:0:13"
msgid "Rrrrrr!"
msgstr ""

#. ja: シュルル…
#. de: Zsssch<nbsp>...
#. fr: Sssss...
msgctxt "NpcYell:15693:0:13"
msgid "Hisss..."
msgstr ""

#. ja: シャーッ…！
#. de: Ssssh!
#. fr: Shaaaa<nbsp>!
msgctxt "NpcYell:15694:0:13"
msgid "Hissssss!"
msgstr ""

#. ja: 粉砕シテヤル…！
#. de: Nichts wird von euch übrig sein!
#. fr: Je vais vous réduire en poussière<nbsp>!
msgctxt "NpcYell:15695:0:13"
msgid "Earth..."
msgstr ""

#. ja: 粉砕シテヤル…！
#. de: Nichts wird von euch übrig sein!
#. fr: Je vais vous réduire en poussière<nbsp>!
msgctxt "NpcYell:15696:0:13"
msgid "Earth..."
msgstr ""

#. ja: 煙ニ惑エ…！
#. de: Rauch in eure Lungen!
#. fr: Que ma fumée vous emporte<nbsp>!
msgctxt "NpcYell:15697:0:13"
msgid "Ashes..."
msgstr ""

#. ja: 煙ニ惑エ…！
#. de: Rauch in eure Lungen!
#. fr: Que ma fumée vous emporte<nbsp>!
msgctxt "NpcYell:15698:0:13"
msgid "Ashes..."
msgstr ""

#. ja: 骨マデ砕ク…！
#. de: Wir malmen eure Knochen zu Staub!
#. fr: Il ne restera plus de vous qu'un tas d'os<nbsp>!
msgctxt "NpcYell:15699:0:13"
msgid "Dust..."
msgstr ""

#. ja: 骨マデ砕ク…！
#. de: Wir malmen eure Knochen zu Staub!
#. fr: Il ne restera plus de vous qu'un tas d'os<nbsp>!
msgctxt "NpcYell:15700:0:13"
msgid "Dust..."
msgstr ""

#. ja: コレデ終イダ…！
#. de: Euer Ende naht ...
#. fr: Vous êtes déjà morts<nbsp>!
msgctxt "NpcYell:15701:0:13"
msgid "Struggle no more..."
msgstr ""

#. ja: コレデ終イダ…！
#. de: Euer Ende naht ...
#. fr: Vous êtes déjà morts<nbsp>!
msgctxt "NpcYell:15702:0:13"
msgid "Struggle no more..."
msgstr ""

#. ja: 私が選ぶのなら…
#. de: Also meiner bescheidenen Meinung nach<nbsp>...
#. fr: Voyons voir...
msgctxt "NpcYell:15703:0:13"
msgid "Were I to chart our course..."
msgstr ""

#. ja: こちらデスネ！
#. de: ... sollten wir hier entlang.
#. fr: Je choisis celui-ci<nbsp>!
msgctxt "NpcYell:15704:0:13"
msgid "I would choose this path."
msgstr ""

#. ja: 陰陽師さん<br>お願いできますか？
#. de: Wärt Ihr wohl so gütig, uns den Weg zu bereiten?
#. fr: Le téléporteur, s'il vous plaît<nbsp>!
msgctxt "NpcYell:15705:0:13"
msgid "The portal, if you would, good sir."
msgstr ""

#. ja: 結界よ、開門せい！<br>ハァァッ！
#. de: So erhöre mich,<br>O Siegel alter Künste:<br>Tu auf die Pforten.
#. fr: Portail magique, ouvre-toi<nbsp>! HAAAH<nbsp>!!
msgctxt "NpcYell:15707:0:13"
msgid "Seal of shadow, reveal thy path!"
msgstr ""

#. ja: さあ<br>進みますヨ！
#. de: Dann wollen wir mal, hm?
#. fr: Attention, chaud devant<nbsp>!
msgctxt "NpcYell:15708:0:13"
msgid "Excellent! Let us be about it."
msgstr ""

#. ja: これが例の<br>怪異デスか！
#. de: Und das wären wohl die Spukgestalten!
#. fr: Oups<nbsp>! Les envahisseurs sont déjà là<nbsp>!
msgctxt "NpcYell:15709:0:13"
msgid "Demons already!?"
msgstr ""

#. ja: さすがの<br>お手並みデ！
#. de: Ein überaus kurzer Prozess.
#. fr: Je n'en attendais pas moins de vous, hé hé<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:15710:0:13"
msgid "Well done, <split \" \" 1><string $gs1></split>!"
msgstr ""

#. ja: またもや<br>怪異が…！
#. de: Huch, da sind noch mehr.
#. fr: Voici la suite des hostilités<nbsp>!
msgctxt "NpcYell:15711:0:13"
msgid "There is no end to these beasts!"
msgstr ""

#. ja: どこも怪異だらけ<br>山を封じて正解デス
#. de: Nichts als Schauerlichkeiten<nbsp>...<br>Zweifelsohne, dieser Berg gehört versiegelt.
#. fr: Le seigneur Uzumibi a bien fait d'interdire l'accès aux lieux<nbsp>!
msgctxt "NpcYell:15712:0:13"
msgid "'Tis little wonder the mount was sealed."
msgstr ""

#. ja: 急な大雨は<br>困りマ～ス！
#. de: Für derlei Ergüsse bin ich nicht gekleidet!
#. fr: En voilà une averse, tout à coup<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:15713:0:13"
msgid "<i>No</i>! My climbing attire is soaked..."
msgstr ""

#. ja: 急に風が<br>強くなりましたネ…
#. de: Hm, die Bergbrise ist deutlich steifer geworden<nbsp>...
#. fr: En voilà une bourrasque, tout à coup<nbsp>!
msgctxt "NpcYell:15714:0:13"
msgid "This is no ordinary windstorm!"
msgstr ""

#. ja: 屋内にまで<br>怪異がいるなんて…
#. de: Selbst hier drinnen spukt es<nbsp>...
#. fr: Même à l'intérieur, ça ne s'arrête jamais<nbsp>!
msgctxt "NpcYell:15715:0:13"
msgid "Oh dear. They've raided the place!"
msgstr ""

#. ja: ここにも怪異が<br>蔓延ってマ～ス！
#. de: Oje, mit jedem Schritt wird es unheimlicher!
#. fr: C'est une véritable armée, ma parole<nbsp>!
msgctxt "NpcYell:15716:0:13"
msgid "Gods, they're everywhere! Have at them!"
msgstr ""

#. ja: これはまた<br>怪しいデ～ス…
#. de: Das gefällt mir auch ganz und gar nicht.
#. fr: Hmm, cette boîte ne me dit rien qui vaille...
msgctxt "NpcYell:15717:0:13"
msgid "How very suspicious."
msgstr ""

#. ja: 異様な気配が<br>収まりましたネ！
#. de: So ist es doch gleich netter hier.
#. fr: Ouf, cette atmosphère étouffante s'est enfin dissipée<nbsp>!
msgctxt "NpcYell:15718:0:13"
msgid "Oho! The wicked presence is no more."
msgstr ""

#. ja: おや<br>行き止まりデスカ
#. de: Oh? Das wird doch keine Sackgasse sein?
#. fr: Hmm... Un cul-de-sac, peut-être<nbsp>?
msgctxt "NpcYell:15719:0:13"
msgid "All this for a dead end...? How odd."
msgstr ""

#. ja: 屋根を進むと…？<br>冗談が過ぎマ～ス！
#. de: Über das <i>Dach</i>?! Bitte nicht<nbsp>...
#. fr: Allons bon, nous voilà bientôt sur le toit<nbsp>!
msgctxt "NpcYell:15720:0:13"
msgid "You mean to take to the roof!?"
msgstr ""

#. ja: こんな場所まで<br>怪異まみれとは…
#. de: Und selbst hier wimmelt es vor Schrecken<nbsp>...
#. fr: Ces créatures sont vraiment partout<nbsp>!
msgctxt "NpcYell:15721:0:13"
msgid "I see the mononoke share your sensibilities!"
msgstr ""

#. ja: そこから<br>屋内へ戻りましょう！
#. de: Lass uns wieder nach Innen zurückkehren!
#. fr: Retournons à l'intérieur<nbsp>!
msgctxt "NpcYell:15722:0:13"
msgid "Let us head back inside, quickly!"
msgstr ""

#. ja: 戦いで明かりが<br>消えてしまいましたネ…
#. de: Während des Kampfes sind alle Lichter erloschen<nbsp>...
#. fr: La lumière n'a pas résisté au combat...
msgctxt "NpcYell:15723:0:13"
msgid "That battle must have blown out the lights."
msgstr ""

#. ja: さらに上へ<br>進みましょう！
#. de: Hinauf, hinauf!
#. fr: Continuons de monter<nbsp>!
msgctxt "NpcYell:15724:0:13"
msgid "Another flight of stairs! Shall we?"
msgstr ""

#. ja: 怪異退治は<br>頼みマシタ！
#. de: Einmal Ungeheuer erschlagen, bitte sehr!
#. fr: À vous l'honneur, <if $gn4>ma chère<else>mon cher</if> <split " " 1><string $gs1></split><nbsp>!
msgctxt "NpcYell:15726:0:13"
msgid "I shall leave the martial matters to you!"
msgstr ""

#. ja: 建物が<br>見えますネ…
#. de: Ich erspähe ein Gebäude!
#. fr: J'aperçois un bâtiment au loin...
msgctxt "NpcYell:15727:0:13"
msgid "I spy a structure in the distance..."
msgstr ""

#. ja: またもや<br>怪異がいますヨ！
#. de: Aaah, noch mehr Abscheulichkeiten!
#. fr: Revoilà ces vilaines créatures<nbsp>!
msgctxt "NpcYell:15728:0:13"
msgid "So many horrors, so little time!"
msgstr ""

#. ja: 寿命が縮むかと<br>思いマシタ…
#. de: Puh, ich hörte mein letztes Stündlein schon schlagen<nbsp>...
#. fr: J'ai bien cru que ma dernière heure avait sonné...
msgctxt "NpcYell:15729:0:13"
msgid "Why, I feared that would be the end of me!"
msgstr ""

#. ja: これはまた<br>絶景デスネ！
#. de: Sehr beschaulich ist es hier! Wenn die Ungeheuer nicht wären.
#. fr: Encore un panorama à couper le souffle<nbsp>!
msgctxt "NpcYell:15730:0:13"
msgid "This temple is the pinnacle of picturesque."
msgstr ""

#. ja: こちらの怪異も<br>倒してくだサ～イ！
#. de: Diese hier, beispielsweise.
#. fr: Débarrassez-nous de ces immondices, s'il vous plaît<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:15731:0:13"
msgid "More of them? \\<sigh> After you, <split \" \" 1><string $gs1></split>!"
msgstr ""

#. ja: ニ、ニンゲン！？
#. de: S-Sind das Sterbliche?!
#. fr: Des... Des humains<nbsp>!?
msgctxt "NpcYell:15732:0:13"
msgid "M-M-Mortals!?"
msgstr ""

#. ja: ヒィッ！<br>命だけは…！
#. de: Aaah! Erbarmen!
#. fr: Ne me tuez pas, je vous en supplie<nbsp>!
msgctxt "NpcYell:15733:0:13"
msgid "Nooo! Spare me, I beg of you!"
msgstr ""

#. ja: わ、わかった…！
#. de: I-In Ordnung!
#. fr: M-merci...
msgctxt "NpcYell:15734:0:13"
msgid "Many, many thanks!"
msgstr ""

#. ja: クソッ…<br>覚えてろよぉ～！
#. de: Blargh! Das merk ich mir!
#. fr: Hi hi hiii<nbsp>!! Vous avez signé votre arrêt de mort, humains<nbsp>!
msgctxt "NpcYell:15735:0:13"
msgid "That way! Oh yes, that way!"
msgstr ""

#. ja: オ～ゥ<br>逃げ足の速いことデ…
#. de: Da nimmt er die Beinchen in die Hand<nbsp>...
#. fr: Il court plus vite que son ombre, celui-là...
msgctxt "NpcYell:15736:0:13"
msgid "And off it goes..."
msgstr ""

#. ja: キャッキャッ！<br>馬鹿なニンゲンめ！
#. de: Kekeke! Reingefallen!
#. fr: Hi hi hiii<nbsp>!! Vous êtes pris au piège, bande d'imbéciles<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:15737:0:13"
msgid "How dare you! How <i>dare</i> you!"
msgstr ""

#. ja: これといったものは<br>見当たりませんネ
#. de: Das sagt mir leider überhaupt nichts.
#. fr: Je ne vois rien du tout...
msgctxt "NpcYell:15739:0:13"
msgid "Would that we had a bit more light."
msgstr ""

#. ja: 怪異の<br>お出ましデ～ス！
#. de: Da geht es auch schon weiter!
#. fr: Ah si, finalement<nbsp>! <split " " 1><string $gs1></split>, je vous présente vos prochains adversaires<nbsp>!
msgctxt "NpcYell:15740:0:13"
msgid "“Be careful what you wish for,” and all that..."
msgstr ""

#. ja: 何もないとは<br>拍子抜けデスネ…
#. de: Nichts? Das ist schon etwas enttäuschend<nbsp>...
#. fr: C'est tout<nbsp>? Mince... quelle déception...
msgctxt "NpcYell:15741:0:13"
msgid "I see naught else of note here."
msgstr ""

#. ja: ともあれ…<br>奥へ進みますか
#. de: Kann man nichts machen. Weiter?
#. fr: Tant pis, on continue<nbsp>!
msgctxt "NpcYell:15742:0:13"
msgid "The inner sanctum awaits!"
msgstr ""

#. ja: やはり<br>煙管がありマシタ！
#. de: Ah, also doch ein Pfeifchen!
#. fr: Nom d'une pipe, voilà une sacrée découverte<nbsp>!
msgctxt "NpcYell:15743:0:13"
msgid "Oho! As I predicted."
msgstr ""

#. ja: オ～ゥ<br>敵が近すぎマスヨ！？
#. de: Oje oje, so hautnah brauche ich das Abenteuer aber nicht!
#. fr: Ils sont un peu trop près à mon goût, ceux-là<nbsp>!
msgctxt "NpcYell:15744:0:13"
msgid "Might I suggest you take this elsewhere!?"
msgstr ""

#. ja: 私を巻き込まないで<br>くだサ～イ！
#. de: Ohne mich, bitte!
#. fr: Laissez-moi tranquille, je n'ai rien à voir là-dedans<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:15745:0:13"
msgid "I would prefer <i>not</i> to join the fray, thank you!"
msgstr ""

#. ja: 怪異ではなく<br>植物の魔物デスか…
#. de: Pflanzen? Gespenster? Gespensterpflanzen?!
#. fr: Hmm, ça ressemble plus à des végétaux qu'à des monstres...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15746:0:13"
msgid "Aaaaaaaaaaaah!<br>...Oh. Just seedkin."
msgstr ""

#. ja: 気をつけて<br>進むとしましょう
#. de: Mir stehen die Haare ja schon etwas zu Berge<nbsp>...
#. fr: Continuons d'avancer, mais restons prudents<nbsp>!
msgctxt "NpcYell:15747:0:13"
msgid "Shall we continue our hike?"
msgstr ""

#. ja: オ～ゥ<br>怪異も現れマシタ！
#. de: Oho, noch mehr Spukgestalten!
#. fr: Oh non, encore des méchants monstres<nbsp>!
msgctxt "NpcYell:15748:0:13"
msgid "Aha! There's our quarry."
msgstr ""

#. ja: 余所見をする暇も<br>ないデ～ス…
#. de: Keinen Moment Ruhe hat man hier<nbsp>...
#. fr: Pas le temps de bayer aux corneilles...
msgctxt "NpcYell:15749:0:13"
msgid "No time to tarry! We've a ways to go."
msgstr ""

#. ja: 彼らの相手は<br>お願いしマ～ス！
#. de: Die ganze Ge<shy>sell<shy>schaft, bitte sehr!
#. fr: Ces atrocités ont envie de faire con<shy>nais<shy>san<shy>ce avec vous, mon ami<if $gn4>e</if><nbsp>!
msgctxt "NpcYell:15750:0:13"
msgid "I believe this is where you come in!"
msgstr ""

#. ja: この道の先には<br>何があるのでしょう…
#. de: Wo uns dieser Pfad wohl hinführt?
#. fr: Je me demande ce qui nous attend au bout de ce chemin...
msgctxt "NpcYell:15751:0:13"
msgid "What lies at the end of the path, I wonder...?"
msgstr ""

#. ja: 今度は<br>野生の獣まで…
#. de: Jetzt also auch noch die Fauna zur Flora.
#. fr: Des bêtes sauvages, maintenant...
msgctxt "NpcYell:15752:0:13"
msgid "There's a veritable menagerie on this mountain!"
msgstr ""

#. ja: 怪異がいては<br>景色が台無しデ～ス！
#. de: Dabei könnte es hier so nett sein<nbsp>...
#. fr: Ces horribles créatures gâchent vraiment le paysage<nbsp>!
msgctxt "NpcYell:15753:0:13"
msgid "And just like that, the scenery is ruined!"
msgstr ""

#. ja: フゥ～<br>キリがないデスネ
#. de: Puh, langsam ist es dann auch gut.
#. fr: Oh là là, on n'en voit jamais le bout<nbsp>!
msgctxt "NpcYell:15754:0:13"
msgid "You would think they'd have given up by now..."
msgstr ""

#. ja: 道が途切れて<br>しまいマシタ…
#. de: Ich habe keine Ahnung mehr, wo genau wir sind.
#. fr: Zut, par où aller à présent<nbsp>?
msgctxt "NpcYell:15755:0:13"
msgid "Hmm... Where to go from here?"
msgstr ""

#. ja: ヒィッ…！
#. de: Schreck lass nach!
#. fr: AAAAAAH<nbsp>!
msgctxt "NpcYell:15756:0:13"
msgid "Courage! Couraaaaaage!"
msgstr ""

#. ja: 次から次へと<br>大忙しデ～ス！
#. de: Nur keine Müdigkeit vorschützen!
#. fr: Encore<nbsp>!? On ne sait plus où donner de la tête tellement il y en a<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:15757:0:13"
msgid "Pray go on ahead...<br>I need a moment."
msgstr ""

#. ja: 冒険というものは<br>大変デスネ…
#. de: Die Abenteurerei ist schon sehr hart verdientes Brot, oder?
#. fr: Pas facile du tout, la vie d'aventurier...
msgctxt "NpcYell:15758:0:13"
msgid "...This is precisely why a life of adventure is not for me."
msgstr ""

#. ja: 祠の扉が<br>開きましたヨ！
#. de: Schrein, öffne dich!
#. fr: Oh<nbsp>!! L'autel nous ouvre ses portes<nbsp>!
msgctxt "NpcYell:15759:0:13"
msgid "'Tis as though it's answering! How very polite."
msgstr ""

#. ja: 地割れでも<br>起きたのでしょうか
#. de: Ist das Land hier aufgerissen?
#. fr: J'ai l'impression que le sol s'est fendu en deux par ici...
msgctxt "NpcYell:15760:0:13"
msgid "The result of a landslide, perhaps?"
msgstr ""

#. ja: こんなところに忍びが…<br>少し様子がおかしいデスね
#. de: Wie kommt denn eine Shinobi hierher? Merkwürdig.
#. fr: Cette shinobi ne m'inspire guère confiance...
msgctxt "NpcYell:15761:0:13"
msgid "A shinobi? And out in the open, at that..."
msgstr ""

#. ja: 物々しい石像デスネ…<br>胴体に何か刺さっていマス
#. de: Höchst imposant, diese Statue. Aber was steckt ihr da im Rumpf?
#. fr: Quelque chose semble planté dans cette énorme statue...
msgctxt "NpcYell:15762:0:13"
msgid "What is that lodged in the statue?"
msgstr ""

#. ja: ベルル…<br>どこにいるクポ？
#. de: Beruru, wo bist du<nbsp>...?
#. fr: Beruru... Où es-tu, kupo<nbsp>?
msgctxt "NpcYell:15763:0:13"
msgid "Beruru, where are you...?"
msgstr ""

#. ja: あ、あちらです…！
#. de: Dort! Dort drüben!
#. fr: Là-bas<nbsp>!
msgctxt "NpcYell:15764:0:13"
msgid "They're over there!"
msgstr ""

#. ja: 助けてください！<br>家族が…！
#. de: Zu Hilfe! Meine Familie ...!
#. fr: S'il vous plaît<nbsp>! Ma famille a besoin d'aide<nbsp>!
msgctxt "NpcYell:15765:0:13"
msgid "Help! Please help my family!"
msgstr ""

#. ja: 戦続きで王女様も<br>心労が絶えないだろうに…
#. de: Dabei müssen die Strapazen des Krieges ihr so zugesetzt haben<nbsp>...
#. fr: Cette guerre lui pèse tellement, à elle aussi...
msgctxt "NpcYell:15766:0:13"
msgid "The war must be trying on her too."
msgstr ""

#. ja: スフェーン様は<br>あの飛空艇に…？
#. de: Ihre Hoheit? In dem Luftschiff dort ...?
#. fr: Sa Majesté Sphene est à bord de cet aéronef<nbsp>!
msgctxt "NpcYell:15767:0:13"
msgid "Awww, she's already back in the airship..."
msgstr ""

#. ja: 倒れて…たまるかッ！
#. de: Nicht hier<nbsp>... Nicht jetzt<nbsp>...
#. fr: J'ai pas dit mon dernier mot<nbsp>!
msgctxt "NpcYell:15768:0:13"
msgid "This isn't over."
msgstr ""

#. ja: くらえっ！
#. de: Nimm das!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:15769:0:13"
msgid "Hold still!"
msgstr ""

#. ja: なめんな！
#. de: Unterschätz mich nicht!
#. fr: Tu vas voir<nbsp>!
msgctxt "NpcYell:15770:0:13"
msgid "Back off!"
msgstr ""

#. ja: 立ち上る光…<br>目的地はあちらか…！
#. de: Eine Säule aus Licht<nbsp>... Damit steht unser Ziel fest.
#. fr: Ce halo de lumière... C'est notre objectif<nbsp>!
msgctxt "NpcYell:15771:0:13"
msgid "That pillar of light... Is it a geyser?"
msgstr ""

#. ja: さて、進むとしよう
#. de: Dann los, lasst uns keine Zeit verlieren.
#. fr: Ne perdons pas de temps.
msgctxt "NpcYell:15772:0:13"
msgid "Let's get moving."
msgstr ""

#. ja: 凄まじい量のエーテルだな
#. de: So viel Äther an einem einzigen Ort<nbsp>... Geradezu unheimlich.
#. fr: Tout cet éther, c'est im<shy>pres<shy>sion<shy>nant.
msgctxt "NpcYell:15773:0:13"
msgid "Such an abundance of aether..."
msgstr ""

#. ja: 陸地が<br>見えてまいりましたね
#. de: Das Festland ist bereits in Sicht.
#. fr: Notre destination est en vue.
msgctxt "NpcYell:15774:0:13"
msgid "The isle proper is within sight."
msgstr ""

#. ja: まずは<br>あの建物まで行くぞ
#. de: Dann lasst uns zunächst bis zu diesem Gebäude dort vorstoßen.
#. fr: Commençons par atteindre cette structure.
msgctxt "NpcYell:15775:0:13"
msgid "That building certainly looks the part."
msgstr ""

#. ja: 哲学者議会直轄の<br>管理施設ですね
#. de: Eine Verwaltungseinrichtung des Rats der Philosophen, wenn mich nicht alles täuscht.
#. fr: Ce bâtiment doit être sous le contrôle du Conseil...
msgctxt "NpcYell:15776:0:13"
msgid "A Sharlayan facility, and no mistake."
msgstr ""

#. ja: 簡単には<br>上陸させてくれないようだな
#. de: So einfach wird man uns hier wohl nicht an Land gehen lassen<nbsp>...
#. fr: Nous ne sommes pas les bienvenus.
msgctxt "NpcYell:15777:0:13"
msgid "It seems we will not pass here without a struggle."
msgstr ""

#. ja: これはまた…<br>独特な姿で…
#. de: Selbst nach allem, was wir bereits erlebt haben<nbsp>... Erstaunt mich manches stets aufs Neue<nbsp>...
#. fr: Quelle morphologie surprenante...
msgctxt "NpcYell:15778:0:13"
msgid "Fascinating..."
msgstr ""

#. ja: なんだあいつは？
#. de: Was ist das für ein Vieh?
#. fr: C'est quoi, cette créature<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:15779:0:13"
msgid "What <i>is</i> that?"
msgstr ""

#. ja: リングバーク…<br>獰猛で知られる海獣です
#. de: Lyngbakr<nbsp>... Eine Bestie bekannt für ihre Grausamkeit.
#. fr: Un des monstres de l'île connu pour sa férocité.
msgctxt "NpcYell:15780:0:13"
msgid "Lyngbakr, dread beast of the seas."
msgstr ""

#. ja: よし、上陸だ！
#. de: Endlich an Land!
#. fr: Enfin, la terre ferme<nbsp>!
msgctxt "NpcYell:15781:0:13"
msgid "Land at last!"
msgstr ""

#. ja: 耳鳴りがいたします…
#. de: Davon werden sich meine Ohren länger nicht erholen<nbsp>...
#. fr: J'ai encore les oreilles qui sifflent...
msgctxt "NpcYell:15782:0:13"
msgid "Mine ears yet ring..."
msgstr ""

#. ja: やかましい奴だったな
#. de: Was für eine nervtötend laute Bestie.
#. fr: Celui-là m'a bien tapé sur les nerfs.
msgctxt "NpcYell:15783:0:13"
msgid "Troublesome creature."
msgstr ""

#. ja: エーテルが濃いためか<br>植生も豊かなようですね
#. de: Welch atemberaubende Vegetation. Den Pflanzen scheint der Äther hier gut zu bekommen.
#. fr: La végétation semble être favorisée par l'éther ambiant.
msgctxt "NpcYell:15784:0:13"
msgid "It cometh as no surprise that the vegetation here is eminently lush."
msgstr ""

#. ja: あの移動手段<br>便利なものだな
#. de: Diese Transportmittel sind durchaus praktisch.
#. fr: C'est pratique de se déplacer comme ça.
msgctxt "NpcYell:15785:0:13"
msgid "A convenient mode of transport, that."
msgstr ""

#. ja: いい眺めじゃないか
#. de: An diesen Anblick könnte ich mich gewöhnen.
#. fr: La vue vaut le détour.
msgctxt "NpcYell:15786:0:13"
msgid "This is quite a view."
msgstr ""

#. ja: 島中に<br>張り巡らされているようです
#. de: Sie sind scheinbar auf der gesamten Insel verstreut.
#. fr: Il y a des filins similaires dans toute l'île.
msgctxt "NpcYell:15787:0:13"
msgid "Such lines are installed throughout the isle, I believe."
msgstr ""

#. ja: 煌びやかなものだな
#. de: Es lässt sich wirklich kaum in Worte fassen.
#. fr: C'est à vous couper le souffle...
msgctxt "NpcYell:15788:0:13"
msgid "Such vibrant colors."
msgstr ""

#. ja: ゴーレムの性質が<br>変化しているようですね
#. de: Etwas in diesen Golems scheint sich verändert zu haben.
#. fr: Une sorte d'évolution du golem, j'imagine.
msgctxt "NpcYell:15789:0:13"
msgid "The isle hath effected a curious change upon yonder golems."
msgstr ""

#. ja: 目障りな…
#. de: Aus dem Weg<nbsp>...!
#. fr: Quelle barbe...
msgctxt "NpcYell:15790:0:13"
msgid "What an eyesore."
msgstr ""

#. ja: エーテルの喰いすぎだ
#. de: Sie haben zu viel Äther auf einmal aufgenommen<nbsp>...
#. fr: Certains ont un peu trop forcé sur l'éther, je crois.
msgctxt "NpcYell:15791:0:13"
msgid "There's such a thing as too much aether."
msgstr ""

#. ja: あれは…シロクマか…？
#. de: Ist das<nbsp>... ein Eisbär<nbsp>...?
#. fr: ... Un ours blanc<nbsp>?
msgctxt "NpcYell:15792:0:13"
msgid "Is that bear from the ice field?"
msgstr ""

#. ja: 体表が結晶化するとは…<br>驚きました
#. de: Sein Körper ist teilweise kristallisiert<nbsp>... Höchst ungewöhnlich.
#. fr: Son corps semble cristallisé. Fascinant...
msgctxt "NpcYell:15793:0:13"
msgid "That aether should crystallize upon its very body..."
msgstr ""

#. ja: ここはこいつの縄張りか
#. de: Ist das hier etwa sein Revier?
#. fr: Je crois qu'on est sur son territoire.
msgctxt "NpcYell:15794:0:13"
msgid "Doesn't look like the type to welcome houseguests."
msgstr ""

#. ja: 濃密なエーテルに<br>引き寄せられて来たのでしょう
#. de: Es könnte auch sein, dass der dichte Äther hier ihn angelockt hat.
#. fr: Il ne semble pas enclin à partager l'éther avec nous...
msgctxt "NpcYell:15795:0:13"
msgid "Drawn hither by the profusion of aether, I daresay."
msgstr ""

#. ja: 雷のエーテルを<br>身に宿していたのか
#. de: Dass er Blitzäther in seinem Körper speichern würde<nbsp>...!
#. fr: Son corps était comme habité par l'énergie de la foudre.
msgctxt "NpcYell:15796:0:13"
msgid "No small amount of lightning it harbored."
msgstr ""

#. ja: 野獣ごときに<br>やられるものか
#. de: Als ob es eine wilde Bestie mit uns aufnehmen könnte.
#. fr: Cette pauvre bête n'avait pas la moindre chance contre nous.
msgctxt "NpcYell:15797:0:13"
msgid "Just another beast in the end."
msgstr ""

#. ja: ずいぶんと凶暴だったな
#. de: Das Biest war ganz schön aufgedreht.
#. fr: Ça a fait des étincelles...
msgctxt "NpcYell:15798:0:13"
msgid "Sparking mad."
msgstr ""

#. ja: まともな獣じゃ<br>なかったがな…
#. de: Wer weiß, wie viel Bestie sie wirklich war<nbsp>...
#. fr: Tu ne perds jamais ton sang-froid, Zero<nbsp>!?
msgctxt "NpcYell:15799:0:13"
msgid "“Just another”..."
msgstr ""

#. ja: 一面にクリスタルとは…<br>むせ返るほどのエーテルだ
#. de: Kristalle, so weit das Auge reicht<nbsp>...! Bei dieser Menge an Äther wird mir geradezu übel.
#. fr: Une façade faite entièrement de cristal... C'est féerique...
msgctxt "NpcYell:15800:0:13"
msgid "Such an overwhelming concentration of aether!"
msgstr ""

#. ja: 悪くない景色だ
#. de: Ich gebe zu, dies ist kein schlechter Anblick.
#. fr: Pas mal, la vue.
msgctxt "NpcYell:15801:0:13"
msgid "Impressive..."
msgstr ""

#. ja: 妖異にとっては<br>垂涎の光景だな
#. de: Meinesgleichen würden alles für diesen Anblick geben.
#. fr: De quoi ravitailler une armée de créatures du néant...
msgctxt "NpcYell:15802:0:13"
msgid "A veritable feast for voidsent."
msgstr ""

#. ja: エーテルの奔流が<br>可視化していますね
#. de: Da ist er, der Ätherstrom.
#. fr: Les courants d'éther se font de plus en plus visibles...
msgctxt "NpcYell:15803:0:13"
msgid "We are come close enough to see even the finer movements of aether."
msgstr ""

#. ja: あの奔流のふもとまで<br>行けばいいんだよな？
#. de: Wir müssen also einfach diesem Strom zum Fuß folgen?
#. fr: Il faut qu'on aille à la source de ce grand geyser, j'imagine<nbsp>?
msgctxt "NpcYell:15804:0:13"
msgid "I suppose we aim for that massive geyser?"
msgstr ""

#. ja: ええ<br>目的地はすぐそこです…
#. de: Exakt. Wir haben unser Ziel beinahe erreicht.
#. fr: Oui, nous ne sommes plus très loin, maintenant.
msgctxt "NpcYell:15805:0:13"
msgid "Aye, there lieth our destination."
msgstr ""

#. ja: 阻むというなら<br>戦うのみだ！
#. de: Wir nehmen es mit allen auf, die sich uns in den Weg stellen.
#. fr: Nous écarterons quiconque se mettra en travers de notre route.
msgctxt "NpcYell:15806:0:13"
msgid "You will not stop us!"
msgstr ""

#. ja: イカ…いえタコでしょうか？
#. de: Ein Tintenfisch<nbsp>...? Nein, ein Oktopus?
#. fr: Un calamar géant<nbsp>? Non, plutôt une pieuvre...
msgctxt "NpcYell:15807:0:13"
msgid "A squid? Nay...an octopus."
msgstr ""

#. ja: …でかいな
#. de: Ziemlich groß<nbsp>...
#. fr: Beau gabarit.
msgctxt "NpcYell:15808:0:13"
msgid "A sizable beast."
msgstr ""

#. ja: やってやろうじゃないか！
#. de: Dann wollen wir mal!
#. fr: Je sens qu'on ne va pas s'ennuyer<nbsp>!
msgctxt "NpcYell:15809:0:13"
msgid "This ought to be interesting."
msgstr ""

#. ja: やる気は十分なようだな
#. de: Ha! An Motivation scheint es ja nicht zu mangeln!
#. fr: Belle détermination<nbsp>!
msgctxt "NpcYell:15810:0:13"
msgid "Though not for want of trying, I suspect."
msgstr ""

#. ja: あまりの高さに少々…<br>身がすくむ思いでした…
#. de: Wenn ich an diese Höhe denke<nbsp>... Erstarrt mein Körper wie von selbst<nbsp>...
#. fr: J'ai le vertige...
msgctxt "NpcYell:15811:0:13"
msgid "That was rather too high for comfort, I must confess..."
msgstr ""

#. ja: 風を切って進むのは<br>気持ちがいいな！
#. de: Mit voller Ge<shy>schwindig<shy>keit voran ist immer noch am besten!
#. fr: C'est si agréable de fendre le vent<nbsp>!
msgctxt "NpcYell:15812:0:13"
msgid "Quite invigorating!"
msgstr ""

#. ja: そぉら！
#. de: Yargh!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:15813:0:13"
msgid "There!"
msgstr ""

#. ja: 行きやすよ！
#. de: Zum Angriff!
#. fr: Sus à l'ennemi<nbsp>!
msgctxt "NpcYell:15814:0:13"
msgid "Here I go!"
msgstr ""

#. ja: 一気呵成に！
#. de: Keine Gnade!
#. fr: Pas de pitié<nbsp>!
msgctxt "NpcYell:15815:0:13"
msgid "In one fell swoop!"
msgstr ""

#. ja: ならば、これにて…！
#. de: Jetzt ist Schluss!
#. fr: C'est terrrminé<nbsp>!
msgctxt "NpcYell:15816:0:13"
msgid "Time to end this!"
msgstr ""

#. ja: 恨みはありやせんが…<br>御免！
#. de: Ihr lasst mir keine Wahl<nbsp>...
#. fr: Je n'ai plus le choix<nbsp>!
msgctxt "NpcYell:15817:0:13"
msgid "It's nothing personal!"
msgstr ""

#. ja: 情けないこと、でやす…
#. de: Verzeiht ...
#. fr: Ça se prrrésente... mal...
msgctxt "NpcYell:15818:0:13"
msgid "A poor showing..."
msgstr ""

#. ja: 心は折れていやせん…！
#. de: Ich habe das letzte Wort!
#. fr: Je n'ai pas dit mon derrrnier mot<nbsp>!
msgctxt "NpcYell:15819:0:13"
msgid "I'm not finished yet!"
msgstr ""

#. ja: 喰らえッ！
#. de: Nimm das!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:15820:0:13"
msgid "Take this!"
msgstr ""

#. ja: うおおおおお！
#. de: Angriiiff!!!
#. fr: Ouoooooh<nbsp>!
msgctxt "NpcYell:15821:0:13"
msgid "Here it comes!"
msgstr ""

#. ja: 姉さん直伝の技で！
#. de: Das ist für Yda!
#. fr: Yda, donne-moi ta force<nbsp>!
msgctxt "NpcYell:15822:0:13"
msgid "This one's for you, Yda!"
msgstr ""

#. ja: 覚悟しなよ！
#. de: Jetzt gibt's Saures!
#. fr: Prépare-toi<nbsp>!
msgctxt "NpcYell:15823:0:13"
msgid "Ready?"
msgstr ""

#. ja: アタシの決意の証しだよ！
#. de: Jetzt bin ICH dran!
#. fr: Tu vas la sentir passer<nbsp>!
msgctxt "NpcYell:15824:0:13"
msgid "Time to get serious!"
msgstr ""

#. ja: 斃れるわけには…
#. de: Nicht schlappmachen, Lyse<nbsp>...
#. fr: Je ne dois pas perdre...
msgctxt "NpcYell:15825:0:13"
msgid "Not here, not now!"
msgstr ""

#. ja: まだ戦える！
#. de: Ich kann noch kämpfen!
#. fr: Je peux encore me battre<nbsp>!
msgctxt "NpcYell:15826:0:13"
msgid "I can still fight!"
msgstr ""

#. ja: 邪魔しないで！
#. de: Hinweg!
#. fr: Hors de mon chemin<nbsp>!
msgctxt "NpcYell:15827:0:13"
msgid "Come no closer!"
msgstr ""

#. ja: 刻むわよ！
#. de: Hier ist Schluss!
#. fr: Tu vas souffrir<nbsp>!
msgctxt "NpcYell:15828:0:13"
msgid "You shall fall soon enough!"
msgstr ""

#. ja: 仕留める！
#. de: Schluss jetzt!
#. fr: C'est terminé<nbsp>!
msgctxt "NpcYell:15829:0:13"
msgid "It's all over now!"
msgstr ""

#. ja: 派手にいくわよ！
#. de: Jetzt mache ich Ernst!
#. fr: Ça va faire très mal<nbsp>!
msgctxt "NpcYell:15830:0:13"
msgid "Let's give them a show!"
msgstr ""

#. ja: 限界だって<br>超えてみせるわ！
#. de: Jetzt zeige ich euch, wozu ich imstande bin!
#. fr: Je vais me surpasser<nbsp>!
msgctxt "NpcYell:15831:0:13"
msgid "There'll be nothing left of you but a smoking crater!"
msgstr ""

#. ja: 見切ったァ！
#. de: Spür meine Klinge!
#. fr: Hors de ma vue<nbsp>!
msgctxt "NpcYell:15832:0:13"
msgid "I have you!"
msgstr ""

#. ja: この一太刀に<br>賭けるでござる！
#. de: Die Seele des Kriegers!
#. fr: Mon sabre ne m'a jamais trahi<nbsp>!
msgctxt "NpcYell:15833:0:13"
msgid "This blow shall end you!"
msgstr ""

#. ja: ドマ侍の意地を見よッ！
#. de: SO kämpft ein Samurai!
#. fr: Craignez l'esprit des samouraïs domiens<nbsp>!
msgctxt "NpcYell:15834:0:13"
msgid "Look upon a samurai of Doma!"
msgstr ""

#. ja: 一刀入魂！
#. de: Ein Geist, ein Hieb!
#. fr: Subissez le courroux de ma lame<nbsp>!
msgctxt "NpcYell:15835:0:13"
msgid "With soul and steel!"
msgstr ""

#. ja: 不覚でござった…！
#. de: Meine Konzentration war unzureichend<nbsp>...!
#. fr: Je ne faillirai plus<nbsp>!
msgctxt "NpcYell:15836:0:13"
msgid "Shameful..."
msgstr ""

#. ja: 斬り倒す！
#. de: Spür meine Klinge!
#. fr: Tâtez de ma lame<nbsp>!
msgctxt "NpcYell:15837:0:13"
msgid "Enough!"
msgstr ""

#. ja: 道をあけぃ！
#. de: Aus dem Weg!
#. fr: Hors de mon chemin<nbsp>!
msgctxt "NpcYell:15838:0:13"
msgid "Out of my way!"
msgstr ""

#. ja: そぉら、行くぞ！
#. de: Vorwärts!
#. fr: En avant<nbsp>!
msgctxt "NpcYell:15839:0:13"
msgid "Forward, forward!"
msgstr ""

#. ja: すみやかに散れ…！
#. de: Flieh oder stirb!
#. fr: Disparaissez<nbsp>!
msgctxt "NpcYell:15840:0:13"
msgid "Let us be about it!"
msgstr ""

#. ja: 腕前、とくと見よ！
#. de: So kämpft ein Domaner!
#. fr: Voilà comment on se bat<nbsp>!
msgctxt "NpcYell:15841:0:13"
msgid "Look well and learn!"
msgstr ""

#. ja: ちとマズイな…
#. de: Das nimmt kein gutes Ende<nbsp>...
#. fr: Ça sent le roussi...
msgctxt "NpcYell:15842:0:13"
msgid "Concentrate!"
msgstr ""

#. ja: これ以上、不甲斐ない姿は<br>見せられんな！
#. de: Nochmal erwischen sie mich nicht, das schwöre ich!
#. fr: C'est l'occasion de laver mon honneur<nbsp>!
msgctxt "NpcYell:15843:0:13"
msgid "Quite unbecoming..."
msgstr ""

#. ja: 峻厳なる山の岩のように！
#. de: Unnachgiebig wie ein Bergfels!
#. fr: Inébranlable telle la montagne<nbsp>!
msgctxt "NpcYell:15844:0:13"
msgid "Unyielding as a mountain!"
msgstr ""

#. ja: 草原を駆ける馬のように！
#. de: Schnell wie ein Pferd in der Prärie!
#. fr: Fulgurant tel le cheval au pas de course<nbsp>!
msgctxt "NpcYell:15845:0:13"
msgid "Swift as a steed!"
msgstr ""

#. ja: 草を揺らす春風のように！
#. de: Sanft wie eine Frühlingsbrise!
#. fr: Délicat tel le vent printanier<nbsp>!
msgctxt "NpcYell:15846:0:13"
msgid "Invigorating as a spring breeze!"
msgstr ""

#. ja: 折れた草も大地の恵みで…！
#. de: Die Erde gibt Kraft selbst geknickten Blumen<nbsp>...!
#. fr: Par la bénédiction de la terre nourricière<nbsp>!
msgctxt "NpcYell:15847:0:13"
msgid "By the blessing of the land!"
msgstr ""

#. ja: くっ…<br>足折れた馬のようだ…！
#. de: Ugh<nbsp>... Hilflos wie ein Pferd mit gebrochenen Beinen<nbsp>...!
#. fr: Tel le cheval... au bord de l'épuisement...
msgctxt "NpcYell:15848:0:13"
msgid "Ugh... Weak as a spent steed..."
msgstr ""

#. ja: 踏まれた草ほど<br>強くなるもの…！
#. de: Zertretenes Gras kehrt stets gestärkt zurück<nbsp>...!
#. fr: L'herbe repousse toujours sur un sol fertile<nbsp>!
msgctxt "NpcYell:15849:0:13"
msgid "Grass that is trampled grows back stronger!"
msgstr ""

#. ja: 必中！
#. de: Es gibt kein Entkommen!
#. fr: En plein dans le mille<nbsp>!
msgctxt "NpcYell:15850:0:13"
msgid "Now fall!"
msgstr ""

#. ja: 印を結びて神秘と成す！
#. de: Kraft der Mudras!
#. fr: Par le pouvoir des shinobi<nbsp>!
msgctxt "NpcYell:15851:0:13"
msgid "The weave of a shinobi's power!"
msgstr ""

#. ja: 始末するっ！
#. de: Das übernehm ich!
#. fr: Laissez-moi faire<nbsp>!
msgctxt "NpcYell:15852:0:13"
msgid "Leave this to me!"
msgstr ""

#. ja: お前を討つ！
#. de: Du bist tot!
#. fr: J'aurai ta vie<nbsp>!
msgctxt "NpcYell:15853:0:13"
msgid "This day you die!"
msgstr ""

#. ja: 頂戴する！
#. de: Du gehörst mir!
#. fr: Je l'aurai<nbsp>!
msgctxt "NpcYell:15854:0:13"
msgid "I will not be denied!"
msgstr ""

#. ja: 耐えてみせる！
#. de: Bloß<nbsp>... ein Kratzer<nbsp>...
#. fr: Je tiendrai bon<nbsp>!
msgctxt "NpcYell:15855:0:13"
msgid "It...it is nothing."
msgstr ""

#. ja: もう…倒れてなるものか！
#. de: Es wäre eine Schande, erneut zu fallen!
#. fr: Hors de question d'abandonner maintenant<nbsp>!
msgctxt "NpcYell:15856:0:13"
msgid "I won't fall again!"
msgstr ""

#. ja: いざ、勝負！
#. de: In den Kampf!
#. fr: En garde<nbsp>!
msgctxt "NpcYell:15857:0:13"
msgid "On your guard!"
msgstr ""

#. ja: とくと見よ！
#. de: Blinzel lieber nicht!
#. fr: Voilà pour vous<nbsp>!
msgctxt "NpcYell:15858:0:13"
msgid "Bear witness!"
msgstr ""

#. ja: 斬り捨てる！
#. de: Du bist so gut wie tot!
#. fr: Vous allez finir en morceaux<nbsp>!
msgctxt "NpcYell:15859:0:13"
msgid "It's over!"
msgstr ""

#. ja: ドマを…我らの手に！
#. de: Doma gehört den Domanern!
#. fr: Doma aux Domiens<nbsp>!
msgctxt "NpcYell:15860:0:13"
msgid "Doma belongs to Domans!"
msgstr ""

#. ja: 我が全霊をかけて！
#. de: Mit ganzem Herzen in einen Angriff!
#. fr: Sincérité et noblesse d'âme<nbsp>!
msgctxt "NpcYell:15861:0:13"
msgid "With all my being!"
msgstr ""

#. ja: まだ、膝はつかない…！
#. de: Ich werde<nbsp>... nicht fallen<nbsp>...
#. fr: Je suis... encore debout<nbsp>!
msgctxt "NpcYell:15862:0:13"
msgid "I will not yield!"
msgstr ""

#. ja: かたじけない…
#. de: Habt Dank<nbsp>...
#. fr: Merci, je me montrerai digne de votre confiance<nbsp>!
msgctxt "NpcYell:15863:0:13"
msgid "Forgive me..."
msgstr ""

#. ja: さあ、ゆくぞ！
#. de: Auf mich ist Verlass!
#. fr: Je suis à vos côtés<nbsp>!
msgctxt "NpcYell:15864:0:13"
msgid "Right, then!"
msgstr ""

#. ja: 畳み掛ける！
#. de: Keine Zurückhaltung!
#. fr: Donnez tout ce que vous avez<nbsp>!
msgctxt "NpcYell:15865:0:13"
msgid "No holding back!"
msgstr ""

#. ja: 治癒しようぞ！
#. de: Lasst mich eure Wunden heilen!
#. fr: Laissez-moi panser vos plaies<nbsp>!
msgctxt "NpcYell:15866:0:13"
msgid "I will heal your wounds!"
msgstr ""

#. ja: 勝利のために…！
#. de: Für den Sieg<nbsp>...!
#. fr: La victoire sera nôtre<nbsp>!
msgctxt "NpcYell:15867:0:13"
msgid "For victory!"
msgstr ""

#. ja: ここで倒れては…
#. de: Nein<nbsp>... es darf so nicht enden<nbsp>...
#. fr: Non... Pas si près du but...
msgctxt "NpcYell:15868:0:13"
msgid "I cannot fall here..."
msgstr ""

#. ja: 不甲斐ない…！
#. de: Verzeiht meine Unvorsicht<nbsp>...!
#. fr: Je ne me ferai plus avoir<nbsp>!
msgctxt "NpcYell:15869:0:13"
msgid "I will do better!"
msgstr ""

#. ja: 任せてください！
#. de: Überlasst die Führung mir!
#. fr: À nous de jouer<nbsp>!
msgctxt "NpcYell:15870:0:13"
msgid "I'll take care of this!"
msgstr ""

#. ja: 邪魔はさせない…
#. de: Niemand hält mich auf!
#. fr: Rentrez chez vous<nbsp>!
msgctxt "NpcYell:15871:0:13"
msgid "Oh no you don't!"
msgstr ""

#. ja: 渾身の力をこめて！
#. de: Spüre meine ganze Kraft<nbsp>...!
#. fr: Pleine puissance<nbsp>!
msgctxt "NpcYell:15872:0:13"
msgid "Rhalgr grant me strength!"
msgstr ""

#. ja: 先行します…！
#. de: Mir nach<nbsp>...!
#. fr: Je prends les devants<nbsp>!
msgctxt "NpcYell:15873:0:13"
msgid "With me!"
msgstr ""

#. ja: 意地を見せますよ…！
#. de: Mein Wille ist unverwundbar!
#. fr: Ma détermination est in<shy>é<shy>bran<shy>la<shy>ble<nbsp>!
msgctxt "NpcYell:15874:0:13"
msgid "I won't let you down!"
msgstr ""

#. ja: 戦闘に復帰します！
#. de: Zurück in den Kampf!
#. fr: Je n'ai pas dit mon dernier mot<nbsp>!
msgctxt "NpcYell:15875:0:13"
msgid "Back to the fight!"
msgstr ""

#. ja: ほら、いくよ！
#. de: Jetzt komme ich!
#. fr: Poussez-vous, me voilà<nbsp>!
msgctxt "NpcYell:15876:0:13"
msgid "Here I go!"
msgstr ""

#. ja: 手は緩めない！
#. de: Nicht nachlassen!
#. fr: Ça fait mal, hein<nbsp>?
msgctxt "NpcYell:15877:0:13"
msgid "Swift and sure!"
msgstr ""

#. ja: 決めてみせる！
#. de: Und der Gnadenstoß!
#. fr: Voilà le coup final<nbsp>!
msgctxt "NpcYell:15878:0:13"
msgid "No mistakes!"
msgstr ""

#. ja: 攻撃の手は緩めない！
#. de: Dranbleiben, zeigt keine Nachsicht!
#. fr: Oh là là, ça fait très très mal, ça<nbsp>!
msgctxt "NpcYell:15879:0:13"
msgid "All or nothing!"
msgstr ""

#. ja: アラミゴを…<br>私たちの悲願を！
#. de: Sowohl Ala Mhigo<nbsp>... Als auch wir werden frei sein!
#. fr: Ala Mhigo est à nous pour toujours<nbsp>!
msgctxt "NpcYell:15880:0:13"
msgid "For Ala Mhigo!"
msgstr ""

#. ja: 挫けてたまるか！
#. de: Als ob ich jetzt aufgeben würde!
#. fr: Je ne capitulerai pas<nbsp>!
msgctxt "NpcYell:15881:0:13"
msgid "I'm not finished yet!"
msgstr ""

#. ja: さあ、仕切り直しだ！
#. de: Auf ein Neues!
#. fr: Allez, c'est reparti<nbsp>!
msgctxt "NpcYell:15882:0:13"
msgid "Right, let's try this again!"
msgstr ""

#. ja: 叩き斬る！
#. de: Ich hack dich in Stücke!
#. fr: Je vais te tailler en pièces<nbsp>!
msgctxt "NpcYell:15883:0:13"
msgid "Down!"
msgstr ""

#. ja: これが猛牛流よ！
#. de: Der Bulle von Ala Mhigo!
#. fr: La charge du taureau<nbsp>!
msgctxt "NpcYell:15884:0:13"
msgid "As a raging bull!"
msgstr ""

#. ja: 燃え上がれ！
#. de: Lodernder Zorn!
#. fr: Brûle en enfer<nbsp>!
msgctxt "NpcYell:15885:0:13"
msgid "The flames rise!"
msgstr ""

#. ja: さあ猛ろ！<br>呪剣ティソーナよッ！
#. de: Tizona, entfessle deinen Zorn!
#. fr: Embrase-toi, Tizona<nbsp>!
msgctxt "NpcYell:15886:0:13"
msgid "Roar, Tizona!"
msgstr ""

#. ja: 吾輩が押されている！？
#. de: Langsam wird's spannend!
#. fr: Moi, surpassé<nbsp>!?<nbsp>...
msgctxt "NpcYell:15887:0:13"
msgid "Not bad..."
msgstr ""

#. ja: 無様な姿は見せられぬ！
#. de: Ich lasse mir meine Ehre nicht erneut nehmen!
#. fr: Le taureau ne courbera plus l'échine<nbsp>!
msgctxt "NpcYell:15888:0:13"
msgid "I will redeem myself!"
msgstr ""

#. ja: 喰らえ！
#. de: Wie schmeckt dir das?!
#. fr: Mange ça<nbsp>!
msgctxt "NpcYell:15889:0:13"
msgid "Try this!"
msgstr ""

#. ja: 決めてみせる！
#. de: Dieser Kampf ist vorbei!
#. fr: C'est l'heure du coup de grâce<nbsp>!
msgctxt "NpcYell:15890:0:13"
msgid "Leave it to me!"
msgstr ""

#. ja: アバ、オリ、見ていてくれよ！
#. de: A'aba, Aulie, wacht über mich!
#. fr: A'aba, Aulie<nbsp>! Celle-là est pour vous<nbsp>!
msgctxt "NpcYell:15891:0:13"
msgid "For A'aba and Aulie!"
msgstr ""

#. ja: やってやるさ！
#. de: Und noch eins!
#. fr: Et pan, dans les dents<nbsp>!
msgctxt "NpcYell:15892:0:13"
msgid "Down with you!"
msgstr ""

#. ja: 倒れてなるものか…！
#. de: Ich werde nicht fallen!
#. fr: Je résisterai jusqu'au bout<nbsp>!
msgctxt "NpcYell:15893:0:13"
msgid "Getting a bit winded..."
msgstr ""

#. ja: ここで散りなさい！
#. de: Jetzt reicht's mir!
#. fr: Hors de ma vue<nbsp>!
msgctxt "NpcYell:15894:0:13"
msgid "Fall!"
msgstr ""

#. ja: 荒っぽくいかせてもらいますよ
#. de: Zeit für die schweren Geschütze!
#. fr: Attention, ça va barder<nbsp>!
msgctxt "NpcYell:15895:0:13"
msgid "I hope you like it rough."
msgstr ""

#. ja: これが、百鬼夜行です…！
#. de: Erlebe die Kraft der Klabauter!
#. fr: Par la force du grand kraken<nbsp>!
msgctxt "NpcYell:15896:0:13"
msgid "Feel the might of the Kraken!"
msgstr ""

#. ja: 容赦はしません！
#. de: Kein Erbarmen!
#. fr: Pas de quartier<nbsp>!
msgctxt "NpcYell:15897:0:13"
msgid "No quarter!"
msgstr ""

#. ja: これは…参りましたね…
#. de: Es ging mir<nbsp>... schon mal besser<nbsp>...
#. fr: Il me reste encore des forces<nbsp>!
msgctxt "NpcYell:15898:0:13"
msgid "Quite a bind..."
msgstr ""

#. ja: ぶっとばしてやらぁッ！
#. de: Du bist erledigt!
#. fr: J'vais t'envoyer valdinguer<nbsp>!
msgctxt "NpcYell:15899:0:13"
msgid "Now I'll show you!"
msgstr ""

#. ja: オレの全力、見せてやる！
#. de: Ich kann auch anders!
#. fr: Ouvrez grand les mirettes<nbsp>!
msgctxt "NpcYell:15900:0:13"
msgid "You haven't seen anything yet!"
msgstr ""

#. ja: 東方で勝機を掴むため<br>立ち止まってはいられない！
#. de: Wenn wir im Osten einen Sieg erlangen wollen, dürfen wir hier keine Zeit verlieren!
#. fr: Personne ne nous barrera la route vers l'Orient<nbsp>!
msgctxt "NpcYell:15901:0:13"
msgid "Nothing's going to stop us from getting to the Far East!"
msgstr ""

#. ja: 私の船で<br>勝手はさせません
#. de: Auf meinem Schiff herrscht Ordnung!
#. fr: Je ne vous laisserai pas mettre mon bateau sens dessus dessous<nbsp>!
msgctxt "NpcYell:15902:0:13"
msgid "I'll not suffer troublemakers aboard my ship."
msgstr ""

#. ja: 東方で勝機を掴むため<br>立ち止まってはいられない！
#. de: Wenn wir im Osten einen Sieg erlangen wollen, dürfen wir hier keine Zeit verlieren!
#. fr: Personne ne nous barrera la route vers l'Orient<nbsp>!
msgctxt "NpcYell:15903:0:13"
msgid "Nothing's going to stop us from getting to the Far East!"
msgstr ""

#. ja: 敵の気配がウヨウヨするよ
#. de: Ich spüre unzählige Bestien um uns<nbsp>...
#. fr: On dirait que ça grouille d'ennemis par ici...
msgctxt "NpcYell:15904:0:13"
msgid "Not the most welcoming place..."
msgstr ""

#. ja: 回復するわ！
#. de: Ich kümmere mich darum!
#. fr: Je m'occupe des soins<nbsp>!
msgctxt "NpcYell:15905:0:13"
msgid "You need healing!"
msgstr ""

#. ja: ぶ、不気味な島だね…
#. de: W-Welch ungeheuerliche Insel<nbsp>...
#. fr: Quelle atmosphère inquiétante sur cette île...
msgctxt "NpcYell:15906:0:13"
msgid "I shudder to imagine what awaits here..."
msgstr ""

#. ja: 殴って倒せる相手なら<br>怖くないって！
#. de: Kein Grund zur Angst! Wir erledigen alle Monster einfach wie immer!
#. fr: Tant que je peux taper dedans, rien ne me fait peur<nbsp>!
msgctxt "NpcYell:15907:0:13"
msgid "If we can punch them, we can deal with them!"
msgstr ""

#. ja: ほう、死霊のようですね…
#. de: Ho, ein waschechtes Gespenst<nbsp>...
#. fr: Un mort-vivant<nbsp>!? On aura tout vu...
msgctxt "NpcYell:15908:0:13"
msgid "Well, well, a ghost..."
msgstr ""

#. ja: 手早くやっつけるわよ！
#. de: Damit machen wir kurzen Prozess!
#. fr: On va lui faire sa fête en moins de deux<nbsp>!
msgctxt "NpcYell:15909:0:13"
msgid "Let's not waste any time!"
msgstr ""

#. ja: ほう、死霊のようですね…
#. de: Ho, ein waschechtes Gespenst<nbsp>...
#. fr: Un mort-vivant<nbsp>!? On aura tout vu...
msgctxt "NpcYell:15910:0:13"
msgid "Well, well, a ghost..."
msgstr ""

#. ja: 手早くやっつけるわよ！
#. de: Damit machen wir kurzen Prozess!
#. fr: On va lui faire sa fête en moins de deux<nbsp>!
msgctxt "NpcYell:15911:0:13"
msgid "Let's not waste any time!"
msgstr ""

#. ja: この程度のものですか…
#. de: Mehr hatte es scheinbar nicht zu bieten<nbsp>...
#. fr: Plus effrayant que coriace, au fond...
msgctxt "NpcYell:15912:0:13"
msgid "All fright and no fight."
msgstr ""

#. ja: これで終わり？
#. de: War das schon alles?
#. fr: Je vous l'avais dit, en moins de deux<nbsp>!
msgctxt "NpcYell:15913:0:13"
msgid "Is it over?"
msgstr ""

#. ja: これで終わり？
#. de: War das schon alles?
#. fr: Je vous l'avais dit, en moins de deux<nbsp>!
msgctxt "NpcYell:15914:0:13"
msgid "Is it over?"
msgstr ""

#. ja: 船を引き寄せた元凶が<br>この程度とは思えません
#. de: Ich bezweifle, dass, wer auch immer uns hierhergeführt hat, sich so leicht bezwingen lassen wird.
#. fr: Restez sur vos gardes, nous ne sommes cer<shy>tai<shy>ne<shy>ment pas au bout de nos peines...
msgctxt "NpcYell:15915:0:13"
msgid "Far from it. Whatever brought us here wouldn't fall so easily."
msgstr ""

#. ja: 派手な演出じゃない！
#. de: Was für ein Schauspiel!
#. fr: Ça alors, quel spectacle<nbsp>!
msgctxt "NpcYell:15916:0:13"
msgid "That's quite a spectacle!"
msgstr ""

#. ja: ゆ、幽霊船！？
#. de: E-Ein G-Geisterschiff!?
#. fr: Un... Un bateau fantôme<nbsp>!?
msgctxt "NpcYell:15917:0:13"
msgid "A gh-ghost ship!?"
msgstr ""

#. ja: ゆ、幽霊船！？
#. de: E-Ein G-Geisterschiff!?
#. fr: Un... Un bateau fantôme<nbsp>!?
msgctxt "NpcYell:15918:0:13"
msgid "A gh-ghost ship!?"
msgstr ""

#. ja: 難破船に死霊が憑依した…<br>といったところでしょう
#. de: Wohl eher Geister, welche sich in einem Wrack eingenistet haben.
#. fr: Après avoir vogué à la dérive, il est passé de l'autre côté de la vie...
msgctxt "NpcYell:15919:0:13"
msgid "Quite literally."
msgstr ""

#. ja: しっかりしてちょうだい…！
#. de: Noch ist es nicht vorbei!
#. fr: Un peu de nerf<nbsp>!
msgctxt "NpcYell:15920:0:13"
msgid "Be strong."
msgstr ""

#. ja: くっ…！<br>魔法が効く相手なら！
#. de: S-Solange meine Magie gegen sie wirkt<nbsp>...!
#. fr: Zut... Voyons voir si vous résistez à ma magie<nbsp>!
msgctxt "NpcYell:15921:0:13"
msgid "S-So long as my spells work..."
msgstr ""

#. ja: 難破したのは<br>はるか昔のようです
#. de: Ein Wrack, welches schon lange Zeit hier zu sein scheint.
#. fr: Ce bateau semble avoir été abandonné il y a une éternité...
msgctxt "NpcYell:15922:0:13"
msgid "It appears to have been adrift for a while."
msgstr ""

#. ja: 乗ってるのは<br>乗組員の幽霊ってこと？
#. de: Sind dies möglicherweise die Geister der ehemaligen Besatzung?
#. fr: Pas tant que ça, vu tous les fantômes qui s'y baladent<nbsp>!
msgctxt "NpcYell:15923:0:13"
msgid "Is that the crew?"
msgstr ""

#. ja: また死霊ですか…
#. de: Noch ein Gespenst<nbsp>...
#. fr: Encore un mort-vivant... Jamais deux sans trois, dans ce cas<nbsp>?
msgctxt "NpcYell:15924:0:13"
msgid "Yet another ghost."
msgstr ""

#. ja: お、恐れるものか！
#. de: Ha! D-Das macht mir gar nichts aus!
#. fr: M-m-même pas peur<nbsp>!
msgctxt "NpcYell:15925:0:13"
msgid "Th-That doesn't scare me!"
msgstr ""

#. ja: お、恐れるものか！
#. de: Ha! D-Das macht mir gar nichts aus!
#. fr: M-m-même pas peur<nbsp>!
msgctxt "NpcYell:15926:0:13"
msgid "Th-That doesn't scare me!"
msgstr ""

#. ja: 死霊と言えど、もとは人…<br>討ち倒せばいいだけです
#. de: Auch Gespenster sind nicht unverwundbar<nbsp>... Auf in den Kampf.
#. fr: Abrégeons les souffrances de ce pauvre hère demeuré vivant par-delà la mort...
msgctxt "NpcYell:15927:0:13"
msgid "And so it shouldn't. Ghosts are but men trapped in purgatory."
msgstr ""

#. ja: 死者の魂に<br>安らぎあらんことを…
#. de: Mögen ihre Seelen in Frieden ruhen <nbsp>...
#. fr: Que son âme repose en paix...
msgctxt "NpcYell:15928:0:13"
msgid "May the dead know peace."
msgstr ""

#. ja: やった…！<br>やったぞ！
#. de: Geschafft<nbsp>...! Wir haben es geschafft!
#. fr: On l'a eu<nbsp>! Bien joué, tout le monde<nbsp>!
msgctxt "NpcYell:15929:0:13"
msgid "We...we did it!"
msgstr ""

#. ja: やった…！<br>やったぞ！
#. de: Geschafft<nbsp>...! Wir haben es geschafft!
#. fr: On l'a eu<nbsp>! Bien joué, tout le monde<nbsp>!
msgctxt "NpcYell:15930:0:13"
msgid "We...we did it!"
msgstr ""

#. ja: 死者の魂に<br>安らぎあらんことを…
#. de: Mögen ihre Seelen in Frieden ruhen <nbsp>...
#. fr: Que son âme repose en paix...
msgctxt "NpcYell:15931:0:13"
msgid "May the dead know peace."
msgstr ""

#. ja: 出し惜しみはナシだッ！
#. de: Ich halte nichts zurück!
#. fr: Bouffe-moi donc ça<nbsp>!
msgctxt "NpcYell:15932:0:13"
msgid "No holding back!"
msgstr ""

#. ja: 見て！<br>檻がいっぱい…！
#. de: Schaut nur, so viele Käfige und Zellen<nbsp>...!
#. fr: Regardez toutes ces cages<nbsp>! C'est une véritable prison à ciel ouvert<nbsp>!
msgctxt "NpcYell:15933:0:13"
msgid "A dungeon!"
msgstr ""

#. ja: 見て！<br>檻がいっぱい…！
#. de: Schaut nur, so viele Käfige und Zellen<nbsp>...!
#. fr: Regardez toutes ces cages<nbsp>! C'est une véritable prison à ciel ouvert<nbsp>!
msgctxt "NpcYell:15934:0:13"
msgid "A dungeon!"
msgstr ""

#. ja: なるほど、ここは<br>監獄島だったようですね…
#. de: Ich verstehe, dies muss wohl eine Gefängnisinsel gewesen sein<nbsp>...
#. fr: Une chose est sûre, je ne passerai pas mes vacances ici...
msgctxt "NpcYell:15935:0:13"
msgid "It appears this was a prison isle."
msgstr ""

#. ja: この先にいるようですね<br>船を引き寄せた元凶が…
#. de: Die Macht, die uns hergeführt hat, scheint hier ihren Ursprung zu haben<nbsp>...
#. fr: Nous approchons de la source de tout ce malheur, je le sens...
msgctxt "NpcYell:15936:0:13"
msgid "I daresay we will soon meet our host."
msgstr ""

#. ja: こ、これは武者震いさ…！
#. de: I-Ich zittere nur aus Vorfreude!
#. fr: J-j-j'en tremble d'excitation<nbsp>!
msgctxt "NpcYell:15937:0:13"
msgid "I-I'm not afraid! M-Merely excited!"
msgstr ""

#. ja: この先にいるようですね<br>船を引き寄せた元凶が…
#. de: Die Macht, die uns hergeführt hat, scheint hier ihren Ursprung zu haben<nbsp>...
#. fr: Nous approchons de la source de tout ce malheur, je le sens...
msgctxt "NpcYell:15938:0:13"
msgid "I daresay we will soon meet our host."
msgstr ""

#. ja: こ、これは武者震いさ…！
#. de: I-Ich zittere nur aus Vorfreude!
#. fr: J-j-j'en tremble d'excitation<nbsp>!
msgctxt "NpcYell:15939:0:13"
msgid "I-I tremble for the anticipation!"
msgstr ""

#. ja: セイレーン伝説の正体…<br>暴いてやりましょう
#. de: Eine echte Sirene<nbsp>... Dann wollen wir mal!
#. fr: La légende avait donc un fond de vérité...
msgctxt "NpcYell:15940:0:13"
msgid "So this is the source of the legend."
msgstr ""

#. ja: あれは…死したセイレーンの<br>死霊だとでも…！？
#. de: Heißt das etwa<nbsp>... Dies ist der Geist einer verstorbenen Sirene<nbsp>...!?
#. fr: Je... Je ne rêve pas, c'est bien le fantôme d'une sirène<nbsp>!?
msgctxt "NpcYell:15941:0:13"
msgid "Is that the ghost of a siren!?"
msgstr ""

#. ja: あれは…死したセイレーンの<br>死霊だとでも…！？
#. de: Heißt das etwa<nbsp>... Dies ist der Geist einer verstorbenen Sirene<nbsp>...!?
#. fr: Je... Je ne rêve pas, c'est bien le fantôme d'une sirène<nbsp>!?
msgctxt "NpcYell:15942:0:13"
msgid "Is that the ghost of a siren!?"
msgstr ""

#. ja: セイレーン伝説の正体<br>見たり、ですね
#. de: Das ist also die Wahrheit hinter der Legende der Sirenen.
#. fr: La légende avait donc un fond de vérité...
msgctxt "NpcYell:15943:0:13"
msgid "And the source of the legend, 'twould seem."
msgstr ""

#. ja: 伝説の英雄が歩んだ道か…<br>気合い入れていこう！
#. de: Diesen Pfad beschritten schon die Helden von einst<nbsp>... Lasst uns ihnen keine Schande bereiten!
#. fr: Le chemin jalonné par les héros, hein... Voyons un peu ce que ça vaut<nbsp>!
msgctxt "NpcYell:15944:0:13"
msgid "So this is the hero's path... Let's prove ourselves worthy!"
msgstr ""

#. ja: ゆくぞ！<br>此度、覇道を進むは我らなり！
#. de: Auf, lasst uns den Weg des Kriegers beschreiten!
#. fr: En avant<nbsp>! La fortune sourit toujours aux guerriers valeureux<nbsp>!
msgctxt "NpcYell:15945:0:13"
msgid "This day, we shall be warriors born anew!"
msgstr ""

#. ja: 応ッ！
#. de: Zu Befehl!
#. fr: Toujours, Mon Seigneur<nbsp>!
msgctxt "NpcYell:15946:0:13"
msgid "Hear, hear!"
msgstr ""

#. ja: 小手調べといったところか
#. de: Scheint, als gäbe man uns die Gelegenheit, uns aufzuwärmen.
#. fr: Un petit échauf<shy>fe<shy>ment contre du menu fretin, pourquoi pas après tout<nbsp>!
msgctxt "NpcYell:15947:0:13"
msgid "Nice of them to afford us the chance to limber up."
msgstr ""

#. ja: まずは、ひとつ突破！
#. de: Und fertig, kein Problem!
#. fr: Pas la peine de tergiverser, on passe en force<nbsp>!
msgctxt "NpcYell:15948:0:13"
msgid "One test down!"
msgstr ""

#. ja: 油断は禁物<br>まだ序の口であろう
#. de: Dies war lediglich der Anfang. Bleibt stets auf der Hut.
#. fr: Ne sous-estimez pas nos ennemis, ils ont plus d'un tour dans leur sac...
msgctxt "NpcYell:15949:0:13"
msgid "There is no telling what awaits. Let us remain vigilant."
msgstr ""

#. ja: 獣の群れが<br>相手ってわけ！？
#. de: Eine Herde wildgewordener Tiere!?
#. fr: Un... troupeau de bêtes<nbsp>?
msgctxt "NpcYell:15950:0:13"
msgid "A herd of beasts!?"
msgstr ""

#. ja: どうやら、あの群れが<br>試練の相手のようでござるな
#. de: Es scheint, als sei diese Herde unsere nächste Heraus<shy>forde<shy>rung.
#. fr: Ces bêtes font assurément partie de l'épreuve...
msgctxt "NpcYell:15951:0:13"
msgid "It appears these beasts are our next test."
msgstr ""

#. ja: 見よ、あの群れのヌシを！<br>不敵な面構えではないか！
#. de: Seht, dieser Bulle ist sicher ihr Anführer! Und er wirkt nicht gerade gut gelaunt.
#. fr: Voilà leur chef<nbsp>! Attention, il a l'air de vouloir en découdre<nbsp>!
msgctxt "NpcYell:15952:0:13"
msgid "No mistaking who the leader is."
msgstr ""

#. ja: とんでもない突進だったね…
#. de: Stürmen konnte der Gute, alle Achtung!
#. fr: Quelle charge foudroyante...
msgctxt "NpcYell:15953:0:13"
msgid "That fellow knew how to charge..."
msgstr ""

#. ja: あの突進には<br>驚かされたな！
#. de: Ich bin jetzt noch außer Atem<nbsp>...
#. fr: J'ai bien failli être emporté plus d'une fois<nbsp>!
msgctxt "NpcYell:15954:0:13"
msgid "That creature was utterly fearless."
msgstr ""

#. ja: 天晴れな<br>戦いぶりでござった！
#. de: Ein wahrer Krieger, durch und durch.
#. fr: Il s'est admirablement battu... Il mérite notre respect<nbsp>!
msgctxt "NpcYell:15955:0:13"
msgid "Aye, a warrior in its own right."
msgstr ""

#. ja: 草原の只中に<br>かような場所があるとは！
#. de: Das solch ein Ort inmitten der Steppe existieren würde<nbsp>...!
#. fr: Un endroit pareil au beau milieu d'une plaine, qui l’eût cru<nbsp>?
msgctxt "NpcYell:15956:0:13"
msgid "That such a place should exist in the Steppe!"
msgstr ""

#. ja: さすがは草原の聖地…<br>気が引き締まる思いだ！
#. de: Zweifellos, wir befinden uns an einem heiligen Ort.
#. fr: Nous nous trouvons sur une terre sacrée... La tension monte<nbsp>!
msgctxt "NpcYell:15957:0:13"
msgid "You truly get the sense that this is sacred ground."
msgstr ""

#. ja: なんだかゾクゾクしてきた…！
#. de: Da bekommt man direkt Gänsehaut<nbsp>...!
#. fr: J'en ai des frissons partout, hi hi<nbsp>!
msgctxt "NpcYell:15958:0:13"
msgid "Indeed! Gives me chills just to be here!"
msgstr ""

#. ja: わわっ！<br>岩がゴーレムに！
#. de: W-Was zum<nbsp>...! Ein Golem!?
#. fr: Aaah<nbsp>!! Le rocher... Il s'est transformé en golems<nbsp>!
msgctxt "NpcYell:15959:0:13"
msgid "Uwaaah! A golem!?"
msgstr ""

#. ja: むう、巨岩が兵に！？
#. de: Der Stein selbst ist ein Kämpfer!?
#. fr: Qu'est-ce donc que cette sorcellerie<nbsp>!?
msgctxt "NpcYell:15960:0:13"
msgid "The stone is alive! What sorcery is this!?"
msgstr ""

#. ja: 見事な絡繰りよな！
#. de: Wahrlich eine fantastische Schöpfung!
#. fr: Quelle souplesse remarquable<nbsp>!
msgctxt "NpcYell:15961:0:13"
msgid "Whatever it is, it's ingenious!"
msgstr ""

#. ja: ずいぶんと<br>大きな相手でござるな
#. de: Sein Körper ragt bis hoch in den Himmel!
#. fr: Enfin un adversaire plus grand que moi<nbsp>!
msgctxt "NpcYell:15962:0:13"
msgid "What an enormous foe!"
msgstr ""

#. ja: 両の手にあるは<br>判子か大鎚か…
#. de: Was hat er da in seinen Händen? Stempel? Oder Hämmer?
#. fr: Qu'est-ce qu'il tient dans ses mains<nbsp>? Un marteau géant<nbsp>?
msgctxt "NpcYell:15963:0:13"
msgid "Are those seals or hammers in its hands?"
msgstr ""

#. ja: どんな戦いになるんだろう…！
#. de: Welches es auch sein mag, dies wird sicherlich ein interessanter Kampf<nbsp>...
#. fr: J'ai pas spé<shy>cia<shy>le<shy>ment envie de connaître la réponse<nbsp>!
msgctxt "NpcYell:15964:0:13"
msgid "Why not both?"
msgstr ""

#. ja: やれやれ<br>忙しい試練でござったな
#. de: Fürwahr eine äußerst hektische Prüfung<nbsp>...
#. fr: Ouf... C'était pas de tout repos<nbsp>!
msgctxt "NpcYell:15965:0:13"
msgid "Whew, such a scramble that was..."
msgstr ""

#. ja: お、終わってくれた…？<br>まだ頭がこんがらかってるよ
#. de: S-Sind wir fertig<nbsp>...? In meinem Kopf dreht sich noch alles.
#. fr: Vous êtes sûrs que c'est fini<nbsp>? On dirait que sa tête bouge encore...
msgctxt "NpcYell:15966:0:13"
msgid "Is it over...? My head's spinning something fierce."
msgstr ""

#. ja: 戦場における判断力を<br>試す仕掛けであろうな
#. de: Scheinbar wollte man testen, ob wir auch im hitzigen Gefecht den Überblick nicht verlieren.
#. fr: Son but était de tester notre jugement dans le feu de l'action, et nous avons passé son épreuve haut la main<nbsp>!
msgctxt "NpcYell:15967:0:13"
msgid "It seems that was a test of judgment in the heat of battle."
msgstr ""

#. ja: 篝火の熱が<br>ありがたいでござる
#. de: Die Wärme dieser Fackeln kommt jetzt gerade recht.
#. fr: Ça fait toujours du bien de se réchauffer près d'un feu<nbsp>!
msgctxt "NpcYell:15968:0:13"
msgid "After that dip, I'm glad for the warmth of the torches."
msgstr ""

#. ja: 気持ちよかったー！
#. de: Die kurze Abkühlung hat echt gutgetan!
#. fr: J'ai retrouvé toute ma pêche<nbsp>!
msgctxt "NpcYell:15969:0:13"
msgid "Ahhh, that was refreshing!"
msgstr ""

#. ja: ふむ…<br>また雰囲気が変わったな
#. de: Und wieder ändert sich unsere Umgebung<nbsp>...
#. fr: L'épreuve est riche en sensations variées...
msgctxt "NpcYell:15970:0:13"
msgid "A cavern now... This is turning out to be quite a tour."
msgstr ""

#. ja: 扉の奥で<br>行き止まりみたいだね…！
#. de: Hinter dem Tor scheint nichts als eine Sackgasse zu warten<nbsp>...
#. fr: La porte mène à un cul-de-sac, on dirait...
msgctxt "NpcYell:15971:0:13"
msgid "A cavernous space behind a portentous gate... This ought to be good!"
msgstr ""

#. ja: この鳥の意匠…
#. de: Diese Vogelstatuen<nbsp>...
#. fr: La forme de cet oiseau...
msgctxt "NpcYell:15972:0:13"
msgid "This bird motif..."
msgstr ""

#. ja: いよいよ<br>ヨルの根城というわけか！
#. de: Hier ist also der Haupt-Nistplatz der Yol!
#. fr: Le repaire des yols n'est plus très loin<nbsp>!
msgctxt "NpcYell:15973:0:13"
msgid "I daresay we are come to the yol's nest!"
msgstr ""

#. ja: 聖地の最奥に<br>着いたようでござるな…
#. de: Es scheint, als hätten wir unser Ziel erreicht<nbsp>...
#. fr: Nous voilà au plus profond du territoire sacré...
msgctxt "NpcYell:15974:0:13"
msgid "'Twould seem we've reached the path's end."
msgstr ""

#. ja: どうやら、最後の試練らしい…！
#. de: Die letzte Prüfung liegt vor uns!
#. fr: L'heure de la dernière épreuve a sonné<nbsp>!
msgctxt "NpcYell:15975:0:13"
msgid "This is it, my friends─the final test!"
msgstr ""

#. ja: あれが、ヨル…？
#. de: Das ist ein Yol<nbsp>...?
#. fr: Un... yol<nbsp>!?
msgctxt "NpcYell:15976:0:13"
msgid "So that's a yol!"
msgstr ""

#. ja: 邪魔立てするなら<br>斬り伏せるのみ！
#. de: Ich werde jeden niederstrecken, der sich uns in den Weg stellt.
#. fr: Tous ceux qui oseront nous barrer la route le payeront de leur vie<nbsp>!
msgctxt "NpcYell:15977:0:13"
msgid "All who bar our way shall taste my steel!"
msgstr ""

#. ja: やあやあ、我こそは<br>ドマの侍大将…
#. de: Ich bin Gosetsu, Samurai-General aus Doma! Höchst erfreut!
#. fr: Préparez-vous à subir la colère de Gosetsu, général samouraï de Doma<nbsp>!
msgctxt "NpcYell:15978:0:13"
msgid "I am Gosetsu, samurai of Doma─"
msgstr ""

#. ja: 名乗りなど上げている場合か！<br>ゆくぞ！
#. de: Lass das, wir sind nicht zu Besuch hier!
#. fr: Bats-toi d'abord, tu te présenteras après<nbsp>!
msgctxt "NpcYell:15979:0:13"
msgid "Now is not the time to be announcing yourself!"
msgstr ""

#. ja: 鉄人形ごときが<br>邪魔をするな！
#. de: Eure Metalpuppen werden uns nicht aufhalten!
#. fr: Je ne ferai qu'une bouchée de vos poupées en métal<nbsp>!
msgctxt "NpcYell:15980:0:13"
msgid "Metal toys will not stop us!"
msgstr ""

#. ja: 鉄人形ごときが邪魔をするな！
#. de: Eure Metalpuppen werden uns nicht aufhalten!
#. fr: Je ne ferai qu'une bouchée de vos poupées en métal<nbsp>!
msgctxt "NpcYell:15981:0:13"
msgid "Metal toys will not stop us!"
msgstr ""

#. ja: 撫で斬りにしてくれるわ！
#. de: Ein Hieb reicht für euch alle!
#. fr: Mon sabre va vous tailler en pièces<nbsp>!
msgctxt "NpcYell:15982:0:13"
msgid "My blade will make short work of this!"
msgstr ""

#. ja: ここの門番らしいな！
#. de: Scheint, als hätten wir einen Wächter vor uns.
#. fr: Voici le gardien des lieux, on dirait<nbsp>!
msgctxt "NpcYell:15983:0:13"
msgid "This appears to be the guardian of the gate!"
msgstr ""

#. ja: ここの門番らしいな！
#. de: Scheint, als hätten wir einen Wächter vor uns.
#. fr: Voici le gardien des lieux, on dirait<nbsp>!
msgctxt "NpcYell:15984:0:13"
msgid "This appears to be the guardian of the gate!"
msgstr ""

#. ja: 押し通るのみよ！
#. de: Der wird hier nicht mehr lange wachen!
#. fr: Il ne les gardera plus très longtemps<nbsp>!
msgctxt "NpcYell:15985:0:13"
msgid "Let us end its watch!"
msgstr ""

#. ja: よし、このまま一気に<br>本丸に攻め入ろう！
#. de: Also dann, weiter! Mit voller Kraft zum Honmaru!
#. fr: En avant toute<nbsp>! Direction le Honmaru<nbsp>!
msgctxt "NpcYell:15986:0:13"
msgid "On to the inner ward!"
msgstr ""

#. ja: よし、このまま一気に<br>本丸に攻め入ろう！
#. de: Also dann, weiter! Mit voller Kraft zum Honmaru!
#. fr: En avant toute<nbsp>! Direction le Honmaru<nbsp>!
msgctxt "NpcYell:15987:0:13"
msgid "On to the inner ward!"
msgstr ""

#. ja: 目指すは代理総督<br>ヨツユの首よ！
#. de: Yotsuyu endgültig auzuschalten ist unser Hauptziel!
#. fr: Ta tête finira bientôt au bout d'une pique, Yotsuyu<nbsp>!
msgctxt "NpcYell:15988:0:13"
msgid "We're coming for you, Yotsuyu!"
msgstr ""

#. ja: それで不意をついたつもりか！
#. de: Dachtet ihr etwa, ihr könntet mich so einfach austricksen?
#. fr: Vous ne nous aurez pas aussi facilement<nbsp>!
msgctxt "NpcYell:15989:0:13"
msgid "Is that your idea of an ambush?"
msgstr ""

#. ja: それで不意をついたつもりか！
#. de: Dachtet ihr etwa, ihr könntet mich so einfach austricksen?
#. fr: Vous ne nous aurez pas aussi facilement<nbsp>!
msgctxt "NpcYell:15990:0:13"
msgid "Is that your idea of an ambush?"
msgstr ""

#. ja: 寄らば斬る！
#. de: Kommt schon, meine Klinge ist in Hochform!
#. fr: Qui veut tâter de ma lame, hein<nbsp>?
msgctxt "NpcYell:15991:0:13"
msgid "Have at you!"
msgstr ""

#. ja: 銃撃の隙に駆け抜けよ！
#. de: Wir stoßen vor, sobald sie ihr Feuer einstellen!
#. fr: Évitez les tirs et foncez<nbsp>!
msgctxt "NpcYell:15992:0:13"
msgid "Quickly, between barrages!"
msgstr ""

#. ja: 銃撃の隙に駆け抜けよ！
#. de: Wir stoßen vor, sobald sie ihr Feuer einstellen!
#. fr: Évitez les tirs et foncez<nbsp>!
msgctxt "NpcYell:15993:0:13"
msgid "Quickly, between barrages!"
msgstr ""

#. ja: ぜぇはぁ…<br>老体に堪えるわい
#. de: \<keuch> Das ist zu viel für einen alten Mann<nbsp>...
#. fr: Pfiou... Tout ça n'est plus de mon âge...
msgctxt "NpcYell:15994:0:13"
msgid "Ugh, I'm too old for this..."
msgstr ""

#. ja: 絡繰りごときが、邪魔をするな！
#. de: Als ob euch diese technischen Spielereien etwas bringen würden!
#. fr: Allons bon, une machine maintenant<nbsp>!
msgctxt "NpcYell:15995:0:13"
msgid "Another machina to reduce to scrap metal!"
msgstr ""

#. ja: また珍妙な絡繰りが<br>出てきおった…！
#. de: Wieder so eine ungewöhnliche Maschine<nbsp>...!
#. fr: En voilà un drôle d'engin<nbsp>!
msgctxt "NpcYell:15996:0:13"
msgid "An unusual machina..."
msgstr ""

#. ja: もはや我らを<br>止められるとは思わぬことだ！
#. de: Ungewöhnlich oder nicht, uns wird hier nichts mehr aufhalten!
#. fr: Drôle ou pas, il ferait mieux de se retirer de notre chemin<nbsp>!
msgctxt "NpcYell:15997:0:13"
msgid "Unusual or no, it will fall all the same!"
msgstr ""

#. ja: さあ、城内に入るぞ！
#. de: Auf, ins Innere der Burg!
#. fr: À l'intérieur du château, au pas de course<nbsp>!
msgctxt "NpcYell:15998:0:13"
msgid "Come, let us head inside!"
msgstr ""

#. ja: さあ、城内に入るぞ！
#. de: Auf, ins Innere der Burg!
#. fr: À l'intérieur du château, au pas de course<nbsp>!
msgctxt "NpcYell:15999:0:13"
msgid "Come, let us head inside!"
msgstr ""
