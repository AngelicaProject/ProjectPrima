# NpcYell
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: この恩は忘れぬ…<br>縁あらば、また会おう!
#. de: Auch dir gilt mein Dank, Abenteurer<if $gn4>in</if>. Mögen sich unsere Wege wieder kreuzen.
#. fr: Je n'oublierai pas votre courage de sitôt, aventuri<if $gn4>ère<else>er</if><nbsp>!
#. macro: <if $gn4>daughter of<else>son of</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3000:0:13"
msgid "I thank you, <if $gn4>daughter of<else>son of</if><br>man. Your bravery will<br>not soon be forgotten."
msgstr "Благодарю тебя, <if $gn4>дочь<else>сын</if><br>земли. Твоя храбрость<br>не скоро забудется."

#. ja: 態勢を立て直してきます！<br>それまで、よろしく頼みましたよ！
#. de: Ich mach mich mal kurz frisch! Bis gleich!
#. fr: La prochaine fois, la victoire sera mienne<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3001:0:13"
msgid "I have a feeling we<br>will meet again soon!"
msgstr "Чую, скоро мы<br>снова встретимся!"

#. ja: 邪魔だ！
#. de: Aus dem Weg!
#. fr: Hors de ma vue<nbsp>!
msgctxt "NpcYell:3002:0:13"
msgid "Out of my way!"
msgstr "С дороги!"

#. ja: セイッ！
#. de: Das reicht!
#. fr: Raaah<nbsp>!
msgctxt "NpcYell:3003:0:13"
msgid "Enough!"
msgstr "Хватит!"

#. ja: 消えろ！
#. de: Verschwindet!
#. fr: Disparaissez<nbsp>!
msgctxt "NpcYell:3004:0:13"
msgid "Begone!"
msgstr "Прочь!"

#. ja: ありがと、くぽ！<br>もう、ひとりで大丈夫くぽ！
#. de: Danke, kupo! Ab hier schaff ich's alleine!
#. fr: Merci, kuppo<nbsp>! Je vous laisse, à bientôt<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3005:0:13"
msgid "Thank you! But now I<br>have to clean this<br>whole tower myself, kupo..."
msgstr "Спасибо! Но теперь мне<br>придётся самому<br>убирать всю башню, купо..."

#. ja: お願い…おじさんを助けて！
#. de: Bitte, du musst meinem Onkel helfen!
#. fr: S'il vous plaît, sauvez mon oncle<nbsp>!
msgctxt "NpcYell:3006:0:13"
msgid "I cannot watch!"
msgstr "Не могу на это смотреть!"

#. ja: 我らの真の力を見よ！
#. de: Dies ist unsere<br>wahre Kraft!
#. fr: Admire notre puissance<nbsp>!
msgctxt "NpcYell:3007:0:13"
msgid "Feel our power!"
msgstr "Почувствуйте нашу силу!"

#. ja: 竜の力、恐れるがよい！
#. de: Die Welt erzittert<br>vor der Horde!
#. fr: Les dragons sont invincibles<nbsp>!
msgctxt "NpcYell:3008:0:13"
msgid "Know our wrath!"
msgstr "Познайте нашу ярость!"

#. ja: ハァ、ハァ……ここまで来れば……。
#. de: \<keuch> ... Das sollte weit genug sein ...
#. fr: Haaa... Haaa...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3009:0:13"
msgid "\\<pant> \\<pant><br>Are we safe here...?"
msgstr ""

#. ja: クエーッ！
#. de: Kweeeh!
#. fr: Kwéééé<nbsp>!
msgctxt "NpcYell:3010:0:13"
msgid "Kweeeh!"
msgstr "Квэээ!"

#. ja: クエッ、クエッ
#. de: Kweh, kweh ...
#. fr: Kwé, kwé...
msgctxt "NpcYell:3011:0:13"
msgid "Wark..."
msgstr "Вар-р..."

#. ja: クエッ！
#. de: Kweh!
#. fr: Kwé<nbsp>!
msgctxt "NpcYell:3012:0:13"
msgid "Kweh! Kweh!"
msgstr "Квэ! Квэ!"

#. ja: 残念だったな……ここは通さぬ。
#. de: Pech, mein Kleiner! Deine Reise endet hier!
#. fr: Votre voyage s'arrête ici<nbsp>!
msgctxt "NpcYell:3013:0:13"
msgid "You will go no further, traitors."
msgstr "Дальше не пройдёте, предатели."

#. ja: 貴様ら裏切り者の行動など、お見通しだ。
#. de: Verräter gehören bestraft!
#. fr: Les traîtres seront punis<nbsp>!
msgctxt "NpcYell:3014:0:13"
msgid "Your every move is known to me."
msgstr "Я знаю каждый ваш шаг."

#. ja: 八つ裂きにしてやろう。<br>逃げられると思うな！
#. de: Du wirst dein Urteil erfahren! Es gibt kein Entrinnen!
#. fr: Je vais vous transformer en charpie<nbsp>!
msgctxt "NpcYell:3015:0:13"
msgid "I will rip the limbs from you and feast on your entrails!"
msgstr "Я оторву вам конечности и сожру ваши внутренности!"

#. ja: くっ……待ち伏せされていたのか！
#. de: Eine Falle!
#. fr: Quoi<nbsp>!? Un piège<nbsp>?
msgctxt "NpcYell:3016:0:13"
msgid "Curses! An ambush!"
msgstr "Проклятье! Засада!"

#. ja: もう少しで、宮殿だったのに……。
#. de: So kurz vor dem Ziel!
#. fr: Si près du but...
msgctxt "NpcYell:3017:0:13"
msgid "And to think we were so close to Zenith...!"
msgstr "И подумать только, мы были так близко к Зениту!.."

#. ja: 抵抗など、無駄、無駄ァ！
#. de: Widerstand ist zwecklos!
#. fr: Toute résistance est inutile<nbsp>!
msgctxt "NpcYell:3018:0:13"
msgid "Resistance is futile."
msgstr "Сопротивление бесполезно."

#. ja: フハハ……我が爪牙の餌食となれ！
#. de: Ich werde meine Fänge in dein zartes Fleisch bohren!
#. fr: Je vais vous manger tout crus<nbsp>!
msgctxt "NpcYell:3019:0:13"
msgid "Gahahaha! I will lick the flesh from your bones!"
msgstr "Га-га-га! Я слижу мясо с ваших костей!"

#. ja: だめだ……。<br>このままでは、やられる……。
#. de: Lange halte ich das nicht mehr durch!
#. fr: On va jamais y arriver...
msgctxt "NpcYell:3020:0:13"
msgid "Is this the end for us...?"
msgstr "Неужели нам конец?.."

#. ja: 不穏な物音を聞きつけて、<br>何事かと駆けつけてみれば……。
#. de: Ich habe die hässlichen Schreie also richtig interpretiert. Ein Angriff der Horde!
#. fr: Voilà donc l'origine de ce cri horrible<nbsp>!
msgctxt "NpcYell:3021:0:13"
msgid "I thought I heard the sounds of fighting..."
msgstr "Я услышал шум битвы и поспешил узнать, что случилось..."

#. ja: 幼き血族よ、無事か？
#. de: Geht es dir gut?
#. fr: Rien de cassé<nbsp>?
msgctxt "NpcYell:3022:0:13"
msgid "How fare you, my young ones?"
msgstr "Как вы, юные сородичи?"

#. ja: ヴェズルフェルニル様……！<br>はい、大丈夫です！
#. de: Ja, Vedrfölnir! Danke!
#. fr: Non<nbsp>! Merci, Vedrfolnir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3023:0:13"
msgid "Lord Vedrfolnir!<br>Your presence heartens us all!"
msgstr "Владыка Ведрфёльнир!<br>Одного вашего присутствия достаточно, чтобы придать нам сил!"

#. ja: むっ……厄介な敵が現れたな。<br>だがここで、奴を倒せば……。
#. de: Der hat gerade noch gefehlt! Andererseits ...
#. fr: Il faut nous débarrasser de cet ennemi dangereux...
msgctxt "NpcYell:3024:0:13"
msgid "Well, look who joins the fray..."
msgstr "Ну и кто это к нам пожаловал..."

#. ja: かまわん、蹴散らせ！
#. de: Ein Sieg brächte mir grenzenlosen Ruhm!
#. fr: La victoire sera mienne<nbsp>!
msgctxt "NpcYell:3025:0:13"
msgid "You will die with your precious younglings!"
msgstr "Вы умрёте вместе со своими драгоценными птенцами!"

#. ja: 旗色が悪いか……。
#. de: Heute ist nicht unser Tag!
#. fr: Ce n'est pas notre jour...
msgctxt "NpcYell:3026:0:13"
msgid "This isn't our day..."
msgstr "День сегодня явно не наш..."

#. ja: ここは退くぞ！
#. de: Rückzug!
#. fr: Arrière, toute<nbsp>!
msgctxt "NpcYell:3027:0:13"
msgid "Fall back!"
msgstr "Отступаем!"

#. ja: よく耐えたな、幼き血族よ。
#. de: Gut gekämpft, mein junger Drache.
#. fr: C'était un beau combat<nbsp>!
msgctxt "NpcYell:3028:0:13"
msgid "You fought well, young ones."
msgstr "Вы хорошо сражались, юные сородичи."

#. ja: ヴェズルフェルニル様、おかげで助かりました。
#. de: Ich danke dir, Vedrfölnir.
#. fr: Merci, Vedrfolnir.
msgctxt "NpcYell:3029:0:13"
msgid "It was by your strength that we prevailed."
msgstr "Мы одержали победу лишь благодаря вам."

#. ja: またいつ、奴らが攻めてくるかもしれん。
#. de: Die Horde kann jederzeit zurückschlagen.
#. fr: Restons tout de même sur nos gardes<nbsp>!
msgctxt "NpcYell:3030:0:13"
msgid "We have won the day, but there is no knowing when our foe will return."
msgstr "Враг может напасть снова в любой миг."

#. ja: 我とともに、白亜の宮殿へ戻ろう。
#. de: Begleite mich zum Tempel.
#. fr: Retournons au temple.
msgctxt "NpcYell:3031:0:13"
msgid "Let us return to Zenith together."
msgstr "Вернёмся вместе в Зенит."

#. ja: はい、ありがとうございます！
#. de: Jawohl, Vedrfölnir!
#. fr: À vos ordres<nbsp>!
msgctxt "NpcYell:3032:0:13"
msgid "We would be honored to, my lord."
msgstr "Для нас это большая честь, владыка."

#. ja: フ……裏切り者どもの末路か。<br>みじめなものだな！
#. de: Ein klägliches Ende steht Verrätern gut.
#. fr: Une fin pitoyable pour un traître<nbsp>!
msgctxt "NpcYell:3033:0:13"
msgid "This is the fate of a traitor!"
msgstr "Вот участь предателя!"

#. ja: 目的は達した……引き揚げるぞ！
#. de: Mission erfüllt! Zurück zu den Unseren!
#. fr: Mission accomplie<nbsp>! Retour au bercail<nbsp>!
msgctxt "NpcYell:3034:0:13"
msgid "We have done our duty here. Let us away!"
msgstr "Здесь мы своё дело сделали. Уходим!"

#. ja: えっ、あっさり退却する……？
#. de: Ihr zieht euch zurück?
#. fr: Vous battez en retraite<nbsp>?
msgctxt "NpcYell:3035:0:13"
msgid "You are so quick to retreat?"
msgstr "Как быстро вы отступаете!"

#. ja: この戦いは、ただの挨拶がわり。<br>貴様ら裏切り者への、宣戦布告にすぎん。
#. de: Dies war lediglich eine Warnung!
#. fr: Ceci n'était qu'un avertissement<nbsp>!
msgctxt "NpcYell:3036:0:13"
msgid "This battle was but a warning."
msgstr "Эта битва была лишь предупреждением."

#. ja: 貴様がどうなろうと、どうでもよかったのだ。<br>見せしめに、痛めつけてやったまで。
#. de: Es ist mir egal, ob du lebst, solange du leidest!
#. fr: Préparez-vous à souffrir<nbsp>!
msgctxt "NpcYell:3037:0:13"
msgid "I care not whether you live or die, so long as you suffer."
msgstr "Мне всё равно, выживете вы или умрёте, лишь бы страдали."

#. ja: ご苦労だったな。<br>ハッハハハハ！
#. de: Und das hast du gut getan. Muwahahahaha!
#. fr: Et pas qu'un peu, hahahaha<nbsp>!
msgctxt "NpcYell:3038:0:13"
msgid "You have suffered, and suffered well. Gahahaha!"
msgstr "Ну и натерпелись же вы! Ха-ха-ха!"

#. ja: 敵の本当の狙いは、白亜の宮殿？<br>……みんなに知らせないと！
#. de: Die Horde hat es auf den Tempel abgesehen! Ich muss die anderen warnen!
#. fr: Ainsi, ils en avaient après Zénith<nbsp>? Il faut vite prévenir les autres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3039:0:13"
msgid "Our foe's true target is Zenith...<br>We must alert the others!"
msgstr "Истинная цель врага — Зенит...<br>Нужно предупредить остальных!"

#. ja: 冒険者よ…すまぬ…
#. de: Danke, Abenteurer<if $gn4>in</if>.
#. fr: Toutes mes excuses, aventuri<if $gn4>ère<else>er</if>...
msgctxt "NpcYell:3040:0:13"
msgid "Forgive me..."
msgstr "Прости меня..."

#. ja: 奴らが気づかぬとよいが…
#. de: Hoffentlich bemerken sie mich nicht.
#. fr: J'espère qu'ils ne remarqueront rien...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3041:0:13"
msgid "I pray I am not<br>discovered..."
msgstr "Надеюсь, меня<br>не заметят..."

#. ja: まずい…気づかれた？
#. de: Hoffentlich bemerken sie mich nicht.
#. fr: Mince<nbsp>! Ils se sont aperçus de quelque chose<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3042:0:13"
msgid "Do not draw<br>them here..."
msgstr "Только бы не привести<br>их сюда..."

#. ja: 構えよ、くるぞ！
#. de: Achtung, sie kommen!
#. fr: Attention, ils arrivent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3043:0:13"
msgid "Steel yourself!<br>They come!"
msgstr "Приготовьтесь!<br>Они идут!"

#. ja: なっ！？<br>あれほどの多勢とは！
#. de: Was?! So viele?!
#. fr: Ils sont nombreux, très nombreux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3044:0:13"
msgid "What!? Th-There<br>are so many!"
msgstr "Что?! Их... Их<br>так много!"

#. ja: すまぬ…<br>我は命が惜しい…
#. de: Denen bin ich nicht gewachsen ...
#. fr: Je ne veux pas mourir<nbsp>!
msgctxt "NpcYell:3045:0:13"
msgid "This is beyond me..."
msgstr "Это мне не по силам..."

#. ja: あとは頼んだぞ…
#. de: Jetzt liegt es an dir, Abenteurer<if $gn4>in</if>!
#. fr: Vous êtes mon dernier espoir, aventuri<if $gn4>ère<else>er</if>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3046:0:13"
msgid "I shall leave it in<br>your capable hands."
msgstr "Оставляю всё<br>в твоих надёжных руках."

#. ja: 後退ではない<br>戦力の温存だ…！
#. de: Wer niemals ruht, nicht kämpfen kann!
#. fr: Pour être efficace, il faut aussi se reposer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3047:0:13"
msgid "Live today, fight<br>tomorrow..."
msgstr "Сегодня отступим,<br>а завтра снова в бой..."

#. ja: 勇敢なる冒険者！<br>よく戦った
#. de: Du hast tapfer gekämpft, Abenteurer<if $gn4>in</if>.
#. fr: Quel courage, c'était magnifique<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <if $gn4>daughter<else>son</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:3048:0:13"
msgid "You fought well,<br><if $gn4>daughter<else>son</if> of the Land.<br>My thanks to you."
msgstr "Ты хорошо сражал<if $gn4>ась<else>ся</if>,<br><if $gn4>дочь<else>сын</if> земли.<br>Благодарю тебя."

#. ja: また会おう、冒険者よ！
#. de: Auf dass wir uns eines Tages wiedertreffen.
#. fr: On se reverra cer<shy>tai<shy>ne<shy>ment un jour<nbsp>!
msgctxt "NpcYell:3049:0:13"
msgid "Till we meet again."
msgstr "До новой встречи."

#. ja: まずいな……このままでは。
#. de: Es steht nicht gut um uns ...
#. fr: Ça ne sent pas bon...
msgctxt "NpcYell:3050:0:13"
msgid "This does not look good for us..."
msgstr "Дело плохо..."

#. ja: 今だ、逃げろ！
#. de: Rückzug, sofort!
#. fr: Fuyons<nbsp>!
msgctxt "NpcYell:3051:0:13"
msgid "Retreat at once!"
msgstr "Немедленно отступаем!"

#. ja: はい！
#. de: Jawohl!
#. fr: D'accord<nbsp>!
msgctxt "NpcYell:3052:0:13"
msgid "Aye!"
msgstr "Есть!"

#. ja: フッ……他愛のないことだ。
#. de: Pah ... Feige Verräter ...
#. fr: Sale traître...
msgctxt "NpcYell:3053:0:13"
msgid "Pathetic..."
msgstr "Жалкие..."

#. ja: 無事でよかった……。
#. de: Ein Glück, du bist unversehrt.
#. fr: Tout va bien, heureusement.
msgctxt "NpcYell:3054:0:13"
msgid "It gladdens me to see you safe."
msgstr "Рад видеть, что ты цел<if $gn4>а<else>ый</if>."

#. ja: 行け！<br>白亜の宮殿へと急ぐのだ！
#. de: Schnell, zum Kreidetempel!
#. fr: Vite, à Zénith<nbsp>!
msgctxt "NpcYell:3055:0:13"
msgid "To Zenith! Fly!"
msgstr "К Зениту! Скорее!"

#. ja: わかりました！
#. de: Verstanden!
#. fr: Tout de suite<nbsp>!
msgctxt "NpcYell:3056:0:13"
msgid "Understood!"
msgstr "Понял!"

#. ja: 誰か、助けてくぽ～！
#. de: Hilfe, kupo!
#. fr: À l'aide, kuppo<nbsp>!
msgctxt "NpcYell:3057:0:13"
msgid "Someone save me, kupo!"
msgstr "Кто-нибудь, спасите меня, купо!"

#. ja: 逃げるなら今くぽ～
#. de: Jetzt oder nie, ich bin weg, kupo!
#. fr: C'est maintenant ou jamais, kuppo<nbsp>!
msgctxt "NpcYell:3058:0:13"
msgid "Now would be a good time to run, kupo."
msgstr "Самое время удирать, купо."

#. ja: 決着を付けるぞ！
#. de: Es wird Zeit, das Ganze zu Ende zu führen.
#. fr: Il est temps d'en finir<nbsp>!
msgctxt "NpcYell:3059:0:13"
msgid "We settle this!"
msgstr "Покончим с этим!"

#. ja: いざ、参る！
#. de: Auf geht's!
#. fr: J'arrive<nbsp>!
msgctxt "NpcYell:3060:0:13"
msgid "Prepare yourselves!"
msgstr "Ну, держитесь!"

#. ja: クッ、やられすぎた……そろそろ潮時か。
#. de: Ein Sieg ist in weiter Ferne.
#. fr: La victoire m'échappe...
msgctxt "NpcYell:3061:0:13"
msgid "Tch...! This is not going as I hoped..."
msgstr "Чёрт... Всё пошло не так, как я надеялся..."

#. ja: 殺しは大好物だが、殺される趣味はない。
#. de: Ich töte gerne, fürs Sterben gilt das nicht.
#. fr: Je n'ai pas l'intention de mourir<nbsp>!
msgctxt "NpcYell:3062:0:13"
msgid "Killing is fine sport. Being killed...not so much."
msgstr "Убивать — весёлое занятие. А вот быть убитым... не очень."

#. ja: そこそこ楽しませてもらった。<br>よい歯ごたえだったぞ！
#. de: Trotzdem, ein unterhaltsamer Kampf!
#. fr: Ce combat m'a beaucoup amusé. Bravo<nbsp>!
msgctxt "NpcYell:3063:0:13"
msgid "You have amused me for the day, my quarry."
msgstr "Сегодня ты меня развлёк, моя добыча."

#. ja: ククク……次も、よい殺し合いをしよう。<br>さらばだ！
#. de: Möge das Schlachten schon bald weitergehen!
#. fr: Que le prochain soit une vraie boucherie<nbsp>!
msgctxt "NpcYell:3064:0:13"
msgid "But know this: I am ever the hunter, and you the hunted."
msgstr "Но запомни: охотник здесь всегда я, а добыча — ты."

#. ja: お助けーっ！
#. de: Gerettet!
#. fr: On est sauvés<nbsp>!
msgctxt "NpcYell:3065:0:13"
msgid "We're saved!"
msgstr "Мы спасены!"

#. ja: 助かったくぽ～！
#. de: Vielen Dank, kupo!
#. fr: Merci beaucoup, kuppo<nbsp>!
msgctxt "NpcYell:3066:0:13"
msgid "I am saved, kupo!"
msgstr "Я спасён, купо!"

#. ja: 小さき者どもよ、逃げるか！
#. de: Wo willst du hin, Kleiner?
#. fr: Où tu vas comme ça<nbsp>?
msgctxt "NpcYell:3067:0:13"
msgid "Flutter all you like, little one..."
msgstr "Можешь порхать сколько угодно, малыш..."

#. ja: 力なき者は、おとなしく殺されるがいい！
#. de: Dein Weg führt direkt ins Grab!
#. fr: Les faibles seront écrasés<nbsp>!
msgctxt "NpcYell:3068:0:13"
msgid "It will only make killing you all the sweeter!"
msgstr "Только слаще будет вас всех прикончить!"

#. ja: 死ぬのはいやくぽ～。
#. de: Ich will noch nicht sterben, kupooo!
#. fr: Je ne veux pas mourir, kuppoooo<nbsp>!
msgctxt "NpcYell:3069:0:13"
msgid "No! I'm too cute to die, kupo!"
msgstr "Нет! Я слишком миленький, чтобы умирать, купо!"

#. ja: 妙なのが紛れ込んでいるな。
#. de: Hm, was hat <if $gn4>die<else>der</if> hier zu suchen?
#. fr: Qu'est-ce que tu viens faire ici, toi<nbsp>?
msgctxt "NpcYell:3070:0:13"
msgid "What is this? My prey comes to me?"
msgstr "Что это? Добыча сама пришла ко мне?"

#. ja: こいつを獲物に、戯れるのもよいな……。
#. de: Ich werde <if $gn4>sie<else>ihn</if> einfach mit töten.
#. fr: Héhéhé, je sens qu'on va s'amuser...
msgctxt "NpcYell:3071:0:13"
msgid "This should be good sport!"
msgstr "Вот это будет забавно!"

#. ja: ククク……両方殺せばよいだけ！
#. de: Doppeltes Leid, doppelte Freud! Harhar!
#. fr: Double souffrance, double joie, haha<nbsp>!
msgctxt "NpcYell:3072:0:13"
msgid "Yes, I shall slaughter the lot of you!"
msgstr "Ха-ха-ха... Просто перебью вас всех!"

#. ja: 次は、貴様を弄んでやろう。
#. de: Sprich dein letztes Gebet!
#. fr: Viens jouer avec moi<nbsp>!
msgctxt "NpcYell:3073:0:13"
msgid "You will be my next plaything..."
msgstr "Ты будешь моей следующей игрушкой..."

#. ja: 貴様……やるな。
#. de: Du kämpfst ... nicht schlecht ...
#. fr: Tu te bats plutôt bien, dis donc...
msgctxt "NpcYell:3074:0:13"
msgid "My prey bites back? How...amusing."
msgstr "Моя добыча огрызается? Как... занятно."

#. ja: 近ごろの玩具は、壊れやすくてな……。
#. de: Normal geht mein Spielzeug schnell kaputt ...
#. fr: Les jouets ne sont plus aussi solides qu'avant...
msgctxt "NpcYell:3075:0:13"
msgid "My playthings of late have proven far too...fragile."
msgstr "В последнее время мои игрушки какие-то уж слишком... хрупкие."

#. ja: これほど楽しめたのは、ひさしぶりだ。
#. de: So viel Spaß hatte ich schon lange nicht mehr.
#. fr: Ça fait longtemps que je n'ai pas ressenti un tel plaisir<nbsp>!
msgctxt "NpcYell:3076:0:13"
msgid "I have not enjoyed myself so thoroughly in quite some time."
msgstr "Давно я не получал такого удовольствия."

#. ja: もっと楽しませてくれ……。
#. de: Lass uns weiterspielen!
#. fr: Allez, viens un peu par ici...
msgctxt "NpcYell:3077:0:13"
msgid "But there is more fun to be had, yes?"
msgstr "Но ведь можно повеселиться ещё, верно?"

#. ja: この手応え……玩具のくせに……。
#. de: Ein gefährliches Spielzeug bist du ...
#. fr: Tu es un jouet bien dangereux...
msgctxt "NpcYell:3078:0:13"
msgid "Ahhh, the thrill of the hunt!"
msgstr "Ах, вот это охота!"

#. ja: 命のやり取りこそ……最高の戯れ……。
#. de: Doch ohne Risiko keinen Ruhm!
#. fr: Sans risque, pas de gloire<nbsp>!
msgctxt "NpcYell:3079:0:13"
msgid "A savage battle to the death!"
msgstr "Жестокая битва не на жизнь, а на смерть!"

#. ja: ククク……たまらんぞ！
#. de: Na los, weiter im blutigen Text!
#. fr: Hahaha... Hahahahaha<nbsp>!
msgctxt "NpcYell:3080:0:13"
msgid "The pain! The blood! The pleasure!"
msgstr "Боль! Кровь! Наслаждение!"

#. ja: どうした、そんなものか！？
#. de: Oder war das etwa schon alles?
#. fr: C'est tout ce que tu as dans le ventre<nbsp>?
msgctxt "NpcYell:3081:0:13"
msgid "Is that all you have? Come! Come, I say!"
msgstr "И это всё, на что ты способен? Давай! Ну же!"

#. ja: こいつ、殺し合いを楽しんでるくぽ？
#. de: Töten ist ein Spiel für ihn, kupo?
#. fr: Il a l'air vraiment méchant, kuppopo<nbsp>!
msgctxt "NpcYell:3082:0:13"
msgid "It's as if the sight of blood urges him on, kupo!"
msgstr "Похоже, вид крови только распаляет его, купо!"

#. ja: 玩具？<br>くぽー、モグはぬいぐるみじゃないくぽ！
#. de: Spielzeug? Ich bin doch kein Stofftier, kupo!
#. fr: Je ne suis pas une peluche, kuppo<nbsp>! Non mais<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3083:0:13"
msgid "Who are you calling “prey”!?<br>I'm no one's dinner, kupo!"
msgstr "Кого это ты назвал добычей!?<br>Я никому на обед не достанусь, купо!"

#. ja: こいつ、やばすぎるくぽ！
#. de: Der ist total durchgedreht, kupo!
#. fr: Attention, kuppooooo<nbsp>!
msgctxt "NpcYell:3084:0:13"
msgid "This one's not right in the head, kupo!"
msgstr "С ним что-то совсем не так, купо!"

#. ja: 小さき者よ、どこへゆく！
#. de: Wo willst du hin, Kleiner?
#. fr: Où est-ce que tu vas comme ça<nbsp>!
msgctxt "NpcYell:3085:0:13"
msgid "Come back, little one..."
msgstr "Стой, малыш..."

#. ja: 白亜の宮殿……いよいよ敵の本陣か。
#. de: Endlich, der Kreidetempel!
#. fr: Zénith, enfin<nbsp>!
msgctxt "NpcYell:3086:0:13"
msgid "At last, Zenith!"
msgstr "Наконец-то Зенит!"

#. ja: 出でよ、我が下僕！
#. de: Stürmt ihn, meine Drachen!
#. fr: À l'attaque, vous autres<nbsp>!
msgctxt "NpcYell:3087:0:13"
msgid "Come forth, my minions!"
msgstr "Вперёд, мои прислужники!"

#. ja: これ程とはっ！
#. de: Läuft ja blendend ...
#. fr: Je dois me ressaisir<nbsp>!
msgctxt "NpcYell:3088:0:13"
msgid "Pull yourself together!"
msgstr "Соберись!"

#. ja: 魔力よ、奔（はし）れっ！
#. de: Zauber, vernichte!
#. fr: À moi, magie des anciens<nbsp>!
msgctxt "NpcYell:3089:0:13"
msgid "Focus...release!"
msgstr "Сосредоточение... высвободить!"

#. ja: 邪魔をするなっ！
#. de: Aus dem Weg!
#. fr: Hors de ma vue<nbsp>!
msgctxt "NpcYell:3090:0:13"
msgid "Away with you!"
msgstr "Не мешай!"

#. ja: 私にだって、これくらいは！
#. de: Meine leichteste Übung!
#. fr: Voilà pour vous<nbsp>!
msgctxt "NpcYell:3091:0:13"
msgid "I have my pride..."
msgstr "У меня тоже есть гордость..."

#. ja: ルヴェユールの名にかけて！
#. de: Bei der Ehre der Leveilleurs!
#. fr: Pour l'honneur des Leveilleur<nbsp>!
msgctxt "NpcYell:3092:0:13"
msgid "For the house of Leveilleur!"
msgstr "Во имя дома Левейлёров!"

#. ja: サリャクの英知よ、ここにっ！
#. de: Thaliak, steh mir bei!
#. fr: Thaliak, protège-moi<nbsp>!
msgctxt "NpcYell:3093:0:13"
msgid "Thaliak protect me!"
msgstr "Талиак, защити меня!"

#. ja: 切り札を使わせてもらう！
#. de: Zeit für meinen Trumpf!
#. fr: Voici ma botte secrète<nbsp>!
msgctxt "NpcYell:3094:0:13"
msgid "So it comes to this!"
msgstr "Похоже, другого выхода нет!"

#. ja: おいおい、冗談だろ！？
#. de: Das ist nicht witzig!
#. fr: C'est... C'est une blague<nbsp>?
msgctxt "NpcYell:3095:0:13"
msgid "A godsdamned joke..."
msgstr "Вот же чёртова шутка..."

#. ja: くらいやがれっ！
#. de: Nimm dies, Bastard!
#. fr: Prends ça dans les dents<nbsp>!
msgctxt "NpcYell:3096:0:13"
msgid "Take this, you bastard!"
msgstr "Получай, ублюдок!"

#. ja: さて、これならどうだ？
#. de: Wie schmeckt dir das?
#. fr: Attention, ça va faire mal<nbsp>!
msgctxt "NpcYell:3097:0:13"
msgid "How about this!?"
msgstr "Ну как тебе это!?"

#. ja: おるあああっ！
#. de: Tod den Häretikern!
#. fr: Immondes païens<nbsp>!
msgctxt "NpcYell:3098:0:13"
msgid "Accursed heathens!"
msgstr "Проклятые еретики!"

#. ja: おぉ、女神よ、ご照覧あれ！
#. de: Halone, sei mit mir!
#. fr: Bénis-moi, Halone<nbsp>!
msgctxt "NpcYell:3099:0:13"
msgid "Bless me, O Fury!"
msgstr "Благослови меня, о Ярость!"

#. ja: とっておきを、くれてやる！
#. de: Jetzt bist du dran!
#. fr: Vous n'êtes rien<nbsp>!
msgctxt "NpcYell:3100:0:13"
msgid "I've got you now!"
msgstr "Теперь ты мой!"

#. ja: くたばりやがれ！
#. de: Krepier!
#. fr: Que la Conquérante vous emporte<nbsp>!
msgctxt "NpcYell:3101:0:13"
msgid "Hells take you!"
msgstr "Чтоб тебя черти побрали!"

#. ja: 負けられるかよ！
#. de: Ich geb nicht auf!
#. fr: Je ne tomberai pas<nbsp>!
msgctxt "NpcYell:3102:0:13"
msgid "I will not yield to you!"
msgstr "Не сдамся тебе!"

#. ja: ミンチにしてやる！
#. de: Ich schneid dich in Stücke!
#. fr: Je vais te couper en morceaux<nbsp>!
msgctxt "NpcYell:3103:0:13"
msgid "I'll cut you to pieces!"
msgstr "Порублю тебя в куски!"

#. ja: もうガマンならねぇ！
#. de: Genug!
#. fr: Assez<nbsp>!
msgctxt "NpcYell:3104:0:13"
msgid "Enough!"
msgstr "Хватит!"

#. ja: オラオラオラァッ！
#. de: Hahaha!
#. fr: Ha ha ha<nbsp>!
msgctxt "NpcYell:3105:0:13"
msgid "Hahaha!"
msgstr "Ха-ха-ха!"

#. ja: これで終いだ！
#. de: Dieser Kampf endet jetzt!
#. fr: Ta mort est arrivée<nbsp>!
msgctxt "NpcYell:3106:0:13"
msgid "This ends here!"
msgstr "Здесь тебе и конец!"

#. ja: 喰らえってんだよ！
#. de: Nieder mit dir!
#. fr: Tu ne te relèveras pas<nbsp>!
msgctxt "NpcYell:3107:0:13"
msgid "Down with you!"
msgstr "Получай!"

#. ja: ハハハ、力が湧き出てきやがる！
#. de: Ich bin erfüllt von Macht!
#. fr: Ma puissance est infinie<nbsp>!
msgctxt "NpcYell:3108:0:13"
msgid "I have the power!"
msgstr "Ха-ха-ха! Сила так и хлещет!"

#. ja: 邪魔が入ったか？
#. de: Wer wagt es, sich einzumischen?
#. fr: Qui vient fouiner par ici<nbsp>?
msgctxt "NpcYell:3109:0:13"
msgid "Who dares interfere?"
msgstr "Кто смеет вмешиваться?"

#. ja: まさか……ヒトに後れを取るとは……。
#. de: Die feigen Verräter schicken Sterbliche vor?
#. fr: Moi, surpassé par des humains<nbsp>? Impossible<nbsp>!
msgctxt "NpcYell:3110:0:13"
msgid "I will not be shown up by a mortal!"
msgstr "Неужто я уступлю смертному?!"

#. ja: ちょうどいい……。<br>手始めに、こやつらを血の贄に捧げるとしよう。
#. de: Eine bessere Aufwärmübung ...
#. fr: On va enfin pouvoir s'amuser un peu.
msgctxt "NpcYell:3111:0:13"
msgid "Perfect... These ones should make a good sacrifice."
msgstr "Прекрасно... Они станут отличной жертвой."

#. ja: フッ……次は、こいつらが相手だ。
#. de: Also gut, wie sieht's hiermit aus?
#. fr: Ah, voilà les autres<nbsp>!
msgctxt "NpcYell:3112:0:13"
msgid "These ones will play with you next."
msgstr "Хм... Теперь с вами поиграют они."

#. ja: またか……ふがいない下僕め。
#. de: Seid ihr zu gar nichts zu gebrauchen?
#. fr: Encore<nbsp>? C'est pitoyable...
msgctxt "NpcYell:3113:0:13"
msgid "Again? Are you good for nothing!?"
msgstr "Опять? Да что с вами не так?!"

#. ja: ならば、これでどうだ？
#. de: Na schön, dann eben die hier!
#. fr: Et qu'est-ce que vous dites de ça<nbsp>?
msgctxt "NpcYell:3114:0:13"
msgid "What say you to this?"
msgstr "Ну как вам это?"

#. ja: 汝ら、無事か！？
#. de: Halte durch!
#. fr: Tenez bon<nbsp>!
msgctxt "NpcYell:3115:0:13"
msgid "Stand down, fiend!"
msgstr "Отойди от них, чудовище!"

#. ja: ヴェズルフェルニルか……ちっ。
#. de: Vedrfölnir? Pah ...
#. fr: Vedrfolnir<nbsp>?
msgctxt "NpcYell:3116:0:13"
msgid "The traitor cometh."
msgstr "Так это ты, предатель... Чёрт."

#. ja: そろそろ貴様とも、決着をつけるか。
#. de: Dein Ende ist nah!
#. fr: Ta fin est proche<nbsp>!
msgctxt "NpcYell:3117:0:13"
msgid "Mark my words─your end is nigh."
msgstr "Запомни: скоро тебе конец."

#. ja: 我が下僕よ、雑魚はまかせる。
#. de: Kümmert euch um das Ungeziefer, meine Knechte!
#. fr: Occupez-vous du menu fretin<nbsp>!
msgctxt "NpcYell:3118:0:13"
msgid "My minions, I leave the whelps to you."
msgstr "Мои слуги, разберитесь с мелюзгой."

#. ja: あいつらもやられたか……。
#. de: Ich bin von Dilettanten umgeben!
#. fr: Quoi<nbsp>? Ils se sont fait avoir<nbsp>?
msgctxt "NpcYell:3119:0:13"
msgid "They, too, have fallen?"
msgstr "И эти тоже пали?"

#. ja: もう少し骨のある連中と思ったが……。
#. de: Ist denn hier jeder unfähig?
#. fr: Je les croyais plus résistants que ça...
msgctxt "NpcYell:3120:0:13"
msgid "And here I thought they would prove more useful..."
msgstr "А я-то думал, от них будет больше толку..."

#. ja: 次は、貴様らが相手せよ！
#. de: Also gut, noch einen Versuch!
#. fr: À votre tour<nbsp>!
msgctxt "NpcYell:3121:0:13"
msgid "You are next! Do not fail me!"
msgstr "Теперь ваша очередь! Не подведите меня!"

#. ja: どれほど苦杯を舐めれば気が済むのか！
#. de: Wann habt ihr endlich genug?!
#. fr: Vous n'en avez jamais assez<nbsp>?
msgctxt "NpcYell:3122:0:13"
msgid "Is there no end to the dishonor you bring me!?"
msgstr "Сколько ещё вы будете меня позорить?!"

#. ja: 情けない奴らよ。
#. de: Erbärmliches Pack!
#. fr: Vous ne me laissez pas le choix...
msgctxt "NpcYell:3123:0:13"
msgid "Pathetic...all of you."
msgstr "Жалкие... все до одного."

#. ja: やむを得ぬ……奥の手を使うか。
#. de: Ihr habt es ja nicht anders gewollt!
#. fr: Voilà ce que vous méritez<nbsp>!
msgctxt "NpcYell:3124:0:13"
msgid "So be it. It appears I have no choice."
msgstr "Что ж, выбора у меня, похоже, нет."

#. ja: 出でよ、我が忠実なる下僕ら！
#. de: Euer Auftritt, meine hörigen Mörder!
#. fr: Allez-y, fidèles serviteurs<nbsp>!
msgctxt "NpcYell:3125:0:13"
msgid "Come, my faithful!"
msgstr "Вперёд, мои верные слуги!"

#. ja: 耐えてみせる！
#. de: Bloß ... ein Kratzer ...
#. fr: Je tiendrai bon<nbsp>!
msgctxt "NpcYell:3126:0:13"
msgid "It is nothing."
msgstr "Пустяки."

#. ja: 見切った！
#. de: Eine Lücke!
#. fr: Là, une faille<nbsp>!
msgctxt "NpcYell:3127:0:13"
msgid "An opening!"
msgstr "Вот она, брешь!"

#. ja: 隙だらけだぞ？
#. de: Erbärmliche Verteidigung!
#. fr: Quelle défense ridicule<nbsp>!
msgctxt "NpcYell:3128:0:13"
msgid "Your defense is lacking."
msgstr "Плохо ты защищаешься."

#. ja: 始末するっ！
#. de: Das übernehm ich!
#. fr: Laissez-moi faire<nbsp>!
msgctxt "NpcYell:3129:0:13"
msgid "Leave this to me!"
msgstr "Предоставьте это мне!"

#. ja: 印（いん）を結びて神秘と成す！
#. de: Kraft der Mudras!
#. fr: Par le pouvoir des shinobi<nbsp>!
msgctxt "NpcYell:3130:0:13"
msgid "The weave of a shinobi's power!"
msgstr "Сила ниндзюцу — в печатях!"

#. ja: 一閃！
#. de: Schattenfang!
#. fr: Pas de quartier<nbsp>!
msgctxt "NpcYell:3131:0:13"
msgid "No retreat, no surrender!"
msgstr "Ни шагу назад!"

#. ja: 里に伝わる奥義を！
#. de: Technik meiner Ahnen!
#. fr: Ma technique secrète vaincra<nbsp>!
msgctxt "NpcYell:3132:0:13"
msgid "The art of my forebears!"
msgstr "Секретное искусство моего народа!"

#. ja: ほう、あれほどの大物を退けるとは……。
#. de: Nicht schlecht, gar nicht schlecht.
#. fr: Pas mal, pas mal du tout...
msgctxt "NpcYell:3133:0:13"
msgid "To bring down a foe of such power..."
msgstr "Справиться с таким сильным противником..."

#. ja: ヒトの中にも、傑物がいるとみえる。
#. de: Für <if $gn4>eine Sterbliche<else>einen Sterblichen</if> schlägst du dich wacker.
#. fr: Vous vous débrouillez plutôt bien pour des mortels...
msgctxt "NpcYell:3134:0:13"
msgid "Your strength is great indeed, mortal."
msgstr "А ты, смертный, и впрямь силён."

#. ja: 敗れた……だと？
#. de: Meine Meute besiegt?
#. fr: Je suis... vaincu<nbsp>?
msgctxt "NpcYell:3135:0:13"
msgid "My minions have fallen...?"
msgstr "Мои слуги... пали?"

#. ja: 壊滅……だと？<br>よもや、これほどの抵抗を見せるとは！
#. de: Vollständig vernichtet? Wie ist das möglich?
#. fr: Je n'aurais jamais cru qu'une telle résistance était possible<nbsp>!
msgctxt "NpcYell:3136:0:13"
msgid "You fight well for a miserable traitor."
msgstr "Все уничтожены?! Не думал, что вы окажете такое сопротивление!"

#. ja: 戦いはまだ続く……ここは退いておくか。
#. de: Doch der Krieg ist noch nicht verloren!
#. fr: Ce n'est pas fini<nbsp>!
msgctxt "NpcYell:3137:0:13"
msgid "...But this is not the end."
msgstr "...Но это ещё не конец."

#. ja: よいか……次こそは、貴様らの最期だ！
#. de: Die nächste Schlacht ist euer Ende!
#. fr: Vous ne serez pas aussi chanceux la prochaine fois<nbsp>!
msgctxt "NpcYell:3138:0:13"
msgid "The day we next meet shall be your last."
msgstr "В следующий раз вам не жить."

#. ja: 逃げるのか！
#. de: Da flieht die feige Schlange!
#. fr: Haha, le fuyard<nbsp>!
msgctxt "NpcYell:3139:0:13"
msgid "You would flee?"
msgstr "Ты бежишь?!"

#. ja: 存外に、逃げ足の速いやつよ。
#. de: Nur seine gespaltene Zunge ist schneller.
#. fr: Il est plutôt rapide<nbsp>! Il devait avoir très peur<nbsp>!
msgctxt "NpcYell:3140:0:13"
msgid "For all his bluster, he is but a craven snake."
msgstr "А он, оказывается, быстро бегает. Только и умеет, что языком молоть."

#. ja: 次こそ、決着をつけねば。
#. de: Noch mal entkommt er mir nicht!
#. fr: La prochaine fois, il ne s'en sortira pas comme ça<nbsp>!
msgctxt "NpcYell:3141:0:13"
msgid "The next time I shall give him the death he deserves."
msgstr "В следующий раз я его прикончу."

#. ja: ええい……こちらが不利か！
#. de: Noch bin ich nicht geschlagen!
#. fr: C'est pas fini<nbsp>!
msgctxt "NpcYell:3142:0:13"
msgid "I'm not finished yet!"
msgstr "Чёрт... Кажется, перевес не на моей стороне!"

#. ja: 見くびるなよ！
#. de: Na, wie ist das?!
#. fr: Qu'est-ce que vous dites de ça<nbsp>?
msgctxt "NpcYell:3143:0:13"
msgid "How do you like this!?"
msgstr "Ну как тебе это?!"

#. ja: うらあぁぁっ！
#. de: Uwaaah!
#. fr: Yaaaaaargh<nbsp>!
msgctxt "NpcYell:3144:0:13"
msgid "Yaaaaaargh!"
msgstr "А-а-а-а!"

#. ja: 斬るッ！
#. de: Das wird ein Blutbad!
#. fr: Votre sang va couler<nbsp>!
msgctxt "NpcYell:3145:0:13"
msgid "I'll make you bleed!"
msgstr "Я заставлю тебя истекать кровью!"

#. ja: アラミゴの意地を見よ！
#. de: Für Ala Mhigo!
#. fr: Pour Ala Mhigo<nbsp>!
msgctxt "NpcYell:3146:0:13"
msgid "For Ala Mhigo!"
msgstr "За Ала Миго!"

#. ja: 切り刻むッ！
#. de: Ich reiß dich in Stücke!
#. fr: Je vais vous mettre en pièces<nbsp>!
msgctxt "NpcYell:3147:0:13"
msgid "I'll tear you limb from limb!"
msgstr "Разорву тебя на куски!"

#. ja: 受けてみろッ！
#. de: Schluss mit dem Trauerspiel.
#. fr: Moureeez<nbsp>!!
msgctxt "NpcYell:3148:0:13"
msgid "I have you now!"
msgstr "Теперь ты мой!"

#. ja: 収穫もりもり<br>大儲けっちゃ～
#. de: Yoyoroon mag Dinge! Glitzernde und leckere Dinge!
#. fr: Yoyoroon adooore les trésors<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3149:0:13"
msgid "Yoyoroon love loots!<br>Loots loots loots!♪"
msgstr "Йойорун обожает добычу!<br>Добыча, добыча, добыча!♪"

#. ja: ムッ……この咆哮は！
#. de: Hm? Dieses Brüllen ...
#. fr: Ce... Ce hurlement<nbsp>!
msgctxt "NpcYell:3150:0:13"
msgid "A roar from the heavens...!"
msgstr "Этот рёв... с небес?!"

#. ja: ダークスケール様が呼んでいる……。
#. de: Dunkelschuppe ruft nach mir.
#. fr: C'est Sombrécaille qui m'appelle...
msgctxt "NpcYell:3151:0:13"
msgid "Darkscale... Darkscale calls..."
msgstr "Тёмная Чешуя... Тёмная Чешуя зовёт..."

#. ja: 貴様ら、命拾いしたな。
#. de: Ihr habt Glück, heute verschon ich euch.
#. fr: Vous avez eu de la chance...
msgctxt "NpcYell:3152:0:13"
msgid "Your death shall come another day..."
msgstr "Повезло вам. Сегодня умрёте не вы..."

#. ja: ご褒美はお預けだ。<br>次は、死という名の褒美をくれてやるわ！
#. de: Doch dieses Glück wird nicht ewig währen!
#. fr: Mais ça ne durera pas éter<shy>nel<shy>le<shy>ment<nbsp>!
msgctxt "NpcYell:3153:0:13"
msgid "Consider yourselves fortunate, traitorous worms..."
msgstr "Считайте, что вам повезло, предательские черви..."

#. ja: 待て！
#. de: Warte!
#. fr: Attends<nbsp>!
msgctxt "NpcYell:3154:0:13"
msgid "Wait, coward!"
msgstr "Стой, трус!"

#. ja: 次こそは、容赦せんぞ！
#. de: Beim nächsten Mal ist er dran.
#. fr: Cette fois, c'est pour de bon<nbsp>!
msgctxt "NpcYell:3155:0:13"
msgid "When next we meet, I will show no quarter!"
msgstr "В следующий раз пощады не будет!"

#. ja: 貴様らに、こいつらが倒せるか？
#. de: Was haltet ihr hiervon?
#. fr: Vous croyez vraiment pouvoir les battre<nbsp>?
msgctxt "NpcYell:3156:0:13"
msgid "You are no match for my minions!"
msgstr "Думаете, вам по силам мои слуги?!"

#. ja: まずはお前からだ！
#. de: Du zuerst!
#. fr: Toi d'abord<nbsp>!
msgctxt "NpcYell:3157:0:13"
msgid "You're first!"
msgstr "Ты первый!"

#. ja: 感謝する！<br>後方支援は任せろ！
#. de: Danke! Ich halte uns den Rücken frei.
#. fr: Je m'en occupe<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3158:0:13"
msgid "My thanks, <split \" \" 1><string $gs1></split>!<br>I am at your back!"
msgstr "Спасибо, <split \" \" 1><string $gs1></split>!<br>Я прикрою тебя с тыла!"

#. ja: ようやく追いつめたぞ！
#. de: Endlich habe ich dich!
#. fr: Je te tiens<nbsp>!
msgctxt "NpcYell:3159:0:13"
msgid "Darkscale! I have cornered you at last."
msgstr "Тёмная Чешуя! Наконец-то я тебя загнал в угол."

#. ja: 配下どもは、すべて倒した。
#. de: Deine Getreuen sind vernichtet!
#. fr: Les sous-fifres sont tous à terre<nbsp>!
msgctxt "NpcYell:3160:0:13"
msgid "Your captains have all fallen to me."
msgstr "Я перебил всех твоих командиров."

#. ja: これ以上、好きにはさせん！
#. de: Und du wirst ihnen folgen!
#. fr: Maintenant, à ton tour<nbsp>!
msgctxt "NpcYell:3161:0:13"
msgid "Now, you will join them!"
msgstr "Теперь твоя очередь!"

#. ja: 追いつめた、だと……？
#. de: Hört, hört!
#. fr: Hahaha<nbsp>!
msgctxt "NpcYell:3162:0:13"
msgid "...“Cornered,” you say?"
msgstr "...«Загнал в угол», говоришь?"

#. ja: 我の縄張りに、誘い込んだまで。
#. de: Und das von einem, der mir direkt in die Falle gegangen ist!
#. fr: Tu es tombé dans mon piège<nbsp>!
msgctxt "NpcYell:3163:0:13"
msgid "Look around you, fool."
msgstr "Осмотрись, глупец."

#. ja: 追いつめられたのは、貴様だ。
#. de: Ich habe dich erwartet, Vedrfölnir.
#. fr: Je t'attendais, Vedrfolnir...
msgctxt "NpcYell:3164:0:13"
msgid "This is my lair...and I have lured you into it."
msgstr "Это моё логово... Я заманил тебя сюда."

#. ja: 覚悟せよ、ヴェズルフェルニル！
#. de: Um dir ein Ende zu machen!
#. fr: Ta mort est proche<nbsp>!
msgctxt "NpcYell:3165:0:13"
msgid "You will not leave this place alive!"
msgstr "Тебе отсюда не уйти живым!"

#. ja: 認めよう……。<br>貴様の力、決して侮ることはできぬと。
#. de: Du bist stark, das gebe ich zu.
#. fr: Tu es fort, je l'admets...
msgctxt "NpcYell:3166:0:13"
msgid "You are a worthy foe...for a traitor."
msgstr "Признаю... ты достойный противник, даже для предателя."

#. ja: 誘い込んでおいて、そのザマか？
#. de: Das nennst du also eine Falle?
#. fr: Tu crois que tu vas t'en sortir comme ça<nbsp>?
msgctxt "NpcYell:3167:0:13"
msgid "Face the truth, Darkscale! You are beaten!"
msgstr "Вот и всё, Тёмная Чешуя! Ты проиграл!"

#. ja: 左様、こんなものではない……。
#. de: Freu dich nicht zu früh!
#. fr: Ne te réjouis pas trop vite<nbsp>!
msgctxt "NpcYell:3168:0:13"
msgid "Beaten? I think not..."
msgstr "Проиграл? Ещё чего..."

#. ja: 刮目せよ！
#. de: Sieh her!
#. fr: Regarde par là<nbsp>!
msgctxt "NpcYell:3169:0:13"
msgid "Behold!!!"
msgstr "Смотрите!"

#. ja: ニーズヘッグ様……我に力を！
#. de: Nidhogg, schenke mir Kraft!
#. fr: Nidhogg, prête-moi ta force<nbsp>!
msgctxt "NpcYell:3170:0:13"
msgid "O, Nidhogg! Give unto me your strength!"
msgstr "О, Нидхёгг! Даруй мне свою силу!"

#. ja: この空気……何だ？
#. de: Dieses Flirren im Äther ...
#. fr: Quelle atmosphère pesante...
msgctxt "NpcYell:3171:0:13"
msgid "The air stirs...?"
msgstr "Воздух... что-то происходит?"

#. ja: クリスタルの力が……奴に……！？
#. de: Er zieht Kraft aus den Kristallen?
#. fr: Le... Le pouvoir du cristal<nbsp>!?
msgctxt "NpcYell:3172:0:13"
msgid "The crystals...! He drinks of their power!"
msgstr "Кристаллы... Он питается их силой!"

#. ja: おおっ……力みなぎる！
#. de: Ah, wie gut sich das anfühlt!
#. fr: Quelle sensation divine<nbsp>!
msgctxt "NpcYell:3173:0:13"
msgid "The fire! It wells from within!"
msgstr "Пламя! Оно разгорается во мне!"

#. ja: 今なら、貴様を殺すのも訳ない……。
#. de: Du bist so gut wie tot, Vedrfölnir!
#. fr: Tu es déjà mort, Vedrfolnir<nbsp>!
msgctxt "NpcYell:3174:0:13"
msgid "Now I shall smite you like the worm you are!"
msgstr "Теперь я сотру тебя в порошок, червь!"

#. ja: なぜだ……なぜ、敗れる！
#. de: Wie ist das möglich?
#. fr: Comment est-ce possible<nbsp>!?
msgctxt "NpcYell:3175:0:13"
msgid "I cannot fall to this traitor...!"
msgstr "Неужели я паду от руки этого предателя?!"

#. ja: 我に……我に力を！
#. de: Kraft ... Ich brauche mehr Kraft!
#. fr: Encore, j'en veux encore<nbsp>!
msgctxt "NpcYell:3176:0:13"
msgid "I must have more power!"
msgstr "Мне нужно больше силы!"

#. ja: よせ！<br>力を御しきれず、自滅するだけだ。
#. de: Lass ab ... Du treibst dich selbst in den Untergang!
#. fr: Arrête, tu cours à ta perte<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3177:0:13"
msgid "You know not what you do, Darkscale!<br>The power you seek will destroy you!"
msgstr "Не делай этого, Тёмная Чешуя!<br>Эта сила тебя погубит!"

#. ja: 貴様ら裏切り者を始末できればよい……。
#. de: Nichts lieber als das!
#. fr: Vous allez tous périr, bande de traîtres...
msgctxt "NpcYell:3178:0:13"
msgid "Silence, fool!"
msgstr "Молчание, глупец!"

#. ja: そのためなら、死も厭わぬ。
#. de: Wenn es auch den deinen bedeutet!
#. fr: La mort vous va si bien<nbsp>!
msgctxt "NpcYell:3179:0:13"
msgid "Gladly would I give my life in service to my lord!"
msgstr "Ради владыки я готов отдать жизнь!"

#. ja: 我に力を……！
#. de: Nidhogg, höre mich!
#. fr: Nidhogg, aide-moi<nbsp>!
msgctxt "NpcYell:3180:0:13"
msgid "I must have more power! MORE!!!"
msgstr "Мне нужна ещё сила! ЕЩЁ!!!"

#. ja: フフフ……ハッハハハハ！
#. de: Haha ... Muwahahahaha!
#. fr: Hahaha... Hahahahahaha<nbsp>!!
msgctxt "NpcYell:3181:0:13"
msgid "GWAHAHAHA!!!"
msgstr "Гва-ха-ха-ха!!!"

#. ja: これなら、負ける気がせぬ！
#. de: Jetzt hält mich nichts mehr auf!
#. fr: Je ne peux pas perdre<nbsp>!
msgctxt "NpcYell:3182:0:13"
msgid "I AM INVINCIBLE!"
msgstr "ТЕПЕРЬ МЕНЯ НЕ ПОБЕДИТЬ!"

#. ja: くっ……聞く耳すらもたんか……。
#. de: Mit Vernunft ist ihm nicht mehr beizukommen.
#. fr: Il n'écoute rien ou quoi<nbsp>?
msgctxt "NpcYell:3183:0:13"
msgid "No words will reach him now..."
msgstr "Теперь до него не достучаться..."

#. ja: 手ごわいぞ……締めてかからんと。
#. de: Furchtbar ... Der Schrecken muss ein Ende haben.
#. fr: Incroyable... Je dois l'arrêter<nbsp>!
msgctxt "NpcYell:3184:0:13"
msgid "Steel yourself. We face a desperate foe."
msgstr "Соберись. Враг загнан в угол и опасен."

#. ja: さあ……続きを始めようか。
#. de: Nur zu!
#. fr: En avant pour la suite<nbsp>!
msgctxt "NpcYell:3185:0:13"
msgid "COME, AND I SHALL SMITE YOU!"
msgstr "НУ ЖЕ! Я СОТРУ ТЕБЯ В ПОРОШОК!"

#. ja: なぜだ……これほどの力を得て、なお……。
#. de: Ich brodle über vor Kraft. Und doch ...
#. fr: Une telle puissance, et pourtant...
msgctxt "NpcYell:3186:0:13"
msgid "How can this be!?"
msgstr "Как такое возможно?!"

#. ja: なぜ、奴は……奴は倒れぬ……！
#. de: Wieso kann ich ihn nicht vernichten?
#. fr: Pourquoi, mais pourquoi<nbsp>!?
msgctxt "NpcYell:3187:0:13"
msgid "Such power is mine, and still the traitor does not fall!"
msgstr "С такой силой я всё равно не могу одолеть предателя!"

#. ja: かくなる上は……さらに力を……
#. de: Es reicht nicht ... Ich brauche mehr ...
#. fr: J'ai besoin... de plus de puissance...
msgctxt "NpcYell:3188:0:13"
msgid "I must have more strength..."
msgstr "Мне нужно... ещё больше силы..."

#. ja: もっと……もっと力を……！
#. de: Mehr Kraft ...
#. fr: Encore... Encore...
msgctxt "NpcYell:3189:0:13"
msgid "Give unto me the power...!"
msgstr "Дай мне силу...!"

#. ja: すべての力を……我に！
#. de: Nidhogg, gib mir all deine Kraft!
#. fr: Nidhogg, je t'en prie<nbsp>! Donne-moi tout ce que tu as<nbsp>!
msgctxt "NpcYell:3190:0:13"
msgid "Give unto me all there is to give!"
msgstr "Дай мне всю свою силу!"

#. ja: 己が限界を超えれば、待つのは死だ！
#. de: Gib auf, es ist zwecklos!
#. fr: Si tu continues comme ça, tu vas mourir<nbsp>!
msgctxt "NpcYell:3191:0:13"
msgid "You only hasten your own demise, Darkscale!"
msgstr "Ты лишь приближаешь свою гибель, Тёмная Чешуя!"

#. ja: フフフ……すべて呑みほしたぞ。
#. de: Mitnichten! Ich habe alles aufgesaugt!
#. fr: Toute la puissance de Nidhogg est en moi...
msgctxt "NpcYell:3192:0:13"
msgid "GRAHAHAHA... I HAVE DRUNK MY FILL."
msgstr "Гва-ха-ха... Я поглотил всю силу!"

#. ja: 己が限界を……超えたというのか……。
#. de: Du hast die Grenzen überwunden?
#. fr: Il a dépassé toutes les limites...
msgctxt "NpcYell:3193:0:13"
msgid "He has exceeded his physical limits."
msgstr "Он... превзошёл предел своих сил?"

#. ja: 何が奴を、そうさせる……？
#. de: Das ist unmöglich!
#. fr: C'est impossible<nbsp>!
msgctxt "NpcYell:3194:0:13"
msgid "What drives him to such madness...?"
msgstr "Что заставляет его так безумствовать?.."

#. ja: 来イ……コロシテヤル。
#. de: KOMM ... ICH ZEIGE ES DIR!
#. fr: JE VAIS TE TUER<nbsp>!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3195:0:13"
msgid "COME, TRAITOR!!!<br>I SHALL TEAR THE WINGS FROM YOUR BACK!!!"
msgstr "ИДИ СЮДА, ПРЕДАТЕЛЬ!!!<br>Я ВЫРВУ ТЕБЕ КРЫЛЬЯ!!!"

#. ja: 貴様ノ翼……鱗……スベテ、引キハガス！
#. de: ICH REISSE DIR DEINE SCHWINGEN UND SCHUPPEN EINZELN RAUS!
#. fr: JE VAIS DÉCHIRER TES AILES ET ARRACHER TES ÉCAILLES<nbsp>!
msgctxt "NpcYell:3196:0:13"
msgid "MY CLAWS SHALL RIP THE SCALES FROM YOUR FLESH AS MY FIRE CHARS YOUR CORPSE TO A SHRIVELED HUSK!!!"
msgstr "МОИ КОГТИ СОДРУТ С ТЕБЯ ЧЕШУЮ, А ПЛАМЯ СОЖЖЁТ ТВОЁ ТЕЛО ДОТЛА!!!"

#. ja: 骨ノ欠片モ残ラヌマデ……焼キ尽クス！
#. de: UND DANN BRENNST DU, BIS NUR NOCH ASCHE ÜBRIG IST!
#. fr: MES FLAMMES VONT TE CONSUMER<nbsp>!
msgctxt "NpcYell:3197:0:13"
msgid "YOU WILL BURN, VEDRFOLNIR! BURN!!!"
msgstr "ТЫ СГОРИШЬ, ВЕДРФОЛЬНИР! СГОРИШЬ!!!"

#. ja: 力に溺れ、心を失ったか……。
#. de: Deine Kraft hat dir den Verstand geraubt!
#. fr: La folie a eu raison de lui...
msgctxt "NpcYell:3198:0:13"
msgid "Alas, the proud dragon who once lived is now gone..."
msgstr "Увы, от гордого дракона, каким он был, ничего не осталось..."

#. ja: 破壊への衝動に呑まれ、竜の誇りを失いし者よ……。
#. de: Du hast deinen Stolz verloren!
#. fr: Où est passée ta fierté<nbsp>?
msgctxt "NpcYell:3199:0:13"
msgid "Consumed by power and hate, he is but a machine of destruction now."
msgstr "Сила и ненависть поглотили его. Теперь он лишь орудие разрушения."

#. ja: 我が引導を渡す！
#. de: Und nun soll dein Leben folgen!
#. fr: Ta vie est finie<nbsp>!
msgctxt "NpcYell:3200:0:13"
msgid "Join me, mortal, and let us put Darkscale out of his misery!"
msgstr "Присоединяйся ко мне, смертный, и избавим Тёмную Чешую от мучений!"

#. ja: 我ガ……敗レタノカ……？
#. de: MEINE KRÄFTE ... VERLASSEN MICH ...
#. fr: MA PUISSANCE... ELLE A DISPARU<nbsp>!
msgctxt "NpcYell:3201:0:13"
msgid "THIS CANNOT BE!"
msgstr "ЭТОГО НЕ МОЖЕТ БЫТЬ!"

#. ja: 裏切リ者ニ……負ケルハズガ……。
#. de: DEN VERRÄTERN UNTERLIEGEN ...?
#. fr: JE NE PEUX PAS PERDRE...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3202:0:13"
msgid "I AM DARKSCALE, GENERAL OF NIDHOGG!<br>I WILL NOT FALL TO THIS TRAITOR!"
msgstr "Я — ТЁМНАЯ ЧЕШУЯ, ГЕНЕРАЛ НИДХОГГА!<br>Я НЕ ПАДУ ОТ РУК ПРЕДАТЕЛЯ!"

#. ja: グォオオ……何故……何故ダ……！？
#. de: DAS KANN NICHT SEIN ... DAS DARF NICHT SEEEIIIN!
#. fr: NON... NOOOON<nbsp>!!
msgctxt "NpcYell:3203:0:13"
msgid "I MUST HAVE MORE POWER...! More...power..."
msgstr "МНЕ НУЖНО БОЛЬШЕ СИЛЫ...! Ещё... силы..."

#. ja: これが、力に溺れるということだ……。
#. de: Ertrunken im Wahn der eigenen Macht ...
#. fr: Voilà le résultat quand on vend son âme...
msgctxt "NpcYell:3204:0:13"
msgid "...It is over."
msgstr "...Всё кончено."

#. ja: 気分は晴れぬが……やっと、平安が訪れた。
#. de: Endlich kehrt Frieden ein,<br>auch wenn mein Herz voll Kummer ist.
#. fr: La paix est enfin revenue...
msgctxt "NpcYell:3205:0:13"
msgid "I take no joy in Darkscale's end, but at last, these halls will know peace again."
msgstr "Не рад я гибели Тёмной Чешуи, но наконец-то в этих стенах вновь воцарится мир."

#. ja: さて、我は白亜の宮殿に戻る。
#. de: Ich kehre zum Kreidetempel zurück.
#. fr: Je vais retourner à Zénith.
msgctxt "NpcYell:3206:0:13"
msgid "I must return to Zenith."
msgstr "Мне пора вернуться в Зенит."

#. ja: 比類なきヒトの英傑よ、また会おうぞ！
#. de: Es war eine Ehre, mit dir zu kämpfen, Held<if $gn4>in</if> der Sterblichen.
#. fr: Ce fut un honneur de combattre à tes côtés, mortel<if $gn4>le</if>.
msgctxt "NpcYell:3207:0:13"
msgid "Till we meet again, O hero among mortals."
msgstr "До новой встречи, о герой среди смертных!"

#. ja: これは…！？<br>我がアダマンクローたちがっ！
#. de: Meine schönen Klauen!
#. fr: Oh non<nbsp>! Mes belles griffes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3208:0:13"
msgid "My claws! My precious adamantite claws!<br>Look what you've done to them!"
msgstr "Мои когти! Мои драгоценные адамантитовые когти!<br>Посмотри, что ты с ними сделал!"

#. ja: おのれ…！<br>我が愛機ですり潰す！
#. de: Na warte, das wirst du büßen!
#. fr: Attends... C'est toi qui as fait ça<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3209:0:13"
msgid "Oh, you'll pay! Don't think<br>that you won't pay!"
msgstr "Ах ты...! Ты за это заплатишь! И даже<br>не надейся, что сможешь отвертеться!"

#. ja: 絶対に許さんっ！
#. de: Damit kommst du nicht durch!
#. fr: Tu vas me le payer<nbsp>!
msgctxt "NpcYell:3210:0:13"
msgid "Philistine!"
msgstr "Невежда!"

#. ja: 機械の無念…<br>晴らしてくれる！
#. de: Rache für meine Klauen!
#. fr: Vengeance<nbsp>!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3211:0:13"
msgid "For your wanton destruction,<br>I sentence you to death!"
msgstr "За бессмысленное уничтожение<br>моих творений я приговариваю тебя к смерти!"

#. ja: どれほど手間をかけたと思う！
#. de: Ich hatte sie gerade erst geölt!
#. fr: Tu sais le temps que ça m'a pris<nbsp>?
msgctxt "NpcYell:3212:0:13"
msgid "How dare you!"
msgstr "Как ты посмел?!"

#. ja: クッ……この力、あなどれぬ！
#. de: Seine Kraft ist unermesslich!
#. fr: Sa puissance est incommensurable<nbsp>!
msgctxt "NpcYell:3213:0:13"
msgid "Our foe is strong..."
msgstr "Наш враг силён..."

#. ja: 先程までとは、比べものにならん！
#. de: Kein Vergleich zu gerade!
#. fr: Ça dépasse l'entendement<nbsp>!
msgctxt "NpcYell:3214:0:13"
msgid "...and his power grows with each passing moment."
msgstr "...и с каждой минутой становится ещё сильнее."

#. ja: 我が戦わねば、護れぬものがある……。
#. de: Doch Rückzug steht nicht zur Debatte.
#. fr: Je ne peux pas abandonner maintenant...
msgctxt "NpcYell:3215:0:13"
msgid "But if not I, who shall defend the spire!?"
msgstr "Но если не я, кто защитит шпиль?!"

#. ja: 故に我は、退かぬ！
#. de: Ich muss meine Heimat beschützen!
#. fr: Je dois me battre<nbsp>!
msgctxt "NpcYell:3216:0:13"
msgid "Yes, I must fight on!"
msgstr "Да, я должен продолжать сражаться!"

#. ja: 護るべき者たちを、護るために！
#. de: Für die Kinder des Kreidetempels!
#. fr: Pour tous mes amis<nbsp>!
msgctxt "NpcYell:3217:0:13"
msgid "I will not abandon those who suffer at Darkscale's ravaging claws!"
msgstr "Я не оставлю тех, кто страдает от свирепых когтей Тёмной Чешуи!"

#. ja: 馬鹿な……全霊の技も、通じぬとは……。
#. de: Selbst meine stärksten Angriffe ... verpuffen ...
#. fr: Mes attaques n'ont plus aucun effet...
msgctxt "NpcYell:3218:0:13"
msgid "It does not even scathe him...? Inconceivable!"
msgstr "Он даже не поцарапан?.. Непостижимость!"

#. ja: このままでは……勝てぬ……。
#. de: So kann ich nicht gewinnen ...
#. fr: Je n'y arriverai jamais...
msgctxt "NpcYell:3219:0:13"
msgid "Do we battle in vain...?"
msgstr "Неужели мы сражаемся напрасно?.."

#. ja: 誇りを捨てた者に……負けるのか……。
#. de: Das Böse ... darf nicht triumphieren ...
#. fr: Le Mal ne doit pas triompher<nbsp>!
msgctxt "NpcYell:3220:0:13"
msgid "No! I will not fall to this fiend who casts away his pride!"
msgstr "Нет! Я не паду от руки чудовища, отбросившего гордость!"

#. ja: 何とか……何とかせねば！
#. de: Ich muss ... etwas tun.
#. fr: Je dois me ressaisir...
msgctxt "NpcYell:3221:0:13"
msgid "I must prevail!"
msgstr "Я должен победить!"

#. ja: せめて……一矢報いん！
#. de: Wenigstens ein ... Schlag der schmerzt ...
#. fr: Encore un coup, un seul...
msgctxt "NpcYell:3222:0:13"
msgid "Even if I must give my life in the trying!"
msgstr "Даже если придётся отдать за это жизнь!"

#. ja: 荒ぶる力を……止められなかった……。
#. de: Ich konnte seine Urgewalt ... nicht stoppen ...
#. fr: Je n'ai rien pu faire...
msgctxt "NpcYell:3223:0:13"
msgid "Have I...failed?"
msgstr "Неужели... я потерпел поражение?"

#. ja: 無念……。
#. de: Es ist eine Tragödie ...
#. fr: C'est horrible...
msgctxt "NpcYell:3224:0:13"
msgid "His power... It was too great..."
msgstr "Его силы... оказались слишком велики..."

#. ja: フレースヴェルグ様……申し訳ありません……。
#. de: Verzeih mir ... Hraesvelgr ...
#. fr: Hraesvelgr... Pardon...
msgctxt "NpcYell:3225:0:13"
msgid "Forgive me...my lord..."
msgstr "Простите меня... мой господин..."

#. ja: フフフ……ハッハハハハ！
#. de: Hahaha ... Muwahahahaha!
#. fr: Hahaha... Hahahahahaha<nbsp>!!
msgctxt "NpcYell:3226:0:13"
msgid "GRAHAHAHA!"
msgstr "ГРАХАХАХА!"

#. ja: ウォォオオ……ツイニ……ついに裏切り者を……。<br>葬り去った！
#. de: Der Verräter hat seine gerechte Strafe erfahren!
#. fr: Le traître est enfin tombé<nbsp>!
msgctxt "NpcYell:3227:0:13"
msgid "YOU DIE AS YOU LIVED─A TRAITOR!"
msgstr "ТЫ УМИРАЕШЬ ТАК ЖЕ, КАК ЖИЛ, — ПРЕДАТЕЛЕМ!"

#. ja: 奴らを根絶やしにしてやる！
#. de: Und alle anderen werden folgen!
#. fr: Exterminez-les tous<nbsp>!
msgctxt "NpcYell:3228:0:13"
msgid "NOW YOUR FOUL BROOD WILL FEEL MY FLAMES!"
msgstr "А ТЕПЕРЬ МОЯ СКВЕРНАЯ ПОРОСЛЬ ПОЗНАЕТ МОЁ ПЛАМЯ!"

#. ja: フハハ……震えて待つがよい！
#. de: Erzittert vor der Macht der Horde!
#. fr: Tremblez, vermines<nbsp>!
msgctxt "NpcYell:3229:0:13"
msgid "KNOW YOUR TRUE LORD, DRAGONLINGS! AND FEAR HIM!"
msgstr "УЗРИТЕ СВОЕГО ИСТИННОГО ГОСПОДИНА, ДРАКОНЬИ ДЕТЁНЫШИ! И ТРЕПЕЩИТЕ ПЕРЕД НИМ!"

#. ja: 貴重な食料、釣り上げてやる！
#. de: Heut fang ich Lachs! Das wird die Kinder freuen!
#. fr: Je sens que la pêche va être bonne<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3230:0:13"
msgid "This looks as good<br>a place as any, I reckon."
msgstr "Место вроде подходящее,<br>сгодится, пожалуй."

#. ja: …ん、何の足音だ？
#. de: Hm? Was war das für ein Geräusch!
#. fr: Des... Des bruits de pas<nbsp>?
msgctxt "NpcYell:3231:0:13"
msgid "What in the seven hells?"
msgstr "Какого чёрта?"

#. ja: やばい、熊だっ！
#. de: Bären! Rette mich wer kann!
#. fr: Des ours<nbsp>! Au secours<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3232:0:13"
msgid "Blimey!<br>Bloody brown bears!"
msgstr "Вот чёрт!<br>Проклятые бурые медведи!"

#. ja: 釣るなら今しかない<br>すまんが、追い払ってくれ！
#. de: Dies ist meine einzige Chance! Vertreib die Bären!
#. fr: Par pitié, renvoyez-les d'où ils viennent<nbsp>!
#. macro: <if $gn4>milady<else>milord</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3233:0:13"
msgid "Please, <if $gn4>milady<else>milord</if>! I beg ye!<br>Drive the beasts afield!"
msgstr "Прошу, <if $gn4>миледи<else>милорд</if>! Умоляю вас!<br>Прогоните зверей!"

#. ja: サーモンが逃げちまう…
#. de: Die haben alle Lachse vertrieben ... oder vertilgt.
#. fr: Oh non, j'ai laissé échapper un saumon...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3234:0:13"
msgid "The salmon...<br>I'm doomed..."
msgstr "Лососи...<br>Мне конец..."

#. ja: これで安心して釣りができる
#. de: Danke, jetzt kann ich in Ruhe weiterangeln.
#. fr: Ouf, je peux enfin pêcher en paix.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3235:0:13"
msgid "Now if I can just catch<br>something...anything."
msgstr "Теперь бы только поймать<br>хоть что-нибудь..."

#. ja: 俺の邪魔をさせないでくれ
#. de: Halt mir die Bären vom Leib!
#. fr: Maintenez les ours loin de moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3236:0:13"
msgid "The wife'll have me<br>head if I come home<br>without a catch."
msgstr "Жена мне голову<br>оторвёт, если я вернусь<br>без улова."

#. ja: サーモンはまだいるか…？
#. de: Hoffentlich lassen die mir welche übrig.
#. fr: Petit saumon, où es-tu<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3237:0:13"
msgid "All this thrashin' about...<br>There won't be a fish<br>left in the entire river!"
msgstr "От такого шума...<br>В реке скоро ни одной<br>рыбы не останется!"

#. ja: 絶対に釣り上げるぞ
#. de: Ohne Lachs darf ich mich Zuhause nicht blicken lassen.
#. fr: Toi, je vais t'avoir<nbsp>!
msgctxt "NpcYell:3238:0:13"
msgid "Bite, godsdamn you! Bite!"
msgstr "Клюй же, проклятье! Клюй!"

#. ja: クッ……思った以上に、やる。
#. de: Du bist stark ... Stärker als gedacht.
#. fr: Tu es plus fort que je le croyais...
msgctxt "NpcYell:3239:0:13"
msgid "Ugh... You are strong..."
msgstr "Уф... Ты силён..."

#. ja: 止むを得ん……退くか。
#. de: Mir bleibt wohl nur die Flucht.
#. fr: Je vais devoir remettre notre combat à plus tard.
msgctxt "NpcYell:3240:0:13"
msgid "The day is yours, but you have not seen the last of me."
msgstr "Сегодня ты победил, но мы ещё встретимся."

#. ja: 逃げる気か？
#. de: Die steht dir gut zu Gesicht, Verräter.
#. fr: Eh<nbsp>! Où est-ce que tu vas comme ça<nbsp>?
msgctxt "NpcYell:3241:0:13"
msgid "You would flee?"
msgstr "Убегаешь?"

#. ja: しょせんは、裏切り者か！
#. de: Hol einmal tief Luft.
#. fr: Espèce de lâche<nbsp>!
msgctxt "NpcYell:3242:0:13"
msgid "You are a craven and a traitor both!"
msgstr "Ты и трус, и предатель!"

#. ja: 次は、手ぬるい真似はせんぞ。
#. de: Es wird das letzte Mal sein!
#. fr: La prochaine fois, tu ne t'en sortiras pas comme ça<nbsp>!
msgctxt "NpcYell:3243:0:13"
msgid "When next we meet, you will not leave with your life."
msgstr "В следующий раз ты отсюда живым не уйдёшь."

#. ja: まだまだ、終わらんぞ！
#. de: Ich bin längst nicht am Ende!
#. fr: C'est pas encore fini<nbsp>!
msgctxt "NpcYell:3244:0:13"
msgid "We have only just begun!"
msgstr "Мы только начали!"

#. ja: この程度で倒れはせん！
#. de: Das soll mich niederringen? Lächerlich.
#. fr: C'est ça que tu appelles se battre<nbsp>?
msgctxt "NpcYell:3245:0:13"
msgid "You'll not best me so easily!"
msgstr "Так просто меня не одолеть!"

#. ja: 貴様を倒すまで、倒れん！
#. de: Vor dir sterb ich bestimmt nicht!
#. fr: Tu tomberas le premier<nbsp>!
msgctxt "NpcYell:3246:0:13"
msgid "I will kill you if it is the last thing I do!"
msgstr "Я убью тебя, чего бы мне это ни стоило!"

#. ja: 魔物の襲来だ！
#. de: Ein Schwarm Geira-Katzen!
#. fr: Attention, ils attaquent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3247:0:13"
msgid "Vileki─ No... Those aren't<br>vilekin... They're..."
msgstr "Вилеки... Нет, это не<br>вилеки... Это..."

#. ja: またゲイラキャットか！
#. de: Sie sind auf dem Weg hierher!
#. fr: Encore des gaélichats<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3248:0:13"
msgid "Gaelicats!<br>Scores of them!"
msgstr "Гаэликаты!<br>Их тут целая тьма!"

#. ja: 糧食を死守しろ！
#. de: Wir müssen die Vorräte schützen!
#. fr: Protégez nos vivres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3249:0:13"
msgid "Twelve help us! They've<br>come for the bloody mint!"
msgstr "Двенадцать, помогите! Они<br>пришли за проклятой мятой!"

#. ja: 食いモノは渡さん！
#. de: Dies ist kein Futterplatz!
#. fr: Enlève tes sales pattes de là<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3250:0:13"
msgid "Keep that mint safe,<br>or we'll be elbow-deep<br>in vilekin as well!"
msgstr "Не дадим им мяты!<br>А то и сами по уши<br>вилеками обрастём!"

#. ja: しつこいな…
#. de: Gebt endlich auf!
#. fr: Ils sont vraiment tenaces...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3251:0:13"
msgid "The mint has sent the<br>things into a right frenzy!"
msgstr "Из-за мяты эти твари<br>совсем взбесились!"

#. ja: なんとか守りきった…
#. de: Das ist gerade noch<br>mal gut gegangen.
#. fr: Ouf, on l'a échappé belle...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3252:0:13"
msgid "Might serve us better if<br>we tossed the mint back<br>down to Ishgard..."
msgstr "Лучше бы нам выкинуть<br>мяту обратно в Ишгард..."

#. ja: オレたちの糧食が…！
#. de: O weh, jetzt heißt es Hungern ...
#. fr: Oh non<nbsp>! Qu'est-ce qu'on va manger maintenant<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3253:0:13"
msgid "At least they won't<br>be coming back?"
msgstr "Хоть обратно-то они<br>не вернутся?"

#. ja: 大漁の予感…！
#. de: Heut mach ich 'nen Riesenfang!
#. fr: Un gros va mordre à l'hameçon, je le sens<nbsp>!
msgctxt "NpcYell:3254:0:13"
msgid "What's that smell...?"
msgstr "Чем это пахнет?.."

#. ja: うわ、オブデラだ！
#. de: Igitt! Hier ist ja alles voller Obdellas!
#. fr: Ouah<nbsp>! Un obdella<nbsp>!
msgctxt "NpcYell:3255:0:13"
msgid "By the Fury! Giant leeches!"
msgstr "Ярость! Гигантские пиявки!"

#. ja: 絶体絶命…？
#. de: Und durstig sehen sie aus!
#. fr: La situation est critique<nbsp>!
msgctxt "NpcYell:3256:0:13"
msgid "I think I'm done for..."
msgstr "Мне, кажется, конец..."

#. ja: 誰か、助けてくれ！
#. de: Hilfe! Ich will nicht sterben!
#. fr: Aaaah<nbsp>! Je ne veux pas mourir<nbsp>!
msgctxt "NpcYell:3257:0:13"
msgid "Somebody, anybody!"
msgstr "Кто-нибудь! Помогите!"

#. ja: 救援に感謝する！
#. de: Das war Rettung in letzter Sekunde! Danke!
#. fr: Il s'en est fallu de peu<nbsp>! Merci beaucoup<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3258:0:13"
msgid "Thanks for the help,<br>mysterious stranger!"
msgstr "Спасибо за помощь,<br>таинственный незнакомец!"

#. ja: 死ぬかと思ったぜ…
#. de: Na ja, immerhin leb ich noch ...
#. fr: J'ai bien cru que j'allais y passer...
msgctxt "NpcYell:3259:0:13"
msgid "What a horrid experience..."
msgstr "Вот уж жуткое приключение..."

#. ja: 気取られたか！？
#. de: Gundo? Was suchen die hier?
#. fr: Qu'est-ce qu'ils font ici<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3262:0:13"
msgid "Oi! Gundu! The whole bloody<br>lot of you are cravens!"
msgstr "Эй, гунду! Да вы все<br>просто трусы!"

#. ja: 作戦情報が漏れたとでも…？
#. de: Haben sie Wind von unserem Plan bekommen?
#. fr: Comment ont-ils découvert notre plan<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3263:0:13"
msgid "Bowing and scraping for your<br>Vundu masters! How pathetic!"
msgstr "Пресмыкаетесь перед<br>своими хозяевами вунду! Жалкое зрелище!"

#. ja: 身を隠すぞ、急げ！
#. de: Nichts wie weg!
#. fr: Vite, il faut qu'on se cache<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3264:0:13"
msgid "Like furious summer squall I<br>piss on the Gundu! Hear me!?<br>I piss on you!"
msgstr "Я, как летняя буря, мочусь на гунду! Слышите!?<br>На вас мочусь!"

#. ja: 出てこい！<br>寒風の如く歓迎されざるヒトども
#. de: Na-Vanu-eeh rauskommen! Wir euch Empfang warm wie Magen von Sanuwa bereiten!
#. fr: Montrez-vous, humains<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3265:0:13"
msgid "Foul-mouthed netherling!<br>Show yourself!"
msgstr "Грязный языкастый чужеземец!<br>Покажись!"

#. ja: そこにいるのは<br>真昼の陽射しよりも、明らか！
#. de: Dass Na-Vanu-eeh hier sind ist so klar wie Quellwasser!
#. fr: Ils sont là, c'est clair comme de l'eau de roche<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3266:0:13"
msgid "Piss on Gundu!?<br>Gundu piss on your corpse!"
msgstr "Мочишься на гунду!?<br>Гунду помочится на твой труп!"

#. ja: 逃がしはせんぞ！<br>籠の鳥のように追いつめてやる！
#. de: Vundo-ooh lassen Na-Vanu-eeh nicht entkommen! Suchen mit Augen von Montisaurus!
#. fr: Vous êtes faits comme des rats<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3267:0:13"
msgid "As surely as sun rises and sets,<br>Gundu find and punish netherling!"
msgstr "Как солнце встаёт и садится,<br>гунду найдёт чужеземца и покарает!"

#. ja: ここから出てゆけ！<br>漁場の岩礁の如き邪魔者よ！
#. de: Na-Vanu-eeh sind lästig wie Flöhe in Federn!
#. fr: Arrêtez de nous chercher des puces dans les plumes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3268:0:13"
msgid "Begone, dark ones!<br>These lands belong to Vundu!"
msgstr "Прочь, тёмные!<br>Эти земли принадлежат вунду!"

#. ja: 殺せ！<br>罠にかかりし飛猫の如く！
#. de: Vanu-ooh häutet Na-Vanu-eeh wie fliegende Katzen!
#. fr: Embrochez-les comme des gaélichats prêts à être rôtis<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3269:0:13"
msgid "Meddlesome as gaelicats!<br>Kill them all! Kill them all!"
msgstr "Надоедливые, как гаэликаты!<br>Убейте их всех! Всех до единого!"

#. ja: ここまでやるとは…<br>地に伏せた竜の如く、侮れぬ敵
#. de: Na-Vanu-eeh ist schändlich wie Drache ohne Flügel! \<spuck>
#. fr: Vous êtes aussi résistants que des dragons...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3270:0:13"
msgid "Netherling is strong, like a<br>dragon without wings."
msgstr "Чужеземец силён, как<br>дракон без крыльев."

#. ja: 今日は退く<br>陽光と同じく、時の運もまた巡る
#. de: Heute flieht Vanu-ooh! Aber Vanu-ooh kommt wieder wie Sonne am Morgen!
#. fr: Nous reviendrons comme le soleil du matin, humains<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3271:0:13"
msgid "The skies grow dark...<br>Kena Vanu will fight<br>another day."
msgstr "Небо темнеет...<br>Кена Вану сразится<br>в другой день."

#. ja: 次は、こうはいかぬぞ<br>我に逆らうは、天に仇なす愚行
#. de: Und dann bringt Vanu-ooh großen Bruder! Na-Vanu-eeh wird gucken mit Augen groß wie Frosch in Schnabel von Storch!
#. fr: Ceux qui osent s'opposer à nous connaîtront le courroux des cieux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3272:0:13"
msgid "As sure as the night swallows<br>the sun, your time will come..."
msgstr "Как ночь поглощает<br>солнце, так придёт и ваш час..."

#. ja: ケナバヌ様のためなら…<br>雲海の藻屑ともなろう！
#. de: Für Kena Vanu würde Vanu-ooh sogar Wolken teilen!
#. fr: Kena Vanu, bénis-nous de ta lumière<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3273:0:13"
msgid "For Kena Vanu, Vundu<br>would cast himself into<br>the swirling winds!"
msgstr "Ради Кены Вану вунду<br>бросится в водоворот<br>ветров!"

#. ja: 純白の雲を汚す<br>不届き者どもめ！
#. de: Na-Vanu-eeh ist schwarzer Fleck im weißen Wolkenmeer!
#. fr: Vous n'aurez pas L'Écume des cieux, humains<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3274:0:13"
msgid "Netherling will pay for<br>sullying the white of the<br>clouds─in blood!"
msgstr "Чужеземец заплатит<br>кровью за то, что осквернил<br>белизну облаков!"

#. ja: 信仰薄き者たちよ<br>雲神様にかわり、裁かん！
#. de: Vanu-ooh wird Na-Vanu-eeh für Weißegott strafen!
#. fr: Notre foi est la plus forte<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3275:0:13"
msgid "Infidels! You will suffer<br>the divine judgment of<br>the White!"
msgstr "Неверные! Вы познаете<br>божественную кару<br>Белого!"

#. ja: 我らに挑むとは<br>雲神様に歯向う雲海魚の如し
#. de: Vanu-ooh wird Na-Vanu-eeh zerquetschen wie Gastornis-Eier!
#. fr: Le Migrateur des brumes vous punira pour vos péchés<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3276:0:13"
msgid "To stand against Kena Vanu<br>is as a minnow baring its<br>teeth against the White."
msgstr "Встать против Кены Вану —<br>всё равно что пескарю<br>оскалиться на Белого."

#. ja: スクヴェイダーよ<br>逆らう者は地虫の如く蹴散らせ！
#. de: Skvader, zerhacke Na-Vanu-eeh wie Würmer im Boden!
#. fr: Skvader, écrase ces insectes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3277:0:13"
msgid "Come, Skvader! Crush<br>these netherlings like<br>gastornis eggs!"
msgstr "Вперёд, Сквадер! Раздави<br>этих чужеземцев, как<br>яйца гасторниса!"

#. ja: 全力で来ねば<br>陽光が消える日まで後悔するぞ
#. de: Na-Vanu-eeh wird untergehen wie Abendsonne!
#. fr: Le soleil ne se lèvera plus pour vous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3278:0:13"
msgid "The sun shall soon<br>set on you, netherling!"
msgstr "Скоро для тебя,<br>чужеземец, зайдёт солнце!"

#. ja: 我を倒すなど…<br>浮島を沈めるに等しい難業
#. de: Solange Insel nicht vom Himmel fallen, fällt auch Vanu-ooh nicht!
#. fr: Nous ne pouvons pas perdre... Toute la Mer de nuages ne pourra pas cacher notre honte<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3279:0:13"
msgid "This island will fall from<br>the sky before a netherling<br>defeats Kena Vanu!"
msgstr "Этот остров скорее рухнет<br>с небес, чем чужеземец<br>победит Кену Вану!"

#. ja: 我に仇なす、雲上の愚か者よ…<br>絶望の味を知れ！
#. de: Närrische Na-Vanu-eeh. Schmeckt Ver<shy>zweif<shy>lung!
#. fr: Vous allez goûter au désespoir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3280:0:13"
msgid "Foolish netherling!<br>Drink from the rains<br>of despair!"
msgstr "Глупый чужеземец!<br>Испей из дождей<br>отчаяния!"

#. ja: 貴様！<br>前に会ったときは、よくも邪魔をしてくれたな！
#. de: Du! Du hast mich das letzte Mal gestört!
#. fr: C'est pas la première fois qu'on croise le fer, toi et moi<nbsp>!
msgctxt "NpcYell:3281:0:13"
msgid "You'll not interfere again!"
msgstr "На этот раз я не позволю тебе вмешаться!"

#. ja: まだ懲りてはおらんのか……。
#. de: Wisse, wann man besser aufhört!
#. fr: Quel entêté...
msgctxt "NpcYell:3282:0:13"
msgid "Have you not had enough?"
msgstr "Тебе всё ещё мало?"

#. ja: フハハ……ここからが本番だぞ！
#. de: Muwahaha! Ich fang gerade erst an!
#. fr: À partir de maintenant, pas de quartier<nbsp>!
msgctxt "NpcYell:3283:0:13"
msgid "The true battle begins now!"
msgstr "Ха-ха-ха... Вот теперь-то всё и начинается!"

#. ja: 裏切り者め、思い知るがいい！
#. de: Büße für deinen Verrat!
#. fr: Tu vas payer pour ta trahison<nbsp>!
msgctxt "NpcYell:3284:0:13"
msgid "Your reckoning is nigh, traitor!"
msgstr "Тебе близок час расплаты, предатель!"

#. ja: クッ……まずいな。
#. de: Argh ... Verflucht!
#. fr: Argh<nbsp>! Malédiction<nbsp>!
msgctxt "NpcYell:3285:0:13"
msgid "This bodes ill..."
msgstr "Дело плохо..."

#. ja: このままでは、済まさん！
#. de: Meine Kräfte schwinden ...
#. fr: Je n'ai plus de forces...
msgctxt "NpcYell:3286:0:13"
msgid "No, it will not end like this!"
msgstr "Нет, так это не закончится!"

#. ja: 地獄の果てまで、つきあってもらおう。
#. de: Begleite mich in die Hölle!
#. fr: Tu vas m'accompagner en enfer<nbsp>!
msgctxt "NpcYell:3287:0:13"
msgid "You shall join me in the abyss!"
msgstr "Ты отправишься со мной в бездну!"

#. ja: ククク……遊び甲斐のありそうな玩具だな。
#. de: Hehe ... Ein viel<shy>ver<shy>sprechendes Spielzeug.
#. fr: Hé hé, je sens que je vais bien m'amuser...
msgctxt "NpcYell:3290:0:13"
msgid "My, such feisty prey!"
msgstr "Хе-хе-хе... Какая бойкая добыча!"

#. ja: こいつ……戦いを楽しんでいる……？
#. de: Kämpfen scheint ihm Spaß zu machen.
#. fr: Il ne vit donc que pour se battre<nbsp>?
msgctxt "NpcYell:3291:0:13"
msgid "You lust for blood? I shall give it to you!"
msgstr "Жаждешь крови? Что ж, я тебе её обеспечу!"

#. ja: 命のやりとり……これぞ、最高の遊戯！
#. de: Auf Leben und Tod spiel ich am liebsten!
#. fr: La vie n'est qu'un jeu qu'on joue avec la mort, ha ha ha<nbsp>!
msgctxt "NpcYell:3292:0:13"
msgid "There is no greater thrill than the hunt!"
msgstr "Охота — вот что будоражит кровь!"

#. ja: フハハ……最高の玩具だな！
#. de: Haha ... Sehr unterhaltsam!
#. fr: Ha ha ha... Très amusant<nbsp>!
msgctxt "NpcYell:3293:0:13"
msgid "Yesss, this is what I live for!"
msgstr "Да-а-а, вот ради чего я живу!"

#. ja: ククク……心地よい感触だ……。
#. de: Wie ich das liebe!
#. fr: C'est tout ce que j'aime<nbsp>!
msgctxt "NpcYell:3294:0:13"
msgid "Hahaha! I love it!"
msgstr "Ха-ха-ха! Как же мне это нравится!"

#. ja: 味わわせてくれ……最高の戯れを。
#. de: Weiter so! Weiter!
#. fr: Viens jouer avec moi, hé hé hé...
msgctxt "NpcYell:3295:0:13"
msgid "Nothing stirs the blood like struggling prey!"
msgstr "Ничто так не будоражит кровь, как бьющаяся добыча!"

#. ja: クッ……ここまで、てこずるとは。
#. de: \<ächz> ... Das ist schwerer, als erwartet.
#. fr: Ça risque d'être plus difficile que prévu...
msgctxt "NpcYell:3299:0:13"
msgid "Confound it..."
msgstr "Проклятье..."

#. ja: こやつら……なかなか、やりおる……。
#. de: Ich habe ... die Horde unterschätzt ...
#. fr: Je les ai... sous-estimés...
msgctxt "NpcYell:3300:0:13"
msgid "That I should be pressed so by their ilk..."
msgstr "И надо же было так увязнуть с этими..."

#. ja: ここまで追いつめられるとは……。
#. de: Mit solch heftigem Widerstand habe ich nicht gerechnet ...
#. fr: Je ne m'attendais pas à une telle résistance...
msgctxt "NpcYell:3301:0:13"
msgid "I had not reckoned upon this..."
msgstr "Не думал, что столкнусь с таким..."

#. ja: まずい、このままでは……！
#. de: Meine Wunden ... sind zu stark ...
#. fr: Mes blessures... sont trop profondes...
msgctxt "NpcYell:3302:0:13"
msgid "No, I cannot fall..."
msgstr "Нет, я не могу пасть..."

#. ja: いま一度、態勢を立て直す！
#. de: Im Rückzug liegt Stärke!
#. fr: Je n'ai pas le choix... Je dois battre en retraite<nbsp>!
msgctxt "NpcYell:3303:0:13"
msgid "Not here, not yet..."
msgstr "Не сейчас, ещё рано..."

#. ja: 借りは必ず返す！
#. de: Ich komme wieder, keine Frage!
#. fr: Je reviendrai, je le jure<nbsp>!
msgctxt "NpcYell:3304:0:13"
msgid "I must regather my strength..."
msgstr "Нужно набраться сил..."

#. ja: 逃げたか……臆病者め。
#. de: Da kriecht er davon, der Feigling!
#. fr: Quel poltron...
msgctxt "NpcYell:3305:0:13"
msgid "Fly like the craven you are!"
msgstr "Улетай, трус, кем ты и являешься!"

#. ja: 思い知ったか、裏切り者！
#. de: Lass dir das eine Lektion sein, Verräter!
#. fr: Que ça te serve de leçon, traître<nbsp>!
msgctxt "NpcYell:3306:0:13"
msgid "Know your folly, traitor!"
msgstr "Понял, до чего доводит глупость, предатель?"

#. ja: つまらんな……もっと楽しませてくれ。
#. de: Dabei fing es gerade an, Spaß zu machen ...
#. fr: Et dire que je commençais tout juste à m'amuser...
msgctxt "NpcYell:3307:0:13"
msgid "This bores me."
msgstr "Мне скучно."

#. ja: 存外に手間を取ったな……。
#. de: Ein hart erkämpfter Sieg ...
#. fr: C'était une rude bataille...
msgctxt "NpcYell:3308:0:13"
msgid "They were persistent if naught else."
msgstr "А они оказались крепче, чем я думал..."

#. ja: 貴重な刻を費やした……。
#. de: Doch ein bedeutender ...
#. fr: Voilà une victoire dont je me souviendrai.
msgctxt "NpcYell:3309:0:13"
msgid "We have wasted enough time here."
msgstr "Мы и так потеряли здесь слишком много времени."

#. ja: 奴はたしか、サルウーム・カシュに向かう、<br>と言っていたか……。
#. de: Tharl Oom Khash ist die Bastion der dreckigen Brut!
#. fr: Il a dit qu'il se rendrait à Tharl Oom Khash...
msgctxt "NpcYell:3310:0:13"
msgid "Darkscale is headed for Tharl Oom Khash."
msgstr "Тёмная Чешуя направляется в Тарл Ом Хаш."

#. ja: 待っておれ……いざ、決着をつけん！
#. de: Dort werde ich ihn zerquetschen!
#. fr: Je vais y aller aussi... pour en finir avec lui<nbsp>!
msgctxt "NpcYell:3311:0:13"
msgid "Let us go and settle this once and for all!"
msgstr "Пойдём и покончим с этим раз и навсегда!"

#. ja: 幼き血族よ、戻って手当てをしよう。
#. de: Lass uns zurückkehren und deine Wunden versorgen, mein Kind.
#. fr: Mais d'abord, nous devons soigner nos plaies.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3312:0:13"
msgid "Come, my young ones.<br>I will tend to your wounds."
msgstr "Идёмте, детки.<br>Я обработаю ваши раны."

#. ja: あのダークスケールを鎮めた力……。
#. de: Selbst Dunkelschuppe hatte dir nichts entgegenzusetzen.
#. fr: Hmm... Même Sombrécaille n'a rien pu faire contre toi...
msgctxt "NpcYell:3313:0:13"
msgid "To think that one of your kind could boast the strength to fell Nidhogg's trusted general..."
msgstr "Подумать только, кто-то из вашего народа сумел одолеть самого надёжного генерала Нидхёгга..."

#. ja: ヒトが秘めし、その力に興味があるのだ。
#. de: Ihr Sterblichen seid faszinierend.
#. fr: Les mortels sont vraiment fascinants, parfois...
msgctxt "NpcYell:3314:0:13"
msgid "You intrigue me, mortal."
msgstr "Ты меня заинтриговал, смертный."

#. ja: なかなか、やるな！
#. de: Beeindruckend.
#. fr: Je suis assez im<shy>pres<shy>sion<shy>né...
msgctxt "NpcYell:3315:0:13"
msgid "You are strong, yes!"
msgstr "А ты силён, да!"

#. ja: だが、その程度ではあるまい！
#. de: Doch längst nicht genug!
#. fr: Mais il en faudra plus pour provoquer mon admiration<nbsp>!
msgctxt "NpcYell:3316:0:13"
msgid "Yet you have not tapped the depths of your potential!"
msgstr "Но ты ещё не раскрыл весь свой потенциал!"

#. ja: ダークスケールを倒したときの、あの力！<br>もう一度、見せてくれ！
#. de: Kämpfe, als wäre ich Dunkelschuppe!
#. fr: Prouve-moi que ta puissance n'était pas une illusion<nbsp>!
msgctxt "NpcYell:3317:0:13"
msgid "Show me the strength by which you did slay the mighty Darkscale!"
msgstr "Покажи мне силу, с которой ты одолел могучую Тёмную Чешую!"

#. ja: やはり、我の考えは正しかった……。
#. de: Ich hatte Recht ...
#. fr: C'est bien ce que je me disais...
msgctxt "NpcYell:3318:0:13"
msgid "Yes! I knew that it was so..."
msgstr "Да! Я знал, что так и будет..."

#. ja: ヒトの秘めし力……それは、底知れぬ力。
#. de: Ihr Sterblichen seid unergründlich.
#. fr: Les mortels ont bien plus d'un tour dans leur sac.
msgctxt "NpcYell:3319:0:13"
msgid "The power ensconced within you is great indeed, mortal..."
msgstr "Сила, скрытая в тебе, и правда велика, смертный..."

#. ja: 我らの血族すら脅かす、強大な力……。
#. de: So mächtig, um sogar uns Drachen zu trotzen.
#. fr: Vaincre un dragon n'est pas donné à tout le monde.
msgctxt "NpcYell:3320:0:13"
msgid "Yes, the power to make even a mighty dragon tremble..."
msgstr "Да, такая сила способна заставить дрожать даже могучего дракона..."

#. ja: 汝らの限界……この目で、見究めん！
#. de: Zeig mir, wozu du fähig bist!
#. fr: Puisque c'est ainsi, montre-moi l'étendue de ta puissance<nbsp>!
msgctxt "NpcYell:3321:0:13"
msgid "I would see you harness your power to its limits, and beyond!"
msgstr "Я хочу увидеть, как ты раскроешь свою силу до предела — и даже больше!"

#. ja: まだまだ、全力ではないな！
#. de: Es steckt noch viel mehr in dir!
#. fr: Je sais que tu peux faire mieux<nbsp>!
msgctxt "NpcYell:3322:0:13"
msgid "There is more power in you yet, mortal!"
msgstr "В тебе ещё много силы, смертный!"

#. ja: 驚きを超えて……信じられぬ……。
#. de: Unglaublich!
#. fr: C'est... tout simplement prodigieux...
msgctxt "NpcYell:3323:0:13"
msgid "Impressive!"
msgstr "Впечатляет!"

#. ja: こんなに寄ってきてる…
#. de: Schwirrt ab, ihr Mistviecher!
#. fr: Ils arrivent de partout<nbsp>!
msgctxt "NpcYell:3324:0:13"
msgid "They're all over me!"
msgstr "Их тут целая туча!"

#. ja: た、助かった
#. de: Besten Dank!
#. fr: Merci...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3325:0:13"
msgid "They're gone...<br>They're finally gone!"
msgstr "Их больше нет...<br>Наконец-то отстали!"

#. ja: もう虫はこりごりだ…
#. de: Ich krieg noch 'ne Flohbie!
#. fr: Je n'en peux plus de ce bourdonnement...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3326:0:13"
msgid "That's it. I'm movin'<br>to Falcon's Nest!"
msgstr "Всё, хватит! Уеду<br>в Соколиное гнездо!"

#. ja: 勘弁してくれ～
#. de: Lasst mich in Ruhe!
#. fr: Aaah<nbsp>! Laissez-moi tranquille<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3327:0:13"
msgid "The damned things'll<br>suck me dry!"
msgstr "Проклятые твари<br>высосут из меня всю кровь!"

#. ja: なぜ虫がオレに…
#. de: Was finden die<br>Viecher nur an mir?
#. fr: Je ne vous ai rien demandé, par les Douze<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3328:0:13"
msgid "I've been cursed,<br>I tell ye!"
msgstr "Меня прокляли,<br>клянусь!"

#. ja: 虫め、近寄るな
#. de: Schwirrt ab, hab ich gesagt!
#. fr: Ouste, j'ai dit<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3329:0:13"
msgid "Find a bloody chocobo's<br>arse to suckle! "
msgstr "А ну прочь! Найдите себе<br>зад какого-нибудь чокобо!"

#. ja: 頼む、助けてくれ～
#. de: Halt mir die Dinger vom Leib!
#. fr: Aventuri<if $gn4>ère<else>er</if>, au secours<nbsp>!
msgctxt "NpcYell:3330:0:13"
msgid "Just keep 'em away..."
msgstr "Только держите их подальше..."

#. ja: 虫はもう願い下げだな
#. de: Ich hoffe, ich seh die nie wieder!
#. fr: Bon débarras<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3331:0:13"
msgid "I don't know how to<br>thank ye! Here's the<br>coin I promised."
msgstr "Не знаю, как вас<br>благодарить! Вот обещанные<br>деньги."

#. ja: シシシシシ…異常なし…
#. de: Hm, nichts Ungewöhnliches ...
#. fr: Ksss... Rien à signaler...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3332:0:13"
msgid "\\<click> \\<click><br>All is well."
msgstr ""

#. ja: いや、あれは敵！？<br>シシシシシ…異常アリだ！
#. de: Außer diese Miacis!
#. fr: Ksss<nbsp>? Des ennemis<nbsp>? Alerte<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:3333:0:13"
msgid "What!? Miacids!?<br>All is <i>not</i> well!"
msgstr "Что!? Миациды!?<br>Тут <i>не</i> всё в порядке!"

#. ja: ここは貴様らの場所ではない！<br>…シシシシシ
#. de: Bssst! Ihr habt hier nichts zu suchen!
#. fr: Vous n'avez rien à faire ici<nbsp>! Ksss ksss<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3334:0:13"
msgid "The vile fiends are<br>befouling the river!"
msgstr "Эти мерзкие твари<br>загрязняют реку!"

#. ja: シシシシシ…<br>そこのヒトら、頼む
#. de: Weichschalige<if $gn4><else>r</if>!
#. fr: Ksssss<nbsp>! Au secours<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3335:0:13"
msgid "\\<click> \\<click><br>You. Fleshling. Help me kill them."
msgstr ""

#. ja: 手を貸してはもらえぬか？<br>シシシシシ…
#. de: Bitte hilf uns!
#. fr: Aidez-nous, humains<nbsp>! Ksss ksss<nbsp>!
msgctxt "NpcYell:3336:0:13"
msgid "Come. We begin now!"
msgstr "Идём. Начинаем!"

#. ja: シシシシシ…恩に着る
#. de: Das werden wir dir nicht vergessen.
#. fr: Ksssss... Nous vous devons la vie, humains...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3337:0:13"
msgid "\\<click> \\<click><br>My thanks to you, fleshling."
msgstr ""

#. ja: シシシシシ…敵わぬか…
#. de: Elende Miacis ... Lasst uns in Ruhe!
#. fr: Ksssss... Nous sommes trop faibles...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3338:0:13"
msgid "\\<click> \\<click><br>You win this day, miacids.<br>But the war is not over..."
msgstr ""

#. ja: シシシシシ…<br>川は荒らさせぬ
#. de: Bleibt hinter dem Fluss!
#. fr: Kssss... Il ne faut pas troubler les flots...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3339:0:13"
msgid "\\<click> \\<click><br>Befoul our river, will you!?"
msgstr ""

#. ja: むう、多勢に無勢か<br>…シシシシシ
#. de: Wir sind in der Unterzahl!
#. fr: Nous ne sommes pas assez nombreux<nbsp>! Kssss<nbsp>!
msgctxt "NpcYell:3340:0:13"
msgid "They are many, but we are strong!"
msgstr "Их много, зато мы сильны!"

#. ja: 退散せよ！<br>…シシシシシ
#. de: Bssst, bssst, haut ab!
#. fr: Ksss<nbsp>! Retraite<nbsp>! Ksss<nbsp>!
msgctxt "NpcYell:3341:0:13"
msgid "\\<click> \\<click>"
msgstr ""

#. ja: 申し訳ありません…<br>イストリド様…
#. de: Verzeiht mir ...
#. fr: Dame Ystride...
msgctxt "NpcYell:3342:0:13"
msgid "M-My lady!"
msgstr "М-миледи!"

#. ja: シシシシシ…<br>すまぬ、仲間に知らせてくる
#. de: Ich warne die anderen!
#. fr: Je vais prévenir les autres, ksss ksss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3343:0:13"
msgid "\\<click> \\<click><br>I grow weak. I go to inform the others."
msgstr ""

#. ja: 相手できそうなら<br>やっちまってくれ…シシシシシ
#. de: Kämpfe weiter, wenn du kannst!
#. fr: Ksss<nbsp>! Battez-vous jusqu'à votre dernier souffle<nbsp>!
msgctxt "NpcYell:3344:0:13"
msgid "Carry on in my stead if you can..."
msgstr "Продолжайте за меня, если сможете..."

#. ja: シシシシシ…<br>狩りの刻だな
#. de: Die Jagd beginnt!
#. fr: Ksss... Que la chasse commence...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3345:0:13"
msgid "\\<click> \\<click><br>Look! Fresh meat."
msgstr ""

#. ja: 狩りつくせ…シシシシシ
#. de: Auf sie mit Gebrüll!
#. fr: À l'assaut<nbsp>! Ksss ksss<nbsp>!
msgctxt "NpcYell:3346:0:13"
msgid "The hunt begins."
msgstr "Охота начинается."

#. ja: シシシシシ…今宵は宴だ！
#. de: Das wird ein Festmahl!
#. fr: Kssss<nbsp>! C'est un vrai festin<nbsp>!
msgctxt "NpcYell:3347:0:13"
msgid "Tonight, we feast!"
msgstr "Сегодня у нас пир!"

#. ja: 今日はずらかるぞ<br>…シシシシシ
#. de: Rückzug, Rückzug!
#. fr: Kssss<nbsp>! On fout le camp<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3348:0:13"
msgid "\\<click> \\<click><br>Pull back! Pull back!"
msgstr ""

#. ja: このへんで勘弁してやる<br>…シシシシシ
#. de: Das reicht für heute ...
#. fr: Ça ira pour aujourd'hui, ksss...
msgctxt "NpcYell:3349:0:13"
msgid "It will not suffice..."
msgstr "Этого мало..."

#. ja: 肉だ、肉だ…シシシシシ！
#. de: Fleisch, Fleisch!
#. fr: Kss kss... De la viande<nbsp>!
msgctxt "NpcYell:3350:0:13"
msgid "Meat, meat, meat..."
msgstr "Мясо, мясо, мясо..."

#. ja: 逃がすか！<br>…シシシシシ
#. de: Lasst sie nicht entkommen!
#. fr: Ne les laissez pas s'échapper<nbsp>! Ksss<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3351:0:13"
msgid "\\<click> \\<click><br>There is no escape."
msgstr ""

#. ja: シシシシシ…待てっ！
#. de: Hiergeblieben, bssst!
#. fr: Ksssssss<nbsp>!
msgctxt "NpcYell:3352:0:13"
msgid "\\<click> \\<click>"
msgstr ""

#. ja: 腕がなるぜ…シシシシシ！
#. de: Wir können's gar nicht erwarten!
#. fr: Nous ne pouvons plus attendre<nbsp>! Kssss<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3353:0:13"
msgid "\\<click> \\<click><br>This one is ready."
msgstr ""

#. ja: シシシシシ…<br>獲物はどこだ！
#. de: Fleisch! Wo ist das Fleisch?
#. fr: Ksss<nbsp>? Mais où est la viande<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3354:0:13"
msgid "\\<click> \\<click><br>All will fall!"
msgstr ""

#. ja: シシシシシ…大満足だ
#. de: Wir sind überglücklich!
#. fr: Quelle chance, kss kss<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3355:0:13"
msgid "\\<click> \\<click><br>Meat, meat, meat!"
msgstr ""

#. ja: 当分、食いモンに困らねえ<br>…シシシシシ
#. de: Jetzt haben wir erst mal genug zu essen.
#. fr: En tout cas, nous avons assez à manger<nbsp>! Ksss ksss<nbsp>!
msgctxt "NpcYell:3356:0:13"
msgid "This should provide adequate sustenance."
msgstr "Запасов еды должно хватить."

#. ja: ここまでだな…シシシシシ
#. de: Wir kehren heim, bssst.
#. fr: C'est foutu, kssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3357:0:13"
msgid "\\<click> \\<click><br>For shame."
msgstr ""

#. ja: シシシシシ…<br>まだ食いモンが足りないが…
#. de: Mit leeren Taschen, bssst.
#. fr: Ksssss... On rentre les poches vides...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3358:0:13"
msgid "\\<click> \\<click><br>Hunting is hard."
msgstr ""

#. ja: シシシシシ…<br>そろそろキツイな
#. de: Lange machen wir's nicht mehr mit ...
#. fr: Ça devient dangereux, ksss ksss<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3359:0:13"
msgid "\\<click> \\<click><br>It hurts us so..."
msgstr ""

#. ja: ひと足先に行くぜ…シシシシシ
#. de: Wir räumen schon mal das Feld!
#. fr: Kssss<nbsp>! On fiche le camp<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3360:0:13"
msgid "\\<click> \\<click><br>More practice is required."
msgstr ""

#. ja: シシシシシ…<br>おとなしくしやがれ
#. de: Schön brav, schön brav!
#. fr: C'est bien, c'est bien<nbsp>! Ksss ksss<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3361:0:13"
msgid "\\<click> \\<click><br>Surrender your flesh."
msgstr ""

#. ja: シシシシシ…くらえッ！
#. de: Nimm dies, bssst!
#. fr: Prends ça, kssssss<nbsp>!
msgctxt "NpcYell:3362:0:13"
msgid "\\<click> \\<click>"
msgstr ""

#. ja: シシシシシ…<br>食いモン、めっけ！
#. de: Her mit dem Fleisch!
#. fr: Par ici la bonne viande, ksss ksss<nbsp>!
msgctxt "NpcYell:3363:0:13"
msgid "For the nourishment of our bodies..."
msgstr "На прокорм нашим телам..."

#. ja: よくも…スクヴェイダーを！<br>雷雨の如きこの怒り、鎮まらんぞ
#. de: Na-Vanu-eeh hat Skvader besiegt? In Vanu-ooh wächst Groll wie Donnersturm!
#. fr: Skvader<nbsp>! Fais pleuvoir le tonnerre sur nos ennemis<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3364:0:13"
msgid "Netherling fells my Skvader!<br>Rage swirls within me like a storm!"
msgstr "Двуногий одолел моего Сквадера!<br>Ярость во мне бушует, как гроза!"

#. ja: ハハハハ！<br>我に仇なすは雲神様に挑むに等しい
#. de: Hahahaha! Na-Vanu-eeh beugen sich vor Weißegott!
#. fr: Vous servirez tous de repas pour le Migrateur des brumes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3365:0:13"
msgid "Gwahahaha!<br>Bow before the White, netherling."
msgstr "Гвахахаха!<br>Склонись перед Белым, двуногий."

#. ja: 貴様…！<br>よくも、我が身に等しき供を…
#. de: Elende<if $gn4><else>r</if>! Wie kannst du es wagen?
#. fr: C-comment oses-tu<nbsp>!?
msgctxt "NpcYell:3366:0:13"
msgid "How dare you, netherling!?"
msgstr "Да как ты смеешь, двуногий!?"

#. ja: 我が名はアルテマ……
#. de: Ich bin Ultima ...
#. fr: 0
msgctxt "NpcYell:3367:0:13"
msgid "My name is Ultima..."
msgstr "Моё имя — Ультима..."

#. ja: 太古に作られし最高の力なり……
#. de: Vor Urzeiten geschaffen, ist meine Macht unerreicht.
#. fr: 0
msgctxt "NpcYell:3368:0:13"
msgid "I am power both ancient and unrivaled..."
msgstr "Я — величайшая сила, созданная в глубокой древности..."

#. ja: 我は力であり、生命にあらず……
#. de: Kein Blut, nein, reine Energie durchströmt mich.
#. fr: 0
msgctxt "NpcYell:3369:0:13"
msgid "I do not bleed, for I am but strength given form..."
msgstr "Я не истекаю кровью, ведь я — сама сила, обретшая форму..."

#. ja: 弱き生命体よ、消え去れ！！
#. de: Fleischliche Kreaturen, eure Leben sind verwirkt!
#. fr: 0
msgctxt "NpcYell:3370:0:13"
msgid "Feeble creatures of flesh... Your time is nigh!"
msgstr "Слабые плотские создания... Ваш час настал!"

#. ja: なんだ？<br>こんなところにクァールが…？
#. de: Coeurl? Was haben<br>die hier zu suchen?
#. fr: Un coeurl<nbsp>? Qu'est-ce qu'il fait là<nbsp>?
msgctxt "NpcYell:3371:0:13"
msgid "Coeurls!? Here!?"
msgstr "Коэрлы!? Здесь!?"

#. ja: くっ、みんな手伝ってくれ！<br>追い払うぞ！
#. de: Die reißen uns alle Chocobos!<br>Wir müssen sie vertreiben!
#. fr: Aidez-moi, nous devons les chasser d'ici<nbsp>!
msgctxt "NpcYell:3372:0:13"
msgid "We must drive them away!"
msgstr "Надо их прогнать!"

#. ja: な、なんだこいつは！？<br>うわあああぁ！
#. de: Seht ihr das auch, Leute?<br>Aaaaaahhh!
#. fr: Aaaah<nbsp>! Vous voyez ce que je vois<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3373:0:13"
msgid "Wh-What in the seven<br>hells is that thing!?"
msgstr "Ч-что это за тварь, во<br>имя семи преисподних!?"

#. ja: ありえない…<br>バケモノだあー！
#. de: Was für ein Monster!
#. fr: Il est immense<nbsp>!
msgctxt "NpcYell:3374:0:13"
msgid "It's...it's massive!"
msgstr "Оно... оно огромное!"

#. ja: ひー
#. de: Hilfe!
#. fr: Au secours<nbsp>!
msgctxt "NpcYell:3375:0:13"
msgid "Heeelp!"
msgstr "Помогите!"

#. ja: ひええ！
#. de: Mamiii!
#. fr: Maman<nbsp>!
msgctxt "NpcYell:3376:0:13"
msgid "Mammy!"
msgstr "Мамочка!"

#. ja: シュコォ、シュコォ……<br>おぼえてろ～！
#. de: Indigohand wird Frechheit in Denkschale aufbehalten für Immerzeit!
#. fr: Pshhhh<nbsp>! Les Gobelins de la Main indigo s'en souviendront<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3377:0:13"
msgid "Illuminati not soon<br>un-remember this!"
msgstr "Пшшш... Иллюминаты<br>этого так просто не забудут!"

#. ja: シュコォ、シュコォ……<br>恥の上塗り　トホホ～
#. de: Psh! Wirzzu nicht nochmal winnen!
#. fr: Pshhhh<nbsp>! L'humiliation est terminée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3378:0:13"
msgid "Rain of shame floods<br>gobbie goggles..."
msgstr "Позорный ливень<br>заливает гоблинские очки..."

#. ja: シュコォ、シュコォ……<br>テッタイ　撤退～
#. de: Nächste Mal gibt saftig Dresche.
#. fr: Retraite<nbsp>! Pshhh<nbsp>! Retraite<nbsp>!
msgctxt "NpcYell:3379:0:13"
msgid "All gob, backfall!"
msgstr "Все гобы — назад!"

#. ja: シュコォ、シュコォ……<br>アレの準備を～
#. de: Jetzt ist Zeit für Heimwaffe ...
#. fr: Ha ha<nbsp>! La botte secrète de la Main indigo, pshhh pshhh<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3380:0:13"
msgid "Readymake<br>secret doom!"
msgstr "Приготовить<br>тайную погибель!"

#. ja: 追い込んだぞ！
#. de: Treibt sie zu mir!
#. fr: Qu'ils y viennent<nbsp>!
msgctxt "NpcYell:3381:0:13"
msgid "There she is!"
msgstr "Вот она!"

#. ja: やっちまえ！
#. de: Auf den Feind!
#. fr: Sus à l'ennemi<nbsp>!
msgctxt "NpcYell:3382:0:13"
msgid "Fill her with arrows!"
msgstr "Нашпигуйте её стрелами!"

#. ja: クエーッ！
#. de: Kweeeh!
#. fr: Kwéééé<nbsp>!
msgctxt "NpcYell:3383:0:13"
msgid "Kweeeh!"
msgstr "Квэээ!"

#. ja: クエッ、クエッ
#. de: Kweh, kewh!
#. fr: Kwé, kwé...
msgctxt "NpcYell:3384:0:13"
msgid "Kweh! Kweh!"
msgstr "Квэ! Квэ!"

#. ja: クエッ…！
#. de: Kweh!
#. fr: ... Kwé<nbsp>!
msgctxt "NpcYell:3385:0:13"
msgid "Kweh...!?"
msgstr "Квэ...!?"

#. ja: くそ、覚えてろ！
#. de: Das wirst du büßen!
#. fr: Vous me le paierez<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3386:0:13"
msgid "We'll be back! You can't<br>watch the whole forest!"
msgstr "Мы ещё вернёмся! Вы не<br>можете караулить весь лес!"

#. ja: ヘヘ、高く売れるぞ
#. de: Die Vögel werden uns 'ne Stange Gil bringen!
#. fr: Nous allons revendre tout ça et devenir riches<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3387:0:13"
msgid "This one'll fetch<br>a fine price, I reckon!"
msgstr "За эту птичку<br>дадут хорошую цену, вот увидите!"

#. ja: くらえっ！
#. de: Nimm dies!
#. fr: Prends ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3388:0:13"
msgid "I'll slice you up and<br>feed you to the bears!"
msgstr "Я порежу тебя на куски и<br>скормлю медведям!"

#. ja: じっとしてろ
#. de: Zappelt nicht so rum!
#. fr: Arrête de bouger comme ça<nbsp>!
msgctxt "NpcYell:3389:0:13"
msgid "Don't you move!"
msgstr "Не двигайся!"

#. ja: チョロいな
#. de: Die Vögel sind im Nu gerupft!
#. fr: Fastoche<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3390:0:13"
msgid "I've seen baby chocobos<br>put up more fight!"
msgstr "Даже птенцы чокобо<br>дерутся лучше!"

#. ja: こいつは敵わねえ
#. de: Wird mir zu heiß hier!
#. fr: J'ai rien pu faire...
msgctxt "NpcYell:3391:0:13"
msgid "Bleedin' 'venturers!"
msgstr "Проклятые авантюристы!"

#. ja: ウハウハだぜ
#. de: Wer uns besiegen will, muss früher aufstehen!
#. fr: Ceux qui voudront nous battre devront se lever tôt<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3392:0:13"
msgid "Hah hah! If I don't eat<br>her first! Hah hah hah!"
msgstr "Ха-ха! А то я сам её<br>первым съем! Ха-ха-ха!"

#. ja: チョコボをつかまえろ
#. de: Schnappt euch die Chocobos!
#. fr: Sur les chocobos, vite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3393:0:13"
msgid "If ye see her,<br>grab her!"
msgstr "Увидите её —<br>хватайте!"

#. ja: このへんにいるはずだ！
#. de: Hier müssen welche sein!
#. fr: Ils sont forcément quelque part par ici<nbsp>!
msgctxt "NpcYell:3394:0:13"
msgid "Where's she hidin' now?"
msgstr "Куда она запропастилась?"

#. ja: チョコボを探すぞ！
#. de: Sucht brav nach Vögelchen, Hündchen!
#. fr: Cherchez les chocobos<nbsp>!
msgctxt "NpcYell:3395:0:13"
msgid "I can smell her!"
msgstr "Я чую её запах!"

#. ja: 退くことなどできん！
#. de: Ich weiche nicht!
#. fr: Je ne plierai pas<nbsp>!
msgctxt "NpcYell:3396:0:13"
msgid "I will not yield!"
msgstr "Я не сдамся!"

#. ja: なめるなぁぁっ！
#. de: Ha, wie unvorsichtig!
#. fr: En plein dans le mille<nbsp>!
msgctxt "NpcYell:3397:0:13"
msgid "Your guard is down!"
msgstr "Ты прозевал удар!"

#. ja: 思い知れっ！
#. de: Ich bin dein Meister!
#. fr: Ta folie te perdra<nbsp>!
msgctxt "NpcYell:3398:0:13"
msgid "Know your folly!"
msgstr "Узнай, какова твоя ошибка!"

#. ja: 誓いの槍よっ！
#. de: Bei meiner Lanze!
#. fr: Lance, pourfends mon ennemi<nbsp>!
msgctxt "NpcYell:3399:0:13"
msgid "Taste my lance!"
msgstr "Попробуй моё копьё!"

#. ja: 今、楽にしてやろうっ！
#. de: Ich erlöse dich!
#. fr: C'en est fini de toi<nbsp>!
msgctxt "NpcYell:3400:0:13"
msgid "I will end your struggles!"
msgstr "Я избавлю тебя от мучений!"

#. ja: 竜の眼の力よ！
#. de: Kraft des Auges!
#. fr: À moi, Œil du dragon<nbsp>!
msgctxt "NpcYell:3401:0:13"
msgid "By the power of the Eye!"
msgstr "Силой Ока!"

#. ja: この力、御してみせる！
#. de: Sieh meine Macht!
#. fr: Par la fureur du dragon<nbsp>!
msgctxt "NpcYell:3402:0:13"
msgid "You are outmatched!"
msgstr "Тебе со мной не справиться!"

#. ja: 気を引き締めていけ！
#. de: Dreht jeden Stein um!
#. fr: Restez sur vos gardes<nbsp>!
msgctxt "NpcYell:3403:0:13"
msgid "Begin the search!"
msgstr "Начинаем поиски!"

#. ja: 調査開始だ
#. de: Sucht los!
#. fr: Examinez tous les recoins<nbsp>!
msgctxt "NpcYell:3404:0:13"
msgid "Spread out!"
msgstr "Разойдитесь!"

#. ja: くまなく探せ！
#. de: Durchkämmt jeden Ilm!
#. fr: Retournez tous les cailloux<nbsp>!
msgctxt "NpcYell:3405:0:13"
msgid "Leave no stone unturned!"
msgstr "Переверните каждый камень!"

#. ja: 異変はないか？
#. de: Alles in Ordnung?
#. fr: Tout est en ordre<nbsp>?
msgctxt "NpcYell:3406:0:13"
msgid "Have you found anything?"
msgstr "Вы что-нибудь нашли?"

#. ja: 注意しろよ
#. de: Seid vorsichtig!
#. fr: Faites attention<nbsp>!
msgctxt "NpcYell:3407:0:13"
msgid "Keep your eyes open!"
msgstr "Глаза держи открытыми!"

#. ja: 徹底的に調べろ
#. de: Seht euch gut um!
#. fr: Cherchez bien<nbsp>!
msgctxt "NpcYell:3408:0:13"
msgid "There is nothing here."
msgstr "Здесь ничего нет."

#. ja: 邪魔するな！
#. de: Du störst!
#. fr: Tu vois pas que tu gênes<nbsp>?
msgctxt "NpcYell:3409:0:13"
msgid "Call for reinforcements!"
msgstr "Зови подкрепление!"

#. ja: 立ち去れ！
#. de: Verschwinde!
#. fr: Dégage<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3410:0:13"
msgid "Drop your weapons and<br>you'll receive a swift death!"
msgstr "Бросай оружие — и умрёшь быстро!"

#. ja: 排除する！
#. de: Dich mach ich fertig!
#. fr: Éliminez-moi ça tout de suite<nbsp>!
msgctxt "NpcYell:3411:0:13"
msgid "Ngah!"
msgstr "Нгах!"

#. ja: 一時撤退！
#. de: Einstweiliger Rückzug!
#. fr: Retraite temporaire<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:3412:0:13"
msgid "Fall back to the <i>Gration</i>!"
msgstr "Отступаем к «Грациону»!"

#. ja: 退け、退くんだ！
#. de: Weg hier, weg!
#. fr: On s'en va, on s'en va<nbsp>!
msgctxt "NpcYell:3413:0:13"
msgid "Maintain your lines!"
msgstr "Держать строй!"

#. ja: 逃げ遅れるな！
#. de: Nehmt die Beine in die Hand!
#. fr: Fuyez, bande d'imbéciles<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3414:0:13"
msgid "The Eorzeans<br>will pay for this!"
msgstr "Эорзейцы за это<br>заплатят!"

#. ja: 調査再開だ
#. de: Sucht weiter!
#. fr: Continuez de chercher<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3415:0:13"
msgid "Stay alert! The enemy<br>may still lurk nearby."
msgstr "Будьте начеку! Враг<br>может быть поблизости."

#. ja: こんなに荒らしやがって…
#. de: Seht euch das an, alles verwüstet!
#. fr: Quelle désolation...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3416:0:13"
msgid "Do not forget<br>why we are here."
msgstr "Не забывайте,<br>зачем мы здесь."

#. ja: 手がかりを見つけるぞ
#. de: Niemand hält uns auf!
#. fr: Nous trouverons bien un moyen.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3417:0:13"
msgid "I think I may have found<br>something! Or not..."
msgstr "Кажется, я кое-что нашёл!<br>Или нет..."

#. ja: これほどの力を発揮するとは……。
#. de: Welch überwältigende Leistung!
#. fr: Une telle puissance...
msgctxt "NpcYell:3418:0:13"
msgid "To think a mortal could wield such might!"
msgstr "Кто бы мог подумать, что смертный способен на такую мощь!"

#. ja: ヒトの力……まさに、底知れぬ。
#. de: Es steckt viel Potenzial in euch Sterblichen.
#. fr: Le potentiel des mortels semble infini...
msgctxt "NpcYell:3419:0:13"
msgid "Truly, there is no limit to your powers."
msgstr "Поистине, вашей силе нет предела."

#. ja: まだ、終わりではないぞ。<br>我もまた、底は見せぬ。
#. de: Doch wir sind noch nicht fertig.<br>Ich habe längst nicht alles gezeigt.
#. fr: Mais je n'ai pas encore déployé le mien...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3420:0:13"
msgid "This battle is not over yet.<br>No, I have only scratched the surface of my strength..."
msgstr "Битва ещё не окончена.<br>Я и половины своей силы не показал..."

#. ja: もう、よいだろう……。
#. de: Ich habe genug gesehen.
#. fr: J'en ai assez vu<nbsp>!
msgctxt "NpcYell:3421:0:13"
msgid "That is enough, mortal."
msgstr "Довольно, смертный."

#. ja: 汝らならば、その力に、溺れることはあるまい。<br>それを、確かめることができた。
#. de: So wie du kämpfst,<br>wird deine Macht dich nicht verschlingen.
#. fr: Tu maîtrises par<shy>fai<shy>te<shy>ment tes capacités, mortel<if $gn4>le</if>.
msgctxt "NpcYell:3422:0:13"
msgid "You are possessed of great power─and the strength of will to control it."
msgstr "В тебе великая сила — и достаточно воли, чтобы её обуздать."

#. ja: このような出会いに恵まれるとは、幸いであった。
#. de: Ich freue mich, dir begegnet sein zu dürfen.
#. fr: Je suis heureux d'avoir pu t'affronter.
msgctxt "NpcYell:3423:0:13"
msgid "It was an honor and a pleasure to meet you on the battlefield."
msgstr "Для меня было честью и радостью встретить тебя на поле боя."

#. ja: さらば、偉大なるヒトの英傑よ！<br>縁あらば、どこかで会うことだろう！
#. de: Lebe wohl, Held<if $gn4>in</if> der Sterblichen! Bis wir uns wiedersehen!
#. fr: Adieu, <if $gn4>héroïne<else>héros</if> des humains<nbsp>! J'espère que nos chemins se recroiseront un jour<nbsp>!
msgctxt "NpcYell:3424:0:13"
msgid "Farewell, hero among mortals. I will remember you."
msgstr "Прощай, герой среди смертных. Я тебя запомню."

#. ja: ムゥ……期待しすぎたか？
#. de: Ich habe wohl zu viel erwartet ...
#. fr: Hmm... Je suis un peu déçu...
msgctxt "NpcYell:3425:0:13"
msgid "You disappoint me, mortal."
msgstr "Ты разочаровал меня, смертный."

#. ja: 秘められし力に感じた、大いなる可能性……。<br>我の見誤りだったか？
#. de: Habe ich mich letztlich in dir getäuscht?
#. fr: Peut-être en attendais-je trop de ta part<nbsp>?
msgctxt "NpcYell:3426:0:13"
msgid "I saw great promise, great strength in you."
msgstr "Я видел в тебе огромную силу и великий потенциал."

#. ja: 誠に、残念だ……。
#. de: Wie bedauerlich ...
#. fr: C'est fort dommage...
msgctxt "NpcYell:3427:0:13"
msgid "Alas, it seems that I was mistaken..."
msgstr "Увы, похоже, я ошибся..."

#. ja: 侵入者と思いきや……汝らか。
#. de: Ich fürchtete schon einen Eindringling ...
#. fr: Quand on parle d'intrus...
msgctxt "NpcYell:3428:0:13"
msgid "Who dares disturb─? Oho, it is you."
msgstr "Кто посмел помешать—? О, так это вы."

#. ja: これもまた、ひとつの邂逅。
#. de: Hat das Schicksal dich zu mir geführt?
#. fr: Le destin a provoqué notre rencontre...
msgctxt "NpcYell:3429:0:13"
msgid "I daresay this encounter is no mere chance."
msgstr "Полагаю, эта встреча не случайна."

#. ja: 我との戦いを望むなら、受けて立たん！
#. de: Dann wollen wir es mit einem Kampf belohnen!
#. fr: Remercions-le avec un combat à la hauteur<nbsp>!
msgctxt "NpcYell:3430:0:13"
msgid "If you would test your strength against me, I would be honored to meet your challenge!"
msgstr "Если желаете испытать свою силу в бою со мной, я с честью приму ваш вызов!"

#. ja: 異常なし
#. de: Keine besonderen Vorkommnisse.
#. fr: Rien à signaler.
msgctxt "NpcYell:3431:0:13"
msgid "Nothing to report."
msgstr "Докладывать нечего."

#. ja: こっちは大丈夫そうだ
#. de: Hier ist niemand.
#. fr: Tout à l'air en ordre...
msgctxt "NpcYell:3432:0:13"
msgid "Sector clear!"
msgstr "Сектор чист!"

#. ja: 問題ない
#. de: Alles im grünen Bereich.
#. fr: Aucun problème.
msgctxt "NpcYell:3433:0:13"
msgid "Not a soul for malms."
msgstr "Ни души на многие мальмы."

#. ja: つかまえろ！
#. de: Ein Eindringling!
#. fr: Un intrus<nbsp>!
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:3434:0:13"
msgid "Seize <if $gn4>her<else>him</if>!"
msgstr "Схватить!"

#. ja: 怪しい奴め…
#. de: Was suchst du hier?
#. fr: Qu'est-ce que tu fais ici<nbsp>?
#. macro: <if $gn4>she<else>he</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:3435:0:13"
msgid "Where did <if $gn4>she<else>he</if> come from!?"
msgstr "Откуда он здесь взялся!?"

#. ja: 排除する！
#. de: Verschwinde hier!
#. fr: Tu vas regretter d'avoir fait le déplacement<nbsp>!
msgctxt "NpcYell:3436:0:13"
msgid "Leave no survivors!"
msgstr "Никого не оставлять в живых!"

#. ja: 態勢を立て直す
#. de: Neu formieren!
#. fr: Changement de formation<nbsp>!
msgctxt "NpcYell:3437:0:13"
msgid "Regroup and fall back!"
msgstr "Перегруппироваться и отступить!"

#. ja: 退くぞ！
#. de: Rückzug!
#. fr: Retraite<nbsp>! Retraite<nbsp>!
msgctxt "NpcYell:3438:0:13"
msgid "Leave the wounded!"
msgstr "Раненых бросить!"

#. ja: よし、警戒態勢に移行
#. de: Zurück auf eure Posten!
#. fr: Retournez à vos postes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3439:0:13"
msgid "There will be more. Do<br>not let down your guard!"
msgstr "Враг ещё вернётся.<br>Не терять бдительности!"

#. ja: 二度と近づくな！
#. de: Hoffentlich wirkt die Lektion.
#. fr: Et que ça te serve de leçon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3440:0:13"
msgid "We lay claim to this land<br>in the name of the Emperor!"
msgstr "Эта земля принадлежит нам<br>именем императора!"

#. ja: 警戒を怠るな
#. de: Seid wachsam!
#. fr: Restez vigilants<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3441:0:13"
msgid "The enemy<br>could be anywhere."
msgstr "Враг может быть<br>где угодно."

#. ja: 周辺にはいないようだ
#. de: Niemand hier ...
#. fr: Je ne vois personne...
msgctxt "NpcYell:3442:0:13"
msgid "There's nothing out here."
msgstr "Здесь никого нет."

#. ja: 何かいたような<br>気のせいか…？
#. de: Hm? War da was?
#. fr: Hmm<nbsp>? J'ai cru entendre un bruit...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3443:0:13"
msgid "I thought I<br>heard something."
msgstr "Кажется, я<br>что-то слышал."

#. ja: 駆逐するッ！
#. de: Zum Angriff!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:3444:0:13"
msgid "Submit!"
msgstr "В атаку!"

#. ja: 貴様ごとき！
#. de: Unbefugter Zutritt!
#. fr: Tu n'as rien à faire ici<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3445:0:13"
msgid "You stand in the<br>way of progress!"
msgstr "Ты стоишь на пути<br>прогресса!"

#. ja: 取り押さえろ！
#. de: Keine Überlebenden!
#. fr: N'épargnez personne<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3446:0:13"
msgid "Alive or dead,<br>the legatus cares not."
msgstr "Легату всё равно,<br>живым или мёртвым."

#. ja: 撤退だ！
#. de: Rückzug, Männer!
#. fr: Repli immédiat<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3447:0:13"
msgid "Controlled retreat!<br>Double time!"
msgstr "Отступаем по плану!<br>Бегом!"

#. ja: 危ない奴だ
#. de: Der Gegner ist zu stark!
#. fr: L'ennemi est trop fort pour nous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3448:0:13"
msgid "We will have to<br>report this to the legatus!"
msgstr "Надо доложить об этом<br>легату!"

#. ja: 脅威を排除した
#. de: Alarmzustand aufgehoben.
#. fr: La menace a été éliminée<nbsp>!
msgctxt "NpcYell:3449:0:13"
msgid "Threat neutralized."
msgstr "Угроза устранена."

#. ja: 巡回を続けるぞ
#. de: Weiterpatrouillieren.
#. fr: Retournez à vos postes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3450:0:13"
msgid "Continue survey<br>of the area."
msgstr "Продолжать патрулирование<br>местности."

#. ja: シュコォ、シュコォ……<br>ヨシヨシ　使える！
#. de: Kho kho kho ... Wird ganz Nützlicheverwenden!
#. fr: Pshhh... Que le spectacle commence<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3451:0:13"
msgid "Illuminati brainfruit<br>is frontmost! Brings much<br>blastydoom to enemy!"
msgstr "Пшшш... Мозгоплод иллюминатов<br>на первом месте! Врагам<br>будет очень больно!"

#. ja: シュコォ、シュコォ……<br>メンテ再開～
#. de: Großwachsene hat ganz staubig macht. Muzzu gleich putzen.
#. fr: Pshhh... Maintenance en cours<nbsp>!
msgctxt "NpcYell:3452:0:13"
msgid "Resuming keepy-look."
msgstr "Пшшш... Возобновляю осмотр."

#. ja: シュコォ、シュコォ……<br>無敵軍団　ステキ軍団
#. de: Stärkere hat Recht! Indigohand hat Recht!
#. fr: Pshhh... La Main indigo vaincra<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3453:0:13"
msgid "None can withstand<br>ironfist of Illuminati!"
msgstr "Пшшш... Никто не устоит<br>перед железным кулаком<br>иллюминатов!"

#. ja: シュコォ、シュコォ……<br>部品　そろってる～か？
#. de: Gibt alle Ersetzenteile, kho?
#. fr: Pshhh... Toutes les pièces de rechange sont là<nbsp>?
msgctxt "NpcYell:3454:0:13"
msgid "All whizzlepopsaccounted for!"
msgstr "Пшшш... Все штуковины<br>на месте?"

#. ja: シュコォ、シュコォ……<br>侵入者　ハイジョ！
#. de: Frechedieb!
#. fr: Pshhh... Sales voleurs<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3455:0:13"
msgid "Strike-meeting<br>intruder!"
msgstr "Пшшш... Тревога!<br>Незваный гобби!"

#. ja: シュコォ、シュコォ……<br>オマエら　出ていけ！
#. de: Pshh! Schauzzu, dazzu wegkommst, aber mit Flotteschritt!
#. fr: Pshhh... Ouste, ouste<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3456:0:13"
msgid "Backwalk away or<br>meet oversoon doom!"
msgstr "Пшшш... Уходи задом<br>или скоро будет беда!"

#. ja: シュコォ、シュコォ……<br>装置　カエセ～！
#. de: Gibzzu sofort zurück, sonst gibt Saures!
#. fr: Pshhh... Les ennemis doivent rendre l'appareil<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3457:0:13"
msgid "Backgive whizzlepops<br>or feel oversharp pain!"
msgstr "Пшшш... Отдай штуковины,<br>а не то будет больно!"

#. ja: シュコォ、シュコォ……<br>オマエ　スパイか？
#. de: Kannzu gleich erkennengeben, miese Spion!
#. fr: Pshhh... Les aventuriers sont des espions ou quoi<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3458:0:13"
msgid "Sneaky-eyes<br>of enemy!?"
msgstr "Пшшш... Вражьи шпионы<br>подкрались!?"

#. ja: シュコォ、シュコォ……<br>外の連中　ドコ行った？
#. de: Wo sind Freunde hin?
#. fr: Pshhh... Où sont les autres<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3459:0:13"
msgid "Enemy is<br>eyecatched!"
msgstr "Пшшш... Врага<br>замечено!"

#. ja: シュコォ、シュコォ……<br>装置　奪い返された！
#. de: Kho! Jemand hat Knallofant wegnehmen!
#. fr: Pshhh... L'appareil a été récupéré<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3460:0:13"
msgid "Whizzlepops<br>sneaky-taken!"
msgstr "Пшшш... Штуковины<br>украли исподтишка!"

#. ja: シュコォ、シュコォ……<br>ナニゴト　起きてる？
#. de: Was ist für laute Räusch ...?!
#. fr: Pshhh... Qu'est-ce qui se passe<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3461:0:13"
msgid "Sound battlebells!<br>To arms, to arms!"
msgstr "Пшшш... Бей в колокола!<br>К оружию, к оружию!"

#. ja: シュコォ、シュコォ……<br>何か　来るケハイ？
#. de: Psh ... Irgendwas kommt in Nähe ...
#. fr: Pshhh... Ça sent le danger...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3462:0:13"
msgid "Gobbie sense tingles!<br>Danger nearcomes!"
msgstr "Пшшш... У гобби мурашки!<br>Опасность близко!"

#. ja: チッ……マズいですネ……。
#. de: Wehe mir ...
#. fr: Je dois tenir bon<nbsp>!
msgctxt "NpcYell:3463:0:13"
msgid "Oh dear..."
msgstr "Ох, беда..."

#. ja: ドブネズミめ！
#. de: Erbärmliche Ratten!
#. fr: Vous n'êtes que des rats<nbsp>!
msgctxt "NpcYell:3464:0:13"
msgid "Filthy rats!"
msgstr "Вы, грязные крысы!"

#. ja: 掃除してくれルワ！
#. de: Die Pest gehört ausgemerzt!
#. fr: Hors de ma vue<nbsp>!
msgctxt "NpcYell:3465:0:13"
msgid "Sickness must be purged!"
msgstr "Надо искоренить эту заразу!"

#. ja: 消えなサイ！
#. de: Hinfort!
#. fr: Dé<shy>guer<shy>pis<shy>sez d'ici, vermines<nbsp>!
msgctxt "NpcYell:3466:0:13"
msgid "Begone with you!"
msgstr "Убирайтесь прочь!"

#. ja: そろそろ幕引きネ！
#. de: Der Vorhang fällt!
#. fr: Fini de jouer<nbsp>!
msgctxt "NpcYell:3467:0:13"
msgid "And now the final curtain!"
msgstr "Пора занавесу опуститься!"

#. ja: あぁ、もう、うざったい！
#. de: Du widerst mich an!
#. fr: Vous me dégoûtez<nbsp>!
msgctxt "NpcYell:3468:0:13"
msgid "You disgust me!"
msgstr "Вы мне отвратительны!"

#. ja: 始末してあげまショウ！
#. de: Ruhet in Frieden!
#. fr: Que la mort vous emporte<nbsp>!
msgctxt "NpcYell:3469:0:13"
msgid "This shall be a mercy!"
msgstr "Я окажу вам милость!"

#. ja: ま、まだまだ！
#. de: Könnte dir so passen!
#. fr: C'est pas fini<nbsp>!
msgctxt "NpcYell:3470:0:13"
msgid "Oh, bugger..."
msgstr "Ох, чёрт..."

#. ja: 甘いんだよ！
#. de: Ist das alles?
#. fr: C'est tout ce que t'as dans le ventre<nbsp>?
msgctxt "NpcYell:3471:0:13"
msgid "Is that all you've got!?"
msgstr "И это всё, на что ты способен!?"

#. ja: お見通しだよ！
#. de: Berechenbar!
#. fr: N'essaie pas de fuir<nbsp>!
msgctxt "NpcYell:3472:0:13"
msgid "I see you!"
msgstr "Я тебя вижу!"

#. ja: そこまでだ！
#. de: Bis hierhin und nicht weiter!
#. fr: Inutile de résister<nbsp>!
msgctxt "NpcYell:3473:0:13"
msgid "That's far enough!"
msgstr "Дальше не пройдёшь!"

#. ja: トドメだっ！
#. de: Machen wir dem hier ein Ende!
#. fr: Ça va faire mal<nbsp>!
msgctxt "NpcYell:3474:0:13"
msgid "Let's finish it!"
msgstr "Покончим с этим!"

#. ja: 狙い撃つ！
#. de: Dahin, wo's wehtut!
#. fr: En plein dans le mille<nbsp>!
msgctxt "NpcYell:3475:0:13"
msgid "Riiight there!"
msgstr "Вот сюда!"

#. ja: この一撃でっ！
#. de: Jeder Schlag ein Volltreffer!
#. fr: Voilà le coup de grâce<nbsp>!
msgctxt "NpcYell:3476:0:13"
msgid "One shot, one kill!"
msgstr "Один выстрел — одна смерть!"

#. ja: 耐えてみせるぞっ！
#. de: Ich falle nicht!
#. fr: Je ne flancherai pas<nbsp>!
msgctxt "NpcYell:3477:0:13"
msgid "Hold fast!"
msgstr "Держаться!"

#. ja: フハハハハッ！
#. de: Angriff!
#. fr: Viens par ici<nbsp>!
msgctxt "NpcYell:3478:0:13"
msgid "Come!"
msgstr "Иди сюда!"

#. ja: セイッ、セイッ、セイィィッ！
#. de: Nimm dies!
#. fr: Yahaaaaah<nbsp>!
msgctxt "NpcYell:3479:0:13"
msgid "Have at thee!"
msgstr "Получай!"

#. ja: 見ていろ、我が友よ！
#. de: Sieh her!
#. fr: Regardez ça, vous autres<nbsp>!
msgctxt "NpcYell:3480:0:13"
msgid "Bear witness!"
msgstr "Смотрите все!"

#. ja: 輝け、我が剣！
#. de: Führe mein Schwert, Halone!
#. fr: Halone, guide mon épée<nbsp>!
msgctxt "NpcYell:3481:0:13"
msgid "Halone guide my sword!"
msgstr "Халонэ, направь мой меч!"

#. ja: 少しはイイところを見せんとな！
#. de: Einer meiner Lieblingstricks!
#. fr: Tu ne t'en remettras pas<nbsp>!
msgctxt "NpcYell:3482:0:13"
msgid "I shall show you something special!"
msgstr "Сейчас я покажу кое-что особенное!"

#. ja: 受けよ、我が妙技！
#. de: Ehre den Fortemps!
#. fr: Pour la gloire des Fortemps<nbsp>!
msgctxt "NpcYell:3483:0:13"
msgid "For the honor of House Fortemps!"
msgstr "За честь дома Фор-Тэмп!"

#. ja: まだ終わってはいない！
#. de: Noch ist es nicht vorbei.
#. fr: Je me rendrai jamais<nbsp>!
msgctxt "NpcYell:3484:0:13"
msgid "This is not over!"
msgstr "Это ещё не конец!"

#. ja: はぁぁぁぁ…！
#. de: Haaah!
#. fr: Haaaah<nbsp>!
msgctxt "NpcYell:3485:0:13"
msgid "Haaah!"
msgstr "Хааа!"

#. ja: やぁぁぁぁ…！
#. de: Yaaah!
#. fr: Yaaaah<nbsp>!
msgctxt "NpcYell:3486:0:13"
msgid "Yaaah!"
msgstr "Яааа!"

#. ja: やっつけるわよ！
#. de: Ich mach's kurz!
#. fr: Ça fait mal, hein<nbsp>?
msgctxt "NpcYell:3487:0:13"
msgid "I shall make it quick!"
msgstr "Я быстро с этим покончу!"

#. ja: 解き放たん！
#. de: Mächte, seid entfesselt!
#. fr: Je n'aban<shy>don<shy>ne<shy>rai pas<nbsp>!
msgctxt "NpcYell:3488:0:13"
msgid "Have at you!"
msgstr "Ну, держись!"

#. ja: エーテルよ……集え！
#. de: Zu mir, Äther!
#. fr: Éther, prête-moi ta force<nbsp>!
msgctxt "NpcYell:3489:0:13"
msgid "Aether, to me!"
msgstr "Эфир, ко мне!"

#. ja: 静寂なる裁きを……！
#. de: Stunde des Urteils!
#. fr: Tu vas périr<nbsp>!
msgctxt "NpcYell:3490:0:13"
msgid "Fall!"
msgstr "Пади!"

#. ja: すぐに、すぐに逃げましょう<br>吹き抜ける、一陣の疾風の如く！
#. de: Schnell weg! Beeilen wie Wirbelwind!
#. fr: Vite, fuyons aussi loin que le tourbillon nous emporte<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3491:0:13"
msgid "Zundu must flee this place<br>on the wings of the wind!"
msgstr "Зунду надо бежать отсюда<br>на крыльях ветра!"

#. ja: 足が、足が…<br>雲の行方の如く、自由にならぬ
#. de: Oje! Füße schwer wie Baumstrunk!
#. fr: Mes pieds sont aussi lourds qu'un tronc d'arbre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3492:0:13"
msgid "Zundu legs are as<br>heavy as tree trunks!"
msgstr "Ноги у Зунду<br>тяжёлые, как брёвна!"

#. ja: 決して、決して油断なきよう<br>奴らは影法師の如く、忍び寄る
#. de: Achtung! Vundo-eeh sind leise wie Schatten!
#. fr: Attention<nbsp>! Les Vundu sont plus rapides que leur ombre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3493:0:13"
msgid "Be wary! Cruel Vundu<br>trail us like a shadow."
msgstr "Будь начеку! Жестокие Вунду<br>крадутся за нами, как тени."

#. ja: どうか、どうか気をつけなされ<br>奴らは朝霧の如く、我らを囲む
#. de: Vundo-eeh schleichen heran wie Nebel!
#. fr: Ils sont capables de nous encercler comme le brouillard du matin<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3494:0:13"
msgid "Vundu surround us<br>like a choking fog!"
msgstr "Вунду окружают нас,<br>как густой туман!"

#. ja: まことに、まことに危なかったが<br>新緑の如く、希望が芽吹いてきた
#. de: Hoffnung bricht an wie Tag nach dunkler Nacht!
#. fr: Je sens l'espoir renaître comme le feuillage au printemps<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3495:0:13"
msgid "Zundu feels hope, like a ray<br>of sun to chase the night!"
msgstr "Зунду чует надежду, словно луч<br>солнца разгоняет тьму!"

#. ja: やっと、やっと見えてきた<br>闇夜の月の如く、近くて遠い故郷
#. de: Oh Heimat, so hell wie Silberstreif am Horizont!
#. fr: Ma belle patrie, tu es aussi lumineuse que le clair de lune<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3496:0:13"
msgid "My homeland greets my eyes<br>like a rainbow on the horizon!"
msgstr "Родина уже видна,<br>как радуга на горизонте!"

#. ja: なんと、なんと悔しい…<br>雲海の高みより地に落ちるが如し
#. de: Oh Enttäuschung, so bitter wie Mohn!
#. fr: Quelle déception<nbsp>! Quelle amertume<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3497:0:13"
msgid "Such treachery! Like a dark<br> cloud on a summer's day!"
msgstr "Предательство! Как чёрная<br>туча среди ясного дня!"

#. ja: ようやく、ようやく逃げ切った<br>寒空の如き、灰色の日々が終わる
#. de: Geschafft! Herz leuchtet wie nach Unwetter Regenbogen!
#. fr: Nous avons réussi<nbsp>! Les rayons du soleil ont percé les sombres nuages<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3498:0:13"
msgid "At last, the storm is over<br>and blue skies return!"
msgstr "Наконец буря миновала,<br>и снова небо прояснилось!"

#. ja: ここなら、ここなら安心<br>渡り鳥の集う、止まり木の如し
#. de: Hier kann Vundo-ooh rasten wie Vogel auf Ast!
#. fr: Ici, on peut se reposer comme des oiseaux sur leur branche<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3499:0:13"
msgid "Here Zundu is safe as a<br>bird in its mother's breast."
msgstr "Здесь Зунду в безопасности,<br>как птенец в материнском гнезде."

#. ja: 旅の、旅のヒトよ<br>甘露の如き優しさに、深き感謝を
#. de: Herz sprudelt über vor Dankbarkeit wie Quellwasser!
#. fr: Ma gratitude envers vous est aussi abondante que le fleuve qui s'écoule dans la mer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3500:0:13"
msgid "Netherling is strong as wind,<br>and gentle as the kiss of<br>the morning dew."
msgstr "Чужеземец силён, как ветер,<br>и нежен, как поцелуй<br>утренней росы."

#. ja: 強き、強きヒトよ<br>迅雷の如き勇姿、決して忘れぬ
#. de: Na-Vanu-eeh ist kraftvoll wie Donnerschlag!
#. fr: Je n'oublierai jamais votre bravoure aussi majestueuse que la foudre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3501:0:13"
msgid "Zundu remember your<br>kindness for many<br>summers to come."
msgstr "Зунду будет помнить твою<br>доброту ещё много<br>летних дней."

#. ja: 何と、何と、後ろに<br>湧き出る黒雲の如く、不穏な気配
#. de: Zundo-ooh spürt dunkle Gewitterwolken hinter sich aufziehen!
#. fr: Le ciel s'obscurcit, la tempête arrive... Je le sens<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3502:0:13"
msgid "Zundu feels a presence<br>behind like storm clouds<br>on the horizon."
msgstr "Зунду чует за спиной<br>чьё-то присутствие, словно<br>грозовые тучи на горизонте."

#. ja: またも、またも、聞こえる<br>山びこの如く、我らを追う声が
#. de: Zundo-ooh hört Verfolger näherkommen wie Lawine!
#. fr: Nos poursuivants se rapprochent tels une avalanche<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3503:0:13"
msgid "Zundu hears voices, like<br>the whispers of the rain."
msgstr "Зунду слышит голоса,<br>словно шёпот дождя."

#. ja: なぜに、なぜに我を追う<br>雲海の霧よりありふれたこの我を
#. de: Warum verfolgen sie Zundo-ooh hartnäckig wie Wespen?
#. fr: Ils sont têtus comme des mules<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3504:0:13"
msgid "Zundu tires of being Vundu<br>footrest. Zundu just wants<br>to go home."
msgstr "Зунду устал быть подставкой<br>для ног Вунду. Зунду просто<br>хочет домой."

#. ja: 獣が、獣が来る！<br>暑き日の太陽より、苛烈なる獣が
#. de: Vundo-eeh kommen! Ihr Zorn ist glühender als Lava!
#. fr: Quelle horreur<nbsp>! Sa colère est comme la lave ardente<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3505:0:13"
msgid "The beasts come,<br>roaring in like a tempest!"
msgstr "Звери идут,<br>ревут, как буря!"

#. ja: ここにも、ここにも追っ手<br>奴らは渦雷の如く、激怒している
#. de: Sie sind überall! Ihr Brüllen lauter als Donner!
#. fr: Ils sont partout<nbsp>! Rugissez comme le tonnerre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3506:0:13"
msgid "Vundu come, on angry<br>wings of thunder!"
msgstr "Вунду налетают на нас<br>на крыльях гнева и грома!"

#. ja: 誰か、誰か来た<br>雲間の陽光の如き、救いの光か？
#. de: Hilfe kommt? Hoffnung dringt in Herz wie Sonnenstrahlen durch Gehölz!
#. fr: De l'aide<nbsp>? Je reprends espoir comme les fleurs accueillant la rosée du matin<nbsp>!
msgctxt "NpcYell:3507:0:13"
msgid "What is this? Am I saved?"
msgstr "Что это? Я спасён?"

#. ja: 迷い人よ、助けてやろう<br>雪嵐の後のようにボロボロだな
#. de: Zundo-Bruder braucht Hilfe? Sieht aus wie Baum nach Blitzschlag!
#. fr: Vous avez besoin d'aide<nbsp>! Vous avez l'air lessivés comme la prairie après un ouragan<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3508:0:13"
msgid "My brother, you look as if<br>battered by raging winds."
msgstr "Брат мой, тебя будто<br>бурей потрепало."

#. ja: これは、これは助かった<br>雨後の虹の如き、眩しき御仁よ！
#. de: Zundo-ooh will helfen? Herz ist beladen mit Dankbarkeit wie Äste mit Schnee!
#. fr: Quel soulagement<nbsp>! Mon cœur est rempli de gratitude<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3509:0:13"
msgid "Oh, what fortune! Like a ray<br>of sun breaking through the<br>clouds, you are!"
msgstr "О, какая удача! Ты словно<br>солнечный луч, пробившийся<br>сквозь тучи!"

#. ja: 迷い人よ<br>誰かに追われていた様子だが…
#. de: Irrender Zundo-Bruder wird verfolgt? Wirkt unruhig wie aufgewühlte See ...
#. fr: Vous êtes suivis<nbsp>? Vous tremblez comme les feuilles de l'automne...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3510:0:13"
msgid "My brother, your heart<br>seems as restless as<br>the stormy seas."
msgstr "Брат мой, ты будто<br>взбудораженное море."

#. ja: さては、天雷のように残酷な<br>ブンド族から逃げてきたか？
#. de: Ist er geflohen vor Vundo-eeh, die grausam sind wie Sonne über Wüste?
#. fr: Vous essayiez d'échapper aux cruels Vundu<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3511:0:13"
msgid "Were you perhaps chased<br>here by the cruel Vundu?"
msgstr "Неужели тебя сюда загнали<br>жестокие вунду?"

#. ja: 郷まで私が、送り届けよう<br>優しく雲を運ぶ、風のように
#. de: Kann helfen! Kann Zundo-ooh nach Hause begleiten, wie Sterne begleiten Mond!
#. fr: Je vais vous accompagner jusqu'à chez vous, comme le vent qui pousse les nuages<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3512:0:13"
msgid "Worry not, for I shall guide you<br>home on a gentle breeze..."
msgstr "Не тревожься, я провожу тебя<br>домой на лёгком ветерке..."

#. ja: さあ、ゆこう…
#. de: Aufbruch!
#. fr: C'est parti<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3513:0:13"
msgid "Come, and take shelter<br>under my wing..."
msgstr "Пойдём, укроешься<br>под моим крылом..."

#. ja: なんたる、なんたる幸運！<br>闇夜に極光を見るが如し！
#. de: Was für ein Glück! Herz strahlt wie Sonne!
#. fr: Quelle chance<nbsp>! C'est comme un rayon de lumière dans les ténèbres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3514:0:13"
msgid "Thank you, brother!<br>My heart shines like the sun!"
msgstr "Спасибо, брат!<br>Сердце моё сияет, как солнце!"

#. ja: 少し休憩するか<br>手負いの獣のように疲れた様子
#. de: Pause ist wichtig. Warum ruht Zundo-ooh nicht ein bisschen?
#. fr: Il ne faut pas oublier de se reposer, pour ne pas finir comme un animal blessé.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3515:0:13"
msgid "Your breathing grows heavy,<br>brother. Let us rest here."
msgstr "Тяжело дышишь, брат.<br>Давай здесь передохнём."

#. ja: 助かる、助かる<br>長旅の渇きを潤す、湧水の如し
#. de: Pause ist gut! Zundo-ooh ist schwach wie Sonne in Winter.
#. fr: Tout à fait<nbsp>! Une pause, c'est comme le beau temps après la pluie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3516:0:13"
msgid "...Ahhh. The rest refreshes<br>me like a mountain spring."
msgstr "...Ах, отдых освежил меня,<br>словно родник в горах."

#. ja: そろそろ、そろそろゆこう<br>嵐の前を思わせる追っ手の気配
#. de: Weiter jetzt! Verfolger ruhen nicht. Rollen und rollen wie Lawine!
#. fr: Il est temps de reprendre la route. Nous ne devons pas nous faire rattraper par la tempête...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3517:0:13"
msgid "Thank you, brother. Now let us<br>be off before the storms come."
msgstr "Спасибо, брат. Пора идти,<br>пока не грянула буря."

#. ja: 心配ない<br>足が痛むなら、もう少し休め
#. de: Keine Angst. Verfolger sind weit weg wie Horizont!
#. fr: Si tu as mal aux jambes, n'hésite pas à te reposer un peu.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3518:0:13"
msgid "Why rush? I see no<br>clouds on the horizon."
msgstr "Куда спешить? На горизонте<br>ни облачка."

#. ja: …時間稼ぎをせねばな…
#. de: ... Vundo-ooh muss Zeit schinden ...
#. fr: Nous devons gagner du temps...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3519:0:13"
msgid "(Curses! What is<br>keeping them...?)"
msgstr "(Проклятье! Что они<br>там так долго...?)"

#. ja: おや、おや？<br>虫の羽音の如き、密かな独り言
#. de: Was hat er gewispert wie Wind?
#. fr: J'entends des voix, comme les insectes qui bourdonnent<nbsp>!
msgctxt "NpcYell:3520:0:13"
msgid "You speak, brother?"
msgstr "Ты что-то сказал, брат?"

#. ja: いや、何でもない…<br>そろそろ、か
#. de: Wie? Nichts gewispert, nichts! Will er aufbrechen?
#. fr: Hmm... J'ai peut-être rêvé<nbsp>? C'est étrange...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3521:0:13"
msgid "N-No! It was just the<br>rustling of the wind."
msgstr "Н-нет! Это просто ветер<br>листвой шумит."

#. ja: あいつだ、いたぞ！
#. de: Da ist er! Darf nicht wieder fliehen!
#. fr: Il est là<nbsp>! Tu ne t'échapperas pas cette fois<nbsp>!
msgctxt "NpcYell:3522:0:13"
msgid "There he is!"
msgstr "Вот он!"

#. ja: やっと来たな、お仲間が！<br>夜明けのように待ちかねたぞ
#. de: Endlich sind sie da! Brüder von Vundo-ooh!
#. fr: Vous voilà enfin<nbsp>! Je vous attendais comme l'aube après une longue nuit<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3523:0:13"
msgid "Finally! I thought spring might<br>come before you arrived!"
msgstr "Наконец-то! Я уж думал,<br>весна раньше вас придёт!"

#. ja: ヘヘ…もう逃がさない<br>大蛇に睨まれた小鳥だな
#. de: Hehehe! Jetzt sitzt er in Falle wie Maus vor Schlange!
#. fr: Ha ha ha<nbsp>! Il est fait comme un rat<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3524:0:13"
msgid "Foolish Zundu. Time to<br>return and fulfill your fate<br>as a footstool."
msgstr "Глупый зунду. Пора возвращаться<br>и исполнять свою судьбу подставки для ног."

#. ja: 仲間、仲間とは？<br>どういう、どういうことだ？
#. de: Brüder von Vundo-ooh? W-Warum? Zundo-ooh versteht nicht ...
#. fr: Des... Des camarades<nbsp>? Je ne comprends pas...
msgctxt "NpcYell:3525:0:13"
msgid "What!? I have been deceived!?"
msgstr "Что?! Меня обманули!?"

#. ja: お前は、騙されたんだよ！
#. de: Zundo-eeh ist hereingelegt worden!
#. fr: Tu t'es fait rouler dans la farine, ha ha<nbsp>!
msgctxt "NpcYell:3526:0:13"
msgid "Hah! Gullible as a fledgling."
msgstr "Ха! Простодушный, как птенец."

#. ja: そいつは、俺たちの仲間！<br>ヒナ鳥のように純朴な奴だ
#. de: Dieser Vundo-ooh ist Bruder! Zundo-eeh ist naiv wie Küken!
#. fr: Tu es naïf comme une oie blanche<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3527:0:13"
msgid "You have escaped Vundu<br>clutches for the last time."
msgstr "От вунду тебе больше<br>не уйти."

#. ja: 助けて、助けてくれ！
#. de: Hilfe! Zu Hilfe eilen!
#. fr: À l'aide<nbsp>! À l'aiiiiide<nbsp>!!
msgctxt "NpcYell:3528:0:13"
msgid "Help! Someone help me!"
msgstr "Помогите! Кто-нибудь, помогите!"

#. ja: あの場所、あの場所には<br>もう戻りたくない！
#. de: Zundo-ooh will nicht wieder gefangen sein! Will nach Hause!
#. fr: Je ne veux plus retourner là-bas<nbsp>! Plus jamais<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3529:0:13"
msgid "Proud, peaceful Zundu is<br>not a piece of furniture!"
msgstr "Гордый и мирный зунду —<br>не мебель!"

#. ja: ただ、ただ感謝あるのみ！<br>日輪の如く力強き、旅のヒトよ
#. de: Herz sprudelt über vor Dankbarkeit wie Fluss, der über Ufer tritt!
#. fr: Merci, merci infiniment<nbsp>! Mon cœur déborde de gratitude comme la rivière en crue<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3530:0:13"
msgid "Netherling is a ray of light<br>in Zundu's darkest hour."
msgstr "Неземец — луч света<br>в самый тёмный час зунду."

#. ja: いかん、いかん<br>流れる雲の如く呑気にしておれぬ
#. de: Zundo-ooh muss wachsam sein wie wilder Chocobo!
#. fr: Dorénavant, je serai prudent comme un chocobo sauvage<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3531:0:13"
msgid "I must hurry back to<br>Ok' Zundu like the wind..."
msgstr "Надо поскорее вернуться<br>в Ок' Зунду..."

#. ja: 仲間に、仲間に<br>ブンド族の罠のことを知らせねば
#. de: Zundo-ooh muss Brüder warnen vor Freund falsch wie Schlange!
#. fr: Les autres Zundu doivent être prévenus du piège des méchants Vundu<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3532:0:13"
msgid "...and tell my brothers<br>of this Vundu treachery."
msgstr "...и предупредить братьев<br>о коварстве вунду."

#. ja: なんたる、なんたる不運<br>またも奴らに、囚われるとは…
#. de: Ah! Herz ist ausgebrannt wie nach Blitzschlag in Baum! Wieder gefangen ...
#. fr: Quel malheur<nbsp>! Quelle catastrophe<nbsp>! Nous sommes perdus<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3533:0:13"
msgid "Oh, woe! Is there no<br>end to my dark days?"
msgstr "Горе мне! Неужели<br>этим мрачным дням не будет конца?"

#. ja: 周囲を警戒しろ！
#. de: Durchkämmt diesen Sektor!
#. fr: Fouillez le secteur<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3534:0:13"
msgid "Movement detected<br>nearby. Weapons ready!"
msgstr "Засекли движение<br>поблизости. Оружие наготове!"

#. ja: 気を抜くなよ
#. de: Keine Müdigkeit vorschützen!
#. fr: Gardez vos sens en alerte<nbsp>!
msgctxt "NpcYell:3535:0:13"
msgid "Something watches us!"
msgstr "За нами кто-то следит!"

#. ja: このあたりのはずだ！
#. de: Hier müsste es sein!
#. fr: Ça doit être par là<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3536:0:13"
msgid "There are tracks<br>leading this direction!"
msgstr "Следы ведут<br>в ту сторону!"

#. ja: 生かして帰すか！
#. de: Grüß deine Götter von mir!
#. fr: Passe le bonjour aux Douze de ma part<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3537:0:13"
msgid "Your orders are to<br>take no survivors!"
msgstr "Приказано никого<br>не оставлять в живых!"

#. ja: 逃げおおせると思うな！
#. de: Du entkommst mir nicht!
#. fr: Tu ne m'échapperas pas<nbsp>!
msgctxt "NpcYell:3538:0:13"
msgid "Try and escape!"
msgstr "Не уйдёшь!"

#. ja: 死ね！
#. de: Stirb!
#. fr: Crève<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3539:0:13"
msgid "You won't leave<br>this place alive!"
msgstr "Отсюда тебе живым<br>не выбраться!"

#. ja: このあたりのはずだが…
#. de: Irgendwo hier ... Ja ...
#. fr: Probablement par ici...
msgctxt "NpcYell:3540:0:13"
msgid "These are the coordinates."
msgstr "Координаты верны."

#. ja: 通常任務に戻れ！
#. de: Zurück auf eure Posten!
#. fr: Retournez à vos postes<nbsp>!
msgctxt "NpcYell:3541:0:13"
msgid "Back to your stations!"
msgstr "Вернуться на посты!"

#. ja: 荒らされてしまったか…
#. de: Das soll ihnen eine Lehre sein!
#. fr: Que ça vous serve de leçon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3542:0:13"
msgid "Toss the bodies<br>over the edge."
msgstr "Сбросьте тела<br>с обрыва."

#. ja: いったん退くぞ！
#. de: Wir ziehen uns vorerst zurück!
#. fr: On se replie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3543:0:13"
msgid "The retreat is sounded!<br>Fall back! Fall back!"
msgstr "Отступаем!<br>Назад! Назад!"

#. ja: 竜の力、思い知れっ！
#. de: Ehre den Drachen!
#. fr: Contemple la puissance des dragons<nbsp>!
msgctxt "NpcYell:3544:0:13"
msgid "Bask in the master's glory!"
msgstr "Узри славу повелителя!"

#. ja: タラスク様を崇めよ！<br>ギギギッ…
#. de: Die Schuckhornkröte wird uns erlösen!
#. fr: Prosternez-vous devant la Tarasque<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3545:0:13"
msgid "All for Tarasque!<br>All for Tarasque!"
msgstr "Всё ради Тараски!<br>Всё ради Тараски!"

#. ja: ギギ…グギギァ…ッ<br>殺す…殺してやるぅう！
#. de: Tod den Feinden der Drachen!
#. fr: Mort aux ennemis des dragons<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3546:0:13"
msgid "This one shall make<br>a fine offering!"
msgstr "Из него выйдет<br>прекрасное подношение!"

#. ja: シュコォ、シュコォ……<br>まさか　アノ装置…
#. de: Kho ... Maschine sieht aus wie ganz Bösesache ...
#. fr: Pshhh... L'appareil...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3547:0:13"
msgid "These whizzlepops...<br>Oh, my gob!"
msgstr "Эти штуковины...<br>Ох ты ж!"

#. ja: シュコォ、シュコォ……<br>一緒に　来て！
#. de: Psh, kommzu auch helfen, Großwachsene<if $gn4><else>r</if>!
#. fr: Pshhh... L'aventuri<if $gn4>ère<else>er</if> doit venir avec Slicktrix<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3548:0:13"
msgid "Uplander must make<br>swiftheels with Slicktrix!"
msgstr "Верхний должен поспешить<br>вместе со Скликсой!"

#. ja: シュコォ、シュコォ……<br>何か　来る！
#. de: Hazzu hören laute Räusch? Irgendwas ist kommen!
#. fr: Pshhh... Il y a un truc qui vient par ici<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3549:0:13"
msgid "Shkohhh! Have<br>wariness muchly!"
msgstr "Шкоххх!<br>Будьте начеку!"

#. ja: シュコォ、シュコォ……<br>「青の手」　来る
#. de: Muzzu fährliche Maschine wegnehmen!
#. fr: Pshhh... C'est la Main indigo<nbsp>!
msgctxt "NpcYell:3550:0:13"
msgid "Enemy comes!"
msgstr "Враг идёт!"

#. ja: シュコォ、シュコォ……<br>強敵　来る！
#. de: Jetzt geht um Wurst, kho!
#. fr: Pshhh... Au secours<nbsp>! Un ennemi surpuissant<nbsp>!
msgctxt "NpcYell:3551:0:13"
msgid "Stronger enemy comes!"
msgstr "Идёт сильный враг!"

#. ja: シュコォ、シュコォ……<br>敵の精鋭　や～ってきた！
#. de: Indigohand schickt Stärkstekämpfer!
#. fr: Pshhh... Ils sont trop nombreux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3552:0:13"
msgid "Strongerer<br>enemy comes!"
msgstr "Идёт ещё<br>более сильный враг!"

#. ja: シュコォ、シュコォ……<br>異常アリ！
#. de: Indigohand! Indigohand hat windkriegen!
#. fr: Pshhh... La Main indigo nous attaque<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3553:0:13"
msgid "Something is<br>very unright!"
msgstr "Что-то<br>не так!"

#. ja: シュコォ、シュコォ……<br>まさか…アレが来た！？
#. de: Nimmzu Beine in Hand! ... Oder Kämpfenwerkzeug!
#. fr: Pshhh... Non... Pas ça<nbsp>!
msgctxt "NpcYell:3554:0:13"
msgid "Can it be...!?"
msgstr "Неужели...!?"

#. ja: シュコォ、シュコォ……<br>凶悪兵器～！
#. de: Neue Maschine ist bestimmt Zerstörenwerkzeug. Schnappzu dir schnell!
#. fr: Pshhh... La machine maléfique<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3555:0:13"
msgid "W-Worrythoughts of<br>Slicktrix is reality!"
msgstr "Страшные опасения<br>Скликсы сбылись!"

#. ja: シュコォ、シュコォ……<br>完成　していたとは～！
#. de: Ist also schon fertigwerden ...
#. fr: Pshhh... Depuis quand est-elle terminée<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3556:0:13"
msgid "New vangob is complete!<br>Idyllshire is in danger!"
msgstr "Новое гоборужие готово!<br>Идиллшир в опасности!"

#. ja: シュコォ、シュコォ……<br>ミンナに　知らせろ～
#. de: Gobbi wird Warnenwort schreien zu alle!
#. fr: Pshhh... Il faut prévenir les autres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3557:0:13"
msgid "Shkohhh... Slicktrix must<br>be telling shirefriends!"
msgstr "Шкоххх... Скликса должна<br>предупредить жителей Идиллшира!"

#. ja: パワー全開！
#. de: Volle Kraft!
#. fr: Puissance maximum<nbsp>!
msgctxt "NpcYell:3558:0:13"
msgid "Focusing energy."
msgstr "Сосредоточение энергии."

#. ja: クルザス川の清き水面の如く！
#. de: Klar wie der Quell des Coerthas!
#. fr: Clair comme les rivières du Coerthas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3559:0:13"
msgid "With a spear as stiff<br>as ice, I thrust!"
msgstr "Я пронзаю копьём,<br>твёрдым, как лёд!"

#. ja: クルザス川の猛き飛沫の如く！
#. de: Flink wie die Schnellen des Coerthas!
#. fr: Agile comme les rapides du Coerthas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3560:0:13"
msgid "Like the majestic<br>Coerthan puffer, I swell!"
msgstr "Раздуваюсь, словно<br>величавый коэртассский иглобрюх!"

#. ja: クルザス川の純白の煌めきの如く！
#. de: Schäumend wie die Strudel des Coerthas!
#. fr: Brillant comme les surfaces des lacs du Coerthas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3561:0:13"
msgid "Like the surging waters<br>of the mighty Coerthas, I come!"
msgstr "Я мчусь, как бурные воды<br>могучего Коэртаса!"

#. ja: 時間介入者ヲ検知…<br>排除行動開始シマス！
#. de: Zugriffsversuch auf Zeitmanipulationsmodul registriert ... Beseitige Bedrohung!
#. fr: Intrusion temporelle détectée...<br>Ordre de détruire les fautifs<nbsp>!
msgctxt "NpcYell:3562:0:13"
msgid "Unauthorized temporal signature detected. Initiating elimination protocol."
msgstr "Обнаружен несанкционированный временной след. Запускаю протокол уничтожения."

#. ja: 遅いな…
#. de: Wo bleibt er nur?
#. fr: Mais où est-ce qu'il est<nbsp>?
msgctxt "NpcYell:3563:0:13"
msgid "Whatever is keeping him?"
msgstr "Что же его задержало?"

#. ja: うわっ、逃げろ！
#. de: O weh, nichts wie weg!
#. fr: Au secours<nbsp>!
msgctxt "NpcYell:3564:0:13"
msgid "Flee! Flee for your lives!"
msgstr "Бегите! Спасайтесь!"

#. ja: 戯れにも、飽きたな……。
#. de: Dieses Spiel ist langweilig geworden.
#. fr: Fini de jouer...
msgctxt "NpcYell:3565:0:13"
msgid "Enough games for today..."
msgstr "На сегодня с меня игр..."

#. ja: おのれ、嗅ぎつけたか！
#. de: Was schnüffelst du hier rum?
#. fr: Qu'est-ce que tu viens faire ici<nbsp>?
msgctxt "NpcYell:3566:0:13"
msgid "Die, damn you!"
msgstr "Чтоб ты сдох!"

#. ja: 氷の巫女は手ぬるいのだ！
#. de: Eisherz' <if $gn4>Spionin<else>Spion</if>!
#. fr: Pour Cœur-de-glace<nbsp>!
msgctxt "NpcYell:3567:0:13"
msgid "For the Lady!"
msgstr "За госпожу!"

#. ja: 邪魔した罪は、死をもって償え！
#. de: Dein Einmischen zahlst du mit dem Tod!
#. fr: Tes péchés seront absous par ta mort<nbsp>!
msgctxt "NpcYell:3568:0:13"
msgid "Meddler!"
msgstr "За то, что вмешался, заплатишь жизнью!"

#. ja: こいつ、手ごわいぞ！
#. de: Du wirst dein blaues<br>Wunder erleben!
#. fr: <if $gn4>Elle<else>Il</if> est redoutable<nbsp>!
msgctxt "NpcYell:3569:0:13"
msgid "You cannot stop us!"
msgstr "Нас не остановить!"

#. ja: そこまでです
#. de: Genug!
#. fr: Fini de jouer<nbsp>!
msgctxt "NpcYell:3570:0:13"
msgid "Well, well..."
msgstr "Ну-ну..."

#. ja: 我に刃向う愚か者よ…<br>その血を竜に捧げるがいい
#. de: Ich werde dein Blut den Drachen opfern!
#. fr: Ton sang sera offert en sacrifice aux dragons<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3571:0:13"
msgid "This one shall make<br>an excellent offering."
msgstr "Твою кровь принесут<br>драконам в жертву."

#. ja: 見せしめにしてやる
#. de: Diese Lektion wirst du nicht vergessen!
#. fr: Que ta mort serve d'exemple<nbsp>!
msgctxt "NpcYell:3572:0:13"
msgid "Look closely, now."
msgstr "Смотри внимательно."

#. ja: 我らの力、侮るな
#. de: Fürchte meine Macht!
#. fr: Ne nous sous-estime pas<nbsp>!
msgctxt "NpcYell:3573:0:13"
msgid "Kneel before me!"
msgstr "Преклонись предо мной!"

#. ja: 絶望せよ
#. de: Du hast keine Chance!
#. fr: Tu n'as aucune chance<nbsp>!
msgctxt "NpcYell:3574:0:13"
msgid "There is no escape!"
msgstr "Тебе не спастись!"

#. ja: ハハハ、もがけ、苦しめ！
#. de: Haha! Winde dich! Leide!
#. fr: Que d'atroces souffrances t'emportent<nbsp>!
msgctxt "NpcYell:3575:0:13"
msgid "Writhe and suffer!"
msgstr "Корчись и страдай!"

#. ja: うぐっ…
#. de: Un... möglich ...
#. fr: C'est... Impossible...
msgctxt "NpcYell:3576:0:13"
msgid "Ugh..."
msgstr "Угх..."

#. ja: おのれ…<br>ここまでやるとは
#. de: Ich habe dich unterschätzt.
#. fr: Tu ne me laisses pas le choix...
msgctxt "NpcYell:3577:0:13"
msgid "So it comes to this."
msgstr "Так вот до чего дошло."

#. ja: よかろう<br>我も全霊をもって応えよう
#. de: Ab jetzt kämpfe ich ohne Zurückhaltung!
#. fr: Prépare-toi car je ne retiendrai aucun de mes coups...
msgctxt "NpcYell:3578:0:13"
msgid "Very well, if I must..."
msgstr "Что ж, раз так надо..."

#. ja: 我が身に脈打つ<br>大いなる血の力…
#. de: Sieh mit eigenen Augen ...
#. fr: Le sang qui bout dans mes veines me donnera la force...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3579:0:13"
msgid "My blood, my body,<br>my soul─as one!"
msgstr "Моя кровь, моё тело,<br>моя душа — едины!"

#. ja: その目に焼きつけよ！
#. de: ... wie mächtig Drachenblüter sind!
#. fr: ... de t'envoyer en enfer<nbsp>!
msgctxt "NpcYell:3580:0:13"
msgid "Bear witness to my ascension!"
msgstr "Узри моё вознесение!"

#. ja: グゥォォォォオオ！
#. de: Grrraaarrrhhhh!
#. fr: Grrraaaaaah<nbsp>!!
msgctxt "NpcYell:3581:0:13"
msgid "Mwahahaha!"
msgstr "Мва-ха-ха-ха!"

#. ja: フシュゥ…<br>グギギギ…虐殺の刻だ
#. de: AUF DIE KNIE, STERBLICHE<if $gn4><else>R</if>!
#. fr: L'HEURE DE TA MORT A SONNÉ, MORTEL<if $gn4>LE</if><nbsp>!
msgctxt "NpcYell:3582:0:13"
msgid "It begins with your end!"
msgstr "С твоей смертью всё начнётся!"

#. ja: グォオオ、もっと血を流せッ！
#. de: BLUT! MEHR BLUT!
#. fr: DU SANG<nbsp>! ENCORE DU SANG<nbsp>!
msgctxt "NpcYell:3583:0:13"
msgid "The blood! It burns!"
msgstr "Кровь! Она пылает!"

#. ja: 泣き喚けッ！
#. de: WEINE BLUT!
#. fr: JE VEUX VOIR TON SANG<nbsp>!
msgctxt "NpcYell:3584:0:13"
msgid "Grind their bones!"
msgstr "Перемалывайте им кости!"

#. ja: グオォ…ギュグア…
#. de: GRRAAARRR!
#. fr: GRRRRRAAAAHHH<nbsp>!!
msgctxt "NpcYell:3585:0:13"
msgid "Feast upon their flesh!"
msgstr "Пируйте их плотью!"

#. ja: のたうち苦しめッ！
#. de: WINDE DICH!
#. fr: TU VAS SOUFFRIR<nbsp>!
msgctxt "NpcYell:3586:0:13"
msgid "Kill them all!"
msgstr "Убейте их всех!"

#. ja: 我らの計画は止められん…
#. de: Niemand hält mich auf!
#. fr: Personne ne pourra m'arrêter...
msgctxt "NpcYell:3587:0:13"
msgid "Tailfeather shall burn..."
msgstr "Хвостовое перо сгорит..."

#. ja: あぢぢぢぢ！
#. de: Autsch, heiß!
#. fr: Fouah<nbsp>! Fouah<nbsp>! Fouah<nbsp>!
msgctxt "NpcYell:3588:0:13"
msgid "Argh, it burns, it burns!"
msgstr "Ай! Горячо, горячо!"

#. ja: 悪しき血を滅せよ！<br>正義は我らに！
#. de: Stirb, Missgeburt! Die Furie will es so!
#. fr: Meurs, abomination<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3589:0:13"
msgid "Die, abomination!<br>The Fury wills it!"
msgstr "Сгинь, мерзость!<br>Так велит Ярость!"

#. ja: あいつらを追い払ってくれ！
#. de: Vertreib die elenden Biester!
#. fr: Débarrassez-nous de ces bêtes immondes<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3590:0:13"
msgid "Here they come!<br>Protect the mint!"
msgstr "Они идут!<br>Защитите мяту!"

#. ja: 仲間の、仲間のために<br>朝露の如き、清涼な水を欲す！
#. de: Zundo-ooh wollen Wasser frisch wie Tau!
#. fr: Les Zundu ont besoin d'eau fraîche comme la rosée du matin<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3591:0:13"
msgid "Zundu wants for water as<br>pure as the morning dew!"
msgstr "Зунду нужна вода,<br>чистая, как утренняя роса!"

#. ja: 誰か、誰か、手を貸してくれ！<br>我は旋風のように急いでおる！
#. de: Jemand soll Wasser besorgen! Beeilen wie Wirbelwind!
#. fr: S'il vous plaît, aidez-nous<nbsp>! C'est très urgent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3592:0:13"
msgid "Zundu is as busy as a whirlwind!<br>Zundu wants for aid!"
msgstr "Зунду занят, как вихрь!<br>Зунду нужна помощь!"

#. ja: 浮草が安住の地を求めるが如く<br>水が、水が欲しいのだ！
#. de: Zundo-ooh dürsten nach Wasser wie ausgetrocknete Pflanze!
#. fr: J'ai besoin d'eau comme une plante desséchée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3593:0:13"
msgid "Like the clouds weep rain,<br>Zundu cries for water!"
msgstr "Как тучи плачут дождём,<br>так зунду просят воды!"

#. ja: ワイルドチョコボの羽根を集めてる
#. de: Ich suche Chocobo-Federn!
#. fr: Je cherche des plumes de chocobo sauvage.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3594:0:13"
msgid "There must be more<br>around here somewhere..."
msgstr "Здесь где-то<br>должно быть ещё..."

#. ja: 誰か手伝ってくれ！
#. de: Wäre jemand so freundlich, mir zu helfen?
#. fr: Quelqu'un peut m'aider à en trouver<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3595:0:13"
msgid "What I wouldn't give<br>for a helping hand!"
msgstr "Вот бы кто-нибудь<br>мне помог!"

#. ja: とびきりの矢を作りたいんだ
#. de: Eine Befiederung daraus ist Gold wert.
#. fr: J'en ai besoin pour mes flèches<nbsp>!
msgctxt "NpcYell:3596:0:13"
msgid "Hm. I could do with a few more."
msgstr "Хм. Мне бы ещё немного."

#. ja: ありがとな！<br>これでいい矢が作れる
#. de: Danke! Das werden fantastische Pfeile!
#. fr: Merci<nbsp>! Je vais pouvoir fabriquer des flèches très solides<nbsp>!
msgctxt "NpcYell:3597:0:13"
msgid "These ought to do nicely!"
msgstr "Отлично подойдут!"

#. ja: 今は危険すぎたか…<br>またの機会にな！
#. de: Zu gefährlich, hm? Vielleicht ein andermal!
#. fr: Dommage, il s'en est fallu de peu... Peut-être une prochaine fois<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3598:0:13"
msgid "That was too close!<br>Mayhap another time..."
msgstr "Ещё немного — и беды не миновать!<br>Может, в другой раз..."

#. ja: 気をつけろよ！
#. de: Pass auf dich auf!
#. fr: Fais attention<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3599:0:13"
msgid "Look out!<br>Bandersnatches!"
msgstr "Берегись!<br>Бандерснатчи!"

#. ja: これぞ後の先よ！
#. de: Ein Sieger kämpft vorausschauend!
#. fr: Vous êtes si prévisibles<nbsp>!
msgctxt "NpcYell:3600:0:13"
msgid "Spare me no quarter!"
msgstr "Вот как надо бить на опережение!"

#. ja: 武神の火焔…<br>その熱きを悟れ！
#. de: Brenne in der Hitze des Kampfes!
#. fr: Flamme du combat<nbsp>! Libère ta chaleur<nbsp>!
msgctxt "NpcYell:3601:0:13"
msgid "Unquenchable are my flames!"
msgstr "Неугасимо пламя моё!"

#. ja: 急にどうしたんだ！？
#. de: Ruhiger, mein Großer!
#. fr: Tout doux, tout doux...
msgctxt "NpcYell:3602:0:13"
msgid "What in the hells happened!?"
msgstr "Какого чёрта тут творится?!"

#. ja: おい！落ち着くんだ！
#. de: Was ist denn in dich gefahren?
#. fr: Calme-toi, tu veux<nbsp>!?
msgctxt "NpcYell:3603:0:13"
msgid "Down, boy, down!"
msgstr "Тихо, мальчик, тихо!"

#. ja: うわああああ！
#. de: Hiiilfe! Die Bestie ist los!
#. fr: Oh là là<nbsp>!
msgctxt "NpcYell:3604:0:13"
msgid "Bloody hells!"
msgstr "Чёрт побери!"

#. ja: 暴れ出したぞ、大変だぁー！
#. de: Er wird uns alle verspeisen!
#. fr: Il est en train de devenir fou<nbsp>! Costa del Sol, on a un problème...
msgctxt "NpcYell:3605:0:13"
msgid "It's out of control!"
msgstr "Она вышла из-под контроля!"

#. ja: ショーどころじゃない…
#. de: So hatte ich mir den Auftritt nicht vorgestellt ...
#. fr: Le spectacle est annulé...
msgctxt "NpcYell:3606:0:13"
msgid "Nothing to see here!"
msgstr "Тут ничего интересного!"

#. ja: もう、手に負えない…
#. de: Vielleicht kannst du ihn beruhigen?
#. fr: Il refuse de m'obéir...
msgctxt "NpcYell:3607:0:13"
msgid "Just a little...difficulty."
msgstr "Ну и... хлопот с ним."

#. ja: 仕方がない、倒してくれ！
#. de: Es hilft alles nichts ... Mach ihn kampfunfähig!
#. fr: Fais-lui sa fête. On n'a plus le choix<nbsp>!
msgctxt "NpcYell:3608:0:13"
msgid "There's no need to worry!"
msgstr "Не о чем беспокоиться!"

#. ja: どうしよう！どうしよう！
#. de: Was jetzt? Den Strand räumen? Gegeruju wird platzen vor Wut!
#. fr: Qu'est-ce qu'on va devenir<nbsp>!?
msgctxt "NpcYell:3609:0:13"
msgid "What do we do!?"
msgstr "Что же нам делать?!"

#. ja: 大変！大変！大変！
#. de: Oh je, oh je ...
#. fr: Au secours<nbsp>! À l'aide<nbsp>!
msgctxt "NpcYell:3610:0:13"
msgid "I knew the beast wasn't ready!"
msgstr "Я знал, что зверь ещё не готов!"

#. ja: 大人しくしてぇー
#. de: V-Vielleicht will er nur ein bisschen Gassi gehen?
#. fr: La grosse bête veut manger la petite<nbsp>!
msgctxt "NpcYell:3611:0:13"
msgid "Calm down, boy!"
msgstr "Тише, мальчик!"

#. ja: 冒険者くん、ありがとう！
#. de: Danke,  Abenteurer<if $gn4>in</if>.
#. fr: Merci à toi, aventuri<if $gn4>ère<else>er</if><nbsp>!
msgctxt "NpcYell:3612:0:13"
msgid "Thank heavens!"
msgstr "Слава богам!"

#. ja: はぁぁ良かったぁ
#. de: Gerettet!
#. fr: Ouuuf<nbsp>!
msgctxt "NpcYell:3613:0:13"
msgid "Everyone's safe..."
msgstr "Все целы..."

#. ja: ひとまず、引くしかない…
#. de: Ich hätte ihn vor dem Feuermond-Reigen füttern sollen ...
#. fr: Tous à l'abri<nbsp>!
msgctxt "NpcYell:3614:0:13"
msgid "Run away!"
msgstr "Бегите!"

#. ja: みんな逃げてー！
#. de: Rennt, rennt um euer Leben!
#. fr: Courage, fuyons<nbsp>!
msgctxt "NpcYell:3615:0:13"
msgid "Everyone, away from the beach!"
msgstr "Все прочь с пляжа!"

#. ja: 海獣ショーが、始まりますよー
#. de: Kommt und bestaunt das Meeresungeheuer!
#. fr: Attention mesdames et messieurs, le spectacle va commencer dans un instant<nbsp>!
msgctxt "NpcYell:3616:0:13"
msgid "Gather 'round everyone!"
msgstr "Собирайтесь, все сюда!"

#. ja: 楽しいショーですよー
#. de: Morgawr, das Ding aus der Tiefe!
#. fr: Cet animal va vous en mettre plein la vue<nbsp>!
msgctxt "NpcYell:3617:0:13"
msgid "You won't believe your eyes!"
msgstr "Глазам своим не поверите!"

#. ja: 存分にお楽しみください
#. de: Schaudert und staunt!
#. fr: Vous allez voir, ça va être com<shy>plè<shy>te<shy>ment fou<nbsp>!
msgctxt "NpcYell:3618:0:13"
msgid "You'll be the envy of your friends!"
msgstr "Друзья вам позавидуют!"

#. ja: 見ないと後悔するよー
#. de: Verpasst nicht die Hauptattraktion des Feuermond-Reigens!
#. fr: Ne ratez pas ce spectacle ex<shy>cep<shy>tion<shy>nel<nbsp>!
msgctxt "NpcYell:3619:0:13"
msgid "The show of a lifetime!"
msgstr "Такое шоу бывает раз в жизни!"

#. ja: バグめ、現れたな！　掃討してみせる！<br>新生祭の邪魔はさせない！
#. de: Da sind sie! Halten wir sie auf!
#. fr: D'où viennent ces monstres<nbsp>? Il faut les empêcher de gâcher la Commémoration<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3620:0:13"
msgid "The infernal contraptions are come!<br>Let us eradicate this threat to Thanalan!"
msgstr "Адские механизмы явились!<br>Мы избавим Таналан от этой напасти!"

#. ja: 聞き惚れたまえ…<br>新生のポエム！
#. de: Hört meine Worte! Hört das Lied der Wiedergeburt!
#. fr: Écoutez ma prose à la gloire de cette terre<nbsp>! Vive la nouvelle Éorzéa<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3621:0:13"
msgid "Hearken to my words!<br>Glory in the song of rebirth!"
msgstr "Внемлите моим словам!<br>Пойте славу возрождению!"

#. ja: 新生祭の邪魔はさせない！
#. de: Sie dürfen das Fest der Wiedergeburt nicht gefährden!
#. fr: Sales bêtes<nbsp>! Laissez les Éorzéens se recueillir en paix<nbsp>!
msgctxt "NpcYell:3622:0:13"
msgid "We cannot allow these fiends to mar the celebrations!"
msgstr "Не позволим этим чудовищам испортить праздник!"

#. ja: くっ…！<br>いったい、何匹いるんだ！
#. de: Was für eine Menge! Sie reproduzieren sich ohne Halten!
#. fr: Il en arrive de partout<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3623:0:13"
msgid "This is an infestation...<br>Mayhap I should have brought more arrows!"
msgstr "Их тут целое нашествие...<br>Надо было взять побольше стрел!"

#. ja: ここは負けられない！
#. de: Wir müssen die Flut eindämmen!
#. fr: Ça ne va pas se passer comme ça<nbsp>!
msgctxt "NpcYell:3624:0:13"
msgid "We must stem this cold, metal tide!"
msgstr "Нельзя дать этой холодной стальной волне захлестнуть нас!"

#. ja: さすがに、数が多い……。<br>仕方ない、「あれ」を使うしかないか……！
#. de: Es wird Zeit für den Höhepunkt dieser Ballade ...
#. fr: Ils sont si nombreux... Il est temps d'utiliser mon Flash miraculeux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3625:0:13"
msgid "They swarm in such numbers...<br>'Tis time for the stirring climax."
msgstr "Их так много...<br>Пора перейти к самому захватывающему моменту."

#. ja: ミラクルフラッシュが決まったァー！
#. de: Möge meine Liebe zu Eorzea euch blenden!
#. fr: En plein dans le mille<nbsp>!
msgctxt "NpcYell:3626:0:13"
msgid "Be smote by mine resolve!"
msgstr "Падите перед моей решимостью!"

#. ja: ●ミラクルフラーッシュ！
#. de: 0
#. fr: Flaaash miraculeeeux<nbsp>!!!
msgctxt "NpcYell:3627:0:13"
msgid "0"
msgstr "0"

#. ja: バグに屈する訳には…！
#. de: Oh nein ... Sie geraten außer Kontrolle ...
#. fr: Ne les laissez pas... nous envahir...
msgctxt "NpcYell:3628:0:13"
msgid "Do not let them...overrun the land..."
msgstr "Не дайте им... захлестнуть всю землю..."

#. ja: く…力、足らずか…！
#. de: Meine Kräfte ... verlassen mich ...
#. fr: Mes forces... m'abandonnent...
msgctxt "NpcYell:3629:0:13"
msgid "My strength fails me..."
msgstr "Силы покидают меня..."

#. ja: ありがとう！<br>バグの数を減らせたようだ！
#. de: Sieg! Davon werden sich diese mechanischen Kreaturen nicht so schnell erholen!
#. fr: Victoire<nbsp>! Avec ça, on devrait être tranquilles pendant un bon moment<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3630:0:13"
msgid "Victory!<br>The bugs will not soon recover from this slaughter."
msgstr "Победа!<br>Этим тварям ещё долго не оправиться от такой бойни."

#. ja: 君のおかげで、勝利を手にすることができたよ！
#. de: Ich danke dir, <if $gn4>Abenteurerin<else>Abenteurer</if>. Diese Schlacht haben wir gewonnen!
#. fr: Merci, mon ami<if $gn4>e</if>. Je n'y serais jamais arrivé sans votre aide<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3631:0:13"
msgid "Thank you, adventurer.<br>The field is ours this day!"
msgstr "Спасибо, искатель приключений.<br>Сегодня победа за нами!"

#. ja: ここまで数が多いとはね…<br>一時撤退すべきか！
#. de: Es sind einfach zu viele ... Ziehen wir uns zurück!
#. fr: Nous sommes submergés... Battons en retraite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3632:0:13"
msgid "Their numbers are too great...<br>Let us fall back and regroup!"
msgstr "Их слишком много...<br>Отступим и перегруппируемся!"

#. ja: 待ちに待ったお祭り楽しみー
#. de: Endlich habe ich auch mal einen Tag frei! Und dann ist auch noch Feuermond-Reigen!
#. fr: J'ai tellement attendu l'arrivée des Feux de la Morrrt<nbsp>!
msgctxt "NpcYell:3633:0:13"
msgid "The faire is here at last!"
msgstr "Наконец-то ярмарка!"

#. ja: ●未使用
#. de: 0
#. fr: 0
msgctxt "NpcYell:3634:0:13"
msgid "0"
msgstr "0"

#. ja: ●未使用
#. de: 0
#. fr: 0
msgctxt "NpcYell:3635:0:13"
msgid "0"
msgstr "0"

#. ja: これ以上、近寄るな！
#. de: He! Kommt ihr nicht zu nahe! Die Dame ist privat hier.
#. fr: N'approchez pas<nbsp>!
msgctxt "NpcYell:3636:0:13"
msgid "Halt!"
msgstr "Стоять!"

#. ja: ●未使用
#. de: 0
#. fr: 0
msgctxt "NpcYell:3637:0:13"
msgid "0"
msgstr "0"

#. ja: 道を開けろ！あっち行け！
#. de: Lasst sie durch! Die Dame will einen Fisch im Teigmantel essen!
#. fr: Laissez-nous tranquilles<nbsp>!
msgctxt "NpcYell:3638:0:13"
msgid "Move aside! Let the lady pass! "
msgstr "Посторонитесь! Дайте пройти даме!"

#. ja: ●未使用
#. de: 0
#. fr: 0
msgctxt "NpcYell:3639:0:13"
msgid "0"
msgstr "0"

#. ja: 踊り娘ちゃーん！
#. de: Na, sieh mal einer an ...
#. fr: Alors ma mignonne, on danse<nbsp>?
msgctxt "NpcYell:3640:0:13"
msgid "Is that...a goddess?"
msgstr "Это... богиня?"

#. ja: 絶世の美女だ！
#. de: So schön und ganz alleine?
#. fr: J'ai jamais vu une telle beauté<nbsp>!
msgctxt "NpcYell:3641:0:13"
msgid "She...she looked at me!"
msgstr "Она... она посмотрела на меня!"

#. ja: ●未使用
#. de: 0
#. fr: 0
msgctxt "NpcYell:3642:0:13"
msgid "0"
msgstr "0"

#. ja: ●未使用
#. de: 0
#. fr: 0
msgctxt "NpcYell:3643:0:13"
msgid "0"
msgstr "0"

#. ja: 行くぞー！
#. de: Wir wollen dich tanzen sehen! Los, tanz!
#. fr: C'est parti<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:3644:0:13"
msgid "She looked at <i>me</i>!"
msgstr "Она посмотрела <i>на меня</i>!"

#. ja: おっしゃぁぁ！
#. de: Beweg dich, oder soll ich dir Beine machen? Har har!
#. fr: Alleeez<nbsp>!
msgctxt "NpcYell:3645:0:13"
msgid "We must get closer!"
msgstr "Надо подойти поближе!"

#. ja: ●未使用
#. de: 0
#. fr: 0
msgctxt "NpcYell:3646:0:13"
msgid "0"
msgstr "0"

#. ja: ゆっくりさせてー
#. de: Euch sollte jemand Manieren beibringen!
#. fr: J'ai besoin de reprrrendre mon souffle...
msgctxt "NpcYell:3647:0:13"
msgid "Pray leave me be!"
msgstr "Оставьте меня в покое!"

#. ja: 指一本触れさせるものか！
#. de: Wehe, ihr legt auch nur einen Finger an sie ...
#. fr: Pas touche, les vicieux<nbsp>!
msgctxt "NpcYell:3648:0:13"
msgid "You won't lay a finger on m'lady!"
msgstr "Не смейте трогать даму!"

#. ja: 邪魔するんじゃない！
#. de: Macht den Weg frei, ihr Schurken!
#. fr: Arrêtez de perturber le spectacle<nbsp>!
msgctxt "NpcYell:3649:0:13"
msgid "Bugger off, you curs!"
msgstr "Проваливайте, мерзавцы!"

#. ja: 近づかせないぞ！
#. de: Keinen Schritt näher!
#. fr: On ne vous laissera pas l'approcher<nbsp>!
msgctxt "NpcYell:3650:0:13"
msgid "Stay back!"
msgstr "Назад!"

#. ja: 踊り娘ちゃーん
#. de: Tanz für uns!
#. fr: Danse<nbsp>!
msgctxt "NpcYell:3651:0:13"
msgid "I am yours, goddess!"
msgstr "Я весь ваш, богиня!"

#. ja: なんのこれしき！
#. de: Ich bin dein größter Verehrer!
#. fr: Nous laisse pas sur notre faim<nbsp>!
msgctxt "NpcYell:3652:0:13"
msgid "Grace us with your gaze!"
msgstr "Одарите нас своим взглядом!"

#. ja: ファンの力を見せてやる！
#. de: Eine Locke, ich will nur eine Locke!
#. fr: On va te montrer combien on t'aime<nbsp>!
msgctxt "NpcYell:3653:0:13"
msgid "Let us grovel at your feet!"
msgstr "Покажем, как мы умеем быть преданными поклонниками!"

#. ja: うぉぉぉ！
#. de: Wir bekommen immer, was wir wollen!
#. fr: Ouaaah<nbsp>!
msgctxt "NpcYell:3654:0:13"
msgid "Don't forsake us!"
msgstr "Не бросайте нас!"

#. ja: 困っちゃうわー
#. de: Hilfe!
#. fr: Qu'est-ce que je vais fairrre<nbsp>?
msgctxt "NpcYell:3655:0:13"
msgid "Oh no!"
msgstr "Ой, что же делать!"

#. ja: 手伝ってほしいなっ
#. de: Hilft mir denn keiner?
#. fr: Aidez-moi, je vous en prrrie...
msgctxt "NpcYell:3656:0:13"
msgid "Please, help!"
msgstr "Помогите, пожалуйста!"

#. ja: 早くお祭りに行きたいのにー
#. de: Ich will doch nur auf den Feuermond-Reigen ...
#. fr: J'aimerrrais bien rejoindre la fête.
msgctxt "NpcYell:3657:0:13"
msgid "I just want to go to the faire..."
msgstr "Я всего лишь хочу на ярмарку..."

#. ja: やっと落ち着けるわぁ…
#. de: Da bin ich aber erleichtert ...
#. fr: Je vais enfin êtrrre un peu tranquille<nbsp>!
msgctxt "NpcYell:3658:0:13"
msgid "Finally, I can enjoy the fireworks."
msgstr "Наконец-то можно спокойно посмотреть на фейерверки."

#. ja: もう安全ですよ
#. de: Die Gefahr ist beseitigt.
#. fr: R.A.S., le calme est revenu<nbsp>!
msgctxt "NpcYell:3659:0:13"
msgid "It's safe now, m'lady."
msgstr "Теперь вы в безопасности, миледи."

#. ja: 俺の踊り娘ちゃん…
#. de: Ich wollte sie doch nur tanzen sehen ...
#. fr: Je voulais juste la serrer très fort dans mes bras...
msgctxt "NpcYell:3660:0:13"
msgid "Goddess, please..."
msgstr "Богиня, прошу..."

#. ja: せめて握手ぐらい…
#. de: Einmal Händeschütteln ... Ist das zuviel verlangt?
#. fr: J'aurais bien aimé lui serrer la main au moins...
msgctxt "NpcYell:3661:0:13"
msgid "Please, at least pat my head."
msgstr "Прошу, хотя бы погладьте меня по голове."

#. ja: いやーんバカー！
#. de: Igitt, diese Rüpel!
#. fr: Bas les pattes, les pirrrates<nbsp>!
msgctxt "NpcYell:3662:0:13"
msgid "Why must this always happen!?"
msgstr "Ну почему это всегда случается?!"

#. ja: 逃げるんだー！
#. de: Es ... sind zu viele ...
#. fr: Prenez la fuite, vite<nbsp>!
msgctxt "NpcYell:3663:0:13"
msgid "M'lady, run!"
msgstr "Миледи, бегите!"

#. ja: やっほー！踊り娘ちゃーん！
#. de: Hurra! Wir bekommen eben, was wir wollen!
#. fr: On va enfin pouvoir être ensemble, ma belle<nbsp>!
msgctxt "NpcYell:3664:0:13"
msgid "Me first!"
msgstr "Я первый!"

#. ja: 踊り娘ちゃんは俺のモノだ！
#. de: Sie ist mein, mein!
#. fr: Du vent, les corsaires<nbsp>! Elle est à moi<nbsp>!
msgctxt "NpcYell:3665:0:13"
msgid "I'll be her favorite!"
msgstr "Она будет моей любимицей!"

#. ja: こんな奴らに…
#. de: Verdammt, wie peinlich ...
#. fr: Qu'est-ce qu'ils vont lui faire...<nbsp>?
msgctxt "NpcYell:3666:0:13"
msgid "Such devotion..."
msgstr "Вот это преданность..."

#. ja: 踊り娘ちゃんかわいすぎる！
#. de: Seht nur, wie hübsch sie ist!
#. fr: Chaque seconde, je pense à toi<nbsp>!
msgctxt "NpcYell:3667:0:13"
msgid "She will be mine!"
msgstr "Она будет моей!"

#. ja: 美しい…
#. de: Ich träume von dir, seit ich dich das erste Mal gesehen habe ...
#. fr: Qu'elle est belle...
msgctxt "NpcYell:3668:0:13"
msgid "Such grace..."
msgstr "Какая грация..."

#. ja: ああ…素敵だ…
#. de: Ich gebe dir alles, was ich habe ...
#. fr: Vous avez vu sa queue, comme elle est longue<nbsp>?
msgctxt "NpcYell:3669:0:13"
msgid "I'm speechless..."
msgstr "Я просто потерял дар речи..."

#. ja: 踊り娘を頼む…
#. de: Ich ... kann nicht mehr!
#. fr: Les gars, prenez soin d'elle...
msgctxt "NpcYell:3670:0:13"
msgid "Protect...m'lady..."
msgstr "Защитите... даму..."

#. ja: こらしめてやってくれ
#. de: Es tut mir so leid ...
#. fr: Bottez-moi les fesses de ces pirates<nbsp>!
msgctxt "NpcYell:3671:0:13"
msgid "Don't let her come to harm..."
msgstr "Не дайте ей пострадать..."

#. ja: うう…無念
#. de: Wer beschützt sie jetzt?
#. fr: J'aurais... tellement voulu... les battre...
msgctxt "NpcYell:3672:0:13"
msgid "Godsdammit..."
msgstr "Чёрт побери..."

#. ja: 何故、入れぬの、だ！？
#. de: Du willst mich nicht reinlassen?
#. fr: Faut-il que je sorte ma hache pour entrer, ja<nbsp>?
msgctxt "NpcYell:3673:0:13"
msgid "Why can Bugaal Ja not bathe at beach!?"
msgstr "Почему Бугаал Джа нельзя купаться на пляже?!"

#. ja: 何度も説明してるだろ？
#. de: Hast du keinen Respekt vor den Traditionen der Mamool Ja?
#. fr: Essaie pour voir<nbsp>! Je crains personne, moi<nbsp>!
msgctxt "NpcYell:3674:0:13"
msgid "You've been banned from the beach!"
msgstr "Тебе же объясняли: тебе запрещено ходить на пляж!"

#. ja: 水浴みの踊り、が問題だ、と？
#. de: Dieser obszöne Tanz geht zu weit! Das können wir nicht dulden!
#. fr: Il n'y a pas de pacotille<nbsp>! La danse de la baignade est une tradition de mon peuple, ja<nbsp>!
msgctxt "NpcYell:3675:0:13"
msgid "You jealous of bathing dance? I teach you!"
msgstr "Тебе не нравится танец для купания? Я тебя научу!"

#. ja: そうだ、あの卑猥な踊りはダメだ
#. de: Es sind Kinder anwesend!
#. fr: On n'a pas envie de te voir onduler comme un ver de terre<nbsp>!
msgctxt "NpcYell:3676:0:13"
msgid "Stop that! I've never seen such...undulations."
msgstr "Прекрати! Таких... извиваний я ещё не видел."

#. ja: 我らの伝統、を侮辱し、おって！
#. de: Wir sind wilde Mamool Ja, wir tanzen wilden Tanz!
#. fr: Tu oses dire que cette danse mamool ja est sauvage<nbsp>?
msgctxt "NpcYell:3677:0:13"
msgid "Smoothskins just jealous they cannot dance so!"
msgstr "Гладкокожие просто завидуют, что сами так танцевать не умеют!"

#. ja: 伝統の侮辱、は許さん！
#. de: Sieh meine Hüften, Oasen der Fruchtbarkeit!
#. fr: Je ne te laisserai pas insulter ma culture, ja<nbsp>!
msgctxt "NpcYell:3678:0:13"
msgid "Forbidden from hot springs, forbidden from beach..."
msgstr "Запретили горячие источники, запретили пляж..."

#. ja: 踊りの美、を解さぬ、とは…
#. de: Vor, zurück, vor, zurück!
#. fr: Je vais te montrer comme je bouge bien. Tu vas adorer, ja<nbsp>!
msgctxt "NpcYell:3679:0:13"
msgid "But you cannot stop dance! Never!"
msgstr "Но танцы не запретишь! Никогда!"

#. ja: 踊る限りは、入れないぞ
#. de: Genug! Meine Augen!
#. fr: Je t'ai déjà dit que tu n'entrerais pas tant que tu danserais<nbsp>!
msgctxt "NpcYell:3680:0:13"
msgid "Then dance out of my sight!"
msgstr "Тогда танцуй подальше от меня!"

#. ja: 文化の摩擦ってやつだ
#. de: Dieser Tanz überschreitet die Grenzen der Zumutbarkeit!
#. fr: Tu ne veux pas comprendre que personne ne veut te voir te tortiller.
msgctxt "NpcYell:3681:0:13"
msgid "Heavens forfend anyone gets any ideas..."
msgstr "Вот что значит культурные разногласия..."

#. ja: う～ん、困った…
#. de: Hilf mir!
#. fr: Qu'on vienne nous aider<nbsp>!
msgctxt "NpcYell:3682:0:13"
msgid "This won't do..."
msgstr "Так дело не пойдёт..."

#. ja: 協力してください！
#. de: Wir müssen das gefährliche Treiben stoppen!
#. fr: À l'aide<nbsp>!
msgctxt "NpcYell:3683:0:13"
msgid "Help us!"
msgstr "Помогите нам!"

#. ja: お祭りを成功させるんだ
#. de: Wenn jemand zu Schaden kommt, ist es aus mit dem Reigen!
#. fr: Le succès des Feux de la Mort en dépend<nbsp>!
msgctxt "NpcYell:3684:0:13"
msgid "Don't let us down!"
msgstr "Не подведите нас!"

#. ja: 俺たちの祭りを、おっ始めるぜ
#. de: Mach mal Platz da! Jetzt kommen wir!
#. fr: Ça va être votre fête<nbsp>!
msgctxt "NpcYell:3685:0:13"
msgid "We'll be havin' our own faire!"
msgstr "Сейчас мы тут свою ярмарку устроим!"

#. ja: ハッハッハッ～
#. de: Wuu huu!
#. fr: Mouah ha ha ha<nbsp>!
msgctxt "NpcYell:3686:0:13"
msgid "Hahaha!"
msgstr "Ха-ха-ха!"

#. ja: 俺たちイケてるだろ～
#. de: Das ist unser Fest!
#. fr: Vous aimez pas notre façon de mettre l'ambiance<nbsp>?
msgctxt "NpcYell:3687:0:13"
msgid "Got yer fireworks right here!"
msgstr "Вот это фейерверки!"

#. ja: なに、見てんだよ～？
#. de: Was guckst'n so?
#. fr: Qu'est-ce que vous regardez<nbsp>?
msgctxt "NpcYell:3688:0:13"
msgid "What're you lookin' at!?"
msgstr "Чего уставился?!"

#. ja: 早くブチかましたいぜ！
#. de: Gleich gibt's hier 'nen ganz großen Knall ...
#. fr: Me retenez pas, je vais faire un malheur<nbsp>!
msgctxt "NpcYell:3689:0:13"
msgid "Die!"
msgstr "Пора бы уже им всыпать!"

#. ja: あっついなぁ～
#. de: Wir haben was Tolles mitgebracht.
#. fr: La température va monter<nbsp>!
msgctxt "NpcYell:3690:0:13"
msgid "What a fight!"
msgstr "Ну и драка!"

#. ja: デカいのブチかましてやるぜ！
#. de: Misch dich nicht ein!
#. fr: J'suis peut-être petit, mais j'suis costaud<nbsp>!
msgctxt "NpcYell:3691:0:13"
msgid "You thought the Bombards were fierce!?"
msgstr "Думаешь, бомбардо страшные?!"

#. ja: 邪魔はさせるか！
#. de: Ein bisschen Spaß muss sein.
#. fr: Je ferai manger leurs dents à ceux qui s'interposeront<nbsp>!
msgctxt "NpcYell:3692:0:13"
msgid "You won't stop us!"
msgstr "Мы вам не дадим нам помешать!"

#. ja: これが俺たちの祭りだ！
#. de: Wir schmeißen jetzt die Feier hier!
#. fr: On va vous montrer ce que c'est qu'une vraie fête<nbsp>!
msgctxt "NpcYell:3693:0:13"
msgid "Let the sparks fly!"
msgstr "Вот это наш праздник!"

#. ja: 腕に自信のある方いませんか？
#. de: Kann denn keiner helfen?
#. fr: Y a-t-il un combattant sur la plage<nbsp>?
msgctxt "NpcYell:3694:0:13"
msgid "Are there no brave adventurers?"
msgstr "Неужели нет храбрых искателей приключений?"

#. ja: 奴らを止めてください
#. de: Zeig's den Störenfrieden!
#. fr: On aurait bien besoin d'aide ici<nbsp>!
msgctxt "NpcYell:3695:0:13"
msgid "Stop them!"
msgstr "Остановите их!"

#. ja: いい度胸じゃねーか
#. de: Das wirst du bereuen!
#. fr: Je sens l'adrénaline monter<nbsp>!
msgctxt "NpcYell:3696:0:13"
msgid "You've got guts!"
msgstr "Вот это смелость!"

#. ja: 後悔させてやる
#. de: Mit uns legt sich keiner an!
#. fr: Vous allez regretter tout ça<nbsp>!
msgctxt "NpcYell:3697:0:13"
msgid "You'll regret this!"
msgstr "Ты об этом пожалеешь!"

#. ja: 海に沈めてやるぜ！
#. de: Du wünschst dich gleich auf 'ne einsame Insel, das schwör ich dir.
#. fr: Je vais vous couler vite fait bien fait<nbsp>!
msgctxt "NpcYell:3698:0:13"
msgid "The seas take you!"
msgstr "Море вас поглотит!"

#. ja: ありがとう、これで安心だよ！
#. de: Danke! Endlich sind wir die los!
#. fr: Merci, on va pouvoir respirer...
msgctxt "NpcYell:3699:0:13"
msgid "Thank you! Our guests should be safe now."
msgstr "Спасибо! Теперь нашим гостям ничего не угрожает."

#. ja: お祭りを楽しんでね
#. de: Jetzt kann der Feuermond-Reigen weitergehen.
#. fr: Profitez bien des Feux de la Mort.
msgctxt "NpcYell:3700:0:13"
msgid "Enjoy the faire!"
msgstr "Приятной ярмарки!"

#. ja: 実行委員で対策を練らないと
#. de: Dafür trage ich die Verantwortung ...
#. fr: Les organisateurs doivent trouver une solution...
msgctxt "NpcYell:3701:0:13"
msgid "We must inform the guild..."
msgstr "Надо сообщить в гильдию..."

#. ja: ハハハ！ブチかましてやったぜ！
#. de: Ha ha! Das hast du jetzt davon.
#. fr: Ha ha<nbsp>! Elle était bonne, cette raclée<nbsp>?
msgctxt "NpcYell:3702:0:13"
msgid "Hahaha! Time for a celebration!"
msgstr "Ха-ха-ха! Вот это праздник!"

#. ja: 二度と来るんじゃねーぞ！
#. de: Verkrümel dich und komm nie wieder!
#. fr: Et qu'on ne revoie jamais vos sales têtes surtout<nbsp>!
msgctxt "NpcYell:3703:0:13"
msgid "Don't let us see you near here again!"
msgstr "И больше не суйтесь сюда!"

#. ja: どかぬ、なら腕ずくで入、る！
#. de: Ich will Respekt!
#. fr: Je vais m'énerver si tu ne me laisses pas passer<nbsp>!
msgctxt "NpcYell:3704:0:13"
msgid "I will bathe, and I will dance!"
msgstr "Я буду купаться и танцевать!"

#. ja: 悪いが、帰ってもらうぞ！
#. de: Den kannst du haben, aber lass das Tanzen!
#. fr: Désolé, mais tu dois rentrer chez toi.
msgctxt "NpcYell:3705:0:13"
msgid "Not here, you won't!"
msgstr "Не здесь. Тебе придётся уйти!"

#. ja: なぜ、だ…なぜ、許されぬ…
#. de: Möge der nächste Sandsturm dir deine hässlichen Ohren abschmirgeln!
#. fr: Pourquoi n'ai-je pas le droit de danser, ja<nbsp>!?
msgctxt "NpcYell:3706:0:13"
msgid "Why...why do you despise me so...?"
msgstr "Почему... почему вы так меня презираете...?"

#. ja: 水浴みしたい、だけなのに…
#. de: Ich wollte doch nur tanzen!
#. fr: Ce ne sont que des petits pas élaborés chez moi...
msgctxt "NpcYell:3707:0:13"
msgid "To dance...was all I wanted..."
msgstr "Я всего-то хотел потанцевать..."

#. ja: 行ってくれたか…
#. de: Hoffentlich bleibt er auch weg.
#. fr: C'est triste, mais bon débarras...
msgctxt "NpcYell:3708:0:13"
msgid "He's gone, finally."
msgstr "Наконец-то ушёл."

#. ja: でも、あの踊りはなぁ…
#. de: Auf solch einen lasterhaften Tanz können wir hier verzichten.
#. fr: Le voir danser m'a fait saigner des yeux.
msgctxt "NpcYell:3709:0:13"
msgid "But I can't unsee his gyrations..."
msgstr "Но этот его танец теперь не развидеть..."

#. ja: 伝統、を軽んじた罰、ぞ！
#. de: Sieg! Sieg für den Mamool Ja!
#. fr: Voilà ce qui se passe quand on prend les gens de haut, ja<nbsp>!
msgctxt "NpcYell:3710:0:13"
msgid "Now you see the power of my dance!"
msgstr "Вот вам сила моего танца!"

#. ja: 興ざめ、だ帰るっ！！
#. de: Banausen wissen meinen Tanz des Lebens nicht zu schätzen.
#. fr: Vous ne méritez pas que je danse pour vous, ja.
msgctxt "NpcYell:3711:0:13"
msgid "You are undeserving of my tradition!"
msgstr "Вы недостойны моей традиции!"

#. ja: 迷惑な野郎だ、まったく…
#. de: Was für ein fieser Kerl ...
#. fr: On n'est pas sortis de l'auberge...
msgctxt "NpcYell:3712:0:13"
msgid "Godsdammit. At least he's gone."
msgstr "Вот же заноза... Хорошо хоть ушёл."

#. ja: また来るんだろうなぁ…
#. de: Hoffentlich bleibt er weg!
#. fr: Il reviendra sans doute. J'ai peur que la soirée vacille...
msgctxt "NpcYell:3713:0:13"
msgid "If he returns, I may call on you again."
msgstr "Ещё заявится, небось. Тогда снова позову тебя на помощь."

#. ja: すまんが、頼んだぞ！
#. de: Bitte hilf, den Strand zu säubern!
#. fr: Un peu d'aide ne serait pas de refus<nbsp>!
msgctxt "NpcYell:3714:0:13"
msgid "You're a godssend!"
msgstr "Ты меня спас!"

#. ja: ああ…キレイな砂浜が…
#. de: Der schöne Strand ...
#. fr: Cette plage est vraiment mer<shy>veil<shy>leu<shy>se...
msgctxt "NpcYell:3715:0:13"
msgid "The beautiful beaches..."
msgstr "И пляжу такому красивому досталось..."

#. ja: う～ん、海賊の奴らめ…
#. de: Diese blöden Piraten!
#. fr: Pourquoi les pirates ne nous laissent-ils pas tranquilles<nbsp>?
msgctxt "NpcYell:3716:0:13"
msgid "Those pirates and their garbage!"
msgstr "Проклятые пираты и их мусор!"

#. ja: 手を貸してくれないか？
#. de: Kannst du nicht helfen?
#. fr: Vous ne voudriez pas nous aider<nbsp>?
msgctxt "NpcYell:3717:0:13"
msgid "I can't pick these up alone."
msgstr "Поможешь? Один я это не соберу."

#. ja: これで一安心だ！
#. de: So ist es besser!
#. fr: On va enfin pouvoir profiter des festivités.
msgctxt "NpcYell:3718:0:13"
msgid "Ah, much better!"
msgstr "Вот, теперь куда лучше!"

#. ja: 対策を立て直すか…
#. de: Es reicht nicht ...
#. fr: On doit revoir notre plan de défense<nbsp>!
msgctxt "NpcYell:3719:0:13"
msgid "Godsdamn, we'll have to try something else..."
msgstr "Чёрт, придётся придумать что-нибудь ещё..."

#. ja: 覚えてやがれ！
#. de: Spielverderber!
#. fr: Que ça vous serve de leçon<nbsp>!
msgctxt "NpcYell:3720:0:13"
msgid "We won't forget this! "
msgstr "Мы этого не забудем!"

#. ja: 失せやがれ！
#. de: Doch nicht so tüchtig, was?
#. fr: Pourquoi vous nous détestez comme ça<nbsp>?
msgctxt "NpcYell:3721:0:13"
msgid "Die!"
msgstr "Сдохни!"

#. ja: この野郎！
#. de: Blödian!
#. fr: Ça va chauffer<nbsp>!
msgctxt "NpcYell:3722:0:13"
msgid "Hands off our grog!"
msgstr "Руки прочь от нашей выпивки!"

#. ja: 酔いが…
#. de: Verträgst wohl unsere Spezialmarke nicht, hm?
#. fr: Ça me gonfle.
msgctxt "NpcYell:3723:0:13"
msgid "Ow...my head..."
msgstr "Ох... Голова..."

#. ja: やっちまえ！
#. de: Dir zeig ich's!
#. fr: Ça y est, je suis en colère<nbsp>!
msgctxt "NpcYell:3724:0:13"
msgid "The beach is ours!"
msgstr "Пляж наш!"

#. ja: なぁ、いいだろう？
#. de: Wie wär's, wie wär's?
#. fr: Allez, juste un verre...
msgctxt "NpcYell:3725:0:13"
msgid "So, how about it?"
msgstr "Ну, как тебе такое?"

#. ja: オレたちと遊ぼうぜ
#. de: Lust auf etwas Unterhaltung?
#. fr: T'as pas envie de t'amuser un peu<nbsp>?
msgctxt "NpcYell:3726:0:13"
msgid "We've got plenty o' grog."
msgstr "У нас рома хоть залейся."

#. ja: ちょっとくらいイイじゃん
#. de: Zier dich nicht!
#. fr: Rien que ce soir...
msgctxt "NpcYell:3727:0:13"
msgid "One sip'll perk you right up."
msgstr "Глотни — сразу повеселеешь."

#. ja: イイところ知ってんだよ
#. de: Ich weiß, was gut ist.
#. fr: Je connais un petit coin tranquille.
msgctxt "NpcYell:3728:0:13"
msgid "We can drink it right here."
msgstr "Можем выпить прямо здесь."

#. ja: ふぅ～楽しぃ～
#. de: So macht das Spaß!
#. fr: C'est l'éclate totale<nbsp>!
msgctxt "NpcYell:3729:0:13"
msgid "Now this is a faire!"
msgstr "Вот это веселье!"

#. ja: 酒もってこ～い
#. de: Hauptsache, wir haben was zu schlucken.
#. fr: Oublie pas la boisson<nbsp>!
msgctxt "NpcYell:3730:0:13"
msgid "Go on, get the grog!"
msgstr "Давай, тащи ром!"

#. ja: 海、祭りときたら酒！
#. de: Ohne Rum keine Strandparty!
#. fr: Qui dit fête sur la plage, dit bibine<nbsp>!
msgctxt "NpcYell:3731:0:13"
msgid "Nothin' beats grog on the beach."
msgstr "Море, пляжный праздник — без рома никак!"

#. ja: オレがイイところ連れてってやるぜ
#. de: Du, komm doch mal mit! Ich zeig dir was!
#. fr: Suis-moi, je vais te montrer un coin sympa.
msgctxt "NpcYell:3732:0:13"
msgid "Come on, lass, I'll carry you."
msgstr "Ну же, красотка, пойдём. Я тебя на руках понесу."

#. ja: なっ！？
#. de: He!
#. fr: Hein<nbsp>!?
msgctxt "NpcYell:3733:0:13"
msgid "Get away!"
msgstr "Отстань!"

#. ja: 調子のってんじゃねーぞコラァ！
#. de: Lass das, du Fiesling!
#. fr: Foutez-nous la paix<nbsp>!
msgctxt "NpcYell:3734:0:13"
msgid "You reek of dead fish!"
msgstr "От тебя дохлой рыбой несёт!"

#. ja: あばらっ
#. de: Ha ha, das Kätzchen hat ja Krallen!
#. fr: Le chaton sort les griffes...
msgctxt "NpcYell:3735:0:13"
msgid "What'd you say!?"
msgstr "Чего ты сказал?!"

#. ja: な、なんだてめぇ！
#. de: Du willst also spielen, ja?
#. fr: Pour qui tu te prends<nbsp>!?
msgctxt "NpcYell:3736:0:13"
msgid "Bloody feisty, they are!"
msgstr "Ух, какие бойкие!"

#. ja: 女子供だろうと容赦しねぇぞ！
#. de: Kannst du haben!
#. fr: C'est pas parce que vous êtes des filles qu'on va se laisser faire<nbsp>!
msgctxt "NpcYell:3737:0:13"
msgid "Been itchin' for a little fun an' games!"
msgstr "Давно хотел немного повеселиться!"

#. ja: 野郎ども！ヤッちまえ！
#. de: Los geht's!
#. fr: Allez les gars, ça chauffe ici<nbsp>!
msgctxt "NpcYell:3738:0:13"
msgid "Get 'em!"
msgstr "Хватай их!"

#. ja: いや～ん、こわ～い！
#. de: Hilfe!
#. fr: À l'aide<nbsp>!
msgctxt "NpcYell:3739:0:13"
msgid "Get your hands away from me!"
msgstr "Уберите от меня руки!"

#. ja: 誰か助けて～！
#. de: So hilf uns doch jemand!
#. fr: Venez nous aider<nbsp>!
msgctxt "NpcYell:3740:0:13"
msgid "Someone, help!"
msgstr "Кто-нибудь, помогите!"

#. ja: はわわわ
#. de: Wir werden belästigt!
#. fr: On est dans de sales drrraps...
msgctxt "NpcYell:3741:0:13"
msgid "Ahhh!"
msgstr "А-а-а!"

#. ja: あわわわわ
#. de: Weg mit euch!
#. fr: Perrrsonne pour nous aider<nbsp>?
msgctxt "NpcYell:3742:0:13"
msgid "You'll regret this!"
msgstr "Вы ещё пожалеете!"

#. ja: ぶっ潰されてーか！
#. de: Hoffentlich bekommt ihr, was ihr verdient!
#. fr: Nous forcez pas à vous faire du mal<nbsp>!
msgctxt "NpcYell:3743:0:13"
msgid "Not the “fun” you had in mind, eh!?"
msgstr "Не такого веселья ты ждал, а?!"

#. ja: へし折ってやっぞ！
#. de: Widerliche Lüstlinge!
#. fr: Je vais vous exploser la tête<nbsp>!
msgctxt "NpcYell:3744:0:13"
msgid "Bend over and kiss your arse good-bye!"
msgstr "Нагнись и попрощайся со своей задницей!"

#. ja: タダじゃ済まさねーからな！
#. de: Ich mag nicht mehr!
#. fr: Vous n'allez pas vous en tirer comme ça<nbsp>!
msgctxt "NpcYell:3745:0:13"
msgid "How do you like ribs? Broken!?"
msgstr "Как тебе сломанные рёбра?!"

#. ja: はぅわ！
#. de: Da vergeht einem die Lust auf Strand ...
#. fr: Tu vas manger du sable<nbsp>!
msgctxt "NpcYell:3746:0:13"
msgid "I never miss!"
msgstr "Я не промахиваюсь!"

#. ja: あわ！！
#. de: So habe ich mir das nicht vorgestellt ...
#. fr: Dans les dents<nbsp>!
msgctxt "NpcYell:3747:0:13"
msgid "Had enough yet!?"
msgstr "Ну что, хватит?!"

#. ja: あわわ！あわわ！
#. de: Das ist ja vielleicht ein<br>Reigen ...
#. fr: Tu en rrredemandes<nbsp>?
msgctxt "NpcYell:3748:0:13"
msgid "Any limbs left to break!?"
msgstr "Ещё есть что ломать?!"

#. ja: 二度と汚い面見せんじゃねえぞ！
#. de: Lasst euch hier nicht wieder blicken!
#. fr: Et que je ne vous revoie pas par ici<nbsp>!
msgctxt "NpcYell:3749:0:13"
msgid "Tell your friends what happened!"
msgstr "Чтоб больше вашу поганую рожу здесь не видел!"

#. ja: ごめんなさいー
#. de: Danke! Endlich sind wir die los!
#. fr: Désolée pour la rrraclée<nbsp>!
msgctxt "NpcYell:3750:0:13"
msgid "Hope you had fun!"
msgstr "Надеюсь, тебе понравилось!"

#. ja: もう勘弁して…
#. de: Was für Kratzbürsten ...
#. fr: C'est bon, on a compris.
msgctxt "NpcYell:3751:0:13"
msgid "Please...no more..."
msgstr "Пожалуйста... хватит..."

#. ja: もうサイアク！
#. de: Sie entkommen ...
#. fr: Y a pas de justice<nbsp>!
msgctxt "NpcYell:3752:0:13"
msgid "What in the hells!?"
msgstr "Да чтоб вас!"

#. ja: どいつもこいつも頼りない！
#. de: Was für ein Reinfall ...
#. fr: On peut vraiment compter sur personne.
msgctxt "NpcYell:3753:0:13"
msgid "Bunch of worthless..."
msgstr "Ну и бесполезные же все..."

#. ja: えーん
#. de: Das ist ja ein tolles Sommerfest ...
#. fr: Mamaaan<nbsp>!
msgctxt "NpcYell:3754:0:13"
msgid "Shite..."
msgstr "Твою ж..."

#. ja: クソッ！逃がすなー！
#. de: Nichts wie weg hier. Die waren eh schäbig ...
#. fr: Les laissez pas filer<nbsp>!
msgctxt "NpcYell:3755:0:13"
msgid "Don't you dare run!"
msgstr "Не смейте убегать!"

#. ja: へぶしっ
#. de: Verdammt!
#. fr: Bon sang de bois...
msgctxt "NpcYell:3756:0:13"
msgid "Curses..."
msgstr "Проклятье..."

#. ja: なんなんだ、こいつら…
#. de: Aua ...
#. fr: On est tombés sur des cas...
msgctxt "NpcYell:3757:0:13"
msgid "Who...? What...?"
msgstr "Кто... Что?.."

#. ja: ヒャッハー！
#. de: Durchhalten!
#. fr: Chargeeez<nbsp>!
msgctxt "NpcYell:3758:0:13"
msgid "Gaaah!"
msgstr "А-а-а!"

#. ja: ッシャー！
#. de: Immer feste drauf!
#. fr: Allez les gars<nbsp>!
msgctxt "NpcYell:3759:0:13"
msgid "Take this!"
msgstr "Получай!"

#. ja: オッラァ！
#. de: Wir schaffen das!
#. fr: Ouaaah<nbsp>!
msgctxt "NpcYell:3760:0:13"
msgid "Ugaaah!"
msgstr "У-а-а!"

#. ja: サイテー
#. de: Ach du meine Güte!
#. fr: Pourquoi nous<nbsp>?
msgctxt "NpcYell:3761:0:13"
msgid "Not like this..."
msgstr "Только не так..."

#. ja: あわわ…
#. de: Wie schrecklich!
#. fr: Non...
msgctxt "NpcYell:3762:0:13"
msgid "Nooo..."
msgstr "Нееет..."

#. ja: ん？　あれは…！？
#. de: Ho-Hoppla!
#. fr: Regardez-moi ça...
msgctxt "NpcYell:3763:0:13"
msgid "Huh? Do you see that?"
msgstr "А? Видишь вон то?"

#. ja: もしや、常夏の踊り娘ちゃん！？
#. de: Das ist doch meine Lieblingskurtisane!
#. fr: C'est ma danseuse préférée<nbsp>!
msgctxt "NpcYell:3764:0:13"
msgid "Is that...a woman!?"
msgstr "Это... женщина?!"

#. ja: 間違いない！チョーかわいい！
#. de: Ja, das ist sie!
#. fr: Quelle beauté...
msgctxt "NpcYell:3765:0:13"
msgid "No, it's a goddess!"
msgstr "Нет, настоящая богиня!"

#. ja: ヤッベ！みんなに知らせなきゃ！
#. de: Ich muss sofort die andern holen!
#. fr: Faut prévenir les autres<nbsp>!
msgctxt "NpcYell:3766:0:13"
msgid "Gods be good, get the others!"
msgstr "Боги милостивые, зовите остальных!"

#. ja: ヤッベ！チョーヤッベ！！
#. de: Das muss mein Glückstag sein!
#. fr: J'en reviens pas<nbsp>!
msgctxt "NpcYell:3767:0:13"
msgid "Hurry up!"
msgstr "Живее!"

#. ja: はぁ、俺の可愛いトレちゃんが…
#. de: Die ganze Aufregung war wohl zu viel für ihn. Er ist so empfindlich.
#. fr: Comment une si noble créature a pu me faire ça<nbsp>?
msgctxt "NpcYell:3768:0:13"
msgid "My poor beast..."
msgstr "Бедная моя зверушка..."

#. ja: またイチから育て直しか…
#. de: Aber ich werde ihn schon wieder aufpäppeln. Mit viel Liebe und etwas Algenbrei.
#. fr: Il faut tout recommencer à zéro, maintenant.
msgctxt "NpcYell:3769:0:13"
msgid "We'll have to get another..."
msgstr "Придётся заводить новую..."

#. ja: イイ気分が台無しだぜ！
#. de: Mist! Ich hatte mich so aufs Feuerwerk gefreut ...
#. fr: Pfff, moi qui avais tellement hâte<nbsp>!
msgctxt "NpcYell:3770:0:13"
msgid "What a bloody waste!"
msgstr "Вот же чёрт, всё насмарку!"

#. ja: チッ！せっかくの花火なのによ…
#. de: Wir kommen wieder!
#. fr: Dire qu'on s'était donné tant de mal<nbsp>!
msgctxt "NpcYell:3771:0:13"
msgid "We slaved away on those fireworks..."
msgstr "Мы столько сил на эти фейерверки потратили..."

#. ja: ヒトを見つけたーぞ！
#. de: Prrr, Eindringlinge!
#. fr: Des humains<nbsp>!<br>Des humains<nbsp>!
msgctxt "NpcYell:3772:0:13"
msgid "Intruders! From above!"
msgstr "Незваные гости! Сверху!"

#. ja: 邪魔するーな！
#. de: Da kommen Obenlaufende!
#. fr: Laissez-nous tranquilles<nbsp>!
msgctxt "NpcYell:3773:0:13"
msgid "Stay back! Don't interfere!"
msgstr "Назад! Не вмешивайтесь!"

#. ja: 排除すーる！
#. de: Leuchtturm gehört uns!
#. fr: Le Phare est à nous, oui, à nous<nbsp>!
msgctxt "NpcYell:3774:0:13"
msgid "Lighthouse is ours!"
msgstr "Маяк наш!"

#. ja: 敵が来たーぞ！
#. de: Aufhalten, aufhalten!
#. fr: Les humains ne passeront pas, non, non, non<nbsp>!
msgctxt "NpcYell:3775:0:13"
msgid "Stall them, stall them!"
msgstr "Враги идут! Задержите их!"

#. ja: 培養炉をまもーれ！
#. de: Schützen Brutofen! Gut schützen!
#. fr: Protégez les bombocubateurs<nbsp>!
msgctxt "NpcYell:3776:0:13"
msgid "Guard the incubators! More bombs!"
msgstr "Защищайте инкубаторы! Ещё бомб!"

#. ja: 迎撃すーる！
#. de: Kommen hierher, großer Fehler!
#. fr: Les humains arrivent trop tard, trop tard, oui<nbsp>!
msgctxt "NpcYell:3777:0:13"
msgid "Intruders are too late! Too late!"
msgstr "Незваные гости опоздали! Опоздали!"

#. ja: ブッ刺しちまうぞ？
#. de: Denk an was Schönes, gleich tut es weh!
#. fr: Vous aurez beau courir, vous n'échapperez pas à ma lance<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3781:0:13"
msgid "Scamper all you will.<br>My lance will find you..."
msgstr "<br>Беги сколько хочешь.<br>От моего копья не уйдёшь..."

#. ja: ヴェルギーン副長！<br>続きます！
#. de: Vellguine! Ich bin zur Stelle!
#. fr: Sire Vellguine<nbsp>!<br>Laissez-moi vous aider<nbsp>!
msgctxt "NpcYell:3782:0:13"
msgid "Ser Vellguine! On your mark!"
msgstr "Сир Веллгвин! По вашему сигналу!"

#. ja: 参るッ！
#. de: Überlasst sie uns!
#. fr: À l'attaaaque<nbsp>!
msgctxt "NpcYell:3783:0:13"
msgid "Charge!"
msgstr "Натиск!"

#. ja: 耐えられるかな？
#. de: Nun versucht mal, das hier zu überstehen ...!
#. fr: Je vais vous embrocher comme un dodo rôti<nbsp>!
msgctxt "NpcYell:3784:0:13"
msgid "I shall pierce your very soul!"
msgstr "Я пронжу саму твою душу!"

#. ja: 捉えたッ！
#. de: Nun steckt ihr in der Klemme!
#. fr: Vous êtes à moi<nbsp>!
msgctxt "NpcYell:3785:0:13"
msgid "You are mine!"
msgstr "Теперь ты мой!"

#. ja: 逃すものか！
#. de: Ihr werdet die Sonne von Coerthas nie wieder sehen!
#. fr: Nul n'échappera au Jugement divin<nbsp>!
msgctxt "NpcYell:3786:0:13"
msgid "None shall escape!"
msgstr "Никто не уйдёт!"

#. ja: ブチ飛ばすッ！
#. de: Hinweg mit euch!
#. fr: Mourez, vermines<nbsp>!
msgctxt "NpcYell:3787:0:13"
msgid "Begone, pests!"
msgstr "Прочь, мерзкие твари!"

#. ja: 神に抗う愚か者め！
#. de: Wer wagt es, sich einem Gott zu widersetzen?
#. fr: Vous défiez le seul dieu légitime<nbsp>!
msgctxt "NpcYell:3788:0:13"
msgid "You defy the only rightful god!"
msgstr "Ты бросаешь вызов единственному истинному богу!"

#. ja: あの男と同じように<br>神意の槍で貫くまでだ！
#. de: Erkennst du die Lanze, du Wurm? Auch dich wird kein Schild retten!
#. fr: Tu vas connaître le même sort que le bâtard du comte de Fortemps<nbsp>!
msgctxt "NpcYell:3789:0:13"
msgid "You shall fall, as did your ally!"
msgstr "Ты падёшь, как и твой союзник!"

#. ja: 決めるぞ、ジャンルヌ！
#. de: Janlenoux! Beenden wir es!
#. fr: À nous de jouer, Sire Janlenoux<nbsp>!
msgctxt "NpcYell:3790:0:13"
msgid "Our moment is come, Ser Janlenoux!"
msgstr "Наш час настал, сир Жанлено!"

#. ja: 合わせるぜ、相棒ッ！
#. de: Ich bin an deiner Seite, Bruder!
#. fr: Je te suis, mon frère<nbsp>!
msgctxt "NpcYell:3791:0:13"
msgid "Take the lead, Brother!"
msgstr "Веди, брат!"

#. ja: 我らの剣を…
#. de: Unsere Klingen ...
#. fr: Unissons nos épées...
msgctxt "NpcYell:3792:0:13"
msgid "Our blades as one..."
msgstr "Наши клинки едины..."

#. ja: 我らが総長に捧ぐ！
#. de: ... für Ihre Exzellenz!
#. fr: Pour Son Excellence<nbsp>!
msgctxt "NpcYell:3793:0:13"
msgid "For the king!"
msgstr "За короля!"

#. ja: 今こそ、<br>究極の力を見せるときぞ！
#. de: Nun werdet Zeugen des Überirdischen ...
#. fr: Montrons-leur le véritable pouvoir des chevaliers de la Table ronde<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3794:0:13"
msgid "Now, Brothers!<br>Unleash the full power of the Heavens' Ward!"
msgstr "Ну же, братья!<br>Высвободим всю мощь Небесной стражи!"

#. ja: 我が美剣にかけて！
#. de: ... der Schönheit wahrer Macht!
#. fr: Puisse mon épée vaincre nos ennemis<nbsp>!
msgctxt "NpcYell:3795:0:13"
msgid "My sword shall sing!"
msgstr "Мой клинок запоёт!"

#. ja: 我が剛剣にかけて！
#. de: ... des Strahlens purer Macht!
#. fr: Puisse mon épée servir mon Seigneur<nbsp>!
msgctxt "NpcYell:3796:0:13"
msgid "My sword shall shine!"
msgstr "Мой клинок засияет!"

#. ja: 槍を構えよ…<br>飛べッ！
#. de: ... der Lanze ewiger Kraft!
#. fr: Il est temps de voler<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3797:0:13"
msgid "Lances at the ready...<br>Now fly!"
msgstr "Копья наготове...<br>Взлетай!"

#. ja: やれやれ…
#. de: Hngh!
#. fr: Toute cette mise en scène...
msgctxt "NpcYell:3798:0:13"
msgid "So very dramatic..."
msgstr "Ну и представление..."

#. ja: 了解ですッ！
#. de: Verstanden!
#. fr: À vos ordres<nbsp>!
msgctxt "NpcYell:3799:0:13"
msgid "Aye, ser!"
msgstr "Так точно, сир!"

#. ja: いいですね、おフタリさん！<br>アタシに合わせなサイ！
#. de: Wie erheiternd - dieser hilflose Widerstand!
#. fr: Avec moi, mes frères<nbsp>!
msgctxt "NpcYell:3800:0:13"
msgid "With me, my brothers!"
msgstr "Со мной, братья!"

#. ja: チッ、仕方あるまい…
#. de: Dann bleibt wohl nur eines ...
#. fr: Si tu insistes...
msgctxt "NpcYell:3801:0:13"
msgid "If I must..."
msgstr "Раз уж выбора нет..."

#. ja: 承知した！
#. de: Jawohl!
#. fr: Ensemble, nous triompherons<nbsp>!
msgctxt "NpcYell:3802:0:13"
msgid "Together, we triumph!"
msgstr "Вместе мы победим!"

#. ja: 燃えてきたぜェ！
#. de: Haha! Was für ein anregendes Geplänkel!
#. fr: Sang et acier<nbsp>!
msgctxt "NpcYell:3803:0:13"
msgid "Blood and steel!"
msgstr "Кровь и сталь!"

#. ja: 雷を束ねるのだッ！
#. de: Kraft des Blitzes ...
#. fr: Tonnerre et fureur<nbsp>!
msgctxt "NpcYell:3804:0:13"
msgid "Thunder and fury!"
msgstr "Молния и ярость!"

#. ja: 力勝負か、面白い！
#. de: Glaubt ihr allen Ernstes, ihr könntet euch mit uns messen? Hah!
#. fr: Force et volonté<nbsp>!
msgctxt "NpcYell:3805:0:13"
msgid "Strength and will!"
msgstr "Сила и воля!"

#. ja: 盾に何の意味があろう…<br>我が力は、すべてを貫く！
#. de: Ja, senk ruhig deinen Schild ... Er wird dir ohnehin nichts nützen!
#. fr: Aucun bouclier ne vous protégera du glaive de la justice<nbsp>!
msgctxt "NpcYell:3806:0:13"
msgid "No shield will defend you from the spear of my conviction!"
msgstr "Твой щит бесполезен...<br>Моё копьё пронзит всё на своём пути!"

#. ja: <sound 1 51>「ロード・オブ・ヴァーミニオン」参加希望の皆様は、<br>愛するミニオンとともに、「ミニオンスクウェア」へどうぞ！
#. de: <sound 1 51>Teilnehmer für den Kampf der Trabanten werden gebeten, sich zusammen mit ihren Begleitern in die Halle der Trabanten zu begeben!
#. fr: <sound 1 51>Mesdames, Mesdemoiselles, Messieurs<nbsp>! Si vous désirez jouer à Choc des mascottes, rendez-vous au square des mascottes<nbsp>!
#. macro: <sound 1 51> — plays a sound effect; kind = 1, sound = 51 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3807:0:13"
msgid "<sound 1 51>Have you tested your tactics with Lord of Verminion?<br>Assemble your loyal minions, and come to Minion Square!"
msgstr "<sound 1 51>Проверили свои тактики на арене «Повелителя миньонов»?<br>Берите верных миньонов и приходите на Площадь миньонов!"

#. ja: <sound 1 51>「ロード・オブ・ヴァーミニオン」の大会を開始いたします。<br>エントリーを希望の皆様は、<br>「ミニオンスクウェア」へ、お集まりください！
#. de: <sound 1 51>In Kürze startet das nächste Trabanten-Turnier! Die Teilnehmer werden gebeten, sich in der Halle der Trabanten einzufinden.
#. fr: <sound 1 51>Un tournoi de Choc des mascottes va bientôt commencer<nbsp>! Si vous désirez y participer, venez vous inscrire au square des mascottes<nbsp>!
#. macro: <sound 1 51> — plays a sound effect; kind = 1, sound = 51 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3808:0:13"
msgid "<sound 1 51>A Lord of Verminion tournament is about to begin.<br>Prospective entrants are encouraged to register at Minion Square!"
msgstr "<sound 1 51>Скоро начнётся турнир на арене «Повелителя миньонов».<br>Желающие принять участие, записывайтесь на Площади миньонов!"

#. ja: <sound 1 51>「ロード・オブ・ヴァーミニオン」の大会を開催中です。<br>エントリーをご希望の皆様は、<br>「ミニオンスクウェア」へ、お集まりください！
#. de: <sound 1 51>Das Trabantenturnier hat begonnen! Wir möchten daran erinnern, dass die Teilnahme auch im laufenden Turnier möglich ist.
#. fr: <sound 1 51>Un tournoi de Choc des mascottes est ac<shy>tu<shy>el<shy>le<shy>ment en cours<nbsp>! Si vous désirez y participer, venez au square des mascottes<nbsp>!
#. macro: <sound 1 51> — plays a sound effect; kind = 1, sound = 51 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3809:0:13"
msgid "<sound 1 51>A Lord of Verminion tournament is currently underway!<br>Prospective challengers are invited to assemble in Minion Square!"
msgstr "<sound 1 51>На арене «Повелителя миньонов» уже идёт турнир!<br>Желающие бросить вызов участникам, собирайтесь на Площади миньонов!"

#. ja: <sound 1 51>まもなく「ロード・オブ・ヴァーミニオン」の大会が終了します。<br>エントリーをご希望の皆様は、お早めに！
#. de: <sound 1 51>In Kürze endet das Trabantenturnier! Wer noch teilnehmen möchte, sollte sich schnellst<shy>möglich in die Halle der Trabanten begeben!
#. fr: <sound 1 51>Le tournoi de Choc des mascottes en cours va bientôt se terminer<nbsp>! Si vous souhaitez y participer, venez vite au square des mascottes<nbsp>!
#. macro: <sound 1 51> — plays a sound effect; kind = 1, sound = 51 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3810:0:13"
msgid "<sound 1 51>Lord of Verminion tournament registration will close momentarily.<br>Prospective challengers, please hasten to Minion Square!"
msgstr "<sound 1 51>Регистрация на турнир арены «Повелителя миньонов» вот-вот закроется.<br>Кто ещё хочет принять участие, поспешите на Площадь миньонов!"

#. ja: <sound 1 51>「ロード・オブ・ヴァーミニオン」の大会が終了いたしました。<br>「ミニオンスクウェア」にて、結果を発表しております。 <br>またのご参加を、お待ちしております！
#. de: <sound 1 51>Das Trabantenturnier ist beendet! Die Ergebnisse können in der Halle der Trabanten eingesehen werden.
#. fr: <sound 1 51>Le tournoi de Choc des mascottes est maintenant terminé<nbsp>! Pour connaître les résultats, veuillez vous présenter au square des mascottes<nbsp>!
#. macro: <sound 1 51> — plays a sound effect; kind = 1, sound = 51 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3811:0:13"
msgid "<sound 1 51>Another thrilling Lord of Verminion tournament has drawn to a close!<br>The winners will be announced in Minion Square.<br>We hope to see everyone back for the next competition!"
msgstr "<sound 1 51>Ещё один захватывающий турнир «Повелителя миньонов» подошёл к концу!<br>Победителей объявят на Площади миньонов.<br>Будем рады видеть вас на следующем турнире!"

#. ja: 道をつなげろー！
#. de: Mach den Weg frei! Platz da!
#. fr: Il faut ouvrir le passage, oui, il le faut<nbsp>!
msgctxt "NpcYell:3812:0:13"
msgid "Must hurry! Must hurry!"
msgstr "Скорей! Надо спешить!"

#. ja: こわーせ！<br>こわーせ！
#. de: Macht sie fertig!
#. fr: Tuez-les<nbsp>! Tuez-les<nbsp>!
msgctxt "NpcYell:3813:0:13"
msgid "Tear down the walls!"
msgstr "Снесите стены!"

#. ja: こ、これが…<br>想いを託された者の力か！？
#. de: So ... groß ist ... die Kraft, die dir geschenkt wurde?
#. fr: Par quelle force impie... avons-nous été... battus...<nbsp>!?
msgctxt "NpcYell:3814:0:13"
msgid "By what unholy strength have we been bested...?"
msgstr "Какой же нечестивой силой нас одолели?.."

#. ja: ここも、見慣れぬ場所でございますな……。
#. de: Auch hier kommt mir alles so fremd vor ...
#. fr: Cet endroit non plus ne m'est pas familier...
msgctxt "NpcYell:3815:0:13"
msgid "This beach is somehow familiar..."
msgstr "Этот пляж кажется мне знакомым..."

#. ja: ともあれ、今は修行あるのみ！
#. de: Aber das Kämpfen, das habe ich nicht verlernt!
#. fr: Que mon en<shy>traî<shy>ne<shy>ment commence.
msgctxt "NpcYell:3816:0:13"
msgid "But there is no time for talk. The crabs come!"
msgstr "Некогда болтать. Крабы уже идут!"

#. ja: ……伝え聞いた記憶がございます。
#. de: Ich erinnere mich ... an <if $gn4>meine Lehrmeisterin<else>meinen Lehrmeister</if> ...
#. fr: Un souvenir me revient...
msgctxt "NpcYell:3817:0:13"
msgid "I am reminded of a tale from long ago..."
msgstr "Мне вспомнилась одна давняя история..."

#. ja: 遥か昔の者たちも、<br>こうしてクラブ族を相手に皆で修行を積んだと……。
#. de: Wir haben zusammen gegen Krabben gekämpft, genau wie diese.
#. fr: Il y a longtemps, de nombreux aventuriers ont fait leurs débuts de la même manière, s'aguérissant au combat contre des crabes...
msgctxt "NpcYell:3818:0:13"
msgid "...Of fledgling adventurers who would fight crabs like these to better themselves."
msgstr "...О начинающих искателях приключений, которые сражались с такими крабами, чтобы стать сильнее."

#. ja: この好機、是が非でも物にせねば。
#. de: Ich vermisse <if $gn4>sie<else>ihn</if> so sehr ...
#. fr: Je dois saisir cette occasion pour progresser, moi aussi.
msgctxt "NpcYell:3819:0:13"
msgid "I pray our training is as successful as theirs was."
msgstr "Молю, пусть наша тренировка будет такой же успешной, как ихняя."

#. ja: みごと、打ち破りましたな。
#. de: Ha! Die hätten wir erledigt!
#. fr: Cela devrait suffire pour cette fois.
msgctxt "NpcYell:3820:0:13"
msgid "I believe that will suffice for now."
msgstr "Думаю, пока хватит."

#. ja: 皆、私めと同じ高みを目指す者たちにございましょうか。
#. de: Der Kampf an deiner Seite hat mich viel gelehrt.
#. fr: Cette séance d'en<shy>traî<shy>ne<shy>ment s'est révélée très intéressante. Merci à vous, <split " " 1><string $gs1></split>.
msgctxt "NpcYell:3821:0:13"
msgid "Fighting alongside such a seasoned warrior has been educational."
msgstr "Битва бок о бок с таким бывалым воином многому меня научила."

#. ja: ともに戦えたことをうれしく思いまする。
#. de: Ich danke dir für die Ehre, mit dir kämpfen zu dürfen.
#. fr: Je suis heureuse d'avoir pu combattre à vos côtés.
msgctxt "NpcYell:3822:0:13"
msgid "I am grateful that you chose to accompany me."
msgstr "Я благодарна, что вы согласились сражаться со мной."

#. ja: ここまで体力がもたぬとは……不覚。
#. de: Argh ... Ich kann nicht mehr ...
#. fr: Argh, je ne pensais pas être aussi faible.
msgctxt "NpcYell:3823:0:13"
msgid "Perhaps...\\<pant>...perhaps I was too ambitious..."
msgstr ""

#. ja: せめて笊蕎麦を用意しておくべきでございました……。
#. de: Dabei hatte ich mich bereits auf eine Schüssel Soba-Nudeln gefreut, um den Sieg zu feiern.
#. fr: Si seulement j'avais mangé des zaru soba avant de commencer...
msgctxt "NpcYell:3824:0:13"
msgid "If only I had taken a proper meal beforehand..."
msgstr "Если бы только я как следует поела перед этим..."

#. ja: これも修行の為！
#. de: Räuberkrabben! Ihr habt euren letzten Raubzug getan!
#. fr: Désolée petit crabe, c'est pour mon en<shy>traî<shy>ne<shy>ment<nbsp>!
msgctxt "NpcYell:3825:0:13"
msgid "Practice makes perfect!"
msgstr "Только практика доведёт меня до совершенства!"

#. ja: 為し遂げてみせまする！
#. de: Konzentrier dich, Iroha, konzentrier dich!
#. fr: Concentre-toi, Iroha, concentre-toi...
msgctxt "NpcYell:3826:0:13"
msgid "Disgusting creatures!"
msgstr "Какие же мерзкие твари!"

#. ja: 邪な気を感じる……何奴？
#. de: Ich spüre eine gewaltige Präsenz ...
#. fr: Je ressens une présence maléfique...
msgctxt "NpcYell:3827:0:13"
msgid "'Tis as if the very air is tainted by darkness..."
msgstr "'Тьма сгущается..."

#. ja: 闇の眷属か！？<br>かようなところに現れるとは！
#. de: Sklaven des Schattenlords? Hier?!
#. fr: Des suppôts du Seigneur des ombres, ici<nbsp>!?
msgctxt "NpcYell:3828:0:13"
msgid "Minions of the Shadow Lord!? From whence did they come?"
msgstr "Приспешники Владыки Теней!? Откуда они взялись?"

#. ja: この魔物、どこぞで伝え聞いた覚えがございます。
#. de: Dies ist nicht das erste Mal, dass wir uns begegnen.
#. fr: Un souvenir me revient...
msgctxt "NpcYell:3829:0:13"
msgid "These demons... They call to mind another old story."
msgstr "Эти демоны... Они напоминают мне другую старую историю."

#. ja: 確か偉大なる侍が、<br>己の限界を超えるために幾度も戦った敵であると。
#. de: Ein Samurai überschreitet die Grenzen von Raum und Zeit, um gegen finstere Dämonen zu kämpfen ...
#. fr: Il y a longtemps, un grand samouraï a in<shy>las<shy>sa<shy>ble<shy>ment combattu des démons de ce genre pour parvenir à dépasser ses limites...
msgctxt "NpcYell:3830:0:13"
msgid "To surpass his limits, a great samurai once fought such fiends..."
msgstr "Великий самурай сражался с такими демонами, чтобы превзойти собственные пределы..."

#. ja: 私めも、この試練を乗り越えた先に<br>見出せるものがありましょうや？
#. de: Das Schicksal formt einen Kreis ... jenseits von Raum und Zeit.
#. fr: Je dois en faire de même pour arriver à retrouver le fil de ma mission<nbsp>!
msgctxt "NpcYell:3831:0:13"
msgid "Perhaps by defeating these demons I can do the same."
msgstr "Возможно, победив демонов, я тоже смогу сделать то же самое."

#. ja: 邪気は去ったようでございますな。
#. de: Die Dämonen sind vertrieben.
#. fr: On dirait qu'ils en ont eu assez.
msgctxt "NpcYell:3832:0:13"
msgid "It would seem we have driven them back."
msgstr "Похоже, мы прогнали их."

#. ja: この程度の魔物を退けられねば、<br>使命を果たすことなどできますまい。
#. de: Ich werde das Gefühl nicht los, dass ich diesen Sieg schon einmal errungen habe.
#. fr: J'ai le sentiment que j'aurai bientôt à combattre des créatures plus redoutables encore...
msgctxt "NpcYell:3833:0:13"
msgid "Alas, I could scarcely match your pace. This will not do."
msgstr "Увы, мне едва удавалось поспевать за вами. Так не годится."

#. ja: さらなる精進を重ねねば……。
#. de: Aber es spielt keine Rolle ... Ich muss meine Wanderschaft fortsetzen.
#. fr: Je dois poursuivre mon en<shy>traî<shy>ne<shy>ment.
msgctxt "NpcYell:3834:0:13"
msgid "There must be a way for me to improve more quickly..."
msgstr "Должен быть способ быстрее стать сильнее..."

#. ja: このような魔物に後れをとるとは……。
#. de: W-Was? Aber ... es kann nicht sein!
#. fr: Aurais-je présumé de mes forces<nbsp>?
msgctxt "NpcYell:3835:0:13"
msgid "It would seem we have underestimated our enemy..."
msgstr "Похоже, мы недооценили врага..."

#. ja: これでは、いたずらに……我が身に宿りし力を失うだけ……。
#. de: Dies ist nicht der Weg, den das Schicksal für mich vorgesehen hat ...
#. fr: Quel échec cuisant...
msgctxt "NpcYell:3836:0:13"
msgid "But I cannot fail─not with so much at stake..."
msgstr "Но я не могу потерпеть неудачу — слишком многое поставлено на карту..."

#. ja: あれは、もしや……？
#. de: Ist es möglich ...?
#. fr: J'ai comme un sentiment de déjà-vu.
msgctxt "NpcYell:3837:0:13"
msgid "Look! Over there! Could it be...?"
msgstr "Смотрите! Вон там! Неужели?.."

#. ja: 尋常ならざる巨躯に、計り知れぬ凶々しさを放つ大鋏。
#. de: Die todbringenden Zangen ... der gewaltige Stachel ...
#. fr: Ces pinces et ce dard de mort...
msgctxt "NpcYell:3838:0:13"
msgid "I know that fiend. Those jagged pincers, dripping with venom..."
msgstr "Я знаю этого демона. Его зазубренные клешни сочатся ядом..."

#. ja: 多くの冒険者が挑むことすら叶わなかったとされる、<br>幻の魔蠍「セルケト」に相違ござらん！
#. de: Es ist Serket, der legendäre Skorpion, der unzählige Abenteurer in Stücke gerissen hat!
#. fr: C'est Serket, le légendaire scorpion qui a arraché la vie de nombreux aventuriers.
msgctxt "NpcYell:3839:0:13"
msgid "It is Serket, an infamous beast and slayer of countless men."
msgstr "Это Серкет, печально известная тварь, погубившая бесчисленное множество людей."

#. ja: これも天の配剤。<br>私めの力を量る好機にございます！
#. de: Dies muss ein Zeichen des Schicksals sein. Eine Aufforderung, über mich hinauszuwachsen!
#. fr: C'est sûrement un signe du ciel... Je dois relever ce défi<nbsp>!
msgctxt "NpcYell:3840:0:13"
msgid "Come! Let us bring an end to its legend and see ours grow in its wake!"
msgstr "Ну же! Покончим с его легендой — и пусть на её месте родится наша!"

#. ja: やりました！<br>このイロハ、とうとうここまでの力を手にしましたぞ！
#. de: Geschafft! Das Biest ist besiegt!
#. fr: Victoire<nbsp>! Merci, <split " " 1><string $gs1></split>, je crois que je n'aurais pas réussi sans vous.
msgctxt "NpcYell:3841:0:13"
msgid "To think that we managed to defeat such a foe..."
msgstr "Подумать только, мы одолели такого противника..."

#. ja: しかし、何故でしょうか……。<br>まだ、何かが足りぬ様子……。
#. de: Und ... ich erinnere mich wieder ... Es ist nur ein Bruchstück, aber ...
#. fr: Cependant, il semblerait que ma mémoire me fasse toujours défaut...
msgctxt "NpcYell:3842:0:13"
msgid "And yet...I find that there is something within me still wanting."
msgstr "И всё же... Мне чего-то не хватает."

#. ja: いったいどうすれば、<br>この袋小路を抜け出せるのでしょうか……？
#. de: Ich darf nicht aufgeben. Ich muss meine Wanderschaft beenden.
#. fr: Mon en<shy>traî<shy>ne<shy>ment n'est pas terminé, il me reste un dernier défi à accomplir.
msgctxt "NpcYell:3843:0:13"
msgid "\\<sigh> I must find a way to overcome this. I must find my way home."
msgstr ""

#. ja: くっ、力及ばず……。
#. de: Serket ... Du hast gesiegt ...
#. fr: Je n'étais pas de taille...
msgctxt "NpcYell:3844:0:13"
msgid "To think...my strength would fail me at a time like this!"
msgstr "Неужели... мои силы подвели меня в такой момент!"

#. ja: 私めのなんと未熟なことか……。<br>修行の道は、長く険しくございます。
#. de: Aber das soll nicht das letzte Wort gewesen sein. Ich werde mein Schicksal erfüllen!
#. fr: Hors de question d'abandonner maintenant. Je dois devenir plus forte<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:3845:0:13"
msgid "I will not be denied. I <i>will</i> find my way back home!"
msgstr "Я не сдамся. Я <i>обязательно</i> найду дорогу домой!"

#. ja: この気配……何やら「ゆがみ」を感じます。
#. de: Spürst du das?
#. fr: Cette aura effrayante... Vous la sentez, vous aussi<nbsp>?
msgctxt "NpcYell:3846:0:13"
msgid "On your guard! I sense a dark presence..."
msgstr "Берегись! Я чувствую присутствие тьмы..."

#. ja: 現れましたな！
#. de: Da!
#. fr: Là<nbsp>!
msgctxt "NpcYell:3847:0:13"
msgid "There! And it is not alone..."
msgstr "Вон они! И не одни..."

#. ja: 凶悪な魔物が2体……。<br>されど、こちらもひとりではございませぬ。
#. de: Zwei Gegner ... Aber ich habe <if $gn4>eine starke Verbündete<else>einen starken Verbündeten</if>.
#. fr: Deux ennemis... Mais je ne suis pas seule, moi non plus<nbsp>!
msgctxt "NpcYell:3848:0:13"
msgid "But I am not alone either."
msgstr "Но и я не одна."

#. ja: いざ、尋常に！
#. de: Also los, auf sie mit Gebrüll!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:3849:0:13"
msgid "I will deal with the dragon. Pray attend to the eye. "
msgstr "С драконом разберусь я. Займитесь глазом."

#. ja: これはいったい！？<br>まるで幻がごとく、刃が通りませぬ……！
#. de: Was ist das? Meine Waffe dringt nicht durch ...
#. fr: Hein<nbsp>!? Ma lame est impuissante...
msgctxt "NpcYell:3850:0:13"
msgid "I-I struck true, and yet...it is unharmed!?"
msgstr "Я... я попала, но... он цел!?"

#. ja: 虚無のごとき、この手応え……もはや、為すすべが。<br>……ここまで、か。
#. de: Durchhalten, wir schaffen es!
#. fr: Courage, nous pouvons le faire<nbsp>!
msgctxt "NpcYell:3851:0:13"
msgid "I fear I am nearing my limit..."
msgstr "Боюсь, силы мои на исходе..."

#. ja: はっ！<br>貴方様はそれでも戦い続けるというのですね……。
#. de: Das ist der Lohn der Arbeit - ein weiterer Kadaver unter der Sonne.
#. fr: Le véritable combat commence maintenant.
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:3852:0:13"
msgid "No! I did not come this far to fail now! I <i>will</i> return to my world! "
msgstr "Нет! Я зашла слишком далеко, чтобы теперь отступить! Я <i>обязательно</i> вернусь в свой мир!"

#. ja: ああ、そのお姿は、まるで……。
#. de: Der Schleier des Vergessens hat sich wieder ein Stück gelichtet ...
#. fr: <split " " 1><string $gs1></split>... Maître<nbsp>!?
msgctxt "NpcYell:3853:0:13"
msgid "To Master..."
msgstr "Наставник..."

#. ja: これは……？<br>まるで磨かれたように心の曇りが晴れてゆく……。
#. de: Ich fühle mich, als hätte ich ein längst vergessenes Buch geöffnet ... als hätte ich eine lange verschlossene Tür aufgestoßen ...
#. fr: Oh<nbsp>! On dirait que la brume qui enveloppait mon cœur se dissipe<nbsp>!
msgctxt "NpcYell:3854:0:13"
msgid "The power...it fills me!"
msgstr "Сила... Она наполняет меня!"

#. ja: 今なら……今こそ、この技を使う時！
#. de: Es geschah genau in dem Moment, als ich diese Technik einsetzte ...!
#. fr: C'est le moment ou jamais d'utiliser cette technique...
msgctxt "NpcYell:3855:0:13"
msgid "The power of Amatsu: Kyori!"
msgstr "Сила «Амацу: Кёри»!"

#. ja: 空蝉のごときその幻、打ち破らん！
#. de: <split " " 1><string $gs1></split>! Bist du etwa ...?
#. fr: Trépasse, monstre du néant<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:3856:0:13"
msgid "Come, <split \" \" 1><string $gs1></split>. It begins!"
msgstr "Ну же, <split \" \" 1><string $gs1></split>. Всё только начинается!"

#. ja: とうとう、ここまでたどり着くことができ申した。
#. de: Meine Wanderschaft ist beendet.
#. fr: Ça y est, j'ai réussi...
msgctxt "NpcYell:3857:0:13"
msgid "At last, my training is complete. And it is all thanks to you."
msgstr "Наконец-то я завершила тренировку. И всё благодаря вам."

#. ja: すべては貴方様のおかげ……。<br>そのお姿が、大切なものを思い出させてくれました。
#. de: Und das habe ich dir zu verdanken. Du hast die Erinnerung in mir wach<shy>gerufen.
#. fr: Je ne sais pas comment vous remercier, <split " " 1><string $gs1></split>. En vous voyant combattre, j'ai eu comme une révélation...
msgctxt "NpcYell:3858:0:13"
msgid "You were always there to keep me on the path."
msgstr "Вы всегда помогали мне не сбиться с пути."

#. ja: いろいろ話したいことがございます。<br>一度、リムサ・ロミンサに戻りましょう。
#. de: Lass uns nach Limsa Lominsa zurückkehren. Es gibt viel, was ich dir zu sagen habe.
#. fr: Retournons à Limsa Lominsa, j'ai beaucoup de choses à vous raconter.
msgctxt "NpcYell:3859:0:13"
msgid "I would speak with you more, but not here. Let us make for Limsa Lominsa."
msgstr "Я бы хотела поговорить с вами, но не здесь. Возвращайтесь со мной в Лимсу Ломинсу."

#. ja: そんなッ！<br>ああ、どうすれば……。
#. de: Nein, es darf nicht sein!
#. fr: Comment trouver la faille...<nbsp>?
msgctxt "NpcYell:3860:0:13"
msgid "H-How could this be?"
msgstr "К-как такое могло случиться?"

#. ja: 我が身に宿りし力よ！
#. de: Komm zu mir, Kraft der Krieger!
#. fr: À moi, force du guerrier bushin<nbsp>!
msgctxt "NpcYell:3861:0:13"
msgid "I will not fall!"
msgstr "Не паду!"

#. ja: やあッ
#. de: Huuu-ah!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:3862:0:13"
msgid "Hyah!"
msgstr "Хия!"

#. ja: 散り果てよ！
#. de: Nimm das!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:3863:0:13"
msgid "Take that!"
msgstr "Получай!"

#. ja: はあッ！
#. de: Uaaah!
#. fr: Haa<nbsp>!
msgctxt "NpcYell:3864:0:13"
msgid "Hyaaa!"
msgstr "Хья-а!"

#. ja: 観念いたしなされッ！
#. de: Blühe, Hanaikusa!
#. fr: Résigne-toi<nbsp>!
msgctxt "NpcYell:3865:0:13"
msgid "Ever shall we rise!"
msgstr "Вечно будем подниматься вновь!"

#. ja: 朧月<br>異邦にそよぐ　星が唄…！
#. de: Tsukioboro! Der Mond wacht über die funkelnden Sterne ...
#. fr: Ma résolution vaincra<nbsp>!
msgctxt "NpcYell:3866:0:13"
msgid "A million souls sing to me!"
msgstr "Миллион душ поёт мне!"

#. ja: いつの間に…！？
#. de: Aber wie ...?
#. fr: Mais comment...<nbsp>!?
msgctxt "NpcYell:3867:0:13"
msgid "How did they!?"
msgstr "Как они успели!?"

#. ja: か、かくなる上は！
#. de: Argh, sie sind hier!
#. fr: Argh<nbsp>! Ils sont coriaces<nbsp>!
msgctxt "NpcYell:3868:0:13"
msgid "They're here!"
msgstr "Они здесь!"

#. ja: 死ね、逆賊め！
#. de: Sterbt, Häretiker!
#. fr: Crève, sale hérétique<nbsp>!
msgctxt "NpcYell:3869:0:13"
msgid "Die, heathens!"
msgstr "Смерть вам, язычники!"

#. ja: 穢れた異端者どもめ！
#. de: Verräter!
#. fr: Bande de pourritures<nbsp>!
msgctxt "NpcYell:3870:0:13"
msgid "Traitorous scum!"
msgstr "Предательская сволочь!"

#. ja: 異端には死あるのみ！
#. de: Soll die Furie euch holen!
#. fr: Vous brûlerez dans les sept enfers<nbsp>!
msgctxt "NpcYell:3871:0:13"
msgid "Fury take you!"
msgstr "Ярость вас побери!"

#. ja: た、助かったのね…
#. de: Ist es ... vorbei?
#. fr: Ouf, j'ai vraiment eu peur...
msgctxt "NpcYell:3872:0:13"
msgid "Is it over...?"
msgstr "Это... закончилось?"

#. ja: ありがとうございます…
#. de: Halone segne euch!
#. fr: M-merci...
msgctxt "NpcYell:3873:0:13"
msgid "Bless you!"
msgstr "Благослови вас Небо!"

#. ja: 餅つき会場はこちら！
#. de: Die Mochi sind dort drüben!
#. fr: Pour le mochi, c'est par ici<nbsp>!
msgctxt "NpcYell:3874:0:13"
msgid "The mochi is this way!"
msgstr "За моти сюда!"

#. ja: 降神餅の回収を<br>手伝ってくれませんか？
#. de: Hilfst du uns, an die Mochi-Klumpen ranzukommen?
#. fr: Pourriez-vous nous aider à récupérer les mochi de la transition<nbsp>?
msgctxt "NpcYell:3875:0:13"
msgid "Will you help us retrieve our rice cakes?"
msgstr "Поможете нам собрать рисовые лепёшки?"

#. ja: サイクロプスの動きを見て餅を取ってください！
#. de: Schau dir an, wann der Zyklop den Hammer schwingt, bevor du dich an den Mörser wagst!
#. fr: Observez bien les mouvements du cyclope pour trouver une ouverture et vous approcher<nbsp>!
msgctxt "NpcYell:3876:0:13"
msgid "Observe how the cyclops swings his mallet before making your approach!"
msgstr "Посмотрите, как циклоп размахивает молотом, прежде чем подбираться к нему!"

#. ja: このままでは<br>臼まで壊れてしまう！
#. de: Wenn er so weitermacht, zerlegt er noch den ganzen Mörser ...
#. fr: Il va pulvériser le mortier s'il continue comme ça<nbsp>!
msgctxt "NpcYell:3877:0:13"
msgid "He'll pulverize the entire mortar at this rate..."
msgstr "Так он и ступу всю расколотит..."

#. ja: どうかご武運を！
#. de: Sei flink wie ein Affe!
#. fr: Soyez agile comme un singe<nbsp>!
msgctxt "NpcYell:3878:0:13"
msgid "Be nimble like the monkey!"
msgstr "Будьте проворны, как обезьяна!"

#. ja: なんと鮮やかな回収！<br>すばらしい！
#. de: Wirklich beeindruckend!<br>Du hast die Mochi-Klumpen ergattert und das Fest gerettet!
#. fr: Magnifique<nbsp>! Vous avez sauvé tous ces mochi... et la fête de la transition<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3879:0:13"
msgid "A fine display!<br>You've saved our mochi─and the festival!"
msgstr "Вот это ловкость!<br>Вы спасли наши моти — а вместе с ними и праздник!"

#. ja: あぁ、縁起物の餅が…
#. de: So viele vergeudete Mochi ...
#. fr: Tous ces mochi gâchés, quelle tristesse...
msgctxt "NpcYell:3880:0:13"
msgid "So much mochi...wasted..."
msgstr "Столько моти... пропало зря..."

#. ja: 卑怯者どもめ、仕留めるッ！
#. de: Nun ist Schluss!
#. fr: Venez vous battre, pleutres<nbsp>!
msgctxt "NpcYell:3881:0:13"
msgid "Down with you!"
msgstr "Ну всё, вам конец!"

#. ja: アイメリクだと！？<br>殺されに来たかッ！
#. de: Es ist der Großmeister persönlich! Er ist hier, um uns zu töten!
#. fr: Tu es venu pour qu'on t'achève, Capitaine<nbsp>?
msgctxt "NpcYell:3882:0:13"
msgid "It's Ser Aymeric! He's come to kill us!"
msgstr "Это сэр Эймерик! Он пришёл нас убить!"

#. ja: 人質は処分する！<br>これは神意に背いた罰だ！
#. de: Tötet die Geiseln!<br>Die Furie will es so!
#. fr: Exterminez les otages<nbsp>! Qu'ils subissent la colère de Halone<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3883:0:13"
msgid "Execute the hostages!<br>The Fury wills it!"
msgstr "Казнить заложников!<br>Такова воля Ярости!"

#. ja: 敵は私に任せろ！<br>人質を頼む！
#. de: Kümmere dich um die Geiseln! Ich übernehme die Verräter.
#. fr: Sauvez les otages pendant que je m'occupe d'eux<nbsp>!
msgctxt "NpcYell:3884:0:13"
msgid "See to the hostages! I will occupy the rebels!"
msgstr "Займитесь заложниками! Я задержу мятежников!"

#. ja: いくぞッ！<br>人質を解放するのだ！
#. de: Legt eure Waffen nieder oder sterbt!
#. fr: Il faut faire vite, ou les otages vont y passer<nbsp>!
msgctxt "NpcYell:3885:0:13"
msgid "Lay down your arms or die by the sword!"
msgstr "Сложите оружие или умрёте от меча!"

#. ja: やってやるさ！
#. de: Los geht's!
#. fr: Prends ça dans les dents<nbsp>!
msgctxt "NpcYell:3886:0:13"
msgid "Make ready!"
msgstr "Приготовьтесь!"

#. ja: 甘く見るなよッ！
#. de: Seht euch vor!
#. fr: Tu me sous-estimes<nbsp>!
msgctxt "NpcYell:3887:0:13"
msgid "You underestimate me!"
msgstr "Не недооценивай меня!"

#. ja: これが騎士の意地だッ！
#. de: Das ist der Wille eines Ritters!
#. fr: Tu l'auras voulu<nbsp>!
msgctxt "NpcYell:3888:0:13"
msgid "This knight does not yield!"
msgstr "Этот рыцарь не отступит!"

#. ja: 人質は無事か！？
#. de: Bist du verletzt?
#. fr: Attention aux otages<nbsp>!
msgctxt "NpcYell:3889:0:13"
msgid "Are they unharmed!?"
msgstr "Они целы!?"

#. ja: フォルタンの名にかけて！
#. de: Bei der Ehre der Fortemps!
#. fr: Pour l'honneur des Fortemps<nbsp>!
msgctxt "NpcYell:3890:0:13"
msgid "Fortemps!"
msgstr "Во имя чести Фортампов!"

#. ja: 異端者めッ！
#. de: Tod den Häretikern!
#. fr: Ordure hérétique<nbsp>!
msgctxt "NpcYell:3891:0:13"
msgid "Death to the heretics!"
msgstr "Смерть еретикам!"

#. ja: こうしてくれるッ！
#. de: Die Furie steht uns bei!
#. fr: Tu ne m'échapperas pas<nbsp>!
msgctxt "NpcYell:3892:0:13"
msgid "The Fury is with us!"
msgstr "Ярость с нами!"

#. ja: 警戒は任せてくれ…
#. de: Ich steh bei Euch!
#. fr: Je monte la garde<nbsp>!
msgctxt "NpcYell:3893:0:13"
msgid "There will be others..."
msgstr "Будут и другие..."

#. ja: や、やめてぇ…
#. de: Zu Hilfe!
#. fr: A-arrêtez...
msgctxt "NpcYell:3894:0:13"
msgid "No, please!"
msgstr "Н-не надо..."

#. ja: お許しを…！
#. de: Bitte nicht!
#. fr: Pitié, non<nbsp>!
msgctxt "NpcYell:3895:0:13"
msgid "I beg of you!"
msgstr "Умоляю вас!"

#. ja: こ、殺さないでくれ！
#. de: Ich flehe euch an!
#. fr: Ne me tuez pas<nbsp>!
msgctxt "NpcYell:3896:0:13"
msgid "I don't want to die!"
msgstr "Я не хочу умирать!"

#. ja: 勘弁してくれぇ…
#. de: Ich will nicht sterben!
#. fr: Au secours<nbsp>!
msgctxt "NpcYell:3897:0:13"
msgid "I'll do anything!"
msgstr "Я на всё согласен!"

#. ja: うぅ…マエリが…<br>友だちが…
#. de: Er ... hat Maelie ...
#. fr: Ma copine, Maelie... Elle est...
msgctxt "NpcYell:3898:0:13"
msgid "He...he took Maelie..."
msgstr "Он... он забрал Маэли..."

#. ja: 誘導は私が！<br>残りの人質を頼むわよ！
#. de: Ich kümmere mich um die Verletzten. Jetzt geh!
#. fr: Je vais les mettre en sécurité<nbsp>! Occupez-vous des autres<nbsp>!
msgctxt "NpcYell:3899:0:13"
msgid "Tell them to come to me! Now go!"
msgstr "Скажи им идти ко мне! Живо!"

#. ja: 隙ありッ！
#. de: Hinfort aus Ishgard!
#. fr: Encaisse donc ça<nbsp>!
msgctxt "NpcYell:3900:0:13"
msgid "There!"
msgstr "Получай!"

#. ja: 立ち上がれケロ！
#. de: Eindringlinge, quaaak?!
#. fr: Venez à moâ<nbsp>!
msgctxt "NpcYell:3901:0:13"
msgid "Ribbit? Intruders!?"
msgstr "Ква-ква? Вторженцы!?"

#. ja: みんな出番ケロ～！
#. de: Auf sie mit Gequaaak!
#. fr: Tous en scène, coâ<nbsp>!
msgctxt "NpcYell:3902:0:13"
msgid "None shall pass, ribbit!"
msgstr "Никто не пройдёт, ква-ква!"

#. ja: 応援要請ケロ～！
#. de: Quaak! Hilfe!
#. fr: Aidez-moâ<nbsp>!
msgctxt "NpcYell:3903:0:13"
msgid "To arms, ribbit! To arms!"
msgstr "К оружию, ква-ква! К оружию!"

#. ja: 真打ち登場ケロ～！
#. de: Ein würdiger Kampf, quaaak!
#. fr: Me voalâ<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3904:0:13"
msgid "At last, a challenge!<br>\\<croak>"
msgstr ""

#. ja: ゲロゲロゲ～ロ♪
#. de: Quak, quak, quaaak ♪
#. fr: Coâ coâ coooâ<nbsp>!♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3905:0:13"
msgid "Me may mah mo,<br>me mo ma me～♪"
msgstr "Ква-ква-ква-а,<br>ква-ква-ква-а～♪"

#. ja: ゲ～ロゲロ♪
#. de: Quaaak ♪
#. fr: Coooâ coâ<nbsp>!♪
msgctxt "NpcYell:3906:0:13"
msgid "And meeeeee!♪"
msgstr "И я-я-я-я!♪"

#. ja: ケロケロケ～ロ♪
#. de: Quak, quak, quaaak ♪
#. fr: Coâ coâ coooâ<nbsp>!♪
msgctxt "NpcYell:3907:0:13"
msgid "The lovers～♪"
msgstr "Влюблённые～♪"

#. ja: ケ～ロケロ♪
#. de: Quak, quak ♪
#. fr: Coooâ coâ<nbsp>!♪
msgctxt "NpcYell:3908:0:13"
msgid "The dreamers～♪"
msgstr "Мечтатели～♪"

#. ja: ナワバリ ナワバリ<br>シンニュウスルナー！
#. de: Ziggy hält sie auf!<br>Ziggy sein groooßer Held!
#. fr: Hors de notre territoire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3909:0:13"
msgid "Ziggy save everyone!<br>Ziggy heeeeeero!"
msgstr "Зигги всех спасёт!<br>Зигги — геройюююга!"

#. ja: デッカイ マセキ<br>デテコイヤー！
#. de: Ziggy hat große Sternensteine!<br>Ziggy ist der Grööößte!
#. fr: Que les grandes pierres magiques ap<shy>pa<shy>rais<shy>sent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3910:0:13"
msgid "Ziggy biggie pretties time!<br>Ziggy Ziggy hey!"
msgstr "Зигги, пора за большими блестяшками!<br>Зигги, Зигги, эй!"

#. ja: ムカツクヤーツ<br>ブチタオース！
#. de: Schaut genau ins Licht! Genauuu ins Licht!
#. fr: Je vais tous vous exterminer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3911:0:13"
msgid "Ziggy super beam time!<br>Ziggy Ziggy hey!"
msgstr "Зигги, пора жечь лучом!<br>Зигги, Зигги, эй!"

#. ja: アーラヨット！
#. de: Ja-haa!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:3912:0:13"
msgid "Ziggy zoooooom!"
msgstr "Зигги, вперёд!"

#. ja: イックゾー！
#. de: Vorwärts, zermalmt sie!
#. fr: En avant<nbsp>!
msgctxt "NpcYell:3913:0:13"
msgid "Ziggy boooooom!"
msgstr "Зигги, бум!"

#. ja: カクゴシロー！
#. de: Zermalmt die Eindringlinge zu Staub!
#. fr: Préparez-vous à mourir<nbsp>!
msgctxt "NpcYell:3914:0:13"
msgid "Ziggy doooooom!"
msgstr "Зигги, смерть!"

#. ja: コンチキショー！
#. de: Nichts soll übrigbleiben von den Eindringlingen!
#. fr: Sales petits mollusques<nbsp>!
msgctxt "NpcYell:3915:0:13"
msgid "Ziggy shoooooom!"
msgstr "Зигги, ну держитесь!"

#. ja: フキトベー！
#. de: Verschwindet von hier!
#. fr: Allez voir ailleurs si j'y suis<nbsp>!
msgctxt "NpcYell:3916:0:13"
msgid "Ziggy pshoooooom!"
msgstr "Зигги, фьюююх!"

#. ja: ヤ…<br>ヤルジャナーイ…
#. de: 0
#. fr: J'ai comme un coup de barre...
msgctxt "NpcYell:3917:0:13"
msgid "0"
msgstr "0"

#. ja: バーカめ！
#. de: Ihr Einfaltspinsel!
#. fr: Bande de simplets<nbsp>!
msgctxt "NpcYell:3918:0:13"
msgid "You are mindless cretins!"
msgstr "Вы просто безмозглые болваны!"

#. ja: のこのこ<br>やってくるからさ！
#. de: <i>Nichts</i> wisst ihr über diesen Ort!
#. fr: Ça ne va pas faire mal...
msgctxt "NpcYell:3919:0:13"
msgid "Charging into unknown halls!"
msgstr "Сами лезете в неизвестные залы!"

#. ja: キャーホッホッー！
#. de: Hiiihihihahaha!
#. fr: Hiiii hi hi hi<nbsp>!
msgctxt "NpcYell:3920:0:13"
msgid "Yip-ho-ho!"
msgstr "И-хо-хо-хо!"

#. ja: 楽しく死んじゃえ！
#. de: Tanzt mit uns!
#. fr: Mourez dans la joie et la bonne humeur<nbsp>!
msgctxt "NpcYell:3921:0:13"
msgid "We'll cut your strings!"
msgstr "Мы вас на куски порежем!"

#. ja: ミナぎるパワー！<br>全力パンチゴブ！
#. de: Psh! Spürzzu Faust auf Glotzenauge!
#. fr: Pzhhh... Ratfinx zent zes forzes ze décupler<nbsp>! Il va écrabouiller les abrutis d'humains avec zon poing<nbsp>!
msgctxt "NpcYell:3922:0:13"
msgid "Deepflow does my might!"
msgstr "В жилах сила бьёт ключом!<br>Получай, гоблинский кулак!"

#. ja: 新型爆弾を<br>試してやるゴブ！
#. de: Gibt gleich waltige Wumms mit neue Knallenkugel! Kho kho!
#. fr: Les crétins humains vont tezter le nouveau type de bombe créé par Ratfinx<nbsp>!
msgctxt "NpcYell:3923:0:13"
msgid "New gobbiebooms, bring uplander doom!"
msgstr "Гоблинские бомбы — горцам на погибель!"

#. ja: 特許出願中の<br>出血毒を味わうゴブ！
#. de: Trinkzzu auf Sundheit von Indigohand, Großwachsene! Leider wird Rotesaft aus Adern rinnen ... Kho kho!
#. fr: Pzhhhouohoho<nbsp>!<nbsp>... Ratfinx va goûter à za nouvelle pozion contre les zaignements de nez<nbsp>!
msgctxt "NpcYell:3924:0:13"
msgid "Uplanders will make fine subjects for bloodpoison! "
msgstr "Горцы станут отличным подопытным материалом для кровавого яда!"

#. ja: お前をブン殴るゴブ！
#. de: Jetzt kriegzzu auf Deckel!
#. fr: Ratfinx va donner une bonne correztion à quelqu'un<nbsp>! Pzhhhéhéhé<nbsp>!
msgctxt "NpcYell:3925:0:13"
msgid "Flatsquash uplanders!"
msgstr "Сейчас мы горцев в лепёшку раскатаем!"

#. ja: か～え～る～の～<br>だい がっ しょ～！
#. de: Ob Pfuhl, Teich oder Tümpel<br>Seerosenblätter dümpeln<br>Und Krötenkehlen quaken ♪
#. fr: C'est la chanson des crapauds, coâ coâ coâ<nbsp>!♪
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3926:0:13"
msgid "Someday we'll find it,<br>the─\\<croak>─<br>connection～♪"
msgstr "Когда-нибудь найдём мы<br>лягушачью песню<br>вместе～♪"

#. ja: エネルギー充填…<br>発射ッ！
#. de: Vollständig geladen ... Feuer!
#. fr: Énergie du Gobrayon concentrée... Feu<nbsp>!
msgctxt "NpcYell:3927:0:13"
msgid "Energy at maximum... Fire!"
msgstr "Энергия на пределе... Огонь!"

#. ja: 予備弾倉装填…<br>一斉射ッ！
#. de: Reservemagazine eingelegt ... Feuer frei!
#. fr: Chargeur secondaire connecté... Feu à volonté<nbsp>!
msgctxt "NpcYell:3928:0:13"
msgid "Barrels at capacity... Fire all!"
msgstr "Стволы заряжены... Огонь из всех орудий!"

#. ja: 青燐水充填…<br>火炎放射ッ！
#. de: Erdseim nachgetankt ... Flammenwerfer los!
#. fr: Réservoirs de céruleum remplis... Feeeuuuu<nbsp>!
msgctxt "NpcYell:3929:0:13"
msgid "Ceruleum tanks filled... Burn them all!"
msgstr "Бак с церулеумом полон... Сожжение!"

#. ja: ゴロニャーン♪
#. de: Miau ♪
#. fr: Rrrr... Miaou<nbsp>!♪
msgctxt "NpcYell:3930:0:13"
msgid "Meow!♪"
msgstr "Мяу!♪"

#. ja: コフォ、コフォ…<br>高まってきたぞ！
#. de: Pshhhh ... Fühlt schon gleich besser!
#. fr: Pshhhouôhôhô<nbsp>!<nbsp>... Quickthinx sent sa détermination décuplée<nbsp>!
msgctxt "NpcYell:3931:0:13"
msgid "Pshhhkohhh... Gobbieblood runs hot!"
msgstr "Пшхх... Гоблинская кровь так и кипит!"

#. ja: まずは一匹<br>始末完了ッ！
#. de: Kho kho kho! Erste Schwächling ist umfallen!
#. fr: Et d'un<nbsp>! Pshhhouô... Quickthinx va tuer tous les humains<nbsp>!
msgctxt "NpcYell:3932:0:13"
msgid "The first falls!"
msgstr "Первый пал!"

#. ja: 我が勝利は<br>確定事項なのだ！
#. de: Pshh ... Großwachsene wird nicht länger klotzhängen an Bein von Denkfix!
#. fr: PshhhouôhÔHôhÔhô<nbsp>!<nbsp>... La victoire appartient à Quickthinx<nbsp>!
msgctxt "NpcYell:3933:0:13"
msgid "Victory is assured! Do not resist!"
msgstr "Победа у нас в кармане! Не сопротивляйтесь!"

#. ja: ファファファ！<br>青の手に敵はナシ！
#. de: Glaubzzu jetzt endlich?! Keiner kann siegstehlen von Indigohand!
#. fr: PshhhmouôhÔHôhÔhô<nbsp>!<nbsp>... Rien ne peut arrêter la Main indigo<nbsp>!!
msgctxt "NpcYell:3934:0:13"
msgid "None can stand against Illuminati! Resign yourselves to defeat!"
msgstr "Никто не устоит перед Иллюминатами! Смиритесь с поражением!"

#. ja: ミラージュシステム起動！
#. de: Luftspiegelungssystem bereit!
#. fr: Activation du système de mirage<nbsp>!
msgctxt "NpcYell:3935:0:13"
msgid "Engage mirage!"
msgstr "Включить мираж!"

#. ja: 全武装ロック解除<br>ターゲットロック！
#. de: Kammern entriegelt ... Ziel im Visier!
#. fr: Déverrouillage des armements<nbsp>! Commencement de la phase de combat<nbsp>!
msgctxt "NpcYell:3936:0:13"
msgid "All weapons ready! Target locked!"
msgstr "Все орудия готовы! Цель захвачена!"

#. ja: 侵入者ノ戦闘値算出…<br>最適戦術ヲ確定！
#. de: Berechne feindliche Stärke ... Gegenmaßnahmen ermittelt!
#. fr: Mesure de la valeur de combat des intrus... Méthode d'élimination optimale calculée<nbsp>!
msgctxt "NpcYell:3937:0:13"
msgid "Analyzing intruder combat potential... Selecting optimal strategy!"
msgstr "Анализ боевого потенциала нарушителей... Выбор оптимальной тактики!"

#. ja: 自動魔紋描画開始…<br>魔法戦ヲ開始シマス！
#. de: Auto-Magiemuster konstruiert ... Fertig zur Projektion!
#. fr: Production automatique de pentacles engagée... Stratégie de combat magique initiée<nbsp>!
msgctxt "NpcYell:3938:0:13"
msgid "Initializing automated ley lines... Commencing metaphysical combat sequence!"
msgstr "Построение автоматических линий силы... Начало магического боя!"

#. ja: システムオフライン…<br>強制終了シマス…
#. de: System deaktiviert ...
#. fr: Système déconnecté... Désactivation forcée enclenchée...
msgctxt "NpcYell:3939:0:13"
msgid "System offline... Forcing shutdown..."
msgstr "Система отключена... Принудительное завершение..."

#. ja: 致命的エラー<br>再起…動…ヲ…
#. de: Ladehemmung! Neustart ... in ... \<brzz>
#. fr: Erreur critique détectée<nbsp>! Rééé... acti... vaaati... ooooon...
msgctxt "NpcYell:3940:0:13"
msgid "Fatal error... Commen...cing...restart..."
msgstr "Критическая ошибка... Переза...груз...ка..."

#. ja: 入力サレタ値ガ<br>異ナリマス…
#. de: Ungültiger Wert ... \<krack>
#. fr: Valeurs saisies erronées...
msgctxt "NpcYell:3941:0:13"
msgid "Invalid input..."
msgstr "Неверный ввод..."

#. ja: エーテルダウン…<br>緊急停止…シマス…
#. de: Fataler Fehler ... Virtueller Äther wird entladen ...
#. fr: Baisse des réserves d'éther... Arrêt... d'urgence...
msgctxt "NpcYell:3942:0:13"
msgid "Aether levels critical... Emergency shutdown imminent..."
msgstr "Уровень эфира критический... Скоро аварийное отключение..."

#. ja: マホウ ノ トビラ<br>ヒラケゴマ！
#. de: Tüüüren auf! Feuer frei!
#. fr: Ouverture des portes magiques<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3943:0:13"
msgid "Open doooooors,<br>kill you deaaaaaad!"
msgstr "Откройтесь, две-е-ери,<br>убью вас всех!"

#. ja: ヨッテ タカッテ<br>ヤッチマイナー！
#. de: Geht weg! Weit weg!
#. fr: Qu'est-ce que vous dites de ça, hein<nbsp>?
msgctxt "NpcYell:3944:0:13"
msgid "Go away! Faaaaaar away!"
msgstr "Убирайтесь! Подальше отсюда!"

#. ja: マホウ ノ トビラ<br>アケチャウゾー！
#. de: Das Feuer soll euch holen!
#. fr: Que les portes magiques s'ouvrent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3945:0:13"
msgid "Not shiny! Not pretty!<br>Do not want! Do not need!"
msgstr "Не блестит! Не красиво!<br>Не хочу! Не надо!"

#. ja: モイッチョ オマケニ<br>デテコイヤー！
#. de: Raus mit euch! Das ist <i>unser</i> Turm!
#. fr: Débarrassez-nous d'eux<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3946:0:13"
msgid "Pretty tower! Our tower!<br>All for us! Not for you!"
msgstr "Красивая башня! Наша башня!<br>Всё нам! Вам ничего!"

#. ja: ニャー！
#. de: Miau! \<schnurr>
#. fr: Miaou<nbsp>!
msgctxt "NpcYell:3947:0:13"
msgid "Meow!"
msgstr "Мяу!"

#. ja: が、がんばるぞ！
#. de: Vorwärts!
#. fr: Je ferai de mon mieux<nbsp>!
msgctxt "NpcYell:3948:0:13"
msgid "My turn!"
msgstr "Теперь я!"

#. ja: 戦神ハルオーネよ、力を！
#. de: Halone, gib uns Kraft!
#. fr: Que la Conquérante nous protège<nbsp>!
msgctxt "NpcYell:3949:0:13"
msgid "Halone, grant me strength!"
msgstr "Халонэ, даруй мне силу!"

#. ja: 護衛を頼む！
#. de: Gebt mir Deckung!
#. fr: Veillez bien sur Ishgard en notre absence<nbsp>!
msgctxt "NpcYell:3950:0:13"
msgid "Defend me, brothers!"
msgstr "Братья, прикройте меня!"

#. ja: 耐え抜いてみせる！
#. de: Kein Schritt zurück!
#. fr: Ils n'ont pas intérêt à nous sous-estimer<nbsp>!
msgctxt "NpcYell:3951:0:13"
msgid "Ishgard, to me!"
msgstr "Ишгард, держись!"

#. ja: 見せ場だな！
#. de: Jetzt geht's ums Ganze!
#. fr: Le grand moment est enfin arrivé<nbsp>!
msgctxt "NpcYell:3952:0:13"
msgid "Mark well my strength!"
msgstr "Сейчас я покажу, на что способен!"

#. ja: 選ばれたか…！
#. de: Ich wurde ausgewählt?
#. fr: C'est un véritable honneur d'être ici<nbsp>!
msgctxt "NpcYell:3953:0:13"
msgid "Have I been chosen!?"
msgstr "Неужели меня выбрали?!"

#. ja: さあ、かかってこい！
#. de: Kommt doch her!
#. fr: Qu'ils y viennent<nbsp>!
msgctxt "NpcYell:3954:0:13"
msgid "Have at you!"
msgstr "Ну, подходите!"

#. ja: 私が戦術目標か！？
#. de: Ich bin das Hauptziel?!
#. fr: C'est moi le major<nbsp>?
msgctxt "NpcYell:3955:0:13"
msgid "The Fury favors me!"
msgstr "Я — избранник Ярости!"

#. ja: 続け、我らに勝利を！
#. de: Erstreitet den Sieg für Ishgard!
#. fr: La victoire sera à nous<nbsp>!
msgctxt "NpcYell:3956:0:13"
msgid "Forward, forward!"
msgstr "Вперёд, к победе!"

#. ja: 自警団の意地を見せな！
#. de: Das ist die Stunde der Miliz!
#. fr: Les miliciens ne s'avoueront jamais vaincus<nbsp>!
msgctxt "NpcYell:3957:0:13"
msgid "Watchmen, with me!"
msgstr "Стража, за мной!"

#. ja: やってやろうぜ、相棒…！
#. de: S-So viele?!
#. fr: Je vais vous montrer ce que je sais faire<nbsp>!
msgctxt "NpcYell:3958:0:13"
msgid "Fortemps, Fortemps!"
msgstr "Фортан! Фортан!"

#. ja: 不滅隊よ！<br>義父上の雄姿に続け！
#. de: Legionäre, nehmt euch ein Beispiel an General Raubahn!
#. fr: Immortels<nbsp>! Rendez-vous dignes de votre général<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3959:0:13"
msgid "Stay with the General!<br>Ul'dah! Ul'dah!"
msgstr "Не отходите от генерала!<br>Ульда! Ульда!"

#. ja: 黒渦団も負けないから！
#. de: Der Mahlstrom verschlingt euch!
#. fr: Le Maelstrom ne peut pas perdre<nbsp>!
msgctxt "NpcYell:3960:0:13"
msgid "Maelstrom, to the fore!"
msgstr "Мальстрём, вперёд!"

#. ja: 諸君、攻め込むよ…！
#. de: So, dich knöpf ich mir vor!
#. fr: À l'attaque, soldats<nbsp>!
msgctxt "NpcYell:3961:0:13"
msgid "Adders, attack!"
msgstr "Змеи, в атаку!"

#. ja: 勝敗は…<br>早さと速さが別つ！
#. de: Schnelligkeit bringt den Sieg!
#. fr: La vitesse ne fait pas tout<nbsp>!
msgctxt "NpcYell:3962:0:13"
msgid "Victory belongs to the bold!"
msgstr "Победа за смелыми!"

#. ja: 暴れるから覚悟してね！
#. de: Euch zerquetsch ich!
#. fr: Préparez-vous à subir ma colère<nbsp>!
msgctxt "NpcYell:3963:0:13"
msgid "Till sea swallows all!"
msgstr "Готовьтесь к моей ярости!"

#. ja: 精霊よ、加護を…
#. de: O Gebieter, beschützt uns!
#. fr: Esprits, protégez-moi...
msgctxt "NpcYell:3964:0:13"
msgid "Wood's will be done!"
msgstr "Воля леса свершится!"

#. ja: 耐えられるか…！？
#. de: Ich könnte Unterstützung gebrauchen!
#. fr: Je ne vais pas pouvoir résister très longtemps...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3965:0:13"
msgid "Fury guide<br>and protect me!"
msgstr "Ярость, веди меня<br>и защити!"

#. ja: 援護に感謝する！
#. de: Danke für den Schutz!
#. fr: Merci pour votre aide<nbsp>!
msgctxt "NpcYell:3966:0:13"
msgid "My thanks to you!"
msgstr "Спасибо за помощь!"

#. ja: 我が友のために！
#. de: Für unsere Freunde!
#. fr: Pour tous mes camarades<nbsp>!
msgctxt "NpcYell:3967:0:13"
msgid "For Ishgard!"
msgstr "За Ишгард!"

#. ja: 受けてもらおう！
#. de: Lasst sie kommen!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:3968:0:13"
msgid "It ends here!"
msgstr "Здесь всё и закончится!"

#. ja: 押されている！？
#. de: Haltet stand!
#. fr: Nous perdons du terrain<nbsp>!
msgctxt "NpcYell:3969:0:13"
msgid "We must stand together!"
msgstr "Надо держаться вместе!"

#. ja: 甘いんだよ！
#. de: Schwächling!
#. fr: Tu as encore beaucoup de choses à apprendre<nbsp>!
msgctxt "NpcYell:3970:0:13"
msgid "Is that all you've got!?"
msgstr "И это всё, на что ты способен?!"

#. ja: 爆ぜろッ！
#. de: Hackt sie in Stücke!
#. fr: Goûte à mes flammes<nbsp>!
msgctxt "NpcYell:3971:0:13"
msgid "Flames take you!"
msgstr "Сгиньте в пламени!"

#. ja: 狩り尽くせ…！
#. de: Macht sie nieder!
#. fr: Je vais t'avoir<nbsp>!
msgctxt "NpcYell:3972:0:13"
msgid "I've got you now!"
msgstr "Попались!"

#. ja: 再出撃だ！
#. de: Auf in den Kampf!
#. fr: En avant toute<nbsp>!
msgctxt "NpcYell:3973:0:13"
msgid "Raaargh!"
msgstr "Р-р-р-а-а-а!"

#. ja: まだまだ…！
#. de: Los, weiter!
#. fr: C'est pas encore terminé<nbsp>!
msgctxt "NpcYell:3974:0:13"
msgid "I'm not finished!"
msgstr "Я ещё не закончил!"

#. ja: やりきるって<br>決めたんだ…！
#. de: Es war meine Entscheidung!<br>Nun gibt es kein Zurück!
#. fr: Je vais y arriver<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3975:0:13"
msgid "Gah! I swore I'd<br>see this through!"
msgstr "Ах! Я поклялся<br>довести дело до конца!"

#. ja: 不覚をとった…<br>次こそは！
#. de: Neuer Versuch, neues Glück!
#. fr: Cette fois, c'est la bonne<nbsp>!
msgctxt "NpcYell:3976:0:13"
msgid "O Halone, lead us to glory!"
msgstr "О Халонэ, веди нас к славе!"

#. ja: くたばってられるか…！
#. de: Ich lass mich nicht kleinkriegen!
#. fr: Par tous les diables<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:3977:0:13"
msgid "Bah, that was<br>bloody embarrassin'..."
msgstr "Чёрт, вот же<br>позорище..."

#. ja: 何度でも斬り込む！
#. de: Ich gebe nicht auf!
#. fr: Vous allez tâter de ma lame<nbsp>!
msgctxt "NpcYell:3978:0:13"
msgid "By fire we are reborn!"
msgstr "Мы возродимся в огне!"

#. ja: 戦線復帰だよ！
#. de: Zurück in die Angriffslinie!
#. fr: Retour en première ligne<nbsp>!
msgctxt "NpcYell:3979:0:13"
msgid "Once more, unto the breach!"
msgstr "Снова в бой!"

#. ja: カチンときた…<br>借りは返そう
#. de: Den Schmerz zahl ich euch heim!
#. fr: Je vais vous rendre la monnaie de votre pièce<nbsp>!
msgctxt "NpcYell:3980:0:13"
msgid "Hmph! I will be revenged!"
msgstr "Хм! Я вам ещё отплачу!"

#. ja: 狙い撃つ！
#. de: Feuer!
#. fr: En plein dans le mille<nbsp>!
msgctxt "NpcYell:3981:0:13"
msgid "Right there!"
msgstr "Вот так!"

#. ja: システムリンク同調完了…<br>抹殺システム起動準備！
#. de: Alle Elemente verbunden ... Aktiviere Eliminierungssystem.
#. fr: Conformation achevée... Pré-activation du mode d'extermination<nbsp>!
msgctxt "NpcYell:3989:0:13"
msgid "System synchronization complete... Auto-clean is on standby!"
msgstr "Синхронизация систем завершена... Автоочистка готова!"

#. ja: 自爆シーケンス起動…<br>カウントダウン開始…
#. de: Selbstzerstörungssequenz eingeleitet ... Countdown beginnt!
#. fr: Séquence d'auto-destruction engagée... Lancement du compte à rebours...
msgctxt "NpcYell:3990:0:13"
msgid "Self-destruct sequence initiated... Beginning countdown..."
msgstr "Запуск последовательности самоуничтожения... Начало обратного отсчёта..."

#. ja: ミラージュシステム起動！
#. de: Luftspiegelungssystem aktiv!
#. fr: Activation du système de mirage<nbsp>!
msgctxt "NpcYell:3991:0:13"
msgid "Initializing mirage system!"
msgstr "Инициализация системы миража!"

#. ja: リミッター解除！<br>ハイパーモード！！
#. de: Begrenzer aus ... Operiere im Hypermodus!
#. fr: Déconnexion du limiteur<nbsp>! Activation de l'hyper-mode<nbsp>!
msgctxt "NpcYell:3992:0:13"
msgid "Limiter released! Commencing hyper mode!"
msgstr "Ограничитель снят! Запуск гиперрежима!"

#. ja: 幻惑失敗…<br>強制終了シマス…
#. de: Illusion fehlgeschlagen. Beende System.
#. fr: Tentative d'éblouissement ratée... Désactivation forcée du système...
msgctxt "NpcYell:3993:0:13"
msgid "Illusion failed... Forcing shutdown..."
msgstr "Иллюзия не удалась... Принудительное отключение..."

#. ja: 全武装ロック解除<br>戦闘フェーズ移行！
#. de: Entsicherung komplett, nächste Phase: Attacke!
#. fr: Déverrouillage des armements<nbsp>! Commencement de la phase de combat<nbsp>!
msgctxt "NpcYell:3994:0:13"
msgid "All weapons locked and loaded... Commencing combat mode!"
msgstr "Все орудия заряжены... Переход в боевой режим!"

#. ja: リミッター解除！<br>ハイパーモード！！
#. de: Begrenzer aus ... Operiere im Hypermodus!
#. fr: Déconnexion du limiteur<nbsp>! Activation de l'hyper-mode<nbsp>!
msgctxt "NpcYell:3995:0:13"
msgid "Limiter released! Commencing hyper mode!"
msgstr "Ограничитель снят! Запуск гиперрежима!"

#. ja: …応答ナシ<br>強制終了シマスカ？
#. de: System reagiert nicht. Beenden?
#. fr: Pas de réponse du système moteur... Confirmer désactivation forcée...<nbsp>?
msgctxt "NpcYell:3996:0:13"
msgid "...Awaiting response... Force shutdown?"
msgstr "...Ожидание ответа... Принудительно отключить?"

#. ja: 戦闘値再計算…<br>最適戦術ヲ変更！
#. de: Neuberechnung ... Ändere Strategie!
#. fr: Nouvelle mesure de la valeur de combat... Méthode d'élimination optimale recalculée<nbsp>!
msgctxt "NpcYell:3997:0:13"
msgid "Recalculating combat variables... Switching to optimal combat strategy..."
msgstr "Перерасчёт боевых параметров... Переход к оптимальной тактике..."

#. ja: リミッター解除！<br>ハイパーモード！！
#. de: Begrenzer aus ... Operiere im Hypermodus!
#. fr: Déconnexion du limiteur<nbsp>! Activation de l'hyper-mode<nbsp>!
msgctxt "NpcYell:3998:0:13"
msgid "Limiter released! Commencing hyper mode!"
msgstr "Ограничитель снят! Запуск гиперрежима!"

#. ja: 計算式ニ<br>致命的エラー発見…
#. de: Zeile 2 fehlerhaft ... Formel nicht wohlgeformt ...
#. fr: Erreur critique détectée dans la méthode de calcul...
msgctxt "NpcYell:3999:0:13"
msgid "Reanalyzing variables... Fatal error detected..."
msgstr "Повторный анализ параметров... Обнаружена критическая ошибка..."
