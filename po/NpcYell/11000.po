# NpcYell
msgid ""
msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 痺レ、怯エヨ…！
#. de: Erstarrt vor Furcht!
#. fr: Schaaaa.... La peur vous paralysera...<nbsp>!
msgctxt "NpcYell:11000:0:13"
msgid "Succumb to the paralyzing power of fear!"
msgstr "Поддайся сковывающей силе страха!"

#. ja: グオオオン！<br>叩ク、叩ク、叩キ潰ス！
#. de: Wraaaaar!<br>Immer feste drauuuf!
#. fr: Grraaah<nbsp>! Frapper<nbsp>! Frappeeer<nbsp>!!!
msgctxt "NpcYell:11001:0:13"
msgid "Grrroooaaarrr!!! Grind bones to dust!"
msgstr "Гррра-а-а!!! Перемелю кости в пыль!"

#. ja: グオオオン！<br>ビリビリ、バリバリィィ！
#. de: Wraaaaar!<br>Es knistert, es kribbelt!
#. fr: Le feu du ciel pour vous<nbsp>! Hé hé hé<nbsp>!
msgctxt "NpcYell:11002:0:13"
msgid "Rip flesh from bones!"
msgstr "Разорву плоть с костей!"

#. ja: ビリビリ、バリバリィィ！
#. de: Hört es knistern, spürt es kribbeln!
#. fr: Des éclairs<nbsp>! Plus d'éclairs<nbsp>!
msgctxt "NpcYell:11003:0:13"
msgid "Rip and teeeaaarrr!!!"
msgstr "Разрыв! Рвууу!"

#. ja: グオオオン！<br>逃ゲロ、逃ゲロォォ！
#. de: Wraaaaar!<br>Rennt, reeennt!
#. fr: Vous n'avez nulle part où fuir<nbsp>!
msgctxt "NpcYell:11004:0:13"
msgid "Nowhere to run! Nowhere to hide!"
msgstr "Не убежать! Не спрятаться!"

#. ja: 来イ！<br>下僕ドモォォ！
#. de: Kommt, meine Dieneeer!
#. fr: Mes servants<nbsp>! Répondez à mon appel<nbsp>!
msgctxt "NpcYell:11005:0:13"
msgid "Smash together!"
msgstr "Сокрушим их вместе!"

#. ja: 吠エロォォ！
#. de: Nieder mit euch!
#. fr: Grraaaah<nbsp>!
msgctxt "NpcYell:11006:0:13"
msgid "Grrroooaaaaaahhh!!!"
msgstr "Гррра-а-а!!!"

#. ja: 逃ゲラレマイィィ！
#. de: Niemand wird entkommeeen!
#. fr: Jetez-vous sur mes pièges<nbsp>!
msgctxt "NpcYell:11007:0:13"
msgid "Run and die!"
msgstr "Беги и умри!"

#. ja: ムキムキ、バリバリィィ！
#. de: Doppeltes Knistern,<br>doppeltes Kribbeeeln!
#. fr: Des éclairs<nbsp>! Encore et encore<nbsp>!
msgctxt "NpcYell:11008:0:13"
msgid "Strike twice! Strike dead!"
msgstr "Ударю дважды! Насмерть!"

#. ja: 迷宮王ノ、呪イダァァ！
#. de: Der König des Labyrinths verflucht euch!
#. fr: Je vous maudis, indésirables<nbsp>!
msgctxt "NpcYell:11009:0:13"
msgid "Curse intruders!"
msgstr "Проклинаю незваных гостей!"

#. ja: 呪イニ震エロォォ！
#. de: Zittert vor seinem Fluch!
#. fr: Cette malédiction vous suivra dans la tombe<nbsp>!
msgctxt "NpcYell:11010:0:13"
msgid "Intruders suffer! Intruders despair!"
msgstr "Трепещите под проклятием! Отчайтесь!"

#. ja: 逃ゲロ、逃ゲロ<br>逃ゲ惑エェェ！
#. de: Rennt! Doch es gibt kein Entfliiieh'n!
#. fr: Fuyez tant que vous voudrez, ça ne changera rien<nbsp>!
msgctxt "NpcYell:11011:0:13"
msgid "Doom comes!"
msgstr "Рок близок!"

#. ja: モットモット、呪イダァァ！
#. de: Verflucht! Seid verfluuucht!
#. fr: Soyez cent fois maudits<nbsp>!
msgctxt "NpcYell:11012:0:13"
msgid "Curse intruders!"
msgstr "Проклинаю незваных гостей!"

#. ja: 呪イニ震エロォォ！
#. de: Zittert vor seinem Fluch!
#. fr: La mort n'apaisera pas cette souffrance<nbsp>!
msgctxt "NpcYell:11013:0:13"
msgid "More suffering! More despair!"
msgstr "Больше страданий! Больше отчаяния!"

#. ja: シブトイウジ虫ドモォォ！
#. de: Ihr lästigen Würmer!
#. fr: Grrrrr<nbsp>!!! Vous ne vous en sortirez pas comme ça<nbsp>!
msgctxt "NpcYell:11014:0:13"
msgid "Intruders stubborn! Foolish!"
msgstr "Упрямые незваные гости! Глупцы!"

#. ja: 最後マデ<br>戦イ続ケルゥゥ！
#. de: Mich besiegt ihr niiie!
#. fr: Je n'en aurai fini qu'avec votre dernier soupir<nbsp>!
msgctxt "NpcYell:11015:0:13"
msgid "Intruders never leave alive!  Grrroooaaarrr!!!"
msgstr "Никому из вас не уйти живым! Гррра-а-а!!!"

#. ja: 降神祭を祝う荒神楽<br>これより開催いたします！
#. de: Möge der Himmelswende-Kagura beginnen!
#. fr: L'Ara-kagura va bientôt commencer<nbsp>! Venez fêtez la transition avec nous<nbsp>!
msgctxt "NpcYell:11016:0:13"
msgid "Prepare to witness an ancient Far Eastern ritual!"
msgstr "Приготовьтесь увидеть древний ритуал Дальнего Востока!"

#. ja: さあさあ、お気軽に<br>お立ち寄りくださいませ～！
#. de: Nur keine Scheu! Jeder ist herzlich willkommen!
#. fr: Approchez, approchez<nbsp>! Venez voir notre superbe spectacle<nbsp>!
msgctxt "NpcYell:11017:0:13"
msgid "Do not be shy now. The more the merrier!"
msgstr "Не стесняйтесь, подходите! Чем больше зрителей, тем веселее!"

#. ja: ほう、東方の演目か…
#. de: Hm, ein fernöstliches Schauspiel ...
#. fr: Une pièce de théâtre orientale, hein...
msgctxt "NpcYell:11018:0:13"
msgid "Huh, this could be interesting..."
msgstr "Хм, может быть интересно..."

#. ja: どれどれ見ていこうか…
#. de: Könnte ganz interessant sein ...
#. fr: Jetons-y un œil<nbsp>!
msgctxt "NpcYell:11019:0:13"
msgid "Might be worth a watch."
msgstr "Стоит взглянуть."

#. ja: 楽しみだな…
#. de: Ich bin gespannt, wie es wird!
#. fr: J'ai hâte de voir ça<nbsp>!
msgctxt "NpcYell:11020:0:13"
msgid "Oh, I can't wait."
msgstr "Ох, не терпится!"

#. ja: これより始まるは、武者と猛虎の大立ち回り……<br>「猛虎退治」の荒神楽をご覧あれ！
#. de: Sehr verehrte Damen und Herren! Gleich beginnt „Die Vertreibung des wilden Tigers“!
#. fr: Et maintenant, sous vos yeux ébahis, va commencer la grande bataille entre notre guerri<if $gn4>ère<else>er</if> et un tigre féroce<nbsp>!
msgctxt "NpcYell:11021:0:13"
msgid "It is time for a fight most ferocious: one between man and beast!"
msgstr "Настало время яростной схватки человека и зверя!"

#. ja: 屏風に潜みしは、悪しき白虎……！<br>我が弟子が秘術にて、追い出してご覧に入れましょう！
#. de: Noch ist Byakko, der weiße Tiger, im Wandschirm gefangen, doch mein Schüler wird einen Zauber wirken, der ihn entfesselt!
#. fr: Mon disciple et moi-même allons donner vie à ce tigre blanc sanguinaire<nbsp>!
msgctxt "NpcYell:11022:0:13"
msgid "Now, watch as my apprentice summons the fearsome Byakko from the folding screen!"
msgstr "Смотрите, как мой ученик вызовет грозного Бякко из ширмы!"

#. ja: ハッ…！
#. de: Los!
#. fr: Tiens<nbsp>!
msgctxt "NpcYell:11023:0:13"
msgid "\\<grunt>"
msgstr "\\<grunt>"

#. ja: それッ！
#. de: Seht her!
#. fr: Et voilà<nbsp>!
msgctxt "NpcYell:11024:0:13"
msgid "Behold!"
msgstr "Взгляните!"

#. ja: 荒ぶる白虎に対するは、義心により立ち上がりし武者！<br>いざ尋常に、勝負でございます！
#. de: Der edle Krieger stellt sich unerschrocken dem furchtbaren Tiger! Ein Kampf auf Leben und Tod!
#. fr: Un<if $gn4>e</if> guerri<if $gn4>ère<else>er</if> valeureu<if $gn4>se<else>x</if> contre un tigre féroce<nbsp>! Que le combat commence<nbsp>!
msgctxt "NpcYell:11025:0:13"
msgid "Do not fear! We have a noble warrior at hand ready to slay the foul feline."
msgstr "Не бойтесь! Наш доблестный воин готов сразить мерзкого тигра."

#. ja: す、すごい！
#. de: I-Ich fass es nicht!
#. fr: Incroyable<nbsp>!
msgctxt "NpcYell:11026:0:13"
msgid "Oh my!"
msgstr "Ого!"

#. ja: 本当に絵から虎が！？
#. de: Er ist einfach so aus dem Wandschirm spaziert!
#. fr: Le tigre est vraiment sorti du dessin<nbsp>!
msgctxt "NpcYell:11027:0:13"
msgid "I can scarce believe my eyes!"
msgstr "Не верю своим глазам!"

#. ja: 悪しき白虎、恐ろしき巨体なれど、その動き風の如し！
#. de: Byakko, stark und groß, aber auch flink und wendig!
#. fr: Un tigre blanc redoutable et énorme, mais rapide comme le vent<nbsp>!
msgctxt "NpcYell:11028:0:13"
msgid "Byakko possesses a bulky frame, but he is more agile than most men!"
msgstr "Бякко огромен и могуч, но проворнее многих людей!"

#. ja: 幾百年の時を生きた白虎、<br>神通力を持ちて、武者の目を惑わさん！
#. de: Byakkos gottgleiche Kräfte haben über die Jahrhunderte an sogar noch Stärke zugenommen, doch der Krieger lässt sich nicht beirren!
#. fr: Les pouvoirs divins de ce tigre blanc vieux de plusieurs centaines d'années ne trompent pas notre guerri<if $gn4>ère<else>er</if><nbsp>!
msgctxt "NpcYell:11029:0:13"
msgid "Byakko is more than capable of bewitching any foes that let their guard down."
msgstr "Бякко вполне способен околдовать любого врага, который потеряет бдительность."

#. ja: さあ、いよいよ大詰め！<br>我らが武者が、悪しき白虎を追い込んでいますよ！
#. de: Wir nähern uns dem Schlussakt! Es sieht schlecht aus für den weißen Tiger!
#. fr: Et maintenant le coup de grâce<nbsp>! Notre <if $gn4>guerrière<else>guerrier</if> arrive bientôt à bout du tigre féroce<nbsp>!
msgctxt "NpcYell:11030:0:13"
msgid "Byakko is on his last legs! The noble warrior's victory is imminent!"
msgstr "Бякко на последнем издыхании! Победа доблестного воина близка!"

#. ja: 見事、白虎は討ち倒され、<br>これにて当地の邪気は払われましてございます！
#. de: Byakko ist besiegt und damit das Böse aus der Welt geschafft!
#. fr: Grâce à la défaite du tigre féroce, les mauvais esprits de cette terre ont été bannis<nbsp>!
msgctxt "NpcYell:11031:0:13"
msgid "The beast is slain and with that the land has been successfully purified."
msgstr "Зверь повержен, а значит, земля очищена от скверны."

#. ja: 此度の荒神楽は、これにて終幕……<br>またのお越しをお待ちしております！
#. de: Wer Gefallen an dieser Vorführung gefunden hat, möge uns bald wieder mit einem Besuch beehren!
#. fr: C'est donc la fin de notre Ara-kagura, mais nous espérons vous revoir très bientôt<nbsp>!
msgctxt "NpcYell:11032:0:13"
msgid "This marks the end of our ritual. We do hope you found it to your liking."
msgstr "На этом наш ритуал окончен. Надеемся, вам понравилось."

#. ja: すごい…<br>虎の絵が戻ったわ！
#. de: Sieh nur! Der Tiger ist in den Wandschirm zurückgekehrt!
#. fr: Ouah...<nbsp>! Le dessin de tigre est revenu<nbsp>!
msgctxt "NpcYell:11033:0:13"
msgid "Look, the tiger's returned to the folding screen!"
msgstr "Смотрите, тигр вернулся на ширму!"

#. ja: これぞ東方の神秘！
#. de: Fernöstliche Zauberei macht's möglich<nbsp>...
#. fr: Ces techniques secrètes orientales sont incroyables<nbsp>!
msgctxt "NpcYell:11034:0:13"
msgid "Now I've seen it all..."
msgstr "Вот это да... Теперь меня ничем не удивить."

#. ja: おやおや、奮戦虚しく成敗ならず……！<br>白虎はどこぞへと逃げ去ったようでございます……！
#. de: Das ging wohl daneben ... Byakko hat sich davongemacht.
#. fr: Eh bien il semblerait que le tigre ait réussi à s'échapper et à gagner ce combat<nbsp>!
msgctxt "NpcYell:11035:0:13"
msgid "Oh dear. It would appear our noble warrior has failed! Byakko has fled to fight another day."
msgstr "Ох, похоже, наш доблестный воин потерпел поражение! Бякко сбежал, чтобы сразиться в другой день."

#. ja: あの虎…<br>そのままで大丈夫…？
#. de: Stellt der Tiger denn keine Gefahr dar?
#. fr: Euh... Vous êtes sûrs que c'est une bonne idée de le laisser s'enfuir<nbsp>?
msgctxt "NpcYell:11036:0:13"
msgid "Is that not a problem?"
msgstr "Разве это не опасно?"

#. ja: 心配ご無用、あくまでも秘術で具現化した幻ですので、<br>いまごろ霞と消えておりますよ。
#. de: Keine Sorge, er ist nicht wirklich aus Fleisch und Blut. Mittlerweile wird er sich bereits in Luft aufgelöst haben.
#. fr: Ne vous en faites pas, ce n'est rien d'autre qu'une illusion, après tout. Il a sûrement déjà disparu comme la brume<nbsp>!
msgctxt "NpcYell:11037:0:13"
msgid "Do not fret. That Byakko was merely an illusion. It cannot sustain its form indefinitely."
msgstr "Не тревожьтесь. Бякко был всего лишь иллюзией. Он не может сохранять облик вечно."

#. ja: それなら安心だ…
#. de: Puh, dann ist ja gut!
#. fr: Ouf...<nbsp>!
msgctxt "NpcYell:11038:0:13"
msgid "Well, that's good to know."
msgstr "Ну, теперь я спокоен."

#. ja: な、ななな…<br>なんと勇ましき猫！
#. de: W-Was für eine große Miezekatze!
#. fr: Quel chat vaillant<nbsp>!
msgctxt "NpcYell:11039:0:13"
msgid "A fiercer feline I have never seen."
msgstr "Такого свирепого кота я ещё не видел!"

#. ja: 美しく…<br>そして気高い！
#. de: Und wie schön und stolz sie ist!
#. fr: Il est si beau, si noble...<nbsp>!
msgctxt "NpcYell:11040:0:13"
msgid "It is...beautiful."
msgstr "Он... прекрасен."

#. ja: 嗚呼、テンゼン…
#. de: Ach, Tenzen ...
#. fr: Ah, Tenzen...
msgctxt "NpcYell:11041:0:13"
msgid "Ah, Tenzen..."
msgstr "Ах, Тэндзэн..."

#. ja: しっかり…<br>そこですよ！
#. de: Pass auf!
#. fr: Je dois me reprendre... C'est là<nbsp>!
msgctxt "NpcYell:11042:0:13"
msgid "That's it!"
msgstr "Вот так!"

#. ja: この演目の題材…<br>まさか…
#. de: Was soll das darstellen? Doch nicht etwa ...
#. fr: Le thème de cette pièce... Ce n'est quand même pas...<nbsp>?
msgctxt "NpcYell:11043:0:13"
msgid "This all feels oddly familiar..."
msgstr "Что-то мне всё это напоминает..."

#. ja: 幻といえど<br>虎ならばもっと素早く…！
#. de: Ein Tiger muss schnell sein, ob er nun echt ist oder nicht.
#. fr: Je sais bien que ce n'est qu'une illusion, mais un tigre serait quand même plus rapide...<nbsp>!
msgctxt "NpcYell:11044:0:13"
msgid "Are tigers not usually a bit more agile?"
msgstr "Разве тигры обычно не проворнее?"

#. ja: 頑張れ～！
#. de: Lass dich nicht unterkriegen!
#. fr: Allez, courage<nbsp>!
msgctxt "NpcYell:11045:0:13"
msgid "Do not falter!"
msgstr "Не сдавайся!"

#. ja: そこだッ！<br>いけいけ～！
#. de: Los! Gib's ihm!
#. fr: Oui, bravo<nbsp>! Vas-y<nbsp>!
msgctxt "NpcYell:11046:0:13"
msgid "Splendid strike!"
msgstr "Отличный удар!"

#. ja: なんという迫力…！
#. de: Was für eine Kraft!
#. fr: Quelle puissance<nbsp>!
msgctxt "NpcYell:11047:0:13"
msgid "Quite the spectacle..."
msgstr "Вот это зрелище..."

#. ja: あの虎…<br>まるで本物みたいだ！
#. de: Ich schwöre, dieser Tiger ist echt!
#. fr: On dirait un véritable tigre<nbsp>!
msgctxt "NpcYell:11048:0:13"
msgid "Are we certain that's not a real tiger?"
msgstr "Вы уверены, что это не настоящий тигр?"

#. ja: <sound 1 51>ただいま、「オフィシャルトーナメント」を開催中です。<br>手に汗握るトリプルトライアドの勝負を体験したい方は、<br>是非、「トリプルトライアドエリア」へお越しください！
#. de: <sound 1 51>Ein offizielles Turnier findet statt!<br>Begib dich schnell zum Kartenspiel-Salon und zeig, was du beim Triple Triad drauf hast!
#. fr: <sound 1 51>Un tournoi officiel de Triple Triade est en cours<nbsp>! Rendez-vous au square des duellistes pour vous inscrire et mettre à l'épreuve votre maîtrise des cartes<nbsp>!
#. macro: <sound 1 51> — plays a sound effect; kind = 1, sound = 51 (game data: keep it; it may move or repeat)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11049:0:13"
msgid "<sound 1 51>An Open tournament is currently in session!<br>Head to Card Square to sign up and put your Triple Triad talents to the test!"
msgstr "<sound 1 51>Сейчас проходит открытый турнир!<br>Приходите на Площадь карт, чтобы записаться и испытать свои силы в тройной триаде!"

#. ja: 火の魔力を<br>ソイルに…！
#. de: Ich werde euch zu Asche verbrennen!
#. fr: Mes flammes vous réduiront en cendres<nbsp>!
msgctxt "NpcYell:11050:0:13"
msgid "I'll burn you to ash!"
msgstr "Я сожгу вас дотла!"

#. ja: 雷の魔力を<br>ソイルに…！
#. de: Möge euch der Blitz erschlagen!
#. fr: Que ma pistolame vous foudroie<nbsp>!
msgctxt "NpcYell:11051:0:13"
msgid "May lightning smite you!"
msgstr "Пусть молния поразит вас!"

#. ja: 「マザーボム」のものまね！
#. de: Diesen Zauber habe ich von Progenitrix gelernt!
#. fr: J'ai appris ce sort auprès de la maman bombo<nbsp>!
msgctxt "NpcYell:11052:0:13"
msgid "An imitation of...Progenitrix!"
msgstr "Подражаю... Бомбо-матери!"

#. ja: 「オルトロス」のものまね！
#. de: Der kommt von Ultros!
#. fr: Celui-ci me vient d'Orthros<nbsp>!
msgctxt "NpcYell:11053:0:13"
msgid "An imitation of...Ultros!"
msgstr "Подражаю... Ультросу!"

#. ja: 「ドゥリン」のものまね！
#. de: Und jetzt ein bisschen Durinn!
#. fr: Un peu de Durinn à présent<nbsp>!
msgctxt "NpcYell:11054:0:13"
msgid "An imitation of...Durinn!"
msgstr "Подражаю... Дуринну!"

#. ja: 「火のシキガミ」のものまね！
#. de: Der Shikigami des Feuers kämpfte so!
#. fr: Le shikigami de feu se battait comme ça...
msgctxt "NpcYell:11055:0:13"
msgid "An imitation of...the shikigami of the pyre!"
msgstr "Подражаю... огненному сикигами!"

#. ja: 「水のシキガミ」のものまね！
#. de: Der Shikigami des Wassers nutzte diesen Zauber oft!
#. fr: Le shikigami d'eau utilisait souvent ce sort...
msgctxt "NpcYell:11056:0:13"
msgid "An imitation of...the shikigami of the undertow!"
msgstr "Подражаю... сикигами водоворота!"

#. ja: 「ジークフリード」のものまね！
#. de: Das hat Siegfried ausgespuckt!
#. fr: Du Siegfried tout craché<nbsp>!
msgctxt "NpcYell:11057:0:13"
msgid "An imitation of...Siegfried!"
msgstr "Подражаю... Зигфриду!"

#. ja: 「フンババ・パパ」のものまね！
#. de: Eine Hommage an Hunbabas Papa!
#. fr: Dédicace à Papa Humbaba<nbsp>!
msgctxt "NpcYell:11058:0:13"
msgid "An imitation of...Papa Humbaba!"
msgstr "Подражаю... Папе Хумбабе!"

#. ja: 出直してこい！
#. de: Komm schon!
#. fr: En garde, Bleuet masqué<nbsp>!
msgctxt "NpcYell:11059:0:13"
msgid "I will erase you from my stage!"
msgstr "Я сотру вас с моей сцены!"

#. ja: 風よ渦巻け！
#. de: Der Wind soll wirbeln!
#. fr: Le vent va tourbillonner<nbsp>!
msgctxt "NpcYell:11060:0:13"
msgid "This shall be a whirlwind tour!"
msgstr "Сейчас закружит вихрь!"

#. ja: 凍りつくがいい！
#. de: Jetzt wird's kalt!
#. fr: Coup de froid sur le Bleuet masqué<nbsp>!
msgctxt "NpcYell:11061:0:13"
msgid "A good performer never freezes!"
msgstr "Настоящий артист не теряет хладнокровия!"

#. ja: ここがマトーヤ様の<br>アトリエか…
#. de: Das ist es also<nbsp>... Matoyas berühmtes Atelier!
#. fr: C'est donc ça, l'atelier de maîtrrre Matoya...
msgctxt "NpcYell:11062:0:13"
msgid "So this is the workshop..."
msgstr "Так вот она какая, мастерская..."

#. ja: またこのアトリエを<br>訪れることになるなんてね
#. de: Ich hätte nicht gedacht, dass ich jemals wieder einen Fuß hier hereinsetzen würde.
#. fr: Je ne pensais pas devoir revenir ici un jour...
msgctxt "NpcYell:11063:0:13"
msgid "I never thought I would see this place again."
msgstr "Не думал, что снова сюда вернусь."

#. ja: さあ、とびきりかわいい<br>豚を作りましょう！
#. de: Erschaffen wir das großartigste Schwein, das die Welt je gesehen hat!
#. fr: Allez, on va créer la plus jolie des mamans porxies<nbsp>!
msgctxt "NpcYell:11064:0:13"
msgid "Right, let's create the mother of all porxies!"
msgstr "Ну что ж, создадим поркси всех поркси!"

#. ja: またこのアトリエを<br>訪れることになるなんてね
#. de: Ich hätte nicht gedacht, dass ich jemals wieder einen Fuß hier hereinsetzen würde.
#. fr: Je ne pensais pas devoir revenir ici un jour...
msgctxt "NpcYell:11065:0:13"
msgid "I never thought I would see this place again."
msgstr "Не думал, что снова сюда вернусь."

#. ja: 勝手知ったる者が<br>いるのは心強いな！
#. de: Es ist beruhigend, eine Fachfrau an meiner Seite zu wissen.
#. fr: Heurrreusement que tu es avec nous, c'est rassurant d'avoir quelqu'un qui connaît un peu les lieux.
msgctxt "NpcYell:11066:0:13"
msgid "We will be counting on your local knowledge."
msgstr "На твои знания местности мы и рассчитываем."

#. ja: 施設は劣化して<br>いないようだが…
#. de: Die Einrichtung selbst scheint ja noch gut in Schuss zu sein<nbsp>...
#. fr: L'intérieur n'a pas l'airrr aussi délabré que je ne l'imaginais...
msgctxt "NpcYell:11067:0:13"
msgid "The facility itself still seems to be in good shape. "
msgstr "Сама мастерская всё ещё в хорошем состоянии."

#. ja: 長年放置していたから<br>何が出るやら…
#. de: Was sich in den langen Jahren der Verwahrlosung hier wohl alles eingenistet hat<nbsp>...
#. fr: Personne n'est entré dans l'atelier depuis des lustres... Qui sait quelles créatures ont pu s'y installer...
msgctxt "NpcYell:11068:0:13"
msgid "What creatures have since taken up residence, I wonder..."
msgstr "Интересно, какие твари тут успели поселиться..."

#. ja: 邪魔な魔物を<br>蹴散らせばいいのね？
#. de: Es hat doch niemand was dagegen, wenn ich die ollen Biester aus dem Weg räume?
#. fr: Si jamais on tombe sur des indésirables, on peut leur mettre une bonne raclée, non<nbsp>?
msgctxt "NpcYell:11069:0:13"
msgid "So we clear out any pests we encounter, yes?"
msgstr "Значит, расправляемся со всеми вредителями, что попадутся?"

#. ja: 長年放置していたから<br>何が出るやら…
#. de: Was sich in den langen Jahren der Verwahrlosung hier wohl alles eingenistet hat<nbsp>...
#. fr: Personne n'est entré ici depuis des lustres... Qui sait quelles créatures ont pu s'y installer...
msgctxt "NpcYell:11070:0:13"
msgid "What creatures have since taken up residence, I wonder..."
msgstr "Интересно, какие твари тут успели поселиться..."

#. ja: 邪魔な魔物は<br>蹴散らしてやるわ！
#. de: Mit den ollen Biestern hier mach ich kurzen Prozess!
#. fr: Si jamais on tombe sur des indésirables, on peut leur mettre une bonne raclée, non<nbsp>?
msgctxt "NpcYell:11071:0:13"
msgid "Whatever they are, we'll make short work of them."
msgstr "Кто бы они ни были, мы быстро с ними разделаемся."

#. ja: どいてくれる気配は<br>なさそうだな…！
#. de: Freiwillig gibt der uns wohl keinen Lehm<nbsp>...
#. fr: Je n'ai pas l'impression qu'il nous laisserrra passer bien sagement...
msgctxt "NpcYell:11072:0:13"
msgid "Looks just about as friendly as the rest."
msgstr "Похоже, он не собирается уступать нам дорогу..."

#. ja: 邪魔者を<br>片付けましょう
#. de: Zeit zum Reinemachen, was?
#. fr: Bon, il est temps de faire le ménage ici, tu ne crois pas<nbsp>?
msgctxt "NpcYell:11073:0:13"
msgid "Time to finish tidying up the area."
msgstr "Пора навести тут порядок."

#. ja: 粘土を手に入れるには<br>アレを倒さないと…
#. de: Der gibt seinen Lehm ganz sicher nicht freiwillig her<nbsp>...
#. fr: Il faut se débarrasser de ce machin si on veut récupérer de l'argile...
msgctxt "NpcYell:11074:0:13"
msgid "So that's the keeper of the clay."
msgstr "Значит, вот кто сторожит глину."

#. ja: あれはゴーレムの<br>成れの果てか…？
#. de: Das scheint mir ein äußerst verwahrloster Golem zu sein<nbsp>...
#. fr: Tu crrrois que c'est une espèce de golem<nbsp>?
msgctxt "NpcYell:11075:0:13"
msgid "Is that supposed to be a golem?"
msgstr "Это что, голем такой?"

#. ja: そのようね…<br>片付けておかないから…
#. de: In der Tat. Der Dreck der letzten Jahre hat sich wohl an ihm gesammelt.
#. fr: Ça m'en a tout l'air... Voilà ce qui arrive quand on laisse un bâtiment à l'abandon...
msgctxt "NpcYell:11076:0:13"
msgid "Aye. This is what happens when you neglect to tidy up."
msgstr "Да. Вот что бывает, если не следить за порядком."

#. ja: よし！<br>やったな、みんな！
#. de: Gute Arbeit! Und sehr schönes Zusammenspiel!
#. fr: Superrr<nbsp>! Bien joué, tout le monde<nbsp>!
msgctxt "NpcYell:11077:0:13"
msgid "Yes! Excellent work, everyone!"
msgstr "Отлично! Молодцы, все!"

#. ja: これでひとつ目の<br>材料は確保完了ね…
#. de: Damit hätten wir also die erste Zutat.
#. fr: Et voilà le premier ingrédient de notre liste...
msgctxt "NpcYell:11078:0:13"
msgid "One ingredient struck off the list."
msgstr "С первым ингредиентом разобрались."

#. ja: 良質の粘土が<br>手に入ったわね！
#. de: Das ist aber wirklich guter Lehm. Fühlt sich ganz samtig an!
#. fr: Avec cette argile, on va pouvoir fabriquer un beau porxie<nbsp>!
msgctxt "NpcYell:11079:0:13"
msgid "This is fine clay, perfect for our porxie!"
msgstr "Хорошая глина, как раз для нашего поркси!"

#. ja: よし！<br>やったな、みんな！
#. de: Gute Arbeit! Und sehr schönes Zusammenspiel!
#. fr: Superrr<nbsp>! Bien joué, tout le monde<nbsp>!
msgctxt "NpcYell:11080:0:13"
msgid "Yes! Excellent work, everyone!"
msgstr "Отлично! Молодцы, все!"

#. ja: あらあら、随分と<br>楽しそうね？
#. de: Da hatte aber jemand Spaß beim Aufräumen<nbsp>...
#. fr: Ah ha<nbsp>! On s'amuse bien à ce que je vois<nbsp>!
msgctxt "NpcYell:11081:0:13"
msgid "If I didn't know better, I would say you were having fun."
msgstr "Надо же, похоже, тебе даже понравилось."

#. ja: なるほど…<br>ここに戻る仕掛けか…
#. de: Klingt so, als würde ein weiterer Teil des Ateliers auf uns warten.
#. fr: Et nous voilà de rrretour ici... Je comprends mieux.
msgctxt "NpcYell:11082:0:13"
msgid "So back here again and on to the next task."
msgstr "Вот мы и вернулись. Значит, пора за следующим делом."

#. ja: 次の材料は<br>清水だったかしら？
#. de: Was brauchen wir als nächstes? Wasser?
#. fr: Et maintenant qu'est-ce qu'il nous faut<nbsp>? De l'eau, non<nbsp>?
msgctxt "NpcYell:11083:0:13"
msgid "So, what's next? Water?"
msgstr "Что там дальше? Вода?"

#. ja: 工房の各所に<br>転送紋が配されているのか…
#. de: Diese Teleportationszirkel verbinden wohl das gesamte Atelier miteinander.
#. fr: Vu la taille gargantuesque de cet atelier, je suis content qu'il y ait des portails à notre disposition.
msgctxt "NpcYell:11084:0:13"
msgid "A workshop this vast, it certainly makes sense to have portals."
msgstr "Мастерская такая огромная, без порталов тут не обойтись."

#. ja: 次の材料は<br>清水だったかしら？
#. de: Was brauchen wir als nächstes? Wasser?
#. fr: Et maintenant qu'est-ce qu'il nous faut<nbsp>? De l'eau, non<nbsp>?
msgctxt "NpcYell:11085:0:13"
msgid "So, what's next? Water?"
msgstr "Что там дальше? Вода?"

#. ja: そうよ<br>粘土をこねるのに必要なの
#. de: Genau. Um den Lehm ordentlich kneten und formen zu können!
#. fr: Tout à fait<nbsp>! De l'eau pour pouvoir façonner l'argile<nbsp>!
msgctxt "NpcYell:11086:0:13"
msgid "That's right─water to work the clay."
msgstr "Верно. Вода нужна, чтобы размять глину."

#. ja: 整備された空間だ…<br>これも使い魔が？
#. de: Erstaunlich aufgeräumt hier. Das haben wir sicherlich ebenfalls einem Familiar zu verdanken.
#. fr: Je me demande si ce sont ses familiers qui font le ménage ici...
msgctxt "NpcYell:11087:0:13"
msgid "A well-kept area. No doubt thanks to the familiars."
msgstr "Здесь такой порядок... Наверняка постарались фамильяры."

#. ja: 水くみをさせられた日々を<br>思い出すわね
#. de: Matoya hat mich oft Wasserholen geschickt. Und jedes Mal habe ich darüber geflucht.
#. fr: Ah<nbsp>! Je me souviens qu'à l'époque, j'étais venue puiser de l'eau plus d'une fois<nbsp>!
msgctxt "NpcYell:11088:0:13"
msgid "How often did I come here to fetch water for Master Matoya's tea..."
msgstr "Сколько же раз я ходила сюда за водой для чая госпожи Матои..."

#. ja: 水の流れる音…<br>地下水脈か！
#. de: Hört ihr das Rauschen? Das müssen zahlreiche Grundwasseradern sein!
#. fr: J'entends comme un ruissellement... Il doit y avoir une source près d'ici<nbsp>!
msgctxt "NpcYell:11089:0:13"
msgid "That gushing sound... There must be a water vein."
msgstr "Этот шум воды... Тут, должно быть, подземный источник."

#. ja: 水の流れる音…<br>地下水脈か！
#. de: Hört ihr das Rauschen? Das müssen zahlreiche Grundwasseradern sein!
#. fr: J'entends comme un ruissellement... Il doit y avoir une source près d'ici<nbsp>!
msgctxt "NpcYell:11090:0:13"
msgid "That gushing sound... There must be a water vein."
msgstr "Этот шум воды... Тут, должно быть, подземный источник."

#. ja: ご明察…<br>落ちると冷たいわよ？
#. de: Fall nur nicht rein<nbsp>...
#. fr: C'est exact<nbsp>! Fais attention à ne pas tomber, tu n'auras pas pied<nbsp>!
msgctxt "NpcYell:11091:0:13"
msgid "Correct, and believe me when I say it's icy cold. Watch your step."
msgstr "Верно. Только смотри не упади — вода ледяная. Осторожнее."

#. ja: なんだか妙なのが<br>出てきたな…！
#. de: Da! Irgendwas ist im Wasser!
#. fr: Quelle est cette étrrrange créature<nbsp>?
msgctxt "NpcYell:11092:0:13"
msgid "What in the world is that thing?"
msgstr "Да что это такое?"

#. ja: 驚いた…<br>あの子たち、まだいたのね…
#. de: Kaum zu glauben, dass die Kleinen nach all den Jahren noch hier sind<nbsp>...
#. fr: Ah<nbsp>! Je ne croyais pas qu'elle serait encore là<nbsp>!
msgctxt "NpcYell:11093:0:13"
msgid "Oh gods, it's still here..."
msgstr "О боги, оно всё ещё здесь..."

#. ja: スプライトの一種か？<br>いや、違うな…
#. de: Ist das eine Art Exergon? Nein, das kann eigentlich nicht sein<nbsp>...
#. fr: C'est une sorte d'élémentaire<nbsp>? Hmm... On ne dirait pas...
msgctxt "NpcYell:11094:0:13"
msgid "Some manner of sprite? Or another familiar?"
msgstr "Какой-то элементаль? Или другой фамильяр?"

#. ja: 雨水から作った使い魔よ<br>きかん坊だから注意して！
#. de: Ein aus Regenwasser geschaffenes Familiar. Und nichts als Flausen im Kopf.
#. fr: C'est un familier créé avec l'eau de pluie... Attention, elle aime bien jouer et ne retient pas ses coups...
msgctxt "NpcYell:11095:0:13"
msgid "That familiar was made with stormwater─and it plays rough. Have care."
msgstr "Этот фамильяр создан из дождевой воды — и дерётся он не по-детски. Будьте осторожны."

#. ja: ヤ・シュトラがそこまで<br>警戒するなんて…
#. de: Deine Einsichten sind wirklich Gold wert, Y'shtola. Und spannend noch dazu!
#. fr: Si Y'shtola est aussi méfiante, il vaut mieux redoubler de prudence...
msgctxt "NpcYell:11096:0:13"
msgid "When even Y'shtola advises caution..."
msgstr "Когда даже Я'штола советует быть осторожнее..."

#. ja: 姿とは裏腹に<br>あなどれないヤツだったな
#. de: So drollig es aussah, so garstig waren seine Manieren.
#. fr: Comme toujourrrs en combat, l'habit ne fait pas le moine. Restons vigilants.
msgctxt "NpcYell:11097:0:13"
msgid "As with all things, one cannot judge a familiar by its appearance."
msgstr "Как и всегда, не суди фамильяра по внешности."

#. ja: 未熟者が作った使い魔ほど<br>厄介なものはないわね
#. de: Es gibt kaum etwas Garstigeres als ein von unerfahrener Hand geschaffenes Familiar<nbsp>...
#. fr: Il n'y a rien de pire qu'un familier créé par erreur par une débutante...
msgctxt "NpcYell:11098:0:13"
msgid "Nothing is so bothersome as a familiar made by an untrained hand."
msgstr "Нет ничего хлопотнее фамильяра, созданного неопытной рукой."

#. ja: 泥まみれの次は<br>ずぶ濡れとはね…
#. de: Erst Schlamm, jetzt auch noch eiskaltes Wasser<nbsp>... Ich will ein heißes Bad.
#. fr: Après avoir été couverts de boue, nous voilà trempés jusqu'aux os...
msgctxt "NpcYell:11099:0:13"
msgid "The water was freezing, but at least it washed the mud away."
msgstr "Вода была ледяная, зато хоть смыла грязь."

#. ja: 過去の清算ができて<br>清々したわ
#. de: Ich für meinen Teil fühle mich richtiggehend <i>reingewaschen</i>.
#. fr: Voilà une bonne chose de réglée<nbsp>!
msgctxt "NpcYell:11100:0:13"
msgid "Ahhh, to have closure after all these years..."
msgstr "Ах, наконец-то я покончила с прошлым..."

#. ja: まさか、あの使い魔を<br>作ったのは…
#. de: Warte<nbsp>... War das etwa <i>dein</i> Familiar?!
#. fr: Attends une minute... C'est toi qui as créé ce familier<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11101:0:13"
msgid "Wait... Was it <i>you</i> who created that familiar!?"
msgstr "Постой... Это <i>ты</i> создал того фамильяра?!"

#. ja: 今のところ<br>材料集めは順調だな！
#. de: Unsere Zutatenjagd ist bislang ja ein voller Erfolg!
#. fr: Parrrfait<nbsp>! Passons à la prochaine étape<nbsp>!
msgctxt "NpcYell:11102:0:13"
msgid "All proceeding apace thus far!"
msgstr "Пока всё идёт как по маслу!"

#. ja: マトーヤ、待ちくたびれて<br>居眠りしていないかしら
#. de: Matoya wird sicherlich schon ungeduldig. Wir sollten uns sputen.
#. fr: Matoya doit être en train de s'impatienter... ou alors de piquer un petit somme<nbsp>!
msgctxt "NpcYell:11103:0:13"
msgid "Master Matoya will be getting impatient─assuming she hasn't fallen asleep."
msgstr "Матоя уже, должно быть, теряет терпение... если только не задремала."

#. ja: 服が濡れたから<br>肌寒いわ…
#. de: Bah, ich bin nass bis auf die Knochen! Bestimmt hab ich auch schon blaue Lippen!
#. fr: On se les gèle avec nos vêtements tout mouillés...
msgctxt "NpcYell:11104:0:13"
msgid "Ugh, I'm freezing in my sodden clothes..."
msgstr "Уф, в этой промокшей одежде так холодно..."

#. ja: 服が濡れたから<br>肌寒いわ…
#. de: Bah, ich bin nass bis auf die Knochen! Bestimmt hab ich auch schon blaue Lippen!
#. fr: On se les gèle avec nos vêtements tout mouillés...
msgctxt "NpcYell:11105:0:13"
msgid "Ugh, I'm freezing in my sodden clothes..."
msgstr "Уф, в этой промокшей одежде так холодно..."

#. ja: どうせ次の場所で<br>すぐ乾くから安心なさい
#. de: Keine Bange, uns wird gleich warm. Sehr warm, tatsächlich.
#. fr: Ne t'en fais pas pour ça, ils devraient sécher très vite...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11106:0:13"
msgid "Worry not, you will be warm again soon. <i>Very</i> warm."
msgstr "Не волнуйся, скоро снова согреешься. <i>Очень</i> согреешься."

#. ja: 溶岩が七色に？<br>すごい光景だな！
#. de: Regenbogenlava<nbsp>...? Was für ein atemberaubender Anblick!
#. fr: C'est moi ou ce magma est... couleur arrrc-en-ciel<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11107:0:13"
msgid "Good heavens, is the magma <i>rainbow-colored</i>? Spectacular!"
msgstr "Вот это да, магма и правда <i>всех цветов радуги</i>? Потрясающе!"

#. ja: 今の目には、この属性の力…<br>鮮やか過ぎるわ…
#. de: Gah! Der Äther strahlt so stark, ich kann kaum etwas sehen<nbsp>...
#. fr: L'éther est si brillant ici, j'arrive à peine à y voir clair...
msgctxt "NpcYell:11108:0:13"
msgid "Ungh, the aether here is so vivid, I can scarcely see..."
msgstr "Ух... эфир здесь такой яркий, что почти ничего не видно..."

#. ja: 六属性が入り乱れた<br>溶岩ってこと？
#. de: Fließen in dieser Lava ganze <i>sechs</i> Ätherattribute?
#. fr: Ces couleurs... Cela signifie que les six éléments sont mélangés ensemble<nbsp>?
msgctxt "NpcYell:11109:0:13"
msgid "These colors... I take it the magma is infused with the elements."
msgstr "Судя по цветам, магма пропитана разными стихиями."

#. ja: 溶岩が七色に？<br>すごい光景だな！
#. de: Regenbogenlava<nbsp>...? Was für ein atemberaubender Anblick!
#. fr: C'est moi ou ce magma est... couleur arrrc-en-ciel<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11110:0:13"
msgid "Good heavens, is the magma <i>rainbow-colored</i>? Spectacular!"
msgstr "Вот это да, магма и правда <i>всех цветов радуги</i>? Потрясающе!"

#. ja: クリスタル鉱脈の成分が<br>溶け出ているのよ
#. de: Die Farbe erhalten sie von dem reichhaltigen Äther der darin aufgelösten Kristalle.
#. fr: C'est le produit des cristaux de la montagne qui sont entrés en fusion.
msgctxt "NpcYell:11111:0:13"
msgid "The product of dissolved crystals, lest you wonder."
msgstr "Это всё растворившиеся кристаллы, если вам интересно."

#. ja: これで魔力含みの火が<br>炉に灯ったはずだな！
#. de: Das sollte für den Ofen doch mehr als genügen!
#. fr: Maintenant que le brasier a été rrravivé, retournons au grand four<nbsp>!
msgctxt "NpcYell:11112:0:13"
msgid "And now the kiln should be lit!"
msgstr "Теперь печь должна загореться!"

#. ja: いつ来ても<br>やっぱりここは暑すぎるわ
#. de: Gehen wir. Mir ist es hier viel zu heiß.
#. fr: Quelle fournaise... Voilà une chose qui ne m'avait pas manqué...
msgctxt "NpcYell:11113:0:13"
msgid "Whew, I shall be glad to leave this stifling place behind."
msgstr "Фух, как же я рада, что мы наконец выбрались из этой духоты."

#. ja: こんなに強い魔力を帯びた<br>熱源があれば、ばっちりね！
#. de: Was für eine Unmenge an magischer Hitze! Ich bin schon ganz aufgeregt!
#. fr: L'éther du magma est si riche... C'est parfait pour notre future mère porxie<nbsp>!
msgctxt "NpcYell:11114:0:13"
msgid "Such an aether-rich heat source will be perfect for porxie-making."
msgstr "Для создания поркси не найти источника тепла богаче эфиром!"

#. ja: これで魔力含みの火が<br>炉に灯ったはずだな！
#. de: Das sollte für den Ofen doch mehr als genügen!
#. fr: Maintenant que le brasier a été rrravivé, retournons au grand four<nbsp>!
msgctxt "NpcYell:11115:0:13"
msgid "And now the kiln should be lit!"
msgstr "Теперь печь должна загореться!"

#. ja: マトーヤのところに<br>戻りましょう…
#. de: Kehren wir zu Matoya zurück.
#. fr: Retournons voir Matoya.
msgctxt "NpcYell:11116:0:13"
msgid "Aye, let us return to Master Matoya."
msgstr "Вернёмся к Матое."

#. ja: 最後の仕上げまで<br>力づくか、面白い！
#. de: Ich kann es kaum erwarten, das fertige Familiar zu sehen.
#. fr: Et donc pourrr fignoler ce familier, il faut le mater<nbsp>? C'est assez inattendu...
msgctxt "NpcYell:11117:0:13"
msgid "So for the finishing touches, we employ...brute force?"
msgstr "Значит, последние штрихи — силой? Забавно!"

#. ja: 作り手に似て<br>荒々しい使い魔のようね…
#. de: Ein störrisches Exemplar. Ganz wie seine Herrin<nbsp>...
#. fr: On dirait que cette cochonne a un sale caractère... un peu comme celle qui l'a créée.
msgctxt "NpcYell:11118:0:13"
msgid "A pugnacious specimen...just like its creator."
msgstr "Задиристый экземпляр... прямо как его создательница."

#. ja: あの豚、服まで<br>着せる必要あった…？
#. de: Warum<nbsp>... Wozu denn die Klamotten<nbsp>...?
#. fr: Avait-on vraiment besoin de lui donner un accoutrement pareil<nbsp>?
msgctxt "NpcYell:11119:0:13"
msgid "Regal raiment? Really?"
msgstr "А наряжать эту свинью было обязательно?"

#. ja: あの豚、服まで<br>着せる必要あった…？
#. de: Warum<nbsp>... Wozu denn die Klamotten<nbsp>...?
#. fr: Avait-on vraiment besoin de lui donner un accoutrement pareil<nbsp>?
msgctxt "NpcYell:11120:0:13"
msgid "Regal raiment? Really?"
msgstr "А наряжать эту свинью было обязательно?"

#. ja: おしとやかとは<br>いきそうにもないわね
#. de: Eine Krone macht noch längst keine Königin<nbsp>...
#. fr: Ça lui donne un air de bonne famille... Maintenant, aidons-la à soigner ses manières.
msgctxt "NpcYell:11121:0:13"
msgid "Garb aside, I suspect the creature will be anything but regal."
msgstr "Хоть и наряжена по-королевски, вряд ли она будет вести себя подобающе."

#. ja: アリゼー、大丈夫か！？
#. de: Alisaie, geht es dir gut?!
#. fr: Alisaie, tout va bien<nbsp>?
msgctxt "NpcYell:11122:0:13"
msgid "Alisaie, are you all right!?"
msgstr "Ализе, ты в порядке?!"

#. ja: 警戒を怠るな…
#. de: Bleibt wachsam<nbsp>...
#. fr: Restez sur vos gardes<nbsp>!
msgctxt "NpcYell:11123:0:13"
msgid "Keep your guard up."
msgstr "Не теряйте бдительности..."

#. ja: まだまだ油断はできん
#. de: Das kann noch nicht alles gewesen sein.
#. fr: Il est encore trop tôt pour crier victoire...
msgctxt "NpcYell:11124:0:13"
msgid "This is only the beginning."
msgstr "Это ещё не конец."

#. ja: 我らは警戒に当たるぞ
#. de: Haltet ein Auge auf die Umgebung.
#. fr: Il faut rester prudents...
msgctxt "NpcYell:11125:0:13"
msgid "They can come from anywhere. Stay alert."
msgstr "Они могут напасть откуда угодно. Будьте начеку."

#. ja: 奴らに妨害させるものか
#. de: Verstanden, Admiral.
#. fr: Ne les laissez pas interrompre le sort<nbsp>!
msgctxt "NpcYell:11126:0:13"
msgid "Aye, Admiral."
msgstr "Так точно, адмирал."

#. ja: ぐっ…ぬかった
#. de: Verflucht<nbsp>...
#. fr: Argh... Enfer<nbsp>!
msgctxt "NpcYell:11127:0:13"
msgid "Damn it..."
msgstr "Чёрт..."

#. ja: ぐはッ…！
#. de: Hng!
#. fr: Argh<nbsp>!
msgctxt "NpcYell:11128:0:13"
msgid "Argh..."
msgstr "А-а..."

#. ja: くっ…
#. de: Gah!
#. fr: Urgh...
msgctxt "NpcYell:11129:0:13"
msgid "Ungh..."
msgstr "Ух..."

#. ja: メルウィブ提督ッ…！
#. de: Admiral Merlwyb!
#. fr: Amirale<nbsp>!
msgctxt "NpcYell:11130:0:13"
msgid "Admiral!"
msgstr "Адмирал!"

#. ja: ぐわぁぁぁ…<br>あたまがわれそーだ！
#. de: Aaaaah! Dieser Schmeeerz!
#. fr: Rhaaaaaa<nbsp>! Ma tête va exploser, oui<nbsp>!
msgctxt "NpcYell:11131:0:13"
msgid "Ahhh! My head! The pain, the pain!"
msgstr "А-а-а! Голова! Как же больно!"

#. ja: 助かりました…<br>賢人殿…！
#. de: Das war die Rettung, Mikoto.
#. fr: Vous nous avez sauvé la vie, Dame Mikoto<nbsp>!
msgctxt "NpcYell:11132:0:13"
msgid "You have our thanks, Mikoto."
msgstr "Спасибо вам, Микото."

#. ja: 魔法障壁がなければ<br>どうなっていたことか…
#. de: Ohne die Barriere wären wir verloren gewesen.
#. fr: Sans cette barrière magique, c'en était fini de nous...
msgctxt "NpcYell:11133:0:13"
msgid "Indeed. Without your magicks, we would be done for."
msgstr "И правда. Без вашей магии нам бы не поздоровилось."

#. ja: アリゼーの護りは<br>オレに任せてくれ！
#. de: Wer zu Alisaie will, muss zuerst an mir vorbei!
#. fr: Je m'occupe de prrrotéger Alisaie<nbsp>!
msgctxt "NpcYell:11134:0:13"
msgid "Everyone back! I will shield Alisaie!"
msgstr "Все назад! Я прикрою Ализе!"

#. ja: ９Ｓ、お願い
#. de: 9S?
#. fr: 9S, à toi de jouer.
msgctxt "NpcYell:11135:0:13"
msgid "Go ahead, 9S."
msgstr "Давай, 9S."

#. ja: ポッドを使って<br>先に進んで
#. de: Der Pod bringt uns auf die andere Seite.
#. fr: Traversons à l'aide de ces pods.
msgctxt "NpcYell:11136:0:13"
msgid "Use the pods."
msgstr "Воспользуйтесь подами."

#. ja: 敵を確認！<br>迎え討つぞ！
#. de: Feind registriert! Macht euch bereit.
#. fr: Ennemi en vue<nbsp>! À l'attaque<nbsp>!
msgctxt "NpcYell:11137:0:13"
msgid "Enemy sighted!"
msgstr "Враг замечен!"

#. ja: 注意して進もう
#. de: Bleibt konzentriert.
#. fr: On continue, reste <if $gn4>concentrée<else>concentré</if>.
msgctxt "NpcYell:11138:0:13"
msgid "Stay focused."
msgstr "Будьте начеку."

#. ja: こいつが足止めの元凶…！
#. de: Sie ist der Grund für die Blockade.
#. fr: C'est elle qu'il faut éliminer pour ouvrir la porte<nbsp>!
msgctxt "NpcYell:11139:0:13"
msgid "There's the leader."
msgstr "Вот главарь."

#. ja: 出口が開いた<br>９Ｓの所に戻ろう
#. de: Ein Ausgang. Kehren wir zu 9S zurück.
#. fr: Voilà la sortie. Retournons auprès de 9S.
msgctxt "NpcYell:11140:0:13"
msgid "Let's get back to 9S."
msgstr "Вернёмся к 9S."

#. ja: 逃がさないっ！
#. de: Hinterher, schnell!
#. fr: Ce n'est pas terminé<nbsp>!
msgctxt "NpcYell:11141:0:13"
msgid "Oh no you don't!"
msgstr "А ну стой!"

#. ja: 惑わされないで<br>今は先に進むことだけを考えて
#. de: Fallt nicht auf ihre Tricks herein!
#. fr: Ne vous laissez pas déstabiliser. Continuez d'avancer, un point c'est tout.
msgctxt "NpcYell:11142:0:13"
msgid "Don't get distracted. Focus on the mission."
msgstr "Не отвлекайтесь. Сосредоточьтесь на задании."

#. ja: 強力なエネルギー反応…！<br>気を付けて！
#. de: Eine massive Energiesignatur! Seid vorsichtig!
#. fr: Attention, je détecte une importante signature d'énergie<nbsp>!
msgctxt "NpcYell:11143:0:13"
msgid "Stay alert. These readings are..."
msgstr "Осторожно! Показания такие..."

#. ja: ここから離脱する
#. de: Weiter.
#. fr: Sortons d'ici.
msgctxt "NpcYell:11144:0:13"
msgid "Time to move."
msgstr "Уходим отсюда."

#. ja: わかってる…
#. de: Ich weiß ...
#. fr: Je sais.
msgctxt "NpcYell:11145:0:13"
msgid "I'm aware."
msgstr "Я знаю..."

#. ja: これは…昇降機…？
#. de: Ein Aufzug ...?
#. fr: On est sur... une sorte de monte-charge<nbsp>?
msgctxt "NpcYell:11146:0:13"
msgid "An elevator?"
msgstr "Лифт?"

#. ja: 敵機確認…<br>９Ｓ、アノッグを頼む！
#. de: Eine Maschine ... 9S, schaff Anogg weg!
#. fr: Ennemi repéré<nbsp>! 9S, veille sur Anogg pendant que je m'en occupe<nbsp>!
msgctxt "NpcYell:11147:0:13"
msgid "Enemy units! 9S, cover Anogg."
msgstr "Вражеские машины! 9S, прикрой Анногг."

#. ja: …終わったか
#. de: Ist es vorbei?
#. fr: Ils ont eu leur compte.
msgctxt "NpcYell:11148:0:13"
msgid "Is that it?"
msgstr "Это всё?"

#. ja: ゲート…<br>いったい何のことでしょう
#. de: ... Wovon erzählen sie da?
#. fr: Même pour nous, ces portes sont un mystère...
msgctxt "NpcYell:11149:0:13"
msgid "Did that say “gates”?"
msgstr "Они сказали «врата»?"

#. ja: このパネルで<br>動かせそうです
#. de: Das dürfte die Steuerung sein.
#. fr: On devrait pouvoir l'activer grâce à cet écran.
msgctxt "NpcYell:11150:0:13"
msgid "We should be able to move it using this panel."
msgstr "Кажется, его можно запустить с этой панели."

#. ja: みなさん、気を付けて！
#. de: Passt auf euch auf!
#. fr: Soyez <if $gn4>prudentes<else>prudents</if><nbsp>!
msgctxt "NpcYell:11151:0:13"
msgid "Be careful!"
msgstr "Осторожнее!"

#. ja: 敵性反応、消失しました
#. de: Ich registriere keine weiteren Maschinen.
#. fr: Je ne détecte plus aucune signature ennemie.
msgctxt "NpcYell:11152:0:13"
msgid "I'm not picking up any more hostiles."
msgstr "Вражеских сигналов больше нет."

#. ja: なっ…<br>何かが喋りかけてきた！？
#. de: Uaaah! Was soll denn diese Gruselstimme?
#. fr: Q-qui nous parle<nbsp>!?
msgctxt "NpcYell:11153:0:13"
msgid "Waugh! What's that!?"
msgstr "А-а! Что это такое?!"

#. ja: ここは…いったい！？
#. de: Was zum großen Eisenbart ...
#. fr: O-on est où, là<nbsp>!?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11154:0:13"
msgid "Wait, the network is a <i>place</i>?"
msgstr "Постойте, сеть — это <i>место</i>?"

#. ja: おまえたち、任せたぞ！
#. de: Das überlasse ich euch!
#. fr: J-je vais rester ici et vous encourager<nbsp>!
msgctxt "NpcYell:11155:0:13"
msgid "You first."
msgstr "Теперь вы!"

#. ja: さっきからこの声…<br>気味が悪いな…
#. de: Dieselbe Stimme von vorhin ... Mir läuft's eiskalt den Bart runter.
#. fr: Cette voix me donne vraiment la chair de poule...
msgctxt "NpcYell:11156:0:13"
msgid "Still not enjoying the creepy voice, thanks!"
msgstr "Эта жуткая голосина уже достала..."

#. ja: 気を付けて！
#. de: Ihr schafft das schon!
#. fr: Bon courage<nbsp>!
msgctxt "NpcYell:11157:0:13"
msgid "Good luck! Don't die!"
msgstr "Удачи! И не погибните!"

#. ja: なんとか無事に<br>戻ってくることができたな
#. de: Na, das ging ja gerade nochmal gut ...
#. fr: J'ai bien cru qu'on allait rester <if $gn4>coincées<else>coincés</if> là-bas<nbsp>!
msgctxt "NpcYell:11158:0:13"
msgid "Well done!"
msgstr "Молодцы!"

#. ja: あいつらは…！？
#. de: Sie schon wieder!
#. fr: C-c'est 2P<nbsp>! Fois trois<nbsp>!
msgctxt "NpcYell:11159:0:13"
msgid "What the─!?"
msgstr "Да что за...?!"

#. ja: あいつらにも<br>感情があるのか…？
#. de: H-Haben sie Gefühle? Wie wir?
#. fr: Ces filles... Je me demande si elles ont des sentiments, elles aussi...
msgctxt "NpcYell:11160:0:13"
msgid "Do they...have feelings too?"
msgstr "У них... тоже есть чувства?"

#. ja: …頼むぞ！
#. de: N-Na gut. Viel Erfolg, ihr!
#. fr: À vous de jouer<nbsp>!
msgctxt "NpcYell:11161:0:13"
msgid "Well, you know what to do!"
msgstr "Ну, вы знаете, что делать!"

#. ja: …<br>やるだけだ…
#. de: ... Jetzt nur nicht zaudern.
#. fr: ... Il faut le faire dans tous les cas.
msgctxt "NpcYell:11162:0:13"
msgid "There's no choice. We do it."
msgstr "Другого выхода нет. Надо действовать."

#. ja: くっ…<br>また敵が…！
#. de: Gah! Noch mehr?!
#. fr: Oh non, encore des ennuis<nbsp>!
msgctxt "NpcYell:11163:0:13"
msgid "More!?"
msgstr "Опять?!"

#. ja: ぶ、無事か…？
#. de: A-Alles in Ordnung?
#. fr: T-tout le monde va bien<nbsp>?
msgctxt "NpcYell:11164:0:13"
msgid "Everyone all right?"
msgstr "Все целы?"

#. ja: 卵の回収をお願いします！
#. de: Sammele so viele Eier, wie nur möglich!
#. fr: Essayez de ramasser le plus d'œufs possible<nbsp>!
msgctxt "NpcYell:11165:0:13"
msgid "Gather as many eggs as you can!"
msgstr "Соберите как можно больше яиц!"

#. ja: 蛮族が…
#. de: Primae<nbsp>...
#. fr: Les hommes-bêtes...
msgctxt "NpcYell:11166:0:13"
msgid "Wretched curs..."
msgstr "Проклятые твари..."

#. ja: 進め…進め…
#. de: Vorwärts<nbsp>... Vooorwääärts<nbsp>...
#. fr: En avant... En avant...
msgctxt "NpcYell:11167:0:13"
msgid "Forward..."
msgstr "Вперёд..."

#. ja: 栄光あれ…<br>栄光あれ…
#. de: Ruhm<nbsp>... und Ehre<nbsp>...
#. fr: Gloire... Gloire...
msgctxt "NpcYell:11168:0:13"
msgid "Glory be... Glory be..."
msgstr "Слава... Слава..."

#. ja: せいっ！
#. de: Nieder mit den Telophoroi!
#. fr: Shaaah<nbsp>!
msgctxt "NpcYell:11169:0:13"
msgid "Take this!"
msgstr "Получи!"

#. ja: はっ！
#. de: Ha!
#. fr: Yah<nbsp>!
msgctxt "NpcYell:11170:0:13"
msgid "Hah!"
msgstr "Ха!"

#. ja: ここは退けぬ！
#. de: Es gibt kein Zurück<nbsp>...
#. fr: Je dois tenir bon<nbsp>!
msgctxt "NpcYell:11171:0:13"
msgid "Give no quarter!"
msgstr "Не отступать!"

#. ja: オラァッァ！
#. de: Khaaa!
#. fr: CRRROAC<nbsp>!!
msgctxt "NpcYell:11172:0:13"
msgid "Charge!"
msgstr "В атаку!"

#. ja: ざけんなよッォ！
#. de: Spür meine Klinge, khahaaa!
#. fr: Dans les dents de celui-là<nbsp>!
msgctxt "NpcYell:11173:0:13"
msgid "Fools you were to come here!"
msgstr "Дураки, что сунулись сюда!"

#. ja: ゆくぞ、ゆくぞ！<br>荒ぶる雲海の風のように！
#. de: Voran! Voran! Stürmt wie Winde von Wolkenmeer!
#. fr: Que les vents de L'Écume des cieux vous balayent<nbsp>!
msgctxt "NpcYell:11174:0:13"
msgid "Now you face the raging storm, netherlings!"
msgstr "Ну что, твари из Нижнего мира, попробуйте выдержать ярость бури!"

#. ja: 守れ、守れ！<br>硬き大岩のように！
#. de: Hart wie Stein! Unverrückbar wie Berge!
#. fr: Que mon corps devienne aussi solide qu'un roc<nbsp>!
msgctxt "NpcYell:11175:0:13"
msgid "Stand firm, unyielding as stone!"
msgstr "Стоять насмерть, крепко, как камень!"

#. ja: シシシシシ…！<br>喰らえ！
#. de: \<klick> \<klick>Nimm daaas!
#. fr: Ksss<nbsp>!! Prends ça<nbsp>!
msgctxt "NpcYell:11176:0:13"
msgid "Die, wicked fleshling!"
msgstr "С-с-с... Умри, жалкий человечишка!"

#. ja: シシシシシ…<br>負けるものか！
#. de: \<klick> \<klack> Wir geben nicht auf!
#. fr: Ksss<nbsp>!! Nous vaincrons<nbsp>!
msgctxt "NpcYell:11177:0:13"
msgid "You cannot hope to defeat us!"
msgstr "С-с-с... Вам нас не одолеть!"

#. ja: 本気出すでふっち！
#. de: Die Unsrige wird's den Eurigen schon zeigen! Ha!
#. fr: Je ne faiblirai pas<nbsp>!
msgctxt "NpcYell:11178:0:13"
msgid "These ones will never surrender!"
msgstr "Эти не сдадутся!"

#. ja: 懲らしめてやるでふっち！
#. de: Das Rauschen des Windes kündet das Ende der Deinigen!
#. fr: Vous allez l'avoir dans le baba<nbsp>!
msgctxt "NpcYell:11179:0:13"
msgid "Hold still! These ones will heal friendly fighting ones!"
msgstr "Стоять! Эти вылечат своих!"

#. ja: 猛れ、呪剣ティソーナ！
#. de: Fluchschwert, entfessle deinen Zorn!
#. fr: Embrase-toi, Tizona<nbsp>!
msgctxt "NpcYell:11180:0:13"
msgid "Now roar, Tizona!"
msgstr "Реви, Тизона!"

#. ja: 好きにはさせん！
#. de: Meine Welt zerstört ihr nicht!
#. fr: Votre défaite est assurée<nbsp>!
msgctxt "NpcYell:11181:0:13"
msgid "This is as far as you go!"
msgstr "Дальше вам не пройти!"

#. ja: アタシの拳で！
#. de: Schon mal einen Fausttanz gesehen?
#. fr: Par le poing d'Ala Mhigo<nbsp>!
msgctxt "NpcYell:11182:0:13"
msgid "Punch first, ask questions later!"
msgstr "Получите от моего кулака!"

#. ja: やっちゃるよ！
#. de: Nieren-Quetscher, Kinn-Brecher, Augenring! Ha!
#. fr: Venez prendre votre raclée<nbsp>!
msgctxt "NpcYell:11183:0:13"
msgid "You'll have to do better than that!"
msgstr "Ну-ка, получите!"

#. ja: いざ、参る…！
#. de: Na komm schon<nbsp>...
#. fr: J'arrive<nbsp>!
msgctxt "NpcYell:11184:0:13"
msgid "Prepare yourself!"
msgstr "Приготовься...!"

#. ja: 御免っ！
#. de: Oh, hat das weh getan?
#. fr: Adieu<nbsp>!
msgctxt "NpcYell:11185:0:13"
msgid "A poor display."
msgstr "Слабовато."

#. ja: はぁッ…！
#. de: Hahaaa!
#. fr: Hyaah<nbsp>!!
msgctxt "NpcYell:11186:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: 正気に戻れ…！
#. de: Komm wieder zu dir!
#. fr: Reprenez vos esprits, bon sang<nbsp>!
msgctxt "NpcYell:11187:0:13"
msgid "Pray return to your senses!"
msgstr "Очнитесь же!"

#. ja: さぁ、行ってくれ！
#. de: Folgt mir, Freunde!
#. fr: Bonne chance<nbsp>!
msgctxt "NpcYell:11188:0:13"
msgid "We are counting on you!"
msgstr "Ну, вперёд! Мы на вас рассчитываем!"

#. ja: 皆さん、ご無事で…
#. de: Das Schlachtenglück möge uns hold sein.
#. fr: Faites attention à vous<nbsp>!
msgctxt "NpcYell:11189:0:13"
msgid "Have faith and victory shall be ours."
msgstr "Верьте в победу — и она будет за нами."

#. ja: こっちだ！
#. de: Hier lang!
#. fr: Par ici<nbsp>!
msgctxt "NpcYell:11190:0:13"
msgid "This way!"
msgstr "Сюда!"

#. ja: アリゼー、こっちだ！
#. de: Alisaie, hier entlang!
#. fr: Alisaie, viens<nbsp>!
msgctxt "NpcYell:11191:0:13"
msgid "With me, Alisaie!"
msgstr "Ализе, за мной!"

#. ja: あ、ううう…
#. de: Uuuagh<nbsp>...
#. fr: Aaaah... Uuurgh...
msgctxt "NpcYell:11192:0:13"
msgid "Unnngh..."
msgstr "У-у-ух..."

#. ja: 栄光あレ…
#. de: Ruuuhm<nbsp>...
#. fr: Gloire...
msgctxt "NpcYell:11193:0:13"
msgid "Glory be..."
msgstr "Сла-а-ава..."

#. ja: この手に勝利をッ！
#. de: Der Sieg ist mir gewiss!
#. fr: La victoire est à moi<nbsp>!
msgctxt "NpcYell:11194:0:13"
msgid "For victory!"
msgstr "К победе!"

#. ja: 限界さえ超えてみせよう！
#. de: Grenzenlos ist meine Macht!
#. fr: À présent, je vais dépasser mes limites<nbsp>!
msgctxt "NpcYell:11195:0:13"
msgid "Power from beyond!"
msgstr "Я преодолею любые пределы!"

#. ja: そらそらそらァ！
#. de: Komm schon, na los!
#. fr: Mange ça !
msgctxt "NpcYell:11197:0:13"
msgid "What, can't keep up?"
msgstr "Ну же, не поспеваешь?"

#. ja: 切り刻むぜェ！
#. de: Ich schlitze dich auf!
#. fr: Tu vas finir en pièces !
msgctxt "NpcYell:11198:0:13"
msgid "I'll cut you to shreds!"
msgstr "Я изрублю тебя в клочья!"

#. ja: コロス…
#. de: Stiiirb<nbsp>...
#. fr: À mort...
msgctxt "NpcYell:11199:0:13"
msgid "Must...kill..."
msgstr "Надо... убить..."

#. ja: 蛮族ドモメ…
#. de: Erhebt euch Götter<nbsp>...
#. fr: Hommes... bêtes...
msgctxt "NpcYell:11200:0:13"
msgid "Get out of my head!"
msgstr "Проклятые зверолюди... Прочь из моей головы!"

#. ja: ああ…本当に…<br>何てお礼を言ったらいいか…
#. de: Ich stehe auf ewig in eurer Schuld ...
#. fr: Comment pourrais-je jamais vous remercier...<nbsp>?
msgctxt "NpcYell:11201:0:13"
msgid "I'm truly in your debt..."
msgstr "Я у тебя в неоплатном долгу..."

#. ja: 片付いたか…
#. de: Fertig ...
#. fr: Ils vont finirrr par se calmer, oui<nbsp>!?
msgctxt "NpcYell:11202:0:13"
msgid "There..."
msgstr "Ну вот..."

#. ja: 今ので最後かしら？
#. de: War es das?
#. fr: Espérons que ce soient les derniers<nbsp>!
msgctxt "NpcYell:11203:0:13"
msgid "Is that all of them?"
msgstr "Это все?"

#. ja: グゥ…つええ…
#. de: I-Ist die stark<nbsp>...
#. fr: Elle est... trop forte... ja...
msgctxt "NpcYell:11204:0:13"
msgid "T-Too strong..."
msgstr "Слишком... сильны..."

#. ja: てイコく…バんザ…
#. de: D-Das Kaiserreich<nbsp>... Lebe hoch<nbsp>...
#. fr: Garle... mald...
msgctxt "NpcYell:11205:0:13"
msgid "For the Empire!"
msgstr "За Империю!"

#. ja: ウググググ…
#. de: Garle... mald<nbsp>...
#. fr: NrrrgGghhH...
msgctxt "NpcYell:11206:0:13"
msgid "Hrnghhh..."
msgstr "Угххх..."

#. ja: ぐげげげ！
#. de: Naaagh<nbsp>...
#. fr: BeuuuAaarh...
msgctxt "NpcYell:11207:0:13"
msgid "Graaagh!"
msgstr "Гра-а-а!"

#. ja: 身動きが…！
#. de: Bin ich dir zu flink?
#. fr: Je ne peux plus bouger<nbsp>!
msgctxt "NpcYell:11208:0:13"
msgid "Can't...move..."
msgstr "Не могу... пошевелиться..."

#. ja: 今度は俺か…！
#. de: Zeit, die Samthandschuhe abzulegen<nbsp>...
#. fr: Argh<nbsp>! Il m'a eu<nbsp>!
msgctxt "NpcYell:11209:0:13"
msgid "I've let my guard down!"
msgstr "Я потерял бдительность!"

#. ja: 守護の魔法を！
#. de: Die Magie ist mein Schild!
#. fr: Barrière protectrice<nbsp>!
msgctxt "NpcYell:11210:0:13"
msgid "Stay close to me!"
msgstr "Держитесь ко мне поближе!"

#. ja: ぜぇ、ぜぇ…
#. de: \<keuch>
#. fr: Haa... Haa...
msgctxt "NpcYell:11211:0:13"
msgid "\\<pant> \\<pant>"
msgstr "\\<тяжело дышит> \\<тяжело дышит>"

#. ja: 仕掛けてくる…！
#. de: Aufgepasst!
#. fr: Attention<nbsp>!
msgctxt "NpcYell:11212:0:13"
msgid "Look out!"
msgstr "Берегись!"

#. ja: はああぁぁっ…！
#. de: Jetzt<nbsp>... reicht<nbsp>... es<nbsp>... mir!!!
#. fr: HAAAA...<nbsp>!!
msgctxt "NpcYell:11213:0:13"
msgid "Haaaaaa...!"
msgstr "А-а-а-а-а...!"

#. ja: この楔は…！
#. de: Achtung, er wirkt Inferno!
#. fr: Les... Les pals infernaux<nbsp>!
msgctxt "NpcYell:11214:0:13"
msgid "I do not like the look of that..."
msgstr "Мне не нравится эта штука..."

#. ja: こちらは、私が！
#. de: Jetzt komm ich!
#. fr: Je m'en charge<nbsp>!
msgctxt "NpcYell:11215:0:13"
msgid "Leave this one to me!"
msgstr "С этим я сам разберусь!"

#. ja: ウグァァァァァ！
#. de: Grrroaaarrr!
#. fr: GRAAAAAHHH<nbsp>!!
msgctxt "NpcYell:11216:0:13"
msgid "Graaaaaagh!"
msgstr "Уа-а-а-а-а!"

#. ja: うおおぉぉ！
#. de: Aaaah!
#. fr: Aaaah<nbsp>!!
msgctxt "NpcYell:11217:0:13"
msgid "Aaah!"
msgstr "А-а-а!"

#. ja: ボガッ！
#. de: BoAAaH!
#. fr: Boum<nbsp>!
msgctxt "NpcYell:11218:0:13"
msgid "TO SPLINTERS! TO SPLINTERS!"
msgstr "В ЩЕПКИ! В ЩЕПКИ!"

#. ja: ボガッ、ボガッ！
#. de: BoAAaH! BOaAAahN!
#. fr: Boum<nbsp>! Boum<nbsp>!
msgctxt "NpcYell:11219:0:13"
msgid "FREEZE! FREEZE!"
msgstr "ЗАМЕРЗАЙТЕ! ЗАМЕРЗАЙТЕ!"

#. ja: ボガガガガァ～！
#. de: BOaAAahN!
#. fr: Boubouboum<nbsp>!!
msgctxt "NpcYell:11220:0:13"
msgid "GRAAAAAAGH!"
msgstr "ГРА-А-А-А!"

#. ja: ボガガガガァ～！<br>ボガアァ～！
#. de: BOaAAahN! BoAAaH! BOaAAahN!
#. fr: Bouboum la bobombe<nbsp>!!
msgctxt "NpcYell:11221:0:13"
msgid "BRRRRRRGH! RRRRRRGH!"
msgstr "БРРРРРР! РРРРРР!"

#. ja: 断ち貫くッ…！
#. de: Du wirst durchbohrt!
#. fr: Ton armure ne résistera pas à ça<nbsp>!
msgctxt "NpcYell:11222:0:13"
msgid "I tire of these games!"
msgstr "С меня хватит этих игр!"

#. ja: 特殊弾、装填…！
#. de: Sondermunition!
#. fr: J'ai les munitions parfaites contre toi<nbsp>!
msgctxt "NpcYell:11223:0:13"
msgid "Charging cannons..."
msgstr "Заряжаю пушки..."

#. ja: 標的確認ッ…！
#. de: Ziel bestätigt.
#. fr: Je t'ai dans mon viseur<nbsp>!
msgctxt "NpcYell:11224:0:13"
msgid "Target locked."
msgstr "Цель захвачена."

#. ja: 斬り刻んでくれるッ！
#. de: Zerstückelt sie!
#. fr: Je vais te déchirer en lambeaux<nbsp>!
msgctxt "NpcYell:11225:0:13"
msgid "Taste my steel!"
msgstr "Попробуй на вкус мою сталь!"

#. ja: 疾走れッ！
#. de: Lauft!
#. fr: Tu n'échapperas pas à la lame du vent<nbsp>!
msgctxt "NpcYell:11226:0:13"
msgid "Down with you!"
msgstr "Сдохни!"

#. ja: 逃げられると<br>思うなよ…！
#. de: Es gibt kein Entkommen!
#. fr: N'espère pas pouvoir fuir...
msgctxt "NpcYell:11227:0:13"
msgid "You'll not escape this time!"
msgstr "На этот раз тебе не уйти!"

#. ja: 見切った…<br>狙い撃つッ！
#. de: Ziel erfasst. Feuer!
#. fr: Je te tiens<nbsp>!
msgctxt "NpcYell:11228:0:13"
msgid "Now, hold still..."
msgstr "А теперь стой смирно..."

#. ja: ブルルルッ！
#. de: \<schnauf>
#. fr: Brrrr<nbsp>!
msgctxt "NpcYell:11229:0:13"
msgid "Neighhh!"
msgstr "И-го-го-о!"

#. ja: モノセロス、お願い！
#. de: Monozeros, tu was!
#. fr: Monocéros, à toi de jouer<nbsp>!
msgctxt "NpcYell:11230:0:13"
msgid "Go, Monoceros!"
msgstr "Моноцерос, вперёд!"

#. ja: 死霊を<br>呼び寄せたというの…！？
#. de: Der Geruch des Kampfes hat die Toten angelockt!
#. fr: I-il a ressuscité des morts<nbsp>!?
msgctxt "NpcYell:11231:0:13"
msgid "I-It summons the dead!?"
msgstr "О-он призывает мертвецов?!"

#. ja: ボズヤの自由のために！
#. de: Für die Freiheit Bozjas!
#. fr: Pour Bozja<nbsp>! Pour la liberté<nbsp>!!!
msgctxt "NpcYell:11232:0:13"
msgid "For Bozja!"
msgstr "За свободу Божи!"

#. ja: 前進、前進ッ！
#. de: Vorwärts! Vorwärts!
#. fr: En avant, camarades<nbsp>!
msgctxt "NpcYell:11233:0:13"
msgid "Forward! Forward!"
msgstr "Вперёд! Вперёд!"

#. ja: いくぞッ！
#. de: Los jetzt!
#. fr: À l'attaque !
msgctxt "NpcYell:11234:0:13"
msgid "Hold steady!"
msgstr "Держать строй!"

#. ja: うおぉぉぉ！
#. de: Uaaah!
#. fr: Uooooh<nbsp>!
msgctxt "NpcYell:11235:0:13"
msgid "Raaah!"
msgstr "Р-р-р-а-а!"

#. ja: ぬんッ！
#. de: Uff!
#. fr: Gnnaaah<nbsp>!
msgctxt "NpcYell:11236:0:13"
msgid "Urgh!"
msgstr "Ух!"

#. ja: ここからが正念場ぞ！
#. de: Das ist die Stunde der Wahrheit!
#. fr: C'est aujourd'hui que tout se joue<nbsp>!
msgctxt "NpcYell:11237:0:13"
msgid "The battle begins here!"
msgstr "Вот теперь начнётся самое трудное!"

#. ja: 気を抜くなよ！
#. de: Nicht nachlassen!
#. fr: Restez vigilants<nbsp>!
msgctxt "NpcYell:11238:0:13"
msgid "On your guard, everyone!"
msgstr "Всем быть начеку!"

#. ja: 進むぞッ！
#. de: Weiter vor!
#. fr: On fonce<nbsp>!
msgctxt "NpcYell:11239:0:13"
msgid "Onward, men!"
msgstr "Вперёд, бойцы!"

#. ja: それでも屈しはしない！<br>抗う力で、打ち崩します…！
#. de: Wir werden nicht nachgeben!
#. fr: Nous ne fléchirons jamais<nbsp>! Goûtez de notre ténacité<nbsp>!
msgctxt "NpcYell:11240:0:13"
msgid "Well, let us see how its defenses fare against this!"
msgstr "Посмотрим, как эта штука выдержит вот это!"

#. ja: 仕留めるッ…！
#. de: Macht sie alle kalt!
#. fr: Je m'en occupe<nbsp>!
msgctxt "NpcYell:11241:0:13"
msgid "I see an opening!"
msgstr "Вот он, шанс!"

#. ja: 私はこちら側へ！
#. de: Ich geh hier lang!
#. fr: Je vais par là<nbsp>!
msgctxt "NpcYell:11242:0:13"
msgid "I will take this path."
msgstr "Я пойду этой дорогой."

#. ja: ご武運を…！
#. de: Das Glück ist mit den Mutigen!
#. fr: Bonne chance<nbsp>!
msgctxt "NpcYell:11243:0:13"
msgid "Stay safe."
msgstr "Берегите себя."

#. ja: 隙あり！
#. de: Stoßt durch die Lücke!
#. fr: Je vois en toi comme dans un livre ouvert<nbsp>!
msgctxt "NpcYell:11244:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: これならッ！
#. de: Das ist es!
#. fr: Là<nbsp>!
msgctxt "NpcYell:11245:0:13"
msgid "Take that!"
msgstr "Получай!"

#. ja: 魔導兵器の背後を…！
#. de: Attackiert die Maschine von hinten!
#. fr: Mieux vaut ne pas rester devant cet engin. Attaquons-le par l'arrière.
msgctxt "NpcYell:11246:0:13"
msgid "What...what is that...?"
msgstr "Что... что это такое?.."

#. ja: あれが例の<br>「アラグの悪魔」なのか！？
#. de: Ist das der Dämon der Allager?
#. fr: C'est lui... le démon d'Allag<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11247:0:13"
msgid "By the gods...<br>Is <i>that</i> the Allagan relic!?"
msgstr "Боги...<br>Неужели <i>это</i> аллаганская реликвия?!"

#. ja: 食い止めろ！
#. de: Haltet sie auf!
#. fr: Arrêtez-les<nbsp>!
msgctxt "NpcYell:11248:0:13"
msgid "Bozjan curs!"
msgstr "Бозийские отродья!"

#. ja: ガブラス様のために！
#. de: Für Legatus Gabranth!
#. fr: Pour Gabranth<nbsp>!
msgctxt "NpcYell:11249:0:13"
msgid "For Gabranth!"
msgstr "За Габранта!"

#. ja: やらせんぞ！
#. de: Die lassen wir nicht durch!
#. fr: N'y crois même pas<nbsp>!
msgctxt "NpcYell:11250:0:13"
msgid "Today you die!"
msgstr "Не бывать этому!"

#. ja: 迎え撃て！
#. de: Feuer erwidern!
#. fr: Abattez-les tous<nbsp>!
msgctxt "NpcYell:11251:0:13"
msgid "Hold nothing back!"
msgstr "Не сдерживайтесь!"

#. ja: 使い魔よ、来たれッ！
#. de: Familiar, erscheine!
#. fr: Fidèle compagnon, réponds à mon appel<nbsp>!
msgctxt "NpcYell:11252:0:13"
msgid "Come, my children. There is work to be done!"
msgstr "Дети мои, ко мне! Пора за работу!"

#. ja: さあ、その炎で<br>我らが敵を焼き尽くせッ！
#. de: In diesem Feuer soll der Feind schmoren!
#. fr: Tes flammes réduiront nos ennemis en cendre<nbsp>!
msgctxt "NpcYell:11253:0:13"
msgid "Their flames will sear the flesh from your bones!"
msgstr "Вашу плоть сожгут их языки пламени!"

#. ja: 侵入者発見…<br>侵入者発見…！
#. de: Eindringlinge gesichtet ...
#. fr: Intrus repérés...<br>Extermination en cours...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11254:0:13"
msgid "Intruder alert!<br>Intruder alert!"
msgstr "Обнаружен нарушитель!<br>Обнаружен нарушитель!"

#. ja: 炎より舞い上がれ！
#. de: Feuer, Flammen, flackert empor!
#. fr: Les flammes sont ton berceau<nbsp>!
msgctxt "NpcYell:11255:0:13"
msgid "Rise from the ashes, and lay waste to our enemies!"
msgstr "Восстань из пепла и испепели наших врагов!"

#. ja: 剣に炎の魔力を…！
#. de: Schwert, empfange die Macht des Feuers!
#. fr: Que les flammes se concentrent dans ma lame<nbsp>!
msgctxt "NpcYell:11256:0:13"
msgid "The flames will consume you all!"
msgstr "Пламя поглотит вас всех!"

#. ja: 魔力の流れ…<br>時を操作する…！
#. de: Die Magie beeinflusst den Lauf der Zeit ...
#. fr: Voyez comment l'éther et le temps peuvent former un même continuum<nbsp>!
msgctxt "NpcYell:11257:0:13"
msgid "Time is mine to command. Mine to control!"
msgstr "Время мне подвластно. Я повелеваю им!"

#. ja: 次から次へと…！
#. de: Immer weiter!
#. fr: Ils en arrivent toujours<nbsp>!
msgctxt "NpcYell:11258:0:13"
msgid "Is there no end to them!?"
msgstr "Им конца не будет?!"

#. ja: まだまだ来るぞ！<br>気を抜くなッ！
#. de: Es kommen immer mehr! Nicht nachlassen!
#. fr: En voilà d'autres<nbsp>! Vous relâchez pas<nbsp>!
msgctxt "NpcYell:11259:0:13"
msgid "We mustn't lose heart!"
msgstr "Нельзя падать духом!"

#. ja: 常夏の浜、そして海！！
#. de: Sonne, Strand und Meer!
#. fr: Ah, l'île de l'Éternel été et ses plages de sable fin<nbsp>!
msgctxt "NpcYell:11260:0:13"
msgid "Sun, sea, and sandy beaches─there's no place like the Isle of Endless Summer!"
msgstr "Солнце, море и песчаный пляж — лучше Острова вечного лета места не найти!"

#. ja: よーし、泳ぐわよー！
#. de: Ab ins Wasser!
#. fr: Moi, je vais me baigner<nbsp>!
msgctxt "NpcYell:11261:0:13"
msgid "I'm diving in!"
msgstr "Ныряю!"

#. ja: 私も泳ぐー！
#. de: Meer, ich komme!
#. fr: Je viens avec toi<nbsp>!
msgctxt "NpcYell:11262:0:13"
msgid "Me too!"
msgstr "Я тоже!"

#. ja: おいおい、慌ててコケんなよ？
#. de: He, immer langsam!
#. fr: Faites attention à ne pas vous casser la figurrre, d'accord<nbsp>?
msgctxt "NpcYell:11263:0:13"
msgid "Hey! Take it easy, will you?"
msgstr "Эй! Полегче, ладно?"

#. ja: ん、なんだこの箱？
#. de: Was machen denn diese Kisten hier?
#. fr: C'est quoi, cette boîte<nbsp>?
msgctxt "NpcYell:11264:0:13"
msgid "What's with all these boxes?"
msgstr "Чего это тут столько ящиков?"

#. ja: 漂着物かな？
#. de: Vielleicht wurden sie von den Wellen angespült.
#. fr: Elle est arrivée par la mer<nbsp>?
msgctxt "NpcYell:11265:0:13"
msgid "Did they just wash up on shore?"
msgstr "Их, что ли, море выбросило на берег?"

#. ja: なんか冷たくなーい？
#. de: Ist dir auch auf einmal so kalt?
#. fr: Vous avez pas frrroid, tout à coup<nbsp>?
msgctxt "NpcYell:11266:0:13"
msgid "Is it just me, or is there a chill in the air?"
msgstr "Это только мне холодно стало?"

#. ja: 冷たいというか…<br>うぅ、寒くなってきた…
#. de: Und wie ... Brrr!
#. fr: Maintenant que tu le dis...
msgctxt "NpcYell:11267:0:13"
msgid "A chill? It's downright freezing! Brrrrrr..."
msgstr "Холодно? Да тут мороз! Бр-р-р..."

#. ja: うわっ！<br>まま、魔物！？
#. de: Uaaa! M-Monster!
#. fr: Ouaaah<nbsp>! Des monstres<nbsp>!
msgctxt "NpcYell:11268:0:13"
msgid "Uwaaah! M-Monsters!?"
msgstr "Ой! М-монстры?!"

#. ja: キャーーー！
#. de: Hilfe!!!
#. fr: Kyaaaaaaah<nbsp>!!
msgctxt "NpcYell:11269:0:13"
msgid "H-Help! Someone, please!"
msgstr "А-а-а! Кто-нибудь, помогите!"

#. ja: 青い…ボム…！？
#. de: Blaue ... Knallomaten ...?
#. fr: Des bombardos... com<shy>plè<shy>te<shy>ment givrrrés<nbsp>!
msgctxt "NpcYell:11270:0:13"
msgid "It's a Bombard, but...blue?"
msgstr "Это бомбардо, но... синий?"

#. ja: さ、寒い…！<br>逃げよう…！
#. de: I-Ich friere. Nichts wie weg!
#. fr: Au secourrrs<nbsp>! Je veux pas me transformer en glaçon<nbsp>!
msgctxt "NpcYell:11271:0:13"
msgid "Let's get out of here before we freeze to death!"
msgstr "Уходим, пока не замёрзли насмерть!"

#. ja: ボガッ…
#. de: BoAAaH!
#. fr: Boum...
msgctxt "NpcYell:11272:0:13"
msgid "TO SPLINTERS! TO SPLINTERS!"
msgstr "В ЩЕПКИ! В ЩЕПКИ!"

#. ja: ボガガアァァッ！
#. de: BoAAaH! BOaAAahN!
#. fr: Bouuuuum<nbsp>!!
msgctxt "NpcYell:11273:0:13"
msgid "FREEZE! FREEZE!"
msgstr "ЗАМЕРЗАЙТЕ! ЗАМЕРЗАЙТЕ!"

#. ja: ボガガ、ボガァッ！
#. de: BOaAAahN!
#. fr: Boum et reboum<nbsp>!!
msgctxt "NpcYell:11274:0:13"
msgid "GRAAAAAAGH!"
msgstr "ГРА-А-А-А!"

#. ja: ボ…ボ…ボガァ…
#. de: BOaAAahN!
#. fr: Bou... boum... Bo... bombe...
msgctxt "NpcYell:11275:0:13"
msgid "BRRRRRRGH! RRRRRRGH!"
msgstr "Бр... бр... р-р-рах..."

#. ja: ギギギ…ミギ…<br>右腕ガァ…！
#. de: Uaaa! Mein rechter Arm!
#. fr: Mon... mon braaaaas<nbsp>! Mon bras droit<nbsp>!!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11276:0:13"
msgid "Adjusting tactic protocols...<br>Enhancing right arm."
msgstr "Перенастройка боевых протоколов...<br>Усиление правой руки."

#. ja: イギ…ギギギ…<br>左腕ェェッ！
#. de: Uiii! Mein linker Arm!
#. fr: Qu-qu'est-ce que...<nbsp>!? Mon bras gauche...<nbsp>! Il...<nbsp>!!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11277:0:13"
msgid "Adjusting tactic protocols...<br>Enhancing left arm."
msgstr "Перенастройка боевых протоколов...<br>Усиление левой руки."

#. ja: オ、レ、オレ、レ…<br>逃サナイ、イィ…！
#. de: I-Ich werde<nbsp>... nicht<nbsp>... fliehen<nbsp>...
#. fr: Dabog... Dabog ne vous laissera pas fuir<nbsp>!
msgctxt "NpcYell:11278:0:13"
msgid "Pursuing target..."
msgstr "Преследую цель..."

#. ja: いくぞッ！
#. de: Los!
#. fr: À l'attaque !
msgctxt "NpcYell:11279:0:13"
msgid "Charge!"
msgstr "Натиск!"

#. ja: 押せ、押せッ！
#. de: Vorwärts! Vorwärts!
#. fr: Repoussez-les<nbsp>! Encore, encore<nbsp>!
msgctxt "NpcYell:11280:0:13"
msgid "No quarter!"
msgstr "Пленных не брать!"

#. ja: さらに使い魔を！
#. de: Schnell, noch ein Familiar<nbsp>...
#. fr: Invoquez plus de familiers<nbsp>!
msgctxt "NpcYell:11281:0:13"
msgid "More! We must have more!"
msgstr "Ещё! Нам нужно ещё!"

#. ja: 具不退転！
#. de: Amalj'aa, haltet die Stellung!
#. fr: La fuite, une option n'est pas<nbsp>!
msgctxt "NpcYell:11282:0:13"
msgid "No turning back!"
msgstr "Ни шагу назад!"

#. ja: 死中求活！
#. de: Ahnen, führt meinen Speer!
#. fr: La mort, je ne crains pas<nbsp>!
msgctxt "NpcYell:11283:0:13"
msgid "We win or we die!"
msgstr "Победим или умрём!"

#. ja: た、助けてくれ…
#. de: Wir brauchen Unterstützung!
#. fr: Que quelqu'un, en aide, nous vienne...
msgctxt "NpcYell:11284:0:13"
msgid "I cannot go on..."
msgstr "Я... больше не могу..."

#. ja: 進退維谷…！
#. de: Grrr<nbsp>... Wir stecken in der Falle!
#. fr: Cernés, nous sommes<nbsp>!
msgctxt "NpcYell:11285:0:13"
msgid "No way forward, no way back!"
msgstr "Нам некуда отступать!"

#. ja: ぬぅ…<br>このままでは…
#. de: Argh<nbsp>... Wir sind in der Unterzahl!
#. fr: Urgh... Mal engagé, c'est...
msgctxt "NpcYell:11286:0:13"
msgid "Our best was not enough."
msgstr "Мы сделали всё, что могли..."

#. ja: 戦々恐々…！
#. de: Zeit, an die Tafel meiner Ahnen zu treten<nbsp>...
#. fr: Le pire, je crains...
msgctxt "NpcYell:11287:0:13"
msgid "They are too strong..."
msgstr "Они слишком сильны..."

#. ja: グハッ…
#. de: Uargh!
#. fr: Gah...<nbsp>!
msgctxt "NpcYell:11288:0:13"
msgid "Gah...!"
msgstr "Ах..."

#. ja: 残念無念…
#. de: Unser Widerstand<nbsp>...<br>war vergebens<nbsp>...
#. fr: Ainsi, finir, ça ne peut pas...
msgctxt "NpcYell:11289:0:13"
msgid "No...not like this..."
msgstr "Нет... только не так..."

#. ja: 報恩謝徳…<br>必ずやこの恩に報いよう
#. de: Meinen Dank für die rettende Hilfe.<br>Die Amalj'aa werden es nicht vergessen.
#. fr: La vie, nous vous devons...
msgctxt "NpcYell:11290:0:13"
msgid "I owe you my life."
msgstr "Я у вас в долгу."

#. ja: 天佑神助！<br>まさかヒトの救援とは！
#. de: Der Himmel hat euch geschickt!<br>Ehre den Drachenfreunden!
#. fr: Être sauvé par <if $gn4>une humaine<else>un humain</if>, je n'aurais jamais cru...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11291:0:13"
msgid "You would grant me succor?<br>Are you not our enemy?"
msgstr "Вы придёте мне на помощь?<br>Но разве мы не враги?"

#. ja: バッシュ様…<br>貴方の下へ…
#. de: Ich diene Euch, Basch van Gabranth.
#. fr: Seigneur Gabranth... Je vous rejoins dans l'au-delà...
msgctxt "NpcYell:11292:0:13"
msgid "Basch... I have failed you..."
msgstr "Баш... Я подвёл тебя..."

#. ja: 先を急ぐぞ！
#. de: Rasch weiter!
#. fr: Allez, on se magne<nbsp>!
msgctxt "NpcYell:11293:0:13"
msgid "Let's keep moving!"
msgstr "Не задерживаемся!"

#. ja: 飛ぶのは得意ですぞ！
#. de: Jetzt geht der Spaß erst richtig los.
#. fr: J'adore les trampolines<nbsp>!
msgctxt "NpcYell:11294:0:13"
msgid "Graceful even in flight!"
msgstr "Даже в полёте я грациозен!"

#. ja: 戦い恐ろしーい…
#. de: Buuuh, Krieg! Fürchterliches Gemetzel!
#. fr: Ces dragons sont effrayants, oui, terrifiants<nbsp>!
msgctxt "NpcYell:11295:0:13"
msgid "Terrified, frightened, scared!"
msgstr "Боюсь, страшно мне, жуть как страшно!"

#. ja: 助かったーよ<br>今、道を作るーね！
#. de: Hilfe in rechtes Moment!<br>Achtung! Kobolde machen Weg frei!
#. fr: Par ici, par ici<nbsp>! Je vais vous ouvrir la voie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11296:0:13"
msgid "Thank you, overdweller!<br>Let me show you the way!"
msgstr "Спасибо, наземник!<br>Сейчас покажу дорогу!"

#. ja: 来たな、相棒ッ！
#. de: Da bist du ja!
#. fr: Te voilà, camarade<nbsp>!
msgctxt "NpcYell:11297:0:13"
msgid "What took you so long?"
msgstr "Ну наконец-то, напарник!"

#. ja: チッ…
#. de: Ha!
#. fr: Tsk<nbsp>!
msgctxt "NpcYell:11298:0:13"
msgid "Tsk..."
msgstr "Ц-ц..."

#. ja: ハァッ！
#. de: Stirb!
#. fr: Ha<nbsp>!
msgctxt "NpcYell:11299:0:13"
msgid "Ha!"
msgstr "Ха!"

#. ja: 甘い！
#. de: Daneben!
#. fr: Ridicule<nbsp>!
msgctxt "NpcYell:11300:0:13"
msgid "Worthless!"
msgstr "Никчёмно!"

#. ja: そこだッ！
#. de: Mitten ins Herz!
#. fr: Je te tiens<nbsp>!
msgctxt "NpcYell:11301:0:13"
msgid "You're finished!"
msgstr "Тебе конец!"

#. ja: 今こそ戦いの時…
#. de: Feuer brennt in meinen Adern!
#. fr: Il est temps de sortir les griffes.
msgctxt "NpcYell:11302:0:13"
msgid "The time has come..."
msgstr "Настало время..."

#. ja: これも我が運命か…
#. de: Die Stunde des Schicksals der Drachen.
#. fr: Si tel est mon destin...
msgctxt "NpcYell:11303:0:13"
msgid "So be it."
msgstr "Так тому и быть."

#. ja: 哀れな子らよ…
#. de: Meine armen Kinder<nbsp>...
#. fr: Mes pauvres enfants dévoyés...
msgctxt "NpcYell:11304:0:13"
msgid "My children..."
msgstr "Мои дети..."

#. ja: 眠るがよい…
#. de: Ich werde euch von diesem Fluch befreien.
#. fr: Repose en paix.
msgctxt "NpcYell:11305:0:13"
msgid "May you finally be at peace."
msgstr "Пусть наконец обретёте покой."

#. ja: 手強い…！
#. de: Ein gewaltiger Hieb!
#. fr: Ils sont coriaces<nbsp>!
msgctxt "NpcYell:11306:0:13"
msgid "Fall, damn you!"
msgstr "Да пади же ты, проклятый!"

#. ja: いくぞッ！
#. de: Aaaar!
#. fr: À nous de jouer<nbsp>!
msgctxt "NpcYell:11307:0:13"
msgid "Here I come!"
msgstr "Ну, держись!"

#. ja: 蒼の竜騎士が<br>天竜とともに戦おうとはな…
#. de: Drachenreiter und Drache sind Eins ...
#. fr: Un chevalier dragon épaulé par une dragonne ancienne, on aura tout vu<nbsp>!
msgctxt "NpcYell:11308:0:13"
msgid "The combined might of both dragon and dragoon..."
msgstr "Вместе дракон и драгуниус..."

#. ja: はぁ、はぁ…<br>どうにか退けたか…
#. de: \<keuch> Das war knapp<nbsp>... \<schnauf>
#. fr: Haa... (halète) C'était moins une...
msgctxt "NpcYell:11309:0:13"
msgid "I have misjudged our foe..."
msgstr "Я недооценил противника..."

#. ja: ハッ！
#. de: Hahar!
#. fr: Hyah<nbsp>!
msgctxt "NpcYell:11310:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: ヤァッ！
#. de: Nimm das!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:11311:0:13"
msgid "Have at you!"
msgstr "Получай!"

#. ja: アイメリク様…<br>ご無理をなさらずに…！
#. de: Großmeister Aymeric!<br>Ihr solltet Euch etwas schonen.
#. fr: Sire Aymeric, reprenez votre souffle<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11312:0:13"
msgid "Lord Aymeric!<br>Let me take care of this!"
msgstr "Лорд Эймерик!<br>Позвольте мне разобраться!"

#. ja: 怨敵退散…！
#. de: Unsere Stellungen sind durchbrochen!
#. fr: Plus loin, vous n'irez pas<nbsp>!
msgctxt "NpcYell:11313:0:13"
msgid "We are being overwhelmed!"
msgstr "Нас теснят!"

#. ja: 同仇敵愾…！
#. de: Heute kämpfen wir als Eins!
#. fr: À l'ennemi, sus<nbsp>!
msgctxt "NpcYell:11314:0:13"
msgid "Today, we fight as one!"
msgstr "Сегодня мы сражаемся как единое целое!"

#. ja: 絶痛絶苦…
#. de: Rückzug!
#. fr: Cuit, je suis<nbsp>!
msgctxt "NpcYell:11315:0:13"
msgid "Fall back!"
msgstr "Отступаем!"

#. ja: 負傷者の救護は我らに任せ<br>貴殿らは先へ！
#. de: Lasst Euch nicht aufhalten. Wir kümmern uns schon um die Verwundeten.
#. fr: Nous nous chargeons de secourir les blessés, partez devant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11316:0:13"
msgid "We shall see the wounded to safety.<br>You are needed elsewhere!"
msgstr "Мы позаботимся о раненых.<br>Вы нужны в другом месте!"

#. ja: もう大丈夫だ…<br>敵は排除した
#. de: Es ist vorbei. Der Feind zieht sich zurück ...
#. fr: Soyez sans crainte, il n'y a plus d'ennemis par ici.
msgctxt "NpcYell:11317:0:13"
msgid "That should give us a moment's rest."
msgstr "Теперь можно немного передохнуть."

#. ja: 治療師が来るまで<br>もう少し辛抱してくれ…
#. de: Halte durch. Die Heiler sind unterwegs ...
#. fr: Les secours arrivent, tenez bon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11318:0:13"
msgid "Help is on the way.<br>Please, hold on a little longer..."
msgstr "Помощь уже в пути.<br>Потерпите ещё немного..."

#. ja: 目が回りましたな…
#. de: Mir ist etwas schwindelig<nbsp>...
#. fr: J'ai la tête qui tournicote...
msgctxt "NpcYell:11319:0:13"
msgid "Oof, feeling a touch dizzy..."
msgstr "Уф, голова немного кружится..."

#. ja: 反抗憤怒！<br>負けてなるものか！
#. de: Wut, Zort, Donnergroll!<br>Wir geben uns nicht geschlagen!
#. fr: D'admettre la défaite, question, il n'est pas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11320:0:13"
msgid "Stand firm!<br>We cannot afford to lose!"
msgstr "Держитесь!<br>Мы не можем проиграть!"

#. ja: 力戦奮闘！<br>戦い続けよ！
#. de: Amalj'aa, vorwärts!<br>Bei den Ahnen, lasst nicht nach!
#. fr: Nous battre, nous pouvons encore<nbsp>!
msgctxt "NpcYell:11321:0:13"
msgid "We bow down to none!"
msgstr "Мы никому не поклонимся!"

#. ja: え、栄光…あれ…
#. de: Ruhm<nbsp>...
#. fr: G-g-gloire...
msgctxt "NpcYell:11322:0:13"
msgid "Glory be..."
msgstr "С... Слава..."

#. ja: ガレマール…<br>帝国…万歳…
#. de: Ruhm und Ehre<nbsp>...<br>für das Kaiserreich<nbsp>...
#. fr: Vive Garlemald... Vive l'Empire...
msgctxt "NpcYell:11323:0:13"
msgid "Glory be to Garlemald..."
msgstr "Слава Гарлемальду..."

#. ja: 帝国に…栄光あれ…
#. de: Ehre<nbsp>... dem Kaiserreich<nbsp>...
#. fr: Gloire... à l'empire de Garlemald.
msgctxt "NpcYell:11324:0:13"
msgid "...to Garlemald..."
msgstr "...Гарлемальду..."

#. ja: すべては…<br>帝国の為に…
#. de: Das Kaiserreich<nbsp>...<br>soll ewig währen<nbsp>...
#. fr: Pour l'Empire...
msgctxt "NpcYell:11325:0:13"
msgid "For the Empire..."
msgstr "За Империю..."

#. ja: エ、イコ、ウ…アレ…
#. de: Kaiserrreich<nbsp>...<br>Und Flammenmeer<nbsp>...
#. fr: Goirrr...
msgctxt "NpcYell:11326:0:13"
msgid "F-For Garlemald..."
msgstr "С-слава Гарлемальду..."

#. ja: ガレ、マール<br>バンザイ…
#. de: Grrroooarrr!!!
#. fr: Viiiv... Gaaar... aal...
msgctxt "NpcYell:11327:0:13"
msgid "Glory...be..."
msgstr "Слава..."

#. ja: テ、イ、コク…<br>エイコ…
#. de: Garrrlemald<nbsp>...
#. fr: Piiirrr... Goirrr...
msgctxt "NpcYell:11328:0:13"
msgid "For the Emp...ire..."
msgstr "За Импери...ю..."

#. ja: エイコウ…<br>ワレ、ラ、テイコク…
#. de: Brrrennt! Bluuuutet! \<fauch>
#. fr: Goirrr... aaal... piiirrr...
msgctxt "NpcYell:11329:0:13"
msgid "Gl-Glory be...to Garlemald..."
msgstr "С-слава... Гарлемальду..."

#. ja: ヤマツミ、ここで会ったが百年目だ！<br>お縄についてもらうぞ！
#. de: Ergib dich, Yamatsumi! Du kannst dem langen Arm des Gesetzes nicht entkommen!
#. fr: Yamatsumi<nbsp>! Tu ne nous échapperas plus<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11330:0:13"
msgid "There is nowhere left to run, Yamatsumi!<br>Give yourself into our custody!"
msgstr "Бежать больше некуда, Ямацуми!<br>Сдавайтесь!"

#. ja: あなた方の境遇には同情しますが、<br>やはりボズヤを支配しようという行いは許せません！
#. de: Wir verstehen dich ja, aber lass die Finger von Bozja!
#. fr: Nous compatissons à votre malheur, mais ce n'est pas pour autant que nous allons vous laisser conquérir Bozja<nbsp>!
msgctxt "NpcYell:11331:0:13"
msgid "We sympathize with your plight, but we will not allow you to subject Bozja to your depravations!"
msgstr "Нам жаль, что вас постигла такая участь, но мы не позволим вам терзать Бозью!"

#. ja: 情けは無用！<br>我らは敵同士、譲れぬもののため戦うのみよ！
#. de: Spart euch euer Mitgefühl! Wir sind Feinde, und als Feinde werdet ihr sterben!
#. fr: Je n'ai que faire de votre pitié<nbsp>! Nous sommes ennemis et nous battons chacun pour défendre notre cause<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11332:0:13"
msgid "Spare me your pity!<br>We are foes─I accept naught from you but pain and blood!"
msgstr "Пощадите меня своей жалостью!<br>Мы враги — от вас мне нужны лишь боль и кровь!"

#. ja: 我が一族の至宝に封じられた、最強の式神をここに……！
#. de: Größter aller Shikigami, erscheine!
#. fr: Pour ce faire, je vais recourir au plus puissant de mes shiki<nbsp>! Le trésor de notre clan<nbsp>!
msgctxt "NpcYell:11333:0:13"
msgid "Pride of our line, greatest of the shikigami, I summon thee forth!"
msgstr "Гордость нашего рода, величайший из сикигами, явись!"

#. ja: ゆけ、ヨウキよ！<br>我に仇なす者どもを叩き潰すのだ！
#. de: Zerstöre sie, Yoki! Sie stehen mir im Weg!
#. fr: À moi, yôki<nbsp>! Réduis à néant tous ceux qui s'opposent à moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11334:0:13"
msgid "Slay them, yoki!<br>Smear their offal upon the rocks!"
msgstr "Убей их, ёки!<br>Размажь их внутренности по скалам!"

#. ja: ええい、やってくれる！<br>来たれ式神ども、我を守る結界を張るのだ！
#. de: Ihr gebt nicht leicht auf, was?<br>Beschütze mich, Yoki, ich befehle es!
#. fr: Argh... Vous vous défendez avec ardeur<nbsp>! Shikigami<nbsp>! Protégez-moi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11335:0:13"
msgid "Bah, you try my patience!<br>Protect me, shikigami! I command it!"
msgstr "Ну и терпение же ты испытываешь!<br>Защити меня, сикигами! Я приказываю!"

#. ja: 我が命運も…<br>ここまでか…
#. de: Ist das unser Ende?
#. fr: Le fil de mes jours va-t-il se rompre ici...<nbsp>?
msgctxt "NpcYell:11336:0:13"
msgid "Is this where our line ends?"
msgstr "Неужели здесь и оборвётся наш род?"

#. ja: ヨウキが<br>打ち崩されただと！？
#. de: Wie ist das möglich! Yoki ist zerstört?
#. fr: Ils ont vaincu le yôki<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11337:0:13"
msgid "It cannot be!<br>Yoki is broken!?"
msgstr "Не может быть!<br>Ёки повержен!?"

#. ja: 最強の式神、ヨウキをも討ち倒すとは……！
#. de: Es darf nicht sein. Er war der stärkste der Shikigami!
#. fr: Impossible... Notre shiki le plus puissant<nbsp>!
msgctxt "NpcYell:11338:0:13"
msgid "The greatest shikigami we have ever commanded... Fallen."
msgstr "Величайший из всех сикигами, что нам служили... Повержен."

#. ja: ヤマツミ様…！<br>再起を図りましょう…
#. de: Los, Yamatsumi! Wir werden unsere Rache schon noch bekommen.
#. fr: Yamatsumi<nbsp>! Venez<nbsp>! Nous aurons notre revanche<nbsp>!
msgctxt "NpcYell:11339:0:13"
msgid "Come, Yamatsumi! We shall have another chance at revenge!"
msgstr "Идём, Ямацуми! Ещё отомстим!"

#. ja: もはや切り札は残されていないようでござるな。<br>ヤマツミよ、観念するのだ！
#. de: Das Spiel ist aus, Yamatsumi! Ergib dich endlich!
#. fr: Cette invocation était ton ultime atout, Yamatsumi<nbsp>! Rends-toi, maintenant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11340:0:13"
msgid "Your quiver of tricks is empty, Yamatsumi.<br>Now surrender!"
msgstr "Твои уловки закончились, Ямацуми.<br>Сдавайся!"

#. ja: うぅ…<br>なんてことだ…
#. de: Nein ... Wie ist das möglich?
#. fr: Non, comment est-ce possible...<nbsp>?
msgctxt "NpcYell:11341:0:13"
msgid "No... This cannot be..."
msgstr "Нет... Не может быть..."

#. ja: ぐっ……<br>ウラベ一族再興のため、退かせてもらおう……！
#. de: Niemals! Der Urabe-Klan wird zurückkehren, stärker als je zuvor!
#. fr: Jamais...<nbsp>! Le clan Urabe survivra<nbsp>! Quoiqu'il en coûte<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11342:0:13"
msgid "Surrender?<br>The Urabe will return, stronger than before!"
msgstr "Сдаться?<br>Клан Урабэ ещё вернётся, и станет сильнее прежнего!"

#. ja: キヒッ……聖石片の使い方、<br>我ながら上達してきたじゃあないか……。
#. de: He he ... Die Auracitensplitter sind wirklich überaus nützlich.
#. fr: Gnin hin hin... Je manie de mieux en mieux le pouvoir des auralithes sacrées. Mon génie me surprend parfois...
msgctxt "NpcYell:11343:0:13"
msgid "Hehe... The relic bends to my will. As is to be expected from one with my talents."
msgstr "Хе-хе... Реликвия покоряется моей воле. Как и подобает тому, кто наделён моими талантами."

#. ja: 精神呪縛も完璧…<br>なかなかのデキだ！
#. de: Nichts und niemand kann sich dieser Kraft entziehen!
#. fr: Mon sort de contrôle mental est désormais parfait<nbsp>! C'est magnifique<nbsp>!
msgctxt "NpcYell:11344:0:13"
msgid "I am master of man and artifact alike, and finally the stage for my masterpiece is set! Haha!"
msgstr "Мне подвластны и люди, и реликвия! Наконец-то сцена готова для моего шедевра! Ха-ха!"

#. ja: 仲間がこの辺りに<br>先行していたはずだが…！
#. de: Wo sind die anderen? Sie müssten längst hier sein!
#. fr: Nos éclaireurs étaient en recon<shy>nais<shy>san<shy>ce dans le coin, mais aucune trace d'eux...
msgctxt "NpcYell:11345:0:13"
msgid "Where are the advance forces? I see no sign of them."
msgstr "Где передовой отряд? Не вижу никаких следов."

#. ja: ググゥ…ダルマスカ…<br>フッフッ…！
#. de: Uahaha ... Dalmasca-Mann ... Ho ho.
#. fr: Grrr... Rapport... Dalmasquiens... hé hé hé...
msgctxt "NpcYell:11346:0:13"
msgid "Grah! Dalmasca. Grrr."
msgstr "Гр-р! Далмаска... Гр-р..."

#. ja: 『ダルマスカで確認された、聖石による変異体』ですって？<br>あれがフラン殿の報告にあった存在だというの！？
#. de: Was? Du meinst, das sind verwandelte Dalmascianer? So wie Fran es berichtet hat?
#. fr: Comment, Kosyu<nbsp>? Tu veux dire que ce sont les Dalmasquiens transformés dont parlait Fran dans son rapport<nbsp>?
msgctxt "NpcYell:11347:0:13"
msgid "What was that, Kosyu? These are the selfsame fiends Lady Fran reported sighting in Dalmasca? It can't be!"
msgstr "Что, Косю? Это те самые чудовища, которых леди Фран видела в Далмаске? Не может быть!"

#. ja: 見たか！<br>これが我が陰陽術よ！
#. de: Seht die Macht des Onmyo! Ich bin das Yin und das Yang!
#. fr: Vous n'êtes pas de taille face au onmyo<nbsp>!
msgctxt "NpcYell:11348:0:13"
msgid "Now do you see!? My art is beyond challenge!"
msgstr "Ну что, убедились!? Моему искусству нет равных!"

#. ja: しまった……！<br>一度、下がるぞ！
#. de: Verdammt. Den knöpfen wir uns ein andermal vor.
#. fr: Nous nous y sommes mal pris<nbsp>! Rentrons avant qu'il ne nous achève<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11349:0:13"
msgid "Curses!<br>We must retreat!"
msgstr "Проклятье!<br>Нужно отступать!"

#. ja: わかりました…<br>オボロ様…！
#. de: Wie Ihr es sagt, Meister Oboro.
#. fr: D'accord<nbsp>!
msgctxt "NpcYell:11350:0:13"
msgid "We will yet prevail, Master Oboro!"
msgstr "Мы ещё одержим победу, господин Оборо!"

#. ja: くっ…！<br>こんなところで…！
#. de: Argh, ausgerechnet hier.
#. fr: Non...<nbsp>! Je... Je dois...<nbsp>!
msgctxt "NpcYell:11351:0:13"
msgid "It cannot end...like...this..."
msgstr "Не может... закончиться... вот так..."

#. ja: 仇ヲ…<br>皆ノ仇ヲ…！
#. de: Feinde! Alles Feinde!
#. fr: Vengeance... Vengeaaance<nbsp>!!!
msgctxt "NpcYell:11352:0:13"
msgid "The Resistance must pay!"
msgstr "Сопротивление заплатит за всё!"

#. ja: コロス…<br>コロス、コロスゥゥ！
#. de: Töten! Töööten!
#. fr: Tuer... Tuer<nbsp>! Tueeeer<nbsp>!!!
msgctxt "NpcYell:11353:0:13"
msgid "Kill them! Kill them all!"
msgstr "Убить их! Всех убить!"

#. ja: こ…ここは…<br>嗚呼、皆、どこに…？
#. de: Uh ... Wo sind alle hin?
#. fr: Où... Où suis-je...<nbsp>? Où sont... les... autres...<nbsp>?
msgctxt "NpcYell:11354:0:13"
msgid "Where...where have they all gone?"
msgstr "Куда... куда все делись?"

#. ja: ライアン様ァ…！<br>勝利ヲ、勝利ヲォォ！
#. de: Siiiegen! Für Lyon!
#. fr: Seigneur Lyon<nbsp>! J'arracherai la victoire pour vous<nbsp>!!!
msgctxt "NpcYell:11355:0:13"
msgid "For the Beast King!"
msgstr "За Короля Зверей!"

#. ja: オオォォォ…<br>ライアン様ァァァ！
#. de: Uaaah! Lyooon!
#. fr: Pour le seigneur Lyon<nbsp>!!!
msgctxt "NpcYell:11356:0:13"
msgid "Lyooon!"
msgstr "Лииион!"

#. ja: ラ…イアン…様ァ…<br>ライア…ン…サ…
#. de: Lyon ... Lyon ...
#. fr: Sei... Seigneur Lyon... Je...
msgctxt "NpcYell:11357:0:13"
msgid "Lyon...sir..."
msgstr "Лион... господин..."

#. ja: 十字鍬通りに用意した素材で、<br>ぬいぐるみを組み立ててもらうぞ！　くぽ！
#. de: Die Aufgabe lautet, aus den bereit<shy>ge<shy>stellten Materialien am Kreuzkarst-Spalier Stofftiere zu nähen! Kupo!
#. fr: Servez-vous des matériaux pour fabriquer des peluches, kupo<nbsp>!
msgctxt "NpcYell:11358:0:13"
msgid "Your task is to make stuffed toys using the materials laid out on the Mattock, kupo."
msgstr "Ваша задача — сшить игрушки из материалов, приготовленных на Мотыге, купо."

#. ja: 組み立てた「ぬいぐるみ」を、<br>蒼天街中心の荷車まで運んだらゴール！
#. de: Die fertigen Plüschwunder müssen dann an einem der beiden Wagen am zentralen Platz des Kreuzkarst-Spaliers abgeliefert werden.
#. fr: Lorsque vous aurez terminé une peluche, déposez-la dans une des charrettes sur la place centrale, kupo<nbsp>!
msgctxt "NpcYell:11359:0:13"
msgid "Once you've finished sewing together a toy, take it to a wain at the central plaza."
msgstr "Когда закончите шить игрушку, отнесите её к телеге на центральной площади."

#. ja: 多くのぬいぐるみを作って、<br>たっくさん運んでくれ！　くぽ！
#. de: Stellt fleißig Plüsch-Mogrys her und bringt sie zu einem Wagen! Kupo!
#. fr: Plus vous chargerez de peluches, plus les enfants d'Ishgard seront contents, kupo<nbsp>!
msgctxt "NpcYell:11360:0:13"
msgid "Make lots of stuffed toys and deliver them all, kupo!"
msgstr "Сшейте побольше игрушек и отнесите их все, купо!"

#. ja: 巨大ぬいぐるみ祭り、楽しんでいただけましたか？<br>次の催しは「ヤクの毛刈り競争」……詩伯門前で開催です！
#. de: Ich hoffe, du hattest ordentlich Spaß mit der Stofftierparade!<br>Das nächste Fête findet an der Balladenpassage statt: Yak-Scheren mit der Ätherschere!
#. fr: Alors, vous avez aimé fabriquer toutes ces peluches moelleuses<nbsp>? La prochaine feste “Y a qu'à tondre<nbsp>!” va commencer devant la porte des Industrieux<nbsp>!
msgctxt "NpcYell:11361:0:13"
msgid "We hope you enjoyed that veritable parade of oversized stuffed toys. The next fête is “Shear-a-Yak,” and it will be held at Bright Ballad's Passage!"
msgstr "Надеемся, вам понравился парад огромных мягких игрушек. Следующая феста — «Яковая стрижка» — пройдёт у Прохода Светлой баллады!"

#. ja: 「ヤクの毛刈り競争」で使うのは「エーテルクリッパー」……。<br>スカイスチール機工房製のエーテルオーガーの改良品です！
#. de: Die Ätherschere ist eine Weiterentwicklung des Ätherschütz und eignet sich hervorragend, um Yaks von ihrer wunderbar weichen Wolle zu befreien!
#. fr: Pour cette feste, vous devrez tondre un yak avec une éthérotondeuse, une version améliorée du perforateur éthéréen<nbsp>!
msgctxt "NpcYell:11362:0:13"
msgid "Though you'll be shearing a yak in this fête, instead of shears, you'll be using an enhanced version of the aetheromatic auger: the aetheromatic clipper!"
msgstr "На этой фесте вам предстоит стричь яка не ножницами, а усовершенствованной версией эфирного бура — эфирной машинкой для стрижки!"

#. ja: 通常濃度のエーテルでも起動可能に調整したことで、<br>ヤクの毛刈りに最適な、魔法の風を起こすことができるんですよー！
#. de: Die Ätherschere operiert mit normalem Äther und feuert Stöße ätherreichen Windes auf die Yaks, deren feines Fell wie von Zauberhand abfällt! Yak-Scheren war nie einfacher und lustiger!
#. fr: Elle a été conçue pour fonctionner dans des con<shy>cen<shy>tra<shy>tions d'éther normales et faire tomber la laine sans aucun effort<nbsp>!
msgctxt "NpcYell:11363:0:13"
msgid "Tuned to operate with normal concentrations of aether, it shoots blasts of magicked wind that effortlessly removes fleece from their owners!"
msgstr "Её настроили так, чтобы она работала при обычной концентрации эфира и запускала волшебные порывы ветра, которые легко сдувают с яков шерсть!"

#. ja: ウーリーヤクに、エーテルクリッパーの風を当てて、<br>刈った「ヤクの毛」は、私が3つまとめて受け取ります！
#. de: Benutze die Ätherschere und blas dem Yak das Fell über die Ohren! Wenn du drei Körbe Yak-Wolle gesammelt hast, kannst du sie bei mir abliefern!
#. fr: Utilisez-la donc sur le yak ici présent, et quand vous aurez ramassé trois paniers de sa laine, apportez-les-moi<nbsp>!
msgctxt "NpcYell:11364:0:13"
msgid "So get firing at the yak, and bring the fleece it sheds to me, three sacks full at a time!"
msgstr "Стреляйте по якам, а шерсть, что с них слетит, приносите мне — по три мешка за раз!"

#. ja: 毛刈り競争は、楽しんでいただけましたか？<br>次の催し「ぬいぐるみ集め競争」はアバカス通りで開催です！
#. de: Hoffentlich hat dir das Yak-Scheren bei Yak-o-matik Spaß gemacht!<br>Als nächstes ist eine lustige Spielzeug-Suche in der Allee des Abakus geplant!
#. fr: La tonte est finie<nbsp>! Direction L'Abaque pour la prochaine feste, “La chasse au jouet”<nbsp>!
msgctxt "NpcYell:11365:0:13"
msgid "That's all for “Shear-a-Yak.” Now, please take yourselves to the Abacus for the next fête: “Toy Hunter”!"
msgstr "На этом «Яковая стрижка» закончилась. Теперь отправляйтесь к счётам: следующая феста — «Охотник за игрушками»!"

#. ja: 子分たちが、ぬいぐるみをどれかの箱に隠したよ。<br>プレゼントボックスを開いて、見つけておくれ！
#. de: Finde das verborgene Spielzeug, das meine Ferkel in einem Geschenk versteckt haben! \<grunz>
#. fr: Mes pourceaux ont caché une peluche dans un des paquets cadeaux. À vous de les ouvrir pour la trouver<nbsp>!
msgctxt "NpcYell:11366:0:13"
msgid "My swinelings have hidden a lucky toy in one of three present boxes."
msgstr "Мои поросята спрятали игрушку в одном из трёх подарочных ящиков."

#. ja: 「アタリのぬいぐるみ」が出てきたら、<br>ボクのところにもってきて！
#. de: Nicht alle Geschenkpäckchen enthalten die süßen Glücksmogrys,<br>aber wenn du einen finden solltest, bring ihn mir!
#. fr: Trouvez la peluche gagnante et venez me l'apporter<nbsp>!
msgctxt "NpcYell:11367:0:13"
msgid "You must open the right box to find the toy, and then bring it to me."
msgstr "Откройте нужный ящик, найдите игрушку и принесите её мне."

#. ja: それでは、幸運を祈ってるよ～！
#. de: Viel Spaß, <if $gn4>Jägerin<else>Jäger</if> des versteckten Mogrys! \<grunz> \<grunz>
#. fr: Bonne chance à vous<nbsp>!
msgctxt "NpcYell:11368:0:13"
msgid "Happy toy hunting!"
msgstr "Удачной охоты за игрушками!"

#. ja: ぬいぐるみ集め競争は、楽しんでいただけましたか？<br>最後の催しが、十字鍬通りと中央の広場で開催されます！
#. de: Und, hat dir die Suche Spaß gemacht?<br>Das nächste Fête findet am Platz des Kreuzkarst-Spaliers statt!
#. fr: Alors, la chasse a été bonne<nbsp>? Maintenant, on se dirige vers la place centrale, au Hoyau<nbsp>!
msgctxt "NpcYell:11369:0:13"
msgid "Great hunting, everyone. Now, please make your way to the central plaza on the Mattock!"
msgstr "Отлично поохотились! А теперь отправляйтесь на центральную площадь Мотыги!"

#. ja: 皆さんお待たせしました！<br>最後の催しは「プレゼント配り競争」です！
#. de: Hallo und Willkommen, Freunde!<br>Das vorerst letzte Fête beginnt: Bote der Glückseligkeit!
#. fr: Bienvenue à la feste suivante<nbsp>: “À chacun son cadeau”<nbsp>!
msgctxt "NpcYell:11370:0:13"
msgid "I bid you welcome to the final fête: “Presents of Mind”!"
msgstr "Добро пожаловать на последнюю фесту — «Подарки с умом»!"

#. ja: マスコットからプレゼントを受け取って、<br>十字鍬通りにいる人たちに、配ってきてくださいね！
#. de: Die Aufgabe ist denkbar einfach und doch von großer Herzlichkeit: Überbringe im Auftrag der Maskottchen Geschenke an die Bewohner von Himmelsstadt!
#. fr: Cette fois, vous devrez distribuer des cadeaux à leurs des<shy>ti<shy>na<shy>tai<shy>res en suivant les in<shy>struc<shy>tions des mascottes<nbsp>!
msgctxt "NpcYell:11371:0:13"
msgid "In this fête, you must deliver presents to various folk on the Mattock according to the mascots' instructions."
msgstr "На этой фесте вам предстоит разносить подарки жителям Мотыги, следуя указаниям талисманов."

#. ja: 2箱を配り終えると、別のマスコットが配り先の指示を出します！<br>聞き逃さないように注意してくださいね～！
#. de: Nachdem du zwei Geschenke ausgehändigt hast, wird dir das nächste Maskottchen den Weg weisen. Hör genau zu und lass den Geschenkereigen beginnen!
#. fr: Les des<shy>ti<shy>na<shy>tai<shy>res changent tous les deux cadeaux livrés, donc soyez bien attentifs<nbsp>!
msgctxt "NpcYell:11372:0:13"
msgid "Upon delivering two presents, the mascot issuing the instructions will change, so be sure to pay attention. Let the gifting begin!"
msgstr "После каждых двух подарков указания будет давать уже другой талисман. Будьте внимательны — и пусть раздача начнётся!"

#. ja: これにて「Fête」は、すべて終了となります。<br>またの開催をお待ちください～！
#. de: Damit wären alle Fêtes beendet!<br>Aber vor dem Fête ist nach dem Fête! Wir hoffen dich schon bald wieder begrüßen zu dürfen!
#. fr: Nous espérons que vous avez apprécié et que vous rejouerez avec nous. À très bientôt<nbsp>!
msgctxt "NpcYell:11373:0:13"
msgid "It's farewell for now, but we look forward to seeing you again! Till next time!"
msgstr "Пока прощаемся, но будем рады увидеться вновь! До новых встреч!"

#. ja: よし、素材はここに…
#. de: Die Materialien kommen hierher ...
#. fr: Un instant, les matériaux seront bientôt prêts<nbsp>! Kupo<nbsp>!
msgctxt "NpcYell:11374:0:13"
msgid "Nothing up my sleeves─save my muscular arms─and presto! We have materials!"
msgstr "Ничего в рукавах — кроме моих могучих рук — и вуаля! Материалы готовы!"

#. ja: くっ…身体が…
#. de: Das sieht man nicht alle Tage.
#. fr: En plein dans le buffet...
msgctxt "NpcYell:11375:0:13"
msgid "I'll feel that in the morning..."
msgstr "Утром всё тело будет болеть..."

#. ja: な、なにが起こったのやら…
#. de: Was geht hier vor sich?!
#. fr: Sapristi<nbsp>!
msgctxt "NpcYell:11376:0:13"
msgid "Was that...? What was that!?"
msgstr "Что это было?.. Что это вообще было!?"

#. ja: 皆、参加ありがとな！
#. de: Danke für die rege Teilnahme!
#. fr: Merci à tous d'avoir participé, kupo<nbsp>!
msgctxt "NpcYell:11377:0:13"
msgid "Thanks for taking part, kupo!"
msgstr "Спасибо, что участвовали, купо!"

#. ja: 準備をするから<br>待っててくださいねー！
#. de: Wir bereiten gerade alles vor ...<br>Bitte warte noch einen Moment. Es geht gleich los, kupo!
#. fr: Un peu de patience, on a bientôt fini de tout préparer<nbsp>!
msgctxt "NpcYell:11378:0:13"
msgid "Just a moment while we prepare."
msgstr "Подождите немного, пока мы всё приготовим."

#. ja: モーグリさん<br>「くぽ」を忘れてる……
#. de: Ich sollte mir vielleicht auch sowas wie ein „Kupo“ ausdenken ...
#. fr: Hmmm, je me demande si un Mog doit terminer toutes ses répliques par “kupo”...
msgctxt "NpcYell:11379:0:13"
msgid "Hm, perhaps I need a speech quirk like “kupo” as well..."
msgstr "Хм, может, и мне придумать себе словечко вроде «купо»?"

#. ja: 暴力…反対ですぞ…
#. de: Ich bin gegen jede Form von Gewalt. <i>Fast</i> jede.
#. fr: La violence, c'est mal<nbsp>!
msgctxt "NpcYell:11380:0:13"
msgid "Violence...is not the answer..."
msgstr "Насилие... ничего не решит..."

#. ja: 雑魚は片付いたぜ？
#. de: Die wären erledigt.
#. fr: On est débarrassés du menu fretin<nbsp>?
msgctxt "NpcYell:11381:0:13"
msgid "That all ya got?"
msgstr "Это всё, на что вы способны?"

#. ja: 指差し確認！<br>風向き、風速、オーケー！
#. de: Visier: Check. Windstärke: Check. Seitenwind: Check!<br>Alles klar, kann losgehen!
#. fr: Direction du vent, OK<nbsp>! Vitesse du vent, OK<nbsp>! Les conditions sont idéales<nbsp>!
msgctxt "NpcYell:11382:0:13"
msgid "Wind direction─check. Wind speed─check. Everything is in order!"
msgstr "Направление ветра — проверено. Скорость ветра — проверена. Всё в порядке!"

#. ja: お待たせしました！　競争の始まりです！
#. de: Möge das Fête beginnen!
#. fr: Merci de votre patience, la feste va commencer<nbsp>!
msgctxt "NpcYell:11383:0:13"
msgid "Thank you for your patience! The fête will now begin!"
msgstr "Спасибо за терпение! Феста начинается!"

#. ja: ウーリーヤクちゃん<br>すっきりしたみたい！
#. de: Haha, unser Yak sieht wie neu geboren aus!
#. fr: On dirait que notre ami laineux est satisfait de sa nouvelle coupe<nbsp>!
msgctxt "NpcYell:11384:0:13"
msgid "Heh heh, our wooly friend looks like a new yak!"
msgstr "Хе-хе, наш шерстяной друг будто заново родился!"

#. ja: 次は僕と子分たちの<br>催しだぁ！
#. de: Jetzt sind ich und meine Ferkel an der Reihe! \<grunz>
#. fr: Maintenant, c'est à moi et à mes petits pourceaux de nous mettre au travail<nbsp>!
msgctxt "NpcYell:11385:0:13"
msgid "Now it's time for me and my swinelings to get to work!"
msgstr "Теперь мы с поросятами за дело примемся!"

#. ja: ヤクの毛の後片づけは<br>任せろ、くぽ！
#. de: Wir kommen nach, sobald wir hier aufgeräumt haben.
#. fr: Faites-moi confiance, je m'occupe de nettoyer, kupo<nbsp>!
msgctxt "NpcYell:11386:0:13"
msgid "My massive muscles will make short work of the tidying up."
msgstr "Уборку оставьте моим могучим мышцам, купо!"

#. ja: さぁ子分たち、用意はいい？
#. de: Also, meine Ferkelchen. Zeit, die Geschenke zu verstecken!
#. fr: Vous êtes prêts, mes pourceaux<nbsp>?
msgctxt "NpcYell:11387:0:13"
msgid "It's time to hide the toy."
msgstr "Пора прятать игрушку!"

#. ja: 箱の中にぬいぐるみを隠すんだ…！
#. de: Auf geht es! Und die Glücks-Mogrys nicht vergessen!
#. fr: C'est le moment de cacher la peluche<nbsp>!
msgctxt "NpcYell:11388:0:13"
msgid "Are you ready, my swinelings?"
msgstr "Ну что, поросята, готовы?"

#. ja: まかせろい！
#. de: Überlass das nur uns, große Wutz!
#. fr: Plus prêt que jamais<nbsp>!
msgctxt "NpcYell:11389:0:13"
msgid "Are we ever!?"
msgstr "Ещё как готовы!"

#. ja: じゃあ、持ち場に移動して！
#. de: Ich warte am vereinbarten Ort.
#. fr: Allez, qu'est-ce qu'on attend<nbsp>?
msgctxt "NpcYell:11390:0:13"
msgid "Go forth, then!"
msgstr "Тогда вперёд!"

#. ja: はーい…
#. de: Alles klar!
#. fr: Euh... Ou-oui...
msgctxt "NpcYell:11391:0:13"
msgid "Yes, yes..."
msgstr "Да-да..."

#. ja: がんばる～
#. de: Juhuu!
#. fr: J-je vais faire de mon m-mieux...
msgctxt "NpcYell:11392:0:13"
msgid "Er, I-I suppose..."
msgstr "Э-э... П-пожалуй..."

#. ja: しまったくぽ！
#. de: Oha ... Kupo!
#. fr: Mince, kupo<nbsp>!
msgctxt "NpcYell:11393:0:13"
msgid "Speech quirks are for the weak...kupo."
msgstr "Словечки — для слабаков... купо."

#. ja: みんな、おつかれさま～！
#. de: Auf zur letzten Runde, Freunde!
#. fr: Bon travail tout le monde<nbsp>!
msgctxt "NpcYell:11394:0:13"
msgid "This is it, everyone─the final fête."
msgstr "Вот и всё, друзья — последняя феста!"

#. ja: 俺たち全員が参加するぜ！
#. de: Diesmal machen alle Maskottchen mit!
#. fr: Cette fois-ci, toutes les mascottes sont de la partie, kupo<nbsp>!
msgctxt "NpcYell:11395:0:13"
msgid "We mascots are all taking part this time."
msgstr "На этот раз участвуем мы, все талисманы!"

#. ja: 最後まで楽しんでいって<br>くださいね！
#. de: Und wir hoffen, dass ihr auch alle mit von der Partie seid!
#. fr: On espère que vous vous amuserez jusqu'au bout<nbsp>!
msgctxt "NpcYell:11396:0:13"
msgid "Have fun with us till the end!"
msgstr "Веселитесь с нами до самого конца!"

#. ja: さて、いよいよ最後の「Fête」です！<br>マスコットの皆さん、準備は万端ですか？
#. de: Das Fête geht los! Seid ihr alle bereit, Maskottchen!?
#. fr: C'est l'heure de la dernière feste<nbsp>! Tout le monde est prêt<nbsp>?
msgctxt "NpcYell:11397:0:13"
msgid "The final fête is upon us. Are you ready, my dear mascots?"
msgstr "Вот и настала последняя феста. Ну что, дорогие талисманы, готовы?"

#. ja: 任せてくれくぽ！
#. de: Bereit und bereiter, kupo!
#. fr: Oui oui, kupo<nbsp>!
msgctxt "NpcYell:11398:0:13"
msgid "Hear, hear, kupo!"
msgstr "Мы готовы, купо!"

#. ja: 最後まで楽しみましょう！
#. de: Vom Kamm bis zum Purzel!
#. fr: Oh que oui<nbsp>!
msgctxt "NpcYell:11399:0:13"
msgid "Yes, ma'am!"
msgstr "Да, госпожа!"

#. ja: もっと遊びたーい！
#. de: \<grunz> \<grunz> \<quiek>
#. fr: On va bien s'amuser<nbsp>!
msgctxt "NpcYell:11400:0:13"
msgid "Huzzah!"
msgstr "Ура!"

#. ja: 最後まで盛り上げていきましょうね！
#. de: Dann auf die Positionen!
#. fr: Il faut finir en beauté<nbsp>!
msgctxt "NpcYell:11401:0:13"
msgid "Let us finish on a high note!"
msgstr "Давайте закончим на высокой ноте!"

#. ja: 筋肉をあたためて<br>待っていてくれ！
#. de: Bis zum nächsten Mal!<br>Und immer schön geschmeidig bleiben!
#. fr: Préparez vos muscles, kupo<nbsp>!
msgctxt "NpcYell:11402:0:13"
msgid "Keep your muscles limber, kupo!"
msgstr "Разомните мышцы, купо!"

#. ja: 楽しんでくれましたかー？
#. de: Ich hoffe, es hat dir genauso viel Spaß gemacht wie uns!
#. fr: Alors, vous avez trouvé ça amusant<nbsp>?
msgctxt "NpcYell:11403:0:13"
msgid "We hope you had as much fun as we did!"
msgstr "Надеемся, вам было так же весело, как и нам!"

#. ja: また遊びにきてねー！
#. de: Schau bald wieder vorbei!
#. fr: Il faudra remettre ça<nbsp>!
msgctxt "NpcYell:11404:0:13"
msgid "Please play with us again!"
msgstr "Приходите играть с нами ещё!"

#. ja: 来るぞ！
#. de: Sie greifen an!
#. fr: Ils arrivent<nbsp>!
msgctxt "NpcYell:11405:0:13"
msgid "Brace yourself."
msgstr "Приготовьтесь."

#. ja: もう一体も破壊する！
#. de: Fast geschafft!
#. fr: À ton tour<nbsp>!
msgctxt "NpcYell:11406:0:13"
msgid "One to go!"
msgstr "Остался один!"

#. ja: チッ…数が多いな
#. de: Verdammt, sind das viele!
#. fr: Ça fait beaucoup...
msgctxt "NpcYell:11407:0:13"
msgid "Nuts. That's a lotta metal mooks."
msgstr "Чтоб их... Да тут целая куча железяк!"

#. ja: この攻撃は危険だ
#. de: Vorsicht, das sieht gefährlich aus.
#. fr: Cette botte s'annonce redoutable...
msgctxt "NpcYell:11408:0:13"
msgid "This one's going to hurt."
msgstr "Будет больно."

#. ja: あぁ…
#. de: Sieht so aus.
#. fr: Hm...
msgctxt "NpcYell:11409:0:13"
msgid "Hm."
msgstr "Хм."

#. ja: この昇降機<br>頂上まで続いているようですね
#. de: Dieser Aufzug scheint bis ganz nach oben zu fahren, was?
#. fr: Cette plateforme devrait nous mener au sommet.
msgctxt "NpcYell:11410:0:13"
msgid "Looks like this goes all the way up."
msgstr "Похоже, эта штука поднимается до самого верха."

#. ja: 死ネ…
#. de: Steeerbt!
#. fr: Crève...
msgctxt "NpcYell:11411:0:13"
msgid "Die!"
msgstr "Умри!"

#. ja: 退ケ…
#. de: Blut ... soll fließen ...
#. fr: Arrière, vermine...
msgctxt "NpcYell:11412:0:13"
msgid "Ugh!"
msgstr "Ух!"

#. ja: 蹴散ラス…
#. de: Keine ... Gnaaade!
#. fr: Fuyez ou mourez...
msgctxt "NpcYell:11413:0:13"
msgid "Miserable curs!"
msgstr "Жалкие псы!"

#. ja: 蒼天街復興祝祭を盛り上げる「Fête」がまもなく始まります～！<br>職人さんたちは、詩伯門前に集まってくださいな！
#. de: Höret, höret! Die Fêtes mögen beginnen!
#. fr: Dans le cadre de la Grande Célébration d'Azurée, les festes vont bientôt commencer<nbsp>! Rendez-vous devant la porte des Industrieux<nbsp>!
msgctxt "NpcYell:11414:0:13"
msgid "Hear ye, hear ye! Fêtes are about to commence!"
msgstr "Слушайте, слушайте! Скоро начнутся праздничные игры!"

#. ja: 本日は、蒼天街復興祝祭の「Fête」へご参加いただき、<br>まことにありがとうございます～！
#. de: Halone zum Gruße, Freunde! Und willkommen beim Himmelsfest!
#. fr: <if ($gn11 < 12)><if ($gn11 < 4)>Bonsoir<else>Bonjour</if><else><if ($gn11 < 17)>Bonjour<else>Bonsoir</if></if>, et bienvenue à tous<nbsp>! Merci de votre par<shy>ti<shy>ci<shy>pa<shy>tion aux festes de la Grande Célébration d'Azurée<nbsp>!
msgctxt "NpcYell:11415:0:13"
msgid "Greetings, friends, and thank you for joining in the Skyrise Celebration!"
msgstr "Приветствую, друзья! Спасибо, что пришли на праздник Небоскрёба!"

#. ja: ハルディボイルド殿！<br>参りますぞ…！
#. de: Hildibrüh! Ich kooomme!
#. fr: C'est parti, Monsieur Hildibrut<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11416:0:13"
msgid "Of course, Detective!<br>Our moment is come!"
msgstr "Конечно, детектив!<br>Наш час настал!"

#. ja: チッ…
#. de: Tsk<nbsp>...
#. fr: Tssk...
msgctxt "NpcYell:11417:0:13"
msgid "Hmph..."
msgstr "Хм..."

#. ja: では、盛り上げてくれるマスコットたちを紹介しながら、<br>最初の「Fête」とまいりましょう～！
#. de: Wir haben eine Reihe von Fêtes zur Unterhaltung organisiert. Das erste soll uns dazu dienen, unsere freundlichen Maskottchen vorzustellen!
#. fr: La première feste sera l'occasion de vous présenter à tous les adorables mascottes qui nous ac<shy>com<shy>pa<shy>gnent pour les festivités<nbsp>!
msgctxt "NpcYell:11418:0:13"
msgid "Today, we will be hosting a variety of fêtes─the first of which serves as an introduction to our friendly team of mascots."
msgstr "Сегодня у нас целая череда праздничных игр. И первая из них — знакомство с нашей дружной командой талисманов!"

#. ja: 俺は、「ぬいぐるみ組立競争」を担当する、<br>筋肉自慢ムキムキモーグリ……くぽ！
#. de: Muskelmacker-Mogry zu Diensten! Bestaunt meine mächtig starken Muskeln! Doch mein Herz schlägt noch stärker für kuschelige Stofftiere! Kupo!
#. fr: Je suis le Mog musculeux, et c'est moi qui m'occupe de la feste “La fabrique à peluches”<nbsp>! Euh... kupo<nbsp>!
msgctxt "NpcYell:11419:0:13"
msgid "Mighty Moogle, at your service, kupo. Made of sterner stuff though I am, I'm in charge of the fête “Made of Softer Stuff”!"
msgstr "Могучий могур к вашим услугам, купо! Хоть я и сам крепкий орешек, отвечаю за игру «Плюшевое дело»!"

#. ja: 私はモフモフ好きのモフモフチョコボ！<br>機工装置を使った「ヤクの毛刈り競争」を担当します！
#. de: Plüschpuschel-Chocobo werde ich genannt und bin für das lustige Spiel „Yak-o-matik“ weithin bekannt! Bei mir fliegen flauschige Fellfetzen, Freunde!
#. fr: Et moi, le chocobo chatoyant<nbsp>! J'aurai le plaisir de vous accompagner pour la feste “Y a qu'à tondre<nbsp>!”, j'ai hâte<nbsp>!
msgctxt "NpcYell:11420:0:13"
msgid "Chirpy Chocobo is my name, and “Shear-a-Yak” is my game. Under my fluffy wing, you will shear as you've never shorn before!"
msgstr "Я — чирикающий чокобо, а моя игра — «Яковая стрижка»! Под моим пушистым крылом вы сострижёте шерсти больше, чем когда-либо!"

#. ja: 僕はクルクルポーキーだよ！<br>三匹の子分たちと「ぬいぐるみ集め競争」を担当するねぇ～！
#. de: Und ich bin Kullerkringel-Grunzi! Jäger des versteckten Mogrys und grunzender Abenteurer! Meine treue Schar Ferkel ist mir stets zu Diensten!
#. fr: Me voici, le porcelet polisson<nbsp>! Avec mes petits pourceaux adorés, j'organise la feste “La chasse au jouet”. On va bien s'amuser<nbsp>!
msgctxt "NpcYell:11421:0:13"
msgid "And last but definitely not least, I am Perky Piggy. My swinelings and I look forward to making a “Toy Hunter” out of you!"
msgstr "А я — бойкий поросёнок! Мы с моими поросятками превратим вас в настоящих «Охотников за игрушками»!"

#. ja: そして最後にもうひとつ、催しを用意しています。<br>全部で5つの「Fête」、楽しんでいってくださいね！
#. de: Haha, was für ein lustiges Trio! Sie werden unsere teuren Gäste durch die Festlichkeiten begleiten. Und damit wären wir auch schon bei dem ersten Fête!
#. fr: Souvenez-vous bien de ces mascottes, car vous aurez affaire à elles tout au long des cinq festes que nous vous proposons. Et maintenant, que le spectacle commence<nbsp>!
msgctxt "NpcYell:11422:0:13"
msgid "Remember these mascots well, for they will be your guides throughout the revelry. On which note, let us dive into the fête!"
msgstr "Запомните наших талисманов: они будут сопровождать вас на празднике. Ну что ж, давайте начинать!"

#. ja: ではさっそく、マスコットたちが得意なポーズで呼びかけるので、<br>同じポーズで応えてあげてくださいな！
#. de: Unsere Maskottchen werden euch eine Reihe von Posen vorführen und es ist an euch, diese nachzuahmen.
#. fr: Nos chères mascottes vont prendre leur pose favorite, chacune leur tour<nbsp>! Soyez attentifs et imitez-les du mieux que vous pourrez<nbsp>!
msgctxt "NpcYell:11423:0:13"
msgid "The mascots will take turns striking their favorite poses, and we ask that you show your celebratory spirit by posing in kind."
msgstr "Наши талисманы по очереди будут принимать любимые позы. Покажите свой праздничный задор и повторяйте за ними!"

#. ja: 準備はいいですか～？
#. de: Seid ihr bereit?
#. fr: Tout le monde est prêt<nbsp>?
msgctxt "NpcYell:11424:0:13"
msgid "Are you ready?"
msgstr "Все готовы?"

#. ja: みんな、筋肉はあたたまってるか！？
#. de: Hier eine muskulöse Pose, die jeden Hantelschwinger vor Neid erblassen lässt!
#. fr: Alors mes petits culturistes, j'espère que vos muscles sont bien chauds<nbsp>?
msgctxt "NpcYell:11425:0:13"
msgid "Here is a pose that maximizes your muscular appeal."
msgstr "А вот поза, которая выгодно подчеркнёт ваши мускулы!"

#. ja: みんなも、俺と同じポーズで、<br>その「ムキムキポーズ」で肉体美を見せてくれ……くぽ！
#. de: Zeigt die Pose <i>Maximum Muskelmasse</i> und beweist, dass ihr Eisen statt Wackelpudding im Bizeps habt! Kupo!
#. fr: Montrez-moi de quoi vous êtes capables avec une “Méga musculation” bien sentie<nbsp>!<nbsp>... Kupo<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11426:0:13"
msgid "Do the <i>mighty maximizer</i>, and show the fine specimen that you are, kupo!"
msgstr "Покажите «<i>Плюшевое дело</i>» и свою великолепную форму, купо!"

#. ja: アタシは休ませてもらうよ
#. de: Zeit für ein kleines Nickerchen<nbsp>...
#. fr: C'est l'heure de la sieste...
msgctxt "NpcYell:11427:0:13"
msgid "A nap sounds heavenly..."
msgstr "Эх, вот бы вздремнуть..."

#. ja: 毛刈り競争で使うエーテルクリッパーは、<br>放つ前の指さし確認が大切ですよー。
#. de: Bevor ihr die Ätherschere auf ein Yak loslasst, empfiehlt sich eine Sicherheitsüberprüfung.
#. fr: Avant d'utiliser un appareil aussi puissant que l'éthérotondeuse, il est primordial de montrer sa cible du doigt. Question de sécurité<nbsp>!
msgctxt "NpcYell:11428:0:13"
msgid "Before using the aetheromatic clipper, it is important to point and acknowledge."
msgstr "Перед тем как стрелять из эфироножниц, обязательно укажите на цель и проверьте её."

#. ja: ちゃーんと「モフモフポーズ」で確認するんですよー！
#. de: Genau dafür habe ich eine praktische Pose entwickelt: Den <i>Puschel-Check</i>!
#. fr: Pour ça, rien de mieux que la “Choco-désignation”, alors à vous de jouer<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11429:0:13"
msgid "To that end, we do the <i>chirpy checker</i>!"
msgstr "Для этого у нас есть поза «<i>Чирикающий чокобо</i>»!"

#. ja: まだ終わってないのかい…？
#. de: Immer noch nicht fertig?
#. fr: Toujours pas terminé<nbsp>?
msgctxt "NpcYell:11430:0:13"
msgid "This ordeal is still going?"
msgstr "И долго ещё это будет продолжаться?.."

#. ja: みんな、お宝を探すときはよく目をこらすでしょ？
#. de: Ein echter Jäger des verlorenen Mogrys hat neben einem Peitschenpurzel auch ein scharfes Auge!
#. fr: Quand on cherche un trésor, on ouvre l'œil et on fait attention aux alentours, n'est-ce pas<nbsp>?
msgctxt "NpcYell:11431:0:13"
msgid "When searching for treasure, one must keep one's eyes peeled."
msgstr "Когда ищешь сокровища, надо смотреть в оба."

#. ja: 僕と同じ「クルクルポーズ」で見回してねぇ！
#. de: Ahmt den <i>Grunz-Glubscher</i> nach und die Schätze der Welt tun sich euch auf!
#. fr: Comme moi, faites donc preuve de “Précaution porcine”<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11432:0:13"
msgid "To help you practice, I bid you do the <i>perky peeler</i> with me!"
msgstr "А чтобы потренироваться, повторяйте за мной позу «<i>Бойкий поросёнок</i>»!"

#. ja: ここからは順番がバラバラになりま～す！
#. de: Los geht's! Ahmt die Posen der Maskottchen nach!
#. fr: À partir de maintenant, plus d'ordre défini, les mascottes prennent la pose comme il leur plaît<nbsp>!
msgctxt "NpcYell:11434:0:13"
msgid "Hereon, the order will be random."
msgstr "А теперь талисманы будут появляться в случайном порядке!"

#. ja: エーテルクリッパーを撃つ前に、「モフモフポーズ」で確認！
#. de: Der <i>Puschel-Check</i> sorgt für Sicherheit!
#. fr: Avant de tirer avec l'éthérotondeuse, ne jamais oublier la “Choco-désignation”<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11435:0:13"
msgid "Before using the aetheromatic clipper, point and acknowledge with the <i>chirpy checker</i>!"
msgstr "Перед выстрелом из эфироножниц не забудьте указать на цель и проверить её позой «<i>Чирикающий чокобо</i>»!"

#. ja: みんな、お宝を探して「クルクルポーズ」をしよー！
#. de: Bei der Suche nach Mogrys ist der <i>Grunz-Glubscher</i> unabdingbar! \<grunz>
#. fr: Pour une chasse au trésor réussie, toujours commencer avec un peu de “Précaution porcine”<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11436:0:13"
msgid "When searching for treasure, keep your eyes peeled with the <i>perky peeler</i>!"
msgstr "Ищете сокровища? Смотрите в оба с позой «<i>Бойкий поросёнок</i>»!"

#. ja: 皆のあたたまった筋肉を「ムキムキポーズ」を自慢してくれ……くぽ！
#. de: Und um zu zeigen, was für tolle Sportskanonen ihr seid, trumpft ab und an mit <i>Maximum Muskelmasse</i> auf! Kupo!
#. fr: Pour toujours avoir les muscles bien chauds, rien de mieux que la “Méga-musculation”, kupo<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11437:0:13"
msgid "Show the fine specimen that you are with the <i>mighty maximizer</i>, kupo!"
msgstr "Покажите свою великолепную форму с позой «<i>Плюшевое дело</i>», купо!"

#. ja: 皆さん、マスコットたちの姿は覚えられましたか～？<br>それではそろそろ、次の「Fête」へまいりましょう！
#. de: Gut! Damit sollten dann hoffentlich alle mit unseren drei Maskottchen vertraut sein!
#. fr: Vous avez bien fait con<shy>nais<shy>san<shy>ce avec nos charmantes mascottes<nbsp>? Dans ce cas, passons à la feste suivante<nbsp>!
msgctxt "NpcYell:11438:0:13"
msgid "I trust you are now acquainted with our friendly mascots. With that, let us move right along to the next fête."
msgstr "Надеюсь, вы уже познакомились с нашими талисманами. А теперь перейдём к следующей праздничной игре!"

#. ja: 次の催しは「ぬいぐるみ組立競争」！<br>十字鍬通りで、ムキムキモーグリが待ってるよ！
#. de: Unser Muskelmacker-Mogry erwartet euch nun am Kreuzkarst-Spalier für das Fête „Stoff der Träume“!
#. fr: Il s'agit de “La fabrique à peluches”, et ça se passe au Hoyau<nbsp>!
msgctxt "NpcYell:11439:0:13"
msgid "Mighty Moogle, whose big muscles are equaled only by his big heart, awaits you on the Mattock for “Made of Softer Stuff”!"
msgstr "Могучий могур, у которого сердце под стать мышцам, ждёт вас на Мотыге. Игра называется «Плюшевое дело»!"

#. ja: ぬいぐるみ組立競争も<br>参加よろしく、くぽ！
#. de: Muskelmacker-Mogry! Kupo!
#. fr: Suivez-moi tout en muscles, kupo<nbsp>!
msgctxt "NpcYell:11440:0:13"
msgid "My turn to shine, kupo!"
msgstr "Теперь моя очередь блистать, купо!"

#. ja: さあさあ、移動しましょー！
#. de: Auf geht's!
#. fr: Allez, on y va tous ensemble<nbsp>!
msgctxt "NpcYell:11441:0:13"
msgid "Here we go!"
msgstr "Ну, пошли!"

#. ja: 行くぞー！
#. de: \<grunz>
#. fr: C'est partiii<nbsp>!
msgctxt "NpcYell:11442:0:13"
msgid "Yaaargh!"
msgstr "Р-р-р-а-а!"

#. ja: 我が名はパガガ！<br>バックスタインの名を継ぎしビーストマスターだッ！
#. de: Ich bin Pagaga, allergrößte Bestienbändigerin aus dem Hause Vochstein!
#. fr: Je me nomme Pagaga<nbsp>! Vous avez devant vous l'héritière du nom de Vochstein<nbsp>!
msgctxt "NpcYell:11443:0:13"
msgid "I am Pagaga, beastmaster of the proud line of Vochstein!"
msgstr "Я Пагага, укротитель из гордого рода Вохштейн!"

#. ja: この日のために育ててきた友と、<br>戦うだけの勇気がある者がいるなら前に出よッ！
#. de: Wenn es jemanden gibt, der es mit mir und meinen Freunden aufnehmen will, soll er vortreten! Er wird ein köstliches Mahl abgeben!
#. fr: J'ai entraîné mes fidèles compagnons sans relâche pour vous affronter aujourd'hui<nbsp>! Avancez, si vous osez nous affronter<nbsp>!
msgctxt "NpcYell:11444:0:13"
msgid "Are there any out there with stones enough to face me and my pets!?"
msgstr "Есть тут смельчаки, готовые сразиться со мной и моими питомцами?!"

#. ja: ハッハッハッ……貴様が相手をすると？<br>よかろう、正々堂々と勝負だッ！
#. de: Ihr? Hahaha! Erlaubt mir, dass ich mich schieflache! Das wird kein Kampf, das wird ein Gemetzel!
#. fr: HA HA HAAA<nbsp>!!! Vous ne devez pas tenir à la vie<nbsp>! Mais que les meilleurs gagnent<nbsp>!
msgctxt "NpcYell:11445:0:13"
msgid "...You lot? Ahahaha! I was expecting something a little sterner, but very well! Let's see how you fare!"
msgstr "...Вы, что ли? Ха-ха-ха! Я ждала кого-нибудь посерьёзнее, но ладно! Посмотрим, на что вы способны!"

#. ja: ベルダJr.、オブダJr.！<br>お前たちの力を、奴らに見せつけてやるんだッ！
#. de: Los, meine Kleinen! Stürzt euch auf euer Fresschen!
#. fr: Berda et Obda junior<nbsp>! Montrez-leur ce que vous savez faire<nbsp>!
msgctxt "NpcYell:11446:0:13"
msgid "Come, Berda! Obda! I've found you some playmates!"
msgstr "За дело, Берда! Обда! Я нашла вам товарищей для игр!"

#. ja: キュイーッ！
#. de: Kräää!
#. fr: Cuiii<nbsp>!!!
msgctxt "NpcYell:11447:0:13"
msgid "Screech! Screeeeeech!"
msgstr "Визг! Вииизг!"

#. ja: 下がれ、ベルダJr.！　無理をするなッ！
#. de: Zurück, kleine Berda! Überanstreng dich nicht.
#. fr: Recule Berda junior<nbsp>! N'en fais pas trop non plus<nbsp>!
msgctxt "NpcYell:11448:0:13"
msgid "That'll do, Berda! That'll do!"
msgstr "Хватит, Берда! Довольно!"

#. ja: 撤退だ、オブダJr.！　戦死は許さんッ！
#. de: Lass los, Obda junior! Ich lasse dich nicht sterben.
#. fr: Obda junior<nbsp>! Je t'interdis de mourir<nbsp>! À la niche<nbsp>!
msgctxt "NpcYell:11449:0:13"
msgid "Away, Obda! I won't have you dying on me!"
msgstr "Отступай, Обда! Не вздумай погибнуть!"

#. ja: なっ……ジュニアたちでさえ敵わないなんてッ……！
#. de: Ich hätte mehr von ihnen erwartet. Aber sie sind ja noch klein.
#. fr: Même Berda et Obda junior n'ont pu vous vaincre<nbsp>!? Graah<nbsp>!
msgctxt "NpcYell:11450:0:13"
msgid "To think that my prized beasts could be bested..."
msgstr "Неужели моих лучших зверей одолели..."

#. ja: 今度こそ、貴様を倒してやるッ！<br>覚えていろッ！
#. de: Das nächste Mal fressen wir euch mit Haut und Haaren, versprochen!
#. fr: J-j-je vous aurai la prochaine fois<nbsp>! Vous m'avez comprise<nbsp>!? Je vous aurai<nbsp>!
msgctxt "NpcYell:11451:0:13"
msgid "Grrr... We'll get you next time! Mark my words!"
msgstr "Гр-р... В следующий раз мы вас одолеем! Вот увидите!"

#. ja: ハッハッハッ……レジスタンスなど、この程度だッ！<br>こんな連中に苦戦するとは、ライアンも老いたものだなッ！
#. de: Hahaha! Mehr haben die Spaßvögel vom Widerstand nicht drauf? Lyon muss alt geworden sein, dass er sich von denen ins Bockshorn jagen ließ.
#. fr: HA HA HAAA<nbsp>!!! Et voilà le travail<nbsp>! Lyon n'est décidément plus qu'un vieux croulant si ces rebelles continuent de lui poser problème<nbsp>!
msgctxt "NpcYell:11452:0:13"
msgid "Hmph, this the best the Resistance's got? Lyon's fallen far to struggle against your ilk."
msgstr "Хм, и это всё, на что способен Сопротивление? Лион совсем сдал, раз его одолевают такие слабаки."

#. ja: キュイィィッ！！
#. de: Kräää!
#. fr: Cui cui cui cuiii<nbsp>! Cui cui, cui cuicuiiii<nbsp>!
msgctxt "NpcYell:11453:0:13"
msgid "Screeeeeech!"
msgstr "Виииизг!"

#. ja: あ、あの異形が<br>仲間の成れの果てだと！？
#. de: Was? Das waren mal unsere Freunde!
#. fr: V-vous voulez dire que ce sont des amis à vous<nbsp>!?
msgctxt "NpcYell:11454:0:13"
msgid "What? These monsters were once your allies!?"
msgstr "Что? Эти чудовища когда-то были вашими союзниками?!"

#. ja: フッ…ググゥ…<br>情け…フッ！
#. de: Uah ... Gnade ... Grrrr!
#. fr: Grrr... Mettre fin...<nbsp>! Graaah<nbsp>!
msgctxt "NpcYell:11455:0:13"
msgid "Grrrgh! Mercy. Graaah!"
msgstr "Гр-р-р! Пощады... Гра-а-а!"

#. ja: 『ああなっては救えない。倒してやるのが情け』と言いたいのね。<br>虎鬚、あなたの意見に賛成よ、ケリをつけてあげましょう。
#. de: Er sagt, dass wir ihnen die letzte Gnade erweisen sollen. Tun wir es.
#. fr: Rien ne pourra plus les sauver. Nous devrions mettre fin à leur souffrance... Je suis d'accord avec toi, Kosyu.
msgctxt "NpcYell:11456:0:13"
msgid "They were once, but they are far past saving. He says killing them would be a mercy. I'm of the same mind, Kosyu─let's end this, and quickly."
msgstr "Когда-то были, но теперь их уже не спасти. Он говорит, что убить их — значит проявить милосердие. Я с тобой согласна, Косю. Давай покончим с этим, и поскорее."

#. ja: キヒッ……レジスタンスどもか……。<br>このオレ、ジルブリスベルが作った傑作を披露させてもらおうか。
#. de: Unwürdige! Ihr verdient es nicht, eure Augen an des großen Gilbrisberts Werk zu laben!
#. fr: Réjouissez-vous, chiens de rebelles. Vous allez contempler le dernier chef-d'œuvre du grand Gilbrisbert.
msgctxt "NpcYell:11457:0:13"
msgid "Impudent rebels. You are hardly worthy to lay eyes upon my masterwork. Grovel for the chance I've afforded you!"
msgstr "Наглые мятежники! Вы недостойны даже взглянуть на моё творение. На колени — и благодарите за такую честь!"

#. ja: さあ、オレの人形よ、華麗なステップで踊ってくれ！
#. de: Tanzt, meine Puppen! Bringt sie mit euren Schritten zum Zittern!
#. fr: En avant, mes marionnettes<nbsp>! Dansez d'un pas léger et exécutez vos anciens alliés<nbsp>!
msgctxt "NpcYell:11458:0:13"
msgid "Now, my puppets, dance and leave the world agog with your grace!"
msgstr "А теперь, мои марионетки, танцуйте! Пусть весь мир восхитится вашей грацией!"

#. ja: 荒ぶる岩石の使い魔よ……！<br>我が命に応えて、レジスタンスどもを押し潰すのだ！
#. de: Erhebt euch, Stein und Fels! Steht uns bei und zerschmettert unsere Feinde!
#. fr: Familliers de roches<nbsp>! Fracassez ces sales rebelles<nbsp>!
msgctxt "NpcYell:11459:0:13"
msgid "O, earth beneath me, heed my call! Rise up and crush these Resistance vermin into so much dust!"
msgstr "О, земля под ногами, услышь мой зов! Восстань и раздави эту мразь из Сопротивления в пыль!"

#. ja: よし、使い魔の状態は良好のようだな。<br>進軍開始……レジスタンスどもを粉砕するぞ！
#. de: Das Familiar gehorcht aufs Wort. Los jetzt, Leute, bringt es zu Ende!
#. fr: Mon familier de glace sera invincible avec tous ces piquants<nbsp>! Mettons en pièces ces rebelles<nbsp>!
msgctxt "NpcYell:11460:0:13"
msgid "It is time to show what you can do, my minion. Go forth and crush the Resistance underfoot!"
msgstr "Покажи, на что способен, мой прислужник! Вперёд, раздави Сопротивление!"

#. ja: なっ…<br>氷の巨人だと！？
#. de: Ein Eisriese? Zu dieser Jahreszeit?
#. fr: Sérieusement<nbsp>!? Un géant de glace<nbsp>!?
msgctxt "NpcYell:11461:0:13"
msgid "What the─? An ice golem!?"
msgstr "Что за... Ледяной голем?!"

#. ja: ええい、迎撃だ！
#. de: Eis ist auch nur gefrorenes Wasser ... Auf ihn!
#. fr: Sus à l'ennemi<nbsp>!
msgctxt "NpcYell:11462:0:13"
msgid "Hmph, we'll shatter it like the ice it is!"
msgstr "Хм! Разобьём его вдребезги, как и положено льду!"

#. ja: よし、充分な戦果だ…
#. de: Das war ganz nach meinem Geschmack.
#. fr: Bien, nous les avons assez amochés...
msgctxt "NpcYell:11463:0:13"
msgid "Yes, a satisfactory showing..."
msgstr "Да, неплохое выступление..."

#. ja: 深追いをする<br>必要はない
#. de: Verschwenden wir hier nicht länger unsere Zeit.
#. fr: Inutile de s'épuiser ici plus longtemps<nbsp>!
msgctxt "NpcYell:11464:0:13"
msgid "We need waste no more time on this rabble."
msgstr "Нечего больше тратить время на эту шваль."

#. ja: 帰還して<br>次の任務に備えるぞ！
#. de: Sparen wir unsere Kräfte für später.
#. fr: Plus vite nous nous serons ravitaillés, plus vite nous pourrons prendre notre revanche<nbsp>!
msgctxt "NpcYell:11465:0:13"
msgid "Let us save our strength for the next mission."
msgstr "Побережём силы для следующего задания."

#. ja: ギギギィィィ…！
#. de: Grrruuua!
#. fr: *Krliiink... Prlink...<nbsp>!*
msgctxt "NpcYell:11466:0:13"
msgid "Graaarrrgggh!"
msgstr "Гра-а-а-р-р!"

#. ja: 痛ってぇな、オイ！<br>相変わらず惚れ惚れするほどの強さだぜッ！
#. de: Aua, das hat weh getan! Fast so wie letztes Mal.
#. fr: Hé hé, mais c'est que ça picotte<nbsp>! Je me lasserai jamais de tes talents<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
#. macro: <if $gn4>woman<else>man</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:11467:0:13"
msgid "Owww, that hurts! Seriously, <split \" \" 1><string $gs1></split>, you're a <if $gn4>woman<else>man</if> after my own heart!"
msgstr "Ай, больно! Ну ты и силач, <split \" \" 1><string $gs1></split>! <if $gn4>Такая женщина<else>Такой мужчина</if> мне по душе!"

#. ja: ハァ、ハァ…<br>力が入らねぇ…
#. de: Puh, ich hab einfach nicht die Kraft ...
#. fr: Pwaaah... J'en... J'en peux plus...<nbsp>!
msgctxt "NpcYell:11468:0:13"
msgid "\\<pant> Bugger me, where did my strength go...?"
msgstr "\\<pant> Чёрт, куда это вся моя сила подевалась?.."

#. ja: 気合入れろッ！<br>負けるんじゃ…ねぇ！
#. de: Ihr sollt kämpfen, nicht verlieren!
#. fr: Qu'est-ce que vous foutez, vous autres<nbsp>! Mettez-y du vôtre aussi<nbsp>!
msgctxt "NpcYell:11469:0:13"
msgid "Fight harder, you lot! Fight harder!"
msgstr "Деритесь усерднее, вы! Ещё усерднее!"

#. ja: 炎の縛めを狙って！
#. de: Zielt auf die Fesseln! Wir müssen sie befreien!
#. fr: Visez les liens enflammés<nbsp>! On doit les libérer !
msgctxt "NpcYell:11470:0:13"
msgid "We must free them! Target the constricting flames!"
msgstr "Надо их освободить! Бейте по огненным путам!"

#. ja: ふわぁ…
#. de: \<seufz>...
#. fr: Haa...
msgctxt "NpcYell:11471:0:13"
msgid "Sigh..."
msgstr "Эх..."

#. ja: 面倒だねぇ
#. de: Wie lange denn noch<nbsp>...
#. fr: Quelle corvée...
msgctxt "NpcYell:11472:0:13"
msgid "This is taking too long..."
msgstr "Ну и долго же это..."

#. ja: まだいるのかい…
#. de: Ihr seid immer noch hier?!
#. fr: Encore là<nbsp>!?
msgctxt "NpcYell:11473:0:13"
msgid "Oh? You're still here?"
msgstr "О? Вы всё ещё здесь?"

#. ja: ギィィィ…！
#. de: Grrruaaa!
#. fr: *Krliiink<nbsp>!*
msgctxt "NpcYell:11474:0:13"
msgid "Graaarrrgggh!"
msgstr "Гра-а-а-р-р!"

#. ja: ようやく現れたな、レジスタンスども……。
#. de: Da sind sie also.
#. fr: *Prscht* Vous voilà enfin<nbsp>!
msgctxt "NpcYell:11475:0:13"
msgid "Resistance scum. Finally, you show yourselves..."
msgstr "Ну наконец-то, мразь из Сопротивления..."

#. ja: さあ、強化兵ダボグ……！<br>改修を加えたデルタ・ガブリエルカイに乗り込むのだ……！
#. de: So, mein neuer Dabog. Mach es dir im Delta Gabriel Kai bequem.
#. fr: Dabog<nbsp>! Fais-moi le plaisir d'embarquer à bord de ce Gabriel delta renforcé<nbsp>!
msgctxt "NpcYell:11476:0:13"
msgid "Come, my new and improved Dabog! Show these fools the power of Delta Gabriel Kai!"
msgstr "Ну же, мой новый и улучшенный Дабог! Покажи этим глупцам, на что способен «Дельта Габриэль Кай»!"

#. ja: あの金色の機体……<br>まさか、あれにダボグさんが乗っているというのですか！？
#. de: Die goldene Flugmaschine da ... Da soll Dabog drin sein?
#. fr: Dabog pilote cette armure magitek dorée<nbsp>!?
msgctxt "NpcYell:11477:0:13"
msgid "It is Dabog inside that golden machina? Gods have mercy..."
msgstr "Дабог внутри той золотой машины? Боги, помилуйте..."

#. ja: ほら、次は向こうだよ
#. de: Und jetzt in die Richtung.
#. fr: Changeons de trajectoire...
msgctxt "NpcYell:11478:0:13"
msgid "Ah, I see we're going this way now."
msgstr "А, теперь мы едем туда."

#. ja: こちら、強化兵ダボグ……<br>攻撃目標を確認……戦闘行動を開始しまス……。
#. de: Hier Magitek-Soldat Dabog. Ziel erfasst. Beginne Angriffssequenz.
#. fr: Ici Dabog... soldat augmenté... Cible confirmée. Début de l'assaut.
msgctxt "NpcYell:11479:0:13"
msgid "This is hyperpilot Dabog. Target confirmed. Commencing combat operations..."
msgstr "Говорит Дабог, гиперпилот. Цель подтверждена. Начинаю боевые действия..."

#. ja: こちら、強化兵ダボグ……<br>機体の損傷を確認……火力不足と判断しまス……。
#. de: Hier Magitek-Soldat Dabog. Melde Schaden. Feuerkraft unzureichend.
#. fr: Ici Dabog... soldat augmenté... Unité endommagée... Puissance de feu insuffisante...
msgctxt "NpcYell:11480:0:13"
msgid "This is hyperpilot Dabog. Hull damage...confirmed. Firepower...below acceptable parameters."
msgstr "Говорит Дабог, гиперпилот. Повреждения корпуса... подтверждены. Огневая мощь... ниже нормы."

#. ja: 遠隔攻撃端末を展開……<br>並列操作によって、全方位攻撃を実行しまス……。
#. de: Fernangriffssystem aktiviert. Angriff aus allen Vektorrichtungen.
#. fr: Déploiement du système d'attaque à distance. Contrôle simultané enclenché. Attaque tous azimuts...
msgctxt "NpcYell:11481:0:13"
msgid "Deploying long-range assault nodes... Initiating omnidirectional attack..."
msgstr "Развёртываю дальнобойные узлы атаки... Начинаю круговую атаку..."

#. ja: 目を覚ましてください……ダボグさん！
#. de: Dabog! Wach auf!
#. fr: Dabog<nbsp>! Je t'en prie<nbsp>! Recouvre tes esprits<nbsp>!
msgctxt "NpcYell:11482:0:13"
msgid "Dabog! Open your eyes!"
msgstr "Дабог! Очнись!"

#. ja: こちら、強化兵ダボグ……<br>機体損傷率上昇……戦闘を続行しまス……。
#. de: Hier Magitek-Soldat Dabog. Melde schwere Schäden. Setze Angriff fort.
#. fr: Ici Dabog... soldat augmenté... Multiples avaries détectées... Poursuite du combat...
msgctxt "NpcYell:11483:0:13"
msgid "This is hyperpilot Dabog. Hull integrity...compromised. Proceeding with combat operations..."
msgstr "Говорит Дабог, гиперпилот. Корпус... повреждён. Продолжаю боевые действия..."

#. ja: そこです！
#. de: Da!
#. fr: Attention<nbsp>!
msgctxt "NpcYell:11484:0:13"
msgid "Gaaah!"
msgstr "А-а-а!"

#. ja: ナメないでくださいッ！
#. de: Unterschätz mich nicht!
#. fr: Ne me sous-estimez pas<nbsp>!
msgctxt "NpcYell:11485:0:13"
msgid "You would do well not to underestimate us!"
msgstr "Не советую нас недооценивать!"

#. ja: 見えたッ！
#. de: Ich sehe es!
#. fr: Je l'ai<nbsp>!
msgctxt "NpcYell:11486:0:13"
msgid "Is that all?"
msgstr "Вот и всё, на что ты способен?"

#. ja: これは…<br>電磁障壁！？
#. de: Eine magnetische Barriere?
#. fr: Un mur magnétique<nbsp>!?
msgctxt "NpcYell:11487:0:13"
msgid "It means to defend itself?"
msgstr "Он что, защищается?"

#. ja: …もっと滑らかに<br>動けないのかい？
#. de: Geht das auch ein bisschen weniger holprig?!
#. fr: Tu ne peux pas tourner moins brusquement<nbsp>!?
msgctxt "NpcYell:11488:0:13"
msgid "Do try and make the ride less bumpy this time."
msgstr "В этот раз хоть помягче рули, ладно?"

#. ja: またうるさいのが来たねぇ…
#. de: Schon wieder solche Störenfriede<nbsp>...
#. fr: Encore des intrus bruyants...
msgctxt "NpcYell:11489:0:13"
msgid "Ugh. Their voices grate on the ears."
msgstr "Уф. Опять эти шумные гости..."

#. ja: 敵戦力低下を確認…<br>任務成功と判断しまス…
#. de: Gegnerischer Widerstand gleich null. Mission erfolgreich.
#. fr: Puissance de feu ennemie grandement réduite...  Succès de la mission confirmée...
msgctxt "NpcYell:11490:0:13"
msgid "Enemy combat capabilities compromised... Mission...successful."
msgstr "Боеспособность противника снижена... Задание... выполнено."

#. ja: なんという火力…<br>皆さん、撤退を！
#. de: Das Ding ist zu heftig! Rückzug!
#. fr: Son... Son armure magitek est trop puissante... Rentrons à la base<nbsp>!
msgctxt "NpcYell:11491:0:13"
msgid "Such firepower! Retreat, I say... Retreat!"
msgstr "Какая огневая мощь... Всем отступить! Отступаем!"

#. ja: 英雄様直々に……<br>ありがとうございます！
#. de: Ein Geschenk <if $gn4>von der Heldin<else>vom Helden</if> selbst! Welch ein Glück!
#. fr: <if $gn4>L'héroïne<else>Le héros</if> d'Ishgard<nbsp>! Quel honneur<nbsp>!
msgctxt "NpcYell:11492:0:13"
msgid "From the savior's own hands... Such an honor this is!"
msgstr "Из рук самого спасителя... Какая честь!"

#. ja: これは、最新の道具…！
#. de: Sind das etwa die neuesten Werkzeuge? Woher wusstest du ...?
#. fr: Les derniers outils à la mode<nbsp>! Comment avez-vous su<nbsp>?
msgctxt "NpcYell:11493:0:13"
msgid "\\<gasp> These are the latest tools! However did you know?"
msgstr "\\<gasp> Да это же новейшие инструменты! Как вы догадались?"

#. ja: 中身はっと……<br>新しい工具だ！
#. de: Was mag das wohl sein? \<keuch> Neue Steinmetzwerkzeuge!
#. fr: Qu'est-ce que ça peut être... Oh, des outils de qualité<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11494:0:13"
msgid "What might this be?<br>...Oho, new masonry tools!"
msgstr "Что же это может быть?<br>Ого, новые инструменты каменщика!"

#. ja: ありがとう<br>大切に使わせてもらうよ！
#. de: Ich danke dir! Ich werde sie gut behandeln!
#. fr: Merci beaucoup<nbsp>! J'en prendrai soin, je vous le promets<nbsp>!
msgctxt "NpcYell:11495:0:13"
msgid "Thank you! I will treasure this!"
msgstr "Спасибо! Буду беречь их!"

#. ja: わぁっ！？
#. de: Wah!
#. fr: Ouah<nbsp>!?
msgctxt "NpcYell:11496:0:13"
msgid "Eeek!"
msgstr "А-а!"

#. ja: ゲギャギャ、ギャギャー！
#. de: \<zwitscher>
#. fr: Gyagya<nbsp>! Gyagya<nbsp>!
msgctxt "NpcYell:11497:0:13"
msgid "\\<chirp> \\<screech>"
msgstr "\\<chirp> \\<screech>"

#. ja: バーチシロップを<br>くれるのかい？
#. de: Hm, lecker Birkensirup!
#. fr: Oooh, du sirop de bouleau<nbsp>! J'adore ça<nbsp>!
msgctxt "NpcYell:11498:0:13"
msgid "Ooh, birch syrup, and quality stuff to boot!"
msgstr "Ого, берёзовый сироп, да ещё и высшего качества!"

#. ja: お茶の時間が<br>楽しみになるね！
#. de: Das passt hervorragend zu meinem Tee!
#. fr: Merci, je goûterai ça avec mon thé<nbsp>!
msgctxt "NpcYell:11499:0:13"
msgid "Heh heh, I shall enjoy this with my tea!"
msgstr "Хе-хе, буду пить его с чаем!"

#. ja: ほう、蒼天街の特産品を？
#. de: Ist das etwa ein Produkt hier aus Ishgard?
#. fr: Des produits locaux ishgardais<nbsp>?
msgctxt "NpcYell:11500:0:13"
msgid "Oho, Ishgardian produce!"
msgstr "О, продукты из Ишгарда!"

#. ja: こんなにもらって<br>いいんですか！
#. de: Das ist aber viel! Ist das wirklich alles für mich?
#. fr: Il y en a tellement, je ne sais pas si je mérite tout ça<nbsp>!
msgctxt "NpcYell:11501:0:13"
msgid "But this is so much! Are you certain?"
msgstr "Но это же так много! Вы уверены?"

#. ja: やーい、のろまー！
#. de: Blöder, langsamer Vogel!
#. fr: M-mais qu'est-ce que... Arrête<nbsp>!
msgctxt "NpcYell:11502:0:13"
msgid "Big dumb bird! And slow, oh so slow!"
msgstr "Ах ты тупая птица! И медленная, ужасно медленная!"

#. ja: ググ、グギィ…！
#. de: Grah, grah!
#. fr: Gugu<nbsp>! Gugiiii<nbsp>!
msgctxt "NpcYell:11503:0:13"
msgid "Grrr... Grraaah!"
msgstr "Гр-р... Гра-а-а!"

#. ja: 僕の大好物の<br>マロングラッセだ！
#. de: Glasierte Glanznüsse! Die liebe ich!
#. fr: Des marrons glacés, mes préférés<nbsp>!
msgctxt "NpcYell:11504:0:13"
msgid "Ooh, marron glace! My favorite!"
msgstr "О-о, марронглассе! Моё любимое!"

#. ja: ありがとう<br><if $gn4>お姉ちゃん<else>お兄ちゃん</if>！
#. de: Vielen Dank, <if $gn4>verehrte Heldin<else>verehrter Held</if>!
#. fr: Merci beaucoup, <if $gn4>Madame l'aventurière<else>Monsieur l'aventurier</if><nbsp>!
msgctxt "NpcYell:11505:0:13"
msgid "Thank you so much!"
msgstr "Спасибо тебе огромное!"

#. ja: ゲイラキャットの<br>ぬいぐるみだ！
#. de: Eine Geira-Katze?! Ich wollte schon immer eine haben!
#. fr: Oh, une peluche de gaélichat<nbsp>! J'en ai toujours rêvé<nbsp>!
msgctxt "NpcYell:11506:0:13"
msgid "\\<gasp> I've always wanted a toy gaelicat!"
msgstr "\\<gasp> Я всегда мечтал о плюшевом гаэликоте!"

#. ja: ありがとう！<br>お祭り楽しいねー！
#. de: Vielen Dank. Ich liiiebe Feste!
#. fr: Merci mille fois<nbsp>!  Vive la Grande Célébration d'Azurée<nbsp>!
msgctxt "NpcYell:11507:0:13"
msgid "Thank you! Hehe, I like festivals!"
msgstr "Спасибо! Хи-хи, обожаю праздники!"

#. ja: はあ…<br>まだ騒がしいのが残ってるねぇ
#. de: Ständig dieser Lärm<nbsp>... Können wir nicht einfach mal Ruhe haben?
#. fr: Pff... Les plus bruyants du lot ont survécu...
msgctxt "NpcYell:11508:0:13"
msgid "Oh, the noise... Can't we just have silence?"
msgstr "Ох, ну и шум... Неужели нельзя просто помолчать?"

#. ja: きゃあ！
#. de: Aaah!
#. fr: Aaaah<nbsp>!
msgctxt "NpcYell:11509:0:13"
msgid "Ouch!"
msgstr "Ай!"

#. ja: さあ、はやく行って！
#. de: Schnell, wir haben keine Zeit zu verlieren!
#. fr: Faut qu'on se dépêche<nbsp>!
msgctxt "NpcYell:11510:0:13"
msgid "Let's get moving!"
msgstr "Ну же, пошли!"

#. ja: 異形の蛮神は、何処に…
#. de: Weit und breit kein Primae in Sicht ...
#. fr: Les Néo-Primordiaux... Mais où sont-ils<nbsp>!?
msgctxt "NpcYell:11511:0:13"
msgid "I do not see any primals..."
msgstr "Я не вижу здесь праймалов..."

#. ja: イヤな空気だ
#. de: Ich habe ein ungutes Gefühl ...
#. fr: Ça sent pas bon par ici...
msgctxt "NpcYell:11512:0:13"
msgid "Something's not right..."
msgstr "Что-то неладно..."

#. ja: なんとかなったわね…
#. de: Grade noch mal gutgegangen<nbsp>...
#. fr: Ouf, ça a marché...
msgctxt "NpcYell:11513:0:13"
msgid "We were fortunate on this occasion..."
msgstr "В этот раз нам повезло..."

#. ja: さぁ、反撃だ！
#. de: Jetzt teil ich mal aus!
#. fr: C'est l'heure de la riposte<nbsp>!
msgctxt "NpcYell:11514:0:13"
msgid "Now it's our turn!"
msgstr "Теперь наш черёд!"

#. ja: すべてを貫く！
#. de: Komm, tanz mit mir!
#. fr: Je vais tout embrocher<nbsp>!
msgctxt "NpcYell:11515:0:13"
msgid "No more games..."
msgstr "Хватит игр..."

#. ja: 解放者殿！<br>こちらへ…！
#. de: <if $gn4>Befreierin<else>Befreier</if>! Hierher!
#. fr: <split " " 1><string $gs1></split><nbsp>! Par ici<nbsp>!
#. macro: <split " " 2><string $gs1></split> — the last name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:11516:0:13"
msgid "Blade <split \" \" 2><string $gs1></split>, over here!"
msgstr "Клинок <split \" \" 2><string $gs1></split>, сюда!"

#. ja: 青燐水バレルを入手したら<br>こちらへ…！
#. de: Bring die Erdseimfässer zu mir!
#. fr: Apportez les batteries ici<nbsp>!
msgctxt "NpcYell:11517:0:13"
msgid "Bring the ceruleum to me!"
msgstr "Принесите мне церулеум!"

#. ja: 防備の厚さを<br>侮っていたようです…
#. de: Wir kommen nicht durch ...
#. fr: Ce céruleum était sous bonne garde...
msgctxt "NpcYell:11518:0:13"
msgid "\\<grunt> I underestimated them..."
msgstr "\\<grunt> Недооценил я их..."

#. ja: 総員、撤退を…！
#. de: Rückzug!
#. fr: Repliez-vous<nbsp>! Nous n'y arriverons pas<nbsp>!
msgctxt "NpcYell:11519:0:13"
msgid "Fall back! Everyone, fall back!"
msgstr "Отступаем! Всем отступать!"

#. ja: くっ…<br>作戦が失敗するとは…！
#. de: Verdammt! Das hätte nicht passieren dürfen.
#. fr: Graah<nbsp>! Mon plan a échoué<nbsp>!
msgctxt "NpcYell:11520:0:13"
msgid "No... How could we fail?"
msgstr "Нет... Как мы могли проиграть?"

#. ja: やれやれ…<br>呪いが解けたようだな
#. de: Puh<nbsp>... Ich glaube, das hat geholfen!
#. fr: Pfiou... La malédiction est levée, on dirait.
msgctxt "NpcYell:11521:0:13"
msgid "Whew... I seem to be cured."
msgstr "Фух... Похоже, я исцелился."

#. ja: 解呪の仕掛けに<br>乗らないと～！
#. de: Schnell, auf die leuchtende Platte!
#. fr: Une dalle magique<nbsp>! Tous dessus, et vite<nbsp>!
msgctxt "NpcYell:11522:0:13"
msgid "Quickly, to the glowing tile!"
msgstr "Скорее, на светящуюся плиту!"

#. ja: 床面に光が…！？
#. de: Der Boden leuchtet ja!
#. fr: Là, le sol brille<nbsp>!
msgctxt "NpcYell:11523:0:13"
msgid "The floor glows!"
msgstr "Пол светится!"

#. ja: 死の匂いを感じる…！
#. de: Der Tod liegt in der Luft<nbsp>...
#. fr: Ce parfum de mort...<nbsp>!
msgctxt "NpcYell:11524:0:13"
msgid "I sense the pall of death..."
msgstr "Чую дыхание смерти..."

#. ja: キヒッ……あんなところに、<br>丁度いい素材が、いるじゃあないか……。
#. de: Oh, fabelhaft! So viel Material für mich.
#. fr: Oh oh, regardez-moi ça. Il y a matière à faire...
msgctxt "NpcYell:11525:0:13"
msgid "Oh my. So many lambs to lead to the slaughter."
msgstr "Ох, сколько же тут ягнят на заклание..."

#. ja: 魔導僧兵大隊が上級百人隊長、ジルブリスベルだ。<br>オレが「人形使い」と呼ばれる理由を知っているか？
#. de: Ich bin Centurio Gilbrisbert von der IV. Legion. Wisst ihr, warum man mich den Puppenspieler nennt?
#. fr: <if ($gn11 < 12)><if ($gn11 < 4)>Bonsoir<else>Bonjour</if><else><if ($gn11 < 17)>Bonjour<else>Bonsoir</if></if> à vous. Je suis Gilbrisbert, un centurio haut gradé de la cohorte des prêtres magitek. On m'appelle aussi le marionnettiste. Savez-vous pourquoi<nbsp>?
msgctxt "NpcYell:11526:0:13"
msgid "Centurion Gilbrisbert, storied among the IVth Legion, at your service. Do you know why they call me the puppetmaster?"
msgstr "К вашим услугам центурион Джилбрисбелт, прославленный во всём IV легионе. Знаете, почему меня прозвали Кукловодом?"

#. ja: おっと悪かった、お前たち「人形」にはわからないよな。<br>だって、オレが使う側なんだから……。
#. de: Ach, verzeiht. Woher sollen die Puppen auch wissen, an wessen Fäden sie hängen? An meinen, natürlich.
#. fr: Ah, que suis-je bête<nbsp>! Bien sûr que non. Une marionnette ne voit jamais qui tire les ficelles...
msgctxt "NpcYell:11527:0:13"
msgid "Ah, but it is not for the puppets to know wherefore the hand pulls their strings. They are only to move at its command."
msgstr "Ах да, куклам не положено знать, чья рука дёргает за ниточки. Им остаётся лишь двигаться по её воле."

#. ja: ん、なんだ？
#. de: Was?
#. fr: Hein<nbsp>?
msgctxt "NpcYell:11528:0:13"
msgid "What?"
msgstr "Что?"

#. ja: 帝国兵か！？
#. de: Ist das ein garleischer Soldat?
#. fr: C'est un soldat impérial<nbsp>!?
msgctxt "NpcYell:11529:0:13"
msgid "An imperial soldier!?"
msgstr "Имперский солдат!?"

#. ja: ふざけたことを…<br>この戦力差がわからんのか？
#. de: Sträubt euch nicht! Das Ende ist unausweichlich.
#. fr: Tu vois pas qu'on te surpasse en nombre<nbsp>!?
msgctxt "NpcYell:11530:0:13"
msgid "You'd be a fool to fight us. 'Tis plain you're outnumbered!"
msgstr "Глупо сражаться с нами. Разве не видишь, что вас куда меньше?"

#. ja: 抵抗せず、武器を捨てろ！<br>お前を拘束する！
#. de: Legt die Waffen nieder, dann braucht niemand zu sterben.
#. fr: Jette tes armes et rends-toi, si tu veux la vie sauve<nbsp>!
msgctxt "NpcYell:11531:0:13"
msgid "Lay down your arms, and we can end this without bloodshed!"
msgstr "Бросьте оружие — и обойдёмся без кровопролития!"

#. ja: 何を言っているんだ？
#. de: Was redet der da?
#. fr: Mais qu'est-ce qu'il raconte<nbsp>?
msgctxt "NpcYell:11532:0:13"
msgid "What is he blathering on about?"
msgstr "Что он несёт?"

#. ja: ダルマスカで発掘された聖石の欠片な。<br>アレを少しアレンジしてみたんだ、おもしろいだろう？
#. de: Dieser Splitter stammt aus Dalmasca. Man hat noch viel mehr davon ausgegraben. Interessant, nicht wahr?
#. fr: Voyez-vous j'ai eu la chance d'obtenir une auralithe sacrée provenant de Dalmasca, et j'ai pris grand plaisir à ex<shy>pé<shy>ri<shy>men<shy>ter avec.
msgctxt "NpcYell:11533:0:13"
msgid "I wield but a fragment of a relic wrested from the earth of Dalmasca. Even so, thanks to my ingenious experimentation, I believe you can agree that to behold its power is quite life altering!"
msgstr "В моих руках лишь осколок реликвии, извлечённой из земли Далмаски. Но благодаря моим гениальным опытам её силу, полагаю, оценит каждый! И жизнь ваша уже никогда не будет прежней!"

#. ja: 目標達成を確認！<br>皆、よく戦い抜きました！
#. de: Wir haben, was wir brauchen! Gut gekämpft, Soldaten!
#. fr: Bravo, soldats<nbsp>! Nous avons réussi<nbsp>!
msgctxt "NpcYell:11534:0:13"
msgid "We have what we came for! Well done, all of you!"
msgstr "Мы добыли то, за чем пришли! Отлично сработали!"

#. ja: 大勝利ですな！
#. de: Gewonnen!
#. fr: C'est une grande victoire pour notre cause<nbsp>!
msgctxt "NpcYell:11535:0:13"
msgid "We've dealt the IVth a great blow!"
msgstr "Мы нанесли IV легиону сокрушительный удар!"

#. ja: これだけの青燐水があれば<br>疑似青龍壁を維持できます！
#. de: Mit so viel Erdseim spannen wir Seiryu Zwo bis nach Dalmasca!
#. fr: Ce céruleum nous aidera à maintenir opérationnel le champ de force de notre camp<nbsp>!
msgctxt "NpcYell:11536:0:13"
msgid "This ceruleum will keep us for a long while!"
msgstr "Этого церулеума нам надолго хватит!"

#. ja: ぐっ…反動が…！
#. de: Das wird interessant ...
#. fr: Le contrecoup est violent...
msgctxt "NpcYell:11537:0:13"
msgid "Not what I was expecting..."
msgstr "Не такого исхода я ожидал..."

#. ja: 作戦開始！<br>突撃…突撃ーッ！
#. de: Es geht los! Angriff!
#. fr: Allons-y<nbsp>! En avant, soldats<nbsp>!
msgctxt "NpcYell:11538:0:13"
msgid "With me, brothers! Chaaarge!"
msgstr "Братья, за мной! В атаку-у-у!"

#. ja: 青燐水を奪せよ！
#. de: Holt euch den Erdseim!
#. fr: Volez autant de batteries que possible<nbsp>!
msgctxt "NpcYell:11539:0:13"
msgid "Take as much ceruleum as possible!"
msgstr "Захватите как можно больше церулеума!"

#. ja: 帝国の…タメ、に…
#. de: Für ... Garlemald ...
#. fr: Pour... l'Empire...
msgctxt "NpcYell:11540:0:13"
msgid "For...Garlemald..."
msgstr "За... Гарлемальд..."

#. ja: 破壊、セヨ…
#. de: Die Welt ... soll enden ...
#. fr: Votre mort... sera si douce...
msgctxt "NpcYell:11541:0:13"
msgid "Crush...the savages..."
msgstr "Растопчите... дикарей..."

#. ja: ここが、正念場だ！
#. de: Alles oder nichts!
#. fr: C'est nous ou eux<nbsp>!
msgctxt "NpcYell:11542:0:13"
msgid "This is where we make our stand!"
msgstr "Здесь мы и дадим отпор!"

#. ja: 押し負けるな！
#. de: Haltet die Stellung!
#. fr: On se laissera pas faire<nbsp>!
msgctxt "NpcYell:11543:0:13"
msgid "Hold the line!"
msgstr "Держать строй!"

#. ja: フスススィーッ！
#. de: Fssshhh!
#. fr: Fsssshhhh<nbsp>!!
msgctxt "NpcYell:11544:0:13"
msgid "Fssssssha!"
msgstr "Ф-с-с-с-с-ха!"

#. ja: フスィーッ！<br>皆を守るのだ！
#. de: Mein Ssspeer für die Föderation!
#. fr: Fsshh<nbsp>! Tousss à l'assaut<nbsp>!
msgctxt "NpcYell:11545:0:13"
msgid "Repel the invaders!"
msgstr "Отбросьте захватчиков!"

#. ja: 一緒に戦う～よ！
#. de: Bumm, bumm, BUMM!
#. fr: On va gagner, oui<nbsp>!
msgctxt "NpcYell:11546:0:13"
msgid "United, unified, together!"
msgstr "Вместе, плечом к плечу!"

#. ja: 負けない～よ！
#. de: Kobolde verlieren nicht, niahahah!
#. fr: On peut pas perdre, non<nbsp>!
msgctxt "NpcYell:11547:0:13"
msgid "We shall triumph, prevail, win!"
msgstr "Мы победим! Одолеем! Выиграем!"

#. ja: シューッ！<br>貴様らの好きには！
#. de: Wir sssind die Ananta! Wir werden sssiegen!
#. fr: Vous êtes déjà morts<nbsp>! Ssss<nbsp>!
msgctxt "NpcYell:11548:0:13"
msgid "No match for usss!"
msgstr "С нами вам не с-с-справиться!"

#. ja: シュシュシューッ！
#. de: \<zisch>
#. fr: SSSSSSSSS<nbsp>!!!
msgctxt "NpcYell:11549:0:13"
msgid "Forward, sssisters!"
msgstr "Вперёд, с-с-сёстры!"

#. ja: 乾坤一擲！
#. de: Ehrt die Ahnen! Amalj'aa kämpft!
#. fr: Votre perte, vous avez signé<nbsp>!
msgctxt "NpcYell:11550:0:13"
msgid "Fortune favors the brave!"
msgstr "Удача любит храбрых!"

#. ja: 勇猛果敢！
#. de: Für Tapferkeit und Ehre!
#. fr: Notre puissance, vous allez sentir<nbsp>!
msgctxt "NpcYell:11551:0:13"
msgid "Strike swiftly, strike true!"
msgstr "Бейте быстро и точно!"

#. ja: 逃げろおおォォ！
#. de: Rette sich, wer kann!
#. fr: Fuyeeez<nbsp>! Fuyeeez<nbsp>! Une booooombe<nbsp>!
msgctxt "NpcYell:11552:0:13"
msgid "It's going to explode! Run for your lives!"
msgstr "Сейчас взорвётся! Спасайся кто может!"

#. ja: お、おいてかないでよー！
#. de: Lasst mich nicht allein zurück!
#. fr: N'approchez pas, sales bombardos<nbsp>!
msgctxt "NpcYell:11553:0:13"
msgid "Hey, where are you going!?"
msgstr "Эй, куда вы?!"

#. ja: まってー！
#. de: Wartet auf mich!
#. fr: Attendez-moi<nbsp>!
msgctxt "NpcYell:11554:0:13"
msgid "Wait for meeeeee!"
msgstr "Подождите меня-я-я!"

#. ja: ガチガチガチガチ…
#. de: \<schlotter>
#. fr: Brrrr...
msgctxt "NpcYell:11555:0:13"
msgid "Brrrrrrrrrrrr..."
msgstr "Бр-р-р-р-р-р..."

#. ja: キヒッ……やってくれるじゃあないか……。<br>予備の人形を出すとしよう。
#. de: Aha, eine echte Heraus<shy>forde<shy>rung. Aber gut, meine Puppen werden mit allem fertig.
#. fr: Gnin hin... Je reconnais que vous savez y faire, mais j'ai encore de la réserve<nbsp>!
msgctxt "NpcYell:11556:0:13"
msgid "What's this? A real challenge? Very well, there is no threat that more puppets cannot answer."
msgstr "Вот это да! Настоящий вызов? Что ж, против любой угрозы найдутся куклы."

#. ja: さあ、人形たちよ……<br>魔力を注いで、オレを障壁で守るのだ！
#. de: Lasst den Äther durch euch fließen und beschützt euren Meister, meine Puppen!
#. fr: Donnez-moi de votre éther, mes marionnettes<nbsp>! Et protégez-moi<nbsp>!
msgctxt "NpcYell:11557:0:13"
msgid "Allow the aether to flow through your veins, and offer up your very bodies to the safety of your master!"
msgstr "Пусть эфир течёт по вашим жилам, а тела послужат защитой вашему господину!"

#. ja: 攻撃が…<br>通らないだと！？
#. de: Unsere Angriffe dringen nicht durch!
#. fr: Nos attaques ne parviennent plus à l'atteindre<nbsp>!
msgctxt "NpcYell:11558:0:13"
msgid "Nothing's getting through!"
msgstr "Ничего не пробивает!"

#. ja: 魔法障壁か！？
#. de: Diese verdammte Barriere!
#. fr: Une barrière magique<nbsp>!?
msgctxt "NpcYell:11559:0:13"
msgid "It's a damn magic shield!"
msgstr "Проклятый магический щит!"

#. ja: ググゥ…フッ…<br>周囲…フッ！
#. de: Gua ... Rund herum ... Grrr.
#. fr: Grrr... Autour... Faire valdinguer...<nbsp>! Ha ha ha<nbsp>!
msgctxt "NpcYell:11560:0:13"
msgid "Grrr! IGNORE! Ungh!"
msgstr "Гр-р! ИГНОРИРУЮ! Унх!"

#. ja: あの男は後回しにしましょう！<br>先に、周囲に現れた異形の魔物から叩くのよ！
#. de: Lasst ihn! Wir müssen zuerst diese Dinger um ihn herum besiegen!
#. fr: Bonne idée, Kosyu<nbsp>! On s'occupera de lui après<nbsp>! Occupons-nous d'abord de ses marionnettes<nbsp>!
msgctxt "NpcYell:11561:0:13"
msgid "Excellent idea, Kosyu! We must focus on the surrounding fiends before aught else!"
msgstr "Отличная мысль, Косю! Сперва разберёмся с тварями вокруг, а уж потом с ним!"

#. ja: オ、オレの人形たちを、よくも壊してくれたな……！
#. de: Lasst meine lieben Puppen in Ruhe!
#. fr: Ne... touchez pas... À MES MARIONNETTES<nbsp>!!!
msgctxt "NpcYell:11562:0:13"
msgid "Oh, my beautiful puppets. You are lovely even in your demise."
msgstr "Ах, мои прекрасные куклы... Даже в гибели вы прекрасны."

#. ja: だが、あれを使えば、お前たちなど……！<br>キヒッ……ヒヒヒヒヒヒヒ……！
#. de: Pah, das ist noch nicht das Ende. Ich habe noch viel vor.
#. fr: Pfff, ce n'est que partie remise, de toute façon. J'ai ce qu'il faut pour vite en finir avec vous<nbsp>! Gnin hin hin hin hin<nbsp>!!!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11563:0:13"
msgid "But this is not <i>my</i> end. I have such grand designs yet in store... Hehehe! Hah hah haha!"
msgstr "Но это ещё не <i>мой</i> конец. Впереди у меня такие грандиозные планы... Хе-хе-хе! Ха-ха-ха!"

#. ja: どうにか異形を倒すことはできたけれど……<br>人形使いジルブリスベル、危険な男のようね。
#. de: Der Kampf wäre gewonnen, aber dieser Puppenspieler, wie er sich nennt, ist geflohen.
#. fr: Ouf, voilà qui est fait. Mais quand même... Gilbrisbert, voilà un homme bien dangereux...
msgctxt "NpcYell:11564:0:13"
msgid "We may have staved off their assault, but the head of the snake yet lives. The puppetmaster, he called himself..."
msgstr "Мы отбили их нападение, но главарь всё ещё жив. Кукловодом, кажется, он себя назвал..."

#. ja: ググゥ…フッ…<br>仕留める…フッ！
#. de: Gua ... Töten... Guuh.
#. fr: Grrr... Compte... Régler...<nbsp>! Graaah<nbsp>!
msgctxt "NpcYell:11565:0:13"
msgid "Grrr! KILL! Grrr..."
msgstr "Гр-р! УБИТЬ! Гр-р..."

#. ja: 『これ以上の犠牲者を生まないため、次こそ仕留める』と？<br>虎鬚、あなたの意見に賛成だわ。
#. de: Ja, ganz recht. Das nächste Mal werden wir ihn zur Strecke bringen.
#. fr: Tu m'ôtes les mots de la bouche, Kosyu. Nous lui réglerons son compte la prochaine fois pour qu'il ne fasse pas plus de victimes.
msgctxt "NpcYell:11566:0:13"
msgid "He says we must kill him next time, or the blood of his victims will be on our hands. I do not disagree."
msgstr "Он говорит, что в следующий раз нужно убить его, иначе кровь жертв будет и на наших руках. Тут я с ним согласна."

#. ja: キヒッ……素晴らしい仕上がりじゃあないか……！<br>レジスタンスどもを叩き潰してやったぞ！
#. de: Hahaaa, was für eine fabelhafte Aufführung! Meine Puppen trampeln den Widerstand nieder!
#. fr: Haaaan, merveilleux<nbsp>! Mes marionnettes ont écrasé tous ces cancrelats<nbsp>!
msgctxt "NpcYell:11567:0:13"
msgid "Heehee! What a fabulous performance! The Resistance is crushed under the unyielding boots of my puppets!"
msgstr "Хи-хи! Вот это представление! Мои куклы растоптали Сопротивление своими несгибаемыми сапогами!"

#. ja: この技術を、あれを使って再現すれば……<br>キヒッ……ヒヒヒヒヒヒヒ……！
#. de: Doch das war noch nicht alles. Bald werde ich der Welt mein Meisterstück offenbaren.
#. fr: J'espère ne pas avoir trop démoralisé ces rebelles. C'est que je n'ai pas encore réalisé mon magnum opus...
msgctxt "NpcYell:11568:0:13"
msgid "However, there is yet more my talents can achieve. The world waits with bated breath for my magnum opus, and I must not disappoint!"
msgstr "Но и это не предел моих талантов. Весь мир затаил дыхание в ожидании моего шедевра, и я не смею его разочаровать!"

#. ja: ぐっ……完敗ね……。<br>人形使いジルブリスベル……なんて危険な男なの！
#. de: Wer ist dieser Puppenspieler? Woher kommt er? Wir hatten keine Chance gegen ihn.
#. fr: Gilbrisbert le marionnettiste... Il nous a bien eus<nbsp>!
msgctxt "NpcYell:11569:0:13"
msgid "Ugh... We didn't stand a chance. Where did that puppetmaster come from?"
msgstr "Уф... Нам было не справиться. Откуда взялся этот Кукловод?"

#. ja: ググゥ…フッ…<br>仕留める…フッ！
#. de: Gua ... Töten... Guuh.
#. fr: Grrr... Compte... Régler...<nbsp>! Graaah<nbsp>!
msgctxt "NpcYell:11570:0:13"
msgid "Grrr! KILL! Grrr..."
msgstr "Гр-р! УБИТЬ! Гр-р..."

#. ja: 『これ以上の犠牲者を生まないため、次こそ仕留める』と？<br>もちろんよ、虎鬚、逆襲の機会を待ちましょう……。
#. de: Ja. Das nächste Mal werden wir ihn zur Strecke bringen, ganz sicher.
#. fr: Tu m'ôtes les mots de la bouche, Kosyu. Nous lui réglerons son compte la prochaine fois pour qu'il ne fasse pas plus de victimes.
msgctxt "NpcYell:11571:0:13"
msgid "He says we must kill him next time, or the blood of his victims will be on our hands. I do not disagree."
msgstr "Он говорит, что в следующий раз нужно убить его, иначе кровь жертв будет и на наших руках. И я согласна. Будем ждать случая отомстить..."

#. ja: 来たわね、大氷獣！<br>応戦するわよ！
#. de: Die Eis-Knallomaten sind da! Keine Sorge, Thracie kümmert sich darum!
#. fr: Ne laissons pas ces monstres refroidir l'ambiance<nbsp>!
msgctxt "NpcYell:11572:0:13"
msgid "The fiends come, but fear not! Thracie stands with you!"
msgstr "Твари уже здесь, но не бойтесь! Трейси с вами!"

#. ja: ククク、アイスボンバードちゃん…<br>ス・テ・キ…！
#. de: Hihi, Eis-Knallomaten ... Wunderbar, wunderbar!
#. fr: Hi hi hi... Ils sont vraiment trognons, oui<nbsp>!
msgctxt "NpcYell:11573:0:13"
msgid "Just look at that! So pretty they are, and so frosty─icy, freezy, frosty!"
msgstr "Только посмотрите! Какие они красивые, прямо ледяные... морозные... снежные!"

#. ja: 俺だって冒険者なんだ…！<br>よぉし、やるぜー！
#. de: Ich bin auch dabei! Das ist doch Abenteurerehrensache!
#. fr: L'union des aventuriers fait la forrrce de l'été<nbsp>!
msgctxt "NpcYell:11574:0:13"
msgid "On my honor as an adventurer, I will quell this icy menace!"
msgstr "Честью приключенца клянусь, я остановлю эту ледяную напасть!"

#. ja: 紅蓮祭を<br>邪魔させはしない！
#. de: Wir lassen uns von den Biestern nicht das Fest verderben!
#. fr: Vous ne nous empêcherez pas de bronzer<nbsp>!
msgctxt "NpcYell:11575:0:13"
msgid "You beasts won't stop us from celebrating the season!"
msgstr "Не позволим вам, зверюги, испортить нам праздник!"

#. ja: うぉおおおお！
#. de: Uaaaah!
#. fr: Yahaaah<nbsp>!!
msgctxt "NpcYell:11576:0:13"
msgid "Haaaaaagh! Here I goooooo!"
msgstr "А-а-а-а! Сейчас я вам покажу-у-у!"

#. ja: お兄ちゃん<br>おケガしないでねー！
#. de: Sei vorsichtig, Bruder!
#. fr: Fais attention à toi, grrrand frère<nbsp>!
msgctxt "NpcYell:11577:0:13"
msgid "Don't hurt yourself out there, Brother!"
msgstr "Братик, смотри не поранься там!"

#. ja: すげえ、戦ってる！
#. de: Was für mutige Abenteurer!
#. fr: Quelle bataille d'anthologie<nbsp>!
msgctxt "NpcYell:11578:0:13"
msgid "Look at them fight!"
msgstr "Ничего себе, как они дерутся!"

#. ja: がんばってー！
#. de: Los, gebt es ihnen!
#. fr: Courage<nbsp>!
msgctxt "NpcYell:11579:0:13"
msgid "Knock those Bombards out of the sky!"
msgstr "Сбейте бомбардо с неба!"

#. ja: いっけー！
#. de: Looos!
#. fr: En avant<nbsp>!
msgctxt "NpcYell:11580:0:13"
msgid "You can do it!"
msgstr "У вас получится!"

#. ja: おやおや、ロフィーではありませんか。<br>実験に協力するため、ご足労いただけるとは嬉しいですねぇ。
#. de: Wenn das nicht Llofii ist ... Du kommst genau richtig, um bei einem spannenden Experiment zu helfen.
#. fr: Llofii<nbsp>? Ravi de te retrouver ici. Tu arrives juste à temps, nous allions procéder à un test intéressant.
msgctxt "NpcYell:11581:0:13"
msgid "Well, if it isn't Llofii! So kind of you to come all this way to take part in my research..."
msgstr "О, да это же Ллофи! Как мило с твоей стороны приехать издалека и поучаствовать в моих исследованиях..."

#. ja: ファビノー！　また何か企んでるのですね……！<br>貴方の非道な実験、ここで終わらせますッ！
#. de: Fabineau! Heckst du etwa schon wieder etwas aus? Ich werde bei deinem Spiel nicht mitspielen!
#. fr: Fabineau<nbsp>! Que manigancez-vous encorrre<nbsp>!? Vos expériences immorales s'arrêtent ici<nbsp>!
msgctxt "NpcYell:11582:0:13"
msgid "Fabineau! Plotting another sick experiment, I see. Well, it ends today!"
msgstr "Фабино! Опять что-то замышляешь? Ну уж нет, сегодня твоим опытам конец!"

#. ja: 被検体を確保しました<br>これより、実験を開始します
#. de: Das sind die Testsubjekte. Beginnen wir das Experiment.
#. fr: Les sujets sont prêts. À votre signal, Maître Fabineau.
msgctxt "NpcYell:11583:0:13"
msgid "Test subject secured. Let the experiment begin..."
msgstr "Подопытный захвачен. Приступаем к эксперименту..."

#. ja: まずは古典的な妖異召喚術の実証実験といきましょう。<br>ちょうどいい贄もいることですしねぇ……。
#. de: Zuerst die uralte Beschwörungsformel. Sie erfordert natürlich passende Opfer ...
#. fr: Commençons par une invocation d'êtres du néant, tout ce qu'il y a de plus classique. Il nous faudra des sacrifices, mais ils sont tout trouvés.
msgctxt "NpcYell:11584:0:13"
msgid "We will begin with the summoning ritual. Of course, this will require a suitable sacrifice..."
msgstr "Начнём с классического ритуала призыва. Разумеется, нам понадобится подходящая жертва..."

#. ja: なんてことを……！！
#. de: Nein! Das ist ja fürchterlich!
#. fr: Non<nbsp>! Quelle fin horrible<nbsp>!
msgctxt "NpcYell:11585:0:13"
msgid "You...you monster!"
msgstr "Ты... чудовище!"

#. ja: この犠牲が、吾輩の魔道をまた一歩先へと前進させるのですよ。<br>素晴らしきかな、研究の自由ッ！
#. de: Wo gehobelt wird, da fallen eben Späne. Ohne Opfer kann es keinen Fortschritt geben!
#. fr: Tel est le prix du progrès. La science va repousser les limites de ma magie, n'est-ce pas magnifique<nbsp>!?
msgctxt "NpcYell:11586:0:13"
msgid "In serving my research, their deaths will serve a greater purpose than their pathetic lives ever could!"
msgstr "Их смерть послужит исследованиям, а значит, принесёт куда больше пользы, чем их жалкие жизни!"

#. ja: いったーい！
#. de: Das tut weh!
#. fr: Ça fait mal<nbsp>!
msgctxt "NpcYell:11587:0:13"
msgid "That hurts!"
msgstr "Больно!"

#. ja: お前の知識欲を満たすために、<br>どれだけの命が犠牲になったことか……許せない！
#. de: Warum musst du deinen Wissensdurst an dem Blut Unschuldiger löschen?
#. fr: Votre avidité sans borrrne pour la con<shy>nais<shy>san<shy>ce a déjà fait tant de victimes... Vous paierez pour vos crimes<nbsp>!
msgctxt "NpcYell:11588:0:13"
msgid "How many innocent creatures must die to serve your crazed thirst for forbidden knowledge!?"
msgstr "Сколько ещё невинных созданий должно погибнуть ради твоей безумной жажды запретных знаний?!"

#. ja: うわわわ…！
#. de: Wie kannst du es wagen!
#. fr: Oh là là<nbsp>!
msgctxt "NpcYell:11589:0:13"
msgid "How dare you!"
msgstr "Да как ты смеешь?!"

#. ja: さて、犠牲を怖れぬ姿勢が、いかに歩みを早めるのか……<br>今ここに実証させていただきましょう！
#. de: Fürchtet euch nicht, euer Opfer ist für eine gute Sache! Also los, es beginnt.
#. fr: Entête-toi avec tes états d'âme et tu courras d'autant plus vite à ta perte<nbsp>! Laisse-moi te le démontrer, ici et maintenant<nbsp>!
msgctxt "NpcYell:11590:0:13"
msgid "Such a noble beast... Look how it fears not death... Now, shall we begin?"
msgstr "Такое благородное создание... И смерти-то не боится... Ну что, начнём?"

#. ja: クエーッ！？
#. de: Kweh!
#. fr: Kwééé<nbsp>!?
msgctxt "NpcYell:11591:0:13"
msgid "Kweh...? Kweh!"
msgstr "Кве?.. Кве!"

#. ja: まさか、この子たちを生贄に……！？<br>や、やめてッ……！
#. de: Nein, nicht sie! Hör auf!
#. fr: V-vous allez vous serrrvir d'eux<nbsp>!? Non<nbsp>! Arrêtez<nbsp>!
msgctxt "NpcYell:11592:0:13"
msgid "They...they're only babies! Stop it!"
msgstr "Они же совсем крошки! Не надо!"

#. ja: ふむ、エーテル供給を確認……実験は成功したようですね。<br>この強化法の実用化に目処が立ちそうです。
#. de: Der Äther ist extrahiert. Das Experiment ist geglückt. Dieser Stärkungszauber wird mir bei meinen nächsten Unternehmungen große Dienste leisten.
#. fr: Extraction de l'éther réussie. Cette expérience m'a l'air d'un grand succès. Nous pourrons utiliser cette méthode de renforcement lors de nos futures missions.
msgctxt "NpcYell:11593:0:13"
msgid "Aether charge confirmed...precisely according to my hypothesis. Yes, these results should bear fruit..."
msgstr "Заряд эфира подтверждён... Всё точно по моей гипотезе. Да, эти результаты ещё принесут плоды..."

#. ja: どこまで……どこまで命を侮辱すれば気が済むの！
#. de: Wie viele müssen noch sterben, bis du genug hast?
#. fr: Vous êtes un monstre... Vous êtes abominable<nbsp>! Quand en aurrrez-vous assez<nbsp>!?
msgctxt "NpcYell:11594:0:13"
msgid "Have you no respect for life whatsoever!?"
msgstr "Тебе совсем не жаль ни одной жизни?!"

#. ja: 実力行使で止めてみてはいかがかな？<br>数多の犠牲によって発展してきた魔法を使って、ね？
#. de: Wenn du mich aufhalten willst, wirst du es mit Gewalt tun müssen. Und das gelingt dir nur, wenn du Opfer bringst. Du und ich, wir unterscheiden uns nicht!
#. fr: Tu devras avoir recours à la force, si tu veux m'arrêter. Une force que tu n'obtiendras qu'en sacrifiant autre chose, tout comme moi<nbsp>!
msgctxt "NpcYell:11595:0:13"
msgid "If you disapprove, why not stop me with your own magic? Of course, that, too, is born from sacrifice..."
msgstr "Не нравится — попробуй остановить меня своей магией. Хотя она ведь тоже рождена жертвами..."

#. ja: おぼえてろよ～！
#. de: Dafür werdet ihr bezahlen!
#. fr: Notre vengeance sera terrible<nbsp>!
msgctxt "NpcYell:11596:0:13"
msgid "You will rue this day!"
msgstr "Вы ещё пожалеете об этом!"

#. ja: なっ……吾輩の魔道が……ここで潰えると……！？<br>認めん……断じて、認められん、ぞ…………。
#. de: Meine Zauber ... wirken nicht mehr. Das darf nicht sein. Ich darf nicht ... sterben ... nicht hier ...
#. fr: Mes charmes se brisent... Mes sorts s'évaporent... Ridicule<nbsp>! Je ne peux pas... mourir... ici...
msgctxt "NpcYell:11597:0:13"
msgid "This cannot be! My magicks...are all powerful! My research...must go on...!"
msgstr "Не может быть! Моя магия... всемогуща! Мои исследования... должны продолжаться...!"

#. ja: ファビノー様が<br>敗れただと！？
#. de: Ist Meister Fabineau ... tot?
#. fr: Maître Fabineau est tombé<nbsp>!?
msgctxt "NpcYell:11598:0:13"
msgid "Master Fabineau has fallen!?"
msgstr "Господин Фабино пал!?"

#. ja: 拠点まで退くぞ…！
#. de: Zurück ins Lager!
#. fr: Replions-nous jusqu'au camp de base<nbsp>!
msgctxt "NpcYell:11599:0:13"
msgid "Fall back to the encampment!"
msgstr "Отступаем к лагерю!"

#. ja: て、撤退だ～！
#. de: Nichts wie weg!
#. fr: Retraite<nbsp>!
msgctxt "NpcYell:11600:0:13"
msgid "Retreat! Retreat!"
msgstr "Отступление! Отступаем!"

#. ja: はぁ、はぁ、はぁ……<br>ど、どうにかファビノーを倒すことができました……。
#. de: Wir haben's geschafft. Fabineau ist besiegt.
#. fr: Haa... Haa... Haa... Nous sommes enfin venus à bout... de Fabineau.
msgctxt "NpcYell:11601:0:13"
msgid "At long last... Fabineau will conduct his cruel experiments no more."
msgstr "Наконец-то... Фабино больше не будет ставить жестокие опыты."

#. ja: しかし、未だ術士大隊の研究施設には、<br>多くの実験動物たちが囚われているはず……。
#. de: Aber es befinden sich noch viele Gefangene im Lager des Spezialbataillons.
#. fr: Mais encore beaucoup de cobayes sont retenus prisonniers par les incantateurrrs de la 4e légion...
msgctxt "NpcYell:11602:0:13"
msgid "And yet...no doubt many innocent creatures remain trapped in his research facility."
msgstr "Но... в его исследовательском центре наверняка ещё много невинных созданий томятся в плену."

#. ja: その子たちを救うまでは、歩みを止めるわけにはいかないのです。
#. de: Wir müssen sie retten!
#. fr: Je ne me reposerai pas tant qu'ils n'aurrront pas été libérés jusqu'au dernier<nbsp>!
msgctxt "NpcYell:11603:0:13"
msgid "I must not rest until all are saved from a horrific fate..."
msgstr "Я не успокоюсь, пока не спасу их всех от ужасной участи..."

#. ja: はぁ、はぁ、はぁ……<br>まだ倒れる……わけには…………！
#. de: Ich ... bin noch nicht ... am Ende!
#. fr: Haa... Haa... Haa... Pas encorrre...<nbsp>! Je dois... Je dois...
msgctxt "NpcYell:11604:0:13"
msgid "No...! I cannot...fall...here..."
msgstr "Нет... Я не... могу... пасть... здесь..."

#. ja: さあ、逃げ帰って愚鈍なレジスタンスどもに伝えなさい。<br>吾輩の魔道は、さらなる高みに至った、とね……！
#. de: Rennt nur! Rennt und sagt es allen! Meine Magie wird mächtiger sein als alles andere!
#. fr: Je te laisse la vie sauve. Retourne chez tes nouveaux amis et dis-leur... dis-leur que ma magie a atteint de nouveaux sommets<nbsp>!
msgctxt "NpcYell:11605:0:13"
msgid "Turn tail and run back to your precious Resistance... And tell them Fabineau has made another breakthrough!"
msgstr "Бегите обратно к своей драгоценной Сопротивлению... И передайте им: Фабино снова совершил прорыв!"

#. ja: またあそんでね～！
#. de: Lasst uns bald wieder miteinander spielen!
#. fr: Même pas drôle<nbsp>!
msgctxt "NpcYell:11606:0:13"
msgid "Play with us again sometime!"
msgstr "Приходите ещё поиграть с нами!"

#. ja: も～、バカ鳥め！<br>どこまで追ってくるのよー！
#. de: Hau ab, du blöder Vogel! Warum klebst du so an mir?!
#. fr: Saleté de piaf<nbsp>! Il n'abandonne pas<nbsp>!
msgctxt "NpcYell:11608:0:13"
msgid "Get away, you blubbering bird! Stop nipping at my heels!"
msgstr "Отстань, ты, мерзкая птица! Хватит клевать меня в пятки!"

#. ja: うぅ、今の私には……力が足りない……。<br>ファビノーの悪行を、止めるだけの……力が……。
#. de: Ich ... habe nicht genug Kraft. Ich kann Fabineau nicht aufhalten.
#. fr: Je n'ai... Je n'ai pas la forrrce nécessaire pour lui tenir tête... Je ne peux pas l'arrêter...<nbsp>!
msgctxt "NpcYell:11610:0:13"
msgid "It's no use... Fabineau's magicks are too powerful..."
msgstr "Бесполезно... Магия Фабиноу слишком сильна..."

#. ja: 姿を現せ、レジスタンスどもッ！<br>我が名はパガガ！
#. de: Zeigt euch, Widerständler! Ich bin Pagaga die Allergrößte!
#. fr: Montrez-vous, chien de rebelles<nbsp>! Pagaga est prête à vous affronter<nbsp>!
msgctxt "NpcYell:11611:0:13"
msgid "I am Pagaga, queen of beasts! Show yourself, Resistance worms!"
msgstr "Я Пагага, королева зверей! Покажитесь, черви из Сопротивления!"

#. ja: ググゥ……フッ……、フッフッ……ググゥ……！
#. de: Guh ... And-and ... Hu ha ... Grrr.
#. fr: Hmm... Ha...<nbsp>! Ha ha ha... Grrr...
msgctxt "NpcYell:11612:0:13"
msgid "Grrr...! Ungggh... Graaagh!"
msgstr "Р-р-р...! У-у-у... Гра-а-а!"

#. ja: 『なにやらあの娘、以前とは雰囲気が違う』ですって？<br>確かに、何か覚悟を決めているようだけれど……
#. de: Du meinst, sie sieht anders aus als vorher?
#. fr: Elle te semble plus assurée que la dernière fois que nous l'avons affrontée, Kosyu<nbsp>? Elle me donne aussi cette impression, c'est vrai...
msgctxt "NpcYell:11613:0:13"
msgid "“The girl...she seems different than before,” you say? We had best be wary, then..."
msgstr "«Девушка... она будто изменилась», говоришь? Тогда нам лучше быть начеку..."

#. ja: あそこまで堂々と挑発されて、尻尾を巻いて逃げでもすれば、<br>それこそ士気に関わるってものよね……！
#. de: Sie will uns Angst machen. Aber wir werden nicht vor ihr kuschen!
#. fr: Elle nous a défiés. Nous n'aurions pas fière allure si nous fuyions maintenant<nbsp>!
msgctxt "NpcYell:11614:0:13"
msgid "At any rate, it would seem we've been issued a challenge. It wouldn't do for us to turn tail now."
msgstr "Как бы то ни было, нам бросили вызов. Сейчас отступать нельзя."

#. ja: 槍女に髭男ッ……！<br>今こそ我が義父の名誉のため、貴様たちを倒してやるッ！
#. de: Schon wieder die mit dem Speer und der mit dem Bart! Ich werde sie besiegen, für die Ehre des Namens Vochsteins!
#. fr: Encore cette femme armée d'une lance et son ami moustachu<nbsp>! Je vais vous vaincre<nbsp>! Et porter le nom des Vochstein au firmament<nbsp>!
msgctxt "NpcYell:11615:0:13"
msgid "Well, if it isn't the spear girl and the mustachioed muscle-head. This time, you'll pay for dishonoring Father!"
msgstr "Ну надо же, копейщица и усатый здоровяк. На этот раз вы поплатитесь за оскорбление отца!"

#. ja: まだだッ！<br>バックスタインの名を継いだ私が負けるわけにはッ！
#. de: Ich darf nicht verlieren! Ich muss die Ehre meines Vaters verteidigen!
#. fr: Je ne peux pas perdre, je dois défendre l'honneur de mon père<nbsp>!
msgctxt "NpcYell:11616:0:13"
msgid "On the Vochstein name...I swear I will not fall!"
msgstr "Во имя рода Вохштейнов... Клянусь, я не паду!"

#. ja: 獣王を騙るあの男に示してやるんだッ！<br>その称号を名乗るに相応しきは、誰なのかをッ！
#. de: Ich werde Lyon zeigen, dass ich die allergrößte Bestienbändigerin aller Zeiten bin!
#. fr: Je dois montrer à Lyon qui mérite vraiment de porter le nom de Roi bestial<nbsp>!
msgctxt "NpcYell:11617:0:13"
msgid "The “Beast King”? Hah! I'll show Lyon who truly deserves to wear the crown!"
msgstr "«Король зверей»? Ха! Я покажу Лиону, кто по-настоящему достоин короны!"

#. ja: ライアンを退けた者たちを倒し、<br>バックスタインこそが、獣王に相応しいと示すのだッ！
#. de: Die Vochsteins sind die Könige der Bestien und niemand anders!
#. fr: Ce titre revient de droit aux Vochstein<nbsp>! Et à personne d'autre<nbsp>!
msgctxt "NpcYell:11618:0:13"
msgid "The Vochsteins are the true rulers of beastkind─now and forever!"
msgstr "Вохштейны — истинные повелители звериного царства, сейчас и навеки!"

#. ja: ジュニアたち、待っているように言ったろう！？<br>お前たちの傷は、まだ癒えてはいないんだッ！
#. de: Berda und Obda junior! Ich habe gesagt, ihr sollt euch hinlegen! Eure Wunden sind noch nicht geheilt.
#. fr: Berda et Obda juniors<nbsp>! Je vous avais dit couché<nbsp>! Vous n'êtes pas encore guéris de vos blessures<nbsp>!
msgctxt "NpcYell:11619:0:13"
msgid "Berda, Obda! I told you to stay put! Your wounds are not yet healed..."
msgstr "Берда, Обда! Я же велел вам сидеть смирно! Ваши раны ещё не зажили..."

#. ja: キュイッ！
#. de: \<fauch>
#. fr: Cuiiii<nbsp>!
msgctxt "NpcYell:11620:0:13"
msgid "Screech!"
msgstr "Визг!"

#. ja: キュイ、キュイッ！
#. de: Grrr ...
#. fr: Cui-cuiiii<nbsp>!
msgctxt "NpcYell:11622:0:13"
msgid "Screech! Screeeeeech!"
msgstr "Визг! Вииизг!"

#. ja: ベルダJr.……なんて優しい子だッ！<br>オブダJr.……わかったよ、最後まで共に闘おうッ！
#. de: Gutes Tier. Ja, wir werden sie zusammen besiegen!
#. fr: Ooooh, vous êtes les meilleurs amis du monde... Très bien, finissons-les ensemble<nbsp>!
msgctxt "NpcYell:11623:0:13"
msgid "Berda, how sweet you are! Obda, let us fight as one to the end!"
msgstr "Берда, до чего же ты добрая! Обда, давай сражаться вместе до самого конца!"

#. ja: キュイーッ！
#. de: Grrroar!
#. fr: Cuiiii<nbsp>!
msgctxt "NpcYell:11624:0:13"
msgid "Screeeeeech!"
msgstr "Виииизг!"

#. ja: グッ……なんてシブとい連中だッ……！<br>あのライアンを退けただけの力はあるということか……
#. de: Grrr, sie wollen sich nicht beugen. Langsam dämmert es mir, warum Lyon den Schwanz vor ihnen eingezogen hat.
#. fr: Grrr...<nbsp>! Ils ne veulent pas courber l'échine<nbsp>! Pas étonnant que Lyon ait fui la queue entre les jambes...
msgctxt "NpcYell:11625:0:13"
msgid "They're tougher than they look. No wonder Lyon felt he'd met his match..."
msgstr "Они крепче, чем кажутся. Неудивительно, что Лион понял: ему с ними не справиться..."

#. ja: だが、諦めてなるものかッ！
#. de: Aber ich werde Erfolg haben, wo er versagt hat! Für die Vochsteins!
#. fr: Mais je réussirai là où il a échoué<nbsp>! Parole de Vochstein<nbsp>!
msgctxt "NpcYell:11626:0:13"
msgid "But this Vochstein will not bend so easily!"
msgstr "Но этот Вохштейн так просто не сдастся!"

#. ja: 今度こそ、今度こそ、貴様たちを倒してやるッ！
#. de: Ich werde euch kriegen, hört ihr? Ich werde euch kriegen!
#. fr: JE VOUS AURAIS<nbsp>! VOUS M'ENTENDEZ<nbsp>!? JE VOUS AURAIS<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11627:0:13"
msgid "Next time! Next time, I swear─Pagaga will <i>end you</i>!"
msgstr "В следующий раз! В следующий раз, клянусь, Пагага <i>с вами покончит</i>!"

#. ja: 異様な執着心を持っているようね……。
#. de: Also Ehrgeiz hat sie.
#. fr: On peut dire qu'elle est motivée...
msgctxt "NpcYell:11628:0:13"
msgid "She's a persistent one, isn't she...?"
msgstr "Упрямая же она..."

#. ja: フッ……ググゥ……、……！
#. de: Gua ... leck ... Gu haha!
#. fr: Grrr... Mouha ha ha<nbsp>!!!
msgctxt "NpcYell:11629:0:13"
msgid "Ungh... Unghhha!"
msgstr "Ух... У-у-у..."

#. ja: 『魔獣があの状況では、しばらく前線には出ないだろう』ですって？<br>そうね……そうあってほしいものだわ。
#. de: Wir werden sie so bald nicht wiedersehen, weil ihre Bestien Zeit brauchen, um ihre Wunden zu lecken? Mögest du recht haben, mein lieber Kosyu.
#. fr: On ne la reverra pas de sitôt parce que ses bêtes mettront du temps à lécher leurs blessures<nbsp>? Puisses-tu avoir raison, mon cher Kosyu.
msgctxt "NpcYell:11630:0:13"
msgid "“Big words, but those wounds will keep her from the front lines for some time,” you say? We can only hope so..."
msgstr "«Громкие слова, да раны надолго не пустят её на передовую», говоришь? Остаётся надеяться..."

#. ja: 名誉のために若い娘が、戦場で命を散らせるだなんて、<br>好んで見たいものではないもの……。
#. de: Es ist traurig, dass dieses Mädchen sein Leben für den Ruhm seiner Familie opfert.
#. fr: C'est que je ne tiens pas à voir cette enfant mourir pour la gloire sur le champ de bataille...
msgctxt "NpcYell:11631:0:13"
msgid "Friend or foe, I've no desire to see a girl throw her life away for foolish pride."
msgstr "Неважно, друг она или враг, я не хочу смотреть, как девчонка губит себя из-за глупой гордости."

#. ja: 見たかッ！<br>これが真のビーストマスター、バックスタインの力だッ！
#. de: Seht her! Das ist die Macht einer ECHTEN Bestienbändigerin! Die Macht der Vochsteins!
#. fr: HA HA<nbsp>! Admirez la toute-puissance des dompteurs de la maison Vochstein<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11632:0:13"
msgid "Behold! <i>This</i> is what it means to rule beastkind! <i>This</i> is the power of the Vochsteins!"
msgstr "Смотрите! <i>Вот</i> что значит повелевать зверями! <i>Вот</i> сила Вохштейнов!"

#. ja: キュイーッ！
#. de: Grrroaaar!
#. fr: Cui cui cui cuiii<nbsp>! Cui cui, cui cuicuiiii<nbsp>!
msgctxt "NpcYell:11633:0:13"
msgid "Screeeeeech!"
msgstr "Виииизг!"

#. ja: さあ、凱旋するぞッ！<br>老いぼれライアンが泣いて悔しがる顔が目に浮かぶなッ！
#. de: Wenn Lyon Wind von diesem Triumph bekommt, werden ihm Tränen in den Augen stehen und Rotz aus der Nase laufen!
#. fr: J'imagine déjà la tête de Lyon quand il aura vent de notre triomphe ici<nbsp>! Son honneur blessé, il aura les larmes aux yeux et la morve au nez<nbsp>!
msgctxt "NpcYell:11634:0:13"
msgid "Gahaha! I can see Lyon's face. The self-styled Beast King is but a weanling compared to the power of Pagaga!"
msgstr "Га-ха-ха! Прямо вижу лицо Лиона. Самозваный король зверей рядом с мощью Пагаги — ещё дитя!"

#. ja: また新しい奴らかい…<br>面倒だね、勝手にやってな
#. de: Heute ist echt was los<nbsp>... Macht das mal ohne mich.
#. fr: Décidément, c'est le défilé aujourd'hui... Débrouillez-vous sans moi.
msgctxt "NpcYell:11635:0:13"
msgid "Another nuisance... Well, go on. Kill each other."
msgstr "Опять какая-то морока... Ладно, убивайте друг друга, мне-то что."

#. ja: そぉれぇぇぇ～！
#. de: Aufgepasst!
#. fr: Hop là<nbsp>!
msgctxt "NpcYell:11636:0:13"
msgid "Unleash the power!"
msgstr "Высвободите силу!"

#. ja: なんて、執着心……！<br>これ以上は不利になる、退きましょう……！
#. de: Sie kämpft zu verbissen. Heute werden wir sie nicht besiegen. Ziehen wir uns zurück!
#. fr: Elle... Elle se bat avec tant d'ardeur...<nbsp>! Nous ne la vaincrons pas aujourd'hui<nbsp>! Replions-nous<nbsp>!
msgctxt "NpcYell:11637:0:13"
msgid "Our foe is too stubborn today. Let us retreat and regroup while we have the chance..."
msgstr "Сегодня нам её не одолеть. Отступим, пока ещё есть возможность..."

#. ja: 負けないわよ！
#. de: Ich habe noch nie einen Kampf verloren!
#. fr: Je me laisserai pas faire<nbsp>!
msgctxt "NpcYell:11639:0:13"
msgid "I won't fall so easily!"
msgstr "Так просто я не паду!"

#. ja: 俺だって…！
#. de: Ich übrigens auch nicht ...
#. fr: Vous allez voirrr<nbsp>!
msgctxt "NpcYell:11640:0:13"
msgid "Nor I!"
msgstr "И я тоже!"

#. ja: ボムちゃんーも<br>一緒に爆発、するーよ…！
#. de: Ba Go platzt auch gleich, hihi!
#. fr: Les bombardos vont faire bouboum, oui<nbsp>!
msgctxt "NpcYell:11641:0:13"
msgid "Ba Go's heart bursts with excitement!"
msgstr "Сердце Ба Го сейчас лопнет от восторга!"

#. ja: キレイーな爆発<br>見せーて！
#. de: Je größer der Bumm, desto größer Ba Gos Wonne!
#. fr: Fais-moi péter ce bombardo givré, oui<nbsp>!
msgctxt "NpcYell:11642:0:13"
msgid "Go boom for Ba Go, my beauties!"
msgstr "Устройте для Ба Го красивый взрыв!"

#. ja: おらァッ！
#. de: Jetzt seid ihr draaan!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:11643:0:13"
msgid "Take that!"
msgstr "Получай!"

#. ja: うりゃりゃりゃ！
#. de: Uaaah!
#. fr: Prends ça<nbsp>! Et ça<nbsp>! Et ça aussi<nbsp>!
msgctxt "NpcYell:11644:0:13"
msgid "Yah! Eee-yah!"
msgstr "На! Ещё!"

#. ja: お兄ちゃん<br>がんばってーーー！
#. de: Los, Bruder!
#. fr: Vas-y, frrrérot<nbsp>!
msgctxt "NpcYell:11645:0:13"
msgid "You can do it, Brother!"
msgstr "Ты сможешь, братик!"

#. ja: ハァ、ハァ…<br>撃退、できたわね…！
#. de: \<keuch> Wir haben's geschafft!
#. fr: Pfiou... Ils nous lâchent enfin la grappe...
msgctxt "NpcYell:11646:0:13"
msgid "\\<pant> \\<huff> The battle...is won!"
msgstr "\\<pant> \\<huff> Битва... выиграна!"

#. ja: マージャ！<br>兄ちゃん、やったぞ！
#. de: Hurra!
#. fr: Hé hé, t'as vu la rrrouste que je leur ai collée<nbsp>?
msgctxt "NpcYell:11647:0:13"
msgid "Did you see me out there, Sister?"
msgstr "Сестрица, видела, как я там расправился с ними?"

#. ja: アイスボンバードちゃん…<br>散り際も、キレイだったーよ…！
#. de: Bumm, auf Nimmer<shy>wieder<shy>sehen, hihi!
#. fr: Ils sont partis sur un gros boum, oui<nbsp>!
msgctxt "NpcYell:11648:0:13"
msgid "Ba Go's icy pretties! How beautifully you go boom..."
msgstr "Ледяные бомбардо Ба Го! Как же красиво вы взрываетесь..."

#. ja: うおおお、勝利だッ！
#. de: Siiieg!
#. fr: Victoire, les amis<nbsp>!
msgctxt "NpcYell:11649:0:13"
msgid "Victory is ours!"
msgstr "Победа за нами!"

#. ja: ふひー…<br>よかった…！
#. de: Puh, ging noch mal gut aus!
#. fr: Tout est bien qui finit bien<nbsp>!
msgctxt "NpcYell:11650:0:13"
msgid "Phew...what a relief!"
msgstr "Фух... Ну и хорошо!"

#. ja: お兄ちゃんたち<br>すごい、すごーい！
#. de: Du bist ein Held, Bruder!
#. fr: Brrravo, t'es trop fort<nbsp>!
msgctxt "NpcYell:11651:0:13"
msgid "Oh, Brother, you were amazing out there!"
msgstr "Братик, ты был просто чудо!"

#. ja: 負けるな！
#. de: Nicht nachlassen!
#. fr: Les bombarrrdos ne passeront pas<nbsp>!
msgctxt "NpcYell:11652:0:13"
msgid "No Bombard will pass!"
msgstr "Ни одно бомбардо не пройдёт!"

#. ja: うおおッ、やったぜッ！
#. de: Jaaa!
#. fr: Bien joué, les gars<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11653:0:13"
msgid "Now <i>that</i> was a fight!"
msgstr "Вот <i>это</i> была битва!"

#. ja: ありがとう<br>みなさん、お疲れ様～！
#. de: Ihr wart toll!
#. fr: Merrrci à tous, vous êtes géniaux<nbsp>!
msgctxt "NpcYell:11654:0:13"
msgid "Thank you, my friends!"
msgstr "Спасибо вам, друзья!"

#. ja: 私の実力では…
#. de: Ich bin stolz auf mich!
#. fr: Argh... Mon sang se glace peu à peu...
msgctxt "NpcYell:11655:0:13"
msgid "Is this where I fall...?"
msgstr "Неужели... здесь мне и суждено пасть?.."

#. ja: マージャ…<br>ごめん、兄ちゃんは…
#. de: R'majha ... Es tut mir leid ...
#. fr: Désolé, sœurrrette...
msgctxt "NpcYell:11656:0:13"
msgid "Majha! Forgive your brother's failure..."
msgstr "Маджа... прости, брат тебя подвёл..."

#. ja: アイスボンバードちゃん…<br>つよいーね…
#. de: Bumm! Aus, vorbei ... Hihi.
#. fr: Zut, j'étais trop près du boum, oui...
msgctxt "NpcYell:11657:0:13"
msgid "Ba Go is no match for your beautiful booms..."
msgstr "Ледяные бомбардо Ба Го... вы так сильны..."

#. ja: うぐっ…！
#. de: Ugh ...
#. fr: Urgh...
msgctxt "NpcYell:11658:0:13"
msgid "Urgh..."
msgstr "У-ух..."

#. ja: だ、駄目だ…
#. de: E-Es ist vorbei ...
#. fr: J'en... peux plus...
msgctxt "NpcYell:11659:0:13"
msgid "Th-They're too strong!"
msgstr "Н-нам их не одолеть..."

#. ja: た、たいへん…！<br>お兄ちゃん…！
#. de: Oh nein! Bruder ...
#. fr: Grand frèrrre<nbsp>!! Relève-toi, je t'en supplie<nbsp>!
msgctxt "NpcYell:11660:0:13"
msgid "Brother! Come back to us! Brother!"
msgstr "Братик! Очнись! Братик!"

#. ja: ま、負けたのか！？
#. de: I-Ihr habt verloren?!
#. fr: Oh non<nbsp>! On va tous devenirrr des glaçons<nbsp>!?
msgctxt "NpcYell:11661:0:13"
msgid "Are we all going to freeze to death?"
msgstr "Неужели мы все замёрзнем насмерть?"

#. ja: うそ…逃げなきゃ…！
#. de: Bringt euch in Sicherheit!
#. fr: Les glaçons, c'est bon pourrr les boissons<nbsp>! Fuyoooons<nbsp>!
msgctxt "NpcYell:11662:0:13"
msgid "Flee! Flee for your lives!"
msgstr "Бегите! Спасайтесь!"

#. ja: 勝利の荒鷲に続けッ！
#. de: Auf sie! Für Bozja!
#. fr: L'aigle va encore frapper<nbsp>!
msgctxt "NpcYell:11663:0:13"
msgid "Today, victory shall be ours! For Bozja!"
msgstr "Сегодня победа будет за нами! За Бозью!"

#. ja: グンヒルドの剣が<br>我らの御旗ッ！
#. de: Wir tragen die Standarte der Königinnenwache!
#. fr: Les lames de Gunnhildr sont là pour défendre notre drapeau<nbsp>!
msgctxt "NpcYell:11664:0:13"
msgid "The Blades shall be our banner!"
msgstr "Клинки станут нашим знаменем!"

#. ja: ボズヤに伝わる秘薬の力…<br>お受け取りを！
#. de: Empfangt die geheimen heilenden Kräfte unserer Ahnen!
#. fr: Vous allez tâter du savoir ancestral de Bozja<nbsp>!
msgctxt "NpcYell:11665:0:13"
msgid "Bozjans are more than just warriors. Our strength is your strength!"
msgstr "Бозийцы — не просто воины. Наша сила — ваша сила!"

#. ja: 大義のために…！
#. de: Es ist für die Gerechtigkeit!
#. fr: Pour la justice<nbsp>!
msgctxt "NpcYell:11666:0:13"
msgid "In the name of justice!"
msgstr "Во имя справедливости!"

#. ja: 同胞の未来…<br>守ってみせる！
#. de: Ich halte meine Hände schützend über die Zukunft meiner Landsleute.
#. fr: Je défendrai l'avenir de mon peuple... Coûte que coûte<nbsp>!
msgctxt "NpcYell:11667:0:13"
msgid "I shall not fall, so that my allies may see the morrow!"
msgstr "Я не паду, чтобы мои союзники встретили новый день!"

#. ja: 盾になりますッ！<br>私から離れないで…！
#. de: Bleibt bei mir! Ich beschütze euch!
#. fr: Je vais servir de bouclier<nbsp>! Vite, derrière moi<nbsp>!
msgctxt "NpcYell:11668:0:13"
msgid "Allow me to be your shield! Stay close!"
msgstr "Позвольте мне стать вашим щитом! Держитесь рядом!"

#. ja: そこだ！
#. de: Da!
#. fr: Tiens<nbsp>!
msgctxt "NpcYell:11669:0:13"
msgid "Hah!"
msgstr "Ха!"

#. ja: これでも<br>上忍でござる！
#. de: Keinen Schritt weiter!
#. fr: Je n'en ai peut-être pas l'air, mais je suis un expert du ninjutsu<nbsp>!
msgctxt "NpcYell:11670:0:13"
msgid "Masterful ninjutsu takes on many forms!"
msgstr "Искусное ниндзюцу принимает разные формы!"

#. ja: 見切った！
#. de: Ich seh dich!
#. fr: Là, une faille<nbsp>!
msgctxt "NpcYell:11671:0:13"
msgid "Your technique is atrocious."
msgstr "Техника у тебя что надо..."

#. ja: いきます！
#. de: Los!
#. fr: Prenez ça<nbsp>!
msgctxt "NpcYell:11672:0:13"
msgid "Now!"
msgstr "Сейчас!"

#. ja: テヤッ！
#. de: Hua!
#. fr: Graaaah<nbsp>!
msgctxt "NpcYell:11673:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: ハアッ！
#. de: Haaa!
#. fr: Aaah<nbsp>!
msgctxt "NpcYell:11674:0:13"
msgid "Gaaah!"
msgstr "Га-а-а!"

#. ja: 穿つッ！
#. de: Treffer!
#. fr: Attention à la pointe de ma lance<nbsp>!
msgctxt "NpcYell:11675:0:13"
msgid "One more scar!"
msgstr "Добавлю ещё один шрам!"

#. ja: 甘いッ！
#. de: Nicht mit mir!
#. fr: Tu me mâches le travail<nbsp>!
msgctxt "NpcYell:11676:0:13"
msgid "Don't make this easy!"
msgstr "Не облегчайте мне работу!"

#. ja: ナグサの技を<br>受けてみよッ！
#. de: Mit lieben Grüßen aus Nagxia!
#. fr: Voilà comment on se bat en Nagxia<nbsp>!
msgctxt "NpcYell:11677:0:13"
msgid "This is how we fight in Nagxia!"
msgstr "Вот так сражаются в Нагксии!"

#. ja: ググゥ…！
#. de: Grrr ...
#. fr: Grrr...<nbsp>!
msgctxt "NpcYell:11678:0:13"
msgid "Grrr!"
msgstr "Р-р-р!"

#. ja: ガアッ…！
#. de: Gaaah ...!
#. fr: Grraah<nbsp>!
msgctxt "NpcYell:11679:0:13"
msgid "Grrraaah!"
msgstr "Гр-р-а-а!"

#. ja: ヌオォォッ！
#. de: Uoooh!
#. fr: Gnnuoooh<nbsp>!!!
msgctxt "NpcYell:11680:0:13"
msgid "Gruooohhh!"
msgstr "Гр-у-у-у!"

#. ja: 抗う力でッ！
#. de: Ich halte dagegen!
#. fr: La flamme de la rébellion brûle dans mon cœur<nbsp>!
msgctxt "NpcYell:11681:0:13"
msgid "We will never surrender!"
msgstr "Мы никогда не сдадимся!"

#. ja: 私だって<br>グンヒルドの剣です！
#. de: Ich bin Gunnhildrs Klinge!
#. fr: Moi aussi, je suis une lame de Gunnhildr<nbsp>!
msgctxt "NpcYell:11682:0:13"
msgid "I am Gunnhildr's blade!"
msgstr "Я тоже Клинок Гуннхильдр!"

#. ja: ふたつのマナを<br>束ねてッ…！
#. de: Mit der Kraft von zweien!
#. fr: Je contrôle les manas blanche et noire<nbsp>!
msgctxt "NpcYell:11683:0:13"
msgid "The twin facets of mana are at my beck and call!"
msgstr "Обе грани маны мне подвластны!"

#. ja: 信じる道のために…！
#. de: Meine Überzeugung wird mich tragen!
#. fr: Je me battrais toujours pour défendre ce en quoi je crrrois<nbsp>!
msgctxt "NpcYell:11684:0:13"
msgid "I shall forge a path of my own making!"
msgstr "Я сама проложу себе путь!"

#. ja: 好きにはさせない！
#. de: Das lasse ich nicht zu!
#. fr: Je ne vous laisserai pas fairrre<nbsp>!
msgctxt "NpcYell:11685:0:13"
msgid "I don't think so!"
msgstr "Не бывать этому!"

#. ja: 聖なる光を！
#. de: Das heilige Licht!
#. fr: La lumièrrre divine<nbsp>!
msgctxt "NpcYell:11686:0:13"
msgid "Bask in divine light!"
msgstr "Узрите божественный свет!"

#. ja: ボズヤのために！
#. de: Für Bozja!
#. fr: Pour Bozja<nbsp>!
msgctxt "NpcYell:11687:0:13"
msgid "For Bozja!"
msgstr "За Бозью!"

#. ja: 故郷を奪還する！
#. de: Dieses Land gehört uns!
#. fr: Nous allons reconquérir notre patrie<nbsp>!
msgctxt "NpcYell:11688:0:13"
msgid "We shall reclaim our home!"
msgstr "Мы вернём родину!"

#. ja: 自由を我が手に！
#. de: Niemand nimmt uns unsere Freiheit!
#. fr: Pour la liberté<nbsp>!
msgctxt "NpcYell:11689:0:13"
msgid "We shall wrest freedom from the clutches of tyrants!"
msgstr "Вырвем свободу из лап тиранов!"

#. ja: 圧政者どもめ！
#. de: Ihr gemeinen Unterdrücker!
#. fr: Sus à l'ennemi<nbsp>!
msgctxt "NpcYell:11690:0:13"
msgid "Our oppressors shall pay for their sins!"
msgstr "Наши угнетатели ответят за свои грехи!"

#. ja: 押せ、押せ！
#. de: Weiter! Druck machen!
#. fr: En avant<nbsp>! Allez<nbsp>!
msgctxt "NpcYell:11691:0:13"
msgid "Go! Push them back!"
msgstr "Вперёд! Тесните их!"

#. ja: グンヒルドの剣に続け！
#. de: Kein Vergeben, kein Vergessen!
#. fr: Suivez les lames de Gunnhildr<nbsp>!
msgctxt "NpcYell:11692:0:13"
msgid "Follow the Blades!"
msgstr "За Клинками!"

#. ja: やらせぬッ！
#. de: Eure Invasion ist jetzt zu Ende!
#. fr: Tu ne passeras pas<nbsp>!
msgctxt "NpcYell:11693:0:13"
msgid "You shall not pass!"
msgstr "Не пройдёшь!"

#. ja: 受けてみよ！
#. de: Seht ihr das?
#. fr: Prenez ça<nbsp>!
msgctxt "NpcYell:11694:0:13"
msgid "Haaah!"
msgstr "Ха-а-а!"

#. ja: これがボズヤの民の力だ！
#. de: Das ist die Stärke Bozjas!
#. fr: C'est ça, la force du peuple de Bozja<nbsp>!
msgctxt "NpcYell:11695:0:13"
msgid "Witness the strength of Bozja!"
msgstr "Узрите силу Бозьи!"

#. ja: この勝利が自由に通じる！
#. de: Ein Sieg für die Freiheit!
#. fr: Pour la victoire<nbsp>! Pour la liberté<nbsp>!
msgctxt "NpcYell:11696:0:13"
msgid "Today we pave the way to freedom!"
msgstr "Сегодня мы проложим путь к свободе!"

#. ja: 見たか！<br>我らの底力を！
#. de: Haha! So kämpft der Widerstand!
#. fr: Vous avez vu ça<nbsp>! Admirez ma force<nbsp>!
msgctxt "NpcYell:11697:0:13"
msgid "Now you know what we're made of!"
msgstr "Теперь вы знаете, на что мы способны!"

#. ja: 帝国軍になど<br>負けるものか！
#. de: Wir werden nicht verlieren!
#. fr: Les Impériaux ne peuvent rien contre nous<nbsp>!
msgctxt "NpcYell:11698:0:13"
msgid "The imperial army will crumble before us!"
msgstr "Имперская армия падёт перед нами!"

#. ja: ボズヤ解放のために！
#. de: Für den Widerstand aller Länder!
#. fr: Bozja sera la prochaine nation à être libérée<nbsp>!
msgctxt "NpcYell:11699:0:13"
msgid "For the liberation!"
msgstr "За освобождение!"

#. ja: 帝国軍、何するものぞ！
#. de: Nieder mit dem Kaiserreich!
#. fr: Voilà tout ce dont les Impériaux sont capables<nbsp>!?
msgctxt "NpcYell:11700:0:13"
msgid "The full might of the Empire is helpless before us!"
msgstr "Вся мощь Империи бессильна против нас!"

#. ja: 逃げろ、逃げるんだ…！
#. de: Flieht, flieht!
#. fr: Retraite<nbsp>! Il faut battre en retraite<nbsp>!
msgctxt "NpcYell:11701:0:13"
msgid "We've lost! Retreat!"
msgstr "Мы проиграли! Отступаем!"

#. ja: 帝国の力…<br>侮れないな…
#. de: Die Garlear sind zu stark!
#. fr: L'ennemi est plus fort qu'on ne l'imaginait...
msgctxt "NpcYell:11702:0:13"
msgid "The Garleans are too strong!"
msgstr "Гарлеанцы слишком сильны!"

#. ja: 悔しいが…<br>ここは退くしか…！
#. de: Verdammt. Hier kommen wir nicht durch.
#. fr: C'est rageant mais... il faut se replier<nbsp>!
msgctxt "NpcYell:11703:0:13"
msgid "Curses... We must retreat!"
msgstr "Проклятье... Нам придётся отступить!"

#. ja: ダ、ダメだ…<br>支えきれない…！
#. de: Es reicht nicht!
#. fr: A-argh<nbsp>! On ne tiendra plus longtemps comme ça...
msgctxt "NpcYell:11704:0:13"
msgid "Gaaah! We can go on no longer!"
msgstr "Га-а-а! Больше мы не выдержим!"

#. ja: この屈辱…<br>忘れぬぞ…
#. de: So eine Schande ...
#. fr: Voilà un revers que je n'oublierai pas si tôt...
msgctxt "NpcYell:11705:0:13"
msgid "The shame of defeat is bitter indeed..."
msgstr "Горечь поражения... не забуду этого позора..."

#. ja: 退け、退けーッ！
#. de: Rückzug, Rückzug!
#. fr: Retraite<nbsp>! Retraite<nbsp>!
msgctxt "NpcYell:11706:0:13"
msgid "Fall back! Fall back!"
msgstr "Отступаем! Отступаем!"

#. ja: こんなところで…
#. de: Ausgerechnet jetzt ...
#. fr: Non... Pas comme ça...
msgctxt "NpcYell:11707:0:13"
msgid "Not now... Not here..."
msgstr "Только не сейчас... Не здесь..."

#. ja: 油断したと…<br>いうのですか…
#. de: Habe ich mich also geirrt?
#. fr: Ghh... Aurais-je été imprudent<nbsp>?
msgctxt "NpcYell:11708:0:13"
msgid "Ugh... Where did we go wrong?"
msgstr "Ух... Где же мы ошиблись?"

#. ja: ぐっ…！
#. de: Nein, bitte!
#. fr: Ghhargh...
msgctxt "NpcYell:11709:0:13"
msgid "Uuugh..."
msgstr "А-а-а..."

#. ja: ま、まだ…<br>戦わなけ、れば…
#. de: Ich muss ... weiterkämpf...
#. fr: Je... Je ne dois pas fléchir...
msgctxt "NpcYell:11710:0:13"
msgid "No...I can still...fight..."
msgstr "Н-но я ещё... могу... сражаться..."

#. ja: ぬかった…
#. de: Ich bin besiegt.
#. fr: Je me suis laissé... avoir...
msgctxt "NpcYell:11711:0:13"
msgid "I was careless..."
msgstr "Я допустил ошибку..."

#. ja: ここまででござるか…
#. de: Danke für dieses Leben.
#. fr: Mon destin est-il de périr sur ces plateaux...<nbsp>?
msgctxt "NpcYell:11712:0:13"
msgid "Is this...where I meet my end?"
msgstr "Неужели... здесь мой конец?"

#. ja: ハァ、ハァ…
#. de: Ha ... Ha ...
#. fr: Aaah... Aaah...
msgctxt "NpcYell:11713:0:13"
msgid "Ugh... Aaagh..."
msgstr "Уф... Ах..."

#. ja: 面目ありません…
#. de: Ein letztes Haiku ...
#. fr: Une fin... indigne de moi...
msgctxt "NpcYell:11714:0:13"
msgid "I've shamed myself..."
msgstr "Я опозорился..."

#. ja: ま、負けられない<br>戦いだというのに…
#. de: Ich dachte, der Sieg ist sicher ...
#. fr: Non... Nous devons remporter à tout prix cette victoire...
msgctxt "NpcYell:11715:0:13"
msgid "No... Victory was all but guaranteed..."
msgstr "Нет... Победа была почти у нас в руках..."

#. ja: この程度の傷で…<br>動けぬとは…
#. de: Argh, was für eine Wunde ...
#. fr: Cette petite plaie... a suffi à m'immobiliser...<nbsp>?
msgctxt "NpcYell:11716:0:13"
msgid "Such trifling wounds...shouldn't stop me..."
msgstr "Такие пустяковые раны... не должны меня остановить..."

#. ja: ヌグゥ…
#. de: Nichts wie weg!
#. fr: Nghh...
msgctxt "NpcYell:11717:0:13"
msgid "Ngh..."
msgstr "Нгх..."

#. ja: ……！！
#. de: Uah!
#. fr: ...<nbsp>!!
msgctxt "NpcYell:11718:0:13"
msgid "Ahhh!"
msgstr "А-а-а!"

#. ja: 抗う力が…<br>足りないというの…？
#. de: Die Kraft des Widerstands ... war nicht genug?
#. fr: La flamme qui m'habitait ne brûlait-elle pas assez fort...<nbsp>?
msgctxt "NpcYell:11719:0:13"
msgid "Are we doomed...to be ruled?"
msgstr "Неужели... нам суждено жить под чужой властью?"

#. ja: 私が未熟なばかりに…
#. de: Ich habe versagt ...
#. fr: La preuve que me je manque encore cruellement d'expérience...
msgctxt "NpcYell:11720:0:13"
msgid "I was foolish to think I was ready..."
msgstr "Я был глуп, раз решил, что готов..."

#. ja: 私では<br>救えないというの…
#. de: Du hast mir vertraut ...
#. fr: Je... Je n'aurais pas eu la forrrce de te sauver...
msgctxt "NpcYell:11721:0:13"
msgid "I can't...save anyone..."
msgstr "Я не могу... никого спасти..."

#. ja: モノセロス…<br>私は…！
#. de: Leb wohl, mein Liebling ...
#. fr: Mon fidèle compagnon... Je...<nbsp>!
msgctxt "NpcYell:11722:0:13"
msgid "I'm sorry... I've failed you..."
msgstr "Прости... Я подвёл тебя..."

#. ja: 頑張ってー！
#. de: Beweg die Hühnerbeine!
#. fr: Allez<nbsp>! Courage<nbsp>!
msgctxt "NpcYell:11723:0:13"
msgid "Move those tail feathers!"
msgstr "Давай, шевели хвостом!"

#. ja: オンドリが来るぞ！
#. de: Pass auf, der Hahn!
#. fr: Attention au coq<nbsp>!
msgctxt "NpcYell:11724:0:13"
msgid "Careful of that rooster!"
msgstr "Осторожно, петух!"

#. ja: あの卵が拾えそう！
#. de: Schnell, schnapp dir eins!
#. fr: Un œuf sans sur<shy>veil<shy>lan<shy>ce, allez-y<nbsp>! C'est le moment ou jamais<nbsp>!
msgctxt "NpcYell:11725:0:13"
msgid "Quick! Grab that one!"
msgstr "Скорее! Хватай то яйцо!"

#. ja: 怪我しないように！
#. de: Pass auf deine Finger auf!
#. fr: Attention à ne pas vous blesser<nbsp>!
msgctxt "NpcYell:11726:0:13"
msgid "Try not to lose any fingers!"
msgstr "Смотри пальцы не оттяпай!"

#. ja: 解放者殿！<br>こちらへ…！
#. de: Hier rüber, <split " " 1><string $gs1></split>!
#. fr: <split " " 1><string $gs1></split><nbsp>! Par ici<nbsp>!
#. macro: <split " " 2><string $gs1></split> — the last name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:11727:0:13"
msgid "Blade <split \" \" 2><string $gs1></split>, over here!"
msgstr "Клинок <split \" \" 2><string $gs1></split>, сюда!"

#. ja: 魔導部品を入手したら<br>こちらへ…！
#. de: Wenn du ein Magitek-Teil findest, bring es zu mir!
#. fr: Revenez me voir pour me livrer les composants magitek<nbsp>!
msgctxt "NpcYell:11728:0:13"
msgid "Bring the components to me!"
msgstr "Принесите мне детали!"

#. ja: カラクリ兵器が<br>ゾロゾロと…
#. de: Das sind aber viele garleische Maschinen!
#. fr: Les automates impériaux pullulent...
msgctxt "NpcYell:11729:0:13"
msgid "Now is the moment to strike."
msgstr "Пора нанести удар."

#. ja: 今なら奇襲できますね
#. de: Das ist der Moment zum Angriff.
#. fr: Le moment parfait pour les assaillir...
msgctxt "NpcYell:11730:0:13"
msgid "I stand ready, Master."
msgstr "Я готова, господин."

#. ja: ゆくぞ、ツバメ！<br>気配を絶って接近するぞ！
#. de: Los, Tsubame! Nichts wie ran!
#. fr: En avant, Tsubame<nbsp>! Frappons vite et fort sans nous faire repérer<nbsp>!
msgctxt "NpcYell:11731:0:13"
msgid "Let us go, Tsubame!"
msgstr "Вперёд, Цубамэ!"

#. ja: 承知…！
#. de: Verstanden!
#. fr: Bien compris<nbsp>!
msgctxt "NpcYell:11732:0:13"
msgid "Understood!"
msgstr "Понял!"

#. ja: ゴホッ…！<br>ふ、不覚…！
#. de: Argh! Ich hab nicht aufgepasst ...
#. fr: Gargh... Quelle erreur de ma part...<nbsp>!
msgctxt "NpcYell:11733:0:13"
msgid "Ugh... I was careless..."
msgstr "Ух... Я был неосторожен..."

#. ja: く、悔しい…
#. de: So ein Mist.
#. fr: Ça n'aurait pas dû... se passer comme ça...
msgctxt "NpcYell:11734:0:13"
msgid "Confound it..."
msgstr "Чёрт..."

#. ja: 任務完了です！<br>みなさん、協力に感謝いたします！
#. de: Mission erfüllt! Gute Arbeit, Leute!
#. fr: J'ai ce qu'il me faut<nbsp>! Beau travail, tout le monde<nbsp>!
msgctxt "NpcYell:11735:0:13"
msgid "Mission accomplished! Well done, everyone!"
msgstr "Задание выполнено! Отличная работа, всем спасибо!"

#. ja: だ、駄目か…<br>撤退しましょう！
#. de: Es bringt nichts ...<br>Zurück!
#. fr: Nous... Nous avons échoué<nbsp>!? Retraite<nbsp>!
msgctxt "NpcYell:11736:0:13"
msgid "This bodes ill... We must retreat!"
msgstr "Дело плохо... Надо отступать!"

#. ja: 助太刀に感謝する！
#. de: Vielen Dank für die Unterstützung!
#. fr: Merci pour votre aide<nbsp>!
msgctxt "NpcYell:11737:0:13"
msgid "My thanks for your aid."
msgstr "Благодарю за помощь."

#. ja: やりましたね！<br>我が方の勝利です！
#. de: Geschafft! Der Sieg ist unser.
#. fr: Nous avons réussi<nbsp>! La victoire est nôtre<nbsp>!
msgctxt "NpcYell:11738:0:13"
msgid "Victory is ours!"
msgstr "Победа за нами!"

#. ja: フッ…ググゥ…<br>退路…フッ！
#. de: Gua! Rennen ... Grr, grruh.
#. fr: Grrr...<nbsp>! Rat<nbsp>! Ha ha ha<nbsp>!
msgctxt "NpcYell:11739:0:13"
msgid "Grah hah! TRAPPED! Grahaha!"
msgstr "Гр-р-ха! ВЫХОДА НЕТ! Га-ха-ха!"

#. ja: なっ、さらなる援軍だと……！？
#. de: Was? Da kommt Verstärkung?
#. fr: D'autres rebelles<nbsp>!?
msgctxt "NpcYell:11740:0:13"
msgid "What!? More reinforcements!?"
msgstr "Что?! Ещё подкрепление?!"

#. ja: ええい、我が命運もここまでか……！
#. de: Das könnte unser Ende sein.
#. fr: Ainsi s'achève mon rêve...<nbsp>?
msgctxt "NpcYell:11741:0:13"
msgid "Is this where we meet our fate?"
msgstr "Неужели здесь нам и суждено погибнуть?"

#. ja: キヒッ……ヤマツミ殿、<br>随分と追い詰められているようじゃないか？
#. de: Hehe. Du bist umzingelt, Yamatsumi.
#. fr: Hé hé hé... Yamatsumi... Vous m'avez l'air le dos au mur.
msgctxt "NpcYell:11742:0:13"
msgid "Heh heh heh... You seem to be hard-pressed, my dear Yamatsumi."
msgstr "Хи-хи... Ямамицу, похоже, тебя крепко прижали к стенке."

#. ja: 『退路は完全に塞いだ』と…<br>そういうことです。
#. de: Das nennt man wohl „in die Falle getappt“.
#. fr: Oui, il est fait comme un rat, en effet.
msgctxt "NpcYell:11743:0:13"
msgid "Your escape has been cut off. You're trapped."
msgstr "Путь к отступлению отрезан. Вы в ловушке."

#. ja: だが、心配はいらない。<br>お前の「切なる願い」は、きっとこの聖石片に届くさ……。
#. de: Aber keine Sorge, die Rettung ist nah. Dieser Splitter wird dir jeden Wunsch erfüllen.
#. fr: Ne désepérez pas... Votre vœu peut encore se réaliser grâce aux auralithes sacrées...
msgctxt "NpcYell:11745:0:13"
msgid "But worry not, for your salvation has arrived. Speak your heart's most earnest wish to the relic I bear, and the path to it shall open."
msgstr "Но не тревожься: спасение уже близко. Открой реликвии сокровенное желание — и путь к нему будет открыт."

#. ja: ダボグさん……！<br>さぁ、私たちと共に帰りましょう！
#. de: Dabog! Komm mit uns zurück!
#. fr: Dabog<nbsp>! Il est temps que tu reviennes parmi les tiens<nbsp>!
msgctxt "NpcYell:11746:0:13"
msgid "Please, Dabog! Come back with us!"
msgstr "Прошу, Дабог! Возвращайся с нами!"

#. ja: 愚かな、レジスタンスどもめ……。<br>そこにいるのは、お前たちの知るダボグなる男ではない。
#. de: Narren! Vor euch steht nicht Dabog!
#. fr: *Prscht* Imbéciles... L'homme qui se trouve devant vous n'est plus celui que vous avez connu.
msgctxt "NpcYell:11747:0:13"
msgid "\\<bzzzt> Fools. The thing that stands before you is not Dabog."
msgstr "\\<бзззт> Глупцы. Перед вами не тот Дабог, которого вы знали."

#. ja: 「切なる願い」だと……！？<br>我が願いは、新たなる祖国での一族の再興……それだけだ！
#. de: Ich habe nur einen Wunsch: Dass sich alle Onmyoji unter einem Banner versammeln und ein neues Reich gründen!
#. fr: Comment<nbsp>!? Je ne souhaitais qu'une chose... une nouvelle patrie pour notre clan<nbsp>! Et voilà comme tout cela fini...
msgctxt "NpcYell:11748:0:13"
msgid "I...I have only one wish: to see the onmyoji revived under the flag of a new nation!"
msgstr "Я... я хочу лишь одного: чтобы оммёдзи возродились под знаменем новой страны!"

#. ja: なんだ……声が……石から声が、聞こえる……。<br>う、うう、うがあぁぁぁぁ！！
#. de: Hm? Höre ich da eine Stimme aus dem Stein kommen? Das ist ja ... Ah! Aaaah!
#. fr: Quoi...<nbsp>? Cette pierre... C'est comme si... elle me parlait... Elle... Elle... HAAAAA<nbsp>!!! GWAAAAH<nbsp>!!!
msgctxt "NpcYell:11749:0:13"
msgid "Huh? There's a voice...a voice coming from the stone. I can... I─ Ungaaah! GWAAAH!!!"
msgstr "Что? Голос... из камня доносится голос... Я... Я... А-а-а! ГВА-А-А-А!"

#. ja: 魔導兵器の性能を究極的に引き上げるべく、<br>最新技術を投入して開発した生体部品なのだ！
#. de: Es ist der Zenit unserer Forschung. Etwas, das das Potenzial der Magitek-Waffen vertausendfacht. Eine lebende Maschinenkomponente!
#. fr: C'est un engrenage vivant, le nec plus ultra de la technologie destiné à extraire le maximum du potentiel de nos armures magitek<nbsp>!
msgctxt "NpcYell:11750:0:13"
msgid "No, it is an organic component─one designed to extract the most out of our weaponry!"
msgstr "Нет, это органический компонент, созданный, чтобы выжать из нашего оружия максимум!"

#. ja: キヒッ……ヒヒヒヒヒヒヒ……！<br>ほうら、やっぱり届いたじゃないか、ヒヒヒヒヒヒ……！
#. de: Hahaaa! Der Splitter tut, wie ihm geheißen!
#. fr: Ha ha ha ha ha<nbsp>! Vous voyez<nbsp>!? Elle a répondu à votre appel<nbsp>!
msgctxt "NpcYell:11751:0:13"
msgid "Hahaha! Haaahaha! Your wish is the relic's command!"
msgstr "Ха-ха-ха! Вот видишь? Реликвия исполнила твоё желание!"

#. ja: よし……精神呪縛も完璧のようだな……。<br>ゆけ、オレの新しい人形、ルカヴィとなりし者よ！
#. de: Ihr lebt nun unter meinem Banner, gehorcht meinen Befehlen! In meinem Reich der Puppen!
#. fr: Oui, parfait<nbsp>! J'ai le contrôle<nbsp>! En avant, ma marionnette rukavi<nbsp>!
msgctxt "NpcYell:11752:0:13"
msgid "You live now under my flag, puppets to obey my every command! You shall be revived, oh yes, and more majestically than you have ever dreamed!"
msgstr "Теперь вы под моим знаменем, мои марионетки, послушные каждому приказу! Возродитесь же... да, станьте величественнее, чем могли мечтать!"

#. ja: ヤマツミを…<br>生贄に！？
#. de: Er bringt Yamatsumi unter seine Kontrolle!
#. fr: Il a sacrifié Yamatsumi pour réaliser son invocation<nbsp>!
msgctxt "NpcYell:11753:0:13"
msgid "He's using Yamatsumi as fodder for his summoning!"
msgstr "Он использует Ямамицу как топливо для призыва!"

#. ja: ググゥ…<br>外道…フッ！
#. de: Grrr ... Ketzer ... Uhu.
#. fr: Grrr... Démon<nbsp>!
msgctxt "NpcYell:11754:0:13"
msgid "Grrrgh. Evil! Urrrgh!"
msgstr "Гр-р... Зло! У-р-р!"

#. ja: 『外道の所業』と<br>言いたいのね、同感よ
#. de: Das Werk eines Ketzers, in der Tat. Gut gesprochen.
#. fr: Pour une fois, je n'ai rien à ajouter...
msgctxt "NpcYell:11755:0:13"
msgid "One evil deed after another, he says. This man seems partial to them."
msgstr "Он говорит: «Одно злодеяние за другим». Похоже, этот человек ими увлекается."

#. ja: 一族を…再興すル…
#. de: Die Onmyoji ... werden sich wieder erheben.
#. fr: Mon clan... renaîtra de ses cendres...
msgctxt "NpcYell:11756:0:13"
msgid "The onmyoji...shall return..."
msgstr "Оммёдзи... возродятся..."

#. ja: ノア様の…新王国デ…
#. de: Für Lord Noah ... Ein neues Reich ...
#. fr: Noah fondera... une nation plus juste...
msgctxt "NpcYell:11757:0:13"
msgid "For Lord Noah... To birth his nation..."
msgstr "Для лорда Ноя... Чтобы основать его страну..."

#. ja: キヒッ……押し負けはしたが……<br>聖石片の力……しかと、確認させてもらったぞ。
#. de: Eine Niederlage, aber eine nützliche. Jetzt kenne ich die Kraft der Auracitensplitter.
#. fr: Ha ha... Je reconnais ma défaite. Mais elle m'aura permis d'évaluer le potentiel des auralithes sacrées.
msgctxt "NpcYell:11758:0:13"
msgid "Hahaha. A defeat, perhaps, but a fruitful one. I have seen the measure of the relic's strength, and I am not left wanting."
msgstr "Ха-ха-ха. Может, я и проиграл, зато увидел, на что способна реликвия. И увиденного мне вполне хватит."

#. ja: こ、この者たちは……いったい！？
#. de: Wer sind diese Soldaten? Warum sehen sie alle aus wie Dabog?
#. fr: Qui... Qui sont ces hommes<nbsp>!? Ils ressemblent à Dabog<nbsp>!
msgctxt "NpcYell:11759:0:13"
msgid "Wh-Who are these men!? Why do they all look like Dabog!?"
msgstr "К-кто эти люди?! Почему они все похожи на Дабога?!"

#. ja: ヤマツミでこの程度なら、オレ自身が使えば……！
#. de: Wenn Yamatsumi so eine Puppe abgibt, was würde dann wohl aus mir werden? Ha ha!
#. fr: Si Yamatsumi a pu devenir si puissant grâce à l'une d'elles, je n'imagine pas la puissance que je serai capable de déployer<nbsp>! Ha ha ha<nbsp>!
msgctxt "NpcYell:11761:0:13"
msgid "If Yamatsumi can make such a puissant puppet, what power would the master himself produce?"
msgstr "Если Ямамицу стал такой могущественной марионеткой, чего же добьюсь я, её хозяин?"

#. ja: フッ……ググゥ……<br>哀れ……フッ！
#. de: Grrr ... Mitleid ... Guaga.
#. fr: Grrr... Yamatsumi... Triste... Hmpf<nbsp>!
msgctxt "NpcYell:11762:0:13"
msgid "Grrr. Pity. Urgh."
msgstr "Гр-р... Жалость. У-р-р..."

#. ja: 『ヤマツミという男、哀れなり』と言いたいのね？<br>たしかに……願いによって異形に堕ちるだなんて……。
#. de: Du meinst, du hast Mitleid mit Yamatsumi? Nun, er hat bekommen, was er sich gewünscht hat. Auf eine gewisse Art.
#. fr: Il a connu une bien triste fin, oui... Son rêve l'aura consumé...
msgctxt "NpcYell:11763:0:13"
msgid "He has pity for Yamatsumi. I see why... They were given their wish, albeit a warped and twisted version of it."
msgstr "Он жалеет Ямамицу. Понимаю почему... Желание исполнилось, пусть и в извращённом виде."

#. ja: ええ、本当に……。<br>そして、変異に使われていた聖石片という存在、危険です……。
#. de: Er hat schon vor langem den falschen Weg eingeschlagen. Und dieser Splitter, der ist wirklich nicht zu unter<shy>schätzen.
#. fr: En effet. Quant à ces auralithes sacrées, elles sont trop dangereuses pour en rester là.
msgctxt "NpcYell:11764:0:13"
msgid "A cruel fate, even for one so misguided. Such terrifying power should not be in the hands of one so depraved."
msgstr "Жестокая судьба, даже для такого заблудшего человека. Нельзя позволять таким ужасным силам попасть в руки столь испорченных людей."

#. ja: ジルブリスベルと言ったか、<br>あの男を、全力で止めなければならないでござる。
#. de: Wir müssen diesen Gilbrisbert aufhalten, mit allen Mitteln.
#. fr: Cet homme s'appelait Gilbrisbert, c'est bien ça<nbsp>? Nous devrons l'arrêter par tous les moyens nécessaires.
msgctxt "NpcYell:11765:0:13"
msgid "We must take every measure to stop him. Muster every last onze of our strength."
msgstr "Надо остановить этого Джилбрисберта любой ценой. Соберём все силы, какие есть."

#. ja: お～い、絨毯！
#. de: Los, an die Arbeit, Teppich!
#. fr: Ohé<nbsp>! Tapis de pacotille<nbsp>!
msgctxt "NpcYell:11766:0:13"
msgid "Time to wake up, you dusty things."
msgstr "Ну-ка, просыпайтесь, пыльные ковры!"

#. ja: 風精め、もう飽きたのかい…
#. de: Selbst die Windfee hat genug von dir<nbsp>...
#. fr: Même l'élémentaire s'est lassé de vous...
msgctxt "NpcYell:11767:0:13"
msgid "Even they tire of your company..."
msgstr "Даже они устали от твоей компании..."

#. ja: ヒヒヒ…！<br>聖石片、素晴らしいぞ！
#. de: Muhaha! Die Auracitensplitter sind wunderbar, ein Geschenk der Götter!
#. fr: Gnin hin hin<nbsp>! Ces auralithes sacrées sont un don du ciel<nbsp>!
msgctxt "NpcYell:11768:0:13"
msgid "Mwahaha! The relic is splendid, absolutely splendid!"
msgstr "Муа-ха-ха! Реликвия чудо как хороша! Просто чудо!"

#. ja: くっ…撤退して<br>仕切り直すでござる！
#. de: Das sind zu viele. Wir müssen uns zurückziehen und neu formieren!
#. fr: Nous ne pourrons pas le vaincre<nbsp>! Pas cette fois<nbsp>! Fuyons<nbsp>!
msgctxt "NpcYell:11769:0:13"
msgid "We're outmatched! We must retreat and regroup!"
msgstr "Нас превосходят числом! Надо отступить и перегруппироваться!"

#. ja: 面目ありません…
#. de: Welch Schande ...
#. fr: Je suis... désolée...
msgctxt "NpcYell:11770:0:13"
msgid "How shameful..."
msgstr "Какой позор..."

#. ja: ググゥ…<br>忍耐…フッ！
#. de: Grrr ... Geduld ... Guaaah.
#. fr: Grrr... Remise... Hmpf<nbsp>!
msgctxt "NpcYell:11771:0:13"
msgid "Grrr! PATIENCE! Graaah!"
msgstr "Гр-р! ТЕРПЕНИЕ! Гр-а-а!"

#. ja: 『今は忍耐のとき』と<br>言うのですね…
#. de: Ja, wir müssen Geduld haben. Dieser Kampf wird an einem anderen Tag entschieden werden.
#. fr: Tout à fait, Kosyu<nbsp>! Ce n'est... que partie remise<nbsp>!
msgctxt "NpcYell:11772:0:13"
msgid "Yes, Kosyu. Now is the time for patience. We can fight another day."
msgstr "Да, Косю. Сейчас надо набраться терпения. Сразимся в другой раз."

#. ja: バックスタインの名を継ぎし、<br>我が首を獲って、武勲としたい者はおらぬかッ！
#. de: Ich kämpfe für die Ehre der Vochsteins! Wenn einer meint, er könnte die Allergrößte einen Kopf kleiner machen, dann soll er sich zeigen!
#. fr: Je défends l'honneur des Vochstein<nbsp>! Celui qui aura ma tête n'est pas encore né, mais approchez si vous l'osez<nbsp>!
msgctxt "NpcYell:11773:0:13"
msgid "I fight in the name of the Vochsteins! My head would make a worthy prize─not that any of you cowards could take it!"
msgstr "Я сражаюсь за честь Вохштейнов! Моя голова — достойная награда, только вот ни одному из вас, трусов, её не взять!"

#. ja: こちら第IV機械化歩兵小隊、敵からの攻撃を受けている！<br>至急、航空支援を要請するッ！
#. de: Wir werden angegriffen! Erbitte Luftunterstützung. Ich wiederhole: Erbitte Luftunterstützung!
#. fr: Ici la cohorte d'infanterie mécanisée<nbsp>! Nous sommes attaqués<nbsp>! Nous requérons un soutien aérien de toute urgence<nbsp>!
msgctxt "NpcYell:11774:0:13"
msgid "We are under attack! Repeat: we are under attack! Requesting air support!"
msgstr "Мы под атакой! Повторяю: мы под атакой! Запрашиваем авиационную поддержку!"

#. ja: すでに「量産」に成功しているということだよ。<br>さあ、我が強化兵部隊よ、レジスタンスどもを一掃するのだ！
#. de: Endlich kann der Magitek-Soldat in Serie produziert werden. Zerstört den Feind! Zermalmt den Widerstand!
#. fr: Voyons, un engrenage, ça se produit en masse<nbsp>! En avant, soldats<nbsp>! Je ne veux plus voir un rebelle en Zadnor<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11775:0:13"
msgid "Isn't it obvious? We have succeeded in mass-producing them.<br>Go forth, my enhanced soldiers! Go forth and destroy the enemy!"
msgstr "Разве не ясно? Мы наладили их массовое производство.<br>Вперёд, мои усиленные солдаты! Уничтожьте врага!"

#. ja: グッ……なんという圧力……！<br>退却、退却だ！
#. de: Sie überrennen uns! Zurück. Zurück!
#. fr: Tsss<nbsp>! On ne peut rien faire contre eux<nbsp>! Repliez-vous tous<nbsp>!
msgctxt "NpcYell:11776:0:13"
msgid "Damn it, they're too strong! Fall back! Fall back!"
msgstr "Чёрт, они слишком сильны! Отступаем! Отступаем!"

#. ja: 飛空戦艦隊に報告、レジスタンス部隊の撤退を確認！<br>航空支援に感謝する……！
#. de: Der Feind zieht sich zurück. Danke für die Luftunterstützung!
#. fr: Confirmation venant de notre soutien aérien<nbsp>! Les rebelles sont en déroute<nbsp>! Vous pourrez remercier nos pilotes quand on rentrera à la base<nbsp>!
msgctxt "NpcYell:11777:0:13"
msgid "The Resistance is withdrawing! Repeat: the Resistance is withdrawing! Much obliged for the air support!"
msgstr "Сопротивление отступает! Повторяю: Сопротивление отступает! Благодарим за авиационную поддержку!"

#. ja: お、おい…<br>あれを見ろ！
#. de: S-Seht euch das an!
#. fr: Oh, hé... Re-regarde ça<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11778:0:13"
msgid "Wh-What is <i>that</i>!?"
msgstr "Ч-что это <i>такое</i>?!"

#. ja: 古代獣…！？<br>なんて大きさだ！
#. de: Was für ein Riesenungetüm!
#. fr: Il est immense<nbsp>! On dirait un... un dinosaure<nbsp>!
msgctxt "NpcYell:11779:0:13"
msgid "Whatever it is, I've never seen one so big!"
msgstr "Что бы это ни было, такого огромного я ещё не видел!"

#. ja: つ、突っ込んで来るぞ！<br>応戦しろォッ！
#. de: E-Er hat uns gesehen! Bereitmachen!
#. fr: Il nous fonce dessus<nbsp>! En position<nbsp>!
msgctxt "NpcYell:11780:0:13"
msgid "I-It comes! Steel yourself!"
msgstr "О-оно несётся прямо на нас! Приготовиться!"

#. ja: ブオオオォォォォォォン！！
#. de: BHHUUUOOON!
#. fr: BHHHUUUÔÔÔN<nbsp>!!!
msgctxt "NpcYell:11781:0:13"
msgid "GrOAaARrRGgGH!"
msgstr "ГРО-А-А-А-А-Р-Р-Р!"

#. ja: いよぉ、解放者！　相変わらず大暴れしてるらしいなッ！<br>オレのところで働いてくれりゃ、言うことないのによッ……！
#. de: So sehen wir uns also wieder, <split " " 1><string $gs1></split>. Warum kämpfst du nicht für uns? Man würde dich fürstlich belohnen.
#. fr: Salut, toi<nbsp>! Toujours en train de te la donner à ce que je vois<nbsp>! Tu sais pas ce que tu rates en refusant de rejoindre ma bande<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:11782:0:13"
msgid "Oho, we meet again, <split \" \" 1><string $gs1></split>! Still fighting up a storm, I hear. You really ought to join us. I'd see to it you want for nothing."
msgstr "Ого, <split \" \" 1><string $gs1></split>, снова встретились! Слыхал, ты всё ещё знатно крушишь врагов. Вот бы ты к нам примкнул. Уж я бы позаботился, чтобы тебе ни в чём не нуждаться."

#. ja: だけどな、オレもそろそろ勧誘を諦めることにするぜッ……！<br>やられっぱなしじゃ、メンツに関わるんでなッ！
#. de: Ich weiß, du würdest niemals überlaufen. Deswegen kann es nur ein Ende geben.
#. fr: J'ai abandonné l'idée de te recruter cela dit. Les refus à coup de baffes, ça va bien deux minutes, mais j'ai une réputation à tenir, moi<nbsp>!
msgctxt "NpcYell:11783:0:13"
msgid "But I know a lost cause when I see one, and you can make a man beg only so many times."
msgstr "Но, похоже, тебя не переубедить. И сколько ни проси, мужчине тоже надо знать меру."

#. ja: このままでは…！<br>悔しいですが、撤退を…！
#. de: Das war's. Wir müssen uns zurückziehen.
#. fr: Nous n'allons pas tenir<nbsp>! Ravalons notre fierté et fuyons tant que nous le pouvons encore<nbsp>!
msgctxt "NpcYell:11784:0:13"
msgid "Not good... It pains to say this, but we must retreat!"
msgstr "Плохо дело... Как ни тяжело это признавать, нам надо отступить!"

#. ja: ようやく解放者殿の<br>勧誘を諦めたか…
#. de: Hat er seine Abwerbungsversuche endlich aufgegeben? Gut so.
#. fr: Il jette l'éponge<nbsp>? Ce n'est pas trop tôt...
msgctxt "NpcYell:11785:0:13"
msgid "Finally given up on trying to woo our friend, has he?"
msgstr "Наконец перестал уговаривать Клинок? Давно пора..."

#. ja: そんなわけで、オメェらまとめて……<br>チョコボの餌にしてやる、覚悟しやがれッ！
#. de: Doch für eins könnte ich dich noch gebrauchen ... als Chocobo-Futter! Ha haaa!
#. fr: Mais vous inquiétez pas, vous me serez utiles quand même<nbsp>! Vous allez nourrir mes chocobos<nbsp>! Bwahahaha<nbsp>!
msgctxt "NpcYell:11786:0:13"
msgid "So, with that out of the way, let's get right to business... You're all chocobo fodder!"
msgstr "Ладно, перейдём к делу... Вы все пойдёте на корм чокобо!"

#. ja: クエエェェッ！
#. de: Kweeeh!
#. fr: Kwéééé<nbsp>!
msgctxt "NpcYell:11787:0:13"
msgid "Kweeeh!"
msgstr "Квэээ!"

#. ja: 迎え討つぞ！
#. de: Auf sie!
#. fr: On y va<nbsp>!
msgctxt "NpcYell:11788:0:13"
msgid "We'll see about that!"
msgstr "Ну, это мы ещё посмотрим!"

#. ja: グハハハ！　やっぱり、見事な暴れっぷりだなッ！<br>気持ちがいいぜッ！
#. de: Hahaha! Was für ein wunderschöner Tumult!
#. fr: Ha ha ha<nbsp>! Qu'est-ce qu'on se marre<nbsp>! Ça faisait longtemps que je m'étais pas autant éclaté<nbsp>!
msgctxt "NpcYell:11789:0:13"
msgid "Gahahaha, there's nothing like a good rampage!"
msgstr "Га-ха-ха! Что может быть лучше хорошей драки!"

#. ja: そのぶん、オメェを倒せば報酬もデカいってことだッ！<br>手下に肉を食わせるために、やらせてもらうぜッ！
#. de: Du bist mir doch nicht böse, oder? Ich tu das alles nur, um meine gefiederten Freunde füttern zu können.
#. fr: Vous êtes des coriaces. Pas étonnant que la prime soit juteuse<nbsp>! Avec elle, je pourrai donner à bouffer à toutes mes bêtes<nbsp>!
msgctxt "NpcYell:11790:0:13"
msgid "No hard feelings, eh? At the end of the day, I just need the coin to feed my own."
msgstr "Без обид, а? Мне просто нужны деньги, чтобы прокормить своих."

#. ja: クエェェェェ！
#. de: Kweeeh!
#. fr: Kwééééé<nbsp>!
msgctxt "NpcYell:11791:0:13"
msgid "Kweeeh!"
msgstr "Квэээ!"

#. ja: 部下のために戦う姿は<br>共感できなくもないが…！
#. de: Natürlich, alles nur aus reiner Freundlichkeit ...
#. fr: Une noble intention, mais ça ne se passera pas comme ça<nbsp>!
msgctxt "NpcYell:11792:0:13"
msgid "Such touching concern for his underlings..."
msgstr "Как трогательно он заботится о подчинённых..."

#. ja: ええい、ここまでかッ！<br>だけどな、手下たちのためにも死ぬわけにはいかねえッ！
#. de: Verdammt! Ich darf hier nicht sterben! Jemand muss doch die Futtertröge füllen.
#. fr: Oh oh<nbsp>! Temps mort<nbsp>! Mes bêtes comptent sur moi pour les nourrir, alors je peux pas clamser ici<nbsp>!
msgctxt "NpcYell:11793:0:13"
msgid "Godsdammit... Sorry, but I can't afford to die here. Someone needs to put meat and mead on the table, see?"
msgstr "Чёрт побери... Извини, но я не могу тут помереть. Кому-то ведь надо кормить моих ребят!"

#. ja: 悪いが勝負は、お預けってことにさせてくれッ！<br>アバヨ、解放者！
#. de: Aber wir regeln das ein andermal! Bis bald, <split " " 1><string $gs1></split>!
#. fr: On se refait ça une autre fois, <split " " 1><string $gs1></split><nbsp>!? À la revoyure<nbsp>!
msgctxt "NpcYell:11794:0:13"
msgid "We'll settle this another time, I promise! So long!"
msgstr "В другой раз сойдёмся, обещаю! Бывай!"

#. ja: クェ…クェェ…
#. de: Kweh, kweh.
#. fr: Kwé... Kwéééé...
msgctxt "NpcYell:11795:0:13"
msgid "Kweh... Kweh..."
msgstr "Квэ... Квээ..."

#. ja: やれやれ……妙な男ですな……。
#. de: Seltsamer Vogel ... Dieser Daguza, mein ich.
#. fr: Décidément... Quel étrange personnage...
msgctxt "NpcYell:11796:0:13"
msgid "Quite a character, this Daguza..."
msgstr "Ну и ну... Дагуза тот ещё тип..."

#. ja: グハハハハ！　どうだオレたちの強さッ！<br>解放者よ、気が変わったら声をかけてくれよなッ！
#. de: Hahaha! Der Sieg gehört den Starken, und ich bin der Stärkste von allen!
#. fr: Bwahahaha<nbsp>! Alors<nbsp>!? On a du répondant, pas vrai<nbsp>!? Allez, si tu changes d'avis, ma porte reste ouverte<nbsp>!
msgctxt "NpcYell:11797:0:13"
msgid "Gahahaha! Victory belongs to the strong, and we're the strongest of all!"
msgstr "Га-ха-ха! Побеждает сильнейший, а сильнее нас никого нет!"

#. ja: 強くて頼れる奴は、いつでも歓迎させてもらぜッ！
#. de: Sag Bescheid, wenn du es dir anders überlegst, ja? Für dich ist immer ein Plätzchen frei.
#. fr: Je la ferme jamais à ceux qui ont du talent comme toi<nbsp>!
msgctxt "NpcYell:11798:0:13"
msgid "If you have a change of heart, just let me know, eh? We can never have too many strong people like you!"
msgstr "Передумаешь — дай знать, а? Нам такие сильные ребята, как ты, всегда нужны!"

#. ja: クエッ！<br>クエッ！
#. de: Kweh! Kweh!
#. fr: Kwé kwé kwé kwééé<nbsp>! Kwé kwé, kwé kwékwééé<nbsp>!
msgctxt "NpcYell:11799:0:13"
msgid "Kweh! Kweh!"
msgstr "Квэ! Квэ!"

#. ja: ヒュルルル…！
#. de: Quiiietsch!
#. fr: SKKRRCCHHH<nbsp>!!!
msgctxt "NpcYell:11800:0:13"
msgid "Hrrrgh! Hrrrk!"
msgstr "Хр-р-р! Хрк!"

#. ja: 旗艦ダル・リアータに<br>帰投する…！
#. de: Gut. Zurück zum Flaggschiff.
#. fr: Bien<nbsp>! Retournons sur le Dalriada<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11801:0:13"
msgid "Excellent. Let us return to the <i>Dalriada</i>."
msgstr "Отлично. Вернёмся на «<i>Далриаду</i>»."

#. ja: ふむ…<br>そろそろ帰投するか…
#. de: Wir sollten zurück zur <i>Dalriada</i>.
#. fr: Bonne idée.
msgctxt "NpcYell:11802:0:13"
msgid "We should be getting back."
msgstr "Пожалуй, пора возвращаться."

#. ja: 帰還して<br>次の任務に備えるぞ！
#. de: Uns erwartet bestimmt schon die nächste Mission.
#. fr: Nous nous y ravitaillerons avant de partir pour notre prochaine mission<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11803:0:13"
msgid "Back to the <i>Dalriada</i>. Our next mission awaits!"
msgstr "Назад на «<i>Далриаду</i>». Нас ждёт следующее задание!"

#. ja: ヒュールルル！
#. de: Quiiietsch!
#. fr: SKKRRCCHHH<nbsp>!!!
msgctxt "NpcYell:11804:0:13"
msgid "Hrrrk! Hrrrngh!"
msgstr "Хр-рк! Хр-рнг!"

#. ja: キヒッ……数で押してくるつもりなら……<br>こちらも人形たちを、使わせてもらおうじゃあないか！
#. de: Haha! Glaubt ihr, ihr wärt in der Überzahl? Dann macht Bekanntschaft mit meinen Puppen.
#. fr: Gnin hin<nbsp>! Plus vous aurez de renforts et plus j'animerai de marionnettes<nbsp>!
msgctxt "NpcYell:11805:0:13"
msgid "Hah hah! You may think to find comfort in numbers, but they shall all be my puppets!"
msgstr "Ха-ха! Думаете, числом возьмёте? Тогда познакомьтесь с моими марионетками!"

#. ja: 何者だ、お前たち東方風の出で立ちだが……<br>東方連合の援軍ではないな！？
#. de: Ihr da! Ihr seht aus, als kämt ihr aus dem Osten. Wer seid ihr?
#. fr: Vous êtes habillés comme nos alliés orientaux, mais de toute évidence vous ne faites pas partie de la coalition<nbsp>! Qui êtes-vous<nbsp>!?
msgctxt "NpcYell:11806:0:13"
msgid "You there! You appear to be Far Easterners, but you're not one of us. Identify yourselves!"
msgstr "Эй вы! На жителей Дальнего Востока похожи, но вы не наши. Назовитесь!"

#. ja: 我ら陰陽衆……故あってノア様配下となった身。<br>うぬらに恨みはないが、その命、貰い受けよう……。
#. de: Wir sind die Onmyo-Bruderschaft. Wir dienen Lord Noah. Und in seinem Namen strecken wir euch nieder!
#. fr: Nous sommes des prêtres onmyo entrés au service du seigneur Gabranth. Nous n'avons personnellement rien contre vous, mais vous allez devoir mourir.
msgctxt "NpcYell:11807:0:13"
msgid "We are the Onmyoji Brotherhood, and fate has ordained that we serve Lord Noah. In his name we shall strike you down."
msgstr "Мы — Братство оммёдзи. Судьба привела нас на службу к лорду Ною. Во имя его мы вас и сразим."

#. ja: 帝国軍か！<br>応戦するぞ…！
#. de: Garlear. Los, zückt die Waffen!
#. fr: Pfff<nbsp>! Des seconds couteaux de la 4e légion<nbsp>!
msgctxt "NpcYell:11808:0:13"
msgid "Hmph, I bloody knew it... To arms! To arms!"
msgstr "Тьфу, я так и знал... К оружию! К оружию!"

#. ja: ブオオオォォォォォォン！！
#. de: BHHUUUOOON!
#. fr: BHHHUUUÔÔÔN<nbsp>!!!
msgctxt "NpcYell:11809:0:13"
msgid "GrOAaARrRGgGH!"
msgstr "Гррр-а-а-р-р-р!"

#. ja: 敵軍と遭遇したか……加勢するぞ！
#. de: Sie haben Feindkontakt! Helfen wir ihnen!
#. fr: Ils sont aux prises avec l'ennemi<nbsp>! Portons leur assistance<nbsp>!
msgctxt "NpcYell:11810:0:13"
msgid "Our comrades need help! Look alive!"
msgstr "Нашим нужна помощь! Живо!"

#. ja: ぬっ……はやくも援軍か……！<br>我が式神たちよ、あの者らをまとめて蹴散らしてやれ！
#. de: Verstärkung? Jetzt schon? Also gut ...<br>Shikigami, zerstört unsere Feinde!
#. fr: Leurs renforts sont déjà là<nbsp>!? Peu importe, nos shikigami les emporteront tous dans l'au-delà<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11811:0:13"
msgid "Reinforcements so soon? Very well, allow us to return the favor.<br>O shikigami! I bid you smite my foes!"
msgstr "Подкрепление так скоро? Что ж, мы ответим тем же.<br>О, сикигами! Сразите моих врагов!"

#. ja: な……なんだ、あの化物は……！<br>皆、気を引き締めてかかるのだ！
#. de: W-Was sind das für Dinger? Seid vorsichtig!
#. fr: Je... Je n'ai jamais vu pareilles monstruosités<nbsp>! Soyez prudents<nbsp>!
msgctxt "NpcYell:11812:0:13"
msgid "Wh-What is that abomination? Have care!"
msgstr "Ч-что это за чудовище? Будьте осторожны!"

#. ja: グッ……ぬかったか……！？
#. de: Grrr. Ich habe sie unterschätzt.
#. fr: Ils m'ont eu...<nbsp>!
msgctxt "NpcYell:11813:0:13"
msgid "Ugh... It seems I underestimated them..."
msgstr "Уф... Похоже, я их недооценил..."

#. ja: 我が式神が打ち破られたというのか……！！
#. de: Die armen Shikigami ...
#. fr: Mon shikigami<nbsp>!
msgctxt "NpcYell:11814:0:13"
msgid "That my shikigami should be defeated..."
msgstr "Неужели мои сикигами потерпели поражение..."

#. ja: うわっ、オンドリたちが乱入してきましたよ！！<br>突かれないよう注意しながら、「産みたて卵」を集めてください！
#. de: Pass auf, die Hühner kommen! Halte Abstand oder sie hacken dir in den Fuß! Greif dir die nestwarmen Eier!
#. fr: Catastrophe<nbsp>! Une horde de coqs a déboulé pour protéger les œufs<nbsp>! Attention aux coups de griffes<nbsp>!
msgctxt "NpcYell:11815:0:13"
msgid "And here come the roosters! Keep your distance, or you'll soon wish you had!"
msgstr "А вот и петухи! Держитесь подальше, а то ещё пожалеете!"

#. ja: ひ、引き上げだ……この借りはいずれ返させてもらうぞ……！
#. de: Das ist noch nicht vorbei. Ihr werdet schon noch sehen!
#. fr: Partons... Ce n'est que partie remise<nbsp>! Nous les aurons la prochaine fois<nbsp>!
msgctxt "NpcYell:11816:0:13"
msgid "Hmph, you may have won the day, but this isn't over. Far from it."
msgstr "Хм, сегодня вы победили, но это ещё не конец. Даже близко."

#. ja: 敵使い魔の破壊を確認！<br>皆、よくやった！
#. de: Der Feind flieht! Gut gemacht, Männer!
#. fr: Nous avons vaincu leurs abo<shy>mi<shy>na<shy>tions<nbsp>! Bravo, camarades<nbsp>!
msgctxt "NpcYell:11817:0:13"
msgid "The enemy is fled! Well fought, brothers!"
msgstr "Враг бежал! Отлично сражались, братья!"

#. ja: うぉぉぉ！
#. de: Hurra!
#. fr: Ouaiiis<nbsp>!
msgctxt "NpcYell:11818:0:13"
msgid "Yaaah!"
msgstr "Ура-а-а!"

#. ja: 我ら陰陽衆の力、思い知ったか……！
#. de: Erfahrt die Macht der Onmyo-Bruderschaft!
#. fr: Vous n'êtes pas de taille face au pouvoir du onmyo<nbsp>!
msgctxt "NpcYell:11819:0:13"
msgid "Know the power of the Onmyoji Brotherhood!"
msgstr "Узрите мощь Братства онмёдзи!"

#. ja: これが東方の陰陽術だというのか……！<br>総員、撤退を！
#. de: Ihre Zauberkunst ist stärker als gedacht. Ziehen wir uns zurück!
#. fr: J'avais entendu parler de cette magie, mais jamais je ne l'aurai cru si puissante...<nbsp>! Retraite<nbsp>!
msgctxt "NpcYell:11820:0:13"
msgid "Their sorcery is more formidable than I had reckoned... Retreat! Retreat!"
msgstr "Их колдовство оказалось куда сильнее, чем я думал... Отступление! Отступление!"

#. ja: あんなヤツに<br>負けるなんて…！
#. de: Wie konnten wir nur gegen die verlieren?
#. fr: Comment avons-nous perdu face à des dévoyés pareils<nbsp>!?
msgctxt "NpcYell:11821:0:13"
msgid "How could we lose to the likes of them!?"
msgstr "Как мы могли проиграть таким, как они!?"

#. ja: 我ら陰陽衆、この勝利を足がかりとして、<br>ノア様の新王国で確かな地位を築いてみせようぞ……！
#. de: Ein glorreicher Sieg! Lang lebe Lord Noahs neues Reich!
#. fr: Cette victoire est une pierre de plus à l'édification de la nation du seigneur Gabranth<nbsp>!
msgctxt "NpcYell:11822:0:13"
msgid "Remember this victory well, my brothers. For it is the moment we began carving our place in Lord Noah's new nation!"
msgstr "Запомните эту победу, братья. С неё мы начали прокладывать себе путь в новой державе лорда Ноа!"

#. ja: ハッ！
#. de: Hurra!
#. fr: Hourra<nbsp>!
msgctxt "NpcYell:11823:0:13"
msgid "Huzzah!"
msgstr "Ура!"

#. ja: 聖石片による変異と同時に、精神呪縛の術式を重ねて、<br>あっという間に人形の出来上がりだ！
#. de: Die Splitter beherrschen eure Körper, und ich beherrsche euren Geist! Ihr hängt an meinen Fäden!
#. fr: Il se trouve qu'en combinant son pouvoir de métamorphose et mes capacités de contrôle mental, je peux désormais créer mes marionnettes instantanément<nbsp>!
msgctxt "NpcYell:11824:0:13"
msgid "The relic takes hold of your body, and I take a hold of your mind. Ere long, the strings have you bound. "
msgstr "Реликвия завладевает вашим телом, а я — разумом. И скоро вы уже будете плясать на моих ниточках."

#. ja: さあ、人形たちよ、せいぜい派手に踊ってくれよ。<br>オレは次の素材を探さなくちゃいけないんでね……！
#. de: Tanzt, meine Puppen! Tanzt für mich!
#. fr: Maintenant... dansez pour moi<nbsp>!
msgctxt "NpcYell:11825:0:13"
msgid "Now dance for me, puppets. Dance, and bring more to my merry troupe!"
msgstr "Ну же, марионетки, танцуйте для меня! Танцуйте и пополняйте мою весёлую труппу!"

#. ja: キヒッ…<br>ヒヒヒヒヒヒヒ！
#. de: He he he ...<br>Muahaha!
#. fr: Hi hi hi...<nbsp>! Ha ha ha ha ha<nbsp>!!!
msgctxt "NpcYell:11826:0:13"
msgid "Hah hah hah! Heheee hehe!"
msgstr "Ха-ха-ха! Хи-хи-хи!"

#. ja: 薄気味悪いヤツめ…
#. de: Er hat den Verstand verloren.
#. fr: Encore un fou à lier...
msgctxt "NpcYell:11827:0:13"
msgid "He's lost his mind..."
msgstr "Он совсем спятил..."

#. ja: ぐ、ぐああぁっ！
#. de: Guaaa! Huaaa!
#. fr: Ghaaa<nbsp>! Haaa<nbsp>!
msgctxt "NpcYell:11828:0:13"
msgid "Gwaaah! Aaargh!"
msgstr "Гва-а-а! А-а-а!"

#. ja: か、身体が熱い…！<br>燃えるようにィィィィ！
#. de: Mein Körper! Ich brenne! Ich breeenne!
#. fr: M-mon corps...<nbsp>! I-il brûle<nbsp>!!! Uhaaaaaa<nbsp>!!!
msgctxt "NpcYell:11829:0:13"
msgid "My...my body...! It's burning... It's buuurning!"
msgstr "М-моё тело...! Оно горит... Гори-и-ит!"

#. ja: 嘆かわしい……実に嘆かわしい……。<br>このような蛮族相手に、栄えある第IV軍団が手こずるなど……。
#. de: Mit diesen Schwächlingen ist die glorreiche IV. Legion nicht fertig geworden? Was für eine Schande.
#. fr: (soupire)... Que c'est regrettable... Pourquoi la 4e légion doit-elle se rabaisser à soumettre des barbares...<nbsp>?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11830:0:13"
msgid "<i>This</i> is the uncouth rabble our glorious legion has struggled so long to eliminate...? How disheartening."
msgstr "<i>Вот</i> с каким грубым сбродом наша славная легия так долго не могла покончить...? Как же прискорбно."

#. ja: しかし、この吾輩が戦場に出たからには、<br>レジスタンスなど一掃してご覧にいれましょう……！
#. de: Doch ich werde diesem würdelosen Treiben nun ein Ende setzen.
#. fr: Enfin... Maintenant que je suis là, le ménage va pouvoir commencer<nbsp>!
msgctxt "NpcYell:11831:0:13"
msgid "No matter. I am here now, and I shall sweep this field clean of Resistance filth!"
msgstr "Неважно. Теперь я здесь и очищу это поле от мерзких повстанцев!"

#. ja: ま、まさか、あれはファビノー……！？<br>なぜ貴方がボズヤにッ！
#. de: Fabineau? Was machst du in Bozja?
#. fr: Fabineau...<nbsp>!? Mais que...<nbsp>!? Que faites-vous en Bozja<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11832:0:13"
msgid "Fabineau!? How did─?<br>Why are you in Bozja?"
msgstr "Фабино!? Как же─?<br>Что вы здесь делаете, в Бозье?"

#. ja: おやおや、脱走したと報告を受けていましたが……<br>吾輩にひれ伏し、許しを請うために出頭したのですかな？
#. de: Meine liebe Llofii! Man sagt, du seist desertiert. Bist du hier, um dich zu ergeben? Winselst du um Gnade?
#. fr: Oh<nbsp>!? Ne serait-ce pas là notre petite déserteuse<nbsp>? Serais-tu venue implorer ton pardon<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11833:0:13"
msgid "Llofii, my dear! The reports had you pinned as a deserter.<br>Have you come forth to surrender to me, then? To beg my forgiveness?"
msgstr "Ллофи, дорогая! Мне доложили, что ты дезертировала.<br>Так ты пришла сдаться мне? Просить о прощении?"

#. ja: ふざけないで！<br>非道な実験を繰り返す貴方に、誰がひれ伏すものですか！
#. de: Niemals! Ich werde nie wieder bei deinen fürchterlichen Experimenten mitmachen!
#. fr: Vous divaguez<nbsp>! Je ne m'abaisserai plus jamais devant vous<nbsp>! Vos méthodes sont immorrrales<nbsp>!
msgctxt "NpcYell:11834:0:13"
msgid "Never! I will never again align myself with you and your cruel experiments!"
msgstr "Никогда! Я больше не стану помогать тебе в твоих жестоких экспериментах!"

#. ja: 裏切り者を始末するのは<br>上官たる吾輩の務め…！
#. de: Gut. Dann brauche ich nur noch die Schande deiner Desertation auszuradieren.
#. fr: Dans ce cas, je t'exécuterai moi-même. Tu étais sous ma res<shy>pon<shy>sa<shy>bi<shy>li<shy>té, après tout<nbsp>!
msgctxt "NpcYell:11835:0:13"
msgid "It falls to me to cleanse the stain of your betrayal!"
msgstr "Мне, твоему начальнику, и исправлять позор твоего предательства!"

#. ja: モノセロスを傷つけた貴方は<br>絶対に許さない！
#. de: Nicht bevor du für das gebüßt hast, was du meinem Monozeros angetan hast!
#. fr: Non, c'est vous qui allez payer pour ce que vous avez fait subirrr à ce pauvre monocéros<nbsp>!
msgctxt "NpcYell:11836:0:13"
msgid "You will suffer for the suffering you've inflicted!"
msgstr "Ты заплатишь за те страдания, что причинила!"

#. ja: おっと、吾輩としたことが忘れておりました。<br>ロフィー、貴方の後任を紹介させていただきましょう。
#. de: Ach, ich vergaß. Ich wollte dir ja noch deinen Nachfolger vorstellen.
#. fr: Ah, pardonne-moi, j'ai failli oublier. Permets-moi de te présenter ton remplaçant.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11837:0:13"
msgid "Ah, but where are my manners?<br>You really should meet your successor."
msgstr "Ах, совсем забыл о приличиях.<br>Позволь познакомить тебя с твоим преемником."

#. ja: きっと、気が合うと思いますよ。<br>貴方と彼は、似たもの同士なのですから……！
#. de: Ihr werdet euch blendend verstehen. Ihr habt ja so viel gemeinsam!
#. fr: Je suis certain que vous allez vous entendre. Après tout, j'ai choisi un... homologue, si je puis dire...
msgctxt "NpcYell:11838:0:13"
msgid "I'm sure the two of you will get along splendidly─after all, you do have so much in common!"
msgstr "Уверен, вы прекрасно поладите. Ведь у вас столько общего!"

#. ja: ご紹介させていただきましょう！<br>裏切りの「グンヒルドの剣」、ロヴロ君ですッ！
#. de: Hier, ein weiterer Verräter: Lovro, Mitglieder der Königinnenwache!
#. fr: Voici Lovro<nbsp>! Une lame de Gunnhildr qui, comme toi, a trahi les siens<nbsp>!
msgctxt "NpcYell:11839:0:13"
msgid "Allow me to introduce a fellow traitor: Lovro, of Gunnhildr's Blades!"
msgstr "Позвольте представить такого же предателя — Ловро из Клинков Гуннхильд!"

#. ja: オォォ……女王陛下ノ命ニヨリ、<br>反逆者ドモヲ……根絶ヤシニ……スルノダ……！
#. de: Der Widerstand muss sterben ... der Königin zu Ehren!
#. fr: Au nom de notre Reine... Je pourfendrai les traîtres jusqu'au dernier<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11840:0:13"
msgid "In the name of the queen...<br>All dissidents must perish!"
msgstr "Во имя королевы...<br>Все мятежники должны погибнуть!"

#. ja: あ、あれはテンパード化されたボズヤ人……！？<br>なんてことを……！
#. de: Das ist kein Verräter. Er ist besessen!
#. fr: Un... Un Bozjien subjugué<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11841:0:13"
msgid "No...<br>This man has been tempered..."
msgstr "Нет...<br>Этот человек порабощён..."

#. ja: ロフィー…<br>さようなら、だ…
#. de: Liebe Llofii. Die Zeit des Abschieds ist gekommen.
#. fr: Il ne me reste plus qu'à te souhaiter adieu, ma chère Llofii.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11842:0:13"
msgid "My poor, addled Llofii.<br>Our final farewell is at hand."
msgstr "Бедная, совсем запутавшаяся Ллофи.<br>Нам пора прощаться навсегда."

#. ja: 女王陛下…<br>御許ヘ…！
#. de: Königin ... Ich kehre zu Euch zurück.
#. fr: Pardonnez-moi, ma Reine...<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11843:0:13"
msgid "My queen...<br>I return to your side..."
msgstr "Моя королева...<br>Я возвращаюсь к вам..."

#. ja: モノセロスでは飽き足らず、<br>テンパード化したボズヤ人を魔術実験に使うなんて……。
#. de: Es hat Fabineau wohl nicht gereicht, seine Experimente nur an Tieren auszuführen.
#. fr: Fabineau a repoussé les limites de l'ignominie... En plus des animaux, il expérimente aussi sur des êtrrres humains maintenant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11844:0:13"
msgid "Fabineau was not content to meddle with the monoceros, it seems.<br>He has expanded into other foul spheres of experimentation..."
msgstr "Выходит, Фабиноу было мало экспериментов над монокеросом.<br>Он перешёл к другим, куда более гнусным опытам..."

#. ja: ファビノーの悪行だけは、<br>この身に代えてでも、止めなければいけません……。
#. de: Ich muss diesem Übel ein Ende bereiten. Koste es, was es wolle!
#. fr: Je l'arrêterrrai... Quoiqu'il en coûte...
msgctxt "NpcYell:11845:0:13"
msgid "I care not what it costs me─I must put an end to his evil!"
msgstr "Мне всё равно, чего это будет мне стоить. Я должен положить конец его злодействам!"

#. ja: オォォォ……コノ勝利ヲ、<br>女王陛下ニ……！
#. de: Meine Königin! Dieser Sieg gehört Euch!
#. fr: Ma Reine<nbsp>! Cette victoire est vôtre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11846:0:13"
msgid "My queen!<br>I bring you victory!"
msgstr "Моя королева!<br>Я принёс вам победу!"

#. ja: これぞ魔術の力…<br>覚えておくことですね
#. de: Habt ihr jetzt verstanden, über welche Macht ich verfüge?
#. fr: Voilà le pouvoir que tu as renié, Llofii.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11847:0:13"
msgid "That is true power.<br>Remember well this defeat."
msgstr "Вот она, истинная сила.<br>Хорошенько запомни это поражение."

#. ja: 逃げて…<br>みんな、逃げて…！
#. de: Lauft! Lauft um euer Leben!
#. fr: Fuyez...<nbsp>! Il est... trop puissant pourrr nous...<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11848:0:13"
msgid "Run...<br>We have to run!"
msgstr "Бегите...<br>Нам нужно бежать!"

#. ja: ムッ…何者だ！？
#. de: Wer da?
#. fr: Hmm<nbsp>!? Qui va là<nbsp>!?
msgctxt "NpcYell:11849:0:13"
msgid "Who goes there!?"
msgstr "Кто здесь!?"

#. ja: オォォ……我コソハ女王ノ盾ニシテ刃、<br>グンヒルドノ剣ナリ……！
#. de: Ich bin ihr Schild, ich bin ihr Schwert. Meine ganze Existenz gehört der Königin!
#. fr: À la fois arme et bouclier... Je suis la lame de Gunnhildr<nbsp>!
msgctxt "NpcYell:11850:0:13"
msgid "I am her shield. I am her sword. The queen's blade is all that I am or wish to be!"
msgstr "Я — её щит. Я — её меч. Я весь принадлежу королеве, и только ей!"

#. ja: 貴方は……ロヴロ！<br>報告は受けていましたが、本当にテンパードに……！
#. de: Lovro! Es ist also wahr. Du bist wirklich besessen ...
#. fr: Lovro<nbsp>!? C'était donc vrai... Vous avez été subjugué...
msgctxt "NpcYell:11851:0:13"
msgid "Lovro! I had not wanted to believe the reports, but now I see that they spoke true..."
msgstr "Ловро! Я не хотел верить донесениям, но теперь вижу, что они не солгали..."

#. ja: ですが、私とて「グンヒルドの剣」の一員ッ！<br>たとえ貴方が相手であろうと、退くわけにはまいりません！
#. de: Dann ist klar, was ich zu tun habe.
#. fr: Je suis maintenant une lame de Gunnhildr, moi aussi... Alors je ne retiendrai pas mes coups, même contre vous, Maître<nbsp>!
msgctxt "NpcYell:11852:0:13"
msgid "Though it pains me to stand against you, my duty is clear!"
msgstr "Мне тяжело выступать против вас, но долг ясен!"

#. ja: 貴方に伝授された、この技で……<br>貴方を捕縛し、ガンゴッシュへと連れ帰りますッ！
#. de: Du hast mir alles beigebracht, was ich wissen muss, um dich zu besiegen.
#. fr: Je vais vous vaincre avec la technique que vous m'avez enseignée... Puis nous rentrerons ensemble à Gangos<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11853:0:13"
msgid "It is fitting somehow...<br>The techniques that you once taught me shall be the very same I wield to effect your capture!"
msgstr "Как же всё символично...<br>Теми приёмами, которым вы меня научили, я и схвачу вас!"

#. ja: オォォ……女王陛下ニ仇ナス者メ……<br>我ト同ジ、赤魔法ヲ操ルトハ……！
#. de: Meine Rotmagie! Gegen mich gewandt, von einem Feind der Königin!
#. fr: Traître à notre Reine... Comment fais-tu pour te battre comme moi<nbsp>!?
msgctxt "NpcYell:11854:0:13"
msgid "Mine own red magicks, used against me by an enemy of the queen!"
msgstr "Моя красная магия... Ею же против меня — врага королевы!"

#. ja: ダガ……コノ奥義ハ、扱エマイ……！<br>赤キ命ヲ燃ヤセ、クリムゾンスカージ……！
#. de: Aber kennst du wirklich alle meine Geheimnisse? Kennst du auch die Blutrote Geißel?
#. fr: Peu importe... Tu ne connais pas tous les secrets de la magie rouge<nbsp>! Rouge comme le feu, rouge comme mon sang<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11855:0:13"
msgid "Yet I wonder...have you mastered <i>all</i> my secrets?<br>Dare you unleash the fires of the Crimson Scourge!?"
msgstr "И всё же... ты овладела <i>всеми</i> моими секретами?<br>Осмелишься призвать пламя Багровой кары!?"

#. ja: この魔力の高まりは……まさかッ！？<br>みなさん、離れてッ！！
#. de: Er bündelt gewaltige Massen an Äther. Alle zurück!
#. fr: Tout cet éther... Il ne va quand même pas...<nbsp>! Arrière, tout le monde<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11856:0:13"
msgid "No... I've felt this surge of mana before...<br>Back! Everyone back!"
msgstr "Нет... Я уже чувствовал этот всплеск маны...<br>Назад! Все назад!"

#. ja: くっ……テンパードと化してなお、この技の冴え……！
#. de: Die Besessenheit hat neue Kräfte in ihm geweckt!
#. fr: Argh... La subjugation a décuplé la puissance de sa botte secrète aussi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11857:0:13"
msgid "Gods above!<br>The tempering has only enhanced his powers..."
msgstr "Боги!<br>Темперация только усилила его магию..."

#. ja: オォォ……マダ、ココデ果テルワケニハ……<br>女王陛下ノ御許ヘ……！
#. de: Ich darf nicht sterben. Meine Königin braucht mich.
#. fr: Je ne peux pas... plier le genou...<nbsp>! Je dois retourner auprès... de ma Reine...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11858:0:13"
msgid "I cannot fall here.<br>My queen yet has need of me..."
msgstr "Я не могу здесь пасть.<br>Королева ещё нуждается во мне..."

#. ja: 待って……待ってください、ロヴロ！
#. de: Lovro, bitte! Wir können dir helfen!
#. fr: Maître<nbsp>! Revenez<nbsp>!
msgctxt "NpcYell:11859:0:13"
msgid "Lovro, please! We can help─!"
msgstr "Ловро, прошу! Мы можем помочь!"

#. ja: だけど、肉体までは変異が進んでいなかった。<br>まだ……今ならまだ、救えるはず……。
#. de: Sein Körper ist noch nicht verändert. Wir haben noch Zeit.
#. fr: Voyons le bon côté des choses... Il est toujours humain. Nous devrions donc pouvoir le sauver.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11860:0:13"
msgid "For a kindness, at least his body yet remains uncorrupted.<br>We can still... There is still time."
msgstr "Хоть тело его пока не испорчено.<br>Ещё можно... Ещё есть время."

#. ja: 師匠…<br>待っていてください…
#. de: Halte durch. Wir werden dich retten.
#. fr: Comptez sur moi, Maître. Je vous ramènerai à la raison...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11861:0:13"
msgid "Fear not, my mentor.<br>We will save you from this darkness..."
msgstr "Не бойтесь, наставник.<br>Мы спасём вас от этой тьмы..."

#. ja: ぐっ……テンパードになって、魔力が高まっている……！<br>対策を立てるため、一度、撤退しましょう……！
#. de: Zurück! Die Zauberkraft des Besessenen ist zu stark! Wir brauchen eine neue Taktik.
#. fr: On ne peut rien faire<nbsp>! La subjugation l'a rendu encore plus fort qu'il ne l'était déjà<nbsp>! Fuyons<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11862:0:13"
msgid "Fall back! His magicks are too strong!<br>We must regroup and reconsider our strategy!"
msgstr "Отступаем! Его магия слишком сильна!<br>Нужно перегруппироваться и пересмотреть план!"

#. ja: オォォォ……コノ勝利ヲ、女王陛下ニ……！<br>イザ陛下ノ御許ヘ……！
#. de: Majestät, der Sieg ist Euer! Dein treuer Diener kehrt nun zu Euch zurück.
#. fr: La victoire est nôtre, ma Reine<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11863:0:13"
msgid "My queen! This victory I seize in your name!<br>Your Majesty's loyal servant returns..."
msgstr "Моя королева! Эту победу я одержал во имя ваше!<br>Ваш верный слуга возвращается..."

#. ja: 見てください、あの武器を……！<br>新生「グンヒルドの剣」、法剣のロヴロ殿です！
#. de: Seht ihr diese Waffe? Das ist Lovro von der Königinnenwache.
#. fr: Je reconnais cette arme<nbsp>! Là-bas, c'est Lovro, la lame de Gunnhildr subjuguée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11864:0:13"
msgid "Mark you the weapon he wields?<br>That man is Lovro─one of Gunnhildr's Blades!"
msgstr "Видите его оружие?<br>Это Ловро, один из Клинков Гуннхильд!"

#. ja: オォォ……マタ、貴様カ……！<br>我ト同ジ、赤魔法ヲ操ル、目障リナ女ヨ……！
#. de: Schon wieder du! Die Verräterin, die meine Rotmagie imitiert!
#. fr: Encore toi<nbsp>! La traîtresse qui copie mes techniques de magie rouge<nbsp>!
msgctxt "NpcYell:11865:0:13"
msgid "You dare face me again, foul pretender to the red mantle!?"
msgstr "Снова ты! Подлая самозванка, присвоившая красную мантию!"

#. ja: ロヴロ……私は、この再戦の機会を待っていました。
#. de: Ja, schon wieder ich, und diesmal bring ich es zu Ende.
#. fr: J'ai longuement attendu le moment où nous pourrions nous battre à nouveau.
msgctxt "NpcYell:11866:0:13"
msgid "Aye, and this time, I will not fail."
msgstr "Да. И на этот раз я не проиграю."

#. ja: この戦いで、私は師匠である貴方を超えてみせます。<br>そして、貴方を救ってみせる……絶対にッ！
#. de: Ich werde dich besiegen, um dich zu retten.
#. fr: Aujourd'hui, je vais vous surpasser, Maître... Et vous sauver<nbsp>!
msgctxt "NpcYell:11867:0:13"
msgid "I will honor you, my mentor...by subduing you in battle!"
msgstr "Я прославлю вас, наставник... одолев в бою!"

#. ja: オォォ……女王陛下ニ仇ナス者メ……<br>今度コソ、引導ヲ渡シテクレヨウゾ……！
#. de: Niemand wird ihr Werk zerstören, auch du nicht!
#. fr: Ce sera la dernière fois que nous croiserons le fer... Je vais définitivement te remettre dans le droit chemin<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11868:0:13"
msgid "Foe to my queen.<br>Prepare to meet your end!"
msgstr "Враг моей королевы.<br>Готовься встретить смерть!"

#. ja: ぐっ……さすがは師匠！<br>でも、負けはしません……魔力を、命を燃やすんだッ！
#. de: Uff! Du bist stark. Aber ich werde nicht scheitern!
#. fr: Argh<nbsp>! Vos coups sont toujours aussi puissants, Maître<nbsp>! Mais je ne vais pas me laisser faire, devrais-je pour cela me sacrifier<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11869:0:13"
msgid "Ugh! ...You truly are a master of the art!<br>Yet I will prove myself the stronger!"
msgstr "Ох... Вы и вправду мастер своего дела!<br>Но я докажу, что сильнее!"

#. ja: オォォ……シブトイ奴メ……！<br>ナラバ、我ガ奥義デ、終ワラセテクレル……！
#. de: Dieser Kampf ist sinnlos. Ich werde ihn nun beenden!
#. fr: Tu es pugnace<nbsp>! Très bien, je vais mettre un terme à ce combat avec ma botte secrète<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11870:0:13"
msgid "I tire of this contest!<br>If you seek my best, then you shall have it!"
msgstr "Мне надоел этот бой!<br>Хочешь увидеть мою мощь — получай!"

#. ja: 今度は、逃げはしません……！<br>貴方に教えられた「抗う力」で、乗り超えてみせるッ！
#. de: Egal, welche Kräfte du auch aufbringst, ich habe die Kraft des Widerstands!
#. fr: Je ne fuirais pas cette fois<nbsp>! La flamme qui brûle dans mon cœur brillera plus fort<nbsp>!
msgctxt "NpcYell:11871:0:13"
msgid "And I will weather the storm just as you taught me...with heart and steel!"
msgstr "На этот раз я не отступлю!<br>Я выдержу всё, как вы меня учили, — с сердцем и сталью!"

#. ja: 赤キ命ヲ燃ヤセ……！
#. de: Rot wie das Feuer ...
#. fr: Rouge comme le feu, rouge comme...
msgctxt "NpcYell:11872:0:13"
msgid "My vital flame─"
msgstr "Моё жизненное пламя..."

#. ja: 赤き命を燃やせ、クリムゾンスカージ……！
#. de: Rot wie das Blut der Geißel!
#. fr: Rouge comme le feu, rouge comme mon sang<nbsp>! Le fléau écarlate<nbsp>!
msgctxt "NpcYell:11873:0:13"
msgid "My vital flame feeds the Crimson Scourge!"
msgstr "Моё жизненное пламя питает Багровую кару!"

#. ja: ナンダト…！？<br>我ガ力ヲ、超エタト…！
#. de: Was? Ist sie wirklich stärker als ich?
#. fr: Comment<nbsp>!? Elle m'aurait réellement surpassé<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11874:0:13"
msgid "My spell!?<br>How dare you─?"
msgstr "Моё заклинание!?<br>Как ты смеешь─?"

#. ja: グォォォ……魔力ノ炎ガ……燃エ尽キテユク……！<br>身体ガ……動カ、ヌ…………。
#. de: Mein Äther ... Meine Flamme erlischt ...
#. fr: La flamme qui m'habite s'éteint...<nbsp>!
msgctxt "NpcYell:11875:0:13"
msgid "My aether... How feeble grows its fire..."
msgstr "Моя эфирная сила... Огонь во мне слабеет..."

#. ja: 今ですッ！<br>師匠を……ロヴロを囚えてください！
#. de: Jetzt! Fangt ihn!
#. fr: Maintenant<nbsp>! Capturez-le<nbsp>!
msgctxt "NpcYell:11876:0:13"
msgid "Quickly, bind him while he is still weak!"
msgstr "Скорее, свяжите его, пока он ослаб!"

#. ja: ハァ、ハァ……ハァ……<br>やりました、師匠……これで貴方を救うことが……！
#. de:  \<keuch> Es ist vorbei, Meister Lovro.
#. fr: Haa... Haa... Haa... Nous avons réussi<nbsp>! Nous avons sauvé mon maître<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11877:0:13"
msgid "\\<pant> \\<pant> \\<pant><br>It is done, Master Lovro. The healing can begin!"
msgstr "\\<pant> \\<pant> \\<pant><br>Готово, мастер Ловро. Теперь вас можно исцелить!"

#. ja: そ、そんな……これほどまでに魔力を燃やしてなお、<br>師匠には……届かないというの……！？
#. de: Das ist alles, mehr habe ich nicht ... Und doch steht er noch!
#. fr: N-non<nbsp>! Ma flamme ne brûlerait pas encore aussi fort que la sienne...<nbsp>!?
msgctxt "NpcYell:11878:0:13"
msgid "I have...no more aether to give...and yet he still stands!"
msgstr "У меня... больше не осталось эфира... а он всё ещё стоит!"

#. ja: オォォォ……コノ勝利ヲ、女王陛下ニ……！<br>イザ陛下ノ御許ヘ……！
#. de: Sieg, meine Königin! Ich kehre erhobenen Hauptes zu Euch zurück!
#. fr: La victoire est nôtre, ma Reine<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11879:0:13"
msgid "Victory, my queen!<br>I return to you triumphant!"
msgstr "Победа, моя королева!<br>Я возвращаюсь к вам с триумфом!"

#. ja: 外からのお客様をお迎えするため「Fête」を用意しております。<br>詩伯門前からスタートですよ～！
#. de: Alle, die an unseren Fêtes teilnehmen möchten, bitte ich, sich zur Balladenpassage zu begeben!
#. fr: Pour prendre part aux festes de la Grande Célébration d'Azurée, c'est devant la porte des Industrieux que ça se passe<nbsp>!
msgctxt "NpcYell:11880:0:13"
msgid "If you wish to participate in these light-hearted games, please gather at Bright Ballad's Passage."
msgstr "Желающие принять участие в наших весёлых играх, собирайтесь у Прохода Светлой баллады."

#. ja: 「Fête」への参加で、プレゼントを差し上げます！<br>詩伯門前へお急ぎくださ～い！
#. de: Handwerker und Sammler aller Manier können an den Spielen teilnehmen und tolle Preise gewinnen!
#. fr: De ravissants présents attendent les par<shy>ti<shy>ci<shy>pants, donc n'hésitez pas à venir vous amuser<nbsp>!
msgctxt "NpcYell:11881:0:13"
msgid "Artisans of all persuasions can join in the fun and win fabulous prizes!"
msgstr "Ремесленники любых специальностей могут присоединиться к веселью и выиграть чудесные призы!"

#. ja: 職人さんであればどなたでも、「Fête」に参加できます！<br>詩伯門前でお待ちしております～！
#. de: Wir freuen uns schon unsere zahlreichen Gäste begrüßen zu dürfen!
#. fr: Nous vous attendons avec impatience devant la porte des Industrieux<nbsp>!
msgctxt "NpcYell:11882:0:13"
msgid "We eagerly look forward to your participation!"
msgstr "Будем с нетерпением ждать вашего участия!"

#. ja: 蒼天街復興祝祭を盛り上げる「Fête」、開幕はいよいよです！<br>皆さん、詩伯門前にお集まりですか～？
#. de: Letzter Aufruf zur Teilnahme an den kurzweiligen Fêtes! Handwerker und Sammler bitte zur Balladenpassage!
#. fr: C'est le dernier appel pour participer aux festes<nbsp>! Si vous êtes intéressés, veuillez vous rendre devant la porte des Industrieux<nbsp>!
msgctxt "NpcYell:11883:0:13"
msgid "This is the final call for fêtes! If you wish to participate, please hasten to Bright Ballad's Passage."
msgstr "Последний зов на праздник! Желающие принять участие, поспешите к Проходу Светлой баллады!"

#. ja: さぁ、マスコットたちを追いかけて、<br>次の開催地「十字鍬通り」へ向かいましょう！
#. de: Kommt, Freunde! Die Maskottchen erwarten euch bereits am Kreuzkarst-Spalier!
#. fr: Ne perdons pas de temps et suivons les mascottes jusqu'au Hoyau<nbsp>!
msgctxt "NpcYell:11884:0:13"
msgid "Come, friends, pray do not dally!"
msgstr "Друзья, за нашими талисманами! Не задерживайтесь!"

#. ja: マスコットたちは次のFête「ぬいぐるみ組立競争」の開催地、<br>「十字鍬通り」に移動中ですよ～！
#. de: Das Fête, „Stoff der Träume“ beginnt in Kürze!
#. fr: Les mascottes sont en route pour Le Hoyau, où la prochaine feste, “La fabrique à peluches”, va se dérouler<nbsp>!
msgctxt "NpcYell:11885:0:13"
msgid "Follow our mascots to the Mattock, where the fête “Made of Softer Stuff” will be held."
msgstr "Следуйте за талисманами к Мотыге — там пройдёт праздник «Плюшевое дело»."

#. ja: まだまだFêteは続きますよー！<br>次のFêteは、「十字鍬通り」にてまもなく開始になります～。
#. de: Der Spaß hat gerade erst begonnen, Freunde! Das nächste Fête findet am Kreuzkarst-Spalier statt!
#. fr: Si vous avez envie de vous amuser, rejoignez-nous vite au Hoyau<nbsp>!
msgctxt "NpcYell:11886:0:13"
msgid "The fun and excitement have only just begun!"
msgstr "Веселье только начинается!"

#. ja: 「ヤクの毛刈り競争」の主催は、モフモフチョコボ！<br>みんなで会場の詩伯門前まで移動しましょう！
#. de: Unser fluffiges Maskottchen, der Plüschpuschel-Chocobo hat die Federführung beim Fête „Yak-o-matik“!
#. fr: C'est notre ami le chocobo chatoyant qui s'occupe de la feste “Y a qu'à tondre”. Il vous attend devant la porte des Industrieux<nbsp>!
msgctxt "NpcYell:11887:0:13"
msgid "In charge of this fête is Chirpy Chocobo, who loves all things fluffy and downy."
msgstr "Этот праздник ведёт чирикающий чокобо — он просто обожает всё пушистое."

#. ja: マスコットたちは次のFête「ヤクの毛刈り競争」の開催地、<br>「詩伯門」前に移動中ですよ～！
#. de: Unsere Maskottchen sind bereits unterwegs zum Veranstaltungsort. Auf zur Balladenpassage!
#. fr: Les mascottes sont en route pour la porte des Industrieux, où la prochaine feste, “Y a qu'à tondre”, va se dérouler<nbsp>!
msgctxt "NpcYell:11888:0:13"
msgid "Our mascots are making their way to the venue as we speak."
msgstr "Наши талисманы уже направляются к месту праздника."

#. ja: Fêteもいよいよ中盤戦！<br>次のFêteは、詩伯門前にてまもなく開始になります～。
#. de: Falls euch der Sinn nach einem ausgelassenen Spielchen steht - man erwartet euch bereits beim nächsten Fête!
#. fr: Il n'est jamais trop tard pour participer<nbsp>! Venez vite devant la porte des Industrieux<nbsp>!
msgctxt "NpcYell:11889:0:13"
msgid "If you wish to participate─and surely you do─please follow them to Bright Ballad's Passage!"
msgstr "Хотите поучаствовать — а вы ведь хотите! — следуйте за ними к Проходу Светлой баллады!"

#. ja: マスコットたちは次のFête「ぬいぐるみ集め競争」の開催地、<br>「アバカス通り」に移動中ですよ～！
#. de: Unsere Maskottchen werden jeden Augenblick mit dem nächsten Fête, „Jäger des versteckten Mogrys“, beginnen! Auf zur Allee des Abakus!
#. fr: Les mascottes sont en route pour L'Abaque, où la prochaine feste, “La chasse au jouet”, va se dérouler<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11890:0:13"
msgid "Quickly, now. As the saying goes, “Good things come to those who <i>don't</i> wait”!"
msgstr "Живее! Как говорится, «хорошее случается с теми, кто <i>не</i> ждёт»!"

#. ja: アバカス通りにて開催されるFête「ぬいぐるみ集め競争」、<br>主催のクルクルポーキーさんも、張り切っています！
#. de: Unser rüsseliges Maskottchen Kullerkringel-Grunzi hat seine Ferkel bereits auf die Schatz<shy>suche eingeschworen!
#. fr: Allez retrouver le porcelet polisson et ses petits pourceaux à L'Abaque pour la feste “La chasse au jouet”<nbsp>!
msgctxt "NpcYell:11891:0:13"
msgid "This time, Perky Piggy and his lovable litter of swinelings will be in charge of the proceedings."
msgstr "На этот раз за праздником будут следить бойкий поросёнок и его очаровательный выводок."

#. ja: Fêteは残り2つ！<br>アバカス通りにて、まもなく開始になります～。
#. de: Nach „Jäger des versteckten Mogrys“, das in Kürze an der Allee des Abakus startet, ist noch ein weiteres geplant.
#. fr: C'est l'heure de l'avant-dernière feste<nbsp>! C'est à L'Abaque que ça se passe, alors ne perdez pas de temps<nbsp>!
msgctxt "NpcYell:11892:0:13"
msgid "Including the soon-to-commence “Toy Hunter,” but two fêtes remain."
msgstr "Включая вот-вот начинающийся праздник «Охотник за игрушками», осталось всего два."

#. ja: 十字鍬通りと中央の広場で開催されるのは、<br>Fête「プレゼント配り競争」!
#. de: Das Fête „Bote der Glückseligkeit“ ist das fünfte und letzte ausgelassener Spiele, die während des Himmelsfestes stattfinden!
#. fr: Et maintenant, le bouquet final<nbsp>!
msgctxt "NpcYell:11893:0:13"
msgid "There, the fifth and final fête awaits: “Presents of Mind.”"
msgstr "Там вас ждёт пятый и последний праздник — «Подарки с умом»."

#. ja: いよいよFêteもこれで最後！<br>ぜひ、中央の広場にお集まりください！
#. de: Nun denn, auf zum zentralen Platz am Spalier! Wir freuen uns auf eure rege Teilnahme!
#. fr: La place centrale du Hoyau vous attend pour la dernière feste, “À chacun son cadeau”<nbsp>!
msgctxt "NpcYell:11894:0:13"
msgid "This being the rousing conclusion, we hope to see every one of you there with bells on!"
msgstr "Надеемся увидеть вас всех на этом весёлом финале!"

#. ja: みなさま、蒼天街復興祝祭の「Fête」に<br>ご参加ありがとうございました！
#. de: Im Namen aller Bewohner von Ishgard möchte ich den teilnehmenden Gästen von ganzem Herzen Danken.
#. fr: Et c'est ainsi que se conclut notre série de festes<nbsp>! Merci à toutes et à tous d'avoir participé<nbsp>!
msgctxt "NpcYell:11895:0:13"
msgid "And that concludes all the fêtes. On behalf of all the residents of the Firmament, we thank you for joining us in the revelry."
msgstr "На этом праздники подошли к концу. От лица жителей Твёрди благодарим вас за участие в гуляньях."

#. ja: 開かれた皇都へ来訪した冒険者や職人の皆さんに、<br>蒼天街をご紹介したく、開催させていただきました。
#. de: Mit dem Himmelsfest wollten wir die Arbeit der fleißigen Helfer ehren und unseren ewigen Dank zum Ausdruck bringen.
#. fr: La Grande Célébration se poursuit, alors nous espérons que vous continuerez à vous amuser en notre compagnie<nbsp>!
msgctxt "NpcYell:11896:0:13"
msgid "The Skyrise Celebration is our way of honoring our esteemed builders while welcoming folk from near and far to our new home."
msgstr "Праздник в честь возрождения небесного квартала — наш способ отблагодарить уважаемых строителей и приветствовать гостей, прибывших издалека."

#. ja: しばしの間、楽しんでいただけたのなら幸いです！
#. de: Wir hoffen, dass wir ein wenig von der geschenkten Freude zurückgeben konnten und wünschen noch viel Spaß bei den Feierlichkeiten!
#. fr: Au plaisir de vous rencontrer dans les rues d'Azurée<nbsp>!
msgctxt "NpcYell:11897:0:13"
msgid "We hope that we have been able to give back some of the joy we have received, and wish you much and more happiness!"
msgstr "Надеемся, что смогли вернуть вам хоть немного той радости, которой вы поделились с нами. Желаем вам счастья и ещё больше счастья!"

#. ja: バイシャーエン様…<br>あちらをご覧ください！
#. de: Kommandant Bajsaljen! Seht nur, da!
#. fr: Bajsaljen<nbsp>! Regardez<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11898:0:13"
msgid "Bajsaljen, sir!<br>There's someone there!"
msgstr "Байсальен, господин!<br>Там кто-то есть!"

#. ja: 戦場にたったひとりで…？
#. de: Wer läuft denn alleine über das Schlachtfeld?
#. fr: Que fait-il seul, au beau milieu du champ de bataille...<nbsp>?
msgctxt "NpcYell:11899:0:13"
msgid "Who would be wandering a battlefield alone...?"
msgstr "Кто это бродит по полю боя в одиночестве...?"

#. ja: ボズヤ人とお見受けしますが……<br>このような場所で、いかがされたのですか？
#. de: Du siehst aus wie ein Bozianer. Was machst du hier, Freund?
#. fr: Tu m'as l'air Bozjien... Que fais-tu là, l'ami<nbsp>?
msgctxt "NpcYell:11900:0:13"
msgid "You appear to be Bozjan, sir, but how came you to this place?"
msgstr "Вы, кажется, из Бозьи, господин. Как вы здесь оказались?"

#. ja: あ、貴方は、もしや……ダボグさんではありませんか？<br>2年前の作戦で捕虜になったとの報告が……！
#. de: Dabog? Bist du das? Wir hörten, dass du gefangen genommen wurdest. Vor zwei Jahren!
#. fr: Mais... je te reconnais<nbsp>! Tu es Dabog, celui qui a été capturé par les Impériaux il y a deux ans<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11901:0:13"
msgid "...Dabog? It is you, is it not?<br>There were reports of your capture two years ago!"
msgstr "...Дабог? Это ведь вы?<br>Нам сообщили, что два года назад вы попали в плен!"

#. ja: こちら、強化兵ダボグ……<br>敵兵を確認……遭遇戦闘を開始しまス……。
#. de: Ich bin Dabog. Der stärkste aller Magitek-Soldaten. Leite Kampfsequenz ein.
#. fr: Dabog... soldat augmenté... Cible... en... visuel. Je passe à... l'attaque...<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11902:0:13"
msgid "This is hyperpilot Dabog.<br>Hostile forces confirmed. Initiating combat."
msgstr "Это усиленный солдат Дабог.<br>Обнаружен противник. Начинаю бой."

#. ja: あ、あの顔は…！
#. de: Moment mal, den kenne ich doch!
#. fr: Son visage<nbsp>!
msgctxt "NpcYell:11903:0:13"
msgid "Wait, we know this man!"
msgstr "Погодите, да мы же знаем этого человека!"

#. ja: な、あの魔導兵器は……！？<br>まさか、貴方が操縦していたとでもいうのですか！
#. de: Dann hat er also die ganze Zeit über diese Maschine gesteuert?
#. fr: Cette machine<nbsp>! C'est donc toi qui la pilotais<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11904:0:13"
msgid "I recognize that warmachina!<br>...And now we know who the pilot was."
msgstr "Я узнаю эту магитех-машину!<br>...Теперь мы знаем, кто был пилотом."

#. ja: 彼の様子……とても正気とは思えないですが、<br>今は迎え討つしかないようですね……！
#. de: Er lässt uns keine andere Wahl. Verteidigt euch!
#. fr: Il n'est pas dans son état normal, mais pas le choix<nbsp>! Nous allons devoir le maîtriser<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11905:0:13"
msgid "Dabog is not in his right mind, but he leaves us little choice.<br>Defend yourselves!"
msgstr "Дабог не в себе, но выбора он нам не оставляет.<br>Защищайтесь!"

#. ja: 目を覚ましてください、ダボグさん！<br>貴方は、操られているのでしょう……！？
#. de: Dabog, widersetze dich ihnen! Du bist nicht du selbst!
#. fr: Reprends tes esprits, Dabog<nbsp>! Quelqu'un t'a sous son emprise<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11906:0:13"
msgid "Fight their control, Dabog!<br>This is not who you are!"
msgstr "Дабог, боритесь с ними!<br>Это не вы!"

#. ja: エネルギーゲイン低下……<br>サブ動力起動、攻撃パターンを変更しまス……。
#. de: Energieniveau sinkt. Initiiere alternative Angriffsmuster.
#. fr:  Niveaux d'énergie en baisse... Activation des générateurs auxiliaires. Changement de tactique.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11907:0:13"
msgid "Energy levels dropping. Initiating subroutines.<br>Launching alternative attack patterns."
msgstr "Уровень энергии падает. Запускаю вспомогательные системы.<br>Перехожу к альтернативным схемам атаки."

#. ja: ダボグさん…！<br>そのマシンは危険です！
#. de: Dabog! Verdammt, welcher Dämon hat diese Maschine geschaffen!
#. fr: Dabog<nbsp>! Sors de cette machine<nbsp>! Tu vas y laisser la vie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11908:0:13"
msgid "Dabog!<br>Gods, that machina is a menace!"
msgstr "Дабог!<br>Боги, да эта магитехника — настоящее бедствие!"

#. ja: バイシャーエン様<br>お気をつけを！
#. de: Vorsicht, Kommandant Bajsaljen!
#. fr: Bajsaljen<nbsp>! Soyez prudent<nbsp>!
msgctxt "NpcYell:11909:0:13"
msgid "Careful, sir!"
msgstr "Осторожнее, господин!"

#. ja: こちら、強化兵ダボグ……<br>機体損傷率、限界突破……これより帰投しまス……。
#. de: Hier Magitek-Soldat Dabog. Melde Hüllenschaden. Kehre ins Lager zurück.
#. fr: Ici Dabog... soldat augmenté... Niveau de dommages critique... Je retourne à la base.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11910:0:13"
msgid "This is hyperpilot Dabog.<br>Hull integrity compromised. Retreating to base."
msgstr "Говорит гиперпилот Дабог.<br>Корпус повреждён. Отступаю на базу."

#. ja: ダボグさん……待ってください！
#. de: Dabog, warte! Wir wollen dir helfen!
#. fr: Dabog<nbsp>! Attends<nbsp>!
msgctxt "NpcYell:11911:0:13"
msgid "Dabog, wait! Let us help you!"
msgstr "Дабог, стой! Давай поможем тебе!"

#. ja: テンパードとは異なる方法で、心を支配する方法があると……<br>あまりにも、あまりにも酷いではありませんか！
#. de: Reicht es nicht, unsere Freunde besessen zu machen? Müssen sie sie auch noch in Todesmaschinen verwandeln?
#. fr: Il n'est pourtant pas subjugué... Ces chiens de la 4e légion doivent le contrôler par un autre moyen<nbsp>!
msgctxt "NpcYell:11912:0:13"
msgid "Is tempering not abhorrent enough!? Must they seek out new ways to twist and control men's hearts!?"
msgstr "Неужели подчинять людей закалкой — уже недостаточно!? Им мало этого, и они ищут новые способы искажать и подчинять людские сердца!"

#. ja: バイシャーエン様…
#. de: Es ist schrecklich, Kommandant ...
#. fr: Commandant...
msgctxt "NpcYell:11913:0:13"
msgid "It lies beyond all reason, sir..."
msgstr "Это уже ни в какие ворота, господин..."

#. ja: しかし、ここで歩みを止めるわけにはいきません。<br>先に進むことで、彼を救う道も見つかるやもしれませんから……。
#. de: Wir dürfen keinen mehr verlieren. Wir müssen doppelt so gut kämpfen, enger zusammen stehen.
#. fr: Ne baissons pas les bras. Nous trouverons peut-être une solution qui le ramènera à la raison...
msgctxt "NpcYell:11914:0:13"
msgid "Then we must work doubly hard not to lose our own. We stay the course, and hope it also leads to his salvation..."
msgstr "Тогда будем вдвое усерднее беречь своих. Продолжим путь — и, быть может, найдём способ спасти и его..."

#. ja: こちら、強化兵ダボグ……<br>敵兵の排除に成功、これより帰投しまス……。
#. de: Hier Magitek-Soldat Dabog. Feinde vertrieben. Kehre ins Lager zurück.
#. fr: Ici Dabog... soldat augmenté... Menace ennemie éliminée. Je rentre à la base.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11915:0:13"
msgid "This is hyperpilot Dabog.<br>Hostiles routed. Returning to base."
msgstr "Говорит гиперпилот Дабог.<br>Враги отступили. Возвращаюсь на базу."

#. ja: 敵軍の動向を<br>探るのだ…
#. de: Wir müssen so viel wie möglich über den Feind herausfinden.
#. fr: Qu'est-ce que ces sales rebelles préparent encore...<nbsp>?
msgctxt "NpcYell:11916:0:13"
msgid "So this is where those Resistance rats were hiding..."
msgstr "Так вот где прятались эти крысы из Сопротивления..."

#. ja: レジスタンスの<br>部隊配置は…
#. de: Aha. Das ist also ihre Truppenaufstellung.
#. fr: Gardez l'œil ouvert.
msgctxt "NpcYell:11917:0:13"
msgid "Heh. Nothing escapes our eyes..."
msgstr "Хм. От наших глаз ничего не скроется..."

#. ja: ●ん？あれは何をしているんだ？
#. de: 0
#. fr: 0
msgctxt "NpcYell:11918:0:13"
msgid "0"
msgstr "0"

#. ja: あれは……帝国軍の偵察部隊！？
#. de: Garleische Spione?
#. fr: Des éclaireurs de l'Empire...<nbsp>!
msgctxt "NpcYell:11919:0:13"
msgid "Imperial scouts...?"
msgstr "Имперские разведчики?.."

#. ja: 情報を持ち帰らせるわけにはいきません！<br>ここで叩きます！
#. de: Lasst sie nicht mit den Informationen entkommen! Vernichtet sie!
#. fr: Leur commandement ne doit pas avoir vent de nos mouvements<nbsp>! Il faut les éliminer avant qu'ils fassent leur rapport<nbsp>!
msgctxt "NpcYell:11920:0:13"
msgid "If they relay this information to their superiors, we're done for! Kill them all!"
msgstr "Нельзя дать им донести эти сведения начальству — нам конец! Убейте их всех!"

#. ja: これでも「グンヒルドの剣」の端くれ……！<br>師匠から受け継いだ力で、皆を守らなくては！
#. de: Ich bin ebenfalls Mitglied der Königinnenwache! Mein Meister hat mich alles gelehrt!
#. fr: À moi de jouer<nbsp>! Je suis une lame de Gunnhildr aussi<nbsp>! Mon maître m'a enseigné son art pour que je protège les autres<nbsp>!
msgctxt "NpcYell:11921:0:13"
msgid "I, too, am a blade of Gunnhildr...and I will do my master proud!"
msgstr "Я тоже состою в Клинках Гуннхильд... И не посрамлю своего наставника!"

#. ja: 飛空戦艦隊に緊急通信……！<br>敵軍の強襲を受けている、至急、航空支援を……！
#. de: Sofort Luftunterstützung anfordern!
#. fr: Soutien aérien demandé de toute urgence<nbsp>! Nous sommes attaqués<nbsp>!
msgctxt "NpcYell:11922:0:13"
msgid "We're under attack! Request aerial support at once!"
msgstr "На воздушный флот срочно! Нас атакуют, нужна поддержка с воздуха!"

#. ja: 奴らをまとめて吹き飛ばしてくれ……！
#. de: Feuer! Zerreibt sie zu Staub!
#. fr: Feu à volonté<nbsp>! Pulvérisez-les tous<nbsp>!
msgctxt "NpcYell:11923:0:13"
msgid "Fire at will! Reduce them to ashes!"
msgstr "Огонь по готовности! Сжечь их дотла!"

#. ja: や、やりましたよ！<br>師匠、私……やってやりましたよ！
#. de: Ich hab's geschafft! Meister, ich hab's geschafft!
#. fr: C... C'était le dernier... J-j'ai réussi... On a réussi<nbsp>!
msgctxt "NpcYell:11924:0:13"
msgid "M-Master...did you see that!? Your student has done you proud!"
msgstr "Н-наставник... видели!? Ваша ученица не подвела!"

#. ja: ほう……貴様もまた「グンヒルドの剣」とやらか……<br>データ収集への協力に感謝しよう。
#. de: Ach, du gehörst auch zur Königinnenwache? Sehr schön, auf diese Daten bin ich besonders gespannt.
#. fr: *Prscht* Intéressant... Alors toi aussi tu es une de ces lames de Gunnhildr<nbsp>? Je te remercie, ton combat m'a beaucoup appris...
msgctxt "NpcYell:11925:0:13"
msgid "So you are one of Gunnhildr's Blades, yes? Thank you for kindly volunteering this information."
msgstr "Так ты тоже из Клинков Гуннхильд? Благодарю за любезно предоставленные сведения."

#. ja: 魔導兵器越しに監視とは、随分と臆病ですね……。<br>次は貴方自ら、戦場に出てくることですね！
#. de: Man spioniert mich aus? Pah. Das nächste Mal kreuzen wir die Waffen.
#. fr: Vous vous êtes servi de cette arme magitek pour nous espionner<nbsp>? Lâche<nbsp>! La prochaine fois, nous discuterons face à face<nbsp>!
msgctxt "NpcYell:11926:0:13"
msgid "Hah! Spying from the comfort of magitek armor, I see. Next time, we cross blades on the battlefield!"
msgstr "Ха! Шпионите, не выходя из магитехнической брони? В следующий раз сойдёмся на поле боя!"

#. ja: お、押されている！？<br>師匠、私はどうすれば…………！！
#. de: Sie machen Druck! Was sollen wir tun?
#. fr: I-ils ont repoussé nos assauts... Maître, que feriez-vous dans pareille situation<nbsp>!?
msgctxt "NpcYell:11927:0:13"
msgid "Our attacks barely scathe them. Oh, Master, whatever shall I do!?"
msgstr "Наши атаки едва их царапают. О наставник, что же мне делать!?"

#. ja: そうか味方の脱出を……<br>皆さん、悔しいですが後退しましょう……！
#. de: Unsere Kameraden fliehen? Also gut, ziehen wir uns auch zurück.
#. fr: La vie de vos camarades avant tout, n'est-ce pas...<nbsp>? Mes amis<nbsp>! Battons en retraite<nbsp>! Nous ferons mieux la prochaine fois<nbsp>!
msgctxt "NpcYell:11928:0:13"
msgid "R-Right... We must live to fight another day. Retreat! Retreat, I say!"
msgstr "П-правильно... Надо ещё повоевать. Отступаем! Отступаем, говорю!"

#. ja: り、了解ッ！
#. de: Z-Zu Befehl!
#. fr: À-à vos ordres<nbsp>!
msgctxt "NpcYell:11929:0:13"
msgid "A-Aye!"
msgstr "С-слушаюсь!"

#. ja: こ、これだけの数、我々だけでは……！
#. de: Verdammt, es sind zu viele!
#. fr: Une armure magitek passait encore, mais là<nbsp>! Nous n'avons aucune chance<nbsp>!
msgctxt "NpcYell:11930:0:13"
msgid "Curses, there are too many..."
msgstr "Чёрт, их слишком много..."

#. ja: バイシャーエン様！<br>援軍に駆けつけましたぞ！
#. de: Kommandant Bajsaljen! Die Verstärkung!
#. fr: Bajsaljen<nbsp>! Les renforts sont là<nbsp>!
msgctxt "NpcYell:11931:0:13"
msgid "Allow us to even the odds!"
msgstr "Позвольте сравнять силы!"

#. ja: み、皆さん…<br>よくぞ来てくれました！
#. de: Ihr kommt genau richtig.
#. fr: Vous arrivez à point nommé<nbsp>!
msgctxt "NpcYell:11932:0:13"
msgid "You couldn't have picked a better moment!"
msgstr "Вы пришли как нельзя вовремя!"

#. ja: 私にもお手伝いを<br>させてください…！
#. de: Erlaubt uns, euch auszuhelfen, Freunde.
#. fr: Permettez-moi de me joindrrre à vous<nbsp>!
msgctxt "NpcYell:11933:0:13"
msgid "We stand with you!"
msgstr "Мы с вами!"

#. ja: 敵旗艦は目前…！<br>勝利あるのみです！
#. de: Wir holen uns das Flaggschiff!
#. fr: L'ennemi est droit devant<nbsp>! Nous vaincrons<nbsp>!
msgctxt "NpcYell:11934:0:13"
msgid "Down with the IVth!"
msgstr "Долой Четвёртый легион!"

#. ja: 我らも共に！
#. de: Zusammen stehen wir das durch!
#. fr: Comptez sur nous<nbsp>!
msgctxt "NpcYell:11935:0:13"
msgid "Let's do this!"
msgstr "И мы с вами!"

#. ja: やってやりましょう！
#. de: Wir werden gewinnen!
#. fr: Mettons-les en pièces<nbsp>!
msgctxt "NpcYell:11936:0:13"
msgid "We will prevail!"
msgstr "Мы победим!"

#. ja: お守りします！
#. de: Ich beschütze euch!
#. fr: Je vous couvre<nbsp>!
msgctxt "NpcYell:11937:0:13"
msgid "I have your backs!"
msgstr "Я вас прикрою!"

#. ja: 皆さん、ありがとうございます……！<br>総員、ボズヤ人の命を弄ぶ、非道なる帝国軍を打ち払うのです！
#. de: Danke, Freunde. Gemeinsam werden wir die Garlear von hier vertreiben.
#. fr: Merci à vous tous<nbsp>! Détruisons ces machines démoniaques qui se nourrissent de nos compatriotes<nbsp>!
msgctxt "NpcYell:11938:0:13"
msgid "Thank you, my friends! Let us put an end to the Empire's villainy!"
msgstr "Спасибо, друзья! Пора положить конец бесчинствам Империи!"

#. ja: ガンゴッシュに<br>移送します…！
#. de: In Gangos wartet eine Zelle auf ihn!
#. fr: Direction les geôles de Gangos<nbsp>!
msgctxt "NpcYell:11939:0:13"
msgid "We will send him to Gangos!"
msgstr "Мы отправим его в Гангос!"

#. ja: 現在、十字鍬通りにて、<br>「ぬいぐるみ組立競争」を開催中です～！
#. de: Das Fête „Stoff der Träume“ hat am Kreuzkarst-Spalier begonnen.
#. fr: La feste “La fabrique à peluches” se déroule en ce moment même au Hoyau<nbsp>!
msgctxt "NpcYell:11940:0:13"
msgid "The fête “Made of Softer Stuff” is currently underway on the Mattock."
msgstr "На Мотыге проходит фестиваль «Плюшевое дело»."

#. ja: 「ぬいぐるみ組立競争」では、箱に入った材料を組み立てると、<br>大きなぬいぐるみができあがりますよ！
#. de: Das ist die Chance, ein Stofftier zu erschaffen, das Kinderherzen schmelzen lässt!
#. fr: Des matériaux vous attendent pour fabriquer les peluches les plus mignonnes et moelleuses qui soient<nbsp>!
msgctxt "NpcYell:11941:0:13"
msgid "Don't miss this chance to craft adorably large stuffed toys!"
msgstr "Не упустите шанс смастерить очаровательные большие игрушки!"

#. ja: オラアアアァァァッ！
#. de: Uraaaaaaah!
#. fr: Rhaaaaaah<nbsp>!
msgctxt "NpcYell:11942:0:13"
msgid "Hrrraaah!"
msgstr "Рррра-а-а!"

#. ja: ウゥオオオォォォッ！
#. de: Uoooraaah!
#. fr: Uuuoaaaah<nbsp>!
msgctxt "NpcYell:11943:0:13"
msgid "Rrruaaah!"
msgstr "Ррруаа-а-а!"

#. ja: 終了時刻が近づいてきました！<br>皆さん、最後まで楽しんでくださいね～！
#. de: Ich rate zur Eile, Freunde. Die Zeit ist bald um!
#. fr: Dépêchez-vous, la fin du temps imparti approche à grands pas<nbsp>!
msgctxt "NpcYell:11944:0:13"
msgid "Hurry, friends! Time is almost up!"
msgstr "Поторопитесь, друзья! Время почти вышло!"

#. ja: ただいま「十字鍬通り」で開催中の「ぬいぐるみ組立競争」、<br>いよいよ終わりが近づいてきました！
#. de: Das Fête „Stoff der Träume“ wird schon bald wieder enden!
#. fr: La feste “La fabrique à peluches” qui se déroule au Hoyau est sur le point de se terminer<nbsp>!
msgctxt "NpcYell:11945:0:13"
msgid "The fête “Made of Softer Stuff” will soon conclude."
msgstr "Фестиваль «Плюшевое дело» скоро завершится."

#. ja: まもなく、ぬいぐるみの納入を締め切りますよ～。<br>もしまだ持っている方は、荷車までお急ぎください！
#. de: Falls ihr noch einen flauschigen Trostspender haben solltet, der noch nicht abgeliefert wurde, solltet ihr euch beeilen!
#. fr: Plus que quelques instants avant que la collecte de peluches se termine. Finissez vite votre livraison<nbsp>!
msgctxt "NpcYell:11946:0:13"
msgid "If you still have a toy, please hurry and deliver it to the wain!"
msgstr "Если у вас ещё осталась игрушка, скорее отнесите её к повозке!"

#. ja: なお、クラフターまたはギャザラーの方にしか、<br>プレゼントはお渡しできませんので、お気をつけくださいね！
#. de: Bitte behaltet eure Handwerker- und Sammler-Kluft an, um uns das Zuteilen der Belohnungen zu erleichtern.
#. fr: N'oubliez pas que seuls les artisans et les récolteurs ont droit à une récompense<nbsp>!
msgctxt "NpcYell:11947:0:13"
msgid "To assist us in distributing rewards, please remain in your artisan's attire until you have received yours."
msgstr "Чтобы мы могли вручить вам награду, оставайтесь в одежде ремесленника или собирателя, пока не получите её."

#. ja: 皆さん、警戒を…<br>私から話してみます
#. de: Bleibt auf der Hut. Das Sprechen übernehme ich.
#. fr: Restez sur vos gardes. Je vais essayer de lui parler.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:11948:0:13"
msgid "Be on your guard.<br>I will speak with this lost lamb."
msgstr "Будьте начеку.<br>Я попробую поговорить с этим заблудшим ягнёнком."

#. ja: 現在、詩伯門前で「ヤクの毛刈り競争」を開催中です！<br>参加するとプレゼントがもらえますよ～！
#. de: Das Fête „Yak-o-matik“ findet an der Balladenpassage statt. Helft uns, das riesige Yak von seinem Fell zu befreien!
#. fr: La feste “Y a qu'à tondre” se tient ac<shy>tu<shy>el<shy>le<shy>ment devant la porte des Industrieux<nbsp>! Venez participer et remporter des cadeaux<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:11949:0:13"
msgid "The fête “Shear-a-Yak” is currently being held at Bright Ballad's Passage. Join us in the fun and reap─or should I say, <i>shear</i>─the rewards!"
msgstr "Фестиваль «Яковая стрижка» проходит у Прохода Светлой баллады. Повеселитесь и получите награду — или, вернее, <i>состригите</i> её!"

#. ja: 「エーテルクリッパー」の調子はいかがですか？<br>モフモフチョコボたちが一つ一つメンテナンスしているんです！
#. de: Wie gefällt dir die Ätherschere? Der Plüschpuschel-Chocobo ist besonders stolz auf dieses nützliche Werkzeug!
#. fr: Les éthérotondeuses marchent à plein tube<nbsp>? Remerciez nos mascottes qui les bichonnent tous les jours<nbsp>!
msgctxt "NpcYell:11950:0:13"
msgid "I trust your clippers are firing well─our mascots are meticulous with their maintenance!"
msgstr "Надеюсь, ваши ножницы работают как надо. Наши талисманы тщательно следят за их состоянием!"

#. ja: 参加者の皆さん～、たっぷりエサを与えてありますから、<br>ウーリーヤクちゃんのご機嫌はご心配なく～！
#. de: Aber sei unbesorgt. Die Ätherschere ist absolut sicher und das Yak mampft friedlich vor sich hin - dank einer Extraportion Heu!
#. fr: Notre ami laineux a bien été nourri, donc ne vous en faites pas, il n'y a aucun danger<nbsp>!
msgctxt "NpcYell:11951:0:13"
msgid "Lest you worry for your safety, I assure you our wooly friend has been rendered docile with a feast of his favorite fodder."
msgstr "Не бойтесь, наш шерстяной друг усмирён любимым кормом — он объелся до отвала."

#. ja: ただいま詩伯門前で開催中の「ヤクの毛刈り競争」、<br>いよいよ終わりが近づきました！
#. de: Das Fête „Yak-o-matik“ wird bald enden!
#. fr: La feste “Y a qu'à tondre” qui se déroule devant la porte des Industrieux est sur le point de se terminer<nbsp>!
msgctxt "NpcYell:11952:0:13"
msgid "The fête “Shear-a-Yak” will soon conclude."
msgstr "Фестиваль «Яковая стрижка» скоро завершится."

#. ja: まもなく、ヤクの毛の納品を締め切ります～。<br>柔らかい毛を堪能したら、モフモフチョコボまでお渡しください！
#. de: Falls du noch Körbe mit Yak-Wolle besitzt, liefere sie umgehend an den Plüschpuschel-Chocobo!
#. fr: La feste est sur le point de se terminer<nbsp>! Si vous avez encore de la laine sur vous, dépêchez-vous de l'apporter au chocobo chatoyant<nbsp>!
msgctxt "NpcYell:11953:0:13"
msgid "If you still have fleece, please hurry and deliver it to Chirpy Chocobo!"
msgstr "Если у вас ещё осталась шерсть, скорее отнесите её чирикающему чокобо!"

#. ja: なお、クラフターまたはギャザラーの方にしか、<br>プレゼントはお渡しできませんので、お気をつけくださいね！
#. de: Bitte behaltet eure Handwerker- und Sammler-Kluft an, um uns das Zuteilen der Belohnungen zu erleichtern.
#. fr: N'oubliez pas que seuls les artisans et les récolteurs ont droit à une récompense<nbsp>!
msgctxt "NpcYell:11954:0:13"
msgid "To assist us in distributing rewards, please remain in your artisan's attire until you have received yours."
msgstr "Чтобы мы могли вручить вам награду, оставайтесь в одежде ремесленника или собирателя, пока не получите её."

#. ja: 現在「アバカス通り」で「ぬいぐるみ集め競争」を開催中です！<br>参加するとプレゼントがもらえますよ～！
#. de: Das Fête „Jäger des versteckten Mogrys“ findet gerade in der Allee des Abakus statt.
#. fr: Envie de cadeaux<nbsp>? Venez participer à la feste “La chasse au jouet” qui est en train de se tenir à L'Abaque<nbsp>!
msgctxt "NpcYell:11955:0:13"
msgid "The fête “Toy Hunter” is underway on the Abacus. Seek and you will find, participate and you will receive─prizes, that is!"
msgstr "На Счётах проходит фестиваль «Охотник за игрушками». Ищите — и найдёте, участвуйте — и получите... призы, конечно!"

#. ja: 箱のどれかに隠されたアタリのぬいぐるみを探して、<br>クルクルポーキーに渡してくださいね！
#. de: Die Regeln sind denkbar einfach: Öffne das richtige Geschenk, finde einen Glücksmogry und überreiche ihn Kullerkringel-Grunzi!
#. fr: Les règles sont simples<nbsp>! Ouvrez les paquets cadeaux pour trouver la peluche gagnante et apportez-la au porcelet polisson<nbsp>!
msgctxt "NpcYell:11956:0:13"
msgid "The rules are simple: open the right present box to find the lucky toy, and see it to Perky Piggy's hands."
msgstr "Правила просты: откройте нужную коробку с подарком, найдите счастливую игрушку и передайте её бойкому поросёнку."

#. ja: 現在「アバカス通り」で「ぬいぐるみ集め競争」を開催中です！<br>まだまだ参加は間に合いますよ～！
#. de: Das Fête „Jäger des versteckten Mogrys“ hat soeben in der Allee des Abakus begonnen. Noch ist Zeit, daran teilzunehmen!
#. fr: Il n'est pas trop tard pour participer à la feste “La chasse au jouet”<nbsp>! Rendez-vous vite à L'Abaque<nbsp>!
msgctxt "NpcYell:11957:0:13"
msgid "The fête “Toy Hunter” is underway on the Abacus. It isn't too late to participate and receive prizes!"
msgstr "На Счётах проходит фестиваль «Охотник за игрушками». Ещё не поздно поучаствовать и получить призы!"

#. ja: 可愛いポーキーちゃんになってしまった方、<br>いたずらは数秒で解除されるので焦らず楽しんでくださいね～！
#. de: Huch, ist da jemand zum Ferkel geworden? Aber wer wollte nicht schon immer mal dem Sauleben frönen?!
#. fr: Si vous êtes transformé en petit porcelet tout chou, ne vous en faites pas, le sortilège s'estompe très vite<nbsp>!
msgctxt "NpcYell:11958:0:13"
msgid "If you find yourself turned into a cute little piggy, fret not. The magick swiftly wears off."
msgstr "Если вы вдруг превратились в милого поросёнка, не волнуйтесь. Чары быстро рассеются."

#. ja: 終了のお時間が近づいてきました！<br>皆さん、アタリは出ましたか～？
#. de: Die Geschenkejagd nähert sich ihrem Ende! Ich hoffe, die Jagd war von Erfolg gekrönt!
#. fr: La fin du temps imparti est proche<nbsp>! Combien de peluches avez-vous réussi à trouver<nbsp>?
msgctxt "NpcYell:11959:0:13"
msgid "The hunt is drawing to a close. How many lucky toys have you found thus far?"
msgstr "Охота подходит к концу. Сколько счастливых игрушек вам удалось найти?"

#. ja: 現在「アバカス通り」で開催中の「ぬいぐるみ集め競争」、<br>まもなく終了です～！
#. de: Das Fête „Jäger des versteckten Mogrys“ endet in Kürze!
#. fr: La feste “La chasse au jouet” qui se déroule à L'Abaque touche à sa fin<nbsp>!
msgctxt "NpcYell:11960:0:13"
msgid "The fête “Toy Hunter” will soon conclude."
msgstr "Фестиваль «Охотник за игрушками» скоро завершится."

#. ja: まもなく、アタリの納品を締め切ります～。<br>お持ち帰りできませんので、クルクルポーキーにお渡しください！
#. de: Auch wenn es schmerzt, die flatterigen Mogrys müssen abgegeben werden. Bitte liefert sie zügig an Kullerkringel-Grunzi!
#. fr: Il sera bientôt trop tard pour remettre les peluches gagnantes au porcelet polisson<nbsp>! Si vous en avez une sur vous, c'est maintenant ou jamais<nbsp>!
msgctxt "NpcYell:11961:0:13"
msgid "Loath though I am to disappoint, you can't take the lucky toys home with you. Please deliver them to Perky Piggy."
msgstr "Не хочется вас огорчать, но забрать счастливые игрушки домой нельзя. Отнесите их бойкому поросёнку."

#. ja: なお、クラフターまたはギャザラーの方にしか、<br>プレゼントはお渡しできませんので、お気をつけくださいね！
#. de: Bitte behaltet eure Handwerker- und Sammler-Kluft an, um uns das Zuteilen der Belohnungen zu erleichtern.
#. fr: N'oubliez pas que seuls les artisans et les récolteurs ont droit à une récompense<nbsp>!
msgctxt "NpcYell:11962:0:13"
msgid "To assist us in distributing rewards, please remain in your artisan's attire until you have received yours."
msgstr "Чтобы мы могли вручить вам награду, оставайтесь в одежде ремесленника или собирателя, пока не получите её."

#. ja: ただいま「十字鍬通り」と「中央の広場」で、<br>「プレゼント配り競争」を開催中です！
#. de: Kommen wir zum nächsten Fête: „Bote der Glückseligkeit“! Es findet am Kreuzkarst-Spalier statt.
#. fr: La feste “À chacun son cadeau”, c'est tout de suite et maintenant sur la place centrale du Hoyau<nbsp>!
msgctxt "NpcYell:11963:0:13"
msgid "The fête “Presents of Mind” is currently taking place on the Mattock."
msgstr "На Мотыге проходит фестиваль «Подарки с умом»."

#. ja: マスコットが用意したプレゼントボックスを、<br>それぞれが配りたい相手に渡してあげましょう！
#. de: Sammelt die Geschenke, die die Maskottchen vorbereitet haben und verteilt sie an die Bewohner von Himmelsstadt!
#. fr: Prenez les cadeaux préparés par les mascottes et apportez-les aux bons des<shy>ti<shy>na<shy>tai<shy>res<nbsp>!
msgctxt "NpcYell:11964:0:13"
msgid "Take the presents the mascots have prepared, and see them delivered to the right people!"
msgstr "Возьмите подарки, приготовленные талисманами, и отнесите их нужным людям!"

#. ja: ただいま「十字鍬通り」と「中央の広場」で、<br>「プレゼント配り競争」を開催中で～す！
#. de: Das Fête „Bote der Glückseligkeit“ findet am Kreuzkarst-Spalier statt!
#. fr: Pour participer à la feste “À chacun son cadeau”, rendez-vous vite sur la place centrale du Hoyau<nbsp>!
msgctxt "NpcYell:11965:0:13"
msgid "The fête “Presents of Mind” is currently taking place on the Mattock."
msgstr "На Мотыге проходит фестиваль «Подарки с умом»."

#. ja: プレゼントを受け取った人たち、みんな嬉しそうですね！<br>どんどん運びましょう～！
#. de: Seht nur das Glück auf den Gesichtern der Beschenkten! Nur weiter so!
#. fr: Regardez-moi le sourire sur ces visages<nbsp>! Continuez à distribuer des cadeaux pour faire des heureux<nbsp>!
msgctxt "NpcYell:11966:0:13"
msgid "Such delight writ upon the faces of the recipients! Come, let's keep up the gift giving!"
msgstr "Посмотрите, как радуются получатели! Ну-ка, продолжим раздавать подарки!"

#. ja: 終了時間が近づいてきました！<br>もうひと踏んばりです！
#. de: Das Ende des Geschenkereigens naht! So schön es auch ist ...
#. fr: Dans quelques instants, la dis<shy>tri<shy>bu<shy>tion de cadeaux s'achèvera<nbsp>! C'est le moment de donner tout ce que vous avez<nbsp>!
msgctxt "NpcYell:11967:0:13"
msgid "Hurry, friends! Not long now until the gift giving must come to an end!"
msgstr "Поторопитесь, друзья! Скоро раздача подарков закончится!"

#. ja: 現在、十字鍬通りと中央の広場で開催中の、<br>「プレゼント配り競争」、まもなく終了のお時間です～！
#. de: Das Fête „Bote der Glückseligkeit“ endet bald!
#. fr: La feste “À chacun son cadeau” qui se déroule sur la place centrale du Hoyau va bientôt prendre fin<nbsp>!
msgctxt "NpcYell:11968:0:13"
msgid "The fête “Presents of Mind” will soon conclude."
msgstr "Фестиваль «Подарки с умом» скоро завершится."

#. ja: まもなく、競技が終了します～。<br>プレゼントボックスをお持ちの方は、配布をお願いします。
#. de: Bitte händigt das letzte Geschenk aus, bevor die Zeit abläuft.
#. fr: C'est ici que ça se termine<nbsp>! Si vous avez encore des cadeaux, dépêchez-vous de les offrir<nbsp>!
msgctxt "NpcYell:11969:0:13"
msgid "Time is almost up, friends. Please deliver your last presents."
msgstr "Время почти вышло, друзья. Раздайте оставшиеся подарки!"

#. ja: これにて一連の「Fête」はすべて終了となります。<br>参加してくださったみなさん、ありがとうございました～！
#. de: Damit sind alle Fêtes abgeschlossen! Wir bedanken uns für die rege Teilnahme und hoffen, es hat viel Freude bereitet!
#. fr: Cette série de festes est sur le point de s'achever. Merci à toutes et à tous de nous avoir rejoints, j'espère que ça vous a plu<nbsp>!
msgctxt "NpcYell:11970:0:13"
msgid "As today's excitement draws to a close, may we say what wonderful participants you have all been!"
msgstr "Вот и подошло к концу сегодняшнее веселье. Спасибо, что участвовали!"

#. ja: 彼らが本物のダボグさんでないとしたら、<br>いったい彼はどこに……！
#. de: Keiner von denen ist Dabog. Was ist mit ihm geschehen?
#. fr: Si aucun d'eux n'est le vrai Dabog... Alors où est-il<nbsp>!?
msgctxt "NpcYell:11971:0:13"
msgid "If none of them are Dabog, what have you done with him!?"
msgstr "Если среди них нет настоящего Дабога, что вы с ним сделали!?"

#. ja: あぁ……被検体VIII号のことか……<br>プロトタイプとして、よく役目を果たしてくれたよ。
#. de: Ach, Testobjekt VIII? Ja, ein gelungener Prototyp.
#. fr: Le vrai Dabog<nbsp>? Ah, vous voulez parler du sujet numéro 8, je suppose. Il a par<shy>fai<shy>te<shy>ment accompli sa tâche de prototype.
msgctxt "NpcYell:11972:0:13"
msgid "Ah yes, subject VIII. He was a truly exceptional prototype."
msgstr "Ах да, подопытный номер VIII. Он и правда оказался выдающимся прототипом."

#. ja: しかし、度重なるテストで肉体の方が限界でね……。<br>複雑な戦闘機動は、どうにも生体部品に負荷がかかるのだ。
#. de: Doch sein Fleisch hielt den Belastungen der Testumgebung nicht stand. Eine so komplexe Maschine verlangt ihren lebenden Komponenten viel ab.
#. fr: Mes tests répétés l'ont quelque peu... endommagé. Je ne pouvais plus m'en servir pour piloter mes armures magitek.
msgctxt "NpcYell:11973:0:13"
msgid "Alas, his flesh eventually succumbed to the rigors of testing. Controlling such complex machinery takes a heavy toll, you see."
msgstr "Увы, его тело не выдержало испытаний. Управление такой сложной машиной требует слишком многого, понимаете ли."

#. ja: だが、第VII軍団が編み出した戦闘データの抽出と、<br>他者への上書き技術を応用することで、問題は解決された……。
#. de: Zum Glück hat die VII. Legion Mittel und Wege gefunden, um Erinnerungen zu transferieren.
#. fr: J'ai donc extrait toutes les con<shy>nais<shy>san<shy>ces qu'il avait accumulées, puis je les ai transférées dans mes nouveaux soldats augmentés.
msgctxt "NpcYell:11974:0:13"
msgid "Fortunately, we were able to overcome this problem by means of the VIIth's data extraction technique."
msgstr "К счастью, эту проблему удалось решить благодаря технологии извлечения данных Четвёртого легиона."

#. ja: 被検体VIII号の記憶は、<br>戦闘技能ごと「彼ら」に移植されているのだよ……！
#. de: Wir haben seine ganze Kampf<shy>erfahrung, all sein Wissen und Können in diese Soldaten übertragen.
#. fr: Données de combat, mais aussi mémoire. Je n'ai pas vraiment fait le tri, vous pensez bien<nbsp>!
msgctxt "NpcYell:11975:0:13"
msgid "From his combat expertise to his memories, we transferred everything into these enhanced soldiers. "
msgstr "Мы перенесли в этих усовершенствованных солдат всё: и боевые навыки, и воспоминания."

#. ja: な、なんという、おぞましい行為を……！<br>とても、人が人に対して行える所業とは思えません！
#. de: Wie bitte? Was für eine fürchterliche Tat! Hast du denn kein Herz?
#. fr: Comment pouvez-vous faire ça à des êtres humains<nbsp>!? Vous êtes abominable<nbsp>! Les Dieux vous le par<shy>don<shy>ne<shy>ront peut-être, mais pas moi<nbsp>!
msgctxt "NpcYell:11976:0:13"
msgid "What!? You heartless fiend! Does your depravity know no bounds!?"
msgstr "Что!? Бессердечный негодяй! Неужели твоей низости нет предела!?"

#. ja: おのれ、許さんぞ、帝国人……！<br>同志ダボグの無念、ここで晴らさせてもらうぞ！
#. de: Dafür wirst du sterben! Rache für Dabog!
#. fr: Tu vas payer<nbsp>! Dabog aura sa vengeance à travers nous<nbsp>!
msgctxt "NpcYell:11977:0:13"
msgid "You will pay for this! We will avenge Dabog!"
msgstr "Ты за это заплатишь! Мы отомстим за Дабога!"

#. ja: な、なんだと……我が強化兵部隊が全滅だと……！？<br>し、仕方あるまい……！
#. de: Unmöglich! Wie konnte diese Einheit besiegt werden!
#. fr: M-mes unités ne répondent plus<nbsp>!? Grrrr... Tant pis<nbsp>!
msgctxt "NpcYell:11978:0:13"
msgid "Impossible... That my enhanced unit should be wiped out..."
msgstr "Невозможно... Мой отряд усовершенствованных солдат уничтожен?.."

#. ja: まだ調整中だが、アレを投入するしかあるまい！<br>今のうちに、せいぜい勝利に酔いしれておくことだな……！
#. de: Also gut, ihr lasst mir keine Wahl. Genießt diesen Triumph, solange ihr noch könnt.
#. fr: Je devais encore procéder à quelques ajustements, mais vous ne me laissez pas le choix<nbsp>! Rira bien qui rira le dernier<nbsp>!
msgctxt "NpcYell:11979:0:13"
msgid "So be it. I had intended to conduct more tests, but you leave me no choice. Savor your victory while you still can!"
msgstr "Что ж, выбора вы мне не оставили. Я собирался провести ещё испытания, но придётся ввести в бой то, что есть. Наслаждайтесь победой, пока можете!"

#. ja: まだ切り札があるかのような<br>口ぶりでしたが…
#. de: Hört sich so an, als hätte er noch etwas in der Hand.
#. fr: On dirait qu'il n'a pas encore abattu sa dernière carrrte...
msgctxt "NpcYell:11980:0:13"
msgid "It sounds as though he hasn't shown all of his hand yet..."
msgstr "Похоже, он ещё не показал все свои козыри..."

#. ja: 気が抜けませんね…<br>心してかからなければ…！
#. de: Was es auch sein mag, wir werden schon damit fertig.
#. fr: Peu importe ce qu'il prépare<nbsp>! Nous resterons sur nos gardes, et l'affronterons sans faillir le moment venu<nbsp>!
msgctxt "NpcYell:11981:0:13"
msgid "Well, whatever it is he has coming, we'll be ready to fight!"
msgstr "Что бы он ни задумал, мы будем готовы дать бой!"

#. ja: ええ、警戒しながらも、戦い続けるのみです。<br>ダボグさんの犠牲を無駄にしないためにも……。
#. de: Ganz bestimmt. Für Dabog und alle anderen, die unter diesem fürchterlichen Projekt gelitten haben.
#. fr: Bien dit. Nous vaincrons, pour Dabog<nbsp>!
msgctxt "NpcYell:11982:0:13"
msgid "Indeed. We will fight, and we will triumph─for Dabog and everyone we have lost."
msgstr "Именно. Мы будем сражаться и победим — ради Дабога и всех, кого потеряли."

#. ja: さあ、前哨地に帰還し、次なる戦いに備えましょう……！
#. de: Jetzt aber zurück zur Gemarkung. Wir können etwas Ruhe gebrauchen.
#. fr: Rentrons à l'avant-poste. Nous devons être prêts à tout<nbsp>!
msgctxt "NpcYell:11983:0:13"
msgid "Come, my friends. Let us return to the encampment and prepare for the next battle."
msgstr "Ну что, друзья, вернёмся в лагерь и подготовимся к следующему бою."

#. ja: なんという火力…<br>皆さん、撤退を！
#. de: Die Kriegsmaschinen sind zu stark! Alle Mann, Rückzug!
#. fr: La puissance de ces machines dépasse l'imagination... Battez en retraite<nbsp>!
msgctxt "NpcYell:11984:0:13"
msgid "Ugh, we cannot contend with such firepower... Fall back! Fall back!"
msgstr "Ух, с такой огневой мощью нам не справиться... Отступаем! Назад!"

#. ja: む、無念…！
#. de: Verdammt ...
#. fr: Non... J'ai failli...
msgctxt "NpcYell:11985:0:13"
msgid "Damn you!"
msgstr "Будь ты проклят!"

#. ja: 悔しいっ…！
#. de: Ich bin zu schwach ...
#. fr: Je suis si faible<nbsp>!
msgctxt "NpcYell:11986:0:13"
msgid "If only I were stronger..."
msgstr "Вот бы мне быть сильнее..."

#. ja: 今のうちに撤退を…！
#. de: Rennen wir, solange wir noch können!
#. fr: Fuyons pendant que nous le pouvons encorrre<nbsp>!
msgctxt "NpcYell:11987:0:13"
msgid "We must retreat while we can!"
msgstr "Надо отступать, пока можем!"

#. ja: 見つけたぞ、ウラベのヤマツミ！<br>マルシャーク殿から情報を聞き、貴様を追ってきた！
#. de: Haben wir dich, Urabe-no-Yamatsumi! Marsaks Informationen waren also richtig.
#. fr: Tu es fait, Urabe-no-Yamatsumi<nbsp>! Marsak nous a prévenus de ta présence ici<nbsp>!
msgctxt "NpcYell:11988:0:13"
msgid "Urabe-no-Yamatsumi, you thief! Marsak told us where to find you!"
msgstr "Ямэцуми Урабэ, вор! Марсак сказал, где тебя искать!"

#. ja: ドマの至宝を盗んで姿を消した貴様が、<br>なぜボズヤの地に……なぜ帝国に協力しているのでござる！？
#. de: Du hast den Schatz gestohlen und bist aus Doma geflohen, aber warum nur machst du gemeinsame Sache mit den Garlearn?
#. fr: Pourquoi coopères-tu avec les Impériaux<nbsp>!? Pourquoi as-tu fui en Bozja après avoir dérobé le trésor de Doma<nbsp>!?
msgctxt "NpcYell:11989:0:13"
msgid "What madness has possessed you to abscond with Doma's treasure? To lick the boots of the Empire!?"
msgstr "Ты с ума сошёл? Украл сокровище Домы — и ещё служишь Империи!?"

#. ja: 我を盗人呼ばわりとは……<br>ドマの忍びよ、同郷のよしみで教えてやろう。
#. de: Ich schulde euch keine Erklärung, Shinobi. Aber ich verrate es euch trotzdem.
#. fr: Moi, un voleur, un fuyard<nbsp>? Hmpf... Nous sommes nés sur la même terre, alors je vais te faire le privilège de te répondre, shinobi de Doma.
msgctxt "NpcYell:11990:0:13"
msgid "Thieves? Do you forget your roots, shinobi of Doma? You deserve no explanation, but for the motherland we share, you shall have it."
msgstr "Воры? Ты забыл свои корни, ниндзя Домы? Ты не заслуживаешь объяснений, но ради нашей общей родины я всё же отвечу."

#. ja: 古来より祭事を司ってきた我が一族は、<br>ヨツユ圧政下にあって、神職として厳しく弾圧されていた。
#. de: Mein Clan gab niemals seinen Glauben auf, auch nicht unter Yotsuyus schrecklicher Herrschaft.
#. fr: Mon clan célébrait les rituels religieux depuis des temps immémoriaux. En tant que tels, nous avons cruellement souffert de la tyrannie de Yotsuyu.
msgctxt "NpcYell:11991:0:13"
msgid "The priests endured untold suffering under Yotsuyu's iron rule, her ire toward our traditions often turning to wrath."
msgstr "Наши жрецы веками оберегали священные обряды. При Ёцуе их жестоко притесняли, а наши традиции вызывали у неё лишь гнев."

#. ja: そんな我らを、ノア様は密かに保護してくださった。<br>命救われた恩義には、命賭して報いる……それだけのことよ。
#. de: Wir überlebten nur, weil Legatus Noah uns Gnade erwies. Mit dem Schatz zahlten wir nur eine jahrelange Schuld zurück.
#. fr: Mais nous avons survécu, grâce à Noah qui nous a secrètement protégés de cette oppression. Nous lui devons nos vies, et elles sont désormais siennes.
msgctxt "NpcYell:11992:0:13"
msgid "Only by Legatus Noah's grace did we survive those dark times. Delivering this treasure to him is the least we can do to repay his clandestine efforts to aid us."
msgstr "Мы выжили лишь благодаря легату Ною, который тайно нас защищал. Передать ему это сокровище — меньшее, чем мы можем отплатить за его помощь."

#. ja: だからと言って、ボズヤを支配する側に協力するなんて……<br>彼らの自由はどうなるのです！
#. de: Du verbeugst dich vor den garleischen Besatzern? Hat dich Yotsuyus Schreckensherrschaft also nichts gelehrt?
#. fr: Cela ne saurait justifier de passer à l'ennemi pour asservir le peuple domien... Que fais-tu de leur liberté à eux<nbsp>!?
msgctxt "NpcYell:11993:0:13"
msgid "And in repaying your debt you would stifle the Bozjans? Think about the full reach of your actions!"
msgstr "И ради уплаты долга ты готов душить народ Бозьи? Подумай, к чему приведут твои поступки!"

#. ja: ●ここまでだヤマツミ！覚悟しろ！！
#. de: 0
#. fr: 0
msgctxt "NpcYell:11994:0:13"
msgid "0"
msgstr "Тебе конец, Ямэцуми! Приготовься!"

#. ja: ●観念しなさいっ！
#. de: 0
#. fr: 0
msgctxt "NpcYell:11995:0:13"
msgid "0"
msgstr "Сдавайся!"

#. ja: なんともはや……これ以上は、我が肉体が……！
#. de: Der Geist ist willig, doch mein Fleisch ist wund und müde.
#. fr: Mon esprit veut persévérer, mais mon corps... ne...
msgctxt "NpcYell:11996:0:13"
msgid "Gah... The spirit is willing...but the flesh is bruised and battered..."
msgstr "Ох... дух силён, но тело... избито и измучено..."

#. ja: テンマが打ち破られただと……！？<br>ば、馬鹿な……！
#. de: Mein Tenma ist besiegt?
#. fr: Ils sont parvenus à vaincre mon tenma<nbsp>!?
msgctxt "NpcYell:11997:0:13"
msgid "The tenma has fallen!?"
msgstr "Тэнма пал!?"

#. ja: ヤマツミよ、今ならまだ間に合う。<br>祖国ドマに帰順するのだ……！
#. de: Es ist noch nicht zu spät für dich, Yamatsumi. Wir können immer noch zusammen nach Doma zurückkehren.
#. fr: Yamatsumi, il n'est pas trop tard. Rejoins-nous<nbsp>!
msgctxt "NpcYell:11998:0:13"
msgid "It is not too late for you, Yamatsumi! We can still return to Doma together! We can return home together!"
msgstr "Ямэцуми, ещё не поздно! Мы можем вместе вернуться в Дому! Домой!"

#. ja: ●おとなしくお縄につきなさい！
#. de: 0
#. fr: 0
msgctxt "NpcYell:11999:0:13"
msgid "0"
msgstr "Смирно, руки за голову!"
