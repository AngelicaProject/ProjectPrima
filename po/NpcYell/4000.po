msgstr ""
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-Game-Version: 2026.09.15.0000.0000\n"
"X-Source-Language: en\n"

#. ja: 自動魔紋描画開始…<br>魔法戦ヲ再開シマス
#. de: Auto-Magiemuster - Wiederhole Ausführung!
#. fr: Production automatique de pentacles engagée... Stratégie de combat magique initiée<nbsp>!
msgctxt "NpcYell:4000:0:13"
msgid "Initializing automated ley lines... Resuming magic combat!"
msgstr "Начинаю прокладывать магические линии... Возобновляю магический бой!"

#. ja: リミッター解除！<br>ハイパーモード！！
#. de: Begrenzer aus ... Operiere im Hypermodus!
#. fr: Déconnexion du limiteur<nbsp>! Activation de l'hyper-mode<nbsp>!
msgctxt "NpcYell:4001:0:13"
msgid "Limiter released! Commencing hyper mode!"
msgstr "Ограничитель снят! Перехожу в гиперрежим!"

#. ja: エーテルダウン…<br>再度、緊急停止シマス
#. de: Ätherschmelze! Beende sofort alle Operationen ...
#. fr: Baisse des réserves d'éther... Protocole d'arrêt d'urgence relancé...
msgctxt "NpcYell:4002:0:13"
msgid "Aether levels critical... Reinitializing emergency shutdown..."
msgstr "Критический уровень эфира... Повторная инициализация аварийного отключения..."

#. ja: 出力低下…<br>予備動力ニテ戦闘継続！
#. de: Spannungsabfall! Schalte auf Notstrom ...
#. fr: Baisse de puissance... Activation de l'ali<shy>men<shy>ta<shy>tion secondaire<nbsp>!
msgctxt "NpcYell:4003:0:13"
msgid "Energy output critical... Resuming combat on auxiliary power..."
msgstr "Критический уровень энергии... Продолжаю бой на резервном питании..."

#. ja: 予備動力停止…<br>戦闘継続…不可能…
#. de: Notstrom unzureichend ... Operation wird beendet.
#. fr: Arrêt de l'ali<shy>men<shy>ta<shy>tion secondaire... Mode de combat... interrompu...
msgctxt "NpcYell:4004:0:13"
msgid "Auxiliary power critical... Combat protocols unsustainable..."
msgstr "Резервное питание на исходе... Продолжать бой невозможно..."

#. ja: 戦術変更ノ必要アリ…<br>戦闘部隊招集！
#. de: Strategieänderung empfohlen. Sammle Truppen!
#. fr: Changement de stratégie requis... Rassemblement des unités de combat<nbsp>!
msgctxt "NpcYell:4005:0:13"
msgid "Altering combat protocol... Melee unit assemble!"
msgstr "Меняю боевой протокол... Сбор бойцов ближнего боя!"

#. ja: 戦術ヲ再変更…<br>射撃部隊招集！
#. de: Erneute Strategieänderung. Sammle Schützen!
#. fr: Changement de stratégie... Rassemblement des unités de tir<nbsp>!
msgctxt "NpcYell:4006:0:13"
msgid "Altering combat protocol... Ranged unit assemble!"
msgstr "Меняю боевой протокол... Сбор бойцов дальнего боя!"

#. ja: 後は任せた…くぽ…
#. de: Ich komme wieder ... kupo!
#. fr: Ouille, ouille<nbsp>!<nbsp>... Désolé, continuez sans moi, kuppo<nbsp>!
msgctxt "NpcYell:4007:0:13"
msgid "I'll be back, kupo..."
msgstr "Я ещё вернусь, купо..."

#. ja: ばたんきゅーくぽ
#. de: Puh, das war aber fest.
#. fr: Je... je n'ai plus de forces... kuppo...
msgctxt "NpcYell:4008:0:13"
msgid "Moogle down, kupo..."
msgstr "Мугл пал, купо..."

#. ja: イタタのタくぽ…
#. de: Aua, kupo ...
#. fr: Ça... ça fait trop mal, kuppo...
msgctxt "NpcYell:4009:0:13"
msgid "Ouch...kupo."
msgstr "Ай... купо."

#. ja: もうダメくぽ…
#. de: Ich mag nicht mehr!
#. fr: Aïe, aïe<nbsp>! Je veux rentrer au Nid-Mog, kuppo...
msgctxt "NpcYell:4010:0:13"
msgid "I'm done for, kupo..."
msgstr "Мне конец, купо..."

#. ja: お、おたすけくぽ…
#. de: Die anderen werden mich rächen, kupo ...
#. fr: Au-au secours, j'ai trop mal, kuppo...
msgctxt "NpcYell:4011:0:13"
msgid "Avenge me, kupo..."
msgstr "Отомстите за меня, купо..."

#. ja: モ、モグたちに…<br>何か怨みでもあるくぽ？
#. de: Womit haben wir das verdient, kupo?
#. fr: On est gentils, nous, kuppo<nbsp>! Pourquoi nous faire tout ce mal<nbsp>?<nbsp>...
msgctxt "NpcYell:4012:0:13"
msgid "I never asked for this, kupo..."
msgstr "Я этого не просил, купо..."

#. ja: こ、降参くぽ…
#. de: G-Gnade!
#. fr: Kuppopoooo<nbsp>!<nbsp>... Je-je me rends, kuppo<nbsp>!
msgctxt "NpcYell:4013:0:13"
msgid "M-Mercy, kupo..."
msgstr "П-пощады, купо..."

#. ja: むおおお！<br>復活くぽ！
#. de: Oho! Ich bin zurück!
#. fr: Kuppoh<nbsp>! Je sens mes forces revenir<nbsp>!
msgctxt "NpcYell:4014:0:13"
msgid "Oh! I'm back, kupo!"
msgstr "О! Я снова в строю, купо!"

#. ja: 元気いっぱいくぽ！
#. de: Weiter, weiter!
#. fr: Allez, c'est reparti, kuppo<nbsp>!
msgctxt "NpcYell:4015:0:13"
msgid "Moogle up, kupo!"
msgstr "Мугл снова в строю, купо!"

#. ja: イタいのイタいの<br>飛んでったくぽ！
#. de: Der Schmerz ist wie weggeblasen!
#. fr: Même pas mal, kuppopo<nbsp>!
msgctxt "NpcYell:4016:0:13"
msgid "The pain is gone, kupo!"
msgstr "Больше не больно, купо!"

#. ja: もう一度いくくぽ！
#. de: Und noch einmal! Jippie!
#. fr: Ah, non<nbsp>! Je vais continuer de me battre, kuppo<nbsp>!
msgctxt "NpcYell:4017:0:13"
msgid "Fresh as a daisy, kupo!"
msgstr "Как огурчик, купо!"

#. ja: リベンジくぽ！
#. de: Jetzt räche ich mich aber selbst, kupo.
#. fr: Cette fois-ci, je ne vais pas me laisser faire, kuppo<nbsp>!
msgctxt "NpcYell:4018:0:13"
msgid "I'll avenge myself, kupo!"
msgstr "Я отомщу, купо!"

#. ja: えっ、もう一度<br>戦うくぽ！？
#. de: Schon wieder? \<stöhn>
#. fr: Vous l'aurez voulu, kuppo<nbsp>! À l'attaque<nbsp>!
msgctxt "NpcYell:4019:0:13"
msgid "What!? Again, kupo!?"
msgstr "Что!? Опять драться, купо!?"

#. ja: がんばるくぽ～！
#. de: Jetzt gibt's keine Gnade mehr!
#. fr: Je plaisantais, hein<nbsp>! Pas question de me rendre, kuppo<nbsp>!
msgctxt "NpcYell:4020:0:13"
msgid "No mercy, kupo!"
msgstr "Пощады не будет, купо!"

#. ja: 通さんぞ！
#. de: Halt! Keinen Schritt weiter!
#. fr: Vous ne passerez pas<nbsp>!
msgctxt "NpcYell:4021:0:13"
msgid "Halt!"
msgstr "Стоять!"

#. ja: 作戦の邪魔はさせん！
#. de: Niemand darf unsere Mission gefährden!
#. fr: Personne ne peut mettre en péril notre mission<nbsp>!
msgctxt "NpcYell:4022:0:13"
msgid "No one interferes!"
msgstr "Не позволю вам помешать!"

#. ja: エオルゼアの蛮族め！
#. de: Nieder mit diesen Wilden!
#. fr: Mort aux barbares d'Éorzéa<nbsp>!
msgctxt "NpcYell:4023:0:13"
msgid "Eorzean scum!"
msgstr "Эорзейские отбросы!"

#. ja: 妨害を排除して<br>先に進みましょう！
#. de: Beseitigen wir sie, und dann rasch weiter!
#. fr: Débarrassons-nous de ces gêneurs<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4024:0:13"
msgid "Clear a path!<br>Cut through them!"
msgstr "Расчистим дорогу!<br>Пробьёмся сквозь них!"

#. ja: 敵将はこの先ね<br>先を急ぎましょう
#. de: Der Anführer ist dort entlang. Schnell!
#. fr: Leur chef ne peut pas être bien loin. Dépêchons-nous de le rattraper<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4025:0:13"
msgid "The legatus cannot be far,<br>but we must be swift."
msgstr "Легат не может быть далеко.<br>Но нам надо спешить."

#. ja: 足止めは<br>おまかせしました！
#. de: Halt sie einstweilen in Schach!
#. fr: Soyez prudent, Urianger<nbsp>!
msgctxt "NpcYell:4026:0:13"
msgid "Our thanks, Urianger!"
msgstr "Благодарю, Урианже!"

#. ja: 死守だ！<br>ここは死守しろ！
#. de: Haltet die Stellung! Sie dürfen nicht durchkommen!
#. fr: Nous ne céderons pas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4027:0:13"
msgid "Stop them!<br>No one gets through!"
msgstr "Остановить их!<br>Никого не пропускать!"

#. ja: 第VI軍団の<br>誇りを見せよ！
#. de: Ehre der VI. Legion!
#. fr: Pour la 6e légion impériale<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4028:0:13"
msgid "We are VIth Legion!<br>Show them what that means!"
msgstr "Мы — VI-й легион!<br>Покажите им, на что мы способны!"

#. ja: 閣下の邪魔は許さん！
#. de: Ehre Seiner Exzellenz, dem Kaiser!
#. fr: Garlemald vaincra<nbsp>!
msgctxt "NpcYell:4029:0:13"
msgid "The emperor will not be denied!"
msgstr "Императору не помешать!"

#. ja: すみやかに撃滅を！
#. de: Keiner darf entkommen! Wir müssen alle vernichten ...
#. fr: Maudits Impériaux<nbsp>! Vous allez tous mourir<nbsp>!
msgctxt "NpcYell:4030:0:13"
msgid "We've no time for this!"
msgstr "У нас нет на это времени!"

#. ja: この敵は厄介よ…
#. de: Oje, der hier ist hartnäckig ...
#. fr: Un colosse... Il ne manquait plus que ça<nbsp>!
msgctxt "NpcYell:4031:0:13"
msgid "This one looks a handful..."
msgstr "С этим противником будет непросто..."

#. ja: フォルガル様…<br>馳せ参じましてよ！
#. de: Forgall ... Ich eile zu Hilfe!
#. fr: À votre service, Seigneur Forgall<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4032:0:13"
msgid "Lord Forgall!<br>Your will is my command!"
msgstr "Лорд Форгалл!<br>Ваше желание для меня закон!"

#. ja: アァ…依り代が…<br>崩れてゆく…！
#. de: Mein Körper ... Meine Hülle ... zerfällt!
#. fr: Aaarrgghhh... Ce corps... se morcèle...
msgctxt "NpcYell:4033:0:13"
msgid "Curse this frail vessel..."
msgstr "Проклятое хрупкое тело..."

#. ja: ゴアアァァァ！
#. de: Gruaaahhrr!
#. fr: Grrrraaaarrrh<nbsp>!
msgctxt "NpcYell:4034:0:13"
msgid "Graaaaaah!"
msgstr "Граааааа!"

#. ja: フシュウゥゥゥゥ…
#. de: Pssh ...
#. fr: Psshhhooôôôh...
msgctxt "NpcYell:4035:0:13"
msgid "Grrr..."
msgstr "Гр-р-р..."

#. ja: グルルルルル！<br>魂ヲ、ヨコセ！
#. de: Groooohhrr ... Gib ... deine ... Seele ...
#. fr: Grrrrmmm<nbsp>! Donnez-moi vos âmes<nbsp>!
msgctxt "NpcYell:4036:0:13"
msgid "Surrender your souls..."
msgstr "Отдайте мне ваши души..."

#. ja: ゴハッ…<br>コンナ、トコロデ…
#. de: Urgh ...
#. fr: Gouaargh<nbsp>!<nbsp>... Pas ici...
msgctxt "NpcYell:4037:0:13"
msgid "I...still...hunger..."
msgstr "Я... всё ещё... голоден..."

#. ja: ウガガガガ…
#. de: Muuuaahrggh!
#. fr: Mouôôôôôh...
msgctxt "NpcYell:4038:0:13"
msgid "\\<gurgle> ..."
msgstr "<i>Буль-буль...</i>"

#. ja: グホッ…
#. de: Uhh ...
#. fr: Grrrrôôôrgh...
msgctxt "NpcYell:4039:0:13"
msgid "\\<splutter> ..."
msgstr "<i>Кх...</i>"

#. ja: 俺…なんで…<br>ラドリア姐さん…
#. de: Wie ... <br>Radlia ...
#. fr: Capitaine Radlia... Pourquoi<nbsp>?<nbsp>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4040:0:13"
msgid "Wait, you don't want me!<br>Surely the captain..."
msgstr "Постой, я тебе не нужен!<br>Вот капитан — другое дело..."

#. ja: オオォォォ…<br>ナンデ、生キテルンダ！？
#. de: Oooohhh ... Ich lebe!?
#. fr: Oooouuuh... Je... suis... vivante<nbsp>?<nbsp>...
msgctxt "NpcYell:4041:0:13"
msgid "\\<groan> I...live?"
msgstr "<i>О-ох...</i> Я... живу?"

#. ja: マタ死ヌ…ノカ…
#. de: Mein Leben ... ist immer so kurz ...
#. fr: Les ténèbres... m'enveloppent... à nouveau...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4042:0:13"
msgid "And so...I die...<br>Again."
msgstr "И вот... я умираю...<br>Снова."

#. ja: 死ニタクナイ！<br>死ニタクナイィィィ！
#. de: Nein! Ich will nicht! Nicht sterben!!!
#. fr: Noooon<nbsp>! Je ne... je ne veux pas... mourir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4043:0:13"
msgid "Please!<br>I don't want to die!"
msgstr "Прошу!<br>Я не хочу умирать!"

#. ja: あがががが…<br>殺す、殺すぅぅ！
#. de: Uahrg ... Nun nehme ich <i>dein</i> Leben!
#. fr: Rrraaaaah... Tuer<nbsp>! Tuuuueeeer<nbsp>!
msgctxt "NpcYell:4044:0:13"
msgid "\\<hack> ...Kill. Kill!"
msgstr "<i>Кх...</i> Убить. Убить!"

#. ja: なんてこった…
#. de: Nein ... nicht doch!
#. fr: Qu'est-ce qui m'arrive<nbsp>?<nbsp>...
msgctxt "NpcYell:4045:0:13"
msgid "Cold..."
msgstr "Холодно..."

#. ja: や、やめとくれよぉぉ…
#. de: Wie geschieht mir?!
#. fr: Nooon<nbsp>! Arrêtez... Je...
msgctxt "NpcYell:4046:0:13"
msgid "N-No! Nooo!"
msgstr "Н-нет! Не-е-ет!"

#. ja: 暗い…<br>暗いよ…
#. de: Es ist so dunkel ...
#. fr: Il fait si... sombre... et si froid...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4047:0:13"
msgid "Dark...<br>So dark..."
msgstr "Темно...<br>Так темно..."

#. ja: はやく…<br>眠らせとくれ…
#. de: Lass mich ... endlich Ruhe finden ...
#. fr: Laissez-moi... reposer... en paix...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4048:0:13"
msgid "Aye...<br>Let me rest..."
msgstr "Да...<br>Дай мне покой..."

#. ja: ああ、闇が…<br>近づいて…
#. de: Komm, Dunkel! Umhülle mich!
#. fr: J-je sens... les ténèbres... déchirer... mon âme...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4049:0:13"
msgid "The darkness...<br>It's coming..."
msgstr "Тьма...<br>Она приближается..."

#. ja: さあ、奥を目指すぞ！
#. de: Wir müssen weiter ins Innere!
#. fr: Continuez comme ça<nbsp>!
msgctxt "NpcYell:4050:0:13"
msgid "Onwards! Upwards!"
msgstr "Вперёд! Выше!"

#. ja: 気を抜くな！
#. de: Nicht nachlassen!
#. fr: Restez bien sur vos gardes<nbsp>!
msgctxt "NpcYell:4051:0:13"
msgid "Eyes open! Stay alert!"
msgstr "Не теряйте бдительности! Будьте начеку!"

#. ja: 流れが速いな…
#. de: Ziemlich starke Strömung ...
#. fr: Le courant est vraiment très rapide...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4052:0:13"
msgid "That flow is<br>terribly swift..."
msgstr "Уж больно быстро<br>течёт вода..."

#. ja: 消え去れい！！
#. de: Nun werdet ihr ausgelöscht!
#. fr: Disparaissez<nbsp>!!
msgctxt "NpcYell:4053:0:13"
msgid "Time for a trim!"
msgstr "Пора подровнять!"

#. ja: 巨大な炎獣迫るとき、みなの希望を守るため、<br>戦士の炎、心に宿し、炎も怖れず立ち向かう！
#. de: Die Leute zählen auf uns. Wir müssen sie um jeden Preis beschützen!
#. fr: Ne craignez rien, les bombattants arrivent à la rescousse<nbsp>! Nous allons apprendre à ce méchant ce que c'est que l'amour de la vie et le respect du bonheur<nbsp>!
msgctxt "NpcYell:4054:0:13"
msgid "The people are counting on us. We must protect them at all costs!"
msgstr "Люди рассчитывают на нас. Мы должны защитить их любой ценой!"

#. ja: 我ら、消防戦隊<br>「火消しの戦士」出動！！
#. de: Keine Angst, die Bombattanten sind hier!
#. fr: Bombattants, en avant<nbsp>!
msgctxt "NpcYell:4055:0:13"
msgid "Fear not, the Go Go Posing Rangers are here!"
msgstr "Не бойтесь, мы — Рейнджеры Го-Го Посинг!"

#. ja: キングボンバードは<br>我らが引き受ける！
#. de: Überlasst den Knallomat-König uns!
#. fr: Ne vous occupez pas du roi bombardo.<br>Laissez-le-nous<nbsp>!
msgctxt "NpcYell:4056:0:13"
msgid "Leave the Bombard King to us!"
msgstr "Оставьте короля бомбардо нам!"

#. ja: 我らの必殺技で<br>海の平和を守る！
#. de: Dein Ende ist nahe, Unhold! Diese Küste gehört uns!
#. fr: Il ne survivra pas à notre botte secrète.
msgctxt "NpcYell:4057:0:13"
msgid "Your demise is nigh, fiend! We'll reclaim these oceans, and see that you inflict no further harm!"
msgstr "Тебе не уйти, чудовище! Мы вернём себе эти моря и не позволим тебе никому навредить!"

#. ja: 君たちは<br>ザコどもの相手を頼む！
#. de: Kümmert euch um die Mini-Knallomaten!
#. fr: Éliminez les mini-bombardos<nbsp>!
msgctxt "NpcYell:4058:0:13"
msgid "Adventurers, take care of the minions!"
msgstr "Авантюристы, разберитесь с прихвостнями!"

#. ja: ウォーリアダイナミック！
#. de: Bombattanten-Dynamik!
#. fr: Bomboforce dynamique<nbsp>!
msgctxt "NpcYell:4059:0:13"
msgid "Go! Go! Triple Majestic Slash Attack!"
msgstr "Вперёд! Вперёд! Тройной сокрушительный рубящий удар!"

#. ja: ウォーリアスペシャル ！
#. de: Bombattanten-Spezial!
#. fr: Bomboforce spéciale<nbsp>!
msgctxt "NpcYell:4060:0:13"
msgid "Go! Go! Raging Flame Reverse-blow Punch!"
msgstr "Вперёд! Вперёд! Пылающий обратный удар кулаком!"

#. ja: ウォーリアバイオレンス！
#. de: Bombattanten-Brecher!
#. fr: Bomboforce violente<nbsp>!
msgctxt "NpcYell:4061:0:13"
msgid "Go! Go! Flash Flare Pummel!"
msgstr "Вперёд! Вперёд! Вспышка, вспышка, тумак!"

#. ja: 気は満ちた！
#. de: Der König muss sterben!
#. fr: Vous êtes prêts<nbsp>?
msgctxt "NpcYell:4062:0:13"
msgid "The king must die!"
msgstr "Король должен умереть!"

#. ja: ハイパーバックドラフト！<br>ファーイト　ファイヤー！！
#. de: Bombattanten, Kampfformation einnehmen!
#. fr: Il va comprendre ce que c'est qu'un retour de flamme...<br>Extinction des feux pour le roi<nbsp>!
msgctxt "NpcYell:4063:0:13"
msgid "Rangers, Firefall Battle Formation!"
msgstr "Рейнджеры, боевой строй «Огненный водопад»!"

#. ja: 鎮火完了！！<br>我ら、消防戦隊「火消しの戦士」撤収！
#. de: Gut gemacht, Bombattanten! Unsere Mission ist erledigt!
#. fr: Et voilà<nbsp>!<br>Encore une victoire des bombattants<nbsp>!
msgctxt "NpcYell:4064:0:13"
msgid "Well done, Rangers! Our job here is finished!"
msgstr "Отличная работа, рейнджеры! Здесь нам больше нечего делать!"

#. ja: 黒渦は、<br>すべてを呑み込む！
#. de: Jetzt wirst du die Bedeutung von „Mahlstrom“ am eigenen Leib erfahren!
#. fr: Tout ce qui passe près d'un maelstrom est inexorablement englouti<nbsp>!
msgctxt "NpcYell:4065:0:13"
msgid "Till sea swallows all!"
msgstr "Пока море не поглотит всё!"

#. ja: 避けねば<br>大怪我では済まんぞ？
#. de: Wenn du nicht ausweichst, wirst du aber nicht lange auf den Beinen bleiben!
#. fr: Si j'étais vous, je m'éloignerais autant que possible<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:4066:0:13"
msgid "Don't disappoint me now, <split \" \" 1><string $gs1></split>."
msgstr "Не разочаруй меня, <split \" \" 1><string $gs1></split>."

#. ja: でりゃあああああ！
#. de: Jaaaahhrg!
#. fr: Yaaaargh<nbsp>!
msgctxt "NpcYell:4067:0:13"
msgid "Graaaaaahhh!"
msgstr "Граааааа!"

#. ja: 足下がガラ空きだ！
#. de: Pass auf, wo du hintrittst, hehehe!
#. fr: Attention à vos pieds<nbsp>! Hé hé hé<nbsp>!
msgctxt "NpcYell:4068:0:13"
msgid "Watch your step, now!"
msgstr "Смотри под ноги!"

#. ja: 多勢に無勢なのだ<br>卑怯とは言わせんぞ？
#. de: Einer gegen alle - wie im wahren Leben! Geht aber für die Minderzahl selten gut aus!
#. fr: Rien ne vaut l'avantage du nombre pour remporter la victoire<nbsp>! Hé hé hé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4069:0:13"
msgid "Outnumbered?<br>I'd say this is...fair."
msgstr "Нас больше?<br>Ну, так даже честнее."

#. ja: これが海賊王の荒技よ！
#. de: Nun bekommst du es mit Rycharde Rauschebart zu tun ...
#. fr: Voyez la puissance du légendaire Barbe-Brume<nbsp>!
msgctxt "NpcYell:4070:0:13"
msgid "The legend never dies!"
msgstr "Легенды не умирают!"

#. ja: 大砲用の火薬樽だ…<br>扱いには気を付けな！
#. de: Pass nur auf, das Pulver da ist ein wahrer Knaller!
#. fr: Attention<nbsp>!<nbsp>...  C'est de la poudre à canon<nbsp>! Hé hé hé<nbsp>!
msgctxt "NpcYell:4071:0:13"
msgid "Careful, those're filled with cannon powder!"
msgstr "Осторожней, в бочках порох для пушек!"

#. ja: これ以上は危険…！<br>一時撤退だ！
#. de: Er ist \<keuch> zu stark! \<keuch> Bombattanten, wir ziehen uns zurück!
#. fr: On n'y arrivera pas<nbsp>!<br>Il faut battre en retraite.
msgctxt "NpcYell:4072:0:13"
msgid "He's...\\<pant>...too strong! \\<pant> Rangers, we must retreat! "
msgstr "Он... <i>Кх...</i> слишком силён! <i>Кх</i> Рейнджеры, отступаем!"

#. ja: まだ戦えるか！？<br>みんな、頑張ってくれ！
#. de: Durchhalten, Bombattanten! Gegen unsere gemeinsame Stärke hat er keine Chance!
#. fr: Ne jetez pas l'éponge, ils n'ont pas encore gagné.<br>Courage<nbsp>!
msgctxt "NpcYell:4073:0:13"
msgid "Stand firm, Rangers! Against our combined strength, he has no chance!"
msgstr "Держитесь, рейнджеры! Вместе нам он не страшен!"

#. ja: 気が満ちつつある<br>あと少し踏ん張ってくれ！
#. de: Wir haben ihn genau da, wo wir ihn haben wollen!
#. fr: Nous sommes à deux doigts de déclencher notre botte secrète. Tenez bon<nbsp>!
msgctxt "NpcYell:4074:0:13"
msgid "We have him right where we want him!"
msgstr "Он у нас в руках!"

#. ja: シュコォ、シュコォ…<br>盗掘、捜索、楽しいナ！
#. de: Psh ... Schatzsammeln bringt Freude in Herz!
#. fr: Pshhhohoho<nbsp>!<nbsp>... Le Gobelin malin aime s'accaparer les trésors des autres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4075:0:13"
msgid "Shkoh! Shkoh! Sneaky-taken<br>jinglyshine, where are yooou?"
msgstr "Шкох! Шкох! Где же блестяшки,<br>что гоблин хитро утащил?"

#. ja: シュコォ、シュコォ…<br>お宝、全部、ゴブのモノ！
#. de: Nimmzu ja Langefinger von Gobbischatz!
#. fr: Pshhh... Tous les trésors et objets précieux appartiennent au Gobelin futé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4076:0:13"
msgid "Jinglyshine, jinglyshine,♪<br>What is yours will soon be mine...♪"
msgstr "Блестяшки, блестяшки,♪<br>Скоро всё будет моим...♪"

#. ja: シュコォ、シュコォ…<br>ところで、道はどっちかナ？
#. de: ... Du, weizzu vielleicht richtige Weg?
#. fr: Pshhhmm<nbsp>?<nbsp>... Le grand chasseur de trésors gobelin se demande bien où il faut aller...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4077:0:13"
msgid "Which way? Which way?<br>Braincase throbs with indecision..."
msgstr "Куда идти? Куда идти?<br>В черепушке от сомнений стучит..."

#. ja: シュコォ、シュコォ…<br>同業者には、負けられヌ！
#. de: Psh, so leicht wird Gobbi nicht schlagengeben!
#. fr: Pshhhéhéhé... Le Gobelin finaud n'a pas l'intention de partager les trésors<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4078:0:13"
msgid "No busydeals for greedy uplander!<br>Jinglyshine is for feeding little gobbies!"
msgstr "Жадному горцу не видать добычи!<br>Блестяшки — малым гоблинам!"

#. ja: シュコォ、シュコォ…<br>そろそろ脱出、サヨウナラ！
#. de: Zeit für Rückspringen! Hazzu noch viel Spaß, Großwachsene<if $gn4><else>r</if>!
#. fr: Pshhh... Il est temps pour le sage Gobelin de tirer sa révérence<nbsp>! Adieu<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4079:0:13"
msgid "No jinglyshine is eyecatched...<br>How to buy cheese for gobbieflock...?"
msgstr "Блестяшек не нашёл...<br>Как же теперь купить сыр для гоблинят...?"

#. ja: シュコォ、シュコォ…<br>なんだ、お前ら、やる気かナ？
#. de: Willzu streitkämpfen, kho?
#. fr: Pshhhmm... Le Gobelin sent de l'agressivité et de la convoitise envers lui<nbsp>!<nbsp>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4080:0:13"
msgid "Shkohhh! Uplander having<br>lustyeyes for jinglyshine!?"
msgstr "Шкох! Горцы на<br>блестяшки заглядываются!?"

#. ja: やれるもんなら<br>やってみナ！
#. de: Psh, jetzt kriegzzu Huckevoll!
#. fr: Mais il est prêt à défendre farouchement ses trésors<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4081:0:13"
msgid "If uplander come at gobbie,<br>uplander best bring whole flock!"
msgstr "Гоблина тронешь —<br>вся стая на тебя навалится!"

#. ja: こっちだ、あっちだ<br>スタコラ、サッサ！
#. de: So macht echt keine Spaß, kho!
#. fr: Pshhhraaah<nbsp>! Le Gobelin ne se laissera pas vaincre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4082:0:13"
msgid "Shkoh! Shkoh! More jinglyshine<br>for starving little gobbies!"
msgstr "Шкох! Шкох! Блестяшек побольше<br>голодным гоблиняткам!"

#. ja: シュコォ、シュコォ…<br>残念、無念、サヨウナラ…
#. de: Psh ... Gobbi kann ... nicht mehr.
#. fr: Pshhhouuargh... Le courageux Gobelin a perdu...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4083:0:13"
msgid "Tell...tell my wife I...<br>Pshhh...kooohhh..."
msgstr "Скажите... жене, что я...<br>Шкох... кххх..."

#. ja: シュコォ、シュコォ…<br>まいった、まいった降参ネ！
#. de: Warum wirzzu gleich ... so böse?! Kho ...
#. fr: Pshhhcreugneugneu<nbsp>!<nbsp>... Le Gobelin intelligent sait quand il vaut mieux s'enfuir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4084:0:13"
msgid "Psheew... Mercy, mercy!<br>Backwalk to wife and little gobbies!"
msgstr "Шкох... Пощады, пощады!<br>Пойду домой к жене и гоблиняткам!"

#. ja: <if ($n2 == 0)><sheet BNpcName $n1 0>が現れた！<else><sheet BNpcName $n1 0>たちが現れた！</if>
#. de: <capitalize><noun-de BNpcName 1 $n1 1 1 1></capitalize> ist erschienen!
#. fr: <capitalize><noun-fr BNpcName 1 $n1 1 1></capitalize> <if ($n1 == 7626)>sont apparu<if "<sheet BNpcName $n1 6>">e</if>s<else><if ($n1 == 8792)>sont apparu<if "<sheet BNpcName $n1 6>">e</if>s<else><if ($n1 == 13283)>sont apparu<if "<sheet BNpcName $n1 6>">e</if>s<else><if ($n1 == 14021)>sont apparu<if "<sheet BNpcName $n1 6>">e</if>s<else>est apparu<if "<sheet BNpcName $n1 6>">e</if></if></if></if></if><nbsp>!
#. macro: <if ($n2 == 0)><capitalize><noun-en BNpcName 1 $n1 1 1></capitalize> appears!<else><capitalize><noun-en BNpcName 3 $n1 2 1></capitalize> appear!</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 2 == 0 (condition: may be reworded, restructured, added, or dropped)
#. macro: <capitalize><noun-en BNpcName 1 $n1 1 1></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <noun-en BNpcName 1 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = BNpcName, form = 1, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
#. macro: <capitalize><noun-en BNpcName 3 $n1 2 1></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <noun-en BNpcName 3 $n1 2 1> — an English noun from a game data sheet, with article and number; sheet = BNpcName, form = 3, row = number parameter 1, count = 2, case = 1 (game data: keep it; it may move or repeat)
msgctxt "NpcYell:4085:0:13"
msgid "<if ($n2 == 0)><capitalize><noun-en BNpcName 1 $n1 1 1></capitalize> appears!<else><capitalize><noun-en BNpcName 3 $n1 2 1></capitalize> appear!</if>"
msgstr "<if ($n2 == 0)><capitalize><noun-en BNpcName 1 $n1 1 1></capitalize> появляется!<else><capitalize><noun-en BNpcName 3 $n1 2 1></capitalize> появляются!</if>"

#. ja: <sheet BNpcName $n1 0>は、どこかに去ったようだ……
#. de: <capitalize><noun-de BNpcName 2 $n1 1 1 1></capitalize> ist irgendwohin verschwunden.
#. fr: <capitalize><noun-fr BNpcName 2 $n1 1 1></capitalize> a disparu...
#. macro: <capitalize><noun-en BNpcName 2 $n1 1 1></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <noun-en BNpcName 2 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = BNpcName, form = 2, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "NpcYell:4086:0:13"
msgid "<capitalize><noun-en BNpcName 2 $n1 1 1></capitalize> withdraws..."
msgstr "<capitalize><noun-en BNpcName 2 $n1 1 1></capitalize> отступает..."

#. ja: <sheet BNpcName $n1 0>が倒され、<sheet Treasure $n2 0>が出現した！
#. de: <capitalize><noun-de BNpcName 2 $n1 1 1 1></capitalize> ist besiegt und <noun-de Treasure 1 $n2 1 1 1> ist erschienen!
#. fr: <capitalize><noun-fr BNpcName 2 $n1 1 1></capitalize> a laissé un <sheet Treasure $n2 0><nbsp>!
#. macro: <sheet Treasure $n2 0> — a value from a game data sheet, such as a name; sheet = Treasure, row = number parameter 2, column = 0 (game data: keep it; it may move or repeat)
#. macro: <noun-en BNpcName 2 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = BNpcName, form = 2, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "NpcYell:4087:0:13"
msgid "A <sheet Treasure $n2 0> is discovered upon defeating <noun-en BNpcName 2 $n1 1 1>!"
msgstr "После победы над <noun-en BNpcName 2 $n1 1 1> найдено сокровище: <sheet Treasure $n2 0>!"

#. ja: <sheet BNpcName $n1 0>が逃げ出した！
#. de: <if ($n2 == 0)><capitalize><noun-de BNpcName 2 $n1 1 1 1></capitalize> ist geflohen!<else><capitalize><noun-de BNpcName 2 $n1 2 1 1></capitalize> sind geflohen!</if>
#. fr: <capitalize><noun-fr BNpcName 2 $n1 1 1></capitalize> s'est enfui<if "<sheet BNpcName $n1 6>">e</if><nbsp>!
#. macro: <capitalize><noun-en BNpcName 2 $n1 1 1></capitalize> — the content with its first letter in upper case (may be added or dropped)
#. macro: <noun-en BNpcName 2 $n1 1 1> — an English noun from a game data sheet, with article and number; sheet = BNpcName, form = 2, row = number parameter 1, count = 1, case = 1 (game data: keep it; it may move or repeat)
msgctxt "NpcYell:4088:0:13"
msgid "<capitalize><noun-en BNpcName 2 $n1 1 1></capitalize> escapes!"
msgstr "<capitalize><noun-en BNpcName 2 $n1 1 1></capitalize> сбегает!"

#. ja: 私に真の勇気があれば…
#. de: Wenn ich nur nicht so viel auf meinen Mut gegeben hätte ...
#. fr: Je dois trouver le courage au fond de mon être...
msgctxt "NpcYell:4096:0:13"
msgid "Impossible! M-My courage is...absolute..."
msgstr "Невозможно! М-моё мужество... непоколебимо..."

#. ja: エオルゼアに名を残す<br>だから俺たちは…
#. de: Wir hatten uns vorgenommen, große Heldentaten zu vollbringen, über die die Barden in ganz Eorzea singen ...
#. fr: Nous voulons devenir célèbres dans tout Éorzéa<nbsp>! C'est pour ça que nous allons au devant du danger...
msgctxt "NpcYell:4097:0:13"
msgid "We said we'd...make a name for ourselves..."
msgstr "Мы говорили, что прославимся..."

#. ja: あれ…<br>なんで私、こんなところに？
#. de: W-Was mache ich hier?
#. fr: Mais... qu'est-ce que je fais ici<nbsp>?<nbsp>...
msgctxt "NpcYell:4098:0:13"
msgid "Wh-What is this place? Where are the others?"
msgstr "Ч-Что это за место? Где остальные?"

#. ja: ベアー…ベアー…<br>アタイ、アンタの事が…
#. de: Warum nur, Trauernder Bär ... Warum?
#. fr: Dolorous... Dolorous... Je-je t'aime...
msgctxt "NpcYell:4099:0:13"
msgid "Oh, Dolorous. Even in death...I will always..."
msgstr "О, Скорбящий Медведь. Даже после смерти... я всегда буду..."

#. ja: チョコボの卵を故郷に…<br>そうすれば…
#. de: Ich muss das Chocobo-Ei in mein Heimatdorf bringen ... Wenn wir nur eines hätten ... und es das richtige ist ...!
#. fr: Je dois ramener l'œuf dans ma patrie... C'est le seul moyen...
msgctxt "NpcYell:4100:0:13"
msgid "I must have that chocobo egg... It's the only way..."
msgstr "Мне нужно это яйцо чокобо... Это единственный выход..."

#. ja: 俺がゾンビーに…<br>まさか…あの秘薬を…？
#. de: Ich? Ein Zombie? War es etwa dieser Trank ...?
#. fr: Je suis... devenu un zombi<nbsp>!?<nbsp>... Mais alors, cette potion...
msgctxt "NpcYell:4101:0:13"
msgid "I am undying...? Was it the elixir?"
msgstr "Я бессмертен...? Неужели это из-за эликсира?"

#. ja: 海が…呼んでいる…<br>母ちゃん…俺は…
#. de: Das Meer ruft mich ... Die Wogen rufen nach mir ...
#. fr: La mer m'appelle... Mère, je dois y aller...
msgctxt "NpcYell:4102:0:13"
msgid "You hear that, lads? The sea's callin' me home..."
msgstr "Слышите, парни? Море зовёт меня домой..."

#. ja: クロビソア、メナル…<br>俺の部隊は…どこに…
#. de: Clovissoir! D'mhenall! Wo seid ihr?
#. fr: Clovissoix<nbsp>!<nbsp>... D'mhenall<nbsp>!<nbsp>... Où sont mes hommes<nbsp>!?<nbsp>...
msgctxt "NpcYell:4103:0:13"
msgid "Where are my men...?  Clovissoix, Dhavha!"
msgstr "Где мои люди...? Кловиссуэ, Дхава!"

#. ja: 私ひとりで充分です！
#. de: Lauf weiter! Ich brauche keine Hilfe!
#. fr: Je peux m'en charger seul<nbsp>! Partez devant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4104:0:13"
msgid "Hie thee onwards!<br>I need no assistance!"
msgstr "Ступайте!<br>Мне помощь не нужна!"

#. ja: 敵が来たら<br>僕が応戦します！
#. de: Wenn noch mehr kommen, halte ich sie auf!
#. fr: S'il en vient d'autres, je m'en occuperai<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4105:0:13"
msgid "If more come,<br>I will handle them!"
msgstr "Если придут ещё,<br>я с ними разберусь!"

#. ja: 我が前より失せろ！
#. de: Aus dem Weg!
#. fr: Hors de ma vue<nbsp>!
msgctxt "NpcYell:4106:0:13"
msgid "Out of my way!"
msgstr "Прочь с дороги!"

#. ja: 追手が来たか…<br>先に行かせてもらう
#. de: Wir haben Ge<shy>sell<shy>schaft ... Haltet sie auf!
#. fr: Nous avons de la compagnie... Retenez-les<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4107:0:13"
msgid "We have company...<br>Stall them!"
msgstr "У нас гости...<br>Задержите их!"

#. ja: そこを退けッ！
#. de: Weg da!
#. fr: Sales vermines<nbsp>!
msgctxt "NpcYell:4108:0:13"
msgid "Move, I say!"
msgstr "Прочь с дороги, я сказал!"

#. ja: アラグの秘術は<br>この奥だな…！
#. de: Das unfassbare Wissen der Allager ist fast in meiner Hand!
#. fr: Les secrets des Allagois seront bientôt à moi<nbsp>! Ha ha ha<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4109:0:13"
msgid "This must be it...<br>Their secrets will be mine!"
msgstr "Вот оно...<br>Их тайны будут моими!"

#. ja: あわわ、見つかっちまった！
#. de: Ah, wie habt ihr mich nur entdeckt?!
#. fr: Hein !? Quoi !? On peut plus roupiller tranquille maintenant !
msgctxt "NpcYell:4110:0:13"
msgid "Bah, my transformation was flawless!"
msgstr "Да что ж... Моё превращение было безупречным!"

#. ja: （仮）ハロウィン2016_仮NPCYELL_02
#. de: 0
#. fr: 0
msgctxt "NpcYell:4111:0:13"
msgid "0"
msgstr "0"

#. ja: こっちにも<br>侵入者だとッォ！？
#. de: Kha! Wer kommt?!
#. fr: Croac<nbsp>! D'autres intrus<nbsp>!
msgctxt "NpcYell:4112:0:13"
msgid "Here too, featherless ones!?"
msgstr "И здесь тоже безпёрые?!"

#. ja: やっちまえッェ！
#. de: Bist du jetzt gleich dran!
#. fr: Écrasez-les<nbsp>!
msgctxt "NpcYell:4113:0:13"
msgid "Squaaaaaak!"
msgstr "Сква-а-а-а-ак!"

#. ja: 羽根ナシがッァ！
#. de: Kha! Federlose!
#. fr: Maudits sans-plumes<nbsp>!
msgctxt "NpcYell:4114:0:13"
msgid "Death to the featherless!"
msgstr "Смерть безпёрым!"

#. ja: 儀式を妨害させるかッァ！
#. de: Großes Fest stören, kha?! Nummerierst du gleich deine Knochen!
#. fr: Ceux-ci ne laisseront pas ceux-là gâcher la cérémonie<nbsp>!
msgctxt "NpcYell:4115:0:13"
msgid "To stop the ceremony, they come!"
msgstr "Не дадим им сорвать церемонию!"

#. ja: ガルーダ様のためにッィ！
#. de: Ehre für Garuda!
#. fr: Gloire à maîtresse Garuda<nbsp>!
msgctxt "NpcYell:4116:0:13"
msgid "O Lady Garuda, to me grant strength! "
msgstr "О Ярость, владычица Гаруда, даруй мне силу!"

#. ja: 行かせるかよッォ！
#. de: Für dich geht hier aber nicht weiter, kha!
#. fr: Hors de la vue de celui-ci<nbsp>!
msgctxt "NpcYell:4117:0:13"
msgid "No further, you will go!"
msgstr "Дальше не пройдёшь!"

#. ja: なんだッァー！？<br>羽根ナシだとッォ！
#. de: Khaa! Wind wird euch wegblasen!
#. fr: Crrroooaaac<nbsp>!? Des sans-plumes<nbsp>?
msgctxt "NpcYell:4118:0:13"
msgid "Squaaaaaak! Featherless! Featherless!"
msgstr "Сква-а-а-а-ак! Безпёрые! Безпёрые!"

#. ja: 儀式の準備がまだ…<br>通すものかッァ！
#. de: Feier vom Wind ist noch nicht bereit! Verschwindet!
#. fr: Ceux-là ne doivent pas passer<nbsp>! La cérémonie n'est pas encore prête<nbsp>!
msgctxt "NpcYell:4119:0:13"
msgid "Your grave, this spot marks!"
msgstr "Здесь будет ваша могила!"

#. ja: 嵐の力をここにッィィィ！
#. de: Wind wird euch wegblasen!
#. fr: Par le pouvoir des tempêtes<nbsp>!
msgctxt "NpcYell:4120:0:13"
msgid "Fury of the vortex, behold!"
msgstr "Узрите ярость вихря!"

#. ja: 我が軍鳥どもッォー！<br>来たれやッァー！
#. de: Kämpft, Brüder!
#. fr: Camarades ailés, celui-ci vous appelle à ses côtés<nbsp>!
msgctxt "NpcYell:4121:0:13"
msgid "For the eyes, go! For the eyes! Squaaak!"
msgstr "За глаза! В атаку на глаза! Сква-ак!"

#. ja: カチ込みかけるたッァ！<br>いい度胸だなコラッァ！
#. de: Traut ihr euch aber schon was, hier reinkommen! Kha!
#. fr: Ceux-là sont peut-être nombreux, mais ils ne vaincront pas ceux-ci<nbsp>!
msgctxt "NpcYell:4122:0:13"
msgid "Fly from this sacred place, featherless ones will!"
msgstr "Безпёрые, убирайтесь из священного места!"

#. ja: 見やがれ、ブッ飛ぶぜッァ！
#. de: Lernt ihr jetzt fliegen, kha!
#. fr: Que ceux-là se préparent à être anéantis<nbsp>!
msgctxt "NpcYell:4123:0:13"
msgid "From on high, we rain down death!"
msgstr "С высоты мы обрушим на вас смерть!"

#. ja: クソッタレッェ！
#. de: Stirbst du jetzt gleich!
#. fr: Crrrroooooaaaaaac<nbsp>!!!
msgctxt "NpcYell:4124:0:13"
msgid "Squaaaaaak!"
msgstr "Сква-а-а-а-ак!"

#. ja: もう…飛べ…<br>ないの…かッ…
#. de: Kh-Kha ...
#. fr: Celui-ci... ne pourra plus jamais... voler dans les cieux...
msgctxt "NpcYell:4125:0:13"
msgid "Fly free, we will..."
msgstr "Свободно летать...<br>уже не сможем..."

#. ja: ぺっぺっ…
#. de: \<spuck> Ugh...
#. fr: Peuh<nbsp>! Peuh<nbsp>!<nbsp>...
msgctxt "NpcYell:4126:0:13"
msgid "\\<splutter> Ugh..."
msgstr "<i>Тьфу-тьфу...</i> Фу..."

#. ja: 目的地は近い！
#. de: Es ist nicht mehr weit!
#. fr: Nous approchons du but<nbsp>!
msgctxt "NpcYell:4127:0:13"
msgid "Not far now!"
msgstr "Уже недалеко!"

#. ja: なつかしい光景だ…
#. de: Ah, wie lange ist es her ...
#. fr: Revoir ces lieux me rappelle tant de vieux souvenirs...
msgctxt "NpcYell:4128:0:13"
msgid "It has been so long..."
msgstr "Давно я здесь не бывал..."

#. ja: 大怪球を<br>退けるのだ！
#. de: Wir müssen die Sphäre zerstören!
#. fr: Évitez la grande sphère<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4129:0:13"
msgid "The sphere must<br>be destroyed!"
msgstr "Сферу нужно<br>уничтожить!"

#. ja: 戦士たちよ、ゆくぞ！
#. de: Weiter, tapfere Kameraden!
#. fr: En avant<nbsp>!
msgctxt "NpcYell:4130:0:13"
msgid "On we go, brave warriors!"
msgstr "Вперёд, отважные воины!"

#. ja: 殲滅しよう…
#. de: Erledigen wir sie ...
#. fr: Finissons-en<nbsp>!
msgctxt "NpcYell:4131:0:13"
msgid "So be it."
msgstr "Что ж, покончим с ними..."

#. ja: 今度こそオシオキだよ！
#. de: Dieses Mal wird das letzte!
#. fr: Cette fois, on ne rrrigole plus<nbsp>!
msgctxt "NpcYell:4132:0:13"
msgid "Finally!"
msgstr "Ну наконец-то!"

#. ja: 護るぜ、大将！
#. de: Ich geb dir Deckung, Arbert!
#. fr: Je te couvre, Arbert<nbsp>!
msgctxt "NpcYell:4133:0:13"
msgid "On your guard!"
msgstr "Берегись, командир!"

#. ja: みんなの傷は私が…！
#. de: Keine Sorge, ich heile euch!
#. fr: Je m'occupe de vos blessures<nbsp>!
msgctxt "NpcYell:4134:0:13"
msgid "Stay close..."
msgstr "Держитесь рядом..."

#. ja: 刻むわよ！
#. de: Jetzt seid ihr daran!
#. fr: Tu vas souffrir<nbsp>!
msgctxt "NpcYell:4135:0:13"
msgid "You shall fall soon enough!"
msgstr "Скоро ты падёшь!"

#. ja: 手は抜かないぜ！
#. de: Ihr werdet schon noch sehen ...
#. fr: Je serai sans pitié<nbsp>!
msgctxt "NpcYell:4136:0:13"
msgid "You asked for it!"
msgstr "Сам напросился!"

#. ja: 引っ込んでな！
#. de: Schaut und lernt, ihr Helden!
#. fr: Comment osez-vous faire obstacle<nbsp>!?
msgctxt "NpcYell:4137:0:13"
msgid "There's no escape!"
msgstr "Вам не сбежать!"

#. ja: 了解だ！<br>遊ぼうぜ、英雄さんよ！
#. de: Dann lasst uns mal ein bisschen Spaß haben ...!
#. fr: À tes ordres<nbsp>!<nbsp>... À nous deux, Guerri<if $gn4>ère<else>er</if> de la Lumière<nbsp>!
msgctxt "NpcYell:4138:0:13"
msgid "I've been waiting for this!"
msgstr "Я давно этого ждал!"

#. ja: 退けねぇんだよ！
#. de: Mich besiegt ihr nicht!
#. fr: Je ne peux pas abandonner<nbsp>!
msgctxt "NpcYell:4139:0:13"
msgid "Courage, friends!"
msgstr "Я не отступлю!"

#. ja: 邪魔するな！
#. de: Aus dem Weg!
#. fr: Je vous pourfendrai de ma hache<nbsp>!
msgctxt "NpcYell:4140:0:13"
msgid "Out of my way!"
msgstr "С дороги!"

#. ja: 待ってろ、必ず…！
#. de: Warte ...
#. fr: Je n'ai pas dit mon dernier mot...<nbsp>!
msgctxt "NpcYell:4141:0:13"
msgid "Just hold on..."
msgstr "Держись... Я обязательно..."

#. ja: クッ！？
#. de: Ugh?!
#. fr: Hein<nbsp>!?
msgctxt "NpcYell:4142:0:13"
msgid "Huh!?"
msgstr "А?!"

#. ja: なにこれ…ッ！
#. de: Was ...?!
#. fr: Q-qu'est-ce que c'est<nbsp>!?
msgctxt "NpcYell:4143:0:13"
msgid "What the─!?"
msgstr "Что за...?!"

#. ja: まだ足りない…<br>もっと力を！
#. de: Der Äther reicht noch nicht!
#. fr: Ça ne suffira pas...<br>J'ai besoin de plus d'éther<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4144:0:13"
msgid "The aether! Hngh!<br>It's not enough!"
msgstr "Эфир... Кх...<br>Мало!"

#. ja: どけッ！
#. de: Weg da!
#. fr: Dégage, microbe<nbsp>!
msgctxt "NpcYell:4145:0:13"
msgid "Graaagh!"
msgstr "Гр-р-р!"

#. ja: あの子を倒す…<br>絶対にッ！
#. de: Diesen Grünschnabel mach ich fertig!
#. fr: Compte sur moi, je vais lui faire la peau<nbsp>!
msgctxt "NpcYell:4146:0:13"
msgid "You won't get away this time!"
msgstr "На этот раз тебе не уйти!"

#. ja: クッ…消耗が激しい…
#. de: Ngh ... Mir geht die Kraft aus ...
#. fr: Mince... Je suis presque à court d'énergie...
msgctxt "NpcYell:4147:0:13"
msgid "Ugh... Let it not be in vain..."
msgstr "Уф... Лишь бы не зря..."

#. ja: 感じる、みんなの力…<br>あと少し…！
#. de: Die Klinge ist fast vollendet!
#. fr: Nous y sommes presque.<br>Allez... un dernier effort<nbsp>!
msgctxt "NpcYell:4148:0:13"
msgid "I can feel it! Just a little more!"
msgstr "Чувствую! Ещё немного!"

#. ja: ブッ潰す！
#. de: Wie gefällt dir das?!
#. fr: Je vais t'écraser...<nbsp>!
msgctxt "NpcYell:4149:0:13"
msgid "I'll crush you!"
msgstr "Я тебя раздавлю!"

#. ja: 風よッォ！<br>風よ吹けッェ！
#. de: Wind! Feg sie weg!
#. fr: Que le vent se lève<nbsp>!
msgctxt "NpcYell:4150:0:13"
msgid "Sacred winds, come forth!"
msgstr "Священные ветра, явитесь!"

#. ja: 風がッァ…<br>やんで…しまったッ…
#. de: Wind ... Hat wehen aufgehört, kha ...?
#. fr: Le vent... s'est arrêté...
msgctxt "NpcYell:4151:0:13"
msgid "One with the wind, we become..."
msgstr "Мы становимся... едины с ветром..."

#. ja: シュコォ、シュコォ…<br>動かば斬るゴブ！
#. de: Wennzu auch nur Kleinefinger rührst, bizzu liefert!
#. fr: Kshhh... Lamebrix découpe tout ce qui bouge<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4152:0:13"
msgid "Pshhh... Shkohhh...<br>Uplander moves, uplander gets cut with stabbysteel!"
msgstr "Пшш... Шкох...<br>Горец шевелится — горцу в брюхо железом!"

#. ja: シュコォ、シュコォ…<br>罠を使うゴブ！
#. de: Psh, jetzt kommt Falle in Spiel!
#. fr: Kshhh... Kshhh... Lamebrix va déclencher un piège<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4153:0:13"
msgid "Pshhh... Shkohhh...<br>Uplander blindsteps right into sneakytrap!"
msgstr "Пшш... Шкох...<br>Горец сам в ловушку угодит!"

#. ja: ゴブ流大回転斬り！！
#. de: Wirbelnschlitzen!
#. fr: Kshhh... Gobtoupie mégatranchante<nbsp>!!
msgctxt "NpcYell:4154:0:13"
msgid "Uplanders taste swirlystab!"
msgstr "Горцам — вертлявый резак!"

#. ja: ゴブ流三日月斬り！！
#. de: Zerfetzensichel!
#. fr: Kshhh... Gobcroissant lacérant<nbsp>!!
msgctxt "NpcYell:4155:0:13"
msgid "Uplanders feel sickleslash!"
msgstr "Горцам — серпом по боку!"

#. ja: シュコォ、シュコォ…<br>切り札を使うゴブ！
#. de: Gleich siehzzu Sterne!
#. fr: Kshhh... Lambrix a plus d'un tour dans son sac<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:4156:0:13"
msgid "Pshhh... Shkohhh...<br>Uplanders are needing to die...<i>nowtimes</i>!"
msgstr "Пшш... Шкох...<br>Горцы должны умереть...<i>прямщас</i>!"

#. ja: シュコォ、シュコォ…<br>助力、援軍、助太刀だ！
#. de: Stützung ist kommen!
#. fr: Pshhh... Le brave Gobelin vient aider le fantastique Lamebrix<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4157:0:13"
msgid "Pshhh... Shkohhh...<br>For make glorious nation of Illuminati, uplanders must die!"
msgstr "Пшш... Шкох...<br>Чтоб великая держава Иллюминатов процветала, горцы должны умереть!"

#. ja: シュコォ、シュコォ…<br>堅守、防衛、大防御だ！
#. de: Psh, starke Abwehrengobbie ist da!
#. fr: Pshhh... Tout combattant gobelin doit savoir se défendre<nbsp>!
msgctxt "NpcYell:4158:0:13"
msgid "For glory of Quickthinx, gobbies must be strong!"
msgstr "Во славу Быстроглаза гобби должны быть сильными!"

#. ja: ケケケケ…<br>オ客サンガ来タゾ！
#. de: Wir haben Besuch! Hihihi.
#. fr: Kékéké... des visiteurs !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4159:0:13"
msgid "Looky heeEeeEre...<br>We have viiiIiiiIisitors..."
msgstr "Гляди-ка...<br>Виии-изитёры..."

#. ja: キキキキ…<br>遊ンデヤロウゼ…！
#. de: Das wird lustig! Hihihi.
#. fr: Kikiki... venez, on va s'amuser !
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4160:0:13"
msgid "I think they want<br>to plaaAaaaAaay...!"
msgstr "Ки-ки-ки...<br>Они хотят поиии-играть...!"

#. ja: ホラホラ…<br>ハヤクハヤク！
#. de: Komm her! Schnell, schnell!
#. fr: Allez, allez ! Dépêchez-vous !
msgctxt "NpcYell:4161:0:13"
msgid "Quickly! Quickly, now!"
msgstr "Быстрей! Ну же, быстрей!"

#. ja: マチクタビレタ…
#. de: Wie lange soll ich noch warten?
#. fr: J'en peux plus d'attendre...
msgctxt "NpcYell:4162:0:13"
msgid "I tire of waiting..."
msgstr "Сил нет ждать..."

#. ja: コッチニオイデ～！
#. de: Hierher!
#. fr: Approchez, approchez...
msgctxt "NpcYell:4163:0:13"
msgid "I'm over heeeeeere!"
msgstr "Идите сюда-а-а..."

#. ja: ウヒャッ！<br>捕マルモンカ～！
#. de: \<kreisch> Du kriegst mich nicht!
#. fr: Wouah ! Vous ne nous attraperez pas si facilement !
msgctxt "NpcYell:4164:0:13"
msgid "Bet you can't catch me!"
msgstr "А ну попробуй поймать!"

#. ja: コッチコッチ！
#. de: Hier bin ich! Hier!
#. fr: Par ici, par ici !
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:4165:0:13"
msgid "Not <i>there</i>...<i>here</i>!"
msgstr "Не <i>там</i>... а <i>тут</i>!"

#. ja: サアサア<br>イラッシャイ！
#. de: Hereinspaziert, her<shy>ein<shy>spa<shy>ziert!
#. fr: Entrez... entrez... on n'attend plus que vous...
msgctxt "NpcYell:4166:0:13"
msgid "Welcome! We have a special treat for you..."
msgstr "Добро пожаловать! Для вас есть особый сюрприз..."

#. ja: オッ、新シイ玩具ヲ<br>連レテキタノカ？
#. de: Oh, ein neues Spielzeug für mich?
#. fr: Oh ? Vous m'avez rapporté un nouveau jouet ?
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:4167:0:13"
msgid "A new toy for me? I do <i>love</i> toys."
msgstr "Новая игрушка для меня? Обожаю <i>игрушки</i>."

#. ja: オソイゾ～！
#. de: Geht das etwas schneller?
#. fr: Trop lent !
msgctxt "NpcYell:4168:0:13"
msgid "Too slooOooow!"
msgstr "Слишком медле-е-енно!"

#. ja: ヨシヨシ…<br>一緒ニ遊ボウゼ…！
#. de: Lass uns spiiielen!
#. fr: Oui, oui... On va s'amuser tous ensemble !
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:4169:0:13"
msgid "Oh, this will be so much <i>fun</i>!"
msgstr "Ох, это будет так <i>весело</i>!"

#. ja: ニゲロニゲロ～！
#. de: Schnell weg!
#. fr: Fuyons, fuyons !
msgctxt "NpcYell:4170:0:13"
msgid "Flee! Fleeeeeeeee!"
msgstr "Бегите! Беги-и-и-и!"

#. ja: オ前タチ…<br>ヤッチマイナ！
#. de: Macht sie fertig!
#. fr: Faites-en de la chair à pâté !
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:4171:0:13"
msgid "My lovelies...see that our friends have a <i>good time</i>."
msgstr "Мои милые... Устройте нашим друзьям <i>весёлый денёк</i>."

#. ja: バラバラニシテヤル！
#. de: Ich mach dich zu Hackbrei!
#. fr: On va vous mettre en pièces !
msgctxt "NpcYell:4172:0:13"
msgid "We'll rend you to shreds!"
msgstr "Разорвём вас на куски!"

#. ja: キキキキキ！
#. de: Hihihiii!
#. fr: Kikiki !
msgctxt "NpcYell:4173:0:13"
msgid "HeaeahHAEHAEha!"
msgstr "Хеа-ха-ха-ха!"

#. ja: 遊ビノ時間ダ！
#. de: Hui, jetzt fängt der Spaß an!
#. fr: C'est l'heure de la récréation !
msgctxt "NpcYell:4174:0:13"
msgid "It's time to plaaAaaaY!"
msgstr "Пора поиии-играть!"

#. ja: グッチャグチャニ<br>シテヤルゾ！
#. de: Hackbrei! Hackbrei!
#. fr: De la bouillie, de la bouillie !
msgctxt "NpcYell:4175:0:13"
msgid "We'll feast on your innards!"
msgstr "Мы сожрём ваши внутренности!"

#. ja: コレデモクラエ！
#. de: Nimm das hier!
#. fr: Prenez ça !
msgctxt "NpcYell:4176:0:13"
msgid "And this is for you!"
msgstr "А это вам!"

#. ja: ウケケケケ…<br>楽シイナァ！
#. de: Ui, ui! Das macht Spaß!
#. fr: Kékéké... qu'est-ce qu'on s'amuse !
msgctxt "NpcYell:4177:0:13"
msgid "This is the most fun we've had in yeeEeeEars!"
msgstr "Ке-ке-ке... Давно мы так не ве-е-еселились!"

#. ja: ここは通さないケロ！
#. de: Hier ist Endstation, quak!
#. fr: Coâc... vous ne poâsserez pas !
msgctxt "NpcYell:4178:0:13"
msgid "'Fraid we can't let you pass, ribbit!"
msgstr "Боюсь, мы не можем вас пропустить, ква!"

#. ja: 泥棒ケロ？<br>退治するケロ！
#. de: Diebe, quaak! Müssen wir zur Schnecke machen, quak!
#. fr: Coâ !? Des voleurs !? Moâssacrez-les !
msgctxt "NpcYell:4179:0:13"
msgid "Intruders? They'll make a fine supper, ribbit!"
msgstr "Незваные гости? Из них выйдет славный ужин, ква!"

#. ja: ここまで来るとはな…！
#. de: Du lebst noch? Nicht mehr lange!
#. fr: Quoi !? Vous êtes parvenus jusqu'ici !?
msgctxt "NpcYell:4180:0:13"
msgid "You still live? Not for long...!"
msgstr "Ещё живы? Ненадолго..."

#. ja: ホーホッホッ！
#. de: Hu hu huh!
#. fr: Rou... rourou !
msgctxt "NpcYell:4181:0:13"
msgid "Hoo! HooOoooOoo!"
msgstr "Ху! Хуу-у-у!"

#. ja: ホッホー！
#. de: Hu huh!
#. fr: Rourou !
msgctxt "NpcYell:4182:0:13"
msgid "Hoo hoo!"
msgstr "Ху-ху!"

#. ja: ホッホッホッー！
#. de: Hu hu huh!
#. fr: Rourourou !
msgctxt "NpcYell:4183:0:13"
msgid "Hoo hoo hooOooo!"
msgstr "Ху-ху-ху-у-у!"

#. ja: ホッ…<br>ホッホッ…
#. de: Hu! Hu huh!
#. fr: Rou... rourou...
msgctxt "NpcYell:4184:0:13"
msgid "Hoo... Hoo hoo..."
msgstr "Ху... Ху-ху..."

#. ja: 「カードバトルルーム」滞在終了まで、残り<num $n1>分です。<br>制限時間が残り<num $n2>分になると対戦ができなくなりますので<br>ご注意ください。
#. de: Dieser Weltensalon schließt in <num $n1> Minute<if ($n1 == 1)><else>n</if>. Wir bitten zu beachten, dass neue Partien nur bis <num $n2> Minuten vor Schließung begonnen werden können.
#. fr: Votre temps de présence dans l'arène sera écoulé dans <num $n1> <if ($n1 <= 1)>minute<else>minutes</if>.<br>Notez que passé <num $n2> <if ($n2 <= 1)>minute restante<else>minutes restantes</if>, vous ne pourrez plus jouer à Triple Triade.
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
#. macro: <if ($n1 == 1)>minute<else>minutes</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 1 == 1 (condition: may be reworded, restructured, added, or dropped)
#. macro: <num $n2> — a number; value = number parameter 2 (game data: keep it; it may move or repeat)
#. macro: <if ($n1 == 2)>minute<else>minutes</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 1 == 2 (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:4185:0:13"
msgid "The Battlehall will be closing in <num $n1> <if ($n1 == 1)>minute<else>minutes</if>. Please note that no new matches may be initiated within <num $n2> <if ($n1 == 2)>minute<else>minutes</if> of closing time."
msgstr "Зал карточных баталий закроется через <num $n1> <if ($n1 == 1)>минута<else>минуты</if>. Обратите внимание: за <num $n2> <if ($n2 == 1)>минута<else>минуты</if> до закрытия новые матчи начинать будет нельзя."

#. ja: 「カードバトルルーム」滞在終了まで、残り<num $n1>分となった為<br>対戦が制限されました。<br>制限時間が0分になると強制退出となりますのでご注意ください。
#. de: Da der Weltensalon in <num $n1> Minute<if ($n1 == 1)><else>n</if> schließt, können keine neuen Partien mehr begonnen werden. Wir bitten zu beachten, dass verbleibende Spieler nach Schließung aus dem Weltensalon entfernt werden.
#. fr: Votre temps de présence restant dans l'arène ayant atteint <num $n1> <if ($n1 <= 1)>minute<else>minutes</if>, vous ne pouvez plus jouer à Triple Triade.<br>Notez qu'une fois le temps de présence écoulé, vous serez au<shy>to<shy>ma<shy>ti<shy>que<shy>ment <if $gn4>expulsée<else>expulsé</if> de l'arène.
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
#. macro: <if ($n1 == 1)>minute<else>minutes</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 1 == 1 (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:4186:0:13"
msgid "The Battlehall will be closing in <num $n1> <if ($n1 == 1)>minute<else>minutes</if>. No new matches may be initiated at this time. Please note that you will automatically be escorted out of the Battlehall at closing time."
msgstr "Зал карточных баталий закроется через <num $n1> <if ($n1 == 1)>минута<else>минуты</if>. Новые матчи уже начинать нельзя. По закрытии вас автоматически проводят из зала."

#. ja: 「カードバトルルーム」滞在終了まで、残り<num $n1>分です。<br>制限時間が0分になると強制退出となりますのでご注意ください。
#. de: Dieser Weltensalon schließt in <if ($n1 == 1)>einer<else><num $n1></if> Minute<if ($n1 == 1)><else>n</if>. Wir bitten zu beachten, dass verbleibende Spieler nach Schließung aus dem Weltensalon entfernt werden.
#. fr: Votre temps de présence dans l'arène sera écoulé dans <num $n1> <if ($n1 <= 1)>minute<else>minutes</if>.<br>Notez qu'une fois ce temps écoulé, vous serez au<shy>to<shy>ma<shy>ti<shy>que<shy>ment <if $gn4>expulsée<else>expulsé</if>.
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
#. macro: <if ($n1 == 1)>minute<else>minutes</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 1 == 1 (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:4187:0:13"
msgid "The Battlehall will be closing in <num $n1> <if ($n1 == 1)>minute<else>minutes</if>. Please note that you will automatically be escorted out of the Battlehall at closing time."
msgstr "Зал карточных баталий закроется через <num $n1> <if ($n1 == 1)>минута<else>минуты</if>. По закрытии вас автоматически проводят из зала."

#. ja: 「カードバトルルーム」滞在終了まで、残り<num $n1>分を過ぎた為<br>新たなプレイヤーの入室が制限されました。
#. de: Dieser Weltensalon schließt in <if ($n1 == 1)>einer<else><num $n1></if> Minute<if ($n1 == 1)><else>n</if>. Neue Spieler werden nun nicht mehr eingelassen.
#. fr: Votre temps de présence dans l'arène sera écoulé dans <num $n1> <if ($n1 <= 1)>minute<else>minutes</if>.<br>Notez que l'arène ne peut plus être rejointe par d'autres joueurs.
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
#. macro: <if ($n1 == 1)>minute<else>minutes</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = number parameter 1 == 1 (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:4188:0:13"
msgid "The Battlehall will be closing in <num $n1> <if ($n1 == 1)>minute<else>minutes</if>. From this point onward, no new players will be admitted to the room."
msgstr "Зал карточных баталий закроется через <num $n1> <if ($n1 == 1)>минута<else>минуты</if>. Новых игроков в зал больше не пускают."

#. ja: チッ…！
#. de: Mist ...
#. fr: Merde<nbsp>!
msgctxt "NpcYell:4189:0:13"
msgid "Grr..."
msgstr "Тьфу..."

#. ja: クソがッ…！
#. de: Verflucht!
#. fr: Bordel<nbsp>!
msgctxt "NpcYell:4190:0:13"
msgid "Damn you!"
msgstr "Проклятье!"

#. ja: 諦めるかよ…！
#. de: Das darf doch nicht ...!
#. fr: Je n'aban<shy>don<shy>ne<shy>rai jamais<nbsp>!
msgctxt "NpcYell:4191:0:13"
msgid "I won't lose!"
msgstr "Я не проиграю!"

#. ja: 餅つき会場はここだぜ！
#. de: Hier geht's zu den Mochi!
#. fr: Pour le mochi, c'est par ici !
msgctxt "NpcYell:4192:0:13"
msgid "Just beyond lies all our mochi!"
msgstr "За поворотом — наши моти!"

#. ja: 降神餅の回収を<br>手伝ってくれねぇか！？
#. de: Schnell, bring die Mochi vor den Vögeln in Sicherheit!
#. fr: Hé ! Tu veux pas nous filer un coup de main pour récupérer ces mochi de la transition !?
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:4193:0:13"
msgid "Please make haste, <split \" \" 1><string $gs1></split>! What's left of our precious mochi is being devoured as we speak!"
msgstr "Поторопитесь, <split \" \" 1><string $gs1></split>! Остатки драгоценных моти уже пожирают прямо сейчас!"

#. ja: サイクロプスの動きを見て餅を取ってくれ！
#. de: Lass dich bloß nicht vom Zyklopen zu Brei stampfen!
#. fr: Fais bien gaffe au cyclope quand tu t'approches, et prends-en le plus possible dans ta besace !
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:4194:0:13"
msgid "Be sure to avoid the cyclops's mallet, <split \" \" 1><string $gs1></split>, lest you also are pounded into a fine paste!"
msgstr "Берегитесь дубины циклопа, <split \" \" 1><string $gs1></split>, а то и сами превратитесь в лепёшку!"

#. ja: このままじゃ<br>臼まで壊れちまうぜ…！
#. de: So wie der draufhaut, zerschlägt er noch den Mörser!
#. fr: Il va pulvériser le mortier s'il continue comme ça !
msgctxt "NpcYell:4195:0:13"
msgid "Quickly, quickly now, else we'll have nothing to distribute to the citizens!"
msgstr "Поторопитесь, а то горожанам нечего будет раздавать!"

#. ja: 餅の回収、任せたぜ！
#. de: Schnapp dir die Mochi!
#. fr: Bonne chance ! Je compte sur toi !
msgctxt "NpcYell:4196:0:13"
msgid "We're counting on you!"
msgstr "Мы на вас рассчитываем!"

#. ja: なんて鮮やかな回収なんだ！<br>さすがだな！
#. de: Flink wie ein Affe! Es macht richtig Spaß, dir zuzusehen!
#. fr: Tu te débrouilles comme un chef ! En trente ans de mochi, j'ai jamais vu un sauvetage pareil !
msgctxt "NpcYell:4197:0:13"
msgid "Fantastic! At this rate, we'll have more than enough mochi to feed the masses!"
msgstr "Вот это да! Такими темпами моти хватит на всех!"

#. ja: あぁ、縁起物の餅が…
#. de: Ah, die schönen Mochi, es ist zum Heulen!
#. fr: Tous ces mochi gâchés, quelle tristesse...
msgctxt "NpcYell:4198:0:13"
msgid "Oh, no! It seems we are too late..."
msgstr "Ах, нет! Похоже, мы опоздали..."

#. ja: 絶対負けないッ！
#. de: So kann es nicht zu Ende gehen!
#. fr: Nous ne pouvons pas perrrdre<nbsp>!
msgctxt "NpcYell:4199:0:13"
msgid "It ends here!"
msgstr "Мы не можем проиграть!"

#. ja: やってくれる…
#. de: Sie sind stark ...
#. fr: Ils sont forts...
msgctxt "NpcYell:4200:0:13"
msgid "Bloody hells..."
msgstr "Ну и ну..."

#. ja: 痛ぇじゃねえか…
#. de: Ugh ...
#. fr: Pétard, ça fait mal...
msgctxt "NpcYell:4201:0:13"
msgid "I can take it..."
msgstr "Да больно же..."

#. ja: ごめんなさい…
#. de: Es ... tut mir leid ...
#. fr: Pardon, mes amis...
msgctxt "NpcYell:4202:0:13"
msgid "Forgive me..."
msgstr "Простите..."

#. ja: みんな…今…
#. de: Vergebt mir!
#. fr: Nous sommes... si près du but...
msgctxt "NpcYell:4203:0:13"
msgid "We...we must..."
msgstr "Все... Мы должны..."

#. ja: 少々…不利か…
#. de: Ich kann ... nicht ...
#. fr: C'est plus dur que prévu...
msgctxt "NpcYell:4204:0:13"
msgid "Unfortunate..."
msgstr "Пожалуй... силы неравны..."

#. ja: おくれを取った…
#. de: Das war's wohl ...
#. fr: Je dois me ressaisir...
msgctxt "NpcYell:4205:0:13"
msgid "Again...?"
msgstr "Я... отстал..."

#. ja: まだダメなのに…
#. de: Unsere ... Mission ...
#. fr: Non... Pas comme ça...
msgctxt "NpcYell:4206:0:13"
msgid "But we're so close..."
msgstr "Но мы же почти справились..."

#. ja: ヤダよ…絶対…！
#. de: Nein ...!
#. fr: Ils ne peuvent pas... nous battrrre...
msgctxt "NpcYell:4207:0:13"
msgid "No, no, no..."
msgstr "Нет... нет..."

#. ja: せっかく…<br>記憶が…戻ったのに…
#. de: Gerade jetzt ...<br>da die Erinnerung wiederkommt ...!
#. fr: Mince... Et dire que je venais juste... de me souvenirrr...
msgctxt "NpcYell:4208:0:13"
msgid "I finally remember...who I am..."
msgstr "Я наконец вспомнил... кто я..."

#. ja: タユーン…ペルスバン…<br>お前たち…どこに…
#. de: Tayuun ... Percevains ... Wo seid ihr?
#. fr: Tayuun... Percevains... Où êtes-vous<nbsp>?<nbsp>...
msgctxt "NpcYell:4209:0:13"
msgid "Una... Percevains... Where did you...?"
msgstr "Уна... Персевен... Где вы?.."

#. ja: 俺たちで砂の家を<br>守らなきゃ…
#. de: Wir müssen den Sonnenwind schützen!
#. fr: Il est de notre devoir de protéger le Refuge des sables<nbsp>!<nbsp>...
msgctxt "NpcYell:4210:0:13"
msgid "We must...protect...the Waking Sands..."
msgstr "Мы должны... защитить... Живые пески..."

#. ja: 竜の牙は…<br>いつでも貴様らに…
#. de: Die Klauen des Drachen ... werden euch ...
#. fr: Les dragons... vous réduiront... en lambeaux<nbsp>!<nbsp>...
msgctxt "NpcYell:4211:0:13"
msgid "The dragons will...rend you...asunder..."
msgstr "Драконы... разорвут вас... в клочья..."

#. ja: あれ…俺は…<br>処分され…て…？
#. de: Wie? E-Exe...kutiert? \<schluck>
#. fr: H-hein<nbsp>!?<nbsp>... J'ai... été... exécuté<nbsp>!?<nbsp>...
msgctxt "NpcYell:4212:0:13"
msgid "I...I've been...executed!?"
msgstr "Меня... казнили!?"

#. ja: グヒャヒャヒャ…<br>闇は闇に還るのが定め…
#. de: Gahaha! Dunkelheit verschwindet im Dunkel!
#. fr: Mouah ha ha<nbsp>!<nbsp>... Une vie passée à agir dans l'ombre... et mourir dans l'ombre...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4213:0:13"
msgid "Gyahahaha! \\<wheeze><br>The dark returns...to dark..."
msgstr "Ха-ха-ха! <i>Хр-р...</i><br>Тьма возвращается... во тьму..."

#. ja: アラミゴが…<br>燃えて…いる…
#. de: Ala Mhigo ... brennt ...! Alles brennt!
#. fr: Ala Mhigo... est... en feu...
msgctxt "NpcYell:4214:0:13"
msgid "Ala Mhigo, it...it burns..."
msgstr "Ала Миго... горит..."

#. ja: やめろ…<br>もう死にたく…
#. de: Nein ... Wag es nicht! Nicht noch einmal!
#. fr: Hiiii<nbsp>!<nbsp>... Nooon... Je ne veux pas mourir... à nouveau...
msgctxt "NpcYell:4215:0:13"
msgid "No... Stay back! Not again!"
msgstr "Нет... Не подходи! Только не снова!"

#. ja: ダミエリオー…<br>もう一度、目を…
#. de: Damielliot, mein Kind! ... Wach auf, bitte!
#. fr: Damielliot... Réveille-toi... mon enfant...
msgctxt "NpcYell:4216:0:13"
msgid "Damielliot, please... Open your eyes..."
msgstr "Дамиэллиот... прошу... Открой глаза..."

#. ja: ラニエット、フランセル…<br>どうか幸せに…
#. de: Laniaitte ... Francel ... Ich wünsche euch alles Gute ...
#. fr: Laniaitte... Francel... Puissiez-vous vivre heureux...
msgctxt "NpcYell:4217:0:13"
msgid "Laniaitte... Francel... I wish you all..."
msgstr "Ланиетт... Франсель... Желаю вам счастья..."

#. ja: あぁ、ガイウス様…<br>貴方のところへ…
#. de: Gaius ... Endlich werde ich an deiner Seite sein ...
#. fr: Gaius... Je vais enfin pouvoir être... à nouveau... à vos côtés...
msgctxt "NpcYell:4218:0:13"
msgid "Lord Gaius... I'm coming..."
msgstr "Господин Гай... Я иду к вам..."

#. ja: 無念…<br>閣下の覇道を…
#. de: „Lass den Sieg Zeichen deiner Loyalität sein“ ... Vergebt mir, Legatus Gaius!
#. fr: Au nom du général Gaius van Baelsar... je ne peux pas me laisser vaincre...
msgctxt "NpcYell:4219:0:13"
msgid "Lord van Baelsar... Even in death...I serve..."
msgstr "Господин ван Баэльсар... Даже после смерти... я служу..."

#. ja: こんな姿で…<br>死ぬ…なんて…
#. de: Dass ich dem Tod ... in dieser Gestalt gegenübertreten würde!
#. fr: Oh, nooon... Mon... corps<nbsp>!<nbsp>... Que m'est-il arrivé<nbsp>?<nbsp>...
msgctxt "NpcYell:4220:0:13"
msgid "No! I can't die... Not like this..."
msgstr "Нет! Я не могу умереть... Только не так..."

#. ja: アタマがイタイ…<br>オデはもう…
#. de: Nguuh ... Mein Kopf ...
#. fr: Mal... à la tête... Je-je suis... mort<nbsp>?<nbsp>...
msgctxt "NpcYell:4221:0:13"
msgid "SLAVES... NO MORE...!"
msgstr "РАБСТВУ — КОНЕЦ...!"

#. ja: 三度の死か…<br>嗚呼、ディアマンダ…
#. de: Noch ein drittes Mal sterben, das ist zu viel! Oh, Diamanda ...
#. fr: Ainsi je péris une fois de plus... Ah, Diamanda... pardonne-moi...
msgctxt "NpcYell:4222:0:13"
msgid "Dyin' a third time... Forgive me, Diamanda..."
msgstr "Умереть в третий раз... Прости меня, Диаманда..."

#. ja: 魔導リーパー改…<br>あれがあれば…
#. de: Wenn ich nur einen Magitek-Schnitter hätte!
#. fr: Fauch... euse... magitek... type II...
msgctxt "NpcYell:4223:0:13"
msgid "I must find...the Black Eft..."
msgstr "Мне нужно найти... Чёрного тритона..."

#. ja: シュコォ、シュコォ…<br>近づく者は撫で斬りゴブ！
#. de: Psh, los, trauzzu dich ruhig her!
#. fr: Kshhh... Lamebrix réserve une surprise à ceux qui s'approchent<nbsp>!
msgctxt "NpcYell:4224:0:13"
msgid "Shkoh! Uplander comes close, gets special surprise!"
msgstr "Шкох! Наземник подойдёт — получит особый сюрприз!"

#. ja: シュコォ、シュコォ…<br>間合いを取っても無駄ゴブ！
#. de: Fernebleiben wird auch nicht nützen!
#. fr: Kshhh... Kshhh... S'éloigner de Lamebrix ne sert à rien<nbsp>!
msgctxt "NpcYell:4225:0:13"
msgid "Uplanders think they are safe in farplace? Think again!"
msgstr "Думают, вдалеке безопасно? Ещё чего!"

#. ja: シュコォ、シュコォ…<br>無差別に攻撃ゴブ！
#. de: Jetzt gibt Dreschen für alle Großwachsene, kho!
#. fr: Kshhh... Lamebrix attaque tout le monde sans discrimination<nbsp>!
msgctxt "NpcYell:4226:0:13"
msgid "Shkoh! Slashycut and pointystab!"
msgstr "Шкох! Режу-кромсаю, колю-тыкаю!"

#. ja: シュコォ、シュコォ…<br>キツい一撃、覚悟ゴブ！
#. de: Machzzu dich schon auf was fasst!
#. fr: Kshhh... Les humains vont beaucoup souffrir<nbsp>!
msgctxt "NpcYell:4227:0:13"
msgid "Shkoh! Uplanders will feel much pain!"
msgstr "Шкох! Наземникам будет больно!"

#. ja: 出でよッ！<br>サモンダークネス！
#. de: Kommt, Geschöpfe der Dunkelheit!<br>Tretet ins Licht der Ewigkeit!
#. fr: Venez<nbsp>!<nbsp>... Et goûtez aux ténèbres<nbsp>!
msgctxt "NpcYell:4228:0:13"
msgid "Darkness to me!"
msgstr "Тьма, ко мне!"

#. ja: こちら側からも<br>侵入者だと！？
#. de: Auf dieser Seite sind sie auch durchgebrochen?!
#. fr: Encore des envahisseurs<nbsp>!? Arrêtez-les im<shy>mé<shy>dia<shy>te<shy>ment<nbsp>!
msgctxt "NpcYell:4229:0:13"
msgid "They've breached the castrum gates!"
msgstr "Они прорвались через ворота лагеря!"

#. ja: エオルゼアの<br>蛮族どもめ！
#. de: Eorzäische Barbaren!
#. fr: Bande de sauvages<nbsp>!
msgctxt "NpcYell:4230:0:13"
msgid "Eorzean savages!"
msgstr "Эорзейские дикари!"

#. ja: 敵を発見！<br>攻撃を開始する！
#. de: Schlagt die Eindringlinge zurück!
#. fr: Ennemis en vue<nbsp>! Anéantissez-les<nbsp>!
msgctxt "NpcYell:4231:0:13"
msgid "Repel the intruders!"
msgstr "Отбросьте захватчиков!"

#. ja: 相手は少数だ…<br>迎撃するぞ！
#. de: Welch jämmerlicher Haufen! Tötet sie!
#. fr: Ils ne sont pas nombreux<nbsp>! Ne leur faites pas de cadeau<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4232:0:13"
msgid "We have them outnumbered!<br>Crush these fools!"
msgstr "Нас больше!<br>Раздавите этих глупцов!"

#. ja: エオルゼア同盟軍か？<br>ええい、反撃だ！
#. de: Die Eorzäische Allianz? Haltet sie auf!
#. fr: L'Alliance éorzéenne va bientôt disparaître<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4233:0:13"
msgid "A scouting party?<br>Stop them!"
msgstr "Разведчики?<br>Остановите их!"

#. ja: 確実に倒すぞ！
#. de: Für das Kaiserreich!
#. fr: Vous ne sortirez pas vivants d'ici<nbsp>!
msgctxt "NpcYell:4234:0:13"
msgid "For the Empire!"
msgstr "За Империю!"

#. ja: ぶっつけ本番だが<br>この新型で！
#. de: Ah, Schießübungen auf lebende Ziele!
#. fr: Ah, voilà des cibles pour m'entraîner<nbsp>!
msgctxt "NpcYell:4235:0:13"
msgid "Ah! Live practice targets!"
msgstr "А! Живые мишени для испытаний!"

#. ja: スカイアーマー隊！<br>支援しろ！
#. de: Setzt die Himmelspanzer ein!
#. fr: Déployez les armures aériennes<nbsp>!
msgctxt "NpcYell:4236:0:13"
msgid "Deploy sky armor units!"
msgstr "Развернуть воздушные доспехи!"

#. ja: アンカー射出！
#. de: Anker los!
#. fr: Vous allez tâter du crochet<nbsp>!
msgctxt "NpcYell:4237:0:13"
msgid "Anchor away!"
msgstr "Якорь — пуск!"

#. ja: 絡め取る！
#. de: Nicht so voreilig!
#. fr: Pas si vite<nbsp>!
msgctxt "NpcYell:4238:0:13"
msgid "Not so fast!"
msgstr "Не так быстро!"

#. ja: 喰らえ！
#. de: Dich mach ich fertig!
#. fr: À mort<nbsp>!
msgctxt "NpcYell:4239:0:13"
msgid "You're mine!"
msgstr "Ты мой!"

#. ja: 新型が破れるなんて…
#. de: Unmöglich! Unsere neueste Entwicklung ...
#. fr: Mais c'est pas vrai<nbsp>! Ce nouveau modèle était censé être invulnérable<nbsp>!
msgctxt "NpcYell:4240:0:13"
msgid "Impossible! This was the latest design..."
msgstr "Невозможно! Это же новейшая модель..."

#. ja: 青燐機関全開！<br>戦闘態勢に移行する！
#. de: Aktiviere Erdseim-Verstärker. Angriffsmodus Delta.
#. fr: Activation complète de la propulsion au céruleum<nbsp>! Paré au combat<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4241:0:13"
msgid "Activating surplus ceruleum propulsion. <br>Engaging enemy."
msgstr "Запуск резервных церулевых двигателей.<br>Переход к бою."

#. ja: 魔導ビット射出！
#. de: Aktiviere Magitek-Bit-Laserraster.
#. fr: Activation des drones magitek<nbsp>!
msgctxt "NpcYell:4242:0:13"
msgid "Activating magitek bit laser grid."
msgstr "Активация лазерной сети магитех-битов."

#. ja: 魔導スラッシャー<br>起動せよ！
#. de: Magitek-Schlitzer in Angriffsmodus!
#. fr: Déploiement des tailladeurs magitek<nbsp>!
msgctxt "NpcYell:4243:0:13"
msgid "Deploying magitek slashers."
msgstr "Развёртывание магитех-рассекателей."

#. ja: 機体が保たない？<br>だ、脱出を…！
#. de: Strukturelle Integrität defekt. Initiiere Notfallprotokoll.
#. fr: Perte de contrôle de l'appareil<nbsp>! É-évacuation d'urgence deman...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4244:0:13"
msgid "Structural integrity compromised.<br>Initiating withdrawal protocol..."
msgstr "Каркас повреждён.<br>Запуск протокола отступления..."

#. ja: 目くらましを使う！
#. de: Gute Nacht!
#. fr: La vengeance sera mienne<nbsp>!
msgctxt "NpcYell:4245:0:13"
msgid "You're all blind!"
msgstr "Теперь вы все ослепнете!"

#. ja: これで動けまい！
#. de: Stehengeblieben!
#. fr: Alors, on fait du surplace<nbsp>? Ha ha<nbsp>!
msgctxt "NpcYell:4246:0:13"
msgid "Let's see you squirm out of this!"
msgstr "Ну-ка, попробуйте выбраться!"

#. ja: 強行着陸するぞ！
#. de: Das wird eine harte Landung!
#. fr: Attention à l'atterrissage<nbsp>!
msgctxt "NpcYell:4247:0:13"
msgid "We'll force a landing!"
msgstr "Принудительная посадка!"

#. ja: 気を付けるのだ！
#. de: Sei vorsichtig, <split " " 1><string $gs1></split>!
#. fr: Soyez sur vos gardes, <split " " 1><string $gs1></split><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:4248:0:13"
msgid "Be wary, <split \" \" 1><string $gs1></split>!"
msgstr "Будьте начеку, <split \" \" 1><string $gs1></split>!"

#. ja: フシュー！<br>嫌な気配だ！
#. de: \<zisch><br>Hier liegt ein fauler Gestank in der Luft!
#. fr: Il y a quelque chose de néfaste dans l'air<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4249:0:13"
msgid "\\<hiss><br>There is a decidedly<br>foul scent on the air!"
msgstr "<i>Ш-ш-ш...</i><br>В воздухе скверно<br>пахнет!"

#. ja: なんということだ…
#. de: Das verheißt nichts Gutes<nbsp>...
#. fr: J'ai un mauvais pres<shy>sen<shy>ti<shy>ment...
msgctxt "NpcYell:4250:0:13"
msgid "This does not bode well..."
msgstr "Это дурной знак..."

#. ja: 女王との決戦だ！
#. de: Jetzt bist du dran, Schattenkönigin!
#. fr: Nous sommes ici pour toi, Reine des ombres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4251:0:13"
msgid "We come for you,<br>Shadow Queen!"
msgstr "Мы пришли за тобой,<br>Королева теней!"

#. ja: イーハッハッ！
#. de: Hihihiii!
#. fr: Ha ha haa haaa<nbsp>!
msgctxt "NpcYell:4252:0:13"
msgid "Tee hee hee!"
msgstr "Хи-хи-хи!"

#. ja: ヒャッハー！
#. de: Harharhar!
#. fr: Yaaaah<nbsp>!
msgctxt "NpcYell:4253:0:13"
msgid "Bwahahaha!"
msgstr "Бу-га-га!"

#. ja: コッチダヨ！
#. de: Hier drüben ... ♪
#. fr: Par ici<nbsp>!
msgctxt "NpcYell:4254:0:13"
msgid "Over here～♪"
msgstr "Сюда～♪"

#. ja: 永遠の眠りに<br>墜ちるがいい！
#. de: Schließ deine Augen und wache nie wieder auf!
#. fr: Fermez les yeux et dormez à tout jamais<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4255:0:13"
msgid "Close your eyes,<br>and never awaken!"
msgstr "Закрой глаза<br>и больше не просыпайся!"

#. ja: 影の力よ！<br>我が命に従え！
#. de: Diener des Schattens!<br>Erhört meinen Ruf!
#. fr: À moi, pouvoir des ombres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4256:0:13"
msgid "Tendrils of shadow!<br>Hearken to my call!"
msgstr "Отростки Тьмы!<br>Внемлите моему зову!"

#. ja: 行け行け！
#. de: Für das Kaiserreich!
#. fr: Gloire à l'Empire<nbsp>!
msgctxt "NpcYell:4257:0:13"
msgid "For the Empire!"
msgstr "За Империю!"

#. ja: 殺っちまえ！
#. de: Schnappt sie euch!
#. fr: Crevez, raclures<nbsp>!
msgctxt "NpcYell:4258:0:13"
msgid "Get 'em, Captain!"
msgstr "Взять их, капитан!"

#. ja: 蛮族どもめ！
#. de: Erschlagt diese Wilden!
#. fr: Mort aux sauvages<nbsp>!
msgctxt "NpcYell:4259:0:13"
msgid "Slay those savages!"
msgstr "Убейте этих дикарей!"

#. ja: うおおおお！
#. de: Raaaahhrg!
#. fr: Raaah<nbsp>!
msgctxt "NpcYell:4263:0:13"
msgid "Raaah!"
msgstr "Рааа!"

#. ja: オラの力<br>見せてやるだ！
#. de: Fürchtet euch schon mal!
#. fr: Mon marteau va vous réduire en bouillie<nbsp>!
msgctxt "NpcYell:4264:0:13"
msgid "Fear my hammer!"
msgstr "Бойтесь моего молота!"

#. ja: おんどりゃあ！
#. de: Gleich weinst du!
#. fr: Ça va faire mal<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4265:0:13"
msgid "I'll break you<br>into pieces!"
msgstr "Я разнесу вас<br>вдребезги!"

#. ja: な、なんで！？
#. de: Kommandant! Aber ...
#. fr: M-mais pourquoi<nbsp>!?
msgctxt "NpcYell:4266:0:13"
msgid "Captain!? Why...?"
msgstr "Капитан!? Почему?.."

#. ja: うわああ！
#. de: Du hast mich getroffen!
#. fr: Aaaah<nbsp>!
msgctxt "NpcYell:4267:0:13"
msgid "Gah! Y-You hit me!"
msgstr "Ай! Т-ты меня задел!"

#. ja: 味方まで…<br>ひ、ひどい！
#. de: Doch nicht die eigenen Leute!
#. fr: Eh, on est dans le même camp<nbsp>!
msgctxt "NpcYell:4268:0:13"
msgid "F-Friendly fire!"
msgstr "С-свои стреляют!"

#. ja: そ、そんな…<br>あんまりだ…
#. de: Wenn ich das gewusst ... \<urks>
#. fr: Mais qu'est-ce que je fais ici...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4269:0:13"
msgid "I didn't sign up<br>for this..."
msgstr "Я не на это<br>подписывался..."

#. ja: う、恨むぞ…
#. de: Verfluchte ...
#. fr: Soyez maudits...
msgctxt "NpcYell:4270:0:13"
msgid "Damn glory-seeker..."
msgstr "Чтоб тебя, охотник за славой..."

#. ja: おりゃああ！
#. de: Garhrr!
#. fr: Graaah<nbsp>!
msgctxt "NpcYell:4271:0:13"
msgid "Graaah!"
msgstr "Гра-а-а!"

#. ja: しつこいんだど！
#. de: Wie oft denn noch?!
#. fr: Qu'est-ce qu'il y a<nbsp>? T'en veux encore<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4272:0:13"
msgid "How many times<br>must I hit you!?"
msgstr "Сколько раз<br>мне ещё тебя бить!?"

#. ja: はやく殺られちまえ！
#. de: Stirb endlich!
#. fr: Meurs<nbsp>! Meurs, j'ai dit<nbsp>!
msgctxt "NpcYell:4273:0:13"
msgid "Just die already!"
msgstr "Да сдохни уже!"

#. ja: 先ほどの<br>威勢はどうした？
#. de: Na, was ist jetzt?!
#. fr: Alors, on fait moins le malin, hein<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4274:0:13"
msgid "Where now is<br>your posturing?"
msgstr "Куда делась<br>твоя спесь?"

#. ja: どうした？<br>こんなものか！
#. de: War das alles?
#. fr: C'est tout<nbsp>? Peuh<nbsp>!
msgctxt "NpcYell:4275:0:13"
msgid "Is this all you have?"
msgstr "И это всё, на что ты способен?"

#. ja: ぬるいわ！
#. de: Pah, erbärmlich!
#. fr: C'est faible, très faible<nbsp>!
msgctxt "NpcYell:4276:0:13"
msgid "Disappointing!"
msgstr "Разочаровывает..."

#. ja: 仕方あるまい…<br>突撃だ！
#. de: Na gut, Leute! Angriff!
#. fr: Bon, pas le choix... À l'attaque<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4277:0:13"
msgid "\\<sigh><br>Well, you heard him!<br>Charge!"
msgstr "<i>Эх...</i><br>Вы слышали приказ!<br>В атаку!"

#. ja: 餅つき会場はここだぜ！
#. de: Hier findet das Mochi-Stampfen statt!
#. fr: C'est ici qu'on écrase le mochi<nbsp>!
msgctxt "NpcYell:4278:0:13"
msgid "Here is where the pounding takes place!"
msgstr "Вот здесь и будем колотить!"

#. ja: 降神餅の回収を<br>手伝ってくれねぇか！？
#. de: Bitte hilf uns, die Mochi zu retten!
#. fr: Tu voudrais pas nous donner un petit coup de main<nbsp>?
msgctxt "NpcYell:4279:0:13"
msgid "Please help us retrieve the mochi!"
msgstr "Помогите собрать моти!"

#. ja: サイクロプスの動きを見て餅を取ってくれ！
#. de: Achte auf den Hammerschwung des Zyklopen, damit du nicht selbst gestampft wirst!
#. fr: Prends garde aux mouvements du cyclope en t'approchant, et prends-en le plus possible<nbsp>!
msgctxt "NpcYell:4280:0:13"
msgid "Watch the cyclops's swing and have care you aren't pounded into paste!"
msgstr "Следите за размахом циклопа, а то сами в кашу превратитесь!"

#. ja: 軍用犬の妨害には<br>気を付けろよ！
#. de: Pass auf die Kampfhunde auf!
#. fr: Gaffe aux molosses qui rôdent, ils aiment par<shy>ti<shy>cu<shy>liè<shy>rement la chair d'aventurier<nbsp>!
msgctxt "NpcYell:4281:0:13"
msgid "Ware the deckhounds!"
msgstr "Берегитесь боевых псов!"

#. ja: 餅の回収、任せたぜ！
#. de: Das Schicksal der Mochi liegt in deinen Händen!
#. fr: On compte sur toi pour ramener des mochi<nbsp>!
msgctxt "NpcYell:4282:0:13"
msgid "The fate of the mochi is in your hands!"
msgstr "Судьба моти в ваших руках!"

#. ja: 見事な回収だったな！<br>タロまで元気になっちまったぜ！
#. de: Das war beeindruckend! Selbst Taro ist begeistert!
#. fr: Tu as fait des miracles<nbsp>! Regarde, même Taro a repris du poil de la bête<nbsp>!
msgctxt "NpcYell:4283:0:13"
msgid "That was a truly inspiring display! Why, even Taro has regained his cheer!"
msgstr "Вот это сбор! Да Таро даже повеселел!"

#. ja: あぁ、縁起物の餅が…
#. de: Oh nein ... Unsere kostbaren Mochi<nbsp>...
#. fr: Oh non... Qu'est-ce qu'on va faire, sans mochi...
msgctxt "NpcYell:4284:0:13"
msgid "No... Our precious mochi..."
msgstr "Нет... Наши драгоценные моти..."

#. ja: キャハハハ！
#. de: Muharhar!
#. fr: Mouah ha ha ha<nbsp>!
msgctxt "NpcYell:4285:0:13"
msgid "Mwahahaha!"
msgstr "Муа-ха-ха-ха!"

#. ja: オバカサ～ン！
#. de: Ihr dummen Sterblichen!
#. fr: Stupides mortels<nbsp>!
msgctxt "NpcYell:4286:0:13"
msgid "Mortal oafs!"
msgstr "Смертные глупцы!"

#. ja: ホラホラホラ！
#. de: Kommt ihr noch hinterher?
#. fr: Nananère<nbsp>!
msgctxt "NpcYell:4287:0:13"
msgid "Nyah nyah!"
msgstr "На-на-на!"

#. ja: さて、この技で<br>イってみようカ！
#. de: Dann probieren wir mal was Neues!
#. fr: Essayons ça, pour voir<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4288:0:13"
msgid "What say we try<br>something new!?"
msgstr "Ну что, попробуем<br>кое-что новенькое!?"

#. ja: これでどうダイ？
#. de: Ich hab da noch ein Ass im Ärmel<nbsp>...
#. fr: Que dites-vous de ce petit tour<nbsp>?
msgctxt "NpcYell:4289:0:13"
msgid "And now, for my next trick..."
msgstr "А теперь — следующий фокус..."

#. ja: お母さん…<br>お母さん…
#. de: Mama?! Mama, nein ...
#. fr: Maman... Non, non... Maman...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4290:0:13"
msgid "Mama...<br>Mama, no..."
msgstr "Мама...<br>Мама, нет..."

#. ja: 攻撃開始！
#. de: Angriff!
#. fr: Chaaargeeez<nbsp>!!
msgctxt "NpcYell:4291:0:13"
msgid "Into the fray!"
msgstr "Вперёд, в бой!"

#. ja: うわぁ…<br>情けな！
#. de: Pah ... jämmerlich.
#. fr: Pfff... Lamentable<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4292:0:13"
msgid "...Now that's just<br>embarrassing."
msgstr "...Ну это уже<br>просто позор."

#. ja: 哀れ…
#. de: Wirklich schwach.
#. fr: Quelle pitié...
msgctxt "NpcYell:4293:0:13"
msgid "Pitiful..."
msgstr "Жалкое зрелище..."

#. ja: 自業自得でござる！
#. de: Das hast du dir selbst zuzuschreiben!
#. fr: Vous méritez une bonne correction<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4294:0:13"
msgid "You bring this fate<br>upon yourself!"
msgstr "Сами навлекли на себя<br>эту участь!"

#. ja: 何人来ようとも<br>同じこと！
#. de: Wie viele ihr auch seid, wir werden siegen!
#. fr: Même à un contre cent, nous vaincrons<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4295:0:13"
msgid "Be you one or many,<br>this battle is ours!"
msgstr "Хоть один вас, хоть сотня —<br>победа за нами!"

#. ja: やれやれ…
#. de: Hah, wie leicht zu durchschauen.
#. fr: C'était prévisible...
msgctxt "NpcYell:4296:0:13"
msgid "Predictable..."
msgstr "Предсказуемо..."

#. ja: かかって来い！
#. de: Na kommt doch!
#. fr: Venez un peu par ici<nbsp>!
msgctxt "NpcYell:4297:0:13"
msgid "Now we're talking!"
msgstr "Ну давай, нападай!"

#. ja: 覚悟はいい？
#. de: Jetzt gibt's Prügel!
#. fr: Attention, ça va faire mal<nbsp>!
msgctxt "NpcYell:4298:0:13"
msgid "This one'll sting!"
msgstr "Сейчас будет больно!"

#. ja: 手加減しないよ！
#. de: Nicht drängeln!
#. fr: J'vais pas y aller de main morte<nbsp>!
msgctxt "NpcYell:4299:0:13"
msgid "No holding back!"
msgstr "Не стану сдерживаться!"

#. ja: 逃がさないんだから！
#. de: Wer hat noch nicht?
#. fr: Inutile de fuir<nbsp>!
msgctxt "NpcYell:4300:0:13"
msgid "You're mine!"
msgstr "Тебе не уйти!"

#. ja: これで決めるっ！
#. de: Gleich tut's weh!
#. fr: Voilà le coup décisif<nbsp>!
msgctxt "NpcYell:4301:0:13"
msgid "Try this one!"
msgstr "А вот и это!"

#. ja: パパリモ、見ててよね！
#. de: Für dich, Papalymo!
#. fr: Je vais te rendre fier, Papalymo<nbsp>!
msgctxt "NpcYell:4302:0:13"
msgid "You watching, Papalymo?"
msgstr "Папалимо, смотри!"

#. ja: 根性みせちゃる！
#. de: Keine Gnade!
#. fr: C'est l'heure de faire ses preuves<nbsp>!
msgctxt "NpcYell:4303:0:13"
msgid "It's all over now!"
msgstr "Ну, держитесь!"

#. ja: 見切ったァ！
#. de: Spür meine Klinge!
#. fr: Hors de ma vue<nbsp>!
msgctxt "NpcYell:4304:0:13"
msgid "I have you!"
msgstr "Я тебя раскусил!"

#. ja: 斬り捨てご免ッ！
#. de: Der Gnadenstreich!
#. fr: Tranchons dans le vif<nbsp>!
msgctxt "NpcYell:4305:0:13"
msgid "'Tis my right to strike!"
msgstr "Именем самурайского закона — рублю!"

#. ja: 一刀入魂！
#. de: Ein Geist, ein Hieb!
#. fr: Subissez le courroux de ma lame<nbsp>!
msgctxt "NpcYell:4306:0:13"
msgid "With soul and steel!"
msgstr "Вложу душу в каждый удар!"

#. ja: この一太刀に賭けるでござる！
#. de: Die Seele des Kriegers!
#. fr: Ce coup sera le dernier<nbsp>!
msgctxt "NpcYell:4307:0:13"
msgid "This blow shall end you!"
msgstr "Этот удар станет последним!"

#. ja: これぞ、我が秘剣ッ！
#. de: Führe meine Klinge!
#. fr: Voici ma botte secrète<nbsp>!
msgctxt "NpcYell:4308:0:13"
msgid "None can stay my blade!"
msgstr "Никто не устоит перед моим клинком!"

#. ja: ドマ侍の意地を見よッ！
#. de: <i>So</i> kämpft ein Samurai!
#. fr: Craignez l'esprit des samouraïs domiens<nbsp>!
msgctxt "NpcYell:4309:0:13"
msgid "Look upon a samurai of Doma!"
msgstr "Вот он, самурай из Домы!"

#. ja: 退け！<br>撤退だッ！
#. de: Wir ziehen uns zurück!<br>Rückzug!
#. fr: Retraite<nbsp>! On se replie<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4310:0:13"
msgid "Pull back!<br>We must withdraw!"
msgstr "Назад!<br>Отступаем!"

#. ja: まさか挟撃だと！？
#. de: Wir werden von beiden Seiten angegriffen!
#. fr: Nous sommes cernés<nbsp>!
msgctxt "NpcYell:4311:0:13"
msgid "We've enemies on both sides!"
msgstr "Нас окружили с двух сторон!"

#. ja: 鉄仮面卿の命令だ！<br>奴らを排除せよ！
#. de: Der Greif hat gesprochen! Tötet sie alle!
#. fr: Tuez-les tous<nbsp>! Le Griffon vous l'ordonne<nbsp>!
msgctxt "NpcYell:4312:0:13"
msgid "The Griffin has spoken! Kill them all!"
msgstr "Грифон приказал! Убить их всех!"

#. ja: この先へは<br>行かせんぞ！
#. de: Keinen Schritt weiter!
#. fr: Halte-là<nbsp>!
msgctxt "NpcYell:4313:0:13"
msgid "You go no further!"
msgstr "Дальше не пройти!"

#. ja: 我らの作戦を<br>邪魔する気か！
#. de: Du wirst unseren Triumph nicht verhindern!
#. fr: Vous ne nous priverez pas de notre moment de gloire<nbsp>!
msgctxt "NpcYell:4314:0:13"
msgid "You'll not spoil our moment of glory!"
msgstr "Не смейте портить нам триумф!"

#. ja: 帝国軍もろとも<br>死ぬがいい！
#. de: Tod dem Kaiserreich!
#. fr: Mort aux Garlemaldais<nbsp>!
msgctxt "NpcYell:4315:0:13"
msgid "Death to the Empire!"
msgstr "Смерть Империи!"

#. ja: 退くぞ！
#. de: Rückzuuug!
#. fr: Retraite<nbsp>! Retraiiite<nbsp>!!
msgctxt "NpcYell:4316:0:13"
msgid "Retreeeat!"
msgstr "Отступаааем!"

#. ja: 信じられねぇ…
#. de: Was für ein Albtraum!
#. fr: Quel cauchemar...
msgctxt "NpcYell:4317:0:13"
msgid "This is some kind of nightmare..."
msgstr "Да это же настоящий кошмар..."

#. ja: なんて強力な<br>魔導アーマーだ…
#. de: Gegen diese Kampf<shy>maschinen kommt keiner an!
#. fr: Cette armure... Elle est indestructible<nbsp>!
msgctxt "NpcYell:4318:0:13"
msgid "That armor's unstoppable..."
msgstr "Эту броню не остановить..."

#. ja: 命あっての<br>物種だぜ…
#. de: Nur wer überlebt, kann Rache nehmen!
#. fr: Tant qu'il y a de la vie, il y a de l'espoir<nbsp>!
msgctxt "NpcYell:4319:0:13"
msgid "Live to fight another day..."
msgstr "Ничего, в другой раз повоюем..."

#. ja: 大物のお出ましだ！
#. de: Das ist ein Prachtexemplar!
#. fr: Voilà la grosse bête<nbsp>!
msgctxt "NpcYell:4320:0:13"
msgid "There she is, lads!"
msgstr "Вот и она, ребята!"

#. ja: みんな…<br>準備はいいな！
#. de: Denkt nicht mal dran, wegzurennen!
#. fr: Tout le monde est prêt<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4321:0:13"
msgid "Any one of you run,<br>and I'll gut you myself!"
msgstr "Только попробуйте сбежать — кишки выпущу!"

#. ja: おうよ！
#. de: Nicht im Traum, Boss!
#. fr: On y va<nbsp>!
msgctxt "NpcYell:4322:0:13"
msgid "Wouldn't think of it, boss!"
msgstr "И не подумали бы, босс!"

#. ja: 任せておけ！
#. de: Und auf meinen Teil der Beute verzichten? Niemals!
#. fr: Laissez-moi faire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4323:0:13"
msgid "And risk losin' me cut?<br>Not on yer life!"
msgstr "И лишиться своей доли?<br>Да ни за что!"

#. ja: いけるよ！
#. de: Wir kämpfen bis zum bitteren Ende!
#. fr: Pas de problème<nbsp>!
msgctxt "NpcYell:4324:0:13"
msgid "With you to the end, sir!"
msgstr "За вами хоть на край света, сэр!"

#. ja: やってやるぜ！
#. de: Wir schaffen das!
#. fr: À nous de jouer<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4325:0:13"
msgid "No man what wanted to<br>live would turn his back<br>on that there beast!"
msgstr "Никто, кто дорожит своей шкурой,<br>не повернётся спиной к такой твари!"

#. ja: 今だ、いくぞ！
#. de: Los! Jetzt!
#. fr: C'est parti<nbsp>!
msgctxt "NpcYell:4326:0:13"
msgid "Time to earn your keep!"
msgstr "Пора отработать своё!"

#. ja: マズい、逃げるよ！
#. de: Verdammt! Ich hab dich gemocht, Boss!
#. fr: Zut<nbsp>! On se replie<nbsp>!
msgctxt "NpcYell:4327:0:13"
msgid "You were always my favorite, boss!"
msgstr "Ты всегда был моим любимчиком, босс!"

#. ja: 撤退、撤退！！
#. de: Ihr könnt meinen Anteil haben!
#. fr: Il faut battre en retraite<nbsp>!
msgctxt "NpcYell:4328:0:13"
msgid "You can have me cut!"
msgstr "Забирайте мою долю!"

#. ja: ダメだこりゃ…
#. de: Das ist viel zu schwierig<nbsp>...
#. fr: C'est trop dur...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4329:0:13"
msgid "I'm fairly certain<br>this constitutes the end!"
msgstr "Кажется,<br>нам конец!"

#. ja: 命が惜しいからな…
#. de: Ich häng an meinem Leben!
#. fr: Je ne veux pas mourir ici<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4330:0:13"
msgid "Look! Over there!<br>No really, look!"
msgstr "Смотрите! Вон там!<br>Нет, правда, смотрите!"

#. ja: お、おい！<br>俺を置いていくな！
#. de: He! Lasst mich nicht zurück!
#. fr: Eh<nbsp>! Attendez-moi<nbsp>!
msgctxt "NpcYell:4331:0:13"
msgid "Why you craven sons of... Wait for me!!!"
msgstr "Ах вы трусливые ублюдки... Стойте!!!"

#. ja: 大きな獲物だ…<br>油断するなよ！
#. de: Das nenn ich mal fette Beute!<br>Seid auf der Hut!
#. fr: Ça, c'est ce que j'appelle une proie... Restez prudents<nbsp>!
msgctxt "NpcYell:4332:0:13"
msgid "Tonight, we'll dine like kings, friend!"
msgstr "Вот это добыча! Сегодня будем пировать, друг!"

#. ja: わかってる…<br>確実に倒すぞ！
#. de: Wir werden es braten und essen!
#. fr: Ne vous en faites pas, on va l'avoir<nbsp>!
msgctxt "NpcYell:4333:0:13"
msgid "I can smell the rump roasting already..."
msgstr "Уже чую запах жареной вырезки..."

#. ja: 仕掛ける場所を<br>決めなければ…
#. de: Wir sollten es von hinten überraschen.
#. fr: Hmm... Comment engager le combat<nbsp>?
msgctxt "NpcYell:4334:0:13"
msgid "An assault from the rear would provide us with the element of surprise..."
msgstr "Нападём сзади и застанем его врасплох..."

#. ja: 奥に引きこむのか？
#. de: Ja, dann sind wir im Vorteil!
#. fr: L'attirer au fond, peut-être<nbsp>?
msgctxt "NpcYell:4335:0:13"
msgid "From the rear. Right."
msgstr "Сзади. Ну да."

#. ja: お、おい…<br>はやく決めろよ
#. de: Moment<nbsp>... Das ist nicht hinten.
#. fr: Il faut se décider, et vite<nbsp>!
msgctxt "NpcYell:4336:0:13"
msgid "Wait... This ain't the rear."
msgstr "Погоди... Это же не сзади."

#. ja: 天候と地形を考慮して<br>決めなければ…
#. de: Wir müssen auch die Windrichtung berücksichtigen<nbsp>...
#. fr: Le temps et la topographie comptent aussi...
msgctxt "NpcYell:4337:0:13"
msgid "And we mustn't forget to consider wind direction..."
msgstr "И о направлении ветра забывать нельзя..."

#. ja: 頼りにしてるからな！
#. de: Wenn du es sagst<nbsp>...
#. fr: On va l'avoir, c'est sûr<nbsp>!
msgctxt "NpcYell:4338:0:13"
msgid "If you say so..."
msgstr "Ну, раз ты так говоришь..."

#. ja: よっしゃ！<br>俺たちの勝利だ！
#. de: Wir haben gesiegt!<br>Lasst uns den Kadaver ins Camp schleppen.
#. fr: Hourra<nbsp>! On a gagné<nbsp>!
msgctxt "NpcYell:4339:0:13"
msgid "Victory! Let us flay the beast and haul the carcass back to camp!"
msgstr "Победа! Сдерём с него шкуру и утащим тушу в лагерь!"

#. ja: 土産話には<br>もってこいだな！
#. de: So viel Blut <nbsp>...<br>Mir ist der Appetit vergangen.
#. fr: Je n'oublierai pas cette journée de sitôt<nbsp>!
msgctxt "NpcYell:4340:0:13"
msgid "All that blood... I think I've lost my appetite..."
msgstr "Кровищи-то... Что-то аппетит пропал..."

#. ja: 美味しいエサは<br>こっちだよ～！
#. de: Hier drüben Kleiner.<br>Hier gibt es lecker happa happa!
#. fr: Par ici la bonne pâture<nbsp>!
msgctxt "NpcYell:4341:0:13"
msgid "Over here, little one. I have some tasty leaves for you..."
msgstr "Сюда, малыш. У меня для тебя вкусные листочки..."

#. ja: 幼獣を捕獲するぞ！
#. de: Los! Schnapp ihn dir!
#. fr: Attrapez le petit<nbsp>!
msgctxt "NpcYell:4342:0:13"
msgid "Now! Grab him!"
msgstr "Сейчас! Хватай его!"

#. ja: ありゃ…<br>逃げちゃった
#. de: Mist! Entwischt<nbsp>...
#. fr: Il s'est enfui...
msgctxt "NpcYell:4343:0:13"
msgid "I don't know if this is going to work..."
msgstr "Не знаю, выйдет ли что-нибудь..."

#. ja: ヤバイ！<br>親が出てきたぞ！
#. de: Oh oh! Ist das Mama oder Papa?
#. fr: Ouah<nbsp>! C'est son père ou sa mère<nbsp>?
msgctxt "NpcYell:4344:0:13"
msgid "Thal's hoarfrosted balls! It's the mother!"
msgstr "Таловы яйца в инее! Это же мать!"

#. ja: くっ、出直すぞ！
#. de: Wir bringen das ein anderes Mal zu Ende!
#. fr: Ce sera pour une autre fois<nbsp>!
msgctxt "NpcYell:4345:0:13"
msgid "You can have me cut!"
msgstr "Забирайте мою долю!"

#. ja: 逃げろ！<br>逃げろ～！
#. de: Bleibt gefälligst hie... O je! Wartet auf mich!!!
#. fr: Fuyez<nbsp>! Fuyeeez<nbsp>!
msgctxt "NpcYell:4346:0:13"
msgid "Stand your ground, you whore-spawned shi─ Wait for me!!!"
msgstr "Не отступать, вы, дети шлюх... Чёрт, стойте!!!"

#. ja: キシャー！？
#. de: Ksss...
#. fr: Ksss...
msgctxt "NpcYell:4347:0:13"
msgid "Hiss..."
msgstr "Шипение..."

#. ja: キィキィ！
#. de: Hiii! Hiii!
#. fr: Hii<nbsp>! Hii<nbsp>!
msgctxt "NpcYell:4348:0:13"
msgid "\\<chitter>"
msgstr "<i>Ки-ки!</i>"

#. ja: キシャー！
#. de: Kssssss!
#. fr: Ksssssss...
msgctxt "NpcYell:4349:0:13"
msgid "Hissssss!"
msgstr "Ш-ш-ш-ш-ш!"

#. ja: ギギギギギ！
#. de: Kikikiki!
#. fr: Kikikiki<nbsp>!
msgctxt "NpcYell:4350:0:13"
msgid "\\<bark> \\<bark>"
msgstr "<i>Гав-гав!</i>"

#. ja: ウホッ！？
#. de: Ouh?
#. fr: Ouh<nbsp>?
msgctxt "NpcYell:4351:0:13"
msgid "Ooh?"
msgstr "Ух?"

#. ja: ウホウホッ！
#. de: Ouh ouh ouh!
#. fr: Ouh ouh ouh<nbsp>!
msgctxt "NpcYell:4352:0:13"
msgid "Ooh ooh! Ooh ooh! Ooh ooh!"
msgstr "Ух-ух! Ух-ух! Ух-ух!"

#. ja: ウホッ！
#. de: Ouh!
#. fr: Ouh<nbsp>!
msgctxt "NpcYell:4353:0:13"
msgid "Ooh ooh!"
msgstr "Ух-ух!"

#. ja: ウホッウホッー！
#. de: Ouh ouh aaah!
#. fr: Ouh ouh aaah<nbsp>!
msgctxt "NpcYell:4354:0:13"
msgid "Ooh ooh ah ahhh!"
msgstr "Ух-ух! А-а-а!"

#. ja: 地を巡る気と…
#. de: Kräfte der Erde ...
#. fr: Puissances de la terre...
msgctxt "NpcYell:4355:0:13"
msgid "From the heart of the mountain..."
msgstr "Из сердца гор..."

#. ja: 空を巡る気よ…
#. de: Kräfte des Himmels ...
#. fr: Puissances des cieux...
msgctxt "NpcYell:4356:0:13"
msgid "To the eye of the storm..."
msgstr "К самому глазу бури..."

#. ja: 清浄なる境を結べ…！
#. de: Schließt den schützenden Kreis!
#. fr: Consolidez les liens de la barrière protectrice<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4357:0:13"
msgid "So do the waters flow<br>till lasting bridges form."
msgstr "Пусть воды текут,<br>пока не сомкнутся крепкие мосты."

#. ja: こわいけど…がんばる！
#. de: Ich hab ein bisschen Angst ... aber ich schaff das schon!
#. fr: A-allez Arya, tu n'as pas peur...<nbsp>!
msgctxt "NpcYell:4358:0:13"
msgid "I'm a little frightened, but I can do this!"
msgstr "Мне немного страшно, но я справлюсь!"

#. ja: ひゃ、ひゃわっ！？
#. de: Aaaaah!
#. fr: Hiiiiii<nbsp>!
msgctxt "NpcYell:4359:0:13"
msgid "Wha─ Ah!"
msgstr "Чт— А!"

#. ja: この近辺に<br>属性の力が…
#. de: Dem Äthermessgerät zufolge muss es hier etliche Scherben geben<nbsp>...
#. fr: D'après mon éthéromètre, cet endroit regorge d'éclats irradiants...
msgctxt "NpcYell:4360:0:13"
msgid "According to the aetherometer, this area should be teeming with shards..."
msgstr "Судя по эфирометру, здесь полно осколков..."

#. ja: よし、充分な量が<br>集まりました！
#. de: Gut, damit haben wir für heute genug gesammelt!
#. fr: Très bien, je crois qu'il y en a assez comme ça<nbsp>!
msgctxt "NpcYell:4361:0:13"
msgid "Ah, that is quite enough for today!"
msgstr "А, на сегодня хватит!"

#. ja: この量では<br>今月のノルマが…
#. de: Ich bin ruiniert! Mit den paar Scherben hier kann man keinen Gilbeutel füllen!
#. fr: Ce n'est pas avec ça que je vais faire mon quota, moi...
msgctxt "NpcYell:4362:0:13"
msgid "I am ruined! There aren't enough shards here to fill a gil purse!"
msgstr "Я пропал! Столько осколков даже на кошель гилов не хватит!"

#. ja: さて、次はどの場所から<br>探索を始めよう…
#. de: Nun, an welchem Ort machen wir wohl am besten mit unserer Suche weiter<nbsp>...?
#. fr: Voyons voir, où est-ce que je vais trouver le prochain bon coin...
msgctxt "NpcYell:4363:0:13"
msgid "Very well, then. It is off to the next location."
msgstr "Что ж, пора отправляться на поиски в другое место."

#. ja: 放属性シャードの影響に<br>どうかご注意を！
#. de: Passt auf die Strahlung der Scherben auf!
#. fr: Attention aux élémentaires engendrés par les éclats<nbsp>!
msgctxt "NpcYell:4364:0:13"
msgid "On behalf of House Haillenarte, you have my thanks."
msgstr "От имени дома Эйленарт благодарю вас."

#. ja: ご協力、感謝します！
#. de: Danke für Eure Mithilfe!
#. fr: Prenez soin de vous, cet endroit est un véritable coupe-gorge<nbsp>!
msgctxt "NpcYell:4365:0:13"
msgid "And do take care on your journey home. The Diadem yet brims with peril."
msgstr "И будьте осторожны по дороге домой. На Диадеме всё ещё полно опасностей."

#. ja: 放属性シャードを<br>回収しています！
#. de: Haus Haillenarte bittet Abenteurer um Mithilfe beim Einsammeln der elementaraktiven Scherben.
#. fr: Aventurières, aventuriers, apportez-moi vos éclats irradiants<nbsp>!
msgctxt "NpcYell:4366:0:13"
msgid "Ye kindly adventurers! House Haillenarte is seeking aid in the collection of crystal shards!"
msgstr "Эй, добрые искатели приключений! Дому Эйленарт нужна помощь в сборе кристальных осколков!"

#. ja: こなくそ！
#. de: Verdammter Dreck!
#. fr: Putain<nbsp>!
msgctxt "NpcYell:4367:0:13"
msgid "Bloody hells!"
msgstr "Проклятье!"

#. ja: どりゃ！
#. de: Sterbt!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:4368:0:13"
msgid "Die, ye swivin' dogs!"
msgstr "Сдохните, псы шелудивые!"

#. ja: こんなところで<br>死んでたまるか…
#. de: Ich bereue nichts!
#. fr: Chienne de vie...
msgctxt "NpcYell:4369:0:13"
msgid "I regret nothing!"
msgstr "Я ни о чём не жалею!"

#. ja: 助かったぜ、冒険者<br>ありがとよ！
#. de: Danke! Das war Rettung in höchster Not!
#. fr: Quel pied, je suis vivant<nbsp>!
msgctxt "NpcYell:4370:0:13"
msgid "I'm...alive! Hah hah!"
msgstr "Я... жив! Ха-ха!"

#. ja: ヒィ！<br>また出た！
#. de: Nein, nicht noch einer!
#. fr: Il en arrive de partout<nbsp>!
msgctxt "NpcYell:4371:0:13"
msgid "Not another one!"
msgstr "Только не ещё один!"

#. ja: だ、誰か、お助けを！
#. de: H-Hilfe!<br>So hilf mir doch jemand!
#. fr: À l'aide<nbsp>! Au secours<nbsp>! Quelqu'un<nbsp>!
msgctxt "NpcYell:4372:0:13"
msgid "A thousand curses on that damnable whoreson!"
msgstr "Тысяча проклятий этому проклятому ублюдку!"

#. ja: うぅ、ご主人様…
#. de: Ungh<nbsp>... Ich<nbsp>...
#. fr: On se reverra sûrement là-haut...
msgctxt "NpcYell:4373:0:13"
msgid "I'll see you in the seventh hell..."
msgstr "Увижу тебя в седьмом аду..."

#. ja: た、助かりました…<br>修行して出直してきます
#. de: D-Das war knapp<nbsp>...
#. fr: Merci, merci, merci<nbsp>!
msgctxt "NpcYell:4374:0:13"
msgid "Many thanks, adventurer. And please...do not tell my master of this..."
msgstr "Большое спасибо, искатель приключений. Только... умоляю, не рассказывайте об этом моему хозяину..."

#. ja: 作戦失敗っちゃ…
#. de: Elende der elendsten Westländer! Ihr nicht das letzte Mal von uns hören!
#. fr: Plan avoir échoué...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4375:0:13"
msgid "Foulest of foul westlanders!<br>You've not heard last of us!"
msgstr "Грязнейшие из грязных западников!<br>Вы ещё о нас услышите!"

#. ja: 逃げるっちゃ…
#. de: Rennen! Rückzuuug!
#. fr: Qiqirns devoir fuir<nbsp>!
msgctxt "NpcYell:4376:0:13"
msgid "Run! Retreat! Fall back!"
msgstr "Бежим! Отступаем! Назад!"

#. ja: とんずらっちゃ！
#. de: Fliehen, ja?
#. fr: Retraite<nbsp>! Retraite<nbsp>!
msgctxt "NpcYell:4377:0:13"
msgid "Flee! Flee! Fleeeeee!"
msgstr "Бегите! Бегите! Беги-и-ите!"

#. ja: 邪魔するなっちゃ！
#. de: Du viel störst!
#. fr: Pas toucher coffres qiqirns<nbsp>!
msgctxt "NpcYell:4379:0:13"
msgid "Thub! Drub! Cuff!"
msgstr "Тьфу! Бей! Лупи!"

#. ja: 甲板に敵が…！
#. de: Da tut sich was auf dem Vorderdeck ...
#. fr: Il y a des créatures sur le pont<nbsp>!
msgctxt "NpcYell:4381:0:13"
msgid "Steady!"
msgstr "Спокойно!"

#. ja: 行くわよ！
#. de: Greift sie an!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:4382:0:13"
msgid "What are we waiting for?"
msgstr "Чего ждём?"

#. ja: 間違いない…<br>奴らを始末しろ！
#. de: Erledigt sie!
#. fr: Éliminez-les<nbsp>!
msgctxt "NpcYell:4383:0:13"
msgid "Seize them, before the Sekiseigumi come!"
msgstr "Хватайте их, пока не явились Сэкисэйгуми!"

#. ja: 死ねッ！
#. de: Stirb!
#. fr: À mort<nbsp>!
msgctxt "NpcYell:4384:0:13"
msgid "You're coming with us!"
msgstr "А ну за нами!"

#. ja: なに、後ろから<br>新手だと！？
#. de: Achtung, da sind noch mehr von denen!
#. fr: Attention<nbsp>! On est pris à revers<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4385:0:13"
msgid "Where did that brat<br>come from!?"
msgstr "Откуда этот малец<br>взялся!?"

#. ja: うおおッ！
#. de: Uaaaaah!
#. fr: Mouooooh<nbsp>!
msgctxt "NpcYell:4386:0:13"
msgid "Surrender or die!"
msgstr "Сдавайтесь или умрите!"

#. ja: （仮）演出：完全におまかせ。
#. de: 0
#. fr: 0
msgctxt "NpcYell:4387:0:13"
msgid "0"
msgstr "0"

#. ja: （仮）演出：すごいね！
#. de: 0
#. fr: 0
msgctxt "NpcYell:4388:0:13"
msgid "0"
msgstr "0"

#. ja: な、なんてことを！
#. de: Was soll denn das?
#. fr: Mais qu'est-ce qui se passe<nbsp>!?
msgctxt "NpcYell:4389:0:13"
msgid "What in the hells!?"
msgstr "Что за чертовщина!?"

#. ja: もうお終いだ…
#. de: Jetzt ist es aus!
#. fr: C'est la fin...
msgctxt "NpcYell:4390:0:13"
msgid "We're done for!"
msgstr "Нам конец..."

#. ja: いけいけぇー！
#. de: Los, macht sie fertig!
#. fr: Allez, à l'attaque<nbsp>! Cloportes<nbsp>!
msgctxt "NpcYell:4391:0:13"
msgid "Get after them, damn you!"
msgstr "За ними, чтоб вас!"

#. ja: 泣かしてやるど！
#. de: Lauf zu Mama!
#. fr: J'vais vous faire pleurer du sang<nbsp>!
msgctxt "NpcYell:4392:0:13"
msgid "You'll be weeping blood!"
msgstr "Будете кровавыми слезами плакать!"

#. ja: やっちまえーッ！
#. de: Endlich hab ich dich!
#. fr: CHAAAARGEZ<nbsp>!
msgctxt "NpcYell:4393:0:13"
msgid "Now I've gotcha!"
msgstr "Ну всё, попались!"

#. ja: ゆくぞい！
#. de: Lauf!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:4394:0:13"
msgid "Forward!"
msgstr "Вперёд!"

#. ja: 倒れろッ…！
#. de: Stirb!
#. fr: Abattez-les<nbsp>! Grrrr<nbsp>!
msgctxt "NpcYell:4395:0:13"
msgid "Finish it off!"
msgstr "Добейте!"

#. ja: 怯むなッ！<br>押して押して押しまくれ！
#. de: Weiter so! Nicht nachlassen!
#. fr: Ne reculez pas<nbsp>! En avant toute<nbsp>!
msgctxt "NpcYell:4396:0:13"
msgid "Send them to the Seventh Gate!"
msgstr "Не отступать! Давите, давите их!"

#. ja: さあ猛ろ、呪剣ティソーナよッ！
#. de: Tizona, entfessle deinen Zorn!
#. fr: Embrase-toi, Tizona<nbsp>!
msgctxt "NpcYell:4397:0:13"
msgid "Roar, Tizona!"
msgstr "Реви, Тизона!"

#. ja: これが猛牛流よ！！
#. de: Der Bulle von Ala Mhigo!
#. fr: La charge du taureau<nbsp>!
msgctxt "NpcYell:4398:0:13"
msgid "As a raging bull!"
msgstr "Вот что значит ярость быка!"

#. ja: ぬおわっ！？
#. de: Waaas? Das darf doch nicht ...
#. fr: Qu-qu-quoi<nbsp>!?
msgctxt "NpcYell:4399:0:13"
msgid "Uaaargh!?"
msgstr "Уа-а-а!?"

#. ja: 追い払えっちゃ！
#. de: Weg! Weg! Weg!
#. fr: Qiqirns défendre armes<nbsp>!
msgctxt "NpcYell:4400:0:13"
msgid "Slice! Dice! Flay!"
msgstr "Кромсать! Рубить! Сдирать шкуру!"

#. ja: む…仲間はどこだ？
#. de: Wo bleibt die Verstärkung?
#. fr: Qu'est-ce qu'il est en train de faire...<nbsp>?
msgctxt "NpcYell:4402:0:13"
msgid "Where are the reinforcements?"
msgstr "Где подкрепление?"

#. ja: う、うわっ…！？<br>どこに行ったんだ！
#. de: W-Wo sind sie hin?
#. fr: Hein<nbsp>!?
msgctxt "NpcYell:4403:0:13"
msgid "What the─ Are they shinobi!?"
msgstr "Какого... Это что, шиноби!?"

#. ja: ゲホッ…ゲホッ…<br>前が見えない…
#. de: \<hust> Ich kann nichts sehen!
#. fr: (tousse)... (tousse)... On n'y voit rien...
msgctxt "NpcYell:4404:0:13"
msgid "\\<cough> \\<cough> I can't see!"
msgstr "<i>Кхе-кхе!</i> <i>Кха!</i> Ничего не вижу!"

#. ja: 見失ったぞ！
#. de: Wir haben sie verloren!
#. fr: On les a perdus<nbsp>!
msgctxt "NpcYell:4405:0:13"
msgid "They escaped!"
msgstr "Упустили их!"

#. ja: 探せ、探せ！
#. de: Findet sie!
#. fr: Trouvez-les<nbsp>!
msgctxt "NpcYell:4406:0:13"
msgid "Search everywhere!"
msgstr "Ищите повсюду!"

#. ja: 見つけたぞ！
#. de: Hier sind sie!
#. fr: Par ici<nbsp>!
msgctxt "NpcYell:4407:0:13"
msgid "I found them!"
msgstr "Нашёл!"

#. ja: 大人しく<br>お縄につけい！
#. de: Du kommst brav mit mir mit!
#. fr: On ne bouge plus<nbsp>!
msgctxt "NpcYell:4408:0:13"
msgid "You are coming with me!"
msgstr "А ну, тихо и под арест!"

#. ja: こっちだよぉ～！
#. de: Hier ...... entlang!
#. fr: Par là<nbsp>!
msgctxt "NpcYell:4409:0:13"
msgid "Over here!"
msgstr "Сюда-а!"

#. ja: 見つからないようにねぇ～！
#. de: Seid ...... vorsichtig.
#. fr: Attention<nbsp>! Cachez-vous<nbsp>!
msgctxt "NpcYell:4410:0:13"
msgid "This way!"
msgstr "Осторожно! Не показывайтесь!"

#. ja: このナマズ…<br>すごい重いんだけど…
#. de: Gyodo wiegt mindestens eine Ponze ...
#. fr: Qu'est-ce qu'il est lourd, ce Namazu<nbsp>!
msgctxt "NpcYell:4411:0:13"
msgid "This Namazu's more heavy than he looks..."
msgstr "Этот намазу тяжелее, чем кажется..."

#. ja: ヌルヌルするし<br>生臭いし…もう…
#. de: Außerdem ist er glitschig und stinkt fürchterlich ...
#. fr: Et il sent le poisson pourri en plus<nbsp>!
msgctxt "NpcYell:4412:0:13"
msgid "He's also slimier and─\\<sniff> \\<sniff>─could really do with a bath..."
msgstr "Он ещё и склизкий... <i>Шмыг-шмыг...</i> ...и искупаться ему бы не помешало."

#. ja: 野営地に<br>魔物を近づけるな！
#. de: Das Lager wird angegriffen!
#. fr: Pas touche à nos provisions, sale bête<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4413:0:13"
msgid "Keep those things<br>away from the camp!"
msgstr "Не подпускайте этих тварей<br>к лагерю!"

#. ja: 大切な糧秣が<br>食い荒らされて…
#. de: Die wollen sich die Vorräte holen!
#. fr: Nos précieuses provisions...
msgctxt "NpcYell:4415:0:13"
msgid "Nigh half our rations...gone..."
msgstr "Почти половина наших припасов... пропала..."

#. ja: 迎え撃て！
#. de: Verteidigt den Proviant!
#. fr: Ne les laissez pas faire<nbsp>!
msgctxt "NpcYell:4416:0:13"
msgid "Watch for its bite!"
msgstr "Берегись, укусит!"

#. ja: うおお！
#. de: Auf sie!
#. fr: Aaaarrh<nbsp>!
msgctxt "NpcYell:4417:0:13"
msgid "Show it no mercy!"
msgstr "Не щади его!"

#. ja: 助かったぞ！<br>奮戦に感謝する！
#. de: Danke! Das war Rettung in letzter Sekunde!
#. fr: Bien joué, ils ne risquent pas de revenir de sitôt<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4419:0:13"
msgid "We would have been at a<br>loss without you, adventurer."
msgstr "Без тебя мы бы пропали,<br>авантюрист."

#. ja: グハッ…<br>こんな…ハズでは…
#. de: \<hust> Was ... Wie ...?
#. fr: Gouaargh... Non...
msgctxt "NpcYell:4423:0:13"
msgid "But...but how..."
msgstr "Но... как же..."

#. ja: シュー…<br>カリヤナの盗人め！
#. de: Elendesss Qalyana-Pack!
#. fr: Qalyanas de malheur<nbsp>! Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4424:0:13"
msgid "The Qalyana will pay<br>for their thievery!"
msgstr "Калияна заплатят<br>за свою воровскую выходку!"

#. ja: シュー…これで<br>姉妹を飾ってやれる！
#. de: Der Ritus issst gerettet!
#. fr: Ce sont mes sœurs qui vont être contentes<nbsp>! Ssss...
msgctxt "NpcYell:4425:0:13"
msgid "Sssisters, rejoice!"
msgstr "С-сёстры, ликуйте!"

#. ja: 荒れ狂え！<br>霊魂旋風脚！
#. de: Wüte, Hurrikan-Tritt!
#. fr: Prenez ça<nbsp>! Coup de pied ouragan<nbsp>!
msgctxt "NpcYell:4426:0:13"
msgid "Taste my fury!"
msgstr "Вкусите мой гнев!"

#. ja: そこだッ！<br>霊魂秘孔拳！
#. de: Spüre den Hauch des Gemetzels!
#. fr: Attention... Toucher massacreur<nbsp>!
msgctxt "NpcYell:4427:0:13"
msgid "Take this!"
msgstr "Получи!"

#. ja: 轟け、真霊波！
#. de: Mentale Welle, erhebe dich!
#. fr: Subissez mon... Onde spirituelle<nbsp>!
msgctxt "NpcYell:4428:0:13"
msgid "Let's see how strong you truly are!"
msgstr "Ну-ка посмотрим, чего ты на самом деле стоишь!"

#. ja: 友たちよ！<br>我が拳に宿れッ！
#. de: Kameraden! Verleiht meinen Fäusten Kraft!
#. fr: Camarades<nbsp>! Donnez votre force à mes poings<nbsp>!
msgctxt "NpcYell:4429:0:13"
msgid "It's time to unleash my true power!"
msgstr "Пора показать истинную силу!"

#. ja: 駆け抜けよ！<br>双豹撃！
#. de: Hörst du es? Das stille Brüllen?
#. fr: Écoutez... Hurlement silencieux<nbsp>!
msgctxt "NpcYell:4430:0:13"
msgid "Know the power of the coeurl!"
msgstr "Познай силу койрла!"

#. ja: 目指すは神の領域…<br>喰らえよ、壊神拳！
#. de: Berausche mich, Gewalt des Zerstörers!
#. fr: J'obtiens la... Force de Rhalgr<nbsp>!
msgctxt "NpcYell:4431:0:13"
msgid "This is far from over!"
msgstr "Это ещё не конец!"

#. ja: 練り上げる！<br>闘霊弾！
#. de: Spüre den Druck des zermalmenden Geistes!
#. fr: Sentez la... Rose de la destruction<nbsp>!
msgctxt "NpcYell:4432:0:13"
msgid "I spy a chink in your armor!"
msgstr "Вижу брешь в твоей защите!"

#. ja: 危険なグリフィンを<br>取り逃がすなんて…
#. de: Wie konnten wir ihn entkommen lassen?!
#. fr: Un jour, on l'aurrra...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4433:0:13"
msgid "You can run...er, fly, but you<br>cannot hide! We will have ourglory another day!"
msgstr "Убежать... то есть улететь можешь, а скрыться — нет!<br>Слава ещё будет нашей!"

#. ja: やった！<br>今夜の晩ご飯よ！
#. de: Sehr schön! Fürs Abendessen ist gesorgt!
#. fr: Youpi<nbsp>! Orrrganisons un banquet pour fêter ça<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4434:0:13"
msgid "Hah hah! We'll need a<br>bigger cookfire this night!"
msgstr "Ха-ха! Сегодня вечером придётся<br>развести костёр побольше!"

#. ja: ナーゴ姉さん直伝の<br>弓術なんだから！
#. de: Niemand spaßt mit der Erbin Nagoos!
#. fr: C'est M'Naago qui m'a appris à tirrrer, hé hé<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4435:0:13"
msgid "Straight and true...<br>Straight and true..."
msgstr "Ровно и метко...<br>Ровно и метко..."

#. ja: 当たれッ！
#. de: Pfeile los!
#. fr: Dans le mille<nbsp>!
msgctxt "NpcYell:4436:0:13"
msgid "Right between the eyes!"
msgstr "Прямо меж глаз!"

#. ja: マラウィ姉さん！<br>見て、グリフィンよ！
#. de: Sieh doch, M'mhalawi! Ein Greif!
#. fr: Regarrrde, M'mhalawi, un griffon<nbsp>!
msgctxt "NpcYell:4437:0:13"
msgid "There! A griffin!"
msgstr "Вон там! Грифон!"

#. ja: 痛たたた…<br>ごめん、下がるね…
#. de: Autsch ... Das war's für mich!
#. fr: Ouille, ça pique...
msgctxt "NpcYell:4438:0:13"
msgid "Forgive me, my sisters..."
msgstr "Простите меня, сёстры..."

#. ja: 悔しい…<br>実力不足だなんて…
#. de: Verdammt ... Ich bin zu schwach.
#. fr: Grrr, on n'est pas assez forrrtes...
msgctxt "NpcYell:4439:0:13"
msgid "I will be back! I swear it!"
msgstr "Я ещё вернусь! Клянусь!"

#. ja: もうダメ…<br>退かせてもらうわ
#. de: Ich kann nicht mehr. Verzeiht mir!
#. fr: Désolée, je me retirrre...
msgctxt "NpcYell:4440:0:13"
msgid "There is no shame in retreat!"
msgstr "Отступать не стыдно!"

#. ja: 樹人の群体を確認！<br>ヤツらを排除するぞ！
#. de: Diakkas gesichtet! Merzt sie aus!
#. fr: Débarrassons-nous de ces diakkas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4441:0:13"
msgid "Enemy sighted!<br>Move to intercept!"
msgstr "Враг замечен!<br>Перехватить его!"

#. ja: はいっ！
#. de: Zu Befehl!
#. fr: Oui chef<nbsp>!
msgctxt "NpcYell:4442:0:13"
msgid "Sir, yes, sir!"
msgstr "Так точно, сэр!"

#. ja: 了解！
#. de: Verstanden!
#. fr: À vos ordres<nbsp>!
msgctxt "NpcYell:4443:0:13"
msgid "Sir, yes, sir!"
msgstr "Так точно, сэр!"

#. ja: 突撃だー！
#. de: Angriff!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:4444:0:13"
msgid "Charge!"
msgstr "В атаку!"

#. ja: うおおお！
#. de: Harrr!
#. fr: Yaaaah<nbsp>!
msgctxt "NpcYell:4445:0:13"
msgid "For Ul'dah!"
msgstr "За Ульду!"

#. ja: いくぞおぉぉ！
#. de: Auf sie!
#. fr: C'est partiii<nbsp>!
msgctxt "NpcYell:4446:0:13"
msgid "For Gridania!"
msgstr "За Гриданию!"

#. ja: 加勢します！
#. de: Ich steh euch bei!
#. fr: Les renforts sont là<nbsp>!
msgctxt "NpcYell:4447:0:13"
msgid "R-Reporting for d-duty, sirs!"
msgstr "П-подкрепление к вашим услугам, с-сэр!"

#. ja: とうっ！
#. de: Haah!
#. fr: Haah<nbsp>!
msgctxt "NpcYell:4448:0:13"
msgid "Hah!"
msgstr "Ха!"

#. ja: やあっ！
#. de: Yaah!
#. fr: Yaah<nbsp>!
msgctxt "NpcYell:4449:0:13"
msgid "Yah!"
msgstr "Йа!"

#. ja: 受けてみろ！
#. de: Nimm das!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:4450:0:13"
msgid "Have at you!"
msgstr "Ну-ка, получи!"

#. ja: くっ…さすがだ…！
#. de: Ugh, nicht schlecht.
#. fr: C'était couru d'avance...
msgctxt "NpcYell:4451:0:13"
msgid "Ungh... I yield..."
msgstr "Ух... сдаюсь..."

#. ja: うおりゃっ！
#. de: He!
#. fr: Yaahaah<nbsp>!
msgctxt "NpcYell:4452:0:13"
msgid "Yaaargh!"
msgstr "Я-а-аргх!"

#. ja: でやぁ！
#. de: Grrr!
#. fr: Grraah<nbsp>!
msgctxt "NpcYell:4453:0:13"
msgid "Graaah!"
msgstr "Гра-а-а!"

#. ja: くらいやがれっ！
#. de: Friss das!
#. fr: Tu ne m'échapperas pas<nbsp>!
msgctxt "NpcYell:4454:0:13"
msgid "Try this!"
msgstr "Получай!"

#. ja: これでもかっ！
#. de: Und wie gefällt dir das?
#. fr: Qu'est-ce que tu dis de ça<nbsp>?
msgctxt "NpcYell:4455:0:13"
msgid "How about this!?"
msgstr "Ну как тебе такое?!"

#. ja: あんた…強いな…！
#. de: Verdammt ... bist du stark.
#. fr: <if $gn4>Elle<else>Il</if> est trop fort<if $gn4>e</if>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4456:0:13"
msgid "H-How can you<br>be so strong?"
msgstr "К-как ты<br>можешь быть таким сильным?"

#. ja: そこだ！
#. de: Da!
#. fr: Tiens<nbsp>!
msgctxt "NpcYell:4457:0:13"
msgid "There!"
msgstr "Вот ты где!"

#. ja: これぞ<br>イシュガルドの聖剣技！
#. de: Bei Halone!
#. fr: Halone, prête-moi ta force<nbsp>!
msgctxt "NpcYell:4458:0:13"
msgid "For the honor of Ishgard!"
msgstr "За честь Ишгарда!"

#. ja: さすがは英雄か…
#. de: <if $gn4>Eine wahre Heldin<else>Ein wahrer Held</if> ...
#. fr: Je n'ai rien pu faire...
msgctxt "NpcYell:4459:0:13"
msgid "Victory is yours, hero..."
msgstr "Победа за тобой, герой..."

#. ja: オラッ！
#. de: Oaaah!
#. fr: Rrraaah<nbsp>!
msgctxt "NpcYell:4460:0:13"
msgid "Yah!"
msgstr "Йа!"

#. ja: ハッ！
#. de: Ha!
#. fr: Hiyaah<nbsp>!
msgctxt "NpcYell:4461:0:13"
msgid "Hah!"
msgstr "Ха!"

#. ja: 衝撃に耐えれるか！？
#. de: Du hast meinem Angriff widerstanden?
#. fr: Encaisse un peu ça<nbsp>!
msgctxt "NpcYell:4462:0:13"
msgid "Can you withstand this?"
msgstr "Выдержишь вот это?"

#. ja: オラオラッ！
#. de: Haha!
#. fr: Ha ha ha<nbsp>!
msgctxt "NpcYell:4463:0:13"
msgid "Aha!"
msgstr "Ага!"

#. ja: まだまだァ！
#. de: Da geht noch mehr!
#. fr: C'est pas terminé<nbsp>!
msgctxt "NpcYell:4464:0:13"
msgid "Just getting started!"
msgstr "Это только начало!"

#. ja: こいつでトドメだ！
#. de: Das gibt dir den Rest!
#. fr: Voilà le coup de grâce<nbsp>!
msgctxt "NpcYell:4465:0:13"
msgid "You're mine!"
msgstr "Ты мой!"

#. ja: 逃さねェぜ！
#. de: Du entwischst mir nicht!
#. fr: Où tu vas comme ça<nbsp>!?
msgctxt "NpcYell:4466:0:13"
msgid "There's nowhere to run!"
msgstr "Тебе не сбежать!"

#. ja: 吹き荒べ、切り刻めッ！
#. de: Dich hau ich in Stücke!
#. fr: Ma lame aura raison de toi<nbsp>!
msgctxt "NpcYell:4467:0:13"
msgid "Storm scour you!"
msgstr "Пусть буря разорвёт тебя на части!"

#. ja: すべてを呑み込め…！
#. de: Das haut dich um!
#. fr: C'est fini<nbsp>! Tu n'en réchapperas pas<nbsp>!
msgctxt "NpcYell:4468:0:13"
msgid "Sand swallow you!"
msgstr "Пусть пески поглотят тебя!"

#. ja: 戦えて…<br>楽しかったぜ…
#. de: Das war ... ein guter Kampf!
#. fr: Merci... C'était le meilleur combat de toute ma vie...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4469:0:13"
msgid "It was everything...<br>I had hoped for..."
msgstr "Всё было...<br>как я и надеялся..."

#. ja: よりにもよって<br>魔物と出会うとは！
#. de: Muss das sein?
#. fr: Regardez, des monstres<nbsp>!
msgctxt "NpcYell:4470:0:13"
msgid "Shields up!"
msgstr "Щиты поднять!"

#. ja: またもや現れたか！
#. de: Schon wieder!
#. fr: En voilà d'autres<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4471:0:13"
msgid "Where are they<br>all coming from?"
msgstr "Да откуда<br>их столько берётся?"

#. ja: よし、排除するぞ！
#. de: Auf in den Kampf!
#. fr: Allez, on s'en débarrasse<nbsp>!
msgctxt "NpcYell:4472:0:13"
msgid "With me!"
msgstr "За мной!"

#. ja: 挟まれただと？
#. de: Wir sind umzingelt?
#. fr: On est encerclés<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4473:0:13"
msgid "They've lured<br>us into a trap!"
msgstr "Они заманили<br>нас в ловушку!"

#. ja: ありがたい！
#. de: Danke!
#. fr: Merci<nbsp>!
msgctxt "NpcYell:4474:0:13"
msgid "Pull it together, recruit!"
msgstr "Соберись, новобранец!"

#. ja: これで任務終了だ…<br>協力に感謝するぞ！
#. de: Meine Pflicht ist erfüllt. Vielen Dank.
#. fr: La patrouille est terminée. Merci pour votre aide<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4475:0:13"
msgid "The hills are safe once again.<br>The Resistance thanks you."
msgstr "Холмы снова в безопасности.<br>Сопротивление благодарит тебя."

#. ja: そのまま、走り続けるんだ！
#. de: Gut so! Rennt weiter!
#. fr: Courrez, et ne vous arrêtez pas<nbsp>!
msgctxt "NpcYell:4476:0:13"
msgid "This way!"
msgstr "Сюда!"

#. ja: 了解だ、アリゼー！
#. de: Verstanden, Alisaie!
#. fr: Comprrris, Alisaie<nbsp>!
msgctxt "NpcYell:4477:0:13"
msgid "Understood, Alisaie!"
msgstr "Поняла, Ализе!"

#. ja: 援軍か！
#. de: Verstärkung!
#. fr: Vous tombez bien<nbsp>!
msgctxt "NpcYell:4478:0:13"
msgid "Reinforcements!"
msgstr "Подкрепление!"

#. ja: よし、この勢いなら！
#. de: Jetzt geht's erst richtig los!
#. fr: On va y arriver<nbsp>!
msgctxt "NpcYell:4479:0:13"
msgid "We may just make it yet!"
msgstr "Может, ещё и выкарабкаемся!"

#. ja: さあ、出発だ！
#. de: Los geht's!
#. fr: En route<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4480:0:13"
msgid "We march.<br>You, take the rear guard."
msgstr "Выступаем.<br>Ты прикрывай тыл."

#. ja: どりゃ！
#. de: Ha!
#. fr: Yaah<nbsp>!
msgctxt "NpcYell:4481:0:13"
msgid "\\<grunt>"
msgstr "<i>Ха!</i>"

#. ja: オラオラ！
#. de: Heh!
#. fr: Viens-là, toi<nbsp>!
msgctxt "NpcYell:4482:0:13"
msgid "Not on my watch!"
msgstr "Не сегодня!"

#. ja: キキルン族め…
#. de: Verfluchte Ratten!
#. fr: Damnées boules de poils...
msgctxt "NpcYell:4483:0:13"
msgid "Bloody rats!"
msgstr "Проклятые крысолюды!"

#. ja: 農作物を守るには<br>どうしたら…
#. de: Was sollen wir essen, wenn es nichts zu ernten gibt?
#. fr: Comment protéger mon potager face à ça<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4484:0:13"
msgid "How's a man to eat if he's<br>without aught to harvest...?"
msgstr "Как же прокормиться, если<br>нечего собирать с полей?.."

#. ja: やったぞ！<br>作物を守り切ったんだ！
#. de: Die Felder sind sicher! Dank sei den Zwölf!
#. fr: Ha<nbsp>! On a réussi<nbsp>! La récolte est sauvée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4485:0:13"
msgid "Twelve be praised!<br>The fields are saved!"
msgstr "Хвала Двенадцати!<br>Урожай спасён!"

#. ja: うりゃ！
#. de: Har!
#. fr: Hmph<nbsp>!
msgctxt "NpcYell:4486:0:13"
msgid "Hngh!"
msgstr "Хнгх!"

#. ja: 冒険者さん！<br>お手伝いいただけませんか？
#. de: <if $gn4>Frau Abenteurerin<else>Herr Abenteurer</if>! Könntest du mir vielleicht helfen?
#. fr: Dites, vous ne voulez pas m'aider<nbsp>?
msgctxt "NpcYell:4487:0:13"
msgid "You! Yes, you!"
msgstr "Эй! Да, вы!"

#. ja: こんなにいっぱい！<br>助かりました～！
#. de: So viele Splitter! Das reicht für Wochen!
#. fr: Toutes ces pierres aiguisées... Youpi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4488:0:13"
msgid "With any luck, I'll be<br>spared my aunt's whip!"
msgstr "Авось тётка не станет<br>драть меня кнутом!"

#. ja: うぅ、数が足りません…<br>しょんぼり…
#. de: O weh, jetzt krieg ich was zu hören ...
#. fr: Avec une récolte aussi maigrrre, mes sœurs vont se moquer de moi...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4489:0:13"
msgid "Another night, another<br>ten lashes..."
msgstr "Ещё ночь — и ещё<br>десять ударов..."

#. ja: みなさん<br>頑張ってください！
#. de: Da vorne liegt einer!
#. fr: Venez à moi, petites pierres aiguisées...
msgctxt "NpcYell:4490:0:13"
msgid "There! Don't you see it!?"
msgstr "Вон! Разве не видите?!"

#. ja: 集めたら<br>持って来てください！
#. de: Ich warte hier!
#. fr: Si vous avez déjà trrrouvé des pierres, merci de me les apporter<nbsp>!
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:4491:0:13"
msgid "No, not there. <i>There</i>!"
msgstr "Нет, не там. <i>Вон там</i>!"

#. ja: 鋭い石片を<br>集めてくださいね！
#. de: Wenn ich nicht bald ein paar Splitter nach Hause bringe ...
#. fr: Regarrrdez, là-bas<nbsp>! J'en vois une<nbsp>!
msgctxt "NpcYell:4492:0:13"
msgid "Remember, only sharp ones!"
msgstr "Помните, нужны только острые!"

#. ja: 此度も勝者は<br>オロニル族なり！
#. de: Wir sind zum Siegen geboren!
#. fr: Les Oronir vaincront une fois de plus<nbsp>!
msgctxt "NpcYell:4493:0:13"
msgid "I shall be eldest!"
msgstr "Я стану старшим!"

#. ja: 我らブドゥガが制する！
#. de: Für die Ehre der Buduga!
#. fr: Gloire aux Buduga<nbsp>!
msgctxt "NpcYell:4494:0:13"
msgid "For the Buduga!"
msgstr "За Будуга!"

#. ja: ドタール族の意地だ！
#. de: Es ist der Wille der Götter!
#. fr: Rien ne résiste aux Dotharl<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4495:0:13"
msgid "The day belongs<br>to the Dotharl!"
msgstr "Сегодня победа<br>за Дотхард!"

#. ja: アハハハハッ！
#. de: Hahaha!
#. fr: AHAHAHAHA<nbsp>!
msgctxt "NpcYell:4496:0:13"
msgid "Bwahahahaha!"
msgstr "Бу-ха-ха-ха!"

#. ja: 行かせん！
#. de: Hier ist Endstation!
#. fr: Vous n'irez pas plus loin<nbsp>!
msgctxt "NpcYell:4497:0:13"
msgid "No you don't!"
msgstr "А ну стоять!"

#. ja: 男は拐え！
#. de: Schnappt euch die Männer!
#. fr: Ne tuez pas leurs hommes, ils peuvent servir<nbsp>!
msgctxt "NpcYell:4498:0:13"
msgid "Your men are ours!"
msgstr "Ваши мужчины теперь наши!"

#. ja: 勝つのは我々だ！
#. de: Wir werden gewinnen!
#. fr: À nous la victoire<nbsp>!
msgctxt "NpcYell:4499:0:13"
msgid "The Sun is all!"
msgstr "Солнце — наша сила!"

#. ja: 覇者の名誉にかけて！
#. de: Die Ehre des Sieges gebührt uns!
#. fr: Pour l'honneur<nbsp>!
msgctxt "NpcYell:4500:0:13"
msgid "Glory to the Sun!"
msgstr "Слава Солнцу!"

#. ja: うあッ…！
#. de: Uaaah!
#. fr: Ourgh...<nbsp>!
msgctxt "NpcYell:4507:0:13"
msgid "Ugh!"
msgstr "Ух!"

#. ja: また厄介なものを…
#. de: Schon wieder so eine lästige Schmeißfliege ...
#. fr: Pff... Trêve d'enfantillages.
msgctxt "NpcYell:4508:0:13"
msgid "What a bother..."
msgstr "Вот же досада..."

#. ja: アタシの決意の証だよ！
#. de: Jetzt bin ich dran!
#. fr: Tu vas la sentir passer<nbsp>!
msgctxt "NpcYell:4509:0:13"
msgid "Time to get serious!"
msgstr "Пора взяться всерьёз!"

#. ja: 馬鹿な…<br>余輩に負けなど…
#. de: Ugh ... das kann nicht wahr sein ...
#. fr: Non... Le Dieu-Soleil ne peut... chuter<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4510:0:13"
msgid "The Sun...cannot<br>be extinguished!"
msgstr "Солнце... не может<br>погаснуть!"

#. ja: こんなんじゃ…<br>まだ足りないだろ…
#. de: Ich war nicht ... tapfer genug ...
#. fr: Non... C'est trop tôt...
msgctxt "NpcYell:4511:0:13"
msgid "It...it is not enough..."
msgstr "Этого... этого мало..."

#. ja: アタシが相手だ！
#. de: Ich übernehme!
#. fr: Il va falloir me passer sur le corps<nbsp>!
msgctxt "NpcYell:4512:0:13"
msgid "You're mine!"
msgstr "Ты мой!"

#. ja: 決して行かせぬッ！
#. de: Ich werde sie um jeden Preis aufhalten!
#. fr: Mon corps est une muraille infranchissable<nbsp>!
msgctxt "NpcYell:4513:0:13"
msgid "None shall pass!"
msgstr "Никто не пройдёт!"

#. ja: 行け、勝利を掴め！
#. de: Geh! Schnapp dir den Sieg!
#. fr: La victoire est à portée de main<nbsp>!
msgctxt "NpcYell:4514:0:13"
msgid "Victory will be ours!"
msgstr "Победа будет за нами!"

#. ja: 必ず守ります…！
#. de: Ich werde euch beschützen!
#. fr: Resserrez les rangs<nbsp>!
msgctxt "NpcYell:4515:0:13"
msgid "I will not fail!"
msgstr "Я не подведу!"

#. ja: させるものか！
#. de: Ha! Versuch es ruhig!
#. fr: On ne va pas vous laisser gagner<nbsp>!
msgctxt "NpcYell:4516:0:13"
msgid "Quickly, quickly!"
msgstr "Быстрее, быстрее!"

#. ja: 阻止するッ！
#. de: Das lass ich nicht zu!
#. fr: Arrêtons-les<nbsp>!
msgctxt "NpcYell:4517:0:13"
msgid "Stop them!"
msgstr "Остановить их!"

#. ja: そこをどけぇッ！
#. de: Aus dem Weg!
#. fr: Poussez-vous<nbsp>!
msgctxt "NpcYell:4518:0:13"
msgid "Damn you!"
msgstr "Проклятье!"

#. ja: 頭を垂れよ！
#. de: In den Staub mit euch!
#. fr: Baissez la tête devant moi<nbsp>!
msgctxt "NpcYell:4519:0:13"
msgid "Kneel or die!"
msgstr "На колени — или смерть!"

#. ja: やらせはせんぞ！
#. de: Das werde ich verhindern!
#. fr: Empêchez-la de nuire<nbsp>!
msgctxt "NpcYell:4520:0:13"
msgid "Filthy savages!"
msgstr "Грязные дикари!"

#. ja: 叩けッ！
#. de: Schlagt zu!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:4521:0:13"
msgid "Down with you!"
msgstr "Падите!"

#. ja: おかげで<br>いっぱい集まりました！
#. de: Dank dir kann ich mich zu Hause blicken lassen!
#. fr: Grrrâce à vous, j'en ai un bon paquet<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4522:0:13"
msgid "I didn't think there were<br>this many in all the Fringes!"
msgstr "Не думал, что в Окраинах<br>их столько найдётся!"

#. ja: 本当に<br>ありがとうございました！
#. de: Vielen, vielen Dank!
#. fr: Merrrci<nbsp>! Merrrci, merrr... (tousse)
msgctxt "NpcYell:4523:0:13"
msgid "A thousand thanks!"
msgstr "Тысяча благодарностей!"

#. ja: 助かりました！<br>ありがとうございます！
#. de: Was für ein Kampf! Vielen Dank!
#. fr: Merrrci, <if $gn4>aventurière<else>aventurier</if><nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4524:0:13"
msgid "If I never see an antlion<br>again it will be too soon!"
msgstr "Только бы больше никогда не видеть этих муравьиных львов!"

#. ja: な、なんて大きいの！？
#. de: Gigantisch ...
#. fr: Qu'est-ce qu'il a avalé pour devenir aussi grrros<nbsp>!?
msgctxt "NpcYell:4526:0:13"
msgid "I hate antlions..."
msgstr "Ненавижу муравьиных львов..."

#. ja: 倒さないと<br>仲間が危ないわ！
#. de: Mein Stamm ist in Gefahr!
#. fr: Hors de notre territoire, monstrrre<nbsp>!
msgctxt "NpcYell:4527:0:13"
msgid "What did I do to deserve this?"
msgstr "За что мне всё это?"

#. ja: オラァ！
#. de: Nicht so stürmisch!
#. fr: Haaa<nbsp>!!!
msgctxt "NpcYell:4528:0:13"
msgid "Yaaargh!"
msgstr "А-а-а!"

#. ja: ぐあああ…
#. de: Guuuaaah!
#. fr: Gouaaaah...
msgctxt "NpcYell:4529:0:13"
msgid "Ugh..."
msgstr "Ух..."

#. ja: 殴り殺してやるぜ！
#. de: Jetzt gibt's Ramba-Zamba!
#. fr: Je vous tuerai tous de mes poings<nbsp>!
msgctxt "NpcYell:4530:0:13"
msgid "I'll pummel you dead!"
msgstr "Забью вас до смерти!"

#. ja: 逃げ場はないぜ！
#. de: Du entkommst uns nicht!
#. fr: Cherchez pas, on vous laissera pas vous enfuir<nbsp>!
msgctxt "NpcYell:4531:0:13"
msgid "There's nowhere to run!"
msgstr "Бежать вам некуда!"

#. ja: 炎の魔法で焼かれろ！
#. de: Brenne! Brenne!
#. fr: Brûlez<nbsp>!!
msgctxt "NpcYell:4532:0:13"
msgid "Burn!"
msgstr "Сожжение!"

#. ja: この人数相手にここまで！？
#. de: <if $gn4>Sie<else>Er</if> ist stärker als erwartet ...
#. fr: Comment autant d'intrus ont-ils pu passer inaperçus<nbsp>!?
msgctxt "NpcYell:4533:0:13"
msgid "This was supposed to be easy..."
msgstr "А ведь всё должно было пройти легко..."

#. ja: シュー…いたな！<br>今日こそ仕留めるぞ！
#. de: Da issst er! Heute kriegen wir ihn!
#. fr: Le voilà... Vengeance<nbsp>! Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4546:0:13"
msgid "Can you tassste the revenge<br>on your lipsss, my sssisters!?"
msgstr "Чуешь вкус мести, сёстры мои?<br>Ш-ш-ш!"

#. ja: シュー…姉妹の仇…<br>討てぬとは…！
#. de: Welch Ssschande ...
#. fr: Mes sœurs, je suis désolée... Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4548:0:13"
msgid "Our sssisters will<br>not be forgotten!"
msgstr "Наших сестёр<br>не забудут! Ш-ш-ш!"

#. ja: シュー…<br>姉妹の仇め！
#. de: Rache für unsere Ssschwestern!
#. fr: Pour mes sœurs<nbsp>! Ssss...
msgctxt "NpcYell:4549:0:13"
msgid "Hissssss!"
msgstr "Ш-ш-ш!"

#. ja: シュー…<br>しぶといヤツだ！
#. de: Ssstirb einen qualvollen Tod!
#. fr: Meurs, immonde créature<nbsp>! Ssss...
msgctxt "NpcYell:4550:0:13"
msgid "The Vira do not forgive!"
msgstr "Вира не прощают! Ш-ш-ш!"

#. ja: シュー…<br>我らは好きにする！
#. de: Uns ssschreibt niemand was vor!
#. fr: On fait ce qu'on veut<nbsp>! Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4551:0:13"
msgid "Thisss land is ours<br>to do as we please!"
msgstr "Эта земля наша —<br>будем делать что захотим! Ш-ш-ш!"

#. ja: シュー…<br>邪魔をするな！
#. de: Ausss dem Weg!
#. fr: Dégage<nbsp>! Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4552:0:13"
msgid "The rocksss will run<br>red with your blood!"
msgstr "Скалы покраснеют<br>от вашей крови! Ш-ш-ш!"

#. ja: シュー…<br>ヒトの子め！
#. de: Dämliche Katze!
#. fr: Sale <if $gn4>humaine<else>humain</if><nbsp>! Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4553:0:13"
msgid "I'll have your legs<br>for sssupper!"
msgstr "Пущу твои ноги<br>на ужин! Ш-ш-ш!"

#. ja: メ族の縄張りから<br>出て行きなさい！
#. de: Dies ist unser Land!
#. fr: Vous n'avez rien à fairrre ici<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4554:0:13"
msgid "You can leave on your<br>tails...or on your backs!"
msgstr "Убирайтесь с земли племени М!<br>Уползёте на хвостах... или унесут на спинах!"

#. ja: やった！<br>二度と来ないでよ！
#. de: Ha! Lasst euch hier nie wieder blicken!
#. fr: Et n'y revenez plus, serrrpents<nbsp>!
msgctxt "NpcYell:4555:0:13"
msgid "Tell your sisters of this day!"
msgstr "Расскажите сёстрам, что здесь было!"

#. ja: ま、まさか<br>負けるなんて…
#. de: Wie konnte das geschehen?
#. fr: Comment on a pu perrrdre...<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4556:0:13"
msgid "Back to the village! We must<br>plan our next attack!"
msgstr "Н-не может быть...<br>Мы проиграли..."

#. ja: 出て行きなさい！
#. de: Verschwindet hier!
#. fr: Allez, ouste<nbsp>!
msgctxt "NpcYell:4562:0:13"
msgid "Leave our lands!"
msgstr "Убирайтесь отсюда!"

#. ja: メ族の猟場を<br>荒らすな！
#. de: Ihr scheucht uns alle Tiere auf!
#. fr: Horrrs de nos terrains de chasse<nbsp>!
msgctxt "NpcYell:4563:0:13"
msgid "We will suffer you no longer!"
msgstr "Хватит разорять охотничьи угодья племени М!"

#. ja: 船室には<br>いかせませんよ！
#. de: Lasst sie bloß nicht unter Deck kommen!
#. fr: Vous n'irez pas dans les cabines<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4569:0:13"
msgid "We cannot allow<br>them below deck!"
msgstr "Мы не позволим<br>им попасть на нижнюю палубу!"

#. ja: 私のミゼリー号を<br>好きにはさせません！
#. de: Runter von meinem Schiff, Unholde des Meeres!
#. fr: Le Misère est à moi<nbsp>!!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4570:0:13"
msgid "Get those blasted<br>fiends off my ship!"
msgstr "Выметайтесь с моего корабля, мерзкие твари!"

#. ja: 舐めないでいただきたい！
#. de: Macht endlich kurzen Prozess mit ihnen!
#. fr: Finies les plai<shy>san<shy>te<shy>ries<nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:4571:0:13"
msgid "Have a care, <split \" \" 1><string $gs1></split>!"
msgstr "Не зевай, <split \" \" 1><string $gs1></split>!"

#. ja: なんだ…<br>新手の妖異か？
#. de: Ist das ... ein neuer Nichts<shy>gesand<shy>ter?
#. fr: Hmm<nbsp>!? Une créature du néant<nbsp>?
msgctxt "NpcYell:4572:0:13"
msgid "Disgusting creatures..."
msgstr "Отвратительные твари..."

#. ja: でえええい！
#. de: Blute!
#. fr: Tiens<nbsp>!
msgctxt "NpcYell:4575:0:13"
msgid "Bleed!"
msgstr "Кровавая расщелина!"

#. ja: ハッ！！
#. de: Hah!
#. fr: Twahaaa<nbsp>!
msgctxt "NpcYell:4576:0:13"
msgid "Hah!"
msgstr "Ха!"

#. ja: うおおおお！
#. de: Yaaarrrgh!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:4577:0:13"
msgid "Yaaarrrgh!"
msgstr "Я-а-а-ар!"

#. ja: つ、強い…
#. de: V-Verdammt ...
#. fr: <if $gn4>E-elle<else>I-il</if> est trop fort<if $gn4>e</if>...
msgctxt "NpcYell:4578:0:13"
msgid "Godsdammit..."
msgstr "Чёрт побери..."

#. ja: 何者なんだ…<br>強すぎる…
#. de: W-Wer bei den Sieben Höllen bist du?
#. fr: M-mais... Qui es-tu...<nbsp>?
msgctxt "NpcYell:4579:0:13"
msgid "Wh-Who the hells are you?"
msgstr "К-кто ты, к чёрту?"

#. ja: バカな…<br>一撃だと…
#. de: Unmöglich ...
#. fr: I-impossible... Comment a-t-il...<nbsp>!?
msgctxt "NpcYell:4580:0:13"
msgid "Impossible..."
msgstr "Невозможно..."

#. ja: 死ね！
#. de: Stirb!
#. fr: Meurs<nbsp>!
msgctxt "NpcYell:4581:0:13"
msgid "Die!"
msgstr "Сдохни!"

#. ja: 食らえ！
#. de: Nimm das!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:4582:0:13"
msgid "Try this!"
msgstr "Получай!"

#. ja: おりゃあああ！
#. de: Du gehörst mir!
#. fr: Je te tiens<nbsp>!
msgctxt "NpcYell:4583:0:13"
msgid "You're mine!"
msgstr "Ты мой!"

#. ja: げ、迎撃せよ！
#. de: Werft sie zurück!
#. fr: Gardez vos positions<nbsp>!
msgctxt "NpcYell:4585:0:13"
msgid "Stand your ground, dammit!"
msgstr "Держать строй, чёрт побери!"

#. ja: ここにも敵部隊が！？
#. de: Ein Hinterhalt!
#. fr: Attention<nbsp>! Il y a des ennemis ici aussi<nbsp>!
msgctxt "NpcYell:4586:0:13"
msgid "Ambush! Ambush!"
msgstr "Засада! Засада!"

#. ja: うおおおおッ！
#. de: Angriiiff!
#. fr: Ouoooooh<nbsp>!
msgctxt "NpcYell:4587:0:13"
msgid "Here it comes!"
msgstr "Вот и началось!"

#. ja: さあ、前進しよう！
#. de: Jawohl, nicht nachlassen!
#. fr: En avant<nbsp>!
msgctxt "NpcYell:4588:0:13"
msgid "That's the way! Let's move!"
msgstr "Так держать! Вперёд!"

#. ja: 大丈夫か？ペリム・ハウリム
#. de: Leichtfuß! Alles in Ordnung?
#. fr: Tiens bon, Perimu<nbsp>! On va te tirer de là<nbsp>!
msgctxt "NpcYell:4589:0:13"
msgid "Underfoot! We'll get ye out o' there."
msgstr "Под ногами! Вытащим тебя оттуда!"

#. ja: ナーゴ、大丈夫かな…
#. de: Hoffentlich ist Naago in Ordnung.
#. fr: J'espère que M'naago va bien...
msgctxt "NpcYell:4590:0:13"
msgid "I hope Naago's all right..."
msgstr "Надеюсь, с Нааго всё в порядке..."

#. ja: ここからが正念場じゃ！
#. de: Jetzt wird es ernst!
#. fr: Le moment de vérité est arrivé<nbsp>!
msgctxt "NpcYell:4591:0:13"
msgid "This is it, lads! Weapons!"
msgstr "Ну всё, ребята! Оружие наготове!"

#. ja: 壊神ラールガーよ<br>我らに力を！
#. de: Verleih mir Stärke, Rhalgr!
#. fr: Rhalgr, donne-nous ta force<nbsp>!
msgctxt "NpcYell:4592:0:13"
msgid "Rhalgr, grant me strength..."
msgstr "Ралгр, даруй мне силу..."

#. ja: 射抜いてみせる！
#. de: Jeder Pfeil ein Treffer ...
#. fr: Je vais les transpercer<nbsp>!
msgctxt "NpcYell:4593:0:13"
msgid "I do not aim with my eye..."
msgstr "Я целюсь не глазами..."

#. ja: シュー…<br>打ち払うのみ！
#. de: Wir werden sssiegen!
#. fr: La chasse est ouverte<nbsp>! Ssss...
msgctxt "NpcYell:4594:0:13"
msgid "We will not fail!"
msgstr "Не подведём! Ш-ш-ш!"

#. ja: ここまで接近を<br>許したというのか！？
#. de: Befreiungskämpfer? Hier?!
#. fr: Comment sont-ils arrivés jusqu'ici<nbsp>!?
msgctxt "NpcYell:4595:0:13"
msgid "Resistance forces!? Here!?"
msgstr "Бойцы Сопротивления!? Здесь?!"

#. ja: その程度か…<br>やはり軽いな
#. de: Pah, mehr hast du nicht drauf?
#. fr: C'est tout<nbsp>? Hmpf<nbsp>! Pitoyable...
msgctxt "NpcYell:4596:0:13"
msgid "So empty..."
msgstr "И это всё?.. Слабовато."

#. ja: 出撃した部隊は<br>何をやっている！
#. de: Wieso haben die Haupttruppen sie nicht aufgehalten?!
#. fr: Mais que fait l'unité d'interception<nbsp>!?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4597:0:13"
msgid "How did they slip<br>past our forces!?"
msgstr "Как они прошли<br>мимо наших войск!?"

#. ja: 死ねッ！
#. de: Stirb!
#. fr: Meeuuuurs<nbsp>!
msgctxt "NpcYell:4598:0:13"
msgid "Die!"
msgstr "Сдохни!"

#. ja: テヤッ！
#. de: Ngah!
#. fr: Graaaah<nbsp>!
msgctxt "NpcYell:4599:0:13"
msgid "Hrah!"
msgstr "Хра-а!"

#. ja: どうだッ！
#. de: Nimm das!
#. fr: Ça fait mal, hein<nbsp>?
msgctxt "NpcYell:4600:0:13"
msgid "How's that!?"
msgstr "Ну как тебе!?"

#. ja: 無間に繰り出される拳の雨…<br>見切れるか！百烈拳じゃ！
#. de: Es regnet Fäuste, Freundchen!
#. fr: On va voir si vous passerez entre les gouttes de mon averse ininterrompue de coups de poing<nbsp>!
msgctxt "NpcYell:4601:0:13"
msgid "Get your umbrellas out, 'cause it's gonna rain fists!"
msgstr "Доставайте зонты — сейчас кулаками ливанёт!"

#. ja: はぁはぁ…<br>まだまだやれるわよ！
#. de: Ich ... \<keuch> ... kann noch!
#. fr: J'en ai encore... dans le ventre<nbsp>!
msgctxt "NpcYell:4602:0:13"
msgid "\\<pant> Just getting started!"
msgstr "<i>Уф...</i> Я только разогрелась!"

#. ja: 怯えろ、雑魚どもが！
#. de: Achtung, Verstärkung!
#. fr: Tremblez devant nous<nbsp>!
msgctxt "NpcYell:4603:0:13"
msgid "Corpse scum! Brace yourselves for pain!"
msgstr "Мрази! Сейчас узнаете, что такое боль!"

#. ja: 修行の成果を見せてやる！
#. de: Zeigen wir ihnen, was wir gelernt haben!
#. fr: On va vous montrrrer combien l'en<shy>traî<shy>ne<shy>ment a été efficace<nbsp>!
msgctxt "NpcYell:4604:0:13"
msgid "Let's knock 'em off their feet!"
msgstr "Свалим их с ног!"

#. ja: 負けるわけには<br>いかないんだから！
#. de: Hier, aus der Trickkiste von <if $gn4>Schwester<else>Bruder</if> <split " " 1><string $gs1></split>!
#. fr: Pas question de perrrdre ce combat<nbsp>!
msgctxt "NpcYell:4605:0:13"
msgid "We cannot─will not─lose!"
msgstr "Мы не можем... нет, не проиграем!"

#. ja: 死ねえ！
#. de: Sterbt!
#. fr: Crève<nbsp>!
msgctxt "NpcYell:4606:0:13"
msgid "Die!"
msgstr "Сдохни!"

#. ja: 帝国兵器の威力を<br>みせてやる！
#. de: Spürt die Macht des Kaiserreichs!
#. fr: Les armes impériales auront raison de vous<nbsp>!
msgctxt "NpcYell:4607:0:13"
msgid "Feel the might of imperial weaponry!"
msgstr "Почувствуйте мощь имперского оружия!"

#. ja: これが新しい星導教の力だ！
#. de: Für den Tempel! Für Rhalgr!
#. fr: Le nouveau poing de Rhalgr triomphera<nbsp>!
msgctxt "NpcYell:4608:0:13"
msgid "Witness the power of the new Fist!"
msgstr "Узрите силу нового Кулака!"

#. ja: 今度こそ殺してやるぞ！
#. de: Ich schwöre, ich bring euch alle um!
#. fr: Cette fois-ci, je ne vais pas vous rater...
msgctxt "NpcYell:4609:0:13"
msgid "I'll get you this time!"
msgstr "На этот раз я вас прикончу!"

#. ja: これで巡回は終了だ<br>助かったよ…
#. de: Danke! Meine Patrouille endet hier.
#. fr: La patrouille est terminée. Merci<nbsp>!
msgctxt "NpcYell:4610:0:13"
msgid "The roads are quiet...for now."
msgstr "Дороги пока спокойны... Спасибо."

#. ja: ふたりとも死ぬんじゃないわよ！
#. de: Sterbt mir ja nicht, ihr beiden!
#. fr: Ne vous avisez pas de mourir, tous les deux<nbsp>!
msgctxt "NpcYell:4611:0:13"
msgid "Don't go dying in there, now!"
msgstr "Только попробуйте там умереть!"

#. ja: くっくっく…
#. de: Ohohoho ...
#. fr: Hin hin hin...
msgctxt "NpcYell:4612:0:13"
msgid "\\<hiss> Hm hm hm..."
msgstr "<i>Хе-хе-хе...</i>"

#. ja: むこうの塊を受け止めてくれ！
#. de: Zerstöre die Feuerbälle dort drüben!
#. fr: Occupe-toi de l'autre<nbsp>!
msgctxt "NpcYell:4613:0:13"
msgid "Catch the one over there!"
msgstr "Лови тот, что вон там!"

#. ja: そっちの塊を頼む
#. de: Kümmere dich um die anderen Feuerbälle!
#. fr: L'autre est pour toi<nbsp>!
msgctxt "NpcYell:4614:0:13"
msgid "That one is yours!"
msgstr "Этот — твой!"

#. ja: 間に合わなかったか…まずいぞ！
#. de: Wir haben es nicht geschafft, sie zu zerstören ... Das ist schlecht!
#. fr: Merde, on a été trop lents<nbsp>!
msgctxt "NpcYell:4615:0:13"
msgid "Ah! We were too slow!"
msgstr "Ах! Не успели!"

#. ja: この一太刀に<br>賭けるでござる！
#. de: Die Seele des Krieges ...
#. fr: Ce coup sera le dernier<nbsp>!
msgctxt "NpcYell:4616:0:13"
msgid "This blow shall end you!"
msgstr "Этот удар станет последним!"

#. ja: 腕前、とくと見よ！
#. de: So kämpft ein Domaner!
#. fr: Voilà comment on se bat<nbsp>!
msgctxt "NpcYell:4617:0:13"
msgid "Mark well and learn!"
msgstr "Смотрите и учитесь!"

#. ja: 潰れろ！
#. de: Elender!
#. fr: Meurs<nbsp>!
msgctxt "NpcYell:4618:0:13"
msgid "Enough!"
msgstr "Довольно!"

#. ja: 迎え撃つ！
#. de: Zum Angriff!
#. fr: Ils sont à nous<nbsp>!
msgctxt "NpcYell:4619:0:13"
msgid "We attack on our terms!"
msgstr "Мы встретим их здесь!"

#. ja: こちらから行くぞ！
#. de: Attacke!
#. fr: Prenons-les à deux<nbsp>!
msgctxt "NpcYell:4620:0:13"
msgid "Stay on the offensive!"
msgstr "Не сбавлять натиск!"

#. ja: 背後を取られた？
#. de: Ein Hinterhalt?
#. fr: Derrière nous<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4621:0:13"
msgid "I thought I told you<br>to watch our rear!"
msgstr "Я же велел прикрывать тыл!"

#. ja: 倒しきれるか？
#. de: Ganz schöner Brocken ...
#. fr: On peut y arriver<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4622:0:13"
msgid "I've never shied from<br>a challenge, and I'm not<br>about to start!"
msgstr "Я никогда не отступал перед испытаниями и сейчас не собираюсь!"

#. ja: 念には念を…
#. de: Vorsicht ist besser als Nachsicht.
#. fr: Concentration...
msgctxt "NpcYell:4623:0:13"
msgid "They could be hiding anywhere."
msgstr "Они могут прятаться где угодно."

#. ja: さあ、出発だ！
#. de: Vorwärts!
#. fr: On y va<nbsp>!
msgctxt "NpcYell:4624:0:13"
msgid "You take the rear, adventurer."
msgstr "Прикрывай тыл, искатель приключений."

#. ja: 反撃開始だ……！
#. de: Bereit für meinen Konter?
#. fr: C'est l'heure de la riposte<nbsp>!
msgctxt "NpcYell:4625:0:13"
msgid "Now where were we?"
msgstr "Ну, на чём мы остановились?"

#. ja: エーテル反応を検知<br>コマンド…受信中…
#. de: Ätherquelle geortet ... Erwarte Befehle ...
#. fr: Réaction éthérée détectée...<br>Commande en cours de réception...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4626:0:13"
msgid "Aetheric response detected.<br>Awaiting commands..."
msgstr "Обнаружен эфирный отклик.<br>Ожидание команд..."

#. ja: コンタクト可能域に進入<br>撃滅戦を開始
#. de: Objekt nähern ... Kampfmodus ein ...
#. fr: Intrusion dans le secteur de contact...<br>Ordre d'élimination initialisé...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4627:0:13"
msgid "Contact zone compromised.<br>Eradication measures initiated."
msgstr "Нарушена зона контакта.<br>Начаты меры по уничтожению."

#. ja: アラート発令を確認<br>攻撃フェーズに移行します
#. de: Alarm ausgelöst ... Angriffsmodus ...
#. fr: Alerte confirmée...<br>Phase d'attaque enclenchée...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4628:0:13"
msgid "Alert status acknowledged.<br>Initiating combat protocols."
msgstr "Тревога принята.<br>Запуск боевых протоколов."

#. ja: あの敵は何だ…？
#. de: Monster! Das waren Monster!
#. fr: Mais qui a pu faire ça<nbsp>!?<nbsp>...
msgctxt "NpcYell:4629:0:13"
msgid "What are those things...?"
msgstr "Что это за твари?.."

#. ja: 不覚…なんて敵だ…！
#. de: Verdammt ... Die sind zu stark<nbsp>...
#. fr: Quel adversaire<nbsp>!<nbsp>...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4630:0:13"
msgid "We was ambushed.<br>Never had a chance..."
msgstr "Нас застали врасплох.<br>Шансов не было..."

#. ja: 龍神バハムートの力よ！
#. de: Kraft des Drachengottes!
#. fr: Ô Bahamut, prête-moi ton pouvoir<nbsp>!
msgctxt "NpcYell:4631:0:13"
msgid "By the power of Bahamut!"
msgstr "Силой Бахамута!"

#. ja: 問答無用ッ！
#. de: Worte sind Lug und Täuschung!
#. fr: Les mots ne valent rien<nbsp>!
msgctxt "NpcYell:4632:0:13"
msgid "Words are air!"
msgstr "Слова — пустой звук!"

#. ja: どかねば斬るッ！
#. de: Flieht jetzt oder sterbt!
#. fr: Vous allez regretter d'être venus ici<nbsp>!
msgctxt "NpcYell:4633:0:13"
msgid "Liars!"
msgstr "Лжецы!"

#. ja: ゆくぞ！
#. de: Huar!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:4634:0:13"
msgid "Defend yourselves!"
msgstr "Защищайтесь!"

#. ja: み、見事…！
#. de: Ugh ...
#. fr: Bravo<nbsp>!
msgctxt "NpcYell:4635:0:13"
msgid "Ho, well struck!"
msgstr "О, метко!"

#. ja: これほどの<br>力が…！
#. de: Welche Kraft ...!
#. fr: Quelle force<nbsp>!
msgctxt "NpcYell:4636:0:13"
msgid "Such power!"
msgstr "Вот это сила!"

#. ja: なんとッ！
#. de: Nguh?
#. fr: Im<shy>pres<shy>sionnant<nbsp>!
msgctxt "NpcYell:4637:0:13"
msgid "Impressive!"
msgstr "Впечатляет!"

#. ja: 餓狼雪風…！
#. de: Eisiger Wind!
#. fr: Préparez-vous à subir un vent glacial<nbsp>!
msgctxt "NpcYell:4638:0:13"
msgid "Cower before the wind!"
msgstr "Трепещите перед ледяным ветром!"

#. ja: 餓狼月光…！
#. de: Licht des Mondes!
#. fr: Nul ne peut se cacher au clair de lune<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4639:0:13"
msgid "You cannot hide from<br>the moonlight!"
msgstr "От лунного света<br>не спрятаться!"

#. ja: 餓狼花車…！
#. de: Fallende Blüten!
#. fr: Le monde entier flotte comme des pétales...
msgctxt "NpcYell:4640:0:13"
msgid "All is fleeting..."
msgstr "Всё преходяще..."

#. ja: 牙を剥け…！<br>餓狼雪月花ッ…！
#. de: Schärft die Fänge ... Kraft von Schnee, Mond und Blütenregen!
#. fr: Vous allez goûter à ma technique secrète<nbsp>!
msgctxt "NpcYell:4641:0:13"
msgid "Be in awe of my hissatsu!"
msgstr "Трепещите перед моим секретным приёмом!"

#. ja: その武…<br>しかと見極めさせてもらった！
#. de: Diese Kampfkunst ... Sie hat euer Herz offenbart.
#. fr: Votre talent aux armes a parlé pour vous<nbsp>!
msgctxt "NpcYell:4642:0:13"
msgid "This one speaks true..."
msgstr "Этот воин не лжёт..."

#. ja: 私こそが帝国軍の<br>新たなる力！
#. de: Ich bin die neue Kraft des Kaiserreichs!
#. fr: Je suis la nouvelle arme de l'Empire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4643:0:13"
msgid "Behold the pinnacle of<br>magitek enhancement!"
msgstr "Узрите вершину<br>магитекового совершенствования!"

#. ja: ガレマール帝国…<br>万歳…！
#. de: Lang lebe der Kaiser!
#. fr: Longue vie... à l'Empereur<nbsp>!<nbsp>...
msgctxt "NpcYell:4644:0:13"
msgid "Glory to the Empire!"
msgstr "Слава Империи!"

#. ja: オオオ…海ヲ守ラネバ…<br>海ヲ…紅玉海ヲ…
#. de: ... Sie muss ... beschützt werden ... die Rubinsee ...
#. fr: Notre mer... La Mer de Rubis... doit être protégée<nbsp>!
msgctxt "NpcYell:4645:0:13"
msgid "Must be...protected. The Ruby Sea...must be protected..."
msgstr "Надо... защитить... Рубиновое море..."

#. ja: 海ノ底…<br>獄ノ蓋ヨ、開ケ…
#. de: Abgrund, öffne dich!
#. fr: Libérez les abysses<nbsp>!<nbsp>...
msgctxt "NpcYell:4646:0:13"
msgid "Abyss...open wide! Show them what it means to be afraid!"
msgstr "Бездна... раскройся! Покажи им, что такое страх!"

#. ja: 若キ命…<br>全テ我ガモノニ…
#. de: Deine Kraft ... Dein Leben<nbsp>... es gehört mir!
#. fr: Votre jeunesse... Vos vies... Elles sont miennes<nbsp>!
msgctxt "NpcYell:4647:0:13"
msgid "Your blood...your spirit...shall be mine!"
msgstr "Ваша кровь... ваш дух... будут моими!"

#. ja: ああ、紅玉姫！
#. de: Prinzessin!
#. fr: Princesse<nbsp>!
msgctxt "NpcYell:4648:0:13"
msgid "Your Highness!"
msgstr "Ваше высочество!"

#. ja: 姉は私が…<br>どうか妖異を祓って！
#. de: Ich kümmere mich um meine Schwester. Nimm dir den Dämon vor!
#. fr: Laissez-moi m'occuper de ma sœur<nbsp>! Renvoyez ces créatures au néant<nbsp>!
msgctxt "NpcYell:4649:0:13"
msgid "Leave my sister to me! See that the voidsent are banished!"
msgstr "Оставьте сестру мне! Изгоните чудовищ из Бездны!"

#. ja: 我ヲ怖レ<br>ソシテ、畏レヨ！
#. de: Verehre mich ... Fürchte mich<nbsp>...
#. fr: Craignez-moi... Abhorrez-moi... Haïssez-moi<nbsp>!
msgctxt "NpcYell:4650:0:13"
msgid "Fear me... Revere me... Worship me...!"
msgstr "Бойтесь меня... Почитайте меня... Поклоняйтесь мне...!"

#. ja: 誰か！<br>援護を頼めないか？
#. de: Haaallo? Kann mir vielleicht irgendjemand helfen?
#. fr: Au secours<nbsp>! Quelqu'un<nbsp>! Donnez-moi une épée<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4653:0:13"
msgid "Anyone!? Is there anyone<br>who might lend me their sword?"
msgstr "Есть кто-нибудь?!<br>Мечом не поможете?"

#. ja: 援護に感謝する！<br>どうにか生き延びたよ…
#. de: Die Be<shy>freiungs<shy>armee wird von deinen hehren Taten erfahren!
#. fr: Merci d'avoir éliminé ces chapulis<nbsp>! Je vais pouvoir rentrer au camp vivant<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4654:0:13"
msgid "The Resistance will hear of<br>your deeds here today, friend."
msgstr "Сопротивление узнает о твоём подвиге, друг."

#. ja: 何者だろうと<br>やられるわけには…！
#. de: Wir tun unser Bestes, Kapitän!
#. fr: Pas question de se laisser faire<nbsp>!
msgctxt "NpcYell:4655:0:13"
msgid "Down with you!"
msgstr "Сгинь!"

#. ja: いけ！<br>カーバンクル・オブシダン！
#. de: Auf sie, Karfunkel!
#. fr: Vas-y, Carbuncle obsidienne<nbsp>!
msgctxt "NpcYell:4656:0:13"
msgid "Have at them, Carbuncle!"
msgstr "Вперёд, карбункул!"

#. ja: させるもんですか！
#. de: Zurück ins Meer, du Ungeheuer!
#. fr: Ça va barder<nbsp>!
msgctxt "NpcYell:4657:0:13"
msgid "Not today!"
msgstr "Не сегодня!"

#. ja: 新しい細剣でッ！
#. de: Ich werde Urianger noch einmal für dieses Rapier danken müssen.
#. fr: Vous allez goûter de ma rapière<nbsp>!
msgctxt "NpcYell:4658:0:13"
msgid "More to test my blade on..."
msgstr "Ну и славно, будет на ком испытать клинок..."

#. ja: いっけぇ！
#. de: Nimm das!
#. fr: Et hop<nbsp>!
msgctxt "NpcYell:4659:0:13"
msgid "Take that!"
msgstr "Получай!"

#. ja: うおおお！
#. de: Uaaaah!
#. fr: Mouoooh<nbsp>!
msgctxt "NpcYell:4660:0:13"
msgid "Ngaaah!"
msgstr "А-а-а!"

#. ja: ハッ、セイッ！<br>とりゃああ！
#. de: Komm doch her!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:4661:0:13"
msgid "That all you got!?"
msgstr "И это всё, на что вы способны?!"

#. ja: 決めちゃる！
#. de: So langsam komme ich in Schwung!
#. fr: Et paf<nbsp>!
msgctxt "NpcYell:4662:0:13"
msgid "Heh heh, this is fun!"
msgstr "Ха-ха, вот это веселье!"

#. ja: この島はいったい…
#. de: Wo sind wir hier?
#. fr: Qu'est-ce que c'est que cette île<nbsp>!?
msgctxt "NpcYell:4663:0:13"
msgid "What is this place..."
msgstr "Что это за место..."

#. ja: 船は私たちに<br>任せて！
#. de: Wir bewachen das Schiff.
#. fr: On défend le navire<nbsp>!
msgctxt "NpcYell:4664:0:13"
msgid "We'll keep the ship safe."
msgstr "Мы корабль в обиду не дадим."

#. ja: 何度来たって<br>倒してやるから！
#. de: Wenn noch mehr kommen, werf ich sie wieder hochkant über Bord.
#. fr: Qu'ils viennent<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4665:0:13"
msgid "I almost want them<br>to come again..."
msgstr "Да я почти хочу, чтобы они<br>вернулись..."

#. ja: こんな島からは<br>早く離れよう…
#. de: Jetzt lass uns schnell von dieser Insel der Ungeheuer verschwinden.
#. fr: Partons de cette île au plus vite<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4666:0:13"
msgid "I should be glad to<br>leave this place..."
msgstr "Рад бы поскорее<br>убраться отсюда..."

#. ja: ありがとう<br>さすがの手並みね
#. de: Hier stranden so schnell keine Seefahrer mehr.
#. fr: Bravo<nbsp>! Belle dé<shy>mon<shy>stra<shy>tion<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4667:0:13"
msgid "And that's the end<br>of that chapter."
msgstr "Ну вот и всё, с этим покончено."

#. ja: ねえ、どんな相手だったの？
#. de: Erzähl schon! Wer hat uns hierhin gelockt?
#. fr: C'est quoi qui nous a attirés jusqu'ici<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4668:0:13"
msgid "Next time, I'm<br>coming with you!"
msgstr "В следующий раз я пойду<br>с тобой!"

#. ja: 協力に感謝しますよ…<br>おかげで修理は完了しました
#. de: Ist die Gefahr vorbei? Können wir ablegen?
#. fr: Merci de nous avoir débarrassés de ces choses<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4669:0:13"
msgid "Ah, I was just about<br>to go and fetch you..."
msgstr "А я уж собрался за вами..."

#. ja: 進メ！<br>囚人タチヨ…！
#. de: Vorwärts, Gefangene!
#. fr: Avancez, prisonniers<nbsp>!
msgctxt "NpcYell:4670:0:13"
msgid "Intruders... To arms!"
msgstr "Чужаки... К оружию!"

#. ja: アアアアア<br>助ケテ、助ケテ、助ケテ…
#. de: Ahhh, Hilfe, Hilfe!
#. fr: À l'aaaiiiideeee...
msgctxt "NpcYell:4671:0:13"
msgid "Release... Release..."
msgstr "Отпустите... Отпустите..."

#. ja: 新入リカ？<br>新入リナノカァ！？
#. de: Einer von uns ...
#. fr: Hmm<nbsp>? De nouveaux arrivants<nbsp>?
msgctxt "NpcYell:4672:0:13"
msgid "One of us..."
msgstr "Один из нас..."

#. ja: コ…殺シテクレ…
#. de: Töte mich ... Befreie mich ...
#. fr: T-tuez-les... Tuez-les tous<nbsp>!
msgctxt "NpcYell:4673:0:13"
msgid "Kill me... Set me free..."
msgstr "У-убейте меня... Освободите..."

#. ja: オオオオオオ…
#. de: Ooohhh ...
#. fr: Ooooh<nbsp>!
msgctxt "NpcYell:4674:0:13"
msgid "Whoooooo..."
msgstr "У-у-у-у-у..."

#. ja: キシャアアアア！
#. de: Aaahhh!
#. fr: Chhrrraaaah<nbsp>!
msgctxt "NpcYell:4675:0:13"
msgid "Aaaaaaaaah!"
msgstr "А-а-а-а-а!"

#. ja: うわっ…！
#. de: Uff!
#. fr: Ouah<nbsp>!<nbsp>...
msgctxt "NpcYell:4676:0:13"
msgid "Hurk!"
msgstr "Ух!"

#. ja: ベロジナ川が<br>見えてきたぞ…
#. de: Ah, der Velodyna!
#. fr: Voilà la Velodyna...
msgctxt "NpcYell:4677:0:13"
msgid "The Velodyna!"
msgstr "Вон и Велодина!"

#. ja: この川を渡れば<br>目的地まであと少し！
#. de: Wenn ich den überquert habe, ist es nur noch ein kurzes Stück.
#. fr: Une fois de l'autre côté, j'y serai presque<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4678:0:13"
msgid "Once across, I'll be but a<br>bell from my destination."
msgstr "Переберусь через реку — и до цели<br>останется рукой подать."

#. ja: だ、誰かッ！<br>助けて！
#. de: K-Kann mir jemand helfen?
#. fr: À l'aiiide<nbsp>!
msgctxt "NpcYell:4679:0:13"
msgid "Heeelllp!"
msgstr "П-помогите!"

#. ja: ありがとうございます<br>助かりました！
#. de: Vielen Dank! Jetzt komme ich rüber!
#. fr: Merci infiniment<nbsp>!
msgctxt "NpcYell:4680:0:13"
msgid "Finally, they are all gone."
msgstr "Наконец-то они все ушли."

#. ja: では、任務に戻りますね<br>失礼します！
#. de: Die Leute drüben warten sicher schon!
#. fr: Grâce à vous, je vais pouvoir délivrer mon message<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4681:0:13"
msgid "You...won't tell anyone<br>of this, will you? Good."
msgstr "Ты... никому об этом<br>не расскажешь, правда? Вот и хорошо."

#. ja: わ、わぁ！？
#. de: W-Was?
#. fr: H-hein<nbsp>?
msgctxt "NpcYell:4682:0:13"
msgid "Never mind, then!"
msgstr "Да неважно!"

#. ja: て、撤退します！
#. de: Die Übergabe muss warten!
#. fr: Aaaaah<nbsp>!
msgctxt "NpcYell:4683:0:13"
msgid "I'll find another way across!"
msgstr "Найду другой путь!"

#. ja: そこです！
#. de: Nimm das, du elender Fisch!
#. fr: Attention<nbsp>!
msgctxt "NpcYell:4684:0:13"
msgid "Knife goes in!"
msgstr "Вот тебе!"

#. ja: いきますよ！
#. de: Euch nehm ich aus!
#. fr: Là<nbsp>!
msgctxt "NpcYell:4685:0:13"
msgid "Guts come out!"
msgstr "Сейчас кишки выпущу!"

#. ja: 邪魔しないでくださいっ！
#. de: Macht den Weg frei!
#. fr: Ne me touche pas, sale monstre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4686:0:13"
msgid "Leave no fish stan─<br>Swimming! No fish swimming!"
msgstr "Ни одной рыбы не остав─<br>Не плывите! Рыбы не плывите!"

#. ja: おりゃ！
#. de: Nimm dies!
#. fr: Yaah<nbsp>!
msgctxt "NpcYell:4687:0:13"
msgid "Go for the roots!"
msgstr "Руби под корень!"

#. ja: ふんっ！
#. de: He!
#. fr: Hmph<nbsp>!
msgctxt "NpcYell:4688:0:13"
msgid "Graaah!"
msgstr "Хр-р!"

#. ja: ハッ！
#. de: Ha!
#. fr: Ha<nbsp>!
msgctxt "NpcYell:4689:0:13"
msgid "Hah!"
msgstr "Ха!"

#. ja: でやぁ！
#. de: Dahin, wo's wehtut!
#. fr: Raah<nbsp>!
msgctxt "NpcYell:4690:0:13"
msgid "Nnngh!"
msgstr "Н-н-нх!"

#. ja: 手強いぞ！
#. de: Ich geb nicht auf!
#. fr: C'est qu'il résiste<nbsp>!
msgctxt "NpcYell:4691:0:13"
msgid "The bark, it's too thick!"
msgstr "Кора у него слишком толстая!"

#. ja: V8…V8…
#. de: V-VIII ... Kritischer Fehler ...
#. fr: V8... V8...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4692:0:13"
msgid "Initiating Ice Break Protocol...<br>Critical failure...<br>Critical failure..."
msgstr "Запуск протокола «Ледолом»...<br>Критический сбой...<br>Критический сбой..."

#. ja: 砲撃開始！<br>足止めするんだ！
#. de: Feuer! Haltet sie auf!
#. fr: Feu à volonté<nbsp>! Il faut les immobiliser<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4693:0:13"
msgid "Man the cannons!<br>Suppressive fire!"
msgstr "К пушкам!<br>Прижмите их огнём!"

#. ja: 下がれ！<br>巻き込まれるぞ！
#. de: Zurück, sonst erwischt es uns auch!
#. fr: Repliez-vous<nbsp>! Vite<nbsp>!
msgctxt "NpcYell:4694:0:13"
msgid "Get to cover! Hurry!"
msgstr "В укрытие! Живо!"

#. ja: 食料の匂いを<br>嗅ぎつけられたか！
#. de: Der Essensgeruch muss sie angelockt haben!
#. fr: Ils ont senti l'odeur de la nourriture<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4695:0:13"
msgid "There! On the horizon!<br>Are those...bears!?"
msgstr "Вон там, на горизонте!<br>Это... медведи?!"

#. ja: もう二度と<br>近寄るんじゃないぞ！
#. de: Lasst euch das eine Lehre sein!
#. fr: Et n'y revenez plus<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4696:0:13"
msgid "Shovels, men! We need to<br>fill the latrines before this<br>happens again!"
msgstr "Лопаты, живо! Надо<br>засыпать отхожие места,<br>пока это не повторилось!"

#. ja: 押し返せ！
#. de: Treibt sie zurück!
#. fr: Tenez bon<nbsp>!
msgctxt "NpcYell:4698:0:13"
msgid "Back! Drive them back!"
msgstr "Назад! Гоните их!"

#. ja: お、俺たちの<br>飯が…！
#. de: U-Unser Essen!
#. fr: Qu'est-ce qu'on va manger, maintenant...<nbsp>?
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4701:0:13"
msgid "How are we to stand against<br>the Empire if we cannot best<br>a few bears!?"
msgstr "Н-но наша еда...!"

#. ja: ここは必ず守る！
#. de: Schützt den Proviant mit allen Mitteln!
#. fr: Va-t'en, sale bête<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4702:0:13"
msgid "Guard the trenches<br>with your lives, men!"
msgstr "Защищайте окопы<br>любой ценой!"

#. ja: いくぞ！<br>うおおおおおっ！
#. de: Ich kenn keine Gnade!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:4703:0:13"
msgid "Bloody murder!"
msgstr "Руби их в кровь!"

#. ja: やったぜ！<br>全部倒してやったぞ！
#. de: Haha! Alle verjagt!
#. fr: On a réussi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4704:0:13"
msgid "No spirit will dine on my<br>soul this day or any day!"
msgstr "Ни один дух сегодня, да и вообще никогда,<br>не полакомится моей душой!"

#. ja: ここで死ねるか！
#. de: Heut sterb ich nicht!
#. fr: Courage<nbsp>!
msgctxt "NpcYell:4705:0:13"
msgid "My soul is mine alone!"
msgstr "Не дождётесь моей смерти!"

#. ja: むっ！？
#. de: Hm?
#. fr: ... Hein<nbsp>?
msgctxt "NpcYell:4706:0:13"
msgid "Fish...?"
msgstr "Рыба?.."

#. ja: 怪魚の群れが！
#. de: Die sehen nicht sehr freundlich aus.
#. fr: Sale poiscaille<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:4707:0:13"
msgid "Fish!? No one told<br>me there would be <i>fish</i>!"
msgstr "Рыба?! А мне никто не сказал,<br>что тут будет <i>рыба</i>!"

#. ja: あわわわわ…
#. de: S-Sie kriechen aus dem Stein!
#. fr: Aaah<nbsp>! Ils sont partout<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4708:0:13"
msgid "They're crawling out of the<br>very rocks!"
msgstr "Они прямо из скал<br>выползают!"

#. ja: もっと早く<br>帰るべきだった…
#. de: Ich hätte auf meinen Vater hören sollen!
#. fr: J'aurais dû écouter mon père et partir plus tôt...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4709:0:13"
msgid "Why, oh why did I not heed<br>my father's warnings?"
msgstr "И зачем я не послушал<br>отца и не ушёл раньше?"

#. ja: 壊神ラールガーよ<br>お救いください！
#. de: Mächtiger Rhalgr, stehe mir bei!
#. fr: Ô puissant Rhalgr<nbsp>! Sauve-moi de ce mauvais pas<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4710:0:13"
msgid "Mighty Rhalgr,<br>send me your fists!"
msgstr "Могучий Ралгр,<br>направь на них кулаки свои!"

#. ja: ありがとうございました！<br>これで帰れます！
#. de: Sind sie ... wirklich weg?
#. fr: I-ils sont partis<nbsp>? Merci<nbsp>! Je vais enfin pouvoir rejoindre Ala Gannha<nbsp>!
msgctxt "NpcYell:4711:0:13"
msgid "Are they...truly gone?"
msgstr "Они... и правда ушли?"

#. ja: だ、だれか…<br>助けてくれないか？
#. de: H-Hat vielleicht jemand mal kurz Zeit?
#. fr: À l'aide, quelqu'un<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4712:0:13"
msgid "Is anyone out there!?<br>C-C-Can anyone hear me!?"
msgstr "Тут есть кто-нибудь?!<br>С-слышите меня?!"

#. ja: す、すまない…<br>逃げさせてもらうぞ！
#. de: I-Ich bin dann mal weg!
#. fr: Je préfère ne pas vous gêner... Bonne chance<nbsp>!
msgctxt "NpcYell:4714:0:13"
msgid "I c-c-can't watch anymore!"
msgstr "Я б-больше не могу на это смотреть!"

#. ja: ひ、ひぃ…！
#. de: B-Braves Bärchen ...
#. fr: Haaaa<nbsp>!
msgctxt "NpcYell:4715:0:13"
msgid "M-M-M-Mother!"
msgstr "М-м-мамочка!"

#. ja: やってやるぜ！
#. de: Auf sie!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:4716:0:13"
msgid "Give 'em hell!"
msgstr "Так вломим им!"

#. ja: うぉぉぉ！
#. de: Harrr!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:4717:0:13"
msgid "For the guild!"
msgstr "За гильдию!"

#. ja: 抜かりなくいくぞ！
#. de: Volle Kraft!
#. fr: Pas de quartier<nbsp>!
msgctxt "NpcYell:4718:0:13"
msgid "Hold nothing back!"
msgstr "Не сдерживайся!"

#. ja: つ、強すぎる…
#. de: Diese Stärke!
#. fr: Quelle force incroyable...
msgctxt "NpcYell:4719:0:13"
msgid "You've...grown strong..."
msgstr "Ты... стал таким сильным..."

#. ja: これは、敵わん…
#. de: Das ist zu viel für mich!
#. fr: Ils sont trop forts pour moi...
msgctxt "NpcYell:4720:0:13"
msgid "Mercy..."
msgstr "Пощады..."

#. ja: ううう…
#. de: Uuurrrggg ...
#. fr: J'ai échoué...
msgctxt "NpcYell:4721:0:13"
msgid "Urgh..."
msgstr "У-ух..."

#. ja: グググ…
#. de: Grrrrrr ...
#. fr: Grrrrr...
msgctxt "NpcYell:4722:0:13"
msgid "Urgh..."
msgstr "У-ух..."

#. ja: グガッ！
#. de: Graaarrr!
#. fr: Graaarrr<nbsp>!
msgctxt "NpcYell:4723:0:13"
msgid "Hagh!"
msgstr "Хах!"

#. ja: ガガグガァァァ！
#. de: Grrraaarrr!
#. fr: GrrRAAarRr<nbsp>!!!
msgctxt "NpcYell:4724:0:13"
msgid "Raaargh!"
msgstr "Р-р-ра-а-ар!"

#. ja: ウググググ…
#. de: Urrrggghhh!
#. fr: NrrrgGghhH...
msgctxt "NpcYell:4725:0:13"
msgid "Graaarghhh!"
msgstr "Гр-р-р-а-а!"

#. ja: ウガガガガ…
#. de: Gggrrr ...
#. fr: GgRRarrrh...
msgctxt "NpcYell:4726:0:13"
msgid "Die! Die! Diiieee!"
msgstr "Умри! Умри! Умри-и-и!"

#. ja: 太平のために！
#. de: Für den Frieden!
#. fr: La poursuite de la paix nous anime<nbsp>!
msgctxt "NpcYell:4727:0:13"
msgid "For peace!"
msgstr "За мир!"

#. ja: 裏切り者め！
#. de: Dreckiger Verräter!
#. fr: Traître<nbsp>!
msgctxt "NpcYell:4728:0:13"
msgid "Vile traitor!"
msgstr "Подлый предатель!"

#. ja: 恥を知れ！
#. de: Ihr seid eine Schande!
#. fr: Repens-toi<nbsp>!
msgctxt "NpcYell:4729:0:13"
msgid "Know your shame!"
msgstr "Постыдился бы!"

#. ja: でえええい！
#. de: Blute!
#. fr: Tiens<nbsp>!
msgctxt "NpcYell:4730:0:13"
msgid "Have at you!"
msgstr "Получи!"

#. ja: ハッ！！
#. de: Hyaaa!
#. fr: Twaah<nbsp>!
msgctxt "NpcYell:4731:0:13"
msgid "Hah!"
msgstr "Ха!"

#. ja: うおおおお！
#. de: Uarrrh!
#. fr: Uarrrh<nbsp>!
msgctxt "NpcYell:4732:0:13"
msgid "Yaaargh!"
msgstr "Я-а-ар!"

#. ja: 太平のために！
#. de: Ich verteidige den Frieden!
#. fr: Je suis le défenseur de la paix<nbsp>!
msgctxt "NpcYell:4733:0:13"
msgid "In the name of peace!"
msgstr "Во имя мира!"

#. ja: 国を護るのだ！
#. de: Ich schütze meine Heimat!
#. fr: Je protégerai ma patrie<nbsp>!
msgctxt "NpcYell:4734:0:13"
msgid "Our lives for the nation!"
msgstr "Жизнь за родину!"

#. ja: まだまだー！
#. de: Nicht so schnell ...
#. fr: C'est pas fini<nbsp>!
msgctxt "NpcYell:4735:0:13"
msgid "It isn't over yet!"
msgstr "Ещё не конец!"

#. ja: 大義のために！
#. de: Für die Gerechtigkeit!
#. fr: Pour la justice<nbsp>!
msgctxt "NpcYell:4736:0:13"
msgid "For the cause!"
msgstr "За наше дело!"

#. ja: ウゲツ様万歳！
#. de: Ruhm für Ugetsu!
#. fr: Gloire à Ugetsu<nbsp>!
msgctxt "NpcYell:4737:0:13"
msgid "Long live Lord Ugetsu!"
msgstr "Да здравствует господин Угэцу!"

#. ja: 死ねっ！
#. de: Stirb!
#. fr: Meurs<nbsp>!
msgctxt "NpcYell:4738:0:13"
msgid "Die!"
msgstr "Умри!"

#. ja: 乱世にはさせない！
#. de: Wir werden sie aufhalten!
#. fr: Nous ne vous laisserons pas faire<nbsp>!
msgctxt "NpcYell:4739:0:13"
msgid "Chaos will not prevail!"
msgstr "Не бывать хаосу!"

#. ja: ひんがしの国のために！
#. de: Für mein geliebtes Hingashi!
#. fr: Ma vie pour Hingashi<nbsp>!
msgctxt "NpcYell:4740:0:13"
msgid "For Hingashi!"
msgstr "За Хингаси!"

#. ja: 負けるものか！
#. de: Wir können nicht verlieren!
#. fr: Je ne faiblirai pas<nbsp>!
msgctxt "NpcYell:4741:0:13"
msgid "We will not  lose!"
msgstr "Мы не проиграем!"

#. ja: やぁっ！
#. de: Yaaah!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:4742:0:13"
msgid "Yah!"
msgstr "Йа!"

#. ja: せいやっ！
#. de: Nimm das!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:4743:0:13"
msgid "Take that!"
msgstr "Получай!"

#. ja: うおおおお！
#. de: Urrrooohhhr!
#. fr: UooOrRRhh<nbsp>!
msgctxt "NpcYell:4744:0:13"
msgid "Raaargh!"
msgstr "Р-р-ра-а-ар!"

#. ja: ぐはっ…
#. de: Ugh ...
#. fr: Beargh...
msgctxt "NpcYell:4745:0:13"
msgid "Ugh..."
msgstr "Ух..."

#. ja: もう…だめだ…
#. de: Das war's ...
#. fr: C'en est fini de moi...
msgctxt "NpcYell:4746:0:13"
msgid "No.. I must...stop him..."
msgstr "Нет... Я должен... остановить его..."

#. ja: 飛んでけ、オラの魂！
#. de: Steigt auf, meine Kräfte!
#. fr: Allez Gorge, vas-y<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4747:0:13"
msgid "I want to share<br>all my love with you."
msgstr "Хочу с тобой<br>любовью поделиться."

#. ja: 届け、オラの魂！
#. de: Erreicht ihn, meine Kräfte!
#. fr: Allez Gorge, tu peux l'faire<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4748:0:13"
msgid "I'll do anything for you.<br>You know I don't mind."
msgstr "Для тебя я на всё готов.<br>Ты же знаешь."

#. ja: 燃えよ、オラの魂！
#. de: Lodert auf, meine Kräfte!
#. fr: Allez Gorge, déchaîne-toi<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4749:0:13"
msgid "No one can deny<br>this love I have inside."
msgstr "Никто не помешает<br>любви, что в сердце пылает."

#. ja: これで、オラのすべてだ！
#. de: Ich hab alles mobilisiert!
#. fr: Allez Gorge, donne tout c'que tu as<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4750:0:13"
msgid "I'll give it all to you─<br>my endless love!"
msgstr "Отдам тебе всё, что есть, —<br>любовь свою без края!"

#. ja: やあ！
#. de: Ha!
#. fr: Yah<nbsp>!
msgctxt "NpcYell:4751:0:13"
msgid "Aaah!"
msgstr "А-а!"

#. ja: おりゃあ！
#. de: He!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:4752:0:13"
msgid "Graaah!"
msgstr "Гра-а!"

#. ja: もいっちょ！
#. de: Und nochmal!
#. fr: Encore<nbsp>!!
msgctxt "NpcYell:4753:0:13"
msgid "Just a little more..."
msgstr "Ещё немного..."

#. ja: これで最後だ！
#. de: Das ist euer Ende!
#. fr: Un dernier effort<nbsp>!
msgctxt "NpcYell:4754:0:13"
msgid "There! That should do it!"
msgstr "Вот! Теперь должно хватить!"

#. ja: これでも食らえ！
#. de: Nehmt dies!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:4755:0:13"
msgid "As always, my sweet!"
msgstr "Получай, как всегда, милый!"

#. ja: これならどうだ！
#. de: Wie ist das?
#. fr: Et que penses-tu d'ça<nbsp>?
msgctxt "NpcYell:4756:0:13"
msgid "Now you're mine!"
msgstr "Ну как тебе такое?"

#. ja: オラの方がつええ！
#. de: Ich bin stärker!
#. fr: C'est moi l'plus fort<nbsp>!
msgctxt "NpcYell:4757:0:13"
msgid "No, he's mine!"
msgstr "Нет, он мой!"

#. ja: そんな程度か！
#. de: Das ist alles?
#. fr: C'est tout ce dont tu es capable<nbsp>?
msgctxt "NpcYell:4758:0:13"
msgid "Ready, Curious Gorge?"
msgstr "Ну что, Любопытное Ущелье, готов?"

#. ja: まだまだだ！
#. de: Da geht noch was!
#. fr: Je ne suis pas im<shy>pres<shy>sion<shy>née<nbsp>!
msgctxt "NpcYell:4759:0:13"
msgid "Now you're mine!"
msgstr "Теперь ты мой!"

#. ja: いんや、オラの方がつええ！
#. de: Nein, ich bin stärker!
#. fr: Non, c'est moi la plus forte<nbsp>!
msgctxt "NpcYell:4760:0:13"
msgid "No, he's mine!"
msgstr "Нет, он мой!"

#. ja: ひれ伏すのだ！
#. de: Auf den Boden!
#. fr: À genoux<nbsp>!
msgctxt "NpcYell:4761:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: 死ぬがいい！
#. de: Stirb!
#. fr: Meurs<nbsp>!
msgctxt "NpcYell:4762:0:13"
msgid "Die!"
msgstr "Умри!"

#. ja: 天罰を食らえ！
#. de: Das ist deine Strafe!
#. fr: Soyez châtiés<nbsp>!
msgctxt "NpcYell:4763:0:13"
msgid "Nnngraaahhh!"
msgstr "Нннгааа!"

#. ja: はぁ、はぁ、はぁ…<br>危なかった…
#. de: Puh, das war knapp ...
#. fr: Ouf, c'est pas passé loin...
msgctxt "NpcYell:4764:0:13"
msgid "Why... Oh, why...?"
msgstr "Почему... ну почему?.."

#. ja: 傷を治さないと…！
#. de: Wir müssen alle Wunden heilen!
#. fr: Je vais vous soigner<nbsp>!
msgctxt "NpcYell:4765:0:13"
msgid "We must heal our wounds!"
msgstr "Надо залечить раны!"

#. ja: こんなもんだろ！
#. de: Ha!
#. fr: Hmpf<nbsp>!
msgctxt "NpcYell:4766:0:13"
msgid "Hmph!"
msgstr "Хм!"

#. ja: くらえ、脇差し！
#. de: Nimm das!
#. fr: Yaah<nbsp>!
msgctxt "NpcYell:4767:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: おりゃっ！
#. de: Grrah!
#. fr: Horyaah
msgctxt "NpcYell:4768:0:13"
msgid "Grah!"
msgstr "Грр!"

#. ja: 見切れまい！
#. de: Stirb!
#. fr: Mourez<nbsp>!
msgctxt "NpcYell:4769:0:13"
msgid "Die!"
msgstr "Умри!"

#. ja: いくぞ！
#. de: Nehmt das!
#. fr: À l'attaque<nbsp>!
msgctxt "NpcYell:4770:0:13"
msgid "Begone!"
msgstr "Прочь!"

#. ja: 斬る！
#. de: Spürt meine Klinge!
#. fr: Goûtez à ça<nbsp>!
msgctxt "NpcYell:4771:0:13"
msgid "Worthless!"
msgstr "Ничтожество!"

#. ja: 気合いを入れるぜ！
#. de: Na warte!
#. fr: Pas mal<nbsp>!
msgctxt "NpcYell:4772:0:13"
msgid "Raaah!"
msgstr "Рааа!"

#. ja: はああああッ！
#. de: Raaah!
#. fr: Raaaah<nbsp>!
msgctxt "NpcYell:4773:0:13"
msgid "Hyaaah!"
msgstr "Хьяяя!"

#. ja: ていやああああ！
#. de: Angriff!
#. fr: Graaaah<nbsp>!
msgctxt "NpcYell:4774:0:13"
msgid "Graaah!"
msgstr "Гррааа!"

#. ja: こいよ！<br>猪鹿蝶！
#. de: Eure Leben flattern davon!
#. fr: Venez à moi, ailes délicates<nbsp>!
msgctxt "NpcYell:4775:0:13"
msgid "On fluttering wings!"
msgstr "На крыльях бабочки!"

#. ja: いでよ！<br>雲蒸竜変！
#. de: Hört ihr die Drachen brüllen?
#. fr: Que rugisse le dragon<nbsp>!
msgctxt "NpcYell:4776:0:13"
msgid "As the dragon roars!"
msgstr "Рёв дракона!"

#. ja: ワォーン！
#. de: Grrr!
#. fr: (aboie) (aboie)...
msgctxt "NpcYell:4777:0:13"
msgid "\\<growl>"
msgstr "<i>А-у-у!</i>"

#. ja: ワンワン！
#. de: Grooaar!
#. fr: (aboie) (aboie)
msgctxt "NpcYell:4778:0:13"
msgid "\\<growl>"
msgstr "<i>Гав-гав!</i>"

#. ja: こ、心づけじゃ！<br>そ～れ！
#. de: Gleich seid ihr tot! Hahahahah!
#. fr: Tue-les, Yojimbo<nbsp>! Tue-les tous<nbsp>! Ha ha ha<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4779:0:13"
msgid "Kill them, Yojimbo!<br>Kill them all! Hahahahaha!"
msgstr "Убей их, Ёдзимбо!<br>Всех до одного! Ха-ха-ха-ха!"

#. ja: ぐぬぬ、勿体ないが<br>しかたな～い！
#. de: Grrr ...<br>Mein ganzes Vermögen ...!
#. fr: C'est tout ce qui me reste<nbsp>! Ne me déçois pas, Yojimbo<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4780:0:13"
msgid "This is the last of my savings.<br>Do not fail me, Yojimbo!"
msgstr "Это все мои сбережения.<br>Не подведи меня, Ёдзимбо!"

#. ja: 銭のことなら…<br>まかせておけ～い！
#. de: J-Ja, einen Moment ... Ich bringe es ja!
#. fr: D'accord<nbsp>! Un instant, s'il te plaît<nbsp>!
msgctxt "NpcYell:4781:0:13"
msgid "R-Right! Give me just a moment..."
msgstr "Д-да! Минутку..."

#. ja: 時間を<br>稼がせてもらうぞ！
#. de: Kageyama! Wo ist mein Sold?!
#. fr: Kageyama<nbsp>! Où est l'argent qui m'est dû<nbsp>?
msgctxt "NpcYell:4782:0:13"
msgid "Kageyama! Where is my payment?"
msgstr "Кагэяма! Где мои деньги?"

#. ja: ひ、ひぃ～<br>これで、どうかご勘弁を～！
#. de: Bitte, so zeig doch ein Einsehen! Ich habe sonst nichts mehr!
#. fr: P-pitié<nbsp>! C'est tout ce qu'il me reste...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4783:0:13"
msgid "P-Please, have mercy!<br>This is all I have left..."
msgstr "П-пощадите!<br>Больше у меня ничего нет..."

#. ja: やっぱり、お化けは苦手…
#. de: Gespenster sind wirklich nicht meine Stärke ...!
#. fr: J-je déteste cet endroit<nbsp>!
msgctxt "NpcYell:4784:0:13"
msgid "No...I don't like this place at all."
msgstr "Нет... Мне тут совсем не по себе."

#. ja: 大丈夫ですか！？
#. de: Alles in Ordnung!?
#. fr: Ça va<nbsp>!?
msgctxt "NpcYell:4785:0:13"
msgid "Speak to me!"
msgstr "Ответь мне!"

#. ja: うわあぁぁ…！
#. de: Aaah!
#. fr: Ouahhh<nbsp>!
msgctxt "NpcYell:4786:0:13"
msgid "O Rhalgr..."
msgstr "О Ралгр..."

#. ja: 助けてくれぇ！
#. de: Hilfe!
#. fr: À l'aide<nbsp>!!
msgctxt "NpcYell:4787:0:13"
msgid "Help us..."
msgstr "Помогите..."

#. ja: ヒ、ヒィ…<br>命だけは…！
#. de: Gnaaade!
#. fr: Haaa<nbsp>! Pitiééé...<nbsp>!
msgctxt "NpcYell:4788:0:13"
msgid "Not like this..."
msgstr "Н-не убивайте..."

#. ja: まだ逃げ遅れてる<br>人たちが…！
#. de: Da hinten sind noch welche!
#. fr: Il y en a qui n'ont pas pu s'enfuir...<nbsp>!
msgctxt "NpcYell:4789:0:13"
msgid "There are others who need us!"
msgstr "Там ещё люди! Им нужна помощь!"

#. ja: クッ…戦況は<br>思わしくないようだな…
#. de: Es sieht nicht gut aus ...
#. fr: Ça se présente mal...
msgctxt "NpcYell:4790:0:13"
msgid "It's worse than I feared..."
msgstr "Всё хуже, чем я думал..."

#. ja: 反逆者どもめッ！
#. de: Tod den Aufständischen!
#. fr: Salauds de rebelles<nbsp>!
msgctxt "NpcYell:4791:0:13"
msgid "Rebel scum!"
msgstr "Проклятые мятежники!"

#. ja: あ、ありがとうございます
#. de: Hab tausend Dank!
#. fr: Merci<nbsp>!
msgctxt "NpcYell:4792:0:13"
msgid "Gods bless you!"
msgstr "Да хранят вас боги!"

#. ja: 助かった…のか…？
#. de: Dir verdanke ich mein Leben!
#. fr: Vous êtes venus... nous sauver<nbsp>?
msgctxt "NpcYell:4793:0:13"
msgid "Reinforcements...?"
msgstr "Подкрепление?.."

#. ja: 仲間が…<br>仲間が…！
#. de: Meine Freunde! Sie sind alle ...
#. fr: Non... Mes amis...<nbsp>!
msgctxt "NpcYell:4794:0:13"
msgid "My brothers... My brothers..."
msgstr "Братья мои... Братья мои..."

#. ja: 反乱分子は<br>皆殺しにしろッ！
#. de: Undankbare Drecks-Mhigiten!
#. fr: Les rebelles peuvent tous crever<nbsp>!
msgctxt "NpcYell:4795:0:13"
msgid "No quarter!"
msgstr "Никого не щадить!"

#. ja: 殺せ殺せ！
#. de: Lasst keinen am Leben!
#. fr: Qu'ils crèvent<nbsp>! Qu'ils crèvent tous<nbsp>!
msgctxt "NpcYell:4796:0:13"
msgid "Kill them all!"
msgstr "Убить их всех!"

#. ja: ここにもいたか<br>蛮族どもめ！
#. de: Hier hat sich noch einer von den Wilden versteckt!
#. fr: Il en restait, des sauvageons<nbsp>!
msgctxt "NpcYell:4797:0:13"
msgid "More savages!?"
msgstr "Ещё дикари!?"

#. ja: アラミゴ人は<br>根絶やしだッ！
#. de: Sie widern mich an, diese staubigen Mhigiten!
#. fr: Faites vos prières, Mhigois<nbsp>!
msgctxt "NpcYell:4798:0:13"
msgid "No Ala Mhigan is to be spared!"
msgstr "Не щадить ни одного аламигца!"

#. ja: 無事か？
#. de: Ist alles in Ordnung?
#. fr: Ça va<nbsp>?
msgctxt "NpcYell:4799:0:13"
msgid "Are we saved?"
msgstr "Мы спасены?"

#. ja: 救援、感謝する！
#. de: Das war Rettung im letzten Moment.
#. fr: Les renforts... Enfin<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4800:0:13"
msgid "Rhalgr watch over<br>and keep you!"
msgstr "Пусть Ралгр хранит вас!<br>Да пребудет с вами его защита!"

#. ja: 進もう！
#. de: Vorwärts!
#. fr: En avant<nbsp>!
msgctxt "NpcYell:4801:0:13"
msgid "Forward!"
msgstr "Вперёд!"

#. ja: この戦…<br>本意ではないが…
#. de: Das ist nicht unser Krieg ...
#. fr: Ce combat, c'est pas ce qu'on voulait...
msgctxt "NpcYell:4802:0:13"
msgid "We have our orders!"
msgstr "Таков наш приказ!"

#. ja: 恨みはないが…<br>許せよ…
#. de: Uns bleibt keine andere Wahl<nbsp>...
#. fr: Désolé, y a rien de personnel...
msgctxt "NpcYell:4803:0:13"
msgid "I take no joy in this..."
msgstr "Мне это не в радость..."

#. ja: 人狼族とは…<br>ともかく次だ！
#. de: Mit den Wolfsmännern werden wir fertig.
#. fr: Des hommes-loups...<nbsp>? C'est pas un problème<nbsp>!
msgctxt "NpcYell:4804:0:13"
msgid "Bloody wolfmen..."
msgstr "Проклятые волколюды..."

#. ja: こんなものか…
#. de: Das war es schon?
#. fr: Voilà qui est intéressant...
msgctxt "NpcYell:4805:0:13"
msgid "Hm. I see..."
msgstr "Хм. Понятно..."

#. ja: 猛牛流を<br>見せてやるッ！
#. de: Ruhm der Legion!
#. fr: Gloire aux Immortels<nbsp>!
msgctxt "NpcYell:4806:0:13"
msgid "For the glory of the Flames!"
msgstr "За славу Пламени!"

#. ja: よし、数がそろったぞ！<br>手伝い、ありがとうよ！
#. de: Hast ordentlich Federn gelassen, was? Buwaha!
#. fr: C'est bon<nbsp>! J'ai ce qui m'faut en plumes de griffon<nbsp>! Merci bien<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4807:0:13"
msgid "Reckon I'll be seeing you<br>again, my featherless friend!"
msgstr "Ещё увидимся,<br>мой бескрылый друг!"

#. ja: 遅い…<br>遅すぎるぞ…！
#. de: Wo bleibt sie nur? Wo bleibt sie nur?
#. fr: Qu'est-ce qu'il fait, bon sang...
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:4808:0:13"
msgid "Where <i>are</i> they!?"
msgstr "Где <i>же</i> они!?"

#. ja: フフフ…
#. de: Hahaha ...
#. fr: Hé hé hé...
msgctxt "NpcYell:4809:0:13"
msgid "Hm hm hm..."
msgstr "Хм-хм-хм..."

#. ja: きみの力が欲しい…
#. de: Gib mir deine Kraft!
#. fr: Je veux ton pouvoir...
msgctxt "NpcYell:4810:0:13"
msgid "Your power will be mine..."
msgstr "Твоя сила станет моей..."

#. ja: 僕は不滅さ…
#. de: Ich bin unsterblich!
#. fr: Je suis imbattable<nbsp>!
msgctxt "NpcYell:4811:0:13"
msgid "You cannot kill me."
msgstr "Тебе меня не убить."

#. ja: 顕現維持、不能…
#. de: H0l0gr@mm ... k@nn n!cht @ufr3cht 3rh@lt3n w3rd3n ...
#. fr: Maintien impossible...
msgctxt "NpcYell:4812:0:13"
msgid "Manifestations unsustainable..."
msgstr "Проявление нестабильно..."

#. ja: ガガ…ガ…コロス…
#. de: \<piep> ... T3rmInI3r3n ...
#. fr: Bvrrr... Tuer...
msgctxt "NpcYell:4813:0:13"
msgid "\\<buzz> Exterminate..."
msgstr "<i>Бз-з-з...</i> Уничтожить..."

#. ja: ガ…ガ…
#. de: \<ratter> ... \<klack> ...
#. fr: Bvrrr... Bvrrr...
msgctxt "NpcYell:4814:0:13"
msgid "\\<buzz> \\<beeeeeep>"
msgstr "<i>Бз-з... Биии-и-и...</i>"

#. ja: この辺りはっと…
#. de: Weiter im Text.
#. fr: Ouvrons l'œil, et le bon<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4816:0:13"
msgid "Stay alert. Some will<br>hide in plain sight."
msgstr "Будьте начеку. Некоторые<br>прячутся у всех на виду."

#. ja: シュー…<br>命の輝きを我が身に！
#. de: Das Licht desss Lebens erfülle mich!
#. fr: À moi l'éclat de la vie<nbsp>! Ssss...
msgctxt "NpcYell:4817:0:13"
msgid "Render unto us Your light!"
msgstr "Даруй нам свой свет!"

#. ja: ホッホッホ
#. de: Ho ho ho!
#. fr: Ho ho ho<nbsp>!
msgctxt "NpcYell:4818:0:13"
msgid "Ho ho ho!"
msgstr "Хо-хо-хо!"

#. ja: なかなかの余興
#. de: Was für ein Spektakel!
#. fr: Quel spectacle<nbsp>!
msgctxt "NpcYell:4819:0:13"
msgid "A fine spectacle."
msgstr "Вот это зрелище!"

#. ja: もっとやれい！
#. de: Zerfetzt <if $gn4>sie<else>ihn</if>!
#. fr: Déchiquetez-<if $gn4>la<else>le</if><nbsp>!
msgctxt "NpcYell:4820:0:13"
msgid "Fight harder, you lot!"
msgstr "Давайте, бейте сильнее!"

#. ja: 捻り潰しておしまい！
#. de: Zerquetscht <if $gn4>sie<else>ihn</if>!
#. fr: Fais-en de la pâté<nbsp>!
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:4821:0:13"
msgid "Tear <if $gn4>her<else>him</if> apart!"
msgstr "Разорви <if $gn4>её<else>его</if> на части!"

#. ja: ヴァナラちゃん、その調子！
#. de: Weiter so, mein süßes Vanara!
#. fr: Continue comme ça, ma petite Vanara<nbsp>!
msgctxt "NpcYell:4822:0:13"
msgid "Good vanara! Good vanara!"
msgstr "Хорошая ванара! Хорошая ванара!"

#. ja: ああっ！
#. de: Ahh! Nein!
#. fr: Ah<nbsp>! Non<nbsp>!
msgctxt "NpcYell:4823:0:13"
msgid "Ahhh!"
msgstr "А-а-а!"

#. ja: やってしまえい！
#. de: Schaff sie mir vom Hals!
#. fr: Débarrasse-moi de ces deux-là<nbsp>!
#. macro: <if $gn4>her<else>him</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
#. macro: <if $gn4>her<else>his</if> — shows the first branch when the condition holds, otherwise the branch after <else>; condition = global number 4 (1 when the player character is female, 0 when male) (condition: may be reworded, restructured, added, or dropped)
msgctxt "NpcYell:4824:0:13"
msgid "Put <if $gn4>her<else>him</if> out of <if $gn4>her<else>his</if> misery!"
msgstr "Избавь меня от <if $gn4>её<else>его</if> мучений!"

#. ja: なにをしておる！
#. de: Was machst du denn da?
#. fr: Mais à quoi joues-tu<nbsp>!?
msgctxt "NpcYell:4825:0:13"
msgid "What are you doing!?"
msgstr "Да что ты творишь!?"

#. ja: 早く片付けよっ！
#. de: Warum dauert das so lange?
#. fr: Dépêche-toi d'en finir avec eux<nbsp>!
msgctxt "NpcYell:4826:0:13"
msgid "Hurry up and finish it!"
msgstr "Живее, прикончите их!"

#. ja: ガアアアアッ！
#. de: WUAAAAAARGH!
#. fr: GRAAAAAAH<nbsp>!
msgctxt "NpcYell:4827:0:13"
msgid "DIEEE!"
msgstr "Умри-и-и!"

#. ja: 力ガ、ミナギル！
#. de: ICH BIN STARK!
#. fr: JE SUIS INVINCIBLE<nbsp>!
msgctxt "NpcYell:4828:0:13"
msgid "RIP AND TEAR!"
msgstr "РВУ И МЕТАЮ!"

#. ja: 戦ウ、モット！
#. de: KLEINHOLZ MACHEN!
#. fr: Je vais... TOUT TRONÇONNER<nbsp>!
msgctxt "NpcYell:4829:0:13"
msgid "MORE, MORE, MORE!"
msgstr "ЕЩЁ! ЕЩЁ! ЕЩЁ!"

#. ja: 喰ラエ、喰ラエ、喰ラエ！
#. de: STIRB, STIRB! STIIIRB!
#. fr: Feu<nbsp>! Feu<nbsp>! FEUUU<nbsp>!
msgctxt "NpcYell:4830:0:13"
msgid "BWAHAHAHA!"
msgstr "БВА-ХА-ХА-ХА!"

#. ja: 集中攻撃だッ！
#. de: Frontalangriff!
#. fr: Attaque générale<nbsp>!
msgctxt "NpcYell:4833:0:13"
msgid "As one!"
msgstr "Все вместе!"

#. ja: 邪魔だ…
#. de: Weg mit dem Ungeziefer!
#. fr: Hors de ma vue...
msgctxt "NpcYell:4834:0:13"
msgid "Begone!"
msgstr "Прочь!"

#. ja: きゃあッ！
#. de: Aaah!
#. fr: Haaa<nbsp>!
msgctxt "NpcYell:4835:0:13"
msgid "Ugh!"
msgstr "Уф!"

#. ja: なん…だと…！？
#. de: Hien?
#. fr: Hein<nbsp>!?
msgctxt "NpcYell:4836:0:13"
msgid "What...the..."
msgstr "Что... за?.."

#. ja: 愉しませてくれよ？
#. de: Enttäusch mich nicht!
#. fr: Divertis-moi...
msgctxt "NpcYell:4837:0:13"
msgid "Give me something to remember!"
msgstr "Удиви меня!"

#. ja: どうした、その程度か？
#. de: Los, bring es zu Ende!
#. fr: Eh bien, c'est tout<nbsp>?
msgctxt "NpcYell:4838:0:13"
msgid "Don't stop now..."
msgstr "Не останавливайся..."

#. ja: でも、油断禁物…<br>コジャには注意っぺな…
#. de: Hoffentlich lassen mich die Koja in Ruhe.
#. fr: Je dois faire attention maintenant... Sinon, les koja vont encore me voler...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4839:0:13"
msgid "Who knows what awaits<br>me!? Who knows!?"
msgstr "Кто знает, что меня ждёт!<br>Кто знает!?"

#. ja: 仕留めるッ！
#. de: Schluss jetzt!
#. fr: C'est terminé<nbsp>!
msgctxt "NpcYell:4840:0:13"
msgid "It's all over now!"
msgstr "Сейчас я с тобой покончу!"

#. ja: 任せておけ！
#. de: Überlass das mir!
#. fr: Je m'en occupe<nbsp>!
msgctxt "NpcYell:4841:0:13"
msgid "Leave it to me!"
msgstr "Предоставь это мне!"

#. ja: 今日こそお魚を<br>全部持ち帰るっぺよ！
#. de: Ich will endlich mal alles mit nach Hause nehmen!
#. fr: Aujourd'hui, je ne leur laisse aucun poisson<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
#. macro: <i> — italic text (formatting: keep it as often as the source has it)
#. macro: </i> — end of: italic text (formatting: keep it as often as the source has it)
msgctxt "NpcYell:4842:0:13"
msgid "Hurry home, I must... But the<br>eyes─they are <i>everywhere</i>!"
msgstr "Скорее домой... Но глаза —<br>они <i>повсюду</i>!"

#. ja: スンスンスン…<br>魚の匂いがする…
#. de: \<schnüff> ... Ich rieche Fisch!
#. fr: (renifle) (renifle) Une délicieuse odeur de poisson frais...
msgctxt "NpcYell:4843:0:13"
msgid "Something smells nice!"
msgstr "Чем-то вкусным пахнет!"

#. ja: オイ、そこのナマズオ<br>魚をよこせや！
#. de: He da, Namazuo! Rück den Fisch raus!
#. fr: Toi, le Namazu<nbsp>! Donne tout ton poisson<nbsp>! Sinon...<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4844:0:13"
msgid "How kind of you, Gyogun,<br>to fetch us a basket of fish!"
msgstr "Какая забота, Гёгун!<br>Целую корзину рыбы принёс!"

#. ja: ええ、この書物があれば…
#. de: Zunächst einmal möchte ich, dass<nbsp>...
#. fr: Ce journal va nous permettre de...
msgctxt "NpcYell:4845:0:13"
msgid "To begin with, I want you to..."
msgstr "Для начала я хочу, чтобы ты..."

#. ja: ついに、悲願が…
#. de: Zu Befehl!
#. fr: Enfin...<nbsp>!
msgctxt "NpcYell:4846:0:13"
msgid "Sir, yes, sir!"
msgstr "Сэр, так точно!"

#. ja: これならば…どうです？
#. de: Was hältst du hiervon?
#. fr: Voyons avec ça...
msgctxt "NpcYell:4847:0:13"
msgid "How will you handle...this?"
msgstr "А если вот так?.."

#. ja: 貴重なデータが取れそうです！
#. de: Ich brauche diese Daten unbedingt.
#. fr: Ces données vont être très utiles<nbsp>!
msgctxt "NpcYell:4848:0:13"
msgid "I must archive these results!"
msgstr "Надо сохранить эти результаты!"

#. ja: 誰も死なせはせんぞ！
#. de: Heute wird niemand sterben.
#. fr: Je ne laisserai mourir personne<nbsp>!
msgctxt "NpcYell:4849:0:13"
msgid "No one's dying today!"
msgstr "Сегодня никто не умрёт!"

#. ja: もうひと踏ん張りだ！
#. de: Nur noch ein bisschen!
#. fr: On y est presque<nbsp>!
msgctxt "NpcYell:4850:0:13"
msgid "Keep at it!"
msgstr "Ещё немного!"

#. ja: ハッ！
#. de: Ha!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:4851:0:13"
msgid "Hah!"
msgstr "Ха!"

#. ja: セイッ！
#. de: Uuu-oh!
#. fr: Raaah<nbsp>!
msgctxt "NpcYell:4852:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: 叩き斬る！
#. de: Ich schneid dich in Stücke!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:4853:0:13"
msgid "Take that!"
msgstr "Получай!"

#. ja: 避けられるか？
#. de: Beweg dich nicht!
#. fr: Évite ça, pour voir<nbsp>!
msgctxt "NpcYell:4854:0:13"
msgid "Mark well..."
msgstr "Ну-ка, попробуй увернуться..."

#. ja: これはどうだ！
#. de: Sieh dir das mal an!
#. fr: Qu'est-ce que tu dis de ça<nbsp>?
msgctxt "NpcYell:4855:0:13"
msgid "How about this?"
msgstr "Ну как тебе это?"

#. ja: 刈り取るッ！
#. de: Schön stillhalten!
#. fr: Tiens<nbsp>!
msgctxt "NpcYell:4856:0:13"
msgid "Keep your guard up!"
msgstr "Не расслабляйся!"

#. ja: 昏き焔よ！
#. de: Hier, das ist für dich!
#. fr: Explosez, ténèbres<nbsp>!
msgctxt "NpcYell:4857:0:13"
msgid "Embrace the dark!"
msgstr "Объятие тьмы!"

#. ja: さあ、爆ぜろッ！
#. de: Lass dich von den Schatten einhüllen!
#. fr: Brûle<nbsp>!
msgctxt "NpcYell:4858:0:13"
msgid "Be sundered!"
msgstr "Рассыпься в прах!"

#. ja: 暗黒よ迸れ…！
#. de: Es gibt kein Entrinnen!
#. fr: Que la noirceur t'emporte<nbsp>!
msgctxt "NpcYell:4859:0:13"
msgid "The abyss comes!"
msgstr "Бездна надвигается!"

#. ja: フンヌァッ！
#. de: Hmmmpf!
#. fr: Hmph<nbsp>!
msgctxt "NpcYell:4860:0:13"
msgid "Hyaaa!"
msgstr "Хья-а!"

#. ja: まだまだいくぞ！
#. de: Es ist noch nicht vorbei!
#. fr: Je n'ai pas dit mon dernier mot<nbsp>!
msgctxt "NpcYell:4861:0:13"
msgid "Hold fast!"
msgstr "Держись!"

#. ja: 墜ちるがいい
#. de: Stirb endlich!
#. fr: Attention à tes pieds, ha ha<nbsp>!
msgctxt "NpcYell:4862:0:13"
msgid "Now fall!"
msgstr "А теперь падай!"

#. ja: グッ…ガッ…
#. de: Hu! Ha!
#. fr: Gah...
msgctxt "NpcYell:4863:0:13"
msgid "\\<pant> \\<pant>"
msgstr "<i>Ха... Ха...</i>"

#. ja: おのれ…動け…！
#. de: Hilf ihr!
#. fr: Grrr, qu'est-ce que fous<nbsp>!?
msgctxt "NpcYell:4864:0:13"
msgid "Godsdamn you..."
msgstr "Будь ты проклят..."

#. ja: まだ俺は…！
#. de: Ich bin noch nicht am Ende ...
#. fr: Tiens bon, <split " " 1><string $gs1></split><nbsp>!
msgctxt "NpcYell:4865:0:13"
msgid "I can still..."
msgstr "Я ещё могу..."

#. ja: リエル…！
#. de: Rielle!
#. fr: Rielle...<nbsp>!
msgctxt "NpcYell:4866:0:13"
msgid "Rielle!"
msgstr "Риэль!"

#. ja: やだ、降ろして…！
#. de: Lass mich runter!
#. fr: Laissez-moi<nbsp>!
msgctxt "NpcYell:4867:0:13"
msgid "Help! Help!"
msgstr "Помогите! Помогите!"

#. ja: きゃあああッ！
#. de: Hiiilfe!
#. fr: Aaaaah<nbsp>!
msgctxt "NpcYell:4868:0:13"
msgid "Aaaaaah!"
msgstr "А-а-а-а-а!"

#. ja: ありがとう！
#. de: Danke!
#. fr: Merci<nbsp>!
msgctxt "NpcYell:4869:0:13"
msgid "Thank you, thank you!"
msgstr "Спасибо! Спасибо!"

#. ja: 大丈夫、まだ戦える！
#. de: Das war noch nicht alles!
#. fr: Ça va, je peux encore me battre<nbsp>!
msgctxt "NpcYell:4870:0:13"
msgid "I'll be fine, don't worry!"
msgstr "Не волнуйся, я в порядке!"

#. ja: フハハハ！
#. de: Sprich dein Urteil, Halone, sprich es durch mich!
#. fr: Ha ha ha ha<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4871:0:13"
msgid "Monster! Abomination!<br>Death will be a mercy!"
msgstr "Чудовище! Отродье!<br>Смерть станет для тебя милосердием!"

#. ja: 壊す、消す、すべて！
#. de: Du machst einen Fehler, <if $gn4>Dunkelritterin<else>Dunkelritter</if>.
#. fr: Mourrez tous<nbsp>!
msgctxt "NpcYell:4872:0:13"
msgid "Pray forgive me my sins...for laying down with Your enemies..."
msgstr "Прости мне грехи мои... за то, что возлёг с врагами Твоими..."

#. ja: 生かしておくものか！
#. de: Die Furie steht mir bei!
#. fr: Tu ne m'échapperas pas<nbsp>!
msgctxt "NpcYell:4873:0:13"
msgid "Help me...to cleanse my soul of this taint..."
msgstr "Помоги мне... очистить душу от этой скверны..."

#. ja: 神に抗う愚か者め！
#. de: Warum? Warum siehst du es nicht!?
#. fr: Vous défiez le seul dieu légitime<nbsp>!
msgctxt "NpcYell:4874:0:13"
msgid "You defy the only rightful god!"
msgstr "Ты бросаешь вызов единственному истинному богу!"

#. ja: 我が力は、すべてを貫く！
#. de: Thordan zum Ruhme!
#. fr: Glaive de la justice<nbsp>!
msgctxt "NpcYell:4875:0:13"
msgid "No shield will defend you from the spear of my conviction!"
msgstr "Щит не спасёт тебя от копья моей веры!"

#. ja: 救われるものか！
#. de: Glaubst du, du kannst dich alleine retten?
#. fr: C'est perdu d'avance<nbsp>!
msgctxt "NpcYell:4876:0:13"
msgid "Ours is the righteous cause!"
msgstr "Наше дело правое!"

#. ja: 決着をつけよう…<br>光の使徒よ！
#. de: Warum sträubst du dich? Lass dir doch helfen!
#. fr: Il est temps d'en finir, misérables humains<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4877:0:13"
msgid "Let us settle this<br>once and for all!"
msgstr "Покончим с этим<br>раз и навсегда!"

#. ja: あの男と同じように<br>神意の槍で貫くまでだ！
#. de: Ich spieß dich auf, wie den anderen!
#. fr: Cette fois, tu vas vraiment connaître le même sort que le bâtard des Fortemps<nbsp>!
msgctxt "NpcYell:4878:0:13"
msgid "You shall fall, as did your ally!"
msgstr "Ты падёшь, как пал твой союзник!"

#. ja: お前は奪われ続ける…
#. de: Du kannst nicht ewig so weitermachen.
#. fr: Tu ne vas plus tenir longtemps...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4879:0:13"
msgid "I will answer for my sins.<br>Will you for yours?"
msgstr "За свои грехи я отвечу.<br>А ты за свои?"

#. ja: ブッ潰す！
#. de: Ich zerquetsch dich!
#. fr: Crève<nbsp>!
msgctxt "NpcYell:4880:0:13"
msgid "I'll crush you!"
msgstr "Я тебя раздавлю!"

#. ja: 引っ込んでな！
#. de: Drück dich nicht vor deinem Schicksal!
#. fr: Ha ha ha<nbsp>!
msgctxt "NpcYell:4881:0:13"
msgid "There's no escape!"
msgstr "Тебе не уйти!"

#. ja: わかれよッ！
#. de: Lächerliche Lichtgestalt!
#. fr: Tiens<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4882:0:13"
msgid "You of all people<br>should understand!"
msgstr "Кто-кто, а ты<br>должна понимать!"

#. ja: 遊びは終わりだ<br>甘ッタレども！
#. de: Zeit, die Sache zu beenden.
#. fr: Fini de jouer<nbsp>!
msgctxt "NpcYell:4883:0:13"
msgid "No more games!"
msgstr "Хватит игр!"

#. ja: お前を殺せば<br>世界はッ！
#. de: Wir haben unser Leben für unsere Mission geopfert. Für eine bessere Welt!
#. fr: Cette fois, je vais te tuer<nbsp>!
msgctxt "NpcYell:4884:0:13"
msgid "One life for one world!"
msgstr "Одна жизнь — за целый мир!"

#. ja: すべての命のために…<br>死んでもらうッ！
#. de: Stirb! Damit all die anderen leben können!
#. fr: Meurs<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4885:0:13"
msgid "We did everything right,<br>everything that<br>was asked of us!"
msgstr "Мы всё сделали как надо,<br>всё, что от нас требовали!"

#. ja: だ、誰か…<br>あの子を止めて！
#. de: So tu doch jemand etwasss!
#. fr: Que quelqu'un arrête ce marid<nbsp>! Ssss...
msgctxt "NpcYell:4886:0:13"
msgid "The young one! She flees!"
msgstr "Молодая! Она убегает!"

#. ja: シュー…<br>我らが止める！
#. de: Ich werde ihn zügeln!
#. fr: On s'en occupe<nbsp>! Ssss...
msgctxt "NpcYell:4887:0:13"
msgid "Do not let her gain the village!"
msgstr "Не дайте ей добраться до деревни!"

#. ja: 鎮まれ！
#. de: Ruhig, Grosssssser!
#. fr: Douuucement<nbsp>! Ssss...
msgctxt "NpcYell:4888:0:13"
msgid "Calm her!"
msgstr "Успокойте её!"

#. ja: シュー…<br>手を貸してくれ！
#. de: Hilf unsss!
#. fr: On a besoin d'aide<nbsp>! Ssss...
msgctxt "NpcYell:4889:0:13"
msgid "You! To my ssside!"
msgstr "Ты! Ко мне, ссскорей!"

#. ja: シュー…普段は<br>大人しいのに…
#. de: Sssonst ist er doch immer ganz brav!
#. fr: Qu'est-ce qui lui prend, aujourd'hui<nbsp>? Ssss...
msgctxt "NpcYell:4890:0:13"
msgid "What could have provoked her?"
msgstr "Ссс чего она вдруг взбесилась?"

#. ja: このままでは<br>大きな被害が…
#. de: Er darf uns nicht entwissschen!
#. fr: Il va finir par tout détruire... Ssss...
msgctxt "NpcYell:4891:0:13"
msgid "If she cannot be sssoothed..."
msgstr "Если её не успокоить..."

#. ja: シュー…ダメだ<br>撤退する…
#. de: Ich muss mich zurückziehen!
#. fr: Rien à faire... Ssss...
msgctxt "NpcYell:4892:0:13"
msgid "My wounds are too great..."
msgstr "Раны слишком тяжёлые..."

#. ja: シュー…すまない…<br>負傷してしまった…
#. de: Ich bin verletzt!
#. fr: Je suis blessée... Ssss...
msgctxt "NpcYell:4893:0:13"
msgid "I am of no ussse like thisss..."
msgstr "В таком сссостоянии я бесполезен..."

#. ja: シュー…その力量…<br>見習いたいものだ…
#. de: Von dir können wir noch lernen!
#. fr: J'aimerais être aussi forte que toi. Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4894:0:13"
msgid "We are witnesss to ssstrength<br>worthy of sssong, sssisters!"
msgstr "Сссвидетельницы сссилы, достойной песни,<br>сёстры мои!"

#. ja: シュー…感謝します<br>ヒトの子の友よ！
#. de: Danke, <if $gn4>Abenteurerin<else>Abenteurer</if>!
#. fr: Merci pour ton aide<nbsp>! Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4895:0:13"
msgid "You have sssaved our<br>village! Peace be with you."
msgstr "Вы ссспасли нашу<br>деревню! Да пребудет ссс вами мир."

#. ja: シュー…<br>もう止められない…
#. de: Er ist uns entwissscht!
#. fr: Nous avons échoué... Ssss...
msgctxt "NpcYell:4896:0:13"
msgid "She is gone..."
msgstr "Она ушла..."

#. ja: シュー…<br>なんということ…
#. de: Wie ssschrecklich!
#. fr: Malheur... Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4897:0:13"
msgid "I am no longer worthy of<br>the beassstmaid's ssscourge."
msgstr "Я больше недостойна<br>бича повелительницы зверей."

#. ja: シュー…<br>お願い、鎮まって！
#. de: Beruhig dich doch!
#. fr: On se calme<nbsp>! Ssss...
msgctxt "NpcYell:4898:0:13"
msgid "Lisssten to my voice, girl!"
msgstr "Ссслушай мой голос, девочка!"

#. ja: シュー…<br>嗚呼、止まって！
#. de: Du kriegst auch dein Fresschen!
#. fr: Chuuut<nbsp>! Ssss...
msgctxt "NpcYell:4899:0:13"
msgid "Please!!!"
msgstr "Пожалуйста!!!"

#. ja: シュー…<br>すさまじい力だ…
#. de: Welch unbändige Kraft!
#. fr: Quelle force... Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4902:0:13"
msgid "There is nothing<br>more we can do."
msgstr "Мы больше ничего<br>не можем сделать."

#. ja: 未使用
#. de: 0
#. fr: 0
msgctxt "NpcYell:4903:0:13"
msgid "0"
msgstr "0"

#. ja: 海兵…魂ぃぃぃぃぃぃぃぃ…
#. de: Ehre den Seesoldaten!
#. fr: Est-ce la science... ou l'acier... qui m'a fait défaut...<nbsp>?
msgctxt "NpcYell:4904:0:13"
msgid "TO VICTORY─COME HELLS OR HIGH WATER!"
msgstr "К ПОБЕДЕ — ХОТЬ СКВОЗЬ СЕМЬ АДОВ!"

#. ja: クソッ…情けねェ…
#. de: Sieben Höllen! Wie peinlich.
#. fr: Bordel... Je m'y suis pris comme un bleu...
msgctxt "NpcYell:4905:0:13"
msgid "Seven hells! That was pathetic!"
msgstr "Семь адов! Ну и жалкое зрелище!"

#. ja: これが！僕の！海兵魂だぁぁぁ！
#. de: Nimm das, du Unhold!
#. fr: Science et acieeeeer<nbsp>!
msgctxt "NpcYell:4906:0:13"
msgid "Take that, fiend!"
msgstr "Получай, злодей!"

#. ja: 覚悟しな…串刺しにしてやらァ！
#. de: Du bist kein Gegner für meine Lanze.
#. fr: Prêt à te faire embrocher<nbsp>!?
msgctxt "NpcYell:4907:0:13"
msgid "You're no match for my lance!"
msgstr "Тебе не сравниться с моим копьём!"

#. ja: 嫌な予感がする…<br>やつから離れるんだ！
#. de: Das verheißt nichts Gutes. Geht auf Sicher<shy>heits<shy>abstand!
#. fr: Je n'aime pas ça... Éloignez-vous de lui<nbsp>!
msgctxt "NpcYell:4908:0:13"
msgid "This bodes ill... Everyone, retreat to a safe distance. Now!"
msgstr "Недоброе дело... Всем отойти подальше! Живо!"

#. ja: チッ、またかよ…<br>いったん距離を取るぞ！
#. de: Nicht schon wieder! Alle zurück!
#. fr: Quoi<nbsp>? Encore<nbsp>!? Tout le monde recule<nbsp>!
msgctxt "NpcYell:4909:0:13"
msgid "Not again! Everyone, move back!"
msgstr "Опять?! Всем назад!"

#. ja: ふたりとも、散開するんだ！
#. de: Wir müssen uns aufteilen!
#. fr: Écartez-vous les uns des autres<nbsp>!
msgctxt "NpcYell:4910:0:13"
msgid "We need to spread out!"
msgstr "Надо разойтись!"

#. ja: 俺に近づくんじゃねェぞ！
#. de: Nicht so nah! Halte Abstand zu mir!
#. fr: Vous avez pas intérêt à vous approcher de moi<nbsp>!
msgctxt "NpcYell:4911:0:13"
msgid "You're too close! Fall back!"
msgstr "Слишком близко! Назад!"

#. ja: この攻撃…<br>みんなで衝撃を分散するんだ！
#. de: Ein weiterer Angriff! Wir müssen den Schaden streuen!
#. fr: Attendez, j'ai déjà vu ça... On doit se rassembler pour chacun absorber une partie des dégâts, vite<nbsp>!
msgctxt "NpcYell:4912:0:13"
msgid "It intends to attack, once more! Hurry─we must disarm it!"
msgstr "Он снова собирается атаковать! Скорее — надо его обезвредить!"

#. ja: テメェら！<br>一カ所に集まりやがれェ！
#. de: Ihr da! Zurück in Formation!
#. fr: Tous au même endroit<nbsp>! Et que ça saute<nbsp>!
msgctxt "NpcYell:4913:0:13"
msgid "You two─move back into formation!"
msgstr "Вы двое — вернитесь в строй!"

#. ja: 大義のために！
#. de: Für die Gerechtigkeit!
#. fr: Pour la justice<nbsp>!
msgctxt "NpcYell:4914:0:13"
msgid "For the cause!"
msgstr "За правое дело!"

#. ja: こっちにつけ！
#. de: Komm her!
#. fr: Viens par là<nbsp>!
msgctxt "NpcYell:4915:0:13"
msgid "Come here!"
msgstr "Иди сюда!"

#. ja: 死ねっ！
#. de: Stirb!
#. fr: Meurs<nbsp>!
msgctxt "NpcYell:4916:0:13"
msgid "Die!"
msgstr "Умри!"

#. ja: 目を覚ますのだ！
#. de: Öffne die Augen!
#. fr: Ouvrez les yeux<nbsp>!
msgctxt "NpcYell:4917:0:13"
msgid "Come to your senses!"
msgstr "Очнись же!"

#. ja: やぁっ！
#. de: Yaah!
#. fr: Yaah<nbsp>!
msgctxt "NpcYell:4918:0:13"
msgid "Yah!"
msgstr "Я-а!"

#. ja: せいやっ！
#. de: Nimm das!
#. fr: Prenez donc ça<nbsp>!
msgctxt "NpcYell:4919:0:13"
msgid "Hah!"
msgstr "Ха!"

#. ja: 虚けめが！
#. de: Lügner!
#. fr: Pauvres fous<nbsp>!
msgctxt "NpcYell:4920:0:13"
msgid "Misguided fools!"
msgstr "Заблудшие глупцы!"

#. ja: どりゃあああ！
#. de: Gyaaaah!
#. fr: Gyaaaah<nbsp>!
msgctxt "NpcYell:4921:0:13"
msgid "Yaaargh!"
msgstr "Я-а-а-а!"

#. ja: てやぁ！
#. de: Hah!
#. fr: Han<nbsp>!
msgctxt "NpcYell:4922:0:13"
msgid "Hah!"
msgstr "Ха!"

#. ja: シュー…<br>何の騒ぎだ？
#. de: Was ist hier losss?
#. fr: Qu'est-ce qui se passe, ici<nbsp>? Ssss...
msgctxt "NpcYell:4923:0:13"
msgid "What commotion is thisss?"
msgstr "Ссс что тут за шум?"

#. ja: シュー…<br>片付きそうだな
#. de: Das sssieht doch gut aus.
#. fr: Quand faut y aller... Ssss...
msgctxt "NpcYell:4924:0:13"
msgid "Sssoon! It ends sssoon!"
msgstr "Ссскоро! Скоро всё кончится!"

#. ja: シュー…<br>見ておれん…
#. de: Ssschade ...
#. fr: Grrr, je préfère ne pas voir ça... Ssss...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4926:0:13"
msgid "My sssisters shame me<br>with their weaknesss!"
msgstr "Ссстолько слабости у сестёр — мне сссрамно смотреть!"

#. ja: いやああああああ！！
#. de: Neeeiiin!!!
#. fr: Noooooon<nbsp>!!!
msgctxt "NpcYell:4930:0:13"
msgid "Noooooo!"
msgstr "Нееееет!"

#. ja: きゃっ！！
#. de: Nein ...
#. fr: Ha<nbsp>!
msgctxt "NpcYell:4931:0:13"
msgid "Gah!"
msgstr "А-а!"

#. ja: ガッティの魔力が<br>これほどとは…
#. de: Ich hätte nicht gedacht, dass sie so viel Macht besitzt ...
#. fr: La puissance de Gatty... dépasse tout ce que j'imaginais...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4932:0:13"
msgid "Gatty's mana...<br>It's incredible."
msgstr "Магия Гатти...<br>Невероятно."

#. ja: もう大丈夫
#. de: Danke, <split " " 1><string $gs1></split>!
#. fr: Merci, <split " " 1><string $gs1></split><nbsp>!
#. macro: <split " " 1><string $gs1></split> — the first name of the player character (game data: keep it; it may move or repeat)
#. macro: <string $gs1> — a text value passed to the string; value = global text 1 (the name of the player character) (game data: keep it; it may move or repeat)
msgctxt "NpcYell:4934:0:13"
msgid "Thank you,  <split \" \" 1><string $gs1></split>!"
msgstr "Спасибо, <split \" \" 1><string $gs1></split>!"

#. ja: はぁ、はぁ…
#. de: \<schnauf> ... Moment ...
#. fr: (souffle) (souffle) Mon cœur va exploser... (souffle)
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4935:0:13"
msgid "A...moment...\\<pant> \\<pant>...<br>to catch my...\\<pant>...breath..."
msgstr "М... минутку... <i>Уф... Уф...</i><br>Надо... <i>уф...</i> перевести дух..."

#. ja: なんてことだ…
#. de: Ach, ich Vollpfosten!
#. fr: Quelle guigne...
msgctxt "NpcYell:4936:0:13"
msgid "Oh, what a fool I am!"
msgstr "Ах, какой же я глупец!"

#. ja: 痛たたたた！
#. de: Autsch, tut das weh ...
#. fr: Ah<nbsp>! Pas là... Aïe<nbsp>! Je souffre<nbsp>! À l'aide<nbsp>!
msgctxt "NpcYell:4937:0:13"
msgid "Ach! The wounds...they burn!"
msgstr "Ай! Раны... жгут!"

#. ja: ゼノス…さま…
#. de: Prinz Zenos, mein Herr ...
#. fr: Seigneur... Zenos...
msgctxt "NpcYell:4938:0:13"
msgid "Lord Zenos..."
msgstr "Господин Зенос..."

#. ja: そんなッ…
#. de: Das kann nicht sein!
#. fr: N-nooon...
msgctxt "NpcYell:4939:0:13"
msgid "Ugh..."
msgstr "Не может быть..."

#. ja: えっ…？
#. de: Hm ...?
#. fr: Hein<nbsp>!?<nbsp>...
msgctxt "NpcYell:4940:0:13"
msgid "Why..."
msgstr "Почему..."

#. ja: 逃げられない…
#. de: Es gibt kein Entkommen!
#. fr: Ils... Ils tournoient... Ô grand Rhalgr<nbsp>! Viens à mon secours<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4941:0:13"
msgid "Beasts before me,<br>beasts behind..."
msgstr "Звери впереди,<br>звери позади..."

#. ja: 命拾いしたよ…<br>どうにか帰れそうだ！
#. de: Bei meiner Ehre als Krieger schwöre ich, nie wieder mein Schwert zu verlegen!
#. fr: Merci, je vais pouvoir faire de vieux os grâce à toi<nbsp>! Je rentre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4942:0:13"
msgid "You have my word as a<br>warrior, never again will I<br>allow my blade from my<br>sight! Honest!"
msgstr "Клянусь честью воина,<br>больше никогда не спущу<br>глаз с клинка! Честное слово!"

#. ja: 力を解放する…
#. de: Lasst die Hatz beginnen!
#. fr: Ce n'est que le début...
msgctxt "NpcYell:4943:0:13"
msgid "All right."
msgstr "Ладно."

#. ja: 奔れ…
#. de: Rennt, ihr Wilden ...
#. fr: Cours, ma jolie proie...
msgctxt "NpcYell:4944:0:13"
msgid "Run, beast, run!"
msgstr "Беги, зверь, беги!"

#. ja: 試し斬りといくか…
#. de: Ein kleiner Schnitttest!
#. fr: Voyons donc ce tranchant...
msgctxt "NpcYell:4945:0:13"
msgid "Let us put you to the proof."
msgstr "Проверим тебя на прочность."

#. ja: 力を解放する…
#. de: Lasst die Hatz beginnen!
#. fr: Ce n'est que le début...
msgctxt "NpcYell:4946:0:13"
msgid "All right."
msgstr "Ладно."

#. ja: くそ！<br>このぉ！
#. de: Verdammt!
#. fr: Bas les pattes<nbsp>! Au... Au secours<nbsp>!
msgctxt "NpcYell:4947:0:13"
msgid "Drive them off! I beg you!"
msgstr "Прогоните их! Прошу вас!"

#. ja: お前を討つ！
#. de: Du bist tot!
#. fr: J'aurai ta vie<nbsp>!
msgctxt "NpcYell:4948:0:13"
msgid "This day you die!"
msgstr "Сегодня ты умрёшь!"

#. ja: 始末するッ！
#. de: Das übernehme ich!
#. fr: Laissez-moi faire<nbsp>!
msgctxt "NpcYell:4949:0:13"
msgid "Leave this to me!"
msgstr "Оставьте это мне!"

#. ja: 獣は俺が引きつける！<br>負傷者の治療を頼んだぞ！
#. de: Ich übernehme die Biester, du die Flüchtlinge!
#. fr: Les petits moches sont pour moi, tu te charges des blessés<nbsp>!
msgctxt "NpcYell:4950:0:13"
msgid "Leave this lot to me. Help the wounded!"
msgstr "Этих зверей беру на себя. Помоги раненым!"

#. ja: で、出たな！<br>コイツです！
#. de: Da ist er! Auf ihn!
#. fr: Voilà ce satané fourrrmilion<nbsp>!
msgctxt "NpcYell:4951:0:13"
msgid "There! See!"
msgstr "Вон! Смотри!"

#. ja: 雄大な川だ…
#. de: Hübsches Flüsschen ...
#. fr: Quelle belle rivière<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4952:0:13"
msgid "There's not a more beautiful<br>river in all the land..."
msgstr "Нет на свете реки<br>прекраснее этой..."

#. ja: そろそろ行くか…
#. de: Aber ich sollte langsam mal weiter.
#. fr: J'en oublierais presque ma mission...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4953:0:13"
msgid "This is why we fight.<br>This is worth dying for..."
msgstr "Вот ради чего мы сражаемся.<br>За это и умереть не жалко..."

#. ja: なっ！？<br>いつの間に！
#. de: Wa...?! Wo kommt der denn her?
#. fr: ... Aaah<nbsp>!!!
msgctxt "NpcYell:4954:0:13"
msgid "When did─! Aaahhh!"
msgstr "Откуда ты—?! А-а-а!"

#. ja: 野郎ども！<br>カチ込みだぞ！
#. de: Achtung! Die Rotpanzer machen Ärger!
#. fr: C'est l'heure de casser du Kojin<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4955:0:13"
msgid "Up on yer feet, dogs!<br>We've some shells to crack!"
msgstr "А ну встали, псы!<br>Есть панцири, которые надо расколоть!"

#. ja: 亀ども！<br>海賊衆をなめるなよ！
#. de: Elende Kröten, legt euch nicht mit der Konföderation an!
#. fr: Vous allez le regretter, sales tortues<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4956:0:13"
msgid "Yer messin' with the wrong<br>crew, ye Red bastards!"
msgstr "Не с той командой связались,<br>краснопанцирные ублюдки!"

#. ja: ぶ、物資が<br>奪われちまった…
#. de: Oh nein, sie haben unseren Rum geklaut!
#. fr: Ils ont emporté toutes nos provisions...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4957:0:13"
msgid "Our rum! The bastards made<br>away with our bloody rum!"
msgstr "Наш ром! Ублюдки утащили<br>весь проклятый ром!"

#. ja: オラァ！
#. de: Zurück ins Meer mit euch!
#. fr: Casse-toi<nbsp>!
msgctxt "NpcYell:4958:0:13"
msgid "Back to the deep with ye!"
msgstr "Обратно в пучину, живо!"

#. ja: いくぜ！
#. de: Stirb, du Kröte!
#. fr: Prends ça<nbsp>!
msgctxt "NpcYell:4959:0:13"
msgid "Die! Die! Die!"
msgstr "Умри! Умри! Умри!"

#. ja: お宝はちょうだい<br>していくぞォー！
#. de: Los, her mit euren Schätzen!
#. fr: À nous la nourriture des pirates<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4960:0:13"
msgid "We are here for your<br>treasures. Run...or stay.<br>It matters not. You all<br>will die here today."
msgstr "Мы пришли за вашими<br>сокровищами. Бегите... или оставайтесь.<br>Нам всё равно. Сегодня<br>вы все здесь умрёте."

#. ja: フンヌッ！
#. de: Arrr ...!
#. fr: Courage, compagnons<nbsp>!
msgctxt "NpcYell:4963:0:13"
msgid "Unbreakable!"
msgstr "Несокрушимость!"

#. ja: ヌラーッ！
#. de: Landkriecher!
#. fr: Oooorh<nbsp>!
msgctxt "NpcYell:4964:0:13"
msgid "Unyielding!"
msgstr "Несгибаемость!"

#. ja: ハァ…ハァ…<br>逃げられねぇか…
#. de: Ich ... muss ... die anderen ... warnen ...
#. fr: Haa haa (souffle)... Satanés Kojin...
msgctxt "NpcYell:4965:0:13"
msgid "Must...warn...my brothers..."
msgstr "Надо... предупредить... братьев..."

#. ja: た、助かったぜ…<br>助太刀、ありがとよ…
#. de: Danke! Du hast mich gerettet.
#. fr: Merci, tu nous as rendu un fier service<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4966:0:13"
msgid "Thank you, stranger...<br>My brothers should be here soon."
msgstr "Спасибо, незнакомец...<br>Братья скоро будут здесь."

#. ja: シマエイどもめ…
#. de: Verdammte Rochen ...
#. fr: Il en arrive de partout<nbsp>!
msgctxt "NpcYell:4967:0:13"
msgid "There's...no end to them..."
msgstr "Им... конца и края нет..."

#. ja: ハァ…ハァ…
#. de: \<keuch>
#. fr: Haa haa (souffle)...
msgctxt "NpcYell:4968:0:13"
msgid "'Tis a good day...to die..."
msgstr "Хороший день... чтобы умереть..."

#. ja: あ、あれは…<br>ヤヒロノワニ！？
#. de: Yahiro, endlich habe ich dich!
#. fr: La voilà<nbsp>! Yahiro...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4969:0:13"
msgid "Thar! Thar blows the blighted<br>fiend what swallowed me<br>poor, sickly brother whole!"
msgstr "Вот он... та самая зараза<br>по имени Яхиро, проглотившая<br>моего бедного, болезного брата целиком!"

#. ja: 弟を喰った化け物め！<br>ここで会ったが百年目！
#. de: Du hast meinen Bruder gefressen!
#. fr: Je vais te faire payer pour mon frère<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4970:0:13"
msgid "Searched, I have for ye nigh<br>seven summers and a moon."
msgstr "Почти семь лет и месяц<br>я тебя искал."

#. ja: 海賊衆に入って磨いた<br>槍術で仕留めてやる！
#. de: Nun bekommst du meine Harpune zu spüren!
#. fr: Tu vas goûter à ma lance, monstre<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4971:0:13"
msgid "Come, Yahiro! Come that<br>I may tear out yer heart<br>as you did mine!"
msgstr "Ну же, Яхиро! Иди сюда,<br>дай вырву тебе сердце,<br>как ты вырвал моё!"

#. ja: かたじけない…<br>おかげで仇が討てたわ…
#. de: Der Mörder meines Bruders ist tot!
#. fr: Je te suis redevable, <if $gn4>aventurière<else>aventurier</if>.
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4972:0:13"
msgid "Yahiro is no more. Me blood<br>might now rest in peace."
msgstr "Яхиро мёртв. Теперь<br>моя кровь может упокоиться с миром."

#. ja: くっ…弟の仇…<br>討てないとは…
#. de: Ich kehre zurück, um meinen Bruder zu rächen.
#. fr: Tu ne perds rien pour attendre, Yahiro...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4973:0:13"
msgid "I'll be back, I swear it. I shall<br>not rest until Yahiro's<br>blood stains the Ruby red."
msgstr "Я ещё вернусь, клянусь. Не успокоюсь,<br>пока кровь Яхиро не окрасит<br>Рубин в алый цвет."

#. ja: 弟の仇ッ！
#. de: Rache für meinen Bruder!
#. fr: Vengeance<nbsp>!
msgctxt "NpcYell:4974:0:13"
msgid "I will have vengeance!"
msgstr "Я отомщу!"

#. ja: 殺してやるッ！
#. de: Ich bring dich um!
#. fr: Meuuurs<nbsp>!
msgctxt "NpcYell:4975:0:13"
msgid "You shall suffer!"
msgstr "Ты за всё ответишь!"

#. ja: ええいッ！
#. de: Hepp!
#. fr: Yaaah<nbsp>!
msgctxt "NpcYell:4976:0:13"
msgid "Take that!"
msgstr "Получай!"

#. ja: フンッ！
#. de: Heh!
#. fr: Grrr<nbsp>!
msgctxt "NpcYell:4977:0:13"
msgid "And that!"
msgstr "И ещё!"

#. ja: 負けるものか！
#. de: So leicht nicht!
#. fr: Je ne perdrai pas<nbsp>!
msgctxt "NpcYell:4978:0:13"
msgid "And that and that and that!"
msgstr "И ещё, ещё, ещё!"

#. ja: どうだッ！
#. de: Wie ist das?
#. fr: Évite un peu ça<nbsp>!
msgctxt "NpcYell:4979:0:13"
msgid "Hyah!"
msgstr "Хья!"

#. ja: アラガーナまで<br>あと少し…
#. de: So nah ... und doch so fern ...
#. fr: Je suis si proche d'Ala Gannha... et pourtant si loin...
msgctxt "NpcYell:4980:0:13"
msgid "So close...yet so far..."
msgstr "Так близко... и всё же так далеко..."

#. ja: 美味そうっちゃ！
#. de: Oh! Ein Leckerhappen!
#. fr: Qiqirn couper tranche juuuteuse<nbsp>!
msgctxt "NpcYell:4982:0:13"
msgid "Oh ho! A most tasty morsel!"
msgstr "О-хо! Какой лакомый кусочек!"

#. ja: 倒れろっちゃ！
#. de: Wir dich kochen! Wir dich grillen!
#. fr: Qiqirn rôtir ta viande<nbsp>!
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4983:0:13"
msgid "Skewer you, we shall!<br>Roast you, we shall!"
msgstr "Пронзим тебя!<br>Зажарим тебя!"

#. ja: 逃げるっちゃ！
#. de: Rückzug! Zurück!
#. fr: Retraite<nbsp>! Retraite<nbsp>!
msgctxt "NpcYell:4984:0:13"
msgid "Back! Back!"
msgstr "Назад! Назад!"

#. ja: 今晩も<br>飯抜きっちゃ…
#. de: Leere Pfoten, leere Mägen ... \<seufz>
#. fr: Encore dormir ventre vide<nbsp>? (snif)...
#. macro: <br> — a line break (may be added or dropped)
msgctxt "NpcYell:4986:0:13"
msgid "Empty paws mean<br>empty bellies... \\<sniffle>"
msgstr "Пустые лапы —<br>пустые животы... <i>Шмыг...</i>"

#. ja: アラミゴ女相手に<br>よくやるぜ…
#. de: Aber eine Mhigitin? Ich weiß nicht.
#. fr: Eh ben, tu as de drôles de goûts, à fricoter avec des Mhigoises...
msgctxt "NpcYell:4988:0:13"
msgid "Tumble a savage? You sick bastard..."
msgstr "Дикарку охмурил? Больной ублюдок..."

#. ja: 何者だ！？
#. de: Wer ist da?!
#. fr: Qui va là<nbsp>!?
msgctxt "NpcYell:4989:0:13"
msgid "Who goes there!?"
msgstr "Кто идёт?!"

#. ja: カストルム・アバニアが<br>落ちたって本当か？
#. de: Castrum Abania? Gefallen?!
#. fr: C'est vrai que Castrum Abania est tombé<nbsp>?
msgctxt "NpcYell:4990:0:13"
msgid "If Castrum Abania's fallen, there's nothing to stop them from marching on the city..."
msgstr "Если Каструм Абания пал, ничто не помешает им двинуться на город..."

#. ja: リセ、声が大きいぞ…<br>静かにな…
#. de: Psst ... Man hört dich malmenweit, Lyse.
#. fr: Lyse, tu parles trop fort...
msgctxt "NpcYell:4991:0:13"
msgid "Except for you, maybe..."
msgstr "Кроме тебя, пожалуй..."

#. ja: 敵影なし！<br>サンクレッド…！
#. de: Die Luft ist rein, Thancred!
#. fr: Pas d'ennemis en vue, ici<nbsp>!
msgctxt "NpcYell:4993:0:13"
msgid "All quiet over here!"
msgstr "Здесь всё тихо!"

#. ja: さっさと<br>どっか行ってよ…
#. de: Versteckt euch!
#. fr: Quelle bande d'escargots<nbsp>!
msgctxt "NpcYell:4994:0:13"
msgid "Let's keep moving!"
msgstr "Давайте дальше!"

#. ja: ここにも帝国兵が！
#. de: Achtung! Wachen!
#. fr: Il y a un Impérial ici aussi<nbsp>!
msgctxt "NpcYell:4995:0:13"
msgid "Imperial soldier, dead ahead!"
msgstr "Имперский солдат прямо по курсу!"

#. ja: ゼノス様の作戦だろ？<br>大丈夫だって…
#. de: ... Ach, Prinz Zenos hat die Dinge bestimmt unter Kontrolle.
#. fr: Cela fait partie du plan du général, je crois...
msgctxt "NpcYell:4996:0:13"
msgid "All part of the viceroy's plan. Probably..."
msgstr "Всё по плану наместника. Наверное..."

#. ja: 不審者発見…<br>援軍を求む！
#. de: Verdächtige gesichtet! Schickt Verstärkung!
#. fr: Alerte<nbsp>! Intrus repérés<nbsp>! Envoyez des renforts<nbsp>!
msgctxt "NpcYell:4997:0:13"
msgid "Sound the alarum! We need reinforcements!"
msgstr "Тревога! Нужна подмога!"

#. ja: 昨日の女はよかったぜ…<br>紹介してやろうか？
#. de: ... Nächstes Mal stell ich dir auch ein Mädel vor. Komm schon, das wird ein Riesenspaß.
#. fr: Cette nénette était incroyable<nbsp>! Tu veux que je te la présente<nbsp>?<nbsp>...
msgctxt "NpcYell:4998:0:13"
msgid "...She did things with her tongue you wouldn't believe. I'll introduce you if you like."
msgstr "...У неё язык такое вытворял — не поверишь. Хочешь, познакомлю?"

#. ja: さよならだ…
#. de: Und gute Nacht ...
#. fr: Bonne nuit...
msgctxt "NpcYell:4999:0:13"
msgid "Pleasant dreams..."
msgstr "Приятных снов..."
