#. ja: 大吉
#. de: Segen
#. fr: — CHANCE EXCEPTIONNELLE —
#. column 6: Thou shalt experience extraordinary fortune. Keep these words of guidance in thy heart.
msgctxt "Omikuji:1:0:5"
msgid "Great Fortune"
msgstr ""

#. ja: 大変幸いの多い運気です　導きを胸に留めて過ごしましょう
#. de: Eine unbeschreiblich große Menge Glück erwartet dich!
#. fr: Vous allez connaître une chance extraordinaire !!!
#. column 5: Great Fortune
msgctxt "Omikuji:1:0:6"
msgid "Thou shalt experience extraordinary fortune. Keep these words of guidance in thy heart."
msgstr ""

#. ja: 吉
#. de: Großes Glück
#. fr: — GRANDE CHANCE —
#. column 6: Thou shalt experience exceptional fortune. Keep these words of guidance in thy heart.
msgctxt "Omikuji:2:0:5"
msgid "Good Fortune"
msgstr ""

#. ja: 満ち足りた運気です　導きを胸に留めて過ごしましょう
#. de: Eine beachtliche Menge Glück erwartet dich!
#. fr: Vous allez connaître une chance remarquable !
#. column 5: Good Fortune
msgctxt "Omikuji:2:0:6"
msgid "Thou shalt experience exceptional fortune. Keep these words of guidance in thy heart."
msgstr ""

#. ja: 中吉
#. de: Glück
#. fr: — CHANCE MOYENNE —
#. column 6: Thou shalt experience moderate fortune. Keep these words of guidance in thy heart.
msgctxt "Omikuji:3:0:5"
msgid "Fair Fortune"
msgstr ""

#. ja: まずまずの運気です　導きを胸に留めて過ごしましょう
#. de: Eine durchschnittliche Menge Glück erwartet dich.
#. fr: Vous allez connaître une chance satisfaisante.
#. column 5: Fair Fortune
msgctxt "Omikuji:3:0:6"
msgid "Thou shalt experience moderate fortune. Keep these words of guidance in thy heart."
msgstr ""

#. ja: 小吉
#. de: Kleines Glück
#. fr: — PETITE CHANCE —
#. column 6: Thou shalt experience limited fortune. Keep these words of guidance in thy heart.
msgctxt "Omikuji:4:0:5"
msgid "Small Fortune"
msgstr ""

#. ja: 悪くはない運気です　導きを胸に留めて過ごしましょう
#. de: Eine kleine, aber nicht zu verachtende Menge Glück erwartet dich.
#. fr: Vous allez connaître une chance ordinaire.
#. column 5: Small Fortune
msgctxt "Omikuji:4:0:6"
msgid "Thou shalt experience limited fortune. Keep these words of guidance in thy heart."
msgstr ""

#. ja: 凶
#. de: Unglück
#. fr: — MALCHANCE —
#. column 6: Thou shalt experience misfortune. Heed these words of guidance, and thy luck may change.
msgctxt "Omikuji:5:0:5"
msgid "Misfortune"
msgstr ""

#. ja: 逆風のある運気です　導きを聞き入れれば、運が開けるでしょう
#. de: Unglück und Gegenwind erwarten dich.
#. fr: Vous allez connaître une certaine malchance.
#. column 5: Misfortune
msgctxt "Omikuji:5:0:6"
msgid "Thou shalt experience misfortune. Heed these words of guidance, and thy luck may change."
msgstr ""

#. ja: 大凶
#. de: Großes Unglück
#. fr: — GRANDE MALCHANCE —
#. column 6: Thou shalt experience considerable misfortune. Heed these words of guidance, and thy luck may change.
msgctxt "Omikuji:6:0:5"
msgid "Grave Misfortune"
msgstr ""

#. ja: 困難の多い運気です　導きを聞き入れれば、運が開けるでしょう
#. de: Eine große Menge Unglück und Schwierigkeiten erwarten dich ...
#. fr: Vous allez connaître une malchance rare...
#. column 5: Grave Misfortune
msgctxt "Omikuji:6:0:6"
msgid "Thou shalt experience considerable misfortune. Heed these words of guidance, and thy luck may change."
msgstr ""
