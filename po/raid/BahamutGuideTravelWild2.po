#. ja: はい
#. de: Ja
#. fr: Oui
msgctxt "raid/BahamutGuideTravelWild2:TEXT_BAHAMUTGUIDETRAVELWILD2_A2_000_101:1"
msgid "Yes"
msgstr "Да"

#. ja: いいえ
#. de: Nein
#. fr: Non
