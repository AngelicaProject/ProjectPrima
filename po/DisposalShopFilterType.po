#. ja: 対象品をすべて表示
#. de: Alle anzeigen
#. fr: Tous les objets
msgctxt "DisposalShopFilterType:1:0:0"
msgid "Show All"
msgstr "Показать всё"

#. ja: ギアセット登録アイテムを除外
#. de: In Ausrüstungssets verwendete ignorieren
#. fr: Cacher les objets des tenues
msgctxt "DisposalShopFilterType:2:0:0"
msgid "Hide Items Registered to Gear Sets"
msgstr "Скрыть предметы, добавленные в комплекты экипировки"

#. ja: アーマリーチェストを除外
#. de: Im Arsenal verstaute ignorieren
#. fr: Cacher les objets de l'arsenal
msgctxt "DisposalShopFilterType:3:0:0"
msgid "Hide Armoury Chest Items"
msgstr "Скрыть предметы в оружейном сундуке"

#. ja: アイテムレベル<num $n1>以下の対象品のみ表示
#. de: Nur unter Gegen<shy>stands<shy>stufe <num $n1>
#. fr: Objets de Nv obj ≦ <num $n1>
#. macro: <num $n1> — a number; value = number parameter 1 (game data: keep it; it may move or repeat)
msgctxt "DisposalShopFilterType:4:0:0"
msgid "Show Only Items IL <num $n1> and Below"
msgstr "Показать предметы ур. предмета <num $n1> и ниже"
